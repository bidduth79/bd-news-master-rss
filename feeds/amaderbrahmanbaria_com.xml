    <item>
      <title>নাইজারে সেনা ক্যাম্পে ভয়াবহ হামলা, নিহত ১৩</title>
      <link>https://amaderbrahmanbaria.com/%e0%a6%a8%e0%a6%be%e0%a6%87%e0%a6%9c%e0%a6%be%e0%a6%b0%e0%a7%87-%e0%a6%b8%e0%a7%87%e0%a6%a8%e0%a6%be-%e0%a6%95%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%ae%e0%a7%8d%e0%a6%aa%e0%a7%87-%e0%a6%ad%e0%a6%af/</link>

    <item>
      <title>ক্রেডিট কার্ডে কোটি টাকার প্রতারণা, গ্রেপ্তার ২</title>
      <link>https://amaderbrahmanbaria.com/%e0%a6%95%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%a1%e0%a6%bf%e0%a6%9f-%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%a1%e0%a7%87-%e0%a6%95%e0%a7%8b%e0%a6%9f%e0%a6%bf-%e0%a6%9f%e0%a6%be%e0%a6%95%e0%a6%be/</link>

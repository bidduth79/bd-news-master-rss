    <item>
      <title>কাঁঠালবাগানে গ্যাস বিস্ফোরণে শিশুসহ দগ্ধ ৫, তিনজনের অবস্থা আশঙ্কাজনক</title>
      <link>https://amaderbrahmanbaria.com/%e0%a6%95%e0%a6%be%e0%a6%81%e0%a6%a0%e0%a6%be%e0%a6%b2%e0%a6%ac%e0%a6%be%e0%a6%97%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%97%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%b8-%e0%a6%ac%e0%a6%bf%e0%a6%b8%e0%a7%8d%e0%a6%ab/</link>

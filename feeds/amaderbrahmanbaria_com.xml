      <pubDate>Fri, 13 Nov 2026 05:45:58 +0000</pubDate>
      <description>স্পোর্টস ডেস্ক : গোলরক্ষক জিয়ানলুইজি দোন্নারুমার ভুলে মাত্র ১০ মিনিটেই গোল হজম করে বসে ইতালি। সেখান থেকে ঘুরে দাঁড়িয়ে কিলিয়ান এমবাপেহীন ফ্রান্সকে তারা ৩-১ গোলে হারিয়েছে। যা ১৯৬২ সালের পর নিজেদের মাঠে ফরাসিদের বিপক্ষে প্রথম জয়। বড় ভাই সেবাস্তিয়ানো এস্পোসিতো পেনাল্টি মিস করলেও, ছোট ভাই পিও এস্পোসিতো </description>
      <source url="https://amaderbrahmanbaria.com/%e0%a6%a8%e0%a6%bf%e0%a6%9c%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a6%be%e0%a6%a0%e0%a7%87-%e0%a7%ac%e0%a7%aa-%e0%a6%ac%e0%a6%9b%e0%a6%b0-%e0%a6%aa%e0%a6%b0-%e0%a6%ab%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%a8/">Amader Brahmanbaria</source>
    </item>
    <item>
      <title>টানা ১২তম জয় পেল বিশ্বচ্যাম্পিয়ন স্পেন</title>
      <link>https://amaderbrahmanbaria.com/%e0%a6%9f%e0%a6%be%e0%a6%a8%e0%a6%be-%e0%a7%a7%e0%a7%a8%e0%a6%a4%e0%a6%ae-%e0%a6%9c%e0%a6%af%e0%a6%bc-%e0%a6%aa%e0%a7%87%e0%a6%b2-%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%ac%e0%a6%9a%e0%a7%8d/</link>

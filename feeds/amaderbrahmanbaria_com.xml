    <item>
      <title>তারেক রহমানের জন্মদিন আজ</title>
      <link>https://amaderbrahmanbaria.com/%e0%a6%a4%e0%a6%be%e0%a6%b0%e0%a7%87%e0%a6%95-%e0%a6%b0%e0%a6%b9%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%9c%e0%a6%a8%e0%a7%8d%e0%a6%ae%e0%a6%a6%e0%a6%bf%e0%a6%a8-%e0%a6%86%e0%a6%9c/</link>
      <guid isPermaLink="true">https://amaderbrahmanbaria.com/%e0%a6%a4%e0%a6%be%e0%a6%b0%e0%a7%87%e0%a6%95-%e0%a6%b0%e0%a6%b9%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%9c%e0%a6%a8%e0%a7%8d%e0%a6%ae%e0%a6%a6%e0%a6%bf%e0%a6%a8-%e0%a6%86%e0%a6%9c/</guid>
      <pubDate>Fri, 20 Nov 2026 04:48:23 +0000</pubDate>
      <description>দেশের ১১তম প্রধানমন্ত্রী ও বিএনপি চেয়ারম্যান তারেক রহমানের ৬২তম জন্মদিন আজ। প্রয়াত রাষ্ট্রপতি জিয়াউর রহমান ও সাবেক প্রধানমন্ত্রী খালেদা জিয়ার জ্যেষ্ঠ সন্তান তারেক রহমান ১৯৬৫ সালের ২০ নভেম্বর জন্মগ্রহণ করেন। তারেক রহমানের শৈশব শুরু হয় একটি বিনয়ী পরিবেশে যেখানে সরল জীবনযাপন ছিল তার পরিবারের মূলমন্ত্র।</description>

    <item>
      <title>ঘূর্ণিঝড় আকভানের প্রভাবে রাণীনগরে আমনক্ষেতে হাহাকার</title>
      <link>https://amaderbrahmanbaria.com/%e0%a6%98%e0%a7%82%e0%a6%b0%e0%a7%8d%e0%a6%a3%e0%a6%bf%e0%a6%9d%e0%a6%a1%e0%a6%bc-%e0%a6%86%e0%a6%95%e0%a6%ad%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%ad%e0%a6%be%e0%a6%ac/</link>

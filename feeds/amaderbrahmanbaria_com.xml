    <item>
      <title>জলবায়ু অভিযোজনে ৩০ মিলিয়ন ডলার পাচ্ছে বাংলাদেশ</title>
      <link>https://amaderbrahmanbaria.com/%e0%a6%9c%e0%a6%b2%e0%a6%ac%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a7%81-%e0%a6%85%e0%a6%ad%e0%a6%bf%e0%a6%af%e0%a7%8b%e0%a6%9c%e0%a6%a8%e0%a7%87-%e0%a7%a9%e0%a7%a6-%e0%a6%ae%e0%a6%bf%e0%a6%b2%e0%a6%bf/</link>

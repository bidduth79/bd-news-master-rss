    <item>
      <title>নবীনগরে ছাত্রলীগের ঝটিকা মিছিল, গ্রেপ্তার ১</title>
      <link>https://amaderbrahmanbaria.com/%e0%a6%a8%e0%a6%ac%e0%a7%80%e0%a6%a8%e0%a6%97%e0%a6%b0%e0%a7%87-%e0%a6%9b%e0%a6%be%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a6%b2%e0%a7%80%e0%a6%97%e0%a7%87%e0%a6%b0-%e0%a6%9d%e0%a6%9f%e0%a6%bf%e0%a6%95%e0%a6%be/</link>

    <item>
      <title>‘জয়বাংলা’ স্লোগান, ১৫ শিক্ষার্থীকে টিসি দেওয়ার সিদ্ধান্ত</title>
      <link>https://amaderbrahmanbaria.com/%e0%a6%9c%e0%a6%af%e0%a6%bc%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be-%e0%a6%b8%e0%a7%8d%e0%a6%b2%e0%a7%8b%e0%a6%97%e0%a6%be%e0%a6%a8-%e0%a7%a7%e0%a7%ab-%e0%a6%b6%e0%a6%bf/</link>

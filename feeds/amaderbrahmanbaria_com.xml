    </item>
    <item>
      <title>চুক্তি ছাড়াই শেষ কপ-৩১, প্রস্তাব প্রত্যাখ্যান ইইউর</title>
      <link>https://amaderbrahmanbaria.com/%e0%a6%9a%e0%a7%81%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%bf-%e0%a6%9b%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a6%be%e0%a6%87-%e0%a6%b6%e0%a7%87%e0%a6%b7-%e0%a6%95%e0%a6%aa-%e0%a7%a9%e0%a7%a7-%e0%a6%aa%e0%a7%8d/</link>

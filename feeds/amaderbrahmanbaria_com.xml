    </item>
    <item>
      <title>ওড়িশায় আঘাত হেনেছে ঘূর্ণিঝড় ‘আকভান’</title>
      <link>https://amaderbrahmanbaria.com/%e0%a6%93%e0%a6%a1%e0%a6%bc%e0%a6%bf%e0%a6%b6%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%86%e0%a6%98%e0%a6%be%e0%a6%a4-%e0%a6%b9%e0%a7%87%e0%a6%a8%e0%a7%87%e0%a6%9b%e0%a7%87-%e0%a6%98%e0%a7%82%e0%a6%b0/</link>

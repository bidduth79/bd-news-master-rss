    <item>
      <title>মুক্ত বাণিজ্য ও এআই নিয়ে তিন নেতার বক্তব্য</title>
      <link>https://amaderbrahmanbaria.com/%e0%a6%ae%e0%a7%81%e0%a6%95%e0%a7%8d%e0%a6%a4-%e0%a6%ac%e0%a6%be%e0%a6%a3%e0%a6%bf%e0%a6%9c%e0%a7%8d%e0%a6%af-%e0%a6%93-%e0%a6%8f%e0%a6%86%e0%a6%87-%e0%a6%a8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87/</link>

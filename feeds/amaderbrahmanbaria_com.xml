    <item>
      <title>নবীনগর প্রবাসী ফোরাম জাতীয়তাবাদী দলের উদ্যোগে তারেক রহমানের জন্মদিনে আলোচনা দোয়া ও মিলাদ মাহফিল অনুষ্ঠিত</title>
      <link>https://amaderbrahmanbaria.com/%e0%a6%a8%e0%a6%ac%e0%a7%80%e0%a6%a8%e0%a6%97%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a7%80-%e0%a6%ab%e0%a7%8b%e0%a6%b0%e0%a6%be%e0%a6%ae-%e0%a6%9c%e0%a6%be%e0%a6%a4/</link>

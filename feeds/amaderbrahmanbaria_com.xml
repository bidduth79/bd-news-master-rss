    <item>
      <title>রাণীনগরে বৃষ্টিতে কাঁচা ইট নষ্ট, দাম বৃদ্ধির আশঙ্কা</title>
      <link>https://amaderbrahmanbaria.com/%e0%a6%b0%e0%a6%be%e0%a6%a3%e0%a7%80%e0%a6%a8%e0%a6%97%e0%a6%b0%e0%a7%87-%e0%a6%ac%e0%a7%83%e0%a6%b7%e0%a7%8d%e0%a6%9f%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%95%e0%a6%be%e0%a6%81%e0%a6%9a%e0%a6%be/</link>

    <item>
      <title>এক দিনের সফরে লালমনিরহাটে প্রধানমন্ত্রী তারেক রহমান</title>
      <link>https://amaderbrahmanbaria.com/%e0%a6%8f%e0%a6%95-%e0%a6%a6%e0%a6%bf%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%ab%e0%a6%b0%e0%a7%87-%e0%a6%b2%e0%a6%be%e0%a6%b2%e0%a6%ae%e0%a6%a8%e0%a6%bf%e0%a6%b0%e0%a6%b9%e0%a6%be%e0%a6%9f/</link>

    </item>
    <item>
      <title>খুলনায় বিএনপি নেতাকে গুলি করে হত্যা</title>
      <link>https://amaderbrahmanbaria.com/%e0%a6%96%e0%a7%81%e0%a6%b2%e0%a6%a8%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%ac%e0%a6%bf%e0%a6%8f%e0%a6%a8%e0%a6%aa%e0%a6%bf-%e0%a6%a8%e0%a7%87%e0%a6%a4%e0%a6%be%e0%a6%95%e0%a7%87-%e0%a6%97%e0%a7%81/</link>
      <guid isPermaLink="true">https://amaderbrahmanbaria.com/%e0%a6%96%e0%a7%81%e0%a6%b2%e0%a6%a8%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%ac%e0%a6%bf%e0%a6%8f%e0%a6%a8%e0%a6%aa%e0%a6%bf-%e0%a6%a8%e0%a7%87%e0%a6%a4%e0%a6%be%e0%a6%95%e0%a7%87-%e0%a6%97%e0%a7%81/</guid>
      <pubDate>Fri, 13 Nov 2026 05:34:40 +0000</pubDate>
      <description>নিজস্ব প্রতিবেদক : খুলনার রূপসা উপজেলার সদর ইউনিয়ন বিএনপির সার্চ কমিটির সদস্য মো. জাকির হোসেনকে (৪৩) গুলি করে হত্যা করা হয়েছে। বৃহস্পতিবার (১২ নভেম্বর) রাত সোয়া ১০ টার দিকে উপজেলার স্বল্পবাহিরদিয়া হিরকের দোকানে বসা অবস্থায় তাকে গুলি করে হত্যা করে সন্ত্রাসীরা। আশঙ্কাজনক অবস্থায় এলাকাবাসী উপজেলা স্বাস</description>
      <source url="https://amaderbrahmanbaria.com/%e0%a6%96%e0%a7%81%e0%a6%b2%e0%a6%a8%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%ac%e0%a6%bf%e0%a6%8f%e0%a6%a8%e0%a6%aa%e0%a6%bf-%e0%a6%a8%e0%a7%87%e0%a6%a4%e0%a6%be%e0%a6%95%e0%a7%87-%e0%a6%97%e0%a7%81/">Amader Brahmanbaria</source>
    </item>
    <item>

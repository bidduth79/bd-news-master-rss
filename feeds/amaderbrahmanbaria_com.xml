    <item>
      <title>শ্রমিক অসন্তোষে পোশাকের অর্ডার হারাচ্ছে বাংলাদেশ, সুবিধা পাচ্ছে ভারত</title>
      <link>https://amaderbrahmanbaria.com/%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a6%ae%e0%a6%bf%e0%a6%95-%e0%a6%85%e0%a6%b8%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%8b%e0%a6%b7%e0%a7%87-%e0%a6%aa%e0%a7%8b%e0%a6%b6%e0%a6%be%e0%a6%95%e0%a7%87%e0%a6%b0/</link>

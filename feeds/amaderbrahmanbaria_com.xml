    </item>
    <item>
      <title>নবীনগরে বিএনপি কার্যালয়ে অগ্নিকাণ্ডের ১০ মাস পর বহিষ্কৃত নেতাদের বিরুদ্ধে মামলা, প্রতিবাদে বিক্ষোভ</title>
      <link>https://amaderbrahmanbaria.com/%e0%a6%a8%e0%a6%ac%e0%a7%80%e0%a6%a8%e0%a6%97%e0%a6%b0%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%8f%e0%a6%a8%e0%a6%aa%e0%a6%bf-%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%b2%e0%a6%af-2/</link>

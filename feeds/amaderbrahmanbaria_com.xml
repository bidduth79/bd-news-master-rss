    </item>
    <item>
      <title>‘এনাফ ইজ এনাফ, আর নয়’: তারেক রহমান</title>
      <link>https://amaderbrahmanbaria.com/%e0%a6%8f%e0%a6%a8%e0%a6%be%e0%a6%ab-%e0%a6%87%e0%a6%9c-%e0%a6%8f%e0%a6%a8%e0%a6%be%e0%a6%ab-%e0%a6%86%e0%a6%b0-%e0%a6%a8%e0%a6%af%e0%a6%bc-%e0%a6%a4%e0%a6%be%e0%a6%b0%e0%a7%87/</link>

    <item>
      <title>টানা বৃষ্টিতে সবজি সরবরাহে ঘাটতি, বাড়তি দামে কিনছেন ক্রেতারা</title>
      <link>https://amaderbrahmanbaria.com/%e0%a6%9f%e0%a6%be%e0%a6%a8%e0%a6%be-%e0%a6%ac%e0%a7%83%e0%a6%b7%e0%a7%8d%e0%a6%9f%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%b8%e0%a6%ac%e0%a6%9c%e0%a6%bf-%e0%a6%b8%e0%a6%b0%e0%a6%ac%e0%a6%b0%e0%a6%be/</link>

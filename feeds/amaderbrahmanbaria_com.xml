    <item>
      <title>ব্যাংক খাতে খেলাপি ঋণ ৬ লাখ ২৭ হাজার কোটি টাকা</title>
      <link>https://amaderbrahmanbaria.com/%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95-%e0%a6%96%e0%a6%be%e0%a6%a4%e0%a7%87-%e0%a6%96%e0%a7%87%e0%a6%b2%e0%a6%be%e0%a6%aa%e0%a6%bf-%e0%a6%8b%e0%a6%a3-%e0%a7%ac-%e0%a6%b2%e0%a6%be/</link>

    <item>
      <title>নবীনগরে ডা. হামদু মিয়া ফাউন্ডেশনের উদ্যোগে স্মৃতি শিক্ষাবৃত্তি পরীক্ষা অনুষ্ঠিত</title>
      <link>https://amaderbrahmanbaria.com/%e0%a6%a8%e0%a6%ac%e0%a7%80%e0%a6%a8%e0%a6%97%e0%a6%b0%e0%a7%87-%e0%a6%a1%e0%a6%be-%e0%a6%b9%e0%a6%be%e0%a6%ae%e0%a6%a6%e0%a7%81-%e0%a6%ae%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be-%e0%a6%ab%e0%a6%be/</link>

    <item>
      <title>নিকলীতে বিয়ের খাবার খেয়ে অর্ধশতাধিক অসুস্থ, একজনের মৃত্যু</title>
      <link>https://tulpar24.com/%e0%a6%a8%e0%a6%bf%e0%a6%95%e0%a6%b2%e0%a7%80%e0%a6%a4%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%b0-%e0%a6%96%e0%a6%be%e0%a6%ac%e0%a6%be%e0%a6%b0-%e0%a6%96%e0%a7%87%e0%a6%af/</link>

    <item>
      <title>দেশের সার্বভৌমত্ব রক্ষায় সেনাবাহিনীর ভূমিকা অনস্বীকার্য: রিজভী ১ ঘন্টা আগে</title>
      <link>https://www.asiantvonline.com/news/politics/75921/c83c-20261121</link>
      <guid isPermaLink="true">https://www.asiantvonline.com/news/politics/75921/c83c-20261121</guid>
      <pubDate>Sat, 21 Nov 2026 09:26:03 +0000</pubDate>

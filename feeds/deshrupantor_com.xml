    <item>
      <title>কপ৩১ সম্মেলনে জামায়াতের প্রতিনিধিত্ব করবেন মাহবুবুল আলম সালেহী</title>
      <link>https://www.deshrupantor.com/733920/%E0%A6%95%E0%A6%AA%E0%A7%A9%E0%A7%A7-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%A8%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A6%A7%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%AC-%E0%A6%95%E0%A6%B0%E0%A6%AC%E0%A7%87%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/733920/%E0%A6%95%E0%A6%AA%E0%A7%A9%E0%A7%A7-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%A8%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A6%A7%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%AC-%E0%A6%95%E0%A6%B0%E0%A6%AC%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Mon, 09 Nov 2026 21:38:26 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/e07acebb9695396cadabccb02fab1116-6af1e88e15305.gif?jadewits_media_id=241375" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/e07acebb9695396cadabccb02fab1116-6af1e88e15305.gif?jadewits_media_id=241375" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/e07acebb9695396cadabccb02fab1116-6af1e88e15305.gif?jadewits_media_id=241375" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কপ৩১ সম্মেলনে জামায়াতের প্রতিনিধিত্ব করবেন মাহবুবুল আলম সালেহী" /&gt;&lt;/p&gt;&lt;p&gt;জাতিসংঘের জলবায়ু সম্মেলন কপ৩১ এ বাংলাদেশ জামায়াতে ইসলামীর প্রতিনিধি হিসেবে অংশ নিবেন কুড়িগ্রাম-৩ (উলিপুর) আসনের সংসদ সদস্য ব্যারিস্টার মাহবুবুল আলম সালেহী।
তিনি সুইডেনের স্টকহোম ইউনিভার্সিটি থেকে জিওকেমিস্ট্রিতে স্নাতকোত্তর ডিগ্রি অর্জন করেছেন। গ্রিনহাউস গ্যাসের ওপর তার গবেষণা এবং যুক্তরাজ্যে পরিবেশ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/733920/%E0%A6%95%E0%A6%AA%E0%A7%A9%E0%A7%A7-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%A8%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A6%A7%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%AC-%E0%A6%95%E0%A6%B0%E0%A6%AC%E0%A7%87%E0%A6%A8">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>তিন ৫০০তে টেস্ট ক্রিকেটে ইতিহাস</title>
      <link>https://www.deshrupantor.com/733919/%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A7%AB%E0%A7%A6%E0%A7%A6%E0%A6%A4%E0%A7%87-%E0%A6%9F%E0%A7%87%E0%A6%B8%E0%A7%8D%E0%A6%9F-%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%9F%E0%A7%87-%E0%A6%87%E0%A6%A4%E0%A6%BF%E0%A6%B9%E0%A6%BE%E0%A6%B8</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/733919/%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A7%AB%E0%A7%A6%E0%A7%A6%E0%A6%A4%E0%A7%87-%E0%A6%9F%E0%A7%87%E0%A6%B8%E0%A7%8D%E0%A6%9F-%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%9F%E0%A7%87-%E0%A6%87%E0%A6%A4%E0%A6%BF%E0%A6%B9%E0%A6%BE%E0%A6%B8</guid>
      <pubDate>Mon, 09 Nov 2026 21:28:45 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/c2857545a535acf527b7fb89500c49ef-6af1e54dd93db.jpg?jadewits_media_id=241372" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/c2857545a535acf527b7fb89500c49ef-6af1e54dd93db.jpg?jadewits_media_id=241372" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/c2857545a535acf527b7fb89500c49ef-6af1e54dd93db.jpg?jadewits_media_id=241372" style="max-width:100%;height:auto;margin-bottom:10px;" alt="তিন ৫০০তে টেস্ট ক্রিকেটে ইতিহাস" /&gt;&lt;/p&gt;&lt;p&gt;শারজায় আফগানিস্তান ও জিম্বাবুয়ের মধ্যকার প্রথম টেস্ট ম্যাচটি ড্রয়ের মধ্য দিয়ে শেষ হলেও, এর স্কোরবোর্ড এবং ব্যক্তিগত অর্জনগুলো ক্রিকেট ইতিহাসের পাতায় সোনালী অক্ষরে লেখা থাকবে। পাঁচ দিনের এই রানবন্যার ম্যাচে দুই দল মিলে তিন ইনিংসে ব্যাট করে যে ইতিহাস গড়েছে, তাতে চারদিকে এখন আলোচনার ঝড়। প্রথম ইনিংসে জি&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/733919/%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A7%AB%E0%A7%A6%E0%A7%A6%E0%A6%A4%E0%A7%87-%E0%A6%9F%E0%A7%87%E0%A6%B8%E0%A7%8D%E0%A6%9F-%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%9F%E0%A7%87-%E0%A6%87%E0%A6%A4%E0%A6%BF%E0%A6%B9%E0%A6%BE%E0%A6%B8">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>হাজীরবাগে বাড়ির ছাদ থেকে ফেলে শিশু হত্যার অভিযোগ</title>
      <link>https://www.deshrupantor.com/733918/%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A7%80%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%97%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%B0-%E0%A6%9B%E0%A6%BE%E0%A6%A6-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/733918/%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A7%80%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%97%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%B0-%E0%A6%9B%E0%A6%BE%E0%A6%A6-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97</guid>
      <pubDate>Mon, 09 Nov 2026 21:24:56 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/07/02/531846359534e4f2cc86d0c832dc6992-6a45eb0f180ac.jpg?jadewits_media_id=209158" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/07/02/531846359534e4f2cc86d0c832dc6992-6a45eb0f180ac.jpg?jadewits_media_id=209158" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/07/02/531846359534e4f2cc86d0c832dc6992-6a45eb0f180ac.jpg?jadewits_media_id=209158" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হাজীরবাগে বাড়ির ছাদ থেকে ফেলে শিশু হত্যার অভিযোগ" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর যাত্রাবাড়ী মীর হাজীরবাগে ৫তলা একটি বাড়ির ছাদ থেকে আবিদা (৪) নামে এক শিশুকে ফেলে দিয়ে হত্যার অভিযোগ পাওয়া গেছে। এই ঘটনায় জিজ্ঞাসাবাদের জন্য নিটল (২৬) নামে পাশের ফ্ল্যাটের এক তরুণীকে আটক করেছে পুলিশ।
সোমবার (৯ নভেম্বর) বিকেল সাড়ে ৫টার দিকে যাত্রাবাড়ী মীর হাজীরবাগ ৪৬১ নম্বর বেলাল হোসেনের বাড়ি&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/733918/%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A7%80%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%97%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%B0-%E0%A6%9B%E0%A6%BE%E0%A6%A6-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>দেশব্যাপী অভিযান: ৪৫ জেলায় ১১৯ প্রতিষ্ঠানকে ৯ লাখ টাকা জরিমানা</title>
      <link>https://www.deshrupantor.com/733917/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AA%E0%A7%80-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A7%AA%E0%A7%AB-%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A7%A7%E0%A7%A7%E0%A7%AF-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A7%AF-%E0%A6%B2%E0%A6%BE%E0%A6%96</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/733917/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AA%E0%A7%80-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A7%AA%E0%A7%AB-%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A7%A7%E0%A7%A7%E0%A7%AF-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A7%AF-%E0%A6%B2%E0%A6%BE%E0%A6%96</guid>
      <pubDate>Mon, 09 Nov 2026 21:16:25 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/dd4edc2c4fdeaa5c350c1fd5397a4d90-6af1e34f42c81.gif?jadewits_media_id=241370" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/dd4edc2c4fdeaa5c350c1fd5397a4d90-6af1e34f42c81.gif?jadewits_media_id=241370" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/dd4edc2c4fdeaa5c350c1fd5397a4d90-6af1e34f42c81.gif?jadewits_media_id=241370" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দেশব্যাপী অভিযান: ৪৫ জেলায় ১১৯ প্রতিষ্ঠানকে ৯ লাখ টাকা জরিমানা" /&gt;&lt;/p&gt;&lt;p&gt;ফল, চাল, ডাল ও ভোজ্যতেলসহ নিত্যপ্রয়োজনীয় পণ্যের বাজারে মূল্য স্থিতিশীল রাখা এবং পণ্যের স্বাভাবিক সরবরাহ নিশ্চিত করতে এবং সরকার নির্ধারিত মূল্যে গ্যাস সিলিন্ডার বিক্রয় নিশ্চিতে দেশব্যাপী বিশেষ তদারকি কার্যক্রম পরিচালনা করেছে জাতীয় ভোক্তা-অধিকার সংরক্ষণ অধিদপ্তর।
ঢাকা মহানগরসহ দেশের ৪৫টি জেলায় অধিদপ্ত&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/733917/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AA%E0%A7%80-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A7%AA%E0%A7%AB-%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A7%A7%E0%A7%A7%E0%A7%AF-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A7%AF-%E0%A6%B2%E0%A6%BE%E0%A6%96">দেশ রূপান্তর</source>

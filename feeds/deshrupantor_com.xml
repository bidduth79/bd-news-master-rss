    <item>
      <title>উরুগুয়ের কাছে হেরে মেসি-পরবর্তী যুগ শুরু আর্জেন্টিনার</title>
      <link>https://www.deshrupantor.com/735015/%E0%A6%89%E0%A6%B0%E0%A7%81%E0%A6%97%E0%A7%81%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%9B%E0%A7%87-%E0%A6%B9%E0%A7%87%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A7%87%E0%A6%B8%E0%A6%BF-%E0%A6%AA%E0%A6%B0%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A7%80-%E0%A6%AF%E0%A7%81%E0%A6%97-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735015/%E0%A6%89%E0%A6%B0%E0%A7%81%E0%A6%97%E0%A7%81%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%9B%E0%A7%87-%E0%A6%B9%E0%A7%87%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A7%87%E0%A6%B8%E0%A6%BF-%E0%A6%AA%E0%A6%B0%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A7%80-%E0%A6%AF%E0%A7%81%E0%A6%97-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81</guid>
      <pubDate>Sat, 14 Nov 2026 07:56:28 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/eb6f5a55eb2101b3baf9d5d7cc009d8c-6af7bcc155754.jpg?jadewits_media_id=242391" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/eb6f5a55eb2101b3baf9d5d7cc009d8c-6af7bcc155754.jpg?jadewits_media_id=242391" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/eb6f5a55eb2101b3baf9d5d7cc009d8c-6af7bcc155754.jpg?jadewits_media_id=242391" style="max-width:100%;height:auto;margin-bottom:10px;" alt="উরুগুয়ের কাছে হেরে মেসি-পরবর্তী যুগ শুরু আর্জেন্টিনার" /&gt;&lt;/p&gt;&lt;p&gt;দীর্ঘ দুই দশকের জাদুকরী অধ্যায়ের ইতি টেনে গত মাসে আবেগঘন বিদায় নিয়েছিলেন লিওনেল মেসি। আর্জেন্টিনার ফুটবলে মহানায়ক-পরবর্তী নতুন যুগের সূচনাটা কেমন হবে, তা দেখার অপেক্ষায় ছিল পুরো ফুটবল বিশ্ব। তবে বুয়েনস আইরেসের ঐতিহাসিক লা বোম্বোনেরা স্টেডিয়ামে শুরুটা মোটেও সুখকর হলো না ২০২৬ বিশ্বকাপের রানার্সআপদের। &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735015/%E0%A6%89%E0%A6%B0%E0%A7%81%E0%A6%97%E0%A7%81%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%9B%E0%A7%87-%E0%A6%B9%E0%A7%87%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A7%87%E0%A6%B8%E0%A6%BF-%E0%A6%AA%E0%A6%B0%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A7%80-%E0%A6%AF%E0%A7%81%E0%A6%97-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>ভবন বানাতে অনিয়মই নিয়ম</title>
      <link>https://www.deshrupantor.com/735014/%E0%A6%AD%E0%A6%AC%E0%A6%A8-%E0%A6%AC%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%85%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%AE%E0%A6%87-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%AE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735014/%E0%A6%AD%E0%A6%AC%E0%A6%A8-%E0%A6%AC%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%85%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%AE%E0%A6%87-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%AE</guid>
      <pubDate>Sat, 14 Nov 2026 07:42:02 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/efbb61210db31dee35399d1e29ea6660-6af7bc6302636.jpg?jadewits_media_id=242390" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/efbb61210db31dee35399d1e29ea6660-6af7bc6302636.jpg?jadewits_media_id=242390" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/efbb61210db31dee35399d1e29ea6660-6af7bc6302636.jpg?jadewits_media_id=242390" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভবন বানাতে অনিয়মই নিয়ম" /&gt;&lt;/p&gt;&lt;p&gt;রাজশাহী নগরীতে একের পর এক গড়ে উঠছে বহুতল ভবন। আবাসন ও বাণিজ্যিক চাহিদা মেটাতে বাড়ছে ভবনের উচ্চতা, বিস্তৃত হচ্ছে নগরায়ণ। কিন্তু এই সম্প্রসারণের সঙ্গে তাল মিলিয়ে নিশ্চিত হচ্ছে না ভবনের নিরাপত্তা ও নির্মাণবিধির যথাযথ প্রয়োগ। রাজশাহী উন্নয়ন কর্তৃপক্ষের (আরডিএ) তথ্য অনুযায়ী, জেলার ১ হাজার ২৪৫টি বহুতল ভবন&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735014/%E0%A6%AD%E0%A6%AC%E0%A6%A8-%E0%A6%AC%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%85%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%AE%E0%A6%87-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%AE">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>মুক্তিপণের টাকা দিয়েও জিম্মি ছেলের সঙ্গে কথা বলতে পারেননি বাবা</title>
      <link>https://www.deshrupantor.com/735013/%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%AA%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%93-%E0%A6%9C%E0%A6%BF%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%BF-%E0%A6%9B%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%95%E0%A6%A5%E0%A6%BE-%E0%A6%AC%E0%A6%B2%E0%A6%A4%E0%A7%87</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735013/%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%AA%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%93-%E0%A6%9C%E0%A6%BF%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%BF-%E0%A6%9B%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%95%E0%A6%A5%E0%A6%BE-%E0%A6%AC%E0%A6%B2%E0%A6%A4%E0%A7%87</guid>
      <pubDate>Sat, 14 Nov 2026 07:41:39 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/3f34fba5adc6222d1361dc695d1e561f-6af76df013b99.jpg?jadewits_media_id=242371" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/3f34fba5adc6222d1361dc695d1e561f-6af76df013b99.jpg?jadewits_media_id=242371" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/3f34fba5adc6222d1361dc695d1e561f-6af76df013b99.jpg?jadewits_media_id=242371" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মুক্তিপণের টাকা দিয়েও জিম্মি ছেলের সঙ্গে কথা বলতে পারেননি বাবা" /&gt;&lt;/p&gt;&lt;p&gt;জিম্মি ছেলেকে ফিরে পাওয়ার আশায় একবার নয়, কয়েক দফায় পাঁচ লাখ টাকা পাঠিয়েছিলেন বৃদ্ধ বাবা আব্দুস সামাদ। কিন্তু টাকা নিয়েও কথা রাখেনি অপহরণকারীরা। ছেলের কোনো সন্ধান তো মেলেইনি, উল্টো পরে আরও ৪২ লাখ টাকা দাবি করা হয়। শেষ পর্যন্ত প্রতারণার শিকার হয়ে আইনের আশ্রয় নেন এই অসহায় বাবা।
মামলার তদন্তে নেমে মানব &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735013/%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%AA%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%93-%E0%A6%9C%E0%A6%BF%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%BF-%E0%A6%9B%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%95%E0%A6%A5%E0%A6%BE-%E0%A6%AC%E0%A6%B2%E0%A6%A4%E0%A7%87">দেশ রূপান্তর</source>

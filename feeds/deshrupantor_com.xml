      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/684b7a261a4ed9e812aaaa309d11b96a-6b008fd7c4d2b.jpg?jadewits_media_id=244037" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/684b7a261a4ed9e812aaaa309d11b96a-6b008fd7c4d2b.jpg?jadewits_media_id=244037" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/684b7a261a4ed9e812aaaa309d11b96a-6b008fd7c4d2b.jpg?jadewits_media_id=244037" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডুলির নজর বিশ্বকাপ বাছাইয়ে" /&gt;&lt;/p&gt;&lt;p&gt;সাফ চ্যাম্পিয়নশিপে ব্যর্থতার কারণ খতিয়ে দেখতে যাচ্ছে বাংলাদেশ ফুটবল ফেডারেশন (বাফুফে)। আজ শনিবার জাতীয় দল কমিটির সভায় টুর্নামেন্টে দলের পারফরম্যান্স, প্রস্তুতি ও ব্যর্থতার কারণ নিয়ে নিজের মূল্যায়ন তুলে ধরবেন প্রধান কোচ থমাস ডুলি। তবে সাফের হতাশা পেছনে ফেলে এরই মধ্যে আগামী মার্চে ২০৩০ ফিফা বিশ্বকাপ ব&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736703/%E0%A6%A1%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B0-%E0%A6%A8%E0%A6%9C%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%95%E0%A6%BE%E0%A6%AA-%E0%A6%AC%E0%A6%BE%E0%A6%9B%E0%A6%BE%E0%A6%87%E0%A7%9F%E0%A7%87">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>জাতীয় জুডো</title>
      <link>https://www.deshrupantor.com/736702/%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%9C%E0%A7%81%E0%A6%A1%E0%A7%8B</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736702/%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%9C%E0%A7%81%E0%A6%A1%E0%A7%8B</guid>
      <pubDate>Sat, 21 Nov 2026 00:24:11 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/684b7a261a4ed9e812aaaa309d11b96a-6b008fd7c4d2b.jpg?jadewits_media_id=244037" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/684b7a261a4ed9e812aaaa309d11b96a-6b008fd7c4d2b.jpg?jadewits_media_id=244037" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/684b7a261a4ed9e812aaaa309d11b96a-6b008fd7c4d2b.jpg?jadewits_media_id=244037" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জাতীয় জুডো" /&gt;&lt;/p&gt;&lt;p&gt;জাতীয় জুডোতে সোনার লড়াইয়ে এগিয়ে সেনাবাহিনী, আনসার ও বিকেএসপি। মিরপুরে শহীদ সোহরাওয়ার্দী ইনডোর স্টেডিয়ামে শুক্রবার অনুষ্ঠিত টুর্নামেন্টের দ্বিতীয় দিনে পুরুষদের ৬৬ কেজি ওজন শ্রেণিতে স্বর্ণ জিতেছেন বাংলাদেশ ক্রীড়া শিক্ষা প্রতিষ্ঠানের (বিকেএসপি) জুবায়ের রহমান। মেয়েদের ৫২ কেজিতে স্বর্ণ জিতেছেন বাংলাদেশ আ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736702/%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%9C%E0%A7%81%E0%A6%A1%E0%A7%8B">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>দেশে ফিরছেন হাসান</title>
      <link>https://www.deshrupantor.com/736701/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736701/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A6%A8</guid>
      <pubDate>Sat, 21 Nov 2026 00:23:51 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/684b7a261a4ed9e812aaaa309d11b96a-6b008fd7c4d2b.jpg?jadewits_media_id=244037" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/684b7a261a4ed9e812aaaa309d11b96a-6b008fd7c4d2b.jpg?jadewits_media_id=244037" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/684b7a261a4ed9e812aaaa309d11b96a-6b008fd7c4d2b.jpg?jadewits_media_id=244037" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দেশে ফিরছেন হাসান" /&gt;&lt;/p&gt;&lt;p&gt;দক্ষিণ আফ্রিকা সফর শেষ না করেই দেশে ফিরছেন বাংলাদেশ দলের ডানহাতি পেসার হাসান মাহমুদ। পুরনো চোটের কারণে প্রোটিয়াদের বিপক্ষে সিরিজের দ্বিতীয় ও শেষ টেস্টে খেলা হচ্ছে না তার। বাংলাদেশ ক্রিকেট বোর্ড নিশ্চিত করেছে। একই সঙ্গে দক্ষিণ আফ্রিকার বিপক্ষে আসন্ন ওয়ানডে ও টি-টোয়েন্টি সিরিজেও খেলতে পারবেন না তিনি।&amp;&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736701/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A6%A8">দেশ রূপান্তর</source>

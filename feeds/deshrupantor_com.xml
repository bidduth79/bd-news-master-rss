      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/f11d73d562c7bc96062ba13eae33da39-6af879a7a15b1.jpg?jadewits_media_id=242596" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/f11d73d562c7bc96062ba13eae33da39-6af879a7a15b1.jpg?jadewits_media_id=242596" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/f11d73d562c7bc96062ba13eae33da39-6af879a7a15b1.jpg?jadewits_media_id=242596" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইবিতে র‍্যাগিং ও শৃঙ্খলা ভঙ্গের দায়ে ৫ জন স্থায়ীসহ ২৭ শিক্ষার্থীকে বহিষ্কার" /&gt;&lt;/p&gt;&lt;p&gt;ইসলামী বিশ্ববিদ্যালয়ের (ইবি) নবীন শিক্ষার্থীদের র&amp;zwj;্যাগিং, শৃঙ্খলা ভঙ্গ ও যৌন হয়রানির দায়ে ৫ জনকে আজীবনসহ ২৭ শিক্ষার্থীকে বহিষ্কারের সিদ্ধান্ত নিয়েছে বিশ্ববিদ্যালয় প্রশাসন। বিশ্ববিদ্যালয়ের ২৭৫তম সিন্ডিকেট সভায় এ সিদ্ধান্ত নেয় প্রশাসন।&amp;nbsp;
শনিবার (১৪ নভেম্বর) বিশ্ববিদ্যালয়ের ভারপ্রাপ্ত রেজিস্ট্র&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735187/%E0%A6%87%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%B0%E2%80%8D%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%97%E0%A6%BF%E0%A6%82-%E0%A6%93-%E0%A6%B6%E0%A7%83%E0%A6%99%E0%A7%8D%E0%A6%96%E0%A6%B2%E0%A6%BE-%E0%A6%AD%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A7%9F%E0%A7%87-%E0%A7%AB-%E0%A6%9C%E0%A6%A8-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A7%9F%E0%A7%80%E0%A6%B8%E0%A6%B9">দেশ রূপান্তর</source>

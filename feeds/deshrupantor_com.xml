      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/5491a2cc7e0ad5405522757bf708161e-6afbb85196eb5.jpg?jadewits_media_id=243180" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/5491a2cc7e0ad5405522757bf708161e-6afbb85196eb5.jpg?jadewits_media_id=243180" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/5491a2cc7e0ad5405522757bf708161e-6afbb85196eb5.jpg?jadewits_media_id=243180" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আওয়ামী লীগকে আর ফিরতে দেওয়া হবে না" /&gt;&lt;/p&gt;&lt;p&gt;আওয়ামী লীগ ও শেখ হাসিনার সমালোচনা করে বিএনপির ভারপ্রাপ্ত মহাসচিব রুহুল কবির রিজভী বলেছেন, গুম-খুন ও রক্তাক্ত পথ ধরে আওয়ামী চক্রকে বাংলাদেশের জনগণ আর ফিরতে দেবে না। পেছনের দরজা দিয়ে এবং পার্শ্ববর্তী দেশের মদদ নিয়ে সমাজে নৈরাজ্য সৃষ্টির যে অপচেষ্টা চালানো হচ্ছে, এ দেশের মানুষ তা কখনোই সফল হতে দেবে না।&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735795/%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A6%95%E0%A7%87-%E0%A6%86%E0%A6%B0-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%B9%E0%A6%AC%E0%A7%87-%E0%A6%A8%E0%A6%BE">দেশ রূপান্তর</source>
    </item>

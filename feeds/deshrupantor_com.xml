      <guid isPermaLink="true">https://www.deshrupantor.com/736299/%E0%A6%A4%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A7%82%E0%A6%AA%E0%A6%B0%E0%A7%87%E0%A6%96%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A7%9F-%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A6%AE%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%B9%E0%A6%BE%E0%A6%9F%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%80</guid>
      <pubDate>Thu, 19 Nov 2026 07:44:37 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/03988f864549f889688234a254d2ce68-6afe5120869bb.jpg?jadewits_media_id=243654" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/03988f864549f889688234a254d2ce68-6afe5120869bb.jpg?jadewits_media_id=243654" medium="image" />

      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/7bf409b96561af74d9c1553b5e37f28f-6b03fa3df2b9e.jpeg?jadewits_media_id=244562" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/7bf409b96561af74d9c1553b5e37f28f-6b03fa3df2b9e.jpeg?jadewits_media_id=244562" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/7bf409b96561af74d9c1553b5e37f28f-6b03fa3df2b9e.jpeg?jadewits_media_id=244562" style="max-width:100%;height:auto;margin-bottom:10px;" alt="স্বাস্থ্যসেবার মান বাড়িয়ে প্রান্তিক জনগোষ্ঠীর কাছে পৌঁছানোর আহ্বান রাষ্ট্রপতির" /&gt;&lt;/p&gt;&lt;p&gt;রাষ্ট্রপতি মির্জা ফখরুল ইসলাম আলমগীর স্বাস্থ্যসেবার মান আরও বাড়ানোর ওপর গুরুত্বারোপ করে বলেছেন, দেশের প্রান্তিক জনগণের কাছে স্বাস্থ্যসেবা পৌঁছে দিতে হবে।
সোমবার (২৩ নভেম্বর ২০২৬) সকালে বঙ্গভবনে স্বাস্থ্য ও পরিবার কল্যাণ মন্ত্রী সরদার মো. সাখাওয়াত হোসেন (বকুল)-এর সঙ্গে সৌজন্য সাক্ষাৎকালে রাষ্ট্রপতি&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737255/%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A7%8D%E0%A6%AF%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%AC%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%9C%E0%A6%A8%E0%A6%97%E0%A7%8B%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A7%80%E0%A6%B0">দেশ রূপান্তর</source>

    <item>
      <title>৯ সশস্ত্র গ্রুপের হাতে জিম্মি খুলনা, চাঁদা না দিলেই গুলি</title>
      <link>https://www.deshrupantor.com/737972/%E0%A7%AF-%E0%A6%B8%E0%A6%B6%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%AA%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%9C%E0%A6%BF%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%BF-%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%BE-%E0%A6%A8%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737972/%E0%A7%AF-%E0%A6%B8%E0%A6%B6%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%AA%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%9C%E0%A6%BF%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%BF-%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%BE-%E0%A6%A8%E0%A6%BE</guid>
      <pubDate>Thu, 26 Nov 2026 01:28:14 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/b952102c7b02f120615e51ab7984e0bd-6b0736c83fd27.jpg?jadewits_media_id=245260" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/b952102c7b02f120615e51ab7984e0bd-6b0736c83fd27.jpg?jadewits_media_id=245260" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/b952102c7b02f120615e51ab7984e0bd-6b0736c83fd27.jpg?jadewits_media_id=245260" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৯ সশস্ত্র গ্রুপের হাতে জিম্মি খুলনা, চাঁদা না দিলেই গুলি" /&gt;&lt;/p&gt;&lt;p&gt;প্রকাশ্যে চাঁদাবাজি, চাঁদা না দিলে গুলি, একের পর এক নৃশংস হত্যা, চাঁদাবাজদের লাগামহীন দৌরাত্ম্যে জিম্মি হয়ে পড়েছেন খুলনার ব্যবসায়ী ও সাধারণ মানুষ। ভয়ে কেউ মুখ খুলছেন না। পরিস্থিতি নিয়ন্ত্রণে যৌথ অভিযান পরিচালিত হচ্ছে, গ্রেপ্তার হচ্ছে, তবুও অপরাধ কমছে না।
আইনশৃঙ্খলা রক্ষাকারী বাহিনীর তথ্য ও সাম্প্রতি&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737972/%E0%A7%AF-%E0%A6%B8%E0%A6%B6%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%AA%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%9C%E0%A6%BF%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%BF-%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%BE-%E0%A6%A8%E0%A6%BE">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>মুদি দোকানে ডাকঘর</title>
      <link>https://www.deshrupantor.com/737971/%E0%A6%AE%E0%A7%81%E0%A6%A6%E0%A6%BF-%E0%A6%A6%E0%A7%8B%E0%A6%95%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%A1%E0%A6%BE%E0%A6%95%E0%A6%98%E0%A6%B0</link>

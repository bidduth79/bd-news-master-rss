    <item>
      <title>‘পুষ্পা ২’কেও ছাপিয়ে গেল ‘রামায়ণ’</title>
      <link>https://www.deshrupantor.com/734174/%E2%80%98%E0%A6%AA%E0%A7%81%E0%A6%B7%E0%A7%8D%E0%A6%AA%E0%A6%BE-%E0%A7%A8%E2%80%99%E0%A6%95%E0%A7%87%E0%A6%93-%E0%A6%9B%E0%A6%BE%E0%A6%AA%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%B2-%E2%80%98%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A6%A3%E2%80%99</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734174/%E2%80%98%E0%A6%AA%E0%A7%81%E0%A6%B7%E0%A7%8D%E0%A6%AA%E0%A6%BE-%E0%A7%A8%E2%80%99%E0%A6%95%E0%A7%87%E0%A6%93-%E0%A6%9B%E0%A6%BE%E0%A6%AA%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%B2-%E2%80%98%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A6%A3%E2%80%99</guid>
      <pubDate>Tue, 10 Nov 2026 21:31:25 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/f4151f70149acae9d0bc43e3342bfec5-6af337f8b1f3e.jpg?jadewits_media_id=241625" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/f4151f70149acae9d0bc43e3342bfec5-6af337f8b1f3e.jpg?jadewits_media_id=241625" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/f4151f70149acae9d0bc43e3342bfec5-6af337f8b1f3e.jpg?jadewits_media_id=241625" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘পুষ্পা ২’কেও ছাপিয়ে গেল ‘রামায়ণ’" /&gt;&lt;/p&gt;&lt;p&gt;এবারের দীপাবলির ছুটিতে কখনও বাড়ে, কখনও কমে নীতেশ তিওয়ারীর &amp;lsquo;রামায়ণ&amp;rsquo;-এর ব্যবসা। তবে উৎসবের রেশ কাটতেই বক্সঅফিসে ঝড় তুলেছে ছবিটি। মুক্তির পঞ্চম দিনে হিন্দি সংস্করণে এক দিনে ৮৭ কোটি টাকার ব্যবসা করল রণবীর কাপুর ও সাই পল্লবী অভিনীত এই ছবি। ফলে হিন্দি ছবির ক্ষেত্রে এক দিনে সর্বোচ্চ আয় করা ছবি&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734174/%E2%80%98%E0%A6%AA%E0%A7%81%E0%A6%B7%E0%A7%8D%E0%A6%AA%E0%A6%BE-%E0%A7%A8%E2%80%99%E0%A6%95%E0%A7%87%E0%A6%93-%E0%A6%9B%E0%A6%BE%E0%A6%AA%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%B2-%E2%80%98%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A6%A3%E2%80%99">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>সাংবাদিক রাজেশকে নির্যাতন, ভুয়া ভিডিও ছড়িয়ে অপপ্রচারের অভিযোগ</title>
      <link>https://www.deshrupantor.com/734173/%E0%A6%B8%E0%A6%BE%E0%A6%82%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A6%BF%E0%A6%95-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A7%87%E0%A6%B6%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A6%A8-%E0%A6%AD%E0%A7%81%E0%A7%9F%E0%A6%BE-%E0%A6%AD%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A6%93-%E0%A6%9B%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A7%87</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734173/%E0%A6%B8%E0%A6%BE%E0%A6%82%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A6%BF%E0%A6%95-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A7%87%E0%A6%B6%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A6%A8-%E0%A6%AD%E0%A7%81%E0%A7%9F%E0%A6%BE-%E0%A6%AD%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A6%93-%E0%A6%9B%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A7%87</guid>
      <pubDate>Tue, 10 Nov 2026 21:26:29 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/7aa1be5ba75e0fdc3122ac1c889d19b9-6af3379e934a3.jpeg?jadewits_media_id=241624" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/7aa1be5ba75e0fdc3122ac1c889d19b9-6af3379e934a3.jpeg?jadewits_media_id=241624" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/7aa1be5ba75e0fdc3122ac1c889d19b9-6af3379e934a3.jpeg?jadewits_media_id=241624" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাংবাদিক রাজেশকে নির্যাতন, ভুয়া ভিডিও ছড়িয়ে অপপ্রচারের অভিযোগ" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর হাজারীবাগ, লালবাগ ও চকবাজার এলাকায় মাদক ব্যবসা, চাঁদাবাজি ও অপরাধী চক্রের বিরুদ্ধে সংবাদ প্রকাশের জেরে সাংবাদিক মোহাম্মদ রাজেশ গনিকে অপহরণ ও শারীরিক নির্যাতনের অভিযোগ উঠেছে। একই সঙ্গে অস্ত্রের মুখে জিম্মি করে জোরপূর্বক ভিডিও ধারণ এবং পরে সামাজিক যোগাযোগমাধ্যমে তা ছড়িয়ে দিয়ে তাঁকে ব্ল্যাকমেই&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734173/%E0%A6%B8%E0%A6%BE%E0%A6%82%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A6%BF%E0%A6%95-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A7%87%E0%A6%B6%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A6%A8-%E0%A6%AD%E0%A7%81%E0%A7%9F%E0%A6%BE-%E0%A6%AD%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A6%93-%E0%A6%9B%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A7%87">দেশ রূপান্তর</source>

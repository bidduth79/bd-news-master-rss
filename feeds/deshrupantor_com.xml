    <item>
      <title>আরব আমিরাতে সড়ক দুর্ঘটনায় নিহত ১৪, আহত ৩০</title>
      <link>https://www.deshrupantor.com/734729/%E0%A6%86%E0%A6%B0%E0%A6%AC-%E0%A6%86%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A7%9C%E0%A6%95-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A7%A7%E0%A7%AA-%E0%A6%86%E0%A6%B9%E0%A6%A4-%E0%A7%A9%E0%A7%A6</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734729/%E0%A6%86%E0%A6%B0%E0%A6%AC-%E0%A6%86%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A7%9C%E0%A6%95-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A7%A7%E0%A7%AA-%E0%A6%86%E0%A6%B9%E0%A6%A4-%E0%A7%A9%E0%A7%A6</guid>
      <pubDate>Fri, 13 Nov 2026 01:00:29 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/c034f587814dddd191be635c3812b35d-6af60c823cc38.jpg?jadewits_media_id=242129" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/c034f587814dddd191be635c3812b35d-6af60c823cc38.jpg?jadewits_media_id=242129" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/c034f587814dddd191be635c3812b35d-6af60c823cc38.jpg?jadewits_media_id=242129" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আরব আমিরাতে সড়ক দুর্ঘটনায় নিহত ১৪, আহত ৩০" /&gt;&lt;/p&gt;&lt;p&gt;সংযুক্ত আরব আমিরাতের (ইউএই) ফুজাইরাহ আমিরাতে ভয়াবহ সড়ক দুর্ঘটনায় অন্তত ১৪ জন নিহত হয়েছেন। এ ঘটনায় আহত হয়েছেন আরও ৩০ জন। দুর্ঘটনায় ১৮টি গাড়ি ও পাঁচটি ট্রাক জড়িত ছিল বলে জানিয়েছে দেশটির স্বরাষ্ট্র মন্ত্রণালয়।
বৃহস্পতিবার স্বরাষ্ট্র মন্ত্রণালয়ের দেওয়া এক বিবৃতিতে বলা হয়, বুধবার স্থানীয় সময় মধ্যরাতের কি&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734729/%E0%A6%86%E0%A6%B0%E0%A6%AC-%E0%A6%86%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A7%9C%E0%A6%95-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A7%A7%E0%A7%AA-%E0%A6%86%E0%A6%B9%E0%A6%A4-%E0%A7%A9%E0%A7%A6">দেশ রূপান্তর</source>
    </item>

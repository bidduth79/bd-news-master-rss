      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/684b7a261a4ed9e812aaaa309d11b96a-6b008fd7c4d2b.jpg?jadewits_media_id=244037" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/684b7a261a4ed9e812aaaa309d11b96a-6b008fd7c4d2b.jpg?jadewits_media_id=244037" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/684b7a261a4ed9e812aaaa309d11b96a-6b008fd7c4d2b.jpg?jadewits_media_id=244037" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মাঠে ব্যর্থতা, পুরস্কারে সাফল্য!" /&gt;&lt;/p&gt;&lt;p&gt;নতুন কোচ, একঝাঁক প্রবাসী ফুটবলার ও বাড়তি প্রত্যাশা সব মিলিয়ে ২০২৬ সাল বাংলাদেশের ফুটবলে নতুন স্বপ্নের বছর হলেও মাঠের পারফরম্যান্স ছিল হতাশাজনক। বছরজুড়ে ৯ ম্যাচ খেলে মাত্র ৩ জয়ের বিপরীতে ৬ হার দেখেছে বাংলাদেশ। গোল করেছে ৯টি, হজম করেছে ১৯টি।
মাঠের ফুটবলে নেই প্রত্যাশিত সাফল্য, আন্তর্জাতিক প্রতিযোগিতায়&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736698/%E0%A6%AE%E0%A6%BE%E0%A6%A0%E0%A7%87-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%A4%E0%A6%BE-%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%AB%E0%A6%B2%E0%A7%8D%E0%A6%AF">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>দলে থেকে পানি টানতে চাইনি</title>
      <link>https://www.deshrupantor.com/736697/%E0%A6%A6%E0%A6%B2%E0%A7%87-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%A8%E0%A6%A4%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%87%E0%A6%A8%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736697/%E0%A6%A6%E0%A6%B2%E0%A7%87-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%A8%E0%A6%A4%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%87%E0%A6%A8%E0%A6%BF</guid>
      <pubDate>Sat, 21 Nov 2026 00:21:49 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/416d183fe3ed969d1757fb48407d8074-6b008fb30f258.jpg?jadewits_media_id=244036" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/416d183fe3ed969d1757fb48407d8074-6b008fb30f258.jpg?jadewits_media_id=244036" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/416d183fe3ed969d1757fb48407d8074-6b008fb30f258.jpg?jadewits_media_id=244036" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দলে থেকে পানি টানতে চাইনি" /&gt;&lt;/p&gt;&lt;p&gt;সদ্য শেষ হওয়া জাতীয় ক্রিকেট লিগে (এনসিএল) সর্বোচ্চ রান সংগ্রাহক হওয়ার পাশাপাশি টুর্নামেন্টসেরা হয়েছেন রংপুর বিভাগের মীম মোসাদ্দেক। ১৪ ইনিংসে ৩টি সেঞ্চুরি ও ৫টি ফিফটির সাহায্যে ৫৭.৪৩ গড়ে ৮০৪ রান করার পাশাপাশি ১৪টি ডিসমিসালের মালিক এই উইকেটরক্ষক-ব্যাটসম্যান। তবে এমন সফলতার পরও ভবিষ্যৎ নিয়ে অনিশ্চয়তার&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736697/%E0%A6%A6%E0%A6%B2%E0%A7%87-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%A8%E0%A6%A4%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%87%E0%A6%A8%E0%A6%BF">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>তমা-মাহিকে সঙ্গে নিয়ে মস্তান-এ শুভ</title>
      <link>https://www.deshrupantor.com/736696/%E0%A6%A4%E0%A6%AE%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8-%E0%A6%8F-%E0%A6%B6%E0%A7%81%E0%A6%AD</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736696/%E0%A6%A4%E0%A6%AE%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8-%E0%A6%8F-%E0%A6%B6%E0%A7%81%E0%A6%AD</guid>
      <pubDate>Sat, 21 Nov 2026 00:21:16 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/8730573934489433fc180965376e0158-6b008f9456e17.jpg?jadewits_media_id=244035" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/8730573934489433fc180965376e0158-6b008f9456e17.jpg?jadewits_media_id=244035" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/8730573934489433fc180965376e0158-6b008f9456e17.jpg?jadewits_media_id=244035" style="max-width:100%;height:auto;margin-bottom:10px;" alt="তমা-মাহিকে সঙ্গে নিয়ে মস্তান-এ শুভ" /&gt;&lt;/p&gt;&lt;p&gt;আন্ডারওয়ার্ল্ড ও গ্যাংস্টারদের জগৎ নিয়ে নির্মিত হতে যাচ্ছে পূর্ণদৈর্ঘ্য চলচ্চিত্র &amp;lsquo;মস্তান&amp;rsquo;। এই সিনেমায় দেখা যাবে আরিফিন শুভকে। তার সঙ্গে পর্দা ভাগ করবেন তমা মির্জা ও সামিরা খান মাহি। নির্মাতা কিসলু গোলাম হায়দারের প্রথম চলচ্চিত্র এটি।
বিজ্ঞাপন নির্মাণে দুই দশকের বেশি সময় পার করার পাশাপাশি&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736696/%E0%A6%A4%E0%A6%AE%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8-%E0%A6%8F-%E0%A6%B6%E0%A7%81%E0%A6%AD">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>এবার যুক্তরাষ্ট্রে সেরা অভিনেত্রী তুষি</title>
      <link>https://www.deshrupantor.com/736695/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A7%87%E0%A6%B0%E0%A6%BE-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%A4%E0%A7%81%E0%A6%B7%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736695/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A7%87%E0%A6%B0%E0%A6%BE-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%A4%E0%A7%81%E0%A6%B7%E0%A6%BF</guid>

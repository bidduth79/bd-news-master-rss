      <guid isPermaLink="true">https://www.deshrupantor.com/737643/%E0%A6%A4%E0%A6%A5%E0%A7%8D%E0%A6%AF-%E0%A6%95%E0%A6%AE%E0%A6%BF%E0%A6%B6%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%A4%E0%A6%A5%E0%A7%8D%E0%A6%AF-%E0%A6%85%E0%A6%A7%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Tue, 24 Nov 2026 21:46:29 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/c1b9d0bf296fcad148249fc62f507412-6b05b12b765fe.jpg?jadewits_media_id=244959" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/c1b9d0bf296fcad148249fc62f507412-6b05b12b765fe.jpg?jadewits_media_id=244959" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/c1b9d0bf296fcad148249fc62f507412-6b05b12b765fe.jpg?jadewits_media_id=244959" style="max-width:100%;height:auto;margin-bottom:10px;" alt="তথ্য কমিশনকে কার্যকর করতে তথ্য অধিকার ফোরামের আহ্বান" /&gt;&lt;/p&gt;&lt;p&gt;তথ্য অধিকার আইনের যথাযথ বাস্তবায়ন এবং তথ্য কমিশনকে স্বাধীন, গতিশীল ও কার্যকর করতে প্রয়োজনীয় পদক্ষেপ নেওয়ার আহ্বান জানিয়েছে তথ্য অধিকার ফোরাম। কমিশনারদের পদমর্যাদা, সুযোগ-সুবিধা, পর্যাপ্ত জনবল ও বাজেট নিশ্চিত করার পাশাপাশি একজন পূর্ণ সচিব নিয়োগেরও দাবি জানিয়েছে সংগঠনটি।
মঙ্গলবার (২৪ নভেম্বর) নতুন তথ্&lt;/p&gt;</description>

    <item>
      <title>২১ নভেম্বর ঢাকা সেনানিবাসে যান চলাচল সীমিত থাকবে</title>
      <link>https://www.deshrupantor.com/736291/%E0%A7%A8%E0%A7%A7-%E0%A6%A8%E0%A6%AD%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%B8%E0%A7%87%E0%A6%A8%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A6%9A%E0%A6%B2%E0%A6%BE%E0%A6%9A%E0%A6%B2-%E0%A6%B8%E0%A7%80%E0%A6%AE%E0%A6%BF%E0%A6%A4-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%AC%E0%A7%87</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736291/%E0%A7%A8%E0%A7%A7-%E0%A6%A8%E0%A6%AD%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%B8%E0%A7%87%E0%A6%A8%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A6%9A%E0%A6%B2%E0%A6%BE%E0%A6%9A%E0%A6%B2-%E0%A6%B8%E0%A7%80%E0%A6%AE%E0%A6%BF%E0%A6%A4-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%AC%E0%A7%87</guid>
      <pubDate>Thu, 19 Nov 2026 07:38:26 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/03988f864549f889688234a254d2ce68-6afe5120869bb.jpg?jadewits_media_id=243654" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/03988f864549f889688234a254d2ce68-6afe5120869bb.jpg?jadewits_media_id=243654" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/03988f864549f889688234a254d2ce68-6afe5120869bb.jpg?jadewits_media_id=243654" style="max-width:100%;height:auto;margin-bottom:10px;" alt="২১ নভেম্বর ঢাকা সেনানিবাসে যান চলাচল সীমিত থাকবে" /&gt;&lt;/p&gt;&lt;p&gt;সশস্ত্র বাহিনী দিবস উপলক্ষে আগামী ২১ নভেম্বর ঢাকা সেনানিবাসে বিভিন্ন কর্মসূচি পালিত হবে।
এদিন ঢাকা সেনানিবাসের রাস্তাগুলো (শহীদ জাহাঙ্গীর গেট থেকে স্টাফ রোড পর্যন্ত প্রধান সড়ক) যানজট মুক্ত রাখার লক্ষে সেনানিবাসে অবস্থানকারী ব্যক্তিবর্গ এবং আমন্ত্রিত অতিথিদের বহনকারী যানবাহন ছাড়া সব প্রকার যানবাহন সক&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736291/%E0%A7%A8%E0%A7%A7-%E0%A6%A8%E0%A6%AD%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%B8%E0%A7%87%E0%A6%A8%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A6%9A%E0%A6%B2%E0%A6%BE%E0%A6%9A%E0%A6%B2-%E0%A6%B8%E0%A7%80%E0%A6%AE%E0%A6%BF%E0%A6%A4-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%AC%E0%A7%87">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>প্রাক্তন স্বামীর ইটের আঘাতে স্ত্রী নিহত</title>
      <link>https://www.deshrupantor.com/736290/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%A8-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%B0-%E0%A6%87%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%98%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736290/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%A8-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%B0-%E0%A6%87%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%98%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4</guid>
      <pubDate>Thu, 19 Nov 2026 07:38:01 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/03988f864549f889688234a254d2ce68-6afe5120869bb.jpg?jadewits_media_id=243654" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/03988f864549f889688234a254d2ce68-6afe5120869bb.jpg?jadewits_media_id=243654" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/03988f864549f889688234a254d2ce68-6afe5120869bb.jpg?jadewits_media_id=243654" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রাক্তন স্বামীর ইটের আঘাতে স্ত্রী নিহত" /&gt;&lt;/p&gt;&lt;p&gt;ঝিনাইদহে শহরের কাঞ্চননগর বাবুর আলীর মোড় এলাকায় প্রাক্তন স্বামীর ইটের আঘাতে স্ত্রী সুমাইয়া খাতুন সুমা (২৬) নিহত হয়েছেন। গতকাল বুধবার সকাল ১০টার দিকে এ ঘটনা ঘটে। ঘটনার পরপরই স্বামী এনামুল হক মিরাজকে আটক করেছে পুলিশ।
&amp;nbsp;						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736290/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%A8-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%B0-%E0%A6%87%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%98%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>শিক্ষার্থী ধর্ষণে স্কুলশিক্ষকের যাবজ্জীবন</title>
      <link>https://www.deshrupantor.com/736289/%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80-%E0%A6%A7%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A6%A3%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AF%E0%A6%BE%E0%A6%AC%E0%A6%9C%E0%A7%8D%E0%A6%9C%E0%A7%80%E0%A6%AC%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736289/%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80-%E0%A6%A7%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A6%A3%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AF%E0%A6%BE%E0%A6%AC%E0%A6%9C%E0%A7%8D%E0%A6%9C%E0%A7%80%E0%A6%AC%E0%A6%A8</guid>
      <pubDate>Thu, 19 Nov 2026 07:37:43 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/03988f864549f889688234a254d2ce68-6afe5120869bb.jpg?jadewits_media_id=243654" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/03988f864549f889688234a254d2ce68-6afe5120869bb.jpg?jadewits_media_id=243654" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/03988f864549f889688234a254d2ce68-6afe5120869bb.jpg?jadewits_media_id=243654" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শিক্ষার্থী ধর্ষণে স্কুলশিক্ষকের যাবজ্জীবন" /&gt;&lt;/p&gt;&lt;p&gt;লালমনিরহাটে বিয়ের প্রলোভন দেখিয়ে ১৭ বছর বয়সী এক কিশোরী শিক্ষার্থীকে ধর্ষণের দায়ে মো. নুরুজ্জামান (৪০) নামের এক স্কুলশিক্ষককে যাবজ্জীবন সশ্রম কারাদ- দিয়েছে আদালত। পাশাপাশি তাকে ১ লাখ টাকা জরিমানা, অনাদায়ে আরও ছয় মাসের সশ্রম কারাদ-ের আদেশ দেওয়া হয়েছে। গতকাল বুধবার দুপুরে লালমনিরহাট নারী ও শিশু নির্যাত&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736289/%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80-%E0%A6%A7%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A6%A3%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AF%E0%A6%BE%E0%A6%AC%E0%A6%9C%E0%A7%8D%E0%A6%9C%E0%A7%80%E0%A6%AC%E0%A6%A8">দেশ রূপান্তর</source>
    </item>

      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/d97806f0fa537faec37f8488f8119f64-6b01f39bc612f.jpg?jadewits_media_id=244250" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/d97806f0fa537faec37f8488f8119f64-6b01f39bc612f.jpg?jadewits_media_id=244250" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/d97806f0fa537faec37f8488f8119f64-6b01f39bc612f.jpg?jadewits_media_id=244250" style="max-width:100%;height:auto;margin-bottom:10px;" alt="খুলনায় বিএনপি নেতা গুলিবিদ্ধ" /&gt;&lt;/p&gt;&lt;p&gt;খুলনার তেরখাদা উপজেলায় মাফিক সরদার নামে এক বিএনপি নেতাকে গুলি করেছে দুর্বৃত্তরা। শনিবার (২১ নভেম্বর) রাত ১১টার দিকে উপজেলার মোকামপুর বাজার সংলগ্ন এলাকায় এ ঘটনা ঘটে। গুলিবিদ্ধ মাফিক সরদার উত্তর মোকামপুর গ্রামের আবুল হোসেনের ছেলে।
পুলিশ ও স্থানীয় সূত্রে জানা গেছে, শনিবার রাত ১১টার দিকে তিনি মোকামপু&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736910/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>জাবিতে বিতর্ক উৎসবে ৯৬ শিক্ষাপ্রতিষ্ঠানের অংশগ্রহণ</title>
      <link>https://www.deshrupantor.com/736909/%E0%A6%9C%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%95-%E0%A6%89%E0%A7%8E%E0%A6%B8%E0%A6%AC%E0%A7%87-%E0%A7%AF%E0%A7%AC-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%82%E0%A6%B6%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%B9%E0%A6%A3</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736909/%E0%A6%9C%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%95-%E0%A6%89%E0%A7%8E%E0%A6%B8%E0%A6%AC%E0%A7%87-%E0%A7%AF%E0%A7%AC-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%82%E0%A6%B6%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%B9%E0%A6%A3</guid>
      <pubDate>Sun, 22 Nov 2026 00:50:42 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/27524fb80f114e37c173c60b32a5bcff-6b01e7fde6613.jpg?jadewits_media_id=244249" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/27524fb80f114e37c173c60b32a5bcff-6b01e7fde6613.jpg?jadewits_media_id=244249" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/27524fb80f114e37c173c60b32a5bcff-6b01e7fde6613.jpg?jadewits_media_id=244249" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জাবিতে বিতর্ক উৎসবে ৯৬ শিক্ষাপ্রতিষ্ঠানের অংশগ্রহণ" /&gt;&lt;/p&gt;&lt;p&gt;জাহাঙ্গীরনগর বিশ্ববিদ্যালয়ে (জাবি) আয়োজিত জাতীয় বিতর্ক উৎসবে দেশের ৯৬টি শিক্ষাপ্রতিষ্ঠানের বিতার্কিকরা অংশ নিয়েছেন। এ উৎসবে স্কুল, কলেজ ও বিশ্ববিদ্যালয় পর্যায়ে বিতর্ক প্রতিযোগিতায় পাঁচ শতাধিক বিতার্কিক ও বিচারক অংশ নেন।
শনিবার (২১ নভেম্বর) বিশ্ববিদ্যালয়ে জাহাঙ্গীরনগর ইউনিভার্সিটি ডিবেট অর্গানাইজেশন &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736909/%E0%A6%9C%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%95-%E0%A6%89%E0%A7%8E%E0%A6%B8%E0%A6%AC%E0%A7%87-%E0%A7%AF%E0%A7%AC-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%82%E0%A6%B6%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%B9%E0%A6%A3">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>বেড়ায় আ.লীগ-বিএনপির সংঘর্ষের ঘটনায় তাৎক্ষণিকভাবে ওসি প্রত্যাহার</title>
      <link>https://www.deshrupantor.com/736908/%E0%A6%AC%E0%A7%87%E0%A7%9C%E0%A6%BE%E0%A7%9F-%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%B0-%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%A4%E0%A6%BE%E0%A7%8E%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A3%E0%A6%BF%E0%A6%95%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736908/%E0%A6%AC%E0%A7%87%E0%A7%9C%E0%A6%BE%E0%A7%9F-%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%B0-%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%A4%E0%A6%BE%E0%A7%8E%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A3%E0%A6%BF%E0%A6%95%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87</guid>
      <pubDate>Sun, 22 Nov 2026 00:44:10 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/0548f222d9c3db909a980be0e9ce0cea-6b01e66ee91ad.jpg?jadewits_media_id=244248" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/0548f222d9c3db909a980be0e9ce0cea-6b01e66ee91ad.jpg?jadewits_media_id=244248" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/0548f222d9c3db909a980be0e9ce0cea-6b01e66ee91ad.jpg?jadewits_media_id=244248" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বেড়ায় আ.লীগ-বিএনপির সংঘর্ষের ঘটনায় তাৎক্ষণিকভাবে ওসি প্রত্যাহার" /&gt;&lt;/p&gt;&lt;p&gt;পাবনার বেড়া উপজেলায় কার্যক্রম নিষিদ্ধ আওয়ামী লীগের নেতাকর্মীদের সঙ্গে বিএনপির নেতাকর্মীদের টানা তিন দিন ধরে দফায় দফায় সংঘর্ষের ঘটনায় বেড়া মডেল থানার ভারপ্রাপ্ত কর্মকর্তা (ওসি) নয়ন কুমার সরকারকে প্রত্যাহার করা হয়েছে। তাকে তাৎক্ষণিকভাবে প্রত্যাহার করে পাবনা সদর সার্কেল অফিসের ইন্সপেক্টর গোলাম মোস্ত&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736908/%E0%A6%AC%E0%A7%87%E0%A7%9C%E0%A6%BE%E0%A7%9F-%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%B0-%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%A4%E0%A6%BE%E0%A7%8E%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A3%E0%A6%BF%E0%A6%95%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>নিরাপত্তা, ন্যায়বিচার ও নির্ভরযোগ্য সুরক্ষা</title>
      <link>https://www.deshrupantor.com/736907/%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BE-%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A7%9F%E0%A6%AC%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%93-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AD%E0%A6%B0%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A7%81%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736907/%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BE-%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A7%9F%E0%A6%AC%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%93-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AD%E0%A6%B0%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A7%81%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE</guid>
      <pubDate>Sun, 22 Nov 2026 00:29:51 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/08d6eb99002dc320acca624aff74be6c-6b01e3179241e.jpg?jadewits_media_id=244247" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/08d6eb99002dc320acca624aff74be6c-6b01e3179241e.jpg?jadewits_media_id=244247" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/08d6eb99002dc320acca624aff74be6c-6b01e3179241e.jpg?jadewits_media_id=244247" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নিরাপত্তা, ন্যায়বিচার ও নির্ভরযোগ্য সুরক্ষা" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জের টুঙ্গিপাড়া ও কাশিয়ানীতে সাম্প্রতিক সহিংসতা বাংলাদেশের রাজনৈতিক বাস্তবতার সামনে একটি গুরুতর প্রশ্ন হাজির করেছে : রাষ্ট্রের আইনশৃঙ্খলা রক্ষাকারী বাহিনী যদি নিজেদের নিরাপত্তা নিয়েই উদ্বিগ্ন হয়ে পড়ে, সাধারণ মানুষের নিরাপত্তা নিশ্চিত করবে কে? রাজনৈতিক সংঘাত, প্রতিশোধের আশঙ্কা, সড়ক অবরোধ, সরকা&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736907/%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BE-%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A7%9F%E0%A6%AC%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%93-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AD%E0%A6%B0%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A7%81%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>সর্বত্র হুমকির মুখে জীববৈচিত্র্য</title>
      <link>https://www.deshrupantor.com/736906/%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%95%E0%A6%BF%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%87-%E0%A6%9C%E0%A7%80%E0%A6%AC%E0%A6%AC%E0%A7%88%E0%A6%9A%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%8D%E0%A6%AF</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736906/%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%95%E0%A6%BF%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%87-%E0%A6%9C%E0%A7%80%E0%A6%AC%E0%A6%AC%E0%A7%88%E0%A6%9A%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%8D%E0%A6%AF</guid>
      <pubDate>Sun, 22 Nov 2026 00:28:31 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/dba09504e463019f89a1f7b34d7c5a48-6b01e2c90cb06.jpg?jadewits_media_id=244246" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/dba09504e463019f89a1f7b34d7c5a48-6b01e2c90cb06.jpg?jadewits_media_id=244246" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/dba09504e463019f89a1f7b34d7c5a48-6b01e2c90cb06.jpg?jadewits_media_id=244246" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সর্বত্র হুমকির মুখে জীববৈচিত্র্য" /&gt;&lt;/p&gt;&lt;p&gt;জীববৈচিত্র্যের পরিপূর্ণ নেত্রকোনা অঞ্চলের হাওর, পাহাড় ও সমতলের বনাঞ্চল। নেত্রকোনা জেলার ১৩৫টি হাওর, শত শত বিল, ১১৫টি নদী, পুকুর, খাল ও বিস্তৃত খোলা মাঠ, উত্তরে গারো পাহাড়ের পাদদেশ এবং উর্বর সমতলের সমন্বয়ে এক অনন্য প্রাকৃতিক পরিবেশের অধিকারী। এই বৈচিত্র্যময় ভূ-প্রকৃতির কারণে নেত্রকোনা দেশীয় ও পরিযায়ী&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736906/%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%95%E0%A6%BF%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%87-%E0%A6%9C%E0%A7%80%E0%A6%AC%E0%A6%AC%E0%A7%88%E0%A6%9A%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%8D%E0%A6%AF">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>উচ্চশিক্ষায় অনাচারের ছায়া</title>
      <link>https://www.deshrupantor.com/736905/%E0%A6%89%E0%A6%9A%E0%A7%8D%E0%A6%9A%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A7%9F-%E0%A6%85%E0%A6%A8%E0%A6%BE%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%9B%E0%A6%BE%E0%A7%9F%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736905/%E0%A6%89%E0%A6%9A%E0%A7%8D%E0%A6%9A%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A7%9F-%E0%A6%85%E0%A6%A8%E0%A6%BE%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%9B%E0%A6%BE%E0%A7%9F%E0%A6%BE</guid>
      <pubDate>Sun, 22 Nov 2026 00:28:04 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/5ab4c8b5a7e4ba419a468ee7005bc908-6b01e2af037a7.jpg?jadewits_media_id=244245" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/5ab4c8b5a7e4ba419a468ee7005bc908-6b01e2af037a7.jpg?jadewits_media_id=244245" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/5ab4c8b5a7e4ba419a468ee7005bc908-6b01e2af037a7.jpg?jadewits_media_id=244245" style="max-width:100%;height:auto;margin-bottom:10px;" alt="উচ্চশিক্ষায় অনাচারের ছায়া" /&gt;&lt;/p&gt;&lt;p&gt;&amp;lsquo;শেখাতে গেলেই শেখা হয়&amp;rsquo; এই জাপানি প্রবাদটির গভীরতা আর মর্মার্থ অনুসরণের প্রক্রিয়া আমাদের শিক্ষা জগতে বহু ক্ষেত্রেই অপাঙ্ক্তেয়। শিক্ষা নিয়ে আমাদের সমাজে অনেক &amp;lsquo;অমিয় বাণী&amp;rsquo; বহুল চর্চিত হলেও এর উল্টোটাই নানাভাবে ফিরে ফিরে দৃশ্যমান হয়ে ওঠে এবং এরই ফের প্রতিফলন দেখা গেছে ২১ নভেম্বর দ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736905/%E0%A6%89%E0%A6%9A%E0%A7%8D%E0%A6%9A%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A7%9F-%E0%A6%85%E0%A6%A8%E0%A6%BE%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%9B%E0%A6%BE%E0%A7%9F%E0%A6%BE">দেশ রূপান্তর</source>
    </item>

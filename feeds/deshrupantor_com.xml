    <item>
      <title>জমি দখলের অভিযোগে নুসরাত তাবাসসুম জ্যোতির পিতার বিরুদ্ধে মামলা</title>
      <link>https://www.deshrupantor.com/735188/%E0%A6%9C%E0%A6%AE%E0%A6%BF-%E0%A6%A6%E0%A6%96%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%87-%E0%A6%A8%E0%A7%81%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%A4-%E0%A6%A4%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%B8%E0%A7%81%E0%A6%AE-%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A6%BF%E0%A6%A4%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735188/%E0%A6%9C%E0%A6%AE%E0%A6%BF-%E0%A6%A6%E0%A6%96%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%87-%E0%A6%A8%E0%A7%81%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%A4-%E0%A6%A4%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%B8%E0%A7%81%E0%A6%AE-%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A6%BF%E0%A6%A4%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Sat, 14 Nov 2026 21:29:25 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/41375e9342acbf08d4a0e6909d898bcb-6af87e31738f4.jpg?jadewits_media_id=242597" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/41375e9342acbf08d4a0e6909d898bcb-6af87e31738f4.jpg?jadewits_media_id=242597" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/41375e9342acbf08d4a0e6909d898bcb-6af87e31738f4.jpg?jadewits_media_id=242597" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জমি দখলের অভিযোগে নুসরাত তাবাসসুম জ্যোতির পিতার বিরুদ্ধে মামলা" /&gt;&lt;/p&gt;&lt;p&gt;কুষ্টিয়ার দৌলতপুরে এক বছর পূর্বে মব সন্ত্রাস করে ঘরবাড়ি ভাংচুর, মারধর ও উচ্ছেদ করে জমি দখলের অভিযোগ এনে এনসিপি নেত্রী নুসরাত তাবাসসুম জ্যোতির পিতা আব্দুল হালিম ওরফে টম মাস্টারের নামোল্লেকসহ অজ্ঞাত ৮/১০ জনের বিরুদ্ধে দৌলতপুর থানায় মামলা করে করেছেন এক বৃদ্ধ কৃষক।&amp;nbsp;
বিষয়টি নিশ্চিত করে দৌলতপুর থানার&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735188/%E0%A6%9C%E0%A6%AE%E0%A6%BF-%E0%A6%A6%E0%A6%96%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%87-%E0%A6%A8%E0%A7%81%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%A4-%E0%A6%A4%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%B8%E0%A7%81%E0%A6%AE-%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A6%BF%E0%A6%A4%E0%A6%BE%E0%A6%B0">দেশ রূপান্তর</source>

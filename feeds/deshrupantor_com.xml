      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/10/27/4e781761bcb3ae179158f63b9b41d0d3-6ae08eb6bc084.jpg?jadewits_media_id=238179" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/10/27/4e781761bcb3ae179158f63b9b41d0d3-6ae08eb6bc084.jpg?jadewits_media_id=238179" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/10/27/4e781761bcb3ae179158f63b9b41d0d3-6ae08eb6bc084.jpg?jadewits_media_id=238179" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যানজট নিরসনে 'মনোরেল' ও এআই সিগন্যালের পরিকল্পনা সরকারের" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানী ঢাকার তীব্র যানজট নিরসন ও গণপরিবহন ব্যবস্থাকে আধুনিকায়ন করতে মেট্রোরেলের পাশাপাশি এবার &amp;lsquo;মনোরেল&amp;rsquo; চালুর বিষয়ে অত্যন্ত গুরুত্বের সাথে চিন্তাভাবনা করছে সরকার। একই সাথে আগামী দুই মাসের মধ্যে রাজধানীর ৫০টি পয়েন্টে কৃত্রিম বুদ্ধিমত্তা (এআই) সম্পন্ন আধুনিক ট্রাফিক সিগন্যাল ব্যবস্থা পুরোদ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736168/%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A6%9C%E0%A6%9F-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%B8%E0%A6%A8%E0%A7%87-%E0%A6%AE%E0%A6%A8%E0%A7%8B%E0%A6%B0%E0%A7%87%E0%A6%B2-%E0%A6%93-%E0%A6%8F%E0%A6%86%E0%A6%87-%E0%A6%B8%E0%A6%BF%E0%A6%97%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A6%A8%E0%A6%BE">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>পাঁচ লাখ শিশুকে স্বাস্থ্যবিধি শেখানোর উদ্যোগ, অ্যানিমেটেড সিরিজ চালু হারপিকের</title>

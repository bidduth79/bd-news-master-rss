    <item>
      <title>সেনেগালের উপকূলে অভিবাসীবাহী নৌকা ডুবে নিহত ২১</title>
      <link>https://www.deshrupantor.com/733625/%E0%A6%B8%E0%A7%87%E0%A6%A8%E0%A7%87%E0%A6%97%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%89%E0%A6%AA%E0%A6%95%E0%A7%82%E0%A6%B2%E0%A7%87-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%80%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A7%80-%E0%A6%A8%E0%A7%8C%E0%A6%95%E0%A6%BE-%E0%A6%A1%E0%A7%81%E0%A6%AC%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A7%A8%E0%A7%A7</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/733625/%E0%A6%B8%E0%A7%87%E0%A6%A8%E0%A7%87%E0%A6%97%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%89%E0%A6%AA%E0%A6%95%E0%A7%82%E0%A6%B2%E0%A7%87-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%80%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A7%80-%E0%A6%A8%E0%A7%8C%E0%A6%95%E0%A6%BE-%E0%A6%A1%E0%A7%81%E0%A6%AC%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A7%A8%E0%A7%A7</guid>
      <pubDate>Sun, 08 Nov 2026 19:41:09 +0600</pubDate>
      <description>পশ্চিম আফ্রিকার দেশ সেনেগালের উপকূলে অভিবাসীবাহী একটি নৌকা ডুবে অন্তত ২১ জনের মৃত্যু হয়েছে। এ ঘটনায় একজনকে জীবিত উদ্ধার করা হয়েছে। রবিবার (৮ নভেম্বর) দেশটির স্বরাষ্ট্র মন্ত্রণালয় এ তথ্য জানিয়েছে। খবর রয়টার্স।&amp;nbsp;
মন্ত্রণালয়ের সামাজিক যোগাযোগমাধ্যম এক্সে দেওয়া বিবৃতিতে বলা হয়, শনিবার সন্ধ্যা পর্যন্</description>
      <source url="https://www.deshrupantor.com/733625/%E0%A6%B8%E0%A7%87%E0%A6%A8%E0%A7%87%E0%A6%97%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%89%E0%A6%AA%E0%A6%95%E0%A7%82%E0%A6%B2%E0%A7%87-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%80%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A7%80-%E0%A6%A8%E0%A7%8C%E0%A6%95%E0%A6%BE-%E0%A6%A1%E0%A7%81%E0%A6%AC%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A7%A8%E0%A7%A7">দেশ রূপান্তর</source>

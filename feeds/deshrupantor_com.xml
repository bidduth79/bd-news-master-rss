    <item>
      <title>আরও এক নতুন পরিচয়ে বুবলী</title>
      <link>https://www.deshrupantor.com/737847/%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A6%8F%E0%A6%95-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%9A%E0%A7%9F%E0%A7%87-%E0%A6%AC%E0%A7%81%E0%A6%AC%E0%A6%B2%E0%A7%80</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737847/%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A6%8F%E0%A6%95-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%9A%E0%A7%9F%E0%A7%87-%E0%A6%AC%E0%A7%81%E0%A6%AC%E0%A6%B2%E0%A7%80</guid>
      <pubDate>Wed, 25 Nov 2026 18:09:16 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/2d87f91963e3701ee270b762e7690b3f-6b06cf0d77e8d.jpg?jadewits_media_id=245152" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/2d87f91963e3701ee270b762e7690b3f-6b06cf0d77e8d.jpg?jadewits_media_id=245152" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/2d87f91963e3701ee270b762e7690b3f-6b06cf0d77e8d.jpg?jadewits_media_id=245152" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আরও এক নতুন পরিচয়ে বুবলী" /&gt;&lt;/p&gt;&lt;p&gt;কন্যা সন্তানের মা হওয়ার পর এখনও নিজেকে প্রকাশ্যে আনেননি। তবে আড়াল থেকেই সোশ্যাল মিডিয়ায় একের পর এক সুখবর দিচ্ছেন চিত্রনায়িকা শবনম ইয়াসমিন বুবলী। প্রযোজক হিসেবে যাত্রা শুরু করার কথা জানান দেয়ার পর আরও এক নতুন পরিচয়ে আত্মপ্রকাশ করতে যাচ্ছেন এই নায়িকা। এবার সরাসরি সিনেমার গানে কণ্ঠ দিতে যাচ্ছেন এই অভিন&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737847/%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A6%8F%E0%A6%95-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%9A%E0%A7%9F%E0%A7%87-%E0%A6%AC%E0%A7%81%E0%A6%AC%E0%A6%B2%E0%A7%80">দেশ রূপান্তর</source>
    </item>

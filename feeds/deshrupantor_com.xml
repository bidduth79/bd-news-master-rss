    <item>
      <title>মাঠে গড়াচ্ছে শাকিবের নতুন সিনেমা</title>
      <link>https://www.deshrupantor.com/738173/%E0%A6%AE%E0%A6%BE%E0%A6%A0%E0%A7%87-%E0%A6%97%E0%A7%9C%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%B6%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%AE%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/738173/%E0%A6%AE%E0%A6%BE%E0%A6%A0%E0%A7%87-%E0%A6%97%E0%A7%9C%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%B6%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%AE%E0%A6%BE</guid>
      <pubDate>Thu, 26 Nov 2026 20:46:36 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/dff80611fc98aa6468a288782cdd745c-6b08454edab03.jpg?jadewits_media_id=245437" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/dff80611fc98aa6468a288782cdd745c-6b08454edab03.jpg?jadewits_media_id=245437" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/dff80611fc98aa6468a288782cdd745c-6b08454edab03.jpg?jadewits_media_id=245437" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মাঠে গড়াচ্ছে শাকিবের নতুন সিনেমা" /&gt;&lt;/p&gt;&lt;p&gt;ডিসেম্বরের প্রথম সপ্তাহেই শুরু হচ্ছে চিত্রতারকা শাকিব খানের নতুন সিনেমার শুটিং। ঈদুল ফিতরে মুক্তির লক্ষ্য নিয়ে সিনেমাটি পরিচালনা করছেন মেহেদী হাসান হৃদয় ও প্রযোনায় রয়েছেন শাহরিন আক্তার সুমি। নির্মাতারা জানান, আগামী ৫ থেকে ৭ ডিসেম্বরের মধ্যেই সিনেমাটির শুটিং।&amp;nbsp;

দেশে ফিরেই বিরামহীন কাজে শাকিব খান&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/738173/%E0%A6%AE%E0%A6%BE%E0%A6%A0%E0%A7%87-%E0%A6%97%E0%A7%9C%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%B6%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%AE%E0%A6%BE">দেশ রূপান্তর</source>
    </item>

      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/efc6e2255f408378a56da5df61e4b9c5-6b091cd483edf.jpg?jadewits_media_id=245540" medium="image" />

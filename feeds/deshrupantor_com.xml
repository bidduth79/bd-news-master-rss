      <guid isPermaLink="true">https://www.deshrupantor.com/737122/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A7%AC%E0%A7%A8%E0%A6%A4%E0%A6%AE-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AE%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%9C%E0%A6%AC%E0%A6%BF-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AB%E0%A6%B2-%E0%A6%89%E0%A7%8E%E0%A6%B8%E0%A6%AC</guid>
      <pubDate>Sun, 22 Nov 2026 22:02:19 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/27032106ef8b65943163a8098976d5c9-6b0311db74f71.jpg?jadewits_media_id=244461" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/27032106ef8b65943163a8098976d5c9-6b0311db74f71.jpg?jadewits_media_id=244461" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/27032106ef8b65943163a8098976d5c9-6b0311db74f71.jpg?jadewits_media_id=244461" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রধানমন্ত্রীর ৬২তম জন্মদিনে জবি ছাত্রদলের ফল উৎসব" /&gt;&lt;/p&gt;&lt;p&gt;প্রধানমন্ত্রী তারেক রহমানের ৬২তম জন্মদিন উপলক্ষে জগন্নাথ বিশ্ববিদ্যালয় (জবি) শাখা ছাত্রদলের উদ্যোগে ৬২ রকমের ফল দিয়ে ফল উৎসবের আয়োজন করা হয়েছে। একই অনুষ্ঠানে শিক্ষার্থীদের মধ্যে ক্রীড়াসামগ্রী বিতরণ করা হয়।
রবিবার (২২ নভেম্বর) বিশ্ববিদ্যালয় ক্যাম্পাসে আয়োজিত এ অনুষ্ঠানে প্রধান অতিথি হিসেবে উপস্থিত ছি&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737122/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A7%AC%E0%A7%A8%E0%A6%A4%E0%A6%AE-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AE%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%9C%E0%A6%AC%E0%A6%BF-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AB%E0%A6%B2-%E0%A6%89%E0%A7%8E%E0%A6%B8%E0%A6%AC">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>চট্টগ্রামে এক বছরের আমলনামা তুলে ধরলেন ডিসি জাহিদ</title>

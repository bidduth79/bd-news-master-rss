    <item>
      <title>‘নারীর সমান অংশগ্রহণেই দেশের উন্নয়ন সম্ভব’</title>
      <link>https://www.deshrupantor.com/736794/%E2%80%98%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%85%E0%A6%82%E0%A6%B6%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%B9%E0%A6%A3%E0%A7%87%E0%A6%87-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A7%9F%E0%A6%A8-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AD%E0%A6%AC%E2%80%99</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736794/%E2%80%98%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%85%E0%A6%82%E0%A6%B6%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%B9%E0%A6%A3%E0%A7%87%E0%A6%87-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A7%9F%E0%A6%A8-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AD%E0%A6%AC%E2%80%99</guid>
      <pubDate>Sat, 21 Nov 2026 15:22:48 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/873e57960a319e3a42317012a0e59cba-6b015feec99a8.jpg?jadewits_media_id=244108" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/873e57960a319e3a42317012a0e59cba-6b015feec99a8.jpg?jadewits_media_id=244108" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/873e57960a319e3a42317012a0e59cba-6b015feec99a8.jpg?jadewits_media_id=244108" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘নারীর সমান অংশগ্রহণেই দেশের উন্নয়ন সম্ভব’" /&gt;&lt;/p&gt;&lt;p&gt;একটি দেশ শুধু পুরুষদের অংশগ্রহণে এগিয়ে যেতে পারে না। দেশের উন্নয়ন ও অগ্রগতি নিশ্চিত করতে নারীদেরও সমানভাবে সম্পৃক্ত করতে হবে বলে মন্তব্য করেছেন লালমনিরহাট-১ (হাতীবান্ধা-পাটগ্রাম) আসনের সংসদ সদস্য ব্যারিস্টার হাসান রাজীব প্রধান।
শনিবার (২১ নভেম্বর) দুপুরে লালমনিরহাটের হাতীবান্ধায় উপজেলা প্রশাসন ও উপজ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736794/%E2%80%98%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%85%E0%A6%82%E0%A6%B6%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%B9%E0%A6%A3%E0%A7%87%E0%A6%87-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A7%9F%E0%A6%A8-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AD%E0%A6%AC%E2%80%99">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>অসময়ের বৃষ্টিতে মাঠেই ভিজল কাটা ধান, বিপাকে কৃষক</title>
      <link>https://www.deshrupantor.com/736793/%E0%A6%85%E0%A6%B8%E0%A6%AE%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%A0%E0%A7%87%E0%A6%87-%E0%A6%AD%E0%A6%BF%E0%A6%9C%E0%A6%B2-%E0%A6%95%E0%A6%BE%E0%A6%9F%E0%A6%BE-%E0%A6%A7%E0%A6%BE%E0%A6%A8-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A7%83%E0%A6%B7%E0%A6%95</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736793/%E0%A6%85%E0%A6%B8%E0%A6%AE%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%A0%E0%A7%87%E0%A6%87-%E0%A6%AD%E0%A6%BF%E0%A6%9C%E0%A6%B2-%E0%A6%95%E0%A6%BE%E0%A6%9F%E0%A6%BE-%E0%A6%A7%E0%A6%BE%E0%A6%A8-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A7%83%E0%A6%B7%E0%A6%95</guid>
      <pubDate>Sat, 21 Nov 2026 15:06:53 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/ca609ec03c35ba4ee1bd101fdf3c1d7a-6b015e849a73c.jpg?jadewits_media_id=244107" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/ca609ec03c35ba4ee1bd101fdf3c1d7a-6b015e849a73c.jpg?jadewits_media_id=244107" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/ca609ec03c35ba4ee1bd101fdf3c1d7a-6b015e849a73c.jpg?jadewits_media_id=244107" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অসময়ের বৃষ্টিতে মাঠেই ভিজল কাটা ধান, বিপাকে কৃষক" /&gt;&lt;/p&gt;&lt;p&gt;রংপুরের পীরগঞ্জে হঠাৎ অসময়ের বৃষ্টিতে মাঠে পড়ে থাকা কাটা আমন ধান নিয়ে বিপাকে পড়েছেন কৃষকরা। সোনালি ফসল ঘরে তোলার আগমুহূর্তে বৃষ্টিতে ভিজে গেছে জমিতে শুকাতে দেওয়া ধান। এতে ধানের গুণগত মান নষ্ট হওয়ার পাশাপাশি আর্থিক ক্ষতির আশঙ্কা দেখা দিয়েছে।
উপজেলা কৃষি অফিস জানায়, পীরগঞ্জে মোট ৩২ হাজার ৮০০ হেক্টর চা&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736793/%E0%A6%85%E0%A6%B8%E0%A6%AE%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%A0%E0%A7%87%E0%A6%87-%E0%A6%AD%E0%A6%BF%E0%A6%9C%E0%A6%B2-%E0%A6%95%E0%A6%BE%E0%A6%9F%E0%A6%BE-%E0%A6%A7%E0%A6%BE%E0%A6%A8-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A7%83%E0%A6%B7%E0%A6%95">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>রিজওয়ান বাদ, পিসিবির কেন্দ্রীয় চুক্তিতে নাসিম শাহর দুই ভাই</title>
      <link>https://www.deshrupantor.com/736791/%E0%A6%B0%E0%A6%BF%E0%A6%9C%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%A8-%E0%A6%AC%E0%A6%BE%E0%A6%A6-%E0%A6%AA%E0%A6%BF%E0%A6%B8%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%95%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A7%9F-%E0%A6%9A%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%AE-%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736791/%E0%A6%B0%E0%A6%BF%E0%A6%9C%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%A8-%E0%A6%AC%E0%A6%BE%E0%A6%A6-%E0%A6%AA%E0%A6%BF%E0%A6%B8%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%95%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A7%9F-%E0%A6%9A%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%AE-%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A6%B0</guid>
      <pubDate>Sat, 21 Nov 2026 15:03:00 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/8a750cb75563aab44d4f2253f2a4bdb4-6b015c72c2e89.jpg?jadewits_media_id=244106" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/8a750cb75563aab44d4f2253f2a4bdb4-6b015c72c2e89.jpg?jadewits_media_id=244106" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/8a750cb75563aab44d4f2253f2a4bdb4-6b015c72c2e89.jpg?jadewits_media_id=244106" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রিজওয়ান বাদ, পিসিবির কেন্দ্রীয় চুক্তিতে নাসিম শাহর দুই ভাই" /&gt;&lt;/p&gt;&lt;p&gt;নতুন কেন্দ্রীয় চুক্তির তালিকা প্রকাশ করেছে পাকিস্তান ক্রিকেট বোর্ড (পিসিবি)। আর সেই তালিকায় সবচেয়ে বড় চমক হয়ে এসেছে মোহাম্মদ রিজওয়ানের বাদ পড়া। গত জুনে আগের চুক্তির মেয়াদ শেষ হওয়ার পর দীর্ঘ বিরতি কাটিয়ে শনিবার ৩৮ ক্রিকেটারকে নতুন চুক্তির আওতায় এনেছে পিসিবি, যেখানে রিজওয়ানের পাশাপাশি জায়গা হারিয়েছেন &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736791/%E0%A6%B0%E0%A6%BF%E0%A6%9C%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%A8-%E0%A6%AC%E0%A6%BE%E0%A6%A6-%E0%A6%AA%E0%A6%BF%E0%A6%B8%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%95%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A7%9F-%E0%A6%9A%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%AE-%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A6%B0">দেশ রূপান্তর</source>

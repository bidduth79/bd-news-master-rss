      <guid isPermaLink="true">https://www.deshrupantor.com/734197/%E0%A6%86%E0%A6%97%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%B9%E0%A6%AC%E0%A7%87-%E0%A6%87%E0%A6%A4%E0%A6%BF%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AC%E0%A6%9A%E0%A7%87%E0%A7%9F%E0%A7%87-%E0%A6%89%E0%A6%B7%E0%A7%8D%E0%A6%A3-%E0%A6%AC%E0%A6%9B%E0%A6%B0</guid>
      <pubDate>Wed, 11 Nov 2026 00:46:00 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/3aebb40ac9bff2b8143eaf5a3d4bfef3-6af3586aa4a9f.jpg?jadewits_media_id=241650" length="0" type="image/jpeg" />

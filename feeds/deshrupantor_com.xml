      <guid isPermaLink="true">https://www.deshrupantor.com/736297/%E0%A6%97%E0%A6%A3%E0%A6%AD%E0%A7%8B%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%B2%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A6%B9%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A6%BF%E0%A6%A4%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%AC%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%A4</guid>
      <pubDate>Thu, 19 Nov 2026 07:41:41 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/03988f864549f889688234a254d2ce68-6afe5120869bb.jpg?jadewits_media_id=243654" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/03988f864549f889688234a254d2ce68-6afe5120869bb.jpg?jadewits_media_id=243654" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/03988f864549f889688234a254d2ce68-6afe5120869bb.jpg?jadewits_media_id=243654" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গণভোটের রায় মানলে সরকারকে সহযোগিতা করবে জামায়াত" /&gt;&lt;/p&gt;&lt;p&gt;গণভোটের রায় মেনে নেওয়ার ঘোষণা দিলে বিরোধী দল হিসেবে সরকারের সব কাজে সহযোগিতা করবে বাংলাদেশ জামায়াতে ইসলামী। একই সঙ্গে গণভোটে অনুমোদিত সংবিধান সংস্কারের প্রস্তাবগুলো বাস্তবায়নে সরকার ও বিরোধী দল সংসদীয় প্রক্রিয়ায় একসঙ্গে কাজ করতে পারবে বলে জানিয়েছেন দলটির সেক্রেটারি জেনারেল মিয়া গোলাম পরওয়ার।
গণভোটের&lt;/p&gt;</description>

      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/23bc0a5160b78f3cb54a00663d5d5e4c-6b008f39b5e63.jpg?jadewits_media_id=244034" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/23bc0a5160b78f3cb54a00663d5d5e4c-6b008f39b5e63.jpg?jadewits_media_id=244034" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/23bc0a5160b78f3cb54a00663d5d5e4c-6b008f39b5e63.jpg?jadewits_media_id=244034" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এবার যুক্তরাষ্ট্রে সেরা অভিনেত্রী তুষি" /&gt;&lt;/p&gt;&lt;p&gt;আন্তর্জাতিক অঙ্গনে সাফল্যের ধারাবাহিকতা বজায় রেখে এবার যুক্তরাষ্ট্রের লস অ্যাঞ্জেলেসে সম্মানজনক পুরস্কার পেলেন অভিনেত্রী নাজিফা তুষি। মেজবাউর রহমান সুমন পরিচালিত &amp;lsquo;রইদ&amp;rsquo; চলচ্চিত্রে অভিনয়ের সুবাদে ২০২৬ সালের এশিয়ান ওয়ার্ল্ড চলচ্চিত্র উৎসবের ১২তম আসরে সেরা অভিনেত্রীর &amp;lsquo;স্নো লেপার্ড&amp;rsqu&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736695/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A7%87%E0%A6%B0%E0%A6%BE-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%A4%E0%A7%81%E0%A6%B7%E0%A6%BF">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>‘মহব্বতে’ শাকিবের নায়িকা কিয়ারা নয় কিনজা হাশমীই</title>
      <link>https://www.deshrupantor.com/736694/%E2%80%98%E0%A6%AE%E0%A6%B9%E0%A6%AC%E0%A7%8D%E0%A6%AC%E0%A6%A4%E0%A7%87%E2%80%99-%E0%A6%B6%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A7%9F%E0%A6%BF%E0%A6%95%E0%A6%BE-%E0%A6%95%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%A8%E0%A7%9F-%E0%A6%95%E0%A6%BF%E0%A6%A8%E0%A6%9C%E0%A6%BE-%E0%A6%B9%E0%A6%BE%E0%A6%B6%E0%A6%AE%E0%A7%80%E0%A6%87</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736694/%E2%80%98%E0%A6%AE%E0%A6%B9%E0%A6%AC%E0%A7%8D%E0%A6%AC%E0%A6%A4%E0%A7%87%E2%80%99-%E0%A6%B6%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A7%9F%E0%A6%BF%E0%A6%95%E0%A6%BE-%E0%A6%95%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%A8%E0%A7%9F-%E0%A6%95%E0%A6%BF%E0%A6%A8%E0%A6%9C%E0%A6%BE-%E0%A6%B9%E0%A6%BE%E0%A6%B6%E0%A6%AE%E0%A7%80%E0%A6%87</guid>
      <pubDate>Sat, 21 Nov 2026 00:19:20 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/84f6f3470212aab6ca67f12599ddca08-6b008f1c11827.jpg?jadewits_media_id=244033" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/84f6f3470212aab6ca67f12599ddca08-6b008f1c11827.jpg?jadewits_media_id=244033" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/84f6f3470212aab6ca67f12599ddca08-6b008f1c11827.jpg?jadewits_media_id=244033" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘মহব্বতে’ শাকিবের নায়িকা কিয়ারা নয় কিনজা হাশমীই" /&gt;&lt;/p&gt;&lt;p&gt;সুপারস্টার শাকিব খানের আসন্ন সিনেমা &amp;lsquo;মহব্বত&amp;rsquo;-এ বলিউড অভিনেত্রী কিয়ারা আদভানি যুক্ত হচ্ছেন সামাজিক যোগাযোগমাধ্যমে ছড়িয়ে পড়া এমন গুঞ্জন, গুঞ্জন হয়েই থাকল। হিমেল আশরাফ পরিচালিত এই সিনেমায় শাকিবের বিপরীতে কিয়ারা নন, পাকিস্তানি অভিনেত্রী কিনজা হাশমীই চূড়ান্ত হয়েছেন।
&amp;lsquo;মহব্বত&amp;rsquo;-এর প্&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736694/%E2%80%98%E0%A6%AE%E0%A6%B9%E0%A6%AC%E0%A7%8D%E0%A6%AC%E0%A6%A4%E0%A7%87%E2%80%99-%E0%A6%B6%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A7%9F%E0%A6%BF%E0%A6%95%E0%A6%BE-%E0%A6%95%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%A8%E0%A7%9F-%E0%A6%95%E0%A6%BF%E0%A6%A8%E0%A6%9C%E0%A6%BE-%E0%A6%B9%E0%A6%BE%E0%A6%B6%E0%A6%AE%E0%A7%80%E0%A6%87">দেশ রূপান্তর</source>

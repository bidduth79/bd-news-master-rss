      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/cff07bf0ebbd43323c5c49b46e6f194e-6aff924ad709a.jpg?jadewits_media_id=243856" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজবন বিহারে কঠিন চীবর দানোৎসব" /&gt;&lt;/p&gt;&lt;p&gt;হাজারো পুণ্যার্থীর অংশগ্রহণে বেইনঘর উদ্বোধন ও চরকায় সুতা কাটার মধ্য দিয়ে রাঙ্গামাটির ঐতিহ্যবাহী রাজবন বিহারে শুরু হয়েছে ৫০তম সুবর্ণজয়ন্তী দানোত্তম কঠিন চীবর দানোৎসব। গতকাল বৃহস্পতিবার বিকেলে চরকায় সুতা কেটে দুই দিনব্যাপী এ ধর্মীয় উৎসবের আনুষ্ঠানিকতা শুরু হয়। রাজবন বিহারের আবাসিক প্রধান শ্রীমৎ প্রজ্ঞ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736520/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%AC%E0%A6%A8-%E0%A6%AC%E0%A6%BF%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%95%E0%A6%A0%E0%A6%BF%E0%A6%A8-%E0%A6%9A%E0%A7%80%E0%A6%AC%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A7%8B%E0%A7%8E%E0%A6%B8%E0%A6%AC">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>সড়কে দুই ভাইসহ নিহত ৪</title>
      <link>https://www.deshrupantor.com/736519/%E0%A6%B8%E0%A7%9C%E0%A6%95%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%AD%E0%A6%BE%E0%A6%87%E0%A6%B8%E0%A6%B9-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A7%AA</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736519/%E0%A6%B8%E0%A7%9C%E0%A6%95%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%AD%E0%A6%BE%E0%A6%87%E0%A6%B8%E0%A6%B9-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A7%AA</guid>
      <pubDate>Fri, 20 Nov 2026 06:42:46 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/c43af5899edd847d04450a36a2559ed3-6aff924c5c7f8.jpg?jadewits_media_id=243864" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/c43af5899edd847d04450a36a2559ed3-6aff924c5c7f8.jpg?jadewits_media_id=243864" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/c43af5899edd847d04450a36a2559ed3-6aff924c5c7f8.jpg?jadewits_media_id=243864" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সড়কে দুই ভাইসহ নিহত ৪" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রামের হাটহাজারীতে দুই মোটরসাইকেলের সংঘর্ষে ইফতেখার মাহমুদ তুষার (৩২) ও ইমতিয়াজ মাহমুদ ইরাত (২৮) নামে আপন দুই ভাইয়ের মর্মান্তিক মৃত্যু হয়েছে। গতকাল বৃহস্পতিবার বেলা আড়াইটার দিকে উপজেলার মির্জাপুর ইউনিয়নের চারিয়া মুছার দোকান এলাকার হাটহাজারী-নাজিরহাট আঞ্চলিক মহাসড়কের ওপর এ দুর্ঘটনা ঘটে।
নিহত তুষ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736519/%E0%A6%B8%E0%A7%9C%E0%A6%95%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%AD%E0%A6%BE%E0%A6%87%E0%A6%B8%E0%A6%B9-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A7%AA">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>১৭ পুলিশ কর্মকর্তাকে বদলি দুইজনকে বরখাস্ত</title>

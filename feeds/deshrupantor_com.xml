    <item>
      <title>মক্কা-মদিনাসহ বিভিন্ন স্থানে বন্যার শঙ্কা</title>
      <link>https://www.deshrupantor.com/734200/%E0%A6%AE%E0%A6%95%E0%A7%8D%E0%A6%95%E0%A6%BE-%E0%A6%AE%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B8%E0%A6%B9-%E0%A6%AC%E0%A6%BF%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%A8-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%B6%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734200/%E0%A6%AE%E0%A6%95%E0%A7%8D%E0%A6%95%E0%A6%BE-%E0%A6%AE%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B8%E0%A6%B9-%E0%A6%AC%E0%A6%BF%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%A8-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%B6%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BE</guid>
      <pubDate>Wed, 11 Nov 2026 01:47:00 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/2cbf8bf41fdb3bae8d1382d3554a524e-6af358d544366.jpg?jadewits_media_id=241653" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/2cbf8bf41fdb3bae8d1382d3554a524e-6af358d544366.jpg?jadewits_media_id=241653" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/2cbf8bf41fdb3bae8d1382d3554a524e-6af358d544366.jpg?jadewits_media_id=241653" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মক্কা-মদিনাসহ বিভিন্ন স্থানে বন্যার শঙ্কা" /&gt;&lt;/p&gt;&lt;p&gt;মরুর দেশ সৌদি আরবে টানা পাঁচ দিন বজ্রপাতসহ মাঝারি থেকে ভারী বৃষ্টি হতে পারে। গতকাল মঙ্গলবার থেকে শুরু হয়ে শনিবার পর্যন্ত চলতে পারে এই বৃষ্টিপাত। এর ফলে কোথাও আকস্মিক বন্যা, শিলাবৃষ্টি ও ঘণ্টায় ৬০ কিলোমিটার বা তার বেশি বেগে ঝোড়ো হওয়া বয়ে যেতে পারে। দেশটির জাতীয় আবহাওয়া কেন্দ্রের পূর্বাভাসে বলা হয়েছে,&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734200/%E0%A6%AE%E0%A6%95%E0%A7%8D%E0%A6%95%E0%A6%BE-%E0%A6%AE%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B8%E0%A6%B9-%E0%A6%AC%E0%A6%BF%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%A8-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%B6%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BE">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>তাহলে শেষ কথা কী</title>
      <link>https://www.deshrupantor.com/734192/%E0%A6%A4%E0%A6%BE%E0%A6%B9%E0%A6%B2%E0%A7%87-%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%95%E0%A6%A5%E0%A6%BE-%E0%A6%95%E0%A7%80</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734192/%E0%A6%A4%E0%A6%BE%E0%A6%B9%E0%A6%B2%E0%A7%87-%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%95%E0%A6%A5%E0%A6%BE-%E0%A6%95%E0%A7%80</guid>

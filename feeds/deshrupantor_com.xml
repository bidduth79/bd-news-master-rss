      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/469209dbc8d83c243c8f91613a91f7ab-6b0a2baf0e310.jpg?jadewits_media_id=245689" length="0" type="image/jpeg" />

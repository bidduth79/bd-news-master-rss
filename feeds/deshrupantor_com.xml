      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/05fb8c2fcf410cb62a774fdc34e6e35b-6af906a4ce3fc.jpg?jadewits_media_id=242655" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/05fb8c2fcf410cb62a774fdc34e6e35b-6af906a4ce3fc.jpg?jadewits_media_id=242655" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/05fb8c2fcf410cb62a774fdc34e6e35b-6af906a4ce3fc.jpg?jadewits_media_id=242655" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডেঙ্গু ও হামের উপসর্গে আরও ১০ জনের মৃত্যু" /&gt;&lt;/p&gt;&lt;p&gt;দেশে গত ২৪ ঘণ্টায় ডেঙ্গুতে আক্রান্ত হয়ে আরও ৮ জনের মৃত্যু হয়েছে। একই সময়ে হামের উপসর্গে ২ শিশু মারা গেছে। গতকাল স্বাস্থ্য অধিদপ্তরের হেলথ ইমার্জেন্সি অপারেশন সেন্টার ও কন্ট্রোলরুম থেকে পাঠানো প্রেস বিজ্ঞপ্তিতে এ তথ্য জানানো হয়।
বিজ্ঞপ্তিতে জানানো হয় শুক্রবার সকাল ৮টা থেকে শনিবার সকাল ৮টা পর্যন্ত ডেঙ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735262/%E0%A6%A1%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%81-%E0%A6%93-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%89%E0%A6%AA%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A7%A7%E0%A7%A6-%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81">দেশ রূপান্তর</source>

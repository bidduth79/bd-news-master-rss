      <guid isPermaLink="true">https://www.deshrupantor.com/736218/%E0%A6%A8%E0%A6%A1%E0%A6%BC%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%87-%E0%A6%86.-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%80</guid>
      <pubDate>Wed, 18 Nov 2026 22:41:51 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/241a8390295013ba8fb9bc827e48cdbe-6afdd2ee78a2e.gif?jadewits_media_id=243600" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/241a8390295013ba8fb9bc827e48cdbe-6afdd2ee78a2e.gif?jadewits_media_id=243600" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/241a8390295013ba8fb9bc827e48cdbe-6afdd2ee78a2e.gif?jadewits_media_id=243600" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নড়াইলে আ. লীগের সঙ্গে সংঘর্ষে বিএনপির দুই কর্মী নিহত" /&gt;&lt;/p&gt;&lt;p&gt;নড়াইলের কালিয়ায় সন্ত্রাস ও নৈরাজ্যের প্রতিবাদে বিএনপি ও সহযোগী অঙ্গসংগঠনের মোটরসাইকেল ও গাড়িবহরে বহরে কার্যক্রম নিষিদ্ধ আওয়ামী লীগের হামলায় দুজন নিহত হয়েছেন। এ সময় বেশ কয়েকটি মোটর সাইকেলে আগুন দেয়া হয়।
বুধবার (১৮ নভেম্বর) সন্ধ্যা সাতটার দিকে এ হামলার ঘটনা ঘটে। নিহতরা হলেন কালিয়া উপজেলা কৃষকদলের সাধা&lt;/p&gt;</description>

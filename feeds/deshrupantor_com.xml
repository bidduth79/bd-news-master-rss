      <guid isPermaLink="true">https://www.deshrupantor.com/733990/%E0%A6%B8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%95%E0%A6%B2%E0%A7%87%E0%A6%9C-%E0%A6%AB%E0%A6%9F%E0%A6%95%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A7%AA</guid>
      <pubDate>Tue, 10 Nov 2026 02:10:23 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/33434b670d451560bd6bcd7bef651912-6af227aeb26cd.jpg?jadewits_media_id=241435" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/33434b670d451560bd6bcd7bef651912-6af227aeb26cd.jpg?jadewits_media_id=241435" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/33434b670d451560bd6bcd7bef651912-6af227aeb26cd.jpg?jadewits_media_id=241435" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সিরাজগঞ্জ সরকারি কলেজ ফটকে ছাত্রলীগের ব্যানার, ৪ ঘণ্টা অবরুদ্ধ অধ্যক্ষ" /&gt;&lt;/p&gt;&lt;p&gt;সিরাজগঞ্জ সরকারি কলেজের প্রধান ফটকে নিষিদ্ধ সংগঠন ছাত্রলীগের ব্যানার টানানো ও স্লোগান দেওয়ার ঘটনাকে কেন্দ্র করে কলেজের অধ্যক্ষ অধ্যাপক মো. মহীদুল হাসানকে প্রায় ৪ ঘণ্টা অবরুদ্ধ করে বিক্ষোভ করেছে ছাত্রদল, ছাত্রশিবির ও সাধারণ শিক্ষার্থীরা। সোমবার (৯ নভেম্বর) এই ঘটনা ঘটে।
খবর পেয়ে তাৎক্ষণিকভাবে কলেজ ক্য&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/733990/%E0%A6%B8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%95%E0%A6%B2%E0%A7%87%E0%A6%9C-%E0%A6%AB%E0%A6%9F%E0%A6%95%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A7%AA">দেশ রূপান্তর</source>

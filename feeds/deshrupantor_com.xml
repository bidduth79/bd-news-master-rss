      <guid isPermaLink="true">https://www.deshrupantor.com/736587/%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%BE-%E0%A6%A8%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%8F%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%95%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE</guid>
      <pubDate>Fri, 20 Nov 2026 16:06:37 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/74e8415a4a1065ca1353eaa7b3e42dad-6b001b9d2ddc0.jpg?jadewits_media_id=243923" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/74e8415a4a1065ca1353eaa7b3e42dad-6b001b9d2ddc0.jpg?jadewits_media_id=243923" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/74e8415a4a1065ca1353eaa7b3e42dad-6b001b9d2ddc0.jpg?jadewits_media_id=243923" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চাঁদা না দেওয়ায় এজেন্ট ব্যাংক পরিচালককে হত্যা" /&gt;&lt;/p&gt;&lt;p&gt;চাঁদা না দেওয়ায় সোশ্যাল ইসলামী ব্যাংকের একটি এজেন্ট শাখার পরিচালক রেদোয়ান হোসেন রিফাত (৩৬)-কে হত্যা করে লাশ পুকুরে ফেলে দেওয়ার অভিযোগ উঠেছে আবরাদ হাসান সজিব নামের এক কিশোর গ্যাং নেতার বিরুদ্ধে।&amp;nbsp;
শুক্রবার সকালে কুমিল্লা সদর দক্ষিণ উপজেলার বারপাড়া ইউনিয়নের লালমাই শিবপুর মধ্যমপাড়া সৈয়দুজ্জামানের&lt;/p&gt;</description>

    <item>
      <title>চন্দনাইশে অবৈধভাবে স্কেভেটর দিয়ে পাহাড় কাটার অভিযোগ</title>
      <link>https://www.deshrupantor.com/737416/%E0%A6%9A%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%A8%E0%A6%BE%E0%A6%87%E0%A6%B6%E0%A7%87-%E0%A6%85%E0%A6%AC%E0%A7%88%E0%A6%A7%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%87%E0%A6%AD%E0%A7%87%E0%A6%9F%E0%A6%B0-%E0%A6%A6%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%A1%E0%A6%BC-%E0%A6%95%E0%A6%BE%E0%A6%9F%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737416/%E0%A6%9A%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%A8%E0%A6%BE%E0%A6%87%E0%A6%B6%E0%A7%87-%E0%A6%85%E0%A6%AC%E0%A7%88%E0%A6%A7%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%87%E0%A6%AD%E0%A7%87%E0%A6%9F%E0%A6%B0-%E0%A6%A6%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%A1%E0%A6%BC-%E0%A6%95%E0%A6%BE%E0%A6%9F%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Tue, 24 Nov 2026 01:43:04 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/0167717cf97b42881c97e3eba6247e1b-6b04972e8fc90.jpg?jadewits_media_id=244724" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/0167717cf97b42881c97e3eba6247e1b-6b04972e8fc90.jpg?jadewits_media_id=244724" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/0167717cf97b42881c97e3eba6247e1b-6b04972e8fc90.jpg?jadewits_media_id=244724" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চন্দনাইশে অবৈধভাবে স্কেভেটর দিয়ে পাহাড় কাটার অভিযোগ" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রামের চন্দনাইশ উপজেলার হাশিমপুর ইউনিয়নের ছৈয়দাবাদ এলাকায় অবৈধভাবে স্কেভেটর দিয়ে পাহাড় কাটার অভিযোগ উঠেছে।
জানা যায়, সোমবার (২৩ নভেম্বর) রাত ১০টা থেকে উত্তর হাশিমপুর পূর্ব ছৈয়দাবাদ ২নং ওয়ার্ডের গাউছিয়া ফার্মের পূর্ব পাশে লিটনের মুরগির ফার্ম সংলগ্ন এলাকায় একটি চক্র স্কেভেটর দিয়ে নির্ব&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737416/%E0%A6%9A%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%A8%E0%A6%BE%E0%A6%87%E0%A6%B6%E0%A7%87-%E0%A6%85%E0%A6%AC%E0%A7%88%E0%A6%A7%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%87%E0%A6%AD%E0%A7%87%E0%A6%9F%E0%A6%B0-%E0%A6%A6%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%A1%E0%A6%BC-%E0%A6%95%E0%A6%BE%E0%A6%9F%E0%A6%BE%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>সেঞ্চুরিয়নে বিপর্যয়কর ৯১</title>
      <link>https://www.deshrupantor.com/737415/%E0%A6%B8%E0%A7%87%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A7%9F%E0%A6%95%E0%A6%B0-%E0%A7%AF%E0%A7%A7</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737415/%E0%A6%B8%E0%A7%87%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A7%9F%E0%A6%95%E0%A6%B0-%E0%A7%AF%E0%A7%A7</guid>
      <pubDate>Tue, 24 Nov 2026 01:37:49 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/074241f6ff38d90105702ed593a531a2-6b04960593a75.jpg?jadewits_media_id=244723" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/074241f6ff38d90105702ed593a531a2-6b04960593a75.jpg?jadewits_media_id=244723" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/074241f6ff38d90105702ed593a531a2-6b04960593a75.jpg?jadewits_media_id=244723" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সেঞ্চুরিয়নে বিপর্যয়কর ৯১" /&gt;&lt;/p&gt;&lt;p&gt;দুই ম্যাচ সিরিজের প্রথম টেস্ট হারের পর ঘুরে দাঁড়ানোর প্রত্যাশা নিয়ে সেঞ্চুরিয়নে মাঠে নামে বাংলাদেশ দল। কিন্তু দক্ষিণ আফ্রিকার পেস আক্রমণের সামনে সেই প্রত্যাশা পূরণ তো হলোই না, বরং ব্যাটিং বিপর্যয়ে আরও একবার অসহায় আত্মসমর্পণ করতে হলো সফরকারীদের। গতকাল বৃষ্টিবিঘি&amp;oelig;ত দিনে টস হেরে ব্যাট করতে নেমে ম&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737415/%E0%A6%B8%E0%A7%87%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A7%9F%E0%A6%95%E0%A6%B0-%E0%A7%AF%E0%A7%A7">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>৩৬ অ্যাথলেটের সঙ্গে কর্মকর্তা ২০!</title>
      <link>https://www.deshrupantor.com/737414/%E0%A7%A9%E0%A7%AC-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A5%E0%A6%B2%E0%A7%87%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE-%E0%A7%A8%E0%A7%A6</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737414/%E0%A7%A9%E0%A7%AC-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A5%E0%A6%B2%E0%A7%87%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE-%E0%A7%A8%E0%A7%A6</guid>
      <pubDate>Tue, 24 Nov 2026 01:37:23 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/bf080fd6bfd0cfc995b552ed24ecfb8b-6b0495d573fe1.jpg?jadewits_media_id=244722" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/bf080fd6bfd0cfc995b552ed24ecfb8b-6b0495d573fe1.jpg?jadewits_media_id=244722" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/bf080fd6bfd0cfc995b552ed24ecfb8b-6b0495d573fe1.jpg?jadewits_media_id=244722" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৩৬ অ্যাথলেটের সঙ্গে কর্মকর্তা ২০!" /&gt;&lt;/p&gt;&lt;p&gt;প্রতিযোগিতায় অংশ নিতে ভারতে যাচ্ছেন বাংলাদেশের ৩৬ অ্যাথলেট। অথচ খেলোয়াড়দের সঙ্গে সফরসঙ্গী হিসেবে থাকছেন আরও ২০ কর্মকর্তা, কোচ ও পর্যবেক্ষক। অর্থাৎ মোট ৫৬ সদস্যের বাংলাদেশ দলে খেলোয়াড়ের তুলনায় কর্মকর্তা-কোচ ও পর্যবেক্ষকের সংখ্যা অর্ধেকেরও বেশি। আন্তর্জাতিক প্রতিযোগিতায় অংশ নিতে এমন বিশাল বহর পাঠানোর &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737414/%E0%A7%A9%E0%A7%AC-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A5%E0%A6%B2%E0%A7%87%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE-%E0%A7%A8%E0%A7%A6">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>জাতীয় স্টেডিয়ামে ফর্টিজের অভিষেক আজ</title>
      <link>https://www.deshrupantor.com/737413/%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%A1%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%AB%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%B7%E0%A7%87%E0%A6%95-%E0%A6%86%E0%A6%9C</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737413/%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%A1%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%AB%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%B7%E0%A7%87%E0%A6%95-%E0%A6%86%E0%A6%9C</guid>
      <pubDate>Tue, 24 Nov 2026 01:37:01 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/bf080fd6bfd0cfc995b552ed24ecfb8b-6b0495d573fe1.jpg?jadewits_media_id=244722" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/bf080fd6bfd0cfc995b552ed24ecfb8b-6b0495d573fe1.jpg?jadewits_media_id=244722" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/bf080fd6bfd0cfc995b552ed24ecfb8b-6b0495d573fe1.jpg?jadewits_media_id=244722" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জাতীয় স্টেডিয়ামে ফর্টিজের অভিষেক আজ" /&gt;&lt;/p&gt;&lt;p&gt;পেশাদার লিগে আসার পর আজই প্রথম জাতীয় স্টেডিয়ামে অভিষেক হচ্ছে ফর্টিজ এফসির। কারণ ৬২ মাস পর দেশের প্রথম আন্তর্জাতিক এই স্টেডিয়ামে ফের গড়াতে যাচ্ছে ঘরোয়া আসর। আর এই সময়ের মধ্যেই পেশাদার লিগে খেলা শুরু করেছে ফর্টিজ। সে হিসাবে দেশের অন্যতম সেরা ভেন্যুতে ফেডারেশন কাপের মাধ্যমে তাদের অভিষেক ঘটতে যাচ্ছে। সে&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737413/%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%A1%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%AB%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%B7%E0%A7%87%E0%A6%95-%E0%A6%86%E0%A6%9C">দেশ রূপান্তর</source>
    </item>

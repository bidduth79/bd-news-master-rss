    <item>
      <title>ফেনীতে অপহরণ: টেকনাফে ২ পলাতক আসামি গ্রেপ্তার</title>
      <link>https://www.deshrupantor.com/734327/%E0%A6%85%E0%A6%AA%E0%A6%B9%E0%A6%B0%E0%A6%A3-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A7%A8-%E0%A6%AA%E0%A6%B2%E0%A6%BE%E0%A6%A4%E0%A6%95-%E0%A6%86%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%BF-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%9F%E0%A7%87%E0%A6%95%E0%A6%A8%E0%A6%BE%E0%A6%AB%E0%A7%87</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734327/%E0%A6%85%E0%A6%AA%E0%A6%B9%E0%A6%B0%E0%A6%A3-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A7%A8-%E0%A6%AA%E0%A6%B2%E0%A6%BE%E0%A6%A4%E0%A6%95-%E0%A6%86%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%BF-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%9F%E0%A7%87%E0%A6%95%E0%A6%A8%E0%A6%BE%E0%A6%AB%E0%A7%87</guid>
      <pubDate>Wed, 11 Nov 2026 15:48:58 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/57ff8dcf4d27d9526e5213a1b298169e-6af4388727fb4.jpg?jadewits_media_id=241754" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/57ff8dcf4d27d9526e5213a1b298169e-6af4388727fb4.jpg?jadewits_media_id=241754" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/57ff8dcf4d27d9526e5213a1b298169e-6af4388727fb4.jpg?jadewits_media_id=241754" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফেনীতে অপহরণ: টেকনাফে ২ পলাতক আসামি গ্রেপ্তার" /&gt;&lt;/p&gt;&lt;p&gt;ফেনীতে চারজনকে অপহরণের ঘটনায় করা চাঞ্চল্যকর মামলার দুই পলাতক আসামিকে কক্সবাজারের টেকনাফ থেকে গ্রেপ্তার করেছে স্পেশাল রেসপন্স ব্যাটালিয়ন (এসআরবি)-১৫। গ্রেপ্তার দুজন ওই মামলার এজাহারভুক্ত ও অভিযোগপত্রে নাম থাকা আসামি।
মঙ্গলবার (১০ নভেম্বর) সন্ধ্যা সাড়ে ৬টার দিকে টেকনাফের হ্নীলা ইউনিয়নের রংগীখালী বাজার&lt;/p&gt;</description>

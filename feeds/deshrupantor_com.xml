      <guid isPermaLink="true">https://www.deshrupantor.com/734234/%E0%A6%95%E0%A7%81%E0%A7%9C%E0%A6%BF%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%B6%E0%A6%BF%E0%A6%B2%E0%A6%BE%E0%A6%AC%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF-%E0%A6%86%E0%A6%AE%E0%A6%A8-%E0%A6%A7%E0%A6%BE%E0%A6%A8</guid>
      <pubDate>Wed, 11 Nov 2026 01:38:34 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/ac3415a0198599cf659a54cdbcd361ed-6af3721f9c3d0.jpg?jadewits_media_id=241683" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/ac3415a0198599cf659a54cdbcd361ed-6af3721f9c3d0.jpg?jadewits_media_id=241683" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/ac3415a0198599cf659a54cdbcd361ed-6af3721f9c3d0.jpg?jadewits_media_id=241683" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কুড়িগ্রামে রাতের বৃষ্টির সঙ্গে শিলাবৃষ্টি, আমন ধান নিয়ে শঙ্কায় কৃষক" /&gt;&lt;/p&gt;&lt;p&gt;কুড়িগ্রাম সদর, রাজারহাটসহ জেলার বিভিন্ন এলাকায় রাতের বৃষ্টির সঙ্গে প্রচণ্ড শিলাবৃষ্টি হয়েছে। এতে মাঠে থাকা রোপা আমন ধানের ক্ষতির আশঙ্কা করছেন কৃষকেরা। বিশেষ করে যেসব জমির ধান পাকতে শুরু করেছে, সেসব ফসল নিয়ে দুশ্চিন্তায় পড়েছেন তারা।
মঙ্গলবার (১০ নভেম্বর) রাত ১১টার দিকে এসব এলাকায় বৃষ্টি ও শিলাবৃষ্টি &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734234/%E0%A6%95%E0%A7%81%E0%A7%9C%E0%A6%BF%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%B6%E0%A6%BF%E0%A6%B2%E0%A6%BE%E0%A6%AC%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF-%E0%A6%86%E0%A6%AE%E0%A6%A8-%E0%A6%A7%E0%A6%BE%E0%A6%A8">দেশ রূপান্তর</source>

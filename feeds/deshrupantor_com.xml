    <item>
      <title>সুন্দরগঞ্জে মা-ছেলের মরদেহ উদ্ধার, আটক সতিন</title>
      <link>https://www.deshrupantor.com/736071/%E0%A6%B8%E0%A7%81%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%B0%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AE%E0%A6%BE-%E0%A6%9B%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%B0%E0%A6%A6%E0%A7%87%E0%A6%B9-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A6%B8%E0%A6%A4%E0%A6%BF%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736071/%E0%A6%B8%E0%A7%81%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%B0%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AE%E0%A6%BE-%E0%A6%9B%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%B0%E0%A6%A6%E0%A7%87%E0%A6%B9-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A6%B8%E0%A6%A4%E0%A6%BF%E0%A6%A8</guid>
      <pubDate>Wed, 18 Nov 2026 08:56:45 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/03/28/9d6a00eec63d91db1277e39724f4bfee-69c75ae7b18f3.jpg?jadewits_media_id=184692" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/03/28/9d6a00eec63d91db1277e39724f4bfee-69c75ae7b18f3.jpg?jadewits_media_id=184692" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/03/28/9d6a00eec63d91db1277e39724f4bfee-69c75ae7b18f3.jpg?jadewits_media_id=184692" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সুন্দরগঞ্জে মা-ছেলের মরদেহ উদ্ধার, আটক সতিন" /&gt;&lt;/p&gt;&lt;p&gt;গাইবান্ধা জেলার সুন্দরগঞ্জ উপজেলায় নিজ ঘর থেকে আঁখি বেগম (৩৫) ও তার ছয় বছর বয়সী ছেলে আদিল মিয়ার মরদেহ উদ্ধার করেছে পুলিশ। এ ঘটনায় নিহত আঁখি বেগমের স্বামী আব্দুর রাজ্জাক মিয়ার দ্বিতীয় স্ত্রী শাহিনা বেগমকে (৩২) আটক করা হয়েছে।
বুধবার (১৮ নভেম্বর) সকালে মরদেহ দুটি ময়নাতদন্তের জন্য গাইবান্ধা জেনারেল হাসপ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736071/%E0%A6%B8%E0%A7%81%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%B0%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AE%E0%A6%BE-%E0%A6%9B%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%B0%E0%A6%A6%E0%A7%87%E0%A6%B9-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A6%B8%E0%A6%A4%E0%A6%BF%E0%A6%A8">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>কোস্টারিকাকে ‘সেভেন আপ’ উপহার দিল আর্জেন্টিনা</title>
      <link>https://www.deshrupantor.com/736070/%E0%A6%95%E0%A7%8B%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%95%E0%A7%87-%E2%80%98%E0%A6%B8%E0%A7%87%E0%A6%AD%E0%A7%87%E0%A6%A8-%E0%A6%86%E0%A6%AA%E2%80%99-%E0%A6%89%E0%A6%AA%E0%A6%B9%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BF%E0%A6%B2-%E0%A6%86%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%A8%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736070/%E0%A6%95%E0%A7%8B%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%95%E0%A7%87-%E2%80%98%E0%A6%B8%E0%A7%87%E0%A6%AD%E0%A7%87%E0%A6%A8-%E0%A6%86%E0%A6%AA%E2%80%99-%E0%A6%89%E0%A6%AA%E0%A6%B9%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BF%E0%A6%B2-%E0%A6%86%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%A8%E0%A6%BE</guid>
      <pubDate>Wed, 18 Nov 2026 08:02:39 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/8f1a8f612de7869a797c04508a063732-6afd070fabd26.jpg?jadewits_media_id=243443" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/8f1a8f612de7869a797c04508a063732-6afd070fabd26.jpg?jadewits_media_id=243443" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/8f1a8f612de7869a797c04508a063732-6afd070fabd26.jpg?jadewits_media_id=243443" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কোস্টারিকাকে ‘সেভেন আপ’ উপহার দিল আর্জেন্টিনা" /&gt;&lt;/p&gt;&lt;p&gt;লিওনেল মেসির অবসরের পর প্রথম ম্যাচে উরুগুয়ের কাছে হেরে আর্জেন্টাইন ফুটবলের ভবিষ্যৎ নিয়ে যে শঙ্কার মেঘ জমেছিল, কর্দোবার সবুজ গালিচায় তা যেন এক ফুৎকারে উড়িয়ে দিল তরুণ আলবিসেলেস্তেরা। বছরের শেষ আন্তর্জাতিক প্রীতি ম্যাচে কোস্টারিকাকে ৭-০ গোলে বিধ্বস্ত করে দুর্দান্ত এক জয় তুলে নিয়েছে আর্জেন্টিনা।
প্রথমা&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736070/%E0%A6%95%E0%A7%8B%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%95%E0%A7%87-%E2%80%98%E0%A6%B8%E0%A7%87%E0%A6%AD%E0%A7%87%E0%A6%A8-%E0%A6%86%E0%A6%AA%E2%80%99-%E0%A6%89%E0%A6%AA%E0%A6%B9%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BF%E0%A6%B2-%E0%A6%86%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%A8%E0%A6%BE">দেশ রূপান্তর</source>

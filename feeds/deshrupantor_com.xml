    <item>
      <title>নিউমোনিয়ায় দেশে দিনে প্রাণ যায় ৬৬ শিশুর</title>
      <link>https://www.deshrupantor.com/734513/%E0%A6%A8%E0%A6%BF%E0%A6%89%E0%A6%AE%E0%A7%8B%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3-%E0%A6%AF%E0%A6%BE%E0%A7%9F-%E0%A7%AC%E0%A7%AC-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734513/%E0%A6%A8%E0%A6%BF%E0%A6%89%E0%A6%AE%E0%A7%8B%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3-%E0%A6%AF%E0%A6%BE%E0%A7%9F-%E0%A7%AC%E0%A7%AC-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%B0</guid>
      <pubDate>Thu, 12 Nov 2026 01:45:34 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/ecee45b5a08b80f881eb873e9129306c-6af4c5d7d95e6.jpg?jadewits_media_id=241930" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/ecee45b5a08b80f881eb873e9129306c-6af4c5d7d95e6.jpg?jadewits_media_id=241930" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/ecee45b5a08b80f881eb873e9129306c-6af4c5d7d95e6.jpg?jadewits_media_id=241930" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নিউমোনিয়ায় দেশে দিনে প্রাণ যায় ৬৬ শিশুর" /&gt;&lt;/p&gt;&lt;p&gt;নিউমোনিয়া প্রতিরোধ ও প্রতিকারযোগ্য রোগ। অথচ এতে দেশে প্রতিদিন গড়ে মৃত্যু হয় প্রায় ৬৬ শিশুর। ঘণ্টার হিসেবে মারা যায় দুই থেকে তিন শিশু। আর প্রতি বছর মারা যায় পাঁচ বছরের কম বয়সী প্রায় ২৪ হাজার শিশু। নিউমোনিয়া শুধু শিশুদের রোগ নয়; পাঁচ বছরের কম বয়সী শিশু, বিশেষ করে নবজাতক এবং ৬৫ বছরের বেশি বয়সী প্রবীণরা&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734513/%E0%A6%A8%E0%A6%BF%E0%A6%89%E0%A6%AE%E0%A7%8B%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3-%E0%A6%AF%E0%A6%BE%E0%A7%9F-%E0%A7%AC%E0%A7%AC-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>

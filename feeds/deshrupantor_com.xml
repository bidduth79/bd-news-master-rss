      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/28f282d9cb7a9fd679040dc1dc646374-6b0914bdb0a54.jpg?jadewits_media_id=245537" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/28f282d9cb7a9fd679040dc1dc646374-6b0914bdb0a54.jpg?jadewits_media_id=245537" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ওয়ারীতে হোটেল ম্যানেজারকে কুপিয়ে খুন" /&gt;&lt;/p&gt;&lt;p&gt;তদন্তকারীদের ধারণা, স্থানীয় এক মুরগি ব্যবসায়ী ও তার ছেলে এতে জড়িত থাকতে পারেন।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/738291/%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A7%8B%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A7%81%E0%A6%AA%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%96%E0%A7%81%E0%A6%A8">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>তেভেজের বিদায়ী ম্যাচে খেলবেন মেসি, রোনালদোও কী থাকবেন?</title>
      <link>https://www.deshrupantor.com/738290/%E0%A6%A4%E0%A7%87%E0%A6%AD%E0%A7%87%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A6%BE%E0%A7%9F%E0%A7%80-%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%87-%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A6%AC%E0%A7%87%E0%A6%A8-%E0%A6%AE%E0%A7%87%E0%A6%B8%E0%A6%BF-%E0%A6%B0%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A6%A6%E0%A7%8B%E0%A6%93-%E0%A6%95%E0%A7%80</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/738290/%E0%A6%A4%E0%A7%87%E0%A6%AD%E0%A7%87%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A6%BE%E0%A7%9F%E0%A7%80-%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%87-%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A6%AC%E0%A7%87%E0%A6%A8-%E0%A6%AE%E0%A7%87%E0%A6%B8%E0%A6%BF-%E0%A6%B0%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A6%A6%E0%A7%8B%E0%A6%93-%E0%A6%95%E0%A7%80</guid>
      <pubDate>Fri, 27 Nov 2026 11:28:09 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/f148976f781df89e786b2a2809b8098b-6b0914938dd54.jpg?jadewits_media_id=245536" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/f148976f781df89e786b2a2809b8098b-6b0914938dd54.jpg?jadewits_media_id=245536" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/f148976f781df89e786b2a2809b8098b-6b0914938dd54.jpg?jadewits_media_id=245536" style="max-width:100%;height:auto;margin-bottom:10px;" alt="তেভেজের বিদায়ী ম্যাচে খেলবেন মেসি, রোনালদোও কী থাকবেন?" /&gt;&lt;/p&gt;&lt;p&gt;বুয়েনস এইরেসের ঐতিহ্যবাহী লা বোমবোনেরায় এক আবেগঘন বিদায়ের মঞ্চ সাজছে কার্লোস তেভেজের জন্য। আর সেই বিশেষ উপলক্ষকে আরও বর্ণিল করতে নিজের সাবেক সতীর্থ লিওনেল মেসির অংশগ্রহণ নিশ্চিত হওয়ায় &amp;lsquo;এল অ্যাপাচি&amp;rsquo;-র বিদায়ী ম্যাচ ঘিরে ফুটবলপ্রেমীদের উন্মাদনা এখন তুঙ্গে।
গতকাল সামাজিক যোগাযোগমাধ্যমে একটি &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/738290/%E0%A6%A4%E0%A7%87%E0%A6%AD%E0%A7%87%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A6%BE%E0%A7%9F%E0%A7%80-%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%87-%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A6%AC%E0%A7%87%E0%A6%A8-%E0%A6%AE%E0%A7%87%E0%A6%B8%E0%A6%BF-%E0%A6%B0%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A6%A6%E0%A7%8B%E0%A6%93-%E0%A6%95%E0%A7%80">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>বার্তাসংস্থা এএফপি’তে সাইবার হামলা</title>
      <link>https://www.deshrupantor.com/738289/%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE-%E0%A6%8F%E0%A6%8F%E0%A6%AB%E0%A6%AA%E0%A6%BF%E2%80%99%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/738289/%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE-%E0%A6%8F%E0%A6%8F%E0%A6%AB%E0%A6%AA%E0%A6%BF%E2%80%99%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE</guid>
      <pubDate>Fri, 27 Nov 2026 11:56:40 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/0b121fdb886c4478a3b705fcda56e108-6b0913b886886.png?jadewits_media_id=245535" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/0b121fdb886c4478a3b705fcda56e108-6b0913b886886.png?jadewits_media_id=245535" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/0b121fdb886c4478a3b705fcda56e108-6b0913b886886.png?jadewits_media_id=245535" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বার্তাসংস্থা এএফপি’তে সাইবার হামলা" /&gt;&lt;/p&gt;&lt;p&gt;সাইবার হামলার শিকার হয়েছে আন্তর্জাতিক সংবাদ সংস্থা এজেন্স ফ্রান্স-প্রেস (এএফপি)। হামলার পর সংস্থাটির গ্রাহকদের সংবাদ, ছবি ও অন্যান্য কনটেন্ট সরবরাহের অন্যতম মাধ্যম ‘এএফপি ফোরাম’ সাময়িকভাবে বন্ধ করে দেওয়া হয়েছে। কারা এ হামলা চালিয়েছে, তা খতিয়ে দেখছে সংস্থাটি।
বৃহস্পতিবার এএফপির ব্যবস্থাপনা কর্তৃপক্ষ &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/738289/%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE-%E0%A6%8F%E0%A6%8F%E0%A6%AB%E0%A6%AA%E0%A6%BF%E2%80%99%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE">দেশ রূপান্তর</source>
    </item>

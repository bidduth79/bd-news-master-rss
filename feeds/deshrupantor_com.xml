    <item>
      <title>হারিয়ে গেছে তুরাগের ‘মিনি কক্সবাজার’</title>
      <link>https://www.deshrupantor.com/736984/%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A6%BE%E0%A6%97%E0%A7%87%E0%A6%B0-%E2%80%98%E0%A6%AE%E0%A6%BF%E0%A6%A8%E0%A6%BF-%E0%A6%95%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E2%80%99</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736984/%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A6%BE%E0%A6%97%E0%A7%87%E0%A6%B0-%E2%80%98%E0%A6%AE%E0%A6%BF%E0%A6%A8%E0%A6%BF-%E0%A6%95%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E2%80%99</guid>

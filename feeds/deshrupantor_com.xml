      <guid isPermaLink="true">https://www.deshrupantor.com/736064/%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A6%BF%E0%A6%B8%E0%A6%B9-%E0%A7%A7%E0%A7%A6-%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%AA%E0%A6%B0%E0%A7%8B%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%97%E0%A6%BE%E0%A6%B0%E0%A7%87</guid>
      <pubDate>Wed, 18 Nov 2026 07:32:09 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2023/11/01/756bedac712941f47eb46b3a34b88636-6541866731238.png?jadewits_media_id=9" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2023/11/01/756bedac712941f47eb46b3a34b88636-6541866731238.png?jadewits_media_id=9" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2023/11/01/756bedac712941f47eb46b3a34b88636-6541866731238.png?jadewits_media_id=9" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাবেক ডিসিসহ ১০ জনের বিরুদ্ধে পরোয়ানা, কারাগারে পাঁচ" /&gt;&lt;/p&gt;&lt;p&gt;মাতারবাড়ী কয়লাবিদ্যুৎ প্রকল্পের প্রায় ২০ কোটি টাকা আত্মসাতের অভিযোগে দুর্নীতি দমন কমিশনের (দুদক) করা মামলায় কক্সবাজারের সাবেক অতিরিক্ত জেলা প্রশাসক (এডিসি) জাফর আলমসহ পাঁচজনকে কারাগারে পাঠিয়েছে আদালত। গতকাল মঙ্গলবার চট্টগ্রাম বিভাগীয় বিশেষ জজ আদালতের বিচারক মিজানুর রহমান এই আদেশ দেন। একই মামলায় জামি&lt;/p&gt;</description>

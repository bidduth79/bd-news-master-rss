    <item>
      <title>নতুন সমঝোতার পথে বিশ্ব!</title>
      <link>https://www.deshrupantor.com/736493/%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%B8%E0%A6%AE%E0%A6%9D%E0%A7%8B%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736493/%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%B8%E0%A6%AE%E0%A6%9D%E0%A7%8B%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC</guid>
      <pubDate>Fri, 20 Nov 2026 00:37:18 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/7f23e1ed85571ddcc7f19da29570c93f-6aff3d6a6365b.jpg?jadewits_media_id=243840" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/7f23e1ed85571ddcc7f19da29570c93f-6aff3d6a6365b.jpg?jadewits_media_id=243840" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/7f23e1ed85571ddcc7f19da29570c93f-6aff3d6a6365b.jpg?jadewits_media_id=243840" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নতুন সমঝোতার পথে বিশ্ব!" /&gt;&lt;/p&gt;&lt;p&gt;বিশ্বের সবচেয়ে শক্তিশালী তিন দেশের নেতা এক টেবিলে। সামনে পারমাণবিক অস্ত্রের ভয়াবহ ঝুঁকি, ইউক্রেনের রক্তক্ষয়ী যুদ্ধ আর বিশ্বজুড়ে ক্ষমতার নতুন সমীকরণ। আলোচনার কেন্দ্রে এমন এক প্রশ্ন, যার সঙ্গে জড়িয়ে আছে গোটা বিশ্বের নিরাপত্তা। পারমাণবিক অস্ত্রের সংখ্যা কি সত্যিই কমানো সম্ভব? নাকি তিন পরাশক্তির বৈঠক শে&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736493/%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%B8%E0%A6%AE%E0%A6%9D%E0%A7%8B%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>প্রথম কৃষ্ণাঙ্গ স্পিকার হওয়ার পথে হাকিম জেফ্রিস</title>
      <link>https://www.deshrupantor.com/736492/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%95%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%A3%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97-%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%AE-%E0%A6%9C%E0%A7%87%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%B8</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736492/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%95%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%A3%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97-%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%AE-%E0%A6%9C%E0%A7%87%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%B8</guid>
      <pubDate>Fri, 20 Nov 2026 00:36:46 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/ac6794ee9a0014f83d0e742bec955289-6aff3d6ca9664.jpg?jadewits_media_id=243847" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/ac6794ee9a0014f83d0e742bec955289-6aff3d6ca9664.jpg?jadewits_media_id=243847" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/ac6794ee9a0014f83d0e742bec955289-6aff3d6ca9664.jpg?jadewits_media_id=243847" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রথম কৃষ্ণাঙ্গ স্পিকার হওয়ার পথে হাকিম জেফ্রিস" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাষ্ট্রের কংগ্রেসের নিম্নকক্ষ প্রতিনিধি পরিষদের স্পিকার পদে আনুষ্ঠানিকভাবে ডেমোক্র্যাটদের মনোনয়ন পেয়েছেন হাকিম জেফ্রিস। সিএনএন জানিয়েছে, গত বুধবার অনুষ্ঠিত গোপন ভোটাভুটিতে নিউ ইয়র্ক থেকে নির্বাচিত ৫৬ বছর বয়সী এই কংগ্রেস সদস্য নিজের দলের মনোনয়ন নিশ্চিত করেন। এ সময় তার প্রার্থিতার পক্ষে ২৫১ জন সদ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736492/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%95%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%A3%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97-%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%AE-%E0%A6%9C%E0%A7%87%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%B8">দেশ রূপান্তর</source>

    <item>
      <title>হাম উপসর্গে আরও ৫ মৃত্যু</title>
      <link>https://www.deshrupantor.com/736595/%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%89%E0%A6%AA%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A7%AB-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736595/%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%89%E0%A6%AA%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A7%AB-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81</guid>
      <pubDate>Fri, 20 Nov 2026 16:43:06 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2024/02/21/945773efe97e2d1846b31e443af83663-65d5d69518be5.jpg?jadewits_media_id=24928" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2024/02/21/945773efe97e2d1846b31e443af83663-65d5d69518be5.jpg?jadewits_media_id=24928" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2024/02/21/945773efe97e2d1846b31e443af83663-65d5d69518be5.jpg?jadewits_media_id=24928" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হাম উপসর্গে আরও ৫ মৃত্যু" /&gt;&lt;/p&gt;&lt;p&gt;গত ২৪ ঘণ্টায় সারাদেশে হাম উপসর্গে আরও পাঁচজনের মৃত্যু হয়েছে। একই সময়ে সারাদেশে হাম উপসর্গ এবং নিশ্চিত হামে আক্রান্ত হয়েছেন এক হাজার ২৭০ জন।
শুক্রবার (২০ নভেম্বর) স্বাস্থ্য অধিদপ্তরের কন্ট্রোলরুম থেকে পাঠানো এক সংবাদ বিজ্ঞপ্তিতে এ তথ্য জানানো হয়।
এতে বলা হয়, গত ২৪ ঘণ্টায় হাম উপসর্গে শনাক্ত রোগীর সংখ্&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736595/%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%89%E0%A6%AA%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A7%AB-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81">দেশ রূপান্তর</source>
    </item>

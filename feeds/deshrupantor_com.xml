      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/b1640919112d7beb2cf641f99bf082ed-6af96e366f1d0.jpg?jadewits_media_id=242732" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/b1640919112d7beb2cf641f99bf082ed-6af96e366f1d0.jpg?jadewits_media_id=242732" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/b1640919112d7beb2cf641f99bf082ed-6af96e366f1d0.jpg?jadewits_media_id=242732" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সম্মানসূচক অস্কার পাচ্ছেন গ্লেন ক্লোজ" /&gt;&lt;/p&gt;&lt;p&gt;আটবার অস্কারের মনোনয়ন পেয়েও  বার বার খালি হাতে ফিরে যাওয়া হলিউডের বর্ষীয়ান অভিনেত্রী গ্লেন ক্লোজের মুখে অবশেষে স্বস্তির হাসি। এবার চলচ্চিত্রে অসামান্য অবদানের স্বীকৃতি হিসেবে সম্মানসূচক অস্কার পেতে যাচ্ছেন হলিউডের বর্ষীয়ান অভিনেত্রী গ্লেন ক্লোজ।
অধরা অস্কার স্পর্শ করার খবরে আপ্লুত  ৭৯ বছর বয়সী এই অভ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735329/%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%B8%E0%A7%82%E0%A6%9A%E0%A6%95-%E0%A6%85%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%97%E0%A7%8D%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%95%E0%A7%8D%E0%A6%B2%E0%A7%8B%E0%A6%9C">দেশ রূপান্তর</source>

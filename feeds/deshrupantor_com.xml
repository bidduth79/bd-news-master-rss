    <item>
      <title>হেগসেথের অভিশংসনে রিপাবলিকানদের বাধা</title>
      <link>https://www.deshrupantor.com/734480/%E0%A6%B9%E0%A7%87%E0%A6%97%E0%A6%B8%E0%A7%87%E0%A6%A5%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%B6%E0%A6%82%E0%A6%B8%E0%A6%A8%E0%A7%87-%E0%A6%B0%E0%A6%BF%E0%A6%AA%E0%A6%BE%E0%A6%AC%E0%A6%B2%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%A8%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%A7%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734480/%E0%A6%B9%E0%A7%87%E0%A6%97%E0%A6%B8%E0%A7%87%E0%A6%A5%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%B6%E0%A6%82%E0%A6%B8%E0%A6%A8%E0%A7%87-%E0%A6%B0%E0%A6%BF%E0%A6%AA%E0%A6%BE%E0%A6%AC%E0%A6%B2%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%A8%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%A7%E0%A6%BE</guid>
      <pubDate>Thu, 12 Nov 2026 00:26:31 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/438f7ca7ba15ac992b798ecd6a4dc44d-6af4b3503928e.jpg?jadewits_media_id=241902" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/438f7ca7ba15ac992b798ecd6a4dc44d-6af4b3503928e.jpg?jadewits_media_id=241902" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/438f7ca7ba15ac992b798ecd6a4dc44d-6af4b3503928e.jpg?jadewits_media_id=241902" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হেগসেথের অভিশংসনে রিপাবলিকানদের বাধা" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাষ্ট্রের প্রতিরক্ষামন্ত্রী পিট হেগসেথকে অভিশংসনের উদ্যোগ প্রতিনিধি পরিষদে আটকে দিয়েছেন রিপাবলিকান আইনপ্রণেতারা। ইরান যুদ্ধ পরিচালনায় কংগ্রেসের অনুমতি না নেওয়া, সংবিধান লঙ্ঘন ও ক্ষমতার অপব্যবহারের অভিযোগে তার বিরুদ্ধে আনা প্রস্তাব সরাসরি ভোটাভুটিতে না তুলে বিচার বিভাগবিষয়ক কমিটিতে পাঠানো হয়েছে।&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734480/%E0%A6%B9%E0%A7%87%E0%A6%97%E0%A6%B8%E0%A7%87%E0%A6%A5%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%B6%E0%A6%82%E0%A6%B8%E0%A6%A8%E0%A7%87-%E0%A6%B0%E0%A6%BF%E0%A6%AA%E0%A6%BE%E0%A6%AC%E0%A6%B2%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%A8%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%A7%E0%A6%BE">দেশ রূপান্তর</source>
    </item>

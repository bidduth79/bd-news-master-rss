    </item>
    <item>
      <title>ভূমি কার্যালয়ের সামনে মিলল ভ্যানচালকের মরদেহ</title>
      <link>https://www.deshrupantor.com/734326/%E0%A6%AD%E0%A7%82%E0%A6%AE%E0%A6%BF-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2-%E0%A6%AD%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%B0%E0%A6%A6%E0%A7%87%E0%A6%B9</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734326/%E0%A6%AD%E0%A7%82%E0%A6%AE%E0%A6%BF-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2-%E0%A6%AD%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%B0%E0%A6%A6%E0%A7%87%E0%A6%B9</guid>
      <pubDate>Wed, 11 Nov 2026 15:38:39 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/2d79f87e073b80073699f806aa865de2-6af43730d70e2.jpg?jadewits_media_id=241753" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/2d79f87e073b80073699f806aa865de2-6af43730d70e2.jpg?jadewits_media_id=241753" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/2d79f87e073b80073699f806aa865de2-6af43730d70e2.jpg?jadewits_media_id=241753" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভূমি কার্যালয়ের সামনে মিলল ভ্যানচালকের মরদেহ" /&gt;&lt;/p&gt;&lt;p&gt;মৌলভীবাজারের রাজনগরে পিন্টু কর নামে এক ভ্যানচালকের ঝুলন্ত মরদেহ উদ্ধার করেছে পুলিশ। বুধবার (১১ নভেম্বর) সকালে উপজেলা ভূমি কার্যালয়ের সামনের থেকে তার মরদেহে উদ্ধার করা হয়।
নিহত পিন্টু কর (২৮) উপজেলার হাসানপুর গ্রামের সুশেন্দু করের ছেলে।
​স্থানীয় ও পুলিশ জানায়, বুধবার সকালে উপজেলা ভূমি অফিসের সামনের এ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734326/%E0%A6%AD%E0%A7%82%E0%A6%AE%E0%A6%BF-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2-%E0%A6%AD%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%B0%E0%A6%A6%E0%A7%87%E0%A6%B9">দেশ রূপান্তর</source>

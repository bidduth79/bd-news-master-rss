      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2023/11/01/756bedac712941f47eb46b3a34b88636-6541866731238.png?jadewits_media_id=9" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2023/11/01/756bedac712941f47eb46b3a34b88636-6541866731238.png?jadewits_media_id=9" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2023/11/01/756bedac712941f47eb46b3a34b88636-6541866731238.png?jadewits_media_id=9" style="max-width:100%;height:auto;margin-bottom:10px;" alt="১৭ পুলিশ কর্মকর্তাকে বদলি দুইজনকে বরখাস্ত" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ পুলিশ ক্যাডারের ১৭ কর্মকর্তাকে একযোগে বদলির পাশাপাশি অতিরিক্ত পুলিশ সুপার ও সহকারী পুলিশ সুপার পদমর্যাদার দুই পুলিশ কর্মকর্তাকে সাময়িক বরখাস্ত করা হয়েছে। বদলি হওয়া কর্মকর্তাদের মধ্যে একজন ডিআইজি, দুজন অতিরিক্ত ডিআইজি ও ১৪ জন পুলিশ সুপার পদমর্যাদার কর্মকর্তা রয়েছেন। গতকাল বৃহস্পতিবার স্বরাষ্&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736518/%E0%A7%A7%E0%A7%AD-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A6%BF-%E0%A6%A6%E0%A7%81%E0%A6%87%E0%A6%9C%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%B0%E0%A6%96%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>কালিয়াকৈরে সংঘবদ্ধ ধর্ষণের শিকার নারী শ্রমিক</title>
      <link>https://www.deshrupantor.com/736517/%E0%A6%95%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%95%E0%A7%88%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%AC%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%A7%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736517/%E0%A6%95%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%95%E0%A7%88%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%AC%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%A7%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95</guid>
      <pubDate>Fri, 20 Nov 2026 06:40:44 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2023/11/01/756bedac712941f47eb46b3a34b88636-6541866731238.png?jadewits_media_id=9" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2023/11/01/756bedac712941f47eb46b3a34b88636-6541866731238.png?jadewits_media_id=9" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2023/11/01/756bedac712941f47eb46b3a34b88636-6541866731238.png?jadewits_media_id=9" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কালিয়াকৈরে সংঘবদ্ধ ধর্ষণের শিকার নারী শ্রমিক" /&gt;&lt;/p&gt;&lt;p&gt;গাজীপুরের কালিয়াকৈরে জোর করে আটকে রেখে সংঘবদ্ধভাবে এক নারী পোশাকশ্রমিককে ধর্ষণ করা হয়েছে বলে অভিযোগ উঠেছে। উপজেলার রতনপুর এলাকায় এ ঘটনা ঘটে। এ ঘটনায় জড়িত সন্দেহে গত বুধবার রাতে অভিযান চালিয়ে তিনজনকে আটক করেছে পুলিশ।
আটককৃতরা হলেন- কালিয়াকৈর উপজেলার পূর্বচান্দরা ছাপড়া মসজিদ এলাকার ইউনুছ আলীর ছেলে আশর&lt;/p&gt;</description>

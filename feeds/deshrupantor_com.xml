    <item>
      <title>স্কুলে গিয়ে আর ফেরা হলো না পাপ্পুর</title>
      <link>https://www.deshrupantor.com/734725/%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2%E0%A7%87-%E0%A6%97%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%86%E0%A6%B0-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE-%E0%A6%B9%E0%A6%B2%E0%A7%8B-%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%AA%E0%A7%81%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734725/%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2%E0%A7%87-%E0%A6%97%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%86%E0%A6%B0-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE-%E0%A6%B9%E0%A6%B2%E0%A7%8B-%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%AA%E0%A7%81%E0%A6%B0</guid>
      <pubDate>Thu, 12 Nov 2026 23:32:20 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2025/04/08/f0f4550b2ec75150c5f3271d8b9ccb00-67f51681ebb54.jpg?jadewits_media_id=104625" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2025/04/08/f0f4550b2ec75150c5f3271d8b9ccb00-67f51681ebb54.jpg?jadewits_media_id=104625" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2025/04/08/f0f4550b2ec75150c5f3271d8b9ccb00-67f51681ebb54.jpg?jadewits_media_id=104625" style="max-width:100%;height:auto;margin-bottom:10px;" alt="স্কুলে গিয়ে আর ফেরা হলো না পাপ্পুর" /&gt;&lt;/p&gt;&lt;p&gt;গাজীপুরের কালিয়াকৈরে একটি বিদ্যালয়ের ভবনের রেলিং ভেঙ্গে নিচে পড়ে নবম শ্রেণীর এক শিক্ষার্থীর মৃত্যু হয়েছে।
বৃহস্পতিবার (১২ নভেম্বর) দুপুরে উপজেলার চাপাইর এলাকায় মর্মান্তিক এ দুর্ঘটনা ঘটে।
নিহত শিক্ষার্থী কালিয়াকৈর উপজেলার চাপাইর পশ্চিমপাড়া এলাকার মো. সাজু মিয়ার ছেলে পাপ্পু মিয়া (১৫)। পাপ্পু স্&lt;/p&gt;</description>

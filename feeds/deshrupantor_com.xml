    <item>
      <title>অপ্রয়োজনীয় হর্ন বন্ধে অভিযানের নির্দেশ হাইকোর্টের</title>
      <link>https://www.deshrupantor.com/735445/%E0%A6%85%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%9F%E0%A7%8B%E0%A6%9C%E0%A6%A8%E0%A7%80%E0%A7%9F-%E0%A6%B9%E0%A6%B0%E0%A7%8D%E0%A6%A8-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%B9%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735445/%E0%A6%85%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%9F%E0%A7%8B%E0%A6%9C%E0%A6%A8%E0%A7%80%E0%A7%9F-%E0%A6%B9%E0%A6%B0%E0%A7%8D%E0%A6%A8-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%B9%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Sun, 15 Nov 2026 22:10:53 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/09/08/d0fe51e0d1b9b7ecd8185b1e04715887-6aa02141585a2.jpg?jadewits_media_id=226955" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/09/08/d0fe51e0d1b9b7ecd8185b1e04715887-6aa02141585a2.jpg?jadewits_media_id=226955" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/09/08/d0fe51e0d1b9b7ecd8185b1e04715887-6aa02141585a2.jpg?jadewits_media_id=226955" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অপ্রয়োজনীয় হর্ন বন্ধে অভিযানের নির্দেশ হাইকোর্টের" /&gt;&lt;/p&gt;&lt;p&gt;&amp;lsquo;নীরব এলাকায়&amp;rsquo; শব্দদূষণ নিয়ন্ত্রণে অপ্রয়োজনীয় হর্নের ব্যবহার বন্ধে নিয়মিত অভিযান পরিচালনার নির্দেশ দিয়েছে উচ্চ আদালত। পাশাপাশি যথাযথ চিহ্ন বা সাইনবোর্ড স্থাপন এবং জনসচেতনতায় প্রচার চালাতে নির্দেশ দিয়েছে হাইকোর্ট। এ-সংক্রান্ত রিট আবেদনের ওপর প্রাথমিক শুনানি নিয়ে আজ রোববার বিচারপতি শিকদার ম&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735445/%E0%A6%85%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%9F%E0%A7%8B%E0%A6%9C%E0%A6%A8%E0%A7%80%E0%A7%9F-%E0%A6%B9%E0%A6%B0%E0%A7%8D%E0%A6%A8-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%B9%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>ভৈরবে সাংবাদিকের উপর হামলার প্রতিবাদে মানববন্ধন</title>

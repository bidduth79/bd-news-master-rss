      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/c04be023b61c9d98ff011415ef4e50e7-6b05b6be87d2b.jpg?jadewits_media_id=244964" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডিসেম্বরে পর্দা উঠছে ‘ডিএসসিসি ফুটবল কাপ-২০২৬’" /&gt;&lt;/p&gt;&lt;p&gt;তরুণ প্রজন্মকে মাদক ও সামাজিক অপরাধ থেকে দূরে রেখে মাঠমুখী করা এবং রাজধানীতে ফুটবলের হারানো ঐতিহ্য ফিরিয়ে আনার লক্ষ্যে আগামী ডিসেম্বরে শুরু হচ্ছে &amp;lsquo;ডিএসসিসি ফুটবল কাপ ২০২৬&amp;rsquo;।
ঢাকা দক্ষিণ সিটি করপোরেশনের (ডিএসসিসি) উদ্যোগে এবং ঢাকা মহানগর দক্ষিণ বিএনপি ও এর অঙ্গ-সহযোগী সংগঠনগুলোর সহযোগিতায় &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737649/%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%87-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A6%BE-%E0%A6%89%E0%A6%A0%E0%A6%9B%E0%A7%87-%E2%80%98%E0%A6%A1%E0%A6%BF%E0%A6%8F%E0%A6%B8%E0%A6%B8%E0%A6%BF%E0%A6%B8%E0%A6%BF-%E0%A6%AB%E0%A7%81%E0%A6%9F%E0%A6%AC%E0%A6%B2-%E0%A6%95%E0%A6%BE%E0%A6%AA-%E0%A7%A8%E0%A7%A6%E0%A7%A8%E0%A7%AC%E2%80%99">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>‘পৃথিবীতে যত দিন ক্ষুধা, দারিদ্র্য থাকবে, সুকান্ত প্রাসঙ্গিক থাকবেন’</title>
      <link>https://www.deshrupantor.com/737648/%E2%80%98%E0%A6%AA%E0%A7%83%E0%A6%A5%E0%A6%BF%E0%A6%AC%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AF%E0%A6%A4-%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%81%E0%A6%A7%E0%A6%BE-%E0%A6%A6%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%8D%E0%A6%AF-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%AC%E0%A7%87-%E0%A6%B8%E0%A7%81%E0%A6%95%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737648/%E2%80%98%E0%A6%AA%E0%A7%83%E0%A6%A5%E0%A6%BF%E0%A6%AC%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AF%E0%A6%A4-%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%81%E0%A6%A7%E0%A6%BE-%E0%A6%A6%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%8D%E0%A6%AF-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%AC%E0%A7%87-%E0%A6%B8%E0%A7%81%E0%A6%95%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4</guid>
      <pubDate>Tue, 24 Nov 2026 22:06:07 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/8528c86fc40036fd0f8734879ab5cece-6b05b5a295168.jpg?jadewits_media_id=244963" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/8528c86fc40036fd0f8734879ab5cece-6b05b5a295168.jpg?jadewits_media_id=244963" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/8528c86fc40036fd0f8734879ab5cece-6b05b5a295168.jpg?jadewits_media_id=244963" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘পৃথিবীতে যত দিন ক্ষুধা, দারিদ্র্য থাকবে, সুকান্ত প্রাসঙ্গিক থাকবেন’" /&gt;&lt;/p&gt;&lt;p&gt;কবি সুকান্ত ভট্টাচার্যের জন্মশতবর্ষ উপলক্ষে আরণ্যক নাট্যদলের আয়োজনে অনুষ্ঠিত হয়েছে &amp;lsquo;হে মহাজীবন&amp;rsquo; শীর্ষক বিশেষ অনুষ্ঠান।
মঙ্গলবার (২৪ নভেম্বর) বাংলাদেশ শিল্পকলা একাডেমির স্টুডিও থিয়েটার হলে আয়োজিত এ অনুষ্ঠানে সুকান্তের জীবন ও সাহিত্যকর্ম নিয়ে আলোচনা, কবিতা আবৃত্তি, সংগীত ও নৃত্য পরিবেশনার &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737648/%E2%80%98%E0%A6%AA%E0%A7%83%E0%A6%A5%E0%A6%BF%E0%A6%AC%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AF%E0%A6%A4-%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%81%E0%A6%A7%E0%A6%BE-%E0%A6%A6%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%8D%E0%A6%AF-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%AC%E0%A7%87-%E0%A6%B8%E0%A7%81%E0%A6%95%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>জাবিপ্রবিতে শিক্ষককে ঘিরে শিক্ষার্থীদের স্লোগান, ভিডিও ভাইরাল</title>
      <link>https://www.deshrupantor.com/737647/%E0%A6%9C%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%95%E0%A6%95%E0%A7%87-%E0%A6%98%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%B2%E0%A7%8B%E0%A6%97%E0%A6%BE%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737647/%E0%A6%9C%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%95%E0%A6%95%E0%A7%87-%E0%A6%98%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%B2%E0%A7%8B%E0%A6%97%E0%A6%BE%E0%A6%A8</guid>
      <pubDate>Tue, 24 Nov 2026 22:00:16 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/2735e53b319d45dea177134d5d7945fa-6b05b47a8a9fd.jpg?jadewits_media_id=244962" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/2735e53b319d45dea177134d5d7945fa-6b05b47a8a9fd.jpg?jadewits_media_id=244962" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/2735e53b319d45dea177134d5d7945fa-6b05b47a8a9fd.jpg?jadewits_media_id=244962" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জাবিপ্রবিতে শিক্ষককে ঘিরে শিক্ষার্থীদের স্লোগান, ভিডিও ভাইরাল" /&gt;&lt;/p&gt;&lt;p&gt;জামালপুর বিজ্ঞান ও প্রযুক্তি বিশ্ববিদ্যালয়ে (জাবিপ্রবি) সহকারী অধ্যাপক ড. সৈয়দ নাজমুল হুদাকে ঘিরে একদল শিক্ষার্থীর &amp;lsquo;ভুয়া ভুয়া&amp;rsquo; স্লোগান দেওয়ার ভিডিও সামাজিক যোগাযোগমাধ্যমে ছড়িয়ে পড়েছে। বিশ্ববিদ্যালয় দিবস উদযাপন উপলক্ষে আয়োজিত একটি সভায় শিক্ষকদের মধ্যে মতবিরোধের জেরে পরদিন এ ঘটনা ঘটে। একজন&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737647/%E0%A6%9C%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%95%E0%A6%95%E0%A7%87-%E0%A6%98%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%B2%E0%A7%8B%E0%A6%97%E0%A6%BE%E0%A6%A8">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>নরসিংদীতে দুর্বৃত্তের গুলিতে কাঠুরির মৃত্যুর অভিযোগ</title>
      <link>https://www.deshrupantor.com/737646/%E0%A6%A8%E0%A6%B0%E0%A6%B8%E0%A6%BF%E0%A6%82%E0%A6%A6%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%A0%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737646/%E0%A6%A8%E0%A6%B0%E0%A6%B8%E0%A6%BF%E0%A6%82%E0%A6%A6%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%A0%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%B0</guid>
      <pubDate>Tue, 24 Nov 2026 21:58:49 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/05/24/514837a02d28e02b106853b633245ee5-6a12c48e33471.jpg?jadewits_media_id=199221" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/05/24/514837a02d28e02b106853b633245ee5-6a12c48e33471.jpg?jadewits_media_id=199221" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/05/24/514837a02d28e02b106853b633245ee5-6a12c48e33471.jpg?jadewits_media_id=199221" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নরসিংদীতে দুর্বৃত্তের গুলিতে কাঠুরির মৃত্যুর অভিযোগ" /&gt;&lt;/p&gt;&lt;p&gt;নরসিংদীর শিবপুরে দুর্বৃত্তের গুলিতে আলম মিয়া নামে এক কাঠুরির মৃত্যু হয়েছে। মঙ্গলবার (২৪ নভেম্বর) রাতে উপজেলার বাঘাবো ইউনিয়নের বংপুর গ্রামে রহিজ মেম্বারের বাড়ির পাশে এই হত্যার ঘটনা ঘটে।
নিহত আলম মিয়া বংপুর গ্রামের মৃত আফসার উদ্দিন ভূইয়ার ছেলে।&amp;nbsp;
পুলিশ ও নিহতের স্বজনরা জানায়, &amp;nbsp;সন্ধ্যায় আলম বা&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737646/%E0%A6%A8%E0%A6%B0%E0%A6%B8%E0%A6%BF%E0%A6%82%E0%A6%A6%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%A0%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>রাজপথে সজাগ থাকতে হবে: বাণিজ্যমন্ত্রী</title>
      <link>https://www.deshrupantor.com/737645/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%B8%E0%A6%9C%E0%A6%BE%E0%A6%97-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%AC%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%A3%E0%A6%BF%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737645/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%B8%E0%A6%9C%E0%A6%BE%E0%A6%97-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%AC%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%A3%E0%A6%BF%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80</guid>
      <pubDate>Tue, 24 Nov 2026 21:56:10 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/009b7a11beb8ec45809ba5fa7a88273c-6b05b3897a192.jpg?jadewits_media_id=244961" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/009b7a11beb8ec45809ba5fa7a88273c-6b05b3897a192.jpg?jadewits_media_id=244961" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/009b7a11beb8ec45809ba5fa7a88273c-6b05b3897a192.jpg?jadewits_media_id=244961" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজপথে সজাগ থাকতে হবে: বাণিজ্যমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;দেশের আইনশৃঙ্খলা পরিস্থিতি স্বাভাবিক রাখা এবং জনগণের জানমালের নিরাপত্তা নিশ্চিত করতে সন্ত্রাস ও নাশকতার বিরুদ্ধে বিএনপির নেতাকর্মীদের সতর্ক ও সংগঠিত থাকার আহ্বান জানিয়েছেন বাণিজ্য, শিল্প এবং বস্ত্র ও পাটমন্ত্রী খন্দকার আব্দুল মুক্তাদির এমপি। তিনি বলেন, যেকোনো ষড়যন্ত্র ও অপতৎপরতা ঐক্যবদ্ধভাবে মোকাবিল&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737645/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%B8%E0%A6%9C%E0%A6%BE%E0%A6%97-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%AC%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%A3%E0%A6%BF%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>ঢাকায় ডিসেম্বরে হচ্ছে চতুর্থ স্কোয়াট বাংলাদেশ সিম্পোজিয়াম</title>
      <link>https://www.deshrupantor.com/737644/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%87-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%9A%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%A5-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%8B%E0%A7%9F%E0%A6%BE%E0%A6%9F-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737644/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%87-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%9A%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%A5-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%8B%E0%A7%9F%E0%A6%BE%E0%A6%9F-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6</guid>
      <pubDate>Tue, 24 Nov 2026 22:01:13 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/29e4842a54e5088273d717c28f79619e-6b05b276c80c0.jpg?jadewits_media_id=244960" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/29e4842a54e5088273d717c28f79619e-6b05b276c80c0.jpg?jadewits_media_id=244960" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/29e4842a54e5088273d717c28f79619e-6b05b276c80c0.jpg?jadewits_media_id=244960" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঢাকায় ডিসেম্বরে হচ্ছে চতুর্থ স্কোয়াট বাংলাদেশ সিম্পোজিয়াম" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশের সফটওয়্যার কোয়ালিটি, কিউএ ও সফটওয়্যার টেস্টিং পেশাজীবীদের অন্যতম প্ল্যাটফর্ম এসকিউএটি বাংলাদেশের চতুর্থ আয়োজন আগামী ৫ ডিসেম্বর ঢাকা শেরাটন হোটেলে অনুষ্ঠিত হবে। এবারের প্রতিপাদ্য ‘এআই যুগে সফটওয়্যার মান’। 
‘চতুর্থ সিম্পোজিয়াম অন সফটওয়্যার কিউএ অ্যান্ড টেস্টিং’ শীর্ষক এ আয়োজনে অংশ নেবেন আইএস&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737644/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%87-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%9A%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%A5-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%8B%E0%A7%9F%E0%A6%BE%E0%A6%9F-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>তথ্য কমিশনকে কার্যকর করতে তথ্য অধিকার ফোরামের আহ্বান</title>

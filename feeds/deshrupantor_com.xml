    <item>
      <title>বাংলাদেশ-পাকিস্তান ম্যাচ ছাড়াও টিভিতে যা যা দেখা যাবে</title>
      <link>https://www.deshrupantor.com/738101/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8-%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9A-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%93-%E0%A6%9F%E0%A6%BF%E0%A6%AD%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AF%E0%A6%BE-%E0%A6%AF%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/738101/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8-%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9A-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%93-%E0%A6%9F%E0%A6%BF%E0%A6%AD%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AF%E0%A6%BE-%E0%A6%AF%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BE</guid>
      <pubDate>Fri, 27 Nov 2026 04:00:00 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/04/23/8f5ca9d3a461f43b1c1378e14a5f68b3-69ea0448893bd.jpg?jadewits_media_id=191428" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/04/23/8f5ca9d3a461f43b1c1378e14a5f68b3-69ea0448893bd.jpg?jadewits_media_id=191428" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/04/23/8f5ca9d3a461f43b1c1378e14a5f68b3-69ea0448893bd.jpg?jadewits_media_id=191428" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাংলাদেশ-পাকিস্তান ম্যাচ ছাড়াও টিভিতে যা যা দেখা যাবে" /&gt;&lt;/p&gt;&lt;p&gt;নিউজিল্যান্ড-ভারত দ্বিতীয় টেস্ট চলছে ক্রাইস্টচার্চে। অস্ট্রেলিয়া-ইংল্যান্ডের তৃতীয় টি-টোয়েন্টি রয়েছে আজ। বাংলাদেশ-পাকিস্তান এ দলের মধ্যে এশিয়া কাপ রাইজিং স্টার্সের দ্বিতীয় সেমিফাইনাল শুরু হবে বিকেলে। এছাড়া বাংলাদেশ ফূটবল লিগের খেলা আছে দুপুর ও বিকেলে।&amp;nbsp;
ক্রিকেট
নিউজিল্যান্ড-ভারত দ্বিতীয় টেস্টভোর&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/738101/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8-%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9A-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%93-%E0%A6%9F%E0%A6%BF%E0%A6%AD%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AF%E0%A6%BE-%E0%A6%AF%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BE">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>কুয়াকাটায় পরিত্যক্ত জিপে আগুন</title>
      <link>https://www.deshrupantor.com/738272/%E0%A6%95%E0%A7%81%E0%A7%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%9F%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%9C%E0%A6%BF%E0%A6%AA%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</link>

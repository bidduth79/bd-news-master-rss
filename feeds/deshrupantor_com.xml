    <item>
      <title>দীপুর লড়াকু সেঞ্চুরি বিফলে; পাকিস্তানের কাছে হেরে বিদায় ‘এ’ দলের</title>
      <link>https://www.deshrupantor.com/738388/%E0%A6%A6%E0%A7%80%E0%A6%AA%E0%A7%81%E0%A6%B0-%E0%A6%B2%E0%A7%9C%E0%A6%BE%E0%A6%95%E0%A7%81-%E0%A6%B8%E0%A7%87%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%AC%E0%A6%BF%E0%A6%AB%E0%A6%B2%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%9B%E0%A7%87-%E0%A6%B9%E0%A7%87%E0%A6%B0%E0%A7%87</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/738388/%E0%A6%A6%E0%A7%80%E0%A6%AA%E0%A7%81%E0%A6%B0-%E0%A6%B2%E0%A7%9C%E0%A6%BE%E0%A6%95%E0%A7%81-%E0%A6%B8%E0%A7%87%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%AC%E0%A6%BF%E0%A6%AB%E0%A6%B2%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%9B%E0%A7%87-%E0%A6%B9%E0%A7%87%E0%A6%B0%E0%A7%87</guid>

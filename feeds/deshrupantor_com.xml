      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/64c9013fb4566bc37e40a30d36d177d6-6b0507bc955f8.jpg?jadewits_media_id=244753" style="max-width:100%;height:auto;margin-bottom:10px;" alt="উপকূলের কৃষিতে বদল আনছে কারিতাসের গবেষণা" /&gt;&lt;/p&gt;&lt;p&gt;কারিতাস বাংলাদেশের আয়োজনে &amp;lsquo;কৃষিবাস্তুতন্ত্রভিত্তিক পদ্ধতির মাধ্যমে উপকূলীয় দুর্যোগ সহনশীলতা বৃদ্ধি&amp;rsquo; শীর্ষক গবেষণার ফলাফল উপস্থাপন ও সহভাগিতা বিষয়ক জাতীয় সেমিনার অনুষ্ঠিত হয়েছে।
সোমবার (২৩ নভেম্বর) রাজধানীর বাংলাদেশ কৃষি গবেষণা কাউন্সিলের মিলনায়তনে এ সেমিনার অনুষ্ঠিত হয়।
সেমিনারে প্রধান অ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737469/%E0%A6%89%E0%A6%AA%E0%A6%95%E0%A7%82%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A7%83%E0%A6%B7%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%A6%E0%A6%B2-%E0%A6%86%E0%A6%A8%E0%A6%9B%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A6%BE%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A6%AC%E0%A7%87%E0%A6%B7%E0%A6%A3%E0%A6%BE">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>ভূমিকম্পে কেঁপে উঠল নেপাল</title>
      <link>https://www.deshrupantor.com/737468/%E0%A6%AD%E0%A7%82%E0%A6%AE%E0%A6%BF%E0%A6%95%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A7%87-%E0%A6%95%E0%A7%87%E0%A6%81%E0%A6%AA%E0%A7%87-%E0%A6%89%E0%A6%A0%E0%A6%B2-%E0%A6%A8%E0%A7%87%E0%A6%AA%E0%A6%BE%E0%A6%B2</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737468/%E0%A6%AD%E0%A7%82%E0%A6%AE%E0%A6%BF%E0%A6%95%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A7%87-%E0%A6%95%E0%A7%87%E0%A6%81%E0%A6%AA%E0%A7%87-%E0%A6%89%E0%A6%A0%E0%A6%B2-%E0%A6%A8%E0%A7%87%E0%A6%AA%E0%A6%BE%E0%A6%B2</guid>
      <pubDate>Tue, 24 Nov 2026 09:09:54 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/06/01/2e90700998161f593a08cba64a53ff3f-6a1d19c5efec0.jpg?jadewits_media_id=200788" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/06/01/2e90700998161f593a08cba64a53ff3f-6a1d19c5efec0.jpg?jadewits_media_id=200788" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/06/01/2e90700998161f593a08cba64a53ff3f-6a1d19c5efec0.jpg?jadewits_media_id=200788" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভূমিকম্পে কেঁপে উঠল নেপাল" /&gt;&lt;/p&gt;&lt;p&gt;নেপালের কোশি প্রদেশে ৫ দশমিক ৩ মাত্রার একটি ভূমিকম্প আঘাত হেনেছে।
মঙ্গলবার (২৪ নভেম্বর) এ ভূমিকম্পের তথ্য জানিয়েছে ইউরোপিয়ান-ভূমধ্যসাগরীয় ভূকম্পন কেন্দ্র (ইএমএসসি)।&amp;nbsp;
ইএমএসসি জানায়, ভূমিকম্পটির উৎপত্তিস্থল ছিল ভূপৃষ্ঠের ১০ কিলোমিটার (৬ দশমিক ২ মাইল) গভীরে। যুক্তরাষ্ট্রের ভূতাত্ত্বিক জরিপ সংস্থা &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737468/%E0%A6%AD%E0%A7%82%E0%A6%AE%E0%A6%BF%E0%A6%95%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A7%87-%E0%A6%95%E0%A7%87%E0%A6%81%E0%A6%AA%E0%A7%87-%E0%A6%89%E0%A6%A0%E0%A6%B2-%E0%A6%A8%E0%A7%87%E0%A6%AA%E0%A6%BE%E0%A6%B2">দেশ রূপান্তর</source>
    </item>

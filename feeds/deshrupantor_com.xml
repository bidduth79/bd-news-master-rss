      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/48d77e2b5050ec0e561632cf1a84ce36-6b0495bc5e818.jpg?jadewits_media_id=244721" length="0" type="image/jpeg" />

    <item>
      <title>তুরস্কের প্রেসিডেন্ট এরদোয়ানের সঙ্গে প্রধানমন্ত্রী তারেক রহমানের বৈঠক</title>
      <link>https://www.deshrupantor.com/734188/%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B8%E0%A6%BF%E0%A6%A1%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F-%E0%A6%8F%E0%A6%B0%E0%A6%A6%E0%A7%8B%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734188/%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B8%E0%A6%BF%E0%A6%A1%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F-%E0%A6%8F%E0%A6%B0%E0%A6%A6%E0%A7%8B%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80</guid>
      <pubDate>Tue, 10 Nov 2026 22:49:19 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/72c1193374d7f5cd6f33312eb1e0e094-6af347e46a29f.jpg?jadewits_media_id=241639" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/72c1193374d7f5cd6f33312eb1e0e094-6af347e46a29f.jpg?jadewits_media_id=241639" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/72c1193374d7f5cd6f33312eb1e0e094-6af347e46a29f.jpg?jadewits_media_id=241639" style="max-width:100%;height:auto;margin-bottom:10px;" alt="তুরস্কের প্রেসিডেন্ট এরদোয়ানের সঙ্গে প্রধানমন্ত্রী তারেক রহমানের বৈঠক" /&gt;&lt;/p&gt;&lt;p&gt;প্রধানমন্ত্রী তারেক রহমান তুরস্কের আন্তালিয়ায় দেশটির প্রেসিডেন্ট রজব তাইয়েব এরদোয়ানের সঙ্গে বৈঠক করেছেন।
বিএনপি সরকার দায়িত্ব নেওয়ার পর দুই দেশের পররাষ্ট্রমন্ত্রীদের পারস্পরিক সফর, বাংলাদেশের সেনাপ্রধানের তুরস্ক সফর ও শীর্ষ পর্যায়ের যোগাযোগে ঢাকা–আঙ্কারা সম্পর্কে যে ঘনিষ্ঠতা তৈরি হয়েছে, এ বৈঠক&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734188/%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B8%E0%A6%BF%E0%A6%A1%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F-%E0%A6%8F%E0%A6%B0%E0%A6%A6%E0%A7%8B%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>ঈশ্বরগঞ্জে ছাত্রলীগ নেতা ও ইউপি সদস্য গ্রেপ্তার</title>
      <link>https://www.deshrupantor.com/734185/%E0%A6%88%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%93-%E0%A6%87%E0%A6%89%E0%A6%AA%E0%A6%BF-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734185/%E0%A6%88%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%93-%E0%A6%87%E0%A6%89%E0%A6%AA%E0%A6%BF-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Tue, 10 Nov 2026 22:31:13 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/ec99c9126f29242bc5f52aae42b67bd1-6af346972e257.jpg?jadewits_media_id=241637" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/ec99c9126f29242bc5f52aae42b67bd1-6af346972e257.jpg?jadewits_media_id=241637" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/ec99c9126f29242bc5f52aae42b67bd1-6af346972e257.jpg?jadewits_media_id=241637" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঈশ্বরগঞ্জে ছাত্রলীগ নেতা ও ইউপি সদস্য গ্রেপ্তার" /&gt;&lt;/p&gt;&lt;p&gt;ময়মনসিংহের ঈশ্বরগঞ্জে কার্যক্রম নিষিদ্ধ ইউনিয়ন ছাত্রলীগের সাবেক সাধারণ সম্পাদক ও ইউনিয়ন পরিষদের (ইউপি) সদস্য আতিকুল ইসলাম ওরফে পিয়াসকে (৩১) গ্রেপ্তার করেছে পুলিশ।
সোমবার (৯ নভেম্বর) দিবাগত রাত ৮টার দিকে উপজেলার ঈশ্বরগঞ্জ ইউনিয়নের দড়িপাঁচাশি এলাকায় অভিযান চালায় পুলিশ। সেখানে তাকে না পেয়ে পরে ঈশ্বরগঞ্&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734185/%E0%A6%88%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%93-%E0%A6%87%E0%A6%89%E0%A6%AA%E0%A6%BF-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>নেগেটিভ ইক্যুইটি সমন্বয়ে ২০৩০ সাল পর্যন্ত ছাড়</title>
      <link>https://www.deshrupantor.com/734184/%E0%A6%A8%E0%A7%87%E0%A6%97%E0%A7%87%E0%A6%9F%E0%A6%BF%E0%A6%AD-%E0%A6%87%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%87%E0%A6%9F%E0%A6%BF-%E0%A6%B8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%AC%E0%A7%9F%E0%A7%87-%E0%A7%A8%E0%A7%A6%E0%A7%A9%E0%A7%A6-%E0%A6%B8%E0%A6%BE%E0%A6%B2-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%9B%E0%A6%BE%E0%A7%9C</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734184/%E0%A6%A8%E0%A7%87%E0%A6%97%E0%A7%87%E0%A6%9F%E0%A6%BF%E0%A6%AD-%E0%A6%87%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%87%E0%A6%9F%E0%A6%BF-%E0%A6%B8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%AC%E0%A7%9F%E0%A7%87-%E0%A7%A8%E0%A7%A6%E0%A7%A9%E0%A7%A6-%E0%A6%B8%E0%A6%BE%E0%A6%B2-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%9B%E0%A6%BE%E0%A7%9C</guid>
      <pubDate>Tue, 10 Nov 2026 22:21:39 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/51af5088147c559fdc7d35502b5844b2-6af3446c9ee2a.jpg?jadewits_media_id=241636" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/51af5088147c559fdc7d35502b5844b2-6af3446c9ee2a.jpg?jadewits_media_id=241636" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/51af5088147c559fdc7d35502b5844b2-6af3446c9ee2a.jpg?jadewits_media_id=241636" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নেগেটিভ ইক্যুইটি সমন্বয়ে ২০৩০ সাল পর্যন্ত ছাড়" /&gt;&lt;/p&gt;&lt;p&gt;পুঁজিবাজারে স্টক ব্রোকার ও মার্চেন্ট ব্যাংকারদের নেগেটিভ ইক্যুইটি এবং আনরিয়ালাইজড লস সমন্বয়ের জন্য ২০৩০ সাল পর্যন্ত সময় নির্ধারণ করেছে বাংলাদেশ সিকিউরিটিজ অ্যান্ড এক্সচেঞ্জ কমিশন (বিএসইসি)। এ সময়ের মধ্যে পর্যায়ক্রমে বিদ্যমান ঘাটতি সমন্বয় করতে হবে সংশ্লিষ্ট প্রতিষ্ঠানগুলোকে।
এ জন্য ২০২৭ সাল থেকে প্রত&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734184/%E0%A6%A8%E0%A7%87%E0%A6%97%E0%A7%87%E0%A6%9F%E0%A6%BF%E0%A6%AD-%E0%A6%87%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%87%E0%A6%9F%E0%A6%BF-%E0%A6%B8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%AC%E0%A7%9F%E0%A7%87-%E0%A7%A8%E0%A7%A6%E0%A7%A9%E0%A7%A6-%E0%A6%B8%E0%A6%BE%E0%A6%B2-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%9B%E0%A6%BE%E0%A7%9C">দেশ রূপান্তর</source>
    </item>

    <item>
      <title>তহবিলের নামে ঋণের ব্যবসা!</title>
      <link>https://www.deshrupantor.com/734517/%E0%A6%A4%E0%A6%B9%E0%A6%AC%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%8B%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734517/%E0%A6%A4%E0%A6%B9%E0%A6%AC%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%8B%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A6%BE</guid>
      <pubDate>Thu, 12 Nov 2026 01:49:43 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/35227811732f0e100439391794f24a9d-6af4c6d092d9d.jpg?jadewits_media_id=241934" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/35227811732f0e100439391794f24a9d-6af4c6d092d9d.jpg?jadewits_media_id=241934" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/35227811732f0e100439391794f24a9d-6af4c6d092d9d.jpg?jadewits_media_id=241934" style="max-width:100%;height:auto;margin-bottom:10px;" alt="তহবিলের নামে ঋণের ব্যবসা!" /&gt;&lt;/p&gt;&lt;p&gt;জলবায়ু পরিবর্তনের জন্য দায় বাংলাদেশের খুবই সামান্য। অথচ জলবায়ু বিপর্যয়ের ক্ষতি সামলাতে গিয়ে সবচেয়ে বড় আর্থিক চাপের মুখে আছে বাংলাদেশ। একদিকে ঘূর্ণিঝড়, বন্যা, নদীভাঙন, লবণাক্ততা ও তাপপ্রবাহের ক্ষতি মোকাবিলা করতে হচ্ছে; অন্যদিকে সেই ক্ষতি সামলানোর অর্থ সংগ্রহেও আন্তর্জাতিক সহযোগিতার অপেক্ষায় থাকতে হচ্&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734517/%E0%A6%A4%E0%A6%B9%E0%A6%AC%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%8B%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A6%BE">দেশ রূপান্তর</source>
    </item>

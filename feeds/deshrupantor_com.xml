    <item>
      <title>নারীদের চর্মরোগ বাড়ছে</title>
      <link>https://www.deshrupantor.com/737736/%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%B0%E0%A7%8B%E0%A6%97-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%9B%E0%A7%87</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737736/%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%B0%E0%A7%8B%E0%A6%97-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%9B%E0%A7%87</guid>
      <pubDate>Wed, 25 Nov 2026 07:43:21 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/d2c67542a5ccb7bb29498eaa9d4a8d57-6b063d3404770.jpg?jadewits_media_id=245031" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/d2c67542a5ccb7bb29498eaa9d4a8d57-6b063d3404770.jpg?jadewits_media_id=245031" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/d2c67542a5ccb7bb29498eaa9d4a8d57-6b063d3404770.jpg?jadewits_media_id=245031" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নারীদের চর্মরোগ বাড়ছে" /&gt;&lt;/p&gt;&lt;p&gt;সুন্দরবন উপকূলের মানুষের কাছে লবণাক্ততা, ঘূর্ণিঝড় ও সুপেয় পানির সংকট দীর্ঘদিনের পরিচিত দুর্যোগ। তবে খুলনার কয়রা, দাকোপ এবং সাতক্ষীরার আশাশুনি ও শ্যামনগর উপজেলায় এখন নতুন আতঙ্ক হয়ে দাঁড়িয়েছে তীব্র চর্মরোগ। স্থানীয়দের অভিজ্ঞতায়, পুরুষের তুলনায় এই রোগে নারীরাই বেশি আক্রান্ত হচ্ছেন।
ভুক্তভোগীদের শরীরে &lt;/p&gt;</description>

      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/0143d55801537753857a5b1f20ff004a-6b07371aeaaf6.jpg?jadewits_media_id=245262" length="0" type="image/jpeg" />

    <item>
      <title>অপরাধ দমনে কুমিল্লায় ১১ দিনে আটক ২৭৬৫</title>
      <link>https://www.deshrupantor.com/734612/%E0%A6%85%E0%A6%AA%E0%A6%B0%E0%A6%BE%E0%A6%A7-%E0%A6%A6%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%95%E0%A7%81%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A7%A7%E0%A7%A7-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A7%A8%E0%A7%AD%E0%A7%AC%E0%A7%AB</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734612/%E0%A6%85%E0%A6%AA%E0%A6%B0%E0%A6%BE%E0%A6%A7-%E0%A6%A6%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%95%E0%A7%81%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A7%A7%E0%A7%A7-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A7%A8%E0%A7%AD%E0%A7%AC%E0%A7%AB</guid>
      <pubDate>Thu, 12 Nov 2026 15:12:34 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/08/07/9f898e56e4315b781550539ff6a39477-6a75da53e9544.jpg?jadewits_media_id=219165" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/08/07/9f898e56e4315b781550539ff6a39477-6a75da53e9544.jpg?jadewits_media_id=219165" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/08/07/9f898e56e4315b781550539ff6a39477-6a75da53e9544.jpg?jadewits_media_id=219165" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অপরাধ দমনে কুমিল্লায় ১১ দিনে আটক ২৭৬৫" /&gt;&lt;/p&gt;&lt;p&gt;কুমিল্লায় মাদক ব্যবসা, কিশোর গ্যাং ও ছিনতাইসহ বিভিন্ন অপরাধ দমনে পুলিশের বিশেষ অভিযানে ১১ দিনে ২ হাজার ৭৬৫ জনকে আটক করা হয়েছে। গত ১ থেকে ১১ নভেম্বর পর্যন্ত জেলার ১৮টি থানায় একযোগে এসব অভিযান পরিচালনা করা হয়।
বৃহস্পতিবার (১২ নভেম্বর) দুপুরে কুমিল্লার অতিরিক্ত পুলিশ সুপার মো. লুৎফর রহমান এ তথ্য নিশ্চি&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734612/%E0%A6%85%E0%A6%AA%E0%A6%B0%E0%A6%BE%E0%A6%A7-%E0%A6%A6%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%95%E0%A7%81%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A7%A7%E0%A7%A7-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A7%A8%E0%A7%AD%E0%A7%AC%E0%A7%AB">দেশ রূপান্তর</source>
    </item>

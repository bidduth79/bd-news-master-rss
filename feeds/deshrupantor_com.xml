    <item>
      <title>গাজীপুরে ৮ জোনে চলবে আট রঙের ই-রিকশা</title>
      <link>https://www.deshrupantor.com/736296/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A7%80%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A7%AE-%E0%A6%9C%E0%A7%8B%E0%A6%A8%E0%A7%87-%E0%A6%9A%E0%A6%B2%E0%A6%AC%E0%A7%87-%E0%A6%86%E0%A6%9F-%E0%A6%B0%E0%A6%99%E0%A7%87%E0%A6%B0-%E0%A6%87-%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%B6%E0%A6%BE</link>

      <guid isPermaLink="true">https://www.deshrupantor.com/734803/%E0%A6%8F%E0%A6%87%E0%A6%9A%E0%A6%8F%E0%A6%B8%E0%A6%B8%E0%A6%BF-%E0%A6%B8%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A6%BF%E0%A6%AE%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%AC%E0%A7%87</guid>
      <pubDate>Fri, 13 Nov 2026 10:18:09 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/08/04/d35d716a14f1f2d9086ebaea86093e65-6a71a881a4385.jpeg?jadewits_media_id=218252" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/08/04/d35d716a14f1f2d9086ebaea86093e65-6a71a881a4385.jpeg?jadewits_media_id=218252" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/08/04/d35d716a14f1f2d9086ebaea86093e65-6a71a881a4385.jpeg?jadewits_media_id=218252" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এইচএসসি সাপ্লিমেন্টারি পরীক্ষার্থীদের মানতে হবে যেসব নির্দেশনা" /&gt;&lt;/p&gt;&lt;p&gt;২০২৬ সালের ও সমমানের সাপ্লিমেন্টারি পরীক্ষা আগামী ১ ডিসেম্বর থেকে শুরু হচ্ছে, চলবে ১৫ ডিসেম্বর পর্যন্ত। লিখিত পরীক্ষার পাশাপাশি এ সময়ের মধ্যে ব্যবহারিক পরীক্ষাও শেষ করতে হবে।
বৃহস্পতিবার (১২ নভেম্বর) প্রকাশিত পরীক্ষার রুটিনে দেখা গেছে, ১ ডিসেম্বর ইংরেজি প্রথম পত্রের মাধ্যমে পরীক্ষা শুরু হবে। ওই দিন &lt;/p&gt;</description>

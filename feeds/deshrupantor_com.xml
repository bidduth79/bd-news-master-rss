      <guid isPermaLink="true">https://www.deshrupantor.com/734182/%E0%A6%9C%E0%A7%80%E0%A6%AC%E0%A6%BE%E0%A6%B6%E0%A7%8D%E0%A6%AE-%E0%A6%9C%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%A4%E0%A6%BF-%E0%A6%A8%E0%A7%9F-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A6%B0</guid>
      <pubDate>Tue, 10 Nov 2026 22:19:36 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/b40eb1cd83248e1673ea9cf74499ebcc-6af3425516c03.jpg?jadewits_media_id=241634" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/b40eb1cd83248e1673ea9cf74499ebcc-6af3425516c03.jpg?jadewits_media_id=241634" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/b40eb1cd83248e1673ea9cf74499ebcc-6af3425516c03.jpg?jadewits_media_id=241634" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জীবাশ্ম জ্বালানি ছাড়ার প্রতিশ্রুতি নয়, কার্যকর পরিকল্পনা দরকার" /&gt;&lt;/p&gt;&lt;p&gt;জীবাশ্ম জ্বালানির ওপর নির্ভরতা কমিয়ে পরিচ্ছন্ন জ্বালানিতে রূপান্তরের জন্য শুধু প্রতিশ্রুতি নয়, প্রয়োজন কার্যকর পরিকল্পনা, বিনিয়োগ ও বাস্তবায়ন। ২০৩৫ সালের মধ্যে বৈশ্বিক জ্বালানি ব্যবহারে বিদ্যুতের অংশ ২৩ শতাংশ থেকে বাড়িয়ে ৩৫ শতাংশে উন্নীত করার লক্ষ্য নির্ধারণ করা হয়েছে। একইসঙ্গে জীবাশ্ম জ্বালানি থেকে&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734182/%E0%A6%9C%E0%A7%80%E0%A6%AC%E0%A6%BE%E0%A6%B6%E0%A7%8D%E0%A6%AE-%E0%A6%9C%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%A4%E0%A6%BF-%E0%A6%A8%E0%A7%9F-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A6%B0">দেশ রূপান্তর</source>

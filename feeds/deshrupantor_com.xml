      <guid isPermaLink="true">https://www.deshrupantor.com/736596/%E0%A6%AB%E0%A7%81%E0%A6%9F%E0%A6%AC%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A7%87%E0%A7%9F%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%97%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%87-%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%BF-%E0%A6%B8%E0%A7%81%E0%A6%96%E0%A7%80-%E0%A6%9B%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%86%E0%A6%B2%E0%A6%AD%E0%A7%87%E0%A6%B8</guid>
      <pubDate>Fri, 20 Nov 2026 16:48:55 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/2b7da178d0f843e676a60bac9407292f-6b002524e4a93.jpg?jadewits_media_id=243930" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/2b7da178d0f843e676a60bac9407292f-6b002524e4a93.jpg?jadewits_media_id=243930" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/2b7da178d0f843e676a60bac9407292f-6b002524e4a93.jpg?jadewits_media_id=243930" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফুটবলের চেয়ে কারাগারেই বেশি সুখী ছিলেন দানি আলভেস" /&gt;&lt;/p&gt;&lt;p&gt;একসময় ইউরোপের নামীদামি সব ক্লাবের হয়ে ট্রফির পর ট্রফি জিতেছেন, আয় করেছেন কোটি কোটি ইউরো; অথচ সেই আলোর ঝলমলে জীবনকে ছাপিয়ে স্পেনের কারাগারে কাটানো দিনগুলোকেই নিজের সবচেয়ে সুখের সময় বলে দাবি করলেন দানি আলভেস। 
ইভাঞ্জেলিক্যাল ধর্মপ্রচারক হিসেবে সাম্প্রতিক এক ধর্মীয় আলোচনায় এই ব্রাজিলিয়ান কিংবদন্তি জানি&lt;/p&gt;</description>

      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/45c351b8bba98e9373e77f09ecd0a1ee-6b04800f1c3d5.jpg?jadewits_media_id=244689" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/45c351b8bba98e9373e77f09ecd0a1ee-6b04800f1c3d5.jpg?jadewits_media_id=244689" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/45c351b8bba98e9373e77f09ecd0a1ee-6b04800f1c3d5.jpg?jadewits_media_id=244689" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সূচকের মিশ্র প্রবণতায় ডিএসইতে ৯২০ কোটি টাকার লেনদেন" /&gt;&lt;/p&gt;&lt;p&gt;সপ্তাহের দ্বিতীয় কার্যদিবস সোমবার দেশের প্রধান শেয়ারবাজার ঢাকা স্টক এক্সচেঞ্জে (ডিএসই) মিশ্র প্রবণতায় লেনদেন শেষ হয়েছে। এদিন বাজারটিতে ৯২০ কোটি ৮১ লাখ টাকার শেয়ার ও ইউনিট হাতবদল হয়েছে।
ডিএসইর সর্বশেষ বাজার তথ্য অনুযায়ী, দিন শেষে প্রধান সূচক ডিএসইএক্স ৮ দশমিক ৪১ পয়েন্ট কমে ৫ হাজার ৫৫৭ দশমিক ১৮ পয়েন্ট&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737405/%E0%A6%B8%E0%A7%82%E0%A6%9A%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%A3%E0%A6%A4%E0%A6%BE%E0%A7%9F-%E0%A6%A1%E0%A6%BF%E0%A6%8F%E0%A6%B8%E0%A6%87%E0%A6%A4%E0%A7%87-%E0%A7%AF%E0%A7%A8%E0%A7%A6-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>টিসিবির পণ্য সংরক্ষণ সক্ষমতা ১ লাখ টনে উন্নীতের পরিকল্পনা</title>
      <link>https://www.deshrupantor.com/737404/%E0%A6%9F%E0%A6%BF%E0%A6%B8%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A6%A3%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A6%82%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A3-%E0%A6%B8%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%AE%E0%A6%A4%E0%A6%BE-%E0%A7%A7-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%9F%E0%A6%A8%E0%A7%87-%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737404/%E0%A6%9F%E0%A6%BF%E0%A6%B8%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A6%A3%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A6%82%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A3-%E0%A6%B8%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%AE%E0%A6%A4%E0%A6%BE-%E0%A7%A7-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%9F%E0%A6%A8%E0%A7%87-%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Tue, 24 Nov 2026 01:33:21 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/45c351b8bba98e9373e77f09ecd0a1ee-6b04800f1c3d5.jpg?jadewits_media_id=244689" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/45c351b8bba98e9373e77f09ecd0a1ee-6b04800f1c3d5.jpg?jadewits_media_id=244689" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/45c351b8bba98e9373e77f09ecd0a1ee-6b04800f1c3d5.jpg?jadewits_media_id=244689" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টিসিবির পণ্য সংরক্ষণ সক্ষমতা ১ লাখ টনে উন্নীতের পরিকল্পনা" /&gt;&lt;/p&gt;&lt;p&gt;নিত্যপ্রয়োজনীয় পণ্যের মজুত সক্ষমতা বাড়ানো, সরবরাহ ব্যবস্থাপনা শক্তিশালী করা এবং ভোক্তাদের কাছে পণ্যের নিরবচ্ছিন্ন সরবরাহ নিশ্চিত করতে গুদামজাতকরণ সক্ষমতা বাড়ানোর উদ্যোগ নিয়েছে ট্রেডিং করপোরেশন অব বাংলাদেশ (টিসিবি)।
আগামী এক থেকে দেড় বছরের মধ্যে সংস্থাটির নিজস্ব পণ্য সংরক্ষণ সক্ষমতা এক লাখ মেট্রিক টন&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737404/%E0%A6%9F%E0%A6%BF%E0%A6%B8%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A6%A3%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A6%82%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A3-%E0%A6%B8%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%AE%E0%A6%A4%E0%A6%BE-%E0%A7%A7-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%9F%E0%A6%A8%E0%A7%87-%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87%E0%A6%B0">দেশ রূপান্তর</source>
    </item>

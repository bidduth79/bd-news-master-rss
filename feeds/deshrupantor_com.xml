      <guid isPermaLink="true">https://www.deshrupantor.com/736157/%E0%A6%AC%E0%A6%97%E0%A7%81%E0%A7%9C%E0%A6%BE%E0%A7%9F-%E0%A6%9F%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AA%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%A1%E0%A6%B2%E0%A6%B8%E0%A6%B9-%E0%A6%AE%E0%A6%BE-%E0%A6%9B%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Wed, 18 Nov 2026 18:22:22 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/daad34d6eb41f123e026b3b7db919382-6afd987ba54b2.jpg?jadewits_media_id=243531" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/daad34d6eb41f123e026b3b7db919382-6afd987ba54b2.jpg?jadewits_media_id=243531" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/daad34d6eb41f123e026b3b7db919382-6afd987ba54b2.jpg?jadewits_media_id=243531" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বগুড়ায় ট্যাপেন্টাডলসহ মা-ছেলে গ্রেপ্তার" /&gt;&lt;/p&gt;&lt;p&gt;বগুড়ায় জেলা গোয়েন্দা পুলিশের (ডিবি) মাদকবিরোধী অভিযানে ১১ হাজার ৫০০ পিস ট্যাপেন্টাডল ট্যাবলেটসহ মা ও ছেলেকে গ্রেপ্তার করা হয়েছে।
বুধবার (১৮ নভেম্বর) বিকেল সোয়া ৩টার দিকে জেলা পুলিশের অতিরিক্ত পুলিশ সুপার ও মিডিয়া মুখপাত্র আতোয়ার রহমান বিষয়টি নিশ্চিত করেছেন। এরআগে ভোররাত ৫টার দিকে জেলার সদর উপজেলার &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736157/%E0%A6%AC%E0%A6%97%E0%A7%81%E0%A7%9C%E0%A6%BE%E0%A7%9F-%E0%A6%9F%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AA%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%A1%E0%A6%B2%E0%A6%B8%E0%A6%B9-%E0%A6%AE%E0%A6%BE-%E0%A6%9B%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0">দেশ রূপান্তর</source>
    </item>

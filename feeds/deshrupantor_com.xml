    <item>
      <title>কঠিন চীবর দানোৎসবে বিদেশি ভিক্ষুরাও</title>
      <link>https://www.deshrupantor.com/736733/%E0%A6%95%E0%A6%A0%E0%A6%BF%E0%A6%A8-%E0%A6%9A%E0%A7%80%E0%A6%AC%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A7%8B%E0%A7%8E%E0%A6%B8%E0%A6%AC%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF-%E0%A6%AD%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%81%E0%A6%B0%E0%A6%BE%E0%A6%93</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736733/%E0%A6%95%E0%A6%A0%E0%A6%BF%E0%A6%A8-%E0%A6%9A%E0%A7%80%E0%A6%AC%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A7%8B%E0%A7%8E%E0%A6%B8%E0%A6%AC%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF-%E0%A6%AD%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%81%E0%A6%B0%E0%A6%BE%E0%A6%93</guid>
      <pubDate>Sat, 21 Nov 2026 07:09:52 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/684b7a261a4ed9e812aaaa309d11b96a-6b008fd7c4d2b.jpg?jadewits_media_id=244037" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/684b7a261a4ed9e812aaaa309d11b96a-6b008fd7c4d2b.jpg?jadewits_media_id=244037" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/684b7a261a4ed9e812aaaa309d11b96a-6b008fd7c4d2b.jpg?jadewits_media_id=244037" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কঠিন চীবর দানোৎসবে বিদেশি ভিক্ষুরাও" /&gt;&lt;/p&gt;&lt;p&gt;লাখো পুণ্যার্থীর অংশগ্রহণে রাঙ্গামাটির রাজবন বিহারে অনুষ্ঠিত হয়েছে দুই দিনব্যাপী ৫০তম কঠিন চীবর দানোৎসব। এটি বৌদ্ধ ধর্মাবলম্বীদের সবচেয়ে বড় ধর্মীয় উৎসব। গতকাল শুক্রবার দুপুরে রাঙ্গামাটি রাজবন বিহারের ৫০তম কঠিন চীবর দানোৎসব অনুষ্ঠানে ২৪ ঘণ্টার মধ্যে তুলা থেকে সুতা তৈরি করে কোমর তাঁতের মাধ্যমে বুননের &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736733/%E0%A6%95%E0%A6%A0%E0%A6%BF%E0%A6%A8-%E0%A6%9A%E0%A7%80%E0%A6%AC%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A7%8B%E0%A7%8E%E0%A6%B8%E0%A6%AC%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF-%E0%A6%AD%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%81%E0%A6%B0%E0%A6%BE%E0%A6%93">দেশ রূপান্তর</source>
    </item>

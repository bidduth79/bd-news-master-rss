      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2023/11/01/756bedac712941f47eb46b3a34b88636-6541866731238.png?jadewits_media_id=9" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শেখ হাসিনাকে ফেরাতে ভারত কোনো শর্ত দেয়নি : প্রতিমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;ভারতে আশ্রয় নেওয়া সাবেক প্রধানমন্ত্রী শেখ হাসিনাকে ফেরাতে দেশটি কোনো শর্ত দেয়নি বলে জানিয়েছেন পররাষ্ট্র প্রতিমন্ত্রী শামা ওবায়েদ ইসলাম। তিনি বলেন, বাংলাদেশ ও ভারতের দ্বিপক্ষীয় সম্পর্ক শেখ হাসিনা ইস্যুর চেয়ে বেশি গুরুত্বপূর্ণ। গতকাল সোমবার পররাষ্ট্র মন্ত্রণালয়ে সাংবাদিকদের প্রশ্নের জবাবে প্রতিমন্ত্রী&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735793/%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4-%E0%A6%95%E0%A7%8B%E0%A6%A8%E0%A7%8B-%E0%A6%B6%E0%A6%B0%E0%A7%8D%E0%A6%A4-%E0%A6%A6%E0%A7%87%E0%A7%9F%E0%A6%A8%E0%A6%BF">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>পাচারের অর্থ আদায়ে ইতিবাচক সাড়া</title>
      <link>https://www.deshrupantor.com/735792/%E0%A6%AA%E0%A6%BE%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A5-%E0%A6%86%E0%A6%A6%E0%A6%BE%E0%A7%9F%E0%A7%87-%E0%A6%87%E0%A6%A4%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%9A%E0%A6%95-%E0%A6%B8%E0%A6%BE%E0%A7%9C%E0%A6%BE%C2%A0</link>

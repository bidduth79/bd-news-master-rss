    </item>
    <item>
      <title>শ্রমিকদের জন্য ১০০ শয্যাবিশিষ্ট ছয়টি হাসপাতাল নির্মিত হবে: প্রধানমন্ত্রী</title>
      <link>https://www.deshrupantor.com/733912/%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A7%A7%E0%A7%A6%E0%A7%A6-%E0%A6%B6%E0%A6%AF%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%9F-%E0%A6%9B%E0%A7%9F%E0%A6%9F%E0%A6%BF-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B2</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/733912/%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A7%A7%E0%A7%A6%E0%A7%A6-%E0%A6%B6%E0%A6%AF%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%9F-%E0%A6%9B%E0%A7%9F%E0%A6%9F%E0%A6%BF-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B2</guid>
      <pubDate>Mon, 09 Nov 2026 20:33:38 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/c57f4ec30b645e53b9cf7220a80f6437-6af1d99d9348d.jpg?jadewits_media_id=241365" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/c57f4ec30b645e53b9cf7220a80f6437-6af1d99d9348d.jpg?jadewits_media_id=241365" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/c57f4ec30b645e53b9cf7220a80f6437-6af1d99d9348d.jpg?jadewits_media_id=241365" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শ্রমিকদের জন্য ১০০ শয্যাবিশিষ্ট ছয়টি হাসপাতাল নির্মিত হবে: প্রধানমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;প্রধানমন্ত্রী তারেক রহমান বলেছেন, দেশের প্রধান শিল্পাঞ্চলগুলোতে শ্রমিকদের জন্য ছয়টি ১০০ শয্যাবিশিষ্ট হাসপাতাল নির্মাণের পরিকল্পনা গ্রহণ করেছে সরকার।
আজ ১৩তম জাতীয় সংসদের চতুর্থ অধিবেশনে পাবনা-৫ (সদর) আসনের সংসদ সদস্য অ্যাডভোকেট শামসুর রহমান শিমুল বিশ্বাসের এক প্রশ্নের জবাবে তিনি এ কথা বলেন।
ওই প্রশ্&lt;/p&gt;</description>

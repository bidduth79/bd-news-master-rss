      <guid isPermaLink="true">https://www.deshrupantor.com/738538/%E0%A6%AE%E0%A6%A0%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%A3-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%9A%E0%A7%87%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BE</guid>
      <pubDate>Sat, 28 Nov 2026 15:38:45 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/f64ab03485e06d47518adc4db55be6cb-6b0aa1177b259.jpg?jadewits_media_id=245795" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/f64ab03485e06d47518adc4db55be6cb-6b0aa1177b259.jpg?jadewits_media_id=245795" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/f64ab03485e06d47518adc4db55be6cb-6b0aa1177b259.jpg?jadewits_media_id=245795" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মঠবাড়িয়ায় গ্রামীণ ব্যাংকে আগুন দেওয়ার চেষ্টা" /&gt;&lt;/p&gt;&lt;p&gt;পিরোজপুরের মঠবাড়িয়া উপজেলার ধানিসাফা ইউনিয়ন বাজারে গ্রামীণ ব্যাংকের একটি শাখায় আগুন দেওয়ার চেষ্টা করেছে দুর্বৃত্তরা। তবে নৈশপ্রহরীর তৎপরতায় আগুন নিয়ন্ত্রণে আসায় বড় ধরনের ক্ষয়ক্ষতি হয়নি।
গ্রামীণ ব্যাংক ধানিসাফা ইউনিয়ন শাখা সূত্রে জানা যায়, শনিবার (২৮ নভেম্বর) ভোর পাঁচটার দিকে অজ্ঞাতনামা দুর্বৃত্তরা ব&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/738538/%E0%A6%AE%E0%A6%A0%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%A3-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%9A%E0%A7%87%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BE">দেশ রূপান্তর</source>
    </item>

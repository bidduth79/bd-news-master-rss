      <guid isPermaLink="true">https://www.deshrupantor.com/735482/%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A7%87%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%8F%E0%A6%A8%E0%A6%AD%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%B6%E0%A7%87%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%A6%E0%A6%B0%E0%A6%AA%E0%A6%A4%E0%A6%A8%E0%A7%87</guid>
      <pubDate>Mon, 16 Nov 2026 01:15:18 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/32221e2251384170fac6cad09238bd8d-6af9ea6fc0fb6.jpg?jadewits_media_id=242865" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/32221e2251384170fac6cad09238bd8d-6af9ea6fc0fb6.jpg?jadewits_media_id=242865" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/32221e2251384170fac6cad09238bd8d-6af9ea6fc0fb6.jpg?jadewits_media_id=242865" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যুক্তরাষ্ট্রের শেয়ারবাজারে এনভিডিয়ার শেয়ারে দরপতনে প্রভাব" /&gt;&lt;/p&gt;&lt;p&gt;এনভিডিয়ার শেয়ারের ধারাবাহিক দরপতনের প্রভাবে সপ্তাহের শেষ কার্যদিবসে নিম্নমুখী প্রবণতায় লেনদেন শেষ করেছে যুক্তরাষ্ট্রের প্রধান দুই পুঁজিবাজার সূচক নাসডাক ও এসঅ্যান্ডপি ৫০০। তবে শেষ দিনের পতন সত্ত্বেও পুরো সপ্তাহের হিসাবে তিনটি প্রধান সূচকেই উল্লেখযোগ্য উত্থান দেখা গেছে। আগস্টের শুরুর পর এটিই ছিল সূচক&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735482/%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A7%87%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%8F%E0%A6%A8%E0%A6%AD%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%B6%E0%A7%87%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%A6%E0%A6%B0%E0%A6%AA%E0%A6%A4%E0%A6%A8%E0%A7%87">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>সম্মিলিত ইসলামী ব্যাংক আমানত ফেরত দেবে</title>
      <link>https://www.deshrupantor.com/735481/%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%BF%E0%A6%A4-%E0%A6%87%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95-%E0%A6%86%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%A4-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%A4-%E0%A6%A6%E0%A7%87%E0%A6%AC%E0%A7%87</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735481/%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%BF%E0%A6%A4-%E0%A6%87%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95-%E0%A6%86%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%A4-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%A4-%E0%A6%A6%E0%A7%87%E0%A6%AC%E0%A7%87</guid>
      <pubDate>Mon, 16 Nov 2026 01:14:55 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/32221e2251384170fac6cad09238bd8d-6af9ea6fc0fb6.jpg?jadewits_media_id=242865" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/32221e2251384170fac6cad09238bd8d-6af9ea6fc0fb6.jpg?jadewits_media_id=242865" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/32221e2251384170fac6cad09238bd8d-6af9ea6fc0fb6.jpg?jadewits_media_id=242865" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সম্মিলিত ইসলামী ব্যাংক আমানত ফেরত দেবে" /&gt;&lt;/p&gt;&lt;p&gt;আমানতকারীদের অর্থ ফেরত দেওয়ার সক্ষমতা হারানো পাঁচটি ব্যাংক একীভূত করে গঠন করা হয়েছে রাষ্ট্রীয় মালিকানাধীন সম্মিলিত ইসলামী ব্যাংক। শুরুতে ক্ষুদ্র ও ব্যক্তিগত আমানতকারীদের অর্থ ফেরত দেওয়াকে অগ্রাধিকার দেওয়া হলেও বড় অঙ্কের করপোরেট আমানত এখনই ফেরত দেওয়া সরকারের পক্ষে সম্ভব নয়। তবে ব্যাংকটি ধীরে ধীরে ঘুর&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735481/%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%BF%E0%A6%A4-%E0%A6%87%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95-%E0%A6%86%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%A4-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%A4-%E0%A6%A6%E0%A7%87%E0%A6%AC%E0%A7%87">দেশ রূপান্তর</source>

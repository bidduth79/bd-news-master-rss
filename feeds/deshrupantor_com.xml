      <guid isPermaLink="true">https://www.deshrupantor.com/735431/%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A7%9F%E0%A6%BF%E0%A6%95-%E0%A6%AC%E0%A6%B0%E0%A6%96%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4-%E0%A6%AC%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A7%87%E0%A6%9F-%E0%A6%A6%E0%A6%96%E0%A6%B2%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Sun, 15 Nov 2026 20:29:47 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/e7af89eefb95b0e27f6d10e7a154ab30-6af9c1b307f4a.jpeg?jadewits_media_id=242848" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/e7af89eefb95b0e27f6d10e7a154ab30-6af9c1b307f4a.jpeg?jadewits_media_id=242848" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/e7af89eefb95b0e27f6d10e7a154ab30-6af9c1b307f4a.jpeg?jadewits_media_id=242848" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাময়িক বরখাস্ত বিচারকের বিরুদ্ধে মার্কেট দখলের অভিযোগ" /&gt;&lt;/p&gt;&lt;p&gt;সাময়িক বরখাস্ত হওয়া বিচারক মো. আরিফুল ইসলাম সোহেলের বিরুদ্ধে গাজীপুরের চান্দনা চৌরাস্তার হাজী হোসেন পাইকারি মার্কেটের ১০০টি দোকান ও একটি গার্মেন্টস কারখানা দখলের চেষ্টার অভিযোগ উঠেছে। একই সঙ্গে ব্যবসায়ীদের ওপর হামলা, ভয়ভীতি প্রদর্শন এবং মিথ্যা মামলা দিয়ে হয়রানি করার অভিযোগও করেছেন মার্কেটের ব্যবসায়ী&lt;/p&gt;</description>

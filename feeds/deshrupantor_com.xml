    <item>
      <title>রমজানে ১১ পণ্য আমদানিতে বড় ছাড় দিল বাংলাদেশ ব্যাংক</title>
      <link>https://www.deshrupantor.com/733636/%E0%A6%B0%E0%A6%AE%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A7%A7%E0%A7%A7-%E0%A6%AA%E0%A6%A3%E0%A7%8D%E0%A6%AF-%E0%A6%86%E0%A6%AE%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A7%9C-%E0%A6%9B%E0%A6%BE%E0%A7%9C-%E0%A6%A6%E0%A6%BF%E0%A6%B2-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/733636/%E0%A6%B0%E0%A6%AE%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A7%A7%E0%A7%A7-%E0%A6%AA%E0%A6%A3%E0%A7%8D%E0%A6%AF-%E0%A6%86%E0%A6%AE%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A7%9C-%E0%A6%9B%E0%A6%BE%E0%A7%9C-%E0%A6%A6%E0%A6%BF%E0%A6%B2-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95</guid>
      <pubDate>Sun, 08 Nov 2026 20:09:52 +0600</pubDate>
      <description>আসন্ন রমজানে নিত্যপ্রয়োজনীয় পণ্যের সরবরাহ স্বাভাবিক রাখা এবং বাজারদর সহনীয় পর্যায়ে রাখতে ১১টি পণ্য আমদানিতে বিশেষ সুবিধা দিয়েছে বাংলাদেশ ব্যাংক। নতুন নির্দেশনা অনুযায়ী, এসব পণ্য আমদানির ক্ষেত্রে ঋণপত্র (এলসি) খোলার সময় আমদানিকারকদের আর শতভাগ নগদ মার্জিন জমা রাখতে হবে না।
রোববার (৮ নভেম্বর) এ বিষয়ে এ</description>
      <source url="https://www.deshrupantor.com/733636/%E0%A6%B0%E0%A6%AE%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A7%A7%E0%A7%A7-%E0%A6%AA%E0%A6%A3%E0%A7%8D%E0%A6%AF-%E0%A6%86%E0%A6%AE%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A7%9C-%E0%A6%9B%E0%A6%BE%E0%A7%9C-%E0%A6%A6%E0%A6%BF%E0%A6%B2-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95">দেশ রূপান্তর</source>

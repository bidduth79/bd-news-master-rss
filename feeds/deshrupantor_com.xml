    <item>
      <title>ভিলার সঙ্গে রোমাঞ্চকর ড্র করেও রেলগেশন অঞ্চলে ম্যানইউ</title>
      <link>https://www.deshrupantor.com/733719/%E0%A6%AD%E0%A6%BF%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%B0%E0%A7%8B%E0%A6%AE%E0%A6%BE%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%95%E0%A6%B0-%E0%A6%A1%E0%A7%8D%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A7%87%E0%A6%93-%E0%A6%B0%E0%A7%87%E0%A6%B2%E0%A6%97%E0%A7%87%E0%A6%B6%E0%A6%A8-%E0%A6%85%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%B2%E0%A7%87</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/733719/%E0%A6%AD%E0%A6%BF%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%B0%E0%A7%8B%E0%A6%AE%E0%A6%BE%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%95%E0%A6%B0-%E0%A6%A1%E0%A7%8D%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A7%87%E0%A6%93-%E0%A6%B0%E0%A7%87%E0%A6%B2%E0%A6%97%E0%A7%87%E0%A6%B6%E0%A6%A8-%E0%A6%85%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%B2%E0%A7%87</guid>
      <pubDate>Mon, 09 Nov 2026 02:33:41 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/4ac22537b6f788472baff3b4eb4fa2f0-6af0dc2ab7922.jpg?jadewits_media_id=241195" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/4ac22537b6f788472baff3b4eb4fa2f0-6af0dc2ab7922.jpg?jadewits_media_id=241195" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/4ac22537b6f788472baff3b4eb4fa2f0-6af0dc2ab7922.jpg?jadewits_media_id=241195" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভিলার সঙ্গে রোমাঞ্চকর ড্র করেও রেলগেশন অঞ্চলে ম্যানইউ" /&gt;&lt;/p&gt;&lt;p&gt;অ্যাস্টন ভিলার বিপক্ষে ঘরের মাঠে এক রোমাঞ্চকর ম্যাচে নাটকীয় কামব্যাক করে ৪-৪ গোলে ড্র করেছে ম্যানচেস্টার ইউনাইটেড। তবে এই ড্রয়ের পরও প্রিমিয়ার লিগের রেলিগেশন জোনেই (১৮তম স্থান) আটকে রইল রেড ডেভিলরা, যা কোচ মাইকেল ক্যারিকের ভবিষ্যৎ নিয়ে নতুন করে শঙ্কার জন্ম দিয়েছে।
ম্যাচের শুরু থেকেই ছিল নাটকীয়তার ছ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/733719/%E0%A6%AD%E0%A6%BF%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%B0%E0%A7%8B%E0%A6%AE%E0%A6%BE%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%95%E0%A6%B0-%E0%A6%A1%E0%A7%8D%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A7%87%E0%A6%93-%E0%A6%B0%E0%A7%87%E0%A6%B2%E0%A6%97%E0%A7%87%E0%A6%B6%E0%A6%A8-%E0%A6%85%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%B2%E0%A7%87">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>ককটেল-আগুনে বাড়ছে আতঙ্ক</title>
      <link>https://www.deshrupantor.com/733718/%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%9B%E0%A7%87-%E0%A6%86%E0%A6%A4%E0%A6%99%E0%A7%8D%E0%A6%95</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/733718/%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%9B%E0%A7%87-%E0%A6%86%E0%A6%A4%E0%A6%99%E0%A7%8D%E0%A6%95</guid>
      <pubDate>Mon, 09 Nov 2026 02:16:34 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/08581ec80447a159b79dc582958594e5-6af0d714eec29.jpg?jadewits_media_id=241187" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/08581ec80447a159b79dc582958594e5-6af0d714eec29.jpg?jadewits_media_id=241187" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/08581ec80447a159b79dc582958594e5-6af0d714eec29.jpg?jadewits_media_id=241187" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ককটেল-আগুনে বাড়ছে আতঙ্ক" /&gt;&lt;/p&gt;&lt;p&gt;সম্প্রতি ঢাকার বিভিন্ন এলাকায় এবং সড়কে ককটেল উদ্ধার ও বিস্ফোরণের ঘটনা বৃদ্ধি পেয়েছে। রাজনৈতিক উত্তাপের জের ধরে রাজধানীসহ সারা দেশে আবারও ছড়ানো হচ্ছে ককটেল আতঙ্ক। মাত্র সাত দিনের ব্যবধানে রাজধানীর ব্যস্ততম চারটি পৃথক পয়েন্টে পরপর আটটি শক্তিশালী ককটেল বিস্ফোরণের ঘটনা ঘটেছে। এ ছাড়া প্রগতি সরণির কোকাকোল&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/733718/%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%9B%E0%A7%87-%E0%A6%86%E0%A6%A4%E0%A6%99%E0%A7%8D%E0%A6%95">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>নজরদারিতে ঢাকা-চট্টগ্রাম মহাসড়কের ১৪ পয়েন্ট</title>

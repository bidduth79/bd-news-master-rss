      <guid isPermaLink="true">https://www.deshrupantor.com/737651/%E0%A6%86%E0%A7%9C%E0%A6%BE%E0%A6%87%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A7%87%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%95%E0%A6%95%E0%A7%87-%E0%A7%A7-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%9C%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%BE</guid>
      <pubDate>Tue, 24 Nov 2026 22:32:10 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/c83727f5185a35306388cc7e6dba01f0-6b05bbfc547bf.jpg?jadewits_media_id=244966" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/c83727f5185a35306388cc7e6dba01f0-6b05bbfc547bf.jpg?jadewits_media_id=244966" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/c83727f5185a35306388cc7e6dba01f0-6b05bbfc547bf.jpg?jadewits_media_id=244966" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আড়াইহাজারে বেকারি মালিককে ১ লাখ টাকা জরিমানা" /&gt;&lt;/p&gt;&lt;p&gt;নারায়ণগঞ্জের আড়াইহাজারে নিরাপদ খাদ্য আইন লঙ্ঘনের দায়ে ফারহান অ্যাগ্রো প্রসেসর নামে একটি বেকারির মালিককে এক লাখ টাকা জরিমানা করেছেন ভ্রাম্যমাণ আদালত।
সহকারী কমিশনার (ভূমি) ও নির্বাহী ম্যাজিস্ট্রেট মোস্তাফিজুর রহমান ইমন মঙ্গলবার (২৪ নভেম্বর) দুপুরে উপজেলার ঝাউগড়া এলাকায় ভ্রাম্যমাণ আদালত পরিচালনা করে এ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737651/%E0%A6%86%E0%A7%9C%E0%A6%BE%E0%A6%87%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A7%87%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%95%E0%A6%95%E0%A7%87-%E0%A7%A7-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%9C%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%BE">দেশ রূপান্তর</source>

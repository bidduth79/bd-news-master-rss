      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/1276e6ec78795c1848e197ea19c9c2fc-6af4c49de28c2.jpg?jadewits_media_id=241925" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/1276e6ec78795c1848e197ea19c9c2fc-6af4c49de28c2.jpg?jadewits_media_id=241925" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/1276e6ec78795c1848e197ea19c9c2fc-6af4c49de28c2.jpg?jadewits_media_id=241925" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নাশকতা ঠেকাতে ঢাকার মোড়ে মোড়ে পাহারা" /&gt;&lt;/p&gt;&lt;p&gt;কার্যক্রম নিষিদ্ধ আওয়ামী লীগ ও দলটির নিষিদ্ধঘোষিত ছাত্র সংগঠন ছাত্রলীগের কর্মসূচি ঘিরে রাজধানী ঢাকাসহ সারা দেশে ব্যাপক নাশকতা শুরু হয়েছে। গত কয়েক দিন ধরেই বাস ও ট্রেনে আগুন, ককটেল বিস্ফোরণের ঘটনায় সাধারণ মানুষের মধ্যে আতঙ্ক নেমে এসেছে। এসব অপকর্ম রুখতে মাঠে নেমেছে বিএনপি ও তার সহযোগী সংগঠনের নেতারা।&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734508/%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%BE-%E0%A6%A0%E0%A7%87%E0%A6%95%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A7%8B%E0%A7%9C%E0%A7%87-%E0%A6%AE%E0%A7%8B%E0%A7%9C%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BE">দেশ রূপান্তর</source>

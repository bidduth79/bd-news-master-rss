      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/dab299da9b1aab9f17da63ea8afaea23-6b09c40755729.jpg?jadewits_media_id=245663" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/dab299da9b1aab9f17da63ea8afaea23-6b09c40755729.jpg?jadewits_media_id=245663" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/dab299da9b1aab9f17da63ea8afaea23-6b09c40755729.jpg?jadewits_media_id=245663" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দীপুর লড়াকু সেঞ্চুরি বিফলে; পাকিস্তানের কাছে হেরে বিদায় ‘এ’ দলের" /&gt;&lt;/p&gt;&lt;p&gt;একের পর এক উইকেট হারিয়ে যখন চরম ব্যাটিং বিপর্যয়ে বাংলাদেশ &amp;lsquo;এ&amp;rsquo; দল, তখন এক প্রান্ত আগলে রেখে লড়াই চালিয়ে যান শাহাদাত হোসেন দিপু। খেলেন দুর্দান্ত এক শতরানের ইনিংস। তবে সতীর্থদের কাছ থেকে যথেষ্ট সমর্থন না পাওয়ায় দিপুর সেই লড়াই শেষ পর্যন্ত কাজে আসেনি। তার সেঞ্চুরির পরও পাকিস্তান শাহীনসের কাছে&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/738388/%E0%A6%A6%E0%A7%80%E0%A6%AA%E0%A7%81%E0%A6%B0-%E0%A6%B2%E0%A7%9C%E0%A6%BE%E0%A6%95%E0%A7%81-%E0%A6%B8%E0%A7%87%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%AC%E0%A6%BF%E0%A6%AB%E0%A6%B2%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%9B%E0%A7%87-%E0%A6%B9%E0%A7%87%E0%A6%B0%E0%A7%87">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>জামালপুরে অটোরিকশার সঙ্গে মোটরসাইকেলের সংঘর্ষে নিহত ১</title>
      <link>https://www.deshrupantor.com/738387/%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%85%E0%A6%9F%E0%A7%8B%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%B6%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%AE%E0%A7%8B%E0%A6%9F%E0%A6%B0%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A7%87</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/738387/%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%85%E0%A6%9F%E0%A7%8B%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%B6%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%AE%E0%A7%8B%E0%A6%9F%E0%A6%B0%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A7%87</guid>
      <pubDate>Fri, 27 Nov 2026 22:56:11 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2025/09/20/ecbcf021bec4c13a439e56a6c538efa8-68ce5d7746b52.jpg?jadewits_media_id=138934" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2025/09/20/ecbcf021bec4c13a439e56a6c538efa8-68ce5d7746b52.jpg?jadewits_media_id=138934" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2025/09/20/ecbcf021bec4c13a439e56a6c538efa8-68ce5d7746b52.jpg?jadewits_media_id=138934" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জামালপুরে অটোরিকশার সঙ্গে মোটরসাইকেলের সংঘর্ষে নিহত ১" /&gt;&lt;/p&gt;&lt;p&gt;জামালপুরের মাদারগঞ্জে অটোরিকশা ও মোটরসাইকেলের মুখোমুখি সংঘর্ষে আব্দুর রাজ্জাক (৫৫) নামে এক মোটরসাইকেল আরোহী নিহত হয়েছেন। শুক্রবার (২৭ নভেম্বর) সন্ধ্যায় উপজেলার আনন্দ নার্সারির দক্ষিণ পাশে এ দুর্ঘটনা ঘটে।
নিহত আব্দুর রাজ্জাক মেলান্দহ উপজেলার চর সগুনা এলাকার মহির মণ্ডলের ছেলে।
স্থানীয় সূত্রে জানা গেছে&lt;/p&gt;</description>

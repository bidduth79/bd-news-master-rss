    <item>
      <title>ন্যূনতম মজুরি ১৮ থেকে ২৪ হাজার করার প্রস্তাব</title>
      <link>https://www.deshrupantor.com/736301/%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A7%82%E0%A6%A8%E0%A6%A4%E0%A6%AE-%E0%A6%AE%E0%A6%9C%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A7%A7%E0%A7%AE-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A7%A8%E0%A7%AA-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%AC</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736301/%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A7%82%E0%A6%A8%E0%A6%A4%E0%A6%AE-%E0%A6%AE%E0%A6%9C%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A7%A7%E0%A7%AE-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A7%A8%E0%A7%AA-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%AC</guid>
      <pubDate>Thu, 19 Nov 2026 07:45:54 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/c1e4cc5fa2b02c8a93d5a0e64e7a96be-6afe54cb97b54.jpg?jadewits_media_id=243660" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/c1e4cc5fa2b02c8a93d5a0e64e7a96be-6afe54cb97b54.jpg?jadewits_media_id=243660" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/c1e4cc5fa2b02c8a93d5a0e64e7a96be-6afe54cb97b54.jpg?jadewits_media_id=243660" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ন্যূনতম মজুরি ১৮ থেকে ২৪ হাজার করার প্রস্তাব" /&gt;&lt;/p&gt;&lt;p&gt;পোশাকশ্রমিকদের ন্যায্য মজুরি নির্ধারণে মাসে ১৮ হাজার ৫৭৮ থেকে ২৪ হাজার ২০৪ টাকার মধ্যে আলোচনার প্রস্তাব দিয়েছে বেসরকারি গবেষণা সংস্থা সেন্টার ফর পলিসি ডায়ালগ (সিপিডি)। সংস্থাটির হিসাবে, মূল্যস্ফীতির সঙ্গে সমন্বয় করে ২০২৩ সালে ১২ হাজার ৫০০ টাকা ন্যূনতম মজুরির বর্তমান সমমূল্য দাঁড়ায় ১৬ হাজার ৩৫১ টাকা।&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736301/%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A7%82%E0%A6%A8%E0%A6%A4%E0%A6%AE-%E0%A6%AE%E0%A6%9C%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A7%A7%E0%A7%AE-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A7%A8%E0%A7%AA-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%AC">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>ববিতে আ.লীগ সংশ্লিষ্টতায় ৫ কর্মকর্তাকে মারধর প্রক্টর অফিসে সোপর্দ</title>

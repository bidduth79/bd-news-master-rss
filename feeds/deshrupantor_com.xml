    <item>
      <title>বিয়ের দাবিতে তরুণের বাড়িতে আরেক তরুণের অবস্থান</title>
      <link>https://www.deshrupantor.com/735937/%E0%A6%AC%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%A4%E0%A6%B0%E0%A7%81%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%A4%E0%A6%B0%E0%A7%81%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735937/%E0%A6%AC%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%A4%E0%A6%B0%E0%A7%81%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%A4%E0%A6%B0%E0%A7%81%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8</guid>
      <pubDate>Tue, 17 Nov 2026 18:46:50 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/a7267008cd82b7eea734752411605ebb-6afc4c7491084.jpg?jadewits_media_id=243327" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/a7267008cd82b7eea734752411605ebb-6afc4c7491084.jpg?jadewits_media_id=243327" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/a7267008cd82b7eea734752411605ebb-6afc4c7491084.jpg?jadewits_media_id=243327" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিয়ের দাবিতে তরুণের বাড়িতে আরেক তরুণের অবস্থান" /&gt;&lt;/p&gt;&lt;p&gt;মাদারীপুরের কালকিনিতে প্রেমের সম্পর্কের সূত্র ধরে বিয়ের দাবিতে নবদ্বীপ চন্দ্র দাশ (১৯) নামে এক তরুণের বাড়িতে অবস্থান নিয়েছেন মাহিন মুন্সি নামে আরেক তরুণ। মঙ্গলবার (১৭ নভেম্বর) একসঙ্গে সংসার করার দাবিতে তিনি ওই বাড়িতে অবস্থান নেন। এ ঘটনাকে কেন্দ্র করে এলাকায় কৌতূহল ও চাঞ্চল্যের সৃষ্টি হয়েছে।
স্থানীয় &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735937/%E0%A6%AC%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%A4%E0%A6%B0%E0%A7%81%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%A4%E0%A6%B0%E0%A7%81%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>সাত দিনের রিমান্ডে সাঈদ খোকন</title>

      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/5a756d791bc59c976b1344bc24d79480-6afa05b88af71.jpg?jadewits_media_id=242898" length="0" type="image/jpeg" />

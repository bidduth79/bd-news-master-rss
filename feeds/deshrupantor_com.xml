    <item>
      <title>পেস্ট বানিয়ে ১১ কোটি টাকা সোনা পাচার, আটক ৩</title>
      <link>https://www.deshrupantor.com/736898/%E0%A6%AA%E0%A7%87%E0%A6%B8%E0%A7%8D%E0%A6%9F-%E0%A6%AC%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A7%A7%E0%A7%A7-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%B8%E0%A7%8B%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A6%BE%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A7%A9%C2%A0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736898/%E0%A6%AA%E0%A7%87%E0%A6%B8%E0%A7%8D%E0%A6%9F-%E0%A6%AC%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A7%A7%E0%A7%A7-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%B8%E0%A7%8B%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A6%BE%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A7%A9%C2%A0</guid>
      <pubDate>Sat, 21 Nov 2026 22:40:22 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/08/28/be49f2d850974b1481ccf1ac397d7d88-6a91749246731.jpg?jadewits_media_id=224382" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/08/28/be49f2d850974b1481ccf1ac397d7d88-6a91749246731.jpg?jadewits_media_id=224382" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/08/28/be49f2d850974b1481ccf1ac397d7d88-6a91749246731.jpg?jadewits_media_id=224382" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পেস্ট বানিয়ে ১১ কোটি টাকা সোনা পাচার, আটক ৩" /&gt;&lt;/p&gt;&lt;p&gt;হজরত শাহজালাল আন্তর্জাতিক বিমানবন্দরে প্রায় ৭ কেজি ৫০০ গ্রাম (৬৪৩ ভরি) ওজনের ১৫টি ডিম্বাকৃতির সোনার পেস্টসহ তিনজনকে আটক করেছে এয়ারপোর্ট আর্মড পুলিশ ব্যাটালিয়ন (এপিবিএন)। উদ্ধার করা ২৪ ক্যারেট মানের এই সোনার আনুমানিক বাজারমূল্য ১১ কোটি ৬৭ লাখ টাকা।&amp;nbsp;
শনিবার (২১ নভেম্বর) সকাল সাড়ে ১০টার দিকে বিমান&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736898/%E0%A6%AA%E0%A7%87%E0%A6%B8%E0%A7%8D%E0%A6%9F-%E0%A6%AC%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A7%A7%E0%A7%A7-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%B8%E0%A7%8B%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A6%BE%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A7%A9%C2%A0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>ফরাসি অপেরার সুরে মুগ্ধ ঢাকার দর্শক</title>
      <link>https://www.deshrupantor.com/736897/%E0%A6%AB%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A6%BF-%E0%A6%85%E0%A6%AA%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A7%81%E0%A6%97%E0%A7%8D%E0%A6%A7-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%B0%E0%A7%8D%E0%A6%B6%E0%A6%95</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736897/%E0%A6%AB%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A6%BF-%E0%A6%85%E0%A6%AA%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A7%81%E0%A6%97%E0%A7%8D%E0%A6%A7-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%B0%E0%A7%8D%E0%A6%B6%E0%A6%95</guid>
      <pubDate>Sat, 21 Nov 2026 22:35:11 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/2ebcbaa76a91aa4c4f6cdfe493cee056-6b01c7ad89fe8.gif?jadewits_media_id=244238" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/2ebcbaa76a91aa4c4f6cdfe493cee056-6b01c7ad89fe8.gif?jadewits_media_id=244238" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/2ebcbaa76a91aa4c4f6cdfe493cee056-6b01c7ad89fe8.gif?jadewits_media_id=244238" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফরাসি অপেরার সুরে মুগ্ধ ঢাকার দর্শক" /&gt;&lt;/p&gt;&lt;p&gt;ফরাসি অপেরার সুর ও বাংলা সংগীতের আবেগ এক মঞ্চে মিলেমিশে তৈরি করল ভিন্নধর্মী এক সংগীতের আবহ। ফরাসি অপেরাশিল্পী ভেরোনিক পেইন ও পিয়ানিস্ট ফ্যাব্রিস মেইত্রের পরিবেশনায় ঢাকায় অনুষ্ঠিত হলো বিশেষ সংগীতানুষ্ঠান &amp;lsquo;ফ্রেঞ্চ অপেরা শো ব্লেন্ডেড উইথ বাংলা অপেরা&amp;rsquo;।
হোটেল ইন্টারকন্টিনেন্টাল ঢাকার গ্র্যান্&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736897/%E0%A6%AB%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A6%BF-%E0%A6%85%E0%A6%AA%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A7%81%E0%A6%97%E0%A7%8D%E0%A6%A7-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%B0%E0%A7%8D%E0%A6%B6%E0%A6%95">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>গুলশানে তারানা হালিমের বাসায় পুলিশের অভিযান</title>
      <link>https://www.deshrupantor.com/736896/%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%B6%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%B9%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736896/%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%B6%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%B9%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8</guid>
      <pubDate>Sat, 21 Nov 2026 22:29:06 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/85dc653080868e78b21bd025e049bfd8-6b01c6bbbd2f2.jpg?jadewits_media_id=244237" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/85dc653080868e78b21bd025e049bfd8-6b01c6bbbd2f2.jpg?jadewits_media_id=244237" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/85dc653080868e78b21bd025e049bfd8-6b01c6bbbd2f2.jpg?jadewits_media_id=244237" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গুলশানে তারানা হালিমের বাসায় পুলিশের অভিযান" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর গুলশানে সাবেক সংসদ সদস্য ও সাবেক তথ্য প্রতিমন্ত্রী তারানা হালিমের বাসায় পুলিশ সদস্যদের অবস্থান ঘিরে চাঞ্চল্য তৈরি হয়েছে। তবে পুলিশ সেখানে গেলেও তারানা হালিমকে বাসায় পাওয়া যায়নি।&amp;nbsp;
শনিবার (২১ নভেম্বর) বেলা ৩টার পর পুলিশ সদস্যরা রাজধানীর গুলশান-২ এলাকার ওই ভবনে গিয়েছিলেন, সন্ধ্যা ৭টা ৪০ ম&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736896/%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%B6%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%B9%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>পুলিশে নতুন ১৪ হাজার পদে নিয়োগের অনুমোদন</title>
      <link>https://www.deshrupantor.com/736895/%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A7%A7%E0%A7%AA-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%A6%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%8B%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AE%E0%A7%8B%E0%A6%A6%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736895/%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A7%A7%E0%A7%AA-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%A6%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%8B%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AE%E0%A7%8B%E0%A6%A6%E0%A6%A8</guid>
      <pubDate>Sat, 21 Nov 2026 22:27:48 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/e02c4afeb0a728b20b2136c7461088b7-6b01c67d19f2a.gif?jadewits_media_id=244236" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/e02c4afeb0a728b20b2136c7461088b7-6b01c67d19f2a.gif?jadewits_media_id=244236" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/e02c4afeb0a728b20b2136c7461088b7-6b01c67d19f2a.gif?jadewits_media_id=244236" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পুলিশে নতুন ১৪ হাজার পদে নিয়োগের অনুমোদন" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ পুলিশের জনবল ও প্রাতিষ্ঠানিক সক্ষমতা বাড়াতে ১৪ হাজার নতুন পদ সৃজনের অনুমোদন দিয়েছে স্বরাষ্ট্র মন্ত্রণালয়। এরমধ্যে ১০ হাজার কনস্টেবল এবং ৪ হাজার উপপরিদর্শক (এসআই-নিরস্ত্র) পদ রয়েছে।
নতুন এসব পদ সৃজনে জনপ্রশাসন মন্ত্রণালয়, অর্থ বিভাগ ও মন্ত্রিপরিষদ বিভাগের প্রয়োজনীয় সম্মতি এবং যথাযথ কর্তৃপক্ষ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736895/%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A7%A7%E0%A7%AA-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%A6%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%8B%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AE%E0%A7%8B%E0%A6%A6%E0%A6%A8">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>বিআরএসএর অর্জন ও অগ্রযাত্রায় মাইকেল মহিউদ্দিনের অবদান, ঐক্যবদ্ধভাবে কাজ করার আহ্বান</title>

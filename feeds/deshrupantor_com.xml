    <item>
      <title>হাম-ডেঙ্গু-নিউমোনিয়া: এক ভাই কবরে, আরেক ভাই লাইফ সাপোর্টে</title>
      <link>https://www.deshrupantor.com/733631/%E0%A6%B9%E0%A6%BE%E0%A6%AE-%E0%A6%A1%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%81-%E0%A6%A8%E0%A6%BF%E0%A6%89%E0%A6%AE%E0%A7%8B%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%BE-%E0%A6%8F%E0%A6%95-%E0%A6%AD%E0%A6%BE%E0%A6%87-%E0%A6%95%E0%A6%AC%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%AD%E0%A6%BE%E0%A6%87-%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%AB</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/733631/%E0%A6%B9%E0%A6%BE%E0%A6%AE-%E0%A6%A1%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%81-%E0%A6%A8%E0%A6%BF%E0%A6%89%E0%A6%AE%E0%A7%8B%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%BE-%E0%A6%8F%E0%A6%95-%E0%A6%AD%E0%A6%BE%E0%A6%87-%E0%A6%95%E0%A6%AC%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%AD%E0%A6%BE%E0%A6%87-%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%AB</guid>
      <pubDate>Sun, 08 Nov 2026 20:00:41 +0600</pubDate>
      <description>চমেক হাসপাতালের মেডিসিন বিভাগের সহযোগী অধ্যাপক নূর মোহাম্মদ জানান, রোগীর চাপ এখনো কমেনি। অনেক রোগী শেষ মুহূর্তে হাসপাতালে আসায় তাদের বাঁচানো কঠিন হয়ে পড়ছে।						বিস্তারিত</description>

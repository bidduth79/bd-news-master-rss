    <item>
      <title>সাভারে স্কুলের সামনে ব্যাগে মিলল ৩ হাতবোমা</title>
      <link>https://www.deshrupantor.com/734048/%E0%A6%B8%E0%A6%BE%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%97%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2-%E0%A7%A9-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734048/%E0%A6%B8%E0%A6%BE%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%97%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2-%E0%A7%A9-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE</guid>
      <pubDate>Tue, 10 Nov 2026 13:00:39 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/079a71e561a9f05411653bc50daea963-6af2c1010ba0c.jpg?jadewits_media_id=241494" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/079a71e561a9f05411653bc50daea963-6af2c1010ba0c.jpg?jadewits_media_id=241494" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/079a71e561a9f05411653bc50daea963-6af2c1010ba0c.jpg?jadewits_media_id=241494" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাভারে স্কুলের সামনে ব্যাগে মিলল ৩ হাতবোমা" /&gt;&lt;/p&gt;&lt;p&gt;সাভারে একটি স্কুলের ফটকের পাশে পড়ে থাকা ব্যাগে অন্তত তিনটি হাতবোমার সন্ধান পেয়েছে পুলিশ। এ ঘটনায় এলাকায় নিরাপত্তা জোরদার করে ব্যাগটি ঘিরে রেখেছে পুলিশ। বোমাগুলো নিষ্ক্রিয় করতে বোমা নিষ্ক্রিয়করণ ইউনিটকে খবর দেওয়া হয়েছে।
সোমবার (৯ নভেম্বর) মধ্যরাতে সাভার অধর চন্দ্র সরকারি উচ্চ বিদ্যালয়ের ফটকের পাশে ব্&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734048/%E0%A6%B8%E0%A6%BE%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%97%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2-%E0%A7%A9-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE">দেশ রূপান্তর</source>

    <item>
      <title>তাইবুরের ডাবল সেঞ্চুরি, তাকরিরের চমক</title>
      <link>https://www.deshrupantor.com/733622/%E0%A6%A4%E0%A6%BE%E0%A6%87%E0%A6%AC%E0%A7%81%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%A1%E0%A6%BE%E0%A6%AC%E0%A6%B2-%E0%A6%B8%E0%A7%87%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A6%B0%E0%A6%BF%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%AE%E0%A6%95</link>

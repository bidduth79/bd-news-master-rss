      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/97cc643fad3b6297ec53b8690a8f44e0-6b02ab75b8662.jpg?jadewits_media_id=244361" length="0" type="image/jpeg" />

    <item>
      <title>রাজধানীতে অজ্ঞান পার্টির খপ্পরে ২ ব্যবসায়ী</title>
      <link>https://www.deshrupantor.com/737254/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%85%E0%A6%9C%E0%A7%8D%E0%A6%9E%E0%A6%BE%E0%A6%A8-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%B0-%E0%A6%96%E0%A6%AA%E0%A7%8D%E0%A6%AA%E0%A6%B0%E0%A7%87-%E0%A7%A8-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A7%80</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737254/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%85%E0%A6%9C%E0%A7%8D%E0%A6%9E%E0%A6%BE%E0%A6%A8-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%B0-%E0%A6%96%E0%A6%AA%E0%A7%8D%E0%A6%AA%E0%A6%B0%E0%A7%87-%E0%A7%A8-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A7%80</guid>
      <pubDate>Mon, 23 Nov 2026 14:33:49 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/07/02/531846359534e4f2cc86d0c832dc6992-6a45eb0f180ac.jpg?jadewits_media_id=209158" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/07/02/531846359534e4f2cc86d0c832dc6992-6a45eb0f180ac.jpg?jadewits_media_id=209158" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/07/02/531846359534e4f2cc86d0c832dc6992-6a45eb0f180ac.jpg?jadewits_media_id=209158" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজধানীতে অজ্ঞান পার্টির খপ্পরে ২ ব্যবসায়ী" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীতে বাসের ভেতর দুই ব্যবসায়ী অজ্ঞানপার্টির খপ্পরে পড়েছেন। তাদের কাছ থেকে কয়েক লাখ টাকা খোয়া গেছে বলে অভিযোগ স্বজনদের।&amp;nbsp;
সোমবার (২৩ নভেম্বর) সকালে এই ঘটনা ঘটে। অচেতন অবস্থায় তাদেরকে উদ্ধার করে দুপুরে ঢাকা মেডিকেল কলেজ হাসপাতালে ভর্তি করা হয়েছে।
আক্রান্তরা হলেন পোস্তগোলার কাউ ম্যাট ব্যবসায়ী স&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737254/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%85%E0%A6%9C%E0%A7%8D%E0%A6%9E%E0%A6%BE%E0%A6%A8-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%B0-%E0%A6%96%E0%A6%AA%E0%A7%8D%E0%A6%AA%E0%A6%B0%E0%A7%87-%E0%A7%A8-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A7%80">দেশ রূপান্তর</source>
    </item>

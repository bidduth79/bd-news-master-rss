    <item>
      <title>টিভিতে আজ যা যা দেখা যাবে</title>
      <link>https://www.deshrupantor.com/737049/%E0%A6%9F%E0%A6%BF%E0%A6%AD%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%9C-%E0%A6%AF%E0%A6%BE-%E0%A6%AF%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BE-%E0%A6%AF%E0%A6%BE%E0%A6%AC%E0%A7%87</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737049/%E0%A6%9F%E0%A6%BF%E0%A6%AD%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%9C-%E0%A6%AF%E0%A6%BE-%E0%A6%AF%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BE-%E0%A6%AF%E0%A6%BE%E0%A6%AC%E0%A7%87</guid>
      <pubDate>Mon, 23 Nov 2026 05:00:00 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/10/26/c379a904bd808debfd6b47b9b7ce4721-6adf34b9328f5.jpg?jadewits_media_id=237879" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/10/26/c379a904bd808debfd6b47b9b7ce4721-6adf34b9328f5.jpg?jadewits_media_id=237879" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/10/26/c379a904bd808debfd6b47b9b7ce4721-6adf34b9328f5.jpg?jadewits_media_id=237879" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টিভিতে আজ যা যা দেখা যাবে" /&gt;&lt;/p&gt;&lt;p&gt;ওয়েলিংটন টেস্ট শেষ হচ্ছে আজ। ওদিকে সেঞ্চুরিয়ানে শুরু হচ্ছে বাংলাদেশ-দক্ষিণ আফ্রিকা দ্বিতীয় টেস্ট। এছাড়া বাংলাদেশ-শ্রীলঙ্কা এশিয়া কাপ রাইজিং স্টার্সের গ্রুপ পর্বের শেষ ম্যাচ আজ।&amp;nbsp;
ক্রিকেট&amp;nbsp;
নিউজিল্যান্ড-ভারত প্রথম টেস্টের শেষ দিনভোর ৪:০০, সনি ৩, ৪, ৫ ও সনি লিভ
বাংলাদেশ-দক্ষিণ আফ্রিকা দ্বিতীয় &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737049/%E0%A6%9F%E0%A6%BF%E0%A6%AD%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%9C-%E0%A6%AF%E0%A6%BE-%E0%A6%AF%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BE-%E0%A6%AF%E0%A6%BE%E0%A6%AC%E0%A7%87">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>শ্রীপুরে ফের কারখানায় হামলা ১০টিতে ছুটি, থমথমে পরিস্থিতি</title>
      <link>https://www.deshrupantor.com/737197/%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A7%A7%E0%A7%A6%E0%A6%9F%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%9B%E0%A7%81%E0%A6%9F%E0%A6%BF-%E0%A6%A5%E0%A6%AE%E0%A6%A5%E0%A6%AE%E0%A7%87</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737197/%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A7%A7%E0%A7%A6%E0%A6%9F%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%9B%E0%A7%81%E0%A6%9F%E0%A6%BF-%E0%A6%A5%E0%A6%AE%E0%A6%A5%E0%A6%AE%E0%A7%87</guid>
      <pubDate>Mon, 23 Nov 2026 02:18:50 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/b4beeed2239366f940c07cd3e7943a1f-6b0349c835f91.jpg?jadewits_media_id=244511" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/b4beeed2239366f940c07cd3e7943a1f-6b0349c835f91.jpg?jadewits_media_id=244511" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/b4beeed2239366f940c07cd3e7943a1f-6b0349c835f91.jpg?jadewits_media_id=244511" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শ্রীপুরে ফের কারখানায় হামলা ১০টিতে ছুটি, থমথমে পরিস্থিতি" /&gt;&lt;/p&gt;&lt;p&gt;গাজীপুরের শ্রীপুরে দুই দিন বিরতি দিয়ে আবারও অশান্ত হয়ে উঠেছে শিল্পাঞ্চল। গতকাল রবিবার একদল বহিরাগত শ্রমিক পরিবেশ অশান্ত করতে বিভিন্ন কারখানায় হামলা ও ভাঙচুর চালিয়েছে। এতে কারখানা এলাকাগুলোতে থমথমে পরিস্থিতি বিরাজ করছে। পুলিশ সতর্ক অবস্থায় রয়েছে।
অন্যদিকে সাভার-আশুলিয়া শিল্পাঞ্চলে অনেকটাই স্বস্তি ফির&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737197/%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A7%A7%E0%A7%A6%E0%A6%9F%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%9B%E0%A7%81%E0%A6%9F%E0%A6%BF-%E0%A6%A5%E0%A6%AE%E0%A6%A5%E0%A6%AE%E0%A7%87">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>পরিযায়ী পাখির চেনা আশ্রয় হারাচ্ছে জাহাঙ্গীরনগর</title>
      <link>https://www.deshrupantor.com/737196/%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A7%9F%E0%A7%80-%E0%A6%AA%E0%A6%BE%E0%A6%96%E0%A6%BF%E0%A6%B0-%E0%A6%9A%E0%A7%87%E0%A6%A8%E0%A6%BE-%E0%A6%86%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%9F-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%80%E0%A6%B0%E0%A6%A8%E0%A6%97%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737196/%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A7%9F%E0%A7%80-%E0%A6%AA%E0%A6%BE%E0%A6%96%E0%A6%BF%E0%A6%B0-%E0%A6%9A%E0%A7%87%E0%A6%A8%E0%A6%BE-%E0%A6%86%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%9F-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%80%E0%A6%B0%E0%A6%A8%E0%A6%97%E0%A6%B0</guid>
      <pubDate>Mon, 23 Nov 2026 02:18:12 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/1c32f73ac73fc51a93e7f5608c2bc4aa-6b0349c892c65.jpg?jadewits_media_id=244513" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/1c32f73ac73fc51a93e7f5608c2bc4aa-6b0349c892c65.jpg?jadewits_media_id=244513" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/1c32f73ac73fc51a93e7f5608c2bc4aa-6b0349c892c65.jpg?jadewits_media_id=244513" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পরিযায়ী পাখির চেনা আশ্রয় হারাচ্ছে জাহাঙ্গীরনগর" /&gt;&lt;/p&gt;&lt;p&gt;একসময় শীত এলেই জাহাঙ্গীরনগর বিশ্ববিদ্যালয়ের (জাবি) জলাশয়গুলোতে ঝাঁকে ঝাঁকে পরিযায়ী পাখির দেখা মিলত। পানিতে ভেসে থাকা পাখির দল, ডানা ঝাপটানোর শব্দ আর তাদের কলকাকলিতে মুখর থাকত ক্যাম্পাসের জলাশয়গুলো। তবে কয়েক বছর ধরে বদলে যাচ্ছে সেই চেনা দৃশ্য। পরিবেশবিজ্ঞান বিভাগের শিক্ষার্থী ও তরুণ গবেষক অরিত্র সাত্&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737196/%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A7%9F%E0%A7%80-%E0%A6%AA%E0%A6%BE%E0%A6%96%E0%A6%BF%E0%A6%B0-%E0%A6%9A%E0%A7%87%E0%A6%A8%E0%A6%BE-%E0%A6%86%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%9F-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%80%E0%A6%B0%E0%A6%A8%E0%A6%97%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>কক্সবাজারের খাবারে আস্থা তলানিতে</title>
      <link>https://www.deshrupantor.com/737195/%E0%A6%95%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%96%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE-%E0%A6%A4%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%A4%E0%A7%87</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737195/%E0%A6%95%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%96%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE-%E0%A6%A4%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%A4%E0%A7%87</guid>
      <pubDate>Mon, 23 Nov 2026 02:17:31 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/d8e902a7a9d3071b8e2c642802e9ad71-6b0349c7c81e7.jpg?jadewits_media_id=244509" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/d8e902a7a9d3071b8e2c642802e9ad71-6b0349c7c81e7.jpg?jadewits_media_id=244509" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/d8e902a7a9d3071b8e2c642802e9ad71-6b0349c7c81e7.jpg?jadewits_media_id=244509" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কক্সবাজারের খাবারে আস্থা তলানিতে" /&gt;&lt;/p&gt;&lt;p&gt;পর্যটন নগরী কক্সবাজারে বেড়াতে এসে মানুষ নিরাপদ ও মানসম্মত খাবার খোঁজেন। রাস্তার ধারের খোলা খাবার এড়িয়ে তারা ছুটে যান শহরের নামিদামি রেস্তোরাঁয়। কেউ যান পরিচিত বেকারি কিংবা ঝকঝকে সুপার শপে। চড়া দাম আর শীতাতপ নিয়ন্ত্রিত পরিবেশের আড়ালে তারা একটুখানি সুস্থতার নিশ্চয়তা আশা করেন। কিন্তু বাস্তবতা বলছে ভিন&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737195/%E0%A6%95%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%96%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE-%E0%A6%A4%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%A4%E0%A7%87">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>মৌলিক ইস্যুগুলোতে বিএনপি সম্মত হলেই কেবল জাতীয় ঐক্য</title>
      <link>https://www.deshrupantor.com/737194/%E0%A6%AE%E0%A7%8C%E0%A6%B2%E0%A6%BF%E0%A6%95-%E0%A6%87%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A7%8B%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%A4-%E0%A6%B9%E0%A6%B2%E0%A7%87%E0%A6%87-%E0%A6%95%E0%A7%87%E0%A6%AC%E0%A6%B2-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F</link>

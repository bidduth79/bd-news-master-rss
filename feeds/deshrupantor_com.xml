    <item>
      <title>কার্যকর সংসদ গড়তে সবাইকে একসাথে কাজ করার আহ্বান ডেপুটি স্পিকারের</title>
      <link>https://www.deshrupantor.com/738169/%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A6%B0-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6-%E0%A6%97%E0%A7%9C%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A6%B8%E0%A6%BE%E0%A6%A5%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%9C-%E0%A6%95%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%B9%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/738169/%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A6%B0-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6-%E0%A6%97%E0%A7%9C%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A6%B8%E0%A6%BE%E0%A6%A5%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%9C-%E0%A6%95%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%B9%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%A8</guid>
      <pubDate>Thu, 26 Nov 2026 20:36:28 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/50c3fb01d7e096da5d2aa9d2399e6b82-6b0843e0e6482.jpg?jadewits_media_id=245434" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/50c3fb01d7e096da5d2aa9d2399e6b82-6b0843e0e6482.jpg?jadewits_media_id=245434" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/50c3fb01d7e096da5d2aa9d2399e6b82-6b0843e0e6482.jpg?jadewits_media_id=245434" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কার্যকর সংসদ গড়তে সবাইকে একসাথে কাজ করার আহ্বান ডেপুটি স্পিকারের" /&gt;&lt;/p&gt;&lt;p&gt;জাতীয় সংসদের ডেপুটি স্পিকার ব্যারিস্টার কায়সার কামাল বলেছেন, জাতীয় সংসদকে অধিকতর দক্ষ এবং কার্যকরভাবে গড়ে তুলতে হলে সবাইকে একসাথে কাজ করতে হবে।&amp;nbsp;তিনি বলেন, যারা সত্যিকার অর্থেই যোগ্য, দক্ষ এবং পেশাদারিত্বের সাথে কাজ করতে পারবে, দুঃখজনকভাবে তারা রাজনীতিতে আসতে চান না।&amp;nbsp;তিনি আরও বলেন, দেশের যো&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/738169/%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A6%B0-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6-%E0%A6%97%E0%A7%9C%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A6%B8%E0%A6%BE%E0%A6%A5%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%9C-%E0%A6%95%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%B9%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%A8">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>চেক প্রতারণায় সিরাজ মোল্লার কারাদণ্ড</title>
      <link>https://www.deshrupantor.com/738168/%E0%A6%9A%E0%A7%87%E0%A6%95-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%A3%E0%A6%BE%E0%A7%9F-%E0%A6%B8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%9C-%E0%A6%AE%E0%A7%8B%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%A6%E0%A6%A3%E0%A7%8D%E0%A6%A1</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/738168/%E0%A6%9A%E0%A7%87%E0%A6%95-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%A3%E0%A6%BE%E0%A7%9F-%E0%A6%B8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%9C-%E0%A6%AE%E0%A7%8B%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%A6%E0%A6%A3%E0%A7%8D%E0%A6%A1</guid>
      <pubDate>Thu, 26 Nov 2026 20:32:24 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/c19ecdb9546c3ac58ead56cdf59775d0-6b0842f5a6497.jpg?jadewits_media_id=245433" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/c19ecdb9546c3ac58ead56cdf59775d0-6b0842f5a6497.jpg?jadewits_media_id=245433" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/c19ecdb9546c3ac58ead56cdf59775d0-6b0842f5a6497.jpg?jadewits_media_id=245433" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চেক প্রতারণায় সিরাজ মোল্লার কারাদণ্ড" /&gt;&lt;/p&gt;&lt;p&gt;ভোলার লালমোহনে ৩০ লাখ টাকার চেক প্রতারণার মামলায় মোল্লা আইসক্রিমের মালিক মো. সিরাজ মোল্লাকে এক বছরের কারাদণ্ড ও ৩০ লাখ টাকা অর্থদণ্ড দিয়েছেন আদালত।
বুধবার (২৫ নভেম্বর) লালমোহন সিনিয়র জুডিসিয়াল ম্যাজিস্ট্রেট আদালত এ রায় দেন। দণ্ডিত সিরাজ মোল্লা (৫১) লালমোহন পৌরসভার ৩ নম্বর ওয়ার্ডের বাসিন্দা।
মামলার ব&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/738168/%E0%A6%9A%E0%A7%87%E0%A6%95-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%A3%E0%A6%BE%E0%A7%9F-%E0%A6%B8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%9C-%E0%A6%AE%E0%A7%8B%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%A6%E0%A6%A3%E0%A7%8D%E0%A6%A1">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>পঞ্চগড়ে জামায়াতের বিক্ষোভ</title>
      <link>https://www.deshrupantor.com/738167/%E0%A6%AA%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%97%E0%A7%9C%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8B%E0%A6%AD%C2%A0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/738167/%E0%A6%AA%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%97%E0%A7%9C%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8B%E0%A6%AD%C2%A0</guid>
      <pubDate>Thu, 26 Nov 2026 20:31:52 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/73a87ce1dcc94ec178a1d6fb07f31127-6b0842c5a4d86.jpg?jadewits_media_id=245432" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/73a87ce1dcc94ec178a1d6fb07f31127-6b0842c5a4d86.jpg?jadewits_media_id=245432" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/73a87ce1dcc94ec178a1d6fb07f31127-6b0842c5a4d86.jpg?jadewits_media_id=245432" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পঞ্চগড়ে জামায়াতের বিক্ষোভ" /&gt;&lt;/p&gt;&lt;p&gt;কার্যক্রম নিষিদ্ধ আওয়ামী লীগের জ্বালাও পোড়াও লুটপাট ও সন্ত্রাস ও আইন শৃঙ্খলা রক্ষায় সরকারের ব্যর্থতার প্রতিবাদে পঞ্চগড়ে বিক্ষোভ মিছিল করেছে জামায়াতে ইসলামী। &amp;nbsp;
বৃহস্পতিবার বিকেলে জেলা শহরের আদালতের সামনে থেকে এই প্রতিবাদ মিছিল বের করে তারা। মিছিলে জামায়াত শিবিরের নেতাকর্মীরা অংশ নেন। &amp;nbsp;এসময় &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/738167/%E0%A6%AA%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%97%E0%A7%9C%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8B%E0%A6%AD%C2%A0">দেশ রূপান্তর</source>
    </item>

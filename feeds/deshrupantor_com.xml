      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/01/75e2b4db3e831106d87c407f71b39715-6ae6c54c15aaf.jpg?jadewits_media_id=239339" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/01/75e2b4db3e831106d87c407f71b39715-6ae6c54c15aaf.jpg?jadewits_media_id=239339" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গোপালগঞ্জে যৌথ বাহিনীর অভিযান, ভিডিও দেখে ব্যবস্থা" /&gt;&lt;/p&gt;&lt;p&gt;‘এই ঘটনা সরকার টলারেট করার কোনো কারণ নেই। যারা এসব নাশকতা ও সহিংসতায় জড়িত, তাদের অবশ্যই বিচারের মুখোমুখি করা হবে।’						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735932/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AF%E0%A7%8C%E0%A6%A5-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A6%AD%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A6%93-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A7%87-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE">দেশ রূপান্তর</source>

    <item>
      <title>'রাজকন্যা, এই সেঞ্চুরিটা তোমার জন্য'</title>
      <link>https://www.deshrupantor.com/735593/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%95%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%8F%E0%A6%87-%E0%A6%B8%E0%A7%87%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%9F%E0%A6%BE-%E0%A6%A4%E0%A7%8B%E0%A6%AE%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735593/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%95%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%8F%E0%A6%87-%E0%A6%B8%E0%A7%87%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%9F%E0%A6%BE-%E0%A6%A4%E0%A7%8B%E0%A6%AE%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF</guid>
      <pubDate>Mon, 16 Nov 2026 15:08:14 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/0f3d69a1e6307576743d594e24e57b61-6afabe41ed73f.jpg?jadewits_media_id=242981" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/0f3d69a1e6307576743d594e24e57b61-6afabe41ed73f.jpg?jadewits_media_id=242981" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/0f3d69a1e6307576743d594e24e57b61-6afabe41ed73f.jpg?jadewits_media_id=242981" style="max-width:100%;height:auto;margin-bottom:10px;" alt="'রাজকন্যা, এই সেঞ্চুরিটা তোমার জন্য'" /&gt;&lt;/p&gt;&lt;p&gt;জোহানসবার্গ টেস্টের দ্বিতীয় দিনটা শুরু করেছিলেন লিটন দাস সেঞ্চুরি থেকে ৮ রান দূরে দাঁড়িয়ে। অপেক্ষাটা খুব একটা দীর্ঘ হয়নি তার।  চতুর্থ ওভারেই সেঞ্চুরি পেয়েছেন। মার্কো ইয়ানসেনের বলে পুল করে ছক্কা মেরে সেঞ্চুরি পূর্ণ হয়। টেস্টে নিজের অষ্টম সেঞ্চুরি করে ভিন্নধর্মী একটা উদ্‌যাপনও করেছেন।
 
ব্যাট ও হেলমেট&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735593/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%95%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%8F%E0%A6%87-%E0%A6%B8%E0%A7%87%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%9F%E0%A6%BE-%E0%A6%A4%E0%A7%8B%E0%A6%AE%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>হত্যাচেষ্টার আরেক মামলায় গ্রেপ্তার সাবেক এমপি মমতাজ</title>

    <item>
      <title>‘আজ বাড়িতে গুলি করলাম, কাল শরীরে করব’ চাঁদা না পেয়ে সন্ত্রাসীর হুমকি</title>
      <link>https://www.deshrupantor.com/735584/%E2%80%98%E0%A6%86%E0%A6%9C-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A6%BE%E0%A6%AE-%E0%A6%95%E0%A6%BE%E0%A6%B2-%E0%A6%B6%E0%A6%B0%E0%A7%80%E0%A6%B0%E0%A7%87-%E0%A6%95%E0%A6%B0%E0%A6%AC%E2%80%99-%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%BE-%E0%A6%A8%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735584/%E2%80%98%E0%A6%86%E0%A6%9C-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A6%BE%E0%A6%AE-%E0%A6%95%E0%A6%BE%E0%A6%B2-%E0%A6%B6%E0%A6%B0%E0%A7%80%E0%A6%B0%E0%A7%87-%E0%A6%95%E0%A6%B0%E0%A6%AC%E2%80%99-%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%BE-%E0%A6%A8%E0%A6%BE</guid>
      <pubDate>Mon, 16 Nov 2026 13:42:06 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/3d7fd141a15e0494e5057ad435262aca-6afab2bba6d1e.jpg?jadewits_media_id=242971" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/3d7fd141a15e0494e5057ad435262aca-6afab2bba6d1e.jpg?jadewits_media_id=242971" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/3d7fd141a15e0494e5057ad435262aca-6afab2bba6d1e.jpg?jadewits_media_id=242971" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘আজ বাড়িতে গুলি করলাম, কাল শরীরে করব’ চাঁদা না পেয়ে সন্ত্রাসীর হুমকি" /&gt;&lt;/p&gt;&lt;p&gt;২০ লাখ টাকা চাঁদা না পেয়ে চট্টগ্রামের শহীদনগর এলাকায় এক ব্যক্তির বাড়িতে গুলি করার অভিযোগ উঠেছে। গুলি করার পর জাফর আহমদ নামের ওই ব্যক্তিকে মোবাইল ফোনে প্রাণনাশের হুমকি দিয়েছেন শীর্ষ সন্ত্রাসী হিসেবে পরিচিত মোহাম্মদ রায়হান।
রবিবার (১৫ নভেম্বর) দিবাগত রাত সাড়ে ১২টার দিকে নগরের শহীদনগর এলাকায় জাফর আহমদে&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735584/%E2%80%98%E0%A6%86%E0%A6%9C-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A6%BE%E0%A6%AE-%E0%A6%95%E0%A6%BE%E0%A6%B2-%E0%A6%B6%E0%A6%B0%E0%A7%80%E0%A6%B0%E0%A7%87-%E0%A6%95%E0%A6%B0%E0%A6%AC%E2%80%99-%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%BE-%E0%A6%A8%E0%A6%BE">দেশ রূপান্তর</source>

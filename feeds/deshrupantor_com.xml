    <item>
      <title>গর্ডনের জোড়ায় ইয়ামাল-রাফিনহাকে ছাড়াই বার্সার সহজ জয়</title>
      <link>https://www.deshrupantor.com/738022/%E0%A6%97%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A7%8B%E0%A6%A1%E0%A6%BC%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%87%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%B2-%E0%A6%B0%E0%A6%BE%E0%A6%AB%E0%A6%BF%E0%A6%A8%E0%A6%B9%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A6%BE%E0%A6%87-%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B8%E0%A6%BE%E0%A6%B0</link>

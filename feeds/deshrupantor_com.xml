      <guid isPermaLink="true">https://www.deshrupantor.com/735191/%E0%A6%9F%E0%A7%81%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BF%E0%A6%AA%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%93-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%9F%E0%A6%BF-%E0%A6%85%E0%A6%AB%E0%A6%BF%E0%A6%B8-%E0%A6%AD%E0%A6%BE%E0%A6%99%E0%A6%9A%E0%A7%81%E0%A6%B0</guid>
      <pubDate>Sat, 14 Nov 2026 22:28:11 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/09d339d0066ac9458ae759d1e54817ae-6af88c09a4802.JPG?jadewits_media_id=242601" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/09d339d0066ac9458ae759d1e54817ae-6af88c09a4802.JPG?jadewits_media_id=242601" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/09d339d0066ac9458ae759d1e54817ae-6af88c09a4802.JPG?jadewits_media_id=242601" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টুঙ্গিপাড়ায় বিএনপি ও যুবদলের দুটি অফিস ভাঙচুর, অগ্নিসংযোগ" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জের টুঙ্গিপাড়ায় বিএনপি ও যুবদলের দুটি অফিস ভাঙচুর ও অগ্নিসংযোগ করেছে কার্যক্রম নিষিদ্ধ আওয়ামী লীগ ও সহযোগী সংগঠনের নেতাকর্মীরা।
আজ শনিবার রাতে টুঙ্গিপাড়া উপজেলার নিলফা বাজার ও বর্ণি বাজারে এ ঘটনা ঘটে।
জানা গেছে, রাতে কার্যক্রম নিষিদ্ধ আওয়ামী লীগ ও সহযোগী সংগঠনের নেতাকর্মীরা লাঠিসোঁটা নিয়ে মি&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735191/%E0%A6%9F%E0%A7%81%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BF%E0%A6%AA%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%93-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%9F%E0%A6%BF-%E0%A6%85%E0%A6%AB%E0%A6%BF%E0%A6%B8-%E0%A6%AD%E0%A6%BE%E0%A6%99%E0%A6%9A%E0%A7%81%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>গুলশান লেকপার্কে সুরের মূর্ছনা: ‘গানে গানে হেমন্ত সন্ধ্যা’</title>
      <link>https://www.deshrupantor.com/735190/%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%B6%E0%A6%BE%E0%A6%A8-%E0%A6%B2%E0%A7%87%E0%A6%95%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A7%81%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%9B%E0%A6%A8%E0%A6%BE-%E2%80%98%E0%A6%97%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%97%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%B9%E0%A7%87%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735190/%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%B6%E0%A6%BE%E0%A6%A8-%E0%A6%B2%E0%A7%87%E0%A6%95%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A7%81%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%9B%E0%A6%A8%E0%A6%BE-%E2%80%98%E0%A6%97%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%97%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%B9%E0%A7%87%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4</guid>
      <pubDate>Sat, 14 Nov 2026 22:04:25 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/6bba6e0e0090773e63229a7239e25a36-6af8867331c55.jpg?jadewits_media_id=242599" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/6bba6e0e0090773e63229a7239e25a36-6af8867331c55.jpg?jadewits_media_id=242599" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/6bba6e0e0090773e63229a7239e25a36-6af8867331c55.jpg?jadewits_media_id=242599" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গুলশান লেকপার্কে সুরের মূর্ছনা: ‘গানে গানে হেমন্ত সন্ধ্যা’" /&gt;&lt;/p&gt;&lt;p&gt;নগরজীবনের যান্ত্রিকতা ও ব্যস্ততাকে ছাপিয়ে হেমন্তের স্নিগ্ধ সন্ধ্যায় শনিবার সুরের মায়াজাল বিস্তার করে &amp;lsquo;গানে গানে হেমন্ত সন্ধ্যা&amp;rsquo;। গুলশান সোসাইটির উদ্যোগে রাজধানীর লেকপার্কে এই মনোজ্ঞ সংগীতানুষ্ঠানের আয়োজন করা হয়।
অগ্রহায়ণের শেষ, মৃদু-মন্দ হিমেল হাওয়া বইছে। প্রকৃতিতে এখন হেমন্তের হাতছানি। &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735190/%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%B6%E0%A6%BE%E0%A6%A8-%E0%A6%B2%E0%A7%87%E0%A6%95%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A7%81%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%9B%E0%A6%A8%E0%A6%BE-%E2%80%98%E0%A6%97%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%97%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%B9%E0%A7%87%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>চারটি ফ্লাইট দিয়ে শুরু হচ্ছে শাহজালালের তৃতীয় টার্মিনালের কার্যক্রম: বিমানমন্ত্রী</title>

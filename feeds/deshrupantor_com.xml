    <item>
      <title>পঞ্চগড়ে তাবলিগ জামাতের তিন দিনের ইজতেমার সমাপ্তি</title>
      <link>https://www.deshrupantor.com/736797/%E0%A6%AA%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%97%E0%A7%9C%E0%A7%87-%E0%A6%A4%E0%A6%BE%E0%A6%AC%E0%A6%B2%E0%A6%BF%E0%A6%97-%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%87%E0%A6%9C%E0%A6%A4%E0%A7%87%E0%A6%AE%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736797/%E0%A6%AA%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%97%E0%A7%9C%E0%A7%87-%E0%A6%A4%E0%A6%BE%E0%A6%AC%E0%A6%B2%E0%A6%BF%E0%A6%97-%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%87%E0%A6%9C%E0%A6%A4%E0%A7%87%E0%A6%AE%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BF</guid>
      <pubDate>Sat, 21 Nov 2026 15:20:35 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/55c2f8bf3f4288bb7c494059e84e097a-6b01625418a78.jpg?jadewits_media_id=244115" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/55c2f8bf3f4288bb7c494059e84e097a-6b01625418a78.jpg?jadewits_media_id=244115" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/55c2f8bf3f4288bb7c494059e84e097a-6b01625418a78.jpg?jadewits_media_id=244115" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পঞ্চগড়ে তাবলিগ জামাতের তিন দিনের ইজতেমার সমাপ্তি" /&gt;&lt;/p&gt;&lt;p&gt;আখেরি মোনাজাতের মধ্য দিয়ে পঞ্চগড়ে তাবলিগ জামাতের তিন দিনব্যাপী ইজতেমার সমাপ্তি হয়েছে। শনিবার (২১ নভেম্বর) সকালে ফজরের নামাজের পর বয়ান শেষে মোনাজাত অনুষ্ঠিত হয়।
আয়োজকেরা জানান, ফজরের নামাজের পর মুরব্বি তারেক মাহমুদ বয়ান করেন। এরপর মাওলানা জিয়াউর রহমান আখেরি মোনাজাত পরিচালনা করেন। এর মধ্য দিয়ে তিন দিন&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736797/%E0%A6%AA%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%97%E0%A7%9C%E0%A7%87-%E0%A6%A4%E0%A6%BE%E0%A6%AC%E0%A6%B2%E0%A6%BF%E0%A6%97-%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%87%E0%A6%9C%E0%A6%A4%E0%A7%87%E0%A6%AE%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BF">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>ত্রিশালে টানা বৃষ্টিতে ফসলের ব্যাপক ক্ষতি</title>
      <link>https://www.deshrupantor.com/736796/%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%B6%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%9F%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%AC%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AB%E0%A6%B8%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AA%E0%A6%95-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A4%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736796/%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%B6%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%9F%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%AC%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AB%E0%A6%B8%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AA%E0%A6%95-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A4%E0%A6%BF</guid>
      <pubDate>Sat, 21 Nov 2026 15:20:20 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/014c31fad0dbff66a4d686becbd105d7-6b01623221ca1.jpg?jadewits_media_id=244114" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/014c31fad0dbff66a4d686becbd105d7-6b01623221ca1.jpg?jadewits_media_id=244114" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/014c31fad0dbff66a4d686becbd105d7-6b01623221ca1.jpg?jadewits_media_id=244114" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ত্রিশালে টানা বৃষ্টিতে ফসলের ব্যাপক ক্ষতি" /&gt;&lt;/p&gt;&lt;p&gt;ময়মনসিংহের ত্রিশালে টানা তিন দিনের বৃষ্টিতে কৃষি খাতে ব্যাপক ক্ষয়ক্ষতি হয়েছে। পাকা ও আধা পাকা আমন ধানের পাশাপাশি শীতকালীন সবজিরও ক্ষতি হয়েছে। এতে দিশেহারা হয়ে পড়েছেন কৃষকেরা। অন্যদিকে টানা বৃষ্টিতে কাজের সুযোগ কমে যাওয়ায় চরম দুর্ভোগে পড়েছেন শ্রমজীবী মানুষ।
কৃষক শফিকুল ইসলাম জানান, টানা বৃষ্টিতে পাকা&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736796/%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%B6%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%9F%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%AC%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AB%E0%A6%B8%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AA%E0%A6%95-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A4%E0%A6%BF">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>ভালো ফলনেও লোকসানের শঙ্কা টাঙ্গাইলের আমনচাষিদের</title>
      <link>https://www.deshrupantor.com/736795/%E0%A6%AD%E0%A6%BE%E0%A6%B2%E0%A7%8B-%E0%A6%AB%E0%A6%B2%E0%A6%A8%E0%A7%87%E0%A6%93-%E0%A6%B2%E0%A7%8B%E0%A6%95%E0%A6%B8%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BE-%E0%A6%9F%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%AE%E0%A6%A8%E0%A6%9A%E0%A6%BE%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736795/%E0%A6%AD%E0%A6%BE%E0%A6%B2%E0%A7%8B-%E0%A6%AB%E0%A6%B2%E0%A6%A8%E0%A7%87%E0%A6%93-%E0%A6%B2%E0%A7%8B%E0%A6%95%E0%A6%B8%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BE-%E0%A6%9F%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%AE%E0%A6%A8%E0%A6%9A%E0%A6%BE%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0</guid>

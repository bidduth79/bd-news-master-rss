    <item>
      <title>শেখ হাসিনার ফেরার ঘোষণা বিশ্বাসযোগ্য নয়</title>
      <link>https://www.deshrupantor.com/737973/%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%98%E0%A7%8B%E0%A6%B7%E0%A6%A3%E0%A6%BE-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%8D%E0%A6%AF-%E0%A6%A8%E0%A7%9F</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737973/%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%98%E0%A7%8B%E0%A6%B7%E0%A6%A3%E0%A6%BE-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%8D%E0%A6%AF-%E0%A6%A8%E0%A7%9F</guid>
      <pubDate>Thu, 26 Nov 2026 01:28:57 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/b9d12c0221bb7f2e622af647af812ebf-6b0736f22fe90.jpg?jadewits_media_id=245261" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/b9d12c0221bb7f2e622af647af812ebf-6b0736f22fe90.jpg?jadewits_media_id=245261" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/b9d12c0221bb7f2e622af647af812ebf-6b0736f22fe90.jpg?jadewits_media_id=245261" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শেখ হাসিনার ফেরার ঘোষণা বিশ্বাসযোগ্য নয়" /&gt;&lt;/p&gt;&lt;p&gt;শেখ হাসিনার দেশে ফেরার ঘোষণা বিশ্বাসযোগ্য নয় বলে মন্তব্য করেছেন বাংলাদেশ জামায়াতে ইসলামীর আমির ও জাতীয় সংসদের বিরোধীদলীয় নেতা ডা. শফিকুর রহমান। তিনি বলেছেন, দেশে ফিরলে শেখ হাসিনাকে আইনের আওতায় আসতে হবে। একই সঙ্গে আওয়ামী লীগের শাসনামলে সংঘটিত হত্যাকান্ড ও নির্যাতনের বিচার নিশ্চিত করার দাবি জানান তিনি&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737973/%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%98%E0%A7%8B%E0%A6%B7%E0%A6%A3%E0%A6%BE-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%8D%E0%A6%AF-%E0%A6%A8%E0%A7%9F">দেশ রূপান্তর</source>

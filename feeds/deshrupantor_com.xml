      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2025/04/08/f0f4550b2ec75150c5f3271d8b9ccb00-67f51681ebb54.jpg?jadewits_media_id=104625" length="0" type="image/jpeg" />

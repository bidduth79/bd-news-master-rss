      <pubDate>Mon, 16 Nov 2026 14:27:06 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2024/01/03/6d1a1cf12da1c12256da25abec50724e-65959ad052762.jpg?jadewits_media_id=14211" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2024/01/03/6d1a1cf12da1c12256da25abec50724e-65959ad052762.jpg?jadewits_media_id=14211" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2024/01/03/6d1a1cf12da1c12256da25abec50724e-65959ad052762.jpg?jadewits_media_id=14211" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হত্যাচেষ্টার আরেক মামলায় গ্রেপ্তার সাবেক এমপি মমতাজ" /&gt;&lt;/p&gt;&lt;p&gt;সোমবার (১৬ নভেম্বর) ঢাকার মেট্রোপলিটন ম্যাজিস্ট্রেট আরিফুর রহমানের আদালতে তাকে ভার্চুয়ালি হাজির দেখানো হয়। এরপর মামলার সুষ্ঠু তদন্তের স্বার্থে তাকে এ মামলায় গ্রেপ্তার দেখানোর আবেদন করেন মামলার তদন্তকারী কর্মকর্তা। শুনানি শেষে আদালত আবেদন মঞ্জুর করেন।						বিস্তারিত&lt;/p&gt;</description>

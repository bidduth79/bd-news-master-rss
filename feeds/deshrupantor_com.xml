    <item>
      <title>আখ চাষের মাধ্যমে দেশের চিনি শিল্পকে রক্ষা করতে হবে: হুইপ দুলু</title>
      <link>https://www.deshrupantor.com/734884/%E0%A6%86%E0%A6%96-%E0%A6%9A%E0%A6%BE%E0%A6%B7%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A6%AE%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%BF%E0%A6%A8%E0%A6%BF-%E0%A6%B6%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A6%95%E0%A7%87-%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734884/%E0%A6%86%E0%A6%96-%E0%A6%9A%E0%A6%BE%E0%A6%B7%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A6%AE%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%BF%E0%A6%A8%E0%A6%BF-%E0%A6%B6%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A6%95%E0%A7%87-%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87</guid>
      <pubDate>Fri, 13 Nov 2026 19:08:58 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/39031e526b16b110ce63642809873fa5-6af70bdf48366.gif?jadewits_media_id=242266" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/39031e526b16b110ce63642809873fa5-6af70bdf48366.gif?jadewits_media_id=242266" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/39031e526b16b110ce63642809873fa5-6af70bdf48366.gif?jadewits_media_id=242266" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আখ চাষের মাধ্যমে দেশের চিনি শিল্পকে রক্ষা করতে হবে: হুইপ দুলু" /&gt;&lt;/p&gt;&lt;p&gt;জাতীয় সংসদের হুইপ ও নাটোর-২ আসনের সংসদ সদস্য এডভোকেট এম রুহুল কুদ্দুস তালুকদার দুলু বলেছেন, বেশি বেশি আখ চাষের মাধ্যমে দেশের চিনি শিল্পকে রক্ষা করতে হবে। নাটোরসহ দেশের সব চিনিকল গুলোকে রক্ষা করতে হবে।
তিনি বলেন, দেশে চিনি উৎপাদন হয় বলে এখনো সাধারন মানুষ চিনি কিনে খেতে পায়, এসব চিনি কল বন্ধ হয়ে গেলে &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734884/%E0%A6%86%E0%A6%96-%E0%A6%9A%E0%A6%BE%E0%A6%B7%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A6%AE%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%BF%E0%A6%A8%E0%A6%BF-%E0%A6%B6%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A6%95%E0%A7%87-%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87">দেশ রূপান্তর</source>

      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/02d5bf3181bf219faa485ba21c10fd47-6afa0c4290a43.jpg?jadewits_media_id=242900" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/02d5bf3181bf219faa485ba21c10fd47-6afa0c4290a43.jpg?jadewits_media_id=242900" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/02d5bf3181bf219faa485ba21c10fd47-6afa0c4290a43.jpg?jadewits_media_id=242900" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আশিয়ান সিটির কার্যালয়ে হামলা ও ককটেল বিস্ফোরণ" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর উত্তরখানের আশকোনায় আবাসন কোম্পানি আশিয়ান সিটির কার্যালয়ে হামলা ও ভাঙচুরের ঘটনা ঘটেছে। রোববার সন্ধ্যা ৬টার দিকে এ ঘটনা ঘটে।
পুলিশের উত্তরা বিভাগের উপকমিশনার মো. রেজাউল করিম গণমাধ্যমকে বলেন, জমিজমা নিয়ে বিরোধের জেরে ২৫ থেকে ৩০ জন আশিয়ান সিটির কার্যালয়ে হামলা চালান। জড়িত ব্যক্তিদের শনাক্ত করে &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735494/%E0%A6%86%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8-%E0%A6%B8%E0%A6%BF%E0%A6%9F%E0%A6%BF%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%93-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3">দেশ রূপান্তর</source>
    </item>

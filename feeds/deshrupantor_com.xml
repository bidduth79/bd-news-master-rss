    <item>
      <title>গ্রামের প্রসূতি রোগীরা ছুটছেন শহরে</title>
      <link>https://www.deshrupantor.com/735010/%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A7%82%E0%A6%A4%E0%A6%BF-%E0%A6%B0%E0%A7%8B%E0%A6%97%E0%A7%80%E0%A6%B0%E0%A6%BE-%E0%A6%9B%E0%A7%81%E0%A6%9F%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%B6%E0%A6%B9%E0%A6%B0%E0%A7%87</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735010/%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A7%82%E0%A6%A4%E0%A6%BF-%E0%A6%B0%E0%A7%8B%E0%A6%97%E0%A7%80%E0%A6%B0%E0%A6%BE-%E0%A6%9B%E0%A7%81%E0%A6%9F%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%B6%E0%A6%B9%E0%A6%B0%E0%A7%87</guid>
      <pubDate>Sat, 14 Nov 2026 07:40:12 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/3f34fba5adc6222d1361dc695d1e561f-6af76df013b99.jpg?jadewits_media_id=242371" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/3f34fba5adc6222d1361dc695d1e561f-6af76df013b99.jpg?jadewits_media_id=242371" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/3f34fba5adc6222d1361dc695d1e561f-6af76df013b99.jpg?jadewits_media_id=242371" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গ্রামের প্রসূতি রোগীরা ছুটছেন শহরে" /&gt;&lt;/p&gt;&lt;p&gt;সন্দ্বীপের বাসিন্দা আসমা বেগম (ছদ্মনাম)। সন্তান প্রসবের সময় এগিয়ে এলে তাকে নেওয়া হয় স্থানীয় উপজেলা স্বাস্থ্য কমপ্লেক্সে। তবে প্রসবকালীন জটিলতা দেখা দেওয়ায় কর্তব্যরত চিকিৎসাকর্মীরা স্বজনদের প্রসূতিকে দ্রুত চট্টগ্রাম শহরে নিয়ে যাওয়ার পরামর্শ দেন। কারণ পরিস্থিতি সামাল দেওয়ার মতো বিশেষজ্ঞ চিকিৎসক বা পর্&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735010/%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A7%82%E0%A6%A4%E0%A6%BF-%E0%A6%B0%E0%A7%8B%E0%A6%97%E0%A7%80%E0%A6%B0%E0%A6%BE-%E0%A6%9B%E0%A7%81%E0%A6%9F%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%B6%E0%A6%B9%E0%A6%B0%E0%A7%87">দেশ রূপান্তর</source>

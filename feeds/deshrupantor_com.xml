    <item>
      <title>বেগমগঞ্জে ছুরিকাঘাতে যুবক নিহতের অভিযোগ</title>
      <link>https://www.deshrupantor.com/733767/%E0%A6%AC%E0%A7%87%E0%A6%97%E0%A6%AE%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%9B%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%98%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%95-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/733767/%E0%A6%AC%E0%A7%87%E0%A6%97%E0%A6%AE%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%9B%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%98%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%95-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97</guid>
      <pubDate>Mon, 09 Nov 2026 11:26:17 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/adc4c68965b8d018d955a7d252671a5e-6af1593c16298.jpg?jadewits_media_id=241225" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/adc4c68965b8d018d955a7d252671a5e-6af1593c16298.jpg?jadewits_media_id=241225" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/adc4c68965b8d018d955a7d252671a5e-6af1593c16298.jpg?jadewits_media_id=241225" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বেগমগঞ্জে ছুরিকাঘাতে যুবক নিহতের অভিযোগ" /&gt;&lt;/p&gt;&lt;p&gt;নোয়াখালীর বেগমগঞ্জ উপজেলায় জমি নিয়ে বিরোধের জেরে প্রতিপক্ষের ছুরিকাঘাতে শহীদুল ইসলাম মোনা নামের এক যুবক নিহত হয়েছেন। এ ঘটনায় তার ভগ্নিপতি আবদুল্লাহ আল মামুন ছুরিকাঘাতে আহত হন। রবিবার (৮ নভেম্বর) রাত সাড়ে ১১টার দিকে উপজেলার হাজীপুর ইউনিয়নের করইতলা গ্রামের এ ঘটনা ঘটে।
নিহত শহীদুল ইসলাম মোনা (২২) ওই এল&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/733767/%E0%A6%AC%E0%A7%87%E0%A6%97%E0%A6%AE%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%9B%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%98%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%95-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97">দেশ রূপান্তর</source>
    </item>

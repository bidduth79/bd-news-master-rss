    <item>
      <title>বিশেষ সম্মাননা পাচ্ছেন ধ্রুব গুহ</title>
      <link>https://www.deshrupantor.com/737840/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%A7%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%AC-%E0%A6%97%E0%A7%81%E0%A6%B9</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737840/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%A7%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%AC-%E0%A6%97%E0%A7%81%E0%A6%B9</guid>
      <pubDate>Wed, 25 Nov 2026 17:50:12 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/b2ad24346c8df73e506d06d5afe0bd39-6b06caea49722.jpg?jadewits_media_id=245146" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/b2ad24346c8df73e506d06d5afe0bd39-6b06caea49722.jpg?jadewits_media_id=245146" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/b2ad24346c8df73e506d06d5afe0bd39-6b06caea49722.jpg?jadewits_media_id=245146" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিশেষ সম্মাননা পাচ্ছেন ধ্রুব গুহ" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশের সংগীতাঙ্গনে দীর্ঘমেয়াদি ও অসামান্য অবদানের স্বীকৃতিস্বরূপ &amp;lsquo;সিজেএফবি পারফরম্যান্স অ্যাওয়ার্ড'-এর বিশেষ সম্মাননায় ভূষিত হচ্ছেন সংগীতশিল্পী ও ধ্রুব মিউজিক স্টেশনের প্রতিষ্ঠাতা ধ্রুব গুহ।&amp;nbsp;
সংগীতশিল্পে ধারাবাহিক অবদানের পাশাপাশি নতুন মৌলিক গান নির্মাণ, প্রযোজনা ও প্রকাশে নিয়মিত &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737840/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%A7%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%AC-%E0%A6%97%E0%A7%81%E0%A6%B9">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>‘গণরায় মেনে বিএনপি সংস্কারের পথে হাঁটলে জুলাইয়ের জাতীয় ঐক্য অটুট থাকত’</title>
      <link>https://www.deshrupantor.com/737839/%E2%80%98%E0%A6%97%E0%A6%A3%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A7%87%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%81%E0%A6%9F%E0%A6%B2%E0%A7%87-%E0%A6%9C%E0%A7%81%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A7%9F%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737839/%E2%80%98%E0%A6%97%E0%A6%A3%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A7%87%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%81%E0%A6%9F%E0%A6%B2%E0%A7%87-%E0%A6%9C%E0%A7%81%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A7%9F%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Wed, 25 Nov 2026 17:48:47 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/aa2128d9f2f5aa2aa1709665723e84e3-6b06cafe0b701.jpeg?jadewits_media_id=245147" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/aa2128d9f2f5aa2aa1709665723e84e3-6b06cafe0b701.jpeg?jadewits_media_id=245147" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/aa2128d9f2f5aa2aa1709665723e84e3-6b06cafe0b701.jpeg?jadewits_media_id=245147" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘গণরায় মেনে বিএনপি সংস্কারের পথে হাঁটলে জুলাইয়ের জাতীয় ঐক্য অটুট থাকত’" /&gt;&lt;/p&gt;&lt;p&gt;দেশে ক্রমবর্ধমান সন্ত্রাস, নাশকতা ও আইনশৃঙ্খলা পরিস্থিতির অবনতি এবং এসব অপরাধমূলক কর্মকাণ্ড নিয়ন্ত্রণ ও জনগণের জানমালের নিরাপত্তা নিশ্চিত করতে সরকারের ব্যর্থতার প্রতিবাদে বুধবার (২৫ নভেম্বর) বিকেলে চট্টগ্রাম নগরীতে বিক্ষোভ মিছিল করেছে বাংলাদেশ জামায়াতে ইসলামী।&amp;nbsp;
মিছিল পূর্ব সমাবেশে দলের কেন্দ্রী&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737839/%E2%80%98%E0%A6%97%E0%A6%A3%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A7%87%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%81%E0%A6%9F%E0%A6%B2%E0%A7%87-%E0%A6%9C%E0%A7%81%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A7%9F%E0%A7%87%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>নদীর প্রবাহ স্বাভাবিক রাখতে নাটোরে স্মারকলিপি প্রদান</title>
      <link>https://www.deshrupantor.com/737838/%E0%A6%A8%E0%A6%A6%E0%A7%80%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B9-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%95-%E0%A6%B0%E0%A6%BE%E0%A6%96%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%9F%E0%A7%8B%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A6%B2%E0%A6%BF%E0%A6%AA%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737838/%E0%A6%A8%E0%A6%A6%E0%A7%80%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B9-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%95-%E0%A6%B0%E0%A6%BE%E0%A6%96%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%9F%E0%A7%8B%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A6%B2%E0%A6%BF%E0%A6%AA%E0%A6%BF</guid>
      <pubDate>Wed, 25 Nov 2026 17:45:07 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/9cf16e5eb1559088249de9d00ac3dc70-6b06ca3ec69d3.jpg?jadewits_media_id=245145" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/9cf16e5eb1559088249de9d00ac3dc70-6b06ca3ec69d3.jpg?jadewits_media_id=245145" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/9cf16e5eb1559088249de9d00ac3dc70-6b06ca3ec69d3.jpg?jadewits_media_id=245145" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নদীর প্রবাহ স্বাভাবিক রাখতে নাটোরে স্মারকলিপি প্রদান" /&gt;&lt;/p&gt;&lt;p&gt;নারদ নদসহ অন্যান্য নদীর স্বাভাবিক প্রবাহ নিশ্চিত করতে নাটোরের জেলা প্রশাসকের মাধ্যমে প্রধানমন্ত্রী বরাবর স্মারকলিপি প্রদান করা হয়েছে। বুধবার (২৫ নভেম্বর) সকাল ১০টায় জেলা প্রশাসক মোছা. সুমনী আক্তারের নিকট তার দপ্তরে ১৭টি দাবি সম্বলিত স্মারকলিপি প্রদান করেন বাংলাদেশ নদী বাঁচাও আন্দোলন নাটোর জেলা কমিটি&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737838/%E0%A6%A8%E0%A6%A6%E0%A7%80%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B9-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%95-%E0%A6%B0%E0%A6%BE%E0%A6%96%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%9F%E0%A7%8B%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A6%B2%E0%A6%BF%E0%A6%AA%E0%A6%BF">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>মণিপুরী নৃত্যে মহারাসলীলায় মাতল জনতা</title>
      <link>https://www.deshrupantor.com/737837/%E0%A6%AE%E0%A6%A3%E0%A6%BF%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%80-%E0%A6%A8%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A6%B2%E0%A7%80%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A6%B2-%E0%A6%9C%E0%A6%A8%E0%A6%A4%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737837/%E0%A6%AE%E0%A6%A3%E0%A6%BF%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%80-%E0%A6%A8%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A6%B2%E0%A7%80%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A6%B2-%E0%A6%9C%E0%A6%A8%E0%A6%A4%E0%A6%BE</guid>
      <pubDate>Wed, 25 Nov 2026 17:27:03 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/222dc21816a0909679f718755ea4f150-6b06c54220967.jpg?jadewits_media_id=245142" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/222dc21816a0909679f718755ea4f150-6b06c54220967.jpg?jadewits_media_id=245142" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/222dc21816a0909679f718755ea4f150-6b06c54220967.jpg?jadewits_media_id=245142" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মণিপুরী নৃত্যে মহারাসলীলায় মাতল জনতা" /&gt;&lt;/p&gt;&lt;p&gt;মৌলভীবাজারের কমলগঞ্জে নানা আয়োজন ও উৎসবমুখর পরিবেশে অনুষ্ঠিত হয়েছে মণিপুরী সম্প্রদায়ের প্রধান ধর্মীয় উৎসব মহারাসলীলা। মঙ্গলবার (২৪ নভেম্বর) সকাল থেকে শুরু হওয়া দুই দিনব্যাপী আয়োজনের সমাপ্তি ঘটে বুধবার (২৫ নভেম্বর) ভোরে। মণিপুরী নৃত্যের অপূর্ব পরিবেশনা, ধর্মীয় আচার ও বিপুলসংখ্যক দর্শনার্থীর উপস্থিতিত&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737837/%E0%A6%AE%E0%A6%A3%E0%A6%BF%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%80-%E0%A6%A8%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A6%B2%E0%A7%80%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A6%B2-%E0%A6%9C%E0%A6%A8%E0%A6%A4%E0%A6%BE">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>শিবগঞ্জে ককটেল বানাতে গিয়ে কৃষক লীগ নেতা নিহত, আহত ৩</title>
      <link>https://www.deshrupantor.com/737836/%E0%A6%B6%E0%A6%BF%E0%A6%AC%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%97%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%95%E0%A7%83%E0%A6%B7%E0%A6%95-%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A6%86%E0%A6%B9%E0%A6%A4</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737836/%E0%A6%B6%E0%A6%BF%E0%A6%AC%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%97%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%95%E0%A7%83%E0%A6%B7%E0%A6%95-%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A6%86%E0%A6%B9%E0%A6%A4</guid>
      <pubDate>Wed, 25 Nov 2026 17:23:41 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/989562041a67d26fd17a16923feca435-6b06c48ec8190.jpg?jadewits_media_id=245141" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/989562041a67d26fd17a16923feca435-6b06c48ec8190.jpg?jadewits_media_id=245141" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/989562041a67d26fd17a16923feca435-6b06c48ec8190.jpg?jadewits_media_id=245141" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শিবগঞ্জে ককটেল বানাতে গিয়ে কৃষক লীগ নেতা নিহত, আহত ৩" /&gt;&lt;/p&gt;&lt;p&gt;চাঁপাইনবাবগঞ্জের শিবগঞ্জে ককটেল বানাতে গিয়ে বিস্ফোরণে টমাস আলী (৩৫) নামের এক যুবক নিহত হয়েছেন। এ সময় আহত হয়েছেন আরও তিনজন। বুধবার দুপুরে শিবগঞ্জ উপজেলার মনাকষা ইউনিয়নের ৫ নম্বর ওয়ার্ডের পারচৌকা এলাকার একটি মাঠের ঘাসের জমিতে ওই বিস্ফোরণের ঘটনা ঘটে।
নিহত টমাস আলী শিবগঞ্জ উপজেলার বিশ্বনাথপুর লম্বাটোলা &lt;/p&gt;</description>

    <item>
      <title>ক্ষেতেই পচছে ফসল</title>
      <link>https://www.deshrupantor.com/735272/%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%A4%E0%A7%87%E0%A6%87-%E0%A6%AA%E0%A6%9A%E0%A6%9B%E0%A7%87-%E0%A6%AB%E0%A6%B8%E0%A6%B2</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735272/%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%A4%E0%A7%87%E0%A6%87-%E0%A6%AA%E0%A6%9A%E0%A6%9B%E0%A7%87-%E0%A6%AB%E0%A6%B8%E0%A6%B2</guid>
      <pubDate>Sun, 15 Nov 2026 07:31:05 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/f23d0dced0ace600a334291ba5fc98a5-6af90b53a49fb.jpg?jadewits_media_id=242672" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/f23d0dced0ace600a334291ba5fc98a5-6af90b53a49fb.jpg?jadewits_media_id=242672" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/f23d0dced0ace600a334291ba5fc98a5-6af90b53a49fb.jpg?jadewits_media_id=242672" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ক্ষেতেই পচছে ফসল" /&gt;&lt;/p&gt;&lt;p&gt;রাঙ্গামাটির বাঘাইছড়ি উপজেলার জনপ্রিয় পর্যটনকেন্দ্র সাজেকে বিভিন্ন দাবিতে চলা অনির্দিষ্টকালের অবরোধ আজ রবিবার ২৫ দিনে গড়িয়েছে। গত ২২ অক্টোবর শুরু হওয়া এই কর্মসূচি প্রত্যাহারের বিষয়ে এখনো কোনো ইতিবাচক অগ্রগতি দেখা যায়নি। অবরোধ আহ্বানকারী দুই সংগঠনের মধ্যে &amp;lsquo;সাজেক কার্বারি অ্যাসোসিয়েশন&amp;rsquo; কর্ম&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735272/%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%A4%E0%A7%87%E0%A6%87-%E0%A6%AA%E0%A6%9A%E0%A6%9B%E0%A7%87-%E0%A6%AB%E0%A6%B8%E0%A6%B2">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>পর্যটকের চাপে বিপর্যয়ের মুখে সেন্টমার্টিন</title>
      <link>https://www.deshrupantor.com/735271/%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%9F%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%BE%E0%A6%AA%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%87-%E0%A6%B8%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735271/%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%9F%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%BE%E0%A6%AA%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%87-%E0%A6%B8%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%A8</guid>
      <pubDate>Sun, 15 Nov 2026 07:29:21 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/0d039844aa83356df6a8d6492bce3fb9-6af90ae972a10.jpg?jadewits_media_id=242671" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/0d039844aa83356df6a8d6492bce3fb9-6af90ae972a10.jpg?jadewits_media_id=242671" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/0d039844aa83356df6a8d6492bce3fb9-6af90ae972a10.jpg?jadewits_media_id=242671" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পর্যটকের চাপে বিপর্যয়ের মুখে সেন্টমার্টিন" /&gt;&lt;/p&gt;&lt;p&gt;পর্যটকদের জন্য দীর্ঘ বিরতির পর খুলেছে দেশের একমাত্র প্রবালসমৃদ্ধ দ্বীপ সেন্টমার্টিন। এতে স্বস্তি ও কর্মচাঞ্চল্য ফিরেছে স্থানীয় ব্যবসায়ীদের মধ্যে। কিন্তু পরিবেশগত বিপর্যয়ের শঙ্কা বিশেষজ্ঞদের। সেন্টমার্টিন দ্বীপের সর্বোচ্চ ধারণক্ষমতা ৪ থেকে ৫ হাজার মানুষ। অথচ এবারে পর্যটন মৌসুমে প্রতিদিন দ্বীপে সাড়ে &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735271/%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%9F%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%BE%E0%A6%AA%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%87-%E0%A6%B8%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%A8">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>মোহাম্মদপুরে আ.লীগ নেতা গ্রেপ্তার</title>
      <link>https://www.deshrupantor.com/735270/%E0%A6%AE%E0%A7%8B%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%A6%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735270/%E0%A6%AE%E0%A7%8B%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%A6%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Sun, 15 Nov 2026 07:28:51 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/05fb8c2fcf410cb62a774fdc34e6e35b-6af906a4ce3fc.jpg?jadewits_media_id=242655" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/05fb8c2fcf410cb62a774fdc34e6e35b-6af906a4ce3fc.jpg?jadewits_media_id=242655" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/05fb8c2fcf410cb62a774fdc34e6e35b-6af906a4ce3fc.jpg?jadewits_media_id=242655" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মোহাম্মদপুরে আ.লীগ নেতা গ্রেপ্তার" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর মোহাম্মদপুর থেকে কার্যক্রম নিষিদ্ধ আওয়ামী লীগের স্থানীয় নেতা আবুল হোসেনকে গ্রেপ্তার করেছে পুলিশ। গত শুক্রবার রাত সোয়া ৮টার দিকে বাবর রোডের অনুরাগের গলি এলাকা থেকে তাকে গ্রেপ্তার করা হয়। গতকাল শনিবার মোহাম্মদপুর থানার ওসি আব্দুল হালিম জানান, তিনি মোহাম্মদপুর থানা আওয়ামী লীগের বাবর রোড ইউনিট &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735270/%E0%A6%AE%E0%A7%8B%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%A6%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>মাহদীর বাসায় বোমা নিক্ষেপের অভিযোগ, পুলিশ বলছে ভিন্ন কথা</title>
      <link>https://www.deshrupantor.com/735269/%E0%A6%AE%E0%A6%BE%E0%A6%B9%E0%A6%A6%E0%A7%80%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%AC%E0%A6%B2%E0%A6%9B%E0%A7%87</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735269/%E0%A6%AE%E0%A6%BE%E0%A6%B9%E0%A6%A6%E0%A7%80%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%AC%E0%A6%B2%E0%A6%9B%E0%A7%87</guid>
      <pubDate>Sun, 15 Nov 2026 07:28:31 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/05fb8c2fcf410cb62a774fdc34e6e35b-6af906a4ce3fc.jpg?jadewits_media_id=242655" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/05fb8c2fcf410cb62a774fdc34e6e35b-6af906a4ce3fc.jpg?jadewits_media_id=242655" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/05fb8c2fcf410cb62a774fdc34e6e35b-6af906a4ce3fc.jpg?jadewits_media_id=242655" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মাহদীর বাসায় বোমা নিক্ষেপের অভিযোগ, পুলিশ বলছে ভিন্ন কথা" /&gt;&lt;/p&gt;&lt;p&gt;বিভিন্ন সময়ে নানাভাবে আলোচনায় আসা হবিগঞ্জে বৈষম্যবিরোধী ছাত্র আন্দোলনের সদস্য সচিব মাহদী হাসান গত শুক্রবার মাঝরাতে ফেসবুক লাইভে এসে অভিযোগ করেছেন তার বাসায় পেট্রোল বোমা নিক্ষেপের ঘটনা ঘটেছে। কিন্তু পুলিশ বলছে ভিন্ন কথা। ঘটনাস্থলে পেট্রোল বোমার কোনো আলামত পাওয়া যায়নি। হবিগঞ্জ সদর মডেল থানার ওসি জাহিদ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735269/%E0%A6%AE%E0%A6%BE%E0%A6%B9%E0%A6%A6%E0%A7%80%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%AC%E0%A6%B2%E0%A6%9B%E0%A7%87">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>অনুরাগ ফার্মেসিতে চাঁদা দাবি, না পেয়ে গুলি</title>

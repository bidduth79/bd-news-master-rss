      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2023/11/01/756bedac712941f47eb46b3a34b88636-6541866731238.png?jadewits_media_id=9" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2023/11/01/756bedac712941f47eb46b3a34b88636-6541866731238.png?jadewits_media_id=9" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2023/11/01/756bedac712941f47eb46b3a34b88636-6541866731238.png?jadewits_media_id=9" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মূসক ও সম্পূরক শুল্ক বিল-২০২৬ পাস" /&gt;&lt;/p&gt;&lt;p&gt;প্রতি কর মেয়াদ শেষে ১৫ দিনের মধ্যে মূল্য সংযোজন কর (মূসক) বা ভ্যাট রিটার্ন জমা দেওয়ার বিধান পুনর্বহালের লক্ষ্যে জাতীয় সংসদে &amp;lsquo;মূল্য সংযোজন কর ও সম্পূরক শুল্ক (সংশোধন) বিল, ২০২৬&amp;rsquo; পাস হয়েছে।
গতকাল মঙ্গলবার জাতীয় সংসদে অর্থ ও পরিকল্পনামন্ত্রী আমির খসরু মাহমুদ চৌধুরী বিলটি উত্থাপন করলে কণ্ঠভো&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736061/%E0%A6%AE%E0%A7%82%E0%A6%B8%E0%A6%95-%E0%A6%93-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A7%82%E0%A6%B0%E0%A6%95-%E0%A6%B6%E0%A7%81%E0%A6%B2%E0%A7%8D%E0%A6%95-%E0%A6%AC%E0%A6%BF%E0%A6%B2-%E0%A7%A8%E0%A7%A6%E0%A7%A8%E0%A7%AC-%E0%A6%AA%E0%A6%BE%E0%A6%B8">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>প্রবাসীরা একটি প্রজন্মকে বড় স্বপ্ন দেখাতে পারেন</title>
      <link>https://www.deshrupantor.com/736060/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%80%E0%A6%B0%E0%A6%BE-%E0%A6%8F%E0%A6%95%E0%A6%9F%E0%A6%BF-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AE%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A7%9C-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%AA%E0%A7%8D%E0%A6%A8-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736060/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%80%E0%A6%B0%E0%A6%BE-%E0%A6%8F%E0%A6%95%E0%A6%9F%E0%A6%BF-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AE%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A7%9C-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%AA%E0%A7%8D%E0%A6%A8-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Wed, 18 Nov 2026 07:27:49 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/06e131fa29f726f4d06419fef3890988-6afcf841f3ada.jpg?jadewits_media_id=243435" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/06e131fa29f726f4d06419fef3890988-6afcf841f3ada.jpg?jadewits_media_id=243435" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/06e131fa29f726f4d06419fef3890988-6afcf841f3ada.jpg?jadewits_media_id=243435" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রবাসীরা একটি প্রজন্মকে বড় স্বপ্ন দেখাতে পারেন" /&gt;&lt;/p&gt;&lt;p&gt;পর্তুগালের ডাচেস অব কোইমব্রা ইনফান্তা মারিয়া ফ্রান্সিসকা বলেছেন, &amp;lsquo;কী কী সম্ভব, তা মানুষকে দেখানোর মাধ্যমে প্রবাসীরা গুরুত্বপূর্ণ ভূমিকা রাখতে পারেন। এ ধরনের যোগাযোগ ও অভিজ্ঞতা বিনিময় অন্যদের উপলব্ধি করতে সহায়তা করে যে, তারাও যেখান থেকেই আসুক না কেন, বড় কিছু অর্জন করতে পারে।&amp;rsquo;
গতকাল মঙ্গলব&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736060/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%80%E0%A6%B0%E0%A6%BE-%E0%A6%8F%E0%A6%95%E0%A6%9F%E0%A6%BF-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AE%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A7%9C-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%AA%E0%A7%8D%E0%A6%A8-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%A8">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>ন্যায়বিচার প্রতিষ্ঠায় বিরোধী দলের সহযোগিতা চাই</title>
      <link>https://www.deshrupantor.com/736059/%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A7%9F%E0%A6%AC%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%80-%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%B9%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A6%BF%E0%A6%A4%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%87</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736059/%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A7%9F%E0%A6%AC%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%80-%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%B9%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A6%BF%E0%A6%A4%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%87</guid>
      <pubDate>Wed, 18 Nov 2026 07:27:21 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2023/11/01/756bedac712941f47eb46b3a34b88636-6541866731238.png?jadewits_media_id=9" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2023/11/01/756bedac712941f47eb46b3a34b88636-6541866731238.png?jadewits_media_id=9" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2023/11/01/756bedac712941f47eb46b3a34b88636-6541866731238.png?jadewits_media_id=9" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ন্যায়বিচার প্রতিষ্ঠায় বিরোধী দলের সহযোগিতা চাই" /&gt;&lt;/p&gt;&lt;p&gt;শিশু রামিসা ধর্ষণ ও হত্যা মামলার বিচারিক প্রক্রিয়া সম্পন্ন হয়েছে জানিয়ে আইনমন্ত্রী মো. আসাদুজ্জামান বলেছেন, শরিফ ওসমান হাদি হত্যা মামলার বিচারও হবে। একই সঙ্গে মেজর সিনহা, বিশ্বজিৎ ও শহীদ আবরার ফাহাদ হত্যা মামলার আপিল শুনানি আগামী সপ্তাহ থেকে পর্যায়ক্রমে শুরু হবে।
গতকাল মঙ্গলবার ত্রয়োদশ জাতীয় সংসদের &lt;/p&gt;</description>

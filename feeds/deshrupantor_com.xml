    <item>
      <title>হাতিয়ায় তিনদিন ধরে স্কুলছাত্রী নিখোঁজ</title>
      <link>https://www.deshrupantor.com/735935/%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%A4%E0%A6%BF%E0%A6%A8%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%A7%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%A8%E0%A6%BF%E0%A6%96%E0%A7%8B%E0%A6%81%E0%A6%9C</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735935/%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%A4%E0%A6%BF%E0%A6%A8%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%A7%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%A8%E0%A6%BF%E0%A6%96%E0%A7%8B%E0%A6%81%E0%A6%9C</guid>
      <pubDate>Tue, 17 Nov 2026 18:44:41 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/02/19/2cc80030d60d4fe5a65860a0f0aed047-6997192a7f9fe.jpg?jadewits_media_id=176432" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/02/19/2cc80030d60d4fe5a65860a0f0aed047-6997192a7f9fe.jpg?jadewits_media_id=176432" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/02/19/2cc80030d60d4fe5a65860a0f0aed047-6997192a7f9fe.jpg?jadewits_media_id=176432" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হাতিয়ায় তিনদিন ধরে স্কুলছাত্রী নিখোঁজ" /&gt;&lt;/p&gt;&lt;p&gt;নোয়াখালীর হাতিয়ায় বাড়ি থেকে বিদ্যালয়ে যাওয়ার পথে শ্রাবণ্তী রাণী মজুমদার নামক এক স্কুলছাত্রী নিখোঁজ হয়েছে। রবিবার (১৫ নভেম্বর) সকাল সাড়ে ১০টা থেকে উপজেলার জাহাজমারা ইউনিয়নের জাহাজমারা এলাকা থেকে সে নিখোঁজ হয়।
মঙ্গলবার (১৭ নভেম্বর) বিকেলে পর্যন্ত তার কোনো সন্ধান পাওয়া যায়নি। এ ঘটনায় ভুক্তভোগী বাবা সখা&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735935/%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%A4%E0%A6%BF%E0%A6%A8%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%A7%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%A8%E0%A6%BF%E0%A6%96%E0%A7%8B%E0%A6%81%E0%A6%9C">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>হাম উপসর্গে আরও ৫ মৃত্যু</title>
      <link>https://www.deshrupantor.com/735933/%E0%A6%B9%E0%A6%BE%E0%A6%AE-%E0%A6%89%E0%A6%AA%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A7%AB-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81</link>

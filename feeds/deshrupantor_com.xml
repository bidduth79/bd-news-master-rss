      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/6395a8bb5c015bf02ce5927bd6bfa78d-6af96e03b2b20.gif?jadewits_media_id=242731" length="0" type="image/jpeg" />

      <guid isPermaLink="true">https://www.deshrupantor.com/737476/%E0%A6%9A%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%A8%E0%A6%BE%E0%A6%87%E0%A6%B6%E0%A7%87-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%8F%E0%A6%B8%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1-%E0%A6%B9%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A7%87-%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%86%E0%A6%AB%E0%A6%B0%E0%A6%BF%E0%A6%A8</guid>
      <pubDate>Tue, 24 Nov 2026 10:39:15 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/f7aaefa90da7f76889f6673ae667835f-6b0514c8adb65.jpg?jadewits_media_id=244758" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/f7aaefa90da7f76889f6673ae667835f-6b0514c8adb65.jpg?jadewits_media_id=244758" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/f7aaefa90da7f76889f6673ae667835f-6b0514c8adb65.jpg?jadewits_media_id=244758" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চন্দনাইশে নতুন এসিল্যান্ড হিসেবে যোগ দিলেন আফরিন ফারজানা পিংকি" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রামের চন্দনাইশ উপজেলায় নতুন সহকারী কমিশনার (ভূমি) হিসেবে যোগদান করেছেন আফরিন ফারজানা পিংকি।
সোমবার (২৩ নভেম্বর) তিনি আনুষ্ঠানিকভাবে যোগদান শেষে উপজেলা নির্বাহী অফিসার (ইউএনও) মো. আবদুর রহমানের কাছ থেকে দায়িত্বভার গ্রহণ করেন। এ সময় ইউএনও তাকে ফুল দিয়ে বরণ করে নেন।
জানা যায়, তিনি ৪১তম বিসিএ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737476/%E0%A6%9A%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%A8%E0%A6%BE%E0%A6%87%E0%A6%B6%E0%A7%87-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%8F%E0%A6%B8%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1-%E0%A6%B9%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A7%87-%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%86%E0%A6%AB%E0%A6%B0%E0%A6%BF%E0%A6%A8">দেশ রূপান্তর</source>

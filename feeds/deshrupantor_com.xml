    <item>
      <title>সরকারি বটিয়াঘাটা কলেজে গেটে তালা ঝুলিয়ে আগুন লাগিয়েছে দুর্বৃত্তরা</title>
      <link>https://www.deshrupantor.com/733908/%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%AC%E0%A6%9F%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%98%E0%A6%BE%E0%A6%9F%E0%A6%BE-%E0%A6%95%E0%A6%B2%E0%A7%87%E0%A6%9C%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%9F%E0%A7%87-%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BE-%E0%A6%9D%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/733908/%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%AC%E0%A6%9F%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%98%E0%A6%BE%E0%A6%9F%E0%A6%BE-%E0%A6%95%E0%A6%B2%E0%A7%87%E0%A6%9C%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%9F%E0%A7%87-%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BE-%E0%A6%9D%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</guid>
      <pubDate>Mon, 09 Nov 2026 20:27:18 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/04e2ec8f2e9967ed3726437804363700-6af1d831b02e5.jpg?jadewits_media_id=241361" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/04e2ec8f2e9967ed3726437804363700-6af1d831b02e5.jpg?jadewits_media_id=241361" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/04e2ec8f2e9967ed3726437804363700-6af1d831b02e5.jpg?jadewits_media_id=241361" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সরকারি বটিয়াঘাটা কলেজে গেটে তালা ঝুলিয়ে আগুন লাগিয়েছে দুর্বৃত্তরা" /&gt;&lt;/p&gt;&lt;p&gt;খুলনার সরকারি বটিয়াঘাটা মহাবিদ্যালয়ের প্রধান গেটে তালা ঝুলিয়ে আগুন লাগিয়েছে দুর্বৃত্তরা। শনিবার (৮ নভেম্বর) গভীর রাতে এ ঘটনা ঘটে। খবর পেয়ে কলেজ কর্তৃপক্ষ বটিয়াঘাটা থানা পুলিশের সহযোগিতায় আগুন নিয়ন্ত্রণ এনে তালা ভেঙে ভিতরে প্রবেশ করেন।
কলেজের নাইটগার্ড সূত্রে জানা গেছে, রবিবার গভীর রাত্রে একদ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/733908/%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%AC%E0%A6%9F%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%98%E0%A6%BE%E0%A6%9F%E0%A6%BE-%E0%A6%95%E0%A6%B2%E0%A7%87%E0%A6%9C%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%9F%E0%A7%87-%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BE-%E0%A6%9D%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>চন্দনাইশে বিশেষ অভিযানে ৪ আসামি গ্রেপ্তার</title>

      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/d65ec51ab09f5907d24378125bd6bfd6-6afddfaf08232.jpg?jadewits_media_id=243606" length="0" type="image/jpeg" />

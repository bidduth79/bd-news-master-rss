      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/be1707bfb5090700840d98220d543205-6afc9fc1098ff.jpg?jadewits_media_id=243402" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/be1707bfb5090700840d98220d543205-6afc9fc1098ff.jpg?jadewits_media_id=243402" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মঞ্চে আজ হুমায়ূন আহমেদের নৃপতি" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ থিয়েটারের চার দশক পূর্তি উপলক্ষে আয়োজিত উৎসবে আজ সন্ধ্যায় মঞ্চস্থ হতে যাচ্ছে নন্দিত কথাসাহিত্যিক হুমায়ূন আহমেদের প্রথম মঞ্চনাটক &amp;lsquo;নৃপতি&amp;rsquo;। আজ বুধবার, ১৮ নভেম্বর সন্ধ্যা সাড়ে ৬টায় বাংলাদেশ শিল্পকলা একাডেমির জাতীয় নাট্যশালার মূল মিলনায়তনে নাটকটির বিশেষ প্রদর্শনী অনুষ্ঠিত হবে। নান্দন&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736017/%E0%A6%AE%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A7%87-%E0%A6%86%E0%A6%9C-%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A7%82%E0%A6%A8-%E0%A6%86%E0%A6%B9%E0%A6%AE%E0%A7%87%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A7%83%E0%A6%AA%E0%A6%A4%E0%A6%BF">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>গাজী মাজহারুল আনোয়ারের নামে সম্মাননা চালু</title>
      <link>https://www.deshrupantor.com/736016/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A7%80-%E0%A6%AE%E0%A6%BE%E0%A6%9C%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A7%81%E0%A6%B2-%E0%A6%86%E0%A6%A8%E0%A7%8B%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%A8%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A7%81</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736016/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A7%80-%E0%A6%AE%E0%A6%BE%E0%A6%9C%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A7%81%E0%A6%B2-%E0%A6%86%E0%A6%A8%E0%A7%8B%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%A8%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A7%81</guid>
      <pubDate>Wed, 18 Nov 2026 01:09:25 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/17886dc378f57b0111129b9b44895047-6afc9fbc31373.jpg?jadewits_media_id=243394" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/17886dc378f57b0111129b9b44895047-6afc9fbc31373.jpg?jadewits_media_id=243394" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/17886dc378f57b0111129b9b44895047-6afc9fbc31373.jpg?jadewits_media_id=243394" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গাজী মাজহারুল আনোয়ারের নামে সম্মাননা চালু" /&gt;&lt;/p&gt;&lt;p&gt;কালচারাল জার্নালিস্টস ফোরাম অব বাংলাদেশ (সিজেএফবি) প্রবর্তন করেছে আধুনিক বাংলা গানের অনন্য গীতিকবি গাজী মাজহারুল আনোয়ার স্মৃতি পুরস্কার। সংগঠনের ২৫তম আসরে এই মর্যাদাপূর্ণ সম্মাননা প্রদান করা হবে বলে জানিয়েছেন সিজেএফবি সভাপতি এনাম সরকার।
এ বিষয়ে তিনি বলেন, &amp;lsquo;গাজী মাজহারুল আনোয়ারের নামে এই সম্মান&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736016/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A7%80-%E0%A6%AE%E0%A6%BE%E0%A6%9C%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A7%81%E0%A6%B2-%E0%A6%86%E0%A6%A8%E0%A7%8B%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%A8%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A7%81">দেশ রূপান্তর</source>

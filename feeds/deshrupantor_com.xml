    <item>
      <title>গাজীপুরে শ্রমিক অসন্তোষে ১১ কারখানা ছুটি, সতর্ক অবস্থানে আইনশৃঙ্খলা বাহিনী</title>
      <link>https://www.deshrupantor.com/734058/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A7%80%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95-%E0%A6%85%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8B%E0%A6%B7%E0%A7%87-%E0%A7%A7%E0%A7%A7-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%9B%E0%A7%81%E0%A6%9F%E0%A6%BF-%E0%A6%B8%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%95</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734058/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A7%80%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95-%E0%A6%85%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8B%E0%A6%B7%E0%A7%87-%E0%A7%A7%E0%A7%A7-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%9B%E0%A7%81%E0%A6%9F%E0%A6%BF-%E0%A6%B8%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%95</guid>
      <pubDate>Tue, 10 Nov 2026 13:58:01 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/6b27bdd8e35a96c409d6996a55472122-6af2ce17a347b.jpg?jadewits_media_id=241501" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/6b27bdd8e35a96c409d6996a55472122-6af2ce17a347b.jpg?jadewits_media_id=241501" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/6b27bdd8e35a96c409d6996a55472122-6af2ce17a347b.jpg?jadewits_media_id=241501" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গাজীপুরে শ্রমিক অসন্তোষে ১১ কারখানা ছুটি, সতর্ক অবস্থানে আইনশৃঙ্খলা বাহিনী" /&gt;&lt;/p&gt;&lt;p&gt;শিল্পাঞ্চল গাজীপুরে শ্রমিক অসন্তোষে ১১ টি কারখানা ছুটি দেওয়া হয়েছে। তবে বিশৃঙ্খলা এড়াতে কারখানা গেইট ও মহাসড়কের গুরুত্বপূর্ণ স্থানে সতর্ক অবস্থান নিয়ে রেখেছে আইনশৃঙ্খলা বাহিনীর সদস্য।&amp;nbsp;
খোঁজ নিয়ে জানা যায়, মঙ্গলবার (১০ নভেম্বর) সকালে শ্রমিকরা কারখানায় যোগ দেন। তবে সকাল ১০ টার পর গাজীপুর সদর উপজে&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734058/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A7%80%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95-%E0%A6%85%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8B%E0%A6%B7%E0%A7%87-%E0%A7%A7%E0%A7%A7-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%9B%E0%A7%81%E0%A6%9F%E0%A6%BF-%E0%A6%B8%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%95">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>বৈদ্যুতিক খুঁটি থেকে তার চুরি করতে গিয়ে যুবকের মৃত্যু</title>
      <link>https://www.deshrupantor.com/734057/%E0%A6%AC%E0%A7%88%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%96%E0%A7%81%E0%A6%81%E0%A6%9F%E0%A6%BF-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%97%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%95%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734057/%E0%A6%AC%E0%A7%88%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%96%E0%A7%81%E0%A6%81%E0%A6%9F%E0%A6%BF-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%97%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%95%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Tue, 10 Nov 2026 13:51:55 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2025/04/08/f0f4550b2ec75150c5f3271d8b9ccb00-67f51681ebb54.jpg?jadewits_media_id=104625" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2025/04/08/f0f4550b2ec75150c5f3271d8b9ccb00-67f51681ebb54.jpg?jadewits_media_id=104625" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2025/04/08/f0f4550b2ec75150c5f3271d8b9ccb00-67f51681ebb54.jpg?jadewits_media_id=104625" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বৈদ্যুতিক খুঁটি থেকে তার চুরি করতে গিয়ে যুবকের মৃত্যু" /&gt;&lt;/p&gt;&lt;p&gt;নরসিংদীর পলাশে বৈদ্যুতিক খুঁটি থেকে তার চুরি করতে গিয়ে বিদ্যুৎ স্পৃষ্ট হয়ে মাসুম মিয়া (২৪) নামে এক যুবকের মৃত্যু হয়েছে।
&amp;nbsp;
মঙ্গলবার (১০ নভেম্বর) বেলা ১১টার দিকে পলাশ থানা পুলিশ গিয়ে নিহতের মরদেহ উদ্ধার করেন। এর আগে সোমবার দিবাগত রাতে পলাশের গড়পাড়া গ্রামের রিজেন্ট পাওয়ার প্লান্টের সামনে সড়কের পাশ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734057/%E0%A6%AC%E0%A7%88%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%96%E0%A7%81%E0%A6%81%E0%A6%9F%E0%A6%BF-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%97%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%95%E0%A7%87%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>রামেক ছাত্রলীগের সভাপতি-সম্পাদক গ্রেপ্তার</title>

      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/5a4be61dbb410bdb20585d896fe85bc4-6af9d745b9b62.jpg?jadewits_media_id=242857" length="0" type="image/jpeg" />

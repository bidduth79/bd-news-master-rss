      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/08581ec80447a159b79dc582958594e5-6af0d714eec29.jpg?jadewits_media_id=241187" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/08581ec80447a159b79dc582958594e5-6af0d714eec29.jpg?jadewits_media_id=241187" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/08581ec80447a159b79dc582958594e5-6af0d714eec29.jpg?jadewits_media_id=241187" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রথম ধাপে ১ হাজার ৫০ ইউপিতে ভোট" /&gt;&lt;/p&gt;&lt;p&gt;স্থানীয় সরকার নির্বাচনে প্রথম ধাপে এক হাজার ৫০ ইউনিয়ন পরিষদে ভোট করতে চায় নির্বাচন কমিশন (ইসি)। আগামী ২১ জানুয়ারি থেকে শুরু হচ্ছে স্থানীয় সরকার নির্বাচন।&amp;nbsp;
যেসব ইউনিয়ন পরিষদের মেয়াদ পেরিয়ে গেছে সেগুলোকে অগ্রাধিকার দেওয়া হবে। একই সঙ্গে নির্বাচনে ইলেকট্রনিক ভোটিং মেশিন (ইভিএম) আর ব্যবহার না করার স&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/733707/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%A7%E0%A6%BE%E0%A6%AA%E0%A7%87-%E0%A7%A7-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A7%AB%E0%A7%A6-%E0%A6%87%E0%A6%89%E0%A6%AA%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AD%E0%A7%8B%E0%A6%9F">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>রাজনৈতিক দলের প্রতি সমর্থন ব্যালট বাক্সে সরকারি অফিসে নয়</title>
      <link>https://www.deshrupantor.com/733706/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A8%E0%A7%88%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF-%E0%A6%B8%E0%A6%AE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%A8-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A6%9F-%E0%A6%AC%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/733706/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A8%E0%A7%88%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF-%E0%A6%B8%E0%A6%AE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%A8-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A6%9F-%E0%A6%AC%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF</guid>
      <pubDate>Mon, 09 Nov 2026 02:09:31 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/fece3241afe69d109e053cbcbf6f2a42-6af0d6f4115fc.jpg?jadewits_media_id=241186" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/fece3241afe69d109e053cbcbf6f2a42-6af0d6f4115fc.jpg?jadewits_media_id=241186" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/fece3241afe69d109e053cbcbf6f2a42-6af0d6f4115fc.jpg?jadewits_media_id=241186" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজনৈতিক দলের প্রতি সমর্থন ব্যালট বাক্সে সরকারি অফিসে নয়" /&gt;&lt;/p&gt;&lt;p&gt;যেকোনো রাজনৈতিক দলের প্রতি প্রশাসনের কর্মকর্তাদের সমর্থন থাকাকে ব্যক্তিগতভাবে দোষের মনে করেন না প্রধানমন্ত্রী তারেক রহমান। তবে রাজনৈতিক দলের প্রতি কর্মকর্তাদের সমর্থনের প্রতিফলন সরকারি অফিসে নয়, ব্যালট বাক্সে ঘটতে হবে বলে মন্তব্য করেছেন তিনি। একই সঙ্গে সরকারি কর্মকর্তাদের দক্ষতা, সততা ও মানবিক মূল্য&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/733706/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A8%E0%A7%88%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF-%E0%A6%B8%E0%A6%AE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%A8-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A6%9F-%E0%A6%AC%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>গহিন পাহাড়ে জিম্মি বেচাকেনার হাট</title>
      <link>https://www.deshrupantor.com/733705/%E0%A6%97%E0%A6%B9%E0%A6%BF%E0%A6%A8-%E0%A6%AA%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A7%9C%E0%A7%87-%E0%A6%9C%E0%A6%BF%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%BF-%E0%A6%AC%E0%A7%87%E0%A6%9A%E0%A6%BE%E0%A6%95%E0%A7%87%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%9F</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/733705/%E0%A6%97%E0%A6%B9%E0%A6%BF%E0%A6%A8-%E0%A6%AA%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A7%9C%E0%A7%87-%E0%A6%9C%E0%A6%BF%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%BF-%E0%A6%AC%E0%A7%87%E0%A6%9A%E0%A6%BE%E0%A6%95%E0%A7%87%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%9F</guid>
      <pubDate>Mon, 09 Nov 2026 02:08:44 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/50bbbb9a9bdcf83d6a19f25354d7d292-6af0d67a012e0.jpg?jadewits_media_id=241184" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/50bbbb9a9bdcf83d6a19f25354d7d292-6af0d67a012e0.jpg?jadewits_media_id=241184" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/50bbbb9a9bdcf83d6a19f25354d7d292-6af0d67a012e0.jpg?jadewits_media_id=241184" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গহিন পাহাড়ে জিম্মি বেচাকেনার হাট" /&gt;&lt;/p&gt;&lt;p&gt;কক্সবাজারের টেকনাফের দুর্গম পাহাড়গুলো এখন আর শুধু প্রকৃতির অংশ নয়, তা পরিণত হয়েছে এক ভয়ংকর অপরাধের অভয়ারণ্যে। দীর্ঘদিন ধরে এই পাহাড়গুলোকে নিরাপদ আস্তানা বানিয়ে একাধিক সশস্ত্র চক্র চালিয়ে যাচ্ছে অপহরণ, জিম্মি বাণিজ্য, মুক্তিপণ আদায় ও মানব পাচারের মতো জঘন্য অপরাধ। গত বৃহস্পতিবার যৌথ বাহিনীর এক অভিযানে&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/733705/%E0%A6%97%E0%A6%B9%E0%A6%BF%E0%A6%A8-%E0%A6%AA%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A7%9C%E0%A7%87-%E0%A6%9C%E0%A6%BF%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%BF-%E0%A6%AC%E0%A7%87%E0%A6%9A%E0%A6%BE%E0%A6%95%E0%A7%87%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%9F">দেশ রূপান্তর</source>

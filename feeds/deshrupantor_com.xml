    <item>
      <title>প্রথম সংসদীয় ভোটে পরাজিত নেতানিয়াহুর জোট</title>
      <link>https://www.deshrupantor.com/734505/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6%E0%A7%80%E0%A7%9F-%E0%A6%AD%E0%A7%8B%E0%A6%9F%E0%A7%87-%E0%A6%AA%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%BF%E0%A6%A4-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B9%E0%A7%81%E0%A6%B0-%E0%A6%9C%E0%A7%8B%E0%A6%9F</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734505/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6%E0%A7%80%E0%A7%9F-%E0%A6%AD%E0%A7%8B%E0%A6%9F%E0%A7%87-%E0%A6%AA%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%BF%E0%A6%A4-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B9%E0%A7%81%E0%A6%B0-%E0%A6%9C%E0%A7%8B%E0%A6%9F</guid>
      <pubDate>Thu, 12 Nov 2026 01:15:15 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/542aaa8b81420fe0ad6b3015d7200c15-6af4be9df2eb1.jpg?jadewits_media_id=241922" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/542aaa8b81420fe0ad6b3015d7200c15-6af4be9df2eb1.jpg?jadewits_media_id=241922" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/542aaa8b81420fe0ad6b3015d7200c15-6af4be9df2eb1.jpg?jadewits_media_id=241922" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রথম সংসদীয় ভোটে পরাজিত নেতানিয়াহুর জোট" /&gt;&lt;/p&gt;&lt;p&gt;ইসরায়েলের প্রধানমন্ত্রী বেনিয়ামিন নেতানিয়াহুর জোট নতুন নির্বাচিত নেসেটে প্রথমবারের মতো সংসদীয় ভোটে পরাজয়ের মুখে পড়েছে। বুধবার বিরোধী দল ও আরব দলগুলোর সমর্থনে নেসেটের অ্যারেঞ্জমেন্টস কমিটি গঠনের প্রস্তাব পাস হয়েছে। খবর আনাদোলু এজেন্সি।
প্রস্তাবের পক্ষে ৬৩টি এবং বিপক্ষে ৫০টি ভোট পড়ে। গাদি আইজেনকোটের ন&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734505/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6%E0%A7%80%E0%A7%9F-%E0%A6%AD%E0%A7%8B%E0%A6%9F%E0%A7%87-%E0%A6%AA%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%BF%E0%A6%A4-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B9%E0%A7%81%E0%A6%B0-%E0%A6%9C%E0%A7%8B%E0%A6%9F">দেশ রূপান্তর</source>
    </item>

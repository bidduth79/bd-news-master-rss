      <guid isPermaLink="true">https://www.deshrupantor.com/733715/%E0%A6%B8%E0%A6%BE%E0%A6%AD%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%B6%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%BE-%E0%A6%B6%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A7%80%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8B%E0%A6%AD-%E0%A6%9B%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%AD%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87</guid>
      <pubDate>Mon, 09 Nov 2026 02:14:57 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/3a36b0854aae42d9e45d7424cf8fc87e-6af0d83be90fc.jpg?jadewits_media_id=241193" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/3a36b0854aae42d9e45d7424cf8fc87e-6af0d83be90fc.jpg?jadewits_media_id=241193" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/3a36b0854aae42d9e45d7424cf8fc87e-6af0d83be90fc.jpg?jadewits_media_id=241193" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাভার আশুলিয়া শান্ত গাজীপুরে বিক্ষোভ ছত্রভঙ্গে সাউন্ড গ্রেনেড" /&gt;&lt;/p&gt;&lt;p&gt;বেতন বৃদ্ধির দাবিতে টানা কয়েক দিনের সহিংস আন্দোলনের পর শুক্রবার সাপ্তাহিক এবং শনিবার জাতীয় বিপ্লব ও সংহতি দিবসের ছুটির পর পোশাকশ্রমিকরা কাজে যোগ দিয়েছেন। গতকাল রবিবার সপ্তাহের প্রথম কর্মদিবসে সকাল থেকেই শ্রমিকরা নিজ নিজ কারখানায় কাজে যোগ দেন। সামগ্রিকভাবে সাভার ও আশুলিয়া ছিল সম্পূর্ণ শান্ত ও স্বাভাব&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/733715/%E0%A6%B8%E0%A6%BE%E0%A6%AD%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%B6%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%BE-%E0%A6%B6%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A7%80%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8B%E0%A6%AD-%E0%A6%9B%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%AD%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>সাজেকের দুর্গম পাড়ায় সন্তান প্রসবের সময় মায়ের মৃত্যু</title>
      <link>https://www.deshrupantor.com/733714/%E0%A6%B8%E0%A6%BE%E0%A6%9C%E0%A7%87%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%97%E0%A6%AE-%E0%A6%AA%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A7%9F-%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A7%9F-%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/733714/%E0%A6%B8%E0%A6%BE%E0%A6%9C%E0%A7%87%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%97%E0%A6%AE-%E0%A6%AA%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A7%9F-%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A7%9F-%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Mon, 09 Nov 2026 02:14:30 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/08581ec80447a159b79dc582958594e5-6af0d714eec29.jpg?jadewits_media_id=241187" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/08581ec80447a159b79dc582958594e5-6af0d714eec29.jpg?jadewits_media_id=241187" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/08581ec80447a159b79dc582958594e5-6af0d714eec29.jpg?jadewits_media_id=241187" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাজেকের দুর্গম পাড়ায় সন্তান প্রসবের সময় মায়ের মৃত্যু" /&gt;&lt;/p&gt;&lt;p&gt;রাঙ্গামাটির বাঘাইছড়ি উপজেলার সাজেক ইউনিয়নের দুর্গম জৌপুই পাড়ায় সন্তান প্রসবের সময় ওয়ারেন্টি ত্রিপুরা নামে এক প্রসূতির মৃত্যু হয়েছে। গত শনিবার দুপুরে বাড়িতে সন্তান প্রসবের সময় অতিরিক্ত রক্তক্ষরণে তার মৃত্যু হয় বলে জানিয়েছেন স্থানীয়রা। তারা বলেন, চিকিৎসা সুবিধা না থাকায় বাড়িতেই প্রসবের সময় অতিরিক্ত রক&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/733714/%E0%A6%B8%E0%A6%BE%E0%A6%9C%E0%A7%87%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%97%E0%A6%AE-%E0%A6%AA%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A7%9F-%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A7%9F-%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>২০২৯ সালে মোদি সরকারের পতন</title>
      <link>https://www.deshrupantor.com/733713/%E0%A7%A8%E0%A7%A6%E0%A7%A8%E0%A7%AF-%E0%A6%B8%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%AE%E0%A7%8B%E0%A6%A6%E0%A6%BF-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%A4%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/733713/%E0%A7%A8%E0%A7%A6%E0%A7%A8%E0%A7%AF-%E0%A6%B8%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%AE%E0%A7%8B%E0%A6%A6%E0%A6%BF-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%A4%E0%A6%A8</guid>
      <pubDate>Mon, 09 Nov 2026 02:14:00 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/08581ec80447a159b79dc582958594e5-6af0d714eec29.jpg?jadewits_media_id=241187" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/08581ec80447a159b79dc582958594e5-6af0d714eec29.jpg?jadewits_media_id=241187" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/08581ec80447a159b79dc582958594e5-6af0d714eec29.jpg?jadewits_media_id=241187" style="max-width:100%;height:auto;margin-bottom:10px;" alt="২০২৯ সালে মোদি সরকারের পতন" /&gt;&lt;/p&gt;&lt;p&gt;২০২৯ সালে ভারতের লোকসভা নির্বাচনে নরেন্দ্র মোদির বিজেপি নেতৃত্বাধীন এনডিএ জোট ক্ষমতা হারাবে বলে ভবিষ্যদ্বাণী করেছেন ককরোচ জনতা পার্টির (সিজেপি) প্রতিষ্ঠাতা অভিজিৎ দীপকে। সরকার পরিবর্তনের জন্য এখন থেকেই প্রস্তুতি নেওয়ার আহ্বান জানিয়েছেন তিনি। তার মতে, নির্বাচনের মাধ্যমেই রাজনৈতিক পরিবর্তন সম্ভব। তবে &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/733713/%E0%A7%A8%E0%A7%A6%E0%A7%A8%E0%A7%AF-%E0%A6%B8%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%AE%E0%A7%8B%E0%A6%A6%E0%A6%BF-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%A4%E0%A6%A8">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>অ্যাটকোর সভাপতি অঞ্জন চৌধুরী, সম্পাদক আবদুস সালাম</title>
      <link>https://www.deshrupantor.com/733712/%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9F%E0%A6%95%E0%A7%8B%E0%A6%B0-%E0%A6%B8%E0%A6%AD%E0%A6%BE%E0%A6%AA%E0%A6%A4%E0%A6%BF-%E0%A6%85%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A6%A8-%E0%A6%9A%E0%A7%8C%E0%A6%A7%E0%A7%81%E0%A6%B0%E0%A7%80-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BE%E0%A6%A6%E0%A6%95-%E0%A6%86%E0%A6%AC%E0%A6%A6%E0%A7%81%E0%A6%B8-%E0%A6%B8%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%AE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/733712/%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9F%E0%A6%95%E0%A7%8B%E0%A6%B0-%E0%A6%B8%E0%A6%AD%E0%A6%BE%E0%A6%AA%E0%A6%A4%E0%A6%BF-%E0%A6%85%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A6%A8-%E0%A6%9A%E0%A7%8C%E0%A6%A7%E0%A7%81%E0%A6%B0%E0%A7%80-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BE%E0%A6%A6%E0%A6%95-%E0%A6%86%E0%A6%AC%E0%A6%A6%E0%A7%81%E0%A6%B8-%E0%A6%B8%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%AE</guid>
      <pubDate>Mon, 09 Nov 2026 02:13:33 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/2c08ca79cb1a738bdfe358d4f59bf9fb-6af0d7e1e4421.jpg?jadewits_media_id=241192" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/2c08ca79cb1a738bdfe358d4f59bf9fb-6af0d7e1e4421.jpg?jadewits_media_id=241192" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/2c08ca79cb1a738bdfe358d4f59bf9fb-6af0d7e1e4421.jpg?jadewits_media_id=241192" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অ্যাটকোর সভাপতি অঞ্জন চৌধুরী, সম্পাদক আবদুস সালাম" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ বেসরকারি টেলিভিশন চ্যানেলগুলোর মালিকদের সংগঠন অ্যাসোসিয়েশন অব টেলিভিশন চ্যানেল ওনার্সের (অ্যাটকো) নতুন নির্বাহী কমিটি গঠন করা হয়েছে। ২০২৬-২০২৮ মেয়াদের নবগঠিত এ কমিটিতে মাছরাঙা টেলিভিশনের অঞ্জন চৌধুরী সভাপতি ও একুশে টেলিভিশনের আবদুস সালাম সাধারণ সম্পাদক নির্বাচিত হয়েছেন। পরিচালক পদে পুনর্নির&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/733712/%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9F%E0%A6%95%E0%A7%8B%E0%A6%B0-%E0%A6%B8%E0%A6%AD%E0%A6%BE%E0%A6%AA%E0%A6%A4%E0%A6%BF-%E0%A6%85%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A6%A8-%E0%A6%9A%E0%A7%8C%E0%A6%A7%E0%A7%81%E0%A6%B0%E0%A7%80-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BE%E0%A6%A6%E0%A6%95-%E0%A6%86%E0%A6%AC%E0%A6%A6%E0%A7%81%E0%A6%B8-%E0%A6%B8%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%AE">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>কুয়াকাটার সুরক্ষিত এলাকায় বেড়েছে লাল কাঁকড়া</title>
      <link>https://www.deshrupantor.com/733711/%E0%A6%95%E0%A7%81%E0%A7%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%81%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%A4-%E0%A6%8F%E0%A6%B2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A7%87%E0%A7%9C%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%B2%E0%A6%BE%E0%A6%B2-%E0%A6%95%E0%A6%BE%E0%A6%81%E0%A6%95%E0%A7%9C%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/733711/%E0%A6%95%E0%A7%81%E0%A7%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%81%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%A4-%E0%A6%8F%E0%A6%B2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A7%87%E0%A7%9C%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%B2%E0%A6%BE%E0%A6%B2-%E0%A6%95%E0%A6%BE%E0%A6%81%E0%A6%95%E0%A7%9C%E0%A6%BE</guid>
      <pubDate>Mon, 09 Nov 2026 02:12:59 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/f9b001b9e4514db7c8153a77ef7ee96f-6af0d7c5e84bd.jpg?jadewits_media_id=241191" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/f9b001b9e4514db7c8153a77ef7ee96f-6af0d7c5e84bd.jpg?jadewits_media_id=241191" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/f9b001b9e4514db7c8153a77ef7ee96f-6af0d7c5e84bd.jpg?jadewits_media_id=241191" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কুয়াকাটার সুরক্ষিত এলাকায় বেড়েছে লাল কাঁকড়া" /&gt;&lt;/p&gt;&lt;p&gt;প্রকৃতির অনন্য উপহার কুয়াকাটা সমুদ্রসৈকত। এখানের অন্যতম আকর্ষণ সৈকতে চিকচিক করা বালিয়াড়িতে লাল কাঁকড়ার দৌড়ঝাঁপ। নিজের তৈরি বাসা থেকে বেরিয়ে ছোটাছুটি এবং পা দিয়ে নানান আকৃতির তৈরি আল্পনা পর্যটকদের আনন্দে বাড়তি মাত্রা যোগ করে। অথচ অবাধ পর্যটন, হইচই আর যানবাহনের চাকায় প্রতিনিয়ত থেঁতলে যাচ্ছিল লাল কাঁকড়&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/733711/%E0%A6%95%E0%A7%81%E0%A7%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%81%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%A4-%E0%A6%8F%E0%A6%B2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A7%87%E0%A7%9C%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%B2%E0%A6%BE%E0%A6%B2-%E0%A6%95%E0%A6%BE%E0%A6%81%E0%A6%95%E0%A7%9C%E0%A6%BE">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>এক ছেলে কবরে, আরেক ছেলে লাইফ সাপোর্টে</title>
      <link>https://www.deshrupantor.com/733710/%E0%A6%8F%E0%A6%95-%E0%A6%9B%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%95%E0%A6%AC%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%9B%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%AB-%E0%A6%B8%E0%A6%BE%E0%A6%AA%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A7%87</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/733710/%E0%A6%8F%E0%A6%95-%E0%A6%9B%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%95%E0%A6%AC%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%9B%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%AB-%E0%A6%B8%E0%A6%BE%E0%A6%AA%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A7%87</guid>
      <pubDate>Mon, 09 Nov 2026 02:12:32 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/3ec87ab1806e43396abd819f8fb39aef-6af0d7aac7a05.jpg?jadewits_media_id=241190" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/3ec87ab1806e43396abd819f8fb39aef-6af0d7aac7a05.jpg?jadewits_media_id=241190" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/3ec87ab1806e43396abd819f8fb39aef-6af0d7aac7a05.jpg?jadewits_media_id=241190" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এক ছেলে কবরে, আরেক ছেলে লাইফ সাপোর্টে" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রাম নগরীর হিলভিউ পাবলিক স্কুলের তৃতীয় শ্রেণির শিক্ষার্থী নূর মোহাম্মদ আরাফাত। ১৫-২০ দিন আগে জ্বর, বমি ও সর্দি দিয়ে শুরু হওয়া অসুস্থতা দ্রুত জটিল আকার ধারণ করে। সাউদার্ন ও ইম্পেরিয়াল হাসপাতাল ঘুরে শেষ পর্যন্ত তাকে চট্টগ্রাম মা ও শিশু হাসপাতালের আইসিইউতে নেওয়া হয়। চিকিৎসকদের সব চেষ্টা ব্যর্থ করে&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/733710/%E0%A6%8F%E0%A6%95-%E0%A6%9B%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%95%E0%A6%AC%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%9B%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%AB-%E0%A6%B8%E0%A6%BE%E0%A6%AA%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A7%87">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>নিখোঁজ জিডি থেকে তথ্য নিয়ে অপহরণ নাটক</title>
      <link>https://www.deshrupantor.com/733709/%E0%A6%A8%E0%A6%BF%E0%A6%96%E0%A7%87%E0%A6%BE%E0%A6%81%E0%A6%9C-%E0%A6%9C%E0%A6%BF%E0%A6%A1%E0%A6%BF-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%A4%E0%A6%A5%E0%A7%8D%E0%A6%AF-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%85%E0%A6%AA%E0%A6%B9%E0%A6%B0%E0%A6%A3-%E0%A6%A8%E0%A6%BE%E0%A6%9F%E0%A6%95</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/733709/%E0%A6%A8%E0%A6%BF%E0%A6%96%E0%A7%87%E0%A6%BE%E0%A6%81%E0%A6%9C-%E0%A6%9C%E0%A6%BF%E0%A6%A1%E0%A6%BF-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%A4%E0%A6%A5%E0%A7%8D%E0%A6%AF-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%85%E0%A6%AA%E0%A6%B9%E0%A6%B0%E0%A6%A3-%E0%A6%A8%E0%A6%BE%E0%A6%9F%E0%A6%95</guid>
      <pubDate>Mon, 09 Nov 2026 02:11:35 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/776a9c87fdd620891d593c93bdedda02-6af0d76f633b1.jpg?jadewits_media_id=241189" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/776a9c87fdd620891d593c93bdedda02-6af0d76f633b1.jpg?jadewits_media_id=241189" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/776a9c87fdd620891d593c93bdedda02-6af0d76f633b1.jpg?jadewits_media_id=241189" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নিখোঁজ জিডি থেকে তথ্য নিয়ে অপহরণ নাটক" /&gt;&lt;/p&gt;&lt;p&gt;নিজেদের কাছে কোনো ভুক্তভোগী না রেখেই অপহরণের নাটক সাজিয়ে পরিবারের কাছ থেকে মুক্তিপণ আদায় করত একটি অনলাইন প্রতারকচক্র। ফেসবুকে নিখোঁজের বিজ্ঞপ্তি দেখে পরিবারের সদস্যদের নম্বর সংগ্রহ করে অপহরণকারী পরিচয়ে ফোন করত চক্রের সদস্যরা। পরে ভুক্তভোগীর কণ্ঠ নকল করে মারধর ও নির্যাতনের অভিনয় করে পরিবারের কাছ থেক&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/733709/%E0%A6%A8%E0%A6%BF%E0%A6%96%E0%A7%87%E0%A6%BE%E0%A6%81%E0%A6%9C-%E0%A6%9C%E0%A6%BF%E0%A6%A1%E0%A6%BF-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%A4%E0%A6%A5%E0%A7%8D%E0%A6%AF-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%85%E0%A6%AA%E0%A6%B9%E0%A6%B0%E0%A6%A3-%E0%A6%A8%E0%A6%BE%E0%A6%9F%E0%A6%95">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>মুক্তাঙ্গনের মুক্তি নেই</title>
      <link>https://www.deshrupantor.com/733708/%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%87</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/733708/%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%87</guid>
      <pubDate>Mon, 09 Nov 2026 02:11:06 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/7c6e204401a44c4aad8e1c19dee74a3d-6af0d7519fe1d.jpg?jadewits_media_id=241188" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/7c6e204401a44c4aad8e1c19dee74a3d-6af0d7519fe1d.jpg?jadewits_media_id=241188" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/7c6e204401a44c4aad8e1c19dee74a3d-6af0d7519fe1d.jpg?jadewits_media_id=241188" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মুক্তাঙ্গনের মুক্তি নেই" /&gt;&lt;/p&gt;&lt;p&gt;একসময় গণতান্ত্রিক আন্দোলন, রাজনৈতিক বিতর্ক আর জনতার প্রতিবাদে মুখর থাকত রাজধানীর ঐতিহাসিক মুক্তাঙ্গন। সেই মুক্তাঙ্গন এখন ভাড়ার গাড়ির মালিকদের দখলে। দখলমুক্ত করার দাবিতে উচ্চ আদালতে রিট করেছেন এলাকাবাসীর প্রতিনিধি পরিচয়ে এক ব্যক্তি। অনুসন্ধানে জানা গেছে, তিনিও মুক্তাঙ্গনের একজন গাড়িচালক। জনস্বার্থের &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/733708/%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%87">দেশ রূপান্তর</source>
    </item>

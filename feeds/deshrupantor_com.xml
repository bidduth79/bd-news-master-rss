    <item>
      <title>নেশার টাকা না পেয়ে মাকে শাবলের আঘাতে হত্যা</title>
      <link>https://www.deshrupantor.com/738261/%E0%A6%A8%E0%A7%87%E0%A6%B6%E0%A6%BE%E0%A6%B0-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A7%87%E0%A7%9F%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%B6%E0%A6%BE%E0%A6%AC%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%98%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/738261/%E0%A6%A8%E0%A7%87%E0%A6%B6%E0%A6%BE%E0%A6%B0-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A7%87%E0%A7%9F%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%B6%E0%A6%BE%E0%A6%AC%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%98%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE</guid>
      <pubDate>Fri, 27 Nov 2026 02:29:40 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/b6e85798f811fe2a9479b31b8b8d707a-6b08891bd32c5.jpg?jadewits_media_id=245471" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/b6e85798f811fe2a9479b31b8b8d707a-6b08891bd32c5.jpg?jadewits_media_id=245471" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/b6e85798f811fe2a9479b31b8b8d707a-6b08891bd32c5.jpg?jadewits_media_id=245471" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নেশার টাকা না পেয়ে মাকে শাবলের আঘাতে হত্যা" /&gt;&lt;/p&gt;&lt;p&gt;বরিশালের মেহেন্দিগঞ্জে টাকা না দেওয়ায় শাবল দিয়ে পিটিয়ে মাকে হত্যার অভিযোগে রবিউল ফকির (২৩) নামে এক তরুণকে আটক করে পুলিশের হাতে তুলে দিয়েছেন স্থানীয়রা। গতকাল বৃহস্পতিবার সকাল ৯টার দিকে উপজেলার ভাষানচর ইউনিয়নের ২ নম্বর ওয়ার্ডের হাজীকান্দা এলাকায় এ ঘটনা ঘটে। কাজিরহাট থানার ওসি সিদ্দিকুর রহমান ঘটনার বিষ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/738261/%E0%A6%A8%E0%A7%87%E0%A6%B6%E0%A6%BE%E0%A6%B0-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A7%87%E0%A7%9F%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%B6%E0%A6%BE%E0%A6%AC%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%98%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>শ্যালিকাকে হত্যায় দুলাভাইয়ের মৃত্যুদন্ড</title>
      <link>https://www.deshrupantor.com/738260/%E0%A6%B6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A7%9F-%E0%A6%A6%E0%A7%81%E0%A6%B2%E0%A6%BE%E0%A6%AD%E0%A6%BE%E0%A6%87%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A6%A8%E0%A7%8D%E0%A6%A1</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/738260/%E0%A6%B6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A7%9F-%E0%A6%A6%E0%A7%81%E0%A6%B2%E0%A6%BE%E0%A6%AD%E0%A6%BE%E0%A6%87%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A6%A8%E0%A7%8D%E0%A6%A1</guid>
      <pubDate>Fri, 27 Nov 2026 02:29:09 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2023/11/01/756bedac712941f47eb46b3a34b88636-6541866731238.png?jadewits_media_id=9" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2023/11/01/756bedac712941f47eb46b3a34b88636-6541866731238.png?jadewits_media_id=9" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2023/11/01/756bedac712941f47eb46b3a34b88636-6541866731238.png?jadewits_media_id=9" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শ্যালিকাকে হত্যায় দুলাভাইয়ের মৃত্যুদন্ড" /&gt;&lt;/p&gt;&lt;p&gt;মৌলভীবাজারের কুলাউড়ায় নবম শ্রেণির শিক্ষার্থী শ্যালিকাকে হত্যা এবং স্ত্রী ও তার ছয় মাস বয়সী শিশুসন্তানকে হত্যাচেষ্টার দায়ে সালাউদ্দিন নামে এক ব্যক্তিকে মৃত্যুদন্ড দিয়েছে আদালত। একইসঙ্গে তাকে ৫০ হাজার টাকা জরিমানা করা হয়েছে। হত্যা ঘটনার ৯ বছর পর মৌলভীবাজারের অতিরিক্ত জেলা ও দায়রা জজ প্রথম আদালতের বিচা&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/738260/%E0%A6%B6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A7%9F-%E0%A6%A6%E0%A7%81%E0%A6%B2%E0%A6%BE%E0%A6%AD%E0%A6%BE%E0%A6%87%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A6%A8%E0%A7%8D%E0%A6%A1">দেশ রূপান্তর</source>
    </item>

    <item>
      <title>নিউইয়র্কে ভবনধসে নিহত অন্তত ২</title>
      <link>https://www.deshrupantor.com/734609/%E0%A6%A8%E0%A6%BF%E0%A6%89%E0%A6%87%E0%A7%9F%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A7%87-%E0%A6%AD%E0%A6%AC%E0%A6%A8%E0%A6%A7%E0%A6%B8%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A6%85%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%A4-%E0%A7%A8</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734609/%E0%A6%A8%E0%A6%BF%E0%A6%89%E0%A6%87%E0%A7%9F%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A7%87-%E0%A6%AD%E0%A6%AC%E0%A6%A8%E0%A6%A7%E0%A6%B8%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A6%85%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%A4-%E0%A7%A8</guid>
      <pubDate>Thu, 12 Nov 2026 15:07:44 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/e641382338818e8b0725a09c87820edc-6af581cae802b.jpg?jadewits_media_id=242007" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/e641382338818e8b0725a09c87820edc-6af581cae802b.jpg?jadewits_media_id=242007" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/e641382338818e8b0725a09c87820edc-6af581cae802b.jpg?jadewits_media_id=242007" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নিউইয়র্কে ভবনধসে নিহত অন্তত ২" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাষ্ট্রের নিউইয়র্ক শহরে একটি ভবন ধসে অন্তত দুজন নিহত হয়েছেন। এ ঘটনায় আহত হয়েছেন আরও ১৭ জনের বেশি। বুধবার (১১ নভেম্বর) স্থানীয় সময় বিকেল ৪টার দিকে ব্রুকলিনে নির্মাণকাজ চলা একটি স্থানের পাশে তিনতলা ভবনটি ধসে পড়ে। খবর বিবিসির।&amp;nbsp;
ভবনধসের পরপরই শুরু হয় ব্যাপক উদ্ধার অভিযান। ধ্বংসস্তূপের নিচে কেউ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734609/%E0%A6%A8%E0%A6%BF%E0%A6%89%E0%A6%87%E0%A7%9F%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A7%87-%E0%A6%AD%E0%A6%AC%E0%A6%A8%E0%A6%A7%E0%A6%B8%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A6%85%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%A4-%E0%A7%A8">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>শেরপুরে সুজনের ২ যুগপূর্তি, মাদকবিরোধী কার্যক্রমের উদ্যোগ</title>

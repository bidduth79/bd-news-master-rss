    <item>
      <title>এআই প্রতিষ্ঠান মেগাস্পিডকে কালো তালিকাভুক্ত করছে যুক্তরাষ্ট্র</title>
      <link>https://www.deshrupantor.com/737473/%E0%A6%8F%E0%A6%86%E0%A6%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A8-%E0%A6%AE%E0%A7%87%E0%A6%97%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A6%A1%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%B2%E0%A7%8B-%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%AD%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%9B%E0%A7%87</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737473/%E0%A6%8F%E0%A6%86%E0%A6%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A8-%E0%A6%AE%E0%A7%87%E0%A6%97%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A6%A1%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%B2%E0%A7%8B-%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%AD%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%9B%E0%A7%87</guid>
      <pubDate>Tue, 24 Nov 2026 10:23:34 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/c4f3df85a6f1e37b3b6d2548ebda1e25-6b0510e6563c9.png?jadewits_media_id=244756" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/c4f3df85a6f1e37b3b6d2548ebda1e25-6b0510e6563c9.png?jadewits_media_id=244756" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/c4f3df85a6f1e37b3b6d2548ebda1e25-6b0510e6563c9.png?jadewits_media_id=244756" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এআই প্রতিষ্ঠান মেগাস্পিডকে কালো তালিকাভুক্ত করছে যুক্তরাষ্ট্র" /&gt;&lt;/p&gt;&lt;p&gt;এনভিডিয়াকে ঘিরে সাম্প্রতিক বিতর্কের জেরে সিঙ্গাপুরভিত্তিক কৃত্রিম বুদ্ধিমত্তা (এআই) প্রতিষ্ঠান মেগাস্পিডকে যুক্তরাষ্ট্রে নিষিদ্ধ করার উদ্যোগ নিয়েছে মার্কিন সরকার। প্রতিষ্ঠানটির বিরুদ্ধে চীনে এনভিডিয়ার উন্নত প্রযুক্তির চিপ সরবরাহে সহায়তা করার অভিযোগ রয়েছে। খবর বিবিসি। 
যুক্তরাষ্ট্রের বাণিজ্য বিভাগ জা&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737473/%E0%A6%8F%E0%A6%86%E0%A6%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A8-%E0%A6%AE%E0%A7%87%E0%A6%97%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A6%A1%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%B2%E0%A7%8B-%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%AD%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%9B%E0%A7%87">দেশ রূপান্তর</source>

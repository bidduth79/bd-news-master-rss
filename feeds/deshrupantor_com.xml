    <item>
      <title>হাজীগঞ্জ পৌর যুবদলের যুগ্ম আহ্বায়ক বহিস্কার, যা জানা গেল</title>
      <link>https://www.deshrupantor.com/736598/%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A7%80%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C-%E0%A6%AA%E0%A7%8C%E0%A6%B0-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AF%E0%A7%81%E0%A6%97%E0%A7%8D%E0%A6%AE-%E0%A6%86%E0%A6%B9%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A6%95-%E0%A6%AC%E0%A6%B9%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AF%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736598/%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A7%80%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C-%E0%A6%AA%E0%A7%8C%E0%A6%B0-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AF%E0%A7%81%E0%A6%97%E0%A7%8D%E0%A6%AE-%E0%A6%86%E0%A6%B9%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A6%95-%E0%A6%AC%E0%A6%B9%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AF%E0%A6%BE</guid>
      <pubDate>Fri, 20 Nov 2026 16:54:53 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/8a49cf252d7419c48ab6738918fa0804-6b0026e75ede1.gif?jadewits_media_id=243932" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/8a49cf252d7419c48ab6738918fa0804-6b0026e75ede1.gif?jadewits_media_id=243932" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/8a49cf252d7419c48ab6738918fa0804-6b0026e75ede1.gif?jadewits_media_id=243932" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হাজীগঞ্জ পৌর যুবদলের যুগ্ম আহ্বায়ক বহিস্কার, যা জানা গেল" /&gt;&lt;/p&gt;&lt;p&gt;​দলীয় নীতি ও আদর্শ পরিপন্থী কর্মকাণ্ডে জড়িত থাকার অভিযোগে চাঁদপুরের হাজীগঞ্জ পৌর যুবদলের যুগ্ম আহ্বায়ক জহির আহমেদ জহিরকে প্রাথমিক সদস্য পদসহ দল থেকে বহিষ্কার করা হয়েছে।&amp;nbsp;
​শুক্রবার (২০ নভেম্বর) বাংলাদেশ জাতীয়তাবাদী যুবদলের কেন্দ্রীয় নির্বাহী কমিটির দপ্তর থেকে পাঠানো এক প্রেস বিজ্ঞপ্তিতে এ তথ্য জ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736598/%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A7%80%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C-%E0%A6%AA%E0%A7%8C%E0%A6%B0-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AF%E0%A7%81%E0%A6%97%E0%A7%8D%E0%A6%AE-%E0%A6%86%E0%A6%B9%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A6%95-%E0%A6%AC%E0%A6%B9%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AF%E0%A6%BE">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>জন্মদিনে প্রধানমন্ত্রীকে শুভেচ্ছা জানাল শিশুরা</title>
      <link>https://www.deshrupantor.com/736597/%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AE%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%B6%E0%A7%81%E0%A6%AD%E0%A7%87%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A6%BE-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B2-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736597/%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AE%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%B6%E0%A7%81%E0%A6%AD%E0%A7%87%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A6%BE-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B2-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A6%BE</guid>
      <pubDate>Fri, 20 Nov 2026 16:51:05 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/c610a211cf3446706f6f6b01f1c76f78-6b0025d147536.jpeg?jadewits_media_id=243931" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/c610a211cf3446706f6f6b01f1c76f78-6b0025d147536.jpeg?jadewits_media_id=243931" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/c610a211cf3446706f6f6b01f1c76f78-6b0025d147536.jpeg?jadewits_media_id=243931" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জন্মদিনে প্রধানমন্ত্রীকে শুভেচ্ছা জানাল শিশুরা" /&gt;&lt;/p&gt;&lt;p&gt;শুক্রবার (২০ নভেম্বর) জুমার নামাজ আদায় করতে বনানীর নৌবাহিনী কেন্দ্রীয় মসজিদে যান প্রধানমন্ত্রী তারেক রহমান। নামাজ শেষে একদল শিশু-কিশোরের সঙ্গে কিছুটা সময় কাটান তিনি। প্রধানমন্ত্রীর উপ প্রেস সচিব সুজাউদ্দৌলা (সুজন মাহমুদ) এ কথা জানিয়েছেন। 
এ সময় শিশুদের সঙ্গে আলাপচারিতায় তাদের পছন্দের খেলা সম্পর্কে জ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736597/%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AE%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%B6%E0%A7%81%E0%A6%AD%E0%A7%87%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A6%BE-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B2-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A6%BE">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>ফুটবলের চেয়ে কারাগারেই বেশি সুখী ছিলেন দানি আলভেস</title>

    <item>
      <title>দেশে কোনো লকডাউন নেই: রিজভী</title>
      <link>https://www.deshrupantor.com/738536/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%95%E0%A7%8B%E0%A6%A8%E0%A7%8B-%E0%A6%B2%E0%A6%95%E0%A6%A1%E0%A6%BE%E0%A6%89%E0%A6%A8-%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%B0%E0%A6%BF%E0%A6%9C%E0%A6%AD%E0%A7%80</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/738536/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%95%E0%A7%8B%E0%A6%A8%E0%A7%8B-%E0%A6%B2%E0%A6%95%E0%A6%A1%E0%A6%BE%E0%A6%89%E0%A6%A8-%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%B0%E0%A6%BF%E0%A6%9C%E0%A6%AD%E0%A7%80</guid>
      <pubDate>Sat, 28 Nov 2026 15:30:02 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/05/26/4f762f30bbc6cf45af2f11515af11a74-6a1595584a379.jpg?jadewits_media_id=199749" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/05/26/4f762f30bbc6cf45af2f11515af11a74-6a1595584a379.jpg?jadewits_media_id=199749" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/05/26/4f762f30bbc6cf45af2f11515af11a74-6a1595584a379.jpg?jadewits_media_id=199749" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দেশে কোনো লকডাউন নেই: রিজভী" /&gt;&lt;/p&gt;&lt;p&gt;নিষিদ্ধ সংগঠনের কর্মসূচির খবর প্রচার না করার আহ্বান জানিয়ে বিএনপির ভারপ্রাপ্ত মহাসচিব রুহুল কবির রিজভী বলেছেন, দেশে কোনো লকডাউন নেই, সবকিছু স্বাভাবিক চলছে। পালিয়ে যাওয়ার পরও শেখ হাসিনা ও পরাজিত ফ্যাসিস্ট শক্তি পার্শ্ববর্তী দেশ থেকে ইন্ধন দিয়ে দেশে অস্থিতিশীলতা তৈরির চেষ্টা করছে।’
শনিবার (২৮ নভেম্বর)&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/738536/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%95%E0%A7%8B%E0%A6%A8%E0%A7%8B-%E0%A6%B2%E0%A6%95%E0%A6%A1%E0%A6%BE%E0%A6%89%E0%A6%A8-%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%B0%E0%A6%BF%E0%A6%9C%E0%A6%AD%E0%A7%80">দেশ রূপান্তর</source>
    </item>

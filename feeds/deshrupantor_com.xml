    <item>
      <title>সিলেটে নিখোঁজ মা-মেয়ের মরদেহ মিলল সুরমায়</title>
      <link>https://www.deshrupantor.com/737850/%E0%A6%B8%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%9F%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%96%E0%A7%8B%E0%A6%81%E0%A6%9C-%E0%A6%AE%E0%A6%BE-%E0%A6%AE%E0%A7%87%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%B0%E0%A6%A6%E0%A7%87%E0%A6%B9-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2-%E0%A6%B8%E0%A7%81%E0%A6%B0%E0%A6%AE%E0%A6%BE%E0%A7%9F%C2%A0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737850/%E0%A6%B8%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%9F%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%96%E0%A7%8B%E0%A6%81%E0%A6%9C-%E0%A6%AE%E0%A6%BE-%E0%A6%AE%E0%A7%87%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%B0%E0%A6%A6%E0%A7%87%E0%A6%B9-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2-%E0%A6%B8%E0%A7%81%E0%A6%B0%E0%A6%AE%E0%A6%BE%E0%A7%9F%C2%A0</guid>
      <pubDate>Wed, 25 Nov 2026 18:16:28 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2025/04/08/765f74ff80b2b513550d590ad85c161e-67f50f5001057.jpg?jadewits_media_id=104620" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2025/04/08/765f74ff80b2b513550d590ad85c161e-67f50f5001057.jpg?jadewits_media_id=104620" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2025/04/08/765f74ff80b2b513550d590ad85c161e-67f50f5001057.jpg?jadewits_media_id=104620" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সিলেটে নিখোঁজ মা-মেয়ের মরদেহ মিলল সুরমায়" /&gt;&lt;/p&gt;&lt;p&gt;সিলেটের দক্ষিণ সুরমা নদী থেকে নিখোঁজের কয়েক ঘণ্টা পর মা ও তার ১১ মাস বয়সী মেয়ের মরদেহ উদ্ধার করেছে পুলিশ। মঙ্গলবার (২৪ নভেম্বর) রাত আড়াইটার দিকে নগরের মাছিমপুর এলাকায় সুরমা নদী থেকে মরদেহ দুটি উদ্ধার করা হয়।
নিহতরা হলেন&amp;mdash; দক্ষিণ সুরমার পিরোজপুর আবাসিক এলাকার বাসিন্দা জীবনানন্দ বিশ্বাসের স্ত্রী &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737850/%E0%A6%B8%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%9F%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%96%E0%A7%8B%E0%A6%81%E0%A6%9C-%E0%A6%AE%E0%A6%BE-%E0%A6%AE%E0%A7%87%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%B0%E0%A6%A6%E0%A7%87%E0%A6%B9-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2-%E0%A6%B8%E0%A7%81%E0%A6%B0%E0%A6%AE%E0%A6%BE%E0%A7%9F%C2%A0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>প্রাণিসম্পদকে রপ্তানিমুখী শিল্পে রূপ দেওয়ার আহ্বান প্রধানমন্ত্রীর</title>

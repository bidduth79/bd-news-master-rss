    <item>
      <title>বেড়িবাঁধের মাটি যাচ্ছে ইটভাটায়</title>
      <link>https://www.deshrupantor.com/736738/%E0%A6%AC%E0%A7%87%E0%A7%9C%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%81%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%9F%E0%A6%BF-%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%87%E0%A6%9F%E0%A6%AD%E0%A6%BE%E0%A6%9F%E0%A6%BE%E0%A7%9F</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736738/%E0%A6%AC%E0%A7%87%E0%A7%9C%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%81%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%9F%E0%A6%BF-%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%87%E0%A6%9F%E0%A6%AD%E0%A6%BE%E0%A6%9F%E0%A6%BE%E0%A7%9F</guid>
      <pubDate>Sat, 21 Nov 2026 07:12:22 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/263a6252cc290d2c26c033a88fe43e61-6b00efedc426b.jpg?jadewits_media_id=244058" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/263a6252cc290d2c26c033a88fe43e61-6b00efedc426b.jpg?jadewits_media_id=244058" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/263a6252cc290d2c26c033a88fe43e61-6b00efedc426b.jpg?jadewits_media_id=244058" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বেড়িবাঁধের মাটি যাচ্ছে ইটভাটায়" /&gt;&lt;/p&gt;&lt;p&gt;খুলনার কয়রা উপজেলার আমাদি ইউনিয়নের নাকশা গ্রামে কপোতাক্ষ নদের বেড়িবাঁধ কেটে মাটি নেওয়ার অভিযোগ উঠেছে দুটি ইটভাটার বিরুদ্ধে। স্থানীয় বাসিন্দাদের অভিযোগ, এক্সকাভেটর (ভেকু) দিয়ে বাঁধের ঢাল থেকে মাটি কেটে ইট তৈরি করা হচ্ছে। এতে বাঁধের সুরক্ষা দুর্বল হওয়ার পাশাপাশি পানি উন্নয়ন বোর্ডের (পাউবো) রাস্তা ও নদ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736738/%E0%A6%AC%E0%A7%87%E0%A7%9C%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%81%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%9F%E0%A6%BF-%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%87%E0%A6%9F%E0%A6%AD%E0%A6%BE%E0%A6%9F%E0%A6%BE%E0%A7%9F">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>৫ দিন পর এজেন্ট ব্যাংক পরিচালকের লাশ উদ্ধার</title>
      <link>https://www.deshrupantor.com/736737/%E0%A7%AB-%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%AA%E0%A6%B0-%E0%A6%8F%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%B2%E0%A6%BE%E0%A6%B6-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736737/%E0%A7%AB-%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%AA%E0%A6%B0-%E0%A6%8F%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%B2%E0%A6%BE%E0%A6%B6-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Sat, 21 Nov 2026 07:11:51 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/87db671df2b3b498feec0987d2b30dad-6b00efd087196.jpg?jadewits_media_id=244057" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/87db671df2b3b498feec0987d2b30dad-6b00efd087196.jpg?jadewits_media_id=244057" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/87db671df2b3b498feec0987d2b30dad-6b00efd087196.jpg?jadewits_media_id=244057" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৫ দিন পর এজেন্ট ব্যাংক পরিচালকের লাশ উদ্ধার" /&gt;&lt;/p&gt;&lt;p&gt;কুমিল্লা সদর দক্ষিণ উপজেলায় নিখোঁজের পাঁচ দিন পর সোশ্যাল ইসলামী ব্যাংকের এক এজেন্ট শাখার পরিচালক রেদোয়ান হোসেন রিফতের (৩৬) লাশ উদ্ধার করেছে পুলিশ। পরিবারের দাবি, চাঁদা না দেওয়ায় স্থানীয় কিশোর গ্যাং নেতা আবরাদ হাসান সজিব তাকে হত্যার পর লাশ পুকুরে ফেলে দিয়েছে। গতকাল শুক্রবার সকালে সদর দক্ষিণ উপজেলার &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736737/%E0%A7%AB-%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%AA%E0%A6%B0-%E0%A6%8F%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%B2%E0%A6%BE%E0%A6%B6-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>ভালো ফলনেও খরচ উঠছে না</title>
      <link>https://www.deshrupantor.com/736736/%E0%A6%AD%E0%A6%BE%E0%A6%B2%E0%A7%8B-%E0%A6%AB%E0%A6%B2%E0%A6%A8%E0%A7%87%E0%A6%93-%E0%A6%96%E0%A6%B0%E0%A6%9A-%E0%A6%89%E0%A6%A0%E0%A6%9B%E0%A7%87-%E0%A6%A8%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736736/%E0%A6%AD%E0%A6%BE%E0%A6%B2%E0%A7%8B-%E0%A6%AB%E0%A6%B2%E0%A6%A8%E0%A7%87%E0%A6%93-%E0%A6%96%E0%A6%B0%E0%A6%9A-%E0%A6%89%E0%A6%A0%E0%A6%9B%E0%A7%87-%E0%A6%A8%E0%A6%BE</guid>
      <pubDate>Sat, 21 Nov 2026 07:11:26 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/1287d0c5c464e04df6dff099967ac725-6b00efa87c3c1.jpg?jadewits_media_id=244056" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/1287d0c5c464e04df6dff099967ac725-6b00efa87c3c1.jpg?jadewits_media_id=244056" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/1287d0c5c464e04df6dff099967ac725-6b00efa87c3c1.jpg?jadewits_media_id=244056" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভালো ফলনেও খরচ উঠছে না" /&gt;&lt;/p&gt;&lt;p&gt;রোদ-বৃষ্টি উপেক্ষা করে মাঠে সোনালি ফসল ফলালেও কৃষকের মুখে হাসি নেই। চলতি মৌসুমে আমন ধানের বাম্পার ফলন হলেও সার, কীটনাশক ও ডিজেলের বাড়তি দাম এবং বাজারে ধানের নিম্নমুখী দামের কারণে লোকসানে পড়েছেন চাষিরা। উৎপাদন খরচ তুলতে না পেরে প্রতি পাকি (২৬ শতাংশ) জমিতে কৃষকদের ৪ থেকে ৮ হাজার টাকা পর্যন্ত লোকসান গু&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736736/%E0%A6%AD%E0%A6%BE%E0%A6%B2%E0%A7%8B-%E0%A6%AB%E0%A6%B2%E0%A6%A8%E0%A7%87%E0%A6%93-%E0%A6%96%E0%A6%B0%E0%A6%9A-%E0%A6%89%E0%A6%A0%E0%A6%9B%E0%A7%87-%E0%A6%A8%E0%A6%BE">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>‘নিজের জীবনের হিসাবটা বড্ড এলোমেলো’</title>
      <link>https://www.deshrupantor.com/736735/%E2%80%98%E0%A6%A8%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A7%80%E0%A6%AC%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%BF%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A6%9F%E0%A6%BE-%E0%A6%AC%E0%A6%A1%E0%A7%8D%E0%A6%A1-%E0%A6%8F%E0%A6%B2%E0%A7%8B%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A7%8B%E2%80%99</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736735/%E2%80%98%E0%A6%A8%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A7%80%E0%A6%AC%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%BF%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A6%9F%E0%A6%BE-%E0%A6%AC%E0%A6%A1%E0%A7%8D%E0%A6%A1-%E0%A6%8F%E0%A6%B2%E0%A7%8B%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A7%8B%E2%80%99</guid>
      <pubDate>Sat, 21 Nov 2026 07:10:50 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/c228d17ed3eab2610851b4e51866e48e-6b00ef9323325.jpg?jadewits_media_id=244055" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/c228d17ed3eab2610851b4e51866e48e-6b00ef9323325.jpg?jadewits_media_id=244055" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/c228d17ed3eab2610851b4e51866e48e-6b00ef9323325.jpg?jadewits_media_id=244055" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘নিজের জীবনের হিসাবটা বড্ড এলোমেলো’" /&gt;&lt;/p&gt;&lt;p&gt;একসময় সরকারি ব্যাংকের হিসাবের খাতায় নিখুঁত অঙ্ক মেলালেও নিজের জীবনের হিসাবটাই আজ বড্ড এলোমেলো সাবেক ব্যাংকার সালেহা আক্তারের। মানসিক ভারসাম্য হারিয়ে দীর্ঘ ১৬ বছর পায়ে শেকল পরে বন্দি জীবন কাটছে তার। একই নিয়তির শিকার তার সন্তান বরাতুল মোস্তাকিনও। পবিত্র কুরআনের ১৮ পারা মুখস্থ করা মেধাবী ছেলেটিও আজ মান&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736735/%E2%80%98%E0%A6%A8%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A7%80%E0%A6%AC%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%BF%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A6%9F%E0%A6%BE-%E0%A6%AC%E0%A6%A1%E0%A7%8D%E0%A6%A1-%E0%A6%8F%E0%A6%B2%E0%A7%8B%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A7%8B%E2%80%99">দেশ রূপান্তর</source>
    </item>

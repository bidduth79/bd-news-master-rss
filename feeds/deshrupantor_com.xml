      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/d498efe9043b344f356fc821b21f2d67-6af0d8bb95d2b.jpg?jadewits_media_id=241194" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/d498efe9043b344f356fc821b21f2d67-6af0d8bb95d2b.jpg?jadewits_media_id=241194" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/d498efe9043b344f356fc821b21f2d67-6af0d8bb95d2b.jpg?jadewits_media_id=241194" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নজরদারিতে ঢাকা-চট্টগ্রাম মহাসড়কের ১৪ পয়েন্ট" /&gt;&lt;/p&gt;&lt;p&gt;ডিসেম্বর সামনে রেখে ঢাকা-চট্টগ্রাম মহাসড়কের কুমিল্লা অংশে নাশকতার আশঙ্কা করছে আইনশৃঙ্খলা রক্ষাকারী বাহিনী। মহাসড়ক অচল করে দিতে যানবাহন ভাঙচুর, ককটেল নিক্ষেপ ও অগ্নিসংযোগের পরিকল্পনার তথ্য পেয়েছে গোয়েন্দা সংস্থাগুলো। এ জন্য মহাসড়কের অন্তত ১৪টি স্থানকে ঝুঁকিপূর্ণ হিসেবে চিহ্নিত করে নজরদারি বাড়ানো হয়েছ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/733717/%E0%A6%A8%E0%A6%9C%E0%A6%B0%E0%A6%A6%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%9A%E0%A6%9F%E0%A7%8D%E0%A6%9F%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A7%9C%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A7%A7%E0%A7%AA-%E0%A6%AA%E0%A7%9F%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F">দেশ রূপান্তর</source>

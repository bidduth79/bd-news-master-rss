      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/d304dfa80d828072380cfdc497ee7646-6af5e8153814d.jpg?jadewits_media_id=242120" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/d304dfa80d828072380cfdc497ee7646-6af5e8153814d.jpg?jadewits_media_id=242120" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/d304dfa80d828072380cfdc497ee7646-6af5e8153814d.jpg?jadewits_media_id=242120" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কুমিল্লায় চেয়ারম্যান প্রার্থী নিয়ে বিরোধ, এমপির সংবর্ধনা অনুষ্ঠানে সংঘর্ষে আহত ১৫" /&gt;&lt;/p&gt;&lt;p&gt;কুমিল্লার হোমনায় সংসদ সদস্য অধ্যক্ষ মো. সেলিম ভূইয়াকে সংবর্ধনা দেওয়ার অনুষ্ঠানে বিএনপির দুই পক্ষের সমর্থকদের মধ্যে সংঘর্ষের ঘটনা ঘটেছে। এতে উভয় পক্ষের অন্তত ১৫ জন আহত হয়েছেন। আহত ব্যক্তিদের উদ্ধার করে দাউদকান্দি উপজেলা স্বাস্থ্য কমপ্লেক্সের গৌরীপুর শাখায় নেওয়া হয়েছে।
বৃহস্পতিবার (১২ নভেম্বর) বিকেলে &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734720/%E0%A6%95%E0%A7%81%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%9A%E0%A7%87%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF%E0%A6%B0">দেশ রূপান্তর</source>

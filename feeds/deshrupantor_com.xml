    <item>
      <title>নতুন এফটিপিতে বড় দলগুলোর বিপক্ষে ম্যাচ খেলবে বাংলাদেশ, জানালেন তামিম</title>
      <link>https://www.deshrupantor.com/737055/%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%8F%E0%A6%AB%E0%A6%9F%E0%A6%BF%E0%A6%AA%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A7%9C-%E0%A6%A6%E0%A6%B2%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A7%8B%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87-%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9A-%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A6%AC%E0%A7%87</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737055/%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%8F%E0%A6%AB%E0%A6%9F%E0%A6%BF%E0%A6%AA%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A7%9C-%E0%A6%A6%E0%A6%B2%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A7%8B%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87-%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9A-%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A6%AC%E0%A7%87</guid>
      <pubDate>Sun, 22 Nov 2026 16:43:54 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/d8f1b671460cf3d154d78799942d4c1a-6b02c737452b9.jpg?jadewits_media_id=244385" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/d8f1b671460cf3d154d78799942d4c1a-6b02c737452b9.jpg?jadewits_media_id=244385" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/d8f1b671460cf3d154d78799942d4c1a-6b02c737452b9.jpg?jadewits_media_id=244385" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নতুন এফটিপিতে বড় দলগুলোর বিপক্ষে ম্যাচ খেলবে বাংলাদেশ, জানালেন তামিম" /&gt;&lt;/p&gt;&lt;p&gt;পাকিস্তান ও শ্রীলঙ্কাকে নিয়ে দেশের মাটিতে ত্রিদেশীয় ওয়ানডে সিরিজ আয়োজনের উদ্যোগ নিয়েছে বাংলাদেশ ক্রিকেট বোর্ড (বিসিবি)। ২০২৭ সালের এশিয়া কাপের আগে হবে এই টুর্নামেন্ট। এ বিষয়ে পাকিস্তান ও শ্রীলঙ্কা ক্রিকেট বোর্ডে ইতিবাচক সাড়া দিয়েছে। তবে এখনো চূড়ান্ত সিদ্ধান্ত আসেনি। শুধু এই সিরিজ আয়োজনই নয়, বাংলাদেশ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737055/%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%8F%E0%A6%AB%E0%A6%9F%E0%A6%BF%E0%A6%AA%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A7%9C-%E0%A6%A6%E0%A6%B2%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A7%8B%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87-%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9A-%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A6%AC%E0%A7%87">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>এসএসসির রেজাল্ট জালিয়াতির অভিযোগে গ্রেপ্তার ৩</title>
      <link>https://www.deshrupantor.com/737054/%E0%A6%8F%E0%A6%B8%E0%A6%8F%E0%A6%B8%E0%A6%B8%E0%A6%BF%E0%A6%B0-%E0%A6%B0%E0%A7%87%E0%A6%9C%E0%A6%BE%E0%A6%B2%E0%A7%8D%E0%A6%9F-%E0%A6%9C%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%87-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A7%A9</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737054/%E0%A6%8F%E0%A6%B8%E0%A6%8F%E0%A6%B8%E0%A6%B8%E0%A6%BF%E0%A6%B0-%E0%A6%B0%E0%A7%87%E0%A6%9C%E0%A6%BE%E0%A6%B2%E0%A7%8D%E0%A6%9F-%E0%A6%9C%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%87-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A7%A9</guid>
      <pubDate>Sun, 22 Nov 2026 16:39:34 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/8636dd19a8bb273061115d5f63614dd6-6b02c6359ae09.jpg?jadewits_media_id=244384" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/8636dd19a8bb273061115d5f63614dd6-6b02c6359ae09.jpg?jadewits_media_id=244384" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/8636dd19a8bb273061115d5f63614dd6-6b02c6359ae09.jpg?jadewits_media_id=244384" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এসএসসির রেজাল্ট জালিয়াতির অভিযোগে গ্রেপ্তার ৩" /&gt;&lt;/p&gt;&lt;p&gt;২০২৬ সালের এসএসসি পরীক্ষার ফল জালিয়াতির মাধ্যমে এক পরীক্ষার্থীর ১১টি বিষয়ের নম্বর বাড়িয়ে দেওয়ার অভিযোগে তিনজনকে গ্রেপ্তার করেছে পুলিশের অপরাধ তদন্ত বিভাগ (সিআইডি)। গত ১৮ নভেম্বর রাত ১০টার দিকে চট্টগ্রাম মহানগরীর পাঁচলাইশ থানা এলাকায় অভিযান চালিয়ে তাদের গ্রেপ্তার করা হয়।
গ্রেপ্তার ব্যক্তিরা হলেন চট্ট&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737054/%E0%A6%8F%E0%A6%B8%E0%A6%8F%E0%A6%B8%E0%A6%B8%E0%A6%BF%E0%A6%B0-%E0%A6%B0%E0%A7%87%E0%A6%9C%E0%A6%BE%E0%A6%B2%E0%A7%8D%E0%A6%9F-%E0%A6%9C%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%87-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A7%A9">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>রোহিঙ্গা সংকট : যে পথ দেখিয়েছে আইসিজে</title>
      <link>https://www.deshrupantor.com/737053/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%B8%E0%A6%82%E0%A6%95%E0%A6%9F-%E0%A6%AF%E0%A7%87-%E0%A6%AA%E0%A6%A5-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%86%E0%A6%87%E0%A6%B8%E0%A6%BF%E0%A6%9C%E0%A7%87</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737053/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%B8%E0%A6%82%E0%A6%95%E0%A6%9F-%E0%A6%AF%E0%A7%87-%E0%A6%AA%E0%A6%A5-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%86%E0%A6%87%E0%A6%B8%E0%A6%BF%E0%A6%9C%E0%A7%87</guid>
      <pubDate>Sun, 22 Nov 2026 16:35:55 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/f0671c128fa2aa9c390d675f9ed5ed85-6b02c57942e5b.jpg?jadewits_media_id=244381" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/f0671c128fa2aa9c390d675f9ed5ed85-6b02c57942e5b.jpg?jadewits_media_id=244381" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/f0671c128fa2aa9c390d675f9ed5ed85-6b02c57942e5b.jpg?jadewits_media_id=244381" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রোহিঙ্গা সংকট : যে পথ দেখিয়েছে আইসিজে" /&gt;&lt;/p&gt;&lt;p&gt;রোহিঙ্গা সংকট কেবল দক্ষিণ-পূর্ব এশিয়া নয়; পুরো বিশ্বে একটি আলোচিত মানবিক ও আন্তঃরাষ্ট্রীয় ইস্যু। বিশেষত রোহিঙ্গা সংকট বাংলাদেশের জন্য একদিকে মানবিক সমস্যা, অন্যদিকে এটি এদেশের জাতীয় নিরাপত্তা, অর্থনীতি, পরিবেশ, সামাজিক স্থিতিশীলতা এবং আঞ্চলিক ভূরাজনীতির সঙ্গে গভীরভাবে সম্পর্কিত। বাস্তুচ্যুত বিপুলসংখ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737053/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%B8%E0%A6%82%E0%A6%95%E0%A6%9F-%E0%A6%AF%E0%A7%87-%E0%A6%AA%E0%A6%A5-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%86%E0%A6%87%E0%A6%B8%E0%A6%BF%E0%A6%9C%E0%A7%87">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>কমনওয়েলথ পার্লামেন্টারি অ্যাসোসিয়েশনের মহাসচিবের সঙ্গে চীফ হুইপের বৈঠক</title>
      <link>https://www.deshrupantor.com/737052/%E0%A6%95%E0%A6%AE%E0%A6%A8%E0%A6%93%E0%A7%9F%E0%A7%87%E0%A6%B2%E0%A6%A5-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B8%E0%A7%8B%E0%A6%B8%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%B6%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%9A%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737052/%E0%A6%95%E0%A6%AE%E0%A6%A8%E0%A6%93%E0%A7%9F%E0%A7%87%E0%A6%B2%E0%A6%A5-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B8%E0%A7%8B%E0%A6%B8%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%B6%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%9A%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Sun, 22 Nov 2026 16:23:47 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/35ad68890d9fbe802519a8ed2dc27a13-6b02c25395ff9.jpeg?jadewits_media_id=244380" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/35ad68890d9fbe802519a8ed2dc27a13-6b02c25395ff9.jpeg?jadewits_media_id=244380" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/35ad68890d9fbe802519a8ed2dc27a13-6b02c25395ff9.jpeg?jadewits_media_id=244380" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কমনওয়েলথ পার্লামেন্টারি অ্যাসোসিয়েশনের মহাসচিবের সঙ্গে চীফ হুইপের বৈঠক" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাজ&amp;zwnj;্য পার্লামেন্টে বাংলাদেশ জাতীয় সংসদের চীফ হুইপ নূরুল ইসলাম মনির সঙ্গে কমনওয়েলথ পার্লামেন্টারি অ্যাসোসিয়েশনের (সিপিএ) মহাসচিব স্টিফেন টুইগের গত ২০ নভেম্বর (শুক্রবার) একটি বৈঠক অনুষ্ঠিত হয়েছে।&amp;nbsp;
বৈঠকে বাংলাদেশ জাতীয় সংসদের সঙ্গে সিপিএ-এর চলমান ও ভবিষ্যৎ সহযোগিতা সম্প্রসারণ, সংসদীয় কা&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737052/%E0%A6%95%E0%A6%AE%E0%A6%A8%E0%A6%93%E0%A7%9F%E0%A7%87%E0%A6%B2%E0%A6%A5-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B8%E0%A7%8B%E0%A6%B8%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%B6%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%9A%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%B0">দেশ রূপান্তর</source>

      <guid isPermaLink="true">https://www.deshrupantor.com/735088/%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A7%80%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A6%A8%E0%A6%BF-%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%A5%E0%A6%A8%E0%A7%87-%E0%A6%85%E0%A6%82%E0%A6%B6-%E0%A6%A8%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A7%AE%E0%A7%A6%E0%A7%A6-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%80</guid>
      <pubDate>Sat, 14 Nov 2026 15:39:03 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/a692075d41b51c4260fad03891dd8335-6af82c1d3250f.jpg?jadewits_media_id=242469" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/a692075d41b51c4260fad03891dd8335-6af82c1d3250f.jpg?jadewits_media_id=242469" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/a692075d41b51c4260fad03891dd8335-6af82c1d3250f.jpg?jadewits_media_id=242469" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হাজীগঞ্জে মিনি ম্যারাথনে অংশ নিলেন ৮০০ প্রতিযোগী" /&gt;&lt;/p&gt;&lt;p&gt;চাঁদপুরের হাজীগঞ্জে প্রথমবারের মতো অনুষ্ঠিত হয়েছে ৬ কিলোমিটার মিনি ম্যারাথন-২০২৬। &amp;lsquo;সুস্থতার জন্য দৌড়&amp;rsquo; স্লোগানে উপজেলা প্রশাসন ও উপজেলা ক্রীড়া সংস্থার যৌথ উদ্যোগে শনিবার (১৪ নভেম্বর) ভোরে এ প্রতিযোগিতার আয়োজন করা হয়। এতে বিভিন্ন বয়সী প্রায় ৮০০ প্রতিযোগী অংশ নেন।
সকালে উপজেলা পরিষদ চত্বর থ&lt;/p&gt;</description>

    <item>
      <title>ভাসমান বেডে কোটি টাকার চারা</title>
      <link>https://www.deshrupantor.com/734268/%E0%A6%AD%E0%A6%BE%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%AC%E0%A7%87%E0%A6%A1%E0%A7%87-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734268/%E0%A6%AD%E0%A6%BE%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%AC%E0%A7%87%E0%A6%A1%E0%A7%87-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A6%BE</guid>
      <pubDate>Wed, 11 Nov 2026 07:37:00 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/8c02e6377130df7807974751d7ffccd9-6af3c4304999b.jpg?jadewits_media_id=241704" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/8c02e6377130df7807974751d7ffccd9-6af3c4304999b.jpg?jadewits_media_id=241704" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/8c02e6377130df7807974751d7ffccd9-6af3c4304999b.jpg?jadewits_media_id=241704" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভাসমান বেডে কোটি টাকার চারা" /&gt;&lt;/p&gt;&lt;p&gt;পানির ওপর কচুরিপানা জমিয়ে বিশেষ পদ্ধতিতে তৈরি করা &amp;lsquo;ধাপ&amp;rsquo; বা ভাসমান বেডে ফলানো হচ্ছে দেশি-বিদেশি নানা জাতের সবজি ও চারা। এতে বদলে যাচ্ছে পিরোজপুরের নাজিরপুরের নারী-পুরুষের একদল কৃষকের জীবন। নাজিরপুর ও এর পার্শ্ববর্তী নেছারাবাদ (স্বরূপকাঠি) উপজেলার শত শত একর জলমহাল জুড়ে এখন শুধু সবুজের সমার&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734268/%E0%A6%AD%E0%A6%BE%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%AC%E0%A7%87%E0%A6%A1%E0%A7%87-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A6%BE">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>তিন বছরের রেকর্ড ভেঙে চট্টগ্রামে ডেঙ্গুর ভয়াবহ রূপ</title>
      <link>https://www.deshrupantor.com/734274/%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A1-%E0%A6%AD%E0%A7%87%E0%A6%99%E0%A7%87-%E0%A6%9A%E0%A6%9F%E0%A7%8D%E0%A6%9F%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%A1%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%81%E0%A6%B0-%E0%A6%AD%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A6%B9-%E0%A6%B0%E0%A7%82%E0%A6%AA</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734274/%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A1-%E0%A6%AD%E0%A7%87%E0%A6%99%E0%A7%87-%E0%A6%9A%E0%A6%9F%E0%A7%8D%E0%A6%9F%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%A1%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%81%E0%A6%B0-%E0%A6%AD%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A6%B9-%E0%A6%B0%E0%A7%82%E0%A6%AA</guid>
      <pubDate>Wed, 11 Nov 2026 07:27:56 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/4511c02e014b3ac3184fdb377db1f339-6af36cf0080dc.jpg?jadewits_media_id=241681" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/4511c02e014b3ac3184fdb377db1f339-6af36cf0080dc.jpg?jadewits_media_id=241681" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/4511c02e014b3ac3184fdb377db1f339-6af36cf0080dc.jpg?jadewits_media_id=241681" style="max-width:100%;height:auto;margin-bottom:10px;" alt="তিন বছরের রেকর্ড ভেঙে চট্টগ্রামে ডেঙ্গুর ভয়াবহ রূপ" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রামে ডেঙ্গু পরিস্থিতি মারাত্মক রূপ ধারণ করেছে। বিগত তিন বছরের রেকর্ড ভেঙে চলতি ২০২৬ সালে জেলায় ডেঙ্গুতে আক্রান্তের সংখ্যা সর্বোচ্চ চূড়ায় পৌঁছেছে। বিশেষ করে বছরের শেষভাগে এসে আগস্ট, সেপ্টেম্বর ও অক্টোবরে সংক্রমণের হারের যে তীব্রতা দেখা গেছে, তা অতীতের যেকোনো সময়কে ছাড়িয়ে গেছে। স্বাস্থ্য খাত-স&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734274/%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A1-%E0%A6%AD%E0%A7%87%E0%A6%99%E0%A7%87-%E0%A6%9A%E0%A6%9F%E0%A7%8D%E0%A6%9F%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%A1%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%81%E0%A6%B0-%E0%A6%AD%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A6%B9-%E0%A6%B0%E0%A7%82%E0%A6%AA">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>সনদসর্বস্ব জ্ঞান দিয়ে দেশের প্রকৃত উন্নয়ন সম্ভব নয়</title>
      <link>https://www.deshrupantor.com/734273/%E0%A6%B8%E0%A6%A8%E0%A6%A6%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%AC-%E0%A6%9C%E0%A7%8D%E0%A6%9E%E0%A6%BE%E0%A6%A8-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A7%83%E0%A6%A4-%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A7%9F%E0%A6%A8-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AD%E0%A6%AC-%E0%A6%A8%E0%A7%9F</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734273/%E0%A6%B8%E0%A6%A8%E0%A6%A6%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%AC-%E0%A6%9C%E0%A7%8D%E0%A6%9E%E0%A6%BE%E0%A6%A8-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A7%83%E0%A6%A4-%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A7%9F%E0%A6%A8-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AD%E0%A6%AC-%E0%A6%A8%E0%A7%9F</guid>
      <pubDate>Wed, 11 Nov 2026 07:27:37 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/4511c02e014b3ac3184fdb377db1f339-6af36cf0080dc.jpg?jadewits_media_id=241681" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/4511c02e014b3ac3184fdb377db1f339-6af36cf0080dc.jpg?jadewits_media_id=241681" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/4511c02e014b3ac3184fdb377db1f339-6af36cf0080dc.jpg?jadewits_media_id=241681" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সনদসর্বস্ব জ্ঞান দিয়ে দেশের প্রকৃত উন্নয়ন সম্ভব নয়" /&gt;&lt;/p&gt;&lt;p&gt;কেবল সনদসর্বস্ব জ্ঞান দিয়ে ব্যক্তি বা দেশের প্রকৃত উন্নয়ন সম্ভব নয় বলে মন্তব্য করেছেন রাষ্ট্রপতি মির্জা ফখরুল ইসলাম আলমগীর। তিনি শিক্ষার্থীদের উদ্দেশে বলেন, অর্জিত শিক্ষা ও দক্ষতাকে দেশ ও মানুষের কল্যাণে কাজে লাগাতে হবে। দেশের সাধারণ মানুষের স্বার্থকে সর্বোচ্চ গুরুত্ব দিতে হবে। যাদের শ্রম ও অবদানে &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734273/%E0%A6%B8%E0%A6%A8%E0%A6%A6%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%AC-%E0%A6%9C%E0%A7%8D%E0%A6%9E%E0%A6%BE%E0%A6%A8-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A7%83%E0%A6%A4-%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A7%9F%E0%A6%A8-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AD%E0%A6%AC-%E0%A6%A8%E0%A7%9F">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>হুমায়ূন আহমেদের গল্প ও গান নিয়ে ‘চাঁদনী পসরে’</title>
      <link>https://www.deshrupantor.com/734272/%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A7%82%E0%A6%A8-%E0%A6%86%E0%A6%B9%E0%A6%AE%E0%A7%87%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A6%B2%E0%A7%8D%E0%A6%AA-%E0%A6%93-%E0%A6%97%E0%A6%BE%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E2%80%98%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%A8%E0%A7%80-%E0%A6%AA%E0%A6%B8%E0%A6%B0%E0%A7%87%E2%80%99</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734272/%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A7%82%E0%A6%A8-%E0%A6%86%E0%A6%B9%E0%A6%AE%E0%A7%87%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A6%B2%E0%A7%8D%E0%A6%AA-%E0%A6%93-%E0%A6%97%E0%A6%BE%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E2%80%98%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%A8%E0%A7%80-%E0%A6%AA%E0%A6%B8%E0%A6%B0%E0%A7%87%E2%80%99</guid>
      <pubDate>Wed, 11 Nov 2026 07:27:14 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/4511c02e014b3ac3184fdb377db1f339-6af36cf0080dc.jpg?jadewits_media_id=241681" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/4511c02e014b3ac3184fdb377db1f339-6af36cf0080dc.jpg?jadewits_media_id=241681" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/4511c02e014b3ac3184fdb377db1f339-6af36cf0080dc.jpg?jadewits_media_id=241681" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হুমায়ূন আহমেদের গল্প ও গান নিয়ে ‘চাঁদনী পসরে’" /&gt;&lt;/p&gt;&lt;p&gt;কথাসাহিত্যিক হুমায়ূন আহমেদের ছোটগল্প ও তার সাহিত্যকর্মে ব্যবহৃত গানের সমন্বয়ে হতে যাচ্ছে বিশেষ শ্রুতি আবৃত্তি অনুষ্ঠান &amp;lsquo;চাঁদনী পসরে&amp;rsquo;। আগামী ১৩ নভেম্বর শুক্রবার সন্ধ্যা ৬টায় বাংলাদেশ শিল্পকলা একাডেমির এক্সপেরিমেন্টাল থিয়েটার হলে অনুষ্ঠিত হবে এ আয়োজন। অনুষ্ঠানটির মিডিয়া পার্টনার হিসেবে রয়ে&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734272/%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A7%82%E0%A6%A8-%E0%A6%86%E0%A6%B9%E0%A6%AE%E0%A7%87%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A6%B2%E0%A7%8D%E0%A6%AA-%E0%A6%93-%E0%A6%97%E0%A6%BE%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E2%80%98%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%A8%E0%A7%80-%E0%A6%AA%E0%A6%B8%E0%A6%B0%E0%A7%87%E2%80%99">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>শ্রীমঙ্গলে ছাত্রশক্তির নেতার ওপর হামলা</title>

    <item>
      <title>আতঙ্কে দিন কাটছে শ্রুতির</title>
      <link>https://www.deshrupantor.com/735321/%E0%A6%86%E0%A6%A4%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A7%87-%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%95%E0%A6%BE%E0%A6%9F%E0%A6%9B%E0%A7%87-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%A4%E0%A6%BF%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735321/%E0%A6%86%E0%A6%A4%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A7%87-%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%95%E0%A6%BE%E0%A6%9F%E0%A6%9B%E0%A7%87-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%A4%E0%A6%BF%E0%A6%B0</guid>
      <pubDate>Sun, 15 Nov 2026 14:15:38 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/cea49cf3463493c1254d04612dd034e7-6af96965155c4.jpg?jadewits_media_id=242724" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/cea49cf3463493c1254d04612dd034e7-6af96965155c4.jpg?jadewits_media_id=242724" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/cea49cf3463493c1254d04612dd034e7-6af96965155c4.jpg?jadewits_media_id=242724" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আতঙ্কে দিন কাটছে শ্রুতির" /&gt;&lt;/p&gt;&lt;p&gt;নিজ বাড়িতে রহস্যময় ঘটনা এক ঘটে যাওয়ায় আতঙ্কে দিন কাটছে দক্ষিণী তারকা শ্রুতি হাসানের। জানা গেছে, অভিনেত্রীর মুম্বাইয়ের বাড়িতে রাখা একটি ম্যানিকুইন (প্লাস্টিকের মানবদেহ) নাকি নিজে থেকেই জায়গা বদলাত! এমন অদ্ভুত অভিজ্ঞতার কথা জানিয়েছেন অভিনেত্রী। শেষ পর্যন্ত আতঙ্কে ম্যানিকুইনটি খুলে ফেলতে বাধ্য হন তিনি।&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735321/%E0%A6%86%E0%A6%A4%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A7%87-%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%95%E0%A6%BE%E0%A6%9F%E0%A6%9B%E0%A7%87-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%A4%E0%A6%BF%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>অভিষেকে প্রথম বলেই আউটের বিব্রতকর রেকর্ড রবিনের</title>
      <link>https://www.deshrupantor.com/735320/%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%B7%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%AC%E0%A6%B2%E0%A7%87%E0%A6%87-%E0%A6%86%E0%A6%89%E0%A6%9F-%E0%A6%B0%E0%A6%AC%E0%A6%BF%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735320/%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%B7%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%AC%E0%A6%B2%E0%A7%87%E0%A6%87-%E0%A6%86%E0%A6%89%E0%A6%9F-%E0%A6%B0%E0%A6%AC%E0%A6%BF%E0%A6%A8</guid>

      <guid isPermaLink="true">https://www.deshrupantor.com/737978/%E0%A6%86%E0%A6%97%E0%A6%B0%E0%A6%A4%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%86%E0%A6%96%E0%A6%BE%E0%A6%89%E0%A7%9C%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8</guid>
      <pubDate>Thu, 26 Nov 2026 01:33:09 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/3667ccbab75c23774d98891aa0a23323-6b0737d25cc74.jpg?jadewits_media_id=245265" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/3667ccbab75c23774d98891aa0a23323-6b0737d25cc74.jpg?jadewits_media_id=245265" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/3667ccbab75c23774d98891aa0a23323-6b0737d25cc74.jpg?jadewits_media_id=245265" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আগরতলায় আ.লীগের নেতারা, আখাউড়ায় বিএনপির অবস্থান" /&gt;&lt;/p&gt;&lt;p&gt;কার্যক্রম নিষিদ্ধ আওয়ামী লীগের একটি প্রতিনিধি দলের আগরতলা স্থলবন্দর পরিদর্শনের খবর ছড়িয়ে পড়লে বাংলাদেশের সীমান্তবর্তী আখাউড়া স্থলবন্দরে অবস্থান নিয়ে বিক্ষোভ করেছেন বিএনপির নেতাকর্মীরা। ব্রাহ্মণবাড়িয়া জেলা বিএনপির সাধারণ সম্পাদক আলহাজ সিরাজুল ইসলাম ও আখাউড়া উপজেলা বিএনপির সভাপতি জয়নাল আবেদীন আব্দুর ন&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737978/%E0%A6%86%E0%A6%97%E0%A6%B0%E0%A6%A4%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%86%E0%A6%96%E0%A6%BE%E0%A6%89%E0%A7%9C%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8">দেশ রূপান্তর</source>

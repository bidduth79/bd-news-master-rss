      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2023/11/01/756bedac712941f47eb46b3a34b88636-6541866731238.png?jadewits_media_id=9" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মজুরি নিয়ে বিজিএমইএর আপত্তির ব্যাখ্যা সিপিডির" /&gt;&lt;/p&gt;&lt;p&gt;তৈরি পোশাকশ্রমিকদের ন্যূনতম মজুরি নির্ধারণ নিয়ে পোশাক মালিকদের সংগঠন বিজিএমইএর পর্যবেক্ষণ ও আপত্তির জবাব দিয়েছে সেন্টার ফর পলিসি ডায়ালগ (সিপিডি)। সংস্থাটি মনে করে, সঠিক ও হালনাগাদ তথ্যের ভিত্তিতে ন্যূনতম মজুরি নির্ধারণ করা উচিত। গতকাল রবিবার সিপিডির পক্ষ থেকে বিজিএমইএ সভাপতি মাহমুদ হাসান খানের কাছে &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737190/%E0%A6%AE%E0%A6%9C%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%8F%E0%A6%AE%E0%A6%87%E0%A6%8F%E0%A6%B0-%E0%A6%86%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%96%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>ব্যাংকের বাইরে মানুষের হাতে নগদ টাকা কমছে</title>
      <link>https://www.deshrupantor.com/737189/%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A6%97%E0%A6%A6-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%95%E0%A6%AE%E0%A6%9B%E0%A7%87</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737189/%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A6%97%E0%A6%A6-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%95%E0%A6%AE%E0%A6%9B%E0%A7%87</guid>
      <pubDate>Mon, 23 Nov 2026 02:06:46 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2023/11/01/756bedac712941f47eb46b3a34b88636-6541866731238.png?jadewits_media_id=9" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2023/11/01/756bedac712941f47eb46b3a34b88636-6541866731238.png?jadewits_media_id=9" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2023/11/01/756bedac712941f47eb46b3a34b88636-6541866731238.png?jadewits_media_id=9" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ব্যাংকের বাইরে মানুষের হাতে নগদ টাকা কমছে" /&gt;&lt;/p&gt;&lt;p&gt;ব্যাংকিং ব্যবস্থার বাইরে মানুষের হাতে থাকা নগদ টাকার পরিমাণ টানা তিন মাস ধরে কমছে। গত মে মাসে ব্যাংকের বাইরে নগদ অর্থের পরিমাণ ৩ লাখ ৪৯ হাজার ৩৭৪ কোটি টাকায় উঠলেও জুন থেকে তা ধারাবাহিকভাবে কমতে শুরু করে। সর্বশেষ গত সেপ্টেম্বর শেষে মানুষের হাতে থাকা নগদ টাকার পরিমাণ নেমে এসেছে ৩ লাখ ১১ হাজার ৬৬ কোটি &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737189/%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A6%97%E0%A6%A6-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%95%E0%A6%AE%E0%A6%9B%E0%A7%87">দেশ রূপান্তর</source>
    </item>

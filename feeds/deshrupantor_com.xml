    <item>
      <title>চন্দনাইশে ‘আর্থিক সাক্ষরতা দিবস’ পালিত</title>
      <link>https://www.deshrupantor.com/735767/%E0%A6%9A%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%A8%E0%A6%BE%E0%A6%87%E0%A6%B6%E0%A7%87-%E2%80%98%E0%A6%86%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%BF%E0%A6%95-%E0%A6%B8%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%B0%E0%A6%A4%E0%A6%BE-%E0%A6%A6%E0%A6%BF%E0%A6%AC%E0%A6%B8%E2%80%99-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%A4</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735767/%E0%A6%9A%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%A8%E0%A6%BE%E0%A6%87%E0%A6%B6%E0%A7%87-%E2%80%98%E0%A6%86%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%BF%E0%A6%95-%E0%A6%B8%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%B0%E0%A6%A4%E0%A6%BE-%E0%A6%A6%E0%A6%BF%E0%A6%AC%E0%A6%B8%E2%80%99-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%A4</guid>
      <pubDate>Tue, 17 Nov 2026 01:13:05 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/f8d963ff9710ff4a4a17305e2a0c168e-6afb558e3b16d.jpg?jadewits_media_id=243163" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/f8d963ff9710ff4a4a17305e2a0c168e-6afb558e3b16d.jpg?jadewits_media_id=243163" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/f8d963ff9710ff4a4a17305e2a0c168e-6afb558e3b16d.jpg?jadewits_media_id=243163" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চন্দনাইশে ‘আর্থিক সাক্ষরতা দিবস’ পালিত" /&gt;&lt;/p&gt;&lt;p&gt;ইউনাইটেড কমার্শিয়াল ব্যাংক (ইউসিবি) পিএলসি চন্দনাইশ শাখার উদ্যোগে ডেপুটি ম্যানেজিং ডিরেক্টর (ডিএমডি) সুফিয়া আক্তার, হোলসেল ব্যাংকিং ডিভিশন-এর নির্দেশনার আলোকে &amp;lsquo;আর্থিক সাক্ষরতা দিবস-২০২৬&amp;rsquo; উপলক্ষে আর্থিক সচেতনতা ও অন্তর্ভুক্তিমূলক মতবিনিময় সভা অনুষ্ঠিত হয়েছে।
সভায় সভাপতিত্ব করেন ইউসিব&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735767/%E0%A6%9A%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%A8%E0%A6%BE%E0%A6%87%E0%A6%B6%E0%A7%87-%E2%80%98%E0%A6%86%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%BF%E0%A6%95-%E0%A6%B8%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%B0%E0%A6%A4%E0%A6%BE-%E0%A6%A6%E0%A6%BF%E0%A6%AC%E0%A6%B8%E2%80%99-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%A4">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>জাবির ভর্তি পরীক্ষার আবেদন শুরু ২২ নভেম্বর</title>
      <link>https://www.deshrupantor.com/735766/%E0%A6%9C%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%AD%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%AC%E0%A7%87%E0%A6%A6%E0%A6%A8-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81-%E0%A7%A8%E0%A7%A8-%E0%A6%A8%E0%A6%AD%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735766/%E0%A6%9C%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%AD%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%AC%E0%A7%87%E0%A6%A6%E0%A6%A8-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81-%E0%A7%A8%E0%A7%A8-%E0%A6%A8%E0%A6%AD%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0</guid>
      <pubDate>Tue, 17 Nov 2026 00:59:39 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/2754b7722d94be474c7ff278efc1d43e-6afb526e19926.jpg?jadewits_media_id=243162" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/2754b7722d94be474c7ff278efc1d43e-6afb526e19926.jpg?jadewits_media_id=243162" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/2754b7722d94be474c7ff278efc1d43e-6afb526e19926.jpg?jadewits_media_id=243162" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জাবির ভর্তি পরীক্ষার আবেদন শুরু ২২ নভেম্বর" /&gt;&lt;/p&gt;&lt;p&gt;জাহাঙ্গীরনগর বিশ্ববিদ্যালয়ে (জাবি) ২০২৬-২৭ শিক্ষাবর্ষে প্রথম বর্ষ স্নাতক (সম্মান) শ্রেণিতে ভর্তি পরীক্ষার আবেদন শুরু হচ্ছে আগামী ২২ নভেম্বর। আবেদন চলবে ১৫ ডিসেম্বর রাত ১১টা ৫৯ মিনিট পর্যন্ত। এবার ভর্তি পরীক্ষার এমসিকিউ অংশের নম্বর ৮০ থেকে বাড়িয়ে ৯০ করা হয়েছে। পাশাপাশি কয়েকটি ইউনিটে আবেদনের ন্যূনতম জ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735766/%E0%A6%9C%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%AD%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%AC%E0%A7%87%E0%A6%A6%E0%A6%A8-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81-%E0%A7%A8%E0%A7%A8-%E0%A6%A8%E0%A6%AD%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>শেষ বিকেলের স্বস্তি বাংলাদেশের</title>
      <link>https://www.deshrupantor.com/735765/%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735765/%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Tue, 17 Nov 2026 00:43:01 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/c77513c3fd9950bf78fff3dd82ee2fb4-6afb480a208b8.jpg?jadewits_media_id=243157" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/c77513c3fd9950bf78fff3dd82ee2fb4-6afb480a208b8.jpg?jadewits_media_id=243157" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/c77513c3fd9950bf78fff3dd82ee2fb4-6afb480a208b8.jpg?jadewits_media_id=243157" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শেষ বিকেলের স্বস্তি বাংলাদেশের" /&gt;&lt;/p&gt;&lt;p&gt;তাওহীদ হৃদয়ের পর লিটন দাসের দুর্দান্ত সেঞ্চুরিতেও দক্ষিণ আফ্রিকায় স্বস্তি খুঁজে পাচ্ছিল না বাংলাদেশ দল। প্রথম ইনিংসে ৪০০ রানে অলআউট হওয়ার পর বল হাতে শুরুটাও ভালো হয় লাল-সবুজের প্রতিনিধিদের। কিন্তু ধারাবাহিকতা ধরে রাখতে পারেননি বোলাররা। মার্কাস অ্যাকারম্যানের সেঞ্চুরি ও জুবাইর হামজার ৮৩ রানের ইনিংসে &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735765/%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>ভারত-পাকিস্তান ফাইনালে বাংলাদেশ দর্শক</title>
      <link>https://www.deshrupantor.com/735764/%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4-%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8-%E0%A6%AB%E0%A6%BE%E0%A6%87%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%A6%E0%A6%B0%E0%A7%8D%E0%A6%B6%E0%A6%95</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735764/%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4-%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8-%E0%A6%AB%E0%A6%BE%E0%A6%87%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%A6%E0%A6%B0%E0%A7%8D%E0%A6%B6%E0%A6%95</guid>
      <pubDate>Tue, 17 Nov 2026 00:42:16 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/d1a99c74042a45c7807539845c7f2355-6afb48082ce95.jpg?jadewits_media_id=243154" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/d1a99c74042a45c7807539845c7f2355-6afb48082ce95.jpg?jadewits_media_id=243154" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/d1a99c74042a45c7807539845c7f2355-6afb48082ce95.jpg?jadewits_media_id=243154" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভারত-পাকিস্তান ফাইনালে বাংলাদেশ দর্শক" /&gt;&lt;/p&gt;&lt;p&gt;দক্ষিণ এশিয়ার ফুটবলে সবচেয়ে কাক্সিক্ষত লড়াইয়ের মঞ্চ প্রস্তুত। ঢাকায় সাফ চ্যাম্পিয়নশিপের ফাইনালে মঙ্গলবার মুখোমুখি হচ্ছে চিরপ্রতিদ্বন্দ্বী ভারত ও পাকিস্তান। বর্তমান চ্যাম্পিয়ন ভারতের সামনে টানা তৃতীয়বার শিরোপা জয়ের হাতছানি। অন্যদিকে প্রথমবারের মতো ফাইনালে ওঠা পাকিস্তানের লক্ষ্য ইতিহাস গড়ে প্রথম শিরোপ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735764/%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4-%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8-%E0%A6%AB%E0%A6%BE%E0%A6%87%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%A6%E0%A6%B0%E0%A7%8D%E0%A6%B6%E0%A6%95">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>আজ খুলনা হারলেই চ্যাম্পিয়ন সিলেট</title>

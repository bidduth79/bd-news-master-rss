    <item>
      <title>‘দেশের সংস্কৃতি, ঐতিহ্য তুলে ধরব বিশ্বমঞ্চে’</title>
      <link>https://www.deshrupantor.com/733686/%E2%80%98%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%83%E0%A6%A4%E0%A6%BF-%E0%A6%90%E0%A6%A4%E0%A6%BF%E0%A6%B9%E0%A7%8D%E0%A6%AF-%E0%A6%A4%E0%A7%81%E0%A6%B2%E0%A7%87-%E0%A6%A7%E0%A6%B0%E0%A6%AC-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AE%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A7%87%E2%80%99</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/733686/%E2%80%98%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%83%E0%A6%A4%E0%A6%BF-%E0%A6%90%E0%A6%A4%E0%A6%BF%E0%A6%B9%E0%A7%8D%E0%A6%AF-%E0%A6%A4%E0%A7%81%E0%A6%B2%E0%A7%87-%E0%A6%A7%E0%A6%B0%E0%A6%AC-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AE%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A7%87%E2%80%99</guid>
      <pubDate>Mon, 09 Nov 2026 01:11:09 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/db7c4c61298484142f3b5922bb03933e-6af0c947e2c91.jpg?jadewits_media_id=241171" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/db7c4c61298484142f3b5922bb03933e-6af0c947e2c91.jpg?jadewits_media_id=241171" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/db7c4c61298484142f3b5922bb03933e-6af0c947e2c91.jpg?jadewits_media_id=241171" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘দেশের সংস্কৃতি, ঐতিহ্য তুলে ধরব বিশ্বমঞ্চে’" /&gt;&lt;/p&gt;&lt;p&gt;বাবা-মার কাছ থেকে পাওয়া অনুপ্রেরণাই এখন সবচেয়ে বড় শক্তি মডেল-অভিনেত্রী সামিরা খান মাহির। লক্ষ্য এবার বিশ্বমঞ্চে বাংলাদেশের মুখ উজ্জ্বল করা। আত্মবিশ্বাসী মাহির দৃঢ় প্রত্যয়, তিনি জিতলে জিতবে পুরো বাংলাদেশও। ২৪ নভেম্বর ক্যারিবীয় দ্বীপাঞ্চল পুয়ের্তো রিকোয় বসবে মিস ইউনিভার্স প্রতিযোগিতাটির ৭৫তম আসর। এই &lt;/p&gt;</description>

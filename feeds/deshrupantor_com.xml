      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/48d77e2b5050ec0e561632cf1a84ce36-6b0495bc5e818.jpg?jadewits_media_id=244721" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রোনালদোকেও ছাড়িয়ে গেলেন আরিফ!" /&gt;&lt;/p&gt;&lt;p&gt;মাঠের শৃঙ্খলাভঙ্গের দায়ে এশিয়ান ফুটবল কনফেডারেশনের (এএফসি) কঠোর শাস্তির মুখে পড়েছেন বাংলাদেশের অনূর্ধ্ব- ১৭ দলের ফুটবলার মোহাম্মদ আরিফ। জানা গেছে, এক ম্যাচের স্বয়ংক্রিয় নিষেধাজ্ঞাসহ মোট তিন ম্যাচ নিষিদ্ধ হয়েছেন তিনি। পাশাপাশি তাকে গুনতে হচ্ছে ৩৫০ মার্কিন ডলার জরিমানা। জরিমানার অঙ্কে কিছুদিন আগে শাস্&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737412/%E0%A6%B0%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A6%A6%E0%A7%8B%E0%A6%95%E0%A7%87%E0%A6%93-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%86%E0%A6%B0%E0%A6%BF%E0%A6%AB">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>ওয়ানডে দলে খালেদ-রাব্বি</title>
      <link>https://www.deshrupantor.com/737411/%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%A1%E0%A7%87-%E0%A6%A6%E0%A6%B2%E0%A7%87-%E0%A6%96%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A6-%E0%A6%B0%E0%A6%BE%E0%A6%AC%E0%A7%8D%E0%A6%AC%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737411/%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%A1%E0%A7%87-%E0%A6%A6%E0%A6%B2%E0%A7%87-%E0%A6%96%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A6-%E0%A6%B0%E0%A6%BE%E0%A6%AC%E0%A7%8D%E0%A6%AC%E0%A6%BF</guid>
      <pubDate>Tue, 24 Nov 2026 01:36:14 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/e6b6d0cd3676913dd36bdde3b2bdd819-6b0495a75fd1f.jpg?jadewits_media_id=244720" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/e6b6d0cd3676913dd36bdde3b2bdd819-6b0495a75fd1f.jpg?jadewits_media_id=244720" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/e6b6d0cd3676913dd36bdde3b2bdd819-6b0495a75fd1f.jpg?jadewits_media_id=244720" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ওয়ানডে দলে খালেদ-রাব্বি" /&gt;&lt;/p&gt;&lt;p&gt;দীর্ঘদিন ধরেই ওয়ানডে দলের বাইরে ছিলেন সৈয়দ খালেদ আহমেদ ও ইয়াসির আলী রাব্বি। এবার দুজনেই ফিরেছেন। দক্ষিণ আফ্রিকার বিপক্ষে তিন ম্যাচের ওয়ানডে সিরিজ সামনে রেখে গতকাল ঘোষিত ১৫ সদস্যের দলে জায়গা পেয়েছেন তারা। খালেদের প্রত্যাবর্তন যেমন চমক জাগিয়েছে, তেমনি ব্যাট হাতে সাম্প্রতিক পারফরম্যান্সের পুরস্কার পেয়ে&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737411/%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%A1%E0%A7%87-%E0%A6%A6%E0%A6%B2%E0%A7%87-%E0%A6%96%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A6-%E0%A6%B0%E0%A6%BE%E0%A6%AC%E0%A7%8D%E0%A6%AC%E0%A6%BF">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>ফিরতে ‘উদগ্রীব’ নাহিদ রানা</title>
      <link>https://www.deshrupantor.com/737410/%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A6%A4%E0%A7%87-%E2%80%98%E0%A6%89%E0%A6%A6%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%AC%E2%80%99-%E0%A6%A8%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A6-%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737410/%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A6%A4%E0%A7%87-%E2%80%98%E0%A6%89%E0%A6%A6%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%AC%E2%80%99-%E0%A6%A8%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A6-%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A6%BE</guid>
      <pubDate>Tue, 24 Nov 2026 01:35:50 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/5e80dc41cd46c14393e54a4a7e7899e4-6b049590493d4.jpg?jadewits_media_id=244719" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/5e80dc41cd46c14393e54a4a7e7899e4-6b049590493d4.jpg?jadewits_media_id=244719" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/5e80dc41cd46c14393e54a4a7e7899e4-6b049590493d4.jpg?jadewits_media_id=244719" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফিরতে ‘উদগ্রীব’ নাহিদ রানা" /&gt;&lt;/p&gt;&lt;p&gt;চোটের কারণে দক্ষিণ আফ্রিকা সফরের টেস্ট দলে থাকতে পারেননি। গতকাল ঘোষণা করা ওয়ানডে দলেও নাম নেই নাহিদ রানার। এ সিরিজে অংশ নিতে আজ দুপুরে ঢাকা ছাড়ার কথা রিশাদ হোসেন ও তানভীর ইসলামের। গতকাল মিরপুরে ড্রেসিংরুমের সামনে বসে যখন আড্ডা দিচ্ছিলেন এ দুই স্পিনার, তখন নেটে ফেরার লড়াইয়ে ঘাম ঝরাতে দেখা গেল নাহিদকে&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737410/%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A6%A4%E0%A7%87-%E2%80%98%E0%A6%89%E0%A6%A6%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%AC%E2%80%99-%E0%A6%A8%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A6-%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A6%BE">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>বসুন্ধরা হাউজিং প্রেজেন্টস ডিএনসিসি কাপ</title>
      <link>https://www.deshrupantor.com/737409/%E0%A6%AC%E0%A6%B8%E0%A7%81%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A6%B0%E0%A6%BE-%E0%A6%B9%E0%A6%BE%E0%A6%89%E0%A6%9C%E0%A6%BF%E0%A6%82-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%B8-%E0%A6%A1%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%B8%E0%A6%BF-%E0%A6%95%E0%A6%BE%E0%A6%AA</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737409/%E0%A6%AC%E0%A6%B8%E0%A7%81%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A6%B0%E0%A6%BE-%E0%A6%B9%E0%A6%BE%E0%A6%89%E0%A6%9C%E0%A6%BF%E0%A6%82-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%B8-%E0%A6%A1%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%B8%E0%A6%BF-%E0%A6%95%E0%A6%BE%E0%A6%AA</guid>
      <pubDate>Tue, 24 Nov 2026 01:35:09 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/68aefd62d39b99f2634dfe9298d25abe-6b04955e584ba.jpg?jadewits_media_id=244718" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/68aefd62d39b99f2634dfe9298d25abe-6b04955e584ba.jpg?jadewits_media_id=244718" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/68aefd62d39b99f2634dfe9298d25abe-6b04955e584ba.jpg?jadewits_media_id=244718" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বসুন্ধরা হাউজিং প্রেজেন্টস ডিএনসিসি কাপ" /&gt;&lt;/p&gt;&lt;p&gt;মুঠোফোনের আসক্তি আর মাদকের ছোবল থেকে তরুণ প্রজন্মকে খেলার মাঠে ফেরানোর প্রত্যয় নিয়ে ৪ ডিসেম্বর শুরু হচ্ছে &amp;lsquo;বসুন্ধরা হাউজিং প্রেজেন্টস ডিএনসিসি কাপ ফুটবল টুর্নামেন্ট&amp;rsquo;। ঢাকা উত্তর সিটি করপোরেশনের (ডিএনসিসি) এ আয়োজনে ছেলেদের পাশাপাশি সমানতালে লড়বে মেয়েরাও; ১০টি করে মোট ২০টি দল চারটি মাঠে শি&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737409/%E0%A6%AC%E0%A6%B8%E0%A7%81%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A6%B0%E0%A6%BE-%E0%A6%B9%E0%A6%BE%E0%A6%89%E0%A6%9C%E0%A6%BF%E0%A6%82-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%B8-%E0%A6%A1%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%B8%E0%A6%BF-%E0%A6%95%E0%A6%BE%E0%A6%AA">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>একনেকে উঠছে ১২ প্রকল্প</title>
      <link>https://www.deshrupantor.com/737408/%E0%A6%8F%E0%A6%95%E0%A6%A8%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%89%E0%A6%A0%E0%A6%9B%E0%A7%87-%E0%A7%A7%E0%A7%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737408/%E0%A6%8F%E0%A6%95%E0%A6%A8%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%89%E0%A6%A0%E0%A6%9B%E0%A7%87-%E0%A7%A7%E0%A7%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA</guid>
      <pubDate>Tue, 24 Nov 2026 01:34:41 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/cc1f786ffc152f22b353a92ae1240a73-6b04954b120e1.jpg?jadewits_media_id=244717" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/cc1f786ffc152f22b353a92ae1240a73-6b04954b120e1.jpg?jadewits_media_id=244717" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/cc1f786ffc152f22b353a92ae1240a73-6b04954b120e1.jpg?jadewits_media_id=244717" style="max-width:100%;height:auto;margin-bottom:10px;" alt="একনেকে উঠছে ১২ প্রকল্প" /&gt;&lt;/p&gt;&lt;p&gt;জাতীয় অর্থনৈতিক পরিষদের নির্বাহী কমিটির (একনেক) সভায় উঠছে ১২টি প্রকল্প। এর মধ্যে নতুন চারটি এবং সংশোধিত আটটি প্রকল্প রয়েছে। আগামীকাল বুধবার সকাল ১০টায় বাংলাদেশ সচিবালয়ের মন্ত্রিসভা কক্ষে এ সভা অনুষ্ঠিত হবে। এতে সভাপতিত্ব করবেন প্রধানমন্ত্রী ও একনেক সভাপতি তারেক রহমান। সভায় স্থানীয় সরকার, পল্লী উন্নয়&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737408/%E0%A6%8F%E0%A6%95%E0%A6%A8%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%89%E0%A6%A0%E0%A6%9B%E0%A7%87-%E0%A7%A7%E0%A7%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>শেয়ারবাজার থেকে মূলধন তুলবে মেহমুদ ইন্ডাস্ট্রিজ</title>
      <link>https://www.deshrupantor.com/737407/%E0%A6%B6%E0%A7%87%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AE%E0%A7%82%E0%A6%B2%E0%A6%A7%E0%A6%A8-%E0%A6%A4%E0%A7%81%E0%A6%B2%E0%A6%AC%E0%A7%87-%E0%A6%AE%E0%A7%87%E0%A6%B9%E0%A6%AE%E0%A7%81%E0%A6%A6-%E0%A6%87%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%9C</link>

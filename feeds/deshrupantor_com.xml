    <item>
      <title>ব্যাংকের হিসাবের খাতা আর লেখকের খাতা: চারটি ধারণার মানুষ এম এম মাহবুব হাসান</title>
      <link>https://www.deshrupantor.com/734727/%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%BF%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%96%E0%A6%BE%E0%A6%A4%E0%A6%BE-%E0%A6%86%E0%A6%B0-%E0%A6%B2%E0%A7%87%E0%A6%96%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%96%E0%A6%BE%E0%A6%A4%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A6%9F%E0%A6%BF-%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A6%A3%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734727/%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%BF%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%96%E0%A6%BE%E0%A6%A4%E0%A6%BE-%E0%A6%86%E0%A6%B0-%E0%A6%B2%E0%A7%87%E0%A6%96%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%96%E0%A6%BE%E0%A6%A4%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A6%9F%E0%A6%BF-%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A6%A3%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Fri, 13 Nov 2026 00:18:43 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/31e52a2ffd9c9a1164421a0194e45927-6af6023461df1.jpg?jadewits_media_id=242127" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/31e52a2ffd9c9a1164421a0194e45927-6af6023461df1.jpg?jadewits_media_id=242127" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/31e52a2ffd9c9a1164421a0194e45927-6af6023461df1.jpg?jadewits_media_id=242127" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ব্যাংকের হিসাবের খাতা আর লেখকের খাতা: চারটি ধারণার মানুষ এম এম মাহবুব হাসান" /&gt;&lt;/p&gt;&lt;p&gt;একই মানুষ ব্যাংকে আর্থিক অন্তর্ভুক্তির কৌশল সাজান, বিশ্ববিদ্যালয়ের শিক্ষার্থীদের শেখান জীবনের সাতটি অর্থনৈতিক ধাপ, আর কলামে জটিল অর্থনীতির প্রশ্নকে সহজ ভাষায় পাঠকের সামনে আনেন। এম এম মাহবুব হাসানের পেশাজীবন ঠিক এমনই। ব্যাংকার, উন্নয়ন গবেষক ও লেখক—তিনি দুই দশকের বেশি সময় ধরে সক্রিয় থেকে এই তিন প&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734727/%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%BF%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%96%E0%A6%BE%E0%A6%A4%E0%A6%BE-%E0%A6%86%E0%A6%B0-%E0%A6%B2%E0%A7%87%E0%A6%96%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%96%E0%A6%BE%E0%A6%A4%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A6%9F%E0%A6%BF-%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A6%A3%E0%A6%BE%E0%A6%B0">দেশ রূপান্তর</source>

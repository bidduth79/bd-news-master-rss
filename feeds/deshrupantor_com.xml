    <item>
      <title>মেডিকেল টেকনোলজি কোর্স পুনরায় চালুর দাবির বিরোধিতা ডি-ফ্যাবের</title>
      <link>https://www.deshrupantor.com/736170/%E0%A6%AE%E0%A7%87%E0%A6%A1%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%B2-%E0%A6%9F%E0%A7%87%E0%A6%95%E0%A6%A8%E0%A7%8B%E0%A6%B2%E0%A6%9C%E0%A6%BF-%E0%A6%95%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%B8-%E0%A6%AA%E0%A7%81%E0%A6%A8%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A7%81%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A6%BF%E0%A6%A4%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736170/%E0%A6%AE%E0%A7%87%E0%A6%A1%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%B2-%E0%A6%9F%E0%A7%87%E0%A6%95%E0%A6%A8%E0%A7%8B%E0%A6%B2%E0%A6%9C%E0%A6%BF-%E0%A6%95%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%B8-%E0%A6%AA%E0%A7%81%E0%A6%A8%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A7%81%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A6%BF%E0%A6%A4%E0%A6%BE</guid>
      <pubDate>Wed, 18 Nov 2026 18:45:53 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/ce2a65ebebcb4a1101d2f231583a92f5-6afd9dd39290c.gif?jadewits_media_id=243541" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/ce2a65ebebcb4a1101d2f231583a92f5-6afd9dd39290c.gif?jadewits_media_id=243541" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/ce2a65ebebcb4a1101d2f231583a92f5-6afd9dd39290c.gif?jadewits_media_id=243541" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মেডিকেল টেকনোলজি কোর্স পুনরায় চালুর দাবির বিরোধিতা ডি-ফ্যাবের" /&gt;&lt;/p&gt;&lt;p&gt;কারিগরি শিক্ষা বোর্ডের অধীনে মেডিকেল টেকনোলজি ও সংশ্লিষ্ট স্বাস্থ্যকারিগরি কোর্স পুনরায় চালুর দাবির বিরোধিতা করেছে ডিপ্লোমা ফার্মাসিস্ট অ্যাসোসিয়েশন অব বাংলাদেশ (ডি-ফ্যাব)।
সংগঠনটি বলেছে, স্বাস্থ্যশিক্ষার মান, পেশাগত যোগ্যতা ও জনস্বাস্থ্য সুরক্ষার প্রশ্নে কোনো ধরনের আপসের সুযোগ নেই।
যথাযথ কর্তৃপক্ষে&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736170/%E0%A6%AE%E0%A7%87%E0%A6%A1%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%B2-%E0%A6%9F%E0%A7%87%E0%A6%95%E0%A6%A8%E0%A7%8B%E0%A6%B2%E0%A6%9C%E0%A6%BF-%E0%A6%95%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%B8-%E0%A6%AA%E0%A7%81%E0%A6%A8%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A7%81%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A6%BF%E0%A6%A4%E0%A6%BE">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>'আমি বল টেম্পারিং করছি পুরো দলই জানতো', বিস্ফোরক স্বীকরোক্তি ব্যানক্রফটের</title>
      <link>https://www.deshrupantor.com/736169/%E0%A6%86%E0%A6%AE%E0%A6%BF-%E0%A6%AC%E0%A6%B2-%E0%A6%9F%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%82-%E0%A6%95%E0%A6%B0%E0%A6%9B%E0%A6%BF-%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%8B-%E0%A6%A6%E0%A6%B2%E0%A6%87-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%A4%E0%A7%8B-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%95</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736169/%E0%A6%86%E0%A6%AE%E0%A6%BF-%E0%A6%AC%E0%A6%B2-%E0%A6%9F%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%82-%E0%A6%95%E0%A6%B0%E0%A6%9B%E0%A6%BF-%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%8B-%E0%A6%A6%E0%A6%B2%E0%A6%87-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%A4%E0%A7%8B-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%95</guid>
      <pubDate>Wed, 18 Nov 2026 18:44:52 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/f439d8f97906175c65aac0deca61ff72-6afd9d4743a02.jpg?jadewits_media_id=243540" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/f439d8f97906175c65aac0deca61ff72-6afd9d4743a02.jpg?jadewits_media_id=243540" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/f439d8f97906175c65aac0deca61ff72-6afd9d4743a02.jpg?jadewits_media_id=243540" style="max-width:100%;height:auto;margin-bottom:10px;" alt="'আমি বল টেম্পারিং করছি পুরো দলই জানতো', বিস্ফোরক স্বীকরোক্তি ব্যানক্রফটের" /&gt;&lt;/p&gt;&lt;p&gt;২০১৮ সালের দক্ষিণ আফ্রিকা সফরে বল টেম্পারিং বা ‘স্যান্ডপেপার-গেট’ কেলেঙ্কারির কথা পুরো অস্ট্রেলিয়া দলই জানত—এমনই বিস্ফোরক দাবি করেছেন ক্যামেরন ব্যানক্রফট। শুধু তাই নয়, ক্রিকেট অস্ট্রেলিয়ার (সিএ) তদন্ত প্রক্রিয়াকে সুরক্ষা দিতে এবং অন্যদের বাঁচাতে তখন তিনি মিথ্যা বলেছিলেন বলেও স্বীকার করেছেন।					&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736169/%E0%A6%86%E0%A6%AE%E0%A6%BF-%E0%A6%AC%E0%A6%B2-%E0%A6%9F%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%82-%E0%A6%95%E0%A6%B0%E0%A6%9B%E0%A6%BF-%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%8B-%E0%A6%A6%E0%A6%B2%E0%A6%87-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%A4%E0%A7%8B-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%95">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>যানজট নিরসনে 'মনোরেল' ও এআই সিগন্যালের পরিকল্পনা সরকারের</title>
      <link>https://www.deshrupantor.com/736168/%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A6%9C%E0%A6%9F-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%B8%E0%A6%A8%E0%A7%87-%E0%A6%AE%E0%A6%A8%E0%A7%8B%E0%A6%B0%E0%A7%87%E0%A6%B2-%E0%A6%93-%E0%A6%8F%E0%A6%86%E0%A6%87-%E0%A6%B8%E0%A6%BF%E0%A6%97%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A6%A8%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736168/%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A6%9C%E0%A6%9F-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%B8%E0%A6%A8%E0%A7%87-%E0%A6%AE%E0%A6%A8%E0%A7%8B%E0%A6%B0%E0%A7%87%E0%A6%B2-%E0%A6%93-%E0%A6%8F%E0%A6%86%E0%A6%87-%E0%A6%B8%E0%A6%BF%E0%A6%97%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A6%A8%E0%A6%BE</guid>

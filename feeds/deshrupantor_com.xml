      <guid isPermaLink="true">https://www.deshrupantor.com/735322/%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2%E0%A6%B8%E0%A6%B9-%E0%A6%AD%E0%A6%AC%E0%A6%A8-%E0%A6%A6%E0%A6%96%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%AC%E0%A6%BE%E0%A6%A6-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%A8</guid>
      <pubDate>Sun, 15 Nov 2026 14:16:32 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/927a06e649a5c546f2c712f04d5ea78b-6af96989edc2f.jpg?jadewits_media_id=242725" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/927a06e649a5c546f2c712f04d5ea78b-6af96989edc2f.jpg?jadewits_media_id=242725" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/927a06e649a5c546f2c712f04d5ea78b-6af96989edc2f.jpg?jadewits_media_id=242725" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মিরপুরে স্কুলসহ ভবন দখলের অভিযোগে সংবাদ সম্মেলন" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর মিরপুর-১ নম্বরের কাছে দক্ষিণ বিশিল আদর্শ বিদ্যানিকেতনসহ পাঁচতলা ভবনের মার্কেট দখলের অভিযোগ উঠেছে বৈষম্যবিরোধী ছাত্র সমাজের নামে। ২০২৪ এ গণঅভ্যুত্থানের পর কিছু সুবিধাভোগী লোক প্রতিষ্ঠানটি জবরদখল, মার্কেটের অর্থ আত্মসাৎ করে আসছে। প্রতিষ্ঠানটির দীর্ঘদিনের পরিচালনা পর্ষদকে বাদ দিয়ে নতুন কমিটি গ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735322/%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2%E0%A6%B8%E0%A6%B9-%E0%A6%AD%E0%A6%AC%E0%A6%A8-%E0%A6%A6%E0%A6%96%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%AC%E0%A6%BE%E0%A6%A6-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%A8">দেশ রূপান্তর</source>

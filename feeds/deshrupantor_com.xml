    <item>
      <title>মেঘনা-গোমতী সেতুতে ত্রুটি, বন্ধ চট্টগ্রামমুখী দুই লেন</title>
      <link>https://www.deshrupantor.com/737251/%E0%A6%AE%E0%A7%87%E0%A6%98%E0%A6%A8%E0%A6%BE-%E0%A6%97%E0%A7%8B%E0%A6%AE%E0%A6%A4%E0%A7%80-%E0%A6%B8%E0%A7%87%E0%A6%A4%E0%A7%81%E0%A6%A4%E0%A7%87-%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%9F%E0%A6%BF-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7-%E0%A6%9A%E0%A6%9F%E0%A7%8D%E0%A6%9F%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%80-%E0%A6%A6%E0%A7%81%E0%A6%87</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737251/%E0%A6%AE%E0%A7%87%E0%A6%98%E0%A6%A8%E0%A6%BE-%E0%A6%97%E0%A7%8B%E0%A6%AE%E0%A6%A4%E0%A7%80-%E0%A6%B8%E0%A7%87%E0%A6%A4%E0%A7%81%E0%A6%A4%E0%A7%87-%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%9F%E0%A6%BF-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7-%E0%A6%9A%E0%A6%9F%E0%A7%8D%E0%A6%9F%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%80-%E0%A6%A6%E0%A7%81%E0%A6%87</guid>
      <pubDate>Mon, 23 Nov 2026 14:25:05 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/505807794a56b0a53cff1633676f295b-6b03f78751276.jpg?jadewits_media_id=244560" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/505807794a56b0a53cff1633676f295b-6b03f78751276.jpg?jadewits_media_id=244560" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/505807794a56b0a53cff1633676f295b-6b03f78751276.jpg?jadewits_media_id=244560" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মেঘনা-গোমতী সেতুতে ত্রুটি, বন্ধ চট্টগ্রামমুখী দুই লেন" /&gt;&lt;/p&gt;&lt;p&gt;ঢাকা-চট্টগ্রাম মহাসড়কের কুমিল্লার দাউদকান্দিতে মেঘনা-গোমতী নদীর ওপর চট্টগ্রামমুখী সেতুর বিয়ারিং প্যাডে ত্রুটি দেখা দিয়েছে। অতিরিক্ত কম্পনের কারণে নিরাপত্তার স্বার্থে সেতুটির দুই লেন বন্ধ রেখে মেরামতের উদ্যোগ নিয়েছে সড়ক ও জনপথ বিভাগ (সওজ)। বিকল্প হিসেবে পাশের নতুন দুই লেনের সেতু দিয়ে ঢাকা ও চট্টগ্রাম&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737251/%E0%A6%AE%E0%A7%87%E0%A6%98%E0%A6%A8%E0%A6%BE-%E0%A6%97%E0%A7%8B%E0%A6%AE%E0%A6%A4%E0%A7%80-%E0%A6%B8%E0%A7%87%E0%A6%A4%E0%A7%81%E0%A6%A4%E0%A7%87-%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%9F%E0%A6%BF-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7-%E0%A6%9A%E0%A6%9F%E0%A7%8D%E0%A6%9F%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%80-%E0%A6%A6%E0%A7%81%E0%A6%87">দেশ রূপান্তর</source>

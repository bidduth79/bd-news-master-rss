    <item>
      <title>স্বর্ণের দাম আরও কমল</title>
      <link>https://www.deshrupantor.com/736727/%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A6%95%E0%A6%AE%E0%A6%B2</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736727/%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A6%95%E0%A6%AE%E0%A6%B2</guid>
      <pubDate>Sat, 21 Nov 2026 07:07:48 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/2b07e08420a9a072be8d1a764b04c876-6b008bccb4dfa.jpg?jadewits_media_id=244023" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/2b07e08420a9a072be8d1a764b04c876-6b008bccb4dfa.jpg?jadewits_media_id=244023" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/2b07e08420a9a072be8d1a764b04c876-6b008bccb4dfa.jpg?jadewits_media_id=244023" style="max-width:100%;height:auto;margin-bottom:10px;" alt="স্বর্ণের দাম আরও কমল" /&gt;&lt;/p&gt;&lt;p&gt;আন্তর্জাতিক বাজারে দাম কমার প্রভাবে দেশের বাজারে স্বর্ণের দামে বড় ধরনের পতন হয়েছে। একবারে ভরিতে প্রায় ১১ হাজার টাকা কমানোর সিদ্ধান্ত নিয়েছে বাংলাদেশ জুয়েলার্স অ্যাসোসিয়েশন (বাজুস)। এতে ২২ ক্যারেটের এক ভরি স্বর্ণের দাম কমে দাঁড়িয়েছে ২ লাখ ১ হাজার ১৪৬ টাকা। নতুন এই দাম কার্যকর হওয়ার মধ্য দিয়ে টানা আট &lt;/p&gt;</description>

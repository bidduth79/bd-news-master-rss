      <guid isPermaLink="true">https://www.deshrupantor.com/737121/%E0%A6%9A%E0%A6%9F%E0%A7%8D%E0%A6%9F%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%8F%E0%A6%95-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%AE%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A6%BE-%E0%A6%A4%E0%A7%81%E0%A6%B2%E0%A7%87-%E0%A6%A7%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A6%BF-%E0%A6%9C%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A6</guid>
      <pubDate>Sun, 22 Nov 2026 22:00:56 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/1ed82d664f759daa12b89bd789f109be-6b03104a62845.gif?jadewits_media_id=244460" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/1ed82d664f759daa12b89bd789f109be-6b03104a62845.gif?jadewits_media_id=244460" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/1ed82d664f759daa12b89bd789f109be-6b03104a62845.gif?jadewits_media_id=244460" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চট্টগ্রামে এক বছরের আমলনামা তুলে ধরলেন ডিসি জাহিদ" /&gt;&lt;/p&gt;&lt;p&gt;দায়িত্ব গ্রহণের এক বছর পূর্তিতে সংবাদ সম্মেলনে নিজের কর্মকাণ্ড, অর্জন, চ্যালেঞ্জ ও ভবিষ্যৎ পরিকল্পনা তুলে ধরেছেন চট্টগ্রামের জেলা প্রশাসক &amp;nbsp;মোহাম্মদ জাহিদুল ইসলাম মিঞা।
জাতীয় সংসদ নির্বাচন পরিচালনা, জঙ্গল সলিমপুরে যৌথ অভিযান, দুর্যোগ মোকাবিলা, নাগরিক সেবা, পরিবেশ সংরক্ষণ ও মানবিক কার্যক্রমসহ বিভ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737121/%E0%A6%9A%E0%A6%9F%E0%A7%8D%E0%A6%9F%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%8F%E0%A6%95-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%AE%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A6%BE-%E0%A6%A4%E0%A7%81%E0%A6%B2%E0%A7%87-%E0%A6%A7%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A6%BF-%E0%A6%9C%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A6">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>৪১ বছরে পদার্পণে নবীনগর প্রেসক্লাবের দোয়া মাহফিল</title>
      <link>https://www.deshrupantor.com/737120/%E0%A7%AA%E0%A7%A7-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87-%E0%A6%AA%E0%A6%A6%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AA%E0%A6%A3%E0%A7%87-%E0%A6%A8%E0%A6%AC%E0%A7%80%E0%A6%A8%E0%A6%97%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B8%E0%A6%95%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%8B%E0%A7%9F%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%B9%E0%A6%AB%E0%A6%BF%E0%A6%B2</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737120/%E0%A7%AA%E0%A7%A7-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87-%E0%A6%AA%E0%A6%A6%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AA%E0%A6%A3%E0%A7%87-%E0%A6%A8%E0%A6%AC%E0%A7%80%E0%A6%A8%E0%A6%97%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B8%E0%A6%95%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%8B%E0%A7%9F%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%B9%E0%A6%AB%E0%A6%BF%E0%A6%B2</guid>
      <pubDate>Sun, 22 Nov 2026 21:49:53 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/0077ab102405d95672666b3ca7a65152-6b030f15c3e2f.jpg?jadewits_media_id=244459" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/0077ab102405d95672666b3ca7a65152-6b030f15c3e2f.jpg?jadewits_media_id=244459" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/0077ab102405d95672666b3ca7a65152-6b030f15c3e2f.jpg?jadewits_media_id=244459" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৪১ বছরে পদার্পণে নবীনগর প্রেসক্লাবের দোয়া মাহফিল" /&gt;&lt;/p&gt;&lt;p&gt;ব্রাহ্মণবাড়িয়ার ঐতিহ্যবাহী নবীনগর প্রেসক্লাব প্রতিষ্ঠার ৪১ বছরে পদার্পণ করেছে। এ উপলক্ষে কেক কাটা, আলোচনা সভা ও দোয়া মাহফিল অনুষ্ঠিত হয়েছে।
রবিবার (২২ নভেম্বর) বিকেলে নবীনগর প্রেসক্লাব কার্যালয়ে সংগঠনটির উদ্যোগে এ অনুষ্ঠানের আয়োজন করা হয়।
অনুষ্ঠানে প্রধান অতিথি হিসেবে উপস্থিত ছিলেন ব্রাহ্মণবাড়িয়া-৫ &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737120/%E0%A7%AA%E0%A7%A7-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87-%E0%A6%AA%E0%A6%A6%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AA%E0%A6%A3%E0%A7%87-%E0%A6%A8%E0%A6%AC%E0%A7%80%E0%A6%A8%E0%A6%97%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B8%E0%A6%95%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%8B%E0%A7%9F%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%B9%E0%A6%AB%E0%A6%BF%E0%A6%B2">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>ডেঙ্গুতে বোয়ালখালীতে দুইজনের মৃত্যু</title>
      <link>https://www.deshrupantor.com/737119/%E0%A6%A1%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%81%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A7%8B%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%B2%E0%A6%96%E0%A6%BE%E0%A6%B2%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%87%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737119/%E0%A6%A1%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%81%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A7%8B%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%B2%E0%A6%96%E0%A6%BE%E0%A6%B2%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%87%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81</guid>
      <pubDate>Sun, 22 Nov 2026 21:46:37 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/d3e45d113e17250d03839bd45cdd4e01-6b030d000963e.gif?jadewits_media_id=244457" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/d3e45d113e17250d03839bd45cdd4e01-6b030d000963e.gif?jadewits_media_id=244457" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/d3e45d113e17250d03839bd45cdd4e01-6b030d000963e.gif?jadewits_media_id=244457" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডেঙ্গুতে বোয়ালখালীতে দুইজনের মৃত্যু" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রামে ডেঙ্গুতে আক্রান্ত হয়ে একদিনের ব্যবধানে বোয়ালখালী উপজেলার দুই বাসিন্দার মৃত্যু হয়েছে। তাদের একজন নগরীর আন্দরকিল্লা এলাকার ব্যবসায়ী মোহাম্মদ ইসমাইল (৪২)। অন্যজন কাতারপ্রবাসী প্রকৌশলী নেজাম উদ্দিন পারভেজ (৩৪)। তিনি দুই মাসের ছুটিতে দেশে এসেছিলেন।
শুক্রবার (২০ নভেম্বর) দিবাগত রাত দেড়টার &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737119/%E0%A6%A1%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%81%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A7%8B%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%B2%E0%A6%96%E0%A6%BE%E0%A6%B2%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%87%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81">দেশ রূপান্তর</source>
    </item>

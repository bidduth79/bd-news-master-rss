    <item>
      <title>টাঙ্গাইলে মওলানা ভাসানীর মৃত্যু বার্ষিকী পালিত</title>
      <link>https://www.deshrupantor.com/735930/%E0%A6%9F%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%87-%E0%A6%AE%E0%A6%93%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%AD%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81-%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%95%E0%A7%80-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%A4</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735930/%E0%A6%9F%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%87-%E0%A6%AE%E0%A6%93%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%AD%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81-%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%95%E0%A7%80-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%A4</guid>
      <pubDate>Tue, 17 Nov 2026 18:30:30 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/9574acb3729ca08b5857e95ca2fbbb04-6afc48986dbf6.jpg?jadewits_media_id=243321" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/9574acb3729ca08b5857e95ca2fbbb04-6afc48986dbf6.jpg?jadewits_media_id=243321" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/9574acb3729ca08b5857e95ca2fbbb04-6afc48986dbf6.jpg?jadewits_media_id=243321" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টাঙ্গাইলে মওলানা ভাসানীর মৃত্যু বার্ষিকী পালিত" /&gt;&lt;/p&gt;&lt;p&gt;&amp;lsquo;যুগ যুগ জিও তুমি, মওলানা ভাসানী&amp;rsquo; এই স্লোগানে টাঙ্গাইলের সন্তোষে নানা কর্মসূচি ও গভীর শ্রদ্ধার মধ্য দিয়ে মজলুম জননেতা মওলানা আবদুল হামিদ খান ভাসানীর ৫০তম ওফাতবার্ষিকী পালিত হয়েছে।
মঙ্গলবার (১৭ নভেম্বর) সকাল সাড়ে ৭টায় সদর উপজেলার সন্তোষ এলাকায় তার মাজার প্রাঙ্গণে মাওলানা ভাসানী বিজ্ঞান ও &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735930/%E0%A6%9F%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%87-%E0%A6%AE%E0%A6%93%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%AD%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81-%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%95%E0%A7%80-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%A4">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>ইবিতে ব্যানার-পোস্টার টাঙানো ও যানবাহন চলাচলে নতুন নির্দেশনা</title>
      <link>https://www.deshrupantor.com/735929/%E0%A6%87%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%8B%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%9F%E0%A6%BE%E0%A6%99%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%93-%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%A8-%E0%A6%9A%E0%A6%B2%E0%A6%BE%E0%A6%9A%E0%A6%B2%E0%A7%87-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735929/%E0%A6%87%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%8B%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%9F%E0%A6%BE%E0%A6%99%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%93-%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%A8-%E0%A6%9A%E0%A6%B2%E0%A6%BE%E0%A6%9A%E0%A6%B2%E0%A7%87-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8</guid>
      <pubDate>Tue, 17 Nov 2026 18:30:15 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/d19070834517adc1dbe4a23fcce4f852-6afc48b5e8e36.jpg?jadewits_media_id=243322" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/d19070834517adc1dbe4a23fcce4f852-6afc48b5e8e36.jpg?jadewits_media_id=243322" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/d19070834517adc1dbe4a23fcce4f852-6afc48b5e8e36.jpg?jadewits_media_id=243322" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইবিতে ব্যানার-পোস্টার টাঙানো ও যানবাহন চলাচলে নতুন নির্দেশনা" /&gt;&lt;/p&gt;&lt;p&gt;ক্যাম্পাসের সার্বিক শৃঙ্খলা ও স্থিতিশীলতা বজায় রাখতে ৬ দফা সিদ্ধান্ত নিয়েছে ইসলামী বিশ্ববিদ্যালয় (ইবি) প্রশাসন। মঙ্গলবার (১৭ নভেম্বর) প্রক্টর অধ্যাপক ড. শাহীনুজ্জামান এ তথ্য নিশ্চিত করেছেন। প্রক্টরের সভাপতিত্বে তাঁর কার্যালয়ে অনুষ্ঠিত ক্রিয়াশীল সব ছাত্রসংগঠন, ছাত্র-উপদেষ্টা ও প্রক্টরিয়াল বডির সমন্বয়&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735929/%E0%A6%87%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%8B%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%9F%E0%A6%BE%E0%A6%99%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%93-%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%A8-%E0%A6%9A%E0%A6%B2%E0%A6%BE%E0%A6%9A%E0%A6%B2%E0%A7%87-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8">দেশ রূপান্তর</source>
    </item>

    <item>
      <title>আমন নিয়ে দুশ্চিন্তায় উপকূলের কৃষক</title>
      <link>https://www.deshrupantor.com/737051/%E0%A6%86%E0%A6%AE%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%B6%E0%A7%8D%E0%A6%9A%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A7%9F-%E0%A6%89%E0%A6%AA%E0%A6%95%E0%A7%82%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A7%83%E0%A6%B7%E0%A6%95</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737051/%E0%A6%86%E0%A6%AE%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%B6%E0%A7%8D%E0%A6%9A%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A7%9F-%E0%A6%89%E0%A6%AA%E0%A6%95%E0%A7%82%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A7%83%E0%A6%B7%E0%A6%95</guid>
      <pubDate>Sun, 22 Nov 2026 16:20:53 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/c24e2b0527328ed98bf1d044d6bc1bfb-6b02c1b1d5f2f.gif?jadewits_media_id=244379" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/c24e2b0527328ed98bf1d044d6bc1bfb-6b02c1b1d5f2f.gif?jadewits_media_id=244379" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/c24e2b0527328ed98bf1d044d6bc1bfb-6b02c1b1d5f2f.gif?jadewits_media_id=244379" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আমন নিয়ে দুশ্চিন্তায় উপকূলের কৃষক" /&gt;&lt;/p&gt;&lt;p&gt;ভোলার বিচ্ছিন্ন দ্বীপ মনপুরা উপজেলায় টানা চার দিনের গুঁড়ি গুঁড়ি বৃষ্টি ও ঝোড়ো বাতাসে হাজার হাজার হেক্টর জমির পাকা আমন ধান নুয়ে পড়েছে। অনেক জমিতে বৃষ্টির পানি জমে ধানের শীষ ডুবে যাওয়ায় ফসল নষ্ট হওয়ার আশঙ্কা দেখা দিয়েছে।
এভাবে আরও কয়েক দিন বৃষ্টি অব্যাহত থাকলে আমনের ব্যাপক ক্ষতির আশঙ্কা করছেন কৃষকরা। &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737051/%E0%A6%86%E0%A6%AE%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%B6%E0%A7%8D%E0%A6%9A%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A7%9F-%E0%A6%89%E0%A6%AA%E0%A6%95%E0%A7%82%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A7%83%E0%A6%B7%E0%A6%95">দেশ রূপান্তর</source>

      <guid isPermaLink="true">https://www.deshrupantor.com/737842/%E0%A6%B0%E0%A6%BF%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AD-%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%A6%E0%A6%A8-%E0%A6%A6%E0%A6%BE%E0%A6%96%E0%A6%BF%E0%A6%B2-%E0%A7%A7%E0%A7%A6%E0%A7%A6-%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%87%E0%A6%9B%E0%A6%BE%E0%A6%B2</guid>
      <pubDate>Wed, 25 Nov 2026 17:58:45 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/09/29/ebd62c33dd922d58e3bcd9686723b1ca-6abbb8aa71562.gif?jadewits_media_id=231617" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/09/29/ebd62c33dd922d58e3bcd9686723b1ca-6abbb8aa71562.gif?jadewits_media_id=231617" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/09/29/ebd62c33dd922d58e3bcd9686723b1ca-6abbb8aa71562.gif?jadewits_media_id=231617" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রিজার্ভ চুরির প্রতিবেদন দাখিল ১০০ বার পেছাল" /&gt;&lt;/p&gt;&lt;p&gt;১০ বছরের বেশি সময় আগে বাংলাদেশ ব্যাংকের চুরির মামলায় তদন্ত প্রতিবেদন দাখিলের তারিখ ১০০ বারের মতো পিছিয়েছে।
বুধবার (২৫ নভেম্বর) প্রতিবেদন দাখিলের দিন ধার্য ছিল। তবে পুলিশের অপরাধ তদন্ত বিভাগ (সিআইডি) প্রতিবেদন দাখিল করতে না পারায় ঢাকার অতিরিক্ত চিফ মেট্রোপলিটন ম্যাজিস্ট্রেট জশিতা ইসলাম ৩০ ডিসেম্ব&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737842/%E0%A6%B0%E0%A6%BF%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AD-%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%A6%E0%A6%A8-%E0%A6%A6%E0%A6%BE%E0%A6%96%E0%A6%BF%E0%A6%B2-%E0%A7%A7%E0%A7%A6%E0%A7%A6-%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%87%E0%A6%9B%E0%A6%BE%E0%A6%B2">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>হালদার তীরে বাঁধের দাবি ৫ শতাধিক পরিবারের</title>

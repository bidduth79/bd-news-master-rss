      <guid isPermaLink="true">https://www.deshrupantor.com/733993/%E0%A6%9C%E0%A7%9F-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E2%80%99-%E0%A6%B8%E0%A7%8D%E0%A6%B2%E0%A7%8B%E0%A6%97%E0%A6%BE%E0%A6%A8-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%AC%E0%A6%97%E0%A7%81%E0%A7%9C%E0%A6%BE-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A7%9C%E0%A6%95%E0%A7%87</guid>
      <pubDate>Tue, 10 Nov 2026 05:28:40 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/80c43cdaf928e854ecb06a9e50b11ecd-6af2570c2719d.jpg?jadewits_media_id=241438" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/80c43cdaf928e854ecb06a9e50b11ecd-6af2570c2719d.jpg?jadewits_media_id=241438" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/80c43cdaf928e854ecb06a9e50b11ecd-6af2570c2719d.jpg?jadewits_media_id=241438" style="max-width:100%;height:auto;margin-bottom:10px;" alt="'জয় বাংলা’ স্লোগান দিয়ে ঢাকা-বগুড়া মহাসড়কে অগ্নিসংযোগ" /&gt;&lt;/p&gt;&lt;p&gt;বগুড়ার শেরপুরে &amp;lsquo;জয় বাংলা&amp;rsquo; স্লোগান দিয়ে ঢাকা-বগুড়া মহাসড়কে অগ্নিসংযোগ করেছে দুর্বৃত্তরা। সোমবার (৯ নভেম্বর) সন্ধ্যা ৭টার দিকে উপজেলার গাড়িদহ ইউনিয়নের গাড়িদহ বাসস্ট্যান্ড এলাকায় এ ঘটনা ঘটে।
প্রত্যক্ষদর্শী ও স্থানীয় সূত্রে জানা যায়, সন্ধ্যার পর হঠাৎ একদল পিকেটার মহাসড়কের গাড়িদহ বাসস্ট্যান্ড&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/733993/%E0%A6%9C%E0%A7%9F-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E2%80%99-%E0%A6%B8%E0%A7%8D%E0%A6%B2%E0%A7%8B%E0%A6%97%E0%A6%BE%E0%A6%A8-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%AC%E0%A6%97%E0%A7%81%E0%A7%9C%E0%A6%BE-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A7%9C%E0%A6%95%E0%A7%87">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>আওয়ামী লীগের সাবেক এমপি হারুনুর রশিদ মারা গেছেন</title>
      <link>https://www.deshrupantor.com/733992/%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A7%81%E0%A6%A8%E0%A7%81%E0%A6%B0-%E0%A6%B0%E0%A6%B6%E0%A6%BF%E0%A6%A6-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%97%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/733992/%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A7%81%E0%A6%A8%E0%A7%81%E0%A6%B0-%E0%A6%B0%E0%A6%B6%E0%A6%BF%E0%A6%A6-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%97%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8</guid>

    <item>
      <title>মাইক্রোসফটের সার্ভারে বিভ্রাট, ভোগান্তিতে লাখো ব্যবহারকারী</title>
      <link>https://www.deshrupantor.com/734731/%E0%A6%AE%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B8%E0%A6%AB%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%AD%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%9F-%E0%A6%AD%E0%A7%8B%E0%A6%97%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%B2%E0%A6%BE%E0%A6%96%E0%A7%8B</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734731/%E0%A6%AE%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B8%E0%A6%AB%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%AD%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%9F-%E0%A6%AD%E0%A7%8B%E0%A6%97%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%B2%E0%A6%BE%E0%A6%96%E0%A7%8B</guid>
      <pubDate>Fri, 13 Nov 2026 04:30:33 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2025/05/06/5b6e55420bb2fba3c21dc6269c22cd0b-681a3cabe025f.jpg?jadewits_media_id=109900" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2025/05/06/5b6e55420bb2fba3c21dc6269c22cd0b-681a3cabe025f.jpg?jadewits_media_id=109900" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2025/05/06/5b6e55420bb2fba3c21dc6269c22cd0b-681a3cabe025f.jpg?jadewits_media_id=109900" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মাইক্রোসফটের সার্ভারে বিভ্রাট, ভোগান্তিতে লাখো ব্যবহারকারী" /&gt;&lt;/p&gt;&lt;p&gt;মাইক্রোসফটের ই-মেইল সেবা আউটলুকসহ প্রতিষ্ঠানটির একাধিক অনলাইন সেবায় বড় ধরনের বিপর্যয় দেখা দিয়েছে। বৃহস্পতিবার এ সমস্যার কারণে হাজারো ব্যবহারকারী ই-মেইল ব্যবহার এবং কর্মক্ষেত্রের বিভিন্ন অ্যাপে প্রবেশ করতে গিয়ে ভোগান্তিতে পড়েন। খবর আল জাজিরার।
সেবা বিভ্রাট পর্যবেক্ষণকারী ওয়েবসাইট ডাউনডিটেক্টরের তথ্য &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734731/%E0%A6%AE%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B8%E0%A6%AB%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%AD%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%9F-%E0%A6%AD%E0%A7%8B%E0%A6%97%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%B2%E0%A6%BE%E0%A6%96%E0%A7%8B">দেশ রূপান্তর</source>

    <item>
      <title>পৃথিবী রক্ষার আহ্বান জানিয়ে কপ৩১ শুরু</title>
      <link>https://www.deshrupantor.com/734507/%E0%A6%AA%E0%A7%83%E0%A6%A5%E0%A6%BF%E0%A6%AC%E0%A7%80-%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%B9%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%A8-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%95%E0%A6%AA%E0%A7%A9%E0%A7%A7-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734507/%E0%A6%AA%E0%A7%83%E0%A6%A5%E0%A6%BF%E0%A6%AC%E0%A7%80-%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%B9%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%A8-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%95%E0%A6%AA%E0%A7%A9%E0%A7%A7-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81</guid>
      <pubDate>Thu, 12 Nov 2026 01:38:15 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/0d383dcfa8264472fde9496bde781174-6af4c420e1d5c.jpg?jadewits_media_id=241924" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/0d383dcfa8264472fde9496bde781174-6af4c420e1d5c.jpg?jadewits_media_id=241924" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/0d383dcfa8264472fde9496bde781174-6af4c420e1d5c.jpg?jadewits_media_id=241924" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পৃথিবী রক্ষার আহ্বান জানিয়ে কপ৩১ শুরু" /&gt;&lt;/p&gt;&lt;p&gt;মানুষের অতিরিক্ত ভোগবিলাসের কারণে পরিবেশের যে বিপুল ক্ষতি হয়, তা কমিয়ে আনা এবং জলবায়ু পরিবর্তনের নেতিবাচক প্রভাব থেকে পৃথিবীকে রক্ষার আহ্বান জানিয়ে জাতিসংঘের জলবায়ু সম্মেলনের (কপ৩১) শীর্ষ পর্যায়ের আলোচনা গতকাল বুধবার তুরস্কে শুরু হয়েছে। প্রধানমন্ত্রী তারেক রহমানসহ বিভিন্ন দেশের রাষ্ট্র ও সরকারপ্রধান&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734507/%E0%A6%AA%E0%A7%83%E0%A6%A5%E0%A6%BF%E0%A6%AC%E0%A7%80-%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%B9%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%A8-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%95%E0%A6%AA%E0%A7%A9%E0%A7%A7-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81">দেশ রূপান্তর</source>
    </item>

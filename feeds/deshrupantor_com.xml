      <guid isPermaLink="true">https://www.deshrupantor.com/736529/%E0%A6%AC%E0%A6%B8%E0%A7%81%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%B0%E0%A7%82%E0%A6%AA%E0%A6%BE%E0%A7%9F%E0%A6%A3-%E0%A6%AC%E0%A7%81%E0%A6%B2%E0%A7%87%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A1-%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%AD%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%B0</guid>
      <pubDate>Fri, 20 Nov 2026 06:52:56 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/1cc4f85c2aa63d37f11a1511e3806307-6aff924ba0ac4.jpg?jadewits_media_id=243860" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/1cc4f85c2aa63d37f11a1511e3806307-6aff924ba0ac4.jpg?jadewits_media_id=243860" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/1cc4f85c2aa63d37f11a1511e3806307-6aff924ba0ac4.jpg?jadewits_media_id=243860" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বসুন্ধরায় রূপায়ণ বুলেভার্ড প্লাজার ভিত্তিপ্রস্তর স্থাপন" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর বসুন্ধরা আবাসিক এলাকায় রূপায়ণ হাউজিং এস্টেট লিমিটেডের নতুন বাণিজ্যিক প্রকল্প &amp;lsquo;রূপায়ণ বুলেভার্ড প্লাজা&amp;rsquo;র ভিত্তিপ্রস্তর স্থাপন করা হয়েছে। এর মধ্য দিয়ে গতকাল বৃহস্পতিবার প্রকল্পটির নির্মাণকাজের আনুষ্ঠানিক সূচনা হলো।
অনুষ্ঠানে ডিডব্লিউএম৪ ইনট্রেন্ডস লিমিটেডের চিফ আর্কিটেক্ট স্থপতি ম&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736529/%E0%A6%AC%E0%A6%B8%E0%A7%81%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%B0%E0%A7%82%E0%A6%AA%E0%A6%BE%E0%A7%9F%E0%A6%A3-%E0%A6%AC%E0%A7%81%E0%A6%B2%E0%A7%87%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A1-%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%AD%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%B0">দেশ রূপান্তর</source>
    </item>

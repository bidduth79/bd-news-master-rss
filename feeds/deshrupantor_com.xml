      <guid isPermaLink="true">https://www.deshrupantor.com/735326/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AD%E0%A7%8B%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%AE%E0%A6%A4%E0%A6%BF%E0%A6%B9%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%B2-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%95%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A6%A3%E0%A7%8D%E0%A6%A1%E0%A6%BE</guid>
      <pubDate>Sun, 15 Nov 2026 14:30:00 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/9a277a8f87caeb6372b7e9b54693b52f-6af96cf56f05c.jpg?jadewits_media_id=242730" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/9a277a8f87caeb6372b7e9b54693b52f-6af96cf56f05c.jpg?jadewits_media_id=242730" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/9a277a8f87caeb6372b7e9b54693b52f-6af96cf56f05c.jpg?jadewits_media_id=242730" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রভোস্টের সঙ্গে মতিহার হল ছাত্রদলের বাকবিতণ্ডা" /&gt;&lt;/p&gt;&lt;p&gt;শিবির নেতাদের গুরুত্ব দেওয়া এবং তাদের নিয়ে হলের নবনির্মিত সাইকেল গ্যারেজ উদ্বোধন করার অভিযোগ এনে রাজশাহী বিশ্ববিদ্যালয়ের (রাবি) মতিহার হল প্রভোস্ট প্রফেসর ড. সামিউল ইসলাম সরকারের সঙ্গে বাকবিতণ্ডায় জড়িয়েছেন শাখা ছাত্রদলের নেতাকর্মীরা।
রবিবার (১৫ নভেম্বর) সকাল ১০টার দিকে হল প্রভোস্টের কার্যালয়ে এ ঘটনা&lt;/p&gt;</description>

      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/3fcda925fe6190b5b63355a07c16d7c7-6aff3d666b4ab.jpg?jadewits_media_id=243828" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হারে কাঠগড়ায় বোলিং-ফিল্ডিং" /&gt;&lt;/p&gt;&lt;p&gt;জোহানেসবার্গের ১৩০ বছরের টেস্ট ইতিহাসে এর আগে প্রথম ইনিংসে ৩২০ রানের বেশি করা দল কখনো হারেনি। সেই ইতিহাস পাল্টে দিল বাংলাদেশ। প্রথম ইনিংসে ৪০০ রান করার পরও ম্যাচের নিয়ন্ত্রণ নেওয়া তো দূরের কথা, শেষ পর্যন্ত দক্ষিণ আফ্রিকার কাছে ৯ উইকেটের বড় ব্যবধানে হারতে হলো বাংলাদেশকে। ওয়ান্ডারার্সে এই পরাজয়ের পেছন&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736484/%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%A0%E0%A6%97%E0%A7%9C%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A7%8B%E0%A6%B2%E0%A6%BF%E0%A6%82-%E0%A6%AB%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%A1%E0%A6%BF%E0%A6%82">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>অভিষেকেই অগ্নিপরীক্ষায় পচেত্তিনো</title>
      <link>https://www.deshrupantor.com/736483/%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%B7%E0%A7%87%E0%A6%95%E0%A7%87%E0%A6%87-%E0%A6%85%E0%A6%97%E0%A7%8D%E0%A6%A8%E0%A6%BF%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A6%9A%E0%A7%87%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%A8%E0%A7%8B</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736483/%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%B7%E0%A7%87%E0%A6%95%E0%A7%87%E0%A6%87-%E0%A6%85%E0%A6%97%E0%A7%8D%E0%A6%A8%E0%A6%BF%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A6%9A%E0%A7%87%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%A8%E0%A7%8B</guid>
      <pubDate>Fri, 20 Nov 2026 00:31:11 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/3dd2f4b5d70fb83aa5e18ab100e88db1-6aff3d650888e.jpg?jadewits_media_id=243824" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/3dd2f4b5d70fb83aa5e18ab100e88db1-6aff3d650888e.jpg?jadewits_media_id=243824" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/3dd2f4b5d70fb83aa5e18ab100e88db1-6aff3d650888e.jpg?jadewits_media_id=243824" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অভিষেকেই অগ্নিপরীক্ষায় পচেত্তিনো" /&gt;&lt;/p&gt;&lt;p&gt;দীর্ঘ এক দশকের ব্যর্থতা আর হতাশার বৃত্ত ভেঙে ম্যানচেস্টার ইউনাইটেডকে পুরনো গৌরবে ফেরানোর কঠিন চ্যালেঞ্জ নিয়ে ওল্ড ট্র্যাফোর্ডে পা রেখেছেন আর্জেন্টাইন কোচ মাউরিসিও পচেত্তিনো। তবে দায়িত্ব নেওয়ার পরপরই বড়সড় অগ্নিপরীক্ষার মুখোমুখি হতে হচ্ছে ৫৪ বছর বয়সী এই কোচকে। আগামী রবিবার ইংলিশ প্রিমিয়ার লিগে ইউনাইটে&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736483/%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%B7%E0%A7%87%E0%A6%95%E0%A7%87%E0%A6%87-%E0%A6%85%E0%A6%97%E0%A7%8D%E0%A6%A8%E0%A6%BF%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A6%9A%E0%A7%87%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%A8%E0%A7%8B">দেশ রূপান্তর</source>
    </item>
    <item>

      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/8aeb69427687c7f57e7504571e5ffda2-6b05eaba15411.jpg?jadewits_media_id=245016" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/8aeb69427687c7f57e7504571e5ffda2-6b05eaba15411.jpg?jadewits_media_id=245016" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/8aeb69427687c7f57e7504571e5ffda2-6b05eaba15411.jpg?jadewits_media_id=245016" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কক্সবাজারে বাসের ধাক্কায় প্রাণ গেল ৫ যাত্রীর" /&gt;&lt;/p&gt;&lt;p&gt;কক্সবাজারের ঈদগাঁও উপজেলায় যাত্রীবাহী বাসের ধাক্কায় একটি সিএনজিচালিত অটোরিকশার নারী-শিশুসহ ৫ যাত্রী নিহত হয়েছেন।&amp;nbsp; এতে আহত হয়েছেন সিএনজিচালক। গতকাল মঙ্গলবার সন্ধ্যা সাড়ে ৬টার দিকে চট্টগ্রাম-কক্সবাজার মহাসড়কের ঈদগাঁও থানার সামনে এ দুর্ঘটনা ঘটে।
নিহতদের মধ্যে দুজনের পরিচয় নিশ্চিত হওয়া গেছে। তারা হ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737731/%E0%A6%95%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%A7%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3-%E0%A6%97%E0%A7%87%E0%A6%B2-%E0%A7%AB-%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0">দেশ রূপান্তর</source>

      <guid isPermaLink="true">https://www.deshrupantor.com/733626/%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9C%E0%A7%81%E0%A7%9F%E0%A7%87%E0%A6%9F%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A4%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%81%E0%A6%9A-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A6%A8%E0%A6%BE</guid>
      <pubDate>Sun, 08 Nov 2026 19:42:02 +0600</pubDate>
      <description>বিশ্ববিদ্যালয়ের ডিগ্রি নিয়েও চাকরির বাজারের চাহিদা অনুযায়ী দক্ষতা অর্জন করতে পারছেন না অনেক তরুণ। এ ঘাটতি দূর করে গ্র্যাজুয়েটদের দেশি-বিদেশি কর্মবাজারের উপযোগী করতে পাঁচ বছর মেয়াদি কৌশলগত পরিকল্পনা নিয়েছে বাংলাদেশ বিশ্ববিদ্যালয় মঞ্জুরী কমিশন (ইউজিসি)।
পরিকল্পনায় তৃতীয় ভাষা শিক্ষা, বাধ্যতামূলক ইন্টার</description>

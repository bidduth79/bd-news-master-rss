    <item>
      <title>ট্যারিফ কমিশনে সচিব নাসির-উদন্ডদৌলাকে চুক্তিভিত্তিক নিয়োগ</title>
      <link>https://www.deshrupantor.com/736527/%E0%A6%9F%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%AB-%E0%A6%95%E0%A6%AE%E0%A6%BF%E0%A6%B6%E0%A6%A8%E0%A7%87-%E0%A6%B8%E0%A6%9A%E0%A6%BF%E0%A6%AC-%E0%A6%A8%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%B0-%E0%A6%89%E0%A6%A6%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A6%A6%E0%A7%8C%E0%A6%B2%E0%A6%BE%E0%A6%95%E0%A7%87</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736527/%E0%A6%9F%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%AB-%E0%A6%95%E0%A6%AE%E0%A6%BF%E0%A6%B6%E0%A6%A8%E0%A7%87-%E0%A6%B8%E0%A6%9A%E0%A6%BF%E0%A6%AC-%E0%A6%A8%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%B0-%E0%A6%89%E0%A6%A6%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A6%A6%E0%A7%8C%E0%A6%B2%E0%A6%BE%E0%A6%95%E0%A7%87</guid>
      <pubDate>Fri, 20 Nov 2026 06:51:08 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/bd3ba1601dcc4d63225ec146de4c784e-6aff924cb2394.jpg?jadewits_media_id=243866" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/bd3ba1601dcc4d63225ec146de4c784e-6aff924cb2394.jpg?jadewits_media_id=243866" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/bd3ba1601dcc4d63225ec146de4c784e-6aff924cb2394.jpg?jadewits_media_id=243866" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ট্যারিফ কমিশনে সচিব নাসির-উদন্ডদৌলাকে চুক্তিভিত্তিক নিয়োগ" /&gt;&lt;/p&gt;&lt;p&gt;সরকার ট্রেড অ্যান্ড ট্যারিফ কমিশনের চেয়ারম্যান নাসির-উদন্ডদৌলাকে তার অবসরোত্তর ছুটি বাতিল করে একই পদে ১৯ নভেম্বর থেকে এক বছর মেয়াদে চুক্তিভিত্তিক নিয়োগ দিয়েছে। গতকাল জনপ্রশাসন মন্ত্রণালয় এ ব্যাপারে প্রজ্ঞাপন জারি করেছে।
নাসির-উদন্ডদৌলা সরকারি চাকরি আইন অনুযায়ী বয়স ৫৯ বছর পূর্তিতে ১৯ নভেম্বর ২০২৬ তার&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736527/%E0%A6%9F%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%AB-%E0%A6%95%E0%A6%AE%E0%A6%BF%E0%A6%B6%E0%A6%A8%E0%A7%87-%E0%A6%B8%E0%A6%9A%E0%A6%BF%E0%A6%AC-%E0%A6%A8%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%B0-%E0%A6%89%E0%A6%A6%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A6%A6%E0%A7%8C%E0%A6%B2%E0%A6%BE%E0%A6%95%E0%A7%87">দেশ রূপান্তর</source>
    </item>

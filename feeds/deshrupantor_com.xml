    <item>
      <title>ভালুকায় সড়ক দুর্ঘটনায় প্রাণ গেল আলমের</title>
      <link>https://www.deshrupantor.com/734919/%E0%A6%AD%E0%A6%BE%E0%A6%B2%E0%A7%81%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%B8%E0%A7%9C%E0%A6%95-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3-%E0%A6%97%E0%A7%87%E0%A6%B2-%E0%A6%86%E0%A6%B2%E0%A6%AE%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734919/%E0%A6%AD%E0%A6%BE%E0%A6%B2%E0%A7%81%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%B8%E0%A7%9C%E0%A6%95-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3-%E0%A6%97%E0%A7%87%E0%A6%B2-%E0%A6%86%E0%A6%B2%E0%A6%AE%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Sat, 14 Nov 2026 02:30:00 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/6565a5d83d60c66250f872c7c2cf5ea4-6af74c90b8237.jpg?jadewits_media_id=242311" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/6565a5d83d60c66250f872c7c2cf5ea4-6af74c90b8237.jpg?jadewits_media_id=242311" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/6565a5d83d60c66250f872c7c2cf5ea4-6af74c90b8237.jpg?jadewits_media_id=242311" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভালুকায় সড়ক দুর্ঘটনায় প্রাণ গেল আলমের" /&gt;&lt;/p&gt;&lt;p&gt;ময়মনসিংহের ভালুকায় সড়ক দুর্ঘটনায় মো. আলম মোল্ল্যা নামে এক ব্যক্তি নিহত হয়েছেন। বৃহস্পতিবার (১২ নভেম্বর) রাত ১২টার দিকে ঢাকা-ময়মনসিংহ মহাসড়কের উপজেলার সিডস্টোর উত্তর বাজার এলাকার পলাশ ফিলিং স্টেশনের সামনে এ দুর্ঘটনা ঘটে।
নিহত আলম উপজেলার হবিরবাড়ী ইউনিয়নের লবণকাঠা গ্রামের বাসিন্দা। তিনি মরহুম হাসেম মো&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734919/%E0%A6%AD%E0%A6%BE%E0%A6%B2%E0%A7%81%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%B8%E0%A7%9C%E0%A6%95-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3-%E0%A6%97%E0%A7%87%E0%A6%B2-%E0%A6%86%E0%A6%B2%E0%A6%AE%E0%A7%87%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>ছিনতাইয়ের পেছনে ‘সিন্ডিকেট’</title>
      <link>https://www.deshrupantor.com/734988/%E0%A6%9B%E0%A6%BF%E0%A6%A8%E0%A6%A4%E0%A6%BE%E0%A6%87%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%87%E0%A6%9B%E0%A6%A8%E0%A7%87-%E2%80%98%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%9F%E2%80%99</link>

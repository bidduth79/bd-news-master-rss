    <item>
      <title>নগর পরিকল্পনায় উপেক্ষিত স্থানীয় সরকার</title>
      <link>https://www.deshrupantor.com/735087/%E0%A6%A8%E0%A6%97%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%89%E0%A6%AA%E0%A7%87%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%A4-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A7%9F-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735087/%E0%A6%A8%E0%A6%97%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%89%E0%A6%AA%E0%A7%87%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%A4-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A7%9F-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Sat, 14 Nov 2026 15:37:17 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/6c2cf0e60fe13a4c040df8e59890afc0-6af82ba05338f.jpg?jadewits_media_id=242468" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/6c2cf0e60fe13a4c040df8e59890afc0-6af82ba05338f.jpg?jadewits_media_id=242468" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/6c2cf0e60fe13a4c040df8e59890afc0-6af82ba05338f.jpg?jadewits_media_id=242468" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নগর পরিকল্পনায় উপেক্ষিত স্থানীয় সরকার" /&gt;&lt;/p&gt;&lt;p&gt;নগর উন্নয়নের পরিকল্পনা ও বাস্তবায়নে স্থানীয় সরকার প্রতিষ্ঠানগুলোকে উপেক্ষা করা হচ্ছে বলে মন্তব্য করেছেন বিশেষজ্ঞরা। তাদের মতে, কেন্দ্রীয় উন্নয়ন কর্তৃপক্ষের একক সিদ্ধান্ত, আমলাতান্ত্রিক জটিলতা ও রাজনৈতিক দলীয়করণের কারণে সিটি করপোরেশন ও পৌরসভাগুলো কার্যকারিতা হারাচ্ছে। সিটি করপোরেশনকে শুধু ময়লা পরিষ্ক&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735087/%E0%A6%A8%E0%A6%97%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%89%E0%A6%AA%E0%A7%87%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%A4-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A7%9F-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0">দেশ রূপান্তর</source>

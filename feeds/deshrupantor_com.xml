    <item>
      <title>যুক্তরাষ্ট্র শান্তিপূর্ণ সমাধান চায়</title>
      <link>https://www.deshrupantor.com/734198/%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0-%E0%A6%B6%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%AA%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%A3-%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%A7%E0%A6%BE%E0%A6%A8-%E0%A6%9A%E0%A6%BE%E0%A7%9F</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734198/%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0-%E0%A6%B6%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%AA%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%A3-%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%A7%E0%A6%BE%E0%A6%A8-%E0%A6%9A%E0%A6%BE%E0%A7%9F</guid>
      <pubDate>Wed, 11 Nov 2026 00:46:00 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/54dc9959cc75319535e4f9b6e324eb76-6af3589229686.jpg?jadewits_media_id=241651" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/54dc9959cc75319535e4f9b6e324eb76-6af3589229686.jpg?jadewits_media_id=241651" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/54dc9959cc75319535e4f9b6e324eb76-6af3589229686.jpg?jadewits_media_id=241651" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যুক্তরাষ্ট্র শান্তিপূর্ণ সমাধান চায়" /&gt;&lt;/p&gt;&lt;p&gt;মার্কিন প্রেসিডেন্ট ডোনাল্ড ট্রাম্প ইরানের সঙ্গে শান্তিপূর্ণ সমাধান চেয়েছেন। তিনি বলেছেন, ইরানের প্রতিবেশী দেশগুলো নতুন করে আর সংঘাত চায় না। কাতার, সৌদি আরব, সংযুক্ত আরব আমিরাত, বাহরাইন, কুয়েত ও অন্য দেশগুলো নতুন করে সংঘাতের বদলে শান্তিকে প্রাধান্য দিতে চাচ্ছে। হোয়াইট হাউজের প্রেস ব্রিফিং রুমে ট্রাম&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734198/%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0-%E0%A6%B6%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%AA%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%A3-%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%A7%E0%A6%BE%E0%A6%A8-%E0%A6%9A%E0%A6%BE%E0%A7%9F">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>আগামী বছর হবে ইতিহাসের সবচেয়ে উষ্ণ বছর</title>

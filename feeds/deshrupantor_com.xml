    <item>
      <title>রাজধানীর লালবাগে বহুতল ভবনে আগুন, নিয়ন্ত্রণে কাজ করছে ফায়ার সার্ভিস</title>
      <link>https://www.deshrupantor.com/735223/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A6%97%E0%A7%87-%E0%A6%AC%E0%A6%B9%E0%A7%81%E0%A6%A4%E0%A6%B2-%E0%A6%AD%E0%A6%AC%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%9C</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735223/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A6%97%E0%A7%87-%E0%A6%AC%E0%A6%B9%E0%A7%81%E0%A6%A4%E0%A6%B2-%E0%A6%AD%E0%A6%AC%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%9C</guid>
      <pubDate>Sun, 15 Nov 2026 02:26:13 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/07d28eb092d575b53fc5a9141e499826-6af8c3dc04178.jpg?jadewits_media_id=242640" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/07d28eb092d575b53fc5a9141e499826-6af8c3dc04178.jpg?jadewits_media_id=242640" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/07d28eb092d575b53fc5a9141e499826-6af8c3dc04178.jpg?jadewits_media_id=242640" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজধানীর লালবাগে বহুতল ভবনে আগুন, নিয়ন্ত্রণে কাজ করছে ফায়ার সার্ভিস" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর লালবাগে একটি ছয়তলা ভবনে অগ্নিকাণ্ডের ঘটনা ঘটেছে। শনিবার রাত সোয়া ১১টার দিকে ভবনটির ষষ্ঠ তলায় আগুনের সূত্রপাত হয়। খবর পেয়ে ফায়ার সার্ভিসের দুটি ইউনিট দ্রুত ঘটনাস্থলে পৌঁছে আগুন নিয়ন্ত্রণে কাজ শুরু করে।
তবে কীভাবে আগুনের সূত্রপাত হয়েছে এবং এ ঘটনায় কোনো হতাহতের ঘটনা ঘটেছে কি না, তা তাৎক্ষণিকভা&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735223/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A6%97%E0%A7%87-%E0%A6%AC%E0%A6%B9%E0%A7%81%E0%A6%A4%E0%A6%B2-%E0%A6%AD%E0%A6%AC%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%9C">দেশ রূপান্তর</source>
    </item>

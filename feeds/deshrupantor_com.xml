    <item>
      <title>বুয়েটের ১৫০ বছর ও ১৪তম মহাপুনর্মিলনী জানুয়ারিতে</title>
      <link>https://www.deshrupantor.com/734338/%E0%A6%AC%E0%A7%81%E0%A7%9F%E0%A7%87%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A7%A7%E0%A7%AB%E0%A7%A6-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%93-%E0%A7%A7%E0%A7%AA%E0%A6%A4%E0%A6%AE-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%AA%E0%A7%81%E0%A6%A8%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%A8%E0%A7%80-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%87%C2%A0%C2%A0%C2%A0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734338/%E0%A6%AC%E0%A7%81%E0%A7%9F%E0%A7%87%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A7%A7%E0%A7%AB%E0%A7%A6-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%93-%E0%A7%A7%E0%A7%AA%E0%A6%A4%E0%A6%AE-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%AA%E0%A7%81%E0%A6%A8%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%A8%E0%A7%80-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%87%C2%A0%C2%A0%C2%A0</guid>
      <pubDate>Wed, 11 Nov 2026 16:31:57 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/dc56a22f2ea8f3d729f7738d7dea07fb-6af4439c71de8.jpg?jadewits_media_id=241764" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/dc56a22f2ea8f3d729f7738d7dea07fb-6af4439c71de8.jpg?jadewits_media_id=241764" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/dc56a22f2ea8f3d729f7738d7dea07fb-6af4439c71de8.jpg?jadewits_media_id=241764" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বুয়েটের ১৫০ বছর ও ১৪তম মহাপুনর্মিলনী জানুয়ারিতে" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ প্রকৌশল বিশ্ববিদ্যালয়ের (বুয়েট) গৌরবময় ১৫০ বছর ও ১৪তম মহাপুনর্মিলনী আগামী ৬&amp;nbsp; থেকে ১৩ জানুয়ারি ২০২৭ সালে অনুষ্ঠিত হবে।&amp;nbsp;&amp;lsquo;সার্ভে স্কুল হতে বুয়েট, গৌরবের ১৫০ বছর (১৮৭৬-২০২৬)&amp;rsquo; প্রতিপাদ্য ও &amp;lsquo;উই আর প্রাউড অব আওয়ার ওয়ান হান্ড্রেড ফিফটি ইয়ার্স হেরিটেজ&amp;rsquo;এই স্লোগানক&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734338/%E0%A6%AC%E0%A7%81%E0%A7%9F%E0%A7%87%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A7%A7%E0%A7%AB%E0%A7%A6-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%93-%E0%A7%A7%E0%A7%AA%E0%A6%A4%E0%A6%AE-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%AA%E0%A7%81%E0%A6%A8%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%A8%E0%A7%80-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%87%C2%A0%C2%A0%C2%A0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>একদিনে ৩৩ ককটেল বিস্ফোরণ, ১৩ যানবাহনে আগুন</title>
      <link>https://www.deshrupantor.com/734337/%E0%A6%8F%E0%A6%95%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A7%A9%E0%A7%A9-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A7%A7%E0%A7%A9-%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734337/%E0%A6%8F%E0%A6%95%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A7%A9%E0%A7%A9-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A7%A7%E0%A7%A9-%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</guid>
      <pubDate>Wed, 11 Nov 2026 16:27:20 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/8ecc0b3bf97c548a07495f924f6f4c95-6af35468117f9.jpg?jadewits_media_id=241646" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/8ecc0b3bf97c548a07495f924f6f4c95-6af35468117f9.jpg?jadewits_media_id=241646" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/8ecc0b3bf97c548a07495f924f6f4c95-6af35468117f9.jpg?jadewits_media_id=241646" style="max-width:100%;height:auto;margin-bottom:10px;" alt="একদিনে ৩৩ ককটেল বিস্ফোরণ, ১৩ যানবাহনে আগুন" /&gt;&lt;/p&gt;&lt;p&gt;ঢাকাসহ দেশের বিভিন্ন এলাকায় মঙ্গলবার ৩৩টি ককটেল বিস্ফোরণ ও ১৩টি যানবাহনে অগ্নিসংযোগের ঘটনা ঘটেছে। এসব নাশকতার ঘটনায় শুধু রাজধানীতেই ৫৯ জনকে গ্রেপ্তার করেছে পুলিশ।
পুলিশ সদর দপ্তরের তথ্য অনুযায়ী, ঢাকা মহানগর পুলিশ (ডিএমপি) এলাকায় সোমবার রাত ১২টার পর থেকে মঙ্গলবার রাত ১১টা ৩০ মিনিট পর্যন্ত ২০টি স্থানে&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734337/%E0%A6%8F%E0%A6%95%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A7%A9%E0%A7%A9-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A7%A7%E0%A7%A9-%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8">দেশ রূপান্তর</source>
    </item>

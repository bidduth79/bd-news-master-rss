      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/3fcda925fe6190b5b63355a07c16d7c7-6aff3d666b4ab.jpg?jadewits_media_id=243828" length="0" type="image/jpeg" />

      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/6a463cb49b39019c18e1e1f6d598cb67-6afe535b91250.jpg?jadewits_media_id=243658" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঢাকা-পাবনা আন্তঃনগর ট্রেন আজ চালু হচ্ছে" /&gt;&lt;/p&gt;&lt;p&gt;সব জল্পনা-কল্পনার অবসান ঘটিয়ে অবশেষে দীর্ঘদিনের লালিত স্বপ্নপূরণ হতে যাচ্ছে পাবনাবাসীর। আজ বৃহস্পতিবার আনুষ্ঠানিক উদ্বোধনের মাধ্যমে চালু হচ্ছে বহুল প্রতীক্ষিত ঢাকা-পাবনা সরাসরি আন্তঃনগর ট্রেন সার্ভিস। রেলপথ মন্ত্রণালয়ের সচিব মো. ফাহিমুল ইসলামের সভাপতিত্বে অনুষ্ঠানে প্রধান অতিথি হিসেবে ট্রেনটির উদ্বো&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736295/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%AA%E0%A6%BE%E0%A6%AC%E0%A6%A8%E0%A6%BE-%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%83%E0%A6%A8%E0%A6%97%E0%A6%B0-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A8-%E0%A6%86%E0%A6%9C-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A7%81-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>মাদকের টাকা জোগাতে মাকে খুন, স্বর্ণালঙ্কার লুট</title>
      <link>https://www.deshrupantor.com/736294/%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%9C%E0%A7%8B%E0%A6%97%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%96%E0%A7%81%E0%A6%A8-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A6%BE%E0%A6%B2%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%B2%E0%A7%81%E0%A6%9F</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736294/%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%9C%E0%A7%8B%E0%A6%97%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%96%E0%A7%81%E0%A6%A8-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A6%BE%E0%A6%B2%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%B2%E0%A7%81%E0%A6%9F</guid>
      <pubDate>Thu, 19 Nov 2026 07:39:21 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/03988f864549f889688234a254d2ce68-6afe5120869bb.jpg?jadewits_media_id=243654" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/03988f864549f889688234a254d2ce68-6afe5120869bb.jpg?jadewits_media_id=243654" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/03988f864549f889688234a254d2ce68-6afe5120869bb.jpg?jadewits_media_id=243654" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মাদকের টাকা জোগাতে মাকে খুন, স্বর্ণালঙ্কার লুট" /&gt;&lt;/p&gt;&lt;p&gt;সিরাজগঞ্জের উল্লাপাড়ায় মাদকের টাকা জোগাড় করতে মা মতিফুল নেছাকে (৬০) শ^াসরোধে হত্যার পর মরদেহ ঘরের ট্রাঙ্কে লুকিয়ে রেখে স্বর্ণালঙ্কার লুট করেছে তারই ছোট ছেলে আশরাফ আলী (২১)। বন্ধুর সহযোগিতায় গত সোমবার ১৬ নভেম্বর রাত ১১টার দিকে উপজেলার পঞ্চক্রোশী ইউনিয়নের রামকান্তপুর গ্রামে এই নৃশংস হত্যাকা- ঘটে।
হত্য&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736294/%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%9C%E0%A7%8B%E0%A6%97%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%96%E0%A7%81%E0%A6%A8-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A6%BE%E0%A6%B2%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%B2%E0%A7%81%E0%A6%9F">দেশ রূপান্তর</source>

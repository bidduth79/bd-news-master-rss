      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/9e1b6375f05ab015c96d68027676fce6-6af36d101bd41.jpg?jadewits_media_id=241682" length="0" type="image/jpeg" />

      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/05fb8c2fcf410cb62a774fdc34e6e35b-6af906a4ce3fc.jpg?jadewits_media_id=242655" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শিক্ষার্থীকে ধর্ষণ চেষ্টার অভিযোগে শিক্ষককে গণপিটুনি" /&gt;&lt;/p&gt;&lt;p&gt;নোয়াখালীর বেগমগঞ্জে ১০ বছর বয়সী এক শিশু শিক্ষার্থীকে ধর্ষণ চেষ্টার অভিযোগে মো. সাইফুল ইসলাম নামের এক মাদ্রাসাশিক্ষক গণপিটুনির শিকার হয়েছেন। উপজেলার মারকাযে আহমদ ছয়ানী মাদ্রাসাতে এই ঘটনাটি ঘটে।
স্থানীয় সূত্রে জানা যায়, ভুক্তভোগী ওই শিশুর মাদ্রাসার তৃতীয় শ্রেণির শিক্ষার্থী। শিশুটির বাবা পেশায় একজন দুব&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735260/%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%A7%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A6%A3-%E0%A6%9A%E0%A7%87%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%87-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%95%E0%A6%95%E0%A7%87">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>মাত্র ১০ মিনিটেই মৃত্যুকূপ উপকূলীয় জনপদ</title>
      <link>https://www.deshrupantor.com/735259/%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A7%A7%E0%A7%A6-%E0%A6%AE%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A6%9F%E0%A7%87%E0%A6%87-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%82%E0%A6%AA-%E0%A6%89%E0%A6%AA%E0%A6%95%E0%A7%82%E0%A6%B2%E0%A7%80%E0%A7%9F-%E0%A6%9C%E0%A6%A8%E0%A6%AA%E0%A6%A6</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735259/%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A7%A7%E0%A7%A6-%E0%A6%AE%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A6%9F%E0%A7%87%E0%A6%87-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%82%E0%A6%AA-%E0%A6%89%E0%A6%AA%E0%A6%95%E0%A7%82%E0%A6%B2%E0%A7%80%E0%A7%9F-%E0%A6%9C%E0%A6%A8%E0%A6%AA%E0%A6%A6</guid>
      <pubDate>Sun, 15 Nov 2026 07:25:03 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/05fb8c2fcf410cb62a774fdc34e6e35b-6af906a4ce3fc.jpg?jadewits_media_id=242655" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/05fb8c2fcf410cb62a774fdc34e6e35b-6af906a4ce3fc.jpg?jadewits_media_id=242655" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/05fb8c2fcf410cb62a774fdc34e6e35b-6af906a4ce3fc.jpg?jadewits_media_id=242655" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মাত্র ১০ মিনিটেই মৃত্যুকূপ উপকূলীয় জনপদ" /&gt;&lt;/p&gt;&lt;p&gt;আজ ভয়াল ১৫ নভেম্বর &amp;lsquo;সিডর&amp;rsquo; দিবস। ২০০৭ সালের এই রাতে ২১৫ থেকে ২৩০ কিলোমিটার বেগে বয়ে যাওয়া প্রলয়ংকরী ঘূর্ণিঝড় &amp;lsquo;সিডর&amp;rsquo; ও সামুদ্রিক জলোচ্ছ্বাসে ল-ভ- হয়ে গিয়েছিল দেশের সমগ্র উপকূলীয় অঞ্চল। সেদিন রাত সাড়ে ১০টার দিকে বঙ্গোপসাগরের ভয়াল জলোচ্ছ্বাস মাত্র ১০ মিনিটেই প্রাণচাঞ্চল্যে ভরা জন&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735259/%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A7%A7%E0%A7%A6-%E0%A6%AE%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A6%9F%E0%A7%87%E0%A6%87-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%82%E0%A6%AA-%E0%A6%89%E0%A6%AA%E0%A6%95%E0%A7%82%E0%A6%B2%E0%A7%80%E0%A7%9F-%E0%A6%9C%E0%A6%A8%E0%A6%AA%E0%A6%A6">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>৪৩৩ বছরের ঐতিহ্যবাহী বরুনা বড় জামে মসজিদ</title>
      <link>https://www.deshrupantor.com/735258/%E0%A7%AA%E0%A7%A9%E0%A7%A9-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%90%E0%A6%A4%E0%A6%BF%E0%A6%B9%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A7%80-%E0%A6%AC%E0%A6%B0%E0%A7%81%E0%A6%A8%E0%A6%BE-%E0%A6%AC%E0%A7%9C-%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%AE%E0%A6%B8%E0%A6%9C%E0%A6%BF%E0%A6%A6</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735258/%E0%A7%AA%E0%A7%A9%E0%A7%A9-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%90%E0%A6%A4%E0%A6%BF%E0%A6%B9%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A7%80-%E0%A6%AC%E0%A6%B0%E0%A7%81%E0%A6%A8%E0%A6%BE-%E0%A6%AC%E0%A7%9C-%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%AE%E0%A6%B8%E0%A6%9C%E0%A6%BF%E0%A6%A6</guid>
      <pubDate>Sun, 15 Nov 2026 07:24:12 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/ff6dd177106f24292c1dbeb01fa61757-6af909b6a28b8.jpg?jadewits_media_id=242667" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/ff6dd177106f24292c1dbeb01fa61757-6af909b6a28b8.jpg?jadewits_media_id=242667" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/ff6dd177106f24292c1dbeb01fa61757-6af909b6a28b8.jpg?jadewits_media_id=242667" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৪৩৩ বছরের ঐতিহ্যবাহী বরুনা বড় জামে মসজিদ" /&gt;&lt;/p&gt;&lt;p&gt;মৌলভীবাজারের শ্রীমঙ্গল উপজেলার ৫ নম্বর কালাপুর ইউনিয়নের হাইল হাওর বিধৌত ঐতিহ্যময় বরুনা গ্রামে অবস্থিত প্রাচীন স্থাপত্যকলার এক অনন্য নিদর্শন &amp;lsquo;বরুনা বড় জামে মসজিদ&amp;rsquo;। অসাধারণ কারুকার্য ও প্রাকৃতিক সৌন্দর্যে ঘেরা মসজিদটির মূল ফটকের একটি ছোট বোর্ডে নির্মাণকাল হিসেবে ১০০০ বঙ্গাব্দ বা ১৫৯৩ খ্রিস&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735258/%E0%A7%AA%E0%A7%A9%E0%A7%A9-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%90%E0%A6%A4%E0%A6%BF%E0%A6%B9%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A7%80-%E0%A6%AC%E0%A6%B0%E0%A7%81%E0%A6%A8%E0%A6%BE-%E0%A6%AC%E0%A7%9C-%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%AE%E0%A6%B8%E0%A6%9C%E0%A6%BF%E0%A6%A6">দেশ রূপান্তর</source>

    <item>
      <title>নেত্রকোনায় আওয়ামীলীগের ৫০১ নেতার বিরুদ্ধে মামালা</title>
      <link>https://www.deshrupantor.com/734722/%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A7%AB%E0%A7%A6%E0%A7%A7-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734722/%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A7%AB%E0%A7%A6%E0%A7%A7-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A6%BE</guid>
      <pubDate>Thu, 12 Nov 2026 22:31:49 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/9950c96bee7294493e5b7bb0caaec428-6af5e97e51dd2.jpg?jadewits_media_id=242122" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/9950c96bee7294493e5b7bb0caaec428-6af5e97e51dd2.jpg?jadewits_media_id=242122" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/9950c96bee7294493e5b7bb0caaec428-6af5e97e51dd2.jpg?jadewits_media_id=242122" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নেত্রকোনায় আওয়ামীলীগের ৫০১ নেতার বিরুদ্ধে মামালা" /&gt;&lt;/p&gt;&lt;p&gt;নেত্রকোনার বিভিন্ন স্থানে (১০ নভেম্বর) অবরোধ, অগ্নিসংযোগের ঘটনায় জেলার চার থানায় সন্ত্রাস বিরোধী আইনে আওয়ামীলীগের নেতাকর্মীদের বিরুদ্ধে মামলা দায়ের হয়েছে। এসকল মামলায় নাম উল্লেখ ও অজ্ঞাতসহ মোট ৫০১ জনকে আসামী করা হয়েছে।
এরমধ্যে সাবেক এমপি সাজ্জাদুল হাসান ও আওয়ামীলীগ, যুবলীগ ছাত্রলীগের নাম উল্লেখ করে &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734722/%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A7%AB%E0%A7%A6%E0%A7%A7-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A6%BE">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>‘বিদেশি প্রেসক্রিপশনের রাজনীতি রুখতে হবে’</title>

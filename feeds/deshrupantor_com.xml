    <item>
      <title>ফের দূষিত ঢাকার বাতাস, বিশ্বে দ্বিতীয়</title>
      <link>https://www.deshrupantor.com/738020/%E0%A6%AB%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%82%E0%A6%B7%E0%A6%BF%E0%A6%A4-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B8-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A7%87-%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%80%E0%A7%9F</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/738020/%E0%A6%AB%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%82%E0%A6%B7%E0%A6%BF%E0%A6%A4-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B8-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A7%87-%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%80%E0%A7%9F</guid>
      <pubDate>Thu, 26 Nov 2026 09:56:03 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2025/12/21/5cc6ede29af1e6f6e08baa4698718a68-694792023bdbe.jpg?jadewits_media_id=161011" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2025/12/21/5cc6ede29af1e6f6e08baa4698718a68-694792023bdbe.jpg?jadewits_media_id=161011" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2025/12/21/5cc6ede29af1e6f6e08baa4698718a68-694792023bdbe.jpg?jadewits_media_id=161011" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফের দূষিত ঢাকার বাতাস, বিশ্বে দ্বিতীয়" /&gt;&lt;/p&gt;&lt;p&gt;বায়ুদূষণের মাত্রা নিয়ে বিশ্বজুড়েই উদ্বেগ বাড়ছে। জলবায়ু পরিবর্তনসহ নানা কারণে দূষণের এই প্রভাব থেকে বাদ যায়নি বাংলাদেশও। সম্প্রতি বৃষ্টির কারণে রাজধানী ঢাকার বাতাসে দূষণের মাত্রা কিছুটা কমলেও আবারও বেড়েছে। ফলে বিশ্বের দূষিত শহরের তালিকায় দ্বিতীয় অবস্থানে উঠে এসেছে ঢাকা।
বৃহস্পতিবার (২৬ নভেম্বর) সকাল &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/738020/%E0%A6%AB%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%82%E0%A6%B7%E0%A6%BF%E0%A6%A4-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B8-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A7%87-%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%80%E0%A7%9F">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>ন্যাশনাল ব্যাংকে চাকরির সুযোগ</title>
      <link>https://www.deshrupantor.com/738019/%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B6%E0%A6%A8%E0%A6%BE%E0%A6%B2-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%95%E0%A6%B0%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A7%81%E0%A6%AF%E0%A7%8B%E0%A6%97</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/738019/%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B6%E0%A6%A8%E0%A6%BE%E0%A6%B2-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%95%E0%A6%B0%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A7%81%E0%A6%AF%E0%A7%8B%E0%A6%97</guid>
      <pubDate>Thu, 26 Nov 2026 09:54:24 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/5ead384a3b23cd57e9f3ccaf5ce9000b-6b07acc8845cc.jpg?jadewits_media_id=245283" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/5ead384a3b23cd57e9f3ccaf5ce9000b-6b07acc8845cc.jpg?jadewits_media_id=245283" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/5ead384a3b23cd57e9f3ccaf5ce9000b-6b07acc8845cc.jpg?jadewits_media_id=245283" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ন্যাশনাল ব্যাংকে চাকরির সুযোগ" /&gt;&lt;/p&gt;&lt;p&gt;ন্যাশনাল ব্যাংক লিমিটেড নিয়োগ বিজ্ঞপ্তি প্রকাশ করেছে। বেসরকারি বাণিজ্যিক ব্যাংকটি ব্রাঞ্চ ম্যানেজার পদে জনবল নিয়োগের লক্ষ্যে এ বিজ্ঞপ্তি দিয়েছে। আগ্রহী যোগ্য প্রার্থীরা নির্ধারিত সময়ে অনলাইনে আবেদন করতে পারবেন। বিস্তারিত তথ্য নিচে দেওয়া হলো।
প্রতিষ্ঠানের নাম: ন্যাশনাল ব্যাংক লিমিটেড
পদের নাম: ব্রাঞ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/738019/%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B6%E0%A6%A8%E0%A6%BE%E0%A6%B2-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%95%E0%A6%B0%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A7%81%E0%A6%AF%E0%A7%8B%E0%A6%97">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>অর্ধ কোটি টাকার গমসহ লাইটার জাহাজ জব্দ, আটক ৫</title>
      <link>https://www.deshrupantor.com/738018/%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A7-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%97%E0%A6%AE%E0%A6%B8%E0%A6%B9-%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%9C-%E0%A6%9C%E0%A6%AC%E0%A7%8D%E0%A6%A6-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A7%AB</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/738018/%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A7-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%97%E0%A6%AE%E0%A6%B8%E0%A6%B9-%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%9C-%E0%A6%9C%E0%A6%AC%E0%A7%8D%E0%A6%A6-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A7%AB</guid>
      <pubDate>Thu, 26 Nov 2026 09:41:19 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/36339a92b96b1c4a480b76f1e4f9c880-6b07aa255d609.jpg?jadewits_media_id=245281" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/36339a92b96b1c4a480b76f1e4f9c880-6b07aa255d609.jpg?jadewits_media_id=245281" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/36339a92b96b1c4a480b76f1e4f9c880-6b07aa255d609.jpg?jadewits_media_id=245281" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অর্ধ কোটি টাকার গমসহ লাইটার জাহাজ জব্দ, আটক ৫" /&gt;&lt;/p&gt;&lt;p&gt;যশোরের অভয়নগরে অর্ধকোটি টাকা মূল্যের চোরাই সরকারি গমসহ একটি লাইটার জাহাজ জব্দ করেছে স্পেশাল রেসপন্স ব্যাটালিয়ন (এসআরবি)। এ ঘটনায় জিজ্ঞাসাবাদের জন্য জাহাজে থাকা পাঁচজনকে আটক করা হয়েছে।
বুধবার (২৫ নভেম্বর) বিকেলে অভিযান চালিয়ে উপজেলার নওয়াপাড়া নৌবন্দরের বেঙ্গল খেয়াঘাট সংলগ্ন রাসেল ফারাজীর ঘাট থে&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/738018/%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A7-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%97%E0%A6%AE%E0%A6%B8%E0%A6%B9-%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%9C-%E0%A6%9C%E0%A6%AC%E0%A7%8D%E0%A6%A6-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A7%AB">দেশ রূপান্তর</source>

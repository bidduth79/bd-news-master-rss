      <guid isPermaLink="true">https://www.deshrupantor.com/736155/%E0%A6%9A%E0%A6%9F%E0%A7%8D%E0%A6%9F%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A6%B2-%E0%A6%B6%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A7%87</guid>
      <pubDate>Wed, 18 Nov 2026 18:15:00 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/edcfafdb910c25481230d02ec5fda1b8-6afd96a998009.jpg?jadewits_media_id=243527" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/edcfafdb910c25481230d02ec5fda1b8-6afd96a998009.jpg?jadewits_media_id=243527" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/edcfafdb910c25481230d02ec5fda1b8-6afd96a998009.jpg?jadewits_media_id=243527" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চট্টগ্রাম বিশ্ববিদ্যালয়ে ছাত্রদল-শিবিরের মধ্যে উত্তেজনা, আহত ২" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রাম বিশ্ববিদ্যালয়ের (চবি) প্রতিষ্ঠাবার্ষিকী বা হীরক জয়ন্তী উপলক্ষে আয়োজিত অনুষ্ঠানে ছাত্রদল ও ছাত্রশিবিরের নেতাকর্মীরা মুখোমুখি অবস্থান নেয়। দু'পক্ষের উত্তেজনার মধ্যে হাতাহাতিতে দুই শিক্ষার্থী আহত হয়েছেন।
​বুধবার (১৮ নভেম্বর) বেলা ১২টায় বিশ্ববিদ্যালয়ের কেন্দ্রীয় খেলার মাঠে আয়োজিত অনুষ্ঠানে &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736155/%E0%A6%9A%E0%A6%9F%E0%A7%8D%E0%A6%9F%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A6%B2-%E0%A6%B6%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A7%87">দেশ রূপান্তর</source>

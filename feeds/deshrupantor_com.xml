      <guid isPermaLink="true">https://www.deshrupantor.com/736219/%E0%A6%88%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A6%A6%E0%A7%80-%E0%A6%95%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A6%BE%E0%A6%B0%E0%A6%97%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%A8-%E0%A6%8F%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B8%E0%A7%8B%E0%A6%B8%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%B6%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A7%83%E0%A6%A4%E0%A7%80</guid>
      <pubDate>Wed, 18 Nov 2026 22:54:20 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/a17f4296bd8726c1924a840775d6cf7f-6afdd78965acc.gif?jadewits_media_id=243601" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/a17f4296bd8726c1924a840775d6cf7f-6afdd78965acc.gif?jadewits_media_id=243601" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/a17f4296bd8726c1924a840775d6cf7f-6afdd78965acc.gif?jadewits_media_id=243601" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঈশ্বরদী কিন্ডারগার্টেন এ্যাসোসিয়েশনের কৃতী শিক্ষার্থীদের সংবর্ধনা" /&gt;&lt;/p&gt;&lt;p&gt;ঈশ্বরদীতে বর্ণাঢ্য আয়োজনে প্রায় ৩&amp;rsquo;শ মেধাবী শিক্ষার্থীকে বৃত্তি ও সংবর্ধনা দেয়া হয়েছে। ঈশ্বরদী কিন্ডার গার্টেন এ্যাসোসিয়েশনের আয়োজনে ওই সংবর্ধনা দেয়া হয়। বুধবার (১৮ নভেম্বর) সকালে ঈশ্বরদীর অভিজাত আর.আর.পি কমিউনিটি সেন্টারে এ অনুষ্ঠানের আয়োজন করা হয়।
&amp;nbsp;এ উপলক্ষে আয়োজিত অনুষ্ঠানে প্রধান অতিথি&lt;/p&gt;</description>

      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/17a17aca60098e923b284cab6bc2329c-6af76d44b5d39.jpg?jadewits_media_id=242367" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অনুদান ‘বাণিজ্য’ নিয়ে কোন্দল জাপান বিএনপিতে" /&gt;&lt;/p&gt;&lt;p&gt;প্রবাসে বিএনপির সাংগঠনিক শক্তি জোরদার করার কথা থাকলেও জাপানে দলটির অভ্যন্তরীণ কোন্দল এখন প্রকাশ্য রূপ নিয়েছে। নেতৃত্বের দ্বন্দ্ব, পকেট কমিটি গঠন, ব্যক্তিগত বলয় তৈরি এবং আর্থিক অনিয়মের অভিযোগে জাপান বিএনপি বর্তমানে তিন থেকে চারটি উপদলে বিভক্ত হয়ে পড়েছে। বিশেষ করে, সম্প্রতি প্রধানমন্ত্রী তারেক রহমানের&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734982/%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%A6%E0%A6%BE%E0%A6%A8-%E2%80%98%E0%A6%AC%E0%A6%BE%E0%A6%A3%E0%A6%BF%E0%A6%9C%E0%A7%8D%E0%A6%AF%E2%80%99-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%95%E0%A7%8B%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%B2-%E0%A6%9C%E0%A6%BE%E0%A6%AA%E0%A6%BE%E0%A6%A8-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%A4%E0%A7%87">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>১০ মাসে খুন ৮ বিএনপি নেতা</title>
      <link>https://www.deshrupantor.com/734981/%E0%A7%A7%E0%A7%A6-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%96%E0%A7%81%E0%A6%A8-%E0%A7%AE-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734981/%E0%A7%A7%E0%A7%A6-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%96%E0%A7%81%E0%A6%A8-%E0%A7%AE-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE</guid>
      <pubDate>Sat, 14 Nov 2026 02:03:56 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/a7561a7fee5553dbabc2d725fcd599f1-6af76d23e7416.jpg?jadewits_media_id=242366" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/a7561a7fee5553dbabc2d725fcd599f1-6af76d23e7416.jpg?jadewits_media_id=242366" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/a7561a7fee5553dbabc2d725fcd599f1-6af76d23e7416.jpg?jadewits_media_id=242366" style="max-width:100%;height:auto;margin-bottom:10px;" alt="১০ মাসে খুন ৮ বিএনপি নেতা" /&gt;&lt;/p&gt;&lt;p&gt;শিল্পনগরী খুলনায় আইনশৃঙ্খলা পরিস্থিতির চরম অবনতি ঘটেছে। গত জানুয়ারি থেকে ১২ নভেম্বর পর্যন্ত সাড়ে ১০ মাসে খুলনা মহানগর ও জেলায় অন্তত ৭৯টি খুনের ঘটনা ঘটেছে। এই উদ্বেগজনক অবস্থার মধ্যে সবচেয়ে বেশি ক্ষতির শিকার হয়েছেন বিএনপির স্থানীয় নেতাকর্মীরা। সাড়ে ১০ মাসে দুর্বৃত্তদের হামলায় বিএনপির আট নেতাকর্মী নিহ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734981/%E0%A7%A7%E0%A7%A6-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%96%E0%A7%81%E0%A6%A8-%E0%A7%AE-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>অস্থিরতার নেপথ্যে আন্ডারওয়ার্ল্ড</title>
      <link>https://www.deshrupantor.com/734980/%E0%A6%85%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BF%E0%A6%B0%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A7%87%E0%A6%AA%E0%A6%A5%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A6%BE%E0%A6%B0%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B2%E0%A7%8D%E0%A6%A1</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734980/%E0%A6%85%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BF%E0%A6%B0%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A7%87%E0%A6%AA%E0%A6%A5%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A6%BE%E0%A6%B0%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B2%E0%A7%8D%E0%A6%A1</guid>
      <pubDate>Sat, 14 Nov 2026 02:02:34 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/8dce6690cd9ed0f256c9b6491bad5386-6af76cd3e6719.jpg?jadewits_media_id=242365" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/8dce6690cd9ed0f256c9b6491bad5386-6af76cd3e6719.jpg?jadewits_media_id=242365" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/8dce6690cd9ed0f256c9b6491bad5386-6af76cd3e6719.jpg?jadewits_media_id=242365" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অস্থিরতার নেপথ্যে আন্ডারওয়ার্ল্ড" /&gt;&lt;/p&gt;&lt;p&gt;দেশজুড়ে চলমান অস্থিরতার সুযোগ নিয়ে ফের সক্রিয় হয়ে উঠছে আত্মগোপনে থাকা আন্ডারওয়ার্ল্ডের শীর্ষ সন্ত্রাসীরা। তাদের সঙ্গে এবার যুক্ত হয়েছে অন্য অপরাধী চক্রও। সরকারকে বেকায়দায় ফেলতে সামাজিক ও রাজনৈতিক এই অস্থিরতায় হাত মিলিয়েছেন কার্যক্রম নিষিদ্ধ আওয়ামী লীগের কতিপয় নেতা। তাদের মধ্যে কেউ কেউ দেশের বাইরে থে&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734980/%E0%A6%85%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BF%E0%A6%B0%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A7%87%E0%A6%AA%E0%A6%A5%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A6%BE%E0%A6%B0%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B2%E0%A7%8D%E0%A6%A1">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>শেখ হাসিনাকে ফিরতে হবে প্রত্যর্পণ চুক্তিতেই</title>
      <link>https://www.deshrupantor.com/734979/%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%AC%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%B0%E0%A7%8D%E0%A6%AA%E0%A6%A3-%E0%A6%9A%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87%E0%A6%87</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734979/%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%AC%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%B0%E0%A7%8D%E0%A6%AA%E0%A6%A3-%E0%A6%9A%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87%E0%A6%87</guid>
      <pubDate>Sat, 14 Nov 2026 02:00:56 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/cec0632bad488f14d8d196529d809a4f-6af764d42490c.jpg?jadewits_media_id=242335" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/cec0632bad488f14d8d196529d809a4f-6af764d42490c.jpg?jadewits_media_id=242335" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/cec0632bad488f14d8d196529d809a4f-6af764d42490c.jpg?jadewits_media_id=242335" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শেখ হাসিনাকে ফিরতে হবে প্রত্যর্পণ চুক্তিতেই" /&gt;&lt;/p&gt;&lt;p&gt;বিএনপির ভারপ্রাপ্ত মহাসচিব রুহুল কবির রিজভী বলেছেন, &amp;lsquo;শেখ হাসিনার নিজের থেকে দেশে ফেরার বা প্রত্যাবর্তনের কোনো সুযোগ নেই, তাকে ভারতের সঙ্গে প্রত্যর্পণ চুক্তির আওতায় দেশে ফিরিয়ে আনা হবে।&amp;rsquo; গতকাল শুক্রবার সকালে জাতীয় প্রেস ক্লাবে জাতীয়তাবাদী মহিলা দল আয়োজিত জাতীয় বিপ্লব ও সংহতি দিবসের আলোচনা&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734979/%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%AC%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%B0%E0%A7%8D%E0%A6%AA%E0%A6%A3-%E0%A6%9A%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87%E0%A6%87">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>দেশে ফিরেছেন প্রধানমন্ত্রী</title>
      <link>https://www.deshrupantor.com/734978/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734978/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80</guid>
      <pubDate>Sat, 14 Nov 2026 02:00:12 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/6eb5bb39b31324b55aea0d8ac342ffcd-6af76b8b9b8e8.jpg?jadewits_media_id=242362" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/6eb5bb39b31324b55aea0d8ac342ffcd-6af76b8b9b8e8.jpg?jadewits_media_id=242362" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/6eb5bb39b31324b55aea0d8ac342ffcd-6af76b8b9b8e8.jpg?jadewits_media_id=242362" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দেশে ফিরেছেন প্রধানমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;তুরস্কে জাতিসংঘ জলবায়ু পরিবর্তনবিষয়ক কপ৩১ সম্মেলনে অংশগ্রহণ শেষে দেশে ফিরেছেন প্রধানমন্ত্রী তারেক রহমান। গতকাল শুক্রবার সকাল ৫টা ৪০ মিনিটের দিকে প্রধানমন্ত্রী, তার সহধর্মিণী ডা. জুবাইদা রহমান ও সফরসঙ্গীদের বহনকারী তুর্কি এয়ারলাইনসের একটি ফ্লাইট হযরত শাহজালাল আন্তর্জাতিক বিমানবন্দরে অবতরণ করে। প্রধান&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734978/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>অভাবের সংসারে গোল্ডেন জিপিএ-৫, বিচারক হতে চায় সুমনা</title>
      <link>https://www.deshrupantor.com/734918/%E0%A6%85%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%97%E0%A7%8B%E0%A6%B2%E0%A7%8D%E0%A6%A1%E0%A7%87%E0%A6%A8-%E0%A6%9C%E0%A6%BF%E0%A6%AA%E0%A6%BF%E0%A6%8F-%E0%A7%AB-%E0%A6%AC%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A6%95-%E0%A6%B9%E0%A6%A4%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A7%9F</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734918/%E0%A6%85%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%97%E0%A7%8B%E0%A6%B2%E0%A7%8D%E0%A6%A1%E0%A7%87%E0%A6%A8-%E0%A6%9C%E0%A6%BF%E0%A6%AA%E0%A6%BF%E0%A6%8F-%E0%A7%AB-%E0%A6%AC%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A6%95-%E0%A6%B9%E0%A6%A4%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A7%9F</guid>
      <pubDate>Sat, 14 Nov 2026 02:00:00 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/e6af3b42309bb8ace23e85ce07da8c14-6af74cd129e4f.jpg?jadewits_media_id=242312" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/e6af3b42309bb8ace23e85ce07da8c14-6af74cd129e4f.jpg?jadewits_media_id=242312" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/e6af3b42309bb8ace23e85ce07da8c14-6af74cd129e4f.jpg?jadewits_media_id=242312" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অভাবের সংসারে গোল্ডেন জিপিএ-৫, বিচারক হতে চায় সুমনা" /&gt;&lt;/p&gt;&lt;p&gt;নুন আনতে পান্তা ফুরানোর সংসারে প্রতিটি ভোর শুরু হয় বেঁচে থাকার কঠিন লড়াই দিয়ে। সেই প্রতিকূলতা জয় করেই এইচএসসি পরীক্ষায় গোল্ডেন জিপিএ-৫ অর্জন করে আশার আলো জ্বেলেছে নাটোরের বড়াইগ্রামের অদম্য মেধাবী শিক্ষার্থী সুমনা খাতুন। তার স্বপ্ন উচ্চশিক্ষায় শিক্ষিত হয়ে বিচারক হওয়া। তবে উচ্চশিক্ষার বিপুল ব্যয় মেটান&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734918/%E0%A6%85%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%97%E0%A7%8B%E0%A6%B2%E0%A7%8D%E0%A6%A1%E0%A7%87%E0%A6%A8-%E0%A6%9C%E0%A6%BF%E0%A6%AA%E0%A6%BF%E0%A6%8F-%E0%A7%AB-%E0%A6%AC%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A6%95-%E0%A6%B9%E0%A6%A4%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A7%9F">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>বাড়ছে ডায়াবেটিসের রোগী আক্রান্তদের ৫০% জানেই না</title>
      <link>https://www.deshrupantor.com/734977/%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%9B%E0%A7%87-%E0%A6%A1%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%9F%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A7%8B%E0%A6%97%E0%A7%80-%E0%A6%86%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A7%AB%E0%A7%A6%25-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%A8%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734977/%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%9B%E0%A7%87-%E0%A6%A1%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%9F%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A7%8B%E0%A6%97%E0%A7%80-%E0%A6%86%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A7%AB%E0%A7%A6%25-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%A8%E0%A6%BE</guid>
      <pubDate>Sat, 14 Nov 2026 01:59:46 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/5de40b36fbdc75b02f03e511955bce22-6af76c2d15720.jpg?jadewits_media_id=242364" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/5de40b36fbdc75b02f03e511955bce22-6af76c2d15720.jpg?jadewits_media_id=242364" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/5de40b36fbdc75b02f03e511955bce22-6af76c2d15720.jpg?jadewits_media_id=242364" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাড়ছে ডায়াবেটিসের রোগী আক্রান্তদের ৫০% জানেই না" /&gt;&lt;/p&gt;&lt;p&gt;বুকের মধ্যে অসুস্থ বোধ হয়। বুক ছটফট করে। শরীরে অস্বস্তি লাগে। পায়ে পানি জমেছে। এ ছাড়া আরও নানা সমস্যা নিয়ে চিকিৎসকের কাছে যান রহিমা বেগম (৬০)। চিকিৎসক জানতে চান ডায়বেটিস আছে কি না? ডায়বেটিসের পরীক্ষা আগে করিয়েছেন কি না? রহিমা বেগমের ছেলে ফজলুল হামিদ জানান, তার মায়ের কখনো ডায়াবেটিস পরীক্ষা করানো হয়নি&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734977/%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%9B%E0%A7%87-%E0%A6%A1%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%9F%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A7%8B%E0%A6%97%E0%A7%80-%E0%A6%86%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A7%AB%E0%A7%A6%25-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%A8%E0%A6%BE">দেশ রূপান্তর</source>

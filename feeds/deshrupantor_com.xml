    <item>
      <title>স্বস্তির বাহন এখন দুর্ভোগের কারণ</title>
      <link>https://www.deshrupantor.com/737741/%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%A8-%E0%A6%8F%E0%A6%96%E0%A6%A8-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%AD%E0%A7%87%E0%A6%BE%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%A3</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737741/%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%A8-%E0%A6%8F%E0%A6%96%E0%A6%A8-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%AD%E0%A7%87%E0%A6%BE%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%A3</guid>
      <pubDate>Wed, 25 Nov 2026 07:45:32 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/62b1eae2870a9769e5b5c8ffbbac4c4d-6b063dab67b88.jpg?jadewits_media_id=245033" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/62b1eae2870a9769e5b5c8ffbbac4c4d-6b063dab67b88.jpg?jadewits_media_id=245033" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/62b1eae2870a9769e5b5c8ffbbac4c4d-6b063dab67b88.jpg?jadewits_media_id=245033" style="max-width:100%;height:auto;margin-bottom:10px;" alt="স্বস্তির বাহন এখন দুর্ভোগের কারণ" /&gt;&lt;/p&gt;&lt;p&gt;একসময় রাজশাহী নগরবাসীর কাছে স্বস্তির বাহন ছিল অটোরিকশা। গণপরিবহনের অভাবে মানুষের চলাচলে নতুনমাত্রা যোগ করেছিল ছোট এই যান। পাঁচ টাকায় আশপাশের গন্তব্যে কিংবা ১৫ থেকে ২০ টাকায় শহরের এক প্রান্ত থেকে অন্য প্রান্তে চলাচল করা যেত। সহজলভ্য ও তুলনামূলক সাশ্রয়ী হওয়ায় অল্প সময়েই জনপ্রিয় হয়ে ওঠে অটোরিকশা। এ চিত&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737741/%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%A8-%E0%A6%8F%E0%A6%96%E0%A6%A8-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%AD%E0%A7%87%E0%A6%BE%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%A3">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>‘যতদিন ক্ষুধা-দারিদ্র্য থাকবে সুকান্ত প্রাসঙ্গিক থাকবেন’</title>
      <link>https://www.deshrupantor.com/737740/%E2%80%98%E0%A6%AF%E0%A6%A4%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%81%E0%A6%A7%E0%A6%BE-%E0%A6%A6%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%8D%E0%A6%AF-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%AC%E0%A7%87-%E0%A6%B8%E0%A7%81%E0%A6%95%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BF%E0%A6%95</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737740/%E2%80%98%E0%A6%AF%E0%A6%A4%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%81%E0%A6%A7%E0%A6%BE-%E0%A6%A6%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%8D%E0%A6%AF-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%AC%E0%A7%87-%E0%A6%B8%E0%A7%81%E0%A6%95%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BF%E0%A6%95</guid>
      <pubDate>Wed, 25 Nov 2026 07:44:58 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/75940aee929966d15a76ba038b68c096-6b063d94550c2.jpg?jadewits_media_id=245032" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/75940aee929966d15a76ba038b68c096-6b063d94550c2.jpg?jadewits_media_id=245032" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/75940aee929966d15a76ba038b68c096-6b063d94550c2.jpg?jadewits_media_id=245032" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘যতদিন ক্ষুধা-দারিদ্র্য থাকবে সুকান্ত প্রাসঙ্গিক থাকবেন’" /&gt;&lt;/p&gt;&lt;p&gt;কবি সুকান্ত ভট্টাচার্যের জন্মশতবর্ষ উপলক্ষে আরণ্যক নাট্যদলের আয়োজনে অনুষ্ঠিত হয়েছে &amp;lsquo;হে মহাজীবন&amp;rsquo; শীর্ষক বিশেষ অনুষ্ঠান। গতকাল মঙ্গলবার বাংলাদেশ শিল্পকলা একাডেমির স্টুডিও থিয়েটার হলে সুকান্তের জীবন ও সাহিত্যকর্ম নিয়ে আলোচনার পাশাপাশি তার কবিতা অবলম্বনে নির্মিত নাটক &amp;lsquo;একটি মোরগের কাহিন&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737740/%E2%80%98%E0%A6%AF%E0%A6%A4%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%81%E0%A6%A7%E0%A6%BE-%E0%A6%A6%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%8D%E0%A6%AF-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%AC%E0%A7%87-%E0%A6%B8%E0%A7%81%E0%A6%95%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BF%E0%A6%95">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>মিয়ানমারের ৫ সামরিক কর্তার ওপর যুক্তরাজ্যের নিষেধাজ্ঞা</title>
      <link>https://www.deshrupantor.com/737739/%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A7%AB-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%B0%E0%A6%BF%E0%A6%95-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737739/%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A7%AB-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%B0%E0%A6%BF%E0%A6%95-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Wed, 25 Nov 2026 07:44:33 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/8aeb69427687c7f57e7504571e5ffda2-6b05eaba15411.jpg?jadewits_media_id=245016" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/8aeb69427687c7f57e7504571e5ffda2-6b05eaba15411.jpg?jadewits_media_id=245016" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/8aeb69427687c7f57e7504571e5ffda2-6b05eaba15411.jpg?jadewits_media_id=245016" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মিয়ানমারের ৫ সামরিক কর্তার ওপর যুক্তরাজ্যের নিষেধাজ্ঞা" /&gt;&lt;/p&gt;&lt;p&gt;রোহিঙ্গা জনগোষ্ঠীর ওপর জেনোসাইড (গোষ্ঠী নিধন বা জাতিগত হত্যাকা-) চালানোর দায়ে মিয়ানমারের বিরুদ্ধে আন্তর্জাতিক বিচার আদালতের (আইসিজে) রায়ের পর দেশটির সামরিক বাহিনীর শীর্ষ পাঁচ কর্মকর্তার ওপর নিষেধাজ্ঞা আরোপ করেছে যুক্তরাজ্য।
জেনোসাইড সংঘটনের দায়ে কোনো রাষ্ট্রকে দোষী সাব্যস্ত করে জাতিসংঘের সর্বোচ্চ আ&lt;/p&gt;</description>

      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/b463b474dbeab81edb404dea77f3e12d-6afa056cb4ea6.jpg?jadewits_media_id=242895" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/b463b474dbeab81edb404dea77f3e12d-6afa056cb4ea6.jpg?jadewits_media_id=242895" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/b463b474dbeab81edb404dea77f3e12d-6afa056cb4ea6.jpg?jadewits_media_id=242895" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডাবল সেঞ্চুরিতে সেরা মোসাদ্দেক" /&gt;&lt;/p&gt;&lt;p&gt;২৮তম জাতীয় ক্রিকেট লিগের (এনসিএল) সপ্তম ও শেষ রাউন্ডের দ্বিতীয় দিনটি ছিল ব্যাটসম্যানদের দাপটের। গতকাল চার ম্যাচের লড়াইয়ে একটি ডাবল সেঞ্চুরির সঙ্গে দুটি শতক হয়েছে। এর মধ্যে প্রথম শ্রেণির ক্রিকেটে বাংলাদেশের প্রথম ব্যাটসম্যান হিসেবে চতুর্থ ডাবল সেঞ্চুরি তুলে রেকর্ড গড়েছেন মোসাদ্দেক হোসেন। তার ২২০ রানে&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735489/%E0%A6%A1%E0%A6%BE%E0%A6%AC%E0%A6%B2-%E0%A6%B8%E0%A7%87%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A7%87%E0%A6%B0%E0%A6%BE-%E0%A6%AE%E0%A7%8B%E0%A6%B8%E0%A6%BE%E0%A6%A6%E0%A7%8D%E0%A6%A6%E0%A7%87%E0%A6%95">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>সাফে বাংলাদেশের স্বপ্নভঙ্গের কারণ কী</title>
      <link>https://www.deshrupantor.com/735488/%E0%A6%B8%E0%A6%BE%E0%A6%AB%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%AA%E0%A7%8D%E0%A6%A8%E0%A6%AD%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%A3-%E0%A6%95%E0%A7%80</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735488/%E0%A6%B8%E0%A6%BE%E0%A6%AB%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%AA%E0%A7%8D%E0%A6%A8%E0%A6%AD%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%A3-%E0%A6%95%E0%A7%80</guid>
      <pubDate>Mon, 16 Nov 2026 01:17:48 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/ec4921993a0d4ceea0c2a4b96aa95824-6afa0553bf50c.jpg?jadewits_media_id=242894" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/ec4921993a0d4ceea0c2a4b96aa95824-6afa0553bf50c.jpg?jadewits_media_id=242894" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/ec4921993a0d4ceea0c2a4b96aa95824-6afa0553bf50c.jpg?jadewits_media_id=242894" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাফে বাংলাদেশের স্বপ্নভঙ্গের কারণ কী" /&gt;&lt;/p&gt;&lt;p&gt;দীর্ঘ ২৩ বছরের অপেক্ষা। কিন্তু তার অবসান হলো না। ২০০৩ সালে দেশের মাটিতে সাফ জেতার পর আরও একটি সুযোগ এসেছিল। আট প্রবাসী নিয়েও সেই প্রত্যাশা মেটেনি। স্বাগতিকদের আশার গুড়ে বালি ছিটিয়ে দিয়েছে পাকিস্তান। তাই ফাইনালে এখন কেবল দর্শক হয়ে থাকতে হচ্ছে হামজা চৌধুরী, শমিত সোম এবং ফারহান আলীদের। সেমিফাইনালের মতো&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735488/%E0%A6%B8%E0%A6%BE%E0%A6%AB%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%AA%E0%A7%8D%E0%A6%A8%E0%A6%AD%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%A3-%E0%A6%95%E0%A7%80">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>নতুন চ্যাম্পিয়ন ইন্ডিপেনডেন্ট টিভি</title>
      <link>https://www.deshrupantor.com/735487/%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%9A%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A7%9F%E0%A6%A8-%E0%A6%87%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A6%BF%E0%A6%AA%E0%A7%87%E0%A6%A8%E0%A6%A1%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F-%E0%A6%9F%E0%A6%BF%E0%A6%AD%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735487/%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%9A%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A7%9F%E0%A6%A8-%E0%A6%87%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A6%BF%E0%A6%AA%E0%A7%87%E0%A6%A8%E0%A6%A1%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F-%E0%A6%9F%E0%A6%BF%E0%A6%AD%E0%A6%BF</guid>
      <pubDate>Mon, 16 Nov 2026 01:17:08 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/b45e90ac91cb9b04e0d193683fa0dade-6afa052d7d70e.jpg?jadewits_media_id=242893" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/b45e90ac91cb9b04e0d193683fa0dade-6afa052d7d70e.jpg?jadewits_media_id=242893" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/b45e90ac91cb9b04e0d193683fa0dade-6afa052d7d70e.jpg?jadewits_media_id=242893" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নতুন চ্যাম্পিয়ন ইন্ডিপেনডেন্ট টিভি" /&gt;&lt;/p&gt;&lt;p&gt;ল্যাবএইড ওয়ালটন ডিআরইউ মিডিয়া কাপ ক্রিকেটের নতুন চ্যাম্পিয়ন ইন্ডিপেনডেন্ট টেলিভিশন। রবিবার পল্টনের আউটার স্টেডিয়ামে অনুষ্ঠিত ফাইনালে তারা ৩ উইকেটে চ্যানেল ২৪ টেলিভিশনকে পরাজিত করে শিরোপা জিতে নেয়। ফাইনালের সেরা খেলোয়াড় নির্বাচিত হন মাজহারুল ইসলাম। টুর্নামেন্ট সেরা হন একই দলের ছেরাজুল মুস্তাহেদিন। এর&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735487/%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%9A%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A7%9F%E0%A6%A8-%E0%A6%87%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A6%BF%E0%A6%AA%E0%A7%87%E0%A6%A8%E0%A6%A1%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F-%E0%A6%9F%E0%A6%BF%E0%A6%AD%E0%A6%BF">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>রোনালদোহীন পর্তুগালের লজ্জার হার</title>
      <link>https://www.deshrupantor.com/735486/%E0%A6%B0%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A6%A6%E0%A7%8B%E0%A6%B9%E0%A7%80%E0%A6%A8-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A7%81%E0%A6%97%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%B2%E0%A6%9C%E0%A7%8D%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735486/%E0%A6%B0%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A6%A6%E0%A7%8B%E0%A6%B9%E0%A7%80%E0%A6%A8-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A7%81%E0%A6%97%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%B2%E0%A6%9C%E0%A7%8D%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Mon, 16 Nov 2026 01:16:46 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/00f10ba61178116c7c38132ec3233094-6afa0513b3345.jpg?jadewits_media_id=242892" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/00f10ba61178116c7c38132ec3233094-6afa0513b3345.jpg?jadewits_media_id=242892" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/00f10ba61178116c7c38132ec3233094-6afa0513b3345.jpg?jadewits_media_id=242892" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রোনালদোহীন পর্তুগালের লজ্জার হার" /&gt;&lt;/p&gt;&lt;p&gt;গ্যালারিজুড়ে ভক্তদের হাতে ছিল &amp;lsquo;ধন্যবাদ অধিনায়ক&amp;rsquo; লেখা বিশাল সব ব্যানার। ফুটবলাররা মাঠে নেমেছিলেন ক্রিশ্চিয়ানো রোনালদোর চিরচেনা নাম ও ৭ নম্বর জার্সি গায়ে জড়িয়ে। ব্রাগার মাঠে ৪১ বছর বয়সী পর্তুগিজ মহাতারকাকে সম্মান জানাতে ম্যাচের ঘড়ি সপ্তম মিনিটে পৌঁছাতেই স্টেডিয়াম ফেটে পড়েছিল করতালিতে। ফিফ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735486/%E0%A6%B0%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A6%A6%E0%A7%8B%E0%A6%B9%E0%A7%80%E0%A6%A8-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A7%81%E0%A6%97%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%B2%E0%A6%9C%E0%A7%8D%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>৪ মাসে এডিপি বাস্তবায়ন ৬.৫৩ শতাংশ</title>
      <link>https://www.deshrupantor.com/735485/%E0%A7%AA-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%8F%E0%A6%A1%E0%A6%BF%E0%A6%AA%E0%A6%BF-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A6%A8-%E0%A7%AC.%E0%A7%AB%E0%A7%A9-%E0%A6%B6%E0%A6%A4%E0%A6%BE%E0%A6%82%E0%A6%B6</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735485/%E0%A7%AA-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%8F%E0%A6%A1%E0%A6%BF%E0%A6%AA%E0%A6%BF-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A6%A8-%E0%A7%AC.%E0%A7%AB%E0%A7%A9-%E0%A6%B6%E0%A6%A4%E0%A6%BE%E0%A6%82%E0%A6%B6</guid>
      <pubDate>Mon, 16 Nov 2026 01:16:20 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/6f430ae55547fdcd61ef315a1718107c-6afa04fc848ab.jpg?jadewits_media_id=242891" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/6f430ae55547fdcd61ef315a1718107c-6afa04fc848ab.jpg?jadewits_media_id=242891" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/6f430ae55547fdcd61ef315a1718107c-6afa04fc848ab.jpg?jadewits_media_id=242891" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৪ মাসে এডিপি বাস্তবায়ন ৬.৫৩ শতাংশ" /&gt;&lt;/p&gt;&lt;p&gt;চলতি অর্থবছরের চতুর্থ মাসেও বার্ষিক উন্নয়ন কর্মসূচি (এডিপি) বাস্তবায়নে খুব একটা গতি আসেনি। ২০২৬-২৭ অর্থবছরের জুলাই-অক্টোবরে এডিপির মাত্র ৬ দশমিক ৫৩ শতাংশ বাস্তবায়ন হয়েছে। এ সময়ে মোট ব্যয় হয়েছে ২০ হাজার ১৫৯ কোটি টাকা। এর বড় অংশই ব্যয় করেছে স্থানীয় সরকার বিভাগ। বিপরীতে বড় বরাদ্দ থাকা দুই মন্ত্রণালয় এ &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735485/%E0%A7%AA-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%8F%E0%A6%A1%E0%A6%BF%E0%A6%AA%E0%A6%BF-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A6%A8-%E0%A7%AC.%E0%A7%AB%E0%A7%A9-%E0%A6%B6%E0%A6%A4%E0%A6%BE%E0%A6%82%E0%A6%B6">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>ইইউতে বাংলাদেশের পোশাক রপ্তানি কমেছে</title>
      <link>https://www.deshrupantor.com/735484/%E0%A6%87%E0%A6%87%E0%A6%89%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%95-%E0%A6%B0%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%95%E0%A6%AE%E0%A7%87%E0%A6%9B%E0%A7%87</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735484/%E0%A6%87%E0%A6%87%E0%A6%89%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%95-%E0%A6%B0%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%95%E0%A6%AE%E0%A7%87%E0%A6%9B%E0%A7%87</guid>
      <pubDate>Mon, 16 Nov 2026 01:15:56 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/32221e2251384170fac6cad09238bd8d-6af9ea6fc0fb6.jpg?jadewits_media_id=242865" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/32221e2251384170fac6cad09238bd8d-6af9ea6fc0fb6.jpg?jadewits_media_id=242865" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/32221e2251384170fac6cad09238bd8d-6af9ea6fc0fb6.jpg?jadewits_media_id=242865" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইইউতে বাংলাদেশের পোশাক রপ্তানি কমেছে" /&gt;&lt;/p&gt;&lt;p&gt;বিশ্বের অন্যতম বড় পোশাক রপ্তানি বাজার ইউরোপীয় ইউনিয়নে (ইইউ) বাংলাদেশের তৈরি পোশাক রপ্তানি কমেছে প্রায় ১২ শতাংশ। চলতি ২০২৬ সালের জানুয়ারি থেকে সেপ্টেম্বর পর্যন্ত নয় মাসে ইউরোপের বাজারে বাংলাদেশের পোশাক রপ্তানি কমে দাঁড়িয়েছে ১ হাজার ৩৪৮ কোটি ইউরোতে, যা আগের বছরের একই সময়ের তুলনায় ১১ দশমিক ৯১ শতাংশ কম।&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735484/%E0%A6%87%E0%A6%87%E0%A6%89%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%95-%E0%A6%B0%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%95%E0%A6%AE%E0%A7%87%E0%A6%9B%E0%A7%87">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>৩ কোম্পানির প্রথম প্রান্তিক প্রকাশ</title>
      <link>https://www.deshrupantor.com/735483/%E0%A7%A9-%E0%A6%95%E0%A7%8B%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B6</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735483/%E0%A7%A9-%E0%A6%95%E0%A7%8B%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B6</guid>
      <pubDate>Mon, 16 Nov 2026 01:15:37 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/32221e2251384170fac6cad09238bd8d-6af9ea6fc0fb6.jpg?jadewits_media_id=242865" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/32221e2251384170fac6cad09238bd8d-6af9ea6fc0fb6.jpg?jadewits_media_id=242865" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/32221e2251384170fac6cad09238bd8d-6af9ea6fc0fb6.jpg?jadewits_media_id=242865" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৩ কোম্পানির প্রথম প্রান্তিক প্রকাশ" /&gt;&lt;/p&gt;&lt;p&gt;শেয়ারবাজারে তালিকাভুক্ত তিনটি প্রতিষ্ঠান চলতি হিসাব বর্ষের প্রথম প্রান্তিকের হিসাব প্রকাশ করেছে। কোম্পানিগুলো হচ্ছে সোনারগাঁও টেক্সটাইল, বিডি থাই এবং পেনিনসুলা চিটাগং।
সোনারগাঁও টেক্সটাইলস : তালিকাভুক্ত সোনারগাঁও টেক্সটাইলস লিমিটেড চলতি হিসাববছরের প্রথম প্রান্তিকের (জুলাই-সেপ্টেম্বর ২০২৬) অনিরীক্ষিত&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735483/%E0%A7%A9-%E0%A6%95%E0%A7%8B%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B6">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>যুক্তরাষ্ট্রের শেয়ারবাজারে এনভিডিয়ার শেয়ারে দরপতনে প্রভাব</title>

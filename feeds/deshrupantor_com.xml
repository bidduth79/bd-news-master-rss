    </item>
    <item>
      <title>বিশ্বজুড়ে মাইক্রোসফটের সেবা বিপর্যয়</title>
      <link>https://www.deshrupantor.com/734801/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%9C%E0%A7%81%E0%A7%9C%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B8%E0%A6%AB%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A6%BE-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A7%9F</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734801/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%9C%E0%A7%81%E0%A7%9C%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B8%E0%A6%AB%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A6%BE-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A7%9F</guid>
      <pubDate>Fri, 13 Nov 2026 09:58:56 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/922e4f2e7762bd3c104ad4454420b57b-6af68ae5636cc.jpg?jadewits_media_id=242176" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/922e4f2e7762bd3c104ad4454420b57b-6af68ae5636cc.jpg?jadewits_media_id=242176" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/922e4f2e7762bd3c104ad4454420b57b-6af68ae5636cc.jpg?jadewits_media_id=242176" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিশ্বজুড়ে মাইক্রোসফটের সেবা বিপর্যয়" /&gt;&lt;/p&gt;&lt;p&gt;বিশ্বজুড়ে বড় ধরনের সেবা বিপর্যয়ের মুখে পড়েছে মাইক্রোসফট। এতে যুক্তরাষ্ট্র, জাপান, সিঙ্গাপুর, যুক্তরাজ্য ও অস্ট্রেলিয়াসহ বিভিন্ন দেশের হাজার হাজার ব্যবহারকারী সমস্যায় পড়েছেন। পরিস্থিতি স্বাভাবিক করতে চেষ্টা চালিয়ে গেলেও এখনো পুরোপুরি নিয়ন্ত্রণে আনতে পারেনি প্রতিষ্ঠানটি। খবর বিবিসির।&amp;nbsp;
এই বিপর্যয়ে&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734801/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%9C%E0%A7%81%E0%A7%9C%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B8%E0%A6%AB%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A6%BE-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A7%9F">দেশ রূপান্তর</source>

    <item>
      <title>ফেসবুকে প্রচার ঢাকাকে দিল্লি হিসেবে প্রচার</title>
      <link>https://www.deshrupantor.com/734262/%E0%A6%AB%E0%A7%87%E0%A6%B8%E0%A6%AC%E0%A7%81%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BF-%E0%A6%B9%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%9A%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734262/%E0%A6%AB%E0%A7%87%E0%A6%B8%E0%A6%AC%E0%A7%81%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BF-%E0%A6%B9%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%9A%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Wed, 11 Nov 2026 07:22:31 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/4511c02e014b3ac3184fdb377db1f339-6af36cf0080dc.jpg?jadewits_media_id=241681" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/4511c02e014b3ac3184fdb377db1f339-6af36cf0080dc.jpg?jadewits_media_id=241681" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/4511c02e014b3ac3184fdb377db1f339-6af36cf0080dc.jpg?jadewits_media_id=241681" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফেসবুকে প্রচার ঢাকাকে দিল্লি হিসেবে প্রচার" /&gt;&lt;/p&gt;&lt;p&gt;চীনের কয়েকজন সামাজিক ইনফ্লুয়েন্সার ঢাকার বিভিন্ন স্থানকে দিল্লির স্থান হিসেবে দেখিয়ে ভিডিও তৈরি করে সামাজিক মাধ্যমে প্রচার করছে। এমন দাবি করে তাদের বিরুদ্ধে ব্যবস্থা নেওয়ার আহ্বান জানিয়েছে ভারতের পররাষ্ট্র মন্ত্রণালয়।
ভারতের পররাষ্ট্র মন্ত্রণালয়ের মুখপাত্র রণধীর জয়সওয়াল গতকাল মঙ্গলবার দিল্লিতে নিয়মি&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734262/%E0%A6%AB%E0%A7%87%E0%A6%B8%E0%A6%AC%E0%A7%81%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BF-%E0%A6%B9%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%9A%E0%A6%BE%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>গাছের সঙ্গে বাঁধা তরুণীর মরদেহ উদ্ধার</title>
      <link>https://www.deshrupantor.com/734261/%E0%A6%97%E0%A6%BE%E0%A6%9B%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%81%E0%A6%A7%E0%A6%BE-%E0%A6%A4%E0%A6%B0%E0%A7%81%E0%A6%A3%E0%A7%80%E0%A6%B0-%E0%A6%AE%E0%A6%B0%E0%A6%A6%E0%A7%87%E0%A6%B9-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734261/%E0%A6%97%E0%A6%BE%E0%A6%9B%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%81%E0%A6%A7%E0%A6%BE-%E0%A6%A4%E0%A6%B0%E0%A7%81%E0%A6%A3%E0%A7%80%E0%A6%B0-%E0%A6%AE%E0%A6%B0%E0%A6%A6%E0%A7%87%E0%A6%B9-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Wed, 11 Nov 2026 07:22:03 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/4511c02e014b3ac3184fdb377db1f339-6af36cf0080dc.jpg?jadewits_media_id=241681" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/4511c02e014b3ac3184fdb377db1f339-6af36cf0080dc.jpg?jadewits_media_id=241681" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/4511c02e014b3ac3184fdb377db1f339-6af36cf0080dc.jpg?jadewits_media_id=241681" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গাছের সঙ্গে বাঁধা তরুণীর মরদেহ উদ্ধার" /&gt;&lt;/p&gt;&lt;p&gt;মৌলভীবাজারের কুলাউড়া উপজেলার জয়চ-ী ইউনিয়নে গাছের সঙ্গে বাঁধা অবস্থায় এক তরুণীর মরদেহ গতকাল মঙ্গলবার সকালে পুলিশ উদ্ধার করেছে। নিহত তরুণীর নাম মামুনি খাড়িয়া (১৯)। সে পাঁচপীর জালাই গ্রামের রবি খাড়িয়ার মেয়ে। স্থানীয় লোকজন জানান, গাছের সঙ্গে বাঁধা অবস্থায় তরুণীর মরদেহ দেখতে পেয়ে এলাকাবাসী কুলাউড়া থানা প&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734261/%E0%A6%97%E0%A6%BE%E0%A6%9B%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%81%E0%A6%A7%E0%A6%BE-%E0%A6%A4%E0%A6%B0%E0%A7%81%E0%A6%A3%E0%A7%80%E0%A6%B0-%E0%A6%AE%E0%A6%B0%E0%A6%A6%E0%A7%87%E0%A6%B9-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>ডেঙ্গু ও হামে মৃত্যু আরও ১৩</title>
      <link>https://www.deshrupantor.com/734260/%E0%A6%A1%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%81-%E0%A6%93-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A7%A7%E0%A7%A9</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734260/%E0%A6%A1%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%81-%E0%A6%93-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A7%A7%E0%A7%A9</guid>
      <pubDate>Wed, 11 Nov 2026 07:21:46 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/4511c02e014b3ac3184fdb377db1f339-6af36cf0080dc.jpg?jadewits_media_id=241681" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/4511c02e014b3ac3184fdb377db1f339-6af36cf0080dc.jpg?jadewits_media_id=241681" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/4511c02e014b3ac3184fdb377db1f339-6af36cf0080dc.jpg?jadewits_media_id=241681" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডেঙ্গু ও হামে মৃত্যু আরও ১৩" /&gt;&lt;/p&gt;&lt;p&gt;দেশে ২৪ ঘণ্টায় ডেঙ্গুতে আক্রান্ত হয়ে আরও ৮ জনের মৃত্যু হয়েছে। হাসপাতালে ভর্তি হয়েছে ১ হাজার ৫৯৫ জন। এ ছাড়াও হাম উপসর্গে ৫ শিশু মারা গেছে। সব মিলিয়ে ডেঙ্গু ও হাম উপসর্গে ১৩ জনের মৃত্যু হয়েছে। গতকাল মঙ্গলবার স্বাস্থ্য অধিদপ্তরের হেলথ ইমার্জেন্সি অপারেশন সেন্টার ও কন্ট্রোলরুম থেকে পাঠানো ডেঙ্গু ও হামবি&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734260/%E0%A6%A1%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%81-%E0%A6%93-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A7%A7%E0%A7%A9">দেশ রূপান্তর</source>
    </item>

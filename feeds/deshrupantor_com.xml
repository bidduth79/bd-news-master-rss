    <item>
      <title>সাবেক কাউন্সিলর মানিকের ১০ বছরের কারাদন্ড</title>
      <link>https://www.deshrupantor.com/737730/%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%95%E0%A6%BE%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%B8%E0%A6%BF%E0%A6%B2%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A7%A7%E0%A7%A6-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%A6%E0%A6%A8%E0%A7%8D%E0%A6%A1</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737730/%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%95%E0%A6%BE%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%B8%E0%A6%BF%E0%A6%B2%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A7%A7%E0%A7%A6-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%A6%E0%A6%A8%E0%A7%8D%E0%A6%A1</guid>
      <pubDate>Wed, 25 Nov 2026 07:40:33 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/8aeb69427687c7f57e7504571e5ffda2-6b05eaba15411.jpg?jadewits_media_id=245016" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/8aeb69427687c7f57e7504571e5ffda2-6b05eaba15411.jpg?jadewits_media_id=245016" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/8aeb69427687c7f57e7504571e5ffda2-6b05eaba15411.jpg?jadewits_media_id=245016" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাবেক কাউন্সিলর মানিকের ১০ বছরের কারাদন্ড" /&gt;&lt;/p&gt;&lt;p&gt;দুর্নীতির মামলায় ঢাকা উত্তর সিটি করপোরেশনের (ডিএনসিসি) ৩ নম্বর ওয়ার্ডের সাবেক কাউন্সিলর কাজী জহিরুল ইসলাম মানিককে ১০ বছরের কারাদন্ড দিয়েছে আদালত। গতকাল মঙ্গলবার ঢাকার বিশেষ জজ নূরে আলম ভূঁইয়া এ দন্ড দেন।&amp;nbsp; দুর্নীতি দমন কমিশনের (দুদক) প্রসিকিউটর তরিকুল ইসলাম জানান, &amp;lsquo;জ্ঞাত আয়বহির্ভূত সম্পদ অ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737730/%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%95%E0%A6%BE%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%B8%E0%A6%BF%E0%A6%B2%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A7%A7%E0%A7%A6-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%A6%E0%A6%A8%E0%A7%8D%E0%A6%A1">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>সশস্ত্র বাহিনীতে ফেরত রাষ্ট্রদূত মে. জে. জাহাঙ্গীর আলম</title>
      <link>https://www.deshrupantor.com/737729/%E0%A6%B8%E0%A6%B6%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%A4-%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A7%82%E0%A6%A4-%E0%A6%AE%E0%A7%87.-%E0%A6%9C%E0%A7%87.-%E0%A6%9C%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%80%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737729/%E0%A6%B8%E0%A6%B6%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%A4-%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A7%82%E0%A6%A4-%E0%A6%AE%E0%A7%87.-%E0%A6%9C%E0%A7%87.-%E0%A6%9C%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%80%E0%A6%B0</guid>
      <pubDate>Wed, 25 Nov 2026 07:40:03 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/8aeb69427687c7f57e7504571e5ffda2-6b05eaba15411.jpg?jadewits_media_id=245016" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/8aeb69427687c7f57e7504571e5ffda2-6b05eaba15411.jpg?jadewits_media_id=245016" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/8aeb69427687c7f57e7504571e5ffda2-6b05eaba15411.jpg?jadewits_media_id=245016" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সশস্ত্র বাহিনীতে ফেরত রাষ্ট্রদূত মে. জে. জাহাঙ্গীর আলম" /&gt;&lt;/p&gt;&lt;p&gt;গত মার্চে রাষ্ট্রদূত হিসেবে নিয়োগপ্রাপ্ত মেজর জেনারেল মো. জাহাঙ্গীর আলমকে সশস্ত্র বাহিনীতে ফেরত পাঠানো হয়েছে। গতকাল মঙ্গলবার জনপ্রশাসন মন্ত্রণালয় এক প্রজ্ঞাপনে এ তথ্য দিয়েছে। তিনি রাষ্ট্রদূত হিসেবে নিয়োগ পাওয়ার আগে প্রতিরক্ষা গোয়েন্দা মহাপরিদপ্তরের (ডিজিএফআই) মহাপরিচালকের দায়িত্ব পালন করেছেন।
চলতি ব&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737729/%E0%A6%B8%E0%A6%B6%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%A4-%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A7%82%E0%A6%A4-%E0%A6%AE%E0%A7%87.-%E0%A6%9C%E0%A7%87.-%E0%A6%9C%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%80%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>রাজধানীতে আ.লীগের ৪ নেতা গ্রেপ্তার</title>
      <link>https://www.deshrupantor.com/737728/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A7%AA-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737728/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A7%AA-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Wed, 25 Nov 2026 07:39:46 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/8aeb69427687c7f57e7504571e5ffda2-6b05eaba15411.jpg?jadewits_media_id=245016" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/8aeb69427687c7f57e7504571e5ffda2-6b05eaba15411.jpg?jadewits_media_id=245016" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/8aeb69427687c7f57e7504571e5ffda2-6b05eaba15411.jpg?jadewits_media_id=245016" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজধানীতে আ.লীগের ৪ নেতা গ্রেপ্তার" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীতে পৃথক অভিযান চালিয়ে কার্যক্রম নিষিদ্ধ আওয়ামী লীগ ও এর অঙ্গ সংগঠনের চার নেতাকে গ্রেপ্তার করেছে ঢাকা মহানগর গোয়েন্দা পুলিশ (ডিবি) ও থানা পুলিশ। গ্রেপ্তার ব্যক্তিরা হলেন&amp;Ntilde; আওয়ামী লীগের কেন্দ্রীয় কমিটির শিল্প ও বাণিজ্যবিষয়ক সদস্য কেএসএম মোস্তাফিজুর রহমান, ছাত্রলীগের কেন্দ্রীয় নির্বাহী সংস&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737728/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A7%AA-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0">দেশ রূপান্তর</source>

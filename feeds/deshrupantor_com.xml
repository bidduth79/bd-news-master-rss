    <item>
      <title>রুহিতপুরে তাঁতিদের মজুরি ঘণ্টায় ২৮ টাকা ১২ পয়সা!</title>
      <link>https://www.deshrupantor.com/737185/%E0%A6%B0%E0%A7%81%E0%A6%B9%E0%A6%BF%E0%A6%A4%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%A4%E0%A6%BE%E0%A6%81%E0%A6%A4%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%9C%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A7%9F-%E0%A7%A8%E0%A7%AE-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A7%A7%E0%A7%A8-%E0%A6%AA%E0%A7%9F%E0%A6%B8%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737185/%E0%A6%B0%E0%A7%81%E0%A6%B9%E0%A6%BF%E0%A6%A4%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%A4%E0%A6%BE%E0%A6%81%E0%A6%A4%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%9C%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A7%9F-%E0%A7%A8%E0%A7%AE-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A7%A7%E0%A7%A8-%E0%A6%AA%E0%A7%9F%E0%A6%B8%E0%A6%BE</guid>
      <pubDate>Mon, 23 Nov 2026 02:03:39 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/a36cdd4b33471e68c9a046a550875e61-6b0349ca6fc11.jpg?jadewits_media_id=244523" length="0" type="image/jpeg" />

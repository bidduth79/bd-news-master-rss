      <guid isPermaLink="true">https://www.deshrupantor.com/735331/%E0%A6%A1%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%81-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%81%E0%A6%9E%E0%A7%8D%E0%A6%9C-%E0%A6%9F%E0%A6%BE%E0%A6%A8%E0%A6%AA%E0%A6%BE%E0%A7%9C%E0%A6%BE-%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A3-%E0%A6%B8%E0%A7%8B%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%9F%E0%A6%BF%E0%A6%B0</guid>
      <pubDate>Sun, 15 Nov 2026 14:42:46 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/cecabc5bb39374762cad475772bc3eb3-6af970473ee38.jpg?jadewits_media_id=242734" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/cecabc5bb39374762cad475772bc3eb3-6af970473ee38.jpg?jadewits_media_id=242734" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/cecabc5bb39374762cad475772bc3eb3-6af970473ee38.jpg?jadewits_media_id=242734" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডেঙ্গু প্রতিরোধে নিকুঞ্জ টানপাড়া কল্যাণ সোসাইটির সামাজিক আন্দোলন" /&gt;&lt;/p&gt;&lt;p&gt;ডেঙ্গুর ঝুঁকি কমাতে জনসচেতনতা সৃষ্টি ও পরিচ্ছন্ন পরিবেশ নিশ্চিত করার লক্ষ্যে মাঠে নেমেছে নিকুঞ্জ টানপাড়া কল্যাণ সোসাইটি। মশক নিধন বা এক দিনের পরিচ্ছন্নতা অভিযানেই সীমাবদ্ধ না থেকে ডেঙ্গু প্রতিরোধকে স্থায়ী সামাজিক আন্দোলনে রূপ দিতে কাজ করছে সংগঠনটি। এ লক্ষ্যে আবাসিক এলাকাকে নিরাপদ ও স্বাস্থ্যকর রাখতে&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735331/%E0%A6%A1%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%81-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%81%E0%A6%9E%E0%A7%8D%E0%A6%9C-%E0%A6%9F%E0%A6%BE%E0%A6%A8%E0%A6%AA%E0%A6%BE%E0%A7%9C%E0%A6%BE-%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A3-%E0%A6%B8%E0%A7%8B%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%9F%E0%A6%BF%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>শ্রীপুরে আগুনে পুড়ল প্রবাসীর ১৩ বসতঘর</title>
      <link>https://www.deshrupantor.com/735330/%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A7%9C%E0%A6%B2-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%80%E0%A6%B0-%E0%A7%A7%E0%A7%A9-%E0%A6%AC%E0%A6%B8%E0%A6%A4%E0%A6%98%E0%A6%B0%C2%A0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735330/%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A7%9C%E0%A6%B2-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%80%E0%A6%B0-%E0%A7%A7%E0%A7%A9-%E0%A6%AC%E0%A6%B8%E0%A6%A4%E0%A6%98%E0%A6%B0%C2%A0</guid>
      <pubDate>Sun, 15 Nov 2026 14:38:34 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/bf64a943860eb51fc7d422a409881ffc-6af96f87ca4f2.jpg?jadewits_media_id=242733" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/bf64a943860eb51fc7d422a409881ffc-6af96f87ca4f2.jpg?jadewits_media_id=242733" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/bf64a943860eb51fc7d422a409881ffc-6af96f87ca4f2.jpg?jadewits_media_id=242733" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শ্রীপুরে আগুনে পুড়ল প্রবাসীর ১৩ বসতঘর" /&gt;&lt;/p&gt;&lt;p&gt;গাজীপুরের শ্রীপুরে একটি খাবার হোটেলের গ্যাস সিলিন্ডার থেকে লাগা আগুনে দুবাইপ্রবাসীর ১৩টি বসতঘর পুড়ে গেছে। আগুনে ঘরগুলোর আসবাবপত্রসহ মূল্যবান মালামাল পুড়ে ছাই হয়ে গেছে। তবে এ ঘটনায় কোনো হতাহতের খবর পাওয়া যায়নি।
রবিবার (১৫ নভেম্বর) সকাল সাড়ে ৯টার দিকে শ্রীপুর পৌরসভার গড়গড়িয়া মাস্টারবাড়ি এলাকার ডেনিম্য&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735330/%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A7%9C%E0%A6%B2-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%80%E0%A6%B0-%E0%A7%A7%E0%A7%A9-%E0%A6%AC%E0%A6%B8%E0%A6%A4%E0%A6%98%E0%A6%B0%C2%A0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>সম্মানসূচক অস্কার পাচ্ছেন গ্লেন ক্লোজ</title>

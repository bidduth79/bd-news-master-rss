    <item>
      <title>হংকং থেকে মসলার আড়ালে এলো ৩০ কেজি সিসা, গ্রেফতার ৩</title>
      <link>https://www.deshrupantor.com/734814/%E0%A6%B9%E0%A6%82%E0%A6%95%E0%A6%82-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AE%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A7%9C%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%8F%E0%A6%B2%E0%A7%8B-%E0%A7%A9%E0%A7%A6-%E0%A6%95%E0%A7%87%E0%A6%9C%E0%A6%BF-%E0%A6%B8%E0%A6%BF%E0%A6%B8%E0%A6%BE-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A7%A9</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734814/%E0%A6%B9%E0%A6%82%E0%A6%95%E0%A6%82-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AE%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A7%9C%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%8F%E0%A6%B2%E0%A7%8B-%E0%A7%A9%E0%A7%A6-%E0%A6%95%E0%A7%87%E0%A6%9C%E0%A6%BF-%E0%A6%B8%E0%A6%BF%E0%A6%B8%E0%A6%BE-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A7%A9</guid>
      <pubDate>Fri, 13 Nov 2026 11:48:15 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/968503dd60dda1d95c4099786835d6f5-6af6a466a8482.jpg?jadewits_media_id=242187" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/968503dd60dda1d95c4099786835d6f5-6af6a466a8482.jpg?jadewits_media_id=242187" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/968503dd60dda1d95c4099786835d6f5-6af6a466a8482.jpg?jadewits_media_id=242187" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হংকং থেকে মসলার আড়ালে এলো ৩০ কেজি সিসা, গ্রেফতার ৩" /&gt;&lt;/p&gt;&lt;p&gt;মসলার চালানের আড়ালে হংকং থেকে আমদানি করা হয়েছিল ৩০ কেজি অবৈধ মাদক সিসা। মাদকদ্রব্য নিয়ন্ত্রণ অধিদপ্তরের (ডিএনসি) গোয়েন্দা নজরদারিতে ধরা পড়ে এই মাদক চোরাচালানের ঘটনা। এ ঘটনায় আমদানিকারক ও সিঅ্যান্ডএফ এজেন্টসহ তিনজনকে গ্রেফতার করেছে সংস্থাটি।
ডিএনসির সহকারী পরিচালক মোস্তাক আহমেদের নেতৃত্বে পরিচালিত অভ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734814/%E0%A6%B9%E0%A6%82%E0%A6%95%E0%A6%82-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AE%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A7%9C%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%8F%E0%A6%B2%E0%A7%8B-%E0%A7%A9%E0%A7%A6-%E0%A6%95%E0%A7%87%E0%A6%9C%E0%A6%BF-%E0%A6%B8%E0%A6%BF%E0%A6%B8%E0%A6%BE-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A7%A9">দেশ রূপান্তর</source>
    </item>
    <item>

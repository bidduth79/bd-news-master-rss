      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/309a3feb26ce2ca1ae371da9a4b144e2-6af5e93162648.jpg?jadewits_media_id=242121" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/309a3feb26ce2ca1ae371da9a4b144e2-6af5e93162648.jpg?jadewits_media_id=242121" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/309a3feb26ce2ca1ae371da9a4b144e2-6af5e93162648.jpg?jadewits_media_id=242121" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘বিদেশি প্রেসক্রিপশনের রাজনীতি রুখতে হবে’" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ জামায়াতে ইসলামী কখনো আধিপত্যবাদ মেনে নেবে না বলে মন্তব্য করেছেন দলটির কেন্দ্রীয় সহকারী সেক্রেটারি জেনারেল ড. এএইচএম হামিদুর রহমান আজাদ। তিনি বলেছেন, যারা বিদেশি প্রেসক্রিপশন নিয়ে দেশের রাজনীতি ও স্বার্থকে প্রভাবিত করতে চায়, তাদের অপতৎপরতা রুখে দিতে হবে। জামায়াতের নেতাকর্মীরা একমাত্র আল্লাহর&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734721/%E2%80%98%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B8%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%AA%E0%A6%B6%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A6%BF-%E0%A6%B0%E0%A7%81%E0%A6%96%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%AC%E0%A7%87%E2%80%99">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>কুমিল্লায় চেয়ারম্যান প্রার্থী নিয়ে বিরোধ, এমপির সংবর্ধনা অনুষ্ঠানে সংঘর্ষে আহত ১৫</title>
      <link>https://www.deshrupantor.com/734720/%E0%A6%95%E0%A7%81%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%9A%E0%A7%87%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734720/%E0%A6%95%E0%A7%81%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%9A%E0%A7%87%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF%E0%A6%B0</guid>

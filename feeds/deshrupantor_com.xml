    <item>
      <title>প্রধানমন্ত্রীর রসবোধে প্রাণবন্ত হলো সংসদের অধিবেশন</title>
      <link>https://www.deshrupantor.com/736230/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%B0%E0%A6%B8%E0%A6%AC%E0%A7%8B%E0%A6%A7%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%B9%E0%A6%B2%E0%A7%8B-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%A7%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736230/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%B0%E0%A6%B8%E0%A6%AC%E0%A7%8B%E0%A6%A7%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%B9%E0%A6%B2%E0%A7%8B-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%A7%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%A8</guid>
      <pubDate>Thu, 19 Nov 2026 03:08:16 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/fef2c28d133406f23d47da773220953a-6afe1206370f3.jpg?jadewits_media_id=243614" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/fef2c28d133406f23d47da773220953a-6afe1206370f3.jpg?jadewits_media_id=243614" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/fef2c28d133406f23d47da773220953a-6afe1206370f3.jpg?jadewits_media_id=243614" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রধানমন্ত্রীর রসবোধে প্রাণবন্ত হলো সংসদের অধিবেশন" /&gt;&lt;/p&gt;&lt;p&gt;জাতীয় সংসদের সমাপনী অধিবেশনে প্রধানমন্ত্রী তারেক রহমানের বক্তব্য ঘিরে সৃষ্টি হয় এক ব্যতিক্রমী ও প্রাণবন্ত পরিবেশ। তাঁর বক্তব্যে যেমন সরকারি দলের সংসদ সদস্যরা উচ্ছ্বাস প্রকাশ করেন, তেমনি বিরোধী দলের সদস্যদেরও টেবিল চাপড়ে সমর্থন জানাতে দেখা যায়। রাজনৈতিক মতপার্থক্যের মধ্যে সংসদে এমন দৃশ্যকে বিরল ঘটনা &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736230/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%B0%E0%A6%B8%E0%A6%AC%E0%A7%8B%E0%A6%A7%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%B9%E0%A6%B2%E0%A7%8B-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%A7%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%A8">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>নিরাপত্তা নিশ্চিতকরণে প্রয়োজন জাতীয় ঐক্য</title>
      <link>https://www.deshrupantor.com/736226/%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%9A%E0%A6%BF%E0%A6%A4%E0%A6%95%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%9F%E0%A7%8B%E0%A6%9C%E0%A6%A8-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%90%E0%A6%95%E0%A7%8D%E0%A6%AF</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736226/%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%9A%E0%A6%BF%E0%A6%A4%E0%A6%95%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%9F%E0%A7%8B%E0%A6%9C%E0%A6%A8-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%90%E0%A6%95%E0%A7%8D%E0%A6%AF</guid>
      <pubDate>Thu, 19 Nov 2026 01:28:00 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/23d322fadedf13778869dce509f49749-6afde058d61a6.jpg?jadewits_media_id=243609" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/23d322fadedf13778869dce509f49749-6afde058d61a6.jpg?jadewits_media_id=243609" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/23d322fadedf13778869dce509f49749-6afde058d61a6.jpg?jadewits_media_id=243609" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নিরাপত্তা নিশ্চিতকরণে প্রয়োজন জাতীয় ঐক্য" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ আবারও এক উদ্বেগজনক নিরাপত্তা পরিস্থিতির মুখোমুখি। রাজনৈতিক উত্তেজনা, বোমা ও ককটেল বিস্ফোরণ, যানবাহনে অগ্নিসংযোগ এবং বিভিন্ন স্থাপনায় হামলার ঘটনা জনমনে আতঙ্ক সৃষ্টি করছে। নভেম্বরের প্রথম দুই সপ্তাহে দেশের বিভিন্ন স্থানে ধারাবাহিক সহিংসতা আইনশৃঙ্খলা পরিস্থিতি নিয়ে নতুন করে উদ্বেগ তৈরি করেছে। &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736226/%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%9A%E0%A6%BF%E0%A6%A4%E0%A6%95%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%9F%E0%A7%8B%E0%A6%9C%E0%A6%A8-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%90%E0%A6%95%E0%A7%8D%E0%A6%AF">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>তারুণ্যের ক্ষয়, তারুণ্যের জয়</title>
      <link>https://www.deshrupantor.com/736225/%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A7%81%E0%A6%A3%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%9F-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A7%81%E0%A6%A3%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A7%9F</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736225/%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A7%81%E0%A6%A3%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%9F-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A7%81%E0%A6%A3%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A7%9F</guid>
      <pubDate>Thu, 19 Nov 2026 00:26:00 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/47f51e606e0d7735fc297d5464ba3405-6afde01b1a2e5.jpg?jadewits_media_id=243608" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/47f51e606e0d7735fc297d5464ba3405-6afde01b1a2e5.jpg?jadewits_media_id=243608" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/47f51e606e0d7735fc297d5464ba3405-6afde01b1a2e5.jpg?jadewits_media_id=243608" style="max-width:100%;height:auto;margin-bottom:10px;" alt="তারুণ্যের ক্ষয়, তারুণ্যের জয়" /&gt;&lt;/p&gt;&lt;p&gt;উইলস্টন চার্চিলের ৮০তম জন্মদিনে একজন ফটোগ্রাফার এসে বিনম্রভাবে বললেন, &amp;lsquo;স্যার, আশা করি আমি আপনার ১০০তম জ&amp;scaron;&amp;sect;দিনে ফটো তুলতে পারব। তখন প্রত্যুৎপন্নমতি চার্চিল বললেন, &amp;lsquo;কেন পারবে না? তোমার চেহারা এবং বয়সের দিকে তাকালে মনে হয়, তুমি নিশ্চয়ই পারবে।&amp;rsquo; সত্যিই ভাগ্যবান এবং সুখী চার্চ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736225/%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A7%81%E0%A6%A3%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%9F-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A7%81%E0%A6%A3%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A7%9F">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>নবদিগন্তে নতুন আলোর বাংলাদেশ</title>
      <link>https://www.deshrupantor.com/736224/%E0%A6%A8%E0%A6%AC%E0%A6%A6%E0%A6%BF%E0%A6%97%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%86%E0%A6%B2%E0%A7%8B%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736224/%E0%A6%A8%E0%A6%AC%E0%A6%A6%E0%A6%BF%E0%A6%97%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%86%E0%A6%B2%E0%A7%8B%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6</guid>
      <pubDate>Thu, 19 Nov 2026 00:26:00 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/99c3c70a5c542c8aa17de9945f229357-6afddfd4726d9.jpg?jadewits_media_id=243607" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/99c3c70a5c542c8aa17de9945f229357-6afddfd4726d9.jpg?jadewits_media_id=243607" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/99c3c70a5c542c8aa17de9945f229357-6afddfd4726d9.jpg?jadewits_media_id=243607" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নবদিগন্তে নতুন আলোর বাংলাদেশ" /&gt;&lt;/p&gt;&lt;p&gt;দীর্ঘ প্রতীক্ষা আর ধারাবাহিক কারিগরি পরীক্ষা-নিরীক্ষার পর রূপপুর পারমাণবিক বিদ্যুৎকেন্দ্রের প্রথম ইউনিট থেকে উৎপাদিত বিদ্যুৎ সফলভাবে জাতীয় গ্রিডে যুক্ত হয়েছে। পারমাণবিক শক্তি ও বিদ্যুৎ নিয়ে বিশ্বের বিখ্যাত বিজ্ঞানীরা যেমন অপার সম্ভাবনা ও পরিবেশবান্ধব জ&amp;brvbar;ালানির কথা বলেছেন, তেমনি সতর্কতা ও মানবি&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736224/%E0%A6%A8%E0%A6%AC%E0%A6%A6%E0%A6%BF%E0%A6%97%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%86%E0%A6%B2%E0%A7%8B%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6">দেশ রূপান্তর</source>
    </item>

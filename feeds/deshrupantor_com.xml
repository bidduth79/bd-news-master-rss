    <item>
      <title>বন্দুকযুদ্ধে মেক্সিকোর 'মাদক সম্রাট' গ্রেপ্তার, নিহত ৭</title>
      <link>https://www.deshrupantor.com/736986/%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%81%E0%A6%95%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%AE%E0%A7%87%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%BF%E0%A6%95%E0%A7%8B%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A6%95-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%9F-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736986/%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%81%E0%A6%95%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%AE%E0%A7%87%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%BF%E0%A6%95%E0%A7%8B%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A6%95-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%9F-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Sun, 22 Nov 2026 08:48:21 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/654a2987eb27a8789699d7f0ddd50717-6b02578504bad.jpg?jadewits_media_id=244300" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/654a2987eb27a8789699d7f0ddd50717-6b02578504bad.jpg?jadewits_media_id=244300" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/654a2987eb27a8789699d7f0ddd50717-6b02578504bad.jpg?jadewits_media_id=244300" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বন্দুকযুদ্ধে মেক্সিকোর 'মাদক সম্রাট' গ্রেপ্তার, নিহত ৭" /&gt;&lt;/p&gt;&lt;p&gt;মেক্সিকোর 'কুখ্যাত মাদকসম্রাট' ফাউস্তো ইসিদ্রো &amp;lsquo;চাপো ইসিদ্রো&amp;rsquo; মেসা ফ্লোরেসকে গ্রেপ্তার করেছে দেশটির বিশেষ বাহিনী। যুক্তরাষ্ট্রের কেন্দ্রীয় তদন্ত সংস্থা এফবিআইয়ের (এফবিআই) ১০ শীর্ষ মোস্ট ওয়ান্টেড অপরাধীর তালিকায় ছিলেন তিনি। খবর বিবিসি।&amp;nbsp;
শুক্রবার মেক্সিকোর সিনালোয়া অঙ্গরাজ্যের গুয়াসাভ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736986/%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%81%E0%A6%95%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%AE%E0%A7%87%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%BF%E0%A6%95%E0%A7%8B%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A6%95-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%9F-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0">দেশ রূপান্তর</source>
    </item>

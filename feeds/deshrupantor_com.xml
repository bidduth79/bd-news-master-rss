      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/01ca028bb30d34c09539f023ff633532-6b063cd1d0e46.jpg?jadewits_media_id=245028" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/01ca028bb30d34c09539f023ff633532-6b063cd1d0e46.jpg?jadewits_media_id=245028" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হারিয়ে যাচ্ছে বৈরালি" /&gt;&lt;/p&gt;&lt;p&gt;১৬টি নদ-নদী বেষ্টিত কুড়িগ্রামে একসময় জাল ফেললেই ধরা পড়ত সুস্বাদু বৈরালি মাছ। তিস্তা, ধরলা, দুধকুমার ও ব্রহ্মপুত্র নদে প্রচুর পরিমাণে পাওয়া এই মাছের চাহিদা এখনো তুঙ্গে, তবে নদ-নদীতে এর দেখা মিলছে খুব কম। বাজারে পাওয়া গেলেও আকারভেদে প্রতি কেজি বৈরালি বিক্রি হচ্ছে ৪০০ থেকে ৬০০ টাকায়। নদীতে পানির প্রবাহ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737733/%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%AC%E0%A7%88%E0%A6%B0%E0%A6%BE%E0%A6%B2%E0%A6%BF">দেশ রূপান্তর</source>
    </item>

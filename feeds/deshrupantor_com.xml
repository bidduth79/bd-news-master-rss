    <item>
      <title>শহীদ আবু সাঈদের নামে স্টেডিয়াম উদ্বোধন</title>
      <link>https://www.deshrupantor.com/736901/%E0%A6%B6%E0%A6%B9%E0%A7%80%E0%A6%A6-%E0%A6%86%E0%A6%AC%E0%A7%81-%E0%A6%B8%E0%A6%BE%E0%A6%88%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%A1%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%AE-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%8B%E0%A6%A7%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736901/%E0%A6%B6%E0%A6%B9%E0%A7%80%E0%A6%A6-%E0%A6%86%E0%A6%AC%E0%A7%81-%E0%A6%B8%E0%A6%BE%E0%A6%88%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%A1%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%AE-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%8B%E0%A6%A7%E0%A6%A8</guid>
      <pubDate>Sat, 21 Nov 2026 23:59:15 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/744d1005d4d36ab895f9615952bd92ef-6b01dbb6b691d.jpg?jadewits_media_id=244241" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/744d1005d4d36ab895f9615952bd92ef-6b01dbb6b691d.jpg?jadewits_media_id=244241" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/744d1005d4d36ab895f9615952bd92ef-6b01dbb6b691d.jpg?jadewits_media_id=244241" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শহীদ আবু সাঈদের নামে স্টেডিয়াম উদ্বোধন" /&gt;&lt;/p&gt;&lt;p&gt;জুলাই গণ-অভ্যুত্থানের প্রথম শহীদ রংপুরের কৃতী সন্তান আবু সাঈদের স্মৃতি সংরক্ষণে রংপুর স্টেডিয়ামের নাম পরিবর্তন করে &amp;lsquo;শহীদ আবু সাঈদ স্টেডিয়াম&amp;rsquo; করা হয়েছে। একই সঙ্গে উদ্বোধন করা হয়েছে &amp;lsquo;শহীদ আবু সাঈদ ইনডোর স্টেডিয়াম&amp;rsquo;। &amp;nbsp;শনিবার (২১ নভেম্বর) দুপুর ২টার দিকে শহীদ আবু সাঈদের বাবা-&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736901/%E0%A6%B6%E0%A6%B9%E0%A7%80%E0%A6%A6-%E0%A6%86%E0%A6%AC%E0%A7%81-%E0%A6%B8%E0%A6%BE%E0%A6%88%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%A1%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%AE-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%8B%E0%A6%A7%E0%A6%A8">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>হারের মুখ থেকে ইমনের চার-ছক্কায় নাটকীয় জয়</title>
      <link>https://www.deshrupantor.com/736900/%E0%A6%87%E0%A6%AE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%9B%E0%A6%95%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%BE%E0%A6%9F%E0%A6%95%E0%A7%80%E0%A7%9F-%E0%A6%9C%E0%A7%9F</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736900/%E0%A6%87%E0%A6%AE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%9B%E0%A6%95%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%BE%E0%A6%9F%E0%A6%95%E0%A7%80%E0%A7%9F-%E0%A6%9C%E0%A7%9F</guid>
      <pubDate>Sun, 22 Nov 2026 00:23:41 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/ac9c7cf1fd015d6c0bea35e47a87bd6d-6b01db71dc440.jpg?jadewits_media_id=244240" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/ac9c7cf1fd015d6c0bea35e47a87bd6d-6b01db71dc440.jpg?jadewits_media_id=244240" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/ac9c7cf1fd015d6c0bea35e47a87bd6d-6b01db71dc440.jpg?jadewits_media_id=244240" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হারের মুখ থেকে ইমনের চার-ছক্কায় নাটকীয় জয়" /&gt;&lt;/p&gt;&lt;p&gt;এশিয়া কাপ রাইজিং স্টার্সে আফগানিস্তান 'এ' দলের বিপক্ষে স্নায়ুক্ষয়ী এক লড়াইয়ে ১ উইকেটের নাটকীয় জয় পেয়েছে বাংলাদেশ 'এ' দল। ১৭৫ রানের লক্ষ্য তাড়া করতে নেমে শেষ দিকে ৯ উইকেট হারিয়ে চাপে পড়ে গেলেও ৪৬তম ওভারে ইকবাল হোসেন ইমন চার ও ছক্কায় জয় তুলে নেন।
শেষ ওভারের নাটকীয়তা
৪৩.৬ ওভারে ৯ উইকেটে ১৬২ রান তুলে ফে&lt;/p&gt;</description>

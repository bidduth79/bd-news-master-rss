    <item>
      <title>ঘিওরে তেরশ্রী গণহত্যা দিবস পালিত</title>
      <link>https://www.deshrupantor.com/737126/%E0%A6%98%E0%A6%BF%E0%A6%93%E0%A6%B0%E0%A7%87-%E0%A6%A4%E0%A7%87%E0%A6%B0%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%97%E0%A6%A3%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%A6%E0%A6%BF%E0%A6%AC%E0%A6%B8-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%A4</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737126/%E0%A6%98%E0%A6%BF%E0%A6%93%E0%A6%B0%E0%A7%87-%E0%A6%A4%E0%A7%87%E0%A6%B0%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%97%E0%A6%A3%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%A6%E0%A6%BF%E0%A6%AC%E0%A6%B8-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%A4</guid>
      <pubDate>Sun, 22 Nov 2026 22:43:16 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/f0e3f945979d649d12e78df9ecac38de-6b031b4aaad52.gif?jadewits_media_id=244465" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/f0e3f945979d649d12e78df9ecac38de-6b031b4aaad52.gif?jadewits_media_id=244465" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/f0e3f945979d649d12e78df9ecac38de-6b031b4aaad52.gif?jadewits_media_id=244465" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঘিওরে তেরশ্রী গণহত্যা দিবস পালিত" /&gt;&lt;/p&gt;&lt;p&gt;মানিকগঞ্জের ঘিওরে যথাযোগ্য মর্যাদায় ঐতিহাসিক তেরশ্রী গণহত্যা দিবস পালিত হয়েছে। ১৯৭১ সালের ২২ নভেম্বর পাকিস্তানি হানাদার বাহিনী ও তাদের এদেশীয় দোসরদের বর্বরোচিত হামলায় তেরশ্রীসহ আশপাশের চার গ্রামের ৪৩ জন নিরীহ মানুষ শহীদ হন।
দিবসটি উপলক্ষে রবিবার (২২ নভেম্বর) সকালে জাতীয় পতাকা উত্তোলন, শহীদদের প্রতি &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737126/%E0%A6%98%E0%A6%BF%E0%A6%93%E0%A6%B0%E0%A7%87-%E0%A6%A4%E0%A7%87%E0%A6%B0%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%97%E0%A6%A3%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%A6%E0%A6%BF%E0%A6%AC%E0%A6%B8-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%A4">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>ঘিওরে ৪৩ শহীদকে শ্রদ্ধা জানালেন জিন্নাহ কবির এমপি</title>
      <link>https://www.deshrupantor.com/737125/%E0%A6%98%E0%A6%BF%E0%A6%93%E0%A6%B0%E0%A7%87-%E0%A7%AA%E0%A7%A9-%E0%A6%B6%E0%A6%B9%E0%A7%80%E0%A6%A6%E0%A6%95%E0%A7%87-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%9C%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A6%BE%E0%A6%B9-%E0%A6%95%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737125/%E0%A6%98%E0%A6%BF%E0%A6%93%E0%A6%B0%E0%A7%87-%E0%A7%AA%E0%A7%A9-%E0%A6%B6%E0%A6%B9%E0%A7%80%E0%A6%A6%E0%A6%95%E0%A7%87-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%9C%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A6%BE%E0%A6%B9-%E0%A6%95%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF</guid>
      <pubDate>Sun, 22 Nov 2026 22:39:14 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/ac7cd429c3c6c4d22c32bb76c1b3378e-6b0319a51f85b.gif?jadewits_media_id=244464" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/ac7cd429c3c6c4d22c32bb76c1b3378e-6b0319a51f85b.gif?jadewits_media_id=244464" medium="image" />

    <item>
      <title>পাগলা মসজিদের দানবাক্সে ১০ কোটি টাকা</title>
      <link>https://www.deshrupantor.com/736983/%E0%A6%AA%E0%A6%BE%E0%A6%97%E0%A6%B2%E0%A6%BE-%E0%A6%AE%E0%A6%B8%E0%A6%9C%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A7%87-%E0%A7%A7%E0%A7%A6-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736983/%E0%A6%AA%E0%A6%BE%E0%A6%97%E0%A6%B2%E0%A6%BE-%E0%A6%AE%E0%A6%B8%E0%A6%9C%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A7%87-%E0%A7%A7%E0%A7%A6-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE</guid>
      <pubDate>Sun, 22 Nov 2026 07:54:37 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/4a829b046b514a2514a2fe14db42a86f-6b02461d404ee.jpg?jadewits_media_id=244274" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/4a829b046b514a2514a2fe14db42a86f-6b02461d404ee.jpg?jadewits_media_id=244274" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/4a829b046b514a2514a2fe14db42a86f-6b02461d404ee.jpg?jadewits_media_id=244274" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পাগলা মসজিদের দানবাক্সে ১০ কোটি টাকা" /&gt;&lt;/p&gt;&lt;p&gt;কিশোরগঞ্জের পাগলা মসজিদের দানবাক্সে এবার পাওয়া গেছে স্বর্ণের চামচ ও বাটি। গতকাল শনিবার সকালে মসজিদের ১৫টি দানবাক্স খুলে পাওয়া রেকর্ড ৫১ বস্তা টাকা গণনার সময় এসব স্বর্ণালংকার পাওয়া যায়। বিষয়টি নিশ্চিত করেছেন পাগলা মসজিদের ইমাম মুফতি মিজবাহ উদ্দীন।
গতকাল সকাল ৭টার দিকে ১৫টি দানবাক্স খোলা হয়। পরে দানবা&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736983/%E0%A6%AA%E0%A6%BE%E0%A6%97%E0%A6%B2%E0%A6%BE-%E0%A6%AE%E0%A6%B8%E0%A6%9C%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A7%87-%E0%A7%A7%E0%A7%A6-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>পোশাক খাত নিয়ে নানা ষড়যন্ত্র উসকানি চলছে</title>

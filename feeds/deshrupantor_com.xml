    <item>
      <title>এলপিজিতে সুখবর ডিসেম্বরে কমতে পারে দাম</title>
      <link>https://www.deshrupantor.com/737969/%E0%A6%8F%E0%A6%B2%E0%A6%AA%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A7%81%E0%A6%96%E0%A6%AC%E0%A6%B0-%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%87-%E0%A6%95%E0%A6%AE%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%A6%E0%A6%BE%E0%A6%AE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737969/%E0%A6%8F%E0%A6%B2%E0%A6%AA%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A7%81%E0%A6%96%E0%A6%AC%E0%A6%B0-%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%87-%E0%A6%95%E0%A6%AE%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%A6%E0%A6%BE%E0%A6%AE</guid>
      <pubDate>Thu, 26 Nov 2026 01:25:48 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/7c06b1388280580d1cbb9e25063db9b1-6b0723a152e03.jpg?jadewits_media_id=245229" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/7c06b1388280580d1cbb9e25063db9b1-6b0723a152e03.jpg?jadewits_media_id=245229" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/7c06b1388280580d1cbb9e25063db9b1-6b0723a152e03.jpg?jadewits_media_id=245229" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এলপিজিতে সুখবর ডিসেম্বরে কমতে পারে দাম" /&gt;&lt;/p&gt;&lt;p&gt;টানা দরবৃদ্ধির পর ডিসেম্বরে কমতে পারে তরলীকৃত পেট্রোলিয়াম গ্যাসের (এলপিজি) দাম। অপারেটররা বলছেন নভেম্বরের মাঝামাঝি থেকে আন্তর্জাতিক বাজারে এলপিজির দাম কমতে শুরু করেছে। মধ্যপ্রাচ্যে আবারও কোনো গুরুতর ঘটনা না ঘটলে টনপ্রতি ১৫০ ডলার কমতে পারে। এতে ১২ কেজির বোতলে ২০০ থেকে ২৪০ টাকা দাম কমতে পারে বলে ধারণা&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737969/%E0%A6%8F%E0%A6%B2%E0%A6%AA%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A7%81%E0%A6%96%E0%A6%AC%E0%A6%B0-%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%87-%E0%A6%95%E0%A6%AE%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%A6%E0%A6%BE%E0%A6%AE">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>দেশে মোট ভোটার ১৩ কোটি</title>
      <link>https://www.deshrupantor.com/737968/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AE%E0%A7%8B%E0%A6%9F-%E0%A6%AD%E0%A7%8B%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A7%A7%E0%A7%A9-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737968/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AE%E0%A7%8B%E0%A6%9F-%E0%A6%AD%E0%A7%8B%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A7%A7%E0%A7%A9-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF</guid>
      <pubDate>Thu, 26 Nov 2026 01:25:18 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/7c06b1388280580d1cbb9e25063db9b1-6b0723a152e03.jpg?jadewits_media_id=245229" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/7c06b1388280580d1cbb9e25063db9b1-6b0723a152e03.jpg?jadewits_media_id=245229" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/7c06b1388280580d1cbb9e25063db9b1-6b0723a152e03.jpg?jadewits_media_id=245229" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দেশে মোট ভোটার ১৩ কোটি" /&gt;&lt;/p&gt;&lt;p&gt;দেশে এখন সর্বমোট ভোটার ১২ কোটি ৯২ লাখ ২৯ হাজার ৭৪৯ জন। আসন্ন ইউনিয়ন পরিষদ (ইউপি) নির্বাচন সামনে রেখে চূড়ান্ত ভোটার তালিকা প্রকাশ করল নির্বাচন কমিশন (ইসি)। গতকাল বুধবার আগারগাঁওয়ের নির্বাচন ভবনে সাংবাদিকদের এ তথ্য জানান ইসি সচিব আখতার আহমেদ। এদিকে কিশোরগঞ্জ-৩ (করিমগঞ্জ-তাড়াইল) আসনের উপনির্বাচন আগামী &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737968/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AE%E0%A7%8B%E0%A6%9F-%E0%A6%AD%E0%A7%8B%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A7%A7%E0%A7%A9-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF">দেশ রূপান্তর</source>
    </item>

    <item>
      <title>গোপালগঞ্জের বেশ কয়েকটি ককটেল বিস্ফোরণ</title>
      <link>https://www.deshrupantor.com/733994/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%87%E0%A6%B6-%E0%A6%95%E0%A7%9F%E0%A7%87%E0%A6%95%E0%A6%9F%E0%A6%BF-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/733994/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%87%E0%A6%B6-%E0%A6%95%E0%A7%9F%E0%A7%87%E0%A6%95%E0%A6%9F%E0%A6%BF-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3</guid>
      <pubDate>Tue, 10 Nov 2026 05:33:34 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/047d2658afe2ff9ea1daa41bb58d401a-6af25831d9b59.jpg?jadewits_media_id=241439" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/047d2658afe2ff9ea1daa41bb58d401a-6af25831d9b59.jpg?jadewits_media_id=241439" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/047d2658afe2ff9ea1daa41bb58d401a-6af25831d9b59.jpg?jadewits_media_id=241439" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গোপালগঞ্জের বেশ কয়েকটি ককটেল বিস্ফোরণ" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জের বিভিন্ন স্থানে ককটেল বিস্ফোরণ ও সড়কের উপরে আগুন জ্বালিয়ে অবরোধের ঘটনা ঘটেছে।&amp;nbsp;
সোমবার (৯ নভেম্বর) রাতে শহরের জেলা স্কুলের প্রধান ফটক, সরকারি মহিলা কলেজের দেয়াল, পাসপোর্ট অফিসের দেয়াল এবং সরকারি টেকনিক্যাল স্কুল অ্যান্ড কলেজের ফটকসহ শহরের বিভিন্ন স্থানে ককটেল বিস্ফোরণের শব্দ শোনা যায়।&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/733994/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%87%E0%A6%B6-%E0%A6%95%E0%A7%9F%E0%A7%87%E0%A6%95%E0%A6%9F%E0%A6%BF-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>'জয় বাংলা’ স্লোগান দিয়ে ঢাকা-বগুড়া মহাসড়কে অগ্নিসংযোগ</title>

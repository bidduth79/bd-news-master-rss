    <item>
      <title>২৪ ঘণ্টায় ঢাকায় গ্রেপ্তার ৪৯৯</title>
      <link>https://www.deshrupantor.com/738025/%E0%A7%A8%E0%A7%AA-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A7%AA%E0%A7%AF%E0%A7%AF</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/738025/%E0%A7%A8%E0%A7%AA-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A7%AA%E0%A7%AF%E0%A7%AF</guid>
      <pubDate>Thu, 26 Nov 2026 10:37:20 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/09/15/f4a4d25662e1b7136f74e305abf0fa28-6aa8f766ae96e.jpg?jadewits_media_id=228429" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/09/15/f4a4d25662e1b7136f74e305abf0fa28-6aa8f766ae96e.jpg?jadewits_media_id=228429" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/09/15/f4a4d25662e1b7136f74e305abf0fa28-6aa8f766ae96e.jpg?jadewits_media_id=228429" style="max-width:100%;height:auto;margin-bottom:10px;" alt="২৪ ঘণ্টায় ঢাকায় গ্রেপ্তার ৪৯৯" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীতে নিয়মিত অভিযান চালিয়ে গত ২৪ ঘণ্টায় ৪৯৯ জন গ্রেপ্তার করেছে ঢাকা মেট্রোপলিটন পুলিশ (ডিএমপি)। একই সময়ে ৫২টি মামলা করা হয়েছে। বৃহস্পতিবার (২৬ নভেম্বর) ডিএমপির এক সংবাদ বিজ্ঞপ্তিতে গ্রেপ্তার ও মামলার বিষয়ে জানানো হয়।
এতে বলা হয়, গ্রেপ্তারদের মধ্যে রমনা বিভাগ থেকে ২৩ জন, লালবাগ বিভাগে ৫৯, ওয়ারী ব&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/738025/%E0%A7%A8%E0%A7%AA-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A7%AA%E0%A7%AF%E0%A7%AF">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>শেখ হাসিনার সাবেক উপপ্রেস সচিবসহ গ্রেপ্তার ৪</title>
      <link>https://www.deshrupantor.com/738024/%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%89%E0%A6%AA%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B8-%E0%A6%B8%E0%A6%9A%E0%A6%BF%E0%A6%AC%E0%A6%B8%E0%A6%B9-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A7%AA</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/738024/%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%89%E0%A6%AA%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B8-%E0%A6%B8%E0%A6%9A%E0%A6%BF%E0%A6%AC%E0%A6%B8%E0%A6%B9-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A7%AA</guid>
      <pubDate>Thu, 26 Nov 2026 10:30:37 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/f717e37afa3b03fdf0ccd4a0c6fd8046-6b07b5bedc0cd.jpg?jadewits_media_id=245286" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/f717e37afa3b03fdf0ccd4a0c6fd8046-6b07b5bedc0cd.jpg?jadewits_media_id=245286" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/f717e37afa3b03fdf0ccd4a0c6fd8046-6b07b5bedc0cd.jpg?jadewits_media_id=245286" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শেখ হাসিনার সাবেক উপপ্রেস সচিবসহ গ্রেপ্তার ৪" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর ধানমন্ডি এলাকা থেকে ক্ষমতাচ্যুত প্রধানমন্ত্রী শেখ হাসিনার উপপ্রেস সচিব কে এম শাখাওয়াত মুন, সাবেক জেলা প্রশাসক (ডিসি) মোহাম্মদ ইলিয়াস হোসেন এবং আয়কর আইনজীবী সুফি মো. আল মামুনকে আটক করে পুলিশের কাছে হস্তান্তর করেন ছাত্রদলের নেতাকর্মীরা।
বুধবার (২৫ নভেম্বর) রাত ১টার দিকে ধানমন্ডি ২৭ নম্বর এলাক&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/738024/%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%89%E0%A6%AA%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B8-%E0%A6%B8%E0%A6%9A%E0%A6%BF%E0%A6%AC%E0%A6%B8%E0%A6%B9-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A7%AA">দেশ রূপান্তর</source>
    </item>

    <item>
      <title>খেলনা পিস্তল দেখিয়ে চুরি, অতঃপর যা ঘটল</title>
      <link>https://www.deshrupantor.com/734181/%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%B2-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%85%E0%A6%A4%E0%A6%83%E0%A6%AA%E0%A6%B0-%E0%A6%AF%E0%A6%BE-%E0%A6%98%E0%A6%9F%E0%A6%B2</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734181/%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%B2-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%85%E0%A6%A4%E0%A6%83%E0%A6%AA%E0%A6%B0-%E0%A6%AF%E0%A6%BE-%E0%A6%98%E0%A6%9F%E0%A6%B2</guid>
      <pubDate>Tue, 10 Nov 2026 22:06:37 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/85b1094e95547c0a3103551d0eac8bab-6af3404b3058e.jpg?jadewits_media_id=241631" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/85b1094e95547c0a3103551d0eac8bab-6af3404b3058e.jpg?jadewits_media_id=241631" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/85b1094e95547c0a3103551d0eac8bab-6af3404b3058e.jpg?jadewits_media_id=241631" style="max-width:100%;height:auto;margin-bottom:10px;" alt="খেলনা পিস্তল দেখিয়ে চুরি, অতঃপর যা ঘটল" /&gt;&lt;/p&gt;&lt;p&gt;রাঙামাটির রাজস্থলী উপজেলার বাঙ্গালহালিয়া ইউনিয়নে খেলনা পিস্তল দেখিয়ে ভয়ভীতি প্রদর্শন করে দুই লাখ টাকা ও স্বর্ণালংকার চুরির ঘটনায় স্থানীয়দের গণপিটুনিতে মো. রফিক (২৩) নামে এক ব্যক্তির মৃত্যু হয়েছে।
মঙ্গলবার (১০ নভেম্বর) সন্ধ্যায় গুরুতর আহত অবস্থায় তাকে কাপ্তাই উপজেলা স্বাস্থ্য কমপ্লেক্সে নেওয়া হলে কর্&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734181/%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%B2-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%85%E0%A6%A4%E0%A6%83%E0%A6%AA%E0%A6%B0-%E0%A6%AF%E0%A6%BE-%E0%A6%98%E0%A6%9F%E0%A6%B2">দেশ রূপান্তর</source>

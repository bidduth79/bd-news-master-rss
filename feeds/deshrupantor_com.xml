    <item>
      <title>নিকুঞ্জে প্রতিবন্ধী শিশুকে ধর্ষণের অভিযোগ, ছাত্রদল নেতার বিরুদ্ধে মামলা</title>
      <link>https://www.deshrupantor.com/736887/%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%81%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A7%80-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%95%E0%A7%87-%E0%A6%A7%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A6%B2</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736887/%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%81%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A7%80-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%95%E0%A7%87-%E0%A6%A7%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A6%B2</guid>
      <pubDate>Sat, 21 Nov 2026 21:46:29 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/d1774a54bfe32bfff932a131e0787c61-6b01bcc54cca6.jpg?jadewits_media_id=244226" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/d1774a54bfe32bfff932a131e0787c61-6b01bcc54cca6.jpg?jadewits_media_id=244226" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/d1774a54bfe32bfff932a131e0787c61-6b01bcc54cca6.jpg?jadewits_media_id=244226" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নিকুঞ্জে প্রতিবন্ধী শিশুকে ধর্ষণের অভিযোগ, ছাত্রদল নেতার বিরুদ্ধে মামলা" /&gt;&lt;/p&gt;&lt;p&gt;যে শিশুটি ঠিকমতো কথাও বলতে পারে না, যে বুঝতেই শেখে না পৃথিবীর নিষ্ঠুরতা&amp;mdash;তার ওপরই নেমে এল পাশবিক নির্যাতন। রাজধানীর খিলক্ষেত থানাধীন নিকুঞ্জ-২ এলাকায় ১২ বছর বয়সী এক শারীরিক ও মানসিক প্রতিবন্ধী শিশুকে ধর্ষণের অভিযোগ উঠেছে।&amp;nbsp;
এ ঘটনায় মো. ইমামুল হোসেন বাপ্পী (৩১) নামের একজনের বিরুদ্ধে মামলা হয়&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736887/%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%81%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A7%80-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%95%E0%A7%87-%E0%A6%A7%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A6%B2">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>সিজেএফবির বিশেষ সম্মাননা পাচ্ছেন আজিজুল হাকিম</title>

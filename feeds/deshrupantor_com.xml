    <item>
      <title>আসুন সবাই মিলে সুস্থ ও সুন্দর দেশ গড়ে তুলি: রাষ্ট্রপতি</title>
      <link>https://www.deshrupantor.com/734883/%E0%A6%86%E0%A6%B8%E0%A7%81%E0%A6%A8-%E0%A6%B8%E0%A6%AC%E0%A6%BE%E0%A6%87-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A7%87-%E0%A6%B8%E0%A7%81%E0%A6%B8%E0%A7%8D%E0%A6%A5-%E0%A6%93-%E0%A6%B8%E0%A7%81%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%B0-%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%97%E0%A7%9C%E0%A7%87-%E0%A6%A4%E0%A7%81%E0%A6%B2%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734883/%E0%A6%86%E0%A6%B8%E0%A7%81%E0%A6%A8-%E0%A6%B8%E0%A6%AC%E0%A6%BE%E0%A6%87-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A7%87-%E0%A6%B8%E0%A7%81%E0%A6%B8%E0%A7%8D%E0%A6%A5-%E0%A6%93-%E0%A6%B8%E0%A7%81%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%B0-%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%97%E0%A7%9C%E0%A7%87-%E0%A6%A4%E0%A7%81%E0%A6%B2%E0%A6%BF</guid>
      <pubDate>Fri, 13 Nov 2026 19:08:21 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/30164c32145f60a82a16b3f7d347826e-6af70ba18de7b.jpg?jadewits_media_id=242265" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/30164c32145f60a82a16b3f7d347826e-6af70ba18de7b.jpg?jadewits_media_id=242265" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/30164c32145f60a82a16b3f7d347826e-6af70ba18de7b.jpg?jadewits_media_id=242265" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আসুন সবাই মিলে সুস্থ ও সুন্দর দেশ গড়ে তুলি: রাষ্ট্রপতি" /&gt;&lt;/p&gt;&lt;p&gt;রাষ্ট্রপতি মির্জা ফখরুল ইসলাম আলমগীর বলেছেন, আসুন সবাই মিলে সুস্থ ও সুন্দর দেশ গড়ে তুলি। তিনি আরও বলেন, ডায়াবেটিসের ক্ষতিকর প্রভাব থেকে বাঁচতে সকলকে সচেতন হতে হবে এবং নিয়মিত রক্ত পরীক্ষা করতে হবে।&amp;nbsp;আগামীকাল &amp;lsquo;বিশ্ব ডায়াবেটিস দিবস&amp;rsquo; উপলক্ষ্যে আজ শুক্রবার (১৩ নভেম্বর ) দেওয়া এক বাণীতে রা&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734883/%E0%A6%86%E0%A6%B8%E0%A7%81%E0%A6%A8-%E0%A6%B8%E0%A6%AC%E0%A6%BE%E0%A6%87-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A7%87-%E0%A6%B8%E0%A7%81%E0%A6%B8%E0%A7%8D%E0%A6%A5-%E0%A6%93-%E0%A6%B8%E0%A7%81%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%B0-%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%97%E0%A7%9C%E0%A7%87-%E0%A6%A4%E0%A7%81%E0%A6%B2%E0%A6%BF">দেশ রূপান্তর</source>

    <item>
      <title>প্রথমবার হলিউডে শাবনূর</title>
      <link>https://www.deshrupantor.com/738620/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%B2%E0%A6%BF%E0%A6%89%E0%A6%A1%E0%A7%87-%E0%A6%B6%E0%A6%BE%E0%A6%AC%E0%A6%A8%E0%A7%82%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/738620/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%B2%E0%A6%BF%E0%A6%89%E0%A6%A1%E0%A7%87-%E0%A6%B6%E0%A6%BE%E0%A6%AC%E0%A6%A8%E0%A7%82%E0%A6%B0</guid>
      <pubDate>Sat, 28 Nov 2026 21:29:01 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/0e40f1b0784d5c29eef5358e3787c891-6b0aee59284fd.jpg?jadewits_media_id=245896" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/0e40f1b0784d5c29eef5358e3787c891-6b0aee59284fd.jpg?jadewits_media_id=245896" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/0e40f1b0784d5c29eef5358e3787c891-6b0aee59284fd.jpg?jadewits_media_id=245896" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রথমবার হলিউডে শাবনূর" /&gt;&lt;/p&gt;&lt;p&gt;দেশীয় চলচ্চিত্রের এক সময়ের শীর্ষ নায়িকা শাবনূর দীর্ঘদিন ধরেই অভিনয় থেকে দূরে গিয়ে স্থায়ীভাবে বাস করছেন অস্ট্রেলিয়ায়। ভ্রমণপিপাসু এই তারকা সুযোগ পেলেই ছুটে যান নতুন কোনো গন্তব্যে। আর ভ্রমণের সেই আনন্দঘন মুহূর্তগুলো তিনি শেয়ার করেন ভক্তদের সঙ্গে।&amp;nbsp;

সালমানের জন্মদিনে স্মৃতিকাতর শাবনূর

সেই ধারাবাহ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/738620/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%B2%E0%A6%BF%E0%A6%89%E0%A6%A1%E0%A7%87-%E0%A6%B6%E0%A6%BE%E0%A6%AC%E0%A6%A8%E0%A7%82%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>এআই যুগের জন্য ডিগ্রি নতুন করে সাজাচ্ছে স্ট্যানফোর্ড, বাংলাদেশের বিশ্ববিদ্যালয়গুলো কী করছে?</title>
      <link>https://www.deshrupantor.com/738619/%E0%A6%8F%E0%A6%86%E0%A6%87-%E0%A6%AF%E0%A7%81%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%A1%E0%A6%BF%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BF-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/738619/%E0%A6%8F%E0%A6%86%E0%A6%87-%E0%A6%AF%E0%A7%81%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%A1%E0%A6%BF%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BF-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87</guid>
      <pubDate>Sat, 28 Nov 2026 21:28:17 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/8ec66a0042917f48d4b7582b45bda06d-6b0af13fdf780.jpg?jadewits_media_id=245898" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/8ec66a0042917f48d4b7582b45bda06d-6b0af13fdf780.jpg?jadewits_media_id=245898" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/8ec66a0042917f48d4b7582b45bda06d-6b0af13fdf780.jpg?jadewits_media_id=245898" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এআই যুগের জন্য ডিগ্রি নতুন করে সাজাচ্ছে স্ট্যানফোর্ড, বাংলাদেশের বিশ্ববিদ্যালয়গুলো কী করছে?" /&gt;&lt;/p&gt;&lt;p&gt;একজন শিক্ষার্থী বাড়িতে বসে ব্যবসায়িক প্রতিবেদন লিখলেন। ভাষা ঝরঝরে, তথ্য সাজানো, সুপারিশও চমৎকার। শিক্ষক ভালো নম্বর দিলেন। কিন্তু শিক্ষার্থী কি সমস্যাটি নিজে বুঝেছেন? প্রতিবেদনের কোনো তথ্য ভুল হলে তিনি কি তা ধরতে পারবেন? সুপারিশটি বাস্তবে প্রয়োগ করতে গেলে কী ঝুঁকি আছে, তা কি ব্যাখ্যা করতে পারবেন?
কৃত&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/738619/%E0%A6%8F%E0%A6%86%E0%A6%87-%E0%A6%AF%E0%A7%81%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%A1%E0%A6%BF%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BF-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>প্রধানমন্ত্রী তারেক রহমানের নেতৃত্বে আমরা ঐক্যবদ্ধ: জসীম উদ্দিন এমপি</title>
      <link>https://www.deshrupantor.com/738618/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%B0%E0%A6%B9%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A7%87-%E0%A6%86%E0%A6%AE%E0%A6%B0%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/738618/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%B0%E0%A6%B9%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A7%87-%E0%A6%86%E0%A6%AE%E0%A6%B0%E0%A6%BE</guid>
      <pubDate>Sat, 28 Nov 2026 21:34:11 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/8ad63d4a1e68f157ad3c60220b2e6983-6b0aeed98b4d8.gif?jadewits_media_id=245897" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/8ad63d4a1e68f157ad3c60220b2e6983-6b0aeed98b4d8.gif?jadewits_media_id=245897" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/8ad63d4a1e68f157ad3c60220b2e6983-6b0aeed98b4d8.gif?jadewits_media_id=245897" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রধানমন্ত্রী তারেক রহমানের নেতৃত্বে আমরা ঐক্যবদ্ধ: জসীম উদ্দিন এমপি" /&gt;&lt;/p&gt;&lt;p&gt;দেশব্যাপী সন্ত্রাস ও নৈরাজ্যের প্রতিবাদে বিএনপি ঘোষিত ডিসেম্বর মাসব্যাপী কর্মসূচি উপলক্ষে চন্দনাইশে প্রস্তুতি সভা অনুষ্ঠিত হয়েছে।
শনিবার (২৮ নভেম্বর) বদুরপাড়ার সংসদ সদস্যের বাসভবনে চন্দনাইশ উপজেলা বিএনপি, চন্দনাইশ পৌরসভা, দোহাজারী পৌরসভা, উত্তর সাতকানিয়া সাংগঠনিক বিএনপি ও অঙ্গ-সহযোগী সংগঠনের যৌথ &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/738618/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%B0%E0%A6%B9%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A7%87-%E0%A6%86%E0%A6%AE%E0%A6%B0%E0%A6%BE">দেশ রূপান্তর</source>

    <item>
      <title>পাবনায় ৪৬৬ বস্তা সার জব্দ, ৩ জনকে জরিমানা</title>
      <link>https://www.deshrupantor.com/737848/%E0%A6%AA%E0%A6%BE%E0%A6%AC%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A7%AA%E0%A7%AC%E0%A7%AC-%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE-%E0%A6%B8%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A6%AC%E0%A7%8D%E0%A6%A6-%E0%A7%A9-%E0%A6%9C%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A6%9C%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%BE</link>

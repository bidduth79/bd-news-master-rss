      <guid isPermaLink="true">https://www.deshrupantor.com/738011/%E0%A6%B6%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%B0-%E0%A6%B6%E0%A6%A8%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A7%80%E0%A6%B0%E0%A7%8D%E0%A6%98%E0%A6%B8%E0%A6%AE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A7%8E-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%AC%E0%A7%87-%E0%A6%A8%E0%A6%BE-%E0%A6%AF%E0%A7%87%E0%A6%B8%E0%A6%AC-%E0%A6%8F%E0%A6%B2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F</guid>
      <pubDate>Thu, 26 Nov 2026 08:27:40 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2025/11/05/c3fddcaa71ef205c0aea2b53b3cacebf-690ad1c8d88b1.jpg?jadewits_media_id=149816" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2025/11/05/c3fddcaa71ef205c0aea2b53b3cacebf-690ad1c8d88b1.jpg?jadewits_media_id=149816" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2025/11/05/c3fddcaa71ef205c0aea2b53b3cacebf-690ad1c8d88b1.jpg?jadewits_media_id=149816" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শুক্র-শনিবার দীর্ঘসময় বিদ্যুৎ থাকবে না যেসব এলাকায়" /&gt;&lt;/p&gt;&lt;p&gt;জরুরি মেরামত ও রক্ষণাবেক্ষণ কাজের জন্য আগামীকাল শুক্র ও শনিবার (২৭ ও ২৮ নভেম্বর) রাজশাহী ও সিরাজগঞ্জের বিভিন্ন এলাকায় দীর্ঘসময় বিদ্যুৎ সরবরাহ বন্ধ থাকবে। নর্দান ইলেকট্রিসিটি সাপ্লাই পিএলসি (নেসকো) রাজশাহীর বিক্রয় ও বিতরণ বিভাগ-৫ এবং সিরাজগঞ্জের বিক্রয় ও বিতরণ বিভাগ-১ পৃথক বিজ্ঞপ্তিতে এ তথ্য জানিয়েছে&lt;/p&gt;</description>

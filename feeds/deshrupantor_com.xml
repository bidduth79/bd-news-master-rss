      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/3f34fba5adc6222d1361dc695d1e561f-6af76df013b99.jpg?jadewits_media_id=242371" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/3f34fba5adc6222d1361dc695d1e561f-6af76df013b99.jpg?jadewits_media_id=242371" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/3f34fba5adc6222d1361dc695d1e561f-6af76df013b99.jpg?jadewits_media_id=242371" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মসলা আমদানির আড়ালে দেশে আসছে সিসা" /&gt;&lt;/p&gt;&lt;p&gt;হংকং থেকে মসলার আড়ালে আমদানি করা হয় সিসা। দুই মাসের গোয়েন্দা নজরদারি ও অভিযানে এ আমদানি চক্রের সন্ধান পেয়েছে মাদকদ্রব্য নিয়ন্ত্রণ অধিদপ্তর (ডিএনসি)। এ ঘটনায় আমদানিকারক, সরবরাহকারী ও সংশ্লিষ্ট প্রতিষ্ঠানের মালিকসহ তিনজনকে গ্রেপ্তারের পর জব্দ করা হয়েছে ৩০ কেজি সিসা। এ ছাড়া চক্রের আরও কয়েকজনের সংশ্লিষ্&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734986/%E0%A6%AE%E0%A6%B8%E0%A6%B2%E0%A6%BE-%E0%A6%86%E0%A6%AE%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%B0-%E0%A6%86%E0%A7%9C%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%86%E0%A6%B8%E0%A6%9B%E0%A7%87-%E0%A6%B8%E0%A6%BF%E0%A6%B8%E0%A6%BE">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>হামে মৃত্যু ছাড়াল ১ হাজার ৩০০</title>
      <link>https://www.deshrupantor.com/734985/%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%B2-%E0%A7%A7-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A7%A9%E0%A7%A6%E0%A7%A6</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734985/%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%B2-%E0%A7%A7-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A7%A9%E0%A7%A6%E0%A7%A6</guid>
      <pubDate>Sat, 14 Nov 2026 02:06:49 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/3dc8a54c29fc7da7b9926477a8585c6f-6af76dc3c58d7.jpg?jadewits_media_id=242370" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/3dc8a54c29fc7da7b9926477a8585c6f-6af76dc3c58d7.jpg?jadewits_media_id=242370" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/3dc8a54c29fc7da7b9926477a8585c6f-6af76dc3c58d7.jpg?jadewits_media_id=242370" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হামে মৃত্যু ছাড়াল ১ হাজার ৩০০" /&gt;&lt;/p&gt;&lt;p&gt;দেশে গত ২৪ ঘণ্টায় হাম উপসর্গে আরও ৫ শিশুর মৃত্যু হয়েছে। একই সময়ে ডেঙ্গুতে আক্রান্ত হয়ে ২ জনের মৃত্যু হয়েছে। সব মিলিয়ে হাম উপসর্গ ও ডেঙ্গুতে একদিনে ৭ জনের মৃত্যু হয়েছে। চলতি বছরে শুধু হামজনিত মৃত্যু ১ হাজার ৩০০ ছাড়িয়েছে। গতকাল শুক্রবার স্বাস্থ্য অধিদপ্তরের হেলথ ইমার্জেন্সি অপারেশন সেন্টার ও কন্ট্রোলর&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734985/%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%B2-%E0%A7%A7-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A7%A9%E0%A7%A6%E0%A7%A6">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>ডিডি আর্ট গ্যালারিতে ৩৫ শিল্পীর শিল্পকর্ম</title>
      <link>https://www.deshrupantor.com/734984/%E0%A6%A1%E0%A6%BF%E0%A6%A1%E0%A6%BF-%E0%A6%86%E0%A6%B0%E0%A7%8D%E0%A6%9F-%E0%A6%97%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A7%A9%E0%A7%AB-%E0%A6%B6%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A7%80%E0%A6%B0-%E0%A6%B6%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734984/%E0%A6%A1%E0%A6%BF%E0%A6%A1%E0%A6%BF-%E0%A6%86%E0%A6%B0%E0%A7%8D%E0%A6%9F-%E0%A6%97%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A7%A9%E0%A7%AB-%E0%A6%B6%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A7%80%E0%A6%B0-%E0%A6%B6%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE</guid>
      <pubDate>Sat, 14 Nov 2026 02:06:08 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/249fa5f90a337b53b4595749328f300f-6af76da9930a3.jpg?jadewits_media_id=242369" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/249fa5f90a337b53b4595749328f300f-6af76da9930a3.jpg?jadewits_media_id=242369" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/249fa5f90a337b53b4595749328f300f-6af76da9930a3.jpg?jadewits_media_id=242369" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডিডি আর্ট গ্যালারিতে ৩৫ শিল্পীর শিল্পকর্ম" /&gt;&lt;/p&gt;&lt;p&gt;দেশের ৩৫ জন প্রতিষ্ঠিত ও উদীয়মান সমসাময়িক শিল্পীর অংশগ্রহণে রাজধানীর গুলশানে ডিডি আর্ট গ্যালারিতে দলীয় শিল্পকর্ম প্রদর্শনী শুরু হয়েছে। গতকাল শুক্রবার সন্ধ্যা সাড়ে ৬টায় গুলশান ১-এর ২৭ নম্বর সড়কে ডিডি আর্ট গ্যালারিতে এ প্রদর্শনীর উদ্বোধন করা হয়। প্রদর্শনী চলবে আগামী ৩ ডিসেম্বর পর্যন্ত।
অনুষ্ঠানে প্রধা&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734984/%E0%A6%A1%E0%A6%BF%E0%A6%A1%E0%A6%BF-%E0%A6%86%E0%A6%B0%E0%A7%8D%E0%A6%9F-%E0%A6%97%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A7%A9%E0%A7%AB-%E0%A6%B6%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A7%80%E0%A6%B0-%E0%A6%B6%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE">দেশ রূপান্তর</source>

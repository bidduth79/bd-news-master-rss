    <item>
      <title>বিএনপির দুই গ্রুপে সংঘর্ষ : পথচারী নিহত</title>
      <link>https://www.deshrupantor.com/736298/%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%AA%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%B0%E0%A7%8D%E0%A6%B7-%E0%A6%AA%E0%A6%A5%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736298/%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%AA%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%B0%E0%A7%8D%E0%A6%B7-%E0%A6%AA%E0%A6%A5%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4</guid>
      <pubDate>Thu, 19 Nov 2026 07:43:35 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/03988f864549f889688234a254d2ce68-6afe5120869bb.jpg?jadewits_media_id=243654" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/03988f864549f889688234a254d2ce68-6afe5120869bb.jpg?jadewits_media_id=243654" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/03988f864549f889688234a254d2ce68-6afe5120869bb.jpg?jadewits_media_id=243654" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিএনপির দুই গ্রুপে সংঘর্ষ : পথচারী নিহত" /&gt;&lt;/p&gt;&lt;p&gt;নারায়ণগঞ্জের ফতুল্লায় পূর্ববিরোধের জেরে বিএনপির দুই পক্ষের সংঘর্ষে বাড়িঘর ভাঙচুর ও লুটপাটের ঘটনা ঘটেছে। সংঘর্ষের ভিডিও ধারণ করার সময় দুর্বৃত্তদের ধারালো অস্ত্রের আঘাতে গুরুতর আহত হন পথচারী ইউসুফ। পরে স্থানীয়রা তাকে উদ্ধার করে ঢাকা মেডিকেল কলেজ (ঢামেক) হাসপাতালে নিয়ে গেলে চিকিৎসাধীন অবস্থায় তার মৃত্য&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736298/%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%AA%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%B0%E0%A7%8D%E0%A6%B7-%E0%A6%AA%E0%A6%A5%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>গণভোটের রায় মানলে সরকারকে সহযোগিতা করবে জামায়াত</title>

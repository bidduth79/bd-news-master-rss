    <item>
      <title>রাজশাহীতে ‘ছাত্রলীগ’ ধরে পুলিশে দেওয়া নিয়ে ছাত্রদলের দুপক্ষের সংঘর্ষ</title>
      <link>https://www.deshrupantor.com/737977/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A7%80%E0%A6%A4%E0%A7%87-%E2%80%98%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%80%E0%A6%97%E2%80%99-%E0%A6%A7%E0%A6%B0%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737977/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A7%80%E0%A6%A4%E0%A7%87-%E2%80%98%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%80%E0%A6%97%E2%80%99-%E0%A6%A7%E0%A6%B0%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87</guid>
      <pubDate>Thu, 26 Nov 2026 01:32:41 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/3667ccbab75c23774d98891aa0a23323-6b0737d25cc74.jpg?jadewits_media_id=245265" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/3667ccbab75c23774d98891aa0a23323-6b0737d25cc74.jpg?jadewits_media_id=245265" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/3667ccbab75c23774d98891aa0a23323-6b0737d25cc74.jpg?jadewits_media_id=245265" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজশাহীতে ‘ছাত্রলীগ’ ধরে পুলিশে দেওয়া নিয়ে ছাত্রদলের দুপক্ষের সংঘর্ষ" /&gt;&lt;/p&gt;&lt;p&gt;রাজশাহীতে নিষিদ্ধ ছাত্রলীগের এক নেতাকে পুলিশের হাতে তুলে দেওয়াকে কেন্দ্র করে গভীর রাতে সংঘর্ষে জড়িয়েছে ছাত্রদলের দুই গ্রুপ। দফায় দফায় ধাওয়া-পাল্টাধাওয়া ও সংঘর্ষে এলোপাতাড়ি ইটপাটকেল নিক্ষেপের ঘটনা ঘটে। পরিস্থিতি নিয়ন্ত্রণে আনতে পুলিশ টিয়ার শেল নিক্ষেপ করে। গত মঙ্গলবার রাত সাড়ে ১২টার দিকে নগরের জাদুঘর&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737977/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A7%80%E0%A6%A4%E0%A7%87-%E2%80%98%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%80%E0%A6%97%E2%80%99-%E0%A6%A7%E0%A6%B0%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>আ.লীগ বাংলাদেশে আর রাজনীতি করতে পারবে না</title>

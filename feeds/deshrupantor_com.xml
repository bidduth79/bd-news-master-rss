      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/ec22e408b6d2a874b7908abcc25916be-6b07b2f0cce51.jpg?jadewits_media_id=245285" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/ec22e408b6d2a874b7908abcc25916be-6b07b2f0cce51.jpg?jadewits_media_id=245285" medium="image" />

      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/9ebf95208af69181cb3e0e5df027ab94-6b05c42b832bb.gif?jadewits_media_id=244971" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিস্ফোরক আইনে মামলায় আইনজীবী রবিউল আলম বুদু কারাগারে" /&gt;&lt;/p&gt;&lt;p&gt;ধানমন্ডি মডেল থানায় বিস্ফোরক দ্রব্য আইনের মামলায় গ্রেপ্তার সাবেক ছাত্রলীগ নেতা ও সুপ্রিম কোর্টের আইনজীবী মো. রবিউল আলম বুদুকে কারাগারে পাঠিয়েছে আদালত।
মঙ্গলবার (২৪ নভেম্বর) ঢাকার মেট্রোপলিটন ম্যাজিস্ট্রেট মো. ইসমাইল &amp;nbsp;মামলার তদন্ত কর্মকর্তা ধানমন্ডি মডেল থানায় উপপরিদর্শক মো. মাহবুব উল আলমের আবেদ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737656/%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%95-%E0%A6%86%E0%A6%87%E0%A6%A8%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%86%E0%A6%87%E0%A6%A8%E0%A6%9C%E0%A7%80%E0%A6%AC%E0%A7%80-%E0%A6%B0%E0%A6%AC%E0%A6%BF%E0%A6%89%E0%A6%B2-%E0%A6%86%E0%A6%B2%E0%A6%AE-%E0%A6%AC%E0%A7%81%E0%A6%A6%E0%A7%81">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>দেশে প্রথমবারের মতো `হোয়াইট ফ্রাইডে’ অফার, নভোএয়ারের টিকিটে ২৬% ছাড়</title>
      <link>https://www.deshrupantor.com/737655/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%A4%E0%A7%8B-%E0%A6%B9%E0%A7%8B%E0%A7%9F%E0%A6%BE%E0%A6%87%E0%A6%9F-%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%87%E0%A6%A1%E0%A7%87%E2%80%99-%E0%A6%85%E0%A6%AB%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737655/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%A4%E0%A7%8B-%E0%A6%B9%E0%A7%8B%E0%A7%9F%E0%A6%BE%E0%A6%87%E0%A6%9F-%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%87%E0%A6%A1%E0%A7%87%E2%80%99-%E0%A6%85%E0%A6%AB%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Tue, 24 Nov 2026 23:07:57 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/b3c5366a01281f894b4c97aedc1b43c6-6b05c0d52388c.gif?jadewits_media_id=244969" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/b3c5366a01281f894b4c97aedc1b43c6-6b05c0d52388c.gif?jadewits_media_id=244969" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/b3c5366a01281f894b4c97aedc1b43c6-6b05c0d52388c.gif?jadewits_media_id=244969" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দেশে প্রথমবারের মতো `হোয়াইট ফ্রাইডে’ অফার, নভোএয়ারের টিকিটে ২৬% ছাড়" /&gt;&lt;/p&gt;&lt;p&gt;দেশের এভিয়েশন খাতে প্রথমবারের মতো ‘হোয়াইট ফ্রাইডে’ ক্যাম্পেইন ঘোষণা করেছে নভোএয়ার। বিশেষ এই অফারে নভোএয়ারের সব রুটের টিকিটে সন্মানিত যাত্রীরা পাবেন ২৬ শতাংশ মূল্যছাড়।
অফারটি উপভোগ করতে আগ্রহী যাত্রীদের আগামী ২৭ ও ২৮ নভেম্বর এই দুই দিনের মধ্যে  যে কোন দিন ভ্রমণের জন্য  টিকিট ক্রয় করতে হবে।VQWHITE26 প&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737655/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%A4%E0%A7%8B-%E0%A6%B9%E0%A7%8B%E0%A7%9F%E0%A6%BE%E0%A6%87%E0%A6%9F-%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%87%E0%A6%A1%E0%A7%87%E2%80%99-%E0%A6%85%E0%A6%AB%E0%A6%BE%E0%A6%B0">দেশ রূপান্তর</source>
    </item>

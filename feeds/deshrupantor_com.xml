    </item>
    <item>
      <title>ইনস্টাগ্রামে স্টোরিতে ভুল হলে ঠিক করা যাবে</title>
      <link>https://www.deshrupantor.com/736903/%E0%A6%87%E0%A6%A8%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%8B%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AD%E0%A7%81%E0%A6%B2-%E0%A6%B9%E0%A6%B2%E0%A7%87-%E0%A6%A0%E0%A6%BF%E0%A6%95-%E0%A6%95%E0%A6%B0%E0%A6%BE-%E0%A6%AF%E0%A6%BE%E0%A6%AC%E0%A7%87</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736903/%E0%A6%87%E0%A6%A8%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%8B%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AD%E0%A7%81%E0%A6%B2-%E0%A6%B9%E0%A6%B2%E0%A7%87-%E0%A6%A0%E0%A6%BF%E0%A6%95-%E0%A6%95%E0%A6%B0%E0%A6%BE-%E0%A6%AF%E0%A6%BE%E0%A6%AC%E0%A7%87</guid>
      <pubDate>Sun, 22 Nov 2026 00:26:51 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/542d33e7c81ea26486fc9401c891ad90-6b01e2626d8f3.jpg?jadewits_media_id=244243" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/542d33e7c81ea26486fc9401c891ad90-6b01e2626d8f3.jpg?jadewits_media_id=244243" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/542d33e7c81ea26486fc9401c891ad90-6b01e2626d8f3.jpg?jadewits_media_id=244243" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইনস্টাগ্রামে স্টোরিতে ভুল হলে ঠিক করা যাবে" /&gt;&lt;/p&gt;&lt;p&gt;ছবি বা ভিডিও দিয়ে ইনস্টাগ্রাম স্টোরি পোস্ট করার পর দেখলেন বানান ভুল করেছেন। কিন্তু এত দিন তা সংশোধনের সহজ উপায় ছিল না। ভুল ঠিক করতে অনেক সময় স্টোরি মুছে নতুন করে পোস্ট করতে হতো। তবে এবার সেই ঝামেলা কমাতে নতুন সুবিধা আনছে ইনস্টাগ্রাম। স্টোরি প্রকাশ করার পরও ১৫ মিনিট পর্যন্ত সেটি এডিট করার সুযোগ পাবেন&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736903/%E0%A6%87%E0%A6%A8%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%8B%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AD%E0%A7%81%E0%A6%B2-%E0%A6%B9%E0%A6%B2%E0%A7%87-%E0%A6%A0%E0%A6%BF%E0%A6%95-%E0%A6%95%E0%A6%B0%E0%A6%BE-%E0%A6%AF%E0%A6%BE%E0%A6%AC%E0%A7%87">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>নিয়ানডারথাল প্রজাতির মানুষ কেন বিলুপ্ত</title>

      <guid isPermaLink="true">https://www.deshrupantor.com/738626/%E0%A6%A4%E0%A7%87%E0%A6%81%E0%A6%A4%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A7%80-%E0%A6%AA%E0%A6%BF%E0%A6%A0%E0%A6%BE-%E0%A6%89%E0%A7%8E%E0%A6%B8%E0%A6%AC-%E0%A6%89%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%8D%E0%A6%AC%E0%A6%B8%E0%A6%BF%E0%A6%A4</guid>
      <pubDate>Sat, 28 Nov 2026 23:00:16 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/4f85f46bbfffd8d8691d00f3500583be-6b0b0456219c4.gif?jadewits_media_id=245906" length="0" type="image/jpeg" />

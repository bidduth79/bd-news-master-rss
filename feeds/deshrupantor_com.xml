    <item>
      <title>চন্দনাইশে মোবাইল কোর্ট, ৩ চালককে জরিমানা</title>
      <link>https://www.deshrupantor.com/734714/%E0%A6%9A%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%A8%E0%A6%BE%E0%A6%87%E0%A6%B6%E0%A7%87-%E0%A6%AE%E0%A7%8B%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%B2-%E0%A6%95%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%9F-%E0%A7%A9-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%95%E0%A6%95%E0%A7%87-%E0%A6%9C%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734714/%E0%A6%9A%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%A8%E0%A6%BE%E0%A6%87%E0%A6%B6%E0%A7%87-%E0%A6%AE%E0%A7%8B%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%B2-%E0%A6%95%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%9F-%E0%A7%A9-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%95%E0%A6%95%E0%A7%87-%E0%A6%9C%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%BE</guid>
      <pubDate>Thu, 12 Nov 2026 22:06:30 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/5af40e060c4d2a42238adaeb4aea1d36-6af5e3a482adc.jpg?jadewits_media_id=242114" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/5af40e060c4d2a42238adaeb4aea1d36-6af5e3a482adc.jpg?jadewits_media_id=242114" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/5af40e060c4d2a42238adaeb4aea1d36-6af5e3a482adc.jpg?jadewits_media_id=242114" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চন্দনাইশে মোবাইল কোর্ট, ৩ চালককে জরিমানা" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রামের চন্দনাইশ উপজেলার বৈলতলী এলাকায় ভ্রাম্যমাণ আদালতের অভিযানে লাইসেন্সবিহীন ট্রাক চালানোসহ বিভিন্ন অপরাধে ৩ যানবাহন চালককে মোট ১২ হাজার টাকা জরিমানা করা হয়েছে।
বৃহস্পতিবার (১২ নভেম্বর) দুপুরে উপজেলা প্রশাসনের উদ্যোগে এ অভিযান পরিচালনা করা হয়। ভ্রাম্যমাণ আদালত পরিচালনা করেন চন্দনাইশ উপজেলা&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734714/%E0%A6%9A%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%A8%E0%A6%BE%E0%A6%87%E0%A6%B6%E0%A7%87-%E0%A6%AE%E0%A7%8B%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%B2-%E0%A6%95%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%9F-%E0%A7%A9-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%95%E0%A6%95%E0%A7%87-%E0%A6%9C%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%BE">দেশ রূপান্তর</source>
    </item>

    <item>
      <title>হাজার কোটির উড়োজাহাজের ঠিকানা ভাঙারিতে</title>
      <link>https://www.deshrupantor.com/733989/%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF%E0%A6%B0-%E0%A6%89%E0%A7%9C%E0%A7%8B%E0%A6%9C%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%A0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%AD%E0%A6%BE%E0%A6%99%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%87</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/733989/%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF%E0%A6%B0-%E0%A6%89%E0%A7%9C%E0%A7%8B%E0%A6%9C%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%A0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%AD%E0%A6%BE%E0%A6%99%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%87</guid>
      <pubDate>Tue, 10 Nov 2026 02:04:23 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/d610faca171d750958fa23e9fce901ad-6af22740d7b97.jpg?jadewits_media_id=241434" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/d610faca171d750958fa23e9fce901ad-6af22740d7b97.jpg?jadewits_media_id=241434" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/d610faca171d750958fa23e9fce901ad-6af22740d7b97.jpg?jadewits_media_id=241434" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হাজার কোটির উড়োজাহাজের ঠিকানা ভাঙারিতে" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর হযরত শাহজালাল আন্তর্জাতিক বিমানবন্দরের কার্গো ভিলেজ ও অপারেশনাল অ্যাপ্রোন এলাকায় দীর্ঘ প্রায় এক যুগ ধরে পড়ে আছে ১২টি পরিত্যক্ত উড়োজাহাজ। এগুলো এখন অ্যাভিয়েশন খাতের গলার কাঁটায় পরিণত হয়েছে। রোদবৃষ্টিতে নষ্ট হওয়া হাজার কোটি টাকার এসব এয়ারক্রাফট আর উড্ডয়নের উপযোগী নয়। বর্তমানে এগুলো &amp;lsquo;স্&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/733989/%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF%E0%A6%B0-%E0%A6%89%E0%A7%9C%E0%A7%8B%E0%A6%9C%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%A0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%AD%E0%A6%BE%E0%A6%99%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%87">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>ফেব্রুয়ারি থেকে পাবলিক বিশ্ববিদ্যালয়ে ভর্তি পরীক্ষা</title>
      <link>https://www.deshrupantor.com/733988/%E0%A6%AB%E0%A7%87%E0%A6%AC%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%AC%E0%A6%B2%E0%A6%BF%E0%A6%95-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87-%E0%A6%AD%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/733988/%E0%A6%AB%E0%A7%87%E0%A6%AC%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%AC%E0%A6%B2%E0%A6%BF%E0%A6%95-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87-%E0%A6%AD%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BF</guid>
      <pubDate>Tue, 10 Nov 2026 02:02:57 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/d1719dc194ba0f74389a5c8c84d90269-6af226a123c32.jpg?jadewits_media_id=241433" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/d1719dc194ba0f74389a5c8c84d90269-6af226a123c32.jpg?jadewits_media_id=241433" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/d1719dc194ba0f74389a5c8c84d90269-6af226a123c32.jpg?jadewits_media_id=241433" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফেব্রুয়ারি থেকে পাবলিক বিশ্ববিদ্যালয়ে ভর্তি পরীক্ষা" /&gt;&lt;/p&gt;&lt;p&gt;এইচএসসি ও সমমান পরীক্ষার ফল পুনর্মূল্যায়ন ও সম্পূরক পরীক্ষার কথা বিবেচনা করে ইউজিসি পাবলিক বিশ্ববিদ্যালয়ে ভর্তি পরীক্ষা পেছানোর সিদ্ধান্ত নিলেও পূর্বঘোষিত সূচিতেই পরীক্ষা নেবে ঢাকা বিশ্ববিদ্যালয়। গতকাল সোমবার বিকেলে ঢাবির সাধারণ ভর্তি কমিটির জরুরি বৈঠকে এ সিদ্ধান্ত হয় বলে জানিয়েছেন উপ-উপাচার্য মোহাম&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/733988/%E0%A6%AB%E0%A7%87%E0%A6%AC%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%AC%E0%A6%B2%E0%A6%BF%E0%A6%95-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87-%E0%A6%AD%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BF">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>নিষেধের পরও থামেননি বেপরোয়া চালক, বাস উল্টে নিহত তিনজন</title>
      <link>https://www.deshrupantor.com/733987/%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A7%87%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%93-%E0%A6%A5%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%A8%E0%A6%A8%E0%A6%BF-%E0%A6%AC%E0%A7%87%E0%A6%AA%E0%A6%B0%E0%A7%8B%E0%A7%9F%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%95-%E0%A6%AC%E0%A6%BE%E0%A6%B8-%E0%A6%89%E0%A6%B2%E0%A7%8D%E0%A6%9F%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/733987/%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A7%87%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%93-%E0%A6%A5%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%A8%E0%A6%A8%E0%A6%BF-%E0%A6%AC%E0%A7%87%E0%A6%AA%E0%A6%B0%E0%A7%8B%E0%A7%9F%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%95-%E0%A6%AC%E0%A6%BE%E0%A6%B8-%E0%A6%89%E0%A6%B2%E0%A7%8D%E0%A6%9F%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4</guid>
      <pubDate>Tue, 10 Nov 2026 02:02:27 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/d1719dc194ba0f74389a5c8c84d90269-6af226a123c32.jpg?jadewits_media_id=241433" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/d1719dc194ba0f74389a5c8c84d90269-6af226a123c32.jpg?jadewits_media_id=241433" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/d1719dc194ba0f74389a5c8c84d90269-6af226a123c32.jpg?jadewits_media_id=241433" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নিষেধের পরও থামেননি বেপরোয়া চালক, বাস উল্টে নিহত তিনজন" /&gt;&lt;/p&gt;&lt;p&gt;লক্ষ্মীপুরে একটি যাত্রীবাহী বাস উল্টে তিনজন নিহত হয়েছেন, আহত হয়েছেন অন্তত ২৫ জন। চালক বেপরোয়া গতিতে বাসটি চালান। যাত্রীরা তাকে নিষেধ করার পরও তিনি শোনেনি। পরে নিয়ন্ত্রণ হারিয়ে বাসটি উল্টে তিনজন মারা যান এবং ২৫ জন আহত হন। এ ছাড়া দেশের বিভিন্ন অঞ্চলে পৃথক দুর্ঘটনায় আরও চারজন মারা গেছেন। সংশ্লিষ্ট এলাক&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/733987/%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A7%87%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%93-%E0%A6%A5%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%A8%E0%A6%A8%E0%A6%BF-%E0%A6%AC%E0%A7%87%E0%A6%AA%E0%A6%B0%E0%A7%8B%E0%A7%9F%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%95-%E0%A6%AC%E0%A6%BE%E0%A6%B8-%E0%A6%89%E0%A6%B2%E0%A7%8D%E0%A6%9F%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>সুন্দরবন জলদস্যুমুক্ত করার দাবিতে নৌকাবন্ধন</title>
      <link>https://www.deshrupantor.com/733986/%E0%A6%B8%E0%A7%81%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%B0%E0%A6%AC%E0%A6%A8-%E0%A6%9C%E0%A6%B2%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A7%8C%E0%A6%95%E0%A6%BE%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/733986/%E0%A6%B8%E0%A7%81%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%B0%E0%A6%AC%E0%A6%A8-%E0%A6%9C%E0%A6%B2%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A7%8C%E0%A6%95%E0%A6%BE%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A6%A8</guid>
      <pubDate>Tue, 10 Nov 2026 02:01:44 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/d1719dc194ba0f74389a5c8c84d90269-6af226a123c32.jpg?jadewits_media_id=241433" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/d1719dc194ba0f74389a5c8c84d90269-6af226a123c32.jpg?jadewits_media_id=241433" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/d1719dc194ba0f74389a5c8c84d90269-6af226a123c32.jpg?jadewits_media_id=241433" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সুন্দরবন জলদস্যুমুক্ত করার দাবিতে নৌকাবন্ধন" /&gt;&lt;/p&gt;&lt;p&gt;সুন্দরবনকে জলদস্যুমুক্ত করার এক দফা দাবিতে সাতক্ষীরার শ্যামনগরে খোলপেটুয়া নদীতে ব্যতিক্রমী নৌকাবন্ধন করেছেন জেলে ও বাওয়ালিরা। গতকাল সোমবার সকাল সাড়ে ১০টায় কয়েকশ নৌকা নিয়ে নদীতে ভাসমান অবস্থায় এ কর্মসূচি পালন করেন তারা।
এতে অংশগ্রহণকারীদের দাবি সুন্দরবনকে বনদস্যুমুক্ত করতে হবে। বনে মাছ ও বনজসম্পদ আহর&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/733986/%E0%A6%B8%E0%A7%81%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%B0%E0%A6%AC%E0%A6%A8-%E0%A6%9C%E0%A6%B2%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A7%8C%E0%A6%95%E0%A6%BE%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A6%A8">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>রেখাকণ্ঠ কাঠঠোকরা</title>
      <link>https://www.deshrupantor.com/733985/%E0%A6%B0%E0%A7%87%E0%A6%96%E0%A6%BE%E0%A6%95%E0%A6%A3%E0%A7%8D%E0%A6%A0-%E0%A6%95%E0%A6%BE%E0%A6%A0%E0%A6%A0%E0%A7%8B%E0%A6%95%E0%A6%B0%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/733985/%E0%A6%B0%E0%A7%87%E0%A6%96%E0%A6%BE%E0%A6%95%E0%A6%A3%E0%A7%8D%E0%A6%A0-%E0%A6%95%E0%A6%BE%E0%A6%A0%E0%A6%A0%E0%A7%8B%E0%A6%95%E0%A6%B0%E0%A6%BE</guid>
      <pubDate>Tue, 10 Nov 2026 02:01:08 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/47c127e2f1b26656ce61c36dfe5a31f5-6af2267e227bc.jpg?jadewits_media_id=241432" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/47c127e2f1b26656ce61c36dfe5a31f5-6af2267e227bc.jpg?jadewits_media_id=241432" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/47c127e2f1b26656ce61c36dfe5a31f5-6af2267e227bc.jpg?jadewits_media_id=241432" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রেখাকণ্ঠ কাঠঠোকরা" /&gt;&lt;/p&gt;&lt;p&gt;এ বছরের ৬ অক্টোবর বিকেলের ঘটনা। গাজীপুর কৃষি বিশ^বিদ্যালয়ের তৃতীয় বর্ষ বিএস (ফরেস্ট্রি)-এর ব্যবহারিক ক্লাসের অংশ হিসেবে ছাত্রছাত্রীদের পাখি-প্রাণী চেনাতে ক্যাম্পাসময় ঘুরে বেড়াচ্ছি। বিভাগ থেকে ছাত্রছাত্রীদের নিয়ে হাঁটতে হাঁটতে আমলকী বাগানের সামনে এলাম। বাগানের সীমানা প্রাচীরের পাশের একটি গাছের ওপর গজ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/733985/%E0%A6%B0%E0%A7%87%E0%A6%96%E0%A6%BE%E0%A6%95%E0%A6%A3%E0%A7%8D%E0%A6%A0-%E0%A6%95%E0%A6%BE%E0%A6%A0%E0%A6%A0%E0%A7%8B%E0%A6%95%E0%A6%B0%E0%A6%BE">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>সন্তানের চিকিৎসা করাতে এসে সর্বস্ব হারাল পরিবারটি</title>
      <link>https://www.deshrupantor.com/733984/%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%BF%E0%A6%95%E0%A6%BF%E0%A7%8E%E0%A6%B8%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%8F%E0%A6%B8%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%AC-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%B2-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A6%9F%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/733984/%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%BF%E0%A6%95%E0%A6%BF%E0%A7%8E%E0%A6%B8%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%8F%E0%A6%B8%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%AC-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%B2-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A6%9F%E0%A6%BF</guid>
      <pubDate>Tue, 10 Nov 2026 02:00:08 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/3154665fd50b094519b5e750cdf8fd5d-6af2263a226a9.jpg?jadewits_media_id=241431" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/3154665fd50b094519b5e750cdf8fd5d-6af2263a226a9.jpg?jadewits_media_id=241431" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/3154665fd50b094519b5e750cdf8fd5d-6af2263a226a9.jpg?jadewits_media_id=241431" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সন্তানের চিকিৎসা করাতে এসে সর্বস্ব হারাল পরিবারটি" /&gt;&lt;/p&gt;&lt;p&gt;ব্রেনে ভাইরাসজনিত রোগে আক্রান্ত সাত মাস বয়সী সন্তান মোহাম্মদ উল্লাহকে নিয়ে ঢাকা মেডিকেল কলেজ (ঢামেক) হাসপাতালে এসেছিলেন বাবা হাফেজ মাওলানা আব্দুল মোতালেব। গত ২৯ অক্টোবর শিশুটিকে হাসপাতালের শিশু বিভাগের ২১০ নম্বর ওয়ার্ডে ভর্তি করান। একদিকে অসুস্থ সন্তানের চিকিৎসা নিয়ে দুশ্চিন্তা, অন্যদিকে হাসপাতালের &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/733984/%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%BF%E0%A6%95%E0%A6%BF%E0%A7%8E%E0%A6%B8%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%8F%E0%A6%B8%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%AC-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%B2-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A6%9F%E0%A6%BF">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>উধাও রিকশা ভোগান্তিতে নগরবাসী</title>
      <link>https://www.deshrupantor.com/733983/%E0%A6%89%E0%A6%A7%E0%A6%BE%E0%A6%93-%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%B6%E0%A6%BE-%E0%A6%AD%E0%A7%8B%E0%A6%97%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A6%97%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%80</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/733983/%E0%A6%89%E0%A6%A7%E0%A6%BE%E0%A6%93-%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%B6%E0%A6%BE-%E0%A6%AD%E0%A7%8B%E0%A6%97%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A6%97%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%80</guid>
      <pubDate>Tue, 10 Nov 2026 01:59:30 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/0528224c7dd578b78b6dc5533055e33b-6af2261d16f93.jpg?jadewits_media_id=241430" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/0528224c7dd578b78b6dc5533055e33b-6af2261d16f93.jpg?jadewits_media_id=241430" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/0528224c7dd578b78b6dc5533055e33b-6af2261d16f93.jpg?jadewits_media_id=241430" style="max-width:100%;height:auto;margin-bottom:10px;" alt="উধাও রিকশা ভোগান্তিতে নগরবাসী" /&gt;&lt;/p&gt;&lt;p&gt;১২ দফা দাবি আদায়ে সমাবেশ করেছেন ব্যাটারিচালিত রিকশা শ্রমিকরা। গতকাল সোমবার রাজধানীর পল্টনে সমাবেশ ও সড়ক অবরোধ করেন তারা। সমাবেশ শেষে চালকরা মিছিল নিয়ে সচিবালয়ের সামনে যাওয়ার চেষ্টা করেন। পরে প্রধানমন্ত্রীর কাছে স্মারকলিপি দিতে শ্রমিক নেতাদের একটি প্রতিনিধিদল পাঠানো হয়। এদিকে কর্মসূচিতে অংশ নিতে চালক&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/733983/%E0%A6%89%E0%A6%A7%E0%A6%BE%E0%A6%93-%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%B6%E0%A6%BE-%E0%A6%AD%E0%A7%8B%E0%A6%97%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A6%97%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%80">দেশ রূপান্তর</source>

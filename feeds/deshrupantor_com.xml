    <item>
      <title>গোপালগঞ্জে সংঘর্ষে জড়াল ১০ গাড়ি, নিহত ১</title>
      <link>https://www.deshrupantor.com/735012/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A7%87-%E0%A6%9C%E0%A7%9C%E0%A6%BE%E0%A6%B2-%E0%A7%A7%E0%A7%A6-%E0%A6%97%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A7%A7</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735012/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A7%87-%E0%A6%9C%E0%A7%9C%E0%A6%BE%E0%A6%B2-%E0%A7%A7%E0%A7%A6-%E0%A6%97%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A7%A7</guid>
      <pubDate>Sat, 14 Nov 2026 07:41:20 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/3f34fba5adc6222d1361dc695d1e561f-6af76df013b99.jpg?jadewits_media_id=242371" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/3f34fba5adc6222d1361dc695d1e561f-6af76df013b99.jpg?jadewits_media_id=242371" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/3f34fba5adc6222d1361dc695d1e561f-6af76df013b99.jpg?jadewits_media_id=242371" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গোপালগঞ্জে সংঘর্ষে জড়াল ১০ গাড়ি, নিহত ১" /&gt;&lt;/p&gt;&lt;p&gt;ঢাকা-বরিশাল মহাসড়কের গোপালগঞ্জের মুকসুদপুরের বরইতলা বাসস্ট্যান্ডে সিরিয়াল ১০ গাড়ির মধ্যে সংঘর্ষে একজন নিহত হয়েছেন। এ সময় আহত হন শতাধিক যাত্রী। ক্ষতিগ্রস্ত যানবাহনের মধ্যে গোপালগঞ্জ-১ আসনের এমপি সেলিমুজ্জামান সেলিমের গাড়ি বহরের দুটি গাড়ি রয়েছে। এমপির গাড়িও কিছুটা ক্ষতিগ্রস্ত হয়। তবে তিনি অক্ষত রয়েছেন&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735012/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A7%87-%E0%A6%9C%E0%A7%9C%E0%A6%BE%E0%A6%B2-%E0%A7%A7%E0%A7%A6-%E0%A6%97%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A7%A7">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>খালেদা জিয়ার মৃত্যুবার্ষিকীতে নাগরিক স্মরণসভা ২৮ ডিসেম্বর</title>
      <link>https://www.deshrupantor.com/735011/%E0%A6%96%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A6%E0%A6%BE-%E0%A6%9C%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%95%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%97%E0%A6%B0%E0%A6%BF%E0%A6%95-%E0%A6%B8%E0%A7%8D%E0%A6%AE%E0%A6%B0%E0%A6%A3%E0%A6%B8%E0%A6%AD%E0%A6%BE-%E0%A7%A8%E0%A7%AE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735011/%E0%A6%96%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A6%E0%A6%BE-%E0%A6%9C%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%95%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%97%E0%A6%B0%E0%A6%BF%E0%A6%95-%E0%A6%B8%E0%A7%8D%E0%A6%AE%E0%A6%B0%E0%A6%A3%E0%A6%B8%E0%A6%AD%E0%A6%BE-%E0%A7%A8%E0%A7%AE</guid>
      <pubDate>Sat, 14 Nov 2026 07:41:02 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/3f34fba5adc6222d1361dc695d1e561f-6af76df013b99.jpg?jadewits_media_id=242371" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/3f34fba5adc6222d1361dc695d1e561f-6af76df013b99.jpg?jadewits_media_id=242371" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/3f34fba5adc6222d1361dc695d1e561f-6af76df013b99.jpg?jadewits_media_id=242371" style="max-width:100%;height:auto;margin-bottom:10px;" alt="খালেদা জিয়ার মৃত্যুবার্ষিকীতে নাগরিক স্মরণসভা ২৮ ডিসেম্বর" /&gt;&lt;/p&gt;&lt;p&gt;সাবেক প্রধানমন্ত্রী ও সাবেক বিএনপি চেয়ারপারসন খালেদা জিয়ার প্রথম মৃত্যুবার্ষিকী উপলক্ষে আগামী ২৮ ডিসেম্বর রাজধানীর জাতীয় সংসদ ভবনের দক্ষিণ প্লাজায় নাগরিক স্মরণসভার আয়োজন করা হয়েছে।
এ উপলক্ষে তার জীবন, রাজনৈতিক দর্শন, নেতৃত্ব ও জাতীয় জীবনে অবদান নিয়ে একটি বিশেষ স্মারকগ্রন্থ প্রকাশের উদ্যোগ নেওয়া হয়েছ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735011/%E0%A6%96%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A6%E0%A6%BE-%E0%A6%9C%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%95%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%97%E0%A6%B0%E0%A6%BF%E0%A6%95-%E0%A6%B8%E0%A7%8D%E0%A6%AE%E0%A6%B0%E0%A6%A3%E0%A6%B8%E0%A6%AD%E0%A6%BE-%E0%A7%A8%E0%A7%AE">দেশ রূপান্তর</source>

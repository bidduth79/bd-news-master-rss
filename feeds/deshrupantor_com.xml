      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/684b7a261a4ed9e812aaaa309d11b96a-6b008fd7c4d2b.jpg?jadewits_media_id=244037" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সিসি ক্যামেরা বন্ধ করে কম্পিউটারের যন্ত্রাংশ লুট" /&gt;&lt;/p&gt;&lt;p&gt;মানিকগঞ্জের সিংগাইরে বাংলাদেশ-কোরিয়া কারিগরি প্রশিক্ষণ কেন্দ্রের দুটি কম্পিউটার ল্যাব থেকে প্রায় ৩৫ লাখ টাকার যন্ত্রাংশ ও ল্যাপটপ চুরির ঘটনা ঘটেছে। দুর্বৃত্তরা ৩৩টি ডেস্কটপ কম্পিউটারের মূল্যবান যন্ত্রাংশ খুলে নেওয়ার পাশাপাশি দুটি ল্যাপটপ নিয়ে গেছে।
গত বুধবার দিবাগত রাতে সিংগাইর পৌর এলাকার বিনোদপুরে &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736730/%E0%A6%B8%E0%A6%BF%E0%A6%B8%E0%A6%BF-%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%B0%E0%A6%BE-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%95%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A6%89%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AF%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%82%E0%A6%B6-%E0%A6%B2%E0%A7%81%E0%A6%9F">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>ডেঙ্গু ও হামে ৮ মৃত্যু, হাসপাতালে ভর্তি ২৫৩২</title>
      <link>https://www.deshrupantor.com/736729/%E0%A6%A1%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%81-%E0%A6%93-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A7%AE-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%AD%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A7%A8%E0%A7%AB%E0%A7%A9%E0%A7%A8</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736729/%E0%A6%A1%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%81-%E0%A6%93-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A7%AE-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%AD%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A7%A8%E0%A7%AB%E0%A7%A9%E0%A7%A8</guid>
      <pubDate>Sat, 21 Nov 2026 07:08:27 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/684b7a261a4ed9e812aaaa309d11b96a-6b008fd7c4d2b.jpg?jadewits_media_id=244037" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/684b7a261a4ed9e812aaaa309d11b96a-6b008fd7c4d2b.jpg?jadewits_media_id=244037" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/684b7a261a4ed9e812aaaa309d11b96a-6b008fd7c4d2b.jpg?jadewits_media_id=244037" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডেঙ্গু ও হামে ৮ মৃত্যু, হাসপাতালে ভর্তি ২৫৩২" /&gt;&lt;/p&gt;&lt;p&gt;ডেঙ্গু ও হামের উপসর্গে ২৪ ঘণ্টায় আরও ৮ জনের মৃত্যু হয়েছে। এই সময়ে রোগ দুটিতে আক্রান্ত হয়েছেন ২ হাজার ৫৩২ জন। গতকাল শুক্রবার সকাল ৮টা পর্যন্ত আগের ২৪ ঘণ্টা সময়ের হিসাবে এই মৃত্যু ও হাসপাতালে ভর্তির তথ্য সংযোজন করা হয়।
অন্যদিকে হামসংক্রান্ত বিজ্ঞপ্তিতে বলা হয়েছে রোগটির উপসর্গ নিয়ে নতুন করে ৫ জনের মৃত্&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736729/%E0%A6%A1%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%81-%E0%A6%93-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A7%AE-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%AD%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A7%A8%E0%A7%AB%E0%A7%A9%E0%A7%A8">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>কাঁঠালবাগানে গ্যাস বিস্ফোরণ দগ্ধ ৫ জনের মধ্যে একজনের মৃত্যু</title>

    <item>
      <title>ঢাকা সাভার ও কুয়াকাটায় বাস-পুলিশ বক্সে আগুন</title>
      <link>https://www.deshrupantor.com/738413/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%B8%E0%A6%BE%E0%A6%AD%E0%A6%BE%E0%A6%B0-%E0%A6%93-%E0%A6%95%E0%A7%81%E0%A7%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%9F%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BE%E0%A6%B8-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%AC%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/738413/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%B8%E0%A6%BE%E0%A6%AD%E0%A6%BE%E0%A6%B0-%E0%A6%93-%E0%A6%95%E0%A7%81%E0%A7%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%9F%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BE%E0%A6%B8-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%AC%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</guid>
      <pubDate>Sat, 28 Nov 2026 06:54:35 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/d20289d2fdf0db3319237a2ef7933e2b-6b0a264581190.jpg?jadewits_media_id=245682" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/d20289d2fdf0db3319237a2ef7933e2b-6b0a264581190.jpg?jadewits_media_id=245682" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/d20289d2fdf0db3319237a2ef7933e2b-6b0a264581190.jpg?jadewits_media_id=245682" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঢাকা সাভার ও কুয়াকাটায় বাস-পুলিশ বক্সে আগুন" /&gt;&lt;/p&gt;&lt;p&gt;দেশের বিভিন্ন স্থানে গতকাল শুক্রবারও নাশকতার ঘটনা ঘটেছে। এদিন রাজধানীর সাভারে ঢাকা-আরিচা মহাসড়কে পার্কিং করে রাখা লাব্বাইক পরিবহনের একটি যাত্রীবাহী বাসে আগুন দেওয়া হয়েছে। গত বৃহস্পতিবার দিবাগত রাতে পটুয়াখালী জেলার কুয়াকাটায় সড়কের পাশে দীর্ঘসময় ধরে পার্কিং করে রাখা পর্যটকবাহী একটি পরিত্যক্ত জিপে অগ্ন&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/738413/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%B8%E0%A6%BE%E0%A6%AD%E0%A6%BE%E0%A6%B0-%E0%A6%93-%E0%A6%95%E0%A7%81%E0%A7%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%9F%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BE%E0%A6%B8-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%AC%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>এবার চট্টগ্রাম-কাপ্তাই সড়ক অবরোধ শিক্ষার্থীদের</title>
      <link>https://www.deshrupantor.com/738412/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%9A%E0%A6%9F%E0%A7%8D%E0%A6%9F%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE-%E0%A6%95%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%87-%E0%A6%B8%E0%A7%9C%E0%A6%95-%E0%A6%85%E0%A6%AC%E0%A6%B0%E0%A7%8B%E0%A6%A7-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/738412/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%9A%E0%A6%9F%E0%A7%8D%E0%A6%9F%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE-%E0%A6%95%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%87-%E0%A6%B8%E0%A7%9C%E0%A6%95-%E0%A6%85%E0%A6%AC%E0%A6%B0%E0%A7%8B%E0%A6%A7-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Sat, 28 Nov 2026 06:51:39 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/f02c2c0c32eb651231431c618f4823fb-6b0a24305bf8f.jpg?jadewits_media_id=245676" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/f02c2c0c32eb651231431c618f4823fb-6b0a24305bf8f.jpg?jadewits_media_id=245676" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/f02c2c0c32eb651231431c618f4823fb-6b0a24305bf8f.jpg?jadewits_media_id=245676" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এবার চট্টগ্রাম-কাপ্তাই সড়ক অবরোধ শিক্ষার্থীদের" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রাম প্রকৌশল ও প্রযুক্তি বিশ্ববিদ্যালয়ের (চুয়েট) চলমান অচলাবস্থা ও সংকট নিরসনে সরকারের সরাসরি হস্তক্ষেপ চেয়েছেন আন্দোলনরত শিক্ষার্থীরা। পাশাপাশি দাবি আদায়ে চট্টগ্রাম-কাপ্তাই মহাসড়ক প্রায় আধা ঘণ্টা অবরোধ করে বিক্ষোভ করেন তারা। শুক্রবার বিকেল সোয়া ৪টার দিকে শতাধিক শিক্ষার্থী বিশ্ববিদ্যালয়ের সামনে&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/738412/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%9A%E0%A6%9F%E0%A7%8D%E0%A6%9F%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE-%E0%A6%95%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%87-%E0%A6%B8%E0%A7%9C%E0%A6%95-%E0%A6%85%E0%A6%AC%E0%A6%B0%E0%A7%8B%E0%A6%A7-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>নারায়ণগঞ্জে ইটভাটার চাঁদা নিয়ে সংঘর্ষ গুলি, আহত ২০</title>

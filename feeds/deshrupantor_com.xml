    <item>
      <title>ন্যূনতম মজুরি বৃদ্ধির পরও কেন সহিংসতা</title>
      <link>https://www.deshrupantor.com/737926/%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A7%82%E0%A6%A8%E0%A6%A4%E0%A6%AE-%E0%A6%AE%E0%A6%9C%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%AC%E0%A7%83%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%93-%E0%A6%95%E0%A7%87%E0%A6%A8-%E0%A6%B8%E0%A6%B9%E0%A6%BF%E0%A6%82%E0%A6%B8%E0%A6%A4%E0%A6%BE%C2%A0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737926/%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A7%82%E0%A6%A8%E0%A6%A4%E0%A6%AE-%E0%A6%AE%E0%A6%9C%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%AC%E0%A7%83%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%93-%E0%A6%95%E0%A7%87%E0%A6%A8-%E0%A6%B8%E0%A6%B9%E0%A6%BF%E0%A6%82%E0%A6%B8%E0%A6%A4%E0%A6%BE%C2%A0</guid>
      <pubDate>Thu, 26 Nov 2026 01:50:00 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/5fa4c3e3fbcfd82502ae82fe0f400fa4-6b07201e86d52.jpg?jadewits_media_id=245222" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/5fa4c3e3fbcfd82502ae82fe0f400fa4-6b07201e86d52.jpg?jadewits_media_id=245222" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/5fa4c3e3fbcfd82502ae82fe0f400fa4-6b07201e86d52.jpg?jadewits_media_id=245222" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ন্যূনতম মজুরি বৃদ্ধির পরও কেন সহিংসতা" /&gt;&lt;/p&gt;&lt;p&gt;ভোটাভুটির মাধ্যমে তৈরি পোশাকশ্রমিকদের ন্যূনতম মজুরি ১৭ হাজার টাকা নির্ধারণ হয়েছে। আগের ১২ হাজার ৫০০ টাকা থেকে এটি ৩৬ শতাংশ বেশি, যদিও ১৯৮৬ সালে প্রথম মজুরি কাঠামোর পর শতাংশের হিসাবে এটিই সবচেয়ে কম বৃদ্ধি। কিন্তু&amp;nbsp; সিদ্ধান্তের কয়েক ঘণ্টার মধ্যেই গাজীপুরে শ্রমিকদের একটি অংশ আবার রাস্তায় নেমেছেন। ঢ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737926/%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A7%82%E0%A6%A8%E0%A6%A4%E0%A6%AE-%E0%A6%AE%E0%A6%9C%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%AC%E0%A7%83%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%93-%E0%A6%95%E0%A7%87%E0%A6%A8-%E0%A6%B8%E0%A6%B9%E0%A6%BF%E0%A6%82%E0%A6%B8%E0%A6%A4%E0%A6%BE%C2%A0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>বোমার আড়ালে উগ্রবাদীরা</title>
      <link>https://www.deshrupantor.com/737980/%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A7%9C%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%89%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A7%80%E0%A6%B0%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737980/%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A7%9C%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%89%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A7%80%E0%A6%B0%E0%A6%BE</guid>
      <pubDate>Thu, 26 Nov 2026 01:35:36 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/064a16e75174e2d5ec7d40fcaf2680e2-6b07386db4b4e.jpg?jadewits_media_id=245266" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/064a16e75174e2d5ec7d40fcaf2680e2-6b07386db4b4e.jpg?jadewits_media_id=245266" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/064a16e75174e2d5ec7d40fcaf2680e2-6b07386db4b4e.jpg?jadewits_media_id=245266" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বোমার আড়ালে উগ্রবাদীরা" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর মতিঝিলের মেট্রোরেল স্টেশনের নিচে ছাতার ভেতরে লুকানো বোমা, সাভারের আশুলিয়ায় মুদি দোকানের সামনে ফেলে যাওয়া ব্যাগে প্রেসার কুকার বোমা, হেমায়েতপুরে বোমা তৈরির সরঞ্জাম ও পাইপবোমার আস্তানা, আর কুষ্টিয়ার লালন সাঁইয়ের আখড়াবাড়িতে টাইমবোমা গত কয়েক মাসে দেশের বিভিন্ন স্থানে একের পর এক শক্তিশালী বোমা ও&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737980/%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A7%9C%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%89%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A7%80%E0%A6%B0%E0%A6%BE">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>উপাচার্য পুনর্বহালের অবস্থান থেকে সরে এলেন চুয়েট শিক্ষকরা</title>
      <link>https://www.deshrupantor.com/737979/%E0%A6%89%E0%A6%AA%E0%A6%BE%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF-%E0%A6%AA%E0%A7%81%E0%A6%A8%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%B9%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A7%87-%E0%A6%8F%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%9A%E0%A7%81%E0%A7%9F%E0%A7%87%E0%A6%9F</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737979/%E0%A6%89%E0%A6%AA%E0%A6%BE%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF-%E0%A6%AA%E0%A7%81%E0%A6%A8%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%B9%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A7%87-%E0%A6%8F%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%9A%E0%A7%81%E0%A7%9F%E0%A7%87%E0%A6%9F</guid>
      <pubDate>Thu, 26 Nov 2026 01:33:41 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/3667ccbab75c23774d98891aa0a23323-6b0737d25cc74.jpg?jadewits_media_id=245265" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/3667ccbab75c23774d98891aa0a23323-6b0737d25cc74.jpg?jadewits_media_id=245265" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/3667ccbab75c23774d98891aa0a23323-6b0737d25cc74.jpg?jadewits_media_id=245265" style="max-width:100%;height:auto;margin-bottom:10px;" alt="উপাচার্য পুনর্বহালের অবস্থান থেকে সরে এলেন চুয়েট শিক্ষকরা" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রাম প্রকৌশল ও প্রযুক্তি বিশ্ববিদ্যালয়ে (চুয়েট) উপাচার্য পুনর্বহালের অবস্থান থেকে সরে এসেছেন শিক্ষকরা। চলমান অচলাবস্থা নিরসনে তারা চুয়েট থেকেই যেকোনো শিক্ষককে উপাচার্য হিসেবে নিয়োগ দেওয়ার দাবি জানিয়েছেন। দুই মাস ধরে সাবেক অধ্যাপক আবু সাদাত মুহাম্মদ সায়েমকে উপাচার্য পদে পুনর্বহালের দাবিতে অনড় থা&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737979/%E0%A6%89%E0%A6%AA%E0%A6%BE%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF-%E0%A6%AA%E0%A7%81%E0%A6%A8%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%B9%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A7%87-%E0%A6%8F%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%9A%E0%A7%81%E0%A7%9F%E0%A7%87%E0%A6%9F">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>আগরতলায় আ.লীগের নেতারা, আখাউড়ায় বিএনপির অবস্থান</title>

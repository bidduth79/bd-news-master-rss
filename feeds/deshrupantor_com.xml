    <item>
      <title>ঢাকায় শুরু হচ্ছে ইয়ুথ ট্যুরিজম এক্সপো, থাকবে ক্যারিয়ার সামিট</title>
      <link>https://www.deshrupantor.com/735090/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%87%E0%A7%9F%E0%A7%81%E0%A6%A5-%E0%A6%9F%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%9C%E0%A6%AE-%E0%A6%8F%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%AA%E0%A7%8B-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%AC%E0%A7%87</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735090/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%87%E0%A7%9F%E0%A7%81%E0%A6%A5-%E0%A6%9F%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%9C%E0%A6%AE-%E0%A6%8F%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%AA%E0%A7%8B-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%AC%E0%A7%87</guid>
      <pubDate>Sat, 14 Nov 2026 15:50:27 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/d9fb3e071bc45769f6bddec24d5a46ea-6af82e20d40ea.gif?jadewits_media_id=242471" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/d9fb3e071bc45769f6bddec24d5a46ea-6af82e20d40ea.gif?jadewits_media_id=242471" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/d9fb3e071bc45769f6bddec24d5a46ea-6af82e20d40ea.gif?jadewits_media_id=242471" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঢাকায় শুরু হচ্ছে ইয়ুথ ট্যুরিজম এক্সপো, থাকবে ক্যারিয়ার সামিট" /&gt;&lt;/p&gt;&lt;p&gt;দেশের অভ্যন্তরীণ পর্যটনশিল্পের প্রসার, তরুণ উদ্যোক্তাদের সম্পৃক্ততা এবং পর্যটন খাতের বিভিন্ন অংশীজনের মধ্যে যোগাযোগ ও ব্যবসায়িক সম্পর্ক জোরদারের লক্ষ্যে ঢাকায় শুরু হচ্ছে তিন দিনব্যাপী প্রথম বাংলাদেশ ইয়ুথ ট্যুরিজম এক্সপো (বাইট) ২০২৬।
আগামী ১৯ থেকে ২১ নভেম্বর রাজধানীর ফার্মগেটে কৃষিবিদ ইনস্টিটিউশন বাং&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735090/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%87%E0%A7%9F%E0%A7%81%E0%A6%A5-%E0%A6%9F%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%9C%E0%A6%AE-%E0%A6%8F%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%AA%E0%A7%8B-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%AC%E0%A7%87">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>সাতক্ষীরায় মোটরসাইকেল দুর্ঘটনায় যুবকের মৃত্যু</title>
      <link>https://www.deshrupantor.com/735089/%E0%A6%B8%E0%A6%BE%E0%A6%A4%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%80%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A7%8B%E0%A6%9F%E0%A6%B0%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%87%E0%A6%B2-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735089/%E0%A6%B8%E0%A6%BE%E0%A6%A4%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%80%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A7%8B%E0%A6%9F%E0%A6%B0%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%87%E0%A6%B2-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81</guid>
      <pubDate>Sat, 14 Nov 2026 15:49:00 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/f8a32fa16e7d8492244b3543faceba93-6af82dbbc7e8c.gif?jadewits_media_id=242470" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/f8a32fa16e7d8492244b3543faceba93-6af82dbbc7e8c.gif?jadewits_media_id=242470" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/f8a32fa16e7d8492244b3543faceba93-6af82dbbc7e8c.gif?jadewits_media_id=242470" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাতক্ষীরায় মোটরসাইকেল দুর্ঘটনায় যুবকের মৃত্যু" /&gt;&lt;/p&gt;&lt;p&gt;সাতক্ষীরার আশাশুনিতে দ্রুতগতির মোটরসাইকেল নিয়ন্ত্রণ হারিয়ে গাছের সাথে ধাক্কা লেগে মোস্তাকিম (২১) নামের এক যুবকের মৃত্যু হয়েছে। ওই দুর্ঘটনায় আরও দুইজন আহত হয়েছেন। শনিবার (১৪ নভেম্বর) দুপুরে সাতক্ষীরা-পারুলিয়া সড়কের শোভনালী এলাকায় এই দুর্ঘটনা ঘটে।
যুবক মোস্তাকিম সাতক্ষীরা সদর উপজেলার দেবনগর গ্রামের মো&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735089/%E0%A6%B8%E0%A6%BE%E0%A6%A4%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%80%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A7%8B%E0%A6%9F%E0%A6%B0%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%87%E0%A6%B2-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>হাজীগঞ্জে মিনি ম্যারাথনে অংশ নিলেন ৮০০ প্রতিযোগী</title>

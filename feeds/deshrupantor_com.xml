    <item>
      <title>কালীগঞ্জে ইয়াবাসহ আটক, অভিযুক্ত রতনের ৪ মাসের কারাদণ্ড</title>
      <link>https://www.deshrupantor.com/736600/%E0%A6%95%E0%A6%BE%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%87%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%B9-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%B0%E0%A6%A4%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A7%AA-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736600/%E0%A6%95%E0%A6%BE%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%87%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%B9-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%B0%E0%A6%A4%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A7%AA-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Fri, 20 Nov 2026 17:03:39 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/a50efb8a3dc186f49198bb647b141b6a-6b0028dfbe89a.jpg?jadewits_media_id=243943" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/a50efb8a3dc186f49198bb647b141b6a-6b0028dfbe89a.jpg?jadewits_media_id=243943" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/a50efb8a3dc186f49198bb647b141b6a-6b0028dfbe89a.jpg?jadewits_media_id=243943" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কালীগঞ্জে ইয়াবাসহ আটক, অভিযুক্ত রতনের ৪ মাসের কারাদণ্ড" /&gt;&lt;/p&gt;&lt;p&gt;গাজীপুরের কালীগঞ্জে ইয়াবাসহ মো. রতন মিয়া (৩৫) নামে এক ব্যক্তিকে আটক করেছে পুলিশ। এ ঘটনায় তাকে চার মাসের বিনাশ্রম কারাদণ্ড ও ১০০ টাকা অর্থদণ্ড দিয়েছেন ভ্রাম্যমাণ আদালত।
শুক্রবার (২০ নভেম্বর) উপজেলার মোক্তারপুর ইউনিয়নের বড়গাঁও এলাকায় এ অভিযান ও ভ্রাম্যমাণ আদালত পরিচালনা করা হয়। আদালত পরিচালনা করেন উপজ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736600/%E0%A6%95%E0%A6%BE%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%87%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%B9-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%B0%E0%A6%A4%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A7%AA-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%87%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>রাবিতে ছাত্রলীগের সাবেক নেতাকে মারধর: তদন্ত কমিটি গঠন</title>
      <link>https://www.deshrupantor.com/736599/%E0%A6%B0%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%A7%E0%A6%B0-%E0%A6%A4%E0%A6%A6%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%95%E0%A6%AE%E0%A6%BF%E0%A6%9F%E0%A6%BF</link>

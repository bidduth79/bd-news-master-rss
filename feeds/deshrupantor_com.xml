    <item>
      <title>২০২৭ সালে আসছে ৩ নতুন আইফোন</title>
      <link>https://www.deshrupantor.com/736222/%E0%A7%A8%E0%A7%A6%E0%A7%A8%E0%A7%AD-%E0%A6%B8%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%86%E0%A6%B8%E0%A6%9B%E0%A7%87-%E0%A7%A9-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%86%E0%A6%87%E0%A6%AB%E0%A7%8B%E0%A6%A8</link>

      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/1b9a1970cbbcbcc5d46e21605b89cba2-6b024a5504feb.jpg?jadewits_media_id=244292" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মায়ের পর মারা গেল শিশুসন্তানও" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর কাঁঠালবাগানে একটি বাসায় গ্যাস লিকেজ থেকে বিস্ফোরণে একই পরিবারের তিনজনসহ পাঁচজন দগ্ধ হওয়ার ঘটনায় মা ইফতি সাবার (২৫) মৃত্যুর পর মারা গেল দেড় বছর বয়সী ছেলে আরিস রহমান মাহাদ।
গতকাল শনিবার ভোর সাড়ে ৫টার দিকে জাতীয় বার্ন অ্যান্ড প্লাস্টিক সার্জারি ইনস্টিটিউটে মৃত্যু হয় শিশুটির। বার্ন ইনস্টিটিউটের&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736973/%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%97%E0%A7%87%E0%A6%B2-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%93">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>বিদ্যুৎ বিল ৫০ হাজার</title>
      <link>https://www.deshrupantor.com/736972/%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A7%8E-%E0%A6%AC%E0%A6%BF%E0%A6%B2-%E0%A7%AB%E0%A7%A6-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736972/%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A7%8E-%E0%A6%AC%E0%A6%BF%E0%A6%B2-%E0%A7%AB%E0%A7%A6-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Sun, 22 Nov 2026 07:50:00 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/c20cbda94c1d8af27a5eb46251e829ca-6b024a41afffb.jpg?jadewits_media_id=244291" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/c20cbda94c1d8af27a5eb46251e829ca-6b024a41afffb.jpg?jadewits_media_id=244291" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/c20cbda94c1d8af27a5eb46251e829ca-6b024a41afffb.jpg?jadewits_media_id=244291" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিদ্যুৎ বিল ৫০ হাজার" /&gt;&lt;/p&gt;&lt;p&gt;কুড়িগ্রামের ফুলবাড়ীতে এক দিনমজুরের বাড়িতে তিন মাসে বিদ্যুৎ বিল এসেছে ৫০ হাজার ৩০ টাকা। অথচ তার দাবি, বাড়িতে একটি বাতি ও একটি ফ্যান ব্যবহারের পাশাপাশি ছোট একটি মিশুক গাড়ি চার্জ দেওয়া ছাড়া উল্লেখযোগ্য কোনো বিদ্যুৎ ব্যবহার করেন না তিনি। সীমিত ব্যবহারের বিপরীতে অস্বাভাবিক এই বিল পেয়ে বিপাকে পড়েছে ছয় সদস&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736972/%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A7%8E-%E0%A6%AC%E0%A6%BF%E0%A6%B2-%E0%A7%AB%E0%A7%A6-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0">দেশ রূপান্তর</source>

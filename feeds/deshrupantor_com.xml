    <item>
      <title>কোচিং ঠেকাতে স্কুলে পাঠদান উন্নত করার নির্দেশ</title>
      <link>https://www.deshrupantor.com/738271/%E0%A6%95%E0%A7%8B%E0%A6%9A%E0%A6%BF%E0%A6%82-%E0%A6%A0%E0%A7%87%E0%A6%95%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%A0%E0%A6%A6%E0%A6%BE%E0%A6%A8-%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A7%87%E0%A6%B6</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/738271/%E0%A6%95%E0%A7%8B%E0%A6%9A%E0%A6%BF%E0%A6%82-%E0%A6%A0%E0%A7%87%E0%A6%95%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%A0%E0%A6%A6%E0%A6%BE%E0%A6%A8-%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A7%87%E0%A6%B6</guid>
      <pubDate>Fri, 27 Nov 2026 02:36:02 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/7febd096d19ccaa37469880394dec04f-6b08891c95daf.jpg?jadewits_media_id=245473" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/7febd096d19ccaa37469880394dec04f-6b08891c95daf.jpg?jadewits_media_id=245473" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/7febd096d19ccaa37469880394dec04f-6b08891c95daf.jpg?jadewits_media_id=245473" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কোচিং ঠেকাতে স্কুলে পাঠদান উন্নত করার নির্দেশ" /&gt;&lt;/p&gt;&lt;p&gt;টেকসই উন্নয়ন লক্ষ্যমাত্রা (এসডিজি) অর্জনে মানসম্মত প্রাথমিক শিক্ষা নিশ্চিত করা, যোগ্য শিক্ষক নিয়োগ বৃদ্ধি এবং শিক্ষাপদ্ধতি ও পাঠ্যক্রম যুগোপযোগী করার সুপারিশ করেছে সংসদীয় স্থায়ী কমিটি। একইসঙ্গে কমিটি শ্রেণিকক্ষে পাঠদান পদ্ধতি এমনভাবে পরিচালনার পরামর্শ দিয়েছে যাতে শিক্ষার্থীদের অন্য কোথাও প্রাইভেট বা&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/738271/%E0%A6%95%E0%A7%8B%E0%A6%9A%E0%A6%BF%E0%A6%82-%E0%A6%A0%E0%A7%87%E0%A6%95%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%A0%E0%A6%A6%E0%A6%BE%E0%A6%A8-%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A7%87%E0%A6%B6">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>শহীদ ডা. মিলন দিবস আজ</title>
      <link>https://www.deshrupantor.com/738270/%E0%A6%B6%E0%A6%B9%E0%A7%80%E0%A6%A6-%E0%A6%A1%E0%A6%BE.-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%A8-%E0%A6%A6%E0%A6%BF%E0%A6%AC%E0%A6%B8-%E0%A6%86%E0%A6%9C</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/738270/%E0%A6%B6%E0%A6%B9%E0%A7%80%E0%A6%A6-%E0%A6%A1%E0%A6%BE.-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%A8-%E0%A6%A6%E0%A6%BF%E0%A6%AC%E0%A6%B8-%E0%A6%86%E0%A6%9C</guid>
      <pubDate>Fri, 27 Nov 2026 02:35:26 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/d9e4a96e8d1d387550b6694291314f1e-6b0889246261e.jpg?jadewits_media_id=245493" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/d9e4a96e8d1d387550b6694291314f1e-6b0889246261e.jpg?jadewits_media_id=245493" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/d9e4a96e8d1d387550b6694291314f1e-6b0889246261e.jpg?jadewits_media_id=245493" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শহীদ ডা. মিলন দিবস আজ" /&gt;&lt;/p&gt;&lt;p&gt;আজ ২৭ নভেম্বর, শহীদ ডা. শামসুল আলম খান মিলন দিবস। ১৯৯০ সালের এই দিনে স্বৈরাচারবিরোধী আন্দোলনের উত্তাল সময়ে রাজধানীর ঢাকা বিশ্ববিদ্যালয় এলাকায় সন্ত্রাসীদের গুলিতে নিহত হন চিকিৎসক নেতা ডা. শামসুল আলম খান মিলন। তার আত্মত্যাগ বাংলাদেশের গণতান্ত্রিক আন্দোলনের ইতিহাসে এক গুরুত্বপূর্ণ অধ্যায় হয়ে আছে।
১৯৯০ &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/738270/%E0%A6%B6%E0%A6%B9%E0%A7%80%E0%A6%A6-%E0%A6%A1%E0%A6%BE.-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%A8-%E0%A6%A6%E0%A6%BF%E0%A6%AC%E0%A6%B8-%E0%A6%86%E0%A6%9C">দেশ রূপান্তর</source>
    </item>

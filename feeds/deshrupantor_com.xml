      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/5a756d791bc59c976b1344bc24d79480-6afa05b88af71.jpg?jadewits_media_id=242898" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হৃদয়ের সেঞ্চুরিতে উজ্জ্বল বাংলাদেশ" /&gt;&lt;/p&gt;&lt;p&gt;মাত্র ২২ রানে ৩ উইকেট নেই। ইনিংসের প্রথম বলেই অভিষিক্ত মাহফিজুল ইসলাম রবিনের বিদায়। এরপর মুমিনুল হক ও অধিনায়ক নাজমুল হোসেন শান্তর সাজঘরে ফেরা। কাগিসো রাবাদার আগুনঝরা বোলিংয়ে জোহানেসবার্গ টেস্টের শুরুতেই দিশেহারা বাংলাদেশ দল। এমন পরিস্থিতিতে হাল ধরেন তাওহীদ হৃদয়। গতকাল দক্ষিণ আফ্রিকার বিপক্ষে প্রথমে &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735492/%E0%A6%B9%E0%A7%83%E0%A6%A6%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%87%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%89%E0%A6%9C%E0%A7%8D%E0%A6%9C%E0%A7%8D%E0%A6%AC%E0%A6%B2-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>ক্ষমা চাইলেন শ্রাবণ ক্ষুব্ধ জামাল</title>
      <link>https://www.deshrupantor.com/735491/%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%AE%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AC%E0%A6%A3-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%81%E0%A6%AC%E0%A7%8D%E0%A6%A7-%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%B2</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735491/%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%AE%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AC%E0%A6%A3-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%81%E0%A6%AC%E0%A7%8D%E0%A6%A7-%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%B2</guid>
      <pubDate>Mon, 16 Nov 2026 01:19:04 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/2b98f58ef88402dc72193dfe2c2e1851-6afa059ed0ff7.jpg?jadewits_media_id=242897" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/2b98f58ef88402dc72193dfe2c2e1851-6afa059ed0ff7.jpg?jadewits_media_id=242897" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/2b98f58ef88402dc72193dfe2c2e1851-6afa059ed0ff7.jpg?jadewits_media_id=242897" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ক্ষমা চাইলেন শ্রাবণ ক্ষুব্ধ জামাল" /&gt;&lt;/p&gt;&lt;p&gt;২৩ বছরের অপেক্ষা ঘুচিয়ে সাফ চ্যাম্পিয়নশিপের ফাইনালে ওঠার স্বপ্ন দেখেছিল বাংলাদেশ। কিন্তু শনিবার পাকিস্তানের কাছে ১-০ গোলে হেরে সেই স্বপ্ন শেষ হয়েছে সেমিফাইনালেই। ম্যাচের শেষ দিকে গোলকিপার মেহেদী হাসান শ্রাবণের একটি ভুলে গোল হজম করে বাংলাদেশ। আবদুল সামাদ আরশাদের সেই গোলেই প্রথমবারের মতো সাফের ফাইনালে&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735491/%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%AE%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AC%E0%A6%A3-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%81%E0%A6%AC%E0%A7%8D%E0%A6%A7-%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%B2">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>রবিনের তিক্ত অভিষেক</title>
      <link>https://www.deshrupantor.com/735490/%E0%A6%B0%E0%A6%AC%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%B7%E0%A7%87%E0%A6%95</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735490/%E0%A6%B0%E0%A6%AC%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%B7%E0%A7%87%E0%A6%95</guid>
      <pubDate>Mon, 16 Nov 2026 01:18:37 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/8f029fbabfd2c68040fd39ef2590201b-6afa05873450e.jpg?jadewits_media_id=242896" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/8f029fbabfd2c68040fd39ef2590201b-6afa05873450e.jpg?jadewits_media_id=242896" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/8f029fbabfd2c68040fd39ef2590201b-6afa05873450e.jpg?jadewits_media_id=242896" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রবিনের তিক্ত অভিষেক" /&gt;&lt;/p&gt;&lt;p&gt;টেস্ট ক্রিকেটে অভিষেকের দিনটা নিশ্চয়ই স্মরণীয় করে রাখতে চেয়েছিলেন মাহফিজুল ইসলাম রবিন। চলমান জাতীয় ক্রিকেট লিগে (এনসিএল) ধারাবাহিক রান করে দক্ষিণ আফ্রিকা সফরের দলে জায়গা করে নেওয়া এই তরুণ ওপেনারের সামনে ছিল নিজেকে প্রমাণের সুযোগ। কিন্তু জোহানেসবার্গের ওয়ান্ডারার্সে সিরিজের প্রথম টেস্টে সেই স্বপ্নের &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735490/%E0%A6%B0%E0%A6%AC%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%B7%E0%A7%87%E0%A6%95">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>ডাবল সেঞ্চুরিতে সেরা মোসাদ্দেক</title>
      <link>https://www.deshrupantor.com/735489/%E0%A6%A1%E0%A6%BE%E0%A6%AC%E0%A6%B2-%E0%A6%B8%E0%A7%87%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A7%87%E0%A6%B0%E0%A6%BE-%E0%A6%AE%E0%A7%8B%E0%A6%B8%E0%A6%BE%E0%A6%A6%E0%A7%8D%E0%A6%A6%E0%A7%87%E0%A6%95</link>

    <item>
      <title>করিমগঞ্জে বিদ্যুৎস্পৃষ্টে যুবকের মৃত্যু</title>
      <link>https://www.deshrupantor.com/735926/%E0%A6%95%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A7%8E%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81%C2%A0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735926/%E0%A6%95%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A7%8E%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81%C2%A0</guid>
      <pubDate>Tue, 17 Nov 2026 18:28:28 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2025/04/08/f0f4550b2ec75150c5f3271d8b9ccb00-67f51681ebb54.jpg?jadewits_media_id=104625" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2025/04/08/f0f4550b2ec75150c5f3271d8b9ccb00-67f51681ebb54.jpg?jadewits_media_id=104625" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2025/04/08/f0f4550b2ec75150c5f3271d8b9ccb00-67f51681ebb54.jpg?jadewits_media_id=104625" style="max-width:100%;height:auto;margin-bottom:10px;" alt="করিমগঞ্জে বিদ্যুৎস্পৃষ্টে যুবকের মৃত্যু" /&gt;&lt;/p&gt;&lt;p&gt;কিশোরগঞ্জের করিমগঞ্জে গাছ থেকে জলপাই পাড়তে গিয়ে বিদ্যুৎস্পৃষ্ট হয়ে মো. আলমগীর (৩৫) নামে এক যুবকের মৃত্যু হয়েছে। মঙ্গলবার (১৭ নভেম্বর) সকাল ১০টার দিকে উপজেলার নিয়ামতপুর ইউনিয়নের নাহিরাজ পাড়া বান্নিঘাটা গ্রামে এ দুর্ঘটনা ঘটে।&amp;nbsp;
নিহত আলমগীর মিয়া ওই গ্রামের মোহাম্মদ জামির উদ্দিনের ছেলে।&amp;nbsp;
স্থানী&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735926/%E0%A6%95%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A7%8E%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81%C2%A0">দেশ রূপান্তর</source>
    </item>

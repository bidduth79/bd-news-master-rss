    <item>
      <title>মার্কিন রাডার স্থাপনায় হামলার দাবি ইরানের</title>
      <link>https://www.deshrupantor.com/734812/%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8-%E0%A6%B0%E0%A6%BE%E0%A6%A1%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%AA%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF-%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734812/%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8-%E0%A6%B0%E0%A6%BE%E0%A6%A1%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%AA%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF-%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Fri, 13 Nov 2026 11:39:43 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/5add7ba222de767924b19463fbfa6b21-6af6a288ba8ca.jpg?jadewits_media_id=242186" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/5add7ba222de767924b19463fbfa6b21-6af6a288ba8ca.jpg?jadewits_media_id=242186" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/5add7ba222de767924b19463fbfa6b21-6af6a288ba8ca.jpg?jadewits_media_id=242186" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মার্কিন রাডার স্থাপনায় হামলার দাবি ইরানের" /&gt;&lt;/p&gt;&lt;p&gt;দক্ষিণ ইরানে টেলিযোগাযোগ টাওয়ারে বিমান হামলার জবাবে বাহরাইনে যুক্তরাষ্ট্রের একটি আগাম সতর্কতামূলক রাডার স্থাপনায় হামলা চালানোর দাবি করেছে ইরানের ইসলামিক রেভল্যুশনারি গার্ড কর্পস (আইআরজিসি)। খবর আল জাজিরা।&amp;nbsp;&amp;nbsp;
আইআরজিসির দাবি, দক্ষিণাঞ্চলীয় হরমোজগান প্রদেশের একটি টেলিযোগাযোগ টাওয়ারে হামলার প্র&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734812/%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8-%E0%A6%B0%E0%A6%BE%E0%A6%A1%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%AA%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF-%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>এমপি নুসরাতের বাড়িতে আগুন, ছাত্রলীগ-যুবলীগের ৮ নেতাসহ ৩৮ জনের বিরুদ্ধে মামলা</title>
      <link>https://www.deshrupantor.com/734811/%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF-%E0%A6%A8%E0%A7%81%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A7%AE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734811/%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF-%E0%A6%A8%E0%A7%81%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A7%AE</guid>
      <pubDate>Fri, 13 Nov 2026 11:32:43 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/3ca36ff426a1aa104403b1ca90d5c834-6af6a0d75dd30.jpg?jadewits_media_id=242185" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/3ca36ff426a1aa104403b1ca90d5c834-6af6a0d75dd30.jpg?jadewits_media_id=242185" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/3ca36ff426a1aa104403b1ca90d5c834-6af6a0d75dd30.jpg?jadewits_media_id=242185" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এমপি নুসরাতের বাড়িতে আগুন, ছাত্রলীগ-যুবলীগের ৮ নেতাসহ ৩৮ জনের বিরুদ্ধে মামলা" /&gt;&lt;/p&gt;&lt;p&gt;দৌলতপুরে সংরক্ষিত নারী আসনের সংসদ সদস্য ও জাতীয় নাগরিক পার্টির (এনসিপি) যুগ্ম আহ্বায়ক নুসরাত তাবাসসুম এমপির গ্রামের বাড়িতে অগ্নিকান্ডের ঘটনা ঘটেছে। এই ঘটনায় পরিবারের লোকজনকে হত্যাচেষ্টার অভিযোগ এনে নিষিদ্ধঘোষিত ছাত্রলীগ, কার্যক্রম নিষিদ্ধ যুবলীগ ও স্বেচ্ছাসেবক লীগের বিভিন্ন পর্যায়ের আট নেতাসহ অজ্ঞাত&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734811/%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF-%E0%A6%A8%E0%A7%81%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A7%AE">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>ইতিহাসের দ্বারপ্রান্তে মেসি, চ্যালেঞ্জ ছুড়লেন সুলিভান</title>

    <item>
      <title>কুয়াকাটায় এক ইলিশ বিক্রি সাড়ে ৮ হাজারে</title>
      <link>https://www.deshrupantor.com/735009/%E0%A6%95%E0%A7%81%E0%A7%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%9F%E0%A6%BE%E0%A7%9F-%E0%A6%8F%E0%A6%95-%E0%A6%87%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF-%E0%A6%B8%E0%A6%BE%E0%A7%9C%E0%A7%87-%E0%A7%AE-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735009/%E0%A6%95%E0%A7%81%E0%A7%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%9F%E0%A6%BE%E0%A7%9F-%E0%A6%8F%E0%A6%95-%E0%A6%87%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF-%E0%A6%B8%E0%A6%BE%E0%A7%9C%E0%A7%87-%E0%A7%AE-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87</guid>
      <pubDate>Sat, 14 Nov 2026 07:39:47 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/3f34fba5adc6222d1361dc695d1e561f-6af76df013b99.jpg?jadewits_media_id=242371" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/3f34fba5adc6222d1361dc695d1e561f-6af76df013b99.jpg?jadewits_media_id=242371" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/3f34fba5adc6222d1361dc695d1e561f-6af76df013b99.jpg?jadewits_media_id=242371" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কুয়াকাটায় এক ইলিশ বিক্রি সাড়ে ৮ হাজারে" /&gt;&lt;/p&gt;&lt;p&gt;২২ দিনের নিষেধাজ্ঞা শেষে কুয়াকাটাসংলগ্ন বঙ্গোপসাগরে নবী হোসেনের জালে ধরা পড়েছে ২ কেজি ৩০০ গ্রাম ওজনের একটি ইলিশ। গতকাল শুক্রবার মাছটি পটুয়াখালীর কুয়াকাটা পৌর মেয়র বাজারে আনা হলে নিলামে ৮ হাজার ৫১০ টাকায় কিনে নেন স্থানীয় ব্যবসায়ী জয়নাল ঘরামী। জয়নাল ঘরামী জানান, মাছটি রপ্তানি করবেন। এর আগে গত বুধবার ২&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735009/%E0%A6%95%E0%A7%81%E0%A7%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%9F%E0%A6%BE%E0%A7%9F-%E0%A6%8F%E0%A6%95-%E0%A6%87%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF-%E0%A6%B8%E0%A6%BE%E0%A7%9C%E0%A7%87-%E0%A7%AE-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>স্বাস্থ্যব্যবস্থা ঢেলে সাজাতে মন-মানসিকতারও পরিবর্তন দরকার</title>
      <link>https://www.deshrupantor.com/735008/%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE-%E0%A6%A2%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AE%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%95%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%93</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735008/%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE-%E0%A6%A2%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AE%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%95%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%93</guid>
      <pubDate>Sat, 14 Nov 2026 07:39:27 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/0cd4c5cc861c40565b8d17004e75cfdb-6af7bbc6d793a.jpg?jadewits_media_id=242389" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/0cd4c5cc861c40565b8d17004e75cfdb-6af7bbc6d793a.jpg?jadewits_media_id=242389" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/0cd4c5cc861c40565b8d17004e75cfdb-6af7bbc6d793a.jpg?jadewits_media_id=242389" style="max-width:100%;height:auto;margin-bottom:10px;" alt="স্বাস্থ্যব্যবস্থা ঢেলে সাজাতে মন-মানসিকতারও পরিবর্তন দরকার" /&gt;&lt;/p&gt;&lt;p&gt;জনগণের দোরগোড়ায় চিকিৎসাসেবা পৌঁছে দিতে দেশের সামগ্রিক স্বাস্থ্যব্যবস্থা ঢেলে সাজানোর পাশাপাশি সংশ্লিষ্ট সবার মানসিকতার পরিবর্তনের ওপর গুরুত্বারোপ করেছেন রাষ্ট্রপতি মির্জা ফখরুল ইসলাম আলমগীর। তিনি বলেন, &amp;lsquo;দেশের চিকিৎসাসেবায় বড় ধরনের পরিবর্তন প্রয়োজন। স্বাস্থ্যব্যবস্থাকে নতুন করে ঢেলে সাজাতে হবে&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735008/%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE-%E0%A6%A2%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AE%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%95%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%93">দেশ রূপান্তর</source>
    </item>
    <item>

      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/ed405c7207a4b4c1b4587e89e843cf1d-6af4c545863d0.jpg?jadewits_media_id=241928" length="0" type="image/jpeg" />

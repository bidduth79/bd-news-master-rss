      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/928b86a061bdcff4468528a2ea0d7311-6b03f49d42819.jpg?jadewits_media_id=244559" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/928b86a061bdcff4468528a2ea0d7311-6b03f49d42819.jpg?jadewits_media_id=244559" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/928b86a061bdcff4468528a2ea0d7311-6b03f49d42819.jpg?jadewits_media_id=244559" style="max-width:100%;height:auto;margin-bottom:10px;" alt="খোলপেটুয়ায় ডুবে শিশুর মৃত্যু" /&gt;&lt;/p&gt;&lt;p&gt;সাতক্ষীরার শ্যামনগরের উপজেলায় খোলপেটুয়ায় নদীর পানিতে সাগর হোসেন নামের ১১ বছর বয়সী এক শিশুর মৃত্যুর হয়েছে বলে জানিয়েছেন স্থানীয় ইউনিয়ন পরিষদের (ইউপি) সদস্য মশিউর রহমান ইয়াসিন। সোমবার (২৩ নভেম্বর) সকাল সাড়ে ১১টায় উপজেলার নাপিতখালী গ্রাম সংলগ্ন খোলপেটুয়া নদী থেকে তার মরদেহ উদ্ধার করা হয়।
মৃত সা&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737250/%E0%A6%96%E0%A7%8B%E0%A6%B2%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A7%81%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%A1%E0%A7%81%E0%A6%AC%E0%A7%87-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81">দেশ রূপান্তর</source>
    </item>

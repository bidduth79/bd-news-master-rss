      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/87dbef7c266306cc7e6cc6e191839125-6af25b6872b7b.jpg?jadewits_media_id=241440" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/87dbef7c266306cc7e6cc6e191839125-6af25b6872b7b.jpg?jadewits_media_id=241440" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/87dbef7c266306cc7e6cc6e191839125-6af25b6872b7b.jpg?jadewits_media_id=241440" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চলতি অর্থবছরে এ পর্যন্ত প্রবাসী আয় ১৩.৮৯ বিলিয়ন ডলার" /&gt;&lt;/p&gt;&lt;p&gt;চলতি ২০২৬-২৭ অর্থবছরের ২৩ নভেম্বর পর্যন্ত দেশে রেমিট্যান্স এসেছে ১ হাজার ৩৮৯ কোটি মার্কিন ডলার। যা গত অর্থবছরের একই সময়ের তুলনায় ১১ দশমিক ৯ শতাংশ বেশি। ২৪ নভেম্বর (মঙ্গলবার) কেন্দ্রীয় ব্যাংকের সর্বশেষ তথ্যানুযায়ী, ২০২৫-২৬ অর্থবছরের একই সময়ে দেশে রেমিট্যান্স এসেছিল ১ হাজার ২৪২ কোটি ডলার। খবর বাসস।
নভ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/738013/%E0%A6%9A%E0%A6%B2%E0%A6%A4%E0%A6%BF-%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87-%E0%A6%8F-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%80-%E0%A6%86%E0%A7%9F-%E0%A7%A7%E0%A7%A9.%E0%A7%AE%E0%A7%AF-%E0%A6%AC%E0%A6%BF%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%A8">দেশ রূপান্তর</source>

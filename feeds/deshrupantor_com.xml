    <item>
      <title>রাজধানীর কুর্মিটোলায় ককটেল বিস্ফোরণ, যা জানা গেল</title>
      <link>https://www.deshrupantor.com/738631/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%95%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%BF%E0%A6%9F%E0%A7%8B%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%AF%E0%A6%BE-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%97%E0%A7%87%E0%A6%B2</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/738631/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%95%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%BF%E0%A6%9F%E0%A7%8B%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%AF%E0%A6%BE-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%97%E0%A7%87%E0%A6%B2</guid>
      <pubDate>Sat, 28 Nov 2026 23:15:35 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/fbd9ffc72d0f8acb8c333a259cc9768b-6b0b0c1e428de.gif?jadewits_media_id=245911" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/fbd9ffc72d0f8acb8c333a259cc9768b-6b0b0c1e428de.gif?jadewits_media_id=245911" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/fbd9ffc72d0f8acb8c333a259cc9768b-6b0b0c1e428de.gif?jadewits_media_id=245911" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজধানীর কুর্মিটোলায় ককটেল বিস্ফোরণ, যা জানা গেল" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর কুর্মিটোলা এলাকায় ককটেল বিস্ফোরণ ঘটিয়েছে দুর্বৃত্তরা। শনিবার (২৮ নভেম্বর) রাত ৮টা ৫ মিনিটের দিকে কুর্মিটোলা বাসস্ট্যান্ড এলাকায় এ ঘটনা ঘটে। তবে তাৎক্ষণিকভাবে এ ঘটনায় কেউ হতাহত হওয়ার খবর পাওয়া যায়নি।
ক্যান্টনমেন্ট থানা সূত্রে জানা যায়, রাত ৮টা ৫ মিনিটের দিকে কুর্মিটোলা বাসস্ট্যান্ডের সামনের &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/738631/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%95%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%BF%E0%A6%9F%E0%A7%8B%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%AF%E0%A6%BE-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%97%E0%A7%87%E0%A6%B2">দেশ রূপান্তর</source>

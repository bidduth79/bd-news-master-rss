    <item>
      <title>প্রতারণায় ৫৬ এজেন্সির লাইসেন্স প্রত্যাহার</title>
      <link>https://www.deshrupantor.com/735524/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%A3%E0%A6%BE%E0%A7%9F-%E0%A7%AB%E0%A7%AC-%E0%A6%8F%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%B8%E0%A6%BF%E0%A6%B0-%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%B8%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%B8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735524/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%A3%E0%A6%BE%E0%A7%9F-%E0%A7%AB%E0%A7%AC-%E0%A6%8F%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%B8%E0%A6%BF%E0%A6%B0-%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%B8%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%B8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Mon, 16 Nov 2026 07:35:52 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/77978c3cee5f512e500ba6009aeffb44-6afa5df1034f3.jpg?jadewits_media_id=242921" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/77978c3cee5f512e500ba6009aeffb44-6afa5df1034f3.jpg?jadewits_media_id=242921" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/77978c3cee5f512e500ba6009aeffb44-6afa5df1034f3.jpg?jadewits_media_id=242921" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রতারণায় ৫৬ এজেন্সির লাইসেন্স প্রত্যাহার" /&gt;&lt;/p&gt;&lt;p&gt;বিদেশে কর্মসংস্থানের সুযোগ সম্প্রসারণ, দক্ষ জনশক্তি তৈরি এবং অভিবাসন খাতে প্রতারণা বন্ধে নানা উদ্যোগ নিয়েছে সরকার। ২০২৬ সালে বিশ্বের ১১৫টি দেশে বাংলাদেশি কর্মীরা কর্মসংস্থানের জন্য গেছেন। অন্যদিকে, বিভিন্ন অনিয়ম ও প্রতারণার অভিযোগে সম্প্রতি ৫৬টি রিক্রুটিং এজেন্সির লাইসেন্স প্রত্যাহার করা হয়েছে। মালয়&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735524/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%A3%E0%A6%BE%E0%A7%9F-%E0%A7%AB%E0%A7%AC-%E0%A6%8F%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%B8%E0%A6%BF%E0%A6%B0-%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%B8%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%B8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%B0">দেশ রূপান্তর</source>

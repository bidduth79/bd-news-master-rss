      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/153d70260c668bc9b3a63b63f361829e-6b0b0d159d7b4.gif?jadewits_media_id=245912" length="0" type="image/jpeg" />

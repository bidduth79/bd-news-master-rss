    </item>
    <item>
      <title>দেশে এলইইডি সনদপ্রাপ্ত সবুজ কারখানা এখন ৩০২</title>
      <link>https://www.deshrupantor.com/736726/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%8F%E0%A6%B2%E0%A6%87%E0%A6%87%E0%A6%A1%E0%A6%BF-%E0%A6%B8%E0%A6%A8%E0%A6%A6%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%A4-%E0%A6%B8%E0%A6%AC%E0%A7%81%E0%A6%9C-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%8F%E0%A6%96%E0%A6%A8-%E0%A7%A9%E0%A7%A6%E0%A7%A8</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736726/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%8F%E0%A6%B2%E0%A6%87%E0%A6%87%E0%A6%A1%E0%A6%BF-%E0%A6%B8%E0%A6%A8%E0%A6%A6%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%A4-%E0%A6%B8%E0%A6%AC%E0%A7%81%E0%A6%9C-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%8F%E0%A6%96%E0%A6%A8-%E0%A7%A9%E0%A7%A6%E0%A7%A8</guid>
      <pubDate>Sat, 21 Nov 2026 07:07:25 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/684b7a261a4ed9e812aaaa309d11b96a-6b008fd7c4d2b.jpg?jadewits_media_id=244037" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/684b7a261a4ed9e812aaaa309d11b96a-6b008fd7c4d2b.jpg?jadewits_media_id=244037" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/684b7a261a4ed9e812aaaa309d11b96a-6b008fd7c4d2b.jpg?jadewits_media_id=244037" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দেশে এলইইডি সনদপ্রাপ্ত সবুজ কারখানা এখন ৩০২" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশে এলইইডি সনদপ্রাপ্ত পরিবেশবান্ধব কারখানার সংখ্যা বেড়ে ৩০২টিতে দাঁড়িয়েছে। গত বৃহস্পতিবার নতুন করে ১২টি তৈরি পোশাক, বস্ত্র ও এক্সেসরিজ কারখানা যুক্তরাষ্ট্রের গ্রিন বিল্ডিং কাউন্সিলের (ইউএসজিবিসি) সনদ পাওয়ায় এ মাইলফলক অর্জিত হয়েছে।
ইউএসজিবিসির তথ্য অনুযায়ী, বিশ্বে সবচেয়ে বেশি এলইইডি সনদপ্রাপ্ত &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736726/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%8F%E0%A6%B2%E0%A6%87%E0%A6%87%E0%A6%A1%E0%A6%BF-%E0%A6%B8%E0%A6%A8%E0%A6%A6%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%A4-%E0%A6%B8%E0%A6%AC%E0%A7%81%E0%A6%9C-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%8F%E0%A6%96%E0%A6%A8-%E0%A7%A9%E0%A7%A6%E0%A7%A8">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>দোলনের ৭ দিন, মিজানুর ও তমালের ৪ দিনের রিমান্ড</title>
      <link>https://www.deshrupantor.com/736725/%E0%A6%A6%E0%A7%8B%E0%A6%B2%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A7%AD-%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%AE%E0%A6%BF%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B0-%E0%A6%93-%E0%A6%A4%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A7%AA-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736725/%E0%A6%A6%E0%A7%8B%E0%A6%B2%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A7%AD-%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%AE%E0%A6%BF%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B0-%E0%A6%93-%E0%A6%A4%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A7%AA-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1</guid>
      <pubDate>Sat, 21 Nov 2026 07:07:05 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/684b7a261a4ed9e812aaaa309d11b96a-6b008fd7c4d2b.jpg?jadewits_media_id=244037" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/684b7a261a4ed9e812aaaa309d11b96a-6b008fd7c4d2b.jpg?jadewits_media_id=244037" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/684b7a261a4ed9e812aaaa309d11b96a-6b008fd7c4d2b.jpg?jadewits_media_id=244037" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দোলনের ৭ দিন, মিজানুর ও তমালের ৪ দিনের রিমান্ড" /&gt;&lt;/p&gt;&lt;p&gt;ঢাকার ধানমন্ডি থানায় সন্ত্রাসবিরোধী আইনের মামলায় সাতক্ষীরা-৪ আসনের সাবেক সংসদ সদস্য এস এম আতাউল হক দোলনের ৭ দিন এবং সাবেক সচিব মিজানুর রহমান ও অভিনেতা আরিফ মাহমুদ তমালকে ৪ দিনের রিমান্ড দিয়েছে আদালত। ঢাকার মেট্রোপলিটন ম্যাজিস্ট্রেট সারাহ্ ফারজানা হক গতকাল শুক্রবার বিকেলে এ আদেশ দেন বলে জানিয়েছেন রাষ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736725/%E0%A6%A6%E0%A7%8B%E0%A6%B2%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A7%AD-%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%AE%E0%A6%BF%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B0-%E0%A6%93-%E0%A6%A4%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A7%AA-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>পোশাকশ্রমিকদের ন্যূনতম মজুরি সিপিডির প্রস্তাবে আপত্তি</title>
      <link>https://www.deshrupantor.com/736724/%E0%A6%AA%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%95%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A7%82%E0%A6%A8%E0%A6%A4%E0%A6%AE-%E0%A6%AE%E0%A6%9C%E0%A7%81%E0%A6%B0%E0%A6%BF%C2%A0%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%AC%E0%A7%87</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736724/%E0%A6%AA%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%95%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A7%82%E0%A6%A8%E0%A6%A4%E0%A6%AE-%E0%A6%AE%E0%A6%9C%E0%A7%81%E0%A6%B0%E0%A6%BF%C2%A0%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%AC%E0%A7%87</guid>
      <pubDate>Sat, 21 Nov 2026 07:06:25 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/2b07e08420a9a072be8d1a764b04c876-6b008bccb4dfa.jpg?jadewits_media_id=244023" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/2b07e08420a9a072be8d1a764b04c876-6b008bccb4dfa.jpg?jadewits_media_id=244023" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/2b07e08420a9a072be8d1a764b04c876-6b008bccb4dfa.jpg?jadewits_media_id=244023" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পোশাকশ্রমিকদের ন্যূনতম মজুরি সিপিডির প্রস্তাবে আপত্তি" /&gt;&lt;/p&gt;&lt;p&gt;তৈরি পোশাকশিল্পের শ্রমিকদের ন্যূনতম মজুরি নির্ধারণে সেন্টার ফর পলিসি ডায়ালগের (সিপিডি) দেওয়া প্রস্তাব নিয়ে আপত্তি তুলেছে পোশাক প্রস্তুতকারক ও রপ্তানিকারকদের সংগঠন বিজিএমইএ। সিপিডির প্রস্তাবে ব্যবহৃত তথ্য ও হিসাবপদ্ধতি নিয়ে প্রশ্ন তুলে সংগঠনটি বলেছে, এতে শ্রমিকদের প্রকৃত ব্যয় এবং শিল্পের বাস্তব পরিস্&lt;/p&gt;</description>

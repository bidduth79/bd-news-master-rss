    <item>
      <title>গোপালগঞ্জে সাংবাদিকের বাসায় হামলা, এমপির বাড়ি-থানায় আগুন</title>
      <link>https://www.deshrupantor.com/736392/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%82%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A7%9F-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736392/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%82%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A7%9F-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF%E0%A6%B0</guid>
      <pubDate>Thu, 19 Nov 2026 17:24:27 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/d9e0a2f41ce2d93e4198421846ed7033-6afedbed7f9d1.jpg?jadewits_media_id=243745" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/d9e0a2f41ce2d93e4198421846ed7033-6afedbed7f9d1.jpg?jadewits_media_id=243745" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/d9e0a2f41ce2d93e4198421846ed7033-6afedbed7f9d1.jpg?jadewits_media_id=243745" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গোপালগঞ্জে সাংবাদিকের বাসায় হামলা, এমপির বাড়ি-থানায় আগুন" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জে একের পর এক হামলা, ভাঙচুর ও অগ্নিসংযোগের ঘটনা ঘটেছে। বৃহস্পতিবার দুপুরে শহরের নবীনবাগ এলাকায় সাংবাদিক সেখ মো. একরামুল কবীর মুক্তর বাসায় হামলা চালিয়ে সিসিটিভি ক্যামেরা ও ভবনের জানালার কাচ ভাঙচুর করেছে দুর্বৃত্তরা। একই দিন জেলার কাশিয়ানীতে সংসদ সদস্য সেলিমুজ্জামান সেলিমের বাড়িতে ককটেল বিস্ফো&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736392/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%82%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A7%9F-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>নিখোঁজের চার দিন পর ওয়াসার খালে অটোরিকশাচালকের মরদেহ উদ্ধার</title>
      <link>https://www.deshrupantor.com/736391/%E0%A6%A8%E0%A6%BF%E0%A6%96%E0%A7%8B%E0%A6%81%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%AA%E0%A6%B0-%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A6%B0-%E0%A6%96%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%85%E0%A6%9F%E0%A7%8B%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%B6%E0%A6%BE%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%95%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736391/%E0%A6%A8%E0%A6%BF%E0%A6%96%E0%A7%8B%E0%A6%81%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%AA%E0%A6%B0-%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A6%B0-%E0%A6%96%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%85%E0%A6%9F%E0%A7%8B%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%B6%E0%A6%BE%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%95%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Thu, 19 Nov 2026 17:21:35 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/07579b92baac91498668a31c94c7e3ae-6afedb9429696.jpg?jadewits_media_id=243744" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/07579b92baac91498668a31c94c7e3ae-6afedb9429696.jpg?jadewits_media_id=243744" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/07579b92baac91498668a31c94c7e3ae-6afedb9429696.jpg?jadewits_media_id=243744" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নিখোঁজের চার দিন পর ওয়াসার খালে অটোরিকশাচালকের মরদেহ উদ্ধার" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর যাত্রাবাড়ীর মাতুয়াইলে নিখোঁজের চার দিন পর মুন্না (৩২) নামে এক অটোরিকশাচালকের মরদেহ উদ্ধার করেছে পুলিশ।
বৃহস্পতিবার (১৯ নভেম্বর) দুপুর ২টার দিকে মাতুয়াইলের মৃধাবাড়ি এলাকায় ওয়াসার খাল থেকে মরদেহটি উদ্ধার করা হয়। পরে ময়নাতদন্তের জন্য মরদেহ ঢাকা মেডিকেল কলেজ হাসপাতালের মর্গে পাঠানো হয়েছে।
যাত্র&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736391/%E0%A6%A8%E0%A6%BF%E0%A6%96%E0%A7%8B%E0%A6%81%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%AA%E0%A6%B0-%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A6%B0-%E0%A6%96%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%85%E0%A6%9F%E0%A7%8B%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%B6%E0%A6%BE%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%95%E0%A7%87%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>ফিফা সভাপতি নির্বাচনে ইনফান্তিনোর বিপক্ষে চূড়ান্ত দুই প্রার্থী</title>

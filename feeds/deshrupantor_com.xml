      <guid isPermaLink="true">https://www.deshrupantor.com/734172/%E0%A6%A1%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%B8%E0%A6%BF%E0%A6%B0-%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A6%AE%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A7%9F-%E0%A6%A6%E0%A6%B2%E0%A6%AE%E0%A6%A4%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B7%E0%A7%87-%E0%A6%86%E0%A6%87%E0%A6%A8</guid>
      <pubDate>Tue, 10 Nov 2026 21:24:36 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/077dbf53cfcaec5090368a5a0a872dba-6af3371d02415.jpg?jadewits_media_id=241623" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/077dbf53cfcaec5090368a5a0a872dba-6af3371d02415.jpg?jadewits_media_id=241623" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/077dbf53cfcaec5090368a5a0a872dba-6af3371d02415.jpg?jadewits_media_id=241623" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডিএনসিসির ভাবমূর্তি রক্ষায় দলমতনির্বিশেষে আইন মানার নির্দেশ প্রশাসকের" /&gt;&lt;/p&gt;&lt;p&gt;ঢাকা উত্তর সিটি করপোরেশনের (ডিএনসিসি) ভাবমূর্তি ও স্বচ্ছতা রক্ষায় দলমতনির্বিশেষে সবাইকে আইন ও বিধিমালা মেনে চলার নির্দেশ দিয়েছেন সংস্থাটির প্রশাসক মো. শফিকুল ইসলাম খান মিল্টন।&amp;nbsp;
তিনি বলেছেন, আইন ও বিধিমালার পরিপন্থী কোনো কাজ সহ্য করা হবে না।
মঙ্গলবার (১০ নভেম্বর) বিকেলে জাতীয় সংহতি ও বিপ্লব দিবস&lt;/p&gt;</description>

    <item>
      <title>বিএনপির ন্যাশনালিস্ট সাইবার ফোরাম গঠন</title>
      <link>https://www.deshrupantor.com/737123/%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B6%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%9F-%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%BE%E0%A6%AE-%E0%A6%97%E0%A6%A0%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737123/%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B6%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%9F-%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%BE%E0%A6%AE-%E0%A6%97%E0%A6%A0%E0%A6%A8</guid>
      <pubDate>Sun, 22 Nov 2026 22:18:08 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/ff1a4f41634ab8128ee677044f81b470-6b0314146e14e.gif?jadewits_media_id=244462" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/ff1a4f41634ab8128ee677044f81b470-6b0314146e14e.gif?jadewits_media_id=244462" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/ff1a4f41634ab8128ee677044f81b470-6b0314146e14e.gif?jadewits_media_id=244462" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিএনপির ন্যাশনালিস্ট সাইবার ফোরাম গঠন" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ জাতীয়তাবাদী দলের (বিএনপি) প্রচার ও প্রসারকে আরও গতিশীল করার লক্ষ্যে ন্যাশনালিস্ট সাইবার ফোরাম (এনসিএফ) গঠন করা হয়েছে। 
বাংলাদেশ জাতীয়তাবাদী দলের নির্বাহী কমিটির প্রচার সম্পাদক সুলতান সালাউদ্দিন টুকু এমপি স্বাক্ষরিত এক কমিটিতে ন্যাশনালিস্ট সাইবার ফোরাম-এনসিএফের নির্বাহী কমিটির চেয়ারম্যান নাস&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737123/%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B6%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%9F-%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%BE%E0%A6%AE-%E0%A6%97%E0%A6%A0%E0%A6%A8">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>প্রধানমন্ত্রীর ৬২তম জন্মদিনে জবি ছাত্রদলের ফল উৎসব</title>

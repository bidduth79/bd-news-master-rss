    <item>
      <title>বিশ্ব ডায়াবেটিস দিবস ২০২৬ উপলক্ষে গ্রামীণ হেলথটেকের সেমিনার</title>
      <link>https://www.deshrupantor.com/734335/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC-%E0%A6%A1%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%9F%E0%A6%BF%E0%A6%B8-%E0%A6%A6%E0%A6%BF%E0%A6%AC%E0%A6%B8-%E0%A7%A8%E0%A7%A6%E0%A7%A8%E0%A7%AC-%E0%A6%89%E0%A6%AA%E0%A6%B2%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%A3</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734335/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC-%E0%A6%A1%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%9F%E0%A6%BF%E0%A6%B8-%E0%A6%A6%E0%A6%BF%E0%A6%AC%E0%A6%B8-%E0%A7%A8%E0%A7%A6%E0%A7%A8%E0%A7%AC-%E0%A6%89%E0%A6%AA%E0%A6%B2%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%A3</guid>
      <pubDate>Wed, 11 Nov 2026 16:18:20 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/0af4f6001ea3e8d7bd8d5507b6acfa62-6af44093be63f.gif?jadewits_media_id=241762" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/0af4f6001ea3e8d7bd8d5507b6acfa62-6af44093be63f.gif?jadewits_media_id=241762" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/0af4f6001ea3e8d7bd8d5507b6acfa62-6af44093be63f.gif?jadewits_media_id=241762" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিশ্ব ডায়াবেটিস দিবস ২০২৬ উপলক্ষে গ্রামীণ হেলথটেকের সেমিনার" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশে লাখ লাখ মানুষ না জেনেই ডায়াবেটিস নিয়ে বেঁচে আছেন। অথচ সময়মতো স্ক্রিনিং, দ্রুত চিকিৎসা এবং দৈনন্দিন জীবনের সহজ কিছু পরিবর্তনে ডায়াবেটিস প্রতিরোধ এবং ভালোভাবে নিয়ন্ত্রণ করা সম্ভব।
বিশ্ব ডায়াবেটিস দিবসের বৈশ্বিক প্রতিপাদ্য &amp;lsquo;আরলি অ্যাকশন অন ডায়াবিটিস&amp;rsquo;,&amp;nbsp;সামনে রেখে গ্রামী&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734335/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC-%E0%A6%A1%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%9F%E0%A6%BF%E0%A6%B8-%E0%A6%A6%E0%A6%BF%E0%A6%AC%E0%A6%B8-%E0%A7%A8%E0%A7%A6%E0%A7%A8%E0%A7%AC-%E0%A6%89%E0%A6%AA%E0%A6%B2%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%A3">দেশ রূপান্তর</source>

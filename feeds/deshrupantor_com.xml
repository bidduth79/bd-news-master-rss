    <item>
      <title>বোমাবাজি, বাসে আগুন লাগানো আ.লীগের ইতিহাস</title>
      <link>https://www.deshrupantor.com/734265/%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BF-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%B2%E0%A6%BE%E0%A6%97%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%87%E0%A6%A4%E0%A6%BF%E0%A6%B9%E0%A6%BE%E0%A6%B8</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734265/%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BF-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%B2%E0%A6%BE%E0%A6%97%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%87%E0%A6%A4%E0%A6%BF%E0%A6%B9%E0%A6%BE%E0%A6%B8</guid>
      <pubDate>Wed, 11 Nov 2026 07:23:47 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/4511c02e014b3ac3184fdb377db1f339-6af36cf0080dc.jpg?jadewits_media_id=241681" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/4511c02e014b3ac3184fdb377db1f339-6af36cf0080dc.jpg?jadewits_media_id=241681" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/4511c02e014b3ac3184fdb377db1f339-6af36cf0080dc.jpg?jadewits_media_id=241681" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বোমাবাজি, বাসে আগুন লাগানো আ.লীগের ইতিহাস" /&gt;&lt;/p&gt;&lt;p&gt;সমাজকল্যাণ এবং নারী ও শিশুবিষয়ক মন্ত্রী ডা. এজেডএম জাহিদ হোসেন বলেছেন, ৫ আগস্টের আগে যারা ক্ষমতায় ছিলেন তারা দেশের অর্থনীতিকে ভঙ্গুর করে কঙ্কাল রেখে পালিয়ে গেছেন। মঙ্গলবার সকালে রূপগঞ্জ উপজেলার দাউদপুর এলাকায় দাউদপুর জেনারেল হাসপাতাল ও রাজিয়া মেমোরিয়াল ট্রাস্টের উদ্বোধনকালে প্রধান অতিথির বক্তব্যে তি&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734265/%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BF-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%B2%E0%A6%BE%E0%A6%97%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%87%E0%A6%A4%E0%A6%BF%E0%A6%B9%E0%A6%BE%E0%A6%B8">দেশ রূপান্তর</source>

      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/bd3fa113ab792da0cbf919713d16451d-6afed29a35a45.jpg?jadewits_media_id=243741" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/bd3fa113ab792da0cbf919713d16451d-6afed29a35a45.jpg?jadewits_media_id=243741" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/bd3fa113ab792da0cbf919713d16451d-6afed29a35a45.jpg?jadewits_media_id=243741" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাংলাদেশ ব্যাংকের নির্বাহী পরিচালক হলেন মো. শফিকুল ইসলাম" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ ব্যাংকের নির্বাহী পরিচালক (পরিসংখ্যান) পদে পদোন্নতি পেয়েছেন কেন্দ্রীয় ব্যাংকের ক্রেডিট ইনফরমেশন ব্যুরোর (সিআইবি) পরিচালক মো. শফিকুল ইসলাম।
প্রায় তিন দশকের পেশাগত জীবনে তিনি বাংলাদেশ ব্যাংকের পরিসংখ্যান, বৈদেশিক খাতের তথ্য ব্যবস্থাপনা, ঋণতথ্য ব্যবস্থাপনা ও তথ্যপ্রযুক্তিনির্ভর বিভিন্ন গুরুত্ব&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736388/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A7%80-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%95-%E0%A6%B9%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AE%E0%A7%8B.-%E0%A6%B6%E0%A6%AB%E0%A6%BF%E0%A6%95%E0%A7%81%E0%A6%B2">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>লর্ডসে নেপালের সঙ্গে টি২০ খেলবে বাংলাদেশ</title>
      <link>https://www.deshrupantor.com/736387/%E0%A6%B2%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A6%B8%E0%A7%87-%E0%A6%A8%E0%A7%87%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%9F%E0%A6%BF%E0%A7%A8%E0%A7%A6-%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A6%AC%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736387/%E0%A6%B2%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A6%B8%E0%A7%87-%E0%A6%A8%E0%A7%87%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%9F%E0%A6%BF%E0%A7%A8%E0%A7%A6-%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A6%AC%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6</guid>
      <pubDate>Thu, 19 Nov 2026 16:42:01 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/a2a651349a69c7a3d536306572032487-6afed210dda59.jpg?jadewits_media_id=243740" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/a2a651349a69c7a3d536306572032487-6afed210dda59.jpg?jadewits_media_id=243740" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/a2a651349a69c7a3d536306572032487-6afed210dda59.jpg?jadewits_media_id=243740" style="max-width:100%;height:auto;margin-bottom:10px;" alt="লর্ডসে নেপালের সঙ্গে টি২০ খেলবে বাংলাদেশ" /&gt;&lt;/p&gt;&lt;p&gt;ইংল্যান্ডের ঐতিহাসিক ক্রিকেট ভেন্যু লর্ডসে আগামী বছরের জুনে নেপালের মুখোমুখি হবে বাংলাদেশ দল। ২০২৭ সালের ৩ জুন (বৃহস্পতিবার) অনুষ্ঠিত হবে দুই দলের একমাত্র টি-টোয়েন্টি ম্যাচটি। মেরিলিবোন ক্রিকেট ক্লাবের (এমসিসি) আয়োজনে এই ম্যাচ দিয়ে প্রথমবারের মতো লর্ডসে ছেলেদের টি-টোয়েন্টি খেলবে বাংলাদেশ।
এমসিসি জান&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736387/%E0%A6%B2%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A6%B8%E0%A7%87-%E0%A6%A8%E0%A7%87%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%9F%E0%A6%BF%E0%A7%A8%E0%A7%A6-%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A6%AC%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>সুনামগঞ্জে গ্রামীণ ব্যাংকে অগ্নিসংযোগ</title>
      <link>https://www.deshrupantor.com/736386/%E0%A6%B8%E0%A7%81%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%A3-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A7%87-%E0%A6%85%E0%A6%97%E0%A7%8D%E0%A6%A8%E0%A6%BF%E0%A6%B8%E0%A6%82%E0%A6%AF%E0%A7%8B%E0%A6%97</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736386/%E0%A6%B8%E0%A7%81%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%A3-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A7%87-%E0%A6%85%E0%A6%97%E0%A7%8D%E0%A6%A8%E0%A6%BF%E0%A6%B8%E0%A6%82%E0%A6%AF%E0%A7%8B%E0%A6%97</guid>
      <pubDate>Thu, 19 Nov 2026 16:38:10 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/a3cba699f316fe17b4deabfd3faa9666-6afed170a1f10.jpg?jadewits_media_id=243739" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/a3cba699f316fe17b4deabfd3faa9666-6afed170a1f10.jpg?jadewits_media_id=243739" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/a3cba699f316fe17b4deabfd3faa9666-6afed170a1f10.jpg?jadewits_media_id=243739" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সুনামগঞ্জে গ্রামীণ ব্যাংকে অগ্নিসংযোগ" /&gt;&lt;/p&gt;&lt;p&gt;সুনামগঞ্জের তাহিরপুরে গ্রামীণ ব্যাংকের শাখায় পেট্রল ঢেলে অগ্নিসংযোগ করেছে দুর্বৃত্তরা। বৃহস্পতিবার (১৯ নভেম্বর) ভোরে তাহিরপুর উপজেলা পরিষদসংলগ্ন গ্রামীণ ব্যাংকের তাহিরপুর শাখায় এ ঘটনা ঘটে।&amp;nbsp;
তবে স্থানীয়দের তাৎক্ষণিক প্রচেষ্টায় আগুন নিয়ন্ত্রণে আসায় বড় ধরনের ক্ষয়ক্ষতি থেকে রক্ষা পেয়েছে ব্যাংকটি।
স&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736386/%E0%A6%B8%E0%A7%81%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%A3-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A7%87-%E0%A6%85%E0%A6%97%E0%A7%8D%E0%A6%A8%E0%A6%BF%E0%A6%B8%E0%A6%82%E0%A6%AF%E0%A7%8B%E0%A6%97">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>মিরসরাইয়ে মহাসড়কে গাছ ফেলে ব্যারিকেড</title>
      <link>https://www.deshrupantor.com/736385/%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%87%E0%A7%9F%E0%A7%87-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A7%9C%E0%A6%95%E0%A7%87-%E0%A6%97%E0%A6%BE%E0%A6%9B-%E0%A6%AB%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%A1</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736385/%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%87%E0%A7%9F%E0%A7%87-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A7%9C%E0%A6%95%E0%A7%87-%E0%A6%97%E0%A6%BE%E0%A6%9B-%E0%A6%AB%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%A1</guid>
      <pubDate>Thu, 19 Nov 2026 16:32:07 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/c11a9db62ac106d77082fc2f51d9f194-6afed0136ccef.jpg?jadewits_media_id=243738" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/c11a9db62ac106d77082fc2f51d9f194-6afed0136ccef.jpg?jadewits_media_id=243738" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/c11a9db62ac106d77082fc2f51d9f194-6afed0136ccef.jpg?jadewits_media_id=243738" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মিরসরাইয়ে মহাসড়কে গাছ ফেলে ব্যারিকেড" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রামের মিরসরাইয়ে ঢাকা-চট্টগ্রাম মহাসড়কে গাছ ফেলে ব্যারিকেড দেওয়ার ঘটনা ঘটেছে। বৃহস্পতিবার (১৯ নভেম্বর) ভোর ৫টার দিকে উপজেলার ১২ নম্বর খৈয়াছড়া ইউনিয়নের নিজতালুক কলঘর এলাকায় এ ঘটনা ঘটে।&amp;nbsp;
এতে চট্টগ্রামমুখী লেনে যান চলাচল ব্যাহত হয় এবং প্রায় দেড় কিলোমিটার যানজটের সৃষ্টি হয়।
স্থানীয় সূত্রে জানা&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736385/%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%87%E0%A7%9F%E0%A7%87-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A7%9C%E0%A6%95%E0%A7%87-%E0%A6%97%E0%A6%BE%E0%A6%9B-%E0%A6%AB%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%A1">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>ডেঙ্গুতে আরও ২ মৃত্যু, হাসপাতালে ১৬১৫</title>
      <link>https://www.deshrupantor.com/736383/%E0%A6%A1%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%81%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A7%A8-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A7%A7%E0%A7%AC%E0%A7%A7%E0%A7%AB</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736383/%E0%A6%A1%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%81%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A7%A8-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A7%A7%E0%A7%AC%E0%A7%A7%E0%A7%AB</guid>
      <pubDate>Thu, 19 Nov 2026 16:23:24 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/09/11/6894e56a8faedc58e159868bacfc1670-6aa369370dcef.jpg?jadewits_media_id=227511" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/09/11/6894e56a8faedc58e159868bacfc1670-6aa369370dcef.jpg?jadewits_media_id=227511" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/09/11/6894e56a8faedc58e159868bacfc1670-6aa369370dcef.jpg?jadewits_media_id=227511" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডেঙ্গুতে আরও ২ মৃত্যু, হাসপাতালে ১৬১৫" /&gt;&lt;/p&gt;&lt;p&gt;ডেঙ্গুতে গত ২৪ ঘণ্টায় আরও দুজনের মৃত্যু হয়েছে। একই সময়ে সারা দেশে নতুন করে ১ হাজার ৬১৫ জন ডেঙ্গু আক্রান্ত হয়ে হাসপাতালে ভর্তি হয়েছেন।
বৃহস্পতিবার (১৯ নভেম্বর) স্বাস্থ্য অধিদপ্তরের হেলথ ইমার্জেন্সি অপারেশন সেন্টার ও কন্ট্রোল রুমের প্রকাশিত প্রতিবেদনে এ তথ্য জানানো হয়।
প্রতিবেদন অনুযায়ী, হামে মারা যাও&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736383/%E0%A6%A1%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%81%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A7%A8-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A7%A7%E0%A7%AC%E0%A7%A7%E0%A7%AB">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>১১ দলীয় ঐক্যের শীর্ষ বৈঠক: দেশবিরোধী অপতৎপরতা প্রতিহত করার ঘোষণা</title>
      <link>https://www.deshrupantor.com/736382/%E0%A7%A7%E0%A7%A7-%E0%A6%A6%E0%A6%B2%E0%A7%80%E0%A7%9F-%E0%A6%90%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A7%80%E0%A6%B0%E0%A7%8D%E0%A6%B7-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%80-%E0%A6%85%E0%A6%AA%E0%A6%A4%E0%A7%8E%E0%A6%AA%E0%A6%B0%E0%A6%A4%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736382/%E0%A7%A7%E0%A7%A7-%E0%A6%A6%E0%A6%B2%E0%A7%80%E0%A7%9F-%E0%A6%90%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A7%80%E0%A6%B0%E0%A7%8D%E0%A6%B7-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%80-%E0%A6%85%E0%A6%AA%E0%A6%A4%E0%A7%8E%E0%A6%AA%E0%A6%B0%E0%A6%A4%E0%A6%BE</guid>
      <pubDate>Thu, 19 Nov 2026 16:21:07 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/4c6d269f32815bd08f3b10edc0d57c1a-6afecd6968097.jpeg?jadewits_media_id=243731" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/4c6d269f32815bd08f3b10edc0d57c1a-6afecd6968097.jpeg?jadewits_media_id=243731" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/4c6d269f32815bd08f3b10edc0d57c1a-6afecd6968097.jpeg?jadewits_media_id=243731" style="max-width:100%;height:auto;margin-bottom:10px;" alt="১১ দলীয় ঐক্যের শীর্ষ বৈঠক: দেশবিরোধী অপতৎপরতা প্রতিহত করার ঘোষণা" /&gt;&lt;/p&gt;&lt;p&gt;বৃহস্পতিবার (১৯ নভেম্বর) সকালে জাতীয় সংসদের বিরোধীদলীয় নেতার সরকারি বাসভবন ২৯ মিন্টো রোডে ১১ দলীয় ঐক্যের শীর্ষ নেতৃবৃন্দের বৈঠক অনুষ্ঠিত হয়েছে। বাংলাদেশ জামায়াতে ইসলামীর আমীর ও বিরোধীদলীয় নেতা ডা. শফিকুর রহমানের সভাপতিত্বে এ বৈঠক অনুষ্ঠিত হয়।
বৈঠকে ১১ দলীয় ঐক্যের শীর্ষ নেতৃবৃন্দ ও বিভিন্ন দলের প্রতি&lt;/p&gt;</description>

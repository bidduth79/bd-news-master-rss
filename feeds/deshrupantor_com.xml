      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/a3e363337f4c58b55cbd0097588dd881-6b09a863ea988.jpg?jadewits_media_id=245650" length="0" type="image/jpeg" />

      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/0382c019e34c1d9bb68e4be7f7f9ef49-6af1d968bc7b5.gif?jadewits_media_id=241363" length="0" type="image/jpeg" />

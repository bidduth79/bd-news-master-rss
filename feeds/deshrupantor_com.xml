    <item>
      <title>ফটিকছড়িতে বিএনপি'র মিছিলে হামলা,আহত ৬</title>
      <link>https://www.deshrupantor.com/736912/%E0%A6%AB%E0%A6%9F%E0%A6%BF%E0%A6%95%E0%A6%9B%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A6%B2%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%86%E0%A6%B9%E0%A6%A4-%E0%A7%AC%C2%A0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736912/%E0%A6%AB%E0%A6%9F%E0%A6%BF%E0%A6%95%E0%A6%9B%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A6%B2%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%86%E0%A6%B9%E0%A6%A4-%E0%A7%AC%C2%A0</guid>
      <pubDate>Sun, 22 Nov 2026 02:06:45 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/67b316123498c3052a6c00e39cea7f43-6b01f99acac1b.jpg?jadewits_media_id=244252" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/67b316123498c3052a6c00e39cea7f43-6b01f99acac1b.jpg?jadewits_media_id=244252" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/67b316123498c3052a6c00e39cea7f43-6b01f99acac1b.jpg?jadewits_media_id=244252" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফটিকছড়িতে বিএনপি'র মিছিলে হামলা,আহত ৬" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রামের ফটিকছড়ির নানুপুর&amp;ndash;কিপাইতনগর এলাকায় আওয়ামী লীগ বিরোধী মিছিলকে কেন্দ্র করে সংঘর্ষ ও হামলার অভিযোগ উঠেছে। এ সময় কার্যক্রম নিষিদ্ধ যুবলীগের বিরুদ্ধে বিএনপি কর্মীদের কয়েকটি মোটরসাইকেল ভাঙচুর ও আগুন দিয়ে পুড়িয়ে দেওয়া হয়েছে বলে অভিযোগ পাওয়া গেছে। ঘটনায় ৬ ছাত্রদল কর্মী আহত হয়েছেন। আহতদের মধ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736912/%E0%A6%AB%E0%A6%9F%E0%A6%BF%E0%A6%95%E0%A6%9B%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A6%B2%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%86%E0%A6%B9%E0%A6%A4-%E0%A7%AC%C2%A0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>ঠাকুরগাঁওয়ে কৃষিজমির মাটি কর্তনের দায়ে ৫০ হাজার টাকা জরিমানা</title>
      <link>https://www.deshrupantor.com/736911/%E0%A6%A0%E0%A6%BE%E0%A6%95%E0%A7%81%E0%A6%B0%E0%A6%97%E0%A6%BE%E0%A6%81%E0%A6%93%E0%A7%9F%E0%A7%87-%E0%A6%95%E0%A7%83%E0%A6%B7%E0%A6%BF%E0%A6%9C%E0%A6%AE%E0%A6%BF%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%9F%E0%A6%BF-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A7%AB%E0%A7%A6-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736911/%E0%A6%A0%E0%A6%BE%E0%A6%95%E0%A7%81%E0%A6%B0%E0%A6%97%E0%A6%BE%E0%A6%81%E0%A6%93%E0%A7%9F%E0%A7%87-%E0%A6%95%E0%A7%83%E0%A6%B7%E0%A6%BF%E0%A6%9C%E0%A6%AE%E0%A6%BF%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%9F%E0%A6%BF-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A7%AB%E0%A7%A6-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Sun, 22 Nov 2026 01:57:59 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/489f4a35e96e5e2c4bc5350c88591d4f-6b01f7bf0904c.jpg?jadewits_media_id=244251" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/489f4a35e96e5e2c4bc5350c88591d4f-6b01f7bf0904c.jpg?jadewits_media_id=244251" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/489f4a35e96e5e2c4bc5350c88591d4f-6b01f7bf0904c.jpg?jadewits_media_id=244251" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঠাকুরগাঁওয়ে কৃষিজমির মাটি কর্তনের দায়ে ৫০ হাজার টাকা জরিমানা" /&gt;&lt;/p&gt;&lt;p&gt;ঠাকুরগাঁওয়ের রুহিয়ায় ফসলি জমির উপরিভাগের উর্বর মাটি কাটার অভিযোগে সুজন ইসলাম নামে এক ব্যক্তিকে ৫০ হাজার টাকা জরিমানা করেছে ভ্রাম্যমাণ আদালত।
শনিবার উপজেলার মধুপুর ও ঢোলারহাট সংলগ্ন শুকনদী এলাকায় এই অভিযান চালিয়ে &amp;nbsp;ভ্রাম্যমাণ আদালতের নির্বাহী ম্যাজিস্ট্রেট ইমরান কবির এই জরিমানার আদেশ দেন।
এসময়&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736911/%E0%A6%A0%E0%A6%BE%E0%A6%95%E0%A7%81%E0%A6%B0%E0%A6%97%E0%A6%BE%E0%A6%81%E0%A6%93%E0%A7%9F%E0%A7%87-%E0%A6%95%E0%A7%83%E0%A6%B7%E0%A6%BF%E0%A6%9C%E0%A6%AE%E0%A6%BF%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%9F%E0%A6%BF-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A7%AB%E0%A7%A6-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>খুলনায় বিএনপি নেতা গুলিবিদ্ধ</title>
      <link>https://www.deshrupantor.com/736910/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736910/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7</guid>

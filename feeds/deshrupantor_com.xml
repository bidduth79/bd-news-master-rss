      <guid isPermaLink="true">https://www.deshrupantor.com/734891/%E0%A6%9C%E0%A7%87%E0%A6%AC%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A6%AE%E0%A7%9F%E0%A7%87-%E0%A6%9A%E0%A6%9F%E0%A7%8D%E0%A6%9F%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%AC%E0%A6%BE%E0%A6%98-%E0%A6%86%E0%A6%A8%E0%A6%B2-%E0%A6%B8%E0%A6%BE%E0%A6%AB%E0%A6%BE%E0%A6%B0%E0%A6%BF</guid>
      <pubDate>Fri, 13 Nov 2026 19:50:50 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/ece565dd5c83767007eddd70f61b7b5f-6af715b027dc3.jpg?jadewits_media_id=242276" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/ece565dd5c83767007eddd70f61b7b5f-6af715b027dc3.jpg?jadewits_media_id=242276" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/ece565dd5c83767007eddd70f61b7b5f-6af715b027dc3.jpg?jadewits_media_id=242276" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জেব্রার বিনিময়ে চট্টগ্রাম থেকে তিন বাঘ আনল সাফারি পার্ক" /&gt;&lt;/p&gt;&lt;p&gt;গাজীপুরের শ্রীপুরে সাফারি পার্কে প্রাণী বিনিময়ের মাধ্যমে চট্টগ্রাম চিড়িয়াখানা থেকে তিনটি বাঘ আনা হয়েছে। এর বিনিময়ে সাফারি পার্ক থেকে চট্টগ্রাম চিড়িয়াখানাকে ছয়টি জেব্রা দেওয়া হচ্ছে। দুই প্রতিষ্ঠানের মধ্যে আলোচনার ভিত্তিতে এ প্রাণী বিনিময় সম্পন্ন হয়েছে।
শুক্রবার (১৩ নভেম্বর) ভোরে চট্টগ্রাম চিড়িয়াখানা &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734891/%E0%A6%9C%E0%A7%87%E0%A6%AC%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A6%AE%E0%A7%9F%E0%A7%87-%E0%A6%9A%E0%A6%9F%E0%A7%8D%E0%A6%9F%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%AC%E0%A6%BE%E0%A6%98-%E0%A6%86%E0%A6%A8%E0%A6%B2-%E0%A6%B8%E0%A6%BE%E0%A6%AB%E0%A6%BE%E0%A6%B0%E0%A6%BF">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>এমপির বাড়িতে অগ্নিকাণ্ড: বিরোধীদলীয় সংসদীয় টিমের ঘটনাস্থল পরিদর্শন</title>
      <link>https://www.deshrupantor.com/734890/%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%85%E0%A6%97%E0%A7%8D%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%A3%E0%A7%8D%E0%A6%A1-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%80%E0%A6%A6%E0%A6%B2%E0%A7%80%E0%A7%9F-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6%E0%A7%80%E0%A7%9F-%E0%A6%9F%E0%A6%BF%E0%A6%AE%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734890/%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%85%E0%A6%97%E0%A7%8D%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%A3%E0%A7%8D%E0%A6%A1-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%80%E0%A6%A6%E0%A6%B2%E0%A7%80%E0%A7%9F-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6%E0%A7%80%E0%A7%9F-%E0%A6%9F%E0%A6%BF%E0%A6%AE%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Fri, 13 Nov 2026 19:44:14 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/8e1f18bbf9c7aa2de4b50b5228fa9914-6af714138fc97.jpg?jadewits_media_id=242274" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/8e1f18bbf9c7aa2de4b50b5228fa9914-6af714138fc97.jpg?jadewits_media_id=242274" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/8e1f18bbf9c7aa2de4b50b5228fa9914-6af714138fc97.jpg?jadewits_media_id=242274" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এমপির বাড়িতে অগ্নিকাণ্ড: বিরোধীদলীয় সংসদীয় টিমের ঘটনাস্থল পরিদর্শন" /&gt;&lt;/p&gt;&lt;p&gt;সংরক্ষিত নারী আসনের সংসদ সদস্য ও এনসিপি নেত্রী নুসরাত তাবাসসুমের বাড়িতে অগ্নিকাণ্ডের ঘটনায় কাজ করছে তদন্ত কমিটি। জেলা প্রশাসন, পুলিশ, বিজিবি ও ফায়ার সার্ভিসের সদস্যদের সমন্বয়ে গঠিত যৌথ তদন্ত দল অগ্নিকাণ্ডের কারণ উদ্&amp;zwnj;ঘাটনে কাজ করছে।
এদিকে বৈদ্যুতিক শর্টসার্কিট থেকে আগুনের সূত্রপাত হয়নি বলে তদন্ত&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734890/%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%85%E0%A6%97%E0%A7%8D%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%A3%E0%A7%8D%E0%A6%A1-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%80%E0%A6%A6%E0%A6%B2%E0%A7%80%E0%A7%9F-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6%E0%A7%80%E0%A7%9F-%E0%A6%9F%E0%A6%BF%E0%A6%AE%E0%A7%87%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>'বাংলাদেশের মতো জয়ের ক্ষুধা আর কারো নেই'</title>
      <link>https://www.deshrupantor.com/734889/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%A4%E0%A7%8B-%E0%A6%9C%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%81%E0%A6%A7%E0%A6%BE-%E0%A6%86%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8B-%E0%A6%A8%E0%A7%87%E0%A6%87</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734889/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%A4%E0%A7%8B-%E0%A6%9C%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%81%E0%A6%A7%E0%A6%BE-%E0%A6%86%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8B-%E0%A6%A8%E0%A7%87%E0%A6%87</guid>
      <pubDate>Fri, 13 Nov 2026 19:42:59 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/bf4517b82f18d90701ca744796e606f7-6af7131f108a0.jpg?jadewits_media_id=242272" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/bf4517b82f18d90701ca744796e606f7-6af7131f108a0.jpg?jadewits_media_id=242272" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/bf4517b82f18d90701ca744796e606f7-6af7131f108a0.jpg?jadewits_media_id=242272" style="max-width:100%;height:auto;margin-bottom:10px;" alt="'বাংলাদেশের মতো জয়ের ক্ষুধা আর কারো নেই'" /&gt;&lt;/p&gt;&lt;p&gt;সাফে পাকিস্তানের বিপক্ষে কাল গুরুত্বপূর্ণ ম্যাচের আগে দলকে শতভাগ প্রস্তুত থাকার তাগিদ দিয়েছেন বাংলাদেশ জাতীয় ফুটবল দলের প্রধান কোচ টমাস ডুলি। প্রতিপক্ষকে সমীহ করলেও নিজেদের সামর্থ্যের ওপর আস্থা রাখছেন তিনি। একই সঙ্গে সমর্থকদের কাছ থেকে আরও বেশি সমর্থন প্রত্যাশা করেছেন এই কোচ। তাঁর আশা, জাতীয় স্টে&lt;/p&gt;</description>

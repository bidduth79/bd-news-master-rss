    <item>
      <title>ফরিদপুরে নিক্সন চৌধুরীসহ ২৪৬ জনের বিরুদ্ধে মামলা</title>
      <link>https://www.deshrupantor.com/737132/%E0%A6%AB%E0%A6%B0%E0%A6%BF%E0%A6%A6%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%A8-%E0%A6%9A%E0%A7%8C%E0%A6%A7%E0%A7%81%E0%A6%B0%E0%A7%80%E0%A6%B8%E0%A6%B9-%E0%A7%A8%E0%A7%AA%E0%A7%AC-%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737132/%E0%A6%AB%E0%A6%B0%E0%A6%BF%E0%A6%A6%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%A8-%E0%A6%9A%E0%A7%8C%E0%A6%A7%E0%A7%81%E0%A6%B0%E0%A7%80%E0%A6%B8%E0%A6%B9-%E0%A7%A8%E0%A7%AA%E0%A7%AC-%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE</guid>
      <pubDate>Sun, 22 Nov 2026 23:15:25 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/58acbc48ee540e9da3ec52d57fc308fd-6b03227039a7a.gif?jadewits_media_id=244470" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/58acbc48ee540e9da3ec52d57fc308fd-6b03227039a7a.gif?jadewits_media_id=244470" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/58acbc48ee540e9da3ec52d57fc308fd-6b03227039a7a.gif?jadewits_media_id=244470" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফরিদপুরে নিক্সন চৌধুরীসহ ২৪৬ জনের বিরুদ্ধে মামলা" /&gt;&lt;/p&gt;&lt;p&gt;ফরিদপুরের ভাঙ্গায় কৃষকদল নেতা রাজু মোল্লা হত্যার ঘটনায় সাবেক সংসদ সদস্য ও কার্যক্রম নিষিদ্ধ যুবলীগের প্রেসিডিয়াম সদস্য মজিবুর রহমান নিক্সন চৌধুরীকে প্রধান আসামি করে ৯৬ জনের নাম উল্লেখ করে অজ্ঞাতপরিচয় আরও ১০০ থেকে ১৫০ জনসহ মোট ২৪৬ জনের নামে হত্যা মামলা করা হয়েছে।
রবিবার(২২ নভেম্বর) দুপুরে রাজু ম&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737132/%E0%A6%AB%E0%A6%B0%E0%A6%BF%E0%A6%A6%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%A8-%E0%A6%9A%E0%A7%8C%E0%A6%A7%E0%A7%81%E0%A6%B0%E0%A7%80%E0%A6%B8%E0%A6%B9-%E0%A7%A8%E0%A7%AA%E0%A7%AC-%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>শ্বাসনালিতে বেলুন আটকে শিশুর মৃত্যু,পরিবারে শোকের মাতম</title>
      <link>https://www.deshrupantor.com/737131/%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A7%87%E0%A6%B2%E0%A7%81%E0%A6%A8-%E0%A6%86%E0%A6%9F%E0%A6%95%E0%A7%87-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%B6%E0%A7%87%E0%A6%BE%E0%A6%95%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737131/%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A7%87%E0%A6%B2%E0%A7%81%E0%A6%A8-%E0%A6%86%E0%A6%9F%E0%A6%95%E0%A7%87-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%B6%E0%A7%87%E0%A6%BE%E0%A6%95%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Sun, 22 Nov 2026 23:10:37 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/4e726c9af6565581d5bea17fbdd28744-6b032189e8b53.gif?jadewits_media_id=244469" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/4e726c9af6565581d5bea17fbdd28744-6b032189e8b53.gif?jadewits_media_id=244469" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/4e726c9af6565581d5bea17fbdd28744-6b032189e8b53.gif?jadewits_media_id=244469" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শ্বাসনালিতে বেলুন আটকে শিশুর মৃত্যু,পরিবারে শোকের মাতম" /&gt;&lt;/p&gt;&lt;p&gt;কুমিল্লার বরুড়ায় বেলুন নিয়ে খেলতে গিয়ে ফেটে যাওয়া বেলুনের অংশ শ্বাসনালিতে আটকে তাবাসুম আক্তার নামে তিন বছরের এক শিশুর মৃত্যু হয়েছে। রবিবার (২২ নভেম্বর) বিকেলে উপজেলার কশামী গ্রামে এ ঘটনা ঘটে।
এ ঘটনায় পরিবার ও স্বজনদের মধ্যে শোকের ছায়া নেমে এসেছে। শিশু তাবাসুম আক্তার কশামী গ্রামের মহিন উদ্দিনের মেয়ে।&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737131/%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A7%87%E0%A6%B2%E0%A7%81%E0%A6%A8-%E0%A6%86%E0%A6%9F%E0%A6%95%E0%A7%87-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%B6%E0%A7%87%E0%A6%BE%E0%A6%95%E0%A7%87%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>ফটিকছড়িতে ব্যবসায়ীকে গুলি করে পালাল দুর্বৃত্তরা</title>
      <link>https://www.deshrupantor.com/737130/%E0%A6%AB%E0%A6%9F%E0%A6%BF%E0%A6%95%E0%A6%9B%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A6%BE%E0%A7%9F%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%B2-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737130/%E0%A6%AB%E0%A6%9F%E0%A6%BF%E0%A6%95%E0%A6%9B%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A6%BE%E0%A7%9F%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%B2-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE</guid>
      <pubDate>Sun, 22 Nov 2026 23:06:29 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/54c8b0a6145ad3d30eaf501abafd7653-6b032098858de.gif?jadewits_media_id=244468" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/54c8b0a6145ad3d30eaf501abafd7653-6b032098858de.gif?jadewits_media_id=244468" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/54c8b0a6145ad3d30eaf501abafd7653-6b032098858de.gif?jadewits_media_id=244468" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফটিকছড়িতে ব্যবসায়ীকে গুলি করে পালাল দুর্বৃত্তরা" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রামের ফটিকছড়িতে মোহাম্মদ আবছার উদ্দীন চৌধুরী (৩৮) নামে এক ব্যবসায়ীকে গুলি করেছে দুর্বৃত্তরা। রবিবার (২২ নভেম্বর) সন্ধ্যা সাড়ে ৬টার দিকে উপজেলার কাঞ্চননগর ইউনিয়নের ৭ নম্বর ওয়ার্ডের দিঘির পাড়া এলাকায় এ ঘটনা ঘটে। গুলি করার পর দুর্বৃত্তরা দ্রুত ঘটনাস্থল থেকে পালিয়ে যায়।
ঘটনার পর স্থানীয়রা আহত ব্যব&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737130/%E0%A6%AB%E0%A6%9F%E0%A6%BF%E0%A6%95%E0%A6%9B%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A6%BE%E0%A7%9F%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%B2-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>সিংগাইরে ৩৮ কেজি গাঁজাসহ ৪ নারী আটক</title>
      <link>https://www.deshrupantor.com/737129/%E0%A6%B8%E0%A6%BF%E0%A6%82%E0%A6%97%E0%A6%BE%E0%A6%87%E0%A6%B0%E0%A7%87-%E0%A7%A9%E0%A7%AE-%E0%A6%95%E0%A7%87%E0%A6%9C%E0%A6%BF-%E0%A6%97%E0%A6%BE%E0%A6%81%E0%A6%9C%E0%A6%BE%E0%A6%B8%E0%A6%B9-%E0%A7%AA-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%86%E0%A6%9F%E0%A6%95</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737129/%E0%A6%B8%E0%A6%BF%E0%A6%82%E0%A6%97%E0%A6%BE%E0%A6%87%E0%A6%B0%E0%A7%87-%E0%A7%A9%E0%A7%AE-%E0%A6%95%E0%A7%87%E0%A6%9C%E0%A6%BF-%E0%A6%97%E0%A6%BE%E0%A6%81%E0%A6%9C%E0%A6%BE%E0%A6%B8%E0%A6%B9-%E0%A7%AA-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%86%E0%A6%9F%E0%A6%95</guid>
      <pubDate>Sun, 22 Nov 2026 23:02:20 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/0c52cacc93d5725c7ee5bfd9f6cbc156-6b031f4538638.gif?jadewits_media_id=244467" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/0c52cacc93d5725c7ee5bfd9f6cbc156-6b031f4538638.gif?jadewits_media_id=244467" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/0c52cacc93d5725c7ee5bfd9f6cbc156-6b031f4538638.gif?jadewits_media_id=244467" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সিংগাইরে ৩৮ কেজি গাঁজাসহ ৪ নারী আটক" /&gt;&lt;/p&gt;&lt;p&gt;মানিকগঞ্জের সিংগাইরে ৩৮ কেজি গাঁজাসহ চার নারীকে আটক করে পুলিশের কাছে সোপর্দ করেছেন স্থানীয় বাসিন্দারা। রবিবার (২২ নভেম্বর) রাত ৮টার দিকে উপজেলার ধল্লা ইউনিয়নের গাজিন্দা গ্রামে এ ঘটনা ঘটে।
আটক নারীরা হলেন গাজিন্দা গ্রামের রুজিনা বেগম (৩৫), তাসলিমা বেগম (৩২), তানহা (১৯) ও হাজেরা বেগম (৬০)।
স্থানীয় সূত&lt;/p&gt;</description>

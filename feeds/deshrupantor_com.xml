      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/3e03bc252f7d02f3e2c9f6a2badfd173-6af876d751216.jpg?jadewits_media_id=242593" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/3e03bc252f7d02f3e2c9f6a2badfd173-6af876d751216.jpg?jadewits_media_id=242593" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মৃত্যুর কাছে হার মানলেন এসআই ফরিদ, শোকে স্তব্ধ ঈশ্বরগঞ্জ" /&gt;&lt;/p&gt;&lt;p&gt;সড়ক দুর্ঘটনায় গুরুতর আহত হওয়ার পর ১৩ দিন মৃত্যুর সঙ্গে লড়াই করে অবশেষে মারা গেছেন পুলিশের উপপরিদর্শক (এসআই) ফরিদ আহমেদ।&amp;nbsp;
শনিবার (১৪ নভেম্বর) বিকেল ৫টা ১৫ মিনিটে ঢাকার রাজারবাগ কেন্দ্রীয় পুলিশ হাসপাতালের নিবিড় পরিচর্যা কেন্দ্রে (আইসিইউ) চিকিৎসাধীন অবস্থায় তার মৃত্যু হয়।
ফরিদ আহমেদের মৃত্যুতে ময়ম&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735184/%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%9B%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%8F%E0%A6%B8%E0%A6%86%E0%A6%87-%E0%A6%AB%E0%A6%B0%E0%A6%BF%E0%A6%A6-%E0%A6%B6%E0%A7%8B%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%AC%E0%A7%8D%E0%A6%A7">দেশ রূপান্তর</source>

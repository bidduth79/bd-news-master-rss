      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/63f1e25e5632606455f4e086d5ae72ee-6afa5d7cda5df.jpg?jadewits_media_id=242917" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হাছান মাহমুদ-নওফেলসহ ২২ জনের বিচার শুরু" /&gt;&lt;/p&gt;&lt;p&gt;গণঅভ্যুত্থানের সময় চট্টগ্রামে ছাত্রদল নেতা মো. ওয়াসিম আকরামসহ ছয়জনকে হত্যাসহ মানবতাবিরোধী অপরাধের মামলায় আওয়ামী লীগদলীয় (এখন কার্যক্রম নিষিদ্ধ) সাবেক মন্ত্রী হাছান মাহমুদ, মহিবুল হাসান চৌধুরী নওফেলসহ ২২ জনের বিচার শুরু হয়েছে। গতকাল রবিবার বিচারপতি নজরুল ইসলাম চৌধুরীর নেতৃত্বে গঠিত আন্তর্জাতিক অপরাধ &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735520/%E0%A6%B9%E0%A6%BE%E0%A6%9B%E0%A6%BE%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B9%E0%A6%AE%E0%A7%81%E0%A6%A6-%E0%A6%A8%E0%A6%93%E0%A6%AB%E0%A7%87%E0%A6%B2%E0%A6%B8%E0%A6%B9-%E0%A7%A8%E0%A7%A8-%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>যাত্রীর পায়ুপথে মিলল কোটি টাকার স্বর্ণ</title>
      <link>https://www.deshrupantor.com/735519/%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%AA%E0%A6%BE%E0%A7%9F%E0%A7%81%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735519/%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%AA%E0%A6%BE%E0%A7%9F%E0%A7%81%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3</guid>
      <pubDate>Mon, 16 Nov 2026 07:33:33 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/ec0e78d003b3840b70b4ab17a0f2b4b7-6afa5d67dc91b.jpg?jadewits_media_id=242916" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/ec0e78d003b3840b70b4ab17a0f2b4b7-6afa5d67dc91b.jpg?jadewits_media_id=242916" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/ec0e78d003b3840b70b4ab17a0f2b4b7-6afa5d67dc91b.jpg?jadewits_media_id=242916" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যাত্রীর পায়ুপথে মিলল কোটি টাকার স্বর্ণ" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর হযরত শাহজালাল আন্তর্জাতিক বিমানবন্দরে দুবাই থেকে আসা হাসান মিয়া নামে এক যাত্রীর পায়ুপথ ও অন্তর্বাসের ভেতর থেকে ১ কোটি ৮০ লাখ টাকা মূল্যের স্বর্ণের ডিম ও পেস্ট জব্দ করেছে কাস্টমস গোয়েন্দা ও তদন্ত অধিদপ্তরের কর্মকর্তারা।
গতকাল রবিবার ভোরে দুবাই থেকে ইউএস-বাংলা এয়ারলাইনসের বিএস-৩৪২ ফ্লাইটে ঢাক&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735519/%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%AA%E0%A6%BE%E0%A7%9F%E0%A7%81%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>স্বাস্থ্যমন্ত্রীর হার্টে দুটি রিং</title>
      <link>https://www.deshrupantor.com/735518/%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A7%8D%E0%A6%AF%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%9F%E0%A6%BF-%E0%A6%B0%E0%A6%BF%E0%A6%82</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735518/%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A7%8D%E0%A6%AF%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%9F%E0%A6%BF-%E0%A6%B0%E0%A6%BF%E0%A6%82</guid>
      <pubDate>Mon, 16 Nov 2026 07:33:14 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/cbe8652e86bff209ee0685fc2223129f-6afa5d54b75a4.jpg?jadewits_media_id=242915" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/cbe8652e86bff209ee0685fc2223129f-6afa5d54b75a4.jpg?jadewits_media_id=242915" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/cbe8652e86bff209ee0685fc2223129f-6afa5d54b75a4.jpg?jadewits_media_id=242915" style="max-width:100%;height:auto;margin-bottom:10px;" alt="স্বাস্থ্যমন্ত্রীর হার্টে দুটি রিং" /&gt;&lt;/p&gt;&lt;p&gt;অসুস্থ হয়েও বিদেশে চিকিৎসার জন্য গেলেন না স্বাস্থ্যমন্ত্রী সরদার মো. সাখাওয়াত হোসেন। তিনি দেশের একটি বেসকারি হাসপাতালে চিকিৎসা নিচ্ছেন। সেখানে তার হার্টে সফলভাবে দুটি রিং (স্টেন্ট) পরানো হয়েছে। গতকাল রবিবার বিকেল সাড়ে ৪টায় তার হৃদযন্ত্রের ব্লক দূর করতে এ চিকিৎসা কার্যক্রম সম্পন্ন হয়।
স্বাস্থ্য মন্ত্&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735518/%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A7%8D%E0%A6%AF%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%9F%E0%A6%BF-%E0%A6%B0%E0%A6%BF%E0%A6%82">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>বার্ষিক পুরস্কার বিতরণ ও সাংস্কৃতিক অনুষ্ঠান</title>
      <link>https://www.deshrupantor.com/735517/%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%95-%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A6%B0%E0%A6%A3-%E0%A6%93-%E0%A6%B8%E0%A6%BE%E0%A6%82%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%83%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735517/%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%95-%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A6%B0%E0%A6%A3-%E0%A6%93-%E0%A6%B8%E0%A6%BE%E0%A6%82%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%83%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A8</guid>

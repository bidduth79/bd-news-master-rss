      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/684b7a261a4ed9e812aaaa309d11b96a-6b008fd7c4d2b.jpg?jadewits_media_id=244037" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/684b7a261a4ed9e812aaaa309d11b96a-6b008fd7c4d2b.jpg?jadewits_media_id=244037" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/684b7a261a4ed9e812aaaa309d11b96a-6b008fd7c4d2b.jpg?jadewits_media_id=244037" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শান্তিপূর্ণ আলোচনার আহ্বান আইএলওর" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশের তৈরি পোশাক (আরএমজি) খাতে ন্যূনতম মজুরি পর্যালোচনা কেন্দ্র করে চলমান পরিস্থিতি, শ্রম অসন্তোষ এবং এর ফলে শ্রমিকদের জীবন-জীবিকা ও শিল্পপ্রতিষ্ঠানের ওপর প্রভাব নিবিড়ভাবে পর্যবেক্ষণ করছে আন্তর্জাতিক শ্রম সংস্থা (আইএলও)। সংস্থাটি পোশাকশ্রমিকদের মজুরি ইস্যুতে শান্তিপূর্ণ আলোচনার আহ্বান জানিয়েছে।&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736731/%E0%A6%B6%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%AA%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%A3-%E0%A6%86%E0%A6%B2%E0%A7%8B%E0%A6%9A%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%B9%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%A8-%E0%A6%86%E0%A6%87%E0%A6%8F%E0%A6%B2%E0%A6%93%E0%A6%B0">দেশ রূপান্তর</source>

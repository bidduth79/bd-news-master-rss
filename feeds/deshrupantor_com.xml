      <guid isPermaLink="true">https://www.deshrupantor.com/737127/%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%95%E0%A6%A0%E0%A7%8B%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE-%E0%A6%A8%E0%A7%87%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A7%87%E0%A6%B6</guid>
      <pubDate>Sun, 22 Nov 2026 22:52:03 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/4824a47bf3852d999c87b80681231186-6b031bf92f204.gif?jadewits_media_id=244466" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/4824a47bf3852d999c87b80681231186-6b031bf92f204.gif?jadewits_media_id=244466" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/4824a47bf3852d999c87b80681231186-6b031bf92f204.gif?jadewits_media_id=244466" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নাশকতার বিরুদ্ধে কঠোর ব্যবস্থা নেয়ার নির্দেশ" /&gt;&lt;/p&gt;&lt;p&gt;আইনশৃঙ্খলা রক্ষা ও অপরাধ নিয়ন্ত্রণে প্রত্যেক পুলিশ সদস্যকে নিজ নিজ অর্পিত দায়িত্ব যথাযথভাবে পালনের নির্দেশ দিয়েছেন ঢাকা মেট্রোপলিটন পুলিশ (ডিএমপি) কমিশনার মোসলেহ্ উদ্দিন আহমদ, বিপিএম-সেবা। তিনি নাশকতামূলক কর্মকাণ্ড, মাদক, অবৈধ অস্ত্র, ছিনতাই ও চাঁদাবাজির বিরুদ্ধে কঠোর আইনানুগ ব্যবস্থা নেয়ার নির্দেশ &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737127/%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%95%E0%A6%A0%E0%A7%8B%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE-%E0%A6%A8%E0%A7%87%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A7%87%E0%A6%B6">দেশ রূপান্তর</source>

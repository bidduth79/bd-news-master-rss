    <item>
      <title>ট্রাইব্যুনালে হাছান মাহমুদ-নওফেলসহ ২২ জনের বিচার শুরু</title>
      <link>https://www.deshrupantor.com/735443/%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%87%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%9B%E0%A6%BE%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B9%E0%A6%AE%E0%A7%81%E0%A6%A6-%E0%A6%A8%E0%A6%93%E0%A6%AB%E0%A7%87%E0%A6%B2%E0%A6%B8%E0%A6%B9-%E0%A7%A8%E0%A7%A8-%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735443/%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%87%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%9B%E0%A6%BE%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B9%E0%A6%AE%E0%A7%81%E0%A6%A6-%E0%A6%A8%E0%A6%93%E0%A6%AB%E0%A7%87%E0%A6%B2%E0%A6%B8%E0%A6%B9-%E0%A7%A8%E0%A7%A8-%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Sun, 15 Nov 2026 21:51:41 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2025/06/22/ad86a224bd821463ea5ac51dab103766-6857cc919fec0.jpg?jadewits_media_id=118558" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2025/06/22/ad86a224bd821463ea5ac51dab103766-6857cc919fec0.jpg?jadewits_media_id=118558" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2025/06/22/ad86a224bd821463ea5ac51dab103766-6857cc919fec0.jpg?jadewits_media_id=118558" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ট্রাইব্যুনালে হাছান মাহমুদ-নওফেলসহ ২২ জনের বিচার শুরু" /&gt;&lt;/p&gt;&lt;p&gt;গণঅভ্যুত্থানের সময় চট্টগ্রামে ছাত্রদল নেতা মো. ওয়াসিম আকরামসহ ছয়জনকে হত্যাসহ মানবতাবিরোধী অপরাধের মামলায় আওয়ামী লীগদলীয় (এখন কার্যক্রম নিষিদ্ধ) সাবেক মন্ত্রী হাছান মাহমুদ, মহিবুল হাসান চৌধুরী নওফেলসহ ২২ জনের বিচার শুরু হয়েছে।
আজ রোববার (১৫ নভেম্বর) বিচারপতি নজরুল ইসলাম চৌধুরীর নেতৃত্বে গঠিত আন্তর্জা&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735443/%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%87%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%9B%E0%A6%BE%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B9%E0%A6%AE%E0%A7%81%E0%A6%A6-%E0%A6%A8%E0%A6%93%E0%A6%AB%E0%A7%87%E0%A6%B2%E0%A6%B8%E0%A6%B9-%E0%A7%A8%E0%A7%A8-%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>সেই এসপি জাহাঙ্গীর চার দিনের রিমান্ডে</title>
      <link>https://www.deshrupantor.com/735442/%E0%A6%B8%E0%A7%87%E0%A6%87-%E0%A6%8F%E0%A6%B8%E0%A6%AA%E0%A6%BF-%E0%A6%9C%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%80%E0%A6%B0-%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A7%87</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735442/%E0%A6%B8%E0%A7%87%E0%A6%87-%E0%A6%8F%E0%A6%B8%E0%A6%AA%E0%A6%BF-%E0%A6%9C%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%80%E0%A6%B0-%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A7%87</guid>
      <pubDate>Sun, 15 Nov 2026 21:44:38 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/c07f2cad68319378d87eb180e0c8b97c-6af933aab5acc.jpg?jadewits_media_id=242684" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/c07f2cad68319378d87eb180e0c8b97c-6af933aab5acc.jpg?jadewits_media_id=242684" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/c07f2cad68319378d87eb180e0c8b97c-6af933aab5acc.jpg?jadewits_media_id=242684" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সেই এসপি জাহাঙ্গীর চার দিনের রিমান্ডে" /&gt;&lt;/p&gt;&lt;p&gt;গণআন্দোলনে ক্ষমতাচ্যুত প্রধানমন্ত্রী &amp;nbsp;শেখ হাসিনার বাংলাদেশে ফিরে আসাকে কেন্দ্র করে কার্যক্রম নিষিদ্ধ আওয়ামী লীগের সঙ্গে &amp;nbsp;যোগাযোগের অভিযোগে গ্রেপ্তার হওয়া চট্টগ্রাম রেঞ্জ রিজার্ভ &amp;nbsp;ফোর্সের (আরআরএফ) পুলিশ সুপার জাহাঙ্গীর আলমকে রাষ্ট্রদ্রোহ মামলায় জিজ্ঞাসাবাদের জন্য চারদিনের রিমান্ড মঞ্জু&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735442/%E0%A6%B8%E0%A7%87%E0%A6%87-%E0%A6%8F%E0%A6%B8%E0%A6%AA%E0%A6%BF-%E0%A6%9C%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%80%E0%A6%B0-%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A7%87">দেশ রূপান্তর</source>

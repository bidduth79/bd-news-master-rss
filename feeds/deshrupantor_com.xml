      <title>ইজিবাইক চালানো সাবেক ছাত্রদল নেতাকে জেলা পরিষদ প্রশাসকের সহায়তা</title>
      <link>https://www.deshrupantor.com/735599/%E0%A6%87%E0%A6%9C%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%95-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A6%B2-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%B7%E0%A6%A6</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735599/%E0%A6%87%E0%A6%9C%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%95-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A6%B2-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%B7%E0%A6%A6</guid>
      <pubDate>Mon, 16 Nov 2026 14:59:08 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/b315adb31bce2c29c1805da738e579bc-6afac5a41468a.jpg?jadewits_media_id=242987" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/b315adb31bce2c29c1805da738e579bc-6afac5a41468a.jpg?jadewits_media_id=242987" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/b315adb31bce2c29c1805da738e579bc-6afac5a41468a.jpg?jadewits_media_id=242987" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইজিবাইক চালানো সাবেক ছাত্রদল নেতাকে জেলা পরিষদ প্রশাসকের সহায়তা" /&gt;&lt;/p&gt;&lt;p&gt;ঝিনাইদহের কালীগঞ্জ উপজেলা ছাত্রদলের সাবেক সাধারণ সম্পাদক রেজওয়ান ইসলাম মুকুলের পরিবারের সহায়তায় ৩০ হাজার টাকা আর্থিক অনুদান দিয়েছে জেলা পরিষদ। একসময় ছাত্ররাজনীতিতে সক্রিয় থাকলেও বর্তমানে জীবিকার তাগিদে ইজিবাইক চালিয়ে সংসার চালাচ্ছেন তিনি।
সোমবার (১৬ নভেম্বর) সকালে ঝিনাইদহ জেলা পরিষদ প্রশাসকের কার্যা&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735599/%E0%A6%87%E0%A6%9C%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%95-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A6%B2-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%B7%E0%A6%A6">দেশ রূপান্তর</source>

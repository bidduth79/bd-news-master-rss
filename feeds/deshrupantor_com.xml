    <item>
      <title>টাঙ্গাইলে সাড়ে ৭ বস্তা বিদেশি মদসহ আটক ৩</title>
      <link>https://www.deshrupantor.com/738625/%E0%A6%9F%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A7%9C%E0%A7%87-%E0%A7%AD-%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF-%E0%A6%AE%E0%A6%A6-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A7%A9</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/738625/%E0%A6%9F%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A7%9C%E0%A7%87-%E0%A7%AD-%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF-%E0%A6%AE%E0%A6%A6-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A7%A9</guid>
      <pubDate>Sat, 28 Nov 2026 22:32:13 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/30ad173ba00c9b20066317b659c31b5a-6b0b01afb2483.gif?jadewits_media_id=245904" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/30ad173ba00c9b20066317b659c31b5a-6b0b01afb2483.gif?jadewits_media_id=245904" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/30ad173ba00c9b20066317b659c31b5a-6b0b01afb2483.gif?jadewits_media_id=245904" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টাঙ্গাইলে সাড়ে ৭ বস্তা বিদেশি মদসহ আটক ৩" /&gt;&lt;/p&gt;&lt;p&gt;টাঙ্গাইলের ভূঞাপুরে গোবিন্দাসী ইউনিয়ন যুবদল নেতা রাশেদুজ্জামান রঞ্জু মন্ডলের বাড়ির পাশ থেকে সাড়ে ৭ বস্তা বিদেশি মদ উদ্ধার করেছে পুলিশ। এসময় মদ বহনে ব্যবহৃত একটি প্রাইভেটকারসহ তিনজনকে আটক করা হয়েছে।
শনিবার (২৮ নভেম্বর) সন্ধ্যায় গোপন সংবাদের ভিত্তিতে উপজেলার গোবিন্দাসী ইউনিয়নের গোবিন্দাসী গ্রামে অভিযা&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/738625/%E0%A6%9F%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A7%9C%E0%A7%87-%E0%A7%AD-%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF-%E0%A6%AE%E0%A6%A6-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A7%A9">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>মানুষের কল্যাণে জ্ঞান কাজে লাগাতে হবে: ইউজিসি চেয়ারম্যান</title>

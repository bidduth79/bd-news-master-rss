    <item>
      <title>উত্তরে হালকা কুয়াশায় শীতের অনুভব, দক্ষিণে এখনই নয়</title>
      <link>https://www.deshrupantor.com/734509/%E0%A6%89%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%B2%E0%A6%95%E0%A6%BE-%E0%A6%95%E0%A7%81%E0%A7%9F%E0%A6%BE%E0%A6%B6%E0%A6%BE%E0%A7%9F-%E0%A6%B6%E0%A7%80%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AD%E0%A6%AC-%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%A3%E0%A7%87-%E0%A6%8F%E0%A6%96%E0%A6%A8%E0%A6%87-%E0%A6%A8%E0%A7%9F</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734509/%E0%A6%89%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%B2%E0%A6%95%E0%A6%BE-%E0%A6%95%E0%A7%81%E0%A7%9F%E0%A6%BE%E0%A6%B6%E0%A6%BE%E0%A7%9F-%E0%A6%B6%E0%A7%80%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AD%E0%A6%AC-%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%A3%E0%A7%87-%E0%A6%8F%E0%A6%96%E0%A6%A8%E0%A6%87-%E0%A6%A8%E0%A7%9F</guid>
      <pubDate>Thu, 12 Nov 2026 01:41:40 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/de318b868e2349497ed0077f43a834aa-6af4c4cdb28e2.jpg?jadewits_media_id=241926" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/de318b868e2349497ed0077f43a834aa-6af4c4cdb28e2.jpg?jadewits_media_id=241926" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/de318b868e2349497ed0077f43a834aa-6af4c4cdb28e2.jpg?jadewits_media_id=241926" style="max-width:100%;height:auto;margin-bottom:10px;" alt="উত্তরে হালকা কুয়াশায় শীতের অনুভব, দক্ষিণে এখনই নয়" /&gt;&lt;/p&gt;&lt;p&gt;উত্তরাঞ্চলসহ সারা দেশে ধীরলয়ে কমছে তাপমাত্রা। সাধারণত সর্বনিম্ন তাপমাত্রা ২১ ডিগ্রি সেলসিয়াসের নিচে নেমে গেলেই শীতের অনুভব পাওয়া যায়। তবে এখনই এই আবহ তৈরি না হওয়ায় পুরোদমে শীত শুরু হয়নি। দেশের উত্তরাঞ্চলের এলাকাগুলোয় গড় তাপমাত্রা ১৯ ডিগ্রি রেকর্ড হলেও দেশের দক্ষিণ ও মধ্যাঞ্চলের গড় তাপমাত্রা এখনো ২২ &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734509/%E0%A6%89%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%B2%E0%A6%95%E0%A6%BE-%E0%A6%95%E0%A7%81%E0%A7%9F%E0%A6%BE%E0%A6%B6%E0%A6%BE%E0%A7%9F-%E0%A6%B6%E0%A7%80%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AD%E0%A6%AC-%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%A3%E0%A7%87-%E0%A6%8F%E0%A6%96%E0%A6%A8%E0%A6%87-%E0%A6%A8%E0%A7%9F">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>নাশকতা ঠেকাতে ঢাকার মোড়ে মোড়ে পাহারা</title>
      <link>https://www.deshrupantor.com/734508/%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%BE-%E0%A6%A0%E0%A7%87%E0%A6%95%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A7%8B%E0%A7%9C%E0%A7%87-%E0%A6%AE%E0%A7%8B%E0%A7%9C%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734508/%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%BE-%E0%A6%A0%E0%A7%87%E0%A6%95%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A7%8B%E0%A7%9C%E0%A7%87-%E0%A6%AE%E0%A7%8B%E0%A7%9C%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BE</guid>

      <guid isPermaLink="true">https://www.deshrupantor.com/736482/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A6%BE-%E0%A6%AD%E0%A7%81%E0%A6%B2%E0%A7%87-%E0%A6%86%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%A8%E0%A7%80-%E0%A6%AE%E0%A7%8B%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%A1%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%A8%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%BE</guid>
      <pubDate>Fri, 20 Nov 2026 00:30:36 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/d97bae04103d22ee94b2aa1a59ec982b-6aff3d64cd4a5.jpg?jadewits_media_id=243823" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/d97bae04103d22ee94b2aa1a59ec982b-6aff3d64cd4a5.jpg?jadewits_media_id=243823" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/d97bae04103d22ee94b2aa1a59ec982b-6aff3d64cd4a5.jpg?jadewits_media_id=243823" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রতিদ্বন্দ্বিতা ভুলে আবাহনী মোহামেডানের মিলনমেলা" /&gt;&lt;/p&gt;&lt;p&gt;একসময় আবাহনী-মোহামেডান ম্যাচ মানেই ছিল দেশের ফুটবলে অন্যরকম উত্তেজনা। দুই দলের লড়াই ঘিরে স্টেডিয়ামে উপচে পড়ত দর্শক, তৈরি হতো উৎসবের আমেজ। মাঠে প্রতিদ্বন্দ্বিতা থাকলেও মাঠের বাইরে খেলোয়াড়দের মধ্যে ছিল বন্ধুত্ব ও সৌহার্দ্য। সময়ের ব্যবধানে সেই উত্তেজনা অনেকটাই হারিয়ে গেছে। তবে পুরনো স্মৃতি ফিরিয়ে আনতে &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736482/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A6%BE-%E0%A6%AD%E0%A7%81%E0%A6%B2%E0%A7%87-%E0%A6%86%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%A8%E0%A7%80-%E0%A6%AE%E0%A7%8B%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%A1%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%A8%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%BE">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>দ্বিতীয় টেস্টে নেই হাসান</title>
      <link>https://www.deshrupantor.com/736481/%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%9F%E0%A7%87%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%87-%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736481/%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%9F%E0%A7%87%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%87-%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A6%A8</guid>
      <pubDate>Fri, 20 Nov 2026 00:29:56 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/42b1690eb706f0a1a4a4c3b2924f5394-6aff3d67cc6d4.jpg?jadewits_media_id=243832" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/42b1690eb706f0a1a4a4c3b2924f5394-6aff3d67cc6d4.jpg?jadewits_media_id=243832" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/42b1690eb706f0a1a4a4c3b2924f5394-6aff3d67cc6d4.jpg?jadewits_media_id=243832" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দ্বিতীয় টেস্টে নেই হাসান" /&gt;&lt;/p&gt;&lt;p&gt;জোহানেসবার্গ টেস্টে চোট ও শারীরিক ধকলের কারণে সিরিজের দ্বিতীয় ও শেষ ম্যাচে খেলা হচ্ছে না হাসান মাহমুদের। টানা বোলিংয়ের চাপ এবং পুরনো কনুইয়ের চোট বিবেচনায় নিয়ে এই ডানহাতি পেসারকে বিশ্রামে রাখার সিদ্ধান্ত নিয়েছে টিম ম্যানেজমেন্ট। ফলে সেঞ্চুরিয়নে আগামী সোমবার শুরু হতে যাওয়া টেস্টে হাসানকে ছাড়াই মাঠে না&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736481/%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%9F%E0%A7%87%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%87-%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A6%A8">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>বড় জয়ে শুরু সাইফদের</title>
      <link>https://www.deshrupantor.com/736480/%E0%A6%AC%E0%A7%9C-%E0%A6%9C%E0%A7%9F%E0%A7%87-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81-%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%AB%E0%A6%A6%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736480/%E0%A6%AC%E0%A7%9C-%E0%A6%9C%E0%A7%9F%E0%A7%87-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81-%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%AB%E0%A6%A6%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Fri, 20 Nov 2026 00:29:26 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/b1877973e82b337cd92bd3e5d109875a-6aff3d6c0ef89.jpg?jadewits_media_id=243844" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/b1877973e82b337cd92bd3e5d109875a-6aff3d6c0ef89.jpg?jadewits_media_id=243844" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/b1877973e82b337cd92bd3e5d109875a-6aff3d6c0ef89.jpg?jadewits_media_id=243844" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বড় জয়ে শুরু সাইফদের" /&gt;&lt;/p&gt;&lt;p&gt;এশিয়া কাপ রাইজিং স্টার্সে দারুণ সূচনা করেছে বাংলাদেশ &amp;lsquo;এ&amp;rsquo; দল। আজ নিজেদের প্রথম ম্যাচে হংকং-চায়নাকে ৮ উইকেটের বড় ব্যবধানে হারান সাইফ হাসানরা। আগে ব্যাট করে নির্ধারিত ৫০ ওভারে ৮ উইকেট হারিয়ে ২১৯ রান করে হংকং-চায়না। লক্ষ্য তাড়ায় ২ উইকেট হারালেও সাইফ ও ইয়াসির আলীর রাব্বির ফিফটিতে ৫৪ বলে আগেই &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736480/%E0%A6%AC%E0%A7%9C-%E0%A6%9C%E0%A7%9F%E0%A7%87-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81-%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%AB%E0%A6%A6%E0%A7%87%E0%A6%B0">দেশ রূপান্তর</source>
    </item>

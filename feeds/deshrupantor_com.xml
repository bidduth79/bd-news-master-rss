      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/5832d64f0edab01c5ccd7883889f7da8-6b03f901eb73d.jpg?jadewits_media_id=244561" length="0" type="image/jpeg" />

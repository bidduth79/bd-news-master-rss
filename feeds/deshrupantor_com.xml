    <item>
      <title>টেকনাফে রোগ নির্ণয়ে ভয়াবহ প্রতারণা</title>
      <link>https://www.deshrupantor.com/738410/%E0%A6%9F%E0%A7%87%E0%A6%95%E0%A6%A8%E0%A6%BE%E0%A6%AB%E0%A7%87-%E0%A6%B0%E0%A7%8B%E0%A6%97-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A7%9F%E0%A7%87-%E0%A6%AD%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A6%B9-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%A3%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/738410/%E0%A6%9F%E0%A7%87%E0%A6%95%E0%A6%A8%E0%A6%BE%E0%A6%AB%E0%A7%87-%E0%A6%B0%E0%A7%8B%E0%A6%97-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A7%9F%E0%A7%87-%E0%A6%AD%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A6%B9-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%A3%E0%A6%BE</guid>
      <pubDate>Sat, 28 Nov 2026 06:50:51 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/f02c2c0c32eb651231431c618f4823fb-6b0a24305bf8f.jpg?jadewits_media_id=245676" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/f02c2c0c32eb651231431c618f4823fb-6b0a24305bf8f.jpg?jadewits_media_id=245676" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/f02c2c0c32eb651231431c618f4823fb-6b0a24305bf8f.jpg?jadewits_media_id=245676" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টেকনাফে রোগ নির্ণয়ে ভয়াবহ প্রতারণা" /&gt;&lt;/p&gt;&lt;p&gt;কক্সবাজারের টেকনাফ পৌরসভা ও উপজেলায় রোগ নির্ণয়ের নামে চলছে ভয়াবহ প্রতারণা। অনুমোদনহীন ডায়াগনস্টিক সেন্টার ও প্যাথলজি ল্যাবগুলোতে অদক্ষ টেকনিশিয়ানদের দিয়ে পরীক্ষা করিয়ে দেওয়া হচ্ছে মনগড়া রিপোর্ট। এর সবচেয়ে বড় শিকার হচ্ছেন উপজেলার অসহায় ও স্বল্পশিক্ষিত গর্ভবতী নারীরা। ভুল আল্ট্রাসনোগ্রাম, রক্তের গ্রুপ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/738410/%E0%A6%9F%E0%A7%87%E0%A6%95%E0%A6%A8%E0%A6%BE%E0%A6%AB%E0%A7%87-%E0%A6%B0%E0%A7%8B%E0%A6%97-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A7%9F%E0%A7%87-%E0%A6%AD%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A6%B9-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%A3%E0%A6%BE">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>ক্ষতি পোষাতে ছুটির দিনেও কর্মচাঞ্চল্য সাভার-আশুলিয়া</title>
      <link>https://www.deshrupantor.com/738409/%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A4%E0%A6%BF-%E0%A6%AA%E0%A7%8B%E0%A6%B7%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%9B%E0%A7%81%E0%A6%9F%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%93-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%9A%E0%A6%BE%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%B2%E0%A7%8D%E0%A6%AF</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/738409/%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A4%E0%A6%BF-%E0%A6%AA%E0%A7%8B%E0%A6%B7%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%9B%E0%A7%81%E0%A6%9F%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%93-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%9A%E0%A6%BE%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%B2%E0%A7%8D%E0%A6%AF</guid>
      <pubDate>Sat, 28 Nov 2026 06:50:24 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/f02c2c0c32eb651231431c618f4823fb-6b0a24305bf8f.jpg?jadewits_media_id=245676" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/f02c2c0c32eb651231431c618f4823fb-6b0a24305bf8f.jpg?jadewits_media_id=245676" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/f02c2c0c32eb651231431c618f4823fb-6b0a24305bf8f.jpg?jadewits_media_id=245676" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ক্ষতি পোষাতে ছুটির দিনেও কর্মচাঞ্চল্য সাভার-আশুলিয়া" /&gt;&lt;/p&gt;&lt;p&gt;গতকাল শুক্রবার সাপ্তাহিক ছুটির দিনেও সাভার ও আশুলিয়া শিল্পাঞ্চলে ১১৮টি তৈরি পোশাক কারখানা চালু ছিল। এসব কারখানায় শান্তিপূর্ণভাবে কাজে যোগ দিয়েছেন শ্রমিকরা। পুরো শিল্পাঞ্চলের পরিস্থিতিও স্বাভাবিক রয়েছে।
শ্রমিক অসন্তোষের কারণে উৎপাদন ব্যাহত হওয়ায় সে ঘাটতি পুষিয়ে নিতে গতকালও কারখানাগুলো খোলা রাখা হয় বল&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/738409/%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A4%E0%A6%BF-%E0%A6%AA%E0%A7%8B%E0%A6%B7%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%9B%E0%A7%81%E0%A6%9F%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%93-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%9A%E0%A6%BE%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%B2%E0%A7%8D%E0%A6%AF">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>শিল্পী হওয়া বড় ব্যাপার</title>
      <link>https://www.deshrupantor.com/738408/%E0%A6%B6%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A7%80-%E0%A6%B9%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%AC%E0%A7%9C-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AA%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/738408/%E0%A6%B6%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A7%80-%E0%A6%B9%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%AC%E0%A7%9C-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AA%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Sat, 28 Nov 2026 06:49:57 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/c291ee5da9ea6fe8cadbe4886af24c28-6b0a252f6eca8.jpg?jadewits_media_id=245681" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/c291ee5da9ea6fe8cadbe4886af24c28-6b0a252f6eca8.jpg?jadewits_media_id=245681" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/c291ee5da9ea6fe8cadbe4886af24c28-6b0a252f6eca8.jpg?jadewits_media_id=245681" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শিল্পী হওয়া বড় ব্যাপার" /&gt;&lt;/p&gt;&lt;p&gt;রফিকুন নবী আমাদের শিল্পগুরুদের একজন। ১৯৪৩ সালের ২৮ নভেম্বর চাঁপাইনবাবগঞ্জে তার জন্ম। ৮৪তম জন্মদিন উপলক্ষে দুই দিন আগে অগ্রহায়ণের সন্ধ্যায় তার শেওড়াপাড়ার বাড়ির গেটে গিয়ে হাজির হই। রফিকুন নবী নিজেই গেট খুলে দিলেন। বললাম &amp;lsquo;আগাম শুভ জন্মদিন স্যার।&amp;rsquo; রফিকুন নবী বললেন, বয়সটা গুনি না আর। এটা গুনত&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/738408/%E0%A6%B6%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A7%80-%E0%A6%B9%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%AC%E0%A7%9C-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AA%E0%A6%BE%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>রাজধানীতে হোটেলে ঢুকে ম্যানেজারকে কুপিয়ে হত্যা</title>
      <link>https://www.deshrupantor.com/738407/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A7%8B%E0%A6%9F%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%A2%E0%A7%81%E0%A6%95%E0%A7%87-%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A7%81%E0%A6%AA%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/738407/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A7%8B%E0%A6%9F%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%A2%E0%A7%81%E0%A6%95%E0%A7%87-%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A7%81%E0%A6%AA%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE</guid>
      <pubDate>Sat, 28 Nov 2026 06:49:27 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/51bf182956344ecd3803a862795718a4-6b0a250ee6c9a.jpg?jadewits_media_id=245680" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/51bf182956344ecd3803a862795718a4-6b0a250ee6c9a.jpg?jadewits_media_id=245680" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/51bf182956344ecd3803a862795718a4-6b0a250ee6c9a.jpg?jadewits_media_id=245680" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজধানীতে হোটেলে ঢুকে ম্যানেজারকে কুপিয়ে হত্যা" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর ওয়ারীর ওসমানী ইন্টারন্যাশনাল আবাসিক হোটেলে ঢুকে ম্যানেজার নাঈমুর রহমানকে (২৬) কুপিয়ে হত্যা করেছে বাবা-ছেলে। এ ঘটনায় গুরুতর আহত হয়েছেন হোটেলের জেনারেল ম্যানেজার আব্দুর রাজ্জাক (৫০) ও স্টাফ মো. হাসান (২৬)। গত বৃহস্পতিবার দিবাগত রাত ২টার দিকে জয়কালী মন্দিরের পাশের হোটেলে এ ঘটনা ঘটে।
পুলিশ ও নি&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/738407/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A7%8B%E0%A6%9F%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%A2%E0%A7%81%E0%A6%95%E0%A7%87-%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A7%81%E0%A6%AA%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE">দেশ রূপান্তর</source>

    <item>
      <title>মাসয়ালা</title>
      <link>https://www.deshrupantor.com/736485/%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%9F%E0%A6%BE%E0%A6%B2%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736485/%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%9F%E0%A6%BE%E0%A6%B2%E0%A6%BE</guid>
      <pubDate>Fri, 20 Nov 2026 00:32:58 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/5533512fe28a570779976cb0caa8486c-6aff3d696d155.jpg?jadewits_media_id=243836" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/5533512fe28a570779976cb0caa8486c-6aff3d696d155.jpg?jadewits_media_id=243836" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/5533512fe28a570779976cb0caa8486c-6aff3d696d155.jpg?jadewits_media_id=243836" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মাসয়ালা" /&gt;&lt;/p&gt;&lt;p&gt;নামাজের সময় নারীর চুল বেরিয়ে থাকা
অনেককে বলেতে শোনা যায়, নামাজ অবস্থায় যদি কোনো নারীর একটি চুলও বের হয়ে থাকে তাহলে নামাজ হবে না। এই কথা সঠিক নয়।
নামাজে এক দুটি চুল বের হয়ে গেলে নামাজের কোনো ক্ষতি হবে না। কেননা সতরের ক্ষেত্রে নারীদের মাথার সব চুল এক অঙ্গ হিসেবে গণ্য। সুতরাং মাথার সব চুলের এক-চতুর্থাং&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736485/%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%9F%E0%A6%BE%E0%A6%B2%E0%A6%BE">দেশ রূপান্তর</source>
    </item>

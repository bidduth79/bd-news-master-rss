      <guid isPermaLink="true">https://www.deshrupantor.com/735989/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87%E0%A6%93-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%B8%E0%A6%A4%E0%A7%80%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%8F%E0%A6%95-%E0%A6%B8%E0%A7%81%E0%A6%A4%E0%A7%8B%E0%A6%AF%E0%A6%BC-%E0%A6%AC%E0%A6%BE%E0%A6%81%E0%A6%A7%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%97%E0%A6%BE%E0%A6%AB%E0%A6%AB%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Wed, 18 Nov 2026 01:43:50 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/641090d64415f7ee21ef2ddfc634878e-6afc9b95f0aab.jpg?jadewits_media_id=243387" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/641090d64415f7ee21ef2ddfc634878e-6afc9b95f0aab.jpg?jadewits_media_id=243387" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/641090d64415f7ee21ef2ddfc634878e-6afc9b95f0aab.jpg?jadewits_media_id=243387" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রবাসেও সাবেক সতীর্থদের এক সুতোয় বাঁধছেন গাফফার" /&gt;&lt;/p&gt;&lt;p&gt;দেশের ফুটবল মাঠে একসময় তাঁরা ছিলেন প্রতিপক্ষ, আবার কখনো একই দলের সতীর্থ। আবাহনী, মোহামেডান, মুক্তিযোদ্ধা কিংবা জাতীয় দলের জার্সিতে তাঁদের অনেকেরই কেটেছে সোনালি সময়। সময়ের ব্যবধানে কেউ পাড়ি জমিয়েছেন কানাডায়, কেউ যুক্তরাষ্ট্রে, আবার কেউ অন্য দেশে। কিন্তু দেশ ছেড়ে গেলেও ফুটবলের টান আর পুরোনো সত&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735989/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87%E0%A6%93-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%B8%E0%A6%A4%E0%A7%80%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%8F%E0%A6%95-%E0%A6%B8%E0%A7%81%E0%A6%A4%E0%A7%8B%E0%A6%AF%E0%A6%BC-%E0%A6%AC%E0%A6%BE%E0%A6%81%E0%A6%A7%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%97%E0%A6%BE%E0%A6%AB%E0%A6%AB%E0%A6%BE%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>খুলনায় যৌথবাহিনীর অভিযানের মধ্যেই গুলিবিদ্ধ ২</title>
      <link>https://www.deshrupantor.com/736027/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%AF%E0%A7%8C%E0%A6%A5%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%87-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A7%A8</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736027/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%AF%E0%A7%8C%E0%A6%A5%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%87-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A7%A8</guid>
      <pubDate>Wed, 18 Nov 2026 01:44:09 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/2058c0bd704fd2c8e8362b879eab2dc4-6afca96bc77a3.jpg?jadewits_media_id=243420" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/2058c0bd704fd2c8e8362b879eab2dc4-6afca96bc77a3.jpg?jadewits_media_id=243420" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/2058c0bd704fd2c8e8362b879eab2dc4-6afca96bc77a3.jpg?jadewits_media_id=243420" style="max-width:100%;height:auto;margin-bottom:10px;" alt="খুলনায় যৌথবাহিনীর অভিযানের মধ্যেই গুলিবিদ্ধ ২" /&gt;&lt;/p&gt;&lt;p&gt;খুলনায় যৌথবাহিনীর অভিযানের মধ্যেই আড়ংঘাটায় দুর্বৃত্তদের গুলিতে দুইজন আহত হয়েছেন। আহতরা হলেন- সোলায়মান শেখ (৫৫) ও মো. খালেক (৬৫)। তাদের শরীরে গুলির পাশাপাশি একাধিক আঘাতের চিহ্ন রয়েছে।
মঙ্গলবার (১৭ নভেম্বর) রাত সাড়ে ৯টার দিকে আড়ংঘাটা বাজারসংলগ্ন বুড়ির বাড়ি এলাকার পশ্চিমপাড়া কেন্দ্রীয় মসজিদের পাশে এ &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736027/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%AF%E0%A7%8C%E0%A6%A5%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%87-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A7%A8">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>রেকর্ড ৮ শিরোপা খুলনার</title>
      <link>https://www.deshrupantor.com/736026/%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A1-%E0%A7%AE-%E0%A6%B6%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%AA%E0%A6%BE-%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736026/%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A1-%E0%A7%AE-%E0%A6%B6%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%AA%E0%A6%BE-%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Wed, 18 Nov 2026 01:15:49 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/b852b6a19b8f81eb0f4d7f09b90e886c-6afc9fbe6981b.jpg?jadewits_media_id=243398" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/b852b6a19b8f81eb0f4d7f09b90e886c-6afc9fbe6981b.jpg?jadewits_media_id=243398" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/b852b6a19b8f81eb0f4d7f09b90e886c-6afc9fbe6981b.jpg?jadewits_media_id=243398" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রেকর্ড ৮ শিরোপা খুলনার" /&gt;&lt;/p&gt;&lt;p&gt;শিরোপা জিততে শুধুমাত্র হার এড়ালেই চলত। কিন্তু সমীকরণের নিরাপদ পথে হাঁটেনি খুলনা বিভাগ। গতকাল জয়ের দাপটেই নিজেদের শ্রেষ্ঠত্বের প্রমাণ দিয়েছে মোহাম্মদ মিঠুনের দল। রংপুর বিভাগকে ৯ উইকেটে হারিয়ে ২৮তম জাতীয় ক্রিকেট লিগের (এনসিএল) শিরোপা জিতেছে খুলনা। এই জয়ে দীর্ঘ সাত মৌসুমের অপেক্ষার অবসান ঘটানোর পাশাপাশ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736026/%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A1-%E0%A7%AE-%E0%A6%B6%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%AA%E0%A6%BE-%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>লিটনের কীর্তির দিনে বৃষ্টির দাপট</title>
      <link>https://www.deshrupantor.com/736025/%E0%A6%B2%E0%A6%BF%E0%A6%9F%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A7%80%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AA%E0%A6%9F</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736025/%E0%A6%B2%E0%A6%BF%E0%A6%9F%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A7%80%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AA%E0%A6%9F</guid>
      <pubDate>Wed, 18 Nov 2026 01:15:23 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/c020b815250588ca76897a98a6d9aab0-6afc9fbf07ef8.jpg?jadewits_media_id=243399" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/c020b815250588ca76897a98a6d9aab0-6afc9fbf07ef8.jpg?jadewits_media_id=243399" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/c020b815250588ca76897a98a6d9aab0-6afc9fbf07ef8.jpg?jadewits_media_id=243399" style="max-width:100%;height:auto;margin-bottom:10px;" alt="লিটনের কীর্তির দিনে বৃষ্টির দাপট" /&gt;&lt;/p&gt;&lt;p&gt;জোহানেসবার্গ টেস্টের তৃতীয় দিনের খেলা বিঘি&amp;oelig;ত হয়েছে। দিনের প্রথম সেশনে খেলা হলেও পরে টানা বৃষ্টি ও বজ্রপাতের কারণে মধ্যাহ্নবিরতির পর একটি বলও আর মাঠে গড়ায়নি। আবহাওয়া খেলার উপযোগী না থাকায় নির্ধারিত সময়ের বেশ আগেই দিনের খেলা শেষ করার সিদ্ধান্ত নেন ম্যাচ অফিশিয়ালরা। সব মিলিয়ে খেলা হয় ২৮ ওভার।
গতক&lt;/p&gt;</description>

      <title>চিকিৎসার পর ফের কারাগারে ইমরান খান</title>
      <link>https://www.deshrupantor.com/734479/%E0%A6%9A%E0%A6%BF%E0%A6%95%E0%A6%BF%E0%A7%8E%E0%A6%B8%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AB%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%97%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%87%E0%A6%AE%E0%A6%B0%E0%A6%BE%E0%A6%A8-%E0%A6%96%E0%A6%BE%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734479/%E0%A6%9A%E0%A6%BF%E0%A6%95%E0%A6%BF%E0%A7%8E%E0%A6%B8%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AB%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%97%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%87%E0%A6%AE%E0%A6%B0%E0%A6%BE%E0%A6%A8-%E0%A6%96%E0%A6%BE%E0%A6%A8</guid>
      <pubDate>Thu, 12 Nov 2026 00:26:07 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/3bbc0f822a6ebd3d34e056bafdb2ce7b-6af4b33876c7b.jpg?jadewits_media_id=241901" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/3bbc0f822a6ebd3d34e056bafdb2ce7b-6af4b33876c7b.jpg?jadewits_media_id=241901" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/3bbc0f822a6ebd3d34e056bafdb2ce7b-6af4b33876c7b.jpg?jadewits_media_id=241901" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চিকিৎসার পর ফের কারাগারে ইমরান খান" /&gt;&lt;/p&gt;&lt;p&gt;পাকিস্তানের সাবেক প্রধানমন্ত্রী ইমরান খানকে ইসলামাবাদের একটি হাসপাতালে চিকিৎসা দেওয়ার পর ফের কারাগারে নিয়ে যাওয়া হয়েছে। এক কর্মকর্তার বরাত দিয়ে গতকাল বুধবার রয়টার্স জানিয়েছে, রাওয়ালপিন্ডির আদিয়ালা কারাগারে বন্দি ইমরানের চোখ পরীক্ষার জন্য তাকে মঙ্গলবার রাতে পাকিস্তান ইনস্টিটিউট অব মেডিকেল সায়েন্সেসে &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734479/%E0%A6%9A%E0%A6%BF%E0%A6%95%E0%A6%BF%E0%A7%8E%E0%A6%B8%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AB%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%97%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%87%E0%A6%AE%E0%A6%B0%E0%A6%BE%E0%A6%A8-%E0%A6%96%E0%A6%BE%E0%A6%A8">দেশ রূপান্তর</source>
    </item>

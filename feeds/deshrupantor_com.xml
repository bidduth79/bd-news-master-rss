    <item>
      <title>যৌথ নদী কমিশনের কারিগরী বৈঠক শুরু কাল</title>
      <link>https://www.deshrupantor.com/736891/%E0%A6%AF%E0%A7%8C%E0%A6%A5-%E0%A6%A8%E0%A6%A6%E0%A7%80-%E0%A6%95%E0%A6%AE%E0%A6%BF%E0%A6%B6%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%97%E0%A6%B0%E0%A7%80-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81-%E0%A6%95%E0%A6%BE%E0%A6%B2</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736891/%E0%A6%AF%E0%A7%8C%E0%A6%A5-%E0%A6%A8%E0%A6%A6%E0%A7%80-%E0%A6%95%E0%A6%AE%E0%A6%BF%E0%A6%B6%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%97%E0%A6%B0%E0%A7%80-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81-%E0%A6%95%E0%A6%BE%E0%A6%B2</guid>
      <pubDate>Sat, 21 Nov 2026 22:01:16 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/23ed8f46c59a46ab322aa52a97b18252-6b01c02f38857.gif?jadewits_media_id=244230" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/23ed8f46c59a46ab322aa52a97b18252-6b01c02f38857.gif?jadewits_media_id=244230" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/23ed8f46c59a46ab322aa52a97b18252-6b01c02f38857.gif?jadewits_media_id=244230" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যৌথ নদী কমিশনের কারিগরী বৈঠক শুরু কাল" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ ও ভারতের যৌথ নদী কমিশনের কারিগরী পর্যায়ের বৈঠক আগামীকাল রবিবার (২২ নভেম্বর) শুরু হচ্ছে। এ বৈঠকে যোগ দিতে ভারতীয় প্রতিনিধি দল গতকাল শুক্রবার ঢাকা পৌঁছেছে। যৌথ নদী কমিশন, বাংলাদেশ-এর সদস্য মো. আনোয়ার কাদির এবং ভারতের পানিসম্পদ বিভাগের কমিশনার শরদ চন্দ্র এ বৈঠকে নিজ নিজ দেশের প্রতিনিধিদলের নেত&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736891/%E0%A6%AF%E0%A7%8C%E0%A6%A5-%E0%A6%A8%E0%A6%A6%E0%A7%80-%E0%A6%95%E0%A6%AE%E0%A6%BF%E0%A6%B6%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%97%E0%A6%B0%E0%A7%80-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81-%E0%A6%95%E0%A6%BE%E0%A6%B2">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>আ. লীগকে নিষিদ্ধ করা হবে কি না, তা আইনি প্রক্রিয়ায় বিবেচনাধীন: আইনমন্ত্রী</title>

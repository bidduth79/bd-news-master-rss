      <title>১ ডিসেম্বর ভিকারুননিসায় প্রথম শ্রেণিতে ভর্তি শুরু, আবেদন চলবে ১০দিন</title>
      <link>https://www.deshrupantor.com/738629/%E0%A7%A7-%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%AD%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%81%E0%A6%A8%E0%A6%A8%E0%A6%BF%E0%A6%B8%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A3%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AD%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/738629/%E0%A7%A7-%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%AD%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%81%E0%A6%A8%E0%A6%A8%E0%A6%BF%E0%A6%B8%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A3%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AD%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81</guid>
      <pubDate>Sat, 28 Nov 2026 23:08:28 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/9677c43c2692dba7c79bd6d7c1b240cb-6b0b09efb76d2.gif?jadewits_media_id=245909" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/9677c43c2692dba7c79bd6d7c1b240cb-6b0b09efb76d2.gif?jadewits_media_id=245909" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/9677c43c2692dba7c79bd6d7c1b240cb-6b0b09efb76d2.gif?jadewits_media_id=245909" style="max-width:100%;height:auto;margin-bottom:10px;" alt="১ ডিসেম্বর ভিকারুননিসায় প্রথম শ্রেণিতে ভর্তি শুরু, আবেদন চলবে ১০দিন" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর ভিকারুননিসা নূন স্কুল অ্যান্ড কলেজে ২০২৭ শিক্ষাবর্ষে প্রথম শ্রেণিতে ভর্তির জন্য আবেদন নেওয়া শুরু হবে আগামী ১ ডিসেম্বর। বাংলা ও ইংরেজি ভার্সনে মোট ১ হাজার ৫৪৫টি আসনে শিক্ষার্থী ভর্তি করা হবে।
আবেদন গ্রহণ চলবে ১০ ডিসেম্বর পর্যন্ত। পরে ১৫ ডিসেম্বর ডিজিটাল লটারির মাধ্যমে ভর্তির জন্য শিক্ষার্থী &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/738629/%E0%A7%A7-%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%AD%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%81%E0%A6%A8%E0%A6%A8%E0%A6%BF%E0%A6%B8%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A3%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AD%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81">দেশ রূপান্তর</source>

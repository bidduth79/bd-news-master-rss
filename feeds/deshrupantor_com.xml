      <guid isPermaLink="true">https://www.deshrupantor.com/737128/%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A6%97%E0%A6%A6-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%95%E0%A6%AE%E0%A6%9B%E0%A7%87%C2%A0</guid>
      <pubDate>Sun, 22 Nov 2026 22:55:37 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/09/29/ebd62c33dd922d58e3bcd9686723b1ca-6abbb8aa71562.gif?jadewits_media_id=231617" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/09/29/ebd62c33dd922d58e3bcd9686723b1ca-6abbb8aa71562.gif?jadewits_media_id=231617" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/09/29/ebd62c33dd922d58e3bcd9686723b1ca-6abbb8aa71562.gif?jadewits_media_id=231617" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ব্যাংকের বাইরে মানুষের হাতে নগদ টাকা কমছে" /&gt;&lt;/p&gt;&lt;p&gt;ব্যাংকিং ব্যবস্থার বাইরে মানুষের হাতে থাকা নগদ টাকার পরিমাণ টানা তিন মাস ধরে কমছে। গত মে মাসে ব্যাংকের বাইরে নগদ অর্থের পরিমাণ ৩ লাখ ৪৯ হাজার ৩৭৪ কোটি টাকায় উঠলেও জুন থেকে তা ধারাবাহিকভাবে কমতে শুরু করে।
সর্বশেষ গত সেপ্টেম্বর শেষে মানুষের হাতে থাকা নগদ টাকার পরিমাণ নেমে এসেছে ৩ লাখ ১১ হাজার ৬৬ কোটি &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737128/%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A6%97%E0%A6%A6-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%95%E0%A6%AE%E0%A6%9B%E0%A7%87%C2%A0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>নাশকতার বিরুদ্ধে কঠোর ব্যবস্থা নেয়ার নির্দেশ</title>

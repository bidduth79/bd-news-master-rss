    <item>
      <title>লালবাগে যুবলীগের দুই সদস্য গ্রেপ্তার</title>
      <link>https://www.deshrupantor.com/735335/%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A6%97%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735335/%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A6%97%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Sun, 15 Nov 2026 14:54:48 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/5ef05adcffa0f0f568aa734c919dee58-6af9732ec0010.jpg?jadewits_media_id=242739" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/5ef05adcffa0f0f568aa734c919dee58-6af9732ec0010.jpg?jadewits_media_id=242739" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/5ef05adcffa0f0f568aa734c919dee58-6af9732ec0010.jpg?jadewits_media_id=242739" style="max-width:100%;height:auto;margin-bottom:10px;" alt="লালবাগে যুবলীগের দুই সদস্য গ্রেপ্তার" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর লালবাগ ও কামরাঙ্গীরচর থানাধীন এলাকা থেকে কার্যক্রম নিষিদ্ধ আওয়ামী লীগের সহযোগী সংগঠন যুবলীগের দুই সদস্যকে গ্রেপ্তার করেছে লালবাগ থানা পুলিশ।
রবিবার (১৫ নভেম্বর) দুপুরে লালবাগ থানার ভারপ্রাপ্ত কর্মকর্তা (ওসি) মোহাম্মদ জামিল হোসাইন এ তথ্য জানিয়েছেন।গ্রেপ্তারকৃতরা হলো- মো. মাসুম (৪৪) ও হৃদয় হ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735335/%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A6%97%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>মেয়র প্রার্থীর বিরুদ্ধে হোটেল কর্মচারীকে মারধরের অভিযোগ, যা জানা গেল</title>
      <link>https://www.deshrupantor.com/735334/%E0%A6%AE%E0%A7%87%E0%A7%9F%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%B9%E0%A7%8B%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%A7%E0%A6%B0%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735334/%E0%A6%AE%E0%A7%87%E0%A7%9F%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%B9%E0%A7%8B%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%A7%E0%A6%B0%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Sun, 15 Nov 2026 14:50:00 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/bde7577499694b17e899f0eb22de2c6a-6af971bc54ce6.gif?jadewits_media_id=242736" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/bde7577499694b17e899f0eb22de2c6a-6af971bc54ce6.gif?jadewits_media_id=242736" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/bde7577499694b17e899f0eb22de2c6a-6af971bc54ce6.gif?jadewits_media_id=242736" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মেয়র প্রার্থীর বিরুদ্ধে হোটেল কর্মচারীকে মারধরের অভিযোগ, যা জানা গেল" /&gt;&lt;/p&gt;&lt;p&gt;পটুয়াখালীর কুয়াকাটায় পাওনা টাকা নিয়ে বিরোধের জেরে আবাসিক হোটেলের এক কর্মচারীকে মারধর ও ২০ হাজার টাকা ছিনিয়ে নেওয়ার অভিযোগ উঠেছে ইসলামী আন্দোলন বাংলাদেশের এক নেতার বিরুদ্ধে। অভিযুক্ত ওই নেতার নাম শাহ আলম হাওলাদার। তিনি ইসলামী আন্দোলন বাংলাদেশের কুয়াকাটা পৌর শাখার সহসভাপতি ও হাতপাখার মেয়র প্রার্থী।
এ &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735334/%E0%A6%AE%E0%A7%87%E0%A7%9F%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%B9%E0%A7%8B%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%A7%E0%A6%B0%E0%A7%87%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>ফ্রান্সে আবারও রাজপথে লাখো মানুষ</title>
      <link>https://www.deshrupantor.com/735333/%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A6%93-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%B2%E0%A6%BE%E0%A6%96%E0%A7%8B-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B7</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735333/%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A6%93-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%B2%E0%A6%BE%E0%A6%96%E0%A7%8B-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B7</guid>
      <pubDate>Sun, 15 Nov 2026 14:49:22 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/35fdaa0a86c1ea4264c6a48d1c8510cc-6af97183ddda2.jpg?jadewits_media_id=242735" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/35fdaa0a86c1ea4264c6a48d1c8510cc-6af97183ddda2.jpg?jadewits_media_id=242735" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/35fdaa0a86c1ea4264c6a48d1c8510cc-6af97183ddda2.jpg?jadewits_media_id=242735" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফ্রান্সে আবারও রাজপথে লাখো মানুষ" /&gt;&lt;/p&gt;&lt;p&gt;জীবনযাত্রার ক্রমবর্ধমান ব্যয় এবং জনসেবামূলক খাতের সংকটের প্রতিবাদে শনিবারও (১৪ নভেম্বর) ফ্রান্সের বিভিন্ন শহরে রাজপথে নেমেছেন হাজারো মানুষ। দেশটির স্বরাষ্ট্র মন্ত্রণালয় জানিয়েছে, সাম্প্রতিক সপ্তাহগুলোর মধ্যে শনিবারের বিক্ষোভে অংশগ্রহণকারীর সংখ্যা ছিল সবচেয়ে কম। খবর ডয়চে ভেলে।&amp;nbsp;&amp;nbsp;
স্বরাষ্ট্র &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735333/%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A6%93-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%B2%E0%A6%BE%E0%A6%96%E0%A7%8B-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B7">দেশ রূপান্তর</source>
    </item>

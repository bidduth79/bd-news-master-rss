      <guid isPermaLink="true">https://www.deshrupantor.com/735594/%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%A3-%E0%A6%86%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A7%83%E0%A6%A5%E0%A6%95-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%81%E0%A6%95-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A7%A7%E0%A7%AD</guid>
      <pubDate>Mon, 16 Nov 2026 14:31:15 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/38502af84ff26560332eb6c4df6b9b4e-6afabf1b02b28.jpg?jadewits_media_id=242983" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/38502af84ff26560332eb6c4df6b9b4e-6afabf1b02b28.jpg?jadewits_media_id=242983" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/38502af84ff26560332eb6c4df6b9b4e-6afabf1b02b28.jpg?jadewits_media_id=242983" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দক্ষিণ আফ্রিকায় পৃথক দুই বন্দুক হামলায় নিহত ১৭" /&gt;&lt;/p&gt;&lt;p&gt;দক্ষিণ আফ্রিকায় পৃথক দুটি বন্দুক হামলায় অন্তত ১৭ জন নিহত হয়েছেন। এর মধ্যে দেশটির প্রশাসনিক রাজধানী প্রিটোরিয়ার পশ্চিমাঞ্চলের একটি জনবসতিতে গুলিবিদ্ধ হয়ে প্রাণ হারিয়েছেন ৯ জন। সোমবার (১৬ নভেম্বর)&amp;nbsp;এ তথ্য জানিয়েছে দেশটির পুলিশ।
পুলিশ জানায়, রোববার গভীর রাতে প্রিটোরিয়ার আতেরিজভিল এলাকার জেফসভিল নাম&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735594/%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%A3-%E0%A6%86%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A7%83%E0%A6%A5%E0%A6%95-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%81%E0%A6%95-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A7%A7%E0%A7%AD">দেশ রূপান্তর</source>

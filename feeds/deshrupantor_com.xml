    <item>
      <title>বাঁচানো গেল না ছোট বক্করকেও</title>
      <link>https://www.deshrupantor.com/733982/%E0%A6%AC%E0%A6%BE%E0%A6%81%E0%A6%9A%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%97%E0%A7%87%E0%A6%B2-%E0%A6%A8%E0%A6%BE-%E0%A6%9B%E0%A7%8B%E0%A6%9F-%E0%A6%AC%E0%A6%95%E0%A7%8D%E0%A6%95%E0%A6%B0%E0%A6%95%E0%A7%87%E0%A6%93</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/733982/%E0%A6%AC%E0%A6%BE%E0%A6%81%E0%A6%9A%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%97%E0%A7%87%E0%A6%B2-%E0%A6%A8%E0%A6%BE-%E0%A6%9B%E0%A7%8B%E0%A6%9F-%E0%A6%AC%E0%A6%95%E0%A7%8D%E0%A6%95%E0%A6%B0%E0%A6%95%E0%A7%87%E0%A6%93</guid>
      <pubDate>Tue, 10 Nov 2026 01:58:50 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/65b9504fc628fec29370c3b8c7c99a60-6af225dd858ee.jpg?jadewits_media_id=241429" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/65b9504fc628fec29370c3b8c7c99a60-6af225dd858ee.jpg?jadewits_media_id=241429" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/65b9504fc628fec29370c3b8c7c99a60-6af225dd858ee.jpg?jadewits_media_id=241429" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাঁচানো গেল না ছোট বক্করকেও" /&gt;&lt;/p&gt;&lt;p&gt;আমার দুইটা ছেলে। ১০ বছর বয়সী বড় ছেলেটা পড়াশোনায় ভালো ছিল। স্বপ্ন ছিল হাফেজ বানাব। আগামী রমজানে মাদ্রাসায় ভর্তি করানোরও পরিকল্পনা ছিল। আর ১০ মাস বয়সী ছেলেটা সুস্থ সবলই ছিল। ডেঙ্গু, হাম আর নিউমোনিয়ায় দুই দিনের ব্যবধানে আমার দুইটা ছেলেই মারা গেল। ভাই, আমাদের তো সব শেষ। আমরা এখন কী নিয়ে বাঁচব? গতকাল সোম&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/733982/%E0%A6%AC%E0%A6%BE%E0%A6%81%E0%A6%9A%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%97%E0%A7%87%E0%A6%B2-%E0%A6%A8%E0%A6%BE-%E0%A6%9B%E0%A7%8B%E0%A6%9F-%E0%A6%AC%E0%A6%95%E0%A7%8D%E0%A6%95%E0%A6%B0%E0%A6%95%E0%A7%87%E0%A6%93">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>টেকনাফে সেনাসদস্য হত্যায় তিন মামলা, আসামি ৯৫</title>
      <link>https://www.deshrupantor.com/733981/%E0%A6%9F%E0%A7%87%E0%A6%95%E0%A6%A8%E0%A6%BE%E0%A6%AB%E0%A7%87-%E0%A6%B8%E0%A7%87%E0%A6%A8%E0%A6%BE%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A7%9F-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%86%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%BF-%E0%A7%AF%E0%A7%AB</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/733981/%E0%A6%9F%E0%A7%87%E0%A6%95%E0%A6%A8%E0%A6%BE%E0%A6%AB%E0%A7%87-%E0%A6%B8%E0%A7%87%E0%A6%A8%E0%A6%BE%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A7%9F-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%86%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%BF-%E0%A7%AF%E0%A7%AB</guid>
      <pubDate>Tue, 10 Nov 2026 01:57:45 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/15bc03a9761bbeaab7782ac776c44bba-6af225b261167.jpg?jadewits_media_id=241428" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/15bc03a9761bbeaab7782ac776c44bba-6af225b261167.jpg?jadewits_media_id=241428" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/15bc03a9761bbeaab7782ac776c44bba-6af225b261167.jpg?jadewits_media_id=241428" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টেকনাফে সেনাসদস্য হত্যায় তিন মামলা, আসামি ৯৫" /&gt;&lt;/p&gt;&lt;p&gt;কক্সবাজারের টেকনাফের লেদা ও রঙ্গিখালী এলাকার গহিন পাহাড়ে মানব পাচার ও অপহরণ চক্রের আস্তানায় যৌথ বাহিনীর অভিযানকালে সন্ত্রাসীদের গুলিতে সেনাসদস্য মো. তিতাস শেখ নিহত হওয়ার ঘটনায় গতকাল সোমবার তিনটি পৃথক মামলা করা হয়েছে। টেকনাফ মডেল থানায় দায়ের করা এসব মামলায় রোহিঙ্গা ক্যাম্পের কুখ্যাত সন্ত্রাসী মোহাম্ম&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/733981/%E0%A6%9F%E0%A7%87%E0%A6%95%E0%A6%A8%E0%A6%BE%E0%A6%AB%E0%A7%87-%E0%A6%B8%E0%A7%87%E0%A6%A8%E0%A6%BE%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A7%9F-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%86%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%BF-%E0%A7%AF%E0%A7%AB">দেশ রূপান্তর</source>

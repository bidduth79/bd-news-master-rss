    <item>
      <title>রাষ্ট্র যখন বৈষম্য টিকিয়ে রাখে</title>
      <link>https://www.deshrupantor.com/736675/%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0-%E0%A6%AF%E0%A6%96%E0%A6%A8-%E0%A6%AC%E0%A7%88%E0%A6%B7%E0%A6%AE%E0%A7%8D%E0%A6%AF-%E0%A6%9F%E0%A6%BF%E0%A6%95%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%96%E0%A7%87</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736675/%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0-%E0%A6%AF%E0%A6%96%E0%A6%A8-%E0%A6%AC%E0%A7%88%E0%A6%B7%E0%A6%AE%E0%A7%8D%E0%A6%AF-%E0%A6%9F%E0%A6%BF%E0%A6%95%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%96%E0%A7%87</guid>
      <pubDate>Sat, 21 Nov 2026 00:47:00 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/2d86f2e10887ce562cc93482f7780cf4-6b0079a77df2e.jpg?jadewits_media_id=244017" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/2d86f2e10887ce562cc93482f7780cf4-6b0079a77df2e.jpg?jadewits_media_id=244017" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/2d86f2e10887ce562cc93482f7780cf4-6b0079a77df2e.jpg?jadewits_media_id=244017" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাষ্ট্র যখন বৈষম্য টিকিয়ে রাখে" /&gt;&lt;/p&gt;&lt;p&gt;স্থানীয় সরকার প্রতিমন্ত্রী মীর শাহে আলম বলেছেন, &amp;lsquo;স্বামী-স্ত্রী দুজনই চাকরি করুক এটি আমি ব্যক্তিগতভাবে পছন্দ করি না&amp;rsquo;। গত ১০ ডিসেম্বর স্থানীয় সরকার প্রকৌশল অধিদপ্তরের (এলজিইডি) নবনিয়োগপ্রাপ্ত সহকারী প্রকৌশলীদের ওরিয়েন্টেশন কোর্সে প্রধান অতিথির বক্তব্যে তিনি এ মন্তব্য করেন, যেখানে নারী ও পু&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736675/%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0-%E0%A6%AF%E0%A6%96%E0%A6%A8-%E0%A6%AC%E0%A7%88%E0%A6%B7%E0%A6%AE%E0%A7%8D%E0%A6%AF-%E0%A6%9F%E0%A6%BF%E0%A6%95%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%96%E0%A7%87">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>বাস্তবায়নে প্রয়োজন আন্তর্জাতিক দায়িত্বশীলতা</title>
      <link>https://www.deshrupantor.com/736674/%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%9F%E0%A7%8B%E0%A6%9C%E0%A6%A8-%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%A6%E0%A6%BE%E0%A7%9F%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A6%B6%E0%A7%80%E0%A6%B2%E0%A6%A4%E0%A6%BE%C2%A0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736674/%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%9F%E0%A7%8B%E0%A6%9C%E0%A6%A8-%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%A6%E0%A6%BE%E0%A7%9F%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A6%B6%E0%A7%80%E0%A6%B2%E0%A6%A4%E0%A6%BE%C2%A0</guid>
      <pubDate>Sat, 21 Nov 2026 00:46:00 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/e3b4a27a25d4e9f0a61b062ef182ed07-6b0079841a023.jpg?jadewits_media_id=244016" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/e3b4a27a25d4e9f0a61b062ef182ed07-6b0079841a023.jpg?jadewits_media_id=244016" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/e3b4a27a25d4e9f0a61b062ef182ed07-6b0079841a023.jpg?jadewits_media_id=244016" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাস্তবায়নে প্রয়োজন আন্তর্জাতিক দায়িত্বশীলতা" /&gt;&lt;/p&gt;&lt;p&gt;আন্তর্জাতিক বিচার আদালত (আইসিজে) মিয়ানমারের সংখ্যালঘু রোহিঙ্গা জনগোষ্ঠীর বিরুদ্ধে জেনোসাইড সংগঠনের জন্য দেশটিকে দায়ী করেছে। আদালত বলেছে, ২০১৭ সালে সেখানে &amp;lsquo;ক্লিয়ারেন্স অপারেশন&amp;rsquo; নামে চালানো অভিযানে জেনোসাইডের মতলব ছিল। তখন প্রায় ১০ হাজার মানুষকে খুন করা হয়েছে। প্রায় ৪০০ গ্রাম পুড়িয়ে দেওয়া &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736674/%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%9F%E0%A7%8B%E0%A6%9C%E0%A6%A8-%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%A6%E0%A6%BE%E0%A7%9F%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A6%B6%E0%A7%80%E0%A6%B2%E0%A6%A4%E0%A6%BE%C2%A0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>জ্যোতিদের জন্য ওষুধ খুঁজছে বিসিবি</title>
      <link>https://www.deshrupantor.com/736705/%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%A4%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%93%E0%A6%B7%E0%A7%81%E0%A6%A7-%E0%A6%96%E0%A7%81%E0%A6%81%E0%A6%9C%E0%A6%9B%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A6%BF%E0%A6%AC%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736705/%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%A4%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%93%E0%A6%B7%E0%A7%81%E0%A6%A7-%E0%A6%96%E0%A7%81%E0%A6%81%E0%A6%9C%E0%A6%9B%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A6%BF%E0%A6%AC%E0%A6%BF</guid>
      <pubDate>Sat, 21 Nov 2026 00:25:18 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/175ed89d128fe0b6657427e55f5ddc34-6b00908705f9f.jpg?jadewits_media_id=244038" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/175ed89d128fe0b6657427e55f5ddc34-6b00908705f9f.jpg?jadewits_media_id=244038" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/175ed89d128fe0b6657427e55f5ddc34-6b00908705f9f.jpg?jadewits_media_id=244038" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জ্যোতিদের জন্য ওষুধ খুঁজছে বিসিবি" /&gt;&lt;/p&gt;&lt;p&gt;একটির পর একটি টুর্নামেন্ট আর সিরিজ যাচ্ছে, কিন্তু পরিবর্তনের হাওয়া বইছে না বাংলাদেশ নারী ক্রিকেটে। ব্যর্থতার বৃত্তেই ঘুরপাক খাচ্ছে। কখনো গুরুত্বপূর্ণ সময়ে হোঁচট, কখনো সামর্থ্য প্রমাণে ব্যর্থ, কখনো ধারাবাহিকতার অভাব। এর সঙ্গে ফিটনেসের ঘাটতি। নিগার সুলতানা জ্যোতিদের এমন অবস্থায় বাংলাদেশ ক্রিকেট বোর্ড&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736705/%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%A4%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%93%E0%A6%B7%E0%A7%81%E0%A6%A7-%E0%A6%96%E0%A7%81%E0%A6%81%E0%A6%9C%E0%A6%9B%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A6%BF%E0%A6%AC%E0%A6%BF">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>স্পেন-ফ্রান্স দ্বৈরথ</title>
      <link>https://www.deshrupantor.com/736704/%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A7%87%E0%A6%A8-%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%B8-%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%88%E0%A6%B0%E0%A6%A5</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736704/%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A7%87%E0%A6%A8-%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%B8-%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%88%E0%A6%B0%E0%A6%A5</guid>
      <pubDate>Sat, 21 Nov 2026 00:24:53 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/684b7a261a4ed9e812aaaa309d11b96a-6b008fd7c4d2b.jpg?jadewits_media_id=244037" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/684b7a261a4ed9e812aaaa309d11b96a-6b008fd7c4d2b.jpg?jadewits_media_id=244037" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/684b7a261a4ed9e812aaaa309d11b96a-6b008fd7c4d2b.jpg?jadewits_media_id=244037" style="max-width:100%;height:auto;margin-bottom:10px;" alt="স্পেন-ফ্রান্স দ্বৈরথ" /&gt;&lt;/p&gt;&lt;p&gt;নকআউট পর্বের আগেই উত্তাপ ছড়াল উয়েফা নেশনস লিগ, যেখানে এ বছরের উত্তর আমেরিকা বিশ্বকাপের স্মৃতি ফিরিয়ে শেষ আটেই মুখোমুখি হচ্ছে স্পেন ও ফ্রান্স। শুক্রবার নিওঁতে অনুষ্ঠিত ড্র শেষে চূড়ান্ত হওয়া কোয়ার্টার ফাইনাল সূচিতে এই স্পেন-ফ্রান্স মহারণের পাশাপাশি ইংল্যান্ডের সামনে নরওয়ে, টুর্নামেন্টের বর্তমান চ্যাম্&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736704/%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A7%87%E0%A6%A8-%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%B8-%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%88%E0%A6%B0%E0%A6%A5">দেশ রূপান্তর</source>
    </item>

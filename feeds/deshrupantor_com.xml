    <item>
      <title>ভারতীয় হাইকমিশনারের সঙ্গে মার্কিন রাষ্ট্রদূতের বৈঠক</title>
      <link>https://www.deshrupantor.com/734719/%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%B9%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A6%AE%E0%A6%BF%E0%A6%B6%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8-%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A7%82%E0%A6%A4%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734719/%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%B9%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A6%AE%E0%A6%BF%E0%A6%B6%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8-%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A7%82%E0%A6%A4%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Thu, 12 Nov 2026 22:21:19 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/5989beff353ac7aaba5ddcfcf33a4a18-6af5e761d0cb7.jpg?jadewits_media_id=242118" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/5989beff353ac7aaba5ddcfcf33a4a18-6af5e761d0cb7.jpg?jadewits_media_id=242118" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/5989beff353ac7aaba5ddcfcf33a4a18-6af5e761d0cb7.jpg?jadewits_media_id=242118" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভারতীয় হাইকমিশনারের সঙ্গে মার্কিন রাষ্ট্রদূতের বৈঠক" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশে নিযুক্ত মার্কিন রাষ্ট্রদূত ব্রেন্ট টি ক্রিস্টেনসেন বৃহস্পতিবার (১২ নভেম্বর) ভারতীয় হাইকমিশনে গিয়ে দেশটির হাইকমিশনার দীনেশ ত্রিবেদীর সঙ্গে বৈঠক করেছেন।
মার্কিন দূতাবাসের একটি সূত্র ইউএনবিকে বৈঠকের বিষয়টি নিশ্চিত করেছেন। তবে দুই কূটনীতিকের মধ্যে কী আলোচনা হয়েছে, তা জানা যায়নি বলে জানিয়েছেন স&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734719/%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%B9%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A6%AE%E0%A6%BF%E0%A6%B6%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8-%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A7%82%E0%A6%A4%E0%A7%87%E0%A6%B0">দেশ রূপান্তর</source>
    </item>

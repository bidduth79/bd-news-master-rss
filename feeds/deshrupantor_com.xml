      <guid isPermaLink="true">https://www.deshrupantor.com/735178/%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%95%E0%A7%8B%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%B0%E0%A6%BE%E0%A6%A6%E0%A7%8D%E0%A6%A6-%E0%A6%AC%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%B2-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A6%A4%E0%A6%BE-%E0%A6%95%E0%A6%AE%E0%A6%BF%E0%A6%9F%E0%A6%BF%E0%A6%A4%E0%A7%87</guid>
      <pubDate>Sat, 14 Nov 2026 20:31:56 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/c1d2076e8f8955bf509ee604e5672529-6af8698c48371.jpg?jadewits_media_id=242583" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/c1d2076e8f8955bf509ee604e5672529-6af8698c48371.jpg?jadewits_media_id=242583" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/c1d2076e8f8955bf509ee604e5672529-6af8698c48371.jpg?jadewits_media_id=242583" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পরিচ্ছন্নতায় অবহেলা করলে বাতিল হবে সরকারি কোয়ার্টারের বরাদ্দ" /&gt;&lt;/p&gt;&lt;p&gt;ঢাকা মহানগরকে একটি বাসযোগ্য, পরিচ্ছন্ন ও সবুজ নগরী হিসেবে গড়ে তুলতে কঠোর ও যুগান্তকারী একগুচ্ছ সিদ্ধান্ত নিয়েছে সরকার। পাড়া-মহল্লার পরিষ্কার-পরিচ্ছন্নতা কার্যক্রমে অবসরপ্রাপ্ত সরকারি কর্মকর্তা ও প্রবীণ নাগরিকদের যুক্ত করার পাশাপাশি সরকারি কোয়ার্টারে ময়লা-আবর্জনা পরিষ্কারের বিষয়ে উদাসীনতা দেখালে কঠোর&lt;/p&gt;</description>

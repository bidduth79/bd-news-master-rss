      <guid isPermaLink="true">https://www.deshrupantor.com/733915/%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A6%BE-%E0%A6%9B%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A7%83%E0%A6%A6%E0%A7%9F%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%B6%E0%A7%80-%E0%A6%97%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A7%87-%E0%A6%AE%E0%A7%81%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%B9%E0%A6%B0-%E2%80%98%E0%A6%B8%E0%A6%BE%E0%A6%95%E0%A7%80%E2%80%99</guid>
      <pubDate>Mon, 09 Nov 2026 20:54:39 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/a1bd6b6e39e1dbc315023094b8a0200f-6af1de98bf4aa.gif?jadewits_media_id=241368" length="0" type="image/jpeg" />

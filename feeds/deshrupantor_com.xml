      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/3f34fba5adc6222d1361dc695d1e561f-6af76df013b99.jpg?jadewits_media_id=242371" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/3f34fba5adc6222d1361dc695d1e561f-6af76df013b99.jpg?jadewits_media_id=242371" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/3f34fba5adc6222d1361dc695d1e561f-6af76df013b99.jpg?jadewits_media_id=242371" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রংপুরে বাড়ির ওপর বালুবোঝাই ট্রাক ঘুমন্ত শিশুর মৃত্যু" /&gt;&lt;/p&gt;&lt;p&gt;রংপুর নগরীতে নিয়ন্ত্রণ হারিয়ে একটি বালুবোঝাই ডাম্প ট্রাক বাড়ির ওপর উল্টে পড়েছে। এতে ঘুমন্ত অবস্থায় ট্রাকের নিচে চাপা পড়ে মোছা. সিনথিয়া নামে এক শিশু নিহত হয়েছে। এ ঘটনায় তার অন্তঃসত্ত্বা মা আশা বেগম গুরুতর আহত হয়েছেন। গতকাল শুক্রবার ভোর ৪টার দিকে নগরীর ৩০ নম্বর ওয়ার্ডের পশ্চিম খাসবাগ চারমাথা এলাকায় এ &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734987/%E0%A6%B0%E0%A6%82%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B2%E0%A7%81%E0%A6%AC%E0%A7%8B%E0%A6%9D%E0%A6%BE%E0%A6%87-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%95-%E0%A6%98%E0%A7%81%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%B0">দেশ রূপান্তর</source>

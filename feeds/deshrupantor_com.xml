      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2023/11/01/756bedac712941f47eb46b3a34b88636-6541866731238.png?jadewits_media_id=9" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাষ্ট্রের গুরুত্বপূর্ণ সম্পদ নিয়ে কী হচ্ছে জাতি জানতে চায়" /&gt;&lt;/p&gt;&lt;p&gt;রাষ্ট্রের গুরুত্বপূর্ণ সম্পদ নিয়ে পর্দার আড়ালে কী হচ্ছে, তা জাতি জানতে চায় বলে মন্তব্য করেছেন বাংলাদেশ জামায়াতে ইসলামীর আমির ও জাতীয় সংসদের বিরোধীদলীয় নেতা ডা. শফিকুর রহমান। তিনি বলেছেন, জাতীয় গুরুত্বপূর্ণ বিষয়গুলো নিয়ে সংসদে নোটিস দেওয়া হয়েছে। এসব বিষয়ে সংসদে জবাব না পাওয়া গেলে জনগণের আদালতে কথা বল&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735789/%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A7%81%E0%A6%B0%E0%A7%81%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A6%AA%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%A3-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%A6-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%95%E0%A7%80-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A6%BF">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>২১ আদালতে বিচারক মাত্র ৪</title>
      <link>https://www.deshrupantor.com/735788/%E0%A7%A8%E0%A7%A7-%E0%A6%86%E0%A6%A6%E0%A6%BE%E0%A6%B2%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A6%95-%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A7%AA</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735788/%E0%A7%A8%E0%A7%A7-%E0%A6%86%E0%A6%A6%E0%A6%BE%E0%A6%B2%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A6%95-%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A7%AA</guid>
      <pubDate>Tue, 17 Nov 2026 08:24:50 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/5b9cf342e31dada4991b0843042b03bf-6afbb84d55da4.jpg?jadewits_media_id=243171" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/5b9cf342e31dada4991b0843042b03bf-6afbb84d55da4.jpg?jadewits_media_id=243171" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/5b9cf342e31dada4991b0843042b03bf-6afbb84d55da4.jpg?jadewits_media_id=243171" style="max-width:100%;height:auto;margin-bottom:10px;" alt="২১ আদালতে বিচারক মাত্র ৪" /&gt;&lt;/p&gt;&lt;p&gt;জামালপুরে তীব্র বিচারক সংকটে আদালতের স্বাভাবিক বিচারিক কার্যক্রম ব্যাহত হচ্ছে। চিফ জুডিশিয়াল ম্যাজিস্ট্রেট আদালতে ১৫টি পদের বিপরীতে কর্মরত আছেন মাত্র চারজন বিচারক। অন্যদিকে জেলা ও দায়রা জজ আদালতেও শূন্য রয়েছে ছয়টি পদ। প্রয়োজনের তুলনায় বিচারক কম থাকায় নির্ধারিত সময়ে মামলার শুনানি ও নিষ্পত্তি সম্ভব হচ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735788/%E0%A7%A8%E0%A7%A7-%E0%A6%86%E0%A6%A6%E0%A6%BE%E0%A6%B2%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A6%95-%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A7%AA">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>অভিযুক্ত যুবলীগ নেতার ভাইকে পিটিয়ে হত্যা</title>
      <link>https://www.deshrupantor.com/735787/%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%AD%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%BF%E0%A6%9F%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735787/%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%AD%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%BF%E0%A6%9F%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE</guid>
      <pubDate>Tue, 17 Nov 2026 08:24:11 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/b41f847b4e419fcc4ae0a6ad41c840ec-6afbb84e915ac.jpg?jadewits_media_id=243174" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/b41f847b4e419fcc4ae0a6ad41c840ec-6afbb84e915ac.jpg?jadewits_media_id=243174" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/b41f847b4e419fcc4ae0a6ad41c840ec-6afbb84e915ac.jpg?jadewits_media_id=243174" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অভিযুক্ত যুবলীগ নেতার ভাইকে পিটিয়ে হত্যা" /&gt;&lt;/p&gt;&lt;p&gt;ময়মনসিংহ নগরীতে স্বেচ্ছাসেবক দলের নেতা সুরুজ জামানকে হত্যার ঘটনায় অভিযুক্ত যুবলীগ নেতার ছোট ভাই মেহেদী হাসানকে (৩১) পিটিয়ে হত্যা করেছেন স্থানীয় লোকজন। গত রবিবার রাতে গণপিটুনিতে গুরুতর আহত হওয়ার পর সোমবার ভোরে ময়মনসিংহ মেডিকেল কলেজ হাসপাতালে চিকিৎসাধীন অবস্থায় তার মৃত্যু হয়।
নিহত মেহেদী হাসান নগরীর ব&lt;/p&gt;</description>

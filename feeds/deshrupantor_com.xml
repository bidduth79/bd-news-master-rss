    <item>
      <title>কুমিল্লায় ইয়াবাসহ যুবদল নেতা গ্রেপ্তার</title>
      <link>https://www.deshrupantor.com/735928/%E0%A6%95%E0%A7%81%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%87%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%B9-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%A6%E0%A6%B2-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%B8%E0%A6%B9-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A7%A9</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735928/%E0%A6%95%E0%A7%81%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%87%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%B9-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%A6%E0%A6%B2-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%B8%E0%A6%B9-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A7%A9</guid>
      <pubDate>Tue, 17 Nov 2026 18:39:30 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/5983ca20195802e3cd8ecb49930526bb-6afc48829b9ff.jpg?jadewits_media_id=243320" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/5983ca20195802e3cd8ecb49930526bb-6afc48829b9ff.jpg?jadewits_media_id=243320" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/5983ca20195802e3cd8ecb49930526bb-6afc48829b9ff.jpg?jadewits_media_id=243320" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কুমিল্লায় ইয়াবাসহ যুবদল নেতা গ্রেপ্তার" /&gt;&lt;/p&gt;&lt;p&gt;কুমিল্লার লাকসামে ৭৫ পিস ইয়াবা ট্যাবলেটসহ যুবদল নেতা মহিন হোসেন (৪০) ও তাঁর দুই সহযোগীকে গ্রেপ্তার করেছে পুলিশ। সোমবার পৃথক অভিযান চালিয়ে তাঁদের গ্রেপ্তার করা হয়। এ ঘটনায় মাদকদ্রব্য নিয়ন্ত্রণ আইনে তাঁদের বিরুদ্ধে দুটি মামলা করেছে পুলিশ।
মঙ্গলবার (১৭ নভেম্বর) দুপুরে আইনি প্রক্রিয়া শেষে গ্রেপ্তার তিনজ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735928/%E0%A6%95%E0%A7%81%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%87%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%B9-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%A6%E0%A6%B2-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%B8%E0%A6%B9-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A7%A9">দেশ রূপান্তর</source>
    </item>
    <item>

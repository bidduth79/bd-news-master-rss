      <guid isPermaLink="true">https://www.deshrupantor.com/738411/%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A6%A3%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%87%E0%A6%9F%E0%A6%AD%E0%A6%BE%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%B0%E0%A7%8D%E0%A6%B7-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF-%E0%A6%86%E0%A6%B9%E0%A6%A4-%E0%A7%A8%E0%A7%A6</guid>
      <pubDate>Sat, 28 Nov 2026 06:51:09 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/f02c2c0c32eb651231431c618f4823fb-6b0a24305bf8f.jpg?jadewits_media_id=245676" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/f02c2c0c32eb651231431c618f4823fb-6b0a24305bf8f.jpg?jadewits_media_id=245676" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/f02c2c0c32eb651231431c618f4823fb-6b0a24305bf8f.jpg?jadewits_media_id=245676" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নারায়ণগঞ্জে ইটভাটার চাঁদা নিয়ে সংঘর্ষ গুলি, আহত ২০" /&gt;&lt;/p&gt;&lt;p&gt;নারায়ণগঞ্জের ফতুল্লার বক্তাবলীতে ইটভাটায় চাঁদা ও মাটি বিক্রি কমিশন-বাণিজ্যের নিয়ন্ত্রণ নিয়ে সামাদ আলী ও হালিম আজাদ গ্রুপের মধ্যে সংঘর্ষে শটগান দিয়ে গুলি ও টেঁটাবিদ্ধ হয়ে উভয় পক্ষের নারীসহ ২০ জন আহত হয়েছে। গতকাল বেলা ১১টা থেকে দুপুর পর্যন্ত আকবরনগর ও উত্তর গোপালনগর এলাকায় এ সংঘর্ষের ঘটনা ঘটে। আহতদের &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/738411/%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A6%A3%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%87%E0%A6%9F%E0%A6%AD%E0%A6%BE%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%B0%E0%A7%8D%E0%A6%B7-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF-%E0%A6%86%E0%A6%B9%E0%A6%A4-%E0%A7%A8%E0%A7%A6">দেশ রূপান্তর</source>

      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/2e907b5023e6a598df2faf5f35e06a21-6b063d06a4757.jpg?jadewits_media_id=245030" length="0" type="image/jpeg" />

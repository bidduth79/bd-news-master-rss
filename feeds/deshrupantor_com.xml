    <item>
      <title>কিউএস টেকসই র‍্যাঙ্কিংয়ে ৬৫ ধাপ এগিয়ে দেশে পঞ্চম রাবি</title>
      <link>https://www.deshrupantor.com/736028/%E0%A6%95%E0%A6%BF%E0%A6%89%E0%A6%8F%E0%A6%B8-%E0%A6%9F%E0%A7%87%E0%A6%95%E0%A6%B8%E0%A6%87-%E0%A6%B0%E2%80%8D%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%82%E0%A7%9F%E0%A7%87-%E0%A7%AC%E0%A7%AB-%E0%A6%A7%E0%A6%BE%E0%A6%AA-%E0%A6%8F%E0%A6%97%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AA%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%AE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736028/%E0%A6%95%E0%A6%BF%E0%A6%89%E0%A6%8F%E0%A6%B8-%E0%A6%9F%E0%A7%87%E0%A6%95%E0%A6%B8%E0%A6%87-%E0%A6%B0%E2%80%8D%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%82%E0%A7%9F%E0%A7%87-%E0%A7%AC%E0%A7%AB-%E0%A6%A7%E0%A6%BE%E0%A6%AA-%E0%A6%8F%E0%A6%97%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AA%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%AE</guid>
      <pubDate>Wed, 18 Nov 2026 03:02:01 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/41eb3a40926b43bbe9eca26eef1d8769-6afcc07d53f26.jpg?jadewits_media_id=243421" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/41eb3a40926b43bbe9eca26eef1d8769-6afcc07d53f26.jpg?jadewits_media_id=243421" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/41eb3a40926b43bbe9eca26eef1d8769-6afcc07d53f26.jpg?jadewits_media_id=243421" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কিউএস টেকসই র‍্যাঙ্কিংয়ে ৬৫ ধাপ এগিয়ে দেশে পঞ্চম রাবি" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাজ্যভিত্তিক শিক্ষা ও গবেষণা সংস্থা কোয়াককোয়ারেলি সায়মন্ডসের (কিউএস) বিশ্বসেরা টেকসই বিশ্ববিদ্যালয়ের তালিকা প্রকাশ করেছে। এতে ৬৫ ধাপ এগিয়ে ৯৭৭তম অবস্থান অর্জন করেছে রাজশাহী বিশ্ববিদ্যালয়। দেশের ২৫টি বিশ্ববিদ্যালয়ের ভেতরে রাবির অবস্থান পঞ্চম।&amp;nbsp;
মঙ্গলবার (১৭ নভেম্বর) পঞ্চমবারের মতো &amp;lsquo;কিউ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736028/%E0%A6%95%E0%A6%BF%E0%A6%89%E0%A6%8F%E0%A6%B8-%E0%A6%9F%E0%A7%87%E0%A6%95%E0%A6%B8%E0%A6%87-%E0%A6%B0%E2%80%8D%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%82%E0%A7%9F%E0%A7%87-%E0%A7%AC%E0%A7%AB-%E0%A6%A7%E0%A6%BE%E0%A6%AA-%E0%A6%8F%E0%A6%97%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AA%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%AE">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>প্রবাসেও সাবেক সতীর্থদের এক সুতোয় বাঁধছেন গাফফার</title>

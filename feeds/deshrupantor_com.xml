      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/4d004dd1150563d170c134475f106578-6b02bbdb16fb2.jpg?jadewits_media_id=244375" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/4d004dd1150563d170c134475f106578-6b02bbdb16fb2.jpg?jadewits_media_id=244375" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/4d004dd1150563d170c134475f106578-6b02bbdb16fb2.jpg?jadewits_media_id=244375" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইন্দোনেশিয়ায় কারখানায় ভয়াবহ আগুন" /&gt;&lt;/p&gt;&lt;p&gt;ইন্দোনেশিয়ার একটি মিষ্টি তৈরির কারখানায় ভয়াবহ অগ্নিকাণ্ডে অন্তত তিনজন নিহত হয়েছেন। এ ঘটনায় এখনো নিখোঁজ রয়েছেন ৩৬ জন। খবর আল জাজিরা।&amp;nbsp;
রবিবার (২২ নভেম্বর) দেশটির জাতীয় অনুসন্ধান ও উদ্ধার সংস্থা এক বিবৃতিতে জানায়, রাজধানী জাকার্তার পাশের বানতেন প্রদেশে অবস্থিত ফনুসা আগুং মুলিয়া কারখানাটি থেকে অন্ত&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737045/%E0%A6%87%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8B%E0%A6%A8%E0%A7%87%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AD%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A6%B9-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8">দেশ রূপান্তর</source>

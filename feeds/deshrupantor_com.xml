    <item>
      <title>বাংলাদেশে প্রথম এআইবিষয়ক ত্রৈমাসিক বুলেটিনের যাত্রা শুরু</title>
      <link>https://www.deshrupantor.com/737653/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%8F%E0%A6%86%E0%A6%87%E0%A6%AC%E0%A6%BF%E0%A6%B7%E0%A7%9F%E0%A6%95-%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%88%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%95-%E0%A6%AC%E0%A7%81%E0%A6%B2%E0%A7%87%E0%A6%9F%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737653/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%8F%E0%A6%86%E0%A6%87%E0%A6%AC%E0%A6%BF%E0%A6%B7%E0%A7%9F%E0%A6%95-%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%88%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%95-%E0%A6%AC%E0%A7%81%E0%A6%B2%E0%A7%87%E0%A6%9F%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Tue, 24 Nov 2026 22:40:17 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/9a4b1159550e297ab541dd61adb48df8-6b05bda519da7.jpg?jadewits_media_id=244968" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/9a4b1159550e297ab541dd61adb48df8-6b05bda519da7.jpg?jadewits_media_id=244968" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/9a4b1159550e297ab541dd61adb48df8-6b05bda519da7.jpg?jadewits_media_id=244968" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাংলাদেশে প্রথম এআইবিষয়ক ত্রৈমাসিক বুলেটিনের যাত্রা শুরু" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশে প্রথমবারের মতো কৃত্রিম বুদ্ধিমত্তা (এআই) বিষয়ক ত্রৈমাসিক প্রকাশনা ‘এআই ফর দ্য গ্লোবাল সাউথ: আ কোয়ার্টারলি বুলেটিন’-এর উদ্বোধনী সংখ্যা প্রকাশিত হয়েছে। মঙ্গলবার রাজধানীর একটি হোটেলে আনুষ্ঠানিকভাবে বুলেটিনটির মোড়ক উন্মোচন করা হয়।
অনুষ্ঠানে প্রধান অতিথি হিসেবে উপস্থিত ছিলেন প্রাথমিক ও গণশিক্ষা&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737653/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%8F%E0%A6%86%E0%A6%87%E0%A6%AC%E0%A6%BF%E0%A6%B7%E0%A7%9F%E0%A6%95-%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%88%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%95-%E0%A6%AC%E0%A7%81%E0%A6%B2%E0%A7%87%E0%A6%9F%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>খুলনায় ১০ ঘণ্টার ব্যবধানে ৫ জায়গায় গুলি, নিহত ১</title>

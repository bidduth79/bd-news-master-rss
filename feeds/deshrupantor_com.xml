      <guid isPermaLink="true">https://www.deshrupantor.com/738265/%E2%80%98%E0%A6%A6%E0%A7%8D%E0%A6%AF-%E0%A6%85%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E2%80%99-%E0%A6%8F%E0%A6%B0-%E0%A6%B0%E0%A6%BF%E0%A6%AA%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%9F-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%B0-%E0%A6%9A%E0%A7%87%E0%A7%9F%E0%A7%87</guid>
      <pubDate>Fri, 27 Nov 2026 02:31:54 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2023/11/01/756bedac712941f47eb46b3a34b88636-6541866731238.png?jadewits_media_id=9" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2023/11/01/756bedac712941f47eb46b3a34b88636-6541866731238.png?jadewits_media_id=9" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2023/11/01/756bedac712941f47eb46b3a34b88636-6541866731238.png?jadewits_media_id=9" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘দ্য অস্ট্রেলিয়ান’-এর রিপোর্ট প্রত্যাহার চেয়ে জামায়াতের নোটিস" /&gt;&lt;/p&gt;&lt;p&gt;জামায়াতে ইসলামীর আমির ও বিরোধীদলীয় নেতা ডা. শফিকুর রহমানের অস্ট্রেলিয়া সফর নিয়ে দেশটির সংবাদমাধ্যম &amp;lsquo;দ্য অস্ট্রেলিয়ান&amp;rsquo;-এ প্রকাশিত প্রতিবেদনের বিরুদ্ধে আইনি নোটিস দিয়েছে জামায়াত। প্রতিবেদনে মিথ্যা, বিভ্রান্তিকর ও মানহানিকর তথ্য প্রকাশের অভিযোগ তুলে তা প্রত্যাহার, সংশোধন ও প্রকাশ্যে ক্ষমা চ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/738265/%E2%80%98%E0%A6%A6%E0%A7%8D%E0%A6%AF-%E0%A6%85%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E2%80%99-%E0%A6%8F%E0%A6%B0-%E0%A6%B0%E0%A6%BF%E0%A6%AA%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%9F-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%B0-%E0%A6%9A%E0%A7%87%E0%A7%9F%E0%A7%87">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>জেগেছে চর, বন্ধ হচ্ছে নৌপথ</title>
      <link>https://www.deshrupantor.com/738264/%E0%A6%9C%E0%A7%87%E0%A6%97%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%9A%E0%A6%B0-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%A8%E0%A7%8C%E0%A6%AA%E0%A6%A5</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/738264/%E0%A6%9C%E0%A7%87%E0%A6%97%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%9A%E0%A6%B0-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%A8%E0%A7%8C%E0%A6%AA%E0%A6%A5</guid>
      <pubDate>Fri, 27 Nov 2026 02:31:14 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/28ce3c013e754f0b832e7ff30151453e-6b088922e1c13.jpg?jadewits_media_id=245489" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/28ce3c013e754f0b832e7ff30151453e-6b088922e1c13.jpg?jadewits_media_id=245489" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/28ce3c013e754f0b832e7ff30151453e-6b088922e1c13.jpg?jadewits_media_id=245489" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জেগেছে চর, বন্ধ হচ্ছে নৌপথ" /&gt;&lt;/p&gt;&lt;p&gt;নদীর পানি কমে জেগে উঠেছে অসংখ্য বালুচর। কোথাও শীর্ণ হয়ে এসেছে নৌপথ, কোথাও আবার ডুবোচরে আটকে যাচ্ছে নৌকা। মূল ভূখ-ের সঙ্গে যোগাযোগ রাখতে চরাঞ্চলের মানুষকে দীর্ঘ বালুপথ পাড়ি দিতে হচ্ছে। এতে যাত্রী ও পণ্য পরিবহনে সময় ও খরচ বেড়েছে। নাব্য সংকটে কুড়িগ্রামের শতাধিক নৌঘাট বন্ধ হওয়ার উপক্রম হয়েছে। আগে যেখানে&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/738264/%E0%A6%9C%E0%A7%87%E0%A6%97%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%9A%E0%A6%B0-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%A8%E0%A7%8C%E0%A6%AA%E0%A6%A5">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>৬ মাসের চাহিদার জ্বালানি তেল কিনছে সরকার</title>

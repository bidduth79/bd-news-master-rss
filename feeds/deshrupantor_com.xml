    <item>
      <title>গাজায় ইসরায়েলি হামলায় মন্ত্রীসহ নিহত ১০</title>
      <link>https://www.deshrupantor.com/738421/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A7%9F-%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B2%E0%A6%BF-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B8%E0%A6%B9-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A7%A7%E0%A7%A6</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/738421/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A7%9F-%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B2%E0%A6%BF-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B8%E0%A6%B9-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A7%A7%E0%A7%A6</guid>
      <pubDate>Sat, 28 Nov 2026 07:18:23 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/f02c2c0c32eb651231431c618f4823fb-6b0a24305bf8f.jpg?jadewits_media_id=245676" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/f02c2c0c32eb651231431c618f4823fb-6b0a24305bf8f.jpg?jadewits_media_id=245676" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/f02c2c0c32eb651231431c618f4823fb-6b0a24305bf8f.jpg?jadewits_media_id=245676" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গাজায় ইসরায়েলি হামলায় মন্ত্রীসহ নিহত ১০" /&gt;&lt;/p&gt;&lt;p&gt;গাজায় ইসরায়েলি হামলায় হামাসের জ্যেষ্ঠ নেতা ও শিক্ষা উপমন্ত্রী খালেদ আবু নাদাসহ অন্তত ১০ জন নিহত হয়েছেন। ইসরায়েলের ধারাবাহিক হামলার জবাব কীভাবে দেওয়া হবে, তা নিয়ে ফিলিস্তিনের অন্য গোষ্ঠীগুলোর সঙ্গে আলোচনার কথা জানিয়েছে হামাস।
গত বৃহস্পতিবার হামাসপ্রধান খলিল আল-হাইয়া বলেন, ইসরায়েলের অব্যাহত হামলা সহ্য&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/738421/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A7%9F-%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B2%E0%A6%BF-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B8%E0%A6%B9-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A7%A7%E0%A7%A6">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>ইউরোপে সামরিক আগ্রাসন বন্ধে পুতিনকে অনুরোধ ট্রাম্পের</title>
      <link>https://www.deshrupantor.com/738420/%E0%A6%87%E0%A6%89%E0%A6%B0%E0%A7%8B%E0%A6%AA%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%B0%E0%A6%BF%E0%A6%95-%E0%A6%86%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A6%A8-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%A4%E0%A6%BF%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%B0%E0%A7%8B%E0%A6%A7</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/738420/%E0%A6%87%E0%A6%89%E0%A6%B0%E0%A7%8B%E0%A6%AA%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%B0%E0%A6%BF%E0%A6%95-%E0%A6%86%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A6%A8-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%A4%E0%A6%BF%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%B0%E0%A7%8B%E0%A6%A7</guid>
      <pubDate>Sat, 28 Nov 2026 07:18:02 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/f02c2c0c32eb651231431c618f4823fb-6b0a24305bf8f.jpg?jadewits_media_id=245676" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/f02c2c0c32eb651231431c618f4823fb-6b0a24305bf8f.jpg?jadewits_media_id=245676" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/f02c2c0c32eb651231431c618f4823fb-6b0a24305bf8f.jpg?jadewits_media_id=245676" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইউরোপে সামরিক আগ্রাসন বন্ধে পুতিনকে অনুরোধ ট্রাম্পের" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাষ্ট্রের প্রেসিডেন্ট ডোনাল্ড ট্রাম্প বলেছেন, গত সপ্তাহে রুশ প্রেসিডেন্ট ভ&amp;oslash;াদিমির পুতিনকে ইউরোপের বিভিন্ন ভূখ-ে সামরিক আগ্রাসন বন্ধ করার আহ্বান জানিয়েছেন তিনি। ট্রাম্পের প্রত্যাশা, এসব আগ্রাসন বন্ধ হলে দ্রুত ইউক্রেন যুদ্ধের অবসান ঘটানো সম্ভব হবে।
নিজের সামাজিক মাধ্যম ট্রুথ সোশ্যালে গত বৃ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/738420/%E0%A6%87%E0%A6%89%E0%A6%B0%E0%A7%8B%E0%A6%AA%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%B0%E0%A6%BF%E0%A6%95-%E0%A6%86%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A6%A8-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%A4%E0%A6%BF%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%B0%E0%A7%8B%E0%A6%A7">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>ককরোচ নেতার বিরুদ্ধে ‘লুক আউট সার্কুলার’ জারি</title>
      <link>https://www.deshrupantor.com/738419/%E0%A6%95%E0%A6%95%E0%A6%B0%E0%A7%8B%E0%A6%9A-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E2%80%98%E0%A6%B2%E0%A7%81%E0%A6%95-%E0%A6%86%E0%A6%89%E0%A6%9F-%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2%E0%A6%BE%E0%A6%B0%E2%80%99-%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/738419/%E0%A6%95%E0%A6%95%E0%A6%B0%E0%A7%8B%E0%A6%9A-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E2%80%98%E0%A6%B2%E0%A7%81%E0%A6%95-%E0%A6%86%E0%A6%89%E0%A6%9F-%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2%E0%A6%BE%E0%A6%B0%E2%80%99-%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A6%BF</guid>

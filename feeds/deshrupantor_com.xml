    <item>
      <title>নিজ বাসের ধাক্কায় মারা গেলেন চেকার</title>
      <link>https://www.deshrupantor.com/736063/%E0%A6%A8%E0%A6%BF%E0%A6%9C-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%A7%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%97%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%9A%E0%A7%87%E0%A6%95%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736063/%E0%A6%A8%E0%A6%BF%E0%A6%9C-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%A7%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%97%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%9A%E0%A7%87%E0%A6%95%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Wed, 18 Nov 2026 07:31:20 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2023/11/01/756bedac712941f47eb46b3a34b88636-6541866731238.png?jadewits_media_id=9" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2023/11/01/756bedac712941f47eb46b3a34b88636-6541866731238.png?jadewits_media_id=9" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2023/11/01/756bedac712941f47eb46b3a34b88636-6541866731238.png?jadewits_media_id=9" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নিজ বাসের ধাক্কায় মারা গেলেন চেকার" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর উত্তরা জসিম উদ্দিন রোড এলাকায় তানজিল পরিবহনের একটি বাসের ধাক্কায় মশিউর রহমান হাসান (৪২) নামে এক ব্যক্তি নিহত হয়েছেন। তিনি ওই বাসেরই চেকার হিসেবে চাকরি করতেন। গতকাল মঙ্গলবার বেলা ১১টার দিকে এই দুর্ঘটনা ঘটে।
তানজিল পরিবহনের সুপারভাইজার আতর আলী জানান, জসিম উদ্দিন রোডে বাসের যাত্রী চেক করতেন হা&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736063/%E0%A6%A8%E0%A6%BF%E0%A6%9C-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%A7%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%97%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%9A%E0%A7%87%E0%A6%95%E0%A6%BE%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>সুকান্তের জন্মশতবর্ষে আরণ্যকের ‘একটি মোরগের কাহিনি’</title>
      <link>https://www.deshrupantor.com/736062/%E0%A6%B8%E0%A7%81%E0%A6%95%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AE%E0%A6%B6%E0%A6%A4%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A6%A3%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%87%E0%A6%B0-%E2%80%98%E0%A6%8F%E0%A6%95%E0%A6%9F%E0%A6%BF-%E0%A6%AE%E0%A7%8B%E0%A6%B0%E0%A6%97%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736062/%E0%A6%B8%E0%A7%81%E0%A6%95%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AE%E0%A6%B6%E0%A6%A4%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A6%A3%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%87%E0%A6%B0-%E2%80%98%E0%A6%8F%E0%A6%95%E0%A6%9F%E0%A6%BF-%E0%A6%AE%E0%A7%8B%E0%A6%B0%E0%A6%97%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Wed, 18 Nov 2026 07:30:55 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2023/11/01/756bedac712941f47eb46b3a34b88636-6541866731238.png?jadewits_media_id=9" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2023/11/01/756bedac712941f47eb46b3a34b88636-6541866731238.png?jadewits_media_id=9" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2023/11/01/756bedac712941f47eb46b3a34b88636-6541866731238.png?jadewits_media_id=9" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সুকান্তের জন্মশতবর্ষে আরণ্যকের ‘একটি মোরগের কাহিনি’" /&gt;&lt;/p&gt;&lt;p&gt;কবি সুকান্ত ভট্টাচার্যের জন্মশতবর্ষ উপলক্ষে তার কবিতা অবলম্বনে আরণ্যক নাট্যদল মঞ্চে আনছে নাটক &amp;lsquo;একটি মোরগের কাহিনি&amp;rsquo;। নাটকটির রচনা ও নির্দেশনায় রয়েছেন অপু মেহেদী। আগামী ২০ নভেম্বর খুলনায় সুকান্ত ভট্টাচার্যের জন্মশতবর্ষ উদযাপন উৎসবে নাটকটির উদ্বোধনী মঞ্চায়ন হবে। দ্বিতীয় মঞ্চায়ন হবে ২৪ নভেম্&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736062/%E0%A6%B8%E0%A7%81%E0%A6%95%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AE%E0%A6%B6%E0%A6%A4%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A6%A3%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%87%E0%A6%B0-%E2%80%98%E0%A6%8F%E0%A6%95%E0%A6%9F%E0%A6%BF-%E0%A6%AE%E0%A7%8B%E0%A6%B0%E0%A6%97%E0%A7%87%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>মূসক ও সম্পূরক শুল্ক বিল-২০২৬ পাস</title>

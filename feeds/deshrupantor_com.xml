      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/c5c3f390b4cb37be952bd7c215d5237f-6af58135da4fb.jpg?jadewits_media_id=242006" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/c5c3f390b4cb37be952bd7c215d5237f-6af58135da4fb.jpg?jadewits_media_id=242006" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/c5c3f390b4cb37be952bd7c215d5237f-6af58135da4fb.jpg?jadewits_media_id=242006" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শেরপুরে সুজনের ২ যুগপূর্তি, মাদকবিরোধী কার্যক্রমের উদ্যোগ" /&gt;&lt;/p&gt;&lt;p&gt;সুশাসনের জন্য নাগরিক (সুজন)-এর দুই যুগ পূর্তি উপলক্ষে শেরপুরে আলোচনা সভা অনুষ্ঠিত হয়েছে।
বৃহস্পতিবার (১২ নভেম্বর) সকালে জেলা ডায়াবেটিক সমিতির হলরুমে &amp;lsquo;সচেতন, সংঘটিত ও সোচ্চার জনগোষ্ঠীই গণতন্ত্রের রক্ষাকবচ&amp;rsquo; শীর্ষক এ সভার আয়োজন করা হয়। এতে সভাপতিত্ব করেন বিশিষ্ট সমাজসেবক ও সুজনের সভাপতি রাজ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734608/%E0%A6%B6%E0%A7%87%E0%A6%B0%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A7%81%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A7%A8-%E0%A6%AF%E0%A7%81%E0%A6%97%E0%A6%AA%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A6%95%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%80-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A7%87%E0%A6%B0">দেশ রূপান্তর</source>
    </item>

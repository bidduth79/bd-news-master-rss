    <item>
      <title>গণহত্যার রায়ে রোহিঙ্গা প্রত্যাবাসনে কতটা প্রভাব ফেলবে?</title>
      <link>https://www.deshrupantor.com/736531/%E0%A6%97%E0%A6%A3%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A7%87-%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%A8%E0%A7%87-%E0%A6%95%E0%A6%A4%E0%A6%9F%E0%A6%BE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AD%E0%A6%BE%E0%A6%AC</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736531/%E0%A6%97%E0%A6%A3%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A7%87-%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%A8%E0%A7%87-%E0%A6%95%E0%A6%A4%E0%A6%9F%E0%A6%BE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AD%E0%A6%BE%E0%A6%AC</guid>
      <pubDate>Fri, 20 Nov 2026 07:11:15 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/c7fa8c54c376e7849a0fd255f07d7414-6afee9b17576d.jpg?jadewits_media_id=243765" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/c7fa8c54c376e7849a0fd255f07d7414-6afee9b17576d.jpg?jadewits_media_id=243765" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/c7fa8c54c376e7849a0fd255f07d7414-6afee9b17576d.jpg?jadewits_media_id=243765" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গণহত্যার রায়ে রোহিঙ্গা প্রত্যাবাসনে কতটা প্রভাব ফেলবে?" /&gt;&lt;/p&gt;&lt;p&gt;মিয়ানমারের রাখাইন রাজ্যে রোহিঙ্গা জনগোষ্ঠীর ওপর গণহত্যা চালানোর দায়ে দেশটির বিরুদ্ধে রায় দিয়েছে নেদারল্যান্ডসের হেগে অবস্থিত জাতিসংঘের সর্বোচ্চ আদালত আন্তর্জাতিক বিচার আদালত (আইসিজে)। দীর্ঘ বিচারিক প্রক্রিয়া শেষে দেওয়া এ রায়কে রোহিঙ্গাদের ন্যায়বিচার পাওয়ার পথে গুরুত্বপূর্ণ অগ্রগতি হিসেবে দেখা হচ্ছে।&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736531/%E0%A6%97%E0%A6%A3%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A7%87-%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%A8%E0%A7%87-%E0%A6%95%E0%A6%A4%E0%A6%9F%E0%A6%BE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AD%E0%A6%BE%E0%A6%AC">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>রোহিঙ্গাদের দ্রুত প্রত্যাবাসনের আশা বাংলাদেশের</title>
      <link>https://www.deshrupantor.com/736530/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%A4-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%B6%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736530/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%A4-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%B6%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Fri, 20 Nov 2026 06:53:20 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/fbc094bd50915662e59e9275371147f3-6aff924b708b0.jpg?jadewits_media_id=243859" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/fbc094bd50915662e59e9275371147f3-6aff924b708b0.jpg?jadewits_media_id=243859" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/fbc094bd50915662e59e9275371147f3-6aff924b708b0.jpg?jadewits_media_id=243859" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রোহিঙ্গাদের দ্রুত প্রত্যাবাসনের আশা বাংলাদেশের" /&gt;&lt;/p&gt;&lt;p&gt;রোহিঙ্গা জনগোষ্ঠীর ওপর মিয়ামনারের গণহত্যা নিয়ে আন্তর্জাতিক ন্যায়বিচার আদালত (আইসিজে) যে রায় দিয়েছে, সেটাকে স্বাগত জানিয়েছে বাংলাদেশ সরকার। এখন রায় মেনে রোহিঙ্গাদের দ্রুততার সঙ্গে প্রত্যাবাসন প্রক্রিয়া শুরুর আহ্বানও জানিয়েছে ঢাকা। গতকাল বৃহস্পতিবার পররাষ্ট্র মন্ত্রণালয়ে তাৎক্ষণিক প্রতিক্রিয়ায় সরকারের&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736530/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%A4-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%B6%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>বসুন্ধরায় রূপায়ণ বুলেভার্ড প্লাজার ভিত্তিপ্রস্তর স্থাপন</title>

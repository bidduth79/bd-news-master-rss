      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2023/11/01/756bedac712941f47eb46b3a34b88636-6541866731238.png?jadewits_media_id=9" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2023/11/01/756bedac712941f47eb46b3a34b88636-6541866731238.png?jadewits_media_id=9" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যুক্তরাজ্যে পোশাক রপ্তানি বেড়েছে ৬.৯২ শতাংশ" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাজ্যের বাজারে বাংলাদেশের তৈরি পোশাক রপ্তানি বেড়েছে। চলতি ২০২৬-২৭ অর্থবছরের প্রথম চার মাসে (জুলাই-অক্টোবর) দেশটিতে ১৬৪ কোটি ডলারের পোশাক রপ্তানি করেছেন বাংলাদেশের উদ্যোক্তারা। গত অর্থবছরের একই সময়ে রপ্তানির পরিমাণ ছিল ১৫৩ কোটি ৩৯ লাখ ডলার। সেই হিসাবে এক বছরের ব্যবধানে যুক্তরাজ্যে পোশাক রপ্তানি &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735755/%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%AA%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%95-%E0%A6%B0%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%AC%E0%A7%87%E0%A7%9C%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A7%AC.%E0%A7%AF%E0%A7%A8-%E0%A6%B6%E0%A6%A4%E0%A6%BE%E0%A6%82%E0%A6%B6">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>লোকসান কমল আফতাব অটোমোবাইলসের</title>
      <link>https://www.deshrupantor.com/735754/%E0%A6%B2%E0%A7%8B%E0%A6%95%E0%A6%B8%E0%A6%BE%E0%A6%A8-%E0%A6%95%E0%A6%AE%E0%A6%B2-%E0%A6%86%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%AC-%E0%A6%85%E0%A6%9F%E0%A7%8B%E0%A6%AE%E0%A7%8B%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A6%B8%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735754/%E0%A6%B2%E0%A7%8B%E0%A6%95%E0%A6%B8%E0%A6%BE%E0%A6%A8-%E0%A6%95%E0%A6%AE%E0%A6%B2-%E0%A6%86%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%AC-%E0%A6%85%E0%A6%9F%E0%A7%8B%E0%A6%AE%E0%A7%8B%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A6%B8%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Tue, 17 Nov 2026 00:34:50 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2023/11/01/756bedac712941f47eb46b3a34b88636-6541866731238.png?jadewits_media_id=9" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2023/11/01/756bedac712941f47eb46b3a34b88636-6541866731238.png?jadewits_media_id=9" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2023/11/01/756bedac712941f47eb46b3a34b88636-6541866731238.png?jadewits_media_id=9" style="max-width:100%;height:auto;margin-bottom:10px;" alt="লোকসান কমল আফতাব অটোমোবাইলসের" /&gt;&lt;/p&gt;&lt;p&gt;শেয়ারবাজারে তালিকাভুক্ত আফতাব অটোমোবাইলস লিমিটেড ২০২৬-২৭ হিসাব বছরের প্রথম প্রান্তিকের (জুলাই-সেপ্টেম্বর ২০২৬) আর্থিক প্রতিবেদন প্রকাশ করেছে। এ সময়ে কোম্পানিটির সমন্বিত শেয়ারপ্রতি লোকসান (ইপিএস) হয়েছে ৪৮ পয়সা। আগের বছরের একই প্রান্তিকে এ লোকসানের পরিমাণ ছিল ৫৫ পয়সা। অর্থাৎ এক বছরের ব্যবধানে শেয়ারপ্র&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735754/%E0%A6%B2%E0%A7%8B%E0%A6%95%E0%A6%B8%E0%A6%BE%E0%A6%A8-%E0%A6%95%E0%A6%AE%E0%A6%B2-%E0%A6%86%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%AC-%E0%A6%85%E0%A6%9F%E0%A7%8B%E0%A6%AE%E0%A7%8B%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A6%B8%E0%A7%87%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>ইন্টেলের বিরুদ্ধে মামলা করলেন বিনিয়োগকারীরা</title>
      <link>https://www.deshrupantor.com/735753/%E0%A6%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AC%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%8B%E0%A6%97%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%B0%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735753/%E0%A6%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AC%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%8B%E0%A6%97%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%B0%E0%A6%BE</guid>
      <pubDate>Tue, 17 Nov 2026 00:34:18 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2023/11/01/756bedac712941f47eb46b3a34b88636-6541866731238.png?jadewits_media_id=9" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2023/11/01/756bedac712941f47eb46b3a34b88636-6541866731238.png?jadewits_media_id=9" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2023/11/01/756bedac712941f47eb46b3a34b88636-6541866731238.png?jadewits_media_id=9" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইন্টেলের বিরুদ্ধে মামলা করলেন বিনিয়োগকারীরা" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাষ্ট্রের শীর্ষস্থানীয় চিপ নির্মাতা প্রতিষ্ঠান ইন্টেলের বিরুদ্ধে প্রতারণার অভিযোগে মামলা করেছেন বিনিয়োগকারীরা। ব্যক্তিগত কম্পিউটার (পিসি) বাজারে দীর্ঘদিনের মন্দা এবং অতিরিক্ত পণ্য মজুদের নেতিবাচক প্রভাব সম্পর্কে সময়মতো তথ্য প্রকাশ না করার অভিযোগ উঠেছে প্রতিষ্ঠানটির বিরুদ্ধে। এক দিনে কোম্পানিটির&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735753/%E0%A6%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AC%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%8B%E0%A6%97%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%B0%E0%A6%BE">দেশ রূপান্তর</source>

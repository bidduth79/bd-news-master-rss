    <item>
      <title>যুবদলকে শক্তিশালী করতে কুড়িগ্রামে মতবিনিময় সভা</title>
      <link>https://www.deshrupantor.com/738171/%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A6%95%E0%A7%87-%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B6%E0%A6%BE%E0%A6%B2%E0%A7%80-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A7%81%E0%A7%9C%E0%A6%BF%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%AE%E0%A6%A4%E0%A6%AC%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A6%AE%E0%A7%9F-%E0%A6%B8%E0%A6%AD%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/738171/%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A6%95%E0%A7%87-%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B6%E0%A6%BE%E0%A6%B2%E0%A7%80-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A7%81%E0%A7%9C%E0%A6%BF%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%AE%E0%A6%A4%E0%A6%AC%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A6%AE%E0%A7%9F-%E0%A6%B8%E0%A6%AD%E0%A6%BE</guid>
      <pubDate>Thu, 26 Nov 2026 20:38:19 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/420da0cc1e54b3dd50c6f621f98935ee-6b0844493ea3e.jpg?jadewits_media_id=245436" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/420da0cc1e54b3dd50c6f621f98935ee-6b0844493ea3e.jpg?jadewits_media_id=245436" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/420da0cc1e54b3dd50c6f621f98935ee-6b0844493ea3e.jpg?jadewits_media_id=245436" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যুবদলকে শক্তিশালী করতে কুড়িগ্রামে মতবিনিময় সভা" /&gt;&lt;/p&gt;&lt;p&gt;যুবদলকে আরও গতিশীল, সুশৃঙ্খল ও শক্তিশালী সংগঠন হিসেবে গড়ে তোলার লক্ষ্যে কুড়িগ্রামে মতবিনিময় সভা অনুষ্ঠিত হয়েছে।&amp;nbsp;
বৃহস্পতিবার (২৬ নভেম্বর) দুপুরে কেন্দ্রীয় কমিটির সিদ্ধান্ত অনুযায়ী জেলা যুবদল এ সভার আয়োজন করে। সভায় জেলা যুবদলের নেতাদের পাশাপাশি জেলার অধীন ১২টি ইউনিটের সুপার ফাইভের নেতারা উপস্থিত&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/738171/%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A6%95%E0%A7%87-%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B6%E0%A6%BE%E0%A6%B2%E0%A7%80-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A7%81%E0%A7%9C%E0%A6%BF%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%AE%E0%A6%A4%E0%A6%AC%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A6%AE%E0%A7%9F-%E0%A6%B8%E0%A6%AD%E0%A6%BE">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>র‌্যাংগসএক্সের নতুন ইলেকট্রিক স্কুটার ব্র্যান্ড আরএক্স উন্মোচন</title>
      <link>https://www.deshrupantor.com/738170/%E0%A6%B0%E2%80%8C%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%97%E0%A6%B8%E0%A6%8F%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%87%E0%A6%B2%E0%A7%87%E0%A6%95%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/738170/%E0%A6%B0%E2%80%8C%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%97%E0%A6%B8%E0%A6%8F%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%87%E0%A6%B2%E0%A7%87%E0%A6%95%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1</guid>
      <pubDate>Thu, 26 Nov 2026 20:41:02 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/80b95496deadcd413f074ff8d14a1849-6b0843f9f1219.jpg?jadewits_media_id=245435" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/80b95496deadcd413f074ff8d14a1849-6b0843f9f1219.jpg?jadewits_media_id=245435" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/80b95496deadcd413f074ff8d14a1849-6b0843f9f1219.jpg?jadewits_media_id=245435" style="max-width:100%;height:auto;margin-bottom:10px;" alt="র‌্যাংগসএক্সের নতুন ইলেকট্রিক স্কুটার ব্র্যান্ড আরএক্স উন্মোচন" /&gt;&lt;/p&gt;&lt;p&gt;দেশের বাজারে নতুন ইলেকট্রিক টু-হুইলার ব্র্যান্ড ‘আরএক্স’ উন্মোচন করেছে র‌্যাংগসএক্স। বৃহস্পতিবার (২৬ নভেম্বর) রাজধানীর আন্তর্জাতিক কনভেনশন সিটি বসুন্ধরায় (আইসিসিবি) শুরু হওয়া তিন দিনব্যাপী বাংলাদেশ ইলেকট্রিক ভেহিকেল অ্যান্ড মোবিলিটি এক্সিবিশন (বিইভিএমএক্স) ২০২৬-এ ব্র্যান্ডটির আনুষ্ঠানিক যাত্রা শুরু &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/738170/%E0%A6%B0%E2%80%8C%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%97%E0%A6%B8%E0%A6%8F%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%87%E0%A6%B2%E0%A7%87%E0%A6%95%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1">দেশ রূপান্তর</source>

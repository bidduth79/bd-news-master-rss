    <item>
      <title>জিয়াউল আহসান ‘মনস্টার’</title>
      <link>https://www.deshrupantor.com/737734/%E0%A6%9C%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%89%E0%A6%B2-%E0%A6%86%E0%A6%B9%E0%A6%B8%E0%A6%BE%E0%A6%A8-%E2%80%98%E0%A6%AE%E0%A6%A8%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0%E2%80%99</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/737734/%E0%A6%9C%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%89%E0%A6%B2-%E0%A6%86%E0%A6%B9%E0%A6%B8%E0%A6%BE%E0%A6%A8-%E2%80%98%E0%A6%AE%E0%A6%A8%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0%E2%80%99</guid>
      <pubDate>Wed, 25 Nov 2026 07:42:16 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/6c42e56368015a28e6a4c5ccec81f3c9-6b063cf28fcee.jpg?jadewits_media_id=245029" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/6c42e56368015a28e6a4c5ccec81f3c9-6b063cf28fcee.jpg?jadewits_media_id=245029" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/6c42e56368015a28e6a4c5ccec81f3c9-6b063cf28fcee.jpg?jadewits_media_id=245029" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জিয়াউল আহসান ‘মনস্টার’" /&gt;&lt;/p&gt;&lt;p&gt;শতাধিক গুম-খুনের অভিযোগে মানবতাবিরোধী অপরাধে অভিযুক্ত সাবেক সেনা কর্মকর্তা জিয়াউল আহসানের বিরুদ্ধে প্রসিকিউশনের যুক্তিতর্কের শুনানি শুরু হয়েছে। গতকাল মঙ্গলবার আন্তর্জাতিক অপরাধ ট্রাইব্যুনাল-১ এ শুনানি করেন চিফ প্রসিকিউটর মো. আমিনুল ইসলাম। এদিন শুনানিতে জিয়াউল আহসানকে &amp;lsquo;মনস্টার&amp;rsquo; বা দানব উল&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/737734/%E0%A6%9C%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%89%E0%A6%B2-%E0%A6%86%E0%A6%B9%E0%A6%B8%E0%A6%BE%E0%A6%A8-%E2%80%98%E0%A6%AE%E0%A6%A8%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0%E2%80%99">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>হারিয়ে যাচ্ছে বৈরালি</title>
      <link>https://www.deshrupantor.com/737733/%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%AC%E0%A7%88%E0%A6%B0%E0%A6%BE%E0%A6%B2%E0%A6%BF</link>

    <item>
      <title>কেরানিগঞ্জে বেকারি মালিকের লাখ টাকা জরিমানা</title>
      <link>https://www.deshrupantor.com/736215/%E0%A6%95%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AC%E0%A7%87%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%9C%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736215/%E0%A6%95%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AC%E0%A7%87%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%9C%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%BE</guid>
      <pubDate>Wed, 18 Nov 2026 21:58:37 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/3ed34dafbe49e09075441ea04046182d-6afdcafc57ee5.gif?jadewits_media_id=243596" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/3ed34dafbe49e09075441ea04046182d-6afdcafc57ee5.gif?jadewits_media_id=243596" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/3ed34dafbe49e09075441ea04046182d-6afdcafc57ee5.gif?jadewits_media_id=243596" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কেরানিগঞ্জে বেকারি মালিকের লাখ টাকা জরিমানা" /&gt;&lt;/p&gt;&lt;p&gt;ঢাকার কেরানীগঞ্জে অস্বাস্থ্যকর পরিবেশে খাদ্যপণ্য তৈরি ও সংরক্ষণসহ বিভিন্ন অনিয়মের দায়ে শৈলী বেকারি অ্যান্ড দাদু কনফেকশনারি মালিককে ১ লাখ টাকা জরিমানা করেছেন ভ্রাম্যমাণ আদালত।
বুধবার (১৮ নভেম্বর) আমীরাবাগের ৬ নম্বর ওয়ার্ডে অবস্থিত ওই ব্যবসা প্রতিষ্ঠানটিতে অভিযান পরিচালনা করেন নির্বাহী ম্যাজিস্ট্রেট অ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/736215/%E0%A6%95%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AC%E0%A7%87%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%9C%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%BE">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>আদীশ্বর ঘটক : বাংলা আলোকচিত্রের বিস্মৃত অগ্রদূত</title>
      <link>https://www.deshrupantor.com/736210/adishwar-ghatak-a-forgotten-pioneer-of-bengali</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/736210/adishwar-ghatak-a-forgotten-pioneer-of-bengali</guid>
      <pubDate>Wed, 18 Nov 2026 22:02:26 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/b1fdd2af756538154fa0572c67155d8b-6afdcacd3ada6.jpg?jadewits_media_id=243595" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/b1fdd2af756538154fa0572c67155d8b-6afdcacd3ada6.jpg?jadewits_media_id=243595" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/b1fdd2af756538154fa0572c67155d8b-6afdcacd3ada6.jpg?jadewits_media_id=243595" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আদীশ্বর ঘটক : বাংলা আলোকচিত্রের বিস্মৃত অগ্রদূত" /&gt;&lt;/p&gt;&lt;p&gt;ক্যামেরার কারিগরি বিদ্যাকে মাতৃভাষায় সাধারণ মানুষের কাছে পৌঁছে দেওয়ার উদ্যোগ নিয়েছিলেন আদীশ্বর ঘটক। বাংলা ভাষায় আলোকচিত্রবিষয়ক প্রথম বই ফটোগ্রাফী শিক্ষার রচয়িতা তিনি। ছবি আঁকা শেখার প্রথম বাংলা বই চিত্রবিদ্যারও লেখক আদীশ্বর।						বিস্তারিত&lt;/p&gt;</description>

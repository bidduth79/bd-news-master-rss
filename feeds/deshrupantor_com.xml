      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/20d7ac678b6380d3e67ca056214e9c58-6af7bb133089f.jpg?jadewits_media_id=242382" length="0" type="image/jpeg" />

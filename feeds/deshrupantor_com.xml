      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/9d11e2f4746d912916e683082ab6b08b-6af4393e54910.gif?jadewits_media_id=241755" length="0" type="image/jpeg" />

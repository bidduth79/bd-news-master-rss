      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/09/14/5d69c5fcb96d375cd539ca3b96d258aa-6aa7aceeb926e.jpeg?jadewits_media_id=228202" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/09/14/5d69c5fcb96d375cd539ca3b96d258aa-6aa7aceeb926e.jpeg?jadewits_media_id=228202" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/09/14/5d69c5fcb96d375cd539ca3b96d258aa-6aa7aceeb926e.jpeg?jadewits_media_id=228202" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সংসদে শব্দচয়ন ও আচরণ নিয়ে স্পিকারের সতর্কবার্তা" /&gt;&lt;/p&gt;&lt;p&gt;জাতীয় সংসদে সদস্যদের বক্তব্যে শব্দচয়ন ও আচরণ নিয়ে সতর্ক করেছেন স্পিকার হাফিজ উদ্দিন আহমদ বীর বিক্রম। সংসদের মর্যাদা ক্ষুণ্ন হয়, এমন আচরণ না করতে সদস্যদের প্রতি আহ্বান জানিয়েছেন তিনি। কোনো সদস্যের বক্তব্যে আপত্তিকর শব্দ থাকলে তা কার্যবিবরণী থেকে বাদ দেওয়া হবে এবং প্রয়োজন হলে সংশ্লিষ্ট সদস্যকে জবাব দে&lt;/p&gt;</description>

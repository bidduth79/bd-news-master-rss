    <item>
      <title>গোবিন্দগঞ্জে ধানখেতে কারেন্ট পোকার উপদ্রব, বিপাকে কৃষক</title>
      <link>https://www.deshrupantor.com/734892/%E0%A6%97%E0%A7%8B%E0%A6%AC%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%96%E0%A7%87%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F-%E0%A6%AA%E0%A7%8B%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%89%E0%A6%AA%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A6%AC-%C2%A0%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A7%87</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/734892/%E0%A6%97%E0%A7%8B%E0%A6%AC%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%96%E0%A7%87%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F-%E0%A6%AA%E0%A7%8B%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%89%E0%A6%AA%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A6%AC-%C2%A0%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A7%87</guid>
      <pubDate>Fri, 13 Nov 2026 20:02:34 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/a61e7929cfef0c07d57a997209acc893-6af7144724096.gif?jadewits_media_id=242275" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/a61e7929cfef0c07d57a997209acc893-6af7144724096.gif?jadewits_media_id=242275" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/a61e7929cfef0c07d57a997209acc893-6af7144724096.gif?jadewits_media_id=242275" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গোবিন্দগঞ্জে ধানখেতে কারেন্ট পোকার উপদ্রব, বিপাকে কৃষক" /&gt;&lt;/p&gt;&lt;p&gt;গাইবান্ধার গোবিন্দগঞ্জ উপজেলায় আমন ধান পাকার শেষ মুহূর্তে খেতে বাদামি গাছ ফড়িংয়ের (কারেন্ট পোকা) উপদ্রব দেখা দিয়েছে। এতে ধানগাছ মরে যাচ্ছে। এ কারণে পুরোপুরি পাকার আগেই অনেক কৃষক ধান কেটে ঘরে তুলছেন।
কৃষকরা জানান, খেতে কারেন্ট পোকার উপদ্রব দেখা দেওয়ায় গাছ পুড়ে যাওয়ার রং ধারণ করে মরে যাচ্ছে। এ কারণে অ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734892/%E0%A6%97%E0%A7%8B%E0%A6%AC%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%96%E0%A7%87%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F-%E0%A6%AA%E0%A7%8B%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%89%E0%A6%AA%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A6%AC-%C2%A0%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A7%87">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>জেব্রার বিনিময়ে চট্টগ্রাম থেকে তিন বাঘ আনল সাফারি পার্ক</title>

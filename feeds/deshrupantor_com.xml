      <guid isPermaLink="true">https://www.deshrupantor.com/734236/%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF-%E0%A6%AA%E0%A7%82%E0%A6%B0%E0%A6%A3-%E0%A6%A8%E0%A6%BE-%E0%A6%B9%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%B8%E0%A6%BE%E0%A6%9C%E0%A7%87%E0%A6%95-%E0%A6%85%E0%A6%AC%E0%A6%B0%E0%A7%8B%E0%A6%A7-%E0%A6%9A%E0%A6%B2%E0%A6%AC%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A7%81%E0%A6%A7%E0%A6%A8</guid>
      <pubDate>Wed, 11 Nov 2026 02:29:01 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/bc246fbbdb3feacd66d73ec89f18e513-6af37dfd671ed.jpg?jadewits_media_id=241685" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/bc246fbbdb3feacd66d73ec89f18e513-6af37dfd671ed.jpg?jadewits_media_id=241685" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/bc246fbbdb3feacd66d73ec89f18e513-6af37dfd671ed.jpg?jadewits_media_id=241685" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দাবি পূরণ না হওয়া পর্যন্ত সাজেক অবরোধ চলবে: বাবুধন চাকমা" /&gt;&lt;/p&gt;&lt;p&gt;রাঙামাটির বাঘাইছড়ি উপজেলার সাজেকে পাঁচ দফা দাবি পূরণ না হওয়া পর্যন্ত অবরোধ কর্মসূচি অব্যাহত রাখার ঘোষণা দিয়েছে সাজেক পর্যটন সড়ক অবরোধ বাস্তবায়ন গণকমিটি। একই সঙ্গে ষড়যন্ত্র ও অপপ্রচারে বিভ্রান্ত না হয়ে চলমান আন্দোলন সফল করতে সাজেকবাসীর প্রতি আহ্বান জানিয়েছেন কমিটির আহ্বায়ক বাবুধন চাকমা।
মঙ্গলবার (১০ &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/734236/%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF-%E0%A6%AA%E0%A7%82%E0%A6%B0%E0%A6%A3-%E0%A6%A8%E0%A6%BE-%E0%A6%B9%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%B8%E0%A6%BE%E0%A6%9C%E0%A7%87%E0%A6%95-%E0%A6%85%E0%A6%AC%E0%A6%B0%E0%A7%8B%E0%A6%A7-%E0%A6%9A%E0%A6%B2%E0%A6%AC%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A7%81%E0%A6%A7%E0%A6%A8">দেশ রূপান্তর</source>

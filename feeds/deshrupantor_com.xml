      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/7e4a2551cddbbd5701578ff16e2b3be2-6b08892bc492f.jpg?jadewits_media_id=245512" length="0" type="image/jpeg" />

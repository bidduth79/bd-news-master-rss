      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/5960516a96143c0f861dd64dbcdf8cf6-6af8c01384e4a.jpg?jadewits_media_id=242638" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শুরু হচ্ছে তিন দিনব্যাপী ‘গ্লোবাল সোর্সিং এক্সপো" /&gt;&lt;/p&gt;&lt;p&gt;দেশের রপ্তানি সম্ভাবনা তুলে ধরা এবং আন্তর্জাতিক বাজারে বাংলাদেশি পণ্যের প্রসার ঘটাতে আজ থেকে শুরু হচ্ছে তিন দিনব্যাপী &amp;lsquo;গ্লোবাল সোর্সিং এক্সপো ২০২৬ ঢাকা&amp;rsquo;। রাজধানীর পূর্বাচলে বাংলাদেশ-চায়না ফ্রেন্ডশিপ এক্সিবিশন সেন্টারে দ্বিতীয়বারের মতো এ বাণিজ্য মন্ত্রণালয় ও রপ্তানি উন্নয়ন ব্যুরো এ মেলার &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735222/%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AA%E0%A7%80-%E2%80%98%E0%A6%97%E0%A7%8D%E0%A6%B2%E0%A7%8B%E0%A6%AC%E0%A6%BE%E0%A6%B2-%E0%A6%B8%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%B8%E0%A6%BF%E0%A6%82-%E0%A6%8F%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%AA%E0%A7%8B">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>১৮ নভেম্বর শিল্পকলায় স্মরণানুষ্ঠান</title>
      <link>https://www.deshrupantor.com/735221/%E0%A7%A7%E0%A7%AE-%E0%A6%A8%E0%A6%AD%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%B6%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A6%95%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%B8%E0%A7%8D%E0%A6%AE%E0%A6%B0%E0%A6%A3%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735221/%E0%A7%A7%E0%A7%AE-%E0%A6%A8%E0%A6%AD%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%B6%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A6%95%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%B8%E0%A7%8D%E0%A6%AE%E0%A6%B0%E0%A6%A3%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A8</guid>
      <pubDate>Sun, 15 Nov 2026 02:09:37 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/da78508c3c15d01d6afe4a7ddcb486b7-6af8bff976b85.jpg?jadewits_media_id=242637" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/da78508c3c15d01d6afe4a7ddcb486b7-6af8bff976b85.jpg?jadewits_media_id=242637" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/da78508c3c15d01d6afe4a7ddcb486b7-6af8bff976b85.jpg?jadewits_media_id=242637" style="max-width:100%;height:auto;margin-bottom:10px;" alt="১৮ নভেম্বর শিল্পকলায় স্মরণানুষ্ঠান" /&gt;&lt;/p&gt;&lt;p&gt;প্রখ্যাত সংগীতশিল্পী ও বংশীবাদক বারী সিদ্দিকীর ৭২তম জন্মবার্ষিকী উপলক্ষে বাংলাদেশ শিল্পকলা একাডেমি এক বর্ণাঢ্য স্মরণানুষ্ঠানের আয়োজন করেছে। আগামী ১৮ নভেম্বর বুধবার বিকেল ৫টায় শিল্পকলা একাডেমির সংগীত ও নৃত্যকলা মিলনায়তনে এই আয়োজন করবে বারী সিদ্দিকী স্মৃতি পরিষদ।
গ্রামীণ লোকসংগীত ও আধ্যাত্মিক ধারার গা&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735221/%E0%A7%A7%E0%A7%AE-%E0%A6%A8%E0%A6%AD%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%B6%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A6%95%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%B8%E0%A7%8D%E0%A6%AE%E0%A6%B0%E0%A6%A3%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A8">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>বাংলা চলচ্চিত্রের অমর অভিনেতা সৌমিত্র</title>
      <link>https://www.deshrupantor.com/735220/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE-%E0%A6%9A%E0%A6%B2%E0%A6%9A%E0%A7%8D%E0%A6%9A%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AE%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%B8%E0%A7%8C%E0%A6%AE%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735220/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE-%E0%A6%9A%E0%A6%B2%E0%A6%9A%E0%A7%8D%E0%A6%9A%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AE%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%B8%E0%A7%8C%E0%A6%AE%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%B0</guid>
      <pubDate>Sun, 15 Nov 2026 02:09:00 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/5319da73e3940d702a170e107db1934c-6af8bfd2985d6.jpg?jadewits_media_id=242636" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/5319da73e3940d702a170e107db1934c-6af8bfd2985d6.jpg?jadewits_media_id=242636" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/5319da73e3940d702a170e107db1934c-6af8bfd2985d6.jpg?jadewits_media_id=242636" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাংলা চলচ্চিত্রের অমর অভিনেতা সৌমিত্র" /&gt;&lt;/p&gt;&lt;p&gt;সৌমিত্র চট্টোপাধ্যায় ছিলেন বহুমুখী প্রতিভার এক অনন্য নাম। ৬০ বছরেরও বেশি সময় রুপালি পর্দায় দাপিয়ে বেড়ানো এই কিংবদন্তি ২০২০ সালের আজকের দিনে চলে যান না ফেরার দেশে
সৌমিত্র চট্টোপাধ্যায় ছিলেন বহুমুখী প্রতিভার এক অনন্য নাম। নায়ক হিসেবে যেমন সাবলীল, খলচরিত্রেও ছিলেন সমান প্রাণোচ্ছল। ৬০ বছরেরও বেশি সময় ধর&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735220/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE-%E0%A6%9A%E0%A6%B2%E0%A6%9A%E0%A7%8D%E0%A6%9A%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AE%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%B8%E0%A7%8C%E0%A6%AE%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%B0">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>তানজিল মিসবাহর ‘কন্যা’</title>
      <link>https://www.deshrupantor.com/735219/%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%9C%E0%A6%BF%E0%A6%B2-%E0%A6%AE%E0%A6%BF%E0%A6%B8%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%B0-%E2%80%98%E0%A6%95%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E2%80%99</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735219/%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%9C%E0%A6%BF%E0%A6%B2-%E0%A6%AE%E0%A6%BF%E0%A6%B8%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%B0-%E2%80%98%E0%A6%95%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E2%80%99</guid>
      <pubDate>Sun, 15 Nov 2026 02:08:20 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/26b9e772dadb5f2cd8cfb09091a1eb23-6af8bf909234e.jpg?jadewits_media_id=242635" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/26b9e772dadb5f2cd8cfb09091a1eb23-6af8bf909234e.jpg?jadewits_media_id=242635" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/26b9e772dadb5f2cd8cfb09091a1eb23-6af8bf909234e.jpg?jadewits_media_id=242635" style="max-width:100%;height:auto;margin-bottom:10px;" alt="তানজিল মিসবাহর ‘কন্যা’" /&gt;&lt;/p&gt;&lt;p&gt;ভালোবাসার মানুষের বিয়ে ও এক প্রেমিকের নিঃশব্দ কান্নার বেদনাবিধুর গল্প নিয়ে প্রকাশিত হয়েছে তরুণ সংগীতশিল্পী তানজিল মিসবাহর নতুন গান &amp;lsquo;কন্যা&amp;rsquo;। গানটির কথা, সুর ও কণ্ঠ দিয়েছেন শিল্পী নিজেই। এর সংগীতায়োজন করেছেন শোভন রায়।
প্রেম, বিচ্ছেদ ও প্রিয়জনকে হারানোর অসহায়ত্বের এই গানটির সঙ্গে সামঞ্জস্য &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735219/%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%9C%E0%A6%BF%E0%A6%B2-%E0%A6%AE%E0%A6%BF%E0%A6%B8%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%B0-%E2%80%98%E0%A6%95%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E2%80%99">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>প্রকাশ হলো জয় শাহরিয়ারের পঞ্চম একক অ্যালবাম ‘বোকা’</title>
      <link>https://www.deshrupantor.com/735218/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B6-%E0%A6%B9%E0%A6%B2%E0%A7%8B-%E0%A6%9C%E0%A7%9F-%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%AE-%E0%A6%8F%E0%A6%95%E0%A6%95-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A6%AE-%E2%80%98%E0%A6%AC%E0%A7%8B%E0%A6%95%E0%A6%BE%E2%80%99</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735218/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B6-%E0%A6%B9%E0%A6%B2%E0%A7%8B-%E0%A6%9C%E0%A7%9F-%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%AE-%E0%A6%8F%E0%A6%95%E0%A6%95-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A6%AE-%E2%80%98%E0%A6%AC%E0%A7%8B%E0%A6%95%E0%A6%BE%E2%80%99</guid>
      <pubDate>Sun, 15 Nov 2026 02:07:18 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/b0679c102cfdc9299c3bcd77e0251a28-6af8bf6f97448.jpg?jadewits_media_id=242634" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/b0679c102cfdc9299c3bcd77e0251a28-6af8bf6f97448.jpg?jadewits_media_id=242634" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/b0679c102cfdc9299c3bcd77e0251a28-6af8bf6f97448.jpg?jadewits_media_id=242634" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রকাশ হলো জয় শাহরিয়ারের পঞ্চম একক অ্যালবাম ‘বোকা’" /&gt;&lt;/p&gt;&lt;p&gt;দীর্ঘ সাত বছরের বিরতি ভেঙে শ্রোতাদের মধ্যে একক অ্যালবাম নিয়ে ফিরলেন সংগীতশিল্পী জয় শাহরিয়ার। গত শুক্রবার রাজধানীর ই এম কে সেন্টারে জমকালো আয়োজনের মধ্য দিয়ে প্রকাশ পেল শিল্পীর পঞ্চম একক স্টুডিও অ্যালবাম &amp;lsquo;বোকা&amp;rsquo;।
অ্যালবামটির মোড়ক উন্মোচন করেন দেশের বরেণ্য গীতিকবি শহীদ মাহমুদ জঙ্গী, বাংলা রক&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735218/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B6-%E0%A6%B9%E0%A6%B2%E0%A7%8B-%E0%A6%9C%E0%A7%9F-%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%AE-%E0%A6%8F%E0%A6%95%E0%A6%95-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A6%AE-%E2%80%98%E0%A6%AC%E0%A7%8B%E0%A6%95%E0%A6%BE%E2%80%99">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>বক্স অফিসে হাজার কোটি পার ‘রামায়ণ’ নির্মাণে ব্যয় কত?</title>
      <link>https://www.deshrupantor.com/735217/%E0%A6%AC%E0%A6%95%E0%A7%8D%E0%A6%B8-%E0%A6%85%E0%A6%AB%E0%A6%BF%E0%A6%B8%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%AA%E0%A6%BE%E0%A6%B0-%E2%80%98%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A6%A3%E2%80%99-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%BE%E0%A6%A3%E0%A7%87-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A7%9F</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735217/%E0%A6%AC%E0%A6%95%E0%A7%8D%E0%A6%B8-%E0%A6%85%E0%A6%AB%E0%A6%BF%E0%A6%B8%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%AA%E0%A6%BE%E0%A6%B0-%E2%80%98%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A6%A3%E2%80%99-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%BE%E0%A6%A3%E0%A7%87-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A7%9F</guid>
      <pubDate>Sun, 15 Nov 2026 02:06:41 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/d662f9b39150b1a061885b798a1b9ed6-6af8bf4b31e16.jpg?jadewits_media_id=242632" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/d662f9b39150b1a061885b798a1b9ed6-6af8bf4b31e16.jpg?jadewits_media_id=242632" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/d662f9b39150b1a061885b798a1b9ed6-6af8bf4b31e16.jpg?jadewits_media_id=242632" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বক্স অফিসে হাজার কোটি পার ‘রামায়ণ’ নির্মাণে ব্যয় কত?" /&gt;&lt;/p&gt;&lt;p&gt;বিশ্বজুড়ে বক্স অফিসে ১ হাজার ১০০ কোটি রুপি আয়ের মাইলফলক অতিক্রম করেছে রণবীর কাপুর ও যশ অভিনীত সিনেমা &amp;lsquo;রামায়ণ&amp;rsquo;। মুক্তির নবম দিনে সিনেমাটির আয় দাঁড়িয়েছে ১ হাজার ১১০ কোটি ৭০ লাখ রুপি। তবে দুই পর্বের সিনেমাটি নির্মাণে সম্মিলিত বাজেট প্রায় ৪ হাজার কোটি রুপি।
নিতেশ তিওয়ারি পরিচালিত সিনেমাটিতে &lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735217/%E0%A6%AC%E0%A6%95%E0%A7%8D%E0%A6%B8-%E0%A6%85%E0%A6%AB%E0%A6%BF%E0%A6%B8%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%AA%E0%A6%BE%E0%A6%B0-%E2%80%98%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A6%A3%E2%80%99-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%BE%E0%A6%A3%E0%A7%87-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A7%9F">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>ধারাবাহিকে ফিরলেন সানজিদা প্রীতি</title>
      <link>https://www.deshrupantor.com/735216/%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%95%E0%A7%87-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%B8%E0%A6%BE%E0%A6%A8%E0%A6%9C%E0%A6%BF%E0%A6%A6%E0%A6%BE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%A4%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735216/%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%95%E0%A7%87-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%B8%E0%A6%BE%E0%A6%A8%E0%A6%9C%E0%A6%BF%E0%A6%A6%E0%A6%BE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%A4%E0%A6%BF</guid>
      <pubDate>Sun, 15 Nov 2026 02:06:07 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/81c42235821013f734033431e44e5de4-6af8bf266043b.jpg?jadewits_media_id=242631" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/81c42235821013f734033431e44e5de4-6af8bf266043b.jpg?jadewits_media_id=242631" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/81c42235821013f734033431e44e5de4-6af8bf266043b.jpg?jadewits_media_id=242631" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ধারাবাহিকে ফিরলেন সানজিদা প্রীতি" /&gt;&lt;/p&gt;&lt;p&gt;ছোট পর্দায় একসময় নিয়মিত অভিনয় করে দর্শকের প্রশংসা পেয়েছেন সানজিদা প্রীতি। ওটিটি প্ল্যাটফর্মেও নিজের অভিনয়দক্ষতার স্বাক্ষর রেখেছেন তিনি। তবে ব্যক্তিগত ব্যস্ততায় দীর্ঘদিন অভিনয় থেকে দূরে ছিলেন এই অভিনেত্রী। প্রায় দুই বছরের বিরতি ভেঙে নতুন ধারাবাহিক নাটক নিয়ে ফিরেছেন তিনি।
তানভীর তন্ময় পরিচালিত &amp;lsquo;&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735216/%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%95%E0%A7%87-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%B8%E0%A6%BE%E0%A6%A8%E0%A6%9C%E0%A6%BF%E0%A6%A6%E0%A6%BE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%A4%E0%A6%BF">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>মার্গট রবির নতুন সিনেমা ‘দ্য উইক অব পেইন’</title>
      <link>https://www.deshrupantor.com/735215/%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%97%E0%A6%9F-%E0%A6%B0%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%AE%E0%A6%BE-%E2%80%98%E0%A6%A6%E0%A7%8D%E0%A6%AF-%E0%A6%89%E0%A6%87%E0%A6%95-%E0%A6%85%E0%A6%AC-%E0%A6%AA%E0%A7%87%E0%A6%87%E0%A6%A8%E2%80%99</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735215/%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%97%E0%A6%9F-%E0%A6%B0%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%AE%E0%A6%BE-%E2%80%98%E0%A6%A6%E0%A7%8D%E0%A6%AF-%E0%A6%89%E0%A6%87%E0%A6%95-%E0%A6%85%E0%A6%AC-%E0%A6%AA%E0%A7%87%E0%A6%87%E0%A6%A8%E2%80%99</guid>
      <pubDate>Sun, 15 Nov 2026 02:05:33 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/8ed8da23fa01049411fa8a70226a0f1c-6af8bf0360a28.jpg?jadewits_media_id=242630" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/8ed8da23fa01049411fa8a70226a0f1c-6af8bf0360a28.jpg?jadewits_media_id=242630" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/8ed8da23fa01049411fa8a70226a0f1c-6af8bf0360a28.jpg?jadewits_media_id=242630" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মার্গট রবির নতুন সিনেমা ‘দ্য উইক অব পেইন’" /&gt;&lt;/p&gt;&lt;p&gt;হলিউড অভিনেত্রী মার্গট রবি নতুন একটি সিনেমায় যুক্ত হয়েছেন। &amp;lsquo;দ্য উইক অব পেইন&amp;rsquo; নামের ডার্ক কমেডি সিনেমাটি পরিচালনা করবেন নরওয়ের নির্মাতা ক্রিস্টোফার বর্গলি। তিনি এর আগে জেন্ডায়া ও রবার্ট প্যাটিনসন অভিনীত &amp;lsquo;দ্য ড্রামা&amp;rsquo; পরিচালনা করে আলোচনায় আসেন।
সিনেমাটি প্রযোজনা ও অর্থায়ন করবে এ&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735215/%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%97%E0%A6%9F-%E0%A6%B0%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%AE%E0%A6%BE-%E2%80%98%E0%A6%A6%E0%A7%8D%E0%A6%AF-%E0%A6%89%E0%A6%87%E0%A6%95-%E0%A6%85%E0%A6%AC-%E0%A6%AA%E0%A7%87%E0%A6%87%E0%A6%A8%E2%80%99">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>লাখ টাকা কামানোর বাস্তব সুযোগ</title>
      <link>https://www.deshrupantor.com/735214/%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%95%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8B%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%AC-%E0%A6%B8%E0%A7%81%E0%A6%AF%E0%A7%8B%E0%A6%97</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735214/%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%95%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8B%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%AC-%E0%A6%B8%E0%A7%81%E0%A6%AF%E0%A7%8B%E0%A6%97</guid>
      <pubDate>Sun, 15 Nov 2026 02:05:00 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/881086d096dcd2806a79e9a91d5577a5-6af8bee313fde.jpg?jadewits_media_id=242629" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/881086d096dcd2806a79e9a91d5577a5-6af8bee313fde.jpg?jadewits_media_id=242629" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/881086d096dcd2806a79e9a91d5577a5-6af8bee313fde.jpg?jadewits_media_id=242629" style="max-width:100%;height:auto;margin-bottom:10px;" alt="লাখ টাকা কামানোর বাস্তব সুযোগ" /&gt;&lt;/p&gt;&lt;p&gt;ব্যাংক কর্মকর্তার সুপ্রতিষ্ঠিত চাকরি ছেড়ে ২০১৯ সাল অর্থাৎ করোনার ঠিক আগের বছর থেকে মাশরুম চাষের ওপর প্রশিক্ষণ নেওয়া শুরু করেছিলেন এই উদ্যোক্তা। বর্তমানে তিনি মাশরুমের উৎপাদন, বিপণন, আধুনিকীকরণ ও যান্ত্রিকীকরণ, এই চারটি উইংস বা সেগমেন্ট নিয়ে বড় পরিসরে কাজ করছেন। ২০ বিঘা জমির ওপর রয়েছে তাদের বিশাল খাম&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735214/%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%95%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8B%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%AC-%E0%A6%B8%E0%A7%81%E0%A6%AF%E0%A7%8B%E0%A6%97">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>ইট-পাথরের শহরে টেরারিয়ামের গল্প</title>
      <link>https://www.deshrupantor.com/735213/%E0%A6%87%E0%A6%9F-%E0%A6%AA%E0%A6%BE%E0%A6%A5%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A6%B9%E0%A6%B0%E0%A7%87-%E0%A6%9F%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A6%B2%E0%A7%8D%E0%A6%AA</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735213/%E0%A6%87%E0%A6%9F-%E0%A6%AA%E0%A6%BE%E0%A6%A5%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A6%B9%E0%A6%B0%E0%A7%87-%E0%A6%9F%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A6%B2%E0%A7%8D%E0%A6%AA</guid>
      <pubDate>Sun, 15 Nov 2026 02:04:30 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/90d5e8d461e080b9976147dc1b94618d-6af8be9935c9f.jpg?jadewits_media_id=242628" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/90d5e8d461e080b9976147dc1b94618d-6af8be9935c9f.jpg?jadewits_media_id=242628" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/90d5e8d461e080b9976147dc1b94618d-6af8be9935c9f.jpg?jadewits_media_id=242628" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইট-পাথরের শহরে টেরারিয়ামের গল্প" /&gt;&lt;/p&gt;&lt;p&gt;ইট-পাথরের ব্যস্ত শহরে মানুষ যখন প্রকৃতির একটু ছোঁয়া পেতে ব্যাকুল, তখন ঘর বা অফিসের টেবিলে দীর্ঘমেয়াদে ইনডোর প্ল্যান্টের যত্ন&amp;nbsp; নেওয়া অনেকের জন্যই কঠিন হয়ে পড়ে। সেই ভাবনা থেকেই গড়ে উঠেছে একটি ব্যতিক্রমী উদ্যোগ, এক টুকরো জীবন্ত প্রকৃতিকে কাচের জারে আটকে নিয়ে আসা, যাকে বলা হয় টেরারিয়াম (Terrarium)&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735213/%E0%A6%87%E0%A6%9F-%E0%A6%AA%E0%A6%BE%E0%A6%A5%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A6%B9%E0%A6%B0%E0%A7%87-%E0%A6%9F%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A6%B2%E0%A7%8D%E0%A6%AA">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>রান্নাঘর থেকে আন্তর্জাতিক মঞ্চে</title>
      <link>https://www.deshrupantor.com/735212/%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A6%BE%E0%A6%98%E0%A6%B0-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%AE%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A7%87</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735212/%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A6%BE%E0%A6%98%E0%A6%B0-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%AE%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A7%87</guid>
      <pubDate>Sun, 15 Nov 2026 02:03:22 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/f7c2b6962c5d18dc4f98b35e93798957-6af8be84367ef.jpg?jadewits_media_id=242627" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/f7c2b6962c5d18dc4f98b35e93798957-6af8be84367ef.jpg?jadewits_media_id=242627" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/f7c2b6962c5d18dc4f98b35e93798957-6af8be84367ef.jpg?jadewits_media_id=242627" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রান্নাঘর থেকে আন্তর্জাতিক মঞ্চে" /&gt;&lt;/p&gt;&lt;p&gt;রান্না বা ফুড প্রিপারেশন প্রতিটি গৃহস্থালির অত্যন্ত পরিচিত অংশ হলেও উপযুক্ত প্রশিক্ষণ ও দক্ষতা কাজে লাগিয়ে এই খাত যে নারীদের স্বাবলম্বী হওয়ার সবচেয়ে চমৎকার ও নিরাপদ মাধ্যম হতে পারে, তা প্রমাণ করেছেন একজন দক্ষ অ্যাকাডেমিশিয়ান, কালিনারি এক্সপার্ট ও মাস্টার ট্রেইনার। ইংলিশ মিডিয়াম স্কুলের শিক্ষকতা পেশা&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735212/%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A6%BE%E0%A6%98%E0%A6%B0-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%AE%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A7%87">দেশ রূপান্তর</source>
    </item>
    <item>
      <title>করপোরেট ক্যারিয়ার থেকে উদ্যোক্তা</title>
      <link>https://www.deshrupantor.com/735211/%E0%A6%95%E0%A6%B0%E0%A6%AA%E0%A7%8B%E0%A6%B0%E0%A7%87%E0%A6%9F-%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.deshrupantor.com/735211/%E0%A6%95%E0%A6%B0%E0%A6%AA%E0%A7%8B%E0%A6%B0%E0%A7%87%E0%A6%9F-%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BE</guid>
      <pubDate>Sun, 15 Nov 2026 02:02:54 +0600</pubDate>
      <enclosure url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/fd78848f1b21a70abf6ee1f1bb3b02f9-6af8be643b2cc.jpg?jadewits_media_id=242626" length="0" type="image/jpeg" />
      <media:content url="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/fd78848f1b21a70abf6ee1f1bb3b02f9-6af8be643b2cc.jpg?jadewits_media_id=242626" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.deshrupantor.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/fd78848f1b21a70abf6ee1f1bb3b02f9-6af8be643b2cc.jpg?jadewits_media_id=242626" style="max-width:100%;height:auto;margin-bottom:10px;" alt="করপোরেট ক্যারিয়ার থেকে উদ্যোক্তা" /&gt;&lt;/p&gt;&lt;p&gt;গ্লোবাল মোবাইল ব্র্যান্ডে ১২ বছরেরও বেশি সময়ের অভিজ্ঞতা নিয়ে নতুন উদ্যোক্তা হিসেবে আন্তর্জাতিক ব্যবসায় আত্মপ্রকাশ করেছেন ওমর ফারুক। দীর্ঘ ১২ বছরেরও বেশি সময়ের করপোরেট ক্যারিয়ার। দেশের অন্যতম পরিচিত আন্তর্জাতিক মোবাইল ব্র্যান্ড OPPO, vivo I realme-এর মতো Global Brand-এর সঙ্গে কাজ করার অভিজ্ঞতা। Sales&lt;/p&gt;</description>
      <source url="https://www.deshrupantor.com/735211/%E0%A6%95%E0%A6%B0%E0%A6%AA%E0%A7%8B%E0%A6%B0%E0%A7%87%E0%A6%9F-%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BE">দেশ রূপান্তর</source>

    <item>
      <title>হায়ার বাংলাদেশের নতুন সিইও ফ্যান জিং</title>
      <link>https://www.newsbangla24.com/corporate/287930/%E0%A6%B9%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%B8%E0%A6%BF%E0%A6%87%E0%A6%93-%E0%A6%AB%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A6%9C%E0%A6%BF%E0%A6%82</link>

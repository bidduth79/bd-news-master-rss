    <item>
      <title>পিছিয়ে পড়েও সেল্টাকে হারাল রিয়াল</title>
      <link>https://www.newsbangla24.com/sports/288560/%E0%A6%AA%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%AA%E0%A6%A1%E0%A6%BC%E0%A7%87%E0%A6%93-%E0%A6%B8%E0%A7%87%E0%A6%B2%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%B2-%E0%A6%B0%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%B2</link>
      <guid isPermaLink="true">https://www.newsbangla24.com/sports/288560/%E0%A6%AA%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%AA%E0%A6%A1%E0%A6%BC%E0%A7%87%E0%A6%93-%E0%A6%B8%E0%A7%87%E0%A6%B2%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%B2-%E0%A6%B0%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%B2</guid>
      <pubDate>Sun, 22 Nov 2026 16:42:07 GMT</pubDate>
      <description>লা লিগায় সেল্টা ভিগোর বিপক্ষে পিছিয়ে পড়েও ২-১ গোলে জিতেছে রিয়াল মাদ্রিদ। সান্তিয়াগো বার্নাব্যুতে ম্যাচের শুরুতে লিড নিয়েছিল সেল্টা, প্রথমার্ধে কিলিয়ান এমবাপ্পের পেনাল্টি মিসও ছিল। দ্বিতীয়ার্ধে জুড বেলিংহ্যামের গোলে সমতা ফেরানোর পর বদলি নেমে জয়সূচক গোল করেন কার্লোস এসপি। এই জয়ে লা লিগার শীর</description>
      <source url="https://www.newsbangla24.com/sports/288560/%E0%A6%AA%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%AA%E0%A6%A1%E0%A6%BC%E0%A7%87%E0%A6%93-%E0%A6%B8%E0%A7%87%E0%A6%B2%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%B2-%E0%A6%B0%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%B2">newsbangla24.com</source>
    </item>
    <item>
      <title>৩৫২ রানের লিডের পর চাপে কিউইরা</title>
      <link>https://www.newsbangla24.com/sports/288559/%E0%A7%A9%E0%A7%AB%E0%A7%A8-%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B2%E0%A6%BF%E0%A6%A1%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%9A%E0%A6%BE%E0%A6%AA%E0%A7%87-%E0%A6%95%E0%A6%BF%E0%A6%89%E0%A6%87%E0%A6%B0%E0%A6%BE</link>

    <item>
      <title>১৬ ডিসেম্বর পর্যন্ত ‘ঢাকা-রিয়াদ’ রুটে বিমানের ফ্লাইট স্থগিত</title>
      <link>https://www.newsbangla24.com/national/288700/%E0%A7%A7%E0%A7%AC-%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A6-%E0%A6%B0%E0%A7%81%E0%A6%9F%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AB%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%9F-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%97%E0%A6%BF%E0%A6%A4</link>
      <guid isPermaLink="true">https://www.newsbangla24.com/national/288700/%E0%A7%A7%E0%A7%AC-%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A6-%E0%A6%B0%E0%A7%81%E0%A6%9F%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AB%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%9F-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%97%E0%A6%BF%E0%A6%A4</guid>
      <pubDate>Tue, 24 Nov 2026 22:37:59 GMT</pubDate>
      <description>যাত্রীদের নিরাপত্তার কথা চিন্তা করে ঢাকা-রিয়াদ রুটের নিয়মিত ফ্লাইট স্থগিত মেয়াদ আরো বাড়িয়েছে বাংলাদেশ বিমান এয়ারলাইন্স। নতুন সিদ্ধান্ত অনুযায়ী, আগামী ১৬ ডিসেম্বর (বাংলাদেশ সময়) পর্যন্ত এই রুটে ফ্লাইট চলাচল বন্ধ থাকবে। জানা যায়, সম্প্রতি সৌদি আরবে বোমা হামলার কারণে ফ্লাইট স্থগিত মেয়াদ বাড়িয়েছে এয়ারলা</description>
      <source url="https://www.newsbangla24.com/national/288700/%E0%A7%A7%E0%A7%AC-%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A6-%E0%A6%B0%E0%A7%81%E0%A6%9F%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AB%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%9F-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%97%E0%A6%BF%E0%A6%A4">newsbangla24.com</source>
    </item>

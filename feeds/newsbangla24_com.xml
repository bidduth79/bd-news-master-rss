    <item>
      <title>ইউক্রেন যুদ্ধের অবসান চান ট্রাম্প</title>
      <link>https://www.newsbangla24.com/international/287858/%E0%A6%87%E0%A6%89%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A8-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A6%BE%E0%A6%A8-%E0%A6%9A%E0%A6%BE%E0%A6%A8-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA</link>

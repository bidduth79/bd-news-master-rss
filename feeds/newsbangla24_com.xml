      <guid isPermaLink="true">https://www.newsbangla24.com/news/288729/%E0%A6%85%E0%A6%AC%E0%A6%B9%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%A7%E0%A7%8D%E0%A6%AC%E0%A6%82%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%B8%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A6%97%E0%A6%BE%E0%A6%81%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%90%E0%A6%A4%E0%A6%BF%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%95-%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A7%9C%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%81%E0%A6%95%E0%A6%B6%E0%A6%BE%E0%A6%B2</guid>
      <pubDate>Wed, 25 Nov 2026 17:39:26 GMT</pubDate>
      <description>প্রাচীন বাংলার মুদ্রা তৈরির ইতিহাসের গুরুত্বপূর্ণ সাক্ষী নারায়ণগঞ্জের সোনারগাঁয়ের ঐতিহাসিক ক্রোড়িবাড়ি টাঁকশাল। একসময় যে স্থাপনায় তৈরি ও সংরক্ষিত হতো মুদ্রা, কালের বিবর্তনে সেই স্থাপনাই এখন ধ্বংসের দ্বারপ্রান্তে। অযত্ন-অবহেলা, সংস্কারের অভাব এবং জমির মালিকানা নিয়ে বিরোধে হারিয়ে যেতে বসেছে কয়েক শতাব্দ</description>
      <source url="https://www.newsbangla24.com/news/288729/%E0%A6%85%E0%A6%AC%E0%A6%B9%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%A7%E0%A7%8D%E0%A6%AC%E0%A6%82%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%B8%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A6%97%E0%A6%BE%E0%A6%81%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%90%E0%A6%A4%E0%A6%BF%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%95-%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A7%9C%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%81%E0%A6%95%E0%A6%B6%E0%A6%BE%E0%A6%B2">newsbangla24.com</source>

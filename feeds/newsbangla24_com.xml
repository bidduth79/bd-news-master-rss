    <item>
      <title>এনআরবি ব্যাংকের ‘ক্যাশলেস বাংলাদেশ’ কর্মসূচি</title>
      <link>https://www.newsbangla24.com/corporate/288168/%E0%A6%8F%E0%A6%A8%E0%A6%86%E0%A6%B0%E0%A6%AC%E0%A6%BF-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B6%E0%A6%B2%E0%A7%87%E0%A6%B8-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%B8%E0%A7%82%E0%A6%9A%E0%A6%BF-</link>
      <guid isPermaLink="true">https://www.newsbangla24.com/corporate/288168/%E0%A6%8F%E0%A6%A8%E0%A6%86%E0%A6%B0%E0%A6%AC%E0%A6%BF-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B6%E0%A6%B2%E0%A7%87%E0%A6%B8-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%B8%E0%A7%82%E0%A6%9A%E0%A6%BF-</guid>
      <pubDate>Sun, 15 Nov 2026 22:07:28 GMT</pubDate>
      <description>কেন্দ্রীয় ব্যাংকের ক্যাশলেস বাংলাদেশ গড়ার লক্ষ্য বাস্তবায়নে সচেতনতা সৃষ্টির অংশ হিসেবে এনআরবি ব্যাংক গত ১১ নভেম্বর চট্টগ্রামের সাউদার্ন ইউনিভার্সিটি বাংলাদেশে ক্যাশলেস বাংলাদেশ বিষয়ক এক সচেতনতামূলক কর্মসূচির আয়োজন করে। শিক্ষার্থী, শিক্ষকসহ সংশ্লিষ্ট অংশীজনদের মধ্যে ডিজিটাল আর্থিক অন্তর্ভুক্তি, নগদবি</description>
      <source url="https://www.newsbangla24.com/corporate/288168/%E0%A6%8F%E0%A6%A8%E0%A6%86%E0%A6%B0%E0%A6%AC%E0%A6%BF-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B6%E0%A6%B2%E0%A7%87%E0%A6%B8-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%B8%E0%A7%82%E0%A6%9A%E0%A6%BF-">newsbangla24.com</source>
    </item>

      <guid isPermaLink="true">https://www.newsbangla24.com/national/287934/%E0%A6%95%E0%A6%AA%E0%A7%A9%E0%A7%A7-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%AA%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AD%E0%A6%BF%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%A8-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%A6%E0%A6%B0%E0%A7%8D%E0%A6%B6%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%B0%E0%A6%B9%E0%A6%AE%E0%A6%BE%E0%A6%A8</guid>
      <pubDate>Wed, 11 Nov 2026 22:16:38 GMT</pubDate>
      <description>তুরস্কের আন্তালিয়ায় জাতিসংঘের জলবায়ু পরিবর্তনবিষয়ক সম্মেলনে (কপ-৩১) বাংলাদেশ প্যাভিলিয়ন পরিদর্শন করেছেন প্রধানমন্ত্রী তারেক রহমান।
এ সময় তিনি প্যাভিলিয়নে প্রদর্শিত পরিবেশবান্ধব পাটজাত পণ্যের প্রদর্শনী ঘুরে দেখেন। পাশাপাশি পরিবেশ সংরক্ষণে বাংলাদেশের নেওয়া বিভিন্ন উদ্যোগের উপস্থাপনাও পর্যবেক্ষণ করেন।
</description>

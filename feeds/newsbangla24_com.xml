      <guid isPermaLink="true">https://www.newsbangla24.com/national/288642/%E0%A6%AA%E0%A6%BE%E0%A6%81%E0%A6%9A-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87-%E0%A6%8F%E0%A6%87%E0%A6%9A%E0%A6%86%E0%A6%87%E0%A6%AD%E0%A6%BF-%E0%A6%86%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80-%E0%A6%AC%E0%A7%87%E0%A7%9C%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%97%E0%A7%81%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%BF-</guid>
      <pubDate>Mon, 23 Nov 2026 22:51:29 GMT</pubDate>
      <description>দেশে নতুন করে এইচআইভি শনাক্ত ব্যক্তিদের মধ্যে শিক্ষার্থীর হার পাঁচ বছরের ব্যবধানে দ্বিগুণের বেশি বেড়েছে। ২০২১ সালে নতুন শনাক্তদের ৭ দশমিক ১৩ শতাংশ শিক্ষার্থী থাকলেও ২০২৫ সালে তা বেড়ে দাঁড়িয়েছে প্রায় ১৭ শতাংশে।
গত বছর দেশে নতুন করে এইচআইভি শনাক্ত হয়েছেন ১ হাজার ৮৯১ জন। তাদের মধ্যে ৩২১ জন শিক্ষার্থী। </description>

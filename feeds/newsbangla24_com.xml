    <item>
      <title>এপিক হেলথ কেয়ার ও ঢাকা ব্যাংকের মধ্যে সমঝোতা চুক্তি স্বাক্ষর</title>
      <link>https://www.newsbangla24.com/corporate/288363/%E0%A6%8F%E0%A6%AA%E0%A6%BF%E0%A6%95-%E0%A6%B9%E0%A7%87%E0%A6%B2%E0%A6%A5-%E0%A6%95%E0%A7%87%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%93-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%B8%E0%A6%AE%E0%A6%9D%E0%A7%8B%E0%A6%A4%E0%A6%BE-%E0%A6%9A%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%B0</link>

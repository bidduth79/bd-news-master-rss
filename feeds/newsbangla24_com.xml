    <item>
      <title>ইনজুরিতে ফ্রান্সের দল ছাড়লেন রিয়াল তারকা চুয়ামেনি</title>
      <link>https://www.newsbangla24.com/sports/287899/%E0%A6%87%E0%A6%A8%E0%A6%9C%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%B2-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B2-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A6%BE-%E0%A6%9A%E0%A7%81%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%A8%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.newsbangla24.com/sports/287899/%E0%A6%87%E0%A6%A8%E0%A6%9C%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%B2-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B2-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A6%BE-%E0%A6%9A%E0%A7%81%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%A8%E0%A6%BF</guid>
      <pubDate>Wed, 11 Nov 2026 16:19:53 GMT</pubDate>
      <description>ডান উরুর চোটের কারণে ফ্রান্স জাতীয় দলের স্কোয়াড থেকে ছিটকে গেছেন রিয়াল মাদ্রিদের মিডফিল্ডার অরেলিয়েন চুয়ামেনি। উরুতে অস্বস্তি অনুভব করায় চলমান আন্তর্জাতিক বিরতিতে ঝুঁকি না নিয়ে তাঁকে ক্লাবের কাছে ফেরত পাঠানোর সিদ্ধান্ত নিয়েছে ফ্রান্স ফুটবল ফেডারেশন (এফএফএফ)। ফলে উয়েফা নেশনস লিগে ফ্রান্সের আসন্ন দুটি</description>
      <source url="https://www.newsbangla24.com/sports/287899/%E0%A6%87%E0%A6%A8%E0%A6%9C%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%B2-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B2-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A6%BE-%E0%A6%9A%E0%A7%81%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%A8%E0%A6%BF">newsbangla24.com</source>

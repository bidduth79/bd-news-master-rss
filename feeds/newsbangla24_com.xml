    <item>
      <title>কৃষিঋণ বেড়েছে দ্বিগুণ, খেলাপি বেড়েছে সাড়ে তিন গুণের বেশি</title>
      <link>https://www.newsbangla24.com/economy/288267/%E0%A6%95%E0%A7%83%E0%A6%B7%E0%A6%BF%E0%A6%8B%E0%A6%A3-%E0%A6%AC%E0%A7%87%E0%A7%9C%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%97%E0%A7%81%E0%A6%A3-%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A6%AA%E0%A6%BF-%E0%A6%AC%E0%A7%87%E0%A7%9C%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A7%9C%E0%A7%87-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%97%E0%A7%81%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%BF</link>

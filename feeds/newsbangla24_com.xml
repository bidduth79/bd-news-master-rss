      <guid isPermaLink="true">https://www.newsbangla24.com/news/288062/%E0%A6%95%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%95%E0%A7%88%E0%A6%B0%E0%A7%87-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8B%E0%A6%AD-%E0%A6%93-%E0%A6%AD%E0%A6%BE%E0%A6%99%E0%A6%9A%E0%A7%81%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%A1-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A7%87%E0%A6%A1-%E0%A6%AE%E0%A7%87%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%B2-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%0D%0A</guid>
      <pubDate>Sat, 14 Nov 2026 12:09:33 GMT</pubDate>
      <description>পারিশ্রমিক বৃদ্ধির দাবিতে গাজীপুরের কালিয়াকৈর উপজেলার পল্লী বিদ্যুৎ এলাকায় ঢাকা-টাঙ্গাইল মহাসড়ক অবরুদ্ধ করে বিক্ষোভ প্রদর্শন করেছেন বেশ কয়েকটি পোশাক কারখানার শ্রমিকেরা। প্রায় দেড় ঘণ্টা ধরে চলা এই অবরোধকালে একটি নির্বাহী ম্যাজিস্ট্রেটের গাড়িতে ভাঙচুর চালানোর ঘটনা ঘটে এবং মহাসড়কে তীব্র যানজটের সৃষ্টি </description>

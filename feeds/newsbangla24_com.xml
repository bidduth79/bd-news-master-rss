    <item>
      <title>এসএমই মেলা-২০২৬ এ ইসলামী ব্যাংকের স্টল উদ্বোধন</title>
      <link>https://www.newsbangla24.com/corporate/288589/%E0%A6%8F%E0%A6%B8%E0%A6%8F%E0%A6%AE%E0%A6%87-%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%BE-%E0%A7%A8%E0%A7%A6%E0%A7%A8%E0%A7%AC-%E0%A6%8F-%E0%A6%87%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%B2-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%8B%E0%A6%A7%E0%A6%A8</link>

    <item>
      <title>‘মির্জাপুর’-এর পথে হাঁটছে ‘পঞ্চায়েত’</title>
      <link>https://www.newsbangla24.com/culture/288734/%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A6%BE%E0%A6%AA%E0%A7%81%E0%A6%B0-%E0%A6%8F%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%81%E0%A6%9F%E0%A6%9B%E0%A7%87-%E0%A6%AA%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%A4</link>
      <guid isPermaLink="true">https://www.newsbangla24.com/culture/288734/%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A6%BE%E0%A6%AA%E0%A7%81%E0%A6%B0-%E0%A6%8F%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%81%E0%A6%9F%E0%A6%9B%E0%A7%87-%E0%A6%AA%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%A4</guid>
      <pubDate>Wed, 25 Nov 2026 18:06:58 GMT</pubDate>
      <description>ওয়েব সিরিজ থেকে সিনেমায় এসে বড় সাফল্য পেয়েছে মির্জাপুর। তিন সিজন পার করে চলতি বছরই মির্জাপুর: দ্য ফিল্ম নামে বড় পর্দায় আসা সিরিজটি বিশ্বব্যাপী আয় করেছে ৩৪০ কোটি রুপির বেশি। এবার একই পথে হাঁটার পরিকল্পনা করছে প্রাইম ভিডিওর জনপ্রিয় কমেডি সিরিজ পঞ্চায়েত। এই সিরিজ অবলম্বনে সিনেমা বানানোর ইঙ্গিত</description>
      <source url="https://www.newsbangla24.com/culture/288734/%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A6%BE%E0%A6%AA%E0%A7%81%E0%A6%B0-%E0%A6%8F%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%81%E0%A6%9F%E0%A6%9B%E0%A7%87-%E0%A6%AA%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%A4">newsbangla24.com</source>
    </item>
    <item>
      <title>‘ঢাকাইয়া দেবদাস’-এ প্লেব্যাক করবেন বুবলী</title>
      <link>https://www.newsbangla24.com/culture/288733/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%87%E0%A6%AF%E0%A6%BC%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%AC%E0%A6%A6%E0%A6%BE%E0%A6%B8-%E0%A6%8F-%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A7%87%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%95-%E0%A6%95%E0%A6%B0%E0%A6%AC%E0%A7%87%E0%A6%A8-%E0%A6%AC%E0%A7%81%E0%A6%AC%E0%A6%B2%E0%A7%80</link>
      <guid isPermaLink="true">https://www.newsbangla24.com/culture/288733/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%87%E0%A6%AF%E0%A6%BC%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%AC%E0%A6%A6%E0%A6%BE%E0%A6%B8-%E0%A6%8F-%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A7%87%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%95-%E0%A6%95%E0%A6%B0%E0%A6%AC%E0%A7%87%E0%A6%A8-%E0%A6%AC%E0%A7%81%E0%A6%AC%E0%A6%B2%E0%A7%80</guid>
      <pubDate>Wed, 25 Nov 2026 17:57:50 GMT</pubDate>
      <description>চিত্রনায়িকা শবনম বুবলী এবার সিনেমার গানে কণ্ঠ দিতে যাচ্ছেন। ঢাকাইয়া দেবদাস সিনেমায় প্লেব্যাক করবেন তিনি। সিনেমার পরিচালক জাহিদ হোসেন বিষয়টি নিশ্চিত করেছেন। এ বছর রোজার ঈদে ম্যাগাজিন অনুষ্ঠান ইত্যাদিতে প্রচারিত হয়েছিল বুবলীর গাওয়া প্রথম গান, যার মাধ্যমে তিনি গায়িকা পরিচয়ে হাজির হয়েছিলেন।
পরি</description>
      <source url="https://www.newsbangla24.com/culture/288733/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%87%E0%A6%AF%E0%A6%BC%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%AC%E0%A6%A6%E0%A6%BE%E0%A6%B8-%E0%A6%8F-%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A7%87%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%95-%E0%A6%95%E0%A6%B0%E0%A6%AC%E0%A7%87%E0%A6%A8-%E0%A6%AC%E0%A7%81%E0%A6%AC%E0%A6%B2%E0%A7%80">newsbangla24.com</source>

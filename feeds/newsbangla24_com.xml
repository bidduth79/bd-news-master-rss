    <item>
      <title>১৬ জেলায় নাশকতা, গাড়ি-স্থাপনায় আগুন ও হামলা</title>
      <link>https://www.newsbangla24.com/news/288438/%E0%A7%A7%E0%A7%AC-%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%BE-%E0%A6%97%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%AA%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%93-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.newsbangla24.com/news/288438/%E0%A7%A7%E0%A7%AC-%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%BE-%E0%A6%97%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%AA%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%93-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE</guid>
      <pubDate>Fri, 20 Nov 2026 01:11:49 GMT</pubDate>
      <description>দেশের ১৬ জেলায় সরকারি-বেসরকারি স্থাপনা, যানবাহন ও রাজনৈতিক নেতাদের বাড়িঘরে হামলা, ভাঙচুর ও অগ্নিসংযোগের ঘটনা ঘটেছে। গত বুধবার রাত থেকে বৃহস্পতিবার (১৯ নভেম্বর)পর্যন্ত এসব ঘটনা ঘটে। এর মধ্যে গোপালগঞ্জে বিএনপির এক সংসদ সদস্যের বাড়িসহ তার স্বজন ও সমর্থকদের বাড়িতে হামলা চালানো হয়েছে। মুকসুদপুর থানায় হাম</description>
      <source url="https://www.newsbangla24.com/news/288438/%E0%A7%A7%E0%A7%AC-%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%BE-%E0%A6%97%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%AA%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%93-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE">newsbangla24.com</source>
    </item>
    <item>
      <title>ট্রাম্প-শি-পুতিনের বৈঠকে চার দফা ঘোষণা</title>
      <link>https://www.newsbangla24.com/international/288437/%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA-%E0%A6%B6%E0%A6%BF-%E0%A6%AA%E0%A7%81%E0%A6%A4%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%AB%E0%A6%BE-%E0%A6%98%E0%A7%8B%E0%A6%B7%E0%A6%A3%E0%A6%BE</link>

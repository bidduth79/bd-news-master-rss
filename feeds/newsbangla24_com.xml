    <item>
      <title>তেলুগু ইন্ডাস্ট্রিতে দুলকারের সাফল্যের ধারা অব্যাহত</title>
      <link>https://www.newsbangla24.com/culture/288800/%E0%A6%A4%E0%A7%87%E0%A6%B2%E0%A7%81%E0%A6%97%E0%A7%81-%E0%A6%87%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%B2%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AB%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%85%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B9%E0%A6%A4</link>

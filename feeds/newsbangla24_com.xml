    <item>
      <title>চ্যাম্পিয়নস লিগের আগে দুয়ের চোটে বিপদে পিএসজি</title>
      <link>https://www.newsbangla24.com/sports/288561/%E0%A6%9A%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%A8%E0%A6%B8-%E0%A6%B2%E0%A6%BF%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A7%8B%E0%A6%9F%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%A6%E0%A7%87-%E0%A6%AA%E0%A6%BF%E0%A6%8F%E0%A6%B8%E0%A6%9C%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.newsbangla24.com/sports/288561/%E0%A6%9A%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%A8%E0%A6%B8-%E0%A6%B2%E0%A6%BF%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A7%8B%E0%A6%9F%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%A6%E0%A7%87-%E0%A6%AA%E0%A6%BF%E0%A6%8F%E0%A6%B8%E0%A6%9C%E0%A6%BF</guid>
      <pubDate>Sun, 22 Nov 2026 16:44:55 GMT</pubDate>
      <description>লিগ ওয়ানে নিসের বিপক্ষে ৩-২ গোলের জয়ের দিনে গুরুতর চোটে পড়েছেন পিএসজি ফরোয়ার্ড দেসিরে দুয়ে। রোমার বিপক্ষে বুধবারের চ্যাম্পিয়নস লিগ ম্যাচের আগে ২১ বছর বয়সী এই ফরাসি তারকার চোট দলের দুশ্চিন্তা বাড়িয়েছে। ম্যাচের ৩৯তম মিনিটে ডান হাঁটু চেপে ধরে মাটিতে পড়ে তীব্র যন্ত্রণায় চিৎকার করে ওঠেন তিনি। </description>
      <source url="https://www.newsbangla24.com/sports/288561/%E0%A6%9A%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%A8%E0%A6%B8-%E0%A6%B2%E0%A6%BF%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A7%8B%E0%A6%9F%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%A6%E0%A7%87-%E0%A6%AA%E0%A6%BF%E0%A6%8F%E0%A6%B8%E0%A6%9C%E0%A6%BF">newsbangla24.com</source>

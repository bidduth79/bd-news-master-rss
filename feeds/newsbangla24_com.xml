      <guid isPermaLink="true">https://www.newsbangla24.com/news/288735/%E0%A6%95%E0%A7%87%E0%A6%87%E0%A6%AA%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%A1%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%BE%E0%A6%95%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%AF%E0%A6%BC%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A7%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8B%E0%A6%AD</guid>
      <pubDate>Wed, 25 Nov 2026 18:12:34 GMT</pubDate>
      <description>চট্টগ্রামের আনোয়ারা ও কর্ণফুলী উপজেলার স্থানীয় নারী-পুরুষের চাকরিতে অগ্রাধিকার দেওয়ার দাবিতে বিক্ষোভ ও অবস্থান কর্মসূচি পালন করেছেন এলাকাবাসী। নিয়োগের ক্ষেত্রে স্থানীয় যোগ্য প্রার্থীদের উপেক্ষা করে দেশের বিভিন্ন জেলা থেকে কর্মী নিয়োগের অভিযোগ তুলে তারা এ কর্মসূচি পালন করেন। পরে কেইপিজেড কর্তৃপ</description>
      <source url="https://www.newsbangla24.com/news/288735/%E0%A6%95%E0%A7%87%E0%A6%87%E0%A6%AA%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%A1%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%BE%E0%A6%95%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%AF%E0%A6%BC%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A7%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8B%E0%A6%AD">newsbangla24.com</source>

      <link>https://www.newsbangla24.com/culture/287723/%E0%A6%AC%E0%A6%95%E0%A7%8D%E0%A6%B8-%E0%A6%85%E0%A6%AB%E0%A6%BF%E0%A6%B8%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%AE%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A1-%E0%A6%AD%E0%A6%BE%E0%A6%99%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%B8%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.newsbangla24.com/culture/287723/%E0%A6%AC%E0%A6%95%E0%A7%8D%E0%A6%B8-%E0%A6%85%E0%A6%AB%E0%A6%BF%E0%A6%B8%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%AE%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A1-%E0%A6%AD%E0%A6%BE%E0%A6%99%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%B8%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE</guid>
      <pubDate>Sun, 8 Nov 2026 17:22:59 GMT</pubDate>
      <description>রণবীর কাপুর ও যশ অভিনীত বহুল প্রতীক্ষিত পৌরাণিক চলচ্চিত্র রামায়ণ-এর ঝড় চলাকালীন বক্স অফিসে শক্ত অবস্থান জানান দিয়েছে তামিল তারকা সুরিয়ার নতুন অ্যাকশন-কমেডি ঘরানার সিনেমা সিন। দীপাবলির উৎসবের আগে গত শুক্রবার (৬ নভেম্বর) প্রেক্ষাগৃহে মুক্তি পাওয়া এই সিনেমাটি মুক্তির প্রথম দিনেই ভারতের অভ্যন্তরীণ বাজার</description>

    <item>
      <title>দক্ষ চালক হিসেবে গড়ে তুলতে ২০ হাজার জনকে প্রশিক্ষণ দেবে বিআরটিসি</title>
      <link>https://www.newsbangla24.com/national/288034/%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%95-%E0%A6%B9%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A7%87-%E0%A6%97%E0%A7%9C%E0%A7%87-%E0%A6%A4%E0%A7%81%E0%A6%B2%E0%A6%A4%E0%A7%87-%E0%A7%A8%E0%A7%A6-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A3-%E0%A6%A6%E0%A7%87%E0%A6%AC%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%86%E0%A6%B0%E0%A6%9F%E0%A6%BF%E0%A6%B8%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.newsbangla24.com/national/288034/%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%95-%E0%A6%B9%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A7%87-%E0%A6%97%E0%A7%9C%E0%A7%87-%E0%A6%A4%E0%A7%81%E0%A6%B2%E0%A6%A4%E0%A7%87-%E0%A7%A8%E0%A7%A6-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A3-%E0%A6%A6%E0%A7%87%E0%A6%AC%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%86%E0%A6%B0%E0%A6%9F%E0%A6%BF%E0%A6%B8%E0%A6%BF</guid>
      <pubDate>Fri, 13 Nov 2026 19:57:01 GMT</pubDate>
      <description>পেশাদার দক্ষ চালক তৈরি করতে এবার ভিন্ন পদ্ধতি গ্রহণ করতে যাচ্ছে বাংলাদেশ সড়ক পরিবহন করপোরেশন (বিআরটিসি)। সড়ক পরিবহন প্রকল্পের আওতায় ২০ হাজার চালককে পেশাদার ও দক্ষ হিসেবে গড়ে তুলতে বদ্ধ পরিকর। আগামী রোববার থেকে শুরু হতে যাচ্ছে ভিন্ন এই পদক্ষেপ।
সড়ক পরিবহন ও মহাসড়ক বিভাগের প্রতিমন্ত্রী হাবিবুর রশিদ </description>
      <source url="https://www.newsbangla24.com/national/288034/%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%95-%E0%A6%B9%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A7%87-%E0%A6%97%E0%A7%9C%E0%A7%87-%E0%A6%A4%E0%A7%81%E0%A6%B2%E0%A6%A4%E0%A7%87-%E0%A7%A8%E0%A7%A6-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A3-%E0%A6%A6%E0%A7%87%E0%A6%AC%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%86%E0%A6%B0%E0%A6%9F%E0%A6%BF%E0%A6%B8%E0%A6%BF">newsbangla24.com</source>
    </item>
    <item>

      <guid isPermaLink="true">https://www.newsbangla24.com/news/288237/%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%98%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A7%80%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A6%A0%E0%A7%8B%E0%A6%B0-%E0%A6%A8%E0%A6%9C%E0%A6%B0%E0%A6%A6%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A7%AE%E0%A7%AA-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF</guid>
      <pubDate>Tue, 17 Nov 2026 00:38:50 GMT</pubDate>
      <description>ডিসেম্বরকে সামনে রেখে দেশের সীমান্ত নিরাপত্তা জোরদার করেছে বর্ডার গার্ড বাংলাদেশ (বিজিবি)। পলাতক আসামিদের অবৈধভাবে দেশত্যাগ, অনুপ্রবেশ, মাদক ও চোরাচালান প্রতিরোধে সীমান্তজুড়ে বাড়ানো হয়েছে টহল ও গোয়েন্দা নজরদারি। ঝুঁকিপূর্ণ এলাকাগুলোতে ব্যবহার করা হচ্ছে নাইটভিশন বাইনোকুলার, সার্চলাইট, সিসিটিভি ক্যামে</description>

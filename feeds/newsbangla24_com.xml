      <guid isPermaLink="true">https://www.newsbangla24.com/news/288241/%E0%A7%A8%E0%A7%A6%E0%A7%A8%E0%A7%AE-%E0%A6%B8%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A7%8D%E0%A6%AF-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%89%E0%A7%8E%E0%A6%AA%E0%A6%BE%E0%A6%A6%E0%A6%BF%E0%A6%A4-%E0%A6%B9%E0%A6%AC%E0%A7%87-%E0%A7%AA%E0%A7%A8%E0%A7%AB-%E0%A6%AE%E0%A7%87%E0%A6%97%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%9F-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A7%8E-%E0%A6%A1%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%B8%E0%A6%BF-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B6%E0%A6%BE%E0%A6%B8%E0%A6%95</guid>
      <pubDate>Tue, 17 Nov 2026 00:46:31 GMT</pubDate>
      <description>বর্জ্য থেকে ৪.২৫ মেগায়াট বিদ্যুৎ উৎপাদন হওয়া সম্ভব বলে জানিয়েছেন উত্তর সিটি করপোরেশনের (ডিএনসিসি) প্রশাসক মো. শফিকুল ইসলাম খান মিল্টন। ২০২৮ সালের মধ্যে এই উৎপাদন হবে বলে মন্তব্য করেন।
তিনি বলেন, দিনের পর দিন বর্জ্য জমিয়ে পাহাড় তৈরি না করে আমরা একে সম্পদে রূপান্তর করতে চাই। আমিনবাজার ল্যান্ডফিলে বর্জ</description>

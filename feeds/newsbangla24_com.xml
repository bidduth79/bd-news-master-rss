    <item>
      <title>মিস ইউনিভার্স বাংলাদেশের মুকুট জিতলেন অভিনেত্রী মাহি</title>
      <link>https://www.newsbangla24.com/culture/287722/%E0%A6%AE%E0%A6%BF%E0%A6%B8-%E0%A6%87%E0%A6%89%E0%A6%A8%E0%A6%BF%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B8-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%81%E0%A6%9F-%E0%A6%9C%E0%A6%BF%E0%A6%A4%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%AE%E0%A6%BE%E0%A6%B9%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.newsbangla24.com/culture/287722/%E0%A6%AE%E0%A6%BF%E0%A6%B8-%E0%A6%87%E0%A6%89%E0%A6%A8%E0%A6%BF%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B8-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%81%E0%A6%9F-%E0%A6%9C%E0%A6%BF%E0%A6%A4%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%AE%E0%A6%BE%E0%A6%B9%E0%A6%BF</guid>
      <pubDate>Sun, 8 Nov 2026 17:20:07 GMT</pubDate>
      <description>অভিনেত্রী ও মডেল সামিরা খান মাহি মিস ইউনিভার্স বাংলাদেশ ২০২৬-এর মুকুট অর্জন করেছেন। শনিবার (৭ নভেম্বর) রাতে রাজধানীর ইন্টারন্যাশনাল কনভেনশন সিটি বসুন্ধরায় (আইসিসিবি) আয়োজিত এক আড়ম্বরপূর্ণ অনুষ্ঠানে তাঁর মাথায় এই মুকুট পরিয়ে দেওয়া হয়। মাহির মাথায় বিজয়ের মুকুট তুলে দেন তাঁর ঘনিষ্ঠ বন্ধু ও গত বছরের বিজ</description>
      <source url="https://www.newsbangla24.com/culture/287722/%E0%A6%AE%E0%A6%BF%E0%A6%B8-%E0%A6%87%E0%A6%89%E0%A6%A8%E0%A6%BF%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B8-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%81%E0%A6%9F-%E0%A6%9C%E0%A6%BF%E0%A6%A4%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%AE%E0%A6%BE%E0%A6%B9%E0%A6%BF">newsbangla24.com</source>

    <item>
      <title>কপ-৩১ সম্মেলনে যোগ দিতে তুরস্কের পথে প্রধানমন্ত্রী</title>
      <link>https://www.newsbangla24.com/national/287811/%E0%A6%95%E0%A6%AA-%E0%A7%A9%E0%A7%A7-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%A8%E0%A7%87-%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%0D%0A</link>
      <guid isPermaLink="true">https://www.newsbangla24.com/national/287811/%E0%A6%95%E0%A6%AA-%E0%A7%A9%E0%A7%A7-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%A8%E0%A7%87-%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%0D%0A</guid>
      <pubDate>Tue, 10 Nov 2026 10:17:38 GMT</pubDate>
      <enclosure url="https://www.newsbangla24.com/assets/news_images/2026/11/10/_Image__27.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.newsbangla24.com/assets/news_images/2026/11/10/_Image__27.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.newsbangla24.com/assets/news_images/2026/11/10/_Image__27.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কপ-৩১ সম্মেলনে যোগ দিতে তুরস্কের পথে প্রধানমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;জাতিসংঘ জলবায়ু পরিবর্তন বিষয়ক শীর্ষ সম্মেলন কপ-৩১ এ অংশ নিতে তিন দিনের সফরে তুরস্কের আন্তালিয়ার উদ্দেশে ঢাকা ত্যাগ করেছেন প্রধানমন্ত্রী তারেক রহমান। সফরে তাঁর সঙ্গে রয়েছেন সহধর্মিণী ডা. জুবাইদা রহমান।
আজ মঙ্গলবার সকাল সাড়ে ৭টায় টার্কিশ এয়ারলাইনসের একটি ফ্লাইটে প্রধানমন্ত্রী, তাঁর সহধর্মিণী ডা. জুবা&lt;/p&gt;</description>
      <source url="https://www.newsbangla24.com/national/287811/%E0%A6%95%E0%A6%AA-%E0%A7%A9%E0%A7%A7-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%A8%E0%A7%87-%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%0D%0A">newsbangla24.com</source>
    </item>
    <item>
      <title>এক প্ল্যাটফর্মে আসছে সব আর্থিক লেনদেন</title>
      <link>https://www.newsbangla24.com/national/287810/%E0%A6%8F%E0%A6%95-%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9F%E0%A6%AB%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%87-%E0%A6%86%E0%A6%B8%E0%A6%9B%E0%A7%87-%E0%A6%B8%E0%A6%AC-%E0%A6%86%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%BF%E0%A6%95-%E0%A6%B2%E0%A7%87%E0%A6%A8%E0%A6%A6%E0%A7%87%E0%A6%A8</link>

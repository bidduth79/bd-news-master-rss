    <item>
      <title>ঢাকার সিএমএম আদালতের সামনে ককটেল বিস্ফোরণ, আটক  ১</title>
      <link>https://www.newsbangla24.com/news/288798/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BF%E0%A6%8F%E0%A6%AE%E0%A6%8F%E0%A6%AE-%E0%A6%86%E0%A6%A6%E0%A6%BE%E0%A6%B2%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%86%E0%A6%9F%E0%A6%95%C2%A0-%E0%A7%A7</link>
      <guid isPermaLink="true">https://www.newsbangla24.com/news/288798/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BF%E0%A6%8F%E0%A6%AE%E0%A6%8F%E0%A6%AE-%E0%A6%86%E0%A6%A6%E0%A6%BE%E0%A6%B2%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%86%E0%A6%9F%E0%A6%95%C2%A0-%E0%A7%A7</guid>
      <pubDate>Thu, 26 Nov 2026 18:11:53 GMT</pubDate>
      <description>এবার ককটেল বিস্ফোরণ ঘটনা ঘটল রাজধানীর ঢাকার চিফ মেট্রোপলিটন ম্যাজিস্ট্রেট (সিএমএম) আদালতের সামনে। এতেক করে মো. নয়ন নামে এক আইনজীবী আহত হয়েছেন। বৃহস্পতিবার (২৬ নভেম্বর) বেলা ১১টা ১৭ মিনিটের দিকে এ ঘটনা ঘটে। বিস্ফোরণের বিকট শব্দে পুরো আদালতপাড়ায় চরম আতঙ্ক ছড়িয়ে পড়ে।
আহত আইনজীবী মো. নয়নকে উদ্ধা</description>
      <source url="https://www.newsbangla24.com/news/288798/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BF%E0%A6%8F%E0%A6%AE%E0%A6%8F%E0%A6%AE-%E0%A6%86%E0%A6%A6%E0%A6%BE%E0%A6%B2%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%86%E0%A6%9F%E0%A6%95%C2%A0-%E0%A7%A7">newsbangla24.com</source>

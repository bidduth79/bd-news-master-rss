      <guid isPermaLink="true">https://www.newsbangla24.com/election/287745/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%A7%E0%A6%BE%E0%A6%AA%E0%A7%87-%E0%A7%A7%E0%A7%A6%E0%A7%AB%E0%A7%A6-%E0%A6%87%E0%A6%89%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%A8%E0%A7%87-%E0%A6%AD%E0%A7%8B%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A6%A8%E0%A6%BE-%E0%A6%87%E0%A6%B8%E0%A6%BF%E0%A6%B0</guid>
      <pubDate>Sun, 8 Nov 2026 22:36:31 GMT</pubDate>
      <description>দেশের স্থানীয় সরকার প্রতিষ্ঠানগুলোতে নির্বাচনী কার্যক্রম শুরু করার প্রস্তুতি নিচ্ছে নির্বাচন কমিশন (ইসি)। দীর্ঘদিন ধরে অপেক্ষায় থাকা ইউনিয়ন পরিষদ নির্বাচন সামনে রেখে প্রথম ধাপে ১ হাজার ৫০টি ইউনিয়নে ভোট গ্রহণের পরিকল্পনা করেছে কমিশন। উপজেলা সদর এলাকার ইউনিয়নগুলোকে অগ্রাধিকার দিয়ে নির্বাচনী কার্যক্রম </description>

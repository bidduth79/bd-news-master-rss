      <guid isPermaLink="true">https://www.newsbangla24.com/news/287937/%E0%A6%A8%E0%A6%BE%E0%A6%97%E0%A6%B0%E0%A6%BF%E0%A6%95-%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A6%BE-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B9%E0%A6%A4-%E0%A6%B9%E0%A6%B2%E0%A7%87-%E0%A6%AC%E0%A6%B0%E0%A6%96%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4-%E0%A6%B9%E0%A6%AC%E0%A7%87%E0%A6%A8-%E0%A6%B8%E0%A6%82%E0%A6%B6%E0%A7%8D%E0%A6%B2%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%9F-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE-%E0%A6%AE%E0%A7%80%E0%A6%B0-%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A7%87-%E0%A6%86%E0%A6%B2%E0%A6%AE</guid>
      <pubDate>Wed, 11 Nov 2026 23:00:51 GMT</pubDate>
      <description>পৌরসভার বর্জ্য ব্যবস্থাপনা এবং নাগরিক সেবা ব্যাহত হলে সংশ্লিষ্ট কর্মকর্তা তাৎক্ষণিকভাবে বরখাস্ত হবেন বলে কঠোর হুঁশিয়ারি দিয়েছেন স্থানীয় সরকার, পল্লী উন্নয়ন ও সমবায় প্রতিমন্ত্রী মীর শাহে আলম। তিনি জানিয়েছেন, আধুনিক বর্জ্য ব্যবস্থাপনা ও পরিবেশবান্ধব উদ্যোগ নিশ্চিতে ব্যর্থ পৌরসভাগুলোর দায়িত্বপ্রাপ্তদের</description>

    <item>
      <title>ওয়াশিংটনে ‘ডার্টি বোমা’ হামলার পরিকল্পনা করছে ইরান</title>
      <link>https://www.newsbangla24.com/international/288302/%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B6%E0%A6%BF%E0%A6%82%E0%A6%9F%E0%A6%A8%E0%A7%87-%E0%A6%A1%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A6%BF-%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A6%A8%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%9B%E0%A7%87-%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.newsbangla24.com/international/288302/%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B6%E0%A6%BF%E0%A6%82%E0%A6%9F%E0%A6%A8%E0%A7%87-%E0%A6%A1%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A6%BF-%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A6%A8%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%9B%E0%A7%87-%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8</guid>

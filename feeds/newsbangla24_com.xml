    <item>
      <title>রংপুরকে হারিয়ে জাতীয় ক্রিকেট লিগে চ্যাম্পিয়ন খুলনা</title>
      <link>https://www.newsbangla24.com/sports/288266/%E0%A6%B0%E0%A6%82%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%9F-%E0%A6%B2%E0%A6%BF%E0%A6%97%E0%A7%87-%E0%A6%9A%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A7%9F%E0%A6%A8-%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.newsbangla24.com/sports/288266/%E0%A6%B0%E0%A6%82%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%9F-%E0%A6%B2%E0%A6%BF%E0%A6%97%E0%A7%87-%E0%A6%9A%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A7%9F%E0%A6%A8-%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE</guid>
      <pubDate>Tue, 17 Nov 2026 16:55:45 GMT</pubDate>
      <description>জাতীয় ক্রিকেট লিগের (এনসিএল) এবারের আসরে রেকর্ড অষ্টমবারের মতো চ্যাম্পিয়ন হওয়ার গৌরব অর্জন করেছে খুলনা বিভাগ। চ্যাম্পিয়ন হওয়ার জন্য শেষ রাউন্ডের এই ম্যাচে কেবল হার এড়ালেই চলত তাদের। তবে সিলেট আন্তর্জাতিক ক্রিকেট স্টেডিয়ামে অনুষ্ঠিত শেষ দিনের খেলায় রংপুর বিভাগকে ৯ উইকেটের বিশাল ব্যবধানে দাপটের সঙ</description>
      <source url="https://www.newsbangla24.com/sports/288266/%E0%A6%B0%E0%A6%82%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%9F-%E0%A6%B2%E0%A6%BF%E0%A6%97%E0%A7%87-%E0%A6%9A%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A7%9F%E0%A6%A8-%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE">newsbangla24.com</source>

    <item>
      <title>পদোন্নতি পেয়ে দুদকের মহাপরিচালক হলেন মোরশেদ আলম</title>
      <link>https://www.newsbangla24.com/national/287992/%E0%A6%AA%E0%A6%A6%E0%A7%8B%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A6%A4%E0%A6%BF-%E0%A6%AA%E0%A7%87%E0%A7%9F%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%A6%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%95-%E0%A6%B9%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AE%E0%A7%8B%E0%A6%B0%E0%A6%B6%E0%A7%87%E0%A6%A6-%E0%A6%86%E0%A6%B2%E0%A6%AE</link>
      <guid isPermaLink="true">https://www.newsbangla24.com/national/287992/%E0%A6%AA%E0%A6%A6%E0%A7%8B%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A6%A4%E0%A6%BF-%E0%A6%AA%E0%A7%87%E0%A7%9F%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%A6%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%95-%E0%A6%B9%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AE%E0%A7%8B%E0%A6%B0%E0%A6%B6%E0%A7%87%E0%A6%A6-%E0%A6%86%E0%A6%B2%E0%A6%AE</guid>
      <pubDate>Thu, 12 Nov 2026 21:51:08 GMT</pubDate>
      <description>পরিচালক থেকে পদোন্নতি পেয়ে দুর্নীতি দমন কমিশনের (দুদক) মহাপরিচালক হয়েছেন মোহাম্মদ মোরশেদ আলম।
বৃহস্পতিবার (১২ নভেম্বর) সংস্থাটির প্রশাসন ও মানবসম্পদ বিভাগ থেকে জারি হওয়া এক প্রজ্ঞাপন এ তথ্য জানা গেছে।
মোহাম্মদ মোরশেদ আলম ১৯৯৫ সালে সহকারী পরিচালক হিসেবে নিয়োগ পেয়েছিলেন। দুদকের নিজস্ব জনবল থেকে মোরশেদ</description>
      <source url="https://www.newsbangla24.com/national/287992/%E0%A6%AA%E0%A6%A6%E0%A7%8B%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A6%A4%E0%A6%BF-%E0%A6%AA%E0%A7%87%E0%A7%9F%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%A6%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%95-%E0%A6%B9%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AE%E0%A7%8B%E0%A6%B0%E0%A6%B6%E0%A7%87%E0%A6%A6-%E0%A6%86%E0%A6%B2%E0%A6%AE">newsbangla24.com</source>

    </item>
    <item>
      <title>খুলনার শীর্ষ সন্ত্রাসী আজম গাজীপুরে গ্রেপ্তার</title>
      <link>https://www.asia-post.com/country-news/ap8frmo5qwfa</link>
      <guid isPermaLink="true">https://www.asia-post.com/country-news/ap8frmo5qwfa</guid>
      <pubDate>Mon, 16 Nov 2026 08:55:00 +0000</pubDate>
      <enclosure url="https://images.asia-post.com/original_images/ARREST8-c70a1e-720x405.webp" length="0" type="image/jpeg" />

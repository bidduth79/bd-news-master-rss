    <item>
      <title>কার্যক্রম নিষিদ্ধ আওয়ামী লীগের কর্মসূচি ঘিরে বিএনপির নতুন ছক</title>
      <link>https://www.asia-post.com/politics/apqllv3uj287</link>
      <guid isPermaLink="true">https://www.asia-post.com/politics/apqllv3uj287</guid>
      <pubDate>Wed, 18 Nov 2026 12:31:14 +0000</pubDate>
      <enclosure url="https://images.asia-post.com/original_images/awamilig-91260b-720x405.webp" length="0" type="image/jpeg" />

      <title>নেতাকর্মীদের সান্ত্বনা দিতেই শেখ হাসিনা দেশে ফেরার গুজব ছড়াচ্ছে: জামায়াত</title>
      <link>https://www.asia-post.com/politics/ap82ozbjb58g</link>
      <guid isPermaLink="true">https://www.asia-post.com/politics/ap82ozbjb58g</guid>
      <pubDate>Mon, 09 Nov 2026 14:54:50 +0000</pubDate>
      <enclosure url="https://images.asia-post.com/original_images/JamateIslami-d06c3e-720x405.webp" length="0" type="image/jpeg" />

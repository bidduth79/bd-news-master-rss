      <title>থাইরয়েড ক্যানসারের নীরব ৬ লক্ষণে সতর্ক হোন</title>
      <link>https://www.asia-post.com/health/apb4adfn5ou3-%E0%A6%A5%E0%A6%BE%E0%A6%87%E0%A6%B0%E0%A7%9F%E0%A7%87%E0%A6%A1-%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A7%80%E0%A6%B0%E0%A6%AC-%E0%A7%AC-%E0%A6%B2%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A3%E0%A7%87-%E0%A6%B8%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%95-%E0%A6%B9%E0%A7%8B%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.asia-post.com/health/apb4adfn5ou3-%E0%A6%A5%E0%A6%BE%E0%A6%87%E0%A6%B0%E0%A7%9F%E0%A7%87%E0%A6%A1-%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A7%80%E0%A6%B0%E0%A6%AC-%E0%A7%AC-%E0%A6%B2%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A3%E0%A7%87-%E0%A6%B8%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%95-%E0%A6%B9%E0%A7%8B%E0%A6%A8</guid>
      <pubDate>Mon, 16 Nov 2026 08:10:57 +0000</pubDate>
      <enclosure url="https://images.asia-post.com/original_images/Untitled-2-280caa-720x405.webp" length="0" type="image/jpeg" />
      <media:content url="https://images.asia-post.com/original_images/Untitled-2-280caa-720x405.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://images.asia-post.com/original_images/Untitled-2-280caa-720x405.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="থাইরয়েড ক্যানসারের নীরব ৬ লক্ষণে সতর্ক হোন" /&gt;&lt;/p&gt;&lt;p&gt;শরীরের খুব ছোট একটি গ্রন্থি হলেও থাইরয়েড আমাদের স্বাস্থ্যের জন্য অত্যন্ত গুরুত্বপূর্ণ। এটি শরীরের বিপাকক্রিয়া, শক্তি উৎপাদন, হৃদস্পন্দন এমনকি হরমোনের ভারসাম্য নিয়ন্ত্রণেও ভূমিকা রাখে। কিন্তু এই থাইরয়েড গ্রন্থিতেই যখন ক্যানসার তৈরি হয়, তখন অনেক সময় তা দীর্ঘদিন নীরবে শরীরের ক্ষতি করতে থাকে।&lt;/p&gt;</description>
      <source url="https://www.asia-post.com/health/apb4adfn5ou3-%E0%A6%A5%E0%A6%BE%E0%A6%87%E0%A6%B0%E0%A7%9F%E0%A7%87%E0%A6%A1-%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A7%80%E0%A6%B0%E0%A6%AC-%E0%A7%AC-%E0%A6%B2%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A3%E0%A7%87-%E0%A6%B8%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%95-%E0%A6%B9%E0%A7%8B%E0%A6%A8">Asia Post</source>
    </item>
    <item>
      <title>১২০ রানে থামলেন লিটন</title>
      <link>https://www.asia-post.com/sports/cricket/aph3n8te3ajn</link>
      <guid isPermaLink="true">https://www.asia-post.com/sports/cricket/aph3n8te3ajn</guid>
      <pubDate>Mon, 16 Nov 2026 08:10:29 +0000</pubDate>
      <enclosure url="https://images.asia-post.com/original_images/littondas-64acd1-720x405.webp" length="0" type="image/jpeg" />
      <media:content url="https://images.asia-post.com/original_images/littondas-64acd1-720x405.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://images.asia-post.com/original_images/littondas-64acd1-720x405.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="১২০ রানে থামলেন লিটন" /&gt;&lt;/p&gt;&lt;p&gt;কাগিসো রাবাদার ভয়ংকর বোলিংয়ে প্রথম দিনেই বড় বিপদে পড়েছিল বাংলাদেশ। মাত্র ১২১ রানে হারিয়েছিল ৫ উইকেট। সেখান থেকে তাওহিদ হৃদয়ের দুর্দান্ত শতক ও লিটন দাসের অসাধারণ ব্যাটিংয়ে ঘুরে দাঁড়িয়েছে টাইগাররা। দুজনের ২০৬ রানের রেকর্ড জুটিতে প্রথম দিন শেষে বাংলাদেশের সংগ্রহ ৬ উইকেটে ৩২৭ রান।

জোহানেসবার্গের ওয়ান্ড&lt;/p&gt;</description>
      <source url="https://www.asia-post.com/sports/cricket/aph3n8te3ajn">Asia Post</source>
    </item>

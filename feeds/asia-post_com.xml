    <item>
      <title>মালয়েশিয়াগামী কর্মীদের মেডিকেল পরীক্ষায় ১১ দফা নির্দেশনা, ফি নির্ধারণ</title>
      <link>https://www.asia-post.com/bangladesh/apzii0ylpq33</link>
      <guid isPermaLink="true">https://www.asia-post.com/bangladesh/apzii0ylpq33</guid>

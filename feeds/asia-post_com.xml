    <item>
      <title>পুলিশ পরিচয়ে প্রাইভেটকার থামিয়ে ছিনতাই</title>
      <link>https://www.asia-post.com/country-news/apv2qtt9el2y</link>
      <guid isPermaLink="true">https://www.asia-post.com/country-news/apv2qtt9el2y</guid>
      <pubDate>Sat, 21 Nov 2026 01:00:12 +0000</pubDate>
      <enclosure url="https://images.asia-post.com/original_images/ap-507ea8-720x405.webp" length="0" type="image/jpeg" />
      <media:content url="https://images.asia-post.com/original_images/ap-507ea8-720x405.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://images.asia-post.com/original_images/ap-507ea8-720x405.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পুলিশ পরিচয়ে প্রাইভেটকার থামিয়ে ছিনতাই" /&gt;&lt;/p&gt;&lt;p&gt;কুষ্টিয়ার কুমারখালীতে নিজেদের আইনশৃঙ্খলা রক্ষাকারী বাহিনীর সদস্য পরিচয় দিয়ে প্রাইভেটকারের গতিরোধ করে টাকা ছিনতাইয়ের অভিযোগ উঠেছে পাঁচজনের বিরুদ্ধে। এ&lt;/p&gt;</description>
      <source url="https://www.asia-post.com/country-news/apv2qtt9el2y">Asia Post</source>
    </item>
    <item>
      <title>ঘরোয়া দোয়া মাহফিলের ছবি ঘিরে আলোচনা, জগলু চৌধুরীকে গ্রেপ্তারে তৎপর পুলিশ</title>
      <link>https://www.asia-post.com/country-news/ap2w5dz9dfiw</link>
      <guid isPermaLink="true">https://www.asia-post.com/country-news/ap2w5dz9dfiw</guid>
      <pubDate>Sat, 21 Nov 2026 00:34:57 +0000</pubDate>
      <enclosure url="https://images.asia-post.com/original_images/ap-343d67-720x405.webp" length="0" type="image/jpeg" />
      <media:content url="https://images.asia-post.com/original_images/ap-343d67-720x405.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://images.asia-post.com/original_images/ap-343d67-720x405.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঘরোয়া দোয়া মাহফিলের ছবি ঘিরে আলোচনা, জগলু চৌধুরীকে গ্রেপ্তারে তৎপর পুলিশ" /&gt;&lt;/p&gt;&lt;p&gt;ঘরোয়া পরিবেশে আয়োজিত একটি দোয়া ও মিলাদ মাহফিলের ছবি সামাজিক যোগাযোগমাধ্যমে প্রকাশ করে নতুন আলোচনার জন্ম দিয়েছেন নিষিদ্ধ ঘোষিত সংগঠন সিলেট জেলা আওয়ামী&lt;/p&gt;</description>
      <source url="https://www.asia-post.com/country-news/ap2w5dz9dfiw">Asia Post</source>
    </item>

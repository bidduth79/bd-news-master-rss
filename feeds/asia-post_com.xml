    <item>
      <title>রাস্তা পার হওয়ার সময় মোটরসাইকেলের ধাক্কা, ইউপি সদস্য নিহত</title>
      <link>https://www.asia-post.com/country-news/ap26hdcflcd1</link>
      <guid isPermaLink="true">https://www.asia-post.com/country-news/ap26hdcflcd1</guid>
      <pubDate>Wed, 25 Nov 2026 20:59:55 +0000</pubDate>
      <enclosure url="https://images.asia-post.com/original_images/tahurul-islam-1dc2fe-720x405.webp" length="0" type="image/jpeg" />
      <media:content url="https://images.asia-post.com/original_images/tahurul-islam-1dc2fe-720x405.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://images.asia-post.com/original_images/tahurul-islam-1dc2fe-720x405.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাস্তা পার হওয়ার সময় মোটরসাইকেলের ধাক্কা, ইউপি সদস্য নিহত" /&gt;&lt;/p&gt;&lt;p&gt;বুধবার সন্ধ্যা সাড়ে ৬টার দিকে খড়গপুর মোড়ে রাস্তা পার হওয়ার সময় দ্রুতগতির একটি মোটরসাইকেল তহুরুল ইসলামকে সজোরে ধাক্কা দেয়। এতে তিনি গুরুতর আহত হন।&lt;/p&gt;</description>
      <source url="https://www.asia-post.com/country-news/ap26hdcflcd1">Asia Post</source>
    </item>

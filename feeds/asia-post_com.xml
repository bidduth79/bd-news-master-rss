    <item>
      <title>টায়ার জ্বালিয়ে সড়ক অবরোধের চেষ্টা নিষিদ্ধ ছাত্রলীগের নেতাকর্মীদের</title>
      <link>https://www.asia-post.com/country-news/aplqrds1ut7x</link>
      <guid isPermaLink="true">https://www.asia-post.com/country-news/aplqrds1ut7x</guid>
      <pubDate>Tue, 10 Nov 2026 06:45:50 +0000</pubDate>
      <enclosure url="https://images.asia-post.com/original_images/Anwara-ae0e06-720x405.webp" length="0" type="image/jpeg" />

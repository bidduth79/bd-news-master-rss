      <link>https://www.asia-post.com/country-news/apcvefjawcwr</link>
      <guid isPermaLink="true">https://www.asia-post.com/country-news/apcvefjawcwr</guid>
      <pubDate>Tue, 10 Nov 2026 07:52:33 +0000</pubDate>
      <enclosure url="https://images.asia-post.com/original_images/EkhlasurRahmanTara-26659a-720x405.webp" length="0" type="image/jpeg" />
      <media:content url="https://images.asia-post.com/original_images/EkhlasurRahmanTara-26659a-720x405.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://images.asia-post.com/original_images/EkhlasurRahmanTara-26659a-720x405.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সীমান্তে সাবেক এমপি গোপন বৈঠকের ভিডিও ভাইরাল, আ.লীগ নেতা আটক" /&gt;&lt;/p&gt;&lt;p&gt;সাবেক প্রধানমন্ত্রী শেখ হাসিনার স্বদেশ প্রত্যাবর্তন উপলক্ষে সিলেট সীমান্তে আওয়ামী লীগের সাবেক সংসদ সদস্য অ্যাডভোকেট রনজিত সরকারের একটি সভা আয়োজনের খবর ও ভিডিও ছড়িয়ে পড়ার পর সুনামগঞ্জে দলটির এক নেতাকে আটক করেছে পুলিশ। 


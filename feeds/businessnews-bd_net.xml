    <item>
      <title>BB Eases External Borrowing Rules for Foreign-Owned Industrial Enterprises</title>
      <link>https://businessnews-bd.net/bb-eases-external-borrowing-rules-for-foreign-owned-industrial-enterprises/</link>
      <guid isPermaLink="true">https://businessnews-bd.net/bb-eases-external-borrowing-rules-for-foreign-owned-industrial-enterprises/</guid>
      <pubDate>Wed, 15 Jul 2026 06:51:52 +0000</pubDate>
      <enclosure url="https://businessnews-bd.net/wp-content/uploads/2024/09/BB-Building-with-Logo-BBN.png" length="0" type="image/jpeg" />
      <media:content url="https://businessnews-bd.net/wp-content/uploads/2024/09/BB-Building-with-Logo-BBN.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://businessnews-bd.net/wp-content/uploads/2024/09/BB-Building-with-Logo-BBN.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="BB Eases External Borrowing Rules for Foreign-Owned Industrial Enterprises" /&gt;&lt;/p&gt;&lt;p&gt;The central bank of Bangladesh has relaxed its regulations on external borrowing by fully foreign-owned industrial enterprises, allowing them to access loans from parent companies, associates, and shareholders abroad under a general authorization framework to facilitate easier access to finance.&lt;/p&gt;</description>
      <source url="https://businessnews-bd.net/bb-eases-external-borrowing-rules-for-foreign-owned-industrial-enterprises/">Bangladesh Business News</source>
    </item>
    <item>
      <title>Bangladesh's Forex Reserves Stay Above $36.5B Despite $1.48B ACU Payment</title>
      <link>https://businessnews-bd.net/bangladeshs-forex-reserves-stay-above-36-5-billion-despite-us1-48-billion-acu-payment/</link>
      <guid isPermaLink="true">https://businessnews-bd.net/bangladeshs-forex-reserves-stay-above-36-5-billion-despite-us1-48-billion-acu-payment/</guid>
      <pubDate>Tue, 07 Jul 2026 15:11:22 +0000</pubDate>
      <enclosure url="https://businessnews-bd.net/wp-content/uploads/2025/10/Dollar-US.webp" length="0" type="image/jpeg" />
      <media:content url="https://businessnews-bd.net/wp-content/uploads/2025/10/Dollar-US.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://businessnews-bd.net/wp-content/uploads/2025/10/Dollar-US.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="Bangladesh's Forex Reserves Stay Above $36.5B Despite $1.48B ACU Payment" /&gt;&lt;/p&gt;&lt;p&gt;Bangladesh's foreign exchange reserves have once again demonstrated resilience. Despite settling US$1.48 billion in import payments to the Asian Clearing Union (ACU), gross reserves remain comfortably above $36.5 billion, underscoring the country's improving external sector position.&lt;/p&gt;</description>
      <source url="https://businessnews-bd.net/bangladeshs-forex-reserves-stay-above-36-5-billion-despite-us1-48-billion-acu-payment/">Bangladesh Business News</source>
    </item>

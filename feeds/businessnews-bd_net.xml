    <item>
      <title>Monthly BDT 32,000 Minimum Wage Proposed for Garment Workers</title>
      <link>https://businessnews-bd.net/monthly-bdt-32000-minimum-wage-proposed-for-garment-workers/</link>
      <guid isPermaLink="true">https://businessnews-bd.net/monthly-bdt-32000-minimum-wage-proposed-for-garment-workers/</guid>
      <pubDate>Mon, 09 Nov 2026 09:14:37 +0000</pubDate>
      <enclosure url="https://businessnews-bd.net/wp-content/uploads/2017/04/RMG-at-factory-wb.jpg" length="0" type="image/jpeg" />
      <media:content url="https://businessnews-bd.net/wp-content/uploads/2017/04/RMG-at-factory-wb.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://businessnews-bd.net/wp-content/uploads/2017/04/RMG-at-factory-wb.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="Monthly BDT 32,000 Minimum Wage Proposed for Garment Workers" /&gt;&lt;/p&gt;&lt;p&gt;Workers' representative on the Minimum Wage Board has proposed BDT 32,000 as the minimum monthly wage for entry-level garment workers, while employers sought four more days to submit their proposal.&lt;/p&gt;</description>
      <source url="https://businessnews-bd.net/monthly-bdt-32000-minimum-wage-proposed-for-garment-workers/">Bangladesh Business News</source>
    </item>
    <item>
      <title>World Bank Approves $300M to Improve Primary Education in Bangladesh</title>
      <link>https://businessnews-bd.net/world-bank-approves-300m-to-improve-primary-education-in-bangladesh/</link>
      <guid isPermaLink="true">https://businessnews-bd.net/world-bank-approves-300m-to-improve-primary-education-in-bangladesh/</guid>
      <pubDate>Sat, 07 Nov 2026 10:23:09 +0000</pubDate>
      <enclosure url="https://businessnews-bd.net/wp-content/uploads/2024/11/World-bank.webp" length="0" type="image/jpeg" />
      <media:content url="https://businessnews-bd.net/wp-content/uploads/2024/11/World-bank.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://businessnews-bd.net/wp-content/uploads/2024/11/World-bank.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="World Bank Approves $300M to Improve Primary Education in Bangladesh" /&gt;&lt;/p&gt;&lt;p&gt;The World Bank (WB) has approved US$300 million to strengthen pre-primary and primary education in Bangladesh, benefiting 26 million children through improved classrooms and learning materials.&lt;/p&gt;</description>
      <source url="https://businessnews-bd.net/world-bank-approves-300m-to-improve-primary-education-in-bangladesh/">Bangladesh Business News</source>
    </item>
    <item>
      <title>Can Stimulus Package Revive Private Investment in Bangladesh?</title>
      <link>https://businessnews-bd.net/can-stimulus-package-revive-private-investment-in-bangladesh/</link>
      <guid isPermaLink="true">https://businessnews-bd.net/can-stimulus-package-revive-private-investment-in-bangladesh/</guid>
      <pubDate>Fri, 28 Aug 2026 18:18:09 +0000</pubDate>
      <enclosure url="https://businessnews-bd.net/wp-content/uploads/2026/05/BDT.jpg" length="0" type="image/jpeg" />
      <media:content url="https://businessnews-bd.net/wp-content/uploads/2026/05/BDT.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://businessnews-bd.net/wp-content/uploads/2026/05/BDT.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="Can Stimulus Package Revive Private Investment in Bangladesh?" /&gt;&lt;/p&gt;&lt;p&gt;The central bank of Bangladesh is mobilising BDT 410 billion from 17 cash-rich banks to support a BDT 600-billion stimulus package aimed at reviving private-sector investment and economic activity.&lt;/p&gt;</description>
      <source url="https://businessnews-bd.net/can-stimulus-package-revive-private-investment-in-bangladesh/">Bangladesh Business News</source>
    </item>
    <item>
      <title>Bangladesh Opens Foreign Currency Guarantee Window</title>
      <link>https://businessnews-bd.net/bangladesh-opens-foreign-currency-guarantee-window/</link>
      <guid isPermaLink="true">https://businessnews-bd.net/bangladesh-opens-foreign-currency-guarantee-window/</guid>
      <pubDate>Thu, 27 Aug 2026 15:57:03 +0000</pubDate>
      <enclosure url="https://businessnews-bd.net/wp-content/uploads/2024/09/BB-Building-with-Logo-BBN.png" length="0" type="image/jpeg" />
      <media:content url="https://businessnews-bd.net/wp-content/uploads/2024/09/BB-Building-with-Logo-BBN.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://businessnews-bd.net/wp-content/uploads/2024/09/BB-Building-with-Logo-BBN.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="Bangladesh Opens Foreign Currency Guarantee Window" /&gt;&lt;/p&gt;&lt;p&gt;The central bank of Bangladesh has allowed banks to issue foreign currency guarantees and standby letters of credit (SBLCs) on behalf of resident entities representing foreign firms that win contracts through international tenders, widening financing support for major projects.&lt;/p&gt;</description>
      <source url="https://businessnews-bd.net/bangladesh-opens-foreign-currency-guarantee-window/">Bangladesh Business News</source>
    </item>
    <item>
      <title>Bangladesh Bank Cuts Policy Rate to 9.5% After 2 Years</title>
      <link>https://businessnews-bd.net/bangladesh-bank-cuts-policy-rate-to-9-5-after-2-years/</link>
      <guid isPermaLink="true">https://businessnews-bd.net/bangladesh-bank-cuts-policy-rate-to-9-5-after-2-years/</guid>
      <pubDate>Thu, 30 Jul 2026 16:23:56 +0000</pubDate>
      <enclosure url="https://businessnews-bd.net/wp-content/uploads/2024/08/BB-building-Logo-BBN.png" length="0" type="image/jpeg" />
      <media:content url="https://businessnews-bd.net/wp-content/uploads/2024/08/BB-building-Logo-BBN.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://businessnews-bd.net/wp-content/uploads/2024/08/BB-building-Logo-BBN.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="Bangladesh Bank Cuts Policy Rate to 9.5% After 2 Years" /&gt;&lt;/p&gt;&lt;p&gt;The central bank of Bangladesh has cut its policy rate, or repo rate, by 50 basis points to 9.5 per cent from the existing level of 10 per cent, marking the first change in the rate since October 2024.&lt;/p&gt;</description>
      <source url="https://businessnews-bd.net/bangladesh-bank-cuts-policy-rate-to-9-5-after-2-years/">Bangladesh Business News</source>
    </item>

    <item>
      <title>দুই বছর কর্মস্থলে অনুপস্থিত থেকেও নিয়মিত বেতন নিচ্ছেন নিষিদ্ধ ছাত্রলীগ নেতা</title>
      <link>https://www.ittefaq.com.bd/820713/%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%B2%E0%A7%87-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AA%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BF%E0%A6%A4-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87%E0%A6%93-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%AE%E0%A6%BF%E0%A6%A4-%E0%A6%AC%E0%A7%87%E0%A6%A4%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820713/%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%B2%E0%A7%87-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AA%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BF%E0%A6%A4-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87%E0%A6%93-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%AE%E0%A6%BF%E0%A6%A4-%E0%A6%AC%E0%A7%87%E0%A6%A4%E0%A6%A8</guid>
      <pubDate>Fri, 13 Nov 2026 11:46:07 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/abdda396b14ef8c6fc8b3a56eeae890a-6af6a38512516.jpg?jadewits_media_id=322504" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/abdda396b14ef8c6fc8b3a56eeae890a-6af6a38512516.jpg?jadewits_media_id=322504" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/abdda396b14ef8c6fc8b3a56eeae890a-6af6a38512516.jpg?jadewits_media_id=322504" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দুই বছর কর্মস্থলে অনুপস্থিত থেকেও নিয়মিত বেতন নিচ্ছেন নিষিদ্ধ ছাত্রলীগ নেতা" /&gt;&lt;/p&gt;&lt;p&gt;কুড়িগ্রামের উলিপুর উপজেলার হাতিয়া ভবেশ আদর্শ উচ্চবিদ্যালয়ের অফিস সহায়ক নজরুল ইসলামের বিরুদ্ধে প্রায় দুই বছর কর্মস্থলে অনুপস্থিত থেকেও নিয়মিত বেতন-ভাতা উত্তোলনের অভিযোগ উঠেছে। এ কাজে বিদ্যালয়ের প্রধান শিক্ষক সহযোগিতা করছেন বলেও অভিযোগ করেছেন স্থানীয় বাসিন্দা ও অভিভাবকেরা। এ ঘটনায় উপজেলা নির্বাহী কর্ম&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820713/%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%B2%E0%A7%87-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AA%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BF%E0%A6%A4-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87%E0%A6%93-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%AE%E0%A6%BF%E0%A6%A4-%E0%A6%AC%E0%A7%87%E0%A6%A4%E0%A6%A8">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>বাংলাদেশ সিরিজের আগে দক্ষিণ আফ্রিকা শিবিরে বড় ধাক্কা</title>
      <link>https://www.ittefaq.com.bd/820712/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%B8%E0%A6%BF%E0%A6%B0%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%87-%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%A3-%E0%A6%86%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE-%E0%A6%B6%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A7%9C</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820712/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%B8%E0%A6%BF%E0%A6%B0%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%87-%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%A3-%E0%A6%86%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE-%E0%A6%B6%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A7%9C</guid>
      <pubDate>Fri, 13 Nov 2026 11:32:25 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/057a774dc4e4e38218605d69549a40e2-6af6a0c98473a.jpg?jadewits_media_id=322503" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/057a774dc4e4e38218605d69549a40e2-6af6a0c98473a.jpg?jadewits_media_id=322503" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/057a774dc4e4e38218605d69549a40e2-6af6a0c98473a.jpg?jadewits_media_id=322503" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাংলাদেশ সিরিজের আগে দক্ষিণ আফ্রিকা শিবিরে বড় ধাক্কা" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশের বিপক্ষে টেস্ট সিরিজ শুরুর আগেই বড় এক ধাক্কা খেয়েছে দক্ষিণ আফ্রিকা। চোটের কারণে জোহানেসবার্গে প্রথম টেস্টে খেলতে পারবেন না গতিময় পেসার এনরিখ নরকিয়া। তবে সিরিজের দ্বিতীয় টেস্টে তাকে পাওয়ার আশা করছে স্বাগতিকেরা।
দক্ষিণ আফ্রিকা ও বাংলাদেশের টেস্ট সিরিজের স্কোয়াডে রাখা হয়েছিল নরকিয়াকে। কিন্তু &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820712/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%B8%E0%A6%BF%E0%A6%B0%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%87-%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%A3-%E0%A6%86%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE-%E0%A6%B6%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A7%9C">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>দেশের বাজারে টানা চতুর্থ দফায় কমলো স্বর্ণের দাম, ভরি ২ লাখ ১৯ হাজার টাকা</title>
      <link>https://www.ittefaq.com.bd/820711/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%9F%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%9A%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%A5-%E0%A6%A6%E0%A6%AB%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A6%AE%E0%A6%B2%E0%A7%8B-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820711/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%9F%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%9A%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%A5-%E0%A6%A6%E0%A6%AB%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A6%AE%E0%A6%B2%E0%A7%8B-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE</guid>
      <pubDate>Fri, 13 Nov 2026 11:31:58 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/f0ab7dcd81d200cb2054271066542255-6af6a05eac9e8.jpg?jadewits_media_id=322502" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/f0ab7dcd81d200cb2054271066542255-6af6a05eac9e8.jpg?jadewits_media_id=322502" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/f0ab7dcd81d200cb2054271066542255-6af6a05eac9e8.jpg?jadewits_media_id=322502" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দেশের বাজারে টানা চতুর্থ দফায় কমলো স্বর্ণের দাম, ভরি ২ লাখ ১৯ হাজার টাকা" /&gt;&lt;/p&gt;&lt;p&gt;টানা চতুর্থ দফায় দেশের বাজারে কমেছে স্বর্ণের দাম। এবার প্রতি ভরিতে দাম কমানো হয়েছে ২ হাজার ১৫৮ টাকা। এতে ভ্যাটসহ ২২ ক্যারেটের প্রতি ভরি (১১ দশমিক ৬৬৪ গ্রাম) স্বর্ণের গয়নার দাম দাঁড়িয়েছে ২ লাখ ১৯ হাজার ৮০৮ টাকা।&amp;nbsp;
শুক্রবার (১৩ নভেম্বর) সকালে এক সংবাদ বিজ্ঞপ্তিতে এ তথ্য জানিয়েছে বাংলাদেশ জুয়েলার্স&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820711/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%9F%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%9A%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%A5-%E0%A6%A6%E0%A6%AB%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A6%AE%E0%A6%B2%E0%A7%8B-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>ডিএমপির অভিযানে ২৪ ঘণ্টায় গ্রেপ্তার ৫৩৪, মামলা ৫৩</title>
      <link>https://www.ittefaq.com.bd/820710/%E0%A6%A1%E0%A6%BF%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A7%A8%E0%A7%AA-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A7%AB%E0%A7%A9%E0%A7%AA-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A7%AB%E0%A7%A9</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820710/%E0%A6%A1%E0%A6%BF%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A7%A8%E0%A7%AA-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A7%AB%E0%A7%A9%E0%A7%AA-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A7%AB%E0%A7%A9</guid>
      <pubDate>Fri, 13 Nov 2026 11:30:45 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/d98819d8c26151460046a56b13e94c90-6af69fe8e3ef7.jpg?jadewits_media_id=322501" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/d98819d8c26151460046a56b13e94c90-6af69fe8e3ef7.jpg?jadewits_media_id=322501" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/d98819d8c26151460046a56b13e94c90-6af69fe8e3ef7.jpg?jadewits_media_id=322501" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডিএমপির অভিযানে ২৪ ঘণ্টায় গ্রেপ্তার ৫৩৪, মামলা ৫৩" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীতে ঢাকা মেট্রোপলিটন পুলিশের (ডিএমপি) বিশেষ অভিযানে গত ২৪ ঘণ্টায় ৫৩৪ জনকে গ্রেপ্তার করা হয়েছে। এ সময় বিভিন্ন অপরাধে ৫৩টি মামলা দায়ের করা হয়েছে।
শুক্রবার (১৩ নভেম্বর) ডিএমপির মিডিয়া অ্যান্ড পাবলিক রিলেশন্স বিভাগ থেকে পাঠানো এক সংবাদ বিজ্ঞপ্তিতে এ তথ্য জানানো হয়।
বিজ্ঞপ্তিতে বলা হয়, রাজধানীর বিভ&lt;/p&gt;</description>

      <pubDate>Thu, 19 Nov 2026 02:59:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/3aeca6fc32109d9199f3f8a9f4937356-6afe08058c489.jpg?jadewits_media_id=323625" length="0" type="image/jpeg" />

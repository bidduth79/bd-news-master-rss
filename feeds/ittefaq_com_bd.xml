    <item>
      <title>যুক্তরাষ্ট্রে রাশিয়ার রাষ্ট্রদূত আলেক্সান্ডার দারচিয়েভের আকস্মিক মৃত্যু</title>
      <link>https://www.ittefaq.com.bd/820452/%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A7%82%E0%A6%A4-%E0%A6%86%E0%A6%B2%E0%A7%87%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820452/%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A7%82%E0%A6%A4-%E0%A6%86%E0%A6%B2%E0%A7%87%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Thu, 12 Nov 2026 00:11:25 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/d3ac343d493acce20fb74c47b4588cc0-6af4afc128747.jpg?jadewits_media_id=322240" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/d3ac343d493acce20fb74c47b4588cc0-6af4afc128747.jpg?jadewits_media_id=322240" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/d3ac343d493acce20fb74c47b4588cc0-6af4afc128747.jpg?jadewits_media_id=322240" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যুক্তরাষ্ট্রে রাশিয়ার রাষ্ট্রদূত আলেক্সান্ডার দারচিয়েভের আকস্মিক মৃত্যু" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাষ্ট্রে নিযুক্ত রাশিয়ার রাষ্ট্রদূত আলেক্সান্ডার দারিচেভ মারা গেছেন। বুধবার (১১ নভেম্বর) ৬৬ বছর বয়সে আকস্মিকভাবে তার মৃত্যু হয়। রাশিয়ার পররাষ্ট্র মন্ত্রণালয় তার মৃত্যুর খবর নিশ্চিত করেছে। তবে তার মৃত্যুর কারণ সম্পর্কে কোনো তথ্য প্রকাশ করেনি মন্ত্রণালয়।
এক বিবৃতিতে মন্ত্রণালয় জানায়, যুক্তরাষ্ট্র&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820452/%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A7%82%E0%A6%A4-%E0%A6%86%E0%A6%B2%E0%A7%87%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A6%BE%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>প্রধানমন্ত্রী তারেক রহমানের সঙ্গে চীনের ভাইস প্রেসিডেন্টের বৈঠক</title>

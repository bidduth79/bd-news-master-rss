      <guid isPermaLink="true">https://www.ittefaq.com.bd/822502/%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%A5-%E0%A6%96%E0%A7%81%E0%A6%81%E0%A6%9C%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A7%8B%E0%A6%B2%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE</guid>
      <pubDate>Mon, 23 Nov 2026 01:22:56 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/6ee92e24f005b725fd47ca5645a7006a-6b03403937f57.jpg?jadewits_media_id=324343" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/6ee92e24f005b725fd47ca5645a7006a-6b03403937f57.jpg?jadewits_media_id=324343" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/6ee92e24f005b725fd47ca5645a7006a-6b03403937f57.jpg?jadewits_media_id=324343" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হাসিনার ফেরার পথ দেখতে পেট্রাপোলে কার্যক্রম নিষিদ্ধ আওয়ামী লীগের ৪ নেতা: ভারতীয় গণমাধ্যম" /&gt;&lt;/p&gt;&lt;p&gt;কার্যক্রম নিষিদ্ধ আওয়ামী লীগের পলাতক চার জ্যেষ্ঠ নেতা পশ্চিমবঙ্গের পেট্রাপোল সীমান্ত এলাকা পরিদর্শন করেছেন বলে জানিয়েছে ভারতের বেশ কয়েকটি গণমাধ্যম। খবরে বলা হয়েছে, গণঅভ্যুত্থানে ক্ষমতাচ্যুত সাবেক প্রধানমন্ত্রী শেখ হাসিনার বাংলাদেশে ফেরার সম্ভাব্য রুট নির্ধারণেই তাদের এই সফর।
রোববার (২২ নভেম্বর) ভার&lt;/p&gt;</description>

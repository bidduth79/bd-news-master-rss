      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/1d56d71f8ab3271269ccb72d05463cd0-6afd0fb4196ba.jpg?jadewits_media_id=323432" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/1d56d71f8ab3271269ccb72d05463cd0-6afd0fb4196ba.jpg?jadewits_media_id=323432" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নেত্রকোনায় পরিত্যক্ত রেল স্টেশনে পেট্রল ঢেলে আগুন" /&gt;&lt;/p&gt;&lt;p&gt;নেত্রকোনার বারহাট্টা উপজেলার পরিত্যক্ত অতিথপুর রেল স্টেশনের প্ল্যাটফর্মে পেট্রল ঢেলে আগুন দিয়েছে দুর্বৃত্তরা। এ ঘটনার ৪১ সেকেন্ডের একটি ভিডিও সামাজিক যোগাযোগমাধ্যমে ছড়িয়ে পড়েছে। ভিডিওটি ছড়িয়ে পড়ার পর বিষয়টি স্থানীয়দের নজরে আসে।
পুলিশ সূত্রে জানা গেছে, মঙ্গলবার (১৭ নভেম্বর) রাত ১১টা থেকে ১২টার মধ্যে &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821607/%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%B0%E0%A7%87%E0%A6%B2-%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B6%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%B2-%E0%A6%A2%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>ঘন কুয়াশায় পাটুরিয়া-দৌলতদিয়া রুটে ফেরি চলাচল বন্ধ</title>
      <link>https://www.ittefaq.com.bd/821606/%E0%A6%98%E0%A6%A8-%E0%A6%95%E0%A7%81%E0%A7%9F%E0%A6%BE%E0%A6%B6%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A6%BE%E0%A6%9F%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE-%E0%A6%A6%E0%A7%8C%E0%A6%B2%E0%A6%A4%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A6%BE-%E0%A6%B0%E0%A7%81%E0%A6%9F%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BF-%E0%A6%9A%E0%A6%B2%E0%A6%BE%E0%A6%9A%E0%A6%B2-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821606/%E0%A6%98%E0%A6%A8-%E0%A6%95%E0%A7%81%E0%A7%9F%E0%A6%BE%E0%A6%B6%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A6%BE%E0%A6%9F%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE-%E0%A6%A6%E0%A7%8C%E0%A6%B2%E0%A6%A4%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A6%BE-%E0%A6%B0%E0%A7%81%E0%A6%9F%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BF-%E0%A6%9A%E0%A6%B2%E0%A6%BE%E0%A6%9A%E0%A6%B2-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7</guid>
      <pubDate>Wed, 18 Nov 2026 08:32:55 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/7d920905f7f66883740e42ee3af3a43e-6afd0e1be2a46.jpg?jadewits_media_id=323431" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/7d920905f7f66883740e42ee3af3a43e-6afd0e1be2a46.jpg?jadewits_media_id=323431" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/7d920905f7f66883740e42ee3af3a43e-6afd0e1be2a46.jpg?jadewits_media_id=323431" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঘন কুয়াশায় পাটুরিয়া-দৌলতদিয়া রুটে ফেরি চলাচল বন্ধ" /&gt;&lt;/p&gt;&lt;p&gt;ঘন কুয়াশার কারণে দেশের দক্ষিণ-পশ্চিমাঞ্চলের গুরুত্বপূর্ণ প্রবেশদ্বার হিসেবে পরিচিত দৌলতদিয়া-পাটুরিয়া নৌরুটে ফেরি চলাচল বন্ধ রয়েছে।
বুধবার (১৮ নভেম্বর) সকাল পৌনে ৬টা থেকে এ রুটে ফেরি চলাচল বন্ধ রয়েছে।
জানা গেছে, পদ্মা নদীর অববাহিকায় কুয়াশার ঘনত্ব বেড়ে যাওয়ার কারণে চ্যানেলের বিকন বাতি ও মার্কিং পয়েন্ট&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821606/%E0%A6%98%E0%A6%A8-%E0%A6%95%E0%A7%81%E0%A7%9F%E0%A6%BE%E0%A6%B6%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A6%BE%E0%A6%9F%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE-%E0%A6%A6%E0%A7%8C%E0%A6%B2%E0%A6%A4%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A6%BE-%E0%A6%B0%E0%A7%81%E0%A6%9F%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BF-%E0%A6%9A%E0%A6%B2%E0%A6%BE%E0%A6%9A%E0%A6%B2-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7">দৈনিক ইত্তেফাক</source>
    </item>
    <item>

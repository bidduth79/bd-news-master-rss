      <guid isPermaLink="true">https://www.ittefaq.com.bd/821982/%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%B7%E0%A6%A6-%E0%A6%AC%E0%A6%BF%E0%A6%AD%E0%A6%BE%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A6%AF%E0%A6%BC</guid>
      <pubDate>Fri, 20 Nov 2026 01:26:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/2ae6be30460b939a35c5205e5cf6c443-6aff4a54e79bb.jpg?jadewits_media_id=323819" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/2ae6be30460b939a35c5205e5cf6c443-6aff4a54e79bb.jpg?jadewits_media_id=323819" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/2ae6be30460b939a35c5205e5cf6c443-6aff4a54e79bb.jpg?jadewits_media_id=323819" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মন্ত্রিপরিষদ বিভাগের কোটায় পাওয়া সরকারি বাসায় ভাড়াটিয়া পাওয়া গেলে বরাদ্দ বাতিল" /&gt;&lt;/p&gt;&lt;p&gt;মন্ত্রিপরিষদ বিভাগের কোটায় বরাদ্দ পাওয়া সরকারি বাসা বা ফ্ল্যাটের সম্পূর্ণ অংশ কিংবা কোনো কক্ষ ভাড়া বা সাবলেট দেওয়া সম্পূর্ণ নিষিদ্ধ করা হয়েছে। এরই মধ্যে যারা সরকারি বাসা বা ফ্ল্যাটের কোনো অংশ ভাড়া দিয়েছেন, তাদের আগামী ৩০ নভেম্বরের মধ্যে ভাড়াটিয়া সরিয়ে নিতে কঠোর নির্দেশ দেওয়া হয়েছে।
বৃহস্&lt;/p&gt;</description>

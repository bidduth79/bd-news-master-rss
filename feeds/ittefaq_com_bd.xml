      <guid isPermaLink="true">https://www.ittefaq.com.bd/821198/%E0%A6%AF%E0%A6%B6%E0%A7%8B%E0%A6%B0-%E0%A6%B8%E0%A7%80%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AB%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%A4%E0%A6%A5%E0%A7%8D%E0%A6%AF-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%87</guid>
      <pubDate>Mon, 16 Nov 2026 00:56:14 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/e6dffe86df5f3bf8ff2093784e753d53-6af9fc852900d.jpg?jadewits_media_id=323012" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/e6dffe86df5f3bf8ff2093784e753d53-6af9fc852900d.jpg?jadewits_media_id=323012" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/e6dffe86df5f3bf8ff2093784e753d53-6af9fc852900d.jpg?jadewits_media_id=323012" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যশোর সীমান্ত দিয়ে ফ্যাসিবাদীদের আগমনের তথ্য দিলে পুরস্কার দেবে বিজিবি" /&gt;&lt;/p&gt;&lt;p&gt;যশোর সীমান্ত দিয়ে ফ্যাসিবাদী গোষ্ঠীর সদস্যদের দেশে প্রবেশের তথ্য দিলে তথ্যদাতাকে পুরস্কৃত করার ঘোষণা দিয়েছে বর্ডার গার্ড বাংলাদেশ (বিজিবি)। একই সঙ্গে তথ্যদাতার ব্যক্তিগত পরিচয় ও ফোন নম্বর গোপন রাখার আশ্বাস দিয়েছে বাহিনীটি।
রোববার (১৫ নভেম্বর) বেলা সাড়ে তিনটার দিকে যশোর সদর উপজেলার ঝুমঝুমপুর এলাকায় ৪&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821198/%E0%A6%AF%E0%A6%B6%E0%A7%8B%E0%A6%B0-%E0%A6%B8%E0%A7%80%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AB%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%A4%E0%A6%A5%E0%A7%8D%E0%A6%AF-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%87">দৈনিক ইত্তেফাক</source>

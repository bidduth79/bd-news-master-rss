    <item>
      <title>জনবলের অভাবে চালু হয়নি ময়মনসিংহের ৭ কোটি টাকার শান্তি নিবাস, নষ্ট হচ্ছে আসবাবপত্র</title>
      <link>https://www.ittefaq.com.bd/822193/%E0%A6%9C%E0%A6%A8%E0%A6%AC%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A7%81-%E0%A6%B9%E0%A6%AF%E0%A6%BC%E0%A6%A8%E0%A6%BF-%E0%A6%AE%E0%A6%AF%E0%A6%BC%E0%A6%AE%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%82%E0%A6%B9%E0%A7%87%E0%A6%B0-%E0%A7%AD-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822193/%E0%A6%9C%E0%A6%A8%E0%A6%AC%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A7%81-%E0%A6%B9%E0%A6%AF%E0%A6%BC%E0%A6%A8%E0%A6%BF-%E0%A6%AE%E0%A6%AF%E0%A6%BC%E0%A6%AE%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%82%E0%A6%B9%E0%A7%87%E0%A6%B0-%E0%A7%AD-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Sat, 21 Nov 2026 14:22:48 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/85c8e34ddfc8957727802907fbc105cb-6b0154a15d6c0.jpg?jadewits_media_id=324032" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/85c8e34ddfc8957727802907fbc105cb-6b0154a15d6c0.jpg?jadewits_media_id=324032" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/85c8e34ddfc8957727802907fbc105cb-6b0154a15d6c0.jpg?jadewits_media_id=324032" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জনবলের অভাবে চালু হয়নি ময়মনসিংহের ৭ কোটি টাকার শান্তি নিবাস, নষ্ট হচ্ছে আসবাবপত্র" /&gt;&lt;/p&gt;&lt;p&gt;উদ্বোধনের পর তিন বছর পেরিয়ে গেলেও জনবল ও পরিচালনা বরাদ্দের অভাবে ময়মনসিংহের প্রায় ৭ কোটি টাকা ব্যয়ে নির্মিত প্রবীণ আশ্রয়কেন্দ্র &amp;lsquo;শান্তি নিবাস&amp;rsquo; এখনো চালু হয়নি। ময়মনসিংহ নগরের শম্ভুগঞ্জে সরকারি শিশু পরিবার (বালক) চত্বরে নির্মিত ২৫ শয্যার এই তিনতলা ভবন তালাবদ্ধ অবস্থায় পড়ে থাকায় ধ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822193/%E0%A6%9C%E0%A6%A8%E0%A6%AC%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A7%81-%E0%A6%B9%E0%A6%AF%E0%A6%BC%E0%A6%A8%E0%A6%BF-%E0%A6%AE%E0%A6%AF%E0%A6%BC%E0%A6%AE%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%82%E0%A6%B9%E0%A7%87%E0%A6%B0-%E0%A7%AD-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0">দৈনিক ইত্তেফাক</source>

    <item>
      <title>অর্থনীতির অগ্রযাত্রা বাধাগ্রস্ত করতে তৎপর দুর্বৃত্তরা: অর্থমন্ত্রী</title>
      <link>https://www.ittefaq.com.bd/822144/%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%85%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%C2%A0%E0%A6%AC%E0%A6%BE%E0%A6%A7%E0%A6%BE%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822144/%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%85%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%C2%A0%E0%A6%AC%E0%A6%BE%E0%A6%A7%E0%A6%BE%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87</guid>
      <pubDate>Sat, 21 Nov 2026 07:00:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/cd824aafa0d7a1a1675c05c293f73a9b-6b00ad5ac9d10.jpg?jadewits_media_id=323982" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/cd824aafa0d7a1a1675c05c293f73a9b-6b00ad5ac9d10.jpg?jadewits_media_id=323982" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/cd824aafa0d7a1a1675c05c293f73a9b-6b00ad5ac9d10.jpg?jadewits_media_id=323982" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অর্থনীতির অগ্রযাত্রা বাধাগ্রস্ত করতে তৎপর দুর্বৃত্তরা: অর্থমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;দেশের অর্থনৈতিক অগ্রযাত্রা বাধাগ্রস্ত করতে একটি স্বার্থানেষী মহল তত্পর রয়েছে বলে মন্তব্য করেছেন অর্থ ও পরিকল্পনামন্ত্রী আমির খসরু মাহমুদ চৌধুরী। তিনি বলেন, দেশের উন্নয়ন ও অর্থনৈতিক অগ্রগতি কোনো একক পক্ষের দায়িত্ব নয়। সরকার, রাজনীতিবিদ, ব্যবসায়ীসহ সমাজের সব শ্রেণি-পেশার মানুষকে নিজ নিজ অবস্থান থেকে ঐ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822144/%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%85%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%C2%A0%E0%A6%AC%E0%A6%BE%E0%A6%A7%E0%A6%BE%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>

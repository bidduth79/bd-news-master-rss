      <guid isPermaLink="true">https://www.ittefaq.com.bd/821017/%E0%A6%AE%E0%A7%8B%E0%A6%9F%E0%A6%B0%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%87%E0%A6%B2%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%81%E0%A6%9A%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%97%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%89%E0%A6%B2%E0%A7%8D%E0%A6%9F%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%B2%E0%A7%8B-%E0%A6%9F%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A7%81-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%95</guid>
      <pubDate>Sun, 15 Nov 2026 00:44:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/d3b021b76a05c834b751dac992d81a1f-6af8a768d012f.jpg?jadewits_media_id=322821" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/d3b021b76a05c834b751dac992d81a1f-6af8a768d012f.jpg?jadewits_media_id=322821" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/d3b021b76a05c834b751dac992d81a1f-6af8a768d012f.jpg?jadewits_media_id=322821" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মোটরসাইকেলকে বাঁচাতে গিয়ে উল্টে গেল টেম্পু, চালক নিহত" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রামের হাটহাজারীতে মোটরসাইকেলটিকে বাঁচাতে গিয়ে টেম্পু গাড়ি (টিকটিকি) সড়কের ওপর উল্টে মো. সুমন (২৭) নামের এক সিএনজিচালিত টেম্পুচালক নিহত হয়েছেন। শনিবার (১৪ নভেম্বর) সন্ধ্যা সাড়ে ৭টার দিকে উপজেলার মির্জাপুর ইউনিয়নের হাটহাজারী-নাজিরহাট আঞ্চলিক মহাসড়কে এ দুর্ঘটনা ঘটে।
নিহত সুমন খাগড়াছড়ি জেলার গুই&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821017/%E0%A6%AE%E0%A7%8B%E0%A6%9F%E0%A6%B0%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%87%E0%A6%B2%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%81%E0%A6%9A%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%97%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%89%E0%A6%B2%E0%A7%8D%E0%A6%9F%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%B2%E0%A7%8B-%E0%A6%9F%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A7%81-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%95">দৈনিক ইত্তেফাক</source>

      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/6f091620756f359c02204c87fbb59387-6b048531c192a.jpg?jadewits_media_id=324530" length="0" type="image/jpeg" />

      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/eabd10f84768cbdb5e0c3153b7d1734d-6af8300b00584.jpg?jadewits_media_id=322730" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/eabd10f84768cbdb5e0c3153b7d1734d-6af8300b00584.jpg?jadewits_media_id=322730" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/eabd10f84768cbdb5e0c3153b7d1734d-6af8300b00584.jpg?jadewits_media_id=322730" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নারীদের জন্য ১০০ বৈদ্যুতিক বাস কিনছে সরকার" /&gt;&lt;/p&gt;&lt;p&gt;গণপরিবহনে নারীদের ভোগান্তি কমাতে ১০০টি বৈদ্যুতিক বাস কিনছে সরকার। এ জন্য চার্জিং স্টেশন ও অবকাঠামো নির্মাণসহ মোট ৪০০ কোটি টাকা বরাদ্দ দেওয়া হয়েছে। সবকিছু ঠিক থাকলে আগামী বছরের ২৫ ফেব্রুয়ারির মধ্যেই বিআরটিসির কাছে বাসগুলো হস্তান্তর করা হবে।
চলতি বছরের ২৯ অক্টোবর অর্থ বিভাগ এ অর্থ বরাদ্দ দেয়। এরপর সড়ক&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820932/%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A7%A7%E0%A7%A6%E0%A7%A6-%E0%A6%AC%E0%A7%88%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%AC%E0%A6%BE%E0%A6%B8-%E0%A6%95%E0%A6%BF%E0%A6%A8%E0%A6%9B%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>সমন্বয়ক মাহদীর বাসায় পেট্রোল বোমা হামলার অভিযোগ, পুলিশ বলছে ‘নাটক’</title>

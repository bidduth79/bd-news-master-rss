      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/300bb4c7a58b6a9775d558105a691eef-6b0a97e7239f4.jpg?jadewits_media_id=325317" length="0" type="image/jpeg" />

    <item>
      <title>অলিম্পিক বাছাইপর্বের সব ম্যাচ ঢাকায় করার পরিকল্পনা বিসিবির</title>
      <link>https://www.ittefaq.com.bd/822413/%E0%A6%85%E0%A6%B2%E0%A6%BF%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A6%95-%E0%A6%AC%E0%A6%BE%E0%A6%9B%E0%A6%BE%E0%A6%87%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AC-%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9A-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A6%A8%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822413/%E0%A6%85%E0%A6%B2%E0%A6%BF%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A6%95-%E0%A6%AC%E0%A6%BE%E0%A6%9B%E0%A6%BE%E0%A6%87%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AC-%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9A-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A6%A8%E0%A6%BE</guid>
      <pubDate>Sun, 22 Nov 2026 16:47:54 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/14eefe438fc16108b724b8ddbee7745a-6b02c854331b0.jpg?jadewits_media_id=324254" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/14eefe438fc16108b724b8ddbee7745a-6b02c854331b0.jpg?jadewits_media_id=324254" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/14eefe438fc16108b724b8ddbee7745a-6b02c854331b0.jpg?jadewits_media_id=324254" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অলিম্পিক বাছাইপর্বের সব ম্যাচ ঢাকায় করার পরিকল্পনা বিসিবির" /&gt;&lt;/p&gt;&lt;p&gt;২০২৮ সালে লস অ্যাঞ্জেলসে হবে অলিম্পিক আসর। এই আসর দিয়ে দীর্ঘ ১২৮ বছর পর অলিম্পিকে ফিরতে যাচ্ছে ক্রিকেট। অলিম্পিক ক্রিকেটে পুরুষদের চূড়ান্ত বাছাইপর্ব আয়োজনের দায়িত্ব পেয়েছে বাংলাদেশ।&amp;nbsp;
সূচি অনুযায়ী, ২০২৮ সালের ৫ থেকে ১৩ ফেব্রুয়ারি অনুষ্ঠিত হবে পুরুষদের চূড়ান্ত বাছাইপর্ব। আর অলিম্পিক বাছাইয়ের সব ম&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822413/%E0%A6%85%E0%A6%B2%E0%A6%BF%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A6%95-%E0%A6%AC%E0%A6%BE%E0%A6%9B%E0%A6%BE%E0%A6%87%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AC-%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9A-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A6%A8%E0%A6%BE">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>ডাকসুর ভিপি সাদিক কায়েমের বাড়িতে হামলাকারী ৩ জন শনাক্ত</title>
      <link>https://www.ittefaq.com.bd/822412/%E0%A6%A1%E0%A6%BE%E0%A6%95%E0%A6%B8%E0%A7%81%E0%A6%B0-%E0%A6%AD%E0%A6%BF%E0%A6%AA%E0%A6%BF-%E0%A6%B8%E0%A6%BE%E0%A6%A6%E0%A6%BF%E0%A6%95-%E0%A6%95%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A7%A9-%E0%A6%9C%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822412/%E0%A6%A1%E0%A6%BE%E0%A6%95%E0%A6%B8%E0%A7%81%E0%A6%B0-%E0%A6%AD%E0%A6%BF%E0%A6%AA%E0%A6%BF-%E0%A6%B8%E0%A6%BE%E0%A6%A6%E0%A6%BF%E0%A6%95-%E0%A6%95%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A7%A9-%E0%A6%9C%E0%A6%A8</guid>
      <pubDate>Sun, 22 Nov 2026 16:45:33 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/d9314313a7c4919cadbab8c6775092c6-6b02c74056316.jpg?jadewits_media_id=324253" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/d9314313a7c4919cadbab8c6775092c6-6b02c74056316.jpg?jadewits_media_id=324253" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/d9314313a7c4919cadbab8c6775092c6-6b02c74056316.jpg?jadewits_media_id=324253" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডাকসুর ভিপি সাদিক কায়েমের বাড়িতে হামলাকারী ৩ জন শনাক্ত" /&gt;&lt;/p&gt;&lt;p&gt;ঢাকা বিশ্ববিদ্যালয় কেন্দ্রীয় ছাত্র সংসদের (ডাকসু) সহসভাপতি (ভিপি) সাদিক কায়েমের খাগড়াছড়ির গ্রামের বাড়িতে পেট্রোলবোমা নিক্ষেপ ও অগ্নিসংযোগের চেষ্টার ঘটনায় জড়িত সন্দেহে তিনজনকে শনাক্ত করেছে পুলিশ। সিসিটিভি ফুটেজ বিশ্লেষণ করে চারজনের মধ্যে তিনজনের পরিচয় নিশ্চিত হওয়া গেছে। তাদের আটকের জন্য অভিযান চালাচ্&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822412/%E0%A6%A1%E0%A6%BE%E0%A6%95%E0%A6%B8%E0%A7%81%E0%A6%B0-%E0%A6%AD%E0%A6%BF%E0%A6%AA%E0%A6%BF-%E0%A6%B8%E0%A6%BE%E0%A6%A6%E0%A6%BF%E0%A6%95-%E0%A6%95%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A7%A9-%E0%A6%9C%E0%A6%A8">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>‘সন্তান-প্রীতি’তে মন সাবেক প্রেস সেক্রেটারির, ট্রাম্পের আক্ষেপ—আমাকে কম ভালোবাসে!</title>
      <link>https://www.ittefaq.com.bd/822411/%E2%80%98%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%A4%E0%A6%BF%E2%80%99%E0%A6%A4%E0%A7%87-%E0%A6%AE%E0%A6%A8-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B8-%E0%A6%B8%E0%A7%87%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822411/%E2%80%98%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%A4%E0%A6%BF%E2%80%99%E0%A6%A4%E0%A7%87-%E0%A6%AE%E0%A6%A8-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B8-%E0%A6%B8%E0%A7%87%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%B0</guid>
      <pubDate>Sun, 22 Nov 2026 16:42:03 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/606e816b66fe9b639ffc9f56ee9c51da-6b02c6a7c0ac2.jpg?jadewits_media_id=324252" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/606e816b66fe9b639ffc9f56ee9c51da-6b02c6a7c0ac2.jpg?jadewits_media_id=324252" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/606e816b66fe9b639ffc9f56ee9c51da-6b02c6a7c0ac2.jpg?jadewits_media_id=324252" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘সন্তান-প্রীতি’তে মন সাবেক প্রেস সেক্রেটারির, ট্রাম্পের আক্ষেপ—আমাকে কম ভালোবাসে!" /&gt;&lt;/p&gt;&lt;p&gt;হোয়াইট হাউসের সাবেক প্রেস সেক্রেটারি ক্যারোলিন লেভিটের কাজের ভূয়সী প্রশংসা করেছেন যুক্তরাষ্ট্রের প্রেসিডেন্ট ডোনাল্ড ট্রাম্প। দায়িত্ব পালনে ক্যারোলিনের অসামান্য দক্ষতার কথা তুলে ধরে তিনি জানান, তার যোগ্য বিকল্প খুঁজে পাওয়া এখন রীতিমতো কঠিন হয়ে পড়েছে। 
তবে পরিবারকে সময় দিতে হোয়াইট হাউস ছেড়ে যাওয়া এই&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822411/%E2%80%98%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%A4%E0%A6%BF%E2%80%99%E0%A6%A4%E0%A7%87-%E0%A6%AE%E0%A6%A8-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B8-%E0%A6%B8%E0%A7%87%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>১৬ বছরের কম বয়সী শিশুদের সামাজিক মাধ্যম ব্যবহারে নীতিমালা প্রণয়নের নির্দেশ হাইকোর্টের</title>
      <link>https://www.ittefaq.com.bd/822410/%E0%A7%A7%E0%A7%AC-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%AE-%E0%A6%AC%E0%A7%9F%E0%A6%B8%E0%A7%80-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%9C%E0%A6%BF%E0%A6%95-%E0%A6%AE%E0%A6%BE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A6%AE-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822410/%E0%A7%A7%E0%A7%AC-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%AE-%E0%A6%AC%E0%A7%9F%E0%A6%B8%E0%A7%80-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%9C%E0%A6%BF%E0%A6%95-%E0%A6%AE%E0%A6%BE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A6%AE-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A7%87</guid>
      <pubDate>Sun, 22 Nov 2026 16:41:11 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/f8deaaeebf8199cd9569a6af6ccab6fe-6b02c69482d51.jpg?jadewits_media_id=324251" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/f8deaaeebf8199cd9569a6af6ccab6fe-6b02c69482d51.jpg?jadewits_media_id=324251" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/f8deaaeebf8199cd9569a6af6ccab6fe-6b02c69482d51.jpg?jadewits_media_id=324251" style="max-width:100%;height:auto;margin-bottom:10px;" alt="১৬ বছরের কম বয়সী শিশুদের সামাজিক মাধ্যম ব্যবহারে নীতিমালা প্রণয়নের নির্দেশ হাইকোর্টের" /&gt;&lt;/p&gt;&lt;p&gt;১৬ বছর বা এর কম বয়সী শিশু-কিশোরদের সামাজিক যোগাযোগমাধ্যম বা সোশ্যাল মিডিয়া ব্যবহার নিয়ন্ত্রণে নীতিমালা প্রণয়নে স্বাধীন বিশেষজ্ঞ কমিটি গঠনে সরকারের সংশ্লিষ্ট কর্তৃপক্ষকে নির্দেশ দিয়েছেন হাইকোর্ট।
রোববার (২২ নভেম্বর) বিচারপতি শিকদার মো. মাহমুদুর রাজী ও বিচারপতি ফাতেমা আনোয়ারের হাইকোর্ট বেঞ্চ এ আদেশ দে&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822410/%E0%A7%A7%E0%A7%AC-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%AE-%E0%A6%AC%E0%A7%9F%E0%A6%B8%E0%A7%80-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%9C%E0%A6%BF%E0%A6%95-%E0%A6%AE%E0%A6%BE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A6%AE-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A7%87">দৈনিক ইত্তেফাক</source>

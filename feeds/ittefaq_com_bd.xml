      <guid isPermaLink="true">https://www.ittefaq.com.bd/821609/%E0%A6%B0%E0%A6%BE%E0%A6%B6%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%AC%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%AC%E0%A6%BF%E0%A6%A7%E0%A7%8D%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A4-%E0%A7%A7%E0%A7%AF-%E0%A6%86%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A7%80%E0%A6%B0-%E0%A6%B8%E0%A6%AC%E0%A6%BE%E0%A6%87-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4</guid>
      <pubDate>Wed, 18 Nov 2026 08:47:34 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/709dcbb28a06e2febb3f4f879aedc955-6afd10c1cd31c.jpg?jadewits_media_id=323435" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/709dcbb28a06e2febb3f4f879aedc955-6afd10c1cd31c.jpg?jadewits_media_id=323435" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/709dcbb28a06e2febb3f4f879aedc955-6afd10c1cd31c.jpg?jadewits_media_id=323435" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাশিয়ায় সামরিক বিমান বিধ্বস্ত, নিহত সবাই" /&gt;&lt;/p&gt;&lt;p&gt;রাশিয়ার সাইবেরিয়া অঞ্চলের কেমেরোভোতে একটি ‘এএন-১২’ সামরিক পরিবহন বিমান বিধ্বস্ত হয়ে ১৯ আরোহী নিহত হয়েছেন। মঙ্গলবার (১৭ নভেম্বর) দেশটির প্রতিরক্ষা মন্ত্রণালয় এই তথ্য জানিয়েছে। এর আগে গণমাধ্যমের প্রাথমিক প্রতিবেদনে মৃতের সংখ্যা ১৭ বলে উল্লেখ করা হয়েছিল।
এক বিবৃতিতে প্রতিরক্ষা মন্ত্রণালয় জানিয়ে&lt;/p&gt;</description>

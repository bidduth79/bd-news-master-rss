    <item>
      <title>মওলানা ভাসানী ছিলেন মুক্তিসংগ্রামের এক অবিস্মরণীয় ব্যক্তিত্ব: রাষ্ট্রপতি</title>
      <link>https://www.ittefaq.com.bd/821421/%E0%A6%AE%E0%A6%93%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%AD%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A6%A8%E0%A7%80-%E0%A6%9B%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B8%E0%A6%82%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%8F%E0%A6%95-%E0%A6%85%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AE%E0%A6%B0%E0%A6%A3%E0%A7%80%E0%A7%9F</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821421/%E0%A6%AE%E0%A6%93%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%AD%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A6%A8%E0%A7%80-%E0%A6%9B%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B8%E0%A6%82%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%8F%E0%A6%95-%E0%A6%85%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AE%E0%A6%B0%E0%A6%A3%E0%A7%80%E0%A7%9F</guid>
      <pubDate>Tue, 17 Nov 2026 09:21:41 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/72022b11d73e003aad38ea6c989bd5c3-6afbc75d97697.jpg?jadewits_media_id=323237" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/72022b11d73e003aad38ea6c989bd5c3-6afbc75d97697.jpg?jadewits_media_id=323237" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/72022b11d73e003aad38ea6c989bd5c3-6afbc75d97697.jpg?jadewits_media_id=323237" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মওলানা ভাসানী ছিলেন মুক্তিসংগ্রামের এক অবিস্মরণীয় ব্যক্তিত্ব: রাষ্ট্রপতি" /&gt;&lt;/p&gt;&lt;p&gt;রাষ্ট্রপতি মির্জা ফখরুল ইসলাম আলমগীর বলেছেন, মওলানা আবদুল হামিদ খান ভাসানী ছিলেন উপমহাদেশের রাজনীতি এবং মুক্তিসংগ্রামের এক অবিস্মরণীয় ব্যক্তিত্ব।
তিনি বলেন, দীর্ঘ বর্ণাঢ্য রাজনৈতিক জীবনে তিনি শোষণ, বঞ্চনা, বৈষম্য ও অন্যায়ের বিরুদ্ধে সোচ্চার ছিলেন এবং কৃষক, শ্রমিক ও সাধারণ মেহনতি মানুষের অধিকার প্রতি&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821421/%E0%A6%AE%E0%A6%93%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%AD%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A6%A8%E0%A7%80-%E0%A6%9B%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B8%E0%A6%82%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%8F%E0%A6%95-%E0%A6%85%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AE%E0%A6%B0%E0%A6%A3%E0%A7%80%E0%A7%9F">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>পাকিস্তান-ভারত ফুটবল যুদ্ধ, সাফ ফাইনালের বাঁশি</title>
      <link>https://www.ittefaq.com.bd/821420/%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4-%E0%A6%AB%E0%A7%81%E0%A6%9F%E0%A6%AC%E0%A6%B2-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%B8%E0%A6%BE%E0%A6%AB-%E0%A6%AB%E0%A6%BE%E0%A6%87%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%81%E0%A6%B6%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821420/%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4-%E0%A6%AB%E0%A7%81%E0%A6%9F%E0%A6%AC%E0%A6%B2-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%B8%E0%A6%BE%E0%A6%AB-%E0%A6%AB%E0%A6%BE%E0%A6%87%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%81%E0%A6%B6%E0%A6%BF</guid>
      <pubDate>Tue, 17 Nov 2026 09:17:17 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/e95a7fd942365366bb36b614c044f9d5-6afbc5514c059.jpg?jadewits_media_id=323231" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/e95a7fd942365366bb36b614c044f9d5-6afbc5514c059.jpg?jadewits_media_id=323231" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/e95a7fd942365366bb36b614c044f9d5-6afbc5514c059.jpg?jadewits_media_id=323231" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পাকিস্তান-ভারত ফুটবল যুদ্ধ, সাফ ফাইনালের বাঁশি" /&gt;&lt;/p&gt;&lt;p&gt;পাকিস্তান-ভারত দুই দেশের রাজনৈতিক অস্থিরতা লেগেই আছে। মুখ দেখা দেখিও বন্ধ থাকে। এই অস্থিরতার প্রভাব পড়েছে ক্রিকেটেও। মাঠে গিয়ে হাত মেলাতে না চাওয়ার দৃষ্টিকটু ছবির কথাও সবার জানা। এমনকি পাকিস্তান যাচ্ছে না ভারতে খেলতে। ভারত যাচ্ছে না পাকিস্তানে খেলতে। এভাবেই চলছে দুই দেশের সম্পর্কেও টানাপড়েন।&amp;nbsp;
র&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821420/%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4-%E0%A6%AB%E0%A7%81%E0%A6%9F%E0%A6%AC%E0%A6%B2-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%B8%E0%A6%BE%E0%A6%AB-%E0%A6%AB%E0%A6%BE%E0%A6%87%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%81%E0%A6%B6%E0%A6%BF">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>ইরানকে ‘অনন্ত যুদ্ধে’ পরিণত হতে দেবেন না ট্রাম্প: ভ্যান্স</title>
      <link>https://www.ittefaq.com.bd/821419/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A6%95%E0%A7%87-%E2%80%98%E0%A6%85%E0%A6%A8%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87%E2%80%99-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%A3%E0%A6%A4-%E0%A6%B9%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%AC%E0%A7%87%E0%A6%A8-%E0%A6%A8%E0%A6%BE-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821419/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A6%95%E0%A7%87-%E2%80%98%E0%A6%85%E0%A6%A8%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87%E2%80%99-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%A3%E0%A6%A4-%E0%A6%B9%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%AC%E0%A7%87%E0%A6%A8-%E0%A6%A8%E0%A6%BE-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA</guid>
      <pubDate>Tue, 17 Nov 2026 09:16:03 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/bc142874174fefee565f2be357ee82e0-6afbc6d13e821.jpg?jadewits_media_id=323236" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/bc142874174fefee565f2be357ee82e0-6afbc6d13e821.jpg?jadewits_media_id=323236" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/bc142874174fefee565f2be357ee82e0-6afbc6d13e821.jpg?jadewits_media_id=323236" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইরানকে ‘অনন্ত যুদ্ধে’ পরিণত হতে দেবেন না ট্রাম্প: ভ্যান্স" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাষ্ট্রের প্রেসিডেন্ট ডোনাল্ড ট্রাম্প মধ্যপ্রাচ্যে তৃতীয় মার্কিন বিমানবাহী রণতরি পাঠালেও ইরান পরিস্থিতিকে &amp;lsquo;অনন্ত যুদ্ধে&amp;rsquo; পরিণত হতে দেবেন না বলে দাবি করেছেন ভাইস প্রেসিডেন্ট জেডি ভ্যান্স। মঙ্গলবার (১৭ নভেম্বর) গালফ নিউজের এক প্রতিবেদনে এই খবর জানানো হয়েছে।
ফক্স নিউজকে দেওয়া এক সাক্&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821419/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A6%95%E0%A7%87-%E2%80%98%E0%A6%85%E0%A6%A8%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87%E2%80%99-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%A3%E0%A6%A4-%E0%A6%B9%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%AC%E0%A7%87%E0%A6%A8-%E0%A6%A8%E0%A6%BE-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA">দৈনিক ইত্তেফাক</source>
    </item>

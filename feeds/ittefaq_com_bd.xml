      <guid isPermaLink="true">https://www.ittefaq.com.bd/820803/%E0%A6%86%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B8-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%8B%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A6%BF-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A7%87-%E0%A7%A8%E0%A7%A9-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3%E0%A6%B9%E0%A6%BE%E0%A6%A8%E0%A6%BF</guid>
      <pubDate>Fri, 13 Nov 2026 20:05:57 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/879348499a248dad0926b9a160c3b826-6af7190c21138.jpg?jadewits_media_id=322601" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/879348499a248dad0926b9a160c3b826-6af7190c21138.jpg?jadewits_media_id=322601" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/879348499a248dad0926b9a160c3b826-6af7190c21138.jpg?jadewits_media_id=322601" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আসামে বাস-ট্রাকের মুখোমুখি সংঘর্ষে ২৩ প্রাণহানি" /&gt;&lt;/p&gt;&lt;p&gt;আসামের কাজিরাঙায় ট্রাক ও মিনিবাসের মুখোমুখি সংঘর্ষে অন্তত ২৩ জন নিহত এবং সাতজন আহত হয়েছেন। আহতদের কয়েকজনের অবস্থা আশঙ্কাজনক হওয়ায় নিহতের সংখ্যা আরও বাড়তে পারে। বৃহস্পতিবার (১২ নভেম্বর) কাজিরাঙার কাছে রংগাজান এলাকায় এ দুর্ঘটনা ঘটে।
সংশ্লিষ্ট কর্তৃপক্ষ জানিয়েছে, বোকাখাত থেকে নওগাঁওয়ের দিকে যাচ্ছিল একট&lt;/p&gt;</description>

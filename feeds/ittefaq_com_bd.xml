      <guid isPermaLink="true">https://www.ittefaq.com.bd/820343/%E0%A6%85%E0%A6%9C%E0%A6%BF%E0%A6%A4-%E0%A6%A6%E0%A7%8B%E0%A6%AD%E0%A6%BE%E0%A6%B2-%E0%A6%93-%E0%A6%B0-%E0%A6%8F%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8</guid>
      <pubDate>Wed, 11 Nov 2026 16:14:13 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/d3b80cbdda97089d55be989684c4be90-6af43fc00ab53.jpg?jadewits_media_id=322131" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/d3b80cbdda97089d55be989684c4be90-6af43fc00ab53.jpg?jadewits_media_id=322131" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/d3b80cbdda97089d55be989684c4be90-6af43fc00ab53.jpg?jadewits_media_id=322131" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অজিত দোভাল ও র-এর সাবেক প্রধানের বিরুদ্ধে মার্কিন আদালতের সমন, ‘বিদ্বেষপূর্ণ’ বলল ভারত" /&gt;&lt;/p&gt;&lt;p&gt;ভারতের জাতীয় নিরাপত্তা উপদেষ্টা অজিত দোভাল এবং র&amp;ndash;এর সাবেক প্রধান সামন্ত গোয়েলের বিরুদ্ধে যুক্তরাষ্ট্রের একটি আদালত দেওয়ানি সমন জারি করেছেন। ভারত সরকার গতকাল মঙ্গলবার এই সমনকে &amp;lsquo;বানানো ও বিদ্বেষপূর্ণ&amp;rsquo; বলে উল্লেখ করেছে। তাদের অভিযোগ, একটা দাবির ওপর ভিত্তি করে দায়ের করা এটি &amp;lsquo;ত&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820343/%E0%A6%85%E0%A6%9C%E0%A6%BF%E0%A6%A4-%E0%A6%A6%E0%A7%8B%E0%A6%AD%E0%A6%BE%E0%A6%B2-%E0%A6%93-%E0%A6%B0-%E0%A6%8F%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8">দৈনিক ইত্তেফাক</source>

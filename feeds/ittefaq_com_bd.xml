    <item>
      <title>আহত বিজিবি সদস্যদের দেখতে পিলখানায় স্বরাষ্ট্রমন্ত্রী</title>
      <link>https://www.ittefaq.com.bd/823418/%E0%A6%86%E0%A6%B9%E0%A6%A4-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%AC%E0%A6%BF-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%BF%E0%A6%B2%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A7%9F</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823418/%E0%A6%86%E0%A6%B9%E0%A6%A4-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%AC%E0%A6%BF-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%BF%E0%A6%B2%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A7%9F</guid>
      <pubDate>Sat, 28 Nov 2026 14:36:57 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/c617f1284498bef359dbc9c7aa2479b0-6b0a9255f0c7e.jpg?jadewits_media_id=325313" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/c617f1284498bef359dbc9c7aa2479b0-6b0a9255f0c7e.jpg?jadewits_media_id=325313" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/c617f1284498bef359dbc9c7aa2479b0-6b0a9255f0c7e.jpg?jadewits_media_id=325313" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আহত বিজিবি সদস্যদের দেখতে পিলখানায় স্বরাষ্ট্রমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জ ও গাজীপুরে আইনশৃঙ্খলা রক্ষায় দায়িত্ব পালনকালে আহত বর্ডার গার্ড বাংলাদেশের (বিজিবি) সদস্যদের দেখতে রাজধানীর পিলখানা বিজিবি সদর দপ্তরে শহীদ জাকির হোসেন বিজিবি হাসপাতালে যান স্বরাষ্ট্রমন্ত্রী সালাহউদ্দিন আহমদ।
শনিবার (২৮ নভেম্বর) দুপুর সাড়ে ১২টার দিকে হাসপাতালে যান তিনি। এ সময় হাসপাতালে আহত ব&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823418/%E0%A6%86%E0%A6%B9%E0%A6%A4-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%AC%E0%A6%BF-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%BF%E0%A6%B2%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A7%9F">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>সাবেক তথ্যমন্ত্রী হাছান মাহমুদের চাচাতো ভাই গ্রেপ্তার</title>

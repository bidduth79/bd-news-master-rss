    <item>
      <title>জাতীয় গ্রিডে পারমাণবিক বিদ্যুৎ—নূতন মাইলফলক</title>
      <link>https://www.ittefaq.com.bd/821598/%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A6%AF%E0%A6%BC-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%A1%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%AE%E0%A6%BE%E0%A6%A3%E0%A6%AC%E0%A6%BF%E0%A6%95-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A7%8E%E2%80%94%E0%A6%A8%E0%A7%82%E0%A6%A4%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A6%AB%E0%A6%B2%E0%A6%95</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821598/%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A6%AF%E0%A6%BC-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%A1%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%AE%E0%A6%BE%E0%A6%A3%E0%A6%AC%E0%A6%BF%E0%A6%95-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A7%8E%E2%80%94%E0%A6%A8%E0%A7%82%E0%A6%A4%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A6%AB%E0%A6%B2%E0%A6%95</guid>
      <pubDate>Wed, 18 Nov 2026 03:30:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2025/03/11/01bd9f25252561a677fb8c828c703ffa-67cff76a8ea1b.jpg?jadewits_media_id=215097" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2025/03/11/01bd9f25252561a677fb8c828c703ffa-67cff76a8ea1b.jpg?jadewits_media_id=215097" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2025/03/11/01bd9f25252561a677fb8c828c703ffa-67cff76a8ea1b.jpg?jadewits_media_id=215097" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জাতীয় গ্রিডে পারমাণবিক বিদ্যুৎ—নূতন মাইলফলক" /&gt;&lt;/p&gt;&lt;p&gt;অর্থনৈতিক অগ্রগতির নেপথ্যে একটি দেশের যেই কয়েকটি জ্বালানি-শক্তি বিশেষ ভূমিকা রাখে&amp;mdash; বিদ্যুৎ তাহাদের অন্যতম। শিল্পকারখানা, কৃষি, যোগাযোগ, চিকিৎসা, শিক্ষা, তথ্যপ্রযুক্তি, এমনকি মানুষের দৈনন্দিন জীবনযাত্রাও বিদ্যুতের উপর নির্ভরশীল। বিদ্যুৎ সরবরাহে অনিশ্চয়তা থাকিলে বিনিয়োগ বাধাগ্রস্ত হয়, উৎপাদন&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821598/%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A6%AF%E0%A6%BC-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%A1%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%AE%E0%A6%BE%E0%A6%A3%E0%A6%AC%E0%A6%BF%E0%A6%95-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A7%8E%E2%80%94%E0%A6%A8%E0%A7%82%E0%A6%A4%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A6%AB%E0%A6%B2%E0%A6%95">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>বিএনপি নেতার ছেলের নেতৃত্বে ছাত্রলীগের মিছিল, পদ গেল বাবার</title>
      <link>https://www.ittefaq.com.bd/821597/%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%9B%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%AA%E0%A6%A6</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821597/%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%9B%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%AA%E0%A6%A6</guid>
      <pubDate>Wed, 18 Nov 2026 03:07:23 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/92340a8eead6eb9dbf7f71bd17cb8f6e-6afcc189e05ec.jpg?jadewits_media_id=323423" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/92340a8eead6eb9dbf7f71bd17cb8f6e-6afcc189e05ec.jpg?jadewits_media_id=323423" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/92340a8eead6eb9dbf7f71bd17cb8f6e-6afcc189e05ec.jpg?jadewits_media_id=323423" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিএনপি নেতার ছেলের নেতৃত্বে ছাত্রলীগের মিছিল, পদ গেল বাবার" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রামের রাউজানে চট্টগ্রাম-রাঙামাটি মহাসড়কে টায়ার জ্বালিয়ে, ককটেল বিস্ফোরণ ঘটিয়ে এবং ফাঁকা গুলি ছুড়ে নাশকতার চেষ্টা চালিয়েছে দুর্বৃত্তরা। এর মাত্র ১৮ ঘণ্টা আগে একই এলাকায় নিষিদ্ধ ঘোষিত সংগঠন ছাত্রলীগের একটি ঝটিকা মিছিল অনুষ্ঠিত হয়। পুলিশের ভাষ্যমতে, ওই মিছিলে সামনে থেকে নেতৃত্ব দিয়েছেন কদলপুর ইউন&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821597/%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%9B%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%AA%E0%A6%A6">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>‘হাসিনা ফিরবে না, না মানে না’</title>
      <link>https://www.ittefaq.com.bd/821596/%E2%80%98%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A6%AC%E0%A7%87-%E0%A6%A8%E0%A6%BE-%E0%A6%A8%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%A8%E0%A6%BE%E2%80%99</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821596/%E2%80%98%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A6%AC%E0%A7%87-%E0%A6%A8%E0%A6%BE-%E0%A6%A8%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%A8%E0%A6%BE%E2%80%99</guid>
      <pubDate>Wed, 18 Nov 2026 02:38:10 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/0200b92827f98a66cc0106cae1979d2c-6afcbaf1e7351.jpg?jadewits_media_id=323422" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/0200b92827f98a66cc0106cae1979d2c-6afcbaf1e7351.jpg?jadewits_media_id=323422" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/0200b92827f98a66cc0106cae1979d2c-6afcbaf1e7351.jpg?jadewits_media_id=323422" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘হাসিনা ফিরবে না, না মানে না’" /&gt;&lt;/p&gt;&lt;p&gt;কার্যক্রম নিষিদ্ধ থাকা আওয়ামী লীগের নেতা-কর্মীদের উদ্দেশে কঠোর হুঁশিয়ারি দিয়েছেন ঢাকা বিশ্ববিদ্যালয় (ঢাবি) ছাত্রদলের যুগ্ম সাধারণ সম্পাদক আবিদুল ইসলাম খান। মঙ্গলবার (১৭ নভেম্বর) রাতে নিজের ভেরিফায়েড ফেসবুক আইডিতে দেওয়া এক পোস্টে তিনি দলটির রাজনৈতিক পুনরুত্থানের সম্ভাবনা নাকচ করে দিয়ে দেশব্যাপী কঠোর &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821596/%E2%80%98%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A6%AC%E0%A7%87-%E0%A6%A8%E0%A6%BE-%E0%A6%A8%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%A8%E0%A6%BE%E2%80%99">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>ঢাকার এসপির বাসার সামনে জোড়া ককটেল বিস্ফোরণ</title>
      <link>https://www.ittefaq.com.bd/821595/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%8F%E0%A6%B8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%9C%E0%A7%8B%E0%A7%9C%E0%A6%BE-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821595/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%8F%E0%A6%B8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%9C%E0%A7%8B%E0%A7%9C%E0%A6%BE-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3</guid>
      <pubDate>Wed, 18 Nov 2026 02:05:27 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/ce1aeea5d99c5bd294eb715b82653437-6afcb2ce67e42.jpg?jadewits_media_id=323421" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/ce1aeea5d99c5bd294eb715b82653437-6afcb2ce67e42.jpg?jadewits_media_id=323421" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/ce1aeea5d99c5bd294eb715b82653437-6afcb2ce67e42.jpg?jadewits_media_id=323421" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঢাকার এসপির বাসার সামনে জোড়া ককটেল বিস্ফোরণ" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর রমনা থানা এলাকায় ঢাকা জেলার পুলিশ সুপারের বাসভবনের ফটকের সামনে দুটি ককটেল ফাটানো হয়েছে।
মঙ্গলবার (১৭ নভেম্বর) রাত ১০টার দিকের বিস্ফোরণের এ ঘটনায় প্রাথমিকভাবে কারও হতাহত হওয়ার খবর নেই বলে জানিয়েছে পুলিশ।
রাত সাড়ে ১২টার দিকে রমনা বিভাগের উপ-পুলিশ কমিশনার শেখ জাহিদুল ইসলাম বলেন, রাত ১০টার দিকে&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821595/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%8F%E0%A6%B8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%9C%E0%A7%8B%E0%A7%9C%E0%A6%BE-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>নেত্রকোনায় আবারও রেললাইনে আগুন</title>
      <link>https://www.ittefaq.com.bd/821594/%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%86%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A6%93-%E0%A6%B0%E0%A7%87%E0%A6%B2%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821594/%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%86%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A6%93-%E0%A6%B0%E0%A7%87%E0%A6%B2%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</guid>
      <pubDate>Wed, 18 Nov 2026 01:51:18 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/ba39af082dcf4d147d01e460b8d7bd84-6afcb00cee6ee.jpg?jadewits_media_id=323420" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/ba39af082dcf4d147d01e460b8d7bd84-6afcb00cee6ee.jpg?jadewits_media_id=323420" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/ba39af082dcf4d147d01e460b8d7bd84-6afcb00cee6ee.jpg?jadewits_media_id=323420" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নেত্রকোনায় আবারও রেললাইনে আগুন" /&gt;&lt;/p&gt;&lt;p&gt;নেত্রকোনায় আবারও রেললাইনে অগ্নিসংযোগের ঘটনা ঘটেছে। জেলার বারহাট্টা ও ঠাকুরাকোনা রেলস্টেশনের মধ্যবর্তী পাটলি এলাকার একটি কালভার্টের ওপর রেললাইনে আগুন ধরিয়ে দেয় দুর্বৃত্তরা। মঙ্গলবার বিকেল ৫টার দিকে এ ঘটনা ঘটে। তবে স্থানীয় বাসিন্দাদের তৎপরতায় দ্রুত আগুন নিভিয়ে ফেলায় বড় ধরনের কোনো দুর্ঘটনা বা ক্ষয়ক্ষতি&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821594/%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%86%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A6%93-%E0%A6%B0%E0%A7%87%E0%A6%B2%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>আজ হোক বা কাল, প্রতিটি ফুটেজ ও ছবি দেখে সবাইকে আইনের আওতায় আনা হবে: স্বরাষ্ট্রমন্ত্রী</title>

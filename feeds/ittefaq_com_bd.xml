      <guid isPermaLink="true">https://www.ittefaq.com.bd/821617/%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%80-%E0%A6%86%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A7%AA%E0%A7%AA.%E0%A7%AC-%E0%A6%B6%E0%A6%A4%E0%A6%BE%E0%A6%82%E0%A6%B6-%E0%A6%8F%E0%A6%B8%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%9B%E0%A7%9F-%E0%A6%89%E0%A6%AA%E0%A6%B8%E0%A6%BE%E0%A6%97%E0%A6%B0%E0%A7%80%E0%A7%9F</guid>
      <pubDate>Wed, 18 Nov 2026 09:23:16 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/fba5b5b8c04e07683e4c722e83996acd-6afd1973450bb.jpg?jadewits_media_id=323442" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/fba5b5b8c04e07683e4c722e83996acd-6afd1973450bb.jpg?jadewits_media_id=323442" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/fba5b5b8c04e07683e4c722e83996acd-6afd1973450bb.jpg?jadewits_media_id=323442" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চার মাসে প্রবাসী আয়ের ৪৪.৬ শতাংশ এসেছে ছয় উপসাগরীয় দেশ থেকে" /&gt;&lt;/p&gt;&lt;p&gt;চলতি ২০২৬-২৭ অর্থবছরের প্রথম চার মাসে (জুলাই-অক্টোবর) দেশে আসা প্রবাসী আয়ের ৪৪ দশমিক ৬ শতাংশ এসেছে মধ্যপ্রাচ্যের ছয়টি উপসাগরীয় দেশ থেকে। দেশগুলো হলো সৌদি আরব, সংযুক্ত আরব আমিরাত (ইউএই), কুয়েত, ওমান, কাতার ও বাহরাইন। এতে বাংলাদেশের বৈদেশিক মুদ্রা অর্জনে মধ্যপ্রাচ্যের শ্রমবাজারের গুরুত্বপূর্ণ ভূমিকা আ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821617/%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%80-%E0%A6%86%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A7%AA%E0%A7%AA.%E0%A7%AC-%E0%A6%B6%E0%A6%A4%E0%A6%BE%E0%A6%82%E0%A6%B6-%E0%A6%8F%E0%A6%B8%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%9B%E0%A7%9F-%E0%A6%89%E0%A6%AA%E0%A6%B8%E0%A6%BE%E0%A6%97%E0%A6%B0%E0%A7%80%E0%A7%9F">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>পিরোজপুরে দুই বাসে আগুন, প্রাণ গেল ঘুমন্ত হেলপারের</title>
      <link>https://www.ittefaq.com.bd/821616/%E0%A6%AA%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%9C%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3-%E0%A6%97%E0%A7%87%E0%A6%B2-%E0%A6%98%E0%A7%81%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%B9%E0%A7%87%E0%A6%B2%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821616/%E0%A6%AA%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%9C%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3-%E0%A6%97%E0%A7%87%E0%A6%B2-%E0%A6%98%E0%A7%81%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%B9%E0%A7%87%E0%A6%B2%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Wed, 18 Nov 2026 09:22:14 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/9deba164e60b5d0e9fae5255b59191d6-6afd195ce264b.jpg?jadewits_media_id=323441" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/9deba164e60b5d0e9fae5255b59191d6-6afd195ce264b.jpg?jadewits_media_id=323441" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/9deba164e60b5d0e9fae5255b59191d6-6afd195ce264b.jpg?jadewits_media_id=323441" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পিরোজপুরে দুই বাসে আগুন, প্রাণ গেল ঘুমন্ত হেলপারের" /&gt;&lt;/p&gt;&lt;p&gt;পিরোজপুরের ভান্ডারিয়ায় বাসস্ট্যান্ডে দাঁড়িয়ে থাকা দুটি বাসে আগুন দিয়েছে দুর্বৃত্তরা। এ ঘটনায় একটি বাসের ভেতরে ঘুমিয়ে থাকা মো. সিয়াম নামে এক হেলপারের মৃত্যু হয়েছে। বুধবার (১৮ নভেম্বর) ভোর ৪টার দিকে এ ঘটনা ঘটে।
ভান্ডারিয়া থানার ভারপ্রাপ্ত কর্মকর্তা (ওসি) মো. জগলুল হাসান বিষয়টি নিশ্চিত করেছেন। নিহত সিয়&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821616/%E0%A6%AA%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%9C%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3-%E0%A6%97%E0%A7%87%E0%A6%B2-%E0%A6%98%E0%A7%81%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%B9%E0%A7%87%E0%A6%B2%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>

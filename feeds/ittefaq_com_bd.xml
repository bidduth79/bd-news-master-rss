      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/2bffe8fef1788618f4401b3589a4222d-6af756a9885b3.jpg?jadewits_media_id=322643" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/2bffe8fef1788618f4401b3589a4222d-6af756a9885b3.jpg?jadewits_media_id=322643" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ক্ষমতার অপব্যবহার করলে আইনের আওতায় আনা হবে: প্রতিমন্ত্রী আব্দুল বারী" /&gt;&lt;/p&gt;&lt;p&gt;ক্ষমতার অপব্যবহার বা কারও ওপর অন্যায়-অত্যাচার করা হলে, তাকে আইনের আওতায় আনা হবে বলে জানিয়েছেন জনপ্রশাসন ও খাদ্য প্রতিমন্ত্রী আব্দুল বারী।
শুক্রবার (১৩ নভেম্বর) বেলা আড়াইটায় উপজেলা পরিষদ হলরুমে অনুষ্ঠিত সভায় এ কথা বলেন তিনি। &amp;lsquo;সর্বজনীন সামাজিক অবকাঠামো উন্নয়ন প্রকল্প-২&amp;rsquo; (জিএসআইডি-২) আওতায় &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820845/%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%AE%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%AA%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B9%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87-%E0%A6%86%E0%A6%87%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%93%E0%A6%A4%E0%A6%BE%E0%A7%9F-%E0%A6%86%E0%A6%A8%E0%A6%BE-%E0%A6%B9%E0%A6%AC%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>সরকারি সহযোগিতা পেতে কাউকে টাকা দেবেন না: সমাজকল্যাণমন্ত্রী</title>
      <link>https://www.ittefaq.com.bd/820843/%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%B8%E0%A6%B9%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A6%BF%E0%A6%A4%E0%A6%BE-%E0%A6%AA%E0%A7%87%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%89%E0%A6%95%E0%A7%87-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%AC%E0%A7%87%E0%A6%A8-%E0%A6%A8%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820843/%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%B8%E0%A6%B9%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A6%BF%E0%A6%A4%E0%A6%BE-%E0%A6%AA%E0%A7%87%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%89%E0%A6%95%E0%A7%87-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%AC%E0%A7%87%E0%A6%A8-%E0%A6%A8%E0%A6%BE</guid>
      <pubDate>Sat, 14 Nov 2026 00:11:02 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/252dc3efc3787103d24e321062525616-6af7529e7908c.jpg?jadewits_media_id=322640" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/252dc3efc3787103d24e321062525616-6af7529e7908c.jpg?jadewits_media_id=322640" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/252dc3efc3787103d24e321062525616-6af7529e7908c.jpg?jadewits_media_id=322640" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সরকারি সহযোগিতা পেতে কাউকে টাকা দেবেন না: সমাজকল্যাণমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;সরকারের যে কোনো ধরনের সহযোগিতা পেতে কাউকে কোনো টাকা-পয়সা দিতে হয় না। কেউ টাকা দাবি করলে তাকে টাকা না দেওয়ার আহ্বান জানিয়েছেন নারী ও শিশুবিষয়ক এবং সমাজকল্যাণমন্ত্রী অধ্যাপক ডা. এ জেড এম জাহিদ হোসেন। একই সঙ্গে দেশকে মাদকমুক্ত রাখা এবং চাঁদাবাজি, সন্ত্রাস ও দখলদারত্বের বিরুদ্ধে সামাজিক প্রতিরোধ গড়ে তু&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820843/%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%B8%E0%A6%B9%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A6%BF%E0%A6%A4%E0%A6%BE-%E0%A6%AA%E0%A7%87%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%89%E0%A6%95%E0%A7%87-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%AC%E0%A7%87%E0%A6%A8-%E0%A6%A8%E0%A6%BE">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>আখতারুজ্জামানের ছেলের ওপর হামলার মামলায় বিএনপি-জামায়াত পাল্টাপাল্টি অবস্থানে উত্তপ্ত কটিয়াদী রাজনীতি</title>

      <guid isPermaLink="true">https://www.ittefaq.com.bd/821090/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%AD%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A6%B9-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A7%A7%E0%A7%A8-%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3%E0%A6%B9%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%86%E0%A6%B9%E0%A6%A4-%E0%A7%A7%E0%A7%AC</guid>
      <pubDate>Sun, 15 Nov 2026 14:26:49 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/aa56b13395cf2031f10493ed3ad18fdf-6af96cc711cdc.jpg?jadewits_media_id=322895" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/aa56b13395cf2031f10493ed3ad18fdf-6af96cc711cdc.jpg?jadewits_media_id=322895" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/aa56b13395cf2031f10493ed3ad18fdf-6af96cc711cdc.jpg?jadewits_media_id=322895" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইরানে ভয়াবহ দুর্ঘটনায় ১২ জনের প্রাণহানি, আহত ১৬" /&gt;&lt;/p&gt;&lt;p&gt;ইরানের পশ্চিমাঞ্চলে গ্যাস শোধনাগারের কর্মীদের বহনকারী একটি বাস দুর্ঘটনায় পড়ে উল্টে গেলে ১২ জন নিহত হয়েছেন। এ ঘটনায় আহত হয়েছেন আরও ১৬ জন। আহতদের ইলাম, দেহলোরান, দেজফুল ও আবদানানের বিভিন্ন হাসপাতালে নেওয়া হয়েছে।
রোববার (১৫ নভেম্বর) ইরানের রাষ্ট্রীয় সংবাদমাধ্যম আইআরএনএর প্রতিবেদনে এ তথ্য জানানো হয়।
প্র&lt;/p&gt;</description>

      <guid isPermaLink="true">https://www.ittefaq.com.bd/822126/%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%8B%E0%A6%9F-%E0%A6%8B%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A7%A9%E0%A7%AB-%E0%A6%B6%E0%A6%A4%E0%A6%BE%E0%A6%82%E0%A6%B6-%E0%A6%8F%E0%A6%B8%E0%A6%8F%E0%A6%AE%E0%A6%87-%E0%A6%96%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A7%A8%E0%A7%A6-%E0%A6%B6%E0%A6%A4%E0%A6%BE%E0%A6%82%E0%A6%B6</guid>
      <pubDate>Fri, 20 Nov 2026 22:59:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/6f2e8244e1112297a77a6d5f21127c24-6b00753c30977.jpg?jadewits_media_id=323963" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/6f2e8244e1112297a77a6d5f21127c24-6b00753c30977.jpg?jadewits_media_id=323963" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/6f2e8244e1112297a77a6d5f21127c24-6b00753c30977.jpg?jadewits_media_id=323963" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ব্যাংকের মোট ঋণের ৩৫ শতাংশ এসএমই খাতে ২০ শতাংশ খুচরা ব্যাংকিংয়ে চান গভর্নর" /&gt;&lt;/p&gt;&lt;p&gt;আগামী বছরের মধ্যে দেশের বাণিজ্যিক ব্যাংকগুলোর মোট ঋণের ৩৫ শতাংশ ক্ষুদ্র ও মাঝারি শিল্প (এসএমই) খাতে এবং ২০ শতাংশ খুচরা ব্যাংকিং (রিটেইল ব্যাংকিং) খাতে বিতরণ নিশ্চিত করতে হবে বলে জানিয়েছেন বাংলাদেশ ব্যাংকের গভর্নর মো. মোস্তাকুর রহমান। একই সঙ্গে করপোরেট খাতে ব্যাংকের ঋণ ৪০ শতাংশের মধ্যে সীমাবদ্ধ রাখার&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822126/%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%8B%E0%A6%9F-%E0%A6%8B%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A7%A9%E0%A7%AB-%E0%A6%B6%E0%A6%A4%E0%A6%BE%E0%A6%82%E0%A6%B6-%E0%A6%8F%E0%A6%B8%E0%A6%8F%E0%A6%AE%E0%A6%87-%E0%A6%96%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A7%A8%E0%A7%A6-%E0%A6%B6%E0%A6%A4%E0%A6%BE%E0%A6%82%E0%A6%B6">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>ইসরায়েলের রাষ্ট্রীয় পরিচয় কোনো নির্দিষ্ট ধর্মের ভিত্তিতে হওয়া উচিত নয়: মার্কিন সিনেটর</title>

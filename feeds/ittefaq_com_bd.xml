    <item>
      <title>রিয়াদে ফের ড্রোন হামলা চালিয়েছে ইয়েমেনি বিদ্রোহীরা</title>
      <link>https://www.ittefaq.com.bd/820995/%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A6%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0-%E0%A6%A1%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%A8-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%87%E0%A7%9F%E0%A7%87%E0%A6%AE%E0%A7%87%E0%A6%A8%E0%A6%BF-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A7%80%E0%A6%B0%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820995/%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A6%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0-%E0%A6%A1%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%A8-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%87%E0%A7%9F%E0%A7%87%E0%A6%AE%E0%A7%87%E0%A6%A8%E0%A6%BF-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A7%80%E0%A6%B0%E0%A6%BE</guid>
      <pubDate>Sat, 14 Nov 2026 21:20:51 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/d05b8b4ce49b76a80da8c3c485b008f0-6af87c4dbb3f8.jpg?jadewits_media_id=322798" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/d05b8b4ce49b76a80da8c3c485b008f0-6af87c4dbb3f8.jpg?jadewits_media_id=322798" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/d05b8b4ce49b76a80da8c3c485b008f0-6af87c4dbb3f8.jpg?jadewits_media_id=322798" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রিয়াদে ফের ড্রোন হামলা চালিয়েছে ইয়েমেনি বিদ্রোহীরা" /&gt;&lt;/p&gt;&lt;p&gt;সৌদি আরবের রাজধানী রিয়াদ ও দেশটির দক্ষিণাঞ্চল লক্ষ্য করে ড্রোন হামলা চালিয়েছে ইরান-সমর্থিত ইয়েমেনের হুথি বিদ্রোহীরা।
শনিবার (১৪ নভেম্বর) হুথিদের ছোড়া ওই দুটি ড্রোন মাঝ-আকাশে ধ্বংস করে দেওয়া হয়েছে বলে জানিয়েছে সৌদি নেতৃত্বাধীন সামরিক জোট।
সৌদি জোট বলছে, রাজধানী রিয়াদ ও দক্ষিণাঞ্চলের দিকে ছোড়া ইয়েম&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820995/%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A6%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0-%E0%A6%A1%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%A8-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%87%E0%A7%9F%E0%A7%87%E0%A6%AE%E0%A7%87%E0%A6%A8%E0%A6%BF-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A7%80%E0%A6%B0%E0%A6%BE">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>অযৌক্তিক মজুরি ঘোষণার প্রেক্ষাপট তৈরি করা হচ্ছে: বিজিএমইএ সভাপতি</title>

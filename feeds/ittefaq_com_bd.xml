    <item>
      <title>টাঙ্গাইলে শিশু শিক্ষার্থীকে যৌন নিপীড়নের অভিযোগে শিক্ষক বরখাস্ত</title>
      <link>https://www.ittefaq.com.bd/820252/%E0%A6%9F%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%87-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%AF%E0%A7%8C%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A6%AA%E0%A7%80%E0%A7%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820252/%E0%A6%9F%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%87-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%AF%E0%A7%8C%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A6%AA%E0%A7%80%E0%A7%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%87</guid>
      <pubDate>Wed, 11 Nov 2026 02:28:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/35253e7bd9fbb78c6b37ce018e17b85c-6af375ed78086.jpg?jadewits_media_id=322038" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/35253e7bd9fbb78c6b37ce018e17b85c-6af375ed78086.jpg?jadewits_media_id=322038" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/35253e7bd9fbb78c6b37ce018e17b85c-6af375ed78086.jpg?jadewits_media_id=322038" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টাঙ্গাইলে শিশু শিক্ষার্থীকে যৌন নিপীড়নের অভিযোগে শিক্ষক বরখাস্ত" /&gt;&lt;/p&gt;&lt;p&gt;টাঙ্গাইলের মির্জাপুরে কোমলমতি এক শিশু শিক্ষার্থীকে যৌন নিপীড়নের অভিযোগে তপন সরকার নামে এক সরকারি প্রাথমিক বিদ্যালয়ের সহকারী শিক্ষককে সাময়িক বরখাস্ত করা হয়েছে।
মঙ্গলবার (১০ নভেম্বর) টাঙ্গাইল জেলা প্রাথমিক শিক্ষা কর্মকর্তা (ডিপিও) মো. মাহিন মিয়া স্বাক্ষরিত এক আদেশে অভিযুক্ত শিক্ষককে বরখাস্তের এ সিদ্ধা&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820252/%E0%A6%9F%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%87-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%AF%E0%A7%8C%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A6%AA%E0%A7%80%E0%A7%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%87">দৈনিক ইত্তেফাক</source>

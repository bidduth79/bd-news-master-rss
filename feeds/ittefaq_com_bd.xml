      <guid isPermaLink="true">https://www.ittefaq.com.bd/821210/%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%87-%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A6%BE%E0%A6%97%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE</guid>
      <pubDate>Mon, 16 Nov 2026 03:24:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/75872961251cec49931b33d3a034345c-6afa1ec7f08cf.jpg?jadewits_media_id=323023" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/75872961251cec49931b33d3a034345c-6afa1ec7f08cf.jpg?jadewits_media_id=323023" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/75872961251cec49931b33d3a034345c-6afa1ec7f08cf.jpg?jadewits_media_id=323023" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নাশকতার অভিযোগে তুরাগে নিষিদ্ধ ছাত্রলীগ নেতা গ্রেপ্তার" /&gt;&lt;/p&gt;&lt;p&gt;নাশকতামূলক কর্মকাণ্ডের সঙ্গে জড়িত থাকার অভিযোগে রাজধানীর তুরাগে ৫৪ নম্বর ওয়ার্ড ছাত্রলীগের দপ্তর সম্পাদক মো. শাকিল খান ওরফে জয়কে (২৪) গ্রেপ্তার করেছে পুলিশ।
রোববার (১৫ নভেম্বর) রাত ৯ টা ৫০ মিনিটে তুরাগ থানার কামারপাড়া ২০ নম্বর রোড থেকে তাকে গ্রেপ্তার করা হয়।
তুরাগ থানা-পুলিশ জানায়, থানার ভারপ্রাপ্ত &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821210/%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%87-%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A6%BE%E0%A6%97%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE">দৈনিক ইত্তেফাক</source>
    </item>

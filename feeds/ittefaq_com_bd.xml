    <item>
      <title>কোস্টারিকাকে ৭-০ গোলে হারাল আর্জেন্টিনা</title>
      <link>https://www.ittefaq.com.bd/821610/%E0%A6%95%E0%A7%8B%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A7%AD-%E0%A7%A6-%E0%A6%97%E0%A7%8B%E0%A6%B2%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%B2-%E0%A6%86%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%A8%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821610/%E0%A6%95%E0%A7%8B%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A7%AD-%E0%A7%A6-%E0%A6%97%E0%A7%8B%E0%A6%B2%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%B2-%E0%A6%86%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%A8%E0%A6%BE</guid>
      <pubDate>Wed, 18 Nov 2026 08:45:40 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/555b617b4b3081d2e2ef9e83d889c506-6afd10d07e643.jpg?jadewits_media_id=323436" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/555b617b4b3081d2e2ef9e83d889c506-6afd10d07e643.jpg?jadewits_media_id=323436" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/555b617b4b3081d2e2ef9e83d889c506-6afd10d07e643.jpg?jadewits_media_id=323436" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কোস্টারিকাকে ৭-০ গোলে হারাল আর্জেন্টিনা" /&gt;&lt;/p&gt;&lt;p&gt;বছরের শেষ আন্তর্জাতিক প্রীতি ম্যাচে দুর্দান্ত পারফরম্যান্স দেখিয়েছে আর্জেন্টিনা। লিওনেল স্কালোনির শিষ্যরা ৭&amp;ndash;০ গোলের বড় ব্যবধানে উড়িয়ে দিয়েছে কোস্টারিকাকে। ম্যাচে জোড়া গোলের কৃতিত্ব দেখিয়েছেন নিকো পাজ, হুলিয়ান আলভারেজ ও ফ্রাঙ্কো মাস্তানতুয়োনো। এছাড়া আর্জেন্টিনার হয়ে একটি গোল করেন অ্যালেক্সিস ম্&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821610/%E0%A6%95%E0%A7%8B%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A7%AD-%E0%A7%A6-%E0%A6%97%E0%A7%8B%E0%A6%B2%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%B2-%E0%A6%86%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%A8%E0%A6%BE">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>রাশিয়ায় সামরিক বিমান বিধ্বস্ত, নিহত সবাই</title>

      <guid isPermaLink="true">https://www.ittefaq.com.bd/820236/%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%B0%E0%A6%B9%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%93-%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF</guid>
      <pubDate>Tue, 10 Nov 2026 22:34:39 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/d13dbe5f9d6def489d6891308749cc53-6af347729fd30.jpg?jadewits_media_id=322021" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/d13dbe5f9d6def489d6891308749cc53-6af347729fd30.jpg?jadewits_media_id=322021" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/d13dbe5f9d6def489d6891308749cc53-6af347729fd30.jpg?jadewits_media_id=322021" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আন্তালিয়ায় প্রধানমন্ত্রী তারেক রহমান ও তুর্কি প্রেসিডেন্ট এরদোয়ানের বৈঠক শুরু" /&gt;&lt;/p&gt;&lt;p&gt;তুরস্কের আন্তালিয়ায় বাংলাদেশের প্রধানমন্ত্রী তারেক রহমানের সঙ্গে তুরস্কের প্রেসিডেন্ট রিসেপ তাইয়েপ এরদোয়ানের মধ্যকার বহুল প্রতীক্ষিত দ্বিপক্ষীয় বৈঠক শুরু হয়েছে। মঙ্গলবার (১০ নভেম্বর) স্থানীয় সময় সন্ধ্যা সোয়া ৭টায় আন্তালিয়ার ম্যাক্স রয়েল হোটেলে দুই দেশের শীর্ষ নেতৃত্বের মধ্যে এ গুরুত্বপূর্ণ বৈঠক শুরু&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820236/%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%B0%E0%A6%B9%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%93-%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF">দৈনিক ইত্তেফাক</source>

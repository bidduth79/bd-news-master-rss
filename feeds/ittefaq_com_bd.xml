      <guid isPermaLink="true">https://www.ittefaq.com.bd/822722/%E0%A6%87%E0%A6%89%E0%A6%B0%E0%A7%8B%E0%A6%AA%E0%A7%80%E0%A7%9F-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%A0%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A6%9B%E0%A7%87-%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B2-%E0%A6%B8%E0%A6%BF%E0%A6%9F%E0%A6%BF-%E0%A6%93-%E0%A6%86%E0%A6%B0%E0%A7%8D%E0%A6%B8%E0%A7%87%E0%A6%A8%E0%A6%BE%E0%A6%B2</guid>
      <pubDate>Tue, 24 Nov 2026 10:34:49 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/10/13/7ba7f45c0aff5e46f684bdb42f786f91-6acdb5866e642.jpg?jadewits_media_id=316488" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/10/13/7ba7f45c0aff5e46f684bdb42f786f91-6acdb5866e642.jpg?jadewits_media_id=316488" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/10/13/7ba7f45c0aff5e46f684bdb42f786f91-6acdb5866e642.jpg?jadewits_media_id=316488" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইউরোপীয় মহারণে মাঠে নামছে রিয়াল, সিটি ও আর্সেনাল" /&gt;&lt;/p&gt;&lt;p&gt;উয়েফা চ্যাম্পিয়নস লিগের লিগ পর্বের পঞ্চম রাউন্ডের লড়াই শুরু হচ্ছে আজ। শেষ ষোলোর টিকিট নিশ্চিত করার দৌড়ে মাঠে নামছে ইউরোপের শীর্ষ ক্লাবগুলো। রাতের সবচেয়ে আকর্ষণীয় লড়াইয়ে রাত ২টায় এমিরেটস স্টেডিয়ামে জার্মান জায়ান্ট বরুশিয়া ডর্টমুন্ডকে আতিথ্য দেবে আর্সেনাল।&amp;nbsp;
পয়েন্ট টেবিলে নিজেদের অবস্থান সুসংহত কর&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822722/%E0%A6%87%E0%A6%89%E0%A6%B0%E0%A7%8B%E0%A6%AA%E0%A7%80%E0%A7%9F-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%A0%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A6%9B%E0%A7%87-%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B2-%E0%A6%B8%E0%A6%BF%E0%A6%9F%E0%A6%BF-%E0%A6%93-%E0%A6%86%E0%A6%B0%E0%A7%8D%E0%A6%B8%E0%A7%87%E0%A6%A8%E0%A6%BE%E0%A6%B2">দৈনিক ইত্তেফাক</source>

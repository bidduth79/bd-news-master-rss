      <guid isPermaLink="true">https://www.ittefaq.com.bd/823232/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%95-%E0%A6%B9%E0%A7%8B%E0%A6%9F%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%A2%E0%A7%81%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%AA%E0%A6%95%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A7%81%E0%A6%AA%E0%A6%BF%E0%A7%9F%E0%A7%87</guid>
      <pubDate>Fri, 27 Nov 2026 12:39:01 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/ae22a5fe454dc877c8394b6a6f0a9363-6b09253abed6d.jpg?jadewits_media_id=325122" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/ae22a5fe454dc877c8394b6a6f0a9363-6b09253abed6d.jpg?jadewits_media_id=325122" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/ae22a5fe454dc877c8394b6a6f0a9363-6b09253abed6d.jpg?jadewits_media_id=325122" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজধানীতে আবাসিক হোটেলে ঢুকে ব্যবস্থাপককে কুপিয়ে হত্যা, আহত ২" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর ওয়ারীতে একটি আবাসিক হোটেলে ঢুকে কর্মীদের এলোপাতাড়ি কুপিয়েছে দুই ব্যক্তি। এতে হোটেলটির এক ব্যবস্থাপক নিহত হয়েছেন। একইসঙ্গে এসময় আহত হয়েছেন মহাব্যবস্থাপকসহ দুজন।
বৃহস্পতিবার (২৬ নভেম্বর) রাত ২টার দিকে ওয়ারীর জয়কালী মন্দিরের পাশে ওসমানী ইন্টারন্যাশনাল আবাসিক হোটেলে এ ঘটনা ঘটে।
নিহত নাঈমুর রহমা&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823232/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%95-%E0%A6%B9%E0%A7%8B%E0%A6%9F%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%A2%E0%A7%81%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%AA%E0%A6%95%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A7%81%E0%A6%AA%E0%A6%BF%E0%A7%9F%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>পারস্পরিক প্রতিরক্ষা চুক্তি নিয়ে ইসলামাবাদে বৈঠকে বসছে পাকিস্তান, সৌদি আরব ও তুরস্ক</title>

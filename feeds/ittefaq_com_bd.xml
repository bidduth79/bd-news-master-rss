      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/16c24ff841dec0ea877c3797d559a659-6aff53d517824.jpg?jadewits_media_id=323824" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/16c24ff841dec0ea877c3797d559a659-6aff53d517824.jpg?jadewits_media_id=323824" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/16c24ff841dec0ea877c3797d559a659-6aff53d517824.jpg?jadewits_media_id=323824" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এক টেবিলে তিন শক্তিশালী নেতা, নেই শক্তিশালী বার্তা" /&gt;&lt;/p&gt;&lt;p&gt;বিশ্বের তিন পরাশক্তি দেশের তিন শক্তিশালী নেতা এক টেবিলে উপস্থিত হয়েছিলেন গতকাল বৃহস্পতিবার। চীনের শেনঝেনে এমন বিরল বৈঠকে পরমাণু অস্ত্র, ও কৃত্রিম বুদ্ধিমত্তাসহ নানা বিষয়ে আলোচনা হলেও বৈঠক থেকে শক্তিশালী কোনো বার্তা আসেনি। যদিও তিন দেশ একটি যৌথ বিবৃতি প্রকাশ করেছে যা ‘শান্তি ঘোষণা’ হিসেবে উল্লেখ করা &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821988/%E0%A6%8F%E0%A6%95-%E0%A6%9F%E0%A7%87%E0%A6%AC%E0%A6%BF%E0%A6%B2%E0%A7%87-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B6%E0%A6%BE%E0%A6%B2%E0%A7%80%C2%A0%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B6%E0%A6%BE%E0%A6%B2%E0%A7%80-%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>যে সাতটি কারণে পদোন্নতি আটকে যেতে পারে</title>
      <link>https://www.ittefaq.com.bd/821993/%E0%A6%AF%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%A4%E0%A6%9F%E0%A6%BF-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%AA%E0%A6%A6%E0%A7%8B%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A6%A4%E0%A6%BF-%E0%A6%86%E0%A6%9F%E0%A6%95%E0%A7%87-%E0%A6%AF%E0%A7%87%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821993/%E0%A6%AF%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%A4%E0%A6%9F%E0%A6%BF-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%AA%E0%A6%A6%E0%A7%8B%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A6%A4%E0%A6%BF-%E0%A6%86%E0%A6%9F%E0%A6%95%E0%A7%87-%E0%A6%AF%E0%A7%87%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87</guid>
      <pubDate>Fri, 20 Nov 2026 05:31:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/3ee8ffcbc84504892edb1e382f39f8c3-6aff593934594.jpg?jadewits_media_id=323827" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/3ee8ffcbc84504892edb1e382f39f8c3-6aff593934594.jpg?jadewits_media_id=323827" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/3ee8ffcbc84504892edb1e382f39f8c3-6aff593934594.jpg?jadewits_media_id=323827" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যে সাতটি কারণে পদোন্নতি আটকে যেতে পারে" /&gt;&lt;/p&gt;&lt;p&gt;দীর্ঘ কর্মজীবনে বিভিন্ন সময় পদোন্নতি কমিটিতে কাজ করেছি। কখনো সদস্য হিসেবে, কখনো প্রধান হিসেবে। এ অভিজ্ঞতা থেকে সাতটি কারণ বললাম যেগুলো পদোন্নতিতে সমস্যা তৈরি করে।
দক্ষ, কিন্তু আচরণে সমস্যাঅনেক কর্মী আছেন, যারা কাজে দক্ষ, বিন্তু আচরণ খারাপ। এ ধরনের কর্মীকে ম্যানেজমেন্ট প্রমোশন দিতে চায় না। উচ্চপদে ব্&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821993/%E0%A6%AF%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%A4%E0%A6%9F%E0%A6%BF-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%AA%E0%A6%A6%E0%A7%8B%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A6%A4%E0%A6%BF-%E0%A6%86%E0%A6%9F%E0%A6%95%E0%A7%87-%E0%A6%AF%E0%A7%87%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>‘সর্বোচ্চ আদালত সম্পর্কে অসত্য সংবাদ পরিবেশন আদালত অবমাননার শামিল’</title>
      <link>https://www.ittefaq.com.bd/821990/%E2%80%98%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A7%8B%E0%A6%9A%E0%A7%8D%E0%A6%9A-%E0%A6%86%E0%A6%A6%E0%A6%BE%E0%A6%B2%E0%A6%A4-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A7%87%C2%A0%E0%A6%85%E0%A6%B8%E0%A6%A4%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A6%82%E0%A6%AC%E0%A6%BE%E0%A6%A6-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%A8%C2%A0%E0%A6%86%E0%A6%A6%E0%A6%BE%E0%A6%B2%E0%A6%A4</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821990/%E2%80%98%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A7%8B%E0%A6%9A%E0%A7%8D%E0%A6%9A-%E0%A6%86%E0%A6%A6%E0%A6%BE%E0%A6%B2%E0%A6%A4-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A7%87%C2%A0%E0%A6%85%E0%A6%B8%E0%A6%A4%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A6%82%E0%A6%AC%E0%A6%BE%E0%A6%A6-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%A8%C2%A0%E0%A6%86%E0%A6%A6%E0%A6%BE%E0%A6%B2%E0%A6%A4</guid>
      <pubDate>Fri, 20 Nov 2026 05:00:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/09/14/71e36c9c45e66ee6bd1381b69b92a28e-6aa7e90b8217d.jpg?jadewits_media_id=311071" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/09/14/71e36c9c45e66ee6bd1381b69b92a28e-6aa7e90b8217d.jpg?jadewits_media_id=311071" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/09/14/71e36c9c45e66ee6bd1381b69b92a28e-6aa7e90b8217d.jpg?jadewits_media_id=311071" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘সর্বোচ্চ আদালত সম্পর্কে অসত্য সংবাদ পরিবেশন আদালত অবমাননার শামিল’" /&gt;&lt;/p&gt;&lt;p&gt;সুপ্রিম কোর্টের আপিল বিভাগে প্রধান বিচারপতির নেতৃত্বে পাঁচ সদস্যবিশিষ্ট পূর্ণাঙ্গ বেঞ্চে মামলার কার্যতালিকার গতকাল বৃহস্পতিবার ১ নম্বর ক্রমিকে থাকা ‘এস এম আমিনুজ্জামান ফারুক এবং অন্যান্য বনাম আইসিটি’ মামলা দীর্ঘ সময় ধরে শুনানি হয়। শুনানিতে রাষ্ট্রপক্ষে চিফ প্রসিকিউটর মো. আমিনুল ইসলাম অংশগ্রহণ করেন। &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821990/%E2%80%98%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A7%8B%E0%A6%9A%E0%A7%8D%E0%A6%9A-%E0%A6%86%E0%A6%A6%E0%A6%BE%E0%A6%B2%E0%A6%A4-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A7%87%C2%A0%E0%A6%85%E0%A6%B8%E0%A6%A4%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A6%82%E0%A6%AC%E0%A6%BE%E0%A6%A6-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%A8%C2%A0%E0%A6%86%E0%A6%A6%E0%A6%BE%E0%A6%B2%E0%A6%A4">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>৪৬ বছর বয়সে রোনালদিনহোর মাঠে ফেরাকে ‘প্রহসন’ ও ‘লজ্জাজনক’ বললেন আন্তোনিও ক্যাসানো</title>

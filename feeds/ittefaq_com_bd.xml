    <item>
      <title>পাগলা মসজিদে ৩ ঘণ্টায় পাওয়া গেল ১০ কোটি টাকা, এখনো চলছে গণনা</title>
      <link>https://www.ittefaq.com.bd/822197/%E0%A6%AA%E0%A6%BE%E0%A6%97%E0%A6%B2%E0%A6%BE-%E0%A6%AE%E0%A6%B8%E0%A6%9C%E0%A6%BF%E0%A6%A6%E0%A7%87-%E0%A7%A9-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%97%E0%A7%87%E0%A6%B2-%E0%A7%A7%E0%A7%A6-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%8F%E0%A6%96%E0%A6%A8%E0%A7%8B</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822197/%E0%A6%AA%E0%A6%BE%E0%A6%97%E0%A6%B2%E0%A6%BE-%E0%A6%AE%E0%A6%B8%E0%A6%9C%E0%A6%BF%E0%A6%A6%E0%A7%87-%E0%A7%A9-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%97%E0%A7%87%E0%A6%B2-%E0%A7%A7%E0%A7%A6-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%8F%E0%A6%96%E0%A6%A8%E0%A7%8B</guid>
      <pubDate>Sat, 21 Nov 2026 14:41:28 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/5ae0b5318638de94d570c9964b204731-6b0158fcf367a.jpg?jadewits_media_id=324036" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/5ae0b5318638de94d570c9964b204731-6b0158fcf367a.jpg?jadewits_media_id=324036" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/5ae0b5318638de94d570c9964b204731-6b0158fcf367a.jpg?jadewits_media_id=324036" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পাগলা মসজিদে ৩ ঘণ্টায় পাওয়া গেল ১০ কোটি টাকা, এখনো চলছে গণনা" /&gt;&lt;/p&gt;&lt;p&gt;কিশোরগঞ্জের ঐতিহাসিক পাগলা মসজিদের দানবাক্সে পাওয়া গেছে রেকর্ড ৫১ বস্তা টাকা। শনিবার (২১ নভেম্বর) সকাল সাড়ে ৯টায় গণনা শুরু হওয়ার পর প্রথম তিন ঘণ্টায় ১০ কোটি টাকা গণনা করা হয়েছে। গণনা করা টাকা পুলিশ পাহারায় ব্যাংকে পাঠানো হয়েছে। 
এবার দানবাক্সে পাওয়া টাকার পরিমাণ আগের সব রেকর্ড ছাড়িয়ে যাওয়ার সম্ভাবনা&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822197/%E0%A6%AA%E0%A6%BE%E0%A6%97%E0%A6%B2%E0%A6%BE-%E0%A6%AE%E0%A6%B8%E0%A6%9C%E0%A6%BF%E0%A6%A6%E0%A7%87-%E0%A7%A9-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%97%E0%A7%87%E0%A6%B2-%E0%A7%A7%E0%A7%A6-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%8F%E0%A6%96%E0%A6%A8%E0%A7%8B">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>প্লাস্টিক ও সিরামিকের দাপটেও পূর্বপুরুষের মৃৎশিল্প বাঁচিয়ে রেখেছেন সিরাজগঞ্জের কারিগরেরা</title>

    <item>
      <title>নামের মিলে এক বছর কারাগারে থাকা আলমাস মুক্তি পেয়েছেন</title>
      <link>https://www.ittefaq.com.bd/820245/%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A7%87-%E0%A6%8F%E0%A6%95-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%97%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%86%E0%A6%B2%E0%A6%AE%E0%A6%BE%E0%A6%B8-%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820245/%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A7%87-%E0%A6%8F%E0%A6%95-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%97%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%86%E0%A6%B2%E0%A6%AE%E0%A6%BE%E0%A6%B8-%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF</guid>
      <pubDate>Wed, 11 Nov 2026 00:22:52 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/45ebc00775a0abeb0a9e9c2aa6bd413f-6af35e460a9e7.jpg?jadewits_media_id=322030" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/45ebc00775a0abeb0a9e9c2aa6bd413f-6af35e460a9e7.jpg?jadewits_media_id=322030" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/45ebc00775a0abeb0a9e9c2aa6bd413f-6af35e460a9e7.jpg?jadewits_media_id=322030" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নামের মিলে এক বছর কারাগারে থাকা আলমাস মুক্তি পেয়েছেন" /&gt;&lt;/p&gt;&lt;p&gt;দুই যুগ আগের একটি অস্ত্র মামলায় প্রকৃত সাজাপ্রাপ্ত আসামির সঙ্গে নামের মিল থাকায় ভুল করে গ্রেপ্তার হয়েছিলেন ঢাকার দোহারের মো. আলমাস। এক বছরেরও বেশি সময় কারাভোগের পর অবশেষে মুক্তি পেয়েছেন তিনি।&amp;nbsp;
মঙ্গলবার (১০ নভেম্বর) দুপুরে কেরানীগঞ্জের ঢাকা কেন্দ্রীয় কারাগার থেকে তাকে মুক্তি দেওয়া হয়। বিষয়টি নিশ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820245/%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A7%87-%E0%A6%8F%E0%A6%95-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%97%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%86%E0%A6%B2%E0%A6%AE%E0%A6%BE%E0%A6%B8-%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>মালয়েশিয়ায় চিকিৎসাধীন লুৎফুজ্জামান বাবর, লাগবে ‘জটিল অস্ত্রোপচার’</title>
      <link>https://www.ittefaq.com.bd/820244/%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%9A%E0%A6%BF%E0%A6%95%E0%A6%BF%E0%A7%8E%E0%A6%B8%E0%A6%BE%E0%A6%A7%E0%A7%80%E0%A6%A8-%E0%A6%B2%E0%A7%81%E0%A7%8E%E0%A6%AB%E0%A7%81%E0%A6%9C%E0%A7%8D%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A6%B0-%E0%A6%B2%E0%A6%BE%E0%A6%97%E0%A6%AC%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820244/%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%9A%E0%A6%BF%E0%A6%95%E0%A6%BF%E0%A7%8E%E0%A6%B8%E0%A6%BE%E0%A6%A7%E0%A7%80%E0%A6%A8-%E0%A6%B2%E0%A7%81%E0%A7%8E%E0%A6%AB%E0%A7%81%E0%A6%9C%E0%A7%8D%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A6%B0-%E0%A6%B2%E0%A6%BE%E0%A6%97%E0%A6%AC%E0%A7%87</guid>
      <pubDate>Wed, 11 Nov 2026 00:19:31 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/f2292fed82c61d38d8cca0d06cd12358-6af35ffb75928.jpg?jadewits_media_id=322031" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/f2292fed82c61d38d8cca0d06cd12358-6af35ffb75928.jpg?jadewits_media_id=322031" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/f2292fed82c61d38d8cca0d06cd12358-6af35ffb75928.jpg?jadewits_media_id=322031" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মালয়েশিয়ায় চিকিৎসাধীন লুৎফুজ্জামান বাবর, লাগবে ‘জটিল অস্ত্রোপচার’" /&gt;&lt;/p&gt;&lt;p&gt;মেরুদণ্ডের জটিল সমস্যায় উন্নত চিকিৎসার অংশ হিসেবে মালয়েশিয়ার একটি হাসপাতালে চিকিৎসাধীন রয়েছেন নেত্রকোনা-৪ (মদন, মোহনগঞ্জ ও খালিয়াজুরী) আসনের সংসদ সদস্য ও সাবেক স্বরাষ্ট্র প্রতিমন্ত্রী লুৎফুজ্জামান বাবর। সেখানে বুধবার (১১ নভেম্বর) তার মেরুদণ্ডে একটি জটিল অস্ত্রোপচার সম্পন্ন হওয়ার কথা রয়েছে।
নিজে&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820244/%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%9A%E0%A6%BF%E0%A6%95%E0%A6%BF%E0%A7%8E%E0%A6%B8%E0%A6%BE%E0%A6%A7%E0%A7%80%E0%A6%A8-%E0%A6%B2%E0%A7%81%E0%A7%8E%E0%A6%AB%E0%A7%81%E0%A6%9C%E0%A7%8D%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A6%B0-%E0%A6%B2%E0%A6%BE%E0%A6%97%E0%A6%AC%E0%A7%87">দৈনিক ইত্তেফাক</source>

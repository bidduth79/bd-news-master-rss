      <guid isPermaLink="true">https://www.ittefaq.com.bd/819795/%E0%A6%AD%E0%A6%BE%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%A4%E0%A6%AC%E0%A7%87-%E0%A6%95%E0%A7%87%E0%A6%89-%E0%A6%B9%E0%A6%A4%E0%A6%BE%E0%A6%B9%E0%A6%A4-%E0%A6%B9%E0%A7%9F%E0%A6%A8%E0%A6%BF</guid>
      <pubDate>Sun, 08 Nov 2026 19:35:54 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/08/38014c85b10aabf30d110a58f8097e57-6af07a3b8c9fb.jpg?jadewits_media_id=321553" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/08/38014c85b10aabf30d110a58f8097e57-6af07a3b8c9fb.jpg?jadewits_media_id=321553" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/08/38014c85b10aabf30d110a58f8097e57-6af07a3b8c9fb.jpg?jadewits_media_id=321553" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভাটারায় স্কুল বাসে আগুন তবে কেউ হতাহত হয়নি" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর ভাটারার ১০০ ফিট এলাকায় একটি স্কুল বাসে আগুন দিয়েছে দুর্বৃত্তরা। রোববার (৮ নভেম্বর) সন্ধ্যা সাড়ে ৬টার দিকে এই ঘটনা ঘটে। তবে এতে হতাহতের কোনও খবর পাওয়া যায়নি।
প্রত্যক্ষদর্শীরা জানিয়েছেন, সন্ধ্যার দিকে জলসিড়ি ক্যান্টনমেন্ট স্কুল অ্যান্ড কলেজের একটি বাসে আগুন দেয় দুর্বৃত্তরা।
ভাটারা থানার কর্ত&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/819795/%E0%A6%AD%E0%A6%BE%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%A4%E0%A6%AC%E0%A7%87-%E0%A6%95%E0%A7%87%E0%A6%89-%E0%A6%B9%E0%A6%A4%E0%A6%BE%E0%A6%B9%E0%A6%A4-%E0%A6%B9%E0%A7%9F%E0%A6%A8%E0%A6%BF">দৈনিক ইত্তেফাক</source>
    </item>

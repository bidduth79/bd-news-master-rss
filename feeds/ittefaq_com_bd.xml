      <guid isPermaLink="true">https://www.ittefaq.com.bd/820931/%E0%A6%B8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%AC%E0%A6%AF%E0%A6%BC%E0%A6%95-%E0%A6%AE%E0%A6%BE%E0%A6%B9%E0%A6%A6%E0%A7%80%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B2%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97</guid>
      <pubDate>Sat, 14 Nov 2026 15:53:17 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/99a0739181f9575a64635b924f161d89-6af82d87a1fdd.jpg?jadewits_media_id=322729" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/99a0739181f9575a64635b924f161d89-6af82d87a1fdd.jpg?jadewits_media_id=322729" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/99a0739181f9575a64635b924f161d89-6af82d87a1fdd.jpg?jadewits_media_id=322729" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সমন্বয়ক মাহদীর বাসায় পেট্রোল বোমা হামলার অভিযোগ, পুলিশ বলছে ‘নাটক’" /&gt;&lt;/p&gt;&lt;p&gt;হবিগঞ্জে বৈষম্যবিরোধী ছাত্র আন্দোলনের জেলা কমিটির সাবেক সদস্য সচিব মাহদী হাসানের বাসায় পেট্রোলবোমা নিক্ষেপের অভিযোগ উঠেছে। তবে ঘটনাস্থল পরিদর্শন করে এ ধরনের হামলার কোনো আলামত পায়নি পুলিশ। পুলিশের ভাষ্য, অটোরিকশার ব্যাটারি চার্জ দেওয়ার সময় বৈদ্যুতিক শর্টসার্কিট থেকে আগুনের সূত্রপাত হয়েছে।
শনিবার (১৪ &lt;/p&gt;</description>

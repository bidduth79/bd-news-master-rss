      <guid isPermaLink="true">https://www.ittefaq.com.bd/821525/%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A6%A7%E0%A7%81%E0%A6%B2%E0%A6%BE-%E0%A6%93-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%83%E0%A6%A4%E0%A6%BF%E0%A6%9A%E0%A6%B0%E0%A7%8D%E0%A6%9A%E0%A6%BE%E0%A7%9F-%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7-%E0%A6%B9%E0%A6%A4%E0%A7%87-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Tue, 17 Nov 2026 18:03:51 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/75cea8da0f65bc9b89104036f4aa5140-6afc41c5be7f3.jpg?jadewits_media_id=323343" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/75cea8da0f65bc9b89104036f4aa5140-6afc41c5be7f3.jpg?jadewits_media_id=323343" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/75cea8da0f65bc9b89104036f4aa5140-6afc41c5be7f3.jpg?jadewits_media_id=323343" style="max-width:100%;height:auto;margin-bottom:10px;" alt="খেলাধুলা ও সংস্কৃতিচর্চায় দক্ষ হতে শিক্ষার্থীদের প্রতি প্রধানমন্ত্রীর আহ্বান" /&gt;&lt;/p&gt;&lt;p&gt;পড়ালেখার পাশাপাশি খেলাধুলা, শিল্প-সংস্কৃতি ও সহশিক্ষা কার্যক্রমে অংশ নিয়ে নিজেদের দক্ষ ও যোগ্য করে গড়ে তুলতে শিক্ষার্থীদের প্রতি আহ্বান জানিয়েছেন প্রধানমন্ত্রী তারেক রহমান। তিনি বলেছেন, শিক্ষার্থীরাই জাতির ভবিষ্যৎ। তাই ভবিষ্যতের কর্মজীবন ও নেতৃত্বের জন্য এখন থেকেই নিজেদের প্রস্তুত করতে হবে।
মঙ্গলবার&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821525/%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A6%A7%E0%A7%81%E0%A6%B2%E0%A6%BE-%E0%A6%93-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%83%E0%A6%A4%E0%A6%BF%E0%A6%9A%E0%A6%B0%E0%A7%8D%E0%A6%9A%E0%A6%BE%E0%A7%9F-%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7-%E0%A6%B9%E0%A6%A4%E0%A7%87-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>

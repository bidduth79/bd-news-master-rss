      <guid isPermaLink="true">https://www.ittefaq.com.bd/823052/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A6%A7%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%A8-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95-%E0%A6%AE%E0%A7%81%E0%A6%96-%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%B2%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Thu, 26 Nov 2026 10:24:22 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/8d0eb919367663b32ad7f3d0c31bb029-6b07b42ee140a.jpg?jadewits_media_id=324926" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/8d0eb919367663b32ad7f3d0c31bb029-6b07b42ee140a.jpg?jadewits_media_id=324926" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/8d0eb919367663b32ad7f3d0c31bb029-6b07b42ee140a.jpg?jadewits_media_id=324926" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইরানের প্রতিনিধিদের সঙ্গে গোপন বৈঠক, মুখ খুললেন ট্রাম্পের বিশেষ দূত" /&gt;&lt;/p&gt;&lt;p&gt;ইরানের সঙ্গে চলমান উত্তেজনার মধ্যে দেশটির কর্মকর্তাদের সঙ্গে একাধিকবার বৈঠকের কথা জানিয়েছেন যুক্তরাষ্ট্রের বিশেষ দূত জ্যারেড কুশনার। একই সঙ্গে ইরান পরিস্থিতি মোকাবিলায় সামরিক পদক্ষেপসহ সব ধরনের বিকল্প বিবেচনায় রেখেছেন মার্কিন প্রেসিডেন্ট ডোনাল্ড ট্রাম্প বলে জানিয়েছেন তিনি।
আল জাজিরার প্রতিবেদনে বলা &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823052/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A6%A7%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%A8-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95-%E0%A6%AE%E0%A7%81%E0%A6%96-%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%B2%E0%A7%87%E0%A6%A8">দৈনিক ইত্তেফাক</source>

    <item>
      <title>গাজীপুর সাফারি পার্কে নীলগাই পরিবারে নতুন অতিথি, চার শাবকের জন্ম</title>
      <link>https://www.ittefaq.com.bd/819796/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A7%80%E0%A6%AA%E0%A7%81%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AB%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A7%80%E0%A6%B2%E0%A6%97%E0%A6%BE%E0%A6%87-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%85%E0%A6%A4%E0%A6%BF%E0%A6%A5%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/819796/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A7%80%E0%A6%AA%E0%A7%81%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AB%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A7%80%E0%A6%B2%E0%A6%97%E0%A6%BE%E0%A6%87-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%85%E0%A6%A4%E0%A6%BF%E0%A6%A5%E0%A6%BF</guid>
      <pubDate>Sun, 08 Nov 2026 19:49:48 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/08/df3b62a738cf284618f83f04bedaebfb-6af07ccc6ce13.jpg?jadewits_media_id=321554" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/08/df3b62a738cf284618f83f04bedaebfb-6af07ccc6ce13.jpg?jadewits_media_id=321554" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/08/df3b62a738cf284618f83f04bedaebfb-6af07ccc6ce13.jpg?jadewits_media_id=321554" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গাজীপুর সাফারি পার্কে নীলগাই পরিবারে নতুন অতিথি, চার শাবকের জন্ম" /&gt;&lt;/p&gt;&lt;p&gt;গাজীপুর বনভূমির নীরব পরিবেশে মায়ের সঙ্গে ছুটে বেড়াচ্ছে চারটি ফুটফুটে শাবক। কখনো মায়ের পাশে ঘেঁষে দাঁড়ানো, কখনো একে অপরের সঙ্গে খুনসুঁটি, এভাবেই কাটছে তাদের সময়। 
নতুন এই চার অতিথির আগমনে প্রাণচাঞ্চল্য বেড়েছে গাজীপুরের সাফারি পার্কে। বিলুপ্তির ঝুঁকিতে থাকা নীলগাই পরিবারের নতুন সদস্যদের দেখতে পেয়ে আনন&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/819796/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A7%80%E0%A6%AA%E0%A7%81%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AB%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A7%80%E0%A6%B2%E0%A6%97%E0%A6%BE%E0%A6%87-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%85%E0%A6%A4%E0%A6%BF%E0%A6%A5%E0%A6%BF">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>ভাটারায় স্কুল বাসে আগুন তবে কেউ হতাহত হয়নি</title>

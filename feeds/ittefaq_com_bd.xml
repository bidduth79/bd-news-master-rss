    </item>
    <item>
      <title>বারিধারা থেকে সাবেক সংসদ সদস্য আতাউল হক দোলন গ্রেপ্তার</title>
      <link>https://www.ittefaq.com.bd/821981/%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF-%E0%A6%86%E0%A6%A4%E0%A6%BE%E0%A6%89%E0%A6%B2-%E0%A6%B9%E0%A6%95-%E0%A6%A6%E0%A7%8B%E0%A6%B2%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821981/%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF-%E0%A6%86%E0%A6%A4%E0%A6%BE%E0%A6%89%E0%A6%B2-%E0%A6%B9%E0%A6%95-%E0%A6%A6%E0%A7%8B%E0%A6%B2%E0%A6%A8</guid>
      <pubDate>Fri, 20 Nov 2026 00:58:21 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/5aa98a30ba84710023afecc66ac5f175-6aff46cae6419.jpg?jadewits_media_id=323817" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/5aa98a30ba84710023afecc66ac5f175-6aff46cae6419.jpg?jadewits_media_id=323817" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/5aa98a30ba84710023afecc66ac5f175-6aff46cae6419.jpg?jadewits_media_id=323817" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বারিধারা থেকে সাবেক সংসদ সদস্য আতাউল হক দোলন গ্রেপ্তার" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর বারিধারা ডিওএইচএস এলাকা থেকে সাতক্ষীরা-৪ আসনের সাবেক সংসদ সদস্য এস এম আতাউল হক দোলনকে গ্রেপ্তার করেছে স্পেশাল রেসপন্স ব্যাটালিয়ন (এসআরবি-১)।
বৃহস্পতিবার (১৯ নভেম্বর) রাত ১১টা ২০ মিনিটের দিকে গোয়েন্দা তথ্যের ভিত্তিতে পরিচালিত বিশেষ অভিযানে তাকে আটক করা হয়। এসআরবির লিগ্যাল অ্যান্ড মিডিয়া উইংয়&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821981/%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF-%E0%A6%86%E0%A6%A4%E0%A6%BE%E0%A6%89%E0%A6%B2-%E0%A6%B9%E0%A6%95-%E0%A6%A6%E0%A7%8B%E0%A6%B2%E0%A6%A8">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>এবার শেখ হাসিনার স্বাক্ষর জাল করে চিঠি পাঠিয়েছেন ম্যাট্রিক্স চেম্বার্স: রাশেদ খাঁন</title>
      <link>https://www.ittefaq.com.bd/821980/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%B0-%E0%A6%9C%E0%A6%BE%E0%A6%B2-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%9A%E0%A6%BF%E0%A6%A0%E0%A6%BF-%E0%A6%AA%E0%A6%BE%E0%A6%A0%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821980/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%B0-%E0%A6%9C%E0%A6%BE%E0%A6%B2-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%9A%E0%A6%BF%E0%A6%A0%E0%A6%BF-%E0%A6%AA%E0%A6%BE%E0%A6%A0%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Fri, 20 Nov 2026 00:55:48 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/e0822336dd130364c9ea78e81dbcf512-6aff4589abfbd.jpg?jadewits_media_id=323816" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/e0822336dd130364c9ea78e81dbcf512-6aff4589abfbd.jpg?jadewits_media_id=323816" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/e0822336dd130364c9ea78e81dbcf512-6aff4589abfbd.jpg?jadewits_media_id=323816" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এবার শেখ হাসিনার স্বাক্ষর জাল করে চিঠি পাঠিয়েছেন ম্যাট্রিক্স চেম্বার্স: রাশেদ খাঁন" /&gt;&lt;/p&gt;&lt;p&gt;বাতিল হয়ে যাওয়া কূটনৈতিক পাসপোর্ট এবং জাতীয় পরিচয়পত্র (এনআইডি) পুনরায় ফিরে পেতে তৎপর হয়ে উঠেছেন ক্ষমতাচ্যুত প্রধানমন্ত্রী শেখ হাসিনা। এবার তার নিজস্ব স্বাক্ষরিত অনুমতিপত্রসহ (ওকালতনামা) নয়াদিল্লিতে অবস্থিত বাংলাদেশ হাইকমিশনের দ্বারস্থ হয়েছেন তার আইনজীবীরা। তবে শেখ হাসিনার এই স্বাক্ষর নিয়েও স&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821980/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%B0-%E0%A6%9C%E0%A6%BE%E0%A6%B2-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%9A%E0%A6%BF%E0%A6%A0%E0%A6%BF-%E0%A6%AA%E0%A6%BE%E0%A6%A0%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8">দৈনিক ইত্তেফাক</source>

      <guid isPermaLink="true">https://www.ittefaq.com.bd/823231/%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%95-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%9A%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%87%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A7%87-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95%E0%A7%87</guid>
      <pubDate>Fri, 27 Nov 2026 12:21:50 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/391a900415b2d3407e6a4edf8441f22f-6b0921643cec3.jpg?jadewits_media_id=325121" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/391a900415b2d3407e6a4edf8441f22f-6b0921643cec3.jpg?jadewits_media_id=325121" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/391a900415b2d3407e6a4edf8441f22f-6b0921643cec3.jpg?jadewits_media_id=325121" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পারস্পরিক প্রতিরক্ষা চুক্তি নিয়ে ইসলামাবাদে বৈঠকে বসছে পাকিস্তান, সৌদি আরব ও তুরস্ক" /&gt;&lt;/p&gt;&lt;p&gt;পারস্পরিক প্রতিরক্ষা সহযোগিতা জোরদারের বিষয়ে আলোচনা করতে বৈঠকে বসছে পাকিস্তান, সৌদি আরব ও তুরস্ক। চলতি সপ্তাহে পাকিস্তানের রাজধানী ইসলামাবাদে এ বৈঠক অনুষ্ঠিত হওয়ার কথা রয়েছে।
বৃহস্পতিবার (২৬ নভেম্বর) পাকিস্তানের দুটি সূত্র বার্তা সংস্থা রয়টার্সকে এ তথ্য জানিয়েছে।
সূত্রগুলোর বরাতে রয়টার্স জানায়, বৈঠক&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823231/%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%95-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%9A%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%87%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A7%87-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>দীর্ঘ আইনি লড়াইয়ের পর সমঝোতায় ব্র্যাড-অ্যাঞ্জেলিনা</title>

    <item>
      <title>হাসপাতালে আক্রান্ত শিশুদের নিয়ে উৎকণ্ঠায় দিন কাটছে মায়েদের</title>
      <link>https://www.ittefaq.com.bd/821799/%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%86%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%89%E0%A7%8E%E0%A6%95%E0%A6%A3%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A7%9F-%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%95%E0%A6%BE%E0%A6%9F%E0%A6%9B%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821799/%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%86%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%89%E0%A7%8E%E0%A6%95%E0%A6%A3%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A7%9F-%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%95%E0%A6%BE%E0%A6%9F%E0%A6%9B%E0%A7%87</guid>
      <pubDate>Thu, 19 Nov 2026 04:14:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/1c6376e16c2dcd3758c128811e508cd4-6afe0afdbbcea.jpg?jadewits_media_id=323626" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/1c6376e16c2dcd3758c128811e508cd4-6afe0afdbbcea.jpg?jadewits_media_id=323626" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/1c6376e16c2dcd3758c128811e508cd4-6afe0afdbbcea.jpg?jadewits_media_id=323626" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হাসপাতালে আক্রান্ত শিশুদের নিয়ে উৎকণ্ঠায় দিন কাটছে মায়েদের" /&gt;&lt;/p&gt;&lt;p&gt;মাত্র ২২ দিন বয়সি ইয়াসিন, ডেঙ্গু জ্বরে আক্রান্ত। গতকাল তার বয়স ছিল ১ মাস ২ দিন। নোয়াখালীর বেগমগঞ্জ থেকে আসা এই শিশুর মা সাজেদা বেগম বলেন, ২২ দিন বয়সে জ্বর আসে; আমরা জ্বরের জন্যে ওষুধ খাওয়াই, কিন্তু জ্বরের পরে পাতলা পায়খানা, বমি শুরু হয়, তখন ডাক্তার ডেঙ্গু পরীক্ষা করাতে বলে, পরীক্ষার রিপোর্টে জানতে প&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821799/%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%86%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%89%E0%A7%8E%E0%A6%95%E0%A6%A3%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A7%9F-%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%95%E0%A6%BE%E0%A6%9F%E0%A6%9B%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>নূতন মাদক সম্পর্কে জনসচেতনতা সৃষ্টি করা প্রয়োজন</title>
      <link>https://www.ittefaq.com.bd/821798/%E0%A6%A8%E0%A7%82%E0%A6%A4%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A6%95-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A7%87-%E0%A6%9C%E0%A6%A8%E0%A6%B8%E0%A6%9A%E0%A7%87%E0%A6%A4%E0%A6%A8%E0%A6%A4%E0%A6%BE-%E0%A6%B8%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF-%E0%A6%95%E0%A6%B0%E0%A6%BE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AF%E0%A6%BC%E0%A7%8B%E0%A6%9C%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821798/%E0%A6%A8%E0%A7%82%E0%A6%A4%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A6%95-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A7%87-%E0%A6%9C%E0%A6%A8%E0%A6%B8%E0%A6%9A%E0%A7%87%E0%A6%A4%E0%A6%A8%E0%A6%A4%E0%A6%BE-%E0%A6%B8%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF-%E0%A6%95%E0%A6%B0%E0%A6%BE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AF%E0%A6%BC%E0%A7%8B%E0%A6%9C%E0%A6%A8</guid>
      <pubDate>Thu, 19 Nov 2026 03:30:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2025/03/11/01bd9f25252561a677fb8c828c703ffa-67cff76a8ea1b.jpg?jadewits_media_id=215097" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2025/03/11/01bd9f25252561a677fb8c828c703ffa-67cff76a8ea1b.jpg?jadewits_media_id=215097" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2025/03/11/01bd9f25252561a677fb8c828c703ffa-67cff76a8ea1b.jpg?jadewits_media_id=215097" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নূতন মাদক সম্পর্কে জনসচেতনতা সৃষ্টি করা প্রয়োজন" /&gt;&lt;/p&gt;&lt;p&gt;দেশে মাদকাসক্তি একটি জাতীয় সমস্যায় পরিণত হইয়াছে। ইহার মোকাবিলায় বিভিন্ন এলাকায়, পাড়া-মহল্লায় যে ধরনের সামাজিক আন্দোলন গড়িয়া তোলা দরকার ছিল, তাহা চোখে পড়িতেছে না। মাদক কারবারি ও রাঘববোয়ালরা বরাবরই থাকিতেছেন ধরাছোঁয়ার বাহিরে। সবচাইতে মারাত্মক প্রবণতা হইল, একশ্রেণির রাজনীতিবিদ এমনকি জনপ্রতি&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821798/%E0%A6%A8%E0%A7%82%E0%A6%A4%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A6%95-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A7%87-%E0%A6%9C%E0%A6%A8%E0%A6%B8%E0%A6%9A%E0%A7%87%E0%A6%A4%E0%A6%A8%E0%A6%A4%E0%A6%BE-%E0%A6%B8%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF-%E0%A6%95%E0%A6%B0%E0%A6%BE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AF%E0%A6%BC%E0%A7%8B%E0%A6%9C%E0%A6%A8">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>‘আলো আসবেই’ গ্রুপের অভিনেত্রী জ্যোতিকা জ্যোতি গ্রেপ্তার</title>
      <link>https://www.ittefaq.com.bd/821805/%E2%80%98%E0%A6%86%E0%A6%B2%E0%A7%8B-%E0%A6%86%E0%A6%B8%E0%A6%AC%E0%A7%87%E0%A6%87%E2%80%99-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%AA%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A6%BE-%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%A4%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821805/%E2%80%98%E0%A6%86%E0%A6%B2%E0%A7%8B-%E0%A6%86%E0%A6%B8%E0%A6%AC%E0%A7%87%E0%A6%87%E2%80%99-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%AA%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A6%BE-%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%A4%E0%A6%BF</guid>
      <pubDate>Thu, 19 Nov 2026 03:23:45 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/10bb11e56bffca89e6860090dc4165f4-6afe174666be9.jpg?jadewits_media_id=323632" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/10bb11e56bffca89e6860090dc4165f4-6afe174666be9.jpg?jadewits_media_id=323632" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/10bb11e56bffca89e6860090dc4165f4-6afe174666be9.jpg?jadewits_media_id=323632" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘আলো আসবেই’ গ্রুপের অভিনেত্রী জ্যোতিকা জ্যোতি গ্রেপ্তার" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর তুরাগ থানার ১৮ নম্বর সেক্টরের একটি সরকারি আবাসিক কোয়ার্টার থেকে অভিনেত্রী জ্যোতিকা জ্যোতিকে গ্রেপ্তার করেছে ঢাকা মহানগর গোয়েন্দা পুলিশ (ডিবি)। বুধবার (১৮ নভেম্বর) দিবাগত রাত পৌনে ৩টার দিকে তাকে গ্রেপ্তার করে ডিবি কার্যালয়ে নিয়ে আসা হয়। 
রাত ২টা ৫৫ মিনিটে গণমাধ্যমকে বিষয়টি নিশ্চিত করেছেন মহা&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821805/%E2%80%98%E0%A6%86%E0%A6%B2%E0%A7%8B-%E0%A6%86%E0%A6%B8%E0%A6%AC%E0%A7%87%E0%A6%87%E2%80%99-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%AA%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A6%BE-%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%A4%E0%A6%BF">দৈনিক ইত্তেফাক</source>
    </item>

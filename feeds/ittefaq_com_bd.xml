    <item>
      <title>ক্ষমা চাইলেন শ্রাবণ, ক্ষোভ ঝাড়লেন জামাল ভূঁইয়া</title>
      <link>https://www.ittefaq.com.bd/821096/%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%AE%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AC%E0%A6%A3-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8B%E0%A6%AD-%E0%A6%9D%E0%A6%BE%E0%A7%9C%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%B2-%E0%A6%AD%E0%A7%82%E0%A6%81%E0%A6%87%E0%A7%9F%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821096/%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%AE%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AC%E0%A6%A3-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8B%E0%A6%AD-%E0%A6%9D%E0%A6%BE%E0%A7%9C%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%B2-%E0%A6%AD%E0%A7%82%E0%A6%81%E0%A6%87%E0%A7%9F%E0%A6%BE</guid>
      <pubDate>Sun, 15 Nov 2026 14:55:22 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/2df664b5f6f070de7e0325b9d262747a-6af97306a9f7e.jpg?jadewits_media_id=322902" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/2df664b5f6f070de7e0325b9d262747a-6af97306a9f7e.jpg?jadewits_media_id=322902" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/2df664b5f6f070de7e0325b9d262747a-6af97306a9f7e.jpg?jadewits_media_id=322902" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ক্ষমা চাইলেন শ্রাবণ, ক্ষোভ ঝাড়লেন জামাল ভূঁইয়া" /&gt;&lt;/p&gt;&lt;p&gt;সাফ চ্যাম্পিয়নশিপে ২৩ বছরের শিরোপাখরা ঘোচানোর আরেকটি সুযোগ এসেছিল বাংলাদেশের সামনে। কিন্তু সেই স্বপ্ন ভেঙে গেছে। শনিবার (১৪ নভেম্বর) সেমিফাইনালে পাকিস্তানের কাছে ১-০ গোলে হেরেছে লাল-সবুজের প্রতিনিধিরা।
পাকিস্তানের কাছে এমন হৃদয়বিদারক হারের পর দর্শকদের দুয়োধ্বনি শুনতে হয়েছে বাংলাদেশের গোলরক্ষক মেহেদী&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821096/%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%AE%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AC%E0%A6%A3-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8B%E0%A6%AD-%E0%A6%9D%E0%A6%BE%E0%A7%9C%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%B2-%E0%A6%AD%E0%A7%82%E0%A6%81%E0%A6%87%E0%A7%9F%E0%A6%BE">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>চাকরির চাহিদা অনুযায়ী বিশ্ববিদ্যালয়ে শিক্ষার মান বৃদ্ধির আহ্বান রাষ্ট্রপতির</title>

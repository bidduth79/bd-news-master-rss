    <item>
      <title>৯ ও ১৪ মাসে ৩০ পারা কোরআন মুখস্থ করে হাফেজ হলো দুই শিশু</title>
      <link>https://www.ittefaq.com.bd/822134/%E0%A7%AF-%E0%A6%93-%E0%A7%A7%E0%A7%AA-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A7%A9%E0%A7%A6-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%95%E0%A7%8B%E0%A6%B0%E0%A6%86%E0%A6%A8-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A6%B8%E0%A7%8D%E0%A6%A5-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AB%E0%A7%87%E0%A6%9C-%E0%A6%B9%E0%A6%B2%E0%A7%8B-%E0%A6%A6%E0%A7%81%E0%A6%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822134/%E0%A7%AF-%E0%A6%93-%E0%A7%A7%E0%A7%AA-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A7%A9%E0%A7%A6-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%95%E0%A7%8B%E0%A6%B0%E0%A6%86%E0%A6%A8-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A6%B8%E0%A7%8D%E0%A6%A5-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AB%E0%A7%87%E0%A6%9C-%E0%A6%B9%E0%A6%B2%E0%A7%8B-%E0%A6%A6%E0%A7%81%E0%A6%87</guid>
      <pubDate>Sat, 21 Nov 2026 00:26:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/f4c3f2ec1ef8025726b48a1f1eeb8626-6b008c1c53517.jpg?jadewits_media_id=323972" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/f4c3f2ec1ef8025726b48a1f1eeb8626-6b008c1c53517.jpg?jadewits_media_id=323972" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/f4c3f2ec1ef8025726b48a1f1eeb8626-6b008c1c53517.jpg?jadewits_media_id=323972" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৯ ও ১৪ মাসে ৩০ পারা কোরআন মুখস্থ করে হাফেজ হলো দুই শিশু" /&gt;&lt;/p&gt;&lt;p&gt;পবিত্র কোরআনের ৩০ পারা মুখস্থ করা যেকোনো শিক্ষার্থীর জন্যই এক অনন্য অর্জন। সেই কঠিন সাধনায় নজরকাড়া সাফল্য দেখিয়েছে চাঁদপুরের দুই শিশু শিক্ষার্থী। একই মাদরাসার হিফজ বিভাগে পড়ে একজন মাত্র ৯ মাস ১০ দিনে এবং অপরজন ১৪ মাসে সম্পূর্ণ কোরআন মুখস্থ করে হাফেজ হওয়ার গৌরব অর্জন করেছে। তাদের এই কৃতিত্বে পরিবার,&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822134/%E0%A7%AF-%E0%A6%93-%E0%A7%A7%E0%A7%AA-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A7%A9%E0%A7%A6-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%95%E0%A7%8B%E0%A6%B0%E0%A6%86%E0%A6%A8-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A6%B8%E0%A7%8D%E0%A6%A5-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AB%E0%A7%87%E0%A6%9C-%E0%A6%B9%E0%A6%B2%E0%A7%8B-%E0%A6%A6%E0%A7%81%E0%A6%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>ভোটার তালিকা সংশোধনের নামে টার্গেট করে মুসলিমদের বাদ দিচ্ছে ভারত: মার্কিন কমিশন</title>
      <link>https://www.ittefaq.com.bd/822132/%E0%A6%AD%E0%A7%8B%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%95%E0%A6%BE-%E0%A6%B8%E0%A6%82%E0%A6%B6%E0%A7%8B%E0%A6%A7%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%97%E0%A7%87%E0%A6%9F-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A7%81%E0%A6%B8%E0%A6%B2%E0%A6%BF%E0%A6%AE%E0%A6%A6%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822132/%E0%A6%AD%E0%A7%8B%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%95%E0%A6%BE-%E0%A6%B8%E0%A6%82%E0%A6%B6%E0%A7%8B%E0%A6%A7%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%97%E0%A7%87%E0%A6%9F-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A7%81%E0%A6%B8%E0%A6%B2%E0%A6%BF%E0%A6%AE%E0%A6%A6%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Sat, 21 Nov 2026 00:26:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/862f44eac46820dc237909f8295b55fa-6b0089c736668.jpg?jadewits_media_id=323970" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/862f44eac46820dc237909f8295b55fa-6b0089c736668.jpg?jadewits_media_id=323970" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/862f44eac46820dc237909f8295b55fa-6b0089c736668.jpg?jadewits_media_id=323970" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভোটার তালিকা সংশোধনের নামে টার্গেট করে মুসলিমদের বাদ দিচ্ছে ভারত: মার্কিন কমিশন" /&gt;&lt;/p&gt;&lt;p&gt;ভারতে ভোটার তালিকা সংশোধনের (এসআইআর) নামে ধর্মীয় সংখ্যালঘু বিশেষ করে মুসলিম নাগরিকদের লক্ষ্যবস্তু বানানোর প্রবণতা আশঙ্কাজনকভাবে বেড়েছে বলে অভিযোগ করেছে যুক্তরাষ্ট্রের আন্তর্জাতিক ধর্মীয় স্বাধীনতাবিষয়ক কমিশন (ইউএসসিআইআরএফ)। দেশজুড়ে পরিচালিত এই প্রক্রিয়ায় ভোটার তালিকা থেকে প্রায় ১৩ কোটি মানুষের নাম বা&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822132/%E0%A6%AD%E0%A7%8B%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%95%E0%A6%BE-%E0%A6%B8%E0%A6%82%E0%A6%B6%E0%A7%8B%E0%A6%A7%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%97%E0%A7%87%E0%A6%9F-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A7%81%E0%A6%B8%E0%A6%B2%E0%A6%BF%E0%A6%AE%E0%A6%A6%E0%A7%87%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>নেপালকে মাত্র ২৬ রানে গুটিয়ে ভারতের রেকর্ড ব্যবধানে জয়</title>
      <link>https://www.ittefaq.com.bd/822135/%E0%A6%A8%E0%A7%87%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%95%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A7%A8%E0%A7%AC-%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%97%E0%A7%81%E0%A6%9F%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A1</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822135/%E0%A6%A8%E0%A7%87%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%95%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A7%A8%E0%A7%AC-%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%97%E0%A7%81%E0%A6%9F%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A1</guid>
      <pubDate>Sat, 21 Nov 2026 00:14:54 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/f3bd958244b7bf10fe3d39bb2d2dfdbe-6b008e0e156c5.jpg?jadewits_media_id=323973" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/f3bd958244b7bf10fe3d39bb2d2dfdbe-6b008e0e156c5.jpg?jadewits_media_id=323973" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/f3bd958244b7bf10fe3d39bb2d2dfdbe-6b008e0e156c5.jpg?jadewits_media_id=323973" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নেপালকে মাত্র ২৬ রানে গুটিয়ে ভারতের রেকর্ড ব্যবধানে জয়" /&gt;&lt;/p&gt;&lt;p&gt;এশিয়া কাপ রাইজিং স্টারস ওয়ানডে টুর্নামেন্টে নেপালকে ৩০৬ রানের বিশাল ব্যবধানে হারিয়ে এক ঐতিহাসিক জয় তুলে নিয়েছে ভারতীয় &amp;lsquo;এ&amp;rsquo; দল। তিলক ভার্মা ও কুমার কুশাগরার জোড়া সেঞ্চুরির পর হর্ষিত রানা ও প্রিন্স যাদবের বিধ্বংসী বোলিংয়ে মাত্র ২৬ রানেই গুটিয়ে যায় নেপাল। লিস্ট-এ ক্রিকেটের ইতিহাসে রানে&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822135/%E0%A6%A8%E0%A7%87%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%95%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A7%A8%E0%A7%AC-%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%97%E0%A7%81%E0%A6%9F%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A1">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>জনগণের আস্থাই সশস্ত্র বাহিনীর প্রকৃত শক্তি: রাষ্ট্রপতি</title>
      <link>https://www.ittefaq.com.bd/822133/%E0%A6%9C%E0%A6%A8%E0%A6%97%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%87-%E0%A6%B8%E0%A6%B6%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A7%83%E0%A6%A4-%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822133/%E0%A6%9C%E0%A6%A8%E0%A6%97%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%87-%E0%A6%B8%E0%A6%B6%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A7%83%E0%A6%A4-%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF</guid>
      <pubDate>Sat, 21 Nov 2026 00:04:32 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/a8153b0804ac7b7a1db1b8d5afd526c5-6b008b9135803.jpg?jadewits_media_id=323971" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/a8153b0804ac7b7a1db1b8d5afd526c5-6b008b9135803.jpg?jadewits_media_id=323971" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/a8153b0804ac7b7a1db1b8d5afd526c5-6b008b9135803.jpg?jadewits_media_id=323971" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জনগণের আস্থাই সশস্ত্র বাহিনীর প্রকৃত শক্তি: রাষ্ট্রপতি" /&gt;&lt;/p&gt;&lt;p&gt;রাষ্ট্রপতি মির্জা ফখরুল ইসলাম আলমগীর বলেছেন, আমি বিশ্বাস করি, দেশপ্রেম, সুশৃঙ্খলা, সততা, পেশাদারত্ব ও জনগণের আস্থাই সশস্ত্র বাহিনীর প্রকৃত শক্তি।
তিনি বলেন, বাংলাদেশের সংবিধান, নেতৃত্বের প্রতি আনুগত্য এবং জাতীয় স্বার্থকে সর্বোচ্চ গুরুত্ব দিয়ে সশস্ত্র বাহিনীর সদস্যরা তাদের ওপর অর্পিত দায়িত্ব পালন কর&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822133/%E0%A6%9C%E0%A6%A8%E0%A6%97%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%87-%E0%A6%B8%E0%A6%B6%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A7%83%E0%A6%A4-%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>‘কার্যক্রম নিষিদ্ধ আওয়ামী লীগ সন্ত্রাসীদের হুঁশিয়ার দিয়ে বলতে চাই— বাড়াবাড়ি করবেন না’</title>
      <link>https://www.ittefaq.com.bd/822131/%E2%80%98%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%86%E0%A6%93%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822131/%E2%80%98%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%86%E0%A6%93%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Sat, 21 Nov 2026 00:00:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/6bc9f9b6c3a5ce2d2dcec865664cd12d-6b00870183d53.jpg?jadewits_media_id=323969" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/6bc9f9b6c3a5ce2d2dcec865664cd12d-6b00870183d53.jpg?jadewits_media_id=323969" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/6bc9f9b6c3a5ce2d2dcec865664cd12d-6b00870183d53.jpg?jadewits_media_id=323969" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘কার্যক্রম নিষিদ্ধ আওয়ামী লীগ সন্ত্রাসীদের হুঁশিয়ার দিয়ে বলতে চাই— বাড়াবাড়ি করবেন না’" /&gt;&lt;/p&gt;&lt;p&gt;নিষিদ্ধ পলাতক আওয়ামী লীগের ডাকা 'লক ডাউন' সফল হতে দেননি বলে মন্তব্য করেছেন ঢাকা মহানগর দক্ষিণ যুবদলের সদস্যসচিব রবিউল ইসলাম নয়ন। সঙ্গে হুঁশিয়ারি দিয়ে আওয়ামী লীগ সন্ত্রাসীদের বলেন, &amp;lsquo;বাড়াবাড়ি করবেন না।&amp;rsquo;
শুক্রবার (২০ নভেম্বর) ফেসবুক পোস্টে তিনি এই হুঁশিয়ার দেন। ইত্তেফাকের পাঠকদের জন্য&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822131/%E2%80%98%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%86%E0%A6%93%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>‘১০০ টাকায়’ কার্যক্রম নিষিদ্ধ আওয়ামী লীগের মিছিলে স্লোগান, আটক ছয় কিশোর</title>
      <link>https://www.ittefaq.com.bd/822130/%E2%80%98%E0%A7%A7%E0%A7%A6%E0%A7%A6-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F%E2%80%99-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A6%B2%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822130/%E2%80%98%E0%A7%A7%E0%A7%A6%E0%A7%A6-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F%E2%80%99-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A6%B2%E0%A7%87</guid>
      <pubDate>Fri, 20 Nov 2026 23:56:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/9d627c382125680cb891afe0b1668051-6b008293014e4.jpg?jadewits_media_id=323968" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/9d627c382125680cb891afe0b1668051-6b008293014e4.jpg?jadewits_media_id=323968" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/9d627c382125680cb891afe0b1668051-6b008293014e4.jpg?jadewits_media_id=323968" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘১০০ টাকায়’ কার্যক্রম নিষিদ্ধ আওয়ামী লীগের মিছিলে স্লোগান, আটক ছয় কিশোর" /&gt;&lt;/p&gt;&lt;p&gt;ময়মনসিংহে কার্যক্রম নিষিদ্ধ আওয়ামী লীগ ও দলটির সহযোগী সংগঠনের মিছিলে অংশ নেওয়ার অভিযোগে ছয় কিশোরকে আটক করেছে পুলিশ। পুলিশের দাবি, মিছিলে অংশ নেওয়ার জন্য প্রত্যেক কিশোরকে ১০০ টাকা করে দেওয়া হয়েছিল।
শুক্রবার (২০ নভেম্বর) বিকেলে নগরের কাশর বোররচর ভবনের সামনে তিন রাস্তার মোড় এলাকা থেকে তাদের আটক করা হয়।&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822130/%E2%80%98%E0%A7%A7%E0%A7%A6%E0%A7%A6-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F%E2%80%99-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A6%B2%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>

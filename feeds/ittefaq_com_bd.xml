      <guid isPermaLink="true">https://www.ittefaq.com.bd/821995/%E0%A7%AA%E0%A7%AC-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%AC%E0%A6%AF%E0%A6%BC%E0%A6%B8%E0%A7%87-%E0%A6%B0%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A6%B9%E0%A7%8B%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%A0%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%95%E0%A7%87-%E2%80%98%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B9%E0%A6%B8%E0%A6%A8%E2%80%99-%E0%A6%93</guid>
      <pubDate>Fri, 20 Nov 2026 04:29:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/d6104826f8d89dc683412d64e529b293-6aff5aeef16e5.jpg?jadewits_media_id=323829" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/d6104826f8d89dc683412d64e529b293-6aff5aeef16e5.jpg?jadewits_media_id=323829" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/d6104826f8d89dc683412d64e529b293-6aff5aeef16e5.jpg?jadewits_media_id=323829" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৪৬ বছর বয়সে রোনালদিনহোর মাঠে ফেরাকে ‘প্রহসন’ ও ‘লজ্জাজনক’ বললেন আন্তোনিও ক্যাসানো" /&gt;&lt;/p&gt;&lt;p&gt;৪৬ বছর বয়সে প্রতিযোগিতামূলক ফুটবলে ফিরেছেন ব্রাজিলিয়ান কিংবদন্তি রোনালদিনহো। তবে তার এই প্রত্যাবর্তনকে সবাই ইতিবাচকভাবে নেননি। ইতালির সাবেক স্ট্রাইকার আন্তোনিও ক্যাসানো রোনালদিনহোর মাঠে ফেরাকে সরাসরি &amp;lsquo;প্রহসন&amp;rsquo; ও &amp;lsquo;লজ্জাজনক&amp;rsquo; বলে মন্তব্য করেছেন।
গত রোববার ইতালির তৃতীয় বিভাগের &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821995/%E0%A7%AA%E0%A7%AC-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%AC%E0%A6%AF%E0%A6%BC%E0%A6%B8%E0%A7%87-%E0%A6%B0%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A6%B9%E0%A7%8B%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%A0%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%95%E0%A7%87-%E2%80%98%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B9%E0%A6%B8%E0%A6%A8%E2%80%99-%E0%A6%93">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>তরুণদের জন্য পর্যাপ্ত কর্মসংস্থান তৈরি হচ্ছে না: বিশ্বব্যাংক</title>

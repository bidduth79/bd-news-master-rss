    <item>
      <title>প্রধানমন্ত্রী তারেক রহমানের সঙ্গে বিরোধীদলীয় নেতার একান্ত বৈঠক</title>
      <link>https://www.ittefaq.com.bd/821806/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%B0%E0%A6%B9%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%80%E0%A6%A6%E0%A6%B2%E0%A7%80%E0%A7%9F-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821806/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%B0%E0%A6%B9%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%80%E0%A6%A6%E0%A6%B2%E0%A7%80%E0%A7%9F-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Thu, 19 Nov 2026 06:59:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/6f17ec46b751a0bd1fff372411978ea7-6afe1899a2e21.jpg?jadewits_media_id=323633" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/6f17ec46b751a0bd1fff372411978ea7-6afe1899a2e21.jpg?jadewits_media_id=323633" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/6f17ec46b751a0bd1fff372411978ea7-6afe1899a2e21.jpg?jadewits_media_id=323633" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রধানমন্ত্রী তারেক রহমানের সঙ্গে বিরোধীদলীয় নেতার একান্ত বৈঠক" /&gt;&lt;/p&gt;&lt;p&gt;প্রধানমন্ত্রী ও সংসদ নেতা তারেক রহমানের সঙ্গে একান্ত বৈঠক করেছেন বিরোধীদলীয় নেতা ও জামায়াতে ইসলামীর আমির ডা. শফিকুর রহমান। বুধবার (১৮ নভেম্বর) মাগরিবের নামাজের আগে জাতীয় সংসদ ভবনে অবস্থিত প্রধানমন্ত্রীর কার্যালয়ে এই বৈঠক অনুষ্ঠিত হয় বলে বিশ্বস্ত সূত্রে জানা গেছে।
সংশ্লিষ্ট সূত্র জানায়, মাগরিবের নামা&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821806/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%B0%E0%A6%B9%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%80%E0%A6%A6%E0%A6%B2%E0%A7%80%E0%A7%9F-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>ধেয়ে আসছে প্রবল ঘূর্ণিঝড় ‘আকভান’</title>
      <link>https://www.ittefaq.com.bd/821803/%E0%A6%A7%E0%A7%87%E0%A7%9F%E0%A7%87-%E0%A6%86%E0%A6%B8%E0%A6%9B%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%B2-%E0%A6%98%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A6%BF%E0%A6%9D%E0%A7%9C-%E2%80%98%E0%A6%86%E0%A6%95%E0%A6%AD%E0%A6%BE%E0%A6%A8%E2%80%99</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821803/%E0%A6%A7%E0%A7%87%E0%A7%9F%E0%A7%87-%E0%A6%86%E0%A6%B8%E0%A6%9B%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%B2-%E0%A6%98%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A6%BF%E0%A6%9D%E0%A7%9C-%E2%80%98%E0%A6%86%E0%A6%95%E0%A6%AD%E0%A6%BE%E0%A6%A8%E2%80%99</guid>
      <pubDate>Thu, 19 Nov 2026 06:28:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/5ac7d1feb6a3a65bf39ccf1f52fd4b20-6afe142a1f0b8.jpg?jadewits_media_id=323630" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/5ac7d1feb6a3a65bf39ccf1f52fd4b20-6afe142a1f0b8.jpg?jadewits_media_id=323630" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/5ac7d1feb6a3a65bf39ccf1f52fd4b20-6afe142a1f0b8.jpg?jadewits_media_id=323630" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ধেয়ে আসছে প্রবল ঘূর্ণিঝড় ‘আকভান’" /&gt;&lt;/p&gt;&lt;p&gt;অল্প সময়ের ব্যবধানে দুটি ঘূর্ণিঝড় ভারতের অন্ধ্র উপকূল অতিক্রম করার পর এবার বঙ্গোপসাগরে সৃস্টি হয়েছে তৃতীয় ঘূর্ণিঝড় &amp;lsquo;আকভান&amp;rsquo;। এটি প্রবল ঘূর্ণিঝড়ে রূপ পরিগ্রহ করেছে। এর প্রভাবে দেশের চার সমুদ্রবন্দর চট্টগ্রাম, কক্সবাজার, মোংলা ও পায়রায় ৩ নম্বর স্থানীয় সতর্কসংকেত জারি করেছে আবহাওয়া অধিদপ্তর।&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821803/%E0%A6%A7%E0%A7%87%E0%A7%9F%E0%A7%87-%E0%A6%86%E0%A6%B8%E0%A6%9B%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%B2-%E0%A6%98%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A6%BF%E0%A6%9D%E0%A7%9C-%E2%80%98%E0%A6%86%E0%A6%95%E0%A6%AD%E0%A6%BE%E0%A6%A8%E2%80%99">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>কুবি শিক্ষার্থীদের বহনকারী বাসে অগ্নিসংযোগের চেষ্টা</title>
      <link>https://www.ittefaq.com.bd/821802/%E0%A6%95%E0%A7%81%E0%A6%AC%E0%A6%BF-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%B9%E0%A6%A8%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%85%E0%A6%97%E0%A7%8D%E0%A6%A8%E0%A6%BF%E0%A6%B8%E0%A6%82%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821802/%E0%A6%95%E0%A7%81%E0%A6%AC%E0%A6%BF-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%B9%E0%A6%A8%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%85%E0%A6%97%E0%A7%8D%E0%A6%A8%E0%A6%BF%E0%A6%B8%E0%A6%82%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Thu, 19 Nov 2026 05:44:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/8603e50933cb49f8726c555ea9a8a7a8-6afe1293d8e57.jpg?jadewits_media_id=323629" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/8603e50933cb49f8726c555ea9a8a7a8-6afe1293d8e57.jpg?jadewits_media_id=323629" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/8603e50933cb49f8726c555ea9a8a7a8-6afe1293d8e57.jpg?jadewits_media_id=323629" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কুবি শিক্ষার্থীদের বহনকারী বাসে অগ্নিসংযোগের চেষ্টা" /&gt;&lt;/p&gt;&lt;p&gt;ঢাকা-চট্টগ্রাম মহাসড়কের কুমিল্লার বেলতলী বিশ্বরোড এলাকায় কুমিল্লা বিশ্ববিদ্যালয়ের (কুবি) শিক্ষার্থীদের বহনকারী একটি বাসে অগ্নিসংযোগের চেষ্টা চালিয়েছে দুর্বৃত্তরা। 
বুধবার (১৮ নভেম্বর) রাত ৯টার দিকে টায়ারে আগুন ধরিয়ে তা বাসটি লক্ষ্য করে নিক্ষেপ করা হয়। তবে জ্বলন্ত টায়ারটি লক্ষ্যভ্রষ্ট হওয়ায় এবং চালকে&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821802/%E0%A6%95%E0%A7%81%E0%A6%AC%E0%A6%BF-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%B9%E0%A6%A8%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%85%E0%A6%97%E0%A7%8D%E0%A6%A8%E0%A6%BF%E0%A6%B8%E0%A6%82%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%87%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>

      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/537485ba6857b9a76e3f48764d931a65-6b07a1b23b189.jpg?jadewits_media_id=324917" length="0" type="image/jpeg" />

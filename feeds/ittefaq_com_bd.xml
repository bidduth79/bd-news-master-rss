    <item>
      <title>আমিরাতের জাহাজ ছিনতায়ের অভিযোগ সোমালি দস্যুদের বিরুদ্ধে</title>
      <link>https://www.ittefaq.com.bd/823477/%E0%A6%86%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%9C-%E0%A6%9B%E0%A6%BF%E0%A6%A8%E0%A6%A4%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%B8%E0%A7%8B%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A6%BF-%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823477/%E0%A6%86%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%9C-%E0%A6%9B%E0%A6%BF%E0%A6%A8%E0%A6%A4%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%B8%E0%A7%8B%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A6%BF-%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Sat, 28 Nov 2026 21:24:29 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/29af6501f2355fce66631fa292046bfc-6b0af1f2b0824.jpg?jadewits_media_id=325375" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/29af6501f2355fce66631fa292046bfc-6b0af1f2b0824.jpg?jadewits_media_id=325375" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/29af6501f2355fce66631fa292046bfc-6b0af1f2b0824.jpg?jadewits_media_id=325375" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আমিরাতের জাহাজ ছিনতায়ের অভিযোগ সোমালি দস্যুদের বিরুদ্ধে" /&gt;&lt;/p&gt;&lt;p&gt;ইয়েমেনের উপকূল থেকে সংযুক্ত আরব আমিরাতের একটি জাহাজ ছিনতায়ের অভিযোগ সোমালি জলদস্যুদের বিরুদ্ধে। তারা জেলের ছদ্মবেশে ইয়েমেনে বসবাসরত সোমালি জনগোষ্ঠীর মধ্যে ছিল।
শনিবার (২৮ নভেম্বর) সামুদ্রিক নিরাপত্তাবিষয়ক সংস্থা ইউকেএমটিও জানায়, ইয়েমেনের বালহাফ থেকে ১২০ কিলোমিটার দূরে একটি পণ্যবাহী জাহাজে উঠেছে কিছু&lt;/p&gt;</description>

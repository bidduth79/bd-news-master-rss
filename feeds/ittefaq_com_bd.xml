      <guid isPermaLink="true">https://www.ittefaq.com.bd/821181/%E0%A6%86%E0%A6%B8%E0%A6%BF%E0%A6%AB%E0%A6%B0%E0%A7%87-%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B6%E0%A6%BE%E0%A6%B8%E0%A6%95-%E0%A6%B9%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%A0%E0%A6%BE%E0%A6%A8-%E0%A6%86%E0%A6%97%E0%A7%87%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Sun, 15 Nov 2026 21:32:18 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/4e9d5b5868c5562b4f9d07f78339c4a3-6af9d004b5d2b.jpg?jadewits_media_id=322994" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/4e9d5b5868c5562b4f9d07f78339c4a3-6af9d004b5d2b.jpg?jadewits_media_id=322994" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/4e9d5b5868c5562b4f9d07f78339c4a3-6af9d004b5d2b.jpg?jadewits_media_id=322994" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আসিফরে গোপালগঞ্জের প্রশাসক হিসেবে পাঠান, আগেরবার তো পালায় আসছিল" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জের প্রশাসক হিসেবে জাতীয় নাগরিক পার্টির (এনসিপি) সিনিয়র যুগ্ম সদস্যসচিব ও সাবেক অন্তর্বর্তী সরকারের উপদেষ্টা আসিফ মাহমুদ সজীব ভূঁইয়াকে পাঠিয়ে দেওয়ার কথা বলেছেন আমজনতা দলের সাধারণ সম্পাদক মো. তারেক রহমান।
রোববার (১৫ নভেম্বর) রাতে নিজের ফেসবুক পেজে এক পোস্টে তিনি এ কথা বলেন।
তারেক রহমান লিখেছে&lt;/p&gt;</description>

    <item>
      <title>জলবায়ু সুবিচার কত দূর?</title>
      <link>https://www.ittefaq.com.bd/820461/%E0%A6%9C%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A7%81-%E0%A6%B8%E0%A7%81%E0%A6%AC%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%A4-%E0%A6%A6%E0%A7%82%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820461/%E0%A6%9C%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A7%81-%E0%A6%B8%E0%A7%81%E0%A6%AC%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%A4-%E0%A6%A6%E0%A7%82%E0%A6%B0</guid>

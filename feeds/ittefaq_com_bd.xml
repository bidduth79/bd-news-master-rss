    <item>
      <title>গোমতীর মাটি কাটলে যত বড় হেডম ওয়ালাই হোক, কাউকে ছাড় দেওয়া হবে না: হাসনাত আবদুল্লাহ</title>
      <link>https://www.ittefaq.com.bd/820844/%E0%A6%97%E0%A7%8B%E0%A6%AE%E0%A6%A4%E0%A7%80%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%9F%E0%A6%BF-%E0%A6%95%E0%A6%BE%E0%A6%9F%E0%A6%B2%E0%A7%87-%E0%A6%AF%E0%A6%A4-%E0%A6%AC%E0%A7%9C-%E0%A6%B9%E0%A7%87%E0%A6%A1%E0%A6%AE-%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%87-%E0%A6%B9%E0%A7%8B%E0%A6%95-%E0%A6%95%E0%A6%BE%E0%A6%89%E0%A6%95%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A7%9C</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820844/%E0%A6%97%E0%A7%8B%E0%A6%AE%E0%A6%A4%E0%A7%80%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%9F%E0%A6%BF-%E0%A6%95%E0%A6%BE%E0%A6%9F%E0%A6%B2%E0%A7%87-%E0%A6%AF%E0%A6%A4-%E0%A6%AC%E0%A7%9C-%E0%A6%B9%E0%A7%87%E0%A6%A1%E0%A6%AE-%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%87-%E0%A6%B9%E0%A7%8B%E0%A6%95-%E0%A6%95%E0%A6%BE%E0%A6%89%E0%A6%95%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A7%9C</guid>
      <pubDate>Sat, 14 Nov 2026 00:34:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/033ead136176cf78550da1aa07a254a7-6af753915e1ed.jpg?jadewits_media_id=322641" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/033ead136176cf78550da1aa07a254a7-6af753915e1ed.jpg?jadewits_media_id=322641" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/033ead136176cf78550da1aa07a254a7-6af753915e1ed.jpg?jadewits_media_id=322641" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গোমতীর মাটি কাটলে যত বড় হেডম ওয়ালাই হোক, কাউকে ছাড় দেওয়া হবে না: হাসনাত আবদুল্লাহ" /&gt;&lt;/p&gt;&lt;p&gt;যারা গোমতী নদীর মাটি কাটার সিদ্ধান্ত নিয়েছে, তারা যত বড় হেডম ওয়ালাই হোক না কেন, তাদের বিন্দুমাত্র ছাড় দেওয়া হবে না বলে কঠোর হুঁশিয়ারি দিয়েছেন কুমিল্লা-৪ (দেবিদ্বার) আসনের সংসদ সদস্য হাসনাত আবদুল্লাহ। তিনি স্পষ্ট করে বলেছেন, নিয়মের মধ্যে কাজ করতে কোনো &amp;lsquo;হেডম&amp;rsquo; বা শক্তির প্রয়োজন হয় না। যারা &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820844/%E0%A6%97%E0%A7%8B%E0%A6%AE%E0%A6%A4%E0%A7%80%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%9F%E0%A6%BF-%E0%A6%95%E0%A6%BE%E0%A6%9F%E0%A6%B2%E0%A7%87-%E0%A6%AF%E0%A6%A4-%E0%A6%AC%E0%A7%9C-%E0%A6%B9%E0%A7%87%E0%A6%A1%E0%A6%AE-%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%87-%E0%A6%B9%E0%A7%8B%E0%A6%95-%E0%A6%95%E0%A6%BE%E0%A6%89%E0%A6%95%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A7%9C">দৈনিক ইত্তেফাক</source>

      <guid isPermaLink="true">https://www.ittefaq.com.bd/821192/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BF%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A6%BF%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%9C%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A6%96%E0%A6%9B%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Sun, 15 Nov 2026 23:19:51 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/9e321ea0ee2519963fa1ae696e8cf2ab-6af9e8c1608cd.jpg?jadewits_media_id=323005" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/9e321ea0ee2519963fa1ae696e8cf2ab-6af9e8c1608cd.jpg?jadewits_media_id=323005" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/9e321ea0ee2519963fa1ae696e8cf2ab-6af9e8c1608cd.jpg?jadewits_media_id=323005" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গোপালগঞ্জের পরিস্থিতির দিকে নজর রাখছে সরকার, পরিস্থিতি বুঝে নেওয়া হবে পদক্ষেপ" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জে কার্যক্রম নিষিদ্ধ আওয়ামী লীগের নেতা-কর্মীদের বিক্ষোভ, মহড়া ও সহিংস ঘটনাবলির দিকে নজর রাখছে সরকার। পরিস্থিতি বিবেচনা করে সেখানে আইনশৃঙ্খলা রক্ষাকারী বাহিনীর বলপ্রয়োগের মাত্রা বাড়ানোর বিষয়েও ভাবা হচ্ছে। তবে সরকার এখনই বলপ্রয়োগ করতে চায় না। পরিস্থিতি পর্যবেক্ষণ করে সে অনুযায়ী পদক্ষেপ নেওয়া হ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821192/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BF%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A6%BF%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%9C%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A6%96%E0%A6%9B%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0">দৈনিক ইত্তেফাক</source>

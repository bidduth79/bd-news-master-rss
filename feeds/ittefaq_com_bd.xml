    <item>
      <title>‘আপনি তো আলেম মানুষ, বেশি না দুই টাকা করে খাবেন’</title>
      <link>https://www.ittefaq.com.bd/821974/%E2%80%98%E0%A6%86%E0%A6%AA%E0%A6%A8%E0%A6%BF-%E0%A6%A4%E0%A7%8B-%E0%A6%86%E0%A6%B2%E0%A7%87%E0%A6%AE-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B7-%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%BF-%E0%A6%A8%E0%A6%BE-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%96%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%A8%E2%80%99</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821974/%E2%80%98%E0%A6%86%E0%A6%AA%E0%A6%A8%E0%A6%BF-%E0%A6%A4%E0%A7%8B-%E0%A6%86%E0%A6%B2%E0%A7%87%E0%A6%AE-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B7-%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%BF-%E0%A6%A8%E0%A6%BE-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%96%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%A8%E2%80%99</guid>
      <pubDate>Fri, 20 Nov 2026 00:27:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/5e3914cdaf5bce266ddb64068c2418b6-6aff350ae984c.jpg?jadewits_media_id=323810" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/5e3914cdaf5bce266ddb64068c2418b6-6aff350ae984c.jpg?jadewits_media_id=323810" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/5e3914cdaf5bce266ddb64068c2418b6-6aff350ae984c.jpg?jadewits_media_id=323810" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘আপনি তো আলেম মানুষ, বেশি না দুই টাকা করে খাবেন’" /&gt;&lt;/p&gt;&lt;p&gt;ইসলামী বিশ্ববিদ্যালয়ের (ইবি) এক অনুষ্ঠানে নিজের কাছে ঘুষের প্রস্তাব আসার ঘটনা তুলে ধরেছেন কুষ্টিয়া-৩ আসনের সংসদ সদস্য মুফতি আমির হামজা। পাশাপাশি কুষ্টিয়া সদরে চাঁদাবাজি এবং রাষ্ট্রের বিভিন্ন খাতে দুর্নীতির চিত্রও তুলে ধরেন তিনি।
বৃহস্পতিবার (১৯ নভেম্বর) ইসলামী বিশ্ববিদ্যালয়ে বাংলাদেশ ইসলামী ছাত্&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821974/%E2%80%98%E0%A6%86%E0%A6%AA%E0%A6%A8%E0%A6%BF-%E0%A6%A4%E0%A7%8B-%E0%A6%86%E0%A6%B2%E0%A7%87%E0%A6%AE-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B7-%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%BF-%E0%A6%A8%E0%A6%BE-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%96%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%A8%E2%80%99">দৈনিক ইত্তেফাক</source>
    </item>

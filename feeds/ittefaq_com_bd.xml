      <guid isPermaLink="true">https://www.ittefaq.com.bd/823050/%E0%A6%87%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8B%E0%A6%A8%E0%A7%87%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%96%E0%A6%A8%E0%A6%BF-%E0%A6%A7%E0%A6%B8%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A7%AF-%E0%A6%A8%E0%A6%BF%E0%A6%96%E0%A7%8B%E0%A6%81%E0%A6%9C-%E0%A7%A7%E0%A7%AD</guid>
      <pubDate>Thu, 26 Nov 2026 09:54:30 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/8a8ae48989a87701bfaeb6e77ddc7433-6b07ad218d308.jpg?jadewits_media_id=324924" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/8a8ae48989a87701bfaeb6e77ddc7433-6b07ad218d308.jpg?jadewits_media_id=324924" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/8a8ae48989a87701bfaeb6e77ddc7433-6b07ad218d308.jpg?jadewits_media_id=324924" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইন্দোনেশিয়ায় স্বর্ণের খনি ধসে নিহত ৯, নিখোঁজ ১৭" /&gt;&lt;/p&gt;&lt;p&gt;ইন্দোনেশিয়ার পশ্চিম জাভা প্রদেশে একটি অবৈধ স্বর্ণের খনিতে ধস ও বন্যার ঘটনায় অন্তত ৯ জনের মৃত্যু হয়েছে। এ ঘটনায় এখনো নিখোঁজ রয়েছেন ১৭ জন। তাদের উদ্ধারে অভিযান চালিয়ে যাচ্ছেন উদ্ধারকর্মীরা।
বুধবার (২৫ নভেম্বর) স্থানীয় সংবাদমাধ্যমের বরাত দিয়ে এ তথ্য জানিয়েছে বার্তা সংস্থা আনাদোলু।
প্রতিবেদনে বলা হয়েছে,&lt;/p&gt;</description>

      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/45bfd9daa9a0adb6cbe17865a595e481-6b08890d9386d.jpg?jadewits_media_id=325081" length="0" type="image/jpeg" />

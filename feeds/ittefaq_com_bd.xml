      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/6bab515c36f4ab19b8eb939432014ec7-6af9cfe5e1050.jpg?jadewits_media_id=322992" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/6bab515c36f4ab19b8eb939432014ec7-6af9cfe5e1050.jpg?jadewits_media_id=322992" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জিয়াউল আহসানের ভিআইপি প্রটোকল নিয়ে সংসদে ক্ষোভ, পুনরাবৃত্তি হবে না বললেন আইনমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;মানবতাবিরোধী অপরাধের মামলায় কারাগারে থাকা সাবেক সেনা কর্মকর্তা মেজর জেনারেল (অব.) জিয়াউল আহসানকে হাতকড়া ছাড়া আদালতে হাজির করার ঘটনায় সংসদে ক্ষোভ প্রকাশ করেছেন বিএনপির সংসদ সদস্য তাহসিনা রুশদীর লুনা। আদালতে নেওয়ার সময় তাকে ভিআইপি প্রটোকল দেওয়ার মতো পরিস্থিতি তৈরি হওয়ায় এ নিয়ে আইনমন্ত্রীর কাছে ব্যাখ্য&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821180/%E0%A6%9C%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%89%E0%A6%B2-%E0%A6%86%E0%A6%B9%E0%A6%B8%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AD%E0%A6%BF%E0%A6%86%E0%A6%87%E0%A6%AA%E0%A6%BF-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%9F%E0%A7%8B%E0%A6%95%E0%A6%B2-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6%E0%A7%87-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8B%E0%A6%AD">দৈনিক ইত্তেফাক</source>

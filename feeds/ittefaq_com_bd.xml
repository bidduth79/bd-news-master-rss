    <item>
      <title>‘বাংলাদেশ ফার্স্ট’ নীতি ও কৌশলগত অংশীদারত্বে জোর: বার্লিনে পররাষ্ট্র প্রতিমন্ত্রী</title>
      <link>https://www.ittefaq.com.bd/823337/%E2%80%98%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%AB%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B8%E0%A7%8D%E0%A6%9F%E2%80%99-%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A6%BF-%E0%A6%93-%E0%A6%95%E0%A7%8C%E0%A6%B6%E0%A6%B2%E0%A6%97%E0%A6%A4-%E0%A6%85%E0%A6%82%E0%A6%B6%E0%A7%80%E0%A6%A6%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A7%87-%E0%A6%9C%E0%A7%8B%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823337/%E2%80%98%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%AB%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B8%E0%A7%8D%E0%A6%9F%E2%80%99-%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A6%BF-%E0%A6%93-%E0%A6%95%E0%A7%8C%E0%A6%B6%E0%A6%B2%E0%A6%97%E0%A6%A4-%E0%A6%85%E0%A6%82%E0%A6%B6%E0%A7%80%E0%A6%A6%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A7%87-%E0%A6%9C%E0%A7%8B%E0%A6%B0</guid>
      <pubDate>Sat, 28 Nov 2026 02:30:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/8d48f9c9884405008caf33fb2a2626e5-6b09d5cfe0ded.jpg?jadewits_media_id=325232" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/8d48f9c9884405008caf33fb2a2626e5-6b09d5cfe0ded.jpg?jadewits_media_id=325232" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/8d48f9c9884405008caf33fb2a2626e5-6b09d5cfe0ded.jpg?jadewits_media_id=325232" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘বাংলাদেশ ফার্স্ট’ নীতি ও কৌশলগত অংশীদারত্বে জোর: বার্লিনে পররাষ্ট্র প্রতিমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;জাতীয় স্বার্থ ও দীর্ঘমেয়াদি সমৃদ্ধি নিশ্চিত করতে বিভিন্ন দেশের সঙ্গে বাস্তবভিত্তিক ও কৌশলগত অংশীদারত্ব গড়ে তোলার ওপর জোর দিয়েছেন পররাষ্ট্র প্রতিমন্ত্রী শামা ওবায়েদ ইসলাম। পরিবর্তিত বৈশ্বিক পরিস্থিতিতে অর্থনৈতিক নিরাপত্তা নিশ্চিত করা এবং কৌশলগত সরবরাহব্যবস্থা বহুমুখীকরণের ওপর বাংলাদেশ গুরুত্ব দি&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823337/%E2%80%98%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%AB%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B8%E0%A7%8D%E0%A6%9F%E2%80%99-%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A6%BF-%E0%A6%93-%E0%A6%95%E0%A7%8C%E0%A6%B6%E0%A6%B2%E0%A6%97%E0%A6%A4-%E0%A6%85%E0%A6%82%E0%A6%B6%E0%A7%80%E0%A6%A6%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A7%87-%E0%A6%9C%E0%A7%8B%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>পুতিনকে ‘বন্ধু’ বলা হিটলারকে ‘বন্ধু’ বলার সমান</title>
      <link>https://www.ittefaq.com.bd/823333/%E0%A6%AA%E0%A7%81%E0%A6%A4%E0%A6%BF%E0%A6%A8%E0%A6%95%E0%A7%87-%E2%80%98%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A7%81%E2%80%99-%E0%A6%AC%E0%A6%B2%E0%A6%BE%C2%A0%E0%A6%B9%E0%A6%BF%E0%A6%9F%E0%A6%B2%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A7%87-%E2%80%98%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A7%81%E2%80%99%C2%A0%E0%A6%AC%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823333/%E0%A6%AA%E0%A7%81%E0%A6%A4%E0%A6%BF%E0%A6%A8%E0%A6%95%E0%A7%87-%E2%80%98%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A7%81%E2%80%99-%E0%A6%AC%E0%A6%B2%E0%A6%BE%C2%A0%E0%A6%B9%E0%A6%BF%E0%A6%9F%E0%A6%B2%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A7%87-%E2%80%98%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A7%81%E2%80%99%C2%A0%E0%A6%AC%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%A8</guid>
      <pubDate>Sat, 28 Nov 2026 02:00:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/bc236e29380e59fcf9fb87e2f8b2b5fc-6b09d234bdef4.jpg?jadewits_media_id=325228" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/bc236e29380e59fcf9fb87e2f8b2b5fc-6b09d234bdef4.jpg?jadewits_media_id=325228" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/bc236e29380e59fcf9fb87e2f8b2b5fc-6b09d234bdef4.jpg?jadewits_media_id=325228" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পুতিনকে ‘বন্ধু’ বলা হিটলারকে ‘বন্ধু’ বলার সমান" /&gt;&lt;/p&gt;&lt;p&gt;অ্যান্টি-ব্যালিস্টিক ক্ষেপণাস্ত্র সরবরাহে দেরি হওয়ায় ইউক্রেনীয়দের প্রাণহানি ঘটছে এবং শান্তি আলোচনায়ও রাশিয়ার ওপর যথেষ্ট চাপ সৃষ্টি করা হচ্ছে না। মার্কিন যুক্তরাষ্ট্রের প্রতি হতাশা প্রকাশ করে এসব অভিযোগ তুলেছেন ইউক্রেনের প্রেসিডেন্ট ভলোদিমির জেলেনস্কি।
কিয়েভে অবস্থিত তার কার্যালয়ে বিবিসিকে দেওয়া এক স&lt;/p&gt;</description>

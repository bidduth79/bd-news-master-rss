    <item>
      <title>ভিনিসিয়ুসের সাবেক প্রেমিকার সঙ্গে নেইমারের ঘনিষ্ঠতার গুঞ্জন</title>
      <link>https://www.ittefaq.com.bd/821302/%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A6%B8%E0%A6%BF%E0%A7%9F%E0%A7%81%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AE%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%A8%E0%A7%87%E0%A6%87%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821302/%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A6%B8%E0%A6%BF%E0%A7%9F%E0%A7%81%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AE%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%A8%E0%A7%87%E0%A6%87%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Mon, 16 Nov 2026 14:54:58 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/3f30f7eb793483bc6a9edabaaeb98453-6afac4b06bde4.png?jadewits_media_id=323113" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/3f30f7eb793483bc6a9edabaaeb98453-6afac4b06bde4.png?jadewits_media_id=323113" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/3f30f7eb793483bc6a9edabaaeb98453-6afac4b06bde4.png?jadewits_media_id=323113" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভিনিসিয়ুসের সাবেক প্রেমিকার সঙ্গে নেইমারের ঘনিষ্ঠতার গুঞ্জন" /&gt;&lt;/p&gt;&lt;p&gt;আন্তর্জাতিক প্রীতি ম্যাচে জাপানের কাছে ৩-২ গোলে হারের রেশ কাটতে না কাটতেই মাঠের বাইরের এক ঘটনায় উত্তাল হয়ে উঠেছে ব্রাজিলের ফুটবল অঙ্গন। আলোচনার কেন্দ্রবিন্দুতে রয়েছেন ব্রাজিলিয়ান সুপারস্টার নেইমার জুনিয়র এবং রিয়াল মাদ্রিদ তারকা ভিনিসিয়ুস জুনিয়রের সাবেক প্রেমিকা ও জনপ্রিয় ইনফ্লুয়েন্সার ভার্জিনিয়া ফনস&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821302/%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A6%B8%E0%A6%BF%E0%A7%9F%E0%A7%81%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AE%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%A8%E0%A7%87%E0%A6%87%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>বাঘ সংরক্ষণ কর্মকর্তার বাসভবনে অভিযান, ১৪ কোটির নগদ অর্থ-স্বর্ণ জব্দ</title>
      <link>https://www.ittefaq.com.bd/821301/%E0%A6%AC%E0%A6%BE%E0%A6%98-%E0%A6%B8%E0%A6%82%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A3-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%AD%E0%A6%AC%E0%A6%A8%E0%A7%87-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A7%A7%E0%A7%AA-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821301/%E0%A6%AC%E0%A6%BE%E0%A6%98-%E0%A6%B8%E0%A6%82%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A3-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%AD%E0%A6%AC%E0%A6%A8%E0%A7%87-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A7%A7%E0%A7%AA-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF%E0%A6%B0</guid>
      <pubDate>Mon, 16 Nov 2026 14:53:53 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/113bfe1f676721144b25d6e22fb66e37-6afac3c98599d.jpg?jadewits_media_id=323112" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/113bfe1f676721144b25d6e22fb66e37-6afac3c98599d.jpg?jadewits_media_id=323112" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/113bfe1f676721144b25d6e22fb66e37-6afac3c98599d.jpg?jadewits_media_id=323112" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাঘ সংরক্ষণ কর্মকর্তার বাসভবনে অভিযান, ১৪ কোটির নগদ অর্থ-স্বর্ণ জব্দ" /&gt;&lt;/p&gt;&lt;p&gt;ভারতের মধ্যপ্রদেশে বাঘ সংরক্ষণ এলাকার কর্মকর্তার বাসভবনে অভিযান চালিয়ে ১৪ কোটির সমপরিমাণ স্বর্ণ, নগদ টাকা ও সম্পদ জব্দ করেছে দুর্নীতিবিরোধী সংস্থা-লোকায়ুক্ত। অভিযানে প্রায় ২ কোটি ৬৩ লাখ রুপি নগদ অর্থ এবং আড়াই কেজি স্বর্ণ জব্দ করা হয়েছে। জব্দ করা স্বর্ণের মূল্য প্রায় ৩ কোটি ৫০ লাখ রুপি, বাংলাদেশি মুদ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821301/%E0%A6%AC%E0%A6%BE%E0%A6%98-%E0%A6%B8%E0%A6%82%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A3-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%AD%E0%A6%AC%E0%A6%A8%E0%A7%87-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A7%A7%E0%A7%AA-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>মিনাবে হামলার নির্দেশদাতা দুই মার্কিন কর্মকর্তাকে ‘খুঁজে বের করবে’ ইরান</title>
      <link>https://www.ittefaq.com.bd/821300/%E0%A6%AE%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%A6%E0%A6%BE%E0%A6%A4%E0%A6%BE-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821300/%E0%A6%AE%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%A6%E0%A6%BE%E0%A6%A4%E0%A6%BE-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87</guid>
      <pubDate>Mon, 16 Nov 2026 14:45:30 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/d4f91fb94be439b8cd4efc2c9125ac04-6afac231bd0b3.jpg?jadewits_media_id=323111" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/d4f91fb94be439b8cd4efc2c9125ac04-6afac231bd0b3.jpg?jadewits_media_id=323111" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/d4f91fb94be439b8cd4efc2c9125ac04-6afac231bd0b3.jpg?jadewits_media_id=323111" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মিনাবে হামলার নির্দেশদাতা দুই মার্কিন কর্মকর্তাকে ‘খুঁজে বের করবে’ ইরান" /&gt;&lt;/p&gt;&lt;p&gt;ইরানের মিনাবের একটি স্কুলে হামলার অভিযোগে অভিযুক্ত যুক্তরাষ্ট্রের নৌবাহিনীর দুই কর্মকর্তাকে খুঁজে বের করার হুমকি দিয়েছে তেহরান। সোমবার (১৬ নভেম্বর) এনডিটিভির এক প্রতিবেদনে এই খবর জানানো হয়েছে।
সামাজিক যোগাযোগমাধ্যম এক্স-এ দক্ষিণ আফ্রিকায় অবস্থিত ইরানি দূতাবাস আট মাস আগের একটি পোস্ট পুনরায় শেয়ার &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821300/%E0%A6%AE%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%A6%E0%A6%BE%E0%A6%A4%E0%A6%BE-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>হঠাৎ পররাষ্ট্র মন্ত্রণালয়ে সাবেক মার্কিন রাষ্ট্রদূত পিটার হাস</title>
      <link>https://www.ittefaq.com.bd/821299/%E0%A6%B9%E0%A6%A0%E0%A6%BE%E0%A7%8E-%E0%A6%AA%E0%A6%B0%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0-%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A3%E0%A6%BE%E0%A6%B2%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821299/%E0%A6%B9%E0%A6%A0%E0%A6%BE%E0%A7%8E-%E0%A6%AA%E0%A6%B0%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0-%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A3%E0%A6%BE%E0%A6%B2%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8</guid>
      <pubDate>Mon, 16 Nov 2026 14:41:29 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/ae4c71440ace35fe8845e8f25a70beca-6afac19dbc265.jpg?jadewits_media_id=323110" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/ae4c71440ace35fe8845e8f25a70beca-6afac19dbc265.jpg?jadewits_media_id=323110" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/ae4c71440ace35fe8845e8f25a70beca-6afac19dbc265.jpg?jadewits_media_id=323110" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হঠাৎ পররাষ্ট্র মন্ত্রণালয়ে সাবেক মার্কিন রাষ্ট্রদূত পিটার হাস" /&gt;&lt;/p&gt;&lt;p&gt;ঢাকায় সফররত যুক্তরাষ্ট্রের সাবেক রাষ্ট্রদূত পিটার হাস পররাষ্ট্র মন্ত্রণালয়ে এসেছেন। সোমবার (১৬ নভেম্বর) দুপুরে তিনি পররাষ্ট্র মন্ত্রণালয়ে যান। তবে কী কারণে তিনি এসেছেন এবং কার সঙ্গে সাক্ষাৎ করেছেন এই বিষয়ে বিস্তারিত কিছু জানায়নি পররাষ্ট্র মন্ত্রণালয়।&amp;nbsp;
২০২২ থেকে ২০২৪ সাল পর্যন্ত বাংলাদেশে যুক্তর&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821299/%E0%A6%B9%E0%A6%A0%E0%A6%BE%E0%A7%8E-%E0%A6%AA%E0%A6%B0%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0-%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A3%E0%A6%BE%E0%A6%B2%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>গোপালগঞ্জে সহিংসতা নিষিদ্ধ আওয়ামী লীগের দেউলিয়াত্বের প্রমাণ: তথ্যমন্ত্রী</title>

      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/3f5f2d88f9cf4eb4f09d1bf33866cd9d-6b088a211fa8f.jpg?jadewits_media_id=325082" medium="image" />

    <item>
      <title>আগুন-সহিংসতা চলছেই</title>
      <link>https://www.ittefaq.com.bd/821987/%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%B8%E0%A6%B9%E0%A6%BF%E0%A6%82%E0%A6%B8%E0%A6%A4%E0%A6%BE-%E0%A6%9A%E0%A6%B2%E0%A6%9B%E0%A7%87%E0%A6%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821987/%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%B8%E0%A6%B9%E0%A6%BF%E0%A6%82%E0%A6%B8%E0%A6%A4%E0%A6%BE-%E0%A6%9A%E0%A6%B2%E0%A6%9B%E0%A7%87%E0%A6%87</guid>
      <pubDate>Fri, 20 Nov 2026 08:00:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/4d2840da37129802acb633a33ff544c4-6aff5351ce11d.jpg?jadewits_media_id=323823" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/4d2840da37129802acb633a33ff544c4-6aff5351ce11d.jpg?jadewits_media_id=323823" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/4d2840da37129802acb633a33ff544c4-6aff5351ce11d.jpg?jadewits_media_id=323823" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আগুন-সহিংসতা চলছেই" /&gt;&lt;/p&gt;&lt;p&gt;চলমান সহিংসতা থামছেই না। গতকাল বৃহস্পতিবারও দেশের বিভিন্নস্থানে আগুন, ভাঙচুর ও সহিংসতার ঘটনা ঘটেছে। দেশের বিভিন্ন জায়গায় কার্যক্রম নিষিদ্ধ আওয়ামী লীগ সরকারের সাবেক মন্ত্রী ও এমপিদের বাড়িতে ভাঙচুরের পর আগুন দেওয়া হয়েছে। অন্যদিকে, গোপালগঞ্জ-১ ও ২ আসনের সংসদ সদস্যের বাড়িতে ভাঙচুর, লুটপাট ও অগ্নিসংযোগের&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821987/%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%B8%E0%A6%B9%E0%A6%BF%E0%A6%82%E0%A6%B8%E0%A6%A4%E0%A6%BE-%E0%A6%9A%E0%A6%B2%E0%A6%9B%E0%A7%87%E0%A6%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>অনন্তের পথে মানুষের একাকী দূত!</title>
      <link>https://www.ittefaq.com.bd/821991/%E0%A6%85%E0%A6%A8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A7%87%E0%A6%B0-%E0%A6%8F%E0%A6%95%E0%A6%BE%E0%A6%95%E0%A7%80-%E0%A6%A6%E0%A7%82%E0%A6%A4</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821991/%E0%A6%85%E0%A6%A8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A7%87%E0%A6%B0-%E0%A6%8F%E0%A6%95%E0%A6%BE%E0%A6%95%E0%A7%80-%E0%A6%A6%E0%A7%82%E0%A6%A4</guid>
      <pubDate>Fri, 20 Nov 2026 07:30:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2025/01/13/930b67d35c3d5b85482546b121685121-6784d15773bfa.jpg?jadewits_media_id=205192" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2025/01/13/930b67d35c3d5b85482546b121685121-6784d15773bfa.jpg?jadewits_media_id=205192" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2025/01/13/930b67d35c3d5b85482546b121685121-6784d15773bfa.jpg?jadewits_media_id=205192" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অনন্তের পথে মানুষের একাকী দূত!" /&gt;&lt;/p&gt;&lt;p&gt;ভয়েজার-১! প্রায় অর্ধশতাব্দী ধরিয়া সে ছুটিতেছে অন্ধকার মহাকাশের বুক চিরিয়া। পিছনে পড়িয়া রহিয়াছে তাহার জন্মভূমি পৃথিবী, সূর্য, গ্রহ-উপগ্রহ, পরিচিত সৌরজগৎ। সামনে কী আছে, তাহা সে জানে না। ১৯৭৭ সালের ৫ সেপ্টেম্বর যাত্রা শুরু করিয়াছিল নাসার এই মহাকাশযান। তখন ইহার আয়ুষ্কাল ধরা হইয়াছিল মাত্র পাঁচ বৎসর। অথচ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821991/%E0%A6%85%E0%A6%A8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A7%87%E0%A6%B0-%E0%A6%8F%E0%A6%95%E0%A6%BE%E0%A6%95%E0%A7%80-%E0%A6%A6%E0%A7%82%E0%A6%A4">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>শিক্ষাপ্রতিষ্ঠানের কঠোরতা কেড়ে নিচ্ছে অনেক শিশুর শিক্ষাজীবন!</title>
      <link>https://www.ittefaq.com.bd/821989/%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%A0%E0%A7%8B%E0%A6%B0%E0%A6%A4%E0%A6%BE-%E0%A6%95%E0%A7%87%E0%A7%9C%E0%A7%87%C2%A0%E0%A6%A8%E0%A6%BF%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%85%E0%A6%A8%E0%A7%87%E0%A6%95-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821989/%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%A0%E0%A7%8B%E0%A6%B0%E0%A6%A4%E0%A6%BE-%E0%A6%95%E0%A7%87%E0%A7%9C%E0%A7%87%C2%A0%E0%A6%A8%E0%A6%BF%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%85%E0%A6%A8%E0%A7%87%E0%A6%95-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%B0</guid>
      <pubDate>Fri, 20 Nov 2026 07:00:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/a79a1072d2bad69d5ba66f7b95fd3f0b-6aff544f2f830.jpg?jadewits_media_id=323825" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/a79a1072d2bad69d5ba66f7b95fd3f0b-6aff544f2f830.jpg?jadewits_media_id=323825" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/a79a1072d2bad69d5ba66f7b95fd3f0b-6aff544f2f830.jpg?jadewits_media_id=323825" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শিক্ষাপ্রতিষ্ঠানের কঠোরতা কেড়ে নিচ্ছে অনেক শিশুর শিক্ষাজীবন!" /&gt;&lt;/p&gt;&lt;p&gt;এসএসসি পরীক্ষায় শতভাগ জিপিএ-৫ নিশ্চিত করতে নির্বাচনি পরীক্ষায় কম নম্বর পাওয়া শিক্ষার্থীদের ফরম পূরণ করতে না দেওয়ার অভিযোগ উঠেছে নরসিংদীর নাছিমা কাদির মোল্লা হাইস্কুল অ্যান্ড হোমসের বিরুদ্ধে। অভিযোগের সত্যতা যাচাইয়ের পর প্রতিষ্ঠানটিকে কারণ দর্শানোর নোটিশ দিয়েছে ঢাকা মাধ্যমিক ও উচ্চমাধ্যমিক শিক্ষা বোর&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821989/%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%A0%E0%A7%8B%E0%A6%B0%E0%A6%A4%E0%A6%BE-%E0%A6%95%E0%A7%87%E0%A7%9C%E0%A7%87%C2%A0%E0%A6%A8%E0%A6%BF%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%85%E0%A6%A8%E0%A7%87%E0%A6%95-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>জিহ্বা: নেক আমলের শ্রেষ্ঠ হাতিয়ার</title>
      <link>https://www.ittefaq.com.bd/821992/%E0%A6%9C%E0%A6%BF%E0%A6%B9%E0%A7%8D%E0%A6%AC%E0%A6%BE-%E0%A6%A8%E0%A7%87%E0%A6%95-%E0%A6%86%E0%A6%AE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B7%E0%A7%8D%E0%A6%A0-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821992/%E0%A6%9C%E0%A6%BF%E0%A6%B9%E0%A7%8D%E0%A6%AC%E0%A6%BE-%E0%A6%A8%E0%A7%87%E0%A6%95-%E0%A6%86%E0%A6%AE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B7%E0%A7%8D%E0%A6%A0-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Fri, 20 Nov 2026 06:30:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/9e696c6636549e7005d16132973b3717-6aff5842a307b.jpg?jadewits_media_id=323826" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/9e696c6636549e7005d16132973b3717-6aff5842a307b.jpg?jadewits_media_id=323826" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/9e696c6636549e7005d16132973b3717-6aff5842a307b.jpg?jadewits_media_id=323826" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জিহ্বা: নেক আমলের শ্রেষ্ঠ হাতিয়ার" /&gt;&lt;/p&gt;&lt;p&gt;মানবদেহের ক্ষুদ্রতম অঙ্গগুলোর মধ্যে জিহ্বা অন্যতম। আকৃতিতে ছোট হলেও এর ক্ষমতা, প্রভাব এবং পরিণতি অত্যন্ত ব্যাপক ও সুদূরপ্রসারী মানুষ হিসেবে আমাদের প্রকাশভঙ্গি, বিশ্বাস ও চরিত্রের সবচেয়ে বড় দর্পণ হলো এই জিহ্বা। এটি এমন একটি শক্তিশালী হাতিয়ার, যার সঠিক ব্যবহারের মাধ্যমে একজন মানুষ জান্নাতের উচ্চ মোকাম&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821992/%E0%A6%9C%E0%A6%BF%E0%A6%B9%E0%A7%8D%E0%A6%AC%E0%A6%BE-%E0%A6%A8%E0%A7%87%E0%A6%95-%E0%A6%86%E0%A6%AE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B7%E0%A7%8D%E0%A6%A0-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>

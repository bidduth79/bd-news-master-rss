      <title>ক্ষমতা ছাড়ার আগে আরেকটি দেশে হামলা করতে চান ট্রাম্প</title>
      <link>https://www.ittefaq.com.bd/820807/%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%AE%E0%A6%A4%E0%A6%BE-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%9F%E0%A6%BF-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820807/%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%AE%E0%A6%A4%E0%A6%BE-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%9F%E0%A6%BF-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%A8</guid>
      <pubDate>Fri, 13 Nov 2026 20:13:34 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/e80ea5e50487c1f6a3668868e0399d0d-6af71ae2c48bc.jpg?jadewits_media_id=322604" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/e80ea5e50487c1f6a3668868e0399d0d-6af71ae2c48bc.jpg?jadewits_media_id=322604" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/e80ea5e50487c1f6a3668868e0399d0d-6af71ae2c48bc.jpg?jadewits_media_id=322604" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ক্ষমতা ছাড়ার আগে আরেকটি দেশে হামলা করতে চান ট্রাম্প" /&gt;&lt;/p&gt;&lt;p&gt;প্রেসিডেন্ট হিসেবে মেয়াদ শেষ হওয়ার আগে কিউবার বিরুদ্ধে সামরিক অভিযান চালানোর বিষয়টি বিবেচনা করবেন বলে জানিয়েছেন যুক্তরাষ্ট্রের প্রেসিডেন্ট ডোনাল্ড ট্রাম্প। একই সময়ে ইরানের সঙ্গে চলমান যুদ্ধ নিয়ে কূটনৈতিক আলোচনা থেকে সরে আসার ইঙ্গিতও দিয়েছেন তিনি। সাম্প্রতিক মধ্যবর্তী নির্বাচনে রিপাবলিকান পার্টির পরা&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820807/%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%AE%E0%A6%A4%E0%A6%BE-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%9F%E0%A6%BF-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%A8">দৈনিক ইত্তেফাক</source>
    </item>

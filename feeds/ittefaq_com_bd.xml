      <guid isPermaLink="true">https://www.ittefaq.com.bd/820709/%E0%A6%AE%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B8%E0%A6%AB%E0%A6%9F-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%AD%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%9F-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%9C%E0%A7%81%E0%A7%9C%E0%A7%87</guid>
      <pubDate>Fri, 13 Nov 2026 11:24:32 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/8ceb4062da6161ed9521531a890271f1-6af69eb938c4a.jpg?jadewits_media_id=322500" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/8ceb4062da6161ed9521531a890271f1-6af69eb938c4a.jpg?jadewits_media_id=322500" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/8ceb4062da6161ed9521531a890271f1-6af69eb938c4a.jpg?jadewits_media_id=322500" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মাইক্রোসফট ব্যবহারে বিভ্রাট, বিশ্বজুড়ে ইমেইল-ক্লাউডসহ বিভিন্ন সেবায় অচলাবস্থা" /&gt;&lt;/p&gt;&lt;p&gt;বিশ্বজুড়ে ধরে বড় ধরনের কারিগরি বিপর্যয়ের মুখে পড়েছে শীর্ষ প্রযুক্তি প্রতিষ্ঠান মাইক্রোসফটের জনপ্রিয় সেবা আউটলুক ও টিমস। বৃহস্পতিবার (১২ নভেম্বর) শুরু হওয়া এই সার্ভার জটিলতায় যুক্তরাষ্ট্র, অস্ট্রেলিয়া, ভারত ও জাপানসহ এশিয়া-প্যাসিফিক অঞ্চলের অসংখ্য সরকারি দপ্তর এবং করপোরেট প্রতিষ্ঠানের দৈনন্দিন কার্যক&lt;/p&gt;</description>

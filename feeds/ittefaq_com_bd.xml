    <item>
      <title>চট্টগ্রামে টহল পুলিশের গাড়ি নিয়ে গেল চোর</title>
      <link>https://www.ittefaq.com.bd/821722/%E0%A6%9A%E0%A6%9F%E0%A7%8D%E0%A6%9F%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%9F%E0%A6%B9%E0%A6%B2-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%B2-%E0%A6%9A%E0%A7%8B%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821722/%E0%A6%9A%E0%A6%9F%E0%A7%8D%E0%A6%9F%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%9F%E0%A6%B9%E0%A6%B2-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%B2-%E0%A6%9A%E0%A7%8B%E0%A6%B0</guid>
      <pubDate>Wed, 18 Nov 2026 18:29:17 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/8b7e51b70024957c4a16d36003c7d560-6afd9a14186b0.jpg?jadewits_media_id=323554" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/8b7e51b70024957c4a16d36003c7d560-6afd9a14186b0.jpg?jadewits_media_id=323554" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/8b7e51b70024957c4a16d36003c7d560-6afd9a14186b0.jpg?jadewits_media_id=323554" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চট্টগ্রামে টহল পুলিশের গাড়ি নিয়ে গেল চোর" /&gt;&lt;/p&gt;&lt;p&gt;পুলিশ লাইনের সামনের সড়কে থানার &amp;lsquo;পিকআপ ভ্যান&amp;rsquo; রেখে হোটেলে ভাত খাচ্ছিলেন কয়েকজন পুলিশ সদস্য। ফিরে এসে দেখেন তাদের গাড়িটি আর নেই। সিসি ক্যামেরার ফুটেজে দেখা গেছে, এক ব্যক্তি গাড়িতে উঠে দ্রুত সেটি নিয়ে&amp;nbsp; লাপাত্তা হয়ে যান।&amp;nbsp;
বুধবার (১৮ নভেম্বর) দুপুর পৌনে ৩টার দিকে নগরীর হালিশহর থানা&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821722/%E0%A6%9A%E0%A6%9F%E0%A7%8D%E0%A6%9F%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%9F%E0%A6%B9%E0%A6%B2-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%B2-%E0%A6%9A%E0%A7%8B%E0%A6%B0">দৈনিক ইত্তেফাক</source>

      <guid isPermaLink="true">https://www.ittefaq.com.bd/821893/%E0%A6%9C%E0%A7%81%E0%A6%B2%E0%A6%BE%E0%A6%87-%E0%A6%97%E0%A6%A3-%E0%A6%85%E0%A6%AD%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%A4%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A6%95%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95</guid>
      <pubDate>Thu, 19 Nov 2026 16:07:41 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/38df795c7da0a3d9edee10ea4f646f16-6afeca2e6ea61.jpg?jadewits_media_id=323726" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/38df795c7da0a3d9edee10ea4f646f16-6afeca2e6ea61.jpg?jadewits_media_id=323726" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/38df795c7da0a3d9edee10ea4f646f16-6afeca2e6ea61.jpg?jadewits_media_id=323726" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জুলাই গণ-অভ্যুত্থানকালের হত্যা মামলায় সাবেক শিক্ষামন্ত্রী নাহিদ কারাগারে" /&gt;&lt;/p&gt;&lt;p&gt;জুলাই গণ&amp;ndash;অভ্যুত্থানকালে রাজধানীর উত্তরায় মাদ্রাসাছাত্র সাদিকুল ইসলামকে গুলি করে হত্যা মামলায় সাবেক শিক্ষামন্ত্রী নুরুল ইসলাম নাহিদ নাহিদকে কারাগারে পাঠানো হয়েছে।
বৃহস্পতিবার (১৯ নভেম্বর) শুনানি নিয়ে এ আদেশ দেন ঢাকার মেট্রোপলিটন ম্যাজিস্ট্রেট রিপন হোসেন।
জানা যায়, এ মামলায় সাবেক শিক্ষামন্ত্রী ন&lt;/p&gt;</description>

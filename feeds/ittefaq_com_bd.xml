      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/54da4177cc2809b6c61128478161fb95-6af81f4724f3d.jpg?jadewits_media_id=322720" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/54da4177cc2809b6c61128478161fb95-6af81f4724f3d.jpg?jadewits_media_id=322720" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিয়ের আসর থেকে ৪ ভরি স্বর্ণ নিয়ে উধাও কনে, দিশেহারা বর" /&gt;&lt;/p&gt;&lt;p&gt;হবিগঞ্জ থেকে ৪২ জন বরযাত্রী নিয়ে রংপুরে বিয়ে করতে এসেছিলেন ব্রুনাইপ্রবাসী ফয়ছল আহমেদ। কমিউনিটি সেন্টারে বিয়ের আয়োজনও প্রায় সম্পন্ন। কিন্তু বিয়ের পিঁড়িতে বসার আগেই চার ভরি স্বর্ণালংকার নিয়ে উধাও হয়ে যান কনে ও তার সঙ্গে থাকা কথিত স্বজনেরা। শেষ পর্যন্ত কনে ছাড়াই খালিহাতে বরযাত্রীদের নিয়ে ফিরতে হয়েছে বর&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820923/%E0%A6%AC%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%B8%E0%A6%B0-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A7%AA-%E0%A6%AD%E0%A6%B0%E0%A6%BF-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3-%E0%A6%A8%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%89%E0%A6%A7%E0%A6%BE%E0%A6%93-%E0%A6%95%E0%A6%A8%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>আপসহীনতার প্রতীক বেগম খালেদা জিয়া বেঁচে থাকবেন মানুষের হৃদয়ে</title>
      <link>https://www.ittefaq.com.bd/820922/%E0%A6%86%E0%A6%AA%E0%A6%B8%E0%A6%B9%E0%A7%80%E0%A6%A8%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A7%80%E0%A6%95-%E0%A6%AC%E0%A7%87%E0%A6%97%E0%A6%AE-%E0%A6%96%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A6%E0%A6%BE-%E0%A6%9C%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE-%E0%A6%AC%E0%A7%87%E0%A6%81%E0%A6%9A%E0%A7%87-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%AC%E0%A7%87%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820922/%E0%A6%86%E0%A6%AA%E0%A6%B8%E0%A6%B9%E0%A7%80%E0%A6%A8%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A7%80%E0%A6%95-%E0%A6%AC%E0%A7%87%E0%A6%97%E0%A6%AE-%E0%A6%96%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A6%E0%A6%BE-%E0%A6%9C%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE-%E0%A6%AC%E0%A7%87%E0%A6%81%E0%A6%9A%E0%A7%87-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%AC%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Sat, 14 Nov 2026 14:35:58 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/ed79db9c1c0dfc640d6d85ea3323462d-6af81d35b91ad.jpg?jadewits_media_id=322719" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/ed79db9c1c0dfc640d6d85ea3323462d-6af81d35b91ad.jpg?jadewits_media_id=322719" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/ed79db9c1c0dfc640d6d85ea3323462d-6af81d35b91ad.jpg?jadewits_media_id=322719" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আপসহীনতার প্রতীক বেগম খালেদা জিয়া বেঁচে থাকবেন মানুষের হৃদয়ে" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশের রাজনীতির ইতিহাসে আপসহীন মহীয়সী নারী হিসেবে বেগম খালেদা জিয়ার নাম চিরস্মরণীয় হয়ে থাকবে। তিনি ছিলেন দেশের এক অনন্য রাজনৈতিক নেতৃত্বের প্রতীক। ৪৩ বছরের বর্ণাঢ্য রাজনৈতিক জীবন শেষে গত বছরের ৩০ ডিসেম্বর ৮০ বছর বয়সে কোটি কোটি মানুষকে কাঁদিয়ে তিনি চিরবিদায় নেন। তার প্রয়াণের মধ্য দিয়ে বা&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820922/%E0%A6%86%E0%A6%AA%E0%A6%B8%E0%A6%B9%E0%A7%80%E0%A6%A8%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A7%80%E0%A6%95-%E0%A6%AC%E0%A7%87%E0%A6%97%E0%A6%AE-%E0%A6%96%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A6%E0%A6%BE-%E0%A6%9C%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE-%E0%A6%AC%E0%A7%87%E0%A6%81%E0%A6%9A%E0%A7%87-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%AC%E0%A7%87%E0%A6%A8">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>দেশের চিকিৎসকরা রাজনীতির শিকার হয়েছেন: মির্জা আব্বাস</title>

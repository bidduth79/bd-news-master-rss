    <item>
      <title>এসএসসিতে বোর্ডপ্রতি জিপিএ-৫ প্রাপ্ত ১০০ শিক্ষার্থীকে ল্যাপটপ দেবে সরকার</title>
      <link>https://www.ittefaq.com.bd/822730/%E0%A6%8F%E0%A6%B8%E0%A6%8F%E0%A6%B8%E0%A6%B8%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF-%E0%A6%9C%E0%A6%BF%E0%A6%AA%E0%A6%BF%E0%A6%8F-%E0%A7%AB-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%A4-%E0%A7%A7%E0%A7%A6%E0%A7%A6</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822730/%E0%A6%8F%E0%A6%B8%E0%A6%8F%E0%A6%B8%E0%A6%B8%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF-%E0%A6%9C%E0%A6%BF%E0%A6%AA%E0%A6%BF%E0%A6%8F-%E0%A7%AB-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%A4-%E0%A7%A7%E0%A7%A6%E0%A7%A6</guid>
      <pubDate>Tue, 24 Nov 2026 11:04:22 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/2ba7a945ffc4751cecc81c4d766a0616-6b051a8ee6eac.png?jadewits_media_id=324570" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/2ba7a945ffc4751cecc81c4d766a0616-6b051a8ee6eac.png?jadewits_media_id=324570" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/2ba7a945ffc4751cecc81c4d766a0616-6b051a8ee6eac.png?jadewits_media_id=324570" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এসএসসিতে বোর্ডপ্রতি জিপিএ-৫ প্রাপ্ত ১০০ শিক্ষার্থীকে ল্যাপটপ দেবে সরকার" /&gt;&lt;/p&gt;&lt;p&gt;চলতি বছরের এসএসসি ও সমমানের পরীক্ষায় বোর্ডপ্রতি সব বিষয়ে জিপিএ-৫ প্রাপ্ত সর্বোচ্চ নম্বরধারী প্রথম ১০০ জন শিক্ষার্থীকে ল্যাপটপ দেবে সরকার।
প্রস্তাবনা অনুযায়ী, দেশের ১১টি শিক্ষা বোর্ডে সব বিষয়ে যারা জিপিএ-৫ পেয়েছে, তাদের মধ্য থেকে মেধাক্রমের ভিত্তিতে প্রণোদনা হিসেবে এ ল্যাপটপ দেওয়া হবে। অর্থাৎ বোর্ডপ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822730/%E0%A6%8F%E0%A6%B8%E0%A6%8F%E0%A6%B8%E0%A6%B8%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF-%E0%A6%9C%E0%A6%BF%E0%A6%AA%E0%A6%BF%E0%A6%8F-%E0%A7%AB-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%A4-%E0%A7%A7%E0%A7%A6%E0%A7%A6">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>রেকর্ড গড়ে এমএলএসে বর্ষসেরা তরুণ বাংলাদেশি বংশোদ্ভূত কাভান সুলিভান</title>
      <link>https://www.ittefaq.com.bd/822729/%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A1-%E0%A6%97%E0%A7%9C%E0%A7%87-%E0%A6%8F%E0%A6%AE%E0%A6%8F%E0%A6%B2%E0%A6%8F%E0%A6%B8%E0%A7%87-%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A6%B8%E0%A7%87%E0%A6%B0%E0%A6%BE-%E0%A6%A4%E0%A6%B0%E0%A7%81%E0%A6%A3-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822729/%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A1-%E0%A6%97%E0%A7%9C%E0%A7%87-%E0%A6%8F%E0%A6%AE%E0%A6%8F%E0%A6%B2%E0%A6%8F%E0%A6%B8%E0%A7%87-%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A6%B8%E0%A7%87%E0%A6%B0%E0%A6%BE-%E0%A6%A4%E0%A6%B0%E0%A7%81%E0%A6%A3-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF</guid>
      <pubDate>Tue, 24 Nov 2026 10:58:55 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/968ef2d4ffbb5ba9bbe69040a4fa0253-6b0518eaefad5.jpg?jadewits_media_id=324569" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/968ef2d4ffbb5ba9bbe69040a4fa0253-6b0518eaefad5.jpg?jadewits_media_id=324569" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/968ef2d4ffbb5ba9bbe69040a4fa0253-6b0518eaefad5.jpg?jadewits_media_id=324569" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রেকর্ড গড়ে এমএলএসে বর্ষসেরা তরুণ বাংলাদেশি বংশোদ্ভূত কাভান সুলিভান" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাষ্ট্রের ফুটবলে রেকর্ডের পর রেকর্ড গড়েছেন বাংলাদেশি বংশোদ্ভূত কাভান সুলিভান। মেজর লিগ সকারে (এমএলএস) ২০২৬ সালের সেরা তরুণ খেলোয়াড় নির্বাচিত হয়েছেন ফিলাডেলফিয়া ইউনিয়নের এই অ্যাটাকিং মিডফিল্ডার।
সবচেয়ে কম বয়সী খেলোয়াড় হিসেবে ১৭ বছর ৫৬ দিন বয়সে এই পুরস্কারটি জিতেছেন সুলিভান। এমএলএস ক্লাবগুলোর কার&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822729/%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A1-%E0%A6%97%E0%A7%9C%E0%A7%87-%E0%A6%8F%E0%A6%AE%E0%A6%8F%E0%A6%B2%E0%A6%8F%E0%A6%B8%E0%A7%87-%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A6%B8%E0%A7%87%E0%A6%B0%E0%A6%BE-%E0%A6%A4%E0%A6%B0%E0%A7%81%E0%A6%A3-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>মানহানির মামলা করলেন তানজিন তিশা</title>
      <link>https://www.ittefaq.com.bd/822728/%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%B9%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%9C%E0%A6%BF%E0%A6%A8-%E0%A6%A4%E0%A6%BF%E0%A6%B6%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822728/%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%B9%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%9C%E0%A6%BF%E0%A6%A8-%E0%A6%A4%E0%A6%BF%E0%A6%B6%E0%A6%BE</guid>
      <pubDate>Tue, 24 Nov 2026 10:52:42 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/a164ba862b8664afbbecfa7adbbdbad6-6b0517718b59a.jpg?jadewits_media_id=324566" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/a164ba862b8664afbbecfa7adbbdbad6-6b0517718b59a.jpg?jadewits_media_id=324566" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/a164ba862b8664afbbecfa7adbbdbad6-6b0517718b59a.jpg?jadewits_media_id=324566" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মানহানির মামলা করলেন তানজিন তিশা" /&gt;&lt;/p&gt;&lt;p&gt;অভিনেত্রী তানজিন তিশা এবার সানায়্যা আনাম ওয়াফিকাহ ও ফাতেমা তুজ জোহরা নামে দুইজনের বিরুদ্ধে মানহানির মামলা দায়ের করেছেন। গত ৪ নভেম্বর ঢাকার অতিরিক্ত চিফ মেট্রোপলিটন ম্যাজিস্ট্রেট জশিতা ইসলামের আদালতে মামলাটি করা হয়।
মামলার বিষয়টি নিশ্চিত করেছেন অভিনেত্রীর আইনজীবী মো. জসীমউদ্দীন।&amp;nbsp;
তিনি জানান, গত &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822728/%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%B9%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%9C%E0%A6%BF%E0%A6%A8-%E0%A6%A4%E0%A6%BF%E0%A6%B6%E0%A6%BE">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>ঢাকাসহ দেশের বিভিন্ন স্থানে ভূমিকম্প অনুভূত, উৎপত্তিস্থল নেপালে</title>
      <link>https://www.ittefaq.com.bd/822727/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B8%E0%A6%B9-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%A8-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%AD%E0%A7%82%E0%A6%AE%E0%A6%BF%E0%A6%95%E0%A6%AE%E0%A7%8D%E0%A6%AA-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AD%E0%A7%82%E0%A6%A4</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822727/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B8%E0%A6%B9-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%A8-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%AD%E0%A7%82%E0%A6%AE%E0%A6%BF%E0%A6%95%E0%A6%AE%E0%A7%8D%E0%A6%AA-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AD%E0%A7%82%E0%A6%A4</guid>
      <pubDate>Tue, 24 Nov 2026 10:52:10 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/bcb5bf435b849cf58d2fef84c64fb7c8-6b0517a89d15e.jpg?jadewits_media_id=324567" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/bcb5bf435b849cf58d2fef84c64fb7c8-6b0517a89d15e.jpg?jadewits_media_id=324567" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/bcb5bf435b849cf58d2fef84c64fb7c8-6b0517a89d15e.jpg?jadewits_media_id=324567" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঢাকাসহ দেশের বিভিন্ন স্থানে ভূমিকম্প অনুভূত, উৎপত্তিস্থল নেপালে" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানী ঢাকাসহ দেশের বিভিন্ন স্থানে মঙ্গলবার (২৪ নভেম্বর) সকালে ভূমিকম্প অনুভূত হয়েছে। রিখটার স্কেলে এর মাত্রা ছিল ৫ দশমিক ৩। ভূমিকম্পটির উৎপত্তিস্থল ছিল নেপালে, যা ঢাকা থেকে ৫১৬ কিলোমিটার দূরে। আবহাওয়া অধিদপ্তর সূত্রে এ তথ্য জানা গেছে। সংশ্লিষ্ট সূত্র জানিয়েছে, চলতি মাসে এর আগে এত মাত্রার ভূমিকম্প &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822727/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B8%E0%A6%B9-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%A8-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%AD%E0%A7%82%E0%A6%AE%E0%A6%BF%E0%A6%95%E0%A6%AE%E0%A7%8D%E0%A6%AA-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AD%E0%A7%82%E0%A6%A4">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>স্তন ক্যানসারের নতুন ওষুধ অনুমোদন দিল যুক্তরাষ্ট্র</title>

    <item>
      <title>ছাত্রদলের মিছিলে ককটেল হামলা, নারীসহ আটক ৪</title>
      <link>https://www.ittefaq.com.bd/823492/%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A6%B2%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%B8%E0%A6%B9-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A7%AA</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823492/%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A6%B2%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%B8%E0%A6%B9-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A7%AA</guid>
      <pubDate>Sun, 29 Nov 2026 00:04:10 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/29/88629b542ca73e8d0c883bd1e791aef4-6b0b1709d3a59.jpg?jadewits_media_id=325390" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/29/88629b542ca73e8d0c883bd1e791aef4-6b0b1709d3a59.jpg?jadewits_media_id=325390" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/29/88629b542ca73e8d0c883bd1e791aef4-6b0b1709d3a59.jpg?jadewits_media_id=325390" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ছাত্রদলের মিছিলে ককটেল হামলা, নারীসহ আটক ৪" /&gt;&lt;/p&gt;&lt;p&gt;পাবনা শহরে কার্যক্রম নিষিদ্ধ আওয়ামী লীগের তৎপরতার প্রতিবাদে বের হওয়া ছাত্রদলের বিক্ষোভ মিছিলে ককটেল হামলার ঘটনা ঘটেছে। শনিবার (২৮ নভেম্বর) রাত পৌনে ৮টার দিকে শহরের আব্দুল হামিদ সড়কের মুক্তিযোদ্ধা মার্কেটের সামনে এ ঘটনা ঘটে। পরে মার্কেটের তৃতীয় তলা থেকে এক নারী ও তিন যুবককে আটক করেছে জেলা গোয়েন্দ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823492/%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A6%B2%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%B8%E0%A6%B9-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A7%AA">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>উদ্যোক্তা ঋণ না পেয়ে ফেসবুকে পদত্যাগের ঘোষণা ছাত্রদল নেতার</title>
      <link>https://www.ittefaq.com.bd/823490/%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BE-%E0%A6%8B%E0%A6%A3-%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A7%87%E0%A7%9F%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B8%E0%A6%AC%E0%A7%81%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%A6%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%98%E0%A7%8B%E0%A6%B7%E0%A6%A3%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823490/%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BE-%E0%A6%8B%E0%A6%A3-%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A7%87%E0%A7%9F%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B8%E0%A6%AC%E0%A7%81%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%A6%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%98%E0%A7%8B%E0%A6%B7%E0%A6%A3%E0%A6%BE</guid>
      <pubDate>Sat, 28 Nov 2026 23:47:53 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/ee6715b62b6b6803af940cb1c8b0482e-6b0b1377106f0.jpg?jadewits_media_id=325387" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/ee6715b62b6b6803af940cb1c8b0482e-6b0b1377106f0.jpg?jadewits_media_id=325387" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/ee6715b62b6b6803af940cb1c8b0482e-6b0b1377106f0.jpg?jadewits_media_id=325387" style="max-width:100%;height:auto;margin-bottom:10px;" alt="উদ্যোক্তা ঋণ না পেয়ে ফেসবুকে পদত্যাগের ঘোষণা ছাত্রদল নেতার" /&gt;&lt;/p&gt;&lt;p&gt;দলে মূল্যায়ন করা হচ্ছে না এবং সরকারি উদ্যোক্তা ঋণ থেকে বঞ্চিত করার অভিযোগ তুলে পদত্যাগের ঘোষণা দিয়েছেন ঝিনাইদহের কালীগঞ্জ উপজেলার রায়গ্রাম ইউনিয়ন ছাত্রদলের সাধারণ সম্পাদক শামীম হোসেন। শুক্রবার (২৭ নভেম্বর) দুপুর ১২টার দিকে নিজের ফেসবুক অ্যাকাউন্টে এক ভিডিও বার্তায় তিনি এই ঘোষণা দেন।
ভিডিও বার্ত&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823490/%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BE-%E0%A6%8B%E0%A6%A3-%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A7%87%E0%A7%9F%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B8%E0%A6%AC%E0%A7%81%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%A6%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%98%E0%A7%8B%E0%A6%B7%E0%A6%A3%E0%A6%BE">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>এক ব্যক্তির ধাওয়া খেয়ে পালালেন নিষিদ্ধ ছাত্রলীগের ২৫-৩০ নেতাকর্মী</title>
      <link>https://www.ittefaq.com.bd/823489/%E0%A6%8F%E0%A6%95-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%A7%E0%A6%BE%E0%A6%93%E0%A6%AF%E0%A6%BC%E0%A6%BE-%E0%A6%96%E0%A7%87%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823489/%E0%A6%8F%E0%A6%95-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%A7%E0%A6%BE%E0%A6%93%E0%A6%AF%E0%A6%BC%E0%A6%BE-%E0%A6%96%E0%A7%87%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7</guid>
      <pubDate>Sat, 28 Nov 2026 23:41:40 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/62d04e431f28efa43104694329a0c491-6b0b122462230.jpg?jadewits_media_id=325386" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/62d04e431f28efa43104694329a0c491-6b0b122462230.jpg?jadewits_media_id=325386" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/62d04e431f28efa43104694329a0c491-6b0b122462230.jpg?jadewits_media_id=325386" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এক ব্যক্তির ধাওয়া খেয়ে পালালেন নিষিদ্ধ ছাত্রলীগের ২৫-৩০ নেতাকর্মী" /&gt;&lt;/p&gt;&lt;p&gt;ফেনী শহরের গোডাউন কোয়ার্টার এলাকায় ঝটিকা মিছিল করে ফেরার পথে এক নিরাপত্তা প্রহরীর ধাওয়া খেয়ে দিগ্বিদিগ ছুটে পালিয়েছেন নিষিদ্ধ ঘোষিত ছাত্রলীগের ২৫ থেকে ৩০ জন তরুণ-যুবক। গত বৃহস্পতিবার (২৬ নভেম্বর) ভোরে ঘটনাটি ঘটলেও শুক্রবার রাতে এক ব্যক্তির ইট-পাথর ছুড়ে তাঁদের ধাওয়া দেওয়ার একটি ভিডিও সামাজিক &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823489/%E0%A6%8F%E0%A6%95-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%A7%E0%A6%BE%E0%A6%93%E0%A6%AF%E0%A6%BC%E0%A6%BE-%E0%A6%96%E0%A7%87%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>শিক্ষার্থীদের বিক্ষোভে উত্তাল আলবেনিয়া, পুলিশের সঙ্গে সংঘর্ষ</title>
      <link>https://www.ittefaq.com.bd/823488/%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8B%E0%A6%AD%E0%A7%87-%E0%A6%89%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B2-%E0%A6%86%E0%A6%B2%E0%A6%AC%E0%A7%87%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%BE-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823488/%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8B%E0%A6%AD%E0%A7%87-%E0%A6%89%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B2-%E0%A6%86%E0%A6%B2%E0%A6%AC%E0%A7%87%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%BE-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Sat, 28 Nov 2026 23:20:49 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/994f27fc23d4c3b26771f111f70a6d73-6b0b0cd918492.jpg?jadewits_media_id=325385" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/994f27fc23d4c3b26771f111f70a6d73-6b0b0cd918492.jpg?jadewits_media_id=325385" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/994f27fc23d4c3b26771f111f70a6d73-6b0b0cd918492.jpg?jadewits_media_id=325385" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শিক্ষার্থীদের বিক্ষোভে উত্তাল আলবেনিয়া, পুলিশের সঙ্গে সংঘর্ষ" /&gt;&lt;/p&gt;&lt;p&gt;ইউরোপীয় ইউনিয়নের (ইইউ) সদস্যপদপ্রত্যাশী বলকান অঞ্চলের দেশ আলবেনিয়ায় সরকারবিরোধী বিক্ষোভ ঘিরে ব্যাপক সংঘর্ষ ছড়িয়ে পড়েছে। প্রধানমন্ত্রী এদি রামার পদত্যাগের দাবিতে শনিবার (২৮ নভেম্বর) দেশটির স্বাধীনতা দিবসের অনুষ্ঠানের মধ্যেই রাজধানী তিরানায় হাজারো মানুষ রাজপথে নেমে আসেন এবং প্রধানমন্ত্রীর কার্&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823488/%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8B%E0%A6%AD%E0%A7%87-%E0%A6%89%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B2-%E0%A6%86%E0%A6%B2%E0%A6%AC%E0%A7%87%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%BE-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>মুশফিক তরুণ ক্রিকেটারদের জন্য আদর্শ: তামিম ইকবাল</title>
      <link>https://www.ittefaq.com.bd/823487/%E0%A6%AE%E0%A7%81%E0%A6%B6%E0%A6%AB%E0%A6%BF%E0%A6%95-%E0%A6%A4%E0%A6%B0%E0%A7%81%E0%A6%A3-%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%86%E0%A6%A6%E0%A6%B0%E0%A7%8D%E0%A6%B6-%E0%A6%A4%E0%A6%BE%E0%A6%AE%E0%A6%BF%E0%A6%AE-%E0%A6%87%E0%A6%95%E0%A6%AC%E0%A6%BE%E0%A6%B2</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823487/%E0%A6%AE%E0%A7%81%E0%A6%B6%E0%A6%AB%E0%A6%BF%E0%A6%95-%E0%A6%A4%E0%A6%B0%E0%A7%81%E0%A6%A3-%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%86%E0%A6%A6%E0%A6%B0%E0%A7%8D%E0%A6%B6-%E0%A6%A4%E0%A6%BE%E0%A6%AE%E0%A6%BF%E0%A6%AE-%E0%A6%87%E0%A6%95%E0%A6%AC%E0%A6%BE%E0%A6%B2</guid>
      <pubDate>Sat, 28 Nov 2026 23:08:39 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/d1e52d55796ee958e47df0e62e0b6bce-6b0b0a882ae61.jpg?jadewits_media_id=325384" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/d1e52d55796ee958e47df0e62e0b6bce-6b0b0a882ae61.jpg?jadewits_media_id=325384" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/d1e52d55796ee958e47df0e62e0b6bce-6b0b0a882ae61.jpg?jadewits_media_id=325384" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মুশফিক তরুণ ক্রিকেটারদের জন্য আদর্শ: তামিম ইকবাল" /&gt;&lt;/p&gt;&lt;p&gt;অভিজ্ঞ উইকেটকিপার-ব্যাটার মুশফিকুর রহিমের আন্তর্জাতিক ক্রিকেট থেকে অবসরের ঘোষণা দিতে গিয়ে বাংলাদেশ ক্রিকেট বোর্ডের (বিসিবি) সভাপতি তামিম ইকবাল বলেছেন, কাজের প্রতি নিষ্ঠার কারণে মুশফিক তরুণ ক্রিকেটারদের জন্য একজন আদর্শ।
২০০৫ সালের মে মাসে লর্ডসে ইংল্যান্ডের বিপক্ষে টেস্ট অভিষেক হয়েছিল মুশফিকের। আগামী&lt;/p&gt;</description>

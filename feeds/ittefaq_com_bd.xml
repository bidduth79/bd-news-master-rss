      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/45bfd9daa9a0adb6cbe17865a595e481-6b08890d9386d.jpg?jadewits_media_id=325081" style="max-width:100%;height:auto;margin-bottom:10px;" alt="খুলনা-ঢাকা রুটের ‘জাহানাবাদ বিকল্প এক্সপ্রেস’ চলবে বিকল্প পথে" /&gt;&lt;/p&gt;&lt;p&gt;নিরাপত্তার স্বার্থে খুলনা-ঢাকা রুটের জাহানাবাদ এক্সপ্রেস এবং ঢাকা-বেনাপোল রুটের রূপসী বাংলা এক্সপ্রেসের চলাচল সাময়িকভাবে স্থগিত করেছে বাংলাদেশ রেলওয়ে। এর পরিবর্তে আগামী শনিবার (২৮ নভেম্বর) থেকে খুলনা-পোড়াদহ-রাজবাড়ী-ঢাকা রুটে চালু হচ্ছে নতুন ট্রেন &amp;lsquo;জাহানাবাদ বিকল্প এক্সপ্রেস&amp;rsquo;, যা পরবর&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823193/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%B0%E0%A7%81%E0%A6%9F%E0%A7%87%E0%A6%B0-%E2%80%98%E0%A6%9C%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%A6-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA-%E0%A6%8F%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B8%E2%80%99-%E0%A6%9A%E0%A6%B2%E0%A6%AC%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>গোপালগঞ্জে প্রায় ২ লাখ বিকাশ ও নগদ অ্যাকাউন্ট বন্ধ, ভোগান্তিতে গ্রাহক</title>
      <link>https://www.ittefaq.com.bd/823190/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A7%9F%C2%A0%E0%A7%A8-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B6-%E0%A6%93%C2%A0%E0%A6%A8%E0%A6%97%E0%A6%A6-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%9F</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823190/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A7%9F%C2%A0%E0%A7%A8-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B6-%E0%A6%93%C2%A0%E0%A6%A8%E0%A6%97%E0%A6%A6-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%9F</guid>
      <pubDate>Fri, 27 Nov 2026 01:00:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/bbead720a0a3af8bdc68dd8e7b3d975d-6b087d49383e0.jpg?jadewits_media_id=325078" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/bbead720a0a3af8bdc68dd8e7b3d975d-6b087d49383e0.jpg?jadewits_media_id=325078" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/bbead720a0a3af8bdc68dd8e7b3d975d-6b087d49383e0.jpg?jadewits_media_id=325078" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গোপালগঞ্জে প্রায় ২ লাখ বিকাশ ও নগদ অ্যাকাউন্ট বন্ধ, ভোগান্তিতে গ্রাহক" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জে মোবাইল ব্যাংকিং (এমএফএস) সেবা বন্ধের অভিযোগ উঠেছে। এতে চরম ভোগান্তিতে পড়েছেন সাধারণ গ্রাহকরা। গত বুধবার রাত থেকে মেসেজ দিয়ে বিভিন্ন কোম্পানির মোবাইল ব্যাংকিং অ্যাকাউন্ট বন্ধ করা শুরু হয়। সেই ধারা গতকাল বৃহস্পতিবারও অব্যাহত ছিল। মেসেজে লেখা রয়েছে, &amp;lsquo;স্যার/ম্যাডাম এমএফএস বিধিমালা আনুযা&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823190/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A7%9F%C2%A0%E0%A7%A8-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B6-%E0%A6%93%C2%A0%E0%A6%A8%E0%A6%97%E0%A6%A6-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%9F">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>ভারতকে পাত্তাই দিল না শ্রীলঙ্কা, দাপুটে জয়ে ফাইনালে</title>
      <link>https://www.ittefaq.com.bd/823192/%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%87-%E0%A6%A6%E0%A6%BF%E0%A6%B2-%E0%A6%A8%E0%A6%BE-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B2%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BE-%E0%A6%A6%E0%A6%BE%E0%A6%AA%E0%A7%81%E0%A6%9F%E0%A7%87-%E0%A6%9C%E0%A7%9F%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823192/%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%87-%E0%A6%A6%E0%A6%BF%E0%A6%B2-%E0%A6%A8%E0%A6%BE-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B2%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BE-%E0%A6%A6%E0%A6%BE%E0%A6%AA%E0%A7%81%E0%A6%9F%E0%A7%87-%E0%A6%9C%E0%A7%9F%E0%A7%87</guid>
      <pubDate>Fri, 27 Nov 2026 00:59:30 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/ad2d23635c439c35e153a1bc203686f4-6b08811fdf964.jpg?jadewits_media_id=325080" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/ad2d23635c439c35e153a1bc203686f4-6b08811fdf964.jpg?jadewits_media_id=325080" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/ad2d23635c439c35e153a1bc203686f4-6b08811fdf964.jpg?jadewits_media_id=325080" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভারতকে পাত্তাই দিল না শ্রীলঙ্কা, দাপুটে জয়ে ফাইনালে" /&gt;&lt;/p&gt;&lt;p&gt;শ্রীলঙ্কা &amp;lsquo;এ&amp;rsquo; দলের দুই ওপেনারের ব্যাটিং তাণ্ডবে রাইজিং স্টারস এশিয়া কাপ থেকে বিদায় নিল ভারত। সেমিফাইনালে ভারতীয় বোলারদের রীতিমতো পাত্তাই দেননি লঙ্কান ব্যাটাররা। ফলে ৮ উইকেটের বড় ব্যবধানে হেরে টুর্নামেন্ট শেষ করতে হলো ভারতকে।
বৃহস্পতিবার (২৬ নভেম্বর) সংযুক্ত আরব আমিরাতের দোহায় প্রথমে ব্যা&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823192/%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%87-%E0%A6%A6%E0%A6%BF%E0%A6%B2-%E0%A6%A8%E0%A6%BE-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B2%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BE-%E0%A6%A6%E0%A6%BE%E0%A6%AA%E0%A7%81%E0%A6%9F%E0%A7%87-%E0%A6%9C%E0%A7%9F%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>দুই পরমাণু সাইটের মাঝে দ্রুতগতিতে ভূগর্ভস্থ স্থাপনা তৈরি করছে ইরান</title>
      <link>https://www.ittefaq.com.bd/823189/%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%AA%E0%A6%B0%E0%A6%AE%E0%A6%BE%E0%A6%A3%E0%A7%81-%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%9D%E0%A7%87-%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%A4%E0%A6%97%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AD%E0%A7%82%E0%A6%97%E0%A6%B0%E0%A7%8D%E0%A6%AD%E0%A6%B8%E0%A7%8D%E0%A6%A5</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823189/%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%AA%E0%A6%B0%E0%A6%AE%E0%A6%BE%E0%A6%A3%E0%A7%81-%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%9D%E0%A7%87-%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%A4%E0%A6%97%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AD%E0%A7%82%E0%A6%97%E0%A6%B0%E0%A7%8D%E0%A6%AD%E0%A6%B8%E0%A7%8D%E0%A6%A5</guid>
      <pubDate>Fri, 27 Nov 2026 00:32:47 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/368787dd161ad1256f3f6a527496b6c5-6b087b311db90.jpg?jadewits_media_id=325077" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/368787dd161ad1256f3f6a527496b6c5-6b087b311db90.jpg?jadewits_media_id=325077" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/368787dd161ad1256f3f6a527496b6c5-6b087b311db90.jpg?jadewits_media_id=325077" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দুই পরমাণু সাইটের মাঝে দ্রুতগতিতে ভূগর্ভস্থ স্থাপনা তৈরি করছে ইরান" /&gt;&lt;/p&gt;&lt;p&gt;নিজেদের দুটি প্রধান পরমাণু সাইটের মধ্যবর্তী স্থানে দ্রুতগতিতে একটি ভূগর্ভস্থ স্থাপনা তৈরি করছে ইরান।
বৃহস্পতিবার (২৬ নভেম্বর) যুক্তরাষ্ট্রভিত্তিক পর্যবেক্ষক সংস্থা আইএসআইএস এ তথ্য জানিয়েছে।
ভেন্টর টেকনোলজির স্যাটেলাইট ছবি বিশ্লেষণ করে আইএসআইএস বলেছে ইরান পিকঅ্যাক্স পাহাড় এবং ইস্ফাহান পারমাণবিক সাইটে&lt;/p&gt;</description>

      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/0896b68c7801262dbee30506377dac1f-6af81b3ac5c2b.jpg?jadewits_media_id=322716" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/0896b68c7801262dbee30506377dac1f-6af81b3ac5c2b.jpg?jadewits_media_id=322716" medium="image" />

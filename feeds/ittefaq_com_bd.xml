      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/0bef7f85251df569338fe1480434399d-6af71ad1089b1.jpg?jadewits_media_id=322603" length="0" type="image/jpeg" />

      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/4e19af0d985736d56419086b1d83b264-6af719fa6f57d.jpg?jadewits_media_id=322602" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/4e19af0d985736d56419086b1d83b264-6af719fa6f57d.jpg?jadewits_media_id=322602" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/4e19af0d985736d56419086b1d83b264-6af719fa6f57d.jpg?jadewits_media_id=322602" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আবদুল গনি চৌধুরী (ক:) মাইজভাণ্ডারীর ৯২তম ওরশ শনিবার" /&gt;&lt;/p&gt;&lt;p&gt;মোজাদ্দেদে জামান হযরত মাওলানা শাহসূফি সৈয়দ আবদুল গনি চৌধুরী মাইজভাণ্ডারীর (ক.) ৯২তম পবিত্র বার্ষিক ওরশ শরিফ আগামী শনিবার (১৪ নভেম্বর) চট্টগ্রামের ফটিকছড়ির গনি মঞ্জিলে অনুষ্ঠিত হবে।
ওরশ শরিফ উপলক্ষে দিনব্যাপী বিভিন্ন ধর্মীয় ও আধ্যাত্মিক কর্মসূচির আয়োজন করা হয়েছে।
কর্মসূচির মধ্যে রয়েছে খতমে কোরআন, সেম&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820805/%E0%A6%86%E0%A6%AC%E0%A6%A6%E0%A7%81%E0%A6%B2-%E0%A6%97%E0%A6%A8%E0%A6%BF-%E0%A6%9A%E0%A7%8C%E0%A6%A7%E0%A7%81%E0%A6%B0%E0%A7%80-%E0%A6%95-%E0%A6%AE%E0%A6%BE%E0%A6%87%E0%A6%9C%E0%A6%AD%E0%A6%BE%E0%A6%A3%E0%A7%8D%E0%A6%A1%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A7%AF%E0%A7%A8%E0%A6%A4%E0%A6%AE-%E0%A6%93%E0%A6%B0%E0%A6%B6">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>১৯৪৫ সালের নীতিতে আজকের বিশ্ব চলতে পারে না: ড. খলিলুর রহমান</title>
      <link>https://www.ittefaq.com.bd/820804/%E0%A7%A7%E0%A7%AF%E0%A7%AA%E0%A7%AB-%E0%A6%B8%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%9C%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC-%E0%A6%9A%E0%A6%B2%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%A8%E0%A6%BE-%E0%A6%A1</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820804/%E0%A7%A7%E0%A7%AF%E0%A7%AA%E0%A7%AB-%E0%A6%B8%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%9C%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC-%E0%A6%9A%E0%A6%B2%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%A8%E0%A6%BE-%E0%A6%A1</guid>
      <pubDate>Fri, 13 Nov 2026 20:09:51 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/6a34dd334539c14fc4bd49a424dfa469-6af718458679c.jpg?jadewits_media_id=322600" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/6a34dd334539c14fc4bd49a424dfa469-6af718458679c.jpg?jadewits_media_id=322600" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/6a34dd334539c14fc4bd49a424dfa469-6af718458679c.jpg?jadewits_media_id=322600" style="max-width:100%;height:auto;margin-bottom:10px;" alt="১৯৪৫ সালের নীতিতে আজকের বিশ্ব চলতে পারে না: ড. খলিলুর রহমান" /&gt;&lt;/p&gt;&lt;p&gt;১৯৪৫ সালের দ্বিতীয় বিশ্বযুদ্ধোত্তর বাস্তবতায় গড়ে ওঠা জাতিসংঘের বর্তমান কাঠামো দিয়ে আজকের পরিবর্তিত বিশ্ব পরিচালনা সম্ভব নয় বলে মন্তব্য করেছেন জাতিসংঘ সাধারণ পরিষদের ৮০তম অধিবেশনের সভাপতি ড. খলিলুর রহমান। তিনি বলেছেন, বৈশ্বিক ক্ষমতার ভারসাম্যে ব্যাপক পরিবর্তন এলেও নিরাপত্তা পরিষদের কাঠামো এখনো আগের ম&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820804/%E0%A7%A7%E0%A7%AF%E0%A7%AA%E0%A7%AB-%E0%A6%B8%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%9C%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC-%E0%A6%9A%E0%A6%B2%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%A8%E0%A6%BE-%E0%A6%A1">দৈনিক ইত্তেফাক</source>

      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/2a42599dd9f684669166a6e1a74a3887-6b047e09d87de.jpg?jadewits_media_id=324528" length="0" type="image/jpeg" />

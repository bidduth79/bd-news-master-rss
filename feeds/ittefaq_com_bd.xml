      <guid isPermaLink="true">https://www.ittefaq.com.bd/823020/%E0%A6%AC%E0%A7%8B%E0%A7%9F%E0%A6%BF%E0%A6%82%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%9B-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A7%AB%E0%A7%A6%E0%A6%9F%E0%A6%BF-%E0%A6%89%E0%A7%9C%E0%A7%8B%E0%A6%9C%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%9C-%E0%A6%95%E0%A6%BF%E0%A6%A8%E0%A6%9B%E0%A7%87-%E0%A6%9A%E0%A7%80%E0%A6%A8%E0%A6%BE</guid>
      <pubDate>Wed, 25 Nov 2026 23:43:48 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/5e59ee4c8d48402102af4592e5f797b1-6b071e453b3d9.jpg?jadewits_media_id=324896" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/5e59ee4c8d48402102af4592e5f797b1-6b071e453b3d9.jpg?jadewits_media_id=324896" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/5e59ee4c8d48402102af4592e5f797b1-6b071e453b3d9.jpg?jadewits_media_id=324896" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বোয়িংয়ের কাছ থেকে ৫০টি উড়োজাহাজ কিনছে চীনা এয়ারলাইন্স" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাষ্ট্রের উড়োজাহাজ নির্মাতা প্রতিষ্ঠান বোয়িংয়ের কাছ থেকে ৫০টি ৭৩৭-৮ মডেলের উড়োজাহাজ কেনার চুক্তি করেছে চীনের সিয়ামেন এয়ারলাইন্স। প্রতিষ্ঠানটি চায়না সাউদার্ন এয়ারলাইন্সের সহযোগী সংস্থা। মঙ্গলবার চায়না সাউদার্ন এয়ারলাইন্স এ তথ্য জানিয়েছে।&amp;nbsp;খবর বার্তা সংস্থা এএফপি&amp;rsquo;র।
চীনা প্রতিষ্ঠানটি চু&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823020/%E0%A6%AC%E0%A7%8B%E0%A7%9F%E0%A6%BF%E0%A6%82%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%9B-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A7%AB%E0%A7%A6%E0%A6%9F%E0%A6%BF-%E0%A6%89%E0%A7%9C%E0%A7%8B%E0%A6%9C%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%9C-%E0%A6%95%E0%A6%BF%E0%A6%A8%E0%A6%9B%E0%A7%87-%E0%A6%9A%E0%A7%80%E0%A6%A8%E0%A6%BE">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>‘সোনার বার’ ৪১টি, পরীক্ষার পর দেখা গেল লোহা</title>
      <link>https://www.ittefaq.com.bd/823019/%E2%80%98%E0%A6%B8%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B0%E2%80%99-%E0%A7%AA%E0%A7%A7%E0%A6%9F%E0%A6%BF-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BE-%E0%A6%97%E0%A7%87%E0%A6%B2-%E0%A6%B2%E0%A7%8B%E0%A6%B9%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823019/%E2%80%98%E0%A6%B8%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B0%E2%80%99-%E0%A7%AA%E0%A7%A7%E0%A6%9F%E0%A6%BF-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BE-%E0%A6%97%E0%A7%87%E0%A6%B2-%E0%A6%B2%E0%A7%8B%E0%A6%B9%E0%A6%BE</guid>
      <pubDate>Wed, 25 Nov 2026 23:41:37 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/81abd4e06f64bbe7556020d416dc31b2-6b071d73dc0ab.jpg?jadewits_media_id=324895" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/81abd4e06f64bbe7556020d416dc31b2-6b071d73dc0ab.jpg?jadewits_media_id=324895" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/81abd4e06f64bbe7556020d416dc31b2-6b071d73dc0ab.jpg?jadewits_media_id=324895" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘সোনার বার’ ৪১টি, পরীক্ষার পর দেখা গেল লোহা" /&gt;&lt;/p&gt;&lt;p&gt;লোহার বারের ওপর সোনালি রঙের প্রলেপ দিয়ে প্রকৃত &amp;lsquo;সোনার বার&amp;rsquo; হিসেবে বিক্রির চেষ্টাকালে রাজশাহীতে দুজনকে গ্রেপ্তার করেছে পুলিশ। এ সময় তাদের কাছ থেকে প্রায় চার কেজি ওজনের ৪১টি নকল সোনার বার উদ্ধার করা হয়, যা পরীক্ষার পর ভেতরে লোহা থাকার বিষয়টি নিশ্চিত হওয়া গেছে।
মঙ্গলবার (২৪ নভেম্বর) র&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823019/%E2%80%98%E0%A6%B8%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B0%E2%80%99-%E0%A7%AA%E0%A7%A7%E0%A6%9F%E0%A6%BF-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BE-%E0%A6%97%E0%A7%87%E0%A6%B2-%E0%A6%B2%E0%A7%8B%E0%A6%B9%E0%A6%BE">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>কার্যক্রম নিষিদ্ধ আওয়ামী লীগ নেতাদের সঙ্গে যোগাযোগের অভিযোগে বিএনপি নেতা বহিষ্কার</title>
      <link>https://www.ittefaq.com.bd/823018/%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823018/%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87</guid>
      <pubDate>Wed, 25 Nov 2026 23:37:37 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/431f996dd872d285add77657a1c7a389-6b0719b1c3f4f.jpg?jadewits_media_id=324894" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/431f996dd872d285add77657a1c7a389-6b0719b1c3f4f.jpg?jadewits_media_id=324894" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/431f996dd872d285add77657a1c7a389-6b0719b1c3f4f.jpg?jadewits_media_id=324894" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কার্যক্রম নিষিদ্ধ আওয়ামী লীগ নেতাদের সঙ্গে যোগাযোগের অভিযোগে বিএনপি নেতা বহিষ্কার" /&gt;&lt;/p&gt;&lt;p&gt;বগুড়ায় দলীয় সিদ্ধান্ত অমান্য করে কার্যক্রম নিষিদ্ধ আওয়ামী লীগ নেতাদের সঙ্গে যোগাযোগ রাখায় জেলা বিএনপির শিল্প ও বাণিজ্য বিষয়ক সম্পাদক মিজানুর রহমান মিজানকে বহিষ্কার করা হয়েছে। বুধবার (২৫ নভেম্বর) বিএনপির কেন্দ্রীয় কমিটির সহদপ্তর সম্পাদক মুহাম্মদ মুনির হোসেন স্বাক্ষরিত এক প্রেস বিজ্ঞপ্তিতে এ তথ্য জান&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823018/%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>অন্যের পরিচয়ে ৩৮ বছর চাকরি: অবসরপ্রাপ্ত বিজিবি সদস্যকে ১৩ বছরের কারাদণ্ড</title>
      <link>https://www.ittefaq.com.bd/823015/%E0%A6%85%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%9A%E0%A7%9F%E0%A7%87-%E0%A7%A9%E0%A7%AE-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%9A%E0%A6%BE%E0%A6%95%E0%A6%B0%E0%A6%BF-%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A6%B0%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%A4-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%AC%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823015/%E0%A6%85%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%9A%E0%A7%9F%E0%A7%87-%E0%A7%A9%E0%A7%AE-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%9A%E0%A6%BE%E0%A6%95%E0%A6%B0%E0%A6%BF-%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A6%B0%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%A4-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%AC%E0%A6%BF</guid>
      <pubDate>Wed, 25 Nov 2026 22:59:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/410b08916647c3a5fe20b5774d9c1675-6b070fd3856e4.jpg?jadewits_media_id=324890" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/410b08916647c3a5fe20b5774d9c1675-6b070fd3856e4.jpg?jadewits_media_id=324890" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/410b08916647c3a5fe20b5774d9c1675-6b070fd3856e4.jpg?jadewits_media_id=324890" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অন্যের পরিচয়ে ৩৮ বছর চাকরি: অবসরপ্রাপ্ত বিজিবি সদস্যকে ১৩ বছরের কারাদণ্ড" /&gt;&lt;/p&gt;&lt;p&gt;ভুয়া পরিচয় ব্যবহার করে তৎকালীন বিডিআর (বর্তমান বিজিবি)-এ প্রায় ৩৮ বছর চাকরি ও সরকারি বেতন-ভাতা আত্মসাতের মামলায় অবসরপ্রাপ্ত এক সদস্যকে ১৩ বছরের সশ্রম কারাদণ্ড দিয়েছেন ঢাকার একটি আদালত। একই সঙ্গে চাকরিকালে উত্তোলিত সমুদয় বেতন-ভাতা সুদসহ সরকারি কোষাগারে ফেরত দিতে তার স্থাবর ও অস্থাবর সম্পত্তি রাষ্ট্রে&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823015/%E0%A6%85%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%9A%E0%A7%9F%E0%A7%87-%E0%A7%A9%E0%A7%AE-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%9A%E0%A6%BE%E0%A6%95%E0%A6%B0%E0%A6%BF-%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A6%B0%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%A4-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%AC%E0%A6%BF">দৈনিক ইত্তেফাক</source>
    </item>

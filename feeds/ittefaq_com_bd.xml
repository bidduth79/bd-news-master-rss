    <item>
      <title>শ্রীলঙ্কার জালে ৪ গোলের ‘বাংলা ঝাল’, সেমিফাইনালে বাংলাদেশ</title>
      <link>https://www.ittefaq.com.bd/820443/%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B2%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A7%AA-%E0%A6%97%E0%A7%8B%E0%A6%B2%E0%A7%87%E0%A6%B0-%E2%80%98%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE-%E0%A6%9D%E0%A6%BE%E0%A6%B2%E2%80%99-%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A6%BF%E0%A6%AB%E0%A6%BE%E0%A6%87%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820443/%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B2%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A7%AA-%E0%A6%97%E0%A7%8B%E0%A6%B2%E0%A7%87%E0%A6%B0-%E2%80%98%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE-%E0%A6%9D%E0%A6%BE%E0%A6%B2%E2%80%99-%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A6%BF%E0%A6%AB%E0%A6%BE%E0%A6%87%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A7%87</guid>
      <pubDate>Wed, 11 Nov 2026 22:36:25 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/9a00ce809cb56b6f09fd05f97be2d3d8-6af495780df6a.jpg?jadewits_media_id=322231" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/9a00ce809cb56b6f09fd05f97be2d3d8-6af495780df6a.jpg?jadewits_media_id=322231" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/9a00ce809cb56b6f09fd05f97be2d3d8-6af495780df6a.jpg?jadewits_media_id=322231" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শ্রীলঙ্কার জালে ৪ গোলের ‘বাংলা ঝাল’, সেমিফাইনালে বাংলাদেশ" /&gt;&lt;/p&gt;&lt;p&gt;অধিনায়ক হিসেবে অভিষেকেই গোল ও সতীর্থের গোলের পেছনে অবদান রেখে আলোচনায় হামজা চৌধুরী। তার নেতৃত্বে শ্রীলঙ্কার বিপক্ষে দাপুটে জয় পেয়েছে বাংলাদেশ। শমিত সোম, হামজা, ফারহান আলী ওয়াহিদ ও রাকিব হোসেনের গোলে ৪-০ ব্যবধানে জিতেছে স্বাগতিকরা। চার ফুটবলারের গোলে একপেশে হয়ে ওঠা ম্যাচে শুরু থেকে শেষ পর্যন্ত আধিপত্&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820443/%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B2%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A7%AA-%E0%A6%97%E0%A7%8B%E0%A6%B2%E0%A7%87%E0%A6%B0-%E2%80%98%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE-%E0%A6%9D%E0%A6%BE%E0%A6%B2%E2%80%99-%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A6%BF%E0%A6%AB%E0%A6%BE%E0%A6%87%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>নতুন পে স্কেল বাস্তবায়নে ভাতা নিয়ে অর্থ মন্ত্রণালয়ের নতুন নির্দেশনা</title>

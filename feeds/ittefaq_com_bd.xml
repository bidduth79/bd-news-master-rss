      <guid isPermaLink="true">https://www.ittefaq.com.bd/821288/%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%A8%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE-%E0%A6%89%E0%A6%AA%E0%A6%95%E0%A7%82%E0%A6%B2%E0%A7%87-%E0%A7%AB%E0%A7%A6-%E0%A6%AB%E0%A7%81%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%BF-%E0%A6%89%E0%A6%81%E0%A6%9A%E0%A7%81-%E0%A6%A2%E0%A7%87%E0%A6%89</guid>

      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/192e18bf2aad71db9ef51a7ca502a8e6-6b00197f5d015.jpg?jadewits_media_id=323891" length="0" type="image/jpeg" />

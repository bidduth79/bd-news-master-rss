      <title>পাকিস্তানের সঙ্গে যুদ্ধের পর ভারতের ৪ রাফায়েল উধাও!</title>
      <link>https://www.ittefaq.com.bd/822137/%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A7%AA-%E0%A6%B0%E0%A6%BE%E0%A6%AB%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B2</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822137/%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A7%AA-%E0%A6%B0%E0%A6%BE%E0%A6%AB%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B2</guid>
      <pubDate>Sat, 21 Nov 2026 01:29:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/12b10fb9ca900c142b9f60913a095f3f-6b009a0228e9c.jpg?jadewits_media_id=323975" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/12b10fb9ca900c142b9f60913a095f3f-6b009a0228e9c.jpg?jadewits_media_id=323975" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/12b10fb9ca900c142b9f60913a095f3f-6b009a0228e9c.jpg?jadewits_media_id=323975" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পাকিস্তানের সঙ্গে যুদ্ধের পর ভারতের ৪ রাফায়েল উধাও!" /&gt;&lt;/p&gt;&lt;p&gt;ব্রিটিশ সামরিক বিমানবিষয়ক প্রকাশনা &amp;lsquo;ফ্লাইটগ্লোবাল&amp;rsquo;-এর সর্বশেষ প্রতিবেদনে ভারতের বিমানবাহিনীর সক্রিয় বহরে ৩৬টির পরিবর্তে ৩২টি রাফায়েল যুদ্ধবিমান থাকার তথ্য উঠে আসায় নতুন করে বিতর্কের সৃষ্টি হয়েছে।
পাকিস্তানের সঙ্গে সামরিক সংঘাতের পর ভারতের চারটি রাফায়েল যুদ্ধবিমানের হদিস পাওয়া যাচ্ছে ন&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822137/%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A7%AA-%E0%A6%B0%E0%A6%BE%E0%A6%AB%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B2">দৈনিক ইত্তেফাক</source>
    </item>

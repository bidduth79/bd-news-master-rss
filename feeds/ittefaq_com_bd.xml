    <item>
      <title>খুলনায় যৌথবাহিনীর অভিযানের মধ্যে গুলিতে ব্যবসায়ীসহ আহত ২</title>
      <link>https://www.ittefaq.com.bd/821584/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AF%E0%A7%8C%E0%A6%A5%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A6%BE%E0%A7%9F%E0%A7%80%E0%A6%B8%E0%A6%B9</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821584/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AF%E0%A7%8C%E0%A6%A5%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A6%BE%E0%A7%9F%E0%A7%80%E0%A6%B8%E0%A6%B9</guid>
      <pubDate>Tue, 17 Nov 2026 23:42:24 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/363f7cfeeff38e72f436ba644212e01a-6afc91fbd4159.jpg?jadewits_media_id=323410" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/363f7cfeeff38e72f436ba644212e01a-6afc91fbd4159.jpg?jadewits_media_id=323410" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/363f7cfeeff38e72f436ba644212e01a-6afc91fbd4159.jpg?jadewits_media_id=323410" style="max-width:100%;height:auto;margin-bottom:10px;" alt="খুলনায় যৌথবাহিনীর অভিযানের মধ্যে গুলিতে ব্যবসায়ীসহ আহত ২" /&gt;&lt;/p&gt;&lt;p&gt;খুলনায় যৌথবাহিনীর অভিযান চলার মধ্যেই দুর্বৃত্তদের গুলিতে এক ঘের ব্যবসায়ীসহ দুজন আহত হয়েছেন।
মঙ্গলবার (১৭ নভেম্বর) রাত সাড়ে ৯টার দিকে নগরীর আড়ংঘাটা থানার বুড়ির ভিটা এলাকায় এ ঘটনা ঘটে। আহত ব্যক্তিরা হলেন ঘের ব্যবসায়ী সোলাইমান ফকির ওরফে সোলাই (৫৪) এবং খালেক নামের এক ভ্যানচালক। সোলাইমান ওই এলাকার নবী ফক&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821584/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AF%E0%A7%8C%E0%A6%A5%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A6%BE%E0%A7%9F%E0%A7%80%E0%A6%B8%E0%A6%B9">দৈনিক ইত্তেফাক</source>

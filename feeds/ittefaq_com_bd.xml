      <guid isPermaLink="true">https://www.ittefaq.com.bd/820106/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A7%87%E0%A6%B0%E0%A7%87-%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%B6%E0%A6%82%E0%A6%B8%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8</guid>
      <pubDate>Tue, 10 Nov 2026 13:06:52 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/e4bf825c09cea669149074fc54a2f41c-6af2c239a9c0b.jpg?jadewits_media_id=321890" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/e4bf825c09cea669149074fc54a2f41c-6af2c239a9c0b.jpg?jadewits_media_id=321890" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/e4bf825c09cea669149074fc54a2f41c-6af2c239a9c0b.jpg?jadewits_media_id=321890" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইরান যুদ্ধের জেরে এবার অভিশংসনের মুখে মার্কিন প্রতিরক্ষামন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;ইরানে অনিয়মতান্ত্রিক হামলা ও অবৈধ আদেশ কার্যকরসহ মার্কিন আইন লঙ্ঘনের অভিযোগে প্রতিরক্ষামন্ত্রী পিট হেগসেথকে পদচ্যুত করতে প্রতিনিধি পরিষদে অভিশংসন প্রস্তাব উত্থাপন করেছেন রিপাবলিকান আইনপ্রণেতা থমাস ম্যাসি।
সোমবার (৯ নভেম্বর) আল জাজিরার এক প্রতিবেদনে এই খবর জানানো হয়েছে&amp;gt; এই সংবাদের সত্যতা প্রকাশ ক&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820106/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A7%87%E0%A6%B0%E0%A7%87-%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%B6%E0%A6%82%E0%A6%B8%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>ইসরায়েলের পার্লামেন্টে ৪৬ নতুন মুখ, ভাঙছে ৬৭ বছরের রেকর্ড</title>

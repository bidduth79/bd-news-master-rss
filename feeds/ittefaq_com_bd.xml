    <item>
      <title>বগুড়ায় নিখোঁজের এক মাস পর ধানখেতে মিলল বৃদ্ধের কঙ্কাল</title>
      <link>https://www.ittefaq.com.bd/821377/%E0%A6%AC%E0%A6%97%E0%A7%81%E0%A6%A1%E0%A6%BC%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%BF%E0%A6%96%E0%A7%8B%E0%A6%81%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%8F%E0%A6%95-%E0%A6%AE%E0%A6%BE%E0%A6%B8-%E0%A6%AA%E0%A6%B0-%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%96%E0%A7%87%E0%A6%A4%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2-%E0%A6%AC%E0%A7%83%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821377/%E0%A6%AC%E0%A6%97%E0%A7%81%E0%A6%A1%E0%A6%BC%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%BF%E0%A6%96%E0%A7%8B%E0%A6%81%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%8F%E0%A6%95-%E0%A6%AE%E0%A6%BE%E0%A6%B8-%E0%A6%AA%E0%A6%B0-%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%96%E0%A7%87%E0%A6%A4%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2-%E0%A6%AC%E0%A7%83%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Mon, 16 Nov 2026 21:47:28 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/0d7d429b809de1c1ad469193832e9ada-6afb2540bd495.jpg?jadewits_media_id=323192" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/0d7d429b809de1c1ad469193832e9ada-6afb2540bd495.jpg?jadewits_media_id=323192" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/0d7d429b809de1c1ad469193832e9ada-6afb2540bd495.jpg?jadewits_media_id=323192" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বগুড়ায় নিখোঁজের এক মাস পর ধানখেতে মিলল বৃদ্ধের কঙ্কাল" /&gt;&lt;/p&gt;&lt;p&gt;বগুড়ার সারিয়াকান্দিতে নিখোঁজের এক মাস পর কজিবর রহমান (৭০) নামে এক বৃদ্ধের কঙ্কাল উদ্ধার করেছে পুলিশ। সোমবার সকালে উপজেলার ফুলবাড়ী ইউনিয়নের মাজবাড়ী গ্রামের একটি ধানখেত থেকে কঙ্কালটি উদ্ধার করা হয়। পাশে পড়ে থাকা পোশাক দেখে সেটি কজিবর রহমানের বলে শনাক্ত করেছেন তার ছেলে।

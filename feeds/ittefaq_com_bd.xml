    <item>
      <title>পঞ্চগড়ে জেঁকে বসছে শীত, এক দিনের ব্যবধানে তাপমাত্রা নেমেছে ১২.৫ ডিগ্রিতে</title>
      <link>https://www.ittefaq.com.bd/821808/%E0%A6%AA%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%97%E0%A7%9C%E0%A7%87-%E0%A6%9C%E0%A7%87%E0%A6%81%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%B8%E0%A6%9B%E0%A7%87-%E0%A6%B6%E0%A7%80%E0%A6%A4-%E0%A6%8F%E0%A6%95-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821808/%E0%A6%AA%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%97%E0%A7%9C%E0%A7%87-%E0%A6%9C%E0%A7%87%E0%A6%81%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%B8%E0%A6%9B%E0%A7%87-%E0%A6%B6%E0%A7%80%E0%A6%A4-%E0%A6%8F%E0%A6%95-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%87</guid>
      <pubDate>Thu, 19 Nov 2026 08:23:05 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/892c7de0e14f7aba1c330295c2e5071a-6afe5d61c3786.png?jadewits_media_id=323635" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/892c7de0e14f7aba1c330295c2e5071a-6afe5d61c3786.png?jadewits_media_id=323635" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/892c7de0e14f7aba1c330295c2e5071a-6afe5d61c3786.png?jadewits_media_id=323635" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পঞ্চগড়ে জেঁকে বসছে শীত, এক দিনের ব্যবধানে তাপমাত্রা নেমেছে ১২.৫ ডিগ্রিতে" /&gt;&lt;/p&gt;&lt;p&gt;হিমালয়ের পাদদেশে অবস্থিত দেশের সর্ব উত্তরের জেলা পঞ্চগড়ে জেঁকে বসতে শুরু করেছে শীত। কয়েক দিনের ব্যবধানে তাপমাত্রা ক্রমাগত কমে আজ বৃহস্পতিবার (১৯ নভেম্বর) সকালে নেমে এসেছে ১২ দশমিক ৫ ডিগ্রি সেলসিয়াসে, যা চলতি মৌসুমে জেলায় সর্বনিম্ন তাপমাত্রা।
তেঁতুলিয়া আবহাওয়া পর্যবেক্ষণ কেন্দ্র সূত্রে জানা গেছ&lt;/p&gt;</description>

      <guid isPermaLink="true">https://www.ittefaq.com.bd/823158/%E0%A6%95%E0%A7%81%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BE-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AB%E0%A6%9F%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%86%E0%A6%B9%E0%A6%A4</guid>
      <pubDate>Thu, 26 Nov 2026 20:35:45 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/258d38add17202a15883ecc47e6a3958-6b0840a8c0581.jpg?jadewits_media_id=325042" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/258d38add17202a15883ecc47e6a3958-6b0840a8c0581.jpg?jadewits_media_id=325042" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/258d38add17202a15883ecc47e6a3958-6b0840a8c0581.jpg?jadewits_media_id=325042" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কুমিল্লা বিশ্ববিদ্যালয়ের ফটকে ককটেল বিস্ফোরণ, আহত ২" /&gt;&lt;/p&gt;&lt;p&gt;কুমিল্লা বিশ্ববিদ্যালয়ের (কুবি) প্রধান ফটকের সামনে ককটেল বিস্ফোরণের ঘটনা ঘটেছে। এতে বিশ্ববিদ্যালয়ের গণযোগাযোগ ও সাংবাদিকতা বিভাগের শিক্ষার্থী সানজিদা হামিম ও স্থানীয় এক অটোরিকশাচালক আহত হয়েছেন।
বৃহস্পতিবার (২৬ নভেম্বর) সন্ধ্যা আনুমানিক ৬টা ৪৫ মিনিটের দিকে এ ঘটনা ঘটে। এই ঘটনায় আহত অটোরিকশাচালকের নাম &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823158/%E0%A6%95%E0%A7%81%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BE-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AB%E0%A6%9F%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%86%E0%A6%B9%E0%A6%A4">দৈনিক ইত্তেফাক</source>
    </item>

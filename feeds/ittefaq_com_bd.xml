    <item>
      <title>সম্ভাবনা আছে; কিন্তু কর্মসংস্থান কোথায়?</title>
      <link>https://www.ittefaq.com.bd/822510/%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A6%A8%E0%A6%BE-%E0%A6%86%E0%A6%9B%E0%A7%87-%E0%A6%95%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%81-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8-%E0%A6%95%E0%A7%8B%E0%A6%A5%E0%A6%BE%E0%A7%9F</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822510/%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A6%A8%E0%A6%BE-%E0%A6%86%E0%A6%9B%E0%A7%87-%E0%A6%95%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%81-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8-%E0%A6%95%E0%A7%8B%E0%A6%A5%E0%A6%BE%E0%A7%9F</guid>
      <pubDate>Mon, 23 Nov 2026 06:00:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/678f9fb482ab59c0074ca9d3aaccadd5-6b035cd2c7287.jpg?jadewits_media_id=324351" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/678f9fb482ab59c0074ca9d3aaccadd5-6b035cd2c7287.jpg?jadewits_media_id=324351" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/678f9fb482ab59c0074ca9d3aaccadd5-6b035cd2c7287.jpg?jadewits_media_id=324351" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সম্ভাবনা আছে; কিন্তু কর্মসংস্থান কোথায়?" /&gt;&lt;/p&gt;&lt;p&gt;একজন তরুণ বিশ্ববিদ্যালয়ের সর্বোচ্চ ডিগ্রি অর্জন করিয়াও চাকুরি পাইতেছেন না। নিয়োগকর্তা তাহাকে বলিতেছেন, কর্মক্ষেত্রের অভিজ্ঞতা নাই। অথচ অভিজ্ঞতা অর্জনের জন্য প্রথম চাকুরিটি তাহার প্রয়োজন। এই অদ্ভুত বাস্তবতায় শিক্ষিত তরুণদের একটি বড় অংশের জীবন কর্মসংস্থানের অপেক্ষায় কাটিয়া যাইতেছে। প্রশ্ন হইল, একটি দে&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822510/%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A6%A8%E0%A6%BE-%E0%A6%86%E0%A6%9B%E0%A7%87-%E0%A6%95%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%81-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8-%E0%A6%95%E0%A7%8B%E0%A6%A5%E0%A6%BE%E0%A7%9F">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>গঙ্গা চুক্তির নবায়ন: ন্যায্যতা, সমতা ও পারস্পরিক সহযোগিতা</title>
      <link>https://www.ittefaq.com.bd/822504/%E0%A6%97%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%9A%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%A8%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A6%A8-%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AF%E0%A7%8D%E0%A6%AF%E0%A6%A4%E0%A6%BE-%E0%A6%B8%E0%A6%AE%E0%A6%A4%E0%A6%BE-%E0%A6%93-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%95</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822504/%E0%A6%97%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%9A%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%A8%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A6%A8-%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AF%E0%A7%8D%E0%A6%AF%E0%A6%A4%E0%A6%BE-%E0%A6%B8%E0%A6%AE%E0%A6%A4%E0%A6%BE-%E0%A6%93-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%95</guid>
      <pubDate>Mon, 23 Nov 2026 05:18:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/696d6ca2cb2f93f10105860b844db614-6b034b3782348.jpg?jadewits_media_id=324345" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/696d6ca2cb2f93f10105860b844db614-6b034b3782348.jpg?jadewits_media_id=324345" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/696d6ca2cb2f93f10105860b844db614-6b034b3782348.jpg?jadewits_media_id=324345" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গঙ্গা চুক্তির নবায়ন: ন্যায্যতা, সমতা ও পারস্পরিক সহযোগিতা" /&gt;&lt;/p&gt;&lt;p&gt;গঙ্গার পানি শুধু একটি নদীর পানি নয়, এটি বাংলাদেশের কৃষি, খাদ্যনিরাপত্তা, পরিবেশ, জীববৈচিত্র্য, নদীনির্ভর অর্থনীতি এবং কোটি মানুষের জীবন-জীবিকার সঙ্গে জড়িত। একই সঙ্গে এটি ভারত ও বাংলাদেশের অভিন্ন নদীর পানির ন্যায্য হিস্যা, প্রতিবেশীসুলভ সম্পর্ক এবং আঞ্চলিক সহযোগিতার একটি গুরুত্বপূর্ণ পরীক্ষা।
১৯৯৬ সা&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822504/%E0%A6%97%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%9A%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%A8%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A6%A8-%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AF%E0%A7%8D%E0%A6%AF%E0%A6%A4%E0%A6%BE-%E0%A6%B8%E0%A6%AE%E0%A6%A4%E0%A6%BE-%E0%A6%93-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%95">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>এইচএসসির উত্তরপত্র পুনঃনিরীক্ষণের ফল আজ</title>
      <link>https://www.ittefaq.com.bd/822512/%E0%A6%8F%E0%A6%87%E0%A6%9A%E0%A6%8F%E0%A6%B8%E0%A6%B8%E0%A6%BF%E0%A6%B0-%E0%A6%89%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AA%E0%A7%81%E0%A6%A8%E0%A6%83%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%AB%E0%A6%B2-%E0%A6%86%E0%A6%9C</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822512/%E0%A6%8F%E0%A6%87%E0%A6%9A%E0%A6%8F%E0%A6%B8%E0%A6%B8%E0%A6%BF%E0%A6%B0-%E0%A6%89%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AA%E0%A7%81%E0%A6%A8%E0%A6%83%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%AB%E0%A6%B2-%E0%A6%86%E0%A6%9C</guid>
      <pubDate>Mon, 23 Nov 2026 04:46:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/568cde9b3517503ae742df56a1610068-6b0361b7f1434.jpg?jadewits_media_id=324353" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/568cde9b3517503ae742df56a1610068-6b0361b7f1434.jpg?jadewits_media_id=324353" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/568cde9b3517503ae742df56a1610068-6b0361b7f1434.jpg?jadewits_media_id=324353" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এইচএসসির উত্তরপত্র পুনঃনিরীক্ষণের ফল আজ" /&gt;&lt;/p&gt;&lt;p&gt;চলতি বছরের উচ্চমাধ্যমিক সার্টিফিকেট (এইচএসসি) ও সমমান পরীক্ষার উত্তরপত্র পুনঃনিরীক্ষণের ফল সোমবার (২৩ নভেম্বর) প্রকাশ করা হবে। বিকেল ৩টায় শিক্ষা বোর্ডগুলোর ওয়েবসাইটে ফল প্রকাশ করা হবে। পাশাপাশি আবেদন করার সময় পরীক্ষার্থীদের দেওয়া মোবাইল নম্বরে এসএমএসের মাধ্যমেও ফল জানানো হবে।
রোববার (২২ নভেম্বর) আন্&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822512/%E0%A6%8F%E0%A6%87%E0%A6%9A%E0%A6%8F%E0%A6%B8%E0%A6%B8%E0%A6%BF%E0%A6%B0-%E0%A6%89%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AA%E0%A7%81%E0%A6%A8%E0%A6%83%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%AB%E0%A6%B2-%E0%A6%86%E0%A6%9C">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>টঙ্গীতে বসতবাড়িতে আগুন, শিশুসহ তিনজন দগ্ধ</title>
      <link>https://www.ittefaq.com.bd/822513/%E0%A6%9F%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%B8%E0%A6%A4%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%B8%E0%A6%B9-%E0%A6%A4%E0%A6%BF%E0%A6%A8%E0%A6%9C%E0%A6%A8-%E0%A6%A6%E0%A6%97%E0%A7%8D%E0%A6%A7</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822513/%E0%A6%9F%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%B8%E0%A6%A4%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%B8%E0%A6%B9-%E0%A6%A4%E0%A6%BF%E0%A6%A8%E0%A6%9C%E0%A6%A8-%E0%A6%A6%E0%A6%97%E0%A7%8D%E0%A6%A7</guid>
      <pubDate>Mon, 23 Nov 2026 04:14:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/0e1ac5304ad01d1b6d573d78d77a40c7-6b0368151327d.jpg?jadewits_media_id=324354" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/0e1ac5304ad01d1b6d573d78d77a40c7-6b0368151327d.jpg?jadewits_media_id=324354" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/0e1ac5304ad01d1b6d573d78d77a40c7-6b0368151327d.jpg?jadewits_media_id=324354" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টঙ্গীতে বসতবাড়িতে আগুন, শিশুসহ তিনজন দগ্ধ" /&gt;&lt;/p&gt;&lt;p&gt;গাজীপুরের টঙ্গী পশ্চিম থানাধীন দাঁড়াইল পশ্চিমপাড়া গ্রামে এক বাড়িতে আগুন লাগার ঘটনা ঘটেছে। এ ঘটনায় শিশুসহ তিনজন দগ্ধ হয়েছেন। আশঙ্কাজনক অবস্থায় তাদের ঢাকা মেডিকেল কলেজ হাসপাতালে পাঠানো হয়েছে।
রোববার (২২ নভেম্বর) রাত ৯টায় টঙ্গীর দাঁড়াইল পশ্চিমপাড়া এলাকায় জাহানারা বেগমের ভাড়া বাড়িতে এ ঘটনা ঘটে। রাত&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822513/%E0%A6%9F%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%B8%E0%A6%A4%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%B8%E0%A6%B9-%E0%A6%A4%E0%A6%BF%E0%A6%A8%E0%A6%9C%E0%A6%A8-%E0%A6%A6%E0%A6%97%E0%A7%8D%E0%A6%A7">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>রঙ মেশানো শুঁটকি-পচা মাংস বিক্রি, তিন প্রতিষ্ঠানকে জরিমানা</title>
      <link>https://www.ittefaq.com.bd/822511/%E0%A6%B0%E0%A6%99-%E0%A6%AE%E0%A7%87%E0%A6%B6%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%B6%E0%A7%81%E0%A6%81%E0%A6%9F%E0%A6%95%E0%A6%BF-%E0%A6%AA%E0%A6%9A%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%82%E0%A6%B8-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A8%E0%A6%95%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822511/%E0%A6%B0%E0%A6%99-%E0%A6%AE%E0%A7%87%E0%A6%B6%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%B6%E0%A7%81%E0%A6%81%E0%A6%9F%E0%A6%95%E0%A6%BF-%E0%A6%AA%E0%A6%9A%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%82%E0%A6%B8-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A8%E0%A6%95%E0%A7%87</guid>
      <pubDate>Mon, 23 Nov 2026 03:45:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/256911f057959972bd3819e07449f97b-6b035fc6d4a62.jpg?jadewits_media_id=324352" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/256911f057959972bd3819e07449f97b-6b035fc6d4a62.jpg?jadewits_media_id=324352" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/256911f057959972bd3819e07449f97b-6b035fc6d4a62.jpg?jadewits_media_id=324352" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রঙ মেশানো শুঁটকি-পচা মাংস বিক্রি, তিন প্রতিষ্ঠানকে জরিমানা" /&gt;&lt;/p&gt;&lt;p&gt;চাঁদপুরে রঙ মেশানো শুঁটকি মাছ বিক্রি, বিক্রির উদ্দেশ্যে বাসি-পচা মাংস মজুত রাখার দায়ে তিন প্রতিষ্ঠানকে মোট ২০ হাজার টাকা জরিমানা করেছে জাতীয় ভোক্তা অধিকার সংরক্ষণ অধিদপ্তর।
রোববার (২২ নভেম্বর) দুপুরে চাঁদপুর শহরের বাবুরহাট বাজারে অভিযান চালানো হয়।
অভিযানে ভোক্তা অধিকার সংরক্ষণ আইন, ২০০৯ অনুযায়ী উত্ত&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822511/%E0%A6%B0%E0%A6%99-%E0%A6%AE%E0%A7%87%E0%A6%B6%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%B6%E0%A7%81%E0%A6%81%E0%A6%9F%E0%A6%95%E0%A6%BF-%E0%A6%AA%E0%A6%9A%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%82%E0%A6%B8-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A8%E0%A6%95%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>তথ্য সংগ্রহে গিয়ে দুর্বৃত্তদের ছুরিকাঘাতে পুলিশ সদস্য নিহত, দৌড়ে বাঁচলেন এএসআই</title>
      <link>https://www.ittefaq.com.bd/822509/%E0%A6%A4%E0%A6%A5%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A6%82%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%B9%E0%A7%87-%E0%A6%97%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%9B%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%98%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822509/%E0%A6%A4%E0%A6%A5%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A6%82%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%B9%E0%A7%87-%E0%A6%97%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%9B%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%98%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6</guid>
      <pubDate>Mon, 23 Nov 2026 03:13:22 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/8a760c4b6bcae3dd4c9476cd100e27b9-6b035aa894608.jpg?jadewits_media_id=324350" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/8a760c4b6bcae3dd4c9476cd100e27b9-6b035aa894608.jpg?jadewits_media_id=324350" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/8a760c4b6bcae3dd4c9476cd100e27b9-6b035aa894608.jpg?jadewits_media_id=324350" style="max-width:100%;height:auto;margin-bottom:10px;" alt="তথ্য সংগ্রহে গিয়ে দুর্বৃত্তদের ছুরিকাঘাতে পুলিশ সদস্য নিহত, দৌড়ে বাঁচলেন এএসআই" /&gt;&lt;/p&gt;&lt;p&gt;নারায়ণগঞ্জের ফতুল্লায় সাদা পোশাকে গোয়েন্দা তথ্য সংগ্রহ করতে গিয়ে দুর্বৃত্তদের ছুরিকাঘাতে আনোয়ার হোসেন নামে এক পুলিশ কনস্টেবল নিহত হয়েছেন। হামলাকারীদের ধাওয়া খেয়ে তার সঙ্গে থাকা সহকারী উপ-পরিদর্শক (এএসআই) আব্দুস সাত্তার দৌড়ে প্রাণে বাঁচলেও আনোয়ারকে ধরে বুকে ছুরিকাঘাত করে হত্যা করে দুর্বৃত্তরা।
র&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822509/%E0%A6%A4%E0%A6%A5%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A6%82%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%B9%E0%A7%87-%E0%A6%97%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%9B%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%98%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>পুলিশের পিকআপ ভ্যান চুরির যাওয়ার ঘটনায় এসআইসহ ৪ সদস্য বরখাস্ত</title>
      <link>https://www.ittefaq.com.bd/822507/%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%BF%E0%A6%95%E0%A6%86%E0%A6%AA-%E0%A6%AD%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%B0-%E0%A6%AF%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%8F%E0%A6%B8%E0%A6%86%E0%A6%87%E0%A6%B8%E0%A6%B9-%E0%A7%AA</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822507/%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%BF%E0%A6%95%E0%A6%86%E0%A6%AA-%E0%A6%AD%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%B0-%E0%A6%AF%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%8F%E0%A6%B8%E0%A6%86%E0%A6%87%E0%A6%B8%E0%A6%B9-%E0%A7%AA</guid>
      <pubDate>Mon, 23 Nov 2026 02:33:43 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/325ed013ed168b67a772c7331d2f1eb5-6b0351470280c.jpg?jadewits_media_id=324348" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/325ed013ed168b67a772c7331d2f1eb5-6b0351470280c.jpg?jadewits_media_id=324348" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/325ed013ed168b67a772c7331d2f1eb5-6b0351470280c.jpg?jadewits_media_id=324348" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পুলিশের পিকআপ ভ্যান চুরির যাওয়ার ঘটনায় এসআইসহ ৪ সদস্য বরখাস্ত" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রামে পুলিশের টহল পিকআপ চুরির ঘটনায় দায়িত্বে অবহেলার অভিযোগে এক উপ-পরিদর্শকসহ (এসআই) চার পুলিশ সদস্যকে সাময়িক বরখাস্ত করেছে চট্টগ্রাম মেট্রোপলিটন পুলিশ (সিএমপি)। চুরির সময় দায়িত্বে থাকা সদস্যদের বিরুদ্ধে এ ব্যবস্থা নেওয়া হয়েছে।
রোববার (২২ নভেম্বর) এক অফিস আদেশের মাধ্যমে তাদের সাময়িক বরখাস্ত করা&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822507/%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%BF%E0%A6%95%E0%A6%86%E0%A6%AA-%E0%A6%AD%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%B0-%E0%A6%AF%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%8F%E0%A6%B8%E0%A6%86%E0%A6%87%E0%A6%B8%E0%A6%B9-%E0%A7%AA">দৈনিক ইত্তেফাক</source>
    </item>

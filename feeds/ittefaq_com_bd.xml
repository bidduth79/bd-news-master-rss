    <item>
      <title>নিউমোনিয়া মোকাবিলায় দেশে ভ্যাকসিনের পর্যাপ্ত মজুত রয়েছে: স্বাস্থ্যমন্ত্রী</title>
      <link>https://www.ittefaq.com.bd/820548/%E0%A6%A8%E0%A6%BF%E0%A6%89%E0%A6%AE%E0%A7%8B%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%BE-%E0%A6%AE%E0%A7%8B%E0%A6%95%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AD%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%95%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%A4-%E0%A6%AE%E0%A6%9C%E0%A7%81%E0%A6%A4</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820548/%E0%A6%A8%E0%A6%BF%E0%A6%89%E0%A6%AE%E0%A7%8B%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%BE-%E0%A6%AE%E0%A7%8B%E0%A6%95%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AD%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%95%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%A4-%E0%A6%AE%E0%A6%9C%E0%A7%81%E0%A6%A4</guid>
      <pubDate>Thu, 12 Nov 2026 15:28:36 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/62aae01e82031117013504f3d8ee3837-6af585e346d0e.jpg?jadewits_media_id=322335" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/62aae01e82031117013504f3d8ee3837-6af585e346d0e.jpg?jadewits_media_id=322335" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/62aae01e82031117013504f3d8ee3837-6af585e346d0e.jpg?jadewits_media_id=322335" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নিউমোনিয়া মোকাবিলায় দেশে ভ্যাকসিনের পর্যাপ্ত মজুত রয়েছে: স্বাস্থ্যমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;নিউমোনিয়া মোকাবিলায় দেশে ভ্যাকসিনের পর্যাপ্ত মজুত রয়েছে। প্রয়োজনে আরও ভ্যাকসিন আমদানির সক্ষমতাও সরকারের রয়েছে বলে জানিয়েছেন স্বাস্থ্যমন্ত্রী সরদার সাখাওয়াত হোসেন। তিনি বলেন, &amp;lsquo;নিউমোনিয়া থেকে শিশুদের বাঁচাতে কী কী করতে হবে, আমাকে শুধু বলেন। আমি সব করব। যেকোনো সরঞ্জাম বা সহায়তা দিতে আমি প্রস্তুত।&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820548/%E0%A6%A8%E0%A6%BF%E0%A6%89%E0%A6%AE%E0%A7%8B%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%BE-%E0%A6%AE%E0%A7%8B%E0%A6%95%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AD%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%95%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%A4-%E0%A6%AE%E0%A6%9C%E0%A7%81%E0%A6%A4">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>র‍্যাংকিংয়ে হৃদয়ের ১১৫ ধাপ উন্নতি</title>
      <link>https://www.ittefaq.com.bd/820547/%E0%A6%B0%E2%80%8D%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A6%BF%E0%A6%82%E0%A7%9F%E0%A7%87-%E0%A6%B9%E0%A7%83%E0%A6%A6%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A7%A7%E0%A7%A7%E0%A7%AB-%E0%A6%A7%E0%A6%BE%E0%A6%AA-%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A6%A4%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820547/%E0%A6%B0%E2%80%8D%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A6%BF%E0%A6%82%E0%A7%9F%E0%A7%87-%E0%A6%B9%E0%A7%83%E0%A6%A6%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A7%A7%E0%A7%A7%E0%A7%AB-%E0%A6%A7%E0%A6%BE%E0%A6%AA-%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A6%A4%E0%A6%BF</guid>
      <pubDate>Thu, 12 Nov 2026 15:15:28 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/4dc6fe0e783a548ffebf91214f9dd0f9-6af583848f340.jpg?jadewits_media_id=322334" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/4dc6fe0e783a548ffebf91214f9dd0f9-6af583848f340.jpg?jadewits_media_id=322334" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/4dc6fe0e783a548ffebf91214f9dd0f9-6af583848f340.jpg?jadewits_media_id=322334" style="max-width:100%;height:auto;margin-bottom:10px;" alt="র‍্যাংকিংয়ে হৃদয়ের ১১৫ ধাপ উন্নতি" /&gt;&lt;/p&gt;&lt;p&gt;ওয়েস্ট ইন্ডিজের বিপক্ষে মহাকাব্যিক ডাবল সেঞ্চুরির পুরস্কার পেলেন তাওহীদ হৃদয়। আইসিসির সবশেষ হালনাগাদ করা টেস্ট ব্যাটারদের র&amp;zwj;্যাংকিংয়ে এক লাফে ১১৫ ধাপ এগিয়েছেন বাংলাদেশের এই ব্যাটার। ৫১১ রেটিং পয়েন্ট নিয়ে উঠে এসেছেন ৬০তম স্থানে।
গতকাল ক্রিকেটের নিয়ন্ত্রক সংস্থা আইসিসি প্রকাশিত র&amp;zwj;্যাংকিংয়ে দেখ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820547/%E0%A6%B0%E2%80%8D%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A6%BF%E0%A6%82%E0%A7%9F%E0%A7%87-%E0%A6%B9%E0%A7%83%E0%A6%A6%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A7%A7%E0%A7%A7%E0%A7%AB-%E0%A6%A7%E0%A6%BE%E0%A6%AA-%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A6%A4%E0%A6%BF">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>তিন দেশ থেকে এলএনজি কিনবে সরকার, রমজানে আসছে ৬২০০ টন খেজুর</title>
      <link>https://www.ittefaq.com.bd/820546/%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%8F%E0%A6%B2%E0%A6%8F%E0%A6%A8%E0%A6%9C%E0%A6%BF-%E0%A6%95%E0%A6%BF%E0%A6%A8%E0%A6%AC%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A6%AE%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%B8%E0%A6%9B%E0%A7%87-%E0%A7%AC%E0%A7%A8%E0%A7%A6%E0%A7%A6</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820546/%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%8F%E0%A6%B2%E0%A6%8F%E0%A6%A8%E0%A6%9C%E0%A6%BF-%E0%A6%95%E0%A6%BF%E0%A6%A8%E0%A6%AC%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A6%AE%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%B8%E0%A6%9B%E0%A7%87-%E0%A7%AC%E0%A7%A8%E0%A7%A6%E0%A7%A6</guid>
      <pubDate>Thu, 12 Nov 2026 14:54:46 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/9d519f037e8b8faa7cd329b98f04dec7-6af57e15b73e0.jpg?jadewits_media_id=322332" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/9d519f037e8b8faa7cd329b98f04dec7-6af57e15b73e0.jpg?jadewits_media_id=322332" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/9d519f037e8b8faa7cd329b98f04dec7-6af57e15b73e0.jpg?jadewits_media_id=322332" style="max-width:100%;height:auto;margin-bottom:10px;" alt="তিন দেশ থেকে এলএনজি কিনবে সরকার, রমজানে আসছে ৬২০০ টন খেজুর" /&gt;&lt;/p&gt;&lt;p&gt;আসন্ন রমজানে ৬ হাজার ২০০ মেট্রিক টন খেজুর আমদানি, তিনটি দেশ থেকে তরলীকৃত প্রাকৃতিক গ্যাস (এলএনজি) কেনা এবং হযরত শাহজালাল আন্তর্জাতিক বিমানবন্দরের তৃতীয় টার্মিনালে মোবাইল নেটওয়ার্ক স্থাপনের উদ্যোগ নিয়েছে সরকার।&amp;nbsp;
এসব বিষয়সহ মোট পাঁচটি প্রস্তাবে নীতিগত অনুমোদনের সুপারিশ করেছে অর্থনৈতিক বিষয়সংক্রান&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820546/%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%8F%E0%A6%B2%E0%A6%8F%E0%A6%A8%E0%A6%9C%E0%A6%BF-%E0%A6%95%E0%A6%BF%E0%A6%A8%E0%A6%AC%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A6%AE%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%B8%E0%A6%9B%E0%A7%87-%E0%A7%AC%E0%A7%A8%E0%A7%A6%E0%A7%A6">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>‘আগামী ১০ বছরের মধ্যেই ক্যানসার-অ্যালঝাইমার অতীত হয়ে যেতে পারে’</title>
      <link>https://www.ittefaq.com.bd/820545/%E2%80%98%E0%A6%86%E0%A6%97%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A7%A7%E0%A7%A6-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%87-%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A6%B8%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A6%9D%E0%A6%BE%E0%A6%87%E0%A6%AE%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%A4%E0%A7%80%E0%A6%A4</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820545/%E2%80%98%E0%A6%86%E0%A6%97%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A7%A7%E0%A7%A6-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%87-%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A6%B8%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A6%9D%E0%A6%BE%E0%A6%87%E0%A6%AE%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%A4%E0%A7%80%E0%A6%A4</guid>
      <pubDate>Thu, 12 Nov 2026 14:53:44 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/e831a8c898799dc8e2277ae78bd83e13-6af57e25948bc.jpg?jadewits_media_id=322333" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/e831a8c898799dc8e2277ae78bd83e13-6af57e25948bc.jpg?jadewits_media_id=322333" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/e831a8c898799dc8e2277ae78bd83e13-6af57e25948bc.jpg?jadewits_media_id=322333" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘আগামী ১০ বছরের মধ্যেই ক্যানসার-অ্যালঝাইমার অতীত হয়ে যেতে পারে’" /&gt;&lt;/p&gt;&lt;p&gt;ক্যানসার, আলঝেইমার, হৃদরোগ ও মানসিক রোগের মতো জটিল রোগ আগামী এক দশকেরও কম সময়ে অতীত হয়ে যেতে পারে বলে আশাবাদ ব্যক্ত করেছেন কৃত্রিম বুদ্ধিমত্তা (এআই) প্রতিষ্ঠান অ্যানথ্রপিকের প্রধান নির্বাহী কর্মকর্তা (সিইও) দারিও আমোদেই। বুধবার (১১ নভেম্বর) ভারতীয় সংবাদমাধ্যম এনডিটিভির এক প্রতিবেদন থেকে এ তথ্য জানা &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820545/%E2%80%98%E0%A6%86%E0%A6%97%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A7%A7%E0%A7%A6-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%87-%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A6%B8%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A6%9D%E0%A6%BE%E0%A6%87%E0%A6%AE%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%A4%E0%A7%80%E0%A6%A4">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>এনসিপি নেত্রী নুসরাত তাবাসসুমের বাড়িতে পেট্রলবোমা হামলা, জামায়াতের নিন্দা</title>

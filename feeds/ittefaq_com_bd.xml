    <item>
      <title>প্রবাসফেরত ‘স্বামীকে’ নিয়ে বিমানবন্দরে তিন নারীর কাড়াকাড়ি</title>
      <link>https://www.ittefaq.com.bd/820674/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%A4-%E2%80%98%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%95%E0%A7%87%E2%80%99-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%B0%E0%A7%87-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820674/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%A4-%E2%80%98%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%95%E0%A7%87%E2%80%99-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%B0%E0%A7%87-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%B0</guid>
      <pubDate>Fri, 13 Nov 2026 05:30:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/2f955ecb44d1b309e8ea28c4b64aeec1-6af628a26f67f.jpg?jadewits_media_id=322467" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/2f955ecb44d1b309e8ea28c4b64aeec1-6af628a26f67f.jpg?jadewits_media_id=322467" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/2f955ecb44d1b309e8ea28c4b64aeec1-6af628a26f67f.jpg?jadewits_media_id=322467" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রবাসফেরত ‘স্বামীকে’ নিয়ে বিমানবন্দরে তিন নারীর কাড়াকাড়ি" /&gt;&lt;/p&gt;&lt;p&gt;প্রবাসফেরত এক ব্যক্তিকে নিজের স্বামী দাবি করে বিমানবন্দর এলাকায় তিন নারীর টানাটানি ও হট্টগোলের একটি ভিডিও সামাজিক যোগাযোগমাধ্যমে ভাইরাল হয়েছে। ওই ব্যক্তিকে নিজ নিজ বাড়িতে নিয়ে যাওয়াকে কেন্দ্র করে তিন নারীর মধ্যে তীব্র বাগ্&amp;zwnj;বিতণ্ডা ও ধস্তাধস্তির ঘটনা ঘটে। তবে ভিডিওতে থাকা ওই প্রবাসী কিংবা নারী&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820674/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%A4-%E2%80%98%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%95%E0%A7%87%E2%80%99-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%B0%E0%A7%87-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>তাইওয়ানের স্বাধীনতার কোনো সুযোগ নেই</title>
      <link>https://www.ittefaq.com.bd/820669/%E0%A6%A4%E0%A6%BE%E0%A6%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%A7%E0%A7%80%E0%A6%A8%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A7%8B%E0%A6%A8%E0%A7%8B-%E0%A6%B8%E0%A7%81%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820669/%E0%A6%A4%E0%A6%BE%E0%A6%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%A7%E0%A7%80%E0%A6%A8%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A7%8B%E0%A6%A8%E0%A7%8B-%E0%A6%B8%E0%A7%81%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%87</guid>
      <pubDate>Fri, 13 Nov 2026 05:00:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/70f0d7d4ea16c986d1f3c4a7f7ce31ac-6af61fa7c24a5.jpg?jadewits_media_id=322462" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/70f0d7d4ea16c986d1f3c4a7f7ce31ac-6af61fa7c24a5.jpg?jadewits_media_id=322462" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/70f0d7d4ea16c986d1f3c4a7f7ce31ac-6af61fa7c24a5.jpg?jadewits_media_id=322462" style="max-width:100%;height:auto;margin-bottom:10px;" alt="তাইওয়ানের স্বাধীনতার কোনো সুযোগ নেই" /&gt;&lt;/p&gt;&lt;p&gt;চীনের মহান বিপ্লবী নেতা সুন ইয়াত-সেনের ১৬০তম জন্মবার্ষিকী উপলক্ষ্যে বৃহস্পতিবার সকালে বেইজিংয়ের গণমহাভবনে এক বর্ণাঢ্য স্মরণসভা অনুষ্ঠিত হয়। এতে চীনের কমিউনিস্ট পার্টির (সিপিসি) কেন্দ্রীয় কমিটির সাধারণ সম্পাদক, প্রেসিডেন্ট এবং কেন্দ্রীয় সামরিক কমিশনের চেয়ারম্যান শি জিনপিং গুরুত্বপূর্ণ ভাষণ দেন।
ভাষণে&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820669/%E0%A6%A4%E0%A6%BE%E0%A6%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%A7%E0%A7%80%E0%A6%A8%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A7%8B%E0%A6%A8%E0%A7%8B-%E0%A6%B8%E0%A7%81%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>পালিত মেয়েই করেছে বাড়ি ছাড়া, চালিয়েছে শারীরিক নির্যাতন</title>
      <link>https://www.ittefaq.com.bd/820671/%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%A4-%E0%A6%AE%E0%A7%87%E0%A7%9F%E0%A7%87%E0%A6%87-%E0%A6%95%E0%A6%B0%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%B6%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%B0%E0%A6%BF%E0%A6%95</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820671/%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%A4-%E0%A6%AE%E0%A7%87%E0%A7%9F%E0%A7%87%E0%A6%87-%E0%A6%95%E0%A6%B0%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%B6%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%B0%E0%A6%BF%E0%A6%95</guid>
      <pubDate>Fri, 13 Nov 2026 04:30:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/375e56c9fd1e0df729dee6735040946c-6af624b63ee8b.jpg?jadewits_media_id=322464" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/375e56c9fd1e0df729dee6735040946c-6af624b63ee8b.jpg?jadewits_media_id=322464" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/375e56c9fd1e0df729dee6735040946c-6af624b63ee8b.jpg?jadewits_media_id=322464" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পালিত মেয়েই করেছে বাড়ি ছাড়া, চালিয়েছে শারীরিক নির্যাতন" /&gt;&lt;/p&gt;&lt;p&gt;নিজের পালিত মেয়েই অত্যাচার-নির্যাতন করে বাড়ি ছাড়া করেছেন। এখন নিজের ফ্ল্যাটটিও লিখে নেওয়ার চেষ্টা করছেন- এমন অভিযোগ করেছেন পঞ্চাশোর্ধ্ব নারী দিল আরা খানম ডলি। ইত্তেফাক কার্যালয়ে এসে ডলি অভিযোগ করেন, নিজের পালিত মেয়ে মেহেরুন নেসা নীর (২৫) তাকে শারীরিকভাবে নির্যাতন করেছেন। এখন সম্পত্তি দখলের চেষ্টা কর&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820671/%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%A4-%E0%A6%AE%E0%A7%87%E0%A7%9F%E0%A7%87%E0%A6%87-%E0%A6%95%E0%A6%B0%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%B6%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%B0%E0%A6%BF%E0%A6%95">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>মোদিকে প্রশ্ন করা সেই নারী সাংবাদিকের ভিসা বাতিল</title>
      <link>https://www.ittefaq.com.bd/820670/%E0%A6%AE%E0%A7%8B%E0%A6%A6%E0%A6%BF%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B6%E0%A7%8D%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A6%BE-%E0%A6%B8%E0%A7%87%E0%A6%87-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%B8%E0%A6%BE%E0%A6%82%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AD%E0%A6%BF%E0%A6%B8%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%B2</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820670/%E0%A6%AE%E0%A7%8B%E0%A6%A6%E0%A6%BF%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B6%E0%A7%8D%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A6%BE-%E0%A6%B8%E0%A7%87%E0%A6%87-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%B8%E0%A6%BE%E0%A6%82%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AD%E0%A6%BF%E0%A6%B8%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%B2</guid>
      <pubDate>Fri, 13 Nov 2026 04:00:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/2ccbf6f87e5de69a16b05d14b4abeaf9-6af6211e1e529.jpg?jadewits_media_id=322463" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/2ccbf6f87e5de69a16b05d14b4abeaf9-6af6211e1e529.jpg?jadewits_media_id=322463" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/2ccbf6f87e5de69a16b05d14b4abeaf9-6af6211e1e529.jpg?jadewits_media_id=322463" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মোদিকে প্রশ্ন করা সেই নারী সাংবাদিকের ভিসা বাতিল" /&gt;&lt;/p&gt;&lt;p&gt;২০২৬ সালের মে মাসে নরওয়ের অসলো সফরে ভারতের প্রধানমন্ত্রী নরেন্দ্র মোদিকে প্রশ্ন করে আলোচনায় আসা নরওয়েজিয়ান সাংবাদিক হেলে লিংকে ভারতে প্রবেশের অনুমতি দেওয়া হয়নি। বৈধ ভিসা থাকা সত্ত্বেও হায়দরাবাদের উদ্দেশে রওনা হওয়ার মাত্র কয়েক ঘণ্টা আগে তার ভিসা বাতিল করা হয়েছে বলে অভিযোগ করেছেন তিনি।
তেলেঙ্গানা সরকা&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820670/%E0%A6%AE%E0%A7%8B%E0%A6%A6%E0%A6%BF%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B6%E0%A7%8D%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A6%BE-%E0%A6%B8%E0%A7%87%E0%A6%87-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%B8%E0%A6%BE%E0%A6%82%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AD%E0%A6%BF%E0%A6%B8%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%B2">দৈনিক ইত্তেফাক</source>

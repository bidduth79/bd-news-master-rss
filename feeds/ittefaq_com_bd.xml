    <item>
      <title>শাহজালাল বিমানবন্দরে সাড়ে ৭ কেজি স্বর্ণের পেস্ট উদ্ধার, আটক ৩</title>
      <link>https://www.ittefaq.com.bd/822306/%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A6%9C%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A7%9C%E0%A7%87-%E0%A7%AD-%E0%A6%95%E0%A7%87%E0%A6%9C%E0%A6%BF-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%87%E0%A6%B8%E0%A7%8D%E0%A6%9F</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822306/%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A6%9C%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A7%9C%E0%A7%87-%E0%A7%AD-%E0%A6%95%E0%A7%87%E0%A6%9C%E0%A6%BF-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%87%E0%A6%B8%E0%A7%8D%E0%A6%9F</guid>
      <pubDate>Sun, 22 Nov 2026 05:21:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/b9c8767b394a3f7e9867c26b593eca22-6b0201bd3693f.jpg?jadewits_media_id=324145" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/b9c8767b394a3f7e9867c26b593eca22-6b0201bd3693f.jpg?jadewits_media_id=324145" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/b9c8767b394a3f7e9867c26b593eca22-6b0201bd3693f.jpg?jadewits_media_id=324145" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শাহজালাল বিমানবন্দরে সাড়ে ৭ কেজি স্বর্ণের পেস্ট উদ্ধার, আটক ৩" /&gt;&lt;/p&gt;&lt;p&gt;হযরত শাহজালাল আন্তর্জাতিক বিমানবন্দরে ৭ কেজি ৫০০ গ্রাম ওজনের ১৫টি ডিম্বাকৃতির স্বর্ণের পেস্ট উদ্ধার করেছে এয়ারপোর্ট আর্মড পুলিশ ব্যাটালিয়ন (এপিবিএন)। &amp;nbsp;এ ঘটনায় তিনজনকে আটক করা হয়েছে। উদ্ধার করা স্বর্ণের আনুমানিক বাজারমূল্য ১১ কোটি ৬৭ লাখ টাকা।&amp;nbsp;
শনিবার (২১ নভেম্বর) সকাল সাড়ে ১০টার দিকে বিমান&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822306/%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A6%9C%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A7%9C%E0%A7%87-%E0%A7%AD-%E0%A6%95%E0%A7%87%E0%A6%9C%E0%A6%BF-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%87%E0%A6%B8%E0%A7%8D%E0%A6%9F">দৈনিক ইত্তেফাক</source>
    </item>

    <item>
      <title>গাজীপুরে সংঘর্ষ, পুলিশ বক্সে আগুন, ৭০ কারখানায় ছুটি</title>
      <link>https://www.ittefaq.com.bd/822874/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A7%80%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%B0%E0%A7%8D%E0%A6%B7-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%AC%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A7%AD%E0%A7%A6-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A7%9F</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822874/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A7%80%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%B0%E0%A7%8D%E0%A6%B7-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%AC%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A7%AD%E0%A7%A6-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A7%9F</guid>
      <pubDate>Wed, 25 Nov 2026 07:56:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/19299039f66001aefc22d65c4ac8da28-6b05fb28f3ab1.jpg?jadewits_media_id=324719" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/19299039f66001aefc22d65c4ac8da28-6b05fb28f3ab1.jpg?jadewits_media_id=324719" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/19299039f66001aefc22d65c4ac8da28-6b05fb28f3ab1.jpg?jadewits_media_id=324719" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গাজীপুরে সংঘর্ষ, পুলিশ বক্সে আগুন, ৭০ কারখানায় ছুটি" /&gt;&lt;/p&gt;&lt;p&gt;পোশাকশ্রমিকদের ন্যূনতম বেতন ৩০ হাজার টাকা করার দাবিতে গত কিছুদিন ধরে চলমান শ্রমিক আন্দোলনের ধারাবাহিকতায় গতকাল মঙ্গলবার সকাল থেকে গাজীপুরের বিভিন্ন স্থানে মহাসড়ক অবরোধ, বিক্ষোভ এবং পুলিশের সঙ্গে শ্রমিকদের ধাওয়া-পালটা ধাওয়া ও সংঘর্ষের ঘটনা ঘটেছে। গাজীপুরা এলাকায় পুলিশ বক্সে আগুন দিয়েছে বিক্ষুব্ধরা। দ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822874/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A7%80%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%B0%E0%A7%8D%E0%A6%B7-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%AC%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A7%AD%E0%A7%A6-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A7%9F">দৈনিক ইত্তেফাক</source>
    </item>

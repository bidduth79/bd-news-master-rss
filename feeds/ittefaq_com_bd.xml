      <guid isPermaLink="true">https://www.ittefaq.com.bd/820334/%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2%E0%A7%87-%E0%A6%AD%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%B2%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%B6%E0%A7%81%E0%A6%A7%E0%A7%81-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A3%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Wed, 11 Nov 2026 16:06:34 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/7e7bdacaa1e7ae9be0b316093b14117d-6af43405b2f9a.jpg?jadewits_media_id=322118" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/7e7bdacaa1e7ae9be0b316093b14117d-6af43405b2f9a.jpg?jadewits_media_id=322118" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/7e7bdacaa1e7ae9be0b316093b14117d-6af43405b2f9a.jpg?jadewits_media_id=322118" style="max-width:100%;height:auto;margin-bottom:10px;" alt="স্কুলে ভর্তি: লটারি শুধু প্রথম শ্রেণিতে, বাকিদের লিখিত পরীক্ষা" /&gt;&lt;/p&gt;&lt;p&gt;২০২৭ শিক্ষাবর্ষে বেসরকারি মাধ্যমিক বিদ্যালয়ের প্রথম শ্রেণিতে লটারির মাধ্যমে শিক্ষার্থী ভর্তি করা হবে। অন্যদিকে, দ্বিতীয় থেকে নবম শ্রেণি পর্যন্ত শূন্য আসনে শিক্ষার্থী ভর্তি করা হবে লিখিত পরীক্ষার মাধ্যমে।
এ ছাড়া ঢাকা মহানগরীর বেসরকারি বিদ্যালয়গুলোতে ভর্তির ক্ষেত্রে সংশ্লিষ্ট বিদ্যালয়ের ক্যাচমেন্ট এলা&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820334/%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2%E0%A7%87-%E0%A6%AD%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%B2%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%B6%E0%A7%81%E0%A6%A7%E0%A7%81-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A3%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0">দৈনিক ইত্তেফাক</source>

    <item>
      <title>ইসরায়েলে বিরোধীদের মধ্যে বিরোধ, সরকার গঠন নিয়ে চ্যালেঞ্জে আইজেনকট</title>
      <link>https://www.ittefaq.com.bd/823028/%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A7%87%C2%A0%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%97%E0%A6%A0%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823028/%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A7%87%C2%A0%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%97%E0%A6%A0%E0%A6%A8</guid>
      <pubDate>Thu, 26 Nov 2026 00:58:05 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/22851bfde273462d16a432c3876be462-6b072fa6f2c14.jpg?jadewits_media_id=324905" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/22851bfde273462d16a432c3876be462-6b072fa6f2c14.jpg?jadewits_media_id=324905" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/22851bfde273462d16a432c3876be462-6b072fa6f2c14.jpg?jadewits_media_id=324905" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইসরায়েলে বিরোধীদের মধ্যে বিরোধ, সরকার গঠন নিয়ে চ্যালেঞ্জে আইজেনকট" /&gt;&lt;/p&gt;&lt;p&gt;ইসরাইলে নতুন সরকার গঠনের প্রক্রিয়ায় বিরোধী জোটে তীব্র মতবিরোধ দেখা দিয়েছে। বামপন্থি &amp;lsquo;ডেমোক্রেটস পার্টি&amp;rsquo; সরকার গঠনের দায়িত্বপ্রাপ্ত নেতা গাদি আইজেনকটের দল &amp;lsquo;ইয়াশার&amp;rsquo; সঙ্গে জোটবদ্ধ হওয়ার আলোচনা স্থগিত করেছে। গত ২৭ অক্টোবরের নির্বাচনে কোনো দল একক সংখ্যাগরিষ্ঠতা না পাওয়ায় বর্তমান প&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823028/%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A7%87%C2%A0%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%97%E0%A6%A0%E0%A6%A8">দৈনিক ইত্তেফাক</source>
    </item>

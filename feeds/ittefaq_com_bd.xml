    <item>
      <title>বিয়ে করলেন মিমি, গোপনীয়তা ভেঙে ছবি প্রকাশ করলেন অভিনেত্রী</title>
      <link>https://www.ittefaq.com.bd/823238/%E0%A6%AC%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AE%E0%A6%BF%E0%A6%AE%E0%A6%BF-%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%A8%E0%A7%80%E0%A7%9F%E0%A6%A4%E0%A6%BE-%E0%A6%AD%E0%A7%87%E0%A6%99%E0%A7%87-%E0%A6%9B%E0%A6%AC%E0%A6%BF-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B6-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823238/%E0%A6%AC%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AE%E0%A6%BF%E0%A6%AE%E0%A6%BF-%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%A8%E0%A7%80%E0%A7%9F%E0%A6%A4%E0%A6%BE-%E0%A6%AD%E0%A7%87%E0%A6%99%E0%A7%87-%E0%A6%9B%E0%A6%AC%E0%A6%BF-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B6-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Fri, 27 Nov 2026 13:26:17 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/3862fa2b26da3afda7cfee72008ce605-6b09309654621.jpg?jadewits_media_id=325130" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/3862fa2b26da3afda7cfee72008ce605-6b09309654621.jpg?jadewits_media_id=325130" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/3862fa2b26da3afda7cfee72008ce605-6b09309654621.jpg?jadewits_media_id=325130" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিয়ে করলেন মিমি, গোপনীয়তা ভেঙে ছবি প্রকাশ করলেন অভিনেত্রী" /&gt;&lt;/p&gt;&lt;p&gt;কোনো ছবিতে বিয়ের কাগজে সই করছেন বর, কোনো ছবিতে আংটি পরিয়ে দিচ্ছেন কনে। আবার কোনো ছবিতে একে অপরকে জড়িয়ে ধরে আছেন দুজন। কয়েক দিন ধরে চলা নানা জল্পনার অবসান ঘটিয়ে অবশেষে নিজের বিয়ের ছবি প্রকাশ করলেন কলকাতার জনপ্রিয় অভিনেত্রী মিমি চক্রবর্তী।
বৃহস্পতিবার (২৬ নভেম্বর) সন্ধ্যায় মেরিন ইঞ্জিনিয়ার সিদ্ধার্থ দ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823238/%E0%A6%AC%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AE%E0%A6%BF%E0%A6%AE%E0%A6%BF-%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%A8%E0%A7%80%E0%A7%9F%E0%A6%A4%E0%A6%BE-%E0%A6%AD%E0%A7%87%E0%A6%99%E0%A7%87-%E0%A6%9B%E0%A6%AC%E0%A6%BF-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B6-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>দেশের সব মাদ্রাসার জন্য জরুরি নির্দেশনা</title>
      <link>https://www.ittefaq.com.bd/823237/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AC-%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%9C%E0%A6%B0%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%A8%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823237/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AC-%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%9C%E0%A6%B0%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%A8%E0%A6%BE</guid>
      <pubDate>Fri, 27 Nov 2026 13:06:26 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/24c2425969eb8ba6ce0c4163ab632dce-6b092b54a7123.jpg?jadewits_media_id=325128" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/24c2425969eb8ba6ce0c4163ab632dce-6b092b54a7123.jpg?jadewits_media_id=325128" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/24c2425969eb8ba6ce0c4163ab632dce-6b092b54a7123.jpg?jadewits_media_id=325128" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দেশের সব মাদ্রাসার জন্য জরুরি নির্দেশনা" /&gt;&lt;/p&gt;&lt;p&gt;আসন্ন শহীদ বুদ্ধিজীবী দিবস ও মহান বিজয় দিবস যথাযোগ্য মর্যাদায় পালন করতে দেশের সব মাদ্রাসার অধ্যক্ষ, সুপার, প্রতিষ্ঠান প্রধান, সভাপতি ও পরিচালনা কমিটির সদস্যদের নির্দেশনা দেওয়া হয়েছে।&amp;nbsp;
বৃহস্পতিবার (২৬ নভেম্বর) বাংলাদেশ মাদ্রাসা শিক্ষা বোর্ডের পৃথক দুই বিজ্ঞপ্তিতে এ নির্দেশনা জানানো হয়।&amp;nbsp;
বিজ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823237/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AC-%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%9C%E0%A6%B0%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%A8%E0%A6%BE">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>টুঙ্গিপাড়ায় বিজিবির ওপর হামলার ঘটনায় মামলা, আসামি ৫ হাজার</title>
      <link>https://www.ittefaq.com.bd/823236/%E0%A6%9F%E0%A7%81%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BF%E0%A6%AA%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%86%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823236/%E0%A6%9F%E0%A7%81%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BF%E0%A6%AA%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%86%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%BF</guid>
      <pubDate>Fri, 27 Nov 2026 13:02:37 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/ee5c35e4d2615f6d7d56f5fd7fc9461c-6b092825c0488.jpg?jadewits_media_id=325127" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/ee5c35e4d2615f6d7d56f5fd7fc9461c-6b092825c0488.jpg?jadewits_media_id=325127" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/ee5c35e4d2615f6d7d56f5fd7fc9461c-6b092825c0488.jpg?jadewits_media_id=325127" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টুঙ্গিপাড়ায় বিজিবির ওপর হামলার ঘটনায় মামলা, আসামি ৫ হাজার" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জের টুঙ্গিপাড়ায় বর্ডার গার্ড বাংলাদেশের (বিজিবি) টহলদলের ওপর হামলা, সরকারি যানবাহনে অগ্নিসংযোগ, গোলাবারুদ ধ্বংস ও সরঞ্জাম লুটের অভিযোগে মামলা হয়েছে। মামলায় নিষিদ্ধ জেলা ছাত্রলীগের সভাপতি নিউটন মোল্লাকে প্রধান আসামি করা হয়েছে। এ ছাড়া আটজনের নাম উল্লেখ করে অজ্ঞাতনামা আরও পাঁচ হাজার ব্যক্তিকে আ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823236/%E0%A6%9F%E0%A7%81%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BF%E0%A6%AA%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%86%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%BF">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>মাতিয়া বানু শুকুর বিদায়ে চঞ্চল চৌধুরীর আবেগঘন বার্তা</title>
      <link>https://www.ittefaq.com.bd/823235/%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A7%9F%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A6%A8%E0%A7%81-%E0%A6%B6%E0%A7%81%E0%A6%95%E0%A7%81%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A6%BE%E0%A7%9F%E0%A7%87-%E0%A6%9A%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%B2-%E0%A6%9A%E0%A7%8C%E0%A6%A7%E0%A7%81%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%86%E0%A6%AC%E0%A7%87%E0%A6%97%E0%A6%98%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823235/%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A7%9F%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A6%A8%E0%A7%81-%E0%A6%B6%E0%A7%81%E0%A6%95%E0%A7%81%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A6%BE%E0%A7%9F%E0%A7%87-%E0%A6%9A%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%B2-%E0%A6%9A%E0%A7%8C%E0%A6%A7%E0%A7%81%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%86%E0%A6%AC%E0%A7%87%E0%A6%97%E0%A6%98%E0%A6%A8</guid>
      <pubDate>Fri, 27 Nov 2026 12:50:48 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/9794fb20b6d8720dd5eed9e04dd233e0-6b09280f0cd06.jpg?jadewits_media_id=325126" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/9794fb20b6d8720dd5eed9e04dd233e0-6b09280f0cd06.jpg?jadewits_media_id=325126" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/9794fb20b6d8720dd5eed9e04dd233e0-6b09280f0cd06.jpg?jadewits_media_id=325126" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মাতিয়া বানু শুকুর বিদায়ে চঞ্চল চৌধুরীর আবেগঘন বার্তা" /&gt;&lt;/p&gt;&lt;p&gt;&amp;lsquo;কয়েক দিন আগেও দেখা হয়েছিল, সেই দেখাই যে শেষ দেখা হয়ে থাকবে তা মেনে নিতে পারছি না&amp;rsquo;-নাট্যকার ও নির্মাতা মাতিয়া বানু শুকুর মৃত্যুতে এভাবেই শোক প্রকাশ করেছেন অভিনেতা চঞ্চল চৌধুরী। সামাজিক যোগাযোগ মাধ্যমে দেওয়া এক পোস্টে চারুকলার বড় বোন শুকুর সঙ্গে কাটানো শেষ সময়ের স্মৃতি তুলে ধরে গভীর শ্রদ্&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823235/%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A7%9F%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A6%A8%E0%A7%81-%E0%A6%B6%E0%A7%81%E0%A6%95%E0%A7%81%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A6%BE%E0%A7%9F%E0%A7%87-%E0%A6%9A%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%B2-%E0%A6%9A%E0%A7%8C%E0%A6%A7%E0%A7%81%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%86%E0%A6%AC%E0%A7%87%E0%A6%97%E0%A6%98%E0%A6%A8">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>দামি চালে বাড়তি খরচ, স্বস্তি শীতের সবজি-মুরগি-ডিমে</title>
      <link>https://www.ittefaq.com.bd/823234/%E0%A6%A6%E0%A6%BE%E0%A6%AE%E0%A6%BF-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%A4%E0%A6%BF-%E0%A6%96%E0%A6%B0%E0%A6%9A-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%B6%E0%A7%80%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AC%E0%A6%9C%E0%A6%BF-%E0%A6%AE%E0%A7%81%E0%A6%B0%E0%A6%97%E0%A6%BF%E2%80%93%E0%A6%A1%E0%A6%BF%E0%A6%AE%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823234/%E0%A6%A6%E0%A6%BE%E0%A6%AE%E0%A6%BF-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%A4%E0%A6%BF-%E0%A6%96%E0%A6%B0%E0%A6%9A-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%B6%E0%A7%80%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AC%E0%A6%9C%E0%A6%BF-%E0%A6%AE%E0%A7%81%E0%A6%B0%E0%A6%97%E0%A6%BF%E2%80%93%E0%A6%A1%E0%A6%BF%E0%A6%AE%E0%A7%87</guid>
      <pubDate>Fri, 27 Nov 2026 12:54:57 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/203438b8253e0bfd55a10e71446cdd07-6b09280594d47.jpg?jadewits_media_id=325125" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/203438b8253e0bfd55a10e71446cdd07-6b09280594d47.jpg?jadewits_media_id=325125" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/203438b8253e0bfd55a10e71446cdd07-6b09280594d47.jpg?jadewits_media_id=325125" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দামি চালে বাড়তি খরচ, স্বস্তি শীতের সবজি-মুরগি-ডিমে" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর বাজারে নাজিরশাইল ও মিনিকেট চালের দাম বাড়তি থাকায় ভোক্তাদের খরচ বেড়েছে। প্রায় তিন সপ্তাহ আগে এসব চালের দাম কেজিতে এক থেকে চার টাকা পর্যন্ত বাড়ানো হয়। এরপর থেকে নতুন করে দাম না কমায় বাড়তি দরেই কিনতে হচ্ছে ক্রেতাদের। বিপরীতে গত দুই সপ্তাহে মুরগি ও ডিমের দাম কমায় কিছুটা স্বস্তি ফিরেছে এ দুই পণ্&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823234/%E0%A6%A6%E0%A6%BE%E0%A6%AE%E0%A6%BF-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%A4%E0%A6%BF-%E0%A6%96%E0%A6%B0%E0%A6%9A-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%B6%E0%A7%80%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AC%E0%A6%9C%E0%A6%BF-%E0%A6%AE%E0%A7%81%E0%A6%B0%E0%A6%97%E0%A6%BF%E2%80%93%E0%A6%A1%E0%A6%BF%E0%A6%AE%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>২০ জন থেকে পাকিস্তানের কেন্দ্রীয় চুক্তিতে মাত্র ৮ নারী ক্রিকেটার</title>
      <link>https://www.ittefaq.com.bd/823233/%E0%A7%A8%E0%A7%A6-%E0%A6%9C%E0%A6%A8-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A7%9F-%E0%A6%9A%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A7%AE</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823233/%E0%A7%A8%E0%A7%A6-%E0%A6%9C%E0%A6%A8-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A7%9F-%E0%A6%9A%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A7%AE</guid>
      <pubDate>Fri, 27 Nov 2026 12:40:31 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/b9d9d0adf14d385c9406c2ca9eef1149-6b0925c0df866.jpg?jadewits_media_id=325123" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/b9d9d0adf14d385c9406c2ca9eef1149-6b0925c0df866.jpg?jadewits_media_id=325123" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/b9d9d0adf14d385c9406c2ca9eef1149-6b0925c0df866.jpg?jadewits_media_id=325123" style="max-width:100%;height:auto;margin-bottom:10px;" alt="২০ জন থেকে পাকিস্তানের কেন্দ্রীয় চুক্তিতে মাত্র ৮ নারী ক্রিকেটার" /&gt;&lt;/p&gt;&lt;p&gt;কয়েকদিন আগেই পুরুষ জাতীয় দলের কেন্দ্রীয় &amp;zwj;চুক্তির তালিকা প্রকাশ করেছিল পাকিস্তান ক্রিকেট বোর্ড (পিসিবি)। যেখানে ৩০ জন থেকে বাড়িয়ে প্রথমবার জায়গা পেয়েছিল ৩৮ ক্রিকেটার।&amp;nbsp;
তবে নারী ক্রিকেটে উল্টোপথে হাঁটল পিসিবি। নারী দলের মাত্র ৮ ক্রিকেটারকে কেন্দ্রীয় চুক্তিতে রাখা হয়েছে। অথচ গত মৌসুমে পাঁচ ক্য&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823233/%E0%A7%A8%E0%A7%A6-%E0%A6%9C%E0%A6%A8-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A7%9F-%E0%A6%9A%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A7%AE">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>রাজধানীতে আবাসিক হোটেলে ঢুকে ব্যবস্থাপককে কুপিয়ে হত্যা, আহত ২</title>

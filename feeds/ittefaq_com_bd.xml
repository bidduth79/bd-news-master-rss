    <item>
      <title>যুক্তরাষ্ট্রে প্রত্যেক শিশুকে স্পেসএক্সের দুটি করে শেয়ার দেবেন ইলন মাস্ক</title>
      <link>https://www.ittefaq.com.bd/823334/%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%95-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%95%E0%A7%87%C2%A0%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A7%87%E0%A6%B8%E0%A6%8F%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%9F%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823334/%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%95-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%95%E0%A7%87%C2%A0%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A7%87%E0%A6%B8%E0%A6%8F%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%9F%E0%A6%BF</guid>
      <pubDate>Sat, 28 Nov 2026 07:00:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/dc912d0a960cf6ddaab38983298b15d6-6b09d2b4d317c.jpg?jadewits_media_id=325229" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/dc912d0a960cf6ddaab38983298b15d6-6b09d2b4d317c.jpg?jadewits_media_id=325229" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/dc912d0a960cf6ddaab38983298b15d6-6b09d2b4d317c.jpg?jadewits_media_id=325229" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যুক্তরাষ্ট্রে প্রত্যেক শিশুকে স্পেসএক্সের দুটি করে শেয়ার দেবেন ইলন মাস্ক" /&gt;&lt;/p&gt;&lt;p&gt;বিশ্বের অন্যতম শীর্ষ ধনকুবের ইলন মাস্ক ঘোষণা দিয়েছেন যুক্তরাষ্ট্রের প্রতিটি শিশুকে তার প্রতিষ্ঠান স্পেসএক্সের দুইটি করে শেয়ার দেওয়া হবে—এর মধ্যে একটি দেবে কোম্পানি এবং একটি দেবেন তিনি ব্যক্তিগতভাবে।
স্পেসএক্সের পক্ষ থেকে শেয়ার আগামী মাসেই হস্তান্তর করা হতে পারে, আর মাস্কের ব্যক্তিগত শেয়ার আগামী বছরে&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823334/%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%95-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%95%E0%A7%87%C2%A0%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A7%87%E0%A6%B8%E0%A6%8F%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%9F%E0%A6%BF">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>নিরাপদ পানি পাচ্ছে না দেশের ৬৩ শতাংশ মানুষ</title>
      <link>https://www.ittefaq.com.bd/823331/%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A6%A6-%E0%A6%AA%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%AA%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%A8%E0%A6%BE%C2%A0%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A7%AC%E0%A7%A9-%E0%A6%B6%E0%A6%A4%E0%A6%BE%E0%A6%82%E0%A6%B6-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B7</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823331/%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A6%A6-%E0%A6%AA%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%AA%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%A8%E0%A6%BE%C2%A0%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A7%AC%E0%A7%A9-%E0%A6%B6%E0%A6%A4%E0%A6%BE%E0%A6%82%E0%A6%B6-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B7</guid>
      <pubDate>Sat, 28 Nov 2026 06:00:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/b42806541426db24f742e7ecf7b6b9cf-6b09d0246fdff.jpg?jadewits_media_id=325226" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/b42806541426db24f742e7ecf7b6b9cf-6b09d0246fdff.jpg?jadewits_media_id=325226" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/b42806541426db24f742e7ecf7b6b9cf-6b09d0246fdff.jpg?jadewits_media_id=325226" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নিরাপদ পানি পাচ্ছে না দেশের ৬৩ শতাংশ মানুষ" /&gt;&lt;/p&gt;&lt;p&gt;দেশে পানির উেসর অভাব নেই। কিন্তু সেই পানি কতটা নিরাপদ, তা নিয়ে বড় প্রশ্ন উঠেছে। দেশের ৯৮ দশমিক ৬ শতাংশ মানুষ অন্তত মৌলিক পানির সুবিধা পেলেও নিরাপদভাবে ব্যবস্থাপিত পানি পাচ্ছেন মাত্র ৩৭ দশমিক ১ শতাংশ। অর্থাত্ নিরাপদ পানির নির্ধারিত সব শর্ত পূরণ হচ্ছে না ৬২ দশমিক ৯ শতাংশ মানুষের ক্ষেত্রে।
পরিবারের ব্য&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823331/%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A6%A6-%E0%A6%AA%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%AA%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%A8%E0%A6%BE%C2%A0%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A7%AC%E0%A7%A9-%E0%A6%B6%E0%A6%A4%E0%A6%BE%E0%A6%82%E0%A6%B6-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B7">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>চারঘাটে রস ছাড়াই তৈরি শত শত মণ ‘খাঁটি গুড়’!</title>
      <link>https://www.ittefaq.com.bd/823330/%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A6%98%E0%A6%BE%E0%A6%9F%E0%A7%87-%E0%A6%B0%E0%A6%B8-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%87-%E0%A6%A4%E0%A7%88%E0%A6%B0%E0%A6%BF%C2%A0%E0%A6%B6%E0%A6%A4-%E0%A6%B6%E0%A6%A4-%E0%A6%AE%E0%A6%A3-%E2%80%98%E0%A6%96%E0%A6%BE%E0%A6%81%E0%A6%9F%E0%A6%BF-%E0%A6%97%E0%A7%81%E0%A7%9C%E2%80%99</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823330/%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A6%98%E0%A6%BE%E0%A6%9F%E0%A7%87-%E0%A6%B0%E0%A6%B8-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%87-%E0%A6%A4%E0%A7%88%E0%A6%B0%E0%A6%BF%C2%A0%E0%A6%B6%E0%A6%A4-%E0%A6%B6%E0%A6%A4-%E0%A6%AE%E0%A6%A3-%E2%80%98%E0%A6%96%E0%A6%BE%E0%A6%81%E0%A6%9F%E0%A6%BF-%E0%A6%97%E0%A7%81%E0%A7%9C%E2%80%99</guid>
      <pubDate>Sat, 28 Nov 2026 05:00:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/53a9dd136f491e19291ef43e209d3afe-6b09cf66842b6.jpg?jadewits_media_id=325225" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/53a9dd136f491e19291ef43e209d3afe-6b09cf66842b6.jpg?jadewits_media_id=325225" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/53a9dd136f491e19291ef43e209d3afe-6b09cf66842b6.jpg?jadewits_media_id=325225" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চারঘাটে রস ছাড়াই তৈরি শত শত মণ ‘খাঁটি গুড়’!" /&gt;&lt;/p&gt;&lt;p&gt;খেজুরের রসের ‘র’ও নেই অথচ তৈরি হচ্ছে একদম ‘খাঁটি গুড়’! শীতের আগমনের শুরুতেই যখন মানুষের আগ্রহ থাকে খেজুরের গুড়ের প্রতি, তখন তত্পর হয়ে উঠেছে সেই অতি পরিচিত অসাধু চক্র। উপাদান হিসেবে ব্যবহার করা হচ্ছে চিনিকলের চিটাগুড়, অপরিশোধিত চিনি, কাপড়ের রং, আটা, রাসায়নিক পদার্থ, ভেষজ নির্যাস ও খেজুরের গুড়ের কৃত্র&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823330/%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A6%98%E0%A6%BE%E0%A6%9F%E0%A7%87-%E0%A6%B0%E0%A6%B8-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%87-%E0%A6%A4%E0%A7%88%E0%A6%B0%E0%A6%BF%C2%A0%E0%A6%B6%E0%A6%A4-%E0%A6%B6%E0%A6%A4-%E0%A6%AE%E0%A6%A3-%E2%80%98%E0%A6%96%E0%A6%BE%E0%A6%81%E0%A6%9F%E0%A6%BF-%E0%A6%97%E0%A7%81%E0%A7%9C%E2%80%99">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>২ লাখ কোচিং সেন্টারে জড়িত লাখো শিক্ষক!</title>
      <link>https://www.ittefaq.com.bd/823328/%E0%A7%A8-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%95%E0%A7%8B%E0%A6%9A%E0%A6%BF%E0%A6%82-%E0%A6%B8%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A7%87%C2%A0%E0%A6%9C%E0%A7%9C%E0%A6%BF%E0%A6%A4-%E0%A6%B2%E0%A6%BE%E0%A6%96%E0%A7%8B-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%95</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823328/%E0%A7%A8-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%95%E0%A7%8B%E0%A6%9A%E0%A6%BF%E0%A6%82-%E0%A6%B8%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A7%87%C2%A0%E0%A6%9C%E0%A7%9C%E0%A6%BF%E0%A6%A4-%E0%A6%B2%E0%A6%BE%E0%A6%96%E0%A7%8B-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%95</guid>
      <pubDate>Sat, 28 Nov 2026 04:00:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/d061204886a1867f00f50f57e29b224a-6b09ce85795be.jpg?jadewits_media_id=325223" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/d061204886a1867f00f50f57e29b224a-6b09ce85795be.jpg?jadewits_media_id=325223" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/d061204886a1867f00f50f57e29b224a-6b09ce85795be.jpg?jadewits_media_id=325223" style="max-width:100%;height:auto;margin-bottom:10px;" alt="২ লাখ কোচিং সেন্টারে জড়িত লাখো শিক্ষক!" /&gt;&lt;/p&gt;&lt;p&gt;শিক্ষা মন্ত্রণালয়ের নির্দেশনা উপেক্ষা করে রাজধানীসহ সারা দেশে প্রায় ২ লাখ কোচিং সেন্টারে সম্পৃক্ত রয়েছেন লাখো এমপিওভুক্ত শিক্ষক! বাংলাদেশ পরিসংখ্যান ব্যুরোর (বিবিএস) জরিপ প্রতিবেদন অনুযায়ী, দেশে নিবন্ধিত কোচিং সেন্টারের সংখ্যা ৬ হাজার ৫৮৭। এর মধ্যে একাডেমিক ৬ হাজার ৩১২টি ও বিশ্ববিদ্যালয় ভর্তি প্রস্ত&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823328/%E0%A7%A8-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%95%E0%A7%8B%E0%A6%9A%E0%A6%BF%E0%A6%82-%E0%A6%B8%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A7%87%C2%A0%E0%A6%9C%E0%A7%9C%E0%A6%BF%E0%A6%A4-%E0%A6%B2%E0%A6%BE%E0%A6%96%E0%A7%8B-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%95">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>আওয়ামী লীগ নেতাকে ধরতে গ্রামবাসীর বাধা, ফিরে গেল পুলিশ</title>
      <link>https://www.ittefaq.com.bd/823338/%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%A7%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%80%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%A7%E0%A6%BE-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%B2</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823338/%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%A7%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%80%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%A7%E0%A6%BE-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%B2</guid>
      <pubDate>Sat, 28 Nov 2026 03:30:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/f26ffc79beff5d366f1260a88e970f50-6b09d66da842c.jpg?jadewits_media_id=325233" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/f26ffc79beff5d366f1260a88e970f50-6b09d66da842c.jpg?jadewits_media_id=325233" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/f26ffc79beff5d366f1260a88e970f50-6b09d66da842c.jpg?jadewits_media_id=325233" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আওয়ামী লীগ নেতাকে ধরতে গ্রামবাসীর বাধা, ফিরে গেল পুলিশ" /&gt;&lt;/p&gt;&lt;p&gt;সিরাজগঞ্জের শাহজাদপুরে কার্যক্রম নিষিদ্ধ আওয়ামী লীগের নেতা ও পৌরসভার সাবেক মেয়র হালিমুল হক মিরুকে গ্রেপ্তার করতে গিয়ে গ্রামবাসীর বাধার মুখে পড়েছে পুলিশ। শুক্রবার (২৭ নভেম্বর) বিকেল পৌনে ৪টার দিকে শাহজাদপুর পৌর শহরের নলুয়া গ্রামে এ ঘটনা ঘটে এবং পরে তাকে গ্রেপ্তার না করেই ঘটনাস্থল থেকে ফিরে যায় &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823338/%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%A7%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%80%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%A7%E0%A6%BE-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%B2">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>ঝড়-বন্যায় বিপর্যস্ত যুক্তরাষ্ট্র বিদ্যুৎহীন ১০ লাখ গ্রাহক, ৪০০ ফ্লাইট বাতিল</title>
      <link>https://www.ittefaq.com.bd/823332/%E0%A6%9D%E0%A7%9C-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%B8%E0%A7%8D%E0%A6%A4-%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A7%8E%E0%A6%B9%E0%A7%80%E0%A6%A8%C2%A0%E0%A7%A7%E0%A7%A6-%E0%A6%B2%E0%A6%BE%E0%A6%96</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823332/%E0%A6%9D%E0%A7%9C-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%B8%E0%A7%8D%E0%A6%A4-%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A7%8E%E0%A6%B9%E0%A7%80%E0%A6%A8%C2%A0%E0%A7%A7%E0%A7%A6-%E0%A6%B2%E0%A6%BE%E0%A6%96</guid>
      <pubDate>Sat, 28 Nov 2026 03:00:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/934d969bdceaa6cc5b5ad835cfd0dbf4-6b09d12b77bd9.jpg?jadewits_media_id=325227" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/934d969bdceaa6cc5b5ad835cfd0dbf4-6b09d12b77bd9.jpg?jadewits_media_id=325227" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/934d969bdceaa6cc5b5ad835cfd0dbf4-6b09d12b77bd9.jpg?jadewits_media_id=325227" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঝড়-বন্যায় বিপর্যস্ত যুক্তরাষ্ট্র বিদ্যুৎহীন ১০ লাখ গ্রাহক, ৪০০ ফ্লাইট বাতিল" /&gt;&lt;/p&gt;&lt;p&gt;থ্যাংকসগিভিংডের ছুটিতে শক্তিশালী ঝড় ও একটানা বৃষ্টিতে তছনছ হয়ে গেছে যুক্তরাষ্ট্রের পূর্ব উপকূলীয় অঞ্চল। কোথাও কোথাও এর মধ্যেই বিপজ্জনক হারে চলছে তুষারপাত।  ঝোড়ো বাতাসে গাছ ও বিদ্যুতের খুঁটি উপড়ে প্রায় ১০ লাখ গ্রাহকের বিদ্যুত্ সরবরাহ বন্ধ হয়ে গেছে। অবরুদ্ধ সড়ক। ব্যাহত বিমান চলাচল।
বৃহস্পতিবার থেকে ৪৪&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823332/%E0%A6%9D%E0%A7%9C-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%B8%E0%A7%8D%E0%A6%A4-%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A7%8E%E0%A6%B9%E0%A7%80%E0%A6%A8%C2%A0%E0%A7%A7%E0%A7%A6-%E0%A6%B2%E0%A6%BE%E0%A6%96">দৈনিক ইত্তেফাক</source>

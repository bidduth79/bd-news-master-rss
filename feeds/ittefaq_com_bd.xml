    <item>
      <title>প্রাথমিক শিক্ষার্থীদের ঝরে পড়া ঠেকাতে সংসদীয় কমিটির একাধিক সুপারিশ</title>
      <link>https://www.ittefaq.com.bd/823155/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A5%E0%A6%AE%E0%A6%BF%E0%A6%95-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%9D%E0%A6%B0%E0%A7%87-%E0%A6%AA%E0%A7%9C%E0%A6%BE-%E0%A6%A0%E0%A7%87%E0%A6%95%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6%E0%A7%80%E0%A7%9F</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823155/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A5%E0%A6%AE%E0%A6%BF%E0%A6%95-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%9D%E0%A6%B0%E0%A7%87-%E0%A6%AA%E0%A7%9C%E0%A6%BE-%E0%A6%A0%E0%A7%87%E0%A6%95%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6%E0%A7%80%E0%A7%9F</guid>
      <pubDate>Thu, 26 Nov 2026 20:07:48 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/974d61471eef9f2c6e2131a16380fc90-6b083d19e8b53.jpg?jadewits_media_id=325038" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/974d61471eef9f2c6e2131a16380fc90-6b083d19e8b53.jpg?jadewits_media_id=325038" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/974d61471eef9f2c6e2131a16380fc90-6b083d19e8b53.jpg?jadewits_media_id=325038" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রাথমিক শিক্ষার্থীদের ঝরে পড়া ঠেকাতে সংসদীয় কমিটির একাধিক সুপারিশ" /&gt;&lt;/p&gt;&lt;p&gt;প্রাথমিক বিদ্যালয় থেকে ঝরে পড়া শিশুদের অপরাধমূলক কর্মকাণ্ডে জড়িয়ে পড়া ঠেকাতে তাদের বিভিন্ন শিক্ষামূলক কার্যক্রমে অন্তর্ভুক্ত করার সুপারিশ করেছে প্রাথমিক ও গণশিক্ষা মন্ত্রণালয় সম্পর্কিত সংসদীয় স্থায়ী কমিটি।
বৃহস্পতিবার (২৬ নভেম্বর) জাতীয় সংসদ ভবনে ত্রয়োদশ জাতীয় সংসদের প্রাথমিক ও গণশিক্ষা মন্ত্রণালয় স&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823155/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A5%E0%A6%AE%E0%A6%BF%E0%A6%95-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%9D%E0%A6%B0%E0%A7%87-%E0%A6%AA%E0%A7%9C%E0%A6%BE-%E0%A6%A0%E0%A7%87%E0%A6%95%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6%E0%A7%80%E0%A7%9F">দৈনিক ইত্তেফাক</source>

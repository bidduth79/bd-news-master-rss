      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/382392b112659897e49194396936f942-6af779548f9cd.jpg?jadewits_media_id=322653" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/382392b112659897e49194396936f942-6af779548f9cd.jpg?jadewits_media_id=322653" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/382392b112659897e49194396936f942-6af779548f9cd.jpg?jadewits_media_id=322653" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাংলাদেশের পেস আক্রমণ নিয়ে ভয় প্রোটিয়াদের" /&gt;&lt;/p&gt;&lt;p&gt;দক্ষিণ আফ্রিকার বিপক্ষে দুই ম্যাচের টেস্ট সিরিজের প্রথম ম্যাচে আগামীকাল মাঠে নামবে বাংলাদেশ। আইসিসি টেস্ট চ্যাম্পিয়নশিপের অংশ হওয়ায় দুই দলের কাছেই সিরিজটি বেশ গুরুত্বপূর্ণ। তবে অতীতের তুলনায় বর্তমান বাংলাদেশ দলকে নিয়ে অনেক বেশি সতর্ক দক্ষিণ আফ্রিকা। বিশেষ করে সাম্প্রতিক সময়ে বাংলাদেশের পেস বোলিং ইউন&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820859/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%87%E0%A6%B8-%E0%A6%86%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%A3-%E0%A6%A8%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%AD%E0%A7%9F-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%9F%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0">দৈনিক ইত্তেফাক</source>

    </item>
    <item>
      <title>আগামীকাল ঢাকায় বসছে বাংলাদেশ-ভারত যৌথ নদী কমিশনের বৈঠক</title>
      <link>https://www.ittefaq.com.bd/822289/%E0%A6%86%E0%A6%97%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%95%E0%A6%BE%E0%A6%B2-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%B8%E0%A6%9B%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4-%E0%A6%AF%E0%A7%8C%E0%A6%A5-%E0%A6%A8%E0%A6%A6%E0%A7%80-%E0%A6%95%E0%A6%AE%E0%A6%BF%E0%A6%B6%E0%A6%A8%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822289/%E0%A6%86%E0%A6%97%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%95%E0%A6%BE%E0%A6%B2-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%B8%E0%A6%9B%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4-%E0%A6%AF%E0%A7%8C%E0%A6%A5-%E0%A6%A8%E0%A6%A6%E0%A7%80-%E0%A6%95%E0%A6%AE%E0%A6%BF%E0%A6%B6%E0%A6%A8%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Sat, 21 Nov 2026 22:40:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/dce775abdeefe6d53a965b59aff85497-6b01c63dcb169.jpg?jadewits_media_id=324129" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/dce775abdeefe6d53a965b59aff85497-6b01c63dcb169.jpg?jadewits_media_id=324129" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/dce775abdeefe6d53a965b59aff85497-6b01c63dcb169.jpg?jadewits_media_id=324129" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আগামীকাল ঢাকায় বসছে বাংলাদেশ-ভারত যৌথ নদী কমিশনের বৈঠক" /&gt;&lt;/p&gt;&lt;p&gt;আগামীকাল ঢাকায় বসছে বাংলাদেশ ও ভারতের যৌথ নদী কমিশনের (জেআরসি) গুরুত্বপূর্ণ বৈঠক। এই বৈঠকে দুই দেশের প্রতিনিধিরা গঙ্গা ও পদ্মা নদীর পানি বণ্টন সংক্রান্ত তথ্য-উপাত্ত বিনিময় করবেন। তবে আগামী ১২ ডিসেম্বর শেষ হতে যাওয়া ঐতিহাসিক গঙ্গা পানি বণ্টন চুক্তির মেয়াদ বাড়ানো কিংবা নতুন চুক্তির বিষয়টি এবারের &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822289/%E0%A6%86%E0%A6%97%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%95%E0%A6%BE%E0%A6%B2-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%B8%E0%A6%9B%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4-%E0%A6%AF%E0%A7%8C%E0%A6%A5-%E0%A6%A8%E0%A6%A6%E0%A7%80-%E0%A6%95%E0%A6%AE%E0%A6%BF%E0%A6%B6%E0%A6%A8%E0%A7%87%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>আওয়ামী লীগকে নিষিদ্ধ করা হবে কিনা, তা আইনি প্রক্রিয়ায় বিবেচনাধীন: আইনমন্ত্রী</title>
      <link>https://www.ittefaq.com.bd/822290/%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%95%E0%A6%B0%E0%A6%BE-%E0%A6%B9%E0%A6%AC%E0%A7%87-%E0%A6%95%E0%A6%BF%E0%A6%A8%E0%A6%BE-%E0%A6%A4%E0%A6%BE-%E0%A6%86%E0%A6%87%E0%A6%A8%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822290/%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%95%E0%A6%B0%E0%A6%BE-%E0%A6%B9%E0%A6%AC%E0%A7%87-%E0%A6%95%E0%A6%BF%E0%A6%A8%E0%A6%BE-%E0%A6%A4%E0%A6%BE-%E0%A6%86%E0%A6%87%E0%A6%A8%E0%A6%BF</guid>
      <pubDate>Sat, 21 Nov 2026 22:32:01 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/53feeff947b027f1a5be99302706498d-6b01c72564808.jpg?jadewits_media_id=324130" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/53feeff947b027f1a5be99302706498d-6b01c72564808.jpg?jadewits_media_id=324130" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/53feeff947b027f1a5be99302706498d-6b01c72564808.jpg?jadewits_media_id=324130" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আওয়ামী লীগকে নিষিদ্ধ করা হবে কিনা, তা আইনি প্রক্রিয়ায় বিবেচনাধীন: আইনমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;আওয়ামী লীগকে নিষিদ্ধ করা হবে কিনা তা আইনি প্রক্রিয়ায় বিবেচনাধীন আছে বলে জানিয়েছেন আইনমন্ত্রী মো. আসাদুজ্জামান। তিনি জানান, গোপালগঞ্জে আওয়ামী লীগের তাণ্ডবের বিচার ট্রাইব্যুনালে হবে কিনা সেটিও খতিয়ে দেখছে সরকার।
শনিবার (২১ নভেম্বর) সন্ধ্যায় জাতীয় জাদুঘরে ঢাকাস্থ চুয়াডাঙ্গার শিক্ষার্থীদের মিলনমেলা ও শি&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822290/%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%95%E0%A6%B0%E0%A6%BE-%E0%A6%B9%E0%A6%AC%E0%A7%87-%E0%A6%95%E0%A6%BF%E0%A6%A8%E0%A6%BE-%E0%A6%A4%E0%A6%BE-%E0%A6%86%E0%A6%87%E0%A6%A8%E0%A6%BF">দৈনিক ইত্তেফাক</source>

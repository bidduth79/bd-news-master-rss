      <guid isPermaLink="true">https://www.ittefaq.com.bd/820996/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A6%BE%E0%A6%9B-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%9D%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%AE%E2%80%99%E0%A6%B0%E2%80%99%E0%A6%A6%E0%A7%87%E0%A6%B9-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Sat, 14 Nov 2026 21:23:22 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/3a2a14d5bcbd9fc3206d8ce1c54c4d7a-6af87cb7e6811.jpg?jadewits_media_id=322799" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/3a2a14d5bcbd9fc3206d8ce1c54c4d7a-6af87cb7e6811.jpg?jadewits_media_id=322799" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/3a2a14d5bcbd9fc3206d8ce1c54c4d7a-6af87cb7e6811.jpg?jadewits_media_id=322799" style="max-width:100%;height:auto;margin-bottom:10px;" alt="খুলনায় গাছ থেকে যুবকের ঝুলন্ত ম’র’দেহ উদ্ধার" /&gt;&lt;/p&gt;&lt;p&gt;খুলনায় রায়খান ওরফে রায়হান (৩২) নামে এক যুবকের ঝুলন্ত মরদেহ উদ্ধার করেছে পুলিশ।
শনিবার (১৪ নভেম্বর) সন্ধ্যা সাড়ে ৫টার দিকে নগরীর মোস্তফার মোড়ের খইয়াতলা-মাক্ষিনগর এলাকায় গাছের সঙ্গে ঝুলন্ত অবস্থায় তার মরদেহ উদ্ধার করা হয়। তার গ্রামের বাড়ি ব্রাহ্মণবাড়িয়া জেলায়। তিনি বর্তমানে নগরীর বৈকালী এলাকায় বসবাস ক&lt;/p&gt;</description>

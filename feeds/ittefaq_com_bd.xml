      <guid isPermaLink="true">https://www.ittefaq.com.bd/823230/%E0%A6%A6%E0%A7%80%E0%A6%B0%E0%A7%8D%E0%A6%98-%E0%A6%86%E0%A6%87%E0%A6%A8%E0%A6%BF-%E0%A6%B2%E0%A7%9C%E0%A6%BE%E0%A6%87%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A6%9D%E0%A7%8B%E0%A6%A4%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A7%8D%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A1-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BF%E0%A6%A8%E0%A6%BE</guid>
      <pubDate>Fri, 27 Nov 2026 12:01:23 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/dfdc9f7280efadd205cd8838161a199e-6b091c78010f9.jpg?jadewits_media_id=325120" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/dfdc9f7280efadd205cd8838161a199e-6b091c78010f9.jpg?jadewits_media_id=325120" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/dfdc9f7280efadd205cd8838161a199e-6b091c78010f9.jpg?jadewits_media_id=325120" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দীর্ঘ আইনি লড়াইয়ের পর সমঝোতায় ব্র্যাড-অ্যাঞ্জেলিনা" /&gt;&lt;/p&gt;&lt;p&gt;দীর্ঘ আইনি লড়াইয়ের পর অবশেষে সমঝোতায় পৌঁছালেন ব্র্যাড পিট ও অ্যাঞ্জেলিনা জোলি। বিচ্ছেদের পর ফ্রান্সের বিখ্যাত ওয়াইনারি &amp;lsquo;শ্যাটো মিরাভাল&amp;rsquo;-এর মালিকানা ও শেয়ার বিক্রি নিয়ে চলা তিক্ত বিরোধ আদালতের বাইরেই মিটিয়ে নিয়েছেন হলিউডের এই সাবেক তারকা জুটি।
যুক্তরাষ্ট্রের সংবাদমাধ্যমে দেওয়া এক যৌথ বিবৃ&lt;/p&gt;</description>

    <item>
      <title>অনুমতি ছাড়া বিদেশে অবস্থান, ঢাকা বিশ্ববিদ্যালয়ের দুই শিক্ষক সাময়িক বরখাস্ত</title>
      <link>https://www.ittefaq.com.bd/822844/%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AE%E0%A6%A4%E0%A6%BF-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822844/%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AE%E0%A6%A4%E0%A6%BF-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Tue, 24 Nov 2026 21:20:39 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/e8b0af32d9a19b138a3574bc077f533e-6b05a91a3efd9.jpg?jadewits_media_id=324686" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/e8b0af32d9a19b138a3574bc077f533e-6b05a91a3efd9.jpg?jadewits_media_id=324686" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/e8b0af32d9a19b138a3574bc077f533e-6b05a91a3efd9.jpg?jadewits_media_id=324686" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অনুমতি ছাড়া বিদেশে অবস্থান, ঢাকা বিশ্ববিদ্যালয়ের দুই শিক্ষক সাময়িক বরখাস্ত" /&gt;&lt;/p&gt;&lt;p&gt;অনুমতি ছাড়া দেশের বাইরে অবস্থান করায় ঢাকা বিশ্ববিদ্যালয়ের (ঢাবি) দুই শিক্ষককে সাময়িক বরখাস্ত করা হয়েছে।&amp;nbsp;
একই সঙ্গে ছুটির মেয়াদ শেষ হওয়ার পরও কর্মস্থলে যোগ না দেওয়ায় বিশ্ববিদ্যালয়ের সাবেক উপাচার্য অধ্যাপক মো. মাকসুদ কামাল ও আইন বিভাগের প্রভাষক শাহরিমা তানজিন অর্নিকে সাত কর্মদিবসের মধ্যে বিশ্ববিদ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822844/%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AE%E0%A6%A4%E0%A6%BF-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>মৃত্যুর দৃশ্যধারণের আগেই মারা গেলেন অভিনেতা</title>
      <link>https://www.ittefaq.com.bd/822843/%E2%80%98%E0%A6%8F%E0%A6%95%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A6%AC-%E0%A6%AD%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%AF%E0%A6%BE%E0%A6%AC%E0%A7%87%E2%80%99-%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%A6%E0%A7%83%E0%A6%B6%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%87%E0%A6%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822843/%E2%80%98%E0%A6%8F%E0%A6%95%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A6%AC-%E0%A6%AD%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%AF%E0%A6%BE%E0%A6%AC%E0%A7%87%E2%80%99-%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%A6%E0%A7%83%E0%A6%B6%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%87%E0%A6%87</guid>
      <pubDate>Tue, 24 Nov 2026 22:30:11 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/0405a2acf3d60728153bf64723784d04-6b05aa3e16166.jpg?jadewits_media_id=324687" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/0405a2acf3d60728153bf64723784d04-6b05aa3e16166.jpg?jadewits_media_id=324687" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/0405a2acf3d60728153bf64723784d04-6b05aa3e16166.jpg?jadewits_media_id=324687" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মৃত্যুর দৃশ্যধারণের আগেই মারা গেলেন অভিনেতা" /&gt;&lt;/p&gt;&lt;p&gt;‘নসীব’ সিনেমায় চার খলচরিত্রের একজন ছিলেন অভিনেতা সোহেল খান। গল্পের প্রয়োজনে তার চরিত্রটির মৃত্যুর দৃশ্য ধারণ করার কথা ছিল। কিন্তু সেই দৃশ্যের শুটিং শুরুর আগেই পৃথিবী থেকে বিদায় নিলেন ৬৬ বছর বয়সী এই অভিনেতা। তার মৃত্যুতে থমকে গেছে সিনেমাটির শুটিং ইউনিট।
পরিচালক মোহাম্মদ ইকবাল জানিয়েছেন, সোহেল খানের আ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822843/%E2%80%98%E0%A6%8F%E0%A6%95%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A6%AC-%E0%A6%AD%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%AF%E0%A6%BE%E0%A6%AC%E0%A7%87%E2%80%99-%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%A6%E0%A7%83%E0%A6%B6%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%87%E0%A6%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>কক্সবাজারে বাস-সিএনজি মুখোমুখি সংঘর্ষে নিহত ৫</title>
      <link>https://www.ittefaq.com.bd/822842/%E0%A6%95%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B8-%E0%A6%B8%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%9C%E0%A6%BF-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%8B%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A6%BF-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A7%AB</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822842/%E0%A6%95%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B8-%E0%A6%B8%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%9C%E0%A6%BF-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%8B%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A6%BF-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A7%AB</guid>
      <pubDate>Tue, 24 Nov 2026 21:06:22 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/c0ac2dec0e97ffa84c204e6d301a2561-6b05a7cc747bc.jpg?jadewits_media_id=324685" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/c0ac2dec0e97ffa84c204e6d301a2561-6b05a7cc747bc.jpg?jadewits_media_id=324685" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/c0ac2dec0e97ffa84c204e6d301a2561-6b05a7cc747bc.jpg?jadewits_media_id=324685" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কক্সবাজারে বাস-সিএনজি মুখোমুখি সংঘর্ষে নিহত ৫" /&gt;&lt;/p&gt;&lt;p&gt;কক্সবাজারের ঈদগাঁওয়ে যাত্রীবাহী বাস ও সিএনজিচালিত অটোরিকশার মুখোমুখি সংঘর্ষে পাঁচজন নিহত হয়েছেন। মঙ্গলবার (২৪ নভেম্বর) সন্ধ্যা ৭টার দিকে কক্সবাজার-চট্টগ্রাম মহাসড়কের ঈদগাঁও থানা এলাকার ফকিরাবাজারে এ দুর্ঘটনা ঘটে।
নিহতরা হলেন- চকরিয়ার খুটাখালীর সাহাব উদ্দিন (৪৩), লামা এলাকার বাসিন্দা ও পটিয়া মাদ্রাসা&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822842/%E0%A6%95%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B8-%E0%A6%B8%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%9C%E0%A6%BF-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%8B%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A6%BF-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A7%AB">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>রাজধানীর ৩০০ ফিটে ‘ডাকাতি’র ভিডিও ভাইরাল, আসলে কী ঘটেছিল</title>
      <link>https://www.ittefaq.com.bd/822841/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A7%A9%E0%A7%A6%E0%A7%A6-%E0%A6%AB%E0%A6%BF%E0%A6%9F%E0%A7%87-%E2%80%98%E0%A6%A1%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%A4%E0%A6%BF%E2%80%99%E0%A6%B0-%E0%A6%AD%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A6%93-%E0%A6%AD%E0%A6%BE%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%B2-%E0%A6%86%E0%A6%B8%E0%A6%B2%E0%A7%87-%E0%A6%95%E0%A7%80</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822841/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A7%A9%E0%A7%A6%E0%A7%A6-%E0%A6%AB%E0%A6%BF%E0%A6%9F%E0%A7%87-%E2%80%98%E0%A6%A1%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%A4%E0%A6%BF%E2%80%99%E0%A6%B0-%E0%A6%AD%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A6%93-%E0%A6%AD%E0%A6%BE%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%B2-%E0%A6%86%E0%A6%B8%E0%A6%B2%E0%A7%87-%E0%A6%95%E0%A7%80</guid>
      <pubDate>Tue, 24 Nov 2026 21:00:03 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/f5f5dff9b0df8a786ac9db43ad2a08a8-6b05a61f2f97f.jpg?jadewits_media_id=324684" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/f5f5dff9b0df8a786ac9db43ad2a08a8-6b05a61f2f97f.jpg?jadewits_media_id=324684" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/f5f5dff9b0df8a786ac9db43ad2a08a8-6b05a61f2f97f.jpg?jadewits_media_id=324684" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজধানীর ৩০০ ফিটে ‘ডাকাতি’র ভিডিও ভাইরাল, আসলে কী ঘটেছিল" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর ৩০০ ফুট সড়ক। মধ্যরাতে সড়কের একটি চেকপোস্টে একটি প্রাইভেট কার আটকের চেষ্টা করছেন কয়েকজন যুবক। গাড়িটি না থামানোয় বাইরে থেকে যুবকেরা লাঠিসোঁটা দিয়ে ভাঙচুর করছেন। এমনকি গাড়ির ভেতরে থাকা ব্যক্তিরা চিৎকার করে ভাঙচুর না করার আকুতি জানাচ্ছেন। 
একপর্যায়ে চেকপোস্টে না থেমে দ্রুতগতিতে চলে যায় গাড়িটি।

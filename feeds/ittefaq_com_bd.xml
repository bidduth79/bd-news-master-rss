      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/3a8918d8e3f9da9647afe551b8edd2b9-6af35bdbda309.jpg?jadewits_media_id=322029" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/3a8918d8e3f9da9647afe551b8edd2b9-6af35bdbda309.jpg?jadewits_media_id=322029" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/3a8918d8e3f9da9647afe551b8edd2b9-6af35bdbda309.jpg?jadewits_media_id=322029" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হাসিবের ওপর হামলার প্রতিবাদ, স্বরাষ্ট্রমন্ত্রীর পদত্যাগসহ ৩ দাবি ছাত্রশক্তির" /&gt;&lt;/p&gt;&lt;p&gt;জুলাই গণঅভ্যুত্থানের অন্যতম সমন্বয়ক ও জাতীয় ছাত্রশক্তির ঢাকা বিশ্ববিদ্যালয় শাখার সভাপতি হাসিব আল ইসলামের ওপর হামলার ঘটনায় জড়িত ব্যক্তিদের গ্রেপ্তার ও বিচারের দাবি জানিয়েছে সংগঠনটি। একই সঙ্গে আইনশৃঙ্খলা পরিস্থিতির অবনতির দায়ে স্বরাষ্ট্রমন্ত্রীর পদত্যাগ এবং নিষিদ্ধ আওয়ামী লীগ ও ছাত্রলীগের নেতাকর্মীদের&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820243/%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%A6-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0">দৈনিক ইত্তেফাক</source>

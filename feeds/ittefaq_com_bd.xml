      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/18c8d0e1bda6964eb74795a61c5551ff-6af4b88701978.jpg?jadewits_media_id=322242" length="0" type="image/jpeg" />

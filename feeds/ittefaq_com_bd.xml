    <item>
      <title>আন্তালিয়ায় তারেক রহমান–এরদোয়ান দ্বিপক্ষীয় বৈঠক: প্রতিরক্ষা, বাণিজ্য ও রোহিঙ্গা ইস্যুতে আলোচনা</title>
      <link>https://www.ittefaq.com.bd/820251/%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%B0%E0%A6%B9%E0%A6%AE%E0%A6%BE%E0%A6%A8%E2%80%93%E0%A6%8F%E0%A6%B0%E0%A6%A6%E0%A7%8B%E0%A7%9F%E0%A6%BE%E0%A6%A8-%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%80%E0%A6%AF%E0%A6%BC-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820251/%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%B0%E0%A6%B9%E0%A6%AE%E0%A6%BE%E0%A6%A8%E2%80%93%E0%A6%8F%E0%A6%B0%E0%A6%A6%E0%A7%8B%E0%A7%9F%E0%A6%BE%E0%A6%A8-%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%80%E0%A6%AF%E0%A6%BC-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95</guid>
      <pubDate>Wed, 11 Nov 2026 01:59:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/934ea57537e23b294497259bc8293c1a-6af3740263cb8.jpg?jadewits_media_id=322037" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/934ea57537e23b294497259bc8293c1a-6af3740263cb8.jpg?jadewits_media_id=322037" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/934ea57537e23b294497259bc8293c1a-6af3740263cb8.jpg?jadewits_media_id=322037" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আন্তালিয়ায় তারেক রহমান–এরদোয়ান দ্বিপক্ষীয় বৈঠক: প্রতিরক্ষা, বাণিজ্য ও রোহিঙ্গা ইস্যুতে আলোচনা" /&gt;&lt;/p&gt;&lt;p&gt;তুরস্কের উপকূলীয় শহর আন্তালিয়ায় বাংলাদেশের প্রধানমন্ত্রী তারেক রহমান ও তুরস্কের প্রেসিডেন্ট রিসেপ তাইয়েপ এরদোয়ানের মধ্যে এক গুরুত্বপূর্ণ দ্বিপক্ষীয় বৈঠক অনুষ্ঠিত হয়েছে। স্থানীয় সময় মঙ্গলবার (১০ নভেম্বর) সন্ধ্যায় আন্তালিয়ার ম্যাক্স রয়েল হোটেলে এ বৈঠক অনুষ্ঠিত হয়। জলবায়ু পরিবর্তনবিষয়ক জাত&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820251/%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%B0%E0%A6%B9%E0%A6%AE%E0%A6%BE%E0%A6%A8%E2%80%93%E0%A6%8F%E0%A6%B0%E0%A6%A6%E0%A7%8B%E0%A7%9F%E0%A6%BE%E0%A6%A8-%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%80%E0%A6%AF%E0%A6%BC-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95">দৈনিক ইত্তেফাক</source>
    </item>
    <item>

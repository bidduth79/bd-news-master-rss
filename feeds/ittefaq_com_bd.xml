    <item>
      <title>জাতীয় প্রাণিসম্পদ পদক পেল আকিজ এগ্রো ফিড</title>
      <link>https://www.ittefaq.com.bd/823165/%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3%E0%A6%BF%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%A6-%E0%A6%AA%E0%A6%A6%E0%A6%95-%E0%A6%AA%E0%A7%87%E0%A6%B2-%E0%A6%86%E0%A6%95%E0%A6%BF%E0%A6%9C-%E0%A6%8F%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%8B-%E0%A6%AB%E0%A6%BF%E0%A6%A1</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823165/%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3%E0%A6%BF%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%A6-%E0%A6%AA%E0%A6%A6%E0%A6%95-%E0%A6%AA%E0%A7%87%E0%A6%B2-%E0%A6%86%E0%A6%95%E0%A6%BF%E0%A6%9C-%E0%A6%8F%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%8B-%E0%A6%AB%E0%A6%BF%E0%A6%A1</guid>
      <pubDate>Thu, 26 Nov 2026 20:44:49 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/01617d998705498b18be07e93b55f8bd-6b0845ba5446e.jpg?jadewits_media_id=325050" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/01617d998705498b18be07e93b55f8bd-6b0845ba5446e.jpg?jadewits_media_id=325050" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/01617d998705498b18be07e93b55f8bd-6b0845ba5446e.jpg?jadewits_media_id=325050" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জাতীয় প্রাণিসম্পদ পদক পেল আকিজ এগ্রো ফিড" /&gt;&lt;/p&gt;&lt;p&gt;জাতীয় পর্যায়ে প্রাণিসম্পদ খাতে অবদানের স্বীকৃতিস্বরূপ &amp;lsquo;জাতীয় প্রাণিসম্পদ পদক ২০২৬&amp;rsquo; অর্জন করেছে আকিজ এগ্রো ফিড লিমিটেড। দেশের প্রাণিসম্পদ খাতের উন্নয়ন, মানসম্মত প্রাণিখাদ্য উৎপাদন, প্রক্রিয়াজাতকরণ ও বাজারজাতকরণে গুরুত্বপূর্ণ অবদানের স্বীকৃতিস্বরূপ রৌপ্য পদক অর্জন করল দেশের অন্যতম শীর্ষস্থ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823165/%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3%E0%A6%BF%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%A6-%E0%A6%AA%E0%A6%A6%E0%A6%95-%E0%A6%AA%E0%A7%87%E0%A6%B2-%E0%A6%86%E0%A6%95%E0%A6%BF%E0%A6%9C-%E0%A6%8F%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%8B-%E0%A6%AB%E0%A6%BF%E0%A6%A1">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>শেখ হাসিনার সাবেক উপপ্রেস সচিব সাখাওয়াত মুনসহ ৩ জন কারাগারে</title>
      <link>https://www.ittefaq.com.bd/823164/%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%89%E0%A6%AA%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B8-%E0%A6%B8%E0%A6%9A%E0%A6%BF%E0%A6%AC-%E0%A6%B8%E0%A6%BE%E0%A6%96%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%A4-%E0%A6%AE%E0%A7%81%E0%A6%A8%E0%A6%B8%E0%A6%B9-%E0%A7%A9-%E0%A6%9C%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823164/%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%89%E0%A6%AA%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B8-%E0%A6%B8%E0%A6%9A%E0%A6%BF%E0%A6%AC-%E0%A6%B8%E0%A6%BE%E0%A6%96%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%A4-%E0%A6%AE%E0%A7%81%E0%A6%A8%E0%A6%B8%E0%A6%B9-%E0%A7%A9-%E0%A6%9C%E0%A6%A8</guid>
      <pubDate>Thu, 26 Nov 2026 20:41:29 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/74c2868296a8f94558552cbfb287db7a-6b0842ab01dcd.jpg?jadewits_media_id=325045" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/74c2868296a8f94558552cbfb287db7a-6b0842ab01dcd.jpg?jadewits_media_id=325045" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/74c2868296a8f94558552cbfb287db7a-6b0842ab01dcd.jpg?jadewits_media_id=325045" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শেখ হাসিনার সাবেক উপপ্রেস সচিব সাখাওয়াত মুনসহ ৩ জন কারাগারে" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর মোহাম্মদপুর থানায় সন্ত্রাসবিরোধী আইনে দায়ের করা মামলায় গ্রেপ্তার ক্ষমতাচ্যুত প্রধানমন্ত্রী শেখ হাসিনার সাবেক উপপ্রেস সচিব কে এম সাখাওয়াত মুনসহ তিনজনকে কারাগারে পাঠানোর আদেশ দিয়েছেন আদালত।
বৃহস্পতিবার (২৬ নভেম্বর) পুলিশের আবেদনের প্রেক্ষিতে ঢাকা মেট্রোপলিটন ম্যাজিস্ট্রেট কামাল উদ্দীনের আদালত&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823164/%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%89%E0%A6%AA%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B8-%E0%A6%B8%E0%A6%9A%E0%A6%BF%E0%A6%AC-%E0%A6%B8%E0%A6%BE%E0%A6%96%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%A4-%E0%A6%AE%E0%A7%81%E0%A6%A8%E0%A6%B8%E0%A6%B9-%E0%A7%A9-%E0%A6%9C%E0%A6%A8">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>এবার পিতৃত্বকালীন ছুটি চালু করল থালাপতি বিজয়ের সরকার</title>
      <link>https://www.ittefaq.com.bd/823163/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%BF%E0%A6%A4%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A6%95%E0%A6%BE%E0%A6%B2%E0%A7%80%E0%A6%A8-%E0%A6%9B%E0%A7%81%E0%A6%9F%E0%A6%BF-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A7%81-%E0%A6%95%E0%A6%B0%E0%A6%B2-%E0%A6%A5%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%AA%E0%A6%A4%E0%A6%BF-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A7%9F%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823163/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%BF%E0%A6%A4%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A6%95%E0%A6%BE%E0%A6%B2%E0%A7%80%E0%A6%A8-%E0%A6%9B%E0%A7%81%E0%A6%9F%E0%A6%BF-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A7%81-%E0%A6%95%E0%A6%B0%E0%A6%B2-%E0%A6%A5%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%AA%E0%A6%A4%E0%A6%BF-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A7%9F%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Thu, 26 Nov 2026 20:40:31 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/e9a93288f65657141d48bd6e8d20dbbc-6b0842e3250d1.jpg?jadewits_media_id=325046" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/e9a93288f65657141d48bd6e8d20dbbc-6b0842e3250d1.jpg?jadewits_media_id=325046" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/e9a93288f65657141d48bd6e8d20dbbc-6b0842e3250d1.jpg?jadewits_media_id=325046" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এবার পিতৃত্বকালীন ছুটি চালু করল থালাপতি বিজয়ের সরকার" /&gt;&lt;/p&gt;&lt;p&gt;ভারতের তামিলনাড়ু রাজ্যে পুরুষ সরকারি কর্মীদের জন্য ১৫ দিনের পিতৃত্বকালীন ছুটি ঘোষণা করেছেন মুখ্যমন্ত্রী থালাপতি বিজয়। বৃহস্পতিবার (২৬ নভেম্বর) রাজ্যে প্রথমবারের মতো এই ছুটি চালুর ঘোষণা দেন তিনি।
নতুন নিয়ম অনুযায়ী, বিবাহিত পুরুষ সরকারি কর্মীরা সন্তানের সম্ভাব্য জন্মতারিখের ১৫ দিন আগে থেকে অথবা সন্তান&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823163/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%BF%E0%A6%A4%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A6%95%E0%A6%BE%E0%A6%B2%E0%A7%80%E0%A6%A8-%E0%A6%9B%E0%A7%81%E0%A6%9F%E0%A6%BF-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A7%81-%E0%A6%95%E0%A6%B0%E0%A6%B2-%E0%A6%A5%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%AA%E0%A6%A4%E0%A6%BF-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A7%9F%E0%A7%87%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>‘সাংবাদিকতায় মানসিক চাপ ও ট্রমা ব্যবস্থাপনা’ শীর্ষক প্রশিক্ষণ কর্মসূচির পঞ্চম সেশন অনুষ্ঠিত</title>
      <link>https://www.ittefaq.com.bd/823162/%E2%80%98%E0%A6%B8%E0%A6%BE%E0%A6%82%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A6%BF%E0%A6%95%E0%A6%A4%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%95-%E0%A6%9A%E0%A6%BE%E0%A6%AA-%E0%A6%93-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BE-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%AA%E0%A6%A8%E0%A6%BE%E2%80%99</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823162/%E2%80%98%E0%A6%B8%E0%A6%BE%E0%A6%82%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A6%BF%E0%A6%95%E0%A6%A4%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%95-%E0%A6%9A%E0%A6%BE%E0%A6%AA-%E0%A6%93-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BE-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%AA%E0%A6%A8%E0%A6%BE%E2%80%99</guid>
      <pubDate>Thu, 26 Nov 2026 20:40:12 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/c3c86cc3fb8c4a932ed398a5fac8868b-6b0844c91a66c.jpg?jadewits_media_id=325049" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/c3c86cc3fb8c4a932ed398a5fac8868b-6b0844c91a66c.jpg?jadewits_media_id=325049" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/c3c86cc3fb8c4a932ed398a5fac8868b-6b0844c91a66c.jpg?jadewits_media_id=325049" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘সাংবাদিকতায় মানসিক চাপ ও ট্রমা ব্যবস্থাপনা’ শীর্ষক প্রশিক্ষণ কর্মসূচির পঞ্চম সেশন অনুষ্ঠিত" /&gt;&lt;/p&gt;&lt;p&gt;সাংবাদিকতায় মানসিক চাপ ও ট্রমা মোকাবিলার পাশাপাশি কর্মক্ষেত্রে নারী সাংবাদিকদের বিভিন্ন চ্যালেঞ্জ নিয়ে স্টামফোর্ড ইউনিভার্সিটি বাংলাদেশে ‘ম্যানেজিং স্ট্রেস অ্যান্ড ট্রমা ইন জার্নালিজম’ বা ‘সাংবাদিকতায় মানসিক চাপ ও ট্রমা ব্যবস্থাপনা’ শীর্ষক প্রশিক্ষণ কর্মসূচির অনুষ্ঠিত হয়েছে।
সুইডেনের লিনিয়াস ইউনিভা&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823162/%E2%80%98%E0%A6%B8%E0%A6%BE%E0%A6%82%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A6%BF%E0%A6%95%E0%A6%A4%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%95-%E0%A6%9A%E0%A6%BE%E0%A6%AA-%E0%A6%93-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BE-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%AA%E0%A6%A8%E0%A6%BE%E2%80%99">দৈনিক ইত্তেফাক</source>

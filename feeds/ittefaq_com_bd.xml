      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/1eae5aaf26a1d28e93721d1f4aac9b73-6b08428f9c2d9.jpg?jadewits_media_id=325044" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/1eae5aaf26a1d28e93721d1f4aac9b73-6b08428f9c2d9.jpg?jadewits_media_id=325044" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অস্ট্রেলিয়ান ওপেন থেকে ছিটকে গেলেন দুইবারের চ্যাম্পিয়ন সিনার" /&gt;&lt;/p&gt;&lt;p&gt;ডান হাঁটুতে অস্ত্রোপচারের পর পুনর্বাসন প্রক্রিয়ায় থাকায় আগামী জানুয়ারিতে অস্ট্রেলিয়ান ওপেনে খেলতে পারবেন না বিশ্ব র&amp;zwnj;্যাংকিংয়ের দুই নম্বর খেলোয়াড় ইয়ানিক সিনার। ইতালির এই টেনিস তারকা ২০২৪ ও ২০২৫ সালে মৌসুমের প্রথম গ্র্যান্ড স্ল্যাম জিতেছিলেন। চলতি সপ্তাহে তিনি জানান, ফিনল্যান্ডের একটি ক্লিনিকে তা&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823160/%E0%A6%85%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8-%E0%A6%93%E0%A6%AA%E0%A7%87%E0%A6%A8-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%9B%E0%A6%BF%E0%A6%9F%E0%A6%95%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%A6%E0%A7%81%E0%A6%87%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>ককরোচ নেতা সৌরভের বিরুদ্ধে ‘লুক আউট সার্কুলার’ জারি</title>

      <guid isPermaLink="true">https://www.ittefaq.com.bd/821718/%E0%A6%B8%E0%A6%BE%E0%A6%A6%E0%A6%BE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%87%E0%A6%AD%E0%A7%87%E0%A6%9F-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E2%80%98%E0%A6%B0%E0%A6%B9%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A6%9C%E0%A6%A8%E0%A6%95-%E0%A6%9A%E0%A6%95%E0%A7%8D%E0%A6%95%E0%A6%B0%E0%A7%87%E0%A6%B0%E2%80%99-%E0%A6%AA%E0%A6%B0-%E0%A6%87%E0%A6%89%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%A8</guid>
      <pubDate>Wed, 18 Nov 2026 18:05:10 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/42e8c74747b49f2f0cb652a17cdad917-6afd943d534a8.jpg?jadewits_media_id=323548" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/42e8c74747b49f2f0cb652a17cdad917-6afd943d534a8.jpg?jadewits_media_id=323548" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/42e8c74747b49f2f0cb652a17cdad917-6afd943d534a8.jpg?jadewits_media_id=323548" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাদা প্রাইভেট কারের ‘রহস্যজনক চক্করের’ পর ইউনিয়ন পরিষদসহ দুই স্থাপনায় আগুন" /&gt;&lt;/p&gt;&lt;p&gt;পিরোজপুরের নাজিরপুরে গভীর রাতে আগুনে পুড়েছে পাঁচটি ব্যবসা প্রতিষ্ঠান। এ ছাড়া একটি ইউনিয়ন পরিষদ পুড়িয়ে দেওয়ার চেষ্টা করেছে দুর্বৃত্তরা। একটি সাদা প্রাইভেটকারের রহস্যজনক চক্করের পর মাত্র এক ঘণ্টার ব্যবধানে পৃথক দুটি স্থানে এই অগ্নিকাণ্ডের সূত্রপাত হয়েছে বলে জানিয়েছেন স্থানীয়রা।
বুধবার (১৮ নভেম্বর) বিষ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821718/%E0%A6%B8%E0%A6%BE%E0%A6%A6%E0%A6%BE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%87%E0%A6%AD%E0%A7%87%E0%A6%9F-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E2%80%98%E0%A6%B0%E0%A6%B9%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A6%9C%E0%A6%A8%E0%A6%95-%E0%A6%9A%E0%A6%95%E0%A7%8D%E0%A6%95%E0%A6%B0%E0%A7%87%E0%A6%B0%E2%80%99-%E0%A6%AA%E0%A6%B0-%E0%A6%87%E0%A6%89%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%A8">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>বিশ্ব ভ্রমণে বেরিয়ে ইসলাম ধর্ম গ্রহণ করলেন চীনা দম্পতি</title>
      <link>https://www.ittefaq.com.bd/821715/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC-%E0%A6%AD%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%A3%E0%A7%87-%E0%A6%AC%E0%A7%87%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%87%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE-%E0%A6%A7%E0%A6%B0%E0%A7%8D%E0%A6%AE-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%B9%E0%A6%A3-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%9A%E0%A7%80%E0%A6%A8%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821715/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC-%E0%A6%AD%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%A3%E0%A7%87-%E0%A6%AC%E0%A7%87%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%87%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE-%E0%A6%A7%E0%A6%B0%E0%A7%8D%E0%A6%AE-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%B9%E0%A6%A3-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%9A%E0%A7%80%E0%A6%A8%E0%A6%BE</guid>
      <pubDate>Wed, 18 Nov 2026 18:00:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/4ae0ecf36f7a070b4fa687dc3cb7efc5-6afd927a14d69.jpg?jadewits_media_id=323545" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/4ae0ecf36f7a070b4fa687dc3cb7efc5-6afd927a14d69.jpg?jadewits_media_id=323545" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/4ae0ecf36f7a070b4fa687dc3cb7efc5-6afd927a14d69.jpg?jadewits_media_id=323545" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিশ্ব ভ্রমণে বেরিয়ে ইসলাম ধর্ম গ্রহণ করলেন চীনা দম্পতি" /&gt;&lt;/p&gt;&lt;p&gt;চাকরি ছেড়ে বিশ্বভ্রমণে বেরিয়ে ইন্দোনেশিয়া থেকে তুরস্কে পৌঁছানো এক চীনা দম্পতির জীবন বদলে গেছে এক অপ্রত্যাশিত পরিচয়ে। তুরস্কের আনতালিয়া শহরে একটি তুর্কি পরিবারের সঙ্গে সাক্ষাতের পর তাদের আতিথেয়তা, আন্তরিকতা এবং পবিত্র কোরআনের সংস্পর্শে এসে ইসলাম ধর্ম গ্রহণ করেছেন আট বছরের সংসার জীবনের এই দম্পতি।&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821715/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC-%E0%A6%AD%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%A3%E0%A7%87-%E0%A6%AC%E0%A7%87%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%87%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE-%E0%A6%A7%E0%A6%B0%E0%A7%8D%E0%A6%AE-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%B9%E0%A6%A3-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%9A%E0%A7%80%E0%A6%A8%E0%A6%BE">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>আগুনে পুড়ে ছাই বাড়ি, লুটপাটের চিহ্ন গোপালগঞ্জের এমপি জিলানীর বাড়িতে</title>
      <link>https://www.ittefaq.com.bd/821717/%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A7%9C%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A6%87-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%B2%E0%A7%81%E0%A6%9F%E0%A6%AA%E0%A6%BE%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%BF%E0%A6%B9%E0%A7%8D%E0%A6%A8-%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821717/%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A7%9C%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A6%87-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%B2%E0%A7%81%E0%A6%9F%E0%A6%AA%E0%A6%BE%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%BF%E0%A6%B9%E0%A7%8D%E0%A6%A8-%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Wed, 18 Nov 2026 17:59:49 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/cfd253cddd7c195a3fcb3ebb7bb3df31-6afd92b2dae86.jpg?jadewits_media_id=323547" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/cfd253cddd7c195a3fcb3ebb7bb3df31-6afd92b2dae86.jpg?jadewits_media_id=323547" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/cfd253cddd7c195a3fcb3ebb7bb3df31-6afd92b2dae86.jpg?jadewits_media_id=323547" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আগুনে পুড়ে ছাই বাড়ি, লুটপাটের চিহ্ন গোপালগঞ্জের এমপি জিলানীর বাড়িতে" /&gt;&lt;/p&gt;&lt;p&gt;আগুনে পুড়ে যাওয়া ঘরের মেঝেতে তখনো জ্বলছিল আগুন। চারদিকে ছড়িয়ে ছিল পোড়া আসবাব, ট্রাঙ্ক, স্যুটকেস ও গৃহস্থালির জিনিসপত্র। টিনের চাল কালো হয়ে গেছে আগুনে। কোনো ঘরের দেয়াল টিকে থাকলেও ভেতরে আসবাবের কিছুই অবশিষ্ট নেই। পুড়ে গেছে গোয়ালঘর, খড়ের পালা এবং ঘরে রাখা ধান-চাল। ধ্বংসস্তূপের পাশে বসে বিলাপ করছিলেন এ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821717/%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A7%9C%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A6%87-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%B2%E0%A7%81%E0%A6%9F%E0%A6%AA%E0%A6%BE%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%BF%E0%A6%B9%E0%A7%8D%E0%A6%A8-%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>মেট্রোরেলে ‘আমরা করব জয়’ গেয়ে ভাইরাল: বাবার বিরুদ্ধে প্রতারণার ভয়াবহ অভিযোগ</title>
      <link>https://www.ittefaq.com.bd/821716/%E0%A6%AE%E0%A7%87%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B0%E0%A7%87%E0%A6%B2%E0%A7%87-%E2%80%98%E0%A6%86%E0%A6%AE%E0%A6%B0%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%AC-%E0%A6%9C%E0%A7%9F%E2%80%99-%E0%A6%97%E0%A7%87%E0%A7%9F%E0%A7%87-%E0%A6%AD%E0%A6%BE%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%B2-%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821716/%E0%A6%AE%E0%A7%87%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B0%E0%A7%87%E0%A6%B2%E0%A7%87-%E2%80%98%E0%A6%86%E0%A6%AE%E0%A6%B0%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%AC-%E0%A6%9C%E0%A7%9F%E2%80%99-%E0%A6%97%E0%A7%87%E0%A7%9F%E0%A7%87-%E0%A6%AD%E0%A6%BE%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%B2-%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Wed, 18 Nov 2026 18:18:16 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/015e0cda175dca5088520d1b73bb8cdd-6afd9273b46ee.jpg?jadewits_media_id=323544" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/015e0cda175dca5088520d1b73bb8cdd-6afd9273b46ee.jpg?jadewits_media_id=323544" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/015e0cda175dca5088520d1b73bb8cdd-6afd9273b46ee.jpg?jadewits_media_id=323544" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মেট্রোরেলে ‘আমরা করব জয়’ গেয়ে ভাইরাল: বাবার বিরুদ্ধে প্রতারণার ভয়াবহ অভিযোগ" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর মেট্রোরেলে ‘আমরা করব জয়’ গান গেয়ে সামাজিক যোগাযোগমাধ্যমে ভাইরাল হওয়া সেই দুই শিশুর বাবার পরিচয় শনাক্ত হয়েছে। ফিরোজ খান রনি নামের ওই ব্যক্তির বিরুদ্ধে ইতিপূর্বে সহায়তা হিসেবে পাওয়া অটোরিকশা বিক্রি করে দেওয়া, একাধিক বিয়ে এবং শিশুদের ব্যবহার করে ভিক্ষাবৃত্তির অভিযোগ উঠেছে।
ঝালকাঠির স্থায়ী বাসি&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821716/%E0%A6%AE%E0%A7%87%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B0%E0%A7%87%E0%A6%B2%E0%A7%87-%E2%80%98%E0%A6%86%E0%A6%AE%E0%A6%B0%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%AC-%E0%A6%9C%E0%A7%9F%E2%80%99-%E0%A6%97%E0%A7%87%E0%A7%9F%E0%A7%87-%E0%A6%AD%E0%A6%BE%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%B2-%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B0">দৈনিক ইত্তেফাক</source>

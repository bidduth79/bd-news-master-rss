      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/437fb04135b489c716e4d87cd6137784-6b07a010a9406.jpg?jadewits_media_id=324916" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/437fb04135b489c716e4d87cd6137784-6b07a010a9406.jpg?jadewits_media_id=324916" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/437fb04135b489c716e4d87cd6137784-6b07a010a9406.jpg?jadewits_media_id=324916" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শেখ হাসিনা দেশে ফিরছেন না, জয়সওয়ালের কথায় তা স্পষ্ট: রাশেদ খাঁন" /&gt;&lt;/p&gt;&lt;p&gt;প্রধানমন্ত্রীর রাজনৈতিক সহকারী রাশেদ খাঁন দাবি করেছেন, ভারতের পররাষ্ট্র মন্ত্রণালয়ের মুখপাত্র রণধীর জয়সওয়ালের বক্তব্যে বাংলাদেশের সাবেক প্রধানমন্ত্রী ও দণ্ডপ্রাপ্ত শেখ হাসিনার দেশে ফেরার বিষয়টি অনেকটাই স্পষ্ট হয়েছে। ভারত মৃত্যুদণ্ড কার্যকরের জন্য শেখ হাসিনাকে বাংলাদেশে ফেরত পাঠাবে না বলেই মনে করছেন &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823042/%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%A8%E0%A6%BE-%E0%A6%9C%E0%A7%9F%E0%A6%B8%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%A5%E0%A6%BE%E0%A7%9F-%E0%A6%A4%E0%A6%BE">দৈনিক ইত্তেফাক</source>

    <item>
      <title>এবার সাইফ আলি খানকে প্রাণনাশের হুমকি</title>
      <link>https://www.ittefaq.com.bd/821895/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%AB-%E0%A6%86%E0%A6%B2%E0%A6%BF-%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%95%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821895/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%AB-%E0%A6%86%E0%A6%B2%E0%A6%BF-%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%95%E0%A6%BF</guid>
      <pubDate>Thu, 19 Nov 2026 16:12:01 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/590fd2328a6570b0a587c93a363a95cf-6afec997e7986.jpg?jadewits_media_id=323724" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/590fd2328a6570b0a587c93a363a95cf-6afec997e7986.jpg?jadewits_media_id=323724" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/590fd2328a6570b0a587c93a363a95cf-6afec997e7986.jpg?jadewits_media_id=323724" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এবার সাইফ আলি খানকে প্রাণনাশের হুমকি" /&gt;&lt;/p&gt;&lt;p&gt;বেশ কয়েকদিন ধরেই একের পর এক বলিউড তারকা প্রাণনাশের হুমকি পাচ্ছেন। এবার সেই তালিকায় যুক্ত হয়েছে অভিনেতা সাইফ আলি খানের নাম। সংবাদ সংস্থা আইএএনএস এ তথ্য জানিয়েছে।
সূত্রের বরাদে ভারতীয় সংবাদমাধ্যম জানিয়েছে, সাইফের কাছে ফোন এসেছে ২০২৪ সালে বাবা সিদ্দিকি হত্যা মামলার পলাতক অভিযুক্ত জিশান আখতারের কাছ থেকে&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821895/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%AB-%E0%A6%86%E0%A6%B2%E0%A6%BF-%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%95%E0%A6%BF">দৈনিক ইত্তেফাক</source>
    </item>

    <item>
      <title>নিষেধাজ্ঞা দিয়েও পাকিস্তানি নাটক থেকে দূরে রাখা যাচ্ছে না ভারতীয়দের</title>
      <link>https://www.ittefaq.com.bd/823309/%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A7%87%E0%A6%A7%E0%A6%BE%E0%A6%9C%E0%A7%8D%E0%A6%9E%E0%A6%BE-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%93-%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%A8%E0%A6%BE%E0%A6%9F%E0%A6%95-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%A6%E0%A7%82%E0%A6%B0%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%96%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823309/%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A7%87%E0%A6%A7%E0%A6%BE%E0%A6%9C%E0%A7%8D%E0%A6%9E%E0%A6%BE-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%93-%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%A8%E0%A6%BE%E0%A6%9F%E0%A6%95-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%A6%E0%A7%82%E0%A6%B0%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%96%E0%A6%BE</guid>
      <pubDate>Fri, 27 Nov 2026 20:50:46 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/dff878fc17276799a63636dee891ddcd-6b099836ddc68.jpg?jadewits_media_id=325203" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/dff878fc17276799a63636dee891ddcd-6b099836ddc68.jpg?jadewits_media_id=325203" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/dff878fc17276799a63636dee891ddcd-6b099836ddc68.jpg?jadewits_media_id=325203" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নিষেধাজ্ঞা দিয়েও পাকিস্তানি নাটক থেকে দূরে রাখা যাচ্ছে না ভারতীয়দের" /&gt;&lt;/p&gt;&lt;p&gt;নয়াদিল্লিভিত্তিক সাংস্কৃতিক উদ্যোক্তা ও কিউরেটর আবু সুফিয়ান খান সম্প্রতি ভারতের রাজধানীতে পাকিস্তানি প্রেমের নাটক ‘দার-এ-নিজাত’-এর (Dar-e-Nijaat) একটি প্রদর্শনীর আয়োজন করে অবাক হয়ে যান। সর্বোচ্চ ৪৫ জনকে নিয়ে ব্যক্তিগতভাবে এই আয়োজন করার কথা ছিল। কিন্তু এতে অংশ নিতে ৭০০ জনের বেশি মানুষ তার কাছে অনুরোধ&lt;/p&gt;</description>

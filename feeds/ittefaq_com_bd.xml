      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/755ed39d96b7435c077b3fbcee28d6b2-6b0021a2a7374.jpg?jadewits_media_id=323898" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/755ed39d96b7435c077b3fbcee28d6b2-6b0021a2a7374.jpg?jadewits_media_id=323898" medium="image" />

      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/08/4f4dcaa265c56f5e0c62927728929121-6af075edbc4ea.jpg?jadewits_media_id=321548" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হিন্দুস্তান থেকে প্যারাশুটে নামবেন, না হেলিকপ্টারে, একটু বলে দিন: রিজভী" /&gt;&lt;/p&gt;&lt;p&gt;শহীদের রক্ত মাটিতে শুকাতে না শুকাতেই শেখ হাসিনা হিন্দুস্তান থেকে দেশে ফেরার আওয়াজ দিচ্ছেন বলে জানিয়েছেন বিএনপির ভারপ্রাপ্ত মহাসচিব রুহুল কবির রিজভী। তিনি বলেন, শেখ হাসিনা দেশে আসতে পারেন, তবে তার প্রতিটি হত্যার বিচার হবে। দেশে আইনের শাসন প্রতিষ্ঠার যে অঙ্গীকার গণতান্ত্রিক আন্দোলনে করা হয়েছে, তা নিশ্&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/819789/%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%81%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%B6%E0%A7%81%E0%A6%9F%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A6%AC%E0%A7%87%E0%A6%A8-%E0%A6%A8%E0%A6%BE">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>পররাষ্ট্র সচিব হলেন সালাহউদ্দিন নোমান চৌধুরী</title>
      <link>https://www.ittefaq.com.bd/819788/%E0%A6%AA%E0%A6%B0%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0-%E0%A6%B8%E0%A6%9A%E0%A6%BF%E0%A6%AC-%E0%A6%B9%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%B8%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%B9%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%A8%E0%A7%8B%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%9A%E0%A7%8C%E0%A6%A7%E0%A7%81%E0%A6%B0%E0%A7%80</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/819788/%E0%A6%AA%E0%A6%B0%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0-%E0%A6%B8%E0%A6%9A%E0%A6%BF%E0%A6%AC-%E0%A6%B9%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%B8%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%B9%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%A8%E0%A7%8B%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%9A%E0%A7%8C%E0%A6%A7%E0%A7%81%E0%A6%B0%E0%A7%80</guid>
      <pubDate>Sun, 08 Nov 2026 19:13:12 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/08/15061835d000d4122bca7398cdafaf5f-6af074ce0fed0.jpg?jadewits_media_id=321547" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/08/15061835d000d4122bca7398cdafaf5f-6af074ce0fed0.jpg?jadewits_media_id=321547" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/08/15061835d000d4122bca7398cdafaf5f-6af074ce0fed0.jpg?jadewits_media_id=321547" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পররাষ্ট্র সচিব হলেন সালাহউদ্দিন নোমান চৌধুরী" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশের নতুন পররাষ্ট্র সচিব হিসেবে নিয়োগ পেয়েছেন সালাহউদ্দিন নোমান চৌধুরী। তিনি দেশের ২৯তম পররাষ্ট্র সচিব হিসেবে দায়িত্ব পালন করবেন।
রোববার (৮ নভেম্বর) তাকে এ পদে নিয়োগ দিয়ে প্রজ্ঞাপন জারি করেছে পররাষ্ট্র মন্ত্রণালয়। তিনি বর্তমান পররাষ্ট্র সচিব আসাদ আলম সিয়ামের স্থলাভিষিক্ত হচ্ছেন।
এদিন পররাষ্ট্র&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/819788/%E0%A6%AA%E0%A6%B0%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0-%E0%A6%B8%E0%A6%9A%E0%A6%BF%E0%A6%AC-%E0%A6%B9%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%B8%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%B9%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%A8%E0%A7%8B%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%9A%E0%A7%8C%E0%A6%A7%E0%A7%81%E0%A6%B0%E0%A7%80">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>দীপাবলি ঘৃণা, অসহিষ্ণুতা ও হতাশার অন্ধকার কাটিয়ে আলোর জয়ের প্রতীক: পাকিস্তানের প্রধানমন্ত্রী</title>

      <guid isPermaLink="true">https://www.ittefaq.com.bd/822052/%E0%A6%B8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B2-%E0%A6%A2%E0%A7%87%E0%A6%B2%E0%A7%87</guid>
      <pubDate>Fri, 20 Nov 2026 15:58:10 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/bf8bf706e991901000cd09e3d3b22931-6b001959403b4.jpg?jadewits_media_id=323889" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/bf8bf706e991901000cd09e3d3b22931-6b001959403b4.jpg?jadewits_media_id=323889" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/bf8bf706e991901000cd09e3d3b22931-6b001959403b4.jpg?jadewits_media_id=323889" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সিরাজগঞ্জে এনসিপি নেতার বাড়ির সামনে পেট্রোল ঢেলে আগুন" /&gt;&lt;/p&gt;&lt;p&gt;সিরাজগঞ্জের বেলকুচিতে জাতীয় নাগরিক পার্টির (এনসিপি) সহযোগী সংগঠন জাতীয় স্বেচ্ছাসেবক শক্তির আহ্বায়ক ও বৈষম্যবিরোধী ছাত্র আন্দোলনের সাবেক সমন্বয়ক মো. মাহিন সরকারের গ্রামের বাড়িতে পেট্রোল বোমা নিক্ষেপের অভিযোগ উঠেছে। এতে বাড়ির প্রবেশ গেটে আগুন ধরে যায়। পরে স্থানীয় বাসিন্দারা আগুন নিয়ন্ত্রণে আনেন।
বৃহস্&lt;/p&gt;</description>

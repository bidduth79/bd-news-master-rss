      <guid isPermaLink="true">https://www.ittefaq.com.bd/821523/%E0%A6%86%E0%A6%AE%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%A5%E0%A6%BE-%E0%A6%AE%E0%A6%BF%E0%A6%A5%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%B9%E0%A6%B2%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%A6%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%97-%E0%A6%95%E0%A6%B0%E0%A6%AC-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF</guid>
      <pubDate>Tue, 17 Nov 2026 17:57:28 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/1626878007fed95f74ea339132043565-6afc40c4e8fec.jpg?jadewits_media_id=323342" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/1626878007fed95f74ea339132043565-6afc40c4e8fec.jpg?jadewits_media_id=323342" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/1626878007fed95f74ea339132043565-6afc40c4e8fec.jpg?jadewits_media_id=323342" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আমার কথা মিথ্যা হলে সংসদ থেকে পদত্যাগ করব: এমপি মনিরুল" /&gt;&lt;/p&gt;&lt;p&gt;সংসদে ক্ষোভ প্রকাশ করেছেন কুমিল্লা-৬ আসনের সংসদ সদস্য মনিরুল হক চৌধুরী। ইপিজেডের বর্জ্যের কারণে কুমিল্লা ও নোয়াখালী অঞ্চলের পরিবেশ বিপর্যয়, কৃষি ও জলজ প্রাণীর ক্ষতির অভিযোগ তুলে তিনি দাবি করেন, তার বক্তব্য মিথ্যা প্রমাণিত হলে সংসদ থেকে পদত্যাগ করবেন। এ সময় সমস্যাগুলো সমাধানে প্রধানমন্ত্রীর হস্তক্ষেপ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821523/%E0%A6%86%E0%A6%AE%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%A5%E0%A6%BE-%E0%A6%AE%E0%A6%BF%E0%A6%A5%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%B9%E0%A6%B2%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%A6%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%97-%E0%A6%95%E0%A6%B0%E0%A6%AC-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>বাকশালের একটি অংশই ১৫ আগস্ট হত্যাকাণ্ড ঘটিয়েছে: রিজভী</title>

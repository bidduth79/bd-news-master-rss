      <guid isPermaLink="true">https://www.ittefaq.com.bd/823411/%E0%A6%B8%E0%A7%80%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A7%80-%E0%A6%95%E0%A6%B0%E0%A6%9B%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%A8%E0%A6%BE-%E0%A6%8F%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%85%E0%A6%AA%E0%A6%A4%E0%A7%8E%E0%A6%AA%E0%A6%B0%E0%A6%A4%E0%A6%BE</guid>
      <pubDate>Sat, 28 Nov 2026 14:29:54 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/9807b1cec26e08254bdbb31884816185-6b0a8cbbe0ac1.jpg?jadewits_media_id=325307" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/9807b1cec26e08254bdbb31884816185-6b0a8cbbe0ac1.jpg?jadewits_media_id=325307" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/9807b1cec26e08254bdbb31884816185-6b0a8cbbe0ac1.jpg?jadewits_media_id=325307" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সীমান্তের ওপারে কে কী করছে জানি না, এপারে অপতৎপরতা চালাতে পারবে না: স্বরাষ্ট্রমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;সীমান্তের ওপারে কে কি করছে জানি না, তবে সীমান্তের এপারে কেউ অপতৎপরতা চালাতে পারবে না বলে মন্তব্য করেছেন স্বরাষ্ট্রমন্ত্রী সালাহউদ্দিন আহমদ।
শনিবার (২৮ নভেম্বর) রাজধানীর রাজারবাগে কেন্দ্রীয় পুলিশ হাসপাতালে সাম্প্রতিক সহিংসতায় আহত পুলিশ সদস্যদের দেখতে গিয়ে সাংবাদিকদের সঙ্গে আলাপকালে তিনি এ কথা বলেন।
স&lt;/p&gt;</description>

      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/168c178458aa5e509609647714cb7c03-6afedca1c41aa.jpg?jadewits_media_id=323740" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/168c178458aa5e509609647714cb7c03-6afedca1c41aa.jpg?jadewits_media_id=323740" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/168c178458aa5e509609647714cb7c03-6afedca1c41aa.jpg?jadewits_media_id=323740" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঢাকায় ৭ পদে ৫৪ জন নিয়োগ দেবে কর কমিশনারের কার্যালয়" /&gt;&lt;/p&gt;&lt;p&gt;কর কমিশনারের কার্যালয়, কর অঞ্চল-১০, ঢাকায় সাত ক্যাটাগরির পদে ৫৪ জন জনবল নিয়োগের বিজ্ঞপ্তি প্রকাশ করা হয়েছে। ১৩তম থেকে ২০তম গ্রেডের এসব পদে শুধু ঢাকা জেলার স্থায়ী বাসিন্দারা আবেদন করতে পারবেন। আগ্রহী প্রার্থীদের জন্য অনলাইন আবেদন শুরু হবে আগামী ২৬ নভেম্বর।
মঙ্গলবার (১৭ নভেম্বর) প্রকাশিত নিয়োগ বিজ্ঞপ্&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821906/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A7%AD-%E0%A6%AA%E0%A6%A6%E0%A7%87-%E0%A7%AB%E0%A7%AA-%E0%A6%9C%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%8B%E0%A6%97-%E0%A6%A6%E0%A7%87%E0%A6%AC%E0%A7%87-%E0%A6%95%E0%A6%B0-%E0%A6%95%E0%A6%AE%E0%A6%BF%E0%A6%B6%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>মামলার চাপ কমাতে প্রাক-মামলা মধ্যস্থতা কার্যক্রম বাড়ানো হবে: আইনমন্ত্রী</title>

    <item>
      <title>বায়ুদূষণে বিশ্বে দ্বিতীয় ঢাকা, বাতাস ‘খুবই অস্বাস্থ্যকর’</title>
      <link>https://www.ittefaq.com.bd/823046/%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A7%81%E0%A6%A6%E0%A7%82%E0%A6%B7%E0%A6%A3%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A7%87-%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B8-%E2%80%98%E0%A6%96%E0%A7%81%E0%A6%AC%E0%A6%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823046/%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A7%81%E0%A6%A6%E0%A7%82%E0%A6%B7%E0%A6%A3%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A7%87-%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B8-%E2%80%98%E0%A6%96%E0%A7%81%E0%A6%AC%E0%A6%87</guid>
      <pubDate>Thu, 26 Nov 2026 09:15:35 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/10/29/1163b1bfd146445196f17b17a8245e48-6ae2ccf0b980e.jpg?jadewits_media_id=319626" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/10/29/1163b1bfd146445196f17b17a8245e48-6ae2ccf0b980e.jpg?jadewits_media_id=319626" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/10/29/1163b1bfd146445196f17b17a8245e48-6ae2ccf0b980e.jpg?jadewits_media_id=319626" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বায়ুদূষণে বিশ্বে দ্বিতীয় ঢাকা, বাতাস ‘খুবই অস্বাস্থ্যকর’" /&gt;&lt;/p&gt;&lt;p&gt;বায়ুদূষণের ভয়াবহতা বাড়ছে রাজধানী ঢাকায়। বৃহস্পতিবার (২৬ নভেম্বর) সকালে বিশ্বের দূষিত শহরের তালিকায় দ্বিতীয় অবস্থানে উঠে এসেছে ঢাকা। শহরটির বায়ুর মান সূচক (একিউআই) ২৩৯, যা &amp;lsquo;খুবই অস্বাস্থ্যকর&amp;rsquo; হিসেবে বিবেচিত।
বৃহস্পতিবার সকাল ৯টা ১৫ মিনিটে আন্তর্জাতিক বায়ুমান পর্যবেক্ষণকারী সংস্থা আইকিউএয়া&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823046/%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A7%81%E0%A6%A6%E0%A7%82%E0%A6%B7%E0%A6%A3%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A7%87-%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B8-%E2%80%98%E0%A6%96%E0%A7%81%E0%A6%AC%E0%A6%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>দেশের বাজারে আজ যে দামে বিক্রি হচ্ছে স্বর্ণ</title>

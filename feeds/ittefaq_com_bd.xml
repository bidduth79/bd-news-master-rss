    <item>
      <title>ভারতে রাষ্ট্রপতির দেহরক্ষীর মাথায় চালানো হলো গুলি</title>
      <link>https://www.ittefaq.com.bd/820260/%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%AA%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A7%87%E0%A6%B9%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%80%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%A5%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%B9%E0%A6%B2%E0%A7%8B-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820260/%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%AA%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A7%87%E0%A6%B9%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%80%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%A5%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%B9%E0%A6%B2%E0%A7%8B-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF</guid>
      <pubDate>Wed, 11 Nov 2026 08:09:22 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/e50fb9ad237528bdb590c95813dbc8cf-6af3cde42c610.jpg?jadewits_media_id=322045" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/e50fb9ad237528bdb590c95813dbc8cf-6af3cde42c610.jpg?jadewits_media_id=322045" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/e50fb9ad237528bdb590c95813dbc8cf-6af3cde42c610.jpg?jadewits_media_id=322045" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভারতে রাষ্ট্রপতির দেহরক্ষীর মাথায় চালানো হলো গুলি" /&gt;&lt;/p&gt;&lt;p&gt;ভারতের উত্তরপ্রদেশ রাজ্যের বাঘপত জেলায় দীপাবলির রাতে আতশবাজি ফাটানোকে কেন্দ্র করে কথা কাটাকাটির জেরে রাষ্ট্রপতির দেহরক্ষী বাহিনীর এক জওয়ানের মাথায় গুলি চালানোর ঘটনা ঘটেছে। বুধবার (১১ নভেম্বর) এনডিটিভির এক প্রতিবেদনে এই খবর জানানো হয়েছে।
আহত ওই সেনাসদস্যের নাম সৌরভ তোমার এবং তার বয়স ছাব্বিশ বছর। &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820260/%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%AA%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A7%87%E0%A6%B9%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%80%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%A5%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%B9%E0%A6%B2%E0%A7%8B-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>সরকারের দাবি, বিচ্ছিন্ন ঘটনা; বিরোধী দল বলল, অবনতি</title>
      <link>https://www.ittefaq.com.bd/820259/%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF-%E0%A6%AC%E0%A6%BF%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%A8-%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%80-%E0%A6%A6%E0%A6%B2-%E0%A6%AC%E0%A6%B2%E0%A6%B2-%E0%A6%85%E0%A6%AC%E0%A6%A8%E0%A6%A4%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820259/%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF-%E0%A6%AC%E0%A6%BF%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%A8-%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%80-%E0%A6%A6%E0%A6%B2-%E0%A6%AC%E0%A6%B2%E0%A6%B2-%E0%A6%85%E0%A6%AC%E0%A6%A8%E0%A6%A4%E0%A6%BF</guid>
      <pubDate>Wed, 11 Nov 2026 07:39:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/4f019e503d6e1da255fbfdcab26a4efd-6af3988dbc3e4.jpg?jadewits_media_id=322044" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/4f019e503d6e1da255fbfdcab26a4efd-6af3988dbc3e4.jpg?jadewits_media_id=322044" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/4f019e503d6e1da255fbfdcab26a4efd-6af3988dbc3e4.jpg?jadewits_media_id=322044" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সরকারের দাবি, বিচ্ছিন্ন ঘটনা; বিরোধী দল বলল, অবনতি" /&gt;&lt;/p&gt;&lt;p&gt;&amp;nbsp;





কয়েক দিন ধরে দেশের বিভিন্নস্থানে ককটেল বিস্ফোরণ, গাড়িতে আগুন ও নাশকতার ঘটনাকে &amp;lsquo;বিচ্ছিন্ন ও প্রতীকী&amp;rsquo; বলে আখ্যায়িত করেছে সরকারি দল। আর বিরোধী দলের অভিযোগ, দেশের আইনশৃঙ্খলা পরিস্থিতির অবনতি ঘটেছে। পরিস্থিতি মোকাবিলায় স্বরাষ্ট্র মন্ত্রণালয় তথা সরকারের &amp;lsquo;ব্যর্থতা&amp;rsquo; দেখছে&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820259/%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF-%E0%A6%AC%E0%A6%BF%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%A8-%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%80-%E0%A6%A6%E0%A6%B2-%E0%A6%AC%E0%A6%B2%E0%A6%B2-%E0%A6%85%E0%A6%AC%E0%A6%A8%E0%A6%A4%E0%A6%BF">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>মৌসুম শেষেও কমছে না ডেঙ্গু রোগীর চাপ, আক্রান্ত ও মৃত্যু বেশি ঢাকায়</title>
      <link>https://www.ittefaq.com.bd/820258/%E0%A6%AE%E0%A7%8C%E0%A6%B8%E0%A7%81%E0%A6%AE-%E0%A6%B6%E0%A7%87%E0%A6%B7%E0%A7%87%E0%A6%93-%E0%A6%95%E0%A6%AE%E0%A6%9B%E0%A7%87-%E0%A6%A8%E0%A6%BE-%E0%A6%A1%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%81-%E0%A6%B0%E0%A7%8B%E0%A6%97%E0%A7%80%E0%A6%B0-%E0%A6%9A%E0%A6%BE%E0%A6%AA-%E0%A6%86%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%93</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820258/%E0%A6%AE%E0%A7%8C%E0%A6%B8%E0%A7%81%E0%A6%AE-%E0%A6%B6%E0%A7%87%E0%A6%B7%E0%A7%87%E0%A6%93-%E0%A6%95%E0%A6%AE%E0%A6%9B%E0%A7%87-%E0%A6%A8%E0%A6%BE-%E0%A6%A1%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%81-%E0%A6%B0%E0%A7%8B%E0%A6%97%E0%A7%80%E0%A6%B0-%E0%A6%9A%E0%A6%BE%E0%A6%AA-%E0%A6%86%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%93</guid>
      <pubDate>Wed, 11 Nov 2026 06:59:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/63ef3faf7b28a1ad3b7128b71bb6aa98-6af393dcd27b5.jpg?jadewits_media_id=322043" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/63ef3faf7b28a1ad3b7128b71bb6aa98-6af393dcd27b5.jpg?jadewits_media_id=322043" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/63ef3faf7b28a1ad3b7128b71bb6aa98-6af393dcd27b5.jpg?jadewits_media_id=322043" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মৌসুম শেষেও কমছে না ডেঙ্গু রোগীর চাপ, আক্রান্ত ও মৃত্যু বেশি ঢাকায়" /&gt;&lt;/p&gt;&lt;p&gt;মৌসুম পেরিয়ে গেলেও কমছে না ডেঙ্গুতে আক্রান্ত রোগীর চাপ। গত বছরের তুলনায় এ বছর ডেঙ্গুতে আক্রান্ত রোগী এবং মৃত্যুর সংখ্যা দুটোই অনেক বেশি। এ রোগে গত ২৪ ঘণ্টায় (সোমবার সকাল ৮টা থেকে গতকাল মঙ্গলবার সকাল ৮টা পর্যন্ত) মৃত্যু হয়েছে আরো আট জনের। এরমধ্যে সাত জনই ঢাকা বিভাগের। একই সময়ে নতুন ডেঙ্গু আক্রান্ত হয়&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820258/%E0%A6%AE%E0%A7%8C%E0%A6%B8%E0%A7%81%E0%A6%AE-%E0%A6%B6%E0%A7%87%E0%A6%B7%E0%A7%87%E0%A6%93-%E0%A6%95%E0%A6%AE%E0%A6%9B%E0%A7%87-%E0%A6%A8%E0%A6%BE-%E0%A6%A1%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%81-%E0%A6%B0%E0%A7%8B%E0%A6%97%E0%A7%80%E0%A6%B0-%E0%A6%9A%E0%A6%BE%E0%A6%AA-%E0%A6%86%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%93">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>মাথা-হাত-পা নেই, পদ্মায় ভাসছিল শুধু অর্ধগলিত খণ্ডিত মরদেহ</title>
      <link>https://www.ittefaq.com.bd/820257/%E0%A6%AE%E0%A6%BE%E0%A6%A5%E0%A6%BE-%E0%A6%B9%E0%A6%BE%E0%A6%A4-%E0%A6%AA%E0%A6%BE-%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%AA%E0%A6%A6%E0%A7%8D%E0%A6%AE%E0%A6%BE%E0%A7%9F-%E0%A6%AD%E0%A6%BE%E0%A6%B8%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%B6%E0%A7%81%E0%A6%A7%E0%A7%81-%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A7%E0%A6%97%E0%A6%B2%E0%A6%BF%E0%A6%A4</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820257/%E0%A6%AE%E0%A6%BE%E0%A6%A5%E0%A6%BE-%E0%A6%B9%E0%A6%BE%E0%A6%A4-%E0%A6%AA%E0%A6%BE-%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%AA%E0%A6%A6%E0%A7%8D%E0%A6%AE%E0%A6%BE%E0%A7%9F-%E0%A6%AD%E0%A6%BE%E0%A6%B8%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%B6%E0%A7%81%E0%A6%A7%E0%A7%81-%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A7%E0%A6%97%E0%A6%B2%E0%A6%BF%E0%A6%A4</guid>
      <pubDate>Wed, 11 Nov 2026 05:59:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/7ad2463fef6c4d28ea767698e8261dbf-6af3926d7b0f7.jpg?jadewits_media_id=322042" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/7ad2463fef6c4d28ea767698e8261dbf-6af3926d7b0f7.jpg?jadewits_media_id=322042" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/7ad2463fef6c4d28ea767698e8261dbf-6af3926d7b0f7.jpg?jadewits_media_id=322042" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মাথা-হাত-পা নেই, পদ্মায় ভাসছিল শুধু অর্ধগলিত খণ্ডিত মরদেহ" /&gt;&lt;/p&gt;&lt;p&gt;শরীয়তপুরের জাজিরায় পদ্মা নদী থেকে মাথা, দুই হাত ও দুই পা বিচ্ছিন্ন অজ্ঞাতপরিচয় এক ব্যক্তির অর্ধগলিত মরদেহ উদ্ধার করেছে নৌ-পুলিশ। মঙ্গলবার (১০ নভেম্বর) রাত ৮টার দিকে উপজেলার পদ্মা সেতু দক্ষিণ থানাধীন পৈলান মোল্লারকান্দি এলাকার পদ্মা নদীর তীর থেকে খণ্ডিত এই মরদেহটি উদ্ধার করা হয়। নৃশংসভাবে শরীর থে&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820257/%E0%A6%AE%E0%A6%BE%E0%A6%A5%E0%A6%BE-%E0%A6%B9%E0%A6%BE%E0%A6%A4-%E0%A6%AA%E0%A6%BE-%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%AA%E0%A6%A6%E0%A7%8D%E0%A6%AE%E0%A6%BE%E0%A7%9F-%E0%A6%AD%E0%A6%BE%E0%A6%B8%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%B6%E0%A7%81%E0%A6%A7%E0%A7%81-%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A7%E0%A6%97%E0%A6%B2%E0%A6%BF%E0%A6%A4">দৈনিক ইত্তেফাক</source>
    </item>
    <item>

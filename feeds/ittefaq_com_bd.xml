    <item>
      <title>ডাকসু ভিপি সাদিক কায়েমের বাড়িতে আগুন দেওয়ার চেষ্টার অভিযোগ</title>
      <link>https://www.ittefaq.com.bd/822318/%E0%A6%A1%E0%A6%BE%E0%A6%95%E0%A6%B8%E0%A7%81-%E0%A6%AD%E0%A6%BF%E0%A6%AA%E0%A6%BF-%E0%A6%B8%E0%A6%BE%E0%A6%A6%E0%A6%BF%E0%A6%95-%E0%A6%95%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822318/%E0%A6%A1%E0%A6%BE%E0%A6%95%E0%A6%B8%E0%A7%81-%E0%A6%AD%E0%A6%BF%E0%A6%AA%E0%A6%BF-%E0%A6%B8%E0%A6%BE%E0%A6%A6%E0%A6%BF%E0%A6%95-%E0%A6%95%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Sun, 22 Nov 2026 08:53:05 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/1cd427353072be44e9e67206ea376b07-6b0258ae714cb.jpg?jadewits_media_id=324157" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/1cd427353072be44e9e67206ea376b07-6b0258ae714cb.jpg?jadewits_media_id=324157" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/1cd427353072be44e9e67206ea376b07-6b0258ae714cb.jpg?jadewits_media_id=324157" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডাকসু ভিপি সাদিক কায়েমের বাড়িতে আগুন দেওয়ার চেষ্টার অভিযোগ" /&gt;&lt;/p&gt;&lt;p&gt;খাগড়াছড়িতে ঢাকা বিশ্ববিদ্যালয় কেন্দ্রীয় ছাত্র সংসদের (ডাকসু) ভিপি সাদিক কায়েমের বাড়িতে পেট্রোলবোমা ও কেরোসিন দিয়ে অগ্নিসংযোগের চেষ্টার অভিযোগ উঠেছে। এ ঘটনার জন্য কার্যক্রম নিষিদ্ধ আওয়ামী লীগের নেতাকর্মীদের দায়ী করেছেন তিনি। ঘটনার সময় বাড়িতে তার বাবা-মা ছিলেন বলে জানিয়েছেন সাদিক।
রোববার (২২ নভেম্বর) &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822318/%E0%A6%A1%E0%A6%BE%E0%A6%95%E0%A6%B8%E0%A7%81-%E0%A6%AD%E0%A6%BF%E0%A6%AA%E0%A6%BF-%E0%A6%B8%E0%A6%BE%E0%A6%A6%E0%A6%BF%E0%A6%95-%E0%A6%95%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>গাজায় শিশুদের খাবার বিতরণের গাড়িতে ইসরাইলের ড্রোন হামলা, নিহত ৪</title>
      <link>https://www.ittefaq.com.bd/822317/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A7%9F-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%96%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A6%B0%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A1%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822317/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A7%9F-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%96%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A6%B0%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A1%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%A8</guid>
      <pubDate>Sun, 22 Nov 2026 08:50:36 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/29786ae884533978250d2c3f52ca572d-6b02583503a7b.jpg?jadewits_media_id=324156" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/29786ae884533978250d2c3f52ca572d-6b02583503a7b.jpg?jadewits_media_id=324156" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/29786ae884533978250d2c3f52ca572d-6b02583503a7b.jpg?jadewits_media_id=324156" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গাজায় শিশুদের খাবার বিতরণের গাড়িতে ইসরাইলের ড্রোন হামলা, নিহত ৪" /&gt;&lt;/p&gt;&lt;p&gt;ফিলিস্তিনের অবরুদ্ধ গাজায় যুদ্ধবিরতি সত্ত্বেও ইসরাইলি হামলা অব্যাহত রয়েছে। উপত্যকাটিতে দুর্ভিক্ষের মধ্যেই ত্রাণবাহী গাড়ি লক্ষ্য করে হামলা করেছে ইসরায়েল।&amp;nbsp;
শনিবার (২১ নভেম্বর) বাস্তুচ্যুত মানুষের জন্য খাবার নিয়ে যাওয়া একটি গাড়িতে ড্রোন হামলায় তিন জনসহ অন্তত চার ফিলিস্তিনি নিহত হয়েছেন।


কাতারভিত্&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822317/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A7%9F-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%96%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A6%B0%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A1%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%A8">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>খুলনায় দুই আওয়ামী লীগ নেতাকে গণপিটুনি, একজনের অবস্থা আশঙ্কাজনক</title>
      <link>https://www.ittefaq.com.bd/822316/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%97%E0%A6%A3%E0%A6%AA%E0%A6%BF%E0%A6%9F%E0%A7%81%E0%A6%A8%E0%A6%BF-%E0%A6%8F%E0%A6%95%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822316/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%97%E0%A6%A3%E0%A6%AA%E0%A6%BF%E0%A6%9F%E0%A7%81%E0%A6%A8%E0%A6%BF-%E0%A6%8F%E0%A6%95%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Sun, 22 Nov 2026 08:48:12 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/3f5c5fe8c24b523b60656019f8cca1f7-6b0257bae7edd.jpg?jadewits_media_id=324155" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/3f5c5fe8c24b523b60656019f8cca1f7-6b0257bae7edd.jpg?jadewits_media_id=324155" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/3f5c5fe8c24b523b60656019f8cca1f7-6b0257bae7edd.jpg?jadewits_media_id=324155" style="max-width:100%;height:auto;margin-bottom:10px;" alt="খুলনায় দুই আওয়ামী লীগ নেতাকে গণপিটুনি, একজনের অবস্থা আশঙ্কাজনক" /&gt;&lt;/p&gt;&lt;p&gt;খুলনায় পৃথক ঘটনায় কার্যক্রম নিষিদ্ধ আওয়ামী লীগের দুই নেতাকে গণপিটুনি দিয়েছেন স্থানীয় লোকজন। তাদের মধ্যে একজনকে আশঙ্কাজনক অবস্থায় খুলনা মেডিকেল কলেজ হাসপাতালে ভর্তি করা হয়েছে।&amp;nbsp;
শনিবার (২১ নভেম্বর) বিকেলে রূপসা উপজেলার সেনেরবাজার ও সন্ধ্যায় নগরীর ফুলবাড়ীগেট এলাকায় এ দুটি ঘটনা ঘটে।
রূপসায় গণপিটুনি&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822316/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%97%E0%A6%A3%E0%A6%AA%E0%A6%BF%E0%A6%9F%E0%A7%81%E0%A6%A8%E0%A6%BF-%E0%A6%8F%E0%A6%95%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>চুয়াডাঙ্গা ছাত্রদলের নতুন কমিটিতে বিবাহিত ও সন্তানের বাবাদের পদ পাওয়া নিয়ে বিতর্ক</title>
      <link>https://www.ittefaq.com.bd/822315/%E0%A6%9A%E0%A7%81%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%A1%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%95%E0%A6%AE%E0%A6%BF%E0%A6%9F%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A4-%E0%A6%93</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822315/%E0%A6%9A%E0%A7%81%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%A1%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%95%E0%A6%AE%E0%A6%BF%E0%A6%9F%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A4-%E0%A6%93</guid>
      <pubDate>Sun, 22 Nov 2026 08:46:35 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/62c90c0bea06d1744c99e869888bc9ed-6b025717c2973.png?jadewits_media_id=324154" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/62c90c0bea06d1744c99e869888bc9ed-6b025717c2973.png?jadewits_media_id=324154" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/62c90c0bea06d1744c99e869888bc9ed-6b025717c2973.png?jadewits_media_id=324154" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চুয়াডাঙ্গা ছাত্রদলের নতুন কমিটিতে বিবাহিত ও সন্তানের বাবাদের পদ পাওয়া নিয়ে বিতর্ক" /&gt;&lt;/p&gt;&lt;p&gt;চুয়াডাঙ্গা জেলা ছাত্রদলের ১৪ সদস্যের আংশিক কমিটি ঘোষণা করা হয়েছে। তবে কমিটি ঘোষণার পরপরই নতুন নেতৃত্ব নিয়ে তীব্র বিতর্ক তৈরি হয়েছে। অভিযোগ উঠেছে, ঘোষিত কমিটির সভাপতি জুয়েল মাহমুদসহ অন্তত পাঁচজন নেতা বিবাহিত এবং তাদের একাধিক নেতার সন্তানও রয়েছে।
শনিবার (২১ নভেম্বর) ছাত্রদলের কেন্দ্রীয় সংসদের স&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822315/%E0%A6%9A%E0%A7%81%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%A1%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%95%E0%A6%AE%E0%A6%BF%E0%A6%9F%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A4-%E0%A6%93">দৈনিক ইত্তেফাক</source>

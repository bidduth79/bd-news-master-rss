      <guid isPermaLink="true">https://www.ittefaq.com.bd/822294/%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%B6%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%B8%E0%A6%BE%E0%A6%81%E0%A6%A1%E0%A6%BC%E0%A6%BE%E0%A6%B6%E0%A6%BF-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A7%A7%E0%A7%AB%E0%A7%A8-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF%E0%A6%B8%E0%A6%B9-%E0%A7%AA%E0%A7%AE%E0%A7%AF</guid>
      <pubDate>Sat, 21 Nov 2026 23:30:21 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/1a964733a570536d4c917f70dbe62b33-6b01d3a137b19.jpg?jadewits_media_id=324133" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/1a964733a570536d4c917f70dbe62b33-6b01d3a137b19.jpg?jadewits_media_id=324133" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/1a964733a570536d4c917f70dbe62b33-6b01d3a137b19.jpg?jadewits_media_id=324133" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মালয়েশিয়ায় সাঁড়াশি অভিযানে ১৫২ বাংলাদেশিসহ ৪৮৯ অভিবাসী আটক" /&gt;&lt;/p&gt;&lt;p&gt;মালয়েশিয়ার সেলাঙ্গর রাজ্যের তামান শ্রী মুদা এলাকার ২৬টি বাণিজ্যিক ভবনে যৌথ সাঁড়াশি অভিযান চালিয়ে ১৫২ জন বাংলাদেশিসহ মোট ৪৮৯ জন বিদেশি নাগরিককে আটক করেছে দেশটির অভিবাসন বিভাগ। শনিবার (২১ নভেম্বর) সকাল ১১টা থেকে দুপুর ১টা পর্যন্ত দুই ঘণ্টাব্যাপী পরিচালিত এই অভিযানে মোট ৮৩১ জন অভিবাসীর কাগজপত্র যাচ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822294/%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%B6%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%B8%E0%A6%BE%E0%A6%81%E0%A6%A1%E0%A6%BC%E0%A6%BE%E0%A6%B6%E0%A6%BF-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A7%A7%E0%A7%AB%E0%A7%A8-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF%E0%A6%B8%E0%A6%B9-%E0%A7%AA%E0%A7%AE%E0%A7%AF">দৈনিক ইত্তেফাক</source>
    </item>
    <item>

    <item>
      <title>সাতক্ষীরায় পরীক্ষা-নিরীক্ষার কথা বলে নারী রোগীকে ধর্ষণের অভিযোগ, আউটসোর্সিং কর্মী গ্রেপ্তার</title>
      <link>https://www.ittefaq.com.bd/821588/%E0%A6%B8%E0%A6%BE%E0%A6%A4%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%80%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%A5%E0%A6%BE-%E0%A6%AC%E0%A6%B2%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%B0%E0%A7%8B%E0%A6%97%E0%A7%80%E0%A6%95%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821588/%E0%A6%B8%E0%A6%BE%E0%A6%A4%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%80%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%A5%E0%A6%BE-%E0%A6%AC%E0%A6%B2%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%B0%E0%A7%8B%E0%A6%97%E0%A7%80%E0%A6%95%E0%A7%87</guid>
      <pubDate>Wed, 18 Nov 2026 00:22:57 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/7e20adeb8495e91ca0f7bb99067a4cdd-6afc9b5f889e4.jpg?jadewits_media_id=323414" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/7e20adeb8495e91ca0f7bb99067a4cdd-6afc9b5f889e4.jpg?jadewits_media_id=323414" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/7e20adeb8495e91ca0f7bb99067a4cdd-6afc9b5f889e4.jpg?jadewits_media_id=323414" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাতক্ষীরায় পরীক্ষা-নিরীক্ষার কথা বলে নারী রোগীকে ধর্ষণের অভিযোগ, আউটসোর্সিং কর্মী গ্রেপ্তার" /&gt;&lt;/p&gt;&lt;p&gt;সাতক্ষীরা সদর হাসপাতালে চিকিৎসা নিতে আসা এক নারীকে (৩৮) পরীক্ষা-নিরীক্ষা করিয়ে দেওয়ার আশ্বাস দিয়ে ধর্ষণের অভিযোগ উঠেছে হাসপাতালের এক আউটসোর্সিং কর্মীর বিরুদ্ধে। এ ঘটনায় ভুক্তভোগী নারীর দায়ের করা মামলায় অভিযুক্ত কর্মী মাহমুদুল হাসানকে (২৪) গ্রেপ্তার করেছে পুলিশ।
মঙ্গলবার (১৭ নভেম্বর) বিকেল ৪টার দিকে &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821588/%E0%A6%B8%E0%A6%BE%E0%A6%A4%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%80%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%A5%E0%A6%BE-%E0%A6%AC%E0%A6%B2%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%B0%E0%A7%8B%E0%A6%97%E0%A7%80%E0%A6%95%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>

      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/2a42599dd9f684669166a6e1a74a3887-6b047e09d87de.jpg?jadewits_media_id=324528" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মঙ্গলবার তিন বাহিনীর যৌথ মহড়া পরিদর্শনে স্বর্ণদ্বীপ যাবেন প্রধানমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;নোয়াখালীর স্বর্ণদ্বীপে বাংলাদেশ সেনাবাহিনী, নৌবাহিনী ও বিমানবাহিনীর বিশেষ যৌথ প্রশিক্ষণ মহড়া পরিদর্শন করতে মঙ্গলবার (২৪ নভেম্বর) সেখানে যাবেন প্রধানমন্ত্রী তারেক রহমান। সশস্ত্র বাহিনীর স্পেশাল ফোর্সগুলোর সমন্বয়ে প্রথমবারের মতো আয়োজিত &amp;lsquo;জয়েন্ট স্পেশাল ফোর্সেস এক্সারসাইজ-১-২০২৬&amp;rsquo;-এর চূড&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822687/%E0%A6%AE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%AF%E0%A7%8C%E0%A6%A5-%E0%A6%AE%E0%A6%B9%E0%A6%A1%E0%A6%BC%E0%A6%BE-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%A6%E0%A6%B0%E0%A7%8D%E0%A6%B6%E0%A6%A8%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>দেশের চলমান পরিস্থিতি নিয়ে কূটনীতিকদের ব্রিফ করবে সরকার</title>
      <link>https://www.ittefaq.com.bd/822686/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%B2%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BF%E0%A6%A4%E0%A6%BF-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%95%E0%A7%82%E0%A6%9F%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%AB-%E0%A6%95%E0%A6%B0%E0%A6%AC%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822686/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%B2%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BF%E0%A6%A4%E0%A6%BF-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%95%E0%A7%82%E0%A6%9F%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%AB-%E0%A6%95%E0%A6%B0%E0%A6%AC%E0%A7%87</guid>
      <pubDate>Mon, 23 Nov 2026 23:51:40 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/f83db8396dd11de4883e3323c2352c31-6b047cd895111.jpg?jadewits_media_id=324527" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/f83db8396dd11de4883e3323c2352c31-6b047cd895111.jpg?jadewits_media_id=324527" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/f83db8396dd11de4883e3323c2352c31-6b047cd895111.jpg?jadewits_media_id=324527" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দেশের চলমান পরিস্থিতি নিয়ে কূটনীতিকদের ব্রিফ করবে সরকার" /&gt;&lt;/p&gt;&lt;p&gt;দেশের চলমান পরিস্থিতি নিয়ে ঢাকায় বিদেশি কূটনৈতিক মিশনের প্রতিনিধিদের ব্রিফ করবে সরকার। একই সঙ্গে তাদের সামনে প্রস্তাবিত সাইবার সুরক্ষা (সংশোধন) আইনের সংশোধিত খসড়ার বিষয়টিও তুলে ধরা হবে।
মঙ্গলবার (২৪ নভেম্বর) সকালে পররাষ্ট্র মন্ত্রণালয়ে এই ব্রিফিং হবে।
শুরুতে পররাষ্ট্র প্রতিমন্ত্রী হুমায়ুন কবির আমন্ত&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822686/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%B2%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BF%E0%A6%A4%E0%A6%BF-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%95%E0%A7%82%E0%A6%9F%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%AB-%E0%A6%95%E0%A6%B0%E0%A6%AC%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>মঙ্গলবার রাজধানীতে মোটরসাইকেল শোভাযাত্রা করবে এনসিপি</title>
      <link>https://www.ittefaq.com.bd/822685/%E0%A6%AE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AE%E0%A7%8B%E0%A6%9F%E0%A6%B0%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%87%E0%A6%B2-%E0%A6%B6%E0%A7%8B%E0%A6%AD%E0%A6%BE%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%AC%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822685/%E0%A6%AE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AE%E0%A7%8B%E0%A6%9F%E0%A6%B0%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%87%E0%A6%B2-%E0%A6%B6%E0%A7%8B%E0%A6%AD%E0%A6%BE%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%AC%E0%A7%87</guid>
      <pubDate>Mon, 23 Nov 2026 23:48:31 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/07c637f1f6a148d1cb5e48ba8d2a3d03-6b047c501cf01.jpg?jadewits_media_id=324526" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/07c637f1f6a148d1cb5e48ba8d2a3d03-6b047c501cf01.jpg?jadewits_media_id=324526" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/07c637f1f6a148d1cb5e48ba8d2a3d03-6b047c501cf01.jpg?jadewits_media_id=324526" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মঙ্গলবার রাজধানীতে মোটরসাইকেল শোভাযাত্রা করবে এনসিপি" /&gt;&lt;/p&gt;&lt;p&gt;কার্যক্রম নিষিদ্ধ থাকা আওয়ামী লীগের নৈরাজ্য প্রতিরোধের ঘোষণা দিয়ে মঙ্গলবার (২৪ নভেম্বর) দুপুরে রাজধানীতে &amp;lsquo;মোটরসাইকেল শোভাযাত্রা&amp;rsquo; কর্মসূচি পালন করবে জাতীয় নাগরিক পার্টি (এনসিপি)। দলটির ঢাকা মহানগর উত্তর শাখার উদ্যোগে মানিক মিয়া অ্যাভিনিউ থেকে এই শোভাযাত্রা শুরু হয়ে মিরপুর ১২ নম্বরে গ&lt;/p&gt;</description>

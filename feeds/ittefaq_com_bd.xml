      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/445f4f2bb18cc17f229708f158497f44-6af699bc89e8b.jpg?jadewits_media_id=322495" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/445f4f2bb18cc17f229708f158497f44-6af699bc89e8b.jpg?jadewits_media_id=322495" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শেকৃবি শিক্ষার্থীদের মাঠ পুনরুদ্ধার আন্দোলনের মধ্যেই পুরোনো বাণিজ্য মেলার মাঠে মেলার অনুমতি" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর আগারগাঁওয়ে পুরোনো বাণিজ্য মেলার মাঠে (বাংলাদেশ-চীন মৈত্রী সম্মেলন কেন্দ্রের পশ্চিম পাশের মাঠ) তিন দিনব্যাপী &amp;lsquo;জাতীয় প্রাণিসম্পদ সপ্তাহ ২০২৬&amp;rsquo; ও প্রদর্শনীর আয়োজন করা হচ্ছে। আগামী ২৬ থেকে ২৮ নভেম্বর এ আয়োজন চলবে। তবে মাঠ পুনরুদ্ধারের দাবিতে শেরেবাংলা কৃষি বিশ্ববিদ্যালয়ের (শেকৃবি) শি&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820704/%E0%A6%B6%E0%A7%87%E0%A6%95%E0%A7%83%E0%A6%AC%E0%A6%BF-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%A0-%E0%A6%AA%E0%A7%81%E0%A6%A8%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8B%E0%A6%B2%E0%A6%A8%E0%A7%87%E0%A6%B0">দৈনিক ইত্তেফাক</source>

    <item>
      <title>রাষ্ট্রের সম্পদ কাহার জন্য ব্যয় হইবে?</title>
      <link>https://www.ittefaq.com.bd/822312/%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%A6-%E0%A6%95%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A7%9F-%E0%A6%B9%E0%A6%87%E0%A6%AC%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822312/%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%A6-%E0%A6%95%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A7%9F-%E0%A6%B9%E0%A6%87%E0%A6%AC%E0%A7%87</guid>
      <pubDate>Sun, 22 Nov 2026 06:35:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/42b38b7b842795efb6dc4d13d5a7a3b0-6b0218caf06e2.jpg?jadewits_media_id=324151" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/42b38b7b842795efb6dc4d13d5a7a3b0-6b0218caf06e2.jpg?jadewits_media_id=324151" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/42b38b7b842795efb6dc4d13d5a7a3b0-6b0218caf06e2.jpg?jadewits_media_id=324151" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাষ্ট্রের সম্পদ কাহার জন্য ব্যয় হইবে?" /&gt;&lt;/p&gt;&lt;p&gt;সম্প্রতি ইউরোপের ২০টিরও অধিক দেশের প্রায় ৪০০টি শহরে শিক্ষার্থী ও তরুণ শ্রমিকদের বিক্ষোভ কীসের ইঙ্গিত দিতেছে? জীবনযাত্রার ব্যয় বৃদ্ধি, আবাসন সংকট, শিক্ষার দুরবস্থা এবং সামরিক খাতে ক্রমবর্ধমান ব্যয়ের প্রতিবাদে ৫০টিরও অধিক যুব ও ছাত্রসংগঠনের অংশগ্রহণে এই আন্দোলনের যে বিস্তার ঘটিয়াছে, তাহা কেবল কয়েকটি দ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822312/%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%A6-%E0%A6%95%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A7%9F-%E0%A6%B9%E0%A6%87%E0%A6%AC%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>

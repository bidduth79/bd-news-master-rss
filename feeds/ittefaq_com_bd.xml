      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/8d0b73956e676c81329f2c8513ee4c70-6aff4ff4ea428.jpg?jadewits_media_id=323822" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সশস্ত্র বাহিনীর জন্য নতুন বেতন কাঠামো নির্ধারণ করলো সরকার" /&gt;&lt;/p&gt;&lt;p&gt;বেসামরিক সরকারি কর্মচারীদের জন্য নতুন বেতন কাঠামোর প্রজ্ঞাপন জারির প্রায় দুই মাস পর এবার সশস্ত্র বাহিনীর সদস্যদের জন্য নতুন বেতন ও ভাতা নির্ধারণ করেছে সরকার। নতুন কাঠামোতে সেনাবাহিনী, নৌবাহিনী ও বিমানবাহিনী&amp;mdash;এই তিন বাহিনীপ্রধানের মূল বেতন নির্ধারণ করা হয়েছে ১ লাখ ৭২ হাজার টাকা। আর সৈনিকদের মূ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821985/%E0%A6%B8%E0%A6%B6%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%AC%E0%A7%87%E0%A6%A4%E0%A6%A8-%E0%A6%95%E0%A6%BE%E0%A6%A0%E0%A6%BE%E0%A6%AE%E0%A7%8B-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A6%A3">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>আমরা স্যান্ডপেপার নয়, বোতলের ছিপি ব্যবহার করতাম: বল টেম্পারিং বিতর্কে শোয়েব আখতার</title>
      <link>https://www.ittefaq.com.bd/821984/%E0%A6%86%E0%A6%AE%E0%A6%B0%E0%A6%BE-%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A6%AA%E0%A7%87%E0%A6%AA%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%AF%E0%A6%BC-%E0%A6%AC%E0%A7%8B%E0%A6%A4%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%9B%E0%A6%BF%E0%A6%AA%E0%A6%BF-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B9%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A6%BE%E0%A6%AE</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821984/%E0%A6%86%E0%A6%AE%E0%A6%B0%E0%A6%BE-%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A6%AA%E0%A7%87%E0%A6%AA%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%AF%E0%A6%BC-%E0%A6%AC%E0%A7%8B%E0%A6%A4%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%9B%E0%A6%BF%E0%A6%AA%E0%A6%BF-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B9%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A6%BE%E0%A6%AE</guid>
      <pubDate>Fri, 20 Nov 2026 02:23:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/c614525c45b6dd0583f8fcb180d512ce-6aff4dd240453.jpg?jadewits_media_id=323821" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/c614525c45b6dd0583f8fcb180d512ce-6aff4dd240453.jpg?jadewits_media_id=323821" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/c614525c45b6dd0583f8fcb180d512ce-6aff4dd240453.jpg?jadewits_media_id=323821" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আমরা স্যান্ডপেপার নয়, বোতলের ছিপি ব্যবহার করতাম: বল টেম্পারিং বিতর্কে শোয়েব আখতার" /&gt;&lt;/p&gt;&lt;p&gt;ক্রিকেটে বল টেম্পারিং নিয়ে নতুন করে আলোচনার জন্ম দিয়েছেন অস্ট্রেলিয়ার সাবেক ব্যাটসম্যান উসমান খাজা। তার আত্মজীবনী &amp;lsquo;সবর&amp;rsquo;-এ ২০১৮ সালের কেপটাউন টেস্টে বল টেম্পারিংয়ের ঘটনায় অস্ট্রেলিয়া দলের আরও অনেকের সম্পৃক্ততার দাবি উঠে এসেছে। এই আলোচনা প্রসঙ্গে এবার মুখ খুলেছেন পাকিস্তানের সাবেক পে&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821984/%E0%A6%86%E0%A6%AE%E0%A6%B0%E0%A6%BE-%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A6%AA%E0%A7%87%E0%A6%AA%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%AF%E0%A6%BC-%E0%A6%AC%E0%A7%8B%E0%A6%A4%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%9B%E0%A6%BF%E0%A6%AA%E0%A6%BF-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B9%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A6%BE%E0%A6%AE">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>বিচার হচ্ছিল মিয়ানমারের, ভয়ে ছিল ইসরায়েল: আসিফ নজরুল</title>
      <link>https://www.ittefaq.com.bd/821983/%E0%A6%AC%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AD%E0%A7%9F%E0%A7%87-%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B2-%E0%A6%86%E0%A6%B8%E0%A6%BF%E0%A6%AB</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821983/%E0%A6%AC%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AD%E0%A7%9F%E0%A7%87-%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B2-%E0%A6%86%E0%A6%B8%E0%A6%BF%E0%A6%AB</guid>
      <pubDate>Fri, 20 Nov 2026 01:58:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/aebb3ec827bc691ef0bcb85bebdfa48f-6aff4c6ce35bf.jpg?jadewits_media_id=323820" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/aebb3ec827bc691ef0bcb85bebdfa48f-6aff4c6ce35bf.jpg?jadewits_media_id=323820" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/aebb3ec827bc691ef0bcb85bebdfa48f-6aff4c6ce35bf.jpg?jadewits_media_id=323820" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিচার হচ্ছিল মিয়ানমারের, ভয়ে ছিল ইসরায়েল: আসিফ নজরুল" /&gt;&lt;/p&gt;&lt;p&gt;আন্তর্জাতিক বিচার আদালতে (আইসিজে) রোহিঙ্গাদের বিরুদ্ধে গণহত্যার অভিযোগে মিয়ানমারের বিচার নিয়ে ইসরায়েলও ভয়ে ছিল বলে মন্তব্য করেছেন সাবেক অন্তর্বর্তী সরকারের আইন উপদেষ্টা অধ্যাপক ড. আসিফ নজরুল।
বৃহস্পতিবার (১৯ নভেম্বর) রাতে নিজের ভেরিফায়েড ফেসবুক পেজে দেওয়া এক পোস্টে তিনি এই মন্তব্য করেন।
ফেসবুক&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821983/%E0%A6%AC%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AD%E0%A7%9F%E0%A7%87-%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B2-%E0%A6%86%E0%A6%B8%E0%A6%BF%E0%A6%AB">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>মন্ত্রিপরিষদ বিভাগের কোটায় পাওয়া সরকারি বাসায় ভাড়াটিয়া পাওয়া গেলে বরাদ্দ বাতিল</title>

    <item>
      <title>চীনের মহাকাশ স্টেশনে প্রথম বিদেশি নভোচারী হিসেবে যাচ্ছেন পাকিস্তানি পাইলট</title>
      <link>https://www.ittefaq.com.bd/822862/%E0%A6%9A%E0%A7%80%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B6-%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B6%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF-%E0%A6%A8%E0%A6%AD%E0%A7%8B%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%B9%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822862/%E0%A6%9A%E0%A7%80%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B6-%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B6%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF-%E0%A6%A8%E0%A6%AD%E0%A7%8B%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%B9%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A7%87</guid>
      <pubDate>Wed, 25 Nov 2026 01:04:10 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/8d3661a012b9d919904dcaf4efde17ec-6b05df035af6f.jpg?jadewits_media_id=324707" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/8d3661a012b9d919904dcaf4efde17ec-6b05df035af6f.jpg?jadewits_media_id=324707" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/8d3661a012b9d919904dcaf4efde17ec-6b05df035af6f.jpg?jadewits_media_id=324707" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চীনের মহাকাশ স্টেশনে প্রথম বিদেশি নভোচারী হিসেবে যাচ্ছেন পাকিস্তানি পাইলট" /&gt;&lt;/p&gt;&lt;p&gt;চীনের নিজস্ব মহাকাশ স্টেশন ‘তিয়ানগং’-এ প্রথম বিদেশি নাগরিক হিসেবে পা রাখতে যাচ্ছেন পাকিস্তানের পাইলট জিশান আলী (৪০)। একই সঙ্গে মহাকাশে যাত্রা করা প্রথম পাকিস্তানি নাগরিক হিসেবেও ইতিহাস গড়তে চলেছেন তিনি।
বুধবার (২৫ নভেম্বর) উত্তর-পশ্চিম চীনের জিউকুয়ান উৎক্ষেপণ কেন্দ্র থেকে ‘শেনঝৌ-২৪’ মহাকাশযানে করে ত&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822862/%E0%A6%9A%E0%A7%80%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B6-%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B6%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF-%E0%A6%A8%E0%A6%AD%E0%A7%8B%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%B9%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>আইপিএল নিলামে থাকছেন না মোস্তাফিজ</title>
      <link>https://www.ittefaq.com.bd/822861/%E0%A6%86%E0%A6%87%E0%A6%AA%E0%A6%BF%E0%A6%8F%E0%A6%B2-%E0%A6%A8%E0%A6%BF%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%A8%E0%A6%BE-%E0%A6%AE%E0%A7%8B%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%AB%E0%A6%BF%E0%A6%9C</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822861/%E0%A6%86%E0%A6%87%E0%A6%AA%E0%A6%BF%E0%A6%8F%E0%A6%B2-%E0%A6%A8%E0%A6%BF%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%A8%E0%A6%BE-%E0%A6%AE%E0%A7%8B%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%AB%E0%A6%BF%E0%A6%9C</guid>
      <pubDate>Wed, 25 Nov 2026 00:42:12 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/705a438d3c55345fb8ab5fbd76b8be46-6b05da61ccebe.jpg?jadewits_media_id=324706" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/705a438d3c55345fb8ab5fbd76b8be46-6b05da61ccebe.jpg?jadewits_media_id=324706" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/705a438d3c55345fb8ab5fbd76b8be46-6b05da61ccebe.jpg?jadewits_media_id=324706" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আইপিএল নিলামে থাকছেন না মোস্তাফিজ" /&gt;&lt;/p&gt;&lt;p&gt;আসন্ন ইন্ডিয়ান প্রিমিয়ার লিগের (আইপিএল) নিলামে বাংলাদেশের বাঁহাতি পেসার মোস্তাফিজুর রহমানের থাকা নিয়ে কয়েক দিন ধরে নানা আলোচনা ও গুঞ্জন চললেও শেষ পর্যন্ত নিলামের প্রাথমিক তালিকায় তার নাম জায়গা পায়নি। আগামী ১৬ ডিসেম্বর অনুষ্ঠেয় নিলামের জন্য ফ্র্যাঞ্চাইজিগুলোর কাছে পাঠানো খেলোয়াড়দের প্রাথমিক&lt;/p&gt;</description>

      <guid isPermaLink="true">https://www.ittefaq.com.bd/822496/%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A6%95-%E0%A6%93-%E0%A6%9B%E0%A6%BF%E0%A6%A8%E0%A6%A4%E0%A6%BE%E0%A6%87%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%95%E0%A6%A0%E0%A7%8B%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE</guid>
      <pubDate>Sun, 22 Nov 2026 23:50:33 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/52cf7a3d0fa903812c771555de6edf89-6b032b0ce7de6.jpg?jadewits_media_id=324337" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/52cf7a3d0fa903812c771555de6edf89-6b032b0ce7de6.jpg?jadewits_media_id=324337" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/52cf7a3d0fa903812c771555de6edf89-6b032b0ce7de6.jpg?jadewits_media_id=324337" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নাশকতা, মাদক ও ছিনতাইয়ের বিরুদ্ধে কঠোর ব্যবস্থা নেওয়ার নির্দেশ ডিএমপি কমিশনারের" /&gt;&lt;/p&gt;&lt;p&gt;নাশকতামূলক কর্মকাণ্ড, মাদক, অবৈধ অস্ত্র, ছিনতাই ও চাঁদাবাজির বিরুদ্ধে কঠোর আইনানুগ ব্যবস্থা নেওয়ার নির্দেশ দিয়েছেন ঢাকা মহানগর পুলিশ (ডিএমপি) কমিশনার মোসলেহ্ উদ্দিন আহমদ।
রোববার (২২ নভেম্বর) সকালে ডিএমপি সদর দপ্তরের ষষ্ঠ তলার সম্মেলনকক্ষে অক্টোবর মাসের মাসিক অপরাধ পর্যালোচনা সভায় সভাপতির বক্তব্যে তি&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822496/%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A6%95-%E0%A6%93-%E0%A6%9B%E0%A6%BF%E0%A6%A8%E0%A6%A4%E0%A6%BE%E0%A6%87%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%95%E0%A6%A0%E0%A7%8B%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>গঙ্গা চুক্তির বাস্তবায়ন নিয়ে ঢাকায় জেআরসির শেষ বৈঠক</title>
      <link>https://www.ittefaq.com.bd/822495/%E0%A6%97%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%9A%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%9C%E0%A7%87%E0%A6%86%E0%A6%B0%E0%A6%B8%E0%A6%BF%E0%A6%B0-%E0%A6%B6%E0%A7%87%E0%A6%B7</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822495/%E0%A6%97%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%9A%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%9C%E0%A7%87%E0%A6%86%E0%A6%B0%E0%A6%B8%E0%A6%BF%E0%A6%B0-%E0%A6%B6%E0%A7%87%E0%A6%B7</guid>
      <pubDate>Sun, 22 Nov 2026 23:36:09 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/ea8aade18509326f4e0d911dd686fbca-6b03278f5607c.jpg?jadewits_media_id=324336" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/ea8aade18509326f4e0d911dd686fbca-6b03278f5607c.jpg?jadewits_media_id=324336" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/ea8aade18509326f4e0d911dd686fbca-6b03278f5607c.jpg?jadewits_media_id=324336" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গঙ্গা চুক্তির বাস্তবায়ন নিয়ে ঢাকায় জেআরসির শেষ বৈঠক" /&gt;&lt;/p&gt;&lt;p&gt;৩০ বছর মেয়াদি গঙ্গার পানিবণ্টন চুক্তির নবায়ন নিয়ে অনিশ্চয়তার মধ্যে চুক্তির বাস্তবায়ন পর্যবেক্ষণে ঢাকায় শেষ বৈঠক করেছে বাংলাদেশ ও ভারতের যৌথ কমিটি। রোববার (২২ নভেম্বর) রাজধানীর একটি হোটেলে যৌথ নদী কমিশনের (জেআরসি) সদস্যদের নেতৃত্বে গঠিত এ কমিটির ৯১তম বৈঠক অনুষ্ঠিত হয়।
যৌথ নদী কমিশনের এক বিজ্ঞপ্তিতে জ&lt;/p&gt;</description>

      <guid isPermaLink="true">https://www.ittefaq.com.bd/821521/%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A6%A4%E0%A7%81%E0%A6%B2-%E0%A6%AE%E0%A7%8B%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%B0%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%96%E0%A6%A4%E0%A6%BF%E0%A6%AC%E0%A6%95%E0%A7%87-%E0%A6%A4%E0%A6%93%E0%A6%AC%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%86%E0%A6%AE%E0%A6%BF%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%9C%E0%A6%BE</guid>
      <pubDate>Tue, 17 Nov 2026 17:40:09 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/8fbe852ecb79c216d4b74f4cbbe583e1-6afc3cee33d9e.jpg?jadewits_media_id=323340" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/8fbe852ecb79c216d4b74f4cbbe583e1-6afc3cee33d9e.jpg?jadewits_media_id=323340" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/8fbe852ecb79c216d4b74f4cbbe583e1-6afc3cee33d9e.jpg?jadewits_media_id=323340" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বায়তুল মোকাররমের খতিবকে তওবা করতে বললেন আমির হামজা" /&gt;&lt;/p&gt;&lt;p&gt;বায়তুল মোকাররম জাতীয় মসজিদের খতিব আল্লামা মুফতি আব্দুল মালেকের জামায়াতে ইসলামীকে নিয়ে দেওয়া সাম্প্রতিক বক্তব্যের তীব্র প্রতিবাদ জানিয়েছেন কুষ্টিয়া-৩ আসনের সংসদ সদস্য ও ইসলামি বক্তা মুফতি আমির হামজা। ওই বক্তব্যের জন্য খতিবকে &amp;lsquo;তাওবা&amp;rsquo; করার আহ্বান জানানোর পাশাপাশি হেফাজতে ইসলামের আমির আল্লাম&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821521/%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A6%A4%E0%A7%81%E0%A6%B2-%E0%A6%AE%E0%A7%8B%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%B0%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%96%E0%A6%A4%E0%A6%BF%E0%A6%AC%E0%A6%95%E0%A7%87-%E0%A6%A4%E0%A6%93%E0%A6%AC%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%86%E0%A6%AE%E0%A6%BF%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%9C%E0%A6%BE">দৈনিক ইত্তেফাক</source>

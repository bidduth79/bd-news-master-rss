      <guid isPermaLink="true">https://www.ittefaq.com.bd/820665/%E0%A6%AE%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%B9-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%87%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%87</guid>
      <pubDate>Fri, 13 Nov 2026 02:20:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/0eaad25dee030f11a043fbdfbd7acedc-6af619c6b2192.jpg?jadewits_media_id=322460" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/0eaad25dee030f11a043fbdfbd7acedc-6af619c6b2192.jpg?jadewits_media_id=322460" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/0eaad25dee030f11a043fbdfbd7acedc-6af619c6b2192.jpg?jadewits_media_id=322460" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মা-বাবাসহ পরিবারের সদস্যদের হত্যাচেষ্টার অভিযোগে মামলা করলেন এমপি নুসরাত" /&gt;&lt;/p&gt;&lt;p&gt;কুষ্টিয়ার দৌলতপুর উপজেলায় সংরক্ষিত নারী আসনের সংসদ সদস্য মোছা. নুসরাত তাবাসসুম জ্যোতির পৈতৃক বাড়িতে আগুন ও বিস্ফোরণ ঘটিয়ে তার মা-বাবাসহ পরিবারের সদস্যদের হত্যাচেষ্টার অভিযোগে মামলা দায়ের করা হয়েছে। 
বৃহস্পতিবার (১২ নভেম্বর) রাতে দৌলতপুর থানায় নিজে উপস্থিত হয়ে মামলাটি করেন তিনি। মামলায় নিষিদ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820665/%E0%A6%AE%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%B9-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%87%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>প্রধানমন্ত্রীর নামে ১৩৭টি ভুয়া ফেসবুক অ্যাকাউন্ট ও পেজ শনাক্ত</title>
      <link>https://www.ittefaq.com.bd/820662/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A7%A7%E0%A7%A9%E0%A7%AD%E0%A6%9F%E0%A6%BF-%E0%A6%AD%E0%A7%81%E0%A6%AF%E0%A6%BC%E0%A6%BE-%E0%A6%AB%E0%A7%87%E0%A6%B8%E0%A6%AC%E0%A7%81%E0%A6%95-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%9F</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820662/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A7%A7%E0%A7%A9%E0%A7%AD%E0%A6%9F%E0%A6%BF-%E0%A6%AD%E0%A7%81%E0%A6%AF%E0%A6%BC%E0%A6%BE-%E0%A6%AB%E0%A7%87%E0%A6%B8%E0%A6%AC%E0%A7%81%E0%A6%95-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%9F</guid>
      <pubDate>Fri, 13 Nov 2026 02:00:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/0133f358103b54a168abf4ceaf47268c-6af60b9d7e9e3.jpg?jadewits_media_id=322456" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/0133f358103b54a168abf4ceaf47268c-6af60b9d7e9e3.jpg?jadewits_media_id=322456" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/0133f358103b54a168abf4ceaf47268c-6af60b9d7e9e3.jpg?jadewits_media_id=322456" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রধানমন্ত্রীর নামে ১৩৭টি ভুয়া ফেসবুক অ্যাকাউন্ট ও পেজ শনাক্ত" /&gt;&lt;/p&gt;&lt;p&gt;প্রধানমন্ত্রী তারেক রহমানের নাম ও ছবি ব্যবহার করে খোলা ১৩৭টি ভুয়া ফেসবুক অ্যাকাউন্ট, পেজ ও গ্রুপ শনাক্ত করেছে তথ্য ও সম্প্রচার মন্ত্রণালয়ের ফ্যাক্ট চেকিং প্রতিষ্ঠান &amp;lsquo;বাংলাফ্যাক্ট&amp;rsquo;। 
এ ছাড়া অপপ্রচার ও অপতথ্য ছড়ানোর অভিযোগে ১৯টি ওয়েবসাইট, ৮০০টির বেশি ফেসবুক অ্যাকাউন্ট এবং ১০০টির বেশি এক্&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820662/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A7%A7%E0%A7%A9%E0%A7%AD%E0%A6%9F%E0%A6%BF-%E0%A6%AD%E0%A7%81%E0%A6%AF%E0%A6%BC%E0%A6%BE-%E0%A6%AB%E0%A7%87%E0%A6%B8%E0%A6%AC%E0%A7%81%E0%A6%95-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%9F">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>খুলনায় ছাত্রদল নেতার ভাইকে গুলি করে হত্যা</title>
      <link>https://www.ittefaq.com.bd/820660/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%9A-%E0%A6%95%E0%A6%AE%E0%A6%BF%E0%A6%9F%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%87-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820660/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%9A-%E0%A6%95%E0%A6%AE%E0%A6%BF%E0%A6%9F%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%87-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE</guid>
      <pubDate>Fri, 13 Nov 2026 03:56:58 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/85be9a1d23d84938614801a9df452988-6af608974eb79.jpg?jadewits_media_id=322454" length="0" type="image/jpeg" />

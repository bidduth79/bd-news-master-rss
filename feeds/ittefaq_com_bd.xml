    <item>
      <title>সশস্ত্র গ্রুপে যোগদান করা সহজ, ছেড়ে এসে বেঁচে থাকা কঠিন</title>
      <link>https://www.ittefaq.com.bd/821020/%E0%A6%B8%E0%A6%B6%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%AA%E0%A7%87-%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A6%A6%E0%A6%BE%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A6%BE-%E0%A6%B8%E0%A6%B9%E0%A6%9C-%E0%A6%9B%E0%A7%87%E0%A7%9C%E0%A7%87-%E0%A6%8F%E0%A6%B8%E0%A7%87-%E0%A6%AC%E0%A7%87%E0%A6%81%E0%A6%9A%E0%A7%87-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821020/%E0%A6%B8%E0%A6%B6%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%AA%E0%A7%87-%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A6%A6%E0%A6%BE%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A6%BE-%E0%A6%B8%E0%A6%B9%E0%A6%9C-%E0%A6%9B%E0%A7%87%E0%A7%9C%E0%A7%87-%E0%A6%8F%E0%A6%B8%E0%A7%87-%E0%A6%AC%E0%A7%87%E0%A6%81%E0%A6%9A%E0%A7%87-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%BE</guid>
      <pubDate>Sun, 15 Nov 2026 07:20:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/bc1d00197841cd0ea50064c3fb67ccfb-6af8b6d4c2a85.jpg?jadewits_media_id=322823" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/bc1d00197841cd0ea50064c3fb67ccfb-6af8b6d4c2a85.jpg?jadewits_media_id=322823" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/bc1d00197841cd0ea50064c3fb67ccfb-6af8b6d4c2a85.jpg?jadewits_media_id=322823" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সশস্ত্র গ্রুপে যোগদান করা সহজ, ছেড়ে এসে বেঁচে থাকা কঠিন" /&gt;&lt;/p&gt;&lt;p&gt;পার্বত্য অঞ্চলে জেএসএস (সন্তু) ও জেএসএস (সংস্কার), ইউপিডিএফ (প্রসিত) ও ইউপিডিএফ (সংস্কার) সহ আরও একাধিক সংগঠন চাঁদাবাজি এবং আধিপত্য বিস্তারকে কেন্দ্র করে প্রায়ই সংঘর্ষে লিপ্ত হচ্ছে। সংঘর্ষে উভয় গ্রুপের নেতাকর্মী হতাহত হচ্ছেন। বছরের পর বছর সংঘর্ষে ও হামলায় স্বজনহারারা কী পাচ্ছেন। তাদের কী লাভ? সব পক্&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821020/%E0%A6%B8%E0%A6%B6%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%AA%E0%A7%87-%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A6%A6%E0%A6%BE%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A6%BE-%E0%A6%B8%E0%A6%B9%E0%A6%9C-%E0%A6%9B%E0%A7%87%E0%A7%9C%E0%A7%87-%E0%A6%8F%E0%A6%B8%E0%A7%87-%E0%A6%AC%E0%A7%87%E0%A6%81%E0%A6%9A%E0%A7%87-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%BE">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>গণপিটুনি রোগ হইতে রাষ্ট্র কবে আরোগ্য লাভ করিবে?</title>
      <link>https://www.ittefaq.com.bd/821026/%E0%A6%97%E0%A6%A3%E0%A6%AA%E0%A6%BF%E0%A6%9F%E0%A7%81%E0%A6%A8%E0%A6%BF-%E0%A6%B0%E0%A7%8B%E0%A6%97-%E0%A6%B9%E0%A6%87%E0%A6%A4%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0-%E0%A6%95%E0%A6%AC%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A7%8B%E0%A6%97%E0%A7%8D%E0%A6%AF-%E0%A6%B2%E0%A6%BE%E0%A6%AD-%E0%A6%95%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821026/%E0%A6%97%E0%A6%A3%E0%A6%AA%E0%A6%BF%E0%A6%9F%E0%A7%81%E0%A6%A8%E0%A6%BF-%E0%A6%B0%E0%A7%8B%E0%A6%97-%E0%A6%B9%E0%A6%87%E0%A6%A4%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0-%E0%A6%95%E0%A6%AC%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A7%8B%E0%A6%97%E0%A7%8D%E0%A6%AF-%E0%A6%B2%E0%A6%BE%E0%A6%AD-%E0%A6%95%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A7%87</guid>
      <pubDate>Sun, 15 Nov 2026 06:40:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/23debfec01b6fdcaee4fded103801889-6af8c35394b6d.jpg?jadewits_media_id=322829" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/23debfec01b6fdcaee4fded103801889-6af8c35394b6d.jpg?jadewits_media_id=322829" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/23debfec01b6fdcaee4fded103801889-6af8c35394b6d.jpg?jadewits_media_id=322829" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গণপিটুনি রোগ হইতে রাষ্ট্র কবে আরোগ্য লাভ করিবে?" /&gt;&lt;/p&gt;&lt;p&gt;চোর সন্দেহে একজন মানুষকে ধরিয়া লওয়া হইল। অতঃপর বাঁশ ও তার দিয়া পিটানো, হাত-পা বাঁধিয়া গুদামে লইয়া প্রায় দুই ঘণ্টা নির্যাতন। শেষ পর্যন্ত মৃত্যু। গতকাল ইত্তেফাকের প্রথম পাতায় প্রকাশিত প্রতিবেদনে বলা হইয়াছে, চট্টগ্রামের পতেঙ্গায় ২৬ বৎসর বয়সি মোবারক ইসলামের ভাগ্যে ঠিক এই পরিণতিই ঘটিয়াছে। গত বৃহস্পতিবারে&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821026/%E0%A6%97%E0%A6%A3%E0%A6%AA%E0%A6%BF%E0%A6%9F%E0%A7%81%E0%A6%A8%E0%A6%BF-%E0%A6%B0%E0%A7%8B%E0%A6%97-%E0%A6%B9%E0%A6%87%E0%A6%A4%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0-%E0%A6%95%E0%A6%AC%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A7%8B%E0%A6%97%E0%A7%8D%E0%A6%AF-%E0%A6%B2%E0%A6%BE%E0%A6%AD-%E0%A6%95%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>পাহাড় থেকে সাগরপথে মানব পাচার থামছে না</title>
      <link>https://www.ittefaq.com.bd/821023/%E0%A6%AA%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A7%9C-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%97%E0%A6%B0%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%AC-%E0%A6%AA%E0%A6%BE%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%A5%E0%A6%BE%E0%A6%AE%E0%A6%9B%E0%A7%87-%E0%A6%A8%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821023/%E0%A6%AA%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A7%9C-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%97%E0%A6%B0%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%AC-%E0%A6%AA%E0%A6%BE%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%A5%E0%A6%BE%E0%A6%AE%E0%A6%9B%E0%A7%87-%E0%A6%A8%E0%A6%BE</guid>
      <pubDate>Sun, 15 Nov 2026 06:00:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/b647bab3ef007654486bc9b7d4ed6d24-6af8bcb13556f.jpg?jadewits_media_id=322826" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/b647bab3ef007654486bc9b7d4ed6d24-6af8bcb13556f.jpg?jadewits_media_id=322826" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/b647bab3ef007654486bc9b7d4ed6d24-6af8bcb13556f.jpg?jadewits_media_id=322826" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পাহাড় থেকে সাগরপথে মানব পাচার থামছে না" /&gt;&lt;/p&gt;&lt;p&gt;টেকনাফের গহিন পাহাড় থেকে বঙ্গোপসাগরের উপকূল পর্যন্ত মানবপাচারকারীদের তৎপরতা থামছে না। কখনো চাকরির প্রলোভন, কখনো বিদেশে উন্নত জীবনের স্বপ্ন দেখিয়ে, আবার কখনো অপহরণ করে মানুষকে জিম্মি করা হচ্ছে। পরে তাদের সাগরপথে মালয়েশিয়া ও থাইল্যান্ডে পাঠানোর চেষ্টা চলছে। এই পাচারের শিকার হচ্ছেন বাংলাদেশের বিভিন্ন জ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821023/%E0%A6%AA%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A7%9C-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%97%E0%A6%B0%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%AC-%E0%A6%AA%E0%A6%BE%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%A5%E0%A6%BE%E0%A6%AE%E0%A6%9B%E0%A7%87-%E0%A6%A8%E0%A6%BE">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>মেটাকে প্রায় ১১ হাজার কোটি টাকা জরিমানা করলো ইতালি</title>
      <link>https://www.ittefaq.com.bd/821027/%E0%A6%AE%E0%A7%87%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A7%A7%E0%A7%A7-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%9C%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%8B-%E0%A6%87%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821027/%E0%A6%AE%E0%A7%87%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A7%A7%E0%A7%A7-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%9C%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%8B-%E0%A6%87%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF</guid>
      <pubDate>Sun, 15 Nov 2026 05:24:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/ac691ef7715141b6704b989909cfaec8-6af8c97b519d0.jpg?jadewits_media_id=322830" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/ac691ef7715141b6704b989909cfaec8-6af8c97b519d0.jpg?jadewits_media_id=322830" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/ac691ef7715141b6704b989909cfaec8-6af8c97b519d0.jpg?jadewits_media_id=322830" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মেটাকে প্রায় ১১ হাজার কোটি টাকা জরিমানা করলো ইতালি" /&gt;&lt;/p&gt;&lt;p&gt;ফেসবুক ব্যবহারকারীদের সুস্পষ্ট সম্মতি ছাড়াই তাদের ছবি ব্যবহারের অভিযোগে মেটাকে ৮৮৭ মিলিয়ন মার্কিন ডলার (প্রায় ১১ হাজার কোটি টাকার বেশি) জরিমানা করেছে ইতালি।&amp;nbsp;
শনিবার (১৪ নভেম্বর) ইতালির ডেটা প্রাইভেসি অথরিটি &amp;lsquo;গারান্তে&amp;rsquo; এ তথ্য জানিয়েছে।&amp;nbsp;
তারা বলেছে, অ্যান্ড্রয়েড ডিভাইসে থাকা &lt;/p&gt;</description>

      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/2b73c323c49cd53c4c7dc57a3ea48084-6af772131a7f2.jpg?jadewits_media_id=322651" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/2b73c323c49cd53c4c7dc57a3ea48084-6af772131a7f2.jpg?jadewits_media_id=322651" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যুক্তরাষ্ট্রের ভিসা জটিলতায় মিস ইউনিভার্সে অনিশ্চিত আফ্রিকার সুন্দরীদের" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাষ্ট্রের কঠোর ভিসা বিধিনিষেধের কারণে এবারের ৭৫তম মিস ইউনিভার্স প্রতিযোগিতায় অংশগ্রহণ নিয়ে চরম অনিশ্চয়তায় পড়েছেন জিম্বাবুয়ে ও দক্ষিণ সুদানসহ আফ্রিকার অন্তত পাঁচটি দেশের প্রতিনিধিরা। ভিসা না পাওয়ায় জিম্বাবুয়ের প্রতিনিধি রোজানা হলের অংশগ্রহণ নিয়ে শঙ্কা তৈরি হয়েছে, আর একই কারণে প্রতিযোগিতা থেকে &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820856/%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AD%E0%A6%BF%E0%A6%B8%E0%A6%BE-%E0%A6%9C%E0%A6%9F%E0%A6%BF%E0%A6%B2%E0%A6%A4%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A6%BF%E0%A6%B8-%E0%A6%87%E0%A6%89%E0%A6%A8%E0%A6%BF%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B8%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>

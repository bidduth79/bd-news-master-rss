      <guid isPermaLink="true">https://www.ittefaq.com.bd/822864/%E0%A6%96%E0%A6%BF%E0%A6%B2%E0%A6%97%E0%A6%BE%E0%A6%81%E0%A6%93%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%98%E0%A6%9F%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A7%8B%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A6%AF%E0%A6%BC-%E0%A6%8F%E0%A6%95%E0%A6%9C%E0%A6%A8</guid>
      <pubDate>Wed, 25 Nov 2026 01:30:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/b291e3240539f1a1bc4ed411f15c21c0-6b05e3ec583d1.jpg?jadewits_media_id=324709" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/b291e3240539f1a1bc4ed411f15c21c0-6b05e3ec583d1.jpg?jadewits_media_id=324709" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/b291e3240539f1a1bc4ed411f15c21c0-6b05e3ec583d1.jpg?jadewits_media_id=324709" style="max-width:100%;height:auto;margin-bottom:10px;" alt="খিলগাঁওয়ে ককটেল বিস্ফোরণ ঘটিয়ে পালানোর সময় একজন আটক" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর খিলগাঁওয়ের তালতলা মার্কেট এলাকায় ককটেল বিস্ফোরণ ঘটিয়ে পালিয়ে যাওয়ার সময় মো. মাজহারুল (৩২) নামে এক ব্যক্তিকে আটক করেছে পুলিশ। মঙ্গলবার (২৪ নভেম্বর) ঢাকা মেট্রোপলিটন পুলিশের (ডিএমপি) মিডিয়া অ্যান্ড পাবলিক রিলেশনস বিভাগের উপ-পুলিশ কমিশনার মো. আকতার হোসেন এ তথ্য নিশ্চিত করেছেন।
খিলগাঁও থ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822864/%E0%A6%96%E0%A6%BF%E0%A6%B2%E0%A6%97%E0%A6%BE%E0%A6%81%E0%A6%93%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%98%E0%A6%9F%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A7%8B%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A6%AF%E0%A6%BC-%E0%A6%8F%E0%A6%95%E0%A6%9C%E0%A6%A8">দৈনিক ইত্তেফাক</source>

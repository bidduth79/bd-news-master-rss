      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/70224a237f1b4ba33f0c02b8127f9c4e-6aff385c2d483.jpg?jadewits_media_id=323812" medium="image" />

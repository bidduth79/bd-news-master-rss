      <guid isPermaLink="true">https://www.ittefaq.com.bd/822192/%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%9F-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%97%E0%A6%BF%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A7%87%E0%A6%B0%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A7%9F%E0%A6%A6%E0%A6%B0%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A7%87-%E0%A6%AE%E0%A7%87%E0%A6%9F%E0%A6%BE-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87</guid>
      <pubDate>Sat, 21 Nov 2026 14:19:04 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/c8821f6ceb1663c6deb5a8c66212bf12-6b015247f03fb.jpg?jadewits_media_id=324030" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/c8821f6ceb1663c6deb5a8c66212bf12-6b015247f03fb.jpg?jadewits_media_id=324030" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/c8821f6ceb1663c6deb5a8c66212bf12-6b015247f03fb.jpg?jadewits_media_id=324030" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অ্যাকাউন্ট স্থগিতের জেরে হায়দরাবাদে মেটা কার্যালয়ে ভাঙচুর" /&gt;&lt;/p&gt;&lt;p&gt;সোশাল মিডিয়ায় যুব কংগ্রেসের দুই নেতার অ্যাকাউন্টে বিধিনিষেধ আরোপের প্রতিবাদে ভারতের হায়দরাবাদে মেটা কার্যালয়ে হামলা চালিয়েছেন তেলেঙ্গানা যুব কংগ্রেসের কর্মীরা।
এনডিটিভির প্রতিবেদন অনুযায়ী, শুক্রবারের (২০ নভেম্বর) এ হামলায় বিক্ষোভকারীদের কার্যালয় প্রাঙ্গণে থাকা ফুলের টব ছুড়ে মারতে ও ভাঙচুর করতে দেখা &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822192/%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%9F-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%97%E0%A6%BF%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A7%87%E0%A6%B0%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A7%9F%E0%A6%A6%E0%A6%B0%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A7%87-%E0%A6%AE%E0%A7%87%E0%A6%9F%E0%A6%BE-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>বিএনপির ধাওয়ায় মশাল-ককটেল ফেলে পালালেন আওয়ামী লীগের নেতাকর্মীরা</title>
      <link>https://www.ittefaq.com.bd/822191/%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%A7%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A6%B6%E0%A6%BE%E0%A6%B2-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AB%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822191/%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%A7%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A6%B6%E0%A6%BE%E0%A6%B2-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AB%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80</guid>
      <pubDate>Sat, 21 Nov 2026 14:18:22 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/2409c077de3bbf2d89df6f136dd0072e-6b01535db1641.jpg?jadewits_media_id=324031" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/2409c077de3bbf2d89df6f136dd0072e-6b01535db1641.jpg?jadewits_media_id=324031" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/2409c077de3bbf2d89df6f136dd0072e-6b01535db1641.jpg?jadewits_media_id=324031" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিএনপির ধাওয়ায় মশাল-ককটেল ফেলে পালালেন আওয়ামী লীগের নেতাকর্মীরা" /&gt;&lt;/p&gt;&lt;p&gt;বগুড়ার নন্দীগ্রামে কার্যক্রম নিষিদ্ধ আওয়ামী লীগের নেতাকর্মীদের মশালমিছিলে বিএনপির নেতাকর্মীরা ধাওয়া দেন। এ সময় দুটি ককটেলের বিস্ফোরণ ঘটে এবং ঘটনাস্থল থেকে জ্বলন্ত অবস্থায় আটটি মশাল ও একটি অবিস্ফোরিত ককটেল উদ্ধার করে পুলিশ।
শুক্রবার (২০ নভেম্বর) রাত ১১টার দিকে উপজেলার রনবাঘা বাইপাস এলাকায় এ ঘটনা ঘটে।&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822191/%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%A7%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A6%B6%E0%A6%BE%E0%A6%B2-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AB%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>‘ক্ষুধার যন্ত্রণায় খেজুরের বিচি আট দিন মুখে রেখেছিলাম’</title>
      <link>https://www.ittefaq.com.bd/822190/%E2%80%98%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%81%E0%A6%A7%E0%A6%BE%E0%A6%B0-%E0%A6%AF%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A3%E0%A6%BE%E0%A7%9F-%E0%A6%96%E0%A7%87%E0%A6%9C%E0%A7%81%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%9A%E0%A6%BF-%E0%A6%86%E0%A6%9F-%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822190/%E2%80%98%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%81%E0%A6%A7%E0%A6%BE%E0%A6%B0-%E0%A6%AF%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A3%E0%A6%BE%E0%A7%9F-%E0%A6%96%E0%A7%87%E0%A6%9C%E0%A7%81%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%9A%E0%A6%BF-%E0%A6%86%E0%A6%9F-%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%87</guid>
      <pubDate>Sat, 21 Nov 2026 14:09:37 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/9c525af8e5d9999edae2d5c8d5a2f1eb-6b0150262d8c9.jpg?jadewits_media_id=324028" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/9c525af8e5d9999edae2d5c8d5a2f1eb-6b0150262d8c9.jpg?jadewits_media_id=324028" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/9c525af8e5d9999edae2d5c8d5a2f1eb-6b0150262d8c9.jpg?jadewits_media_id=324028" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘ক্ষুধার যন্ত্রণায় খেজুরের বিচি আট দিন মুখে রেখেছিলাম’" /&gt;&lt;/p&gt;&lt;p&gt;প্রচণ্ড ঢেউ, নৌকার ইঞ্জিন বিকল, খাবার ও পানির সংকট&amp;mdash;সব মিলিয়ে ভূমধ্যসাগরে আট দিনের বেশি সময় কাটাতে হয়েছে বাংলাদেশি অভিবাসী তুফায়েল আহমেদ ফাহিমকে। এ সময় চোখের সামনে সহযাত্রীদের হারিয়ে যেতে দেখেছেন তিনি। নৌকার চালকেরা দুই বাংলাদেশিকে সাগরে ফেলে দিয়েছিলেন বলেও অভিযোগ করেছেন ফাহিম।
গ্রিসের একটি ক্য&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822190/%E2%80%98%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%81%E0%A6%A7%E0%A6%BE%E0%A6%B0-%E0%A6%AF%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A3%E0%A6%BE%E0%A7%9F-%E0%A6%96%E0%A7%87%E0%A6%9C%E0%A7%81%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%9A%E0%A6%BF-%E0%A6%86%E0%A6%9F-%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%87">দৈনিক ইত্তেফাক</source>

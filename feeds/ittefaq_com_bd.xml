      <link>https://www.ittefaq.com.bd/821297/%E0%A6%AA%E0%A6%BE%E0%A6%81%E0%A6%9A-%E0%A6%A7%E0%A6%BE%E0%A6%AA%E0%A7%87-%E0%A6%B9%E0%A6%AC%E0%A7%87-%E0%A6%87%E0%A6%89%E0%A6%AA%E0%A6%BF-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%9A%E0%A6%A8-%E0%A6%A6%E0%A6%B2%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A7%8B%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%AA</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821297/%E0%A6%AA%E0%A6%BE%E0%A6%81%E0%A6%9A-%E0%A6%A7%E0%A6%BE%E0%A6%AA%E0%A7%87-%E0%A6%B9%E0%A6%AC%E0%A7%87-%E0%A6%87%E0%A6%89%E0%A6%AA%E0%A6%BF-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%9A%E0%A6%A8-%E0%A6%A6%E0%A6%B2%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A7%8B%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%AA</guid>
      <pubDate>Mon, 16 Nov 2026 14:25:17 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/86ae69dae7c4a152df6512f813d6bef7-6afabd9717e3b.png?jadewits_media_id=323106" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/86ae69dae7c4a152df6512f813d6bef7-6afabd9717e3b.png?jadewits_media_id=323106" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/86ae69dae7c4a152df6512f813d6bef7-6afabd9717e3b.png?jadewits_media_id=323106" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পাঁচ ধাপে হবে ইউপি নির্বাচন, দলগুলোর সঙ্গে সংলাপ ১০ ডিসেম্বরের মধ্যে" /&gt;&lt;/p&gt;&lt;p&gt;দেশের ৪ হাজার ৩০০টি ইউনিয়ন পরিষদে (ইউপি) পাঁচ ধাপে নির্বাচন আয়োজনের সিদ্ধান্ত নিয়েছে নির্বাচন কমিশন (ইসি)। পাশাপাশি স্থানীয় সরকার নির্বাচনকে কেন্দ্র করে নিবন্ধিত সব রাজনৈতিক দলের সঙ্গে সংলাপে বসবে কমিশন, যা আগামী ১০ ডিসেম্বরের মধ্যে সম্পন্ন করা হবে।

সোমবার (১৬ নভেম্বর) নির্বাচন ভবনে কমিশন সভা শ&lt;/p&gt;</description>

    <item>
      <title>দুর্নীতির তদন্তে হাঙ্গেরির সাবেক মন্ত্রীর খামারবাড়ি ও মাটির নিচে মিলল ২০ মিলিয়ন ডলার</title>
      <link>https://www.ittefaq.com.bd/821185/%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%A4%E0%A6%A6%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87%E0%A6%B0%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821185/%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%A4%E0%A6%A6%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87%E0%A6%B0%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0</guid>
      <pubDate>Sun, 15 Nov 2026 21:55:18 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/c085f3dd39749cfcd87750e7a2c2125c-6af9d52b09a0e.jpg?jadewits_media_id=322998" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/c085f3dd39749cfcd87750e7a2c2125c-6af9d52b09a0e.jpg?jadewits_media_id=322998" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/c085f3dd39749cfcd87750e7a2c2125c-6af9d52b09a0e.jpg?jadewits_media_id=322998" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দুর্নীতির তদন্তে হাঙ্গেরির সাবেক মন্ত্রীর খামারবাড়ি ও মাটির নিচে মিলল ২০ মিলিয়ন ডলার" /&gt;&lt;/p&gt;&lt;p&gt;হাঙ্গেরির সাবেক প্রধানমন্ত্রী ভিক্টর অরবানের সরকারের এক সাবেক মন্ত্রীর বিরুদ্ধে দুর্নীতির তদন্তে বিপুল পরিমাণ নগদ অর্থ উদ্ধার করেছে দেশটির কর্তৃপক্ষ। খামারবাড়ির বিভিন্ন ভবন ও বনের মাটির নিচে লুকিয়ে রাখা অবস্থায় প্রায় ২ কোটি ডলার পাওয়া গেছে।
তদন্তসংশ্লিষ্ট কর্মকর্তারা জানিয়েছেন, সাবেক জাতীয় উন্নয়নমন্&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821185/%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%A4%E0%A6%A6%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87%E0%A6%B0%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>সন্তানকে নিয়ে মোটরসাইকেল চালিয়ে যাচ্ছিলেন বাবা, পথরোধ করে কু’পিয়ে হ’ত্যা</title>
      <link>https://www.ittefaq.com.bd/821184/%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AE%E0%A7%8B%E0%A6%9F%E0%A6%B0%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%87%E0%A6%B2-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821184/%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AE%E0%A7%8B%E0%A6%9F%E0%A6%B0%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%87%E0%A6%B2-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A6%BE</guid>
      <pubDate>Sun, 15 Nov 2026 21:54:04 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/2cbbc8685b37c64b72d3927ccdb6dc30-6af9d525c7e43.jpg?jadewits_media_id=322997" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/2cbbc8685b37c64b72d3927ccdb6dc30-6af9d525c7e43.jpg?jadewits_media_id=322997" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/2cbbc8685b37c64b72d3927ccdb6dc30-6af9d525c7e43.jpg?jadewits_media_id=322997" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সন্তানকে নিয়ে মোটরসাইকেল চালিয়ে যাচ্ছিলেন বাবা, পথরোধ করে কু’পিয়ে হ’ত্যা" /&gt;&lt;/p&gt;&lt;p&gt;ময়মনসিংহ মহানগরীতে দুর্বৃত্তের ধারালো অস্ত্রের আঘাতে মো. জামান (৩৫) নামে এক যুবককে হত্যার ঘটনা ঘটেছে। নিহত জামান স্থানীয় স্বেচ্ছাসেবক দলের রাজনীতিতে জড়িত ছিলে বলে জানিয়েছে পুলিশ।
রোববার (১৫ নভেম্বর) সন্ধ্যা ৭টার দিকে ময়মনসিংহ মহানগরীর ২৬ নম্বর ওয়ার্ড সংলগ্ন কোতোয়ালী থানার মধ্য বারেরা মজিদ মার্কেট এল&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821184/%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AE%E0%A7%8B%E0%A6%9F%E0%A6%B0%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%87%E0%A6%B2-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A6%BE">দৈনিক ইত্তেফাক</source>
    </item>

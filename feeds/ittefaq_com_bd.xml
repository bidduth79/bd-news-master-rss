      <guid isPermaLink="true">https://www.ittefaq.com.bd/822196/%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%95-%E0%A6%93-%E0%A6%B8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AA%E0%A6%9F%E0%A7%87%E0%A6%93-%E0%A6%AA%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%81%E0%A6%B7%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A7%8E%E0%A6%B6%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%AA</guid>
      <pubDate>Sat, 21 Nov 2026 14:38:12 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/55972b3a3ec493513fb8be9b8005b458-6b01584914356.jpg?jadewits_media_id=324035" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/55972b3a3ec493513fb8be9b8005b458-6b01584914356.jpg?jadewits_media_id=324035" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/55972b3a3ec493513fb8be9b8005b458-6b01584914356.jpg?jadewits_media_id=324035" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্লাস্টিক ও সিরামিকের দাপটেও পূর্বপুরুষের মৃৎশিল্প বাঁচিয়ে রেখেছেন সিরাজগঞ্জের কারিগরেরা" /&gt;&lt;/p&gt;&lt;p&gt;আধুনিকতার প্রভাবে প্লাস্টিক, স্টিল ও সিরামিক পণ্যের ব্যবহার বাড়ায় সংকুচিত হয়ে পড়েছে মাটির তৈজসপত্রের বাজার। তবুও নানা প্রতিকূলতা উপেক্ষা করে পূর্বপুরুষের পেশা ও গ্রামীণ ঐতিহ্য ধরে রেখেছেন সিরাজগঞ্জের সলঙ্গা এলাকার মৃৎশিল্পীরা।
স্থানীয় কারিগরেরা প্রতিনিয়ত মাটির টব, হাঁড়ি-পাতিল, দইয়ের বাটিসহ ব&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822196/%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%95-%E0%A6%93-%E0%A6%B8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AA%E0%A6%9F%E0%A7%87%E0%A6%93-%E0%A6%AA%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%81%E0%A6%B7%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A7%8E%E0%A6%B6%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%AA">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>রোহিঙ্গাদের বাঙালি বলেই দাবি করল মিয়ানমার</title>

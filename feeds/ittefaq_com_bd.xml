      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/c06f34aebc072169dbb9836070c2e878-6af3477519f96.jpg?jadewits_media_id=322022" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/c06f34aebc072169dbb9836070c2e878-6af3477519f96.jpg?jadewits_media_id=322022" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/c06f34aebc072169dbb9836070c2e878-6af3477519f96.jpg?jadewits_media_id=322022" style="max-width:100%;height:auto;margin-bottom:10px;" alt="উখিয়ার সেই কূপে ১৫ দিনেও নেভেনি আগুন, মজুত অনুসন্ধান করবে বাপেক্স" /&gt;&lt;/p&gt;&lt;p&gt;কক্সবাজারের উখিয়ার ইনানীতে নলকূপ স্থাপনের সময় মাটির নিচ থেকে বেরিয়ে আসা গ্যাসের আগুন ১৫ দিন ধরে জ্বলছে। দীর্ঘ সময় পার হলেও গ্যাসের প্রবাহে উল্লেখযোগ্য কোনো পরিবর্তন দেখা যায়নি। এ অবস্থায় প্রথমে অনিয়ন্ত্রিত গ্যাসপ্রবাহ বন্ধ করে নিরাপত্তা নিশ্চিত করার পরিকল্পনা করছে বাংলাদেশ পেট্রোলিয়াম এক্সপ্লোরেশন অ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820235/%E0%A6%89%E0%A6%96%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A7%A7%E0%A7%AB-%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%A7%E0%A6%B0%E0%A7%87-%E0%A6%9C%E0%A7%8D%E0%A6%AC%E0%A6%B2%E0%A6%9B%E0%A7%87-%E0%A6%97%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%AE%E0%A6%9C%E0%A7%81%E0%A6%A4">দৈনিক ইত্তেফাক</source>
    </item>

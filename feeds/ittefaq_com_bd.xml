      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/4a1a0b9da47075f1c3671dfb50524187-6afc9521c8032.jpg?jadewits_media_id=323412" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/4a1a0b9da47075f1c3671dfb50524187-6afc9521c8032.jpg?jadewits_media_id=323412" medium="image" />

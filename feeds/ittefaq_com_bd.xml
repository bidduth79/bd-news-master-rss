      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/3baed82e91f2166286fb63615466723f-6b05e290a80cc.jpg?jadewits_media_id=324708" length="0" type="image/jpeg" />

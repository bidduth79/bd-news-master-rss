      <guid isPermaLink="true">https://www.ittefaq.com.bd/820033/%E0%A6%86%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%B0%E0%A7%87-%E0%A7%AC-%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B2%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE-%E0%A6%97%E0%A6%BE%E0%A6%A8%E0%A6%AA%E0%A6%BE%E0%A6%89%E0%A6%A1%E0%A6%BE%E0%A6%B0%E0%A6%B8%E0%A6%B9-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%87</guid>
      <pubDate>Tue, 10 Nov 2026 04:42:59 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/efc31cc3575c173fe5d3afd8faeed28e-6af21f827abf0.jpg?jadewits_media_id=321806" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/efc31cc3575c173fe5d3afd8faeed28e-6af21f827abf0.jpg?jadewits_media_id=321806" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/efc31cc3575c173fe5d3afd8faeed28e-6af21f827abf0.jpg?jadewits_media_id=321806" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আদাবরে ৬ পেট্রোলবোমা-গানপাউডারসহ ছাত্রলীগের দুই নেতা গ্রেপ্তার" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর আদাবর থানাধীন শ্যামলী রিং রোড এলাকা থেকে ছয়টি পেট্রোলবোমা এবং ৯৫০ গ্রাম গানপাউডারসহ নিষিদ্ধঘোষিত সংগঠন বাংলাদেশ ছাত্রলীগের দুই নেতাকে গ্রেপ্তার করেছে এসআরবি-২। 
সোমবার (৯ নভেম্বর) এসআরবি-২ এর উপপরিচালক (মিডিয়া) মেজর এম মুবীন রহমান তাপস গণমাধ্যমকে এ তথ্য নিশ্চিত করেছেন।
গ্রেপ্তার ব্যক্তিরা হ&lt;/p&gt;</description>

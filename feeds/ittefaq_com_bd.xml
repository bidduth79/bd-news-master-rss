      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/0478cdbdcf7356bbc8118a3fbb4da187-6b07a99f249b0.jpg?jadewits_media_id=324922" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/0478cdbdcf7356bbc8118a3fbb4da187-6b07a99f249b0.jpg?jadewits_media_id=324922" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/0478cdbdcf7356bbc8118a3fbb4da187-6b07a99f249b0.jpg?jadewits_media_id=324922" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হোয়াটসঅ্যাপে আসছে ‘ডুয়াল ক্যামেরা মোড’" /&gt;&lt;/p&gt;&lt;p&gt;কোনো অনুষ্ঠান বা ভ্রমণের দৃশ্য ধারণের পাশাপাশি একই ভিডিওতে নিজের অভিব্যক্তিও তুলে ধরতে নতুন ফিচার আনছে হোয়াটসঅ্যাপ। &amp;lsquo;ডুয়াল ক্যামেরা মোড&amp;rsquo; নামের এই সুবিধায় ফোনের সামনের ও পেছনের ক্যামেরা ব্যবহার করে একই সময়ে ছবি ও ভিডিও ধারণ করা যাবে। ফলে আলাদা করে নিজের প্রতিক্রিয়া রেকর্ড করার প্রয়োজন হবে&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823048/%E0%A6%B9%E0%A7%8B%E0%A7%9F%E0%A6%BE%E0%A6%9F%E0%A6%B8%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AA%E0%A7%87-%E0%A6%86%E0%A6%B8%E0%A6%9B%E0%A7%87-%E2%80%98%E0%A6%A1%E0%A7%81%E0%A7%9F%E0%A6%BE%E0%A6%B2-%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%B0%E0%A6%BE-%E0%A6%AE%E0%A7%8B%E0%A6%A1%E2%80%99">দৈনিক ইত্তেফাক</source>

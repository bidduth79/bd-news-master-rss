    <item>
      <title>২৫ কোটি পাঠ্যবই ছাপা শেষ, বাকি আছে ৬ কোটি</title>
      <link>https://www.ittefaq.com.bd/820851/%E0%A7%A8%E0%A7%AB-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%AA%E0%A6%BE%E0%A6%A0%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%87%C2%A0%E0%A6%9B%E0%A6%BE%E0%A6%AA%E0%A6%BE-%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%AC%E0%A6%BE%E0%A6%95%E0%A6%BF%C2%A0%E0%A6%86%E0%A6%9B%E0%A7%87-%E0%A7%AC-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820851/%E0%A7%A8%E0%A7%AB-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%AA%E0%A6%BE%E0%A6%A0%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%87%C2%A0%E0%A6%9B%E0%A6%BE%E0%A6%AA%E0%A6%BE-%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%AC%E0%A6%BE%E0%A6%95%E0%A6%BF%C2%A0%E0%A6%86%E0%A6%9B%E0%A7%87-%E0%A7%AC-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF</guid>
      <pubDate>Sat, 14 Nov 2026 04:00:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/05/23/4a3024f564cf8d05e58a0608ab7576a1-6a10a0035faa3.jpg?jadewits_media_id=290058" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/05/23/4a3024f564cf8d05e58a0608ab7576a1-6a10a0035faa3.jpg?jadewits_media_id=290058" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/05/23/4a3024f564cf8d05e58a0608ab7576a1-6a10a0035faa3.jpg?jadewits_media_id=290058" style="max-width:100%;height:auto;margin-bottom:10px;" alt="২৫ কোটি পাঠ্যবই ছাপা শেষ, বাকি আছে ৬ কোটি" /&gt;&lt;/p&gt;&lt;p&gt;আগামী শিক্ষাবর্ষের বিনা মূল্যের পাঠ্যবই এবার আগেভাগেই পাচ্ছে শিক্ষার্থীরা। জাতীয় শিক্ষাক্রম ও পাঠ্যপুস্তক বোর্ড (এনসিটিবি) সূত্রে জানা গেছে, গতকাল শুক্রবার পর্যন্ত প্রায় ২৫ কোটি পাঠ্যবই ছাপা হয়েছে। এখনো প্রায় ৬ কোটি বই ছাপা বাকি আছে। আগামী মাসে বার্ষিক পরীক্ষার ফল ঘোষণার দিনই শিক্ষার্থীদের হাতে নতুন&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820851/%E0%A7%A8%E0%A7%AB-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%AA%E0%A6%BE%E0%A6%A0%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%87%C2%A0%E0%A6%9B%E0%A6%BE%E0%A6%AA%E0%A6%BE-%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%AC%E0%A6%BE%E0%A6%95%E0%A6%BF%C2%A0%E0%A6%86%E0%A6%9B%E0%A7%87-%E0%A7%AC-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>যুক্তরাষ্ট্রের ভিসা জটিলতায় মিস ইউনিভার্সে অনিশ্চিত আফ্রিকার সুন্দরীদের</title>

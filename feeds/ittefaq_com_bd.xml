    <item>
      <title>সৌদির নিরাপত্তা শক্তিশালী করতে মক্কা জোট প্রতিশ্রুতিবদ্ধ: পাকিস্তানের পররাষ্ট্রমন্ত্রী</title>
      <link>https://www.ittefaq.com.bd/823323/%E0%A6%B8%E0%A7%8C%E0%A6%A6%E0%A6%BF%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BE-%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B6%E0%A6%BE%E0%A6%B2%E0%A7%80-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%AE%E0%A6%95%E0%A7%8D%E0%A6%95%E0%A6%BE-%E0%A6%9C%E0%A7%8B%E0%A6%9F</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823323/%E0%A6%B8%E0%A7%8C%E0%A6%A6%E0%A6%BF%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BE-%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B6%E0%A6%BE%E0%A6%B2%E0%A7%80-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%AE%E0%A6%95%E0%A7%8D%E0%A6%95%E0%A6%BE-%E0%A6%9C%E0%A7%8B%E0%A6%9F</guid>
      <pubDate>Fri, 27 Nov 2026 23:52:57 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/3fa3acbfd9bfb7985b6d523eb6361487-6b09c37222ba0.jpg?jadewits_media_id=325219" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/3fa3acbfd9bfb7985b6d523eb6361487-6b09c37222ba0.jpg?jadewits_media_id=325219" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/3fa3acbfd9bfb7985b6d523eb6361487-6b09c37222ba0.jpg?jadewits_media_id=325219" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সৌদির নিরাপত্তা শক্তিশালী করতে মক্কা জোট প্রতিশ্রুতিবদ্ধ: পাকিস্তানের পররাষ্ট্রমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;ইয়েমেনের হুথি বিদ্রোহীদের হামলার মধ্যে সৌদি আরবের নিরাপত্তা পরিস্থিতি নিয়ে বৈঠক করেছেন মক্কা প্রতিরক্ষা জোটের তিন সদস্যদেশ সৌদি আরব, তুরস্ক ও পাকিস্তানের পররাষ্ট্রমন্ত্রীরা। পাকিস্তানের রাজধানী ইসলামাবাদে অনুষ্ঠিত এ বৈঠক শেষে দেশটির পররাষ্ট্রমন্ত্রী ইসহাক দার বলেছেন, সৌদি আরবের নিরাপত্তা জোরদারে প্র&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823323/%E0%A6%B8%E0%A7%8C%E0%A6%A6%E0%A6%BF%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BE-%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B6%E0%A6%BE%E0%A6%B2%E0%A7%80-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%AE%E0%A6%95%E0%A7%8D%E0%A6%95%E0%A6%BE-%E0%A6%9C%E0%A7%8B%E0%A6%9F">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>বোরকা পরে গ্যাস কারখানায় ডাকাতি, লুট আড়াই টন তামার তার</title>
      <link>https://www.ittefaq.com.bd/823322/%E0%A6%AC%E0%A7%8B%E0%A6%B0%E0%A6%95%E0%A6%BE-%E0%A6%AA%E0%A6%B0%E0%A7%87-%E0%A6%97%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B8-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%A1%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%A4%E0%A6%BF-%E0%A6%B2%E0%A7%81%E0%A6%9F-%E0%A6%86%E0%A6%A1%E0%A6%BC%E0%A6%BE%E0%A6%87-%E0%A6%9F%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823322/%E0%A6%AC%E0%A7%8B%E0%A6%B0%E0%A6%95%E0%A6%BE-%E0%A6%AA%E0%A6%B0%E0%A7%87-%E0%A6%97%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B8-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%A1%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%A4%E0%A6%BF-%E0%A6%B2%E0%A7%81%E0%A6%9F-%E0%A6%86%E0%A6%A1%E0%A6%BC%E0%A6%BE%E0%A6%87-%E0%A6%9F%E0%A6%A8</guid>
      <pubDate>Fri, 27 Nov 2026 23:32:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/a97955e8f19c59a42d92cfc3c8047ad8-6b09bb13b9f36.jpg?jadewits_media_id=325217" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/a97955e8f19c59a42d92cfc3c8047ad8-6b09bb13b9f36.jpg?jadewits_media_id=325217" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/a97955e8f19c59a42d92cfc3c8047ad8-6b09bb13b9f36.jpg?jadewits_media_id=325217" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বোরকা পরে গ্যাস কারখানায় ডাকাতি, লুট আড়াই টন তামার তার" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রামের সীতাকুণ্ডে একটি গ্যাস কারখানায় অভিনব কায়দায় ডাকাতির ঘটনা ঘটেছে। বৃহস্পতিবার (২৬ নভেম্বর) দিবাগত রাত তিনটার দিকে উপজেলার বাড়বকুণ্ড ইউনিয়নের মান্দারীটোলা এলাকায় বেড়িবাঁধসংলগ্ন ইউরো গ্যাস কারখানায় হানা দেয় ডাকাত দল। এতে নগদ টাকা ও প্রায় আড়াই টন তামার তার লুট করে নিয়ে গেছে বলে দাব&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823322/%E0%A6%AC%E0%A7%8B%E0%A6%B0%E0%A6%95%E0%A6%BE-%E0%A6%AA%E0%A6%B0%E0%A7%87-%E0%A6%97%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B8-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%A1%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%A4%E0%A6%BF-%E0%A6%B2%E0%A7%81%E0%A6%9F-%E0%A6%86%E0%A6%A1%E0%A6%BC%E0%A6%BE%E0%A6%87-%E0%A6%9F%E0%A6%A8">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>বিগত ১৭ বছরে বিরোধীমতের সাড়ে ৪ হাজার মানুষকে বিচারবহির্ভূত হত্যা করা হয়েছে: আইনমন্ত্রী</title>
      <link>https://www.ittefaq.com.bd/823321/%E0%A6%AC%E0%A6%BF%E0%A6%97%E0%A6%A4-%E0%A7%A7%E0%A7%AD-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%80%E0%A6%AE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A7%9C%E0%A7%87-%E0%A7%AA-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A6%95%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823321/%E0%A6%AC%E0%A6%BF%E0%A6%97%E0%A6%A4-%E0%A7%A7%E0%A7%AD-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%80%E0%A6%AE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A7%9C%E0%A7%87-%E0%A7%AA-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A6%95%E0%A7%87</guid>
      <pubDate>Fri, 27 Nov 2026 23:14:22 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/9ebd5708bb92f8d7c63079408777f2db-6b09ba5c7cf32.jpg?jadewits_media_id=325216" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/9ebd5708bb92f8d7c63079408777f2db-6b09ba5c7cf32.jpg?jadewits_media_id=325216" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/9ebd5708bb92f8d7c63079408777f2db-6b09ba5c7cf32.jpg?jadewits_media_id=325216" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিগত ১৭ বছরে বিরোধীমতের সাড়ে ৪ হাজার মানুষকে বিচারবহির্ভূত হত্যা করা হয়েছে: আইনমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;আইন, বিচার ও সংসদ বিষয়ক মন্ত্রী মো. আসাদুজ্জামান বলেছেন, বিগত ১৭ বছরে বিএনপির নেতাকর্মীসহ বিরোধীমতের সাড়ে ৪ হাজার মানুষকে বিচারবহির্ভূতভাবে হত্যা করা হয়েছে।&amp;nbsp;তিনি বলেন, আওয়ামী লীগ (বর্তমানে কার্যক্রম নিষিদ্ধ) সরকারের আমলে ৭০০ জনকে গুম করা হয়েছে। বিএনপির প্রায় ৬০ লাখ নেতাকর্মীর বিরুদ্ধে মামলা দেও&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823321/%E0%A6%AC%E0%A6%BF%E0%A6%97%E0%A6%A4-%E0%A7%A7%E0%A7%AD-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%80%E0%A6%AE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A7%9C%E0%A7%87-%E0%A7%AA-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A6%95%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>প্রধানমন্ত্রীর সঙ্গে ছবি তোলা সেই পাখির দেখা মিলছে ১০০ টাকায়</title>
      <link>https://www.ittefaq.com.bd/823320/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%9B%E0%A6%AC%E0%A6%BF-%E0%A6%A4%E0%A7%8B%E0%A6%B2%E0%A6%BE-%E0%A6%B8%E0%A7%87%E0%A6%87-%E0%A6%AA%E0%A6%BE%E0%A6%96%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BE-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%9B%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823320/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%9B%E0%A6%AC%E0%A6%BF-%E0%A6%A4%E0%A7%8B%E0%A6%B2%E0%A6%BE-%E0%A6%B8%E0%A7%87%E0%A6%87-%E0%A6%AA%E0%A6%BE%E0%A6%96%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BE-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%9B%E0%A7%87</guid>
      <pubDate>Fri, 27 Nov 2026 22:55:03 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/1ee35bd0b50e01a86246918bf47876cd-6b09b5c2678cf.jpg?jadewits_media_id=325215" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/1ee35bd0b50e01a86246918bf47876cd-6b09b5c2678cf.jpg?jadewits_media_id=325215" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/1ee35bd0b50e01a86246918bf47876cd-6b09b5c2678cf.jpg?jadewits_media_id=325215" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রধানমন্ত্রীর সঙ্গে ছবি তোলা সেই পাখির দেখা মিলছে ১০০ টাকায়" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর আগারগাঁওয়ে জাতীয় প্রাণিসম্পদ সপ্তাহ-২০২৬ উপলক্ষে আয়োজিত মেলায় দর্শনার্থীদের বাড়তি আকর্ষণ হয়ে উঠেছে একটি ম্যাকাও পাখি। প্রধানমন্ত্রী তারেক রহমানের সঙ্গে পাখিটির ছবি সামাজিক যোগাযোগমাধ্যমে ছড়িয়ে পড়ার পর সেটিকে ঘিরে তৈরি হয়েছে কৌতূহল। এখন মেলায় মাত্র ১০০ টাকা খরচ করে সেই পাখির সঙ্গে ছবি তোলার &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823320/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%9B%E0%A6%AC%E0%A6%BF-%E0%A6%A4%E0%A7%8B%E0%A6%B2%E0%A6%BE-%E0%A6%B8%E0%A7%87%E0%A6%87-%E0%A6%AA%E0%A6%BE%E0%A6%96%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BE-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%9B%E0%A7%87">দৈনিক ইত্তেফাক</source>

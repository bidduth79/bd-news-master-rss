    <item>
      <title>মাইকে ‘ডাকাত’ ঘোষণা দিয়ে ছাত্রদল-যুবদলের মিছিলে কার্যক্রম নিষিদ্ধ যুবলীগের হামলা</title>
      <link>https://www.ittefaq.com.bd/822280/%E0%A6%AE%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%87-%E0%A6%A1%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%A4-%E0%A6%98%E0%A7%8B%E0%A6%B7%E0%A6%A3%E0%A6%BE-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A6%B2-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A6%B2%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822280/%E0%A6%AE%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%87-%E0%A6%A1%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%A4-%E0%A6%98%E0%A7%8B%E0%A6%B7%E0%A6%A3%E0%A6%BE-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A6%B2-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A6%B2%E0%A7%87</guid>
      <pubDate>Sat, 21 Nov 2026 21:46:47 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/56dd55f626409b3abf98af3178e6c28e-6b01bb338bc12.jpg?jadewits_media_id=324120" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/56dd55f626409b3abf98af3178e6c28e-6b01bb338bc12.jpg?jadewits_media_id=324120" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/56dd55f626409b3abf98af3178e6c28e-6b01bb338bc12.jpg?jadewits_media_id=324120" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মাইকে ‘ডাকাত’ ঘোষণা দিয়ে ছাত্রদল-যুবদলের মিছিলে কার্যক্রম নিষিদ্ধ যুবলীগের হামলা" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রামের ফটিকছড়িতে মাইকে ডাকাত বলে ঘোষণা দিয়ে ছাত্রদল ও যুবদলের একটি মোটর সাইকেল মিছিলে হামলার অভিযোগ উঠেছে কার্যক্রম নিষিদ্ধ সংগঠন যুবলীগের নেতাকর্মীদের বিরুদ্ধে। এ সময় মিছিলের মোটরসাইকেলে অগ্নিসংযোগ করা হয় বলে দাবি করেছেন ভুক্তভোগী যুবদলের নেতাকর্মীরা।
শনিবার (২১ নভেম্বর) বিকেল ৫টার দিকে উপজেলা&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822280/%E0%A6%AE%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%87-%E0%A6%A1%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%A4-%E0%A6%98%E0%A7%8B%E0%A6%B7%E0%A6%A3%E0%A6%BE-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A6%B2-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A6%B2%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>ভুলে সীমান্ত অতিক্রমের পর বাংলাদেশি ‘বধির’ শ্রমিককে ধরে নিয়ে গেল বিএসএফ</title>
      <link>https://www.ittefaq.com.bd/822279/%E0%A6%AD%E0%A7%81%E0%A6%B2%E0%A7%87-%E0%A6%B8%E0%A7%80%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%85%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF-%E2%80%98%E0%A6%AC%E0%A6%A7%E0%A6%BF%E0%A6%B0%E2%80%99</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822279/%E0%A6%AD%E0%A7%81%E0%A6%B2%E0%A7%87-%E0%A6%B8%E0%A7%80%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%85%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF-%E2%80%98%E0%A6%AC%E0%A6%A7%E0%A6%BF%E0%A6%B0%E2%80%99</guid>
      <pubDate>Sat, 21 Nov 2026 21:40:12 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/f5c3e63d4b6210a36efb78b8a2c510d8-6b01bb010d5ea.jpg?jadewits_media_id=324119" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/f5c3e63d4b6210a36efb78b8a2c510d8-6b01bb010d5ea.jpg?jadewits_media_id=324119" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/f5c3e63d4b6210a36efb78b8a2c510d8-6b01bb010d5ea.jpg?jadewits_media_id=324119" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভুলে সীমান্ত অতিক্রমের পর বাংলাদেশি ‘বধির’ শ্রমিককে ধরে নিয়ে গেল বিএসএফ" /&gt;&lt;/p&gt;&lt;p&gt;সিলেটের গোয়াইনঘাট উপজেলার বিছনাকান্দি সীমান্ত দিয়ে অবৈধভাবে ভারতে প্রবেশের অভিযোগে শাহরিয়ার (২২) নামের এক বাংলাদেশি পাথর শ্রমিককে ধরে নিয়ে গেছে ভারতীয় সীমান্তরক্ষী বাহিনী (বিএসএফ)।
শনিবার (২১ নভেম্বর) বেলা ৩টার দিকে উপজেলার বিছনাকান্দি সীমান্তের মরকিটিলা এলাকায় ১২৬৩/৭ এস পিলারসংলগ্ন ভারতের অভ্যন্তর &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822279/%E0%A6%AD%E0%A7%81%E0%A6%B2%E0%A7%87-%E0%A6%B8%E0%A7%80%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%85%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF-%E2%80%98%E0%A6%AC%E0%A6%A7%E0%A6%BF%E0%A6%B0%E2%80%99">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>শ্রমিক দলের ৫১ সদস্যের আহ্বায়ক কমিটি গঠন, ছয় মাসের মধ্যে কাউন্সিল</title>
      <link>https://www.ittefaq.com.bd/822278/%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95-%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A7%AB%E0%A7%A7-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%B9%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A6%95-%E0%A6%95%E0%A6%AE%E0%A6%BF%E0%A6%9F%E0%A6%BF-%E0%A6%97%E0%A6%A0%E0%A6%A8-%E0%A6%9B%E0%A7%9F-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822278/%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95-%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A7%AB%E0%A7%A7-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%B9%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A6%95-%E0%A6%95%E0%A6%AE%E0%A6%BF%E0%A6%9F%E0%A6%BF-%E0%A6%97%E0%A6%A0%E0%A6%A8-%E0%A6%9B%E0%A7%9F-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Sat, 21 Nov 2026 21:31:16 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/c8f9c883c4b3dd19f4c170793df34f9d-6b01b907bc1e7.jpg?jadewits_media_id=324118" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/c8f9c883c4b3dd19f4c170793df34f9d-6b01b907bc1e7.jpg?jadewits_media_id=324118" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/c8f9c883c4b3dd19f4c170793df34f9d-6b01b907bc1e7.jpg?jadewits_media_id=324118" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শ্রমিক দলের ৫১ সদস্যের আহ্বায়ক কমিটি গঠন, ছয় মাসের মধ্যে কাউন্সিল" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ জাতীয়তাবাদী শ্রমিক দলের কেন্দ্রীয় নির্বাহী কমিটি বিলুপ্ত করে ৫১ সদস্যবিশিষ্ট নতুন আহ্বায়ক কমিটি গঠন করা হয়েছে। কমিটিতে আমান উল্লাহ আমান এমপিকে আহ্বায়ক এবং অ্যাডভোকেট শামছুর রহমান শিমুল বিশ্বাস এমপিকে সদস্য সচিব করা হয়েছে। আগামী ছয় মাসের মধ্যে সংগঠনের সপ্তম কেন্দ্রীয় কাউন্সিল ও সম্মেলন সম্পন&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822278/%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95-%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A7%AB%E0%A7%A7-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%B9%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A6%95-%E0%A6%95%E0%A6%AE%E0%A6%BF%E0%A6%9F%E0%A6%BF-%E0%A6%97%E0%A6%A0%E0%A6%A8-%E0%A6%9B%E0%A7%9F-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%87%E0%A6%B0">দৈনিক ইত্তেফাক</source>

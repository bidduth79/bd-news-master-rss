      <pubDate>Wed, 11 Nov 2026 00:30:30 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/4e09f2f12def9f4a08d6c69c7d8ca3fc-6af362a2b6d84.jpg?jadewits_media_id=322032" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/4e09f2f12def9f4a08d6c69c7d8ca3fc-6af362a2b6d84.jpg?jadewits_media_id=322032" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/4e09f2f12def9f4a08d6c69c7d8ca3fc-6af362a2b6d84.jpg?jadewits_media_id=322032" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আন্তালিয়ায় তুর্কি ফার্স্ট লেডি এমিনে এরদোয়ানের সঙ্গে ডা. জুবাইদা রহমানের সাক্ষাৎ" /&gt;&lt;/p&gt;&lt;p&gt;তুরস্কের ফার্স্ট লেডি এমিনে এরদোয়ানের সঙ্গে সৌজন্য সাক্ষাৎ করেছেন বাংলাদেশের প্রধানমন্ত্রী তারেক রহমানের সহধর্মিণী ডা. জুবাইদা রহমান। মঙ্গলবার (১০ নভেম্বর) তুরস্কের উপকূলীয় শহর আন্তালিয়ায় জাতিসংঘের জলবায়ু সম্মেলন (কপ-৩১) চলাকালে এ বৈঠক অনুষ্ঠিত হয়।
সাক্ষাতের বিষয়টি সামাজিক যোগাযোগমাধ্যম ফেসবুকে নিজ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820246/%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF-%E0%A6%AB%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B8%E0%A7%8D%E0%A6%9F-%E0%A6%B2%E0%A7%87%E0%A6%A1%E0%A6%BF-%E0%A6%8F%E0%A6%AE%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%8F%E0%A6%B0%E0%A6%A6%E0%A7%8B%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0">দৈনিক ইত্তেফাক</source>

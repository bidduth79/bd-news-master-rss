      <guid isPermaLink="true">https://www.ittefaq.com.bd/820104/%E0%A6%87%E0%A6%82%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%87-%E0%A6%86%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87-%E0%A6%9F%E0%A7%87%E0%A6%B8%E0%A7%8D%E0%A6%9F-%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A6%AC%E0%A7%87</guid>
      <pubDate>Tue, 10 Nov 2026 12:58:08 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/63df56ff01ac3a3dedaffd19a9546cbe-6af2c077e3b47.jpg?jadewits_media_id=321888" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/63df56ff01ac3a3dedaffd19a9546cbe-6af2c077e3b47.jpg?jadewits_media_id=321888" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/63df56ff01ac3a3dedaffd19a9546cbe-6af2c077e3b47.jpg?jadewits_media_id=321888" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইংল্যান্ডের আগে আয়ারল্যান্ডের বিপক্ষে টেস্ট খেলবে বাংলাদেশ!" /&gt;&lt;/p&gt;&lt;p&gt;সর্বশেষ ২০১০ সালে দ্বিপক্ষীয় সিরিজ খেলতে ইংল্যান্ড সফর করেছিল বাংলাদেশ। এক যুগেরও বেশি সময়ের অবসান ঘটিয়ে আগামী বছর ইংল্যান্ড সফর করবে বাংলাদেশ দল।
মাস কয়েক আগে ২০২৭ সালের আন্তর্জাতিক সূচি প্রকাশ করেছিল ইংল্যান্ড ও ওয়েলস ক্রিকেট বোর্ড (ইসিবি)। সূচি অনুযায়ী, বাংলাদেশ দল ইংল্যান্ডের বিপক্ষে একটি টেস্&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820104/%E0%A6%87%E0%A6%82%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%87-%E0%A6%86%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87-%E0%A6%9F%E0%A7%87%E0%A6%B8%E0%A7%8D%E0%A6%9F-%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A6%AC%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>খাগড়াছড়িতে বিএনপি কার্যালয় ও গাড়িতে আগুন</title>
      <link>https://www.ittefaq.com.bd/820103/%E0%A6%96%E0%A6%BE%E0%A6%97%E0%A7%9C%E0%A6%BE%E0%A6%9B%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F-%E0%A6%93-%E0%A6%97%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820103/%E0%A6%96%E0%A6%BE%E0%A6%97%E0%A7%9C%E0%A6%BE%E0%A6%9B%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F-%E0%A6%93-%E0%A6%97%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</guid>
      <pubDate>Tue, 10 Nov 2026 12:54:57 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/e93270dafb282e3163f57d3587e1fa08-6af2bf651179f.jpg?jadewits_media_id=321886" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/e93270dafb282e3163f57d3587e1fa08-6af2bf651179f.jpg?jadewits_media_id=321886" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/e93270dafb282e3163f57d3587e1fa08-6af2bf651179f.jpg?jadewits_media_id=321886" style="max-width:100%;height:auto;margin-bottom:10px;" alt="খাগড়াছড়িতে বিএনপি কার্যালয় ও গাড়িতে আগুন" /&gt;&lt;/p&gt;&lt;p&gt;খাগড়াছড়ির গুইমারা ও জেলা সদরে দুর্বৃত্তদের দেওয়া আগুনে পুড়েছে ওয়ার্ড বিএনপির কার্যালয় ও একটি চাঁদের গাড়ি। সোমবার (৯ নভেম্বর) দিবাগত রাতে পৃথক এ অগ্নিসংযোগের ঘটনা ঘটে। এ ঘটনায় জড়িত সন্দেহে আটজনকে আটক করেছে পুলিশ।
পুলিশ ও স্থানীয় সূত্রে জানা গেছে, সোমবার দিবাগত রাত সাড়ে ৩টার দিকে গুইমারা উপজেলার হাফছড়&lt;/p&gt;</description>

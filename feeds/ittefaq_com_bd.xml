      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/a31b21038f160645e3ca8492279f18bf-6af57d5ee9e12.jpg?jadewits_media_id=322330" medium="image" />

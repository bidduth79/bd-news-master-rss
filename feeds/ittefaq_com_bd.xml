    <item>
      <title>ড্রেজিংয়ে নদীর গৌরব ফেরার আশা</title>
      <link>https://www.ittefaq.com.bd/820037/%E0%A6%A1%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%9C%E0%A6%BF%E0%A6%82%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%A8%E0%A6%A6%E0%A7%80%E0%A6%B0-%E0%A6%97%E0%A7%8C%E0%A6%B0%E0%A6%AC-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%B6%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820037/%E0%A6%A1%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%9C%E0%A6%BF%E0%A6%82%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%A8%E0%A6%A6%E0%A7%80%E0%A6%B0-%E0%A6%97%E0%A7%8C%E0%A6%B0%E0%A6%AC-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%B6%E0%A6%BE</guid>
      <pubDate>Tue, 10 Nov 2026 03:30:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/68f942d75c7bdbd697fbdd993b349632-6af22dd952d11.jpg?jadewits_media_id=321809" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/68f942d75c7bdbd697fbdd993b349632-6af22dd952d11.jpg?jadewits_media_id=321809" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/68f942d75c7bdbd697fbdd993b349632-6af22dd952d11.jpg?jadewits_media_id=321809" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ড্রেজিংয়ে নদীর গৌরব ফেরার আশা" /&gt;&lt;/p&gt;&lt;p&gt;নদী শুধু জলধারা নয়, সভ্যতার অন্যতম প্রধান বাহকও। তাই বিশ্বে নদী থাকা দেশগুলো ভাগ্যবান। প্রকৃতির এ দান তাদের জন্য গৌরবের। আর নদী না থাকা দেশগুলো দুর্ভাগা। বাংলাদেশ সেখানে অপার সম্ভাবনার কাতারে। কিন্তু, সম্ভাবনাকে কাজে লাগানোর চেয়ে হেলাফেলার আধিক্য। কখনো কখনো চরম বাজে অবস্থায় পড়লে তা কেবল আলোচনার &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820037/%E0%A6%A1%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%9C%E0%A6%BF%E0%A6%82%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%A8%E0%A6%A6%E0%A7%80%E0%A6%B0-%E0%A6%97%E0%A7%8C%E0%A6%B0%E0%A6%AC-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%B6%E0%A6%BE">দৈনিক ইত্তেফাক</source>
    </item>

    <item>
      <title>একনেক সভা আজ, উঠছে ২১ প্রকল্প</title>
      <link>https://www.ittefaq.com.bd/821613/%E0%A6%8F%E0%A6%95%E0%A6%A8%E0%A7%87%E0%A6%95-%E0%A6%B8%E0%A6%AD%E0%A6%BE-%E0%A6%86%E0%A6%9C-%E0%A6%89%E0%A6%A0%E0%A6%9B%E0%A7%87-%E0%A7%A8%E0%A7%A7-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821613/%E0%A6%8F%E0%A6%95%E0%A6%A8%E0%A7%87%E0%A6%95-%E0%A6%B8%E0%A6%AD%E0%A6%BE-%E0%A6%86%E0%A6%9C-%E0%A6%89%E0%A6%A0%E0%A6%9B%E0%A7%87-%E0%A7%A8%E0%A7%A7-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA</guid>

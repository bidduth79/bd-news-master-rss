    <item>
      <title>রংপুরে একদিনে তিন সড়ক দুর্ঘটনায় ৫ জনের মৃত্যু</title>
      <link>https://www.ittefaq.com.bd/821178/%E0%A6%B0%E0%A6%82%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%B8%E0%A7%9C%E0%A6%95-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A7%AB-%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821178/%E0%A6%B0%E0%A6%82%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%B8%E0%A7%9C%E0%A6%95-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A7%AB-%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81</guid>
      <pubDate>Sun, 15 Nov 2026 21:28:25 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/72dd3573a4bff18bec512cb53ac87590-6af9cf3450022.jpg?jadewits_media_id=322991" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/72dd3573a4bff18bec512cb53ac87590-6af9cf3450022.jpg?jadewits_media_id=322991" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/72dd3573a4bff18bec512cb53ac87590-6af9cf3450022.jpg?jadewits_media_id=322991" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রংপুরে একদিনে তিন সড়ক দুর্ঘটনায় ৫ জনের মৃত্যু" /&gt;&lt;/p&gt;&lt;p&gt;রংপুরে পৃথক সড়ক দুর্ঘটনায় একদিনে তিনটি পৃথক সড়ক দুর্ঘটনায় পাঁচজনের মৃত্যু হয়েছে। এর মধ্যে জেলার তারাগঞ্জে চলন্ত বাস থেকে ফেলে দিয়ে দুইজনকে হত্যার অভিযোগ উঠেছে।
রোববার (১৫ নভেম্বর) ভোর থেকে সন্ধ্যা পর্যন্ত জেলার তারাগঞ্জ, রংপুরের পাগলাপীর-গঞ্জীপুর সড়ক ও জেলার কাউনিয়ায় রংপুর-কুড়িগ্রাম মহাসড়কের ভেলুপাড়&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821178/%E0%A6%B0%E0%A6%82%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%B8%E0%A7%9C%E0%A6%95-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A7%AB-%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>সশস্ত্র বাহিনীর তিন কর্মকর্তার রদবদল</title>
      <link>https://www.ittefaq.com.bd/821177/%E0%A6%B8%E0%A6%B6%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A6%A6%E0%A6%AC%E0%A6%A6%E0%A6%B2</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821177/%E0%A6%B8%E0%A6%B6%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A6%A6%E0%A6%AC%E0%A6%A6%E0%A6%B2</guid>
      <pubDate>Sun, 15 Nov 2026 21:40:23 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/b732cece9a03eb94b12fdcd04f17c328-6af9d265c0ab3.jpg?jadewits_media_id=322995" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/b732cece9a03eb94b12fdcd04f17c328-6af9d265c0ab3.jpg?jadewits_media_id=322995" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/b732cece9a03eb94b12fdcd04f17c328-6af9d265c0ab3.jpg?jadewits_media_id=322995" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সশস্ত্র বাহিনীর তিন কর্মকর্তার রদবদল" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ সেনাবাহিনীতে শীর্ষ পর্যায়ে বড় ধরনের রদবদল ও পদায়ন করা হয়েছে। নতুন দায়িত্ব বণ্টনের অংশ হিসেবে বিভিন্ন পদাতিক ডিভিশন, সামরিক প্রশিক্ষণ প্রতিষ্ঠান, গুরুত্বপূর্ণ সংস্থা ও আনসার বাহিনীতে এই পরিবর্তন আনা হয়েছে। একই সঙ্গে তিনজন ব্রিগেডিয়ার জেনারেলকে মেজর জেনারেল পদে পদোন্নতি দেওয়া হয়েছে। রাষ্ট্রপ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821177/%E0%A6%B8%E0%A6%B6%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A6%A6%E0%A6%AC%E0%A6%A6%E0%A6%B2">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>১১ হাজারের বেশি প্রবাসীকে নিজ দেশে ফেরত পাঠাল সৌদি আরব</title>
      <link>https://www.ittefaq.com.bd/821176/%E0%A7%A7%E0%A7%A7-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%BF-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%9C-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%A4-%E0%A6%AA%E0%A6%BE%E0%A6%A0%E0%A6%BE%E0%A6%B2-%E0%A6%B8%E0%A7%8C%E0%A6%A6%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821176/%E0%A7%A7%E0%A7%A7-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%BF-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%9C-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%A4-%E0%A6%AA%E0%A6%BE%E0%A6%A0%E0%A6%BE%E0%A6%B2-%E0%A6%B8%E0%A7%8C%E0%A6%A6%E0%A6%BF</guid>
      <pubDate>Sun, 15 Nov 2026 21:15:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/a841a991e8073ca91cf6fb4d778d0794-6af9cc3d48312.jpg?jadewits_media_id=322989" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/a841a991e8073ca91cf6fb4d778d0794-6af9cc3d48312.jpg?jadewits_media_id=322989" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/a841a991e8073ca91cf6fb4d778d0794-6af9cc3d48312.jpg?jadewits_media_id=322989" style="max-width:100%;height:auto;margin-bottom:10px;" alt="১১ হাজারের বেশি প্রবাসীকে নিজ দেশে ফেরত পাঠাল সৌদি আরব" /&gt;&lt;/p&gt;&lt;p&gt;সৌদি আরবে আবাসন, শ্রম ও সীমান্ত নিরাপত্তা আইন লঙ্ঘনের অভিযোগে এক সপ্তাহে ১১ হাজার ৯৫২ জনকে গ্রেপ্তার করেছে দেশটির নিরাপত্তা বাহিনী। একই সময়ে ১১ হাজার ৪১৮ জন প্রবাসীকে নিজ নিজ দেশে ফেরত পাঠানো হয়েছে।
সৌদি স্বরাষ্ট্র মন্ত্রণালয়ের বরাতে রোববার (১৫ নভেম্বর) এ তথ্য জানিয়েছে সংবাদমাধ্যম গালফ নিউজ। গত ৫ থে&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821176/%E0%A7%A7%E0%A7%A7-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%BF-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%9C-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%A4-%E0%A6%AA%E0%A6%BE%E0%A6%A0%E0%A6%BE%E0%A6%B2-%E0%A6%B8%E0%A7%8C%E0%A6%A6%E0%A6%BF">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>যারা কারিগরি শিক্ষাকে অ্যাভয়েড করে তারা জাতির শত্রু: এমপি মনিরুল</title>
      <link>https://www.ittefaq.com.bd/821175/%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%97%E0%A6%B0%E0%A6%BF-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AD%E0%A7%9F%E0%A7%87%E0%A6%A1-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821175/%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%97%E0%A6%B0%E0%A6%BF-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AD%E0%A7%9F%E0%A7%87%E0%A6%A1-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%B0</guid>
      <pubDate>Sun, 15 Nov 2026 21:13:15 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/a544698270707fabbbc66e59e394b419-6af9cbc19727c.jpg?jadewits_media_id=322988" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/a544698270707fabbbc66e59e394b419-6af9cbc19727c.jpg?jadewits_media_id=322988" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/a544698270707fabbbc66e59e394b419-6af9cbc19727c.jpg?jadewits_media_id=322988" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যারা কারিগরি শিক্ষাকে অ্যাভয়েড করে তারা জাতির শত্রু: এমপি মনিরুল" /&gt;&lt;/p&gt;&lt;p&gt;কারিগরি শিক্ষার সংকট, বিভিন্ন মন্ত্রণালয়ের মধ্যকার সমন্বয়হীনতা এবং দুই মন্ত্রণালয়ের দ্বন্দ্বে এই খাতের স্থবিরতা নিয়ে জাতীয় সংসদে তীব্র ক্ষোভ ও উদ্বেগ প্রকাশ করেছেন সংসদ সদস্য মনিরুল হক চৌধুরী।
বিশ্ববিদ্যালয় থেকে ডিগ্রি নিয়ে তরুণরা যখন বেকার ঘুরে বেড়াচ্ছে, তখন কারিগরি শিক্ষা সম্পন্ন করা যুবকদের কর&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821175/%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%97%E0%A6%B0%E0%A6%BF-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AD%E0%A7%9F%E0%A7%87%E0%A6%A1-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>খেজুরের রস ছাড়াই তৈরি হচ্ছিল গুড়, কারখানায় মিলল চুন-চিনি-রাসায়নিক</title>
      <link>https://www.ittefaq.com.bd/821174/%E0%A6%96%E0%A7%87%E0%A6%9C%E0%A7%81%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%B8-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%87-%E0%A6%A4%E0%A7%88%E0%A6%B0%E0%A6%BF-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%97%E0%A7%81%E0%A7%9C-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821174/%E0%A6%96%E0%A7%87%E0%A6%9C%E0%A7%81%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%B8-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%87-%E0%A6%A4%E0%A7%88%E0%A6%B0%E0%A6%BF-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%97%E0%A7%81%E0%A7%9C-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2</guid>
      <pubDate>Sun, 15 Nov 2026 21:03:28 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/07935aa8ca0c0225e3ed0555fd6e8975-6af9c94513dec.jpg?jadewits_media_id=322987" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/07935aa8ca0c0225e3ed0555fd6e8975-6af9c94513dec.jpg?jadewits_media_id=322987" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/07935aa8ca0c0225e3ed0555fd6e8975-6af9c94513dec.jpg?jadewits_media_id=322987" style="max-width:100%;height:auto;margin-bottom:10px;" alt="খেজুরের রস ছাড়াই তৈরি হচ্ছিল গুড়, কারখানায় মিলল চুন-চিনি-রাসায়নিক" /&gt;&lt;/p&gt;&lt;p&gt;রাজশাহীর বাঘা উপজেলায় খেজুরের রস ছাড়াই চিনি, চুন, রং ও বিভিন্ন রাসায়নিক দ্রব্য মিশিয়ে তৈরি করা হচ্ছিল খেজুরের গুড়। এ অভিযোগে দুই ব্যবসায়ীর বাড়িতে অভিযান চালিয়ে তাদের মোট দুই লাখ টাকা জরিমানা করেছেন ভ্রাম্যমাণ আদালত।
রোববার (১৫ নভেম্বর) সকালে উপজেলার বাউসা ইউনিয়নের পীরগাছা নতুনপাড়া গ্রামে এবং গত বৃহস&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821174/%E0%A6%96%E0%A7%87%E0%A6%9C%E0%A7%81%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%B8-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%87-%E0%A6%A4%E0%A7%88%E0%A6%B0%E0%A6%BF-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%97%E0%A7%81%E0%A7%9C-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>গোপালগঞ্জে পুলিশের গাড়ি ভাঙচুর মামলার বাদী এসআই মোসলেমকে কু’পিয়ে জ’খম</title>

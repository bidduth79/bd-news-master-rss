      <guid isPermaLink="true">https://www.ittefaq.com.bd/821723/%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%87-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%A8%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A7%87%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%9B%E0%A7%87</guid>
      <pubDate>Wed, 18 Nov 2026 18:29:48 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/26931833b7cb61ea52a13f76a7063aef-6afd99fd84b78.jpg?jadewits_media_id=323553" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/26931833b7cb61ea52a13f76a7063aef-6afd99fd84b78.jpg?jadewits_media_id=323553" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/26931833b7cb61ea52a13f76a7063aef-6afd99fd84b78.jpg?jadewits_media_id=323553" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সরকারই আওয়ামী লীগকে পুনর্বাসনের চেষ্টা করছে: জামায়াত" /&gt;&lt;/p&gt;&lt;p&gt;সরকারের দুর্বলতা, প্রত্যক্ষ-পরোক্ষ মদদ এবং প্রশাসনের একাংশের পরিকল্পিত ভূমিকার মাধ্যমে আওয়ামী লীগকে পুনর্বাসনের চেষ্টা চলছে বলে অভিযোগ করেছেন বাংলাদেশ জামায়াতে ইসলামীর সেক্রেটারি জেনারেল মিয়া গোলাম পরওয়ার। তিনি বলেন, দেশে সহিংস ও অস্থিতিশীল পরিস্থিতি তৈরি করে আওয়ামী লীগকে পুনর্বাসনের পথ করে দেওয়া হচ&lt;/p&gt;</description>

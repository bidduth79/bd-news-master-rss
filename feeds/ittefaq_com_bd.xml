      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/f79679ca7dc638d9946b61ac56c4defe-6b07a91ba3e61.jpg?jadewits_media_id=324921" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/f79679ca7dc638d9946b61ac56c4defe-6b07a91ba3e61.jpg?jadewits_media_id=324921" medium="image" />

      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/7a6166aa616012cd7b719ea2509bf6c2-6b07a2f3b45a8.jpg?jadewits_media_id=324919" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দেশের বাজারে আজ যে দামে বিক্রি হচ্ছে স্বর্ণ" /&gt;&lt;/p&gt;&lt;p&gt;দেশের বাজারে টানা দুই দফা দাম বাড়ার পর স্বর্ণের দাম কমিয়েছে বাংলাদেশ জুয়েলার্স অ্যাসোসিয়েশন (বাজুস)। নতুন সিদ্ধান্ত অনুযায়ী, প্রতি ভরিতে ২ হাজার ৮৫৮ টাকা কমিয়ে ২২ ক্যারেটের এক ভরি স্বর্ণের দাম নির্ধারণ করা হয়েছে ১ লাখ ৯৬ হাজার ৮৩০ টাকা।
বাজুসের ঘোষণা অনুযায়ী, বুধবার (২৫ নভেম্বর) সকালে নতুন দাম নির্ধ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823045/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%9C-%E0%A6%AF%E0%A7%87-%E0%A6%A6%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>দাকোপে আগুনে পুড়ে ছাই ৭ দোকান, নদী পার হতে পারেনি ফায়ার সার্ভিস</title>
      <link>https://www.ittefaq.com.bd/823044/%E0%A6%A6%E0%A6%BE%E0%A6%95%E0%A7%8B%E0%A6%AA%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A7%9C%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A6%87-%E0%A7%AD-%E0%A6%A6%E0%A7%8B%E0%A6%95%E0%A6%BE%E0%A6%A8-%E0%A6%A8%E0%A6%A6%E0%A7%80-%E0%A6%AA%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823044/%E0%A6%A6%E0%A6%BE%E0%A6%95%E0%A7%8B%E0%A6%AA%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A7%9C%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A6%87-%E0%A7%AD-%E0%A6%A6%E0%A7%8B%E0%A6%95%E0%A6%BE%E0%A6%A8-%E0%A6%A8%E0%A6%A6%E0%A7%80-%E0%A6%AA%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A6%BF</guid>
      <pubDate>Thu, 26 Nov 2026 09:07:18 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/e13c9ab97b40af36b30e127358819db4-6b07a239ce897.png?jadewits_media_id=324918" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/e13c9ab97b40af36b30e127358819db4-6b07a239ce897.png?jadewits_media_id=324918" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/e13c9ab97b40af36b30e127358819db4-6b07a239ce897.png?jadewits_media_id=324918" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দাকোপে আগুনে পুড়ে ছাই ৭ দোকান, নদী পার হতে পারেনি ফায়ার সার্ভিস" /&gt;&lt;/p&gt;&lt;p&gt;আগুনে একের পর এক দোকান পুড়ে গেলেও নদী পার হতে না পারায় ঘটনাস্থলে পৌঁছাতে পারেনি ফায়ার সার্ভিস। খুলনার দাকোপ উপজেলার কামারখোলা ইউনিয়নের কালিনগর বাজারে বুধবার (২৫ নভেম্বর) রাতের অগ্নিকাণ্ডে সাতটি দোকান পুড়ে ছাই হয়েছে। আগুনের সূত্রপাত বৈদ্যুতিক শর্টসার্কিট থেকে বলে প্রাথমিকভাবে ধারণা করা হচ্ছে।
স্থানীয়&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823044/%E0%A6%A6%E0%A6%BE%E0%A6%95%E0%A7%8B%E0%A6%AA%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A7%9C%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A6%87-%E0%A7%AD-%E0%A6%A6%E0%A7%8B%E0%A6%95%E0%A6%BE%E0%A6%A8-%E0%A6%A8%E0%A6%A6%E0%A7%80-%E0%A6%AA%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A6%BF">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>সৌদি আরবের বন্দর ও রাজধানী লক্ষ্য করে হামলা</title>
      <link>https://www.ittefaq.com.bd/823043/%E0%A6%B8%E0%A7%8C%E0%A6%A6%E0%A6%BF-%E0%A6%86%E0%A6%B0%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%B0-%E0%A6%93-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80-%E0%A6%B2%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8D%E0%A6%AF-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823043/%E0%A6%B8%E0%A7%8C%E0%A6%A6%E0%A6%BF-%E0%A6%86%E0%A6%B0%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%B0-%E0%A6%93-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80-%E0%A6%B2%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8D%E0%A6%AF-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE</guid>

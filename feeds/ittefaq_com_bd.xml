    <item>
      <title>সাত জেলায় নতুন পুলিশ সুপার, বদলি-পদায়ন ১৪ কর্মকর্তা</title>
      <link>https://www.ittefaq.com.bd/823029/%E0%A6%B8%E0%A6%BE%E0%A6%A4-%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%B8%E0%A7%81%E0%A6%AA%E0%A6%BE%E0%A6%B0-%C2%A0%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A6%BF-%E0%A6%AA%E0%A6%A6%E0%A6%BE%E0%A7%9F%E0%A6%A8-%E0%A7%A7%E0%A7%AA</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823029/%E0%A6%B8%E0%A6%BE%E0%A6%A4-%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%B8%E0%A7%81%E0%A6%AA%E0%A6%BE%E0%A6%B0-%C2%A0%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A6%BF-%E0%A6%AA%E0%A6%A6%E0%A6%BE%E0%A7%9F%E0%A6%A8-%E0%A7%A7%E0%A7%AA</guid>
      <pubDate>Thu, 26 Nov 2026 04:00:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/10/12/75d79743d2c90df24887174f60761f80-6accd76c0c647.jpg?jadewits_media_id=316390" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/10/12/75d79743d2c90df24887174f60761f80-6accd76c0c647.jpg?jadewits_media_id=316390" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/10/12/75d79743d2c90df24887174f60761f80-6accd76c0c647.jpg?jadewits_media_id=316390" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাত জেলায় নতুন পুলিশ সুপার, বদলি-পদায়ন ১৪ কর্মকর্তা" /&gt;&lt;/p&gt;&lt;p&gt;দেশের সাত জেলায় নতুন পুলিশ সুপার (এসপি) নিয়োগ দিয়েছে সরকার। একই সঙ্গে পুলিশ সুপার পদমর্যাদার আরো সাত কর্মকর্তাসহ মোট ১৪ জনকে বদলি ও নতুন কর্মস্থলে পদায়ন করা হয়েছে। গতকাল বুধবার স্বরাষ্ট্র মন্ত্রণালয়ের জননিরাপত্তা বিভাগের পুলিশ-১ শাখা থেকে এ-সংক্রান্ত প্রজ্ঞাপন জারি করা হয়। উপসচিব তৌছিফ আহমেদ স্বাক্ষ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823029/%E0%A6%B8%E0%A6%BE%E0%A6%A4-%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%B8%E0%A7%81%E0%A6%AA%E0%A6%BE%E0%A6%B0-%C2%A0%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A6%BF-%E0%A6%AA%E0%A6%A6%E0%A6%BE%E0%A7%9F%E0%A6%A8-%E0%A7%A7%E0%A7%AA">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>আপত্তিকর ভিডিও ভাইরাল: পদ হারালেন ছাত্রদল নেতা নয়ন</title>
      <link>https://www.ittefaq.com.bd/823036/%E0%A6%86%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A6%B0-%E0%A6%AD%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A6%93-%E0%A6%AD%E0%A6%BE%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%B2-%E0%A6%AA%E0%A6%A6-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A6%B2-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%A8%E0%A7%9F%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823036/%E0%A6%86%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A6%B0-%E0%A6%AD%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A6%93-%E0%A6%AD%E0%A6%BE%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%B2-%E0%A6%AA%E0%A6%A6-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A6%B2-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%A8%E0%A7%9F%E0%A6%A8</guid>
      <pubDate>Thu, 26 Nov 2026 03:31:57 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/4d3c64ad958a6ec7ace83bd4c048c8bc-6b0753bde5c50.jpg?jadewits_media_id=324910" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/4d3c64ad958a6ec7ace83bd4c048c8bc-6b0753bde5c50.jpg?jadewits_media_id=324910" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/4d3c64ad958a6ec7ace83bd4c048c8bc-6b0753bde5c50.jpg?jadewits_media_id=324910" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আপত্তিকর ভিডিও ভাইরাল: পদ হারালেন ছাত্রদল নেতা নয়ন" /&gt;&lt;/p&gt;&lt;p&gt;সামাজিক যোগাযোগমাধ্যমে আপত্তিকর ভিডিও ছড়িয়ে পড়ার ঘটনায় চট্টগ্রাম দক্ষিণ জেলা ছাত্রদলের যুগ্ম আহ্বায়ক শেখ মোহাম্মদ হোসেন ওরফে এস এম নয়নকে সাংগঠনিক পদ থেকে অব্যাহতি দেওয়া হয়েছে। বুধবার (২৫ নভেম্বর) বাংলাদেশ জাতীয়তাবাদী ছাত্রদলের কেন্দ্রীয় সংসদ থেকে পাঠানো এক সংবাদ বিজ্ঞপ্তিতে এ সিদ্ধান্তের ক&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823036/%E0%A6%86%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A6%B0-%E0%A6%AD%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A6%93-%E0%A6%AD%E0%A6%BE%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%B2-%E0%A6%AA%E0%A6%A6-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A6%B2-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%A8%E0%A7%9F%E0%A6%A8">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>টিকটকে পরিচয়, স্কুলছাত্রীকে আটকে রেখে ধর্ষণের অভিযোগে চীনা নাগরিক গ্রেপ্তার</title>
      <link>https://www.ittefaq.com.bd/823035/%E0%A6%9F%E0%A6%BF%E0%A6%95%E0%A6%9F%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%9A%E0%A7%9F-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%86%E0%A6%9F%E0%A6%95%E0%A7%87-%E0%A6%B0%E0%A7%87%E0%A6%96%E0%A7%87-%E0%A6%A7%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A6%A3%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823035/%E0%A6%9F%E0%A6%BF%E0%A6%95%E0%A6%9F%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%9A%E0%A7%9F-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%86%E0%A6%9F%E0%A6%95%E0%A7%87-%E0%A6%B0%E0%A7%87%E0%A6%96%E0%A7%87-%E0%A6%A7%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A6%A3%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Thu, 26 Nov 2026 03:04:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/682c2902719bfeeb776b51eb629668a7-6b073f3f5f0f2.jpg?jadewits_media_id=324909" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/682c2902719bfeeb776b51eb629668a7-6b073f3f5f0f2.jpg?jadewits_media_id=324909" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/682c2902719bfeeb776b51eb629668a7-6b073f3f5f0f2.jpg?jadewits_media_id=324909" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টিকটকে পরিচয়, স্কুলছাত্রীকে আটকে রেখে ধর্ষণের অভিযোগে চীনা নাগরিক গ্রেপ্তার" /&gt;&lt;/p&gt;&lt;p&gt;টিকটকে পরিচয়ের সূত্র ধরে বিয়ের আশ্বাসে ১৪ বছর বয়সী এক স্কুলছাত্রীকে মানিকগঞ্জ থেকে ঢাকায় নিয়ে একটি বাসায় আটকে রেখে একাধিকবার ধর্ষণের অভিযোগে চেন ইয়ং (৪১) নামের এক চীনা নাগরিককে গ্রেপ্তার করেছে পুলিশ।
নিখোঁজের ছয় দিন পর মঙ্গলবার (২৪ নভেম্বর) দিবাগত রাতে রাজধানীর উত্তরা পূর্ব থানার ৪ নম্বর সেক্টরের এক&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823035/%E0%A6%9F%E0%A6%BF%E0%A6%95%E0%A6%9F%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%9A%E0%A7%9F-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%86%E0%A6%9F%E0%A6%95%E0%A7%87-%E0%A6%B0%E0%A7%87%E0%A6%96%E0%A7%87-%E0%A6%A7%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A6%A3%E0%A7%87%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>ভারত-পাকিস্তানও বল টেম্পারিং করতো: বিস্ফোরক দাবি খাজার</title>
      <link>https://www.ittefaq.com.bd/823033/%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4-%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%93-%E0%A6%AC%E0%A6%B2-%E0%A6%9F%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%82-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%8B-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%95-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823033/%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4-%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%93-%E0%A6%AC%E0%A6%B2-%E0%A6%9F%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%82-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%8B-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%95-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF</guid>
      <pubDate>Thu, 26 Nov 2026 02:26:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/cca9aed1b7b0fe86eae3f556c9308b48-6b073cc72994f.jpg?jadewits_media_id=324908" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/cca9aed1b7b0fe86eae3f556c9308b48-6b073cc72994f.jpg?jadewits_media_id=324908" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/cca9aed1b7b0fe86eae3f556c9308b48-6b073cc72994f.jpg?jadewits_media_id=324908" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভারত-পাকিস্তানও বল টেম্পারিং করতো: বিস্ফোরক দাবি খাজার" /&gt;&lt;/p&gt;&lt;p&gt;২০১৮ সালের কেপটাউন টেস্টে আলোচিত ‘স্যান্ডপেপারগেট’ বা বল টেম্পারিং কেলেঙ্কারির প্রায় আট বছর পর নতুন বিতর্ক উসকে দিয়েছেন অস্ট্রেলিয়ার সাবেক ওপেনার উসমান খাজা। সাম্প্রতিক এক সাক্ষাৎকারে তিনি দাবি করেছেন, ওই ঘটনার আগে আন্তর্জাতিক ক্রিকেটে ভারত, পাকিস্তান ও দক্ষিণ আফ্রিকাসহ প্রায় সব দলই কোনো না কোনোভাবে&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823033/%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4-%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%93-%E0%A6%AC%E0%A6%B2-%E0%A6%9F%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%82-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%8B-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%95-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>‘রাস্তায় নৈরাজ্য ছড়িয়ে ক্ষমতা পরিবর্তনের দিবাস্বপ্ন ভুলে যান’</title>
      <link>https://www.ittefaq.com.bd/823032/%E2%80%98%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A7%88%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A7%8D%E0%A6%AF-%E0%A6%9B%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%AE%E0%A6%A4%E0%A6%BE-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%A8%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823032/%E2%80%98%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A7%88%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A7%8D%E0%A6%AF-%E0%A6%9B%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%AE%E0%A6%A4%E0%A6%BE-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%A8%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Thu, 26 Nov 2026 02:06:01 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/3755e2df9a25c999f055bac447b8dfc3-6b073b79823ab.jpg?jadewits_media_id=324907" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/3755e2df9a25c999f055bac447b8dfc3-6b073b79823ab.jpg?jadewits_media_id=324907" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/3755e2df9a25c999f055bac447b8dfc3-6b073b79823ab.jpg?jadewits_media_id=324907" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘রাস্তায় নৈরাজ্য ছড়িয়ে ক্ষমতা পরিবর্তনের দিবাস্বপ্ন ভুলে যান’" /&gt;&lt;/p&gt;&lt;p&gt;রাজপথে অস্থিতিশীলতা ও নৈরাজ্য সৃষ্টি করে সরকার পরিবর্তনের দিবাস্বপ্ন ভুলে যাওয়ার জন্য ভারতের প্রধান বিরোধী দল কংগ্রেসের নেতা রাহুল গান্ধীকে কড়া হুঁশিয়ারি দিয়েছেন দেশটির প্রতিরক্ষামন্ত্রী রাজনাথ সিং।
বুধবার (২৫ নভেম্বর) কর্ণাটকের কালাবুরাগিতে বিজেপির ‘গণতন্ত্র বাঁচাও, নৈরাজ্য হটাও’ প্রচারণার অংশ হিসে&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823032/%E2%80%98%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A7%88%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A7%8D%E0%A6%AF-%E0%A6%9B%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%AE%E0%A6%A4%E0%A6%BE-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%A8%E0%A7%87%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>দেয়ালে শেখ মুজিবের ছবি, প্রধান শিক্ষিকার কক্ষে তালা</title>
      <link>https://www.ittefaq.com.bd/823031/%E0%A6%A6%E0%A7%87%E0%A7%9F%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%AE%E0%A7%81%E0%A6%9C%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%9B%E0%A6%AC%E0%A6%BF-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823031/%E0%A6%A6%E0%A7%87%E0%A7%9F%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%AE%E0%A7%81%E0%A6%9C%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%9B%E0%A6%AC%E0%A6%BF-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87</guid>
      <pubDate>Thu, 26 Nov 2026 01:31:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/a4f279109b6d2ff2bc4c1c5e3a862ee6-6b07350778e59.jpg?jadewits_media_id=324906" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/a4f279109b6d2ff2bc4c1c5e3a862ee6-6b07350778e59.jpg?jadewits_media_id=324906" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/a4f279109b6d2ff2bc4c1c5e3a862ee6-6b07350778e59.jpg?jadewits_media_id=324906" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দেয়ালে শেখ মুজিবের ছবি, প্রধান শিক্ষিকার কক্ষে তালা" /&gt;&lt;/p&gt;&lt;p&gt;রাজশাহীর বাঘা উপজেলার বাউসা মাঝপাড়া সরকারি প্রাথমিক বিদ্যালয়ে প্রধান শিক্ষিকার কক্ষে তালা ঝুলিয়ে দেওয়ার ঘটনায় এলাকায় উত্তেজনা সৃষ্টি হয়েছে। বিদ্যালয়ের মাঠের ভেতর দিয়ে রাস্তা নির্মাণ নিয়ে দীর্ঘদিনের বিরোধ এবং বিদ্যালয়ের দেয়ালে শেখ মুজিবুর রহমানের ছবি থাকা নিয়ে অভিযোগের জেরে বুধবার (২৫ নভেম্বর) সকালে &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823031/%E0%A6%A6%E0%A7%87%E0%A7%9F%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%AE%E0%A7%81%E0%A6%9C%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%9B%E0%A6%AC%E0%A6%BF-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87">দৈনিক ইত্তেফাক</source>

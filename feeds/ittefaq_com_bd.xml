    <item>
      <title>‘ওয়ালাইকুম সালাম’ বলার আগেই পয়েন্ট অব অর্ডার, এমপিকে থামিয়ে স্পিকারের রসিকতা</title>
      <link>https://www.ittefaq.com.bd/820226/%E2%80%98%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%81%E0%A6%AE-%E0%A6%B8%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%AE%E2%80%99-%E0%A6%AC%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%87%E0%A6%87-%E0%A6%AA%E0%A7%9F%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F-%E0%A6%85%E0%A6%AC-%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820226/%E2%80%98%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%81%E0%A6%AE-%E0%A6%B8%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%AE%E2%80%99-%E0%A6%AC%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%87%E0%A6%87-%E0%A6%AA%E0%A7%9F%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F-%E0%A6%85%E0%A6%AC-%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Tue, 10 Nov 2026 21:38:59 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/883ea9fb1691a39debd420bea99d2766-6af33a608231e.jpg?jadewits_media_id=322012" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/883ea9fb1691a39debd420bea99d2766-6af33a608231e.jpg?jadewits_media_id=322012" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/883ea9fb1691a39debd420bea99d2766-6af33a608231e.jpg?jadewits_media_id=322012" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘ওয়ালাইকুম সালাম’ বলার আগেই পয়েন্ট অব অর্ডার, এমপিকে থামিয়ে স্পিকারের রসিকতা" /&gt;&lt;/p&gt;&lt;p&gt;জাতীয় সংসদের অধিবেশন শুরু হওয়ার পরপরই পয়েন্ট অব অর্ডারে কথা বলতে দাঁড়িয়ে যাওয়া এক সংসদ সদস্যকে থামিয়ে রসিকতা করেছেন স্পিকার মেজর (অব.) হাফিজ উদ্দিন আহমদ। তার তাৎক্ষণিক মন্তব্যে সংসদ কক্ষে হাস্যরসের পরিবেশ তৈরি হয়।
মঙ্গলবার (১০ নভেম্বর) ত্রয়োদশ জাতীয় সংসদের চতুর্থ অধিবেশনের দ্বিতীয় দিনের বৈঠকের শুরুত&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820226/%E2%80%98%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%81%E0%A6%AE-%E0%A6%B8%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%AE%E2%80%99-%E0%A6%AC%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%87%E0%A6%87-%E0%A6%AA%E0%A7%9F%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F-%E0%A6%85%E0%A6%AC-%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A6%BE%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>ইরান ইস্যুতে উত্তেজনা কমাতে জি-৭-এ কাতারের প্রধানমন্ত্রীর বার্তা</title>
      <link>https://www.ittefaq.com.bd/820225/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8-%E0%A6%87%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%A4%E0%A7%87-%E0%A6%89%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A7%87%E0%A6%9C%E0%A6%A8%E0%A6%BE-%E0%A6%95%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%9C%E0%A6%BF-%E0%A7%AD-%E0%A6%8F-%E0%A6%95%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820225/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8-%E0%A6%87%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%A4%E0%A7%87-%E0%A6%89%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A7%87%E0%A6%9C%E0%A6%A8%E0%A6%BE-%E0%A6%95%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%9C%E0%A6%BF-%E0%A7%AD-%E0%A6%8F-%E0%A6%95%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Tue, 10 Nov 2026 21:31:32 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/1e3a418776c02cdea397a89114ca5ddf-6af3386c0a0f0.jpg?jadewits_media_id=322011" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/1e3a418776c02cdea397a89114ca5ddf-6af3386c0a0f0.jpg?jadewits_media_id=322011" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/1e3a418776c02cdea397a89114ca5ddf-6af3386c0a0f0.jpg?jadewits_media_id=322011" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইরান ইস্যুতে উত্তেজনা কমাতে জি-৭-এ কাতারের প্রধানমন্ত্রীর বার্তা" /&gt;&lt;/p&gt;&lt;p&gt;ইরানকে ঘিরে চলমান উত্তেজনা প্রশমনে কূটনৈতিক উদ্যোগ জোরদারের আহ্বান জানাতে যাচ্ছেন কাতারের প্রধানমন্ত্রী শেখ মোহাম্মদ বিন আবদুর রহমান আল থানি। ফ্রান্সের প্যারিসে অনুষ্ঠিত জি-৭ সম্মেলনে অংশ নেওয়া বিভিন্ন দেশের পররাষ্ট্রমন্ত্রীদের কাছে উপসাগরীয় অঞ্চলের এই অবস্থান তুলে ধরবেন তিনি।
ব্রিটেন, ফ্রান্স, ইতাল&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820225/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8-%E0%A6%87%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%A4%E0%A7%87-%E0%A6%89%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A7%87%E0%A6%9C%E0%A6%A8%E0%A6%BE-%E0%A6%95%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%9C%E0%A6%BF-%E0%A7%AD-%E0%A6%8F-%E0%A6%95%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>বিয়ে নিয়ে পুরুষদের মনে ভয়ের ৬ কারণ</title>
      <link>https://www.ittefaq.com.bd/820224/%E0%A6%AC%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%81%E0%A6%B7%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%AD%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A7%AC-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%A3</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820224/%E0%A6%AC%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%81%E0%A6%B7%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%AD%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A7%AC-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%A3</guid>
      <pubDate>Tue, 10 Nov 2026 21:44:58 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/d22af77b492956576a1442eac2693c90-6af337a1ade16.jpg?jadewits_media_id=322010" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/d22af77b492956576a1442eac2693c90-6af337a1ade16.jpg?jadewits_media_id=322010" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/d22af77b492956576a1442eac2693c90-6af337a1ade16.jpg?jadewits_media_id=322010" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিয়ে নিয়ে পুরুষদের মনে ভয়ের ৬ কারণ" /&gt;&lt;/p&gt;&lt;p&gt;বিয়ে মানুষের জীবনের গুরুত্বপূর্ণ একটি অধ্যায়। ভালোবাসা, পারস্পরিক বিশ্বাস ও দায়িত্ব ভাগাভাগির মধ্য দিয়ে দুটি মানুষ একসঙ্গে নতুন জীবন শুরু করেন। এর মাধ্যমে গড়ে ওঠে পরিবার, তৈরি হয় সামাজিক বন্ধন এবং ভবিষ্যৎ প্রজন্মের ভিত্তি।
তবে বর্তমান সময়ে বিয়ে নিয়ে তরুণদের মধ্যে, বিশেষ করে পুরুষদের একাংশের অনীহা বা&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820224/%E0%A6%AC%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%81%E0%A6%B7%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%AD%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A7%AC-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%A3">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>পেট্রোল পাম্পে ভয়ঙ্কর জালিয়াতি পেল বিএসটিআই</title>
      <link>https://www.ittefaq.com.bd/820223/%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B2-%E0%A6%AA%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A7%87-%E0%A6%AD%E0%A7%9F%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%B0-%E0%A6%9C%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A4%E0%A6%BF-%E0%A6%AA%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%B8%E0%A6%9F%E0%A6%BF%E0%A6%86%E0%A6%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820223/%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B2-%E0%A6%AA%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A7%87-%E0%A6%AD%E0%A7%9F%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%B0-%E0%A6%9C%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A4%E0%A6%BF-%E0%A6%AA%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%B8%E0%A6%9F%E0%A6%BF%E0%A6%86%E0%A6%87</guid>
      <pubDate>Tue, 10 Nov 2026 21:24:25 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/817236a503c5379fb31b2b067b9f890e-6af336f5c37a7.jpg?jadewits_media_id=322009" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/817236a503c5379fb31b2b067b9f890e-6af336f5c37a7.jpg?jadewits_media_id=322009" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/817236a503c5379fb31b2b067b9f890e-6af336f5c37a7.jpg?jadewits_media_id=322009" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পেট্রোল পাম্পে ভয়ঙ্কর জালিয়াতি পেল বিএসটিআই" /&gt;&lt;/p&gt;&lt;p&gt;পরিমাপে কারচুপির অপরাধে রাজধানীর পশ্চিম কাফরুলের মেসার্স সোবহান ফিলিং অ্যান্ড সার্ভিসিং স্টেশনকে ৫ লাখ টাকা জরিমানা এবং ৩টি ডিসপেন্সিং ইউনিট সিলগালা বা বন্ধ করে দিয়েছে বাংলাদেশ স্ট্যান্ডার্ডস অ্যান্ড টেস্টিং ইনস্টিটিউশন (বিএসটিআই)।
মঙ্গলবার (১০ নভেম্বর) বিএসটিআইয়ের নির্বাহী ম্যাজিস্ট্রেট লুৎফুন্নে&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820223/%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B2-%E0%A6%AA%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A7%87-%E0%A6%AD%E0%A7%9F%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%B0-%E0%A6%9C%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A4%E0%A6%BF-%E0%A6%AA%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%B8%E0%A6%9F%E0%A6%BF%E0%A6%86%E0%A6%87">দৈনিক ইত্তেফাক</source>

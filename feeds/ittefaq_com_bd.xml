      <guid isPermaLink="true">https://www.ittefaq.com.bd/823417/%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%A4%E0%A6%A5%E0%A7%8D%E0%A6%AF%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%B9%E0%A6%BE%E0%A6%9B%E0%A6%BE%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B9%E0%A6%AE%E0%A7%81%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%BE%E0%A6%9A%E0%A6%BE%E0%A6%A4%E0%A7%8B-%E0%A6%AD%E0%A6%BE%E0%A6%87</guid>

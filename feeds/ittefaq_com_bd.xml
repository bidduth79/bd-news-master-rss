      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/3aeca6fc32109d9199f3f8a9f4937356-6afe08058c489.jpg?jadewits_media_id=323625" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চাঁদপুরে দীপু মনি ও সুজিত রায় নন্দীর বাসভবনে অগ্নিকাণ্ড" /&gt;&lt;/p&gt;&lt;p&gt;চাঁদপুরে আওয়ামী লীগের সাবেক মন্ত্রী দীপু মনি এবং দলটির সাবেক সাংগঠনিক সম্পাদক ও সাবেক সংসদ সদস্য সুজিত রায় নন্দীর বাসভবনে অগ্নিকাণ্ডের ঘটনা ঘটেছে।
বুধবার (১৮ নভেম্বর) রাতে পৃথক সময়ে শহরের জেটি রোড ও সদর উপজেলার ফারাক্কাবাদ এলাকায় অবস্থিত তাদের বাড়িতে আগুন লাগে। তবে দুটি ঘটনাতেই স্থানীয় বাসিন্দা ও ফা&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821797/%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%A6%E0%A7%80%E0%A6%AA%E0%A7%81-%E0%A6%AE%E0%A6%A8%E0%A6%BF-%E0%A6%93-%E0%A6%B8%E0%A7%81%E0%A6%9C%E0%A6%BF%E0%A6%A4-%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%80%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%AD%E0%A6%AC%E0%A6%A8%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>উত্তরা থেকে সাবেক শিক্ষামন্ত্রী নুরুল ইসলাম নাহিদ গ্রেপ্তার</title>
      <link>https://www.ittefaq.com.bd/821800/%E0%A6%89%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%A8%E0%A7%81%E0%A6%B0%E0%A7%81%E0%A6%B2-%E0%A6%87%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE-%E0%A6%A8%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A6</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821800/%E0%A6%89%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%A8%E0%A7%81%E0%A6%B0%E0%A7%81%E0%A6%B2-%E0%A6%87%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE-%E0%A6%A8%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A6</guid>
      <pubDate>Thu, 19 Nov 2026 02:38:56 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/6bc6f6c7f480957dacd79116731dad8e-6afe0cc74eb23.jpg?jadewits_media_id=323627" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/6bc6f6c7f480957dacd79116731dad8e-6afe0cc74eb23.jpg?jadewits_media_id=323627" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/6bc6f6c7f480957dacd79116731dad8e-6afe0cc74eb23.jpg?jadewits_media_id=323627" style="max-width:100%;height:auto;margin-bottom:10px;" alt="উত্তরা থেকে সাবেক শিক্ষামন্ত্রী নুরুল ইসলাম নাহিদ গ্রেপ্তার" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর উত্তরা থেকে সাবেক শিক্ষা মন্ত্রী নুরুল ইসলাম নাহিদকে গ্রেপ্তার করেছে পুলিশ। বুধবার (১৮ নভেম্বর) দিবাগত রাত ২টার দিকে উত্তরা এলাকা থেকে তাকে গ্রেপ্তার করা হয়।
বিষয়টি নিশ্চিত করেছেন উত্তরা পশ্চিম থানার ভারপ্রাপ্ত কর্মকর্তা (ওসি) খালিদ মনসুর।
তিনি জানান, গোপন সংবাদের ভিত্তিতে উত্তরা তিন নম্বর&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821800/%E0%A6%89%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%A8%E0%A7%81%E0%A6%B0%E0%A7%81%E0%A6%B2-%E0%A6%87%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE-%E0%A6%A8%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A6">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>পটুয়াখালীতে কার্যক্রম নিষিদ্ধ আওয়ামী লীগের জেলা সভাপতির বাড়িতে আগুন</title>
      <link>https://www.ittefaq.com.bd/821796/%E0%A6%AA%E0%A6%9F%E0%A7%81%E0%A7%9F%E0%A6%BE%E0%A6%96%E0%A6%BE%E0%A6%B2%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE</link>

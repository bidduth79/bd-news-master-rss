    </item>
    <item>
      <title>ডিবি হেফাজতে সুইডেন আসলাম, চলছে জিজ্ঞাসাবাদ</title>
      <link>https://www.ittefaq.com.bd/822577/%E0%A6%A1%E0%A6%BF%E0%A6%AC%E0%A6%BF-%E0%A6%B9%E0%A7%87%E0%A6%AB%E0%A6%BE%E0%A6%9C%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A7%81%E0%A6%87%E0%A6%A1%E0%A7%87%E0%A6%A8-%E0%A6%86%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE-%E0%A6%9A%E0%A6%B2%E0%A6%9B%E0%A7%87-%E0%A6%9C%E0%A6%BF%E0%A6%9C%E0%A7%8D%E0%A6%9E%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%A6</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822577/%E0%A6%A1%E0%A6%BF%E0%A6%AC%E0%A6%BF-%E0%A6%B9%E0%A7%87%E0%A6%AB%E0%A6%BE%E0%A6%9C%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A7%81%E0%A6%87%E0%A6%A1%E0%A7%87%E0%A6%A8-%E0%A6%86%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE-%E0%A6%9A%E0%A6%B2%E0%A6%9B%E0%A7%87-%E0%A6%9C%E0%A6%BF%E0%A6%9C%E0%A7%8D%E0%A6%9E%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%A6</guid>
      <pubDate>Mon, 23 Nov 2026 13:55:22 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/643a01845dd411e5d138b251f0dde9ed-6b03effa94afe.jpg?jadewits_media_id=324414" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/643a01845dd411e5d138b251f0dde9ed-6b03effa94afe.jpg?jadewits_media_id=324414" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/643a01845dd411e5d138b251f0dde9ed-6b03effa94afe.jpg?jadewits_media_id=324414" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডিবি হেফাজতে সুইডেন আসলাম, চলছে জিজ্ঞাসাবাদ" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর অন্যতম শীর্ষ সন্ত্রাসী হিসেবে পরিচিত শেখ আসলাম ওরফে সুইডেন আসলাম বর্তমানে ঢাকা মহানগর গোয়েন্দা পুলিশের (ডিবি) হেফাজতে রয়েছেন। তার বিরুদ্ধে একাধিক মামলা রয়েছে। এসব মামলার বিষয়ে তাকে জিজ্ঞাসাবাদ করা হচ্ছে বলে জানিয়েছে ঢাকা মহানগর পুলিশ (ডিএমপি)।&amp;nbsp;
সোমবার (২৩ নভেম্বর) এ তথ্য জানান ডিএমপির &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822577/%E0%A6%A1%E0%A6%BF%E0%A6%AC%E0%A6%BF-%E0%A6%B9%E0%A7%87%E0%A6%AB%E0%A6%BE%E0%A6%9C%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A7%81%E0%A6%87%E0%A6%A1%E0%A7%87%E0%A6%A8-%E0%A6%86%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE-%E0%A6%9A%E0%A6%B2%E0%A6%9B%E0%A7%87-%E0%A6%9C%E0%A6%BF%E0%A6%9C%E0%A7%8D%E0%A6%9E%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%A6">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>পলাতক আসামি সীমান্ত দিয়ে ঢুকলে গ্রেপ্তার করা হবে: বিজিবি</title>

      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/f3584b47d81441225538ff09deb9f721-6afb273843a97.jpg?jadewits_media_id=323194" length="0" type="image/jpeg" />

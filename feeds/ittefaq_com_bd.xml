      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/a4b992a990db74af53738ee3e2a3f949-6afc98a84b11f.jpg?jadewits_media_id=323413" style="max-width:100%;height:auto;margin-bottom:10px;" alt="১৯ নভেম্বর গোপালগঞ্জে নাশকতার পরিকল্পনার তথ্য রয়েছে: সংসদে জামায়াত আমির" /&gt;&lt;/p&gt;&lt;p&gt;আগামী ১৯ নভেম্বর গোপালগঞ্জে বড় ধরনের নাশকতার পরিকল্পনা করা হচ্ছে বলে তথ্য পাওয়ার দাবি করেছেন বিরোধীদলীয় নেতা ও জামায়াতে ইসলামীর আমির শফিকুর রহমান। এ পরিস্থিতি মোকাবিলায় সরকার কী পদক্ষেপ নিয়েছে, তা স্বরাষ্ট্রমন্ত্রীর কাছে জানতে চেয়েছেন তিনি। একই সঙ্গে সাধারণ মানুষের জীবন ও সম্পদ এবং রাষ্ট্রীয় স্থাপনা&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821587/%E0%A7%A7%E0%A7%AF-%E0%A6%A8%E0%A6%AD%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%A4%E0%A6%A5%E0%A7%8D%E0%A6%AF">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>মোহাম্মদপুরের ৫ স্থানে ককটেল নিক্ষেপ, চার জায়গায় বিস্ফোরণ</title>
      <link>https://www.ittefaq.com.bd/821586/%E0%A6%AE%E0%A7%8B%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%A6%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A7%AB-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA-%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A6%BE%E0%A7%9F%E0%A6%97%E0%A6%BE%E0%A7%9F</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821586/%E0%A6%AE%E0%A7%8B%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%A6%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A7%AB-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA-%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A6%BE%E0%A7%9F%E0%A6%97%E0%A6%BE%E0%A7%9F</guid>

      <guid isPermaLink="true">https://www.ittefaq.com.bd/822688/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C-%E0%A6%B8%E0%A6%A6%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BE%E0%A6%B2%E0%A7%80%E0%A6%AA%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%93-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7</guid>
      <pubDate>Tue, 24 Nov 2026 00:08:27 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/a4828669a5d604dc6a825fca4dc43a70-6b0480de721c4.jpg?jadewits_media_id=324529" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/a4828669a5d604dc6a825fca4dc43a70-6b0480de721c4.jpg?jadewits_media_id=324529" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/a4828669a5d604dc6a825fca4dc43a70-6b0480de721c4.jpg?jadewits_media_id=324529" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গোপালগঞ্জ সদরের পর কোটালীপাড়াতেও কার্যক্রম নিষিদ্ধ আওয়ামী লীগের দুই পক্ষে সংঘর্ষ" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জের কোটালীপাড়া উপজেলায় কার্যক্রম নিষিদ্ধ আওয়ামী লীগের মিছিল চলাকালে দুই পক্ষের সংঘর্ষে অন্তত ১০ জন আহত হয়েছেন এবং পাঁচটি দোকান ভাঙচুর করা হয়েছে। সোমবার (২৩ নভেম্বর) সন্ধ্যায় উপজেলার দক্ষিণ হিরণ গ্রামে এ সংঘর্ষের ঘটনা ঘটে।
আহত ব্যক্তিদের মধ্যে মশিউর রহমান (৪২), মিকাইল ইসলাম (৫২) ও জায়ে&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822688/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C-%E0%A6%B8%E0%A6%A6%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BE%E0%A6%B2%E0%A7%80%E0%A6%AA%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%93-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7">দৈনিক ইত্তেফাক</source>
    </item>
    <item>

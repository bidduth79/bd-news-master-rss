    <item>
      <title>মেধাবীরাই আগামী দিনে দেশ-জাতির নেতৃত্ব দেবে: ডা. তাহের</title>
      <link>https://www.ittefaq.com.bd/822291/%E0%A6%AE%E0%A7%87%E0%A6%A7%E0%A6%BE%E0%A6%AC%E0%A7%80%E0%A6%B0%E0%A6%BE%E0%A6%87-%E0%A6%86%E0%A6%97%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AC-%E0%A6%A6%E0%A7%87%E0%A6%AC%E0%A7%87-%E0%A6%A1%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822291/%E0%A6%AE%E0%A7%87%E0%A6%A7%E0%A6%BE%E0%A6%AC%E0%A7%80%E0%A6%B0%E0%A6%BE%E0%A6%87-%E0%A6%86%E0%A6%97%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AC-%E0%A6%A6%E0%A7%87%E0%A6%AC%E0%A7%87-%E0%A6%A1%E0%A6%BE</guid>
      <pubDate>Sat, 21 Nov 2026 23:05:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/e6c39287b5a39bf7397fcd0b07156d31-6b01c7a7190c9.jpg?jadewits_media_id=324131" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/e6c39287b5a39bf7397fcd0b07156d31-6b01c7a7190c9.jpg?jadewits_media_id=324131" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/e6c39287b5a39bf7397fcd0b07156d31-6b01c7a7190c9.jpg?jadewits_media_id=324131" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মেধাবীরাই আগামী দিনে দেশ-জাতির নেতৃত্ব দেবে: ডা. তাহের" /&gt;&lt;/p&gt;&lt;p&gt;শুধু প্রাতিষ্ঠানিক সাফল্য অর্জন করলেই চলবে না, সততা, নৈতিকতা ও দেশপ্রেমের সমন্বয়ে নিজেদের যোগ্য নাগরিক হিসেবে গড়ে তুলতে হবে বলে মন্তব্য করেছেন জাতীয় সংসদের বিরোধীদলীয় উপনেতা ও বাংলাদেশ জামায়াতে ইসলামীর নায়েবে আমির ডা: সৈয়দ আব্দুল্লাহ মোহাম্মদ তাহের।&amp;nbsp;
তিনি বলেন, &amp;lsquo;আজকের মেধাবী শিক্ষার্থীরাই&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822291/%E0%A6%AE%E0%A7%87%E0%A6%A7%E0%A6%BE%E0%A6%AC%E0%A7%80%E0%A6%B0%E0%A6%BE%E0%A6%87-%E0%A6%86%E0%A6%97%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AC-%E0%A6%A6%E0%A7%87%E0%A6%AC%E0%A7%87-%E0%A6%A1%E0%A6%BE">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>ডাকাতির অভিযোগে নিষিদ্ধ ছাত্রলীগ নেতাসহ গ্রেপ্তার ২, পিস্তল উদ্ধার</title>

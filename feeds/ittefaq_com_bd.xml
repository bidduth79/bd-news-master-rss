    <item>
      <title>অনুমতি নেই আমির হামজার তাফসিরুল কোরআন মাহফিলের, একই মাঠে মাদকবিরোধী সমাবেশের ডাক</title>
      <link>https://www.ittefaq.com.bd/820672/%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AE%E0%A6%A4%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%86%E0%A6%AE%E0%A6%BF%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%A4%E0%A6%BE%E0%A6%AB%E0%A6%B8%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%B2-%E0%A6%95%E0%A7%8B%E0%A6%B0%E0%A6%86%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B9%E0%A6%AB%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820672/%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AE%E0%A6%A4%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%86%E0%A6%AE%E0%A6%BF%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%A4%E0%A6%BE%E0%A6%AB%E0%A6%B8%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%B2-%E0%A6%95%E0%A7%8B%E0%A6%B0%E0%A6%86%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B9%E0%A6%AB%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Fri, 13 Nov 2026 03:30:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/c4119a3412f5842f9fdd11e3f254115a-6af625ce00a25.jpg?jadewits_media_id=322465" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/c4119a3412f5842f9fdd11e3f254115a-6af625ce00a25.jpg?jadewits_media_id=322465" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/c4119a3412f5842f9fdd11e3f254115a-6af625ce00a25.jpg?jadewits_media_id=322465" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অনুমতি নেই আমির হামজার তাফসিরুল কোরআন মাহফিলের, একই মাঠে মাদকবিরোধী সমাবেশের ডাক" /&gt;&lt;/p&gt;&lt;p&gt;আইনশৃঙ্খলা পরিস্থিতির অবনতির আশঙ্কায় ঝিনাইদহের কালীগঞ্জের সরকারি নলডাঙ্গা ভূষণ স্কুল মাঠে মুফতি আমির হামজার তাফসিরুল কোরআন মাহফিলের অনুমতি দেয়নি জেলা প্রশাসন। বৃহস্পতিবার বিকেলে ঝিনাইদহের অতিরিক্ত জেলা ম্যাজিস্ট্রেট মোহাম্মদ সাইফুর রহমান স্বাক্ষরিত এক বিজ্ঞপ্তিতে এই সিদ্ধান্ত জানানো হয়। 
তবে প্রশাসন&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820672/%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AE%E0%A6%A4%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%86%E0%A6%AE%E0%A6%BF%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%A4%E0%A6%BE%E0%A6%AB%E0%A6%B8%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%B2-%E0%A6%95%E0%A7%8B%E0%A6%B0%E0%A6%86%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B9%E0%A6%AB%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%B0">দৈনিক ইত্তেফাক</source>

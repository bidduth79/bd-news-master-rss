    <item>
      <title>নতুন খবরে ‘একটু বেশিই রোমাঞ্চিত’ তাহসান</title>
      <link>https://www.ittefaq.com.bd/821535/%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%96%E0%A6%AC%E0%A6%B0%E0%A7%87-%E2%80%98%E0%A6%8F%E0%A6%95%E0%A6%9F%E0%A7%81-%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%BF%E0%A6%87-%E0%A6%B0%E0%A7%8B%E0%A6%AE%E0%A6%BE%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%BF%E0%A6%A4%E2%80%99-%E0%A6%A4%E0%A6%BE%E0%A6%B9%E0%A6%B8%E0%A6%BE%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821535/%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%96%E0%A6%AC%E0%A6%B0%E0%A7%87-%E2%80%98%E0%A6%8F%E0%A6%95%E0%A6%9F%E0%A7%81-%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%BF%E0%A6%87-%E0%A6%B0%E0%A7%8B%E0%A6%AE%E0%A6%BE%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%BF%E0%A6%A4%E2%80%99-%E0%A6%A4%E0%A6%BE%E0%A6%B9%E0%A6%B8%E0%A6%BE%E0%A6%A8</guid>
      <pubDate>Tue, 17 Nov 2026 18:44:42 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/ce98409eff092cc6d58d71813aa02e33-6afc4c2619d09.jpg?jadewits_media_id=323354" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/ce98409eff092cc6d58d71813aa02e33-6afc4c2619d09.jpg?jadewits_media_id=323354" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/ce98409eff092cc6d58d71813aa02e33-6afc4c2619d09.jpg?jadewits_media_id=323354" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নতুন খবরে ‘একটু বেশিই রোমাঞ্চিত’ তাহসান" /&gt;&lt;/p&gt;&lt;p&gt;গান ও অভিনয় থেকে নিজেকে অনেকটা গুটিয়ে নিলেও উপস্থাপনায় এখনো বেশ সরব তাহসান রহমান খান। জনপ্রিয় গেম শো &amp;lsquo;ফ্যামিলি ফিউড বাংলাদেশ&amp;rsquo;-এর সঞ্চালক হিসেবে নিয়মিত দেখা যাচ্ছে তাকে। ইতিমধ্যে অনুষ্ঠানটির দুটি সিজন সঞ্চালনা করেছেন এই তারকা, যার দ্বিতীয় সিজনটি টিভি ও ডিজিটাল প্ল্যাটফর্ম মিলিয়ে ১০০ কোটির&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821535/%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%96%E0%A6%AC%E0%A6%B0%E0%A7%87-%E2%80%98%E0%A6%8F%E0%A6%95%E0%A6%9F%E0%A7%81-%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%BF%E0%A6%87-%E0%A6%B0%E0%A7%8B%E0%A6%AE%E0%A6%BE%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%BF%E0%A6%A4%E2%80%99-%E0%A6%A4%E0%A6%BE%E0%A6%B9%E0%A6%B8%E0%A6%BE%E0%A6%A8">দৈনিক ইত্তেফাক</source>
    </item>
    <item>

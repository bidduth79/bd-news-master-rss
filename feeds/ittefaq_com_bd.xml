      <guid isPermaLink="true">https://www.ittefaq.com.bd/822491/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%87%E0%A6%89%E0%A6%AA%E0%A6%BF-%E0%A6%9A%E0%A7%87%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A6%95%E0%A7%87</guid>
      <pubDate>Sun, 22 Nov 2026 22:54:23 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/7fdd5d286620640b357f9a6b80909a43-6b031d0d846d1.jpg?jadewits_media_id=324332" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/7fdd5d286620640b357f9a6b80909a43-6b031d0d846d1.jpg?jadewits_media_id=324332" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/7fdd5d286620640b357f9a6b80909a43-6b031d0d846d1.jpg?jadewits_media_id=324332" style="max-width:100%;height:auto;margin-bottom:10px;" alt="খুলনায় গোপালগঞ্জের সাবেক ইউপি চেয়ারম্যানকে গণপিটুনি দিয়ে পুলিশে সোপর্দ" /&gt;&lt;/p&gt;&lt;p&gt;খুলনায় গোপালগঞ্জের এক আওয়ামী লীগ নেতা ও সাবেক ইউনিয়ন পরিষদ (ইউপি) চেয়ারম্যানকে গণপিটুনি দিয়ে পুলিশের কাছে সোপর্দ করেছেন স্থানীয় লোকজন।
রোববার (২২ নভেম্বর) দুপুর ১২টা থেকে ১টার মধ্যে নগরীর কেসিসি মার্কেটের সামনে এ ঘটনা ঘটে। মারধরের শিকার ওই ব্যক্তির নাম শেখ আবেদ আলী।
প্রত্যক্ষদর্শী ও পুলিশ সূত্রে জান&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822491/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%87%E0%A6%89%E0%A6%AA%E0%A6%BF-%E0%A6%9A%E0%A7%87%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A6%95%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>সাদিক কায়েমের বাড়িতে অগ্নিসংযোগে জড়িত নিষিদ্ধ ছাত্রলীগ: পুলিশ</title>

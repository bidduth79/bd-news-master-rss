    <item>
      <title>৯৬ কোটি টাকার জন্মনিয়ন্ত্রণ বড়ি কিনছে সরকার</title>
      <link>https://www.ittefaq.com.bd/820538/%E0%A7%AF%E0%A7%AC-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AE%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A3-%E0%A6%AC%E0%A7%9C%E0%A6%BF-%E0%A6%95%E0%A6%BF%E0%A6%A8%E0%A6%9B%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820538/%E0%A7%AF%E0%A7%AC-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AE%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A3-%E0%A6%AC%E0%A7%9C%E0%A6%BF-%E0%A6%95%E0%A6%BF%E0%A6%A8%E0%A6%9B%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Thu, 12 Nov 2026 14:41:30 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/97036591c57bbe4f5e013c006e5b65c4-6af57bb82d47e.jpg?jadewits_media_id=322328" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/97036591c57bbe4f5e013c006e5b65c4-6af57bb82d47e.jpg?jadewits_media_id=322328" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/97036591c57bbe4f5e013c006e5b65c4-6af57bb82d47e.jpg?jadewits_media_id=322328" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৯৬ কোটি টাকার জন্মনিয়ন্ত্রণ বড়ি কিনছে সরকার" /&gt;&lt;/p&gt;&lt;p&gt;পরিবার পরিকল্পনা কার্যক্রমের আওতায় ১ কোটি ৯৩ লাখ ৭৫ হাজার সাইকেল জন্মনিয়ন্ত্রণ খাবার বড়ি কিনবে সরকার। ৯৬ কোটি ৫৪ লাখ ৫৬ হাজার ২৫০ টাকা ব্যয়ে এসব বড়ি সরবরাহ করবে দেশীয় প্রতিষ্ঠান পপুলার ফার্মাসিউটিক্যালস।
বৃহস্পতিবার (১২ নভেম্বর) অর্থমন্ত্রী আমির খসরু মাহমুদ চৌধুরীর সভাপতিত্বে অনুষ্ঠিত সরকারি ক্রয় সং&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820538/%E0%A7%AF%E0%A7%AC-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AE%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A3-%E0%A6%AC%E0%A7%9C%E0%A6%BF-%E0%A6%95%E0%A6%BF%E0%A6%A8%E0%A6%9B%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>

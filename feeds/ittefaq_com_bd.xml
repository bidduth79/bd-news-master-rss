      <pubDate>Thu, 19 Nov 2026 00:48:58 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/14b15ddcbdf18dbd8ccb9a71e14ce206-6afdf284b1d1e.jpg?jadewits_media_id=323620" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/14b15ddcbdf18dbd8ccb9a71e14ce206-6afdf284b1d1e.jpg?jadewits_media_id=323620" medium="image" />

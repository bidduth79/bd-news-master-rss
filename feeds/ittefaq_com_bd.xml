      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/99b8c5b03a268452467962df7a4a55af-6b050975c7215.jpg?jadewits_media_id=324558" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাংলাদেশে যুক্তরাষ্ট্র থেকে গরুর মাংস আমদানির প্রস্তাব মার্কিন রাষ্ট্রদূতের" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাষ্ট্রের আইওয়া অঙ্গরাজ্যের হালাল সনদপ্রাপ্ত গরুর মাংস বাংলাদেশের বাজারে প্রবেশের সুযোগ তৈরির প্রস্তাব দিয়েছেন ঢাকায় নিযুক্ত মার্কিন রাষ্ট্রদূত ব্রেন্ট টি. ক্রিস্টেনসেন। প্রাথমিকভাবে দেশের হোটেল ও রেস্তোরাঁগুলোতে এ মাংস আমদানির অনুমতি দেওয়ার আহ্বান জানিয়েছেন তিনি। তার মতে, এ উদ্যোগের মাধ্যমে বা&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822719/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%97%E0%A6%B0%E0%A7%81%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%82%E0%A6%B8-%E0%A6%86%E0%A6%AE%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>১৬ ডিসেম্বর রাষ্ট্রীয় বিমানে দেশে ফিরতে চান শেখ হাসিনা</title>
      <link>https://www.ittefaq.com.bd/822718/%E0%A7%A7%E0%A7%AC-%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%AF%E0%A6%BC-%E0%A6%AC%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%A8-%E0%A6%B6%E0%A7%87%E0%A6%96</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822718/%E0%A7%A7%E0%A7%AC-%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%AF%E0%A6%BC-%E0%A6%AC%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%A8-%E0%A6%B6%E0%A7%87%E0%A6%96</guid>
      <pubDate>Tue, 24 Nov 2026 09:58:04 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/4360683c493542bbc089f27acf79fa7a-6b050b4985157.png?jadewits_media_id=324560" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/4360683c493542bbc089f27acf79fa7a-6b050b4985157.png?jadewits_media_id=324560" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/4360683c493542bbc089f27acf79fa7a-6b050b4985157.png?jadewits_media_id=324560" style="max-width:100%;height:auto;margin-bottom:10px;" alt="১৬ ডিসেম্বর রাষ্ট্রীয় বিমানে দেশে ফিরতে চান শেখ হাসিনা" /&gt;&lt;/p&gt;&lt;p&gt;দুই বছরের বেশি সময় ভারতে নির্বাসনে থাকা ক্ষমতাচ্যুত প্রধানমন্ত্রী শেখ হাসিনা আগামী ১৬ ডিসেম্বর দেশে ফেরার পরিকল্পনা করছেন। ১৯৭১ সালে পাকিস্তানের বিরুদ্ধে বাংলাদেশের বিজয়ের দিনে দেশে ফেরার কথা মঙ্গলবার (২৪ নভেম্বর) রয়টার্সকে জানিয়েছেন তার মুখপাত্র।
এই প্রথম দেশে ফেরার নির্দিষ্ট তারিখ ঘোষণা করলেন হ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822718/%E0%A7%A7%E0%A7%AC-%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%AF%E0%A6%BC-%E0%A6%AC%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%A8-%E0%A6%B6%E0%A7%87%E0%A6%96">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>হিজাব ছাড়া কনসার্টে গান পরিবেশন, ইরানি সংগীতশিল্পীকে ৭৪ বার বেত্রাঘাত</title>
      <link>https://www.ittefaq.com.bd/822717/%E0%A6%B9%E0%A6%BF%E0%A6%9C%E0%A6%BE%E0%A6%AC-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE-%E0%A6%95%E0%A6%A8%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A7%87-%E0%A6%97%E0%A6%BE%E0%A6%A8-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%A8-%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822717/%E0%A6%B9%E0%A6%BF%E0%A6%9C%E0%A6%BE%E0%A6%AC-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE-%E0%A6%95%E0%A6%A8%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A7%87-%E0%A6%97%E0%A6%BE%E0%A6%A8-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%A8-%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A6%BF</guid>
      <pubDate>Tue, 24 Nov 2026 09:42:27 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/2ba8cf098863ca7b9712944ec9e96cfa-6b050747d68cd.jpg?jadewits_media_id=324555" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/2ba8cf098863ca7b9712944ec9e96cfa-6b050747d68cd.jpg?jadewits_media_id=324555" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/2ba8cf098863ca7b9712944ec9e96cfa-6b050747d68cd.jpg?jadewits_media_id=324555" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হিজাব ছাড়া কনসার্টে গান পরিবেশন, ইরানি সংগীতশিল্পীকে ৭৪ বার বেত্রাঘাত" /&gt;&lt;/p&gt;&lt;p&gt;হিজাব ছাড়া কনসার্টে গান পরিবেশনের দায়ে ইরানি সংগীতশিল্পী পারাস্তু আহমাদি ও তার দলের চার সদস্যকে ৭৪ বার করে বেত্রাঘাত করা হয়েছে। জনসমক্ষে নারীদের পোশাকবিধি লঙ্ঘনের অভিযোগে দেওয়া এ শাস্তি ইরানে হিজাব আইন আরও কঠোরভাবে কার্যকরের সরকারি অবস্থানের ইঙ্গিত দিচ্ছে।
সোমবার (২৩ নভেম্বর) সংগীতশিল্পী ও তার সহযোগ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822717/%E0%A6%B9%E0%A6%BF%E0%A6%9C%E0%A6%BE%E0%A6%AC-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE-%E0%A6%95%E0%A6%A8%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A7%87-%E0%A6%97%E0%A6%BE%E0%A6%A8-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%A8-%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A6%BF">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>ঢাকাসহ দেশের বিভিন্ন জেলায় ১০১ প্লাটুন বিজিবি মোতায়েন</title>
      <link>https://www.ittefaq.com.bd/822716/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B8%E0%A6%B9-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%A8-%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A7%A7%E0%A7%A6%E0%A7%A7-%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%9F%E0%A7%81%E0%A6%A8-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%AC%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822716/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B8%E0%A6%B9-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%A8-%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A7%A7%E0%A7%A6%E0%A7%A7-%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%9F%E0%A7%81%E0%A6%A8-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%AC%E0%A6%BF</guid>
      <pubDate>Tue, 24 Nov 2026 09:41:23 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/0fe495b814ee5fee2f6e630ed64985c6-6b050711a4b97.jpg?jadewits_media_id=324554" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/0fe495b814ee5fee2f6e630ed64985c6-6b050711a4b97.jpg?jadewits_media_id=324554" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/0fe495b814ee5fee2f6e630ed64985c6-6b050711a4b97.jpg?jadewits_media_id=324554" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঢাকাসহ দেশের বিভিন্ন জেলায় ১০১ প্লাটুন বিজিবি মোতায়েন" /&gt;&lt;/p&gt;&lt;p&gt;আইনশৃঙ্খলা পরিস্থিতি নিয়ন্ত্রণ ও জননিরাপত্তা নিশ্চিত করতে ঢাকাসহ দেশের বিভিন্ন জেলায় ১০১ প্লাটুন বর্ডার গার্ড বাংলাদেশ (বিজিবি) মোতায়েন করা হয়েছে। এর মধ্যে গোপালগঞ্জে মোতায়েন করা হয়েছে দুই ব্যাটালিয়ন বিজিবি।
মঙ্গলবার (২৪ নভেম্বর) বিজিবি সদর দপ্তরের এক বিজ্ঞপ্তিতে এ তথ্য জানানো হয়।
বিজ্ঞপ্তিতে বলা হয়&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822716/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B8%E0%A6%B9-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%A8-%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A7%A7%E0%A7%A6%E0%A7%A7-%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%9F%E0%A7%81%E0%A6%A8-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%AC%E0%A6%BF">দৈনিক ইত্তেফাক</source>

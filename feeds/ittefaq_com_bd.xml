      <guid isPermaLink="true">https://www.ittefaq.com.bd/822132/%E0%A6%AD%E0%A7%8B%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%95%E0%A6%BE-%E0%A6%B8%E0%A6%82%E0%A6%B6%E0%A7%8B%E0%A6%A7%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%97%E0%A7%87%E0%A6%9F-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A7%81%E0%A6%B8%E0%A6%B2%E0%A6%BF%E0%A6%AE%E0%A6%A6%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Sat, 21 Nov 2026 00:26:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/862f44eac46820dc237909f8295b55fa-6b0089c736668.jpg?jadewits_media_id=323970" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/862f44eac46820dc237909f8295b55fa-6b0089c736668.jpg?jadewits_media_id=323970" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/862f44eac46820dc237909f8295b55fa-6b0089c736668.jpg?jadewits_media_id=323970" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভোটার তালিকা সংশোধনের নামে টার্গেট করে মুসলিমদের বাদ দিচ্ছে ভারত: মার্কিন কমিশন" /&gt;&lt;/p&gt;&lt;p&gt;ভারতে ভোটার তালিকা সংশোধনের (এসআইআর) নামে ধর্মীয় সংখ্যালঘু বিশেষ করে মুসলিম নাগরিকদের লক্ষ্যবস্তু বানানোর প্রবণতা আশঙ্কাজনকভাবে বেড়েছে বলে অভিযোগ করেছে যুক্তরাষ্ট্রের আন্তর্জাতিক ধর্মীয় স্বাধীনতাবিষয়ক কমিশন (ইউএসসিআইআরএফ)। দেশজুড়ে পরিচালিত এই প্রক্রিয়ায় ভোটার তালিকা থেকে প্রায় ১৩ কোটি মানুষের নাম বা&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822132/%E0%A6%AD%E0%A7%8B%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%95%E0%A6%BE-%E0%A6%B8%E0%A6%82%E0%A6%B6%E0%A7%8B%E0%A6%A7%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%97%E0%A7%87%E0%A6%9F-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A7%81%E0%A6%B8%E0%A6%B2%E0%A6%BF%E0%A6%AE%E0%A6%A6%E0%A7%87%E0%A6%B0">দৈনিক ইত্তেফাক</source>

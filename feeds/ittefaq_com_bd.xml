    </item>
    <item>
      <title>‘জয় বাংলা’ স্লোগান দেওয়ার অভিযোগে দুজন গ্রেপ্তার, পরিবার বলছে তারা জুলাই আন্দোলনকারী</title>
      <link>https://www.ittefaq.com.bd/823486/%E2%80%98%E0%A6%9C%E0%A7%9F-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E2%80%99-%E0%A6%B8%E0%A7%8D%E0%A6%B2%E0%A7%8B%E0%A6%97%E0%A6%BE%E0%A6%A8-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%9C%E0%A6%A8-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823486/%E2%80%98%E0%A6%9C%E0%A7%9F-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E2%80%99-%E0%A6%B8%E0%A7%8D%E0%A6%B2%E0%A7%8B%E0%A6%97%E0%A6%BE%E0%A6%A8-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%9C%E0%A6%A8-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Sat, 28 Nov 2026 22:51:06 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/a2bfbf8fc081540640a0e0785610f241-6b0b065c7318a.jpg?jadewits_media_id=325383" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/a2bfbf8fc081540640a0e0785610f241-6b0b065c7318a.jpg?jadewits_media_id=325383" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/a2bfbf8fc081540640a0e0785610f241-6b0b065c7318a.jpg?jadewits_media_id=325383" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘জয় বাংলা’ স্লোগান দেওয়ার অভিযোগে দুজন গ্রেপ্তার, পরিবার বলছে তারা জুলাই আন্দোলনকারী" /&gt;&lt;/p&gt;&lt;p&gt;রাজশাহীর গোদাগাড়ীতে &amp;lsquo;জয় বাংলা&amp;rsquo; স্লোগান দেওয়ার অভিযোগে দুই যুবককে গ্রেপ্তার করেছে পুলিশ। তাঁদের পরিবারের দাবি, দুজনই ২০২৪ সালের জুলাই আন্দোলনে সক্রিয় ছিলেন। আওয়ামী লীগ সরকারের পতনের আগের দিন আন্দোলনে তাদের অংশগ্রহণের ছবিও পাওয়া গেছে। তবে সম্প্রতি বিএনপির কার্যালয় পোড়ানোর মামলায় তাঁদের গ্র&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823486/%E2%80%98%E0%A6%9C%E0%A7%9F-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E2%80%99-%E0%A6%B8%E0%A7%8D%E0%A6%B2%E0%A7%8B%E0%A6%97%E0%A6%BE%E0%A6%A8-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%9C%E0%A6%A8-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0">দৈনিক ইত্তেফাক</source>

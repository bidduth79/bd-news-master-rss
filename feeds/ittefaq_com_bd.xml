    <item>
      <title>‘নেতানিয়াহুর কথা রাখার কোনও ইচ্ছাই ছিল না’, স্মৃতিকথায় জো বাইডেন</title>
      <link>https://www.ittefaq.com.bd/821203/%E2%80%98%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%B9%E0%A7%81%E0%A6%B0-%E0%A6%95%E0%A6%A5%E0%A6%BE-%E0%A6%B0%E0%A6%BE%E0%A6%96%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A7%8B%E0%A6%A8%E0%A6%93-%E0%A6%87%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A6%BE%E0%A6%87-%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%A8%E0%A6%BE%E2%80%99</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821203/%E2%80%98%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%B9%E0%A7%81%E0%A6%B0-%E0%A6%95%E0%A6%A5%E0%A6%BE-%E0%A6%B0%E0%A6%BE%E0%A6%96%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A7%8B%E0%A6%A8%E0%A6%93-%E0%A6%87%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A6%BE%E0%A6%87-%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%A8%E0%A6%BE%E2%80%99</guid>
      <pubDate>Mon, 16 Nov 2026 02:13:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/ceb4c20db9a0fd8e3d4ce5b5ca58bd76-6afa0eec20754.jpg?jadewits_media_id=323016" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/ceb4c20db9a0fd8e3d4ce5b5ca58bd76-6afa0eec20754.jpg?jadewits_media_id=323016" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/ceb4c20db9a0fd8e3d4ce5b5ca58bd76-6afa0eec20754.jpg?jadewits_media_id=323016" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘নেতানিয়াহুর কথা রাখার কোনও ইচ্ছাই ছিল না’, স্মৃতিকথায় জো বাইডেন" /&gt;&lt;/p&gt;&lt;p&gt;গাজায় বেসামরিক মানুষের প্রাণহানি কমানোর প্রতিশ্রুতি বারবার দিয়েও তা বাস্তবায়ন করেননি ইসরাইলের প্রধানমন্ত্রী বেনিয়ামিন নেতানিয়াহু। এমন অভিযোগ করেছেন যুক্তরাষ্ট্রের সাবেক প্রেসিডেন্ট জো বাইডেন। তিনি বলেছেন, নেতানিয়াহু নিজের তাৎক্ষণিক রাজনৈতিক স্বার্থের বাইরে গিয়ে দীর্ঘমেয়াদী পরিণতির কথা ভাবতে নারাজ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821203/%E2%80%98%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%B9%E0%A7%81%E0%A6%B0-%E0%A6%95%E0%A6%A5%E0%A6%BE-%E0%A6%B0%E0%A6%BE%E0%A6%96%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A7%8B%E0%A6%A8%E0%A6%93-%E0%A6%87%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A6%BE%E0%A6%87-%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%A8%E0%A6%BE%E2%80%99">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>মিয়ানমারে রোহিঙ্গা গণহত্যা নিয়ে জাতিসংঘের সর্বোচ্চ আদালতে রায় ১৯ নভেম্বর</title>
      <link>https://www.ittefaq.com.bd/821202/%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%97%E0%A6%A3%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A7%8B%E0%A6%9A%E0%A7%8D%E0%A6%9A</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821202/%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%97%E0%A6%A3%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A7%8B%E0%A6%9A%E0%A7%8D%E0%A6%9A</guid>
      <pubDate>Mon, 16 Nov 2026 01:39:50 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/59582044c8b8398e258fcc91ff3b7e0e-6afa09759ece1.jpg?jadewits_media_id=323015" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/59582044c8b8398e258fcc91ff3b7e0e-6afa09759ece1.jpg?jadewits_media_id=323015" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/59582044c8b8398e258fcc91ff3b7e0e-6afa09759ece1.jpg?jadewits_media_id=323015" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মিয়ানমারে রোহিঙ্গা গণহত্যা নিয়ে জাতিসংঘের সর্বোচ্চ আদালতে রায় ১৯ নভেম্বর" /&gt;&lt;/p&gt;&lt;p&gt;বিচারের অপেক্ষায় কেটে গেছে বছরের পর বছর। ঘরবাড়ি হারিয়ে, স্বজনদের ফেলে প্রাণ বাঁচাতে বাংলাদেশে আশ্রয় নেওয়া রোহিঙ্গাদের সেই অপেক্ষার অবসান হতে যাচ্ছে। দ্বিতীয় বিশ্বযুদ্ধের পর আন্তর্জাতিক আইনের ইতিহাসে অন্যতম গুরুত্বপূর্ণ রায় দিতে যাচ্ছেন জাতিসংঘের সর্বোচ্চ আদালত।
মিয়ানমার তার সংখ্যালঘু রোহিঙ্গা জনগোষ্&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821202/%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%97%E0%A6%A3%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A7%8B%E0%A6%9A%E0%A7%8D%E0%A6%9A">দৈনিক ইত্তেফাক</source>

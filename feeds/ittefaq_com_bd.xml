    </item>
    <item>
      <title>চার বছরের শিশুকে যৌ’ন নি’পীড়নের মামলায় যুবকের ১০ বছরের কারাদণ্ড</title>
      <link>https://www.ittefaq.com.bd/822402/%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%95%E0%A7%87-%E0%A6%AF%E0%A7%8C%E2%80%99%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E2%80%99%E0%A6%AA%E0%A7%80%E0%A6%A1%E0%A6%BC%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A7%A7%E0%A7%A6</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822402/%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%95%E0%A7%87-%E0%A6%AF%E0%A7%8C%E2%80%99%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E2%80%99%E0%A6%AA%E0%A7%80%E0%A6%A1%E0%A6%BC%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A7%A7%E0%A7%A6</guid>
      <pubDate>Sun, 22 Nov 2026 16:12:46 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/73e6d3642245f4947cbf0dc2cad9ae33-6b02bfd0cef5e.jpg?jadewits_media_id=324244" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/73e6d3642245f4947cbf0dc2cad9ae33-6b02bfd0cef5e.jpg?jadewits_media_id=324244" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/73e6d3642245f4947cbf0dc2cad9ae33-6b02bfd0cef5e.jpg?jadewits_media_id=324244" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চার বছরের শিশুকে যৌ’ন নি’পীড়নের মামলায় যুবকের ১০ বছরের কারাদণ্ড" /&gt;&lt;/p&gt;&lt;p&gt;ফরিদপুরের মধুখালীতে চার বছরের শিশুকে যৌন নিপীড়নের দায়ে আশরাফুল উকিল (২৮) নামের এক যুবককে ১০ বছরের কারাদণ্ড দিয়েছেন আদালত। একই সঙ্গে তাকে ৫০ হাজার টাকা জরিমানা, অনাদায়ে আরও এক বছরের কারাদণ্ডের আদেশ দেওয়া হয়েছে।
রোববার (২২ নভেম্বর) দুপুরে ফরিদপুর নারী ও শিশু নির্যাতন দমন ট্রাইব্যুনালের বিচারক জে&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822402/%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%95%E0%A7%87-%E0%A6%AF%E0%A7%8C%E2%80%99%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E2%80%99%E0%A6%AA%E0%A7%80%E0%A6%A1%E0%A6%BC%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A7%A7%E0%A7%A6">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>ফতুল্লায় গ্যাসের আগুনে দগ্ধ স্বামীর মৃত্যু, আইসিইউতে স্ত্রী</title>
      <link>https://www.ittefaq.com.bd/822401/%E0%A6%AB%E0%A6%A4%E0%A7%81%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8%E0%A7%87-%E0%A6%A6%E0%A6%97%E0%A7%8D%E0%A6%A7-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822401/%E0%A6%AB%E0%A6%A4%E0%A7%81%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8%E0%A7%87-%E0%A6%A6%E0%A6%97%E0%A7%8D%E0%A6%A7-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81</guid>
      <pubDate>Sun, 22 Nov 2026 16:11:26 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/f3e91885e3cadc07b6671a670e9fc307-6b02bf806e5ec.jpg?jadewits_media_id=324243" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/f3e91885e3cadc07b6671a670e9fc307-6b02bf806e5ec.jpg?jadewits_media_id=324243" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/f3e91885e3cadc07b6671a670e9fc307-6b02bf806e5ec.jpg?jadewits_media_id=324243" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফতুল্লায় গ্যাসের আগুনে দগ্ধ স্বামীর মৃত্যু, আইসিইউতে স্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;নারায়ণগঞ্জের ফতুল্লায় আবাসিক ফ্ল্যাটে জমে থাকা গ্যাস থেকে আগুনের ঘটনায় দগ্ধ শাহিন (৩০) মারা গেছেন। তার শরীরের ৬৮ শতাংশ পুড়ে গিয়েছিল। একই ঘটনায় দগ্ধ তার স্ত্রী লিমা পারভীন (২৬) আশঙ্কাজনক অবস্থায় নিবিড় পরিচর্যা কেন্দ্রে (আইসিইউ) চিকিৎসাধীন রয়েছেন।
রোববার (২২ নভেম্বর) ভোর ৪টার দিকে ঢাকা মেডিকেল কলেজ হা&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822401/%E0%A6%AB%E0%A6%A4%E0%A7%81%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8%E0%A7%87-%E0%A6%A6%E0%A6%97%E0%A7%8D%E0%A6%A7-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>সংযোগ সড়ক উধাও, ৩১ লাখ টাকার সেতুতে চলছে ধান শুকানোর মহোৎসব</title>
      <link>https://www.ittefaq.com.bd/822400/%E0%A6%B8%E0%A6%82%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%B8%E0%A7%9C%E0%A6%95-%E0%A6%89%E0%A6%A7%E0%A6%BE%E0%A6%93-%E0%A7%A9%E0%A7%A7-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%87%E0%A6%A4%E0%A7%81%E0%A6%A4%E0%A7%87-%E0%A6%9A%E0%A6%B2%E0%A6%9B%E0%A7%87-%E0%A6%A7%E0%A6%BE%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822400/%E0%A6%B8%E0%A6%82%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%B8%E0%A7%9C%E0%A6%95-%E0%A6%89%E0%A6%A7%E0%A6%BE%E0%A6%93-%E0%A7%A9%E0%A7%A7-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%87%E0%A6%A4%E0%A7%81%E0%A6%A4%E0%A7%87-%E0%A6%9A%E0%A6%B2%E0%A6%9B%E0%A7%87-%E0%A6%A7%E0%A6%BE%E0%A6%A8</guid>
      <pubDate>Sun, 22 Nov 2026 16:07:11 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/a1b07f306d60d180d20c9145556492fe-6b02beb9c2522.jpg?jadewits_media_id=324242" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/a1b07f306d60d180d20c9145556492fe-6b02beb9c2522.jpg?jadewits_media_id=324242" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/a1b07f306d60d180d20c9145556492fe-6b02beb9c2522.jpg?jadewits_media_id=324242" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সংযোগ সড়ক উধাও, ৩১ লাখ টাকার সেতুতে চলছে ধান শুকানোর মহোৎসব" /&gt;&lt;/p&gt;&lt;p&gt;মুন্সীগঞ্জের গজারিয়া উপজেলার ভবেরচর ইউনিয়নের শ্রীনগর গ্রামসংলগ্ন খালের ওপর প্রায় ৩১ লাখ টাকা ব্যয়ে নির্মিত সেতুটি গত সাত বছর ধরে যানবাহন চলাচলের বদলে ধান ও খড় শুকানোর কাজে ব্যবহৃত হচ্ছে। সেতুটির একপাশে সংযোগ সড়ক না থাকায় স্থানীয়দের যাতায়াতের কোনো কাজেই আসছে না এটি।ফলে কয়েকটি গ্রামের মানুষ ভোগান্&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822400/%E0%A6%B8%E0%A6%82%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%B8%E0%A7%9C%E0%A6%95-%E0%A6%89%E0%A6%A7%E0%A6%BE%E0%A6%93-%E0%A7%A9%E0%A7%A7-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%87%E0%A6%A4%E0%A7%81%E0%A6%A4%E0%A7%87-%E0%A6%9A%E0%A6%B2%E0%A6%9B%E0%A7%87-%E0%A6%A7%E0%A6%BE%E0%A6%A8">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>ইরানে সরকার পরিবর্তন নিয়ে আগ্রহ নেই ট্রাম্পের</title>
      <link>https://www.ittefaq.com.bd/822398/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%B9-%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822398/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%B9-%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Sun, 22 Nov 2026 16:03:31 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/aadcf9fcea662538017150abae4ef01f-6b02bda834f8b.jpg?jadewits_media_id=324240" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/aadcf9fcea662538017150abae4ef01f-6b02bda834f8b.jpg?jadewits_media_id=324240" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/aadcf9fcea662538017150abae4ef01f-6b02bda834f8b.jpg?jadewits_media_id=324240" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইরানে সরকার পরিবর্তন নিয়ে আগ্রহ নেই ট্রাম্পের" /&gt;&lt;/p&gt;&lt;p&gt;ইরানের ক্ষমতাসীন সরকার পরিবর্তনের বিষয়টি নিয়ে বিশেষ কোনো আগ্রহ নেই বলে জানিয়েছেন যুক্তরাষ্ট্রের প্রেসিডেন্ট ডোনাল্ড ট্রাম্প। তবে তেহরানের সঙ্গে দীর্ঘমেয়াদি একটি সমঝোতায় পৌঁছাতে চান তিনি। তার মতে, এমন চুক্তির মাধ্যমে ইরানের সঙ্গে চলমান সংঘাতের অবসান ঘটানোর পাশাপাশি দেশটিকে পারমাণবিক অস্ত্র অর্জন থেকে&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822398/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%B9-%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A7%87%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>

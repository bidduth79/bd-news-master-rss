    <item>
      <title>বিশ্ববাজারে কমলো জ্বালানি তেলের দাম</title>
      <link>https://www.ittefaq.com.bd/821408/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%95%E0%A6%AE%E0%A6%B2%E0%A7%8B-%E0%A6%9C%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%A4%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821408/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%95%E0%A6%AE%E0%A6%B2%E0%A7%8B-%E0%A6%9C%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%A4%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE</guid>
      <pubDate>Tue, 17 Nov 2026 08:29:46 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/09/18/1dca9541499d7346b992eea4e454921b-6aac9ec7b57a7.jpg?jadewits_media_id=311654" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/09/18/1dca9541499d7346b992eea4e454921b-6aac9ec7b57a7.jpg?jadewits_media_id=311654" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/09/18/1dca9541499d7346b992eea4e454921b-6aac9ec7b57a7.jpg?jadewits_media_id=311654" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিশ্ববাজারে কমলো জ্বালানি তেলের দাম" /&gt;&lt;/p&gt;&lt;p&gt;কৌশলগত জলপথ হরমুজ প্রণালি দিয়ে তেল সরবরাহ পুনরায় স্বাভাবিক হতে শুরু করায় বিশ্ববাজারে অপরিশোধিত তেলের দাম ৩ শতাংশের বেশি কমেছে।
মঙ্গলবার (১৭ নভেম্বর) আল জাজিরার এক প্রতিবেদনে এই তথ্য জানানো হয়েছে।
বাজারের তথ্য অনুযায়ী, ব্রেন্ট ক্রুড ফিউচারের দাম ৩ দশমিক ৬ শতাংশ কমে ব্যারেলপ্রতি ৯২ দশমিক ৪৪ ডলারে &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821408/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%95%E0%A6%AE%E0%A6%B2%E0%A7%8B-%E0%A6%9C%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%A4%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE">দৈনিক ইত্তেফাক</source>
    </item>

      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/76eb117be3ce97bb7d1f37948ecf1d9d-6aff36ffac6ac.jpg?jadewits_media_id=323811" medium="image" />

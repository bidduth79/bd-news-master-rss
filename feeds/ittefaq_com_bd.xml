      <guid isPermaLink="true">https://www.ittefaq.com.bd/821986/%E0%A6%A4%E0%A6%B0%E0%A7%81%E0%A6%A3%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8-%E0%A6%A4%E0%A7%88%E0%A6%B0%E0%A6%BF-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87%C2%A0%E0%A6%A8%E0%A6%BE</guid>
      <pubDate>Fri, 20 Nov 2026 04:00:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2023/08/09/2e5c71f802e13dea40110b7aeca153cf-64d36cf920d11.jpg?jadewits_media_id=121705" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2023/08/09/2e5c71f802e13dea40110b7aeca153cf-64d36cf920d11.jpg?jadewits_media_id=121705" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2023/08/09/2e5c71f802e13dea40110b7aeca153cf-64d36cf920d11.jpg?jadewits_media_id=121705" style="max-width:100%;height:auto;margin-bottom:10px;" alt="তরুণদের জন্য পর্যাপ্ত কর্মসংস্থান তৈরি হচ্ছে না: বিশ্বব্যাংক" /&gt;&lt;/p&gt;&lt;p&gt;স্বল্প রাজস্ব আদায়, ক্রমবর্ধমান অনুন্নয়ন ব্যয় এবং জ্বালানি খাতের ভর্তুকির চাপে বাংলাদেশের উন্নয়নমূলক খাতে বিনিয়োগ সংকুচিত হয়ে পড়েছে। বিশ্বব্যাংকের সর্বশেষ ‘বাংলাদেশ পাবলিক ফাইন্যান্স রিভিউ ২০২৬’ শীর্ষক প্রতিবেদনে এ সতর্কবার্তা দেওয়া হয়েছে। গতকাল বৃহস্পতিবার  প্রকাশিত এই প্রতিবেদনে বলা হয়েছে, ২০৩৪ সা&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821986/%E0%A6%A4%E0%A6%B0%E0%A7%81%E0%A6%A3%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8-%E0%A6%A4%E0%A7%88%E0%A6%B0%E0%A6%BF-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87%C2%A0%E0%A6%A8%E0%A6%BE">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>ফোনে প্রধানমন্ত্রীর ছবি দেখে বিএনপি নেতাকে তুলে নিয়ে গেল আওয়ামী লীগের নেতাকর্মীরা</title>
      <link>https://www.ittefaq.com.bd/821994/%E0%A6%AB%E0%A7%8B%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%9B%E0%A6%AC%E0%A6%BF-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%A4%E0%A7%81%E0%A6%B2%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821994/%E0%A6%AB%E0%A7%8B%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%9B%E0%A6%AC%E0%A6%BF-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%A4%E0%A7%81%E0%A6%B2%E0%A7%87</guid>
      <pubDate>Fri, 20 Nov 2026 03:30:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/4e12f120c438c6d9299ec8e9e6139bd3-6aff5a2b6a47d.jpg?jadewits_media_id=323828" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/4e12f120c438c6d9299ec8e9e6139bd3-6aff5a2b6a47d.jpg?jadewits_media_id=323828" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/4e12f120c438c6d9299ec8e9e6139bd3-6aff5a2b6a47d.jpg?jadewits_media_id=323828" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফোনে প্রধানমন্ত্রীর ছবি দেখে বিএনপি নেতাকে তুলে নিয়ে গেল আওয়ামী লীগের নেতাকর্মীরা" /&gt;&lt;/p&gt;&lt;p&gt;বাগেরহাট জেলা বিএনপির সদস্য মনিরুল হক ফরাজিকে অপহরণের অভিযোগ উঠেছে কার্যক্রম নিষিদ্ধ আওয়ামী লীগের নেতাকর্মীদের বিরুদ্ধে। বৃহস্পতিবার (১৯ নভেম্বর) ভোরে খুলনা-মাওয়া মহাসড়কের গোপালগঞ্জ অংশের ঘোনাপাড়া এলাকায় এ ঘটনা ঘটে।
অভিযোগ উঠেছে, মনিরুল হক ফরাজির মুঠোফোনে প্রধানমন্ত্রীর ছবিসহ দলীয় কার্যক্রমের &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821994/%E0%A6%AB%E0%A7%8B%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%9B%E0%A6%AC%E0%A6%BF-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%A4%E0%A7%81%E0%A6%B2%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>সশস্ত্র বাহিনীর জন্য নতুন বেতন কাঠামো নির্ধারণ করলো সরকার</title>

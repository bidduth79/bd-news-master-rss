      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/8874b11ecb410bdeb772b2b26336e128-6af9f7563b838.jpg?jadewits_media_id=323009" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/8874b11ecb410bdeb772b2b26336e128-6af9f7563b838.jpg?jadewits_media_id=323009" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/8874b11ecb410bdeb772b2b26336e128-6af9f7563b838.jpg?jadewits_media_id=323009" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সরকার উৎখাতের ষড়যন্ত্রের ব্লু-প্রিন্ট তৈরিতে জড়িত এসপি জাহাঙ্গীর: এজাহারে অভিযোগ" /&gt;&lt;/p&gt;&lt;p&gt;বর্তমান সরকার ও রাষ্ট্রব্যবস্থাকে উৎখাতের ষড়যন্ত্রের পরিকল্পনা তৈরি এবং তা বাস্তবায়নে সহায়তার অভিযোগে চট্টগ্রাম রেঞ্জ রিজার্ভ ফোর্সের (আরআরএফ) পুলিশ সুপার (এসপি) মোহাম্মদ জাহাঙ্গীর আলমকে চার দিনের রিমান্ডে পাঠিয়েছেন আদালত। এজাহারে বলা হয়েছে, বিদেশে অবস্থানরত পলাতক আওয়ামী লীগ নেতা ও তাদের মদতদাতাদের &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821196/%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%89%E0%A7%8E%E0%A6%96%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%B7%E0%A7%9C%E0%A6%AF%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%B2%E0%A7%81-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%9F-%E0%A6%A4%E0%A7%88%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%9C%E0%A7%9C%E0%A6%BF%E0%A6%A4">দৈনিক ইত্তেফাক</source>

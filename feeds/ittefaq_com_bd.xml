      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/46575c5722ca090a8f24e26d80be2550-6afe10a0d9b1a.jpg?jadewits_media_id=323628" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/46575c5722ca090a8f24e26d80be2550-6afe10a0d9b1a.jpg?jadewits_media_id=323628" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/46575c5722ca090a8f24e26d80be2550-6afe10a0d9b1a.jpg?jadewits_media_id=323628" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বর পছন্দ না হওয়ায় বিয়ে ভাঙতে বিষ মেশানো মিষ্টি পাঠালেন কনে" /&gt;&lt;/p&gt;&lt;p&gt;বিয়ের সব আয়োজন সম্পন্ন, বাড়িতে আত্মীয়স্বজন ও বরযাত্রীদের ভিড়, উপস্থিত ছিলেন কাজিও। ঠিক এমন মুহূর্তে বোরকা পরা এক তরুণী বরের জন্য বিশেষ মিষ্টি নিয়ে আসেন। কিন্তু মিষ্টি মুখে দিতে গিয়ে অস্বাভাবিক গন্ধ পেয়ে সন্দেহ হয় বরের; একই সঙ্গে ওই তরুণীর হাতে কীটনাশকের বোতল দেখতে পেয়ে পুরো বিয়েবাড়িতে আতঙ্ক ছড়িয়ে পড়&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821801/%E0%A6%AC%E0%A6%B0-%E0%A6%AA%E0%A6%9B%E0%A6%A8%E0%A7%8D%E0%A6%A6-%E0%A6%A8%E0%A6%BE-%E0%A6%B9%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%AD%E0%A6%BE%E0%A6%99%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B7-%E0%A6%AE%E0%A7%87%E0%A6%B6%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%AE%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF">দৈনিক ইত্তেফাক</source>

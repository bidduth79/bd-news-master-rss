      <guid isPermaLink="true">https://www.ittefaq.com.bd/822292/%E0%A6%A1%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%B8%E0%A6%B9-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Sat, 21 Nov 2026 22:59:31 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/e61da04302bf2a11932e9a00e8719425-6b01cc3363059.jpg?jadewits_media_id=324132" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/e61da04302bf2a11932e9a00e8719425-6b01cc3363059.jpg?jadewits_media_id=324132" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/e61da04302bf2a11932e9a00e8719425-6b01cc3363059.jpg?jadewits_media_id=324132" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডাকাতির অভিযোগে নিষিদ্ধ ছাত্রলীগ নেতাসহ গ্রেপ্তার ২, পিস্তল উদ্ধার" /&gt;&lt;/p&gt;&lt;p&gt;গাজীপুরের শ্রীপুরে বিকাশের টাকা ডাকাতির ঘটনায় নিষিদ্ধ ছাত্রলীগের গাজীপুর জেলা কমিটির সাংগঠনিক সম্পাদকসহ দুজনকে গ্রেপ্তার করেছে পুলিশ। তারা হলেন- সাংগঠনিক সম্পাদক ইমরান শেখ ও তার সহযোগী মো. রবিন আহম্মেদ।
এ সময় তাদের কাছ থেকে ডাকাতির কাজে ব্যবহৃত একটি বিদেশি পিস্তল ও একটি খালি ম্যাগজিন উদ্ধার করা হয়েছ&lt;/p&gt;</description>

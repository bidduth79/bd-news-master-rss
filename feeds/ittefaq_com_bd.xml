      <guid isPermaLink="true">https://www.ittefaq.com.bd/820105/%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A7%87-%E0%A7%AA%E0%A7%AC-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%AE%E0%A7%81%E0%A6%96-%E0%A6%AD%E0%A6%BE%E0%A6%99%E0%A6%9B%E0%A7%87-%E0%A7%AC%E0%A7%AD-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Tue, 10 Nov 2026 13:15:58 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/043d072fcc2f7359c6a3605c99e6df64-6af2c0ff3ce59.jpg?jadewits_media_id=321889" length="0" type="image/jpeg" />

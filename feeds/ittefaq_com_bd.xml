      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/f0fb63eec4ff44a8d5d057a46f36b1c8-6b0a8e0d0478f.jpg?jadewits_media_id=325309" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/f0fb63eec4ff44a8d5d057a46f36b1c8-6b0a8e0d0478f.jpg?jadewits_media_id=325309" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিমা কোম্পানির অনিয়মে হাত দেওয়ার পর থেকেই বাধা আসা শুরু হয়েছে: অর্থমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;বিমা কোম্পানির বিভিন্ন অনিয়মের বিরুদ্ধে অনুসন্ধান শুরুর পর থেকেই বাধা আসা শুরু হয়েছে বলে জানিয়েছেন অর্থ ও পরিকল্পনামন্ত্রী আমির খসরু মাহমুদ চৌধুরী। হাজার কোটি টাকার পণ্য আমদানি হলেও সরকার কোনো রাজস্ব পাচ্ছে না, প্রিমিয়াম জমা হচ্ছে না এবং সাধারণ শেয়ারহোল্ডাররা ক্ষতিগ্রস্ত হচ্ছেন। এই অনিয়মে হাত দেওয়ার&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823414/%E0%A6%AC%E0%A6%BF%E0%A6%AE%E0%A6%BE-%E0%A6%95%E0%A7%8B%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%B0-%E0%A6%85%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%AE%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%A4-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87%E0%A6%87-%E0%A6%AC%E0%A6%BE%E0%A6%A7%E0%A6%BE-%E0%A6%86%E0%A6%B8%E0%A6%BE">দৈনিক ইত্তেফাক</source>

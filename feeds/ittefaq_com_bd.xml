      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/8d0b73956e676c81329f2c8513ee4c70-6aff4ff4ea428.jpg?jadewits_media_id=323822" length="0" type="image/jpeg" />

    <item>
      <title>আওয়ামী লীগের ওপর স্থায়ী নিষেধাজ্ঞা দিতে চার সচিবকে আইনি নোটিশ</title>
      <link>https://www.ittefaq.com.bd/822203/%E0%A6%86%E0%A6%93%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A7%9F%E0%A7%80-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A7%87%E0%A6%A7%E0%A6%BE%E0%A6%9C%E0%A7%8D%E0%A6%9E%E0%A6%BE-%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822203/%E0%A6%86%E0%A6%93%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A7%9F%E0%A7%80-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A7%87%E0%A6%A7%E0%A6%BE%E0%A6%9C%E0%A7%8D%E0%A6%9E%E0%A6%BE-%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Sat, 21 Nov 2026 15:07:46 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/4a8d1844d8a599b0651ae4294ca02dfa-6b015eb65dfab.jpg?jadewits_media_id=324041" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/4a8d1844d8a599b0651ae4294ca02dfa-6b015eb65dfab.jpg?jadewits_media_id=324041" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/4a8d1844d8a599b0651ae4294ca02dfa-6b015eb65dfab.jpg?jadewits_media_id=324041" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আওয়ামী লীগের ওপর স্থায়ী নিষেধাজ্ঞা দিতে চার সচিবকে আইনি নোটিশ" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ আওয়ামী লীগের ওপর আরোপিত নিষেধাজ্ঞাকে স্থায়ী বিধিবদ্ধ আইনি কাঠামোয় নিয়ে আসা এবং দলটির বিরুদ্ধে ওঠা সহিংসতা, অগ্নিসংযোগ ও হত্যাকাণ্ডের অভিযোগ তদন্তে স্বাধীন বিচার বিভাগীয় কমিশন গঠনের দাবিতে সরকারের চার সচিবকে আইনি নোটিশ পাঠানো হয়েছে। বৃহস্পতিবার (১৯ নভেম্বর) মো. রবিউল করিমের পক্ষে সুপ্র&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822203/%E0%A6%86%E0%A6%93%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A7%9F%E0%A7%80-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A7%87%E0%A6%A7%E0%A6%BE%E0%A6%9C%E0%A7%8D%E0%A6%9E%E0%A6%BE-%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>রাজধানীতে যুবকের রক্তাক্ত মরদেহ উদ্ধার, পিটিয়ে-ছুরিকাঘাতে হত্যার অভিযোগ বোনের</title>

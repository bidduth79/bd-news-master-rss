    <item>
      <title>কুষ্টিয়ায় স্কুলছাত্রীকে ছুরিকাঘাতের ঘটনায় অভিযুক্ত ইমন গ্রেপ্তার, গা-ঢাকা দিয়েছিল পরিবারসহ</title>
      <link>https://www.ittefaq.com.bd/820042/%E0%A6%95%E0%A7%81%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%9B%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%98%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A6%AF%E0%A6%BC</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820042/%E0%A6%95%E0%A7%81%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%9B%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%98%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A6%AF%E0%A6%BC</guid>
      <pubDate>Tue, 10 Nov 2026 05:59:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/945dc2989481d8a3b37b634e2aee01be-6af247e6322b8.jpg?jadewits_media_id=321814" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/945dc2989481d8a3b37b634e2aee01be-6af247e6322b8.jpg?jadewits_media_id=321814" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/945dc2989481d8a3b37b634e2aee01be-6af247e6322b8.jpg?jadewits_media_id=321814" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কুষ্টিয়ায় স্কুলছাত্রীকে ছুরিকাঘাতের ঘটনায় অভিযুক্ত ইমন গ্রেপ্তার, গা-ঢাকা দিয়েছিল পরিবারসহ" /&gt;&lt;/p&gt;&lt;p&gt;কুষ্টিয়া শহরে বাসার সামনে দিনদুপুরে দশম শ্রেণির এক স্কুলছাত্রীকে উপর্যুপরি ছুরিকাঘাতের ঘটনায় অভিযুক্ত কিশোর ইমনকে অবশেষে গ্রেপ্তার করেছে পুলিশ। ঘটনার পর নিজের বাড়িতে তালা ঝুলিয়ে পরিবারের সদস্যদের নিয়ে গা-ঢাকা দিলেও পুলিশের সাঁড়াশি অভিযানে শেষ পর্যন্ত তাকে গ্রেপ্তার করা সম্ভব হয়। অন্যদিকে এ বর&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820042/%E0%A6%95%E0%A7%81%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%9B%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%98%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A6%AF%E0%A6%BC">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>শিক্ষক নিয়োগে নতুন পদ্ধতি: পরীক্ষার সিলেবাস, প্রশ্নের ধরন ও নম্বর বণ্টনেও পরিবর্তন</title>
      <link>https://www.ittefaq.com.bd/820041/%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%95-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%8B%E0%A6%97%E0%A7%87-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%AA%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%A4%E0%A6%BF-%C2%A0%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%AC%E0%A6%BE%E0%A6%B8</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820041/%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%95-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%8B%E0%A6%97%E0%A7%87-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%AA%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%A4%E0%A6%BF-%C2%A0%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%AC%E0%A6%BE%E0%A6%B8</guid>
      <pubDate>Tue, 10 Nov 2026 05:28:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/0f3a07ba13dccfc4bfc8e15107ed7394-6af23d6e18172.jpg?jadewits_media_id=321813" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/0f3a07ba13dccfc4bfc8e15107ed7394-6af23d6e18172.jpg?jadewits_media_id=321813" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/0f3a07ba13dccfc4bfc8e15107ed7394-6af23d6e18172.jpg?jadewits_media_id=321813" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শিক্ষক নিয়োগে নতুন পদ্ধতি: পরীক্ষার সিলেবাস, প্রশ্নের ধরন ও নম্বর বণ্টনেও পরিবর্তন" /&gt;&lt;/p&gt;&lt;p&gt;বেসরকারি এমপিওভুক্ত প্রায় ৪০ হাজার শিক্ষাপ্রতিষ্ঠানে শিক্ষক নিয়োগের পরীক্ষা পদ্ধতিতে বড় পরিবর্তন আনতে যাচ্ছে বেসরকারি শিক্ষক নিবন্ধন ও প্রত্যয়ন কর্তৃপক্ষ (এনটিআরসিএ)। নতুন পদ্ধতিতে প্রিলিমিনারির পাশাপাশি লিখিত ও মৌখিক পরীক্ষা নেওয়ার পরিকল্পনা রয়েছে। পরিবর্তন আসতে পারে পরীক্ষার সিলেবাস, প্রশ্নের ধরন &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820041/%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%95-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%8B%E0%A6%97%E0%A7%87-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%AA%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%A4%E0%A6%BF-%C2%A0%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%AC%E0%A6%BE%E0%A6%B8">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>অক্টোবরে সার্বিক মূল্যস্ফীতি সামান্য কমে দাঁড়িয়েছে ৮.২৭ শতাংশে</title>
      <link>https://www.ittefaq.com.bd/820040/%E0%A6%85%E0%A6%95%E0%A7%8D%E0%A6%9F%E0%A7%8B%E0%A6%AC%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%95-%E0%A6%AE%E0%A7%82%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%80%E0%A6%A4%E0%A6%BF-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%95%E0%A6%AE%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820040/%E0%A6%85%E0%A6%95%E0%A7%8D%E0%A6%9F%E0%A7%8B%E0%A6%AC%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%95-%E0%A6%AE%E0%A7%82%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%80%E0%A6%A4%E0%A6%BF-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%95%E0%A6%AE%E0%A7%87</guid>
      <pubDate>Tue, 10 Nov 2026 04:59:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/ea950100c331b2b539b1e245defccb89-6af23afc5939d.jpg?jadewits_media_id=321812" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/ea950100c331b2b539b1e245defccb89-6af23afc5939d.jpg?jadewits_media_id=321812" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/ea950100c331b2b539b1e245defccb89-6af23afc5939d.jpg?jadewits_media_id=321812" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অক্টোবরে সার্বিক মূল্যস্ফীতি সামান্য কমে দাঁড়িয়েছে ৮.২৭ শতাংশে" /&gt;&lt;/p&gt;&lt;p&gt;দেশে সার্বিক মূল্যস্ফীতি সামান্য কমেছে। বাংলাদেশ পরিসংখ্যান ব্যুরোর (বিবিএস) সর্বশেষ তথ্য অনুযায়ী, 2026 সালের অক্টোবর মাসে পয়েন্ট-টু-পয়েন্ট ভিত্তিতে জাতীয় পর্যায়ে সাধারণ মূল্যস্ফীতি কমে ৮ দশমিক ২৭ শতাংশে দাঁড়িয়েছে। এর আগের মাস সেপ্টেম্বরে এ হার ছিল ৮ দশমিক ৩৪ শতাংশ । তবে মাসওয়ারি কমলেও গত বছ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820040/%E0%A6%85%E0%A6%95%E0%A7%8D%E0%A6%9F%E0%A7%8B%E0%A6%AC%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%95-%E0%A6%AE%E0%A7%82%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%80%E0%A6%A4%E0%A6%BF-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%95%E0%A6%AE%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>২৫ লাখ বছর পুরোনো বিড়ালের ফসিল মিলল তুর্কি জাদুঘরে</title>
      <link>https://www.ittefaq.com.bd/820039/%E0%A7%A8%E0%A7%AB-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%8B%E0%A6%A8%E0%A7%8B-%E0%A6%AC%E0%A6%BF%E0%A6%A1%E0%A6%BC%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AB%E0%A6%B8%E0%A6%BF%E0%A6%B2-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2-%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820039/%E0%A7%A8%E0%A7%AB-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%8B%E0%A6%A8%E0%A7%8B-%E0%A6%AC%E0%A6%BF%E0%A6%A1%E0%A6%BC%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AB%E0%A6%B8%E0%A6%BF%E0%A6%B2-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2-%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF</guid>
      <pubDate>Tue, 10 Nov 2026 04:28:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/d3947a1a99d720740cddf40f7e8464ac-6af236e1572cb.jpg?jadewits_media_id=321811" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/d3947a1a99d720740cddf40f7e8464ac-6af236e1572cb.jpg?jadewits_media_id=321811" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/d3947a1a99d720740cddf40f7e8464ac-6af236e1572cb.jpg?jadewits_media_id=321811" style="max-width:100%;height:auto;margin-bottom:10px;" alt="২৫ লাখ বছর পুরোনো বিড়ালের ফসিল মিলল তুর্কি জাদুঘরে" /&gt;&lt;/p&gt;&lt;p&gt;তুরস্কের দক্ষিণ-পশ্চিমাঞ্চলের একটি জাদুঘরে কয়েক দশক ধরে সংরক্ষিত একটি ফসিলকে প্রায় ২৫ লাখ বছর আগে বেঁচে থাকা স্যাবার-টুথড বিড়ালের দেহাবশেষ হিসেবে শনাক্ত করেছেন গবেষকেরা।
১৯৮৯ সালে ইয়াকাকোয় গ্রামের কাছে ফসিলটি আবিষ্কৃত হয়। এটি বুরদুর প্রাকৃতিক ইতিহাস জাদুঘরে সংরক্ষিত আছে। ফসিলটি হোমোথেরিয়াম লা&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820039/%E0%A7%A8%E0%A7%AB-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%8B%E0%A6%A8%E0%A7%8B-%E0%A6%AC%E0%A6%BF%E0%A6%A1%E0%A6%BC%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AB%E0%A6%B8%E0%A6%BF%E0%A6%B2-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2-%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF">দৈনিক ইত্তেফাক</source>
    </item>

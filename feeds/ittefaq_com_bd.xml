    <item>
      <title>সারাদেশে ২৪ ঘণ্টায় হাম উপসর্গে ৬ জনের মৃত্যু</title>
      <link>https://www.ittefaq.com.bd/820341/%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A7%A8%E0%A7%AA-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A7%9F-%E0%A6%B9%E0%A6%BE%E0%A6%AE-%E0%A6%89%E0%A6%AA%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A7%AC-%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81-%E0%A6%AE%E0%A7%8B%E0%A6%9F</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820341/%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A7%A8%E0%A7%AA-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A7%9F-%E0%A6%B9%E0%A6%BE%E0%A6%AE-%E0%A6%89%E0%A6%AA%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A7%AC-%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81-%E0%A6%AE%E0%A7%8B%E0%A6%9F</guid>
      <pubDate>Wed, 11 Nov 2026 16:10:05 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/6a8bcd68d586329c9eceea360ac599fe-6af43d83701e7.jpg?jadewits_media_id=322128" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/6a8bcd68d586329c9eceea360ac599fe-6af43d83701e7.jpg?jadewits_media_id=322128" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/6a8bcd68d586329c9eceea360ac599fe-6af43d83701e7.jpg?jadewits_media_id=322128" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সারাদেশে ২৪ ঘণ্টায় হাম উপসর্গে ৬ জনের মৃত্যু" /&gt;&lt;/p&gt;&lt;p&gt;গত ২৪ ঘণ্টায় সারাদেশে হামের উপসর্গ নিয়ে ছয় শিশুর মৃত্যু হয়েছে। তবে এ সময়ে নিশ্চিত হামে কারও মৃত্যুর তথ্য নথিভুক্ত হয়নি বলে জানিয়েছে স্বাস্থ্য অধিদপ্তর। 
বুধবার (১১ নভেম্বর) অধিদপ্তরের পাঠানো এক বার্তায় এ তথ্য জানানো হয়। হিসাবটি বুধবার সকাল ৮টা পর্যন্ত গত ২৪ ঘণ্টার।
স্বাস্থ্য অধিদপ্তরের তথ্য অনুযায়ী,&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820341/%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A7%A8%E0%A7%AA-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A7%9F-%E0%A6%B9%E0%A6%BE%E0%A6%AE-%E0%A6%89%E0%A6%AA%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A7%AC-%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81-%E0%A6%AE%E0%A7%8B%E0%A6%9F">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>থানা থেকে বাসায় ফেরার পথে নারী পুলিশ সদস্যের মুখ চেপে ধরে তুলে নেওয়ার চেষ্টা</title>
      <link>https://www.ittefaq.com.bd/820340/%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A7%9F-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%96</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820340/%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A7%9F-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%96</guid>
      <pubDate>Wed, 11 Nov 2026 16:00:42 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/ccca55b2877898a1941c14914bd72378-6af43c976349e.jpg?jadewits_media_id=322127" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/ccca55b2877898a1941c14914bd72378-6af43c976349e.jpg?jadewits_media_id=322127" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/ccca55b2877898a1941c14914bd72378-6af43c976349e.jpg?jadewits_media_id=322127" style="max-width:100%;height:auto;margin-bottom:10px;" alt="থানা থেকে বাসায় ফেরার পথে নারী পুলিশ সদস্যের মুখ চেপে ধরে তুলে নেওয়ার চেষ্টা" /&gt;&lt;/p&gt;&lt;p&gt;মৌলভীবাজারের জুড়ীতে এক নারী কনস্টেবলকে মুখ চেপে ধরে তুলে নেওয়ার চেষ্টা করেছে দুর্বৃত্তরা। মঙ্গলবার (১০ নভেম্বর) রাত ৮টার দিকে উপজেলা সদরের হরিরামপুর এলাকায় পশ্চিম জুড়ী ইউনিয়ন পরিষদ কার্যালয়ের কাছে এ ঘটনা ঘটে।
ওই নারী কনস্টেবল জুড়ী থানায় কর্মরত। তার স্বামীও একই থানায় কনস্টেবল হিসেবে দায়িত্ব পালন করছে&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820340/%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A7%9F-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%96">দৈনিক ইত্তেফাক</source>

      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/08/1a56236fcc10e1541e23df68830e125b-6af08265003e6.jpg?jadewits_media_id=321557" length="0" type="image/jpeg" />

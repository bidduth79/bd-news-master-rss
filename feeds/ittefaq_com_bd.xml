      <guid isPermaLink="true">https://www.ittefaq.com.bd/823485/%E0%A6%AC%E0%A6%BF%E0%A6%AE%E0%A6%B8%E0%A6%9F%E0%A7%87%E0%A6%95-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A5%E0%A6%B2%E0%A7%87%E0%A6%9F%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A7%87-%E0%A7%A7%E0%A7%A6-%E0%A6%AA%E0%A6%A6%E0%A6%95-%E0%A6%9C%E0%A7%9F%E0%A7%80-%E0%A6%A6%E0%A6%B2%E0%A6%95%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A6%A6%E0%A6%96%E0%A7%8B%E0%A6%B2%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87</guid>
      <pubDate>Sat, 28 Nov 2026 22:40:28 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/bad9c2aca2e680bad6e4951b79860983-6b0b0368c5180.jpg?jadewits_media_id=325382" length="0" type="image/jpeg" />

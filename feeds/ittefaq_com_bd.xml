    <item>
      <title>সরকারি ব্যয়ে আবারও কড়াকড়ি, গাড়ি কেনা ও ভবন নির্মাণে নিষেধাজ্ঞা</title>
      <link>https://www.ittefaq.com.bd/820229/%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A7%9F%E0%A7%87-%E0%A6%86%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A6%93-%E0%A6%95%E0%A7%9C%E0%A6%BE%E0%A6%95%E0%A7%9C%E0%A6%BF-%E0%A6%97%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%95%E0%A7%87%E0%A6%A8%E0%A6%BE-%E0%A6%93-%E0%A6%AD%E0%A6%AC%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820229/%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A7%9F%E0%A7%87-%E0%A6%86%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A6%93-%E0%A6%95%E0%A7%9C%E0%A6%BE%E0%A6%95%E0%A7%9C%E0%A6%BF-%E0%A6%97%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%95%E0%A7%87%E0%A6%A8%E0%A6%BE-%E0%A6%93-%E0%A6%AD%E0%A6%AC%E0%A6%A8</guid>
      <pubDate>Tue, 10 Nov 2026 21:53:41 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/006cee1448b51685e9f12ea9d6a7cadd-6af33df004fb7.jpg?jadewits_media_id=322016" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/006cee1448b51685e9f12ea9d6a7cadd-6af33df004fb7.jpg?jadewits_media_id=322016" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/006cee1448b51685e9f12ea9d6a7cadd-6af33df004fb7.jpg?jadewits_media_id=322016" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সরকারি ব্যয়ে আবারও কড়াকড়ি, গাড়ি কেনা ও ভবন নির্মাণে নিষেধাজ্ঞা" /&gt;&lt;/p&gt;&lt;p&gt;চলতি ২০২৬&amp;ndash;২৭ অর্থবছরের বাজেট বাস্তবায়নে সরকারি ব্যয়ে কঠোর নির্দেশিকা জারি করেছে অর্থ মন্ত্রণালয়ের অর্থ বিভাগ। গত সোমবার জারি করা এক পরিপত্রে নতুন যানবাহন কেনা, বিদেশ ভ্রমণ ও অনাবশ্যক ভবন নির্মাণ স্থগিত রাখাসহ এডিপির কম গুরুত্বপূর্ণ প্রকল্প ছাঁটাইয়ের নির্দেশ দেওয়া হয়েছে।
পরিপত্র অনুযায়ী, কো&lt;/p&gt;</description>

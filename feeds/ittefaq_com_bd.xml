      <guid isPermaLink="true">https://www.ittefaq.com.bd/822579/%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%9C%E0%A6%BF%E0%A6%A8-%E0%A6%A4%E0%A6%BF%E0%A6%B6%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%AA%E0%A6%B0%E0%A7%8B%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%B0</guid>
      <pubDate>Mon, 23 Nov 2026 14:06:41 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/8d62edd5426cd312e621cb36f675458c-6b03f35bddb10.jpg?jadewits_media_id=324419" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/8d62edd5426cd312e621cb36f675458c-6b03f35bddb10.jpg?jadewits_media_id=324419" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/8d62edd5426cd312e621cb36f675458c-6b03f35bddb10.jpg?jadewits_media_id=324419" style="max-width:100%;height:auto;margin-bottom:10px;" alt="তানজিন তিশার বিরুদ্ধে গ্রেপ্তারি পরোয়ানা জারির আবেদন" /&gt;&lt;/p&gt;&lt;p&gt;অভিনেত্রী তানজিন তিশার বিরুদ্ধে হত্যার হুমকির অভিযোগের মামলায় গ্রেপ্তারি পরোয়ানা জারির আবেদন করেছেন নারী উদ্যোক্তা ও ফ্যাশন ডিজাইনার সানায়া আনাম ওয়াফিকাহ চৌধুরী।&amp;nbsp;
সোমবার (২৩ নভেম্বর) ঢাকার নির্বাহী ম্যাজিস্ট্রেট মু. মাহবুব-উল-আলমের আদালতে তার বিরুদ্ধে গ্রেপ্তারি&amp;nbsp;পরোয়ানা জারির এই আবেদন করা &lt;/p&gt;</description>

      <guid isPermaLink="true">https://www.ittefaq.com.bd/822053/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A7%87%E0%A6%AD%E0%A6%BE-%E0%A6%95%E0%A6%A8%E0%A6%AD%E0%A7%87%E0%A6%A8%E0%A6%B6%E0%A6%A8-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AF%E0%A6%BE%E0%A7%9F%E0%A7%80</guid>
      <pubDate>Fri, 20 Nov 2026 16:08:12 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/e92136a0740dfaaf2c598c96cc5a44fa-6b00196a10fea.jpg?jadewits_media_id=323890" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/e92136a0740dfaaf2c598c96cc5a44fa-6b00196a10fea.jpg?jadewits_media_id=323890" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/e92136a0740dfaaf2c598c96cc5a44fa-6b00196a10fea.jpg?jadewits_media_id=323890" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গোপালগঞ্জের হাসপাতালে হামলা জেনেভা কনভেনশন অনুযায়ী যুদ্ধাপরাধ: প্রধানমন্ত্রীর উপ-প্রেস সচিব" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জের একটি হাসপাতালে গত বৃহস্পতিবার (১৯ নভেম্বর) রামদা ও কুড়াল হাতে মহড়া দিয়ে আগুন দিয়েছে কার্যক্রম নিষিদ্ধ আওয়ামী লীগের নেতাকর্মীরা। একে আন্তর্জাতিক মানবিক আইনের লঙ্ঘন এবং যুদ্ধাপরাধ হিসেবে অভিহিত করেছেন প্রধানমন্ত্রীর উপ-প্রেস সচিব মো. সুজাউদ্দৌলা (সুজন মাহমুদ)।
বৃহস্পতিবার (১৯ নভেম্বর) সামা&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822053/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A7%87%E0%A6%AD%E0%A6%BE-%E0%A6%95%E0%A6%A8%E0%A6%AD%E0%A7%87%E0%A6%A8%E0%A6%B6%E0%A6%A8-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AF%E0%A6%BE%E0%A7%9F%E0%A7%80">দৈনিক ইত্তেফাক</source>

    <item>
      <title>জাল সার্টিফিকেটধারীদের দুর্দিন আসছে, লুকিয়ে রাখতে পারবেন না: শিক্ষামন্ত্রী</title>
      <link>https://www.ittefaq.com.bd/822145/%E0%A6%9C%E0%A6%BE%E0%A6%B2-%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%AB%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%9F%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0%C2%A0%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%86%E0%A6%B8%E0%A6%9B%E0%A7%87-%E0%A6%B2%E0%A7%81%E0%A6%95%E0%A6%BF%E0%A7%9F%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822145/%E0%A6%9C%E0%A6%BE%E0%A6%B2-%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%AB%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%9F%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0%C2%A0%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%86%E0%A6%B8%E0%A6%9B%E0%A7%87-%E0%A6%B2%E0%A7%81%E0%A6%95%E0%A6%BF%E0%A7%9F%E0%A7%87</guid>
      <pubDate>Sat, 21 Nov 2026 05:00:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/8393c7db6da89f04be651dcba9901119-6b00ae1758014.jpg?jadewits_media_id=323983" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/8393c7db6da89f04be651dcba9901119-6b00ae1758014.jpg?jadewits_media_id=323983" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/8393c7db6da89f04be651dcba9901119-6b00ae1758014.jpg?jadewits_media_id=323983" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জাল সার্টিফিকেটধারীদের দুর্দিন আসছে, লুকিয়ে রাখতে পারবেন না: শিক্ষামন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;শিক্ষামন্ত্রী ড. আ ন ম এহছানুল হক মিলন বলেছেন, জাল সার্টিফিকেট দিয়ে যারা বিভিন্ন শিক্ষাপ্রতিষ্ঠানে ভর্তি, চাকরি কিংবা সরকারি-বেসরকারি সুযোগ-সুবিধা নিয়েছেন সামনে তাদের দুর্দিন আসছে। কোনো ভাবেই তারা আর জালিয়াতি লুকিয়ে রাখতে পারবেন না। গতকাল শুক্রবার বিকাল ৪টার দিকে মুন্সীগঞ্জের গজারিয়া উপজেলার ভবেরচর &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822145/%E0%A6%9C%E0%A6%BE%E0%A6%B2-%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%AB%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%9F%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0%C2%A0%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%86%E0%A6%B8%E0%A6%9B%E0%A7%87-%E0%A6%B2%E0%A7%81%E0%A6%95%E0%A6%BF%E0%A7%9F%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>ভেড়ামারায় দুরারোগ্য রোগে আক্রান্ত একই পরিবারের সাত জন</title>
      <link>https://www.ittefaq.com.bd/822143/%E0%A6%AD%E0%A7%87%E0%A7%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A6%BE%E0%A6%B0%E0%A7%8B%E0%A6%97%E0%A7%8D%E0%A6%AF-%E0%A6%B0%E0%A7%8B%E0%A6%97%E0%A7%87-%E0%A6%86%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%C2%A0%E0%A6%8F%E0%A6%95%E0%A6%87-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%A4</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822143/%E0%A6%AD%E0%A7%87%E0%A7%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A6%BE%E0%A6%B0%E0%A7%8B%E0%A6%97%E0%A7%8D%E0%A6%AF-%E0%A6%B0%E0%A7%8B%E0%A6%97%E0%A7%87-%E0%A6%86%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%C2%A0%E0%A6%8F%E0%A6%95%E0%A6%87-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%A4</guid>
      <pubDate>Sat, 21 Nov 2026 04:24:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/4409ff1d58593abc464eb4ef04665bd4-6b00ac7de6b03.jpg?jadewits_media_id=323981" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/4409ff1d58593abc464eb4ef04665bd4-6b00ac7de6b03.jpg?jadewits_media_id=323981" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/4409ff1d58593abc464eb4ef04665bd4-6b00ac7de6b03.jpg?jadewits_media_id=323981" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভেড়ামারায় দুরারোগ্য রোগে আক্রান্ত একই পরিবারের সাত জন" /&gt;&lt;/p&gt;&lt;p&gt;কুষ্টিয়ার ভেড়ামারার পল্লিতে দুরারোগ্য রোগে আক্রান্ত হয়ে মানবেতর জীবনযাপন করেছেন একই পরিবারের সাত জন ব্যক্তি। দীর্ঘদিন ধরে সহায়-সম্বলহীন পরিবারটি অত্যন্ত মানবেতর জীবনযাপন করছে। ভুক্তভোগীরা হলেন উপজেলার বাহাদুরপুর ইউনিয়নের আরকান্দি গ্রামের আজিজুল হকের (৮২), ছেলে বেলাল উদ্দিন (৪৮), হেলাল উদ্দিন (৪৪), আ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822143/%E0%A6%AD%E0%A7%87%E0%A7%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A6%BE%E0%A6%B0%E0%A7%8B%E0%A6%97%E0%A7%8D%E0%A6%AF-%E0%A6%B0%E0%A7%8B%E0%A6%97%E0%A7%87-%E0%A6%86%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%C2%A0%E0%A6%8F%E0%A6%95%E0%A6%87-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%A4">দৈনিক ইত্তেফাক</source>

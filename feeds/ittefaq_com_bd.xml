      <guid isPermaLink="true">https://www.ittefaq.com.bd/821902/%E0%A6%AA%E0%A6%A6%E0%A7%8D%E0%A6%AE%E0%A6%BE-%E0%A6%B8%E0%A7%87%E0%A6%A4%E0%A7%81-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A7%A7%E0%A7%AD-%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A6%9A%E0%A6%B2%E0%A6%BE%E0%A6%9A%E0%A6%B2-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%AC%E0%A6%BF%E0%A6%B0</guid>
      <pubDate>Thu, 19 Nov 2026 17:03:26 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/ad20827efb506d64716f8c607f85ac1c-6afed6a2efe09.jpg?jadewits_media_id=323734" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/ad20827efb506d64716f8c607f85ac1c-6afed6a2efe09.jpg?jadewits_media_id=323734" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/ad20827efb506d64716f8c607f85ac1c-6afed6a2efe09.jpg?jadewits_media_id=323734" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পদ্মা সেতু দিয়ে ১৭ জেলার যান চলাচল বন্ধ, স্থবির মোংলা বন্দর" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জে কার্যক্রম নিষিদ্ধ আওয়ামী লীগ ও নিষিদ্ধঘোষিত ছাত্রলীগের নেতাকর্মীদের সহিংসতায় পদ্মা সেতুর উপর দিয়ে যাওয়া দক্ষিণ-পশ্চিমাঞ্চলের জেলাগুলোর সব রুটের পরিবহন চলাচল বন্ধ রয়েছে। গোপালগঞ্জ থেকে কাশিয়ানি পর্যন্ত মোংলা-ঢাকা মহাসড়কের বিভিন্ন স্থানে গাছের গুঁড়ি ফেলে অবরোধ ও অগ্নিসংযোগসহ বিশৃঙ্খল পরিস্থ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821902/%E0%A6%AA%E0%A6%A6%E0%A7%8D%E0%A6%AE%E0%A6%BE-%E0%A6%B8%E0%A7%87%E0%A6%A4%E0%A7%81-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A7%A7%E0%A7%AD-%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A6%9A%E0%A6%B2%E0%A6%BE%E0%A6%9A%E0%A6%B2-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%AC%E0%A6%BF%E0%A6%B0">দৈনিক ইত্তেফাক</source>

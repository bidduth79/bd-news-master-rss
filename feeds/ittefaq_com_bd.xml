      <guid isPermaLink="true">https://www.ittefaq.com.bd/821094/%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87-%E0%A6%AD%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A6%B9-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A7%A8-%E0%A6%89%E0%A7%9C%E0%A7%8B%E0%A6%9C%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Sun, 15 Nov 2026 14:42:28 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/14de18fa8e360a9a0642f7383e67631a-6af97058e3749.jpg?jadewits_media_id=322899" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/14de18fa8e360a9a0642f7383e67631a-6af97058e3749.jpg?jadewits_media_id=322899" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/14de18fa8e360a9a0642f7383e67631a-6af97058e3749.jpg?jadewits_media_id=322899" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যুক্তরাষ্ট্রে ভয়াবহ বিপর্যয়ের পর এবার ২ উড়োজাহাজের মুখোমুখি সংঘর্ষ" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাষ্ট্রজুড়ে উড়োজাহাজ চলাচলে অচলাবস্থা ও ব্যাপক ফ্লাইট বাতিলের ঘটনার এক দিন পর মায়ামি আন্তর্জাতিক বিমানবন্দরে দুটি উড়োজাহাজরে সংঘর্ষ হয়েছে। শনিবার (১৪ নভেম্বর) রাতে অবতরণের পর ট্যাক্সি করার সময় কোপা এয়ারলাইনসের একটি বোয়িং ৭৩৭ বিমানের ডানার প্রান্তের সঙ্গে ইউপিএসের একটি বোয়িং ৭৬৭ বিমানের সামনের অ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821094/%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87-%E0%A6%AD%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A6%B9-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A7%A8-%E0%A6%89%E0%A7%9C%E0%A7%8B%E0%A6%9C%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A7%87%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>

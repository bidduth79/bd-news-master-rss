    <item>
      <title>হাসপাতাল থেকে বাসায় ফিরেছেন স্বাস্থ্যমন্ত্রী</title>
      <link>https://www.ittefaq.com.bd/821531/%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B2-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A7%9F-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A7%8D%E0%A6%AF%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821531/%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B2-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A7%9F-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A7%8D%E0%A6%AF%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80</guid>
      <pubDate>Tue, 17 Nov 2026 18:25:39 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/5888278fbd090cc0e6691b2e65f549f6-6afc4791db971.jpg?jadewits_media_id=323352" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/5888278fbd090cc0e6691b2e65f549f6-6afc4791db971.jpg?jadewits_media_id=323352" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/5888278fbd090cc0e6691b2e65f549f6-6afc4791db971.jpg?jadewits_media_id=323352" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হাসপাতাল থেকে বাসায় ফিরেছেন স্বাস্থ্যমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;হাসপাতাল থেকে বাসায় ফিরেছেন স্বাস্থ্য ও পরিবার কল্যাণমন্ত্রী সরদার মো. সাখাওয়াত হোসেন। মঙ্গলবার (১৭ নভেম্বর) দুপুরে তাকে হাসপাতাল থেকে ছাড়পত্র দেওয়া হয়।
এর আগে শনিবার (১৪ নভেম্বর) সকালে বুকে ব্যথা অনুভব করলে মন্ত্রীকে রাজধানীর একটি বেসরকারি হাসপাতালে ভর্তি করা হয়। পরে হৃদ্&amp;zwnj;রোগ বিশেষজ্ঞদের একটি &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821531/%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B2-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A7%9F-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A7%8D%E0%A6%AF%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>রূপপুর পারমাণবিক বিদ্যুৎকেন্দ্রে যেভাবে তৈরি হয় বিদ্যুৎ</title>
      <link>https://www.ittefaq.com.bd/821530/%E0%A6%B0%E0%A7%82%E0%A6%AA%E0%A6%AA%E0%A7%81%E0%A6%B0-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%AE%E0%A6%BE%E0%A6%A3%E0%A6%AC%E0%A6%BF%E0%A6%95-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A7%8E%E0%A6%95%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%87-%E0%A6%AF%E0%A7%87%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%A4%E0%A7%88%E0%A6%B0%E0%A6%BF-%E0%A6%B9%E0%A7%9F</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821530/%E0%A6%B0%E0%A7%82%E0%A6%AA%E0%A6%AA%E0%A7%81%E0%A6%B0-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%AE%E0%A6%BE%E0%A6%A3%E0%A6%AC%E0%A6%BF%E0%A6%95-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A7%8E%E0%A6%95%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%87-%E0%A6%AF%E0%A7%87%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%A4%E0%A7%88%E0%A6%B0%E0%A6%BF-%E0%A6%B9%E0%A7%9F</guid>
      <pubDate>Tue, 17 Nov 2026 18:18:17 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/9b500a61e4fd87a77073941baf0d676e-6afc45e01585d.jpg?jadewits_media_id=323349" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/9b500a61e4fd87a77073941baf0d676e-6afc45e01585d.jpg?jadewits_media_id=323349" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/9b500a61e4fd87a77073941baf0d676e-6afc45e01585d.jpg?jadewits_media_id=323349" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রূপপুর পারমাণবিক বিদ্যুৎকেন্দ্রে যেভাবে তৈরি হয় বিদ্যুৎ" /&gt;&lt;/p&gt;&lt;p&gt;ইউরেনিয়াম পরমাণুর বিভাজন থেকে উৎপন্ন তাপকে কাজে লাগিয়ে বিদ্যুৎ তৈরি হয় রূপপুর পারমাণবিক বিদ্যুৎকেন্দ্রে। পারমাণবিক বিভাজন বা নিউক্লিয়ার ফিশন প্রক্রিয়ায় পরমাণুর নিউক্লিয়াস ভেঙে বিপুল তাপশক্তি নির্গত হয়। সেই তাপে পানি থেকে বাষ্প তৈরি করা হয়। বাষ্পের প্রবল চাপে ঘুরতে থাকে টারবাইন। আর টারবাইনের সঙ্গে সং&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821530/%E0%A6%B0%E0%A7%82%E0%A6%AA%E0%A6%AA%E0%A7%81%E0%A6%B0-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%AE%E0%A6%BE%E0%A6%A3%E0%A6%AC%E0%A6%BF%E0%A6%95-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A7%8E%E0%A6%95%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%87-%E0%A6%AF%E0%A7%87%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%A4%E0%A7%88%E0%A6%B0%E0%A6%BF-%E0%A6%B9%E0%A7%9F">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>পদত্যাগপত্রে কী লিখেছেন ওসমান ফারুক</title>
      <link>https://www.ittefaq.com.bd/821529/%E0%A6%AA%E0%A6%A6%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%97%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%87-%E0%A6%95%E0%A7%80-%E0%A6%B2%E0%A6%BF%E0%A6%96%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%93%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%AB%E0%A6%BE%E0%A6%B0%E0%A7%81%E0%A6%95</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821529/%E0%A6%AA%E0%A6%A6%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%97%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%87-%E0%A6%95%E0%A7%80-%E0%A6%B2%E0%A6%BF%E0%A6%96%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%93%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%AB%E0%A6%BE%E0%A6%B0%E0%A7%81%E0%A6%95</guid>
      <pubDate>Tue, 17 Nov 2026 18:17:34 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/c48a1c62ab5e6c0c0bb4b5a65d707395-6afc454ac6b13.jpg?jadewits_media_id=323348" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/c48a1c62ab5e6c0c0bb4b5a65d707395-6afc454ac6b13.jpg?jadewits_media_id=323348" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/c48a1c62ab5e6c0c0bb4b5a65d707395-6afc454ac6b13.jpg?jadewits_media_id=323348" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পদত্যাগপত্রে কী লিখেছেন ওসমান ফারুক" /&gt;&lt;/p&gt;&lt;p&gt;শারীরিক অসুস্থতা ও চিকিৎসাধীন থাকার কারণ দেখিয়ে জাতীয় সংসদ সদস্য পদ থেকে পদত্যাগ করেছেন বিএনপির ভাইস চেয়ারম্যান ও সাবেক শিক্ষামন্ত্রী ড. ওসমান ফারুক। জাতীয় সংসদের স্পিকার বরাবর পাঠানো পদত্যাগপত্রে তিনি উল্লেখ করেছেন, পদত্যাগের এই সিদ্ধান্ত নেওয়াটা তার জন্য অত্যন্ত কঠিন ও বেদনাদায়ক ছিল।
সংশ্লিষ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821529/%E0%A6%AA%E0%A6%A6%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%97%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%87-%E0%A6%95%E0%A7%80-%E0%A6%B2%E0%A6%BF%E0%A6%96%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%93%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%AB%E0%A6%BE%E0%A6%B0%E0%A7%81%E0%A6%95">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>ভিনির হ্যাটট্রিকে সিঙ্গাপুরকে ‘সেভেন আপ’ খাওয়াল ব্রাজিল</title>
      <link>https://www.ittefaq.com.bd/821528/%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A6%B0-%E0%A6%B9%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9F%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A6%95%E0%A7%87-%E2%80%98%E0%A6%B8%E0%A7%87%E0%A6%AD%E0%A7%87%E0%A6%A8-%E0%A6%86%E0%A6%AA%E2%80%99-%E0%A6%96%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B2</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821528/%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A6%B0-%E0%A6%B9%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9F%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A6%95%E0%A7%87-%E2%80%98%E0%A6%B8%E0%A7%87%E0%A6%AD%E0%A7%87%E0%A6%A8-%E0%A6%86%E0%A6%AA%E2%80%99-%E0%A6%96%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B2</guid>
      <pubDate>Tue, 17 Nov 2026 18:13:14 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/ca451c07df2473a3fb3c22324676686b-6afc44727068d.jpg?jadewits_media_id=323347" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/ca451c07df2473a3fb3c22324676686b-6afc44727068d.jpg?jadewits_media_id=323347" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/ca451c07df2473a3fb3c22324676686b-6afc44727068d.jpg?jadewits_media_id=323347" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভিনির হ্যাটট্রিকে সিঙ্গাপুরকে ‘সেভেন আপ’ খাওয়াল ব্রাজিল" /&gt;&lt;/p&gt;&lt;p&gt;জাপানের বিপক্ষে হারের ক্ষত একপাশে রেখে পরের ম্যাচেই বিশ্ব ফুটবলে নিজেদের শক্তির জানান দিলো ব্রাজিল। আন্তর্জাতিক প্রীতি ম্যাচে সিঙ্গাপুরকে ৭-০ গোলে বিধ্বস্ত করেছে কার্লো আনচেলত্তির দল। ম্যাচের প্রথম ২১ মিনিটেই হ্যাটট্রিক পূর্ণ করেন ভিনিসিয়ুস জুনিয়র।
মঙ্গলবার (১৭ নভেম্বর) সিঙ্গাপুরের ন্যাশনাল স্টেডিয়া&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821528/%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A6%B0-%E0%A6%B9%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9F%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A6%95%E0%A7%87-%E2%80%98%E0%A6%B8%E0%A7%87%E0%A6%AD%E0%A7%87%E0%A6%A8-%E0%A6%86%E0%A6%AA%E2%80%99-%E0%A6%96%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B2">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>গ্র্যামিতে রায়ের জয়জয়কার, মরণোত্তর মনোনয়ন পেলেন ডলি পার্টন</title>
      <link>https://www.ittefaq.com.bd/821527/%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A7%9F%E0%A6%9C%E0%A7%9F%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A6%B0%E0%A6%A3%E0%A7%8B%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%B0-%E0%A6%AE%E0%A6%A8%E0%A7%8B%E0%A6%A8%E0%A7%9F%E0%A6%A8-%E0%A6%AA%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821527/%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A7%9F%E0%A6%9C%E0%A7%9F%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A6%B0%E0%A6%A3%E0%A7%8B%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%B0-%E0%A6%AE%E0%A6%A8%E0%A7%8B%E0%A6%A8%E0%A7%9F%E0%A6%A8-%E0%A6%AA%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Tue, 17 Nov 2026 18:11:38 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/ddcfc507872641cb59fb42ff492da91e-6afc444a0481c.jpg?jadewits_media_id=323346" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/ddcfc507872641cb59fb42ff492da91e-6afc444a0481c.jpg?jadewits_media_id=323346" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/ddcfc507872641cb59fb42ff492da91e-6afc444a0481c.jpg?jadewits_media_id=323346" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গ্র্যামিতে রায়ের জয়জয়কার, মরণোত্তর মনোনয়ন পেলেন ডলি পার্টন" /&gt;&lt;/p&gt;&lt;p&gt;ব্রিটিশ গায়িকা রায়ের জয়জয়কার আর প্রয়াত কিংবদন্তি ডলি পার্টনের মরণোত্তর সম্মানের মধ্য দিয়ে ঘোষিত হলো ২০২৭ সালের গ্র্যামি অ্যাওয়ার্ডসের মনোনয়ন। সর্বোচ্চ ১১টি বিভাগে মনোনয়ন পেয়ে সবার ওপরে আছেন রায়ে, আর মৃত্যুর তিন মাস পরও তিনটি বিভাগে মনোনয়ন পেয়েছেন ডলি পার্টন। পাশাপাশি মনোনয়ন তালিকায় জায়গা করে নিয়েছেন&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821527/%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A7%9F%E0%A6%9C%E0%A7%9F%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A6%B0%E0%A6%A3%E0%A7%8B%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%B0-%E0%A6%AE%E0%A6%A8%E0%A7%8B%E0%A6%A8%E0%A7%9F%E0%A6%A8-%E0%A6%AA%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%A8">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>রংপুরকে জাতীয় লিগে উড়িয়ে দিয়ে রেকর্ড শিরোপা খুলনার</title>
      <link>https://www.ittefaq.com.bd/821526/%E0%A6%B0%E0%A6%82%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A6%95%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%B2%E0%A6%BF%E0%A6%97%E0%A7%87-%E0%A6%89%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A1-%E0%A6%B6%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%AA%E0%A6%BE-%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821526/%E0%A6%B0%E0%A6%82%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A6%95%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%B2%E0%A6%BF%E0%A6%97%E0%A7%87-%E0%A6%89%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A1-%E0%A6%B6%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%AA%E0%A6%BE-%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Tue, 17 Nov 2026 18:06:56 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/ac884e9e97239f190f2043f1879d5461-6afc4250abf7f.jpg?jadewits_media_id=323345" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/ac884e9e97239f190f2043f1879d5461-6afc4250abf7f.jpg?jadewits_media_id=323345" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/ac884e9e97239f190f2043f1879d5461-6afc4250abf7f.jpg?jadewits_media_id=323345" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রংপুরকে জাতীয় লিগে উড়িয়ে দিয়ে রেকর্ড শিরোপা খুলনার" /&gt;&lt;/p&gt;&lt;p&gt;জাতীয় ক্রিকেট লিগে (এনসিএল) রংপুরকে হারিয়ে রেকর্ড অষ্টম শিরোপা জিতেছে খুলনা। দীর্ঘ সাত বছর পর মঙ্গলবার (১৭ নভেম্বর) ফের শিরোপা জিতল খুলনা। সিলেট আন্তর্জাতিক স্টেডিয়ামে রংপুরকে ৯ উইকেটে হারিয়ে শিরোপা নিজেদের করে নেয় দক্ষিণাঞ্চলের দলটি। 
এর আগে সবশেষ ২০১৯-২০ মৌসুমে চ্যাম্পিয়ন হয়েছিল খুলনা।
সিলেট আন্তর&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821526/%E0%A6%B0%E0%A6%82%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A6%95%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%B2%E0%A6%BF%E0%A6%97%E0%A7%87-%E0%A6%89%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A1-%E0%A6%B6%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%AA%E0%A6%BE-%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>খেলাধুলা ও সংস্কৃতিচর্চায় দক্ষ হতে শিক্ষার্থীদের প্রতি প্রধানমন্ত্রীর আহ্বান</title>

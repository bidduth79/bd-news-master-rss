      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/df06e2ef620a879c745490e0e9b2c772-6b06c35e8f2c3.jpg?jadewits_media_id=324819" style="max-width:100%;height:auto;margin-bottom:10px;" alt="১ ডিসেম্বর দিল্লি মিশনের দায়িত্ব নিচ্ছেন আসাদ আলম সিয়াম" /&gt;&lt;/p&gt;&lt;p&gt;ভারতে বাংলাদেশের নতুন হাইকমিশনার হিসেবে আগামী ১ ডিসেম্বর দায়িত্ব গ্রহণ করবেন আসাদ আলম সিয়াম। মিশনে আনুষ্ঠানিকভাবে দায়িত্ব নেওয়ার আগে সিয়াম শুক্রবার (২৭ নভেম্বর) নয়াদিল্লির উদ্দেশ্যে রওনা হবেন বলে পররাষ্ট্র মন্ত্রণালয়ের একটি সূত্র নিশ্চিত করেছে।
গত ৩১ অক্টোবর আসাদ আলম সিয়ামের বাবা চট্টগ্রাম বিশ্ববিদ্&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822962/%E0%A7%A7-%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BF-%E0%A6%AE%E0%A6%BF%E0%A6%B6%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A7%9F%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%AC-%E0%A6%A8%E0%A6%BF%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%86%E0%A6%B8%E0%A6%BE%E0%A6%A6-%E0%A6%86%E0%A6%B2%E0%A6%AE">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>একনেকে ২৪ হাজার ১১০ কোটি টাকার ১০ প্রকল্প অনুমোদন</title>
      <link>https://www.ittefaq.com.bd/822961/%E0%A6%8F%E0%A6%95%E0%A6%A8%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A7%A8%E0%A7%AA-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A7%A7%E0%A7%A7%E0%A7%A6-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A7%A7%E0%A7%A6-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AE%E0%A7%8B%E0%A6%A6%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822961/%E0%A6%8F%E0%A6%95%E0%A6%A8%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A7%A8%E0%A7%AA-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A7%A7%E0%A7%A7%E0%A7%A6-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A7%A7%E0%A7%A6-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AE%E0%A7%8B%E0%A6%A6%E0%A6%A8</guid>
      <pubDate>Wed, 25 Nov 2026 17:50:55 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/4d0898a92faf4452a10c112b933ce368-6b06cb9ca656d.jpg?jadewits_media_id=324831" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/4d0898a92faf4452a10c112b933ce368-6b06cb9ca656d.jpg?jadewits_media_id=324831" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/4d0898a92faf4452a10c112b933ce368-6b06cb9ca656d.jpg?jadewits_media_id=324831" style="max-width:100%;height:auto;margin-bottom:10px;" alt="একনেকে ২৪ হাজার ১১০ কোটি টাকার ১০ প্রকল্প অনুমোদন" /&gt;&lt;/p&gt;&lt;p&gt;প্রধানমন্ত্রী এবং জাতীয় অর্থনৈতিক পরিষদের নির্বাহী কমিটির (একনেক) সভায় ২৪ হাজার ১১০ কোটি ৬৬ লাখ টাকা ব্যয়ের ১০টি প্রকল্প অনুমোদন দেওয়া হয়েছে। এর মধ্যে নতুন প্রকল্প ৫টি, সংশোধিত প্রকল্প ৪টি এবং মেয়াদ বৃদ্ধি সংক্রান্ত প্রকল্প ১টি রয়েছে।
বুধবার (২৫ নভেম্বর) বাংলাদেশ সচিবালয়ে অনুষ্ঠিত একনেক সভায় এসব প্র&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822961/%E0%A6%8F%E0%A6%95%E0%A6%A8%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A7%A8%E0%A7%AA-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A7%A7%E0%A7%A7%E0%A7%A6-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A7%A7%E0%A7%A6-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AE%E0%A7%8B%E0%A6%A6%E0%A6%A8">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>চাচার পিস্তল হাতে ছবি তুলেছিল ভাতিজা, ছবির সূত্র ধরে দুজনই গ্রেপ্তার</title>
      <link>https://www.ittefaq.com.bd/822960/%E0%A6%9A%E0%A6%BE%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%B2-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%9B%E0%A6%AC%E0%A6%BF-%E0%A6%A4%E0%A7%81%E0%A6%B2%E0%A7%87%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%AD%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%9C%E0%A6%BE-%E0%A6%9B%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A7%82%E0%A6%A4%E0%A7%8D%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822960/%E0%A6%9A%E0%A6%BE%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%B2-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%9B%E0%A6%AC%E0%A6%BF-%E0%A6%A4%E0%A7%81%E0%A6%B2%E0%A7%87%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%AD%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%9C%E0%A6%BE-%E0%A6%9B%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A7%82%E0%A6%A4%E0%A7%8D%E0%A6%B0</guid>
      <pubDate>Wed, 25 Nov 2026 17:02:35 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/a8d1c627e5ef9781dd91c14e4fb448b4-6b06c0066782f.jpg?jadewits_media_id=324817" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/a8d1c627e5ef9781dd91c14e4fb448b4-6b06c0066782f.jpg?jadewits_media_id=324817" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/a8d1c627e5ef9781dd91c14e4fb448b4-6b06c0066782f.jpg?jadewits_media_id=324817" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চাচার পিস্তল হাতে ছবি তুলেছিল ভাতিজা, ছবির সূত্র ধরে দুজনই গ্রেপ্তার" /&gt;&lt;/p&gt;&lt;p&gt;চাঁদপুরে পুলিশের অভিযানে একটি বিদেশি পিস্তল ও দুই রাউন্ড গুলিসহ দুজনকে গ্রেপ্তার করা হয়েছে। মোবাইল ফোনের গ্যালারিতে পিস্তলের ছবি দেখে পুলিশের সন্দেহ হওয়ায় জিজ্ঞাসাবাদের সূত্র ধরে তাদের গ্রেপ্তার ও অস্ত্র উদ্ধারের ঘটনা ঘটে।
বুধবার (২৫ নভেম্বর) ভোর আনুমানিক ৬টার দিকে কচুয়া পৌরসভার ৮ নম্বর ওয়ার্ডের কড়ই&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822960/%E0%A6%9A%E0%A6%BE%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%B2-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%9B%E0%A6%AC%E0%A6%BF-%E0%A6%A4%E0%A7%81%E0%A6%B2%E0%A7%87%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%AD%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%9C%E0%A6%BE-%E0%A6%9B%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A7%82%E0%A6%A4%E0%A7%8D%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>বিকেল ৫টার পর ভিক্ষা করলেই জরিমানার ঘোষণা ফকির সমিতির সভাপতির</title>
      <link>https://www.ittefaq.com.bd/822959/%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%B2-%E0%A7%AB%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AD%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%87-%E0%A6%9C%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%98%E0%A7%8B%E0%A6%B7%E0%A6%A3%E0%A6%BE-%E0%A6%AB%E0%A6%95%E0%A6%BF%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822959/%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%B2-%E0%A7%AB%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AD%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%87-%E0%A6%9C%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%98%E0%A7%8B%E0%A6%B7%E0%A6%A3%E0%A6%BE-%E0%A6%AB%E0%A6%95%E0%A6%BF%E0%A6%B0</guid>
      <pubDate>Wed, 25 Nov 2026 16:58:27 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/0682c005677f50b354dd97e4c78f2058-6b06bf1f999e5.jpg?jadewits_media_id=324816" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/0682c005677f50b354dd97e4c78f2058-6b06bf1f999e5.jpg?jadewits_media_id=324816" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/0682c005677f50b354dd97e4c78f2058-6b06bf1f999e5.jpg?jadewits_media_id=324816" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিকেল ৫টার পর ভিক্ষা করলেই জরিমানার ঘোষণা ফকির সমিতির সভাপতির" /&gt;&lt;/p&gt;&lt;p&gt;ময়মনসিংহের ফুলপুর বাজারে ভিক্ষাবৃত্তির সময়সীমা বেঁধে দিয়ে ব্যতিক্রমী ঘোষণা দিয়েছেন স্থানীয় &amp;lsquo;ফকির কমিটির&amp;rsquo; সভাপতি। তার ঘোষণা অনুযায়ী, বিকেল ৫টার পর ফুলপুর বাজার এলাকায় কেউ ভিক্ষা করতে পারবেন না এবং এই নির্দেশনা অমান্য করলে জরিমানা ও কারাদণ্ডের মতো শাস্তিমূলক ব্যবস্থার মুখে পড়তে হবে&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822959/%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%B2-%E0%A7%AB%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AD%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%87-%E0%A6%9C%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%98%E0%A7%8B%E0%A6%B7%E0%A6%A3%E0%A6%BE-%E0%A6%AB%E0%A6%95%E0%A6%BF%E0%A6%B0">দৈনিক ইত্তেফাক</source>

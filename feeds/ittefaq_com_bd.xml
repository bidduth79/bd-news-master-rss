      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/923a4c962e9614d5f143369ee58bbae6-6afbc0ed207a8.png?jadewits_media_id=323225" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/923a4c962e9614d5f143369ee58bbae6-6afbc0ed207a8.png?jadewits_media_id=323225" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/923a4c962e9614d5f143369ee58bbae6-6afbc0ed207a8.png?jadewits_media_id=323225" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আওয়ামী লীগ নেতাদের দলে ভেড়ানোর অভিযোগ, বিএনপি ছাড়ার ঘোষণা ছাত্রদল নেতা সাইফুলের" /&gt;&lt;/p&gt;&lt;p&gt;বিভিন্ন কমিটিতে আওয়ামী লীগের নেতা-কর্মীদের অন্তর্ভুক্ত করার অভিযোগ তুলে বিএনপির রাজনীতি ছাড়ার ঘোষণা দিয়েছেন খুলনা মহানগর ছাত্রদলের সাবেক যুগ্ম আহ্বায়ক খান সাইফুল। তবে বিএনপি ও জিয়া পরিবারের প্রতি ভালোবাসা এবং দলটির চেয়ারম্যান ও প্রধানমন্ত্রী তারেক রহমানের প্রতি শ্রদ্ধা অটুট থাকার কথা জানিয়েছেন তিনি।&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821413/%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%B2%E0%A7%87-%E0%A6%AD%E0%A7%87%E0%A7%9C%E0%A6%BE%E0%A6%A8%E0%A7%8B%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF">দৈনিক ইত্তেফাক</source>

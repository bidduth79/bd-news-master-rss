    <item>
      <title>আমার হাঁটুটা যদি আপনার হতো, তবেই বুঝতেন— চোট নিয়ে নেইমার</title>
      <link>https://www.ittefaq.com.bd/820347/%E0%A6%86%E0%A6%AE%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%81%E0%A6%9F%E0%A7%81%E0%A6%9F%E0%A6%BE-%E0%A6%AF%E0%A6%A6%E0%A6%BF-%E0%A6%86%E0%A6%AA%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%A4%E0%A7%8B-%E0%A6%A4%E0%A6%AC%E0%A7%87%E0%A6%87-%E0%A6%AC%E0%A7%81%E0%A6%9D%E0%A6%A4%E0%A7%87%E0%A6%A8%E2%80%94-%E0%A6%9A%E0%A7%8B%E0%A6%9F-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820347/%E0%A6%86%E0%A6%AE%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%81%E0%A6%9F%E0%A7%81%E0%A6%9F%E0%A6%BE-%E0%A6%AF%E0%A6%A6%E0%A6%BF-%E0%A6%86%E0%A6%AA%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%A4%E0%A7%8B-%E0%A6%A4%E0%A6%AC%E0%A7%87%E0%A6%87-%E0%A6%AC%E0%A7%81%E0%A6%9D%E0%A6%A4%E0%A7%87%E0%A6%A8%E2%80%94-%E0%A6%9A%E0%A7%8B%E0%A6%9F-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87</guid>
      <pubDate>Wed, 11 Nov 2026 16:25:40 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/f37f01eefda4065a922401fae5cca9ac-6af4424de914c.jpg?jadewits_media_id=322136" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/f37f01eefda4065a922401fae5cca9ac-6af4424de914c.jpg?jadewits_media_id=322136" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/f37f01eefda4065a922401fae5cca9ac-6af4424de914c.jpg?jadewits_media_id=322136" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আমার হাঁটুটা যদি আপনার হতো, তবেই বুঝতেন— চোট নিয়ে নেইমার" /&gt;&lt;/p&gt;&lt;p&gt;অসাধারণ ফুটবলশৈলী, মনোমুগ্ধকর ড্রিবলিং আর ক্ষুরধার ফুটবল বুদ্ধি দিয়ে কোটি ভক্তকে মুগ্ধ করেছেন নেইমার জুনিয়র। তবে বর্ণিল এই ক্যারিয়ারে তার সবচেয়ে বড় প্রতিপক্ষ হয়ে দাঁড়িয়েছে নিজের শরীর। চোটের কারণে বারবার মাঠের বাইরে যেতে হয়েছে ব্রাজিলের এই তারকাকে। মাঠে ফেরার লড়াই আর শারীরিক যন্ত্রণা যেন তার ক্যারিয়া&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820347/%E0%A6%86%E0%A6%AE%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%81%E0%A6%9F%E0%A7%81%E0%A6%9F%E0%A6%BE-%E0%A6%AF%E0%A6%A6%E0%A6%BF-%E0%A6%86%E0%A6%AA%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%A4%E0%A7%8B-%E0%A6%A4%E0%A6%AC%E0%A7%87%E0%A6%87-%E0%A6%AC%E0%A7%81%E0%A6%9D%E0%A6%A4%E0%A7%87%E0%A6%A8%E2%80%94-%E0%A6%9A%E0%A7%8B%E0%A6%9F-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>

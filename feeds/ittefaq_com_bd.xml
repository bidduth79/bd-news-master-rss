      <guid isPermaLink="true">https://www.ittefaq.com.bd/820112/%E0%A6%AE%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%B0-%E0%A6%AB%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%A6-%E0%A6%95%E0%A6%AC%E0%A7%87-%E0%A6%A6%E0%A7%82%E0%A6%B0-%E0%A6%B9%E0%A6%AC%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%A4%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%A8-%E0%A6%86%E0%A6%B8%E0%A6%BF%E0%A6%AB</guid>
      <pubDate>Tue, 10 Nov 2026 13:43:30 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/2b5fdef33e08e78dfbb56129fec2098a-6af2cb0792bf4.jpg?jadewits_media_id=321901" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/2b5fdef33e08e78dfbb56129fec2098a-6af2cb0792bf4.jpg?jadewits_media_id=321901" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/2b5fdef33e08e78dfbb56129fec2098a-6af2cb0792bf4.jpg?jadewits_media_id=321901" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মিডিয়ার ফ্যাসিবাদ কবে দূর হবে, জানতে চান আসিফ মাহমুদ" /&gt;&lt;/p&gt;&lt;p&gt;মিডিয়ার ফ্যাসিবাদ কবে দূর হবে, জানতে চেয়েছেন জাতীয় নাগরিক পার্টির (এনসিপি) সিনিয়র যুগ্ম সদস্যসচিব আসিফ মাহমুদ সজীব ভূঁইয়া। মঙ্গলবার (১০ নভেম্বর) নিষিদ্ধ ছাত্রলীগের ডাকা ধর্মঘটের বিষয়ে ফেসবুকে একটি পোস্টে তিনি এমন প্রশ্ন রাখেন।

এনসিপির এই নেতা লিখেছেন, &amp;zwnj;&amp;lsquo;ধর্মঘট মাঠে নাই, মিডিয়ায় আছে। মিডি&lt;/p&gt;</description>

    <item>
      <title>ঢাকার অনেক স্কুলে ‘ভর্তি ফি নৈরাজ্য’</title>
      <link>https://www.ittefaq.com.bd/822142/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%A8%E0%A7%87%E0%A6%95-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2%E0%A7%87%C2%A0%E2%80%98%E0%A6%AD%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%AB%E0%A6%BF-%E0%A6%A8%E0%A7%88%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A7%8D%E0%A6%AF%E2%80%99</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822142/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%A8%E0%A7%87%E0%A6%95-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2%E0%A7%87%C2%A0%E2%80%98%E0%A6%AD%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%AB%E0%A6%BF-%E0%A6%A8%E0%A7%88%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A7%8D%E0%A6%AF%E2%80%99</guid>
      <pubDate>Sat, 21 Nov 2026 04:00:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/36889816bd738c3528bacdcd7655676b-6b00abf67740f.jpg?jadewits_media_id=323980" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/36889816bd738c3528bacdcd7655676b-6b00abf67740f.jpg?jadewits_media_id=323980" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/36889816bd738c3528bacdcd7655676b-6b00abf67740f.jpg?jadewits_media_id=323980" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঢাকার অনেক স্কুলে ‘ভর্তি ফি নৈরাজ্য’" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর অধিকাংশ স্কুলে চলছে &amp;lsquo;ভর্তি ফি নেরাজ্য&amp;rsquo;। শিক্ষা মন্ত্রণালয়ের নীতিমালা অনুসারে এবার ঢাকা মহানগরীতে বাংলা মাধ্যম স্কুলে ভর্তি ফি সর্বোচ্চ ৮ হাজার টাকা; ইংরেজি ভার্শনে ১০ হাজার টাকা। তবে এটা শুধু নীতিমালাতেই সীমাবদ্ধ। রাজধানীতে এমন শিক্ষাপ্রতিষ্ঠান খুঁজে পাওয়া কঠিন, যেখানে এই টাকায় &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822142/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%A8%E0%A7%87%E0%A6%95-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2%E0%A7%87%C2%A0%E2%80%98%E0%A6%AD%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%AB%E0%A6%BF-%E0%A6%A8%E0%A7%88%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A7%8D%E0%A6%AF%E2%80%99">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>ক্যানসারে আক্রান্ত শামীম ওসমান, রয়েছেন চতুর্থ স্টেজে</title>
      <link>https://www.ittefaq.com.bd/822148/%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%B6%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%AE-%E0%A6%93%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%B0%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%9A%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%A5</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822148/%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%B6%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%AE-%E0%A6%93%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%B0%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%9A%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%A5</guid>
      <pubDate>Sat, 21 Nov 2026 03:30:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/bd05c41de8e57d870f191f54e8c5b6a4-6b00b10761e72.jpg?jadewits_media_id=323985" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/bd05c41de8e57d870f191f54e8c5b6a4-6b00b10761e72.jpg?jadewits_media_id=323985" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/bd05c41de8e57d870f191f54e8c5b6a4-6b00b10761e72.jpg?jadewits_media_id=323985" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ক্যানসারে আক্রান্ত শামীম ওসমান, রয়েছেন চতুর্থ স্টেজে" /&gt;&lt;/p&gt;&lt;p&gt;মরণব্যাধী ক্যানসারে আক্রান্ত হয়েছেন বলে জানিয়েছেন নারায়ণগঞ্জ-৪ আসনের সাবেক সংসদ সদস্য ও কার্যক্রম নিষিদ্ধ আওয়ামী লীগ নেতা এ কে এম শামীম ওসমান।
শুক্রবার (২০ নভেম্বর) রাতে ছড়িয়ে পড়া একটি ভিডিওতে নিজের শারীরিক এই অবস্থার কথা জানান তিনি। তবে ভিডিওটি কোন সময়ের তা স্বাধীনভাবে যাচাই করা সম্ভব হয়নি।
ভিড&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822148/%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%B6%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%AE-%E0%A6%93%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%B0%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%9A%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%A5">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>সাড়ে ৩ বছর ধরে মৃত নারীর খাদ্যবান্ধব কর্মসূচির চাল ‘খাচ্ছেন’ ইউপি সদস্য</title>
      <link>https://www.ittefaq.com.bd/822147/%E0%A6%B8%E0%A6%BE%E0%A7%9C%E0%A7%87-%E0%A7%A9-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%A7%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A7%83%E0%A6%A4-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%96%E0%A6%BE%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A6%AC-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%B8%E0%A7%82%E0%A6%9A%E0%A6%BF%E0%A6%B0-%E0%A6%9A%E0%A6%BE%E0%A6%B2</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822147/%E0%A6%B8%E0%A6%BE%E0%A7%9C%E0%A7%87-%E0%A7%A9-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%A7%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A7%83%E0%A6%A4-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%96%E0%A6%BE%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A6%AC-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%B8%E0%A7%82%E0%A6%9A%E0%A6%BF%E0%A6%B0-%E0%A6%9A%E0%A6%BE%E0%A6%B2</guid>
      <pubDate>Sat, 21 Nov 2026 03:00:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/f143a32d09825093072ce7b97ca74260-6b00afee33695.jpg?jadewits_media_id=323984" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/f143a32d09825093072ce7b97ca74260-6b00afee33695.jpg?jadewits_media_id=323984" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/f143a32d09825093072ce7b97ca74260-6b00afee33695.jpg?jadewits_media_id=323984" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাড়ে ৩ বছর ধরে মৃত নারীর খাদ্যবান্ধব কর্মসূচির চাল ‘খাচ্ছেন’ ইউপি সদস্য" /&gt;&lt;/p&gt;&lt;p&gt;কুড়িগ্রামের উলিপুরে খাদ্যবান্ধব কর্মসূচির চাল উত্তোলন ও আত্মসাতের অভিযোগ উঠেছে এক ইউপি সদস্যের বিরুদ্ধে। প্রায় সাড়ে তিন বছর ধরে সরকারি খাদ্যসহায়তা থেকে বঞ্চিত থাকার অভিযোগ এনে উপজেলা নির্বাহী কর্মকর্তার (ইউএনও) কাছে লিখিত অভিযোগ করেছেন আম্বিয়া বেগম নামে এক নারী।
অভিযুক্ত ইউপি সদস্যের নাম মো. বা&lt;/p&gt;</description>

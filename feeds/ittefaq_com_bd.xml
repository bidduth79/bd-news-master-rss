      <guid isPermaLink="true">https://www.ittefaq.com.bd/821089/%E0%A6%AA%E0%A6%BE%E0%A6%81%E0%A6%9A-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A6%A4%E0%A6%BF-%E0%A6%B6%E0%A7%87%E0%A6%B7%E0%A7%87-%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87</guid>
      <pubDate>Sun, 15 Nov 2026 14:12:55 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/19c74e1bf4a07368b2eb18716ae600cc-6af9696ccd47f.jpg?jadewits_media_id=322893" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/19c74e1bf4a07368b2eb18716ae600cc-6af9696ccd47f.jpg?jadewits_media_id=322893" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/19c74e1bf4a07368b2eb18716ae600cc-6af9696ccd47f.jpg?jadewits_media_id=322893" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পাঁচ বছরের বিরতি শেষে আন্তর্জাতিক অর্জন নিয়ে ফিরলেন এহসানুল হক বাবু" /&gt;&lt;/p&gt;&lt;p&gt;দীর্ঘ পাঁচ বছরের বিরতি ভেঙে নতুন কাজ নিয়ে ফিরেছেন চলচ্চিত্র প্রযোজক এহসানুল হক বাবু। নির্মাতা আব্দুল্লাহ মোহাম্মদ সাদের আলোচিত ওয়েব সিরিজ &amp;lsquo;অ্যানি&amp;rsquo;র মাধ্যমে নতুনভাবে আলোচনায় এসেছেন তিনি। ইতোমধ্যে সিরিজটি আন্তর্জাতিক অঙ্গনে বাংলাদেশের জন্য তৈরি করেছে নতুন মাইলফলক।
পাঁচ বছরের নীরবতা ভেঙে ফি&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821089/%E0%A6%AA%E0%A6%BE%E0%A6%81%E0%A6%9A-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A6%A4%E0%A6%BF-%E0%A6%B6%E0%A7%87%E0%A6%B7%E0%A7%87-%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>অভিষেক ম্যাচের প্রথম বলেই সাজঘরে রবিন</title>
      <link>https://www.ittefaq.com.bd/821088/%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%B7%E0%A7%87%E0%A6%95-%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%AC%E0%A6%B2%E0%A7%87%E0%A6%87-%E0%A6%B8%E0%A6%BE%E0%A6%9C%E0%A6%98%E0%A6%B0%E0%A7%87-%E0%A6%B0%E0%A6%AC%E0%A6%BF%E0%A6%A8%C2%A0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821088/%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%B7%E0%A7%87%E0%A6%95-%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%AC%E0%A6%B2%E0%A7%87%E0%A6%87-%E0%A6%B8%E0%A6%BE%E0%A6%9C%E0%A6%98%E0%A6%B0%E0%A7%87-%E0%A6%B0%E0%A6%AC%E0%A6%BF%E0%A6%A8%C2%A0</guid>
      <pubDate>Sun, 15 Nov 2026 14:51:52 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/8b688815acbfeef3e3a01d95752ab81b-6af96a9d467ec.jpg?jadewits_media_id=322894" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/8b688815acbfeef3e3a01d95752ab81b-6af96a9d467ec.jpg?jadewits_media_id=322894" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/8b688815acbfeef3e3a01d95752ab81b-6af96a9d467ec.jpg?jadewits_media_id=322894" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অভিষেক ম্যাচের প্রথম বলেই সাজঘরে রবিন" /&gt;&lt;/p&gt;&lt;p&gt;দুই ম্যাচ সিরিজের প্রথম টেস্টে দক্ষিণ আফ্রিকার বিপক্ষে মাঠে নেমেছে বাংলাদেশ। এই ম্যাচে অভিষেক হয়েছে ওপেনার মাহফিজুল ইসলাম রবিনের। তবে অভিষেক ম্যাচটা তার জন্য অনেকটা দুঃস্বপ্নের মতো। প্রথম বলেই আউট হয়েছেন এই ওপেনার। &amp;nbsp;&amp;nbsp;
রোববার (১৫ নভেম্বর) জোহানেজবার্গে টস জিতে ব্যাট করার সিদ্ধান্ত নেন টাইগা&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821088/%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%B7%E0%A7%87%E0%A6%95-%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%AC%E0%A6%B2%E0%A7%87%E0%A6%87-%E0%A6%B8%E0%A6%BE%E0%A6%9C%E0%A6%98%E0%A6%B0%E0%A7%87-%E0%A6%B0%E0%A6%AC%E0%A6%BF%E0%A6%A8%C2%A0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>রাজধানীতে ‘গোপন বৈঠক’ থেকে আওয়ামী লীগের ৪ সদস্য গ্রেপ্তার</title>
      <link>https://www.ittefaq.com.bd/821087/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E2%80%98%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%A8-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95%E2%80%99-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A7%AA-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821087/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E2%80%98%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%A8-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95%E2%80%99-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A7%AA-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF</guid>
      <pubDate>Sun, 15 Nov 2026 14:43:29 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/1e9f7d2d9cadf7c1b139fb31372d1d84-6af967c0a02cc.jpg?jadewits_media_id=322890" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/1e9f7d2d9cadf7c1b139fb31372d1d84-6af967c0a02cc.jpg?jadewits_media_id=322890" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/1e9f7d2d9cadf7c1b139fb31372d1d84-6af967c0a02cc.jpg?jadewits_media_id=322890" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজধানীতে ‘গোপন বৈঠক’ থেকে আওয়ামী লীগের ৪ সদস্য গ্রেপ্তার" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর আজিমপুরে অভিযান পরিচালনা করে কার্যক্রম নিষিদ্ধ আওয়ামী লীগের চার সক্রিয় সদস্যকে গ্রেপ্তার করেছে ঢাকা মেট্রোপলিটন পুলিশের (ডিএমপি) লালবাগ থানা পুলিশ।
গ্রেপ্তারকৃতরা হলো- মো. সোহরাব হোসেন সুমন মিয়া (৪০), মোহাম্মদ জাহাঙ্গীর আলম (৪৬), মো. রাসেল আহম্মেদ (৪২) ও মো. মফিজুল ইসলাম (৫০)।
আজ ডিএমপির মি&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821087/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E2%80%98%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%A8-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95%E2%80%99-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A7%AA-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>মুঠোফোনের দুই বার্তায় ফেঁসে গেলেন এসপি জাহাঙ্গীর আলম</title>
      <link>https://www.ittefaq.com.bd/821086/%E0%A6%AE%E0%A7%81%E0%A6%A0%E0%A7%8B%E0%A6%AB%E0%A7%8B%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A7%9F-%E0%A6%AB%E0%A7%87%E0%A6%81%E0%A6%B8%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%8F%E0%A6%B8%E0%A6%AA%E0%A6%BF-%E0%A6%9C%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%80%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821086/%E0%A6%AE%E0%A7%81%E0%A6%A0%E0%A7%8B%E0%A6%AB%E0%A7%8B%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A7%9F-%E0%A6%AB%E0%A7%87%E0%A6%81%E0%A6%B8%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%8F%E0%A6%B8%E0%A6%AA%E0%A6%BF-%E0%A6%9C%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%80%E0%A6%B0</guid>
      <pubDate>Sun, 15 Nov 2026 14:06:19 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/3784d0cb73a336ca9be80ae0d05b5f41-6af967f278c25.jpg?jadewits_media_id=322891" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/3784d0cb73a336ca9be80ae0d05b5f41-6af967f278c25.jpg?jadewits_media_id=322891" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/3784d0cb73a336ca9be80ae0d05b5f41-6af967f278c25.jpg?jadewits_media_id=322891" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মুঠোফোনের দুই বার্তায় ফেঁসে গেলেন এসপি জাহাঙ্গীর আলম" /&gt;&lt;/p&gt;&lt;p&gt;কার্যক্রম নিষিদ্ধ আওয়ামী লীগের সঙ্গে যোগাযোগ, পুলিশের অভ্যন্তরীণ ও স্পর্শকাতর তথ্য সরবরাহ এবং সরকারের বিরুদ্ধে বিদ্রোহে উসকানি দেওয়ার অভিযোগে চট্টগ্রাম রেঞ্জ রিজার্ভ ফোর্সের (আরআরএফ) পুলিশ সুপার (এসপি) জাহাঙ্গীর আলমকে গ্রেপ্তার করা হয়েছে।
শনিবার (১৪ নভেম্বর) দিবাগত রাত ১০টার পর রাষ্ট্রদ্রোহের অভিযোগ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821086/%E0%A6%AE%E0%A7%81%E0%A6%A0%E0%A7%8B%E0%A6%AB%E0%A7%8B%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A7%9F-%E0%A6%AB%E0%A7%87%E0%A6%81%E0%A6%B8%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%8F%E0%A6%B8%E0%A6%AA%E0%A6%BF-%E0%A6%9C%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%80%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>সোনিয়া গান্ধীর বইয়ের প্রকাশনা অনুষ্ঠান সোমবার, যোগ দিবেন মুখ্যমন্ত্রী বিজয়</title>
      <link>https://www.ittefaq.com.bd/821085/%E0%A6%B8%E0%A7%8B%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%BE-%E0%A6%97%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A7%80%E0%A6%B0-%E0%A6%AC%E0%A6%87%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B6%E0%A6%A8%E0%A6%BE-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A8-%E0%A6%B8%E0%A7%8B%E0%A6%AE%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AF%E0%A7%8B%E0%A6%97</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821085/%E0%A6%B8%E0%A7%8B%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%BE-%E0%A6%97%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A7%80%E0%A6%B0-%E0%A6%AC%E0%A6%87%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B6%E0%A6%A8%E0%A6%BE-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A8-%E0%A6%B8%E0%A7%8B%E0%A6%AE%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AF%E0%A7%8B%E0%A6%97</guid>
      <pubDate>Sun, 15 Nov 2026 14:04:36 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/d8d693b5c3f1334594c03fd901bc8af5-6af9647010cb7.jpg?jadewits_media_id=322889" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/d8d693b5c3f1334594c03fd901bc8af5-6af9647010cb7.jpg?jadewits_media_id=322889" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/d8d693b5c3f1334594c03fd901bc8af5-6af9647010cb7.jpg?jadewits_media_id=322889" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সোনিয়া গান্ধীর বইয়ের প্রকাশনা অনুষ্ঠান সোমবার, যোগ দিবেন মুখ্যমন্ত্রী বিজয়" /&gt;&lt;/p&gt;&lt;p&gt;ভারতের প্রধান বিরোধী দল কংগ্রেস নেত্রী সোনিয়া গান্ধীর স্মৃতিকথার আনুষ্ঠানিক প্রকাশনা অনুষ্ঠানে যোগ দিতে পারেন তামিলনাড়ুর মুখ্যমন্ত্রী সি জোসেফ বিজয়। আগামীকাল সোমবার (১৬ নভেম্বর) নয়াদিল্লিতে এই প্রকাশনা অনুষ্ঠান হওয়ার কথা।&amp;nbsp;
কংগ্রেসের সূত্রের বরাতে দ্য টাইমস অব ইন্ডিয়ার প্রতিবেদনে বলা হয়, সোনিয়া &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821085/%E0%A6%B8%E0%A7%8B%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%BE-%E0%A6%97%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A7%80%E0%A6%B0-%E0%A6%AC%E0%A6%87%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B6%E0%A6%A8%E0%A6%BE-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A8-%E0%A6%B8%E0%A7%8B%E0%A6%AE%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AF%E0%A7%8B%E0%A6%97">দৈনিক ইত্তেফাক</source>
    </item>

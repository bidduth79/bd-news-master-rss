      <guid isPermaLink="true">https://www.ittefaq.com.bd/822492/%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A7%E0%A7%80%E0%A6%B0%E0%A7%87-%E0%A6%A7%E0%A7%80%E0%A6%B0%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%83%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%B9%E0%A7%9F%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A6%9F%E0%A6%BF-%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A7%80-%E0%A6%A6%E0%A6%B2%E0%A7%87</guid>
      <pubDate>Sun, 22 Nov 2026 23:01:57 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/0358f59e2459ef3d42f6a5cbd0a59525-6b031f1a23772.jpg?jadewits_media_id=324333" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/0358f59e2459ef3d42f6a5cbd0a59525-6b031f1a23772.jpg?jadewits_media_id=324333" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/0358f59e2459ef3d42f6a5cbd0a59525-6b031f1a23772.jpg?jadewits_media_id=324333" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আওয়ামী লীগ ধীরে ধীরে নিঃশেষ হয়ে একটি সন্ত্রাসী দলে পরিণত হয়েছে: শামা ওবায়েদ" /&gt;&lt;/p&gt;&lt;p&gt;কার্যক্রম নিষিদ্ধ আওয়ামী লীগের রাজনীতি, অতীতের সহিংসতা, গুম-খুন এবং দেশের অর্থনীতি নিয়ে কঠোর সমালোচনা করেছেন পররাষ্ট্র প্রতিমন্ত্রী শামা ওবায়েদ ইসলাম। তিনি বলেন, আওয়ামী লীগ নামের দলটি ধীরে ধীরে নিঃশেষ হয়ে একটি সন্ত্রাসী দলে পরিণত হয়েছে। ২০২৬ সালে এসে দলটির অতীত কর্মকাণ্ডের প্রমাণ সামনে এসেছে, যা বাং&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822492/%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A7%E0%A7%80%E0%A6%B0%E0%A7%87-%E0%A6%A7%E0%A7%80%E0%A6%B0%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%83%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%B9%E0%A7%9F%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A6%9F%E0%A6%BF-%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A7%80-%E0%A6%A6%E0%A6%B2%E0%A7%87">দৈনিক ইত্তেফাক</source>

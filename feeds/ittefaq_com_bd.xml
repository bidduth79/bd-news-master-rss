    <item>
      <title>সিলেটে আওয়ামী লীগের সাবেক এমপি রনজিত সরকারের বাসায় মধ্যরাতে হামলা-ভাঙচুর</title>
      <link>https://www.ittefaq.com.bd/820254/%E0%A6%B8%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%9F%E0%A7%87-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF-%E0%A6%B0%E0%A6%A8%E0%A6%9C%E0%A6%BF%E0%A6%A4-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A7%9F</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820254/%E0%A6%B8%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%9F%E0%A7%87-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF-%E0%A6%B0%E0%A6%A8%E0%A6%9C%E0%A6%BF%E0%A6%A4-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A7%9F</guid>
      <pubDate>Wed, 11 Nov 2026 03:59:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/37e79e86cf2b04e67a8e565111f035bf-6af3870bda13b.jpg?jadewits_media_id=322040" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/37e79e86cf2b04e67a8e565111f035bf-6af3870bda13b.jpg?jadewits_media_id=322040" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/37e79e86cf2b04e67a8e565111f035bf-6af3870bda13b.jpg?jadewits_media_id=322040" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সিলেটে আওয়ামী লীগের সাবেক এমপি রনজিত সরকারের বাসায় মধ্যরাতে হামলা-ভাঙচুর" /&gt;&lt;/p&gt;&lt;p&gt;কার্যক্রম নিষিদ্ধ বাংলাদেশ আওয়ামী লীগের সিলেট জেলা শাখার সাংগঠনিক সম্পাদক ও সুনামগঞ্জ-১ আসনের সাবেক সংসদ সদস্য রনজিত চন্দ্র সরকার এবং নিষিদ্ধঘোষিত জেলা ছাত্রলীগের সভাপতি নাজমুল ইসলামের বাসায় মধ্যরাতে হামলা ও ভাঙচুরের ঘটনা ঘটেছে।
সোমবার (৯ নভেম্বর) মধ্যরাতে নগরের টিলাগড় ও মেজরটিলা এলাকায় পৃথকভাবে এসব&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820254/%E0%A6%B8%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%9F%E0%A7%87-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF-%E0%A6%B0%E0%A6%A8%E0%A6%9C%E0%A6%BF%E0%A6%A4-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A7%9F">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>সড়কের মাঝখানে খুঁটি!</title>
      <link>https://www.ittefaq.com.bd/820256/%E0%A6%B8%E0%A6%A1%E0%A6%BC%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%9D%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%96%E0%A7%81%E0%A6%81%E0%A6%9F%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820256/%E0%A6%B8%E0%A6%A1%E0%A6%BC%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%9D%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%96%E0%A7%81%E0%A6%81%E0%A6%9F%E0%A6%BF</guid>
      <pubDate>Wed, 11 Nov 2026 03:41:23 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2025/03/11/01bd9f25252561a677fb8c828c703ffa-67cff76a8ea1b.jpg?jadewits_media_id=215097" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2025/03/11/01bd9f25252561a677fb8c828c703ffa-67cff76a8ea1b.jpg?jadewits_media_id=215097" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2025/03/11/01bd9f25252561a677fb8c828c703ffa-67cff76a8ea1b.jpg?jadewits_media_id=215097" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সড়কের মাঝখানে খুঁটি!" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশে উন্নয়নকর্মকাণ্ডের এমন কিছু দৃশ্য দেখা যায়, যাহা আমাদের বিস্মিত করে। সড়ক সম্প্রসারণ করা হইতেছে, নির্মাণকাজও শেষ হইতেছে; কিন্তু সড়কের মাঝখানে ঠায় দাঁড়াইয়া থাকিতেছে বৈদ্যুতিক খুঁটি! এমনকি বৎসরের পর বৎসর সেই খুঁটি সরানো হইতেছে না। ফলে নূতন সড়ক নির্মাণ করিয়াও নিশ্চিত করা যাইতেছে না মান&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820256/%E0%A6%B8%E0%A6%A1%E0%A6%BC%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%9D%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%96%E0%A7%81%E0%A6%81%E0%A6%9F%E0%A6%BF">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>সন্তান জন্মের ৩ দিন পর ফেনীতে ভবনের ছাদ থেকে পড়ে কর্মকর্তার রহস্যজনক মৃত্যু</title>
      <link>https://www.ittefaq.com.bd/820253/%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A7%A9-%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%AA%E0%A6%B0-%E0%A6%AB%E0%A7%87%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AD%E0%A6%AC%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%9B%E0%A6%BE%E0%A6%A6-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%9C%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820253/%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A7%A9-%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%AA%E0%A6%B0-%E0%A6%AB%E0%A7%87%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AD%E0%A6%AC%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%9B%E0%A6%BE%E0%A6%A6-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%9C%E0%A7%87</guid>
      <pubDate>Wed, 11 Nov 2026 02:59:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/9b842a4d93c7a06d56b5a04cb97d89e4-6af383d80fa8b.jpg?jadewits_media_id=322039" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/9b842a4d93c7a06d56b5a04cb97d89e4-6af383d80fa8b.jpg?jadewits_media_id=322039" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/9b842a4d93c7a06d56b5a04cb97d89e4-6af383d80fa8b.jpg?jadewits_media_id=322039" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সন্তান জন্মের ৩ দিন পর ফেনীতে ভবনের ছাদ থেকে পড়ে কর্মকর্তার রহস্যজনক মৃত্যু" /&gt;&lt;/p&gt;&lt;p&gt;দ্বিতীয় সন্তান জন্মের মাত্র তিন দিনের মাথায় ফেনী শহরে একটি ছয়তলা ভবনের ছাদ থেকে নিচে পড়ে আহমেদুর রহমান আকাশ (৩০) নামে বেসরকারি প্রতিষ্ঠানের এক কর্মকর্তা নিহত হয়েছেন। সোমবার (৯ নভেম্বর) রাত ১১টার দিকে শহরের পুরাতন পুলিশ কোয়ার্টার এলাকার ডাক্তার ডানহাম গলিতে এ ঘটনা ঘটে। পরিবারের সদস্যরা এই মৃত্য&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820253/%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A7%A9-%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%AA%E0%A6%B0-%E0%A6%AB%E0%A7%87%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AD%E0%A6%AC%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%9B%E0%A6%BE%E0%A6%A6-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%9C%E0%A7%87">দৈনিক ইত্তেফাক</source>

      <title>টুঙ্গিপাড়ায় বিএনপি ও যুবদলের দুই কার্যালয়ে ভাঙচুর-আগুন</title>
      <link>https://www.ittefaq.com.bd/821025/%E0%A6%9F%E0%A7%81%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BF%E0%A6%AA%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%93-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821025/%E0%A6%9F%E0%A7%81%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BF%E0%A6%AA%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%93-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87</guid>
      <pubDate>Sun, 15 Nov 2026 02:50:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/8c695f2f85e15aaf5f595d2ba0a25ff9-6af8c1df654e4.jpg?jadewits_media_id=322828" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/8c695f2f85e15aaf5f595d2ba0a25ff9-6af8c1df654e4.jpg?jadewits_media_id=322828" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/8c695f2f85e15aaf5f595d2ba0a25ff9-6af8c1df654e4.jpg?jadewits_media_id=322828" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টুঙ্গিপাড়ায় বিএনপি ও যুবদলের দুই কার্যালয়ে ভাঙচুর-আগুন" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জের টুঙ্গিপাড়ায় বিএনপি ও যুবদলের দুটি কার্যালয়ে হামলা, ভাঙচুর ও অগ্নিসংযোগের ঘটনা ঘটেছে। এ সময় ব্যক্তিগত কার্যালয় ও কয়েকটি দোকানেও আগুন ও ভাঙচুর চালানো হয়। কার্যক্রম নিষিদ্ধ আওয়ামী লীগ ও যুবলীগ এবং নিষিদ্ধঘোষিত ছাত্রলীগের নেতা-কর্মীরা এ ঘটনা ঘটিয়েছেন বলে অভিযোগ করেছেন বিএনপি নেতারা।
শনিবার&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821025/%E0%A6%9F%E0%A7%81%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BF%E0%A6%AA%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%93-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>

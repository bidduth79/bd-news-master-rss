      <guid isPermaLink="true">https://www.ittefaq.com.bd/820805/%E0%A6%86%E0%A6%AC%E0%A6%A6%E0%A7%81%E0%A6%B2-%E0%A6%97%E0%A6%A8%E0%A6%BF-%E0%A6%9A%E0%A7%8C%E0%A6%A7%E0%A7%81%E0%A6%B0%E0%A7%80-%E0%A6%95-%E0%A6%AE%E0%A6%BE%E0%A6%87%E0%A6%9C%E0%A6%AD%E0%A6%BE%E0%A6%A3%E0%A7%8D%E0%A6%A1%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A7%AF%E0%A7%A8%E0%A6%A4%E0%A6%AE-%E0%A6%93%E0%A6%B0%E0%A6%B6</guid>

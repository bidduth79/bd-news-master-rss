      <guid isPermaLink="true">https://www.ittefaq.com.bd/820542/%E0%A6%86%E0%A6%AE%E0%A6%BF%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%A6%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%97-%E0%A6%93-%E0%A6%AC%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A7%81%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F</guid>
      <pubDate>Thu, 12 Nov 2026 14:45:48 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/fdfcb636b392d515bf16152a2a0bed3f-6af57c2cc2054.jpg?jadewits_media_id=322329" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/fdfcb636b392d515bf16152a2a0bed3f-6af57c2cc2054.jpg?jadewits_media_id=322329" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/fdfcb636b392d515bf16152a2a0bed3f-6af57c2cc2054.jpg?jadewits_media_id=322329" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আমির হামজার পদত্যাগ ও বিচারের দাবিতে কুষ্টিয়ায় নারীদের বিক্ষোভ" /&gt;&lt;/p&gt;&lt;p&gt;কুষ্টিয়া-৩ (সদর) আসনের সংসদ সদস্য মুফতি আমির হামজার পদত্যাগ ও বিচারের দাবিতে বিক্ষোভ মিছিল ও সমাবেশ করেছেন কুষ্টিয়ার সচেতন নাগরিক সমাজের নারী নেতাকর্মীরা।
বৃহস্পতিবার (১২ নভেম্বর) বেলা ১১টার দিকে শহরের পাঁচ রাস্তার মোড় থেকে বিক্ষোভ মিছিলটি শুরু হয়। মিছিলটি শহরের বিভিন্ন সড়ক প্রদক্ষিণ করে পৌরসভা চত্ব&lt;/p&gt;</description>

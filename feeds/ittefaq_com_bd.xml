      <guid isPermaLink="true">https://www.ittefaq.com.bd/821411/%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%B8%E0%A7%87%E0%A6%9C%E0%A7%87-%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%BF-%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BE-%E0%A6%95%E0%A7%87%E0%A6%9F%E0%A7%87-%E0%A6%86%E0%A6%87%E0%A6%AB%E0%A7%8B%E0%A6%A8%E0%A6%B8%E0%A6%B9-%E0%A7%AC%E0%A7%A7</guid>

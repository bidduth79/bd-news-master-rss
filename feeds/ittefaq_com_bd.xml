    </item>
    <item>
      <title>আত্মীয় বিদায় দিতে ট্রেনে উঠলেন ১২ জন, দরজা আটকে যাওয়ায় যেতে হলো ১৪০ কিমি, সঙ্গে জরিমানাও</title>
      <link>https://www.ittefaq.com.bd/821787/%E0%A6%86%E0%A6%A4%E0%A7%8D%E0%A6%AE%E0%A7%80%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A6%BE%E0%A7%9F-%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A7%87-%E0%A6%89%E0%A6%A0%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A7%A7%E0%A7%A8-%E0%A6%9C%E0%A6%A8-%E0%A6%A6%E0%A6%B0%E0%A6%9C%E0%A6%BE-%E0%A6%86%E0%A6%9F%E0%A6%95%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821787/%E0%A6%86%E0%A6%A4%E0%A7%8D%E0%A6%AE%E0%A7%80%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A6%BE%E0%A7%9F-%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A7%87-%E0%A6%89%E0%A6%A0%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A7%A7%E0%A7%A8-%E0%A6%9C%E0%A6%A8-%E0%A6%A6%E0%A6%B0%E0%A6%9C%E0%A6%BE-%E0%A6%86%E0%A6%9F%E0%A6%95%E0%A7%87</guid>
      <pubDate>Wed, 18 Nov 2026 23:42:58 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/1b7ae5d292c5fb8910e76efd26e2327e-6afde3752fa53.jpg?jadewits_media_id=323615" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/1b7ae5d292c5fb8910e76efd26e2327e-6afde3752fa53.jpg?jadewits_media_id=323615" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/1b7ae5d292c5fb8910e76efd26e2327e-6afde3752fa53.jpg?jadewits_media_id=323615" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আত্মীয় বিদায় দিতে ট্রেনে উঠলেন ১২ জন, দরজা আটকে যাওয়ায় যেতে হলো ১৪০ কিমি, সঙ্গে জরিমানাও" /&gt;&lt;/p&gt;&lt;p&gt;ভারতের উত্তর প্রদেশের কানপুর সেন্ট্রাল রেলওয়ে স্টেশনে এক অদ্ভুত ও বিড়ম্বনাকর পরিস্থিতির শিকার হয়েছেন ১২ জন ব্যক্তি। স্বজনদের ট্রেনে তুলে দিয়ে বিদায় জানাতে গিয়ে &amp;lsquo;বন্দে ভারত এক্সপ্রেস&amp;rsquo;-এর স্বয়ংক্রিয় দরজা বন্ধ হয়ে যাওয়ায় ট্রেনের ভেতরেই আটকা পড়েন তারা। পরবর্তীতে ইটাওয়া জংশনে ট্রেন থামিয়ে ত&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821787/%E0%A6%86%E0%A6%A4%E0%A7%8D%E0%A6%AE%E0%A7%80%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A6%BE%E0%A7%9F-%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A7%87-%E0%A6%89%E0%A6%A0%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A7%A7%E0%A7%A8-%E0%A6%9C%E0%A6%A8-%E0%A6%A6%E0%A6%B0%E0%A6%9C%E0%A6%BE-%E0%A6%86%E0%A6%9F%E0%A6%95%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>ত্রিপক্ষীয় নয়, শি জিনপিং ও পুতিনের সঙ্গে আলাদা বৈঠকে বসছেন ট্রাম্প</title>
      <link>https://www.ittefaq.com.bd/821786/%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%AA%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%80%E0%A7%9F-%E0%A6%A8%E0%A7%9F-%E0%A6%B6%E0%A6%BF-%E0%A6%9C%E0%A6%BF%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%82-%E0%A6%93-%E0%A6%AA%E0%A7%81%E0%A6%A4%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%86%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821786/%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%AA%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%80%E0%A7%9F-%E0%A6%A8%E0%A7%9F-%E0%A6%B6%E0%A6%BF-%E0%A6%9C%E0%A6%BF%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%82-%E0%A6%93-%E0%A6%AA%E0%A7%81%E0%A6%A4%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%86%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A6%BE</guid>
      <pubDate>Wed, 18 Nov 2026 23:30:58 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/a1bb45469b9bb5db061f2323e1af03c1-6afde0974583e.jpg?jadewits_media_id=323614" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/a1bb45469b9bb5db061f2323e1af03c1-6afde0974583e.jpg?jadewits_media_id=323614" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/a1bb45469b9bb5db061f2323e1af03c1-6afde0974583e.jpg?jadewits_media_id=323614" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ত্রিপক্ষীয় নয়, শি জিনপিং ও পুতিনের সঙ্গে আলাদা বৈঠকে বসছেন ট্রাম্প" /&gt;&lt;/p&gt;&lt;p&gt;ত্রিপক্ষীয় বৈঠকের সম্ভাবনা নিয়ে নানা আলোচনা চললেও শেষ পর্যন্ত চীনের প্রেসিডেন্ট শি জিনপিং ও রাশিয়ার প্রেসিডেন্ট ভ্লাদিমির পুতিনের সঙ্গে একসঙ্গে বৈঠকে বসছেন না যুক্তরাষ্ট্রের প্রেসিডেন্ট ডোনাল্ড ট্রাম্প; বরং এই দুই নেতার সঙ্গে আলাদাভাবে বৈঠক করবেন তিনি। মার্কিন সংবাদমাধ্যম সিএনএন এক মার্কিন কর্মকর্তা&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821786/%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%AA%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%80%E0%A7%9F-%E0%A6%A8%E0%A7%9F-%E0%A6%B6%E0%A6%BF-%E0%A6%9C%E0%A6%BF%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%82-%E0%A6%93-%E0%A6%AA%E0%A7%81%E0%A6%A4%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%86%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A6%BE">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>ওদের হাতে গোলামির জিঞ্জির, আমাদের হাতে স্বাধীনতার পতাকা: প্রধানমন্ত্রী</title>
      <link>https://www.ittefaq.com.bd/821785/%E0%A6%93%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%97%E0%A7%8B%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A6%BF%E0%A6%B0-%E0%A6%9C%E0%A6%BF%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A6%BF%E0%A6%B0-%E0%A6%86%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%A7%E0%A7%80%E0%A6%A8%E0%A6%A4%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821785/%E0%A6%93%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%97%E0%A7%8B%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A6%BF%E0%A6%B0-%E0%A6%9C%E0%A6%BF%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A6%BF%E0%A6%B0-%E0%A6%86%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%A7%E0%A7%80%E0%A6%A8%E0%A6%A4%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Wed, 18 Nov 2026 23:22:47 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/62b37e27a7d79a66ad3ca3fbe9a40408-6afddee5a70bc.jpg?jadewits_media_id=323613" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/62b37e27a7d79a66ad3ca3fbe9a40408-6afddee5a70bc.jpg?jadewits_media_id=323613" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/62b37e27a7d79a66ad3ca3fbe9a40408-6afddee5a70bc.jpg?jadewits_media_id=323613" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ওদের হাতে গোলামির জিঞ্জির, আমাদের হাতে স্বাধীনতার পতাকা: প্রধানমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;দেশকে আবারও তাঁবেদার রাষ্ট্রে পরিণত করার ষড়যন্ত্র প্রতিহত করতে দলমত নির্বিশেষে গণতন্ত্রের পক্ষের সব রাজনৈতিক শক্তিকে ২০২৪ সালের গণঅভ্যুত্থানের চেতনায় ঐক্যবদ্ধ হওয়ার আহ্বান জানিয়েছেন প্রধানমন্ত্রী তারেক রহমান।
বুধবার (১৮ নভেম্বর) ত্রয়োদশ জাতীয় সংসদের চতুর্থ অধিবেশনের সমাপনী বক্তব্যে এসব কথা বলেন সংসদ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821785/%E0%A6%93%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%97%E0%A7%8B%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A6%BF%E0%A6%B0-%E0%A6%9C%E0%A6%BF%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A6%BF%E0%A6%B0-%E0%A6%86%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%A7%E0%A7%80%E0%A6%A8%E0%A6%A4%E0%A6%BE%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>নারায়ণগঞ্জে শামীম ওসমানের বাড়িতে আগুন, ফটকে ছবি সাঁটিয়ে বিক্ষোভ</title>
      <link>https://www.ittefaq.com.bd/821784/%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A6%A3%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%B6%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%AE-%E0%A6%93%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%AB%E0%A6%9F%E0%A6%95%E0%A7%87-%E0%A6%9B%E0%A6%AC%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821784/%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A6%A3%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%B6%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%AE-%E0%A6%93%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%AB%E0%A6%9F%E0%A6%95%E0%A7%87-%E0%A6%9B%E0%A6%AC%E0%A6%BF</guid>
      <pubDate>Wed, 18 Nov 2026 23:15:48 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/86f138b683f05247996485d601582707-6afddd2db72d0.jpg?jadewits_media_id=323612" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/86f138b683f05247996485d601582707-6afddd2db72d0.jpg?jadewits_media_id=323612" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/86f138b683f05247996485d601582707-6afddd2db72d0.jpg?jadewits_media_id=323612" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নারায়ণগঞ্জে শামীম ওসমানের বাড়িতে আগুন, ফটকে ছবি সাঁটিয়ে বিক্ষোভ" /&gt;&lt;/p&gt;&lt;p&gt;নারায়ণগঞ্জ-৪ আসনের সাবেক সংসদ সদস্য ও কার্যক্রম নিষিদ্ধ আওয়ামী লীগ নেতা এ কে এম শামীম ওসমানের পরিত্যক্ত বাড়িতে অগ্নিসংযোগ করেছে একদল যুবক। বুধবার (১৮ নভেম্বর) রাতে নারায়ণগঞ্জের ফতুল্লার জামতলা এলাকায় অবস্থিত বাড়িটিতে এ ঘটনা ঘটে।
স্থানীয় সূত্রে জানা গেছে, রাতে সরকারি কদম রসুল কলেজ ছাত্র সংসদের সাবেক &lt;/p&gt;</description>

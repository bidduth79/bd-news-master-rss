      <guid isPermaLink="true">https://www.ittefaq.com.bd/820544/%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%A8%E0%A7%81%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%A4-%E0%A6%A4%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%B8%E0%A7%81%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE</guid>
      <pubDate>Thu, 12 Nov 2026 14:51:50 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/b7fa67150c8fbc52cc9390cbe00bea65-6af57d770b4aa.jpg?jadewits_media_id=322331" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/b7fa67150c8fbc52cc9390cbe00bea65-6af57d770b4aa.jpg?jadewits_media_id=322331" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/b7fa67150c8fbc52cc9390cbe00bea65-6af57d770b4aa.jpg?jadewits_media_id=322331" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এনসিপি নেত্রী নুসরাত তাবাসসুমের বাড়িতে পেট্রলবোমা হামলা, জামায়াতের নিন্দা" /&gt;&lt;/p&gt;&lt;p&gt;জাতীয় নাগরিক পার্টির (এনসিপি) নেত্রী ও সংসদ সদস্য নুসরাত তাবাসসুম জ্যোতির কুষ্টিয়ার দৌলতপুরের গ্রামের বাড়িতে পেট্রলবোমা নিক্ষেপ ও অগ্নিসংযোগের ঘটনায় নিন্দা জানিয়েছে বাংলাদেশ জামায়াতে ইসলামী।
বৃহস্পতিবার (১২ নভেম্বর) দেওয়া এক বিবৃতিতে দলটির সহকারী সেক্রেটারি জেনারেল ও কেন্দ্রীয় প্রচার ও মিডিয়া বিভাগে&lt;/p&gt;</description>

    <item>
      <title>মিরপুরে কার্যক্রম নিষিদ্ধ যুবলীগ নেতা নিখিলের বাসায় হামলা-আগুন</title>
      <link>https://www.ittefaq.com.bd/821813/%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%96%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821813/%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%96%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Thu, 19 Nov 2026 08:49:30 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/feeb6c5b2dfab519595994d3706b0876-6afe62b570ea8.jpg?jadewits_media_id=323641" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/feeb6c5b2dfab519595994d3706b0876-6afe62b570ea8.jpg?jadewits_media_id=323641" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/feeb6c5b2dfab519595994d3706b0876-6afe62b570ea8.jpg?jadewits_media_id=323641" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মিরপুরে কার্যক্রম নিষিদ্ধ যুবলীগ নেতা নিখিলের বাসায় হামলা-আগুন" /&gt;&lt;/p&gt;&lt;p&gt;ঢাকার মিরপুরে কার্যক্রম নিষিদ্ধ যুবলীগের সাধারণ সম্পাদক মাইনুল হোসেন খান নিখিলের বাসায় হামলা, ভাঙচুর ও অগ্নিসংযোগের ঘটনা ঘটেছে।
বুধবার (১৮ নভেম্বর) রাত ৯টার দিকে মিরপুরের ৭ নম্বর সেকশনের মল্লিকা হাউজিংয়ের ছয়তলা ভবনের নিচতলায় এ ঘটনা ঘটে।
হামলাকারীরা বাসার ভেতরে থাকা আসবাব ও ক্রেস্ট ভাঙচুর করে সেগুলোত&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821813/%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%96%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>অবশেষে মধ্যপ্রাচ্য ছাড়ল মার্কিন বিমানবাহী রণতরি জর্জ ওয়াশিংটন</title>
      <link>https://www.ittefaq.com.bd/821812/%E0%A6%85%E0%A6%AC%E0%A6%B6%E0%A7%87%E0%A6%B7%E0%A7%87-%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%AF-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%B2-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8-%E0%A6%AC%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A7%80-%E0%A6%B0%E0%A6%A3%E0%A6%A4%E0%A6%B0%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821812/%E0%A6%85%E0%A6%AC%E0%A6%B6%E0%A7%87%E0%A6%B7%E0%A7%87-%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%AF-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%B2-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8-%E0%A6%AC%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A7%80-%E0%A6%B0%E0%A6%A3%E0%A6%A4%E0%A6%B0%E0%A6%BF</guid>
      <pubDate>Thu, 19 Nov 2026 08:44:23 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/7b456a154e8d2975373a527e4f0ac505-6afe62390fcba.jpg?jadewits_media_id=323640" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/7b456a154e8d2975373a527e4f0ac505-6afe62390fcba.jpg?jadewits_media_id=323640" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/7b456a154e8d2975373a527e4f0ac505-6afe62390fcba.jpg?jadewits_media_id=323640" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অবশেষে মধ্যপ্রাচ্য ছাড়ল মার্কিন বিমানবাহী রণতরি জর্জ ওয়াশিংটন" /&gt;&lt;/p&gt;&lt;p&gt;টানা তিন মাস মধ্যপ্রাচ্যে অবস্থানের পর অঞ্চলটি ছেড়ে চলে গেছে যুক্তরাষ্ট্রের বিমানবাহী রণতরি ইউএসএস জর্জ ওয়াশিংটন। বুধবার (১৮ নভেম্বর) মার্কিন নৌবাহিনী-সংশ্লিষ্ট সংবাদমাধ্যম ইউএসএনআই নিউজের এক প্রতিবেদনে এ তথ্য জানানো হয়েছে।
মার্কিন প্রশান্ত মহাসাগরীয় নৌবহরের এক মুখপাত্র জানান, জাপানে ঘাঁটি থাকা রণতর&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821812/%E0%A6%85%E0%A6%AC%E0%A6%B6%E0%A7%87%E0%A6%B7%E0%A7%87-%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%AF-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%B2-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8-%E0%A6%AC%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A7%80-%E0%A6%B0%E0%A6%A3%E0%A6%A4%E0%A6%B0%E0%A6%BF">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>‘খুবই অস্বাস্থ্যকর’ বাতাস, দূষিত শহরের তালিকায় দ্বিতীয় ঢাকা</title>
      <link>https://www.ittefaq.com.bd/821811/%E2%80%98%E0%A6%96%E0%A7%81%E0%A6%AC%E0%A6%87-%E0%A6%85%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A6%B0%E2%80%99-%E0%A6%AC%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B8-%E0%A6%A6%E0%A7%82%E0%A6%B7%E0%A6%BF%E0%A6%A4-%E0%A6%B6%E0%A6%B9%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A7%9F</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821811/%E2%80%98%E0%A6%96%E0%A7%81%E0%A6%AC%E0%A6%87-%E0%A6%85%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A6%B0%E2%80%99-%E0%A6%AC%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B8-%E0%A6%A6%E0%A7%82%E0%A6%B7%E0%A6%BF%E0%A6%A4-%E0%A6%B6%E0%A6%B9%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A7%9F</guid>
      <pubDate>Thu, 19 Nov 2026 08:42:28 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/15fba6fdf979b5a7ceb1d65fd28a1048-6afe617b05365.jpg?jadewits_media_id=323638" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/15fba6fdf979b5a7ceb1d65fd28a1048-6afe617b05365.jpg?jadewits_media_id=323638" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/15fba6fdf979b5a7ceb1d65fd28a1048-6afe617b05365.jpg?jadewits_media_id=323638" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘খুবই অস্বাস্থ্যকর’ বাতাস, দূষিত শহরের তালিকায় দ্বিতীয় ঢাকা" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানী ঢাকার বাতাসের মান আজ ‘খুবই অস্বাস্থ্যকর’। বায়ুদূষণের মাত্রা বিবেচনায় বিশ্বের দূষিত শহরের তালিকায় ২৩১ স্কোর নিয়ে দ্বিতীয় অবস্থানে রয়েছে ঢাকা। তালিকার শীর্ষে রয়েছে পাকিস্তানের শহর লাহোর।
বৃহস্পতিবার (১৯ নভেম্বর) সকাল ৮টায় সুইজারল্যান্ডভিত্তিক বায়ুমান পর্যবেক্ষণ সংস্থা আইকিউএয়ারের প্রকাশিত তথ্য&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821811/%E2%80%98%E0%A6%96%E0%A7%81%E0%A6%AC%E0%A6%87-%E0%A6%85%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A6%B0%E2%80%99-%E0%A6%AC%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B8-%E0%A6%A6%E0%A7%82%E0%A6%B7%E0%A6%BF%E0%A6%A4-%E0%A6%B6%E0%A6%B9%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A7%9F">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>আজ লালমনিরহাট যাচ্ছেন প্রধানমন্ত্রী</title>
      <link>https://www.ittefaq.com.bd/821810/%E0%A6%86%E0%A6%9C-%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A6%AE%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%B9%E0%A6%BE%E0%A6%9F-%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821810/%E0%A6%86%E0%A6%9C-%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A6%AE%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%B9%E0%A6%BE%E0%A6%9F-%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80</guid>
      <pubDate>Thu, 19 Nov 2026 08:35:56 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/f18ed5c6c38f79f53a6c544b6b2e06a2-6afe60517e7eb.png?jadewits_media_id=323637" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/f18ed5c6c38f79f53a6c544b6b2e06a2-6afe60517e7eb.png?jadewits_media_id=323637" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/f18ed5c6c38f79f53a6c544b6b2e06a2-6afe60517e7eb.png?jadewits_media_id=323637" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আজ লালমনিরহাট যাচ্ছেন প্রধানমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;দীর্ঘ দুই দশকেরও বেশি সময় পর&amp;nbsp; বৃহস্পতিবার (১৯ নভেম্বর) লালমনিরহাট সফরে যাচ্ছেন প্রধানমন্ত্রী তারেক রহমান। তিস্তাপারের এ জেলায় সফরে গিয়ে তিনি একাধিক কর্মসূচিতে অংশগ্রহণ করবেন বলে জানিয়েছেন প্রধানমন্ত্রীর উপ-প্রেস সচিব জাহিদুল ইসলাম রনি।
&amp;nbsp;
সফরসূচি অনুযায়ী, প্রধানমন্ত্রী বৃহস্পতিবার সকাল ৯টায়&lt;/p&gt;</description>

      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/f3bd958244b7bf10fe3d39bb2d2dfdbe-6b008e0e156c5.jpg?jadewits_media_id=323973" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/f3bd958244b7bf10fe3d39bb2d2dfdbe-6b008e0e156c5.jpg?jadewits_media_id=323973" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/f3bd958244b7bf10fe3d39bb2d2dfdbe-6b008e0e156c5.jpg?jadewits_media_id=323973" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নেপালকে মাত্র ২৬ রানে গুটিয়ে ভারতের রেকর্ড ব্যবধানে জয়" /&gt;&lt;/p&gt;&lt;p&gt;এশিয়া কাপ রাইজিং স্টারস ওয়ানডে টুর্নামেন্টে নেপালকে ৩০৬ রানের বিশাল ব্যবধানে হারিয়ে এক ঐতিহাসিক জয় তুলে নিয়েছে ভারতীয় &amp;lsquo;এ&amp;rsquo; দল। তিলক ভার্মা ও কুমার কুশাগরার জোড়া সেঞ্চুরির পর হর্ষিত রানা ও প্রিন্স যাদবের বিধ্বংসী বোলিংয়ে মাত্র ২৬ রানেই গুটিয়ে যায় নেপাল। লিস্ট-এ ক্রিকেটের ইতিহাসে রানে&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822135/%E0%A6%A8%E0%A7%87%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%95%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A7%A8%E0%A7%AC-%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%97%E0%A7%81%E0%A6%9F%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A1">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>জনগণের আস্থাই সশস্ত্র বাহিনীর প্রকৃত শক্তি: রাষ্ট্রপতি</title>
      <link>https://www.ittefaq.com.bd/822133/%E0%A6%9C%E0%A6%A8%E0%A6%97%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%87-%E0%A6%B8%E0%A6%B6%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A7%83%E0%A6%A4-%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822133/%E0%A6%9C%E0%A6%A8%E0%A6%97%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%87-%E0%A6%B8%E0%A6%B6%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A7%83%E0%A6%A4-%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF</guid>
      <pubDate>Sat, 21 Nov 2026 00:04:32 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/a8153b0804ac7b7a1db1b8d5afd526c5-6b008b9135803.jpg?jadewits_media_id=323971" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/a8153b0804ac7b7a1db1b8d5afd526c5-6b008b9135803.jpg?jadewits_media_id=323971" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/a8153b0804ac7b7a1db1b8d5afd526c5-6b008b9135803.jpg?jadewits_media_id=323971" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জনগণের আস্থাই সশস্ত্র বাহিনীর প্রকৃত শক্তি: রাষ্ট্রপতি" /&gt;&lt;/p&gt;&lt;p&gt;রাষ্ট্রপতি মির্জা ফখরুল ইসলাম আলমগীর বলেছেন, আমি বিশ্বাস করি, দেশপ্রেম, সুশৃঙ্খলা, সততা, পেশাদারত্ব ও জনগণের আস্থাই সশস্ত্র বাহিনীর প্রকৃত শক্তি।
তিনি বলেন, বাংলাদেশের সংবিধান, নেতৃত্বের প্রতি আনুগত্য এবং জাতীয় স্বার্থকে সর্বোচ্চ গুরুত্ব দিয়ে সশস্ত্র বাহিনীর সদস্যরা তাদের ওপর অর্পিত দায়িত্ব পালন কর&lt;/p&gt;</description>

      <guid isPermaLink="true">https://www.ittefaq.com.bd/820920/%E0%A6%B9%E0%A6%B0%E0%A6%AE%E0%A7%81%E0%A6%9C-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A3%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A6%9B%E0%A6%AF%E0%A6%BC-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A7%A8%E0%A7%AB-%E0%A6%A8%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%95</guid>
      <pubDate>Sat, 14 Nov 2026 14:31:18 +0600</pubDate>

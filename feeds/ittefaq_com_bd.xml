      <guid isPermaLink="true">https://www.ittefaq.com.bd/822202/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%AE%E0%A6%B0%E0%A6%A6%E0%A7%87%E0%A6%B9-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Sat, 21 Nov 2026 15:00:25 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/7f9b3b8916d42f08c98419208564b840-6b015d6e2793f.jpg?jadewits_media_id=324040" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/7f9b3b8916d42f08c98419208564b840-6b015d6e2793f.jpg?jadewits_media_id=324040" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/7f9b3b8916d42f08c98419208564b840-6b015d6e2793f.jpg?jadewits_media_id=324040" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজধানীতে যুবকের রক্তাক্ত মরদেহ উদ্ধার, পিটিয়ে-ছুরিকাঘাতে হত্যার অভিযোগ বোনের" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর খিলগাঁওয়ের নাগদারপাড় এলাকায় মোস্তফা (২২) নামে এক যুবকের রক্তাক্ত মরদেহ উদ্ধার করা হয়েছে। এদিকে মাছ ধরার লিজ নিয়ে বিরোধের জেরে তাকে পিটিয়ে ও ছুরিকাঘাতে হত্যা করা হয়েছে বলে অভিযোগ করেন তার বোন। শুক্রবার (২০ নভেম্বর) দিবাগত রাত সাড়ে তিনটার পর এ ঘটনা ঘটে।
এক বন্ধু ডেকে নিয়ে যাওয়ার পর তাকে হত&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822202/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%AE%E0%A6%B0%E0%A6%A6%E0%A7%87%E0%A6%B9-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>সমুদ্রবন্দরে ৩ নম্বর সতর্ক সংকেত নামিয়ে ফেলার নির্দেশ</title>
      <link>https://www.ittefaq.com.bd/822201/%E0%A6%B8%E0%A6%AE%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%B0%E0%A7%87-%E0%A7%A9-%E0%A6%A8%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%B8%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%95-%E0%A6%B8%E0%A6%82%E0%A6%95%E0%A7%87%E0%A6%A4-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822201/%E0%A6%B8%E0%A6%AE%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%B0%E0%A7%87-%E0%A7%A9-%E0%A6%A8%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%B8%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%95-%E0%A6%B8%E0%A6%82%E0%A6%95%E0%A7%87%E0%A6%A4-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Sat, 21 Nov 2026 14:59:10 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2024/10/24/22d8c3c8b7bddd0c935d92a1f36826ad-6719dbcedd528.jpg?jadewits_media_id=192370" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2024/10/24/22d8c3c8b7bddd0c935d92a1f36826ad-6719dbcedd528.jpg?jadewits_media_id=192370" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2024/10/24/22d8c3c8b7bddd0c935d92a1f36826ad-6719dbcedd528.jpg?jadewits_media_id=192370" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সমুদ্রবন্দরে ৩ নম্বর সতর্ক সংকেত নামিয়ে ফেলার নির্দেশ" /&gt;&lt;/p&gt;&lt;p&gt;উত্তর বঙ্গোপসাগর ও তৎসংলগ্ন বাংলাদেশের উপকূলীয় এলাকার ওপর দিয়ে ঝোড়ো হাওয়া বয়ে যাওয়ার আশঙ্কা নেই বলে জানিয়েছে বাংলাদেশ আবহাওয়া অধিদপ্তর। এ অবস্থায় চট্টগ্রাম, কক্সবাজার, মোংলা ও পায়রা সমুদ্রবন্দরকে দেখানো সংকেত নামিয়ে ফেলতে বলা হয়েছে।
শনিবার (২১ নভেম্বর) বাংলাদেশ আবহাওয়া অধিদপ্তরের ঝড় সতর্কীকরণ কেন্দ্&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822201/%E0%A6%B8%E0%A6%AE%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%B0%E0%A7%87-%E0%A7%A9-%E0%A6%A8%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%B8%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%95-%E0%A6%B8%E0%A6%82%E0%A6%95%E0%A7%87%E0%A6%A4-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>হাসিনা আসুক, আইন অনুযায়ী তার ব্যবস্থা হবে: নিতাই রায় চৌধুরী</title>
      <link>https://www.ittefaq.com.bd/822200/%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE-%E0%A6%86%E0%A6%B8%E0%A7%81%E0%A6%95-%E0%A6%86%E0%A6%87%E0%A6%A8-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AF%E0%A6%BE%E0%A7%9F%E0%A7%80-%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE-%E0%A6%B9%E0%A6%AC%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%A4%E0%A6%BE%E0%A6%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822200/%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE-%E0%A6%86%E0%A6%B8%E0%A7%81%E0%A6%95-%E0%A6%86%E0%A6%87%E0%A6%A8-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AF%E0%A6%BE%E0%A7%9F%E0%A7%80-%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE-%E0%A6%B9%E0%A6%AC%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%A4%E0%A6%BE%E0%A6%87</guid>
      <pubDate>Sat, 21 Nov 2026 14:58:11 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/414e2f20c1cdbf0f5ff621b09cff64a5-6b015cd42c2ff.jpg?jadewits_media_id=324039" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/414e2f20c1cdbf0f5ff621b09cff64a5-6b015cd42c2ff.jpg?jadewits_media_id=324039" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/414e2f20c1cdbf0f5ff621b09cff64a5-6b015cd42c2ff.jpg?jadewits_media_id=324039" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হাসিনা আসুক, আইন অনুযায়ী তার ব্যবস্থা হবে: নিতাই রায় চৌধুরী" /&gt;&lt;/p&gt;&lt;p&gt;আন্তর্জাতিক ও দ্বিপাক্ষিক আইন অনুযায়ী শেখ হাসিনাকে দেশে ফিরিয়ে এনে আইনের মাধ্যমে বিচারের আওতায় আনার কথা বলেছেন সংস্কৃতি মন্ত্রী ও মাগুরা-২ আসনের সংসদ সদস্য নিতাই রায় চৌধুরী। শনিবার (২১ নভেম্বর) মাগুরার মহম্মদপুর উপজেলায় এক মতবিনিময় সভায় তিনি এ মন্তব্য করেন এবং ভারতে বসে ষড়যন্ত্র ও অরাজকতা সৃ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822200/%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE-%E0%A6%86%E0%A6%B8%E0%A7%81%E0%A6%95-%E0%A6%86%E0%A6%87%E0%A6%A8-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AF%E0%A6%BE%E0%A7%9F%E0%A7%80-%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE-%E0%A6%B9%E0%A6%AC%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%A4%E0%A6%BE%E0%A6%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>

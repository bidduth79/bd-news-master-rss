    <item>
      <title>ট্রাক থামিয়ে চাঁদা আদায়, বিএনপির দুই নেতাকে বহিষ্কারের নির্দেশ</title>
      <link>https://www.ittefaq.com.bd/820928/%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%95-%E0%A6%A5%E0%A6%BE%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%BE-%E0%A6%86%E0%A6%A6%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820928/%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%95-%E0%A6%A5%E0%A6%BE%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%BE-%E0%A6%86%E0%A6%A6%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87</guid>
      <pubDate>Sat, 14 Nov 2026 15:17:54 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/19429274f3f607890468c919e0883e28-6af8255ac5207.jpg?jadewits_media_id=322726" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/19429274f3f607890468c919e0883e28-6af8255ac5207.jpg?jadewits_media_id=322726" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/19429274f3f607890468c919e0883e28-6af8255ac5207.jpg?jadewits_media_id=322726" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ট্রাক থামিয়ে চাঁদা আদায়, বিএনপির দুই নেতাকে বহিষ্কারের নির্দেশ" /&gt;&lt;/p&gt;&lt;p&gt;টাঙ্গাইলের মির্জাপুরে আঞ্চলিক সড়কে ট্রাক থামিয়ে চাঁদা আদায়ের ঘটনায় বিএনপির দুই নেতাকে দল থেকে বহিষ্কারের নির্দেশ দেওয়া হয়েছে। অভিযোগের সত্যতা পাওয়ার পর শুক্রবার রাতে উপজেলা বিএনপির ভারপ্রাপ্ত সভাপতি অ্যাডভোকেট আব্দুর রউফ এ নির্দেশ দেন।
শনিবার (১৪ নভেম্বর) গণমাধ্যমের কাছে বিষয়টি নিশ্চিত করেছেন অ্যাডভ&lt;/p&gt;</description>

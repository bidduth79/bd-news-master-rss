      <guid isPermaLink="true">https://www.ittefaq.com.bd/822493/%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%AE%E0%A6%B2%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%B8%E0%A6%AB%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%B8%E0%A6%9B%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Sun, 22 Nov 2026 23:13:20 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/00f9d170a3bb080babe86eab6edc7827-6b032266d3793.jpg?jadewits_media_id=324334" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/00f9d170a3bb080babe86eab6edc7827-6b032266d3793.jpg?jadewits_media_id=324334" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/00f9d170a3bb080babe86eab6edc7827-6b032266d3793.jpg?jadewits_media_id=324334" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিএনপি সরকারের আমলে প্রথম ঢাকা সফরে আসছেন মালয়েশিয়ার প্রধানমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;বিএনপি সরকার গঠনের ১০ মাসের মাথায় প্রথম কোনো সরকারপ্রধানের দ্বিপক্ষীয় সফরে ঢাকায় আসছেন মালয়েশিয়ার প্রধানমন্ত্রী আনোয়ার ইব্রাহিম। আগামী ৭ ডিসেম্বর দুই দিনের সফরে তার বাংলাদেশে আসার প্রস্তুতি চলছে বলে জানিয়েছেন পররাষ্ট্র মন্ত্রণালয়ের কর্মকর্তারা।
সফরকালে প্রধানমন্ত্রী তারেক রহমানের সঙ্গে দ্বিপক্ষীয় বৈ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822493/%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%AE%E0%A6%B2%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%B8%E0%A6%AB%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%B8%E0%A6%9B%E0%A7%87%E0%A6%A8">দৈনিক ইত্তেফাক</source>
    </item>

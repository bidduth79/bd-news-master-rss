    <item>
      <title>জিয়াউর রহমানের নেতৃত্বে বিএনপির প্রথম কমিটিতে ছিলেন ইত্তেফাকের চেয়ারম্যান আনোয়ার হোসেন মঞ্জু</title>
      <link>https://www.ittefaq.com.bd/820333/%E0%A6%9C%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%89%E0%A6%B0-%E0%A6%B0%E0%A6%B9%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%95%E0%A6%AE%E0%A6%BF%E0%A6%9F%E0%A6%BF%E0%A6%A4%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820333/%E0%A6%9C%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%89%E0%A6%B0-%E0%A6%B0%E0%A6%B9%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%95%E0%A6%AE%E0%A6%BF%E0%A6%9F%E0%A6%BF%E0%A6%A4%E0%A7%87</guid>
      <pubDate>Wed, 11 Nov 2026 15:29:54 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/00cdb76da4efc61508370f4822795a45-6af4340c6c85a.jpg?jadewits_media_id=322119" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/00cdb76da4efc61508370f4822795a45-6af4340c6c85a.jpg?jadewits_media_id=322119" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/00cdb76da4efc61508370f4822795a45-6af4340c6c85a.jpg?jadewits_media_id=322119" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জিয়াউর রহমানের নেতৃত্বে বিএনপির প্রথম কমিটিতে ছিলেন ইত্তেফাকের চেয়ারম্যান আনোয়ার হোসেন মঞ্জু" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ জাতীয়তাবাদী দল (বিএনপি) প্রতিষ্ঠা করেন প্রয়াত রাষ্ট্রপতি জিয়াউর রহমান। প্রথমে দলটির নাম ছিল বাংলাদেশ ন্যাশনালিস্ট পার্টি। ১৯৭৫ সালে বঙ্গবন্ধুকে সপরিবারে হত্যার পর রাষ্ট্রীয় ক্ষমতার পালাবদলের এক পর্যায়ে ১৯৭৬ সালে সামরিক আইন জারি করে ক্ষমতায় এসেছিলেন জিয়াউর রহমান। প্রধান সামরিক আইন প্রশাসক থা&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820333/%E0%A6%9C%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%89%E0%A6%B0-%E0%A6%B0%E0%A6%B9%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%95%E0%A6%AE%E0%A6%BF%E0%A6%9F%E0%A6%BF%E0%A6%A4%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>ঋণ নয়, জলবায়ু তহবিলের অনুদানের বিষয় তুলে ধরবেন প্রধানমন্ত্রী: শামা ওবায়েদ</title>

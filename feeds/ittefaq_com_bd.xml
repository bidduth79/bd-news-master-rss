    <item>
      <title>[দৈনিক ইত্তেফাক] ভাটারায় স্কুল বাসে আগুন তবে কেউ হতাহত হয়নি</title>
      <link>https://www.ittefaq.com.bd/819795/%E0%A6%AD%E0%A6%BE%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%A4%E0%A6%AC%E0%A7%87-%E0%A6%95%E0%A7%87%E0%A6%89-%E0%A6%B9%E0%A6%A4%E0%A6%BE%E0%A6%B9%E0%A6%A4-%E0%A6%B9%E0%A7%9F%E0%A6%A8%E0%A6%BF</link>

    </item>
    <item>
      <title>রাজবাড়ীতে ঢাকঢোল পিটিয়ে-লাল পতাকা টাঙিয়ে জমির দখল বুঝিয়ে দিলেন আদালত</title>
      <link>https://www.ittefaq.com.bd/822313/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%AC%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%A2%E0%A7%8B%E0%A6%B2-%E0%A6%AA%E0%A6%BF%E0%A6%9F%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%B2%E0%A6%BE%E0%A6%B2-%E0%A6%AA%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%9F%E0%A6%BE%E0%A6%99%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%9C%E0%A6%AE%E0%A6%BF%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822313/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%AC%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%A2%E0%A7%8B%E0%A6%B2-%E0%A6%AA%E0%A6%BF%E0%A6%9F%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%B2%E0%A6%BE%E0%A6%B2-%E0%A6%AA%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%9F%E0%A6%BE%E0%A6%99%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%9C%E0%A6%AE%E0%A6%BF%E0%A6%B0</guid>
      <pubDate>Sun, 22 Nov 2026 08:39:34 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/5aeb7f592449494bf3e468e33bdf0018-6b0255be58082.jpg?jadewits_media_id=324152" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/5aeb7f592449494bf3e468e33bdf0018-6b0255be58082.jpg?jadewits_media_id=324152" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/5aeb7f592449494bf3e468e33bdf0018-6b0255be58082.jpg?jadewits_media_id=324152" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজবাড়ীতে ঢাকঢোল পিটিয়ে-লাল পতাকা টাঙিয়ে জমির দখল বুঝিয়ে দিলেন আদালত" /&gt;&lt;/p&gt;&lt;p&gt;ব্রিটিশ আমলের প্রচলিত রীতির আদলে ঢাকঢোল পিটিয়ে ও লাল পতাকা টাঙিয়ে জমির সীমানা নির্ধারণ করে রাজবাড়ীতে মালিকদের দখল বুঝিয়ে দিয়েছেন আদালত।&amp;nbsp;
শনিবার (২১ নভেম্বর) সকালে রাজবাড়ীর গোয়ালন্দ উপজেলার দৌলতদিয়া ইউনিয়নের যদু ফকির পাড়ায় ব্যতিক্রম এ ঘটনা ঘটে। এ সময় ঘটনাটি দেখতে স্থানীয় উৎসুক মানুষ ভিড় করেন।
আদ&lt;/p&gt;</description>

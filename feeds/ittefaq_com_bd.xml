      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/9b842a4d93c7a06d56b5a04cb97d89e4-6af383d80fa8b.jpg?jadewits_media_id=322039" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফেনীতে সন্তান জন্মের ৩ দিন পর ভবনের ছাদ থেকে পড়ে কর্মকর্তার রহস্যজনক মৃত্যু" /&gt;&lt;/p&gt;&lt;p&gt;দ্বিতীয় সন্তান জন্মের মাত্র তিন দিনের মাথায় ফেনী শহরে একটি ছয়তলা ভবনের ছাদ থেকে নিচে পড়ে আহমেদুর রহমান আকাশ (৩০) নামে বেসরকারি প্রতিষ্ঠানের এক কর্মকর্তা নিহত হয়েছেন। সোমবার (৯ নভেম্বর) রাত ১১টার দিকে শহরের পুরাতন পুলিশ কোয়ার্টার এলাকার ডাক্তার ডানহাম গলিতে এ ঘটনা ঘটে। পরিবারের সদস্যরা এই মৃত্য&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820253/%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A7%A9-%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%AA%E0%A6%B0-%E0%A6%AB%E0%A7%87%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AD%E0%A6%AC%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%9B%E0%A6%BE%E0%A6%A6-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%9C%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>টাঙ্গাইলে শিশু শিক্ষার্থীকে যৌন নিপীড়নের অভিযোগে শিক্ষক বরখাস্ত</title>
      <link>https://www.ittefaq.com.bd/820252/%E0%A6%9F%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%87-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%AF%E0%A7%8C%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A6%AA%E0%A7%80%E0%A7%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820252/%E0%A6%9F%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%87-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%AF%E0%A7%8C%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A6%AA%E0%A7%80%E0%A7%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%87</guid>
      <pubDate>Wed, 11 Nov 2026 02:28:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/35253e7bd9fbb78c6b37ce018e17b85c-6af375ed78086.jpg?jadewits_media_id=322038" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/35253e7bd9fbb78c6b37ce018e17b85c-6af375ed78086.jpg?jadewits_media_id=322038" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/35253e7bd9fbb78c6b37ce018e17b85c-6af375ed78086.jpg?jadewits_media_id=322038" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টাঙ্গাইলে শিশু শিক্ষার্থীকে যৌন নিপীড়নের অভিযোগে শিক্ষক বরখাস্ত" /&gt;&lt;/p&gt;&lt;p&gt;টাঙ্গাইলের মির্জাপুরে কোমলমতি এক শিশু শিক্ষার্থীকে যৌন নিপীড়নের অভিযোগে তপন সরকার নামে এক সরকারি প্রাথমিক বিদ্যালয়ের সহকারী শিক্ষককে সাময়িক বরখাস্ত করা হয়েছে।
মঙ্গলবার (১০ নভেম্বর) টাঙ্গাইল জেলা প্রাথমিক শিক্ষা কর্মকর্তা (ডিপিও) মো. মাহিন মিয়া স্বাক্ষরিত এক আদেশে অভিযুক্ত শিক্ষককে বরখাস্তের এ সিদ্ধা&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820252/%E0%A6%9F%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%87-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%AF%E0%A7%8C%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A6%AA%E0%A7%80%E0%A7%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>আন্তালিয়ায় তারেক রহমান–এরদোয়ান দ্বিপক্ষীয় বৈঠক: প্রতিরক্ষা, বাণিজ্য ও রোহিঙ্গা ইস্যুতে আলোচনা</title>
      <link>https://www.ittefaq.com.bd/820251/%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%B0%E0%A6%B9%E0%A6%AE%E0%A6%BE%E0%A6%A8%E2%80%93%E0%A6%8F%E0%A6%B0%E0%A6%A6%E0%A7%8B%E0%A7%9F%E0%A6%BE%E0%A6%A8-%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%80%E0%A6%AF%E0%A6%BC-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820251/%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%B0%E0%A6%B9%E0%A6%AE%E0%A6%BE%E0%A6%A8%E2%80%93%E0%A6%8F%E0%A6%B0%E0%A6%A6%E0%A7%8B%E0%A7%9F%E0%A6%BE%E0%A6%A8-%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%80%E0%A6%AF%E0%A6%BC-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95</guid>
      <pubDate>Wed, 11 Nov 2026 01:59:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/934ea57537e23b294497259bc8293c1a-6af3740263cb8.jpg?jadewits_media_id=322037" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/934ea57537e23b294497259bc8293c1a-6af3740263cb8.jpg?jadewits_media_id=322037" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/934ea57537e23b294497259bc8293c1a-6af3740263cb8.jpg?jadewits_media_id=322037" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আন্তালিয়ায় তারেক রহমান–এরদোয়ান দ্বিপক্ষীয় বৈঠক: প্রতিরক্ষা, বাণিজ্য ও রোহিঙ্গা ইস্যুতে আলোচনা" /&gt;&lt;/p&gt;&lt;p&gt;তুরস্কের উপকূলীয় শহর আন্তালিয়ায় বাংলাদেশের প্রধানমন্ত্রী তারেক রহমান ও তুরস্কের প্রেসিডেন্ট রিসেপ তাইয়েপ এরদোয়ানের মধ্যে এক গুরুত্বপূর্ণ দ্বিপক্ষীয় বৈঠক অনুষ্ঠিত হয়েছে। স্থানীয় সময় মঙ্গলবার (১০ নভেম্বর) সন্ধ্যায় আন্তালিয়ার ম্যাক্স রয়েল হোটেলে এ বৈঠক অনুষ্ঠিত হয়। জলবায়ু পরিবর্তনবিষয়ক জাত&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820251/%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%B0%E0%A6%B9%E0%A6%AE%E0%A6%BE%E0%A6%A8%E2%80%93%E0%A6%8F%E0%A6%B0%E0%A6%A6%E0%A7%8B%E0%A7%9F%E0%A6%BE%E0%A6%A8-%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%80%E0%A6%AF%E0%A6%BC-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>‘এখান থেকেই শুরু হয়েছিল সব’— ‘ব্যাচেলর পয়েন্ট’ শেষলগ্নে ‘কাবিলা’</title>
      <link>https://www.ittefaq.com.bd/820250/%E2%80%98%E0%A6%8F%E0%A6%96%E0%A6%BE%E0%A6%A8-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87%E0%A6%87-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81-%E0%A6%B9%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%B8%E0%A6%AC%E2%80%99%E2%80%94-%E2%80%98%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%87%E0%A6%B2%E0%A6%B0-%E0%A6%AA%E0%A7%9F%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E2%80%99</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820250/%E2%80%98%E0%A6%8F%E0%A6%96%E0%A6%BE%E0%A6%A8-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87%E0%A6%87-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81-%E0%A6%B9%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%B8%E0%A6%AC%E2%80%99%E2%80%94-%E2%80%98%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%87%E0%A6%B2%E0%A6%B0-%E0%A6%AA%E0%A7%9F%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E2%80%99</guid>
      <pubDate>Wed, 11 Nov 2026 01:37:40 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/03f293498af3da75f4f5979e1847f18b-6af3725e5b7a3.jpg?jadewits_media_id=322036" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/03f293498af3da75f4f5979e1847f18b-6af3725e5b7a3.jpg?jadewits_media_id=322036" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/03f293498af3da75f4f5979e1847f18b-6af3725e5b7a3.jpg?jadewits_media_id=322036" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘এখান থেকেই শুরু হয়েছিল সব’— ‘ব্যাচেলর পয়েন্ট’ শেষলগ্নে ‘কাবিলা’" /&gt;&lt;/p&gt;&lt;p&gt;দীর্ঘ নয় বছরের বর্ণাঢ্য পথচলার ইতি টেনে অবশেষে সম্পন্ন হলো দর্শকপ্রিয় ধারাবাহিক &amp;lsquo;ব্যাচেলর পয়েন্ট&amp;rsquo;-এর পঞ্চম সিজনের শেষ অংশের শুটিং। সময়ের আবর্তে কেবল বিনোদনের গণ্ডি পেরিয়ে সাধারণ দর্শকের কাছে এক গভীর আবেগ ও ভালোবাসার নাম হয়ে উঠেছিল নির্মাতা কাজল আরেফিন অমি পরিচালিত এই ধারাবাহিকটি।
এবার এর&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820250/%E2%80%98%E0%A6%8F%E0%A6%96%E0%A6%BE%E0%A6%A8-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87%E0%A6%87-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81-%E0%A6%B9%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%B8%E0%A6%AC%E2%80%99%E2%80%94-%E2%80%98%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%87%E0%A6%B2%E0%A6%B0-%E0%A6%AA%E0%A7%9F%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E2%80%99">দৈনিক ইত্তেফাক</source>
    </item>

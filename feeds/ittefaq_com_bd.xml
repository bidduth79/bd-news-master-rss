    <item>
      <title>রমজান উপলক্ষ্যে খেজুর, মাল্টা ও আপেল আমদানিতে শুল্ক কমল</title>
      <link>https://www.ittefaq.com.bd/821205/%E0%A6%B0%E0%A6%AE%E0%A6%9C%E0%A6%BE%E0%A6%A8-%E0%A6%89%E0%A6%AA%E0%A6%B2%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%96%E0%A7%87%E0%A6%9C%E0%A7%81%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%93-%E0%A6%86%E0%A6%AA%E0%A7%87%E0%A6%B2-%E0%A6%86%E0%A6%AE%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%A4%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821205/%E0%A6%B0%E0%A6%AE%E0%A6%9C%E0%A6%BE%E0%A6%A8-%E0%A6%89%E0%A6%AA%E0%A6%B2%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%96%E0%A7%87%E0%A6%9C%E0%A7%81%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%93-%E0%A6%86%E0%A6%AA%E0%A7%87%E0%A6%B2-%E0%A6%86%E0%A6%AE%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%A4%E0%A7%87</guid>
      <pubDate>Mon, 16 Nov 2026 07:20:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/2044f35f30a40a092f920a9317ae51d2-6afa11c710afd.jpg?jadewits_media_id=323018" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/2044f35f30a40a092f920a9317ae51d2-6afa11c710afd.jpg?jadewits_media_id=323018" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/2044f35f30a40a092f920a9317ae51d2-6afa11c710afd.jpg?jadewits_media_id=323018" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রমজান উপলক্ষ্যে খেজুর, মাল্টা ও আপেল আমদানিতে শুল্ক কমল" /&gt;&lt;/p&gt;&lt;p&gt;আসন্ন পবিত্র রমজান মাসে খেজুর, মাল্টা ও আপেলের সরবরাহ স্বাভাবিক রাখা এবং দাম সহনীয় পর্যায়ে রাখতে এসব পণ্য আমদানিতে শুল্ক ও করভার কমিয়েছে সরকার। খেজুর আমদানিতে কাস্টমস শুল্ক ২৫ শতাংশ থেকে কমিয়ে ৫ শতাংশ নির্ধারণ করা হয়েছে। অন্যদিকে মাল্টা ও আপেল আমদানিতে বিদ্যমান ১২১ দশমিক ৭৮ শতাংশ মোট করভার কমিয়ে ৬১ &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821205/%E0%A6%B0%E0%A6%AE%E0%A6%9C%E0%A6%BE%E0%A6%A8-%E0%A6%89%E0%A6%AA%E0%A6%B2%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%96%E0%A7%87%E0%A6%9C%E0%A7%81%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%93-%E0%A6%86%E0%A6%AA%E0%A7%87%E0%A6%B2-%E0%A6%86%E0%A6%AE%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%A4%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>যুদ্ধের অবসানে তিন পরাশক্তি কি সত্যিই একমত হইবে?</title>
      <link>https://www.ittefaq.com.bd/821208/%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%AA%E0%A6%B0%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%95%E0%A6%BF-%E0%A6%B8%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BF%E0%A6%87-%E0%A6%8F%E0%A6%95%E0%A6%AE%E0%A6%A4-%E0%A6%B9%E0%A6%87%E0%A6%AC%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821208/%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%AA%E0%A6%B0%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%95%E0%A6%BF-%E0%A6%B8%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BF%E0%A6%87-%E0%A6%8F%E0%A6%95%E0%A6%AE%E0%A6%A4-%E0%A6%B9%E0%A6%87%E0%A6%AC%E0%A7%87</guid>
      <pubDate>Mon, 16 Nov 2026 06:41:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/71296d4680ea64ba84d7027716cc91c8-6afa193f27733.jpg?jadewits_media_id=323021" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/71296d4680ea64ba84d7027716cc91c8-6afa193f27733.jpg?jadewits_media_id=323021" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/71296d4680ea64ba84d7027716cc91c8-6afa193f27733.jpg?jadewits_media_id=323021" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যুদ্ধের অবসানে তিন পরাশক্তি কি সত্যিই একমত হইবে?" /&gt;&lt;/p&gt;&lt;p&gt;যুদ্ধেরও একটি অর্থনৈতিক মূল্য রহিয়াছে, সামাজিক মূল্য রহিয়াছে, এমনকি রহিয়াছে গভীর মনস্তাত্ত্বিক মূল্য। কিন্তু সেই মূল্য যখন সীমা অতিক্রম করে, তখন তাহার বোঝা বহন করিবার ক্ষমতা রাষ্ট্রেরও থাকে না, সাধারণ মানুষেরও থাকে না। পৃথিবী এখন অনেকটা সেই পরিস্থিতির সম্মুখীন। ইউক্রেনের যুদ্ধ থামিতেছে না, ইরানকে কে&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821208/%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%AA%E0%A6%B0%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%95%E0%A6%BF-%E0%A6%B8%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BF%E0%A6%87-%E0%A6%8F%E0%A6%95%E0%A6%AE%E0%A6%A4-%E0%A6%B9%E0%A6%87%E0%A6%AC%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>সিলেট থেকে জোহানেসবার্গ: হৃদয় জয় করে চলেছেন হৃদয়</title>
      <link>https://www.ittefaq.com.bd/821207/%E0%A6%B8%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%9F-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%9C%E0%A7%8B%E0%A6%B9%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B8%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%97-%E0%A6%B9%E0%A7%83%E0%A6%A6%E0%A7%9F-%E0%A6%9C%E0%A7%9F-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%9A%E0%A6%B2%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%B9%E0%A7%83%E0%A6%A6%E0%A7%9F</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821207/%E0%A6%B8%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%9F-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%9C%E0%A7%8B%E0%A6%B9%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B8%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%97-%E0%A6%B9%E0%A7%83%E0%A6%A6%E0%A7%9F-%E0%A6%9C%E0%A7%9F-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%9A%E0%A6%B2%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%B9%E0%A7%83%E0%A6%A6%E0%A7%9F</guid>
      <pubDate>Mon, 16 Nov 2026 06:02:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/2687de10cc23bca7f00636bf5d95441d-6afa179e41a67.jpg?jadewits_media_id=323020" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/2687de10cc23bca7f00636bf5d95441d-6afa179e41a67.jpg?jadewits_media_id=323020" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/2687de10cc23bca7f00636bf5d95441d-6afa179e41a67.jpg?jadewits_media_id=323020" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সিলেট থেকে জোহানেসবার্গ: হৃদয় জয় করে চলেছেন হৃদয়" /&gt;&lt;/p&gt;&lt;p&gt;১২১ রানে ৫ উইকেট হারিয়ে যখন ধুঁকছিল বাংলাদেশের ব্যাটিং লাইনআপ, তখনই দলের হাল ধরেন সিলেট টেস্টে ওয়েস্ট ইন্ডিজের বিপক্ষে ঐতিহাসিক ডাবল সেঞ্চুরি করা তাওহীদ হৃদয় ও অভিজ্ঞ লিটন দাস। শেষ পর্যন্ত ৬ উইকেট হারিয়ে স্কোর বোর্ডে ৩২৭ রান তুলে প্রথমদিন শেষ করে বাংলাদেশ। দিন শেষ হওয়ার আগে হৃদয়জুড়ানো ব্যাটিংয়ে সেঞ্&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821207/%E0%A6%B8%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%9F-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%9C%E0%A7%8B%E0%A6%B9%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B8%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%97-%E0%A6%B9%E0%A7%83%E0%A6%A6%E0%A7%9F-%E0%A6%9C%E0%A7%9F-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%9A%E0%A6%B2%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%B9%E0%A7%83%E0%A6%A6%E0%A7%9F">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>সিরাজগঞ্জে হাতে তৈরি হচ্ছে বাহারি নকশার টুপি</title>
      <link>https://www.ittefaq.com.bd/821209/%E0%A6%B8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%A4%E0%A7%88%E0%A6%B0%E0%A6%BF-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%A8%E0%A6%95%E0%A6%B6%E0%A6%BE%E0%A6%B0-%E0%A6%9F%E0%A7%81%E0%A6%AA%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821209/%E0%A6%B8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%A4%E0%A7%88%E0%A6%B0%E0%A6%BF-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%A8%E0%A6%95%E0%A6%B6%E0%A6%BE%E0%A6%B0-%E0%A6%9F%E0%A7%81%E0%A6%AA%E0%A6%BF</guid>
      <pubDate>Mon, 16 Nov 2026 05:25:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/44edc70f416e482396ec3b64598d44f6-6afa1bd5cb4d2.jpg?jadewits_media_id=323022" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/44edc70f416e482396ec3b64598d44f6-6afa1bd5cb4d2.jpg?jadewits_media_id=323022" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/44edc70f416e482396ec3b64598d44f6-6afa1bd5cb4d2.jpg?jadewits_media_id=323022" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সিরাজগঞ্জে হাতে তৈরি হচ্ছে বাহারি নকশার টুপি" /&gt;&lt;/p&gt;&lt;p&gt;সিরাজগঞ্জ জেলার কাজীপুর ও উল্লাপড়া উপজেলার বিভিন্ন গ্রামে নারীরা টুপি বানিয়ে সংসারে সচ্ছলতা এনেছে। জানা গেছে, কাজীপুরের চালিতাডাঙ্গা, চর ভানুডাঙ্গা অন্যদিকে উল্লাপাড়া উপজেলার সলঙ্গা ইউনিয়নের নাইমুরি, পুরান ভেড়া, তেলকুপি গ্রামের স্কুলপড়ুয়া মেয়ে, মধ্যবয়সি নারী, বৃদ্ধ নারীরা সুইসুতার দ্বারা তৈরি করছেন&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821209/%E0%A6%B8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%A4%E0%A7%88%E0%A6%B0%E0%A6%BF-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%A8%E0%A6%95%E0%A6%B6%E0%A6%BE%E0%A6%B0-%E0%A6%9F%E0%A7%81%E0%A6%AA%E0%A6%BF">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>সরকারি টাকার নয়ছয় তিন প্রতিষ্ঠানে, দুদকের অভিযানে প্রমাণ</title>
      <link>https://www.ittefaq.com.bd/821213/%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A7%9F%E0%A6%9B%E0%A7%9F-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%A6%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821213/%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A7%9F%E0%A6%9B%E0%A7%9F-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%A6%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%87</guid>
      <pubDate>Mon, 16 Nov 2026 04:55:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/75d4aebbd3b3e7ac9a872988b0a6d4b9-6afa282475cf4.jpg?jadewits_media_id=323026" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/75d4aebbd3b3e7ac9a872988b0a6d4b9-6afa282475cf4.jpg?jadewits_media_id=323026" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/75d4aebbd3b3e7ac9a872988b0a6d4b9-6afa282475cf4.jpg?jadewits_media_id=323026" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সরকারি টাকার নয়ছয় তিন প্রতিষ্ঠানে, দুদকের অভিযানে প্রমাণ" /&gt;&lt;/p&gt;&lt;p&gt;কোথাও সড়ক উন্নয়নকাজ না করেই বিল উত্তোলনের অভিযোগ, কোথাও ফাঁকা ভাউচার পূরণ করে প্রশিক্ষণ ব্যয়ের হিসাব তৈরি, আবার কোথাও হাসপাতালে রোগীদের নিম্নমানের খাবার সরবরাহ ও ওষুধের সংকট। সরকারি অর্থ ব্যবহারে এমন নানা অনিয়মের অভিযোগে সাভার, খুলনা ও ঝিনাইদহের তিনটি সরকারি প্রতিষ্ঠানে অভিযান চালিয়েছে দুর্নীতি দমন &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821213/%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A7%9F%E0%A6%9B%E0%A7%9F-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%A6%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>গোপালগঞ্জে আওয়ামী লীগ নেতাকর্মীদের বিরুদ্ধে বিএনপি নেতার মামলা</title>
      <link>https://www.ittefaq.com.bd/821212/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821212/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF</guid>
      <pubDate>Mon, 16 Nov 2026 04:29:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/0551c19b960f7df9c8864511ee92acb7-6afa26bdbb75b.jpg?jadewits_media_id=323025" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/0551c19b960f7df9c8864511ee92acb7-6afa26bdbb75b.jpg?jadewits_media_id=323025" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/0551c19b960f7df9c8864511ee92acb7-6afa26bdbb75b.jpg?jadewits_media_id=323025" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গোপালগঞ্জে আওয়ামী লীগ নেতাকর্মীদের বিরুদ্ধে বিএনপি নেতার মামলা" /&gt;&lt;/p&gt;&lt;p&gt;ককটেল বিস্ফোরণ ও নাশকতার পরিকল্পনার অভিযোগে গোপালগঞ্জের মুকসুদপুরে কার্যক্রম নিষিদ্ধ আওয়ামী লীগ ও সহযোগী সংগঠনের ৫৩ নেতাকর্মীর বিরুদ্ধে মামলা হয়েছে।
রোববার (১৫ নভেম্বর) দুপুরে মুকসুদপুর থানার ভারপ্রাপ্ত কর্মকর্তা (ওসি) আব্দুল্লাহ আল মামুন বিষয়টি নিশ্চিত করেছেন। তিনি বলেন, শনিবার দুপুরে মামলাটি কর&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821212/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF">দৈনিক ইত্তেফাক</source>
    </item>
    <item>

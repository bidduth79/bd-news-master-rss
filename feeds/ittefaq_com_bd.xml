    <item>
      <title>জামানত ছাড়াই সর্বোচ্চ ২০ লাখ টাকার সুবিধা: ৬৪০ তরুণ উদ্যোক্তা চূড়ান্ত করলো বাংলাদেশ ব্যাংক</title>
      <link>https://www.ittefaq.com.bd/823197/%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%A4-%E0%A6%9B%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A6%BE%E0%A6%87-%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A7%8B%E0%A6%9A%E0%A7%8D%E0%A6%9A-%E0%A7%A8%E0%A7%A6-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%81%E0%A6%AC%E0%A6%BF%E0%A6%A7%E0%A6%BE-%E0%A7%AC%E0%A7%AA%E0%A7%A6</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823197/%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%A4-%E0%A6%9B%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A6%BE%E0%A6%87-%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A7%8B%E0%A6%9A%E0%A7%8D%E0%A6%9A-%E0%A7%A8%E0%A7%A6-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%81%E0%A6%AC%E0%A6%BF%E0%A6%A7%E0%A6%BE-%E0%A7%AC%E0%A7%AA%E0%A7%A6</guid>
      <pubDate>Fri, 27 Nov 2026 02:33:25 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/f742e5777338aaa3a0ea9a4153795332-6b08975a3ac1a.jpg?jadewits_media_id=325089" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/f742e5777338aaa3a0ea9a4153795332-6b08975a3ac1a.jpg?jadewits_media_id=325089" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/f742e5777338aaa3a0ea9a4153795332-6b08975a3ac1a.jpg?jadewits_media_id=325089" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জামানত ছাড়াই সর্বোচ্চ ২০ লাখ টাকার সুবিধা: ৬৪০ তরুণ উদ্যোক্তা চূড়ান্ত করলো বাংলাদেশ ব্যাংক" /&gt;&lt;/p&gt;&lt;p&gt;দেশের গ্রামীণ ও উপজেলা পর্যায়ে নতুন উদ্যোক্তা তৈরি এবং কর্মসংস্থানের সুযোগ বাড়াতে &amp;lsquo;উদ্যোগ&amp;rsquo; কর্মসূচির প্রথম ধাপে ৬৪০ জন তরুণকে চূড়ান্তভাবে নির্বাচন করেছে বাংলাদেশ ব্যাংক। 
বৃহস্পতিবার (২৬ নভেম্বর) কেন্দ্রীয় ব্যাংকের ওয়েবসাইটে এই তালিকা প্রকাশ করা হয়। নির্বাচিত উদ্যোক্তারা জামানত ছাড&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823197/%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%A4-%E0%A6%9B%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A6%BE%E0%A6%87-%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A7%8B%E0%A6%9A%E0%A7%8D%E0%A6%9A-%E0%A7%A8%E0%A7%A6-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%81%E0%A6%AC%E0%A6%BF%E0%A6%A7%E0%A6%BE-%E0%A7%AC%E0%A7%AA%E0%A7%A6">দৈনিক ইত্তেফাক</source>
    </item>
    <item>

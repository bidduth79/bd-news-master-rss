      <guid isPermaLink="true">https://www.ittefaq.com.bd/821592/%E0%A7%A8%E0%A6%9F%E0%A6%BF-%E0%A6%97%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B8-%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B2%E0%A7%8D%E0%A6%A1-%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A7%80%E0%A6%95%E0%A7%83%E0%A6%A4%E0%A6%BF-%E0%A6%AA%E0%A7%87%E0%A6%B2%E0%A7%8B-%E0%A6%AE%E0%A6%95%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Wed, 18 Nov 2026 01:04:03 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/7e31d3f6fe6770a4b8ea16c53b79ee98-6afca509c351c.jpg?jadewits_media_id=323418" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/7e31d3f6fe6770a4b8ea16c53b79ee98-6afca509c351c.jpg?jadewits_media_id=323418" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/7e31d3f6fe6770a4b8ea16c53b79ee98-6afca509c351c.jpg?jadewits_media_id=323418" style="max-width:100%;height:auto;margin-bottom:10px;" alt="২টি গিনেস ওয়ার্ল্ড রেকর্ডের স্বীকৃতি পেলো মক্কার ক্লক টাওয়ার" /&gt;&lt;/p&gt;&lt;p&gt;সৌদি আরবের মক্কায় অবস্থিত বিখ্যাত ক্লক টাওয়ার নতুন করে দুটি গিনেস ওয়ার্ল্ড রেকর্ডের স্বীকৃতি পেয়েছে। ভবনের ভেতরে সর্বোচ্চ উচ্চতায় অবস্থিত জাদুঘর এবং বিশ্বের সর্বোচ্চ উন্মুক্ত পর্যবেক্ষণ ডেকের স্বীকৃতি পেয়েছে স্থাপনাটি। এ নিয়ে ক্লক টাওয়ারের গিনেস রেকর্ডের সংখ্যা দাঁড়াল অন্তত পাঁচটিতে।
মক্কা সিটি ও পব&lt;/p&gt;</description>

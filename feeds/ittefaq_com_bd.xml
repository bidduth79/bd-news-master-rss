      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/7dac215ff7c8ee414b619951cc04fe7c-6af577a2c4351.png?jadewits_media_id=322320" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/7dac215ff7c8ee414b619951cc04fe7c-6af577a2c4351.png?jadewits_media_id=322320" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/7dac215ff7c8ee414b619951cc04fe7c-6af577a2c4351.png?jadewits_media_id=322320" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মুন্সীগঞ্জে বিএনপির দুই পক্ষের সংঘর্ষে গুলিবিদ্ধ ৫" /&gt;&lt;/p&gt;&lt;p&gt;আসন্ন ইউনিয়ন পরিষদ (ইউপি) নির্বাচনকে সামনে রেখে এলাকায় আধিপত্য বিস্তার নিয়ে মুন্সীগঞ্জ সদরের মোল্লাকান্দি ইউনিয়নে বিএনপির দুই পক্ষের মধ্যে রাতভর হামলা, সংঘর্ষ ও ককটেল বিস্ফোরণের ঘটনা ঘটেছে। এতে পাঁচজন গুলিবিদ্ধসহ অন্তত ১০ জন আহত হয়েছেন। সংঘর্ষ চলাকালে পরিস্থিতি নিয়ন্ত্রণ করতে যাওয়া পুলিশের পি&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820536/%E0%A6%AE%E0%A7%81%E0%A6%A8%E0%A7%8D%E0%A6%B8%E0%A7%80%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%AA%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A7%87-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A7%AB">দৈনিক ইত্তেফাক</source>

    <item>
      <title>রুমিন ফারহানার সঙ্গে বাদানুবাদ, সরাইল থানার সেই ওসিকে বদলি</title>
      <link>https://www.ittefaq.com.bd/820440/%E0%A6%B0%E0%A7%81%E0%A6%AE%E0%A6%BF%E0%A6%A8-%E0%A6%AB%E0%A6%BE%E0%A6%B0%E0%A6%B9%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%AC%E0%A6%BE%E0%A6%A6-%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%87%E0%A6%B2-%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%87%E0%A6%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820440/%E0%A6%B0%E0%A7%81%E0%A6%AE%E0%A6%BF%E0%A6%A8-%E0%A6%AB%E0%A6%BE%E0%A6%B0%E0%A6%B9%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%AC%E0%A6%BE%E0%A6%A6-%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%87%E0%A6%B2-%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%87%E0%A6%87</guid>

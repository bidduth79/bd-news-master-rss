    <item>
      <title>ঢাকার বস্তির ৮৯ শতাংশ পরিবার বহুমাত্রিক দারিদ্র্যের শিকার</title>
      <link>https://www.ittefaq.com.bd/820460/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A7%AE%E0%A7%AF-%E0%A6%B6%E0%A6%A4%E0%A6%BE%E0%A6%82%E0%A6%B6-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820460/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A7%AE%E0%A7%AF-%E0%A6%B6%E0%A6%A4%E0%A6%BE%E0%A6%82%E0%A6%B6-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95</guid>
      <pubDate>Thu, 12 Nov 2026 02:35:59 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/61aa9bf9d5c62b78529f283dfb132bdb-6af4d18866005.jpg?jadewits_media_id=322248" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/61aa9bf9d5c62b78529f283dfb132bdb-6af4d18866005.jpg?jadewits_media_id=322248" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/61aa9bf9d5c62b78529f283dfb132bdb-6af4d18866005.jpg?jadewits_media_id=322248" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঢাকার বস্তির ৮৯ শতাংশ পরিবার বহুমাত্রিক দারিদ্র্যের শিকার" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর বস্তিতে বসবাসকারী ৮৯ শতাংশ পরিবার বহুমাত্রিক দারিদ্র্যে ভুগছে। অর্থাৎ এখানে প্রতি ১০টি পরিবারের ৯টি দরিদ্র। আবাসন, পানি, স্যানিটেশন, স্বাস্থ্য ও শিক্ষার মতো প্রায় সব সূচকে বস্তির মানুষ গভীর সংকটের মধ্যে রয়েছে। এছাড়া বস্তির অর্ধেকের বেশি মানুষ সার্বক্ষণিক উচ্ছেদের আতঙ্কে থাকে।
&amp;lsquo;বাংল&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820460/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A7%AE%E0%A7%AF-%E0%A6%B6%E0%A6%A4%E0%A6%BE%E0%A6%82%E0%A6%B6-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95">দৈনিক ইত্তেফাক</source>

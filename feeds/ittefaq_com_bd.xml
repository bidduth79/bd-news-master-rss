    <item>
      <title>সাময়িক বরখাস্ত হলেন এসপি জাহাঙ্গীর</title>
      <link>https://www.ittefaq.com.bd/821533/%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A7%9F%E0%A6%BF%E0%A6%95-%E0%A6%AC%E0%A6%B0%E0%A6%96%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4-%E0%A6%B9%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%8F%E0%A6%B8%E0%A6%AA%E0%A6%BF-%E0%A6%9C%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%80%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821533/%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A7%9F%E0%A6%BF%E0%A6%95-%E0%A6%AC%E0%A6%B0%E0%A6%96%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4-%E0%A6%B9%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%8F%E0%A6%B8%E0%A6%AA%E0%A6%BF-%E0%A6%9C%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%80%E0%A6%B0</guid>
      <pubDate>Tue, 17 Nov 2026 18:34:10 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/66e90a3e956cc96c0006081fffacb3f7-6afc46ea7a835.jpg?jadewits_media_id=323350" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/66e90a3e956cc96c0006081fffacb3f7-6afc46ea7a835.jpg?jadewits_media_id=323350" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/66e90a3e956cc96c0006081fffacb3f7-6afc46ea7a835.jpg?jadewits_media_id=323350" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাময়িক বরখাস্ত হলেন এসপি জাহাঙ্গীর" /&gt;&lt;/p&gt;&lt;p&gt;কার্যক্রম নিষিদ্ধ আওয়ামী লীগের সঙ্গে যোগাযোগ এবং পুলিশের অভ্যন্তরীণ ও স্পর্শকাতর তথ্য সরবরাহের অভিযোগে পুলিশ সুপার (এসপি) মো. জাহাঙ্গীর আলমকে সাময়িক বরখাস্ত করা হয়েছে।
মঙ্গলবার (১৭ নভেম্বর) স্বরাষ্ট্র মন্ত্রণালয় থেকে জারি করা এক প্রজ্ঞাপনে এ তথ্য জানানো হয়। রাষ্ট্রপতির আদেশক্রমে প্রজ্ঞাপনটিতে সই করে&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821533/%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A7%9F%E0%A6%BF%E0%A6%95-%E0%A6%AC%E0%A6%B0%E0%A6%96%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4-%E0%A6%B9%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%8F%E0%A6%B8%E0%A6%AA%E0%A6%BF-%E0%A6%9C%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%80%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>জুলাই জাদুঘরে শহীদদের সব স্মৃতিচিহ্ন প্রদর্শন হচ্ছে না: এমপি সানজিদা</title>
      <link>https://www.ittefaq.com.bd/821532/%E0%A6%9C%E0%A7%81%E0%A6%B2%E0%A6%BE%E0%A6%87-%E0%A6%9C%E0%A6%BE%E0%A6%A6%E0%A7%81%E0%A6%98%E0%A6%B0%E0%A7%87-%E0%A6%B6%E0%A6%B9%E0%A7%80%E0%A6%A6%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AC-%E0%A6%B8%E0%A7%8D%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A6%BF%E0%A6%9A%E0%A6%BF%E0%A6%B9%E0%A7%8D%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A6%B0%E0%A7%8D%E0%A6%B6%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821532/%E0%A6%9C%E0%A7%81%E0%A6%B2%E0%A6%BE%E0%A6%87-%E0%A6%9C%E0%A6%BE%E0%A6%A6%E0%A7%81%E0%A6%98%E0%A6%B0%E0%A7%87-%E0%A6%B6%E0%A6%B9%E0%A7%80%E0%A6%A6%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AC-%E0%A6%B8%E0%A7%8D%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A6%BF%E0%A6%9A%E0%A6%BF%E0%A6%B9%E0%A7%8D%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A6%B0%E0%A7%8D%E0%A6%B6%E0%A6%A8</guid>
      <pubDate>Tue, 17 Nov 2026 18:29:21 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/db0c7bbf07b85d17361930e35fd787cc-6afc478ad0020.jpg?jadewits_media_id=323351" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/db0c7bbf07b85d17361930e35fd787cc-6afc478ad0020.jpg?jadewits_media_id=323351" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/db0c7bbf07b85d17361930e35fd787cc-6afc478ad0020.jpg?jadewits_media_id=323351" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জুলাই জাদুঘরে শহীদদের সব স্মৃতিচিহ্ন প্রদর্শন হচ্ছে না: এমপি সানজিদা" /&gt;&lt;/p&gt;&lt;p&gt;জুলাই গণ-অভ্যুত্থানে শহীদ, গুম ও বিচারবহির্ভূত হত্যাকাণ্ডের শিকার ব্যক্তিদের ব্যবহৃত সব স্মৃতিচিহ্ন &amp;lsquo;জুলাই গণ-অভ্যুত্থান স্মৃতি জাদুঘরে&amp;rsquo; যথাযথভাবে সংরক্ষণ ও প্রদর্শন করা হচ্ছে না বলে সংসদে অভিযোগ তুলেছেন সংরক্ষিত নারী আসনের সংসদ সদস্য সানজিদা ইয়াসমিন তুলি।
তিনি বলেন, শহীদদের রক্তমাখা শা&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821532/%E0%A6%9C%E0%A7%81%E0%A6%B2%E0%A6%BE%E0%A6%87-%E0%A6%9C%E0%A6%BE%E0%A6%A6%E0%A7%81%E0%A6%98%E0%A6%B0%E0%A7%87-%E0%A6%B6%E0%A6%B9%E0%A7%80%E0%A6%A6%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AC-%E0%A6%B8%E0%A7%8D%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A6%BF%E0%A6%9A%E0%A6%BF%E0%A6%B9%E0%A7%8D%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A6%B0%E0%A7%8D%E0%A6%B6%E0%A6%A8">দৈনিক ইত্তেফাক</source>

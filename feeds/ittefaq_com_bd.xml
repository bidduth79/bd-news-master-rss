      <guid isPermaLink="true">https://www.ittefaq.com.bd/821092/%E0%A6%A5%E0%A7%8D%E0%A6%B0%E0%A6%BF-%E0%A6%87%E0%A6%A1%E0%A6%BF%E0%A7%9F%E0%A6%9F%E0%A6%B8%E0%A7%87%E0%A6%B0-%E2%80%98%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%AC-%E0%A6%9A%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%B0%E2%80%99-%E0%A6%B8%E0%A7%8B%E0%A6%A8%E0%A6%AE-%E0%A6%93%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%82%E0%A6%9A%E0%A7%81%E0%A6%95</guid>

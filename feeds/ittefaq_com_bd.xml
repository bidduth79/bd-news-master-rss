    <item>
      <title>রামগঞ্জে সড়কের পাশে পার্কিং করা বাসে আগুন</title>
      <link>https://www.ittefaq.com.bd/823056/%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%B8%E0%A7%9C%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%BE%E0%A6%B6%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%82-%E0%A6%95%E0%A6%B0%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823056/%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%B8%E0%A7%9C%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%BE%E0%A6%B6%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%82-%E0%A6%95%E0%A6%B0%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</guid>
      <pubDate>Thu, 26 Nov 2026 10:44:09 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/d1f0e786bd6e9de8e723df3aff939747-6b07b8f25dcaf.png?jadewits_media_id=324930" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/d1f0e786bd6e9de8e723df3aff939747-6b07b8f25dcaf.png?jadewits_media_id=324930" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/d1f0e786bd6e9de8e723df3aff939747-6b07b8f25dcaf.png?jadewits_media_id=324930" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রামগঞ্জে সড়কের পাশে পার্কিং করা বাসে আগুন" /&gt;&lt;/p&gt;&lt;p&gt;ফজরের নামাজ আদায় করতে বাস থেকে নেমেছিলেন হেলপার। এর কিছুক্ষণ পর ফিরে এসে দেখেন, দাউ দাউ করে জ্বলছে বাসটি। বৃহস্পতিবার (২৬ নভেম্বর) ভোরে লক্ষ্মীপুরের রামগঞ্জ বাসস্ট্যান্ডের রেস্ট হাউসের সামনে এ অগ্নিকাণ্ডের ঘটনা ঘটে। এতে বাসটি পুড়ে যাওয়ার পাশাপাশি পাশের একটি দোকানের সাইনবোর্ড ও সিসিটিভি ক্যামেরাও ক্ষ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823056/%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%B8%E0%A7%9C%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%BE%E0%A6%B6%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%82-%E0%A6%95%E0%A6%B0%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>মধ্যপ্রাচ্যে সংঘাত: বিশ্ববাজারে ফের বাড়ল তেলের দাম</title>
      <link>https://www.ittefaq.com.bd/823055/%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%BE%E0%A6%A4-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%B2-%E0%A6%A4%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823055/%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%BE%E0%A6%A4-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%B2-%E0%A6%A4%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE</guid>
      <pubDate>Thu, 26 Nov 2026 10:34:43 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/b57b483aaf3ec9534ded3884e516b25c-6b07b5e6c4bf7.jpg?jadewits_media_id=324929" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/b57b483aaf3ec9534ded3884e516b25c-6b07b5e6c4bf7.jpg?jadewits_media_id=324929" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/b57b483aaf3ec9534ded3884e516b25c-6b07b5e6c4bf7.jpg?jadewits_media_id=324929" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মধ্যপ্রাচ্যে সংঘাত: বিশ্ববাজারে ফের বাড়ল তেলের দাম" /&gt;&lt;/p&gt;&lt;p&gt;মধ্যপ্রাচ্যে নতুন করে সংঘাত ছড়িয়ে পড়ায় বিশ্ববাজারে অপরিশোধিত জ্বালানি তেলের দাম টানা দ্বিতীয় দিনের মতো বেড়েছে। উপসাগরীয় অঞ্চল থেকে তেল রপ্তানি স্বাভাবিক হওয়া নিয়ে নতুন করে উদ্বেগ তৈরি হয়েছে। বিশেষ করে সৌদি আরবে ইয়েমেনের হুথি বিদ্রোহীদের হামলা এবং হরমুজ প্রণালিতে জাহাজে মাইন বিস্ফোরণের খবরে তেলের বাজ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823055/%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%BE%E0%A6%A4-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%B2-%E0%A6%A4%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>গাজীপুরে কাজে ফিরছেন পোশাকশ্রমিকেরা, মাঠে ৩২ প্লাটুন আইনশৃঙ্খলা বাহিনী</title>
      <link>https://www.ittefaq.com.bd/823054/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A7%80%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%9C%E0%A7%87-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%AA%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%95%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%B0%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%A0%E0%A7%87-%E0%A7%A9%E0%A7%A8</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823054/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A7%80%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%9C%E0%A7%87-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%AA%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%95%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%B0%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%A0%E0%A7%87-%E0%A7%A9%E0%A7%A8</guid>
      <pubDate>Thu, 26 Nov 2026 10:30:42 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/84316109c437cdcc7adb369ed0e36d1d-6b07b52cd1ce0.jpg?jadewits_media_id=324928" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/84316109c437cdcc7adb369ed0e36d1d-6b07b52cd1ce0.jpg?jadewits_media_id=324928" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/84316109c437cdcc7adb369ed0e36d1d-6b07b52cd1ce0.jpg?jadewits_media_id=324928" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গাজীপুরে কাজে ফিরছেন পোশাকশ্রমিকেরা, মাঠে ৩২ প্লাটুন আইনশৃঙ্খলা বাহিনী" /&gt;&lt;/p&gt;&lt;p&gt;ন্যূনতম মজুরি বাড়ানোর দাবিতে শ্রমিক অসন্তোষের মধ্যে গাজীপুরের শিল্পাঞ্চলে কাজে ফিরতে শুরু করেছেন পোশাকশ্রমিকেরা। বৃহস্পতিবার সকালে বিভিন্ন কারখানায় শ্রমিকদের কাজে যোগ দিতে দেখা গেছে। সকাল সাড়ে ৮টা পর্যন্ত শিল্পাঞ্চলের কোথাও বিক্ষোভ বা সড়ক-মহাসড়ক অবরোধের খবর পাওয়া যায়নি। তবে এখনো বেশ কিছু কারখানা বন্&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823054/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A7%80%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%9C%E0%A7%87-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%AA%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%95%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%B0%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%A0%E0%A7%87-%E0%A7%A9%E0%A7%A8">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>ভারতের ওপর নজর রাখতে স্যাটেলাইট নেটওয়ার্ক গড়ে তুলছে পাকিস্তান ও চীন</title>
      <link>https://www.ittefaq.com.bd/823053/%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%A8%E0%A6%9C%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A6%96%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9F%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%9F-%E0%A6%A8%E0%A7%87%E0%A6%9F%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95-%E0%A6%97%E0%A7%9C%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823053/%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%A8%E0%A6%9C%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A6%96%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9F%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%9F-%E0%A6%A8%E0%A7%87%E0%A6%9F%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95-%E0%A6%97%E0%A7%9C%E0%A7%87</guid>
      <pubDate>Thu, 26 Nov 2026 10:28:44 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/2a61fcc02a55df51c4074740db396977-6b07b4400a61d.jpg?jadewits_media_id=324927" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/2a61fcc02a55df51c4074740db396977-6b07b4400a61d.jpg?jadewits_media_id=324927" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/2a61fcc02a55df51c4074740db396977-6b07b4400a61d.jpg?jadewits_media_id=324927" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভারতের ওপর নজর রাখতে স্যাটেলাইট নেটওয়ার্ক গড়ে তুলছে পাকিস্তান ও চীন" /&gt;&lt;/p&gt;&lt;p&gt;চীন ও পাকিস্তানের যৌথ মহাকাশ সক্ষমতা ভারতের সামরিক ও কৌশলগত স্থাপনাগুলোর ওপর আরও বিস্তৃত নজরদারির সুযোগ তৈরি করছে। দুই দেশ এমন একটি সমন্বিত স্যাটেলাইট নেটওয়ার্ক গড়ে তুলছে, যার মাধ্যমে ভারতের বিভিন্ন অঞ্চলে ধারাবাহিকভাবে পর্যবেক্ষণ চালানো সম্ভব হতে পারে। ২০২৫ সালে ভারত ও পাকিস্তানের সামরিক সংঘাতের সম&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823053/%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%A8%E0%A6%9C%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A6%96%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9F%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%9F-%E0%A6%A8%E0%A7%87%E0%A6%9F%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95-%E0%A6%97%E0%A7%9C%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>ইরানের প্রতিনিধিদের সঙ্গে গোপন বৈঠক, মুখ খুললেন ট্রাম্পের বিশেষ দূত</title>

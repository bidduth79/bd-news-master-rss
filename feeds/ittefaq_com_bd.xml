      <guid isPermaLink="true">https://www.ittefaq.com.bd/821904/%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%B0</guid>
      <pubDate>Thu, 19 Nov 2026 17:05:25 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/41f0cd99fec7ea74cd3028824493a9c2-6afed7b1a0b7b.jpg?jadewits_media_id=323738" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/41f0cd99fec7ea74cd3028824493a9c2-6afed7b1a0b7b.jpg?jadewits_media_id=323738" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/41f0cd99fec7ea74cd3028824493a9c2-6afed7b1a0b7b.jpg?jadewits_media_id=323738" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মিয়ানমারে হাজার হাজার রোহিঙ্গাকে হত্যা, নারী-শিশুর ওপর যৌন সহিংসতার প্রমাণ মিলেছে" /&gt;&lt;/p&gt;&lt;p&gt;মিয়ানমারের নিরাপত্তা বাহিনীর সদস্যরা দেশটির সংখ্যালঘু মুসলিম রোহিঙ্গা জনগোষ্ঠীর হাজার হাজার সদস্যকে হত্যা করেছে। শুধু তাই নয়, এমনকি রোহিঙ্গা নারী ও শিশুদের ওপর ব্যাপক যৌন সহিংসতা চালিয়েছে।&amp;nbsp;
বৃহস্পতিবার (১৯ নভেম্বর) জাতিসংঘের আওতাধীন আন্তর্জাতিক বিচার আদালতের (আইসিজে) বিচারকরা বহুল আলোচিত এই মাম&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821904/%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>

    <item>
      <title>সেমিতে প্রথমার্ধে গোলশূন্য বাংলাদেশ-পাকিস্তান</title>
      <link>https://www.ittefaq.com.bd/821008/%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%97%E0%A7%8B%E0%A6%B2%E0%A6%B6%E0%A7%82%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821008/%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%97%E0%A7%8B%E0%A6%B2%E0%A6%B6%E0%A7%82%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8</guid>
      <pubDate>Sat, 14 Nov 2026 22:27:15 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/4d5a95b9c34467a383551ca1a900c42f-6af88bbc39220.jpg?jadewits_media_id=322811" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/4d5a95b9c34467a383551ca1a900c42f-6af88bbc39220.jpg?jadewits_media_id=322811" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/4d5a95b9c34467a383551ca1a900c42f-6af88bbc39220.jpg?jadewits_media_id=322811" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সেমিতে প্রথমার্ধে গোলশূন্য বাংলাদেশ-পাকিস্তান" /&gt;&lt;/p&gt;&lt;p&gt;এবারের সাফ চ্যাম্পিয়নশিপের দ্বিতীয় সেমি ফাইনালে পাকিস্তানের মুখোমুখি হয়েছে বাংলাদেশ। ম্যাচের প্রথমার্ধে একাধিক গোলের সুযোগ তৈরি করলেও জালে দেখা পায়নি কোনো দলই। গোল না পেলেও ম্যাচে বলের দখল কিংবা আক্রমণ সব জায়গায় কিছুটা এগিয়ে ছিল স্বাগতিকরা।
জাতীয় স্টেডিয়ামের গ্যালারিতে &amp;lsquo;বাংলাদেশ, বাংলাদেশ&amp;rsqu&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821008/%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%97%E0%A7%8B%E0%A6%B2%E0%A6%B6%E0%A7%82%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>পর্তুগালে সড়ক দুর্ঘটনায় ১০ দিন কোমায় থাকার পর বাংলাদেশি তরুণের মৃত্যু</title>
      <link>https://www.ittefaq.com.bd/821007/%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A7%81%E0%A6%97%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%B8%E0%A6%A1%E0%A6%BC%E0%A6%95-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A7%A7%E0%A7%A6-%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%95%E0%A7%8B%E0%A6%AE%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821007/%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A7%81%E0%A6%97%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%B8%E0%A6%A1%E0%A6%BC%E0%A6%95-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A7%A7%E0%A7%A6-%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%95%E0%A7%8B%E0%A6%AE%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%B0</guid>
      <pubDate>Sat, 14 Nov 2026 22:13:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/7bb16081659c26710fff312f1806fbd4-6af8884fa224e.jpg?jadewits_media_id=322810" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/7bb16081659c26710fff312f1806fbd4-6af8884fa224e.jpg?jadewits_media_id=322810" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/7bb16081659c26710fff312f1806fbd4-6af8884fa224e.jpg?jadewits_media_id=322810" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পর্তুগালে সড়ক দুর্ঘটনায় ১০ দিন কোমায় থাকার পর বাংলাদেশি তরুণের মৃত্যু" /&gt;&lt;/p&gt;&lt;p&gt;পর্তুগালে এক মর্মান্তিক সড়ক দুর্ঘটনায় গুরুতর আহত হয়ে টানা ১০ দিন কোমায় থাকার পর রাহাত নামের এক বাংলাদেশি তরুণের মৃত্যু হয়েছে। শুক্রবার (১৩ নভেম্বর) স্থানীয় সময় সন্ধ্যা সাড়ে ৬টায় রাজধানী লিসবনের একটি হাসপাতালে চিকিৎসাধীন অবস্থায় তিনি শেষ নিশ্বাস ত্যাগ করেন।
নিহত রাহাত বাংলাদেশের গাজীপুর জেল&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821007/%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A7%81%E0%A6%97%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%B8%E0%A6%A1%E0%A6%BC%E0%A6%95-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A7%A7%E0%A7%A6-%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%95%E0%A7%8B%E0%A6%AE%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>‘সন্ত্রাসী’ জুয়েলের বাড়িতে অভিযান, মিললো বিদেশি পিস্তল ও গুলি</title>
      <link>https://www.ittefaq.com.bd/821006/%E2%80%98%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A7%80%E2%80%99-%E0%A6%9C%E0%A7%81%E0%A7%9F%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2%E0%A7%8B-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821006/%E2%80%98%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A7%80%E2%80%99-%E0%A6%9C%E0%A7%81%E0%A7%9F%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2%E0%A7%8B-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF</guid>
      <pubDate>Sat, 14 Nov 2026 22:06:53 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/0c8d86c71cb45897335cfce7bfbbf7bf-6af886459ac5e.jpg?jadewits_media_id=322809" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/0c8d86c71cb45897335cfce7bfbbf7bf-6af886459ac5e.jpg?jadewits_media_id=322809" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/0c8d86c71cb45897335cfce7bfbbf7bf-6af886459ac5e.jpg?jadewits_media_id=322809" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘সন্ত্রাসী’ জুয়েলের বাড়িতে অভিযান, মিললো বিদেশি পিস্তল ও গুলি" /&gt;&lt;/p&gt;&lt;p&gt;যশোরে পুলিশের তালিকাভুক্ত সন্ত্রাসী তৌহিদুর রহমান জুয়েলের বাড়িতে অভিযান চালিয়ে একটি বিদেশি পিস্তল, দুটি ম্যাগাজিন, পাঁচ রাউন্ড গুলি উদ্ধার করেছে ডিবি পুলিশ।
শনিবার (১৪ নভেম্বর) সন্ধ্যায় এ তথ্যের সত্যতা নিশ্চিত করেছেন জেলা গোয়েন্দা শাখার ভারপ্রাপ্ত কর্মকর্তা (ওসি) । এর আগে এদিন ভোরে সদর উপজেলার শেখহা&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821006/%E2%80%98%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A7%80%E2%80%99-%E0%A6%9C%E0%A7%81%E0%A7%9F%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2%E0%A7%8B-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>জলবায়ু সহনশীলতা বাড়াতে বাংলাদেশকে ৩ কোটি ডলার দিচ্ছে সিআইএফ</title>
      <link>https://www.ittefaq.com.bd/821005/%E0%A6%9C%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A7%81-%E0%A6%B8%E0%A6%B9%E0%A6%A8%E0%A6%B6%E0%A7%80%E0%A6%B2%E0%A6%A4%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%95%E0%A7%87-%E0%A7%A9-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%A1%E0%A6%B2%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821005/%E0%A6%9C%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A7%81-%E0%A6%B8%E0%A6%B9%E0%A6%A8%E0%A6%B6%E0%A7%80%E0%A6%B2%E0%A6%A4%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%95%E0%A7%87-%E0%A7%A9-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%A1%E0%A6%B2%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Sat, 14 Nov 2026 21:59:18 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/a88c529b54c96567c545f56861154826-6af8852a3f0ea.jpg?jadewits_media_id=322808" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/a88c529b54c96567c545f56861154826-6af8852a3f0ea.jpg?jadewits_media_id=322808" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/a88c529b54c96567c545f56861154826-6af8852a3f0ea.jpg?jadewits_media_id=322808" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জলবায়ু সহনশীলতা বাড়াতে বাংলাদেশকে ৩ কোটি ডলার দিচ্ছে সিআইএফ" /&gt;&lt;/p&gt;&lt;p&gt;জলবায়ু পরিবর্তনের অভিঘাত মোকাবিলা ও দেশের জলবায়ু সহনশীলতা বাড়াতে বাংলাদেশকে ৩ কোটি মার্কিন ডলার অর্থায়ন দেওয়ার ঘোষণা দিয়েছে ক্লাইমেট ইনভেস্টমেন্ট ফান্ডস (সিআইএফ)।
এ অর্থ ছাড়ের প্রক্রিয়া, অগ্রাধিকারভিত্তিক প্রকল্প নির্বাচন ও ভবিষ্যৎ সহযোগিতা নিয়ে সংস্থাটির শীর্ষ কর্মকর্তাদের সঙ্গে বৈঠক করেছেন পরিবেশ,&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821005/%E0%A6%9C%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A7%81-%E0%A6%B8%E0%A6%B9%E0%A6%A8%E0%A6%B6%E0%A7%80%E0%A6%B2%E0%A6%A4%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%95%E0%A7%87-%E0%A7%A9-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%A1%E0%A6%B2%E0%A6%BE%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>

    <item>
      <title>আইনশৃঙ্খলা বাহিনীর ভেতরে নজরদারি, এসপিসহ গ্রেপ্তার ৩</title>
      <link>https://www.ittefaq.com.bd/823191/%E0%A6%86%E0%A6%87%E0%A6%A8%E0%A6%B6%E0%A7%83%E0%A6%99%E0%A7%8D%E0%A6%96%E0%A6%B2%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%AD%E0%A7%87%E0%A6%A4%E0%A6%B0%E0%A7%87%C2%A0%E0%A6%A8%E0%A6%9C%E0%A6%B0%E0%A6%A6%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%8F%E0%A6%B8%E0%A6%AA%E0%A6%BF%E0%A6%B8%E0%A6%B9-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823191/%E0%A6%86%E0%A6%87%E0%A6%A8%E0%A6%B6%E0%A7%83%E0%A6%99%E0%A7%8D%E0%A6%96%E0%A6%B2%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%AD%E0%A7%87%E0%A6%A4%E0%A6%B0%E0%A7%87%C2%A0%E0%A6%A8%E0%A6%9C%E0%A6%B0%E0%A6%A6%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%8F%E0%A6%B8%E0%A6%AA%E0%A6%BF%E0%A6%B8%E0%A6%B9-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Fri, 27 Nov 2026 03:30:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/43116f7dfeed78a86a0f9db6b86487d7-6b087f1107f5f.jpg?jadewits_media_id=325079" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/43116f7dfeed78a86a0f9db6b86487d7-6b087f1107f5f.jpg?jadewits_media_id=325079" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/43116f7dfeed78a86a0f9db6b86487d7-6b087f1107f5f.jpg?jadewits_media_id=325079" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আইনশৃঙ্খলা বাহিনীর ভেতরে নজরদারি, এসপিসহ গ্রেপ্তার ৩" /&gt;&lt;/p&gt;&lt;p&gt;ভারতে অবস্থানরত ক্ষমতাচ্যুত প্রধানমন্ত্রী শেখ হাসিনার দেশে ফেরার ঘোষণা ও কার্যক্রম-নিষিদ্ধ আওয়ামী লীগের কর্মসূচি ঘিরে নাশকতার আশঙ্কায় নিরাপত্তা বাড়িয়েছে পুলিশ। একই সময়ে বাহিনীর ভেতরেও নজরদারি বাড়ানো হয়েছে। এই প্রক্রিয়ার অংশ হিসেবে একজন পুলিশ সুপার ও দুই জন অতিরিক্ত পুলিশ সুপারকে গ্রেফতার করা হয়েছে। &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823191/%E0%A6%86%E0%A6%87%E0%A6%A8%E0%A6%B6%E0%A7%83%E0%A6%99%E0%A7%8D%E0%A6%96%E0%A6%B2%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%AD%E0%A7%87%E0%A6%A4%E0%A6%B0%E0%A7%87%C2%A0%E0%A6%A8%E0%A6%9C%E0%A6%B0%E0%A6%A6%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%8F%E0%A6%B8%E0%A6%AA%E0%A6%BF%E0%A6%B8%E0%A6%B9-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0">দৈনিক ইত্তেফাক</source>

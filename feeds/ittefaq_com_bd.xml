    <item>
      <title>ফটিকছড়িতে ইয়াবাসহ তিন যুবক আটক</title>
      <link>https://www.ittefaq.com.bd/821030/%E0%A6%AB%E0%A6%9F%E0%A6%BF%E0%A6%95%E0%A6%9B%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%87%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%B9-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%95-%E0%A6%86%E0%A6%9F%E0%A6%95</link>

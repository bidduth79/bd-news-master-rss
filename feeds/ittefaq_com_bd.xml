    <item>
      <title>পিঁপড়ার ডিমেই বেঁচে থাকার স্বপ্ন, জীবিকা চলছে শতাধিক পরিবারের</title>
      <link>https://www.ittefaq.com.bd/820852/%E0%A6%AA%E0%A6%BF%E0%A6%81%E0%A6%AA%E0%A7%9C%E0%A6%BE%E0%A6%B0-%E0%A6%A1%E0%A6%BF%E0%A6%AE%E0%A7%87%E0%A6%87-%E0%A6%AC%E0%A7%87%E0%A6%81%E0%A6%9A%E0%A7%87-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%AA%E0%A7%8D%E0%A6%A8-%C2%A0%E0%A6%9C%E0%A7%80%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A6%BE-%E0%A6%9A%E0%A6%B2%E0%A6%9B%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820852/%E0%A6%AA%E0%A6%BF%E0%A6%81%E0%A6%AA%E0%A7%9C%E0%A6%BE%E0%A6%B0-%E0%A6%A1%E0%A6%BF%E0%A6%AE%E0%A7%87%E0%A6%87-%E0%A6%AC%E0%A7%87%E0%A6%81%E0%A6%9A%E0%A7%87-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%AA%E0%A7%8D%E0%A6%A8-%C2%A0%E0%A6%9C%E0%A7%80%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A6%BE-%E0%A6%9A%E0%A6%B2%E0%A6%9B%E0%A7%87</guid>
      <pubDate>Sat, 14 Nov 2026 05:00:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/ce21a49eca2965dbe2aa4f8cfa4cff69-6af7640aa7aa9.jpg?jadewits_media_id=322647" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/ce21a49eca2965dbe2aa4f8cfa4cff69-6af7640aa7aa9.jpg?jadewits_media_id=322647" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/ce21a49eca2965dbe2aa4f8cfa4cff69-6af7640aa7aa9.jpg?jadewits_media_id=322647" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পিঁপড়ার ডিমেই বেঁচে থাকার স্বপ্ন, জীবিকা চলছে শতাধিক পরিবারের" /&gt;&lt;/p&gt;&lt;p&gt;পাহাড়ের আঁকাবাঁকা পথ, ঘন বন আর উঁচু উঁচু গাছ। ভোরের আলো ফুটতেই জীবিকার সন্ধানে বনের গভীরে ছুটে চলেন তারা। কারো হাতে লম্বা বাঁশ, কারো কাঁধে ডিম রাখার ঝুড়ি। লক্ষ্য একটাই—গাছের ডালে পিঁপড়ার বাসা খুঁজে ডিম সংগ্রহ করা। দিন শেষে সেই ডিম বিক্রির টাকাতেই চলে সংসারের খরচ, জোটে পরিবারের মুখের খাবার। এভাবেই শে&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820852/%E0%A6%AA%E0%A6%BF%E0%A6%81%E0%A6%AA%E0%A7%9C%E0%A6%BE%E0%A6%B0-%E0%A6%A1%E0%A6%BF%E0%A6%AE%E0%A7%87%E0%A6%87-%E0%A6%AC%E0%A7%87%E0%A6%81%E0%A6%9A%E0%A7%87-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%AA%E0%A7%8D%E0%A6%A8-%C2%A0%E0%A6%9C%E0%A7%80%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A6%BE-%E0%A6%9A%E0%A6%B2%E0%A6%9B%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>বাংলাদেশের পেস আক্রমণ নিয়ে ভয় প্রোটিয়াদের</title>
      <link>https://www.ittefaq.com.bd/820859/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%87%E0%A6%B8-%E0%A6%86%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%A3-%E0%A6%A8%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%AD%E0%A7%9F-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%9F%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820859/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%87%E0%A6%B8-%E0%A6%86%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%A3-%E0%A6%A8%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%AD%E0%A7%9F-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%9F%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0</guid>

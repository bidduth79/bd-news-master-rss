    <item>
      <title>দেশেই স্বাস্থ্যমন্ত্রীর হার্টে বসানো হলো দুটি রিং</title>
      <link>https://www.ittefaq.com.bd/821172/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%87-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A7%8D%E0%A6%AF%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A7%87-%E0%A6%AC%E0%A6%B8%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%B9%E0%A6%B2%E0%A7%8B-%E0%A6%A6%E0%A7%81%E0%A6%9F%E0%A6%BF-%E0%A6%B0%E0%A6%BF%E0%A6%82</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821172/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%87-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A7%8D%E0%A6%AF%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A7%87-%E0%A6%AC%E0%A6%B8%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%B9%E0%A6%B2%E0%A7%8B-%E0%A6%A6%E0%A7%81%E0%A6%9F%E0%A6%BF-%E0%A6%B0%E0%A6%BF%E0%A6%82</guid>
      <pubDate>Sun, 15 Nov 2026 20:37:16 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/16de906d5381d49967f691ad7bce9564-6af9c2c5873a8.jpg?jadewits_media_id=322984" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/16de906d5381d49967f691ad7bce9564-6af9c2c5873a8.jpg?jadewits_media_id=322984" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/16de906d5381d49967f691ad7bce9564-6af9c2c5873a8.jpg?jadewits_media_id=322984" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দেশেই স্বাস্থ্যমন্ত্রীর হার্টে বসানো হলো দুটি রিং" /&gt;&lt;/p&gt;&lt;p&gt;স্বাস্থ্য ও পরিবার কল্যাণমন্ত্রী সরদার মো. সাখাওয়াত হোসেনের হৃদ্&amp;zwnj;যন্ত্রে সফলভাবে দুটি রিং (স্টেন্ট) পরানো হয়েছে। রোববার (১৫ নভেম্বর) বিকেলে রাজধানীর একটি হাসপাতালে তার হৃদ্&amp;zwnj;যন্ত্রের ব্লক দূর করতে এ চিকিৎসা সম্পন্ন হয়।
স্বাস্থ্য মন্ত্রণালয়ের তথ্য ও জনসংযোগ কর্মকর্তা পবন চৌধুরী এ তথ্য জানিয়ে&lt;/p&gt;</description>

    <item>
      <title>সাগরে ডুবিয়ে দেওয়া হলো টাইটানিক থেকে বড় মার্কিন জাহাজ ‘এসএস ইউনাইটেড স্টেটস’</title>
      <link>https://www.ittefaq.com.bd/820854/%E0%A6%B8%E0%A6%BE%E0%A6%97%E0%A6%B0%E0%A7%87-%E0%A6%A1%E0%A7%81%E0%A6%AC%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%B9%E0%A6%B2%E0%A7%8B-%E0%A6%9F%E0%A6%BE%E0%A6%87%E0%A6%9F%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%95-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A7%9C-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820854/%E0%A6%B8%E0%A6%BE%E0%A6%97%E0%A6%B0%E0%A7%87-%E0%A6%A1%E0%A7%81%E0%A6%AC%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%B9%E0%A6%B2%E0%A7%8B-%E0%A6%9F%E0%A6%BE%E0%A6%87%E0%A6%9F%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%95-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A7%9C-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8</guid>
      <pubDate>Sat, 14 Nov 2026 02:30:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/76b0f66dfc3d2a1ccfd0b49021078cfe-6af76ec781bb7.jpg?jadewits_media_id=322649" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/76b0f66dfc3d2a1ccfd0b49021078cfe-6af76ec781bb7.jpg?jadewits_media_id=322649" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/76b0f66dfc3d2a1ccfd0b49021078cfe-6af76ec781bb7.jpg?jadewits_media_id=322649" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাগরে ডুবিয়ে দেওয়া হলো টাইটানিক থেকে বড় মার্কিন জাহাজ ‘এসএস ইউনাইটেড স্টেটস’" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাষ্ট্রের ঐতিহাসিক যাত্রীবাহী জাহাজ ও বিশ্বের দ্রুততম সমুদ্রগামী প্রমোদতরী &amp;lsquo;এসএস ইউনাইটেড স্টেটস&amp;rsquo; তার বর্ণাঢ্য জীবনের ইতি টেনে তলিয়ে গেছে সমুদ্রের গভীরে। প্রায় এক হাজার ফুট (৩০২ মিটার) দীর্ঘ এই জাহাজটিকে ইচ্ছাকৃতভাবে ডুবিয়ে (&amp;lsquo;স্কাটলিং&amp;rsquo;) ফ্লোরিডার ডেস্টিন উপকূলের কাছে মেক&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820854/%E0%A6%B8%E0%A6%BE%E0%A6%97%E0%A6%B0%E0%A7%87-%E0%A6%A1%E0%A7%81%E0%A6%AC%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%B9%E0%A6%B2%E0%A7%8B-%E0%A6%9F%E0%A6%BE%E0%A6%87%E0%A6%9F%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%95-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A7%9C-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>কোন নারীর সঙ্গে কে গল্প করেছে, তা আমার নামে চালিয়ে দেওয়া হচ্ছে: আমির হামজা</title>
      <link>https://www.ittefaq.com.bd/820853/%E0%A6%95%E0%A7%8B%E0%A6%A8-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%95%E0%A7%87-%E0%A6%97%E0%A6%B2%E0%A7%8D%E0%A6%AA-%E0%A6%95%E0%A6%B0%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%A4%E0%A6%BE-%E0%A6%86%E0%A6%AE%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820853/%E0%A6%95%E0%A7%8B%E0%A6%A8-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%95%E0%A7%87-%E0%A6%97%E0%A6%B2%E0%A7%8D%E0%A6%AA-%E0%A6%95%E0%A6%B0%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%A4%E0%A6%BE-%E0%A6%86%E0%A6%AE%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A7%87</guid>
      <pubDate>Sat, 14 Nov 2026 01:58:37 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/751a881c1d4730d53948c753da8a19fe-6af76bb28a084.jpg?jadewits_media_id=322648" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/751a881c1d4730d53948c753da8a19fe-6af76bb28a084.jpg?jadewits_media_id=322648" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/751a881c1d4730d53948c753da8a19fe-6af76bb28a084.jpg?jadewits_media_id=322648" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কোন নারীর সঙ্গে কে গল্প করেছে, তা আমার নামে চালিয়ে দেওয়া হচ্ছে: আমির হামজা" /&gt;&lt;/p&gt;&lt;p&gt;কুরআনের মাহফিলে যারা প্রত্যক্ষ বা পরোক্ষভাবে বাধা দেয়, তারা মুসলমান হলেও তাদের জন্মের ঠিক নেই বলে মন্তব্য করেছেন কুষ্টিয়া-৩ আসনের সংসদ সদস্য আমির হামজা। শুক্রবার (১৩ নভেম্বর) বিকেলে ঝিনাইদহের কালীগঞ্জ শহরের সরকারি নলডাঙ্গা ভূষণ স্কুল মাঠে ফালাহুল উম্মাহ ক্যাডেট মাদ্রাসার উদ্যোগে আয়োজিত তাফসিরুল কু&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820853/%E0%A6%95%E0%A7%8B%E0%A6%A8-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%95%E0%A7%87-%E0%A6%97%E0%A6%B2%E0%A7%8D%E0%A6%AA-%E0%A6%95%E0%A6%B0%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%A4%E0%A6%BE-%E0%A6%86%E0%A6%AE%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>সাঘাটায় ফতেয়ার খাবার খেয়ে অসুস্থ সহস্রাধিক</title>
      <link>https://www.ittefaq.com.bd/820849/%E0%A6%B8%E0%A6%BE%E0%A6%98%E0%A6%BE%E0%A6%9F%E0%A6%BE%E0%A7%9F-%E0%A6%AB%E0%A6%A4%E0%A7%87%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%96%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B0%C2%A0%E0%A6%96%E0%A7%87%E0%A7%9F%E0%A7%87-%E0%A6%85%E0%A6%B8%E0%A7%81%E0%A6%B8%E0%A7%8D%E0%A6%A5-%E0%A6%B8%E0%A6%B9%E0%A6%B8%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A7%E0%A6%BF%E0%A6%95</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820849/%E0%A6%B8%E0%A6%BE%E0%A6%98%E0%A6%BE%E0%A6%9F%E0%A6%BE%E0%A7%9F-%E0%A6%AB%E0%A6%A4%E0%A7%87%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%96%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B0%C2%A0%E0%A6%96%E0%A7%87%E0%A7%9F%E0%A7%87-%E0%A6%85%E0%A6%B8%E0%A7%81%E0%A6%B8%E0%A7%8D%E0%A6%A5-%E0%A6%B8%E0%A6%B9%E0%A6%B8%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A7%E0%A6%BF%E0%A6%95</guid>
      <pubDate>Sat, 14 Nov 2026 01:28:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/5f707d726660a2bb24155afd78a44773-6af7605262909.jpg?jadewits_media_id=322646" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/5f707d726660a2bb24155afd78a44773-6af7605262909.jpg?jadewits_media_id=322646" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/5f707d726660a2bb24155afd78a44773-6af7605262909.jpg?jadewits_media_id=322646" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাঘাটায় ফতেয়ার খাবার খেয়ে অসুস্থ সহস্রাধিক" /&gt;&lt;/p&gt;&lt;p&gt;গাইবান্ধার সাঘাটা উপজেলায় ফতেয়ার (মজলিস) খাবার খেয়ে সহস্রাধিক নারী-পুরুষ ও শিশু অসুস্থ হয়ে পড়েছে। তারা এখন বিভিন্ন হাসপাতালে চিকিত্সাধীন রয়েছে। একসঙ্গে বিপুলসংখ্যক মানুষ অসুস্থ হয়ে পড়ার ঘটনায় এলাকায় আতঙ্ক ছড়িয়ে পড়েছে। বিশেষ করে শিশু, নারী ও বয়স্কদের স্বাস্থ্যঝুঁকি নিয়ে স্বজনরা উত্কণ্ঠায় পড়েছেন।
শুক্&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820849/%E0%A6%B8%E0%A6%BE%E0%A6%98%E0%A6%BE%E0%A6%9F%E0%A6%BE%E0%A7%9F-%E0%A6%AB%E0%A6%A4%E0%A7%87%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%96%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B0%C2%A0%E0%A6%96%E0%A7%87%E0%A7%9F%E0%A7%87-%E0%A6%85%E0%A6%B8%E0%A7%81%E0%A6%B8%E0%A7%8D%E0%A6%A5-%E0%A6%B8%E0%A6%B9%E0%A6%B8%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A7%E0%A6%BF%E0%A6%95">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>এইচএসসি সাপ্লিমেন্টারি পরীক্ষা: ১০ বোর্ডে ১ লাখ ৫৮ হাজার শিক্ষার্থীর আবেদন</title>
      <link>https://www.ittefaq.com.bd/820846/%E0%A6%8F%E0%A6%87%E0%A6%9A%E0%A6%8F%E0%A6%B8%E0%A6%B8%E0%A6%BF-%E0%A6%B8%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A6%BF%E0%A6%AE%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A7%A7%E0%A7%A6-%E0%A6%AC%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A7%87-%E0%A7%A7-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A7%AB%E0%A7%AE</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820846/%E0%A6%8F%E0%A6%87%E0%A6%9A%E0%A6%8F%E0%A6%B8%E0%A6%B8%E0%A6%BF-%E0%A6%B8%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A6%BF%E0%A6%AE%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A7%A7%E0%A7%A6-%E0%A6%AC%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A7%87-%E0%A7%A7-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A7%AB%E0%A7%AE</guid>
      <pubDate>Sat, 14 Nov 2026 01:03:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/0e8ecaf9513ce82ae4d9cda04719cf2b-6af75ba430a48.jpg?jadewits_media_id=322644" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/0e8ecaf9513ce82ae4d9cda04719cf2b-6af75ba430a48.jpg?jadewits_media_id=322644" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/0e8ecaf9513ce82ae4d9cda04719cf2b-6af75ba430a48.jpg?jadewits_media_id=322644" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এইচএসসি সাপ্লিমেন্টারি পরীক্ষা: ১০ বোর্ডে ১ লাখ ৫৮ হাজার শিক্ষার্থীর আবেদন" /&gt;&lt;/p&gt;&lt;p&gt;২০২৬ সালের এইচএসসি ও সমমান পরীক্ষার ফলাফলে রেকর্ড সংখ্যক শিক্ষার্থী অকৃতকার্য হওয়ার পর নেওয়া বিশেষ ব্যবস্থার অংশ হিসেবে আয়োজিত হচ্ছে সাপ্লিমেন্টারি (পুনঃপরীক্ষা)। ১০টি শিক্ষা বোর্ডের তথ্য অনুযায়ী, এই বিশেষ পরীক্ষায় অংশ নিতে ইতিমধ্যে ১ লাখ ৫৮ হাজার ২৬৮ জন শিক্ষার্থী ফরম পূরণ ও আবেদন করেছে। আগামী ১ থে&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820846/%E0%A6%8F%E0%A6%87%E0%A6%9A%E0%A6%8F%E0%A6%B8%E0%A6%B8%E0%A6%BF-%E0%A6%B8%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A6%BF%E0%A6%AE%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A7%A7%E0%A7%A6-%E0%A6%AC%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A7%87-%E0%A7%A7-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A7%AB%E0%A7%AE">দৈনিক ইত্তেফাক</source>

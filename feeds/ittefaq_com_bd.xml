      <pubDate>Sun, 15 Nov 2026 03:31:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/892f4303fb7f475851422bf25685991d-6af8ce9b93bae.jpg?jadewits_media_id=322833" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/892f4303fb7f475851422bf25685991d-6af8ce9b93bae.jpg?jadewits_media_id=322833" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/892f4303fb7f475851422bf25685991d-6af8ce9b93bae.jpg?jadewits_media_id=322833" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফটিকছড়িতে ইয়াবাসহ তিন যুবক আটক" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রামের ফটিকছড়িতে পুলিশের মাদকবিরোধী বিশেষ অভিযানে ১০০ ইয়াবাসহ তিন যুবককে আটক করা হয়েছে।&amp;nbsp;
শনিবার (১৪ নভেম্বর) ফটিকছড়ি থানা পুলিশের অভিযানে তাদের আটক করা হয়।
আটক ব্যক্তিরা হলেন- ফটিকছড়ি উপজেলার ভূজপুর ইউনিয়নের ২ নম্বর ওয়ার্ডের মো. শাহাজাহান (৪৬), একই ইউনিয়নের ৯ নম্বর ওয়ার্ডের পূর্ব ভূজপুর টি&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821030/%E0%A6%AB%E0%A6%9F%E0%A6%BF%E0%A6%95%E0%A6%9B%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%87%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%B9-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%95-%E0%A6%86%E0%A6%9F%E0%A6%95">দৈনিক ইত্তেফাক</source>
    </item>

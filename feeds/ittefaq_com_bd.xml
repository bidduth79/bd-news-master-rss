      <guid isPermaLink="true">https://www.ittefaq.com.bd/820451/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%B0%E0%A6%B9%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%9A%E0%A7%80%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AD%E0%A6%BE%E0%A6%87%E0%A6%B8</guid>
      <pubDate>Thu, 12 Nov 2026 00:06:43 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/afbe142891b9ad2b990773477a94d5cb-6af4ae9d19ff7.jpg?jadewits_media_id=322239" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/afbe142891b9ad2b990773477a94d5cb-6af4ae9d19ff7.jpg?jadewits_media_id=322239" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/afbe142891b9ad2b990773477a94d5cb-6af4ae9d19ff7.jpg?jadewits_media_id=322239" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রধানমন্ত্রী তারেক রহমানের সঙ্গে চীনের ভাইস প্রেসিডেন্টের বৈঠক" /&gt;&lt;/p&gt;&lt;p&gt;তুরস্কের আন্তালিয়ায় জাতিসংঘের জলবায়ু পরিবর্তনবিষয়ক শীর্ষ সম্মেলনের (কপ৩১) সাইডলাইনে চীনের ভাইস প্রেসিডেন্ট হান ঝেং-এর সঙ্গে দ্বিপক্ষীয় বৈঠকে মিলিত হয়েছেন বাংলাদেশের প্রধানমন্ত্রী তারেক রহমান। বুধবার (১১ নভেম্বর) স্থানীয় সময় বিকেল সাড়ে ৪টায় সম্মেলনস্থলে দুই শীর্ষ নেতার মধ্যে এ গুরুত্বপূর্ণ &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820451/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%B0%E0%A6%B9%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%9A%E0%A7%80%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AD%E0%A6%BE%E0%A6%87%E0%A6%B8">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>সাবেক উপদেষ্টা আসিফ নজরুলের মোবাইল ফোন ছিনতাই</title>
      <link>https://www.ittefaq.com.bd/820450/%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%89%E0%A6%AA%E0%A6%A6%E0%A7%87%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%86%E0%A6%B8%E0%A6%BF%E0%A6%AB-%E0%A6%A8%E0%A6%9C%E0%A6%B0%E0%A7%81%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%8B%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%B2-%E0%A6%AB%E0%A7%8B%E0%A6%A8-%E0%A6%9B%E0%A6%BF%E0%A6%A8%E0%A6%A4%E0%A6%BE%E0%A6%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820450/%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%89%E0%A6%AA%E0%A6%A6%E0%A7%87%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%86%E0%A6%B8%E0%A6%BF%E0%A6%AB-%E0%A6%A8%E0%A6%9C%E0%A6%B0%E0%A7%81%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%8B%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%B2-%E0%A6%AB%E0%A7%8B%E0%A6%A8-%E0%A6%9B%E0%A6%BF%E0%A6%A8%E0%A6%A4%E0%A6%BE%E0%A6%87</guid>
      <pubDate>Wed, 11 Nov 2026 23:50:12 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/64ebffbf0d6c67937189b9398ad114d6-6af4aa3425d3a.jpg?jadewits_media_id=322238" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/64ebffbf0d6c67937189b9398ad114d6-6af4aa3425d3a.jpg?jadewits_media_id=322238" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/64ebffbf0d6c67937189b9398ad114d6-6af4aa3425d3a.jpg?jadewits_media_id=322238" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাবেক উপদেষ্টা আসিফ নজরুলের মোবাইল ফোন ছিনতাই" /&gt;&lt;/p&gt;&lt;p&gt;সাবেক অন্তর্বর্তী সরকারের আইন, বিচার ও সংসদবিষয়ক উপদেষ্টা অধ্যাপক আসিফ নজরুলের চলন্ত গাড়ির খোলা জানালা দিয়ে ছোঁ মেরে মোবাইল ফোন ছিনিয়ে নিয়েছে এক ছিনতাইকারী। বুধবার (১১ নভেম্বর) সন্ধ্যা সাড়ে ছয়টার দিকে রাজধানীর ধানমন্ডি সংলগ্ন শুক্রাবাদ এলাকায় এ ঘটনা ঘটে।
ঘটনার পরপরই সামাজিক যোগাযোগমাধ্যম ফেস&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820450/%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%89%E0%A6%AA%E0%A6%A6%E0%A7%87%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%86%E0%A6%B8%E0%A6%BF%E0%A6%AB-%E0%A6%A8%E0%A6%9C%E0%A6%B0%E0%A7%81%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%8B%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%B2-%E0%A6%AB%E0%A7%8B%E0%A6%A8-%E0%A6%9B%E0%A6%BF%E0%A6%A8%E0%A6%A4%E0%A6%BE%E0%A6%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>সিলেট সীমান্তে এয়ারগান ও গুলিসহ ভারতীয় ২ খাসিয়া নাগরিক আটক</title>
      <link>https://www.ittefaq.com.bd/820449/%E0%A6%B8%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%9F-%E0%A6%B8%E0%A7%80%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%87-%E0%A6%8F%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A6%97%E0%A6%BE%E0%A6%A8-%E0%A6%93-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B8%E0%A6%B9-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A7%A8-%E0%A6%96%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A7%9F%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820449/%E0%A6%B8%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%9F-%E0%A6%B8%E0%A7%80%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%87-%E0%A6%8F%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A6%97%E0%A6%BE%E0%A6%A8-%E0%A6%93-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B8%E0%A6%B9-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A7%A8-%E0%A6%96%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A7%9F%E0%A6%BE</guid>
      <pubDate>Wed, 11 Nov 2026 23:43:22 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/901f3d8241c3f841f25c0218d67e430b-6af4a888bfbb6.jpg?jadewits_media_id=322237" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/901f3d8241c3f841f25c0218d67e430b-6af4a888bfbb6.jpg?jadewits_media_id=322237" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/901f3d8241c3f841f25c0218d67e430b-6af4a888bfbb6.jpg?jadewits_media_id=322237" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সিলেট সীমান্তে এয়ারগান ও গুলিসহ ভারতীয় ২ খাসিয়া নাগরিক আটক" /&gt;&lt;/p&gt;&lt;p&gt;সিলেটের জৈন্তাপুর সীমান্ত দিয়ে বাংলাদেশে ঢোকার সময় দুই ভারতীয় নাগরিককে আটক করেছে বর্ডার গার্ড বাংলাদেশ (বিজিবি)। এ সময় তাদের কাছ থেকে একটি এয়ারগান, ৩৫ রাউন্ড প্যালেট গুলি ও দুটি দা উদ্ধার করা হয়েছে।
বুধবার (১১ নভেম্বর) দুপুরে উপজেলার মিনাটিলা সীমান্তের আনারস বাগান এলাকা থেকে তাদের আটক করা হয়।&amp;nbsp;
&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820449/%E0%A6%B8%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%9F-%E0%A6%B8%E0%A7%80%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%87-%E0%A6%8F%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A6%97%E0%A6%BE%E0%A6%A8-%E0%A6%93-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B8%E0%A6%B9-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A7%A8-%E0%A6%96%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A7%9F%E0%A6%BE">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>খিলগাঁও থানার ভেতরে ককটেল বিস্ফোরণ</title>
      <link>https://www.ittefaq.com.bd/820448/%E0%A6%96%E0%A6%BF%E0%A6%B2%E0%A6%97%E0%A6%BE%E0%A6%81%E0%A6%93-%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%AD%E0%A7%87%E0%A6%A4%E0%A6%B0%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820448/%E0%A6%96%E0%A6%BF%E0%A6%B2%E0%A6%97%E0%A6%BE%E0%A6%81%E0%A6%93-%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%AD%E0%A7%87%E0%A6%A4%E0%A6%B0%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3</guid>
      <pubDate>Wed, 11 Nov 2026 23:38:19 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/68671b93a555ea99112f15c8968fb975-6af4a7c7a5008.jpg?jadewits_media_id=322236" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/68671b93a555ea99112f15c8968fb975-6af4a7c7a5008.jpg?jadewits_media_id=322236" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/68671b93a555ea99112f15c8968fb975-6af4a7c7a5008.jpg?jadewits_media_id=322236" style="max-width:100%;height:auto;margin-bottom:10px;" alt="খিলগাঁও থানার ভেতরে ককটেল বিস্ফোরণ" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর খিলগাঁও থানা প্রাঙ্গণে ভেতরে ঢুকে পরপর দুটি ককটেল বিস্ফোরণের ঘটনা ঘটিয়েছে দুর্বৃত্তরা। বুধবার রাত ৯টার দিকে থানার সীমানার ভেতরে থাকা নারী ও শিশু হেল্পডেস্কের কক্ষের সামনের আমগাছের নিচে এই বিস্ফোরণ ঘটে। তবে আকস্মিক এই হামলায় কোনো পুলিশ সদস্য বা সাধারণ নাগরিক হতাহত হননি।
ঘটনার সত্যতা নিশ্চিত &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820448/%E0%A6%96%E0%A6%BF%E0%A6%B2%E0%A6%97%E0%A6%BE%E0%A6%81%E0%A6%93-%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%AD%E0%A7%87%E0%A6%A4%E0%A6%B0%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3">দৈনিক ইত্তেফাক</source>
    </item>

      <guid isPermaLink="true">https://www.ittefaq.com.bd/819798/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%B6%E0%A7%87%E0%A6%96%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%87%E0%A7%9F%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%87</guid>
      <pubDate>Sun, 08 Nov 2026 20:11:04 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/08/dae18a0bea3ae7fc1a8dc8c9f0e76f48-6af08267d15e0.jpg?jadewits_media_id=321558" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/08/dae18a0bea3ae7fc1a8dc8c9f0e76f48-6af08267d15e0.jpg?jadewits_media_id=321558" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/08/dae18a0bea3ae7fc1a8dc8c9f0e76f48-6af08267d15e0.jpg?jadewits_media_id=321558" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাংলাদেশের রাজনীতিতে একমাত্র শেখের মেয়ে হাসিনাই পালিয়েছেন: মুক্তিযুদ্ধবিষয়ক মন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশের রাজনীতিতে একমাত্র শেখের মেয়ে হাসিনাই পালিয়েছেন বলে মন্তব্য করেছেন মুক্তিযুদ্ধবিষয়ক মন্ত্রী ও টাঙ্গাইল-৮ (সখীপুর-বাসাইল) আসনের সংসদ সদস্য অ্যাডভোকেট আহমেদ আযম খান।&amp;nbsp;
তিনি বলেছেন, &amp;lsquo;হাসিনা বলেছিলেন, শেখের মেয়ে পালায় না। অথচ বাংলাদেশের রাজনীতিতে একমাত্র শেখের মেয়ে হাসিনাই পালিয়েছেন।&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/819798/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%B6%E0%A7%87%E0%A6%96%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%87%E0%A7%9F%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>অবসর-কল্যাণের টাকা পাচ্ছেন ১৩ হাজার এমপিও শিক্ষক-কর্মচারী</title>
      <link>https://www.ittefaq.com.bd/819791/%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A6%B0-%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%AA%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A7%A7%E0%A7%A9-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF%E0%A6%93</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/819791/%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A6%B0-%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%AA%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A7%A7%E0%A7%A9-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF%E0%A6%93</guid>
      <pubDate>Sun, 08 Nov 2026 20:00:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/08/11ed0173dd27cf5344024b6b41238b66-6af0782b7ee2b.jpg?jadewits_media_id=321550" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/08/11ed0173dd27cf5344024b6b41238b66-6af0782b7ee2b.jpg?jadewits_media_id=321550" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/08/11ed0173dd27cf5344024b6b41238b66-6af0782b7ee2b.jpg?jadewits_media_id=321550" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অবসর-কল্যাণের টাকা পাচ্ছেন ১৩ হাজার এমপিও শিক্ষক-কর্মচারী" /&gt;&lt;/p&gt;&lt;p&gt;বেসরকারি শিক্ষাপ্রতিষ্ঠানের প্রায় ১৩ হাজার অবসরপ্রাপ্ত শিক্ষক-কর্মচারীর অবসর ও কল্যাণ সুবিধার বকেয়া টাকা দ্রুত পরিশোধের সিদ্ধান্ত নেওয়া হয়েছে। বিশেষ করে ২০২২ ও ২০২৩ সালে আবেদন করা শিক্ষক-কর্মচারীদের পাওনা পরিশোধে সবচেয়ে বেশি গুরুত্ব দেওয়া হয়েছে। একই সঙ্গে হজযাত্রী ও দুরারোগ্য রোগে আক্রান্ত শিক্ষক-কর&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/819791/%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A6%B0-%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%AA%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A7%A7%E0%A7%A9-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF%E0%A6%93">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>‘পরাজিত ব্যক্তি’ বলতেই ক্ষুব্ধ হয়ে ব্রিফিং ছাড়লেন ট্রাম্প</title>

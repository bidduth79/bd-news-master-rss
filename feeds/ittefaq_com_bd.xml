      <link>https://www.ittefaq.com.bd/820247/%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A6%B0%E0%A7%8D%E0%A6%A4-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820247/%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A6%B0%E0%A7%8D%E0%A6%A4-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Wed, 11 Nov 2026 00:51:43 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/55e1f033fc1fa16f29b4c99df62c243a-6af365ddb820d.jpg?jadewits_media_id=322033" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/55e1f033fc1fa16f29b4c99df62c243a-6af365ddb820d.jpg?jadewits_media_id=322033" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/55e1f033fc1fa16f29b4c99df62c243a-6af365ddb820d.jpg?jadewits_media_id=322033" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যুদ্ধ বন্ধে যুক্তরাষ্ট্রকে সাত শর্ত মানার আহ্বান ইরানের" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাষ্ট্রের সঙ্গে চলমান সংঘাতের অবসান ঘটাতে সাতটি শর্ত দিয়েছে ইরান। দেশটির সর্বোচ্চ জাতীয় নিরাপত্তা পরিষদের সচিব মেজর জেনারেল মোহসেন রেজাই বলেছেন, তেহরানের দেওয়া শর্তগুলো মেনে নিয়ে যুদ্ধ বন্ধ করার সময় এসেছে ওয়াশিংটনের। একই সঙ্গে যুক্তরাষ্ট্রের সঙ্গে কোনো আলোচনা চলছে না দাবি করে ‘কাল্পনিক আলোচনার &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820247/%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A6%B0%E0%A7%8D%E0%A6%A4-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B0">দৈনিক ইত্তেফাক</source>

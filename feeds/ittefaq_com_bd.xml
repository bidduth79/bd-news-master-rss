    <item>
      <title>পরকীয়া কাণ্ডে বহিষ্কৃত বিএনপি নেতাকে ফেরাতে ৩১ নেতার পদত্যাগ, ৮ ঘণ্টা পর প্রত্যাহার</title>
      <link>https://www.ittefaq.com.bd/821391/%E0%A6%AA%E0%A6%B0%E0%A6%95%E0%A7%80%E0%A7%9F%E0%A6%BE-%E0%A6%95%E0%A6%BE%E0%A6%A3%E0%A7%8D%E0%A6%A1%E0%A7%87-%E0%A6%AC%E0%A6%B9%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%95%E0%A7%83%E0%A6%A4-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A7%A9%E0%A7%A7</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821391/%E0%A6%AA%E0%A6%B0%E0%A6%95%E0%A7%80%E0%A7%9F%E0%A6%BE-%E0%A6%95%E0%A6%BE%E0%A6%A3%E0%A7%8D%E0%A6%A1%E0%A7%87-%E0%A6%AC%E0%A6%B9%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%95%E0%A7%83%E0%A6%A4-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A7%A9%E0%A7%A7</guid>
      <pubDate>Tue, 17 Nov 2026 01:22:20 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/c0417e395ae27261c494767a5e65af24-6afb57aee40d6.png?jadewits_media_id=323207" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/c0417e395ae27261c494767a5e65af24-6afb57aee40d6.png?jadewits_media_id=323207" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/c0417e395ae27261c494767a5e65af24-6afb57aee40d6.png?jadewits_media_id=323207" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পরকীয়া কাণ্ডে বহিষ্কৃত বিএনপি নেতাকে ফেরাতে ৩১ নেতার পদত্যাগ, ৮ ঘণ্টা পর প্রত্যাহার" /&gt;&lt;/p&gt;&lt;p&gt;পরকীয়া প্রেমের জেরে এক বিবাহিত নারীকে ভাগিয়ে নিয়ে যাওয়ার ঘটনায় বহিষ্কৃত এক নেতার বহিষ্কারাদেশ প্রত্যাহার করাকে কেন্দ্র করে তীব্র অসন্তোষ ও গণপদত্যাগের নাটকীয়তা দেখা দিয়েছে লক্ষ্মীপুর সদর উপজেলার চররুহিতা ইউনিয়ন বিএনপিতে। ক্ষোভের বশে ৫১ সদস্যবিশিষ্ট ওয়ার্ড কমিটির ৩১ জন নেতা একযোগে পদত্যাগপত্র জমা দিল&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821391/%E0%A6%AA%E0%A6%B0%E0%A6%95%E0%A7%80%E0%A7%9F%E0%A6%BE-%E0%A6%95%E0%A6%BE%E0%A6%A3%E0%A7%8D%E0%A6%A1%E0%A7%87-%E0%A6%AC%E0%A6%B9%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%95%E0%A7%83%E0%A6%A4-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A7%A9%E0%A7%A7">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>প্রকাশ্যে বিরোধিতা, গোপনে আরব নেতাদের সাহায্য চেয়েছেন নেতানিয়াহু</title>
      <link>https://www.ittefaq.com.bd/821390/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B6%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A6%BF%E0%A6%A4%E0%A6%BE-%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A6%AC-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%AF%E0%A7%8D%E0%A6%AF</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821390/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B6%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A6%BF%E0%A6%A4%E0%A6%BE-%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A6%AC-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%AF%E0%A7%8D%E0%A6%AF</guid>
      <pubDate>Tue, 17 Nov 2026 00:51:23 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/f2c5dd65c38bcd5117361ed94e5c4a7f-6afb5036dca48.png?jadewits_media_id=323205" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/f2c5dd65c38bcd5117361ed94e5c4a7f-6afb5036dca48.png?jadewits_media_id=323205" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/f2c5dd65c38bcd5117361ed94e5c4a7f-6afb5036dca48.png?jadewits_media_id=323205" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রকাশ্যে বিরোধিতা, গোপনে আরব নেতাদের সাহায্য চেয়েছেন নেতানিয়াহু" /&gt;&lt;/p&gt;&lt;p&gt;প্রকাশ্যে আরব রাজনৈতিক দলগুলোর সঙ্গে যেকোনো ধরনের জোট বা সহযোগিতার তীব্র বিরোধিতা করলেও, গোপনে বিরোধী নেতা গাদি আইজেনকোটের জোটকে ঠেকাতে আরব আইনপ্রণেতাদের সহায়তা চেয়েছিলেন ইসরায়েলের প্রধানমন্ত্রী বেনিয়ামিন নেতানিয়াহু। শুক্রবার ইসরায়েলি সংবাদমাধ্যম &amp;lsquo;চ্যানেল ১২&amp;rsquo;-কে দেওয়া এক সাক্ষাৎকারে নেতা&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821390/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B6%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A6%BF%E0%A6%A4%E0%A6%BE-%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A6%AC-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%AF%E0%A7%8D%E0%A6%AF">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>জাতীয় বিশ্ববিদ্যালয়ের সব অফিস তিন দিন বন্ধ ঘোষণা</title>
      <link>https://www.ittefaq.com.bd/821389/%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AC-%E0%A6%85%E0%A6%AB%E0%A6%BF%E0%A6%B8-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7-%E0%A6%98%E0%A7%8B%E0%A6%B7%E0%A6%A3%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821389/%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AC-%E0%A6%85%E0%A6%AB%E0%A6%BF%E0%A6%B8-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7-%E0%A6%98%E0%A7%8B%E0%A6%B7%E0%A6%A3%E0%A6%BE</guid>
      <pubDate>Tue, 17 Nov 2026 00:55:49 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/beb19186cc38609ec99d430c6942e538-6afb508f5b702.jpg?jadewits_media_id=323206" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/beb19186cc38609ec99d430c6942e538-6afb508f5b702.jpg?jadewits_media_id=323206" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/beb19186cc38609ec99d430c6942e538-6afb508f5b702.jpg?jadewits_media_id=323206" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জাতীয় বিশ্ববিদ্যালয়ের সব অফিস তিন দিন বন্ধ ঘোষণা" /&gt;&lt;/p&gt;&lt;p&gt;জাতীয় বিশ্ববিদ্যালয়ের উদ্ভূত পরিস্থিতির কারণে বিশ্ববিদ্যালয়টির সব অফিস তিন দিন বন্ধ রাখার সিদ্ধান্ত নেওয়া হয়েছে। সিদ্ধান্ত অনুযায়ী, মঙ্গলবার (১৭ নভেম্বর) থেকে আগামী বৃহস্পতিবার (১৯ নভেম্বর) পর্যন্ত  বিশ্ববিদ্যালয়ের সব অফিস বন্ধ থাকবে।
সোমবার (১৬ নভেম্বর) রাতে বিশ্ববিদ্যালয়ের সিন্ডিকেটের জরুরি সভায় এ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821389/%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AC-%E0%A6%85%E0%A6%AB%E0%A6%BF%E0%A6%B8-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7-%E0%A6%98%E0%A7%8B%E0%A6%B7%E0%A6%A3%E0%A6%BE">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>শাহজাদপুরে পরপর তিনটি ককটেল বিস্ফোরণ, আটক ৩</title>
      <link>https://www.ittefaq.com.bd/821388/%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A6%9C%E0%A6%BE%E0%A6%A6%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%AA%E0%A6%B0%E0%A6%AA%E0%A6%B0-%E0%A6%A4%E0%A6%BF%E0%A6%A8%E0%A6%9F%E0%A6%BF-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A7%A9</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821388/%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A6%9C%E0%A6%BE%E0%A6%A6%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%AA%E0%A6%B0%E0%A6%AA%E0%A6%B0-%E0%A6%A4%E0%A6%BF%E0%A6%A8%E0%A6%9F%E0%A6%BF-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A7%A9</guid>
      <pubDate>Tue, 17 Nov 2026 00:12:30 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/59d20de0eaceb4aecedee11f03f1c41e-6afb47752094a.jpg?jadewits_media_id=323204" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/59d20de0eaceb4aecedee11f03f1c41e-6afb47752094a.jpg?jadewits_media_id=323204" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/59d20de0eaceb4aecedee11f03f1c41e-6afb47752094a.jpg?jadewits_media_id=323204" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শাহজাদপুরে পরপর তিনটি ককটেল বিস্ফোরণ, আটক ৩" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর গুলশান থানাধীন শাহজাদপুর এলাকায় পপুলার হাসপাতালের সামনে তিনটি ককটেল বিস্ফোরণের ঘটনা ঘটেছে। বিস্ফোরণ ঘটিয়ে পালিয়ে যাওয়ার সময় তিনজনকে আটক করেছে পুলিশ।
সোমবার (১৬ নভেম্বর) রাত ৯টার দিকে পপুলার হাসপাতালের সামনে এ ঘটনা ঘটে।
এ বিষয়ে জানতে চাইলে গুলশান থানার ভারপ্রাপ্ত কর্মকর্তা (ওসি) আবু জায়েদ &lt;/p&gt;</description>

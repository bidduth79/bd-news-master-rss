      <guid isPermaLink="true">https://www.ittefaq.com.bd/821725/%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%AE%E0%A6%A4%E0%A6%AC%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A6%AE%E0%A7%9F%E0%A7%87-%E0%A6%B8%E0%A7%8C%E0%A6%B0%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A7%81%E0%A6%B0%E0%A7%81%E0%A6%A4%E0%A7%8D%E0%A6%AC</guid>
      <pubDate>Wed, 18 Nov 2026 18:45:44 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/8a8fbd7aba46a45f642c0fe6e0fb7048-6afd9df5d9acd.jpg?jadewits_media_id=323556" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/8a8fbd7aba46a45f642c0fe6e0fb7048-6afd9df5d9acd.jpg?jadewits_media_id=323556" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/8a8fbd7aba46a45f642c0fe6e0fb7048-6afd9df5d9acd.jpg?jadewits_media_id=323556" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শিক্ষার্থীদের সঙ্গে মতবিনিময়ে সৌরবিদ্যুতের গুরুত্ব তুলে ধরলেন প্রধানমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;দেশের বিদ্যুৎ খাতে স্বনির্ভরতা অর্জনে সৌরবিদ্যুতের ব্যবহার বাড়ানোর ওপর গুরুত্বারোপ করেছেন প্রধানমন্ত্রী তারেক রহমান। তিনি বলেছেন, গ্যাস ও কয়লার পাশাপাশি সৌরবিদ্যুতের ব্যবহার বাড়ানো গেলে ভবিষ্যতে বিদ্যুৎ নিয়ে দুশ্চিন্তা অনেকটাই কমে আসবে। এ লক্ষ্যে শিগগিরই জাতীয় সংসদ ভবনকে পুরোপুরি সৌরবিদ্যুৎ ব্যবস্থা&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821725/%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%AE%E0%A6%A4%E0%A6%AC%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A6%AE%E0%A7%9F%E0%A7%87-%E0%A6%B8%E0%A7%8C%E0%A6%B0%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A7%81%E0%A6%B0%E0%A7%81%E0%A6%A4%E0%A7%8D%E0%A6%AC">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>নদীর মাঝখানে খুঁটি ছাড়াই হবে ২৫৬টি দীর্ঘ সেতু: পরিকল্পনা প্রতিমন্ত্রী</title>

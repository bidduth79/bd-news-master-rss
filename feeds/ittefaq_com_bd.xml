      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/e62ad9b24b1ef17b92ae099d0ebf3e85-6b02158ae8573.jpg?jadewits_media_id=324149" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/e62ad9b24b1ef17b92ae099d0ebf3e85-6b02158ae8573.jpg?jadewits_media_id=324149" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/e62ad9b24b1ef17b92ae099d0ebf3e85-6b02158ae8573.jpg?jadewits_media_id=324149" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মধ্যরাতে বাহরাইনে মিসাইল ও ড্রোন ছুড়ল ইরান" /&gt;&lt;/p&gt;&lt;p&gt;বাহরাইনে নতুন করে আবারও হামলা চালিয়েছে ইরানের ইসলামিক বিপ্লবী গার্ড। স্থানীয় সময় শনিবার রাতে ও বাংলাদেশ সময় রোববার (২২ নভেম্বর) ভোররাত প্রায় ৩টার দিকে দেশটিতে মিসাইল ও ড্রোন ছুড়েছে সেনাবাহিনীর চৌকস এ ইউনিট।&amp;nbsp;
বিপ্লবী গার্ড বলেছে, তারা বাহরাইনে থাকা মার্কিনিদের দুটি ঘাঁটিতে থাকা আকাশ প্রতিরক্ষা ব&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822310/%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%B0%E0%A6%BE%E0%A6%87%E0%A6%A8%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%B2-%E0%A6%93-%E0%A6%A1%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%A8-%E0%A6%9B%E0%A7%81%E0%A7%9C%E0%A6%B2-%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8">দৈনিক ইত্তেফাক</source>

      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/b608855690b19b4ecd690c41cc1cce64-6af750b1808d7.jpg?jadewits_media_id=322639" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/b608855690b19b4ecd690c41cc1cce64-6af750b1808d7.jpg?jadewits_media_id=322639" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আখতারুজ্জামানের ছেলের ওপর হামলার মামলায় বিএনপি-জামায়াত পাল্টাপাল্টি অবস্থানে উত্তপ্ত কটিয়াদী রাজনীতি" /&gt;&lt;/p&gt;&lt;p&gt;কিশোরগঞ্জের কটিয়াদীতে জামায়াতের সহযোগী সদস্য ও বীর মুক্তিযোদ্ধা মেজর (অব.) মোহাম্মদ আখতারুজ্জামানের ছেলের ওপর হামলার ঘটনায় দায়ের করা মামলায় স্থানীয় বিএনপি নেতাদের আসামি করাকে কেন্দ্র করে শুরু হয়েছে তীব্র রাজনৈতিক সংঘাত। 
মামলায় বিএনপির নেতাকর্মীদের জড়ানোর প্রতিবাদে দলটির স্থানীয় শীর্ষ নেতা&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820842/%E0%A6%86%E0%A6%96%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A7%81%E0%A6%9C%E0%A7%8D%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%9B%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%AF%E0%A6%BC">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>চট্টগ্রামে ৫ কোটি টাকার স্বর্ণসহ যুবক গ্রেপ্তার</title>
      <link>https://www.ittefaq.com.bd/820841/%E0%A6%9A%E0%A6%9F%E0%A7%8D%E0%A6%9F%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A7%AB-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A6%B8%E0%A6%B9-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%95-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820841/%E0%A6%9A%E0%A6%9F%E0%A7%8D%E0%A6%9F%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A7%AB-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A6%B8%E0%A6%B9-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%95-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Fri, 13 Nov 2026 23:58:15 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/5087235ffe3368127a7f3a3edbd23c3b-6af74f9de4cc3.jpg?jadewits_media_id=322638" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/5087235ffe3368127a7f3a3edbd23c3b-6af74f9de4cc3.jpg?jadewits_media_id=322638" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/5087235ffe3368127a7f3a3edbd23c3b-6af74f9de4cc3.jpg?jadewits_media_id=322638" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চট্টগ্রামে ৫ কোটি টাকার স্বর্ণসহ যুবক গ্রেপ্তার" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রাম নগরের আকবরশাহ থানা পুলিশের অভিযানে ৩ কেজি ১২৯ দশমিক ৭ গ্রাম স্বর্ণসহ চোরা কারবারি চক্রের এক সদস্যকে করেছে পুলিশ। উদ্ধার করা স্বর্ণের আনুমানিক বাজারমূল্য ৫ কোটি ৩৬ লাখ ৬২ হাজার টাকা বলে জানা গেছে।
বৃহস্পতিবার (১২ নভেম্বর) রাতে নগরের আকবরশাহ থানার সিটি গেট এলাকায় ঢাকা-চট্টগ্রাম মহাসড়কের পশ্চ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820841/%E0%A6%9A%E0%A6%9F%E0%A7%8D%E0%A6%9F%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A7%AB-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A6%B8%E0%A6%B9-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%95-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>মা ও ছেলেকে অপহরণ করে টাকা দাবি, এএসপি বরখাস্ত</title>
      <link>https://www.ittefaq.com.bd/820840/%E0%A6%AE%E0%A6%BE-%E0%A6%93-%E0%A6%9B%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%85%E0%A6%AA%E0%A6%B9%E0%A6%B0%E0%A6%A3-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF-%E0%A6%8F%E0%A6%8F%E0%A6%B8%E0%A6%AA%E0%A6%BF-%E0%A6%AC%E0%A6%B0%E0%A6%96%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820840/%E0%A6%AE%E0%A6%BE-%E0%A6%93-%E0%A6%9B%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%85%E0%A6%AA%E0%A6%B9%E0%A6%B0%E0%A6%A3-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF-%E0%A6%8F%E0%A6%8F%E0%A6%B8%E0%A6%AA%E0%A6%BF-%E0%A6%AC%E0%A6%B0%E0%A6%96%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4</guid>
      <pubDate>Fri, 13 Nov 2026 23:38:40 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/2030a7b5a0374a1db37e5ab49c5f9430-6af74a6e1f200.jpg?jadewits_media_id=322637" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/2030a7b5a0374a1db37e5ab49c5f9430-6af74a6e1f200.jpg?jadewits_media_id=322637" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/2030a7b5a0374a1db37e5ab49c5f9430-6af74a6e1f200.jpg?jadewits_media_id=322637" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মা ও ছেলেকে অপহরণ করে টাকা দাবি, এএসপি বরখাস্ত" /&gt;&lt;/p&gt;&lt;p&gt;দিনাজপুরে এক ব্যক্তির বাড়িতে গিয়ে তার স্ত্রী ও ছেলেকে তুলে নিয়ে আটকে রাখার পর মোবাইল ফোনে টাকা দাবির অভিযোগে পুলিশের অপরাধ তদন্ত বিভাগের (সিআইডি) সাবেক সহকারী পুলিশ সুপার (এএসপি) মো. সারোয়ার কবীর সোহাগকে চাকরি থেকে বরখাস্ত করা হয়েছে। ঘটনাটি ২০২১ সালে দিনাজপুরের&amp;nbsp; চিরিরবন্দর এলাকায় ঘটে। 
এই ঘটনায়&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820840/%E0%A6%AE%E0%A6%BE-%E0%A6%93-%E0%A6%9B%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%85%E0%A6%AA%E0%A6%B9%E0%A6%B0%E0%A6%A3-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF-%E0%A6%8F%E0%A6%8F%E0%A6%B8%E0%A6%AA%E0%A6%BF-%E0%A6%AC%E0%A6%B0%E0%A6%96%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>মৃত্যুকে খুব কাছ থেকে দেখে বদলে যান কাজল</title>
      <link>https://www.ittefaq.com.bd/820838/%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%87-%E0%A6%96%E0%A7%81%E0%A6%AC-%E0%A6%95%E0%A6%BE%E0%A6%9B-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A7%87-%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A6%95%E0%A6%BE%E0%A6%9C%E0%A6%B2</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820838/%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%87-%E0%A6%96%E0%A7%81%E0%A6%AC-%E0%A6%95%E0%A6%BE%E0%A6%9B-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A7%87-%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A6%95%E0%A6%BE%E0%A6%9C%E0%A6%B2</guid>
      <pubDate>Sat, 14 Nov 2026 00:18:53 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/01381d978d85f687fe2b4fd2b3dbe842-6af7548b6a83c.jpg?jadewits_media_id=322642" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/01381d978d85f687fe2b4fd2b3dbe842-6af7548b6a83c.jpg?jadewits_media_id=322642" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/01381d978d85f687fe2b4fd2b3dbe842-6af7548b6a83c.jpg?jadewits_media_id=322642" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মৃত্যুকে খুব কাছ থেকে দেখে বদলে যান কাজল" /&gt;&lt;/p&gt;&lt;p&gt;একটি দুর্ঘটনা মানুষের জীবনের প্রতি দৃষ্টিভঙ্গি সম্পূর্ণ বদলে দিতে পারে। ভারতীয় অভিনেত্রী কাজল আগারওয়ালের জীবনেও ঠিক তেমনই এক বড় পরিবর্তন এনেছে ২০২০ সালের একটি ভয়ংকর অভিজ্ঞতা। 
কমল হাসান অভিনীত ‘ইন্ডিয়ান টু’ সিনেমার শুটিং সেটে প্রায় ১০০ ফুট উঁচু একটি ক্রেন ভেঙে পড়ার সেই ভয়াবহ দুর্ঘটনার মুখে পড়ে অল&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820838/%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%87-%E0%A6%96%E0%A7%81%E0%A6%AC-%E0%A6%95%E0%A6%BE%E0%A6%9B-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A7%87-%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A6%95%E0%A6%BE%E0%A6%9C%E0%A6%B2">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>বাংলাদেশের খেলোয়াড়দের কী খাওয়ানো হয়— প্রশ্ন শ্রীলঙ্কার খেলোয়াড়দের</title>
      <link>https://www.ittefaq.com.bd/820836/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A7%8B%E0%A7%9F%E0%A6%BE%E0%A7%9C%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A7%80-%E0%A6%96%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%B9%E0%A7%9F%E2%80%94-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B6%E0%A7%8D%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820836/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A7%8B%E0%A7%9F%E0%A6%BE%E0%A7%9C%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A7%80-%E0%A6%96%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%B9%E0%A7%9F%E2%80%94-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B6%E0%A7%8D%E0%A6%A8</guid>
      <pubDate>Fri, 13 Nov 2026 23:12:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/16536a28abfbac716dd5d52817edbf95-6af73c062bc1d.jpg?jadewits_media_id=322633" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/16536a28abfbac716dd5d52817edbf95-6af73c062bc1d.jpg?jadewits_media_id=322633" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/16536a28abfbac716dd5d52817edbf95-6af73c062bc1d.jpg?jadewits_media_id=322633" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাংলাদেশের খেলোয়াড়দের কী খাওয়ানো হয়— প্রশ্ন শ্রীলঙ্কার খেলোয়াড়দের" /&gt;&lt;/p&gt;&lt;p&gt;শ্রীলঙ্কার বিপক্ষে ৪-০ গোলের বড় জয়ের পর বাংলাদেশের ফুটবলারদের গতি ও খেলার ধরন প্রতিপক্ষের নজর কেড়েছে। ম্যাচ শেষে শ্রীলঙ্কার কয়েকজন খেলোয়াড় বাংলাদেশ দলের ড্রেসিংরুমে এসে কোচ ও খেলোয়াড়দের সঙ্গে কথা বলেন এবং কৌতূহল প্রকাশ করে জানতে চান, বাংলাদেশের খেলোয়াড়দের কী খাওয়ানো হয়!
শুক্রবার কিংস অ্যারেনায় অনুশ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820836/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A7%8B%E0%A7%9F%E0%A6%BE%E0%A7%9C%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A7%80-%E0%A6%96%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%B9%E0%A7%9F%E2%80%94-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B6%E0%A7%8D%E0%A6%A8">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>কাঁদতে কাঁদতে যুক্তরাষ্ট্রকে বিদায় বললেন পচেত্তিনো</title>
      <link>https://www.ittefaq.com.bd/820839/%E0%A6%95%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%A4%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A6%87%E0%A6%89%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820839/%E0%A6%95%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%A4%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A6%87%E0%A6%89%E0%A6%B0</guid>
      <pubDate>Fri, 13 Nov 2026 23:10:43 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/285ea140a1caa09f7ce03ae9de4ef4d0-6af7442617895.jpg?jadewits_media_id=322636" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/285ea140a1caa09f7ce03ae9de4ef4d0-6af7442617895.jpg?jadewits_media_id=322636" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/285ea140a1caa09f7ce03ae9de4ef4d0-6af7442617895.jpg?jadewits_media_id=322636" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কাঁদতে কাঁদতে যুক্তরাষ্ট্রকে বিদায় বললেন পচেত্তিনো" /&gt;&lt;/p&gt;&lt;p&gt;মাইকেল ক্যারিককে বরখাস্তের পর ম্যানচেস্টার ইউনাইটেডের নতুন প্রধান কোচ হিসেবে নিয়োগ পেয়েছেন মাউরিসিও পচেত্তিনো। তবে নতুন দায়িত্বে যোগ দেওয়ার আগে যুক্তরাষ্ট্রের জাতীয় দলের কোচের পদ ছাড়তে গিয়ে আবেগ ধরে রাখতে পারেননি আর্জেন্টাইন এই কোচ। শুক্রবার (১৩ নভেম্বর) বিদায়ী সংবাদ সম্মেলনে অশ্রুসিক্ত হয়ে পড়েন তিন&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820839/%E0%A6%95%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%A4%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A6%87%E0%A6%89%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>

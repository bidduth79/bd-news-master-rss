    <item>
      <title>মুকসুদপুরে মুসাদ্দিকের বাড়িতে আগুন-ভাঙচুর</title>
      <link>https://www.ittefaq.com.bd/821972/%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A6%B8%E0%A7%81%E0%A6%A6%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A7%81%E0%A6%B8%E0%A6%BE%E0%A6%A6%E0%A7%8D%E0%A6%A6%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%AD%E0%A6%BE%E0%A6%99%E0%A6%9A%E0%A7%81%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821972/%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A6%B8%E0%A7%81%E0%A6%A6%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A7%81%E0%A6%B8%E0%A6%BE%E0%A6%A6%E0%A7%8D%E0%A6%A6%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%AD%E0%A6%BE%E0%A6%99%E0%A6%9A%E0%A7%81%E0%A6%B0</guid>
      <pubDate>Thu, 19 Nov 2026 23:26:44 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/877076980f8fd456dd230dda5f4f3220-6aff310e407f3.jpg?jadewits_media_id=323808" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/877076980f8fd456dd230dda5f4f3220-6aff310e407f3.jpg?jadewits_media_id=323808" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/877076980f8fd456dd230dda5f4f3220-6aff310e407f3.jpg?jadewits_media_id=323808" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মুকসুদপুরে মুসাদ্দিকের বাড়িতে আগুন-ভাঙচুর" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জের মুকসুদপুরে ঢাকা বিশ্ববিদ্যালয় কেন্দ্রীয় ছাত্র সংসদের (ডাকসু) সাহিত্য ও সংস্কৃতিবিষয়ক সম্পাদক মুসাদ্দিক আলী ইবনে মোহাম্মদের গ্রামের বাড়িতে আগুন, ভাঙচুর ও লুটপাটের ঘটনা ঘটেছে।&amp;nbsp;
বৃহস্পতিবার (১৯ নভেম্বর) ভোরে তার বাড়িতে আগুন দেওয়া হয়। পরে দুপুরে সেখানে ভাঙচুর ও লুটপাট চালানো হয়।
মুসাদ্দ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821972/%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A6%B8%E0%A7%81%E0%A6%A6%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A7%81%E0%A6%B8%E0%A6%BE%E0%A6%A6%E0%A7%8D%E0%A6%A6%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%AD%E0%A6%BE%E0%A6%99%E0%A6%9A%E0%A7%81%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>বিএনপি এখন বিপদে পড়ে চিৎকার করছে— “মুঝে বাঁচাও, বাঁচাও!”</title>
      <link>https://www.ittefaq.com.bd/821971/%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%8F%E0%A6%96%E0%A6%A8-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%A6%E0%A7%87-%E0%A6%AA%E0%A7%9C%E0%A7%87-%E0%A6%9A%E0%A6%BF%E0%A7%8E%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%9B%E0%A7%87%E2%80%94-%E2%80%9C%E0%A6%AE%E0%A7%81%E0%A6%9D%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%81%E0%A6%9A%E0%A6%BE%E0%A6%93</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821971/%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%8F%E0%A6%96%E0%A6%A8-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%A6%E0%A7%87-%E0%A6%AA%E0%A7%9C%E0%A7%87-%E0%A6%9A%E0%A6%BF%E0%A7%8E%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%9B%E0%A7%87%E2%80%94-%E2%80%9C%E0%A6%AE%E0%A7%81%E0%A6%9D%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%81%E0%A6%9A%E0%A6%BE%E0%A6%93</guid>
      <pubDate>Thu, 19 Nov 2026 23:21:55 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/5991ff6a8e214d09cd2918ce1a2c5ba3-6aff300c064ac.jpg?jadewits_media_id=323807" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/5991ff6a8e214d09cd2918ce1a2c5ba3-6aff300c064ac.jpg?jadewits_media_id=323807" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/5991ff6a8e214d09cd2918ce1a2c5ba3-6aff300c064ac.jpg?jadewits_media_id=323807" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিএনপি এখন বিপদে পড়ে চিৎকার করছে— “মুঝে বাঁচাও, বাঁচাও!”" /&gt;&lt;/p&gt;&lt;p&gt;বিএনপি অন্যদের জন্য কবর খুঁড়তে গিয়ে নিজেরাই সেই কবরে পড়েছে বলে মন্তব্য করেছেন জাতীয় নাগরিক পার্টির (এনসিপি) সিনিয়র যুগ্ম আহ্বায়ক নাসীরুদ্দীন পাটওয়ারী। বর্তমান পরিস্থিতিতে দলটি বিপদে পড়ে &amp;lsquo;মুঝে বাঁচাও, বাঁচাও&amp;rsquo; বলে চিৎকার করছে বলেও কটাক্ষ করেন তিনি।
বৃহস্পতিবার (১৯ নভেম্বর) বিকেলে ন&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821971/%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%8F%E0%A6%96%E0%A6%A8-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%A6%E0%A7%87-%E0%A6%AA%E0%A7%9C%E0%A7%87-%E0%A6%9A%E0%A6%BF%E0%A7%8E%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%9B%E0%A7%87%E2%80%94-%E2%80%9C%E0%A6%AE%E0%A7%81%E0%A6%9D%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%81%E0%A6%9A%E0%A6%BE%E0%A6%93">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>রোহিঙ্গা গণহত্যার রায়ের পর মিয়ানমারের প্রতিরক্ষা উপদেষ্টাকে বহিষ্কার করলো যুক্তরাজ্য</title>
      <link>https://www.ittefaq.com.bd/821970/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%97%E0%A6%A3%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821970/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%97%E0%A6%A3%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE</guid>
      <pubDate>Thu, 19 Nov 2026 23:02:24 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/4461ee52009e80946a400d1afa23c1f1-6aff2a9f750b7.jpg?jadewits_media_id=323806" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/4461ee52009e80946a400d1afa23c1f1-6aff2a9f750b7.jpg?jadewits_media_id=323806" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/4461ee52009e80946a400d1afa23c1f1-6aff2a9f750b7.jpg?jadewits_media_id=323806" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রোহিঙ্গা গণহত্যার রায়ের পর মিয়ানমারের প্রতিরক্ষা উপদেষ্টাকে বহিষ্কার করলো যুক্তরাজ্য" /&gt;&lt;/p&gt;&lt;p&gt;রোহিঙ্গা জনগোষ্ঠীর ওপর গণহত্যা চালানোর ঘটনায় আন্তর্জাতিক বিচার আদালতের (আইসিজে) রায়ের পর মিয়ানমারের বিরুদ্ধে নতুন কিছু পদক্ষেপ নেওয়ার ঘোষণা দিয়েছে যুক্তরাজ্য। এর অংশ হিসেবে লন্ডনে নিযুক্ত মিয়ানমারের প্রতিরক্ষা অ্যাটাশেকে বহিষ্কারের নির্দেশ দিয়েছে ব্রিটিশ সরকার।
বৃহস্পতিবার (১৯ নভেম্বর) আইসিজের রায়ের&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821970/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%97%E0%A6%A3%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>এবার শেখ হাসিনার স্বাক্ষরসহ পাসপোর্টের আবেদন তার আইনজীবীর, স্বাক্ষর ঘিরে চলছে সমালোচনা</title>
      <link>https://www.ittefaq.com.bd/821968/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%B0%E0%A6%B8%E0%A6%B9-%E0%A6%AA%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%AC%E0%A7%87%E0%A6%A6%E0%A6%A8-%E0%A6%A4%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821968/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%B0%E0%A6%B8%E0%A6%B9-%E0%A6%AA%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%AC%E0%A7%87%E0%A6%A6%E0%A6%A8-%E0%A6%A4%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Fri, 20 Nov 2026 00:41:21 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/90f68ae721864e474b90519c9236938d-6aff29b275d09.jpg?jadewits_media_id=323805" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/90f68ae721864e474b90519c9236938d-6aff29b275d09.jpg?jadewits_media_id=323805" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/90f68ae721864e474b90519c9236938d-6aff29b275d09.jpg?jadewits_media_id=323805" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এবার শেখ হাসিনার স্বাক্ষরসহ পাসপোর্টের আবেদন তার আইনজীবীর, স্বাক্ষর ঘিরে চলছে সমালোচনা" /&gt;&lt;/p&gt;&lt;p&gt;বাতিল হয়ে যাওয়া কূটনৈতিক পাসপোর্ট এবং জাতীয় পরিচয়পত্র (এনআইডি) পুনরায় ফিরে পেতে তৎপর হয়ে উঠেছেন ক্ষমতাচ্যুত প্রধানমন্ত্রী শেখ হাসিনা। এবার তার নিজস্ব স্বাক্ষরিত অনুমতিপত্রসহ (ওকালতনামা) নয়াদিল্লিতে অবস্থিত বাংলাদেশ হাইকমিশনের দ্বারস্থ হয়েছেন তার আইনজীবীরা।
শেখ হাসিনার পক্ষে লন্ডনের আইনি পরাম&lt;/p&gt;</description>

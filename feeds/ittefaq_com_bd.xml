      <guid isPermaLink="true">https://www.ittefaq.com.bd/821724/%E0%A6%A8%E0%A6%A6%E0%A7%80%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%9D%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%96%E0%A7%81%E0%A6%81%E0%A6%9F%E0%A6%BF-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%87-%E0%A6%B9%E0%A6%AC%E0%A7%87-%E0%A7%A8%E0%A7%AB%E0%A7%AC%E0%A6%9F%E0%A6%BF-%E0%A6%A6%E0%A7%80%E0%A6%B0%E0%A7%8D%E0%A6%98-%E0%A6%B8%E0%A7%87%E0%A6%A4%E0%A7%81</guid>

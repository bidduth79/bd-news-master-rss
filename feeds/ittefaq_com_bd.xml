      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/35f74812f9d05defbfc6ce8fc86d312e-6b0a87d95904b.jpg?jadewits_media_id=325304" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/35f74812f9d05defbfc6ce8fc86d312e-6b0a87d95904b.jpg?jadewits_media_id=325304" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/35f74812f9d05defbfc6ce8fc86d312e-6b0a87d95904b.jpg?jadewits_media_id=325304" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিয়ে করতে কুমিল্লায় চীনা যুবক, ফিরিয়ে দিল পরিবার" /&gt;&lt;/p&gt;&lt;p&gt;প্রেমের টানে চীন থেকে কুমিল্লার দেবিদ্বারে প্রেমিকার বাড়িতে এসেছিলেন ৩৫ বছর বয়সী যুবক জেকুইন। তবে প্রেমিকার পরিবারের অসম্মতির কারণে বিয়ে না করেই ফিরতে হয়েছে তাকে। গতকাল শুক্রবার মধ্যরাতে পুলিশের সহযোগিতায় প্রেমিকার বাড়ি ছাড়েন তিনি।
গতকাল শুক্রবার দুপুরে দেবিদ্বার উপজেলার ফতেহাবাদ ইউনিয়নের সুলতানপুর &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823409/%E0%A6%AC%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A7%81%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%9A%E0%A7%80%E0%A6%A8%E0%A6%BE-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%95-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%A6%E0%A6%BF%E0%A6%B2">দৈনিক ইত্তেফাক</source>

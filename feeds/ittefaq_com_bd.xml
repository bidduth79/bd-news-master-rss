      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/cc3c9ec4f8786c26119b77c75dc27e8f-6b05096a04b5e.jpg?jadewits_media_id=324557" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/cc3c9ec4f8786c26119b77c75dc27e8f-6b05096a04b5e.jpg?jadewits_media_id=324557" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/cc3c9ec4f8786c26119b77c75dc27e8f-6b05096a04b5e.jpg?jadewits_media_id=324557" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হুয়াংকে পদে ফেরানোর পর ট্রাম্প বললেন, ‘এটি আমি করিয়েছি’" /&gt;&lt;/p&gt;&lt;p&gt;কৃত্রিম বুদ্ধিমত্তা (এআই) চিপ নির্মাতা প্রতিষ্ঠান এনভিডিয়ার প্রধান নির্বাহী কর্মকর্তা (সিইও) পদে জেনসেন হুয়াংকে ফিরিয়ে আনতে প্রতিষ্ঠানটির পরিচালনা পর্ষদকে নিজেই রাজি করিয়েছেন বলে দাবি করেছেন যুক্তরাষ্ট্রের প্রেসিডেন্ট ডোনাল্ড ট্রাম্প। এ জন্য তিনি সরাসরি পরিচালনা পর্ষদের সঙ্গে কথা বলেছেন বলেও জানিয়েছ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822720/%E0%A6%B9%E0%A7%81%E0%A7%9F%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%A6%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8B%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A7%87%E0%A6%A8-%E2%80%98%E0%A6%8F%E0%A6%9F%E0%A6%BF-%E0%A6%86%E0%A6%AE%E0%A6%BF">দৈনিক ইত্তেফাক</source>

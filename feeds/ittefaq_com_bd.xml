      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/1af49d728433d7c54efdc1fa22e150a6-6b05144dc1e4d.png?jadewits_media_id=324562" length="0" type="image/jpeg" />

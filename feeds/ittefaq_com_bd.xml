      <guid isPermaLink="true">https://www.ittefaq.com.bd/821298/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%B8%E0%A6%B9%E0%A6%BF%E0%A6%82%E0%A6%B8%E0%A6%A4%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Mon, 16 Nov 2026 14:29:56 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/366215adcb0b72764890cb52018d15ff-6afabdd2e342d.jpg?jadewits_media_id=323108" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/366215adcb0b72764890cb52018d15ff-6afabdd2e342d.jpg?jadewits_media_id=323108" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/366215adcb0b72764890cb52018d15ff-6afabdd2e342d.jpg?jadewits_media_id=323108" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গোপালগঞ্জে সহিংসতা নিষিদ্ধ আওয়ামী লীগের দেউলিয়াত্বের প্রমাণ: তথ্যমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;তথ্য ও সম্প্রচারমন্ত্রী ব্যারিস্টার আন্দালিব রহমান পার্থ বলেছেন, গোপালগঞ্জে কার্যক্রম নিষিদ্ধ আওয়ামী লীগের সহিংস কর্মকাণ্ড দলটির দেউলিয়াত্ব প্রমাণ করে। গোপালগঞ্জ ছাড়া আর কোথাও তারা কিছু করতে পারছে না।
সোমবার (১৬ নভেম্বর) তথ্য ও সম্প্রচার মন্ত্রণালয়ের সভাকক্ষে &amp;lsquo;অনলাইন এডিটরস ফোরাম&amp;rsquo;-এর স&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821298/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%B8%E0%A6%B9%E0%A6%BF%E0%A6%82%E0%A6%B8%E0%A6%A4%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>

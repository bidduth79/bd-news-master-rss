    <item>
      <title>সেঞ্চুরিয়ন টেস্টে বৃষ্টির বাগড়া, টস হতে দেরি</title>
      <link>https://www.ittefaq.com.bd/822578/%E0%A6%B8%E0%A7%87%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%A8-%E0%A6%9F%E0%A7%87%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%87-%E0%A6%AC%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%97%E0%A7%9C%E0%A6%BE-%E0%A6%9F%E0%A6%B8-%E0%A6%B9%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%B0%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822578/%E0%A6%B8%E0%A7%87%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%A8-%E0%A6%9F%E0%A7%87%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%87-%E0%A6%AC%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%97%E0%A7%9C%E0%A6%BE-%E0%A6%9F%E0%A6%B8-%E0%A6%B9%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%B0%E0%A6%BF</guid>
      <pubDate>Mon, 23 Nov 2026 14:00:45 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/f34accd93e59d8c5033e112537af58b9-6b03f28f70b65.jpg?jadewits_media_id=324418" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/f34accd93e59d8c5033e112537af58b9-6b03f28f70b65.jpg?jadewits_media_id=324418" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/f34accd93e59d8c5033e112537af58b9-6b03f28f70b65.jpg?jadewits_media_id=324418" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সেঞ্চুরিয়ন টেস্টে বৃষ্টির বাগড়া, টস হতে দেরি" /&gt;&lt;/p&gt;&lt;p&gt;জোহানেসবার্গের পর সেঞ্চুরিয়নে সিরিজের দ্বিতীয় ও শেষ টেস্টে স্বাগতিক দক্ষিণ আফ্রিকার মুখোমুখি হচ্ছে বাংলাদেশ। তবে ম্যাচ শুরুর আগেই বাগড়া দিয়েছে বৃষ্টি। ফলে টসও হতে দেরি হচ্ছে।
সোমবার (২৩ নভেম্বর) বাংলাদেশ সময় বেলা দুইটায় ম্যাচ শুরু হওয়ার কথা। তার আধঘণ্টা আগে টস হওয়ার কথা থাকলেও বৃষ্টির কারণে তা সম্ভব&lt;/p&gt;</description>

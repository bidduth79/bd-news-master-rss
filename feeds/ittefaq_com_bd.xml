      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/e8eee41918226d5e9eb50247ac37c42e-6b0156b240630.jpg?jadewits_media_id=324034" length="0" type="image/jpeg" />

    <item>
      <title>‘ক্রসফায়ারে’ ছাত্রদল নেতা জনি হত্যা মামলায় এসপি আবুল কালাম গ্রেপ্তার</title>
      <link>https://www.ittefaq.com.bd/823229/%E2%80%98%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A6%AB%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%87%E2%80%99-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A6%B2-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%9C%E0%A6%A8%E0%A6%BF-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%8F%E0%A6%B8%E0%A6%AA%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823229/%E2%80%98%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A6%AB%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%87%E2%80%99-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A6%B2-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%9C%E0%A6%A8%E0%A6%BF-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%8F%E0%A6%B8%E0%A6%AA%E0%A6%BF</guid>
      <pubDate>Fri, 27 Nov 2026 11:53:55 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/c486c95764d2f79dadb1d4f37769e8ac-6b091a0337efd.jpg?jadewits_media_id=325119" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/c486c95764d2f79dadb1d4f37769e8ac-6b091a0337efd.jpg?jadewits_media_id=325119" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/c486c95764d2f79dadb1d4f37769e8ac-6b091a0337efd.jpg?jadewits_media_id=325119" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘ক্রসফায়ারে’ ছাত্রদল নেতা জনি হত্যা মামলায় এসপি আবুল কালাম গ্রেপ্তার" /&gt;&lt;/p&gt;&lt;p&gt;খিলগাঁও থানা ছাত্রদলের সাবেক সাধারণ সম্পাদক নুরুজ্জামান জনিকে ‘ক্রসফায়ারের’ নামে হত্যার অভিযোগে মানবতাবিরোধী অপরাধের মামলায় পুলিশ সুপার (এসপি) আবুল কালাম আজাদকে গ্রেপ্তার করেছে পুলিশ ।
বুধবার গাজীপুরের ইন-সার্ভিস ট্রেনিং সেন্টার থেকে ঢাকা মহানগর পুলিশের (ডিএমপি) গোয়েন্দা বিভাগের (ডিবি) সদস্যরা তাকে &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823229/%E2%80%98%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A6%AB%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%87%E2%80%99-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A6%B2-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%9C%E0%A6%A8%E0%A6%BF-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%8F%E0%A6%B8%E0%A6%AA%E0%A6%BF">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>থাইল্যান্ডে তেল শোধনাগারে ভয়াবহ বিস্ফোরণ ও আগুন</title>
      <link>https://www.ittefaq.com.bd/823228/%E0%A6%A5%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A7%87-%E0%A6%A4%E0%A7%87%E0%A6%B2-%E0%A6%B6%E0%A7%8B%E0%A6%A7%E0%A6%A8%E0%A6%BE%E0%A6%97%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%AD%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A6%B9-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%93-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823228/%E0%A6%A5%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A7%87-%E0%A6%A4%E0%A7%87%E0%A6%B2-%E0%A6%B6%E0%A7%8B%E0%A6%A7%E0%A6%A8%E0%A6%BE%E0%A6%97%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%AD%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A6%B9-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%93-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</guid>
      <pubDate>Fri, 27 Nov 2026 11:48:22 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/8ae2216ed98f019ee91176b4367fbbf3-6b0919a379fe5.jpg?jadewits_media_id=325118" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/8ae2216ed98f019ee91176b4367fbbf3-6b0919a379fe5.jpg?jadewits_media_id=325118" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/8ae2216ed98f019ee91176b4367fbbf3-6b0919a379fe5.jpg?jadewits_media_id=325118" style="max-width:100%;height:auto;margin-bottom:10px;" alt="থাইল্যান্ডে তেল শোধনাগারে ভয়াবহ বিস্ফোরণ ও আগুন" /&gt;&lt;/p&gt;&lt;p&gt;থাইল্যান্ডের রাজধানী ব্যাংককের একটি তেল শোধনাগার ও সংরক্ষণাগারে বিস্ফোরণের পর অগ্নিকাণ্ডের ঘটনা ঘটেছে। এতে অন্তত নয়জন আহত হয়েছেন। দুর্ঘটনার পর নিরাপত্তার স্বার্থে স্থাপনাটির আশপাশের বাসিন্দাদের সাময়িকভাবে নিরাপদ স্থানে সরিয়ে নেওয়া হয়।
বৃহস্পতিবার (২৬ নভেম্বর) স্থানীয় সময় বিকেল ৩টার দিকে এ দুর্ঘটনা ঘ&lt;/p&gt;</description>

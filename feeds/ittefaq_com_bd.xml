    <item>
      <title>পাসপোর্ট সূচকে দক্ষিণ এশিয়ায় ষষ্ঠ বাংলাদেশ, বিশ্বে ১৯২তম</title>
      <link>https://www.ittefaq.com.bd/822973/%E0%A6%AA%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%9F-%E0%A6%B8%E0%A7%82%E0%A6%9A%E0%A6%95%E0%A7%87-%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%A3-%E0%A6%8F%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%B7%E0%A6%B7%E0%A7%8D%E0%A6%A0-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822973/%E0%A6%AA%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%9F-%E0%A6%B8%E0%A7%82%E0%A6%9A%E0%A6%95%E0%A7%87-%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%A3-%E0%A6%8F%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%B7%E0%A6%B7%E0%A7%8D%E0%A6%A0-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A7%87</guid>
      <pubDate>Wed, 25 Nov 2026 18:14:10 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/6d28092135d08bab0a83c86cea84baa4-6b06cdb973506.jpg?jadewits_media_id=324833" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/6d28092135d08bab0a83c86cea84baa4-6b06cdb973506.jpg?jadewits_media_id=324833" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/6d28092135d08bab0a83c86cea84baa4-6b06cdb973506.jpg?jadewits_media_id=324833" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পাসপোর্ট সূচকে দক্ষিণ এশিয়ায় ষষ্ঠ বাংলাদেশ, বিশ্বে ১৯২তম" /&gt;&lt;/p&gt;&lt;p&gt;বিশ্বের পাসপোর্টের শক্তি ও ভ্রমণসুবিধা নিয়ে আর্টন ক্যাপিটলের পাসপোর্ট সূচকে বাংলাদেশের অবস্থান ১৯২তম। দক্ষিণ এশিয়ার দেশগুলোর মধ্যে বাংলাদেশের অবস্থান ষষ্ঠ।
বুধবার (২৫ নভেম্বর) প্রতিষ্ঠানটির ওয়েবসাইটে প্রকাশিত হালনাগাদ সূচকে এ তথ্য উঠে এসেছে।
আর্টন ক্যাপিটলের পাসপোর্ট ইনডেক্সে বিশ্বের ১৯৯টি দেশের পাস&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822973/%E0%A6%AA%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%9F-%E0%A6%B8%E0%A7%82%E0%A6%9A%E0%A6%95%E0%A7%87-%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%A3-%E0%A6%8F%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%B7%E0%A6%B7%E0%A7%8D%E0%A6%A0-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>খুলনায় চাঁদার দাবিতে হুমকি, থানায় জিডির পর বাড়িতে গুলি</title>
      <link>https://www.ittefaq.com.bd/822972/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%95%E0%A6%BF-%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%9C%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822972/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%95%E0%A6%BF-%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%9C%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87</guid>
      <pubDate>Wed, 25 Nov 2026 18:10:52 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/ae05364326a3f031235e920d2fc806bf-6b06cf6f1410e.jpg?jadewits_media_id=324834" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/ae05364326a3f031235e920d2fc806bf-6b06cf6f1410e.jpg?jadewits_media_id=324834" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/ae05364326a3f031235e920d2fc806bf-6b06cf6f1410e.jpg?jadewits_media_id=324834" style="max-width:100%;height:auto;margin-bottom:10px;" alt="খুলনায় চাঁদার দাবিতে হুমকি, থানায় জিডির পর বাড়িতে গুলি" /&gt;&lt;/p&gt;&lt;p&gt;খুলনায় আবারও গুলির ঘটনা ঘটেছে। এবার চাঁদার দাবিতে একটি বেসরকারি সংস্থার (এনজিও) এক কর্মকর্তাকে হুমকি এবং এ বিষয়ে থানায় জিডির পর তার বাড়িতে গুলির অভিযোগ উঠেছে।
বুধবার (২৫ নভেম্বর) দুপুরে নগরীর দক্ষিণ টুটপাড়ায় প্রকাশ্যে এই গুলির ঘটনা ঘটেছে বলে ভুক্তভোগী পরিবারটি জানিয়েছে। তবে এতে কোনো হতাহতের ঘটনা ঘটে&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822972/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%95%E0%A6%BF-%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%9C%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>গোপালগঞ্জের সাধারণ মানুষকে ‘গণপ্রতিরোধ’ গড়ে তোলার আহ্বান রাশেদ খাঁনের</title>

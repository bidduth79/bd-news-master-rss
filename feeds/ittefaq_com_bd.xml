    <item>
      <title>‘আন্তালিয়া লিডার্স সামিট’ উদ্বোধনী অনুষ্ঠান শুরু, অংশ নিয়েছেন প্রধানমন্ত্রী তারেক রহমান</title>
      <link>https://www.ittefaq.com.bd/820345/%E2%80%98%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%BE-%E0%A6%B2%E0%A6%BF%E0%A6%A1%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B8-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%BF%E0%A6%9F%E2%80%99-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%8B%E0%A6%A7%E0%A6%A8%E0%A7%80-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A8-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820345/%E2%80%98%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%BE-%E0%A6%B2%E0%A6%BF%E0%A6%A1%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B8-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%BF%E0%A6%9F%E2%80%99-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%8B%E0%A6%A7%E0%A6%A8%E0%A7%80-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A8-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81</guid>
      <pubDate>Wed, 11 Nov 2026 16:20:57 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/f5e826681ca4881c782e52764e81ef03-6af44184c8584.jpg?jadewits_media_id=322135" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/f5e826681ca4881c782e52764e81ef03-6af44184c8584.jpg?jadewits_media_id=322135" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/f5e826681ca4881c782e52764e81ef03-6af44184c8584.jpg?jadewits_media_id=322135" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘আন্তালিয়া লিডার্স সামিট’ উদ্বোধনী অনুষ্ঠান শুরু, অংশ নিয়েছেন প্রধানমন্ত্রী তারেক রহমান" /&gt;&lt;/p&gt;&lt;p&gt;জাতিসংঘ জলবায়ু পরিবর্তনবিষয়ক সম্মেলনে (কপ-৩১) &amp;lsquo;আন্তালিয়া লিডার্স সামিট&amp;rsquo;-এর উদ্বোধনী অধিবেশন শুরু হয়েছে। এতে বিশ্বের বিভিন্ন দেশের রাষ্ট্র ও সরকারপ্রধানের সঙ্গে অংশ নিয়েছেন বাংলাদেশের প্রধানমন্ত্রী তারেক রহমান।
বুধবার (১১ নভেম্বর) তুরস্কের স্থানীয় সময় দুপুর ১২টা ১৫ মিনিটে কপ-৩১ সম্মেলনস্থ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820345/%E2%80%98%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%BE-%E0%A6%B2%E0%A6%BF%E0%A6%A1%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B8-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%BF%E0%A6%9F%E2%80%99-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%8B%E0%A6%A7%E0%A6%A8%E0%A7%80-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A8-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81">দৈনিক ইত্তেফাক</source>
    </item>

      <title>নুসরাত তাবাসসুমের বাড়িতে আগুনের প্রতিবাদে এনসিপির মশাল মিছিল</title>
      <link>https://www.ittefaq.com.bd/820642/%E0%A6%A8%E0%A7%81%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%A4-%E0%A6%A4%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%B8%E0%A7%81%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A7%87-%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820642/%E0%A6%A8%E0%A7%81%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%A4-%E0%A6%A4%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%B8%E0%A7%81%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A7%87-%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF%E0%A6%B0</guid>
      <pubDate>Thu, 12 Nov 2026 21:59:27 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/1d19718d58eb13563885348dc54ef76a-6af5e2207ab66.jpg?jadewits_media_id=322436" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/1d19718d58eb13563885348dc54ef76a-6af5e2207ab66.jpg?jadewits_media_id=322436" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/1d19718d58eb13563885348dc54ef76a-6af5e2207ab66.jpg?jadewits_media_id=322436" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নুসরাত তাবাসসুমের বাড়িতে আগুনের প্রতিবাদে এনসিপির মশাল মিছিল" /&gt;&lt;/p&gt;&lt;p&gt;কুষ্টিয়ার দৌলতপুরে জাতীয় নাগরিক পার্টির (এনসিপি) রাজনৈতিক পর্ষদের সদস্য ও সংসদ সদস্য নুসরাত তাবাসসুম জ্যোতির গ্রামের বাড়িতে অগ্নিসংযোগের প্রতিবাদে মশাল মিছিল করেছেন দলটির নেতাকর্মীরা।
বৃহস্পতিবার (১২ নভেম্বর) রাত পৌনে ৮টার দিকে রাজধানীর বাংলামোটরে এনসিপির কেন্দ্রীয় কার্যালয়ের সামনে থেকে মিছিলটি বের &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820642/%E0%A6%A8%E0%A7%81%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%A4-%E0%A6%A4%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%B8%E0%A7%81%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A7%87-%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>কৃষক কার্ড করতে গিয়ে জানতে পারেন মৃত, ‘জীবিত’ প্রমাণ করতে নির্বাচন অফিসে বৃদ্ধ</title>
      <link>https://www.ittefaq.com.bd/820641/%E0%A6%95%E0%A7%83%E0%A6%B7%E0%A6%95-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A1-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%97%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%A8-%E0%A6%AE%E0%A7%83%E0%A6%A4-%E2%80%98%E0%A6%9C%E0%A7%80%E0%A6%AC%E0%A6%BF%E0%A6%A4%E2%80%99</link>

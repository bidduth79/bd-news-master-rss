      <guid isPermaLink="true">https://www.ittefaq.com.bd/820237/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%82%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A6%AE%E0%A6%BE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A6%AE%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%B2%E0%A6%BE-%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0</guid>
      <pubDate>Tue, 10 Nov 2026 22:45:29 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/b75ef250fcce33c8c25bd9b6aaf78abd-6af349ff99433.jpg?jadewits_media_id=322023" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/b75ef250fcce33c8c25bd9b6aaf78abd-6af349ff99433.jpg?jadewits_media_id=322023" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/b75ef250fcce33c8c25bd9b6aaf78abd-6af349ff99433.jpg?jadewits_media_id=322023" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাংলাদেশের সংবাদমাধ্যমকে নিজের মুখপাতলা স্ত্রীর সঙ্গে তুলনা করলেন শ্রীলঙ্কার কোচ" /&gt;&lt;/p&gt;&lt;p&gt;সাফ চ্যাম্পিয়নশিপে বাংলাদেশের বিপক্ষে বাঁচা-মরার লড়াইয়ের আগে সংবাদ সম্মেলনে এসে এক চোট রসবোধ আর খোঁচায় মেতে উঠলেন শ্রীলঙ্কা জাতীয় ফুটবল দলের কুয়েতি কোচ আবদুল্লাহ আল মুতাইরি। বাংলাদেশের সাংবাদিকদের কৌতূহল ও ভেতরের তথ্য ফাঁসের প্রবণতা বোঝাতে গিয়ে নিজের মুখপাতলা স্ত্রীর পরিবারের সঙ্গে এ দেশের সংবাদমাধ্&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820237/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%82%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A6%AE%E0%A6%BE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A6%AE%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%B2%E0%A6%BE-%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>

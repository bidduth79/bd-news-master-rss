      <guid isPermaLink="true">https://www.ittefaq.com.bd/822585/%E0%A6%95%E0%A6%BF%E0%A6%B6%E0%A7%8B%E0%A6%B0%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%A6%E0%A6%95-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87-%E0%A6%AA%E0%A6%B0%E0%A6%AA%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%9F%E0%A6%BF-%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B2-%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE</guid>
      <pubDate>Mon, 23 Nov 2026 14:31:08 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/0c00c6e27e17ea2649717a9e2001d202-6b03f993a3ca4.jpg?jadewits_media_id=324426" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/0c00c6e27e17ea2649717a9e2001d202-6b03f993a3ca4.jpg?jadewits_media_id=324426" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/0c00c6e27e17ea2649717a9e2001d202-6b03f993a3ca4.jpg?jadewits_media_id=324426" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কিশোরগঞ্জে দুদক কার্যালয়ে পরপর দুটি পেট্রোল বোমা নিক্ষেপ" /&gt;&lt;/p&gt;&lt;p&gt;কিশোরগঞ্জ জেলা দুর্নীতি দমন কমিশন (দুদক) কার্যালয় লক্ষ্য করে পরপর দুটি পেট্রোল বোমা নিক্ষেপ করেছে দুর্বৃত্তরা। বোমা দুটি বারান্দায় পড়ে আগুন জ্বললেও এতে কোনো ক্ষয়ক্ষতি হয়নি।
রোববার (২২ নভেম্বর) রাত ১১টার দিকে শহরের নগুয়া জেলখানা রোড এলাকায় অবস্থিত কার্যালয়ের দ্বিতীয় তলায় এ ঘটনা ঘটে।&amp;nbsp;
কিশোরগঞ্জ জ&lt;/p&gt;</description>

      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/1104716cb52de671f2bd2c159a176312-6b01f959d622a.jpg?jadewits_media_id=324142" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/1104716cb52de671f2bd2c159a176312-6b01f959d622a.jpg?jadewits_media_id=324142" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গুলিস্তান থেকে গাবতলী পাঁচ বাসকেন্দ্রে অব্যবস্থাপনা" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর গণপরিবহনের অন্যতম গুরুত্বপূর্ণ পাঁচটি বাসকেন্দ্র গুলিস্তান, ফুলবাড়িয়া, সায়েদাবাদ, মহাখালী ও গাবতলী। প্রতিদিন হাজার হাজার মানুষ এসব কেন্দ্র ব্যবহার করে দেশের বিভিন্ন গন্তব্যে যাতায়াত করেন। অথচ বিপুলসংখ্যক যাত্রীর চাপ সামাল দেওয়ার মতো পরিকল্পিত ব্যবস্থাপনা ও প্রয়োজনীয় সুযোগ-সুবিধা গড়ে ওঠেনি। &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822303/%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%97%E0%A6%BE%E0%A6%AC%E0%A6%A4%E0%A6%B2%E0%A7%80-%E0%A6%AA%E0%A6%BE%E0%A6%81%E0%A6%9A-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%95%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%87">দৈনিক ইত্তেফাক</source>

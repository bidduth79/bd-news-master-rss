    <item>
      <title>বর্তমান সরকারের সময়ে ১৩৪৪ সাংবাদিককে ৬ কোটি ৪৮ লাখ টাকা অনুদান</title>
      <link>https://www.ittefaq.com.bd/820658/%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A7%9F%E0%A7%87-%E0%A7%A7%E0%A7%A9%E0%A7%AA%E0%A7%AA-%E0%A6%B8%E0%A6%BE%E0%A6%82%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A6%BF%E0%A6%95%E0%A6%95%E0%A7%87-%E0%A7%AC-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A7%AA%E0%A7%AE-%E0%A6%B2%E0%A6%BE%E0%A6%96</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820658/%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A7%9F%E0%A7%87-%E0%A7%A7%E0%A7%A9%E0%A7%AA%E0%A7%AA-%E0%A6%B8%E0%A6%BE%E0%A6%82%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A6%BF%E0%A6%95%E0%A6%95%E0%A7%87-%E0%A7%AC-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A7%AA%E0%A7%AE-%E0%A6%B2%E0%A6%BE%E0%A6%96</guid>
      <pubDate>Fri, 13 Nov 2026 01:08:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/57ee58dbea7615b4be68d99cf119acff-6af605ba459ba.jpg?jadewits_media_id=322452" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/57ee58dbea7615b4be68d99cf119acff-6af605ba459ba.jpg?jadewits_media_id=322452" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/57ee58dbea7615b4be68d99cf119acff-6af605ba459ba.jpg?jadewits_media_id=322452" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বর্তমান সরকারের সময়ে ১৩৪৪ সাংবাদিককে ৬ কোটি ৪৮ লাখ টাকা অনুদান" /&gt;&lt;/p&gt;&lt;p&gt;বর্তমান সরকারের সময়ে ১ হাজার ৩৪৪ জন সাংবাদিককে মোট ৬ কোটি ৪৮ লাখ ৫ হাজার টাকা কল্যাণ অনুদান দেওয়া হয়েছে। এছাড়া ২০২৫-২৬ অর্থবছরে সাংবাদিক পরিবারের ৪০২ জন শিক্ষার্থীকে ৭৩ লাখ ২৬ হাজার টাকা শিক্ষাবৃত্তি প্রদান করা হয়েছে। 
বৃহস্পতিবার (১২ নভেম্বর) জাতীয় সংসদে এক লিখিত প্রশ্নের জবাবে তথ্য ও সম্প্রচার প্&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820658/%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A7%9F%E0%A7%87-%E0%A7%A7%E0%A7%A9%E0%A7%AA%E0%A7%AA-%E0%A6%B8%E0%A6%BE%E0%A6%82%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A6%BF%E0%A6%95%E0%A6%95%E0%A7%87-%E0%A7%AC-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A7%AA%E0%A7%AE-%E0%A6%B2%E0%A6%BE%E0%A6%96">দৈনিক ইত্তেফাক</source>

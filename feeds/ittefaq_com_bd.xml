    <item>
      <title>গোপালগঞ্জে বেশির ভাগ মোবাইল ব্যাংকিং বন্ধ, ট্রেন চলাচল ও সরকারি বরাদ্দে স্থবিরতা</title>
      <link>https://www.ittefaq.com.bd/823319/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%BF%E0%A6%B0-%E0%A6%AD%E0%A6%BE%E0%A6%97-%E0%A6%AE%E0%A7%8B%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%B2-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A6%BF%E0%A6%82-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823319/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%BF%E0%A6%B0-%E0%A6%AD%E0%A6%BE%E0%A6%97-%E0%A6%AE%E0%A7%8B%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%B2-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A6%BF%E0%A6%82-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Fri, 27 Nov 2026 22:50:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/88072f1574fc9eac797bbd2f683a121a-6b09b4ab7450c.jpg?jadewits_media_id=325214" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/88072f1574fc9eac797bbd2f683a121a-6b09b4ab7450c.jpg?jadewits_media_id=325214" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/88072f1574fc9eac797bbd2f683a121a-6b09b4ab7450c.jpg?jadewits_media_id=325214" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গোপালগঞ্জে বেশির ভাগ মোবাইল ব্যাংকিং বন্ধ, ট্রেন চলাচল ও সরকারি বরাদ্দে স্থবিরতা" /&gt;&lt;/p&gt;&lt;p&gt;নাশকতা ও সন্দেহজনক লেনদেনের অভিযোগের পরিপ্রেক্ষিতে গোপালগঞ্জে মোবাইল ব্যাংকিং সেবা সাময়িকভাবে বন্ধ করে দেওয়া হয়েছে। এর আগেই গত ১৫ নভেম্বর থেকে সহিংসতার জেরে জেলাটিতে ট্রেন চলাচল বন্ধ রাখা হয়েছে, পাশাপাশি পুড়ে যাওয়া দুটি থানার কার্যক্রম চালুর বিষয়টিও অনিশ্চিত হয়ে পড়েছে এবং স্থানীয় সরকার প্র&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823319/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%BF%E0%A6%B0-%E0%A6%AD%E0%A6%BE%E0%A6%97-%E0%A6%AE%E0%A7%8B%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%B2-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A6%BF%E0%A6%82-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A8">দৈনিক ইত্তেফাক</source>

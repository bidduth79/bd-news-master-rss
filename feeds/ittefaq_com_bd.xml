    <item>
      <title>শর্তসাপেক্ষে ধর্মঘট প্রত্যাহার, ৫ ঘণ্টা পর শরীয়তপুর-চাঁদপুর নৌরুটে ফেরি চলাচল শুরু</title>
      <link>https://www.ittefaq.com.bd/820930/%E0%A6%B6%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%B8%E0%A6%BE%E0%A6%AA%E0%A7%87%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87-%E0%A6%A7%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%98%E0%A6%9F-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%B0-%E0%A7%AB-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%AA%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820930/%E0%A6%B6%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%B8%E0%A6%BE%E0%A6%AA%E0%A7%87%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87-%E0%A6%A7%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%98%E0%A6%9F-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%B0-%E0%A7%AB-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%AA%E0%A6%B0</guid>
      <pubDate>Sat, 14 Nov 2026 15:43:06 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/f2e9051e6f0e3f22aa8f866101860168-6af82c9ccf727.jpg?jadewits_media_id=322728" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/f2e9051e6f0e3f22aa8f866101860168-6af82c9ccf727.jpg?jadewits_media_id=322728" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/f2e9051e6f0e3f22aa8f866101860168-6af82c9ccf727.jpg?jadewits_media_id=322728" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শর্তসাপেক্ষে ধর্মঘট প্রত্যাহার, ৫ ঘণ্টা পর শরীয়তপুর-চাঁদপুর নৌরুটে ফেরি চলাচল শুরু" /&gt;&lt;/p&gt;&lt;p&gt;ফেরি কাকলীর প্রথম শ্রেণির মাস্টার মোশাররফ হোসেনকে গ্রেপ্তারের প্রতিবাদে বন্ধ থাকা শরীয়তপুর-চাঁদপুর নৌ-রুটে ফেরি চলাচল পাঁচ ঘণ্টা পর স্বাভাবিক হয়েছে।
বিআইডব্লিউটিসির চেয়ারম্যান আব্দুল বারী ড্যানির শর্তসাপেক্ষ আশ্বাসের পর শনিবার (১৪ নভেম্বর) বেলা ১১টার দিকে কর্মবিরতি প্রত্যাহার করে ফেরি চলাচল স্বাভাবি&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820930/%E0%A6%B6%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%B8%E0%A6%BE%E0%A6%AA%E0%A7%87%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87-%E0%A6%A7%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%98%E0%A6%9F-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%B0-%E0%A7%AB-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%AA%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>

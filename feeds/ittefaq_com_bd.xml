      <guid isPermaLink="true">https://www.ittefaq.com.bd/820335/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A5%E0%A6%AE%E0%A6%BF%E0%A6%95-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%95%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A6%BF%E0%A6%B0-%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A6%BE</guid>
      <pubDate>Wed, 11 Nov 2026 15:39:46 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/1cdb78860b7d5998977617af82540fae-6af4375062127.jpg?jadewits_media_id=322122" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/1cdb78860b7d5998977617af82540fae-6af4375062127.jpg?jadewits_media_id=322122" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/1cdb78860b7d5998977617af82540fae-6af4375062127.jpg?jadewits_media_id=322122" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রাথমিক বিদ্যালয়ের শিক্ষকদের বদলির নীতিমালা উপজেলা-জেলা-বিভাগীয় পর্যায়ে ডিসেন্ট্রালাইজ করেছি" /&gt;&lt;/p&gt;&lt;p&gt;প্রাথমিক বিদ্যালয়ের শিক্ষকদের বদলি নিয়ে সংসদে কথা বলেছেন শিক্ষা এবং প্রাথমিক ও গণশিক্ষামন্ত্রী ড. আ ন ম এহছানুল হক মিলন।&amp;nbsp;
তিনি বলেন, প্রাথমিক বিদ্যালয়ের শিক্ষকদের বদলি নীতিমালা ইতোমধ্যে আমরা উপজেলা, জেলা এবং বিভাগীয় পর্যায়ে ডিসেন্ট্রালাইজ করেছি। এখন শুধু এক ডিভিশন থেকে আরেক ডিভিশনে মন্ত্রণালয় থ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820335/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A5%E0%A6%AE%E0%A6%BF%E0%A6%95-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%95%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A6%BF%E0%A6%B0-%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A6%BE">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>স্কুলে ভর্তি: লটারি শুধু প্রথম শ্রেণিতে, বাকিদের লিখিত পরীক্ষা</title>

    <item>
      <title>শেখ হাসিনা দেশে ফিরছেন না, জয়সওয়ালের কথায় তা স্পষ্ট: রাশেদ খাঁন</title>
      <link>https://www.ittefaq.com.bd/823042/%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%A8%E0%A6%BE-%E0%A6%9C%E0%A7%9F%E0%A6%B8%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%A5%E0%A6%BE%E0%A7%9F-%E0%A6%A4%E0%A6%BE</link>

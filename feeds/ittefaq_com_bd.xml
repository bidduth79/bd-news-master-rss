    <item>
      <title>১৩ হাজার ৯৩৫ প্রবাসীকে নিজ দেশে ফেরত পাঠাল সৌদি আরব</title>
      <link>https://www.ittefaq.com.bd/823481/%E0%A7%A7%E0%A7%A9-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A7%AF%E0%A7%A9%E0%A7%AB-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%9C-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%A4-%E0%A6%AA%E0%A6%BE%E0%A6%A0%E0%A6%BE%E0%A6%B2-%E0%A6%B8%E0%A7%8C%E0%A6%A6%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823481/%E0%A7%A7%E0%A7%A9-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A7%AF%E0%A7%A9%E0%A7%AB-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%9C-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%A4-%E0%A6%AA%E0%A6%BE%E0%A6%A0%E0%A6%BE%E0%A6%B2-%E0%A6%B8%E0%A7%8C%E0%A6%A6%E0%A6%BF</guid>
      <pubDate>Sat, 28 Nov 2026 21:46:10 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/063c6732e7e69c322f56e90edcf47add-6b0af7067baa5.jpg?jadewits_media_id=325379" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/063c6732e7e69c322f56e90edcf47add-6b0af7067baa5.jpg?jadewits_media_id=325379" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/063c6732e7e69c322f56e90edcf47add-6b0af7067baa5.jpg?jadewits_media_id=325379" style="max-width:100%;height:auto;margin-bottom:10px;" alt="১৩ হাজার ৯৩৫ প্রবাসীকে নিজ দেশে ফেরত পাঠাল সৌদি আরব" /&gt;&lt;/p&gt;&lt;p&gt;সৌদি আরবে আবাসন, শ্রম ও সীমান্ত নিরাপত্তা আইন লঙ্ঘনের অভিযোগে এক সপ্তাহে ৯ হাজার ১৬৯ জনকে গ্রেপ্তার করেছে দেশটির আইনশৃঙ্খলা রক্ষাকারী বাহিনী। একই সময়ে বিভিন্ন অপরাধে জড়িত ১৩ হাজার ৯৩৫ জন প্রবাসীকে নিজ নিজ দেশে ফেরত পাঠানো হয়েছে।
শনিবার (২৮ নভেম্বর) গালফ নিউজের এক প্রতিবেদনে সৌদি আরবের স্বরাষ্ট্র মন্&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823481/%E0%A7%A7%E0%A7%A9-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A7%AF%E0%A7%A9%E0%A7%AB-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%9C-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%A4-%E0%A6%AA%E0%A6%BE%E0%A6%A0%E0%A6%BE%E0%A6%B2-%E0%A6%B8%E0%A7%8C%E0%A6%A6%E0%A6%BF">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>মালয়েশিয়ার প্রধানমন্ত্রীর ঢাকা সফর স্থগিত</title>

      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/e6cb00a660e612f2b83f4f9631e9bbcd-6b05175cf1714.jpg?jadewits_media_id=324565" length="0" type="image/jpeg" />

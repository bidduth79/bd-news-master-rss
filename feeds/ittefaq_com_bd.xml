    <item>
      <title>ছয় মাসের জন্য সিসিটির দায়িত্ব পেল এমপি পারিবারিক প্রতিষ্ঠান এভারেস্ট</title>
      <link>https://www.ittefaq.com.bd/822695/%E0%A6%9B%E0%A7%9F-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A6%BF%E0%A6%B8%E0%A6%BF%E0%A6%9F%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A7%9F%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%AC-%E0%A6%AA%E0%A7%87%E0%A6%B2-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%95</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822695/%E0%A6%9B%E0%A7%9F-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A6%BF%E0%A6%B8%E0%A6%BF%E0%A6%9F%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A7%9F%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%AC-%E0%A6%AA%E0%A7%87%E0%A6%B2-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%95</guid>
      <pubDate>Tue, 24 Nov 2026 02:59:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/0209724c6d78e0baf40bd336a2b4e78b-6b049c237a099.jpg?jadewits_media_id=324536" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/0209724c6d78e0baf40bd336a2b4e78b-6b049c237a099.jpg?jadewits_media_id=324536" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/0209724c6d78e0baf40bd336a2b4e78b-6b049c237a099.jpg?jadewits_media_id=324536" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ছয় মাসের জন্য সিসিটির দায়িত্ব পেল এমপি পারিবারিক প্রতিষ্ঠান এভারেস্ট" /&gt;&lt;/p&gt;&lt;p&gt;দরপত্রের মাধ্যমে চট্টগ্রাম বন্দরের গুরুত্বপূর্ণ স্থাপনা চিটাগং কনটেইনার টার্মিনাল (সিসিটি) ছয় মাস পরিচালনার দায়িত্ব পেয়েছে এভারেস্ট পোর্ট সার্ভিসেস। সোমবার (২৩ নভেম্বর) প্রতিষ্ঠানটির সঙ্গে আনুষ্ঠানিক চুক্তি স্বাক্ষর করেছে চট্টগ্রাম বন্দর কর্তৃপক্ষ (চবক)।
চুক্তি অনুযায়ী, সোমবার দিবাগত রাত ১২টায় &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822695/%E0%A6%9B%E0%A7%9F-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A6%BF%E0%A6%B8%E0%A6%BF%E0%A6%9F%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A7%9F%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%AC-%E0%A6%AA%E0%A7%87%E0%A6%B2-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%95">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>ধ্রুব রাঠির বিরুদ্ধে জামিন অযোগ্য গ্রেপ্তারি পরোয়ানা</title>
      <link>https://www.ittefaq.com.bd/822694/%E0%A6%A7%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%AC-%E0%A6%B0%E0%A6%BE%E0%A6%A0%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BF%E0%A6%A8-%E0%A6%85%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%8D%E0%A6%AF-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822694/%E0%A6%A7%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%AC-%E0%A6%B0%E0%A6%BE%E0%A6%A0%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BF%E0%A6%A8-%E0%A6%85%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%8D%E0%A6%AF-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%BF</guid>
      <pubDate>Tue, 24 Nov 2026 02:28:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/2759c37bf60615edde4388a256b85821-6b049acb0e96e.jpg?jadewits_media_id=324535" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/2759c37bf60615edde4388a256b85821-6b049acb0e96e.jpg?jadewits_media_id=324535" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/2759c37bf60615edde4388a256b85821-6b049acb0e96e.jpg?jadewits_media_id=324535" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ধ্রুব রাঠির বিরুদ্ধে জামিন অযোগ্য গ্রেপ্তারি পরোয়ানা" /&gt;&lt;/p&gt;&lt;p&gt;একটি মানহানির মামলায় ভারতীয় ইউটিউবার ধ্রুব রাঠির বিরুদ্ধে জামিন অযোগ্য গ্রেপ্তারি পরোয়ানা জারি করেছেন দিল্লির একটি আদালত। সোমবার (২৩ নভেম্বর) দিল্লির সাকেত আদালতের জুডিশিয়াল ম্যাজিস্ট্রেট আনাম রইস খান এই পরোয়ানা জারি করেন এবং মামলার পরবর্তী শুনানির জন্য আগামী ৩ ডিসেম্বর দিন নির্ধারণ করেন। এনডিট&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822694/%E0%A6%A7%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%AC-%E0%A6%B0%E0%A6%BE%E0%A6%A0%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BF%E0%A6%A8-%E0%A6%85%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%8D%E0%A6%AF-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%BF">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>অভিনেত্রী জ্যোতিকা জ্যোতিকে ১০ দিনের রিমান্ডে নিতে ডিবির আবেদন</title>
      <link>https://www.ittefaq.com.bd/822693/%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A6%BE-%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A7%87-%E0%A7%A7%E0%A7%A6-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%A4%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822693/%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A6%BE-%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A7%87-%E0%A7%A7%E0%A7%A6-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%A4%E0%A7%87</guid>
      <pubDate>Tue, 24 Nov 2026 01:48:35 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/725795f21a21dcc7c803464033884165-6b04984bb77ec.jpg?jadewits_media_id=324534" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/725795f21a21dcc7c803464033884165-6b04984bb77ec.jpg?jadewits_media_id=324534" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/725795f21a21dcc7c803464033884165-6b04984bb77ec.jpg?jadewits_media_id=324534" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অভিনেত্রী জ্যোতিকা জ্যোতিকে ১০ দিনের রিমান্ডে নিতে ডিবির আবেদন" /&gt;&lt;/p&gt;&lt;p&gt;জুলাই আন্দোলনের বিপক্ষে অবস্থান নিয়ে আওয়ামী লীগকে অর্থের জোগান দেওয়ার অভিযোগে করা মামলায় গ্রেপ্তার অভিনেত্রী জ্যোতিকা জ্যোতিকে ১০ দিনের রিমান্ডে নিয়ে জিজ্ঞাসাবাদের আবেদন করেছে গোয়েন্দা পুলিশ (ডিবি)। মামলার তদন্তে তাঁর কথিত সংশ্লিষ্টতা যাচাই, অর্থের জোগান ও যোগাযোগের তথ্য সংগ্রহসহ পাঁচটি কারণ দ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822693/%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A6%BE-%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A7%87-%E0%A7%A7%E0%A7%A6-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%A4%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>

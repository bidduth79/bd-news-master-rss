      <guid isPermaLink="true">https://www.ittefaq.com.bd/822403/%E0%A6%B0%E0%A7%87%E0%A6%B2%E0%A6%93%E0%A7%9F%E0%A7%87%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%8B%E0%A6%97-%E0%A6%9C%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A4%E0%A6%BF-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%9C%E0%A6%BF%E0%A6%8F%E0%A6%AE%E0%A6%B8%E0%A6%B9-%E0%A6%A6%E0%A7%81%E0%A6%87</guid>
      <pubDate>Sun, 22 Nov 2026 16:15:07 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/ca36e4b875014edaf0cfb0f0d298cc6e-6b02c070cea99.jpg?jadewits_media_id=324246" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/ca36e4b875014edaf0cfb0f0d298cc6e-6b02c070cea99.jpg?jadewits_media_id=324246" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/ca36e4b875014edaf0cfb0f0d298cc6e-6b02c070cea99.jpg?jadewits_media_id=324246" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রেলওয়েতে নিয়োগ জালিয়াতি, সাবেক জিএমসহ দুই কর্মকর্তার কারাদণ্ড" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ রেলওয়ের রেকর্ড কিপার পদে নিয়োগ পরীক্ষার নম্বরপত্রে ঘষামাজা ও জালিয়াতির মাধ্যমে একজনকে চাকরি দেওয়ার মামলায় রেলওয়ে পূর্বাঞ্চলের সাবেক দুই কর্মকর্তাকে কারাদণ্ড দিয়েছেন আদালত। একই মামলায় সরোয়ার হোসেন নামের এক আসামিকে খালাস দেওয়া হয়েছে।
রোববার (২২ নভেম্বর) চট্টগ্রাম বিভাগীয় বিশেষ জজ আদালতের বিচা&lt;/p&gt;</description>

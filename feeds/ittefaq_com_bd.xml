      <guid isPermaLink="true">https://www.ittefaq.com.bd/822583/%E0%A6%AF%E0%A6%B6%E0%A7%8B%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%AB%E0%A7%8B%E0%A6%A8%E0%A7%87-%E0%A6%95%E0%A6%A5%E0%A6%BE-%E0%A6%AC%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%95%E0%A6%AC%E0%A7%8D%E0%A6%9C%E0%A6%BF</guid>
      <pubDate>Mon, 23 Nov 2026 14:20:05 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/93a3b94ea71eeff6f1f1982e08431911-6b03f7106e8c2.jpg?jadewits_media_id=324423" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/93a3b94ea71eeff6f1f1982e08431911-6b03f7106e8c2.jpg?jadewits_media_id=324423" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/93a3b94ea71eeff6f1f1982e08431911-6b03f7106e8c2.jpg?jadewits_media_id=324423" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যশোরে মায়ের সঙ্গে ফোনে কথা বলায় স্ত্রীর কব্জি বিচ্ছিন্নের অভিযোগ স্বামীর বিরুদ্ধে" /&gt;&lt;/p&gt;&lt;p&gt;যশোরে মায়ের সঙ্গে মুঠোফোনে কথা বলাকে কেন্দ্র করে তিথি (৩০) নামে এক গৃহবধূর বাম হাতের কব্জি ধারালো দা দিয়ে কেটে বিচ্ছিন্ন করার অভিযোগ উঠেছে তার স্বামী বিল্লালের (৪০) বিরুদ্ধে।
রোববার (২২ নভেম্বর) রাত ১০টার দিকে যশোর শহরের চাঁচড়া ডালমিল এলাকার একটি ভাড়া বাসায় এ ঘটনা ঘটে।&amp;nbsp;
ভুক্তভোগী ও স্থানীয় সূত্&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822583/%E0%A6%AF%E0%A6%B6%E0%A7%8B%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%AB%E0%A7%8B%E0%A6%A8%E0%A7%87-%E0%A6%95%E0%A6%A5%E0%A6%BE-%E0%A6%AC%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%95%E0%A6%AC%E0%A7%8D%E0%A6%9C%E0%A6%BF">দৈনিক ইত্তেফাক</source>

    <item>
      <title>হোয়াটসঅ্যাপে আসছে ‘ডুয়াল ক্যামেরা মোড’</title>
      <link>https://www.ittefaq.com.bd/823048/%E0%A6%B9%E0%A7%8B%E0%A7%9F%E0%A6%BE%E0%A6%9F%E0%A6%B8%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AA%E0%A7%87-%E0%A6%86%E0%A6%B8%E0%A6%9B%E0%A7%87-%E2%80%98%E0%A6%A1%E0%A7%81%E0%A7%9F%E0%A6%BE%E0%A6%B2-%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%B0%E0%A6%BE-%E0%A6%AE%E0%A7%8B%E0%A6%A1%E2%80%99</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823048/%E0%A6%B9%E0%A7%8B%E0%A7%9F%E0%A6%BE%E0%A6%9F%E0%A6%B8%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AA%E0%A7%87-%E0%A6%86%E0%A6%B8%E0%A6%9B%E0%A7%87-%E2%80%98%E0%A6%A1%E0%A7%81%E0%A7%9F%E0%A6%BE%E0%A6%B2-%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%B0%E0%A6%BE-%E0%A6%AE%E0%A7%8B%E0%A6%A1%E2%80%99</guid>

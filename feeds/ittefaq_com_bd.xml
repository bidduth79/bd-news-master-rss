      <guid isPermaLink="true">https://www.ittefaq.com.bd/821522/%E0%A6%AC%E0%A6%BE%E0%A6%95%E0%A6%B6%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%8F%E0%A6%95%E0%A6%9F%E0%A6%BF-%E0%A6%85%E0%A6%82%E0%A6%B6%E0%A6%87-%E0%A7%A7%E0%A7%AB-%E0%A6%86%E0%A6%97%E0%A6%B8%E0%A7%8D%E0%A6%9F-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%A3%E0%A7%8D%E0%A6%A1-%E0%A6%98%E0%A6%9F%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A7%87</guid>

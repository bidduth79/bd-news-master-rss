    <item>
      <title>দণ্ডিত শেখ হাসিনাকে পাসপোর্ট দেওয়ার সুযোগ নেই: চিফ প্রসিকিউটর</title>
      <link>https://www.ittefaq.com.bd/820117/%E0%A6%A6%E0%A6%A3%E0%A7%8D%E0%A6%A1%E0%A6%BF%E0%A6%A4-%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%9F-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%81%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%9A%E0%A6%BF%E0%A6%AB</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820117/%E0%A6%A6%E0%A6%A3%E0%A7%8D%E0%A6%A1%E0%A6%BF%E0%A6%A4-%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%9F-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%81%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%9A%E0%A6%BF%E0%A6%AB</guid>
      <pubDate>Tue, 10 Nov 2026 14:03:45 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/e88545a666e83cf006d2bdf4eedbf465-6af2ce56cb63e.png?jadewits_media_id=321905" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/e88545a666e83cf006d2bdf4eedbf465-6af2ce56cb63e.png?jadewits_media_id=321905" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/e88545a666e83cf006d2bdf4eedbf465-6af2ce56cb63e.png?jadewits_media_id=321905" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দণ্ডিত শেখ হাসিনাকে পাসপোর্ট দেওয়ার সুযোগ নেই: চিফ প্রসিকিউটর" /&gt;&lt;/p&gt;&lt;p&gt;দণ্ডিত ও দেশের বাইরে পলাতক থাকায় ছাত্র-জনতার গণ-অভ্যুত্থানে ক্ষমতাচ্যুত সাবেক প্রধানমন্ত্রী শেখ হাসিনার পাসপোর্ট ও জাতীয় পরিচয়পত্র (এনআইডি) চাওয়ার কোনো আইনগত সুযোগ নেই বলে জানিয়েছেন আন্তর্জাতিক অপরাধ ট্রাইব্যুনালের চিফ প্রসিকিউটর আমিনুল ইসলাম। তিনি স্পষ্ট করেছেন, ন্যূনতম দুই বছরের সাজা হলে আইন অনুযা&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820117/%E0%A6%A6%E0%A6%A3%E0%A7%8D%E0%A6%A1%E0%A6%BF%E0%A6%A4-%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%9F-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%81%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%9A%E0%A6%BF%E0%A6%AB">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>ইয়েমেনে ৭৩ ঘণ্টায় হুথি হামলায় নিহত ৩৩</title>
      <link>https://www.ittefaq.com.bd/820116/%E0%A6%87%E0%A7%9F%E0%A7%87%E0%A6%AE%E0%A7%87%E0%A6%A8%E0%A7%87-%E0%A7%AD%E0%A7%A9-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%B9%E0%A7%81%E0%A6%A5%E0%A6%BF-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A7%A9%E0%A7%A9</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820116/%E0%A6%87%E0%A7%9F%E0%A7%87%E0%A6%AE%E0%A7%87%E0%A6%A8%E0%A7%87-%E0%A7%AD%E0%A7%A9-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%B9%E0%A7%81%E0%A6%A5%E0%A6%BF-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A7%A9%E0%A7%A9</guid>
      <pubDate>Tue, 10 Nov 2026 13:58:25 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/10dcbe0bdd8334ed569b6e52229995b5-6af2ce1f0a5c8.jpg?jadewits_media_id=321904" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/10dcbe0bdd8334ed569b6e52229995b5-6af2ce1f0a5c8.jpg?jadewits_media_id=321904" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/10dcbe0bdd8334ed569b6e52229995b5-6af2ce1f0a5c8.jpg?jadewits_media_id=321904" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইয়েমেনে ৭৩ ঘণ্টায় হুথি হামলায় নিহত ৩৩" /&gt;&lt;/p&gt;&lt;p&gt;ইয়েমেনের তাইজ প্রদেশে হুথিদের চালানো হামলায় ৭৩ ঘণ্টায় অন্তত ৩৩ জন বেসামরিক নাগরিক নিহত এবং ৫৮ জন আহত হয়েছেন বলে জানিয়েছে একটি মানবাধিকার সংস্থা। সোমবার (৯ নভেম্বর) প্রকাশিত এক প্রতিবেদনে ইয়েমেনি নেটওয়ার্ক ফর রাইটস অ্যান্ড ফ্রিডমসের পক্ষ থেকে এই তথ্য জানানো হয়েছে।
প্রতিষ্ঠানটি জানিয়েছে, তারা &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820116/%E0%A6%87%E0%A7%9F%E0%A7%87%E0%A6%AE%E0%A7%87%E0%A6%A8%E0%A7%87-%E0%A7%AD%E0%A7%A9-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%B9%E0%A7%81%E0%A6%A5%E0%A6%BF-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A7%A9%E0%A7%A9">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>২০২৬ সালের ‘গোল্ডেন বয়’ পুরস্কার জিতলেন পাউ কুবারসি</title>
      <link>https://www.ittefaq.com.bd/820115/%E0%A7%A8%E0%A7%A6%E0%A7%A8%E0%A7%AC-%E0%A6%B8%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E2%80%98%E0%A6%97%E0%A7%8B%E0%A6%B2%E0%A7%8D%E0%A6%A1%E0%A7%87%E0%A6%A8-%E0%A6%AC%E0%A7%9F%E2%80%99-%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A6%BF%E0%A6%A4%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AA%E0%A6%BE%E0%A6%89</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820115/%E0%A7%A8%E0%A7%A6%E0%A7%A8%E0%A7%AC-%E0%A6%B8%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E2%80%98%E0%A6%97%E0%A7%8B%E0%A6%B2%E0%A7%8D%E0%A6%A1%E0%A7%87%E0%A6%A8-%E0%A6%AC%E0%A7%9F%E2%80%99-%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A6%BF%E0%A6%A4%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AA%E0%A6%BE%E0%A6%89</guid>
      <pubDate>Tue, 10 Nov 2026 13:53:53 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/78e8be96aa48d95d53e24bdd88b136ce-6af2cced590b1.jpg?jadewits_media_id=321903" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/78e8be96aa48d95d53e24bdd88b136ce-6af2cced590b1.jpg?jadewits_media_id=321903" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/78e8be96aa48d95d53e24bdd88b136ce-6af2cced590b1.jpg?jadewits_media_id=321903" style="max-width:100%;height:auto;margin-bottom:10px;" alt="২০২৬ সালের ‘গোল্ডেন বয়’ পুরস্কার জিতলেন পাউ কুবারসি" /&gt;&lt;/p&gt;&lt;p&gt;ইউরোপের অনূর্ধ্ব-২১ বর্ষসেরা ফুটবলারের পুরস্কার &amp;lsquo;গোল্ডেন বয়&amp;rsquo; জিতেছেন স্পেন ও বার্সেলোনার তরুণ ডিফেন্ডার পাউ কুবারসি। আর্জেন্টিনার দুই প্রতিভাবান ফুটবলার ফ্রাঙ্কো মাস্তানতুয়োনো ও জিয়ানলুকা প্রেস্টিয়ানিকে পেছনে ফেলে ২০২৬ সালের এই পুরস্কার জিতেছেন ১৯ বছর বয়সী এই স্প্যানিশ তারকা।
ইউরোপজুড়ে &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820115/%E0%A7%A8%E0%A7%A6%E0%A7%A8%E0%A7%AC-%E0%A6%B8%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E2%80%98%E0%A6%97%E0%A7%8B%E0%A6%B2%E0%A7%8D%E0%A6%A1%E0%A7%87%E0%A6%A8-%E0%A6%AC%E0%A7%9F%E2%80%99-%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A6%BF%E0%A6%A4%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AA%E0%A6%BE%E0%A6%89">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>শেখ হাসিনা বেঁচে আছেন, নাকি মারা গেছেন তাও জানি না: নুরুল হক</title>
      <link>https://www.ittefaq.com.bd/820114/%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE-%E0%A6%AC%E0%A7%87%E0%A6%81%E0%A6%9A%E0%A7%87-%E0%A6%86%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%A8%E0%A6%BE%E0%A6%95%E0%A6%BF-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%97%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%A4%E0%A6%BE%E0%A6%93-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820114/%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE-%E0%A6%AC%E0%A7%87%E0%A6%81%E0%A6%9A%E0%A7%87-%E0%A6%86%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%A8%E0%A6%BE%E0%A6%95%E0%A6%BF-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%97%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%A4%E0%A6%BE%E0%A6%93-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BF</guid>
      <pubDate>Tue, 10 Nov 2026 13:54:34 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/05e850035c1490ab2083bd5f76b62551-6af2cbd7a78d7.jpg?jadewits_media_id=321902" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/05e850035c1490ab2083bd5f76b62551-6af2cbd7a78d7.jpg?jadewits_media_id=321902" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/05e850035c1490ab2083bd5f76b62551-6af2cbd7a78d7.jpg?jadewits_media_id=321902" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শেখ হাসিনা বেঁচে আছেন, নাকি মারা গেছেন তাও জানি না: নুরুল হক" /&gt;&lt;/p&gt;&lt;p&gt;পলাতক শেখ হাসিনা বিভিন্ন সময়ে কথা বলছেন- এটা কী এইআই নাকি বাস্তব আমরা কিন্তু জানি না৷ তিনি বেঁচে আছেন, নাকি মারা গেছেন তাও জানি না বলে মন্তব্য করেছেন প্রবাসী কল্যাণ ও বৈদেশিক কর্মসংস্থান প্রতিমন্ত্রী নুরুল হক নুর।
মঙ্গলবার (১০ নভেম্বর) জাতীয় বিপ্লব ও সংহতি দিবস উপলক্ষে ঢাকা রিপোর্টার্স ইউনিটিতে এক অ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820114/%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE-%E0%A6%AC%E0%A7%87%E0%A6%81%E0%A6%9A%E0%A7%87-%E0%A6%86%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%A8%E0%A6%BE%E0%A6%95%E0%A6%BF-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%97%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%A4%E0%A6%BE%E0%A6%93-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BF">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>মানবতাবিরোধী অপরাধে দণ্ডপ্রাপ্ত শেখ হাসিনার পাসপোর্ট ইস্যুর সুযোগ নেই: চিফ প্রসিকিউটর</title>
      <link>https://www.ittefaq.com.bd/820113/%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%A4%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%80-%E0%A6%85%E0%A6%AA%E0%A6%B0%E0%A6%BE%E0%A6%A7%E0%A7%87-%E0%A6%A6%E0%A6%A3%E0%A7%8D%E0%A6%A1%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%A4-%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820113/%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%A4%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%80-%E0%A6%85%E0%A6%AA%E0%A6%B0%E0%A6%BE%E0%A6%A7%E0%A7%87-%E0%A6%A6%E0%A6%A3%E0%A7%8D%E0%A6%A1%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%A4-%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Tue, 10 Nov 2026 13:46:41 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/5c927941ba55b4dacb9f5f6543fead4b-6af2ca662731f.jpg?jadewits_media_id=321900" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/5c927941ba55b4dacb9f5f6543fead4b-6af2ca662731f.jpg?jadewits_media_id=321900" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/5c927941ba55b4dacb9f5f6543fead4b-6af2ca662731f.jpg?jadewits_media_id=321900" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মানবতাবিরোধী অপরাধে দণ্ডপ্রাপ্ত শেখ হাসিনার পাসপোর্ট ইস্যুর সুযোগ নেই: চিফ প্রসিকিউটর" /&gt;&lt;/p&gt;&lt;p&gt;মৃত্যুদণ্ডপ্রাপ্ত সাবেক প্রধানমন্ত্রী শেখ হাসিনাকে নতুন করে পাসপোর্ট দেওয়ার আইনি সুযোগ নেই বলে জানিয়েছেন আন্তর্জাতিক অপরাধ ট্রাইব্যুনালের চিফ প্রসিকিউটর মোহাম্মদ আমিনুল ইসলাম।
তিনি বলেছেন, শেখ হাসিনার পাসপোর্ট বাতিল করেছে বাংলাদেশ সরকার। পাসপোর্ট আইন অনুযায়ী, কোনো দণ্ডপ্রাপ্ত আসামিকে পাসপোর্ট দেওয়ার&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820113/%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%A4%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%80-%E0%A6%85%E0%A6%AA%E0%A6%B0%E0%A6%BE%E0%A6%A7%E0%A7%87-%E0%A6%A6%E0%A6%A3%E0%A7%8D%E0%A6%A1%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%A4-%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>মিডিয়ার ফ্যাসিবাদ কবে দূর হবে, জানতে চান আসিফ মাহমুদ</title>

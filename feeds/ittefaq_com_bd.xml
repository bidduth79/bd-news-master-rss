    <item>
      <title>নারায়ণগঞ্জে তিন ইটভাটাকে ১৫ লাখ টাকা জরিমানা</title>
      <link>https://www.ittefaq.com.bd/822501/%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A6%A3%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%87%E0%A6%9F%E0%A6%AD%E0%A6%BE%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A7%A7%E0%A7%AB-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%9C%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822501/%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A6%A3%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%87%E0%A6%9F%E0%A6%AD%E0%A6%BE%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A7%A7%E0%A7%AB-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%9C%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%BE</guid>
      <pubDate>Mon, 23 Nov 2026 00:53:48 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/a3830f386a22a8964c33db88f451f92f-6b0339b4daf57.jpg?jadewits_media_id=324342" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/a3830f386a22a8964c33db88f451f92f-6b0339b4daf57.jpg?jadewits_media_id=324342" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/a3830f386a22a8964c33db88f451f92f-6b0339b4daf57.jpg?jadewits_media_id=324342" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নারায়ণগঞ্জে তিন ইটভাটাকে ১৫ লাখ টাকা জরিমানা" /&gt;&lt;/p&gt;&lt;p&gt;সদর উপজেলার বক্তাবলীতে অবৈধভাবে ইটভাটা পরিচালনার দায়ে তিনটি প্রতিষ্ঠানকে মোট ১৫ লাখ টাকা জরিমানা করেছেন ভ্রাম্যমাণ আদালত।&amp;nbsp;
রোববার (২২ নভেম্বর) সদর উপজেলার পূর্ব গোপালনগর এলাকায় পরিবেশ অধিদপ্তরের মনিটরিং অ্যান্ড এনফোর্সমেন্ট উইং এই অভিযান পরিচালনা করে।
অভিযানে একটি ইটভাটার স্থাপনা ভেকু দিয়ে আংশি&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822501/%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A6%A3%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%87%E0%A6%9F%E0%A6%AD%E0%A6%BE%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A7%A7%E0%A7%AB-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%9C%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%BE">দৈনিক ইত্তেফাক</source>
    </item>

    <item>
      <title>পল্লবী-মিরপুরে অপরাধে জড়িত চার গ্রুপ, ভাড়ায় মেলে অস্ত্র</title>
      <link>https://www.ittefaq.com.bd/822871/%E0%A6%AA%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%AC%E0%A7%80-%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%85%E0%A6%AA%E0%A6%B0%E0%A6%BE%E0%A6%A7%E0%A7%87-%E0%A6%9C%E0%A6%A1%E0%A6%BC%E0%A6%BF%E0%A6%A4-%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%AA-%E0%A6%AD%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A6%BE%E0%A6%AF%E0%A6%BC</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822871/%E0%A6%AA%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%AC%E0%A7%80-%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%85%E0%A6%AA%E0%A6%B0%E0%A6%BE%E0%A6%A7%E0%A7%87-%E0%A6%9C%E0%A6%A1%E0%A6%BC%E0%A6%BF%E0%A6%A4-%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%AA-%E0%A6%AD%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A6%BE%E0%A6%AF%E0%A6%BC</guid>
      <pubDate>Wed, 25 Nov 2026 05:45:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/d0e409591a93752683e962173da03dfa-6b05f664f2dd5.jpg?jadewits_media_id=324715" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/d0e409591a93752683e962173da03dfa-6b05f664f2dd5.jpg?jadewits_media_id=324715" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/d0e409591a93752683e962173da03dfa-6b05f664f2dd5.jpg?jadewits_media_id=324715" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পল্লবী-মিরপুরে অপরাধে জড়িত চার গ্রুপ, ভাড়ায় মেলে অস্ত্র" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর পল্লবী ও মিরপুর জুড়ে বিস্তৃত সংঘবদ্ধ অপরাধী চক্রের নাম 'ফোর স্টার গ্রুপ। চাপাবাজি, জমি দখল, মাদক কারবার, অঙ্গের ব্যবহার, ছিনতাই ও ডাকাতিসহ নানা অপরাধে জড়িয়ে পড়েছে এই চক্রের সদস্যরা। চারটি পৃথক শাখায় বিভক্ত চক্রটির সহযোগীর সংখ্যা ৬৩ বলে সূত্র নিশ্চিত করেছে।
অভিযোগ রয়েছে, শীর্ষ সন্ত্রাস&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822871/%E0%A6%AA%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%AC%E0%A7%80-%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%85%E0%A6%AA%E0%A6%B0%E0%A6%BE%E0%A6%A7%E0%A7%87-%E0%A6%9C%E0%A6%A1%E0%A6%BC%E0%A6%BF%E0%A6%A4-%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%AA-%E0%A6%AD%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A6%BE%E0%A6%AF%E0%A6%BC">দৈনিক ইত্তেফাক</source>

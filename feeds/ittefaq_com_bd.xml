      <guid isPermaLink="true">https://www.ittefaq.com.bd/823195/%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF%E0%A6%93%E0%A6%AD%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%95%E0%A6%B0%E0%A6%BE%C2%A0%E0%A6%95%E0%A7%8B%E0%A6%9A%E0%A6%BF%E0%A6%82-%E0%A6%B8%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%AA%E0%A7%9C%E0%A6%BE%E0%A6%A4%E0%A7%87%C2%A0%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%AC%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Fri, 27 Nov 2026 03:00:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/0b2a16781329296c95c8c38f42704901-6b088b8892b93.jpg?jadewits_media_id=325083" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/0b2a16781329296c95c8c38f42704901-6b088b8892b93.jpg?jadewits_media_id=325083" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/0b2a16781329296c95c8c38f42704901-6b088b8892b93.jpg?jadewits_media_id=325083" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এমপিওভুক্ত শিক্ষকরা কোচিং সেন্টারে পড়াতে পারবেন না: শিক্ষামন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;শিক্ষা মন্ত্রী ড. আ ন ম এহছানুল হক মিলন এমপি বলেছেন, লেখাপড়ায় আর কোনো দুর্নীতি হবে না। দেশে আর নকলও চলবে না। যেসব শিক্ষকরা ক্লাস বাদ দিয়ে রাজনৈতিক দলের মিছিল মিটিং করেন তাদের বিরুদ্ধে আইনগত ব্যবস্থা নেওয়া হবে। তিনি বলেন, বেতনভুক্ত শিক্ষকরা প্রজাতন্ত্রের কর্মচারী। যখন তখন মিছিল মিটিং করে রাষ্ট্রদ্রোহ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823195/%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF%E0%A6%93%E0%A6%AD%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%95%E0%A6%B0%E0%A6%BE%C2%A0%E0%A6%95%E0%A7%8B%E0%A6%9A%E0%A6%BF%E0%A6%82-%E0%A6%B8%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%AA%E0%A7%9C%E0%A6%BE%E0%A6%A4%E0%A7%87%C2%A0%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%AC%E0%A7%87%E0%A6%A8">দৈনিক ইত্তেফাক</source>

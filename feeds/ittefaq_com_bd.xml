    </item>
    <item>
      <title>প্রত্যেক উপজেলায় মহিলা কলেজ প্রতিষ্ঠা করবে সরকার: শিক্ষামন্ত্রী</title>
      <link>https://www.ittefaq.com.bd/820644/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%95-%E0%A6%89%E0%A6%AA%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A6%B9%E0%A6%BF%E0%A6%B2%E0%A6%BE-%E0%A6%95%E0%A6%B2%E0%A7%87%E0%A6%9C-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%AC%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820644/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%95-%E0%A6%89%E0%A6%AA%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A6%B9%E0%A6%BF%E0%A6%B2%E0%A6%BE-%E0%A6%95%E0%A6%B2%E0%A7%87%E0%A6%9C-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%AC%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Thu, 12 Nov 2026 22:02:04 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/9d2284753564e4555334beeaa9ba1440-6af5e290ad49a.jpg?jadewits_media_id=322437" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/9d2284753564e4555334beeaa9ba1440-6af5e290ad49a.jpg?jadewits_media_id=322437" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/9d2284753564e4555334beeaa9ba1440-6af5e290ad49a.jpg?jadewits_media_id=322437" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রত্যেক উপজেলায় মহিলা কলেজ প্রতিষ্ঠা করবে সরকার: শিক্ষামন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;দেশের প্রতিটি উপজেলায় একটি করে মহিলা কলেজ প্রতিষ্ঠার পরিকল্পনা নিয়েছে বিএনপি সরকার। প্রধানমন্ত্রী তারেক রহমানের নির্দেশনায় এ উদ্যোগ বাস্তবায়নের লক্ষ্যে ইতিমধ্যে দেশব্যাপী জরিপ ও সমীক্ষা শুরু হয়েছে বলে জানিয়েছেন শিক্ষা এবং প্রাথমিক ও গণশিক্ষামন্ত্রী ড. আ ন ম এহছানুল হক মিলন। তিনি জানান, বর্তমানে দেশে&lt;/p&gt;</description>

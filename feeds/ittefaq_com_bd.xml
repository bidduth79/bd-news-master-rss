    <item>
      <title>দেশে প্রথম এলো নিজে ব্যবহার উপযোগী জন্মনিয়ন্ত্রণ ইনজেকশন</title>
      <link>https://www.ittefaq.com.bd/822870/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%8F%E0%A6%B2%E0%A7%8B-%E0%A6%A8%E0%A6%BF%E0%A6%9C%E0%A7%87-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B9%E0%A6%BE%E0%A6%B0-%E0%A6%89%E0%A6%AA%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%80-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AE%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A3</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822870/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%8F%E0%A6%B2%E0%A7%8B-%E0%A6%A8%E0%A6%BF%E0%A6%9C%E0%A7%87-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B9%E0%A6%BE%E0%A6%B0-%E0%A6%89%E0%A6%AA%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%80-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AE%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A3</guid>
      <pubDate>Wed, 25 Nov 2026 04:59:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/1b6f1ebe0748d061e026d7f2549a28cb-6b05f186c5266.jpg?jadewits_media_id=324714" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/1b6f1ebe0748d061e026d7f2549a28cb-6b05f186c5266.jpg?jadewits_media_id=324714" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/1b6f1ebe0748d061e026d7f2549a28cb-6b05f186c5266.jpg?jadewits_media_id=324714" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দেশে প্রথম এলো নিজে ব্যবহার উপযোগী জন্মনিয়ন্ত্রণ ইনজেকশন" /&gt;&lt;/p&gt;&lt;p&gt;দেশে প্রথম বারের মতো বাজারে এলো নারীদের জন্যে নিজে ব্যবহার উপযোগী জন্মনিয়ন্ত্রণ ইনজেকশন &amp;lsquo;মেডোজেন সাবকিউ&amp;rsquo;। নারীদের জন্মনিয়ন্ত্রণের সহজ সুবিধার জন্যে এই ইনজেকশন বাজারে এনেছে &amp;lsquo;ইনসেপ্টা ফার্মাসিউটিক্যালস লিমিটেড&amp;rsquo;।
প্রতিদিন জন্মনিয়ন্ত্রণ বড়ি খাওয়া কিংবা স্বাস্থ্যকর্মীর মাধ্যমে ইনজ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822870/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%8F%E0%A6%B2%E0%A7%8B-%E0%A6%A8%E0%A6%BF%E0%A6%9C%E0%A7%87-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B9%E0%A6%BE%E0%A6%B0-%E0%A6%89%E0%A6%AA%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%80-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AE%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A3">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>অর্থাভাবে হয়নি উচ্চশিক্ষা, কৃষক হয়ে উদ্ভাবন করেছেন ২৫ ধরনের দেশীয় ধান</title>
      <link>https://www.ittefaq.com.bd/822869/%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%B9%E0%A7%9F%E0%A6%A8%E0%A6%BF-%E0%A6%89%E0%A6%9A%E0%A7%8D%E0%A6%9A%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%95%E0%A7%83%E0%A6%B7%E0%A6%95-%E0%A6%B9%E0%A7%9F%E0%A7%87-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822869/%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%B9%E0%A7%9F%E0%A6%A8%E0%A6%BF-%E0%A6%89%E0%A6%9A%E0%A7%8D%E0%A6%9A%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%95%E0%A7%83%E0%A6%B7%E0%A6%95-%E0%A6%B9%E0%A7%9F%E0%A7%87-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Wed, 25 Nov 2026 04:15:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/8d8aed26c88e2cda08977a7df2f2f61a-6b05f0df97d61.jpg?jadewits_media_id=324713" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/8d8aed26c88e2cda08977a7df2f2f61a-6b05f0df97d61.jpg?jadewits_media_id=324713" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/8d8aed26c88e2cda08977a7df2f2f61a-6b05f0df97d61.jpg?jadewits_media_id=324713" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অর্থাভাবে হয়নি উচ্চশিক্ষা, কৃষক হয়ে উদ্ভাবন করেছেন ২৫ ধরনের দেশীয় ধান" /&gt;&lt;/p&gt;&lt;p&gt;জেলা জুড়ে জনপ্রিয়তা পেয়েছে কৃষক সেন্টু হাজং উদ্ভাবিত দেশীয় জাতের ধান &amp;lsquo;সেন্টু পাইজাম&amp;rsquo;। খরচ কম ও সহজলভ্য হওয়ায় এ ধরনের ধান চাষে আগ্রহী হচ্ছেন কৃষকরা। গত ২১ বছরে ২৫ ধরনের দেশীয় জাতের নতুন ধান উদ্ভাবন করেছেন। এছাড়া উদ্ভাবনের অপেক্ষায় রয়েছে আরো প্রায় শতাধিক জাতের ধান।
নালিতাবাড়ী উপজেলার নয়াবি&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822869/%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%B9%E0%A7%9F%E0%A6%A8%E0%A6%BF-%E0%A6%89%E0%A6%9A%E0%A7%8D%E0%A6%9A%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%95%E0%A7%83%E0%A6%B7%E0%A6%95-%E0%A6%B9%E0%A7%9F%E0%A7%87-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>তৈরি পোশাকশ্রমিকদের ন্যূনতম মজুরি ১৭ হাজার টাকা নির্ধারণ</title>

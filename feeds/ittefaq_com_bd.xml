      <guid isPermaLink="true">https://www.ittefaq.com.bd/822199/%E0%A6%9F%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A7%AB%E0%A7%A8-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%A5%E0%A6%A8-%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A7%87-%E0%A6%9C%E0%A6%BF%E0%A6%9F%E0%A6%BF%E0%A6%8F-%E0%A7%AC-%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Sat, 21 Nov 2026 14:48:36 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/edcedb6379e24ac12e5ba7d823982152-6b015a339dde1.jpg?jadewits_media_id=324037" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/edcedb6379e24ac12e5ba7d823982152-6b015a339dde1.jpg?jadewits_media_id=324037" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/edcedb6379e24ac12e5ba7d823982152-6b015a339dde1.jpg?jadewits_media_id=324037" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টানা ৫২ ঘণ্টার ম্যারাথন স্ট্রিমে জিটিএ-৬ শেষ করলেন আইশোস্পিড, কাঁদলেন সমাপ্তি দেখে" /&gt;&lt;/p&gt;&lt;p&gt;বিশ্বজুড়ে লাখো গেমার যখন রকস্টার গেমসের বহুল প্রতীক্ষিত &amp;lsquo;গ্র্যান্ড থেফট অটো ৬&amp;rsquo; (জিটিএ ৬)-এর বিশাল ভার্চ্যুয়াল জগৎ ঘুরে দেখছেন, তখন গেমটির মূল কাহিনি শেষ করে ফেলেছেন দুই জনপ্রিয় গেম স্ট্রিমার।&amp;nbsp;
তারা হলেন ব্রাইস-এক্সডি ও আইশোস্পিড। গেমটির চূড়ান্ত পর্বে পৌঁছে তারা দ্রুততম সময়ে জিটিএ ৬ &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822199/%E0%A6%9F%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A7%AB%E0%A7%A8-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%A5%E0%A6%A8-%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A7%87-%E0%A6%9C%E0%A6%BF%E0%A6%9F%E0%A6%BF%E0%A6%8F-%E0%A7%AC-%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8">দৈনিক ইত্তেফাক</source>
    </item>

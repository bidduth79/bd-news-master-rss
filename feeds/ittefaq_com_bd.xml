      <guid isPermaLink="true">https://www.ittefaq.com.bd/822134/%E0%A7%AF-%E0%A6%93-%E0%A7%A7%E0%A7%AA-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A7%A9%E0%A7%A6-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%95%E0%A7%8B%E0%A6%B0%E0%A6%86%E0%A6%A8-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A6%B8%E0%A7%8D%E0%A6%A5-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AB%E0%A7%87%E0%A6%9C-%E0%A6%B9%E0%A6%B2%E0%A7%8B-%E0%A6%A6%E0%A7%81%E0%A6%87</guid>
      <pubDate>Sat, 21 Nov 2026 00:26:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/f4c3f2ec1ef8025726b48a1f1eeb8626-6b008c1c53517.jpg?jadewits_media_id=323972" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/f4c3f2ec1ef8025726b48a1f1eeb8626-6b008c1c53517.jpg?jadewits_media_id=323972" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/f4c3f2ec1ef8025726b48a1f1eeb8626-6b008c1c53517.jpg?jadewits_media_id=323972" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৯ ও ১৪ মাসে ৩০ পারা কোরআন মুখস্থ করে হাফেজ হলো দুই শিশু" /&gt;&lt;/p&gt;&lt;p&gt;পবিত্র কোরআনের ৩০ পারা মুখস্থ করা যেকোনো শিক্ষার্থীর জন্যই এক অনন্য অর্জন। সেই কঠিন সাধনায় নজরকাড়া সাফল্য দেখিয়েছে চাঁদপুরের দুই শিশু শিক্ষার্থী। একই মাদরাসার হিফজ বিভাগে পড়ে একজন মাত্র ৯ মাস ১০ দিনে এবং অপরজন ১৪ মাসে সম্পূর্ণ কোরআন মুখস্থ করে হাফেজ হওয়ার গৌরব অর্জন করেছে। তাদের এই কৃতিত্বে পরিবার,&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822134/%E0%A7%AF-%E0%A6%93-%E0%A7%A7%E0%A7%AA-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A7%A9%E0%A7%A6-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%95%E0%A7%8B%E0%A6%B0%E0%A6%86%E0%A6%A8-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A6%B8%E0%A7%8D%E0%A6%A5-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AB%E0%A7%87%E0%A6%9C-%E0%A6%B9%E0%A6%B2%E0%A7%8B-%E0%A6%A6%E0%A7%81%E0%A6%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>ভোটার তালিকা সংশোধনের নামে টার্গেট করে মুসলিমদের বাদ দিচ্ছে ভারত: মার্কিন কমিশন</title>

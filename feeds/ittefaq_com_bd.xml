      <guid isPermaLink="true">https://www.ittefaq.com.bd/822490/%E0%A6%B8%E0%A6%BE%E0%A6%A6%E0%A6%BF%E0%A6%95-%E0%A6%95%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%85%E0%A6%97%E0%A7%8D%E0%A6%A8%E0%A6%BF%E0%A6%B8%E0%A6%82%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%87-%E0%A6%9C%E0%A7%9C%E0%A6%BF%E0%A6%A4-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7</guid>
      <pubDate>Sun, 22 Nov 2026 22:28:30 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/409dd7c3b6257986c000b9c419b1fb44-6b0317f1d38cc.jpg?jadewits_media_id=324331" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/409dd7c3b6257986c000b9c419b1fb44-6b0317f1d38cc.jpg?jadewits_media_id=324331" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/409dd7c3b6257986c000b9c419b1fb44-6b0317f1d38cc.jpg?jadewits_media_id=324331" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাদিক কায়েমের বাড়িতে অগ্নিসংযোগে জড়িত নিষিদ্ধ ছাত্রলীগ: পুলিশ" /&gt;&lt;/p&gt;&lt;p&gt;খাগড়াছড়িতে ঢাকা বিশ্ববিদ্যালয় কেন্দ্রীয় ছাত্র সংসদের (ডাকসু) সহ-সভাপতি (ভিপি) সাদিক কায়েমের গ্রামের বাড়িতে পেট্রোলবোমা নিক্ষেপ ও অগ্নিসংযোগের ঘটনায় মামলা দায়ের করা হয়েছে। মামলায় নিষিদ্ধ সংগঠন ছাত্রলীগের ১০ কর্মীকে আসামি করা হয়েছে। তাদের মধ্যে তিনজনের পরিচয় শনাক্ত করেছে পুলিশ।
রোববার (২২ নভেম্বর) বিক&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822490/%E0%A6%B8%E0%A6%BE%E0%A6%A6%E0%A6%BF%E0%A6%95-%E0%A6%95%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%85%E0%A6%97%E0%A7%8D%E0%A6%A8%E0%A6%BF%E0%A6%B8%E0%A6%82%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%87-%E0%A6%9C%E0%A7%9C%E0%A6%BF%E0%A6%A4-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7">দৈনিক ইত্তেফাক</source>

      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/253aae23a75476d5f559c22e3024513c-6afab9b5c4369.jpg?jadewits_media_id=323098" medium="image" />

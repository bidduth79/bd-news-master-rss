    <item>
      <title>মাদক চোরাচালানের দায়ে সৌদিতে পাঁচ বাংলাদেশি গ্রেপ্তার</title>
      <link>https://www.ittefaq.com.bd/820453/%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A6%95-%E0%A6%9A%E0%A7%8B%E0%A6%B0%E0%A6%BE%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A7%9F%E0%A7%87-%E0%A6%B8%E0%A7%8C%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%81%E0%A6%9A-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820453/%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A6%95-%E0%A6%9A%E0%A7%8B%E0%A6%B0%E0%A6%BE%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A7%9F%E0%A7%87-%E0%A6%B8%E0%A7%8C%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%81%E0%A6%9A-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF</guid>
      <pubDate>Thu, 12 Nov 2026 00:30:45 +0600</pubDate>

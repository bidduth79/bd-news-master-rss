      <guid isPermaLink="true">https://www.ittefaq.com.bd/820646/%E0%A6%86%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A7%A7%E0%A7%AE%E0%A6%9F%E0%A6%BF-%E0%A6%97%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%93-%E0%A7%AB%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AD%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A6%B9-%E0%A6%B8%E0%A7%9C%E0%A6%95</guid>

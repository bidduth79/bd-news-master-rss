      <guid isPermaLink="true">https://www.ittefaq.com.bd/821206/%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B7%E0%A7%9F%E0%A7%87-%E0%A6%B8%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A6%97%E0%A6%A3%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%A4%E0%A7%87</guid>
      <pubDate>Mon, 16 Nov 2026 02:49:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/2121e57275dc1551cfac29950728f5fa-6afa1567daea0.jpg?jadewits_media_id=323019" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/2121e57275dc1551cfac29950728f5fa-6afa1567daea0.jpg?jadewits_media_id=323019" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/2121e57275dc1551cfac29950728f5fa-6afa1567daea0.jpg?jadewits_media_id=323019" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শেখ হাসিনার বিষয়ে সিদ্ধান্ত বাংলাদেশের জনগণকে নিতে হবে: যুক্তরাষ্ট্র" /&gt;&lt;/p&gt;&lt;p&gt;মানবতাবিরোধী অপরাধে ফাঁসির রায় মাথায় নিয়ে ভারতে অবস্থানরত ক্ষমতাচ্যুত প্রধানমন্ত্রী শেখ হাসিনা পাসপোর্ট ও জাতীয় পরিচয়পত্রের যে আবেদন জানিয়েছেন, সে বিষয়ে বাংলাদেশের জনগণকেই সিদ্ধান্ত নিতে হবে বলে অভিমত ব্যক্ত করেছে যুক্তরাষ্ট্র।
মার্কিন পররাষ্ট্র মন্ত্রণালয়ের একজন মুখপাত্র বলেছেন, &amp;lsquo;এটি এমন একটি&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821206/%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B7%E0%A7%9F%E0%A7%87-%E0%A6%B8%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A6%97%E0%A6%A3%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%A4%E0%A7%87">দৈনিক ইত্তেফাক</source>

      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/35387f02a001b87755846497004a326b-6af4cec6dfeb3.jpg?jadewits_media_id=322247" medium="image" />

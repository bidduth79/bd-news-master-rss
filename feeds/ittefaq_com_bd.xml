      <guid isPermaLink="true">https://www.ittefaq.com.bd/821173/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%AD%E0%A6%BE%E0%A6%99%E0%A6%9A%E0%A7%81%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A7%80-%E0%A6%8F%E0%A6%B8%E0%A6%86%E0%A6%87</guid>
      <pubDate>Sun, 15 Nov 2026 20:37:46 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/34d220c94a0800629b1eb41d26666234-6af9c337c7420.jpg?jadewits_media_id=322986" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/34d220c94a0800629b1eb41d26666234-6af9c337c7420.jpg?jadewits_media_id=322986" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/34d220c94a0800629b1eb41d26666234-6af9c337c7420.jpg?jadewits_media_id=322986" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গোপালগঞ্জে পুলিশের গাড়ি ভাঙচুর মামলার বাদী এসআই মোসলেমকে কু’পিয়ে জ’খম" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জের টুঙ্গিপাড়ায় পুলিশের গাড়ি ভাঙচুর ও অগ্নিসংযোগের ঘটনায় দায়ের করা মামলার বাদী উপ-পরিদর্শক (এসআই) মোসলেম আলীকে কুপিয়ে জখম করেছে দুর্বৃত্তরা।
রোববার (১৫ নভেম্বর) সন্ধ্যায় উপজেলার পাটগাতী ইউনিয়নের চৌরঙ্গী মোড় এলাকায় এ ঘটনা ঘটে। তবে কারা এবং কী কারণে তার ওপর হামলা চালিয়েছে, তা তাৎক্ষণিকভাবে জান&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821173/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%AD%E0%A6%BE%E0%A6%99%E0%A6%9A%E0%A7%81%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A7%80-%E0%A6%8F%E0%A6%B8%E0%A6%86%E0%A6%87">দৈনিক ইত্তেফাক</source>

      <guid isPermaLink="true">https://www.ittefaq.com.bd/822307/%E0%A6%AA%E0%A6%BE%E0%A6%AC%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%93-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Sun, 22 Nov 2026 03:10:34 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/c61eef9b88fff86d59ce2b5a94449767-6b02089457a14.jpg?jadewits_media_id=324146" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/c61eef9b88fff86d59ce2b5a94449767-6b02089457a14.jpg?jadewits_media_id=324146" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/c61eef9b88fff86d59ce2b5a94449767-6b02089457a14.jpg?jadewits_media_id=324146" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পাবনায় বিএনপি ও কার্যক্রম নিষিদ্ধ আওয়ামী লীগের মধ্যে সংঘর্ষের পর ওসি প্রত্যাহার" /&gt;&lt;/p&gt;&lt;p&gt;পাবনার বেড়া পৌর এলাকায় বিএনপি ও কার্যক্রমে নিষিদ্ধ আওয়ামী লীগের নেতাকর্মীদের মধ্যে দফায় দফায় সংঘর্ষ, ভাঙচুর ও অগ্নিসংযোগের ঘটনার পর বেড়া মডেল থানার ভারপ্রাপ্ত কর্মকর্তা (ওসি) নয়ন কুমার সরকারকে প্রত্যাহার করা হয়েছে। তার স্থলে পাবনা সদর সার্কেলের পরিদর্শক গোলাম মোস্তফাকে নতুন ওসি হিসেবে দায়িত্ব দেওয়া &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822307/%E0%A6%AA%E0%A6%BE%E0%A6%AC%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%93-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>চাটমোহরে নিষিদ্ধ ছাত্রলীগের সভাপতিসহ ৩ নেতা আটক</title>
      <link>https://www.ittefaq.com.bd/822304/%E0%A6%9A%E0%A6%BE%E0%A6%9F%E0%A6%AE%E0%A7%8B%E0%A6%B9%E0%A6%B0%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AD%E0%A6%BE%E0%A6%AA%E0%A6%A4%E0%A6%BF%E0%A6%B8%E0%A6%B9-%E0%A7%A9-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%86%E0%A6%9F%E0%A6%95</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822304/%E0%A6%9A%E0%A6%BE%E0%A6%9F%E0%A6%AE%E0%A7%8B%E0%A6%B9%E0%A6%B0%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AD%E0%A6%BE%E0%A6%AA%E0%A6%A4%E0%A6%BF%E0%A6%B8%E0%A6%B9-%E0%A7%A9-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%86%E0%A6%9F%E0%A6%95</guid>
      <pubDate>Sun, 22 Nov 2026 02:22:58 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/8ac219450b737ce9708c86d5c4af91f3-6b01fc9c7b8c9.jpg?jadewits_media_id=324143" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/8ac219450b737ce9708c86d5c4af91f3-6b01fc9c7b8c9.jpg?jadewits_media_id=324143" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/8ac219450b737ce9708c86d5c4af91f3-6b01fc9c7b8c9.jpg?jadewits_media_id=324143" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চাটমোহরে নিষিদ্ধ ছাত্রলীগের সভাপতিসহ ৩ নেতা আটক" /&gt;&lt;/p&gt;&lt;p&gt;পাবনার চাটমোহরে পৃথক অভিযান চালিয়ে নিষিদ্ধ ঘোষিত উপজেলা ছাত্রলীগের সভাপতিসহ সংগঠনটির তিন নেতাকে আটক করেছে থানা-পুলিশ।&amp;nbsp;
শনিবার (২১ নভেম্বর) রাত সাড়ে ১০টার দিকে উপজেলার হরিপুর ও গুনাইগাছা এলাকা থেকে তাদের আটক করা হয়।
আটক ব্যক্তিরা হলেন- উপজেলা ছাত্রলীগের সভাপতি হুমায়ূন কবির, গুনাইগাছা ইউনিয়ন ছাত্&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822304/%E0%A6%9A%E0%A6%BE%E0%A6%9F%E0%A6%AE%E0%A7%8B%E0%A6%B9%E0%A6%B0%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AD%E0%A6%BE%E0%A6%AA%E0%A6%A4%E0%A6%BF%E0%A6%B8%E0%A6%B9-%E0%A7%A9-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%86%E0%A6%9F%E0%A6%95">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>খুলনায় বিএনপি নেতাকে গুলি</title>
      <link>https://www.ittefaq.com.bd/822301/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822301/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF</guid>
      <pubDate>Sun, 22 Nov 2026 01:44:21 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/510288526f5085409557c24fa0113546-6b01f31ba32b3.jpg?jadewits_media_id=324140" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/510288526f5085409557c24fa0113546-6b01f31ba32b3.jpg?jadewits_media_id=324140" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/510288526f5085409557c24fa0113546-6b01f31ba32b3.jpg?jadewits_media_id=324140" style="max-width:100%;height:auto;margin-bottom:10px;" alt="খুলনায় বিএনপি নেতাকে গুলি" /&gt;&lt;/p&gt;&lt;p&gt;খুলনার তেরখাদা উপজেলায় মধুপুর ইউনিয়ন বিএনপির সম্মেলন প্রস্তুতি কমিটির সদস্য মাফিজুর রহমান সরদার (৪৭) দুর্বৃত্তদের গুলিতে আহত হয়েছেন।&amp;nbsp;
শনিবার (২১ নভেম্বর) রাত ১০ টার দিকে উপজেলার মোকামপুর এলাকায় এ ঘটনা ঘটে। আহত অবস্থায় তাকে খুলনা মেডিকেল কলেজ হাসপাতালে ভর্তি করা হয়েছে।&amp;nbsp;
মাফিজুর রহমান তেরখাদ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822301/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>বিক্ষোভের মুখে খুলল ঢাবির মুজিব হলের বন্ধ পকেট গেট</title>
      <link>https://www.ittefaq.com.bd/822300/%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8B%E0%A6%AD%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%87-%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%B2-%E0%A6%A2%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%9C%E0%A6%BF%E0%A6%AC-%E0%A6%B9%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7-%E0%A6%AA%E0%A6%95%E0%A7%87%E0%A6%9F-%E0%A6%97%E0%A7%87%E0%A6%9F</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822300/%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8B%E0%A6%AD%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%87-%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%B2-%E0%A6%A2%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%9C%E0%A6%BF%E0%A6%AC-%E0%A6%B9%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7-%E0%A6%AA%E0%A6%95%E0%A7%87%E0%A6%9F-%E0%A6%97%E0%A7%87%E0%A6%9F</guid>
      <pubDate>Sun, 22 Nov 2026 01:09:37 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/ad206d5697ca0f8cff1f9346002805c7-6b01ec1eda4b0.jpg?jadewits_media_id=324139" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/ad206d5697ca0f8cff1f9346002805c7-6b01ec1eda4b0.jpg?jadewits_media_id=324139" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/ad206d5697ca0f8cff1f9346002805c7-6b01ec1eda4b0.jpg?jadewits_media_id=324139" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিক্ষোভের মুখে খুলল ঢাবির মুজিব হলের বন্ধ পকেট গেট" /&gt;&lt;/p&gt;&lt;p&gt;ঢাকা বিশ্ববিদ্যালয়ের (ঢাবি) শেখ মুজিবুর রহমান হলের কাটাবন-শাহবাগ সড়কসংলগ্ন পকেট গেট খুলে দেওয়া হয়েছে। গেটটি বন্ধ রাখার সিদ্ধান্তের প্রতিবাদে শিক্ষার্থীদের বিক্ষোভের মুখে শনিবার (২১ নভেম্বর) রাতে এটি খুলে দেওয়া হয়।
এর আগে রাত ৯টা ৫০ মিনিটের দিকে গেটটি খুলে দেওয়ার দাবিতে বিক্ষোভ শুরু করেন বিভিন্ন হলের&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822300/%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8B%E0%A6%AD%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%87-%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%B2-%E0%A6%A2%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%9C%E0%A6%BF%E0%A6%AC-%E0%A6%B9%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7-%E0%A6%AA%E0%A6%95%E0%A7%87%E0%A6%9F-%E0%A6%97%E0%A7%87%E0%A6%9F">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>পটুয়াখালীতে কার্যক্রম নিষিদ্ধ আওয়ামী লীগের সাবেক তিন এমপি ও এক মেয়রের বাড়িতে হামলা-ভাঙচুর</title>
      <link>https://www.ittefaq.com.bd/822299/%E0%A6%AA%E0%A6%9F%E0%A7%81%E0%A7%9F%E0%A6%BE%E0%A6%96%E0%A6%BE%E0%A6%B2%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%A4%E0%A6%BF%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822299/%E0%A6%AA%E0%A6%9F%E0%A7%81%E0%A7%9F%E0%A6%BE%E0%A6%96%E0%A6%BE%E0%A6%B2%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%A4%E0%A6%BF%E0%A6%A8</guid>
      <pubDate>Sun, 22 Nov 2026 02:24:44 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/625224b1aa232ca9e2a7bc0e33cd50b0-6b01e91142764.jpg?jadewits_media_id=324138" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/625224b1aa232ca9e2a7bc0e33cd50b0-6b01e91142764.jpg?jadewits_media_id=324138" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/625224b1aa232ca9e2a7bc0e33cd50b0-6b01e91142764.jpg?jadewits_media_id=324138" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পটুয়াখালীতে কার্যক্রম নিষিদ্ধ আওয়ামী লীগের সাবেক তিন এমপি ও এক মেয়রের বাড়িতে হামলা-ভাঙচুর" /&gt;&lt;/p&gt;&lt;p&gt;পটুয়াখালীতে কার্যক্রম নিষিদ্ধ আওয়ামী লীগের সাবেক তিন সংসদ সদস্য (এমপি) ও এক পৌর মেয়রের বাড়িতে হামলা ও ভাঙচুরের ঘটনা ঘটেছে। বৃহস্পতিবার (১৯ নভেম্বর) রাত ১০টা থেকে শুক্রবার রাত ৯টার মধ্যে এসব ঘটনা ঘটে। 
জানা যায়, শুক্রবার সন্ধ্যা সাতটার দিকে কার্যক্রম নিষিদ্ধ আওয়ামী লীগের প্রয়াত সংসদ সদস্য আনোয়ার-উল ই&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822299/%E0%A6%AA%E0%A6%9F%E0%A7%81%E0%A7%9F%E0%A6%BE%E0%A6%96%E0%A6%BE%E0%A6%B2%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%A4%E0%A6%BF%E0%A6%A8">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>এক বছর পরে ২ লাখ টাকার নিচে নামল সোনার ভরির দাম</title>
      <link>https://www.ittefaq.com.bd/822298/%E0%A6%8F%E0%A6%95-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A7%87-%E0%A7%A8-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%9A%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A6%B2-%E0%A6%B8%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%AD%E0%A6%B0%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822298/%E0%A6%8F%E0%A6%95-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A7%87-%E0%A7%A8-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%9A%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A6%B2-%E0%A6%B8%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%AD%E0%A6%B0%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE</guid>
      <pubDate>Sun, 22 Nov 2026 00:55:16 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2025/10/08/c97078784610b40d451ba0373889c630-68e681ead7068.jpg?jadewits_media_id=252704" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2025/10/08/c97078784610b40d451ba0373889c630-68e681ead7068.jpg?jadewits_media_id=252704" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2025/10/08/c97078784610b40d451ba0373889c630-68e681ead7068.jpg?jadewits_media_id=252704" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এক বছর পরে ২ লাখ টাকার নিচে নামল সোনার ভরির দাম" /&gt;&lt;/p&gt;&lt;p&gt;দেশের বাজারে সোনার দাম আরেক দফা কমা‌নোর ঘোষণা দিয়েছে বাংলাদেশ জুয়েলার্স অ্যাসোসিয়েশন (বাজুস)। তাতে ২২ ক্যারেটের প্রতি ভরি সোনার দাম হয়েছে ১ লাখ ৯৪ হাজার ৯৬৪ টাকা। এর ফলে প্রায় ১৩ মাস পরে সোনার ভরির দাম কমে ২ লাখ টাকার নিচে নামল। সর্বশেষ ২০২৫ সালের অক্টোবরে ২২ ক্যারেট সোনার ভরির দাম ছিল ১ লাখ ৯৪ হাজ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822298/%E0%A6%8F%E0%A6%95-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A7%87-%E0%A7%A8-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%9A%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A6%B2-%E0%A6%B8%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%AD%E0%A6%B0%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>স্থানীয় সরকার নির্বাচনে দলীয় প্রার্থী হিসেবে পরিচয় দেওয়া যাবে না: মীর শাহে আলম</title>
      <link>https://www.ittefaq.com.bd/822297/%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A7%9F-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%9A%E0%A6%A8%E0%A7%87-%E0%A6%A6%E0%A6%B2%E0%A7%80%E0%A7%9F-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80-%E0%A6%B9%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A7%87-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%9A%E0%A7%9F</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822297/%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A7%9F-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%9A%E0%A6%A8%E0%A7%87-%E0%A6%A6%E0%A6%B2%E0%A7%80%E0%A7%9F-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80-%E0%A6%B9%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A7%87-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%9A%E0%A7%9F</guid>
      <pubDate>Sun, 22 Nov 2026 00:30:11 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/65cb6459286d08af25054e2d08e81f2a-6b01e32a3dfce.jpg?jadewits_media_id=324137" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/65cb6459286d08af25054e2d08e81f2a-6b01e32a3dfce.jpg?jadewits_media_id=324137" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/65cb6459286d08af25054e2d08e81f2a-6b01e32a3dfce.jpg?jadewits_media_id=324137" style="max-width:100%;height:auto;margin-bottom:10px;" alt="স্থানীয় সরকার নির্বাচনে দলীয় প্রার্থী হিসেবে পরিচয় দেওয়া যাবে না: মীর শাহে আলম" /&gt;&lt;/p&gt;&lt;p&gt;স্থানীয় সরকার আইন সংশোধন করা হয়েছে এবং আগামীতে স্থানীয় সরকার নির্বাচন আর দলীয়ভাবে বা দলীয় প্রতীকে অনুষ্ঠিত হবে না বলে জানিয়েছেন স্থানীয় সরকার, পল্লী উন্নয়ন ও সমবায় প্রতিমন্ত্রী মীর শাহে আলম।&amp;nbsp;
তিনি বলছেন, স্থানীয় সরকার নির্বাচনে দলীয়ভাবে সরাসরি কাউকে মনোনয়ন দেওয়ার সুযোগ নেই। ব্যানার-পো&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822297/%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A7%9F-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%9A%E0%A6%A8%E0%A7%87-%E0%A6%A6%E0%A6%B2%E0%A7%80%E0%A7%9F-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80-%E0%A6%B9%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A7%87-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%9A%E0%A7%9F">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>পাগলা মসজিদের দানবাক্সে মিলল রেকর্ড ১৮ কোটি ২১ লাখ টাকা</title>
      <link>https://www.ittefaq.com.bd/822296/%E0%A6%AA%E0%A6%BE%E0%A6%97%E0%A6%B2%E0%A6%BE-%E0%A6%AE%E0%A6%B8%E0%A6%9C%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2-%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A1-%E0%A7%A7%E0%A7%AE-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A7%A8%E0%A7%A7-%E0%A6%B2%E0%A6%BE%E0%A6%96</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822296/%E0%A6%AA%E0%A6%BE%E0%A6%97%E0%A6%B2%E0%A6%BE-%E0%A6%AE%E0%A6%B8%E0%A6%9C%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2-%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A1-%E0%A7%A7%E0%A7%AE-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A7%A8%E0%A7%A7-%E0%A6%B2%E0%A6%BE%E0%A6%96</guid>
      <pubDate>Sun, 22 Nov 2026 00:10:51 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/7152b519edeffba3a99b05a6e68e09ee-6b01dd0ed0f27.jpg?jadewits_media_id=324136" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/7152b519edeffba3a99b05a6e68e09ee-6b01dd0ed0f27.jpg?jadewits_media_id=324136" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/7152b519edeffba3a99b05a6e68e09ee-6b01dd0ed0f27.jpg?jadewits_media_id=324136" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পাগলা মসজিদের দানবাক্সে মিলল রেকর্ড ১৮ কোটি ২১ লাখ টাকা" /&gt;&lt;/p&gt;&lt;p&gt;কিশোরগঞ্জের ঐতিহাসিক পাগলা মসজিদের দানবাক্সে এবার দানের টাকায় নতুন ইতিহাস সৃষ্টি হয়েছে। প্রায় পাঁচ মাস পর খোলা ১৫টি দানসিন্দুকে পাওয়া ৫১ বস্তা টাকা ১২ ঘণ্টা ধরে গণনা করা হয়। গণনা শেষে টাকার পরিমাণ দাঁড়ায় ১৮ কোটি ২১ লাখ ৬৯ হাজার ৫১৭ টাকা। দানবাক্সে এবার পাওয়া টাকার পরিমাণ আগের সব রেকর্ড ছাড়িয়ে গেছে।
&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822296/%E0%A6%AA%E0%A6%BE%E0%A6%97%E0%A6%B2%E0%A6%BE-%E0%A6%AE%E0%A6%B8%E0%A6%9C%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2-%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A1-%E0%A7%A7%E0%A7%AE-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A7%A8%E0%A7%A7-%E0%A6%B2%E0%A6%BE%E0%A6%96">দৈনিক ইত্তেফাক</source>
    </item>
    <item>

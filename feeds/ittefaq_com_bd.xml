      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/ebe0a8ef3c66bfd1414144349b15fef4-6b00776440503.jpg?jadewits_media_id=323964" length="0" type="image/jpeg" />

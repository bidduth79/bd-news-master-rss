    <item>
      <title>বিশ্বের দূষিত শহরের তালিকায় দ্বিতীয় ঢাকা, শীর্ষে লাহোর</title>
      <link>https://www.ittefaq.com.bd/821608/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%82%E0%A6%B7%E0%A6%BF%E0%A6%A4-%E0%A6%B6%E0%A6%B9%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%B6%E0%A7%80%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821608/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%82%E0%A6%B7%E0%A6%BF%E0%A6%A4-%E0%A6%B6%E0%A6%B9%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%B6%E0%A7%80%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A7%87</guid>
      <pubDate>Wed, 18 Nov 2026 08:43:17 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/4c160974971ffe6d9a00e55aa3f6d089-6afd10987c83a.jpg?jadewits_media_id=323434" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/4c160974971ffe6d9a00e55aa3f6d089-6afd10987c83a.jpg?jadewits_media_id=323434" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/4c160974971ffe6d9a00e55aa3f6d089-6afd10987c83a.jpg?jadewits_media_id=323434" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিশ্বের দূষিত শহরের তালিকায় দ্বিতীয় ঢাকা, শীর্ষে লাহোর" /&gt;&lt;/p&gt;&lt;p&gt;বিশ্বের দূষিত বায়ুর শহরের তালিকায় আজ শীর্ষে অবস্থানে করছে পাকিস্তানের লাহোর। বায়ুমান সূচকে স্কোর ২৮৪। তালিকায় দ্বিতীয় স্থানে রয়েছে রাজধানী ঢাকা, যার স্কোর ২০৮। যা বাতাসের মান &amp;lsquo;খুবই অস্বাস্থ্যকর&amp;rsquo; হিসেবে চিহ্নিত করা হয়েছে।
বুধবার (১৮ নভেম্বর) সকাল সাড়ে ৮টায় সুইজারল্যান্ডভিত্তিক বায়ুমান বিষ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821608/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%82%E0%A6%B7%E0%A6%BF%E0%A6%A4-%E0%A6%B6%E0%A6%B9%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%B6%E0%A7%80%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A7%87">দৈনিক ইত্তেফাক</source>

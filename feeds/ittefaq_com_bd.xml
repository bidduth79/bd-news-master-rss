      <guid isPermaLink="true">https://www.ittefaq.com.bd/820032/%E0%A6%AB%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%A6-%E0%A6%AA%E0%A7%81%E0%A6%A8%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AA%E0%A6%9A%E0%A7%87%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B9%E0%A6%A4%E0%A7%87-%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%9A%E0%A7%87%E0%A7%9F%E0%A7%87</guid>
      <pubDate>Tue, 10 Nov 2026 01:01:19 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/26ecad6c426607aa0960bce68e71a632-6af2185dda53e.jpg?jadewits_media_id=321805" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/26ecad6c426607aa0960bce68e71a632-6af2185dda53e.jpg?jadewits_media_id=321805" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/26ecad6c426607aa0960bce68e71a632-6af2185dda53e.jpg?jadewits_media_id=321805" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফ্যাসিবাদ পুনর্বাসনের অপচেষ্টা প্রতিহতে শক্তি চেয়ে সংসদে ধর্ম প্রতিমন্ত্রীর মোনাজাত" /&gt;&lt;/p&gt;&lt;p&gt;বিতাড়িত ফ্যাসিবাদকে পুনরায় কেউ ফিরিয়ে আনার চক্রান্ত বা পরিস্থিতি তৈরি করলে তা কঠোরভাবে প্রতিহত করার তৌফিক ও সক্ষমতা চেয়ে জাতীয় সংসদে বিশেষ মোনাজাত পরিচালনা করেছেন ধর্মবিষয়ক প্রতিমন্ত্রী শামীম কায়সার লিংকন। একই সঙ্গে দেশবাসীর প্রত্যাশা অনুযায়ী রাষ্ট্র পরিচালনায় সংসদ ও সরকারকে সক্ষমতা দানের জন্যও মহান&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820032/%E0%A6%AB%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%A6-%E0%A6%AA%E0%A7%81%E0%A6%A8%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AA%E0%A6%9A%E0%A7%87%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B9%E0%A6%A4%E0%A7%87-%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%9A%E0%A7%87%E0%A7%9F%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>এনসিপির নারী শক্তির সদস্য সচিব হলেন পাইলট ফারিয়াল হামিদ</title>
      <link>https://www.ittefaq.com.bd/820031/%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A6%9A%E0%A6%BF%E0%A6%AC-%E0%A6%B9%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AA%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A6%9F-%E0%A6%AB%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B2</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820031/%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A6%9A%E0%A6%BF%E0%A6%AC-%E0%A6%B9%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AA%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A6%9F-%E0%A6%AB%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B2</guid>
      <pubDate>Tue, 10 Nov 2026 00:48:19 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/53a822b506ff6322cd9af1273e33f788-6af2149f11c03.jpg?jadewits_media_id=321804" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/53a822b506ff6322cd9af1273e33f788-6af2149f11c03.jpg?jadewits_media_id=321804" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/53a822b506ff6322cd9af1273e33f788-6af2149f11c03.jpg?jadewits_media_id=321804" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এনসিপির নারী শক্তির সদস্য সচিব হলেন পাইলট ফারিয়াল হামিদ" /&gt;&lt;/p&gt;&lt;p&gt;জাতীয় নারী শক্তির ঢাকা মহানগর দক্ষিণের নবগঠিত আহ্বায়ক কমিটির সদস্য সচিবের দায়িত্ব পেয়েছেন বাণিজ্যিক সিভিল পাইলট ইথার ফারিয়াল হামিদ। তিনি জাতীয় নাগরিক পার্টির (এনসিপি) এই অঙ্গ সংগঠনের গুরুত্বপূর্ণ পদে ভূষিত হয়েছেন। পাইলট হিসেবে পরিচিতির পাশাপাশি বিমান চলাচল নিরাপত্তা ও বিমান দুর্ঘটনা বিষয়ক উচ্চতর গবে&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820031/%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A6%9A%E0%A6%BF%E0%A6%AC-%E0%A6%B9%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AA%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A6%9F-%E0%A6%AB%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B2">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>দুই কারণে শেখ হাসিনা পাসপোর্টের আবেদন করেছে: জামায়াত</title>
      <link>https://www.ittefaq.com.bd/820030/%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%AC%E0%A7%87%E0%A6%A6%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A7%87%E0%A6%9B%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820030/%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%AC%E0%A7%87%E0%A6%A6%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A7%87%E0%A6%9B%E0%A7%87</guid>
      <pubDate>Tue, 10 Nov 2026 00:20:31 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/1792167ed51d7ae739f8d276d448719a-6af20edbea316.jpg?jadewits_media_id=321803" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/1792167ed51d7ae739f8d276d448719a-6af20edbea316.jpg?jadewits_media_id=321803" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/1792167ed51d7ae739f8d276d448719a-6af20edbea316.jpg?jadewits_media_id=321803" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দুই কারণে শেখ হাসিনা পাসপোর্টের আবেদন করেছে: জামায়াত" /&gt;&lt;/p&gt;&lt;p&gt;সাবেক প্রধানমন্ত্রী শেখ হাসিনার নতুন পাসপোর্ট ও জাতীয় পরিচয়পত্রের (এনআইডি) জন্য আবেদনের পেছনে দুটি কারণ থাকতে পারে বলে মনে করছে জামায়াতে ইসলামী। শেখ হাসিনা দেশে ফেরার প্রক্রিয়া দেখানোর পাশাপাশি দলীয় নেতাকর্মীদের আশ্বস্ত করতেও এমন পদক্ষেপ নিয়ে থাকতে পারেন বলে দাবি দলটির।
সোমবার (৯ নভেম্বর) সন্ধ্যায় এ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820030/%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%AC%E0%A7%87%E0%A6%A6%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A7%87%E0%A6%9B%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>যাত্রাবাড়ীতে ৫ ককটেল ও মোটরসাইকেলসহ যুবক গ্রেপ্তার, পালিয়েছে সঙ্গী</title>
      <link>https://www.ittefaq.com.bd/820029/%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A7%AB-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%93-%E0%A6%AE%E0%A7%8B%E0%A6%9F%E0%A6%B0%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%87%E0%A6%B2%E0%A6%B8%E0%A6%B9-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%95</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820029/%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A7%AB-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%93-%E0%A6%AE%E0%A7%8B%E0%A6%9F%E0%A6%B0%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%87%E0%A6%B2%E0%A6%B8%E0%A6%B9-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%95</guid>
      <pubDate>Tue, 10 Nov 2026 00:13:40 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/61c3545ee8ddbe08185d859aa6219c43-6af20d396bce9.jpg?jadewits_media_id=321802" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/61c3545ee8ddbe08185d859aa6219c43-6af20d396bce9.jpg?jadewits_media_id=321802" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/61c3545ee8ddbe08185d859aa6219c43-6af20d396bce9.jpg?jadewits_media_id=321802" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যাত্রাবাড়ীতে ৫ ককটেল ও মোটরসাইকেলসহ যুবক গ্রেপ্তার, পালিয়েছে সঙ্গী" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর যাত্রাবাড়ীতে পুলিশের তল্লাশিচৌকিতে অভিযান চালিয়ে পাঁচটি তাজা ককটেল ও একটি মোটরসাইকেলসহ মোহাম্মদ সাইফুল ইসলাম (৩৫) নামে এক যুবককে গ্রেপ্তার করেছে পুলিশ। সোমবার (৯ নভেম্বর) রাত ৮টা ১০ মিনিটের দিকে যাত্রাবাড়ীর জনপদ মোড় ফ্লাইওভারের প্রবেশমুখে এ ঘটনা ঘটে। 
এ সময় তল্লাশি এড়িয়ে মোটরসাইকেলে থ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820029/%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A7%AB-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%93-%E0%A6%AE%E0%A7%8B%E0%A6%9F%E0%A6%B0%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%87%E0%A6%B2%E0%A6%B8%E0%A6%B9-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%95">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>কপ-৩১ বিশ্ব জলবায়ু সম্মেলনে যোগ দিতে তুরস্ক যাচ্ছেন খলিলুর রহমান</title>
      <link>https://www.ittefaq.com.bd/820028/%E0%A6%95%E0%A6%AA-%E0%A7%A9%E0%A7%A7-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC-%E0%A6%9C%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A7%81-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%A8%E0%A7%87-%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%95</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820028/%E0%A6%95%E0%A6%AA-%E0%A7%A9%E0%A7%A7-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC-%E0%A6%9C%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A7%81-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%A8%E0%A7%87-%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%95</guid>
      <pubDate>Tue, 10 Nov 2026 00:10:57 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/06b42c5c78d731f6631b4b73f0b7353e-6af20c94d52cb.jpg?jadewits_media_id=321801" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/06b42c5c78d731f6631b4b73f0b7353e-6af20c94d52cb.jpg?jadewits_media_id=321801" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/06b42c5c78d731f6631b4b73f0b7353e-6af20c94d52cb.jpg?jadewits_media_id=321801" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কপ-৩১ বিশ্ব জলবায়ু সম্মেলনে যোগ দিতে তুরস্ক যাচ্ছেন খলিলুর রহমান" /&gt;&lt;/p&gt;&lt;p&gt;জাতিসংঘের জলবায়ু সম্মেলন &amp;lsquo;কপ-৩১&amp;rsquo;-এর ওয়ার্ল্ড লিডার্স সামিটে যোগ দিতে তুরস্ক সফরে যাচ্ছেন বাংলাদেশের পররাষ্ট্রমন্ত্রী ও জাতিসংঘের ৮১তম সাধারণ পরিষদ অধিবেশনের সভাপতি খলিলুর রহমান।
সোমবার (৯ নভেম্বর) প্রচারিত এক ভিডিও বার্তায় তিনি নিজেই এ তথ্য নিশ্চিত করেছেন। তুরস্কের আন্তালিয়ায় অনুষ্ঠেয় এ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820028/%E0%A6%95%E0%A6%AA-%E0%A7%A9%E0%A7%A7-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC-%E0%A6%9C%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A7%81-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%A8%E0%A7%87-%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%95">দৈনিক ইত্তেফাক</source>
    </item>

    <item>
      <title>রুশ ঘাঁটিতে ইউক্রেনের হামলা পাঁচটি যুদ্ধবিমান ধ্বংস</title>
      <link>https://www.ittefaq.com.bd/823202/%E0%A6%B0%E0%A7%81%E0%A6%B6-%E0%A6%98%E0%A6%BE%E0%A6%81%E0%A6%9F%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%87%E0%A6%89%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%AA%E0%A6%BE%E0%A6%81%E0%A6%9A%E0%A6%9F%E0%A6%BF-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%AC%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823202/%E0%A6%B0%E0%A7%81%E0%A6%B6-%E0%A6%98%E0%A6%BE%E0%A6%81%E0%A6%9F%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%87%E0%A6%89%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%AA%E0%A6%BE%E0%A6%81%E0%A6%9A%E0%A6%9F%E0%A6%BF-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%AC%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8</guid>
      <pubDate>Fri, 27 Nov 2026 05:00:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/a74f10aa5302fa4a7abc5d7a92d9f813-6b08995045892.jpg?jadewits_media_id=325091" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/a74f10aa5302fa4a7abc5d7a92d9f813-6b08995045892.jpg?jadewits_media_id=325091" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/a74f10aa5302fa4a7abc5d7a92d9f813-6b08995045892.jpg?jadewits_media_id=325091" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রুশ ঘাঁটিতে ইউক্রেনের হামলা পাঁচটি যুদ্ধবিমান ধ্বংস" /&gt;&lt;/p&gt;&lt;p&gt;রাশিয়ার রাজধানী মস্কো থেকে ৩০০ কিলোমিটার পূর্বে অবস্থিত সাভাসলেইকা বিমানঘাঁটিতে হামলা চালিয়ে পাঁচটি যুদ্ধবিমান ধ্বংসের দাবি করেছে ইউক্রেনের সেনাবাহিনী। বুধবার এ হামলা পরিচালনা করা হয় বলে এক বিবৃতিতে জানিয়েছে ইউক্রেনের সেনাপ্রধানের দপ্তর। এদিকে ইউক্রেন যুদ্ধ বিস্তৃত হয় এমন পদক্ষেপ এড়াতে রাশিয়ার প্রতি&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823202/%E0%A6%B0%E0%A7%81%E0%A6%B6-%E0%A6%98%E0%A6%BE%E0%A6%81%E0%A6%9F%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%87%E0%A6%89%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%AA%E0%A6%BE%E0%A6%81%E0%A6%9A%E0%A6%9F%E0%A6%BF-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%AC%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>ভ্রমণ ভিসায় এসে প্রেমের ফাঁদ, তিন মাসে ১৫ নারীকে বিয়ে চীনা নাগরিকের</title>
      <link>https://www.ittefaq.com.bd/823204/%E0%A6%AD%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%A3-%E0%A6%AD%E0%A6%BF%E0%A6%B8%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%8F%E0%A6%B8%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AB%E0%A6%BE%E0%A6%81%E0%A6%A6-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A7%A7%E0%A7%AB-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823204/%E0%A6%AD%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%A3-%E0%A6%AD%E0%A6%BF%E0%A6%B8%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%8F%E0%A6%B8%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AB%E0%A6%BE%E0%A6%81%E0%A6%A6-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A7%A7%E0%A7%AB-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%87</guid>
      <pubDate>Fri, 27 Nov 2026 04:20:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/a078033c1192ec1d73b8f8f4744bdf15-6b08a63b2a118.jpg?jadewits_media_id=325093" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/a078033c1192ec1d73b8f8f4744bdf15-6b08a63b2a118.jpg?jadewits_media_id=325093" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/a078033c1192ec1d73b8f8f4744bdf15-6b08a63b2a118.jpg?jadewits_media_id=325093" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভ্রমণ ভিসায় এসে প্রেমের ফাঁদ, তিন মাসে ১৫ নারীকে বিয়ে চীনা নাগরিকের" /&gt;&lt;/p&gt;&lt;p&gt;টিকটকে পরিচয়ের পর মানিকগঞ্জের এক স্কুলছাত্রীকে ঢাকায় এনে আটকে রেখে ধর্ষণের অভিযোগে গ্রেপ্তার চীনা নাগরিক চেন ইয়ংয়ের (৪১) বিরুদ্ধে এবার বেরিয়ে এসেছে আরও চাঞ্চল্যকর তথ্য। পুলিশ জানিয়েছে, ভ্রমণ ভিসায় বাংলাদেশে এসে গত তিন মাসে অন্তত ১৫ জন নারীর সঙ্গে একই কায়দায় প্রতারণামূলক সম্পর্ক গড়ে তুলেছেন&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823204/%E0%A6%AD%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%A3-%E0%A6%AD%E0%A6%BF%E0%A6%B8%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%8F%E0%A6%B8%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AB%E0%A6%BE%E0%A6%81%E0%A6%A6-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A7%A7%E0%A7%AB-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%87">দৈনিক ইত্তেফাক</source>

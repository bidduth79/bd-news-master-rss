    <item>
      <title>বাংলাদেশ পরিত্যক্ত একটা দেশ: আসিফ মাহমুদ</title>
      <link>https://www.ittefaq.com.bd/820706/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%8F%E0%A6%95%E0%A6%9F%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%86%E0%A6%B8%E0%A6%BF%E0%A6%AB-%E0%A6%AE%E0%A6%BE%E0%A6%B9%E0%A6%AE%E0%A7%81%E0%A6%A6</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820706/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%8F%E0%A6%95%E0%A6%9F%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%86%E0%A6%B8%E0%A6%BF%E0%A6%AB-%E0%A6%AE%E0%A6%BE%E0%A6%B9%E0%A6%AE%E0%A7%81%E0%A6%A6</guid>
      <pubDate>Fri, 13 Nov 2026 11:04:28 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/59190ba04463115a071bc84dc898ff68-6af699fc1765e.jpg?jadewits_media_id=322497" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/59190ba04463115a071bc84dc898ff68-6af699fc1765e.jpg?jadewits_media_id=322497" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/59190ba04463115a071bc84dc898ff68-6af699fc1765e.jpg?jadewits_media_id=322497" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাংলাদেশ পরিত্যক্ত একটা দেশ: আসিফ মাহমুদ" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশকে &amp;lsquo;পরিত্যক্ত দেশ&amp;rsquo; আখ্যা দিয়ে আইনশৃঙ্খলা ও নিরাপত্তা পরিস্থিতি নিয়ে সমালোচনা করেছেন সাবেক অন্তর্বর্তী সরকারের উপদেষ্টা ও জাতীয় নাগরিক পার্টির (এনসিপি) মুখপাত্র আসিফ মাহমুদ সজীব ভূঁইয়া।
শুক্রবার (১৩ নভেম্বর) নিজের ফেসবুক অ্যাকাউন্টে দেওয়া এক পোস্টে তিনি এ মন্তব্য করেন।
ফেসবুক পোস্&lt;/p&gt;</description>

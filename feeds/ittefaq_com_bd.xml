    <item>
      <title>ট্রাম্পকে হত্যার ষড়যন্ত্র, যুক্তরাষ্ট্রে ২৭ বছরের কারাদণ্ড পাকিস্তানি নাগরিকের</title>
      <link>https://www.ittefaq.com.bd/821618/%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%B7%E0%A6%A1%E0%A6%BC%E0%A6%AF%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87-%E0%A7%A8%E0%A7%AD-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821618/%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%B7%E0%A6%A1%E0%A6%BC%E0%A6%AF%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87-%E0%A7%A8%E0%A7%AD-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Wed, 18 Nov 2026 09:25:55 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/c5b4221ed55f3ff6c7dfc966cab5ba50-6afd1a8fa2db8.jpg?jadewits_media_id=323443" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/c5b4221ed55f3ff6c7dfc966cab5ba50-6afd1a8fa2db8.jpg?jadewits_media_id=323443" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/c5b4221ed55f3ff6c7dfc966cab5ba50-6afd1a8fa2db8.jpg?jadewits_media_id=323443" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ট্রাম্পকে হত্যার ষড়যন্ত্র, যুক্তরাষ্ট্রে ২৭ বছরের কারাদণ্ড পাকিস্তানি নাগরিকের" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাষ্ট্রের প্রেসিডেন্ট ডোনাল্ড ট্রাম্প এবং অন্যান্য বিশিষ্ট মার্কিন রাজনীতিবিদদের হত্যার ষড়যন্ত্রের দায়ে দোষী সাব্যস্ত এক পাকিস্তানি নাগরিককে ২৭ বছরের বেশি কারাদণ্ড দিয়েছেন মার্কিন আদালত। মঙ্গলবার (১৭ নভেম্বর) যুক্তরাষ্ট্রের বিচার বিভাগ (ডিওজে) এই তথ্য জানিয়েছে।
এক বিবৃতিতে বিচার বিভাগ বলেছে&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821618/%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%B7%E0%A6%A1%E0%A6%BC%E0%A6%AF%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87-%E0%A7%A8%E0%A7%AD-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>চার মাসে প্রবাসী আয়ের ৪৪.৬ শতাংশ এসেছে ছয় উপসাগরীয় দেশ থেকে</title>

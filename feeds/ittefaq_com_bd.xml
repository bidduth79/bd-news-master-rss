    <item>
      <title>সন্তান ৬ বিষয় ফেল করায় প্রধান শিক্ষককে মারধর করলেন অভিভাবক</title>
      <link>https://www.ittefaq.com.bd/821591/%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8-%E0%A7%AC-%E0%A6%AC%E0%A6%BF%E0%A6%B7%E0%A7%9F-%E0%A6%AB%E0%A7%87%E0%A6%B2-%E0%A6%95%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%95%E0%A6%95%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%A7%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821591/%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8-%E0%A7%AC-%E0%A6%AC%E0%A6%BF%E0%A6%B7%E0%A7%9F-%E0%A6%AB%E0%A7%87%E0%A6%B2-%E0%A6%95%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%95%E0%A6%95%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%A7%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Wed, 18 Nov 2026 00:50:47 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/11e67c8c1ef510d3546d3e4b895139af-6afca1cbad15b.jpg?jadewits_media_id=323417" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/11e67c8c1ef510d3546d3e4b895139af-6afca1cbad15b.jpg?jadewits_media_id=323417" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/11e67c8c1ef510d3546d3e4b895139af-6afca1cbad15b.jpg?jadewits_media_id=323417" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সন্তান ৬ বিষয় ফেল করায় প্রধান শিক্ষককে মারধর করলেন অভিভাবক" /&gt;&lt;/p&gt;&lt;p&gt;এসএসসির নির্বাচনী (টেস্ট) পরীক্ষায় এক শিক্ষার্থী ছয় বিষয়ে অকৃতকার্য হওয়ায় যশোরের ঝিকরগাছায় একটি বিদ্যালয়ের প্রধান শিক্ষককে মারধরের অভিযোগ উঠেছে এক অভিভাবকের বিরুদ্ধে। এ ঘটনায় অভিযুক্ত অভিভাবক ইউনুস আলীকে আটক করেছে পুলিশ।
মঙ্গলবার (১৭ নভেম্বর) বেলা সাড়ে ১১টার দিকে ঝিকরগাছার সেন্ট লুইস মাধ্যমিক বিদ্যা&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821591/%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8-%E0%A7%AC-%E0%A6%AC%E0%A6%BF%E0%A6%B7%E0%A7%9F-%E0%A6%AB%E0%A7%87%E0%A6%B2-%E0%A6%95%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%95%E0%A6%95%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%A7%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>এবার রামপুরায় পুলিশ বক্সের সামনে যাত্রীবাহী বাসে আগুন</title>
      <link>https://www.ittefaq.com.bd/821590/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%AC%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A7%80-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821590/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%AC%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A7%80-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87</guid>
      <pubDate>Wed, 18 Nov 2026 00:47:57 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/199720b01c26bfffecd90953efdd4dd4-6afca15a8054e.jpg?jadewits_media_id=323416" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/199720b01c26bfffecd90953efdd4dd4-6afca15a8054e.jpg?jadewits_media_id=323416" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/199720b01c26bfffecd90953efdd4dd4-6afca15a8054e.jpg?jadewits_media_id=323416" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এবার রামপুরায় পুলিশ বক্সের সামনে যাত্রীবাহী বাসে আগুন" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীতে একের পর এক যাত্রীবাহী বাসে আগুন দেওয়ার ঘটনার মধ্যে এবার রামপুরায় রাইদা পরিবহনের একটি বাসে অগ্নিসংযোগ করা হয়েছে।
মঙ্গলবার (১৭ নভেম্বর) রাত সোয়া ১১টার দিকে রামপুরা ব্রিজসংলগ্ন পুলিশ বক্সের সামনে এ ঘটনা ঘটে। এতে কেউ হতাহত হয়নি।
ফায়ার সার্ভিস কন্ট্রোল রুমের ডিউটি অফিসার শাহজাহান মিয়া বিষয়টি নি&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821590/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%AC%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A7%80-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>

      <guid isPermaLink="true">https://www.ittefaq.com.bd/823045/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%9C-%E0%A6%AF%E0%A7%87-%E0%A6%A6%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3</guid>
      <pubDate>Thu, 26 Nov 2026 10:44:05 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/7a6166aa616012cd7b719ea2509bf6c2-6b07a2f3b45a8.jpg?jadewits_media_id=324919" length="0" type="image/jpeg" />

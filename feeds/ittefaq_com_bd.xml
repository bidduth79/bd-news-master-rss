      <guid isPermaLink="true">https://www.ittefaq.com.bd/822500/%E0%A6%B2%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8D%E0%A6%AE%E0%A7%80%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E2%80%98%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%81-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A7%81%E0%A6%A8%E2%80%99-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%9A%E0%A7%9F-%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A7%87</guid>
      <pubDate>Mon, 23 Nov 2026 00:41:24 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/4c14f4113c26dea970cafec2b0f2feef-6b0335e1f044d.jpg?jadewits_media_id=324340" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/4c14f4113c26dea970cafec2b0f2feef-6b0335e1f044d.jpg?jadewits_media_id=324340" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/4c14f4113c26dea970cafec2b0f2feef-6b0335e1f044d.jpg?jadewits_media_id=324340" style="max-width:100%;height:auto;margin-bottom:10px;" alt="লক্ষ্মীপুরে গ্রেপ্তার ‘বোমারু মামুন’, পরিচয় বদলে ছিলেন আত্মগোপনে" /&gt;&lt;/p&gt;&lt;p&gt;উগ্রবাদী সংগঠন নব্য জেএমবির সদস্য নাজমুল হাসান মামুন ওরফে &amp;lsquo;বোমারু মামুন&amp;rsquo; প্রায় দুই মাস ধরে পরিচয় গোপন করে লক্ষ্মীপুরের রায়পুর উপজেলায় আত্মগোপনে ছিলেন। স্থানীয় লোকজনের হাতে আটকের পর নিজের নাম সাইফুল ইসলাম সুজন বলে পরিচয় দেন তিনি। পরে পাঁচ দিনের রিমান্ডে জিজ্ঞাসাবাদে তার প্রকৃত পরিচয় জানতে&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822500/%E0%A6%B2%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8D%E0%A6%AE%E0%A7%80%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E2%80%98%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%81-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A7%81%E0%A6%A8%E2%80%99-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%9A%E0%A7%9F-%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A7%87">দৈনিক ইত্তেফাক</source>

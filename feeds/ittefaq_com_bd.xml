      <guid isPermaLink="true">https://www.ittefaq.com.bd/823314/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%98%E0%A7%8B%E0%A6%B7%E0%A6%A3%E0%A6%BE-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B8%E0%A7%9C%E0%A6%95-%E0%A6%85%E0%A6%AC%E0%A6%B0%E0%A7%8B%E0%A6%A7-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%9A%E0%A7%81%E0%A7%9F%E0%A7%87%E0%A6%9F%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Fri, 27 Nov 2026 21:44:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/4ee5805d9270cb45f113a5184d296a4c-6b09a48981f92.jpg?jadewits_media_id=325208" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/4ee5805d9270cb45f113a5184d296a4c-6b09a48981f92.jpg?jadewits_media_id=325208" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/4ee5805d9270cb45f113a5184d296a4c-6b09a48981f92.jpg?jadewits_media_id=325208" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এবার ঘোষণা দিয়ে সড়ক অবরোধ করলেন চুয়েটের শিক্ষার্থীরা" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রাম প্রকৌশল ও প্রযুক্তি বিশ্ববিদ্যালয়ে (চুয়েট) উপাচার্য নিয়োগকে কেন্দ্র করে টানা দুই মাসের প্রশাসনিক অচলাবস্থা ও &amp;lsquo;কমপ্লিট শাটডাউন&amp;rsquo; কর্মসূচির মধ্যে এবার চট্টগ্রাম-কাপ্তাই সড়ক অবরোধ করেছেন আন্দোলনরত শিক্ষার্থীরা। টানা দুই মাস ধরে চলে আসা এই সংকট নিরসনে দাবিতে শিক্ষার্থীরা ইতোপূর্বে ম&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823314/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%98%E0%A7%8B%E0%A6%B7%E0%A6%A3%E0%A6%BE-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B8%E0%A7%9C%E0%A6%95-%E0%A6%85%E0%A6%AC%E0%A6%B0%E0%A7%8B%E0%A6%A7-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%9A%E0%A7%81%E0%A7%9F%E0%A7%87%E0%A6%9F%E0%A7%87%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>ফেনীতে বিএনপির দুই পক্ষের সংঘর্ষে একজনের কবজি বিচ্ছিন্ন, আহত ২০</title>
      <link>https://www.ittefaq.com.bd/823313/%E0%A6%AB%E0%A7%87%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%AA%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%AC%E0%A6%9C%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823313/%E0%A6%AB%E0%A7%87%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%AA%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%AC%E0%A6%9C%E0%A6%BF</guid>
      <pubDate>Fri, 27 Nov 2026 21:26:52 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/f1aaf276bb5319e73c6a775651948915-6b09a0c9270c9.jpg?jadewits_media_id=325207" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/f1aaf276bb5319e73c6a775651948915-6b09a0c9270c9.jpg?jadewits_media_id=325207" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/f1aaf276bb5319e73c6a775651948915-6b09a0c9270c9.jpg?jadewits_media_id=325207" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফেনীতে বিএনপির দুই পক্ষের সংঘর্ষে একজনের কবজি বিচ্ছিন্ন, আহত ২০" /&gt;&lt;/p&gt;&lt;p&gt;ফেনীর দাগনভূঞায় বিএনপির দুই পক্ষের সংঘর্ষে অন্তত ২০ জন আহত হয়েছেন। এ সময় ককটেল বিস্ফোরণ, গুলির শব্দ ও পাল্টাপাল্টি ধাওয়ার ঘটনা ঘটে।
শুক্রবার (২৭ নভেম্বর) বিকেল পাঁচটার দিকে দাগনভূঞা পৌরসভার আলাইয়ারপুর গ্রামে পরিবেশমন্ত্রীর বাড়ির পাশে এ সংঘর্ষ হয়। খবর পেয়ে পুলিশ ঘটনাস্থলে গিয়ে পরিস্থিতি নিয়ন্ত্রণে আন&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823313/%E0%A6%AB%E0%A7%87%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%AA%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%AC%E0%A6%9C%E0%A6%BF">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>খুলনায় চাঁদা না দেওয়ায় বন্ধ দোকান, পুলিশের আশ্বাসে খোলার পর গুলি</title>
      <link>https://www.ittefaq.com.bd/823312/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%BE-%E0%A6%A8%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7-%E0%A6%A6%E0%A7%8B%E0%A6%95%E0%A6%BE%E0%A6%A8-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823312/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%BE-%E0%A6%A8%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7-%E0%A6%A6%E0%A7%8B%E0%A6%95%E0%A6%BE%E0%A6%A8-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87</guid>
      <pubDate>Fri, 27 Nov 2026 21:20:11 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/14cfabee384955de51daee145db125a1-6b099f0ecd7b9.jpg?jadewits_media_id=325206" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/14cfabee384955de51daee145db125a1-6b099f0ecd7b9.jpg?jadewits_media_id=325206" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/14cfabee384955de51daee145db125a1-6b099f0ecd7b9.jpg?jadewits_media_id=325206" style="max-width:100%;height:auto;margin-bottom:10px;" alt="খুলনায় চাঁদা না দেওয়ায় বন্ধ দোকান, পুলিশের আশ্বাসে খোলার পর গুলি" /&gt;&lt;/p&gt;&lt;p&gt;খুলনায় দুর্বৃত্তদের গুলিতে জারিফুজ্জামান ওরফে জারিফ (৩৩) নামে এক যুবক আহত হয়েছেন। আহত জারিফ খুলনার আলোচিত চয়নিকা ফার্মেসির মালিক এ বি এম দৌলতুজ্জামানের ছেলে।
শুক্রবার (২৭ নভেম্বর) সন্ধ্যা ৬টা ৫ মিনিটের দিকে নগরীর টুটপাড়া সেন্ট্রাল রোডে ফার্মেসির ভেতরে এ গুলিবর্ষণের ঘটনা ঘটে। গুলিবিদ্ধ জারিফুজ্জামানক&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823312/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%BE-%E0%A6%A8%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7-%E0%A6%A6%E0%A7%8B%E0%A6%95%E0%A6%BE%E0%A6%A8-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>তোমাদের বয়স হয়েছে, ভালো জায়গায় বিয়ে করিয়ে দিব— ছাত্র সংসদ নেতাদের জামায়াত আমির</title>
      <link>https://www.ittefaq.com.bd/823311/%E0%A6%A4%E0%A7%8B%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%9F%E0%A6%B8-%E0%A6%B9%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%AD%E0%A6%BE%E0%A6%B2%E0%A7%8B-%E0%A6%9C%E0%A6%BE%E0%A7%9F%E0%A6%97%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%95%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A6%E0%A6%BF%E0%A6%AC%E2%80%94</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/823311/%E0%A6%A4%E0%A7%8B%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%9F%E0%A6%B8-%E0%A6%B9%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%AD%E0%A6%BE%E0%A6%B2%E0%A7%8B-%E0%A6%9C%E0%A6%BE%E0%A7%9F%E0%A6%97%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%95%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A6%E0%A6%BF%E0%A6%AC%E2%80%94</guid>
      <pubDate>Fri, 27 Nov 2026 21:08:02 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/f94b7e5d5cc97a95b2be738c7050b44f-6b099c491bf6c.jpg?jadewits_media_id=325205" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/f94b7e5d5cc97a95b2be738c7050b44f-6b099c491bf6c.jpg?jadewits_media_id=325205" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/f94b7e5d5cc97a95b2be738c7050b44f-6b099c491bf6c.jpg?jadewits_media_id=325205" style="max-width:100%;height:auto;margin-bottom:10px;" alt="তোমাদের বয়স হয়েছে, ভালো জায়গায় বিয়ে করিয়ে দিব— ছাত্র সংসদ নেতাদের জামায়াত আমির" /&gt;&lt;/p&gt;&lt;p&gt;ছাত্র সংসদের নেতাদের বিয়ের বয়স হয়েছে উল্লেখ করে তাদের বিয়ে করিয়ে দেওয়ার আশ্বাস দিয়েছেন বিরোধীদলীয় নেতা ও জামায়াতে ইসলামীর আমির ডা. শফিকুর রহমান। শুধু বিয়ের প্রতিশ্রুতিই নয়, ভালো জায়গায় তাদের বিয়ে দেওয়ার প্রতিশ্রুতিও দিয়েছেন তিনি। একই সঙ্গে ছাত্রনেতাদের চাকরির পেছনে না ছুটে নেতৃত্ব, উদ্ভাবন ও উদ্যোক্&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/823311/%E0%A6%A4%E0%A7%8B%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%9F%E0%A6%B8-%E0%A6%B9%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%AD%E0%A6%BE%E0%A6%B2%E0%A7%8B-%E0%A6%9C%E0%A6%BE%E0%A7%9F%E0%A6%97%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%95%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A6%E0%A6%BF%E0%A6%AC%E2%80%94">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>ভারত থেকে টাকা পাঠিয়ে দেশে নাশকতা করাচ্ছে আওয়ামী লীগ: রিজভী</title>

      <guid isPermaLink="true">https://www.ittefaq.com.bd/821387/%E0%A6%9A%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%AE%E0%A6%AF%E0%A6%BC-%E0%A6%95%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%A3-%E0%A6%A6%E0%A6%BE%E0%A6%B8%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A7%9C%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE</guid>

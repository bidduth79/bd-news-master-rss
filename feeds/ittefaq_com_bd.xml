    <item>
      <title>কুড়িগ্রামে একসঙ্গে ৫ ছানার জন্ম দিল দেশি ছাগল</title>
      <link>https://www.ittefaq.com.bd/820242/%E0%A6%95%E0%A7%81%E0%A7%9C%E0%A6%BF%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A7%AB-%E0%A6%9B%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AE-%E0%A6%A6%E0%A6%BF%E0%A6%B2-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF-%E0%A6%9B%E0%A6%BE%E0%A6%97%E0%A6%B2</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820242/%E0%A6%95%E0%A7%81%E0%A7%9C%E0%A6%BF%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A7%AB-%E0%A6%9B%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AE-%E0%A6%A6%E0%A6%BF%E0%A6%B2-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF-%E0%A6%9B%E0%A6%BE%E0%A6%97%E0%A6%B2</guid>
      <pubDate>Wed, 11 Nov 2026 03:33:58 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/8eb3381d2f1a1a275f3dccd9d77fcaa8-6af35b65d7b8f.jpg?jadewits_media_id=322028" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/8eb3381d2f1a1a275f3dccd9d77fcaa8-6af35b65d7b8f.jpg?jadewits_media_id=322028" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/8eb3381d2f1a1a275f3dccd9d77fcaa8-6af35b65d7b8f.jpg?jadewits_media_id=322028" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কুড়িগ্রামে একসঙ্গে ৫ ছানার জন্ম দিল দেশি ছাগল" /&gt;&lt;/p&gt;&lt;p&gt;কুড়িগ্রামের ফুলবাড়ী উপজেলায় একটি দেশি জাতের ছাগলের একসঙ্গে পাঁচটি ছানার জন্ম দেওয়ার ঘটনা এলাকায় ব্যাপক কৌতূহল ও চাঞ্চল্যের সৃষ্টি করেছে। ব্যতিক্রমী এ খবর ছড়িয়ে পড়লে নবজাতক ছানাগুলোকে একনজর দেখতে ছাগলের মালিকের বাড়িতে প্রতিবেশীসহ আশপাশের উৎসুক মানুষের উপচে পড়া ভিড় জমে। বিষয়টি স্থানীয়দের &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820242/%E0%A6%95%E0%A7%81%E0%A7%9C%E0%A6%BF%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A7%AB-%E0%A6%9B%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AE-%E0%A6%A6%E0%A6%BF%E0%A6%B2-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF-%E0%A6%9B%E0%A6%BE%E0%A6%97%E0%A6%B2">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>এমটিবির ১৩৫ কোটি টাকার ঋণখেলাপি মামলা: সিটিসেলের শীর্ষ কর্মকর্তাদের গ্রেপ্তারে পুলিশের অভিযান</title>
      <link>https://www.ittefaq.com.bd/820241/%E0%A6%8F%E0%A6%AE%E0%A6%9F%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A7%A7%E0%A7%A9%E0%A7%AB-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%8B%E0%A6%A3%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A6%AA%E0%A6%BF-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%B8%E0%A6%BF%E0%A6%9F%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820241/%E0%A6%8F%E0%A6%AE%E0%A6%9F%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A7%A7%E0%A7%A9%E0%A7%AB-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%8B%E0%A6%A3%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A6%AA%E0%A6%BF-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%B8%E0%A6%BF%E0%A6%9F%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Tue, 10 Nov 2026 23:27:57 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/aa2ccf25d0dc59417a14f19dedf60a86-6af353fa029db.jpg?jadewits_media_id=322027" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/aa2ccf25d0dc59417a14f19dedf60a86-6af353fa029db.jpg?jadewits_media_id=322027" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/aa2ccf25d0dc59417a14f19dedf60a86-6af353fa029db.jpg?jadewits_media_id=322027" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এমটিবির ১৩৫ কোটি টাকার ঋণখেলাপি মামলা: সিটিসেলের শীর্ষ কর্মকর্তাদের গ্রেপ্তারে পুলিশের অভিযান" /&gt;&lt;/p&gt;&lt;p&gt;উচ্চপর্যায়ের ঋণখেলাপিদের বিরুদ্ধে চলমান কঠোর আইনি পদক্ষেপের অংশ হিসেবে বন্ধ হয়ে যাওয়া মোবাইল অপারেটর &amp;lsquo;সিটিসেল&amp;rsquo;-এর মূল পরিচালনাকারী প্রতিষ্ঠান প্যাসিফিক বাংলাদেশ টেলিকম লিমিটেডের (পিবিটিএল) শীর্ষ কর্মকর্তাদের গ্রেপ্তারে বিশেষ অভিযান শুরু করেছে আইনশৃঙ্খলা রক্ষাকারী বাহিনী। মিউচুয়াল ট্র&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820241/%E0%A6%8F%E0%A6%AE%E0%A6%9F%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A7%A7%E0%A7%A9%E0%A7%AB-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%8B%E0%A6%A3%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A6%AA%E0%A6%BF-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%B8%E0%A6%BF%E0%A6%9F%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0">দৈনিক ইত্তেফাক</source>

    <item>
      <title>রোহিঙ্গা গণহত্যার দায়ে আইসিজের রায়কে ‘অন্যায়’ বললো মিয়ানমার</title>
      <link>https://www.ittefaq.com.bd/822063/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%97%E0%A6%A3%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A7%9F%E0%A7%87-%E0%A6%86%E0%A6%87%E0%A6%B8%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A6%95%E0%A7%87-%E2%80%98%E0%A6%85%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A7%9F%E2%80%99-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A7%8B</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822063/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%97%E0%A6%A3%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A7%9F%E0%A7%87-%E0%A6%86%E0%A6%87%E0%A6%B8%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A6%95%E0%A7%87-%E2%80%98%E0%A6%85%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A7%9F%E2%80%99-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A7%8B</guid>
      <pubDate>Fri, 20 Nov 2026 17:00:21 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/89a659d09be397636871ddaea5f53856-6b002754e82d8.jpg?jadewits_media_id=323901" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/89a659d09be397636871ddaea5f53856-6b002754e82d8.jpg?jadewits_media_id=323901" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/89a659d09be397636871ddaea5f53856-6b002754e82d8.jpg?jadewits_media_id=323901" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রোহিঙ্গা গণহত্যার দায়ে আইসিজের রায়কে ‘অন্যায়’ বললো মিয়ানমার" /&gt;&lt;/p&gt;&lt;p&gt;রোহিঙ্গা মুসলিমদের বিরুদ্ধে গণহত্যার (জেনোসাইড) দায়ে মিয়ানমারকে দোষী সাব্যস্ত করেছে জাতিসংঘের সর্বোচ্চ আদালত আন্তর্জাতিক বিচার আদালত (আইসিজে)। আদালতের এ রায়কে &amp;lsquo;অন্যায্য&amp;rsquo; আখ্যা দিয়ে প্রত্যাখ্যান করেছে মিয়ানমারের সামরিক সরকার। দেশটির দাবি, তাদের বিরুদ্ধে অন্যায়ভাবে অভিযোগ আনা হয়েছে এবং আদা&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822063/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%97%E0%A6%A3%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A7%9F%E0%A7%87-%E0%A6%86%E0%A6%87%E0%A6%B8%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A6%95%E0%A7%87-%E2%80%98%E0%A6%85%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A7%9F%E2%80%99-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A7%8B">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>রোহিঙ্গা গণহত্যার রায় নেতানিয়াহুর জন্য গুরুত্বপূর্ণ সতর্কবার্তা</title>
      <link>https://www.ittefaq.com.bd/822062/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%97%E0%A6%A3%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B9%E0%A7%81%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822062/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%97%E0%A6%A3%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B9%E0%A7%81%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF</guid>
      <pubDate>Fri, 20 Nov 2026 16:49:23 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/5f4c9d24a5dea696de4c8ffe6de9f375-6b00252b67027.jpg?jadewits_media_id=323900" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/5f4c9d24a5dea696de4c8ffe6de9f375-6b00252b67027.jpg?jadewits_media_id=323900" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/5f4c9d24a5dea696de4c8ffe6de9f375-6b00252b67027.jpg?jadewits_media_id=323900" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রোহিঙ্গা গণহত্যার রায় নেতানিয়াহুর জন্য গুরুত্বপূর্ণ সতর্কবার্তা" /&gt;&lt;/p&gt;&lt;p&gt;মিয়ানমারের সেনাবাহিনীর বিরুদ্ধে রোহিঙ্গা গণহত্যার অভিযোগে আন্তর্জাতিক বিচার আদালতের (আইসিজে) রায় ইসরায়েলের জন্যও গুরুত্বপূর্ণ আইনি নজির তৈরি করেছে বলে মনে করছেন আন্তর্জাতিক আইন ও রাজনীতি বিশ্লেষকেরা। তাদের মতে, এই রায়ের মধ্য দিয়ে গণহত্যার অভিপ্রায় প্রমাণে সরাসরি বা অকাট্য দলিলের পাশাপাশি পারিপার্শ্ব&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822062/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%97%E0%A6%A3%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B9%E0%A7%81%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>টাঙ্গাইলে জুলাই শহীদ স্মৃতিস্তম্ভে অগ্নিসংযোগের ঘটনায় গ্রেপ্তার ৫</title>
      <link>https://www.ittefaq.com.bd/822061/%E0%A6%9F%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%87-%E0%A6%9C%E0%A7%81%E0%A6%B2%E0%A6%BE%E0%A6%87-%E0%A6%B6%E0%A6%B9%E0%A7%80%E0%A6%A6-%E0%A6%B8%E0%A7%8D%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%AE%E0%A7%8D%E0%A6%AD%E0%A7%87-%E0%A6%85%E0%A6%97%E0%A7%8D%E0%A6%A8%E0%A6%BF%E0%A6%B8%E0%A6%82%E0%A6%AF%E0%A7%87%E0%A6%BE%E0%A6%97%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822061/%E0%A6%9F%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%87-%E0%A6%9C%E0%A7%81%E0%A6%B2%E0%A6%BE%E0%A6%87-%E0%A6%B6%E0%A6%B9%E0%A7%80%E0%A6%A6-%E0%A6%B8%E0%A7%8D%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%AE%E0%A7%8D%E0%A6%AD%E0%A7%87-%E0%A6%85%E0%A6%97%E0%A7%8D%E0%A6%A8%E0%A6%BF%E0%A6%B8%E0%A6%82%E0%A6%AF%E0%A7%87%E0%A6%BE%E0%A6%97%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Fri, 20 Nov 2026 16:39:47 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/eb8096e1c94f167ef33ef80a16aa836d-6b002316aa65f.jpg?jadewits_media_id=323899" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/eb8096e1c94f167ef33ef80a16aa836d-6b002316aa65f.jpg?jadewits_media_id=323899" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/eb8096e1c94f167ef33ef80a16aa836d-6b002316aa65f.jpg?jadewits_media_id=323899" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টাঙ্গাইলে জুলাই শহীদ স্মৃতিস্তম্ভে অগ্নিসংযোগের ঘটনায় গ্রেপ্তার ৫" /&gt;&lt;/p&gt;&lt;p&gt;টাঙ্গাইলের মির্জাপুরে গোড়াই হাইওয়ে থানা সংলগ্ন জুলাই শহীদ স্মৃতিস্তম্ভে অগ্নিসংযোগের ঘটনায় ৫ জনকে গ্রেপ্তার করেছে পুলিশ। গ্রেপ্তাররা কার্যক্রম নিষিদ্ধঘোষিত সংগঠন আওয়ামী লীগ ও এর সহযোগী সংগঠনের সক্রিয় সদস্য বলে ভাষ্য পুলিশের।
সর্বশেষ শুক্রবার (২০ নভেম্বর) আদালতের মাধ্যমে তাদের কারাগারে পাঠানো হয়েছে।&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822061/%E0%A6%9F%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%87-%E0%A6%9C%E0%A7%81%E0%A6%B2%E0%A6%BE%E0%A6%87-%E0%A6%B6%E0%A6%B9%E0%A7%80%E0%A6%A6-%E0%A6%B8%E0%A7%8D%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%AE%E0%A7%8D%E0%A6%AD%E0%A7%87-%E0%A6%85%E0%A6%97%E0%A7%8D%E0%A6%A8%E0%A6%BF%E0%A6%B8%E0%A6%82%E0%A6%AF%E0%A7%87%E0%A6%BE%E0%A6%97%E0%A7%87%E0%A6%B0">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>সীমান্তে ২০ জনকে পুশইনের চেষ্টা, বিজিবির বাধায় ব্যর্থ</title>
      <link>https://www.ittefaq.com.bd/822060/%E0%A6%B8%E0%A7%80%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%87-%E0%A7%A8%E0%A7%A6-%E0%A6%9C%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B6%E0%A6%87%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A7%87%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%A7%E0%A6%BE%E0%A7%9F</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/822060/%E0%A6%B8%E0%A7%80%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%87-%E0%A7%A8%E0%A7%A6-%E0%A6%9C%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B6%E0%A6%87%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A7%87%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%A7%E0%A6%BE%E0%A7%9F</guid>
      <pubDate>Fri, 20 Nov 2026 16:37:20 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/10/11/07b652d0b56f3c355d081e0dcf53f2c6-6acafcea4bffa.jpg?jadewits_media_id=316025" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/10/11/07b652d0b56f3c355d081e0dcf53f2c6-6acafcea4bffa.jpg?jadewits_media_id=316025" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/10/11/07b652d0b56f3c355d081e0dcf53f2c6-6acafcea4bffa.jpg?jadewits_media_id=316025" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সীমান্তে ২০ জনকে পুশইনের চেষ্টা, বিজিবির বাধায় ব্যর্থ" /&gt;&lt;/p&gt;&lt;p&gt;মৌলভীবাজারের বড়লেখা সীমান্ত দিয়ে নারী-পুরুষসহ ২০ জনকে বাংলাদেশে পুশইনের চেষ্টা করেছে ভারতীয় সীমান্তরক্ষী বাহিনী (বিএসএফ)। তবে বিজিবির সতর্ক অবস্থান ও তৎপরতায় তাদের সেই চেষ্টা ব্যর্থ হয়েছে। ফলে ওই ২০ জন বাংলাদেশের অভ্যন্তরে প্রবেশ করতে পারেননি।
বৃহস্পতিবার (১৯ নভেম্বর) রাতে বড়লেখা উপজেলার দুর্গম লাতু&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/822060/%E0%A6%B8%E0%A7%80%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%87-%E0%A7%A8%E0%A7%A6-%E0%A6%9C%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B6%E0%A6%87%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A7%87%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%A7%E0%A6%BE%E0%A7%9F">দৈনিক ইত্তেফাক</source>

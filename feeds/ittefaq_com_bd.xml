    <item>
      <title>অনিয়ন্ত্রিত ডায়াবেটিসে বাড়ে বহু রোগের ঝুঁকি</title>
      <link>https://www.ittefaq.com.bd/820847/%E0%A6%85%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%A4-%E0%A6%A1%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%9F%E0%A6%BF%E0%A6%B8%E0%A7%87%C2%A0%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A7%87-%E0%A6%AC%E0%A6%B9%E0%A7%81-%E0%A6%B0%E0%A7%8B%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%9D%E0%A7%81%E0%A6%81%E0%A6%95%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820847/%E0%A6%85%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%A4-%E0%A6%A1%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%9F%E0%A6%BF%E0%A6%B8%E0%A7%87%C2%A0%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A7%87-%E0%A6%AC%E0%A6%B9%E0%A7%81-%E0%A6%B0%E0%A7%8B%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%9D%E0%A7%81%E0%A6%81%E0%A6%95%E0%A6%BF</guid>
      <pubDate>Sat, 14 Nov 2026 08:00:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/c59500346a440d013471ab9e97135a5e-6af75dd832133.jpg?jadewits_media_id=322645" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/c59500346a440d013471ab9e97135a5e-6af75dd832133.jpg?jadewits_media_id=322645" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/c59500346a440d013471ab9e97135a5e-6af75dd832133.jpg?jadewits_media_id=322645" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অনিয়ন্ত্রিত ডায়াবেটিসে বাড়ে বহু রোগের ঝুঁকি" /&gt;&lt;/p&gt;&lt;p&gt;বিশ্বব্যাপী উল্লেখযোগ্য জনস্বাস্থ্য সমস্যা ডায়াবেটিস। এই রোগে আক্রান্ত ব্যক্তিরা কেবল গ্লুকোজের সমস্যায় ভোগেন না, তারা দীর্ঘমেয়াদি নানা রোগের জটিলতায় ভোগেন। ডায়াবেটিস নিয়ন্ত্রণে না থাকলে শরীরের বিভিন্ন অঙ্গ ক্ষতিগ্রস্ত হয়&amp;mdash;যার মধ্যে হূদেরাগ, কিডনি, চোখ, মস্তিষ্ক, স্নায়ু এবং রক্তনালির জটিলতা দেখ&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820847/%E0%A6%85%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%A4-%E0%A6%A1%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%9F%E0%A6%BF%E0%A6%B8%E0%A7%87%C2%A0%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A7%87-%E0%A6%AC%E0%A6%B9%E0%A7%81-%E0%A6%B0%E0%A7%8B%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%9D%E0%A7%81%E0%A6%81%E0%A6%95%E0%A6%BF">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>নারী বদলাইতেছে, সমাজ কি বদলাইবে?</title>
      <link>https://www.ittefaq.com.bd/820857/%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%A4%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%9C-%E0%A6%95%E0%A6%BF-%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%AC%E0%A7%87</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820857/%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%A4%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%9C-%E0%A6%95%E0%A6%BF-%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%AC%E0%A7%87</guid>
      <pubDate>Sat, 14 Nov 2026 07:30:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2025/03/11/01bd9f25252561a677fb8c828c703ffa-67cff76a8ea1b.jpg?jadewits_media_id=215097" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2025/03/11/01bd9f25252561a677fb8c828c703ffa-67cff76a8ea1b.jpg?jadewits_media_id=215097" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2025/03/11/01bd9f25252561a677fb8c828c703ffa-67cff76a8ea1b.jpg?jadewits_media_id=215097" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নারী বদলাইতেছে, সমাজ কি বদলাইবে?" /&gt;&lt;/p&gt;&lt;p&gt;বিবাহের পর চাকুরি ছাড়িতে হইবে কি না, নিজের উপার্জনের উপর নিজের অধিকার থাকিবে কি না, সন্তান জন্মদানের পর পেশাগত জীবনে ফিরিতে পারিবেন কি না-এখন বিবাহের সিদ্ধান্ত লইবার আগে অনেক নারী এই প্রশ্নগুলির উত্তর খুঁজিতেছেন। একসময় যে বিষয়গুলি পারিবারিক জীবনের স্বাভাবিক নিয়ম বলিয়া মানিয়া লওয়া হইত, শিক্ষিত ও কর্ম&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820857/%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%A4%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%9C-%E0%A6%95%E0%A6%BF-%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%AC%E0%A7%87">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>গ্রামাঞ্চলে বাড়ছে ডেঙ্গু, মশা নিধনের তাগিদ</title>
      <link>https://www.ittefaq.com.bd/820848/%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%B2%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%9B%E0%A7%87-%E0%A6%A1%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%81-%C2%A0%E0%A6%AE%E0%A6%B6%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%A7%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A4%E0%A6%BE%E0%A6%97%E0%A6%BF%E0%A6%A6</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820848/%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%B2%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%9B%E0%A7%87-%E0%A6%A1%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%81-%C2%A0%E0%A6%AE%E0%A6%B6%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%A7%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A4%E0%A6%BE%E0%A6%97%E0%A6%BF%E0%A6%A6</guid>
      <pubDate>Sat, 14 Nov 2026 07:00:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/07/15/ed65c04f562f9aaac9417829579e94d6-6a5774168359d.jpg?jadewits_media_id=299306" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/07/15/ed65c04f562f9aaac9417829579e94d6-6a5774168359d.jpg?jadewits_media_id=299306" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/07/15/ed65c04f562f9aaac9417829579e94d6-6a5774168359d.jpg?jadewits_media_id=299306" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গ্রামাঞ্চলে বাড়ছে ডেঙ্গু, মশা নিধনের তাগিদ" /&gt;&lt;/p&gt;&lt;p&gt;দেশে এডিস মশার বিস্তার কমছে না। প্রধানত বর্ষাকালের রোগ হলেও ডেঙ্গুর প্রাদুর্ভাব কমবেশি ১২ মাসই থাকতে পারে। এমন সতর্কবার্তা দিয়েছেন কীটতত্ত্ববিদ ও জনস্বাস্থ্যবিদেরা। তাদের মতে, অক্টোবর-নভেম্বর থেকে বৃষ্টিপাত কমে যায়। তখন ডেঙ্গুর প্রাদুর্ভাব কিংবা জ্বরে আক্রান্ত হার শূন্যের কোটায় নেমে আসে। চলতি বছরে ড&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820848/%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%B2%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%9B%E0%A7%87-%E0%A6%A1%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%81-%C2%A0%E0%A6%AE%E0%A6%B6%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%A7%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A4%E0%A6%BE%E0%A6%97%E0%A6%BF%E0%A6%A6">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>বিদেশি আদালতের গ্রেফতারি পরোয়ানা স্বয়ংক্রিয়ভাবে কার্যকরের সুযোগ নেই</title>
      <link>https://www.ittefaq.com.bd/820850/%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF-%E0%A6%86%E0%A6%A6%E0%A6%BE%E0%A6%B2%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%BF%C2%A0%E0%A6%AA%E0%A6%B0%E0%A7%8B%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820850/%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF-%E0%A6%86%E0%A6%A6%E0%A6%BE%E0%A6%B2%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%BF%C2%A0%E0%A6%AA%E0%A6%B0%E0%A7%8B%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%BE</guid>
      <pubDate>Sat, 14 Nov 2026 06:00:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/09/14/fd2a0bd1aaebf833a9defe4f10b6170f-6aa7e7ed37fd6.jpg?jadewits_media_id=311066" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/09/14/fd2a0bd1aaebf833a9defe4f10b6170f-6aa7e7ed37fd6.jpg?jadewits_media_id=311066" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/09/14/fd2a0bd1aaebf833a9defe4f10b6170f-6aa7e7ed37fd6.jpg?jadewits_media_id=311066" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিদেশি আদালতের গ্রেফতারি পরোয়ানা স্বয়ংক্রিয়ভাবে কার্যকরের সুযোগ নেই" /&gt;&lt;/p&gt;&lt;p&gt;অর্থ আত্মসাতের মামলায় বাংলাদেশি এক নাগরিকের বিরুদ্ধে গ্রেফতারি পরোয়ানা জারি করে সংযুক্ত আরব আমিরাতের একটি আদালত। শুধু গ্রেফতারি পরোয়ানা জারিই নয়, দেওয়া হয় কারাদণ্ড, করা হয় প্রায় ১০ কোটি টাকা জরিমানা। বিচারের শুরু থেকে বাংলাদেশি ঐ নাগরিক ছিলেন পলাতক। পরবর্তীকালে ঐ নাগরিকের অবস্থান বাংলাদেশে জানতে পের&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820850/%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF-%E0%A6%86%E0%A6%A6%E0%A6%BE%E0%A6%B2%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%BF%C2%A0%E0%A6%AA%E0%A6%B0%E0%A7%8B%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%BE">দৈনিক ইত্তেফাক</source>
    </item>
    <item>
      <title>টেকনাফের পাহাড় এখন সশস্ত্র অপহরণকারীদের আস্তানা</title>
      <link>https://www.ittefaq.com.bd/820860/%E0%A6%9F%E0%A7%87%E0%A6%95%E0%A6%A8%E0%A6%BE%E0%A6%AB%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A7%9C-%E0%A6%8F%E0%A6%96%E0%A6%A8-%E0%A6%B8%E0%A6%B6%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%85%E0%A6%AA%E0%A6%B9%E0%A6%B0%E0%A6%A3%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/820860/%E0%A6%9F%E0%A7%87%E0%A6%95%E0%A6%A8%E0%A6%BE%E0%A6%AB%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A7%9C-%E0%A6%8F%E0%A6%96%E0%A6%A8-%E0%A6%B8%E0%A6%B6%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%85%E0%A6%AA%E0%A6%B9%E0%A6%B0%E0%A6%A3%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%BE</guid>
      <pubDate>Sat, 14 Nov 2026 05:28:00 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/c34c3f64b56dbb088d5fad171275c5bd-6af77a084e4f0.jpg?jadewits_media_id=322654" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/c34c3f64b56dbb088d5fad171275c5bd-6af77a084e4f0.jpg?jadewits_media_id=322654" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/c34c3f64b56dbb088d5fad171275c5bd-6af77a084e4f0.jpg?jadewits_media_id=322654" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টেকনাফের পাহাড় এখন সশস্ত্র অপহরণকারীদের আস্তানা" /&gt;&lt;/p&gt;&lt;p&gt;কক্সবাজারের টেকনাফের একসময়কার শান্ত ও নিরাপদ পাহাড় এখন সশস্ত্র মানব পাচারকারী ও অপহরণকারীদের আস্তানায় পরিণত হয়েছে। এসব অপরাধী চক্রের দৌরাত্ম্যে পাহাড়সংলগ্ন এলাকার কৃষক, শ্রমিক ও সাধারণ বাসিন্দাদের জীবনযাত্রা অনিরাপদ হয়ে উঠেছে। প্রতিনিয়ত আতঙ্কের মধ্যে দিন কাটছে তাদের।
স্থানীয় সূত্রে জানা গেছে, একসময় &lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/820860/%E0%A6%9F%E0%A7%87%E0%A6%95%E0%A6%A8%E0%A6%BE%E0%A6%AB%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A7%9C-%E0%A6%8F%E0%A6%96%E0%A6%A8-%E0%A6%B8%E0%A6%B6%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%85%E0%A6%AA%E0%A6%B9%E0%A6%B0%E0%A6%A3%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%BE">দৈনিক ইত্তেফাক</source>

      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/c6a95cf1113b2e116f14318518ed03fd-6af96dd6006d3.jpg?jadewits_media_id=322896" length="0" type="image/jpeg" />

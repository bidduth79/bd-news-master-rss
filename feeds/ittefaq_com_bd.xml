    <item>
      <title>ঘরের দরজা ভেতর থেকে বন্ধ, দুই হাত বাঁধা অবস্থায় ঝুলছিল যুবকের মরদেহ</title>
      <link>https://www.ittefaq.com.bd/821003/%E0%A6%98%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%B0%E0%A6%9C%E0%A6%BE-%E0%A6%AD%E0%A7%87%E0%A6%A4%E0%A6%B0-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%B9%E0%A6%BE%E0%A6%A4-%E0%A6%AC%E0%A6%BE%E0%A6%81%E0%A6%A7%E0%A6%BE-%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A7%9F</link>
      <guid isPermaLink="true">https://www.ittefaq.com.bd/821003/%E0%A6%98%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%B0%E0%A6%9C%E0%A6%BE-%E0%A6%AD%E0%A7%87%E0%A6%A4%E0%A6%B0-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%B9%E0%A6%BE%E0%A6%A4-%E0%A6%AC%E0%A6%BE%E0%A6%81%E0%A6%A7%E0%A6%BE-%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A7%9F</guid>
      <pubDate>Sat, 14 Nov 2026 21:53:57 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/66a2aaa501f53f3835709c6c2fcde1d0-6af883d0efaf2.jpg?jadewits_media_id=322806" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/66a2aaa501f53f3835709c6c2fcde1d0-6af883d0efaf2.jpg?jadewits_media_id=322806" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/66a2aaa501f53f3835709c6c2fcde1d0-6af883d0efaf2.jpg?jadewits_media_id=322806" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঘরের দরজা ভেতর থেকে বন্ধ, দুই হাত বাঁধা অবস্থায় ঝুলছিল যুবকের মরদেহ" /&gt;&lt;/p&gt;&lt;p&gt;বরগুনার আমতলী উপজেলায় নিজ ঘর থেকে তুহিন মুন্সি (২২) নামে এক যুবকের দুই হাত বাঁধা অবস্থায় ঝুলন্ত মরদেহ উদ্ধার করেছে পুলিশ। তার গলায় ফাঁস লাগানো ছিল। তবে মরদেহ উদ্ধারের সময় ঘরের দরজা ভেতর থেকে বন্ধ ছিল বলে জানিয়েছে পুলিশ।
শনিবার (১৪ নভেম্বর) বিকেলে উপজেলার চাওড়া ইউনিয়নের লোদা এলাকায় নিজ ঘর থেকে তার মর&lt;/p&gt;</description>

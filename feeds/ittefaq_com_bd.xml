      <guid isPermaLink="true">https://www.ittefaq.com.bd/822964/%E0%A6%B8%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%9F%E0%A7%87-%E0%A6%86%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%95-%E0%A6%B9%E0%A7%8B%E0%A6%9F%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A6%95%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95</guid>
      <pubDate>Wed, 25 Nov 2026 17:22:15 +0600</pubDate>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/f84cefe923c834d8430a6e53b55d3ef6-6b06c47eb262a.jpg?jadewits_media_id=324821" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/f84cefe923c834d8430a6e53b55d3ef6-6b06c47eb262a.jpg?jadewits_media_id=324821" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/f84cefe923c834d8430a6e53b55d3ef6-6b06c47eb262a.jpg?jadewits_media_id=324821" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সিলেটে আবাসিক হোটেলে অভিযান: কক্সবাজারের সাবেক এমপি বদির ছেলে ও ২ ভাই আটক" /&gt;&lt;/p&gt;&lt;p&gt;সিলেট নগরীর একটি আবাসিক হোটেলে পুলিশ রাতভর অভিযান চালিয়ে কার্যক্রম নিষিদ্ধ আওয়ামী লীগের কক্সবাজারের সাবেক সংসদ আব্দুর রহমান বদির ছেলে ও দুই ভাইসহ চারজনকে আটক করেছে।
বুধবার (২৫ নভেম্বর) সিলেটে মেট্রোপলিটন পুলিশের উপ কমিশনার (উত্তর) সাইফুল ইসলাম এ তথ্যের সত্যতা নিশ্চিত করেছেন।
এর আগে মঙ্গলবার দিবাগত র&lt;/p&gt;</description>

      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/b78e7bb2852d497db9cf23411a63207b-6afbbe3dc1f44.jpg?jadewits_media_id=323223" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/b78e7bb2852d497db9cf23411a63207b-6afbbe3dc1f44.jpg?jadewits_media_id=323223" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/b78e7bb2852d497db9cf23411a63207b-6afbbe3dc1f44.jpg?jadewits_media_id=323223" style="max-width:100%;height:auto;margin-bottom:10px;" alt="লন্ডনে নাহিদ ইসলামের সংবর্ধনা শেষে আওয়ামী লীগ-এনসিপি সংঘর্ষ, আহত অন্তত চার" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাজ্যের লন্ডনে জাতীয় নাগরিক পার্টির (এনসিপি) আহ্বায়ক ও বিরোধীদলীয় চিফ হুইপ নাহিদ ইসলামকে দেওয়া সংবর্ধনা অনুষ্ঠান শেষে আওয়ামী লীগ ও এনসিপির নেতা-কর্মীদের মধ্যে সংঘর্ষের ঘটনা ঘটেছে। এতে অন্তত চারজন গুরুতর আহত হয়েছেন বলে দাবি করেছে এনসিপি। আহত কয়েকজনকে হাসপাতালে নেওয়া হয়েছে। তাঁদের মধ্যে পাঁচজন কি&lt;/p&gt;</description>
      <source url="https://www.ittefaq.com.bd/821409/%E0%A6%B2%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A6%A8%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A6-%E0%A6%87%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%82%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A7%E0%A6%A8%E0%A6%BE-%E0%A6%B6%E0%A7%87%E0%A6%B7%E0%A7%87-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80">দৈনিক ইত্তেফাক</source>

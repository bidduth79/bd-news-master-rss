    <item>
      <title>ইউরোপের যেসব দেশ ইরানেই হামলার লক্ষবস্তু হতে পারে</title>
      <link>https://www.sangbadkonika.com/international/%e0%a6%87%e0%a6%89%e0%a6%b0%e0%a7%8b%e0%a6%aa%e0%a7%87%e0%a6%b0-%e0%a6%af%e0%a7%87%e0%a6%b8%e0%a6%ac-%e0%a6%a6%e0%a7%87%e0%a6%b6-%e0%a6%87%e0%a6%b0%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%87-%e0%a6%b9/</link>

    <item>
      <title>মায়ানমারে সিমেন্ট পাচারের সময় আটক ৯</title>
      <link>https://www.sangbadkonika.com/local-news/chittagong/%e0%a6%ae%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%a8%e0%a6%ae%e0%a6%be%e0%a6%b0%e0%a7%87-%e0%a6%b8%e0%a6%bf%e0%a6%ae%e0%a7%87%e0%a6%a8%e0%a7%8d%e0%a6%9f-%e0%a6%aa%e0%a6%be%e0%a6%9a%e0%a6%be%e0%a6%b0/</link>

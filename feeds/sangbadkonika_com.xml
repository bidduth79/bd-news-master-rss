    </item>
    <item>
      <title>পোশাকশিল্পের শ্রমিক অসন্তোষ নিয়ন্ত্রণে এসেছে: বাণিজ্যমন্ত্রী</title>
      <link>https://sangbadkonika.com/national/%e0%a6%aa%e0%a7%8b%e0%a6%b6%e0%a6%be%e0%a6%95%e0%a6%b6%e0%a6%bf%e0%a6%b2%e0%a7%8d%e0%a6%aa%e0%a7%87%e0%a6%b0-%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a6%ae%e0%a6%bf%e0%a6%95-%e0%a6%85%e0%a6%b8%e0%a6%a8%e0%a7%8d/</link>

      <title>বিনা চিকিৎসায় কারাগারেই মৃত্যুর আশঙ্কার কথা জানালেন ইমরান খান</title>
      <link>https://www.sangbadkonika.com/international/%e0%a6%ac%e0%a6%bf%e0%a6%a8%e0%a6%be-%e0%a6%9a%e0%a6%bf%e0%a6%95%e0%a6%bf%e0%a7%8e%e0%a6%b8%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%be%e0%a6%97%e0%a6%be%e0%a6%b0%e0%a7%87%e0%a6%87/</link>
      <guid isPermaLink="true">https://www.sangbadkonika.com/international/%e0%a6%ac%e0%a6%bf%e0%a6%a8%e0%a6%be-%e0%a6%9a%e0%a6%bf%e0%a6%95%e0%a6%bf%e0%a7%8e%e0%a6%b8%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%be%e0%a6%97%e0%a6%be%e0%a6%b0%e0%a7%87%e0%a6%87/</guid>
      <pubDate>Tue, 17 Nov 2026 04:35:09 +0000</pubDate>
      <description>আন্তর্জাতিক ডেস্ক :  কারাগারে প্রয়োজনীয় চিকিৎসা না পেলে মৃত্যুর আশঙ্কা রয়েছে বলে উদ্বেগ প্রকাশ করেছেন পাকিস্তানের সাবেক প্রধানমন্ত্রী ইমরান খান। নিজের ও স্ত্রী বুশরা বিবির সুচিকিৎসা নিশ্চিত করতে দেশটির শীর্ষ বিচারপতিদের কাছে খোলা চিঠি লিখেছেন তিনি। একই সঙ্গে চিকিৎসা ও কারাবাসের পরিস্থিতি নিয়ে আদালতে</description>
      <source url="https://www.sangbadkonika.com/international/%e0%a6%ac%e0%a6%bf%e0%a6%a8%e0%a6%be-%e0%a6%9a%e0%a6%bf%e0%a6%95%e0%a6%bf%e0%a7%8e%e0%a6%b8%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%be%e0%a6%97%e0%a6%be%e0%a6%b0%e0%a7%87%e0%a6%87/">সংবাদ কণিকা</source>
    </item>
    <item>
      <title>জলবায়ু সহনশীলতা ও ডিজিটাল রূপান্তর: সাধারণ মানুষের কল্যাণে প্রযুক্তির ব্যবহার</title>
      <link>https://www.sangbadkonika.com/editorial/%e0%a6%9c%e0%a6%b2%e0%a6%ac%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a7%81-%e0%a6%b8%e0%a6%b9%e0%a6%a8%e0%a6%b6%e0%a7%80%e0%a6%b2%e0%a6%a4%e0%a6%be-%e0%a6%93-%e0%a6%a1%e0%a6%bf%e0%a6%9c%e0%a6%bf%e0%a6%9f/</link>

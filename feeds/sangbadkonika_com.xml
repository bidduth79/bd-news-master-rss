    <item>
      <title>রূপপুর বিদ্যুৎকেন্দ্রে পৌছালো ইউরেনিয়ামের আরও একটি চালান</title>
      <link>https://www.sangbadkonika.com/national/%e0%a6%b0%e0%a7%82%e0%a6%aa%e0%a6%aa%e0%a7%81%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a7%81%e0%a7%8e%e0%a6%95%e0%a7%87%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a7%8d%e0%a6%b0%e0%a7%87-%e0%a6%aa/</link>
      <guid isPermaLink="true">https://www.sangbadkonika.com/national/%e0%a6%b0%e0%a7%82%e0%a6%aa%e0%a6%aa%e0%a7%81%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a7%81%e0%a7%8e%e0%a6%95%e0%a7%87%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a7%8d%e0%a6%b0%e0%a7%87-%e0%a6%aa/</guid>
      <pubDate>Fri, 20 Nov 2026 14:13:46 +0000</pubDate>
      <description>রাশিয়া থেকে আনা ইউরেনিয়ামের আরও একটি চালান রূপপুর পারমাণবিক বিদ্যুৎকেন্দ্রে পৌঁছেছে। শুক্রবার (২০ নভেম্বর) সকালে সেনাবাহিনীসহ বিভিন্ন আইনশৃঙ্খলা রক্ষাকারী বাহিনীর নিরাপত্তায় তিনটি বিশেষায়িত লরিতে করে ইউরেনিয়াম প্রকল্প এলাকায় নেওয়া হয়। সংশ্লিষ্ট সূত্র জানায়, বৃহস্পতিবার  (১৯ নভেম্বর) দিবাগত রাতে ঢাকা</description>
      <source url="https://www.sangbadkonika.com/national/%e0%a6%b0%e0%a7%82%e0%a6%aa%e0%a6%aa%e0%a7%81%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a7%81%e0%a7%8e%e0%a6%95%e0%a7%87%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a7%8d%e0%a6%b0%e0%a7%87-%e0%a6%aa/">সংবাদ কণিকা</source>
    </item>
    <item>
      <title>নোয়াখালীতে ৮ ইউনিয়ন পরিষদে তালা দিল যুবদল–ছাত্রদল</title>
      <link>https://www.sangbadkonika.com/local-news/chittagong/%e0%a6%a8%e0%a7%8b%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%96%e0%a6%be%e0%a6%b2%e0%a7%80%e0%a6%a4%e0%a7%87-%e0%a7%ae-%e0%a6%87%e0%a6%89%e0%a6%a8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%a8-%e0%a6%aa%e0%a6%b0/</link>

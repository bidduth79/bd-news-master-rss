    <item>
      <title>স্বর্ণের দাম তৃতীয় দফায় কমলো</title>
      <link>https://www.sangbadkonika.com/%e0%a6%b8%e0%a7%8d%e0%a6%ac%e0%a6%b0%e0%a7%8d%e0%a6%a3%e0%a7%87%e0%a6%b0-%e0%a6%a6%e0%a6%be%e0%a6%ae-%e0%a6%a4%e0%a7%83%e0%a6%a4%e0%a7%80%e0%a6%af%e0%a6%bc-%e0%a6%a6%e0%a6%ab%e0%a6%be%e0%a6%af/</link>

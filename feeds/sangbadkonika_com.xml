    <item>
      <title>২৪ ঘণ্টায় ডেঙ্গুতে ৮ জনের মৃত্যু</title>
      <link>https://www.sangbadkonika.com/national/%e0%a7%a8%e0%a7%aa-%e0%a6%98%e0%a6%a3%e0%a7%8d%e0%a6%9f%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%a1%e0%a7%87%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%81%e0%a6%a4%e0%a7%87-%e0%a7%ae-%e0%a6%9c%e0%a6%a8%e0%a7%87/</link>
      <guid isPermaLink="true">https://www.sangbadkonika.com/national/%e0%a7%a8%e0%a7%aa-%e0%a6%98%e0%a6%a3%e0%a7%8d%e0%a6%9f%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%a1%e0%a7%87%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%81%e0%a6%a4%e0%a7%87-%e0%a7%ae-%e0%a6%9c%e0%a6%a8%e0%a7%87/</guid>
      <pubDate>Sat, 14 Nov 2026 12:18:15 +0000</pubDate>
      <description>দেশে ডেঙ্গুর প্রকোপ বেড়েই চলেছে। গত ২৪ ঘণ্টায় ডেঙ্গুতে আক্রান্ত হয়ে আরও আটজনের মৃত্যু হয়েছে। একই সময়ে নতুন করে ১ হাজার ৬৭৪ জন রোগী হাসপাতালে ভর্তি হয়েছেন। শনিবার স্বাস্থ্য অধিদপ্তরের হেলথ ইমার্জেন্সি অপারেশন সেন্টার ও কন্ট্রোলরুমের পাঠানো ডেঙ্গুবিষয়ক সংবাদ বিজ্ঞপ্তিতে এ তথ্য জানানো হয়। স্বাস্থ্য অধি</description>
      <source url="https://www.sangbadkonika.com/national/%e0%a7%a8%e0%a7%aa-%e0%a6%98%e0%a6%a3%e0%a7%8d%e0%a6%9f%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%a1%e0%a7%87%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%81%e0%a6%a4%e0%a7%87-%e0%a7%ae-%e0%a6%9c%e0%a6%a8%e0%a7%87/">সংবাদ কণিকা</source>
    </item>
    <item>
      <title>১৬ ডিসেম্বর আংশিকভাবে চালু হচ্ছে বিমানবন্দরের তৃতীয় টার্মিনাল</title>
      <link>https://www.sangbadkonika.com/national/%e0%a7%a7%e0%a7%ac-%e0%a6%a1%e0%a6%bf%e0%a6%b8%e0%a7%87%e0%a6%ae%e0%a7%8d%e0%a6%ac%e0%a6%b0-%e0%a6%86%e0%a6%82%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a6%ad%e0%a6%be%e0%a6%ac%e0%a7%87-%e0%a6%9a%e0%a6%be/</link>

    <item>
      <title>ফরিদপুরে ৫ প্লাটুন বিজিবি মোতায়েন</title>
      <link>https://www.sangbadkonika.com/national/%e0%a6%ab%e0%a6%b0%e0%a6%bf%e0%a6%a6%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87-%e0%a7%ab-%e0%a6%aa%e0%a7%8d%e0%a6%b2%e0%a6%be%e0%a6%9f%e0%a7%81%e0%a6%a8-%e0%a6%ac%e0%a6%bf%e0%a6%9c%e0%a6%bf%e0%a6%ac/</link>
      <guid isPermaLink="true">https://www.sangbadkonika.com/national/%e0%a6%ab%e0%a6%b0%e0%a6%bf%e0%a6%a6%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87-%e0%a7%ab-%e0%a6%aa%e0%a7%8d%e0%a6%b2%e0%a6%be%e0%a6%9f%e0%a7%81%e0%a6%a8-%e0%a6%ac%e0%a6%bf%e0%a6%9c%e0%a6%bf%e0%a6%ac/</guid>
      <pubDate>Fri, 20 Nov 2026 10:01:12 +0000</pubDate>
      <description>ফরিদপুরের আইনশৃঙ্খলা পরিস্থিতি স্বাভাবিক রাখতে পাঁচ প্লাটুন বর্ডার গার্ড বাংলাদেশ (বিজিবি) মোতায়েন করা হয়েছে। বৃহস্পতিবার (১৯ নভেম্বর) বিকেলে বিজিবি সদস্যরা জেলায় পৌঁছান। মোতায়েন করা বিজিবির মধ্যে ভাঙ্গা উপজেলায় তিন প্লাটুন এবং ফরিদপুর সদরে দুই প্লাটুন দায়িত্ব পালন করবে। ভাঙ্গা উপজেলা নির্বাহী কর্মক</description>
      <source url="https://www.sangbadkonika.com/national/%e0%a6%ab%e0%a6%b0%e0%a6%bf%e0%a6%a6%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87-%e0%a7%ab-%e0%a6%aa%e0%a7%8d%e0%a6%b2%e0%a6%be%e0%a6%9f%e0%a7%81%e0%a6%a8-%e0%a6%ac%e0%a6%bf%e0%a6%9c%e0%a6%bf%e0%a6%ac/">সংবাদ কণিকা</source>
    </item>
    <item>
      <title>প্রধানমন্ত্রী তারেক রহমানের ৬২তম জন্মদিন আজ</title>
      <link>https://www.sangbadkonika.com/national/%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a7%e0%a6%be%e0%a6%a8%e0%a6%ae%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a7%80-%e0%a6%a4%e0%a6%be%e0%a6%b0%e0%a7%87%e0%a6%95-%e0%a6%b0%e0%a6%b9%e0%a6%ae-2/</link>

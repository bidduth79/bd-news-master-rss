    <item>
      <title>জননিরাপত্তা নিশ্চিত করতে বিভিন্ন জেলায় ১০১ প্লাটুন বিজিবি মোতায়েন</title>
      <link>https://www.sangbadkonika.com/national/%e0%a6%9c%e0%a6%a8%e0%a6%a8%e0%a6%bf%e0%a6%b0%e0%a6%be%e0%a6%aa%e0%a6%a4%e0%a7%8d%e0%a6%a4%e0%a6%be-%e0%a6%a8%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%9a%e0%a6%bf%e0%a6%a4-%e0%a6%95%e0%a6%b0%e0%a6%a4%e0%a7%87/</link>
      <guid isPermaLink="true">https://www.sangbadkonika.com/national/%e0%a6%9c%e0%a6%a8%e0%a6%a8%e0%a6%bf%e0%a6%b0%e0%a6%be%e0%a6%aa%e0%a6%a4%e0%a7%8d%e0%a6%a4%e0%a6%be-%e0%a6%a8%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%9a%e0%a6%bf%e0%a6%a4-%e0%a6%95%e0%a6%b0%e0%a6%a4%e0%a7%87/</guid>
      <pubDate>Tue, 24 Nov 2026 04:54:00 +0000</pubDate>
      <description>আইনশৃঙ্খলা পরিস্থিতি নিয়ন্ত্রণ ও জননিরাপত্তা নিশ্চিত করতে রাজধানী ঢাকা ও আশপাশের জেলাসহ দেশের বিভিন্ন স্থানে ১০১ প্লাটুন বর্ডার গার্ড বাংলাদেশ (বিজিবি) মোতায়েন করা হয়েছে। এর মধ্যে গোপালগঞ্জে মোতায়েন করা হয়েছে ২ ব্যাটালিয়ন বিজিবি। আজ মঙ্গলবার (২৪ নভেম্বর) বিজিবির এক সংবাদ বিজ্ঞপ্তিতে এ তথ্য জানানো হয়</description>
      <source url="https://www.sangbadkonika.com/national/%e0%a6%9c%e0%a6%a8%e0%a6%a8%e0%a6%bf%e0%a6%b0%e0%a6%be%e0%a6%aa%e0%a6%a4%e0%a7%8d%e0%a6%a4%e0%a6%be-%e0%a6%a8%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%9a%e0%a6%bf%e0%a6%a4-%e0%a6%95%e0%a6%b0%e0%a6%a4%e0%a7%87/">সংবাদ কণিকা</source>
    </item>
    <item>
      <title>নোয়াখালীতে কিশোর গ্যাংবিরোধী অভিযানে আটক ২৭</title>
      <link>https://www.sangbadkonika.com/local-news/chittagong/%e0%a6%a8%e0%a7%8b%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%96%e0%a6%be%e0%a6%b2%e0%a7%80%e0%a6%a4%e0%a7%87-%e0%a6%95%e0%a6%bf%e0%a6%b6%e0%a7%8b%e0%a6%b0-%e0%a6%97%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%ac/</link>

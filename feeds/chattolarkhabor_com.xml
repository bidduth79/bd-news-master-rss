      <guid isPermaLink="true">https://chattolarkhabor.com/347521/3f7335eb/</guid>
      <pubDate>Mon, 16 Nov 2026 12:09:56 +0000</pubDate>
      <enclosure url="https://chattolarkhabor.com/wp-content/uploads/2026/11/untitled-1794827861.jpg" length="0" type="image/jpeg" />
      <media:content url="https://chattolarkhabor.com/wp-content/uploads/2026/11/untitled-1794827861.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://chattolarkhabor.com/wp-content/uploads/2026/11/untitled-1794827861.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নদীভাঙন ও বন্যা মোকাবিলায় বরাদ্দ ১ হাজার ৪০০ কোটি টাকা: অর্থমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;চলতি ২০২৬-২৭ অর্থবছরে বাঁধ মেরামত ও দুর্যোগকালীন কার্যক্রমের জন্য এক হাজার ৪০০ কোটি টাকা বরাদ্দ রাখা হয়েছে বলে জানিয়েছেন অর্থমন্ত্রী আমির খসরু মাহমুদ চৌধুরী। তিনি জানান, এ বরাদ্দ থেকে দেশের নদীভাঙন ও বন্যা মোকাবিলায় দ্রুত প্রয়োজনীয় ব্যবস্থা করার সুযোগ রয়েছে। সোমবার (১৬ নভেম্বর) জাতীয় সংসদের চতুর্থ অ&lt;/p&gt;</description>
      <source url="https://chattolarkhabor.com/347521/3f7335eb/">চট্টলার খবর</source>
    </item>

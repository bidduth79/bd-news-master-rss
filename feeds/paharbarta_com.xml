      <enclosure url="https://paharbarta.com/wp-content/uploads/Pic-Bandarban-Sena-2.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/Pic-Bandarban-Sena-2.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/Pic-Bandarban-Sena-2.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বান্দরবান যুব উন্নয়ন ক্যাম্পেইন এর যানবাহন রক্ষণাবেক্ষণ প্রশিক্ষনের সমাপনী" /&gt;&lt;/p&gt;&lt;p&gt;বান্দরবানে সেনাবাহিনীর উদ্যোগে বান্দরবান যুব উন্নয়ন ক্যাম্পেইন এর ৩ সপ্তাহব্যাপী যানবাহন রক্ষণাবেক্ষণ প্রশিক্ষনের সমাপনী অনুষ্ঠিত হয়েছে। আজ বৃহস্পতিবার (১৯ নভেম্বর) সকালে ১৪৩ ফিল্ড ওয়ার্কশপ কোম্পানী পরিচালনায় ৬৯ পদাতিক ব্রিগেড বান্দরবান রিজিয়নের ব্যবস্থাপনায় সেনা রিজিয়ন মাঠে এই ৩ সপ্তাহব্যাপী যানবাহ&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8-%e0%a6%af%e0%a7%81%e0%a6%ac-%e0%a6%89%e0%a6%a8%e0%a7%8d%e0%a6%a8%e0%a6%af%e0%a6%bc%e0%a6%a8-%e0%a6%95%e0%a7%8d/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>শৈলপ্রপাত ঝর্ণা থেকে নিখোঁজ শিক্ষার্থীর মরদেহ উদ্ধার</title>
      <link>https://paharbarta.com/%e0%a6%b6%e0%a7%88%e0%a6%b2%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%aa%e0%a6%be%e0%a6%a4-%e0%a6%9d%e0%a6%b0%e0%a7%8d%e0%a6%a3%e0%a6%be-%e0%a6%a5%e0%a7%87%e0%a6%95%e0%a7%87-%e0%a6%a8%e0%a6%bf%e0%a6%96/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%b6%e0%a7%88%e0%a6%b2%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%aa%e0%a6%be%e0%a6%a4-%e0%a6%9d%e0%a6%b0%e0%a7%8d%e0%a6%a3%e0%a6%be-%e0%a6%a5%e0%a7%87%e0%a6%95%e0%a7%87-%e0%a6%a8%e0%a6%bf%e0%a6%96/</guid>
      <pubDate>Thu, 19 Nov 2026 11:42:28 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/1000369-copy.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/1000369-copy.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/1000369-copy.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শৈলপ্রপাত ঝর্ণা থেকে নিখোঁজ শিক্ষার্থীর মরদেহ উদ্ধার" /&gt;&lt;/p&gt;&lt;p&gt;বান্দরবানের শৈলপ্রপাত ঝর্ণায় বন্ধুদের সঙ্গে ঘুরতে গিয়ে গোসল করতে নেমে নিখোঁজ হওয়া মিসকাত (১৫) নামের এক শিক্ষার্থীর মরদেহ উদ্ধার করা হয়েছে। আজ বৃহস্পতিবার (১৯ নভেম্বর) সকালে জেলা সদরের শৈলপ্রপাত পর্যটনকেন্দ্রের পাশের একটি ঝর্ণা থেকে তার মরদেহ উদ্ধার করা হয়। মিসকাত বান্দরবান ক্যান্টনমেন্ট পাবলিক স্কুল&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%b6%e0%a7%88%e0%a6%b2%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%aa%e0%a6%be%e0%a6%a4-%e0%a6%9d%e0%a6%b0%e0%a7%8d%e0%a6%a3%e0%a6%be-%e0%a6%a5%e0%a7%87%e0%a6%95%e0%a7%87-%e0%a6%a8%e0%a6%bf%e0%a6%96/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>বান্দরবানে বিএনপির বিক্ষোভ</title>
      <link>https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%8f%e0%a6%a8%e0%a6%aa%e0%a6%bf%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%95%e0%a7%8d-7/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%8f%e0%a6%a8%e0%a6%aa%e0%a6%bf%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%95%e0%a7%8d-7/</guid>
      <pubDate>Thu, 19 Nov 2026 11:39:52 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/1000202369.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/1000202369.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/1000202369.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বান্দরবানে বিএনপির বিক্ষোভ" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জসহ দেশের বিভিন্ন স্থানে কার্যক্রম নিষিদ্ধ আওয়ামী লীগের নৈরাজ্যের প্রতিবাদে বান্দরবানে বিক্ষোভ মিছিল ও প্রতিবাদ সমাবেশ করেছে বিএনপি। আজ বৃহস্পতিবার (১৯ নভেম্বর) সকালে বান্দরবান জেলা বিএনপির দলীয় কার্যালয় থেকে বিক্ষোভ মিছিলটি শুরু হয়ে শহরের প্রধান সড়ক প্রদক্ষিণ করে মুক্তমঞ্চে গিয়ে জমায়েত হয়। &lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%8f%e0%a6%a8%e0%a6%aa%e0%a6%bf%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%95%e0%a7%8d-7/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>মাটিরাঙ্গা স্পোর্টস একাডেমির বর্ণাঢ্য উদ্বোধন</title>
      <link>https://paharbarta.com/%e0%a6%ae%e0%a6%be%e0%a6%9f%e0%a6%bf%e0%a6%b0%e0%a6%be%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a6%be-%e0%a6%b8%e0%a7%8d%e0%a6%aa%e0%a7%8b%e0%a6%b0%e0%a7%8d%e0%a6%9f%e0%a6%b8-%e0%a6%8f%e0%a6%95%e0%a6%be%e0%a6%a1/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%ae%e0%a6%be%e0%a6%9f%e0%a6%bf%e0%a6%b0%e0%a6%be%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a6%be-%e0%a6%b8%e0%a7%8d%e0%a6%aa%e0%a7%8b%e0%a6%b0%e0%a7%8d%e0%a6%9f%e0%a6%b8-%e0%a6%8f%e0%a6%95%e0%a6%be%e0%a6%a1/</guid>
      <pubDate>Wed, 18 Nov 2026 12:10:29 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/Messenger_creation_3F88AC6D-A1FB-47A2-A06A-2ACD215C71AB.jpeg.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/Messenger_creation_3F88AC6D-A1FB-47A2-A06A-2ACD215C71AB.jpeg.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/Messenger_creation_3F88AC6D-A1FB-47A2-A06A-2ACD215C71AB.jpeg.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মাটিরাঙ্গা স্পোর্টস একাডেমির বর্ণাঢ্য উদ্বোধন" /&gt;&lt;/p&gt;&lt;p&gt;তৃণমূল থেকে জাতীয় পর্যায় পর্যন্ত খেলাধুলার একটি সমন্বিত কাঠামো গড়ে তোলার লক্ষ্যে বর্ণাঢ্য আয়োজনের মধ্য দিয়ে &amp;#8216;মাটিরাঙ্গা স্পোর্টস একাডেমি&amp;#8217;র উদ্বোধন করা হয়েছে। আজ বুধবার (১৮ নভেম্বর) বিকেল ৪টার দিকে মাটিরাঙ্গা মিনি স্টেডিয়ামে একাডেমির উদ্বোধন করেন খাগড়াছড়ি পার্বত্য জেলা পরিষদের সদ&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%ae%e0%a6%be%e0%a6%9f%e0%a6%bf%e0%a6%b0%e0%a6%be%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a6%be-%e0%a6%b8%e0%a7%8d%e0%a6%aa%e0%a7%8b%e0%a6%b0%e0%a7%8d%e0%a6%9f%e0%a6%b8-%e0%a6%8f%e0%a6%95%e0%a6%be%e0%a6%a1/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>বান্দরবানে ক্রীড়া অফিস পরিদর্শন করলেন পার্বত্য জেলা পরিষদের ক্রীড়া কনভেনর</title>
      <link>https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%95%e0%a7%8d%e0%a6%b0%e0%a7%80%e0%a6%a1%e0%a6%bc%e0%a6%be-%e0%a6%85%e0%a6%ab%e0%a6%bf%e0%a6%b8/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%95%e0%a7%8d%e0%a6%b0%e0%a7%80%e0%a6%a1%e0%a6%bc%e0%a6%be-%e0%a6%85%e0%a6%ab%e0%a6%bf%e0%a6%b8/</guid>
      <pubDate>Wed, 18 Nov 2026 12:05:15 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/Bandarban-Sports-News-Pic-18-Nov-2026.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/Bandarban-Sports-News-Pic-18-Nov-2026.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/Bandarban-Sports-News-Pic-18-Nov-2026.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বান্দরবানে ক্রীড়া অফিস পরিদর্শন করলেন পার্বত্য জেলা পরিষদের ক্রীড়া কনভেনর" /&gt;&lt;/p&gt;&lt;p&gt;বান্দরবানে জেলা ক্রীড়া অফিস পরিদর্শন করেছেন জেলা পরিষদ সদস্য ও ক্রীড়া বিষয়ক কনভেনিং কমিটির কনভেনর কাজী নিরুতাজ বেগম। আজ বুধবার (১৮ নভেম্বর) সকালে বান্দরবান জেলা ক্রীড়া অফিস পরিদর্শন শেষে বিশেষ চাহিদাসম্পন্ন শিশুদের নিয়ে অনুষ্ঠিত আনন্দ উৎসব অনুষ্ঠানে পুরষ্কার বিতরন করেন তিনি। বান্দরবান জেলা ক্রীড়া অফ&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%95%e0%a7%8d%e0%a6%b0%e0%a7%80%e0%a6%a1%e0%a6%bc%e0%a6%be-%e0%a6%85%e0%a6%ab%e0%a6%bf%e0%a6%b8/">পাহাড়বার্তা</source>

      <enclosure url="https://paharbarta.com/wp-content/uploads/FB_IMG_1794284140191-scaled-e1794313288651.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/FB_IMG_1794284140191-scaled-e1794313288651.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/FB_IMG_1794284140191-scaled-e1794313288651.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রোয়াংছড়িতে আগুনে পুড়েছে ১৬ বসতঘর" /&gt;&lt;/p&gt;&lt;p&gt;বান্দরবানের রোয়াংছড়ি উপজেলার তারাছা ইউনিয়নের বড়ইতলী মার্মা পাড়ায় অগ্নিকাণ্ডে ১৬টি বসতঘর ও দুটি দোকান পুড়ে ছাই হয়ে গেছে। স্থানীয় সূত্রে জানা গেছে, সোমবার (৯ নভেম্বর) দিবাগত রাত ১১টার দিকে ইউনিয়নের ৪ নম্বর ওয়ার্ডের এ পাড়ায় আগুন লাগে। স্থানীয় বাসিন্দাদের প্রায় দুই ঘণ্টার চেষ্টায় আগুন নিয়ন্ত্রণে আসে। স্&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%b0%e0%a7%8b%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%82%e0%a6%9b%e0%a6%a1%e0%a6%bc%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%86%e0%a6%97%e0%a7%81%e0%a6%a8%e0%a7%87-%e0%a6%aa%e0%a7%81%e0%a6%a1%e0%a6%bc-2/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>থানচিতে প্রত্যাবর্তিত বম পরিবারের চিকিৎসা সেবায় সেনাবাহিনী</title>
      <link>https://paharbarta.com/%e0%a6%a5%e0%a6%be%e0%a6%a8%e0%a6%9a%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%ac%e0%a6%b0%e0%a7%8d%e0%a6%a4%e0%a6%bf%e0%a6%a4-%e0%a6%ac%e0%a6%ae/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%a5%e0%a6%be%e0%a6%a8%e0%a6%9a%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%ac%e0%a6%b0%e0%a7%8d%e0%a6%a4%e0%a6%bf%e0%a6%a4-%e0%a6%ac%e0%a6%ae/</guid>
      <pubDate>Mon, 09 Nov 2026 11:59:17 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/1000424831.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/1000424831.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/1000424831.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="থানচিতে প্রত্যাবর্তিত বম পরিবারের চিকিৎসা সেবায় সেনাবাহিনী" /&gt;&lt;/p&gt;&lt;p&gt;আসন্ন বড়দিন উদ্‌যাপনের প্রস্তুতি ও শারীরিক সুরক্ষা নিশ্চিত করতে সম্প্রতিকালে ভারতে মিজোরাম হতে প্রত্যাবর্তীত এবং বান্দরবানের থানচি ও রুমা দুই উপজেলার সীমান্তে বসবাসরত থানচি লিটক্রে সড়কের পাশে ২২ কিলোমিটার দুর্গম থান্দুই পাড়ায় প্রত্যাবর্তিত বম পরিবারসহ স্থানীয়দের বিনামূল্যে চিকিৎসাসেবা ও মানবিক সহায়ত&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%a5%e0%a6%be%e0%a6%a8%e0%a6%9a%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%ac%e0%a6%b0%e0%a7%8d%e0%a6%a4%e0%a6%bf%e0%a6%a4-%e0%a6%ac%e0%a6%ae/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>কাপ্তাইয়ে অজগর উদ্ধার, জাতীয় উদ্যানে অবমুক্ত</title>
      <link>https://paharbarta.com/%e0%a6%95%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%87%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%85%e0%a6%9c%e0%a6%97%e0%a6%b0-%e0%a6%89%e0%a6%a6%e0%a7%8d%e0%a6%a7%e0%a6%be%e0%a6%b0-%e0%a6%9c/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%95%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%87%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%85%e0%a6%9c%e0%a6%97%e0%a6%b0-%e0%a6%89%e0%a6%a6%e0%a7%8d%e0%a6%a7%e0%a6%be%e0%a6%b0-%e0%a6%9c/</guid>
      <pubDate>Mon, 09 Nov 2026 11:49:29 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/292201.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/292201.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/292201.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কাপ্তাইয়ে অজগর উদ্ধার, জাতীয় উদ্যানে অবমুক্ত" /&gt;&lt;/p&gt;&lt;p&gt;রাঙামাটির কাপ্তাইয়ে লোকালয় থেকে উদ্ধার করা ১২ ফুট লম্বা ও ১৫ কেজি ওজনের একটি বিশাল অজগর সাপ কাপ্তাই জাতীয় উদ্যানে অবমুক্ত করা হয়েছে। আজ সোমবার (৯ নভেম্বর) বেলা সাড়ে ১২টায় কাপ্তাই জাতীয় উদ্যানে উপজেলা নির্বাহী কর্মকর্তা (ইউএনও) রায়হানুল ইসলাম ও পার্বত্য চট্টগ্রাম দক্ষিণ বন বিভাগের কাপ্তাই সহকারী বন স&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%95%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%87%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%85%e0%a6%9c%e0%a6%97%e0%a6%b0-%e0%a6%89%e0%a6%a6%e0%a7%8d%e0%a6%a7%e0%a6%be%e0%a6%b0-%e0%a6%9c/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>কাপ্তাই ওয়াগ্গা টি লিমিটেডের চা শ্রমিক ইউনিয়ন নির্বাচনে মনোনয়ন পত্র জমা</title>
      <link>https://paharbarta.com/%e0%a6%95%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%87-%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%97%e0%a7%8d%e0%a6%97%e0%a6%be-%e0%a6%9f%e0%a6%bf-%e0%a6%b2%e0%a6%bf%e0%a6%ae%e0%a6%bf/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%95%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%87-%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%97%e0%a7%8d%e0%a6%97%e0%a6%be-%e0%a6%9f%e0%a6%bf-%e0%a6%b2%e0%a6%bf%e0%a6%ae%e0%a6%bf/</guid>
      <pubDate>Mon, 09 Nov 2026 11:45:29 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/292143.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/292143.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/292143.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কাপ্তাই ওয়াগ্গা টি লিমিটেডের চা শ্রমিক ইউনিয়ন নির্বাচনে মনোনয়ন পত্র জমা" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ চা-শ্রমিক ইউনিয়ন নির্বাচন-২০২৬ উপলক্ষে রাঙামাটির কাপ্তাই উপজেলার ওয়াগ্গা টি লিমিটেডের চা শ্রমিকদের পঞ্চায়েত কমিটির নির্বাচনে সব পদে একক প্রার্থী মনোনয়নপত্র জমা দিয়েছেন। ফলে প্রতিদ্বন্দ্বিতা ছাড়াই প্রার্থীদের নির্বাচিত হওয়ার সম্ভাবনা তৈরি হয়েছে। আজ সোমবার (৯ নভেম্বর) কাপ্তাই উপজেলা নির্বাহী &lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%95%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%87-%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%97%e0%a7%8d%e0%a6%97%e0%a6%be-%e0%a6%9f%e0%a6%bf-%e0%a6%b2%e0%a6%bf%e0%a6%ae%e0%a6%bf/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>রুমায় বিএনপির বিভক্তি প্রকাশ্যে রূপ নিয়েছে !</title>
      <link>https://paharbarta.com/%e0%a6%b0%e0%a7%81%e0%a6%ae%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%ac%e0%a6%bf%e0%a6%8f%e0%a6%a8%e0%a6%aa%e0%a6%bf%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%ad%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%bf-%e0%a6%aa/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%b0%e0%a7%81%e0%a6%ae%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%ac%e0%a6%bf%e0%a6%8f%e0%a6%a8%e0%a6%aa%e0%a6%bf%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%ad%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%bf-%e0%a6%aa/</guid>
      <pubDate>Mon, 09 Nov 2026 11:39:57 +0000</pubDate>

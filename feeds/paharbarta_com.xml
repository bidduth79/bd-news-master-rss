    <item>
      <title>চিম্বুক পাহাড়ে পরিচ্ছন্নতা অভিযান, ম্রো পাড়ায় পানি সরবরাহের আশ্বাস পার্বত্য মন্ত্রীর</title>
      <link>https://paharbarta.com/%e0%a6%9a%e0%a6%bf%e0%a6%ae%e0%a7%8d%e0%a6%ac%e0%a7%81%e0%a6%95-%e0%a6%aa%e0%a6%be%e0%a6%b9%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a7%87-%e0%a6%aa%e0%a6%b0%e0%a6%bf%e0%a6%9a%e0%a7%8d%e0%a6%9b%e0%a6%a8%e0%a7%8d/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%9a%e0%a6%bf%e0%a6%ae%e0%a7%8d%e0%a6%ac%e0%a7%81%e0%a6%95-%e0%a6%aa%e0%a6%be%e0%a6%b9%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a7%87-%e0%a6%aa%e0%a6%b0%e0%a6%bf%e0%a6%9a%e0%a7%8d%e0%a6%9b%e0%a6%a8%e0%a7%8d/</guid>
      <pubDate>Sat, 07 Nov 2026 12:16:59 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/minister-pic-1-3.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/minister-pic-1-3.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/minister-pic-1-3.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চিম্বুক পাহাড়ে পরিচ্ছন্নতা অভিযান, ম্রো পাড়ায় পানি সরবরাহের আশ্বাস পার্বত্য মন্ত্রীর" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশের সংকটময় মুহূর্তে শহীদ রাষ্ট্রপতি জিয়াউর রহমান ধূমকেতুর মতো ত্রাতার ভূমিকায় আবির্ভূত হয়েছিলেন বলে মন্তব্য করেছেন পার্বত্য চট্টগ্রাম বিষয়ক মন্ত্রণালয়ের মন্ত্রী সাচিংপ্রু জেরী। তিনি বলেন, প্রধানমন্ত্রী ৭ নভেম্বরকে রাষ্ট্রীয়ভাবে জাতীয় বিপ্লব ও সংহতি দিবস হিসেবে ঘোষণা করেছেন এবং সরকারি ছুটি নির&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%9a%e0%a6%bf%e0%a6%ae%e0%a7%8d%e0%a6%ac%e0%a7%81%e0%a6%95-%e0%a6%aa%e0%a6%be%e0%a6%b9%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a7%87-%e0%a6%aa%e0%a6%b0%e0%a6%bf%e0%a6%9a%e0%a7%8d%e0%a6%9b%e0%a6%a8%e0%a7%8d/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>প্রথাগত নেতৃত্বে নতুন প্রজন্মের প্রতিনিধি : ইখিন চৌধুরীর স্বপ্ন, সংগ্রাম ও প্রত্যয়</title>
      <link>https://paharbarta.com/%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a5%e0%a6%be%e0%a6%97%e0%a6%a4-%e0%a6%a8%e0%a7%87%e0%a6%a4%e0%a7%83%e0%a6%a4%e0%a7%8d%e0%a6%ac%e0%a7%87-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%aa%e0%a7%8d/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a5%e0%a6%be%e0%a6%97%e0%a6%a4-%e0%a6%a8%e0%a7%87%e0%a6%a4%e0%a7%83%e0%a6%a4%e0%a7%8d%e0%a6%ac%e0%a7%87-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%aa%e0%a7%8d/</guid>

      <enclosure url="https://paharbarta.com/wp-content/uploads/11-WA0015-copy.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/11-WA0015-copy.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/11-WA0015-copy.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাইখালীতে চেয়ারম্যান পদে প্রার্থী হবে তরুন রাজনীতিবিদ বিশু তঞ্চঙ্গ্যা" /&gt;&lt;/p&gt;&lt;p&gt;রাঙামাটির কাপ্তাই উপজেলার ২নং রাইখালী ইউনিয়ন পরিষদ নির্বাচনে চেয়ারম্যান পদপ্রার্থী হিসেবে বিশ্বজিৎ তঞ্চঙ্গ্যা বিশু প্রার্থী হচ্ছেন। রাইখালী ইউনিয়নের প্রতিটি গ্রামে-পাড়া-মহল্লায়, দোকানে ও মহলে ব্যাপক আলোচনায় আছেন তিনি। জানা যায়, আসন্ন ২নং রাইখালী ইউপি নির্বাচনে বাংলাদেশ জাতীয়তাবাদী দল বিএনপি হতে চেয়া&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%b0%e0%a6%be%e0%a6%87%e0%a6%96%e0%a6%be%e0%a6%b2%e0%a7%80%e0%a6%a4%e0%a7%87-%e0%a6%9a%e0%a7%87%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0%e0%a6%ae%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%a8-%e0%a6%aa%e0%a6%a6/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>বান্দরবানের অষ্টবিংশতি বুদ্ধ বিহার ও রত্নপ্রিয় বির্দশন ভাবনা কেন্দ্রে কঠিন চীবর দানোৎসব</title>
      <link>https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%85%e0%a6%b7%e0%a7%8d%e0%a6%9f%e0%a6%ac%e0%a6%bf%e0%a6%82%e0%a6%b6%e0%a6%a4%e0%a6%bf-2/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%85%e0%a6%b7%e0%a7%8d%e0%a6%9f%e0%a6%ac%e0%a6%bf%e0%a6%82%e0%a6%b6%e0%a6%a4%e0%a6%bf-2/</guid>
      <pubDate>Tue, 10 Nov 2026 12:27:40 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/Pic-Bandarban-Vabanakandara-2.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/Pic-Bandarban-Vabanakandara-2.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/Pic-Bandarban-Vabanakandara-2.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বান্দরবানের অষ্টবিংশতি বুদ্ধ বিহার ও রত্নপ্রিয় বির্দশন ভাবনা কেন্দ্রে কঠিন চীবর দানোৎসব" /&gt;&lt;/p&gt;&lt;p&gt;বান্দরবান সদরের অষ্টবিংশতি বুদ্ধ বিহার ও রত্নপ্রিয় বির্দশন ভাবনা কেন্দ্রে দানোত্তম শুভ কঠিন চীবর দানোৎসব উদযাপিত হয়েছে। আজ মঙ্গলবার (১০ নভেম্বর) সকালে বান্দরবান সদরের নীলাচল টাইগার পাড়া এলাকায় অষ্টবিংশতি বুদ্ধ বিহার ও রত্নপ্রিয় বির্দশন ভাবনা কেন্দ্রের সকল দায়ক-দায়িকাবৃন্দ ও কঠিন চীবর দানোৎসব উদ্যাপন&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%85%e0%a6%b7%e0%a7%8d%e0%a6%9f%e0%a6%ac%e0%a6%bf%e0%a6%82%e0%a6%b6%e0%a6%a4%e0%a6%bf-2/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>গুইমারায় বিএনপির ওয়ার্ড কার্যালয়ে আগুন, আটক ৬</title>
      <link>https://paharbarta.com/%e0%a6%97%e0%a7%81%e0%a6%87%e0%a6%ae%e0%a6%be%e0%a6%b0%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%ac%e0%a6%bf%e0%a6%8f%e0%a6%a8%e0%a6%aa%e0%a6%bf%e0%a6%b0-%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0%e0%a7%8d/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%97%e0%a7%81%e0%a6%87%e0%a6%ae%e0%a6%be%e0%a6%b0%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%ac%e0%a6%bf%e0%a6%8f%e0%a6%a8%e0%a6%aa%e0%a6%bf%e0%a6%b0-%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0%e0%a7%8d/</guid>
      <pubDate>Tue, 10 Nov 2026 12:19:30 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/IMG-20261110-WA0002.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/IMG-20261110-WA0002.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/IMG-20261110-WA0002.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গুইমারায় বিএনপির ওয়ার্ড কার্যালয়ে আগুন, আটক ৬" /&gt;&lt;/p&gt;&lt;p&gt;খাগড়াছড়ির গুইমারা উপজেলার হাফছড়ি ইউনিয়নের ৬ নম্বর বড়পিলাক ওয়ার্ড বিএনপির দলীয় কার্যালয় আগুনে পুড়ে ছাই হয়ে গেছে। গত সোমবার (৯ নভেম্বর) দিবাগত রাত সাড়ে ৩টার দিকে এ অগ্নিকাণ্ডের ঘটনা ঘটে। এ ঘটনায় জড়িত সন্দেহে আওয়ামী লীগ ও ছাত্রলীগের ছয়জনকে আটক করেছে পুলিশ। স্থানীয় সূত্রে জানা যায়, রাত সাড়ে ৩টার দিকে ওয়&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%97%e0%a7%81%e0%a6%87%e0%a6%ae%e0%a6%be%e0%a6%b0%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%ac%e0%a6%bf%e0%a6%8f%e0%a6%a8%e0%a6%aa%e0%a6%bf%e0%a6%b0-%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0%e0%a7%8d/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>খাগড়াছড়িতে হাসপাতালের সামনে জিপে আগুন, ক্ষতি ৫ লাখ টাকা</title>
      <link>https://paharbarta.com/%e0%a6%96%e0%a6%be%e0%a6%97%e0%a6%a1%e0%a6%bc%e0%a6%be%e0%a6%9b%e0%a6%a1%e0%a6%bc%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%aa%e0%a6%be%e0%a6%a4%e0%a6%be%e0%a6%b2%e0%a7%87%e0%a6%b0/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%96%e0%a6%be%e0%a6%97%e0%a6%a1%e0%a6%bc%e0%a6%be%e0%a6%9b%e0%a6%a1%e0%a6%bc%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%aa%e0%a6%be%e0%a6%a4%e0%a6%be%e0%a6%b2%e0%a7%87%e0%a6%b0/</guid>
      <pubDate>Tue, 10 Nov 2026 12:07:44 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/00138501.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/00138501.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/00138501.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="খাগড়াছড়িতে হাসপাতালের সামনে জিপে আগুন, ক্ষতি ৫ লাখ টাকা" /&gt;&lt;/p&gt;&lt;p&gt;খাগড়াছড়ি পৌর শহরের পানখাইয়া পাড়া রোডে কে এইচ টি সি হাসপাতালের সামনে দাঁড়িয়ে থাকা একটি জিপ গাড়িতে আগুন দিয়েছে দুর্বৃত্তরা। এতে গাড়িটি পুড়ে ব্যাপক ক্ষয়ক্ষতি হয়েছে। তবে কারা এবং কী কারণে গাড়িটিতে আগুন দিয়েছে, তা এখনো শনাক্ত করা যায়নি। আজ মঙ্গলবার (১০ নভেম্বর) রাতে হাসপাতালের সামনে এ ঘটনা ঘটে। স্থানীয় স&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%96%e0%a6%be%e0%a6%97%e0%a6%a1%e0%a6%bc%e0%a6%be%e0%a6%9b%e0%a6%a1%e0%a6%bc%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%aa%e0%a6%be%e0%a6%a4%e0%a6%be%e0%a6%b2%e0%a7%87%e0%a6%b0/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>মানবেন্দ্র নারায়ণ লারমা ছিলো পাহাড়ে জুম্মজাতির অগ্রদূত</title>
      <link>https://paharbarta.com/%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a6%ac%e0%a7%87%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a7%8d%e0%a6%b0-%e0%a6%a8%e0%a6%be%e0%a6%b0%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a6%a3-%e0%a6%b2%e0%a6%be%e0%a6%b0%e0%a6%ae%e0%a6%be/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a6%ac%e0%a7%87%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a7%8d%e0%a6%b0-%e0%a6%a8%e0%a6%be%e0%a6%b0%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a6%a3-%e0%a6%b2%e0%a6%be%e0%a6%b0%e0%a6%ae%e0%a6%be/</guid>
      <pubDate>Tue, 10 Nov 2026 12:05:23 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/1000138501.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/1000138501.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/1000138501.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মানবেন্দ্র নারায়ণ লারমা ছিলো পাহাড়ে জুম্মজাতির অগ্রদূত" /&gt;&lt;/p&gt;&lt;p&gt;সাবেক সংসদ সদস্য মানবেন্দ্র নারায়ণ লারমা (এমএন লারমা)-র ৪৩তম মৃত্যুবার্ষিকীতে র‍্যালী ও স্মরণ সভা করেছে করেছে পার্বত্য চট্টগ্রাম জনসংহতি সমিতি (জেএসএস এমএন লারমা)। আজ মঙ্গলবার (১০ নভেম্বর ২০২৬) সকালে চেঙ্গি স্কয়ারে প্রভাতফেরী শেষে ফুলেল শ্রদ্ধা জানায় সংগঠনটি। এ সময় সহযোগি সংগঠনগুলো একে একে এই নেতার &lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a6%ac%e0%a7%87%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a7%8d%e0%a6%b0-%e0%a6%a8%e0%a6%be%e0%a6%b0%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a6%a3-%e0%a6%b2%e0%a6%be%e0%a6%b0%e0%a6%ae%e0%a6%be/">পাহাড়বার্তা</source>
    </item>

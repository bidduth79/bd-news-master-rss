      <enclosure url="https://paharbarta.com/wp-content/uploads/FB_IMG_1795240882732.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/FB_IMG_1795240882732.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/FB_IMG_1795240882732.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="খাগড়াছড়িতে ৮২ মি.মি. মর্টারশেল নিষ্ক্রিয় করল সেনাবাহিনী" /&gt;&lt;/p&gt;&lt;p&gt;খাগড়াছড়ির শালবন এলাকায় মাটির নিচ থেকে উদ্ধার করা একটি পরিত্যক্ত মর্টারশেল বিস্ফোরণের মাধ্যমে নিষ্ক্রিয় করেছে বাংলাদেশ সেনাবাহিনীর বোমা ডিসপোজাল ইউনিট। ​ আজ শনিবার (২১ নভেম্বর) খাগড়াছড়ি সদর জোনের ১৮ বেঙ্গল বোমা ডিসপোজাল ইউনিটের সদস্যরা মর্টারশেলটি খবংপুড়িয়া এলাকার চেঙ্গী নদীর তীরে একটি নিরাপদ স্থানে &lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%96%e0%a6%be%e0%a6%97%e0%a6%a1%e0%a6%bc%e0%a6%be%e0%a6%9b%e0%a6%a1%e0%a6%bc%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a7%ae%e0%a7%a8-%e0%a6%ae%e0%a6%bf-%e0%a6%ae%e0%a6%bf-%e0%a6%ae%e0%a6%b0%e0%a7%8d/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>বান্দরবানে শ্রমিকদের কল্যাণে নতুন ট্যুরিস্ট জীপ চালু</title>
      <link>https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a6%ae%e0%a6%bf%e0%a6%95%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a6%b2%e0%a7%8d/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a6%ae%e0%a6%bf%e0%a6%95%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a6%b2%e0%a7%8d/</guid>
      <pubDate>Fri, 20 Nov 2026 12:05:22 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/Banadarban-Tourist-Coach-Pic20-Nov-2026-1.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/Banadarban-Tourist-Coach-Pic20-Nov-2026-1.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/Banadarban-Tourist-Coach-Pic20-Nov-2026-1.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বান্দরবানে শ্রমিকদের কল্যাণে নতুন ট্যুরিস্ট জীপ চালু" /&gt;&lt;/p&gt;&lt;p&gt;বান্দরবানে বান্দরবান মাইক্রোবাস শ্রমিক ইউনিয়নের শ্রমিকদের কল্যাণে এবার একটি ট্যুরিস্ট জীপ চালু করা হয়েছে। এই ট্যুারিস্ট জীপ থেকে অর্জিত অর্থ মাইক্রোবাস শ্রমিক ইউনিয়নের সদস্যদের বিভিন্ন চিকিৎসা,যাবতীয় দুর্ঘটনা এবং মৃত্যু পরবর্তী তাদের পরিবারের সহায়তার জন্য ব্যয় করা হবে। আজ শুক্রবার (২০ নভেম্বর) বিকেল&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a6%ae%e0%a6%bf%e0%a6%95%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a6%b2%e0%a7%8d/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>বান্দরবানে প্রতিবাদ সমাবেশ করলো জাসাস</title>
      <link>https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4%e0%a6%bf%e0%a6%ac%e0%a6%be%e0%a6%a6-%e0%a6%b8%e0%a6%ae%e0%a6%be%e0%a6%ac/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4%e0%a6%bf%e0%a6%ac%e0%a6%be%e0%a6%a6-%e0%a6%b8%e0%a6%ae%e0%a6%be%e0%a6%ac/</guid>
      <pubDate>Fri, 20 Nov 2026 11:59:58 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/Bandarban-BNp-News-Pic-20-Nov-2026-2.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/Bandarban-BNp-News-Pic-20-Nov-2026-2.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/Bandarban-BNp-News-Pic-20-Nov-2026-2.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বান্দরবানে প্রতিবাদ সমাবেশ করলো জাসাস" /&gt;&lt;/p&gt;&lt;p&gt;ফ্যাসিবাদী আওয়ামী সন্ত্রাসীদের বর্বরোচিত হামলার মাধ্যমে নড়াইল জেলার কালিয়া উপজেলা পৌর জাসাস এর সাধারণ সম্পাদক সোহেল মোল্লাকে হত্যার প্রতিবাদে এবং দোষীদের দৃষ্টান্তমূলক শাস্তির দাবিতে বান্দরবানে প্রতিবাদ সমাবেশ অনুষ্ঠিত হয়েছে। আজ শুক্রবার (২০ নভেম্বর) বিকেলে জাতীয়তাবাদী সামাজিক সাংস্কৃতিক সংস্থা জাসা&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4%e0%a6%bf%e0%a6%ac%e0%a6%be%e0%a6%a6-%e0%a6%b8%e0%a6%ae%e0%a6%be%e0%a6%ac/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>রামগড়ে দেশীয় পিস্তল ও গুলিসহ বৃদ্ধ আটক</title>
      <link>https://paharbarta.com/%e0%a6%b0%e0%a6%be%e0%a6%ae%e0%a6%97%e0%a6%a1%e0%a6%bc%e0%a7%87-%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%80%e0%a6%af%e0%a6%bc-%e0%a6%aa%e0%a6%bf%e0%a6%b8%e0%a7%8d%e0%a6%a4%e0%a6%b2-%e0%a6%93-%e0%a6%97/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%b0%e0%a6%be%e0%a6%ae%e0%a6%97%e0%a6%a1%e0%a6%bc%e0%a7%87-%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%80%e0%a6%af%e0%a6%bc-%e0%a6%aa%e0%a6%bf%e0%a6%b8%e0%a7%8d%e0%a6%a4%e0%a6%b2-%e0%a6%93-%e0%a6%97/</guid>
      <pubDate>Fri, 20 Nov 2026 11:56:50 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/IMG-20261120-WA0000.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/IMG-20261120-WA0000.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/IMG-20261120-WA0000.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রামগড়ে দেশীয় পিস্তল ও গুলিসহ বৃদ্ধ আটক" /&gt;&lt;/p&gt;&lt;p&gt;খাগড়াছড়ির রামগড়ে বিশেষ সেনা অভিযানে দেশীয় তৈরি পিস্তল ও তাজা গুলিসহ সাগর দেবনাথ (৬১) নামে এক ব্যক্তিকে আটক করা হয়েছে। গত বৃহস্পতিবার (১৯ নভেম্বর ২০২৬) রাত ৯টার দিকে উপজেলার শ্মশানটিলা এলাকার নিজবাড়ি থেকে তাঁকে আটক করে সিন্ধুকছড়ি জোন (২০ ফিল্ড রেজিমেন্ট আর্টিলারি) সেনাবাহিনীর একটি অভিযানিক দল। ​অভিযা&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%b0%e0%a6%be%e0%a6%ae%e0%a6%97%e0%a6%a1%e0%a6%bc%e0%a7%87-%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%80%e0%a6%af%e0%a6%bc-%e0%a6%aa%e0%a6%bf%e0%a6%b8%e0%a7%8d%e0%a6%a4%e0%a6%b2-%e0%a6%93-%e0%a6%97/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>আওয়ামী লীগ এর কর্মকাণ্ডের প্রতিবাদে বান্দরবানে বিএনপির বিক্ষোভ</title>
      <link>https://paharbarta.com/%e0%a6%86%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%ae%e0%a7%80-%e0%a6%b2%e0%a7%80%e0%a6%97-%e0%a6%8f%e0%a6%b0-%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a6%95%e0%a6%be%e0%a6%a3%e0%a7%8d%e0%a6%a1/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%86%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%ae%e0%a7%80-%e0%a6%b2%e0%a7%80%e0%a6%97-%e0%a6%8f%e0%a6%b0-%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a6%95%e0%a6%be%e0%a6%a3%e0%a7%8d%e0%a6%a1/</guid>
      <pubDate>Fri, 20 Nov 2026 11:49:33 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/1000723420.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/1000723420.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/1000723420.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আওয়ামী লীগ এর কর্মকাণ্ডের প্রতিবাদে বান্দরবানে বিএনপির বিক্ষোভ" /&gt;&lt;/p&gt;&lt;p&gt;কার্যক্রম নিষিদ্ধ আওয়ামী লীগের সন্ত্রাসী কর্মকাণ্ডের প্রতিবাদে বান্দরবানে বিক্ষোভ মিছিল ও আলোচনা সভা করেছে জেলা বিএনপি। আজ বৃহস্পতিবার (১৯ নভেম্বর ২০২৬) দুপুরে এ কর্মসূচি পালিত হয়। বান্দরবান জর্জ কোর্ট প্রাঙ্গণ থেকে বিক্ষোভ মিছিলটি শুরু হয়। মিছিলটি শহরের প্রধান প্রধান সড়ক প্রদক্ষিণ করে মুক্তমঞ্চের স&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%86%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%ae%e0%a7%80-%e0%a6%b2%e0%a7%80%e0%a6%97-%e0%a6%8f%e0%a6%b0-%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a6%95%e0%a6%be%e0%a6%a3%e0%a7%8d%e0%a6%a1/">পাহাড়বার্তা</source>

      <enclosure url="https://paharbarta.com/wp-content/uploads/309382.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/309382.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/309382.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কাপ্তাইয়ে বিকাশে অর্থ প্রতারণার অভিযোগে আটক যুবক, মিলল গাঁজা" /&gt;&lt;/p&gt;&lt;p&gt;রাঙামাটির কাপ্তাইয়ে বিকাশের মাধ্যমে ৩৫ হাজার টাকা প্রতারণার অভিযোগে সুমন নামে এক যুবককে আটক করেছে বর্ডার গার্ড বাংলাদেশ (৪১ বিজিবি)। পরে তাকে কাপ্তাই থানা পুলিশের কাছে হস্তান্তর করা হয়। পুলিশি তল্লাশিতে তার কাছ থেকে ১০ গ্রাম গাঁজা উদ্ধার করা হয়েছে। এ ঘটনায় তার বিরুদ্ধে মাদকদ্রব্য নিয়ন্ত্রণ আইনে মামল&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%95%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%87%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%95%e0%a6%be%e0%a6%b6%e0%a7%87-%e0%a6%85%e0%a6%b0%e0%a7%8d%e0%a6%a5-%e0%a6%aa/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>দেশব্যাপী নৈরাজ্যের প্রতিবাদে থানচিতে বিএনপির বিক্ষোভ সমাবেশ</title>
      <link>https://paharbarta.com/%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%aa%e0%a7%80-%e0%a6%a8%e0%a7%88%e0%a6%b0%e0%a6%be%e0%a6%9c%e0%a7%8d%e0%a6%af%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%aa%e0%a7%80-%e0%a6%a8%e0%a7%88%e0%a6%b0%e0%a6%be%e0%a6%9c%e0%a7%8d%e0%a6%af%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4/</guid>
      <pubDate>Sat, 21 Nov 2026 12:33:19 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/1000447027.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/1000447027.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/1000447027.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দেশব্যাপী নৈরাজ্যের প্রতিবাদে থানচিতে বিএনপির বিক্ষোভ সমাবেশ" /&gt;&lt;/p&gt;&lt;p&gt;সহিংসতা ও নৈরাজ্যসহ কার্যক্রম নিষিদ্ধ আওয়ামী লীগের দেশব্যাপী জ্বালাও-পোড়াও, সন্ত্রাস ও সহিংসতার প্রতিবাদে বান্দরবানের থানচি উপজেলা বিক্ষোভ সমাবেশ ও প্রতিবাদ করেছে বাংলাদেশ জাতীয়তাবাদী দল (বিএনপি)। আজ শনিবার (২১ নভেম্বর) সকালে জেলার থানচি উপজেলা শাখা বিএনপির আয়োজনে উপজেলা সদর বাজার প্রাঙ্গণ থেকে বিক্&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%aa%e0%a7%80-%e0%a6%a8%e0%a7%88%e0%a6%b0%e0%a6%be%e0%a6%9c%e0%a7%8d%e0%a6%af%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>রবিউল আউয়াল উপলক্ষে বান্দরবানে প্রতিযোগিতার পুরস্কার বিতরণ</title>
      <link>https://paharbarta.com/%e0%a6%b0%e0%a6%ac%e0%a6%bf%e0%a6%89%e0%a6%b2-%e0%a6%86%e0%a6%89%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b2-%e0%a6%89%e0%a6%aa%e0%a6%b2%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a7%87-%e0%a6%ac%e0%a6%be%e0%a6%a8/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%b0%e0%a6%ac%e0%a6%bf%e0%a6%89%e0%a6%b2-%e0%a6%86%e0%a6%89%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b2-%e0%a6%89%e0%a6%aa%e0%a6%b2%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a7%87-%e0%a6%ac%e0%a6%be%e0%a6%a8/</guid>
      <pubDate>Sat, 21 Nov 2026 12:29:07 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/Bandarban-Islami-Patagar-Prize-Giving-Ceremony-Pic-21-Nov-2026-1.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/Bandarban-Islami-Patagar-Prize-Giving-Ceremony-Pic-21-Nov-2026-1.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/Bandarban-Islami-Patagar-Prize-Giving-Ceremony-Pic-21-Nov-2026-1.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রবিউল আউয়াল উপলক্ষে বান্দরবানে প্রতিযোগিতার পুরস্কার বিতরণ" /&gt;&lt;/p&gt;&lt;p&gt;পবিত্র মাহে রবিউল আউয়াল উপলক্ষে বান্দরবানে কেরাত, আযান ও ইসলামী সংগীত প্রতিযোগিতার পুরস্কার বিতরণ অনুষ্ঠিত হয়েছে। আজ শনিবার (২১ নভেম্বর) সকালে বান্দরবান ইসলামী পাঠাগার বান্দরবানের আয়োজনে পাঠাগারের সভাকক্ষে এইপুরস্কার বিতরণ অনুষ্ঠানের আয়োজন করা হয়। ইসলামী পাঠাগার বান্দরবানের প্রধান নির্বাহী অ্যাডভোকে&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%b0%e0%a6%ac%e0%a6%bf%e0%a6%89%e0%a6%b2-%e0%a6%86%e0%a6%89%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b2-%e0%a6%89%e0%a6%aa%e0%a6%b2%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a7%87-%e0%a6%ac%e0%a6%be%e0%a6%a8/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>খাগড়াছড়িতে ৮২ মি.মি. মর্টারশেল নিষ্ক্রিয় করল সেনাবাহিনী</title>
      <link>https://paharbarta.com/%e0%a6%96%e0%a6%be%e0%a6%97%e0%a6%a1%e0%a6%bc%e0%a6%be%e0%a6%9b%e0%a6%a1%e0%a6%bc%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a7%ae%e0%a7%a8-%e0%a6%ae%e0%a6%bf-%e0%a6%ae%e0%a6%bf-%e0%a6%ae%e0%a6%b0%e0%a7%8d/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%96%e0%a6%be%e0%a6%97%e0%a6%a1%e0%a6%bc%e0%a6%be%e0%a6%9b%e0%a6%a1%e0%a6%bc%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a7%ae%e0%a7%a8-%e0%a6%ae%e0%a6%bf-%e0%a6%ae%e0%a6%bf-%e0%a6%ae%e0%a6%b0%e0%a7%8d/</guid>
      <pubDate>Sat, 21 Nov 2026 12:24:03 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/FB_IMG_1795240882732.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/FB_IMG_1795240882732.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/FB_IMG_1795240882732.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="খাগড়াছড়িতে ৮২ মি.মি. মর্টারশেল নিষ্ক্রিয় করল সেনাবাহিনী" /&gt;&lt;/p&gt;&lt;p&gt;খাগড়াছড়ির শালবন এলাকায় মাটির নিচ থেকে উদ্ধার করা একটি পরিত্যক্ত মর্টারশেল বিস্ফোরণের মাধ্যমে নিষ্ক্রিয় করেছে বাংলাদেশ সেনাবাহিনীর বোমা ডিসপোজাল ইউনিট। ​ আজ শনিবার (২১ নভেম্বর) খাগড়াছড়ি সদর জোনের ১৮ বেঙ্গল বোমা ডিসপোজাল ইউনিটের সদস্যরা মর্টারশেলটি খবংপুড়িয়া এলাকার চেঙ্গী নদীর তীরে একটি নিরাপদ স্থানে &lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%96%e0%a6%be%e0%a6%97%e0%a6%a1%e0%a6%bc%e0%a6%be%e0%a6%9b%e0%a6%a1%e0%a6%bc%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a7%ae%e0%a7%a8-%e0%a6%ae%e0%a6%bf-%e0%a6%ae%e0%a6%bf-%e0%a6%ae%e0%a6%b0%e0%a7%8d/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>বান্দরবানে শ্রমিকদের কল্যাণে নতুন ট্যুরিস্ট জীপ চালু</title>
      <link>https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a6%ae%e0%a6%bf%e0%a6%95%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a6%b2%e0%a7%8d/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a6%ae%e0%a6%bf%e0%a6%95%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a6%b2%e0%a7%8d/</guid>
      <pubDate>Fri, 20 Nov 2026 12:05:22 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/Banadarban-Tourist-Coach-Pic20-Nov-2026-1.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/Banadarban-Tourist-Coach-Pic20-Nov-2026-1.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/Banadarban-Tourist-Coach-Pic20-Nov-2026-1.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বান্দরবানে শ্রমিকদের কল্যাণে নতুন ট্যুরিস্ট জীপ চালু" /&gt;&lt;/p&gt;&lt;p&gt;বান্দরবানে বান্দরবান মাইক্রোবাস শ্রমিক ইউনিয়নের শ্রমিকদের কল্যাণে এবার একটি ট্যুরিস্ট জীপ চালু করা হয়েছে। এই ট্যুারিস্ট জীপ থেকে অর্জিত অর্থ মাইক্রোবাস শ্রমিক ইউনিয়নের সদস্যদের বিভিন্ন চিকিৎসা,যাবতীয় দুর্ঘটনা এবং মৃত্যু পরবর্তী তাদের পরিবারের সহায়তার জন্য ব্যয় করা হবে। আজ শুক্রবার (২০ নভেম্বর) বিকেল&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a6%ae%e0%a6%bf%e0%a6%95%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a6%b2%e0%a7%8d/">পাহাড়বার্তা</source>

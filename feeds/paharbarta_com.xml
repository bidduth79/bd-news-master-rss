    <item>
      <title>স্ত্রীর করা মামলায় বান্দরবানে এনসিপি নেতা মিজানুর রহমান গ্রেপ্তার</title>
      <link>https://paharbarta.com/%e0%a6%b8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a7%80%e0%a6%b0-%e0%a6%95%e0%a6%b0%e0%a6%be-%e0%a6%ae%e0%a6%be%e0%a6%ae%e0%a6%b2%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%b8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a7%80%e0%a6%b0-%e0%a6%95%e0%a6%b0%e0%a6%be-%e0%a6%ae%e0%a6%be%e0%a6%ae%e0%a6%b2%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d/</guid>
      <pubDate>Sat, 14 Nov 2026 13:03:34 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/মিজানুর-রহমান-1.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/মিজানুর-রহমান-1.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/মিজানুর-রহমান-1.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="স্ত্রীর করা মামলায় বান্দরবানে এনসিপি নেতা মিজানুর রহমান গ্রেপ্তার" /&gt;&lt;/p&gt;&lt;p&gt;স্ত্রীর করা প্রতারণার মামলায় আদালতের গ্রেপ্তারি পরোয়ানার ভিত্তিতে জাতীয় নাগরিক পার্টির (এনসিপি) নেতা মিজানুর রহমান আখন্দকে গ্রেপ্তার করেছে পুলিশ। তিনি এনসিপির বান্দরবান জেলা আহ্বায়ক কমিটির সহ-সাংগঠনিক সম্পাদক। গ্রেপ্তারের পর তাকে দলীয় দায়িত্ব থেকে সাময়িক অব্যাহতি দিয়েছে দলটির কেন্দ্রীয় আহ্ব&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%b8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a7%80%e0%a6%b0-%e0%a6%95%e0%a6%b0%e0%a6%be-%e0%a6%ae%e0%a6%be%e0%a6%ae%e0%a6%b2%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>রূপসী কাপ্তাইয়ের ৪২তম প্রতিষ্ঠাবার্ষিকী উদযাপন</title>
      <link>https://paharbarta.com/%e0%a6%b0%e0%a7%82%e0%a6%aa%e0%a6%b8%e0%a7%80-%e0%a6%95%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%87%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%b0-%e0%a7%aa%e0%a7%a8%e0%a6%a4%e0%a6%ae-%e0%a6%aa/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%b0%e0%a7%82%e0%a6%aa%e0%a6%b8%e0%a7%80-%e0%a6%95%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%87%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%b0-%e0%a7%aa%e0%a7%a8%e0%a6%a4%e0%a6%ae-%e0%a6%aa/</guid>
      <pubDate>Sat, 14 Nov 2026 12:33:41 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/298495.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/298495.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/298495.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রূপসী কাপ্তাইয়ের ৪২তম প্রতিষ্ঠাবার্ষিকী উদযাপন" /&gt;&lt;/p&gt;&lt;p&gt;রাঙামাটির কাপ্তাই থেকে প্রকাশিত মাসিক সাময়িকী ‘রূপসী কাপ্তাই’-এর ৪২তম প্রতিষ্ঠাবার্ষিকী উদযাপন করা হয়েছে। আজ শনিবার (১৪ নভেম্বর) বিকেল ৩ টা হতে সন্ধ্যা পর্যন্ত কাপ্তাইয়ের ওয়াগ্গা প্যানোরোমা জুম রেস্তোরাঁয় এ উপলক্ষে সুধী সমাবেশ, কেক কাটা, সাংস্কৃতিক অনুষ্ঠান, র‍্যাফেল ড্র, পুরস্কার বিতরণ, সাংবাদিক সং&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%b0%e0%a7%82%e0%a6%aa%e0%a6%b8%e0%a7%80-%e0%a6%95%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%87%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%b0-%e0%a7%aa%e0%a7%a8%e0%a6%a4%e0%a6%ae-%e0%a6%aa/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>কাপ্তাইয়ে জোন কমান্ডারস স্কলারশিপ পরীক্ষায় অংশ নিল ৩৬৭ শিক্ষার্থী</title>
      <link>https://paharbarta.com/%e0%a6%95%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%87%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%9c%e0%a7%8b%e0%a6%a8-%e0%a6%95%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a1%e0%a6%be%e0%a6%b0%e0%a6%b8/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%95%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%87%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%9c%e0%a7%8b%e0%a6%a8-%e0%a6%95%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a1%e0%a6%be%e0%a6%b0%e0%a6%b8/</guid>
      <pubDate>Sat, 14 Nov 2026 12:27:16 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/298319.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/298319.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/298319.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কাপ্তাইয়ে জোন কমান্ডারস স্কলারশিপ পরীক্ষায় অংশ নিল ৩৬৭ শিক্ষার্থী" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ সেনাবাহিনীর রাঙামাটি রিজিয়নের অধীন কাপ্তাই ৩৮ রণজয়ী বীর জোনের উদ্যোগে জোন কমান্ডারস স্কলারশিপ-২০২৬ পরীক্ষা অনুষ্ঠিত হয়েছে। আজ শনিবার (১৪ নভেম্বর) সকাল ১০টা থেকে ১১টা পর্যন্ত কাপ্তাইয়ের ঐতিহ্যবাহী শিক্ষা প্রতিষ্ঠান শিশু নিকেতন স্কুলে এ পরীক্ষা অনুষ্ঠিত হয়। এতে কাপ্তাইসহ আশপাশের বিভিন্ন উপজেল&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%95%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%87%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%9c%e0%a7%8b%e0%a6%a8-%e0%a6%95%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a1%e0%a6%be%e0%a6%b0%e0%a6%b8/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>চন্দ্রঘোনায় ইয়াবাসহ যুবক গ্রেপ্তার, মোটরসাইকেল জব্দ</title>
      <link>https://paharbarta.com/%e0%a6%9a%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a7%8d%e0%a6%b0%e0%a6%98%e0%a7%8b%e0%a6%a8%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%87%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a6%b9-%e0%a6%af%e0%a7%81/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%9a%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a7%8d%e0%a6%b0%e0%a6%98%e0%a7%8b%e0%a6%a8%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%87%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a6%b9-%e0%a6%af%e0%a7%81/</guid>
      <pubDate>Sat, 14 Nov 2026 12:20:53 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/atna-Bihar-4.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/atna-Bihar-4.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/atna-Bihar-4.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চন্দ্রঘোনায় ইয়াবাসহ যুবক গ্রেপ্তার, মোটরসাইকেল জব্দ" /&gt;&lt;/p&gt;&lt;p&gt;রাঙামাটির কাপ্তাই উপজেলার রাইখালী বাজার এলাকায় অভিযান চালিয়ে ১১ পিস ইয়াবাসদৃশ ট্যাবলেটসহ মো. হাবিবুল ইসলাম মামুন (২০) নামে এক যুবককে গ্রেপ্তার করেছে পুলিশ। এ সময় তাঁর ব্যবহৃত একটি পালসার মোটরসাইকেলও জব্দ করা হয়েছে। গত শুক্রবার (১৩ নভেম্বর) দুপুর ২টা ১০ মিনিটের দিকে উপজেলার ২ নম্বর রাইখালী ইউনিয়নের ৩&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%9a%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a7%8d%e0%a6%b0%e0%a6%98%e0%a7%8b%e0%a6%a8%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%87%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a6%b9-%e0%a6%af%e0%a7%81/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>রামগড়ে সাবেক বিজিবি সদস্যের মৃতদেহ নদী থেকে উদ্ধার</title>
      <link>https://paharbarta.com/%e0%a6%b0%e0%a6%be%e0%a6%ae%e0%a6%97%e0%a6%a1%e0%a6%bc%e0%a7%87-%e0%a6%b8%e0%a6%be%e0%a6%ac%e0%a7%87%e0%a6%95-%e0%a6%ac%e0%a6%bf%e0%a6%9c%e0%a6%bf%e0%a6%ac%e0%a6%bf-%e0%a6%b8%e0%a6%a6%e0%a6%b8/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%b0%e0%a6%be%e0%a6%ae%e0%a6%97%e0%a6%a1%e0%a6%bc%e0%a7%87-%e0%a6%b8%e0%a6%be%e0%a6%ac%e0%a7%87%e0%a6%95-%e0%a6%ac%e0%a6%bf%e0%a6%9c%e0%a6%bf%e0%a6%ac%e0%a6%bf-%e0%a6%b8%e0%a6%a6%e0%a6%b8/</guid>
      <pubDate>Sat, 14 Nov 2026 12:13:38 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/Bihar-4.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/Bihar-4.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/Bihar-4.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রামগড়ে সাবেক বিজিবি সদস্যের মৃতদেহ নদী থেকে উদ্ধার" /&gt;&lt;/p&gt;&lt;p&gt;খাগড়াছড়ির রামগড়ে ফেনীরকুল সীমান্তে ফেনী নদী থেকে অংথৈইপ্রু মারমা নামে এক ব্যক্তির রক্তাক্ত মরদেহ উদ্ধার করেছে এলাকাবাসী। আজ শনিবার (১৪ নভেম্বর) সকাল সাড়ে ৮টার দিকে প্রতিবেশীরা পার্শ্ববর্তী ফেনী নদীতে খোঁজাখুঁজি করে তার মৃতদেহ উদ্ধার করেন। অংথৈইপ্রু মারমার ছেলে রামগড় শহীদ ক্যাপ্টেন আফতাবুল কাদের বিদ্&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%b0%e0%a6%be%e0%a6%ae%e0%a6%97%e0%a6%a1%e0%a6%bc%e0%a7%87-%e0%a6%b8%e0%a6%be%e0%a6%ac%e0%a7%87%e0%a6%95-%e0%a6%ac%e0%a6%bf%e0%a6%9c%e0%a6%bf%e0%a6%ac%e0%a6%bf-%e0%a6%b8%e0%a6%a6%e0%a6%b8/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>বান্দরবানের জ্ঞানরত্ন বৌদ্ধ বিহারে কঠিন চীবর দানোৎসব সম্পন্ন</title>
      <link>https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%9c%e0%a7%8d%e0%a6%9e%e0%a6%be%e0%a6%a8%e0%a6%b0%e0%a6%a4%e0%a7%8d%e0%a6%a8-%e0%a6%ac-5/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%9c%e0%a7%8d%e0%a6%9e%e0%a6%be%e0%a6%a8%e0%a6%b0%e0%a6%a4%e0%a7%8d%e0%a6%a8-%e0%a6%ac-5/</guid>
      <pubDate>Sat, 14 Nov 2026 12:10:23 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/Pic-Bandarban-Gaanaratna-Bihar-4.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/Pic-Bandarban-Gaanaratna-Bihar-4.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/Pic-Bandarban-Gaanaratna-Bihar-4.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বান্দরবানের জ্ঞানরত্ন বৌদ্ধ বিহারে কঠিন চীবর দানোৎসব সম্পন্ন" /&gt;&lt;/p&gt;&lt;p&gt;বান্দরবানের জ্ঞানরত্ন বৌদ্ধ বিহারে দানোত্তম শুভ কঠিন চীবর দানোৎসব সম্পন্ন হয়েছে। আজ শনিবার (১৪ নভেম্বর) সকালে বান্দরবান সদরের বালাঘাটা চন্দ্রমোহন মেম্বার পাড়ার জ্ঞানরত্ন বৌদ্ধ বিহারের সকল দায়ক-দায়িকা ও বিহার পরিচালনা কমিটির আয়োজনে বিভিন্ন কর্মসূচির মধ্য দিয়ে ২১তম দানোত্তম এই শুভ কঠিন চীবর দানোৎসব সম&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%9c%e0%a7%8d%e0%a6%9e%e0%a6%be%e0%a6%a8%e0%a6%b0%e0%a6%a4%e0%a7%8d%e0%a6%a8-%e0%a6%ac-5/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>বান্দরবানে বিশ্ব ডায়াবেটিস দিবস উদযাপন</title>
      <link>https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%ac-%e0%a6%a1%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%ac-2/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%ac-%e0%a6%a1%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%ac-2/</guid>
      <pubDate>Sat, 14 Nov 2026 11:59:16 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/Bandarban-Diabetic-Divas-Pic-14-Nov-2026-3.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/Bandarban-Diabetic-Divas-Pic-14-Nov-2026-3.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/Bandarban-Diabetic-Divas-Pic-14-Nov-2026-3.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বান্দরবানে বিশ্ব ডায়াবেটিস দিবস উদযাপন" /&gt;&lt;/p&gt;&lt;p&gt;“ডায়াবেটিসে দেরি নয়, ব্যবস্থা নিন এখনই” এই প্রতিপাদ্যকে সামনে রেখে নানা আয়োজনে বান্দরবানে বিশ্ব ডায়াবেটিস দিবস উদযাপন করা হয়েছে। দিবসটি উপলক্ষ্যে আজ শনিবার (১৪ নভেম্বর) সকালে বান্দরবান ডায়াবেটিক সমিতির আয়োজনে জেলা প্রশাসকের কার্যালয় প্রাঙ্গন থেকে একটি বর্ণাঢ্য শোভাযাত্রা বের হয়ে শহরের প্রধান সড়ক প্র&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%ac-%e0%a6%a1%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%ac-2/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>বান্দরবানে অনুষ্ঠিত হলো অন্নকূট মহোৎসব</title>
      <link>https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%85%e0%a6%a8%e0%a7%81%e0%a6%b7%e0%a7%8d%e0%a6%a0%e0%a6%bf%e0%a6%a4-%e0%a6%b9%e0%a6%b2%e0%a7%8b-5/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%85%e0%a6%a8%e0%a7%81%e0%a6%b7%e0%a7%8d%e0%a6%a0%e0%a6%bf%e0%a6%a4-%e0%a6%b9%e0%a6%b2%e0%a7%8b-5/</guid>
      <pubDate>Fri, 13 Nov 2026 12:51:25 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/Bandarban-Sanatany-Annakut-News-Pic-13-Nov-2026-.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/Bandarban-Sanatany-Annakut-News-Pic-13-Nov-2026-.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/Bandarban-Sanatany-Annakut-News-Pic-13-Nov-2026-.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বান্দরবানে অনুষ্ঠিত হলো অন্নকূট মহোৎসব" /&gt;&lt;/p&gt;&lt;p&gt;পার্বত্য জেলা বান্দরবানে ধর্মীয় ভাবগাম্ভীর্য ও উৎসবমুখর পরিবেশে অনুষ্ঠিত হলো গিরি গোবর্ধন পূজা ও অন্নকূট মহোৎসব। আন্তর্জাতিক কৃষ্ণভাবনামৃত সংঘ (ইসকন) বান্দরবানের উদ্যোগে কালাঘাটাস্থ শ্রী শ্রী রাধা গিরিধারী মন্দির প্রাঙ্গণে দিনব্যাপী নানা ধর্মীয় অনুষ্ঠানের মাধ্যমে এই আয়োজন সুন্দরভাবে সম্পন্ন হয়। গিরি&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%85%e0%a6%a8%e0%a7%81%e0%a6%b7%e0%a7%8d%e0%a6%a0%e0%a6%bf%e0%a6%a4-%e0%a6%b9%e0%a6%b2%e0%a7%8b-5/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>রামগড়ে ১১২ জনকে সম্মাননা প্রদান করলো শ্রী শ্রী লোকনাথ ধাম পরিচালনা পর্ষদ</title>
      <link>https://paharbarta.com/%e0%a6%b0%e0%a6%be%e0%a6%ae%e0%a6%97%e0%a6%a1%e0%a6%bc%e0%a7%87-%e0%a7%a7%e0%a7%a7%e0%a7%a8-%e0%a6%9c%e0%a6%a8%e0%a6%95%e0%a7%87-%e0%a6%b8%e0%a6%ae%e0%a7%8d%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a6%a8/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%b0%e0%a6%be%e0%a6%ae%e0%a6%97%e0%a6%a1%e0%a6%bc%e0%a7%87-%e0%a7%a7%e0%a7%a7%e0%a7%a8-%e0%a6%9c%e0%a6%a8%e0%a6%95%e0%a7%87-%e0%a6%b8%e0%a6%ae%e0%a7%8d%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a6%a8/</guid>
      <pubDate>Fri, 13 Nov 2026 12:43:09 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/WhatsApp-Image-2026-11-13-at-3.53.57-PM.jpeg.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/WhatsApp-Image-2026-11-13-at-3.53.57-PM.jpeg.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/WhatsApp-Image-2026-11-13-at-3.53.57-PM.jpeg.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রামগড়ে ১১২ জনকে সম্মাননা প্রদান করলো শ্রী শ্রী লোকনাথ ধাম পরিচালনা পর্ষদ" /&gt;&lt;/p&gt;&lt;p&gt;খাগড়াছড়ির রামগড়ে শ্রী শ্রী লোকনাথ ধাম পরিচালনা পর্ষদের উদ্যোগে এক বর্ণাঢ্য আয়োজনের মধ্য দিয়ে প্রথমবারের মতো কৃতি ব্যক্তিবর্গ ও ধর্মীয় নেতৃবৃন্দকে সম্মাননা প্রদান করা হয়েছে। আজ শুক্রবার (১৩ নভেম্বর) সকাল ১১টায় গর্জনতলীস্থ লোকনাথ ধাম প্রাঙ্গণে এই সম্মাননা প্রদান অনুষ্ঠান অনুষ্ঠিত হয়। অনুষ্ঠানে লোকনাথ &lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%b0%e0%a6%be%e0%a6%ae%e0%a6%97%e0%a6%a1%e0%a6%bc%e0%a7%87-%e0%a7%a7%e0%a7%a7%e0%a7%a8-%e0%a6%9c%e0%a6%a8%e0%a6%95%e0%a7%87-%e0%a6%b8%e0%a6%ae%e0%a7%8d%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a6%a8/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>বান্দরবানের করুণাপুর বন বিহারে কঠিন চীবর দানোৎসব উদযাপিত</title>

    <item>
      <title>বান্দরবানে অনুষ্ঠিত হলো অন্নকূট মহোৎসব</title>
      <link>https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%85%e0%a6%a8%e0%a7%81%e0%a6%b7%e0%a7%8d%e0%a6%a0%e0%a6%bf%e0%a6%a4-%e0%a6%b9%e0%a6%b2%e0%a7%8b-5/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%85%e0%a6%a8%e0%a7%81%e0%a6%b7%e0%a7%8d%e0%a6%a0%e0%a6%bf%e0%a6%a4-%e0%a6%b9%e0%a6%b2%e0%a7%8b-5/</guid>
      <pubDate>Fri, 13 Nov 2026 12:51:25 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/Bandarban-Sanatany-Annakut-News-Pic-13-Nov-2026-.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/Bandarban-Sanatany-Annakut-News-Pic-13-Nov-2026-.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/Bandarban-Sanatany-Annakut-News-Pic-13-Nov-2026-.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বান্দরবানে অনুষ্ঠিত হলো অন্নকূট মহোৎসব" /&gt;&lt;/p&gt;&lt;p&gt;পার্বত্য জেলা বান্দরবানে ধর্মীয় ভাবগাম্ভীর্য ও উৎসবমুখর পরিবেশে অনুষ্ঠিত হলো গিরি গোবর্ধন পূজা ও অন্নকূট মহোৎসব। আন্তর্জাতিক কৃষ্ণভাবনামৃত সংঘ (ইসকন) বান্দরবানের উদ্যোগে কালাঘাটাস্থ শ্রী শ্রী রাধা গিরিধারী মন্দির প্রাঙ্গণে দিনব্যাপী নানা ধর্মীয় অনুষ্ঠানের মাধ্যমে এই আয়োজন সুন্দরভাবে সম্পন্ন হয়। গিরি&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%85%e0%a6%a8%e0%a7%81%e0%a6%b7%e0%a7%8d%e0%a6%a0%e0%a6%bf%e0%a6%a4-%e0%a6%b9%e0%a6%b2%e0%a7%8b-5/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>রামগড়ে ১১২ জনকে সম্মাননা প্রদান করলো শ্রী শ্রী লোকনাথ ধাম পরিচালনা পর্ষদ</title>
      <link>https://paharbarta.com/%e0%a6%b0%e0%a6%be%e0%a6%ae%e0%a6%97%e0%a6%a1%e0%a6%bc%e0%a7%87-%e0%a7%a7%e0%a7%a7%e0%a7%a8-%e0%a6%9c%e0%a6%a8%e0%a6%95%e0%a7%87-%e0%a6%b8%e0%a6%ae%e0%a7%8d%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a6%a8/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%b0%e0%a6%be%e0%a6%ae%e0%a6%97%e0%a6%a1%e0%a6%bc%e0%a7%87-%e0%a7%a7%e0%a7%a7%e0%a7%a8-%e0%a6%9c%e0%a6%a8%e0%a6%95%e0%a7%87-%e0%a6%b8%e0%a6%ae%e0%a7%8d%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a6%a8/</guid>
      <pubDate>Fri, 13 Nov 2026 12:43:09 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/WhatsApp-Image-2026-11-13-at-3.53.57-PM.jpeg.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/WhatsApp-Image-2026-11-13-at-3.53.57-PM.jpeg.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/WhatsApp-Image-2026-11-13-at-3.53.57-PM.jpeg.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রামগড়ে ১১২ জনকে সম্মাননা প্রদান করলো শ্রী শ্রী লোকনাথ ধাম পরিচালনা পর্ষদ" /&gt;&lt;/p&gt;&lt;p&gt;খাগড়াছড়ির রামগড়ে শ্রী শ্রী লোকনাথ ধাম পরিচালনা পর্ষদের উদ্যোগে এক বর্ণাঢ্য আয়োজনের মধ্য দিয়ে প্রথমবারের মতো কৃতি ব্যক্তিবর্গ ও ধর্মীয় নেতৃবৃন্দকে সম্মাননা প্রদান করা হয়েছে। আজ শুক্রবার (১৩ নভেম্বর) সকাল ১১টায় গর্জনতলীস্থ লোকনাথ ধাম প্রাঙ্গণে এই সম্মাননা প্রদান অনুষ্ঠান অনুষ্ঠিত হয়। অনুষ্ঠানে লোকনাথ &lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%b0%e0%a6%be%e0%a6%ae%e0%a6%97%e0%a6%a1%e0%a6%bc%e0%a7%87-%e0%a7%a7%e0%a7%a7%e0%a7%a8-%e0%a6%9c%e0%a6%a8%e0%a6%95%e0%a7%87-%e0%a6%b8%e0%a6%ae%e0%a7%8d%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a6%a8/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>বান্দরবানের করুণাপুর বন বিহারে কঠিন চীবর দানোৎসব উদযাপিত</title>
      <link>https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a6%b0%e0%a7%81%e0%a6%a3%e0%a6%be%e0%a6%aa%e0%a7%81%e0%a6%b0-%e0%a6%ac%e0%a6%a8/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a6%b0%e0%a7%81%e0%a6%a3%e0%a6%be%e0%a6%aa%e0%a7%81%e0%a6%b0-%e0%a6%ac%e0%a6%a8/</guid>
      <pubDate>Fri, 13 Nov 2026 12:39:26 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/Bandarban-Buddist-Katin-Cibar-Dan-Pic-13-Nov-2026-2.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/Bandarban-Buddist-Katin-Cibar-Dan-Pic-13-Nov-2026-2.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/Bandarban-Buddist-Katin-Cibar-Dan-Pic-13-Nov-2026-2.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বান্দরবানের করুণাপুর বন বিহারে কঠিন চীবর দানোৎসব উদযাপিত" /&gt;&lt;/p&gt;&lt;p&gt;নানান ধর্মীয় আয়োজনে বান্দরবানের করুণাপুর বন বিহারে দানোত্তম শুভ কঠিন চীবর দানোৎসব উদযাপিত হয়েছে। শুভ কঠিন চীবর দানোৎসব উপলক্ষ্যে আজ শুক্রবার (১৩ নভেম্বর) বান্দরবান সদরের করুণাপুর বন বিহারে উপাসক-উপাসিকাবৃন্দের আয়োজনে বিভিন্ন কর্মসূচির মধ্য দিয়ে দানোত্তম এই শুভ কঠিন চীবর দানোৎসব উদযাপিত হয়। কঠিন চীবর&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a6%b0%e0%a7%81%e0%a6%a3%e0%a6%be%e0%a6%aa%e0%a7%81%e0%a6%b0-%e0%a6%ac%e0%a6%a8/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>কারিগরি শিক্ষায় দক্ষ হলেই বিদেশে লাখ টাকা আয় সম্ভব : উপ-পরিচালক</title>
      <link>https://paharbarta.com/%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%bf%e0%a6%97%e0%a6%b0%e0%a6%bf-%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%a6%e0%a6%95%e0%a7%8d%e0%a6%b7-%e0%a6%b9%e0%a6%b2/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%bf%e0%a6%97%e0%a6%b0%e0%a6%bf-%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%a6%e0%a6%95%e0%a7%8d%e0%a6%b7-%e0%a6%b9%e0%a6%b2/</guid>
      <pubDate>Fri, 13 Nov 2026 12:36:57 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/1000741245.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/1000741245.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/1000741245.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কারিগরি শিক্ষায় দক্ষ হলেই বিদেশে লাখ টাকা আয় সম্ভব : উপ-পরিচালক" /&gt;&lt;/p&gt;&lt;p&gt;কারিগরি শিক্ষায় একজন শিক্ষার্থী যদি নবম ও দশম শ্রেণিতে ভালোভাবে দক্ষ হয়ে ওঠে, তাহলে শুধু এই দক্ষতা নিয়েই বিদেশে গিয়ে মাসে দেড় থেকে দুই লাখ টাকা আয় করা সম্ভব বলে মন্তব্য করেছেন বাংলাদেশ কারিগরি শিক্ষা বোর্ডের উপ-পরিচালক মুহাম্মদ নুর উদ্দিন আহমদ। আজ শুক্রবার (১৩ নভেম্বর) বেলা সাড়ে ১১টায় তিনি র&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%bf%e0%a6%97%e0%a6%b0%e0%a6%bf-%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%a6%e0%a6%95%e0%a7%8d%e0%a6%b7-%e0%a6%b9%e0%a6%b2/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>কাপ্তাইয়ে নজরুলের জীবন ও সৃষ্টিকর্ম নিয়ে সাংস্কৃতিক অনুষ্ঠান ও আলোকচিত্র প্রদর্শনী</title>
      <link>https://paharbarta.com/%e0%a6%95%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%87%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%a8%e0%a6%9c%e0%a6%b0%e0%a7%81%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a6%9c%e0%a7%80%e0%a6%ac%e0%a6%a8/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%95%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%87%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%a8%e0%a6%9c%e0%a6%b0%e0%a7%81%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a6%9c%e0%a7%80%e0%a6%ac%e0%a6%a8/</guid>
      <pubDate>Thu, 12 Nov 2026 12:49:26 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/295750.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/295750.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/295750.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কাপ্তাইয়ে নজরুলের জীবন ও সৃষ্টিকর্ম নিয়ে সাংস্কৃতিক অনুষ্ঠান ও আলোকচিত্র প্রদর্শনী" /&gt;&lt;/p&gt;&lt;p&gt;জাতীয় কবি কাজী নজরুল ইসলামের জীবন, সাহিত্য ও সৃষ্টিকর্ম নতুন প্রজন্মের কাছে তুলে ধরতে রাঙামাটির কাপ্তাইয়ে নজরুল বর্ষ উদযাপন উপলক্ষে সাংস্কৃতিক অনুষ্ঠান ও আলোকচিত্র প্রদর্শনীর আয়োজন করা হয়েছে। আজ বৃহস্পতিবার (১২ নভেম্বর) বিকেল সাড়ে ৩টা থেকে সন্ধ্যা ৬টা পর্যন্ত কাপ্তাই উপজেলা পরিষদ মিলনায়তনে সংস্কৃতিব&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%95%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%87%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%a8%e0%a6%9c%e0%a6%b0%e0%a7%81%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a6%9c%e0%a7%80%e0%a6%ac%e0%a6%a8/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>খাগড়াছড়িতে সমাজসেবা ও ভূমি অফিসে রহস্যজনক অগ্নিকাণ্ড</title>

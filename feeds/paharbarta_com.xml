    <item>
      <title>হাসি ফুটল থানচির ৬০ হতদরিদ্র ও প্রতিবন্ধীদের মুখে</title>
      <link>https://paharbarta.com/%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf-%e0%a6%ab%e0%a7%81%e0%a6%9f%e0%a6%b2-%e0%a6%a5%e0%a6%be%e0%a6%a8%e0%a6%9a%e0%a6%bf%e0%a6%b0-%e0%a7%ac%e0%a7%a6-%e0%a6%b9%e0%a6%a4%e0%a6%a6%e0%a6%b0%e0%a6%bf/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf-%e0%a6%ab%e0%a7%81%e0%a6%9f%e0%a6%b2-%e0%a6%a5%e0%a6%be%e0%a6%a8%e0%a6%9a%e0%a6%bf%e0%a6%b0-%e0%a7%ac%e0%a7%a6-%e0%a6%b9%e0%a6%a4%e0%a6%a6%e0%a6%b0%e0%a6%bf/</guid>
      <pubDate>Thu, 26 Nov 2026 12:47:32 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/1000456812.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/1000456812.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/1000456812.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হাসি ফুটল থানচির ৬০ হতদরিদ্র ও প্রতিবন্ধীদের মুখে" /&gt;&lt;/p&gt;&lt;p&gt;পাহাড়ে শীতের শুরুতে মানবিক উষ্ণতা, ​দেশের অন্যতম দুর্গম ও শীতপ্রবণ পাহাড়ি জনপদ বান্দরবানের থানচি উপজেলার জেঁকে বসতে শুরু করেছে শীত। আর পাহাড়ের এই কনকনে শীতের শুরুতেই অসহায় মানুষের পাশে উষ্ণতার পরশ নিয়ে দাঁড়িয়েছেন স্থানীয় পর্যটনকর্মীরা। আজ বৃহস্পতিবার (২৬ নভেম্বর) সকালে উপজেলার পরিষদের প্রাঙ্গনের ৬০ট&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf-%e0%a6%ab%e0%a7%81%e0%a6%9f%e0%a6%b2-%e0%a6%a5%e0%a6%be%e0%a6%a8%e0%a6%9a%e0%a6%bf%e0%a6%b0-%e0%a7%ac%e0%a7%a6-%e0%a6%b9%e0%a6%a4%e0%a6%a6%e0%a6%b0%e0%a6%bf/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>কাপ্তাইয়ে বিজিবির অভিযানে ২৩ ঘনফুট অবৈধ কাঠ জব্দ</title>
      <link>https://paharbarta.com/%e0%a6%95%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%87%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%9c%e0%a6%bf%e0%a6%ac%e0%a6%bf%e0%a6%b0-%e0%a6%85%e0%a6%ad%e0%a6%bf%e0%a6%af-2/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%95%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%87%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%9c%e0%a6%bf%e0%a6%ac%e0%a6%bf%e0%a6%b0-%e0%a6%85%e0%a6%ad%e0%a6%bf%e0%a6%af-2/</guid>
      <pubDate>Thu, 26 Nov 2026 12:41:55 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/315918.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/315918.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/315918.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কাপ্তাইয়ে বিজিবির অভিযানে ২৩ ঘনফুট অবৈধ কাঠ জব্দ" /&gt;&lt;/p&gt;&lt;p&gt;রাঙামাটির কাপ্তাই উপজেলায় বিশেষ অভিযান চালিয়ে ২৩ ঘনফুটের বেশি অবৈধ সেগুন ও গামারী কাঠ জব্দ করেছে বর্ডার গার্ড বাংলাদেশ (বিজিবি)। জব্দ করা কাঠের আনুমানিক সিজার মূল্য ১ লাখ ৮ হাজার ৫৭০ টাকা। গত বুধবার (২৫ নভেম্বর) সন্ধ্যা ৬টার দিকে গোয়েন্দা তথ্যের ভিত্তিতে কাপ্তাই ব্যাটালিয়ন (৪১ বিজিবি) এর অধিনায়কের দ&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%95%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%87%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%9c%e0%a6%bf%e0%a6%ac%e0%a6%bf%e0%a6%b0-%e0%a6%85%e0%a6%ad%e0%a6%bf%e0%a6%af-2/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>বান্দরবানে নতুন আক্রান্ত ৮ জন ডেঙ্গু রোগী</title>
      <link>https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%86%e0%a6%95%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%a8%e0%a7%8d-2/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%86%e0%a6%95%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%a8%e0%a7%8d-2/</guid>
      <pubDate>Thu, 26 Nov 2026 12:38:39 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/মশা.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/মশা.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/মশা.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বান্দরবানে নতুন আক্রান্ত ৮ জন ডেঙ্গু রোগী" /&gt;&lt;/p&gt;&lt;p&gt;নতুন ভাবে বান্দরবানে আরো ৮জন ডেঙ্গু রোগী সনাক্ত হয়েছে। যাদের মধ্যে বান্দরবান সদর হাসপাতালে ৪ জন এবং লামা উপজেলা স্বাস্থ্য কমপ্লেক্সে আরো ৪জন নতুন ডেঙ্গু রোগী সনাক্ত হয়েছে। জেলা স্বাস্থ্য বিভাগের তথ্যমতে, বান্দরবানে এই পর্যন্ত ১,৫৯৮ জন ডেঙ্গু রোগী পাওয়া গেছে যারা উপজেলা স্বাস্থ্য কমপ্লেক্স ও সরকারী হ&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%86%e0%a6%95%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%a8%e0%a7%8d-2/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>বাঙালহালিয়ায় গাছের সঙ্গে পিকআপের ধাক্কায় নিহত ১, চালক আহত</title>
      <link>https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%99%e0%a6%be%e0%a6%b2%e0%a6%b9%e0%a6%be%e0%a6%b2%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%97%e0%a6%be%e0%a6%9b%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%99%e0%a7%8d/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%99%e0%a6%be%e0%a6%b2%e0%a6%b9%e0%a6%be%e0%a6%b2%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%97%e0%a6%be%e0%a6%9b%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%99%e0%a7%8d/</guid>
      <pubDate>Thu, 26 Nov 2026 12:34:06 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/সড়ক-দূর্ঘটনা-3.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/সড়ক-দূর্ঘটনা-3.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/সড়ক-দূর্ঘটনা-3.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাঙালহালিয়ায় গাছের সঙ্গে পিকআপের ধাক্কায় নিহত ১, চালক আহত" /&gt;&lt;/p&gt;&lt;p&gt;রাঙামাটি-বান্দরবান সড়কের রাজস্থলী উপজেলার বাঙ্গালহালিয়া হেলিপ্যাড এলাকায় পিকআপ ভ্যান নিয়ন্ত্রণ হারিয়ে গাছের সঙ্গে ধাক্কা লেগে একজন নিহত ও চালক আহত হয়েছে। আবুল খায়ের কোম্পানির দুগ্ধজাত পণ্যবাহী পিকআপ ভ্যান এই দূর্ঘটনার শিকার হয়। এতে সেলসম্যান খোকন দে (৪৫) নিহত ও পিকআপ ভ্যানের চালক আমজাদ হোসেন (৬০) গু&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%99%e0%a6%be%e0%a6%b2%e0%a6%b9%e0%a6%be%e0%a6%b2%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%97%e0%a6%be%e0%a6%9b%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%99%e0%a7%8d/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>পাহাড়ের উন্নয়নে শতভাগ স্বচ্ছতা নিশ্চিত করতে হবে: মন্ত্রী সাচিং প্রু জেরী</title>
      <link>https://paharbarta.com/%e0%a6%aa%e0%a6%be%e0%a6%b9%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a7%87%e0%a6%b0-%e0%a6%89%e0%a6%a8%e0%a7%8d%e0%a6%a8%e0%a6%af%e0%a6%bc%e0%a6%a8%e0%a7%87-%e0%a6%b6%e0%a6%a4%e0%a6%ad%e0%a6%be%e0%a6%97/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%aa%e0%a6%be%e0%a6%b9%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a7%87%e0%a6%b0-%e0%a6%89%e0%a6%a8%e0%a7%8d%e0%a6%a8%e0%a6%af%e0%a6%bc%e0%a6%a8%e0%a7%87-%e0%a6%b6%e0%a6%a4%e0%a6%ad%e0%a6%be%e0%a6%97/</guid>
      <pubDate>Thu, 26 Nov 2026 12:31:19 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/1000254560.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/1000254560.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/1000254560.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পাহাড়ের উন্নয়নে শতভাগ স্বচ্ছতা নিশ্চিত করতে হবে: মন্ত্রী সাচিং প্রু জেরী" /&gt;&lt;/p&gt;&lt;p&gt;পাহাড়ের উন্নয়ন প্রকল্পে অনিয়ম ও অপচয় বন্ধ করে শতভাগ স্বচ্ছতা ও জবাবদিহিতা নিশ্চিত করার আহ্বান জানিয়েছেন পার্বত্য চট্টগ্রাম বিষয়ক মন্ত্রী সাচিং প্রু জেরী এমপি। তিনি বলেন, অতীতে অনেক প্রকল্পে কোটি কোটি টাকা ব্যয় হলেও দৃশ্যমান উন্নয়ন হয়নি। বর্তমান সরকার এ অবস্থার পরিবর্তন চায়। উন্নয়নের প্রতিটি টাকা যেন&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%aa%e0%a6%be%e0%a6%b9%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a7%87%e0%a6%b0-%e0%a6%89%e0%a6%a8%e0%a7%8d%e0%a6%a8%e0%a6%af%e0%a6%bc%e0%a6%a8%e0%a7%87-%e0%a6%b6%e0%a6%a4%e0%a6%ad%e0%a6%be%e0%a6%97/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>কাপ্তাইয়ে চা বোর্ডের চেয়ারম্যান মেজর জেনারেল মো: মেসবাহ উদ্দিন আহমেদ</title>
      <link>https://paharbarta.com/%e0%a6%95%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%87%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%9a%e0%a6%be-%e0%a6%ac%e0%a7%8b%e0%a6%b0%e0%a7%8d%e0%a6%a1%e0%a7%87%e0%a6%b0-%e0%a6%9a%e0%a7%87-2/</link>

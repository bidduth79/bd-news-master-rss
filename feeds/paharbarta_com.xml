      <media:content url="https://paharbarta.com/wp-content/uploads/Bandarban-Sports-News-Pic-18-Nov-2026.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/Bandarban-Sports-News-Pic-18-Nov-2026.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বান্দরবানে ক্রীড়া অফিস পরিদর্শন করলেন পার্বত্য জেলা পরিষদের ক্রীড়া কনভেনর" /&gt;&lt;/p&gt;&lt;p&gt;বান্দরবানে জেলা ক্রীড়া অফিস পরিদর্শন করেছেন জেলা পরিষদ সদস্য ও ক্রীড়া বিষয়ক কনভেনিং কমিটির কনভেনর কাজী নিরুতাজ বেগম। আজ বুধবার (১৮ নভেম্বর) সকালে বান্দরবান জেলা ক্রীড়া অফিস পরিদর্শন শেষে বিশেষ চাহিদাসম্পন্ন শিশুদের নিয়ে অনুষ্ঠিত আনন্দ উৎসব অনুষ্ঠানে পুরষ্কার বিতরন করেন তিনি। বান্দরবান জেলা ক্রীড়া অফ&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%95%e0%a7%8d%e0%a6%b0%e0%a7%80%e0%a6%a1%e0%a6%bc%e0%a6%be-%e0%a6%85%e0%a6%ab%e0%a6%bf%e0%a6%b8/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>বান্দরবানে সনাতন ধর্মালম্বীদের শ্রী শ্রী জগদ্ধাত্রী পূজা উদযাপন</title>
      <link>https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%b8%e0%a6%a8%e0%a6%be%e0%a6%a4%e0%a6%a8-%e0%a6%a7%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a6%be%e0%a6%b2-15/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%b8%e0%a6%a8%e0%a6%be%e0%a6%a4%e0%a6%a8-%e0%a6%a7%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a6%be%e0%a6%b2-15/</guid>
      <pubDate>Wed, 18 Nov 2026 11:59:04 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/Bandarban-Sanatany-Jagadarti-Puja-Pic18-Nov-2026-2.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/Bandarban-Sanatany-Jagadarti-Puja-Pic18-Nov-2026-2.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/Bandarban-Sanatany-Jagadarti-Puja-Pic18-Nov-2026-2.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বান্দরবানে সনাতন ধর্মালম্বীদের শ্রী শ্রী জগদ্ধাত্রী পূজা উদযাপন" /&gt;&lt;/p&gt;&lt;p&gt;থাযথ ধর্মীয় ভাবগাম্ভীর্যের মধ্য দিয়ে বান্দরবানে শুরু হয়েছে সনাতন ধর্মালম্বীদের শ্রী শ্রী জগদ্ধাত্রী পূজা। আজ ১৮ নভেম্বর (বুধবার) সকালে বান্দরবান সদরের কেন্দ্রীয় মন্দিরের আওতাধীন প্রাঙ্গনে এই পূজা শুরু হয়। জগদ্ধাত্রী পূজা উপলক্ষ্যে ভোরে মঙ্গল প্রদীপ প্রজ্জলনের মধ্য দিয়ে পূজার আনুষ্টানিকতা শুরু হয়। এর&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%b8%e0%a6%a8%e0%a6%be%e0%a6%a4%e0%a6%a8-%e0%a6%a7%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a6%be%e0%a6%b2-15/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>বান্দরবান সাংবাদিক কল্যাণ ফোরামের সভাপতি আলাউদ্দিন, সাধারণ সম্পাদক এস বাসু দাশ</title>
      <link>https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8-%e0%a6%b8%e0%a6%be%e0%a6%82%e0%a6%ac%e0%a6%be%e0%a6%a6%e0%a6%bf%e0%a6%95-%e0%a6%95%e0%a6%b2%e0%a7%8d%e0%a6%af%e0%a6%be/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8-%e0%a6%b8%e0%a6%be%e0%a6%82%e0%a6%ac%e0%a6%be%e0%a6%a6%e0%a6%bf%e0%a6%95-%e0%a6%95%e0%a6%b2%e0%a7%8d%e0%a6%af%e0%a6%be/</guid>
      <pubDate>Wed, 18 Nov 2026 11:50:09 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/32.jpeg-copy.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/32.jpeg-copy.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/32.jpeg-copy.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বান্দরবান সাংবাদিক কল্যাণ ফোরামের সভাপতি আলাউদ্দিন, সাধারণ সম্পাদক এস বাসু দাশ" /&gt;&lt;/p&gt;&lt;p&gt;বান্দরবানের বিভিন্ন গণমাধ্যমে কর্মরত সাংবাদিকদের সমন্বয়ে ১১ সদস্যবিশিষ্ট ‘বান্দরবান সাংবাদিক কল্যাণ ফোরাম’ গঠন করা হয়েছে। কমিটিতে এনটিভির স্টাফ রিপোর্টার ও দৈনিক যুগান্তরের বান্দরবান জেলা প্রতিনিধি আলাউদ্দিন শাহরিয়ারকে সভাপতি, আজকের পত্রিকা ও ঢাকা ট্রিবিউন এর জেলা প্রতিনিধি এস বাসু দাশ&amp;#8217;কে সাধা&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8-%e0%a6%b8%e0%a6%be%e0%a6%82%e0%a6%ac%e0%a6%be%e0%a6%a6%e0%a6%bf%e0%a6%95-%e0%a6%95%e0%a6%b2%e0%a7%8d%e0%a6%af%e0%a6%be/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>বান্দরবানে সড়ক দুর্ঘটনায় পুলিশ কনস্টেবল নিহত</title>
      <link>https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%b8%e0%a6%a1%e0%a6%bc%e0%a6%95-%e0%a6%a6%e0%a7%81%e0%a6%b0%e0%a7%8d%e0%a6%98%e0%a6%9f%e0%a6%a8%e0%a6%be/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%b8%e0%a6%a1%e0%a6%bc%e0%a6%95-%e0%a6%a6%e0%a7%81%e0%a6%b0%e0%a7%8d%e0%a6%98%e0%a6%9f%e0%a6%a8%e0%a6%be/</guid>
      <pubDate>Wed, 18 Nov 2026 11:32:06 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/সড়ক-দূর্ঘটনা..jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/সড়ক-দূর্ঘটনা..jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/সড়ক-দূর্ঘটনা..jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বান্দরবানে সড়ক দুর্ঘটনায় পুলিশ কনস্টেবল নিহত" /&gt;&lt;/p&gt;&lt;p&gt;বান্দরবানের লামা-আলীকদম সড়কের শিবাতলী এলাকায় বাসচাপায় সাজু চক্রবর্তী (৩৫) নামে এক পুলিশ কনস্টেবল নিহত হয়েছেন। তিনি জেলার আলীকদম থানায় কর্মরত ছিলেন। আজ বুধবার (১৮ নভেম্বর) বিকেলে জেলার আলিকদম উপজেলার শিবাতলী এলাকায় এ দুর্ঘটনা ঘটে। স্থানীয় ও পুলিশ সূত্রে জানা যায়, সাজু চক্রবর্তী কক্সবাজার থেকে মোটরসাই&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%b8%e0%a6%a1%e0%a6%bc%e0%a6%95-%e0%a6%a6%e0%a7%81%e0%a6%b0%e0%a7%8d%e0%a6%98%e0%a6%9f%e0%a6%a8%e0%a6%be/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>কাপ্তাইয়ে গিরি গোবর্ধন পূজা ও অন্নকূট মহোৎসব উদযাপন</title>
      <link>https://paharbarta.com/%e0%a6%95%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%87%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%97%e0%a6%bf%e0%a6%b0%e0%a6%bf-%e0%a6%97%e0%a7%8b%e0%a6%ac%e0%a6%b0%e0%a7%8d%e0%a6%a7%e0%a6%a8/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%95%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%87%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%97%e0%a6%bf%e0%a6%b0%e0%a6%bf-%e0%a6%97%e0%a7%8b%e0%a6%ac%e0%a6%b0%e0%a7%8d%e0%a6%a7%e0%a6%a8/</guid>
      <pubDate>Tue, 17 Nov 2026 11:53:06 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/iskon.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/iskon.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/iskon.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কাপ্তাইয়ে গিরি গোবর্ধন পূজা ও অন্নকূট মহোৎসব উদযাপন" /&gt;&lt;/p&gt;&lt;p&gt;রাঙামাটির কাপ্তাই উপজেলার চন্দ্রঘোনা মিশন এলাকায় ধর্মীয় ভাবগাম্ভীর্য ও উৎসবমুখর পরিবেশে শ্রী শ্রী গিরি গোবর্ধন পূজা ও অন্নকূট মহোৎসব অনুষ্ঠিত হয়েছে। মঙ্গলবার (১৭ নভেম্বর) চন্দ্রঘোনা মিশন এলাকার শ্রী শ্রী গৌর নিতাই নামহট্ট প্রচার কেন্দ্র ইসকন মন্দির প্রাঙ্গণে দিনব্যাপী নানা ধর্মীয় ও সাংস্কৃতিক অনুষ্ঠ&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%95%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%87%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%97%e0%a6%bf%e0%a6%b0%e0%a6%bf-%e0%a6%97%e0%a7%8b%e0%a6%ac%e0%a6%b0%e0%a7%8d%e0%a6%a7%e0%a6%a8/">পাহাড়বার্তা</source>
    </item>

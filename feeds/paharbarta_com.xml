      <enclosure url="https://paharbarta.com/wp-content/uploads/00138501.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/00138501.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/00138501.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="খাগড়াছড়িতে হাসপাতালের সামনে জিপে আগুন, ক্ষতি ৫ লাখ টাকা" /&gt;&lt;/p&gt;&lt;p&gt;খাগড়াছড়ি পৌর শহরের পানখাইয়া পাড়া রোডে কে এইচ টি সি হাসপাতালের সামনে দাঁড়িয়ে থাকা একটি জিপ গাড়িতে আগুন দিয়েছে দুর্বৃত্তরা। এতে গাড়িটি পুড়ে ব্যাপক ক্ষয়ক্ষতি হয়েছে। তবে কারা এবং কী কারণে গাড়িটিতে আগুন দিয়েছে, তা এখনো শনাক্ত করা যায়নি। আজ মঙ্গলবার (১০ নভেম্বর) রাতে হাসপাতালের সামনে এ ঘটনা ঘটে। স্থানীয় স&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%96%e0%a6%be%e0%a6%97%e0%a6%a1%e0%a6%bc%e0%a6%be%e0%a6%9b%e0%a6%a1%e0%a6%bc%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%aa%e0%a6%be%e0%a6%a4%e0%a6%be%e0%a6%b2%e0%a7%87%e0%a6%b0/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>মানবেন্দ্র নারায়ণ লারমা ছিলো পাহাড়ে জুম্মজাতির অগ্রদূত</title>
      <link>https://paharbarta.com/%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a6%ac%e0%a7%87%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a7%8d%e0%a6%b0-%e0%a6%a8%e0%a6%be%e0%a6%b0%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a6%a3-%e0%a6%b2%e0%a6%be%e0%a6%b0%e0%a6%ae%e0%a6%be/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a6%ac%e0%a7%87%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a7%8d%e0%a6%b0-%e0%a6%a8%e0%a6%be%e0%a6%b0%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a6%a3-%e0%a6%b2%e0%a6%be%e0%a6%b0%e0%a6%ae%e0%a6%be/</guid>
      <pubDate>Tue, 10 Nov 2026 12:05:23 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/1000138501.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/1000138501.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/1000138501.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মানবেন্দ্র নারায়ণ লারমা ছিলো পাহাড়ে জুম্মজাতির অগ্রদূত" /&gt;&lt;/p&gt;&lt;p&gt;সাবেক সংসদ সদস্য মানবেন্দ্র নারায়ণ লারমা (এমএন লারমা)-র ৪৩তম মৃত্যুবার্ষিকীতে র‍্যালী ও স্মরণ সভা করেছে করেছে পার্বত্য চট্টগ্রাম জনসংহতি সমিতি (জেএসএস এমএন লারমা)। আজ মঙ্গলবার (১০ নভেম্বর ২০২৬) সকালে চেঙ্গি স্কয়ারে প্রভাতফেরী শেষে ফুলেল শ্রদ্ধা জানায় সংগঠনটি। এ সময় সহযোগি সংগঠনগুলো একে একে এই নেতার &lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a6%ac%e0%a7%87%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a7%8d%e0%a6%b0-%e0%a6%a8%e0%a6%be%e0%a6%b0%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a6%a3-%e0%a6%b2%e0%a6%be%e0%a6%b0%e0%a6%ae%e0%a6%be/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>কাপ্তাইয়ে এনএসআই সদস্য পরিচয়ে চাঁদা আদায়কারী আটক</title>
      <link>https://paharbarta.com/%e0%a6%95%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%87%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%8f%e0%a6%a8%e0%a6%8f%e0%a6%b8%e0%a6%86%e0%a6%87-%e0%a6%b8%e0%a6%a6%e0%a6%b8%e0%a7%8d%e0%a6%af/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%95%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%87%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%8f%e0%a6%a8%e0%a6%8f%e0%a6%b8%e0%a6%86%e0%a6%87-%e0%a6%b8%e0%a6%a6%e0%a6%b8%e0%a7%8d%e0%a6%af/</guid>
      <pubDate>Tue, 10 Nov 2026 11:58:58 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/কারাগার-1-e1586792984482.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/কারাগার-1-e1586792984482.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/কারাগার-1-e1586792984482.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কাপ্তাইয়ে এনএসআই সদস্য পরিচয়ে চাঁদা আদায়কারী আটক" /&gt;&lt;/p&gt;&lt;p&gt;রাঙামাটির কাপ্তাইয়ে জাতীয় নিরাপত্তা গোয়েন্দা সংস্থার (এনএসআই) সদস্য পরিচয়ে একটি ব্যবসাপ্রতিষ্ঠান থেকে দীর্ঘ চার মাস ধরে মাসিক ১০ হাজার টাকা করে চাঁদা আদায়ের অভিযোগে মোহাম্মদ সাইদুর রহমান (৩০) নামে এক ব্যক্তিকে আটক করেছে পুলিশ। আজ মঙ্গলবার (১০ নভেম্বর) কাপ্তাই উপজেলার রাইখালী ইউনিয়নের ৩ নম্বর ওয়ার্ডে&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%95%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%87%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%8f%e0%a6%a8%e0%a6%8f%e0%a6%b8%e0%a6%86%e0%a6%87-%e0%a6%b8%e0%a6%a6%e0%a6%b8%e0%a7%8d%e0%a6%af/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>রোয়াংছড়িতে আগুনে পুড়েছে ১৬ বসতঘর</title>
      <link>https://paharbarta.com/%e0%a6%b0%e0%a7%8b%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%82%e0%a6%9b%e0%a6%a1%e0%a6%bc%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%86%e0%a6%97%e0%a7%81%e0%a6%a8%e0%a7%87-%e0%a6%aa%e0%a7%81%e0%a6%a1%e0%a6%bc-2/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%b0%e0%a7%8b%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%82%e0%a6%9b%e0%a6%a1%e0%a6%bc%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%86%e0%a6%97%e0%a7%81%e0%a6%a8%e0%a7%87-%e0%a6%aa%e0%a7%81%e0%a6%a1%e0%a6%bc-2/</guid>
      <pubDate>Tue, 10 Nov 2026 05:57:47 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/FB_IMG_1794284140191-scaled-e1794313288651.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/FB_IMG_1794284140191-scaled-e1794313288651.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/FB_IMG_1794284140191-scaled-e1794313288651.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রোয়াংছড়িতে আগুনে পুড়েছে ১৬ বসতঘর" /&gt;&lt;/p&gt;&lt;p&gt;বান্দরবানের রোয়াংছড়ি উপজেলার তারাছা ইউনিয়নের বড়ইতলী মার্মা পাড়ায় অগ্নিকাণ্ডে ১৬টি বসতঘর ও দুটি দোকান পুড়ে ছাই হয়ে গেছে। স্থানীয় সূত্রে জানা গেছে, সোমবার (৯ নভেম্বর) দিবাগত রাত ১১টার দিকে ইউনিয়নের ৪ নম্বর ওয়ার্ডের এ পাড়ায় আগুন লাগে। স্থানীয় বাসিন্দাদের প্রায় দুই ঘণ্টার চেষ্টায় আগুন নিয়ন্ত্রণে আসে। স্&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%b0%e0%a7%8b%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%82%e0%a6%9b%e0%a6%a1%e0%a6%bc%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%86%e0%a6%97%e0%a7%81%e0%a6%a8%e0%a7%87-%e0%a6%aa%e0%a7%81%e0%a6%a1%e0%a6%bc-2/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>থানচিতে প্রত্যাবর্তিত বম পরিবারের চিকিৎসা সেবায় সেনাবাহিনী</title>
      <link>https://paharbarta.com/%e0%a6%a5%e0%a6%be%e0%a6%a8%e0%a6%9a%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%ac%e0%a6%b0%e0%a7%8d%e0%a6%a4%e0%a6%bf%e0%a6%a4-%e0%a6%ac%e0%a6%ae/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%a5%e0%a6%be%e0%a6%a8%e0%a6%9a%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%ac%e0%a6%b0%e0%a7%8d%e0%a6%a4%e0%a6%bf%e0%a6%a4-%e0%a6%ac%e0%a6%ae/</guid>
      <pubDate>Mon, 09 Nov 2026 11:59:17 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/1000424831.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/1000424831.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/1000424831.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="থানচিতে প্রত্যাবর্তিত বম পরিবারের চিকিৎসা সেবায় সেনাবাহিনী" /&gt;&lt;/p&gt;&lt;p&gt;আসন্ন বড়দিন উদ্‌যাপনের প্রস্তুতি ও শারীরিক সুরক্ষা নিশ্চিত করতে সম্প্রতিকালে ভারতে মিজোরাম হতে প্রত্যাবর্তীত এবং বান্দরবানের থানচি ও রুমা দুই উপজেলার সীমান্তে বসবাসরত থানচি লিটক্রে সড়কের পাশে ২২ কিলোমিটার দুর্গম থান্দুই পাড়ায় প্রত্যাবর্তিত বম পরিবারসহ স্থানীয়দের বিনামূল্যে চিকিৎসাসেবা ও মানবিক সহায়ত&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%a5%e0%a6%be%e0%a6%a8%e0%a6%9a%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%ac%e0%a6%b0%e0%a7%8d%e0%a6%a4%e0%a6%bf%e0%a6%a4-%e0%a6%ac%e0%a6%ae/">পাহাড়বার্তা</source>
    </item>

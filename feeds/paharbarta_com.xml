    <item>
      <title>কাপ্তাইয়ে নজরুলের জীবন ও সৃষ্টিকর্ম নিয়ে সাংস্কৃতিক অনুষ্ঠান ও আলোকচিত্র প্রদর্শনী</title>
      <link>https://paharbarta.com/%e0%a6%95%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%87%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%a8%e0%a6%9c%e0%a6%b0%e0%a7%81%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a6%9c%e0%a7%80%e0%a6%ac%e0%a6%a8/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%95%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%87%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%a8%e0%a6%9c%e0%a6%b0%e0%a7%81%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a6%9c%e0%a7%80%e0%a6%ac%e0%a6%a8/</guid>
      <pubDate>Thu, 12 Nov 2026 12:49:26 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/295750.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/295750.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/295750.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কাপ্তাইয়ে নজরুলের জীবন ও সৃষ্টিকর্ম নিয়ে সাংস্কৃতিক অনুষ্ঠান ও আলোকচিত্র প্রদর্শনী" /&gt;&lt;/p&gt;&lt;p&gt;জাতীয় কবি কাজী নজরুল ইসলামের জীবন, সাহিত্য ও সৃষ্টিকর্ম নতুন প্রজন্মের কাছে তুলে ধরতে রাঙামাটির কাপ্তাইয়ে নজরুল বর্ষ উদযাপন উপলক্ষে সাংস্কৃতিক অনুষ্ঠান ও আলোকচিত্র প্রদর্শনীর আয়োজন করা হয়েছে। আজ বৃহস্পতিবার (১২ নভেম্বর) বিকেল সাড়ে ৩টা থেকে সন্ধ্যা ৬টা পর্যন্ত কাপ্তাই উপজেলা পরিষদ মিলনায়তনে সংস্কৃতিব&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%95%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%87%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%a8%e0%a6%9c%e0%a6%b0%e0%a7%81%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a6%9c%e0%a7%80%e0%a6%ac%e0%a6%a8/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>খাগড়াছড়িতে সমাজসেবা ও ভূমি অফিসে রহস্যজনক অগ্নিকাণ্ড</title>
      <link>https://paharbarta.com/%e0%a6%96%e0%a6%be%e0%a6%97%e0%a6%a1%e0%a6%bc%e0%a6%be%e0%a6%9b%e0%a6%a1%e0%a6%bc%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%b8%e0%a6%ae%e0%a6%be%e0%a6%9c%e0%a6%b8%e0%a7%87%e0%a6%ac%e0%a6%be-%e0%a6%93/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%96%e0%a6%be%e0%a6%97%e0%a6%a1%e0%a6%bc%e0%a6%be%e0%a6%9b%e0%a6%a1%e0%a6%bc%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%b8%e0%a6%ae%e0%a6%be%e0%a6%9c%e0%a6%b8%e0%a7%87%e0%a6%ac%e0%a6%be-%e0%a6%93/</guid>
      <pubDate>Thu, 12 Nov 2026 12:41:25 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/file_00000000da60820a98f017ec2812308d-copy.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/file_00000000da60820a98f017ec2812308d-copy.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/file_00000000da60820a98f017ec2812308d-copy.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="খাগড়াছড়িতে সমাজসেবা ও ভূমি অফিসে রহস্যজনক অগ্নিকাণ্ড" /&gt;&lt;/p&gt;&lt;p&gt;খাগড়াছড়ি সদর উপজেলা সমাজসেবা কার্যালয় এবং ভূমি অফিসে গভীর রাতে রহস্যজনক অগ্নিকাণ্ডের ঘটনা ঘটেছে। এ ঘটনায় ভূমি অফিসের বেশ কিছু গুরুত্বপূর্ণ নথি এবং সমাজসেবা কার্যালয়ের আসবাবপত্রসহ বিভিন্ন দামি সরঞ্জাম পুড়ে গেছে। ​গতকাল বুধবার দিবাগত রাত পৌনে ৩টার দিকে সদর উপজেলা পরিষদের এই কার্যালয় দুটিতে এই অগ্নিকাণ&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%96%e0%a6%be%e0%a6%97%e0%a6%a1%e0%a6%bc%e0%a6%be%e0%a6%9b%e0%a6%a1%e0%a6%bc%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%b8%e0%a6%ae%e0%a6%be%e0%a6%9c%e0%a6%b8%e0%a7%87%e0%a6%ac%e0%a6%be-%e0%a6%93/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>রোয়াংছড়ির বড়ইতলীর অগ্নিকাণ্ডে ক্ষতিগ্রস্থদের পাশে বান্দরবান প্রেসক্লাব</title>
      <link>https://paharbarta.com/%e0%a6%b0%e0%a7%8b%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%82%e0%a6%9b%e0%a6%a1%e0%a6%bc%e0%a6%bf%e0%a6%b0-%e0%a6%ac%e0%a6%a1%e0%a6%bc%e0%a6%87%e0%a6%a4%e0%a6%b2%e0%a7%80%e0%a6%b0-%e0%a6%85%e0%a6%97%e0%a7%8d/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%b0%e0%a7%8b%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%82%e0%a6%9b%e0%a6%a1%e0%a6%bc%e0%a6%bf%e0%a6%b0-%e0%a6%ac%e0%a6%a1%e0%a6%bc%e0%a6%87%e0%a6%a4%e0%a6%b2%e0%a7%80%e0%a6%b0-%e0%a6%85%e0%a6%97%e0%a7%8d/</guid>
      <pubDate>Thu, 12 Nov 2026 12:35:12 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/Pic-Bandarban-Press-Club-1-1.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/Pic-Bandarban-Press-Club-1-1.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/Pic-Bandarban-Press-Club-1-1.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রোয়াংছড়ির বড়ইতলীর অগ্নিকাণ্ডে ক্ষতিগ্রস্থদের পাশে বান্দরবান প্রেসক্লাব" /&gt;&lt;/p&gt;&lt;p&gt;বান্দরবানের রোয়াংছড়ি উপজেলার ২নং তারাছা ইউনিয়নের বড়ইতলী পাড়ায় ভয়াবহ অগ্নিকাণ্ডে ক্ষতিগ্রস্থ পরিবারের পাশে বান্দরবান প্রেসক্লাব। আজ বৃহস্পতিবার (১২ নভেম্বর) সকালে বান্দরবান প্রেসক্লাবের উদ্যোগে তারাছা ইউনিয়নের বড়ইতলী পাড়ায় ভয়াবহ অগ্নিকাণ্ডে ক্ষতিগ্রস্থ পরিবারের সদস্যদের মাঝে বিভিন্ন শীতবস্ত্র ও শিক্ষ&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%b0%e0%a7%8b%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%82%e0%a6%9b%e0%a6%a1%e0%a6%bc%e0%a6%bf%e0%a6%b0-%e0%a6%ac%e0%a6%a1%e0%a6%bc%e0%a6%87%e0%a6%a4%e0%a6%b2%e0%a7%80%e0%a6%b0-%e0%a6%85%e0%a6%97%e0%a7%8d/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>দুর্গম বড় মদকে প্রাণে বাঁচলেন প্রসূতি মা ও নবজাতক</title>
      <link>https://paharbarta.com/%e0%a6%a6%e0%a7%81%e0%a6%b0%e0%a7%8d%e0%a6%97%e0%a6%ae-%e0%a6%ac%e0%a6%a1%e0%a6%bc-%e0%a6%ae%e0%a6%a6%e0%a6%95%e0%a7%87-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%a3%e0%a7%87-%e0%a6%ac%e0%a6%be/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%a6%e0%a7%81%e0%a6%b0%e0%a7%8d%e0%a6%97%e0%a6%ae-%e0%a6%ac%e0%a6%a1%e0%a6%bc-%e0%a6%ae%e0%a6%a6%e0%a6%95%e0%a7%87-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%a3%e0%a7%87-%e0%a6%ac%e0%a6%be/</guid>
      <pubDate>Wed, 11 Nov 2026 11:38:12 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/1000428014.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/1000428014.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/1000428014.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দুর্গম বড় মদকে প্রাণে বাঁচলেন প্রসূতি মা ও নবজাতক" /&gt;&lt;/p&gt;&lt;p&gt;বান্দরবানের থানচি উপজেলার দুর্গম বড় মদক এলাকায় প্রসবকালীন জটিলতায় পড়া এক প্রসূতি মা ও নবজাতককে প্রাণে রক্ষা করা হয়েছে। রাতের আঁধারে প্রায় ৭০ কিলোমিটার সাঙ্গু নদীপথ পাড়ি দিয়ে প্রথমে থানচি উপজেলা স্বাস্থ্য কমপ্লেক্স এবং পরে বান্দরবান জেলা সদরের হাসপাতালে নেওয়া হয় ওই প্রসূতিকে। স্থানীয় বেসরকারি উন্নয়ন &lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%a6%e0%a7%81%e0%a6%b0%e0%a7%8d%e0%a6%97%e0%a6%ae-%e0%a6%ac%e0%a6%a1%e0%a6%bc-%e0%a6%ae%e0%a6%a6%e0%a6%95%e0%a7%87-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%a3%e0%a7%87-%e0%a6%ac%e0%a6%be/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>পাহাড়ি শিক্ষার্থীদের মাঝে একাদশ শ্রেণির বই ও শিক্ষাসামগ্রী বিতরণ</title>
      <link>https://paharbarta.com/%e0%a6%aa%e0%a6%be%e0%a6%b9%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a6%bf-%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%a5%e0%a7%80%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a6%be/</link>
      <guid isPermaLink="true">https://paharbarta.com/%e0%a6%aa%e0%a6%be%e0%a6%b9%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a6%bf-%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%a5%e0%a7%80%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a6%be/</guid>
      <pubDate>Wed, 11 Nov 2026 11:33:39 +0000</pubDate>
      <enclosure url="https://paharbarta.com/wp-content/uploads/IMG-20261111-WA0015.jpg" length="0" type="image/jpeg" />
      <media:content url="https://paharbarta.com/wp-content/uploads/IMG-20261111-WA0015.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://paharbarta.com/wp-content/uploads/IMG-20261111-WA0015.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পাহাড়ি শিক্ষার্থীদের মাঝে একাদশ শ্রেণির বই ও শিক্ষাসামগ্রী বিতরণ" /&gt;&lt;/p&gt;&lt;p&gt;খাগড়াছড়ির মাটিরাঙ্গায় দূরবর্তী ও দুর্গম এলাকার দরিদ্র পাহাড়ি শিক্ষার্থীদের পড়াশোনা চালিয়ে যেতে সহায়তার হাত বাড়িয়ে দিয়েছে বাংলাদেশ সেনাবাহিনী। ১৮ ফিল্ড রেজিমেন্ট আর্টিলারি মাটিরাঙ্গা জোনের উদ্যোগে দরিদ্র ও মেধাবী ছাত্র-ছাত্রীদের মাঝে শিক্ষাসামগ্রী বিতরণ করা হয়েছে। ​আজ বুধবার (১২ নভেম্বর) মাটিরাঙ্গা জ&lt;/p&gt;</description>
      <source url="https://paharbarta.com/%e0%a6%aa%e0%a6%be%e0%a6%b9%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a6%bf-%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%a5%e0%a7%80%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a6%be/">পাহাড়বার্তা</source>
    </item>
    <item>
      <title>রাইখালীতে চেয়ারম্যান পদে প্রার্থী হবে তরুন রাজনীতিবিদ বিশু তঞ্চঙ্গ্যা</title>
      <link>https://paharbarta.com/%e0%a6%b0%e0%a6%be%e0%a6%87%e0%a6%96%e0%a6%be%e0%a6%b2%e0%a7%80%e0%a6%a4%e0%a7%87-%e0%a6%9a%e0%a7%87%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0%e0%a6%ae%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%a8-%e0%a6%aa%e0%a6%a6/</link>

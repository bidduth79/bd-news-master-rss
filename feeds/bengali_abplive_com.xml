      <pubDate>Fri, 27 Nov 2026 00:02:36 +0530 </pubDate>
      <enclosure url="https://feeds.abplive.com/onecms/images/uploaded-images/2026/11/26/8a756af94cbbe6ee6c12c648095e853a1795717788938484_original.jpg" length="0" type="image/jpeg" />

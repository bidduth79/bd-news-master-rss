      <source url="https://bengali.abplive.com/entertainment/sadhak-bamakhepa-controversy-cm-suvendu-adhikari-tollywood-industry-meet-rudranil-ghosh-rituparna-sengupta-adhir-chowdhury-on-bengal-cinema-prime-time-1200234">states</source>

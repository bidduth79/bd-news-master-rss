      <pubDate>Tue, 17 Nov 2026 19:24:17 +0530 </pubDate>
      <enclosure url="https://feeds.abplive.com/onecms/images/uploaded-images/2026/11/17/ae277477befb5a5a5f4f85c12b736f351794924023827484_original.jpg" length="0" type="image/jpeg" />

      <guid isPermaLink="true">https://www.nytimes.com/2026/11/23/technology/jensen-huang-nvidia-board-trump.html</guid>
      <pubDate>Tue, 24 Nov 2026 15:40:13 +0000</pubDate>
      <enclosure url="https://static01.nyt.com/images/2026/11/23/multimedia/23biz-nvidia-board-1-hjlv/23biz-nvidia-board-1-hjlv-mediumSquareAt3X.jpg" length="0" type="image/jpeg" />

      <guid isPermaLink="true">https://www.nytimes.com/2026/11/21/world/americas/mexico-captures-drug-kingpin.html</guid>
      <pubDate>Sun, 22 Nov 2026 01:56:16 +0000</pubDate>
      <enclosure url="https://static01.nyt.com/images/2026/11/22/multimedia/22int-cartel-ticktock-photo1-bpwm/22int-cartel-ticktock-photo1-bpwm-mediumSquareAt3X.jpg" length="0" type="image/jpeg" />

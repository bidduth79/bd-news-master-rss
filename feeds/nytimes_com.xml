      <pubDate>Thu, 26 Nov 2026 14:06:46 +0000</pubDate>
      <enclosure url="https://static01.nyt.com/images/2026/11/26/multimedia/26xp-Thanksgiving-Parade-Balloons-02-kvzp/26xp-Thanksgiving-Parade-Balloons-02-kvzp-mediumSquareAt3X.jpg" length="0" type="image/jpeg" />

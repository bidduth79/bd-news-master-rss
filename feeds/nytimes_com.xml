      <pubDate>Thu, 26 Nov 2026 20:21:00 +0000</pubDate>
      <enclosure url="https://static01.nyt.com/images/2026/11/25/multimedia/25parade-live-marching-band-gfqm/25parade-live-marching-band-gfqm-mediumSquareAt3X.jpg" length="0" type="image/jpeg" />

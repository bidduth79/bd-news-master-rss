      <pubDate>Sun, 22 Nov 2026 12:30:24 +0000</pubDate>
      <enclosure url="https://static01.nyt.com/images/2026/11/22/multimedia/22pol-gop-reflection-SWAP-mblz/22pol-gop-reflection-SWAP-mblz-mediumSquareAt3X.jpg" length="0" type="image/jpeg" />

      <pubDate>Sat, 14 Nov 2026 20:48:54 +0000</pubDate>
      <enclosure url="https://static01.nyt.com/images/2026/11/14/multimedia/14faa-groundstop-bouncing-back-topart-ztjq/14faa-groundstop-bouncing-back-topart-ztjq-mediumSquareAt3X.jpg" length="0" type="image/jpeg" />

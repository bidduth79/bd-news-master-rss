    <item>
      <title>তিনটি ২০০ মেগাপিক্সেল ক্যামেরার ফোন Oppo Find X10 Ultra</title>
      <link>https://zoombangla.com/%e0%a6%a4%e0%a6%bf%e0%a6%a8%e0%a6%9f%e0%a6%bf-%e0%a7%a8%e0%a7%a6%e0%a7%a6-%e0%a6%ae%e0%a7%87%e0%a6%97%e0%a6%be%e0%a6%aa%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b8%e0%a7%87%e0%a6%b2-%e0%a6%95%e0%a7%8d/</link>

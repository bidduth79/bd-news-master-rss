      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/image_353392_1795485975.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/image_353392_1795485975.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৯১ রানে অলআউট হয়ে ৫ রেকর্ড করল টাইগাররা" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ ক্রিকেটের উত্থান-পতনের গল্প যেন থামছেই না। জোহানেসবার্গের ওয়ান্ডারার্সে ৪০০ রানের ঐতিহাসিক ইনিংস খেলার এক সপ্তাহ না পেরোতেই আবারও চরম ব্যাটিং বিপর্যয়ে পড়েছে বাংলাদেশ। দক্ষিণ আফ্রিকার বিপক্ষে সেঞ্চুরিয়নে দ্বিতীয় টেস্টের প্রথম ইনিংসে মাত্র ৯১ রানেই অলআউট হয়েছে নাজমুল হোসেন শান্তর দল। আর এই ব্&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a7%af%e0%a7%a7-%e0%a6%b0%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%85%e0%a6%b2%e0%a6%86%e0%a6%89%e0%a6%9f-%e0%a6%b9%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a7%ab/">জুমবাংলা</source>
    </item>
    <item>
      <title>দেশের চলমান পরিস্থিতি নিয়ে মঙ্গলবার কূটনীতিকদের ব্রিফ করবে সরকার</title>
      <link>https://zoombangla.com/%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%87%e0%a6%b0-%e0%a6%9a%e0%a6%b2%e0%a6%ae%e0%a6%be%e0%a6%a8-%e0%a6%aa%e0%a6%b0%e0%a6%bf%e0%a6%b8%e0%a7%8d%e0%a6%a5%e0%a6%bf%e0%a6%a4%e0%a6%bf/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%87%e0%a6%b0-%e0%a6%9a%e0%a6%b2%e0%a6%ae%e0%a6%be%e0%a6%a8-%e0%a6%aa%e0%a6%b0%e0%a6%bf%e0%a6%b8%e0%a7%8d%e0%a6%a5%e0%a6%bf%e0%a6%a4%e0%a6%bf/</guid>
      <pubDate>Mon, 23 Nov 2026 18:45:45 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%B2%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BF%E0%A6%A4%E0%A6%BF.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%B2%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BF%E0%A6%A4%E0%A6%BF.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%B2%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BF%E0%A6%A4%E0%A6%BF.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দেশের চলমান পরিস্থিতি নিয়ে মঙ্গলবার কূটনীতিকদের ব্রিফ করবে সরকার" /&gt;&lt;/p&gt;&lt;p&gt;দেশের চলমান পরিস্থিতি নিয়ে ঢাকায় বিদেশি কূটনৈতিক মিশনের প্রতিনিধিদের ব্রিফ করবে সরকার। একই সঙ্গে প্রস্তাবিত সাইবার সুরক্ষা (সংশোধন) আইনের সংশোধিত খসড়া নিয়েও বিদেশি কূটনীতিকদের ব্রিফ করা হবে। মঙ্গলবার (২৪ নভেম্বর) সকালে পররাষ্ট্র মন্ত্রণালয়ে এই ব্রিফিং হবে। শুরুতে পররাষ্ট্র প্রতিমন্ত্রী হুমায়ুন কবির &lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%87%e0%a6%b0-%e0%a6%9a%e0%a6%b2%e0%a6%ae%e0%a6%be%e0%a6%a8-%e0%a6%aa%e0%a6%b0%e0%a6%bf%e0%a6%b8%e0%a7%8d%e0%a6%a5%e0%a6%bf%e0%a6%a4%e0%a6%bf/">জুমবাংলা</source>
    </item>
    <item>
      <title>গোপালগঞ্জে কার্যক্রম নিষিদ্ধ আ.লীগের দুই গ্রুপের তুমুল সংঘর্ষ</title>
      <link>https://zoombangla.com/%e0%a6%97%e0%a7%8b%e0%a6%aa%e0%a6%be%e0%a6%b2%e0%a6%97%e0%a6%9e%e0%a7%8d%e0%a6%9c%e0%a7%87-%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%95%e0%a7%8d%e0%a6%b0%e0%a6%ae/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%97%e0%a7%8b%e0%a6%aa%e0%a6%be%e0%a6%b2%e0%a6%97%e0%a6%9e%e0%a7%8d%e0%a6%9c%e0%a7%87-%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%95%e0%a7%8d%e0%a6%b0%e0%a6%ae/</guid>
      <pubDate>Mon, 23 Nov 2026 18:39:08 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গোপালগঞ্জে কার্যক্রম নিষিদ্ধ আ.লীগের দুই গ্রুপের তুমুল সংঘর্ষ" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জে কার্যক্রম নিষিদ্ধ আওয়ামী লীগের দুই গ্রুপের মধ্যে সংঘর্ষে অন্তত ২০ জন আহত হয়েছেন। এ সময় ককটেল বিস্ফোরণ ও কয়েকটি দোকান ভাঙচুরের ঘটনা ঘটে। সোমবার (২৩ নভেম্বর) রাতে জেলা শহরের গোপালগঞ্জ ক্রিকেট স্টেডিয়াম সংলগ্ন সড়কে সদর উপজেলার চরমানিকদাহ ও ঘোষেরচর গ্রামের আওয়ামী লীগের কর্মী-সমর্থকদের মধ্যে এ&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%97%e0%a7%8b%e0%a6%aa%e0%a6%be%e0%a6%b2%e0%a6%97%e0%a6%9e%e0%a7%8d%e0%a6%9c%e0%a7%87-%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%95%e0%a7%8d%e0%a6%b0%e0%a6%ae/">জুমবাংলা</source>
    </item>
    <item>
      <title>মঙ্গলবার স্বর্ণদ্বীপ যাচ্ছেন প্রধানমন্ত্রী তারেক রহমান</title>
      <link>https://zoombangla.com/%e0%a6%ae%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a6%b2%e0%a6%ac%e0%a6%be%e0%a6%b0-%e0%a6%b8%e0%a7%8d%e0%a6%ac%e0%a6%b0%e0%a7%8d%e0%a6%a3%e0%a6%a6%e0%a7%8d%e0%a6%ac%e0%a7%80%e0%a6%aa/</link>

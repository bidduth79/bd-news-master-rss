      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/InShot_20261121_194654808.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/InShot_20261121_194654808.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/InShot_20261121_194654808.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দৌলতপুরে গভীর রাতে গ্রামীণ ব্যাংকে অগ্নিকাণ্ড" /&gt;&lt;/p&gt;&lt;p&gt;সাইফুল ইসলাম: মানিকগঞ্জের দৌলতপুরে গ্রামীণ ব্যাংকের উপজেলা শাখায় অগ্নিকাণ্ডের ঘটনা ঘটেছে। তবে দ্রুত আগুন নিয়ন্ত্রণে আনায় কোনো ধরনের আর্থিক বা অবকাঠামোগত ক্ষয়ক্ষতি হয়নি। শনিবার (২১ নভেম্বর) রাত আনুমানিক পৌনে তিনটার দিকে ব্যাংক ভবনে এ ঘটনা ঘটে। ব্যাংক ও স্থানীয় সূত্রে জানা গেছে, শুক্রবার রাত ১২টার দিক&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%a6%e0%a7%8c%e0%a6%b2%e0%a6%a4%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87-%e0%a6%97%e0%a6%ad%e0%a7%80%e0%a6%b0-%e0%a6%b0%e0%a6%be%e0%a6%a4%e0%a7%87/">জুমবাংলা</source>
    </item>
    <item>
      <title>মানিকগঞ্জ সাংবাদিক সমিতির সভাপতি মতিউর, সম্পাদক সুজন</title>
      <link>https://zoombangla.com/%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a6%bf%e0%a6%95%e0%a6%97%e0%a6%9e%e0%a7%8d%e0%a6%9c-%e0%a6%b8%e0%a6%be%e0%a6%82%e0%a6%ac%e0%a6%be%e0%a6%a6%e0%a6%bf%e0%a6%95/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a6%bf%e0%a6%95%e0%a6%97%e0%a6%9e%e0%a7%8d%e0%a6%9c-%e0%a6%b8%e0%a6%be%e0%a6%82%e0%a6%ac%e0%a6%be%e0%a6%a6%e0%a6%bf%e0%a6%95/</guid>
      <pubDate>Sat, 21 Nov 2026 13:20:08 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/IMG_20261121_191700-scaled.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/IMG_20261121_191700-scaled.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/IMG_20261121_191700-scaled.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মানিকগঞ্জ সাংবাদিক সমিতির সভাপতি মতিউর, সম্পাদক সুজন" /&gt;&lt;/p&gt;&lt;p&gt;সাইফুল ইসলাম: বাংলাদেশ সাংবাদিক সমিতি (বাসাস) মানিকগঞ্জ জেলা শাখার ত্রিবার্ষিক নির্বাচনে সভাপতি নির্বাচিত হয়েছেন দৈনিক যুগান্তরের স্টাফ রিপোর্টার মতিউর রহমান এবং সাধারণ সম্পাদক হয়েছেন এটিএন বাংলার জেলা প্রতিনিধি শহীদুল ইসলাম সুজন। শনিবার (২১ নভেম্বর) দুপুরে মানিকগঞ্জ জেলা ক্রীড়া সংস্থা মিলনায়তনে সমি&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a6%bf%e0%a6%95%e0%a6%97%e0%a6%9e%e0%a7%8d%e0%a6%9c-%e0%a6%b8%e0%a6%be%e0%a6%82%e0%a6%ac%e0%a6%be%e0%a6%a6%e0%a6%bf%e0%a6%95/">জুমবাংলা</source>
    </item>
    <item>
      <title>কে হচ্ছেন নতুন জেমস বন্ডের নায়িকা</title>
      <link>https://zoombangla.com/%e0%a6%95%e0%a7%87-%e0%a6%b9%e0%a6%9a%e0%a7%8d%e0%a6%9b%e0%a7%87%e0%a6%a8-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%9c%e0%a7%87%e0%a6%ae%e0%a6%b8/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%95%e0%a7%87-%e0%a6%b9%e0%a6%9a%e0%a7%8d%e0%a6%9b%e0%a7%87%e0%a6%a8-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%9c%e0%a7%87%e0%a6%ae%e0%a6%b8/</guid>
      <pubDate>Sat, 21 Nov 2026 12:35:24 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Nayika-6-scaled.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Nayika-6-scaled.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Nayika-6-scaled.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কে হচ্ছেন নতুন জেমস বন্ডের নায়িকা" /&gt;&lt;/p&gt;&lt;p&gt;নতুন জেমস বন্ড হিসেবে রবার্ট প্যাটিনসনের নাম ঘোষণার পর আলোচনা শুরু হয়েছে তার নায়িকা কে হচ্ছেন, তা নিয়ে। হলিউডের বেশ কয়েকজন জনপ্রিয় অভিনেত্রীর নাম শোনা গেলেও এখনো কাউকে চূড়ান্ত করা হয়নি। গেল ১৬ নভেম্বর প্যাটিনসনকে নতুন জেমস বন্ড হিসেবে ঘোষণা করে অ্যামাজন এমজিএম স্টুডিওস। এরপর থেকেই তার বিপরীতে কে অভি&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%95%e0%a7%87-%e0%a6%b9%e0%a6%9a%e0%a7%8d%e0%a6%9b%e0%a7%87%e0%a6%a8-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%9c%e0%a7%87%e0%a6%ae%e0%a6%b8/">জুমবাংলা</source>
    </item>
    <item>
      <title>দুই বছরের মধ্যে সর্বনিম্ন দামে বিটকয়েন</title>
      <link>https://zoombangla.com/%e0%a6%a6%e0%a7%81%e0%a6%87-%e0%a6%ac%e0%a6%9b%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a6%a7%e0%a7%8d%e0%a6%af%e0%a7%87/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%a6%e0%a7%81%e0%a6%87-%e0%a6%ac%e0%a6%9b%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a6%a7%e0%a7%8d%e0%a6%af%e0%a7%87/</guid>
      <pubDate>Sat, 21 Nov 2026 12:30:12 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Bit.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Bit.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Bit.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দুই বছরের মধ্যে সর্বনিম্ন দামে বিটকয়েন" /&gt;&lt;/p&gt;&lt;p&gt;কৃত্রিম বুদ্ধিমত্তা খাতের শেয়ারের অতিরিক্ত মূল্যায়ন নিয়ে উদ্বেগের প্রভাব পড়েছে বৈশ্বিক বিনিয়োগ বাজারে। এর জেরে বিশ্বের সবচেয়ে বড় ক্রিপ্টোকারেন্সি বিটকয়েনের দাম কমে গত দুই বছরের মধ্যে সর্বনিম্ন পর্যায়ে নেমেছে। শুক্রবার (২০ নভেম্বর) যুক্তরাষ্ট্রের স্থানীয় সময় রাত ১১টা ১৩ মিনিটে বিটকয়েনের দাম ৫ দশমিক ১&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%a6%e0%a7%81%e0%a6%87-%e0%a6%ac%e0%a6%9b%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a6%a7%e0%a7%8d%e0%a6%af%e0%a7%87/">জুমবাংলা</source>
    </item>

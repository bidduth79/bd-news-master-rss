      <pubDate>Mon, 23 Nov 2026 17:32:58 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%8F%E0%A6%B6%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AD%E0%A6%BE%E0%A6%AC-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%A6%E0%A7%87%E0%A6%B6.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%8F%E0%A6%B6%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AD%E0%A6%BE%E0%A6%AC-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%A6%E0%A7%87%E0%A6%B6.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%8F%E0%A6%B6%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AD%E0%A6%BE%E0%A6%AC-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%A6%E0%A7%87%E0%A6%B6.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এশিয়ায় প্রভাব বিস্তারকারী দেশগুলোর নতুন তালিকা প্রকাশ, বাংলাদেশের অবস্থান ২০তম" /&gt;&lt;/p&gt;&lt;p&gt;এশিয়া ও ইন্দো-প্যাসিফিক অঞ্চলে প্রভাব বিস্তারকারী দেশগুলোর নতুন তালিকা প্রকাশ করেছে অস্ট্রেলিয়াভিত্তিক গবেষণা প্রতিষ্ঠান লোই ইনস্টিটিউট। ২০২৬ সালের এশিয়া পাওয়ার ইনডেক্সে ২৭টি দেশ ও অঞ্চলের মধ্যে বাংলাদেশের অবস্থান ২০তম। সূচকে বাংলাদেশের স্কোর ৮ দশমিক ৯। গত বছরের তুলনায় অবস্থান অপরিবর্তিত থাকলেও স্কো&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%8f%e0%a6%b6%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%ad%e0%a6%be%e0%a6%ac/">জুমবাংলা</source>
    </item>

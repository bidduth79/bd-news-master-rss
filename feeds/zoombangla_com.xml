      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%87%E0%A6%AE%E0%A6%BE%E0%A6%AE-%E0%A6%AE%E0%A7%81%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%9C%E0%A7%8D%E0%A6%9C%E0%A6%BF%E0%A6%A8.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%87%E0%A6%AE%E0%A6%BE%E0%A6%AE-%E0%A6%AE%E0%A7%81%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%9C%E0%A7%8D%E0%A6%9C%E0%A6%BF%E0%A6%A8.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%87%E0%A6%AE%E0%A6%BE%E0%A6%AE-%E0%A6%AE%E0%A7%81%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%9C%E0%A7%8D%E0%A6%9C%E0%A6%BF%E0%A6%A8.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="২ লাখ ৫৬ হাজার ইমাম-মুয়াজ্জিনকে সম্মানী দেবে সরকার" /&gt;&lt;/p&gt;&lt;p&gt;চলতি অর্থবছরে দেশের ২ লাখ ৫৬ হাজার ইমাম, মুয়াজ্জিন ও খাদেমকে সরকারি সম্মানীর আওতায় আনা হচ্ছে। এরই মধ্যে প্রায় ২ লাখ ১০ হাজার সুবিধাভোগীর তথ্য অন্তর্ভুক্তির কাজ শেষ হয়েছে। আগামী ডিসেম্বরের মধ্যে বাকি সুবিধাভোগীদেরও এ কর্মসূচির আওতায় আনার চেষ্টা চলছে। বৃহস্পতিবার (২৬ নভেম্বর) দুপুরে ঢাকার সাভারের আশুল&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a7%a8-%e0%a6%b2%e0%a6%be%e0%a6%96-%e0%a7%ab%e0%a7%ac-%e0%a6%b9%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0-%e0%a6%87%e0%a6%ae%e0%a6%be%e0%a6%ae/">জুমবাংলা</source>
    </item>
    <item>
      <title>যুবলীগ নেত্রীকে ওসি, ‘আমার কাছে এলে তোমার কোনো ব্যথাই আর থাকবে না’</title>
      <link>https://zoombangla.com/%e0%a6%af%e0%a7%81%e0%a6%ac%e0%a6%b2%e0%a7%80%e0%a6%97-%e0%a6%a8%e0%a7%87%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a7%80%e0%a6%95%e0%a7%87-%e0%a6%93%e0%a6%b8%e0%a6%bf/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%af%e0%a7%81%e0%a6%ac%e0%a6%b2%e0%a7%80%e0%a6%97-%e0%a6%a8%e0%a7%87%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a7%80%e0%a6%95%e0%a7%87-%e0%a6%93%e0%a6%b8%e0%a6%bf/</guid>
      <pubDate>Thu, 26 Nov 2026 15:49:12 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/OC.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/OC.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/OC.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যুবলীগ নেত্রীকে ওসি, ‘আমার কাছে এলে তোমার কোনো ব্যথাই আর থাকবে না’" /&gt;&lt;/p&gt;&lt;p&gt;ফেনীর দাগনভূঞা মডেল থানার ওসি ফয়জুল আজীম নোমান ও কার্যক্রম নিষিদ্ধ যুব মহিলা লীগের দাগনভূঞা পৌর শাখার সাবেক সভাপতি তাসকিরা তানিন সনির কথোপকথনের একটি অডিও সামাজিক যোগাযোগমাধ্যমে ছড়িয়ে পড়েছে। এতে মাইগ্রেনের ব্যথা সারানোর কথা বলে সিএনজিচালিত অটোরিকশা ভাড়া করে সনিকে নিজের বাংলোতে যেতে বলেন ওসি। এ সময় তি&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%af%e0%a7%81%e0%a6%ac%e0%a6%b2%e0%a7%80%e0%a6%97-%e0%a6%a8%e0%a7%87%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a7%80%e0%a6%95%e0%a7%87-%e0%a6%93%e0%a6%b8%e0%a6%bf/">জুমবাংলা</source>
    </item>
    <item>
      <title>র‍্যাম্পে হাঁটতে গিয়ে পড়ে আহত হয়ে হাসপাতালে মিষ্টি জান্নাত</title>
      <link>https://zoombangla.com/%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%ae%e0%a7%8d%e0%a6%aa%e0%a7%87-%e0%a6%b9%e0%a6%be%e0%a6%81%e0%a6%9f%e0%a6%a4%e0%a7%87-%e0%a6%97%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%ae%e0%a7%8d%e0%a6%aa%e0%a7%87-%e0%a6%b9%e0%a6%be%e0%a6%81%e0%a6%9f%e0%a6%a4%e0%a7%87-%e0%a6%97%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87/</guid>
      <pubDate>Thu, 26 Nov 2026 15:45:40 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Mistee.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Mistee.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Mistee.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="র‍্যাম্পে হাঁটতে গিয়ে পড়ে আহত হয়ে হাসপাতালে মিষ্টি জান্নাত" /&gt;&lt;/p&gt;&lt;p&gt;ব্র্যান্ড অ্যাম্বাসেডর হিসেবে একটি অনুষ্ঠানে অংশ নিতে গিয়ে দুর্ঘটনার শিকার হয়েছেন চিত্রনায়িকা মিষ্টি জান্নাত। অনুষ্ঠানের র‍্যাম্পে হাঁটার সময় স্টেজের ত্রুটির কারণে ভারসাম্য হারিয়ে পড়ে যান তিনি। এতে পায়ের গোড়ালির লিগামেন্টে আঘাত পেয়েছেন এই অভিনেত্রী। পরে তাঁকে রাজধানীর একটি হাসপাতালে নেওয়া হয়। চিকিৎস&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%ae%e0%a7%8d%e0%a6%aa%e0%a7%87-%e0%a6%b9%e0%a6%be%e0%a6%81%e0%a6%9f%e0%a6%a4%e0%a7%87-%e0%a6%97%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87/">জুমবাংলা</source>
    </item>
    <item>
      <title>জিয়াউল সিরিয়াল কিলার ও বিশ্বমানবতার কলঙ্ক, একবার ফাঁসিতে যথেষ্ট নয় : অ্যাটর্নি জেনারেল</title>
      <link>https://zoombangla.com/%e0%a6%9c%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%89%e0%a6%b2-%e0%a6%b8%e0%a6%bf%e0%a6%b0%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b2-%e0%a6%95%e0%a6%bf%e0%a6%b2%e0%a6%be%e0%a6%b0/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%9c%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%89%e0%a6%b2-%e0%a6%b8%e0%a6%bf%e0%a6%b0%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b2-%e0%a6%95%e0%a6%bf%e0%a6%b2%e0%a6%be%e0%a6%b0/</guid>
      <pubDate>Thu, 26 Nov 2026 15:44:09 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Zia-1.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Zia-1.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Zia-1.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জিয়াউল সিরিয়াল কিলার ও বিশ্বমানবতার কলঙ্ক, একবার ফাঁসিতে যথেষ্ট নয় : অ্যাটর্নি জেনারেল" /&gt;&lt;/p&gt;&lt;p&gt;গুম-খুন, নির্যাতন ও মরদেহ গুমের মতো অপরাধের ভয়াবহতা বিবেচনায় মেজর জেনারেল (অব.) জিয়াউল আহসানের একবারের মৃত্যুদণ্ডও যথেষ্ট নয় বলে মন্তব্য করেছেন অ্যাটর্নি জেনারেল ব্যারিস্টার মো. রুহুল কুদ্দুস কাজল। তিনি বলেন, জিয়াউল আহসানের অপরাধ সমুদ্রসমান। তাকে মৃত্যুদণ্ড দেওয়া হলেও তা হবে কেবল একটি শিশির কণা। বৃহ&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%9c%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%89%e0%a6%b2-%e0%a6%b8%e0%a6%bf%e0%a6%b0%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b2-%e0%a6%95%e0%a6%bf%e0%a6%b2%e0%a6%be%e0%a6%b0/">জুমবাংলা</source>
    </item>
    <item>
      <title>এবার ৮ হাজার কোটি টাকার জ্বালানি তেল কেনার সিদ্ধান্ত সরকারের</title>

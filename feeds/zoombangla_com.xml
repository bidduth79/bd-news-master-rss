    <item>
      <title>৭০ লাখ শিক্ষার্থীকে উপবৃত্তি দেবে সরকার, পাবেন যারা</title>
      <link>https://zoombangla.com/%e0%a7%ad%e0%a7%a6-%e0%a6%b2%e0%a6%be%e0%a6%96-%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%a5%e0%a7%80%e0%a6%95%e0%a7%87/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a7%ad%e0%a7%a6-%e0%a6%b2%e0%a6%be%e0%a6%96-%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%a5%e0%a7%80%e0%a6%95%e0%a7%87/</guid>
      <pubDate>Thu, 19 Nov 2026 18:02:21 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%89%E0%A6%AA%E0%A6%AC%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BF.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%89%E0%A6%AA%E0%A6%AC%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BF.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%89%E0%A6%AA%E0%A6%AC%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BF.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৭০ লাখ শিক্ষার্থীকে উপবৃত্তি দেবে সরকার, পাবেন যারা" /&gt;&lt;/p&gt;&lt;p&gt;অর্থের অভাবে কোনো শিক্ষার্থীর লেখাপড়া যাতে বন্ধ না হয়, সে লক্ষ্য নিয়ে দেশের ৭০ লাখ শিক্ষার্থীকে উপবৃত্তি দেয়ার ঘোষণা দিয়েছেন প্রধানমন্ত্রী তারেক রহমান। ষষ্ঠ শ্রেণি থেকে ডিগ্রি (পাস কোর্স) পর্যন্ত শিক্ষার্থীরা এ সুবিধার আওতায় আসবে। আগামী এক থেকে দুই মাসের মধ্যে উপবৃত্তি কার্যক্রম শুরু করার পরিকল্পনা &lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a7%ad%e0%a7%a6-%e0%a6%b2%e0%a6%be%e0%a6%96-%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%a5%e0%a7%80%e0%a6%95%e0%a7%87/">জুমবাংলা</source>
    </item>
    <item>
      <title>সরকারি ফ্ল্যাটে সাবলেট অপসারণ নিয়ে নতুন সিদ্ধান্ত</title>
      <link>https://zoombangla.com/%e0%a6%b8%e0%a6%b0%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%bf-%e0%a6%ab%e0%a7%8d%e0%a6%b2%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%9f%e0%a7%87-%e0%a6%b8%e0%a6%be%e0%a6%ac%e0%a6%b2%e0%a7%87%e0%a6%9f/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%b8%e0%a6%b0%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%bf-%e0%a6%ab%e0%a7%8d%e0%a6%b2%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%9f%e0%a7%87-%e0%a6%b8%e0%a6%be%e0%a6%ac%e0%a6%b2%e0%a7%87%e0%a6%9f/</guid>
      <pubDate>Thu, 19 Nov 2026 17:54:36 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%AB%E0%A7%8D%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9F%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A6%B2%E0%A7%87%E0%A6%9F.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%AB%E0%A7%8D%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9F%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A6%B2%E0%A7%87%E0%A6%9F.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%AB%E0%A7%8D%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9F%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A6%B2%E0%A7%87%E0%A6%9F.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সরকারি ফ্ল্যাটে সাবলেট অপসারণ নিয়ে নতুন সিদ্ধান্ত" /&gt;&lt;/p&gt;&lt;p&gt;সরকারি কোটায় বরাদ্দ পাওয়া বাসা বা ফ্ল্যাটে অবৈধভাবে সাবলেট (উপভাড়া) দেওয়া ভাড়াটিয়াদের আগামী ৩০ নভেম্বরের মধ্যে অপসারণের কড়া নির্দেশ দিয়েছে মন্ত্রিপরিষদ বিভাগ। নির্ধারিত সময়ের মধ্যে ভাড়াটিয়া সরিয়ে নিজে বসবাস শুরু না করলে কোনো ধরনের কারণ দর্শানোর নোটিশ ছাড়াই সংশ্লিষ্ট কর্মকর্তার বাসার বরাদ্দ বাতিল করা&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%b8%e0%a6%b0%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%bf-%e0%a6%ab%e0%a7%8d%e0%a6%b2%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%9f%e0%a7%87-%e0%a6%b8%e0%a6%be%e0%a6%ac%e0%a6%b2%e0%a7%87%e0%a6%9f/">জুমবাংলা</source>
    </item>
    <item>
      <title>বৃষ্টি থাকবে কতদিন, জানাল আবহাওয়া অধিদপ্তর</title>
      <link>https://zoombangla.com/%e0%a6%ac%e0%a7%83%e0%a6%b7%e0%a7%8d%e0%a6%9f%e0%a6%bf-%e0%a6%a5%e0%a6%be%e0%a6%95%e0%a6%ac%e0%a7%87-%e0%a6%95%e0%a6%a4%e0%a6%a6%e0%a6%bf%e0%a6%a8/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%ac%e0%a7%83%e0%a6%b7%e0%a7%8d%e0%a6%9f%e0%a6%bf-%e0%a6%a5%e0%a6%be%e0%a6%95%e0%a6%ac%e0%a7%87-%e0%a6%95%e0%a6%a4%e0%a6%a6%e0%a6%bf%e0%a6%a8/</guid>
      <pubDate>Thu, 19 Nov 2026 17:48:00 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AC%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AC%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AC%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বৃষ্টি থাকবে কতদিন, জানাল আবহাওয়া অধিদপ্তর" /&gt;&lt;/p&gt;&lt;p&gt;ঘূর্ণিঝড় ‘আকভান’-এর প্রভাবে রাজধানী ঢাকাসহ দেশের বিভিন্ন অঞ্চলে সকাল থেকে বৃষ্টি হচ্ছে। এরই মধ্যে মৌসুমি বায়ু বিদায় নেওয়ায় দেশের অনেক জেলায় শীতের আমেজ শুরু হয়েছে। তবে এই বৃষ্টির প্রবণতা আরও কয়েক দিন থাকতে পারে বলে জানিয়েছে আবহাওয়া অধিদপ্তর। আবহাওয়া অধিদপ্তরের পূর্বাভাস অনুযায়ী, আগামী পাঁচ দিন রাজধান&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ac%e0%a7%83%e0%a6%b7%e0%a7%8d%e0%a6%9f%e0%a6%bf-%e0%a6%a5%e0%a6%be%e0%a6%95%e0%a6%ac%e0%a7%87-%e0%a6%95%e0%a6%a4%e0%a6%a6%e0%a6%bf%e0%a6%a8/">জুমবাংলা</source>
    </item>
    <item>
      <title>বৈষম্যবিরোধী ছাত্র আন্দোলনের সাবেক নেতা রাফির বাড়িতে আগুন</title>
      <link>https://zoombangla.com/%e0%a6%ac%e0%a7%88%e0%a6%b7%e0%a6%ae%e0%a7%8d%e0%a6%af%e0%a6%ac%e0%a6%bf%e0%a6%b0%e0%a7%8b%e0%a6%a7%e0%a7%80-%e0%a6%9b%e0%a6%be%e0%a6%a4%e0%a7%8d%e0%a6%b0/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%ac%e0%a7%88%e0%a6%b7%e0%a6%ae%e0%a7%8d%e0%a6%af%e0%a6%ac%e0%a6%bf%e0%a6%b0%e0%a7%8b%e0%a6%a7%e0%a7%80-%e0%a6%9b%e0%a6%be%e0%a6%a4%e0%a7%8d%e0%a6%b0/</guid>
      <pubDate>Thu, 19 Nov 2026 17:41:45 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AC%E0%A7%88%E0%A6%B7%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%80-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8B%E0%A6%B2%E0%A6%A8%E0%A7%87%E0%A6%B0.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AC%E0%A7%88%E0%A6%B7%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%80-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8B%E0%A6%B2%E0%A6%A8%E0%A7%87%E0%A6%B0.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AC%E0%A7%88%E0%A6%B7%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%80-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8B%E0%A6%B2%E0%A6%A8%E0%A7%87%E0%A6%B0.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বৈষম্যবিরোধী ছাত্র আন্দোলনের সাবেক নেতা রাফির বাড়িতে আগুন" /&gt;&lt;/p&gt;&lt;p&gt;জাতীয় ছাত্রশক্তির সিনিয়র যুগ্ম সাধারণ সম্পাদক ও বৈষম্যবিরোধী ছাত্র আন্দোলনের সাবেক সমন্বয়ক খান তালাত মাহমুদ রাফির গ্রামের বাড়িতে আগুন দেয়ার অভিযোগ উঠেছে। বুধবার (১৮ নভেম্বর) দিবাগত রাত তিনটার দিকে নেত্রকোনার জেলার মোহনগঞ্জ উপজেলার সমাজ সহিলদেও ইউনিয়নের জয়পুর গ্রামে এ ঘটনা ঘটে। রফির বাবা তরিকুল ইসলাম&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ac%e0%a7%88%e0%a6%b7%e0%a6%ae%e0%a7%8d%e0%a6%af%e0%a6%ac%e0%a6%bf%e0%a6%b0%e0%a7%8b%e0%a6%a7%e0%a7%80-%e0%a6%9b%e0%a6%be%e0%a6%a4%e0%a7%8d%e0%a6%b0/">জুমবাংলা</source>
    </item>
    <item>
      <title>‘আইসিজের রায় রোহিঙ্গার বিজয়’</title>
      <link>https://zoombangla.com/%e0%a6%86%e0%a6%87%e0%a6%b8%e0%a6%bf%e0%a6%9c%e0%a7%87%e0%a6%b0-%e0%a6%b0%e0%a6%be%e0%a6%af%e0%a6%bc/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%86%e0%a6%87%e0%a6%b8%e0%a6%bf%e0%a6%9c%e0%a7%87%e0%a6%b0-%e0%a6%b0%e0%a6%be%e0%a6%af%e0%a6%bc/</guid>
      <pubDate>Thu, 19 Nov 2026 17:37:14 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘আইসিজের রায় রোহিঙ্গার বিজয়’" /&gt;&lt;/p&gt;&lt;p&gt;রোহিঙ্গা জনগোষ্ঠীর বিরুদ্ধে গণহত্যার দায়ে মিয়ানমারকে দায়ী করে আন্তর্জাতিক বিচার আদালতের (আইসিজে) দেয়া রায়কে রোহিঙ্গাদের বিজয় হিসেবে অভিহিত করেছেন গাম্বিয়ার বিচারমন্ত্রী দাউদা জালো। তিনি বলেছেন, দীর্ঘ নিপীড়ন ও দুর্ভোগের পর এই রায় রোহিঙ্গাদের বিশ্বাস ও আশার জায়গা তৈরি করবে। বৃহস্পতিবার (১৯ নভেম্বর) নে&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%86%e0%a6%87%e0%a6%b8%e0%a6%bf%e0%a6%9c%e0%a7%87%e0%a6%b0-%e0%a6%b0%e0%a6%be%e0%a6%af%e0%a6%bc/">জুমবাংলা</source>
    </item>
    <item>
      <title>ভাগ্য বদলের আশায় আঙুলে ‘পাথরের আংটি’ পরা কি জায়েজ?</title>
      <link>https://zoombangla.com/%e0%a6%ad%e0%a6%be%e0%a6%97%e0%a7%8d%e0%a6%af-%e0%a6%ac%e0%a6%a6%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a6%86%e0%a6%b6%e0%a6%be%e0%a6%af%e0%a6%bc/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%ad%e0%a6%be%e0%a6%97%e0%a7%8d%e0%a6%af-%e0%a6%ac%e0%a6%a6%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a6%86%e0%a6%b6%e0%a6%be%e0%a6%af%e0%a6%bc/</guid>
      <pubDate>Thu, 19 Nov 2026 17:19:13 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Ring.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Ring.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Ring.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভাগ্য বদলের আশায় আঙুলে ‘পাথরের আংটি’ পরা কি জায়েজ?" /&gt;&lt;/p&gt;&lt;p&gt;আমাদের সমাজে ভাগ্য ফেরানো, বিপদ কাটানো কিংবা সৌভাগ্য লাভের আশায় নানা ধরনের পাথর বা ধাতুর আংটি ধারণ করার প্রচলন দেখা যায়। অনেকে আবার শরীরের নানা অসুখ বা ব্যথা সারানোর কথা ভেবেও এসব পাথর ব্যবহার করেন। কিন্তু একজন মুমিন হিসেবে এসব পাথরের ওপর বিশ্বাস রাখা বা তা ব্যবহার করার শরয়ি বিধান কী? অলৌকিক ক্ষমতায়&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ad%e0%a6%be%e0%a6%97%e0%a7%8d%e0%a6%af-%e0%a6%ac%e0%a6%a6%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a6%86%e0%a6%b6%e0%a6%be%e0%a6%af%e0%a6%bc/">জুমবাংলা</source>
    </item>
    <item>
      <title>রণবীরের সঙ্গে ‘অসম বিয়ে’: আলিয়া বললেন—এটা আপত্তিকর</title>
      <link>https://zoombangla.com/%e0%a6%b0%e0%a6%a3%e0%a6%ac%e0%a7%80%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%87-%e0%a6%85%e0%a6%b8%e0%a6%ae/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%b0%e0%a6%a3%e0%a6%ac%e0%a7%80%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%87-%e0%a6%85%e0%a6%b8%e0%a6%ae/</guid>
      <pubDate>Thu, 19 Nov 2026 17:14:15 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/alia-ranbir.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/alia-ranbir.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/alia-ranbir.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রণবীরের সঙ্গে ‘অসম বিয়ে’: আলিয়া বললেন—এটা আপত্তিকর" /&gt;&lt;/p&gt;&lt;p&gt;ভালোবেসে ঘর বেঁধেছেন বলিউডের তারকা দম্পতি আলিয়া ভাট ও রণবীর কাপুর। কিন্তু রণবীরের সঙ্গে তার সম্পর্ক নিয়ে নানা ধরনের সমালোচনার মুখে পড়তে হয়েছে আলিয়াকে। অনেকে এটিকে ‘অসম বিয়ে’ বলেও মন্তব্য করেছেন। কিন্তু মানুষের এ ধরনের ব্যাখ্যা-বিশ্লেষণ শুনতে নারাজ এই অভিনেত্রী। ‘টাইম’ ম্যাগাজিনকে দেওয়া এক সাক্ষাৎকার&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%b0%e0%a6%a3%e0%a6%ac%e0%a7%80%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%87-%e0%a6%85%e0%a6%b8%e0%a6%ae/">জুমবাংলা</source>
    </item>
    <item>
      <title>এক বছর বিনামূল্যে ChatGPT Plus ব্যবহারের সুযোগ দিচ্ছে ওপেন এআই</title>
      <link>https://zoombangla.com/%e0%a6%8f%e0%a6%95-%e0%a6%ac%e0%a6%9b%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%a8%e0%a6%be%e0%a6%ae%e0%a7%82%e0%a6%b2%e0%a7%8d%e0%a6%af%e0%a7%87-chatgpt-plus/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%8f%e0%a6%95-%e0%a6%ac%e0%a6%9b%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%a8%e0%a6%be%e0%a6%ae%e0%a7%82%e0%a6%b2%e0%a7%8d%e0%a6%af%e0%a7%87-chatgpt-plus/</guid>
      <pubDate>Thu, 19 Nov 2026 16:45:14 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/ChatGPT-Plus.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/ChatGPT-Plus.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/ChatGPT-Plus.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এক বছর বিনামূল্যে ChatGPT Plus ব্যবহারের সুযোগ দিচ্ছে ওপেন এআই" /&gt;&lt;/p&gt;&lt;p&gt;গবেষণার কাজে কৃত্রিম বুদ্ধিমত্তার ব্যবহার বাড়াতে বিশ্বজুড়ে গবেষকদের জন্য বিশেষ সুযোগ চালু করছে ওপেন এআই। ‘চ্যাটজিপিটি ফর একাডেমিক রিসার্সারস’ কর্মসূচির আওতায় নির্বাচিত গবেষকেরা ১২ মাস বিনামূল্যে চ্যাটজিপিটি প্লাস ব্যবহার করতে পারবেন। মূল আবেদনকারীর পাশাপাশি তার প্রতিষ্ঠানের আরও দুজন সহযোগী গবেষকও এই&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%8f%e0%a6%95-%e0%a6%ac%e0%a6%9b%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%a8%e0%a6%be%e0%a6%ae%e0%a7%82%e0%a6%b2%e0%a7%8d%e0%a6%af%e0%a7%87-chatgpt-plus/">জুমবাংলা</source>
    </item>
    <item>
      <title>টুঙ্গিপাড়ায় বিএনপির ৫ নেতার পদত্যাগ</title>
      <link>https://zoombangla.com/%e0%a6%9f%e0%a7%81%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a6%bf%e0%a6%aa%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%ac%e0%a6%bf%e0%a6%8f%e0%a6%a8%e0%a6%aa%e0%a6%bf%e0%a6%b0/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%9f%e0%a7%81%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a6%bf%e0%a6%aa%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%ac%e0%a6%bf%e0%a6%8f%e0%a6%a8%e0%a6%aa%e0%a6%bf%e0%a6%b0/</guid>
      <pubDate>Thu, 19 Nov 2026 16:39:26 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/gopalganj.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/gopalganj.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/gopalganj.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টুঙ্গিপাড়ায় বিএনপির ৫ নেতার পদত্যাগ" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জের টুঙ্গিপাড়ায় বিএনপি ও এর সহযোগী সংগঠনের পাঁচ নেতা পদত্যাগ করেছেন। বুধবার (১৮ নভেম্বর) উপজেলার পাটগাতী এলাকায় আসলাম ফকিরের বাড়ির উঠানে এক সংবাদ সম্মেলনে তারা এই পদত্যাগের ঘোষণা দেন। পদত্যাগকারী নেতারা হলেন উপজেলা বিএনপির সদস্য আসলাম ফকির, পাটগাতী ইউনিয়ন বিএনপির সহসভাপতি ফায়েকুজ্জামান ফকির,&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%9f%e0%a7%81%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a6%bf%e0%a6%aa%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%ac%e0%a6%bf%e0%a6%8f%e0%a6%a8%e0%a6%aa%e0%a6%bf%e0%a6%b0/">জুমবাংলা</source>
    </item>
    <item>
      <title>দৈনন্দিন জীবনের সঙ্গে অর্থনীতির যোগসূত্র বোঝাবে তরুণদের ‘অর্থল্যাব’</title>
      <link>https://zoombangla.com/arthalab-bd/</link>
      <guid isPermaLink="true">https://zoombangla.com/arthalab-bd/</guid>
      <pubDate>Thu, 19 Nov 2026 16:36:59 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/arthalabbd.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/arthalabbd.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/arthalabbd.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দৈনন্দিন জীবনের সঙ্গে অর্থনীতির যোগসূত্র বোঝাবে তরুণদের ‘অর্থল্যাব’" /&gt;&lt;/p&gt;&lt;p&gt;মুদ্রাস্ফীতি, ডলারের বিনিময় হার কিংবা রেমিট্যান্সের পরিসংখ্যান সাধারণ মানুষের কাছে অনেক সময় জটিল মনে হয়। এসব অর্থনৈতিক সূচক দৈনন্দিন জীবনে কীভাবে প্রভাব ফেলে, তা সহজ ভাষায় তুলে ধরতে তরুণদের উদ্যোগে আত্মপ্রকাশ করতে যাচ্ছে নতুন অনলাইন প্ল্যাটফর্ম ‘অর্থল্যাব’। আগামী ১৬ ডিসেম্বর মহান বিজয় দিবসে প্ল্যাটফ&lt;/p&gt;</description>
      <source url="https://zoombangla.com/arthalab-bd/">জুমবাংলা</source>
    </item>
    <item>
      <title>লালমনিরহাটে জাতীয় অ্যারো জিনিয়াস প্রতিযোগিতা-২০২৬ উদ্বোধন করলেন প্রধানমন্ত্রী</title>
      <link>https://zoombangla.com/%e0%a6%b2%e0%a6%be%e0%a6%b2%e0%a6%ae%e0%a6%a8%e0%a6%bf%e0%a6%b0%e0%a6%b9%e0%a6%be%e0%a6%9f%e0%a7%87-%e0%a6%9c%e0%a6%be%e0%a6%a4%e0%a7%80%e0%a6%af%e0%a6%bc/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%b2%e0%a6%be%e0%a6%b2%e0%a6%ae%e0%a6%a8%e0%a6%bf%e0%a6%b0%e0%a6%b9%e0%a6%be%e0%a6%9f%e0%a7%87-%e0%a6%9c%e0%a6%be%e0%a6%a4%e0%a7%80%e0%a6%af%e0%a6%bc/</guid>
      <pubDate>Thu, 19 Nov 2026 16:20:18 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/PM-2-1.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/PM-2-1.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/PM-2-1.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="লালমনিরহাটে জাতীয় অ্যারো জিনিয়াস প্রতিযোগিতা-২০২৬ উদ্বোধন করলেন প্রধানমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;আবির হোসেন সজল : অ্যাভিয়েশন অ্যান্ড অ্যারোস্পেস বিশ্ববিদ্যালয়, বাংলাদেশ (AAUB)-এর উদ্যোগে লালমনিরহাট ক্যাম্পাসে শুরু হয়েছে দুই দিনব্যাপী জাতীয় অ্যারো জিনিয়াস প্রতিযোগিতা-২০২৬ (NAGC-2026)। প্রধান অতিথি হিসেবে উপস্থিত থেকে প্রতিযোগিতার উদ্বোধন করেন গণপ্রজাতন্ত্রী বাংলাদেশ সরকারের মাননীয় প্রধানমন&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%b2%e0%a6%be%e0%a6%b2%e0%a6%ae%e0%a6%a8%e0%a6%bf%e0%a6%b0%e0%a6%b9%e0%a6%be%e0%a6%9f%e0%a7%87-%e0%a6%9c%e0%a6%be%e0%a6%a4%e0%a7%80%e0%a6%af%e0%a6%bc/">জুমবাংলা</source>
    </item>
    <item>
      <title>২০২৭ সালে আসছে ৩টি নতুন iPhone</title>
      <link>https://zoombangla.com/%e0%a7%a9%e0%a6%9f%e0%a6%bf-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-iphone/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a7%a9%e0%a6%9f%e0%a6%bf-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-iphone/</guid>
      <pubDate>Thu, 19 Nov 2026 16:18:07 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/iPhone.jpeg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/iPhone.jpeg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/iPhone.jpeg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="২০২৭ সালে আসছে ৩টি নতুন iPhone" /&gt;&lt;/p&gt;&lt;p&gt;নতুন আইফোন উন্মোচনের চিরাচরিত সময়সূচিতে বড় ধরনের পরিবর্তন আনতে চলেছে প্রযুক্তিপণ্য নির্মাতা প্রতিষ্ঠান অ্যাপল। সাধারণত প্রতি বছর সেপ্টেম্বর মাসে নতুন আইফোন সিরিজের সব মডেল একসঙ্গে প্রকাশ করা হলেও, বিভিন্ন প্রতিবেদন অনুযায়ী ২০২৭ সালের শুরুতেই তিনটি নতুন মডেল আলাদা অনুষ্ঠানের মাধ্যমে বাজারে আনতে পারে &lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a7%a9%e0%a6%9f%e0%a6%bf-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-iphone/">জুমবাংলা</source>
    </item>
    <item>
      <title>জেনারেল ও হিফজ শিক্ষার সমন্বয়ে ইতমিনান বৃত্তি পরীক্ষা, অংশ নিচ্ছে ১৫ হাজার শিক্ষার্থী</title>
      <link>https://zoombangla.com/%e0%a6%9c%e0%a7%87%e0%a6%a8%e0%a6%be%e0%a6%b0%e0%a7%87%e0%a6%b2-%e0%a6%93-%e0%a6%b9%e0%a6%bf%e0%a6%ab%e0%a6%9c-%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%be%e0%a6%b0/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%9c%e0%a7%87%e0%a6%a8%e0%a6%be%e0%a6%b0%e0%a7%87%e0%a6%b2-%e0%a6%93-%e0%a6%b9%e0%a6%bf%e0%a6%ab%e0%a6%9c-%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%be%e0%a6%b0/</guid>
      <pubDate>Thu, 19 Nov 2026 15:06:31 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Student-3.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Student-3.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Student-3.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জেনারেল ও হিফজ শিক্ষার সমন্বয়ে ইতমিনান বৃত্তি পরীক্ষা, অংশ নিচ্ছে ১৫ হাজার শিক্ষার্থী" /&gt;&lt;/p&gt;&lt;p&gt;ধর্মীয় শিক্ষার পাশাপাশি আধুনিক শিক্ষায়ও দক্ষ একটি প্রজন্ম গড়ে তোলার প্রত্যয় নিয়ে কাজ করছে ইতমিনান ফাউন্ডেশন। এরই ধারাবাহিকতায় দেশব্যাপী অনুষ্ঠিত হচ্ছে ‘ইতমিনান বৃত্তি পরীক্ষা ২০২৬’। জেনারেল ও হিফজ শিক্ষার সমন্বয়ে পরিচালিত ইতমিনান কারিকুলামের আওতায় আয়োজিত এ পরীক্ষায় অংশ নিচ্ছে প্রায় ১৫ হাজ&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%9c%e0%a7%87%e0%a6%a8%e0%a6%be%e0%a6%b0%e0%a7%87%e0%a6%b2-%e0%a6%93-%e0%a6%b9%e0%a6%bf%e0%a6%ab%e0%a6%9c-%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%be%e0%a6%b0/">জুমবাংলা</source>
    </item>
    <item>
      <title>ভারতে একাই নদী পরিষ্কার করা সেই বিট্টু এবার হাতে সংক্রমণ নিয়ে হাসপাতালে</title>
      <link>https://zoombangla.com/%e0%a6%ad%e0%a6%be%e0%a6%b0%e0%a6%a4%e0%a7%87-%e0%a6%8f%e0%a6%95%e0%a6%be%e0%a6%87-%e0%a6%a8%e0%a6%a6%e0%a7%80-%e0%a6%aa%e0%a6%b0%e0%a6%bf%e0%a6%b7%e0%a7%8d%e0%a6%95%e0%a6%be%e0%a6%b0/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%ad%e0%a6%be%e0%a6%b0%e0%a6%a4%e0%a7%87-%e0%a6%8f%e0%a6%95%e0%a6%be%e0%a6%87-%e0%a6%a8%e0%a6%a6%e0%a7%80-%e0%a6%aa%e0%a6%b0%e0%a6%bf%e0%a6%b7%e0%a7%8d%e0%a6%95%e0%a6%be%e0%a6%b0/</guid>
      <pubDate>Thu, 19 Nov 2026 14:50:45 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Screenshot_1-4.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Screenshot_1-4.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Screenshot_1-4.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভারতে একাই নদী পরিষ্কার করা সেই বিট্টু এবার হাতে সংক্রমণ নিয়ে হাসপাতালে" /&gt;&lt;/p&gt;&lt;p&gt;ভারতের মধ্যপ্রদেশের অজনার নদী বারবার পরিষ্কার করার পরও মানুষ সেখানে আবর্জনা ফেলা অব্যাহত রাখায় হতাশা প্রকাশ করেছেন পরিবেশকর্মী সুরেন্দ্র সিং চৌধুরী, যিনি &amp;#8216;বিট্টু তাবাহি&amp;#8217; নামেই বেশি পরিচিত। দীর্ঘদিন একা হাতে নদী পরিষ্কার করতে গিয়ে এবার নিজের হাতে মারাত্মক সংক্রমণ নিয়ে হাসপাতালে ভর্তি হ&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ad%e0%a6%be%e0%a6%b0%e0%a6%a4%e0%a7%87-%e0%a6%8f%e0%a6%95%e0%a6%be%e0%a6%87-%e0%a6%a8%e0%a6%a6%e0%a7%80-%e0%a6%aa%e0%a6%b0%e0%a6%bf%e0%a6%b7%e0%a7%8d%e0%a6%95%e0%a6%be%e0%a6%b0/">জুমবাংলা</source>
    </item>
    <item>
      <title>iQOO 16 : শীঘ্রই লঞ্চ হতে যাচ্ছে iQOO-এর শক্তিশালী গেমিং স্মার্টফোন</title>
      <link>https://zoombangla.com/iqoo-16-%e0%a6%b6%e0%a7%80%e0%a6%98%e0%a7%8d%e0%a6%b0%e0%a6%87-%e0%a6%b2%e0%a6%9e%e0%a7%8d%e0%a6%9a-%e0%a6%b9%e0%a6%a4%e0%a7%87-%e0%a6%af%e0%a6%be%e0%a6%9a%e0%a7%8d%e0%a6%9b%e0%a7%87-iqoo/</link>
      <guid isPermaLink="true">https://zoombangla.com/iqoo-16-%e0%a6%b6%e0%a7%80%e0%a6%98%e0%a7%8d%e0%a6%b0%e0%a6%87-%e0%a6%b2%e0%a6%9e%e0%a7%8d%e0%a6%9a-%e0%a6%b9%e0%a6%a4%e0%a7%87-%e0%a6%af%e0%a6%be%e0%a6%9a%e0%a7%8d%e0%a6%9b%e0%a7%87-iqoo/</guid>
      <pubDate>Thu, 19 Nov 2026 14:33:06 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/iQOO-16.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/iQOO-16.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/iQOO-16.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="iQOO 16 : শীঘ্রই লঞ্চ হতে যাচ্ছে iQOO-এর শক্তিশালী গেমিং স্মার্টফোন" /&gt;&lt;/p&gt;&lt;p&gt;আইকু শীঘ্রই ভারতে তার নতুন ফ্ল্যাগশিপ স্মার্টফোন iQOO 16 লঞ্চ করবে বলে আশা করা হচ্ছে। আইকু কোম্পানির এই ফ্ল্যাগশিপ গেমিং ফোনটি সম্প্রতি চীনের বাজারে লঞ্চ করা হয়েছিল। এতে কোম্পানি ব্যবহার করেছে Qualcomm এর সবচেয়ে দ্রুত Snapdragon 8 Elite Extreme Gen 6 প্রসেসর, যা 2nm প্রসেসে কাজ করে। বলে দি যে এই চিপ&lt;/p&gt;</description>
      <source url="https://zoombangla.com/iqoo-16-%e0%a6%b6%e0%a7%80%e0%a6%98%e0%a7%8d%e0%a6%b0%e0%a6%87-%e0%a6%b2%e0%a6%9e%e0%a7%8d%e0%a6%9a-%e0%a6%b9%e0%a6%a4%e0%a7%87-%e0%a6%af%e0%a6%be%e0%a6%9a%e0%a7%8d%e0%a6%9b%e0%a7%87-iqoo/">জুমবাংলা</source>
    </item>

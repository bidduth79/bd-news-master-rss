      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A7%8E%E0%A6%B9%E0%A7%80%E0%A6%A8-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%AC%E0%A7%87-%E0%A6%AF%E0%A7%87%E0%A6%B8%E0%A6%AC-%E0%A6%8F%E0%A6%B2%E0%A6%BE%E0%A6%95%E0%A6%BE.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A7%8E%E0%A6%B9%E0%A7%80%E0%A6%A8-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%AC%E0%A7%87-%E0%A6%AF%E0%A7%87%E0%A6%B8%E0%A6%AC-%E0%A6%8F%E0%A6%B2%E0%A6%BE%E0%A6%95%E0%A6%BE.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A7%8E%E0%A6%B9%E0%A7%80%E0%A6%A8-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%AC%E0%A7%87-%E0%A6%AF%E0%A7%87%E0%A6%B8%E0%A6%AC-%E0%A6%8F%E0%A6%B2%E0%A6%BE%E0%A6%95%E0%A6%BE.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মঙ্গলবার টানা ৯ ঘণ্টা বিদ্যুৎহীন থাকবে যেসব এলাকা" /&gt;&lt;/p&gt;&lt;p&gt;বার্ষিক রক্ষণাবেক্ষণ কাজের জন্য মঙ্গলবার (২৪ নভেম্বর) সকাল থেকে আটিবাজার জোনাল অফিসের আওতাধীন এলাকায় টানা ৯ ঘণ্টা বিদ্যুৎ সরবরাহ বন্ধ থাকবে। সোমবার (২৩ নভেম্বর) ঢাকা পল্লী বিদ্যুৎ সমিতি-৪-এর আটিবাজার জোনাল অফিস এক বিজ্ঞপ্তিতে এ তথ্য জানিয়েছে। এতে বলা হয়, আটিবাজার ও ওয়াসপুর বৈদ্যুতিক উপকেন্দ্রের বার্&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ae%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a6%b2%e0%a6%ac%e0%a6%be%e0%a6%b0-%e0%a6%9f%e0%a6%be%e0%a6%a8%e0%a6%be-%e0%a7%af-%e0%a6%98%e0%a6%a3%e0%a7%8d%e0%a6%9f%e0%a6%be/">জুমবাংলা</source>
    </item>
    <item>
      <title>নগদের সাবেক প্রশাসককে দেশত্যাগে নিষেধাজ্ঞা</title>
      <link>https://zoombangla.com/%e0%a6%a8%e0%a6%97%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%be%e0%a6%ac%e0%a7%87%e0%a6%95-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%b6%e0%a6%be%e0%a6%b8%e0%a6%95%e0%a6%95%e0%a7%87/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%a8%e0%a6%97%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%be%e0%a6%ac%e0%a7%87%e0%a6%95-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%b6%e0%a6%be%e0%a6%b8%e0%a6%95%e0%a6%95%e0%a7%87/</guid>
      <pubDate>Mon, 23 Nov 2026 16:00:44 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/News-a-7.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/News-a-7.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/News-a-7.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নগদের সাবেক প্রশাসককে দেশত্যাগে নিষেধাজ্ঞা" /&gt;&lt;/p&gt;&lt;p&gt;নগদ লিমিটেডের সাবেক প্রশাসক মো. মোতাসিম বিল্লাহর দেশত্যাগে নিষেধাজ্ঞা দিয়েছেন আদালত। সোমবার (২৩ নভেম্বর) দুর্নীতি দমন কমিশনের (দুদক) আবেদনের পরিপ্রেক্ষিতে ঢাকা মহানগর সিনিয়র স্পেশাল জজ আদালত এ আদেশ দেন। দুদকের আবেদনে বলা হয়েছে, পারস্পরিক যোগসাজশে বিভিন্ন অনিয়ম ও দুর্নীতির মাধ্যমে নগদ লিমিটেডের অর্থ &lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%a8%e0%a6%97%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%be%e0%a6%ac%e0%a7%87%e0%a6%95-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%b6%e0%a6%be%e0%a6%b8%e0%a6%95%e0%a6%95%e0%a7%87/">জুমবাংলা</source>

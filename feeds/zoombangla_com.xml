    <item>
      <title>এইচএসসি সাপ্লিমেন্টারি : ১০ বোর্ডে ১ লাখ ৫৮ হাজার ২৬৮ পরীক্ষার্থী</title>
      <link>https://zoombangla.com/%e0%a6%8f%e0%a6%87%e0%a6%9a%e0%a6%8f%e0%a6%b8%e0%a6%b8%e0%a6%bf-%e0%a6%b8%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%b2%e0%a6%bf%e0%a6%ae%e0%a7%87%e0%a6%a8%e0%a7%8d%e0%a6%9f%e0%a6%be%e0%a6%b0%e0%a6%bf/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%8f%e0%a6%87%e0%a6%9a%e0%a6%8f%e0%a6%b8%e0%a6%b8%e0%a6%bf-%e0%a6%b8%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%b2%e0%a6%bf%e0%a6%ae%e0%a7%87%e0%a6%a8%e0%a7%8d%e0%a6%9f%e0%a6%be%e0%a6%b0%e0%a6%bf/</guid>
      <pubDate>Fri, 13 Nov 2026 19:59:33 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/hsc-exam.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/hsc-exam.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/hsc-exam.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এইচএসসি সাপ্লিমেন্টারি : ১০ বোর্ডে ১ লাখ ৫৮ হাজার ২৬৮ পরীক্ষার্থী" /&gt;&lt;/p&gt;&lt;p&gt;২০২৬ সালের এইচএসসি ও সমমান পরীক্ষার ফলাফলে রেকর্ড পরিমাণ শিক্ষার্থী অকৃতকার্য হওয়ার পর পুনঃপরীক্ষা (সাপ্লিমেন্টারি) নেওয়ার সিদ্ধান্ত হয়েছে। এইচএসসি সাপ্লিমেন্টারি পরীক্ষার ফরম পূরণ শুরু হয় ৫ নভেম্বর। চলে ৯ নভেম্বর পর্যন্ত। এ পর্যন্ত ১০ শিক্ষাবোর্ডে ১ লাখ ৫৮ হাজার ২৬৮ জন শিক্ষার্থী পুনঃপরীক্ষার আবেদন&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%8f%e0%a6%87%e0%a6%9a%e0%a6%8f%e0%a6%b8%e0%a6%b8%e0%a6%bf-%e0%a6%b8%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%b2%e0%a6%bf%e0%a6%ae%e0%a7%87%e0%a6%a8%e0%a7%8d%e0%a6%9f%e0%a6%be%e0%a6%b0%e0%a6%bf/">জুমবাংলা</source>
    </item>

      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%B6%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%B6%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মালয়েশিয়া প্রধানমন্ত্রীর ঘোষণা, ডিসেম্বরজুড়ে নৌযান-বিমানে রোহিঙ্গারা যাবে মিয়ানমার" /&gt;&lt;/p&gt;&lt;p&gt;মালয়েশিয়া থেকে ৬ হাজার ৮০০ জনের বেশি মিয়ানমারের নাগরিককে নিজ দেশে ফেরত পাঠানোর ঘোষণা দিয়েছেন দেশটির প্রধানমন্ত্রী আনোয়ার ইব্রাহিম। তাদের মধ্যে বড় একটি অংশ রোহিঙ্গা শরণার্থী। আগামী ৬ ও ৭ ডিসেম্বর নৌযানে এবং ডিসেম্বরজুড়ে উড়োজাহাজে তাদের ফেরত পাঠানো হবে। মঙ্গলবার মালয়েশিয়ার পার্লামেন্টে দেওয়া বক্তব্যে &lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ae%e0%a6%be%e0%a6%b2%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%b6%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a7%e0%a6%be%e0%a6%a8%e0%a6%ae%e0%a6%a8%e0%a7%8d%e0%a6%a4/">জুমবাংলা</source>
    </item>
    <item>
      <title>আফ্রিকা নেশনস কাপের শিরোপা ফিরে পেল সেনেগাল, চূড়ান্ত রায় ঘোষণা</title>
      <link>https://zoombangla.com/%e0%a6%86%e0%a6%ab%e0%a7%8d%e0%a6%b0%e0%a6%bf%e0%a6%95%e0%a6%be-%e0%a6%a8%e0%a7%87%e0%a6%b6%e0%a6%a8%e0%a6%b8-%e0%a6%95%e0%a6%be%e0%a6%aa%e0%a7%87%e0%a6%b0/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%86%e0%a6%ab%e0%a7%8d%e0%a6%b0%e0%a6%bf%e0%a6%95%e0%a6%be-%e0%a6%a8%e0%a7%87%e0%a6%b6%e0%a6%a8%e0%a6%b8-%e0%a6%95%e0%a6%be%e0%a6%aa%e0%a7%87%e0%a6%b0/</guid>
      <pubDate>Tue, 24 Nov 2026 17:55:05 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%86%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE-%E0%A6%A8%E0%A7%87%E0%A6%B6%E0%A6%A8%E0%A6%B8-%E0%A6%95%E0%A6%BE%E0%A6%AA.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%86%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE-%E0%A6%A8%E0%A7%87%E0%A6%B6%E0%A6%A8%E0%A6%B8-%E0%A6%95%E0%A6%BE%E0%A6%AA.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%86%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE-%E0%A6%A8%E0%A7%87%E0%A6%B6%E0%A6%A8%E0%A6%B8-%E0%A6%95%E0%A6%BE%E0%A6%AA.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আফ্রিকা নেশনস কাপের শিরোপা ফিরে পেল সেনেগাল, চূড়ান্ত রায় ঘোষণা" /&gt;&lt;/p&gt;&lt;p&gt;আন্তর্জাতিক ক্রীড়া আদালতের (সিএএস) রায়ে আফ্রিকা কাপ অব নেশনসের (আফকন) চ্যাম্পিয়নশিপ শিরোপা ফিরে পেল সেনেগাল। মঙ্গলবার (২৪ নভেম্বর) তিন বিচারকের সমন্বয়ে গঠিত সিএএস প্যানেল এই চূড়ান্ত রায় ঘোষণা করে। গত জানুয়ারিতে মরক্কোর রাবাতে অনুষ্ঠিত এক নাটকীয় ও বিশৃঙ্খল ফাইনালে স্বাগতিক মরক্কোকে ১-০ গোলে হারিয়ে শি&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%86%e0%a6%ab%e0%a7%8d%e0%a6%b0%e0%a6%bf%e0%a6%95%e0%a6%be-%e0%a6%a8%e0%a7%87%e0%a6%b6%e0%a6%a8%e0%a6%b8-%e0%a6%95%e0%a6%be%e0%a6%aa%e0%a7%87%e0%a6%b0/">জুমবাংলা</source>
    </item>
    <item>
      <title>ফোন চার্জে রেখে ঘুমান? সারারাত যেসব কাজ করে আপনার স্মার্টফোন</title>
      <link>https://zoombangla.com/%e0%a6%ab%e0%a7%8b%e0%a6%a8-%e0%a6%9a%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%9c%e0%a7%87-%e0%a6%b0%e0%a7%87%e0%a6%96%e0%a7%87-%e0%a6%98%e0%a7%81%e0%a6%ae%e0%a6%be%e0%a6%a8/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%ab%e0%a7%8b%e0%a6%a8-%e0%a6%9a%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%9c%e0%a7%87-%e0%a6%b0%e0%a7%87%e0%a6%96%e0%a7%87-%e0%a6%98%e0%a7%81%e0%a6%ae%e0%a6%be%e0%a6%a8/</guid>
      <pubDate>Tue, 24 Nov 2026 17:54:29 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Charge.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Charge.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Charge.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফোন চার্জে রেখে ঘুমান? সারারাত যেসব কাজ করে আপনার স্মার্টফোন" /&gt;&lt;/p&gt;&lt;p&gt;রাতে ঘুমানোর আগে স্মার্টফোন চার্জে দিয়ে ঘুমিয়ে পড়েন অনেকেই। সকালে উঠে দেখেন ব্যাটারি পুরোপুরি চার্জ হয়ে গেছে। তবে এই সময় ফোনে শুধু ব্যাটারি চার্জ হওয়ার কাজই চলে না। ব্যবহারকারীর অজান্তে ব্যাকগ্রাউন্ডে আরও কিছু গুরুত্বপূর্ণ কাজ সম্পন্ন করে আধুনিক অ্যান্ড্রয়েড ফোন। প্রযুক্তিবিষয়ক ওয়েবসাইট অ্যান্ড্রয়েড&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ab%e0%a7%8b%e0%a6%a8-%e0%a6%9a%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%9c%e0%a7%87-%e0%a6%b0%e0%a7%87%e0%a6%96%e0%a7%87-%e0%a6%98%e0%a7%81%e0%a6%ae%e0%a6%be%e0%a6%a8/">জুমবাংলা</source>
    </item>
    <item>
      <title>খুলনায় কার্যক্রম নিষিদ্ধ আ.লীগ নেতাকে গুলি করে হত্যা</title>
      <link>https://zoombangla.com/%e0%a6%96%e0%a7%81%e0%a6%b2%e0%a6%a8%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%95%e0%a7%8d%e0%a6%b0%e0%a6%ae/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%96%e0%a7%81%e0%a6%b2%e0%a6%a8%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%95%e0%a7%8d%e0%a6%b0%e0%a6%ae/</guid>
      <pubDate>Tue, 24 Nov 2026 17:52:03 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/A-Lig-1.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/A-Lig-1.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/A-Lig-1.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="খুলনায় কার্যক্রম নিষিদ্ধ আ.লীগ নেতাকে গুলি করে হত্যা" /&gt;&lt;/p&gt;&lt;p&gt;খুলনার দৌলতপুরে আব্দুল হালিম (৫০) নামে কার্যক্রম নিষিদ্ধ আওয়ামী লীগের এক নেতাকে গুলি করে হত্যা করা হয়েছে। মঙ্গলবার (২৪ নভেম্বর) রাত সাড়ে ৮টার দিকে দৌলতপুরের কল্পতরু মার্কেট এলাকায় আব্দুল হালিমকে লক্ষ্য করে গুলি করা হয়। তার মাথা ও বুকে গুলি লাগে। হাসপাতালে চিকিৎসাধীন অবস্থায় তার মৃত্যু হয়। আব্দুল হাল&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%96%e0%a7%81%e0%a6%b2%e0%a6%a8%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%95%e0%a7%8d%e0%a6%b0%e0%a6%ae/">জুমবাংলা</source>
    </item>
    <item>
      <title>রাতের আকাশে দেখা মিলবে বিভার সুপারমুন</title>
      <link>https://zoombangla.com/%e0%a6%b0%e0%a6%be%e0%a6%a4%e0%a7%87%e0%a6%b0-%e0%a6%86%e0%a6%95%e0%a6%be%e0%a6%b6%e0%a7%87-%e0%a6%a6%e0%a7%87%e0%a6%96%e0%a6%be-%e0%a6%ae%e0%a6%bf%e0%a6%b2%e0%a6%ac%e0%a7%87/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%b0%e0%a6%be%e0%a6%a4%e0%a7%87%e0%a6%b0-%e0%a6%86%e0%a6%95%e0%a6%be%e0%a6%b6%e0%a7%87-%e0%a6%a6%e0%a7%87%e0%a6%96%e0%a6%be-%e0%a6%ae%e0%a6%bf%e0%a6%b2%e0%a6%ac%e0%a7%87/</guid>
      <pubDate>Tue, 24 Nov 2026 17:49:19 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Moon-2.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Moon-2.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Moon-2.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাতের আকাশে দেখা মিলবে বিভার সুপারমুন" /&gt;&lt;/p&gt;&lt;p&gt;বছরের সবচেয়ে বড় ও উজ্জ্বল পূর্ণিমার চাঁদ দেখতে যাচ্ছে বিশ্ববাসী। মঙ্গলবার (২৪ নভেম্বর) সূর্যাস্তের পর আকাশে দেখা মিলবে ‘বিভার সুপারমুন’-এর। পূর্ণিমার এ বিশেষ চাঁদ রাত ৮টা ৫৩ মিনিটে পূর্ণতম রূপ ধারণ করবে। বাংলাদেশসহ বিশ্বের বিভিন্ন প্রান্ত থেকে দেখা যাবে বিরল এই মহাজাগতিক দৃশ্য। মহাকাশ গবেষণা সংস্থা &lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%b0%e0%a6%be%e0%a6%a4%e0%a7%87%e0%a6%b0-%e0%a6%86%e0%a6%95%e0%a6%be%e0%a6%b6%e0%a7%87-%e0%a6%a6%e0%a7%87%e0%a6%96%e0%a6%be-%e0%a6%ae%e0%a6%bf%e0%a6%b2%e0%a6%ac%e0%a7%87/">জুমবাংলা</source>
    </item>
    <item>
      <title>আ. লীগ নেতাকে সেদ্ধ ডিম, পানি ও কফি খাইয়ে পুলিশে দিলেন নয়ন</title>
      <link>https://zoombangla.com/%e0%a6%86-%e0%a6%b2%e0%a7%80%e0%a6%97-%e0%a6%a8%e0%a7%87%e0%a6%a4%e0%a6%be%e0%a6%95%e0%a7%87-%e0%a6%b8%e0%a7%87%e0%a6%a6%e0%a7%8d%e0%a6%a7-%e0%a6%a1%e0%a6%bf%e0%a6%ae/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%86-%e0%a6%b2%e0%a7%80%e0%a6%97-%e0%a6%a8%e0%a7%87%e0%a6%a4%e0%a6%be%e0%a6%95%e0%a7%87-%e0%a6%b8%e0%a7%87%e0%a6%a6%e0%a7%8d%e0%a6%a7-%e0%a6%a1%e0%a6%bf%e0%a6%ae/</guid>
      <pubDate>Tue, 24 Nov 2026 17:44:57 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%A8%E0%A6%AF%E0%A6%BC%E0%A6%A8.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%A8%E0%A6%AF%E0%A6%BC%E0%A6%A8.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%A8%E0%A6%AF%E0%A6%BC%E0%A6%A8.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আ. লীগ নেতাকে সেদ্ধ ডিম, পানি ও কফি খাইয়ে পুলিশে দিলেন নয়ন" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর পল্টন এলাকায় কার্যক্রম নিষিদ্ধ আওয়ামী লীগের এক নেতাকে আটক করে ব্যতিক্রমীভাবে আপ্যায়ন করেছেন ঢাকা মহানগর দক্ষিণ যুবদলের সদস্যসচিব রবিউল ইসলাম নয়ন। তাকে দুটি সেদ্ধ ডিম, পানি ও কফি খাওয়ানোর পর পুলিশের হাতে তুলে দেন তিনি ও তার অনুসারীরা। মঙ্গলবার (২৪ নভেম্বর) দিবাগত রাতে এ ঘটনা ঘটে। ঘটনার একটি &lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%86-%e0%a6%b2%e0%a7%80%e0%a6%97-%e0%a6%a8%e0%a7%87%e0%a6%a4%e0%a6%be%e0%a6%95%e0%a7%87-%e0%a6%b8%e0%a7%87%e0%a6%a6%e0%a7%8d%e0%a6%a7-%e0%a6%a1%e0%a6%bf%e0%a6%ae/">জুমবাংলা</source>
    </item>
    <item>
      <title>অসুস্থ মাকে দেখতে ১৮ বছর পর প্যারোলে মুক্তি পেলেন মোংলার বাদল</title>
      <link>https://zoombangla.com/%e0%a6%85%e0%a6%b8%e0%a7%81%e0%a6%b8%e0%a7%8d%e0%a6%a5-%e0%a6%ae%e0%a6%be%e0%a6%95%e0%a7%87-%e0%a6%a6%e0%a7%87%e0%a6%96%e0%a6%a4%e0%a7%87-%e0%a7%a7%e0%a7%ae-%e0%a6%ac%e0%a6%9b%e0%a6%b0/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%85%e0%a6%b8%e0%a7%81%e0%a6%b8%e0%a7%8d%e0%a6%a5-%e0%a6%ae%e0%a6%be%e0%a6%95%e0%a7%87-%e0%a6%a6%e0%a7%87%e0%a6%96%e0%a6%a4%e0%a7%87-%e0%a7%a7%e0%a7%ae-%e0%a6%ac%e0%a6%9b%e0%a6%b0/</guid>
      <pubDate>Tue, 24 Nov 2026 16:19:57 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Manus.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Manus.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Manus.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অসুস্থ মাকে দেখতে ১৮ বছর পর প্যারোলে মুক্তি পেলেন মোংলার বাদল" /&gt;&lt;/p&gt;&lt;p&gt;দীর্ঘ ১৮ বছর পরে চার সপ্তাহের জন্য কারাগার থেকে প্যারোলে মুক্তি পেয়েছেন মোংলার বাদল ফরাজী। মঙ্গলবার (২৪ নভেম্বর) সন্ধ্যা সাড়ে ৬টায় বাগেরহাট জেলা কারাগার থেকে পুলিশ প্রহরায় তাকে মোংলা পৌরসভার কুমারখালী এলাকার নিজ বাড়িতে পাঠানো হয়। এর আগে এদিন দুপুর ২টা ২৫ মিনিটে কাশিমপুর কারাগার থেকে তাকে বাগেরহাট জে&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%85%e0%a6%b8%e0%a7%81%e0%a6%b8%e0%a7%8d%e0%a6%a5-%e0%a6%ae%e0%a6%be%e0%a6%95%e0%a7%87-%e0%a6%a6%e0%a7%87%e0%a6%96%e0%a6%a4%e0%a7%87-%e0%a7%a7%e0%a7%ae-%e0%a6%ac%e0%a6%9b%e0%a6%b0/">জুমবাংলা</source>
    </item>
    <item>
      <title>ম্যানেজিং কমিটির সভাপতির হতে লাগবে স্নাতক বা সমমানের ডিগ্রি</title>
      <link>https://zoombangla.com/%e0%a6%ae%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%9c%e0%a6%bf%e0%a6%82-%e0%a6%95%e0%a6%ae%e0%a6%bf%e0%a6%9f%e0%a6%bf%e0%a6%b0/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%ae%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%9c%e0%a6%bf%e0%a6%82-%e0%a6%95%e0%a6%ae%e0%a6%bf%e0%a6%9f%e0%a6%bf%e0%a6%b0/</guid>
      <pubDate>Tue, 24 Nov 2026 16:17:09 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Ministry-of-Education-1.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Ministry-of-Education-1.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Ministry-of-Education-1.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ম্যানেজিং কমিটির সভাপতির হতে লাগবে স্নাতক বা সমমানের ডিগ্রি" /&gt;&lt;/p&gt;&lt;p&gt;বেসরকারি শিক্ষাপ্রতিষ্ঠানের গভর্নিং বডি ও ম্যানেজিং কমিটির সভাপতি হওয়ার ক্ষেত্রে ন্যূনতম শিক্ষাগত যোগ্যতা স্নাতক বা সমমানের ডিগ্রি থাকতে হবে। তবে শিক্ষার প্রসার ও উন্নয়নে বিশেষ অবদান থাকলে সরকার এ শর্ত শিথিল করতে পারবে। সোমবার (২৩ নভেম্বর) শিক্ষা মন্ত্রণালয়ের মাধ্যমিক ও উচ্চশিক্ষা বিভাগের উপসচিব মোহ&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ae%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%9c%e0%a6%bf%e0%a6%82-%e0%a6%95%e0%a6%ae%e0%a6%bf%e0%a6%9f%e0%a6%bf%e0%a6%b0/">জুমবাংলা</source>
    </item>
    <item>
      <title>ডিসেম্বরে পর্দা কাঁপাতে আসছে যেসব সিনেমা</title>
      <link>https://zoombangla.com/%e0%a6%a1%e0%a6%bf%e0%a6%b8%e0%a7%87%e0%a6%ae%e0%a7%8d%e0%a6%ac%e0%a6%b0%e0%a7%87-%e0%a6%aa%e0%a6%b0%e0%a7%8d%e0%a6%a6%e0%a6%be/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%a1%e0%a6%bf%e0%a6%b8%e0%a7%87%e0%a6%ae%e0%a7%8d%e0%a6%ac%e0%a6%b0%e0%a7%87-%e0%a6%aa%e0%a6%b0%e0%a7%8d%e0%a6%a6%e0%a6%be/</guid>
      <pubDate>Tue, 24 Nov 2026 16:15:17 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Shahrukh-2.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Shahrukh-2.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Shahrukh-2.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডিসেম্বরে পর্দা কাঁপাতে আসছে যেসব সিনেমা" /&gt;&lt;/p&gt;&lt;p&gt;বছরের শেষ মাস ডিসেম্বর হতে যাচ্ছে সিনেমাপ্রেমীদের জন্য দারুণ উপভোগ্য। হলিউড থেকে বলিউড—বড় পর্দা ও ওটিটি প্ল্যাটফর্মে মুক্তি পেতে যাচ্ছে একঝাঁক নতুন সিনেমা ও সিরিজ। অ্যাকশন, সায়েন্স ফিকশন, সুপারহিরো অ্যাডভেঞ্চার থেকে অ্যানিমেশন—সব ধরনের দর্শকের জন্যই থাকছে নানা আয়োজন। সবচেয়ে বড় চমক, নতুন সিনেমা নিয়ে &lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%a1%e0%a6%bf%e0%a6%b8%e0%a7%87%e0%a6%ae%e0%a7%8d%e0%a6%ac%e0%a6%b0%e0%a7%87-%e0%a6%aa%e0%a6%b0%e0%a7%8d%e0%a6%a6%e0%a6%be/">জুমবাংলা</source>
    </item>
    <item>
      <title>পুলিশের ঊর্ধ্বতন ১৪ কর্মকর্তাকে বদলি</title>
      <link>https://zoombangla.com/%e0%a6%aa%e0%a7%81%e0%a6%b2%e0%a6%bf%e0%a6%b6%e0%a7%87%e0%a6%b0-%e0%a6%8a%e0%a6%b0%e0%a7%8d%e0%a6%a7%e0%a7%8d%e0%a6%ac%e0%a6%a4%e0%a6%a8-%e0%a7%a7%e0%a7%aa/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%aa%e0%a7%81%e0%a6%b2%e0%a6%bf%e0%a6%b6%e0%a7%87%e0%a6%b0-%e0%a6%8a%e0%a6%b0%e0%a7%8d%e0%a6%a7%e0%a7%8d%e0%a6%ac%e0%a6%a4%e0%a6%a8-%e0%a7%a7%e0%a7%aa/</guid>
      <pubDate>Tue, 24 Nov 2026 16:12:02 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/police-12.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/police-12.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/police-12.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পুলিশের ঊর্ধ্বতন ১৪ কর্মকর্তাকে বদলি" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ পুলিশের ঊর্ধ্বতন ১৪ কর্মকর্তাকে বিভিন্ন পদে বদলি ও পদায়ন করেছে সরকার। মঙ্গলবার (২৪ নভেম্বর) স্বরাষ্ট্র মন্ত্রণালয়ের পুলিশ-১ শাখা থেকে জারি করা পৃথক দুটি প্রজ্ঞাপনে এ তথ্য জানানো হয়। রাষ্ট্রপতির আদেশক্রমে প্রজ্ঞাপন দুটিতে সই করেন উপসচিব তৌছিফ আহমেদ। প্রথম প্রজ্ঞাপন অনুযায়ী, পুলিশের বিশেষ শাখ&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%aa%e0%a7%81%e0%a6%b2%e0%a6%bf%e0%a6%b6%e0%a7%87%e0%a6%b0-%e0%a6%8a%e0%a6%b0%e0%a7%8d%e0%a6%a7%e0%a7%8d%e0%a6%ac%e0%a6%a4%e0%a6%a8-%e0%a7%a7%e0%a7%aa/">জুমবাংলা</source>
    </item>
    <item>
      <title>ধামরাইয়ে নিজ গ্রামে চিরনিদ্রায় অভিনেতা সোহেল খান</title>
      <link>https://zoombangla.com/%e0%a6%a7%e0%a6%be%e0%a6%ae%e0%a6%b0%e0%a6%be%e0%a6%87%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%a8%e0%a6%bf%e0%a6%9c-%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ae%e0%a7%87/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%a7%e0%a6%be%e0%a6%ae%e0%a6%b0%e0%a6%be%e0%a6%87%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%a8%e0%a6%bf%e0%a6%9c-%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ae%e0%a7%87/</guid>
      <pubDate>Tue, 24 Nov 2026 15:07:12 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Sohel-Khan.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Sohel-Khan.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Sohel-Khan.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ধামরাইয়ে নিজ গ্রামে চিরনিদ্রায় অভিনেতা সোহেল খান" /&gt;&lt;/p&gt;&lt;p&gt;ঢাকার ধামরাইয়ে নিজ গ্রামে দাফন করা হয়েছে জনপ্রিয় অভিনেতা সোহেল খানকে। মঙ্গলবার (২৪ নভেম্বর) সন্ধ্যায় উপজেলার চৌহাট ইউনিয়নের রাজাপুর ঈদগাহ মাঠে তার জানাজার নামাজ অনুষ্ঠিত হয়। পরে রাজাপুর কবরস্থানে তাকে দাফন করা হয়। তার মৃত্যুতে শোকের ছায়া নেমে এসেছে গ্রামের বাড়ি ও সহকর্মীদের মধ্যে। মঙ্গলবার সন্ধ্যা ছ&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%a7%e0%a6%be%e0%a6%ae%e0%a6%b0%e0%a6%be%e0%a6%87%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%a8%e0%a6%bf%e0%a6%9c-%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ae%e0%a7%87/">জুমবাংলা</source>

    <item>
      <title>ডায়েট করাতে গিয়ে বিপাকে চিড়িয়াখানা, বয়সের ভারে ওজন কমানো বন্ধ ‘মোটা’ চিতাবাঘের</title>
      <link>https://zoombangla.com/%e0%a6%a1%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%9f-%e0%a6%95%e0%a6%b0%e0%a6%be%e0%a6%a4%e0%a7%87-%e0%a6%97%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87/</link>

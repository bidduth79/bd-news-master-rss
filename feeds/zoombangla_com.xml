      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/1-1-768x517-70.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/1-1-768x517-70.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/1-1-768x517-70.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="Honda CR-V চলবে শুধু hybrid powertrain-এ" /&gt;&lt;/p&gt;&lt;p&gt;Honda জানিয়েছে, সপ্তম প্রজন্মের ২০২৮ মডেল CR-V আগামী বছর আসবে এবং চলবে শুধু নতুন two-motor hybrid system-এ। সঙ্গে থাকবে নতুন platform ও electric AWD unit।The post Honda CR-V চলবে শুধু hybrid powertrain-এ appeared first on ZoomBangla.&lt;/p&gt;</description>
      <source url="https://zoombangla.com/2028-honda-cr-v-hybrid-only/">জুমবাংলা</source>
    </item>
    <item>
      <title>৭ হাজারের বেশি ভুয়া অ্যাকাউন্ট, বিকাশের কাছে ব্যাখ্যা চাইল বাংলাদেশ ব্যাংক</title>
      <link>https://zoombangla.com/%e0%a6%ac%e0%a6%bf%e0%a6%95%e0%a6%be%e0%a6%b6%e0%a7%87-%e0%a7%ad-%e0%a6%b9%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%ac%e0%a7%87%e0%a6%b6%e0%a6%bf-%e0%a6%ad%e0%a7%81%e0%a6%af/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%ac%e0%a6%bf%e0%a6%95%e0%a6%be%e0%a6%b6%e0%a7%87-%e0%a7%ad-%e0%a6%b9%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%ac%e0%a7%87%e0%a6%b6%e0%a6%bf-%e0%a6%ad%e0%a7%81%e0%a6%af/</guid>
      <pubDate>Sat, 14 Nov 2026 18:53:51 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/বিকাশে-৭-হাজারের-বেশি-ভুয়া-অ্যাকাউন্ট.avif" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/বিকাশে-৭-হাজারের-বেশি-ভুয়া-অ্যাকাউন্ট.avif" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/বিকাশে-৭-হাজারের-বেশি-ভুয়া-অ্যাকাউন্ট.avif" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৭ হাজারের বেশি ভুয়া অ্যাকাউন্ট, বিকাশের কাছে ব্যাখ্যা চাইল বাংলাদেশ ব্যাংক" /&gt;&lt;/p&gt;&lt;p&gt;দেশের শীর্ষস্থানীয় মোবাইল ফিন্যান্সিয়াল সার্ভিস (এমএফএস) প্রতিষ্ঠান বিকাশের প্ল্যাটফর্মে ৭ হাজারের বেশি সন্দেহজনক ভুয়া অ্যাকাউন্ট শনাক্ত করেছে বাংলাদেশ ব্যাংক। এসব অ্যাকাউন্টে গ্রাহকের বয়স ১০০ থেকে ১৫০ বছর পর্যন্ত দেখানো হয়েছে। এ ছাড়া বেশ কিছু অ্যাকাউন্টে অস্বাভাবিক মাত্রার লেনদেনের তথ্য পাওয়া গেছে।&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ac%e0%a6%bf%e0%a6%95%e0%a6%be%e0%a6%b6%e0%a7%87-%e0%a7%ad-%e0%a6%b9%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%ac%e0%a7%87%e0%a6%b6%e0%a6%bf-%e0%a6%ad%e0%a7%81%e0%a6%af/">জুমবাংলা</source>
    </item>
    <item>
      <title>১৫ বছর বয়সেই টি-টোয়েন্টিতে বিশ্বরেকর্ড গড়লেন বৈভব</title>
      <link>https://zoombangla.com/%e0%a6%9f%e0%a6%bf-%e0%a6%9f%e0%a7%8b%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%a8%e0%a7%8d%e0%a6%9f%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%ac%e0%a6%b0%e0%a7%87%e0%a6%95%e0%a6%b0/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%9f%e0%a6%bf-%e0%a6%9f%e0%a7%8b%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%a8%e0%a7%8d%e0%a6%9f%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%ac%e0%a6%b0%e0%a7%87%e0%a6%95%e0%a6%b0/</guid>
      <pubDate>Sat, 14 Nov 2026 18:45:42 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/টি-টোয়েন্টিতে-বিশ্বরেকর্ড-গড়লেন-বৈভব.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/টি-টোয়েন্টিতে-বিশ্বরেকর্ড-গড়লেন-বৈভব.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/টি-টোয়েন্টিতে-বিশ্বরেকর্ড-গড়লেন-বৈভব.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="১৫ বছর বয়সেই টি-টোয়েন্টিতে বিশ্বরেকর্ড গড়লেন বৈভব" /&gt;&lt;/p&gt;&lt;p&gt;বয়স মাত্র ১৫ বছর ২৩২ দিন। এই বয়সেই পুরুষদের টি-টোয়েন্টি ক্রিকেটে অধিনায়কত্বের বিশ্বরেকর্ড গড়েছেন ভারতীয় ব্যাটার বৈভব সূর্যবংশী। ২০২৬-২৭ মৌসুমের সৈয়দ মুস্তাক আলী ট্রফিতে বিহারের হয়ে মাঠে নেমে ইতিহাসের পাতায় নাম লিখিয়েছেন এই ভারতীয় তরুণ। ইন্দোরে জয়দেব উনাদকাটের নেতৃত্বাধীন সৌরাষ্ট্রের বিপক্ষে দলকে নেত&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%9f%e0%a6%bf-%e0%a6%9f%e0%a7%8b%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%a8%e0%a7%8d%e0%a6%9f%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%ac%e0%a6%b0%e0%a7%87%e0%a6%95%e0%a6%b0/">জুমবাংলা</source>
    </item>

    <item>
      <title>এবার লোকাল এলসির তথ্য বিনিময়ে নতুন প্ল্যাটফর্ম চালু করল বাংলাদেশ</title>
      <link>https://zoombangla.com/%e0%a6%8f%e0%a6%ac%e0%a6%be%e0%a6%b0-%e0%a6%b2%e0%a7%8b%e0%a6%95%e0%a6%be%e0%a6%b2-%e0%a6%8f%e0%a6%b2%e0%a6%b8%e0%a6%bf%e0%a6%b0-%e0%a6%a4%e0%a6%a5%e0%a7%8d%e0%a6%af/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%8f%e0%a6%ac%e0%a6%be%e0%a6%b0-%e0%a6%b2%e0%a7%8b%e0%a6%95%e0%a6%be%e0%a6%b2-%e0%a6%8f%e0%a6%b2%e0%a6%b8%e0%a6%bf%e0%a6%b0-%e0%a6%a4%e0%a6%a5%e0%a7%8d%e0%a6%af/</guid>
      <pubDate>Sat, 28 Nov 2026 16:08:28 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/BD-Link.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/BD-Link.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/BD-Link.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এবার লোকাল এলসির তথ্য বিনিময়ে নতুন প্ল্যাটফর্ম চালু করল বাংলাদেশ" /&gt;&lt;/p&gt;&lt;p&gt;দেশের অভ্যন্তরীণ বাণিজ্যে ঋণপত্রের (লোকাল এলসি) তথ্য আদান-প্রদান আরও দ্রুত, নিরাপদ ও সাশ্রয়ী করতে ‘বাংলাদেশ রিয়েল-টাইম ট্রেড অ্যারেঞ্জমেন্ট’ (বিএআরটিএ বা বার্তা) চালু করেছে বাংলাদেশ ব্যাংক। শনিবার (২৮ নভেম্বর) বাংলাদেশ ব্যাংক এক সংবাদ বিজ্ঞপ্তিতে এসব তথ্য জানিয়েছে। এ ব্যবস্থায় ব্যাংকগুলো কেন্দ্রীয়ভা&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%8f%e0%a6%ac%e0%a6%be%e0%a6%b0-%e0%a6%b2%e0%a7%8b%e0%a6%95%e0%a6%be%e0%a6%b2-%e0%a6%8f%e0%a6%b2%e0%a6%b8%e0%a6%bf%e0%a6%b0-%e0%a6%a4%e0%a6%a5%e0%a7%8d%e0%a6%af/">জুমবাংলা</source>

    <item>
      <title>ইরানের ধর্মগুরু আয়াতুল্লাহ ওয়াহিদ আর নেই</title>
      <link>https://zoombangla.com/%e0%a6%87%e0%a6%b0%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%a7%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a6%97%e0%a7%81%e0%a6%b0%e0%a7%81-%e0%a6%86%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%a4%e0%a7%81%e0%a6%b2%e0%a7%8d/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%87%e0%a6%b0%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%a7%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a6%97%e0%a7%81%e0%a6%b0%e0%a7%81-%e0%a6%86%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%a4%e0%a7%81%e0%a6%b2%e0%a7%8d/</guid>
      <pubDate>Tue, 17 Nov 2026 17:52:54 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/ইরানের-ধর্মগুরু-আয়াতুল্লাহ-ওয়াহিদ১.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/ইরানের-ধর্মগুরু-আয়াতুল্লাহ-ওয়াহিদ১.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/ইরানের-ধর্মগুরু-আয়াতুল্লাহ-ওয়াহিদ১.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইরানের ধর্মগুরু আয়াতুল্লাহ ওয়াহিদ আর নেই" /&gt;&lt;/p&gt;&lt;p&gt;ইরানের প্রখ্যাত ধর্মীয় নেতা ও কোম সেমিনারির জ্যেষ্ঠ অধ্যাপক গ্র্যান্ড আয়াতুল্লাহ শেখ হুসেইন ওয়াহিদ খোরাসানি মারা গেছেন। মঙ্গলবার (১৭ নভেম্বর) বার্ধক্যজনিত শারীরিক জটিলতায় ১০৫ বছর বয়সে শেষ নিঃশ্বাস ত্যাগ করেন তিনি। মঙ্গলবার তার দপ্তরের এক বিবৃতিতে মৃত্যুর বিষয়টি জানানো হয়। তার মৃত্যুতে শোক প্রকাশ করে&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%87%e0%a6%b0%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%a7%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a6%97%e0%a7%81%e0%a6%b0%e0%a7%81-%e0%a6%86%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%a4%e0%a7%81%e0%a6%b2%e0%a7%8d/">জুমবাংলা</source>
    </item>
    <item>
      <title>কার্যক্রম নিষিদ্ধ আ.লীগ নেতাকর্মীদের হামলায় প্রাণ গেল কৃষক দল নেতার</title>
      <link>https://zoombangla.com/%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%95%e0%a7%8d%e0%a6%b0%e0%a6%ae-%e0%a6%a8%e0%a6%bf%e0%a6%b7%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%a7-%e0%a6%86-%e0%a6%b2%e0%a7%80%e0%a6%97-%e0%a6%a8/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%95%e0%a7%8d%e0%a6%b0%e0%a6%ae-%e0%a6%a8%e0%a6%bf%e0%a6%b7%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%a7-%e0%a6%86-%e0%a6%b2%e0%a7%80%e0%a6%97-%e0%a6%a8/</guid>
      <pubDate>Tue, 17 Nov 2026 17:46:08 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Nata.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Nata.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Nata.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কার্যক্রম নিষিদ্ধ আ.লীগ নেতাকর্মীদের হামলায় প্রাণ গেল কৃষক দল নেতার" /&gt;&lt;/p&gt;&lt;p&gt;ফরিদপুরের ভাঙ্গায় কার্যক্রম নিষিদ্ধ আওয়ামী লীগের নেতাকর্মীদের হামলায় কৃষক দল নেতা রাজু মোল্লা নিহত হয়েছেন। এ সময় তিনটি মোটরসাইকেলে আগুন ধরিয়ে যান চলাচল বন্ধ করে দেয় আওয়ামী লীগের নেতাকর্মীরা। মঙ্গলবার (১৭ নভেম্বর) রাত ৯টার দিকে ফরিদপুর-বরিশাল মহাসড়কের ভাঙ্গা উপজেলার হামিরদী বাসস্টান্ড এলাকায&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%95%e0%a7%8d%e0%a6%b0%e0%a6%ae-%e0%a6%a8%e0%a6%bf%e0%a6%b7%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%a7-%e0%a6%86-%e0%a6%b2%e0%a7%80%e0%a6%97-%e0%a6%a8/">জুমবাংলা</source>
    </item>
    <item>

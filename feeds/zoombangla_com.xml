    <item>
      <title>১ লাখ ৬৫ হাজার কর্মী নেবে ইতালি, যেভাবে আবেদন করবেন</title>
      <link>https://zoombangla.com/%e0%a7%a7-%e0%a6%b2%e0%a6%be%e0%a6%96-%e0%a7%ac%e0%a7%ab-%e0%a6%b9%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0-%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a7%80-%e0%a6%a8%e0%a7%87%e0%a6%ac%e0%a7%87/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a7%a7-%e0%a6%b2%e0%a6%be%e0%a6%96-%e0%a7%ac%e0%a7%ab-%e0%a6%b9%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0-%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a7%80-%e0%a6%a8%e0%a7%87%e0%a6%ac%e0%a7%87/</guid>
      <pubDate>Sun, 15 Nov 2026 19:12:48 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Italy-1.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Italy-1.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Italy-1.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="১ লাখ ৬৫ হাজার কর্মী নেবে ইতালি, যেভাবে আবেদন করবেন" /&gt;&lt;/p&gt;&lt;p&gt;ইউরোপের জনপ্রিয় গন্তব্য ইতালিতে কাজের সুযোগ পাচ্ছেন বাংলাদেশিসহ বিভিন্ন দেশের নাগরিকেরা। বিদেশি কর্মী নিয়োগে ২০২৭ সালের জন্য ১ লাখ ৬৫ হাজার ৮৫০ জন এবং ২০২৮ সালের জন্য ১ লাখ ৬৬ হাজার ৮৫০ জনের কোটা নির্ধারণ করেছে ইতালি সরকার। অর্থাৎ, দুই বছরে মোট ৩ লাখ ৩২ হাজার ৭০০ বিদেশি কর্মী নেওয়া হবে। ইতালির ২০২৬-&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a7%a7-%e0%a6%b2%e0%a6%be%e0%a6%96-%e0%a7%ac%e0%a7%ab-%e0%a6%b9%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0-%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a7%80-%e0%a6%a8%e0%a7%87%e0%a6%ac%e0%a7%87/">জুমবাংলা</source>
    </item>
    <item>
      <title>নবায়নযোগ্য জ্বালানির ব্যবহার বাড়াতে উচ্চ সক্ষমতার বিদ্যুৎ করিডোর বানাচ্ছে ভারত</title>
      <link>https://zoombangla.com/%e0%a6%89%e0%a6%9a%e0%a7%8d%e0%a6%9a-%e0%a6%b8%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%ae%e0%a6%a4%e0%a6%be%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a7%81%e0%a7%8e-%e0%a6%95%e0%a6%b0/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%89%e0%a6%9a%e0%a7%8d%e0%a6%9a-%e0%a6%b8%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%ae%e0%a6%a4%e0%a6%be%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a7%81%e0%a7%8e-%e0%a6%95%e0%a6%b0/</guid>
      <pubDate>Sun, 15 Nov 2026 17:48:02 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/উচ্চ-সক্ষমতার-বিদ্যুৎ-করিডোর-বানাচ্ছে-ভারত.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/উচ্চ-সক্ষমতার-বিদ্যুৎ-করিডোর-বানাচ্ছে-ভারত.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/উচ্চ-সক্ষমতার-বিদ্যুৎ-করিডোর-বানাচ্ছে-ভারত.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নবায়নযোগ্য জ্বালানির ব্যবহার বাড়াতে উচ্চ সক্ষমতার বিদ্যুৎ করিডোর বানাচ্ছে ভারত" /&gt;&lt;/p&gt;&lt;p&gt;ভারতের পশ্চিমাঞ্চলে উৎপাদিত নবায়নযোগ্য বিদ্যুৎ পূর্বাঞ্চলের শিল্প ও শহরাঞ্চলে সরবরাহ করতে বিশাল বিদ্যুৎ সঞ্চালন করিডোর নির্মাণের অনুমোদন দিয়েছে দেশটি। প্রায় ৬৮ হাজার ৮০০ কোটি রুপি (৭৩৪ কোটি মার্কিন ডলার) ব্যয়ের এই মেগা প্রকল্প বাস্তবায়নে সময় লাগবে প্রায় ছয় বছর। ভারতের জাতীয় সঞ্চালন প্যানেল গত মঙ্গলব&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%89%e0%a6%9a%e0%a7%8d%e0%a6%9a-%e0%a6%b8%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%ae%e0%a6%a4%e0%a6%be%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a7%81%e0%a7%8e-%e0%a6%95%e0%a6%b0/">জুমবাংলা</source>
    </item>
    <item>
      <title>সৌদি আরব জুড়ে ব্যাপক ধরপাকড়</title>
      <link>https://zoombangla.com/%e0%a6%b8%e0%a7%8c%e0%a6%a6%e0%a6%bf-%e0%a6%86%e0%a6%b0%e0%a6%ac%e0%a7%87-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%aa%e0%a6%95-%e0%a6%a7%e0%a6%b0%e0%a6%aa%e0%a6%be%e0%a6%95%e0%a6%a1%e0%a6%bc/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%b8%e0%a7%8c%e0%a6%a6%e0%a6%bf-%e0%a6%86%e0%a6%b0%e0%a6%ac%e0%a7%87-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%aa%e0%a6%95-%e0%a6%a7%e0%a6%b0%e0%a6%aa%e0%a6%be%e0%a6%95%e0%a6%a1%e0%a6%bc/</guid>
      <pubDate>Sun, 15 Nov 2026 17:43:28 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/সৌদি-আরবে-ব্যাপক-ধরপাকড়.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/সৌদি-আরবে-ব্যাপক-ধরপাকড়.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/সৌদি-আরবে-ব্যাপক-ধরপাকড়.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সৌদি আরব জুড়ে ব্যাপক ধরপাকড়" /&gt;&lt;/p&gt;&lt;p&gt;আবাসন, শ্রম ও সীমান্ত নিরাপত্তা আইন লঙ্ঘনের বিরুদ্ধে বড় ধরনের অভিযান চালিয়েছে সৌদি আরব। মাত্র এক সপ্তাহে দেশটির বিভিন্ন প্রান্ত থেকে ১১ হাজার ৯৫২ জনকে গ্রেপ্তার করেছে নিরাপত্তা বাহিনী। একই সময়ে আইনি প্রক্রিয়া শেষে ১১ হাজার ৪১৮ জনকে নিজ নিজ দেশে ফেরত পাঠানো হয়েছে। শনিবার (১৪ নভেম্বর) সৌদি স্বরাষ্ট্র &lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%b8%e0%a7%8c%e0%a6%a6%e0%a6%bf-%e0%a6%86%e0%a6%b0%e0%a6%ac%e0%a7%87-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%aa%e0%a6%95-%e0%a6%a7%e0%a6%b0%e0%a6%aa%e0%a6%be%e0%a6%95%e0%a6%a1%e0%a6%bc/">জুমবাংলা</source>
    </item>
    <item>
      <title>জনপ্রিয় বর্ষীয়ান অভিনেতা গিরি বাবু আর নেই</title>
      <link>https://zoombangla.com/%e0%a6%ac%e0%a6%b0%e0%a7%8d%e0%a6%b7%e0%a7%80%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%a8-%e0%a6%85%e0%a6%ad%e0%a6%bf%e0%a6%a8%e0%a7%87%e0%a6%a4%e0%a6%be-%e0%a6%97%e0%a6%bf%e0%a6%b0%e0%a6%bf-%e0%a6%ac/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%ac%e0%a6%b0%e0%a7%8d%e0%a6%b7%e0%a7%80%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%a8-%e0%a6%85%e0%a6%ad%e0%a6%bf%e0%a6%a8%e0%a7%87%e0%a6%a4%e0%a6%be-%e0%a6%97%e0%a6%bf%e0%a6%b0%e0%a6%bf-%e0%a6%ac/</guid>
      <pubDate>Sun, 15 Nov 2026 17:39:21 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/বর্ষীয়ান-অভিনেতা-গিরি-বাবু.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/বর্ষীয়ান-অভিনেতা-গিরি-বাবু.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/বর্ষীয়ান-অভিনেতা-গিরি-বাবু.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জনপ্রিয় বর্ষীয়ান অভিনেতা গিরি বাবু আর নেই" /&gt;&lt;/p&gt;&lt;p&gt;প্রবীণ তেলুগু অভিনেতা গিরি বাবু মারা গেছেন। শনিবার (১৪ নভেম্বর) শেষনিশ্বাস ত্যাগ করেন তিনি। তার মৃত্যুতে শোকের ছায়া নেমে এসেছে তেলুগু চলচ্চিত্র অঙ্গনে। বর্ষীয়ান এই অভিনেতাকে শোক জানিয়েছেন, অভিনেতা চিরঞ্জীবী, পরিচালক অনিল রবিপুড়ি ও অন্ধ্রপ্রদেশের মুখ্যমন্ত্রী এন চন্দ্রবাবু নাইডু। পাঁচ দশকেরও বেশি সময়&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ac%e0%a6%b0%e0%a7%8d%e0%a6%b7%e0%a7%80%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%a8-%e0%a6%85%e0%a6%ad%e0%a6%bf%e0%a6%a8%e0%a7%87%e0%a6%a4%e0%a6%be-%e0%a6%97%e0%a6%bf%e0%a6%b0%e0%a6%bf-%e0%a6%ac/">জুমবাংলা</source>
    </item>
    <item>
      <title>‘আস্তে বলো, অজ্ঞান হয়ে যাব’—বিয়ের গুঞ্জনে কেন বললেন হানিয়া আমির?</title>
      <link>https://zoombangla.com/%e0%a6%b9%e0%a6%be%e0%a6%a8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be-%e0%a6%86%e0%a6%ae%e0%a6%bf%e0%a6%b0/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%b9%e0%a6%be%e0%a6%a8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be-%e0%a6%86%e0%a6%ae%e0%a6%bf%e0%a6%b0/</guid>
      <pubDate>Sun, 15 Nov 2026 17:34:34 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/হানিয়া-আমির.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/হানিয়া-আমির.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/হানিয়া-আমির.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘আস্তে বলো, অজ্ঞান হয়ে যাব’—বিয়ের গুঞ্জনে কেন বললেন হানিয়া আমির?" /&gt;&lt;/p&gt;&lt;p&gt;আগামী ডিসেম্বরে পাকিস্তানি অভিনেত্রী হানিয়া আমির ও সংগীতশিল্পী আসিম আজহার বিয়ে করছেন কি না, তা নিয়ে কয়েক দিন ধরে দেশটির বিনোদন অঙ্গনে গুঞ্জন চলছে। এবার বিষয়টি নিয়ে মুখ খুলেছেন হানিয়া। তবে বিয়ের খবর নিশ্চিত বা অস্বীকার না করে মজার মন্তব্যের মাধ্যমে নতুন করে আলোচনার জন্ম দিয়েছেন এই অভিনেত্রী।&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%b9%e0%a6%be%e0%a6%a8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be-%e0%a6%86%e0%a6%ae%e0%a6%bf%e0%a6%b0/">জুমবাংলা</source>
    </item>
    <item>
      <title>সব শিক্ষাপ্রতিষ্ঠানের জন্য মাউশির নতুন নির্দেশনা</title>
      <link>https://zoombangla.com/%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4%e0%a6%bf%e0%a6%b7%e0%a7%8d%e0%a6%a0%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%9c%e0%a6%a8%e0%a7%8d-3/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4%e0%a6%bf%e0%a6%b7%e0%a7%8d%e0%a6%a0%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%9c%e0%a6%a8%e0%a7%8d-3/</guid>
      <pubDate>Sun, 15 Nov 2026 17:30:10 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/শিক্ষাপ্রতিষ্ঠানের-জন্য-মাউশির-নতুন-নির্দেশনা.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/শিক্ষাপ্রতিষ্ঠানের-জন্য-মাউশির-নতুন-নির্দেশনা.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/শিক্ষাপ্রতিষ্ঠানের-জন্য-মাউশির-নতুন-নির্দেশনা.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সব শিক্ষাপ্রতিষ্ঠানের জন্য মাউশির নতুন নির্দেশনা" /&gt;&lt;/p&gt;&lt;p&gt;সারা দেশের স্কুল-কলেজের জন্য নতুন নির্দেশনা দিয়েছে মাধ্যমিক ও উচ্চশিক্ষা অধিদপ্তর (মাউশি)। নির্দেশনা অনুযায়ী বার্ষিক অ্যাকাডেমিক ক্যালেন্ডার অনুযায়ী সারা বছরব্যাপী খেলাধুলা আয়োজন করতে হবে। রোববার (১৫ নভেম্বর) মাউশির উপপরিচালক (শারীরিক শিক্ষা) প্রফেসর মো: শহিদুল ইসলাম স্বাক্ষরিত এক বিজ্ঞপ্তিতে এ নির্&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4%e0%a6%bf%e0%a6%b7%e0%a7%8d%e0%a6%a0%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%9c%e0%a6%a8%e0%a7%8d-3/">জুমবাংলা</source>
    </item>
    <item>
      <title>ধেয়ে আসছে ঘূর্ণিঝড়, সতর্কতা জারি</title>
      <link>https://zoombangla.com/%e0%a6%a7%e0%a7%87%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%86%e0%a6%b8%e0%a6%9b%e0%a7%87-%e0%a6%98%e0%a7%82%e0%a6%b0%e0%a7%8d%e0%a6%a3%e0%a6%bf%e0%a6%9d%e0%a6%a1%e0%a6%bc/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%a7%e0%a7%87%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%86%e0%a6%b8%e0%a6%9b%e0%a7%87-%e0%a6%98%e0%a7%82%e0%a6%b0%e0%a7%8d%e0%a6%a3%e0%a6%bf%e0%a6%9d%e0%a6%a1%e0%a6%bc/</guid>
      <pubDate>Sun, 15 Nov 2026 17:24:53 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/ধেয়ে-আসছে-ঘূর্ণিঝড়-সতর্কতা-জারি.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/ধেয়ে-আসছে-ঘূর্ণিঝড়-সতর্কতা-জারি.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/ধেয়ে-আসছে-ঘূর্ণিঝড়-সতর্কতা-জারি.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ধেয়ে আসছে ঘূর্ণিঝড়, সতর্কতা জারি" /&gt;&lt;/p&gt;&lt;p&gt;বঙ্গোপসাগরে সৃষ্ট নিম্নচাপটি আরও ঘনীভূত হয়ে সোমবার (১৬ নভেম্বর) ঘূর্ণিঝড়ে রূপ নিতে পারে। বর্তমানে নিম্নচাপটি পায়রা সমুদ্রবন্দর থেকে ১ হাজার ৪৩০ কিলোমিটার দক্ষিণ-পশ্চিমে অবস্থান করছে। এর প্রভাবে সাগর উত্তাল রয়েছে। এ পরিস্থিতিতে দেশের চার সমুদ্রবন্দরে ১ নম্বর দূরবর্তী সতর্ক সংকেত দেখাতে বলেছে আবহাওয়া &lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%a7%e0%a7%87%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%86%e0%a6%b8%e0%a6%9b%e0%a7%87-%e0%a6%98%e0%a7%82%e0%a6%b0%e0%a7%8d%e0%a6%a3%e0%a6%bf%e0%a6%9d%e0%a6%a1%e0%a6%bc/">জুমবাংলা</source>
    </item>
    <item>
      <title>শেয়ারবাজার কারসাজির অভিযোগে সিটি ব্যাংকের শীর্ষ কর্মকর্তাদের নাম</title>
      <link>https://zoombangla.com/%e0%a6%b6%e0%a7%87%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0-%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%b8%e0%a6%be%e0%a6%9c%e0%a6%bf%e0%a6%b0-%e0%a6%85%e0%a6%ad%e0%a6%bf/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%b6%e0%a7%87%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0-%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%b8%e0%a6%be%e0%a6%9c%e0%a6%bf%e0%a6%b0-%e0%a6%85%e0%a6%ad%e0%a6%bf/</guid>
      <pubDate>Sun, 15 Nov 2026 17:19:24 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/শেয়ারবাজার-কারসাজির-অভিযোগে-সিটি-ব্যাংক.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/শেয়ারবাজার-কারসাজির-অভিযোগে-সিটি-ব্যাংক.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/শেয়ারবাজার-কারসাজির-অভিযোগে-সিটি-ব্যাংক.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শেয়ারবাজার কারসাজির অভিযোগে সিটি ব্যাংকের শীর্ষ কর্মকর্তাদের নাম" /&gt;&lt;/p&gt;&lt;p&gt;শেয়ারবাজারে তালিকভুক্ত বেসরকারি খাতের অন্যতম শীর্ষ আর্থিক প্রতিষ্ঠান সিটি ব্যাংকে বড় ধরনের শেয়ার কারসাজির চাঞ্চল্যকর তথ্য উঠে এসেছে। ব্যাংকটির তিন উপব্যবস্থাপনা পরিচালকসহ (ডিএমডি) মোট পাঁচজন কর্মকর্তার বিরুদ্ধে নিজেদের বিনিয়োগ তহবিল অপব্যবহার করে ব্যক্তিগত মুনাফা অর্জনের গুরুতর অভিযোগ পাওয়া গেছে। বা&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%b6%e0%a7%87%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0-%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%b8%e0%a6%be%e0%a6%9c%e0%a6%bf%e0%a6%b0-%e0%a6%85%e0%a6%ad%e0%a6%bf/">জুমবাংলা</source>
    </item>
    <item>
      <title>প্রেমের গুঞ্জনের মধ্যেই মা হওয়ার বিষয়ে মুখ খুললেন অনন্যা পাণ্ডে</title>
      <link>https://zoombangla.com/%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%ae%e0%a7%87%e0%a6%b0-%e0%a6%97%e0%a7%81%e0%a6%9e%e0%a7%8d%e0%a6%9c%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a6%a7%e0%a7%8d%e0%a6%af%e0%a7%87%e0%a6%87/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%ae%e0%a7%87%e0%a6%b0-%e0%a6%97%e0%a7%81%e0%a6%9e%e0%a7%8d%e0%a6%9c%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a6%a7%e0%a7%8d%e0%a6%af%e0%a7%87%e0%a6%87/</guid>
      <pubDate>Sun, 15 Nov 2026 17:11:43 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Ananna-1.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Ananna-1.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Ananna-1.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রেমের গুঞ্জনের মধ্যেই মা হওয়ার বিষয়ে মুখ খুললেন অনন্যা পাণ্ডে" /&gt;&lt;/p&gt;&lt;p&gt;বর্তমানের বলিউড পাড়ায় আলোচনার কেন্দ্রে অভিনেত্রী অনন্যা পাণ্ডে ও অক্ষয় কুমারের ছেলে আরভ ভাটিয়া। দুজনের প্রেমের গুঞ্জনের মাঝেই বিয়ে ও সন্তান নেওয়ার বিষয় খোলামেলা আলোচনা করেছে অনন্যা। সম্প্রতি এক সংবাদমাধ্যমের অনুষ্ঠানে পরিচালক ইমতিয়াজ আলির সঙ্গে উপস্থিত ছিলেন অনন্যা। সেখানে সত্তর ও আশির দশকের অভিন&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%ae%e0%a7%87%e0%a6%b0-%e0%a6%97%e0%a7%81%e0%a6%9e%e0%a7%8d%e0%a6%9c%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a6%a7%e0%a7%8d%e0%a6%af%e0%a7%87%e0%a6%87/">জুমবাংলা</source>
    </item>
    <item>
      <title>এনভিডিয়ার অন্তর্বর্তী সিইও কোলেট ক্রেস</title>
      <link>https://zoombangla.com/%e0%a6%8f%e0%a6%a8%e0%a6%ad%e0%a6%bf%e0%a6%a1%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0-%e0%a6%85%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a6%b0%e0%a7%8d%e0%a6%ac%e0%a6%b0%e0%a7%8d%e0%a6%a4%e0%a7%80-%e0%a6%b8/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%8f%e0%a6%a8%e0%a6%ad%e0%a6%bf%e0%a6%a1%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0-%e0%a6%85%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a6%b0%e0%a7%8d%e0%a6%ac%e0%a6%b0%e0%a7%8d%e0%a6%a4%e0%a7%80-%e0%a6%b8/</guid>
      <pubDate>Sun, 15 Nov 2026 17:09:37 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Nvidia.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Nvidia.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Nvidia.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এনভিডিয়ার অন্তর্বর্তী সিইও কোলেট ক্রেস" /&gt;&lt;/p&gt;&lt;p&gt;বিশ্বখ্যাত চিপ নির্মাতা প্রতিষ্ঠান এনভিডিয়ার (NVIDIA) প্রধান নির্বাহী কর্মকর্তা (সিইও) ও সহপ্রতিষ্ঠাতা জেনসেন হুয়াং পদত্যাগ করেছেন। বৃহস্পতিবার (১২ নভেম্বর) তার পদত্যাগের বিষয়টি প্রকাশের পর কোম্পানিটির পরিচালনা পর্ষদ কোলেট ক্রেস-কে অন্তর্বর্তী সিইও হিসেবে নিয়োগ দিয়েছে। ৩৩ বছর আগে জেনসেন হুয়াং এনভিডি&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%8f%e0%a6%a8%e0%a6%ad%e0%a6%bf%e0%a6%a1%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0-%e0%a6%85%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a6%b0%e0%a7%8d%e0%a6%ac%e0%a6%b0%e0%a7%8d%e0%a6%a4%e0%a7%80-%e0%a6%b8/">জুমবাংলা</source>
    </item>

    <item>
      <title>খুলনায় গুলি করে আ.লীগ নেতাকে হত্যা করেছে দুর্বৃত্তরা</title>
      <link>https://zoombangla.com/%e0%a6%96%e0%a7%81%e0%a6%b2%e0%a6%a8%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%97%e0%a7%81%e0%a6%b2%e0%a6%bf-%e0%a6%95%e0%a6%b0%e0%a7%87-%e0%a6%86-%e0%a6%b2%e0%a7%80%e0%a6%97/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%96%e0%a7%81%e0%a6%b2%e0%a6%a8%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%97%e0%a7%81%e0%a6%b2%e0%a6%bf-%e0%a6%95%e0%a6%b0%e0%a7%87-%e0%a6%86-%e0%a6%b2%e0%a7%80%e0%a6%97/</guid>
      <pubDate>Tue, 24 Nov 2026 18:12:23 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A6%AF%E0%A6%BC-1.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A6%AF%E0%A6%BC-1.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A6%AF%E0%A6%BC-1.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="খুলনায় গুলি করে আ.লীগ নেতাকে হত্যা করেছে দুর্বৃত্তরা" /&gt;&lt;/p&gt;&lt;p&gt;খুলনায় মো. হালিম (৪০) নামের কার্যক্রম নিষিদ্ধ আওয়ামী লীগের এক নেতাকে গুলি করে হত্যা করেছে দুর্বৃত্তরা। মঙ্গলবার (২৪ নভেম্বর) রাত সোয়া ৮টার দিকে নগরীর দৌলতপুর থানাধীন কল্পতরু মাঠের পাশে এ ঘটনা ঘটে। এ হত্যাকাণ্ডসহ মঙ্গলবার সকাল থেকে রাত পর্যন্ত প্রায় নয় ঘণ্টায় খুলনা মহানগরীর ছয়টি স্থানে গুলির ঘটনা ঘটে&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%96%e0%a7%81%e0%a6%b2%e0%a6%a8%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%97%e0%a7%81%e0%a6%b2%e0%a6%bf-%e0%a6%95%e0%a6%b0%e0%a7%87-%e0%a6%86-%e0%a6%b2%e0%a7%80%e0%a6%97/">জুমবাংলা</source>
    </item>

      <source url="https://zoombangla.com/%e0%a6%b8%e0%a7%8d%e0%a6%95%e0%a7%81%e0%a6%b2-%e0%a6%95%e0%a6%b2%e0%a7%87%e0%a6%9c%e0%a7%87%e0%a6%b0-%e0%a6%8f%e0%a6%ae%e0%a6%aa%e0%a6%bf%e0%a6%93/">জুমবাংলা</source>
    </item>
    <item>
      <title>মানুষের মতো প্রাণীদের মাঝেও বন্ধুত্ব হয়, দায়িত্ব পালন করে—বিজ্ঞান কী বলে?</title>
      <link>https://zoombangla.com/%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a7%81%e0%a6%b7%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a6%a4%e0%a7%8b-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%a3%e0%a7%80%e0%a6%a6%e0%a7%87%e0%a6%b0/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a7%81%e0%a6%b7%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a6%a4%e0%a7%8b-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%a3%e0%a7%80%e0%a6%a6%e0%a7%87%e0%a6%b0/</guid>
      <pubDate>Sun, 22 Nov 2026 17:29:35 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/chimpanji.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/chimpanji.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/chimpanji.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মানুষের মতো প্রাণীদের মাঝেও বন্ধুত্ব হয়, দায়িত্ব পালন করে—বিজ্ঞান কী বলে?" /&gt;&lt;/p&gt;&lt;p&gt;“বন্ধুত্ব গড়তে ধীরগতির হও। কিন্তু বন্ধুত্ব হয়ে গেলে প্রতিনিয়তই তার পরিচর্যা করো।”—সক্রেটিসের এই উক্তি অনেক মানুষই মানেন এবং পালন করেন। কারণ বন্ধুত্ব মানুষের সামাজিক সম্পর্কের গুরুত্বপূর্ণ একটি অংশ। কিন্তু প্রাণীদের মধ্যেও কী বন্ধুত্বের সম্পর্ক গড়ে ওঠে? তারাও কী মানুষের মতো বন্ধুত্বের যত্ন নেয়? এসব প&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a7%81%e0%a6%b7%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a6%a4%e0%a7%8b-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%a3%e0%a7%80%e0%a6%a6%e0%a7%87%e0%a6%b0/">জুমবাংলা</source>
    </item>
    <item>
      <title>লাইভে সবার সামনে মেকআপ তুললেন পাকিস্তানি অভিনেত্রী, কেন?</title>
      <link>https://zoombangla.com/%e0%a6%b2%e0%a6%be%e0%a6%87%e0%a6%ad%e0%a7%87-%e0%a6%b8%e0%a6%ac%e0%a6%be%e0%a6%b0-%e0%a6%b8%e0%a6%be%e0%a6%ae%e0%a6%a8%e0%a7%87-%e0%a6%ae%e0%a7%87%e0%a6%95%e0%a6%86%e0%a6%aa/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%b2%e0%a6%be%e0%a6%87%e0%a6%ad%e0%a7%87-%e0%a6%b8%e0%a6%ac%e0%a6%be%e0%a6%b0-%e0%a6%b8%e0%a6%be%e0%a6%ae%e0%a6%a8%e0%a7%87-%e0%a6%ae%e0%a7%87%e0%a6%95%e0%a6%86%e0%a6%aa/</guid>
      <pubDate>Sun, 22 Nov 2026 17:24:01 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Nayika-7.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Nayika-7.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Nayika-7.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="লাইভে সবার সামনে মেকআপ তুললেন পাকিস্তানি অভিনেত্রী, কেন?" /&gt;&lt;/p&gt;&lt;p&gt;শরীরের ওজন ও শারীরিক গঠন নিয়ে সামাজিক যোগাযোগমাধ্যমে নিয়মিত কটাক্ষের শিকার হচ্ছিলেন পাকিস্তানি অভিনেত্রী ও টেলিভিশন উপস্থাপক ভিনা মালিক। এবার সরাসরি লাইভ অনুষ্ঠানে কান্নায় ভেঙে পড়ে সমালোচকদের জবাব দিয়েছেন তিনি। ক্যামেরার সামনেই খুলে ফেলেছেন উঁচু হিলের জুতা, মুছে ফেলেছেন মুখের মেকআপ। পাকিস্তানের একটি&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%b2%e0%a6%be%e0%a6%87%e0%a6%ad%e0%a7%87-%e0%a6%b8%e0%a6%ac%e0%a6%be%e0%a6%b0-%e0%a6%b8%e0%a6%be%e0%a6%ae%e0%a6%a8%e0%a7%87-%e0%a6%ae%e0%a7%87%e0%a6%95%e0%a6%86%e0%a6%aa/">জুমবাংলা</source>
    </item>
    <item>
      <title>বিশ্বের প্রথম আইনি অধিকার পেল হুলবিহীন মৌমাছি</title>
      <link>https://zoombangla.com/%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%ac%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a5%e0%a6%ae-%e0%a6%86%e0%a6%87%e0%a6%a8%e0%a6%bf/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%ac%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a5%e0%a6%ae-%e0%a6%86%e0%a6%87%e0%a6%a8%e0%a6%bf/</guid>
      <pubDate>Sun, 22 Nov 2026 17:18:33 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Moumasi.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Moumasi.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Moumasi.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিশ্বের প্রথম আইনি অধিকার পেল হুলবিহীন মৌমাছি" /&gt;&lt;/p&gt;&lt;p&gt;দক্ষিণ আমেরিকার দেশ পেরুতে বিশ্বের প্রথম পতঙ্গ হিসেবে আইনি অধিকার পেল হুলবিহীন মৌমাছি। হুলহীন মৌমাছির কথা অনেকের অজানা থাকলেও পৃথিবীতে এদের ৬০০টিরও বেশি প্রজাতি রয়েছে। এদের কোনোটি আকারে মাত্র ৫ মিলিমিটার লম্বা হলেও পরাগায়নে এরা অত্যন্ত গুরুত্বপূর্ণ ভূমিকা পালন করে। গত বছর পেরুতে এই মৌমাছিগুলো বিশ্বে&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%ac%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a5%e0%a6%ae-%e0%a6%86%e0%a6%87%e0%a6%a8%e0%a6%bf/">জুমবাংলা</source>
    </item>
    <item>
      <title>বিনামূল্যের পাঠ্যবই বিতরণ শেষ না হওয়া পর্যন্ত নোট-গাইড ছাপা বন্ধ</title>
      <link>https://zoombangla.com/%e0%a6%ac%e0%a6%bf%e0%a6%a8%e0%a6%be%e0%a6%ae%e0%a7%82%e0%a6%b2%e0%a7%8d%e0%a6%af%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a6%be%e0%a6%a0%e0%a7%8d%e0%a6%af%e0%a6%ac%e0%a6%87/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%ac%e0%a6%bf%e0%a6%a8%e0%a6%be%e0%a6%ae%e0%a7%82%e0%a6%b2%e0%a7%8d%e0%a6%af%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a6%be%e0%a6%a0%e0%a7%8d%e0%a6%af%e0%a6%ac%e0%a6%87/</guid>
      <pubDate>Sun, 22 Nov 2026 17:12:50 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Logo-15.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Logo-15.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Logo-15.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিনামূল্যের পাঠ্যবই বিতরণ শেষ না হওয়া পর্যন্ত নোট-গাইড ছাপা বন্ধ" /&gt;&lt;/p&gt;&lt;p&gt;২০২৭ শিক্ষাবর্ষের বিনামূল্যের পাঠ্যবই শিক্ষার্থীদের মধ্যে বিতরণ শেষ না হওয়া পর্যন্ত নোট, গাইড ও অনুশীলনমূলক সহায়ক বইয়ের মুদ্রণ ও বাঁধাই বন্ধ রাখার নির্দেশ দিয়েছে জাতীয় শিক্ষাক্রম ও পাঠ্যপুস্তক বোর্ড (এনসিটিবি)। এ নির্দেশনা অনুযায়ী, আগামী ৩১ ডিসেম্বর পর্যন্ত এসব বইয়ের মুদ্রণ ও বাঁধাই কার্যক্রম বন্ধ র&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ac%e0%a6%bf%e0%a6%a8%e0%a6%be%e0%a6%ae%e0%a7%82%e0%a6%b2%e0%a7%8d%e0%a6%af%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a6%be%e0%a6%a0%e0%a7%8d%e0%a6%af%e0%a6%ac%e0%a6%87/">জুমবাংলা</source>
    </item>
    <item>
      <title>১০ মিনিটের ঝড়ে রিয়ালকে পেছনে ফেলে শীর্ষে বার্সেলোনা</title>
      <link>https://zoombangla.com/%e0%a7%a7%e0%a7%a6-%e0%a6%ae%e0%a6%bf%e0%a6%a8%e0%a6%bf%e0%a6%9f%e0%a7%87%e0%a6%b0-%e0%a6%9d%e0%a6%a1%e0%a6%bc%e0%a7%87/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a7%a7%e0%a7%a6-%e0%a6%ae%e0%a6%bf%e0%a6%a8%e0%a6%bf%e0%a6%9f%e0%a7%87%e0%a6%b0-%e0%a6%9d%e0%a6%a1%e0%a6%bc%e0%a7%87/</guid>
      <pubDate>Sun, 22 Nov 2026 17:10:17 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%B0%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%B2%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%87%E0%A6%9B%E0%A6%A8%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%B6%E0%A7%80%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B8%E0%A7%87%E0%A6%B2%E0%A7%8B%E0%A6%A8%E0%A6%BE-%E0%A6%A4.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%B0%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%B2%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%87%E0%A6%9B%E0%A6%A8%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%B6%E0%A7%80%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B8%E0%A7%87%E0%A6%B2%E0%A7%8B%E0%A6%A8%E0%A6%BE-%E0%A6%A4.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%B0%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%B2%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%87%E0%A6%9B%E0%A6%A8%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%B6%E0%A7%80%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B8%E0%A7%87%E0%A6%B2%E0%A7%8B%E0%A6%A8%E0%A6%BE-%E0%A6%A4.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="১০ মিনিটের ঝড়ে রিয়ালকে পেছনে ফেলে শীর্ষে বার্সেলোনা" /&gt;&lt;/p&gt;&lt;p&gt;ঘরের মাঠ ক্যাম্প ন্যুতে শ্বাসরুদ্ধকর প্রত্যাবর্তনের গল্প লিখে স্প্যানিশ লা লিগার শীর্ষস্থান আরও মজবুত করল বার্সেলোনা। ম্যাচের শুরুতেই দুই গোল হজম এবং প্রথমার্ধে লামিন ইয়ামালের পেনাল্টি মিসের ধাক্কা সামলে দ্বিতীয়ার্ধে মাত্র ১০ মিনিটের ঝড়ে ভিয়ারিয়ালকে ৩–২ ব্যবধানে হারিয়েছে কাতালানরা। এই রোমাঞ্চকর&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a7%a7%e0%a7%a6-%e0%a6%ae%e0%a6%bf%e0%a6%a8%e0%a6%bf%e0%a6%9f%e0%a7%87%e0%a6%b0-%e0%a6%9d%e0%a6%a1%e0%a6%bc%e0%a7%87/">জুমবাংলা</source>
    </item>
    <item>
      <title>মোরগ নিয়ে মামলা করায় ১৫ লাখ টাকা জরিমানা</title>
      <link>https://zoombangla.com/%e0%a6%ae%e0%a7%8b%e0%a6%b0%e0%a6%97-%e0%a6%a8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%ae%e0%a6%be%e0%a6%ae%e0%a6%b2%e0%a6%be-%e0%a6%95%e0%a6%b0%e0%a6%be%e0%a6%af%e0%a6%bc/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%ae%e0%a7%8b%e0%a6%b0%e0%a6%97-%e0%a6%a8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%ae%e0%a6%be%e0%a6%ae%e0%a6%b2%e0%a6%be-%e0%a6%95%e0%a6%b0%e0%a6%be%e0%a6%af%e0%a6%bc/</guid>
      <pubDate>Sun, 22 Nov 2026 17:06:26 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Morog.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Morog.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Morog.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মোরগ নিয়ে মামলা করায় ১৫ লাখ টাকা জরিমানা" /&gt;&lt;/p&gt;&lt;p&gt;সিঙ্গাপুরে রাস্তা পার হওয়া একটি মোরগকে কেন্দ্র করে ঘটে যাওয়া দুর্ঘটনার ঘটনায় চালকের বিরুদ্ধে মামলা করে উল্টো জরিমানার মুখে পড়েছেন এক নারী যাত্রী। আদালত মামলাটি খারিজ করে দিয়ে বাদীকে মামলার আইনি খরচ বাবদ ১৫ হাজার সিঙ্গাপুরিয়ান ডলার পরিশোধের নির্দেশ দিয়েছেন। সিঙ্গাপুরভিত্তিক সংবাদমাধ্যম সিএনএর এক প্রত&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ae%e0%a7%8b%e0%a6%b0%e0%a6%97-%e0%a6%a8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%ae%e0%a6%be%e0%a6%ae%e0%a6%b2%e0%a6%be-%e0%a6%95%e0%a6%b0%e0%a6%be%e0%a6%af%e0%a6%bc/">জুমবাংলা</source>
    </item>
    <item>
      <title>এইচএসসি ও সমমানের পুনর্নিরীক্ষণের ফল প্রকাশের সময় পরিবর্তন</title>
      <link>https://zoombangla.com/%e0%a6%8f%e0%a6%87%e0%a6%9a%e0%a6%8f%e0%a6%b8%e0%a6%b8%e0%a6%bf-%e0%a6%93-%e0%a6%b8%e0%a6%ae%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b0/</link>

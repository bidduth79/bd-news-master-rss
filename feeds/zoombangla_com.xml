      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Jatisongho.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Jatisongho.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Jatisongho.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রোহিঙ্গা গণহত্যার রায়ের পর মিয়ানমারের ওপর আসছে নতুন নিষেধাজ্ঞা" /&gt;&lt;/p&gt;&lt;p&gt;রোহিঙ্গাদের ওপর গণহত্যার দায়ে মিয়ানমারের বিরুদ্ধে আন্তর্জাতিক বিচার আদালতের (আইসিজে) ঐতিহাসিক রায়ের পর দেশটির ওপর আন্তর্জাতিক চাপ বাড়ছে। দীর্ঘদিন বিচারহীনতা, সামরিক দমন-পীড়ন এবং রোহিঙ্গাদের বাস্তুচ্যুত করার অভিযোগে অভিযুক্ত মিয়ানমারের সামরিক কর্তৃপক্ষের বিরুদ্ধে এবার আরও কঠোর নিষেধাজ্ঞার দাবি জোরালো&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ae%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%a8%e0%a6%ae%e0%a6%be%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%93%e0%a6%aa%e0%a6%b0-%e0%a6%86%e0%a6%b8%e0%a6%9b%e0%a7%87/">জুমবাংলা</source>
    </item>
    <item>
      <title>স্কুলে পাঠদানের সময়সূচিতে পরিবর্তন আসছে</title>
      <link>https://zoombangla.com/%e0%a6%b8%e0%a7%8d%e0%a6%95%e0%a7%81%e0%a6%b2%e0%a7%87-%e0%a6%aa%e0%a6%be%e0%a6%a0%e0%a6%a6%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b0/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%b8%e0%a7%8d%e0%a6%95%e0%a7%81%e0%a6%b2%e0%a7%87-%e0%a6%aa%e0%a6%be%e0%a6%a0%e0%a6%a6%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b0/</guid>
      <pubDate>Fri, 20 Nov 2026 12:35:48 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/classroom-school-college.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/classroom-school-college.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/classroom-school-college.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="স্কুলে পাঠদানের সময়সূচিতে পরিবর্তন আসছে" /&gt;&lt;/p&gt;&lt;p&gt;মাধ্যমিক বিদ্যালয়ে পাঠদানের সময়সূচিতে পরিবর্তন আসতে পারে। বিষয়টি নিয়ে প্রাথমিকভাবে আলোচনা হলেও চূড়ান্ত কোনো সিদ্ধান্ত হয়নি। আগামী সপ্তাহে এ বিষয়ে ফের আলোচনা হতে পারে বলে জানা গেছে। শিক্ষা মন্ত্রণালয় এবং মাধ্যমিক ও উচ্চশিক্ষা অধিদপ্তর (মাউশি) সূত্রে জানা গেছে, তাপমাত্রা কমে গেলে বা শৈত্যপ্রবাহ শুরু হ&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%b8%e0%a7%8d%e0%a6%95%e0%a7%81%e0%a6%b2%e0%a7%87-%e0%a6%aa%e0%a6%be%e0%a6%a0%e0%a6%a6%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b0/">জুমবাংলা</source>
    </item>
    <item>
      <title>পৃথিবী থেকে এক আলোক দিবস দূরে নাসার ভয়েজার-১</title>
      <link>https://zoombangla.com/%e0%a6%aa%e0%a7%83%e0%a6%a5%e0%a6%bf%e0%a6%ac%e0%a7%80-%e0%a6%a5%e0%a7%87%e0%a6%95%e0%a7%87-%e0%a6%8f%e0%a6%95-%e0%a6%86%e0%a6%b2%e0%a7%8b%e0%a6%95-%e0%a6%a6%e0%a6%bf%e0%a6%ac%e0%a6%b8/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%aa%e0%a7%83%e0%a6%a5%e0%a6%bf%e0%a6%ac%e0%a7%80-%e0%a6%a5%e0%a7%87%e0%a6%95%e0%a7%87-%e0%a6%8f%e0%a6%95-%e0%a6%86%e0%a6%b2%e0%a7%8b%e0%a6%95-%e0%a6%a6%e0%a6%bf%e0%a6%ac%e0%a6%b8/</guid>
      <pubDate>Fri, 20 Nov 2026 12:27:56 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Voyajar.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Voyajar.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Voyajar.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পৃথিবী থেকে এক আলোক দিবস দূরে নাসার ভয়েজার-১" /&gt;&lt;/p&gt;&lt;p&gt;মানবসৃষ্ট প্রথম মহাকাশযান হিসেবে ঐতিহাসিক মাইলফলক স্পর্শ করল নাসার ৪৯ বছর বয়সী নভোযান ভয়েজার-১; পৃথিবী থেকে এর বর্তমান দূরত্ব প্রায় ২ হাজার ৫৯০ কোটি কিলোমিটার। বুধবার, এটি পৃথিবী থেকে এক ‘লাইট-ডে’ বা এক আলোক-দিবস দূরত্বে পৌঁছানোয় এই মাইলফলক স্পর্শ করে। আলো প্রতি সেকেন্ডে প্রায় ৩ লাখ কিলোমিটার বেগে ছ&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%aa%e0%a7%83%e0%a6%a5%e0%a6%bf%e0%a6%ac%e0%a7%80-%e0%a6%a5%e0%a7%87%e0%a6%95%e0%a7%87-%e0%a6%8f%e0%a6%95-%e0%a6%86%e0%a6%b2%e0%a7%8b%e0%a6%95-%e0%a6%a6%e0%a6%bf%e0%a6%ac%e0%a6%b8/">জুমবাংলা</source>
    </item>
    <item>
      <title>মিস ইউনিভার্সে ব্যস্ত মাহি, ভক্তদের জন্য এলো সুখবর</title>
      <link>https://zoombangla.com/%e0%a6%ae%e0%a6%bf%e0%a6%b8-%e0%a6%87%e0%a6%89%e0%a6%a8%e0%a6%bf%e0%a6%ad%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%b8%e0%a7%87-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%b8%e0%a7%8d%e0%a6%a4/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%ae%e0%a6%bf%e0%a6%b8-%e0%a6%87%e0%a6%89%e0%a6%a8%e0%a6%bf%e0%a6%ad%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%b8%e0%a7%87-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%b8%e0%a7%8d%e0%a6%a4/</guid>
      <pubDate>Fri, 20 Nov 2026 12:26:03 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Mahi-2.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Mahi-2.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Mahi-2.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মিস ইউনিভার্সে ব্যস্ত মাহি, ভক্তদের জন্য এলো সুখবর" /&gt;&lt;/p&gt;&lt;p&gt;মিস ইউনিভার্সের ৭৫তম আসরে বাংলাদেশের প্রতিনিধিত্ব করছেন অভিনেত্রী ও মডেল সামিরা খান মাহি। ইতোমধ্যেই দর্শক ভোটে সেরা ৩০ প্রতিযোগীর তালিকায় জায়গা করে নিয়েছেন তিনি। সামনে দেশের মানুষের সমর্থন ও ভালোবাসা নিয়ে বিশ্বমঞ্চে নিজের সেরাটা দেওয়ার প্রত্যয় জানিয়েছেন এই মডেল-অভিনেত্রী। মিস ইউনিভার্সের মঞ্চে ব্যস্&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ae%e0%a6%bf%e0%a6%b8-%e0%a6%87%e0%a6%89%e0%a6%a8%e0%a6%bf%e0%a6%ad%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%b8%e0%a7%87-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%b8%e0%a7%8d%e0%a6%a4/">জুমবাংলা</source>
    </item>

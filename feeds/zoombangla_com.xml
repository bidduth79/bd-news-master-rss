      <pubDate>Wed, 18 Nov 2026 18:03:53 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A6%BE-%E0%A6%B9%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%8F%E0%A6%A8%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A6%BE-%E0%A6%B9%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%8F%E0%A6%A8%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A6%BE-%E0%A6%B9%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%8F%E0%A6%A8%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাবা হলেন এনদ্রিক, ছেলের নাম রাখলেন কেনদ্রিক" /&gt;&lt;/p&gt;&lt;p&gt;সিঙ্গাপুর জাতীয় স্টেডিয়ামে প্রীতি ম্যাচে ব্রাজিলিয়ান ফরোয়ার্ড এনদ্রিকের গোল উদ্‌যাপনটি ছিল ব্যতিক্রমী। গোল করার পর দুই হাতে ভালোবাসার চিহ্ন দেখিয়ে উড়ন্ত চুমু ছুড়ে দেন রিয়াল মাদ্রিদ তারকা। ম্যাচ শেষে জানা যায়, গোলটি ছিল তার নবজাতক পুত্র ও স্ত্রীর জন্যই। প্রথমবারের মতো বাবা হয়েছেন ২০ বছর বয়স&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ac%e0%a6%be%e0%a6%ac%e0%a6%be-%e0%a6%b9%e0%a6%b2%e0%a7%87%e0%a6%a8-%e0%a6%8f%e0%a6%a8%e0%a6%a6%e0%a7%8d%e0%a6%b0%e0%a6%bf%e0%a6%95-%e0%a6%9b%e0%a7%87%e0%a6%b2%e0%a7%87%e0%a6%b0/">জুমবাংলা</source>
    </item>
    <item>
      <title>ভারত-পাকিস্তানের সুন্দরীর সঙ্গে বাংলাদেশের সামিরা খান মাহি</title>
      <link>https://zoombangla.com/%e0%a6%ad%e0%a6%be%e0%a6%b0%e0%a6%a4-%e0%a6%aa%e0%a6%be%e0%a6%95%e0%a6%bf%e0%a6%b8%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a7%81%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a7%80/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%ad%e0%a6%be%e0%a6%b0%e0%a6%a4-%e0%a6%aa%e0%a6%be%e0%a6%95%e0%a6%bf%e0%a6%b8%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a7%81%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a7%80/</guid>
      <pubDate>Wed, 18 Nov 2026 17:59:04 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4-%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%81%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%B0%E0%A7%80%E0%A6%B0.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4-%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%81%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%B0%E0%A7%80%E0%A6%B0.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4-%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%81%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%B0%E0%A7%80%E0%A6%B0.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভারত-পাকিস্তানের সুন্দরীর সঙ্গে বাংলাদেশের সামিরা খান মাহি" /&gt;&lt;/p&gt;&lt;p&gt;পুয়ের্তো রিকোয় চলছে ৭৫তম ‘মিস ইউনিভার্স’। সুন্দরী বিষয়ক এ প্রতিযোগিতায় বাংলাদেশ থেকে অংশ নিচ্ছেন সামিরা খান মাহি। প্রতিযোগিতার নানা পর্বে অংশ নিয়ে নিয়মিত ছবি-ভিডিও শেয়ার করছেন সোশ্যাল মিডিয়ায়। এবার মাহিকে দেখা গেল প্রতিবেশী দুই দেশের সুন্দরীর সঙ্গে। তারা হলেন ‘মিস ইউনিভার্স ইন্ডিয়া’ কাজিয়া লিজ মেজো &lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ad%e0%a6%be%e0%a6%b0%e0%a6%a4-%e0%a6%aa%e0%a6%be%e0%a6%95%e0%a6%bf%e0%a6%b8%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a7%81%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a7%80/">জুমবাংলা</source>
    </item>
    <item>
      <title>নারায়ণগঞ্জে কৃষক দলের নেতাকে বহিষ্কার</title>
      <link>https://zoombangla.com/%e0%a6%a8%e0%a6%be%e0%a6%b0%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a6%a3%e0%a6%97%e0%a6%9e%e0%a7%8d%e0%a6%9c%e0%a7%87-%e0%a6%95%e0%a7%83%e0%a6%b7%e0%a6%95-%e0%a6%a6%e0%a6%b2%e0%a7%87%e0%a6%b0/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%a8%e0%a6%be%e0%a6%b0%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a6%a3%e0%a6%97%e0%a6%9e%e0%a7%8d%e0%a6%9c%e0%a7%87-%e0%a6%95%e0%a7%83%e0%a6%b7%e0%a6%95-%e0%a6%a6%e0%a6%b2%e0%a7%87%e0%a6%b0/</guid>
      <pubDate>Wed, 18 Nov 2026 17:54:48 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%95%E0%A7%83%E0%A6%B7%E0%A6%95-%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%B9%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A6%B0.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%95%E0%A7%83%E0%A6%B7%E0%A6%95-%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%B9%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A6%B0.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%95%E0%A7%83%E0%A6%B7%E0%A6%95-%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%B9%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A6%B0.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নারায়ণগঞ্জে কৃষক দলের নেতাকে বহিষ্কার" /&gt;&lt;/p&gt;&lt;p&gt;নারায়ণগঞ্জের ফতুল্লায় প্রতিপক্ষের বাড়িতে হামলা ও ভাঙচুরের দৃশ্য মোবাইলে ভিডিও করার সময় আবু ইউসুফ (২৫) নামে এক যুবককে কুপিয়ে হত্যার ঘটনায় ফতুল্লা থানা কৃষক দলের সভাপতি ও জেলা কৃষক দলের যুগ্ম আহ্বায়ক জুয়েল আরমানকে দল থেকে স্থায়ীভাবে বহিষ্কার করা হয়েছে। বুধবার (১৮ নভেম্বর) বাংলাদেশ জাতীয়তাবাদী কৃষক দলে&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%a8%e0%a6%be%e0%a6%b0%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a6%a3%e0%a6%97%e0%a6%9e%e0%a7%8d%e0%a6%9c%e0%a7%87-%e0%a6%95%e0%a7%83%e0%a6%b7%e0%a6%95-%e0%a6%a6%e0%a6%b2%e0%a7%87%e0%a6%b0/">জুমবাংলা</source>
    </item>
    <item>
      <title>২০২৪ সালের মতো সবাইকে আবারও এক মঞ্চে দাঁড়াতে হবে: প্রধানমন্ত্রী</title>
      <link>https://zoombangla.com/%e0%a7%a8%e0%a7%a6%e0%a7%a8%e0%a7%aa-%e0%a6%b8%e0%a6%be%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a6%a4%e0%a7%8b-%e0%a6%b8%e0%a6%ac%e0%a6%be%e0%a6%87%e0%a6%95%e0%a7%87/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a7%a8%e0%a7%a6%e0%a7%a8%e0%a7%aa-%e0%a6%b8%e0%a6%be%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a6%a4%e0%a7%8b-%e0%a6%b8%e0%a6%ac%e0%a6%be%e0%a6%87%e0%a6%95%e0%a7%87/</guid>
      <pubDate>Wed, 18 Nov 2026 17:44:31 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="২০২৪ সালের মতো সবাইকে আবারও এক মঞ্চে দাঁড়াতে হবে: প্রধানমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;কার্যক্রম নিষিদ্ধ আওয়ামী লীগের পুনরুত্থান ঠেকাতে ফ্যাসিবাদবিরোধী সব রাজনৈতিক দলকে ঐক্যবদ্ধ হওয়ার আহ্বান জানিয়েছেন প্রধানমন্ত্রী তারেক রহমান। তিনি বলেছেন, বাংলাদেশকে আর কখনো তাবেদারি রাষ্ট্রে পরিণত হতে দেওয়া হবে না। বুধবার (১৮ নভেম্বর) বিকেলে ত্রয়োদশ জাতীয় সংসদের চতুর্থ অধিবেশনে বক্তব্য দিতে গিয়ে এ আ&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a7%a8%e0%a7%a6%e0%a7%a8%e0%a7%aa-%e0%a6%b8%e0%a6%be%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a6%a4%e0%a7%8b-%e0%a6%b8%e0%a6%ac%e0%a6%be%e0%a6%87%e0%a6%95%e0%a7%87/">জুমবাংলা</source>
    </item>

      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE-3.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE-3.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টানা কমছে স্বর্ণের দাম: নেমেছে এক বছরের মধ্যে সর্বনিম্নে" /&gt;&lt;/p&gt;&lt;p&gt;বিশ্ববাজারে হঠাৎ করে সোনার দাম ২ শতাংশের বেশি কমে যাওয়ায় মূল্যবান এই ধাতুর দর এক বছরেরও বেশি সময়ের মধ্যে সর্বনিম্ন পর্যায়ে নেমে এসেছে। যুক্তরাষ্ট্রের কেন্দ্রীয় ব্যাংক ফেডারেল রিজার্ভ ভবিষ্যতে সুদের হার বাড়াতে পারে—এমন আশঙ্কাই মূলত সোনার বাজারে বড় ধরনের চাপ তৈরি করেছে। বুধবার (২৫ নভেম্বর) রাতে স্পট ম&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%9f%e0%a6%be%e0%a6%a8%e0%a6%be-%e0%a6%95%e0%a6%ae%e0%a6%9b%e0%a7%87-%e0%a6%b8%e0%a7%8d%e0%a6%ac%e0%a6%b0%e0%a7%8d%e0%a6%a3%e0%a7%87%e0%a6%b0-%e0%a6%a6%e0%a6%be%e0%a6%ae/">জুমবাংলা</source>
    </item>
    <item>
      <title>সাত জেলায় নতুন পুলিশ সুপার</title>
      <link>https://zoombangla.com/%e0%a6%b8%e0%a6%be%e0%a6%a4-%e0%a6%9c%e0%a7%87%e0%a6%b2%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%aa%e0%a7%81%e0%a6%b2%e0%a6%bf%e0%a6%b6/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%b8%e0%a6%be%e0%a6%a4-%e0%a6%9c%e0%a7%87%e0%a6%b2%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%aa%e0%a7%81%e0%a6%b2%e0%a6%bf%e0%a6%b6/</guid>
      <pubDate>Thu, 26 Nov 2026 02:18:08 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%B8%E0%A7%81%E0%A6%AA%E0%A6%BE%E0%A6%B0-1.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%B8%E0%A7%81%E0%A6%AA%E0%A6%BE%E0%A6%B0-1.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%B8%E0%A7%81%E0%A6%AA%E0%A6%BE%E0%A6%B0-1.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাত জেলায় নতুন পুলিশ সুপার" /&gt;&lt;/p&gt;&lt;p&gt;বুধবার (২৫ নভেম্বর) স্বরাষ্ট্র মন্ত্রণালয়ের পুলিশ-১ শাখা থেকে এক প্রজ্ঞাপনে এ তথ্য জানানো হয়েছে। এতে সই করেছেন উপসচিব তৌছিফ আহমেদ। প্রজ্ঞাপন অনুযায়ী, সুনামগঞ্জের পুলিশ সুপার করা হয়েছে চট্টগ্রামের উপপুলিশ কমিশনার আমিরুল ইসলামকে, লালমনিরহাটের পুলিশ সুপার করা হয়েছে ডিএমপির উপ-পুলিশ কমিশনার মোহাম্মদ হার&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%b8%e0%a6%be%e0%a6%a4-%e0%a6%9c%e0%a7%87%e0%a6%b2%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%aa%e0%a7%81%e0%a6%b2%e0%a6%bf%e0%a6%b6/">জুমবাংলা</source>
    </item>
    <item>
      <title>ছয় মাসের মধ্যে বায়োমেট্রিক না দিলে বাতিল হবে এনআইডির আবেদন</title>
      <link>https://zoombangla.com/%e0%a6%9b%e0%a6%af%e0%a6%bc-%e0%a6%ae%e0%a6%be%e0%a6%b8%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a6%a7%e0%a7%8d%e0%a6%af%e0%a7%87/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%9b%e0%a6%af%e0%a6%bc-%e0%a6%ae%e0%a6%be%e0%a6%b8%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a6%a7%e0%a7%8d%e0%a6%af%e0%a7%87/</guid>
      <pubDate>Thu, 26 Nov 2026 02:15:56 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AC%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%B2-1.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AC%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%B2-1.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AC%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%B2-1.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ছয় মাসের মধ্যে বায়োমেট্রিক না দিলে বাতিল হবে এনআইডির আবেদন" /&gt;&lt;/p&gt;&lt;p&gt;জাতীয় পরিচয়পত্রের জন্য নিবন্ধনের ছয় মাসের মধ্যে বায়োমেট্রিক তথ্য না দিলে সংশ্লিষ্ট ব্যক্তির আবেদন বাতিল করবে নির্বাচন কমিশন (ইসি)। দীর্ঘদিন ধরে অনিষ্পন্ন থাকা আবেদন নিষ্পত্তির লক্ষ্যে এ সিদ্ধান্ত নিয়েছে সংস্থাটি। মঙ্গলবার (২৪ নভেম্বর) ইসি সচিবালয়ের সিনিয়র সচিব আখতার আহমেদ এ তথ্য জানিয়েছেন। তিনি বলেন&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%9b%e0%a6%af%e0%a6%bc-%e0%a6%ae%e0%a6%be%e0%a6%b8%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a6%a7%e0%a7%8d%e0%a6%af%e0%a7%87/">জুমবাংলা</source>
    </item>
    <item>
      <title>পাসপোর্ট সূচকে দক্ষিণ এশিয়ায় ষষ্ঠ বাংলাদেশ, বিশ্বে ১৯২তম</title>
      <link>https://zoombangla.com/%e0%a6%aa%e0%a6%be%e0%a6%b8%e0%a6%aa%e0%a7%8b%e0%a6%b0%e0%a7%8d%e0%a6%9f-%e0%a6%b8%e0%a7%82%e0%a6%9a%e0%a6%95%e0%a7%87-%e0%a6%a6%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%bf%e0%a6%a3/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%aa%e0%a6%be%e0%a6%b8%e0%a6%aa%e0%a7%8b%e0%a6%b0%e0%a7%8d%e0%a6%9f-%e0%a6%b8%e0%a7%82%e0%a6%9a%e0%a6%95%e0%a7%87-%e0%a6%a6%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%bf%e0%a6%a3/</guid>
      <pubDate>Thu, 26 Nov 2026 02:13:59 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AA%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%9F.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AA%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%9F.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AA%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%9F.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পাসপোর্ট সূচকে দক্ষিণ এশিয়ায় ষষ্ঠ বাংলাদেশ, বিশ্বে ১৯২তম" /&gt;&lt;/p&gt;&lt;p&gt;বিশ্বের পাসপোর্টের শক্তি ও ভ্রমণসুবিধা নিয়ে আর্টন ক্যাপিটলের পাসপোর্ট সূচকে বাংলাদেশের অবস্থান ১৯২তম। দক্ষিণ এশিয়ার দেশগুলোর মধ্যে বাংলাদেশের অবস্থান ষষ্ঠ। বুধবার (২৫ নভেম্বর) প্রতিষ্ঠানটির ওয়েবসাইটে প্রকাশিত হালনাগাদ সূচকে এ তথ্য উঠে এসেছে। আর্টন ক্যাপিটলের পাসপোর্ট ইনডেক্সে বিশ্বের ১৯৯টি দেশের পাস&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%aa%e0%a6%be%e0%a6%b8%e0%a6%aa%e0%a7%8b%e0%a6%b0%e0%a7%8d%e0%a6%9f-%e0%a6%b8%e0%a7%82%e0%a6%9a%e0%a6%95%e0%a7%87-%e0%a6%a6%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%bf%e0%a6%a3/">জুমবাংলা</source>
    </item>
    <item>
      <title>যে ৫ কারণে নতুন করে বাংলাদেশের ওপর ট্রাম্প প্রশাসনের শুল্ক আরোপ</title>
      <link>https://zoombangla.com/%e0%a6%af%e0%a7%87-%e0%a7%ab-%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%a3%e0%a7%87-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%95%e0%a6%b0%e0%a7%87/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%af%e0%a7%87-%e0%a7%ab-%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%a3%e0%a7%87-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%95%e0%a6%b0%e0%a7%87/</guid>
      <pubDate>Wed, 25 Nov 2026 18:44:19 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B6%E0%A6%BE%E0%A6%B8%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A7%81%E0%A6%B2%E0%A7%8D%E0%A6%95.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B6%E0%A6%BE%E0%A6%B8%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A7%81%E0%A6%B2%E0%A7%8D%E0%A6%95.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B6%E0%A6%BE%E0%A6%B8%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A7%81%E0%A6%B2%E0%A7%8D%E0%A6%95.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যে ৫ কারণে নতুন করে বাংলাদেশের ওপর ট্রাম্প প্রশাসনের শুল্ক আরোপ" /&gt;&lt;/p&gt;&lt;p&gt;উৎপাদন খাতে অতিরিক্ত সক্ষমতা ও অন্যায্য বাণিজ্যিক নীতির অভিযোগে বাংলাদেশসহ ১৪টি দেশ ও বাণিজ্যিক অংশীদারের বিরুদ্ধে নতুন করে শুল্ক আরোপের ঘোষণা দিয়েছে যুক্তরাষ্ট্র। মার্কিন বাণিজ্য প্রতিনিধি (ইউএসটিআর) জেমিসন গ্রিয়ার ১৯৭৪ সালের বাণিজ্য আইনের ৩০১ ধারার (সেকশন ৩০১) অধীনে এই সিদ্ধান্ত নিয়েছেন। নতুন করে&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%af%e0%a7%87-%e0%a7%ab-%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%a3%e0%a7%87-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%95%e0%a6%b0%e0%a7%87/">জুমবাংলা</source>
    </item>

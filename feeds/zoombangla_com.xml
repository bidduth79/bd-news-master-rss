    <item>
      <title>মানিকগঞ্জ জাতীয়তাবাদী মুক্তিযোদ্ধা দলের আহ্বায়ক সেলিম, সদস্য সচিব রেজাউল</title>
      <link>https://zoombangla.com/%e0%a6%9c%e0%a7%87%e0%a6%b2%e0%a6%be-%e0%a6%ae%e0%a7%81%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%bf%e0%a6%af%e0%a7%8b%e0%a6%a6%e0%a7%8d%e0%a6%a7%e0%a6%be-%e0%a6%a6%e0%a6%b2/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%9c%e0%a7%87%e0%a6%b2%e0%a6%be-%e0%a6%ae%e0%a7%81%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%bf%e0%a6%af%e0%a7%8b%e0%a6%a6%e0%a7%8d%e0%a6%a7%e0%a6%be-%e0%a6%a6%e0%a6%b2/</guid>
      <pubDate>Sat, 14 Nov 2026 14:53:02 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/IMG_20261114_213509.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/IMG_20261114_213509.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/IMG_20261114_213509.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মানিকগঞ্জ জাতীয়তাবাদী মুক্তিযোদ্ধা দলের আহ্বায়ক সেলিম, সদস্য সচিব রেজাউল" /&gt;&lt;/p&gt;&lt;p&gt;মানিকগঞ্জ প্রতিনিধি: বাংলাদেশ জাতীয়তাবাদী মুক্তিযোদ্ধা দলের মানিকগঞ্জ জেলা শাখার নতুন আহ্বায়ক কমিটি গঠন করা হয়েছে। নবগঠিত এ কমিটিতে বীর মুক্তিযোদ্ধা মোহাম্মদ সেলিমকে আহ্বায়ক এবং বীর মুক্তিযোদ্ধা ডা. এস এম রেজাউলকে সদস্য সচিব করা হয়েছে। গত ৩ নভেম্বর বাংলাদেশ জাতীয়তাবাদী মুক্তিযোদ্ধা দলের কেন্দ্রীয় সভ&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%9c%e0%a7%87%e0%a6%b2%e0%a6%be-%e0%a6%ae%e0%a7%81%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%bf%e0%a6%af%e0%a7%8b%e0%a6%a6%e0%a7%8d%e0%a6%a7%e0%a6%be-%e0%a6%a6%e0%a6%b2/">জুমবাংলা</source>

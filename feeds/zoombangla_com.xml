    </item>
    <item>
      <title>বাংলাদেশ এখন পেঁয়াজ উৎপাদনে ‘স্বয়ংসম্পূর্ণ’, আমদানির প্রয়োজন নেই : ডিএই</title>
      <link>https://zoombangla.com/%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%a6%e0%a7%87%e0%a6%b6-%e0%a6%8f%e0%a6%96%e0%a6%a8-%e0%a6%aa%e0%a7%87%e0%a6%81%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%9c/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%a6%e0%a7%87%e0%a6%b6-%e0%a6%8f%e0%a6%96%e0%a6%a8-%e0%a6%aa%e0%a7%87%e0%a6%81%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%9c/</guid>
      <pubDate>Sun, 22 Nov 2026 16:53:15 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AA%E0%A7%87%E0%A6%81%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%9C-%E0%A6%89%E0%A7%8E%E0%A6%AA%E0%A6%BE%E0%A6%A6%E0%A6%A8.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AA%E0%A7%87%E0%A6%81%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%9C-%E0%A6%89%E0%A7%8E%E0%A6%AA%E0%A6%BE%E0%A6%A6%E0%A6%A8.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AA%E0%A7%87%E0%A6%81%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%9C-%E0%A6%89%E0%A7%8E%E0%A6%AA%E0%A6%BE%E0%A6%A6%E0%A6%A8.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাংলাদেশ এখন পেঁয়াজ উৎপাদনে ‘স্বয়ংসম্পূর্ণ’, আমদানির প্রয়োজন নেই : ডিএই" /&gt;&lt;/p&gt;&lt;p&gt;ব্যাপক ফলন এবং সংরক্ষণ সক্ষমতা বৃদ্ধির ফলে বাংলাদেশ এখন পেঁয়াজ উৎপাদনে স্বয়ংসম্পূর্ণ অবস্থানে পৌঁছেছে। এতে আমদানি নির্ভরতা এড়িয়ে অফ-সিজনেও স্থানীয় বাজারে পেঁয়াজের নির্বিঘ্ন সরবরাহ নিশ্চিত করা সম্ভব হচ্ছে। কৃষি সম্প্রসারণ অধিদপ্তর (ডিএই) জানায়, দেশে বার্ষিক ৩৬ লাখ টন চাহিদার বিপরীতে ৫০.৯০ লাখ টনেরও ব&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%a6%e0%a7%87%e0%a6%b6-%e0%a6%8f%e0%a6%96%e0%a6%a8-%e0%a6%aa%e0%a7%87%e0%a6%81%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%9c/">জুমবাংলা</source>
    </item>
    <item>
      <title>নবম পে স্কেল কার্যকরের প্রস্তুতি, কারিগরি শিক্ষকদের বেতনের হিসাব জমা</title>
      <link>https://zoombangla.com/%e0%a6%a8%e0%a6%ac%e0%a6%ae-%e0%a6%aa%e0%a7%87-%e0%a6%b8%e0%a7%8d%e0%a6%95%e0%a7%87%e0%a6%b2-%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%95%e0%a6%b0%e0%a7%87%e0%a6%b0/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%a8%e0%a6%ac%e0%a6%ae-%e0%a6%aa%e0%a7%87-%e0%a6%b8%e0%a7%8d%e0%a6%95%e0%a7%87%e0%a6%b2-%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%95%e0%a6%b0%e0%a7%87%e0%a6%b0/</guid>
      <pubDate>Sun, 22 Nov 2026 16:22:35 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Sikkha.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Sikkha.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Sikkha.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নবম পে স্কেল কার্যকরের প্রস্তুতি, কারিগরি শিক্ষকদের বেতনের হিসাব জমা" /&gt;&lt;/p&gt;&lt;p&gt;নবম পে স্কেল বাস্তবায়ন হলে এমপিওভুক্ত কারিগরি শিক্ষাপ্রতিষ্ঠানের শিক্ষক-কর্মচারীদের বেতন-ভাতা বাবদ ১ হাজার ২২১ কোটি টাকা প্রয়োজন হবে। এ ব্যয়ের হিসাব তৈরি করে শিক্ষা মন্ত্রণালয়ের কারিগরি ও মাদ্রাসা শিক্ষা বিভাগে পাঠিয়েছে কারিগরি শিক্ষা অধিদপ্তর। নতুন বেতন কাঠামো কার্যকরের প্রস্তুতির অংশ হিসেবে এ হিসা&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%a8%e0%a6%ac%e0%a6%ae-%e0%a6%aa%e0%a7%87-%e0%a6%b8%e0%a7%8d%e0%a6%95%e0%a7%87%e0%a6%b2-%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%95%e0%a6%b0%e0%a7%87%e0%a6%b0/">জুমবাংলা</source>
    </item>
    <item>
      <title>পোশাক রপ্তানিতে আয় ছাড়াল ১০ বিলিয়ন ডলার</title>
      <link>https://zoombangla.com/%e0%a6%aa%e0%a7%8b%e0%a6%b6%e0%a6%be%e0%a6%95-%e0%a6%b0%e0%a6%aa%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%a8%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%86%e0%a6%af%e0%a6%bc/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%aa%e0%a7%8b%e0%a6%b6%e0%a6%be%e0%a6%95-%e0%a6%b0%e0%a6%aa%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%a8%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%86%e0%a6%af%e0%a6%bc/</guid>
      <pubDate>Sun, 22 Nov 2026 16:12:59 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Dress-2.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Dress-2.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Dress-2.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পোশাক রপ্তানিতে আয় ছাড়াল ১০ বিলিয়ন ডলার" /&gt;&lt;/p&gt;&lt;p&gt;বৈশ্বিক অর্থনৈতিক অনিশ্চয়তা, ভূরাজনৈতিক উত্তেজনা, উৎপাদন ব্যয় বৃদ্ধি এবং প্রতিযোগী দেশগুলোর সঙ্গে প্রতিযোগিতা ও অভ্যন্তরীণ নানা চ্যালেঞ্জ মোকাবিলা করে ২১ মাস পর চলতি অর্থবছরের প্রথম তিন মাসে (জুলাই-সেপ্টেম্বর) দেশের তৈরি পোশাক রপ্তানি থেকে আয় ১০ বিলিয়ন ডলারের মাইলফলক ছাড়িয়েছে। এ সময়ে তৈরি পোশাক রপ্ত&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%aa%e0%a7%8b%e0%a6%b6%e0%a6%be%e0%a6%95-%e0%a6%b0%e0%a6%aa%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%a8%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%86%e0%a6%af%e0%a6%bc/">জুমবাংলা</source>
    </item>
    <item>

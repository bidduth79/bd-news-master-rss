      <pubDate>Fri, 27 Nov 2026 15:55:56 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/shatabdi-roy.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/shatabdi-roy.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/shatabdi-roy.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অভিনয়ে শতাব্দী রায়ের কন্যা" /&gt;&lt;/p&gt;&lt;p&gt;ভারতীয় বাংলা সিনেমার জনপ্রিয় অভিনেত্রী শতাব্দী রায় অভিনয় ক্যারিয়ারে অসংখ্য হিট সিনেমা উপহার দিয়েছেন। মায়ের পদচিহ্ন অনুসরণ করে অভিনয়ে নাম লেখাতে যাচ্ছেন তার কন্যা শামিয়ানা ব্যানার্জি। তার ডাক নাম—জুমি। অতনু রায় পরিচালিত ‘ফাতমা’ সিনেমায় কিশোরী জুবেদা চরিত্র রূপায়ন করবেন শতাব্দী কন্যা। কলকাতার মডার্ন হ&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%85%e0%a6%ad%e0%a6%bf%e0%a6%a8%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%b6%e0%a6%a4%e0%a6%be%e0%a6%ac%e0%a7%8d%e0%a6%a6%e0%a7%80/">জুমবাংলা</source>
    </item>
    <item>
      <title>ঢাকায় পৌঁছেছেন রোমানিয়ান পপতারকা ওটিলিয়া</title>
      <link>https://zoombangla.com/%e0%a6%aa%e0%a6%aa%e0%a6%a4%e0%a6%be%e0%a6%b0%e0%a6%95%e0%a6%be-%e0%a6%93%e0%a6%9f%e0%a6%bf%e0%a6%b2%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%aa%e0%a6%aa%e0%a6%a4%e0%a6%be%e0%a6%b0%e0%a6%95%e0%a6%be-%e0%a6%93%e0%a6%9f%e0%a6%bf%e0%a6%b2%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be/</guid>
      <pubDate>Fri, 27 Nov 2026 15:53:14 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Nayika-13.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Nayika-13.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Nayika-13.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঢাকায় পৌঁছেছেন রোমানিয়ান পপতারকা ওটিলিয়া" /&gt;&lt;/p&gt;&lt;p&gt;চার বছর পর আবারও ঢাকার মঞ্চ মাতাতে আসছেন ‘বিলিয়নেরা’ খ্যাত বিশ্বনন্দিত রোমানিয়ান পপতারকা ওটিলিয়া। ‘ওটিলিয়া রিটার্নস : বিলিয়নেরা লাইভ ইন ঢাকা’ শীর্ষক এই কনসার্টে আন্তর্জাতিক সংগীতের সঙ্গে দেশীয় সুরের মেলবন্ধন ঘটাতে বাড়তি চমক হিসেবে থাকছেন বাংলাদেশের জনপ্রিয় সংগীতশিল্পী ফুয়াদ আল মুক্তাদির ও তার ব্যান্&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%aa%e0%a6%aa%e0%a6%a4%e0%a6%be%e0%a6%b0%e0%a6%95%e0%a6%be-%e0%a6%93%e0%a6%9f%e0%a6%bf%e0%a6%b2%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be/">জুমবাংলা</source>
    </item>
    <item>
      <title>দুই ছাত্রীকে বিয়ে করে তালাক, এবার আরেক ছাত্রী নিয়ে পালালেন শিক্ষক</title>
      <link>https://zoombangla.com/%e0%a6%a6%e0%a7%81%e0%a6%87-%e0%a6%9b%e0%a6%be%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a7%80%e0%a6%95%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%a6%e0%a7%81%e0%a6%87-%e0%a6%9b%e0%a6%be%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a7%80%e0%a6%95%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87/</guid>
      <pubDate>Fri, 27 Nov 2026 15:51:56 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/News-a-9.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/News-a-9.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/News-a-9.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দুই ছাত্রীকে বিয়ে করে তালাক, এবার আরেক ছাত্রী নিয়ে পালালেন শিক্ষক" /&gt;&lt;/p&gt;&lt;p&gt;সিরাজগঞ্জের উল্লাপাড়ায় দশম শ্রেণির এক ছাত্রীকে নিয়ে পালিয়ে যাওয়ার অভিযোগে মো. রাজিব হোসেন (৩৮) নামে এক প্রাইভেট শিক্ষককে গ্রেপ্তার করেছে স্পেশাল রেসপন্স ব্যাটালিয়ন (এসআরবি)। এ সময় ওই ছাত্রীকেও উদ্ধার করা হয়েছে। ফরিদপুর থেকে তাদের গ্রেপ্তার ও উদ্ধারের পর সিরাজগঞ্জে নেওয়ার প্রক্রিয়া চলছে। অভিযোগ রয়েছে&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%a6%e0%a7%81%e0%a6%87-%e0%a6%9b%e0%a6%be%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a7%80%e0%a6%95%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87/">জুমবাংলা</source>
    </item>
    <item>
      <title>চলিত মাসের ২৫ দিনে রেমিট্যান্স এলো ৩১ হাজার ৮৩০ কোটি টাকা</title>
      <link>https://zoombangla.com/%e0%a6%9a%e0%a6%b2%e0%a6%bf%e0%a6%a4-%e0%a6%ae%e0%a6%be%e0%a6%b8%e0%a7%87%e0%a6%b0-%e0%a7%a8%e0%a7%ab-%e0%a6%a6%e0%a6%bf%e0%a6%a8%e0%a7%87/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%9a%e0%a6%b2%e0%a6%bf%e0%a6%a4-%e0%a6%ae%e0%a6%be%e0%a6%b8%e0%a7%87%e0%a6%b0-%e0%a7%a8%e0%a7%ab-%e0%a6%a6%e0%a6%bf%e0%a6%a8%e0%a7%87/</guid>
      <pubDate>Fri, 27 Nov 2026 15:49:33 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Logo-22.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Logo-22.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Logo-22.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চলিত মাসের ২৫ দিনে রেমিট্যান্স এলো ৩১ হাজার ৮৩০ কোটি টাকা" /&gt;&lt;/p&gt;&lt;p&gt;চলতি বছরের নভেম্বর মাসের প্রথম ২৫ দিনে দেশে প্রবাসী আয় বা রেমিট্যান্স এসেছে ২৫৬ কোটি ৭০ লাখ মার্কিন ডলার, যা দেশীয় মুদ্রায় ৩১ হাজার ৮৩০ কোটি ৮০ লাখ টাকা। এর মধ্যে গতকাল বুধবার (২৫ নভেম্বর) প্রবাসী আয় এসেছে ছয় কোটি ৯০ লাখ ডলার বা ৮৫৫ কোটি ৬০ লাখ টাকা। বৃহস্পতিবার (২৬ নভেম্বর) বাংলাদেশ ব্যাংকের মুখপাত&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%9a%e0%a6%b2%e0%a6%bf%e0%a6%a4-%e0%a6%ae%e0%a6%be%e0%a6%b8%e0%a7%87%e0%a6%b0-%e0%a7%a8%e0%a7%ab-%e0%a6%a6%e0%a6%bf%e0%a6%a8%e0%a7%87/">জুমবাংলা</source>
    </item>
    <item>
      <title>ছেলেকে নিয়ে হলিউড সাইন দেখতে গেলেন শাবনূর</title>
      <link>https://zoombangla.com/%e0%a6%9b%e0%a7%87%e0%a6%b2%e0%a7%87%e0%a6%95%e0%a7%87-%e0%a6%a8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%b9%e0%a6%b2%e0%a6%bf%e0%a6%89%e0%a6%a1-%e0%a6%b8%e0%a6%be%e0%a6%87%e0%a6%a8/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%9b%e0%a7%87%e0%a6%b2%e0%a7%87%e0%a6%95%e0%a7%87-%e0%a6%a8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%b9%e0%a6%b2%e0%a6%bf%e0%a6%89%e0%a6%a1-%e0%a6%b8%e0%a6%be%e0%a6%87%e0%a6%a8/</guid>
      <pubDate>Fri, 27 Nov 2026 15:46:49 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Actor-3.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Actor-3.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Actor-3.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ছেলেকে নিয়ে হলিউড সাইন দেখতে গেলেন শাবনূর" /&gt;&lt;/p&gt;&lt;p&gt;ঢালিউডের একসময়ের জনপ্রিয় চিত্রনায়িকা শাবনূর। ঘুরে বেড়াতে বেশ পছন্দ করেন তিনি, সুযোগ পেলেই ছুটে যান নতুন কোনো গন্তব্যে। সেই ভ্রমণের মুহূর্তগুলো আবার ভক্তদের সঙ্গে ভাগ করে নেন সামাজিক যোগাযোগমাধ্যমে। এবার ছেলেকে সঙ্গে নিয়ে যুক্তরাষ্ট্রের হলিউডে ঘুরে বেড়ানোর কয়েকটি স্থিরচিত্র ফেসবুকে প্রকাশ করেছেন এ অভ&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%9b%e0%a7%87%e0%a6%b2%e0%a7%87%e0%a6%95%e0%a7%87-%e0%a6%a8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%b9%e0%a6%b2%e0%a6%bf%e0%a6%89%e0%a6%a1-%e0%a6%b8%e0%a6%be%e0%a6%87%e0%a6%a8/">জুমবাংলা</source>
    </item>
    <item>
      <title>কেরানীগঞ্জে তিন হাজার একর জমিতে সেকেন্ডারি সিটি গড়ার পরিকল্পনা</title>
      <link>https://zoombangla.com/%e0%a6%95%e0%a7%87%e0%a6%b0%e0%a6%be%e0%a6%a8%e0%a7%80%e0%a6%97%e0%a6%9e%e0%a7%8d%e0%a6%9c%e0%a7%87-%e0%a6%a4%e0%a6%bf%e0%a6%a8-%e0%a6%b9%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%95%e0%a7%87%e0%a6%b0%e0%a6%be%e0%a6%a8%e0%a7%80%e0%a6%97%e0%a6%9e%e0%a7%8d%e0%a6%9c%e0%a7%87-%e0%a6%a4%e0%a6%bf%e0%a6%a8-%e0%a6%b9%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0/</guid>
      <pubDate>Fri, 27 Nov 2026 15:02:23 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Dhaka-2.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Dhaka-2.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Dhaka-2.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কেরানীগঞ্জে তিন হাজার একর জমিতে সেকেন্ডারি সিটি গড়ার পরিকল্পনা" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানী ঢাকার জনসংখ্যা ও আবাসনের চাপ কমাতে কেরানীগঞ্জে তিন হাজার একর জমিতে সেকেন্ডারি সিটি গড়ে তোলার পরিকল্পনা নিয়েছে সরকার। রাজধানীর পাশে নাগরিক সুবিধাসম্পন্ন পরিকল্পিত জনবসতি গড়ে তোলাই এ প্রকল্পের মূল লক্ষ্য। এর মাধ্যমে ঢাকার মূল নগর এলাকার বাইরে বসবাসের বিকল্প সুযোগ তৈরি হবে। সংশ্লিষ্ট কর্মকর্তার&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%95%e0%a7%87%e0%a6%b0%e0%a6%be%e0%a6%a8%e0%a7%80%e0%a6%97%e0%a6%9e%e0%a7%8d%e0%a6%9c%e0%a7%87-%e0%a6%a4%e0%a6%bf%e0%a6%a8-%e0%a6%b9%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0/">জুমবাংলা</source>
    </item>
    <item>
      <title>বাংলাদেশি খাবার সুস্বাদু, তবে একটু বেশিই ঝাল : ওটিলিয়া</title>
      <link>https://zoombangla.com/%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a6%bf-%e0%a6%96%e0%a6%be%e0%a6%ac%e0%a6%be%e0%a6%b0/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a6%bf-%e0%a6%96%e0%a6%be%e0%a6%ac%e0%a6%be%e0%a6%b0/</guid>
      <pubDate>Fri, 27 Nov 2026 14:36:42 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/olita.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/olita.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/olita.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাংলাদেশি খাবার সুস্বাদু, তবে একটু বেশিই ঝাল : ওটিলিয়া" /&gt;&lt;/p&gt;&lt;p&gt;প্রায় এক দশক আগে ‘বিলিওনেরা’ গান দিয়ে বিশ্বজুড়ে আলোড়ন সৃষ্টি করেছিলেন রোমানিয়ান পপতারকা ওটিলিয়া ব্রুমা। ইংরেজি ও স্প্যানিশ ভাষার মিশেলে তৈরি গানটি বাংলাদেশের শ্রোতাদের কাছেও ব্যাপক জনপ্রিয়তা পায়। সেই সুবাদে বাংলাদেশেও তৈরি হয় তার অসংখ্য ভক্ত। ২০২২ সালের পর দ্বিতীয়বারের মতো ঢাকায় এসেছেন এই সংগীতশিল্প&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a6%bf-%e0%a6%96%e0%a6%be%e0%a6%ac%e0%a6%be%e0%a6%b0/">জুমবাংলা</source>
    </item>
    <item>
      <title>ভাইরাল ভিডিও নিয়ে ইনফ্লুয়েন্সারকে দেয়া লিগ্যাল নোটিশ ভুয়া : শাহরুখ খানের আইন সংস্থা</title>
      <link>https://zoombangla.com/%e0%a6%ad%e0%a6%be%e0%a6%87%e0%a6%b0%e0%a6%be%e0%a6%b2-%e0%a6%ad%e0%a6%bf%e0%a6%a1%e0%a6%bf%e0%a6%93-%e0%a6%a8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%ad%e0%a6%be%e0%a6%87%e0%a6%b0%e0%a6%be%e0%a6%b2-%e0%a6%ad%e0%a6%bf%e0%a6%a1%e0%a6%bf%e0%a6%93-%e0%a6%a8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87/</guid>
      <pubDate>Fri, 27 Nov 2026 14:33:23 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/srk-1795775618.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/srk-1795775618.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/srk-1795775618.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভাইরাল ভিডিও নিয়ে ইনফ্লুয়েন্সারকে দেয়া লিগ্যাল নোটিশ ভুয়া : শাহরুখ খানের আইন সংস্থা" /&gt;&lt;/p&gt;&lt;p&gt;শিল্পপতি মুকেশ আম্বানির ছেলে অনন্ত আম্বানি ও আধ্যাত্মিক গুরু সদগুরুর সঙ্গে জড়িয়ে একটি ভিডিও ভাইরাল হওয়াকে কেন্দ্র করে ইনফ্লুয়েন্সার সুভিগ্য শর্মাকে লিগ্যাল নোটিশ পাঠানোর খবর নাকচ করেছে শাহরুখ খানের আইন সংস্থা। অভিনেতার অনুমোদিত আইন সংস্থা হিরানি অ্যান্ড অ্যাসোসিয়েটস স্পষ্ট জানিয়েছে, ওই লিগ্যাল নোটিশ&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ad%e0%a6%be%e0%a6%87%e0%a6%b0%e0%a6%be%e0%a6%b2-%e0%a6%ad%e0%a6%bf%e0%a6%a1%e0%a6%bf%e0%a6%93-%e0%a6%a8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87/">জুমবাংলা</source>
    </item>
    <item>
      <title>৮৬ হাজার মসজিদ-মন্দির-গির্জা-প্যাগোডায় দেওয়া হচ্ছে সম্মানি ভাতা</title>
      <link>https://zoombangla.com/%e0%a7%ae%e0%a7%ac-%e0%a6%b9%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0-%e0%a6%ae%e0%a6%b8%e0%a6%9c%e0%a6%bf%e0%a6%a6-%e0%a6%ae%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%bf%e0%a6%b0/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a7%ae%e0%a7%ac-%e0%a6%b9%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0-%e0%a6%ae%e0%a6%b8%e0%a6%9c%e0%a6%bf%e0%a6%a6-%e0%a6%ae%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%bf%e0%a6%b0/</guid>
      <pubDate>Fri, 27 Nov 2026 14:08:44 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Logo-21.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Logo-21.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Logo-21.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৮৬ হাজার মসজিদ-মন্দির-গির্জা-প্যাগোডায় দেওয়া হচ্ছে সম্মানি ভাতা" /&gt;&lt;/p&gt;&lt;p&gt;দেশের ৮৬ হাজার ৭০৯টি মসজিদ, মন্দির, গির্জা ও বৌদ্ধ বিহারে কর্মরত ২ লাখ ৫৬ হাজার ৭৪ জন ধর্মীয় নেতা ও সেবাকর্মীকে সম্মানি ভাতা দিচ্ছে সরকার। আগামী ২ ডিসেম্বর কুষ্টিয়া সদরে প্রধানমন্ত্রী তারেক রহমান এ কর্মসূচির দ্বিতীয় পর্যায়ের আনুষ্ঠানিক উদ্বোধন করবেন বলে আশা করা হচ্ছে। ২০২৬-২৭ অর্থবছরে এ কর্মসূচি&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a7%ae%e0%a7%ac-%e0%a6%b9%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0-%e0%a6%ae%e0%a6%b8%e0%a6%9c%e0%a6%bf%e0%a6%a6-%e0%a6%ae%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%bf%e0%a6%b0/">জুমবাংলা</source>
    </item>

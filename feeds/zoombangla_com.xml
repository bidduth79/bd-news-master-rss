      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%8F%E0%A6%A8%E0%A6%AD%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%B0-%E0%A6%B6%E0%A7%80%E0%A6%B0%E0%A7%8D%E0%A6%B7-%E0%A6%AA%E0%A6%A6%E0%A7%87-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A6%B8%E0%A7%87%E0%A6%A8-%E0%A6%B9%E0%A7%81%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%82.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পদত্যাগের ১১ দিন পর এনভিডিয়ার শীর্ষ পদে ফিরলেন জেনসেন হুয়াং" /&gt;&lt;/p&gt;&lt;p&gt;চিপ নির্মাতা প্রতিষ্ঠান এনভিডিয়ার প্রেসিডেন্ট, প্রধান নির্বাহী কর্মকর্তা (সিইও) ও পরিচালনা পর্ষদের পরিচালক পদে পুনর্বহাল হয়েছেন জেনসেন হুয়াং। পদত্যাগের মাত্র ১১ দিন পর তাকে আবারও কোম্পানির শীর্ষ নেতৃত্বে ফিরিয়ে আনার সিদ্ধান্ত নিয়েছে পরিচালনা পর্ষদ। সোমবার এক বিবৃতিতে এনভিডিয়া জানিয়েছে, হুয়াংয়ের পদত্&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%aa%e0%a6%a6%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%97%e0%a7%87%e0%a6%b0-%e0%a7%a7%e0%a7%a7-%e0%a6%a6%e0%a6%bf%e0%a6%a8-%e0%a6%aa%e0%a6%b0/">জুমবাংলা</source>
    </item>
    <item>
      <title>রোহিঙ্গা ইস্যুতে মিয়ানমারের ওপর চাপ বাড়াতে যুক্তরাজ্যকে ঢাকার আহ্বান</title>
      <link>https://zoombangla.com/%e0%a6%b0%e0%a7%8b%e0%a6%b9%e0%a6%bf%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a6%be-%e0%a6%87%e0%a6%b8%e0%a7%8d%e0%a6%af%e0%a7%81%e0%a6%a4%e0%a7%87/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%b0%e0%a7%8b%e0%a6%b9%e0%a6%bf%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a6%be-%e0%a6%87%e0%a6%b8%e0%a7%8d%e0%a6%af%e0%a7%81%e0%a6%a4%e0%a7%87/</guid>
      <pubDate>Mon, 23 Nov 2026 17:18:58 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%87%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A7%81.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%87%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A7%81.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%87%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A7%81.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রোহিঙ্গা ইস্যুতে মিয়ানমারের ওপর চাপ বাড়াতে যুক্তরাজ্যকে ঢাকার আহ্বান" /&gt;&lt;/p&gt;&lt;p&gt;রোহিঙ্গা সংকটের টেকসই সমাধান এবং জলবায়ু খাতে বিনিয়োগ বাড়াতে যুক্তরাজ্যের সহযোগিতা চেয়েছে বাংলাদেশ। বিশেষ করে রোহিঙ্গাদের বিরুদ্ধে গণহত্যার ঘটনায় আন্তর্জাতিক বিচার আদালতের (আইসিজে) রায় বাস্তবায়নে মিয়ানমারের ওপর আন্তর্জাতিক চাপ জোরদার করার আহ্বান জানিয়েছে ঢাকা। সোমবার (২৩ নভেম্বর) পররাষ্ট্র প্রতিমন্ত্&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%b0%e0%a7%8b%e0%a6%b9%e0%a6%bf%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a6%be-%e0%a6%87%e0%a6%b8%e0%a7%8d%e0%a6%af%e0%a7%81%e0%a6%a4%e0%a7%87/">জুমবাংলা</source>
    </item>
    <item>
      <title>শিক্ষাপ্রতিষ্ঠান-শিল্পপ্রতিষ্ঠানের সংযোগ বাড়ালে কর্মসংস্থান বাড়বে:শিক্ষামন্ত্রী</title>
      <link>https://zoombangla.com/%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4%e0%a6%bf%e0%a6%b7%e0%a7%8d%e0%a6%a0%e0%a6%be%e0%a6%a8/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4%e0%a6%bf%e0%a6%b7%e0%a7%8d%e0%a6%a0%e0%a6%be%e0%a6%a8/</guid>
      <pubDate>Mon, 23 Nov 2026 17:14:15 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%A1.-%E0%A6%86-%E0%A6%A8-%E0%A6%AE-%E0%A6%8F%E0%A6%B9%E0%A6%9B%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B2-%E0%A6%B9%E0%A6%95-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%A8.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%A1.-%E0%A6%86-%E0%A6%A8-%E0%A6%AE-%E0%A6%8F%E0%A6%B9%E0%A6%9B%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B2-%E0%A6%B9%E0%A6%95-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%A8.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%A1.-%E0%A6%86-%E0%A6%A8-%E0%A6%AE-%E0%A6%8F%E0%A6%B9%E0%A6%9B%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B2-%E0%A6%B9%E0%A6%95-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%A8.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শিক্ষাপ্রতিষ্ঠান-শিল্পপ্রতিষ্ঠানের সংযোগ বাড়ালে কর্মসংস্থান বাড়বে:শিক্ষামন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;শিক্ষা এবং প্রাথমিক ও গণশিক্ষামন্ত্রী ড. আ ন ম এহছানুল হক মিলন বলেছেন, শিক্ষাপ্রতিষ্ঠান ও শিল্পপ্রতিষ্ঠানের মধ্যে সংযোগ (ইন্ডাস্ট্রি-একাডেমিয়া লিংকেজ) বাড়াতে সরকার কাজ করছে। এ সংযোগ কার্যকর হলে শিক্ষার্থীদের কর্মসংস্থানের সুযোগ বাড়বে। এটি বাস্তবায়নে বিশ্ববিদ্যালয় মঞ্জুরি কমিশন (ইউজিসি) কাজ করছে। সোম&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4%e0%a6%bf%e0%a6%b7%e0%a7%8d%e0%a6%a0%e0%a6%be%e0%a6%a8/">জুমবাংলা</source>
    </item>
    <item>
      <title>সাটুরিয়ায় নাশকতার মামলায় আওয়ামী লীগ নেতা গ্রেপ্তার</title>
      <link>https://zoombangla.com/%e0%a6%b8%e0%a6%be%e0%a6%9f%e0%a7%81%e0%a6%b0%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%a8%e0%a6%be%e0%a6%b6%e0%a6%95%e0%a6%a4%e0%a6%be%e0%a6%b0/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%b8%e0%a6%be%e0%a6%9f%e0%a7%81%e0%a6%b0%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%a8%e0%a6%be%e0%a6%b6%e0%a6%95%e0%a6%a4%e0%a6%be%e0%a6%b0/</guid>
      <pubDate>Mon, 23 Nov 2026 17:11:31 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/InShot_20261123_230826328.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/InShot_20261123_230826328.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/InShot_20261123_230826328.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাটুরিয়ায় নাশকতার মামলায় আওয়ামী লীগ নেতা গ্রেপ্তার" /&gt;&lt;/p&gt;&lt;p&gt;সাইফুল ইসলাম: মানিকগঞ্জের সাটুরিয়ায় অগ্নিকাণ্ড ও নাশকতার মামলায় পরিমল পাল নামে ইউনিয়ন আওয়ামী লীগের এক নেতাকে গ্রেপ্তার করেছে পুলিশ। সোমবার (২৩ নভেম্বর) সন্ধ্যায় সাটুরিয়া বাজার এলাকা থেকে তাকে গ্রেপ্তার করা হয়। গ্রেপ্তার পরিমল পাল উপজেলার পশ্চিম কাউন্নারা পালপাড়া এলাকার মৃত জিতেন পালের ছেলে। তিনি সাট&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%b8%e0%a6%be%e0%a6%9f%e0%a7%81%e0%a6%b0%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%a8%e0%a6%be%e0%a6%b6%e0%a6%95%e0%a6%a4%e0%a6%be%e0%a6%b0/">জুমবাংলা</source>
    </item>

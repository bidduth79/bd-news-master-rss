      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/zoombangla-3.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/zoombangla-3.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/zoombangla-3.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নিকুঞ্জের জাহিদ ইকবাল চত্বরে বুধবার ব্র্যাকের বিশেষ স্বাস্থ্যসেবা ক্যাম্প" /&gt;&lt;/p&gt;&lt;p&gt;​নিজস্ব প্রতিবেদক: ​প্রান্তিক ও স্থানীয় জনগোষ্ঠীর দোরগোড়ায় মানসম্মত ও সাশ্রয়ী স্বাস্থ্যসেবা সুনিশ্চিত করার লক্ষ্য নিয়ে ব্র্যাক প্রাথমিক স্বাস্থ্যসেবা কেন্দ্র, খিলক্ষেত শাখার আয়োজনে অনুষ্ঠিত হতে যাচ্ছে এক বিশেষ স্যাটেলাইট স্বাস্থ্যসেবা ক্যাম্প। আগামী ১১ নভেম্বর, বুধবারে সকাল ১০টা থেকে দুপুর ২টা পর্যন&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%a8%e0%a6%bf%e0%a6%95%e0%a7%81%e0%a6%9e%e0%a7%8d%e0%a6%9c%e0%a7%87%e0%a6%b0-%e0%a6%9c%e0%a6%be%e0%a6%b9%e0%a6%bf%e0%a6%a6-%e0%a6%87%e0%a6%95%e0%a6%ac%e0%a6%be%e0%a6%b2-%e0%a6%ac%e0%a7%8d/">জুমবাংলা</source>
    </item>
    <item>
      <title>মাদরাসা শিক্ষকদের এমপিও আবেদনের সময় বাড়ল</title>
      <link>https://zoombangla.com/%e0%a6%ae%e0%a6%be%e0%a6%a6%e0%a6%b0%e0%a6%be%e0%a6%b8%e0%a6%be-%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%95%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%8f%e0%a6%ae%e0%a6%aa%e0%a6%bf%e0%a6%93/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%ae%e0%a6%be%e0%a6%a6%e0%a6%b0%e0%a6%be%e0%a6%b8%e0%a6%be-%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%95%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%8f%e0%a6%ae%e0%a6%aa%e0%a6%bf%e0%a6%93/</guid>
      <pubDate>Tue, 10 Nov 2026 05:53:31 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/mpo-2.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/mpo-2.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/mpo-2.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মাদরাসা শিক্ষকদের এমপিও আবেদনের সময় বাড়ল" /&gt;&lt;/p&gt;&lt;p&gt;মাদরাসা এডুকেশন ম্যানেজমেন্ট ইনফরমেশন সিস্টেম (মেমিস) সফটওয়্যারের রক্ষণাবেক্ষণ ও উন্নয়ন কার্যক্রম চলমান থাকায় শিক্ষক ও কর্মচারীদের এমপিও-সংক্রান্ত অনলাইনে আবেদন দাখিল ও অগ্রায়নের সময়সীমা বৃদ্ধি করেছে মাদরাসা শিক্ষা অধিদপ্তর। রোববার (৮ নভেম্বর) মাদরাসা শিক্ষা অধিদপ্তরের এক নোটিশে এ তথ্য জানানো হয়। নো&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ae%e0%a6%be%e0%a6%a6%e0%a6%b0%e0%a6%be%e0%a6%b8%e0%a6%be-%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%95%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%8f%e0%a6%ae%e0%a6%aa%e0%a6%bf%e0%a6%93/">জুমবাংলা</source>
    </item>
    <item>
      <title>কপ-৩১ সম্মেলনে যোগ দিতে তুরস্কের পথে প্রধানমন্ত্রী</title>
      <link>https://zoombangla.com/%e0%a6%95%e0%a6%aa-%e0%a7%a9%e0%a7%a7-%e0%a6%b8%e0%a6%ae%e0%a7%8d%e0%a6%ae%e0%a7%87%e0%a6%b2%e0%a6%a8%e0%a7%87-%e0%a6%af%e0%a7%8b%e0%a6%97-%e0%a6%a6%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%a4%e0%a7%81/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%95%e0%a6%aa-%e0%a7%a9%e0%a7%a7-%e0%a6%b8%e0%a6%ae%e0%a7%8d%e0%a6%ae%e0%a7%87%e0%a6%b2%e0%a6%a8%e0%a7%87-%e0%a6%af%e0%a7%8b%e0%a6%97-%e0%a6%a6%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%a4%e0%a7%81/</guid>
      <pubDate>Tue, 10 Nov 2026 05:48:24 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/pm-tareq-4.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/pm-tareq-4.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/pm-tareq-4.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কপ-৩১ সম্মেলনে যোগ দিতে তুরস্কের পথে প্রধানমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;জাতিসংঘের জলবায়ু পরিবর্তন বিষয়ক শীর্ষ সম্মেলনে (কপ-৩১) যোগ দিতে তুরস্কের উদ্দেশে ঢাকা ত্যাগ করেছেন প্রধানমন্ত্রী তারেক রহমান। মঙ্গলবার (১০ নভেম্বর) সকাল সাড়ে ৭টার দিকে হযরত শাহজালাল আন্তর্জাতিক বিমানবন্দর থেকে টার্কিশ এয়ারলাইনসের একটি নিয়মিত ফ্লাইটে ইস্তাম্বুলের উদ্দেশে যাত্রা করেন তিনি। এ সফরে তার&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%95%e0%a6%aa-%e0%a7%a9%e0%a7%a7-%e0%a6%b8%e0%a6%ae%e0%a7%8d%e0%a6%ae%e0%a7%87%e0%a6%b2%e0%a6%a8%e0%a7%87-%e0%a6%af%e0%a7%8b%e0%a6%97-%e0%a6%a6%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%a4%e0%a7%81/">জুমবাংলা</source>
    </item>
    <item>
      <title>২০২৭ সালে শিক্ষাপ্রতিষ্ঠানে কত দিন ছুটি, দেখুন তালিকা</title>
      <link>https://zoombangla.com/%e0%a7%a8%e0%a7%a6%e0%a7%a8%e0%a7%ad-%e0%a6%b8%e0%a6%be%e0%a6%b2%e0%a7%87-%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4%e0%a6%bf%e0%a6%b7%e0%a7%8d%e0%a6%a0/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a7%a8%e0%a7%a6%e0%a7%a8%e0%a7%ad-%e0%a6%b8%e0%a6%be%e0%a6%b2%e0%a7%87-%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4%e0%a6%bf%e0%a6%b7%e0%a7%8d%e0%a6%a0/</guid>
      <pubDate>Tue, 10 Nov 2026 05:43:27 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/schholl.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/schholl.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/schholl.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="২০২৭ সালে শিক্ষাপ্রতিষ্ঠানে কত দিন ছুটি, দেখুন তালিকা" /&gt;&lt;/p&gt;&lt;p&gt;২০২৭ শিক্ষাবর্ষে দেশের সরকারি ও বেসরকারি মাধ্যমিক ও নিম্নমাধ্যমিক বিদ্যালয়ের ছুটির খসড়া তালিকা তৈরি করেছে শিক্ষা মন্ত্রণালয়। খসড়া অনুযায়ী, আগামী বছর শিক্ষাপ্রতিষ্ঠানে মোট ৭০ দিন ছুটি থাকবে। এর মধ্যে পবিত্র রমজান, ঈদুল ফিতরসহ বিভিন্ন উপলক্ষে ২৪ দিন, ঈদুল আজহায় ১০ দিন এবং শীতকালীন অবকাশে ১১ দিন ছুটি &lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a7%a8%e0%a7%a6%e0%a7%a8%e0%a7%ad-%e0%a6%b8%e0%a6%be%e0%a6%b2%e0%a7%87-%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4%e0%a6%bf%e0%a6%b7%e0%a7%8d%e0%a6%a0/">জুমবাংলা</source>
    </item>
    <item>
      <title>যে ৬ দেশ ভ্রমণে নাগরিকদের নিষেধাজ্ঞা দিল যুক্তরাষ্ট্র</title>
      <link>https://zoombangla.com/%e0%a6%af%e0%a7%87-%e0%a7%ac-%e0%a6%a6%e0%a7%87%e0%a6%b6-%e0%a6%ad%e0%a7%8d%e0%a6%b0%e0%a6%ae%e0%a6%a3%e0%a7%87-%e0%a6%a8%e0%a6%be%e0%a6%97%e0%a6%b0%e0%a6%bf%e0%a6%95%e0%a6%a6%e0%a7%87%e0%a6%b0/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%af%e0%a7%87-%e0%a7%ac-%e0%a6%a6%e0%a7%87%e0%a6%b6-%e0%a6%ad%e0%a7%8d%e0%a6%b0%e0%a6%ae%e0%a6%a3%e0%a7%87-%e0%a6%a8%e0%a6%be%e0%a6%97%e0%a6%b0%e0%a6%bf%e0%a6%95%e0%a6%a6%e0%a7%87%e0%a6%b0/</guid>
      <pubDate>Tue, 10 Nov 2026 05:36:55 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/state.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/state.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/state.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যে ৬ দেশ ভ্রমণে নাগরিকদের নিষেধাজ্ঞা দিল যুক্তরাষ্ট্র" /&gt;&lt;/p&gt;&lt;p&gt;মধ্যপ্রাচ্য ও উত্তর আফ্রিকার ছয়টি দেশে নিজ দেশের নাগরিকদের ভ্রমণ না করার নির্দেশনা দিয়েছে যুক্তরাষ্ট্র। নিরাপত্তাঝুঁকি এবং এসব দেশে অবস্থানরত মার্কিন নাগরিকদের জরুরি কনস্যুলার সহায়তা দেওয়ার সীমাবদ্ধতার কথা বিবেচনায় নিয়ে সর্বোচ্চ সতর্কতা জারি করেছে দেশটির পররাষ্ট্র দপ্তর। নিষেধাজ্ঞার আওতায় থাকা দেশগু&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%af%e0%a7%87-%e0%a7%ac-%e0%a6%a6%e0%a7%87%e0%a6%b6-%e0%a6%ad%e0%a7%8d%e0%a6%b0%e0%a6%ae%e0%a6%a3%e0%a7%87-%e0%a6%a8%e0%a6%be%e0%a6%97%e0%a6%b0%e0%a6%bf%e0%a6%95%e0%a6%a6%e0%a7%87%e0%a6%b0/">জুমবাংলা</source>
    </item>

    </item>
    <item>
      <title>নতুন OSTA O1 Pro স্মার্টফোন আনতে পারে Huawei, ঘোষণা ২০ নভেম্বর</title>
      <link>https://zoombangla.com/%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-osta-o1-pro-%e0%a6%b8%e0%a7%8d%e0%a6%ae%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%9f%e0%a6%ab%e0%a7%8b%e0%a6%a8-%e0%a6%86%e0%a6%a8%e0%a6%a4%e0%a7%87-%e0%a6%aa%e0%a6%be/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-osta-o1-pro-%e0%a6%b8%e0%a7%8d%e0%a6%ae%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%9f%e0%a6%ab%e0%a7%8b%e0%a6%a8-%e0%a6%86%e0%a6%a8%e0%a6%a4%e0%a7%87-%e0%a6%aa%e0%a6%be/</guid>
      <pubDate>Wed, 11 Nov 2026 18:36:21 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/1-1-768x517-26.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/1-1-768x517-26.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/1-1-768x517-26.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নতুন OSTA O1 Pro স্মার্টফোন আনতে পারে Huawei, ঘোষণা ২০ নভেম্বর" /&gt;&lt;/p&gt;&lt;p&gt;স্মার্টফোন ব্যবসায় নতুন একটি ব্র্যান্ড চালুর প্রস্তুতি নিচ্ছে Huawei। চীনা প্রযুক্তি প্রতিষ্ঠানটি OSTA নামে নতুন Smartphone Sub-brand বাজারে আনার পরিকল্পনা করেছে। প্রতিষ্ঠানটির নির্বাহী Richard Yu-এর ঘোষণা অনুযায়ী, আগামী ২০ নভেম্বর ২০২৬ তারিখে চীনে নতুন ব্র্যান্ডটি আনুষ্ঠানিকভাবে পরিচয় করিয়ে দেওয়া হ&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-osta-o1-pro-%e0%a6%b8%e0%a7%8d%e0%a6%ae%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%9f%e0%a6%ab%e0%a7%8b%e0%a6%a8-%e0%a6%86%e0%a6%a8%e0%a6%a4%e0%a7%87-%e0%a6%aa%e0%a6%be/">জুমবাংলা</source>
    </item>
    <item>
      <title>Fold নয়, ওপরের দিকে Sliding করা Samsung-এর নতুন স্মার্টফোনের ডিসপ্লে</title>
      <link>https://zoombangla.com/fold-%e0%a6%a8%e0%a6%af%e0%a6%bc-%e0%a6%93%e0%a6%aa%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%a6%e0%a6%bf%e0%a6%95%e0%a7%87-sliding-%e0%a6%95%e0%a6%b0%e0%a6%be-samsung-%e0%a6%8f%e0%a6%b0-%e0%a6%a8%e0%a6%a4/</link>

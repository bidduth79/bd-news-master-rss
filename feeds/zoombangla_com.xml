    <item>
      <title>বিয়ে না করেও সিঁদুর পরায় কটাক্ষ, ঝাঁজালো জবাব নায়িকার</title>
      <link>https://zoombangla.com/%e0%a6%ac%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%a8%e0%a6%be-%e0%a6%95%e0%a6%b0%e0%a7%87%e0%a6%93-%e0%a6%b8%e0%a6%bf%e0%a6%81%e0%a6%a6%e0%a7%81%e0%a6%b0/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%ac%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%a8%e0%a6%be-%e0%a6%95%e0%a6%b0%e0%a7%87%e0%a6%93-%e0%a6%b8%e0%a6%bf%e0%a6%81%e0%a6%a6%e0%a7%81%e0%a6%b0/</guid>
      <pubDate>Thu, 19 Nov 2026 10:12:33 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Akkhora-Sing.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Akkhora-Sing.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Akkhora-Sing.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিয়ে না করেও সিঁদুর পরায় কটাক্ষ, ঝাঁজালো জবাব নায়িকার" /&gt;&lt;/p&gt;&lt;p&gt;অবিবাহিতা হয়েও সিঁদুর পরে পূজা দিয়ে বিতর্কের মুখে পড়েছেন অভিনেত্রী অক্ষরা সিং। সামাজিক যোগাযোগমাধ্যমে আধ্যাত্মিক মূহূর্ত ভাগ করে নিতেই ভোজপুরী অভিনেত্রীকে নিয়ে শুরু হয় কটাক্ষ। একাংশের প্রশ্ন, বিয়ে না করেও কেন নাকে কমলা সিঁদুর টেনে ছটপুজোর রীতি পালন করছেন অক্ষরা? এদিকে সমালোচনার শিকার হতেই পাল্টা নিন&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ac%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%a8%e0%a6%be-%e0%a6%95%e0%a6%b0%e0%a7%87%e0%a6%93-%e0%a6%b8%e0%a6%bf%e0%a6%81%e0%a6%a6%e0%a7%81%e0%a6%b0/">জুমবাংলা</source>
    </item>

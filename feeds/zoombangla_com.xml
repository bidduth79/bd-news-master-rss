      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%AC%E0%A6%A1%E0%A6%BC-%E0%A6%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BF%E0%A6%A4-%E0%A6%A6%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%B0.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%AC%E0%A6%A1%E0%A6%BC-%E0%A6%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BF%E0%A6%A4-%E0%A6%A6%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%B0.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%AC%E0%A6%A1%E0%A6%BC-%E0%A6%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BF%E0%A6%A4-%E0%A6%A6%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%B0.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অবসর নিয়ে বড় ইঙ্গিত দিবালার" /&gt;&lt;/p&gt;&lt;p&gt;পেশাদার ফুটবল ক্যারিয়ারের শেষ অধ্যায় কোথায় লিখতে চান—এবার তা নিয়ে স্পষ্ট অবস্থান জানালেন আর্জেন্টাইন ফরোয়ার্ড পাওলো দিবালা। উয়েফা চ্যাম্পিয়ন্স লিগে পিএসজির বিপক্ষে গুরুত্বপূর্ণ ম্যাচের আগে সংবাদ সম্মেলনে ৩২ বছর বয়সি এই তারকা জানিয়েছেন, রোমার জার্সি গায়েই ফুটবলকে বিদায় জানানো তার অন্যতম স্&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%85%e0%a6%ac%e0%a6%b8%e0%a6%b0-%e0%a6%a8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%ac%e0%a6%a1%e0%a6%bc-%e0%a6%87%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a6%bf%e0%a6%a4/">জুমবাংলা</source>
    </item>
    <item>
      <title>বিচ্ছেদের ঘোষণা দিলেন ন্যান্সি</title>
      <link>https://zoombangla.com/%e0%a6%ac%e0%a6%bf%e0%a6%9a%e0%a7%8d%e0%a6%9b%e0%a7%87%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%98%e0%a7%8b%e0%a6%b7%e0%a6%a3%e0%a6%be-%e0%a6%a6%e0%a6%bf%e0%a6%b2%e0%a7%87%e0%a6%a8/</link>

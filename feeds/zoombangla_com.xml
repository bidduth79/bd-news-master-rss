      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Samsung-Galaxy-S27-3.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Samsung-Galaxy-S27-3.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Samsung-Galaxy-S27-3.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="Samsung Galaxy S27 : গ্যালাক্সি এস২৭ সিরিজে থাকছে বিশাল বড় চমক" /&gt;&lt;/p&gt;&lt;p&gt;স্যামসাংয়ের আপকামিং গ্যালাক্সি এস২৭ সিরিজে (Galaxy S27, S27 Plus, S27 Pro, S27 Ultra) আইফোনের ডায়নামিক আইল্যান্ডের মতো &amp;#8216;মোমেন্ট এফেক্টস&amp;#8217; ফিচার আসছে। One UI 9.5 আপডেটের মাধ্যমে এই বড় চমক দেখা যাবে। স্যামসাংয়ের পরবর্তী ফ্ল্যাগশিপ স্মার্টফোন গ্যালাক্সি এস২৭ সিরিজ (Galaxy S27 series) বড়সড় পর&lt;/p&gt;</description>
      <source url="https://zoombangla.com/samsung-galaxy-s27-%e0%a6%97%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%b2%e0%a6%be%e0%a6%95%e0%a7%8d%e0%a6%b8%e0%a6%bf-%e0%a6%8f%e0%a6%b8%e0%a7%a8%e0%a7%ad/">জুমবাংলা</source>
    </item>
    <item>
      <title>মহাকাশ গবেষণায় বাংলাদেশকে সহযোগিতার প্রস্তাব পাকিস্তানের</title>
      <link>https://zoombangla.com/%e0%a6%ae%e0%a6%b9%e0%a6%be%e0%a6%95%e0%a6%be%e0%a6%b6-%e0%a6%97%e0%a6%ac%e0%a7%87%e0%a6%b7%e0%a6%a3%e0%a6%be%e0%a6%af%e0%a6%bc/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%ae%e0%a6%b9%e0%a6%be%e0%a6%95%e0%a6%be%e0%a6%b6-%e0%a6%97%e0%a6%ac%e0%a7%87%e0%a6%b7%e0%a6%a3%e0%a6%be%e0%a6%af%e0%a6%bc/</guid>
      <pubDate>Sat, 28 Nov 2026 17:34:23 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B6-%E0%A6%97%E0%A6%AC%E0%A7%87%E0%A6%B7%E0%A6%A3%E0%A6%BE.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B6-%E0%A6%97%E0%A6%AC%E0%A7%87%E0%A6%B7%E0%A6%A3%E0%A6%BE.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B6-%E0%A6%97%E0%A6%AC%E0%A7%87%E0%A6%B7%E0%A6%A3%E0%A6%BE.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মহাকাশ গবেষণায় বাংলাদেশকে সহযোগিতার প্রস্তাব পাকিস্তানের" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশের মহাকাশ গবেষণা, প্রযুক্তি উন্নয়ন ও দক্ষ জনবল তৈরিতে সহযোগিতার আগ্রহ প্রকাশ করেছে পাকিস্তান। এ ক্ষেত্রে গবেষণা, প্রযুক্তি ও অভিজ্ঞতা বিনিময়ের পাশাপাশি বাংলাদেশি শিক্ষার্থীদের পাকিস্তানের বিশ্ববিদ্যালয়গুলোতে উচ্চশিক্ষা ও গবেষণার সুযোগ দেওয়ার প্রস্তাবও দিয়েছে দেশটি। পাকিস্তান সফররত বাংলাদেশি &lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ae%e0%a6%b9%e0%a6%be%e0%a6%95%e0%a6%be%e0%a6%b6-%e0%a6%97%e0%a6%ac%e0%a7%87%e0%a6%b7%e0%a6%a3%e0%a6%be%e0%a6%af%e0%a6%bc/">জুমবাংলা</source>
    </item>
    <item>
      <title>ঢাকায় আসছেন বিশ্বখ্যাত পপ তারকা শাকিরা?</title>
      <link>https://zoombangla.com/%e0%a6%a2%e0%a6%be%e0%a6%95%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%86%e0%a6%b8%e0%a6%9b%e0%a7%87%e0%a6%a8/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%a2%e0%a6%be%e0%a6%95%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%86%e0%a6%b8%e0%a6%9b%e0%a7%87%e0%a6%a8/</guid>
      <pubDate>Sat, 28 Nov 2026 17:27:53 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%96%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A4-%E0%A6%AA%E0%A6%AA-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A6%BE-%E0%A6%B6%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B0%E0%A6%BE.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%96%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A4-%E0%A6%AA%E0%A6%AA-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A6%BE-%E0%A6%B6%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B0%E0%A6%BE.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%96%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A4-%E0%A6%AA%E0%A6%AA-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A6%BE-%E0%A6%B6%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B0%E0%A6%BE.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঢাকায় আসছেন বিশ্বখ্যাত পপ তারকা শাকিরা?" /&gt;&lt;/p&gt;&lt;p&gt;রোমানিয়ান পপ তারকা ওটিলিয়ার কনসার্টের রেশ কাটতে না কাটতেই ঢাকায় আরেকটি বড় আন্তর্জাতিক সংগীত আয়োজনের পরিকল্পনার কথা জানিয়েছেন ই-মেকার্স বাংলাদেশের কর্ণধার নাঈম আশরাফ। তার ঘোষণা অনুযায়ী, ২০২৭ সালের এপ্রিলে কলম্বিয়ান পপ তারকা শাকিরা ইসাবেলকে বাংলাদেশে নিয়ে আসার পরিকল্পনা করছে আয়োজক প্রতিষ্ঠানটি। রাজধান&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%a2%e0%a6%be%e0%a6%95%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%86%e0%a6%b8%e0%a6%9b%e0%a7%87%e0%a6%a8/">জুমবাংলা</source>
    </item>
    <item>
      <title>ফেল করা শিক্ষার্থীদের জন্য বিশেষ পরীক্ষা, অংশ নেবে ২ লাখ ৯০ হাজার: শিক্ষামন্ত্রী</title>
      <link>https://zoombangla.com/%e0%a6%ab%e0%a7%87%e0%a6%b2-%e0%a6%95%e0%a6%b0%e0%a6%be-%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%a5%e0%a7%80%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%9c%e0%a6%a8-2/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%ab%e0%a7%87%e0%a6%b2-%e0%a6%95%e0%a6%b0%e0%a6%be-%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%a5%e0%a7%80%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%9c%e0%a6%a8-2/</guid>
      <pubDate>Sat, 28 Nov 2026 17:21:49 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AB%E0%A7%87%E0%A6%B2-%E0%A6%95%E0%A6%B0%E0%A6%BE-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AB%E0%A7%87%E0%A6%B2-%E0%A6%95%E0%A6%B0%E0%A6%BE-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AB%E0%A7%87%E0%A6%B2-%E0%A6%95%E0%A6%B0%E0%A6%BE-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফেল করা শিক্ষার্থীদের জন্য বিশেষ পরীক্ষা, অংশ নেবে ২ লাখ ৯০ হাজার: শিক্ষামন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;এক বা দুটি বিষয়ে অকৃতকার্য হওয়ার কারণে শিক্ষার্থীদের শিক্ষাজীবন যেন থেমে না যায়, সে লক্ষ্যে বিশেষ পরীক্ষা আয়োজনের উদ্যোগ নিয়েছে সরকার। এ পরীক্ষায় প্রায় ২ লাখ ৯০ হাজার শিক্ষার্থী অংশ নেবে বলে জানিয়েছেন শিক্ষা এবং প্রাথমিক ও গণশিক্ষামন্ত্রী ড. আ ন ম এহছানুল হক মিলন। শনিবার (২৮ নভেম্বর) রাজধানীর মিরপুর&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ab%e0%a7%87%e0%a6%b2-%e0%a6%95%e0%a6%b0%e0%a6%be-%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%a5%e0%a7%80%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%9c%e0%a6%a8-2/">জুমবাংলা</source>
    </item>
    <item>
      <title>Motorola Edge 70 Neo : ৭০০০ মিলিঅ্যাম্পিয়ার আওয়ার ব্যাটারির নতুন ফোন আনল মটোরোলা</title>
      <link>https://zoombangla.com/motorola-edge-70-neo/</link>
      <guid isPermaLink="true">https://zoombangla.com/motorola-edge-70-neo/</guid>
      <pubDate>Sat, 28 Nov 2026 17:15:56 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/motorola-edge-70-neo-news-image.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/motorola-edge-70-neo-news-image.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/motorola-edge-70-neo-news-image.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="Motorola Edge 70 Neo : ৭০০০ মিলিঅ্যাম্পিয়ার আওয়ার ব্যাটারির নতুন ফোন আনল মটোরোলা" /&gt;&lt;/p&gt;&lt;p&gt;বাজারে নিজেদের নতুন স্মার্টফোন Motorola Edge 70 Neo উন্মোচন করল প্রযুক্তি প্রতিষ্ঠান মটোরোলা। এজ নিও সিরিজের এই নতুন ডিভাইসটিতে রয়েছে ৭ হাজার মিলিঅ্যাম্পিয়ার আওয়ারের বিশাল ব্যাটারি, সর্বোচ্চ ১৪৪ হার্জ রিফ্রেশ রেটের অ্যামোলেড ডিসপ্লে এবং কোয়ালকম স্ন্যাপড্রাগন প্রসেসর। পাশাপাশি ৫০ মেগাপিক্সেলের সনি&lt;/p&gt;</description>
      <source url="https://zoombangla.com/motorola-edge-70-neo/">জুমবাংলা</source>
    </item>

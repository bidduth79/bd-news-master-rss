    <item>
      <title>মেসির ঐতিহাসিক রেকর্ড ভাঙার দ্বারপ্রান্তে মদরিচ</title>
      <link>https://zoombangla.com/%e0%a6%ae%e0%a7%87%e0%a6%b8%e0%a6%bf%e0%a6%b0-%e0%a6%90%e0%a6%a4%e0%a6%bf%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%95-%e0%a6%b0%e0%a7%87%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%a1-%e0%a6%ad%e0%a6%be/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%ae%e0%a7%87%e0%a6%b8%e0%a6%bf%e0%a6%b0-%e0%a6%90%e0%a6%a4%e0%a6%bf%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%95-%e0%a6%b0%e0%a7%87%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%a1-%e0%a6%ad%e0%a6%be/</guid>
      <pubDate>Sat, 14 Nov 2026 16:24:16 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Messi-5.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Messi-5.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Messi-5.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মেসির ঐতিহাসিক রেকর্ড ভাঙার দ্বারপ্রান্তে মদরিচ" /&gt;&lt;/p&gt;&lt;p&gt;আন্তর্জাতিক ফুটবলকে কদিন আগেই বিদায় বলেছেন আর্জেন্টাইন কিংবদন্তি লিওনেল মেসি। এই মহাতারকার বিদায়ের পর এবার তাঁর একটি রেকর্ড ভাঙার কাছে আছেন ক্রোয়েশিয়ার অধিনায়ক লুকা মদ্রিচ। আন্তর্জাতিক ফুটবলের অন্যতম এক ঐতিহাসিক রেকর্ডের খুব কাছাকাছি পৌঁছে গেছেন মদরিচ। দেশের হয়ে তাঁর ম্যাচসংখ্যা এখন ২০৭টি। গত বৃ&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ae%e0%a7%87%e0%a6%b8%e0%a6%bf%e0%a6%b0-%e0%a6%90%e0%a6%a4%e0%a6%bf%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%95-%e0%a6%b0%e0%a7%87%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%a1-%e0%a6%ad%e0%a6%be/">জুমবাংলা</source>
    </item>

      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A6%AC%E0%A7%87%E0%A6%A8.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A6%AC%E0%A7%87%E0%A6%A8.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A6%AC%E0%A7%87%E0%A6%A8.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অবসরের পর প্রথমবার আর্জেন্টিনায় খেলবেন মেসি" /&gt;&lt;/p&gt;&lt;p&gt;আন্তর্জাতিক ফুটবল থেকে অবসর নেওয়ার পর প্রথমবারের মতো নিজ দেশ আর্জেন্টিনায় মাঠে নামতে যাচ্ছেন লিওনেল মেসি। আগামী ডিসেম্বরে সাবেক সতীর্থ কার্লোস তেভেজের বিদায়ী (টেস্টিমোনিয়াল) ম্যাচে খেলবেন তিনি। গত অক্টোবরে আর্জেন্টিনা জাতীয় দলের হয়ে ২১ বছরের বর্ণাঢ্য ক্যারিয়ারের ইতি টানেন মেসি। বেনিনের বিপক্ষে ৩-০ গ&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%85%e0%a6%ac%e0%a6%b8%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a5%e0%a6%ae%e0%a6%ac%e0%a6%be%e0%a6%b0/">জুমবাংলা</source>
    </item>
    <item>
      <title>গোপালগঞ্জসহ বিভিন্ন জেলায় ১২০ প্লাটুন বিজিবি মোতায়েন</title>
      <link>https://zoombangla.com/%e0%a6%97%e0%a7%8b%e0%a6%aa%e0%a6%be%e0%a6%b2%e0%a6%97%e0%a6%9e%e0%a7%8d%e0%a6%9c%e0%a6%b8%e0%a6%b9-%e0%a6%ac%e0%a6%bf%e0%a6%ad%e0%a6%bf%e0%a6%a8%e0%a7%8d%e0%a6%a8/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%97%e0%a7%8b%e0%a6%aa%e0%a6%be%e0%a6%b2%e0%a6%97%e0%a6%9e%e0%a7%8d%e0%a6%9c%e0%a6%b8%e0%a6%b9-%e0%a6%ac%e0%a6%bf%e0%a6%ad%e0%a6%bf%e0%a6%a8%e0%a7%8d%e0%a6%a8/</guid>
      <pubDate>Sat, 28 Nov 2026 05:08:15 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/ipiiopi.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/ipiiopi.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/ipiiopi.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গোপালগঞ্জসহ বিভিন্ন জেলায় ১২০ প্লাটুন বিজিবি মোতায়েন" /&gt;&lt;/p&gt;&lt;p&gt;আইনশৃঙ্খলা পরিস্থিতি নিয়ন্ত্রণ, জননিরাপত্তা নিশ্চিতকরণ এবং যেকোনো ধরনের অনাকাঙ্ক্ষিত পরিস্থিতি মোকাবিলায় ঢাকা, গাজীপুর, নারায়ণগঞ্জ, ময়মনসিংহ, গোপালগঞ্জ, চট্টগ্রাম ও কক্সবাজারে ১২০ প্লাটুন বিজিবি মোতায়েন করা হয়েছে। এরমধ্যে ঢাকার সাভার ও আশুলিয়ায় ১৭, গাজীপুরে ১৯, নারায়ণগঞ্জে ৭, ময়মনসিংহের ভালুকায় &lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%97%e0%a7%8b%e0%a6%aa%e0%a6%be%e0%a6%b2%e0%a6%97%e0%a6%9e%e0%a7%8d%e0%a6%9c%e0%a6%b8%e0%a6%b9-%e0%a6%ac%e0%a6%bf%e0%a6%ad%e0%a6%bf%e0%a6%a8%e0%a7%8d%e0%a6%a8/">জুমবাংলা</source>
    </item>
    <item>
      <title>লাহোরে ঐতিহাসিক মিনার-ই-পাকিস্তান পরিদর্শন করলেন স্পিকার</title>
      <link>https://zoombangla.com/%e0%a6%b2%e0%a6%be%e0%a6%b9%e0%a7%8b%e0%a6%b0%e0%a7%87-%e0%a6%90%e0%a6%a4%e0%a6%bf%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%95-%e0%a6%ae%e0%a6%bf%e0%a6%a8%e0%a6%be%e0%a6%b0-%e0%a6%87/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%b2%e0%a6%be%e0%a6%b9%e0%a7%8b%e0%a6%b0%e0%a7%87-%e0%a6%90%e0%a6%a4%e0%a6%bf%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%95-%e0%a6%ae%e0%a6%bf%e0%a6%a8%e0%a6%be%e0%a6%b0-%e0%a6%87/</guid>
      <pubDate>Sat, 28 Nov 2026 05:05:08 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%A6%E0%A6%B0%E0%A7%8D%E0%A6%B6%E0%A6%A8.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%A6%E0%A6%B0%E0%A7%8D%E0%A6%B6%E0%A6%A8.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%A6%E0%A6%B0%E0%A7%8D%E0%A6%B6%E0%A6%A8.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="লাহোরে ঐতিহাসিক মিনার-ই-পাকিস্তান পরিদর্শন করলেন স্পিকার" /&gt;&lt;/p&gt;&lt;p&gt;জাতীয় সংসদের স্পিকার হাফিজ উদ্দিন আহমদ বীর বিক্রম পাকিস্তানের লাহোরে অবস্থিত জাতীয় স্মৃতিস্তম্ভ মিনার-ই পাকিস্তান পরিদর্শন করেছেন। শুক্রবার জাতীয় সংসদ সচিবালয়ের এক প্রেস বিজ্ঞপ্তিতে এ তথ্য জানানো হয়েছে। এ সময় পাকিস্তান সফররত বাংলাদেশের সংসদীয় প্রতিনিধিদলের সদস্যরাও উপস্থিত ছিলেন। এর আগে বুধবার স্পিক&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%b2%e0%a6%be%e0%a6%b9%e0%a7%8b%e0%a6%b0%e0%a7%87-%e0%a6%90%e0%a6%a4%e0%a6%bf%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%95-%e0%a6%ae%e0%a6%bf%e0%a6%a8%e0%a6%be%e0%a6%b0-%e0%a6%87/">জুমবাংলা</source>
    </item>

      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AC%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A6%B2.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AC%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A6%B2.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AC%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A6%B2.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টানা দরপতনের পর বিশ্ববাজারে বাড়ল স্বর্ণের দাম" /&gt;&lt;/p&gt;&lt;p&gt;বিশ্ববাজারে টানা পাঁচ দিনের দরপতনের পর স্বর্ণের দাম আবারও বেড়েছে। সোমবার (২৩ নভেম্বর) এশিয়ার বাজারে লেনদেনের শুরুতে প্রতি আউন্স স্বর্ণের দাম ১ দশমিক ৫ শতাংশ বেড়ে ৩ হাজার ৫৯০ ডলার ছাড়িয়েছে। বিশ্ববাজারে শেয়ারদরের পতনের মধ্যে নিরাপদ বিনিয়োগ হিসেবে স্বর্ণের চাহিদা বাড়ায় এই উত্থান হয়েছে। বার্তা সংস্থা রয়&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%9f%e0%a6%be%e0%a6%a8%e0%a6%be-%e0%a6%a6%e0%a6%b0%e0%a6%aa%e0%a6%a4%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a6%b0/">জুমবাংলা</source>
    </item>
    <item>
      <title>বাংলাদেশ সফরে ভিভিআইপি মর্যাদা পাচ্ছেন মালয়েশিয়ার প্রধানমন্ত্রী</title>
      <link>https://zoombangla.com/%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%a6%e0%a7%87%e0%a6%b6-%e0%a6%b8%e0%a6%ab%e0%a6%b0%e0%a7%87-%e0%a6%ad%e0%a6%bf%e0%a6%ad%e0%a6%bf%e0%a6%86%e0%a6%87%e0%a6%aa%e0%a6%bf/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%a6%e0%a7%87%e0%a6%b6-%e0%a6%b8%e0%a6%ab%e0%a6%b0%e0%a7%87-%e0%a6%ad%e0%a6%bf%e0%a6%ad%e0%a6%bf%e0%a6%86%e0%a6%87%e0%a6%aa%e0%a6%bf/</guid>
      <pubDate>Mon, 23 Nov 2026 04:02:56 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A6%E0%A6%BE-1.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A6%E0%A6%BE-1.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A6%E0%A6%BE-1.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাংলাদেশ সফরে ভিভিআইপি মর্যাদা পাচ্ছেন মালয়েশিয়ার প্রধানমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;মালয়েশিয়ার প্রধানমন্ত্রী আনোয়ার ইব্রাহিমের আসন্ন বাংলাদেশ সফর উপলক্ষে তাকে অতি গুরুত্বপূর্ণ ব্যক্তি (ভিভিআইপি) ঘোষণা করে গেজেট প্রকাশ করেছে সরকার। আগামী ৭ ও ৮ ডিসেম্বর ২০২৬ তার বাংলাদেশ সফরকালীন এ মর্যাদা কার্যকর থাকবে। রোববার(২২ নভেম্বর) প্রকাশিত বাংলাদেশ গেজেটের এক প্রজ্ঞাপনে এ তথ্য জানানো হয়। প্র&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%a6%e0%a7%87%e0%a6%b6-%e0%a6%b8%e0%a6%ab%e0%a6%b0%e0%a7%87-%e0%a6%ad%e0%a6%bf%e0%a6%ad%e0%a6%bf%e0%a6%86%e0%a6%87%e0%a6%aa%e0%a6%bf/">জুমবাংলা</source>
    </item>
    <item>
      <title>বিচার বিভাগীয় ৮ কর্মকর্তাকে বদলি</title>
      <link>https://zoombangla.com/%e0%a6%ac%e0%a6%bf%e0%a6%9a%e0%a6%be%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%ad%e0%a6%be%e0%a6%97%e0%a7%80%e0%a6%af%e0%a6%bc-%e0%a7%ae/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%ac%e0%a6%bf%e0%a6%9a%e0%a6%be%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%ad%e0%a6%be%e0%a6%97%e0%a7%80%e0%a6%af%e0%a6%bc-%e0%a7%ae/</guid>
      <pubDate>Mon, 23 Nov 2026 03:58:43 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A6%BF-1.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A6%BF-1.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A6%BF-1.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিচার বিভাগীয় ৮ কর্মকর্তাকে বদলি" /&gt;&lt;/p&gt;&lt;p&gt;বিচার বিভাগের আটজন কর্মকর্তার জন্য নতুন ঠিকানা নির্ধারণ করে দিয়েছে সরকার। এর মধ্যে ঢাকা, চট্টগ্রাম ও গাজীপুরের মতো ব্যস্ত শহর যেমন রয়েছে, তেমনি দেশের আরও কয়েকটি জায়গাও এ তালিকায় আছে। মজার বিষয় হলো, বদলি হওয়া এ আটজনের একজন হলেন পূর্ণাঙ্গ জেলা ও দায়রা জজ, আর বাকি সাতজন দায়িত্ব পালন করেন অতিরিক্ত জেলা&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ac%e0%a6%bf%e0%a6%9a%e0%a6%be%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%ad%e0%a6%be%e0%a6%97%e0%a7%80%e0%a6%af%e0%a6%bc-%e0%a7%ae/">জুমবাংলা</source>
    </item>

    <item>
      <title>কিয়ামতের দিন আল্লাহর কাছে অভিযোগ জানাবেন শ্রীলঙ্কা কোচ</title>
      <link>https://zoombangla.com/%e0%a6%95%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%ae%e0%a6%a4%e0%a7%87%e0%a6%b0-%e0%a6%a6%e0%a6%bf%e0%a6%a8-%e0%a6%86%e0%a6%b2%e0%a7%8d%e0%a6%b2%e0%a6%be%e0%a6%b9%e0%a6%b0-%e0%a6%95%e0%a6%be/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%95%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%ae%e0%a6%a4%e0%a7%87%e0%a6%b0-%e0%a6%a6%e0%a6%bf%e0%a6%a8-%e0%a6%86%e0%a6%b2%e0%a7%8d%e0%a6%b2%e0%a6%be%e0%a6%b9%e0%a6%b0-%e0%a6%95%e0%a6%be/</guid>
      <pubDate>Thu, 12 Nov 2026 08:33:00 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/4587.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/4587.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/4587.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কিয়ামতের দিন আল্লাহর কাছে অভিযোগ জানাবেন শ্রীলঙ্কা কোচ" /&gt;&lt;/p&gt;&lt;p&gt;শ্রীলঙ্কার জন্য ম্যাচটা ছিল বাঁচা-মরার। টুর্নামেন্টে টিকে থাকতে বাংলাদেশের বিপক্ষে অন্তত ড্র করতে হতো লঙ্কানদের। কিন্তু সেটা করতে পারেননি আবদুল্লাহ আল মুতাইরির শিষ্যরা। গতকাল বুধবার বাংলাদেশের কাছে ৪-০ ব্যবধানে উড়ে গেছে শ্রীলঙ্কা। এ ম্যাচের পর সংবাদ সম্মেলনে ক্ষোভ উগড়ে দিয়েছেন মুতাইরি। সাফের সমালোচন&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%95%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%ae%e0%a6%a4%e0%a7%87%e0%a6%b0-%e0%a6%a6%e0%a6%bf%e0%a6%a8-%e0%a6%86%e0%a6%b2%e0%a7%8d%e0%a6%b2%e0%a6%be%e0%a6%b9%e0%a6%b0-%e0%a6%95%e0%a6%be/">জুমবাংলা</source>
    </item>

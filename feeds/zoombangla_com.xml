      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Nasa.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Nasa.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Nasa.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চাঁদে বসবাস নিশ্চিত করতে নতুন প্রজন্মের নভোচারী খুঁজছে নাসা" /&gt;&lt;/p&gt;&lt;p&gt;চাঁদে স্থায়ী ঘাঁটি নির্মাণ ও সেখানে মানুষের বসবাস নিশ্চিত করতে নতুন প্রজন্মের নভোচারী নিয়োগের উদ্যোগ নিয়েছে মার্কিন মহাকাশ গবেষণা সংস্থা নাসা। নির্বাচিত নভোচারীরা চাঁদে গিয়ে ঘাঁটি নির্মাণ, বসবাস ও গবেষণার কাজে যুক্ত হবেন। পাশাপাশি ভবিষ্যতে মঙ্গলে মানব অভিযান পরিচালনার ক্ষেত্রেও ভূমিকা রাখবেন তারা। গ&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%9a%e0%a6%be%e0%a6%81%e0%a6%a6%e0%a7%87-%e0%a6%ac%e0%a6%b8%e0%a6%ac%e0%a6%be%e0%a6%b8-%e0%a6%a8%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%9a%e0%a6%bf%e0%a6%a4-%e0%a6%95/">জুমবাংলা</source>

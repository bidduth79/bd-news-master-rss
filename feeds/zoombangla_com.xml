      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a6%bf%e0%a6%95%e0%a6%97%e0%a6%9e%e0%a7%8d%e0%a6%9c%e0%a7%87%e0%a6%b0-%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%b7%e0%a7%8d%e0%a6%a0-%e0%a6%93%e0%a6%b8%e0%a6%bf/</guid>
      <pubDate>Tue, 17 Nov 2026 11:23:20 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/IMG_20261117_171504.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/IMG_20261117_171504.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/IMG_20261117_171504.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মানিকগঞ্জের শ্রেষ্ঠ ওসি মনির হোসেন, উপপরিদর্শক আইয়ুব খান" /&gt;&lt;/p&gt;&lt;p&gt;সাইফুল ইসলাম: মানিকগঞ্জে অক্টোবর মাসের অপরাধ পর্যালোচনায় জেলার সাতটি থানার মধ্যে শ্রেষ্ঠ অফিসার ইনচার্জ (ওসি) নির্বাচিত হয়েছেন মনির হোসেন। একই সভায় জেলার শ্রেষ্ঠ উপপরিদর্শক নির্বাচিত হয়েছেন আইয়ুব খান। আইনশৃঙ্খলা রক্ষা, অপরাধ দমন, আসামি গ্রেপ্তার, পরোয়ানা তামিল ও মামলা তদন্তে গুরুত্বপূর্ণ অবদান রাখায়&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a6%bf%e0%a6%95%e0%a6%97%e0%a6%9e%e0%a7%8d%e0%a6%9c%e0%a7%87%e0%a6%b0-%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%b7%e0%a7%8d%e0%a6%a0-%e0%a6%93%e0%a6%b8%e0%a6%bf/">জুমবাংলা</source>
    </item>
    <item>
      <title>Galaxy Z Slide : পেটেন্টে দেখা গেল স্যামসাংয়ের স্লাইডিং ফোনের ডিজাইন</title>
      <link>https://zoombangla.com/galaxy-z-slide-%e0%a6%aa%e0%a7%87%e0%a6%9f%e0%a7%87%e0%a6%a8%e0%a7%8d%e0%a6%9f%e0%a7%87/</link>
      <guid isPermaLink="true">https://zoombangla.com/galaxy-z-slide-%e0%a6%aa%e0%a7%87%e0%a6%9f%e0%a7%87%e0%a6%a8%e0%a7%8d%e0%a6%9f%e0%a7%87/</guid>
      <pubDate>Tue, 17 Nov 2026 11:07:55 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Galaxy-Z-Slide.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Galaxy-Z-Slide.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Galaxy-Z-Slide.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="Galaxy Z Slide : পেটেন্টে দেখা গেল স্যামসাংয়ের স্লাইডিং ফোনের ডিজাইন" /&gt;&lt;/p&gt;&lt;p&gt;স্যামসাং তাদের স্মার্টফোনের ডিজাইনের ক্ষেত্রে বড় পরিবর্তন করতে চলেছে। কোম্পানির নতুন পেটেন্টে এমন একটি Galaxy ফোনের ডিজাইন দেখা গেছে, যে ফোনের স্ক্রিন ওপরের দিকে স্লাইড হয়ে বড় হতে পারে। এই ডিজাইন কোম্পানির তথাকথিত Galaxy Z Slide ফোনের জন্য হতে পারে। আগামী বছর অর্থাৎ 2027 সালে এই আপকামিং ফোনটি পেশ&lt;/p&gt;</description>
      <source url="https://zoombangla.com/galaxy-z-slide-%e0%a6%aa%e0%a7%87%e0%a6%9f%e0%a7%87%e0%a6%a8%e0%a7%8d%e0%a6%9f%e0%a7%87/">জুমবাংলা</source>
    </item>
    <item>
      <title>গ্র্যামিতে নারীদের দাপট, চমক দেখালেন টেইলর সুইফট</title>
      <link>https://zoombangla.com/%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%ae%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%a8%e0%a6%be%e0%a6%b0%e0%a7%80%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%a6%e0%a6%be%e0%a6%aa%e0%a6%9f/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%ae%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%a8%e0%a6%be%e0%a6%b0%e0%a7%80%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%a6%e0%a6%be%e0%a6%aa%e0%a6%9f/</guid>
      <pubDate>Tue, 17 Nov 2026 11:02:49 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/grammy.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/grammy.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/grammy.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গ্র্যামিতে নারীদের দাপট, চমক দেখালেন টেইলর সুইফট" /&gt;&lt;/p&gt;&lt;p&gt;২০২৭ সালের গ্র্যামি অ্যাওয়ার্ডসের মনোনয়ন তালিকা প্রকাশ করা হয়েছে। এবারের আসরে সবচেয়ে বেশি মনোনয়ন পেয়েছেন ব্রিটিশ গায়িকা রায়ে। তার ঝুলিতে উঠেছে ১১টি মনোনয়ন! দ্বিতীয় অবস্থানে রয়েছেন স্প্যানিশ গায়িকা রোজালিয়া। তিনি পেয়েছেন ৯টি মনোনয়ন। এ ছাড়া এলা ল্যাংলি, মিরান্ডা ল্যামবার্ট, অলিভিয়া রদ্রিগো ও ফোবি ব্রি&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%ae%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%a8%e0%a6%be%e0%a6%b0%e0%a7%80%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%a6%e0%a6%be%e0%a6%aa%e0%a6%9f/">জুমবাংলা</source>
    </item>
    <item>
      <title>ওসব লেভেল আমরা গুনি না, পাল্টা জবাবে পরীমণি</title>
      <link>https://zoombangla.com/%e0%a6%93%e0%a6%b8%e0%a6%ac-%e0%a6%b2%e0%a7%87%e0%a6%ad%e0%a7%87%e0%a6%b2-%e0%a6%86%e0%a6%ae%e0%a6%b0%e0%a6%be-%e0%a6%97%e0%a7%81%e0%a6%a8%e0%a6%bf-%e0%a6%a8%e0%a6%be-%e0%a6%aa%e0%a6%be%e0%a6%b2/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%93%e0%a6%b8%e0%a6%ac-%e0%a6%b2%e0%a7%87%e0%a6%ad%e0%a7%87%e0%a6%b2-%e0%a6%86%e0%a6%ae%e0%a6%b0%e0%a6%be-%e0%a6%97%e0%a7%81%e0%a6%a8%e0%a6%bf-%e0%a6%a8%e0%a6%be-%e0%a6%aa%e0%a6%be%e0%a6%b2/</guid>
      <pubDate>Tue, 17 Nov 2026 10:59:18 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Pori-Moni-1.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Pori-Moni-1.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Pori-Moni-1.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ওসব লেভেল আমরা গুনি না, পাল্টা জবাবে পরীমণি" /&gt;&lt;/p&gt;&lt;p&gt;‘লেভেল’ নয়, বরং ‘কোয়ালিটি’কেই গুরুত্ব দিতে চান ঢাকাই চলচ্চিত্রের আলোচিত নায়িকা পরীমণি। নিজেদের মান নিয়ে শতভাগ আত্মবিশ্বাসী এই অভিনেত্রী। সম্প্রতি সামাজিক যোগাযোগমাধ্যমে দেওয়া এক পোস্টে এমন মন্তব্যই করেছেন তিনি। তবে, পোস্টে কারো নাম উল্লেখ না করলেও তার এই বক্তব্যকে অপু বিশ্বাসের সঙ্গে চলমান বাক্‌যুদ্&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%93%e0%a6%b8%e0%a6%ac-%e0%a6%b2%e0%a7%87%e0%a6%ad%e0%a7%87%e0%a6%b2-%e0%a6%86%e0%a6%ae%e0%a6%b0%e0%a6%be-%e0%a6%97%e0%a7%81%e0%a6%a8%e0%a6%bf-%e0%a6%a8%e0%a6%be-%e0%a6%aa%e0%a6%be%e0%a6%b2/">জুমবাংলা</source>
    </item>
    <item>
      <title>OPPO A7 Ultra : আগামী মাসে লঞ্চ হতে চলেছে 12000mAh ব্যাটারিসহ এই স্মার্টফোন, রইল বিস্তারিত</title>
      <link>https://zoombangla.com/oppo-a7-ultra/</link>
      <guid isPermaLink="true">https://zoombangla.com/oppo-a7-ultra/</guid>
      <pubDate>Tue, 17 Nov 2026 10:55:25 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/OPPO-A7-Ultra.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/OPPO-A7-Ultra.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/OPPO-A7-Ultra.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="OPPO A7 Ultra : আগামী মাসে লঞ্চ হতে চলেছে 12000mAh ব্যাটারিসহ এই স্মার্টফোন, রইল বিস্তারিত" /&gt;&lt;/p&gt;&lt;p&gt;গত সেপ্টেম্বর মাসে ওপ্পো তাদের 8000mAh Battery সহ OPPO A7 Pro স্মার্টফোনটি লঞ্চ করেছিল। এই সিরিজের OPPO A7 Pro Max ফোনটি 10000mAh Battery সহ পেশ করা হয়েছিল। তবে ওপ্পো এখানেই থামছে না। কোম্পানি এই সিরিজের অধীনে OPPO A7 Ultra স্মার্টফোন লঞ্চ করতে চলেছে বলে খবর পাওয়া যাচ্ছে এবং এই ফোনটি ব্যাটারির দিক&lt;/p&gt;</description>
      <source url="https://zoombangla.com/oppo-a7-ultra/">জুমবাংলা</source>
    </item>

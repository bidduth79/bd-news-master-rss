      <title>স্বর্ণের দামে বড় পতন, ভরি যত টাকা</title>
      <link>https://zoombangla.com/%e0%a6%b8%e0%a7%8d%e0%a6%ac%e0%a6%b0%e0%a7%8d%e0%a6%a3%e0%a7%87%e0%a6%b0-%e0%a6%a6%e0%a6%be%e0%a6%ae%e0%a7%87-%e0%a6%ac%e0%a6%a1%e0%a6%bc-%e0%a6%aa%e0%a6%a4%e0%a6%a8/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%b8%e0%a7%8d%e0%a6%ac%e0%a6%b0%e0%a7%8d%e0%a6%a3%e0%a7%87%e0%a6%b0-%e0%a6%a6%e0%a6%be%e0%a6%ae%e0%a7%87-%e0%a6%ac%e0%a6%a1%e0%a6%bc-%e0%a6%aa%e0%a6%a4%e0%a6%a8/</guid>
      <pubDate>Wed, 18 Nov 2026 17:21:11 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Gold-16.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Gold-16.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Gold-16.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="স্বর্ণের দামে বড় পতন, ভরি যত টাকা" /&gt;&lt;/p&gt;&lt;p&gt;মার্কিন ডলার এবং যুক্তরাষ্ট্রে সুদের হার আরও বাড়ার প্রত্যাশায় মূল্যবান ধাতুর বাজারে চাপ বেড়েছে। বুধবার (১৮ নভেম্বর) আন্তর্জাতিক বাজারে স্বর্ণের দাম প্রায় ২ শতাংশ কমে এক বছরেরও বেশি সময়ের মধ্যে সর্বনিম্ন পর্যায়ে নেমে এসেছে। এদিন বাংলাদেশ সময় বেলা ১২টা ২৭ মিনিটে স্পট মার্কেটে স্বর্ণের দাম ১ দশমিক ৯ শত&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%b8%e0%a7%8d%e0%a6%ac%e0%a6%b0%e0%a7%8d%e0%a6%a3%e0%a7%87%e0%a6%b0-%e0%a6%a6%e0%a6%be%e0%a6%ae%e0%a7%87-%e0%a6%ac%e0%a6%a1%e0%a6%bc-%e0%a6%aa%e0%a6%a4%e0%a6%a8/">জুমবাংলা</source>
    </item>
    <item>
      <title>শুরু হচ্ছে চিরুনি অভিযান, নিরাপত্তায় সাজানো হয়েছে রাজধানী</title>
      <link>https://zoombangla.com/%e0%a6%b6%e0%a7%81%e0%a6%b0%e0%a7%81-%e0%a6%b9%e0%a6%9a%e0%a7%8d%e0%a6%9b%e0%a7%87-%e0%a6%9a%e0%a6%bf%e0%a6%b0%e0%a7%81%e0%a6%a8%e0%a6%bf/</link>

      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/OnePlus-N6X-5G.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="OnePlus এর ৫জি স্মার্টফোন পাওয়া যাচ্ছে বিশাল ছাড়ে রয়েছে 7000mAh ব্যাটারির সুবিধা" /&gt;&lt;/p&gt;&lt;p&gt;অ্যামাজন সাইটে OnePlus N6X 5G ফোনে দুর্দান্ত ডিল দেওয়া হচ্ছে। ওয়ানপ্লাস এন6এক্স 5জি ফোনে অনেকটা ডিসকাউন্ট দেওয়া হচ্ছে। মিডিয়াটেক ডাইমেনসিটি 6260 অ্যাপেক্স প্রসেসর এবং 7000mAh ব্যাটারি ফিচার সহ ওয়ানপ্লাস এন6এক্স 5জি ফোনটি ওয়ানপ্লাস এর N সিরিজের আওতায় আসে। বর্তমানে Amazon সাইটে ফোনটি ব্যাঙ্ক অফারের স&lt;/p&gt;</description>
      <source url="https://zoombangla.com/oneplus-%e0%a6%8f%e0%a6%b0-%e0%a7%ab%e0%a6%9c%e0%a6%bf-%e0%a6%b8%e0%a7%8d%e0%a6%ae%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%9f%e0%a6%ab%e0%a7%8b%e0%a6%a8/">জুমবাংলা</source>
    </item>
    <item>
      <title>সৌদি আরবে সোনার ভরি কত? জেনে নিন</title>
      <link>https://zoombangla.com/%e0%a6%b8%e0%a7%8c%e0%a6%a6%e0%a6%bf-%e0%a6%86%e0%a6%b0%e0%a6%ac%e0%a7%87-%e0%a6%b8%e0%a7%8b%e0%a6%a8%e0%a6%be%e0%a6%b0-%e0%a6%ad%e0%a6%b0%e0%a6%bf-%e0%a6%95%e0%a6%a4-%e0%a6%9c%e0%a7%87%e0%a6%a8/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%b8%e0%a7%8c%e0%a6%a6%e0%a6%bf-%e0%a6%86%e0%a6%b0%e0%a6%ac%e0%a7%87-%e0%a6%b8%e0%a7%8b%e0%a6%a8%e0%a6%be%e0%a6%b0-%e0%a6%ad%e0%a6%b0%e0%a6%bf-%e0%a6%95%e0%a6%a4-%e0%a6%9c%e0%a7%87%e0%a6%a8/</guid>
      <pubDate>Fri, 13 Nov 2026 13:03:35 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Gold-12.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Gold-12.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Gold-12.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সৌদি আরবে সোনার ভরি কত? জেনে নিন" /&gt;&lt;/p&gt;&lt;p&gt;সৌদি আরবে সোনার দাম কমেছে। শুক্রবার (১৩ নভেম্বর) দেশটির বাজারে সবচেয়ে বেশি জনপ্রিয় ২১ ক্যারেট সোনার দাম কমে প্রতি গ্রাম ৪১১ দশমিক ৬৩ রিয়ালে দাঁড়িয়েছে। মার্কিন মুদ্রায় এর পরিমাণ প্রায় ১০৯ ডলার ৭৭ সেন্ট। ২১ ক্যারেট সোনার প্রতি গ্রাম দাম ৪১১ দশমিক ৬৩ সৌদি রিয়াল হলে, এক ভরি (১১.৬৬৪ গ্রাম) সোনার দাম প্রা&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%b8%e0%a7%8c%e0%a6%a6%e0%a6%bf-%e0%a6%86%e0%a6%b0%e0%a6%ac%e0%a7%87-%e0%a6%b8%e0%a7%8b%e0%a6%a8%e0%a6%be%e0%a6%b0-%e0%a6%ad%e0%a6%b0%e0%a6%bf-%e0%a6%95%e0%a6%a4-%e0%a6%9c%e0%a7%87%e0%a6%a8/">জুমবাংলা</source>
    </item>
    <item>
      <title>DSLR বা দামি ফোনের কোন প্রয়োজন নেই, নিয়মটি মানলে কমদামি ফোনেও উঠবে সেরা ছবি!</title>
      <link>https://zoombangla.com/dslr-%e0%a6%ac%e0%a6%be-%e0%a6%a6%e0%a6%be%e0%a6%ae%e0%a6%bf-%e0%a6%ab%e0%a7%8b%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a7%8b%e0%a6%a8-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%af%e0%a6%bc%e0%a7%8b%e0%a6%9c/</link>
      <guid isPermaLink="true">https://zoombangla.com/dslr-%e0%a6%ac%e0%a6%be-%e0%a6%a6%e0%a6%be%e0%a6%ae%e0%a6%bf-%e0%a6%ab%e0%a7%8b%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a7%8b%e0%a6%a8-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%af%e0%a6%bc%e0%a7%8b%e0%a6%9c/</guid>
      <pubDate>Fri, 13 Nov 2026 13:01:24 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Camera.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Camera.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Camera.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="DSLR বা দামি ফোনের কোন প্রয়োজন নেই, নিয়মটি মানলে কমদামি ফোনেও উঠবে সেরা ছবি!" /&gt;&lt;/p&gt;&lt;p&gt;ছোট ছোট আনন্দের মুহূর্তই জীবনে খুশির জোয়ার আনে। অবসরে সেই সময়ের স্মৃতিচারণ করি সবাই। একাল হোক কিংবা সেকাল সেই স্মৃতিচারণের অন্যতম মাধ্যম ছবি। যুগ বদলছে, ছবি তোলার ক্যামেরাও উন্নত হয়েছে। তবে অনেকেই ভাবেন ডিএসএলআর ক্যামেরা হলে ছবি ভালো উঠবে। এখন সেই ধারনা দামি ফোনের ক্যামেরার দৌলতে অনেকটাই ফিকে হয়েছে।&lt;/p&gt;</description>
      <source url="https://zoombangla.com/dslr-%e0%a6%ac%e0%a6%be-%e0%a6%a6%e0%a6%be%e0%a6%ae%e0%a6%bf-%e0%a6%ab%e0%a7%8b%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a7%8b%e0%a6%a8-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%af%e0%a6%bc%e0%a7%8b%e0%a6%9c/">জুমবাংলা</source>
    </item>
    <item>
      <title>সাহারা মরুভূমির মধ্যে পাওয়া গেল মঙ্গল গ্রহের পাথর, বয়স ৪০০ কোটি বছর!</title>
      <link>https://zoombangla.com/researchers-say-meteorite/</link>
      <guid isPermaLink="true">https://zoombangla.com/researchers-say-meteorite/</guid>
      <pubDate>Fri, 13 Nov 2026 12:55:59 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/sahara.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/sahara.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/sahara.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাহারা মরুভূমির মধ্যে পাওয়া গেল মঙ্গল গ্রহের পাথর, বয়স ৪০০ কোটি বছর!" /&gt;&lt;/p&gt;&lt;p&gt;উল্কাপিণ্ডটির বয়স অন্তত ৪১০ কোটি বছর। মঙ্গল গ্রহ সৃষ্টি হয়েছিল আনুমানিক ৪৫০-৪৬০ কোটি বছর আগে। সে ক্ষেত্রে মঙ্গলে যখন তরল অবস্থায় জল পাওয়া যেত, সে সময়ের তথ্যও মিলতে পারে এই উল্কাপিণ্ড থেকে। খোঁজ মিলেছিল চার বছর আগে। আফ্রিকার সাহারা মরুভূমিতে। গোলাপি রঙের এক উল্কাপিণ্ড। মঙ্গল গ্রহ থেকে ছিটকে বেরিয়ে আস&lt;/p&gt;</description>
      <source url="https://zoombangla.com/researchers-say-meteorite/">জুমবাংলা</source>
    </item>
    <item>
      <title>টাকের চিকিৎসায় নতুন সম্ভাবনা, চুল ফেরাবে বৈদ্যুতিক চিরুনি!</title>
      <link>https://zoombangla.com/%e0%a6%9f%e0%a6%be%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%9a%e0%a6%bf%e0%a6%95%e0%a6%bf%e0%a7%8e%e0%a6%b8%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%b8%e0%a6%ae%e0%a7%8d/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%9f%e0%a6%be%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%9a%e0%a6%bf%e0%a6%95%e0%a6%bf%e0%a7%8e%e0%a6%b8%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%b8%e0%a6%ae%e0%a7%8d/</guid>
      <pubDate>Fri, 13 Nov 2026 12:53:33 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Untitled-1-3.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Untitled-1-3.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Untitled-1-3.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টাকের চিকিৎসায় নতুন সম্ভাবনা, চুল ফেরাবে বৈদ্যুতিক চিরুনি!" /&gt;&lt;/p&gt;&lt;p&gt;টাক পড়া বা চুল ঝরে যাওয়ার সমস্যার সমাধানে নতুন এক প্রযুক্তি উদ্ভাবন করেছেন চীনা গবেষকেরা। সাধারণ চিরুনির মতো দেখতে বিশেষ একটি বৈদ্যুতিক যন্ত্র ব্যবহার করে পরীক্ষাগারে ইঁদুরের প্রায় সব হারানো চুল এক মাসের মধ্যে ফিরিয়ে আনতে সক্ষম হয়েছেন তারা। গবেষকদের দাবি, চুলের গোড়ায় সরাসরি চিকিৎসার উপাদান পৌঁছে দিত&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%9f%e0%a6%be%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%9a%e0%a6%bf%e0%a6%95%e0%a6%bf%e0%a7%8e%e0%a6%b8%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%b8%e0%a6%ae%e0%a7%8d/">জুমবাংলা</source>
    </item>
    <item>
      <title>নেকলেস বিতর্কে দীপিকা, নেট দুনিয়ায় তোলপাড়</title>
      <link>https://zoombangla.com/%e0%a6%a8%e0%a7%87%e0%a6%95%e0%a6%b2%e0%a7%87%e0%a6%b8-%e0%a6%ac%e0%a6%bf%e0%a6%a4%e0%a6%b0%e0%a7%8d%e0%a6%95%e0%a7%87-%e0%a6%a6%e0%a7%80%e0%a6%aa%e0%a6%bf%e0%a6%95%e0%a6%be-%e0%a6%a8%e0%a7%87/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%a8%e0%a7%87%e0%a6%95%e0%a6%b2%e0%a7%87%e0%a6%b8-%e0%a6%ac%e0%a6%bf%e0%a6%a4%e0%a6%b0%e0%a7%8d%e0%a6%95%e0%a7%87-%e0%a6%a6%e0%a7%80%e0%a6%aa%e0%a6%bf%e0%a6%95%e0%a6%be-%e0%a6%a8%e0%a7%87/</guid>
      <pubDate>Fri, 13 Nov 2026 12:49:49 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Dipika-2.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Dipika-2.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Dipika-2.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নেকলেস বিতর্কে দীপিকা, নেট দুনিয়ায় তোলপাড়" /&gt;&lt;/p&gt;&lt;p&gt;কারিনা কাপুর খানের দীপাবলির সাজে পবিত্র কোরআনের আয়াত খোদাই করা পান্নার লকেট পরা নিয়ে বিতর্কের মধ্যেই নতুন করে আলোচনায় এসেছেন বলিউড অভিনেত্রী দীপিকা পাড়ুকোন। সামাজিক যোগাযোগমাধ্যমে ছড়িয়ে পড়েছে ২০২২ সালের কান চলচ্চিত্র উৎসবে দীপিকার পরা একটি বিশেষ গয়নার ছবি। ওই গহনায় আরবি ভাষায় খোদাই করা ছিল&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%a8%e0%a7%87%e0%a6%95%e0%a6%b2%e0%a7%87%e0%a6%b8-%e0%a6%ac%e0%a6%bf%e0%a6%a4%e0%a6%b0%e0%a7%8d%e0%a6%95%e0%a7%87-%e0%a6%a6%e0%a7%80%e0%a6%aa%e0%a6%bf%e0%a6%95%e0%a6%be-%e0%a6%a8%e0%a7%87/">জুমবাংলা</source>
    </item>
    <item>
      <title>বায়ুদূষণে শীর্ষ দিল্লি, বাংলাদেশ কত জানুন</title>
      <link>https://zoombangla.com/%e0%a6%ac%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a7%81%e0%a6%a6%e0%a7%82%e0%a6%b7%e0%a6%a3%e0%a7%87-%e0%a6%b6%e0%a7%80%e0%a6%b0%e0%a7%8d%e0%a6%b7-%e0%a6%a6%e0%a6%bf%e0%a6%b2%e0%a7%8d%e0%a6%b2%e0%a6%bf/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%ac%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a7%81%e0%a6%a6%e0%a7%82%e0%a6%b7%e0%a6%a3%e0%a7%87-%e0%a6%b6%e0%a7%80%e0%a6%b0%e0%a7%8d%e0%a6%b7-%e0%a6%a6%e0%a6%bf%e0%a6%b2%e0%a7%8d%e0%a6%b2%e0%a6%bf/</guid>
      <pubDate>Fri, 13 Nov 2026 12:19:34 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Bayu.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Bayu.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Bayu.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বায়ুদূষণে শীর্ষ দিল্লি, বাংলাদেশ কত জানুন" /&gt;&lt;/p&gt;&lt;p&gt;বিশ্বের দূষিত বায়ুর শহরের তালিকায় আজ শীর্ষে রয়েছে ভারতের দিল্লি, স্কোর ৩৪২। অন্যদিকে তালিকায় চতুর্থ অবস্থানে রয়েছে বাংলাদেশের রাজধানী ঢাকা। এদিন সকালে ঢাকার এয়ার কোয়ালিটি ইনডেক্স (বায়ুর মান সূচক) স্কোর ছিল ১৭৩, যা ‘অস্বাস্থ্যকর’ হিসেবে বিবেচিত। শুক্রবার (১৩ মার্চ) সকাল সাড়ে ৮টায় সুইজারল্যান্ডভিত্&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ac%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a7%81%e0%a6%a6%e0%a7%82%e0%a6%b7%e0%a6%a3%e0%a7%87-%e0%a6%b6%e0%a7%80%e0%a6%b0%e0%a7%8d%e0%a6%b7-%e0%a6%a6%e0%a6%bf%e0%a6%b2%e0%a7%8d%e0%a6%b2%e0%a6%bf/">জুমবাংলা</source>
    </item>

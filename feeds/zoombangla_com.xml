    <item>
      <title>শ্রীমঙ্গলে সর্বনিম্ন তাপমাত্রা রেকর্ড</title>
      <link>https://zoombangla.com/%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a7%80%e0%a6%ae%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a6%b2%e0%a7%87-%e0%a6%b8%e0%a6%b0%e0%a7%8d%e0%a6%ac%e0%a6%a8%e0%a6%bf%e0%a6%ae%e0%a7%8d%e0%a6%a8-%e0%a6%a4%e0%a6%be%e0%a6%aa/</link>

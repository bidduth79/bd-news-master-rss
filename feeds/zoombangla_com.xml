      <pubDate>Fri, 20 Nov 2026 10:55:19 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/rituparna.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/rituparna.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/rituparna.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দুর্ঘটনায় দুমড়ে-মুচড়ে গেল ঋতুপর্ণার গাড়ি" /&gt;&lt;/p&gt;&lt;p&gt;দুর্ঘটনার কবলে পড়েছে ভারতীয় বাংলা সিনেমার জনপ্রিয় অভিনেত্রী ঋতুপর্ণা সেনগুপ্তর গাড়ি। বৃহস্পতিবার (১৯ নভেম্বর) সকালে অভিনেত্রীর বাড়ির সামনে দুর্ঘটনাটি ঘটে। এতে দুমড়ে-মুচড়ে গেছে তার গাড়িটি। তবে ঋতুপর্ণা সেনগুপ্ত নিরাপদে রয়েছেন। ঘটনা বর্ণনা করে ভারতীয় একটি গণমাধ্যমে ঋতুপর্ণা সেনগুপ্ত বলেন, “ঘটনার সময়ে &lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%a6%e0%a7%81%e0%a6%b0%e0%a7%8d%e0%a6%98%e0%a6%9f%e0%a6%a8%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%a6%e0%a7%81%e0%a6%ae%e0%a6%a1%e0%a6%bc%e0%a7%87/">জুমবাংলা</source>
    </item>
    <item>
      <title>কর বাড়ানোর প্রতিবাদে উত্তাল কলম্বিয়া, রাজপথে হাজারো মানুষ</title>
      <link>https://zoombangla.com/%e0%a6%95%e0%a6%b0-%e0%a6%ac%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a6%be%e0%a6%a8%e0%a7%8b%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4%e0%a6%bf%e0%a6%ac%e0%a6%be%e0%a6%a6%e0%a7%87/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%95%e0%a6%b0-%e0%a6%ac%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a6%be%e0%a6%a8%e0%a7%8b%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4%e0%a6%bf%e0%a6%ac%e0%a6%be%e0%a6%a6%e0%a7%87/</guid>
      <pubDate>Fri, 20 Nov 2026 10:50:34 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Andolon.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Andolon.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Andolon.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কর বাড়ানোর প্রতিবাদে উত্তাল কলম্বিয়া, রাজপথে হাজারো মানুষ" /&gt;&lt;/p&gt;&lt;p&gt;কলম্বিয়ায় প্রস্তাবিত কর সংস্কার ও জীবনযাত্রার ব্যয় বৃদ্ধির প্রতিবাদে দেশজুড়ে বিক্ষোভ করেছেন হাজারো মানুষ। বৃহস্পতিবার (১৯ নভেম্বর) রাজধানী বোগোতাসহ বিভিন্ন বড় শহরে শ্রমিক সংগঠন, শিক্ষার্থী ও বিরোধী দলের নেতাকর্মীরা এ বিক্ষোভে অংশ নেন। শুক্রবার (২০ নভেম্বর) আন্তর্জাতিক সংবাদমাধ্যম আল জাজিরা এক প্রতিব&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%95%e0%a6%b0-%e0%a6%ac%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a6%be%e0%a6%a8%e0%a7%8b%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4%e0%a6%bf%e0%a6%ac%e0%a6%be%e0%a6%a6%e0%a7%87/">জুমবাংলা</source>
    </item>
    <item>
      <title>ভ ‘য়া ব হ অভিজ্ঞতার কথা জানালেন ঋতুপর্ণা</title>
      <link>https://zoombangla.com/%e0%a6%ad-%e0%a6%af%e0%a6%bc%e0%a6%be-%e0%a6%ac-%e0%a6%b9-%e0%a6%85%e0%a6%ad%e0%a6%bf%e0%a6%9c%e0%a7%8d%e0%a6%9e%e0%a6%a4%e0%a6%be%e0%a6%b0-%e0%a6%95%e0%a6%a5%e0%a6%be/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%ad-%e0%a6%af%e0%a6%bc%e0%a6%be-%e0%a6%ac-%e0%a6%b9-%e0%a6%85%e0%a6%ad%e0%a6%bf%e0%a6%9c%e0%a7%8d%e0%a6%9e%e0%a6%a4%e0%a6%be%e0%a6%b0-%e0%a6%95%e0%a6%a5%e0%a6%be/</guid>
      <pubDate>Fri, 20 Nov 2026 09:16:23 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/ritu.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/ritu.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/ritu.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভ ‘য়া ব হ অভিজ্ঞতার কথা জানালেন ঋতুপর্ণা" /&gt;&lt;/p&gt;&lt;p&gt;উৎসবের আনন্দের মধ্যেই বড় ধরনের দুর্ঘটনার মুখে পড়লেন টালিউডের জনপ্রিয় অভিনেত্রী ঋতুপর্ণা সেনগুপ্ত। বৃহস্পতিবার (১৯ নভেম্বর) সকালে তার বাড়ির সামনে দাঁড়িয়ে থাকা বিলাসবহুল গাড়িতে সজোরে ধাক্কা দেয় অন্য একটি গাড়ি। আকস্মিক এ ঘটনায় অল্পের জন্য বড় বিপদ থেকে রক্ষা পেলেন এই অভিনেত্রী। ভারতীয় সংবাদমাধ্যমের প্রত&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ad-%e0%a6%af%e0%a6%bc%e0%a6%be-%e0%a6%ac-%e0%a6%b9-%e0%a6%85%e0%a6%ad%e0%a6%bf%e0%a6%9c%e0%a7%8d%e0%a6%9e%e0%a6%a4%e0%a6%be%e0%a6%b0-%e0%a6%95%e0%a6%a5%e0%a6%be/">জুমবাংলা</source>
    </item>
    <item>
      <title>বৃষ্টি আর কতদিন থাকবে, যা জানা গেল</title>
      <link>https://zoombangla.com/%e0%a6%ac%e0%a7%83%e0%a6%b7%e0%a7%8d%e0%a6%9f%e0%a6%bf-%e0%a6%86%e0%a6%b0-%e0%a6%95%e0%a6%a4%e0%a6%a6%e0%a6%bf%e0%a6%a8-%e0%a6%a5%e0%a6%be%e0%a6%95%e0%a6%ac%e0%a7%87-%e0%a6%af%e0%a6%be/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%ac%e0%a7%83%e0%a6%b7%e0%a7%8d%e0%a6%9f%e0%a6%bf-%e0%a6%86%e0%a6%b0-%e0%a6%95%e0%a6%a4%e0%a6%a6%e0%a6%bf%e0%a6%a8-%e0%a6%a5%e0%a6%be%e0%a6%95%e0%a6%ac%e0%a7%87-%e0%a6%af%e0%a6%be/</guid>
      <pubDate>Fri, 20 Nov 2026 09:15:18 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/weather-3.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/weather-3.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/weather-3.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বৃষ্টি আর কতদিন থাকবে, যা জানা গেল" /&gt;&lt;/p&gt;&lt;p&gt;বৃষ্টি আর দমকা হাওয়ার দাপট আপাতত কাটছে না। দেশের বিভিন্ন অঞ্চলে আরও দু-এক দিন অব্যাহত থাকতে পারে বৃষ্টির প্রবণতা। তবে রোববার থেকে ধীরে ধীরে কমে আসবে বৃষ্টির বিস্তৃতি। সোম ও মঙ্গলবার দেশের অধিকাংশ এলাকায় ফিরতে পারে শুষ্ক আবহাওয়া। আর মেঘমুক্ত আকাশের হাত ধরে নামতে শুরু করবে রাতের তাপমাত্রা, বাড়বে শীতের&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ac%e0%a7%83%e0%a6%b7%e0%a7%8d%e0%a6%9f%e0%a6%bf-%e0%a6%86%e0%a6%b0-%e0%a6%95%e0%a6%a4%e0%a6%a6%e0%a6%bf%e0%a6%a8-%e0%a6%a5%e0%a6%be%e0%a6%95%e0%a6%ac%e0%a7%87-%e0%a6%af%e0%a6%be/">জুমবাংলা</source>
    </item>
    <item>
      <title>সশস্ত্র বাহিনীর জন্য সরকারের নতুন বেতন কাঠামো</title>
      <link>https://zoombangla.com/%e0%a6%b8%e0%a6%b6%e0%a6%b8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0-%e0%a6%ac%e0%a6%be%e0%a6%b9%e0%a6%bf%e0%a6%a8%e0%a7%80%e0%a6%b0-%e0%a6%9c%e0%a6%a8%e0%a7%8d%e0%a6%af/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%b8%e0%a6%b6%e0%a6%b8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0-%e0%a6%ac%e0%a6%be%e0%a6%b9%e0%a6%bf%e0%a6%a8%e0%a7%80%e0%a6%b0-%e0%a6%9c%e0%a6%a8%e0%a7%8d%e0%a6%af/</guid>
      <pubDate>Fri, 20 Nov 2026 09:09:49 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/sallary.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/sallary.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/sallary.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সশস্ত্র বাহিনীর জন্য সরকারের নতুন বেতন কাঠামো" /&gt;&lt;/p&gt;&lt;p&gt;বেসামরিক সরকারি কর্মচারীদের জন্য নতুন বেতন কাঠামোর প্রজ্ঞাপন জারির প্রায় দুই মাস পর এবার সশস্ত্র বাহিনীর সদস্যদের জন্য নতুন বেতন ও ভাতা নির্ধারণ করেছে সরকার। নতুন কাঠামোতে সেনাবাহিনী, নৌবাহিনী ও বিমানবাহিনী-এই তিন বাহিনীপ্রধানের মূল বেতন নির্ধারণ করা হয়েছে ১ লাখ ৭২ হাজার টাকা। আর সৈনিকদের মূল বেতন&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%b8%e0%a6%b6%e0%a6%b8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0-%e0%a6%ac%e0%a6%be%e0%a6%b9%e0%a6%bf%e0%a6%a8%e0%a7%80%e0%a6%b0-%e0%a6%9c%e0%a6%a8%e0%a7%8d%e0%a6%af/">জুমবাংলা</source>
    </item>
    <item>
      <title>হাইকমিশনে পাঠানো হাসিনার চিঠির স্বাক্ষর জাল, যেভাবে ধরা পড়ল</title>
      <link>https://zoombangla.com/%e0%a6%b9%e0%a6%be%e0%a6%87%e0%a6%95%e0%a6%ae%e0%a6%bf%e0%a6%b6%e0%a6%a8%e0%a7%87-%e0%a6%aa%e0%a6%be%e0%a6%a0%e0%a6%be%e0%a6%a8%e0%a7%8b/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%b9%e0%a6%be%e0%a6%87%e0%a6%95%e0%a6%ae%e0%a6%bf%e0%a6%b6%e0%a6%a8%e0%a7%87-%e0%a6%aa%e0%a6%be%e0%a6%a0%e0%a6%be%e0%a6%a8%e0%a7%8b/</guid>
      <pubDate>Fri, 20 Nov 2026 08:25:18 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/hasina-7.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/hasina-7.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/hasina-7.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হাইকমিশনে পাঠানো হাসিনার চিঠির স্বাক্ষর জাল, যেভাবে ধরা পড়ল" /&gt;&lt;/p&gt;&lt;p&gt;শেখ হাসিনার নতুন পাসপোর্ট ও জাতীয় পরিচয়পত্র ইস্যু নিয়ে এবার যুক্তরাজ্যের আইনি প্রতিষ্ঠান ম্যাট্রিক্স চেম্বার্সের তৎপরতা। গত ৯ নভেম্বর লন্ডনে বাংলাদেশের হাইকমিশনে চিঠি পাঠিয়ে তার জন্য নতুন পাসপোর্ট ও এনআইডি ইস্যুর অনুরোধ জানায় প্রতিষ্ঠানটি। চিঠিতে শেখ হাসিনার আগের পাসপোর্ট ও জাতীয় পরিচয়পত্র বাতিলের ব&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%b9%e0%a6%be%e0%a6%87%e0%a6%95%e0%a6%ae%e0%a6%bf%e0%a6%b6%e0%a6%a8%e0%a7%87-%e0%a6%aa%e0%a6%be%e0%a6%a0%e0%a6%be%e0%a6%a8%e0%a7%8b/">জুমবাংলা</source>
    </item>
    <item>
      <title>ঘূর্ণিঝড় আকভানের প্রভাব কেমন পড়বে বাংলাদেশে</title>
      <link>https://zoombangla.com/%e0%a6%98%e0%a7%82%e0%a6%b0%e0%a7%8d%e0%a6%a3%e0%a6%bf%e0%a6%9d%e0%a6%a1%e0%a6%bc-%e0%a6%86%e0%a6%95%e0%a6%ad%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b0/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%98%e0%a7%82%e0%a6%b0%e0%a7%8d%e0%a6%a3%e0%a6%bf%e0%a6%9d%e0%a6%a1%e0%a6%bc-%e0%a6%86%e0%a6%95%e0%a6%ad%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b0/</guid>
      <pubDate>Fri, 20 Nov 2026 08:17:37 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Storm-1.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Storm-1.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Storm-1.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঘূর্ণিঝড় আকভানের প্রভাব কেমন পড়বে বাংলাদেশে" /&gt;&lt;/p&gt;&lt;p&gt;পশ্চিম-মধ্য বঙ্গোপসাগরে অবস্থানরত ঘূর্ণিঝড় আকভানের প্রভাবে দেশের ১০ জেলার ওপর দিয়ে ঘণ্টায় সর্বোচ্চ ৬০ কিলোমিটার বেগে ঝড় বয়ে যেতে পারে। এ ছাড়া দেশের সব বিভাগে অস্থায়ীভাবে দমকা হাওয়াসহ হালকা থেকে মাঝারি ধরনের বৃষ্টি অথবা বজ্রসহ বৃষ্টি হতে পারে। শুক্রবার (২০ নভেম্বর) পৃথক দুই পূর্বাভাসে এসব তথ্য জানায় &lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%98%e0%a7%82%e0%a6%b0%e0%a7%8d%e0%a6%a3%e0%a6%bf%e0%a6%9d%e0%a6%a1%e0%a6%bc-%e0%a6%86%e0%a6%95%e0%a6%ad%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b0/">জুমবাংলা</source>
    </item>
    <item>
      <title>স্বর্ণের দামে বড় পতন, ভরিতে কমলো ১১ হাজার</title>
      <link>https://zoombangla.com/%e0%a6%b8%e0%a7%8d%e0%a6%ac%e0%a6%b0%e0%a7%8d%e0%a6%a3%e0%a7%87%e0%a6%b0-%e0%a6%a6%e0%a6%be%e0%a6%ae%e0%a7%87-%e0%a6%ac%e0%a6%a1%e0%a6%bc-%e0%a6%aa%e0%a6%a4%e0%a6%a8-%e0%a6%ad%e0%a6%b0%e0%a6%bf-2/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%b8%e0%a7%8d%e0%a6%ac%e0%a6%b0%e0%a7%8d%e0%a6%a3%e0%a7%87%e0%a6%b0-%e0%a6%a6%e0%a6%be%e0%a6%ae%e0%a7%87-%e0%a6%ac%e0%a6%a1%e0%a6%bc-%e0%a6%aa%e0%a6%a4%e0%a6%a8-%e0%a6%ad%e0%a6%b0%e0%a6%bf-2/</guid>
      <pubDate>Fri, 20 Nov 2026 08:16:52 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/gold-18.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/gold-18.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/gold-18.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="স্বর্ণের দামে বড় পতন, ভরিতে কমলো ১১ হাজার" /&gt;&lt;/p&gt;&lt;p&gt;স্বর্ণের বাজারে বড় ধস। এক লাফেই ভরিপ্রতি প্রায় ১১ হাজার টাকা কমলো সোনার দাম। ফলে স্বর্ণ কিনতে ক্রেতাদের জন্য তৈরি হয়েছে বড় স্বস্তির সুযোগ। বাংলাদেশ জুয়েলার্স অ্যাসোসিয়েশন (বাজুস) নতুন সিদ্ধান্তে ভ্যাটসহ ২২ ক্যারেটের প্রতি ভরি স্বর্ণের দাম নেমে এসেছে ২ লাখ ১ হাজার ১৪৬ টাকায়। আর এ নিয়ে টানা আট দফায় কম&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%b8%e0%a7%8d%e0%a6%ac%e0%a6%b0%e0%a7%8d%e0%a6%a3%e0%a7%87%e0%a6%b0-%e0%a6%a6%e0%a6%be%e0%a6%ae%e0%a7%87-%e0%a6%ac%e0%a6%a1%e0%a6%bc-%e0%a6%aa%e0%a6%a4%e0%a6%a8-%e0%a6%ad%e0%a6%b0%e0%a6%bf-2/">জুমবাংলা</source>
    </item>
    <item>
      <title>আবারও বিশ্বমঞ্চে উজ্জ্বল নাজিফা তুষি, জিতলেন সেরা অভিনেত্রীর পুরস্কার</title>
      <link>https://zoombangla.com/%e0%a6%86%e0%a6%ac%e0%a6%be%e0%a6%b0%e0%a6%93-%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%ac%e0%a6%ae%e0%a6%9e%e0%a7%8d%e0%a6%9a%e0%a7%87/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%86%e0%a6%ac%e0%a6%be%e0%a6%b0%e0%a6%93-%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%ac%e0%a6%ae%e0%a6%9e%e0%a7%8d%e0%a6%9a%e0%a7%87/</guid>
      <pubDate>Fri, 20 Nov 2026 08:15:12 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Tushi.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Tushi.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Tushi.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আবারও বিশ্বমঞ্চে উজ্জ্বল নাজিফা তুষি, জিতলেন সেরা অভিনেত্রীর পুরস্কার" /&gt;&lt;/p&gt;&lt;p&gt;আন্তর্জাতিক চলচ্চিত্র অঙ্গনে আবারও সাফল্য পেলেন বাংলাদেশের অভিনেত্রী নাজিফা তুষি। মেজবাউর রহমান সুমন পরিচালিত ‘রইদ’ সিনেমায় অভিনয়ের জন্য যুক্তরাষ্ট্রের লস অ্যাঞ্জেলেসে অনুষ্ঠিত ২০২৬ সালের এশিয়ান ওয়ার্ল্ড চলচ্চিত্র উৎসবে সেরা অভিনেত্রীর পুরস্কার জিতেছেন তিনি। উৎসবের ১২তম আসরে ‘স্নো লেপার্ড’ পুরস্কারে&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%86%e0%a6%ac%e0%a6%be%e0%a6%b0%e0%a6%93-%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%ac%e0%a6%ae%e0%a6%9e%e0%a7%8d%e0%a6%9a%e0%a7%87/">জুমবাংলা</source>
    </item>
    <item>
      <title>হঠাৎ বৃষ্টিতে যেসব ক্ষতির শঙ্কা দেখছেন কৃষকেরা</title>
      <link>https://zoombangla.com/%e0%a6%b9%e0%a6%a0%e0%a6%be%e0%a7%8e-%e0%a6%ac%e0%a7%83%e0%a6%b7%e0%a7%8d%e0%a6%9f%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%af%e0%a7%87%e0%a6%b8%e0%a6%ac/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%b9%e0%a6%a0%e0%a6%be%e0%a7%8e-%e0%a6%ac%e0%a7%83%e0%a6%b7%e0%a7%8d%e0%a6%9f%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%af%e0%a7%87%e0%a6%b8%e0%a6%ac/</guid>
      <pubDate>Fri, 20 Nov 2026 08:13:22 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/rain-6.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/rain-6.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/rain-6.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হঠাৎ বৃষ্টিতে যেসব ক্ষতির শঙ্কা দেখছেন কৃষকেরা" /&gt;&lt;/p&gt;&lt;p&gt;বঙ্গোপসাগরে সৃষ্ট প্রবল ঘূর্ণিঝড় ‘আকভান’-এর প্রভাবে দেশের উপকূলীয় জেলাগুলোতে শুরু হয়েছে থেমে থেমে বৃষ্টিপাত ও দমকা হাওয়া। এর প্রভাবে ভোলা, ঝালকাঠি, চাঁদপুর ও পিরোজপুরসহ উপকূলীয় বিভিন্ন এলাকায় বিরাজ করছে বৈরী আবহাওয়া। কোথাও গুঁড়ি গুঁড়ি বৃষ্টি, কোথাও উত্তাল নদ-নদী। আর এই অসময়ের বৃষ্টিতে সবচেয়ে বেশি দু&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%b9%e0%a6%a0%e0%a6%be%e0%a7%8e-%e0%a6%ac%e0%a7%83%e0%a6%b7%e0%a7%8d%e0%a6%9f%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%af%e0%a7%87%e0%a6%b8%e0%a6%ac/">জুমবাংলা</source>
    </item>

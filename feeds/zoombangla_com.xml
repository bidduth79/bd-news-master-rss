      <source url="https://zoombangla.com/%e0%a6%ac%e0%a6%bf%e0%a6%9a%e0%a7%8d%e0%a6%9b%e0%a7%87%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%98%e0%a7%8b%e0%a6%b7%e0%a6%a3%e0%a6%be-%e0%a6%a6%e0%a6%bf%e0%a6%b2%e0%a7%87%e0%a6%a8/">জুমবাংলা</source>
    </item>
    <item>
      <title>জানুয়ারি থেকেই স্কুল ড্রেস, জুতা ও ব্যাগ পাবে শিশুরা</title>
      <link>https://zoombangla.com/%e0%a6%9c%e0%a6%be%e0%a6%a8%e0%a7%81%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0%e0%a6%bf-%e0%a6%a5%e0%a7%87%e0%a6%95%e0%a7%87%e0%a6%87-%e0%a6%b8%e0%a7%8d%e0%a6%95%e0%a7%81%e0%a6%b2/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%9c%e0%a6%be%e0%a6%a8%e0%a7%81%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0%e0%a6%bf-%e0%a6%a5%e0%a7%87%e0%a6%95%e0%a7%87%e0%a6%87-%e0%a6%b8%e0%a7%8d%e0%a6%95%e0%a7%81%e0%a6%b2/</guid>
      <pubDate>Wed, 25 Nov 2026 18:24:56 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2-%E0%A6%A1%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B8-%E0%A6%9C%E0%A7%81%E0%A6%A4%E0%A6%BE-%E0%A6%93-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%97-%E0%A6%AA%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A6%BE.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2-%E0%A6%A1%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B8-%E0%A6%9C%E0%A7%81%E0%A6%A4%E0%A6%BE-%E0%A6%93-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%97-%E0%A6%AA%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A6%BE.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2-%E0%A6%A1%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B8-%E0%A6%9C%E0%A7%81%E0%A6%A4%E0%A6%BE-%E0%A6%93-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%97-%E0%A6%AA%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A6%BE.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জানুয়ারি থেকেই স্কুল ড্রেস, জুতা ও ব্যাগ পাবে শিশুরা" /&gt;&lt;/p&gt;&lt;p&gt;আগামী বছরের জানুয়ারি মাস থেকেই শিশুদের জন্য নির্ধারিত স্কুল ড্রেস (পোশাক), জুতা ও ব্যাগ সরবরাহ করবে সরকার। বুধবার (২৫ নভেম্বর) রাজধানীর শাহবাগে বাংলাদেশ শিশু একাডেমি মিলনায়তনে আয়োজিত ‘ন্যাশনাল চাইল্ড অ্যান্ড ইয়ুথ লেড ডায়ালগ’ অনুষ্ঠানে এ কথা জানান নারী ও শিশুবিষয়ক মন্ত্রী ডা. এ জেড এম জাহিদ হোসেন। অন&lt;/p&gt;</description>

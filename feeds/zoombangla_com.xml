    </item>
    <item>
      <title>নড়াইলে বিএনপির মিছিলে কার্যক্রম নিষিদ্ধ আ.লীগের হামলা, দুই নেতা নিহত</title>
      <link>https://zoombangla.com/%e0%a6%a8%e0%a6%a1%e0%a6%bc%e0%a6%be%e0%a6%87%e0%a6%b2%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%8f%e0%a6%a8%e0%a6%aa%e0%a6%bf%e0%a6%b0-%e0%a6%ae%e0%a6%bf%e0%a6%9b%e0%a6%bf%e0%a6%b2%e0%a7%87/</link>

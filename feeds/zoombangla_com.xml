      <pubDate>Fri, 13 Nov 2026 02:48:25 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/alim-medium.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/alim-medium.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/alim-medium.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আলিম সাপ্লিমেন্টারি পরীক্ষার কেন্দ্র তালিকা প্রকাশ" /&gt;&lt;/p&gt;&lt;p&gt;আলিম সাপ্লিমেন্টারি পরীক্ষার কেন্দ্র তালিকা প্রকাশ করা হয়েছে। মোট ৬৪টি কেন্দ্রে এ পরীক্ষা অনুষ্ঠিত হবে। বৃহস্পতিবার (১২ নভেম্বর) মাদ্রাসা শিক্ষা বোর্ড এ তালিকা প্রকাশ করে। প্রসঙ্গত, আলিম সাপ্লিমেন্টারি পরীক্ষা আগামী ১ ডিসেম্বর থেকে শুরু হবে। শিক্ষাসহ সব খবর সবার আগে জানতে দৈনিক শিক্ষাডটকমের ইউটিউব চ&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%86%e0%a6%b2%e0%a6%bf%e0%a6%ae-%e0%a6%b8%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%b2%e0%a6%bf%e0%a6%ae%e0%a7%87%e0%a6%a8%e0%a7%8d%e0%a6%9f%e0%a6%be%e0%a6%b0%e0%a6%bf-%e0%a6%aa%e0%a6%b0%e0%a7%80%e0%a6%95/">জুমবাংলা</source>
    </item>
    <item>
      <title>৬ মাসের বেতন, ম্যাকবুক, ব্যবসা করতে চাইলে আরও ১০ হাজার ডলার— ১২৭১ কর্মীকে ছাঁটাই করে প্রশংসায় ভাসছেন ক্যানভা সিইও</title>
      <link>https://zoombangla.com/%e0%a7%ac-%e0%a6%ae%e0%a6%be%e0%a6%b8%e0%a7%87%e0%a6%b0-%e0%a6%ac%e0%a7%87%e0%a6%a4%e0%a6%a8-%e0%a6%ae%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%95%e0%a6%ac%e0%a7%81%e0%a6%95-%e0%a6%ac%e0%a7%8d%e0%a6%af/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a7%ac-%e0%a6%ae%e0%a6%be%e0%a6%b8%e0%a7%87%e0%a6%b0-%e0%a6%ac%e0%a7%87%e0%a6%a4%e0%a6%a8-%e0%a6%ae%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%95%e0%a6%ac%e0%a7%81%e0%a6%95-%e0%a6%ac%e0%a7%8d%e0%a6%af/</guid>
      <pubDate>Fri, 13 Nov 2026 02:38:50 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/1794502840_69093c00f527f8d38355.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/1794502840_69093c00f527f8d38355.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/1794502840_69093c00f527f8d38355.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৬ মাসের বেতন, ম্যাকবুক, ব্যবসা করতে চাইলে আরও ১০ হাজার ডলার— ১২৭১ কর্মীকে ছাঁটাই করে প্রশংসায় ভাসছেন ক্যানভা সিইও" /&gt;&lt;/p&gt;&lt;p&gt;কর্মী ছাঁটাই সাধারণত কোনো প্রতিষ্ঠানের জন্যই স্বস্তির বিষয় নয়। বরং এমন সিদ্ধান্তের কারণে প্রায়ই সমালোচনার মুখে পড়তে হয় কর্পোরেট প্রতিষ্ঠানগুলোকে। তবে এবার কর্মী ছাঁটাইয়ের পর ভিন্ন ধরনের প্রশংসা পাচ্ছে ডিজাইন প্ল্যাটফর্ম ক্যানভা। ছাঁটাইয়ের প্রক্রিয়া ও ক্ষতিগ্রস্ত কর্মীদের জন্য দেওয়া ক্ষতিপূরণ প্যাকেজ&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a7%ac-%e0%a6%ae%e0%a6%be%e0%a6%b8%e0%a7%87%e0%a6%b0-%e0%a6%ac%e0%a7%87%e0%a6%a4%e0%a6%a8-%e0%a6%ae%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%95%e0%a6%ac%e0%a7%81%e0%a6%95-%e0%a6%ac%e0%a7%8d%e0%a6%af/">জুমবাংলা</source>
    </item>
    <item>
      <title>ত্বকের উজ্জ্বলতা কমাচ্ছে রূপচর্চার যেসব ভুল</title>
      <link>https://zoombangla.com/%e0%a6%a4%e0%a7%8d%e0%a6%ac%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%89%e0%a6%9c%e0%a7%8d%e0%a6%9c%e0%a7%8d%e0%a6%ac%e0%a6%b2%e0%a6%a4%e0%a6%be-%e0%a6%95%e0%a6%ae%e0%a6%be%e0%a6%9a%e0%a7%8d%e0%a6%9b%e0%a7%87/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%a4%e0%a7%8d%e0%a6%ac%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%89%e0%a6%9c%e0%a7%8d%e0%a6%9c%e0%a7%8d%e0%a6%ac%e0%a6%b2%e0%a6%a4%e0%a6%be-%e0%a6%95%e0%a6%ae%e0%a6%be%e0%a6%9a%e0%a7%8d%e0%a6%9b%e0%a7%87/</guid>
      <pubDate>Fri, 13 Nov 2026 02:26:57 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/pic-4-1794468109.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/pic-4-1794468109.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/pic-4-1794468109.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ত্বকের উজ্জ্বলতা কমাচ্ছে রূপচর্চার যেসব ভুল" /&gt;&lt;/p&gt;&lt;p&gt;আজকাল সামাজিক যোগাযোগ মাধ্যম ও ইন্টারনেটে রূপচর্চা বিষয়ক নানা ধরনের পরামর্শ পাওয়া যায়। বিভিন্ন ধরনের তথ্যের ভিড়ে রূপচর্চার সঠিন রুটিন বেছে নেওয়া কারও কারও কাছে বেশ কঠিন হয়ে পড়ে। চর্মরোগ বিশেষজ্ঞদের মতে, প্রত্যেকের ত্বকের ধরন ও চাহিদা আলাদা হওয়ায়, না বুঝে ভুল পণ্য বা পদ্ধতি অনুসরণ করলে ত্বকের ক্ষতি হ&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%a4%e0%a7%8d%e0%a6%ac%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%89%e0%a6%9c%e0%a7%8d%e0%a6%9c%e0%a7%8d%e0%a6%ac%e0%a6%b2%e0%a6%a4%e0%a6%be-%e0%a6%95%e0%a6%ae%e0%a6%be%e0%a6%9a%e0%a7%8d%e0%a6%9b%e0%a7%87/">জুমবাংলা</source>
    </item>
    <item>
      <title>আর্থিক প্রতিষ্ঠানের শীর্ষ তিন পদে নিয়োগের যোগ্যতা নির্ধারণ</title>
      <link>https://zoombangla.com/%e0%a6%86%e0%a6%b0%e0%a7%8d%e0%a6%a5%e0%a6%bf%e0%a6%95-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4%e0%a6%bf%e0%a6%b7%e0%a7%8d%e0%a6%a0%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%b6%e0%a7%80%e0%a6%b0%e0%a7%8d/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%86%e0%a6%b0%e0%a7%8d%e0%a6%a5%e0%a6%bf%e0%a6%95-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4%e0%a6%bf%e0%a6%b7%e0%a7%8d%e0%a6%a0%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%b6%e0%a7%80%e0%a6%b0%e0%a7%8d/</guid>
      <pubDate>Fri, 13 Nov 2026 02:22:46 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/b4a76db45dff449da29c41ecb8b3bbfa-5791baf2109d8.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/b4a76db45dff449da29c41ecb8b3bbfa-5791baf2109d8.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/b4a76db45dff449da29c41ecb8b3bbfa-5791baf2109d8.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আর্থিক প্রতিষ্ঠানের শীর্ষ তিন পদে নিয়োগের যোগ্যতা নির্ধারণ" /&gt;&lt;/p&gt;&lt;p&gt;দেশের আর্থিক প্রতিষ্ঠানগুলোর শীর্ষ পর্যায়ের আরও তিনটি পদে নিয়োগের যোগ্যতা ও মানদণ্ড নির্ধারণ করে দিয়েছে বাংলাদেশ ব্যাংক। এখন থেকে প্রধান আর্থিক কর্মকর্তা (সিএফও), প্রধান তথ্যপ্রযুক্তি কর্মকর্তা (সিটিও) এবং কোম্পানি সচিব পদে নিয়োগের ক্ষেত্রে সংশ্লিষ্ট ব্যক্তির শিক্ষাগত যোগ্যতা, পেশাগত দক্ষতা ও কাজের &lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%86%e0%a6%b0%e0%a7%8d%e0%a6%a5%e0%a6%bf%e0%a6%95-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4%e0%a6%bf%e0%a6%b7%e0%a7%8d%e0%a6%a0%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%b6%e0%a7%80%e0%a6%b0%e0%a7%8d/">জুমবাংলা</source>
    </item>
    <item>
      <title>ভারতের ভিজিটর ভিসায় বড় পরিবর্তন, থাকছে ১০ বছর মেয়াদি সুবিধা</title>
      <link>https://zoombangla.com/%e0%a6%ad%e0%a6%be%e0%a6%b0%e0%a6%a4%e0%a7%87%e0%a6%b0-%e0%a6%ad%e0%a6%bf%e0%a6%9c%e0%a6%bf%e0%a6%9f%e0%a6%b0-%e0%a6%ad%e0%a6%bf%e0%a6%b8%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%ac%e0%a6%a1%e0%a6%bc/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%ad%e0%a6%be%e0%a6%b0%e0%a6%a4%e0%a7%87%e0%a6%b0-%e0%a6%ad%e0%a6%bf%e0%a6%9c%e0%a6%bf%e0%a6%9f%e0%a6%b0-%e0%a6%ad%e0%a6%bf%e0%a6%b8%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%ac%e0%a6%a1%e0%a6%bc/</guid>
      <pubDate>Fri, 13 Nov 2026 02:18:48 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/7-1794514870-1.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/7-1794514870-1.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/7-1794514870-1.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভারতের ভিজিটর ভিসায় বড় পরিবর্তন, থাকছে ১০ বছর মেয়াদি সুবিধা" /&gt;&lt;/p&gt;&lt;p&gt;বিদেশি ভ্রমণকারীদের জন্য ভিসাব্যবস্থায় পরিবর্তন এনেছে ভারত। দেশটির সরকার পর্যটন ভিসার নাম পরিবর্তন করে ‘ভিজিটর ভিসা’ করেছে। একই সঙ্গে এই ভিসাকে ভি-১ ও ভি-২- দুই শ্রেণিতে ভাগ করা হয়েছে। নতুন ব্যবস্থায় স্বল্পমেয়াদি ভ্রমণের পাশাপাশি এক, পাঁচ ও ১০ বছর মেয়াদি ভিসার সুযোগ রাখা হয়েছে। ভারতের সংবাদমাধ্যম এন&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ad%e0%a6%be%e0%a6%b0%e0%a6%a4%e0%a7%87%e0%a6%b0-%e0%a6%ad%e0%a6%bf%e0%a6%9c%e0%a6%bf%e0%a6%9f%e0%a6%b0-%e0%a6%ad%e0%a6%bf%e0%a6%b8%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%ac%e0%a6%a1%e0%a6%bc/">জুমবাংলা</source>
    </item>

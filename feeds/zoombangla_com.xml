      <pubDate>Sun, 22 Nov 2026 18:09:51 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A6%B0%E0%A7%80%E0%A6%B0%E0%A7%87-%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A6%B8%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AE-%E0%A6%98%E0%A6%BE%E0%A6%9F%E0%A6%A4%E0%A6%BF.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A6%B0%E0%A7%80%E0%A6%B0%E0%A7%87-%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A6%B8%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AE-%E0%A6%98%E0%A6%BE%E0%A6%9F%E0%A6%A4%E0%A6%BF.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A6%B0%E0%A7%80%E0%A6%B0%E0%A7%87-%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A6%B8%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AE-%E0%A6%98%E0%A6%BE%E0%A6%9F%E0%A6%A4%E0%A6%BF.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কীভাবে বুঝবেন আপনার সন্তানের শরীরে ক্যালসিয়াম ঘাটতি?" /&gt;&lt;/p&gt;&lt;p&gt;আপনার সন্তানের শরীরে ক্যালসিয়ামের ঘাটতি (হাইপোক্যালসেমিয়া) হলে পেশিতে টান ধরা, দাঁত উঠতে দেরি হওয়া, অতিরিক্ত ক্লান্তি এবং হাড়ের ব্যথার মতো লক্ষণ দেখা দিতে পারে। অনেক সময় প্রাথমিক অবস্থায় কোনো লক্ষণ বোঝা না গেলেও বয়সভেদে এমন উপসর্গগুলো দেখা দিতে পারে। আবার অনেক শিশুর শরীরে পর্যাপ্ত পরিমাণে ক্যালসিয়&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%95%e0%a7%80%e0%a6%ad%e0%a6%be%e0%a6%ac%e0%a7%87-%e0%a6%ac%e0%a7%81%e0%a6%9d%e0%a6%ac%e0%a7%87%e0%a6%a8-%e0%a6%86%e0%a6%aa%e0%a6%a8%e0%a6%be%e0%a6%b0/">জুমবাংলা</source>
    </item>

    <item>
      <title>চুয়েটে আবারও কমপ্লিট শাটডাউন ঘোষণা</title>
      <link>https://zoombangla.com/%e0%a6%9a%e0%a7%81%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%9f%e0%a7%87-%e0%a6%86%e0%a6%ac%e0%a6%be%e0%a6%b0%e0%a6%93-%e0%a6%95%e0%a6%ae%e0%a6%aa%e0%a7%8d%e0%a6%b2%e0%a6%bf%e0%a6%9f/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%9a%e0%a7%81%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%9f%e0%a7%87-%e0%a6%86%e0%a6%ac%e0%a6%be%e0%a6%b0%e0%a6%93-%e0%a6%95%e0%a6%ae%e0%a6%aa%e0%a7%8d%e0%a6%b2%e0%a6%bf%e0%a6%9f/</guid>
      <pubDate>Thu, 26 Nov 2026 10:16:22 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/456-2.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/456-2.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/456-2.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চুয়েটে আবারও কমপ্লিট শাটডাউন ঘোষণা" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রাম প্রকৌশল ও প্রযুক্তি বিশ্ববিদ্যালয়ে (চুয়েট) চলমান সংকটের স্থায়ী সমাধান না হওয়ায় আবারও ‘কমপ্লিট শাটডাউন’ কর্মসূচি ঘোষণা করেছেন শিক্ষার্থীরা। বৃহস্পতিবার (২৬ নভেম্বর) থেকে এ কর্মসূচি শুরু হচ্ছে। সংকটের সমাধান না হওয়া পর্যন্ত বিশ্ববিদ্যালয়ের সব ব্যাচের একাডেমিক ও প্রশাসনিক কার্যক্রম বন্ধ রাখার&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%9a%e0%a7%81%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%9f%e0%a7%87-%e0%a6%86%e0%a6%ac%e0%a6%be%e0%a6%b0%e0%a6%93-%e0%a6%95%e0%a6%ae%e0%a6%aa%e0%a7%8d%e0%a6%b2%e0%a6%bf%e0%a6%9f/">জুমবাংলা</source>
    </item>
    <item>
      <title>ফ্যাসিবাদী শক্তি আর কখনও ফিরবে না: স্বরাষ্ট্রমন্ত্রী</title>
      <link>https://zoombangla.com/%e0%a6%ab%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%ac%e0%a6%be%e0%a6%a6%e0%a7%80-%e0%a6%b6%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%bf-%e0%a6%86%e0%a6%b0/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%ab%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%ac%e0%a6%be%e0%a6%a6%e0%a7%80-%e0%a6%b6%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%bf-%e0%a6%86%e0%a6%b0/</guid>
      <pubDate>Thu, 26 Nov 2026 10:10:49 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/salauddin-1.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/salauddin-1.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/salauddin-1.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফ্যাসিবাদী শক্তি আর কখনও ফিরবে না: স্বরাষ্ট্রমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;স্বরাষ্ট্রমন্ত্রী ও বিএনপির স্থায়ী কমিটির সদস্য সালাহউদ্দিন আহমদ বলেছেন, এ দেশে আর কখনও ফ্যাসিবাদী শক্তির পুনরুত্থান এবং প্রত্যাবর্তন হবে না। এই প্রতিজ্ঞা আমাদের আছে, এ দেশের জনগণের আছে। বৃহস্পতিবার (২৬ নভেম্বর) নয়াপল্টনে বিএনপির দলীয় কার্যালয়ে তিনি এ কথা বলেন। সালাউদ্দিন আহমদ বলেন, বারবার যখন স&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ab%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%ac%e0%a6%be%e0%a6%a6%e0%a7%80-%e0%a6%b6%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%bf-%e0%a6%86%e0%a6%b0/">জুমবাংলা</source>
    </item>
    <item>
      <title>শিমুলতলীতে কুটির শিল্প মেলায় সাংস্কৃতিক অনুষ্ঠানে ন্যাক্কারজনক হামলা ও ভাঙচুর</title>
      <link>https://zoombangla.com/%e0%a6%b6%e0%a6%bf%e0%a6%ae%e0%a7%81%e0%a6%b2%e0%a6%a4%e0%a6%b2%e0%a7%80%e0%a6%a4%e0%a7%87-%e0%a6%95%e0%a7%81%e0%a6%9f%e0%a6%bf%e0%a6%b0-%e0%a6%b6%e0%a6%bf%e0%a6%b2%e0%a7%8d%e0%a6%aa/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%b6%e0%a6%bf%e0%a6%ae%e0%a7%81%e0%a6%b2%e0%a6%a4%e0%a6%b2%e0%a7%80%e0%a6%a4%e0%a7%87-%e0%a6%95%e0%a7%81%e0%a6%9f%e0%a6%bf%e0%a6%b0-%e0%a6%b6%e0%a6%bf%e0%a6%b2%e0%a7%8d%e0%a6%aa/</guid>
      <pubDate>Thu, 26 Nov 2026 10:04:34 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Gazipur-1.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Gazipur-1.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Gazipur-1.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শিমুলতলীতে কুটির শিল্প মেলায় সাংস্কৃতিক অনুষ্ঠানে ন্যাক্কারজনক হামলা ও ভাঙচুর" /&gt;&lt;/p&gt;&lt;p&gt;শিল্প ও সংস্কৃতির মিলনমেলা হিসেবে পরিচিত একটি জনসমাগমস্থলে হঠাৎ নেমে এল অন্ধকারের কালো ছায়া। গাজীপুরের শিমুলতলী এলাকার ‘আর্মি ফার্ম’ সংলগ্ন স্থানে আয়োজিত একটি কুটির শিল্প মেলা চলাকালীন মঞ্চে একদল উগ্র ধর্মান্ধ ও দুষ্কৃতকারী হামলা চালিয়েছে। ওই অনুষ্ঠানে সংগীত পরিবেশন করার কথা ছিল বিশিষ্ট লোকসংগীতশিল্&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%b6%e0%a6%bf%e0%a6%ae%e0%a7%81%e0%a6%b2%e0%a6%a4%e0%a6%b2%e0%a7%80%e0%a6%a4%e0%a7%87-%e0%a6%95%e0%a7%81%e0%a6%9f%e0%a6%bf%e0%a6%b0-%e0%a6%b6%e0%a6%bf%e0%a6%b2%e0%a7%8d%e0%a6%aa/">জুমবাংলা</source>

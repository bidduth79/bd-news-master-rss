    <item>
      <title>টিসিবির পণ্য সংরক্ষণে ‘নতুন পরিকল্পনা’</title>
      <link>https://zoombangla.com/%e0%a6%9f%e0%a6%bf%e0%a6%b8%e0%a6%bf%e0%a6%ac%e0%a6%bf%e0%a6%b0-%e0%a6%aa%e0%a6%a3%e0%a7%8d%e0%a6%af-%e0%a6%b8%e0%a6%82%e0%a6%b0%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%a3%e0%a7%87/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%9f%e0%a6%bf%e0%a6%b8%e0%a6%bf%e0%a6%ac%e0%a6%bf%e0%a6%b0-%e0%a6%aa%e0%a6%a3%e0%a7%8d%e0%a6%af-%e0%a6%b8%e0%a6%82%e0%a6%b0%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%a3%e0%a7%87/</guid>
      <pubDate>Mon, 23 Nov 2026 05:54:03 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/tcb-1.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/tcb-1.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/tcb-1.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টিসিবির পণ্য সংরক্ষণে ‘নতুন পরিকল্পনা’" /&gt;&lt;/p&gt;&lt;p&gt;নিত্যপ্রয়োজনীয় পণ্যের মজুত সক্ষমতা বাড়ানো, সরবরাহ ব্যবস্থাপনা শক্তিশালী করা এবং ভোক্তাদের কাছে পণ্যের নিরবচ্ছিন্ন সরবরাহ নিশ্চিত করতে গুদামজাতকরণ সক্ষমতা বাড়ানোর উদ্যোগ নিয়েছে ট্রেডিং করপোরেশন অব বাংলাদেশ (টিসিবি)। আগামী এক থেকে দেড় বছরের মধ্যে সংস্থাটির নিজস্ব পণ্য সংরক্ষণ সক্ষমতা এক লাখ মেট্রিক টন&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%9f%e0%a6%bf%e0%a6%b8%e0%a6%bf%e0%a6%ac%e0%a6%bf%e0%a6%b0-%e0%a6%aa%e0%a6%a3%e0%a7%8d%e0%a6%af-%e0%a6%b8%e0%a6%82%e0%a6%b0%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%a3%e0%a7%87/">জুমবাংলা</source>
    </item>
    <item>
      <title>সুইডেন আসলামকে নিয়ে যে তথ্য দিল গোয়েন্দা বিভাগ</title>
      <link>https://zoombangla.com/%e0%a6%b8%e0%a7%81%e0%a6%87%e0%a6%a1%e0%a7%87%e0%a6%a8-%e0%a6%86%e0%a6%b8%e0%a6%b2%e0%a6%be%e0%a6%ae%e0%a6%95%e0%a7%87-%e0%a6%a8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%af%e0%a7%87/</link>

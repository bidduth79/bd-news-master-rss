      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/humayon-kabir.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/humayon-kabir.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/humayon-kabir.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আওয়ামী লীগ এখন সন্ত্রাসী লীগ : পররাষ্ট্র প্রতিমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;কার্যক্রম নিষিদ্ধ আওয়ামী লীগ এখন একটি সন্ত্রাসী দলে পরিণত হয়েছে বলে মন্তব্য করেছেন পররাষ্ট্র প্রতিমন্ত্রী হুমায়ুন কবির। শুক্রবার (২০ নভেম্বর) সিলেটের হযরত শাহজালালের (রহ.) দরগাহ মসজিদ প্রাঙ্গণে প্রধানমন্ত্রী ও বিএনপির চেয়ারম্যান তারেক রহমানের ৬২তম জন্মদিন উপলক্ষে সিলেট জেলা বিএনপির দোয়া মাহফিলে তিনি&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%86%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%ae%e0%a7%80-%e0%a6%b2%e0%a7%80%e0%a6%97-%e0%a6%8f%e0%a6%96%e0%a6%a8/">জুমবাংলা</source>
    </item>

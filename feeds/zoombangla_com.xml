    <item>
      <title>ঢাকা-চট্টগ্রাম মহাসড়কে ১৩ কিলোমিটার যানজট</title>
      <link>https://zoombangla.com/%e0%a6%a2%e0%a6%be%e0%a6%95%e0%a6%be-%e0%a6%9a%e0%a6%9f%e0%a7%8d%e0%a6%9f%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ae-%e0%a6%ae%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%a1%e0%a6%bc%e0%a6%95%e0%a7%87-3/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%a2%e0%a6%be%e0%a6%95%e0%a6%be-%e0%a6%9a%e0%a6%9f%e0%a7%8d%e0%a6%9f%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ae-%e0%a6%ae%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%a1%e0%a6%bc%e0%a6%95%e0%a7%87-3/</guid>
      <pubDate>Fri, 13 Nov 2026 05:41:52 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/c7cb236a1416148c136de9cf8b57a234-6af69e4687a79.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/c7cb236a1416148c136de9cf8b57a234-6af69e4687a79.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/c7cb236a1416148c136de9cf8b57a234-6af69e4687a79.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঢাকা-চট্টগ্রাম মহাসড়কে ১৩ কিলোমিটার যানজট" /&gt;&lt;/p&gt;&lt;p&gt;ঢাকা-চট্টগ্রাম মহাসড়কের মুন্সীগঞ্জের গজারিয়া অংশে কুমিল্লাগামী লেনে দীর্ঘ যানজটের সৃষ্টি হয়েছে। প্রায় ১৩ কিলোমিটার এলাকাজুড়ে যানবাহনের দীর্ঘ সারি তৈরি হওয়ায় বিপাকে পড়েছেন দূরপাল্লার বাস ও ট্রাকের চালকসহ সাধারণ যাত্রীরা। শুক্রবার (১৩ নভেম্বর) সকাল সাড়ে ৭টার দিকে দাউদকান্দি এলাকায় মেঘনা-গোমতী সেতুর ঢা&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%a2%e0%a6%be%e0%a6%95%e0%a6%be-%e0%a6%9a%e0%a6%9f%e0%a7%8d%e0%a6%9f%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ae-%e0%a6%ae%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%a1%e0%a6%bc%e0%a6%95%e0%a7%87-3/">জুমবাংলা</source>
    </item>
    <item>
      <title>বিশ্বকাপের ড্রয়ের নতুন নিয়ম আনল ফিফা</title>
      <link>https://zoombangla.com/%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%ac%e0%a6%95%e0%a6%be%e0%a6%aa%e0%a7%87%e0%a6%b0-%e0%a6%a1%e0%a7%8d%e0%a6%b0%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%ac%e0%a6%95%e0%a6%be%e0%a6%aa%e0%a7%87%e0%a6%b0-%e0%a6%a1%e0%a7%8d%e0%a6%b0%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8/</guid>
      <pubDate>Fri, 13 Nov 2026 05:19:43 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/fifa-world-cup-6af5bb74e7c3c-1.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/fifa-world-cup-6af5bb74e7c3c-1.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/fifa-world-cup-6af5bb74e7c3c-1.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিশ্বকাপের ড্রয়ের নতুন নিয়ম আনল ফিফা" /&gt;&lt;/p&gt;&lt;p&gt;২০২৭ নারী বিশ্বকাপ ফুটবলের গ্রুপ পর্বের ড্রয়ের ঠিক এক মাস আগে ফিফা এই ইভেন্টের নিয়মাবলি ও পদ্ধতি প্রকাশ করেছে। রিও ডি জেনেইরোর আধুনিক শিল্প জাদুঘরে এই ড্র অনুষ্ঠিত হবে। আগামী ১১ ডিসেম্বর বিশ্বকাপের ড্র হওয়ার কথা রয়েছে। আগামী বছরে অনুষ্ঠেয় বিশ্বকাপে অংশগ্রহণকারী ৩২টি দল—যাদের মধ্যে এখন পর্যন্ত ১৮টি দ&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%ac%e0%a6%95%e0%a6%be%e0%a6%aa%e0%a7%87%e0%a6%b0-%e0%a6%a1%e0%a7%8d%e0%a6%b0%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8/">জুমবাংলা</source>
    </item>
    <item>
      <title>১৩ বিশ্ববিদ্যালয়ের ভর্তি পরীক্ষার তারিখ চূড়ান্ত</title>
      <link>https://zoombangla.com/%e0%a7%a7%e0%a7%a9-%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%ac%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%b2%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%b0-%e0%a6%ad%e0%a6%b0%e0%a7%8d%e0%a6%a4/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a7%a7%e0%a7%a9-%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%ac%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%b2%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%b0-%e0%a6%ad%e0%a6%b0%e0%a7%8d%e0%a6%a4/</guid>
      <pubDate>Fri, 13 Nov 2026 04:59:55 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/1794468779-d1b604eb840ac6fb86d76dafcbaac05c.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/1794468779-d1b604eb840ac6fb86d76dafcbaac05c.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/1794468779-d1b604eb840ac6fb86d76dafcbaac05c.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="১৩ বিশ্ববিদ্যালয়ের ভর্তি পরীক্ষার তারিখ চূড়ান্ত" /&gt;&lt;/p&gt;&lt;p&gt;উচ্চ মাধ্যমিক (এইচএসসি) ও সমমানের সম্পূরক পরীক্ষায় অংশ নেওয়া শিক্ষার্থীদের সুযোগ দিতে দেশের পাবলিক বিশ্ববিদ্যালয়গুলোকে আবেদন ১ জানুয়ারি ও পরীক্ষা ১ ফেব্রুয়ারির পর নেওয়ার অনুরোধ জানিয়েছিল বিশ্ববিদ্যালয় মঞ্জুরি কমিশন (ইউজিসি)। তবে ইউজিসির সেই আহ্বান ও সুপারিশ সত্ত্বেও ঢাকা বিশ্ববিদ্যালয়সহ বেশ কিছু প্র&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a7%a7%e0%a7%a9-%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%ac%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%b2%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%b0-%e0%a6%ad%e0%a6%b0%e0%a7%8d%e0%a6%a4/">জুমবাংলা</source>
    </item>
    <item>
      <title>মোদিকে প্রশ্ন করা সেই নারী সাংবাদিকের ভিসা বাতিল</title>
      <link>https://zoombangla.com/%e0%a6%ae%e0%a7%8b%e0%a6%a6%e0%a6%bf%e0%a6%95%e0%a7%87-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%b6%e0%a7%8d%e0%a6%a8-%e0%a6%95%e0%a6%b0%e0%a6%be-%e0%a6%b8%e0%a7%87%e0%a6%87-%e0%a6%a8%e0%a6%be%e0%a6%b0/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%ae%e0%a7%8b%e0%a6%a6%e0%a6%bf%e0%a6%95%e0%a7%87-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%b6%e0%a7%8d%e0%a6%a8-%e0%a6%95%e0%a6%b0%e0%a6%be-%e0%a6%b8%e0%a7%87%e0%a6%87-%e0%a6%a8%e0%a6%be%e0%a6%b0/</guid>
      <pubDate>Fri, 13 Nov 2026 04:35:12 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/2ccbf6f87e5de69a16b05d14b4abeaf9-6af6211e1e529.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/2ccbf6f87e5de69a16b05d14b4abeaf9-6af6211e1e529.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/2ccbf6f87e5de69a16b05d14b4abeaf9-6af6211e1e529.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মোদিকে প্রশ্ন করা সেই নারী সাংবাদিকের ভিসা বাতিল" /&gt;&lt;/p&gt;&lt;p&gt;২০২৬ সালের মে মাসে নরওয়ের অসলো সফরে ভারতের প্রধানমন্ত্রী নরেন্দ্র মোদিকে প্রশ্ন করে আলোচনায় আসা নরওয়েজিয়ান সাংবাদিক হেলে লিংকে ভারতে প্রবেশের অনুমতি দেওয়া হয়নি। বৈধ ভিসা থাকা সত্ত্বেও হায়দরাবাদের উদ্দেশে রওনা হওয়ার মাত্র কয়েক ঘণ্টা আগে তার ভিসা বাতিল করা হয়েছে বলে অভিযোগ করেছেন তিনি। তেলেঙ্গানা সরকা&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ae%e0%a7%8b%e0%a6%a6%e0%a6%bf%e0%a6%95%e0%a7%87-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%b6%e0%a7%8d%e0%a6%a8-%e0%a6%95%e0%a6%b0%e0%a6%be-%e0%a6%b8%e0%a7%87%e0%a6%87-%e0%a6%a8%e0%a6%be%e0%a6%b0/">জুমবাংলা</source>
    </item>
    <item>
      <title>হাসিনার পাসপোর্ট-এনআইডি আবেদনের আগেই স্থগিত হয় বাংলাদেশ-ভারত সংলাপ</title>
      <link>https://zoombangla.com/%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%a8%e0%a6%be%e0%a6%b0-%e0%a6%aa%e0%a6%be%e0%a6%b8%e0%a6%aa%e0%a7%8b%e0%a6%b0%e0%a7%8d%e0%a6%9f-%e0%a6%8f%e0%a6%a8%e0%a6%86%e0%a6%87%e0%a6%a1%e0%a6%bf/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%a8%e0%a6%be%e0%a6%b0-%e0%a6%aa%e0%a6%be%e0%a6%b8%e0%a6%aa%e0%a7%8b%e0%a6%b0%e0%a7%8d%e0%a6%9f-%e0%a6%8f%e0%a6%a8%e0%a6%86%e0%a6%87%e0%a6%a1%e0%a6%bf/</guid>
      <pubDate>Fri, 13 Nov 2026 02:56:00 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/hasinajpg-3-20261109133822.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/hasinajpg-3-20261109133822.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/hasinajpg-3-20261109133822.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হাসিনার পাসপোর্ট-এনআইডি আবেদনের আগেই স্থগিত হয় বাংলাদেশ-ভারত সংলাপ" /&gt;&lt;/p&gt;&lt;p&gt;শেখ হাসিনার পাসপোর্ট ও জাতীয় পরিচয়পত্রের (এনআইডি) আবেদনকে কেন্দ্র করে বাংলাদেশ ও ভারতের মধ্যকার পঞ্চম দফার কনস্যুলার সংলাপ স্থগিত হয়নি বলে জানিয়েছেন দিল্লিতে বাংলাদেশ হাইকমিশনের প্রেস মিনিস্টার সাইদুর রহমান। তাঁর দাবি, শেখ হাসিনার পক্ষে পাসপোর্ট ও এনআইডির আবেদন করার অন্তত চার দিন আগেই সংলাপ স্থগিতের&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%a8%e0%a6%be%e0%a6%b0-%e0%a6%aa%e0%a6%be%e0%a6%b8%e0%a6%aa%e0%a7%8b%e0%a6%b0%e0%a7%8d%e0%a6%9f-%e0%a6%8f%e0%a6%a8%e0%a6%86%e0%a6%87%e0%a6%a1%e0%a6%bf/">জুমবাংলা</source>
    </item>
    <item>
      <title>আলিম সাপ্লিমেন্টারি পরীক্ষার কেন্দ্র তালিকা প্রকাশ</title>
      <link>https://zoombangla.com/%e0%a6%86%e0%a6%b2%e0%a6%bf%e0%a6%ae-%e0%a6%b8%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%b2%e0%a6%bf%e0%a6%ae%e0%a7%87%e0%a6%a8%e0%a7%8d%e0%a6%9f%e0%a6%be%e0%a6%b0%e0%a6%bf-%e0%a6%aa%e0%a6%b0%e0%a7%80%e0%a6%95/</link>

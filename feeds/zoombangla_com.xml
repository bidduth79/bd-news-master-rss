      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/EC-3.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চূড়ান্ত ভোটার তালিকা প্রকাশ" /&gt;&lt;/p&gt;&lt;p&gt;ইউনিয়ন পরিষদ নির্বাচনকে সামনে রেখে বুধবার (২৫ নভেম্বর) চূড়ান্ত ভোটার তালিকা প্রকাশ করেছে নির্বাচন কমিশন (ইসি)। জানা গেছে, স্থানীয় সরকার নির্বাচনের চূড়ান্ত ভোটার তালিকা করা হয়েছে, এতে ৩১ অক্টোবর ২০২৬ পর্যন্ত যাদের বয়স ১৮ বছর পূর্ণ হয়েছে, তাদের নাম অন্তর্ভুক্ত করা হয়। সর্বশেষ ভোটার তালিকা অনুযায়ী, দেশ&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%9a%e0%a7%82%e0%a6%a1%e0%a6%bc%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a4-%e0%a6%ad%e0%a7%8b%e0%a6%9f%e0%a6%be%e0%a6%b0-%e0%a6%a4%e0%a6%be%e0%a6%b2%e0%a6%bf%e0%a6%95%e0%a6%be-%e0%a6%aa%e0%a7%8d-4/">জুমবাংলা</source>
    </item>
    <item>
      <title>মাতৃত্ব ও সমাজকর্মী থেকে বিশ্বসুন্দরী—কে এই জেনিফার</title>
      <link>https://zoombangla.com/%e0%a6%ae%e0%a6%be%e0%a6%a4%e0%a7%83%e0%a6%a4%e0%a7%8d%e0%a6%ac-%e0%a6%93-%e0%a6%b8%e0%a6%ae%e0%a6%be%e0%a6%9c%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a7%80/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%ae%e0%a6%be%e0%a6%a4%e0%a7%83%e0%a6%a4%e0%a7%8d%e0%a6%ac-%e0%a6%93-%e0%a6%b8%e0%a6%ae%e0%a6%be%e0%a6%9c%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a7%80/</guid>
      <pubDate>Wed, 25 Nov 2026 10:38:22 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Nayika-9.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Nayika-9.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Nayika-9.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মাতৃত্ব ও সমাজকর্মী থেকে বিশ্বসুন্দরী—কে এই জেনিফার" /&gt;&lt;/p&gt;&lt;p&gt;সৌন্দর্যের মঞ্চে মাথায় উঠেছে বিশ্বসেরার মুকুট। তবে ২৭ বছর বয়সী জেনিফার বারেতোর পরিচয় কেবল একজন সুন্দরী প্রতিযোগিতার বিজয়ী হিসেবে নয়। তিনি একজন স্ত্রী, সাত বছর বয়সী কন্যাসন্তানের মা, উচ্চশিক্ষিত পেশাজীবী ও সমাজকর্মী। পুয়ের্তো রিকোর এই নারী মিস ইউনিভার্সের ৭৫তম আসরে সেরার মুকুট জিতে গড়েছেন ইতিহাস। প্র&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ae%e0%a6%be%e0%a6%a4%e0%a7%83%e0%a6%a4%e0%a7%8d%e0%a6%ac-%e0%a6%93-%e0%a6%b8%e0%a6%ae%e0%a6%be%e0%a6%9c%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a7%80/">জুমবাংলা</source>
    </item>
    <item>
      <title>৩৬ বছরের রেকর্ড ভেঙে মার্কিন প্রতিনিধি পরিষদে ডেমোক্র্যাটদের জয়</title>
      <link>https://zoombangla.com/%e0%a7%a9%e0%a7%ac-%e0%a6%ac%e0%a6%9b%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%b0%e0%a7%87%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%a1-%e0%a6%ad%e0%a7%87%e0%a6%99%e0%a7%87/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a7%a9%e0%a7%ac-%e0%a6%ac%e0%a6%9b%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%b0%e0%a7%87%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%a1-%e0%a6%ad%e0%a7%87%e0%a6%99%e0%a7%87/</guid>
      <pubDate>Wed, 25 Nov 2026 10:38:13 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/us-2.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/us-2.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/us-2.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৩৬ বছরের রেকর্ড ভেঙে মার্কিন প্রতিনিধি পরিষদে ডেমোক্র্যাটদের জয়" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাষ্ট্রের প্রতিনিধি পরিষদে অন্তত ২৫৯টি আসন জিতে ৩৬ বছরের মধ্যে সবচেয়ে বড় সংখ্যাগরিষ্ঠতা অর্জন করেছে ডেমোক্র্যাটিক পার্টি। ১৯৯০ সালের পর কোনো সাধারণ নির্বাচনে দলটির এমন জয় দেখা যায়নি। বুধবার (২৫ নভেম্বর) বার্তা সংস্থা এপি জানায়, মঙ্গলবার (২৪ নভেম্বর) টেনেসিতে ডেমোক্র্যাট প্রার্থী ভিক্টোরিয়া ব্রড&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a7%a9%e0%a7%ac-%e0%a6%ac%e0%a6%9b%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%b0%e0%a7%87%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%a1-%e0%a6%ad%e0%a7%87%e0%a6%99%e0%a7%87/">জুমবাংলা</source>
    </item>
    <item>
      <title>শিশুর শরীরে ভিটামিনের ঘাটতি কীভাবে বুঝবেন</title>
      <link>https://zoombangla.com/%e0%a6%b6%e0%a6%bf%e0%a6%b6%e0%a7%81%e0%a6%b0-%e0%a6%b6%e0%a6%b0%e0%a7%80%e0%a6%b0%e0%a7%87-%e0%a6%ad%e0%a6%bf%e0%a6%9f%e0%a6%be%e0%a6%ae%e0%a6%bf%e0%a6%a8%e0%a7%87%e0%a6%b0/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%b6%e0%a6%bf%e0%a6%b6%e0%a7%81%e0%a6%b0-%e0%a6%b6%e0%a6%b0%e0%a7%80%e0%a6%b0%e0%a7%87-%e0%a6%ad%e0%a6%bf%e0%a6%9f%e0%a6%be%e0%a6%ae%e0%a6%bf%e0%a6%a8%e0%a7%87%e0%a6%b0/</guid>
      <pubDate>Wed, 25 Nov 2026 10:36:00 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/kids-vitamin.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/kids-vitamin.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/kids-vitamin.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শিশুর শরীরে ভিটামিনের ঘাটতি কীভাবে বুঝবেন" /&gt;&lt;/p&gt;&lt;p&gt;আপনার শিশুসন্তানের শরীরে ভিটামিনের ঘাটতি হলে সাধারণত অতিরিক্ত ক্লান্তি, খিটখিটে মেজাজ, ওজন বা উচ্চতা কম বাড়া এবং ঘন ঘন অসুস্থ হওয়ার মতো লক্ষণ দেখা দেয়। কোন ভিটামিনের ঘাটতি হয়েছে, তার ওপর ভিত্তি করে উপসর্গগুলো ভিন্ন হতে পারে। খাওয়া নিয়ে অনেক শিশুরই বায়না আছে। তারা ঠিকমতো খাবার খেতে চায় না। আবার সঠিক &lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%b6%e0%a6%bf%e0%a6%b6%e0%a7%81%e0%a6%b0-%e0%a6%b6%e0%a6%b0%e0%a7%80%e0%a6%b0%e0%a7%87-%e0%a6%ad%e0%a6%bf%e0%a6%9f%e0%a6%be%e0%a6%ae%e0%a6%bf%e0%a6%a8%e0%a7%87%e0%a6%b0/">জুমবাংলা</source>

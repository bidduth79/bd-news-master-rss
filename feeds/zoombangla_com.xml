    <item>
      <title>যুক্তরাষ্ট্রের শিকাগোতে খালেদা জিয়ার নামে সড়কের নামকরণ</title>
      <link>https://zoombangla.com/%e0%a6%af%e0%a7%81%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%b0%e0%a6%be%e0%a6%b7%e0%a7%8d%e0%a6%9f%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%b0/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%af%e0%a7%81%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%b0%e0%a6%be%e0%a6%b7%e0%a7%8d%e0%a6%9f%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%b0/</guid>
      <pubDate>Mon, 23 Nov 2026 05:05:00 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%B8%E0%A6%A1%E0%A6%BC%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A6%95%E0%A6%B0%E0%A6%A3-1.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%B8%E0%A6%A1%E0%A6%BC%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A6%95%E0%A6%B0%E0%A6%A3-1.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%B8%E0%A6%A1%E0%A6%BC%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A6%95%E0%A6%B0%E0%A6%A3-1.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যুক্তরাষ্ট্রের শিকাগোতে খালেদা জিয়ার নামে সড়কের নামকরণ" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাষ্ট্রের ইলিনয় অঙ্গরাজ্যের শিকাগো শহরে বাংলাদেশের প্রয়াত সাবেক প্রধানমন্ত্রী খালেদা জিয়ার নামে একটি সড়কের নামকরণ করা হয়েছে। শহরের উইলিস টাওয়ারের কাছে আপার ওয়াকার ড্রাইভের একটি অংশের নতুন নাম রাখা হয়েছে ‘মাদার অব ডেমোক্রেসি বেগম খালেদা জিয়া ওয়ে’। স্থানীয় সময় রোববার (২২ নভেম্বর) দুপুরে এক অনুষ্ঠ&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%af%e0%a7%81%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%b0%e0%a6%be%e0%a6%b7%e0%a7%8d%e0%a6%9f%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%b0/">জুমবাংলা</source>
    </item>

      <pubDate>Sat, 28 Nov 2026 18:00:27 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AE%E0%A7%87%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%A4%E0%A7%87-%E0%A6%8F%E0%A6%B2%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%A3%E0%A7%8D%E0%A6%A1-%E0%A6%8F%E0%A6%95-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%B0.gif" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AE%E0%A7%87%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%A4%E0%A7%87-%E0%A6%8F%E0%A6%B2%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%A3%E0%A7%8D%E0%A6%A1-%E0%A6%8F%E0%A6%95-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%B0.gif" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AE%E0%A7%87%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%A4%E0%A7%87-%E0%A6%8F%E0%A6%B2%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%A3%E0%A7%8D%E0%A6%A1-%E0%A6%8F%E0%A6%95-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%B0.gif" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মেয়ের বিয়েতে ৪ লাখ অতিথি আপ্যায়নের এলাহিকাণ্ড এক রাজনীতিকের" /&gt;&lt;/p&gt;&lt;p&gt;ভারতের সবচেয়ে দরিদ্র রাজ্য বিহারে মেয়ের বিয়েতে প্রায় ৪ লাখ অতিথির আপ্যায়নের আয়োজন করেছেন এক রাজনীতিক। বিয়ের অনুষ্ঠানের জন্য তৈরি করা হয়েছে ছয়টি অস্থায়ী হেলিপ্যাড। আর অতিথিদের ভোজের আয়োজন করতে নিয়োগ দেওয়া হয়েছে ৫০০ রাঁধুনি। খাওয়ানো হয়েছে লাখ লাখ ঐতিহ্যবাহী মিষ্টি। গত বুধবার বিহারের বিধায়ক অনন্ত সিং ত&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ae%e0%a7%87%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%a4%e0%a7%87-%e0%a7%aa-%e0%a6%b2%e0%a6%be%e0%a6%96/">জুমবাংলা</source>
    </item>
    <item>
      <title>কৃষক কার্ড: ৫ লাখ কৃষকের মধ্যে বিতরণ হবে ১০২ কোটি টাকা</title>
      <link>https://zoombangla.com/%e0%a6%95%e0%a7%83%e0%a6%b7%e0%a6%95-%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%a1-%e0%a7%ab-%e0%a6%b2%e0%a6%be%e0%a6%96-%e0%a6%95%e0%a7%83%e0%a6%b7%e0%a6%95%e0%a7%87%e0%a6%b0/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%95%e0%a7%83%e0%a6%b7%e0%a6%95-%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%a1-%e0%a7%ab-%e0%a6%b2%e0%a6%be%e0%a6%96-%e0%a6%95%e0%a7%83%e0%a6%b7%e0%a6%95%e0%a7%87%e0%a6%b0/</guid>
      <pubDate>Sat, 28 Nov 2026 17:49:44 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%95%E0%A7%83%E0%A6%B7%E0%A6%95-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A1-%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A6%B0%E0%A6%A3.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%95%E0%A7%83%E0%A6%B7%E0%A6%95-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A1-%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A6%B0%E0%A6%A3.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%95%E0%A7%83%E0%A6%B7%E0%A6%95-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A1-%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A6%B0%E0%A6%A3.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কৃষক কার্ড: ৫ লাখ কৃষকের মধ্যে বিতরণ হবে ১০২ কোটি টাকা" /&gt;&lt;/p&gt;&lt;p&gt;কৃষকের আর্থিক সুরক্ষা, উৎপাদন সক্ষমতা বৃদ্ধি ও কৃষিতে সামাজিক নিরাপত্তা জোরদারে নতুন দিগন্ত খুলেছে কৃষক কার্ড কর্মসূচি। এ কর্মসূচির আওতায় আগামী ২ ডিসেম্বর কুষ্টিয়া এবং ৫ ডিসেম্বর গাইবান্ধায় কৃষি উপকরণ সহায়তা পাবেন প্রায় ৫ লাখ কৃষক। ইতোমধ্যে ৪ লাখ ৪৩ হাজার ৪৮৪ জন কৃষকের তথ্য হালনাগাদ হয়েছে। বাকী ৫৬ হ&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%95%e0%a7%83%e0%a6%b7%e0%a6%95-%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%a1-%e0%a7%ab-%e0%a6%b2%e0%a6%be%e0%a6%96-%e0%a6%95%e0%a7%83%e0%a6%b7%e0%a6%95%e0%a7%87%e0%a6%b0/">জুমবাংলা</source>
    </item>
    <item>
      <title>৯ বছরের যাত্রা শেষ ব্যাচেলর পয়েন্টের, ‘কিছু সংলাপ, কিছু স্মৃতি আজীবন হৃদয়ে থেকে যাবে’: পলাশ</title>
      <link>https://zoombangla.com/%e0%a7%af-%e0%a6%ac%e0%a6%9b%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%af%e0%a6%be%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a6%be-%e0%a6%b6%e0%a7%87%e0%a6%b7/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a7%af-%e0%a6%ac%e0%a6%9b%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%af%e0%a6%be%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a6%be-%e0%a6%b6%e0%a7%87%e0%a6%b7/</guid>
      <pubDate>Sat, 28 Nov 2026 17:44:35 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A7%AF-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE-%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%87%E0%A6%B2%E0%A6%B0-%E0%A6%AA%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B0.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A7%AF-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE-%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%87%E0%A6%B2%E0%A6%B0-%E0%A6%AA%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B0.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A7%AF-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE-%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%87%E0%A6%B2%E0%A6%B0-%E0%A6%AA%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B0.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৯ বছরের যাত্রা শেষ ব্যাচেলর পয়েন্টের, ‘কিছু সংলাপ, কিছু স্মৃতি আজীবন হৃদয়ে থেকে যাবে’: পলাশ" /&gt;&lt;/p&gt;&lt;p&gt;দীর্ঘ নয় বছরের যাত্রার ইতি টেনেছে জনপ্রিয় সিরিয়াল ‘ব্যাচেলর পয়েন্ট’ (সিজন ৫)। শুক্রবার রাতে প্রচারিত শেষ পর্বের মধ্য দিয়ে শেষ হয়েছে দর্শকপ্রিয় এই সিরিয়ালের পথচলা। সিরিজটির কাবিলা চরিত্রে অভিনয় করে তুমুল জনপ্রিয়তা পাওয়া জিয়াউল হক পলাশকে ঘিরে শেষ পর্বেও ছিল দর্শকদের বাড়তি আগ্রহ। ‘ব্যাচেলর পয়েন্টে’ বন্&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a7%af-%e0%a6%ac%e0%a6%9b%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%af%e0%a6%be%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a6%be-%e0%a6%b6%e0%a7%87%e0%a6%b7/">জুমবাংলা</source>
    </item>
    <item>
      <title>নিষিদ্ধ ছাত্রলীগ নেতা সাদ্দাম গ্রেফতার</title>
      <link>https://zoombangla.com/%e0%a6%a8%e0%a6%bf%e0%a6%b7%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%a7-%e0%a6%9b%e0%a6%be%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a6%b2%e0%a7%80%e0%a6%97/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%a8%e0%a6%bf%e0%a6%b7%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%a7-%e0%a6%9b%e0%a6%be%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a6%b2%e0%a7%80%e0%a6%97/</guid>
      <pubDate>Sat, 28 Nov 2026 17:44:09 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Logo-24.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Logo-24.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Logo-24.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নিষিদ্ধ ছাত্রলীগ নেতা সাদ্দাম গ্রেফতার" /&gt;&lt;/p&gt;&lt;p&gt;পটুয়াখালীর কুয়াকাটায় নিষিদ্ধ ঘোষিত সংগঠন ছাত্রলীগের সাবেক নেতা মো. সাদ্দাম সিকদারকে (৩২) গ্রেফতার করেছে মহিপুর থানা পুলিশ। শনিবার (২৮ নভেম্বর) ভোররাতে কুয়াকাটা পৌরসভার ২ নম্বর ওয়ার্ডে তার নিজ বাসা থেকে তাকে গ্রেফতার করা হয়। গ্রেফতারকৃত সাদ্দাম সিকদার কুয়াকাটা পৌরসভার ২ নম্বর ওয়ার্ড ছাত্রলীগের সাবেক &lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%a8%e0%a6%bf%e0%a6%b7%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%a7-%e0%a6%9b%e0%a6%be%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a6%b2%e0%a7%80%e0%a6%97/">জুমবাংলা</source>
    </item>

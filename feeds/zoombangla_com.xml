    <item>
      <title>শরিয়া আইনে আমির হামজার বিচার চাইলেন রাশেদ খান</title>
      <link>https://zoombangla.com/%e0%a6%b6%e0%a6%b0%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be-%e0%a6%86%e0%a6%87%e0%a6%a8%e0%a7%87-%e0%a6%86%e0%a6%ae%e0%a6%bf%e0%a6%b0-%e0%a6%b9%e0%a6%be%e0%a6%ae%e0%a6%9c%e0%a6%be%e0%a6%b0-%e0%a6%ac/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%b6%e0%a6%b0%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be-%e0%a6%86%e0%a6%87%e0%a6%a8%e0%a7%87-%e0%a6%86%e0%a6%ae%e0%a6%bf%e0%a6%b0-%e0%a6%b9%e0%a6%be%e0%a6%ae%e0%a6%9c%e0%a6%be%e0%a6%b0-%e0%a6%ac/</guid>
      <pubDate>Wed, 11 Nov 2026 02:22:34 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/বিচার.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/বিচার.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/বিচার.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শরিয়া আইনে আমির হামজার বিচার চাইলেন রাশেদ খান" /&gt;&lt;/p&gt;&lt;p&gt;জামায়াতে ইসলামীর সংসদ সদস্য আমির হামজার ভাইরাল হওয়া নারীঘটিত অডিও-ভিডিওটি সত্য বলে দাবি করে প্রধানমন্ত্রীর রাজনৈতিক সহকারী রাশেদ খান বলেছেন, জামায়াত যদি সত্যিই শরিয়া আইনে বিশ্বাস করে, তবে সেই আইন অনুযায়ী আমির হামজাকে পাথর মেরে মৃত্যুদণ্ড নিশ্চিত করা উচিত। মঙ্গলবার (১০ নভেম্বর) নিজের ভেরিফায়েড ফেসবুক&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%b6%e0%a6%b0%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be-%e0%a6%86%e0%a6%87%e0%a6%a8%e0%a7%87-%e0%a6%86%e0%a6%ae%e0%a6%bf%e0%a6%b0-%e0%a6%b9%e0%a6%be%e0%a6%ae%e0%a6%9c%e0%a6%be%e0%a6%b0-%e0%a6%ac/">জুমবাংলা</source>
    </item>
    <item>
      <title>কপ৩১-এ সুযোগ না পেয়ে ফলের ব্যবসার সিদ্ধান্ত জলবায়ু কর্মী ফাতিহার</title>
      <link>https://zoombangla.com/%e0%a6%95%e0%a6%aa%e0%a7%a9%e0%a7%a7-%e0%a6%8f-%e0%a6%b8%e0%a7%81%e0%a6%af%e0%a7%8b%e0%a6%97-%e0%a6%a8%e0%a6%be-%e0%a6%aa%e0%a7%87%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%ab%e0%a6%b2%e0%a7%87%e0%a6%b0/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%95%e0%a6%aa%e0%a7%a9%e0%a7%a7-%e0%a6%8f-%e0%a6%b8%e0%a7%81%e0%a6%af%e0%a7%8b%e0%a6%97-%e0%a6%a8%e0%a6%be-%e0%a6%aa%e0%a7%87%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%ab%e0%a6%b2%e0%a7%87%e0%a6%b0/</guid>
      <pubDate>Wed, 11 Nov 2026 02:19:01 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/dg.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/dg.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/dg.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কপ৩১-এ সুযোগ না পেয়ে ফলের ব্যবসার সিদ্ধান্ত জলবায়ু কর্মী ফাতিহার" /&gt;&lt;/p&gt;&lt;p&gt;তুরস্কের আনাতালিয়ায় শুরু হওয়া জাতিসংঘের আন্তর্জাতিক জলবায়ু সম্মেলন কপ-৩১-এ এবারও বাংলাদেশকে প্রতিনিধিত্ব করার সুযোগ পাননি জলবায়ু কর্মী ফাতিহা আয়াত। এ নিয়ে হতাশা প্রকাশের পাশাপাশি জলবায়ু সংকট মোকাবিলায় আন্তর্জাতিক সম্মেলনগুলোতে দেওয়া প্রতিশ্রুতি বাস্তবায়নের দাবি জানিয়েছেন তিনি। এমনকি আগামী মৌসুম থেকে&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%95%e0%a6%aa%e0%a7%a9%e0%a7%a7-%e0%a6%8f-%e0%a6%b8%e0%a7%81%e0%a6%af%e0%a7%8b%e0%a6%97-%e0%a6%a8%e0%a6%be-%e0%a6%aa%e0%a7%87%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%ab%e0%a6%b2%e0%a7%87%e0%a6%b0/">জুমবাংলা</source>
    </item>
    <item>
      <title>কানাডায় স্থায়ী বসবাসের নতুন সুযোগ, কারা যেতে পারবেন? আবেদন করবেন যেভাবে</title>
      <link>https://zoombangla.com/%e0%a6%95%e0%a6%be%e0%a6%a8%e0%a6%be%e0%a6%a1%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%b8%e0%a7%8d%e0%a6%a5%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a7%80-%e0%a6%ac%e0%a6%b8%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a7%87%e0%a6%b0/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%95%e0%a6%be%e0%a6%a8%e0%a6%be%e0%a6%a1%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%b8%e0%a7%8d%e0%a6%a5%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a7%80-%e0%a6%ac%e0%a6%b8%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a7%87%e0%a6%b0/</guid>
      <pubDate>Wed, 11 Nov 2026 02:16:49 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/আবেদন.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/আবেদন.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/আবেদন.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কানাডায় স্থায়ী বসবাসের নতুন সুযোগ, কারা যেতে পারবেন? আবেদন করবেন যেভাবে" /&gt;&lt;/p&gt;&lt;p&gt;কানাডায় স্থায়ীভাবে বসবাসের প্রত্যাশীদের জন্য নতুন সম্ভাবনার দ্বার খুলছে। পরীক্ষামূলক প্রকল্প থেকে স্থায়ী কর্মসূচিতে রূপ নিচ্ছে দেশটির গ্রামীণ ও ছোট শহরভিত্তিক অভিবাসন উদ্যোগ ‘রুরাল কমিউনিটি ইমিগ্রেশন প্রোগ্রাম’ (আরসিআইপি)। ২০২৭ সালের ১ জানুয়ারি থেকে নতুন এই কর্মসূচিটি কার্যকর হবে। এর মাধ্যমে গ্রামীণ&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%95%e0%a6%be%e0%a6%a8%e0%a6%be%e0%a6%a1%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%b8%e0%a7%8d%e0%a6%a5%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a7%80-%e0%a6%ac%e0%a6%b8%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a7%87%e0%a6%b0/">জুমবাংলা</source>
    </item>
    <item>
      <title>স্মার্টফোন বারবার হ্যাং বা Slow হচ্ছে? জেনে নিন প্রধান ৫ কারণ</title>
      <link>https://zoombangla.com/%e0%a6%b8%e0%a7%8d%e0%a6%ae%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%9f%e0%a6%ab%e0%a7%8b%e0%a6%a8-%e0%a6%ac%e0%a6%be%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%b0-%e0%a6%b9%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%b8%e0%a7%8d%e0%a6%ae%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%9f%e0%a6%ab%e0%a7%8b%e0%a6%a8-%e0%a6%ac%e0%a6%be%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%b0-%e0%a6%b9%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82/</guid>
      <pubDate>Tue, 10 Nov 2026 22:54:10 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/1-1-768x517-20.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/1-1-768x517-20.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/1-1-768x517-20.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="স্মার্টফোন বারবার হ্যাং বা Slow হচ্ছে? জেনে নিন প্রধান ৫ কারণ" /&gt;&lt;/p&gt;&lt;p&gt;দীর্ঘদিন ব্যবহারের পর Smartphone-এর গতি কমে যাওয়া কিংবা বারবার Hang হওয়ার সমস্যায় পড়েন অনেক ব্যবহারকারী। কোনো App চালু হতে বেশি সময় নেওয়া, Screen আটকে যাওয়া কিংবা হঠাৎ App বন্ধ হয়ে যাওয়ার মতো সমস্যা দেখা দিতে পারে। এমন পরিস্থিতিতে অনেকেই ফোন Restart করেন। এতে সাময়িকভাবে সমস্যা কমলেও ধীরগতির মূল কারণ&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%b8%e0%a7%8d%e0%a6%ae%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%9f%e0%a6%ab%e0%a7%8b%e0%a6%a8-%e0%a6%ac%e0%a6%be%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%b0-%e0%a6%b9%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82/">জুমবাংলা</source>
    </item>
    <item>
      <title>Nvidia-র আধিপত্যে চ্যালেঞ্জ, AI Chip বাজারে শক্তিশালী হচ্ছে Broadcom</title>
      <link>https://zoombangla.com/nvidia-%e0%a6%b0-%e0%a6%86%e0%a6%a7%e0%a6%bf%e0%a6%aa%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a7%87-%e0%a6%9a%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%b2%e0%a7%87%e0%a6%9e%e0%a7%8d%e0%a6%9c-ai-chip-%e0%a6%ac%e0%a6%be/</link>
      <guid isPermaLink="true">https://zoombangla.com/nvidia-%e0%a6%b0-%e0%a6%86%e0%a6%a7%e0%a6%bf%e0%a6%aa%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a7%87-%e0%a6%9a%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%b2%e0%a7%87%e0%a6%9e%e0%a7%8d%e0%a6%9c-ai-chip-%e0%a6%ac%e0%a6%be/</guid>
      <pubDate>Tue, 10 Nov 2026 22:11:57 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/1-1-768x517-19.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/1-1-768x517-19.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/1-1-768x517-19.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="Nvidia-র আধিপত্যে চ্যালেঞ্জ, AI Chip বাজারে শক্তিশালী হচ্ছে Broadcom" /&gt;&lt;/p&gt;&lt;p&gt;বিশ্বের AI Chip বাজারে Nvidia-র দীর্ঘদিনের আধিপত্যের সামনে নতুন প্রতিযোগিতা তৈরি করছে মার্কিন Semiconductor প্রতিষ্ঠান Broadcom। Generative AI-এর জন্য Nvidia-র GPU এখনো গুরুত্বপূর্ণ ভূমিকা পালন করলেও বড় প্রযুক্তি কোম্পানিগুলো নিজস্ব AI Processor তৈরিতে বিনিয়োগ বাড়াচ্ছে। এই পরিবর্তনের অন্যতম সুবিধাভো&lt;/p&gt;</description>
      <source url="https://zoombangla.com/nvidia-%e0%a6%b0-%e0%a6%86%e0%a6%a7%e0%a6%bf%e0%a6%aa%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a7%87-%e0%a6%9a%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%b2%e0%a7%87%e0%a6%9e%e0%a7%8d%e0%a6%9c-ai-chip-%e0%a6%ac%e0%a6%be/">জুমবাংলা</source>
    </item>
    <item>
      <title>Touchscreen MacBook Pro আনছে Apple, সুবিধার সঙ্গে বাড়ছে নতুন উদ্বেগ</title>

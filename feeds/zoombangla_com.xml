    <item>
      <title>বেড়ে গেল স্বর্ণের দাম, বিশ্ববাজারে ছাড়াল ৪ হাজার ডলার</title>
      <link>https://zoombangla.com/%e0%a6%b8%e0%a7%8d%e0%a6%ac%e0%a6%b0%e0%a7%8d%e0%a6%a3%e0%a7%87%e0%a6%b0-%e0%a6%a6%e0%a6%be%e0%a6%ae-2/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%b8%e0%a7%8d%e0%a6%ac%e0%a6%b0%e0%a7%8d%e0%a6%a3%e0%a7%87%e0%a6%b0-%e0%a6%a6%e0%a6%be%e0%a6%ae-2/</guid>
      <pubDate>Mon, 09 Nov 2026 18:54:32 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/স্বর্ণের-দাম.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/স্বর্ণের-দাম.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/স্বর্ণের-দাম.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বেড়ে গেল স্বর্ণের দাম, বিশ্ববাজারে ছাড়াল ৪ হাজার ডলার" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাষ্ট্রের মধ্যবর্তী নির্বাচনে ক্ষমতাসীন রিপাবলিকানদের পরাজয়, মার্কিন ডলারের দরপতন এবং জ্বালানি তেলের দাম কমার প্রভাবে আন্তর্জাতিক বাজারে আবারও ঊর্ধ্বমুখী হয়েছে স্বর্ণের দাম। গত সপ্তাহে প্রায় ৫ শতাংশ মূল্যবৃদ্ধির পর চলতি সপ্তাহের প্রথম কার্যদিবস সোমবারও পণ্যটির দাম বেড়েছে। বাজার বিশ্লেষকদের মতে,&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%b8%e0%a7%8d%e0%a6%ac%e0%a6%b0%e0%a7%8d%e0%a6%a3%e0%a7%87%e0%a6%b0-%e0%a6%a6%e0%a6%be%e0%a6%ae-2/">জুমবাংলা</source>
    </item>
    <item>
      <title>শেষ হতে যাচ্ছে ব্যাচেলর পয়েন্ট, সম্পন্ন শেষ দিনের শুটিং</title>
      <link>https://zoombangla.com/%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%9a%e0%a7%87%e0%a6%b2%e0%a6%b0-%e0%a6%aa%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%a8%e0%a7%8d%e0%a6%9f/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%9a%e0%a7%87%e0%a6%b2%e0%a6%b0-%e0%a6%aa%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%a8%e0%a7%8d%e0%a6%9f/</guid>
      <pubDate>Mon, 09 Nov 2026 18:50:00 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/ব্যাচেলর-পয়েন্ট.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/ব্যাচেলর-পয়েন্ট.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/ব্যাচেলর-পয়েন্ট.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শেষ হতে যাচ্ছে ব্যাচেলর পয়েন্ট, সম্পন্ন শেষ দিনের শুটিং" /&gt;&lt;/p&gt;&lt;p&gt;প্রায় নয় বছরের পথচলা শেষে শেষ হতে যাচ্ছে জনপ্রিয় ধারাবাহিক ‘ব্যাচেলর পয়েন্ট’। সোমবার (৯ নভেম্বর) ধারাবাহিকটির শেষ দিনের শুটিং সম্পন্ন হয়েছে। এর মধ্য দিয়ে পর্দায় ইতি ঘটতে যাচ্ছে তরুণ দর্শকদের কাছে ব্যাপক জনপ্রিয়তা পাওয়া এই সিরিয়ালের দীর্ঘ যাত্রার। সামাজিক যোগাযোগমাধ্যমে ধারাবাহিকটির নির্মাতা কাজল আরে&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%9a%e0%a7%87%e0%a6%b2%e0%a6%b0-%e0%a6%aa%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%a8%e0%a7%8d%e0%a6%9f/">জুমবাংলা</source>
    </item>
    <item>
      <title>কুমিল্লায় কার্যক্রম নিষিদ্ধ আওয়ামী লীগের ৮১ নেতাকর্মী গ্রেপ্তার</title>
      <link>https://zoombangla.com/%e0%a6%95%e0%a7%81%e0%a6%ae%e0%a6%bf%e0%a6%b2%e0%a7%8d%e0%a6%b2%e0%a6%be/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%95%e0%a7%81%e0%a6%ae%e0%a6%bf%e0%a6%b2%e0%a7%8d%e0%a6%b2%e0%a6%be/</guid>
      <pubDate>Mon, 09 Nov 2026 18:45:29 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/কুমিল্লা.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/কুমিল্লা.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/কুমিল্লা.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কুমিল্লায় কার্যক্রম নিষিদ্ধ আওয়ামী লীগের ৮১ নেতাকর্মী গ্রেপ্তার" /&gt;&lt;/p&gt;&lt;p&gt;কুমিল্লার বিভিন্ন থানায় পুলিশের সাঁড়াশি অভিযানে কার্যক্রম নিষিদ্ধ আওয়ামী লীগ ও অঙ্গ সহযোগী সংগঠনের ৮১ জন নেতাকর্মীকে গ্রেপ্তার করেছে পুলিশ। সোমবার (৯ নভেম্বর) দুপুরে কুমিল্লার অতিরিক্ত পুলিশ সুপার মো. লুৎফর রহমান এ তথ্য নিশ্চিত করেছেন। গ্রেপ্তারদের মধ্যে কুমিল্লা কোতোয়ালি মডেল থানায় ১১ জন, কুমিল্&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%95%e0%a7%81%e0%a6%ae%e0%a6%bf%e0%a6%b2%e0%a7%8d%e0%a6%b2%e0%a6%be/">জুমবাংলা</source>
    </item>
    <item>
      <title>যেসব এলাকায় মঙ্গলবার টানা ৮ ঘণ্টা থাকবে না বিদ্যুৎ</title>
      <link>https://zoombangla.com/%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a7%81%e0%a7%8e/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a7%81%e0%a7%8e/</guid>
      <pubDate>Mon, 09 Nov 2026 18:40:12 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/বিদ্যুৎ.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/বিদ্যুৎ.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/বিদ্যুৎ.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যেসব এলাকায় মঙ্গলবার টানা ৮ ঘণ্টা থাকবে না বিদ্যুৎ" /&gt;&lt;/p&gt;&lt;p&gt;গাছের ডালপালা কর্তন ও রক্ষণাবেক্ষণ কাজের জন্য নাটোরের বড়াইগ্রাম উপজেলার কয়েকটি এলাকায় মঙ্গলবার (১০ নভেম্বর) টানা ৮ ঘণ্টা বিদ্যুৎ সরবরাহ বন্ধ থাকবে। সোমবার (৯ নভেম্বর) নাটোর পল্লী বিদ্যুৎ সমিতি-২ থেকে পাঠানো এক বিজ্ঞপ্তিতে এ তথ্য জানানো হয়েছে। বিজ্ঞপ্তিতে বলা হয়, বড়াইগ্রাম-১ (বনপাড়া) উপকেন্দ্রের ৩ ন&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a7%81%e0%a7%8e/">জুমবাংলা</source>
    </item>
    <item>
      <title>আগামী জুলাইয়ে চালু হচ্ছে অন্তর্ভুক্তিমূলক তাৎক্ষণিক লেনদেন ব্যবস্থা</title>
      <link>https://zoombangla.com/%e0%a6%85%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a6%b0%e0%a7%8d%e0%a6%ad%e0%a7%81%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%bf%e0%a6%ae%e0%a7%82%e0%a6%b2%e0%a6%95-%e0%a6%a4%e0%a6%be%e0%a7%8e%e0%a6%95%e0%a7%8d%e0%a6%b7/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%85%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a6%b0%e0%a7%8d%e0%a6%ad%e0%a7%81%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%bf%e0%a6%ae%e0%a7%82%e0%a6%b2%e0%a6%95-%e0%a6%a4%e0%a6%be%e0%a7%8e%e0%a6%95%e0%a7%8d%e0%a6%b7/</guid>
      <pubDate>Mon, 09 Nov 2026 18:25:41 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/অন্তর্ভুক্তিমূলক-তাৎক্ষণিক-লেনদেন-ব্যবস্থা-1.png" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/অন্তর্ভুক্তিমূলক-তাৎক্ষণিক-লেনদেন-ব্যবস্থা-1.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/অন্তর্ভুক্তিমূলক-তাৎক্ষণিক-লেনদেন-ব্যবস্থা-1.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আগামী জুলাইয়ে চালু হচ্ছে অন্তর্ভুক্তিমূলক তাৎক্ষণিক লেনদেন ব্যবস্থা" /&gt;&lt;/p&gt;&lt;p&gt;ঢাকা, ৯ নভেম্বর, ২০২৬ (বাসস): দেশের সব ব্যাংক, মোবাইল আর্থিক সেবাদাতা প্রতিষ্ঠান এবং অন্যান্য আর্থিক প্রতিষ্ঠানকে একটি অভিন্ন ডিজিটাল প্ল্যাটফর্মে যুক্ত করতে ‘ইনক্লুসিভ ইনস্ট্যান্ট পেমেন্ট সিস্টেম’ (আইআইপিএস) চালুর উদ্যোগ নিয়েছে বাংলাদেশ ব্যাংক। আগামী বছরের জুলাইয়ে এ ব্যবস্থা চালুর লক্ষ্যমাত্রা নির্&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%85%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a6%b0%e0%a7%8d%e0%a6%ad%e0%a7%81%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%bf%e0%a6%ae%e0%a7%82%e0%a6%b2%e0%a6%95-%e0%a6%a4%e0%a6%be%e0%a7%8e%e0%a6%95%e0%a7%8d%e0%a6%b7/">জুমবাংলা</source>
    </item>
    <item>
      <title>মানিকগঞ্জে পুলিশ সুপারের বাসভবন ও ফাঁড়ির সামনে ককটেল বিস্ফোরণ</title>
      <link>https://zoombangla.com/%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a6%bf%e0%a6%95%e0%a6%97%e0%a6%9e%e0%a7%8d%e0%a6%9c%e0%a7%87-%e0%a6%aa%e0%a7%81%e0%a6%b2%e0%a6%bf%e0%a6%b6-%e0%a6%b8%e0%a7%81%e0%a6%aa%e0%a6%be%e0%a6%b0%e0%a7%87%e0%a6%b0/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a6%bf%e0%a6%95%e0%a6%97%e0%a6%9e%e0%a7%8d%e0%a6%9c%e0%a7%87-%e0%a6%aa%e0%a7%81%e0%a6%b2%e0%a6%bf%e0%a6%b6-%e0%a6%b8%e0%a7%81%e0%a6%aa%e0%a6%be%e0%a6%b0%e0%a7%87%e0%a6%b0/</guid>
      <pubDate>Mon, 09 Nov 2026 18:11:18 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/IMG_20261110_000915.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/IMG_20261110_000915.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/IMG_20261110_000915.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মানিকগঞ্জে পুলিশ সুপারের বাসভবন ও ফাঁড়ির সামনে ককটেল বিস্ফোরণ" /&gt;&lt;/p&gt;&lt;p&gt;সাইফুল ইসলাম: মানিকগঞ্জে একের পর এক ককটেল বিস্ফোরণের ঘটনায় উত্তেজনা ছড়িয়ে পড়েছে। জেলা প্রশাসকের কার্যালয়, বাসস্ট্যান্ড, বিভিন্ন রাজনৈতিক কার্যালয় ও গুরুত্বপূর্ণ স্থানের পর এবার পুলিশ সুপারের বাসভবন, পাটুরিয়া পুলিশ ফাঁড়ি এবং ঘিওর বাসস্ট্যান্ডের সামনে ককটেল বিস্ফোরণের ঘটনা ঘটেছে। সোমবার (৯ নভেম্বর) সন&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a6%bf%e0%a6%95%e0%a6%97%e0%a6%9e%e0%a7%8d%e0%a6%9c%e0%a7%87-%e0%a6%aa%e0%a7%81%e0%a6%b2%e0%a6%bf%e0%a6%b6-%e0%a6%b8%e0%a7%81%e0%a6%aa%e0%a6%be%e0%a6%b0%e0%a7%87%e0%a6%b0/">জুমবাংলা</source>
    </item>
    <item>
      <title>আসছে লঘুচাপ, টানা ৩ দিন বৃষ্টির আভাস যেসব অঞ্চলে</title>
      <link>https://zoombangla.com/%e0%a6%86%e0%a6%b8%e0%a6%9b%e0%a7%87-%e0%a6%b2%e0%a6%98%e0%a7%81%e0%a6%9a%e0%a6%be%e0%a6%aa/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%86%e0%a6%b8%e0%a6%9b%e0%a7%87-%e0%a6%b2%e0%a6%98%e0%a7%81%e0%a6%9a%e0%a6%be%e0%a6%aa/</guid>
      <pubDate>Mon, 09 Nov 2026 17:47:57 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/আসছে-লঘুচাপ.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/আসছে-লঘুচাপ.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/আসছে-লঘুচাপ.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আসছে লঘুচাপ, টানা ৩ দিন বৃষ্টির আভাস যেসব অঞ্চলে" /&gt;&lt;/p&gt;&lt;p&gt;দক্ষিণ বঙ্গোপসাগরে মৌসুমের স্বাভাবিক লঘুচাপের প্রভাবে দেশের আট বিভাগেই বৃষ্টি ও বজ্রসহ বৃষ্টির সম্ভাবনা রয়েছে। আগামী মঙ্গলবার (১০ নভেম্বর) ও বুধবার (১১ নভেম্বর) টানা বৃষ্টির পূর্বাভাস দিয়েছে বাংলাদেশ আবহাওয়া অধিদপ্তর। এর আগে সোমবারও দেশের বিভিন্ন অঞ্চলে বৃষ্টি হতে পারে। এ সময়ে রাত ও দিনের তাপমাত্রা &lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%86%e0%a6%b8%e0%a6%9b%e0%a7%87-%e0%a6%b2%e0%a6%98%e0%a7%81%e0%a6%9a%e0%a6%be%e0%a6%aa/">জুমবাংলা</source>
    </item>

      <pubDate>Mon, 23 Nov 2026 18:33:58 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%B0%E0%A6%B9%E0%A6%AE%E0%A6%BE%E0%A6%A8.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%B0%E0%A6%B9%E0%A6%AE%E0%A6%BE%E0%A6%A8.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%B0%E0%A6%B9%E0%A6%AE%E0%A6%BE%E0%A6%A8.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মঙ্গলবার স্বর্ণদ্বীপ যাচ্ছেন প্রধানমন্ত্রী তারেক রহমান" /&gt;&lt;/p&gt;&lt;p&gt;সেনা, নৌ ও বিমান বাহিনীর যৌথ সামরিক মহড়া পরিদর্শনে আগামীকাল মঙ্গলবার নোয়াখালীর স্বর্ণদ্বীপ যাচ্ছেন প্রধানমন্ত্রী তারেক রহমান। সেখানে তিন বাহিনীর বিশেষ প্রশিক্ষণ, সামরিক সরঞ্জাম প্রদর্শনী ও বিভিন্ন অভিযানমূলক কার্যক্রম দেখবেন তিনি। মঙ্গলবার (২৩ নভেম্বর) প্রধানমন্ত্রীর কার্যালয়ের এক সংবাদ বিজ্ঞপ্তিতে &lt;/p&gt;</description>

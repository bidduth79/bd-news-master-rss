      <source url="https://zoombangla.com/%e0%a6%a8%e0%a6%be%e0%a6%b0%e0%a7%80-%e0%a6%aa%e0%a7%81%e0%a6%b2%e0%a6%bf%e0%a6%b6-%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%a4%e0%a6%be/">জুমবাংলা</source>
    </item>
    <item>
      <title>সর্বনিম্ন ও সর্বোচ্চ নিট পেনশনের সীমা নির্ধারণ করে নতুন প্রজ্ঞাপন জারি</title>
      <link>https://zoombangla.com/%e0%a6%b8%e0%a6%b0%e0%a7%8d%e0%a6%ac%e0%a6%a8%e0%a6%bf%e0%a6%ae%e0%a7%8d%e0%a6%a8-%e0%a6%93-%e0%a6%b8%e0%a6%b0%e0%a7%8d%e0%a6%ac%e0%a7%8b%e0%a6%9a%e0%a7%8d%e0%a6%9a-%e0%a6%a8%e0%a6%bf%e0%a6%9f/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%b8%e0%a6%b0%e0%a7%8d%e0%a6%ac%e0%a6%a8%e0%a6%bf%e0%a6%ae%e0%a7%8d%e0%a6%a8-%e0%a6%93-%e0%a6%b8%e0%a6%b0%e0%a7%8d%e0%a6%ac%e0%a7%8b%e0%a6%9a%e0%a7%8d%e0%a6%9a-%e0%a6%a8%e0%a6%bf%e0%a6%9f/</guid>
      <pubDate>Thu, 12 Nov 2026 18:15:17 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/সর্বনিম্ন-ও-সর্বোচ্চ-নিট-পেনশনের.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/সর্বনিম্ন-ও-সর্বোচ্চ-নিট-পেনশনের.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/সর্বনিম্ন-ও-সর্বোচ্চ-নিট-পেনশনের.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সর্বনিম্ন ও সর্বোচ্চ নিট পেনশনের সীমা নির্ধারণ করে নতুন প্রজ্ঞাপন জারি" /&gt;&lt;/p&gt;&lt;p&gt;সরকারি চাকরিজীবীদের পেনশন ও অবসর-উত্তর সুবিধায় গুরুত্বপূর্ণ পরিবর্তন এনেছে সরকার। ২০২৬ সালের জাতীয় বেতন স্কেল অনুযায়ী অবসরপ্রাপ্ত সরকারি কর্মচারীদের নিট পেনশন বৃদ্ধির হার এবং সর্বনিম্ন ও সর্বোচ্চ পেনশনের সীমা নির্ধারণ করে নতুন প্রজ্ঞাপন জারি করেছে অর্থ মন্ত্রণালয়। এতে বিদ্যমান নিট পেনশনের পরিমাণ অনু&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%b8%e0%a6%b0%e0%a7%8d%e0%a6%ac%e0%a6%a8%e0%a6%bf%e0%a6%ae%e0%a7%8d%e0%a6%a8-%e0%a6%93-%e0%a6%b8%e0%a6%b0%e0%a7%8d%e0%a6%ac%e0%a7%8b%e0%a6%9a%e0%a7%8d%e0%a6%9a-%e0%a6%a8%e0%a6%bf%e0%a6%9f/">জুমবাংলা</source>
    </item>
    <item>
      <title>দলীয় কর্মীকে লাথি, পরে ফোন করে দুঃখ প্রকাশ প্রতিমন্ত্রীর</title>
      <link>https://zoombangla.com/%e0%a6%a6%e0%a6%b2%e0%a7%80%e0%a6%af%e0%a6%bc-%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a7%80%e0%a6%95%e0%a7%87-%e0%a6%b2%e0%a6%be%e0%a6%a5%e0%a6%bf/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%a6%e0%a6%b2%e0%a7%80%e0%a6%af%e0%a6%bc-%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a7%80%e0%a6%95%e0%a7%87-%e0%a6%b2%e0%a6%be%e0%a6%a5%e0%a6%bf/</guid>
      <pubDate>Thu, 12 Nov 2026 18:08:09 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/দলীয়-কর্মীকে-লাথি.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/দলীয়-কর্মীকে-লাথি.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/দলীয়-কর্মীকে-লাথি.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দলীয় কর্মীকে লাথি, পরে ফোন করে দুঃখ প্রকাশ প্রতিমন্ত্রীর" /&gt;&lt;/p&gt;&lt;p&gt;ঢাকায় বিএনপির একটি রাজনৈতিক মিছিলে দলীয় কর্মীকে লাথি মারার ঘটনার এক দিন পর তার কাছে ফোন করে দুঃখ প্রকাশ করেছেন নৌপরিবহন ও সেতু বিভাগের প্রতিমন্ত্রী মো. রাজীব আহসান। লাথির শিকার ওই কর্মী শফিকুল ইসলাম শফিক নিজেই এ তথ্য জানিয়েছেন। বৃহস্পতিবার (১২ নভেম্বর) সন্ধ্যায় একটি সংবাদমাধ্যমকে দেওয়া সাক্ষাৎকারে শ&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%a6%e0%a6%b2%e0%a7%80%e0%a6%af%e0%a6%bc-%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a7%80%e0%a6%95%e0%a7%87-%e0%a6%b2%e0%a6%be%e0%a6%a5%e0%a6%bf/">জুমবাংলা</source>
    </item>
    <item>
      <title>শেখ হাসিনাকে ফেরত পাঠাতে চায় ভারত, তবে শর্ত ২টি: বিবিসি বাংলার প্রতিবেদন</title>
      <link>https://zoombangla.com/%e0%a6%b6%e0%a7%87%e0%a6%96-%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%a8%e0%a6%be-2/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%b6%e0%a7%87%e0%a6%96-%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%a8%e0%a6%be-2/</guid>
      <pubDate>Thu, 12 Nov 2026 17:59:49 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/শেখ-হাসিনা.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/শেখ-হাসিনা.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/শেখ-হাসিনা.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শেখ হাসিনাকে ফেরত পাঠাতে চায় ভারত, তবে শর্ত ২টি: বিবিসি বাংলার প্রতিবেদন" /&gt;&lt;/p&gt;&lt;p&gt;ছাত্র-জনতার গণঅভ্যুত্থানে ক্ষমতাচ্যুত হয়ে ভারতে আশ্রয় নেওয়া শেখ হাসিনাকে বাংলাদেশে পাঠাতে চায় দেশটির সরকার। এ জন্য দুটি শর্ত নিয়ে দুই দেশের মধ্যে চলছে আলোচনা। বৃহস্পতিবার বিবিসি বাংলার এক প্রতিবেদনে এমনটি দাবি করা হয়েছে। প্রতিবেদনের কিছু অংশ হুবহু তুলে ধরা হলো: দিল্লিতে সরকারি কর্মকর্তারা বিবি&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%b6%e0%a7%87%e0%a6%96-%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%a8%e0%a6%be-2/">জুমবাংলা</source>
    </item>
    <item>
      <title>পোশাক শ্রমিকদের ওভারটাইমে নতুন শর্ত, ৭ নির্দেশনা জারি</title>
      <link>https://zoombangla.com/%e0%a6%aa%e0%a7%8b%e0%a6%b6%e0%a6%be%e0%a6%95-%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a6%ae%e0%a6%bf%e0%a6%95%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%93%e0%a6%ad%e0%a6%be%e0%a6%b0%e0%a6%9f%e0%a6%be%e0%a6%87%e0%a6%ae/</link>

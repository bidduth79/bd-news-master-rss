    <item>
      <title>ঘূর্ণিঝড় আকভানের প্রভাবে বঙ্গোপসাগরে নৌকাসহ নিখোঁজ ৭ জেলে, তল্লাশিতে নৌবাহিনী</title>
      <link>https://zoombangla.com/%e0%a6%98%e0%a7%82%e0%a6%b0%e0%a7%8d%e0%a6%a3%e0%a6%bf%e0%a6%9d%e0%a6%a1%e0%a6%bc-%e0%a6%86%e0%a6%95%e0%a6%ad%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b0-2/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%98%e0%a7%82%e0%a6%b0%e0%a7%8d%e0%a6%a3%e0%a6%bf%e0%a6%9d%e0%a6%a1%e0%a6%bc-%e0%a6%86%e0%a6%95%e0%a6%ad%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b0-2/</guid>
      <pubDate>Tue, 24 Nov 2026 18:35:05 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AC%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%B8%E0%A6%BE%E0%A6%97%E0%A6%B0%E0%A7%87.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AC%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%B8%E0%A6%BE%E0%A6%97%E0%A6%B0%E0%A7%87.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AC%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%B8%E0%A6%BE%E0%A6%97%E0%A6%B0%E0%A7%87.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঘূর্ণিঝড় আকভানের প্রভাবে বঙ্গোপসাগরে নৌকাসহ নিখোঁজ ৭ জেলে, তল্লাশিতে নৌবাহিনী" /&gt;&lt;/p&gt;&lt;p&gt;ঘূর্ণিঝড় আকভানের প্রভাবে বঙ্গোপসাগরে নৌকাসহ নিখোঁজ হয়েছেন ভারতের অন্ধ্রপ্রদেশের কাকিনাড়ার সাত জেলে। তাদের উদ্ধারে ব্যাপক তল্লাশি অভিযান চালাচ্ছে ভারতীয় নৌবাহিনী, কোস্টগার্ডসহ বিভিন্ন সামুদ্রিক সংস্থা। বাংলাদেশ ও মিয়ানমারের জলসীমায় নৌকাটি চলে গেছে কিনা তা যাচাইয়ে দুইদেশের কর্তৃপক্ষের কাছে তথ্য পাঠিয়ে&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%98%e0%a7%82%e0%a6%b0%e0%a7%8d%e0%a6%a3%e0%a6%bf%e0%a6%9d%e0%a6%a1%e0%a6%bc-%e0%a6%86%e0%a6%95%e0%a6%ad%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b0-2/">জুমবাংলা</source>
    </item>
    <item>
      <title>যৌথ সামরিক মহড়া বিশ্বদরবারে বাংলাদেশের সশস্ত্র বাহিনীর সক্ষমতা তুলে ধরবে: প্রধানমন্ত্রী</title>
      <link>https://zoombangla.com/%e0%a6%af%e0%a7%8c%e0%a6%a5-%e0%a6%b8%e0%a6%be%e0%a6%ae%e0%a6%b0%e0%a6%bf%e0%a6%95-%e0%a6%ae%e0%a6%b9%e0%a6%a1%e0%a6%bc%e0%a6%be/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%af%e0%a7%8c%e0%a6%a5-%e0%a6%b8%e0%a6%be%e0%a6%ae%e0%a6%b0%e0%a6%bf%e0%a6%95-%e0%a6%ae%e0%a6%b9%e0%a6%a1%e0%a6%bc%e0%a6%be/</guid>
      <pubDate>Tue, 24 Nov 2026 18:29:06 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AF%E0%A7%8C%E0%A6%A5-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%B0%E0%A6%BF%E0%A6%95-%E0%A6%AE%E0%A6%B9%E0%A6%A1%E0%A6%BC%E0%A6%BE.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AF%E0%A7%8C%E0%A6%A5-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%B0%E0%A6%BF%E0%A6%95-%E0%A6%AE%E0%A6%B9%E0%A6%A1%E0%A6%BC%E0%A6%BE.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AF%E0%A7%8C%E0%A6%A5-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%B0%E0%A6%BF%E0%A6%95-%E0%A6%AE%E0%A6%B9%E0%A6%A1%E0%A6%BC%E0%A6%BE.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যৌথ সামরিক মহড়া বিশ্বদরবারে বাংলাদেশের সশস্ত্র বাহিনীর সক্ষমতা তুলে ধরবে: প্রধানমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;প্রধানমন্ত্রী তারেক রহমান বলেছেন, তিন বাহিনীর যৌথ সামরিক মহড়া বিশ্বদরবারে বাংলাদেশের সশস্ত্র বাহিনীর সক্ষমতা তুলে ধরবে। তিনি বলেন, বাংলাদেশের সামরিক বাহিনীর ইতিহাসে আজ একটি নতুন অধ্যায়ের সূচনা হয়েছে। দেশের ইতিহাসে প্রথমবারের মতো তিন বাহিনীর স্পেশাল ফোর্সের সমন্বয়ে অনুষ্ঠিত যৌথ সামরিক মহড়ার সাক্ষী হত&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%af%e0%a7%8c%e0%a6%a5-%e0%a6%b8%e0%a6%be%e0%a6%ae%e0%a6%b0%e0%a6%bf%e0%a6%95-%e0%a6%ae%e0%a6%b9%e0%a6%a1%e0%a6%bc%e0%a6%be/">জুমবাংলা</source>
    </item>

      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Cheta.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Cheta.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Cheta.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডায়েট করাতে গিয়ে বিপাকে চিড়িয়াখানা, বয়সের ভারে ওজন কমানো বন্ধ ‘মোটা’ চিতাবাঘের" /&gt;&lt;/p&gt;&lt;p&gt;ওজন কমানোর জন্য বহু চেষ্টা হয়েছিল। খাবারের পরিমাণ নিয়ন্ত্রণ, ডায়েটের বদল—কোনও কিছুই বাদ রাখেননি চিড়িয়াখানার কর্মীরা। কিন্তু শেষ পর্যন্ত হাল ছাড়তে হল তাঁদেরই। কারণ, চিতাবাঘটির বয়স এখন ১৯ বছর। এই বয়সে জোর করে ওজন কমানোর চেষ্টা তার স্বাস্থ্যের পক্ষে বিপজ্জনক হতে পারে। তাই আপাতত ডায়েটের লক্ষ্য বদলে গি&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%a1%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%9f-%e0%a6%95%e0%a6%b0%e0%a6%be%e0%a6%a4%e0%a7%87-%e0%a6%97%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87/">জুমবাংলা</source>
    </item>
    <item>
      <title>র‍্যাম সংকটে বিশ্বে স্মার্টফোন বিক্রি কমেছে ১৬ শতাংশ, চাপে অ্যান্ড্রয়েড</title>
      <link>https://zoombangla.com/%e0%a6%b8%e0%a7%8d%e0%a6%ae%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%9f%e0%a6%ab%e0%a7%8b%e0%a6%a8-%e0%a6%ac%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b0%e0%a6%bf/</link>

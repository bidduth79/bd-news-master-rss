    <item>
      <title>দ্বিতীয়বারের মতো জাতীয় গ্রিডে যুক্ত হলো রূপপুরের বিদ্যুৎ</title>
      <link>https://zoombangla.com/%e0%a6%a6%e0%a7%8d%e0%a6%ac%e0%a6%bf%e0%a6%a4%e0%a7%80%e0%a6%af%e0%a6%bc%e0%a6%ac%e0%a6%be%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a6%a4%e0%a7%8b/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%a6%e0%a7%8d%e0%a6%ac%e0%a6%bf%e0%a6%a4%e0%a7%80%e0%a6%af%e0%a6%bc%e0%a6%ac%e0%a6%be%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a6%a4%e0%a7%8b/</guid>
      <pubDate>Mon, 23 Nov 2026 08:15:32 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Rub.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Rub.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Rub.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দ্বিতীয়বারের মতো জাতীয় গ্রিডে যুক্ত হলো রূপপুরের বিদ্যুৎ" /&gt;&lt;/p&gt;&lt;p&gt;রূপপুর পারমাণবিক বিদ্যুৎকেন্দ্র থেকে দ্বিতীয়বারের মতো পরীক্ষামূলকভাবে জাতীয় গ্রিডে বিদ্যুৎ সরবরাহ শুরু হয়েছে। সোমবার (২৩ নভেম্বর) সকাল ১০টা ২০ মিনিটে এ বিদ্যুৎ সরবরাহ শুরু হয়। রূপপুর পারমাণবিক বিদ্যুৎকেন্দ্র নির্মাণ প্রকল্পের ঊর্ধ্বতন বৈজ্ঞানিক তথ্য কর্মকর্তা এবং ফোকাল পয়েন্ট (গণমাধ্যম) সৈকত আহমেদ এ&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%a6%e0%a7%8d%e0%a6%ac%e0%a6%bf%e0%a6%a4%e0%a7%80%e0%a6%af%e0%a6%bc%e0%a6%ac%e0%a6%be%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a6%a4%e0%a7%8b/">জুমবাংলা</source>
    </item>
    <item>
      <title>সুইডেন আসলামের বিরুদ্ধে নতুন হ ‘ত্যা মামলা!</title>
      <link>https://zoombangla.com/%e0%a6%b8%e0%a7%81%e0%a6%87%e0%a6%a1%e0%a7%87%e0%a6%a8-%e0%a6%86%e0%a6%b8%e0%a6%b2%e0%a6%be%e0%a6%ae%e0%a7%87%e0%a6%b0/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%b8%e0%a7%81%e0%a6%87%e0%a6%a1%e0%a7%87%e0%a6%a8-%e0%a6%86%e0%a6%b8%e0%a6%b2%e0%a6%be%e0%a6%ae%e0%a7%87%e0%a6%b0/</guid>
      <pubDate>Mon, 23 Nov 2026 08:09:01 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/sw.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/sw.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/sw.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সুইডেন আসলামের বিরুদ্ধে নতুন হ ‘ত্যা মামলা!" /&gt;&lt;/p&gt;&lt;p&gt;দেশ ছেড়ে থাইল্যান্ডে পালানোর সময় রোববার (২২ নভেম্বর) রাতে হযরত শাহজালাল আন্তর্জাতিক বিমানবন্দরে ধরা পড়েছেন নব্বইয়ের দশকে ঢাকায় ত্রাস ছড়ানো আলোচিত শীর্ষ সন্ত্রাসী এস এম আসলাম হোসেন ওরফে ‘সুইডেন আসলাম’। ধরা পড়ার পর তালিকাভুক্ত এই শীর্ষ সন্ত্রাসী এখন জিজ্ঞাসাবাদ করছে গোয়েন্দা পুলিশ (ডিবি)। চলতি বছরে রা&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%b8%e0%a7%81%e0%a6%87%e0%a6%a1%e0%a7%87%e0%a6%a8-%e0%a6%86%e0%a6%b8%e0%a6%b2%e0%a6%be%e0%a6%ae%e0%a7%87%e0%a6%b0/">জুমবাংলা</source>
    </item>
    <item>
      <title>আরও বেড়েছে খেলাপি ঋণ</title>
      <link>https://zoombangla.com/%e0%a6%86%e0%a6%b0%e0%a6%93-%e0%a6%ac%e0%a7%87%e0%a6%a1%e0%a6%bc%e0%a7%87%e0%a6%9b%e0%a7%87-%e0%a6%96%e0%a7%87%e0%a6%b2%e0%a6%be%e0%a6%aa%e0%a6%bf-%e0%a6%8b%e0%a6%a3/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%86%e0%a6%b0%e0%a6%93-%e0%a6%ac%e0%a7%87%e0%a6%a1%e0%a6%bc%e0%a7%87%e0%a6%9b%e0%a7%87-%e0%a6%96%e0%a7%87%e0%a6%b2%e0%a6%be%e0%a6%aa%e0%a6%bf-%e0%a6%8b%e0%a6%a3/</guid>
      <pubDate>Mon, 23 Nov 2026 08:05:52 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/bd.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/bd.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/bd.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আরও বেড়েছে খেলাপি ঋণ" /&gt;&lt;/p&gt;&lt;p&gt;দেশের ব্যাংক খাতে ক্রমশ বাড়ছে খেলাপি ও শ্রেণিকৃত ঋণের চাপ। সেপ্টেম্বর শেষে ব্যাংকগুলোর মোট শ্রেণিকৃত ঋণের পরিমাণ ২০ হাজার ৮৪৯ কোটি টাকা বেড়ে এখন ৬ লাখ ২৭ হাজার ৪০৪ কোটি টাকা, যা বিতরণ করা মোট ঋণের ৩৩ দশমিক ৮০ শতাংশ। অর্থাৎ ব্যাংক খাতের বিতরণ করা ঋণের প্রায় ৩৪ শতাংশই এখন ঝুঁকিপূর্ণ ঋণে পরিণত হয়েছে। স&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%86%e0%a6%b0%e0%a6%93-%e0%a6%ac%e0%a7%87%e0%a6%a1%e0%a6%bc%e0%a7%87%e0%a6%9b%e0%a7%87-%e0%a6%96%e0%a7%87%e0%a6%b2%e0%a6%be%e0%a6%aa%e0%a6%bf-%e0%a6%8b%e0%a6%a3/">জুমবাংলা</source>
    </item>
    <item>
      <title>প্রধানমন্ত্রীর সঙ্গে বৈঠকের জন্য সচিবালয়ে এনসিপির চার নেতা</title>
      <link>https://zoombangla.com/%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a7%e0%a6%be%e0%a6%a8%e0%a6%ae%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a7%80%e0%a6%b0-%e0%a6%b8%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%87-%e0%a6%ac%e0%a7%88-4/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a7%e0%a6%be%e0%a6%a8%e0%a6%ae%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a7%80%e0%a6%b0-%e0%a6%b8%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%87-%e0%a6%ac%e0%a7%88-4/</guid>
      <pubDate>Mon, 23 Nov 2026 07:59:44 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/hasnat.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/hasnat.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/hasnat.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রধানমন্ত্রীর সঙ্গে বৈঠকের জন্য সচিবালয়ে এনসিপির চার নেতা" /&gt;&lt;/p&gt;&lt;p&gt;প্রধানমন্ত্রী তারেক রহমানের সঙ্গে সংলাপে অংশ নিতে জাতীয় নাগরিক পার্টির (এনসিপি) আহ্বায়ক নাহিদ ইসলামের নেতৃত্বে সচিবালয়ে পৌঁছেছে চার সদস্যের একটি প্রতিনিধি দল। সোমবার (২৩ নভেম্বর) বেলা একটার দিকে প্রতিনিধি দলটি সচিবালয়ে প্রধানমন্ত্রীর কার্যালয়ে পৌঁছায়। এনসিপির আহ্বায়ক ও জাতীয় সংসদের বিরোধীদলীয় চিফ হু&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a7%e0%a6%be%e0%a6%a8%e0%a6%ae%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a7%80%e0%a6%b0-%e0%a6%b8%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%87-%e0%a6%ac%e0%a7%88-4/">জুমবাংলা</source>
    </item>
    <item>
      <title>আর্জেন্টিনায় অনুশীলনের সময় বজ্রপাতে ফুটবলারের মৃত্যু</title>
      <link>https://zoombangla.com/%e0%a6%86%e0%a6%b0%e0%a7%8d%e0%a6%9c%e0%a7%87%e0%a6%a8%e0%a7%8d%e0%a6%9f%e0%a6%bf%e0%a6%a8%e0%a6%be%e0%a6%af%e0%a6%bc/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%86%e0%a6%b0%e0%a7%8d%e0%a6%9c%e0%a7%87%e0%a6%a8%e0%a7%8d%e0%a6%9f%e0%a6%bf%e0%a6%a8%e0%a6%be%e0%a6%af%e0%a6%bc/</guid>
      <pubDate>Mon, 23 Nov 2026 07:08:05 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/arg-1.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/arg-1.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/arg-1.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আর্জেন্টিনায় অনুশীলনের সময় বজ্রপাতে ফুটবলারের মৃত্যু" /&gt;&lt;/p&gt;&lt;p&gt;আর্জেন্টিনায় ফুটবল অনুশীলন করার সময় বজ্রপাতে প্রাণ হারিয়েছেন ৩৪ বছর বয়সী ফুটবলার ইভান মিয়ের্স। একই ঘটনায় আহত হয়েছেন তার সতীর্থ হুয়ান রোমেরো। বর্তমানে তিনি হাসপাতালে চিকিৎসাধীন রয়েছেন। শুক্রবার (২০ নভেম্বর) স্থানীয় সময় বিকেল ৩টার দিকে দেশটির উত্তরাঞ্চলীয় ফোরমোসা প্রদেশের রাজধানীতে এ দুর্ঘটনা ঘটে। আর্&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%86%e0%a6%b0%e0%a7%8d%e0%a6%9c%e0%a7%87%e0%a6%a8%e0%a7%8d%e0%a6%9f%e0%a6%bf%e0%a6%a8%e0%a6%be%e0%a6%af%e0%a6%bc/">জুমবাংলা</source>
    </item>
    <item>
      <title>রিজার্ভ-রেমিট্যান্স স্বস্তিতেও বিনিয়োগে গতি ফিরছে না</title>
      <link>https://zoombangla.com/%e0%a6%b0%e0%a6%bf%e0%a6%9c%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%ad-%e0%a6%b0%e0%a7%87%e0%a6%ae%e0%a6%bf%e0%a6%9f%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%b8/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%b0%e0%a6%bf%e0%a6%9c%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%ad-%e0%a6%b0%e0%a7%87%e0%a6%ae%e0%a6%bf%e0%a6%9f%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%b8/</guid>
      <pubDate>Mon, 23 Nov 2026 06:50:21 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/bnak.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/bnak.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/bnak.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রিজার্ভ-রেমিট্যান্স স্বস্তিতেও বিনিয়োগে গতি ফিরছে না" /&gt;&lt;/p&gt;&lt;p&gt;বৈদেশিক মুদ্রার রিজার্ভ, প্রবাসী আয় ও রপ্তানি আয়ে ইতিবাচক ধারা বৈদেশিক খাতে ফিরছে স্বস্তি। বাংলাদেশ ব্যাংক বলছে, রেমিট্যান্স ও রপ্তানি আয়ের বর্তমান প্রবাহে চাপমুক্ত রয়েছে ডলারের বাজার। তবে অভ্যন্তরীণ অর্থনীতির চিত্র ভিন্ন। বেসরকারি খাতে ঋণ প্রবৃদ্ধি নেমেছে ইতিহাসের সর্বনিম্ন পর্যায়ে। ব্যাংকে বিপুল অ&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%b0%e0%a6%bf%e0%a6%9c%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%ad-%e0%a6%b0%e0%a7%87%e0%a6%ae%e0%a6%bf%e0%a6%9f%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%b8/">জুমবাংলা</source>
    </item>
    <item>
      <title>বিয়ে করলেন পপ-তারকা মাইলি সাইরাস</title>
      <link>https://zoombangla.com/%e0%a6%8f%e0%a6%87%e0%a6%9a%e0%a6%8f%e0%a6%b8%e0%a6%b8%e0%a6%bf%e0%a6%b0/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%8f%e0%a6%87%e0%a6%9a%e0%a6%8f%e0%a6%b8%e0%a6%b8%e0%a6%bf%e0%a6%b0/</guid>
      <pubDate>Mon, 23 Nov 2026 06:25:41 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/865-1.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/865-1.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/865-1.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিয়ে করলেন পপ-তারকা মাইলি সাইরাস" /&gt;&lt;/p&gt;&lt;p&gt;দীর্ঘদিনের প্রেমিক, সঙ্গীতশিল্পী ম্যাক্স মোরান্ডোকে বিয়ে করেছেন আমেরিকান পপ-তারকা মাইলি সাইরাস। ক্যালিফোর্নিয়ার পাম স্প্রিংসে ঘনিষ্ঠ আত্মীয়স্বজন ও বন্ধুদের উপস্থিতিতে ব্যক্তিগত অনুষ্ঠানের আয়োজন করেছিলেন তারা। ‘পিপল’ ম্যাগাজ়িনের প্রতিবেদন অনুযায়ী, গত শনিবার (২১ নভেম্বর) বিয়ে করেছেন এই যুগল। তাদের বি&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%8f%e0%a6%87%e0%a6%9a%e0%a6%8f%e0%a6%b8%e0%a6%b8%e0%a6%bf%e0%a6%b0/">জুমবাংলা</source>
    </item>
    <item>
      <title>কয়েক দফা কমার পর বাড়ল স্বর্ণের দাম</title>
      <link>https://zoombangla.com/%e0%a6%95%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%95-%e0%a6%a6%e0%a6%ab%e0%a6%be-%e0%a6%95%e0%a6%ae%e0%a6%be%e0%a6%b0-%e0%a6%aa%e0%a6%b0-%e0%a6%ac%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a6%b2/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%95%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%95-%e0%a6%a6%e0%a6%ab%e0%a6%be-%e0%a6%95%e0%a6%ae%e0%a6%be%e0%a6%b0-%e0%a6%aa%e0%a6%b0-%e0%a6%ac%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a6%b2/</guid>
      <pubDate>Mon, 23 Nov 2026 06:17:22 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/gold.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/gold.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/gold.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কয়েক দফা কমার পর বাড়ল স্বর্ণের দাম" /&gt;&lt;/p&gt;&lt;p&gt;টানা কয়েক দফা কমার পর দেশের বাজারে আবারও বেড়েছে স্বর্ণের দাম। নতুন সিদ্ধান্ত অনুযায়ী, ২২ ক্যারেটের এক ভরি স্বর্ণের দাম নির্ধারণ করা হয়েছে ১ লাখ ৯৮ হাজার ১১৩ টাকা। আগের দামের তুলনায় বেড়েছে ৩ হাজার ১৪৯ টাকা। সোমবার (২৩ নভেম্বর) সকালে বাংলাদেশ জুয়েলার্স অ্যাসোসিয়েশনের (বাজুস) এক বিজ্ঞপ্তিতে নতুন দাম ঘো&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%95%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%95-%e0%a6%a6%e0%a6%ab%e0%a6%be-%e0%a6%95%e0%a6%ae%e0%a6%be%e0%a6%b0-%e0%a6%aa%e0%a6%b0-%e0%a6%ac%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a6%b2/">জুমবাংলা</source>
    </item>
    <item>
      <title>৫ বিভাগে বজ্রসহ বৃষ্টির আভাস, রাতের তাপমাত্রা নিয়ে নতুন বার্তা</title>
      <link>https://zoombangla.com/%e0%a7%ab-%e0%a6%ac%e0%a6%bf%e0%a6%ad%e0%a6%be%e0%a6%97%e0%a7%87-%e0%a6%ac%e0%a6%9c%e0%a7%8d%e0%a6%b0%e0%a6%b8%e0%a6%b9/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a7%ab-%e0%a6%ac%e0%a6%bf%e0%a6%ad%e0%a6%be%e0%a6%97%e0%a7%87-%e0%a6%ac%e0%a6%9c%e0%a7%8d%e0%a6%b0%e0%a6%b8%e0%a6%b9/</guid>

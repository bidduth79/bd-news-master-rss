    <item>
      <title>মিস ইউনিভার্সে দেশীয় ঐতিহ্য নজর কাড়লেন সামিরা খান মাহি</title>
      <link>https://zoombangla.com/%e0%a6%ae%e0%a6%bf%e0%a6%b8-%e0%a6%87%e0%a6%89%e0%a6%a8%e0%a6%bf%e0%a6%ad%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%b8%e0%a7%87-%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%80%e0%a6%af%e0%a6%bc/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%ae%e0%a6%bf%e0%a6%b8-%e0%a6%87%e0%a6%89%e0%a6%a8%e0%a6%bf%e0%a6%ad%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%b8%e0%a7%87-%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%80%e0%a6%af%e0%a6%bc/</guid>
      <pubDate>Sun, 22 Nov 2026 18:15:12 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AE%E0%A6%BF%E0%A6%B8-%E0%A6%87%E0%A6%89%E0%A6%A8%E0%A6%BF%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B8%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A6%BE-%E0%A6%96%E0%A6%BE%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B9%E0%A6%BF.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AE%E0%A6%BF%E0%A6%B8-%E0%A6%87%E0%A6%89%E0%A6%A8%E0%A6%BF%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B8%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A6%BE-%E0%A6%96%E0%A6%BE%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B9%E0%A6%BF.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AE%E0%A6%BF%E0%A6%B8-%E0%A6%87%E0%A6%89%E0%A6%A8%E0%A6%BF%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B8%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A6%BE-%E0%A6%96%E0%A6%BE%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B9%E0%A6%BF.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মিস ইউনিভার্সে দেশীয় ঐতিহ্য নজর কাড়লেন সামিরা খান মাহি" /&gt;&lt;/p&gt;&lt;p&gt;পিঠে বৃত্তাকার শিল্পকর্মে ফুটে উঠেছে এক নারীর শৈশব, মাতৃত্ব থেকে বার্ধক্যে পৌঁছানোর গল্প। পরনে লাল-সাদা খাদির শাড়ি, গায়ে বাংলার সাবেকি নকশার সোনালি গয়না। দেশীয় ঐতিহ্য আর মায়ের চিরন্তন ভালোবাসার গল্প নিয়ে আন্তর্জাতিক মঞ্চে হাজির হলেন বাংলাদেশের প্রতিনিধি সামিরা খান মাহি। ৭৫তম মিস ইউনিভার্স প্রতিযোগিত&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ae%e0%a6%bf%e0%a6%b8-%e0%a6%87%e0%a6%89%e0%a6%a8%e0%a6%bf%e0%a6%ad%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%b8%e0%a7%87-%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%80%e0%a6%af%e0%a6%bc/">জুমবাংলা</source>
    </item>
    <item>
      <title>কীভাবে বুঝবেন আপনার সন্তানের শরীরে ক্যালসিয়াম ঘাটতি?</title>
      <link>https://zoombangla.com/%e0%a6%95%e0%a7%80%e0%a6%ad%e0%a6%be%e0%a6%ac%e0%a7%87-%e0%a6%ac%e0%a7%81%e0%a6%9d%e0%a6%ac%e0%a7%87%e0%a6%a8-%e0%a6%86%e0%a6%aa%e0%a6%a8%e0%a6%be%e0%a6%b0/</link>

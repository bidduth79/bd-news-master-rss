      <pubDate>Wed, 18 Nov 2026 17:17:54 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/DMP-scaled.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/DMP-scaled.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/DMP-scaled.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শুরু হচ্ছে চিরুনি অভিযান, নিরাপত্তায় সাজানো হয়েছে রাজধানী" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর বাইরে সহিংসতা করে ঢাকায় এসে বিভিন্ন স্থানে আশ্রয় নেওয়া কার্যক্রম নিষিদ্ধ আওয়ামী লীগ ও এর অঙ্গ সংগঠনের নেতাকর্মীদের ধরতে চিরুনি অভিযান শুরু করছে ঢাকা মহানগর (ডিএমপি) পুলিশ। বুধবার (১৮ নভেম্বর) দুপুরে নিজ কার্যালয়ে সাংবাদিকদের সঙ্গে আলাপকালে এসব তথ্য জানান ডিএমপির অতিরিক্ত উপ-পুলিশ কমিশনার (&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%b6%e0%a7%81%e0%a6%b0%e0%a7%81-%e0%a6%b9%e0%a6%9a%e0%a7%8d%e0%a6%9b%e0%a7%87-%e0%a6%9a%e0%a6%bf%e0%a6%b0%e0%a7%81%e0%a6%a8%e0%a6%bf/">জুমবাংলা</source>
    </item>
    <item>
      <title>বিশ্বভ্রমণে বেরিয়ে ইসলাম গ্রহণ করলেন চীনা দম্পতি</title>
      <link>https://zoombangla.com/%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%ac%e0%a6%ad%e0%a7%8d%e0%a6%b0%e0%a6%ae%e0%a6%a3%e0%a7%87-%e0%a6%ac%e0%a7%87%e0%a6%b0%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%87%e0%a6%b8%e0%a6%b2%e0%a6%be/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%ac%e0%a6%ad%e0%a7%8d%e0%a6%b0%e0%a6%ae%e0%a6%a3%e0%a7%87-%e0%a6%ac%e0%a7%87%e0%a6%b0%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%87%e0%a6%b8%e0%a6%b2%e0%a6%be/</guid>
      <pubDate>Wed, 18 Nov 2026 17:16:17 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%87%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%B9%E0%A6%A3-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%9A%E0%A7%80%E0%A6%A8%E0%A6%BE-%E0%A6%A6%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%A4%E0%A6%BF.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%87%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%B9%E0%A6%A3-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%9A%E0%A7%80%E0%A6%A8%E0%A6%BE-%E0%A6%A6%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%A4%E0%A6%BF.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%87%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%B9%E0%A6%A3-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%9A%E0%A7%80%E0%A6%A8%E0%A6%BE-%E0%A6%A6%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%A4%E0%A6%BF.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিশ্বভ্রমণে বেরিয়ে ইসলাম গ্রহণ করলেন চীনা দম্পতি" /&gt;&lt;/p&gt;&lt;p&gt;চাকরি ছেড়ে বিশ্বভ্রমণে বেরিয়ে জীবনের নতুন ঠিকানা খুঁজে পেয়েছেন চীনের এক দম্পতি। ইন্দোনেশিয়া থেকে তুরস্কে ভ্রমণের সময় এক তুর্কি পরিবারের সঙ্গে পরিচয় তাদের জীবন বদলে দিয়েছে। ওই পরিবারের আতিথেয়তা, আন্তরিকতা এবং পবিত্র কোরআনের সংস্পর্শে এসে ইসলাম গ্রহণ করেছেন আট বছরের দাম্পত্য জীবনের এই দম্পতি। ইসলাম গ্&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%ac%e0%a6%ad%e0%a7%8d%e0%a6%b0%e0%a6%ae%e0%a6%a3%e0%a7%87-%e0%a6%ac%e0%a7%87%e0%a6%b0%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%87%e0%a6%b8%e0%a6%b2%e0%a6%be/">জুমবাংলা</source>
    </item>
    <item>
      <title>ধেয়ে আসছে ঘূর্ণিঝড় ‌‌‘আকভান’, কখন-কোথায় আঘাত হানবে</title>
      <link>https://zoombangla.com/%e0%a6%a7%e0%a7%87%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%86%e0%a6%b8%e0%a6%9b%e0%a7%87-%e0%a6%98%e0%a7%82%e0%a6%b0%e0%a7%8d%e0%a6%a3%e0%a6%bf/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%a7%e0%a7%87%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%86%e0%a6%b8%e0%a6%9b%e0%a7%87-%e0%a6%98%e0%a7%82%e0%a6%b0%e0%a7%8d%e0%a6%a3%e0%a6%bf/</guid>
      <pubDate>Wed, 18 Nov 2026 17:13:55 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Storm.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Storm.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Storm.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ধেয়ে আসছে ঘূর্ণিঝড় ‌‌‘আকভান’, কখন-কোথায় আঘাত হানবে" /&gt;&lt;/p&gt;&lt;p&gt;বঙ্গোপসাগরে অবস্থানরত ঘূর্ণিঝড় ‘আকভান’ প্রবল ঘূর্ণিঝড়ে রূপ নিয়েছে। প্রবল ঘূর্ণিঝড় রূপে ‘আকভান’ ভারতের উত্তর অন্ধ্র ও দক্ষিণ উড়িষ্যা উপকূলের দিকে এগিয়ে যাচ্ছে। এর প্রভাবে বাংলাদেশের কক্সবাজার ও চট্টগ্রামের কিছু এলাকায় বৃষ্টি শুরু হয়েছে। বুধবার (১৮ নভেম্বর) আবহাওয়া অধিদপ্তরের বিশেষ বিজ্ঞপ্তি নম্বর ১৪-&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%a7%e0%a7%87%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%86%e0%a6%b8%e0%a6%9b%e0%a7%87-%e0%a6%98%e0%a7%82%e0%a6%b0%e0%a7%8d%e0%a6%a3%e0%a6%bf/">জুমবাংলা</source>
    </item>
    <item>
      <title>সংসদ সদস্যদের নিজ নিজ নির্বাচনী এলাকায় যাওয়ার নির্দেশ প্রধানমন্ত্রীর</title>
      <link>https://zoombangla.com/%e0%a6%b8%e0%a6%82%e0%a6%b8%e0%a6%a6-%e0%a6%b8%e0%a6%a6%e0%a6%b8%e0%a7%8d%e0%a6%af%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a6%bf%e0%a6%9c-%e0%a6%a8%e0%a6%bf%e0%a6%9c/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%b8%e0%a6%82%e0%a6%b8%e0%a6%a6-%e0%a6%b8%e0%a6%a6%e0%a6%b8%e0%a7%8d%e0%a6%af%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a6%bf%e0%a6%9c-%e0%a6%a8%e0%a6%bf%e0%a6%9c/</guid>
      <pubDate>Wed, 18 Nov 2026 17:10:57 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/PM-5-scaled.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/PM-5-scaled.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/PM-5-scaled.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সংসদ সদস্যদের নিজ নিজ নির্বাচনী এলাকায় যাওয়ার নির্দেশ প্রধানমন্ত্রীর" /&gt;&lt;/p&gt;&lt;p&gt;দেশের বিভিন্ন স্থানে কার্যক্রম নিষিদ্ধ আওয়ামী লীগের অগ্নিসংযোগ, ভাঙচুর ও ককটেল বিস্ফোরণের ঘটনা রাজনৈতিকভাবে মোকাবিলা করতে বিএনপির সংসদ সদস্যদের (এমপি) নিজ নিজ এলাকায় গিয়ে মাঠে থাকার নির্দেশ দিয়েছেন প্রধানমন্ত্রী ও বিএনপি চেয়ারম্যান তারেক রহমান। বুধবার (১৮ নভেম্বর) বিকেলে বিএনপির সংসদীয় দলের সভায় প্র&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%b8%e0%a6%82%e0%a6%b8%e0%a6%a6-%e0%a6%b8%e0%a6%a6%e0%a6%b8%e0%a7%8d%e0%a6%af%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a6%bf%e0%a6%9c-%e0%a6%a8%e0%a6%bf%e0%a6%9c/">জুমবাংলা</source>
    </item>
    <item>
      <title>দুই মাসের মধ্যে ঢাকার ৫০ সিগন্যালে বসবে এআই ক্যামেরা</title>

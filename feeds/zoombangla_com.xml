    </item>
    <item>
      <title>১১ বছরের প্রেম, প্রবাসীর ৬০ লাখ টাকা নিয়ে যাওয়ার অভিযোগ</title>
      <link>https://zoombangla.com/%e0%a7%a7%e0%a7%a7-%e0%a6%ac%e0%a6%9b%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%ae-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a7%80%e0%a6%b0-%e0%a7%ac/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a7%a7%e0%a7%a7-%e0%a6%ac%e0%a6%9b%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%ae-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a7%80%e0%a6%b0-%e0%a7%ac/</guid>
      <pubDate>Tue, 17 Nov 2026 18:30:14 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A7%A7%E0%A7%A7-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AE.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A7%A7%E0%A7%A7-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AE.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A7%A7%E0%A7%A7-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AE.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="১১ বছরের প্রেম, প্রবাসীর ৬০ লাখ টাকা নিয়ে যাওয়ার অভিযোগ" /&gt;&lt;/p&gt;&lt;p&gt;১১ বছরের প্রেমের সম্পর্কের পর প্রবাসীর ৬০ লাখ টাকা ও স্বর্ণালংকার নিয়ে উধাও, অভিযোগ জমিলার বিরুদ্ধে? বান্দরবানের নাইক্ষ্যংছড়ি উপজেলায় দীর্ঘ ১১ বছরের প্রেমের সম্পর্কের পর এক অস্ট্রেলিয়া প্রবাসীর পাঠানো প্রায় ৬০ লাখ টাকা, বিপুল পরিমাণ স্বর্ণালংকার ও অন্যান্য মূল্যবান সামগ্রী নিয়ে অন্য এক ব্যক্তি&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a7%a7%e0%a7%a7-%e0%a6%ac%e0%a6%9b%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%ae-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a7%80%e0%a6%b0-%e0%a7%ac/">জুমবাংলা</source>
    </item>
    <item>
      <title>১৪৫ কিমি বেগে ধেয়ে আসছে ঘূর্ণিঝড় ‘আকভাান’</title>
      <link>https://zoombangla.com/%e0%a7%a7%e0%a7%aa%e0%a7%ab-%e0%a6%95%e0%a6%bf%e0%a6%ae%e0%a6%bf-%e0%a6%ac%e0%a7%87%e0%a6%97%e0%a7%87-%e0%a6%a7%e0%a7%87%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%86%e0%a6%b8%e0%a6%9b%e0%a7%87-%e0%a6%98/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a7%a7%e0%a7%aa%e0%a7%ab-%e0%a6%95%e0%a6%bf%e0%a6%ae%e0%a6%bf-%e0%a6%ac%e0%a7%87%e0%a6%97%e0%a7%87-%e0%a6%a7%e0%a7%87%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%86%e0%a6%b8%e0%a6%9b%e0%a7%87-%e0%a6%98/</guid>
      <pubDate>Tue, 17 Nov 2026 18:26:10 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%98%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A6%BF%E0%A6%9D%E0%A6%A1%E0%A6%BC-%E2%80%98%E0%A6%86%E0%A6%95%E0%A6%AD%E0%A6%BE%E0%A6%BE%E0%A6%A8.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%98%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A6%BF%E0%A6%9D%E0%A6%A1%E0%A6%BC-%E2%80%98%E0%A6%86%E0%A6%95%E0%A6%AD%E0%A6%BE%E0%A6%BE%E0%A6%A8.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%98%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A6%BF%E0%A6%9D%E0%A6%A1%E0%A6%BC-%E2%80%98%E0%A6%86%E0%A6%95%E0%A6%AD%E0%A6%BE%E0%A6%BE%E0%A6%A8.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="১৪৫ কিমি বেগে ধেয়ে আসছে ঘূর্ণিঝড় ‘আকভাান’" /&gt;&lt;/p&gt;&lt;p&gt;বঙ্গোপসাগরে ক্রমেই শক্তি বাড়িয়ে শক্তিশালী ঘূর্ণিঝড়ে রূপ নিয়েছে ‘আকভান’। এটি আরও ঘনীভূত হয়ে আগামী ২০ নভেম্বর ভারতের অন্ধ্রপ্রদেশ উপকূলে আঘাত হানতে পারে বলে পূর্বাভাস দিয়েছে দেশটির আবহাওয়া দপ্তর (আইএমডি)। আঘাত হানার সময় ঝড়টির বাতাসের সর্বোচ্চ গতিবেগ ঘণ্টায় ১৪৫ কিলোমিটার পর্যন্ত উঠতে পারে বলে আশঙ্কা কর&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a7%a7%e0%a7%aa%e0%a7%ab-%e0%a6%95%e0%a6%bf%e0%a6%ae%e0%a6%bf-%e0%a6%ac%e0%a7%87%e0%a6%97%e0%a7%87-%e0%a6%a7%e0%a7%87%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%86%e0%a6%b8%e0%a6%9b%e0%a7%87-%e0%a6%98/">জুমবাংলা</source>
    </item>
    <item>
      <title>ছেলে ৬ বিষয়ে ফেল করায় প্রধান শিক্ষককে মা’রধরের অভিযোগ বাবার বিরুদ্ধে</title>
      <link>https://zoombangla.com/%e0%a6%9b%e0%a7%87%e0%a6%b2%e0%a7%87-%e0%a7%ac-%e0%a6%ac%e0%a6%bf%e0%a6%b7%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%ab%e0%a7%87%e0%a6%b2-%e0%a6%95%e0%a6%b0%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%aa%e0%a7%8d/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%9b%e0%a7%87%e0%a6%b2%e0%a7%87-%e0%a7%ac-%e0%a6%ac%e0%a6%bf%e0%a6%b7%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%ab%e0%a7%87%e0%a6%b2-%e0%a6%95%e0%a6%b0%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%aa%e0%a7%8d/</guid>
      <pubDate>Tue, 17 Nov 2026 18:20:56 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%9B%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A7%AC-%E0%A6%AC%E0%A6%BF%E0%A6%B7%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B2.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%9B%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A7%AC-%E0%A6%AC%E0%A6%BF%E0%A6%B7%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B2.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%9B%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A7%AC-%E0%A6%AC%E0%A6%BF%E0%A6%B7%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B2.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ছেলে ৬ বিষয়ে ফেল করায় প্রধান শিক্ষককে মা’রধরের অভিযোগ বাবার বিরুদ্ধে" /&gt;&lt;/p&gt;&lt;p&gt;যশোরের ঝিকরগাছায় দশম শ্রেণির নির্বাচনী পরীক্ষায় ছেলে ছয় বিষয়ে অকৃতকার্য হওয়ায় সেন্ট লুইস মাধ্যমিক বিদ্যালয়ের প্রধান শিক্ষক ব্রাদার সঞ্চয় মাথিয়াস রোজারিওকে মা&amp;#8217;রধরের অভিযোগ উঠেছে এক অভিভাবকের বিরুদ্ধে। এ ঘটনার একটি সিসিটিভি ফুটেজ সামাজিক যোগাযোগমাধ্যমে ছড়িয়ে পড়েছে। মঙ্গলবার (১৭ নভেম্বর) বেলা সাড়&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%9b%e0%a7%87%e0%a6%b2%e0%a7%87-%e0%a7%ac-%e0%a6%ac%e0%a6%bf%e0%a6%b7%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%ab%e0%a7%87%e0%a6%b2-%e0%a6%95%e0%a6%b0%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%aa%e0%a7%8d/">জুমবাংলা</source>
    </item>
    <item>
      <title>গোপালগঞ্জে বহু দেশপ্রেমিক ও নিরীহ নাগরিক আছেন, তাদের রক্ষা করা আমাদের দায়িত্ব: বিরোধীদলীয় নেতা</title>
      <link>https://zoombangla.com/%e0%a6%97%e0%a7%8b%e0%a6%aa%e0%a6%be%e0%a6%b2%e0%a6%97%e0%a6%9e%e0%a7%8d%e0%a6%9c%e0%a7%87-%e0%a6%ac%e0%a6%b9%e0%a7%81-%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%ae%e0%a6%bf/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%97%e0%a7%8b%e0%a6%aa%e0%a6%be%e0%a6%b2%e0%a6%97%e0%a6%9e%e0%a7%8d%e0%a6%9c%e0%a7%87-%e0%a6%ac%e0%a6%b9%e0%a7%81-%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%ae%e0%a6%bf/</guid>
      <pubDate>Tue, 17 Nov 2026 18:09:47 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87%E0%A7%A7.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87%E0%A7%A7.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87%E0%A7%A7.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গোপালগঞ্জে বহু দেশপ্রেমিক ও নিরীহ নাগরিক আছেন, তাদের রক্ষা করা আমাদের দায়িত্ব: বিরোধীদলীয় নেতা" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জের টুঙ্গিপাড়ায় থানায় হামলা, অগ্নিসংযোগ ও অস্ত্র লুটপাটের ঘটনায় উদ্বেগ প্রকাশ করেছেন বিরোধীদলীয় নেতা ও জামায়াতে ইসলামীর আমির ডা. শফিকুর রহমান। তিনি বলেন, ‘গোপালগঞ্জে বহু দেশপ্রেমিক ও নিরীহ নাগরিক আছেন, তাদের রক্ষা করা আমাদের সবার দায়িত্ব।’ মঙ্গলবার (১৭ নভেম্বর) জাতীয় সংসদের অধিবেশনে বক্তব্য&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%97%e0%a7%8b%e0%a6%aa%e0%a6%be%e0%a6%b2%e0%a6%97%e0%a6%9e%e0%a7%8d%e0%a6%9c%e0%a7%87-%e0%a6%ac%e0%a6%b9%e0%a7%81-%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%ae%e0%a6%bf/">জুমবাংলা</source>
    </item>
    <item>
      <title>যুবদল নেতা নয়নের বিরুদ্ধে হামলার অভিযোগ গুরুত্ব দিয়ে দেখার আশ্বাস আইনমন্ত্রীর</title>
      <link>https://zoombangla.com/%e0%a6%af%e0%a7%81%e0%a6%ac%e0%a6%a6%e0%a6%b2-%e0%a6%a8%e0%a7%87%e0%a6%a4%e0%a6%be-%e0%a6%a8%e0%a6%af%e0%a6%bc%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%b0%e0%a7%81%e0%a6%a6%e0%a7%8d/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%af%e0%a7%81%e0%a6%ac%e0%a6%a6%e0%a6%b2-%e0%a6%a8%e0%a7%87%e0%a6%a4%e0%a6%be-%e0%a6%a8%e0%a6%af%e0%a6%bc%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%b0%e0%a7%81%e0%a6%a6%e0%a7%8d/</guid>
      <pubDate>Tue, 17 Nov 2026 18:03:29 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%A6%E0%A6%B2-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%A8%E0%A6%AF%E0%A6%BC%E0%A6%A8.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%A6%E0%A6%B2-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%A8%E0%A6%AF%E0%A6%BC%E0%A6%A8.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%A6%E0%A6%B2-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%A8%E0%A6%AF%E0%A6%BC%E0%A6%A8.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যুবদল নেতা নয়নের বিরুদ্ধে হামলার অভিযোগ গুরুত্ব দিয়ে দেখার আশ্বাস আইনমন্ত্রীর" /&gt;&lt;/p&gt;&lt;p&gt;সুপ্রিম কোর্টের আইনজীবী অ্যাডভোকেট রাহেদুল ইসলাম রঞ্জুর ওপর হামলার ঘটনায় যুবদল নেতা রবিউল ইসলাম নয়নের বিরুদ্ধে ওঠা অভিযোগ গুরুত্ব দিয়ে দেখার আশ্বাস দিয়েছেন আইনমন্ত্রী মো. আসাদুজ্জামান। তিনি বলেছেন, বিরোধী দলের সংসদ সদস্য মোহাম্মদ নাজিবুর রহমান মোমেন বিষয়টি সংসদে উত্থাপন করেছেন। সরকার বিষয়টি গুরুত্ব &lt;/p&gt;</description>

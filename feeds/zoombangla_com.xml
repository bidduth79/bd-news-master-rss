    <item>
      <title>ইমাম-মুয়াজ্জিন ও পুরোহিতদের জন্য সুখবর</title>
      <link>https://zoombangla.com/%e0%a6%87%e0%a6%ae%e0%a6%be%e0%a6%ae-%e0%a6%ae%e0%a7%81%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%9c%e0%a7%8d%e0%a6%9c%e0%a6%bf%e0%a6%a8-%e0%a6%93/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%87%e0%a6%ae%e0%a6%be%e0%a6%ae-%e0%a6%ae%e0%a7%81%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%9c%e0%a7%8d%e0%a6%9c%e0%a6%bf%e0%a6%a8-%e0%a6%93/</guid>
      <pubDate>Fri, 27 Nov 2026 16:00:20 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Imam-1.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Imam-1.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Imam-1.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইমাম-মুয়াজ্জিন ও পুরোহিতদের জন্য সুখবর" /&gt;&lt;/p&gt;&lt;p&gt;দেশের মসজিদ, মন্দির, গির্জা ও বৌদ্ধবিহারে কর্মরত ধর্মীয় নেতা ও সেবাকর্মীদের মাসিক সম্মানী দিচ্ছে সরকার। এ কর্মসূচির আওতায় চলতি অর্থবছরে ৮৬ হাজার ৭০৯টি ধর্মীয় প্রতিষ্ঠানের ২ লাখ ৫৬ হাজার ৭৪ জন সম্মানী পাবেন। এ জন্য ২০২৬-২৭ অর্থবছরে ১ হাজার ১০০ কোটি টাকা বরাদ্দ রাখা হয়েছে। আগামী ২ ডিসেম্বর কুষ্টিয়া সদ&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%87%e0%a6%ae%e0%a6%be%e0%a6%ae-%e0%a6%ae%e0%a7%81%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%9c%e0%a7%8d%e0%a6%9c%e0%a6%bf%e0%a6%a8-%e0%a6%93/">জুমবাংলা</source>
    </item>
    <item>
      <title>কৃষিকে উদ্যোক্তা ও বাজারমুখী করতে আসছে ১৪ হাজার কোটি টাকার প্রকল্প</title>
      <link>https://zoombangla.com/%e0%a6%95%e0%a7%83%e0%a6%b7%e0%a6%bf%e0%a6%95%e0%a7%87-%e0%a6%89%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a7%8b%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%be-%e0%a6%93/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%95%e0%a7%83%e0%a6%b7%e0%a6%bf%e0%a6%95%e0%a7%87-%e0%a6%89%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a7%8b%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%be-%e0%a6%93/</guid>
      <pubDate>Fri, 27 Nov 2026 15:57:28 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/Dhan.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/Dhan.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/Dhan.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কৃষিকে উদ্যোক্তা ও বাজারমুখী করতে আসছে ১৪ হাজার কোটি টাকার প্রকল্প" /&gt;&lt;/p&gt;&lt;p&gt;দেশের কৃষি খাতকে প্রচলিত উৎপাদননির্ভর ব্যবস্থা থেকে উদ্যোক্তা ও বাজারমুখী কাঠামোয় রূপান্তরের উদ্যোগ নিয়েছে সরকার। এ লক্ষ্যে প্রায় ১৪ হাজার কোটি টাকার একটি প্রকল্প গ্রহণের প্রাথমিক পরিকল্পনা করা হচ্ছে। ‘বাংলাদেশ এগ্রি এন্টারপ্রেনারশিপ প্রজেক্ট’ (বিএপি) নামের এ প্রকল্পের আওতায় কৃষি, প্রাণিসম্পদ ও মৎস্&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%95%e0%a7%83%e0%a6%b7%e0%a6%bf%e0%a6%95%e0%a7%87-%e0%a6%89%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a7%8b%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%be-%e0%a6%93/">জুমবাংলা</source>
    </item>
    <item>
      <title>অভিনয়ে শতাব্দী রায়ের কন্যা</title>
      <link>https://zoombangla.com/%e0%a6%85%e0%a6%ad%e0%a6%bf%e0%a6%a8%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%b6%e0%a6%a4%e0%a6%be%e0%a6%ac%e0%a7%8d%e0%a6%a6%e0%a7%80/</link>

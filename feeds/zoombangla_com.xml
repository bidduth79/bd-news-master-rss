    <item>
      <title>খাদ্যনিরাপত্তা নিশ্চিত করাই সরকারের লক্ষ্য: খাদ্যমন্ত্রী</title>
      <link>https://zoombangla.com/%e0%a6%96%e0%a6%be%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a6%a8%e0%a6%bf%e0%a6%b0%e0%a6%be%e0%a6%aa%e0%a6%a4%e0%a7%8d%e0%a6%a4%e0%a6%be-%e0%a6%a8%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%9a%e0%a6%bf%e0%a6%a4-%e0%a6%95/</link>
      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%96%e0%a6%be%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a6%a8%e0%a6%bf%e0%a6%b0%e0%a6%be%e0%a6%aa%e0%a6%a4%e0%a7%8d%e0%a6%a4%e0%a6%be-%e0%a6%a8%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%9a%e0%a6%bf%e0%a6%a4-%e0%a6%95/</guid>
      <pubDate>Sat, 14 Nov 2026 13:43:18 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/IMG_20261114_194225.jpg" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/IMG_20261114_194225.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://zoombangla.com/wp-content/uploads/2026/11/IMG_20261114_194225.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="খাদ্যনিরাপত্তা নিশ্চিত করাই সরকারের লক্ষ্য: খাদ্যমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;সাইফুল ইসলাম: কৃষকের উৎপাদিত ধানের ন্যায্যমূল্য নিশ্চিত করা, সরকারি খাদ্য মজুত বাড়ানো এবং সাধারণ মানুষের ক্রয়ক্ষমতার মধ্যে নিরাপদ ও পুষ্টিকর খাবার পৌঁছে দেওয়াই সরকারের মূল লক্ষ্য বলে জানিয়েছেন খাদ্যমন্ত্রী আফরোজা খানম রিতা। তিনি বলেন, খাদ্যনিরাপত্তা কেবল খাদ্য উৎপাদনের মধ্যে সীমাবদ্ধ নয়। দেশের প্রতি&lt;/p&gt;</description>
      <source url="https://zoombangla.com/%e0%a6%96%e0%a6%be%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a6%a8%e0%a6%bf%e0%a6%b0%e0%a6%be%e0%a6%aa%e0%a6%a4%e0%a7%8d%e0%a6%a4%e0%a6%be-%e0%a6%a8%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%9a%e0%a6%bf%e0%a6%a4-%e0%a6%95/">জুমবাংলা</source>
    </item>

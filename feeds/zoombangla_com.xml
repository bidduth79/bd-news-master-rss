      <guid isPermaLink="true">https://zoombangla.com/%e0%a6%a8%e0%a6%be%e0%a6%b0%e0%a7%80-%e0%a6%aa%e0%a7%81%e0%a6%b2%e0%a6%bf%e0%a6%b6-%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%a4%e0%a6%be/</guid>
      <pubDate>Thu, 12 Nov 2026 18:20:05 +0000</pubDate>
      <enclosure url="https://zoombangla.com/wp-content/uploads/2026/11/নারী-পুলিশ-কর্মকর্তা.webp" length="0" type="image/jpeg" />
      <media:content url="https://zoombangla.com/wp-content/uploads/2026/11/নারী-পুলিশ-কর্মকর্তা.webp" medium="image" />

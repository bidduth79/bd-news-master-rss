    <item>
      <title>ঢাকা, গাজীপুর ও নারায়ণগঞ্জে ৩৪ প্লাটুন বিজিবি মোতায়েন</title>
      <link>https://www.dhakanews24.com/%e0%a6%a2%e0%a6%be%e0%a6%95%e0%a6%be-%e0%a6%97%e0%a6%be%e0%a6%9c%e0%a7%80%e0%a6%aa%e0%a7%81%e0%a6%b0-%e0%a6%93-%e0%a6%a8%e0%a6%be%e0%a6%b0%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a6%a3%e0%a6%97%e0%a6%9e/</link>
      <guid isPermaLink="true">https://www.dhakanews24.com/%e0%a6%a2%e0%a6%be%e0%a6%95%e0%a6%be-%e0%a6%97%e0%a6%be%e0%a6%9c%e0%a7%80%e0%a6%aa%e0%a7%81%e0%a6%b0-%e0%a6%93-%e0%a6%a8%e0%a6%be%e0%a6%b0%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a6%a3%e0%a6%97%e0%a6%9e/</guid>
      <pubDate>Sat, 14 Nov 2026 06:26:20 +0000</pubDate>
      <description>শিল্পাঞ্চলের সার্বিক নিরাপত্তা নিশ্চিত করা, আইনশৃঙ্খলা পরিস্থিতি স্বাভাবিক রাখা এবং যেকোনো অপ্রীতিকর পরিস্থিতি মোকাবিলায় ঢাকা, গাজীপুর ও নারায়ণগঞ্জের বিভিন্ন গুরুত্বপূর্ণ শিল্পাঞ্চলে ৩৪ প্লাটুন বর্ডার গার্ড বাংলাদেশ (বিজিবি) মোতায়েন করা হয়েছে। মোতায়েন করা বিজিবি সদস্যরা ঢাকা জেলার সাভার, আশুলিয়া, হে</description>
      <source url="https://www.dhakanews24.com/%e0%a6%a2%e0%a6%be%e0%a6%95%e0%a6%be-%e0%a6%97%e0%a6%be%e0%a6%9c%e0%a7%80%e0%a6%aa%e0%a7%81%e0%a6%b0-%e0%a6%93-%e0%a6%a8%e0%a6%be%e0%a6%b0%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a6%a3%e0%a6%97%e0%a6%9e/">Dhaka News 24</source>
    </item>
    <item>
      <title>মহাসড়ক অবরোধ করে পোশাক শ্রমিকদের বিক্ষোভ</title>
      <link>https://www.dhakanews24.com/%e0%a6%ae%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%a1%e0%a6%bc%e0%a6%95-%e0%a6%85%e0%a6%ac%e0%a6%b0%e0%a7%8b%e0%a6%a7-%e0%a6%95%e0%a6%b0%e0%a7%87-%e0%a6%aa%e0%a7%8b%e0%a6%b6%e0%a6%be%e0%a6%95-%e0%a6%b6/</link>

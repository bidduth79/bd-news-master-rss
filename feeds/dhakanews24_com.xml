    <item>
      <title>রাষ্ট্রপতির সঙ্গে তিন বাহিনী প্রধানের সৌজন্য সাক্ষাৎ</title>
      <link>https://www.dhakanews24.com/%e0%a6%b0%e0%a6%be%e0%a6%b7%e0%a7%8d%e0%a6%9f%e0%a7%8d%e0%a6%b0%e0%a6%aa%e0%a6%a4%e0%a6%bf%e0%a6%b0-%e0%a6%b8%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%87-%e0%a6%a4%e0%a6%bf%e0%a6%a8-%e0%a6%ac%e0%a6%be-2/</link>

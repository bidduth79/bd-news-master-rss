    <item>
      <title>রায়পুরে গ্রামীণ ব্যাংকের ফটকে আগুন, ছাত্রলীগ নেতা আটক</title>
      <link>https://www.dhakanews24.com/%e0%a6%b0%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87-%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ae%e0%a7%80%e0%a6%a3-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95%e0%a7%87/</link>

    <item>
      <title>ঢাকায় মরক্কোর ঐতিহাসিক ‘গ্লোরিয়াস গ্রিন মার্চ’ এর ৫১তম বার্ষিকী পালিত</title>
      <link>https://www.dhakanews24.com/%e0%a6%a2%e0%a6%be%e0%a6%95%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%ae%e0%a6%b0%e0%a6%95%e0%a7%8d%e0%a6%95%e0%a7%8b%e0%a6%b0-%e0%a6%90%e0%a6%a4%e0%a6%bf%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%95/</link>
      <guid isPermaLink="true">https://www.dhakanews24.com/%e0%a6%a2%e0%a6%be%e0%a6%95%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%ae%e0%a6%b0%e0%a6%95%e0%a7%8d%e0%a6%95%e0%a7%8b%e0%a6%b0-%e0%a6%90%e0%a6%a4%e0%a6%bf%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%95/</guid>
      <pubDate>Tue, 17 Nov 2026 12:17:52 +0000</pubDate>
      <description>কূটনৈতিক প্রতিবেদক: ঢাকায় মরক্কোর ঐতিহাসিক ‘গ্লোরিয়াস গ্রিন মার্চ’-এর ৫১তম বার্ষিকী উদযাপন করা হয়েছে। এ উপলক্ষে আয়োজিত সংবর্ধনা অনুষ্ঠানে দেশটির ইতিহাস, ঐতিহ্য, সংস্কৃতি ও দুই দেশের বন্ধুত্বপূর্ণ সম্পর্কের বিভিন্ন দিক তুলে ধরা হয়। সোমবার (১৬ নভেম্বর) রাজধানীর ওয়েস্টিন হোটেলে বাংলাদেশে নিযুক্ত মরক্কো</description>
      <source url="https://www.dhakanews24.com/%e0%a6%a2%e0%a6%be%e0%a6%95%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%ae%e0%a6%b0%e0%a6%95%e0%a7%8d%e0%a6%95%e0%a7%8b%e0%a6%b0-%e0%a6%90%e0%a6%a4%e0%a6%bf%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%95/">Dhaka News 24</source>
    </item>

    </item>
    <item>
      <title>অ্যান্টিবায়োটিক ব্যবহারে সচেতনতা বাড়াতে গণবিজ্ঞপ্তি</title>
      <link>https://www.dhakanews24.com/%e0%a6%94%e0%a6%b7%e0%a6%a7-%e0%a6%93-%e0%a6%95%e0%a6%b8%e0%a6%ae%e0%a7%87%e0%a6%9f%e0%a6%bf%e0%a6%95%e0%a6%b8-%e0%a6%86%e0%a6%87%e0%a6%a8-%e0%a6%85%e0%a6%a8%e0%a7%81%e0%a6%af%e0%a6%be%e0%a6%af/</link>

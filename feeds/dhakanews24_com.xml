    <item>
      <title>দক্ষিণ গফরগাঁওয়ে কৃষি প্রণোদনার সার-বীজ বিতরণ</title>
      <link>https://www.dhakanews24.com/%e0%a6%a6%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%bf%e0%a6%a3-%e0%a6%97%e0%a6%ab%e0%a6%b0%e0%a6%97%e0%a6%be%e0%a6%81%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%95%e0%a7%83%e0%a6%b7%e0%a6%bf-%e0%a6%aa/</link>

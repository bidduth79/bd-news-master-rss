    <item>
      <title>সাত জেলায় ৯৫ প্লাটুন বিজিবি মোতায়েন</title>
      <link>https://www.dhakanews24.com/%e0%a6%b8%e0%a6%be%e0%a6%a4-%e0%a6%9c%e0%a7%87%e0%a6%b2%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a7%af%e0%a7%ab-%e0%a6%aa%e0%a7%8d%e0%a6%b2%e0%a6%be%e0%a6%9f%e0%a7%81%e0%a6%a8-%e0%a6%ac%e0%a6%bf%e0%a6%9c/</link>

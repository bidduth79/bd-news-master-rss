    <item>
      <title>চাঁদপুরে আওয়ামী লীগ নেতা অ্যাডভোকেট মজিবুর রহমান গ্রেপ্তার</title>
      <link>https://www.dhakanews24.com/%e0%a6%9a%e0%a6%be%e0%a6%81%e0%a6%a6%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87-%e0%a6%86%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%ae%e0%a7%80-%e0%a6%b2%e0%a7%80%e0%a6%97-%e0%a6%a8%e0%a7%87%e0%a6%a4/</link>

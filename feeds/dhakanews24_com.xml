    <item>
      <title>চার ফ্লাইট দিয়ে চালু হবে শাহজালালের তৃতীয় টার্মিনাল</title>
      <link>https://www.dhakanews24.com/%e0%a6%9a%e0%a6%be%e0%a6%b0-%e0%a6%ab%e0%a7%8d%e0%a6%b2%e0%a6%be%e0%a6%87%e0%a6%9f-%e0%a6%a6%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%9a%e0%a6%be%e0%a6%b2%e0%a7%81-%e0%a6%b9%e0%a6%ac%e0%a7%87/</link>

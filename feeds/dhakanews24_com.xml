    <item>
      <title>ঢাকা বিশ্ববিদ্যালয়ে যান চলাচল ও বহিরাগত প্রবেশে কড়াকড়ি</title>
      <link>https://www.dhakanews24.com/%e0%a6%a2%e0%a6%be%e0%a6%95%e0%a6%be-%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%ac%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%b2%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%af%e0%a6%be%e0%a6%a8/</link>

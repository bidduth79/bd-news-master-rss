    <item>
      <title>সওজ অতিরিক্ত প্রধান প্রকৌশলী আজাদ রহমান আইইবি-এর ভাইস-প্রেসিডেন্ট নির্বাচিত</title>
      <link>https://www.dhakanews24.com/%e0%a6%b8%e0%a6%93%e0%a6%9c-%e0%a6%8f%e0%a6%b8%e0%a6%bf%e0%a6%87-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%95%e0%a7%8c%e0%a6%b6%e0%a6%b2%e0%a7%80-%e0%a6%86%e0%a6%9c%e0%a6%be%e0%a6%a6-%e0%a6%b0%e0%a6%b9/</link>

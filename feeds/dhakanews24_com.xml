    </item>
    <item>
      <title>ভারত-পাকিস্তান-শ্রীলঙ্কাকে পেছনে ফেলে বাংলাদেশের নতুন ইতিহাস</title>
      <link>https://www.dhakanews24.com/%e0%a6%ad%e0%a6%be%e0%a6%b0%e0%a6%a4-%e0%a6%aa%e0%a6%be%e0%a6%95%e0%a6%bf%e0%a6%b8%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%a8-%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a7%80%e0%a6%b2%e0%a6%99%e0%a7%8d%e0%a6%95%e0%a6%be/</link>
      <guid isPermaLink="true">https://www.dhakanews24.com/%e0%a6%ad%e0%a6%be%e0%a6%b0%e0%a6%a4-%e0%a6%aa%e0%a6%be%e0%a6%95%e0%a6%bf%e0%a6%b8%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%a8-%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a7%80%e0%a6%b2%e0%a6%99%e0%a7%8d%e0%a6%95%e0%a6%be/</guid>
      <pubDate>Tue, 17 Nov 2026 09:03:04 +0000</pubDate>
      <description>নিউজ ডেস্ক:   দক্ষিণ আফ্রিকার মাটিতে টেস্টে নতুন ইতিহাস গড়েছে বাংলাদেশ। জোহানেসবার্গ টেস্টের প্রথম ইনিংসে ৪০০ রান করেছে টাইগাররা। এতে এশিয়ার প্রথম দল হিসেবে দক্ষিণ আফ্রিকার মাটিতে টেস্ট সিরিজের প্রথম ইনিংসে ৪০০ রান করার কীর্তি গড়েছে লাল-সবুজের প্রতিনিধিরা। এই কীর্তি গড়তে বড় অবদান রেখেছেন তাওহীদ হৃদয়</description>
      <source url="https://www.dhakanews24.com/%e0%a6%ad%e0%a6%be%e0%a6%b0%e0%a6%a4-%e0%a6%aa%e0%a6%be%e0%a6%95%e0%a6%bf%e0%a6%b8%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%a8-%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a7%80%e0%a6%b2%e0%a6%99%e0%a7%8d%e0%a6%95%e0%a6%be/">Dhaka News 24</source>
    </item>

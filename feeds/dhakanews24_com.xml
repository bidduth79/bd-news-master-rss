    <item>
      <title>নির্মাণশিল্পে অবদানের স্বীকৃতি-সম্মাননা দিল আকিজ রেডিমিক্স</title>
      <link>https://www.dhakanews24.com/%e0%a6%a8%e0%a6%bf%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a6%be%e0%a6%a3%e0%a6%b6%e0%a6%bf%e0%a6%b2%e0%a7%8d%e0%a6%aa%e0%a7%87-%e0%a6%85%e0%a6%ac%e0%a6%a6%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a7%8d/</link>

    <item>
      <title>নিষেধাজ্ঞা দিয়েও পাকিস্তানি নাটক থেকে দূরে রাখা যাচ্ছে না ভারতীয়দের</title>
      <link>https://www.dhakanews24.com/%e0%a6%a8%e0%a6%bf%e0%a6%b7%e0%a7%87%e0%a6%a7%e0%a6%be%e0%a6%9c%e0%a7%8d%e0%a6%9e%e0%a6%be-%e0%a6%a6%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%93-%e0%a6%aa%e0%a6%be%e0%a6%95%e0%a6%bf%e0%a6%b8%e0%a7%8d/</link>

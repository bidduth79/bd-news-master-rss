    </item>
    <item>
      <title>গঙ্গার পানি বণ্টন নিয়ে আজ ঢাকায় বাংলাদেশ-ভারত বৈঠক</title>
      <link>https://www.dhakanews24.com/%e0%a6%97%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a6%be%e0%a6%b0-%e0%a6%aa%e0%a6%be%e0%a6%a8%e0%a6%bf-%e0%a6%ac%e0%a6%a3%e0%a7%8d%e0%a6%9f%e0%a6%a8-%e0%a6%a8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%86/</link>

    <item>
      <title>গ্রাম পুলিশ মহাসমাবেশে আসার পথে দুই সদস্যের মৃত্যু, পরিবার পাবে ৩ লাখ টাকা ও চাকরি</title>
      <link>https://www.dhakanews24.com/%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ae-%e0%a6%aa%e0%a7%81%e0%a6%b2%e0%a6%bf%e0%a6%b6-%e0%a6%ae%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%ae%e0%a6%be%e0%a6%ac%e0%a7%87%e0%a6%b6%e0%a7%87-%e0%a6%86/</link>

    <item>
      <title>লক্ষ্মীপুরে জাতীয় পরিসংখ্যান দিবস পালিত, বাল্যবিবাহের হার ৫০.৯ শতাংশ</title>
      <link>https://www.dhakanews24.com/%e0%a6%b2%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a7%8d%e0%a6%ae%e0%a7%80%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87-%e0%a6%9c%e0%a6%be%e0%a6%a4%e0%a7%80%e0%a6%af%e0%a6%bc-%e0%a6%aa%e0%a6%b0%e0%a6%bf%e0%a6%b8%e0%a6%82/</link>

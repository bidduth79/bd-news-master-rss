    <item>
      <title>বায়ুসেনা থেকে চলচ্চিত্র, উমাশঙ্কর যাদবের বহুমুখী যাত্রা</title>
      <link>https://www.dhakanews24.com/%e0%a6%ac%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a7%81%e0%a6%b8%e0%a7%87%e0%a6%a8%e0%a6%be-%e0%a6%a5%e0%a7%87%e0%a6%95%e0%a7%87-%e0%a6%9a%e0%a6%b2%e0%a6%9a%e0%a7%8d%e0%a6%9a%e0%a6%bf%e0%a6%a4%e0%a7%8d%e0%a6%b0/</link>

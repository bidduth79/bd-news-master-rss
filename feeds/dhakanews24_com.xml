    <item>
      <title>ঢাকা-গোপালগঞ্জসহ সাত জেলায় ১২০ প্লাটুন বিজিবি মোতায়েন</title>
      <link>https://www.dhakanews24.com/%e0%a6%a2%e0%a6%be%e0%a6%95%e0%a6%be-%e0%a6%97%e0%a7%8b%e0%a6%aa%e0%a6%be%e0%a6%b2%e0%a6%97%e0%a6%9e%e0%a7%8d%e0%a6%9c%e0%a6%b8%e0%a6%b9-%e0%a6%b8%e0%a6%be%e0%a6%a4-%e0%a6%9c%e0%a7%87%e0%a6%b2/</link>
      <guid isPermaLink="true">https://www.dhakanews24.com/%e0%a6%a2%e0%a6%be%e0%a6%95%e0%a6%be-%e0%a6%97%e0%a7%8b%e0%a6%aa%e0%a6%be%e0%a6%b2%e0%a6%97%e0%a6%9e%e0%a7%8d%e0%a6%9c%e0%a6%b8%e0%a6%b9-%e0%a6%b8%e0%a6%be%e0%a6%a4-%e0%a6%9c%e0%a7%87%e0%a6%b2/</guid>
      <pubDate>Sat, 28 Nov 2026 06:36:45 +0000</pubDate>
      <description>আইন-শৃঙ্খলা পরিস্থিতি নিয়ন্ত্রণ ও জননিরাপত্তা নিশ্চিত করতে ঢাকা, গাজীপুর, গোপালগঞ্জসহ বিভিন্ন জেলায় ১২০ প্লাটুন বর্ডার গার্ড বাংলাদেশ (বিজিবি) মোতায়েন করা হয়েছে। পরিস্থিতি বিবেচনায় অতিরিক্ত চার প্লাটুন সদস্যকেও প্রস্তুত রাখা হয়েছে। শনিবার (২৮ নভেম্বর) বিজিবির এক সংবাদ বিজ্ঞপ্তিতে মোতায়েনের এ তথ্য জা</description>
      <source url="https://www.dhakanews24.com/%e0%a6%a2%e0%a6%be%e0%a6%95%e0%a6%be-%e0%a6%97%e0%a7%8b%e0%a6%aa%e0%a6%be%e0%a6%b2%e0%a6%97%e0%a6%9e%e0%a7%8d%e0%a6%9c%e0%a6%b8%e0%a6%b9-%e0%a6%b8%e0%a6%be%e0%a6%a4-%e0%a6%9c%e0%a7%87%e0%a6%b2/">Dhaka News 24</source>
    </item>
    <item>
      <title>বিদেশি বিনিয়োগ আকর্ষণে ১.২৫ শতাংশ প্রণোদনা পাবেন বাংলাদেশিরা</title>
      <link>https://www.dhakanews24.com/%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a6%bf-%e0%a6%ac%e0%a6%bf%e0%a6%a8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%8b%e0%a6%97-%e0%a6%86%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%b7%e0%a6%a3%e0%a7%87/</link>

    <item>
      <title>আহত আনসার সদস্যদের দেখতে হাসপাতালে মহাপরিচালক</title>
      <link>https://www.dhakanews24.com/%e0%a6%86%e0%a6%b9%e0%a6%a4-%e0%a6%86%e0%a6%a8%e0%a6%b8%e0%a6%be%e0%a6%b0-%e0%a6%b8%e0%a6%a6%e0%a6%b8%e0%a7%8d%e0%a6%af%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%a6%e0%a7%87%e0%a6%96%e0%a6%a4%e0%a7%87/</link>
      <guid isPermaLink="true">https://www.dhakanews24.com/%e0%a6%86%e0%a6%b9%e0%a6%a4-%e0%a6%86%e0%a6%a8%e0%a6%b8%e0%a6%be%e0%a6%b0-%e0%a6%b8%e0%a6%a6%e0%a6%b8%e0%a7%8d%e0%a6%af%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%a6%e0%a7%87%e0%a6%96%e0%a6%a4%e0%a7%87/</guid>
      <pubDate>Sat, 28 Nov 2026 17:11:39 +0000</pubDate>
      <enclosure url="https://www.dhakanews24.com/wp-content/uploads/2026/11/sar-300x196.png" length="0" type="image/jpeg" />
      <media:content url="https://www.dhakanews24.com/wp-content/uploads/2026/11/sar-300x196.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.dhakanews24.com/wp-content/uploads/2026/11/sar-300x196.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আহত আনসার সদস্যদের দেখতে হাসপাতালে মহাপরিচালক" /&gt;&lt;/p&gt;&lt;p&gt;ঢাকা নিউজ ডেস্ক:গাজীপুরের শালনায় পোশাক শ্রমিকদের আন্দোলন ও সড়ক অবরোধ চলাকালে নিরাপত্তার দায়িত্ব পালন করতে গিয়ে দুষ্কৃতকারীদের পরিকল্পিত ও আকস্মিক হামলায় আহত বাংলাদেশ আনসার ও গ্রাম প্রতিরক্ষা বাহিনীর ৩ জন কর্মকর্তা ও ৬ জন আনসার ব্যাটালিয়ন সদস্যকে দেখতে আজ শনিবার আনসার-ভিডিপি হাসপাতাল পরিদর্শন করেন বা&lt;/p&gt;</description>
      <source url="https://www.dhakanews24.com/%e0%a6%86%e0%a6%b9%e0%a6%a4-%e0%a6%86%e0%a6%a8%e0%a6%b8%e0%a6%be%e0%a6%b0-%e0%a6%b8%e0%a6%a6%e0%a6%b8%e0%a7%8d%e0%a6%af%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%a6%e0%a7%87%e0%a6%96%e0%a6%a4%e0%a7%87/">Dhaka News 24</source>
    </item>

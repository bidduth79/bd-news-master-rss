    <item>
      <title>পার্বত্য চট্টগ্রামে সাম্প্রদায়িক সম্প্রীতি নষ্টের ষড়যন্ত্র রুখে দিতে হবে: পার্বত্য চট্টগ্রাম বিষয়ক মন্ত্রী</title>
      <link>https://www.dhakanews24.com/%e0%a6%aa%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%ac%e0%a6%a4%e0%a7%8d%e0%a6%af-%e0%a6%9a%e0%a6%9f%e0%a7%8d%e0%a6%9f%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ae%e0%a7%87-%e0%a6%b8%e0%a6%be%e0%a6%ae%e0%a7%8d/</link>

    <item>
      <title>ঢাবি ভর্তির আবেদন শেষ হচ্ছে ২৮ নভেম্বর</title>
      <link>https://www.dhakanews24.com/%e0%a6%a2%e0%a6%be%e0%a6%ac%e0%a6%bf-%e0%a6%ad%e0%a6%b0%e0%a7%8d%e0%a6%a4%e0%a6%bf%e0%a6%b0-%e0%a6%86%e0%a6%ac%e0%a7%87%e0%a6%a6%e0%a6%a8-%e0%a6%b6%e0%a7%87%e0%a6%b7-%e0%a6%b9%e0%a6%9a%e0%a7%8d/</link>

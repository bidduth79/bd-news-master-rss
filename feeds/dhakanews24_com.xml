    <item>
      <title>টুঙ্গিপাড়া থানার কার্যক্রম বন্ধ</title>
      <link>https://www.dhakanews24.com/%e0%a6%9f%e0%a7%81%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a6%bf%e0%a6%aa%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a6%be-%e0%a6%a5%e0%a6%be%e0%a6%a8%e0%a6%be%e0%a6%b0-%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%95/</link>

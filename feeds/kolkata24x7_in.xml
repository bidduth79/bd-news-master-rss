      <guid isPermaLink="true">https://kolkata24x7.in/india/govt-may-delink-delimitation-from-census/</guid>
      <pubDate>Fri, 27 Nov 2026 06:13:16 +0000</pubDate>
      <enclosure url="https://kolkata24x7.in/wp-content/uploads/2026/11/loksabha2.jpg" length="0" type="image/jpeg" />

      <link>https://kolkata24x7.in/india/jaish-operative-mobile-terror-training-videos-pakistan-handler/</link>
      <guid isPermaLink="true">https://kolkata24x7.in/india/jaish-operative-mobile-terror-training-videos-pakistan-handler/</guid>
      <pubDate>Sat, 28 Nov 2026 07:01:44 +0000</pubDate>
      <enclosure url="https://kolkata24x7.in/wp-content/uploads/2026/11/anti-terrorist.jpg" length="0" type="image/jpeg" />

      <guid isPermaLink="true">https://kolkata24x7.in/north-east-india/tripura-high-court-tribal-land-restoration-claims-before-january-1969%e0%a7%a7%e0%a7%af%e0%a7%ac%e0%a7%af-%e0%a6%8f%e0%a6%b0-%e0%a6%86%e0%a6%97%e0%a7%87-%e0%a6%b9%e0%a6%b8%e0%a7%8d%e0%a6%a4%e0%a6%be/</guid>
      <pubDate>Tue, 17 Nov 2026 22:15:44 +0000</pubDate>
      <enclosure url="https://kolkata24x7.in/wp-content/uploads/2026/11/tripura-high-court-tribal-land-restoration-claims-before-january-1969.jpg" length="0" type="image/jpeg" />
      <media:content url="https://kolkata24x7.in/wp-content/uploads/2026/11/tripura-high-court-tribal-land-restoration-claims-before-january-1969.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://kolkata24x7.in/wp-content/uploads/2026/11/tripura-high-court-tribal-land-restoration-claims-before-january-1969.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="১৯৬৯-এর আগের জমি ফেরতের দাবি খারিজ, ত্রিপুরা হাইকোর্টের রায়" /&gt;&lt;/p&gt;&lt;p&gt;আগরতলা: ১৯৬৯ সালের জানুয়ারির আগে অ-জনজাতিদের হাতে হস্তান্তরিত বা তাঁদের দখলে চলে যাওয়া জনজাতি জমি (Tribal Land Rights) ফেরত পাওয়ার আবেদন খারিজ করল ত্রিপুরা হাইকোর্ট।&amp;#8230;&lt;/p&gt;</description>

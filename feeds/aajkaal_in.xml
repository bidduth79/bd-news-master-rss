    <item>
      <title>২০ লক্ষ টাকার অধিক মূল্যের বেশি কয়েক কেজি গাঁজা উদ্ধার শিয়ালদহ স্টেশন চত্বরে, গ্রেপ্তার দুই মহিলা-সহ চার</title>
      <link>https://www.aajkaal.in/kolkata/several-kilograms-of-cannabis-valued-at-over-20-lakh-rupees-seized-in-the-sealdah-station-area-521174</link>
      <guid isPermaLink="true">https://www.aajkaal.in/kolkata/several-kilograms-of-cannabis-valued-at-over-20-lakh-rupees-seized-in-the-sealdah-station-area-521174</guid>
      <pubDate>Thu, 19 Nov 2026 21:30:00 +0530</pubDate>
      <enclosure url="https://cdn.aajkaal.in/uploads/images/2026/11/19/9a5c11fd-0c0c-4fa2-b4c3-8526bc54e126.webp" length="0" type="image/jpeg" />

      <link>https://www.aajkaal.in/sports/glenn-phillips-reveal-cheat-code-against-jasprit-bumrah-after-end-of-second-day-s-play-at-wellington-521287</link>
      <guid isPermaLink="true">https://www.aajkaal.in/sports/glenn-phillips-reveal-cheat-code-against-jasprit-bumrah-after-end-of-second-day-s-play-at-wellington-521287</guid>
      <pubDate>Fri, 20 Nov 2026 21:20:00 +0530</pubDate>
      <enclosure url="https://cdn.aajkaal.in/uploads/images/2026/11/20/3db1cc2f-7c07-4f5c-a92e-d36af32a3784.webp" length="0" type="image/jpeg" />
      <media:content url="https://cdn.aajkaal.in/uploads/images/2026/11/20/3db1cc2f-7c07-4f5c-a92e-d36af32a3784.webp" medium="image" />

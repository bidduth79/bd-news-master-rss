      <enclosure url="https://cdn.aajkaal.in/uploads/images/2026/11/25/6dd3eaa7-8d91-4988-aa25-0b07e3bbfae7.webp" length="0" type="image/jpeg" />
      <media:content url="https://cdn.aajkaal.in/uploads/images/2026/11/25/6dd3eaa7-8d91-4988-aa25-0b07e3bbfae7.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.aajkaal.in/uploads/images/2026/11/25/6dd3eaa7-8d91-4988-aa25-0b07e3bbfae7.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="'রাজবংশীদের জমি বাংলাদেশিদের হাতে তুলে দিয়েছিল সিপিআইএম', কোচবিহারে গিয়ে বামেদের নিশানা শুভেন্দুর" /&gt;&lt;/p&gt;&lt;p&gt;রাজবংশী ও কামতাপুরী সম্প্রদায়ের মানুষের জমি হারানোর অভিযোগকে সামনে রেখে ফের বামেদের বিরুদ্ধে আক্রমণ শানালেন মুখ্যমন্ত্রী শুভেন্দু অধিকারী।&lt;/p&gt;</description>

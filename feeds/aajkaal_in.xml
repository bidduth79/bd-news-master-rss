    <item>
      <title>এবার পেত্নী-র চরিত্রে ‘লাপতা লেডিজ’ খ্যাত নিতাংশি? কোন বিতর্কে দীপিকার পাশে দাঁড়ালেন আলিয়া?</title>
      <link>https://www.aajkaal.in/entertainment/top-entertainment-news-nitanshi-goel-enters-the-horror-comedy-world-with-hero-ki-horrorine-521182</link>
      <guid isPermaLink="true">https://www.aajkaal.in/entertainment/top-entertainment-news-nitanshi-goel-enters-the-horror-comedy-world-with-hero-ki-horrorine-521182</guid>
      <pubDate>Fri, 20 Nov 2026 00:48:00 +0530</pubDate>
      <enclosure url="https://cdn.aajkaal.in/uploads/images/2026/11/20/84c8fc08-2b95-4b89-928c-feb0c4c30bc1.webp" length="0" type="image/jpeg" />

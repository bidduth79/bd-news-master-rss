    </item>
    <item>
      <title>প্রশ্নবাণ এবার দর্শকদেরই হাতে! নতুন রূপে ‘খেলো বাংলা’য় আসছেন সৌরভ</title>
      <link>https://www.aajkaal.in/entertainment/sourav-ganguly-is-ready-to-host-new-game-show-of-star-jalsha-khelo-bangla-521127</link>
      <guid isPermaLink="true">https://www.aajkaal.in/entertainment/sourav-ganguly-is-ready-to-host-new-game-show-of-star-jalsha-khelo-bangla-521127</guid>
      <pubDate>Thu, 19 Nov 2026 15:49:00 +0530</pubDate>
      <enclosure url="https://cdn.aajkaal.in/uploads/images/2026/11/19/75c6b7e4-8a50-41f6-bf91-a5a996d949c1.webp" length="0" type="image/jpeg" />

      <pubDate>Sat, 25 Jun 2016 18:00:47 +0000</pubDate>
      <description>&amp;#160; শেখ মিরাজুল ইসলাম &amp;#160; শুধুমাত্র সমগ্র ঢাকা ও ঢাকার পার্শ্ববর্তী শহর নারায়ণগঞ্জের তিন মেয়রকে বিশেষ বিবেচনায় যথাক্রমে পূর্ণমন্ত্রী ও উপমন্ত্রীর মর্যাদা দেওয়ার খবরটা জেনে অনেক ভালো লেগেছে। যথাক্রমেÑ ঢাকার আনিসুল হক, সাঈদ খোকন ও সেলিনা হায়াত আইভীকে বিশেষ বিবেচনায় এই মর্যাদা দেওয়া হয়। এটাই ট্রা</description>
      <source url="https://amaderorthoneeti.com/2016/06/26/%e0%a6%b8%e0%a6%ac-%e0%a6%ae%e0%a7%87%e0%a7%9f%e0%a6%b0-%e0%a6%95%e0%a6%bf-%e0%a6%a4%e0%a6%ac%e0%a7%87-%e0%a6%ae%e0%a7%87%e0%a7%9f%e0%a6%b0-%e0%a6%a8%e0%a6%a8/">আমাদের অর্থনীতি</source>
    </item>
    <item>
      <title>বেঁড়িবাধ ভেঙে আশাশুনির তিনটি গ্রাম প্লাবিত</title>
      <link>https://amaderorthoneeti.com/2016/06/25/%e0%a6%ac%e0%a7%87%e0%a6%81%e0%a7%9c%e0%a6%bf%e0%a6%ac%e0%a6%be%e0%a6%a7-%e0%a6%ad%e0%a7%87%e0%a6%99%e0%a7%87-%e0%a6%86%e0%a6%b6%e0%a6%be%e0%a6%b6%e0%a7%81%e0%a6%a8%e0%a6%bf%e0%a6%b0-%e0%a6%a4/</link>

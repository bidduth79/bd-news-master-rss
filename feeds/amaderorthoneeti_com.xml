    <item>
      <title>শোলাকিয়া থেকে নিস, হাসির হাটে আর্তনাদ</title>
      <link>https://amaderorthoneeti.com/2016/07/18/%e0%a6%b6%e0%a7%8b%e0%a6%b2%e0%a6%be%e0%a6%95%e0%a6%bf%e0%a7%9f%e0%a6%be-%e0%a6%a5%e0%a7%87%e0%a6%95%e0%a7%87-%e0%a6%a8%e0%a6%bf%e0%a6%b8-%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%b0-%e0%a6%b9/</link>
      <guid isPermaLink="true">https://amaderorthoneeti.com/2016/07/18/%e0%a6%b6%e0%a7%8b%e0%a6%b2%e0%a6%be%e0%a6%95%e0%a6%bf%e0%a7%9f%e0%a6%be-%e0%a6%a5%e0%a7%87%e0%a6%95%e0%a7%87-%e0%a6%a8%e0%a6%bf%e0%a6%b8-%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%b0-%e0%a6%b9/</guid>
      <pubDate>Sun, 17 Jul 2016 18:00:43 +0000</pubDate>
      <description>প্রতিটি জাতি ধর্ম ও বর্ণের মানুষের জন্য বিশেষ বিশেষ কিছু আনন্দের মুহূর্ত ও দিন থাকে। বাঙালিরাও তার থেকে আলাদা নয়। আমাদের বিভিন্ন উৎসবের মধ্যে দুইটি দিন বিশেষভাবে উল্লেখযোগ্য, বিশেষ করে মুসলমানদের জন্য একটি হলো ঈদুল ফিতর আর একটি ঈদুল আযহা। শোলাকিয়ার সঙ্গে দেশের মুসলমানদের একটা বিশেষ সম্পর্ক আছে এই সম</description>
      <source url="https://amaderorthoneeti.com/2016/07/18/%e0%a6%b6%e0%a7%8b%e0%a6%b2%e0%a6%be%e0%a6%95%e0%a6%bf%e0%a7%9f%e0%a6%be-%e0%a6%a5%e0%a7%87%e0%a6%95%e0%a7%87-%e0%a6%a8%e0%a6%bf%e0%a6%b8-%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%b0-%e0%a6%b9/">আমাদের অর্থনীতি</source>
    </item>
    <item>
      <title>মিডিয়া, দায়িত্ব তোমাকে দায়িত্বশীল করে না বন্ধু?</title>
      <link>https://amaderorthoneeti.com/2016/06/27/%e0%a6%ae%e0%a6%bf%e0%a6%a1%e0%a6%bf%e0%a7%9f%e0%a6%be-%e0%a6%a6%e0%a6%be%e0%a7%9f%e0%a6%bf%e0%a6%a4%e0%a7%8d%e0%a6%ac-%e0%a6%a4%e0%a7%8b%e0%a6%ae%e0%a6%be%e0%a6%95%e0%a7%87-%e0%a6%a6%e0%a6%be/</link>

      <title>গোপালগঞ্জে আইজিপির সঙ্গে তিন বাহিনীর ডিজির উপস্থিতি</title>
      <link>https://protidinerpost.com/%e0%a6%97%e0%a7%8b%e0%a6%aa%e0%a6%be%e0%a6%b2%e0%a6%97%e0%a6%9e%e0%a7%8d%e0%a6%9c%e0%a7%87-%e0%a6%86%e0%a6%87%e0%a6%9c%e0%a6%bf%e0%a6%aa%e0%a6%bf%e0%a6%b0-%e0%a6%b8%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%87/</link>

    <item>
      <title>বাংলাদেশি রোগীদের জন্য থাইল্যান্ডে মাল্টিপল-এন্ট্রি ভিসার অনুরোধ</title>
      <link>https://protidinerpost.com/%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a6%bf-%e0%a6%b0%e0%a7%8b%e0%a6%97%e0%a7%80%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%9c%e0%a6%a8%e0%a7%8d%e0%a6%af-%e0%a6%a5/</link>

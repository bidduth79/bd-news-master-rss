    <item>
      <title>ভালোবাসা আর অভিমানে নিলয়-হিমির পথচলা</title>
      <link>https://protidinerpost.com/%e0%a6%ad%e0%a6%be%e0%a6%b2%e0%a7%8b%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a6%be-%e0%a6%86%e0%a6%b0-%e0%a6%85%e0%a6%ad%e0%a6%bf%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%a8%e0%a6%bf%e0%a6%b2%e0%a7%9f/</link>
      <guid isPermaLink="true">https://protidinerpost.com/%e0%a6%ad%e0%a6%be%e0%a6%b2%e0%a7%8b%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a6%be-%e0%a6%86%e0%a6%b0-%e0%a6%85%e0%a6%ad%e0%a6%bf%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%a8%e0%a6%bf%e0%a6%b2%e0%a7%9f/</guid>
      <pubDate>Sat, 14 Nov 2026 03:56:39 +0000</pubDate>
      <description>ছোটপর্দার জনপ্রিয় জুটি নিলয় আলমগীর ও জান্নাতুল সুমাইয়া হিমি। দর্শকের কাছে তাদের জুটির আলাদা গ্রহণযোগ্যতা রয়েছে। রোমান্টিক কিংবা হাস্যরসাত্মক গল্প— বিভিন্ন ধরনের নাটকে একসঙ্গে অভিনয় করে প্রশংসা পেয়েছেন তারা। এবার এই জুটিকে দেখা গেছে ‘অকারণ’ শিরোনামের একটি নাটকে। এটি রচনা ও পরিচালনা করেছেন জুবায়ের ইবন</description>
      <source url="https://protidinerpost.com/%e0%a6%ad%e0%a6%be%e0%a6%b2%e0%a7%8b%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a6%be-%e0%a6%86%e0%a6%b0-%e0%a6%85%e0%a6%ad%e0%a6%bf%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%a8%e0%a6%bf%e0%a6%b2%e0%a7%9f/">Protidiner Post</source>
    </item>
    <item>
      <title>ট্যাংকারের ধাক্কায় মুহূর্তেই ডুবল প্রমোদতরি!</title>
      <link>https://protidinerpost.com/%e0%a6%9f%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%a7%e0%a6%be%e0%a6%95%e0%a7%8d%e0%a6%95%e0%a6%be%e0%a7%9f-%e0%a6%ae%e0%a7%81%e0%a6%b9%e0%a7%82%e0%a6%b0/</link>

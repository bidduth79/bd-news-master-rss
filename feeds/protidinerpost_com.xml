    <item>
      <title>প্রধানমন্ত্রীর সঙ্গে বৈঠকে বসছেন বিরোধীদলীয় নেতা</title>
      <link>https://protidinerpost.com/%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a7%e0%a6%be%e0%a6%a8%e0%a6%ae%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a7%80%e0%a6%b0-%e0%a6%b8%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%87-%e0%a6%ac%e0%a7%88%e0%a6%a0/</link>
      <guid isPermaLink="true">https://protidinerpost.com/%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a7%e0%a6%be%e0%a6%a8%e0%a6%ae%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a7%80%e0%a6%b0-%e0%a6%b8%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%87-%e0%a6%ac%e0%a7%88%e0%a6%a0/</guid>
      <pubDate>Thu, 19 Nov 2026 06:00:24 +0000</pubDate>
      <description>সংসদ নেতা ও প্রধানমন্ত্রী তারেক রহমানের সঙ্গে বৈঠক করেছেন বিরোধীদলীয় নেতা এবং বাংলাদেশ জামায়াতে ইসলামীর আমির ডা. শফিকুর রহমান। বুধবার (১৮ নভেম্বর) মাগরিবের নামাজের আগে জাতীয় সংসদ ভবনে প্রধানমন্ত্রীর কার্যালয়ে এ বৈঠক অনুষ্ঠিত হয়। বৈঠকে দেশের চলমান রাজনৈতিক পরিস্থিতি, জুলাই জাতীয় সনদ বাস্তবায়ন এবং গণত</description>
      <source url="https://protidinerpost.com/%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a7%e0%a6%be%e0%a6%a8%e0%a6%ae%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a7%80%e0%a6%b0-%e0%a6%b8%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%87-%e0%a6%ac%e0%a7%88%e0%a6%a0/">Protidiner Post</source>
    </item>
    <item>
      <title>সৌন্দর্যের মঞ্চে নজর কাড়লেন মাহি, দিলেন বন্ধুত্বের বার্তা!</title>
      <link>https://protidinerpost.com/%e0%a6%b8%e0%a7%8c%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a6%9e%e0%a7%8d%e0%a6%9a%e0%a7%87-%e0%a6%a8%e0%a6%9c%e0%a6%b0-%e0%a6%95%e0%a6%be%e0%a7%9c/</link>

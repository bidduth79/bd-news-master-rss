    <item>
      <title>হোয়াটসঅ্যাপে এই একটি ভুলেই খালি হতে পারে ব্যাংক অ্যাকাউন্ট, সাবধান!</title>
      <link>https://protidinerpost.com/%e0%a6%b9%e0%a7%8b%e0%a7%9f%e0%a6%be%e0%a6%9f%e0%a6%b8%e0%a6%85%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%aa%e0%a7%87-%e0%a6%8f%e0%a6%87-%e0%a6%8f%e0%a6%95%e0%a6%9f%e0%a6%bf-%e0%a6%ad%e0%a7%81%e0%a6%b2/</link>

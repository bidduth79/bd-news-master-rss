    <item>
      <title>শিক্ষার্থীদের বাসে দুর্বৃত্তদের আগুন, বিপাকে ৫০ আবাসিক শিক্ষার্থী</title>
      <link>https://protidinerpost.com/%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%a5%e0%a7%80%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a7%87-%e0%a6%a6%e0%a7%81%e0%a6%b0%e0%a7%8d%e0%a6%ac/</link>

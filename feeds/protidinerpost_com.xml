    <item>
      <title>গর্তে পড়েছেন তারেক রহমান!’—পাটওয়ারীর মন্তব্যে।</title>
      <link>https://protidinerpost.com/%e0%a6%97%e0%a6%b0%e0%a7%8d%e0%a6%a4%e0%a7%87-%e0%a6%aa%e0%a7%9c%e0%a7%87%e0%a6%9b%e0%a7%87%e0%a6%a8-%e0%a6%a4%e0%a6%be%e0%a6%b0%e0%a7%87%e0%a6%95-%e0%a6%b0%e0%a6%b9%e0%a6%ae%e0%a6%be%e0%a6%a8/</link>

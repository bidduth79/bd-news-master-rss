      <pubDate>Thu, 26 Nov 2026 08:50:49 +0000</pubDate>
      <description>নোয়াখালীর সদর উপজেলার হরিনারায়ণপুর বালিকা সরকারি প্রাথমিক বিদ্যালয়ের সহকারী শিক্ষক রাবেয়া সুলতানা চাকরিতে যোগ দেন ২০০১ সালের জুলাইয়ে। এরপর পেরিয়ে গেছে ২৩ বছর ৭ মাস। অথচ এই দীর্ঘ কর্মজীবনের ৯ বছর ৭ মাসের বেশি সময় কেটেছে তার ছুটিতে। তবে কর্মদিবস ধরে হিসাব করলে প্রায় ১৮ বছরই ছিলেন বিদ্যালয়ের বাইরে। কখন</description>
      <source url="https://protidinerpost.com/%e0%a7%a8%e0%a7%a9-%e0%a6%ac%e0%a6%9b%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%9a%e0%a6%be%e0%a6%95%e0%a6%b0%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a7%af-%e0%a6%ac%e0%a6%9b%e0%a6%b0%e0%a6%87-%e0%a6%9b%e0%a7%81/">Protidiner Post</source>
    </item>
    <item>
      <title>জন্মনিয়ন্ত্রণে নতুন সুবিধা, এবার নিজেই নিতে পারবেন ইনজেকশন।</title>
      <link>https://protidinerpost.com/%e0%a6%9c%e0%a6%a8%e0%a7%8d%e0%a6%ae%e0%a6%a8%e0%a6%bf%e0%a7%9f%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a6%a3%e0%a7%87-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%b8%e0%a7%81%e0%a6%ac%e0%a6%bf/</link>

    </item>
    <item>
      <title>[Protidiner Post] নরসিংদী শিবপুরের নকল বিড়ি উৎপাদন, ডিবি পুলিশের অভিযান</title>
      <link>https://protidinerpost.com/%e0%a6%a8%e0%a6%b0%e0%a6%b8%e0%a6%bf%e0%a6%82%e0%a6%a6%e0%a7%80-%e0%a6%b6%e0%a6%bf%e0%a6%ac%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a6%95%e0%a6%b2-%e0%a6%ac%e0%a6%bf%e0%a6%a1/</link>
      <guid isPermaLink="true">https://protidinerpost.com/%e0%a6%a8%e0%a6%b0%e0%a6%b8%e0%a6%bf%e0%a6%82%e0%a6%a6%e0%a7%80-%e0%a6%b6%e0%a6%bf%e0%a6%ac%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a6%95%e0%a6%b2-%e0%a6%ac%e0%a6%bf%e0%a6%a1/</guid>
      <pubDate>Sun, 08 Nov 2026 11:40:20 +0000</pubDate>
      <description>নরসিংদীর শিবপুরে নকল ব্যান্ড রোল ব্যবহার করে বিড়ি উৎপাদন ও রাজস্ব ফাঁকির অভিযোগে একাধিক কারখানায় যৌথ অভিযান চালিয়েছে এনএসআই ও জেলা গোয়েন্দা পুলিশ (ডিবি)। রোববার সকালে উপজেলার কামড়াবো বাজার এলাকায় পরিচালিত এ অভিযানে প্রায় ১২ লাখ টাকা মূল্যের নক</description>
      <source url="https://protidinerpost.com/%e0%a6%a8%e0%a6%b0%e0%a6%b8%e0%a6%bf%e0%a6%82%e0%a6%a6%e0%a7%80-%e0%a6%b6%e0%a6%bf%e0%a6%ac%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a6%95%e0%a6%b2-%e0%a6%ac%e0%a6%bf%e0%a6%a1/">Protidiner Post</source>
    </item>
    <item>
      <title>[Protidiner Post] সমবায়ের হাত ধরে স্বনির্ভরতার পথে বাংলাদেশ, গঙ্গাচড়ায় দিবস উদযাপন</title>
      <link>https://protidinerpost.com/%e0%a6%b8%e0%a6%ae%e0%a6%ac%e0%a6%be%e0%a7%9f%e0%a7%87%e0%a6%b0-%e0%a6%b9%e0%a6%be%e0%a6%a4-%e0%a6%a7%e0%a6%b0%e0%a7%87-%e0%a6%b8%e0%a7%8d%e0%a6%ac%e0%a6%a8%e0%a6%bf%e0%a6%b0%e0%a7%8d%e0%a6%ad/</link>

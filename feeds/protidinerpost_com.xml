    <item>
      <title>এক লাখ স্বাস্থ্যকর্মী নিয়োগ দেবে সরকার, ৮০ শতাংশ নারী</title>
      <link>https://protidinerpost.com/%e0%a6%8f%e0%a6%95-%e0%a6%b2%e0%a6%be%e0%a6%96-%e0%a6%b8%e0%a7%8d%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a7%8d%e0%a6%a5%e0%a7%8d%e0%a6%af%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a7%80-%e0%a6%a8%e0%a6%bf/</link>
      <guid isPermaLink="true">https://protidinerpost.com/%e0%a6%8f%e0%a6%95-%e0%a6%b2%e0%a6%be%e0%a6%96-%e0%a6%b8%e0%a7%8d%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a7%8d%e0%a6%a5%e0%a7%8d%e0%a6%af%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a7%80-%e0%a6%a8%e0%a6%bf/</guid>
      <pubDate>Sat, 14 Nov 2026 12:09:53 +0000</pubDate>
      <description>জিয়াউর রহমান ফাউন্ডেশনের ভাইস প্রেসিডেন্ট ডা. জুবাইদা রহমান জানিয়েছেন, রোগ প্রতিরোধমূলক ব্যবস্থা মানুষের দোরগোড়ায় পৌঁছে দিতে দেশে এক লাখ স্বাস্থ্যকর্মী নিয়োগ দেওয়া হচ্ছে। আর এর ৮০ শতাংশই নারী। শনিবার (১৪ নভেম্বর) রাজধানীর গুলশানের একটি হোটেলে গবেষণা প্রতিষ্ঠান ইন্সটিটিউট ফর ডেভেলপিং সায়েন্স অ্যান্ড </description>
      <source url="https://protidinerpost.com/%e0%a6%8f%e0%a6%95-%e0%a6%b2%e0%a6%be%e0%a6%96-%e0%a6%b8%e0%a7%8d%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a7%8d%e0%a6%a5%e0%a7%8d%e0%a6%af%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a7%80-%e0%a6%a8%e0%a6%bf/">Protidiner Post</source>
    </item>
    <item>
      <title>নতুন বেকারির আনন্দ বিষাদে পরিণত, সড়ক দুর্ঘটনায় ছেলের মৃত্যু</title>
      <link>https://protidinerpost.com/%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%ac%e0%a7%87%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%bf%e0%a6%b0-%e0%a6%86%e0%a6%a8%e0%a6%a8%e0%a7%8d%e0%a6%a6-%e0%a6%ac%e0%a6%bf%e0%a6%b7%e0%a6%be%e0%a6%a6/</link>

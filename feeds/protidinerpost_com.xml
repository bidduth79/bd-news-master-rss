    <item>
      <title>গোপন রাখেননি কিছুই, স্তন প্রতিস্থাপনের কথা স্বীকার অভিনেত্রীর</title>
      <link>https://protidinerpost.com/%e0%a6%97%e0%a7%8b%e0%a6%aa%e0%a6%a8-%e0%a6%b0%e0%a6%be%e0%a6%96%e0%a7%87%e0%a6%a8%e0%a6%a8%e0%a6%bf-%e0%a6%95%e0%a6%bf%e0%a6%9b%e0%a7%81%e0%a6%87-%e0%a6%b8%e0%a7%8d%e0%a6%a4%e0%a6%a8-%e0%a6%aa/</link>
      <guid isPermaLink="true">https://protidinerpost.com/%e0%a6%97%e0%a7%8b%e0%a6%aa%e0%a6%a8-%e0%a6%b0%e0%a6%be%e0%a6%96%e0%a7%87%e0%a6%a8%e0%a6%a8%e0%a6%bf-%e0%a6%95%e0%a6%bf%e0%a6%9b%e0%a7%81%e0%a6%87-%e0%a6%b8%e0%a7%8d%e0%a6%a4%e0%a6%a8-%e0%a6%aa/</guid>
      <pubDate>Sat, 21 Nov 2026 13:02:52 +0000</pubDate>
      <description>বিশ্বের সবচেয়ে বেশি পারিশ্রমিক নেওয়া অভিনেত্রীদের মধ্যে অন্যতম অস্কারজয়ী মার্কিন অভিনেত্রী জেনিফার লরেন্স। অস্ত্রোপচারের মাধ্যমে ব্রেস্ট ইমপ্ল্যান্ট বা স্তন প্রতিস্থাপন করিয়েছেন এই অভিনেত্রী। কিছুদিন আগে ‘ওয়াচ হোয়াট হ্যাপেনস লাইভ উইথ অ্যান্ডি কোহেন’ টিভি শোয়ে অতিথি হিসেবে উপস্থিত হয়ে গোপন খবরটি জানা</description>
      <source url="https://protidinerpost.com/%e0%a6%97%e0%a7%8b%e0%a6%aa%e0%a6%a8-%e0%a6%b0%e0%a6%be%e0%a6%96%e0%a7%87%e0%a6%a8%e0%a6%a8%e0%a6%bf-%e0%a6%95%e0%a6%bf%e0%a6%9b%e0%a7%81%e0%a6%87-%e0%a6%b8%e0%a7%8d%e0%a6%a4%e0%a6%a8-%e0%a6%aa/">Protidiner Post</source>
    </item>
    <item>
      <title>এবার সাবেক এমপির বাড়িতে অগ্নিসংযোগ, উত্তাল সীতাকুণ্ড</title>
      <link>https://protidinerpost.com/%e0%a6%8f%e0%a6%ac%e0%a6%be%e0%a6%b0-%e0%a6%b8%e0%a6%be%e0%a6%ac%e0%a7%87%e0%a6%95-%e0%a6%8f%e0%a6%ae%e0%a6%aa%e0%a6%bf%e0%a6%b0-%e0%a6%ac%e0%a6%be%e0%a7%9c%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%85/</link>
      <guid isPermaLink="true">https://protidinerpost.com/%e0%a6%8f%e0%a6%ac%e0%a6%be%e0%a6%b0-%e0%a6%b8%e0%a6%be%e0%a6%ac%e0%a7%87%e0%a6%95-%e0%a6%8f%e0%a6%ae%e0%a6%aa%e0%a6%bf%e0%a6%b0-%e0%a6%ac%e0%a6%be%e0%a7%9c%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%85/</guid>
      <pubDate>Sat, 21 Nov 2026 12:54:33 +0000</pubDate>
      <description>চট্টগ্রামের সীতাকুণ্ডে সাবেক সংসদ সদস্য এস এম আল মামুনের বাড়িতে আবারও ভাঙচুর ও গাড়িতে অগ্নিসংযোগের অভিযোগ উঠেছে। বৃহস্পতিবার (১৯ নভেম্বর) দিবাগত রাত ২টার দিকে উপজেলার সলিমপুর ইউনিয়নের ফকিরহাট এলাকায় অবস্থিত তার বাসভবনে এই ঘটনা ঘটে। স্থানীয় ও প্রত্যক্ষদর্শী সূত্রে জানা গেছে, গভীর রাতে একদল দুর্ব</description>
      <source url="https://protidinerpost.com/%e0%a6%8f%e0%a6%ac%e0%a6%be%e0%a6%b0-%e0%a6%b8%e0%a6%be%e0%a6%ac%e0%a7%87%e0%a6%95-%e0%a6%8f%e0%a6%ae%e0%a6%aa%e0%a6%bf%e0%a6%b0-%e0%a6%ac%e0%a6%be%e0%a7%9c%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%85/">Protidiner Post</source>

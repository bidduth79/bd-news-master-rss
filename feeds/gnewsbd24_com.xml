    <item>
      <title>কুষ্টিয়ায় স্কুলছাত্রীকে ছুরিকাঘাতের ঘটনায় অভিযুক্ত কিশোর গ্রেপ্তার</title>
      <link>https://gnewsbd24.com/2026/11/10/%e0%a6%95%e0%a7%81%e0%a6%b7%e0%a7%8d%e0%a6%9f%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%b8%e0%a7%8d%e0%a6%95%e0%a7%81%e0%a6%b2%e0%a6%9b%e0%a6%be%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a7%80/</link>

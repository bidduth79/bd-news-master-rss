    <item>
      <title>কিলি অভিযানের ইতিকথা</title>
      <link>https://www.ghurunchi.com/%e0%a6%95%e0%a6%bf%e0%a6%b2%e0%a6%bf-%e0%a6%85%e0%a6%ad%e0%a6%bf%e0%a6%af%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%87%e0%a6%a4%e0%a6%bf%e0%a6%95%e0%a6%a5%e0%a6%be/</link>
      <guid isPermaLink="true">https://www.ghurunchi.com/%e0%a6%95%e0%a6%bf%e0%a6%b2%e0%a6%bf-%e0%a6%85%e0%a6%ad%e0%a6%bf%e0%a6%af%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%87%e0%a6%a4%e0%a6%bf%e0%a6%95%e0%a6%a5%e0%a6%be/</guid>
      <pubDate>Mon, 07 Sep 2026 02:47:28 +0000</pubDate>
      <description>বিকেলের দিকে আমরা হোরোম্বো হাট থেকে কিবো হাটে পৌঁছলাম। সমুদ্রপৃষ্ঠ থেকে ৩,৭০০ মিটার উচ্চতার হোরোম্বো হাট থেকে ৪,৮০০ মিটার উচ্চতার কিবো হাটে পৌঁছানোর কিছুটা আগে থেকেই মনটা খারাপ হয়ে যাচ্ছিল, কারণ বুঝতে পারছিলাম মাথাব্যথা শুরু হচ্ছে এবং পেটেও এক ধরনের অস্বস্তি অনুভব করছিলাম। ট্রেইলটি তুলনামূলক সহজ হল</description>
      <source url="https://www.ghurunchi.com/%e0%a6%95%e0%a6%bf%e0%a6%b2%e0%a6%bf-%e0%a6%85%e0%a6%ad%e0%a6%bf%e0%a6%af%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%87%e0%a6%a4%e0%a6%bf%e0%a6%95%e0%a6%a5%e0%a6%be/">Gurunchi Magazine</source>
    </item>
    <item>
      <title>মাসাই মারা</title>
      <link>https://www.ghurunchi.com/%e0%a6%ae%e0%a6%be%e0%a6%b8%e0%a6%be%e0%a6%87-%e0%a6%ae%e0%a6%be%e0%a6%b0%e0%a6%be/</link>
      <guid isPermaLink="true">https://www.ghurunchi.com/%e0%a6%ae%e0%a6%be%e0%a6%b8%e0%a6%be%e0%a6%87-%e0%a6%ae%e0%a6%be%e0%a6%b0%e0%a6%be/</guid>
      <pubDate>Tue, 18 Aug 2026 13:28:42 +0000</pubDate>
      <enclosure url="https://www.ghurunchi.com/wp-content/uploads/2023/02/This-space-is-for.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.ghurunchi.com/wp-content/uploads/2023/02/This-space-is-for.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.ghurunchi.com/wp-content/uploads/2023/02/This-space-is-for.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মাসাই মারা" /&gt;&lt;/p&gt;&lt;p&gt;এক টুকরো মেঘ ছুটতে ছুটতে চলে গেল আফ্রিকান সাভানার উপর দিয়ে। নাইরোবির উইলসন এয়ারপোর্ট থেকে মাসাই মারার কিকোরোক এয়ারস্ট্রিপ। আকাশপথে মিনিট পঞ্চাশেক। ছোট্ট বিমান, পথে কয়েকটা এয়ারস্ট্রিপে যাত্রী নামাবে, তুলবে। অনেকটা আকাশপথে লোকাল বাসের ছোঁয়া।আমারটা দ্বিতীয় স্টেশন। যাত্রার আগে অবশ্য ফ্লাইট শিডিউল নিয়ে ক&lt;/p&gt;</description>
      <source url="https://www.ghurunchi.com/%e0%a6%ae%e0%a6%be%e0%a6%b8%e0%a6%be%e0%a6%87-%e0%a6%ae%e0%a6%be%e0%a6%b0%e0%a6%be/">Gurunchi Magazine</source>
    </item>
    <item>
      <title>শীত-বাসন্তী এক রূপকথার শহর: ওয়ালহালা ভ্রমণ</title>
      <link>https://www.ghurunchi.com/%e0%a6%b6%e0%a7%80%e0%a6%a4-%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%80-%e0%a6%8f%e0%a6%95-%e0%a6%b0%e0%a7%82%e0%a6%aa%e0%a6%95%e0%a6%a5%e0%a6%be%e0%a6%b0-%e0%a6%b6%e0%a6%b9/</link>
      <guid isPermaLink="true">https://www.ghurunchi.com/%e0%a6%b6%e0%a7%80%e0%a6%a4-%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%80-%e0%a6%8f%e0%a6%95-%e0%a6%b0%e0%a7%82%e0%a6%aa%e0%a6%95%e0%a6%a5%e0%a6%be%e0%a6%b0-%e0%a6%b6%e0%a6%b9/</guid>
      <pubDate>Sat, 26 Jul 2025 08:23:40 +0000</pubDate>
      <enclosure url="https://www.ghurunchi.com/wp-content/uploads/2023/02/This-space-is-for.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.ghurunchi.com/wp-content/uploads/2023/02/This-space-is-for.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.ghurunchi.com/wp-content/uploads/2023/02/This-space-is-for.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শীত-বাসন্তী এক রূপকথার শহর: ওয়ালহালা ভ্রমণ" /&gt;&lt;/p&gt;&lt;p&gt;মেলবোর্ন শহর থেকে প্রায় ১৮০ কিলোমিটার দূরে, পাহাড় ঘেরা এক নিস্তব্ধ ছোট্ট শহরের নাম ওয়ালহালা (Walhalla)। মনে হবে যেন একটি পুরোনো ইউরোপিয়ান ছবির দৃশ্য—যেখানে রূপকথার শহরের মতো সাজানো গাছপালা, রঙিন পাখির ডাক, আর পাহাড় বেয়ে নামা কুয়াশার পর্দা আপনাকে স্বপ্নের জগতে নিয়ে যাবে। ওয়ালহালা এক সময় ছিল&lt;/p&gt;</description>
      <source url="https://www.ghurunchi.com/%e0%a6%b6%e0%a7%80%e0%a6%a4-%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%80-%e0%a6%8f%e0%a6%95-%e0%a6%b0%e0%a7%82%e0%a6%aa%e0%a6%95%e0%a6%a5%e0%a6%be%e0%a6%b0-%e0%a6%b6%e0%a6%b9/">Gurunchi Magazine</source>
    </item>
    <item>
      <title>পর্যটকদের জন্য বাংলাদেশে ভ্রমণ</title>
      <link>https://www.ghurunchi.com/%e0%a6%aa%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%9f%e0%a6%95%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%9c%e0%a6%a8%e0%a7%8d%e0%a6%af-%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%87/</link>
      <guid isPermaLink="true">https://www.ghurunchi.com/%e0%a6%aa%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%9f%e0%a6%95%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%9c%e0%a6%a8%e0%a7%8d%e0%a6%af-%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%87/</guid>
      <pubDate>Wed, 02 Jul 2025 06:59:45 +0000</pubDate>
      <enclosure url="https://www.ghurunchi.com/wp-content/uploads/2023/02/This-space-is-for.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.ghurunchi.com/wp-content/uploads/2023/02/This-space-is-for.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.ghurunchi.com/wp-content/uploads/2023/02/This-space-is-for.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পর্যটকদের জন্য বাংলাদেশে ভ্রমণ" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ মূলত: বাংলাভাষী ও কিছু অন্যান্য ভাষার জাতিগোষ্ঠীর দেশ। বাংলা হচ্ছে প্রধান স্থানীয় ভাষা এবং দেশ মানে ভূমি। এজন্যই নাম বাংলাদেশ। বাংলাদেশ বিশ্ব সম্প্রদায়ের সক্রিয় অংশগ্রহণকারী স্বাধীন জাতি হিসাবে গর্বের সাথে নিজেকে প্রতিষ্ঠিত এবং উল্লেখযোগ্য বিদেশী পর্যটকদের আকর্ষণ করেছে। সাধারণভাবে বলা হয়&lt;/p&gt;</description>
      <source url="https://www.ghurunchi.com/%e0%a6%aa%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%9f%e0%a6%95%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%9c%e0%a6%a8%e0%a7%8d%e0%a6%af-%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%87/">Gurunchi Magazine</source>
    </item>
    <item>
      <title>আয়রনম্যান – কঠিন সাধনা ও পরিশ্রম</title>
      <link>https://www.ghurunchi.com/%e0%a6%86%e0%a7%9f%e0%a6%b0%e0%a6%a8%e0%a6%ae%e0%a7%8d%e0%a6%af%e0%a6%a8-%e0%a6%95%e0%a6%a0%e0%a6%bf%e0%a6%a8-%e0%a6%b8%e0%a6%be%e0%a6%a7%e0%a6%a8%e0%a6%be-%e0%a6%93-%e0%a6%aa%e0%a6%b0%e0%a6%bf/</link>
      <guid isPermaLink="true">https://www.ghurunchi.com/%e0%a6%86%e0%a7%9f%e0%a6%b0%e0%a6%a8%e0%a6%ae%e0%a7%8d%e0%a6%af%e0%a6%a8-%e0%a6%95%e0%a6%a0%e0%a6%bf%e0%a6%a8-%e0%a6%b8%e0%a6%be%e0%a6%a7%e0%a6%a8%e0%a6%be-%e0%a6%93-%e0%a6%aa%e0%a6%b0%e0%a6%bf/</guid>
      <pubDate>Sun, 12 Jan 2025 09:03:40 +0000</pubDate>
      <enclosure url="https://www.ghurunchi.com/wp-content/uploads/2023/02/This-space-is-for.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.ghurunchi.com/wp-content/uploads/2023/02/This-space-is-for.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.ghurunchi.com/wp-content/uploads/2023/02/This-space-is-for.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আয়রনম্যান – কঠিন সাধনা ও পরিশ্রম" /&gt;&lt;/p&gt;&lt;p&gt;গতকাল ঢাকা আন্তর্জাতিক বিমানবন্দর থেকে ফ্লাইট উড়ানকাল ছিলো রাত ১০.২৫। চেঙ্গি এয়ারপোর্টে ৭ ঘন্টা ট্রানজিট নিতে হবে। এরপর লানকাউইতে নিয়ে যাবে স্কুট নামে আরেক উড়োজাহাজ। আমরা একসাথে রওনা দিয়েছি ৮ জন আয়রনম্যান ইভেন্টে অংশগ্রহণকারী। এরমধ্যে কারো কারো বিদেশ যাত্রা প্রথম বারের মত। বিমানবন্দরের দোতলায় অনেকগু&lt;/p&gt;</description>
      <source url="https://www.ghurunchi.com/%e0%a6%86%e0%a7%9f%e0%a6%b0%e0%a6%a8%e0%a6%ae%e0%a7%8d%e0%a6%af%e0%a6%a8-%e0%a6%95%e0%a6%a0%e0%a6%bf%e0%a6%a8-%e0%a6%b8%e0%a6%be%e0%a6%a7%e0%a6%a8%e0%a6%be-%e0%a6%93-%e0%a6%aa%e0%a6%b0%e0%a6%bf/">Gurunchi Magazine</source>
    </item>
    <item>
      <title>স্প্রিংব্রুক ন্যাশনাল পার্ক</title>
      <link>https://www.ghurunchi.com/%e0%a6%b8%e0%a7%8d%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%bf%e0%a6%82%e0%a6%ac%e0%a7%8d%e0%a6%b0%e0%a7%81%e0%a6%95-%e0%a6%a8%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%b6%e0%a6%a8%e0%a6%be%e0%a6%b2-%e0%a6%aa%e0%a6%be/</link>
      <guid isPermaLink="true">https://www.ghurunchi.com/%e0%a6%b8%e0%a7%8d%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%bf%e0%a6%82%e0%a6%ac%e0%a7%8d%e0%a6%b0%e0%a7%81%e0%a6%95-%e0%a6%a8%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%b6%e0%a6%a8%e0%a6%be%e0%a6%b2-%e0%a6%aa%e0%a6%be/</guid>
      <pubDate>Fri, 10 May 2024 07:50:46 +0000</pubDate>
      <enclosure url="https://www.ghurunchi.com/wp-content/uploads/2024/05/Springfield_NP_Ghurunchi_Nawshaba_0022-771x1024.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.ghurunchi.com/wp-content/uploads/2024/05/Springfield_NP_Ghurunchi_Nawshaba_0022-771x1024.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.ghurunchi.com/wp-content/uploads/2024/05/Springfield_NP_Ghurunchi_Nawshaba_0022-771x1024.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="স্প্রিংব্রুক ন্যাশনাল পার্ক" /&gt;&lt;/p&gt;&lt;p&gt;হুট করেই প্ল্যান, মে মাসের শুরুতে লং উইকেন্ডে গোল্ড কোস্ট ঘুরে আসি। এর আগেও দুইবার গোল্ড কোস্টে যাওয়া হয়েছে তাই এইবার প্ল্যান ছিলো এমন কোথাও যাবো যেখানে আগে যাই নি। খুঁজে পেলাম স্প্রিংব্রুক ন্যাশনাল পার্ক। ঘুরুঞ্চির ফেইসবুক পেজ ঘুরুঞ্চির ফেইসবুক গ্রুপ  আমরা ডারউইনের মানুষ সূর্যাস্ত নিয়ে ভীষণ প্রাউড।&lt;/p&gt;</description>
      <source url="https://www.ghurunchi.com/%e0%a6%b8%e0%a7%8d%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%bf%e0%a6%82%e0%a6%ac%e0%a7%8d%e0%a6%b0%e0%a7%81%e0%a6%95-%e0%a6%a8%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%b6%e0%a6%a8%e0%a6%be%e0%a6%b2-%e0%a6%aa%e0%a6%be/">Gurunchi Magazine</source>
    </item>
    <item>
      <title>অরোরা</title>
      <link>https://www.ghurunchi.com/%e0%a6%85%e0%a6%b0%e0%a7%8b%e0%a6%b0%e0%a6%be/</link>
      <guid isPermaLink="true">https://www.ghurunchi.com/%e0%a6%85%e0%a6%b0%e0%a7%8b%e0%a6%b0%e0%a6%be/</guid>

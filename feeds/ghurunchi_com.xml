      <enclosure url="https://www.ghurunchi.com/wp-content/uploads/2023/02/This-space-is-for.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.ghurunchi.com/wp-content/uploads/2023/02/This-space-is-for.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.ghurunchi.com/wp-content/uploads/2023/02/This-space-is-for.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অরোরা" /&gt;&lt;/p&gt;&lt;p&gt;অরোরা বেরিয়েলিস (aurora borealis) ! নর্দান লাইট্স নামেই যা বেশি পরিচিত । আজকে অরোরা বোরিয়ালিস দেখার জন্য কিছু টিপ্স দিবো। আশা করি যারা প্লান করছেন তাদের কাজে লাগবে। এটা কি? কেন হয়? সায়েন্টিফিক ব্যাখ্যা এসব গুগল করলে পেয়ে যাবেন, কাজেই সে আলোচনায় যাচ্ছি না। আমি আজকের লেখায় কখন, কোথায় প্লান করলে ভাল ভি&lt;/p&gt;</description>
      <source url="https://www.ghurunchi.com/%e0%a6%85%e0%a6%b0%e0%a7%8b%e0%a6%b0%e0%a6%be/">Gurunchi Magazine</source>
    </item>
    <item>
      <title>মেলবোর্ন টু পার্থ রোড ট্রিপ</title>
      <link>https://www.ghurunchi.com/%e0%a6%ae%e0%a7%87%e0%a6%b2%e0%a6%ac%e0%a7%8b%e0%a6%b0%e0%a7%8d%e0%a6%a8-%e0%a6%9f%e0%a7%81-%e0%a6%aa%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%a5-%e0%a6%b0%e0%a7%8b%e0%a6%a1-%e0%a6%9f%e0%a7%8d%e0%a6%b0/</link>
      <guid isPermaLink="true">https://www.ghurunchi.com/%e0%a6%ae%e0%a7%87%e0%a6%b2%e0%a6%ac%e0%a7%8b%e0%a6%b0%e0%a7%8d%e0%a6%a8-%e0%a6%9f%e0%a7%81-%e0%a6%aa%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%a5-%e0%a6%b0%e0%a7%8b%e0%a6%a1-%e0%a6%9f%e0%a7%8d%e0%a6%b0/</guid>
      <pubDate>Mon, 18 Mar 2024 04:41:43 +0000</pubDate>
      <enclosure url="https://www.ghurunchi.com/wp-content/uploads/2023/02/This-space-is-for.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.ghurunchi.com/wp-content/uploads/2023/02/This-space-is-for.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.ghurunchi.com/wp-content/uploads/2023/02/This-space-is-for.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মেলবোর্ন টু পার্থ রোড ট্রিপ" /&gt;&lt;/p&gt;&lt;p&gt;অস্ট্রেলিয়া আসার পর থেকে সবসময় মনের মধ্যে ঘুরে বেড়াতো কখন এই দেশটাকে ঘুরে দেখব। ছোট খাটো অনেক জায়গায় যাওয়া হলেও লম্বা রোড ট্রিপ হয় নাই কখনো। লম্বা বন্ধ সহজে অস্ট্রেলিয়ায় পাওয়াও হয়ে ওঠে না। এখানে সবচেয়ে লম্বা ছুটি বড়দিনের ছুটি সাথে নুতন বছরের শুরু। এই সময়টাই আরো ২/৩ দিন অতিরিক্ত ছুটি সাথে যোগ &lt;/p&gt;</description>
      <source url="https://www.ghurunchi.com/%e0%a6%ae%e0%a7%87%e0%a6%b2%e0%a6%ac%e0%a7%8b%e0%a6%b0%e0%a7%8d%e0%a6%a8-%e0%a6%9f%e0%a7%81-%e0%a6%aa%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%a5-%e0%a6%b0%e0%a7%8b%e0%a6%a1-%e0%a6%9f%e0%a7%8d%e0%a6%b0/">Gurunchi Magazine</source>
    </item>
    <item>
      <title>আল্পস পর্বতমালা</title>
      <link>https://www.ghurunchi.com/%e0%a6%86%e0%a6%b2%e0%a7%8d%e0%a6%aa%e0%a6%b8-%e0%a6%aa%e0%a6%b0%e0%a7%8d%e0%a6%ac%e0%a6%a4%e0%a6%ae%e0%a6%be%e0%a6%b2%e0%a6%be/</link>
      <guid isPermaLink="true">https://www.ghurunchi.com/%e0%a6%86%e0%a6%b2%e0%a7%8d%e0%a6%aa%e0%a6%b8-%e0%a6%aa%e0%a6%b0%e0%a7%8d%e0%a6%ac%e0%a6%a4%e0%a6%ae%e0%a6%be%e0%a6%b2%e0%a6%be/</guid>
      <pubDate>Mon, 18 Mar 2024 03:50:35 +0000</pubDate>
      <enclosure url="https://www.ghurunchi.com/wp-content/uploads/2023/02/This-space-is-for.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.ghurunchi.com/wp-content/uploads/2023/02/This-space-is-for.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.ghurunchi.com/wp-content/uploads/2023/02/This-space-is-for.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আল্পস পর্বতমালা" /&gt;&lt;/p&gt;&lt;p&gt;আল্পস হলো ইউরোপের সর্বোচ্চ এবং বৃহত্তম পর্বতমালা। এটি ফ্রান্স, সুইজারল্যান্ড, ইতালি, অস্ট্রিয়া, জার্মানি, স্লোভেনিয়া, লিশটেনস্টাইন এবং মোনাকো এই আটটি দেশ জুড়ে প্রায় ১,২০০ কিলোমিটার (৭৫০ মাইল) এলাকায় বিস্তৃত। টেলিকম সেক্টরে গত ১০ বছর বিভিন্ন দেশে কাজ করার পর উচ্চ শিক্ষার্থে আমার ইউরোপে আসা। ইউরোপ&lt;/p&gt;</description>
      <source url="https://www.ghurunchi.com/%e0%a6%86%e0%a6%b2%e0%a7%8d%e0%a6%aa%e0%a6%b8-%e0%a6%aa%e0%a6%b0%e0%a7%8d%e0%a6%ac%e0%a6%a4%e0%a6%ae%e0%a6%be%e0%a6%b2%e0%a6%be/">Gurunchi Magazine</source>
    </item>
    <item>
      <title>লা চাসকোনা</title>
      <link>https://www.ghurunchi.com/%e0%a6%b2%e0%a6%be-%e0%a6%9a%e0%a6%be%e0%a6%b8%e0%a6%95%e0%a7%8b%e0%a6%a8%e0%a6%be/</link>
      <guid isPermaLink="true">https://www.ghurunchi.com/%e0%a6%b2%e0%a6%be-%e0%a6%9a%e0%a6%be%e0%a6%b8%e0%a6%95%e0%a7%8b%e0%a6%a8%e0%a6%be/</guid>
      <pubDate>Wed, 13 Mar 2024 03:00:25 +0000</pubDate>
      <enclosure url="https://www.ghurunchi.com/wp-content/uploads/2024/03/lachascona_Ghurunchi_salahuddin2-1024x683.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.ghurunchi.com/wp-content/uploads/2024/03/lachascona_Ghurunchi_salahuddin2-1024x683.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.ghurunchi.com/wp-content/uploads/2024/03/lachascona_Ghurunchi_salahuddin2-1024x683.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="লা চাসকোনা" /&gt;&lt;/p&gt;&lt;p&gt;চিলির সান্তিয়াগোর ব্যারিও বেলাভিস্তার এলাকার একটি বাড়ি। বাড়িটি চিলির বিখ্যাত কবি পাবলো নেরুদার যিনি ১৯৭১ সালে সাহিত্যে নোবেল পুরস্কার অর্জন করেছিলেন। সমুদ্রের প্রতি তার অসাধাণ টান ছিল। সবাই মনে করেন লা চাসকোনা বাড়িটির অদ্ভুত শৈলী নেরুদার সেই ভালোলাগার প্রতিফলন। যদিও তিনি ১৯৫৩ সালে তৎকালীন গোপন প্র&lt;/p&gt;</description>
      <source url="https://www.ghurunchi.com/%e0%a6%b2%e0%a6%be-%e0%a6%9a%e0%a6%be%e0%a6%b8%e0%a6%95%e0%a7%8b%e0%a6%a8%e0%a6%be/">Gurunchi Magazine</source>
    </item>

    <item>
      <title>বিশ্বের প্রথম ফুটবলার হিসেবে ফিফার বিশেষ দায়িত্বে ভারতের সুনীল ছেত্রী</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%B6%E0%A6%AC%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%AB%E0%A6%9F%E0%A6%AC%E0%A6%B2%E0%A6%B0-%E0%A6%B9%E0%A6%B8%E0%A6%AC-%E0%A6%AB%E0%A6%AB%E0%A6%B0-%E0%A6%AC%E0%A6%B6%E0%A6%B7-%E0%A6%A6%E0%A7%9F%E0%A6%A4%E0%A6%AC-%E0%A6%AD%E0%A6%B0%E0%A6%A4%E0%A6%B0-%E0%A6%B8%E0%A6%A8%E0%A6%B2-%E0%A6%9B%E0%A6%A4%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%B6%E0%A6%AC%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%AB%E0%A6%9F%E0%A6%AC%E0%A6%B2%E0%A6%B0-%E0%A6%B9%E0%A6%B8%E0%A6%AC-%E0%A6%AB%E0%A6%AB%E0%A6%B0-%E0%A6%AC%E0%A6%B6%E0%A6%B7-%E0%A6%A6%E0%A7%9F%E0%A6%A4%E0%A6%AC-%E0%A6%AD%E0%A6%B0%E0%A6%A4%E0%A6%B0-%E0%A6%B8%E0%A6%A8%E0%A6%B2-%E0%A6%9B%E0%A6%A4%E0%A6%B0</guid>
      <pubDate>Thu, 12 Nov 2026 09:02:13 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794474133_rkr_6af58095f111d.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794474133_rkr_6af58095f111d.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794474133_rkr_6af58095f111d.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিশ্বের প্রথম ফুটবলার হিসেবে ফিফার বিশেষ দায়িত্বে ভারতের সুনীল ছেত্রী" /&gt;&lt;/p&gt;&lt;p&gt;ফুটবল মাঠে গোল করে বহুবার খবরের শিরোনাম হয়েছেন সুনীল ছেত্রী। এবার আলোচনায় এলেন মাঠের বাইরের এক উদ্যোগে অংশ নিয়ে। শুধু জনপ্রিয়তা নয়, ফুটবলারদের সামাজিক প্রভাবকেও কাজে লাগাতে চায় ফিফা। সেই লক্ষ্যেই বিশ্ব ফুটবলের নিয়ন্ত্রক সংস্থাটির বিশেষ কর্মসূচিতে জায়গা করে নিয়েছেন ভারতের সাবেক অধিনায়ক। এই প্রথম কোনো&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%B6%E0%A6%AC%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%AB%E0%A6%9F%E0%A6%AC%E0%A6%B2%E0%A6%B0-%E0%A6%B9%E0%A6%B8%E0%A6%AC-%E0%A6%AB%E0%A6%AB%E0%A6%B0-%E0%A6%AC%E0%A6%B6%E0%A6%B7-%E0%A6%A6%E0%A7%9F%E0%A6%A4%E0%A6%AC-%E0%A6%AD%E0%A6%B0%E0%A6%A4%E0%A6%B0-%E0%A6%B8%E0%A6%A8%E0%A6%B2-%E0%A6%9B%E0%A6%A4%E0%A6%B0">Education Bangla</source>
    </item>
    <item>
      <title>ব্রাজিলের দায়িত্ব পাচ্ছেন রাফিনিয়া</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%B0%E0%A6%9C%E0%A6%B2%E0%A6%B0-%E0%A6%A6%E0%A7%9F%E0%A6%A4%E0%A6%AC-%E0%A6%AA%E0%A6%9A%E0%A6%9B%E0%A6%A8-%E0%A6%B0%E0%A6%AB%E0%A6%A8%E0%A7%9F</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%B0%E0%A6%9C%E0%A6%B2%E0%A6%B0-%E0%A6%A6%E0%A7%9F%E0%A6%A4%E0%A6%AC-%E0%A6%AA%E0%A6%9A%E0%A6%9B%E0%A6%A8-%E0%A6%B0%E0%A6%AB%E0%A6%A8%E0%A7%9F</guid>
      <pubDate>Thu, 12 Nov 2026 09:01:28 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794474088_rkr_6af58068b01b6.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794474088_rkr_6af58068b01b6.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794474088_rkr_6af58068b01b6.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ব্রাজিলের দায়িত্ব পাচ্ছেন রাফিনিয়া" /&gt;&lt;/p&gt;&lt;p&gt;বার্সেলোনায় নিজের সামর্থ্যের প্রমাণ আগেই দিয়েছেন রাফিনিয়া। এবার জাতীয় দলের হয়েও বড় দায়িত্ব পাওয়ার অপেক্ষায় এই ব্রাজিলিয়ান ফরোয়ার্ড। নভেম্বরের আন্তর্জাতিক বিরতিতে জাপানের বিপক্ষে ব্রাজিলের অধিনায়কের আর্মব্যান্ড উঠছে তার হাতে। নিয়মিত অধিনায়ক মারকুইনহোসের অনুপস্থিতিতে রাফিনিয়ার ওপরই আস্থা রাখার সিদ্ধান&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%B0%E0%A6%9C%E0%A6%B2%E0%A6%B0-%E0%A6%A6%E0%A7%9F%E0%A6%A4%E0%A6%AC-%E0%A6%AA%E0%A6%9A%E0%A6%9B%E0%A6%A8-%E0%A6%B0%E0%A6%AB%E0%A6%A8%E0%A7%9F">Education Bangla</source>
    </item>
    <item>
      <title>মার্টিনেজকে নিয়ে অনিশ্চয়তা</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%B0%E0%A6%9F%E0%A6%A8%E0%A6%9C%E0%A6%95-%E0%A6%A8%E0%A7%9F-%E0%A6%85%E0%A6%A8%E0%A6%B6%E0%A6%9A%E0%A7%9F%E0%A6%A4</link>

    <item>
      <title>থাকছেন না ট্রাভিস হেড, ভাঙছে হায়দরাবাদের ‘ট্রাভিশেক’ জুটি</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%A5%E0%A6%95%E0%A6%9B%E0%A6%A8-%E0%A6%A8-%E0%A6%9F%E0%A6%B0%E0%A6%AD%E0%A6%B8-%E0%A6%B9%E0%A6%A1-%E0%A6%AD%E0%A6%99%E0%A6%9B-%E0%A6%B9%E0%A7%9F%E0%A6%A6%E0%A6%B0%E0%A6%AC%E0%A6%A6%E0%A6%B0-%E0%A6%9F%E0%A6%B0%E0%A6%AD%E0%A6%B6%E0%A6%95-%E0%A6%9C%E0%A6%9F</link>

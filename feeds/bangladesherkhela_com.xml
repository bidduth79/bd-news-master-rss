    <item>
      <title>ম্যানচেস্টার ইউনাইটেডের নতুন কোচ পচেত্তিনো</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%AF%E0%A6%A8%E0%A6%9A%E0%A6%B8%E0%A6%9F%E0%A6%B0-%E0%A6%87%E0%A6%89%E0%A6%A8%E0%A6%87%E0%A6%9F%E0%A6%A1%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A6%A8-%E0%A6%95%E0%A6%9A-%E0%A6%AA%E0%A6%9A%E0%A6%A4%E0%A6%A4%E0%A6%A8</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%AF%E0%A6%A8%E0%A6%9A%E0%A6%B8%E0%A6%9F%E0%A6%B0-%E0%A6%87%E0%A6%89%E0%A6%A8%E0%A6%87%E0%A6%9F%E0%A6%A1%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A6%A8-%E0%A6%95%E0%A6%9A-%E0%A6%AA%E0%A6%9A%E0%A6%A4%E0%A6%A4%E0%A6%A8</guid>
      <pubDate>Fri, 13 Nov 2026 13:08:22 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794575302_rkr_6af70bc69848f.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794575302_rkr_6af70bc69848f.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794575302_rkr_6af70bc69848f.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ম্যানচেস্টার ইউনাইটেডের নতুন কোচ পচেত্তিনো" /&gt;&lt;/p&gt;&lt;p&gt;ইংলিশ ক্লাব ম্যানচেস্টার ইউনাইটেডের নতুন প্রধান কোচ হিসেবে নিয়োগ পেয়েছেন আর্জেন্টাইন কোচ মরিসিও পচেত্তিনো। মাইকেল ক্যারিকের বিদায়ের পর এবার ওল্ড ট্রাফোর্ডের দায়িত্ব নিতে যাচ্ছেন সাবেক টটেনহাম ও চেলসি কোচ। আগামী ১৮ নভেম্বর থেকে আনুষ্ঠানিকভাবে দায়িত্ব পালন শুরু করবেন তিনি। খবর গোল ডটকমের।&amp;amp;nbsp;বর্&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%AF%E0%A6%A8%E0%A6%9A%E0%A6%B8%E0%A6%9F%E0%A6%B0-%E0%A6%87%E0%A6%89%E0%A6%A8%E0%A6%87%E0%A6%9F%E0%A6%A1%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A6%A8-%E0%A6%95%E0%A6%9A-%E0%A6%AA%E0%A6%9A%E0%A6%A4%E0%A6%A4%E0%A6%A8">Education Bangla</source>
    </item>

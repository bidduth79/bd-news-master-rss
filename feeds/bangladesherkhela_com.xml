      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795097872_rkr_6aff0510babb6.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795097872_rkr_6aff0510babb6.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ম্যানইউ ছেড়ে রিয়ালে যোগ দিচ্ছেন ১৬ বছর বয়সী ইংলিশ তারকা" /&gt;&lt;/p&gt;&lt;p&gt;ম্যানচেস্টার ইউনাইটেড ছাড়ার ঘোষণা দিয়েছেন ইংলিশ ফুটবলের সম্ভাবনাময় তরুণ জেজে গ্যাব্রিয়েল। ১৬ বছর বয়সী এই ফুটবলার সামাজিক যোগাযোগমাধ্যম ইনস্টাগ্রামে আবেগঘন বার্তায় ওল্ড ট্রাফোর্ডের ক্লাবটির প্রতি কৃতজ্ঞতা জানিয়েছেন। তার পরবর্তী গন্তব্য হতে যাচ্ছে স্প্যানিশ জায়ান্ট রিয়াল মাদ্রিদ।গত সেপ্টেম্বরে ম্যানচে&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%AF%E0%A6%A8%E0%A6%87%E0%A6%89-%E0%A6%9B%E0%A7%9C-%E0%A6%B0%E0%A7%9F%E0%A6%B2-%E0%A6%AF%E0%A6%97-%E0%A6%A6%E0%A6%9A%E0%A6%9B%E0%A6%A8-%E0%A7%A7%E0%A7%AC-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%AC%E0%A7%9F%E0%A6%B8-%E0%A6%87%E0%A6%B2%E0%A6%B6-%E0%A6%A4%E0%A6%B0%E0%A6%95">Education Bangla</source>
    </item>
    <item>
      <title>‘স্পেনেই হবে ২০৩০ বিশ্বকাপের ফাইনাল’</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%AA%E0%A6%A8%E0%A6%87-%E0%A6%B9%E0%A6%AC-%E0%A7%A8%E0%A7%A6%E0%A7%A9%E0%A7%A6-%E0%A6%AC%E0%A6%B6%E0%A6%AC%E0%A6%95%E0%A6%AA%E0%A6%B0-%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2</link>

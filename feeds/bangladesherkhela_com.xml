      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794932798_rkr_6afc803e50f46.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794932798_rkr_6afc803e50f46.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794932798_rkr_6afc803e50f46.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সমালোচনার মেঘ সরিয়ে ব্রাজিলের গোলবৃষ্টি" /&gt;&lt;/p&gt;&lt;p&gt;ফিফা র‌্যাঙ্কিংয়ে ব্রাজিলের অবস্থান ছয়ে, আর সিঙ্গাপুর ১৪৮ নম্বরে। শক্তি, সামর্থ্য, অভিজ্ঞতা কিংবা মাঠের পারফরম্যান্স সব দিক থেকেই দুই দলের ব্যবধান আকাশ-পাতাল। তবু ফুটবল বলে কথা, অনিশ্চয়তা আর রোমাঞ্চের সুযোগ তো থাকেই! তবে ফিফা উইন্ডোর প্রীতি ম্যাচে সিঙ্গাপুরের বিপক্ষে সেই ঝুঁকি নিতে চায়নি ব্রাজিল।আগে&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%AE%E0%A6%B2%E0%A6%9A%E0%A6%A8%E0%A6%B0-%E0%A6%AE%E0%A6%98-%E0%A6%B8%E0%A6%B0%E0%A7%9F-%E0%A6%AC%E0%A6%B0%E0%A6%9C%E0%A6%B2%E0%A6%B0-%E0%A6%97%E0%A6%B2%E0%A6%AC%E0%A6%B7%E0%A6%9F">Education Bangla</source>
    </item>

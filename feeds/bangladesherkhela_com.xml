      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795186111_rkr_6b005dbf81386.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795186111_rkr_6b005dbf81386.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795186111_rkr_6b005dbf81386.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অনুশীলনে ড্রোন চালিয়ে ক্ষমা, সরিয়ে নিলেন ফুটেজ" /&gt;&lt;/p&gt;&lt;p&gt;ম্যানচেস্টার ইউনাইটেডের প্রধান কোচ হিসেবে মরিসিও পচেত্তিনোর প্রথম অনুশীলন সেশনের কিছু অংশ ড্রোনে ধারণ করার পর সেই ভিডিও সরিয়ে নিয়েছেন এক ড্রোন অপারেটর। এ ঘটনায় নিজের ‘সম্পূর্ণ বিচারবুদ্ধিহীন’ সিদ্ধান্তের জন্য ক্ষমাও চেয়েছেন তিনি।বৃহস্পতিবার ক্লাবটির ক্যারিংটন অনুশীলন কমপ্লেক্সের কাছে ড্রোন উড়িয়ে ১২.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%85%E0%A6%A8%E0%A6%B6%E0%A6%B2%E0%A6%A8-%E0%A6%A1%E0%A6%B0%E0%A6%A8-%E0%A6%9A%E0%A6%B2%E0%A7%9F-%E0%A6%95%E0%A6%B7%E0%A6%AE-%E0%A6%B8%E0%A6%B0%E0%A7%9F-%E0%A6%A8%E0%A6%B2%E0%A6%A8-%E0%A6%AB%E0%A6%9F%E0%A6%9C">Education Bangla</source>
    </item>
    <item>
      <title>প্রতিপক্ষ ফুটবলারের লাথির আঘাতে ফুটবল মাঠে আবারও মৃত্যু</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AA%E0%A6%B0%E0%A6%A4%E0%A6%AA%E0%A6%95%E0%A6%B7-%E0%A6%AB%E0%A6%9F%E0%A6%AC%E0%A6%B2%E0%A6%B0%E0%A6%B0-%E0%A6%B2%E0%A6%A5%E0%A6%B0-%E0%A6%86%E0%A6%98%E0%A6%A4-%E0%A6%AB%E0%A6%9F%E0%A6%AC%E0%A6%B2-%E0%A6%AE%E0%A6%A0-%E0%A6%86%E0%A6%AC%E0%A6%B0%E0%A6%93-%E0%A6%AE%E0%A6%A4%E0%A6%AF</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AA%E0%A6%B0%E0%A6%A4%E0%A6%AA%E0%A6%95%E0%A6%B7-%E0%A6%AB%E0%A6%9F%E0%A6%AC%E0%A6%B2%E0%A6%B0%E0%A6%B0-%E0%A6%B2%E0%A6%A5%E0%A6%B0-%E0%A6%86%E0%A6%98%E0%A6%A4-%E0%A6%AB%E0%A6%9F%E0%A6%AC%E0%A6%B2-%E0%A6%AE%E0%A6%A0-%E0%A6%86%E0%A6%AC%E0%A6%B0%E0%A6%93-%E0%A6%AE%E0%A6%A4%E0%A6%AF</guid>
      <pubDate>Fri, 20 Nov 2026 14:36:17 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795185377_rkr_6b005ae1835d7.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795185377_rkr_6b005ae1835d7.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795185377_rkr_6b005ae1835d7.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রতিপক্ষ ফুটবলারের লাথির আঘাতে ফুটবল মাঠে আবারও মৃত্যু" /&gt;&lt;/p&gt;&lt;p&gt;কয়েক সপ্তাহের ব্যবধানে ফুটবল মাঠে আবারও একটি মৃত্যুর ঘটনা দেখা গেল। এবার ঘটনাটি ঘটেছে লিওনেল মেসির দেশ আর্জেন্টিনায়। বলের জন্য লড়াই করতে গিয়ে প্রতিপক্ষ ফুটবলারের লাথির আঘাতে মৃত্যু হয়েছে ১৮ বছরের ফুটবলার আবেল নুনেজের।ঘটনাটি ঘটেছে যুব দলের চতুর্থ ডিভিশনে এফসি এজেইজা বনাম দেপোর্তিভো মুনিজের ম্যাচে। এজ&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AA%E0%A6%B0%E0%A6%A4%E0%A6%AA%E0%A6%95%E0%A6%B7-%E0%A6%AB%E0%A6%9F%E0%A6%AC%E0%A6%B2%E0%A6%B0%E0%A6%B0-%E0%A6%B2%E0%A6%A5%E0%A6%B0-%E0%A6%86%E0%A6%98%E0%A6%A4-%E0%A6%AB%E0%A6%9F%E0%A6%AC%E0%A6%B2-%E0%A6%AE%E0%A6%A0-%E0%A6%86%E0%A6%AC%E0%A6%B0%E0%A6%93-%E0%A6%AE%E0%A6%A4%E0%A6%AF">Education Bangla</source>
    </item>
    <item>
      <title>ব্যাটিংয়ে ধুঁকলেও সহজ জয়েই এশিয়া কাপ শুরু পাকিস্তানের</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%AF%E0%A6%9F%E0%A7%9F-%E0%A6%A7%E0%A6%95%E0%A6%B2%E0%A6%93-%E0%A6%B8%E0%A6%B9%E0%A6%9C-%E0%A6%9C%E0%A7%9F%E0%A6%87-%E0%A6%8F%E0%A6%B6%E0%A7%9F-%E0%A6%95%E0%A6%AA-%E0%A6%B6%E0%A6%B0-%E0%A6%AA%E0%A6%95%E0%A6%B8%E0%A6%A4%E0%A6%A8%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%AF%E0%A6%9F%E0%A7%9F-%E0%A6%A7%E0%A6%95%E0%A6%B2%E0%A6%93-%E0%A6%B8%E0%A6%B9%E0%A6%9C-%E0%A6%9C%E0%A7%9F%E0%A6%87-%E0%A6%8F%E0%A6%B6%E0%A7%9F-%E0%A6%95%E0%A6%AA-%E0%A6%B6%E0%A6%B0-%E0%A6%AA%E0%A6%95%E0%A6%B8%E0%A6%A4%E0%A6%A8%E0%A6%B0</guid>
      <pubDate>Fri, 20 Nov 2026 14:35:16 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795185316_rkr_6b005aa44d55c.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795185316_rkr_6b005aa44d55c.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795185316_rkr_6b005aa44d55c.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ব্যাটিংয়ে ধুঁকলেও সহজ জয়েই এশিয়া কাপ শুরু পাকিস্তানের" /&gt;&lt;/p&gt;&lt;p&gt;ব্যাটিংটা তেমন ভালো হয়নি। ২৪৫ রানেই গুটিয়ে যায় পাকিস্তান ‘এ’ দল। তবে বোলাররা এই পুঁজি নিয়েই সহজ জয় এনে দিয়েছেন। দোহায় এশিয়া কাপ রাইজিং স্টারস ওয়ানডে টুর্নামেন্টে সংযুক্ত আরব আমিরাতকে ৬১ রানে হারিয়ে শুভসূচনা করেছে পাকিস্তান ‘এ’।টস হেরে ব্যাট করতে নামে পাকিস্তান ‘এ’ দল। দুই ওপেনারই ফিফটি তুলে নেন। শাম&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%AF%E0%A6%9F%E0%A7%9F-%E0%A6%A7%E0%A6%95%E0%A6%B2%E0%A6%93-%E0%A6%B8%E0%A6%B9%E0%A6%9C-%E0%A6%9C%E0%A7%9F%E0%A6%87-%E0%A6%8F%E0%A6%B6%E0%A7%9F-%E0%A6%95%E0%A6%AA-%E0%A6%B6%E0%A6%B0-%E0%A6%AA%E0%A6%95%E0%A6%B8%E0%A6%A4%E0%A6%A8%E0%A6%B0">Education Bangla</source>
    </item>
    <item>
      <title>প্রোটিয়াদের বিপক্ষে দ্বিতীয় টেস্ট থেকে ছিটকে গেলেন হাসান মাহমুদ</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AA%E0%A6%B0%E0%A6%9F%E0%A7%9F%E0%A6%A6%E0%A6%B0-%E0%A6%AC%E0%A6%AA%E0%A6%95%E0%A6%B7-%E0%A6%A6%E0%A6%AC%E0%A6%A4%E0%A7%9F-%E0%A6%9F%E0%A6%B8%E0%A6%9F-%E0%A6%A5%E0%A6%95-%E0%A6%9B%E0%A6%9F%E0%A6%95-%E0%A6%97%E0%A6%B2%E0%A6%A8-%E0%A6%B9%E0%A6%B8%E0%A6%A8-%E0%A6%AE%E0%A6%B9%E0%A6%AE%E0%A6%A6</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AA%E0%A6%B0%E0%A6%9F%E0%A7%9F%E0%A6%A6%E0%A6%B0-%E0%A6%AC%E0%A6%AA%E0%A6%95%E0%A6%B7-%E0%A6%A6%E0%A6%AC%E0%A6%A4%E0%A7%9F-%E0%A6%9F%E0%A6%B8%E0%A6%9F-%E0%A6%A5%E0%A6%95-%E0%A6%9B%E0%A6%9F%E0%A6%95-%E0%A6%97%E0%A6%B2%E0%A6%A8-%E0%A6%B9%E0%A6%B8%E0%A6%A8-%E0%A6%AE%E0%A6%B9%E0%A6%AE%E0%A6%A6</guid>
      <pubDate>Fri, 20 Nov 2026 14:07:04 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795183624_rkr_6b00540820ba2.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795183624_rkr_6b00540820ba2.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795183624_rkr_6b00540820ba2.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রোটিয়াদের বিপক্ষে দ্বিতীয় টেস্ট থেকে ছিটকে গেলেন হাসান মাহমুদ" /&gt;&lt;/p&gt;&lt;p&gt;জোহানেসবার্গে প্রথম টেস্ট চলাকালে দীর্ঘদিনের পুরোনো &amp;#039;টেনিস এলবো&amp;#039; চোট বেড়ে যাওয়ায় দক্ষিণ আফ্রিকার বিপক্ষে সেঞ্চুরিয়নে অনুষ্ঠিতব্য দ্বিতীয় টেস্ট থেকে ছিটকে গেছেন বাংলাদেশি পেসার হাসান মাহমুদ।প্রথম টেস্টের আগে থেকেই ডান হাতের কনুইয়ে অস্বস্তি নিয়ে খেলছিলেন ডানহাতি এই পেসার এবং ওয়ান্ডারার্সে বো&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AA%E0%A6%B0%E0%A6%9F%E0%A7%9F%E0%A6%A6%E0%A6%B0-%E0%A6%AC%E0%A6%AA%E0%A6%95%E0%A6%B7-%E0%A6%A6%E0%A6%AC%E0%A6%A4%E0%A7%9F-%E0%A6%9F%E0%A6%B8%E0%A6%9F-%E0%A6%A5%E0%A6%95-%E0%A6%9B%E0%A6%9F%E0%A6%95-%E0%A6%97%E0%A6%B2%E0%A6%A8-%E0%A6%B9%E0%A6%B8%E0%A6%A8-%E0%A6%AE%E0%A6%B9%E0%A6%AE%E0%A6%A6">Education Bangla</source>
    </item>
    <item>
      <title>ইনফান্তিনোকে হারাতে দিয়ালোর সঙ্গে সমঝোতা চান জাপানের ফিফা সভাপতি প্রার্থী</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%87%E0%A6%A8%E0%A6%AB%E0%A6%A8%E0%A6%A4%E0%A6%A8%E0%A6%95-%E0%A6%B9%E0%A6%B0%E0%A6%A4-%E0%A6%A6%E0%A7%9F%E0%A6%B2%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A6%97-%E0%A6%B8%E0%A6%AE%E0%A6%9D%E0%A6%A4-%E0%A6%9A%E0%A6%A8-%E0%A6%9C%E0%A6%AA%E0%A6%A8%E0%A6%B0-%E0%A6%AB%E0%A6%AB-%E0%A6%B8%E0%A6%AD%E0%A6%AA%E0%A6%A4-%E0%A6%AA%E0%A6%B0%E0%A6%B0%E0%A6%A5</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%87%E0%A6%A8%E0%A6%AB%E0%A6%A8%E0%A6%A4%E0%A6%A8%E0%A6%95-%E0%A6%B9%E0%A6%B0%E0%A6%A4-%E0%A6%A6%E0%A7%9F%E0%A6%B2%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A6%97-%E0%A6%B8%E0%A6%AE%E0%A6%9D%E0%A6%A4-%E0%A6%9A%E0%A6%A8-%E0%A6%9C%E0%A6%AA%E0%A6%A8%E0%A6%B0-%E0%A6%AB%E0%A6%AB-%E0%A6%B8%E0%A6%AD%E0%A6%AA%E0%A6%A4-%E0%A6%AA%E0%A6%B0%E0%A6%B0%E0%A6%A5</guid>
      <pubDate>Fri, 20 Nov 2026 13:39:10 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795181950_rkr_6b004d7ef13cb.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795181950_rkr_6b004d7ef13cb.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795181950_rkr_6b004d7ef13cb.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইনফান্তিনোকে হারাতে দিয়ালোর সঙ্গে সমঝোতা চান জাপানের ফিফা সভাপতি প্রার্থী" /&gt;&lt;/p&gt;&lt;p&gt;ফিফা সভাপতি পদে নির্বাচনের জন্য জিয়ান্নি ইনফান্তিনো বাদে মনোনয়নপত্র জমা দেওয়া দুজনের একজন জাপানের কোহজো তাশিমা। ইনফান্তিনোর চতুর্থ মেয়াদে নির্বাচিত হওয়া ঠেকাতে আরেক প্রার্থী ফিলিপ দিয়ালোর সঙ্গে মিলে কাজ করতে চান তিনি।ফিফার ক্ষমতায় রদবদল আনার জন্যই তাশিমার প্রতিপক্ষের সঙ্গে এক হয়ে কাজ করার ইচ্ছা। যদি&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%87%E0%A6%A8%E0%A6%AB%E0%A6%A8%E0%A6%A4%E0%A6%A8%E0%A6%95-%E0%A6%B9%E0%A6%B0%E0%A6%A4-%E0%A6%A6%E0%A7%9F%E0%A6%B2%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A6%97-%E0%A6%B8%E0%A6%AE%E0%A6%9D%E0%A6%A4-%E0%A6%9A%E0%A6%A8-%E0%A6%9C%E0%A6%AA%E0%A6%A8%E0%A6%B0-%E0%A6%AB%E0%A6%AB-%E0%A6%B8%E0%A6%AD%E0%A6%AA%E0%A6%A4-%E0%A6%AA%E0%A6%B0%E0%A6%B0%E0%A6%A5">Education Bangla</source>
    </item>

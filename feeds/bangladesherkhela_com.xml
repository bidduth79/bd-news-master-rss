      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794667271_rkr_6af873074de88.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794667271_rkr_6af873074de88.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="স্টেডিয়ামে লাল-সবুজের জার্সি-পতাকায় উৎসব" /&gt;&lt;/p&gt;&lt;p&gt;পাকিস্তানের বিপক্ষে সাফ চ্যাম্পিয়নশিপের গুরুত্বপূর্ণ সেমিফাইনাল ঘিরে উৎসবের আমেজ ঢাকার জাতীয় স্টেডিয়াম এলাকায়। ফাইনালে ওঠার স্বপ্ন নিয়ে শনিবার বিকেল থেকেই স্টেডিয়ামে আসতে শুরু করেন বাংলাদেশ দলের সমর্থকরা। ম্যাচ শুরুর আগেই গ্যালারি ভরাতে দেখা যায় ফুটবলপ্রেমীদের। রাত ৮টা ৩০ মিনিটে ম্যাচ শুরুর ক&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%9F%E0%A6%A1%E0%A6%AF%E0%A6%AE-%E0%A6%B2%E0%A6%B2-%E0%A6%B8%E0%A6%AC%E0%A6%9C%E0%A6%B0-%E0%A6%9C%E0%A6%B0%E0%A6%B8-%E0%A6%AA%E0%A6%A4%E0%A6%95%E0%A6%AF-%E0%A6%89%E0%A7%8E%E0%A6%B8%E0%A6%AC">Education Bangla</source>
    </item>
    <item>
      <title>বল টেম্পারিং নিয়ে এবার ক্রিকেট অস্ট্রেলিয়ার কড়া সমালোচনায় ওয়ার্নার</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%B2-%E0%A6%9F%E0%A6%AE%E0%A6%AA%E0%A6%B0-%E0%A6%A8%E0%A7%9F-%E0%A6%8F%E0%A6%AC%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%95%E0%A6%9F-%E0%A6%85%E0%A6%B8%E0%A6%9F%E0%A6%B0%E0%A6%B2%E0%A7%9F%E0%A6%B0-%E0%A6%95%E0%A7%9C-%E0%A6%B8%E0%A6%AE%E0%A6%B2%E0%A6%9A%E0%A6%A8%E0%A7%9F-%E0%A6%93%E0%A7%9F%E0%A6%B0%E0%A6%A8%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%B2-%E0%A6%9F%E0%A6%AE%E0%A6%AA%E0%A6%B0-%E0%A6%A8%E0%A7%9F-%E0%A6%8F%E0%A6%AC%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%95%E0%A6%9F-%E0%A6%85%E0%A6%B8%E0%A6%9F%E0%A6%B0%E0%A6%B2%E0%A7%9F%E0%A6%B0-%E0%A6%95%E0%A7%9C-%E0%A6%B8%E0%A6%AE%E0%A6%B2%E0%A6%9A%E0%A6%A8%E0%A7%9F-%E0%A6%93%E0%A7%9F%E0%A6%B0%E0%A6%A8%E0%A6%B0</guid>
      <pubDate>Sat, 14 Nov 2026 13:21:32 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794662492_rkr_6af8605c31ee3.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794662492_rkr_6af8605c31ee3.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794662492_rkr_6af8605c31ee3.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বল টেম্পারিং নিয়ে এবার ক্রিকেট অস্ট্রেলিয়ার কড়া সমালোচনায় ওয়ার্নার" /&gt;&lt;/p&gt;&lt;p&gt;২০১৮ সালের কেপ টাউন বল টেম্পারিং কেলেঙ্কারির তদন্ত প্রক্রিয়াকে ‘ধামাচাপা দেওয়ার চেষ্টা’ এবং ‘ত্রুটিপূর্ণ তদন্ত’ বলে অভিহিত করে ক্রিকেট অস্ট্রেলিয়ার (সিএ) তীব্র সমালোচনা করেছেন সাবেক অজি ওপেনার ডেভিড ওয়ার্নার। শনিবার ইনস্টাগ্রামে দেওয়া এক বিস্ফোরক পোস্টে তিনি এই অভিযোগ তোলেন, যা অস্ট্রেলিয়ান ক্রিকেটে&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%B2-%E0%A6%9F%E0%A6%AE%E0%A6%AA%E0%A6%B0-%E0%A6%A8%E0%A7%9F-%E0%A6%8F%E0%A6%AC%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%95%E0%A6%9F-%E0%A6%85%E0%A6%B8%E0%A6%9F%E0%A6%B0%E0%A6%B2%E0%A7%9F%E0%A6%B0-%E0%A6%95%E0%A7%9C-%E0%A6%B8%E0%A6%AE%E0%A6%B2%E0%A6%9A%E0%A6%A8%E0%A7%9F-%E0%A6%93%E0%A7%9F%E0%A6%B0%E0%A6%A8%E0%A6%B0">Education Bangla</source>
    </item>

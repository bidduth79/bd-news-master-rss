      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%85%E0%A6%A8%E0%A6%B6%E0%A6%B2%E0%A6%A8-%E0%A6%AE%E0%A6%A0-%E0%A6%AA%E0%A6%B2%E0%A6%B6%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%AF%E0%A6%A8-%E0%A6%97%E0%A6%B0%E0%A6%AA%E0%A6%A4%E0%A6%B0-%E0%A6%AC%E0%A6%B0%E0%A6%9C%E0%A6%B2%E0%A7%9F%E0%A6%A8-%E0%A6%AB%E0%A6%9F%E0%A6%AC%E0%A6%B2%E0%A6%B0</guid>

    <item>
      <title>কিছুদিন আগে আলো ছড়ান বড় ভাই, এবার শেবাগের ছোট ছেলের অবিশ্বাস্য কীর্তি</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%95%E0%A6%9B%E0%A6%A6%E0%A6%A8-%E0%A6%86%E0%A6%97-%E0%A6%86%E0%A6%B2-%E0%A6%9B%E0%A7%9C%E0%A6%A8-%E0%A6%AC%E0%A7%9C-%E0%A6%AD%E0%A6%87-%E0%A6%8F%E0%A6%AC%E0%A6%B0-%E0%A6%B6%E0%A6%AC%E0%A6%97%E0%A6%B0-%E0%A6%9B%E0%A6%9F-%E0%A6%9B%E0%A6%B2%E0%A6%B0-%E0%A6%85%E0%A6%AC%E0%A6%B6%E0%A6%AC%E0%A6%B8%E0%A6%AF-%E0%A6%95%E0%A6%B0%E0%A6%A4</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%95%E0%A6%9B%E0%A6%A6%E0%A6%A8-%E0%A6%86%E0%A6%97-%E0%A6%86%E0%A6%B2-%E0%A6%9B%E0%A7%9C%E0%A6%A8-%E0%A6%AC%E0%A7%9C-%E0%A6%AD%E0%A6%87-%E0%A6%8F%E0%A6%AC%E0%A6%B0-%E0%A6%B6%E0%A6%AC%E0%A6%97%E0%A6%B0-%E0%A6%9B%E0%A6%9F-%E0%A6%9B%E0%A6%B2%E0%A6%B0-%E0%A6%85%E0%A6%AC%E0%A6%B6%E0%A6%AC%E0%A6%B8%E0%A6%AF-%E0%A6%95%E0%A6%B0%E0%A6%A4</guid>
      <pubDate>Thu, 26 Nov 2026 16:35:10 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795710910_rkr_6b085fbe12985.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795710910_rkr_6b085fbe12985.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795710910_rkr_6b085fbe12985.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কিছুদিন আগে আলো ছড়ান বড় ভাই, এবার শেবাগের ছোট ছেলের অবিশ্বাস্য কীর্তি" /&gt;&lt;/p&gt;&lt;p&gt;ক্রিকেট মাঠে বাবার মতোই আলো ছড়াতে শুরু করেছেন বীরেন্দ্র শেবাগের দুই ছেলে। কিছুদিন আগে বড় ছেলে আর্যবীর শেবাগ অনূর্ধ্ব-১৯ এশিয়া কাপে দুর্দান্ত পারফরম্যান্স করে জিতেছিলেন টুর্নামেন্টসেরার পুরস্কার। এবার বল হাতে চমক দেখালেন শেবাগের ছোট ছেলে বেদান্ত শেবাগ। কুচবিহার ট্রফিতে দিল্লি অনূর্ধ্ব-১৯ দলের হয়ে পাঞ&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%95%E0%A6%9B%E0%A6%A6%E0%A6%A8-%E0%A6%86%E0%A6%97-%E0%A6%86%E0%A6%B2-%E0%A6%9B%E0%A7%9C%E0%A6%A8-%E0%A6%AC%E0%A7%9C-%E0%A6%AD%E0%A6%87-%E0%A6%8F%E0%A6%AC%E0%A6%B0-%E0%A6%B6%E0%A6%AC%E0%A6%97%E0%A6%B0-%E0%A6%9B%E0%A6%9F-%E0%A6%9B%E0%A6%B2%E0%A6%B0-%E0%A6%85%E0%A6%AC%E0%A6%B6%E0%A6%AC%E0%A6%B8%E0%A6%AF-%E0%A6%95%E0%A6%B0%E0%A6%A4">Education Bangla</source>
    </item>
    <item>
      <title>ওমানের হকি ক্লাবের আমন্ত্রণ পেলেন বাংলাদেশের ৩ খেলোয়াড়</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%93%E0%A6%AE%E0%A6%A8%E0%A6%B0-%E0%A6%B9%E0%A6%95-%E0%A6%95%E0%A6%B2%E0%A6%AC%E0%A6%B0-%E0%A6%86%E0%A6%AE%E0%A6%A8%E0%A6%A4%E0%A6%B0%E0%A6%A3-%E0%A6%AA%E0%A6%B2%E0%A6%A8-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6%E0%A6%B0-%E0%A7%A9-%E0%A6%96%E0%A6%B2%E0%A7%9F%E0%A7%9C</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%93%E0%A6%AE%E0%A6%A8%E0%A6%B0-%E0%A6%B9%E0%A6%95-%E0%A6%95%E0%A6%B2%E0%A6%AC%E0%A6%B0-%E0%A6%86%E0%A6%AE%E0%A6%A8%E0%A6%A4%E0%A6%B0%E0%A6%A3-%E0%A6%AA%E0%A6%B2%E0%A6%A8-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6%E0%A6%B0-%E0%A7%A9-%E0%A6%96%E0%A6%B2%E0%A7%9F%E0%A7%9C</guid>
      <pubDate>Thu, 26 Nov 2026 16:22:32 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795710152_rkr_6b085cc8e18b3.png" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795710152_rkr_6b085cc8e18b3.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795710152_rkr_6b085cc8e18b3.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ওমানের হকি ক্লাবের আমন্ত্রণ পেলেন বাংলাদেশের ৩ খেলোয়াড়" /&gt;&lt;/p&gt;&lt;p&gt;ওমানের হকিতে খেলার আমন্ত্রণ পেয়েছেন বাংলাদেশের তিন হকি খেলোয়াড়। তারা হলেন জাতীয় দলের বিপ্লব কুজুর, আমিরুল ইসলাম ও রাকিবুল ইসলাম রকি। দেশটির আল ইত্তিহাদ হকি ক্লাবের হয়ে ৫৬তম হিজ ম্যাজেস্টি’স হকি কাপ ২০২৬-এ খেলার জন্য তাদের আমন্ত্রণ জানানো হয়েছে।আগামী ৮ থেকে ২৩ ডিসেম্বর ওমানের রাজধানী মাসকাটে অনুষ্ঠিত&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%93%E0%A6%AE%E0%A6%A8%E0%A6%B0-%E0%A6%B9%E0%A6%95-%E0%A6%95%E0%A6%B2%E0%A6%AC%E0%A6%B0-%E0%A6%86%E0%A6%AE%E0%A6%A8%E0%A6%A4%E0%A6%B0%E0%A6%A3-%E0%A6%AA%E0%A6%B2%E0%A6%A8-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6%E0%A6%B0-%E0%A7%A9-%E0%A6%96%E0%A6%B2%E0%A7%9F%E0%A7%9C">Education Bangla</source>
    </item>
    <item>
      <title>সিঙ্গাপুরের বিপক্ষে পরীক্ষায় বাংলাদেশ, বাটলারের কৌশলে আস্থা মেয়ারের</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%99%E0%A6%97%E0%A6%AA%E0%A6%B0%E0%A6%B0-%E0%A6%AC%E0%A6%AA%E0%A6%95%E0%A6%B7-%E0%A6%AA%E0%A6%B0%E0%A6%95%E0%A6%B7%E0%A7%9F-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6-%E0%A6%AC%E0%A6%9F%E0%A6%B2%E0%A6%B0%E0%A6%B0-%E0%A6%95%E0%A6%B6%E0%A6%B2-%E0%A6%86%E0%A6%B8%E0%A6%A5-%E0%A6%AE%E0%A7%9F%E0%A6%B0%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%99%E0%A6%97%E0%A6%AA%E0%A6%B0%E0%A6%B0-%E0%A6%AC%E0%A6%AA%E0%A6%95%E0%A6%B7-%E0%A6%AA%E0%A6%B0%E0%A6%95%E0%A6%B7%E0%A7%9F-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6-%E0%A6%AC%E0%A6%9F%E0%A6%B2%E0%A6%B0%E0%A6%B0-%E0%A6%95%E0%A6%B6%E0%A6%B2-%E0%A6%86%E0%A6%B8%E0%A6%A5-%E0%A6%AE%E0%A7%9F%E0%A6%B0%E0%A6%B0</guid>
      <pubDate>Thu, 26 Nov 2026 16:21:33 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795710093_rkr_6b085c8db35f6.png" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795710093_rkr_6b085c8db35f6.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795710093_rkr_6b085c8db35f6.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সিঙ্গাপুরের বিপক্ষে পরীক্ষায় বাংলাদেশ, বাটলারের কৌশলে আস্থা মেয়ারের" /&gt;&lt;/p&gt;&lt;p&gt;দুই সপ্তাহের প্রস্তুতি, নতুন দায়িত্ব, আর সামনে সিঙ্গাপুরের বিপক্ষে দুটি আন্তর্জাতিক প্রীতি ম্যাচ-বাংলাদেশ নারী ফুটবল দলের দায়িত্ব নিয়ে প্রথম পরীক্ষার মুখোমুখি হতে যাচ্ছেন ফরাসি কোচ এরিক মেয়ার। তবে স্বল্প সময়ের প্রস্তুতিতে দলের খেলার ধরনে বড় কোনো পরিবর্তন আনতে চান না তিনি। বরং সাবেক কোচ পিটার বাটলারে&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%99%E0%A6%97%E0%A6%AA%E0%A6%B0%E0%A6%B0-%E0%A6%AC%E0%A6%AA%E0%A6%95%E0%A6%B7-%E0%A6%AA%E0%A6%B0%E0%A6%95%E0%A6%B7%E0%A7%9F-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6-%E0%A6%AC%E0%A6%9F%E0%A6%B2%E0%A6%B0%E0%A6%B0-%E0%A6%95%E0%A6%B6%E0%A6%B2-%E0%A6%86%E0%A6%B8%E0%A6%A5-%E0%A6%AE%E0%A7%9F%E0%A6%B0%E0%A6%B0">Education Bangla</source>
    </item>
    <item>
      <title>বিমসটেক অ্যাথলেটিকসে রেকর্ড গড়ে স্বপ্নার রুপা জয়</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%AE%E0%A6%B8%E0%A6%9F%E0%A6%95-%E0%A6%85%E0%A6%AF%E0%A6%A5%E0%A6%B2%E0%A6%9F%E0%A6%95%E0%A6%B8-%E0%A6%B0%E0%A6%95%E0%A6%B0%E0%A6%A1-%E0%A6%97%E0%A7%9C-%E0%A6%B8%E0%A6%AC%E0%A6%AA%E0%A6%A8%E0%A6%B0-%E0%A6%B0%E0%A6%AA-%E0%A6%9C%E0%A7%9F</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%AE%E0%A6%B8%E0%A6%9F%E0%A6%95-%E0%A6%85%E0%A6%AF%E0%A6%A5%E0%A6%B2%E0%A6%9F%E0%A6%95%E0%A6%B8-%E0%A6%B0%E0%A6%95%E0%A6%B0%E0%A6%A1-%E0%A6%97%E0%A7%9C-%E0%A6%B8%E0%A6%AC%E0%A6%AA%E0%A6%A8%E0%A6%B0-%E0%A6%B0%E0%A6%AA-%E0%A6%9C%E0%A7%9F</guid>
      <pubDate>Thu, 26 Nov 2026 16:20:11 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795710011_rkr_6b085c3b0daa9.png" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795710011_rkr_6b085c3b0daa9.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795710011_rkr_6b085c3b0daa9.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিমসটেক অ্যাথলেটিকসে রেকর্ড গড়ে স্বপ্নার রুপা জয়" /&gt;&lt;/p&gt;&lt;p&gt;বিমসটেক অনূর্ধ্ব-২৩ অ্যাথলেটিকস মিটে নতুন জাতীয় রেকর্ড গড়ে রুপার পদক জিতেছেন বাংলাদেশের স্বপ্না খাতুন। ভারতের ওড়িশা রাজ্যের ভুবনেশ্বরের কলিঙ্গ স্টেডিয়ামে প্রতিযোগিতার দ্বিতীয় দিনে মেয়েদের ট্রিপল জাম্পে এই কৃতিত্ব দেখান বাংলাদেশের অ্যাথলেট।ফাইনালে নিজের পঞ্চম প্রচেষ্টায় ১৩.২২ মিটার লাফিয়ে দ্বিতীয় স্থ&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%AE%E0%A6%B8%E0%A6%9F%E0%A6%95-%E0%A6%85%E0%A6%AF%E0%A6%A5%E0%A6%B2%E0%A6%9F%E0%A6%95%E0%A6%B8-%E0%A6%B0%E0%A6%95%E0%A6%B0%E0%A6%A1-%E0%A6%97%E0%A7%9C-%E0%A6%B8%E0%A6%AC%E0%A6%AA%E0%A6%A8%E0%A6%B0-%E0%A6%B0%E0%A6%AA-%E0%A6%9C%E0%A7%9F">Education Bangla</source>
    </item>

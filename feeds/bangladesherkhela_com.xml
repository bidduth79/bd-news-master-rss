    <item>
      <title>ইংল্যান্ডের বিপক্ষে টি-টোয়েন্টি সিরিজ থেকে ছিটকে গেলেন অস্ট্রেলিয়ার দুই পেসার</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%87%E0%A6%B2%E0%A6%AF%E0%A6%A8%E0%A6%A1%E0%A6%B0-%E0%A6%AC%E0%A6%AA%E0%A6%95%E0%A6%B7-%E0%A6%9F-%E0%A6%9F%E0%A7%9F%E0%A6%A8%E0%A6%9F-%E0%A6%B8%E0%A6%B0%E0%A6%9C-%E0%A6%A5%E0%A6%95-%E0%A6%9B%E0%A6%9F%E0%A6%95-%E0%A6%97%E0%A6%B2%E0%A6%A8-%E0%A6%85%E0%A6%B8%E0%A6%9F%E0%A6%B0%E0%A6%B2%E0%A7%9F%E0%A6%B0-%E0%A6%A6%E0%A6%87-%E0%A6%AA%E0%A6%B8%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%87%E0%A6%B2%E0%A6%AF%E0%A6%A8%E0%A6%A1%E0%A6%B0-%E0%A6%AC%E0%A6%AA%E0%A6%95%E0%A6%B7-%E0%A6%9F-%E0%A6%9F%E0%A7%9F%E0%A6%A8%E0%A6%9F-%E0%A6%B8%E0%A6%B0%E0%A6%9C-%E0%A6%A5%E0%A6%95-%E0%A6%9B%E0%A6%9F%E0%A6%95-%E0%A6%97%E0%A6%B2%E0%A6%A8-%E0%A6%85%E0%A6%B8%E0%A6%9F%E0%A6%B0%E0%A6%B2%E0%A7%9F%E0%A6%B0-%E0%A6%A6%E0%A6%87-%E0%A6%AA%E0%A6%B8%E0%A6%B0</guid>
      <pubDate>Fri, 20 Nov 2026 16:30:41 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795192241_rkr_6b0075b110d06.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795192241_rkr_6b0075b110d06.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795192241_rkr_6b0075b110d06.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইংল্যান্ডের বিপক্ষে টি-টোয়েন্টি সিরিজ থেকে ছিটকে গেলেন অস্ট্রেলিয়ার দুই পেসার" /&gt;&lt;/p&gt;&lt;p&gt;চোটের কারণে অস্ট্রেলিয়ার পেস আক্রমণের শঙ্কা আরও বেড়েছে। ইংল্যান্ডের বিপক্ষে পাঁচ ম্যাচের টি-টোয়েন্টি সিরিজ থেকে ছিটকে গেছেন মাহলি বিয়ার্ডম্যান ও জেভিয়ার বার্টলেট।বিয়ার্ডম্যানের বাঁ উরুর সামনের পেশিতে (কোয়াড্রিসেপস) টান লেগেছে। অন্যদিকে, বাঁ হাঁটুর চোটে পড়েছেন বার্টলেট। রোববার মেলবোর্ন ক্রিকেট গ্রাউন&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%87%E0%A6%B2%E0%A6%AF%E0%A6%A8%E0%A6%A1%E0%A6%B0-%E0%A6%AC%E0%A6%AA%E0%A6%95%E0%A6%B7-%E0%A6%9F-%E0%A6%9F%E0%A7%9F%E0%A6%A8%E0%A6%9F-%E0%A6%B8%E0%A6%B0%E0%A6%9C-%E0%A6%A5%E0%A6%95-%E0%A6%9B%E0%A6%9F%E0%A6%95-%E0%A6%97%E0%A6%B2%E0%A6%A8-%E0%A6%85%E0%A6%B8%E0%A6%9F%E0%A6%B0%E0%A6%B2%E0%A7%9F%E0%A6%B0-%E0%A6%A6%E0%A6%87-%E0%A6%AA%E0%A6%B8%E0%A6%B0">Education Bangla</source>
    </item>
    <item>
      <title>স্যান্ডপেপারগেট বিতর্কের মাঝেও অধিনায়ক থাকছেন কামিন্স!</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%AF%E0%A6%A8%E0%A6%A1%E0%A6%AA%E0%A6%AA%E0%A6%B0%E0%A6%97%E0%A6%9F-%E0%A6%AC%E0%A6%A4%E0%A6%B0%E0%A6%95%E0%A6%B0-%E0%A6%AE%E0%A6%9D%E0%A6%93-%E0%A6%85%E0%A6%A7%E0%A6%A8%E0%A7%9F%E0%A6%95-%E0%A6%A5%E0%A6%95%E0%A6%9B%E0%A6%A8-%E0%A6%95%E0%A6%AE%E0%A6%A8%E0%A6%B8</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%AF%E0%A6%A8%E0%A6%A1%E0%A6%AA%E0%A6%AA%E0%A6%B0%E0%A6%97%E0%A6%9F-%E0%A6%AC%E0%A6%A4%E0%A6%B0%E0%A6%95%E0%A6%B0-%E0%A6%AE%E0%A6%9D%E0%A6%93-%E0%A6%85%E0%A6%A7%E0%A6%A8%E0%A7%9F%E0%A6%95-%E0%A6%A5%E0%A6%95%E0%A6%9B%E0%A6%A8-%E0%A6%95%E0%A6%AE%E0%A6%A8%E0%A6%B8</guid>
      <pubDate>Fri, 20 Nov 2026 16:29:49 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795192189_rkr_6b00757de4382.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795192189_rkr_6b00757de4382.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795192189_rkr_6b00757de4382.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="স্যান্ডপেপারগেট বিতর্কের মাঝেও অধিনায়ক থাকছেন কামিন্স!" /&gt;&lt;/p&gt;&lt;p&gt;স্যান্ডপেপার ব্যবহার করে বল টেম্পারিংয়ের ঘটনায় মূল অভিযুক্ত ক্যামেরন ব্যানক্রফটও সম্প্রতি মুখ খুলেছেন। যেখানে ভূমিকা ছিল অস্ট্রেলিয়ার বর্তমান টেস্ট অধিনায়ক প্যাট কামিন্সের। দুজনের অবস্থান বিপরীত হলেও, এটাই বাস্তবতা। মূলত উসমান খাজার করা ‘পুরো দলই স্যান্ডপেপার ব্যবহারের কথা জানত’ দাবি অস্বীকার করেছেন&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%AF%E0%A6%A8%E0%A6%A1%E0%A6%AA%E0%A6%AA%E0%A6%B0%E0%A6%97%E0%A6%9F-%E0%A6%AC%E0%A6%A4%E0%A6%B0%E0%A6%95%E0%A6%B0-%E0%A6%AE%E0%A6%9D%E0%A6%93-%E0%A6%85%E0%A6%A7%E0%A6%A8%E0%A7%9F%E0%A6%95-%E0%A6%A5%E0%A6%95%E0%A6%9B%E0%A6%A8-%E0%A6%95%E0%A6%AE%E0%A6%A8%E0%A6%B8">Education Bangla</source>
    </item>
    <item>
      <title>নেপালকে ২৬ রানে গুটিয়ে ভারতের বিশাল জয়</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%A8%E0%A6%AA%E0%A6%B2%E0%A6%95-%E0%A7%A8%E0%A7%AC-%E0%A6%B0%E0%A6%A8-%E0%A6%97%E0%A6%9F%E0%A7%9F-%E0%A6%AD%E0%A6%B0%E0%A6%A4%E0%A6%B0-%E0%A6%AC%E0%A6%B6%E0%A6%B2-%E0%A6%9C%E0%A7%9F</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%A8%E0%A6%AA%E0%A6%B2%E0%A6%95-%E0%A7%A8%E0%A7%AC-%E0%A6%B0%E0%A6%A8-%E0%A6%97%E0%A6%9F%E0%A7%9F-%E0%A6%AD%E0%A6%B0%E0%A6%A4%E0%A6%B0-%E0%A6%AC%E0%A6%B6%E0%A6%B2-%E0%A6%9C%E0%A7%9F</guid>
      <pubDate>Fri, 20 Nov 2026 16:28:03 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795192083_rkr_6b007513a12c8.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795192083_rkr_6b007513a12c8.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795192083_rkr_6b007513a12c8.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নেপালকে ২৬ রানে গুটিয়ে ভারতের বিশাল জয়" /&gt;&lt;/p&gt;&lt;p&gt;কাতারের দোয়ায় রাইজিং স্টারস এশিয়া কাপে বিশাল জয়ে নিজেদের মিশন শুরু করল ভারত ‘এ’ দল। আসরের প্রথম ম্যাচেই নেপালকে মাত্র ২৬ রানে গুটিয়ে দিয়ে ৩০৬ রানের বিশাল ব্যবধানে জয় তুলে নিয়েছে তারা।শুক্রবার (২০ নভেম্বর) দোহার ইস্ট এন্ড পার্ক আন্তর্জাতিক ক্রিকেট স্টেডিয়ামে ম্যাচে আগে ব্যাট করে নির্ধারিত ৫০ ওভারে ৯.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%A8%E0%A6%AA%E0%A6%B2%E0%A6%95-%E0%A7%A8%E0%A7%AC-%E0%A6%B0%E0%A6%A8-%E0%A6%97%E0%A6%9F%E0%A7%9F-%E0%A6%AD%E0%A6%B0%E0%A6%A4%E0%A6%B0-%E0%A6%AC%E0%A6%B6%E0%A6%B2-%E0%A6%9C%E0%A7%9F">Education Bangla</source>
    </item>
    <item>
      <title>টাইম ম্যাগাজিনের ১০০ তরুণের তালিকায় বৈভব সূর্যবংশী</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%9F%E0%A6%87%E0%A6%AE-%E0%A6%AE%E0%A6%AF%E0%A6%97%E0%A6%9C%E0%A6%A8%E0%A6%B0-%E0%A7%A7%E0%A7%A6%E0%A7%A6-%E0%A6%A4%E0%A6%B0%E0%A6%A3%E0%A6%B0-%E0%A6%A4%E0%A6%B2%E0%A6%95%E0%A6%AF-%E0%A6%AC%E0%A6%AD%E0%A6%AC-%E0%A6%B8%E0%A6%B0%E0%A6%AF%E0%A6%AC%E0%A6%B6</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%9F%E0%A6%87%E0%A6%AE-%E0%A6%AE%E0%A6%AF%E0%A6%97%E0%A6%9C%E0%A6%A8%E0%A6%B0-%E0%A7%A7%E0%A7%A6%E0%A7%A6-%E0%A6%A4%E0%A6%B0%E0%A6%A3%E0%A6%B0-%E0%A6%A4%E0%A6%B2%E0%A6%95%E0%A6%AF-%E0%A6%AC%E0%A6%AD%E0%A6%AC-%E0%A6%B8%E0%A6%B0%E0%A6%AF%E0%A6%AC%E0%A6%B6</guid>
      <pubDate>Fri, 20 Nov 2026 15:51:36 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795189896_rkr_6b006c8816072.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795189896_rkr_6b006c8816072.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795189896_rkr_6b006c8816072.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টাইম ম্যাগাজিনের ১০০ তরুণের তালিকায় বৈভব সূর্যবংশী" /&gt;&lt;/p&gt;&lt;p&gt;বলিউডের তারকা, ব্যবসায়ী ও বিনোদনজগতের পরিচিত মুখদের ভিড়ে জায়গা করে নিয়েছেন ১৫ বছর বয়সী ক্রিকেটার বৈভব সূর্যবংশী। ভারতের ভবিষ্যৎ গঠনে সম্ভাবনাময় ১০০ ব্যক্তিত্বকে নিয়ে টাইম ম্যাগাজিনের প্রথমবারের মতো প্রকাশিত ‘টাইম১০০ নেক্সট ইন্ডিয়া’ তালিকায় স্থান পেয়েছেন এই বিস্ময়বালক।তালিকার ‘ইনোভেটরস’ বি&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%9F%E0%A6%87%E0%A6%AE-%E0%A6%AE%E0%A6%AF%E0%A6%97%E0%A6%9C%E0%A6%A8%E0%A6%B0-%E0%A7%A7%E0%A7%A6%E0%A7%A6-%E0%A6%A4%E0%A6%B0%E0%A6%A3%E0%A6%B0-%E0%A6%A4%E0%A6%B2%E0%A6%95%E0%A6%AF-%E0%A6%AC%E0%A6%AD%E0%A6%AC-%E0%A6%B8%E0%A6%B0%E0%A6%AF%E0%A6%AC%E0%A6%B6">Education Bangla</source>
    </item>

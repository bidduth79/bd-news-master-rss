      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795882329_rkr_6b0afd59848b5.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রিয়ালের বড় স্বস্তি" /&gt;&lt;/p&gt;&lt;p&gt;মাঠের পারফরম্যান্সে দাপট, চ্যাম্পিয়নস লিগে সাফল্য আর লা লিগার শিরোপা জয়ের নিয়ন্ত্রণ নিজেদের হাতে রাখা সব মিলিয়ে দুর্দান্ত সময় পার করছে রিয়াল মাদ্রিদ। তবে এবারের মৌসুমে মাঠের সাফল্যের বাইরেও ক্লাবটির সবচেয়ে বড় প্রাপ্তি চোটের তালিকা ছোট হয়ে আসা। গত কয়েক মৌসুমে ইনজুরির কারণে যখন একের পর এক খেলোয়াড়কে হা&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B0%E0%A7%9F%E0%A6%B2%E0%A6%B0-%E0%A6%AC%E0%A7%9C-%E0%A6%B8%E0%A6%AC%E0%A6%B8%E0%A6%A4">Education Bangla</source>
    </item>
    <item>
      <title>বার্সেলোনা ছাড়ার ২৮ বছর পর মুখ খুললেন রোনালদো</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%B0%E0%A6%B8%E0%A6%B2%E0%A6%A8-%E0%A6%9B%E0%A7%9C%E0%A6%B0-%E0%A7%A8%E0%A7%AE-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AE%E0%A6%96-%E0%A6%96%E0%A6%B2%E0%A6%B2%E0%A6%A8-%E0%A6%B0%E0%A6%A8%E0%A6%B2%E0%A6%A6</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%B0%E0%A6%B8%E0%A6%B2%E0%A6%A8-%E0%A6%9B%E0%A7%9C%E0%A6%B0-%E0%A7%A8%E0%A7%AE-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AE%E0%A6%96-%E0%A6%96%E0%A6%B2%E0%A6%B2%E0%A6%A8-%E0%A6%B0%E0%A6%A8%E0%A6%B2%E0%A6%A6</guid>
      <pubDate>Sat, 28 Nov 2026 16:10:11 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795882211_rkr_6b0afce35a70c.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795882211_rkr_6b0afce35a70c.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795882211_rkr_6b0afce35a70c.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বার্সেলোনা ছাড়ার ২৮ বছর পর মুখ খুললেন রোনালদো" /&gt;&lt;/p&gt;&lt;p&gt;বার্সেলোনা ছেড়ে ইন্টার মিলানে যোগ দেওয়ার ঘটনা নিয়ে অবশেষে মুখ খুলেছেন ব্রাজিলিয়ান কিংবদন্তি রোনালদো নাজারিও। প্রায় তিন দশক আগের সেই আলোচিত দলবদলের পেছনের কারণ জানিয়ে তিনি বলেছেন, ইতালিয়ান ক্লাবটির বিশাল আর্থিক প্রস্তাব উপেক্ষা করা তার পক্ষে সম্ভব ছিল না। ক্যারিয়ারের সেরা সময়েই বার্সেলোনা ছেড়ে ইন্টার&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%B0%E0%A6%B8%E0%A6%B2%E0%A6%A8-%E0%A6%9B%E0%A7%9C%E0%A6%B0-%E0%A7%A8%E0%A7%AE-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AE%E0%A6%96-%E0%A6%96%E0%A6%B2%E0%A6%B2%E0%A6%A8-%E0%A6%B0%E0%A6%A8%E0%A6%B2%E0%A6%A6">Education Bangla</source>
    </item>
    <item>
      <title>নিকো পাজের জন্য ১০০ মিলিয়ন পাউন্ডও ঢালতে প্রস্তুত আর্সেনাল</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%A8%E0%A6%95-%E0%A6%AA%E0%A6%9C%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A6%AF-%E0%A7%A7%E0%A7%A6%E0%A7%A6-%E0%A6%AE%E0%A6%B2%E0%A7%9F%E0%A6%A8-%E0%A6%AA%E0%A6%89%E0%A6%A8%E0%A6%A1%E0%A6%93-%E0%A6%A2%E0%A6%B2%E0%A6%A4-%E0%A6%AA%E0%A6%B0%E0%A6%B8%E0%A6%A4%E0%A6%A4-%E0%A6%86%E0%A6%B0%E0%A6%B8%E0%A6%A8%E0%A6%B2</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%A8%E0%A6%95-%E0%A6%AA%E0%A6%9C%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A6%AF-%E0%A7%A7%E0%A7%A6%E0%A7%A6-%E0%A6%AE%E0%A6%B2%E0%A7%9F%E0%A6%A8-%E0%A6%AA%E0%A6%89%E0%A6%A8%E0%A6%A1%E0%A6%93-%E0%A6%A2%E0%A6%B2%E0%A6%A4-%E0%A6%AA%E0%A6%B0%E0%A6%B8%E0%A6%A4%E0%A6%A4-%E0%A6%86%E0%A6%B0%E0%A6%B8%E0%A6%A8%E0%A6%B2</guid>
      <pubDate>Sat, 28 Nov 2026 16:09:19 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795882159_rkr_6b0afcaf5efd1.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795882159_rkr_6b0afcaf5efd1.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795882159_rkr_6b0afcaf5efd1.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নিকো পাজের জন্য ১০০ মিলিয়ন পাউন্ডও ঢালতে প্রস্তুত আর্সেনাল" /&gt;&lt;/p&gt;&lt;p&gt;মেসুত ওজিল কিংবা সান্তি কাজোরলার মতো সৃজনশীল মিডফিল্ডার খুঁজছে আর্সেনাল। দলটির ভবিষ্যৎ পরিকল্পনায় এবার উঠে এসেছে আর্জেন্টাইন তরুণ নিকো পাজের নাম। তাকে দলে পেতে বড় অঙ্কের অর্থ খরচ করতেও প্রস্তুত মিকেল আর্তেতার দল। তবে পাজকে পেতে আর্সেনালকে লড়তে হবে ম্যানচেস্টার ইউনাইটেডসহ ইউরোপের কয়েকটি বড় ক্লাবের সঙ&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%A8%E0%A6%95-%E0%A6%AA%E0%A6%9C%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A6%AF-%E0%A7%A7%E0%A7%A6%E0%A7%A6-%E0%A6%AE%E0%A6%B2%E0%A7%9F%E0%A6%A8-%E0%A6%AA%E0%A6%89%E0%A6%A8%E0%A6%A1%E0%A6%93-%E0%A6%A2%E0%A6%B2%E0%A6%A4-%E0%A6%AA%E0%A6%B0%E0%A6%B8%E0%A6%A4%E0%A6%A4-%E0%A6%86%E0%A6%B0%E0%A6%B8%E0%A6%A8%E0%A6%B2">Education Bangla</source>
    </item>
    <item>
      <title>রেসলার ব্রনসন রিডের মৃত্যুর রহস্য প্রকাশ</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B0%E0%A6%B8%E0%A6%B2%E0%A6%B0-%E0%A6%AC%E0%A6%B0%E0%A6%A8%E0%A6%B8%E0%A6%A8-%E0%A6%B0%E0%A6%A1%E0%A6%B0-%E0%A6%AE%E0%A6%A4%E0%A6%AF%E0%A6%B0-%E0%A6%B0%E0%A6%B9%E0%A6%B8%E0%A6%AF-%E0%A6%AA%E0%A6%B0%E0%A6%95%E0%A6%B6</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%B0%E0%A6%B8%E0%A6%B2%E0%A6%B0-%E0%A6%AC%E0%A6%B0%E0%A6%A8%E0%A6%B8%E0%A6%A8-%E0%A6%B0%E0%A6%A1%E0%A6%B0-%E0%A6%AE%E0%A6%A4%E0%A6%AF%E0%A6%B0-%E0%A6%B0%E0%A6%B9%E0%A6%B8%E0%A6%AF-%E0%A6%AA%E0%A6%B0%E0%A6%95%E0%A6%B6</guid>
      <pubDate>Sat, 28 Nov 2026 16:08:32 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795882112_rkr_6b0afc804b189.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795882112_rkr_6b0afc804b189.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795882112_rkr_6b0afc804b189.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রেসলার ব্রনসন রিডের মৃত্যুর রহস্য প্রকাশ" /&gt;&lt;/p&gt;&lt;p&gt;ডব্লিউডব্লিউই-তে বর্তমানে সবচেয়ে প্রভাবশালী ও শক্তিশালী রেসলারদের একজন ওবা ফেমি। তবে রেসলিং রিংয়ে পা রাখার অনেক আগে থেকেই নিজের শারীরিক সক্ষমতা ও অ্যাথলেটিক দক্ষতার পরিচয় দিয়েছিলেন নাইজেরিয়ায় জন্ম নেয়া এই তারকা। পেশাদার রেসলিংয়ে আসার আগে যুক্তরাষ্ট্রের ইউনিভার্সিটি অব আলাবামায় শটপাট অ্যাথলেট হিসেবে.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B0%E0%A6%B8%E0%A6%B2%E0%A6%B0-%E0%A6%AC%E0%A6%B0%E0%A6%A8%E0%A6%B8%E0%A6%A8-%E0%A6%B0%E0%A6%A1%E0%A6%B0-%E0%A6%AE%E0%A6%A4%E0%A6%AF%E0%A6%B0-%E0%A6%B0%E0%A6%B9%E0%A6%B8%E0%A6%AF-%E0%A6%AA%E0%A6%B0%E0%A6%95%E0%A6%B6">Education Bangla</source>
    </item>
    <item>
      <title>হাজার গোলের পথে রোনালদো: বিস্ফোরক মন্তব্য সাবেক আর্জেন্টাইন স্ট্রাইকারের</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B9%E0%A6%9C%E0%A6%B0-%E0%A6%97%E0%A6%B2%E0%A6%B0-%E0%A6%AA%E0%A6%A5-%E0%A6%B0%E0%A6%A8%E0%A6%B2%E0%A6%A6-%E0%A6%AC%E0%A6%B8%E0%A6%AB%E0%A6%B0%E0%A6%95-%E0%A6%AE%E0%A6%A8%E0%A6%A4%E0%A6%AC%E0%A6%AF-%E0%A6%B8%E0%A6%AC%E0%A6%95-%E0%A6%86%E0%A6%B0%E0%A6%9C%E0%A6%A8%E0%A6%9F%E0%A6%87%E0%A6%A8-%E0%A6%B8%E0%A6%9F%E0%A6%B0%E0%A6%87%E0%A6%95%E0%A6%B0%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%B9%E0%A6%9C%E0%A6%B0-%E0%A6%97%E0%A6%B2%E0%A6%B0-%E0%A6%AA%E0%A6%A5-%E0%A6%B0%E0%A6%A8%E0%A6%B2%E0%A6%A6-%E0%A6%AC%E0%A6%B8%E0%A6%AB%E0%A6%B0%E0%A6%95-%E0%A6%AE%E0%A6%A8%E0%A6%A4%E0%A6%AC%E0%A6%AF-%E0%A6%B8%E0%A6%AC%E0%A6%95-%E0%A6%86%E0%A6%B0%E0%A6%9C%E0%A6%A8%E0%A6%9F%E0%A6%87%E0%A6%A8-%E0%A6%B8%E0%A6%9F%E0%A6%B0%E0%A6%87%E0%A6%95%E0%A6%B0%E0%A6%B0</guid>
      <pubDate>Sat, 28 Nov 2026 16:07:36 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795882056_rkr_6b0afc483779e.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795882056_rkr_6b0afc483779e.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795882056_rkr_6b0afc483779e.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হাজার গোলের পথে রোনালদো: বিস্ফোরক মন্তব্য সাবেক আর্জেন্টাইন স্ট্রাইকারের" /&gt;&lt;/p&gt;&lt;p&gt;সের্হিও আগুয়েরোর ক্যারিয়ার থেমে গেছে মাত্র ৩৩ বছর বয়সে। হৃদযন্ত্রের সমস্যায় ফুটবলকে বিদায় বলতে হয়েছে আর্জেন্টিনার সাবেক এই স্ট্রাইকারকে। তবে আগুয়েরোর বিশ্বাস, খেলা চালিয়ে যেতে পারলে ক্রিশ্চিয়ানো রোনালদোর আগেই ছুঁতে পারতেন হাজার গোলের মাইলফলক! রোনালদোর গোলের রেকর্ডের প্রসঙ্গ উঠতেই নিজের অপূর্ণ স্বপ্ন&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B9%E0%A6%9C%E0%A6%B0-%E0%A6%97%E0%A6%B2%E0%A6%B0-%E0%A6%AA%E0%A6%A5-%E0%A6%B0%E0%A6%A8%E0%A6%B2%E0%A6%A6-%E0%A6%AC%E0%A6%B8%E0%A6%AB%E0%A6%B0%E0%A6%95-%E0%A6%AE%E0%A6%A8%E0%A6%A4%E0%A6%AC%E0%A6%AF-%E0%A6%B8%E0%A6%AC%E0%A6%95-%E0%A6%86%E0%A6%B0%E0%A6%9C%E0%A6%A8%E0%A6%9F%E0%A6%87%E0%A6%A8-%E0%A6%B8%E0%A6%9F%E0%A6%B0%E0%A6%87%E0%A6%95%E0%A6%B0%E0%A6%B0">Education Bangla</source>
    </item>
    <item>
      <title>ফের মুম্বাইয়ের অধিনায়ক হতে চাননি, রোহিততে রাজি করালেন কে</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AB%E0%A6%B0-%E0%A6%AE%E0%A6%AE%E0%A6%AC%E0%A6%87%E0%A7%9F%E0%A6%B0-%E0%A6%85%E0%A6%A7%E0%A6%A8%E0%A7%9F%E0%A6%95-%E0%A6%B9%E0%A6%A4-%E0%A6%9A%E0%A6%A8%E0%A6%A8-%E0%A6%B0%E0%A6%B9%E0%A6%A4%E0%A6%A4-%E0%A6%B0%E0%A6%9C-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A6%A8-%E0%A6%95</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AB%E0%A6%B0-%E0%A6%AE%E0%A6%AE%E0%A6%AC%E0%A6%87%E0%A7%9F%E0%A6%B0-%E0%A6%85%E0%A6%A7%E0%A6%A8%E0%A7%9F%E0%A6%95-%E0%A6%B9%E0%A6%A4-%E0%A6%9A%E0%A6%A8%E0%A6%A8-%E0%A6%B0%E0%A6%B9%E0%A6%A4%E0%A6%A4-%E0%A6%B0%E0%A6%9C-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A6%A8-%E0%A6%95</guid>
      <pubDate>Sat, 28 Nov 2026 16:06:38 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795881998_rkr_6b0afc0ee2470.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795881998_rkr_6b0afc0ee2470.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795881998_rkr_6b0afc0ee2470.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফের মুম্বাইয়ের অধিনায়ক হতে চাননি, রোহিততে রাজি করালেন কে" /&gt;&lt;/p&gt;&lt;p&gt;তিন মৌসুম পর আবারও মুম্বাই ইন্ডিয়ান্সের (এমআই) অধিনায়কত্ব ফিরে পেয়েছেন ভারতীয় ক্রিকেটের তারকা ব্যাটার রোহিত শর্মা। তবে নতুন করে নেতৃত্বের দায়িত্ব নিতে শুরুতে খুব একটা আগ্রহী ছিলেন না তিনি। এমনকি নিজেকে এই দায়িত্বের জন্য প্রস্তুত বলেও মনে করেননি পাঁচবারের আইপিএলজয়ী অধিনায়ক। শেষ পর্যন্ত পরিবার ও দলের.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AB%E0%A6%B0-%E0%A6%AE%E0%A6%AE%E0%A6%AC%E0%A6%87%E0%A7%9F%E0%A6%B0-%E0%A6%85%E0%A6%A7%E0%A6%A8%E0%A7%9F%E0%A6%95-%E0%A6%B9%E0%A6%A4-%E0%A6%9A%E0%A6%A8%E0%A6%A8-%E0%A6%B0%E0%A6%B9%E0%A6%A4%E0%A6%A4-%E0%A6%B0%E0%A6%9C-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A6%A8-%E0%A6%95">Education Bangla</source>
    </item>
    <item>
      <title>ক্রিকেটের মাঠ ছেড়ে পঞ্চায়েতের ফুলেরায় কেভিন পিটারসেন</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%95%E0%A6%B0%E0%A6%95%E0%A6%9F%E0%A6%B0-%E0%A6%AE%E0%A6%A0-%E0%A6%9B%E0%A6%A1-%E0%A6%AA%E0%A6%9E%E0%A6%9A%E0%A6%AF%E0%A6%A4%E0%A6%B0-%E0%A6%AB%E0%A6%B2%E0%A6%B0%E0%A7%9F-%E0%A6%95%E0%A6%AD%E0%A6%A8-%E0%A6%AA%E0%A6%9F%E0%A6%B0%E0%A6%B8%E0%A6%A8</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%95%E0%A6%B0%E0%A6%95%E0%A6%9F%E0%A6%B0-%E0%A6%AE%E0%A6%A0-%E0%A6%9B%E0%A6%A1-%E0%A6%AA%E0%A6%9E%E0%A6%9A%E0%A6%AF%E0%A6%A4%E0%A6%B0-%E0%A6%AB%E0%A6%B2%E0%A6%B0%E0%A7%9F-%E0%A6%95%E0%A6%AD%E0%A6%A8-%E0%A6%AA%E0%A6%9F%E0%A6%B0%E0%A6%B8%E0%A6%A8</guid>
      <pubDate>Sat, 28 Nov 2026 16:05:03 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795881903_rkr_6b0afbaf2cfca.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795881903_rkr_6b0afbaf2cfca.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795881903_rkr_6b0afbaf2cfca.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ক্রিকেটের মাঠ ছেড়ে পঞ্চায়েতের ফুলেরায় কেভিন পিটারসেন" /&gt;&lt;/p&gt;&lt;p&gt;ক্রিকেটের মাঠ থেকে এবার সরাসরি ভারতের গ্রামের আঙিনায়! ইংল্যান্ডের সাবেক ক্রিকেট অধিনায়ক কেভিন পিটারসেনকে এবার দেখা গেল একেবারে দেশি সাজে। জনপ্রিয় ভারতীয় ওয়েব সিরিজ ‘পঞ্চায়েত’-এর পঞ্চম মৌসুমের প্রচারণায় নতুন চমক নিয়ে হাজির হয়েছেন তিনি। সিরিজের দুই পরিচিত মুখ দুর্গেশ কুমার ও আসিফ খানের সঙ্গে পিটারসেনে&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%95%E0%A6%B0%E0%A6%95%E0%A6%9F%E0%A6%B0-%E0%A6%AE%E0%A6%A0-%E0%A6%9B%E0%A6%A1-%E0%A6%AA%E0%A6%9E%E0%A6%9A%E0%A6%AF%E0%A6%A4%E0%A6%B0-%E0%A6%AB%E0%A6%B2%E0%A6%B0%E0%A7%9F-%E0%A6%95%E0%A6%AD%E0%A6%A8-%E0%A6%AA%E0%A6%9F%E0%A6%B0%E0%A6%B8%E0%A6%A8">Education Bangla</source>
    </item>
    <item>
      <title>গারনাচোর ক্যারিয়ারে বড় ধাক্কা, জানুয়ারিতেই কী ভিলা ছাড়ছেন?</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%97%E0%A6%B0%E0%A6%A8%E0%A6%9A%E0%A6%B0-%E0%A6%95%E0%A6%AF%E0%A6%B0%E0%A7%9F%E0%A6%B0-%E0%A6%AC%E0%A7%9C-%E0%A6%A7%E0%A6%95%E0%A6%95-%E0%A6%9C%E0%A6%A8%E0%A7%9F%E0%A6%B0%E0%A6%A4%E0%A6%87-%E0%A6%95-%E0%A6%AD%E0%A6%B2-%E0%A6%9B%E0%A7%9C%E0%A6%9B%E0%A6%A8</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%97%E0%A6%B0%E0%A6%A8%E0%A6%9A%E0%A6%B0-%E0%A6%95%E0%A6%AF%E0%A6%B0%E0%A7%9F%E0%A6%B0-%E0%A6%AC%E0%A7%9C-%E0%A6%A7%E0%A6%95%E0%A6%95-%E0%A6%9C%E0%A6%A8%E0%A7%9F%E0%A6%B0%E0%A6%A4%E0%A6%87-%E0%A6%95-%E0%A6%AD%E0%A6%B2-%E0%A6%9B%E0%A7%9C%E0%A6%9B%E0%A6%A8</guid>
      <pubDate>Sat, 28 Nov 2026 16:04:09 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795881849_rkr_6b0afb79b5a07.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795881849_rkr_6b0afb79b5a07.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795881849_rkr_6b0afb79b5a07.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গারনাচোর ক্যারিয়ারে বড় ধাক্কা, জানুয়ারিতেই কী ভিলা ছাড়ছেন?" /&gt;&lt;/p&gt;&lt;p&gt;একসময় ক্লাব ফুটবল ও আর্জেন্টিনা জাতীয় দল—উভয় জায়গাতেই যাকে ঘিরে ছিল উজ্জ্বল ভবিষ্যতের প্রত্যাশা, সেই আলেহান্দ্রো গারনাচো এখন চরম দুঃসময় পার করছেন। চেলসি থেকে ধারে অ্যাস্টন ভিলায় যোগ দেওয়ার চার মাসের মাথায় ২২ বছর বয়সী এই ফরোয়ার্ড একাদশে তো দূরের কথা, ১২ জনের বদলি খেলোয়াড়ের তালিকাতেও সুযোগ&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%97%E0%A6%B0%E0%A6%A8%E0%A6%9A%E0%A6%B0-%E0%A6%95%E0%A6%AF%E0%A6%B0%E0%A7%9F%E0%A6%B0-%E0%A6%AC%E0%A7%9C-%E0%A6%A7%E0%A6%95%E0%A6%95-%E0%A6%9C%E0%A6%A8%E0%A7%9F%E0%A6%B0%E0%A6%A4%E0%A6%87-%E0%A6%95-%E0%A6%AD%E0%A6%B2-%E0%A6%9B%E0%A7%9C%E0%A6%9B%E0%A6%A8">Education Bangla</source>
    </item>
    <item>
      <title>মুশফিকের সাথে ১৫ নম্বর জার্সিও যাবে অবসরে</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%B6%E0%A6%AB%E0%A6%95%E0%A6%B0-%E0%A6%B8%E0%A6%A5-%E0%A7%A7%E0%A7%AB-%E0%A6%A8%E0%A6%AE%E0%A6%AC%E0%A6%B0-%E0%A6%9C%E0%A6%B0%E0%A6%B8%E0%A6%93-%E0%A6%AF%E0%A6%AC-%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%B6%E0%A6%AB%E0%A6%95%E0%A6%B0-%E0%A6%B8%E0%A6%A5-%E0%A7%A7%E0%A7%AB-%E0%A6%A8%E0%A6%AE%E0%A6%AC%E0%A6%B0-%E0%A6%9C%E0%A6%B0%E0%A6%B8%E0%A6%93-%E0%A6%AF%E0%A6%AC-%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A6%B0</guid>
      <pubDate>Sat, 28 Nov 2026 15:58:15 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795881495_rkr_6b0afa1750cdc.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795881495_rkr_6b0afa1750cdc.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795881495_rkr_6b0afa1750cdc.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মুশফিকের সাথে ১৫ নম্বর জার্সিও যাবে অবসরে" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ ক্রিকেটের অন্যতম সফল ও অভিজ্ঞ ক্রিকেটার মুশফিকুর রহিমের প্রতি সম্মান জানাতে বিশেষ উদ্যোগ নিয়েছে বাংলাদেশ ক্রিকেট বোর্ড (বিসিবি)। এই ক্রিকেটার আন্তর্জাতিক ক্রিকেট থেকে অবসর নিলে তার ব্যবহৃত ১৫ নম্বর জার্সিও তুলে রাখার সিদ্ধান্ত হয়েছে। অর্থাৎ, ভবিষ্যতে বাংলাদেশ জাতীয় দলের আর কোনো ক্রিকেটার ১৫&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%B6%E0%A6%AB%E0%A6%95%E0%A6%B0-%E0%A6%B8%E0%A6%A5-%E0%A7%A7%E0%A7%AB-%E0%A6%A8%E0%A6%AE%E0%A6%AC%E0%A6%B0-%E0%A6%9C%E0%A6%B0%E0%A6%B8%E0%A6%93-%E0%A6%AF%E0%A6%AC-%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A6%B0">Education Bangla</source>
    </item>
    <item>
      <title>৫০ লাখ চ্যাম্পিয়ন প্রাইজমানির এবিজি মিডিয়া কাপের ট্রফি উন্মোচন</title>
      <link>https://bangladesherkhela.com/news/%E0%A7%AB%E0%A7%A6-%E0%A6%B2%E0%A6%96-%E0%A6%9A%E0%A6%AF%E0%A6%AE%E0%A6%AA%E0%A7%9F%E0%A6%A8-%E0%A6%AA%E0%A6%B0%E0%A6%87%E0%A6%9C%E0%A6%AE%E0%A6%A8%E0%A6%B0-%E0%A6%8F%E0%A6%AC%E0%A6%9C-%E0%A6%AE%E0%A6%A1%E0%A7%9F-%E0%A6%95%E0%A6%AA%E0%A6%B0-%E0%A6%9F%E0%A6%B0%E0%A6%AB-%E0%A6%89%E0%A6%A8%E0%A6%AE%E0%A6%9A%E0%A6%A8</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A7%AB%E0%A7%A6-%E0%A6%B2%E0%A6%96-%E0%A6%9A%E0%A6%AF%E0%A6%AE%E0%A6%AA%E0%A7%9F%E0%A6%A8-%E0%A6%AA%E0%A6%B0%E0%A6%87%E0%A6%9C%E0%A6%AE%E0%A6%A8%E0%A6%B0-%E0%A6%8F%E0%A6%AC%E0%A6%9C-%E0%A6%AE%E0%A6%A1%E0%A7%9F-%E0%A6%95%E0%A6%AA%E0%A6%B0-%E0%A6%9F%E0%A6%B0%E0%A6%AB-%E0%A6%89%E0%A6%A8%E0%A6%AE%E0%A6%9A%E0%A6%A8</guid>
      <pubDate>Sat, 28 Nov 2026 15:56:53 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795881413_rkr_6b0af9c536416.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795881413_rkr_6b0af9c536416.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795881413_rkr_6b0af9c536416.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৫০ লাখ চ্যাম্পিয়ন প্রাইজমানির এবিজি মিডিয়া কাপের ট্রফি উন্মোচন" /&gt;&lt;/p&gt;&lt;p&gt;৫০ লাখ টাকা চ্যাম্পিয়ন প্রাইজমানির এবিজি মিডিয়া কাপ ফুটবল শুরু হচ্ছে ১ ডিসেম্বর থেকে। এতে অংশ নেবে ৪৮টি গণমাধ্যম প্রতিষ্ঠান।আজ শনিবার রাজধানীর বসুন্ধরা আবাসিক এলাকার এবিজি স্পোর্টস সিটির জুলকান ইনডোর অ্যারেনায় জমকালো আয়োজনে টুর্নামেন্টের ড্র ও জার্সি উন্মোচন অনুষ্ঠান সম্পন্ন হয়। এ অনুষ্ঠানে আকর্ষণীয়&lt;/p&gt;</description>

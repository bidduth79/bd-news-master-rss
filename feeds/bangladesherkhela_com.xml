      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794327272_rkr_6af342e833f24.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794327272_rkr_6af342e833f24.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794327272_rkr_6af342e833f24.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চোটের ধকল আর নিতে পারছেন না নেইমার!" /&gt;&lt;/p&gt;&lt;p&gt;নেইমার জুনিয়রের ভবিষ্যৎ নিয়ে অনিশ্চয়তা যেন দিন দিন বাড়ছেই। ব্রাজিলের এই তারকা ফুটবলার এবার সত্যিই ক্যারিয়ার শেষ করার কথা গুরুত্বের সঙ্গে ভাবছেন। একের পর এক চোট ও শারীরিক সমস্যায় ক্লান্ত হয়ে পড়েছেন তিনি। এসব সমস্যা তার প্রত্যাশিত পর্যায়ে পারফর্ম করার সক্ষমতাকেও প্রশ্নের মুখে ফেলেছে।ফরাসি সংবাদমাধ্যম.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%9A%E0%A6%9F%E0%A6%B0-%E0%A6%A7%E0%A6%95%E0%A6%B2-%E0%A6%86%E0%A6%B0-%E0%A6%A8%E0%A6%A4-%E0%A6%AA%E0%A6%B0%E0%A6%9B%E0%A6%A8-%E0%A6%A8-%E0%A6%A8%E0%A6%87%E0%A6%AE%E0%A6%B0">Education Bangla</source>

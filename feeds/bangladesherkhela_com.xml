    <item>
      <title>হামজাকে কেন সেরা অধিনায়ক মনে করেন ডুলি, জানালেন নিজেই</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B9%E0%A6%AE%E0%A6%9C%E0%A6%95-%E0%A6%95%E0%A6%A8-%E0%A6%B8%E0%A6%B0-%E0%A6%85%E0%A6%A7%E0%A6%A8%E0%A7%9F%E0%A6%95-%E0%A6%AE%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A6%A8-%E0%A6%A1%E0%A6%B2-%E0%A6%9C%E0%A6%A8%E0%A6%B2%E0%A6%A8-%E0%A6%A8%E0%A6%9C%E0%A6%87</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%B9%E0%A6%AE%E0%A6%9C%E0%A6%95-%E0%A6%95%E0%A6%A8-%E0%A6%B8%E0%A6%B0-%E0%A6%85%E0%A6%A7%E0%A6%A8%E0%A7%9F%E0%A6%95-%E0%A6%AE%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A6%A8-%E0%A6%A1%E0%A6%B2-%E0%A6%9C%E0%A6%A8%E0%A6%B2%E0%A6%A8-%E0%A6%A8%E0%A6%9C%E0%A6%87</guid>

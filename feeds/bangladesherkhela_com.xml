      <title>প্রথম টেস্টে নেই নরকিয়া, বাংলাদেশ সিরিজে দক্ষিণ আফ্রিকার বড় ধাক্কা</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AA%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%9F%E0%A6%B8%E0%A6%9F-%E0%A6%A8%E0%A6%87-%E0%A6%A8%E0%A6%B0%E0%A6%95%E0%A7%9F-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6-%E0%A6%B8%E0%A6%B0%E0%A6%9C-%E0%A6%A6%E0%A6%95%E0%A6%B7%E0%A6%A3-%E0%A6%86%E0%A6%AB%E0%A6%B0%E0%A6%95%E0%A6%B0-%E0%A6%AC%E0%A7%9C-%E0%A6%A7%E0%A6%95%E0%A6%95</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AA%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%9F%E0%A6%B8%E0%A6%9F-%E0%A6%A8%E0%A6%87-%E0%A6%A8%E0%A6%B0%E0%A6%95%E0%A7%9F-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6-%E0%A6%B8%E0%A6%B0%E0%A6%9C-%E0%A6%A6%E0%A6%95%E0%A6%B7%E0%A6%A3-%E0%A6%86%E0%A6%AB%E0%A6%B0%E0%A6%95%E0%A6%B0-%E0%A6%AC%E0%A7%9C-%E0%A6%A7%E0%A6%95%E0%A6%95</guid>

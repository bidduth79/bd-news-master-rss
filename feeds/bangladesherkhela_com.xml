    <item>
      <title>পার্থ টেস্টে থাকছেন না লায়ন, অনিশ্চয়তায় ক্যারিয়ার</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AA%E0%A6%B0%E0%A6%A5-%E0%A6%9F%E0%A6%B8%E0%A6%9F-%E0%A6%A5%E0%A6%95%E0%A6%9B%E0%A6%A8-%E0%A6%A8-%E0%A6%B2%E0%A7%9F%E0%A6%A8-%E0%A6%85%E0%A6%A8%E0%A6%B6%E0%A6%9A%E0%A7%9F%E0%A6%A4%E0%A7%9F-%E0%A6%95%E0%A6%AF%E0%A6%B0%E0%A7%9F%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AA%E0%A6%B0%E0%A6%A5-%E0%A6%9F%E0%A6%B8%E0%A6%9F-%E0%A6%A5%E0%A6%95%E0%A6%9B%E0%A6%A8-%E0%A6%A8-%E0%A6%B2%E0%A7%9F%E0%A6%A8-%E0%A6%85%E0%A6%A8%E0%A6%B6%E0%A6%9A%E0%A7%9F%E0%A6%A4%E0%A7%9F-%E0%A6%95%E0%A6%AF%E0%A6%B0%E0%A7%9F%E0%A6%B0</guid>

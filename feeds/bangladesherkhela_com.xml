    <item>
      <title>বাটলারের দর্শন ধরে রাখতে চান ঋতুপর্ণাদের নতুন কোচ</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%9F%E0%A6%B2%E0%A6%B0%E0%A6%B0-%E0%A6%A6%E0%A6%B0%E0%A6%B6%E0%A6%A8-%E0%A6%A7%E0%A6%B0-%E0%A6%B0%E0%A6%96%E0%A6%A4-%E0%A6%9A%E0%A6%A8-%E0%A6%8B%E0%A6%A4%E0%A6%AA%E0%A6%B0%E0%A6%A3%E0%A6%A6%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A6%A8-%E0%A6%95%E0%A6%9A</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%9F%E0%A6%B2%E0%A6%B0%E0%A6%B0-%E0%A6%A6%E0%A6%B0%E0%A6%B6%E0%A6%A8-%E0%A6%A7%E0%A6%B0-%E0%A6%B0%E0%A6%96%E0%A6%A4-%E0%A6%9A%E0%A6%A8-%E0%A6%8B%E0%A6%A4%E0%A6%AA%E0%A6%B0%E0%A6%A3%E0%A6%A6%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A6%A8-%E0%A6%95%E0%A6%9A</guid>
      <pubDate>Mon, 09 Nov 2026 15:13:35 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_media/1794214137_6af188f96f96b.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_media/1794214137_6af188f96f96b.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_media/1794214137_6af188f96f96b.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাটলারের দর্শন ধরে রাখতে চান ঋতুপর্ণাদের নতুন কোচ" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ নারী জাতীয় ফুটবল দলের অন্তর্বর্তীকালীন প্রধান কোচ হিসেবে দায়িত্ব নিয়েছেন ফরাসি কোচ এরিক মেয়ার। দায়িত্ব পেয়েই দলের খেলার ধরনে বড় কোনো পরিবর্তন না আনার ঘোষণা দিয়েছেন তিনি। বরং সাবেক কোচ পিটার বাটলারের ফুটবল দর্শন ধরে রেখেই পরিস্থিতি ও খেলোয়াড়দের সামর্থ্য অনুযায়ী কিছু কৌশলগত পরিবর্তন আনতে চান.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%9F%E0%A6%B2%E0%A6%B0%E0%A6%B0-%E0%A6%A6%E0%A6%B0%E0%A6%B6%E0%A6%A8-%E0%A6%A7%E0%A6%B0-%E0%A6%B0%E0%A6%96%E0%A6%A4-%E0%A6%9A%E0%A6%A8-%E0%A6%8B%E0%A6%A4%E0%A6%AA%E0%A6%B0%E0%A6%A3%E0%A6%A6%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A6%A8-%E0%A6%95%E0%A6%9A">Education Bangla</source>
    </item>
    <item>
      <title>ক্রীড়া শক্তির কথা তুলে ধরলেন ডাচেস অব এডিনবরা</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%95%E0%A6%B0%E0%A7%9C-%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%B0-%E0%A6%95%E0%A6%A5-%E0%A6%A4%E0%A6%B2-%E0%A6%A7%E0%A6%B0%E0%A6%B2%E0%A6%A8-%E0%A6%A1%E0%A6%9A%E0%A6%B8-%E0%A6%85%E0%A6%AC-%E0%A6%8F%E0%A6%A1%E0%A6%A8%E0%A6%AC%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%95%E0%A6%B0%E0%A7%9C-%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%B0-%E0%A6%95%E0%A6%A5-%E0%A6%A4%E0%A6%B2-%E0%A6%A7%E0%A6%B0%E0%A6%B2%E0%A6%A8-%E0%A6%A1%E0%A6%9A%E0%A6%B8-%E0%A6%85%E0%A6%AC-%E0%A6%8F%E0%A6%A1%E0%A6%A8%E0%A6%AC%E0%A6%B0</guid>
      <pubDate>Mon, 09 Nov 2026 15:12:18 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_media/1794237127_6af1e2c728ef9.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_media/1794237127_6af1e2c728ef9.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_media/1794237127_6af1e2c728ef9.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ক্রীড়া শক্তির কথা তুলে ধরলেন ডাচেস অব এডিনবরা" /&gt;&lt;/p&gt;&lt;p&gt;নতুন প্রজন্মকে অনুপ্রাণিত করতে খেলাধুলার অনন্য শক্তির ওপর জোর দিয়েছেন ডাচেস অব এডিনবরা সোফি হেলেন রিস-জোন্স। সোমবার বিকেএসপি (বাংলাদেশ ক্রীড়া শিক্ষা প্রতিষ্ঠান) পরিদর্শনের সময় তিনি এই কথা বলেন।সফরের অংশ হিসেবে তিনি সেখানে তরুণ অ্যাথলেট ও নারী হকি খেলোয়াড়দের সঙ্গে সাক্ষাৎ করেন। এ সময় বাংলাদেশের কিশোর&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%95%E0%A6%B0%E0%A7%9C-%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%B0-%E0%A6%95%E0%A6%A5-%E0%A6%A4%E0%A6%B2-%E0%A6%A7%E0%A6%B0%E0%A6%B2%E0%A6%A8-%E0%A6%A1%E0%A6%9A%E0%A6%B8-%E0%A6%85%E0%A6%AC-%E0%A6%8F%E0%A6%A1%E0%A6%A8%E0%A6%AC%E0%A6%B0">Education Bangla</source>
    </item>
    <item>
      <title>মুমিন-তামিমের রেকর্ডে সেমিফাইনালে বাংলাদেশ</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%AE%E0%A6%A8-%E0%A6%A4%E0%A6%AE%E0%A6%AE%E0%A6%B0-%E0%A6%B0%E0%A6%95%E0%A6%B0%E0%A6%A1-%E0%A6%B8%E0%A6%AE%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%AE%E0%A6%A8-%E0%A6%A4%E0%A6%AE%E0%A6%AE%E0%A6%B0-%E0%A6%B0%E0%A6%95%E0%A6%B0%E0%A6%A1-%E0%A6%B8%E0%A6%AE%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6</guid>
      <pubDate>Mon, 09 Nov 2026 15:10:56 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_media/1794237041_6af1e271752b3.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_media/1794237041_6af1e271752b3.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_media/1794237041_6af1e271752b3.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মুমিন-তামিমের রেকর্ডে সেমিফাইনালে বাংলাদেশ" /&gt;&lt;/p&gt;&lt;p&gt;ব্যাট হাতে একাই লড়লেন আহসান আল মুমিন। সতীর্থদের আসা-যাওয়ার মিছিলে এক প্রান্ত আগলে রেখে খেললেন ক্যারিয়ারসেরা ইনিংস। তাতে গড়লেন বাংলাদেশের যুব ওয়ানডে ক্রিকেটে সর্বোচ্চ ব্যক্তিগত ইনিংসের রেকর্ড। আজ ওমানের আল আমেরাত ক্রিকেট গ্রাউন্ডে তার অপরাজিত ১৫২ রানের ঝলমলে ইনিংসে ভর করে মালয়েশিয়ার যুবাদের বিপক্ষে ৫&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%AE%E0%A6%A8-%E0%A6%A4%E0%A6%AE%E0%A6%AE%E0%A6%B0-%E0%A6%B0%E0%A6%95%E0%A6%B0%E0%A6%A1-%E0%A6%B8%E0%A6%AE%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6">Education Bangla</source>
    </item>
    <item>
      <title>একই দিনে মিঠুন-জাকিরের ১৮তম সেঞ্চুরি</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%8F%E0%A6%95%E0%A6%87-%E0%A6%A6%E0%A6%A8-%E0%A6%AE%E0%A6%A0%E0%A6%A8-%E0%A6%9C%E0%A6%95%E0%A6%B0%E0%A6%B0-%E0%A7%A7%E0%A7%AE%E0%A6%A4%E0%A6%AE-%E0%A6%B8%E0%A6%9E%E0%A6%9A%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%8F%E0%A6%95%E0%A6%87-%E0%A6%A6%E0%A6%A8-%E0%A6%AE%E0%A6%A0%E0%A6%A8-%E0%A6%9C%E0%A6%95%E0%A6%B0%E0%A6%B0-%E0%A7%A7%E0%A7%AE%E0%A6%A4%E0%A6%AE-%E0%A6%B8%E0%A6%9E%E0%A6%9A%E0%A6%B0</guid>
      <pubDate>Mon, 09 Nov 2026 15:08:49 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_media/1794236918_6af1e1f60b1be.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_media/1794236918_6af1e1f60b1be.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_media/1794236918_6af1e1f60b1be.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="একই দিনে মিঠুন-জাকিরের ১৮তম সেঞ্চুরি" /&gt;&lt;/p&gt;&lt;p&gt;২৮তম জাতীয় ক্রিকেট লিগের (এনসিএল) ষষ্ঠ রাউন্ডের তৃতীয় দিনটি ছিল ব্যাটসম্যানদের। তিনটি সেঞ্চুরিতে দিনটি রাঙিয়েছেন সিলেটের জাকির হাসান, সৈকত আলী ও খুলনার মোহাম্মদ মিঠুন। তাদের ব্যাটে বড় সংগ্রহ পেয়েছে সিলেট ও খুলনা। অন্যদিকে ময়মনসিংহের বিপক্ষে ফলোঅনে পড়ে বিপাকে রয়েছে বরিশাল। তবে দলের হয়ে লড়াই চালিয়ে যা&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%8F%E0%A6%95%E0%A6%87-%E0%A6%A6%E0%A6%A8-%E0%A6%AE%E0%A6%A0%E0%A6%A8-%E0%A6%9C%E0%A6%95%E0%A6%B0%E0%A6%B0-%E0%A7%A7%E0%A7%AE%E0%A6%A4%E0%A6%AE-%E0%A6%B8%E0%A6%9E%E0%A6%9A%E0%A6%B0">Education Bangla</source>
    </item>
    <item>
      <title>১০টি ক্রীড়া ইভেন্ট নিয়ে দেশব্যাপী শুরু হচ্ছে ‌‘নতুন কুঁড়ি স্পোর্টস’</title>
      <link>https://bangladesherkhela.com/news/%E0%A7%A7%E0%A7%A6%E0%A6%9F-%E0%A6%95%E0%A6%B0%E0%A7%9C-%E0%A6%87%E0%A6%AD%E0%A6%A8%E0%A6%9F-%E0%A6%A8%E0%A7%9F-%E0%A6%A6%E0%A6%B6%E0%A6%AC%E0%A6%AF%E0%A6%AA-%E0%A6%B6%E0%A6%B0-%E0%A6%B9%E0%A6%9A%E0%A6%9B-%E0%A6%A8%E0%A6%A4%E0%A6%A8-%E0%A6%95%E0%A7%9C-%E0%A6%B8%E0%A6%AA%E0%A6%B0%E0%A6%9F%E0%A6%B8</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A7%A7%E0%A7%A6%E0%A6%9F-%E0%A6%95%E0%A6%B0%E0%A7%9C-%E0%A6%87%E0%A6%AD%E0%A6%A8%E0%A6%9F-%E0%A6%A8%E0%A7%9F-%E0%A6%A6%E0%A6%B6%E0%A6%AC%E0%A6%AF%E0%A6%AA-%E0%A6%B6%E0%A6%B0-%E0%A6%B9%E0%A6%9A%E0%A6%9B-%E0%A6%A8%E0%A6%A4%E0%A6%A8-%E0%A6%95%E0%A7%9C-%E0%A6%B8%E0%A6%AA%E0%A6%B0%E0%A6%9F%E0%A6%B8</guid>
      <pubDate>Mon, 09 Nov 2026 13:14:16 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_media/1793275437_6ae3362d699d2.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_media/1793275437_6ae3362d699d2.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_media/1793275437_6ae3362d699d2.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="১০টি ক্রীড়া ইভেন্ট নিয়ে দেশব্যাপী শুরু হচ্ছে ‌‘নতুন কুঁড়ি স্পোর্টস’" /&gt;&lt;/p&gt;&lt;p&gt;১০টি ক্রীড়া ইভেন্ট নিয়ে ইউনিয়ন পর্যায় থেকে ১০-১৪ বছর বয়সী শিশু-কিশোরদের অংশগ্রহণে ‘নতুন কুঁড়ি স্পোর্টস’ প্রতিযোগিতা শুরু হচ্ছে বলে জানিয়েছেন যুব ও ক্রীড়া প্রতিমন্ত্রী আমিনুল হক।ইভেন্টের মধ্যে রয়েছে- ফুটবল, ক্রিকেট, কাবাডি, অ্যাথলেটিক্স, ব্যাডমিন্টন, ভলিবল, টেবিল টেনিস, সাঁতার, দাবা এবং মার্শাল আর্ট.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A7%A7%E0%A7%A6%E0%A6%9F-%E0%A6%95%E0%A6%B0%E0%A7%9C-%E0%A6%87%E0%A6%AD%E0%A6%A8%E0%A6%9F-%E0%A6%A8%E0%A7%9F-%E0%A6%A6%E0%A6%B6%E0%A6%AC%E0%A6%AF%E0%A6%AA-%E0%A6%B6%E0%A6%B0-%E0%A6%B9%E0%A6%9A%E0%A6%9B-%E0%A6%A8%E0%A6%A4%E0%A6%A8-%E0%A6%95%E0%A7%9C-%E0%A6%B8%E0%A6%AA%E0%A6%B0%E0%A6%9F%E0%A6%B8">Education Bangla</source>
    </item>
    <item>
      <title>দ্রুতই ১২ হাজার ক্রীড়া শিক্ষক নিয়োগ: সংসদে আমিনুল হক</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%A6%E0%A6%B0%E0%A6%A4%E0%A6%87-%E0%A7%A7%E0%A7%A8-%E0%A6%B9%E0%A6%9C%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A7%9C-%E0%A6%B6%E0%A6%95%E0%A6%B7%E0%A6%95-%E0%A6%A8%E0%A7%9F%E0%A6%97-%E0%A6%B8%E0%A6%B8%E0%A6%A6-%E0%A6%86%E0%A6%AE%E0%A6%A8%E0%A6%B2-%E0%A6%B9%E0%A6%95</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%A6%E0%A6%B0%E0%A6%A4%E0%A6%87-%E0%A7%A7%E0%A7%A8-%E0%A6%B9%E0%A6%9C%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A7%9C-%E0%A6%B6%E0%A6%95%E0%A6%B7%E0%A6%95-%E0%A6%A8%E0%A7%9F%E0%A6%97-%E0%A6%B8%E0%A6%B8%E0%A6%A6-%E0%A6%86%E0%A6%AE%E0%A6%A8%E0%A6%B2-%E0%A6%B9%E0%A6%95</guid>
      <pubDate>Mon, 09 Nov 2026 13:12:14 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_media/1794229921_6af1c6a13ff49.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_media/1794229921_6af1c6a13ff49.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_media/1794229921_6af1c6a13ff49.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দ্রুতই ১২ হাজার ক্রীড়া শিক্ষক নিয়োগ: সংসদে আমিনুল হক" /&gt;&lt;/p&gt;&lt;p&gt;উপজেলা পর্যায় ১১ হাজার ৮৮০টি পদে ক্রীড়া শিক্ষক নিয়োগের বিষয়ে দ্রুত ব্যবস্থা গ্রহণের প্রক্রিয়া চলমান বলে জানিয়েছেন যুব ও ক্রীড়া প্রতিমন্ত্রী আমিনুল হক।সোমবার (৯ নভেম্বর) জাতীয় সংসদ অধিবেশনে সংসদ সদস্য নেওয়াজ হালিমা আরলীর এক প্রশ্নের জবাবে প্রতিমন্ত্রী এ কথা জানান।প্রতিমন্ত্রী বলেন, ১০টি ক্রীড়া ইভেন্ট&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%A6%E0%A6%B0%E0%A6%A4%E0%A6%87-%E0%A7%A7%E0%A7%A8-%E0%A6%B9%E0%A6%9C%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A7%9C-%E0%A6%B6%E0%A6%95%E0%A6%B7%E0%A6%95-%E0%A6%A8%E0%A7%9F%E0%A6%97-%E0%A6%B8%E0%A6%B8%E0%A6%A6-%E0%A6%86%E0%A6%AE%E0%A6%A8%E0%A6%B2-%E0%A6%B9%E0%A6%95">Education Bangla</source>
    </item>
    <item>
      <title>ম্যাচসেরা হৃদয়, সিরিজ সেরা ওয়ারিকান</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%AF%E0%A6%9A%E0%A6%B8%E0%A6%B0-%E0%A6%B9%E0%A6%A6%E0%A7%9F-%E0%A6%B8%E0%A6%B0%E0%A6%9C-%E0%A6%B8%E0%A6%B0-%E0%A6%93%E0%A7%9F%E0%A6%B0%E0%A6%95%E0%A6%A8</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%AF%E0%A6%9A%E0%A6%B8%E0%A6%B0-%E0%A6%B9%E0%A6%A6%E0%A7%9F-%E0%A6%B8%E0%A6%B0%E0%A6%9C-%E0%A6%B8%E0%A6%B0-%E0%A6%93%E0%A7%9F%E0%A6%B0%E0%A6%95%E0%A6%A8</guid>
      <pubDate>Mon, 09 Nov 2026 12:37:58 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_media/1794227864_6af1be988557a.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_media/1794227864_6af1be988557a.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_media/1794227864_6af1be988557a.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ম্যাচসেরা হৃদয়, সিরিজ সেরা ওয়ারিকান" /&gt;&lt;/p&gt;&lt;p&gt;মিরপুর থেকে সিলেট দুই ম্যাচেই বাংলাদেশের ব্যাটারদের আতঙ্কের নাম ছিলেন প্রতিপক্ষ ওয়েস্ট ইন্ডিজের বাঁহাতি স্পিনার জোমেল ওয়ারিকান। একবার পাঁচ উইকেটসহ মোট ১৬ উইকেট নেওয়া এই বাঁহাতির হাতে উঠেছে সিরিজ সেরার পুরস্কার। আর সিলেট টেস্টে রেকর্ড গড়া ডাবল সেঞ্চুরি করে তাওহিদ হৃদয় বাগিয়ে নিয়েছেন ম্যাচসেরার পুরস্ক&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%AF%E0%A6%9A%E0%A6%B8%E0%A6%B0-%E0%A6%B9%E0%A6%A6%E0%A7%9F-%E0%A6%B8%E0%A6%B0%E0%A6%9C-%E0%A6%B8%E0%A6%B0-%E0%A6%93%E0%A7%9F%E0%A6%B0%E0%A6%95%E0%A6%A8">Education Bangla</source>
    </item>
    <item>
      <title>বগুড়া শহীদ চাঁন্দু স্টেডিয়ামকে আন্তর্জাতিক মানের করা হবে : বিসিবি</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%97%E0%A7%9C-%E0%A6%B6%E0%A6%B9%E0%A6%A6-%E0%A6%9A%E0%A6%A8%E0%A6%A6-%E0%A6%B8%E0%A6%9F%E0%A6%A1%E0%A7%9F%E0%A6%AE%E0%A6%95-%E0%A6%86%E0%A6%A8%E0%A6%A4%E0%A6%B0%E0%A6%9C%E0%A6%A4%E0%A6%95-%E0%A6%AE%E0%A6%A8%E0%A6%B0-%E0%A6%95%E0%A6%B0-%E0%A6%B9%E0%A6%AC-%E0%A6%AC%E0%A6%B8%E0%A6%AC</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%97%E0%A7%9C-%E0%A6%B6%E0%A6%B9%E0%A6%A6-%E0%A6%9A%E0%A6%A8%E0%A6%A6-%E0%A6%B8%E0%A6%9F%E0%A6%A1%E0%A7%9F%E0%A6%AE%E0%A6%95-%E0%A6%86%E0%A6%A8%E0%A6%A4%E0%A6%B0%E0%A6%9C%E0%A6%A4%E0%A6%95-%E0%A6%AE%E0%A6%A8%E0%A6%B0-%E0%A6%95%E0%A6%B0-%E0%A6%B9%E0%A6%AC-%E0%A6%AC%E0%A6%B8%E0%A6%AC</guid>
      <pubDate>Mon, 09 Nov 2026 12:34:05 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_media/1794227636_6af1bdb4dee72.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_media/1794227636_6af1bdb4dee72.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_media/1794227636_6af1bdb4dee72.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বগুড়া শহীদ চাঁন্দু স্টেডিয়ামকে আন্তর্জাতিক মানের করা হবে : বিসিবি" /&gt;&lt;/p&gt;&lt;p&gt;দীর্ঘ ১৭ বছর পর বগুড়ার শহীদ চাঁন্দু স্টেডিয়ামকে আন্তর্জাতিক ক্রিকেট ভেন্যুর উপযোগী করে তোলার লক্ষ্যে সংস্কার ও পুন:নির্মাণ কাজের আনুষ্ঠানিক প্রক্রিয়া শুরু হয়েছে। স্টেডিয়ামটির ড্রইং ও ডিজাইনের জন্য ইতোমধ্যে কনসালটেন্ট ফার্ম নিয়োগ করা হয়েছে এবং আগামী বছরের জানুয়ারি-ফেব্রুয়ারির মধ্যে মাঠ পর্যায়ে দৃশ্যম&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%97%E0%A7%9C-%E0%A6%B6%E0%A6%B9%E0%A6%A6-%E0%A6%9A%E0%A6%A8%E0%A6%A6-%E0%A6%B8%E0%A6%9F%E0%A6%A1%E0%A7%9F%E0%A6%AE%E0%A6%95-%E0%A6%86%E0%A6%A8%E0%A6%A4%E0%A6%B0%E0%A6%9C%E0%A6%A4%E0%A6%95-%E0%A6%AE%E0%A6%A8%E0%A6%B0-%E0%A6%95%E0%A6%B0-%E0%A6%B9%E0%A6%AC-%E0%A6%AC%E0%A6%B8%E0%A6%AC">Education Bangla</source>
    </item>
    <item>
      <title>আত্মবিশ্বাস নিয়েই দক্ষিণ আফ্রিকা যাচ্ছেন শান্ত</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%A4%E0%A6%AE%E0%A6%AC%E0%A6%B6%E0%A6%AC%E0%A6%B8-%E0%A6%A8%E0%A7%9F%E0%A6%87-%E0%A6%A6%E0%A6%95%E0%A6%B7%E0%A6%A3-%E0%A6%86%E0%A6%AB%E0%A6%B0%E0%A6%95-%E0%A6%AF%E0%A6%9A%E0%A6%9B%E0%A6%A8-%E0%A6%B6%E0%A6%A8%E0%A6%A4</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%A4%E0%A6%AE%E0%A6%AC%E0%A6%B6%E0%A6%AC%E0%A6%B8-%E0%A6%A8%E0%A7%9F%E0%A6%87-%E0%A6%A6%E0%A6%95%E0%A6%B7%E0%A6%A3-%E0%A6%86%E0%A6%AB%E0%A6%B0%E0%A6%95-%E0%A6%AF%E0%A6%9A%E0%A6%9B%E0%A6%A8-%E0%A6%B6%E0%A6%A8%E0%A6%A4</guid>
      <pubDate>Mon, 09 Nov 2026 12:29:35 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_media/1794227363_6af1bca3ed9c3.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_media/1794227363_6af1bca3ed9c3.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_media/1794227363_6af1bca3ed9c3.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আত্মবিশ্বাস নিয়েই দক্ষিণ আফ্রিকা যাচ্ছেন শান্ত" /&gt;&lt;/p&gt;&lt;p&gt;ওয়েস্ট ইন্ডিজের কাছে টেস্ট সিরিজ হেরে বিশ্ব টেস্ট চ্যাম্পিয়নশিপের ফাইনালে খেলার লড়াইয়ে অনেকটাই পিছিয়ে পড়েছে বাংলাদেশ। এবার সামনে দক্ষিণ আফ্রিকা সফরের চ্যালেঞ্জ। আগামীকালই প্রোটিয়াদের দেশে উড়াল দেবে বাংলাদেশ দল। সেখানে স্বাগতিকদের বিপক্ষে টেস্ট চ্যাম্পিয়নশিপের দুটি ম্যাচ খেলবে টাইগাররা। তবে এই সিরিজে&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%A4%E0%A6%AE%E0%A6%AC%E0%A6%B6%E0%A6%AC%E0%A6%B8-%E0%A6%A8%E0%A7%9F%E0%A6%87-%E0%A6%A6%E0%A6%95%E0%A6%B7%E0%A6%A3-%E0%A6%86%E0%A6%AB%E0%A6%B0%E0%A6%95-%E0%A6%AF%E0%A6%9A%E0%A6%9B%E0%A6%A8-%E0%A6%B6%E0%A6%A8%E0%A6%A4">Education Bangla</source>
    </item>
    <item>
      <title>‘আমরা নিজেদের ৫০ শতাংশ ক্রিকেটও খেলতে পারিনি’, স্বীকারোক্তি শান্তর</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%AE%E0%A6%B0-%E0%A6%A8%E0%A6%9C%E0%A6%A6%E0%A6%B0-%E0%A7%AB%E0%A7%A6-%E0%A6%B6%E0%A6%A4%E0%A6%B6-%E0%A6%95%E0%A6%B0%E0%A6%95%E0%A6%9F%E0%A6%93-%E0%A6%96%E0%A6%B2%E0%A6%A4-%E0%A6%AA%E0%A6%B0%E0%A6%A8-%E0%A6%B8%E0%A6%AC%E0%A6%95%E0%A6%B0%E0%A6%95%E0%A6%A4-%E0%A6%B6%E0%A6%A8%E0%A6%A4%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%AE%E0%A6%B0-%E0%A6%A8%E0%A6%9C%E0%A6%A6%E0%A6%B0-%E0%A7%AB%E0%A7%A6-%E0%A6%B6%E0%A6%A4%E0%A6%B6-%E0%A6%95%E0%A6%B0%E0%A6%95%E0%A6%9F%E0%A6%93-%E0%A6%96%E0%A6%B2%E0%A6%A4-%E0%A6%AA%E0%A6%B0%E0%A6%A8-%E0%A6%B8%E0%A6%AC%E0%A6%95%E0%A6%B0%E0%A6%95%E0%A6%A4-%E0%A6%B6%E0%A6%A8%E0%A6%A4%E0%A6%B0</guid>
      <pubDate>Mon, 09 Nov 2026 12:28:40 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_media/1794227307_6af1bc6b623d8.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_media/1794227307_6af1bc6b623d8.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_media/1794227307_6af1bc6b623d8.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘আমরা নিজেদের ৫০ শতাংশ ক্রিকেটও খেলতে পারিনি’, স্বীকারোক্তি শান্তর" /&gt;&lt;/p&gt;&lt;p&gt;ওয়েস্ট ইন্ডিজের বিপক্ষে সিলেট টেস্ট ড্র হলেও নিজেদের পরিকল্পনা ও তার বাস্তবায়ন নিয়ে সন্তুষ্ট নন বাংলাদেশ অধিনায়ক নাজমুল হোসেন শান্ত। তার মতে, স্পিননির্ভর উইকেটে খেলার পরিকল্পনা ঠিক থাকলেও প্রত্যাশিত কন্ডিশন না পাওয়া এবং তিন বিভাগে ভালো ক্রিকেট খেলতে না পারায় প্রথম টেস্টে হারের মুখ দেখতে হয়েছে বাংলাদ&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%AE%E0%A6%B0-%E0%A6%A8%E0%A6%9C%E0%A6%A6%E0%A6%B0-%E0%A7%AB%E0%A7%A6-%E0%A6%B6%E0%A6%A4%E0%A6%B6-%E0%A6%95%E0%A6%B0%E0%A6%95%E0%A6%9F%E0%A6%93-%E0%A6%96%E0%A6%B2%E0%A6%A4-%E0%A6%AA%E0%A6%B0%E0%A6%A8-%E0%A6%B8%E0%A6%AC%E0%A6%95%E0%A6%B0%E0%A6%95%E0%A6%A4-%E0%A6%B6%E0%A6%A8%E0%A6%A4%E0%A6%B0">Education Bangla</source>

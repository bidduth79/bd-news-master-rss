      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794739446_rkr_6af98cf62e8c4.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ক্ষমা চাইলেন শ্রাবণ, কোচ-ম্যানেজমেন্টকে কাঠগড়ায় তুললেন জামাল" /&gt;&lt;/p&gt;&lt;p&gt;সাফ চ্যাম্পিয়নশিপের সেমিফাইনালে পাকিস্তানের কাছে শেষ মুহূর্তের নাটকীয় হারে বাংলাদেশ দলের ফাইনাল খেলার স্বপ্ন ধূলিসাৎ হয়েছে। ২১ বছরের অপেক্ষা ঘুচিয়ে শিরোপার মঞ্চে ওঠার যে স্বপ্ন নিয়ে লাল-সবুজের প্রতিনিধিরা মাঠে নেমেছিল, তা ১-০ গোলের হারে রূপ নিয়েছে তীব্র হতাশা ও আক্ষেপে। ম্যাচের ৮৫ মিনিটে গোলকিপা&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%95%E0%A6%B7%E0%A6%AE-%E0%A6%9A%E0%A6%87%E0%A6%B2%E0%A6%A8-%E0%A6%B6%E0%A6%B0%E0%A6%AC%E0%A6%A3-%E0%A6%95%E0%A6%9A-%E0%A6%AE%E0%A6%AF%E0%A6%A8%E0%A6%9C%E0%A6%AE%E0%A6%A8%E0%A6%9F%E0%A6%95-%E0%A6%95%E0%A6%A0%E0%A6%97%E0%A7%9C%E0%A7%9F-%E0%A6%A4%E0%A6%B2%E0%A6%B2%E0%A6%A8-%E0%A6%9C%E0%A6%AE%E0%A6%B2">Education Bangla</source>

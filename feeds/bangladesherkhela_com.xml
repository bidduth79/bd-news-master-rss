    <item>
      <title>চোটের মিছিলে নিউজিল্যান্ড</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%9A%E0%A6%9F%E0%A6%B0-%E0%A6%AE%E0%A6%9B%E0%A6%B2-%E0%A6%A8%E0%A6%89%E0%A6%9C%E0%A6%B2%E0%A6%AF%E0%A6%A8%E0%A6%A1</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%9A%E0%A6%9F%E0%A6%B0-%E0%A6%AE%E0%A6%9B%E0%A6%B2-%E0%A6%A8%E0%A6%89%E0%A6%9C%E0%A6%B2%E0%A6%AF%E0%A6%A8%E0%A6%A1</guid>
      <pubDate>Mon, 09 Nov 2026 09:02:44 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794214964_rkr_6af18c34e5d87.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794214964_rkr_6af18c34e5d87.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794214964_rkr_6af18c34e5d87.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চোটের মিছিলে নিউজিল্যান্ড" /&gt;&lt;/p&gt;&lt;p&gt;ভারতের বিপক্ষে পাঁচ ম্যাচের ওয়ানডে সিরিজে একের পর এক চোটের ধাক্কা সামলাতে হচ্ছে নিউজিল্যান্ডকে। এবার সিরিজের শেষ দুই ওয়ানডে থেকে ছিটকে গেছেন পেসার লকি ফার্গুসন। অন্যদিকে, হেলমেটে আঘাত পাওয়ায় আইসিসির বাধ্যতামূলক সাত দিনের বিরতিতে থাকতে হবে ব্লেয়ার টিকনারকে। ফলে পরবর্তী দুই ম্যাচে খেলা হচ্ছে না তারও।.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%9A%E0%A6%9F%E0%A6%B0-%E0%A6%AE%E0%A6%9B%E0%A6%B2-%E0%A6%A8%E0%A6%89%E0%A6%9C%E0%A6%B2%E0%A6%AF%E0%A6%A8%E0%A6%A1">Education Bangla</source>
    </item>
    <item>
      <title>ফুটবলে সবচেয়ে দামি ভাইয়ের জুটিতে ২৯৪৯ কোটি টাকায় শীর্ষে এমবাপ্পেরা</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AB%E0%A6%9F%E0%A6%AC%E0%A6%B2-%E0%A6%B8%E0%A6%AC%E0%A6%9A%E0%A7%9F-%E0%A6%A6%E0%A6%AE-%E0%A6%AD%E0%A6%87%E0%A7%9F%E0%A6%B0-%E0%A6%9C%E0%A6%9F%E0%A6%A4-%E0%A7%A8%E0%A7%AF%E0%A7%AA%E0%A7%AF-%E0%A6%95%E0%A6%9F-%E0%A6%9F%E0%A6%95%E0%A7%9F-%E0%A6%B6%E0%A6%B0%E0%A6%B7-%E0%A6%8F%E0%A6%AE%E0%A6%AC%E0%A6%AA%E0%A6%AA%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AB%E0%A6%9F%E0%A6%AC%E0%A6%B2-%E0%A6%B8%E0%A6%AC%E0%A6%9A%E0%A7%9F-%E0%A6%A6%E0%A6%AE-%E0%A6%AD%E0%A6%87%E0%A7%9F%E0%A6%B0-%E0%A6%9C%E0%A6%9F%E0%A6%A4-%E0%A7%A8%E0%A7%AF%E0%A7%AA%E0%A7%AF-%E0%A6%95%E0%A6%9F-%E0%A6%9F%E0%A6%95%E0%A7%9F-%E0%A6%B6%E0%A6%B0%E0%A6%B7-%E0%A6%8F%E0%A6%AE%E0%A6%AC%E0%A6%AA%E0%A6%AA%E0%A6%B0</guid>
      <pubDate>Mon, 09 Nov 2026 09:01:50 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794214910_rkr_6af18bfee0247.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794214910_rkr_6af18bfee0247.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794214910_rkr_6af18bfee0247.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফুটবলে সবচেয়ে দামি ভাইয়ের জুটিতে ২৯৪৯ কোটি টাকায় শীর্ষে এমবাপ্পেরা" /&gt;&lt;/p&gt;&lt;p&gt;এক পরিবারের দুই ভাই, দুজনই ফুটবলার। একজন বিশ্ব ফুটবলের মহাতারকা, অন্যজনও গড়ছেন নিজের পরিচয়। বাজারমূল্যের হিসাবে তাদের জুটি এখন বিশ্বের সবচেয়ে দামি। কিলিয়ান ও এথান এমবাপ্পের সম্মিলিত মূল্য প্রায় ২ হাজার ৯৪৯ কোটি টাকা!ফুটবল ইতিহাসে চার্লটন ব্রাদার্স কিংবা নেভিল ব্রাদার্সের মতো ভাইদের জুটি বিশেষ জায়গা.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AB%E0%A6%9F%E0%A6%AC%E0%A6%B2-%E0%A6%B8%E0%A6%AC%E0%A6%9A%E0%A7%9F-%E0%A6%A6%E0%A6%AE-%E0%A6%AD%E0%A6%87%E0%A7%9F%E0%A6%B0-%E0%A6%9C%E0%A6%9F%E0%A6%A4-%E0%A7%A8%E0%A7%AF%E0%A7%AA%E0%A7%AF-%E0%A6%95%E0%A6%9F-%E0%A6%9F%E0%A6%95%E0%A7%9F-%E0%A6%B6%E0%A6%B0%E0%A6%B7-%E0%A6%8F%E0%A6%AE%E0%A6%AC%E0%A6%AA%E0%A6%AA%E0%A6%B0">Education Bangla</source>
    </item>

      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795014711_rkr_6afdc03704283.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৩ উইকেট হারিয়ে চা বিরতিতে বাংলাদেশ" /&gt;&lt;/p&gt;&lt;p&gt;১৫৭ রানে পিছিয়ে থেকে দ্বিতীয় ইনিংসে ব্যাট করতে নেমে বিপদে আছে বাংলাদেশ। চা বিরতির আগ পর্যন্ত বাংলাদেশের সংগ্রহ ৩ উইকেটে ৫৮ রান। এখনও ৯৯ রানে পিছিয়ে আছে শান্তর দল। ক্রিজে রয়েছেন মাহফিজুল ইসলাম (৩০*) এবং তাওহীদ হৃদয় (৪*)।এদিকে জোহানেসবার্গ টেস্টে দক্ষিণ আফ্রিকার প্রথম ইনিংস থেমেছে ৫৫৭ রানে। বাংলাদেশের&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A7%A9-%E0%A6%89%E0%A6%87%E0%A6%95%E0%A6%9F-%E0%A6%B9%E0%A6%B0%E0%A7%9F-%E0%A6%9A-%E0%A6%AC%E0%A6%B0%E0%A6%A4%E0%A6%A4-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6">Education Bangla</source>

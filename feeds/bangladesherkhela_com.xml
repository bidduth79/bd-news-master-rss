      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795709582_rkr_6b085a8ecf12f.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হার্দিককে পেতে দুই তারকাকে ছাড়তে বলেছিল মুম্বাই, রাজি হয়নি রাজস্থান" /&gt;&lt;/p&gt;&lt;p&gt;আইপিএলে দলবদল নিয়ে কম নাটক হয়নি হার্দিক পান্ডিয়াকে ঘিরে। শেষ পর্যন্ত মুম্বাই ইন্ডিয়ানস ছেড়ে পাঞ্জাব কিংসে নাম লিখিয়েছেন ভারতের এই তারকা অলরাউন্ডার। তবে তার ঠিকানা পাঞ্জাব নয়, হতে পারত রাজস্থান রয়্যালসও। হার্দিককে পেতে রাজস্থানের সঙ্গে মুম্বাইয়ের আলোচনা অনেক দূর এগিয়েছিল। কিন্তু বিনিময়ে দুই গুরুত্বপূ&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B9%E0%A6%B0%E0%A6%A6%E0%A6%95%E0%A6%95-%E0%A6%AA%E0%A6%A4-%E0%A6%A6%E0%A6%87-%E0%A6%A4%E0%A6%B0%E0%A6%95%E0%A6%95-%E0%A6%9B%E0%A7%9C%E0%A6%A4-%E0%A6%AC%E0%A6%B2%E0%A6%9B%E0%A6%B2-%E0%A6%AE%E0%A6%AE%E0%A6%AC%E0%A6%87-%E0%A6%B0%E0%A6%9C-%E0%A6%B9%E0%A7%9F%E0%A6%A8-%E0%A6%B0%E0%A6%9C%E0%A6%B8%E0%A6%A5%E0%A6%A8">Education Bangla</source>

      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794896869_rkr_6afbf3e519f43.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794896869_rkr_6afbf3e519f43.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794896869_rkr_6afbf3e519f43.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ম্যাচে বলের আঘাতে প্রাণ গেল আর্জেন্টাইন তরুণ ফুটবলারের" /&gt;&lt;/p&gt;&lt;p&gt;ফুটবল মাঠে একটি মুহূর্তই কেড়ে নিল তরুণ এক খেলোয়াড়ের প্রাণ। সতীর্থদের সঙ্গে মাঠে নেমেছিলেন স্বপ্ন পূরণের আশায়। কিন্তু ম্যাচ চলাকালে মাথায় বলের আঘাত পেয়ে আর ফিরতে পারলেন না। আর্জেন্টিনার ১৮ বছর বয়সী ফুটবলার আবেল নুনিয়েজের মৃত্যুতে শোকের ছায়া নেমে এসেছে দেশটির ফুটবল অঙ্গনে। আর্জেন্টিনার যুব ফুটবল টুর্ন&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%AF%E0%A6%9A-%E0%A6%AC%E0%A6%B2%E0%A6%B0-%E0%A6%86%E0%A6%98%E0%A6%A4-%E0%A6%AA%E0%A6%B0%E0%A6%A3-%E0%A6%97%E0%A6%B2-%E0%A6%86%E0%A6%B0%E0%A6%9C%E0%A6%A8%E0%A6%9F%E0%A6%87%E0%A6%A8-%E0%A6%A4%E0%A6%B0%E0%A6%A3-%E0%A6%AB%E0%A6%9F%E0%A6%AC%E0%A6%B2%E0%A6%B0%E0%A6%B0">Education Bangla</source>
    </item>

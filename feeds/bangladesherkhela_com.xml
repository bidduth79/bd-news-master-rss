      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%87%E0%A6%AA%E0%A6%8F%E0%A6%B2-%E0%A6%A8%E0%A6%B2%E0%A6%AE-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6%E0%A6%B0-%E0%A7%A7%E0%A7%A8-%E0%A6%95%E0%A6%B0%E0%A6%95%E0%A6%9F%E0%A6%B0-%E0%A6%A4%E0%A6%AC-%E0%A6%A4%E0%A6%B2%E0%A6%95%E0%A7%9F-%E0%A6%A8%E0%A6%AE-%E0%A6%A8%E0%A6%87-%E0%A6%B8%E0%A6%95%E0%A6%AC-%E0%A6%AE%E0%A6%B8%E0%A6%A4%E0%A6%AB%E0%A6%9C%E0%A6%B0</guid>
      <pubDate>Wed, 25 Nov 2026 11:09:50 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795604990_rkr_6b06c1fed6ee3.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795604990_rkr_6b06c1fed6ee3.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795604990_rkr_6b06c1fed6ee3.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আইপিএল নিলামে বাংলাদেশের ১২ ক্রিকেটার, তবে তালিকায় নাম নেই সাকিব-মোস্তাফিজের" /&gt;&lt;/p&gt;&lt;p&gt;আইপিএলের নিলাম ঘিরে মোস্তাফিজুর রহমানকে নিয়ে কয়েক দিন ধরেই চলছিল আলোচনা। ধারণা করা হচ্ছিল, ১৬ ডিসেম্বরের নিলামে দেখা যেতে পারে বাংলাদেশের বাঁহাতি পেসারকে। তবে শেষ পর্যন্ত সেই সম্ভাবনা আর সত্যি হলো না। নিলামের প্রাথমিক তালিকায় জায়গা পাননি মোস্তাফিজ, নেই সাকিব আল হাসানের নামও।১৬ ডিসেম্বর অনুষ্ঠেয় নিলা&lt;/p&gt;</description>

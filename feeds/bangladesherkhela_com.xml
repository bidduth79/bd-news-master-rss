      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795014523_rkr_6afdbf7bd0f90.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795014523_rkr_6afdbf7bd0f90.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795014523_rkr_6afdbf7bd0f90.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রোটিয়া ব্যাটারকে বল ছুড়ে শাস্তি পেলেন ইবাদত" /&gt;&lt;/p&gt;&lt;p&gt;দক্ষিণ আফ্রিকার বিপক্ষে জোহানেসবার্গ টেস্টে আচরণবিধি ভাঙার দায়ে শাস্তি পেয়েছেন বাংলাদেশের পেসার ইবাদত হোসেন। তার ম্যাচ ফির ১৫ শতাংশ জরিমানা করেছে ইন্টারন্যাশনাল ক্রিকেট কাউন্সিল (আইসিসি)। পাশাপাশি তার নামের পাশে যোগ হয়েছে একটি ডিমেরিট পয়েন্ট।আইসিসির আচরণবিধির লেভেল-১ ভঙ্গ করেছেন ইবাদত। প্রতিপক্ষ ব্য&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AA%E0%A6%B0%E0%A6%9F%E0%A7%9F-%E0%A6%AC%E0%A6%AF%E0%A6%9F%E0%A6%B0%E0%A6%95-%E0%A6%AC%E0%A6%B2-%E0%A6%9B%E0%A7%9C-%E0%A6%B6%E0%A6%B8%E0%A6%A4-%E0%A6%AA%E0%A6%B2%E0%A6%A8-%E0%A6%87%E0%A6%AC%E0%A6%A6%E0%A6%A4">Education Bangla</source>
    </item>
    <item>
      <title>ইংল্যান্ডের কাছে সিরিজ হেরে অস্ট্রেলিয়ার বিব্রতকর রেকর্ড</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%87%E0%A6%B2%E0%A6%AF%E0%A6%A8%E0%A6%A1%E0%A6%B0-%E0%A6%95%E0%A6%9B-%E0%A6%B8%E0%A6%B0%E0%A6%9C-%E0%A6%B9%E0%A6%B0-%E0%A6%85%E0%A6%B8%E0%A6%9F%E0%A6%B0%E0%A6%B2%E0%A7%9F%E0%A6%B0-%E0%A6%AC%E0%A6%AC%E0%A6%B0%E0%A6%A4%E0%A6%95%E0%A6%B0-%E0%A6%B0%E0%A6%95%E0%A6%B0%E0%A6%A1</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%87%E0%A6%B2%E0%A6%AF%E0%A6%A8%E0%A6%A1%E0%A6%B0-%E0%A6%95%E0%A6%9B-%E0%A6%B8%E0%A6%B0%E0%A6%9C-%E0%A6%B9%E0%A6%B0-%E0%A6%85%E0%A6%B8%E0%A6%9F%E0%A6%B0%E0%A6%B2%E0%A7%9F%E0%A6%B0-%E0%A6%AC%E0%A6%AC%E0%A6%B0%E0%A6%A4%E0%A6%95%E0%A6%B0-%E0%A6%B0%E0%A6%95%E0%A6%B0%E0%A6%A1</guid>
      <pubDate>Wed, 18 Nov 2026 15:08:01 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795014481_rkr_6afdbf51d9613.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795014481_rkr_6afdbf51d9613.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795014481_rkr_6afdbf51d9613.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইংল্যান্ডের কাছে সিরিজ হেরে অস্ট্রেলিয়ার বিব্রতকর রেকর্ড" /&gt;&lt;/p&gt;&lt;p&gt;অস্ট্রেলিয়ার মাটিতে ওয়ানডে সিরিজ জেতা ইংল্যান্ডের জন্য সহজ কোনো কাজ নয়। তবে হোবার্টে সিরিজের শেষ ম্যাচে ৯৭ রানের বড় জয় তুলে নিয়ে সেই কঠিন কাজটিই করে দেখাল হ্যারি ব্রুকের দল। শুধু সিরিজ জয়ই নয়, এই হারে ঘরের মাঠে অস্ট্রেলিয়ার ওয়ানডে ইতিহাসে যুক্ত হয়েছে বিব্রতকর এক রেকর্ড। বিশ্ব চ্যাম্পিয়নরা এবারই প্রথ&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%87%E0%A6%B2%E0%A6%AF%E0%A6%A8%E0%A6%A1%E0%A6%B0-%E0%A6%95%E0%A6%9B-%E0%A6%B8%E0%A6%B0%E0%A6%9C-%E0%A6%B9%E0%A6%B0-%E0%A6%85%E0%A6%B8%E0%A6%9F%E0%A6%B0%E0%A6%B2%E0%A7%9F%E0%A6%B0-%E0%A6%AC%E0%A6%AC%E0%A6%B0%E0%A6%A4%E0%A6%95%E0%A6%B0-%E0%A6%B0%E0%A6%95%E0%A6%B0%E0%A6%A1">Education Bangla</source>
    </item>
    <item>
      <title>গাজী ঘোরি-রাজাউল্লাহর ব্যাটে পাকিস্তানের লিড ২২৭</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%97%E0%A6%9C-%E0%A6%98%E0%A6%B0-%E0%A6%B0%E0%A6%9C%E0%A6%89%E0%A6%B2%E0%A6%B2%E0%A6%B9%E0%A6%B0-%E0%A6%AC%E0%A6%AF%E0%A6%9F-%E0%A6%AA%E0%A6%95%E0%A6%B8%E0%A6%A4%E0%A6%A8%E0%A6%B0-%E0%A6%B2%E0%A6%A1-%E0%A7%A8%E0%A7%A8%E0%A7%AD</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%97%E0%A6%9C-%E0%A6%98%E0%A6%B0-%E0%A6%B0%E0%A6%9C%E0%A6%89%E0%A6%B2%E0%A6%B2%E0%A6%B9%E0%A6%B0-%E0%A6%AC%E0%A6%AF%E0%A6%9F-%E0%A6%AA%E0%A6%95%E0%A6%B8%E0%A6%A4%E0%A6%A8%E0%A6%B0-%E0%A6%B2%E0%A6%A1-%E0%A7%A8%E0%A7%A8%E0%A7%AD</guid>
      <pubDate>Wed, 18 Nov 2026 15:06:48 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795014408_rkr_6afdbf08c12d0.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795014408_rkr_6afdbf08c12d0.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795014408_rkr_6afdbf08c12d0.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গাজী ঘোরি-রাজাউল্লাহর ব্যাটে পাকিস্তানের লিড ২২৭" /&gt;&lt;/p&gt;&lt;p&gt;রাওয়ালপিন্ডিতে শ্রীলঙ্কার বিপক্ষে দ্বিতীয় টেস্টে ব্যাট হাতে দারুণ লড়াই করেছে পাকিস্তান। নবম উইকেটে গাজী ঘোরি ও রাজাউল্লাহর ঝোড়ো জুটিতে বড় লিডের পথে এগিয়েছে স্বাগতিকেরা। ঘোরির প্রথম টেস্ট ফিফটি এবং রাজাউল্লাহর বিধ্বংসী ব্যাটিংয়ে দ্বিতীয় দিনের দ্বিতীয় সেশনে ৩২৫ রানে অলআউট হয়েছে পাকিস্তান। প্রথম ইনিংসে&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%97%E0%A6%9C-%E0%A6%98%E0%A6%B0-%E0%A6%B0%E0%A6%9C%E0%A6%89%E0%A6%B2%E0%A6%B2%E0%A6%B9%E0%A6%B0-%E0%A6%AC%E0%A6%AF%E0%A6%9F-%E0%A6%AA%E0%A6%95%E0%A6%B8%E0%A6%A4%E0%A6%A8%E0%A6%B0-%E0%A6%B2%E0%A6%A1-%E0%A7%A8%E0%A7%A8%E0%A7%AD">Education Bangla</source>
    </item>
    <item>
      <title>বল টেম্পারিংয়ে অস্ট্রেলিয়ার পুরো দলই জড়িত ছিল</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%B2-%E0%A6%9F%E0%A6%AE%E0%A6%AA%E0%A6%B0%E0%A7%9F-%E0%A6%85%E0%A6%B8%E0%A6%9F%E0%A6%B0%E0%A6%B2%E0%A7%9F%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%A6%E0%A6%B2%E0%A6%87-%E0%A6%9C%E0%A7%9C%E0%A6%A4-%E0%A6%9B%E0%A6%B2</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%B2-%E0%A6%9F%E0%A6%AE%E0%A6%AA%E0%A6%B0%E0%A7%9F-%E0%A6%85%E0%A6%B8%E0%A6%9F%E0%A6%B0%E0%A6%B2%E0%A7%9F%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%A6%E0%A6%B2%E0%A6%87-%E0%A6%9C%E0%A7%9C%E0%A6%A4-%E0%A6%9B%E0%A6%B2</guid>
      <pubDate>Wed, 18 Nov 2026 15:06:10 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795014370_rkr_6afdbee233e11.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795014370_rkr_6afdbee233e11.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795014370_rkr_6afdbee233e11.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বল টেম্পারিংয়ে অস্ট্রেলিয়ার পুরো দলই জড়িত ছিল" /&gt;&lt;/p&gt;&lt;p&gt;২০১৮ সালে দক্ষিণ আফ্রিকা সফরে অস্ট্রেলিয়ার বহুল আলোচিত বল টেম্পারিং কাণ্ডে শুধু তিনজন নয়, পুরো দলের সদস্যরাই বিষয়টি জানতেন। এমন বিস্ফোরক দাবি করেছেন অস্ট্রেলিয়ার সাবেক ওপেনার ক্যামেরন ব্যানক্রফট। তার দাবি, স্যান্ডপেপার দিয়ে বলের আকৃতি পরিবর্তনের বিষয়টি দলের সবারই জানা ছিল। এমনকি বল রিভার্স সুইং করান&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%B2-%E0%A6%9F%E0%A6%AE%E0%A6%AA%E0%A6%B0%E0%A7%9F-%E0%A6%85%E0%A6%B8%E0%A6%9F%E0%A6%B0%E0%A6%B2%E0%A7%9F%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%A6%E0%A6%B2%E0%A6%87-%E0%A6%9C%E0%A7%9C%E0%A6%A4-%E0%A6%9B%E0%A6%B2">Education Bangla</source>
    </item>
    <item>
      <title>আর্জেন্টিনার গোলপোস্টে মার্তিনেজের অনন্য কীর্তি</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%B0%E0%A6%9C%E0%A6%A8%E0%A6%9F%E0%A6%A8%E0%A6%B0-%E0%A6%97%E0%A6%B2%E0%A6%AA%E0%A6%B8%E0%A6%9F-%E0%A6%AE%E0%A6%B0%E0%A6%A4%E0%A6%A8%E0%A6%9C%E0%A6%B0-%E0%A6%85%E0%A6%A8%E0%A6%A8%E0%A6%AF-%E0%A6%95%E0%A6%B0%E0%A6%A4</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%B0%E0%A6%9C%E0%A6%A8%E0%A6%9F%E0%A6%A8%E0%A6%B0-%E0%A6%97%E0%A6%B2%E0%A6%AA%E0%A6%B8%E0%A6%9F-%E0%A6%AE%E0%A6%B0%E0%A6%A4%E0%A6%A8%E0%A6%9C%E0%A6%B0-%E0%A6%85%E0%A6%A8%E0%A6%A8%E0%A6%AF-%E0%A6%95%E0%A6%B0%E0%A6%A4</guid>
      <pubDate>Wed, 18 Nov 2026 15:05:25 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795014325_rkr_6afdbeb5d022b.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795014325_rkr_6afdbeb5d022b.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795014325_rkr_6afdbeb5d022b.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আর্জেন্টিনার গোলপোস্টে মার্তিনেজের অনন্য কীর্তি" /&gt;&lt;/p&gt;&lt;p&gt;কোস্টারিকার বিপক্ষে আর্জেন্টিনার গোল উৎসবে হয়তো সবচেয়ে বেশি নজর ছিল আক্রমণভাগের খেলোয়াড়দের দিকে। সাত গোলের ম্যাচে গোলদাতাদের নিয়ে আলোচনা হওয়াই স্বাভাবিক। কিন্তু গোলপোস্টের নিচে দাঁড়িয়ে নিজের মতো করে ইতিহাস লিখেছেন এমিলিয়ানো মার্তিনেজ। একটি গুরুত্বপূর্ণ সেভ, প্রতিপক্ষকে গোলবঞ্চিত রাখা আর তাতেই আর্জেন&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%B0%E0%A6%9C%E0%A6%A8%E0%A6%9F%E0%A6%A8%E0%A6%B0-%E0%A6%97%E0%A6%B2%E0%A6%AA%E0%A6%B8%E0%A6%9F-%E0%A6%AE%E0%A6%B0%E0%A6%A4%E0%A6%A8%E0%A6%9C%E0%A6%B0-%E0%A6%85%E0%A6%A8%E0%A6%A8%E0%A6%AF-%E0%A6%95%E0%A6%B0%E0%A6%A4">Education Bangla</source>

    <item>
      <title>রুদ্ধশ্বাস লড়াইয়ে শ্রীলঙ্কা-ভুটান ম্যাচ ড্র, সেমিফাইনালে বাংলাদেশ</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B0%E0%A6%A6%E0%A6%A7%E0%A6%B6%E0%A6%AC%E0%A6%B8-%E0%A6%B2%E0%A7%9C%E0%A6%87%E0%A7%9F-%E0%A6%B6%E0%A6%B0%E0%A6%B2%E0%A6%99%E0%A6%95-%E0%A6%AD%E0%A6%9F%E0%A6%A8-%E0%A6%AE%E0%A6%AF%E0%A6%9A-%E0%A6%A1%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%B0%E0%A6%A6%E0%A6%A7%E0%A6%B6%E0%A6%AC%E0%A6%B8-%E0%A6%B2%E0%A7%9C%E0%A6%87%E0%A7%9F-%E0%A6%B6%E0%A6%B0%E0%A6%B2%E0%A6%99%E0%A6%95-%E0%A6%AD%E0%A6%9F%E0%A6%A8-%E0%A6%AE%E0%A6%AF%E0%A6%9A-%E0%A6%A1%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6</guid>
      <pubDate>Sun, 08 Nov 2026 16:19:56 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_media/1794154782_6af0a11e55419.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_media/1794154782_6af0a11e55419.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_media/1794154782_6af0a11e55419.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রুদ্ধশ্বাস লড়াইয়ে শ্রীলঙ্কা-ভুটান ম্যাচ ড্র, সেমিফাইনালে বাংলাদেশ" /&gt;&lt;/p&gt;&lt;p&gt;২৩ বছর পর সাফ চ্যাম্পিয়নশিপের শিরোপা পুনরুদ্ধারের পথে আরও একধাপ এগিয়ে গেল বাংলাদেশ। গ্রুপের অপর দুই দল শ্রীলঙ্কা ও ভুটানের মধ্যকার ম্যাচটি ২–২ গোলে ড্র হওয়ায় এক ম্যাচ হাতে রেখেই সেমিফাইনালে জায়গা করে নিয়েছে লাল-সবুজের প্রতিনিধিরা। এর আগে ভুটানের বিপক্ষে ১–০ ব্যবধানের জয় দিয়ে সাফ চ্যাম্পিয়নশিপ মিশন&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B0%E0%A6%A6%E0%A6%A7%E0%A6%B6%E0%A6%AC%E0%A6%B8-%E0%A6%B2%E0%A7%9C%E0%A6%87%E0%A7%9F-%E0%A6%B6%E0%A6%B0%E0%A6%B2%E0%A6%99%E0%A6%95-%E0%A6%AD%E0%A6%9F%E0%A6%A8-%E0%A6%AE%E0%A6%AF%E0%A6%9A-%E0%A6%A1%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6">Education Bangla</source>
    </item>
    <item>
      <title>ছোটদের এশিয়া কাপে ভারতকে হারালো পাকিস্তান</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%9B%E0%A6%9F%E0%A6%A6%E0%A6%B0-%E0%A6%8F%E0%A6%B6%E0%A7%9F-%E0%A6%95%E0%A6%AA-%E0%A6%AD%E0%A6%B0%E0%A6%A4%E0%A6%95-%E0%A6%B9%E0%A6%B0%E0%A6%B2-%E0%A6%AA%E0%A6%95%E0%A6%B8%E0%A6%A4%E0%A6%A8</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%9B%E0%A6%9F%E0%A6%A6%E0%A6%B0-%E0%A6%8F%E0%A6%B6%E0%A7%9F-%E0%A6%95%E0%A6%AA-%E0%A6%AD%E0%A6%B0%E0%A6%A4%E0%A6%95-%E0%A6%B9%E0%A6%B0%E0%A6%B2-%E0%A6%AA%E0%A6%95%E0%A6%B8%E0%A6%A4%E0%A6%A8</guid>
      <pubDate>Sun, 08 Nov 2026 15:40:27 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794152427_rkr_6af097eb12f88.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794152427_rkr_6af097eb12f88.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794152427_rkr_6af097eb12f88.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ছোটদের এশিয়া কাপে ভারতকে হারালো পাকিস্তান" /&gt;&lt;/p&gt;&lt;p&gt;বড়দের ক্রিকেটে গত কয়েক বছরে ভারত যেভাবে পাকিস্তানের উপর দাপট দেখিয়েছে তা দেখাতে পারলেন না ছোটরা। ব্যাটিং ব্যর্থতায় অনূর্ধ্ব-১৯ এশিয়া কাপে পাকিস্তানের কাছে হারল ভারত। অর্জুন রাজপুতের শতরানও কাজে এল না। পাল্টা অপরাজিত শতরান করে পাকিস্তানকে জেতালেন হামজা জহুর।প্রথমে ব্যাট করে ২০৮ রানে অল আউট হয় ভারত।.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%9B%E0%A6%9F%E0%A6%A6%E0%A6%B0-%E0%A6%8F%E0%A6%B6%E0%A7%9F-%E0%A6%95%E0%A6%AA-%E0%A6%AD%E0%A6%B0%E0%A6%A4%E0%A6%95-%E0%A6%B9%E0%A6%B0%E0%A6%B2-%E0%A6%AA%E0%A6%95%E0%A6%B8%E0%A6%A4%E0%A6%A8">Education Bangla</source>
    </item>
    <item>
      <title>টানা তিন হারে বিপর্যস্ত ম্যানসিটি, ‘ভারসাম্য’ ধরে রাখার আহ্বান কোচের</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%9F%E0%A6%A8-%E0%A6%A4%E0%A6%A8-%E0%A6%B9%E0%A6%B0-%E0%A6%AC%E0%A6%AA%E0%A6%B0%E0%A6%AF%E0%A6%B8%E0%A6%A4-%E0%A6%AE%E0%A6%AF%E0%A6%A8%E0%A6%B8%E0%A6%9F-%E0%A6%AD%E0%A6%B0%E0%A6%B8%E0%A6%AE%E0%A6%AF-%E0%A6%A7%E0%A6%B0-%E0%A6%B0%E0%A6%96%E0%A6%B0-%E0%A6%86%E0%A6%B9%E0%A6%AC%E0%A6%A8-%E0%A6%95%E0%A6%9A%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%9F%E0%A6%A8-%E0%A6%A4%E0%A6%A8-%E0%A6%B9%E0%A6%B0-%E0%A6%AC%E0%A6%AA%E0%A6%B0%E0%A6%AF%E0%A6%B8%E0%A6%A4-%E0%A6%AE%E0%A6%AF%E0%A6%A8%E0%A6%B8%E0%A6%9F-%E0%A6%AD%E0%A6%B0%E0%A6%B8%E0%A6%AE%E0%A6%AF-%E0%A6%A7%E0%A6%B0-%E0%A6%B0%E0%A6%96%E0%A6%B0-%E0%A6%86%E0%A6%B9%E0%A6%AC%E0%A6%A8-%E0%A6%95%E0%A6%9A%E0%A6%B0</guid>
      <pubDate>Sun, 08 Nov 2026 15:39:36 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794152376_rkr_6af097b8a09c9.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794152376_rkr_6af097b8a09c9.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794152376_rkr_6af097b8a09c9.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টানা তিন হারে বিপর্যস্ত ম্যানসিটি, ‘ভারসাম্য’ ধরে রাখার আহ্বান কোচের" /&gt;&lt;/p&gt;&lt;p&gt;মৌসুমের শুরুতে টানা সাত ম্যাচ জিতে উড়ছিল ম্যানচেস্টার সিটি; কিন্তু সেই দলই এখন প্রিমিয়ার লিগে টানা তিন হারের মুখে। নটিংহ্যাম ফরেস্টের মাঠে শনিবার ৩-১ গোলে হেরে শিরোপার দৌড়ে বড় ধাক্কা খেয়েছে এনজো মারেস্কার দল। এমন পরিস্থিতিতে দলের পারফরম্যান্স নিয়ে প্রতিক্রিয়া জানানোর ক্ষেত্রে ‘ভারসাম্য’ রাখার আহ্বান&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%9F%E0%A6%A8-%E0%A6%A4%E0%A6%A8-%E0%A6%B9%E0%A6%B0-%E0%A6%AC%E0%A6%AA%E0%A6%B0%E0%A6%AF%E0%A6%B8%E0%A6%A4-%E0%A6%AE%E0%A6%AF%E0%A6%A8%E0%A6%B8%E0%A6%9F-%E0%A6%AD%E0%A6%B0%E0%A6%B8%E0%A6%AE%E0%A6%AF-%E0%A6%A7%E0%A6%B0-%E0%A6%B0%E0%A6%96%E0%A6%B0-%E0%A6%86%E0%A6%B9%E0%A6%AC%E0%A6%A8-%E0%A6%95%E0%A6%9A%E0%A6%B0">Education Bangla</source>
    </item>
    <item>
      <title>‘যোগাযোগ করলে তার কাছে শিখব’, ইউসুফের পরামর্শের জবাবে বাবর</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AF%E0%A6%97%E0%A6%AF%E0%A6%97-%E0%A6%95%E0%A6%B0%E0%A6%B2-%E0%A6%A4%E0%A6%B0-%E0%A6%95%E0%A6%9B-%E0%A6%B6%E0%A6%96%E0%A6%AC-%E0%A6%87%E0%A6%89%E0%A6%B8%E0%A6%AB%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%AE%E0%A6%B0%E0%A6%B6%E0%A6%B0-%E0%A6%9C%E0%A6%AC%E0%A6%AC-%E0%A6%AC%E0%A6%AC%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AF%E0%A6%97%E0%A6%AF%E0%A6%97-%E0%A6%95%E0%A6%B0%E0%A6%B2-%E0%A6%A4%E0%A6%B0-%E0%A6%95%E0%A6%9B-%E0%A6%B6%E0%A6%96%E0%A6%AC-%E0%A6%87%E0%A6%89%E0%A6%B8%E0%A6%AB%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%AE%E0%A6%B0%E0%A6%B6%E0%A6%B0-%E0%A6%9C%E0%A6%AC%E0%A6%AC-%E0%A6%AC%E0%A6%AC%E0%A6%B0</guid>
      <pubDate>Sun, 08 Nov 2026 15:34:20 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794152060_rkr_6af0967cb742f.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794152060_rkr_6af0967cb742f.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794152060_rkr_6af0967cb742f.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘যোগাযোগ করলে তার কাছে শিখব’, ইউসুফের পরামর্শের জবাবে বাবর" /&gt;&lt;/p&gt;&lt;p&gt;টেস্ট ক্রিকেটের কিংবদন্তি মোহাম্মদ ইউসুফের বিশেষায়িত কোচিং নিতে ইংল্যান্ড বা অস্ট্রেলিয়ায় যাওয়ার পরামর্শের জবাব দিয়েছেন বাবর আজম। পাকিস্তানের সাবেক এই ব্যাটার জানিয়েছেন, ইউসুফ যোগাযোগ করলে তার কাছ থেকে শিখতে আগ্রহী বাবর।বাবরের সাম্প্রতিক ফর্ম ও ব্যাটিংয়ের টেকনিক নিয়ে উদ্বেগ প্রকাশ করে ইংল্যান্ড অথবা&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AF%E0%A6%97%E0%A6%AF%E0%A6%97-%E0%A6%95%E0%A6%B0%E0%A6%B2-%E0%A6%A4%E0%A6%B0-%E0%A6%95%E0%A6%9B-%E0%A6%B6%E0%A6%96%E0%A6%AC-%E0%A6%87%E0%A6%89%E0%A6%B8%E0%A6%AB%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%AE%E0%A6%B0%E0%A6%B6%E0%A6%B0-%E0%A6%9C%E0%A6%AC%E0%A6%AC-%E0%A6%AC%E0%A6%AC%E0%A6%B0">Education Bangla</source>
    </item>

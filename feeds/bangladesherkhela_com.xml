      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794139541_rkr_6af06595543d8.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আন্তঃকলেজ ক্রীড়া প্রতিযোগিতায় খেলোয়াড়দের মানতে হবে কঠিন নিয়ম" /&gt;&lt;/p&gt;&lt;p&gt;ঢাকা শিক্ষা বোর্ডের অধীন আন্তঃকলেজ ক্রীড়া প্রতিযোগিতা ২০২৬-২০২৭ আয়োজনের বিস্তারিত নীতিমালা (বাইলজ) প্রকাশ করা হয়েছে। ফুটবল, ক্রিকেট, ভলিবল, হ্যান্ডবল, ব্যাডমিন্টন ও অ্যাথলেটিকসসহ বিভিন্ন ইভেন্টে অংশগ্রহণের নিয়মকানুন নির্ধারণ করে এ নীতিমালা প্রকাশ করেছে মাধ্যমিক ও উচ্চমাধ্যমিক শিক্ষা বোর্ড, ঢাকা। প্র&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%A8%E0%A6%A4%E0%A6%95%E0%A6%B2%E0%A6%9C-%E0%A6%95%E0%A6%B0%E0%A7%9C-%E0%A6%AA%E0%A6%B0%E0%A6%A4%E0%A6%AF%E0%A6%97%E0%A6%A4%E0%A7%9F-%E0%A6%96%E0%A6%B2%E0%A7%9F%E0%A7%9C%E0%A6%A6%E0%A6%B0-%E0%A6%AE%E0%A6%A8%E0%A6%A4-%E0%A6%B9%E0%A6%AC-%E0%A6%95%E0%A6%A0%E0%A6%A8-%E0%A6%A8%E0%A7%9F%E0%A6%AE">Education Bangla</source>

      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794743703_rkr_6af99d97c0d7d.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794743703_rkr_6af99d97c0d7d.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794743703_rkr_6af99d97c0d7d.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অভিষেকেই অনাকাঙ্ক্ষিত রেকর্ডে মাহফিজুল" /&gt;&lt;/p&gt;&lt;p&gt;স্বপ্নের টেস্ট অভিষেকটা দুঃস্বপ্নে পরিণত হলো মাহফিজুল ইসলাম রবিনের। আন্তর্জাতিক ক্রিকেটের দীর্ঘ পরিসরে প্রথম টেস্টের প্রথম বলেই সাজঘরে ফিরতে হলো তরুণ এই ওপেনারকে। দক্ষিণ আফ্রিকার পেসার কাগিসো রাবাদার বলে স্লিপে ক্যাচ দিয়ে ফিরেছেন তিনি।তাতে অভিষেকের প্রথম বলেই আউট হওয়ার বিরল তালিকায় যুক্ত হয়েছে তার ন&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%85%E0%A6%AD%E0%A6%B7%E0%A6%95%E0%A6%87-%E0%A6%85%E0%A6%A8%E0%A6%95%E0%A6%99%E0%A6%95%E0%A6%B7%E0%A6%A4-%E0%A6%B0%E0%A6%95%E0%A6%B0%E0%A6%A1-%E0%A6%AE%E0%A6%B9%E0%A6%AB%E0%A6%9C%E0%A6%B2">Education Bangla</source>

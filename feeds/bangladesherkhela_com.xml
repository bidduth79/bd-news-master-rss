      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795533041_rkr_6b05a8f171302.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795533041_rkr_6b05a8f171302.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795533041_rkr_6b05a8f171302.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডোনাল্ড-সল্টের ঝড়ে অস্ট্রেলিয়াকে উড়িয়ে সিরিজে সমতা ফেরাল ইংল্যান্ড" /&gt;&lt;/p&gt;&lt;p&gt;অ্যানিউরিন ডোনাল্ড ও ফিল সল্টের বিধ্বংসী ব্যাটিংয়ে অস্ট্রেলিয়াকে পাত্তাই দিল না ইংল্যান্ড। ক্যারারা ওভালে মঙ্গলবার (২৪ নভেম্বর) পাঁচ ম্যাচ সিরিজের দ্বিতীয় টি-টোয়েন্টিতে স্বাগতিকদের ৮ উইকেটে হারিয়েছে ইংলিশরা। ১৮৫ রানের লক্ষ্য মাত্র ১৩.১ ওভারেই টপকে গেছে তারা। তাতে সিরিজে ১-১ সমতা ফিরেছে।ইংল্যান্ডের জ&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%A1%E0%A6%A8%E0%A6%B2%E0%A6%A1-%E0%A6%B8%E0%A6%B2%E0%A6%9F%E0%A6%B0-%E0%A6%9D%E0%A7%9C-%E0%A6%85%E0%A6%B8%E0%A6%9F%E0%A6%B0%E0%A6%B2%E0%A7%9F%E0%A6%95-%E0%A6%89%E0%A7%9C%E0%A7%9F-%E0%A6%B8%E0%A6%B0%E0%A6%9C-%E0%A6%B8%E0%A6%AE%E0%A6%A4-%E0%A6%AB%E0%A6%B0%E0%A6%B2-%E0%A6%87%E0%A6%B2%E0%A6%AF%E0%A6%A8%E0%A6%A1">Education Bangla</source>
    </item>
    <item>
      <title>‘আজ নিজের ওপর বিশ্বাস রেখেছিলাম’, ডাবল সেঞ্চুরির পর যা বললেন সূর্যবংশী</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%9C-%E0%A6%A8%E0%A6%9C%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%AC%E0%A6%B6%E0%A6%AC%E0%A6%B8-%E0%A6%B0%E0%A6%96%E0%A6%9B%E0%A6%B2%E0%A6%AE-%E0%A6%A1%E0%A6%AC%E0%A6%B2-%E0%A6%B8%E0%A6%9E%E0%A6%9A%E0%A6%B0%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AF-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A6%A8-%E0%A6%B8%E0%A6%B0%E0%A6%AF%E0%A6%AC%E0%A6%B6</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%9C-%E0%A6%A8%E0%A6%9C%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%AC%E0%A6%B6%E0%A6%AC%E0%A6%B8-%E0%A6%B0%E0%A6%96%E0%A6%9B%E0%A6%B2%E0%A6%AE-%E0%A6%A1%E0%A6%AC%E0%A6%B2-%E0%A6%B8%E0%A6%9E%E0%A6%9A%E0%A6%B0%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AF-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A6%A8-%E0%A6%B8%E0%A6%B0%E0%A6%AF%E0%A6%AC%E0%A6%B6</guid>
      <pubDate>Tue, 24 Nov 2026 14:18:38 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795529918_rkr_6b059cbe7e949.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795529918_rkr_6b059cbe7e949.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795529918_rkr_6b059cbe7e949.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘আজ নিজের ওপর বিশ্বাস রেখেছিলাম’, ডাবল সেঞ্চুরির পর যা বললেন সূর্যবংশী" /&gt;&lt;/p&gt;&lt;p&gt;এশিয়া কাপ রাইজিং স্টারস টুর্নামেন্টে সংযুক্ত আরব আমিরাতের বিপক্ষে ব্যাট হাতে রীতিমতো তাণ্ডব চালিয়েছেন বৈভব সূর্যবংশী। মাত্র ৫৩ বলে ২০৪ রানের বিধ্বংসী ইনিংস খেলে ভারত ‘এ’ দলকে জিতিয়েছেন। এমন অবিশ্বাস্য পারফরম্যান্সের স্বীকৃতি হিসেবে ম্যাচসেরার পুরস্কারও উঠেছে তার হাতে।ম্যাচ শেষে নিজের ইনিংস নিয়ে কথা.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%9C-%E0%A6%A8%E0%A6%9C%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%AC%E0%A6%B6%E0%A6%AC%E0%A6%B8-%E0%A6%B0%E0%A6%96%E0%A6%9B%E0%A6%B2%E0%A6%AE-%E0%A6%A1%E0%A6%AC%E0%A6%B2-%E0%A6%B8%E0%A6%9E%E0%A6%9A%E0%A6%B0%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AF-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A6%A8-%E0%A6%B8%E0%A6%B0%E0%A6%AF%E0%A6%AC%E0%A6%B6">Education Bangla</source>
    </item>
    <item>
      <title>ছক্কা খরা কাটিয়ে বাবরের রেকর্ড</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%9B%E0%A6%95%E0%A6%95-%E0%A6%96%E0%A6%B0-%E0%A6%95%E0%A6%9F%E0%A7%9F-%E0%A6%AC%E0%A6%AC%E0%A6%B0%E0%A6%B0-%E0%A6%B0%E0%A6%95%E0%A6%B0%E0%A6%A1</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%9B%E0%A6%95%E0%A6%95-%E0%A6%96%E0%A6%B0-%E0%A6%95%E0%A6%9F%E0%A7%9F-%E0%A6%AC%E0%A6%AC%E0%A6%B0%E0%A6%B0-%E0%A6%B0%E0%A6%95%E0%A6%B0%E0%A6%A1</guid>
      <pubDate>Tue, 24 Nov 2026 13:26:43 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795526803_rkr_6b05909394113.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795526803_rkr_6b05909394113.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795526803_rkr_6b05909394113.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ছক্কা খরা কাটিয়ে বাবরের রেকর্ড" /&gt;&lt;/p&gt;&lt;p&gt;টি-টোয়েন্টিতে দীর্ঘদিন ছক্কা পাচ্ছিলেন না বাবর আজম। অবশেষে সেই অপেক্ষার অবসান ঘটল ইন্টারন্যাশনাল লিগ টি-টোয়েন্টিতে (আইএলটি-টোয়েন্টি)। অভিষেক ম্যাচেই দুটি ছক্কা হাঁকানোর পাশাপাশি নতুন রেকর্ড গড়েছেন পাকিস্তানের এই ব্যাটার।সোমবার শারজাহ ওয়ারিয়র্সের বিপক্ষে ৫১ বলে ৮৬ রানের দুর্দান্ত ইনিংস খেলেন বাবর। ১৩&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%9B%E0%A6%95%E0%A6%95-%E0%A6%96%E0%A6%B0-%E0%A6%95%E0%A6%9F%E0%A7%9F-%E0%A6%AC%E0%A6%AC%E0%A6%B0%E0%A6%B0-%E0%A6%B0%E0%A6%95%E0%A6%B0%E0%A6%A1">Education Bangla</source>
    </item>
    <item>
      <title>‘আমি বিশ্বসেরা গোলরক্ষক হব’–সতীর্থকে ভবিষ্যদ্বাণী করেছিলেন এমি মার্টিনেজ</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%AE-%E0%A6%AC%E0%A6%B6%E0%A6%AC%E0%A6%B8%E0%A6%B0-%E0%A6%97%E0%A6%B2%E0%A6%B0%E0%A6%95%E0%A6%B7%E0%A6%95-%E0%A6%B9%E0%A6%AC%E0%A6%B8%E0%A6%A4%E0%A6%B0%E0%A6%A5%E0%A6%95-%E0%A6%AD%E0%A6%AC%E0%A6%B7%E0%A6%AF%E0%A6%A6%E0%A6%AC%E0%A6%A3-%E0%A6%95%E0%A6%B0%E0%A6%9B%E0%A6%B2%E0%A6%A8-%E0%A6%8F%E0%A6%AE-%E0%A6%AE%E0%A6%B0%E0%A6%9F%E0%A6%A8%E0%A6%9C</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%AE-%E0%A6%AC%E0%A6%B6%E0%A6%AC%E0%A6%B8%E0%A6%B0-%E0%A6%97%E0%A6%B2%E0%A6%B0%E0%A6%95%E0%A6%B7%E0%A6%95-%E0%A6%B9%E0%A6%AC%E0%A6%B8%E0%A6%A4%E0%A6%B0%E0%A6%A5%E0%A6%95-%E0%A6%AD%E0%A6%AC%E0%A6%B7%E0%A6%AF%E0%A6%A6%E0%A6%AC%E0%A6%A3-%E0%A6%95%E0%A6%B0%E0%A6%9B%E0%A6%B2%E0%A6%A8-%E0%A6%8F%E0%A6%AE-%E0%A6%AE%E0%A6%B0%E0%A6%9F%E0%A6%A8%E0%A6%9C</guid>
      <pubDate>Tue, 24 Nov 2026 13:25:48 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795526748_rkr_6b05905c199b0.png" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795526748_rkr_6b05905c199b0.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795526748_rkr_6b05905c199b0.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘আমি বিশ্বসেরা গোলরক্ষক হব’–সতীর্থকে ভবিষ্যদ্বাণী করেছিলেন এমি মার্টিনেজ" /&gt;&lt;/p&gt;&lt;p&gt;আর্সেনালে যোগ দিলেও সেখানে খুব বেশি খেলার সুযোগ পাননি এমিলিয়ানো মার্টিনেজ। সে সময়ে ধারে মোট ছয়টি ক্লাবে খেলেছেন এই আর্জেন্টাইন গোলরক্ষক। ছবি: রয়টার্সআর্সেনালে আর্জেন্টাইন গোলরক্ষক এমিলিয়ানো মার্টিনেজের ক্যারিয়ারের শুরুর দিকের একটি বিশেষ ঘটনা স্মরণ করেছেন সাবেক সতীর্থ সান্তি কাসোরলা। তখন মিডফিল্ডার&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%AE-%E0%A6%AC%E0%A6%B6%E0%A6%AC%E0%A6%B8%E0%A6%B0-%E0%A6%97%E0%A6%B2%E0%A6%B0%E0%A6%95%E0%A6%B7%E0%A6%95-%E0%A6%B9%E0%A6%AC%E0%A6%B8%E0%A6%A4%E0%A6%B0%E0%A6%A5%E0%A6%95-%E0%A6%AD%E0%A6%AC%E0%A6%B7%E0%A6%AF%E0%A6%A6%E0%A6%AC%E0%A6%A3-%E0%A6%95%E0%A6%B0%E0%A6%9B%E0%A6%B2%E0%A6%A8-%E0%A6%8F%E0%A6%AE-%E0%A6%AE%E0%A6%B0%E0%A6%9F%E0%A6%A8%E0%A6%9C">Education Bangla</source>
    </item>
    <item>
      <title>জাতীয় স্টেডিয়ামে লিগের খেলাও চান ফুটবলাররা</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%9C%E0%A6%A4%E0%A7%9F-%E0%A6%B8%E0%A6%9F%E0%A6%A1%E0%A7%9F%E0%A6%AE-%E0%A6%B2%E0%A6%97%E0%A6%B0-%E0%A6%96%E0%A6%B2%E0%A6%93-%E0%A6%9A%E0%A6%A8-%E0%A6%AB%E0%A6%9F%E0%A6%AC%E0%A6%B2%E0%A6%B0%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%9C%E0%A6%A4%E0%A7%9F-%E0%A6%B8%E0%A6%9F%E0%A6%A1%E0%A7%9F%E0%A6%AE-%E0%A6%B2%E0%A6%97%E0%A6%B0-%E0%A6%96%E0%A6%B2%E0%A6%93-%E0%A6%9A%E0%A6%A8-%E0%A6%AB%E0%A6%9F%E0%A6%AC%E0%A6%B2%E0%A6%B0%E0%A6%B0</guid>
      <pubDate>Tue, 24 Nov 2026 12:52:19 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795524739_rkr_6b058883ca64e.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795524739_rkr_6b058883ca64e.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795524739_rkr_6b058883ca64e.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জাতীয় স্টেডিয়ামে লিগের খেলাও চান ফুটবলাররা" /&gt;&lt;/p&gt;&lt;p&gt;ম্যাচ শেষে মাঠে প্রবেশ করেন গণমাধ্যমকর্মীরা। ছিলেন কিছু দর্শকও। সব মিলিয়ে ফুটবল ম্যাচ ঘিরে তৈরি হয় পরিচিত এক আবহ।দীর্ঘ পাঁচ বছর দুই মাস পর মঙ্গলবার ঢাকা জাতীয় স্টেডিয়ামে ফিরেছে ঘরোয়া ফুটবল। এদিন ফেডারেশন কাপের ম্যাচে মুখোমুখি হয়েছিল ফর্টিস এফসি ও রহমতগঞ্জ। সংস্কারকাজের জন্য ২০২১ সালের পর এই ভেন্যুতে&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%9C%E0%A6%A4%E0%A7%9F-%E0%A6%B8%E0%A6%9F%E0%A6%A1%E0%A7%9F%E0%A6%AE-%E0%A6%B2%E0%A6%97%E0%A6%B0-%E0%A6%96%E0%A6%B2%E0%A6%93-%E0%A6%9A%E0%A6%A8-%E0%A6%AB%E0%A6%9F%E0%A6%AC%E0%A6%B2%E0%A6%B0%E0%A6%B0">Education Bangla</source>
    </item>

    <item>
      <title>৬ বছর পর খুলনার শিরোপা</title>
      <link>https://bangladesherkhela.com/news/%E0%A7%AC-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%96%E0%A6%B2%E0%A6%A8%E0%A6%B0-%E0%A6%B6%E0%A6%B0%E0%A6%AA</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A7%AC-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%96%E0%A6%B2%E0%A6%A8%E0%A6%B0-%E0%A6%B6%E0%A6%B0%E0%A6%AA</guid>
      <pubDate>Tue, 17 Nov 2026 16:24:49 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794932689_rkr_6afc7fd13e65d.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794932689_rkr_6afc7fd13e65d.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794932689_rkr_6afc7fd13e65d.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৬ বছর পর খুলনার শিরোপা" /&gt;&lt;/p&gt;&lt;p&gt;কেবল ড্র করলেই হতো। পয়েন্ট টেবিলের শীর্ষে থেকে খুলনা বিভাগ জিতে যেত জাতীয় ক্রিকেট লিগের শিরোপা। কিন্তু মোহাম্মদ মিঠুনের দল কোনো ঝুঁকিই নিল না। সিলেটে শেষ রাউন্ডের খেলায় রংপুর বিভাগকে ৯ উইকেটে উড়িয়ে জাতীয় ক্রিকেট লিগের ২৮তম আসরের শিরোপা জিতে নিল খুলনা বিভাগ।৬ বছর পর খুলনার শোকেসে জাতীয় ক্রিকেট লিগের.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A7%AC-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%96%E0%A6%B2%E0%A6%A8%E0%A6%B0-%E0%A6%B6%E0%A6%B0%E0%A6%AA">Education Bangla</source>
    </item>
    <item>
      <title>বৃষ্টি-ঝড়ে পণ্ড দিনের খেলা</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%B7%E0%A6%9F-%E0%A6%9D%E0%A7%9C-%E0%A6%AA%E0%A6%A3%E0%A6%A1-%E0%A6%A6%E0%A6%A8%E0%A6%B0-%E0%A6%96%E0%A6%B2</link>

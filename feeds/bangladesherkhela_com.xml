    <item>
      <title>দল ভালো অবস্থানে, কপাল পুড়লো সাকিবের</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%A6%E0%A6%B2-%E0%A6%AD%E0%A6%B2-%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A6%A5%E0%A6%A8-%E0%A6%95%E0%A6%AA%E0%A6%B2-%E0%A6%AA%E0%A7%9C%E0%A6%B2-%E0%A6%B8%E0%A6%95%E0%A6%AC%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%A6%E0%A6%B2-%E0%A6%AD%E0%A6%B2-%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A6%A5%E0%A6%A8-%E0%A6%95%E0%A6%AA%E0%A6%B2-%E0%A6%AA%E0%A7%9C%E0%A6%B2-%E0%A6%B8%E0%A6%95%E0%A6%AC%E0%A6%B0</guid>
      <pubDate>Thu, 19 Nov 2026 14:14:30 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795097670_rkr_6aff044665f64.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795097670_rkr_6aff044665f64.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795097670_rkr_6aff044665f64.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দল ভালো অবস্থানে, কপাল পুড়লো সাকিবের" /&gt;&lt;/p&gt;&lt;p&gt;অভিষেক ইনিংসেই ৭ উইকেট। শুরুটা স্বপ্নের মতো হয়েছিল পাকিস্তানের পেসার সাকিব খানের। কিন্তু ক্যারিয়ারের দ্বিতীয় টেস্টেই কপাল পুড়লো তার।হ্যামস্ট্রিং চোটের কারণে শ্রীলঙ্কার বিপক্ষে রাওয়ালপিন্ডিতে চলমান দ্বিতীয় টেস্টের বাকি অংশ থেকে ছিটকে গেছেন সাকিব। বাঁ পায়ের হ্যামস্ট্রিংয়ে চোট পেয়েছেন ৩১ বছর বয়সী এই পে&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%A6%E0%A6%B2-%E0%A6%AD%E0%A6%B2-%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A6%A5%E0%A6%A8-%E0%A6%95%E0%A6%AA%E0%A6%B2-%E0%A6%AA%E0%A7%9C%E0%A6%B2-%E0%A6%B8%E0%A6%95%E0%A6%AC%E0%A6%B0">Education Bangla</source>
    </item>
    <item>
      <title>ফিফা সভাপতি নির্বাচন: ইনফান্তিনোর প্রতিদ্বন্দ্বী দুইজন</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AB%E0%A6%AB-%E0%A6%B8%E0%A6%AD%E0%A6%AA%E0%A6%A4-%E0%A6%A8%E0%A6%B0%E0%A6%AC%E0%A6%9A%E0%A6%A8-%E0%A6%87%E0%A6%A8%E0%A6%AB%E0%A6%A8%E0%A6%A4%E0%A6%A8%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%A4%E0%A6%A6%E0%A6%AC%E0%A6%A8%E0%A6%A6%E0%A6%AC-%E0%A6%A6%E0%A6%87%E0%A6%9C%E0%A6%A8</link>

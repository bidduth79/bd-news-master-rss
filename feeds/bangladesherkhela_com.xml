      <enclosure url="https://bangladesherkhela.com/uploads/rkr_media/1794315648_6af31580a7168.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_media/1794315648_6af31580a7168.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_media/1794315648_6af31580a7168.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মোসাদ্দেকের আরেক সেঞ্চুরি, ড্র খুলনা-চট্টগ্রামের ম্যাচ" /&gt;&lt;/p&gt;&lt;p&gt;তাইবুর রহমানের ডাবল সেঞ্চুরি ও মোহাম্মদ মিঠুনের ১৮২ রানের পর শেষ পর্যন্ত ড্র হলো খুলনা ও ঢাকা বিভাগের মধ্যকার ম্যাচটি। ৬ রাউন্ড শেষে তিন জয় ও তিন ড্রয়ে ৯ পয়েন্ট নিয়ে টেবিলের শীর্ষে আছে খুলনা। ৭ পয়েন্ট নিয়ে ঢাকা আছে দুইয়ে।এদিকে চট্টগ্রাম ও রংপুরের ড্রয়ের ম্যাচে ১৪৫ রানের ইনিংস খেলেছেন মিম মোসাদ্দেক।.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%B8%E0%A6%A6%E0%A6%A6%E0%A6%95%E0%A6%B0-%E0%A6%86%E0%A6%B0%E0%A6%95-%E0%A6%B8%E0%A6%9E%E0%A6%9A%E0%A6%B0-%E0%A6%A1%E0%A6%B0-%E0%A6%96%E0%A6%B2%E0%A6%A8-%E0%A6%9A%E0%A6%9F%E0%A6%9F%E0%A6%97%E0%A6%B0%E0%A6%AE%E0%A6%B0-%E0%A6%AE%E0%A6%AF%E0%A6%9A">Education Bangla</source>
    </item>
    <item>
      <title>ম্যানইউতে আরও সময় পাচ্ছেন ক্যারিক!</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%AF%E0%A6%A8%E0%A6%87%E0%A6%89%E0%A6%A4-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A6%B8%E0%A6%AE%E0%A7%9F-%E0%A6%AA%E0%A6%9A%E0%A6%9B%E0%A6%A8-%E0%A6%95%E0%A6%AF%E0%A6%B0%E0%A6%95</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%AF%E0%A6%A8%E0%A6%87%E0%A6%89%E0%A6%A4-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A6%B8%E0%A6%AE%E0%A7%9F-%E0%A6%AA%E0%A6%9A%E0%A6%9B%E0%A6%A8-%E0%A6%95%E0%A6%AF%E0%A6%B0%E0%A6%95</guid>
      <pubDate>Tue, 10 Nov 2026 13:00:04 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794315604_rkr_6af3155439ebb.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794315604_rkr_6af3155439ebb.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794315604_rkr_6af3155439ebb.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ম্যানইউতে আরও সময় পাচ্ছেন ক্যারিক!" /&gt;&lt;/p&gt;&lt;p&gt;গত ২৫ অক্টোবর বোর্নমাউথের কাছে ৩-০ গোলে হারের পরই মাইকেল ক্যারিকের চাকরি যায় যায় অবস্থা। কিন্তু তাকে আরও সময় দিয়েছিল ম্যানচেস্টার ইউনাইটেড কর্তৃপক্ষ। তারপর আরও তিন ম্যাচ খেলে একটি করে জয়, ড্র ও হারের মিশ্র অভিজ্ঞতা হয়েছে ক্লাবের। অনেকের আশঙ্কা, আগামী ২২ নভেম্বর প্রিমিয়ার লিগে লিভারপুলের বিপক্ষে হয়তো&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%AF%E0%A6%A8%E0%A6%87%E0%A6%89%E0%A6%A4-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A6%B8%E0%A6%AE%E0%A7%9F-%E0%A6%AA%E0%A6%9A%E0%A6%9B%E0%A6%A8-%E0%A6%95%E0%A6%AF%E0%A6%B0%E0%A6%95">Education Bangla</source>
    </item>
    <item>
      <title>‘৪ বছরে আমার পুরো পৃথিবীটাই ওলটপালট হয়ে গেছে’</title>
      <link>https://bangladesherkhela.com/news/%E0%A7%AA-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%86%E0%A6%AE%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A6%AC%E0%A6%9F%E0%A6%87-%E0%A6%93%E0%A6%B2%E0%A6%9F%E0%A6%AA%E0%A6%B2%E0%A6%9F-%E0%A6%B9%E0%A7%9F-%E0%A6%97%E0%A6%9B</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A7%AA-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%86%E0%A6%AE%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A6%AC%E0%A6%9F%E0%A6%87-%E0%A6%93%E0%A6%B2%E0%A6%9F%E0%A6%AA%E0%A6%B2%E0%A6%9F-%E0%A6%B9%E0%A7%9F-%E0%A6%97%E0%A6%9B</guid>
      <pubDate>Tue, 10 Nov 2026 12:59:24 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794315564_rkr_6af3152c06023.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794315564_rkr_6af3152c06023.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794315564_rkr_6af3152c06023.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘৪ বছরে আমার পুরো পৃথিবীটাই ওলটপালট হয়ে গেছে’" /&gt;&lt;/p&gt;&lt;p&gt;নিষিদ্ধ ওষুধ সেবনের অভিযোগ থেকে নিজেকে প্রমাণ করতে চার বছর ধরে লড়াই করেছেন ইংলিশ ক্রিকেটার লরি ইভান্স। এই দীর্ঘ আইনি লড়াইয়ে তার খরচ হয়েছে ৫ লাখ পাউন্ডের বেশি। মানসিকভাবেও ভীষণ বিপর্যস্ত হয়ে পড়েছিলেন ৩৯ বছর বয়সী এই ব্যাটসম্যান। এমনকি আত্মহত্যার কথাও ভেবেছিলেন তিনি।২০২২ সালের আগস্টে দ্য হান্ড্রেডে ম্য&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A7%AA-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%86%E0%A6%AE%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A6%AC%E0%A6%9F%E0%A6%87-%E0%A6%93%E0%A6%B2%E0%A6%9F%E0%A6%AA%E0%A6%B2%E0%A6%9F-%E0%A6%B9%E0%A7%9F-%E0%A6%97%E0%A6%9B">Education Bangla</source>
    </item>
    <item>
      <title>‘কখনো কখনো ঘুমানোই কঠিন’ কোচিংয়ের চাপ নিয়ে জাভির স্বীকারোক্তি</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%95%E0%A6%96%E0%A6%A8-%E0%A6%95%E0%A6%96%E0%A6%A8-%E0%A6%98%E0%A6%AE%E0%A6%A8%E0%A6%87-%E0%A6%95%E0%A6%A0%E0%A6%A8-%E0%A6%95%E0%A6%9A%E0%A7%9F%E0%A6%B0-%E0%A6%9A%E0%A6%AA-%E0%A6%A8%E0%A7%9F-%E0%A6%9C%E0%A6%AD%E0%A6%B0-%E0%A6%B8%E0%A6%AC%E0%A6%95%E0%A6%B0%E0%A6%95%E0%A6%A4</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%95%E0%A6%96%E0%A6%A8-%E0%A6%95%E0%A6%96%E0%A6%A8-%E0%A6%98%E0%A6%AE%E0%A6%A8%E0%A6%87-%E0%A6%95%E0%A6%A0%E0%A6%A8-%E0%A6%95%E0%A6%9A%E0%A7%9F%E0%A6%B0-%E0%A6%9A%E0%A6%AA-%E0%A6%A8%E0%A7%9F-%E0%A6%9C%E0%A6%AD%E0%A6%B0-%E0%A6%B8%E0%A6%AC%E0%A6%95%E0%A6%B0%E0%A6%95%E0%A6%A4</guid>
      <pubDate>Tue, 10 Nov 2026 12:58:19 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794315499_rkr_6af314ebafc76.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794315499_rkr_6af314ebafc76.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794315499_rkr_6af314ebafc76.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘কখনো কখনো ঘুমানোই কঠিন’ কোচিংয়ের চাপ নিয়ে জাভির স্বীকারোক্তি" /&gt;&lt;/p&gt;&lt;p&gt;শীর্ষ পর্যায়ের ফুটবলে কোচিংয়ের চাপ কতটা কঠিন, তা নিয়ে খোলোমেলা কথা বললেন জাভি হার্নান্দেজ। বায়ার্ন মিউনিখ কোচ ভিনসেন্ট কোম্পানির সাম্প্রতিক অসুস্থতার খবরের পর তাকে দ্রুত সুস্থতা কামনা করেছেন নেদারল্যান্ডসের কোচ। সেই সঙ্গে স্বীকার করেছেন, কোচিংয়ের তীব্র চাপের কারণে কখনো কখনো ঘুমানোও কঠিন হয়ে পড়ে।দুই.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%95%E0%A6%96%E0%A6%A8-%E0%A6%95%E0%A6%96%E0%A6%A8-%E0%A6%98%E0%A6%AE%E0%A6%A8%E0%A6%87-%E0%A6%95%E0%A6%A0%E0%A6%A8-%E0%A6%95%E0%A6%9A%E0%A7%9F%E0%A6%B0-%E0%A6%9A%E0%A6%AA-%E0%A6%A8%E0%A7%9F-%E0%A6%9C%E0%A6%AD%E0%A6%B0-%E0%A6%B8%E0%A6%AC%E0%A6%95%E0%A6%B0%E0%A6%95%E0%A6%A4">Education Bangla</source>
    </item>

    <item>
      <title>পড়াশোনায় কেমন ছিলেন মেসি, ফাঁস হলো স্কুলের সেই নম্বরপত্র</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AA%E0%A7%9C%E0%A6%B6%E0%A6%A8%E0%A7%9F-%E0%A6%95%E0%A6%AE%E0%A6%A8-%E0%A6%9B%E0%A6%B2%E0%A6%A8-%E0%A6%AE%E0%A6%B8-%E0%A6%AB%E0%A6%B8-%E0%A6%B9%E0%A6%B2-%E0%A6%B8%E0%A6%95%E0%A6%B2%E0%A6%B0-%E0%A6%B8%E0%A6%87-%E0%A6%A8%E0%A6%AE%E0%A6%AC%E0%A6%B0%E0%A6%AA%E0%A6%A4%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AA%E0%A7%9C%E0%A6%B6%E0%A6%A8%E0%A7%9F-%E0%A6%95%E0%A6%AE%E0%A6%A8-%E0%A6%9B%E0%A6%B2%E0%A6%A8-%E0%A6%AE%E0%A6%B8-%E0%A6%AB%E0%A6%B8-%E0%A6%B9%E0%A6%B2-%E0%A6%B8%E0%A6%95%E0%A6%B2%E0%A6%B0-%E0%A6%B8%E0%A6%87-%E0%A6%A8%E0%A6%AE%E0%A6%AC%E0%A6%B0%E0%A6%AA%E0%A6%A4%E0%A6%B0</guid>
      <pubDate>Thu, 26 Nov 2026 16:14:07 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795709647_rkr_6b085acf85b32.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795709647_rkr_6b085acf85b32.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795709647_rkr_6b085acf85b32.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পড়াশোনায় কেমন ছিলেন মেসি, ফাঁস হলো স্কুলের সেই নম্বরপত্র" /&gt;&lt;/p&gt;&lt;p&gt;ফুটবল মাঠে তার পায়ের জাদুতে মুগ্ধ পুরো বিশ্ব। গোল, অ্যাসিস্ট আর একের পর এক রেকর্ডে নিজেকে নিয়ে গেছেন অনন্য উচ্চতায়। কিন্তু স্কুলজীবনে কেমন ছিলেন লিওনেল মেসি? পড়াশোনায় কতটা ভালো ছিলেন আর্জেন্টাইন এই কিংবদন্তি? সামাজিক যোগাযোগমাধ্যমে ছড়িয়ে পড়া তার পুরোনো একটি নম্বরপত্র সামনে এনেছে সেই প্রশ্নের উত্তর।১&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AA%E0%A7%9C%E0%A6%B6%E0%A6%A8%E0%A7%9F-%E0%A6%95%E0%A6%AE%E0%A6%A8-%E0%A6%9B%E0%A6%B2%E0%A6%A8-%E0%A6%AE%E0%A6%B8-%E0%A6%AB%E0%A6%B8-%E0%A6%B9%E0%A6%B2-%E0%A6%B8%E0%A6%95%E0%A6%B2%E0%A6%B0-%E0%A6%B8%E0%A6%87-%E0%A6%A8%E0%A6%AE%E0%A6%AC%E0%A6%B0%E0%A6%AA%E0%A6%A4%E0%A6%B0">Education Bangla</source>
    </item>
    <item>
      <title>হার্দিককে পেতে দুই তারকাকে ছাড়তে বলেছিল মুম্বাই, রাজি হয়নি রাজস্থান</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B9%E0%A6%B0%E0%A6%A6%E0%A6%95%E0%A6%95-%E0%A6%AA%E0%A6%A4-%E0%A6%A6%E0%A6%87-%E0%A6%A4%E0%A6%B0%E0%A6%95%E0%A6%95-%E0%A6%9B%E0%A7%9C%E0%A6%A4-%E0%A6%AC%E0%A6%B2%E0%A6%9B%E0%A6%B2-%E0%A6%AE%E0%A6%AE%E0%A6%AC%E0%A6%87-%E0%A6%B0%E0%A6%9C-%E0%A6%B9%E0%A7%9F%E0%A6%A8-%E0%A6%B0%E0%A6%9C%E0%A6%B8%E0%A6%A5%E0%A6%A8</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%B9%E0%A6%B0%E0%A6%A6%E0%A6%95%E0%A6%95-%E0%A6%AA%E0%A6%A4-%E0%A6%A6%E0%A6%87-%E0%A6%A4%E0%A6%B0%E0%A6%95%E0%A6%95-%E0%A6%9B%E0%A7%9C%E0%A6%A4-%E0%A6%AC%E0%A6%B2%E0%A6%9B%E0%A6%B2-%E0%A6%AE%E0%A6%AE%E0%A6%AC%E0%A6%87-%E0%A6%B0%E0%A6%9C-%E0%A6%B9%E0%A7%9F%E0%A6%A8-%E0%A6%B0%E0%A6%9C%E0%A6%B8%E0%A6%A5%E0%A6%A8</guid>

      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%B0%E0%A6%9C%E0%A6%B2-%E0%A6%8F%E0%A6%A8%E0%A6%A6%E0%A6%B0%E0%A6%95%E0%A6%95-%E0%A6%B8%E0%A6%AF%E0%A6%97-%E0%A6%A6%E0%A6%B2-%E0%A6%86%E0%A6%A8%E0%A6%9A%E0%A6%B2%E0%A6%A4%E0%A6%A4%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%A4-%E0%A6%95%E0%A6%A4%E0%A6%9C%E0%A6%9E-%E0%A6%A5%E0%A6%95%E0%A6%AC%E0%A6%A8-%E0%A6%AE%E0%A6%B0%E0%A6%A8%E0%A6%B9</guid>

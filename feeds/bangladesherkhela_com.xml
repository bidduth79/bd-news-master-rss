    <item>
      <title>নতুন দল চাঁদপুরে ঋতুপর্ণা, ফিরছেন সাবিনা-কৃষ্ণারাও</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%A8%E0%A6%A4%E0%A6%A8-%E0%A6%A6%E0%A6%B2-%E0%A6%9A%E0%A6%A6%E0%A6%AA%E0%A6%B0-%E0%A6%8B%E0%A6%A4%E0%A6%AA%E0%A6%B0%E0%A6%A3-%E0%A6%AB%E0%A6%B0%E0%A6%9B%E0%A6%A8-%E0%A6%B8%E0%A6%AC%E0%A6%A8-%E0%A6%95%E0%A6%B7%E0%A6%A3%E0%A6%B0%E0%A6%93</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%A8%E0%A6%A4%E0%A6%A8-%E0%A6%A6%E0%A6%B2-%E0%A6%9A%E0%A6%A6%E0%A6%AA%E0%A6%B0-%E0%A6%8B%E0%A6%A4%E0%A6%AA%E0%A6%B0%E0%A6%A3-%E0%A6%AB%E0%A6%B0%E0%A6%9B%E0%A6%A8-%E0%A6%B8%E0%A6%AC%E0%A6%A8-%E0%A6%95%E0%A6%B7%E0%A6%A3%E0%A6%B0%E0%A6%93</guid>
      <pubDate>Mon, 23 Nov 2026 16:26:13 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795451173_rkr_6b046925a0c52.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795451173_rkr_6b046925a0c52.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795451173_rkr_6b046925a0c52.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নতুন দল চাঁদপুরে ঋতুপর্ণা, ফিরছেন সাবিনা-কৃষ্ণারাও" /&gt;&lt;/p&gt;&lt;p&gt;আগামী মাসের শেষ দিকে নারী ফুটবল লিগ শুরু হওয়ার কথা। কোন দলগুলো লিগে অংশগ্রহণ করবে এখনো আনুষ্ঠানিকভাবে জানায়নি ফুটবল ফেডারেশন। তবে নতুন দলগুলো অনুমোদন পাওয়ার আগেই তারকা ফুটবলারদের সঙ্গে চুক্তি করছে।নারী ফুটবলে সবচেয়ে বড় তারকা ঋতুপর্ণা চাকমা। তিনি এবার চাঁদপুর স্পোর্টিং ক্লাবের হয়ে খেলবেন বলে নিশ্চিত.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%A8%E0%A6%A4%E0%A6%A8-%E0%A6%A6%E0%A6%B2-%E0%A6%9A%E0%A6%A6%E0%A6%AA%E0%A6%B0-%E0%A6%8B%E0%A6%A4%E0%A6%AA%E0%A6%B0%E0%A6%A3-%E0%A6%AB%E0%A6%B0%E0%A6%9B%E0%A6%A8-%E0%A6%B8%E0%A6%AC%E0%A6%A8-%E0%A6%95%E0%A6%B7%E0%A6%A3%E0%A6%B0%E0%A6%93">Education Bangla</source>
    </item>
    <item>
      <title>ইতিহাসের দীর্ঘতম অ্যাওয়ে সফরে বার্সেলোনা</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%87%E0%A6%A4%E0%A6%B9%E0%A6%B8%E0%A6%B0-%E0%A6%A6%E0%A6%B0%E0%A6%98%E0%A6%A4%E0%A6%AE-%E0%A6%85%E0%A6%AF%E0%A6%93%E0%A6%AF-%E0%A6%B8%E0%A6%AB%E0%A6%B0-%E0%A6%AC%E0%A6%B0%E0%A6%B8%E0%A6%B2%E0%A6%A8</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%87%E0%A6%A4%E0%A6%B9%E0%A6%B8%E0%A6%B0-%E0%A6%A6%E0%A6%B0%E0%A6%98%E0%A6%A4%E0%A6%AE-%E0%A6%85%E0%A6%AF%E0%A6%93%E0%A6%AF-%E0%A6%B8%E0%A6%AB%E0%A6%B0-%E0%A6%AC%E0%A6%B0%E0%A6%B8%E0%A6%B2%E0%A6%A8</guid>
      <pubDate>Mon, 23 Nov 2026 16:08:12 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795450092_rkr_6b0464ec14761.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795450092_rkr_6b0464ec14761.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795450092_rkr_6b0464ec14761.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইতিহাসের দীর্ঘতম অ্যাওয়ে সফরে বার্সেলোনা" /&gt;&lt;/p&gt;&lt;p&gt;ইউরোপীয় প্রতিযোগিতার ইতিহাসে নিজেদের সবচেয়ে দীর্ঘতম অ্যাওয়ে সফর করতে যাচ্ছে স্প্যানিশ ক্লাব বার্সেলোনা। উয়েফা চ্যাম্পিয়নস লিগের পঞ্চম রাউন্ডের ম্যাচে আজারবাইজানের ক্লাব সাবাহর মুখোমুখি হতে কাতালানদের পাড়ি দিতে হবে ৩,৯৭০ কিলোমিটার পথ। আগামী বুধবার (২৫ নভেম্বর) বাকু অলিম্পিক স্টেডিয়ামে বাংলাদেশ সময় র&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%87%E0%A6%A4%E0%A6%B9%E0%A6%B8%E0%A6%B0-%E0%A6%A6%E0%A6%B0%E0%A6%98%E0%A6%A4%E0%A6%AE-%E0%A6%85%E0%A6%AF%E0%A6%93%E0%A6%AF-%E0%A6%B8%E0%A6%AB%E0%A6%B0-%E0%A6%AC%E0%A6%B0%E0%A6%B8%E0%A6%B2%E0%A6%A8">Education Bangla</source>
    </item>
    <item>
      <title>মার্করামকে ফিরিয়ে প্রথম ব্রেক থ্রু এনে দিলেন ইবাদত</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%B0%E0%A6%95%E0%A6%B0%E0%A6%AE%E0%A6%95-%E0%A6%AB%E0%A6%B0%E0%A7%9F-%E0%A6%AA%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%AC%E0%A6%B0%E0%A6%95-%E0%A6%A5%E0%A6%B0-%E0%A6%8F%E0%A6%A8-%E0%A6%A6%E0%A6%B2%E0%A6%A8-%E0%A6%87%E0%A6%AC%E0%A6%A6%E0%A6%A4</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%B0%E0%A6%95%E0%A6%B0%E0%A6%AE%E0%A6%95-%E0%A6%AB%E0%A6%B0%E0%A7%9F-%E0%A6%AA%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%AC%E0%A6%B0%E0%A6%95-%E0%A6%A5%E0%A6%B0-%E0%A6%8F%E0%A6%A8-%E0%A6%A6%E0%A6%B2%E0%A6%A8-%E0%A6%87%E0%A6%AC%E0%A6%A6%E0%A6%A4</guid>
      <pubDate>Mon, 23 Nov 2026 16:06:57 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795450017_rkr_6b0464a1ef11d.JPG" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795450017_rkr_6b0464a1ef11d.JPG" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795450017_rkr_6b0464a1ef11d.JPG" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মার্করামকে ফিরিয়ে প্রথম ব্রেক থ্রু এনে দিলেন ইবাদত" /&gt;&lt;/p&gt;&lt;p&gt;দশম ওভারের প্রথম বলে ভাঙল দক্ষিণ আফ্রিকার ওপেনিং জুটি। ইবাদত হোসেনের খাটো লেংথের বল পুল করতে গিয়ে উইকেটের পেছনে লিটন দাসের হাতে ক্যাচ দেন এইডেন মার্করাম (২১)। অ্যাকারম্যানের সঙ্গে উদ্বোধনী জুটিতে এসেছে ৪৯ রান। নতুন ব্যাটার হিসেবে ক্রিজে এসেছেন জুবায়ের হামজা। &amp;amp;nbsp;দক্ষিণ আফ্রিকা ১ম ইনিংস: ৯.১ ওভ&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%B0%E0%A6%95%E0%A6%B0%E0%A6%AE%E0%A6%95-%E0%A6%AB%E0%A6%B0%E0%A7%9F-%E0%A6%AA%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%AC%E0%A6%B0%E0%A6%95-%E0%A6%A5%E0%A6%B0-%E0%A6%8F%E0%A6%A8-%E0%A6%A6%E0%A6%B2%E0%A6%A8-%E0%A6%87%E0%A6%AC%E0%A6%A6%E0%A6%A4">Education Bangla</source>
    </item>
    <item>
      <title>ভারত সফরে ৩৬ অ্যাথলেটের সঙ্গে ২০ কর্মকর্তা!</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AD%E0%A6%B0%E0%A6%A4-%E0%A6%B8%E0%A6%AB%E0%A6%B0-%E0%A7%A9%E0%A7%AC-%E0%A6%85%E0%A6%AF%E0%A6%A5%E0%A6%B2%E0%A6%9F%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A6%97-%E0%A7%A8%E0%A7%A6-%E0%A6%95%E0%A6%B0%E0%A6%AE%E0%A6%95%E0%A6%B0%E0%A6%A4</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AD%E0%A6%B0%E0%A6%A4-%E0%A6%B8%E0%A6%AB%E0%A6%B0-%E0%A7%A9%E0%A7%AC-%E0%A6%85%E0%A6%AF%E0%A6%A5%E0%A6%B2%E0%A6%9F%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A6%97-%E0%A7%A8%E0%A7%A6-%E0%A6%95%E0%A6%B0%E0%A6%AE%E0%A6%95%E0%A6%B0%E0%A6%A4</guid>
      <pubDate>Mon, 23 Nov 2026 15:57:23 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795449443_rkr_6b046263c8455.png" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795449443_rkr_6b046263c8455.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795449443_rkr_6b046263c8455.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভারত সফরে ৩৬ অ্যাথলেটের সঙ্গে ২০ কর্মকর্তা!" /&gt;&lt;/p&gt;&lt;p&gt;প্রতিযোগিতায় অংশ নেবেন ৩৬ জন অ্যাথলেট। তাদের সঙ্গে ভারত সফরে যাচ্ছেন কর্মকর্তা, কোচ ও পর্যবেক্ষক মিলিয়ে আরও ২০ জন। অর্থাৎ খেলোয়াড়ের তুলনায় কর্মকর্তা, কোচ ও পর্যবেক্ষকের সংখ্যা অর্ধেকেরও বেশি।আন্তর্জাতিক প্রতিযোগিতায় অংশ নিতে বাংলাদেশ দলের এমন বিশাল বহর নিয়ে প্রশ্ন উঠেছে ক্রীড়াঙ্গনে। বিশেষ করে পাঁচজন&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AD%E0%A6%B0%E0%A6%A4-%E0%A6%B8%E0%A6%AB%E0%A6%B0-%E0%A7%A9%E0%A7%AC-%E0%A6%85%E0%A6%AF%E0%A6%A5%E0%A6%B2%E0%A6%9F%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A6%97-%E0%A7%A8%E0%A7%A6-%E0%A6%95%E0%A6%B0%E0%A6%AE%E0%A6%95%E0%A6%B0%E0%A6%A4">Education Bangla</source>
    </item>
    <item>
      <title>ফর্টিস এফসি ছাড়ছেন শুকি ইতোফুসা</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AB%E0%A6%B0%E0%A6%9F%E0%A6%B8-%E0%A6%8F%E0%A6%AB%E0%A6%B8-%E0%A6%9B%E0%A7%9C%E0%A6%9B%E0%A6%A8-%E0%A6%B6%E0%A6%95-%E0%A6%87%E0%A6%A4%E0%A6%AB%E0%A6%B8</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AB%E0%A6%B0%E0%A6%9F%E0%A6%B8-%E0%A6%8F%E0%A6%AB%E0%A6%B8-%E0%A6%9B%E0%A7%9C%E0%A6%9B%E0%A6%A8-%E0%A6%B6%E0%A6%95-%E0%A6%87%E0%A6%A4%E0%A6%AB%E0%A6%B8</guid>
      <pubDate>Mon, 23 Nov 2026 15:56:15 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795449375_rkr_6b04621f43c55.png" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795449375_rkr_6b04621f43c55.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795449375_rkr_6b04621f43c55.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফর্টিস এফসি ছাড়ছেন শুকি ইতোফুসা" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ ফুটবল লিগের ক্লাব ফর্টিস এফসি ছাড়তে যাচ্ছেন বাংলাদেশি বংশোদ্ভূত জাপানি ফুটবলার শুকি ইতোফুসা। চলতি বছরই ক্লাবটিতে যোগ দেওয়া এই লেফট উইঙ্গার ইতোমধ্যে নিজের নৈপুণ্যে নজর কেড়েছেন। জায়গা করে নিয়েছেন বাংলাদেশ জাতীয় দলেও। তবে ভালো প্রস্তাব পেয়ে ফর্টিসের সঙ্গে সম্পর্ক ছিন্ন করতে যাচ্ছেন তিনি।ফর্টিস&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AB%E0%A6%B0%E0%A6%9F%E0%A6%B8-%E0%A6%8F%E0%A6%AB%E0%A6%B8-%E0%A6%9B%E0%A7%9C%E0%A6%9B%E0%A6%A8-%E0%A6%B6%E0%A6%95-%E0%A6%87%E0%A6%A4%E0%A6%AB%E0%A6%B8">Education Bangla</source>
    </item>
    <item>
      <title>শ্রীলঙ্কার কাছে পাত্তাই পেল না সাইফ-সাব্বিররা</title>

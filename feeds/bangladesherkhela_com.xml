    </item>
    <item>
      <title>এমবাপ্পে-ইয়ামালের নাম উঠল বিব্রতকর রেকর্ডে</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%8F%E0%A6%AE%E0%A6%AC%E0%A6%AA%E0%A6%AA-%E0%A6%87%E0%A7%9F%E0%A6%AE%E0%A6%B2%E0%A6%B0-%E0%A6%A8%E0%A6%AE-%E0%A6%89%E0%A6%A0%E0%A6%B2-%E0%A6%AC%E0%A6%AC%E0%A6%B0%E0%A6%A4%E0%A6%95%E0%A6%B0-%E0%A6%B0%E0%A6%95%E0%A6%B0%E0%A6%A1</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%8F%E0%A6%AE%E0%A6%AC%E0%A6%AA%E0%A6%AA-%E0%A6%87%E0%A7%9F%E0%A6%AE%E0%A6%B2%E0%A6%B0-%E0%A6%A8%E0%A6%AE-%E0%A6%89%E0%A6%A0%E0%A6%B2-%E0%A6%AC%E0%A6%AC%E0%A6%B0%E0%A6%A4%E0%A6%95%E0%A6%B0-%E0%A6%B0%E0%A6%95%E0%A6%B0%E0%A6%A1</guid>
      <pubDate>Mon, 23 Nov 2026 15:39:48 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795448388_rkr_6b045e442b81b.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795448388_rkr_6b045e442b81b.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795448388_rkr_6b045e442b81b.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এমবাপ্পে-ইয়ামালের নাম উঠল বিব্রতকর রেকর্ডে" /&gt;&lt;/p&gt;&lt;p&gt;লা লিগার ১৩তম রাউন্ডে স্প্যানিশ ফুটবলের দুই পরাশক্তি রিয়াল মাদ্রিদ ও বার্সেলোনা জয় দিয়ে সপ্তাহান্ত শেষ করলেও আলোচনায় দুই তারকা ফরোয়ার্ড কিলিয়ান এমবাপ্পে ও লামিন ইয়ামালের স্পটকিক ব্যর্থতা। দুজনই পেনাল্টি থেকে গোল করতে ব্যর্থ হওয়ায় ম্যাচে চাপে পড়েছিল, যদিও শেষ পর্যন্ত জয়ের হাসি হাসতে পেরেছে দুই ক্লাবই&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%8F%E0%A6%AE%E0%A6%AC%E0%A6%AA%E0%A6%AA-%E0%A6%87%E0%A7%9F%E0%A6%AE%E0%A6%B2%E0%A6%B0-%E0%A6%A8%E0%A6%AE-%E0%A6%89%E0%A6%A0%E0%A6%B2-%E0%A6%AC%E0%A6%AC%E0%A6%B0%E0%A6%A4%E0%A6%95%E0%A6%B0-%E0%A6%B0%E0%A6%95%E0%A6%B0%E0%A6%A1">Education Bangla</source>
    </item>
    <item>
      <title>সারার সঙ্গে রাজবীরের বিয়ের গুঞ্জন, অবশেষে জানা গেল সত্য</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%B0%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A6%97-%E0%A6%B0%E0%A6%9C%E0%A6%AC%E0%A6%B0%E0%A6%B0-%E0%A6%AC%E0%A7%9F%E0%A6%B0-%E0%A6%97%E0%A6%9E%E0%A6%9C%E0%A6%A8-%E0%A6%85%E0%A6%AC%E0%A6%B6%E0%A6%B7-%E0%A6%9C%E0%A6%A8-%E0%A6%97%E0%A6%B2-%E0%A6%B8%E0%A6%A4%E0%A6%AF</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%B0%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A6%97-%E0%A6%B0%E0%A6%9C%E0%A6%AC%E0%A6%B0%E0%A6%B0-%E0%A6%AC%E0%A7%9F%E0%A6%B0-%E0%A6%97%E0%A6%9E%E0%A6%9C%E0%A6%A8-%E0%A6%85%E0%A6%AC%E0%A6%B6%E0%A6%B7-%E0%A6%9C%E0%A6%A8-%E0%A6%97%E0%A6%B2-%E0%A6%B8%E0%A6%A4%E0%A6%AF</guid>
      <pubDate>Mon, 23 Nov 2026 15:38:45 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795448325_rkr_6b045e05121e9.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795448325_rkr_6b045e05121e9.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795448325_rkr_6b045e05121e9.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সারার সঙ্গে রাজবীরের বিয়ের গুঞ্জন, অবশেষে জানা গেল সত্য" /&gt;&lt;/p&gt;&lt;p&gt;সামাজিক যোগাযোগমাধ্যমে বেশ কিছুদিন ধরেই ছড়িয়ে পড়েছে ক্রিকেট কিংবদন্তি শচীন টেন্ডুলকারের মেয়ে সারা টেন্ডুলকারের সঙ্গে বলিউড অভিনেতা সানি দেওলের ছেলে রাজবীর দেওলের বিয়ের গুঞ্জন। এমনকি দুজনের বিয়ে নিয়ে নানা ধরনের আলোচনা চলছে নেটদুনিয়ায়। তবে এই গুঞ্জনের কোনো সত্যতা নেই বলে জানিয়েছেন সারার ঘনিষ্ঠ একটি সূ&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%B0%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A6%97-%E0%A6%B0%E0%A6%9C%E0%A6%AC%E0%A6%B0%E0%A6%B0-%E0%A6%AC%E0%A7%9F%E0%A6%B0-%E0%A6%97%E0%A6%9E%E0%A6%9C%E0%A6%A8-%E0%A6%85%E0%A6%AC%E0%A6%B6%E0%A6%B7-%E0%A6%9C%E0%A6%A8-%E0%A6%97%E0%A6%B2-%E0%A6%B8%E0%A6%A4%E0%A6%AF">Education Bangla</source>
    </item>
    <item>
      <title>মরিনিওর চাওয়ায় এনমেচাকে টার্গেট রিয়ালের</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%B0%E0%A6%A8%E0%A6%93%E0%A6%B0-%E0%A6%9A%E0%A6%93%E0%A7%9F%E0%A7%9F-%E0%A6%8F%E0%A6%A8%E0%A6%AE%E0%A6%9A%E0%A6%95-%E0%A6%9F%E0%A6%B0%E0%A6%97%E0%A6%9F-%E0%A6%B0%E0%A7%9F%E0%A6%B2%E0%A6%B0-1</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%B0%E0%A6%A8%E0%A6%93%E0%A6%B0-%E0%A6%9A%E0%A6%93%E0%A7%9F%E0%A7%9F-%E0%A6%8F%E0%A6%A8%E0%A6%AE%E0%A6%9A%E0%A6%95-%E0%A6%9F%E0%A6%B0%E0%A6%97%E0%A6%9F-%E0%A6%B0%E0%A7%9F%E0%A6%B2%E0%A6%B0-1</guid>
      <pubDate>Mon, 23 Nov 2026 15:37:38 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795448258_rkr_6b045dc261f5e.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795448258_rkr_6b045dc261f5e.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795448258_rkr_6b045dc261f5e.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মরিনিওর চাওয়ায় এনমেচাকে টার্গেট রিয়ালের" /&gt;&lt;/p&gt;&lt;p&gt;মাঝমাঠের শারীরিক শক্তি ও গতিশীলতা বাড়াতে বরুশিয়া ডর্টমুন্ডের জার্মান মিডফিল্ডার ফেলিক্স এনমেচাকে দলে ভেড়ানোর পরিকল্পনা করছে রিয়াল মাদ্রিদ। কোচ হোসে মরিনিওর বিশেষ আগ্রহের কারণেই আগামী মৌসুমে ২৬ বছর বয়সী এই ফুটবলারকে দলে টানার ছক কষছে স্প্যানিশ ক্লাবটি।গোল ডট কমের প্রতিবেদন অনুযায়ী, এনমেচার মধ্যে এমন.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%B0%E0%A6%A8%E0%A6%93%E0%A6%B0-%E0%A6%9A%E0%A6%93%E0%A7%9F%E0%A7%9F-%E0%A6%8F%E0%A6%A8%E0%A6%AE%E0%A6%9A%E0%A6%95-%E0%A6%9F%E0%A6%B0%E0%A6%97%E0%A6%9F-%E0%A6%B0%E0%A7%9F%E0%A6%B2%E0%A6%B0-1">Education Bangla</source>
    </item>
    <item>
      <title>সেঞ্চুরিয়ানের বাউন্সে চার পেসারের সূর্যোদয়</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%9E%E0%A6%9A%E0%A6%B0%E0%A7%9F%E0%A6%A8%E0%A6%B0-%E0%A6%AC%E0%A6%89%E0%A6%A8%E0%A6%B8-%E0%A6%9A%E0%A6%B0-%E0%A6%AA%E0%A6%B8%E0%A6%B0%E0%A6%B0-%E0%A6%B8%E0%A6%B0%E0%A6%AF%E0%A6%A6%E0%A7%9F</link>

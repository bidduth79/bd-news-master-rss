    <item>
      <title>মোহামেডান-আবাহনী দুই দলের হয়েই খেললেন ক্রীড়া প্রতিমন্ত্রী আমিনুল</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%B9%E0%A6%AE%E0%A6%A1%E0%A6%A8-%E0%A6%86%E0%A6%AC%E0%A6%B9%E0%A6%A8-%E0%A6%A6%E0%A6%87-%E0%A6%A6%E0%A6%B2%E0%A6%B0-%E0%A6%B9%E0%A6%AF%E0%A6%87-%E0%A6%96%E0%A6%B2%E0%A6%B2%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A6%A1-%E0%A6%AA%E0%A6%B0%E0%A6%A4%E0%A6%AE%E0%A6%A8%E0%A6%A4%E0%A6%B0-%E0%A6%86%E0%A6%AE%E0%A6%A8%E0%A6%B2</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%B9%E0%A6%AE%E0%A6%A1%E0%A6%A8-%E0%A6%86%E0%A6%AC%E0%A6%B9%E0%A6%A8-%E0%A6%A6%E0%A6%87-%E0%A6%A6%E0%A6%B2%E0%A6%B0-%E0%A6%B9%E0%A6%AF%E0%A6%87-%E0%A6%96%E0%A6%B2%E0%A6%B2%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A6%A1-%E0%A6%AA%E0%A6%B0%E0%A6%A4%E0%A6%AE%E0%A6%A8%E0%A6%A4%E0%A6%B0-%E0%A6%86%E0%A6%AE%E0%A6%A8%E0%A6%B2</guid>
      <pubDate>Thu, 19 Nov 2026 14:32:16 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795098736_rkr_6aff08700981e.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795098736_rkr_6aff08700981e.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795098736_rkr_6aff08700981e.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মোহামেডান-আবাহনী দুই দলের হয়েই খেললেন ক্রীড়া প্রতিমন্ত্রী আমিনুল" /&gt;&lt;/p&gt;&lt;p&gt;এক সময় মাঠে নামলেই গ্যালারিতে উত্তেজনার ঝড় উঠতো। মোহামেডান-আবাহনী মানেই ছিল অন্যরকম উন্মাদনা, অন্যরকম আবেগ। দুই দলের সমর্থকদের মধ্যে প্রতিদ্বন্দ্বিতা থাকলেও ফুটবলারদের কাছে দুই ক্লাবই ছিল ভালোবাসা ও গর্বের জায়গা। সময়ের পরিক্রমায় সেই উত্তাপ অনেকটাই কমেছে। কিন্তু স্মৃতির পাতায় এখনো অমলিন দুই চির&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%B9%E0%A6%AE%E0%A6%A1%E0%A6%A8-%E0%A6%86%E0%A6%AC%E0%A6%B9%E0%A6%A8-%E0%A6%A6%E0%A6%87-%E0%A6%A6%E0%A6%B2%E0%A6%B0-%E0%A6%B9%E0%A6%AF%E0%A6%87-%E0%A6%96%E0%A6%B2%E0%A6%B2%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A6%A1-%E0%A6%AA%E0%A6%B0%E0%A6%A4%E0%A6%AE%E0%A6%A8%E0%A6%A4%E0%A6%B0-%E0%A6%86%E0%A6%AE%E0%A6%A8%E0%A6%B2">Education Bangla</source>
    </item>
    <item>
      <title>‘মাথায় রাখতে হবে, কাকে কার সঙ্গে তুলনা করছেন’</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%A5%E0%A7%9F-%E0%A6%B0%E0%A6%96%E0%A6%A4-%E0%A6%B9%E0%A6%AC-%E0%A6%95%E0%A6%95-%E0%A6%95%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A6%97-%E0%A6%A4%E0%A6%B2%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A6%9B%E0%A6%A8</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%A5%E0%A7%9F-%E0%A6%B0%E0%A6%96%E0%A6%A4-%E0%A6%B9%E0%A6%AC-%E0%A6%95%E0%A6%95-%E0%A6%95%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A6%97-%E0%A6%A4%E0%A6%B2%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A6%9B%E0%A6%A8</guid>
      <pubDate>Thu, 19 Nov 2026 14:29:06 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795098546_rkr_6aff07b2d7d34.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795098546_rkr_6aff07b2d7d34.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795098546_rkr_6aff07b2d7d34.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘মাথায় রাখতে হবে, কাকে কার সঙ্গে তুলনা করছেন’" /&gt;&lt;/p&gt;&lt;p&gt;দুই অভিজ্ঞ ব্যাটার মুশফিকুর রহিম ও মুমিনুল হক সাদা পোশাকে রান খরায় ভুগছেন সাম্প্রতিক সময়ে। শেষ ১১ ইনিংসে কোনো ফিফটি নেই মুমিনুলের আর মুশফিকের শেষ ১২ ইনিংসে মাত্র ১টি ফিফটি। দক্ষিণ আফ্রিকার বিপক্ষে সেঞ্চুরিয়ন টেস্টের দুই ইনিংসেই দুজনই ব্যর্থ হয়েছেন।এর আগেও দক্ষিণ আফ্রিকার মাটিতে রান করতে পারেননি তারা&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%A5%E0%A7%9F-%E0%A6%B0%E0%A6%96%E0%A6%A4-%E0%A6%B9%E0%A6%AC-%E0%A6%95%E0%A6%95-%E0%A6%95%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A6%97-%E0%A6%A4%E0%A6%B2%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A6%9B%E0%A6%A8">Education Bangla</source>
    </item>
    <item>
      <title>শরিফুলকে না খেলানোর যে ব্যাখ্যা দিলেন শান্ত</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B6%E0%A6%B0%E0%A6%AB%E0%A6%B2%E0%A6%95-%E0%A6%A8-%E0%A6%96%E0%A6%B2%E0%A6%A8%E0%A6%B0-%E0%A6%AF-%E0%A6%AC%E0%A6%AF%E0%A6%96%E0%A6%AF-%E0%A6%A6%E0%A6%B2%E0%A6%A8-%E0%A6%B6%E0%A6%A8%E0%A6%A4</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%B6%E0%A6%B0%E0%A6%AB%E0%A6%B2%E0%A6%95-%E0%A6%A8-%E0%A6%96%E0%A6%B2%E0%A6%A8%E0%A6%B0-%E0%A6%AF-%E0%A6%AC%E0%A6%AF%E0%A6%96%E0%A6%AF-%E0%A6%A6%E0%A6%B2%E0%A6%A8-%E0%A6%B6%E0%A6%A8%E0%A6%A4</guid>
      <pubDate>Thu, 19 Nov 2026 14:27:13 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795098433_rkr_6aff0741e4d80.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795098433_rkr_6aff0741e4d80.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795098433_rkr_6aff0741e4d80.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শরিফুলকে না খেলানোর যে ব্যাখ্যা দিলেন শান্ত" /&gt;&lt;/p&gt;&lt;p&gt;দক্ষিণ আফ্রিকার বিপক্ষে প্রথম টেস্টের একাদশে ছিলেন না শরিফুল ইসলাম। পুরো ম্যাচ জুড়ে তার অভাব নিয়ে আলোচনা হয়েছে। স্বাগতিক ধারাভাষ্যকাররাও শরিফুলকে একাদশে না দেখে বিস্ময় প্রকাশ করেছেন।&amp;amp;nbsp;বিশেষ করে তিন ডানহাতি পেসার নিয়ে মাঠে নামা এবং এবাদত হোসেনের কার্যকারিতা নিয়ে প্রশ্ন উঠেছে। তবে অধিনায়ক নাজম&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B6%E0%A6%B0%E0%A6%AB%E0%A6%B2%E0%A6%95-%E0%A6%A8-%E0%A6%96%E0%A6%B2%E0%A6%A8%E0%A6%B0-%E0%A6%AF-%E0%A6%AC%E0%A6%AF%E0%A6%96%E0%A6%AF-%E0%A6%A6%E0%A6%B2%E0%A6%A8-%E0%A6%B6%E0%A6%A8%E0%A6%A4">Education Bangla</source>
    </item>
    <item>
      <title>ভবিষ্যতের ‘ফ্যাব ফোর’ কারা? পাঁচজনের নাম বললেন উইলিয়ামসন</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AD%E0%A6%AC%E0%A6%B7%E0%A6%AF%E0%A6%A4%E0%A6%B0-%E0%A6%AB%E0%A6%AF%E0%A6%AC-%E0%A6%AB%E0%A6%B0-%E0%A6%95%E0%A6%B0-%E0%A6%AA%E0%A6%9A%E0%A6%9C%E0%A6%A8%E0%A6%B0-%E0%A6%A8%E0%A6%AE-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A6%A8-%E0%A6%89%E0%A6%87%E0%A6%B2%E0%A7%9F%E0%A6%AE%E0%A6%B8%E0%A6%A8</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AD%E0%A6%AC%E0%A6%B7%E0%A6%AF%E0%A6%A4%E0%A6%B0-%E0%A6%AB%E0%A6%AF%E0%A6%AC-%E0%A6%AB%E0%A6%B0-%E0%A6%95%E0%A6%B0-%E0%A6%AA%E0%A6%9A%E0%A6%9C%E0%A6%A8%E0%A6%B0-%E0%A6%A8%E0%A6%AE-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A6%A8-%E0%A6%89%E0%A6%87%E0%A6%B2%E0%A7%9F%E0%A6%AE%E0%A6%B8%E0%A6%A8</guid>
      <pubDate>Thu, 19 Nov 2026 14:24:33 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795098273_rkr_6aff06a1b3b52.JPG" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795098273_rkr_6aff06a1b3b52.JPG" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795098273_rkr_6aff06a1b3b52.JPG" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভবিষ্যতের ‘ফ্যাব ফোর’ কারা? পাঁচজনের নাম বললেন উইলিয়ামসন" /&gt;&lt;/p&gt;&lt;p&gt;টেস্ট ক্রিকেটের ‘ফ্যাব ফোর’ হিসেবে পরিচিত বিরাট কোহলি, স্টিভ স্মিথ, জো রুট ও কেন উইলিয়ামসনের যুগ ধীরে ধীরে শেষের দিকে। গত দেড় দশকের বেশি সময় তাদের ব্যাটিংয়ের আধিপত্যে সমৃদ্ধ হয়েছে সাদা পোশাকের ক্রিকেট। এবার স্বাভাবিকভাবেই আলোচনায় উঠে আসছে পরবর্তী প্রজন্মের সেরা ব্যাটারদের নাম। ভবিষ্যতে কারা গড়ে তুলত&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AD%E0%A6%AC%E0%A6%B7%E0%A6%AF%E0%A6%A4%E0%A6%B0-%E0%A6%AB%E0%A6%AF%E0%A6%AC-%E0%A6%AB%E0%A6%B0-%E0%A6%95%E0%A6%B0-%E0%A6%AA%E0%A6%9A%E0%A6%9C%E0%A6%A8%E0%A6%B0-%E0%A6%A8%E0%A6%AE-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A6%A8-%E0%A6%89%E0%A6%87%E0%A6%B2%E0%A7%9F%E0%A6%AE%E0%A6%B8%E0%A6%A8">Education Bangla</source>
    </item>
    <item>
      <title>উদ্বোধনী ম্যাচে হংকংকে উড়িয়ে দিল বাংলাদেশ</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%89%E0%A6%A6%E0%A6%AC%E0%A6%A7%E0%A6%A8-%E0%A6%AE%E0%A6%AF%E0%A6%9A-%E0%A6%B9%E0%A6%95%E0%A6%95-%E0%A6%89%E0%A7%9C%E0%A7%9F-%E0%A6%A6%E0%A6%B2-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%89%E0%A6%A6%E0%A6%AC%E0%A6%A7%E0%A6%A8-%E0%A6%AE%E0%A6%AF%E0%A6%9A-%E0%A6%B9%E0%A6%95%E0%A6%95-%E0%A6%89%E0%A7%9C%E0%A7%9F-%E0%A6%A6%E0%A6%B2-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6</guid>
      <pubDate>Thu, 19 Nov 2026 14:23:20 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795098200_rkr_6aff0658e2b03.JPG" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795098200_rkr_6aff0658e2b03.JPG" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795098200_rkr_6aff0658e2b03.JPG" style="max-width:100%;height:auto;margin-bottom:10px;" alt="উদ্বোধনী ম্যাচে হংকংকে উড়িয়ে দিল বাংলাদেশ" /&gt;&lt;/p&gt;&lt;p&gt;দাপুটে এক জয় দিয়ে এশিয়া কাপ রাইজিং স্টার্স টুর্নামেন্ট শুরু করেছে বাংলাদেশ ‘এ’ দল। কাতারের দোয়ায় এবারের আসরের উদ্বোধনী ম্যাচে হংকংকে রীতিমত উড়িয়ে দিয়েছে সাইফ হাসানের নেতৃত্বাধীন দল। হংকংয়ের দেয়া ২২০ রানের লক্ষ্য ৫৪ বল ও ৮ উইকেট হাতে রেখেই টপকে গেছে টাইগাররা। এর আগে নির্ধারিত ৫০ ওভারে ৮ উইকেটে ২১৯ রা&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%89%E0%A6%A6%E0%A6%AC%E0%A6%A7%E0%A6%A8-%E0%A6%AE%E0%A6%AF%E0%A6%9A-%E0%A6%B9%E0%A6%95%E0%A6%95-%E0%A6%89%E0%A7%9C%E0%A7%9F-%E0%A6%A6%E0%A6%B2-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6">Education Bangla</source>
    </item>
    <item>
      <title>জোহানেসবার্গ টেস্ট • ৯ উইকেটে জিতে সিরিজে এগিয়ে গেল দক্ষিণ আফ্রিকা</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%9C%E0%A6%B9%E0%A6%A8%E0%A6%B8%E0%A6%AC%E0%A6%B0%E0%A6%97-%E0%A6%9F%E0%A6%B8%E0%A6%9F-%E0%A7%AF-%E0%A6%89%E0%A6%87%E0%A6%95%E0%A6%9F-%E0%A6%9C%E0%A6%A4-%E0%A6%B8%E0%A6%B0%E0%A6%9C-%E0%A6%8F%E0%A6%97%E0%A7%9F-%E0%A6%97%E0%A6%B2-%E0%A6%A6%E0%A6%95%E0%A6%B7%E0%A6%A3-%E0%A6%86%E0%A6%AB%E0%A6%B0%E0%A6%95</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%9C%E0%A6%B9%E0%A6%A8%E0%A6%B8%E0%A6%AC%E0%A6%B0%E0%A6%97-%E0%A6%9F%E0%A6%B8%E0%A6%9F-%E0%A7%AF-%E0%A6%89%E0%A6%87%E0%A6%95%E0%A6%9F-%E0%A6%9C%E0%A6%A4-%E0%A6%B8%E0%A6%B0%E0%A6%9C-%E0%A6%8F%E0%A6%97%E0%A7%9F-%E0%A6%97%E0%A6%B2-%E0%A6%A6%E0%A6%95%E0%A6%B7%E0%A6%A3-%E0%A6%86%E0%A6%AB%E0%A6%B0%E0%A6%95</guid>
      <pubDate>Thu, 19 Nov 2026 14:19:41 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795097981_rkr_6aff057d28462.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795097981_rkr_6aff057d28462.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795097981_rkr_6aff057d28462.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জোহানেসবার্গ টেস্ট • ৯ উইকেটে জিতে সিরিজে এগিয়ে গেল দক্ষিণ আফ্রিকা" /&gt;&lt;/p&gt;&lt;p&gt;মাত্র ১২ রানের লক্ষ্য। দক্ষিণ আফ্রিকা জিতে যাবে এটাই ছিল স্বাভাবিক, হয়েছেও তাই। বাংলাদেশের প্রাপ্তি মেহেদী হাসান মিরাজের বলে প্রথম ইনিংসের সেঞ্চুরিয়ান মার্কাস অ্যাকারম্যানের উইকেট। ফলে ৯ উইকেটে জিতে স্বাগতিকরা দুই ম্যাচের টেস্ট সিরিজে ১-০ ব্যবধানে এগিয়ে গেছে।জবাব দিতে নেমে দুই বলে কোনো রান করতে না প&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%9C%E0%A6%B9%E0%A6%A8%E0%A6%B8%E0%A6%AC%E0%A6%B0%E0%A6%97-%E0%A6%9F%E0%A6%B8%E0%A6%9F-%E0%A7%AF-%E0%A6%89%E0%A6%87%E0%A6%95%E0%A6%9F-%E0%A6%9C%E0%A6%A4-%E0%A6%B8%E0%A6%B0%E0%A6%9C-%E0%A6%8F%E0%A6%97%E0%A7%9F-%E0%A6%97%E0%A6%B2-%E0%A6%A6%E0%A6%95%E0%A6%B7%E0%A6%A3-%E0%A6%86%E0%A6%AB%E0%A6%B0%E0%A6%95">Education Bangla</source>
    </item>
    <item>
      <title>ম্যানইউ ছেড়ে রিয়ালে যোগ দিচ্ছেন ১৬ বছর বয়সী ইংলিশ তারকা</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%AF%E0%A6%A8%E0%A6%87%E0%A6%89-%E0%A6%9B%E0%A7%9C-%E0%A6%B0%E0%A7%9F%E0%A6%B2-%E0%A6%AF%E0%A6%97-%E0%A6%A6%E0%A6%9A%E0%A6%9B%E0%A6%A8-%E0%A7%A7%E0%A7%AC-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%AC%E0%A7%9F%E0%A6%B8-%E0%A6%87%E0%A6%B2%E0%A6%B6-%E0%A6%A4%E0%A6%B0%E0%A6%95</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%AF%E0%A6%A8%E0%A6%87%E0%A6%89-%E0%A6%9B%E0%A7%9C-%E0%A6%B0%E0%A7%9F%E0%A6%B2-%E0%A6%AF%E0%A6%97-%E0%A6%A6%E0%A6%9A%E0%A6%9B%E0%A6%A8-%E0%A7%A7%E0%A7%AC-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%AC%E0%A7%9F%E0%A6%B8-%E0%A6%87%E0%A6%B2%E0%A6%B6-%E0%A6%A4%E0%A6%B0%E0%A6%95</guid>

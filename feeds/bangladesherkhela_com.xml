    </item>
    <item>
      <title>সেমিফাইনালে টস জিতে ব্যাটিং করছে বাংলাদেশ</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%AE%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2-%E0%A6%9F%E0%A6%B8-%E0%A6%9C%E0%A6%A4-%E0%A6%AC%E0%A6%AF%E0%A6%9F-%E0%A6%95%E0%A6%B0%E0%A6%9B-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%AE%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2-%E0%A6%9F%E0%A6%B8-%E0%A6%9C%E0%A6%A4-%E0%A6%AC%E0%A6%AF%E0%A6%9F-%E0%A6%95%E0%A6%B0%E0%A6%9B-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6</guid>
      <pubDate>Fri, 27 Nov 2026 13:20:43 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795785643_rkr_6b0983ab7a70f.png" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795785643_rkr_6b0983ab7a70f.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795785643_rkr_6b0983ab7a70f.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সেমিফাইনালে টস জিতে ব্যাটিং করছে বাংলাদেশ" /&gt;&lt;/p&gt;&lt;p&gt;রাইজিং স্টারস এশিয়া কাপের দ্বিতীয় সেমিফাইনালে পাকিস্তান শাহিনসের বিপক্ষে টস জিতে ব্যাটিং করার সিদ্ধান্ত নিয়েছেন বাংলাদেশ ‘এ’ দলের অধিনায়ক সাইফ হাসান।শুক্রবার (২৭ নভেম্বর) কাতারের দোহার ওয়েস্ট এন্ড পার্ক আন্তর্জাতিক ক্রিকেট স্টেডিয়ামে ম্যাচটি শুরু হয়েছে বাংলাদেশ সময় বিকেল ৪টায়।এই প্রতিবেদন লেখার আগ প&lt;/p&gt;</description>

      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794660993_rkr_6af85a81204c0.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794660993_rkr_6af85a81204c0.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794660993_rkr_6af85a81204c0.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গুজরাটে যাচ্ছেন হার্শাল, হায়দরাবাদে ব্যান্টন" /&gt;&lt;/p&gt;&lt;p&gt;আইপিএলের আসন্ন মৌসুমের আগে দলবদলে বড় পরিবর্তন আনছে সানরাইজার্স হায়দরাবাদ ও গুজরাট টাইটানস। হার্শাল প্যাটেলকে গুজরাটের কাছে ছেড়ে দিতে যাচ্ছে হায়দরাবাদ। বিনিময়ে ইংল্যান্ডের উইকেটকিপার-ব্যাটসম্যান টম ব্যান্টনকে দলে পাচ্ছে তারা। দুই দলের মধ্যে এ নিয়ে চূড়ান্ত আলোচনা চলছে।হার্শালকে দলে নিতে দুটি পদ্ধতি বি&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%97%E0%A6%9C%E0%A6%B0%E0%A6%9F-%E0%A6%AF%E0%A6%9A%E0%A6%9B%E0%A6%A8-%E0%A6%B9%E0%A6%B0%E0%A6%B6%E0%A6%B2-%E0%A6%B9%E0%A7%9F%E0%A6%A6%E0%A6%B0%E0%A6%AC%E0%A6%A6-%E0%A6%AC%E0%A6%AF%E0%A6%A8%E0%A6%9F%E0%A6%A8">Education Bangla</source>
    </item>
    <item>
      <title>সেমিফাইনালে বাংলাদেশ দলে দুই পরিবর্তন, একাদশে রেকর্ড ৮ প্রবাসী ফুটবলার</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%AE%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6-%E0%A6%A6%E0%A6%B2-%E0%A6%A6%E0%A6%87-%E0%A6%AA%E0%A6%B0%E0%A6%AC%E0%A6%B0%E0%A6%A4%E0%A6%A8-%E0%A6%8F%E0%A6%95%E0%A6%A6%E0%A6%B6-%E0%A6%B0%E0%A6%95%E0%A6%B0%E0%A6%A1-%E0%A7%AE-%E0%A6%AA%E0%A6%B0%E0%A6%AC%E0%A6%B8-%E0%A6%AB%E0%A6%9F%E0%A6%AC%E0%A6%B2%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%AE%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6-%E0%A6%A6%E0%A6%B2-%E0%A6%A6%E0%A6%87-%E0%A6%AA%E0%A6%B0%E0%A6%AC%E0%A6%B0%E0%A6%A4%E0%A6%A8-%E0%A6%8F%E0%A6%95%E0%A6%A6%E0%A6%B6-%E0%A6%B0%E0%A6%95%E0%A6%B0%E0%A6%A1-%E0%A7%AE-%E0%A6%AA%E0%A6%B0%E0%A6%AC%E0%A6%B8-%E0%A6%AB%E0%A6%9F%E0%A6%AC%E0%A6%B2%E0%A6%B0</guid>
      <pubDate>Sat, 14 Nov 2026 12:47:46 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_media/1794660455_6af858678b8e3.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_media/1794660455_6af858678b8e3.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_media/1794660455_6af858678b8e3.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সেমিফাইনালে বাংলাদেশ দলে দুই পরিবর্তন, একাদশে রেকর্ড ৮ প্রবাসী ফুটবলার" /&gt;&lt;/p&gt;&lt;p&gt;সাফ সেমিফাইনালের মহারণে একাদশে দুই পরিবর্তন নিয়ে নামছে বাংলাদেশ। গত ম্যাচে ডিফেন্ডার সাদ উদ্দিন মারাত্মক চোট পেয়ে টুর্নামেন্ট থেকেই ছিটকে গেছেন। তার পজিশনে অভিজ্ঞ ডিফেন্ডার রহমত মিয়ার ওপরই ভরসা রেখেছেন বাংলাদেশ কোচ থমাস ডুলি।ভুটান ম্যাচে ইব্রাহিমের গোলে জয় পেয়েছিল বাংলাদেশ। বদলি হিসেবে নেমে চার মিনি&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%AE%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6-%E0%A6%A6%E0%A6%B2-%E0%A6%A6%E0%A6%87-%E0%A6%AA%E0%A6%B0%E0%A6%AC%E0%A6%B0%E0%A6%A4%E0%A6%A8-%E0%A6%8F%E0%A6%95%E0%A6%A6%E0%A6%B6-%E0%A6%B0%E0%A6%95%E0%A6%B0%E0%A6%A1-%E0%A7%AE-%E0%A6%AA%E0%A6%B0%E0%A6%AC%E0%A6%B8-%E0%A6%AB%E0%A6%9F%E0%A6%AC%E0%A6%B2%E0%A6%B0">Education Bangla</source>
    </item>
    <item>
      <title>ফাইনালে কাকে চায় ভারত?</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2-%E0%A6%95%E0%A6%95-%E0%A6%9A%E0%A7%9F-%E0%A6%AD%E0%A6%B0%E0%A6%A4</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2-%E0%A6%95%E0%A6%95-%E0%A6%9A%E0%A7%9F-%E0%A6%AD%E0%A6%B0%E0%A6%A4</guid>
      <pubDate>Sat, 14 Nov 2026 12:41:08 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794660068_rkr_6af856e493ca9.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794660068_rkr_6af856e493ca9.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794660068_rkr_6af856e493ca9.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফাইনালে কাকে চায় ভারত?" /&gt;&lt;/p&gt;&lt;p&gt;সাফ চ্যাম্পিয়নশিপের ফাইনালে প্রতিপক্ষ হিসেবে বাংলাদেশ না পাকিস্তান- কোনো দলকেই বেছে নিতে চান না ভারতের কোচ। দুই দলকেই সমানভাবে মোকাবিলার প্রস্তুতি রাখছেন তিনি। তবে ফাইনালের আগে তার চোখে এগিয়ে বাংলাদেশই।শনিবার ঢাকা জাতীয় স্টেডিয়ামে ভুটানকে ২-১ গোলে হারিয়ে চলতি সাফ চ্যাম্পিয়নশিপের ফাইনালে উঠেছে ভারত।.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2-%E0%A6%95%E0%A6%95-%E0%A6%9A%E0%A7%9F-%E0%A6%AD%E0%A6%B0%E0%A6%A4">Education Bangla</source>
    </item>
    <item>
      <title>সাফ চ্যাম্পিয়নশিপে ভিএআরের প্রথম সুফল পেল ভুটান</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%AB-%E0%A6%9A%E0%A6%AF%E0%A6%AE%E0%A6%AA%E0%A7%9F%E0%A6%A8%E0%A6%B6%E0%A6%AA-%E0%A6%AD%E0%A6%8F%E0%A6%86%E0%A6%B0%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%B8%E0%A6%AB%E0%A6%B2-%E0%A6%AA%E0%A6%B2-%E0%A6%AD%E0%A6%9F%E0%A6%A8</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%AB-%E0%A6%9A%E0%A6%AF%E0%A6%AE%E0%A6%AA%E0%A7%9F%E0%A6%A8%E0%A6%B6%E0%A6%AA-%E0%A6%AD%E0%A6%8F%E0%A6%86%E0%A6%B0%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%B8%E0%A6%AB%E0%A6%B2-%E0%A6%AA%E0%A6%B2-%E0%A6%AD%E0%A6%9F%E0%A6%A8</guid>
      <pubDate>Sat, 14 Nov 2026 12:40:21 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794660021_rkr_6af856b57bb81.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794660021_rkr_6af856b57bb81.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794660021_rkr_6af856b57bb81.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাফ চ্যাম্পিয়নশিপে ভিএআরের প্রথম সুফল পেল ভুটান" /&gt;&lt;/p&gt;&lt;p&gt;সাফ চ্যাম্পিয়নশিপে প্রথমবারের মতো ব্যবহার হচ্ছে ভিডিও অ্যাসিস্ট্যান্ট রেফারি (ভিএআর) প্রযুক্তি। ভারত ও ভুটানের সেমিফাইনাল দিয়ে দক্ষিণ এশিয়ার এই ফুটবল প্রতিযোগিতায় যুক্ত হয়েছে আধুনিক প্রযুক্তিটি। আর এর প্রথম সুফলও পেল ভুটান। একবার নয়, দুইবার।ঢাকার জাতীয় স্টেডিয়ামে প্রথম সেমিফাইনালের প্রথমার্ধে ভুটানে&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%AB-%E0%A6%9A%E0%A6%AF%E0%A6%AE%E0%A6%AA%E0%A7%9F%E0%A6%A8%E0%A6%B6%E0%A6%AA-%E0%A6%AD%E0%A6%8F%E0%A6%86%E0%A6%B0%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%B8%E0%A6%AB%E0%A6%B2-%E0%A6%AA%E0%A6%B2-%E0%A6%AD%E0%A6%9F%E0%A6%A8">Education Bangla</source>
    </item>
    <item>
      <title>এক গোল, এক পেনাল্টিতেই ভিএআরের ওপর বিরক্ত ভারত কোচ!</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%8F%E0%A6%95-%E0%A6%97%E0%A6%B2-%E0%A6%8F%E0%A6%95-%E0%A6%AA%E0%A6%A8%E0%A6%B2%E0%A6%9F%E0%A6%A4%E0%A6%87-%E0%A6%AD%E0%A6%8F%E0%A6%86%E0%A6%B0%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%AC%E0%A6%B0%E0%A6%95%E0%A6%A4-%E0%A6%AD%E0%A6%B0%E0%A6%A4-%E0%A6%95%E0%A6%9A</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%8F%E0%A6%95-%E0%A6%97%E0%A6%B2-%E0%A6%8F%E0%A6%95-%E0%A6%AA%E0%A6%A8%E0%A6%B2%E0%A6%9F%E0%A6%A4%E0%A6%87-%E0%A6%AD%E0%A6%8F%E0%A6%86%E0%A6%B0%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%AC%E0%A6%B0%E0%A6%95%E0%A6%A4-%E0%A6%AD%E0%A6%B0%E0%A6%A4-%E0%A6%95%E0%A6%9A</guid>
      <pubDate>Sat, 14 Nov 2026 12:38:58 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794659938_rkr_6af85662f0aca.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794659938_rkr_6af85662f0aca.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794659938_rkr_6af85662f0aca.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এক গোল, এক পেনাল্টিতেই ভিএআরের ওপর বিরক্ত ভারত কোচ!" /&gt;&lt;/p&gt;&lt;p&gt;সাফ চ্যাম্পিয়নশিপে প্রথমবারের মতো চালু হয়েছে ভিডিও অ্যাসিস্ট্যান্ট রেফারি (ভিএআর)। প্রযুক্তির অভিষেকেই অবশ্য স্বস্তি পাননি ভারতের কোচ নওশাদ মুসা। ম্যাচে একটি গোল ও একটি পেনাল্টির সিদ্ধান্ত বিপক্ষে গেছে ভারতের। এতেই ভিএআরের &amp;amp;nbsp;প্রতি বিরক্তিই প্রকাশ করেছেন তিনি।&amp;amp;nbsp;শনিবার ভুটানকে ২-১ গোলে&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%8F%E0%A6%95-%E0%A6%97%E0%A6%B2-%E0%A6%8F%E0%A6%95-%E0%A6%AA%E0%A6%A8%E0%A6%B2%E0%A6%9F%E0%A6%A4%E0%A6%87-%E0%A6%AD%E0%A6%8F%E0%A6%86%E0%A6%B0%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%AC%E0%A6%B0%E0%A6%95%E0%A6%A4-%E0%A6%AD%E0%A6%B0%E0%A6%A4-%E0%A6%95%E0%A6%9A">Education Bangla</source>
    </item>

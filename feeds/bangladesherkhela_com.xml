      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795018239_rkr_6afdcdffaab04.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795018239_rkr_6afdcdffaab04.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাবা হলেন এনদ্রিক, সন্তানের নাম রাখলেন কেনদ্রিক" /&gt;&lt;/p&gt;&lt;p&gt;ফুটবল মাঠে গোলের উচ্ছ্বাস, আর মাঠের বাইরে জীবনের সবচেয়ে সুন্দর মুহূর্তের স্বাদ; একই দিনে দুই আনন্দে ভাসলেন ব্রাজিলের তরুণ ফরোয়ার্ড এনদ্রিক। সিঙ্গাপুরের বিপক্ষে ব্রাজিলের জার্সিতে গোল করার দিনেই বাবা হওয়ার সুখবর পেয়েছেন রিয়াল মাদ্রিদের এই ফুটবলার। স্ত্রী গ্যাব্রিয়েলি মিরান্দার কোলজুড়ে এসেছে তাঁদের প্&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%AC-%E0%A6%B9%E0%A6%B2%E0%A6%A8-%E0%A6%8F%E0%A6%A8%E0%A6%A6%E0%A6%B0%E0%A6%95-%E0%A6%B8%E0%A6%A8%E0%A6%A4%E0%A6%A8%E0%A6%B0-%E0%A6%A8%E0%A6%AE-%E0%A6%B0%E0%A6%96%E0%A6%B2%E0%A6%A8-%E0%A6%95%E0%A6%A8%E0%A6%A6%E0%A6%B0%E0%A6%95">Education Bangla</source>

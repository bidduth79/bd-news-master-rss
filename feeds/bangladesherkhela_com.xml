      <pubDate>Thu, 12 Nov 2026 09:00:31 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794474031_rkr_6af5802fedfa1.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794474031_rkr_6af5802fedfa1.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794474031_rkr_6af5802fedfa1.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মার্টিনেজকে নিয়ে অনিশ্চয়তা" /&gt;&lt;/p&gt;&lt;p&gt;আর্জেন্টিনার গোলবারে এমিলিয়ানো মার্তিনেজ থাকবেন, নাকি তার জায়গায় দেখা যাবে হেরোনিমো রুলিকে, উরুগুয়ের বিপক্ষে ম্যাচের আগে আলোচনায় এখন এই এক প্রশ্ন। চেলসির বিপক্ষে ম্যাচে চোয়ালে চোট পেয়ে অস্ত্রোপচার করাতে হয়েছিল মার্তিনেজকে। এখনো পুরোপুরি সুস্থ হয়ে ওঠেননি তিনি। তবে মুখে সুরক্ষামূলক মাস্ক পরে অনুশীলন চ&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%B0%E0%A6%9F%E0%A6%A8%E0%A6%9C%E0%A6%95-%E0%A6%A8%E0%A7%9F-%E0%A6%85%E0%A6%A8%E0%A6%B6%E0%A6%9A%E0%A7%9F%E0%A6%A4">Education Bangla</source>
    </item>
    <item>
      <title>ফিলিস্তিনের তরুণ ফুটবলারকে হত্যা করল ইসরায়েল</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AB%E0%A6%B2%E0%A6%B8%E0%A6%A4%E0%A6%A8%E0%A6%B0-%E0%A6%A4%E0%A6%B0%E0%A6%A3-%E0%A6%AB%E0%A6%9F%E0%A6%AC%E0%A6%B2%E0%A6%B0%E0%A6%95-%E0%A6%B9%E0%A6%A4%E0%A6%AF-%E0%A6%95%E0%A6%B0%E0%A6%B2-%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A7%9F%E0%A6%B2</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AB%E0%A6%B2%E0%A6%B8%E0%A6%A4%E0%A6%A8%E0%A6%B0-%E0%A6%A4%E0%A6%B0%E0%A6%A3-%E0%A6%AB%E0%A6%9F%E0%A6%AC%E0%A6%B2%E0%A6%B0%E0%A6%95-%E0%A6%B9%E0%A6%A4%E0%A6%AF-%E0%A6%95%E0%A6%B0%E0%A6%B2-%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A7%9F%E0%A6%B2</guid>
      <pubDate>Thu, 12 Nov 2026 08:59:19 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794473959_rkr_6af57fe75eae3.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794473959_rkr_6af57fe75eae3.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794473959_rkr_6af57fe75eae3.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফিলিস্তিনের তরুণ ফুটবলারকে হত্যা করল ইসরায়েল" /&gt;&lt;/p&gt;&lt;p&gt;ফিলিস্তিনের গাজায় ইসরায়েলি বিমান হামলায় নিহত হয়েছেন দেশটির ২০ বছর বয়সী ফুটবলার মাহমুদ কামাল ফারেস আবদেল-মালেক। মঙ্গলবার স্থানীয় সময় গাজা সিটির দক্ষিণাঞ্চলীয় সাবরা এলাকায় এ হামলার ঘটনা ঘটে। তার মৃত্যুর খবর নিশ্চিত করেছে ফিলিস্তিন ফুটবল অ্যাসোসিয়েশন (পিএফএ)।আবদেল-মালেক ছিলেন গাজা স্পোর্টস ক্লাবের অধিন&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AB%E0%A6%B2%E0%A6%B8%E0%A6%A4%E0%A6%A8%E0%A6%B0-%E0%A6%A4%E0%A6%B0%E0%A6%A3-%E0%A6%AB%E0%A6%9F%E0%A6%AC%E0%A6%B2%E0%A6%B0%E0%A6%95-%E0%A6%B9%E0%A6%A4%E0%A6%AF-%E0%A6%95%E0%A6%B0%E0%A6%B2-%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A7%9F%E0%A6%B2">Education Bangla</source>
    </item>
    <item>
      <title>ইনজামামের চোখে বিশ্বকাপ না-জেতা সেরা ১২ ক্রিকেটার</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%87%E0%A6%A8%E0%A6%9C%E0%A6%AE%E0%A6%AE%E0%A6%B0-%E0%A6%9A%E0%A6%96-%E0%A6%AC%E0%A6%B6%E0%A6%AC%E0%A6%95%E0%A6%AA-%E0%A6%A8-%E0%A6%9C%E0%A6%A4-%E0%A6%B8%E0%A6%B0-%E0%A7%A7%E0%A7%A8-%E0%A6%95%E0%A6%B0%E0%A6%95%E0%A6%9F%E0%A6%B0</link>

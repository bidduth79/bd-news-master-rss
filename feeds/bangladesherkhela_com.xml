      <title>তায়কোয়ানডোর মানোন্নয়নে ২০০ কোচকে নিয়ে বিশেষ প্রশিক্ষণ</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%A4%E0%A7%9F%E0%A6%95%E0%A7%9F%E0%A6%A8%E0%A6%A1%E0%A6%B0-%E0%A6%AE%E0%A6%A8%E0%A6%A8%E0%A6%A8%E0%A7%9F%E0%A6%A8-%E0%A7%A8%E0%A7%A6%E0%A7%A6-%E0%A6%95%E0%A6%9A%E0%A6%95-%E0%A6%A8%E0%A7%9F-%E0%A6%AC%E0%A6%B6%E0%A6%B7-%E0%A6%AA%E0%A6%B0%E0%A6%B6%E0%A6%95%E0%A6%B7%E0%A6%A3</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%A4%E0%A7%9F%E0%A6%95%E0%A7%9F%E0%A6%A8%E0%A6%A1%E0%A6%B0-%E0%A6%AE%E0%A6%A8%E0%A6%A8%E0%A6%A8%E0%A7%9F%E0%A6%A8-%E0%A7%A8%E0%A7%A6%E0%A7%A6-%E0%A6%95%E0%A6%9A%E0%A6%95-%E0%A6%A8%E0%A7%9F-%E0%A6%AC%E0%A6%B6%E0%A6%B7-%E0%A6%AA%E0%A6%B0%E0%A6%B6%E0%A6%95%E0%A6%B7%E0%A6%A3</guid>

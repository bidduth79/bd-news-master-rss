    <item>
      <title>নারী ক্রিকেটারদের নিরাপত্তা ও মাতৃত্বের সুরক্ষায় উদ্যোগ বিসিবির</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%A8%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%95%E0%A6%9F%E0%A6%B0%E0%A6%A6%E0%A6%B0-%E0%A6%A8%E0%A6%B0%E0%A6%AA%E0%A6%A4%E0%A6%A4-%E0%A6%93-%E0%A6%AE%E0%A6%A4%E0%A6%A4%E0%A6%AC%E0%A6%B0-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%B7%E0%A7%9F-%E0%A6%89%E0%A6%A6%E0%A6%AF%E0%A6%97-%E0%A6%AC%E0%A6%B8%E0%A6%AC%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%A8%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%95%E0%A6%9F%E0%A6%B0%E0%A6%A6%E0%A6%B0-%E0%A6%A8%E0%A6%B0%E0%A6%AA%E0%A6%A4%E0%A6%A4-%E0%A6%93-%E0%A6%AE%E0%A6%A4%E0%A6%A4%E0%A6%AC%E0%A6%B0-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%B7%E0%A7%9F-%E0%A6%89%E0%A6%A6%E0%A6%AF%E0%A6%97-%E0%A6%AC%E0%A6%B8%E0%A6%AC%E0%A6%B0</guid>
      <pubDate>Sun, 22 Nov 2026 16:15:26 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795364126_rkr_6b03151ecee46.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795364126_rkr_6b03151ecee46.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795364126_rkr_6b03151ecee46.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নারী ক্রিকেটারদের নিরাপত্তা ও মাতৃত্বের সুরক্ষায় উদ্যোগ বিসিবির" /&gt;&lt;/p&gt;&lt;p&gt;নারী ক্রিকেটে দীর্ঘদিনের অনিয়ম, হয়রানির অভিযোগ ও খেলোয়াড়দের নিরাপত্তার প্রশ্নে প্রাতিষ্ঠানিক পরিবর্তনের উদ্যোগ নিয়েছে বাংলাদেশ ক্রিকেট বোর্ড (বিসিবি)। নারী ক্রিকেটারদের অভিযোগ গ্রহণ ও তদন্তে স্বাধীন কমিটি গঠনের পাশাপাশি মাতৃত্বকালীন ছুটি এবং সন্তান জন্মের পর মাঠে ফেরার সুযোগ নিশ্চিত করতে পৃথক নীতিমা&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%A8%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%95%E0%A6%9F%E0%A6%B0%E0%A6%A6%E0%A6%B0-%E0%A6%A8%E0%A6%B0%E0%A6%AA%E0%A6%A4%E0%A6%A4-%E0%A6%93-%E0%A6%AE%E0%A6%A4%E0%A6%A4%E0%A6%AC%E0%A6%B0-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%B7%E0%A7%9F-%E0%A6%89%E0%A6%A6%E0%A6%AF%E0%A6%97-%E0%A6%AC%E0%A6%B8%E0%A6%AC%E0%A6%B0">Education Bangla</source>
    </item>
    <item>
      <title>জাতীয় বিচ ভলিবলে নারী বিভাগে চ্যাম্পিয়ন আনসার-ভিডিপি</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%9C%E0%A6%A4%E0%A6%AF-%E0%A6%AC%E0%A6%9A-%E0%A6%AD%E0%A6%B2%E0%A6%AC%E0%A6%B2-%E0%A6%A8%E0%A6%B0-%E0%A6%AC%E0%A6%AD%E0%A6%97-%E0%A6%9A%E0%A6%AF%E0%A6%AE%E0%A6%AA%E0%A6%AF%E0%A6%A8-%E0%A6%86%E0%A6%A8%E0%A6%B8%E0%A6%B0-%E0%A6%AD%E0%A6%A1%E0%A6%AA</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%9C%E0%A6%A4%E0%A6%AF-%E0%A6%AC%E0%A6%9A-%E0%A6%AD%E0%A6%B2%E0%A6%AC%E0%A6%B2-%E0%A6%A8%E0%A6%B0-%E0%A6%AC%E0%A6%AD%E0%A6%97-%E0%A6%9A%E0%A6%AF%E0%A6%AE%E0%A6%AA%E0%A6%AF%E0%A6%A8-%E0%A6%86%E0%A6%A8%E0%A6%B8%E0%A6%B0-%E0%A6%AD%E0%A6%A1%E0%A6%AA</guid>
      <pubDate>Sun, 22 Nov 2026 16:14:23 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795364063_rkr_6b0314df9de3a.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795364063_rkr_6b0314df9de3a.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795364063_rkr_6b0314df9de3a.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জাতীয় বিচ ভলিবলে নারী বিভাগে চ্যাম্পিয়ন আনসার-ভিডিপি" /&gt;&lt;/p&gt;&lt;p&gt;জাতীয় বিচ ভলিবল চ্যাম্পিয়নশিপ-২০২৬ এর নারী বিভাগে চ্যাম্পিয়ন হয়েছে বাংলাদেশ আনসার ও গ্রাম প্রতিরক্ষা বাহিনী মহিলা এ দল। কক্সবাজার সমুদ্রসৈকতে অনুষ্ঠিত প্রতিযোগিতার ফাইনালে বাংলাদেশ পুলিশ মহিলা এ দলকে ২-১ সেটে হারিয়ে শিরোপা জিতে নেয় আনসার ও ভিডিপি মহিলা এ দল।এ গৌরবময় অর্জনে বাংলাদেশ আনসার ও গ্&lt;/p&gt;</description>

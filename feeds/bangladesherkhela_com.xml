      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794139587_rkr_6af065c35da1f.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794139587_rkr_6af065c35da1f.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794139587_rkr_6af065c35da1f.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="খাজার দাবি নিয়ে ইংল্যান্ড লিজেন্ডের প্রশ্ন" /&gt;&lt;/p&gt;&lt;p&gt;আট বছর আগে কেপটাউনে ঘটে যাওয়া স্যান্ডপেপার গেট কেলেঙ্কারি নতুন করে উসকে দিয়েছেন উসমান খাজা। ক্রিকেট ইতিহাসে অন্যতম বিতর্কিত হয়ে থাকা এই ঘটনা নতুন মোড় নিয়েছে তার প্রকাশিত হতে যাওয়া আত্মজীবনীমূলক বই ‘সবর’এ।২০১৮ সালে দক্ষিণ আফ্রিকার বিপক্ষে সেই ঘটনায় ক্যামেরন ব্যানক্রফট, ডেভিড ওয়ার্নার ও স্টিভ স্মিথ দো&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%96%E0%A6%9C%E0%A6%B0-%E0%A6%A6%E0%A6%AC-%E0%A6%A8%E0%A7%9F-%E0%A6%87%E0%A6%B2%E0%A6%AF%E0%A6%A8%E0%A6%A1-%E0%A6%B2%E0%A6%9C%E0%A6%A8%E0%A6%A1%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%B6%E0%A6%A8">Education Bangla</source>

      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794661507_rkr_6af85c83357f3.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794661507_rkr_6af85c83357f3.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794661507_rkr_6af85c83357f3.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অস্ট্রেলিয়াকে চাপে ফেলায় বাংলাদেশকে সম্মান করছেন বাভুমা" /&gt;&lt;/p&gt;&lt;p&gt;টেস্ট চ্যাম্পিয়নশিপের আরও একটি গুরুত্বপূর্ণ সিরিজে মাঠে নামতে যাচ্ছে দক্ষিণ আফ্রিকা ও বাংলাদেশ। দুই ম্যাচ সিরিজের প্রথমটি শুরু হচ্ছে আগামীকাল। তার আগে আজ জোহানার্সবার্গে সংবাদ সম্মেলনে আসেন প্রোটিয়া অধিনায়ক টেম্বা বাভুমা।সেখানে তিনি বাংলাদেশকে বেশ সম্মানের সাথে দেখার কথা জানান, &amp;#039;হ্যাঁ আমরা তাদে&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%85%E0%A6%B8%E0%A6%9F%E0%A6%B0%E0%A6%B2%E0%A7%9F%E0%A6%95-%E0%A6%9A%E0%A6%AA-%E0%A6%AB%E0%A6%B2%E0%A7%9F-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6%E0%A6%95-%E0%A6%B8%E0%A6%AE%E0%A6%AE%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A6%9B%E0%A6%A8-%E0%A6%AC%E0%A6%AD%E0%A6%AE">Education Bangla</source>
    </item>
    <item>
      <title>জুবিমেন্দিকে পেতে আগ্রহী নয় বায়ার্ন</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%9C%E0%A6%AC%E0%A6%AE%E0%A6%A8%E0%A6%A6%E0%A6%95-%E0%A6%AA%E0%A6%A4-%E0%A6%86%E0%A6%97%E0%A6%B0%E0%A6%B9-%E0%A6%A8%E0%A7%9F-%E0%A6%AC%E0%A7%9F%E0%A6%B0%E0%A6%A8</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%9C%E0%A6%AC%E0%A6%AE%E0%A6%A8%E0%A6%A6%E0%A6%95-%E0%A6%AA%E0%A6%A4-%E0%A6%86%E0%A6%97%E0%A6%B0%E0%A6%B9-%E0%A6%A8%E0%A7%9F-%E0%A6%AC%E0%A7%9F%E0%A6%B0%E0%A6%A8</guid>
      <pubDate>Sat, 14 Nov 2026 12:57:21 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794661041_rkr_6af85ab17f87f.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794661041_rkr_6af85ab17f87f.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794661041_rkr_6af85ab17f87f.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জুবিমেন্দিকে পেতে আগ্রহী নয় বায়ার্ন" /&gt;&lt;/p&gt;&lt;p&gt;আর্সেনালের স্প্যানিশ মিডফিল্ডার মার্টিন জুবিমেন্দিকে দলে ভেড়ানোর আগ্রহ নেই বায়ার্ন মিউনিখের। আগামী জানুয়ারির দলবদলে তাকে কেনার সম্ভাবনা নাকচ করে দিয়েছে জার্মান ক্লাবটি। জার্মান সাংবাদিক ক্রিস্টিয়ান ফাল্কের বরাত দিয়ে এ খবর জানিয়েছে ফুটবল ৩৬৫।গত বছরের জুলাইয়ে রিয়াল সোসিয়েদাদ থেকে প্রায় ৬ কোটি পাউন্ডে.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%9C%E0%A6%AC%E0%A6%AE%E0%A6%A8%E0%A6%A6%E0%A6%95-%E0%A6%AA%E0%A6%A4-%E0%A6%86%E0%A6%97%E0%A6%B0%E0%A6%B9-%E0%A6%A8%E0%A7%9F-%E0%A6%AC%E0%A7%9F%E0%A6%B0%E0%A6%A8">Education Bangla</source>
    </item>
    <item>

      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795708634_rkr_6b0856daa6cc5.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795708634_rkr_6b0856daa6cc5.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795708634_rkr_6b0856daa6cc5.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="লাহোর কালান্দার্সের প্রধান কোচ হিসেবে নিয়োগ পেলেন শন টেইট" /&gt;&lt;/p&gt;&lt;p&gt;তিনবারের চ্যাম্পিয়ন লাহোর কালান্দার্স পাকিস্তান সুপার লিগের (পিএসএল) ১২তম আসরের জন্য অস্ট্রেলিয়ার সাবেক ফাস্ট বোলার শন টেইটকে প্রধান কোচ হিসেবে নিয়োগ দিয়েছে। আসন্ন মৌসুমের আগে কোচিং স্টাফকে আরও শক্তিশালী করতেই এ উদ্যোগ নিয়েছে ফ্র্যাঞ্চাইজিটি।লাহোরের মালিক সামিন রানার বরাত দিয়ে টেইটের নিয়োগের বিষয়টি.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B2%E0%A6%B9%E0%A6%B0-%E0%A6%95%E0%A6%B2%E0%A6%A8%E0%A6%A6%E0%A6%B0%E0%A6%B8%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%A7%E0%A6%A8-%E0%A6%95%E0%A6%9A-%E0%A6%B9%E0%A6%B8%E0%A6%AC-%E0%A6%A8%E0%A7%9F%E0%A6%97-%E0%A6%AA%E0%A6%B2%E0%A6%A8-%E0%A6%B6%E0%A6%A8-%E0%A6%9F%E0%A6%87%E0%A6%9F">Education Bangla</source>
    </item>
    <item>
      <title>নিউজিল্যান্ড-ভারত দ্বিতীয় টেস্টে সবার নজর ক্রাইস্টচার্চের পিচে</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%A8%E0%A6%89%E0%A6%9C%E0%A6%B2%E0%A6%AF%E0%A6%A8%E0%A6%A1-%E0%A6%AD%E0%A6%B0%E0%A6%A4-%E0%A6%A6%E0%A6%AC%E0%A6%A4%E0%A7%9F-%E0%A6%9F%E0%A6%B8%E0%A6%9F-%E0%A6%B8%E0%A6%AC%E0%A6%B0-%E0%A6%A8%E0%A6%9C%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%87%E0%A6%B8%E0%A6%9F%E0%A6%9A%E0%A6%B0%E0%A6%9A%E0%A6%B0-%E0%A6%AA%E0%A6%9A</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%A8%E0%A6%89%E0%A6%9C%E0%A6%B2%E0%A6%AF%E0%A6%A8%E0%A6%A1-%E0%A6%AD%E0%A6%B0%E0%A6%A4-%E0%A6%A6%E0%A6%AC%E0%A6%A4%E0%A7%9F-%E0%A6%9F%E0%A6%B8%E0%A6%9F-%E0%A6%B8%E0%A6%AC%E0%A6%B0-%E0%A6%A8%E0%A6%9C%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%87%E0%A6%B8%E0%A6%9F%E0%A6%9A%E0%A6%B0%E0%A6%9A%E0%A6%B0-%E0%A6%AA%E0%A6%9A</guid>
      <pubDate>Thu, 26 Nov 2026 15:56:33 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795708593_rkr_6b0856b1ee080.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795708593_rkr_6b0856b1ee080.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795708593_rkr_6b0856b1ee080.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নিউজিল্যান্ড-ভারত দ্বিতীয় টেস্টে সবার নজর ক্রাইস্টচার্চের পিচে" /&gt;&lt;/p&gt;&lt;p&gt;ওয়েলিংটনের বেসিন রিজার্ভে নিষ্প্রাণ উইকেটে পাঁচ দিনের খেলা শেষে ড্রয়ের পর ভারতের বিপক্ষে দ্বিতীয় টেস্টে স্বাভাবিক উইকেট পাওয়ার প্রত্যাশা করছেন নিউজিল্যান্ড অধিনায়ক টম ল্যাথাম।শুক্রবার থেকে শুরু হতে যাওয়া ম্যাচের ভেন্যু হ্যাগলি ওভালের পিচে লম্বা সবুজ ঘাস রয়েছে। এক দিন বৃষ্টির পর টস জিতলে দুই দলই সম্ভ&lt;/p&gt;</description>

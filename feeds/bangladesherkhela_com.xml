      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794499367_rkr_6af5e32720e29.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794499367_rkr_6af5e32720e29.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পায়ের রগ ছিঁড়েছে সাদের, অন্তত এক বছর মাঠের বাইরে" /&gt;&lt;/p&gt;&lt;p&gt;সাফ চ্যাম্পিয়নশিপে বুধবার শ্রীলঙ্কাকে ৪-০ গোলে উড়িয়ে দিয়েছে বাংলাদেশ। তবে পুরো ম্যাচে দারুণ পারফর্ম করা সাদ উদ্দীন মাঠ ছাড়েন চোট নিয়ে। আর সেই চোটেই এবারের সাফ থেকে ছিটকে গেছেন এই রাইট।গতকাল&amp;amp;nbsp;শ্রীলঙ্কার বিপক্ষে ম্যাচে ৭৬তম মিনিটে চোট পেয়ে মাঠ ছাড়তে হয় তাকে। প্রাথমিকভাবে পাওয়া তথ্যে, তার গোড়াল&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AA%E0%A7%9F%E0%A6%B0-%E0%A6%B0%E0%A6%97-%E0%A6%9B%E0%A7%9C%E0%A6%9B-%E0%A6%B8%E0%A6%A6%E0%A6%B0-%E0%A6%85%E0%A6%A8%E0%A6%A4%E0%A6%A4-%E0%A6%8F%E0%A6%95-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%AE%E0%A6%A0%E0%A6%B0-%E0%A6%AC%E0%A6%87%E0%A6%B0">Education Bangla</source>

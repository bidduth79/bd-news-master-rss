      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795364479_rkr_6b03167f91b80.png" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795364479_rkr_6b03167f91b80.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795364479_rkr_6b03167f91b80.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ক্রীড়াবিদদের এক লাখ টাকা ভাতা দিচ্ছে সরকার" /&gt;&lt;/p&gt;&lt;p&gt;খেলাধুলাকে শুধু বিনোদনের মাধ্যমে সীমাবদ্ধ না রেখে জীবিকা অর্জনের মাধ্যম হিসেবে প্রতিষ্ঠা করতে চায় বর্তমান সরকার। এই লক্ষ্য সামনে রেখে ক্রীড়াবিদদের আর্থ-সামাজিক উন্নয়নে এক লাখ টাকা করে আর্থিক সহায়তা ভাতা প্রদানের কার্যক্রম শুরু করেছে বলে জানিয়েছেন যুব ও ক্রীড়া প্রতিমন্ত্রী আমিনুল হক।রোববার (২২ নভ&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%95%E0%A6%B0%E0%A6%A1%E0%A6%AC%E0%A6%A6%E0%A6%A6%E0%A6%B0-%E0%A6%8F%E0%A6%95-%E0%A6%B2%E0%A6%96-%E0%A6%9F%E0%A6%95-%E0%A6%AD%E0%A6%A4-%E0%A6%A6%E0%A6%9A%E0%A6%9B-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%B0">Education Bangla</source>

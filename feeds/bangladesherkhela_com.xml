    <item>
      <title>মোজাম্বিককে হারিয়ে অনূর্ধ্ব-১৭ বিশ্বকাপে প্রথম জয় আর্জেন্টিনার</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%9C%E0%A6%AE%E0%A6%AC%E0%A6%95%E0%A6%95-%E0%A6%B9%E0%A6%B0%E0%A7%9F-%E0%A6%85%E0%A6%A8%E0%A6%B0%E0%A6%A7%E0%A6%AC-%E0%A7%A7%E0%A7%AD-%E0%A6%AC%E0%A6%B6%E0%A6%AC%E0%A6%95%E0%A6%AA-%E0%A6%AA%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%9C%E0%A7%9F-%E0%A6%86%E0%A6%B0%E0%A6%9C%E0%A6%A8%E0%A6%9F%E0%A6%A8%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%9C%E0%A6%AE%E0%A6%AC%E0%A6%95%E0%A6%95-%E0%A6%B9%E0%A6%B0%E0%A7%9F-%E0%A6%85%E0%A6%A8%E0%A6%B0%E0%A6%A7%E0%A6%AC-%E0%A7%A7%E0%A7%AD-%E0%A6%AC%E0%A6%B6%E0%A6%AC%E0%A6%95%E0%A6%AA-%E0%A6%AA%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%9C%E0%A7%9F-%E0%A6%86%E0%A6%B0%E0%A6%9C%E0%A6%A8%E0%A6%9F%E0%A6%A8%E0%A6%B0</guid>
      <pubDate>Mon, 23 Nov 2026 06:58:25 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795417105_rkr_6b03e4116eb5e.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795417105_rkr_6b03e4116eb5e.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795417105_rkr_6b03e4116eb5e.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মোজাম্বিককে হারিয়ে অনূর্ধ্ব-১৭ বিশ্বকাপে প্রথম জয় আর্জেন্টিনার" /&gt;&lt;/p&gt;&lt;p&gt;ফিফা অনূর্ধ্ব-১৭ বিশ্বকাপে নিজেদের প্রথম জয় তুলে নিয়েছে আর্জেন্টিনা। গ্রুপ ‘সি’র ম্যাচে মোজাম্বিককে ২-১ গোলে হারিয়েছে দিয়েগো প্লাসেন্তের দল। আগের ম্যাচে অস্ট্রেলিয়ার কাছে ২-০ গোলে হারের পর এই জয়ে ঘুরে দাঁড়াল দুইবারের বিশ্বচ্যাম্পিয়নরা।ম্যাচের শুরু থেকেই আক্রমণাত্মক ফুটবল খেলতে থাকে আর্জেন্টিনা। চতুর&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%9C%E0%A6%AE%E0%A6%AC%E0%A6%95%E0%A6%95-%E0%A6%B9%E0%A6%B0%E0%A7%9F-%E0%A6%85%E0%A6%A8%E0%A6%B0%E0%A6%A7%E0%A6%AC-%E0%A7%A7%E0%A7%AD-%E0%A6%AC%E0%A6%B6%E0%A6%AC%E0%A6%95%E0%A6%AA-%E0%A6%AA%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%9C%E0%A7%9F-%E0%A6%86%E0%A6%B0%E0%A6%9C%E0%A6%A8%E0%A6%9F%E0%A6%A8%E0%A6%B0">Education Bangla</source>
    </item>
    <item>
      <title>প্রথমবার এটিপি ফাইনালসের চ্যাম্পিয়ন আলকারাজ</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AA%E0%A6%B0%E0%A6%A5%E0%A6%AE%E0%A6%AC%E0%A6%B0-%E0%A6%8F%E0%A6%9F%E0%A6%AA-%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2%E0%A6%B8%E0%A6%B0-%E0%A6%9A%E0%A6%AF%E0%A6%AE%E0%A6%AA%E0%A7%9F%E0%A6%A8-%E0%A6%86%E0%A6%B2%E0%A6%95%E0%A6%B0%E0%A6%9C</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AA%E0%A6%B0%E0%A6%A5%E0%A6%AE%E0%A6%AC%E0%A6%B0-%E0%A6%8F%E0%A6%9F%E0%A6%AA-%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2%E0%A6%B8%E0%A6%B0-%E0%A6%9A%E0%A6%AF%E0%A6%AE%E0%A6%AA%E0%A7%9F%E0%A6%A8-%E0%A6%86%E0%A6%B2%E0%A6%95%E0%A6%B0%E0%A6%9C</guid>
      <pubDate>Mon, 23 Nov 2026 06:55:10 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795416910_rkr_6b03e34ee9b89.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795416910_rkr_6b03e34ee9b89.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795416910_rkr_6b03e34ee9b89.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রথমবার এটিপি ফাইনালসের চ্যাম্পিয়ন আলকারাজ" /&gt;&lt;/p&gt;&lt;p&gt;চোটের কারণে দীর্ঘদিন কোর্টের বাইরে থাকতে হয়েছিল। তবে ফিরেই নিজের চেনা ছন্দে স্প্যানিশ টেনিস তারকা কার্লোস আলকারাজ। বিশ্ব টেনিসের এক নম্বর খেলোয়াড় জার্মানির আলেকজান্ডার জভেরেভকে হারিয়ে প্রথমবারের মতো এটিপি ফাইনালসের শিরোপা জিতেছেন তিনি। রোববার (২২ নভেম্বর) ইতালির তুরিনে অনুষ্ঠিত ফাইনালে জভেরেভকে ৬-২,&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AA%E0%A6%B0%E0%A6%A5%E0%A6%AE%E0%A6%AC%E0%A6%B0-%E0%A6%8F%E0%A6%9F%E0%A6%AA-%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2%E0%A6%B8%E0%A6%B0-%E0%A6%9A%E0%A6%AF%E0%A6%AE%E0%A6%AA%E0%A7%9F%E0%A6%A8-%E0%A6%86%E0%A6%B2%E0%A6%95%E0%A6%B0%E0%A6%9C">Education Bangla</source>
    </item>
    <item>
      <title>ভারতকে ৪৮ রানে হারিয়ে সেমিফাইনালে পাকিস্তান</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AD%E0%A6%B0%E0%A6%A4%E0%A6%95-%E0%A7%AA%E0%A7%AE-%E0%A6%B0%E0%A6%A8-%E0%A6%B9%E0%A6%B0%E0%A7%9F-%E0%A6%B8%E0%A6%AE%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2-%E0%A6%AA%E0%A6%95%E0%A6%B8%E0%A6%A4%E0%A6%A8</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AD%E0%A6%B0%E0%A6%A4%E0%A6%95-%E0%A7%AA%E0%A7%AE-%E0%A6%B0%E0%A6%A8-%E0%A6%B9%E0%A6%B0%E0%A7%9F-%E0%A6%B8%E0%A6%AE%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2-%E0%A6%AA%E0%A6%95%E0%A6%B8%E0%A6%A4%E0%A6%A8</guid>
      <pubDate>Mon, 23 Nov 2026 06:54:25 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795416865_rkr_6b03e3216b36b.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795416865_rkr_6b03e3216b36b.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795416865_rkr_6b03e3216b36b.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভারতকে ৪৮ রানে হারিয়ে সেমিফাইনালে পাকিস্তান" /&gt;&lt;/p&gt;&lt;p&gt;রোমাঞ্চকর লড়াইয়ে চিরপ্রতিদ্বন্দ্বী ভারতকে ৪৮ রানে হারিয়ে এসিসি পুরুষ এশিয়া কাপ রাইজিং স্টার্সের সেমিফাইনাল নিশ্চিত করেছে ডিফেন্ডিং চ্যাম্পিয়ন পাকিস্তান। রোববার (২৩ নভেম্বর) ওয়েস্ট এন্ড পার্ক আন্তর্জাতিক ক্রিকেট স্টেডিয়ামে গ্রুপ ‘বি’র ম্যাচে এই জয় তুলে নেয় পাকিস্তান শাহিনস। টুর্নামেন্টে এটি তাদের টান&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AD%E0%A6%B0%E0%A6%A4%E0%A6%95-%E0%A7%AA%E0%A7%AE-%E0%A6%B0%E0%A6%A8-%E0%A6%B9%E0%A6%B0%E0%A7%9F-%E0%A6%B8%E0%A6%AE%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2-%E0%A6%AA%E0%A6%95%E0%A6%B8%E0%A6%A4%E0%A6%A8">Education Bangla</source>
    </item>
    <item>
      <title>পচেত্তিনোর অভিষেকেই লিভারপুলের কাছে বিধ্বস্ত ম্যানচেস্টার ইউনাইটেড</title>

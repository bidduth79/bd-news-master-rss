      <enclosure url="https://bangladesherkhela.com/uploads/rkr_media/1794413959_6af49587391fc.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_media/1794413959_6af49587391fc.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_media/1794413959_6af49587391fc.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শ্রীলঙ্কার জালে এক হালি গোল, গ্রুপসেরা হয়ে সেমিতে বাংলাদেশ" /&gt;&lt;/p&gt;&lt;p&gt;শ্রীলঙ্কাকে ৪-০ গোলে উড়িয়ে দিয়ে সাফ চ্যাম্পিয়নশিপের গ্রুপ পর্ব শেষ করেছে বাংলাদেশ। দুর্দান্ত এই জয়ে গ্রুপসেরা নিশ্চিত করে সেমিফাইনাল নিশ্চিত করেছে লাল সবুজের প্রতিনিধিরা। বাংলাদেশের হয়ে গোল করেছেন শমিত সোম, হামজা চৌধুরী, ফারহান আলী ও রাকিব হোসেন।বুধবার (১১ নভেম্বর) রাত ৮টায় ঢাকার জাতীয় স্টেডিয়ামে গ্&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B6%E0%A6%B0%E0%A6%B2%E0%A6%99%E0%A6%95%E0%A6%B0-%E0%A6%9C%E0%A6%B2-%E0%A6%8F%E0%A6%95-%E0%A6%B9%E0%A6%B2-%E0%A6%97%E0%A6%B2-%E0%A6%97%E0%A6%B0%E0%A6%AA%E0%A6%B8%E0%A6%B0-%E0%A6%B9%E0%A7%9F-%E0%A6%B8%E0%A6%AE%E0%A6%A4-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6">Education Bangla</source>
    </item>
    <item>
      <title>বোমার আঘাতে হারিয়েছেন দু’পা, ভিনিসিয়ুসের এক বার্তায় বদলে গেল জাহেরের জীবন</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%AE%E0%A6%B0-%E0%A6%86%E0%A6%98%E0%A6%A4-%E0%A6%B9%E0%A6%B0%E0%A7%9F%E0%A6%9B%E0%A6%A8-%E0%A6%A6%E0%A6%AA-%E0%A6%AD%E0%A6%A8%E0%A6%B8%E0%A7%9F%E0%A6%B8%E0%A6%B0-%E0%A6%8F%E0%A6%95-%E0%A6%AC%E0%A6%B0%E0%A6%A4%E0%A7%9F-%E0%A6%AC%E0%A6%A6%E0%A6%B2-%E0%A6%97%E0%A6%B2-%E0%A6%9C%E0%A6%B9%E0%A6%B0%E0%A6%B0-%E0%A6%9C%E0%A6%AC%E0%A6%A8</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%AE%E0%A6%B0-%E0%A6%86%E0%A6%98%E0%A6%A4-%E0%A6%B9%E0%A6%B0%E0%A7%9F%E0%A6%9B%E0%A6%A8-%E0%A6%A6%E0%A6%AA-%E0%A6%AD%E0%A6%A8%E0%A6%B8%E0%A7%9F%E0%A6%B8%E0%A6%B0-%E0%A6%8F%E0%A6%95-%E0%A6%AC%E0%A6%B0%E0%A6%A4%E0%A7%9F-%E0%A6%AC%E0%A6%A6%E0%A6%B2-%E0%A6%97%E0%A6%B2-%E0%A6%9C%E0%A6%B9%E0%A6%B0%E0%A6%B0-%E0%A6%9C%E0%A6%AC%E0%A6%A8</guid>
      <pubDate>Wed, 11 Nov 2026 10:23:29 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794392609_rkr_6af44221625e4.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794392609_rkr_6af44221625e4.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794392609_rkr_6af44221625e4.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বোমার আঘাতে হারিয়েছেন দু’পা, ভিনিসিয়ুসের এক বার্তায় বদলে গেল জাহেরের জীবন" /&gt;&lt;/p&gt;&lt;p&gt;সান্তিয়াগো বার্নাব্যুর ভরা গ্যালারি কিংবা লাখ লাখ টিভি স্ক্রিনে যাকে বিশ্বজুড়ে ফুটপ্রেমীরা দেখে অভ্যস্ত, তিনি রিয়াল মাদ্রিদের &amp;amp;nbsp;তারকা ভিনিসিয়ুস জুনিয়র। তবে সম্প্রতি মিশরের কায়রোর একটি ছোট্ট অন্ধকার ঘরে স্ক্রিনের দিকে অপলক তাকিয়ে ছিল ১৩ বছরের এক কিশোর। পর্দা কেঁপে উঠতেই স্ক্রিনে ভেসে উঠলেন ভ&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%AE%E0%A6%B0-%E0%A6%86%E0%A6%98%E0%A6%A4-%E0%A6%B9%E0%A6%B0%E0%A7%9F%E0%A6%9B%E0%A6%A8-%E0%A6%A6%E0%A6%AA-%E0%A6%AD%E0%A6%A8%E0%A6%B8%E0%A7%9F%E0%A6%B8%E0%A6%B0-%E0%A6%8F%E0%A6%95-%E0%A6%AC%E0%A6%B0%E0%A6%A4%E0%A7%9F-%E0%A6%AC%E0%A6%A6%E0%A6%B2-%E0%A6%97%E0%A6%B2-%E0%A6%9C%E0%A6%B9%E0%A6%B0%E0%A6%B0-%E0%A6%9C%E0%A6%AC%E0%A6%A8">Education Bangla</source>
    </item>
    <item>
      <title>আইপিএল ট্রেডিংয়ে চমক: হার্দিকের ঠিকানা পাঞ্জাব, মুম্বাইয়ে আর্শদীপ</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%87%E0%A6%AA%E0%A6%8F%E0%A6%B2-%E0%A6%9F%E0%A6%B0%E0%A6%A1%E0%A7%9F-%E0%A6%9A%E0%A6%AE%E0%A6%95-%E0%A6%B9%E0%A6%B0%E0%A6%A6%E0%A6%95%E0%A6%B0-%E0%A6%A0%E0%A6%95%E0%A6%A8-%E0%A6%AA%E0%A6%9E%E0%A6%9C%E0%A6%AC-%E0%A6%AE%E0%A6%AE%E0%A6%AC%E0%A6%87%E0%A7%9F-%E0%A6%86%E0%A6%B0%E0%A6%B6%E0%A6%A6%E0%A6%AA</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%87%E0%A6%AA%E0%A6%8F%E0%A6%B2-%E0%A6%9F%E0%A6%B0%E0%A6%A1%E0%A7%9F-%E0%A6%9A%E0%A6%AE%E0%A6%95-%E0%A6%B9%E0%A6%B0%E0%A6%A6%E0%A6%95%E0%A6%B0-%E0%A6%A0%E0%A6%95%E0%A6%A8-%E0%A6%AA%E0%A6%9E%E0%A6%9C%E0%A6%AC-%E0%A6%AE%E0%A6%AE%E0%A6%AC%E0%A6%87%E0%A7%9F-%E0%A6%86%E0%A6%B0%E0%A6%B6%E0%A6%A6%E0%A6%AA</guid>
      <pubDate>Wed, 11 Nov 2026 10:22:14 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794392534_rkr_6af441d64d1a3.jpeg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794392534_rkr_6af441d64d1a3.jpeg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794392534_rkr_6af441d64d1a3.jpeg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আইপিএল ট্রেডিংয়ে চমক: হার্দিকের ঠিকানা পাঞ্জাব, মুম্বাইয়ে আর্শদীপ" /&gt;&lt;/p&gt;&lt;p&gt;ইন্ডিয়ান প্রিমিয়ার লিগের (আইপিএল) নতুন মৌসুমের নিলামের আগেই ফ্র্যাঞ্চাইজি দলবদলে বড় চমক দেখাল মুম্বাই ইন্ডিয়ান্স ও পাঞ্জাব কিংস। খেলোয়াড় অদল-বদল বা ‘ট্রেডিং’ প্রক্রিয়ায় সাবেক অধিনায়ক হার্দিক পান্ডিয়াকে ছেড়ে দিয়েছে মুম্বাই। অন্যদিকে, পাঞ্জাবের বোলিং আক্রমণের অন্যতম প্রধান অস্ত্র বাঁহাতি পেসার আর্শদী&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%87%E0%A6%AA%E0%A6%8F%E0%A6%B2-%E0%A6%9F%E0%A6%B0%E0%A6%A1%E0%A7%9F-%E0%A6%9A%E0%A6%AE%E0%A6%95-%E0%A6%B9%E0%A6%B0%E0%A6%A6%E0%A6%95%E0%A6%B0-%E0%A6%A0%E0%A6%95%E0%A6%A8-%E0%A6%AA%E0%A6%9E%E0%A6%9C%E0%A6%AC-%E0%A6%AE%E0%A6%AE%E0%A6%AC%E0%A6%87%E0%A7%9F-%E0%A6%86%E0%A6%B0%E0%A6%B6%E0%A6%A6%E0%A6%AA">Education Bangla</source>
    </item>
    <item>
      <title>ফুটবল মাঠে সংঘর্ষে স্ট্রাইকারের মৃত্যু, কেমন আছেন সেই গোলরক্ষক?</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AB%E0%A6%9F%E0%A6%AC%E0%A6%B2-%E0%A6%AE%E0%A6%A0-%E0%A6%B8%E0%A6%98%E0%A6%B0%E0%A6%B7-%E0%A6%B8%E0%A6%9F%E0%A6%B0%E0%A6%87%E0%A6%95%E0%A6%B0%E0%A6%B0-%E0%A6%AE%E0%A6%A4%E0%A6%AF-%E0%A6%95%E0%A6%AE%E0%A6%A8-%E0%A6%86%E0%A6%9B%E0%A6%A8-%E0%A6%B8%E0%A6%87-%E0%A6%97%E0%A6%B2%E0%A6%B0%E0%A6%95%E0%A6%B7%E0%A6%95</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AB%E0%A6%9F%E0%A6%AC%E0%A6%B2-%E0%A6%AE%E0%A6%A0-%E0%A6%B8%E0%A6%98%E0%A6%B0%E0%A6%B7-%E0%A6%B8%E0%A6%9F%E0%A6%B0%E0%A6%87%E0%A6%95%E0%A6%B0%E0%A6%B0-%E0%A6%AE%E0%A6%A4%E0%A6%AF-%E0%A6%95%E0%A6%AE%E0%A6%A8-%E0%A6%86%E0%A6%9B%E0%A6%A8-%E0%A6%B8%E0%A6%87-%E0%A6%97%E0%A6%B2%E0%A6%B0%E0%A6%95%E0%A6%B7%E0%A6%95</guid>
      <pubDate>Wed, 11 Nov 2026 10:19:10 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794392350_rkr_6af4411e77a39.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794392350_rkr_6af4411e77a39.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794392350_rkr_6af4411e77a39.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফুটবল মাঠে সংঘর্ষে স্ট্রাইকারের মৃত্যু, কেমন আছেন সেই গোলরক্ষক?" /&gt;&lt;/p&gt;&lt;p&gt;ফুটবল মাঠে হাজারো সংঘর্ষ হয়। কেউ হালকা চোটে মাঠে শুয়ে পড়ে ব্যথায় কুঁকড়ে যান, কেউ আবার উঠে দাঁড়িয়ে দ্রুত খেলা শুরু করেন। গ্যালারিতে ফিরে আসে দর্শকের করতালি আর উল্লাস। কিন্তু কিছু সংঘর্ষ সব সমীকরণ ও খেলার আবহ বদলে দেয়। ম্যাচের বাঁশি চিরতরে থেমে যায়, চারপাশ ঢেকে যায় শোক, অপরাধবোধ আর এক বুক অসহায়ত্বে।সম&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AB%E0%A6%9F%E0%A6%AC%E0%A6%B2-%E0%A6%AE%E0%A6%A0-%E0%A6%B8%E0%A6%98%E0%A6%B0%E0%A6%B7-%E0%A6%B8%E0%A6%9F%E0%A6%B0%E0%A6%87%E0%A6%95%E0%A6%B0%E0%A6%B0-%E0%A6%AE%E0%A6%A4%E0%A6%AF-%E0%A6%95%E0%A6%AE%E0%A6%A8-%E0%A6%86%E0%A6%9B%E0%A6%A8-%E0%A6%B8%E0%A6%87-%E0%A6%97%E0%A6%B2%E0%A6%B0%E0%A6%95%E0%A6%B7%E0%A6%95">Education Bangla</source>
    </item>
    <item>
      <title>খেলোয়াড়দের ‘কমফোর্ট জোন’ ভাঙার মাশুল দিয়েছি: সারোয়ার ইমরান</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%96%E0%A6%B2%E0%A6%AF%E0%A6%A1%E0%A6%A6%E0%A6%B0-%E0%A6%95%E0%A6%AE%E0%A6%AB%E0%A6%B0%E0%A6%9F-%E0%A6%9C%E0%A6%A8-%E0%A6%AD%E0%A6%99%E0%A6%B0-%E0%A6%AE%E0%A6%B6%E0%A6%B2-%E0%A6%A6%E0%A7%9F%E0%A6%9B-%E0%A6%B8%E0%A6%B0%E0%A6%AF%E0%A6%B0-%E0%A6%87%E0%A6%AE%E0%A6%B0%E0%A6%A8</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%96%E0%A6%B2%E0%A6%AF%E0%A6%A1%E0%A6%A6%E0%A6%B0-%E0%A6%95%E0%A6%AE%E0%A6%AB%E0%A6%B0%E0%A6%9F-%E0%A6%9C%E0%A6%A8-%E0%A6%AD%E0%A6%99%E0%A6%B0-%E0%A6%AE%E0%A6%B6%E0%A6%B2-%E0%A6%A6%E0%A7%9F%E0%A6%9B-%E0%A6%B8%E0%A6%B0%E0%A6%AF%E0%A6%B0-%E0%A6%87%E0%A6%AE%E0%A6%B0%E0%A6%A8</guid>
      <pubDate>Wed, 11 Nov 2026 10:18:03 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_media/1794392268_6af440cc93d07.jpeg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_media/1794392268_6af440cc93d07.jpeg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_media/1794392268_6af440cc93d07.jpeg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="খেলোয়াড়দের ‘কমফোর্ট জোন’ ভাঙার মাশুল দিয়েছি: সারোয়ার ইমরান" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ নারী ক্রিকেট দলের সাবেক প্রধান কোচ সারোয়ার ইমরান সম্প্রতি গণমাধ্যমে দেওয়া এক সাক্ষাৎকারে তার বরখাস্তের নেপথ্য কারণ ও দলের ভেতরের নানা অনিয়ম নিয়ে মুখ খুলেছেন। তার মতে, ক্রিকেটারদের তাদের ‘কমফোর্ট জোন’ বা স্বাচ্ছন্দ্যের গণ্ডি থেকে বের করে আনার চেষ্টা করার মাশুলই তাকে চাকরি হারিয়ে দিতে হয়েছে।&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%96%E0%A6%B2%E0%A6%AF%E0%A6%A1%E0%A6%A6%E0%A6%B0-%E0%A6%95%E0%A6%AE%E0%A6%AB%E0%A6%B0%E0%A6%9F-%E0%A6%9C%E0%A6%A8-%E0%A6%AD%E0%A6%99%E0%A6%B0-%E0%A6%AE%E0%A6%B6%E0%A6%B2-%E0%A6%A6%E0%A7%9F%E0%A6%9B-%E0%A6%B8%E0%A6%B0%E0%A6%AF%E0%A6%B0-%E0%A6%87%E0%A6%AE%E0%A6%B0%E0%A6%A8">Education Bangla</source>
    </item>
    <item>
      <title>দুই দশক পর মেসি-রোনালদোবিহীন ফিফা উইন্ডো</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%A6%E0%A6%87-%E0%A6%A6%E0%A6%B6%E0%A6%95-%E0%A6%AA%E0%A6%B0-%E0%A6%AE%E0%A6%B8-%E0%A6%B0%E0%A6%A8%E0%A6%B2%E0%A6%A6%E0%A6%AC%E0%A6%B9%E0%A6%A8-%E0%A6%AB%E0%A6%AB-%E0%A6%89%E0%A6%87%E0%A6%A8%E0%A6%A1</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%A6%E0%A6%87-%E0%A6%A6%E0%A6%B6%E0%A6%95-%E0%A6%AA%E0%A6%B0-%E0%A6%AE%E0%A6%B8-%E0%A6%B0%E0%A6%A8%E0%A6%B2%E0%A6%A6%E0%A6%AC%E0%A6%B9%E0%A6%A8-%E0%A6%AB%E0%A6%AB-%E0%A6%89%E0%A6%87%E0%A6%A8%E0%A6%A1</guid>
      <pubDate>Wed, 11 Nov 2026 10:16:58 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794392218_rkr_6af4409a94b3f.jpeg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794392218_rkr_6af4409a94b3f.jpeg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794392218_rkr_6af4409a94b3f.jpeg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দুই দশক পর মেসি-রোনালদোবিহীন ফিফা উইন্ডো" /&gt;&lt;/p&gt;&lt;p&gt;ফিফা উইন্ডো মানেই গত দুই দশক ধরে ফুটবলপ্রেমীদের কাছে ছিল লিওনেল মেসি কিংবা ক্রিশ্চিয়ানো রোনালদোর দ্যুতি ছড়ানোর সময়। কিন্তু নভেম্বরের এই আন্তর্জাতিক বিরতিতে এসে বিশ্ব ফুটবলে দেখা মিলেছে এক ঐতিহাসিক পরিবর্তনের। দীর্ঘ কুড়ি বছর পর এই প্রথম ফিফা উইন্ডোতে পর্তুগাল কিংবা আর্জেন্টিনা—কোনো দলেই নেই মেসি অথ&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%A6%E0%A6%87-%E0%A6%A6%E0%A6%B6%E0%A6%95-%E0%A6%AA%E0%A6%B0-%E0%A6%AE%E0%A6%B8-%E0%A6%B0%E0%A6%A8%E0%A6%B2%E0%A6%A6%E0%A6%AC%E0%A6%B9%E0%A6%A8-%E0%A6%AB%E0%A6%AB-%E0%A6%89%E0%A6%87%E0%A6%A8%E0%A6%A1">Education Bangla</source>
    </item>
    <item>
      <title>টেস্ট র‌্যাঙ্কিংয়ে রেকর্ড গড়ে তাওহীদের বড় লাফ</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%9F%E0%A6%B8%E0%A6%9F-%E0%A6%B0%E0%A6%AF%E0%A6%99%E0%A6%95%E0%A7%9F-%E0%A6%B0%E0%A6%95%E0%A6%B0%E0%A6%A1-%E0%A6%97%E0%A7%9C-%E0%A6%A4%E0%A6%93%E0%A6%B9%E0%A6%A6%E0%A6%B0-%E0%A6%AC%E0%A7%9C-%E0%A6%B2%E0%A6%AB</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%9F%E0%A6%B8%E0%A6%9F-%E0%A6%B0%E0%A6%AF%E0%A6%99%E0%A6%95%E0%A7%9F-%E0%A6%B0%E0%A6%95%E0%A6%B0%E0%A6%A1-%E0%A6%97%E0%A7%9C-%E0%A6%A4%E0%A6%93%E0%A6%B9%E0%A6%A6%E0%A6%B0-%E0%A6%AC%E0%A7%9C-%E0%A6%B2%E0%A6%AB</guid>
      <pubDate>Wed, 11 Nov 2026 10:15:57 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_media/1794392143_6af4404f11157.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_media/1794392143_6af4404f11157.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_media/1794392143_6af4404f11157.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টেস্ট র‌্যাঙ্কিংয়ে রেকর্ড গড়ে তাওহীদের বড় লাফ" /&gt;&lt;/p&gt;&lt;p&gt;সিলেটে বাংলাদেশ ও ওয়েস্ট ইন্ডিজের মধ্যকার দুই ম্যাচের আইসিসি বিশ্ব টেস্ট চ্যাম্পিয়নশিপ সিরিজের দ্বিতীয় ম্যাচটি ড্র হয়েছে। তাতে প্রথম টেস্টে ৮ উইকেটের জয়ের সুবাদে সিরিজ নিজেদের করে নিয়েছে সফরকারীরা।তবে সিরিজে ব্যক্তিগত পারফরম্যান্সে বড় চমক দেখিয়েছেন বাংলাদেশের ব্যাটার তাওহীদ হৃদয়। জাতীয় রেকর্ড গড়ে টে&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%9F%E0%A6%B8%E0%A6%9F-%E0%A6%B0%E0%A6%AF%E0%A6%99%E0%A6%95%E0%A7%9F-%E0%A6%B0%E0%A6%95%E0%A6%B0%E0%A6%A1-%E0%A6%97%E0%A7%9C-%E0%A6%A4%E0%A6%93%E0%A6%B9%E0%A6%A6%E0%A6%B0-%E0%A6%AC%E0%A7%9C-%E0%A6%B2%E0%A6%AB">Education Bangla</source>
    </item>
    <item>
      <title>‘ব্যালন ডি’অরের হতাশা কাটিয়ে উঠেছেন এমবাপে’</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%AF%E0%A6%B2%E0%A6%A8-%E0%A6%A1%E0%A6%85%E0%A6%B0%E0%A6%B0-%E0%A6%B9%E0%A6%A4%E0%A6%B6-%E0%A6%95%E0%A6%9F%E0%A7%9F-%E0%A6%89%E0%A6%A0%E0%A6%9B%E0%A6%A8-%E0%A6%8F%E0%A6%AE%E0%A6%AC%E0%A6%AA</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%AF%E0%A6%B2%E0%A6%A8-%E0%A6%A1%E0%A6%85%E0%A6%B0%E0%A6%B0-%E0%A6%B9%E0%A6%A4%E0%A6%B6-%E0%A6%95%E0%A6%9F%E0%A7%9F-%E0%A6%89%E0%A6%A0%E0%A6%9B%E0%A6%A8-%E0%A6%8F%E0%A6%AE%E0%A6%AC%E0%A6%AA</guid>
      <pubDate>Tue, 10 Nov 2026 16:23:27 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794327807_rkr_6af344ffb36e0.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794327807_rkr_6af344ffb36e0.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794327807_rkr_6af344ffb36e0.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘ব্যালন ডি’অরের হতাশা কাটিয়ে উঠেছেন এমবাপে’" /&gt;&lt;/p&gt;&lt;p&gt;ব্যালন ডি’অর জিততে না পারার হতাশা এবং চীনে বিতর্কিত মন্তব্যের জেরে সমালোচনা—সবকিছু পেছনে ফেলে স্বাভাবিক ছন্দে ফিরেছেন কিলিয়ান এমবাপে। ফ্রান্স ও রিয়াল মাদ্রিদে তার সতীর্থ ইব্রাহিমা কোনাতে জানিয়েছেন, এমবাপে এখন বেশ ভালো মানসিক অবস্থায় আছেন।এবারের ব্যালন ডি’অর ভোটে ইংল্যান্ডের হ্যারি কেইনের কাছে হেরে দ&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%AF%E0%A6%B2%E0%A6%A8-%E0%A6%A1%E0%A6%85%E0%A6%B0%E0%A6%B0-%E0%A6%B9%E0%A6%A4%E0%A6%B6-%E0%A6%95%E0%A6%9F%E0%A7%9F-%E0%A6%89%E0%A6%A0%E0%A6%9B%E0%A6%A8-%E0%A6%8F%E0%A6%AE%E0%A6%AC%E0%A6%AA">Education Bangla</source>
    </item>
    <item>
      <title>হাঁটুর চোটে ছিটকে গেলেন ইয়ামাল</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B9%E0%A6%9F%E0%A6%B0-%E0%A6%9A%E0%A6%9F-%E0%A6%9B%E0%A6%9F%E0%A6%95-%E0%A6%97%E0%A6%B2%E0%A6%A8-%E0%A6%87%E0%A7%9F%E0%A6%AE%E0%A6%B2</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%B9%E0%A6%9F%E0%A6%B0-%E0%A6%9A%E0%A6%9F-%E0%A6%9B%E0%A6%9F%E0%A6%95-%E0%A6%97%E0%A6%B2%E0%A6%A8-%E0%A6%87%E0%A7%9F%E0%A6%AE%E0%A6%B2</guid>
      <pubDate>Tue, 10 Nov 2026 16:22:34 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794327754_rkr_6af344ca87a88.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794327754_rkr_6af344ca87a88.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794327754_rkr_6af344ca87a88.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হাঁটুর চোটে ছিটকে গেলেন ইয়ামাল" /&gt;&lt;/p&gt;&lt;p&gt;হাঁটুর চোটের কারণে বৃহস্পতিবার চেক প্রজাতন্ত্রের বিপক্ষে স্পেনের নেশন্স লিগের ম্যাচে খেলতে পারবেন না বার্সেলোনার তরুণ ফরোয়ার্ড লামিন ইয়ামাল। সোমবার বিষয়টি নিশ্চিত করেছে স্প্যানিশ ফুটবল ফেডারেশন (আরএফইএফ)।রোববার লা লিগায় অ্যাথলেটিকো মাদ্রিদের মাঠে বার্সেলোনার ২-১ গোলের জয়ের ম্যাচে ডান হাঁটুতে চোট পান&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B9%E0%A6%9F%E0%A6%B0-%E0%A6%9A%E0%A6%9F-%E0%A6%9B%E0%A6%9F%E0%A6%95-%E0%A6%97%E0%A6%B2%E0%A6%A8-%E0%A6%87%E0%A7%9F%E0%A6%AE%E0%A6%B2">Education Bangla</source>
    </item>
    <item>
      <title>আবাহনীর হারুন, আবাহনীতেই ক্রীড়াঙ্গনের শেষ শ্রদ্ধা</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%AC%E0%A6%B9%E0%A6%A8%E0%A6%B0-%E0%A6%B9%E0%A6%B0%E0%A6%A8-%E0%A6%86%E0%A6%AC%E0%A6%B9%E0%A6%A8%E0%A6%A4%E0%A6%87-%E0%A6%95%E0%A6%B0%E0%A7%9C%E0%A6%99%E0%A6%97%E0%A6%A8%E0%A6%B0-%E0%A6%B6%E0%A6%B7-%E0%A6%B6%E0%A6%B0%E0%A6%A6%E0%A6%A7</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%AC%E0%A6%B9%E0%A6%A8%E0%A6%B0-%E0%A6%B9%E0%A6%B0%E0%A6%A8-%E0%A6%86%E0%A6%AC%E0%A6%B9%E0%A6%A8%E0%A6%A4%E0%A6%87-%E0%A6%95%E0%A6%B0%E0%A7%9C%E0%A6%99%E0%A6%97%E0%A6%A8%E0%A6%B0-%E0%A6%B6%E0%A6%B7-%E0%A6%B6%E0%A6%B0%E0%A6%A6%E0%A6%A7</guid>
      <pubDate>Tue, 10 Nov 2026 16:20:54 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794327654_rkr_6af344669959f.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794327654_rkr_6af344669959f.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794327654_rkr_6af344669959f.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আবাহনীর হারুন, আবাহনীতেই ক্রীড়াঙ্গনের শেষ শ্রদ্ধা" /&gt;&lt;/p&gt;&lt;p&gt;আবাহনী ক্লাবের আঙিনায় হারুনুর রশীদের কেটেছে জীবনের অনেকটা সময়। আজ তার হাতে গড়া সেই আবাহনী ক্লাবেই আসলেন শেষ বারের মতো নিথর দেহে। আবাহনীর সাবেক খেলোয়াড়, কোচ, কর্মকর্তাসহ ক্রীড়াঙ্গনের অনেকেই এসেছিলেন দেশের ক্রীড়াঙ্গনের বিশিষ্ট ক্রীড়াসংগঠক হারুনুর রশীদকে শেষ শ্রদ্ধা জানাতে।আবাহনীর বর্ষীয়ান ফুটবলার শেখ.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%AC%E0%A6%B9%E0%A6%A8%E0%A6%B0-%E0%A6%B9%E0%A6%B0%E0%A6%A8-%E0%A6%86%E0%A6%AC%E0%A6%B9%E0%A6%A8%E0%A6%A4%E0%A6%87-%E0%A6%95%E0%A6%B0%E0%A7%9C%E0%A6%99%E0%A6%97%E0%A6%A8%E0%A6%B0-%E0%A6%B6%E0%A6%B7-%E0%A6%B6%E0%A6%B0%E0%A6%A6%E0%A6%A7">Education Bangla</source>
    </item>
    <item>
      <title>শ্রীলঙ্কা ম্যাচের আগে দুঃসংবাদ পেল বাংলাদেশ</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B6%E0%A6%B0%E0%A6%B2%E0%A6%99%E0%A6%95-%E0%A6%AE%E0%A6%AF%E0%A6%9A%E0%A6%B0-%E0%A6%86%E0%A6%97-%E0%A6%A6%E0%A6%B8%E0%A6%AC%E0%A6%A6-%E0%A6%AA%E0%A6%B2-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%B6%E0%A6%B0%E0%A6%B2%E0%A6%99%E0%A6%95-%E0%A6%AE%E0%A6%AF%E0%A6%9A%E0%A6%B0-%E0%A6%86%E0%A6%97-%E0%A6%A6%E0%A6%B8%E0%A6%AC%E0%A6%A6-%E0%A6%AA%E0%A6%B2-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6</guid>
      <pubDate>Tue, 10 Nov 2026 16:19:27 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_media/1794327483_6af343bb1e1eb.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_media/1794327483_6af343bb1e1eb.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_media/1794327483_6af343bb1e1eb.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শ্রীলঙ্কা ম্যাচের আগে দুঃসংবাদ পেল বাংলাদেশ" /&gt;&lt;/p&gt;&lt;p&gt;সাফ চ্যাম্পিয়নশিপ শুরুর আগে থেকেই বাংলাদেশ স্কোয়াড ইনজুরিতে ভুগছিল। প্রবাসী ফুটবলার রোনান সুলিভান চোটের জন্য আমেরিকা থেকে বাংলাদেশেই আসতে পারেননি। ভুটান ম্যাচে ইনজুরির জন্য একাদশ ঘোষণার পরও খেলতে পারেননি তপু বর্মণ। এবার ইনজুরির থাবায় পড়েছেন বিশ্বনাথ ঘোষ।গতকাল (সোমবার) অনুশীলনে বিশ্বনাথ ইনজুরিতে পড়েন&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B6%E0%A6%B0%E0%A6%B2%E0%A6%99%E0%A6%95-%E0%A6%AE%E0%A6%AF%E0%A6%9A%E0%A6%B0-%E0%A6%86%E0%A6%97-%E0%A6%A6%E0%A6%B8%E0%A6%AC%E0%A6%A6-%E0%A6%AA%E0%A6%B2-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6">Education Bangla</source>
    </item>
    <item>
      <title>আধুনিক হচ্ছে দেশের ৫১টি জেলা স্টেডিয়াম</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%A7%E0%A6%A8%E0%A6%95-%E0%A6%B9%E0%A6%9A%E0%A6%9B-%E0%A6%A6%E0%A6%B6%E0%A6%B0-%E0%A7%AB%E0%A7%A7%E0%A6%9F-%E0%A6%9C%E0%A6%B2-%E0%A6%B8%E0%A6%9F%E0%A6%A1%E0%A7%9F%E0%A6%AE</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%A7%E0%A6%A8%E0%A6%95-%E0%A6%B9%E0%A6%9A%E0%A6%9B-%E0%A6%A6%E0%A6%B6%E0%A6%B0-%E0%A7%AB%E0%A7%A7%E0%A6%9F-%E0%A6%9C%E0%A6%B2-%E0%A6%B8%E0%A6%9F%E0%A6%A1%E0%A7%9F%E0%A6%AE</guid>

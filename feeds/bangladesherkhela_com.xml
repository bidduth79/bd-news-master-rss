    <item>
      <title>সেমিফাইনালে মুখোমুখি বাংলাদেশ-পাকিস্তান</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%AE%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2-%E0%A6%AE%E0%A6%96%E0%A6%AE%E0%A6%96-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6-%E0%A6%AA%E0%A6%95%E0%A6%B8%E0%A6%A4%E0%A6%A8</link>

      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795792750_rkr_6b099f6e0806d.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পার্থ টেস্টে থাকছেন না লায়ন, অনিশ্চয়তায় ক্যারিয়ার" /&gt;&lt;/p&gt;&lt;p&gt;টানা এক যুগ ধরে ফিট থাকলে অস্ট্রেলিয়ার প্রথম পছন্দের স্পিনার হিসেবে যার জায়গা ছিল প্রায় অবধারিত, সেই নাথান লায়নই এবার বাদ পড়ছেন নিউজিল্যান্ডের বিপক্ষে প্রথম টেস্টের স্কোয়াড থেকে। আর এই সিদ্ধান্ত ৩৯ বছর বয়সী এই অফস্পিনারের টেস্ট ভবিষ্যৎ ঘিরে তুলে দিয়েছে বড় প্রশ্নচিহ্ন।আগামী ৯ ডিসেম্বর পার্থে শুরু হতে&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AA%E0%A6%B0%E0%A6%A5-%E0%A6%9F%E0%A6%B8%E0%A6%9F-%E0%A6%A5%E0%A6%95%E0%A6%9B%E0%A6%A8-%E0%A6%A8-%E0%A6%B2%E0%A7%9F%E0%A6%A8-%E0%A6%85%E0%A6%A8%E0%A6%B6%E0%A6%9A%E0%A7%9F%E0%A6%A4%E0%A7%9F-%E0%A6%95%E0%A6%AF%E0%A6%B0%E0%A7%9F%E0%A6%B0">Education Bangla</source>

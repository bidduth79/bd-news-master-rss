    <item>
      <title>এএফএর সঙ্গে সম্পর্ক ছিন্ন করছেন মেসি</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%8F%E0%A6%8F%E0%A6%AB%E0%A6%8F%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A6%97-%E0%A6%B8%E0%A6%AE%E0%A6%AA%E0%A6%B0%E0%A6%95-%E0%A6%9B%E0%A6%A8%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A6%9B%E0%A6%A8-%E0%A6%AE%E0%A6%B8</link>

    <item>
      <title>অভিষেকের পর টানা ছয় হার, তলানিতে চট্টগ্রাম সিটি</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%85%E0%A6%AD%E0%A6%B7%E0%A6%95%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%9F%E0%A6%A8-%E0%A6%9B%E0%A7%9F-%E0%A6%B9%E0%A6%B0-%E0%A6%A4%E0%A6%B2%E0%A6%A8%E0%A6%A4-%E0%A6%9A%E0%A6%9F%E0%A6%9F%E0%A6%97%E0%A6%B0%E0%A6%AE-%E0%A6%B8%E0%A6%9F</link>

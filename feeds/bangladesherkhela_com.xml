    <item>
      <title>সাইবার হামলার শিকার ফিফা, চুরি হয়েছে ব্যক্তিগত ও ব্যবসায়িক তথ্য</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%87%E0%A6%AC%E0%A6%B0-%E0%A6%B9%E0%A6%AE%E0%A6%B2%E0%A6%B0-%E0%A6%B6%E0%A6%95%E0%A6%B0-%E0%A6%AB%E0%A6%AB-%E0%A6%9A%E0%A6%B0-%E0%A6%B9%E0%A7%9F%E0%A6%9B-%E0%A6%AC%E0%A6%AF%E0%A6%95%E0%A6%A4%E0%A6%97%E0%A6%A4-%E0%A6%93-%E0%A6%AC%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A7%9F%E0%A6%95-%E0%A6%A4%E0%A6%A5%E0%A6%AF</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%87%E0%A6%AC%E0%A6%B0-%E0%A6%B9%E0%A6%AE%E0%A6%B2%E0%A6%B0-%E0%A6%B6%E0%A6%95%E0%A6%B0-%E0%A6%AB%E0%A6%AB-%E0%A6%9A%E0%A6%B0-%E0%A6%B9%E0%A7%9F%E0%A6%9B-%E0%A6%AC%E0%A6%AF%E0%A6%95%E0%A6%A4%E0%A6%97%E0%A6%A4-%E0%A6%93-%E0%A6%AC%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A7%9F%E0%A6%95-%E0%A6%A4%E0%A6%A5%E0%A6%AF</guid>
      <pubDate>Thu, 26 Nov 2026 16:07:50 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795709270_rkr_6b08595632f68.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795709270_rkr_6b08595632f68.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795709270_rkr_6b08595632f68.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাইবার হামলার শিকার ফিফা, চুরি হয়েছে ব্যক্তিগত ও ব্যবসায়িক তথ্য" /&gt;&lt;/p&gt;&lt;p&gt;সাইবার হামলার শিকার হয়েছে বিশ্ব ফুটবলের নিয়ন্ত্রক সংস্থা ফিফা। এ ঘটনায় সংস্থাটির ব্যক্তিগত ও ব্যবসায়িক তথ্যের একটি সীমিত অংশে অবৈধ প্রবেশের ঘটনা ঘটেছে। তবে পরিত্যক্ত ‘ফিফা ফরোয়ার্ড এন্টারপ্রাইজ’ প্রকল্পের কোনো ফাইল এই হামলায় হাতিয়ে নেয়া হয়নি বলে বিভিন্ন গণমাধ্যমের প্রতিবেদনে উল্লেখ করা হয়েছে।ফিফার এ&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%87%E0%A6%AC%E0%A6%B0-%E0%A6%B9%E0%A6%AE%E0%A6%B2%E0%A6%B0-%E0%A6%B6%E0%A6%95%E0%A6%B0-%E0%A6%AB%E0%A6%AB-%E0%A6%9A%E0%A6%B0-%E0%A6%B9%E0%A7%9F%E0%A6%9B-%E0%A6%AC%E0%A6%AF%E0%A6%95%E0%A6%A4%E0%A6%97%E0%A6%A4-%E0%A6%93-%E0%A6%AC%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A7%9F%E0%A6%95-%E0%A6%A4%E0%A6%A5%E0%A6%AF">Education Bangla</source>
    </item>
    <item>
      <title>দলের ফুটবলারদের নতুন গাড়ি দিলো রিয়াল মাদ্রিদ</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%A6%E0%A6%B2%E0%A6%B0-%E0%A6%AB%E0%A6%9F%E0%A6%AC%E0%A6%B2%E0%A6%B0%E0%A6%A6%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A6%A8-%E0%A6%97%E0%A7%9C-%E0%A6%A6%E0%A6%B2-%E0%A6%B0%E0%A7%9F%E0%A6%B2-%E0%A6%AE%E0%A6%A6%E0%A6%B0%E0%A6%A6</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%A6%E0%A6%B2%E0%A6%B0-%E0%A6%AB%E0%A6%9F%E0%A6%AC%E0%A6%B2%E0%A6%B0%E0%A6%A6%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A6%A8-%E0%A6%97%E0%A7%9C-%E0%A6%A6%E0%A6%B2-%E0%A6%B0%E0%A7%9F%E0%A6%B2-%E0%A6%AE%E0%A6%A6%E0%A6%B0%E0%A6%A6</guid>
      <pubDate>Thu, 26 Nov 2026 16:06:55 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795709215_rkr_6b08591f9c855.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795709215_rkr_6b08591f9c855.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795709215_rkr_6b08591f9c855.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দলের ফুটবলারদের নতুন গাড়ি দিলো রিয়াল মাদ্রিদ" /&gt;&lt;/p&gt;&lt;p&gt;বিলাসবহুল গাড়ির বহরে নতুন সংযোজন আনল রিয়াল মাদ্রিদ। ক্লাবের প্রথম দলের ফুটবলার ও কোচিং স্টাফদের হাতে নতুন বিএমডব্লিউ গাড়ি তুলে দেয়া হয়েছে। সান্তিয়াগো বার্নাব্যুতে আয়োজিত এক অনুষ্ঠানে আনুষ্ঠানিকভাবে গাড়িগুলো হস্তান্তর করা হয়। খবর এএস স্পোর্টসের।বিএমডব্লিউর সঙ্গে রিয়াল মাদ্রিদের অংশীদারত্বের এটি পঞ্চম&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%A6%E0%A6%B2%E0%A6%B0-%E0%A6%AB%E0%A6%9F%E0%A6%AC%E0%A6%B2%E0%A6%B0%E0%A6%A6%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A6%A8-%E0%A6%97%E0%A7%9C-%E0%A6%A6%E0%A6%B2-%E0%A6%B0%E0%A7%9F%E0%A6%B2-%E0%A6%AE%E0%A6%A6%E0%A6%B0%E0%A6%A6">Education Bangla</source>
    </item>
    <item>
      <title>১৭তম সিআইএসএম ওয়ার্ল্ড মিলিটারি গলফ চ্যাম্পিয়শীপ শুরু হচ্ছে</title>
      <link>https://bangladesherkhela.com/news/%E0%A7%A7%E0%A7%AD%E0%A6%A4%E0%A6%AE-%E0%A6%B8%E0%A6%86%E0%A6%87%E0%A6%8F%E0%A6%B8%E0%A6%8F%E0%A6%AE-%E0%A6%93%E0%A7%9F%E0%A6%B0%E0%A6%B2%E0%A6%A1-%E0%A6%AE%E0%A6%B2%E0%A6%9F%E0%A6%B0-%E0%A6%97%E0%A6%B2%E0%A6%AB-%E0%A6%9A%E0%A6%AF%E0%A6%AE%E0%A6%AA%E0%A7%9F%E0%A6%B6%E0%A6%AA-%E0%A6%B6%E0%A6%B0-%E0%A6%B9%E0%A6%9A%E0%A6%9B</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A7%A7%E0%A7%AD%E0%A6%A4%E0%A6%AE-%E0%A6%B8%E0%A6%86%E0%A6%87%E0%A6%8F%E0%A6%B8%E0%A6%8F%E0%A6%AE-%E0%A6%93%E0%A7%9F%E0%A6%B0%E0%A6%B2%E0%A6%A1-%E0%A6%AE%E0%A6%B2%E0%A6%9F%E0%A6%B0-%E0%A6%97%E0%A6%B2%E0%A6%AB-%E0%A6%9A%E0%A6%AF%E0%A6%AE%E0%A6%AA%E0%A7%9F%E0%A6%B6%E0%A6%AA-%E0%A6%B6%E0%A6%B0-%E0%A6%B9%E0%A6%9A%E0%A6%9B</guid>
      <pubDate>Thu, 26 Nov 2026 16:01:19 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795708879_rkr_6b0857cf23ba8.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795708879_rkr_6b0857cf23ba8.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795708879_rkr_6b0857cf23ba8.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="১৭তম সিআইএসএম ওয়ার্ল্ড মিলিটারি গলফ চ্যাম্পিয়শীপ শুরু হচ্ছে" /&gt;&lt;/p&gt;&lt;p&gt;বিশ্ব সামরিক ক্রীডাঙ্গনের অন্যতম মর্যাদাপূর্ণ আসর &amp;#039;১৭তম সিআইএসএম ওয়ার্ল্ড মিলিটারি গলফ চ্যাম্পিয়নশীপের স্বাগতিক দেশ হতে যাচ্ছে বাংলাদেশ। আন্তর্জাতিক সামরিক ক্রীড়া সংস্থা ইন্টারন্যাশনাল মিলিটারি স্পোর্টস কাউন্সিল (সিআইএসএম)-এর উদ্যোগে এবং বাংলাদেশ সশস্ত্র বাহিনী বিভাগের সার্বিক তত্ত্বাবধানে আগাম&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A7%A7%E0%A7%AD%E0%A6%A4%E0%A6%AE-%E0%A6%B8%E0%A6%86%E0%A6%87%E0%A6%8F%E0%A6%B8%E0%A6%8F%E0%A6%AE-%E0%A6%93%E0%A7%9F%E0%A6%B0%E0%A6%B2%E0%A6%A1-%E0%A6%AE%E0%A6%B2%E0%A6%9F%E0%A6%B0-%E0%A6%97%E0%A6%B2%E0%A6%AB-%E0%A6%9A%E0%A6%AF%E0%A6%AE%E0%A6%AA%E0%A7%9F%E0%A6%B6%E0%A6%AA-%E0%A6%B6%E0%A6%B0-%E0%A6%B9%E0%A6%9A%E0%A6%9B">Education Bangla</source>
    </item>
    <item>
      <title>অস্ট্রেলিয়ান ওপেন থেকে ছিটকে গেলেন দুইবারের চ্যাম্পিয়ন সিনার</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%85%E0%A6%B8%E0%A6%9F%E0%A6%B0%E0%A6%B2%E0%A7%9F%E0%A6%A8-%E0%A6%93%E0%A6%AA%E0%A6%A8-%E0%A6%A5%E0%A6%95-%E0%A6%9B%E0%A6%9F%E0%A6%95-%E0%A6%97%E0%A6%B2%E0%A6%A8-%E0%A6%A6%E0%A6%87%E0%A6%AC%E0%A6%B0%E0%A6%B0-%E0%A6%9A%E0%A6%AF%E0%A6%AE%E0%A6%AA%E0%A7%9F%E0%A6%A8-%E0%A6%B8%E0%A6%A8%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%85%E0%A6%B8%E0%A6%9F%E0%A6%B0%E0%A6%B2%E0%A7%9F%E0%A6%A8-%E0%A6%93%E0%A6%AA%E0%A6%A8-%E0%A6%A5%E0%A6%95-%E0%A6%9B%E0%A6%9F%E0%A6%95-%E0%A6%97%E0%A6%B2%E0%A6%A8-%E0%A6%A6%E0%A6%87%E0%A6%AC%E0%A6%B0%E0%A6%B0-%E0%A6%9A%E0%A6%AF%E0%A6%AE%E0%A6%AA%E0%A7%9F%E0%A6%A8-%E0%A6%B8%E0%A6%A8%E0%A6%B0</guid>
      <pubDate>Thu, 26 Nov 2026 15:59:20 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795708760_rkr_6b08575863d36.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795708760_rkr_6b08575863d36.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795708760_rkr_6b08575863d36.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অস্ট্রেলিয়ান ওপেন থেকে ছিটকে গেলেন দুইবারের চ্যাম্পিয়ন সিনার" /&gt;&lt;/p&gt;&lt;p&gt;ডান হাঁটুতে অস্ত্রোপচারের পর পুনর্বাসন প্রক্রিয়ায় থাকায় আগামী জানুয়ারিতে অস্ট্রেলিয়ান ওপেনে খেলতে পারবেন না বিশ্ব র‌্যাঙ্কিংয়ের দুই নম্বর খেলোয়াড় ইয়ানিক সিনার।ইতালির এই টেনিস তারকা ২০২৪ ও ২০২৫ সালে মৌসুমের প্রথম গ্র্যান্ড স্ল্যাম জিতেছিলেন। চলতি সপ্তাহে তিনি জানান, ফিনল্যান্ডের একটি ক্লিনিকে তাঁর অস&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%85%E0%A6%B8%E0%A6%9F%E0%A6%B0%E0%A6%B2%E0%A7%9F%E0%A6%A8-%E0%A6%93%E0%A6%AA%E0%A6%A8-%E0%A6%A5%E0%A6%95-%E0%A6%9B%E0%A6%9F%E0%A6%95-%E0%A6%97%E0%A6%B2%E0%A6%A8-%E0%A6%A6%E0%A6%87%E0%A6%AC%E0%A6%B0%E0%A6%B0-%E0%A6%9A%E0%A6%AF%E0%A6%AE%E0%A6%AA%E0%A7%9F%E0%A6%A8-%E0%A6%B8%E0%A6%A8%E0%A6%B0">Education Bangla</source>
    </item>
    <item>
      <title>দ্বিতীয় টেস্টের আগে অপ্রত্যাশিত এক ম্যাচ খেললেন পান্ত</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%A6%E0%A6%AC%E0%A6%A4%E0%A7%9F-%E0%A6%9F%E0%A6%B8%E0%A6%9F%E0%A6%B0-%E0%A6%86%E0%A6%97-%E0%A6%85%E0%A6%AA%E0%A6%B0%E0%A6%A4%E0%A6%AF%E0%A6%B6%E0%A6%A4-%E0%A6%8F%E0%A6%95-%E0%A6%AE%E0%A6%AF%E0%A6%9A-%E0%A6%96%E0%A6%B2%E0%A6%B2%E0%A6%A8-%E0%A6%AA%E0%A6%A8%E0%A6%A4</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%A6%E0%A6%AC%E0%A6%A4%E0%A7%9F-%E0%A6%9F%E0%A6%B8%E0%A6%9F%E0%A6%B0-%E0%A6%86%E0%A6%97-%E0%A6%85%E0%A6%AA%E0%A6%B0%E0%A6%A4%E0%A6%AF%E0%A6%B6%E0%A6%A4-%E0%A6%8F%E0%A6%95-%E0%A6%AE%E0%A6%AF%E0%A6%9A-%E0%A6%96%E0%A6%B2%E0%A6%B2%E0%A6%A8-%E0%A6%AA%E0%A6%A8%E0%A6%A4</guid>
      <pubDate>Thu, 26 Nov 2026 15:57:53 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795708673_rkr_6b085701c2afa.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795708673_rkr_6b085701c2afa.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795708673_rkr_6b085701c2afa.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দ্বিতীয় টেস্টের আগে অপ্রত্যাশিত এক ম্যাচ খেললেন পান্ত" /&gt;&lt;/p&gt;&lt;p&gt;শুক্রবার থেকে শুরু হতে যাওয়া নিউজিল্যান্ডের বিপক্ষে দ্বিতীয় টেস্টের আগে ব্যাটিংয়ের ধার শাণিয়ে নিতে এক অপ্রত্যাশিত জায়গায় হাজির হয়েছিলেন ভারতের তারকা উইকেটকিপার-ব্যাটার ঋষভ পান্ত। ক্রাইস্টচার্চে সামাজিক ক্রিকেটের একটি ‘লাস্ট ম্যান স্ট্যান্ডস’ ম্যাচে খেলেছেন তিনি।২৯ বছর বয়সী পান্ত টেস্ট ক্রিকেটের ইতিহ&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%A6%E0%A6%AC%E0%A6%A4%E0%A7%9F-%E0%A6%9F%E0%A6%B8%E0%A6%9F%E0%A6%B0-%E0%A6%86%E0%A6%97-%E0%A6%85%E0%A6%AA%E0%A6%B0%E0%A6%A4%E0%A6%AF%E0%A6%B6%E0%A6%A4-%E0%A6%8F%E0%A6%95-%E0%A6%AE%E0%A6%AF%E0%A6%9A-%E0%A6%96%E0%A6%B2%E0%A6%B2%E0%A6%A8-%E0%A6%AA%E0%A6%A8%E0%A6%A4">Education Bangla</source>
    </item>
    <item>

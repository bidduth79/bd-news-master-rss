    <item>
      <title>থাকছেন না ট্রাভিস হেড, ভাঙছে হায়দরাবাদের ‘ট্রাভিশেক’ জুটি</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%A5%E0%A6%95%E0%A6%9B%E0%A6%A8-%E0%A6%A8-%E0%A6%9F%E0%A6%B0%E0%A6%AD%E0%A6%B8-%E0%A6%B9%E0%A6%A1-%E0%A6%AD%E0%A6%99%E0%A6%9B-%E0%A6%B9%E0%A7%9F%E0%A6%A6%E0%A6%B0%E0%A6%AC%E0%A6%A6%E0%A6%B0-%E0%A6%9F%E0%A6%B0%E0%A6%AD%E0%A6%B6%E0%A6%95-%E0%A6%9C%E0%A6%9F</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%A5%E0%A6%95%E0%A6%9B%E0%A6%A8-%E0%A6%A8-%E0%A6%9F%E0%A6%B0%E0%A6%AD%E0%A6%B8-%E0%A6%B9%E0%A6%A1-%E0%A6%AD%E0%A6%99%E0%A6%9B-%E0%A6%B9%E0%A7%9F%E0%A6%A6%E0%A6%B0%E0%A6%AC%E0%A6%A6%E0%A6%B0-%E0%A6%9F%E0%A6%B0%E0%A6%AD%E0%A6%B6%E0%A6%95-%E0%A6%9C%E0%A6%9F</guid>
      <pubDate>Tue, 17 Nov 2026 06:44:40 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794897880_rkr_6afbf7d8372f7.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794897880_rkr_6afbf7d8372f7.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794897880_rkr_6afbf7d8372f7.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="থাকছেন না ট্রাভিস হেড, ভাঙছে হায়দরাবাদের ‘ট্রাভিশেক’ জুটি" /&gt;&lt;/p&gt;&lt;p&gt;আসন্ন ২০২৭ সালের আইপিএল আসরে আর দেখা যাবে না সানরাইজার্স হায়দরাবাদের (এসআরএইচ) বিধ্বংসী ওপেনিং জুটি ‘ট্রাভিশেক’। আন্তর্জাতিক ক্রিকেটের ব্যস্ত সূচিতে কাজের চাপ কমাতে আগামী মৌসুম থেকে নিজেকে সরিয়ে নেয়ার সিদ্ধান্ত নিয়েছেন অস্ট্রেলিয়ান ওপেনার ট্রাভিস হেড। ক্রিকইনফোর এক প্রতিবেদনে বলা হয়েছে, ইতিমধ্যে নিজ&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%A5%E0%A6%95%E0%A6%9B%E0%A6%A8-%E0%A6%A8-%E0%A6%9F%E0%A6%B0%E0%A6%AD%E0%A6%B8-%E0%A6%B9%E0%A6%A1-%E0%A6%AD%E0%A6%99%E0%A6%9B-%E0%A6%B9%E0%A7%9F%E0%A6%A6%E0%A6%B0%E0%A6%AC%E0%A6%A6%E0%A6%B0-%E0%A6%9F%E0%A6%B0%E0%A6%AD%E0%A6%B6%E0%A6%95-%E0%A6%9C%E0%A6%9F">Education Bangla</source>
    </item>
    <item>
      <title>কোস্টারিকার বিপক্ষে খেলবেন মার্তিনেজ</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%95%E0%A6%B8%E0%A6%9F%E0%A6%B0%E0%A6%95%E0%A6%B0-%E0%A6%AC%E0%A6%AA%E0%A6%95%E0%A6%B7-%E0%A6%96%E0%A6%B2%E0%A6%AC%E0%A6%A8-%E0%A6%AE%E0%A6%B0%E0%A6%A4%E0%A6%A8%E0%A6%9C</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%95%E0%A6%B8%E0%A6%9F%E0%A6%B0%E0%A6%95%E0%A6%B0-%E0%A6%AC%E0%A6%AA%E0%A6%95%E0%A6%B7-%E0%A6%96%E0%A6%B2%E0%A6%AC%E0%A6%A8-%E0%A6%AE%E0%A6%B0%E0%A6%A4%E0%A6%A8%E0%A6%9C</guid>
      <pubDate>Tue, 17 Nov 2026 06:37:29 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794897449_rkr_6afbf629af219.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794897449_rkr_6afbf629af219.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794897449_rkr_6afbf629af219.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কোস্টারিকার বিপক্ষে খেলবেন মার্তিনেজ" /&gt;&lt;/p&gt;&lt;p&gt;আর্জেন্টিনা জাতীয় দলকে ঘিরে নতুন করে উন্মাদনা শুরু হয়েছে সমর্থকদের মধ্যে। চলতি ফিফা আন্তর্জাতিক বিরতিতে নিজেদের দ্বিতীয় প্রীতি ম্যাচে বাংলাদেশ সময় বুধবার (১৮ নভেম্বর) ভোর পাঁচটায় কর্দোবার মারিও আলবের্তো কেম্পেস স্টেডিয়ামে কোস্টারিকার মুখোমুখি হবে সাবেক বিশ্বচ্যাম্পিয়নরা। উরুগুয়ের কাছে লা বোমবোনেরায়.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%95%E0%A6%B8%E0%A6%9F%E0%A6%B0%E0%A6%95%E0%A6%B0-%E0%A6%AC%E0%A6%AA%E0%A6%95%E0%A6%B7-%E0%A6%96%E0%A6%B2%E0%A6%AC%E0%A6%A8-%E0%A6%AE%E0%A6%B0%E0%A6%A4%E0%A6%A8%E0%A6%9C">Education Bangla</source>
    </item>
    <item>
      <title>হায়দরাবাদের ‘ফেইক’ বোলারকে নিয়ে ক্ষোভ ঝাড়লেন ভারতের সাবেক অধিনায়ক</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B9%E0%A7%9F%E0%A6%A6%E0%A6%B0%E0%A6%AC%E0%A6%A6%E0%A6%B0-%E0%A6%AB%E0%A6%87%E0%A6%95-%E0%A6%AC%E0%A6%B2%E0%A6%B0%E0%A6%95-%E0%A6%A8%E0%A7%9F-%E0%A6%95%E0%A6%B7%E0%A6%AD-%E0%A6%9D%E0%A7%9C%E0%A6%B2%E0%A6%A8-%E0%A6%AD%E0%A6%B0%E0%A6%A4%E0%A6%B0-%E0%A6%B8%E0%A6%AC%E0%A6%95-%E0%A6%85%E0%A6%A7%E0%A6%A8%E0%A7%9F%E0%A6%95</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%B9%E0%A7%9F%E0%A6%A6%E0%A6%B0%E0%A6%AC%E0%A6%A6%E0%A6%B0-%E0%A6%AB%E0%A6%87%E0%A6%95-%E0%A6%AC%E0%A6%B2%E0%A6%B0%E0%A6%95-%E0%A6%A8%E0%A7%9F-%E0%A6%95%E0%A6%B7%E0%A6%AD-%E0%A6%9D%E0%A7%9C%E0%A6%B2%E0%A6%A8-%E0%A6%AD%E0%A6%B0%E0%A6%A4%E0%A6%B0-%E0%A6%B8%E0%A6%AC%E0%A6%95-%E0%A6%85%E0%A6%A7%E0%A6%A8%E0%A7%9F%E0%A6%95</guid>
      <pubDate>Tue, 17 Nov 2026 06:36:16 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794897376_rkr_6afbf5e0be489.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794897376_rkr_6afbf5e0be489.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794897376_rkr_6afbf5e0be489.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হায়দরাবাদের ‘ফেইক’ বোলারকে নিয়ে ক্ষোভ ঝাড়লেন ভারতের সাবেক অধিনায়ক" /&gt;&lt;/p&gt;&lt;p&gt;আইপিএলে সানরাইজার্স হায়দরাবাদের (এসআরএইচ) বোলিং আক্রমণ নিয়ে অসন্তোষ প্রকাশ করেছেন ভারতের সাবেক অধিনায়ক কৃষ্ণমাচারি শ্রীকান্ত। বিশেষ করে অভিজ্ঞ পেসার জয়দেব উনাদকাটকে দলে রেখে দেওয়ার সিদ্ধান্ত নিয়ে প্রশ্ন তুলেছেন তিনি। এমনকি উনাদকাটের বোলিংকে ‘ফেইক’ বলেও কটাক্ষ করেছেন সাবেক এই ক্রিকেটার। প্রতিবেদন এনড&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B9%E0%A7%9F%E0%A6%A6%E0%A6%B0%E0%A6%AC%E0%A6%A6%E0%A6%B0-%E0%A6%AB%E0%A6%87%E0%A6%95-%E0%A6%AC%E0%A6%B2%E0%A6%B0%E0%A6%95-%E0%A6%A8%E0%A7%9F-%E0%A6%95%E0%A6%B7%E0%A6%AD-%E0%A6%9D%E0%A7%9C%E0%A6%B2%E0%A6%A8-%E0%A6%AD%E0%A6%B0%E0%A6%A4%E0%A6%B0-%E0%A6%B8%E0%A6%AC%E0%A6%95-%E0%A6%85%E0%A6%A7%E0%A6%A8%E0%A7%9F%E0%A6%95">Education Bangla</source>
    </item>
    <item>
      <title>এক দশক পর কোহলি বুঝবে কত বড় ভুল করেছে: কপিল দেব</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%8F%E0%A6%95-%E0%A6%A6%E0%A6%B6%E0%A6%95-%E0%A6%AA%E0%A6%B0-%E0%A6%95%E0%A6%B9%E0%A6%B2-%E0%A6%AC%E0%A6%9D%E0%A6%AC-%E0%A6%95%E0%A6%A4-%E0%A6%AC%E0%A7%9C-%E0%A6%AD%E0%A6%B2-%E0%A6%95%E0%A6%B0%E0%A6%9B-%E0%A6%95%E0%A6%AA%E0%A6%B2-%E0%A6%A6%E0%A6%AC</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%8F%E0%A6%95-%E0%A6%A6%E0%A6%B6%E0%A6%95-%E0%A6%AA%E0%A6%B0-%E0%A6%95%E0%A6%B9%E0%A6%B2-%E0%A6%AC%E0%A6%9D%E0%A6%AC-%E0%A6%95%E0%A6%A4-%E0%A6%AC%E0%A7%9C-%E0%A6%AD%E0%A6%B2-%E0%A6%95%E0%A6%B0%E0%A6%9B-%E0%A6%95%E0%A6%AA%E0%A6%B2-%E0%A6%A6%E0%A6%AC</guid>
      <pubDate>Tue, 17 Nov 2026 06:34:38 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794897278_rkr_6afbf57ec9a97.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794897278_rkr_6afbf57ec9a97.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794897278_rkr_6afbf57ec9a97.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এক দশক পর কোহলি বুঝবে কত বড় ভুল করেছে: কপিল দেব" /&gt;&lt;/p&gt;&lt;p&gt;টেস্ট ক্রিকেটে বিরাট কোহলির ফেরার সম্ভাবনা নেই বললেই চলে। কিন্তু ভারতের বিশ্বকাপজয়ী সাবেক অধিনায়ক কপিল দেবের মনে এখনো সেই অবসরের সিদ্ধান্ত নিয়ে আক্ষেপ। তার মতে, কোহলির মতো ফিট ক্রিকেটারের আরও কয়েক বছর টেস্ট খেলা উচিত ছিল। শুধু তা-ই নয়, এক দশক পর নিজের সিদ্ধান্তের জন্য অনুশোচনা হতে পারে কোহলির।সময়ের.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%8F%E0%A6%95-%E0%A6%A6%E0%A6%B6%E0%A6%95-%E0%A6%AA%E0%A6%B0-%E0%A6%95%E0%A6%B9%E0%A6%B2-%E0%A6%AC%E0%A6%9D%E0%A6%AC-%E0%A6%95%E0%A6%A4-%E0%A6%AC%E0%A7%9C-%E0%A6%AD%E0%A6%B2-%E0%A6%95%E0%A6%B0%E0%A6%9B-%E0%A6%95%E0%A6%AA%E0%A6%B2-%E0%A6%A6%E0%A6%AC">Education Bangla</source>
    </item>
    <item>
      <title>ভারতের বিপক্ষে টেস্ট সিরিজ থেকে ছিটকে গেলেন স্যান্টনার</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AD%E0%A6%B0%E0%A6%A4%E0%A6%B0-%E0%A6%AC%E0%A6%AA%E0%A6%95%E0%A6%B7-%E0%A6%9F%E0%A6%B8%E0%A6%9F-%E0%A6%B8%E0%A6%B0%E0%A6%9C-%E0%A6%A5%E0%A6%95-%E0%A6%9B%E0%A6%9F%E0%A6%95-%E0%A6%97%E0%A6%B2%E0%A6%A8-%E0%A6%B8%E0%A6%AF%E0%A6%A8%E0%A6%9F%E0%A6%A8%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AD%E0%A6%B0%E0%A6%A4%E0%A6%B0-%E0%A6%AC%E0%A6%AA%E0%A6%95%E0%A6%B7-%E0%A6%9F%E0%A6%B8%E0%A6%9F-%E0%A6%B8%E0%A6%B0%E0%A6%9C-%E0%A6%A5%E0%A6%95-%E0%A6%9B%E0%A6%9F%E0%A6%95-%E0%A6%97%E0%A6%B2%E0%A6%A8-%E0%A6%B8%E0%A6%AF%E0%A6%A8%E0%A6%9F%E0%A6%A8%E0%A6%B0</guid>
      <pubDate>Tue, 17 Nov 2026 06:33:29 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794897209_rkr_6afbf539a89ff.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794897209_rkr_6afbf539a89ff.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794897209_rkr_6afbf539a89ff.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভারতের বিপক্ষে টেস্ট সিরিজ থেকে ছিটকে গেলেন স্যান্টনার" /&gt;&lt;/p&gt;&lt;p&gt;ভারতের বিপক্ষে আসন্ন দুই ম্যাচের টেস্ট সিরিজ থেকে ছিটকে গেছেন নিউজিল্যান্ডের অলরাউন্ডার মিচেল স্যান্টনার। ডান হাতের হাড়ে চিড় ধরায় সিরিজে খেলা হচ্ছে না কিউইদের সাদা বলের অধিনায়কের। খবর ক্রিকবাজের।গত রোববার (১৫ নভেম্বর) মাউন্ট মঙ্গানুইয়ে ভারতের বিপক্ষে পাঁচ ম্যাচের ওয়ানডে সিরিজের শেষ ম্যাচে ব্যাটিংয়ের&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AD%E0%A6%B0%E0%A6%A4%E0%A6%B0-%E0%A6%AC%E0%A6%AA%E0%A6%95%E0%A6%B7-%E0%A6%9F%E0%A6%B8%E0%A6%9F-%E0%A6%B8%E0%A6%B0%E0%A6%9C-%E0%A6%A5%E0%A6%95-%E0%A6%9B%E0%A6%9F%E0%A6%95-%E0%A6%97%E0%A6%B2%E0%A6%A8-%E0%A6%B8%E0%A6%AF%E0%A6%A8%E0%A6%9F%E0%A6%A8%E0%A6%B0">Education Bangla</source>
    </item>
    <item>
      <title>পেরুকে ৯ গোলের বন্যায় ভাসাল ব্রাজিলের যুবারা</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AA%E0%A6%B0%E0%A6%95-%E0%A7%AF-%E0%A6%97%E0%A6%B2%E0%A6%B0-%E0%A6%AC%E0%A6%A8%E0%A6%AF%E0%A7%9F-%E0%A6%AD%E0%A6%B8%E0%A6%B2-%E0%A6%AC%E0%A6%B0%E0%A6%9C%E0%A6%B2%E0%A6%B0-%E0%A6%AF%E0%A6%AC%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AA%E0%A6%B0%E0%A6%95-%E0%A7%AF-%E0%A6%97%E0%A6%B2%E0%A6%B0-%E0%A6%AC%E0%A6%A8%E0%A6%AF%E0%A7%9F-%E0%A6%AD%E0%A6%B8%E0%A6%B2-%E0%A6%AC%E0%A6%B0%E0%A6%9C%E0%A6%B2%E0%A6%B0-%E0%A6%AF%E0%A6%AC%E0%A6%B0</guid>
      <pubDate>Tue, 17 Nov 2026 06:32:40 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794897160_rkr_6afbf508f3875.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794897160_rkr_6afbf508f3875.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794897160_rkr_6afbf508f3875.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পেরুকে ৯ গোলের বন্যায় ভাসাল ব্রাজিলের যুবারা" /&gt;&lt;/p&gt;&lt;p&gt;ব্রাজিলের অনূর্ধ্ব-২০ ফুটবল দল যেন গোল উৎসবে মেতে উঠেছিল। পেরুর বিপক্ষে প্রীতি ম্যাচে প্রতিপক্ষকে রীতিমতো বিধ্বস্ত করেছে সেলেসাওরা। দুই অর্ধে মিলিয়ে ৯ গোল করেছে ব্রাজিল। জবাবে একটি গোলও করতে পারেনি পেরু। ম্যাচে জোড়া গোল করেছেন রোবিনহো জুনিয়র, আর হ্যাটট্রিকসহ একটি অ্যাসিস্ট করেছেন আন্দ্রে। খবর গ্লোবো&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AA%E0%A6%B0%E0%A6%95-%E0%A7%AF-%E0%A6%97%E0%A6%B2%E0%A6%B0-%E0%A6%AC%E0%A6%A8%E0%A6%AF%E0%A7%9F-%E0%A6%AD%E0%A6%B8%E0%A6%B2-%E0%A6%AC%E0%A6%B0%E0%A6%9C%E0%A6%B2%E0%A6%B0-%E0%A6%AF%E0%A6%AC%E0%A6%B0">Education Bangla</source>
    </item>
    <item>
      <title>পর্তুগালের হারে খুশি রোনালদোর মা, সতীর্থদের বিরুদ্ধে ক্ষোভ</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AA%E0%A6%B0%E0%A6%A4%E0%A6%97%E0%A6%B2%E0%A6%B0-%E0%A6%B9%E0%A6%B0-%E0%A6%96%E0%A6%B6-%E0%A6%B0%E0%A6%A8%E0%A6%B2%E0%A6%A6%E0%A6%B0-%E0%A6%AE-%E0%A6%B8%E0%A6%A4%E0%A6%B0%E0%A6%A5%E0%A6%A6%E0%A6%B0-%E0%A6%AC%E0%A6%B0%E0%A6%A6%E0%A6%A7-%E0%A6%95%E0%A6%B7%E0%A6%AD</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AA%E0%A6%B0%E0%A6%A4%E0%A6%97%E0%A6%B2%E0%A6%B0-%E0%A6%B9%E0%A6%B0-%E0%A6%96%E0%A6%B6-%E0%A6%B0%E0%A6%A8%E0%A6%B2%E0%A6%A6%E0%A6%B0-%E0%A6%AE-%E0%A6%B8%E0%A6%A4%E0%A6%B0%E0%A6%A5%E0%A6%A6%E0%A6%B0-%E0%A6%AC%E0%A6%B0%E0%A6%A6%E0%A6%A7-%E0%A6%95%E0%A6%B7%E0%A6%AD</guid>
      <pubDate>Tue, 17 Nov 2026 06:31:26 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794897086_rkr_6afbf4beb5363.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794897086_rkr_6afbf4beb5363.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794897086_rkr_6afbf4beb5363.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পর্তুগালের হারে খুশি রোনালদোর মা, সতীর্থদের বিরুদ্ধে ক্ষোভ" /&gt;&lt;/p&gt;&lt;p&gt;ছেলের বিদায়টা যেভাবে হয়েছে, তা মেনে নিতে পারছেন না মা দোলোরেস আভেইরো। পর্তুগাল জাতীয় দল থেকে ক্রিয়ানো রোনালদোর বিদায়ের পর এবার দেশটির বড় হারে আনন্দ প্রকাশ করেছেন তিনি। শুধু তা-ই নয়, রোনালদোর সাবেক সতীর্থদের বিরুদ্ধেও তুলেছেন অসম্মানের অভিযোগ। তার দাবি, জাতীয় দলে রোনালদো যথেষ্ট ভালোবাসা ও সম্মান পানন&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AA%E0%A6%B0%E0%A6%A4%E0%A6%97%E0%A6%B2%E0%A6%B0-%E0%A6%B9%E0%A6%B0-%E0%A6%96%E0%A6%B6-%E0%A6%B0%E0%A6%A8%E0%A6%B2%E0%A6%A6%E0%A6%B0-%E0%A6%AE-%E0%A6%B8%E0%A6%A4%E0%A6%B0%E0%A6%A5%E0%A6%A6%E0%A6%B0-%E0%A6%AC%E0%A6%B0%E0%A6%A6%E0%A6%A7-%E0%A6%95%E0%A6%B7%E0%A6%AD">Education Bangla</source>
    </item>
    <item>
      <title>‘সে চলে আসুক’, আর্জেন্টিনা দলে মেসিকে নিয়ে স্কালোনি</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B8-%E0%A6%9A%E0%A6%B2-%E0%A6%86%E0%A6%B8%E0%A6%95-%E0%A6%86%E0%A6%B0%E0%A6%9C%E0%A6%A8%E0%A6%9F%E0%A6%A8-%E0%A6%A6%E0%A6%B2-%E0%A6%AE%E0%A6%B8%E0%A6%95-%E0%A6%A8%E0%A7%9F-%E0%A6%B8%E0%A6%95%E0%A6%B2%E0%A6%A8</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%B8-%E0%A6%9A%E0%A6%B2-%E0%A6%86%E0%A6%B8%E0%A6%95-%E0%A6%86%E0%A6%B0%E0%A6%9C%E0%A6%A8%E0%A6%9F%E0%A6%A8-%E0%A6%A6%E0%A6%B2-%E0%A6%AE%E0%A6%B8%E0%A6%95-%E0%A6%A8%E0%A7%9F-%E0%A6%B8%E0%A6%95%E0%A6%B2%E0%A6%A8</guid>
      <pubDate>Tue, 17 Nov 2026 06:29:16 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794896956_rkr_6afbf43c2c126.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794896956_rkr_6afbf43c2c126.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794896956_rkr_6afbf43c2c126.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘সে চলে আসুক’, আর্জেন্টিনা দলে মেসিকে নিয়ে স্কালোনি" /&gt;&lt;/p&gt;&lt;p&gt;খেলোয়াড় হিসেবে আর্জেন্টিনা জাতীয় দলের জার্সিতে মেসির অধ্যায় শেষ হয়েছে। তবে আলবিসেলেস্তেদের সঙ্গে তার সম্পর্ক কি এখানেই শেষ নয়। বরং লিওনেল মেসিকে এবার অন্য ভূমিকায় আর্জেন্টিনা দলে দেখার সম্ভাবনার কথা জানালেন কোচ লিওনেল স্কালোনি। এমনকি কোচিং স্টাফে মেসিকে যুক্ত করার দরজাও খোলা রেখেছেন তিনি।স্কালোনি বল&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B8-%E0%A6%9A%E0%A6%B2-%E0%A6%86%E0%A6%B8%E0%A6%95-%E0%A6%86%E0%A6%B0%E0%A6%9C%E0%A6%A8%E0%A6%9F%E0%A6%A8-%E0%A6%A6%E0%A6%B2-%E0%A6%AE%E0%A6%B8%E0%A6%95-%E0%A6%A8%E0%A7%9F-%E0%A6%B8%E0%A6%95%E0%A6%B2%E0%A6%A8">Education Bangla</source>
    </item>
    <item>
      <title>ম্যাচে বলের আঘাতে প্রাণ গেল আর্জেন্টাইন তরুণ ফুটবলারের</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%AF%E0%A6%9A-%E0%A6%AC%E0%A6%B2%E0%A6%B0-%E0%A6%86%E0%A6%98%E0%A6%A4-%E0%A6%AA%E0%A6%B0%E0%A6%A3-%E0%A6%97%E0%A6%B2-%E0%A6%86%E0%A6%B0%E0%A6%9C%E0%A6%A8%E0%A6%9F%E0%A6%87%E0%A6%A8-%E0%A6%A4%E0%A6%B0%E0%A6%A3-%E0%A6%AB%E0%A6%9F%E0%A6%AC%E0%A6%B2%E0%A6%B0%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%AF%E0%A6%9A-%E0%A6%AC%E0%A6%B2%E0%A6%B0-%E0%A6%86%E0%A6%98%E0%A6%A4-%E0%A6%AA%E0%A6%B0%E0%A6%A3-%E0%A6%97%E0%A6%B2-%E0%A6%86%E0%A6%B0%E0%A6%9C%E0%A6%A8%E0%A6%9F%E0%A6%87%E0%A6%A8-%E0%A6%A4%E0%A6%B0%E0%A6%A3-%E0%A6%AB%E0%A6%9F%E0%A6%AC%E0%A6%B2%E0%A6%B0%E0%A6%B0</guid>

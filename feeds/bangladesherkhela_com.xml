    <item>
      <title>৬ ক্যাচে লিটনের কীর্তি, হাতছানি বিশ্বরেকর্ডের</title>
      <link>https://bangladesherkhela.com/news/%E0%A7%AC-%E0%A6%95%E0%A6%AF%E0%A6%9A-%E0%A6%B2%E0%A6%9F%E0%A6%A8%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%A4-%E0%A6%B9%E0%A6%A4%E0%A6%9B%E0%A6%A8-%E0%A6%AC%E0%A6%B6%E0%A6%AC%E0%A6%B0%E0%A6%95%E0%A6%B0%E0%A6%A1%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A7%AC-%E0%A6%95%E0%A6%AF%E0%A6%9A-%E0%A6%B2%E0%A6%9F%E0%A6%A8%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%A4-%E0%A6%B9%E0%A6%A4%E0%A6%9B%E0%A6%A8-%E0%A6%AC%E0%A6%B6%E0%A6%AC%E0%A6%B0%E0%A6%95%E0%A6%B0%E0%A6%A1%E0%A6%B0</guid>
      <pubDate>Tue, 17 Nov 2026 16:57:22 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794934642_rkr_6afc87723a8ae.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794934642_rkr_6afc87723a8ae.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794934642_rkr_6afc87723a8ae.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৬ ক্যাচে লিটনের কীর্তি, হাতছানি বিশ্বরেকর্ডের" /&gt;&lt;/p&gt;&lt;p&gt;জোহানেসবার্গে ব্যাট হাতে সেঞ্চুরি হাঁকানোর পর এবার গ্লাভস হাতেও ইতিহাস গড়লেন লিটন দাস। দক্ষিণ আফ্রিকার বিপক্ষে সিরিজের এই টেস্টের প্রথম ইনিংসে ৬টি ক্যাচ নিয়ে টেস্ট ক্রিকেটে বাংলাদেশের উইকেটরক্ষক হিসেবে এক ইনিংসে সর্বোচ্চ ক্যাচের নতুন রেকর্ড গড়েছেন তিনি। একই সঙ্গে তার সামনে উঁকি দিচ্ছে বিশ্বরেকর্ডে ভ&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A7%AC-%E0%A6%95%E0%A6%AF%E0%A6%9A-%E0%A6%B2%E0%A6%9F%E0%A6%A8%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%A4-%E0%A6%B9%E0%A6%A4%E0%A6%9B%E0%A6%A8-%E0%A6%AC%E0%A6%B6%E0%A6%AC%E0%A6%B0%E0%A6%95%E0%A6%B0%E0%A6%A1%E0%A6%B0">Education Bangla</source>
    </item>
    <item>
      <title>২২ বছর পর টেস্ট সিরিজ জিতল জিম্বাবুয়ে</title>
      <link>https://bangladesherkhela.com/news/%E0%A7%A8%E0%A7%A8-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%9F%E0%A6%B8%E0%A6%9F-%E0%A6%B8%E0%A6%B0%E0%A6%9C-%E0%A6%9C%E0%A6%A4%E0%A6%B2-%E0%A6%9C%E0%A6%AE%E0%A6%AC%E0%A6%AC%E0%A7%9F</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A7%A8%E0%A7%A8-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%9F%E0%A6%B8%E0%A6%9F-%E0%A6%B8%E0%A6%B0%E0%A6%9C-%E0%A6%9C%E0%A6%A4%E0%A6%B2-%E0%A6%9C%E0%A6%AE%E0%A6%AC%E0%A6%AC%E0%A7%9F</guid>
      <pubDate>Tue, 17 Nov 2026 16:33:18 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794933198_rkr_6afc81ce1d640.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794933198_rkr_6afc81ce1d640.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794933198_rkr_6afc81ce1d640.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="২২ বছর পর টেস্ট সিরিজ জিতল জিম্বাবুয়ে" /&gt;&lt;/p&gt;&lt;p&gt;শেষ দিন পর্যন্ত লড়াই করেও হার এড়াতে পারল না আফগানিস্তান। নাসির খানের দুর্দান্ত সেঞ্চুরির পরও শারজাহ টেস্টে জিম্বাবুয়ের কাছে ৫৭ রানে হেরেছে তারা। দ্বিতীয় ইনিংসে ৩৬০ রানে অলআউট হয়েছে আফগানিস্তান। এই জয়ে দুই ম্যাচের টেস্ট সিরিজ ১-০ ব্যবধানে জিতে নিয়েছে জিম্বাবুয়ে।ম্যাচের শেষ দিনে জয়ের জন্য আফগানিস্তানে&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A7%A8%E0%A7%A8-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%9F%E0%A6%B8%E0%A6%9F-%E0%A6%B8%E0%A6%B0%E0%A6%9C-%E0%A6%9C%E0%A6%A4%E0%A6%B2-%E0%A6%9C%E0%A6%AE%E0%A6%AC%E0%A6%AC%E0%A7%9F">Education Bangla</source>
    </item>
    <item>
      <title>সেরা সময়ে আত্মহত্যার কথা ভাবতেন রুনি!</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A7%9F-%E0%A6%86%E0%A6%A4%E0%A6%AE%E0%A6%B9%E0%A6%A4%E0%A6%AF%E0%A6%B0-%E0%A6%95%E0%A6%A5-%E0%A6%AD%E0%A6%AC%E0%A6%A4%E0%A6%A8-%E0%A6%B0%E0%A6%A8</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A7%9F-%E0%A6%86%E0%A6%A4%E0%A6%AE%E0%A6%B9%E0%A6%A4%E0%A6%AF%E0%A6%B0-%E0%A6%95%E0%A6%A5-%E0%A6%AD%E0%A6%AC%E0%A6%A4%E0%A6%A8-%E0%A6%B0%E0%A6%A8</guid>
      <pubDate>Tue, 17 Nov 2026 16:30:30 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794933030_rkr_6afc81268192c.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794933030_rkr_6afc81268192c.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794933030_rkr_6afc81268192c.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সেরা সময়ে আত্মহত্যার কথা ভাবতেন রুনি!" /&gt;&lt;/p&gt;&lt;p&gt;ফুটবল মাঠে তখন সাফল্যের চূড়ায় ওয়েন রুনি। ম্যানচেস্টার ইউনাইটেডের জার্সিতে একের পর এক গোল, চারদিকে খ্যাতি আর অর্জনের হাতছানি। সদ্য বিয়ে করেছেন, ঘর আলো করে এসেছে প্রথম সন্তান কাই। বাইরে থেকে দেখলে জীবনটা ছিল স্বপ্নের মতো। অথচ সেই স্বপ্নের আড়ালেই ভয়াবহ মানসিক যন্ত্রণায় পুড়ছিলেন ইংল্যান্ডের সাবেক এই তার&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A7%9F-%E0%A6%86%E0%A6%A4%E0%A6%AE%E0%A6%B9%E0%A6%A4%E0%A6%AF%E0%A6%B0-%E0%A6%95%E0%A6%A5-%E0%A6%AD%E0%A6%AC%E0%A6%A4%E0%A6%A8-%E0%A6%B0%E0%A6%A8">Education Bangla</source>
    </item>
    <item>
      <title>পেসারদের তোপে ৯৮ রানেই গুটিয়ে গেল শ্রীলঙ্কা</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AA%E0%A6%B8%E0%A6%B0%E0%A6%A6%E0%A6%B0-%E0%A6%A4%E0%A6%AA-%E0%A7%AF%E0%A7%AE-%E0%A6%B0%E0%A6%A8%E0%A6%87-%E0%A6%97%E0%A6%9F%E0%A7%9F-%E0%A6%97%E0%A6%B2-%E0%A6%B6%E0%A6%B0%E0%A6%B2%E0%A6%99%E0%A6%95</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AA%E0%A6%B8%E0%A6%B0%E0%A6%A6%E0%A6%B0-%E0%A6%A4%E0%A6%AA-%E0%A7%AF%E0%A7%AE-%E0%A6%B0%E0%A6%A8%E0%A6%87-%E0%A6%97%E0%A6%9F%E0%A7%9F-%E0%A6%97%E0%A6%B2-%E0%A6%B6%E0%A6%B0%E0%A6%B2%E0%A6%99%E0%A6%95</guid>
      <pubDate>Tue, 17 Nov 2026 16:28:39 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794932919_rkr_6afc80b770794.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794932919_rkr_6afc80b770794.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794932919_rkr_6afc80b770794.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পেসারদের তোপে ৯৮ রানেই গুটিয়ে গেল শ্রীলঙ্কা" /&gt;&lt;/p&gt;&lt;p&gt;রাওয়ালপিন্ডিতে শ্রীলঙ্কার বিপক্ষে দ্বিতীয় টেস্টের প্রথম দিনটি নিজেদের করে নিয়েছে পাকিস্তান। স্বাগতিকদের পেসারদের তোপে মাত্র ৯৮ রানেই গুটিয়ে গেছে শ্রীলঙ্কার প্রথম ইনিংস। জবাবে ব্যাট করতে নেমে দিন শেষে ৩ উইকেট হারিয়ে ১২১ রান তুলেছে পাকিস্তান। ফলে ২৩ রানের লিড নিয়ে দ্বিতীয় দিনের খেলা শুরু করবে তারা।পাক&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AA%E0%A6%B8%E0%A6%B0%E0%A6%A6%E0%A6%B0-%E0%A6%A4%E0%A6%AA-%E0%A7%AF%E0%A7%AE-%E0%A6%B0%E0%A6%A8%E0%A6%87-%E0%A6%97%E0%A6%9F%E0%A7%9F-%E0%A6%97%E0%A6%B2-%E0%A6%B6%E0%A6%B0%E0%A6%B2%E0%A6%99%E0%A6%95">Education Bangla</source>
    </item>
    <item>
      <title>সমালোচনার মেঘ সরিয়ে ব্রাজিলের গোলবৃষ্টি</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%AE%E0%A6%B2%E0%A6%9A%E0%A6%A8%E0%A6%B0-%E0%A6%AE%E0%A6%98-%E0%A6%B8%E0%A6%B0%E0%A7%9F-%E0%A6%AC%E0%A6%B0%E0%A6%9C%E0%A6%B2%E0%A6%B0-%E0%A6%97%E0%A6%B2%E0%A6%AC%E0%A6%B7%E0%A6%9F</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%AE%E0%A6%B2%E0%A6%9A%E0%A6%A8%E0%A6%B0-%E0%A6%AE%E0%A6%98-%E0%A6%B8%E0%A6%B0%E0%A7%9F-%E0%A6%AC%E0%A6%B0%E0%A6%9C%E0%A6%B2%E0%A6%B0-%E0%A6%97%E0%A6%B2%E0%A6%AC%E0%A6%B7%E0%A6%9F</guid>

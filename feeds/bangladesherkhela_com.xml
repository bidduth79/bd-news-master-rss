    <item>
      <title>বাটলারের দর্শন ধরে রাখতে চান ঋতুপর্ণাদের নতুন কোচ</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%9F%E0%A6%B2%E0%A6%B0%E0%A6%B0-%E0%A6%A6%E0%A6%B0%E0%A6%B6%E0%A6%A8-%E0%A6%A7%E0%A6%B0-%E0%A6%B0%E0%A6%96%E0%A6%A4-%E0%A6%9A%E0%A6%A8-%E0%A6%8B%E0%A6%A4%E0%A6%AA%E0%A6%B0%E0%A6%A3%E0%A6%A6%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A6%A8-%E0%A6%95%E0%A6%9A</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%9F%E0%A6%B2%E0%A6%B0%E0%A6%B0-%E0%A6%A6%E0%A6%B0%E0%A6%B6%E0%A6%A8-%E0%A6%A7%E0%A6%B0-%E0%A6%B0%E0%A6%96%E0%A6%A4-%E0%A6%9A%E0%A6%A8-%E0%A6%8B%E0%A6%A4%E0%A6%AA%E0%A6%B0%E0%A6%A3%E0%A6%A6%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A6%A8-%E0%A6%95%E0%A6%9A</guid>
      <pubDate>Mon, 09 Nov 2026 15:13:35 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_media/1794214137_6af188f96f96b.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_media/1794214137_6af188f96f96b.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_media/1794214137_6af188f96f96b.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাটলারের দর্শন ধরে রাখতে চান ঋতুপর্ণাদের নতুন কোচ" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ নারী জাতীয় ফুটবল দলের অন্তর্বর্তীকালীন প্রধান কোচ হিসেবে দায়িত্ব নিয়েছেন ফরাসি কোচ এরিক মেয়ার। দায়িত্ব পেয়েই দলের খেলার ধরনে বড় কোনো পরিবর্তন না আনার ঘোষণা দিয়েছেন তিনি। বরং সাবেক কোচ পিটার বাটলারের ফুটবল দর্শন ধরে রেখেই পরিস্থিতি ও খেলোয়াড়দের সামর্থ্য অনুযায়ী কিছু কৌশলগত পরিবর্তন আনতে চান.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%9F%E0%A6%B2%E0%A6%B0%E0%A6%B0-%E0%A6%A6%E0%A6%B0%E0%A6%B6%E0%A6%A8-%E0%A6%A7%E0%A6%B0-%E0%A6%B0%E0%A6%96%E0%A6%A4-%E0%A6%9A%E0%A6%A8-%E0%A6%8B%E0%A6%A4%E0%A6%AA%E0%A6%B0%E0%A6%A3%E0%A6%A6%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A6%A8-%E0%A6%95%E0%A6%9A">Education Bangla</source>
    </item>
    <item>
      <title>ক্রীড়া শক্তির কথা তুলে ধরলেন ডাচেস অব এডিনবরা</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%95%E0%A6%B0%E0%A7%9C-%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%B0-%E0%A6%95%E0%A6%A5-%E0%A6%A4%E0%A6%B2-%E0%A6%A7%E0%A6%B0%E0%A6%B2%E0%A6%A8-%E0%A6%A1%E0%A6%9A%E0%A6%B8-%E0%A6%85%E0%A6%AC-%E0%A6%8F%E0%A6%A1%E0%A6%A8%E0%A6%AC%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%95%E0%A6%B0%E0%A7%9C-%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%B0-%E0%A6%95%E0%A6%A5-%E0%A6%A4%E0%A6%B2-%E0%A6%A7%E0%A6%B0%E0%A6%B2%E0%A6%A8-%E0%A6%A1%E0%A6%9A%E0%A6%B8-%E0%A6%85%E0%A6%AC-%E0%A6%8F%E0%A6%A1%E0%A6%A8%E0%A6%AC%E0%A6%B0</guid>
      <pubDate>Mon, 09 Nov 2026 15:12:18 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_media/1794237127_6af1e2c728ef9.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_media/1794237127_6af1e2c728ef9.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_media/1794237127_6af1e2c728ef9.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ক্রীড়া শক্তির কথা তুলে ধরলেন ডাচেস অব এডিনবরা" /&gt;&lt;/p&gt;&lt;p&gt;নতুন প্রজন্মকে অনুপ্রাণিত করতে খেলাধুলার অনন্য শক্তির ওপর জোর দিয়েছেন ডাচেস অব এডিনবরা সোফি হেলেন রিস-জোন্স। সোমবার বিকেএসপি (বাংলাদেশ ক্রীড়া শিক্ষা প্রতিষ্ঠান) পরিদর্শনের সময় তিনি এই কথা বলেন।সফরের অংশ হিসেবে তিনি সেখানে তরুণ অ্যাথলেট ও নারী হকি খেলোয়াড়দের সঙ্গে সাক্ষাৎ করেন। এ সময় বাংলাদেশের কিশোর&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%95%E0%A6%B0%E0%A7%9C-%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%B0-%E0%A6%95%E0%A6%A5-%E0%A6%A4%E0%A6%B2-%E0%A6%A7%E0%A6%B0%E0%A6%B2%E0%A6%A8-%E0%A6%A1%E0%A6%9A%E0%A6%B8-%E0%A6%85%E0%A6%AC-%E0%A6%8F%E0%A6%A1%E0%A6%A8%E0%A6%AC%E0%A6%B0">Education Bangla</source>
    </item>
    <item>
      <title>মুমিন-তামিমের রেকর্ডে সেমিফাইনালে বাংলাদেশ</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%AE%E0%A6%A8-%E0%A6%A4%E0%A6%AE%E0%A6%AE%E0%A6%B0-%E0%A6%B0%E0%A6%95%E0%A6%B0%E0%A6%A1-%E0%A6%B8%E0%A6%AE%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%AE%E0%A6%A8-%E0%A6%A4%E0%A6%AE%E0%A6%AE%E0%A6%B0-%E0%A6%B0%E0%A6%95%E0%A6%B0%E0%A6%A1-%E0%A6%B8%E0%A6%AE%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6</guid>
      <pubDate>Mon, 09 Nov 2026 15:10:56 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_media/1794237041_6af1e271752b3.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_media/1794237041_6af1e271752b3.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_media/1794237041_6af1e271752b3.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মুমিন-তামিমের রেকর্ডে সেমিফাইনালে বাংলাদেশ" /&gt;&lt;/p&gt;&lt;p&gt;ব্যাট হাতে একাই লড়লেন আহসান আল মুমিন। সতীর্থদের আসা-যাওয়ার মিছিলে এক প্রান্ত আগলে রেখে খেললেন ক্যারিয়ারসেরা ইনিংস। তাতে গড়লেন বাংলাদেশের যুব ওয়ানডে ক্রিকেটে সর্বোচ্চ ব্যক্তিগত ইনিংসের রেকর্ড। আজ ওমানের আল আমেরাত ক্রিকেট গ্রাউন্ডে তার অপরাজিত ১৫২ রানের ঝলমলে ইনিংসে ভর করে মালয়েশিয়ার যুবাদের বিপক্ষে ৫&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%AE%E0%A6%A8-%E0%A6%A4%E0%A6%AE%E0%A6%AE%E0%A6%B0-%E0%A6%B0%E0%A6%95%E0%A6%B0%E0%A6%A1-%E0%A6%B8%E0%A6%AE%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6">Education Bangla</source>
    </item>
    <item>
      <title>একই দিনে মিঠুন-জাকিরের ১৮তম সেঞ্চুরি</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%8F%E0%A6%95%E0%A6%87-%E0%A6%A6%E0%A6%A8-%E0%A6%AE%E0%A6%A0%E0%A6%A8-%E0%A6%9C%E0%A6%95%E0%A6%B0%E0%A6%B0-%E0%A7%A7%E0%A7%AE%E0%A6%A4%E0%A6%AE-%E0%A6%B8%E0%A6%9E%E0%A6%9A%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%8F%E0%A6%95%E0%A6%87-%E0%A6%A6%E0%A6%A8-%E0%A6%AE%E0%A6%A0%E0%A6%A8-%E0%A6%9C%E0%A6%95%E0%A6%B0%E0%A6%B0-%E0%A7%A7%E0%A7%AE%E0%A6%A4%E0%A6%AE-%E0%A6%B8%E0%A6%9E%E0%A6%9A%E0%A6%B0</guid>

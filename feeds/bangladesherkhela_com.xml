    <item>
      <title>আন্তোনিও নুসাকে দলে ভেড়াতে মরিয়া আর্সেনাল</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%A8%E0%A6%A4%E0%A6%A8%E0%A6%93-%E0%A6%A8%E0%A6%B8%E0%A6%95-%E0%A6%A6%E0%A6%B2-%E0%A6%AD%E0%A7%9C%E0%A6%A4-%E0%A6%AE%E0%A6%B0%E0%A7%9F-%E0%A6%86%E0%A6%B0%E0%A6%B8%E0%A6%A8%E0%A6%B2</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%A8%E0%A6%A4%E0%A6%A8%E0%A6%93-%E0%A6%A8%E0%A6%B8%E0%A6%95-%E0%A6%A6%E0%A6%B2-%E0%A6%AD%E0%A7%9C%E0%A6%A4-%E0%A6%AE%E0%A6%B0%E0%A7%9F-%E0%A6%86%E0%A6%B0%E0%A6%B8%E0%A6%A8%E0%A6%B2</guid>
      <pubDate>Thu, 19 Nov 2026 14:10:09 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795097409_rkr_6aff034125702.JPG" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795097409_rkr_6aff034125702.JPG" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795097409_rkr_6aff034125702.JPG" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আন্তোনিও নুসাকে দলে ভেড়াতে মরিয়া আর্সেনাল" /&gt;&lt;/p&gt;&lt;p&gt;আক্রমণভাগের শক্তি বাড়াতে জার্মান ক্লাব আরবি লাইপজিগের নরওয়েজিয়ান উইঙ্গার আন্তোনিও নুসাকে দলে ভেড়াতে চায় প্রিমিয়ার লিগের ডিফেন্ডিং চ্যাম্পিয়ন &amp;amp;nbsp;আর্সেনাল। তবে জানুয়ারির শীতকালীন দলবদলে নুসাকে পাওয়া ইংলিশ ক্লাবটির জন্য কঠিন হতে পারে; আগামী গ্রীষ্মেই তাকে দলে নেওয়ার সম্ভাবনা বেশি বলে মনে করা হচ্&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%A8%E0%A6%A4%E0%A6%A8%E0%A6%93-%E0%A6%A8%E0%A6%B8%E0%A6%95-%E0%A6%A6%E0%A6%B2-%E0%A6%AD%E0%A7%9C%E0%A6%A4-%E0%A6%AE%E0%A6%B0%E0%A7%9F-%E0%A6%86%E0%A6%B0%E0%A6%B8%E0%A6%A8%E0%A6%B2">Education Bangla</source>
    </item>
    <item>
      <title>লর্ডসে প্রথমবার টি-টোয়েন্টি খেলবে বাংলাদেশ, সূচি চূড়ান্ত</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B2%E0%A6%B0%E0%A6%A1%E0%A6%B8-%E0%A6%AA%E0%A6%B0%E0%A6%A5%E0%A6%AE%E0%A6%AC%E0%A6%B0-%E0%A6%9F-%E0%A6%9F%E0%A7%9F%E0%A6%A8%E0%A6%9F-%E0%A6%96%E0%A6%B2%E0%A6%AC-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6-%E0%A6%B8%E0%A6%9A-%E0%A6%9A%E0%A7%9C%E0%A6%A8%E0%A6%A4</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%B2%E0%A6%B0%E0%A6%A1%E0%A6%B8-%E0%A6%AA%E0%A6%B0%E0%A6%A5%E0%A6%AE%E0%A6%AC%E0%A6%B0-%E0%A6%9F-%E0%A6%9F%E0%A7%9F%E0%A6%A8%E0%A6%9F-%E0%A6%96%E0%A6%B2%E0%A6%AC-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6-%E0%A6%B8%E0%A6%9A-%E0%A6%9A%E0%A7%9C%E0%A6%A8%E0%A6%A4</guid>
      <pubDate>Thu, 19 Nov 2026 14:08:09 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795097289_rkr_6aff02c979e95.JPG" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795097289_rkr_6aff02c979e95.JPG" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795097289_rkr_6aff02c979e95.JPG" style="max-width:100%;height:auto;margin-bottom:10px;" alt="লর্ডসে প্রথমবার টি-টোয়েন্টি খেলবে বাংলাদেশ, সূচি চূড়ান্ত" /&gt;&lt;/p&gt;&lt;p&gt;‘হোম অব ক্রিকেট’ খ্যাত লর্ডস ক্রিকেট গ্রাউন্ডে আন্তর্জাতিক টি-টোয়েন্টি ম্যাচ খেলতে যাচ্ছে বাংলাদেশ পুরুষ দল। আগামী বছরের ৩ জুন ঐতিহাসিক এই ভেন্যুতে নেপালের মুখোমুখি হবেন লিটন দাস ও তাওহিদ হৃদয়রা। মেরিলিবোন ক্রিকেট ক্লাবের (এমসিসি) আয়োজনে ম্যাচটি অনুষ্ঠিত হবে বলে এক সংবাদ বিজ্ঞপ্তিতে নিশ্চিত করেছে বা&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B2%E0%A6%B0%E0%A6%A1%E0%A6%B8-%E0%A6%AA%E0%A6%B0%E0%A6%A5%E0%A6%AE%E0%A6%AC%E0%A6%B0-%E0%A6%9F-%E0%A6%9F%E0%A7%9F%E0%A6%A8%E0%A6%9F-%E0%A6%96%E0%A6%B2%E0%A6%AC-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6-%E0%A6%B8%E0%A6%9A-%E0%A6%9A%E0%A7%9C%E0%A6%A8%E0%A6%A4">Education Bangla</source>
    </item>
    <item>
      <title>টি-টোয়েন্টিতে ৪০০ উইকেটের মাইলফলকে প্রথম ভারতীয় বোলার চাহাল</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%9F-%E0%A6%9F%E0%A7%9F%E0%A6%A8%E0%A6%9F%E0%A6%A4-%E0%A7%AA%E0%A7%A6%E0%A7%A6-%E0%A6%89%E0%A6%87%E0%A6%95%E0%A6%9F%E0%A6%B0-%E0%A6%AE%E0%A6%87%E0%A6%B2%E0%A6%AB%E0%A6%B2%E0%A6%95-%E0%A6%AA%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%AD%E0%A6%B0%E0%A6%A4%E0%A7%9F-%E0%A6%AC%E0%A6%B2%E0%A6%B0-%E0%A6%9A%E0%A6%B9%E0%A6%B2</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%9F-%E0%A6%9F%E0%A7%9F%E0%A6%A8%E0%A6%9F%E0%A6%A4-%E0%A7%AA%E0%A7%A6%E0%A7%A6-%E0%A6%89%E0%A6%87%E0%A6%95%E0%A6%9F%E0%A6%B0-%E0%A6%AE%E0%A6%87%E0%A6%B2%E0%A6%AB%E0%A6%B2%E0%A6%95-%E0%A6%AA%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%AD%E0%A6%B0%E0%A6%A4%E0%A7%9F-%E0%A6%AC%E0%A6%B2%E0%A6%B0-%E0%A6%9A%E0%A6%B9%E0%A6%B2</guid>
      <pubDate>Thu, 19 Nov 2026 14:06:48 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795097208_rkr_6aff027860e37.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795097208_rkr_6aff027860e37.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795097208_rkr_6aff027860e37.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টি-টোয়েন্টিতে ৪০০ উইকেটের মাইলফলকে প্রথম ভারতীয় বোলার চাহাল" /&gt;&lt;/p&gt;&lt;p&gt;টি-টোয়েন্টি ক্রিকেটে ইতিহাস গড়লেন ভারতের লেগ স্পিনার যুজবেন্দ্র চাহাল। প্রথম ভারতীয় বোলার হিসেবে স্বীকৃত টি-টোয়েন্টি ক্রিকেটে ৪০০ উইকেট শিকারের অনন্য কীর্তি গড়েছেন ৩৬ বছর বয়সী এই স্পিনার। খবর এনডিটিভির।বুধবার (১৯ নভেম্বর) সৈয়দ মুস্তাক আলী ট্রফির ২০২৬-২৭ মৌসুমে তামিলনাড়ুর বিপক্ষে হরিয়ানার হয়ে খেলতে ন&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%9F-%E0%A6%9F%E0%A7%9F%E0%A6%A8%E0%A6%9F%E0%A6%A4-%E0%A7%AA%E0%A7%A6%E0%A7%A6-%E0%A6%89%E0%A6%87%E0%A6%95%E0%A6%9F%E0%A6%B0-%E0%A6%AE%E0%A6%87%E0%A6%B2%E0%A6%AB%E0%A6%B2%E0%A6%95-%E0%A6%AA%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%AD%E0%A6%B0%E0%A6%A4%E0%A7%9F-%E0%A6%AC%E0%A6%B2%E0%A6%B0-%E0%A6%9A%E0%A6%B9%E0%A6%B2">Education Bangla</source>
    </item>
    <item>
      <title>শ্লটেরবেককে দলে ভেড়াতে রিয়াল-বার্সার লড়াই</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B6%E0%A6%B2%E0%A6%9F%E0%A6%B0%E0%A6%AC%E0%A6%95%E0%A6%95-%E0%A6%A6%E0%A6%B2-%E0%A6%AD%E0%A7%9C%E0%A6%A4-%E0%A6%B0%E0%A7%9F%E0%A6%B2-%E0%A6%AC%E0%A6%B0%E0%A6%B8%E0%A6%B0-%E0%A6%B2%E0%A7%9C%E0%A6%87</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%B6%E0%A6%B2%E0%A6%9F%E0%A6%B0%E0%A6%AC%E0%A6%95%E0%A6%95-%E0%A6%A6%E0%A6%B2-%E0%A6%AD%E0%A7%9C%E0%A6%A4-%E0%A6%B0%E0%A7%9F%E0%A6%B2-%E0%A6%AC%E0%A6%B0%E0%A6%B8%E0%A6%B0-%E0%A6%B2%E0%A7%9C%E0%A6%87</guid>
      <pubDate>Thu, 19 Nov 2026 14:05:23 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795097123_rkr_6aff0223e6fae.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795097123_rkr_6aff0223e6fae.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795097123_rkr_6aff0223e6fae.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শ্লটেরবেককে দলে ভেড়াতে রিয়াল-বার্সার লড়াই" /&gt;&lt;/p&gt;&lt;p&gt;জার্মান তারকা নিকো শ্লটেরবেককে দলে ভেড়াতে আগ্রহী হয়ে উঠেছে স্প্যানিশ দুই জায়ান্ট রিয়াল মাদ্রিদ ও বার্সেলোনা। আগামী গ্রীষ্মকালীন দলবদলে বরুশিয়া ডর্টমুন্ডের এই ডিফেন্ডারকে নিজেদের দলে পেতে আগেভাগেই তৎপরতা শুরু করেছে ক্লাব দুটি। খবর গোল ডটকমের।জার্মান সংবাদমাধ্যমের পাশাপাশি ট্রান্সফারবিষয়ক নির্ভরযোগ্য.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B6%E0%A6%B2%E0%A6%9F%E0%A6%B0%E0%A6%AC%E0%A6%95%E0%A6%95-%E0%A6%A6%E0%A6%B2-%E0%A6%AD%E0%A7%9C%E0%A6%A4-%E0%A6%B0%E0%A7%9F%E0%A6%B2-%E0%A6%AC%E0%A6%B0%E0%A6%B8%E0%A6%B0-%E0%A6%B2%E0%A7%9C%E0%A6%87">Education Bangla</source>
    </item>
    <item>
      <title>দ্বিতীয় টেস্টে খেলছেন না বাভুমা, নেতৃত্বে মার্করাম</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%A6%E0%A6%AC%E0%A6%A4%E0%A7%9F-%E0%A6%9F%E0%A6%B8%E0%A6%9F-%E0%A6%96%E0%A6%B2%E0%A6%9B%E0%A6%A8-%E0%A6%A8-%E0%A6%AC%E0%A6%AD%E0%A6%AE-%E0%A6%A8%E0%A6%A4%E0%A6%A4%E0%A6%AC-%E0%A6%AE%E0%A6%B0%E0%A6%95%E0%A6%B0%E0%A6%AE</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%A6%E0%A6%AC%E0%A6%A4%E0%A7%9F-%E0%A6%9F%E0%A6%B8%E0%A6%9F-%E0%A6%96%E0%A6%B2%E0%A6%9B%E0%A6%A8-%E0%A6%A8-%E0%A6%AC%E0%A6%AD%E0%A6%AE-%E0%A6%A8%E0%A6%A4%E0%A6%A4%E0%A6%AC-%E0%A6%AE%E0%A6%B0%E0%A6%95%E0%A6%B0%E0%A6%AE</guid>
      <pubDate>Thu, 19 Nov 2026 13:05:36 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795093536_rkr_6afef420ca9d1.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795093536_rkr_6afef420ca9d1.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795093536_rkr_6afef420ca9d1.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দ্বিতীয় টেস্টে খেলছেন না বাভুমা, নেতৃত্বে মার্করাম" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশের বিপক্ষে সিরিজের দ্বিতীয় টেস্টে খেলতে পারবেন না দক্ষিণ আফ্রিকার অধিনায়ক টেম্বা বাভুমা। জোহানেসবার্গে সিরিজের প্রথম টেস্ট চলাকালে ডান পায়ের কাফ মাসলে (পেশিতে) চোট পেয়েছেন তিনি। ফলে সুপারস্পোর্ট পার্কে আগামী টেস্টে দলের নেতৃত্ব দেয়ার কথা রয়েছে এইডেন মার্করামের। খবর ক্রিকইনফোর।বাভুমার অনুপস্থ&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%A6%E0%A6%AC%E0%A6%A4%E0%A7%9F-%E0%A6%9F%E0%A6%B8%E0%A6%9F-%E0%A6%96%E0%A6%B2%E0%A6%9B%E0%A6%A8-%E0%A6%A8-%E0%A6%AC%E0%A6%AD%E0%A6%AE-%E0%A6%A8%E0%A6%A4%E0%A6%A4%E0%A6%AC-%E0%A6%AE%E0%A6%B0%E0%A6%95%E0%A6%B0%E0%A6%AE">Education Bangla</source>
    </item>

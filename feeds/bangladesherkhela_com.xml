    <item>
      <title>‘গোল্ডেন বয়’ পুরস্কার জিতলেন কুবারসি</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%97%E0%A6%B2%E0%A6%A1%E0%A6%A8-%E0%A6%AC%E0%A7%9F-%E0%A6%AA%E0%A6%B0%E0%A6%B8%E0%A6%95%E0%A6%B0-%E0%A6%9C%E0%A6%A4%E0%A6%B2%E0%A6%A8-%E0%A6%95%E0%A6%AC%E0%A6%B0%E0%A6%B8</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%97%E0%A6%B2%E0%A6%A1%E0%A6%A8-%E0%A6%AC%E0%A7%9F-%E0%A6%AA%E0%A6%B0%E0%A6%B8%E0%A6%95%E0%A6%B0-%E0%A6%9C%E0%A6%A4%E0%A6%B2%E0%A6%A8-%E0%A6%95%E0%A6%AC%E0%A6%B0%E0%A6%B8</guid>
      <pubDate>Tue, 10 Nov 2026 07:39:27 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794296367_rkr_6af2ca2fbac35.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794296367_rkr_6af2ca2fbac35.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794296367_rkr_6af2ca2fbac35.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘গোল্ডেন বয়’ পুরস্কার জিতলেন কুবারসি" /&gt;&lt;/p&gt;&lt;p&gt;ইউরোপের অনূর্ধ্ব-২১ বর্ষসেরা ফুটবলারের পুরস্কার ‘গোল্ডেন বয়’ জিতেছেন স্পেন ও বার্সেলোনার তরুণ ডিফেন্ডার পাউ কুবারসি। আর্জেন্টিনার দুই প্রতিভাবান ফুটবলার ফ্রাঙ্কো মাস্তানতুয়োনো ও জিয়ানলুকা প্রেস্টিয়ানিকে পেছনে ফেলে ২০২৬ সালের এই পুরস্কার জিতেছেন ১৯ বছর বয়সী এই স্প্যানিশ তারকা। খবর টিওয়াইসি স্পোর্টসের&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%97%E0%A6%B2%E0%A6%A1%E0%A6%A8-%E0%A6%AC%E0%A7%9F-%E0%A6%AA%E0%A6%B0%E0%A6%B8%E0%A6%95%E0%A6%B0-%E0%A6%9C%E0%A6%A4%E0%A6%B2%E0%A6%A8-%E0%A6%95%E0%A6%AC%E0%A6%B0%E0%A6%B8">Education Bangla</source>
    </item>
    <item>
      <title>ইংল্যান্ড সফরে দুটি টেস্ট খেলবে বাংলাদেশ</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%87%E0%A6%B2%E0%A6%AF%E0%A6%A8%E0%A6%A1-%E0%A6%B8%E0%A6%AB%E0%A6%B0-%E0%A6%A6%E0%A6%9F-%E0%A6%9F%E0%A6%B8%E0%A6%9F-%E0%A6%96%E0%A6%B2%E0%A6%AC-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%87%E0%A6%B2%E0%A6%AF%E0%A6%A8%E0%A6%A1-%E0%A6%B8%E0%A6%AB%E0%A6%B0-%E0%A6%A6%E0%A6%9F-%E0%A6%9F%E0%A6%B8%E0%A6%9F-%E0%A6%96%E0%A6%B2%E0%A6%AC-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6</guid>
      <pubDate>Tue, 10 Nov 2026 07:38:11 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794296291_rkr_6af2c9e333716.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794296291_rkr_6af2c9e333716.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794296291_rkr_6af2c9e333716.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইংল্যান্ড সফরে দুটি টেস্ট খেলবে বাংলাদেশ" /&gt;&lt;/p&gt;&lt;p&gt;দীর্ঘ ১৭ বছর পর আগামী বছর ইংল্যান্ড সফরে যাবে বাংলাদেশ। সফরে লর্ডসে স্বাগতিক ইংল্যান্ডের বিপক্ষে একটি টেস্ট খেলার কথা থাকলেও ম্যাচের সংখ্যা বাড়িয়েছে বাংলাদেশ ক্রিকেট বোর্ড (বিসিবি)। ইংল্যান্ডের বিপক্ষে টেস্টের আগে আয়ারল্যান্ডের বিপক্ষেও একটি টেস্ট খেলবে বাংলাদেশ।আয়ারল্যান্ডের বিপক্ষে ম্যাচটি অনুষ্ঠি&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%87%E0%A6%B2%E0%A6%AF%E0%A6%A8%E0%A6%A1-%E0%A6%B8%E0%A6%AB%E0%A6%B0-%E0%A6%A6%E0%A6%9F-%E0%A6%9F%E0%A6%B8%E0%A6%9F-%E0%A6%96%E0%A6%B2%E0%A6%AC-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6">Education Bangla</source>
    </item>
    <item>
      <title>আইপিএলের সময়সূচি বদলের প্রস্তাবে মোদির পাশে কলকাতা</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%87%E0%A6%AA%E0%A6%8F%E0%A6%B2%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A7%9F%E0%A6%B8%E0%A6%9A-%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%B8%E0%A6%A4%E0%A6%AC-%E0%A6%AE%E0%A6%A6%E0%A6%B0-%E0%A6%AA%E0%A6%B6-%E0%A6%95%E0%A6%B2%E0%A6%95%E0%A6%A4</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%87%E0%A6%AA%E0%A6%8F%E0%A6%B2%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A7%9F%E0%A6%B8%E0%A6%9A-%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%B8%E0%A6%A4%E0%A6%AC-%E0%A6%AE%E0%A6%A6%E0%A6%B0-%E0%A6%AA%E0%A6%B6-%E0%A6%95%E0%A6%B2%E0%A6%95%E0%A6%A4</guid>
      <pubDate>Tue, 10 Nov 2026 07:36:17 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794296177_rkr_6af2c9712ff8f.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794296177_rkr_6af2c9712ff8f.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794296177_rkr_6af2c9712ff8f.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আইপিএলের সময়সূচি বদলের প্রস্তাবে মোদির পাশে কলকাতা" /&gt;&lt;/p&gt;&lt;p&gt;প্রচণ্ড গরমে আইপিএল খেলতে গিয়ে ভোগান্তিতে পড়েন ক্রিকেটার থেকে শুরু করে দর্শকেরাও। তাপপ্রবাহের মধ্যে মাঠে খেলা চালিয়ে যাওয়ার পাশাপাশি দর্শকদের গ্যালারিতে বসে ম্যাচ উপভোগ করাও হয়ে ওঠে কঠিন। এবার সেই বাস্তবতা বিবেচনায় নিয়ে আইপিএলের সময়সূচি বদলের প্রস্তাব দিয়েছেন টুর্নামেন্টের প্রতিষ্ঠাতা ললিত মোদি। তার&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%87%E0%A6%AA%E0%A6%8F%E0%A6%B2%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A7%9F%E0%A6%B8%E0%A6%9A-%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%B8%E0%A6%A4%E0%A6%AC-%E0%A6%AE%E0%A6%A6%E0%A6%B0-%E0%A6%AA%E0%A6%B6-%E0%A6%95%E0%A6%B2%E0%A6%95%E0%A6%A4">Education Bangla</source>
    </item>
    <item>
      <title>আর্জেন্টিনার হয়ে খেলতে বাধা, মলিনাকে ছাড়ছে না রোমা</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%B0%E0%A6%9C%E0%A6%A8%E0%A6%9F%E0%A6%A8%E0%A6%B0-%E0%A6%B9%E0%A7%9F-%E0%A6%96%E0%A6%B2%E0%A6%A4-%E0%A6%AC%E0%A6%A7-%E0%A6%AE%E0%A6%B2%E0%A6%A8%E0%A6%95-%E0%A6%9B%E0%A7%9C%E0%A6%9B-%E0%A6%A8-%E0%A6%B0%E0%A6%AE</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%B0%E0%A6%9C%E0%A6%A8%E0%A6%9F%E0%A6%A8%E0%A6%B0-%E0%A6%B9%E0%A7%9F-%E0%A6%96%E0%A6%B2%E0%A6%A4-%E0%A6%AC%E0%A6%A7-%E0%A6%AE%E0%A6%B2%E0%A6%A8%E0%A6%95-%E0%A6%9B%E0%A7%9C%E0%A6%9B-%E0%A6%A8-%E0%A6%B0%E0%A6%AE</guid>
      <pubDate>Tue, 10 Nov 2026 07:35:32 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794296132_rkr_6af2c9443a524.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794296132_rkr_6af2c9443a524.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794296132_rkr_6af2c9443a524.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আর্জেন্টিনার হয়ে খেলতে বাধা, মলিনাকে ছাড়ছে না রোমা" /&gt;&lt;/p&gt;&lt;p&gt;আন্তর্জাতিক বিরতিতে জাতীয় দলের জার্সিতে মাঠে নামার অপেক্ষায় ছিলেন নাহুয়েল মলিনা। ফিফার নিষেধাজ্ঞা কমে যাওয়ায় আর্জেন্টিনার হয়ে খেলার পথও প্রায় খুলে গিয়েছিল তার সামনে। কিন্তু শেষ পর্যন্ত সেই সুযোগ মিলছে না। নিষেধাজ্ঞার হিসাব চুকিয়ে কোস্টারিকার বিপক্ষে মাঠে নামার সম্ভাবনা থাকলেও মলিনাকে ইতালিতে রেখে দি&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%B0%E0%A6%9C%E0%A6%A8%E0%A6%9F%E0%A6%A8%E0%A6%B0-%E0%A6%B9%E0%A7%9F-%E0%A6%96%E0%A6%B2%E0%A6%A4-%E0%A6%AC%E0%A6%A7-%E0%A6%AE%E0%A6%B2%E0%A6%A8%E0%A6%95-%E0%A6%9B%E0%A7%9C%E0%A6%9B-%E0%A6%A8-%E0%A6%B0%E0%A6%AE">Education Bangla</source>
    </item>
    <item>
      <title>বাফুফের ৫ বারের সাধারণ সম্পাদক হারুনুর রশীদ আর নেই</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%AB%E0%A6%AB%E0%A6%B0-%E0%A7%AB-%E0%A6%AC%E0%A6%B0%E0%A6%B0-%E0%A6%B8%E0%A6%A7%E0%A6%B0%E0%A6%A3-%E0%A6%B8%E0%A6%AE%E0%A6%AA%E0%A6%A6%E0%A6%95-%E0%A6%B9%E0%A6%B0%E0%A6%A8%E0%A6%B0-%E0%A6%B0%E0%A6%B6%E0%A6%A6-%E0%A6%86%E0%A6%B0-%E0%A6%A8%E0%A6%87</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%AB%E0%A6%AB%E0%A6%B0-%E0%A7%AB-%E0%A6%AC%E0%A6%B0%E0%A6%B0-%E0%A6%B8%E0%A6%A7%E0%A6%B0%E0%A6%A3-%E0%A6%B8%E0%A6%AE%E0%A6%AA%E0%A6%A6%E0%A6%95-%E0%A6%B9%E0%A6%B0%E0%A6%A8%E0%A6%B0-%E0%A6%B0%E0%A6%B6%E0%A6%A6-%E0%A6%86%E0%A6%B0-%E0%A6%A8%E0%A6%87</guid>
      <pubDate>Tue, 10 Nov 2026 07:34:27 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_media/1794296052_6af2c8f44381a.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_media/1794296052_6af2c8f44381a.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_media/1794296052_6af2c8f44381a.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাফুফের ৫ বারের সাধারণ সম্পাদক হারুনুর রশীদ আর নেই" /&gt;&lt;/p&gt;&lt;p&gt;দেশের ক্রীড়াঙ্গনে নেমে এসেছে শোকের ছায়া। আবাহনী ক্রীড়া চক্রের প্রতিষ্ঠাকালীন সাধারণ সম্পাদক ও বাংলাদেশ ফুটবল ফেডারেশনের (বাফুফে) পাঁচবারের সাবেক সাধারণ সম্পাদক হারুনুর রশীদ আর নেই (ইন্না লিল্লাহি ওয়া ইন্না ইলাইহি রাজিউন)। সোমবার (৯ নভেম্বর) দিবাগত রাত ১২টার দিকে রাজধানীর ল্যাবএইড হাসপাতালে চিকিৎসাধী&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%AB%E0%A6%AB%E0%A6%B0-%E0%A7%AB-%E0%A6%AC%E0%A6%B0%E0%A6%B0-%E0%A6%B8%E0%A6%A7%E0%A6%B0%E0%A6%A3-%E0%A6%B8%E0%A6%AE%E0%A6%AA%E0%A6%A6%E0%A6%95-%E0%A6%B9%E0%A6%B0%E0%A6%A8%E0%A6%B0-%E0%A6%B0%E0%A6%B6%E0%A6%A6-%E0%A6%86%E0%A6%B0-%E0%A6%A8%E0%A6%87">Education Bangla</source>
    </item>
    <item>
      <title>তিন ৫০০তে টেস্ট ক্রিকেটে ইতিহাস</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%A4%E0%A6%A8-%E0%A7%AB%E0%A7%A6%E0%A7%A6%E0%A6%A4-%E0%A6%9F%E0%A6%B8%E0%A6%9F-%E0%A6%95%E0%A6%B0%E0%A6%95%E0%A6%9F-%E0%A6%87%E0%A6%A4%E0%A6%B9%E0%A6%B8</link>

    <item>
      <title>অ্যাডিডাসের রাজত্বে ইতি, চ্যাম্পিয়নস লিগের বল নিয়ে আসছে নাইকি</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%85%E0%A6%AF%E0%A6%A1%E0%A6%A1%E0%A6%B8%E0%A6%B0-%E0%A6%B0%E0%A6%9C%E0%A6%A4%E0%A6%AC-%E0%A6%87%E0%A6%A4-%E0%A6%9A%E0%A6%AF%E0%A6%AE%E0%A6%AA%E0%A7%9F%E0%A6%A8%E0%A6%B8-%E0%A6%B2%E0%A6%97%E0%A6%B0-%E0%A6%AC%E0%A6%B2-%E0%A6%A8%E0%A7%9F-%E0%A6%86%E0%A6%B8%E0%A6%9B-%E0%A6%A8%E0%A6%87%E0%A6%95</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%85%E0%A6%AF%E0%A6%A1%E0%A6%A1%E0%A6%B8%E0%A6%B0-%E0%A6%B0%E0%A6%9C%E0%A6%A4%E0%A6%AC-%E0%A6%87%E0%A6%A4-%E0%A6%9A%E0%A6%AF%E0%A6%AE%E0%A6%AA%E0%A7%9F%E0%A6%A8%E0%A6%B8-%E0%A6%B2%E0%A6%97%E0%A6%B0-%E0%A6%AC%E0%A6%B2-%E0%A6%A8%E0%A7%9F-%E0%A6%86%E0%A6%B8%E0%A6%9B-%E0%A6%A8%E0%A6%87%E0%A6%95</guid>
      <pubDate>Mon, 16 Nov 2026 16:05:29 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794845129_rkr_6afb29c9dfb10.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794845129_rkr_6afb29c9dfb10.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794845129_rkr_6afb29c9dfb10.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অ্যাডিডাসের রাজত্বে ইতি, চ্যাম্পিয়নস লিগের বল নিয়ে আসছে নাইকি" /&gt;&lt;/p&gt;&lt;p&gt;ফুটবলের সবচেয়ে মর্যাদাপূর্ণ ক্লাব প্রতিযোগিতার মাঠে এবার দেখা যাবে নতুন পরিবর্তন। দীর্ঘদিন ধরে চ্যাম্পিয়নস লিগের বল সরবরাহ করে আসা অ্যাডিডাসের জায়গা নিতে যাচ্ছে মার্কিন ক্রীড়াসামগ্রী নির্মাতা প্রতিষ্ঠান নাইকি। ২০২৭-২৮ মৌসুম থেকে ইউরোপীয় ফুটবলের শীর্ষ ক্লাব প্রতিযোগিতাগুলোতে অফিসিয়াল বল সরবরাহ করবে প&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%85%E0%A6%AF%E0%A6%A1%E0%A6%A1%E0%A6%B8%E0%A6%B0-%E0%A6%B0%E0%A6%9C%E0%A6%A4%E0%A6%AC-%E0%A6%87%E0%A6%A4-%E0%A6%9A%E0%A6%AF%E0%A6%AE%E0%A6%AA%E0%A7%9F%E0%A6%A8%E0%A6%B8-%E0%A6%B2%E0%A6%97%E0%A6%B0-%E0%A6%AC%E0%A6%B2-%E0%A6%A8%E0%A7%9F-%E0%A6%86%E0%A6%B8%E0%A6%9B-%E0%A6%A8%E0%A6%87%E0%A6%95">Education Bangla</source>
    </item>
    <item>
      <title>উয়েফা নেশনস লিগে কোয়ার্টার ফাইনাল নিশ্চিত করেছে যারা</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%89%E0%A6%AF%E0%A6%AB-%E0%A6%A8%E0%A6%B6%E0%A6%A8%E0%A6%B8-%E0%A6%B2%E0%A6%97-%E0%A6%95%E0%A6%AF%E0%A6%B0%E0%A6%9F%E0%A6%B0-%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2-%E0%A6%A8%E0%A6%B6%E0%A6%9A%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%9B-%E0%A6%AF%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%89%E0%A6%AF%E0%A6%AB-%E0%A6%A8%E0%A6%B6%E0%A6%A8%E0%A6%B8-%E0%A6%B2%E0%A6%97-%E0%A6%95%E0%A6%AF%E0%A6%B0%E0%A6%9F%E0%A6%B0-%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2-%E0%A6%A8%E0%A6%B6%E0%A6%9A%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%9B-%E0%A6%AF%E0%A6%B0</guid>
      <pubDate>Mon, 16 Nov 2026 16:01:26 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794844886_rkr_6afb28d6ef209.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794844886_rkr_6afb28d6ef209.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794844886_rkr_6afb28d6ef209.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="উয়েফা নেশনস লিগে কোয়ার্টার ফাইনাল নিশ্চিত করেছে যারা" /&gt;&lt;/p&gt;&lt;p&gt;উয়েফা নেশনস লিগের এবারের আসরে ইউরোপের পরাশক্তি দলগুলো নিজেদের আধিপত্য বজায় রেখে নকআউট পর্বের পথে অনেকটাই এগিয়ে গেছে। গ্রুপ পর্বের জমজমাট লড়াইয়ের শেষ মুহূর্তে এসে আট দলের কোয়ার্টার ফাইনাল নিশ্চিত করার দৌড়ে এখন পর্যন্ত সেরা পাঁচ দল চূড়ান্ত টিকিট হাতে পেয়েছে। বাকি তিনটি স্থানের ফয়সালা হবে চলতি সপ্তাহ&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%89%E0%A6%AF%E0%A6%AB-%E0%A6%A8%E0%A6%B6%E0%A6%A8%E0%A6%B8-%E0%A6%B2%E0%A6%97-%E0%A6%95%E0%A6%AF%E0%A6%B0%E0%A6%9F%E0%A6%B0-%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2-%E0%A6%A8%E0%A6%B6%E0%A6%9A%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%9B-%E0%A6%AF%E0%A6%B0">Education Bangla</source>
    </item>
    <item>
      <title>শেষ সেশনে ৩ উইকেট শিকার বাংলাদেশের</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B6%E0%A6%B7-%E0%A6%B8%E0%A6%B6%E0%A6%A8-%E0%A7%A9-%E0%A6%89%E0%A6%87%E0%A6%95%E0%A6%9F-%E0%A6%B6%E0%A6%95%E0%A6%B0-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%B6%E0%A6%B7-%E0%A6%B8%E0%A6%B6%E0%A6%A8-%E0%A7%A9-%E0%A6%89%E0%A6%87%E0%A6%95%E0%A6%9F-%E0%A6%B6%E0%A6%95%E0%A6%B0-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6%E0%A6%B0</guid>
      <pubDate>Mon, 16 Nov 2026 15:58:51 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794844731_rkr_6afb283b79079.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794844731_rkr_6afb283b79079.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794844731_rkr_6afb283b79079.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শেষ সেশনে ৩ উইকেট শিকার বাংলাদেশের" /&gt;&lt;/p&gt;&lt;p&gt;দক্ষিণ আফ্রিকার মাটিতে প্রথম এশীয় দল হিসেবে টেস্টের প্রথম ইনিংসে ৪০০ রান করেছে বাংলাদেশ। জোহানেসবার্গে প্রথম ইনিংসে এতো রান তুলে কোনো দলেরই হারের রেকর্ড নেই। দক্ষিণ আফ্রিকার ইনিংসের শুরুতেই এইডেন মার্করামকে আউট করে টাইগার সমর্থকদের আরও আশাবাদী করে তুলেছিলেন হাসান মাহমুদ। কিন্তু এরপরই পরিস্থিতি আমূল.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B6%E0%A6%B7-%E0%A6%B8%E0%A6%B6%E0%A6%A8-%E0%A7%A9-%E0%A6%89%E0%A6%87%E0%A6%95%E0%A6%9F-%E0%A6%B6%E0%A6%95%E0%A6%B0-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6%E0%A6%B0">Education Bangla</source>
    </item>
    <item>
      <title>‘ভারতকে বিপদে ফেলার কৌশল জানা আছে’</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AD%E0%A6%B0%E0%A6%A4%E0%A6%95-%E0%A6%AC%E0%A6%AA%E0%A6%A6-%E0%A6%AB%E0%A6%B2%E0%A6%B0-%E0%A6%95%E0%A6%B6%E0%A6%B2-%E0%A6%9C%E0%A6%A8-%E0%A6%86%E0%A6%9B</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AD%E0%A6%B0%E0%A6%A4%E0%A6%95-%E0%A6%AC%E0%A6%AA%E0%A6%A6-%E0%A6%AB%E0%A6%B2%E0%A6%B0-%E0%A6%95%E0%A6%B6%E0%A6%B2-%E0%A6%9C%E0%A6%A8-%E0%A6%86%E0%A6%9B</guid>
      <pubDate>Mon, 16 Nov 2026 15:49:57 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794844197_rkr_6afb26258749f.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794844197_rkr_6afb26258749f.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794844197_rkr_6afb26258749f.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘ভারতকে বিপদে ফেলার কৌশল জানা আছে’" /&gt;&lt;/p&gt;&lt;p&gt;দক্ষিণ এশিয়ার ফুটবলে এতদিন ‘সহজ প্রতিপক্ষ’ হিসেবে পরিচিত পাকিস্তানের পরিচিতিটাই এবার পুরোপুরি পাল্টে দিয়েছেন নলবার্তো সোলানো।স্বাগতিক বাংলাদেশকে ১-০ গোলে হারিয়ে প্রথমবারের মতো সাফ চ্যাম্পিয়নশিপের ফাইনালে নাম লেখানোর পর এবার রেকর্ড নয়বারের চ্যাম্পিয়ন ভারতের মুখোমুখি হতে যাচ্ছে পাকিস্তান।ঐতিহাসিক এই ফ&lt;/p&gt;</description>

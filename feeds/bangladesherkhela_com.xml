      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794139780_rkr_6af0668453982.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গার্দিওলা-আনচেলত্তিসহ সবাইকে ছাড়িয়ে গেলেন মরিনিয়ো" /&gt;&lt;/p&gt;&lt;p&gt;টানা অষ্টম ম্যাচে জয় তুলে নিয়ে শুরুতে কিছুটা ছন্দ হারানো রিয়াল মাদ্রিদ লড়াইয়ে ফিরেছে। হোসে মরিনিয়োর অধীনে স্কোয়াডে বড় রদবদল আনা হয়েছিল। তবে ফল পেতে সময় লেগেছে কিছুটা। এরই মাঝে লা লিগায় সর্বোচ্চ জয়ের হারে সবাইকে পেছনে ফেলেছেন ‘দ্য স্পেশাল ওয়ান’খ্যাত এই পর্তুগিজ কোচ।গতকাল প্রতিপক্ষ ভ্যালেন্সিয়ার মাঠে.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%97%E0%A6%B0%E0%A6%A6%E0%A6%93%E0%A6%B2-%E0%A6%86%E0%A6%A8%E0%A6%9A%E0%A6%B2%E0%A6%A4%E0%A6%A4%E0%A6%B8%E0%A6%B9-%E0%A6%B8%E0%A6%AC%E0%A6%87%E0%A6%95-%E0%A6%9B%E0%A7%9C%E0%A7%9F-%E0%A6%97%E0%A6%B2%E0%A6%A8-%E0%A6%AE%E0%A6%B0%E0%A6%A8%E0%A7%9F">Education Bangla</source>
    </item>
    <item>
      <title>আর্জেন্টিনা ম্যাচে আলোচিত সেই কোচকে বরখাস্ত করল মিসর</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%B0%E0%A6%9C%E0%A6%A8%E0%A6%9F%E0%A6%A8-%E0%A6%AE%E0%A6%AF%E0%A6%9A-%E0%A6%86%E0%A6%B2%E0%A6%9A%E0%A6%A4-%E0%A6%B8%E0%A6%87-%E0%A6%95%E0%A6%9A%E0%A6%95-%E0%A6%AC%E0%A6%B0%E0%A6%96%E0%A6%B8%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%B2-%E0%A6%AE%E0%A6%B8%E0%A6%B0-1</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%B0%E0%A6%9C%E0%A6%A8%E0%A6%9F%E0%A6%A8-%E0%A6%AE%E0%A6%AF%E0%A6%9A-%E0%A6%86%E0%A6%B2%E0%A6%9A%E0%A6%A4-%E0%A6%B8%E0%A6%87-%E0%A6%95%E0%A6%9A%E0%A6%95-%E0%A6%AC%E0%A6%B0%E0%A6%96%E0%A6%B8%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%B2-%E0%A6%AE%E0%A6%B8%E0%A6%B0-1</guid>
      <pubDate>Sun, 08 Nov 2026 12:08:28 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794139708_rkr_6af0663ce18c1.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794139708_rkr_6af0663ce18c1.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794139708_rkr_6af0663ce18c1.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আর্জেন্টিনা ম্যাচে আলোচিত সেই কোচকে বরখাস্ত করল মিসর" /&gt;&lt;/p&gt;&lt;p&gt;বিশ্বকাপে আর্জেন্টিনার বিপক্ষে রোমাঞ্চকর ম্যাচে অন্যতম আলোচিত ব্যক্তি ছিলেন মিসরের কোচ হোসাম হাসান। তার পাশাপাশি দেশটির তারকা ফুটবলার মোস্তফা জিকো ম্যাচে রেফারির বিতর্কিত সিদ্ধান্তের সমালোচনা করেছিলেন। যে কারণে সম্প্রতি কোচকে তিন ম্যাচ এবং জিকোকে পাঁচ ম্যাচ নিষিদ্ধ করেছে ফিফা। এবার বিশ্বকাপের আলোচিত&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%B0%E0%A6%9C%E0%A6%A8%E0%A6%9F%E0%A6%A8-%E0%A6%AE%E0%A6%AF%E0%A6%9A-%E0%A6%86%E0%A6%B2%E0%A6%9A%E0%A6%A4-%E0%A6%B8%E0%A6%87-%E0%A6%95%E0%A6%9A%E0%A6%95-%E0%A6%AC%E0%A6%B0%E0%A6%96%E0%A6%B8%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%B2-%E0%A6%AE%E0%A6%B8%E0%A6%B0-1">Education Bangla</source>
    </item>
    <item>
      <title>লিগে সেরা শুরুর রেকর্ড ছুঁয়েও হতাশ আর্সেনাল কোচ</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B2%E0%A6%97-%E0%A6%B8%E0%A6%B0-%E0%A6%B6%E0%A6%B0%E0%A6%B0-%E0%A6%B0%E0%A6%95%E0%A6%B0%E0%A6%A1-%E0%A6%9B%E0%A7%9F%E0%A6%93-%E0%A6%B9%E0%A6%A4%E0%A6%B6-%E0%A6%86%E0%A6%B0%E0%A6%B8%E0%A6%A8%E0%A6%B2-%E0%A6%95%E0%A6%9A</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%B2%E0%A6%97-%E0%A6%B8%E0%A6%B0-%E0%A6%B6%E0%A6%B0%E0%A6%B0-%E0%A6%B0%E0%A6%95%E0%A6%B0%E0%A6%A1-%E0%A6%9B%E0%A7%9F%E0%A6%93-%E0%A6%B9%E0%A6%A4%E0%A6%B6-%E0%A6%86%E0%A6%B0%E0%A6%B8%E0%A6%A8%E0%A6%B2-%E0%A6%95%E0%A6%9A</guid>
      <pubDate>Sun, 08 Nov 2026 12:07:27 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794139647_rkr_6af065ff3ae29.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794139647_rkr_6af065ff3ae29.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794139647_rkr_6af065ff3ae29.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="লিগে সেরা শুরুর রেকর্ড ছুঁয়েও হতাশ আর্সেনাল কোচ" /&gt;&lt;/p&gt;&lt;p&gt;পরিষ্কার সুযোগের অভাবে হাল সিটির বিপক্ষে প্রতিপক্ষের রক্ষণ ভাঙতে হিমশিম খেতে হয়েছে আর্সেনালকে। অধিনায়ক মার্টিন ওডেগার্ডের ৭২তম মিনিটের একমাত্র গোলে ম্যাচটি জেতে তারা। চলতি মৌসুমে এনিয়ে সব প্রতিযোগিতা মিলে আটটি ম্যাচ তারা জিতল এক গোলের ব্যবধানে। হাল সিটির বিপক্ষে ১-০ গোলে ম্যাচ জেতার পর তাই হতাশ কোচ.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B2%E0%A6%97-%E0%A6%B8%E0%A6%B0-%E0%A6%B6%E0%A6%B0%E0%A6%B0-%E0%A6%B0%E0%A6%95%E0%A6%B0%E0%A6%A1-%E0%A6%9B%E0%A7%9F%E0%A6%93-%E0%A6%B9%E0%A6%A4%E0%A6%B6-%E0%A6%86%E0%A6%B0%E0%A6%B8%E0%A6%A8%E0%A6%B2-%E0%A6%95%E0%A6%9A">Education Bangla</source>
    </item>
    <item>
      <title>খাজার দাবি নিয়ে ইংল্যান্ড লিজেন্ডের প্রশ্ন</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%96%E0%A6%9C%E0%A6%B0-%E0%A6%A6%E0%A6%AC-%E0%A6%A8%E0%A7%9F-%E0%A6%87%E0%A6%B2%E0%A6%AF%E0%A6%A8%E0%A6%A1-%E0%A6%B2%E0%A6%9C%E0%A6%A8%E0%A6%A1%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%B6%E0%A6%A8</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%96%E0%A6%9C%E0%A6%B0-%E0%A6%A6%E0%A6%AC-%E0%A6%A8%E0%A7%9F-%E0%A6%87%E0%A6%B2%E0%A6%AF%E0%A6%A8%E0%A6%A1-%E0%A6%B2%E0%A6%9C%E0%A6%A8%E0%A6%A1%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%B6%E0%A6%A8</guid>

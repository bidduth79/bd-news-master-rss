      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794501372_rkr_6af5eafc9d2b1.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="তায়কোয়ানডোর মানোন্নয়নে ২০০ কোচকে নিয়ে বিশেষ প্রশিক্ষণ" /&gt;&lt;/p&gt;&lt;p&gt;দেশে তায়কোয়ানডোর প্রশিক্ষণ ব্যবস্থার মানোন্নয়ন এবং দক্ষ কোচ তৈরির লক্ষ্যে তিন দিনব্যাপী বিশেষ প্রশিক্ষণ কর্মসূচি শুরু করেছে বাংলাদেশ তায়কোয়ানডো ফেডারেশন। বৃহস্পতিবার জাতীয় ক্রীড়া পরিষদ জিমনেশিয়ামে শুরু হয়েছে ‘কোচেস ট্রেনিং অ্যান্ড রিফ্রেশার কোর্স-২০২৬’।উদ্বোধনী অনুষ্ঠানে বিশেষ অতিথি হিসেবে উপস্থিত ছ&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%A4%E0%A7%9F%E0%A6%95%E0%A7%9F%E0%A6%A8%E0%A6%A1%E0%A6%B0-%E0%A6%AE%E0%A6%A8%E0%A6%A8%E0%A6%A8%E0%A7%9F%E0%A6%A8-%E0%A7%A8%E0%A7%A6%E0%A7%A6-%E0%A6%95%E0%A6%9A%E0%A6%95-%E0%A6%A8%E0%A7%9F-%E0%A6%AC%E0%A6%B6%E0%A6%B7-%E0%A6%AA%E0%A6%B0%E0%A6%B6%E0%A6%95%E0%A6%B7%E0%A6%A3">Education Bangla</source>
    </item>
    <item>
      <title>আরও এক টেস্টে সিরিশ কাগজ দিয়ে বল বিকৃত করেছিল অস্ট্রেলিয়া!</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A6%8F%E0%A6%95-%E0%A6%9F%E0%A6%B8%E0%A6%9F-%E0%A6%B8%E0%A6%B0%E0%A6%B6-%E0%A6%95%E0%A6%97%E0%A6%9C-%E0%A6%A6%E0%A7%9F-%E0%A6%AC%E0%A6%B2-%E0%A6%AC%E0%A6%95%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%9B%E0%A6%B2-%E0%A6%85%E0%A6%B8%E0%A6%9F%E0%A6%B0%E0%A6%B2%E0%A7%9F</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A6%8F%E0%A6%95-%E0%A6%9F%E0%A6%B8%E0%A6%9F-%E0%A6%B8%E0%A6%B0%E0%A6%B6-%E0%A6%95%E0%A6%97%E0%A6%9C-%E0%A6%A6%E0%A7%9F-%E0%A6%AC%E0%A6%B2-%E0%A6%AC%E0%A6%95%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%9B%E0%A6%B2-%E0%A6%85%E0%A6%B8%E0%A6%9F%E0%A6%B0%E0%A6%B2%E0%A7%9F</guid>

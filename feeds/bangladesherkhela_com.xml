    <item>
      <title>অ্যাডিডাসের রাজত্বে ইতি, চ্যাম্পিয়নস লিগের বল নিয়ে আসছে নাইকি</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%85%E0%A6%AF%E0%A6%A1%E0%A6%A1%E0%A6%B8%E0%A6%B0-%E0%A6%B0%E0%A6%9C%E0%A6%A4%E0%A6%AC-%E0%A6%87%E0%A6%A4-%E0%A6%9A%E0%A6%AF%E0%A6%AE%E0%A6%AA%E0%A7%9F%E0%A6%A8%E0%A6%B8-%E0%A6%B2%E0%A6%97%E0%A6%B0-%E0%A6%AC%E0%A6%B2-%E0%A6%A8%E0%A7%9F-%E0%A6%86%E0%A6%B8%E0%A6%9B-%E0%A6%A8%E0%A6%87%E0%A6%95</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%85%E0%A6%AF%E0%A6%A1%E0%A6%A1%E0%A6%B8%E0%A6%B0-%E0%A6%B0%E0%A6%9C%E0%A6%A4%E0%A6%AC-%E0%A6%87%E0%A6%A4-%E0%A6%9A%E0%A6%AF%E0%A6%AE%E0%A6%AA%E0%A7%9F%E0%A6%A8%E0%A6%B8-%E0%A6%B2%E0%A6%97%E0%A6%B0-%E0%A6%AC%E0%A6%B2-%E0%A6%A8%E0%A7%9F-%E0%A6%86%E0%A6%B8%E0%A6%9B-%E0%A6%A8%E0%A6%87%E0%A6%95</guid>
      <pubDate>Mon, 16 Nov 2026 16:05:29 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794845129_rkr_6afb29c9dfb10.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794845129_rkr_6afb29c9dfb10.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794845129_rkr_6afb29c9dfb10.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অ্যাডিডাসের রাজত্বে ইতি, চ্যাম্পিয়নস লিগের বল নিয়ে আসছে নাইকি" /&gt;&lt;/p&gt;&lt;p&gt;ফুটবলের সবচেয়ে মর্যাদাপূর্ণ ক্লাব প্রতিযোগিতার মাঠে এবার দেখা যাবে নতুন পরিবর্তন। দীর্ঘদিন ধরে চ্যাম্পিয়নস লিগের বল সরবরাহ করে আসা অ্যাডিডাসের জায়গা নিতে যাচ্ছে মার্কিন ক্রীড়াসামগ্রী নির্মাতা প্রতিষ্ঠান নাইকি। ২০২৭-২৮ মৌসুম থেকে ইউরোপীয় ফুটবলের শীর্ষ ক্লাব প্রতিযোগিতাগুলোতে অফিসিয়াল বল সরবরাহ করবে প&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%85%E0%A6%AF%E0%A6%A1%E0%A6%A1%E0%A6%B8%E0%A6%B0-%E0%A6%B0%E0%A6%9C%E0%A6%A4%E0%A6%AC-%E0%A6%87%E0%A6%A4-%E0%A6%9A%E0%A6%AF%E0%A6%AE%E0%A6%AA%E0%A7%9F%E0%A6%A8%E0%A6%B8-%E0%A6%B2%E0%A6%97%E0%A6%B0-%E0%A6%AC%E0%A6%B2-%E0%A6%A8%E0%A7%9F-%E0%A6%86%E0%A6%B8%E0%A6%9B-%E0%A6%A8%E0%A6%87%E0%A6%95">Education Bangla</source>
    </item>
    <item>
      <title>উয়েফা নেশনস লিগে কোয়ার্টার ফাইনাল নিশ্চিত করেছে যারা</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%89%E0%A6%AF%E0%A6%AB-%E0%A6%A8%E0%A6%B6%E0%A6%A8%E0%A6%B8-%E0%A6%B2%E0%A6%97-%E0%A6%95%E0%A6%AF%E0%A6%B0%E0%A6%9F%E0%A6%B0-%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2-%E0%A6%A8%E0%A6%B6%E0%A6%9A%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%9B-%E0%A6%AF%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%89%E0%A6%AF%E0%A6%AB-%E0%A6%A8%E0%A6%B6%E0%A6%A8%E0%A6%B8-%E0%A6%B2%E0%A6%97-%E0%A6%95%E0%A6%AF%E0%A6%B0%E0%A6%9F%E0%A6%B0-%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2-%E0%A6%A8%E0%A6%B6%E0%A6%9A%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%9B-%E0%A6%AF%E0%A6%B0</guid>
      <pubDate>Mon, 16 Nov 2026 16:01:26 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794844886_rkr_6afb28d6ef209.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794844886_rkr_6afb28d6ef209.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794844886_rkr_6afb28d6ef209.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="উয়েফা নেশনস লিগে কোয়ার্টার ফাইনাল নিশ্চিত করেছে যারা" /&gt;&lt;/p&gt;&lt;p&gt;উয়েফা নেশনস লিগের এবারের আসরে ইউরোপের পরাশক্তি দলগুলো নিজেদের আধিপত্য বজায় রেখে নকআউট পর্বের পথে অনেকটাই এগিয়ে গেছে। গ্রুপ পর্বের জমজমাট লড়াইয়ের শেষ মুহূর্তে এসে আট দলের কোয়ার্টার ফাইনাল নিশ্চিত করার দৌড়ে এখন পর্যন্ত সেরা পাঁচ দল চূড়ান্ত টিকিট হাতে পেয়েছে। বাকি তিনটি স্থানের ফয়সালা হবে চলতি সপ্তাহ&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%89%E0%A6%AF%E0%A6%AB-%E0%A6%A8%E0%A6%B6%E0%A6%A8%E0%A6%B8-%E0%A6%B2%E0%A6%97-%E0%A6%95%E0%A6%AF%E0%A6%B0%E0%A6%9F%E0%A6%B0-%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2-%E0%A6%A8%E0%A6%B6%E0%A6%9A%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%9B-%E0%A6%AF%E0%A6%B0">Education Bangla</source>
    </item>
    <item>
      <title>শেষ সেশনে ৩ উইকেট শিকার বাংলাদেশের</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B6%E0%A6%B7-%E0%A6%B8%E0%A6%B6%E0%A6%A8-%E0%A7%A9-%E0%A6%89%E0%A6%87%E0%A6%95%E0%A6%9F-%E0%A6%B6%E0%A6%95%E0%A6%B0-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%B6%E0%A6%B7-%E0%A6%B8%E0%A6%B6%E0%A6%A8-%E0%A7%A9-%E0%A6%89%E0%A6%87%E0%A6%95%E0%A6%9F-%E0%A6%B6%E0%A6%95%E0%A6%B0-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6%E0%A6%B0</guid>
      <pubDate>Mon, 16 Nov 2026 15:58:51 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794844731_rkr_6afb283b79079.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794844731_rkr_6afb283b79079.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794844731_rkr_6afb283b79079.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শেষ সেশনে ৩ উইকেট শিকার বাংলাদেশের" /&gt;&lt;/p&gt;&lt;p&gt;দক্ষিণ আফ্রিকার মাটিতে প্রথম এশীয় দল হিসেবে টেস্টের প্রথম ইনিংসে ৪০০ রান করেছে বাংলাদেশ। জোহানেসবার্গে প্রথম ইনিংসে এতো রান তুলে কোনো দলেরই হারের রেকর্ড নেই। দক্ষিণ আফ্রিকার ইনিংসের শুরুতেই এইডেন মার্করামকে আউট করে টাইগার সমর্থকদের আরও আশাবাদী করে তুলেছিলেন হাসান মাহমুদ। কিন্তু এরপরই পরিস্থিতি আমূল.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B6%E0%A6%B7-%E0%A6%B8%E0%A6%B6%E0%A6%A8-%E0%A7%A9-%E0%A6%89%E0%A6%87%E0%A6%95%E0%A6%9F-%E0%A6%B6%E0%A6%95%E0%A6%B0-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6%E0%A6%B0">Education Bangla</source>
    </item>
    <item>
      <title>‘ভারতকে বিপদে ফেলার কৌশল জানা আছে’</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AD%E0%A6%B0%E0%A6%A4%E0%A6%95-%E0%A6%AC%E0%A6%AA%E0%A6%A6-%E0%A6%AB%E0%A6%B2%E0%A6%B0-%E0%A6%95%E0%A6%B6%E0%A6%B2-%E0%A6%9C%E0%A6%A8-%E0%A6%86%E0%A6%9B</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AD%E0%A6%B0%E0%A6%A4%E0%A6%95-%E0%A6%AC%E0%A6%AA%E0%A6%A6-%E0%A6%AB%E0%A6%B2%E0%A6%B0-%E0%A6%95%E0%A6%B6%E0%A6%B2-%E0%A6%9C%E0%A6%A8-%E0%A6%86%E0%A6%9B</guid>
      <pubDate>Mon, 16 Nov 2026 15:49:57 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794844197_rkr_6afb26258749f.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794844197_rkr_6afb26258749f.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794844197_rkr_6afb26258749f.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘ভারতকে বিপদে ফেলার কৌশল জানা আছে’" /&gt;&lt;/p&gt;&lt;p&gt;দক্ষিণ এশিয়ার ফুটবলে এতদিন ‘সহজ প্রতিপক্ষ’ হিসেবে পরিচিত পাকিস্তানের পরিচিতিটাই এবার পুরোপুরি পাল্টে দিয়েছেন নলবার্তো সোলানো।স্বাগতিক বাংলাদেশকে ১-০ গোলে হারিয়ে প্রথমবারের মতো সাফ চ্যাম্পিয়নশিপের ফাইনালে নাম লেখানোর পর এবার রেকর্ড নয়বারের চ্যাম্পিয়ন ভারতের মুখোমুখি হতে যাচ্ছে পাকিস্তান।ঐতিহাসিক এই ফ&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AD%E0%A6%B0%E0%A6%A4%E0%A6%95-%E0%A6%AC%E0%A6%AA%E0%A6%A6-%E0%A6%AB%E0%A6%B2%E0%A6%B0-%E0%A6%95%E0%A6%B6%E0%A6%B2-%E0%A6%9C%E0%A6%A8-%E0%A6%86%E0%A6%9B">Education Bangla</source>
    </item>
    <item>
      <title>সাফের ফাইনালে পাকিস্তানকে ফেবারিট মানছেন না ভারত কোচ</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%AB%E0%A6%B0-%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2-%E0%A6%AA%E0%A6%95%E0%A6%B8%E0%A6%A4%E0%A6%A8%E0%A6%95-%E0%A6%AB%E0%A6%AC%E0%A6%B0%E0%A6%9F-%E0%A6%AE%E0%A6%A8%E0%A6%9B%E0%A6%A8-%E0%A6%A8-%E0%A6%AD%E0%A6%B0%E0%A6%A4-%E0%A6%95%E0%A6%9A</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%AB%E0%A6%B0-%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2-%E0%A6%AA%E0%A6%95%E0%A6%B8%E0%A6%A4%E0%A6%A8%E0%A6%95-%E0%A6%AB%E0%A6%AC%E0%A6%B0%E0%A6%9F-%E0%A6%AE%E0%A6%A8%E0%A6%9B%E0%A6%A8-%E0%A6%A8-%E0%A6%AD%E0%A6%B0%E0%A6%A4-%E0%A6%95%E0%A6%9A</guid>
      <pubDate>Mon, 16 Nov 2026 15:49:08 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794844148_rkr_6afb25f446a2f.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794844148_rkr_6afb25f446a2f.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794844148_rkr_6afb25f446a2f.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাফের ফাইনালে পাকিস্তানকে ফেবারিট মানছেন না ভারত কোচ" /&gt;&lt;/p&gt;&lt;p&gt;স্বাগতিক বাংলাদেশকে ১-০ গোলে হারিয়ে প্রথমবারের মতো সাফ চ্যাম্পিয়নশিপের ফাইনালে উঠেছে পাকিস্তান। দারুণ পারফরম্যান্সে শিরোপার লড়াইয়ে অনেকের চোখেই এগিয়ে দলটি।তবে ফাইনালের আগে পাকিস্তানকে ফেবারিট মানতে নারাজ ভারতের প্রধান কোচ নওশাদ মুসা। তার মতে, ভারতকে হারাতে পারলেই কেবল ফেবারিটের তকমা পাবে পাকিস্তান।ম&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%AB%E0%A6%B0-%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2-%E0%A6%AA%E0%A6%95%E0%A6%B8%E0%A6%A4%E0%A6%A8%E0%A6%95-%E0%A6%AB%E0%A6%AC%E0%A6%B0%E0%A6%9F-%E0%A6%AE%E0%A6%A8%E0%A6%9B%E0%A6%A8-%E0%A6%A8-%E0%A6%AD%E0%A6%B0%E0%A6%A4-%E0%A6%95%E0%A6%9A">Education Bangla</source>
    </item>
    <item>
      <title>আবাহনী-মোহামেডানের প্রীতি ম্যাচ, দুই দলের হয়েই খেলবেন আমিনুল</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%AC%E0%A6%B9%E0%A6%A8-%E0%A6%AE%E0%A6%B9%E0%A6%AE%E0%A6%A1%E0%A6%A8%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%A4-%E0%A6%AE%E0%A6%AF%E0%A6%9A-%E0%A6%A6%E0%A6%87-%E0%A6%A6%E0%A6%B2%E0%A6%B0-%E0%A6%B9%E0%A7%9F%E0%A6%87-%E0%A6%96%E0%A6%B2%E0%A6%AC%E0%A6%A8-%E0%A6%86%E0%A6%AE%E0%A6%A8%E0%A6%B2</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%AC%E0%A6%B9%E0%A6%A8-%E0%A6%AE%E0%A6%B9%E0%A6%AE%E0%A6%A1%E0%A6%A8%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%A4-%E0%A6%AE%E0%A6%AF%E0%A6%9A-%E0%A6%A6%E0%A6%87-%E0%A6%A6%E0%A6%B2%E0%A6%B0-%E0%A6%B9%E0%A7%9F%E0%A6%87-%E0%A6%96%E0%A6%B2%E0%A6%AC%E0%A6%A8-%E0%A6%86%E0%A6%AE%E0%A6%A8%E0%A6%B2</guid>
      <pubDate>Mon, 16 Nov 2026 15:48:21 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794844101_rkr_6afb25c570fed.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794844101_rkr_6afb25c570fed.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794844101_rkr_6afb25c570fed.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আবাহনী-মোহামেডানের প্রীতি ম্যাচ, দুই দলের হয়েই খেলবেন আমিনুল" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশের ফুটবলে আবাহনী-মোহামেডান মানেই চিরপ্রতিদ্বন্দ্বিতার উত্তাপ। দুই দলের লড়াই ঘিরে সমর্থকদের মধ্যে থাকে বাড়তি উন্মাদনা।তবে এবার সেই প্রতিদ্বন্দ্বিতার বাইরে সম্প্রীতি ও পুনর্মিলনের বার্তা নিয়ে মাঠে নামছেন দুই ক্লাবের সাবেক ফুটবলাররা। আগামী ১৯ নভেম্বরের এই বিশেষ প্রীতি ম্যাচে দুই দলের হয়েই খেলবে&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%AC%E0%A6%B9%E0%A6%A8-%E0%A6%AE%E0%A6%B9%E0%A6%AE%E0%A6%A1%E0%A6%A8%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%A4-%E0%A6%AE%E0%A6%AF%E0%A6%9A-%E0%A6%A6%E0%A6%87-%E0%A6%A6%E0%A6%B2%E0%A6%B0-%E0%A6%B9%E0%A7%9F%E0%A6%87-%E0%A6%96%E0%A6%B2%E0%A6%AC%E0%A6%A8-%E0%A6%86%E0%A6%AE%E0%A6%A8%E0%A6%B2">Education Bangla</source>
    </item>
    <item>
      <title>নতুন দায়িত্ব উপভোগ করছেন আশরাফুল</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%A8%E0%A6%A4%E0%A6%A8-%E0%A6%A6%E0%A7%9F%E0%A6%A4%E0%A6%AC-%E0%A6%89%E0%A6%AA%E0%A6%AD%E0%A6%97-%E0%A6%95%E0%A6%B0%E0%A6%9B%E0%A6%A8-%E0%A6%86%E0%A6%B6%E0%A6%B0%E0%A6%AB%E0%A6%B2</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%A8%E0%A6%A4%E0%A6%A8-%E0%A6%A6%E0%A7%9F%E0%A6%A4%E0%A6%AC-%E0%A6%89%E0%A6%AA%E0%A6%AD%E0%A6%97-%E0%A6%95%E0%A6%B0%E0%A6%9B%E0%A6%A8-%E0%A6%86%E0%A6%B6%E0%A6%B0%E0%A6%AB%E0%A6%B2</guid>
      <pubDate>Mon, 16 Nov 2026 15:47:27 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794844047_rkr_6afb258f0f8fd.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794844047_rkr_6afb258f0f8fd.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794844047_rkr_6afb258f0f8fd.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নতুন দায়িত্ব উপভোগ করছেন আশরাফুল" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ জাতীয় দলের কোচিং প্যানেল থেকে বাদ পড়লেও নতুন দায়িত্ব নিয়ে বেশ উপভোগ করছেন মোহাম্মদ আশরাফুল। বাংলাদেশ ‘এ’ দলের সহকারী কোচ হিসেবে কাজ করতে পেরে খুশি সাবেক এই ব্যাটিং কোচ।তার মতে, কোচদের চেয়ে চাপটা বেশি থাকে খেলোয়াড়দের ওপর।আগামী রাইজিং স্টার্স এশিয়া কাপ সামনে রেখে বাংলাদেশ ‘এ’ দলের সহকারী কোচ.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%A8%E0%A6%A4%E0%A6%A8-%E0%A6%A6%E0%A7%9F%E0%A6%A4%E0%A6%AC-%E0%A6%89%E0%A6%AA%E0%A6%AD%E0%A6%97-%E0%A6%95%E0%A6%B0%E0%A6%9B%E0%A6%A8-%E0%A6%86%E0%A6%B6%E0%A6%B0%E0%A6%AB%E0%A6%B2">Education Bangla</source>
    </item>
    <item>
      <title>দ্বিতীয় মেয়াদে আইসিসির চেয়ারম্যান হওয়ায় জয় শাহকে তামিমের অভিনন্দন</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%A6%E0%A6%AC%E0%A6%A4%E0%A7%9F-%E0%A6%AE%E0%A7%9F%E0%A6%A6-%E0%A6%86%E0%A6%87%E0%A6%B8%E0%A6%B8%E0%A6%B0-%E0%A6%9A%E0%A7%9F%E0%A6%B0%E0%A6%AE%E0%A6%AF%E0%A6%A8-%E0%A6%B9%E0%A6%93%E0%A7%9F%E0%A7%9F-%E0%A6%9C%E0%A7%9F-%E0%A6%B6%E0%A6%B9%E0%A6%95-%E0%A6%A4%E0%A6%AE%E0%A6%AE%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%A8%E0%A6%A8%E0%A6%A6%E0%A6%A8</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%A6%E0%A6%AC%E0%A6%A4%E0%A7%9F-%E0%A6%AE%E0%A7%9F%E0%A6%A6-%E0%A6%86%E0%A6%87%E0%A6%B8%E0%A6%B8%E0%A6%B0-%E0%A6%9A%E0%A7%9F%E0%A6%B0%E0%A6%AE%E0%A6%AF%E0%A6%A8-%E0%A6%B9%E0%A6%93%E0%A7%9F%E0%A7%9F-%E0%A6%9C%E0%A7%9F-%E0%A6%B6%E0%A6%B9%E0%A6%95-%E0%A6%A4%E0%A6%AE%E0%A6%AE%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%A8%E0%A6%A8%E0%A6%A6%E0%A6%A8</guid>
      <pubDate>Mon, 16 Nov 2026 15:46:46 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794844006_rkr_6afb256649c63.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794844006_rkr_6afb256649c63.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794844006_rkr_6afb256649c63.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দ্বিতীয় মেয়াদে আইসিসির চেয়ারম্যান হওয়ায় জয় শাহকে তামিমের অভিনন্দন" /&gt;&lt;/p&gt;&lt;p&gt;আন্তর্জাতিক ক্রিকেট কাউন্সিলের (আইসিসি) চেয়ারম্যান হিসেবে দ্বিতীয় মেয়াদে বিনা প্রতিদ্বন্দ্বিতায় পুনর্নির্বাচিত হয়েছেন জয় শাহ। নতুন মেয়াদে দায়িত্ব পাওয়ায় তাকে অভিনন্দন জানিয়েছেন বাংলাদেশের সাবেক অধিনায়ক ও বিসিবি সভাপতি তামিম ইকবাল খান।সামাজিক যোগাযোগমাধ্যম এক্সে দেওয়া এক বার্তায় জয় শাহকে শুভেচ্ছা জান&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%A6%E0%A6%AC%E0%A6%A4%E0%A7%9F-%E0%A6%AE%E0%A7%9F%E0%A6%A6-%E0%A6%86%E0%A6%87%E0%A6%B8%E0%A6%B8%E0%A6%B0-%E0%A6%9A%E0%A7%9F%E0%A6%B0%E0%A6%AE%E0%A6%AF%E0%A6%A8-%E0%A6%B9%E0%A6%93%E0%A7%9F%E0%A7%9F-%E0%A6%9C%E0%A7%9F-%E0%A6%B6%E0%A6%B9%E0%A6%95-%E0%A6%A4%E0%A6%AE%E0%A6%AE%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%A8%E0%A6%A8%E0%A6%A6%E0%A6%A8">Education Bangla</source>
    </item>
    <item>
      <title>দিলারার ফিফটি বিফলে, ক্যালিসের ব্যাটে নেদারল্যান্ডসের জয়</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%A6%E0%A6%B2%E0%A6%B0%E0%A6%B0-%E0%A6%AB%E0%A6%AB%E0%A6%9F-%E0%A6%AC%E0%A6%AB%E0%A6%B2-%E0%A6%95%E0%A6%AF%E0%A6%B2%E0%A6%B8%E0%A6%B0-%E0%A6%AC%E0%A6%AF%E0%A6%9F-%E0%A6%A8%E0%A6%A6%E0%A6%B0%E0%A6%B2%E0%A6%AF%E0%A6%A8%E0%A6%A1%E0%A6%B8%E0%A6%B0-%E0%A6%9C%E0%A7%9F</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%A6%E0%A6%B2%E0%A6%B0%E0%A6%B0-%E0%A6%AB%E0%A6%AB%E0%A6%9F-%E0%A6%AC%E0%A6%AB%E0%A6%B2-%E0%A6%95%E0%A6%AF%E0%A6%B2%E0%A6%B8%E0%A6%B0-%E0%A6%AC%E0%A6%AF%E0%A6%9F-%E0%A6%A8%E0%A6%A6%E0%A6%B0%E0%A6%B2%E0%A6%AF%E0%A6%A8%E0%A6%A1%E0%A6%B8%E0%A6%B0-%E0%A6%9C%E0%A7%9F</guid>
      <pubDate>Mon, 16 Nov 2026 15:46:00 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794843960_rkr_6afb2538eb7b3.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794843960_rkr_6afb2538eb7b3.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794843960_rkr_6afb2538eb7b3.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দিলারার ফিফটি বিফলে, ক্যালিসের ব্যাটে নেদারল্যান্ডসের জয়" /&gt;&lt;/p&gt;&lt;p&gt;আইসিসি উইমেন্স ইমার্জিং নেশনস টুর্নামেন্টে জয়ের দেখা পেল না বাংলাদেশ নারী দল। গ্রুপ পর্বের ১৩তম ম্যাচে নেদারল্যান্ডস নারী দলের কাছে ৫ উইকেটে হেরেছে নিগার সুলতানার দল।বাংলাদেশের দেওয়া ১৩০ রানের লক্ষ্য ২ বল হাতে রেখেই পেরিয়ে যায় ডাচরা। তাদের জয়ের নায়ক স্টেরে ক্যালিস।৫০ বলে ৬৮ রানের অপরাজিত ইনিংস খেলে.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%A6%E0%A6%B2%E0%A6%B0%E0%A6%B0-%E0%A6%AB%E0%A6%AB%E0%A6%9F-%E0%A6%AC%E0%A6%AB%E0%A6%B2-%E0%A6%95%E0%A6%AF%E0%A6%B2%E0%A6%B8%E0%A6%B0-%E0%A6%AC%E0%A6%AF%E0%A6%9F-%E0%A6%A8%E0%A6%A6%E0%A6%B0%E0%A6%B2%E0%A6%AF%E0%A6%A8%E0%A6%A1%E0%A6%B8%E0%A6%B0-%E0%A6%9C%E0%A7%9F">Education Bangla</source>
    </item>
    <item>
      <title>বিশ্বকাপ আয়োজনে ভারতের সঙ্গী বাংলাদেশ, সূচি চূড়ান্ত</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%B6%E0%A6%AC%E0%A6%95%E0%A6%AA-%E0%A6%86%E0%A7%9F%E0%A6%9C%E0%A6%A8-%E0%A6%AD%E0%A6%B0%E0%A6%A4%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A6%97-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6-%E0%A6%B8%E0%A6%9A-%E0%A6%9A%E0%A7%9C%E0%A6%A8%E0%A6%A4</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%B6%E0%A6%AC%E0%A6%95%E0%A6%AA-%E0%A6%86%E0%A7%9F%E0%A6%9C%E0%A6%A8-%E0%A6%AD%E0%A6%B0%E0%A6%A4%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A6%97-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6-%E0%A6%B8%E0%A6%9A-%E0%A6%9A%E0%A7%9C%E0%A6%A8%E0%A6%A4</guid>
      <pubDate>Mon, 16 Nov 2026 15:45:23 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794843923_rkr_6afb25136cc57.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794843923_rkr_6afb25136cc57.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794843923_rkr_6afb25136cc57.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিশ্বকাপ আয়োজনে ভারতের সঙ্গী বাংলাদেশ, সূচি চূড়ান্ত" /&gt;&lt;/p&gt;&lt;p&gt;ভারত ও বাংলাদেশের যৌথ আয়োজনে ২০৩১ সালে বসবে ওয়ানডে বিশ্বকাপের আসর। টুর্নামেন্টটির সম্ভাব্য সময়সূচি চূড়ান্ত করেছে আন্তর্জাতিক ক্রিকেট কাউন্সিল (আইসিসি)।৯ অক্টোবর শুরু হয়ে ২৩ নভেম্বর ফাইনালের মধ্য দিয়ে শেষ হবে ক্রিকেটের এই বৈশ্বিক আয়োজন।২০৩৫ সাল পর্যন্ত পুরুষদের আন্তর্জাতিক ক্রিকেটের বড় টুর্নামেন্টগুল&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%B6%E0%A6%AC%E0%A6%95%E0%A6%AA-%E0%A6%86%E0%A7%9F%E0%A6%9C%E0%A6%A8-%E0%A6%AD%E0%A6%B0%E0%A6%A4%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A6%97-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6-%E0%A6%B8%E0%A6%9A-%E0%A6%9A%E0%A7%9C%E0%A6%A8%E0%A6%A4">Education Bangla</source>
    </item>
    <item>
      <title>সাফ নিয়ে বিতর্কিত মন্তব্য, শ্রীলঙ্কার কুয়েতি কোচের ৫০০ ডলার জরিমানা</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%AB-%E0%A6%A8%E0%A7%9F-%E0%A6%AC%E0%A6%A4%E0%A6%B0%E0%A6%95%E0%A6%A4-%E0%A6%AE%E0%A6%A8%E0%A6%A4%E0%A6%AC%E0%A6%AF-%E0%A6%B6%E0%A6%B0%E0%A6%B2%E0%A6%99%E0%A6%95%E0%A6%B0-%E0%A6%95%E0%A7%9F%E0%A6%A4-%E0%A6%95%E0%A6%9A%E0%A6%B0-%E0%A7%AB%E0%A7%A6%E0%A7%A6-%E0%A6%A1%E0%A6%B2%E0%A6%B0-%E0%A6%9C%E0%A6%B0%E0%A6%AE%E0%A6%A8</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%AB-%E0%A6%A8%E0%A7%9F-%E0%A6%AC%E0%A6%A4%E0%A6%B0%E0%A6%95%E0%A6%A4-%E0%A6%AE%E0%A6%A8%E0%A6%A4%E0%A6%AC%E0%A6%AF-%E0%A6%B6%E0%A6%B0%E0%A6%B2%E0%A6%99%E0%A6%95%E0%A6%B0-%E0%A6%95%E0%A7%9F%E0%A6%A4-%E0%A6%95%E0%A6%9A%E0%A6%B0-%E0%A7%AB%E0%A7%A6%E0%A7%A6-%E0%A6%A1%E0%A6%B2%E0%A6%B0-%E0%A6%9C%E0%A6%B0%E0%A6%AE%E0%A6%A8</guid>
      <pubDate>Mon, 16 Nov 2026 15:44:36 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794843876_rkr_6afb24e444605.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794843876_rkr_6afb24e444605.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794843876_rkr_6afb24e444605.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাফ নিয়ে বিতর্কিত মন্তব্য, শ্রীলঙ্কার কুয়েতি কোচের ৫০০ ডলার জরিমানা" /&gt;&lt;/p&gt;&lt;p&gt;সাফ চ্যাম্পিয়নশিপে আচরণবিধি ভঙ্গের দায়ে শাস্তির মুখোমুখি হয়েছেন শ্রীলঙ্কা জাতীয় ফুটবল দলের কুয়েতি কোচ আব্দুল্লাহ আল মুতাইরি। দক্ষিণ এশীয় ফুটবল ফেডারেশনের (সাফ) অনলাইন শৃঙ্খলা কমিটির বৈঠকে তাকে ৫০০ মার্কিন ডলার অর্থদণ্ড দেওয়া হয়েছে।একই সঙ্গে ভবিষ্যতে এমন আচরণ থেকে বিরত থাকতে তাকে কঠোর সতর্কবাণীও দেওয়&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%AB-%E0%A6%A8%E0%A7%9F-%E0%A6%AC%E0%A6%A4%E0%A6%B0%E0%A6%95%E0%A6%A4-%E0%A6%AE%E0%A6%A8%E0%A6%A4%E0%A6%AC%E0%A6%AF-%E0%A6%B6%E0%A6%B0%E0%A6%B2%E0%A6%99%E0%A6%95%E0%A6%B0-%E0%A6%95%E0%A7%9F%E0%A6%A4-%E0%A6%95%E0%A6%9A%E0%A6%B0-%E0%A7%AB%E0%A7%A6%E0%A7%A6-%E0%A6%A1%E0%A6%B2%E0%A6%B0-%E0%A6%9C%E0%A6%B0%E0%A6%AE%E0%A6%A8">Education Bangla</source>
    </item>
    <item>
      <title>রোনালদোর বিদায়ের পর এবার তিন তারকাকে হারাল পর্তুগাল</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B0%E0%A6%A8%E0%A6%B2%E0%A6%A6%E0%A6%B0-%E0%A6%AC%E0%A6%A6%E0%A7%9F%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%8F%E0%A6%AC%E0%A6%B0-%E0%A6%A4%E0%A6%A8-%E0%A6%A4%E0%A6%B0%E0%A6%95%E0%A6%95-%E0%A6%B9%E0%A6%B0%E0%A6%B2-%E0%A6%AA%E0%A6%B0%E0%A6%A4%E0%A6%97%E0%A6%B2</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%B0%E0%A6%A8%E0%A6%B2%E0%A6%A6%E0%A6%B0-%E0%A6%AC%E0%A6%A6%E0%A7%9F%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%8F%E0%A6%AC%E0%A6%B0-%E0%A6%A4%E0%A6%A8-%E0%A6%A4%E0%A6%B0%E0%A6%95%E0%A6%95-%E0%A6%B9%E0%A6%B0%E0%A6%B2-%E0%A6%AA%E0%A6%B0%E0%A6%A4%E0%A6%97%E0%A6%B2</guid>
      <pubDate>Mon, 16 Nov 2026 15:43:55 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794843835_rkr_6afb24bb069a2.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794843835_rkr_6afb24bb069a2.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794843835_rkr_6afb24bb069a2.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রোনালদোর বিদায়ের পর এবার তিন তারকাকে হারাল পর্তুগাল" /&gt;&lt;/p&gt;&lt;p&gt;ক্রিস্টিয়ানো রোনালদোর বিদায়ের পর প্রথম ম্যাচেই ডেনমার্কের কাছে ৪-১ গোলে হেরেছে পর্তুগাল। সেই ধাক্কা সামলে ওঠার আগেই আরও দুঃসংবাদ পেল দলটি।উয়েফা নেশন্স লিগে ওয়েলসের বিপক্ষে গ্রুপ পর্বের শেষ ম্যাচের আগে দল থেকে ছিটকে গেছেন তিন গুরুত্বপূর্ণ ফুটবলার। নিষেধাজ্ঞার কারণে খেলতে পারবেন না রুবেন দিয়াস ও জোয়াও&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B0%E0%A6%A8%E0%A6%B2%E0%A6%A6%E0%A6%B0-%E0%A6%AC%E0%A6%A6%E0%A7%9F%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%8F%E0%A6%AC%E0%A6%B0-%E0%A6%A4%E0%A6%A8-%E0%A6%A4%E0%A6%B0%E0%A6%95%E0%A6%95-%E0%A6%B9%E0%A6%B0%E0%A6%B2-%E0%A6%AA%E0%A6%B0%E0%A6%A4%E0%A6%97%E0%A6%B2">Education Bangla</source>
    </item>
    <item>
      <title>রোনালদোর দেশের ক্লাবের মালিকানায় বাংলাদেশী!</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B0%E0%A6%A8%E0%A6%B2%E0%A6%A6%E0%A6%B0-%E0%A6%A6%E0%A6%B6%E0%A6%B0-%E0%A6%95%E0%A6%B2%E0%A6%AC%E0%A6%B0-%E0%A6%AE%E0%A6%B2%E0%A6%95%E0%A6%A8%E0%A7%9F-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%B0%E0%A6%A8%E0%A6%B2%E0%A6%A6%E0%A6%B0-%E0%A6%A6%E0%A6%B6%E0%A6%B0-%E0%A6%95%E0%A6%B2%E0%A6%AC%E0%A6%B0-%E0%A6%AE%E0%A6%B2%E0%A6%95%E0%A6%A8%E0%A7%9F-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6</guid>
      <pubDate>Mon, 16 Nov 2026 14:43:47 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794840227_rkr_6afb16a3071c7.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794840227_rkr_6afb16a3071c7.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794840227_rkr_6afb16a3071c7.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রোনালদোর দেশের ক্লাবের মালিকানায় বাংলাদেশী!" /&gt;&lt;/p&gt;&lt;p&gt;ইউরোপের ফুটবলে যুক্ত হলো বাংলাদেশের নাম। পর্তুগালের একটি ফুটবল ক্লাবের মালিকানা নিয়েছে বাংলাদেশি বিনিয়োগকারীর নেতৃত্বাধীন প্রতিষ্ঠান আর্গোনাট স্পোর্টস ক্যাপিটাল। ক্লাবটির নতুন মালিকানায় রয়েছেন বাংলাদেশি বিনিয়োগকারী ইশতিয়াক রউফ। এর মধ্য দিয়ে ইউরোপীয় ফুটবলের সঙ্গে বাংলাদেশের ফুটবলের নতুন সংযোগ&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B0%E0%A6%A8%E0%A6%B2%E0%A6%A6%E0%A6%B0-%E0%A6%A6%E0%A6%B6%E0%A6%B0-%E0%A6%95%E0%A6%B2%E0%A6%AC%E0%A6%B0-%E0%A6%AE%E0%A6%B2%E0%A6%95%E0%A6%A8%E0%A7%9F-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6">Education Bangla</source>
    </item>
    <item>
      <title>&amp;#039;ব্রাজিল প্রতিযোগিতা করার মতো পর্যায়ে নেই&amp;#039;,- স্বীকার করলেন আনচেলত্তি</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%B0%E0%A6%9C%E0%A6%B2-%E0%A6%AA%E0%A6%B0%E0%A6%A4%E0%A6%AF%E0%A6%97%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%B0-%E0%A6%AE%E0%A6%A4-%E0%A6%AA%E0%A6%B0%E0%A6%AF%E0%A7%9F-%E0%A6%A8%E0%A6%87-%E0%A6%B8%E0%A6%AC%E0%A6%95%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A6%A8-%E0%A6%86%E0%A6%A8%E0%A6%9A%E0%A6%B2%E0%A6%A4%E0%A6%A4</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%B0%E0%A6%9C%E0%A6%B2-%E0%A6%AA%E0%A6%B0%E0%A6%A4%E0%A6%AF%E0%A6%97%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%B0-%E0%A6%AE%E0%A6%A4-%E0%A6%AA%E0%A6%B0%E0%A6%AF%E0%A7%9F-%E0%A6%A8%E0%A6%87-%E0%A6%B8%E0%A6%AC%E0%A6%95%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A6%A8-%E0%A6%86%E0%A6%A8%E0%A6%9A%E0%A6%B2%E0%A6%A4%E0%A6%A4</guid>
      <pubDate>Mon, 16 Nov 2026 14:13:32 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794838412_rkr_6afb0f8c56673.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794838412_rkr_6afb0f8c56673.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794838412_rkr_6afb0f8c56673.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="&amp;#039;ব্রাজিল প্রতিযোগিতা করার মতো পর্যায়ে নেই&amp;#039;,- স্বীকার করলেন আনচেলত্তি" /&gt;&lt;/p&gt;&lt;p&gt;জাপানের বিপক্ষে হতাশার হারের পর ২০২৬ সালের শেষ ম্যাচে মাঠে নামার আগে নিজের কাজ ও দলের বর্তমান অবস্থা নিয়ে খোলামেলা কথা বলেছেন ব্রাজিল জাতীয় দলের কোচ কার্লো আনচেলত্তি। সিঙ্গাপুরে অনুষ্ঠিত সংবাদ সম্মেলনে ইতালিয়ান এই কোচ স্বীকার করেছেন যে, জাতীয় দলের বর্তমান পারফরম্যান্স প্রত্যাশার চেয়ে পিছিয়ে রয়েছে এব&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%B0%E0%A6%9C%E0%A6%B2-%E0%A6%AA%E0%A6%B0%E0%A6%A4%E0%A6%AF%E0%A6%97%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%B0-%E0%A6%AE%E0%A6%A4-%E0%A6%AA%E0%A6%B0%E0%A6%AF%E0%A7%9F-%E0%A6%A8%E0%A6%87-%E0%A6%B8%E0%A6%AC%E0%A6%95%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A6%A8-%E0%A6%86%E0%A6%A8%E0%A6%9A%E0%A6%B2%E0%A6%A4%E0%A6%A4">Education Bangla</source>
    </item>
    <item>
      <title>বেলজিয়ামের সর্বোচ্চ গোলদাতার অবসর ঘোষণা</title>

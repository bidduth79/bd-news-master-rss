    <item>
      <title>ড্রয়ে শেষ সিলেট টেস্ট, ১–০ ব্যবধানে সিরিজ হারল বাংলাদেশ</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%A1%E0%A6%B0%E0%A7%9F-%E0%A6%B6%E0%A6%B7-%E0%A6%B8%E0%A6%B2%E0%A6%9F-%E0%A6%9F%E0%A6%B8%E0%A6%9F-%E0%A7%A7%E0%A7%A6-%E0%A6%AC%E0%A6%AF%E0%A6%AC%E0%A6%A7%E0%A6%A8-%E0%A6%B8%E0%A6%B0%E0%A6%9C-%E0%A6%B9%E0%A6%B0%E0%A6%B2-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%A1%E0%A6%B0%E0%A7%9F-%E0%A6%B6%E0%A6%B7-%E0%A6%B8%E0%A6%B2%E0%A6%9F-%E0%A6%9F%E0%A6%B8%E0%A6%9F-%E0%A7%A7%E0%A7%A6-%E0%A6%AC%E0%A6%AF%E0%A6%AC%E0%A6%A7%E0%A6%A8-%E0%A6%B8%E0%A6%B0%E0%A6%9C-%E0%A6%B9%E0%A6%B0%E0%A6%B2-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6</guid>
      <pubDate>Mon, 09 Nov 2026 10:51:05 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_media/1794133261_6af04d0db3873.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_media/1794133261_6af04d0db3873.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_media/1794133261_6af04d0db3873.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ড্রয়ে শেষ সিলেট টেস্ট, ১–০ ব্যবধানে সিরিজ হারল বাংলাদেশ" /&gt;&lt;/p&gt;&lt;p&gt;সিলেট টেস্টে লড়াই করেও শেষ পর্যন্ত হার এড়াতে পারলেও সিরিজ রক্ষা করতে পারেনি বাংলাদেশ। ওয়েস্ট ইন্ডিজের বিপক্ষে দুই ম্যাচ সিরিজের দ্বিতীয় ও শেষ টেস্টটি ড্র হয়েছে। তবে মিরপুরে অনুষ্ঠিত প্রথম টেস্টে ৮ উইকেটের জয়ের সুবাদে সিরিজ ১–০ ব্যবধানে নিজেদের করে নিয়েছে ক্যারিবীয়রা।সিলেট আন্তর্জাতিক ক্রিকেট স্টেডিয়&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%A1%E0%A6%B0%E0%A7%9F-%E0%A6%B6%E0%A6%B7-%E0%A6%B8%E0%A6%B2%E0%A6%9F-%E0%A6%9F%E0%A6%B8%E0%A6%9F-%E0%A7%A7%E0%A7%A6-%E0%A6%AC%E0%A6%AF%E0%A6%AC%E0%A6%A7%E0%A6%A8-%E0%A6%B8%E0%A6%B0%E0%A6%9C-%E0%A6%B9%E0%A6%B0%E0%A6%B2-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6">Education Bangla</source>
    </item>
    <item>
      <title>ব্রাজিলকে হারিয়ে ফুটসাল ফিনালিসিমা চ্যাম্পিয়ন স্পেন</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%B0%E0%A6%9C%E0%A6%B2%E0%A6%95-%E0%A6%B9%E0%A6%B0%E0%A7%9F-%E0%A6%AB%E0%A6%9F%E0%A6%B8%E0%A6%B2-%E0%A6%AB%E0%A6%A8%E0%A6%B2%E0%A6%B8%E0%A6%AE-%E0%A6%9A%E0%A6%AF%E0%A6%AE%E0%A6%AA%E0%A7%9F%E0%A6%A8-%E0%A6%B8%E0%A6%AA%E0%A6%A8</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%B0%E0%A6%9C%E0%A6%B2%E0%A6%95-%E0%A6%B9%E0%A6%B0%E0%A7%9F-%E0%A6%AB%E0%A6%9F%E0%A6%B8%E0%A6%B2-%E0%A6%AB%E0%A6%A8%E0%A6%B2%E0%A6%B8%E0%A6%AE-%E0%A6%9A%E0%A6%AF%E0%A6%AE%E0%A6%AA%E0%A7%9F%E0%A6%A8-%E0%A6%B8%E0%A6%AA%E0%A6%A8</guid>
      <pubDate>Mon, 09 Nov 2026 09:05:34 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794215134_rkr_6af18cded203b.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794215134_rkr_6af18cded203b.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794215134_rkr_6af18cded203b.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ব্রাজিলকে হারিয়ে ফুটসাল ফিনালিসিমা চ্যাম্পিয়ন স্পেন" /&gt;&lt;/p&gt;&lt;p&gt;ফাইনালে স্বাগতিক ব্রাজিলকে ৩-০ গোলে হারিয়ে প্রথমবারের মতো কনমেবল-উয়েফা ফিনালিসিমা ফুটসালের শিরোপা জিতেছে স্পেন। রোববার (৮ নভেম্বর) ব্রাজিলের নিতেরোইয়ের অ্যারেনা নিতেরোইয়ে অনুষ্ঠিত শিরোপা নির্ধারণী ম্যাচে দাপুটে জয় তুলে নেয় স্প্যানিশরা। খবর কোপা আমেরিকার।এদিকে তৃতীয় স্থান নির্ধারণী ম্যাচে পর্তুগালকে.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%B0%E0%A6%9C%E0%A6%B2%E0%A6%95-%E0%A6%B9%E0%A6%B0%E0%A7%9F-%E0%A6%AB%E0%A6%9F%E0%A6%B8%E0%A6%B2-%E0%A6%AB%E0%A6%A8%E0%A6%B2%E0%A6%B8%E0%A6%AE-%E0%A6%9A%E0%A6%AF%E0%A6%AE%E0%A6%AA%E0%A7%9F%E0%A6%A8-%E0%A6%B8%E0%A6%AA%E0%A6%A8">Education Bangla</source>
    </item>

      <title>ভারতের প্রথম বোলার হিসেবে চাহালের ৪০০ উইকেট</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AD%E0%A6%B0%E0%A6%A4%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%AC%E0%A6%B2%E0%A6%B0-%E0%A6%B9%E0%A6%B8%E0%A6%AC-%E0%A6%9A%E0%A6%B9%E0%A6%B2%E0%A6%B0-%E0%A7%AA%E0%A7%A6%E0%A7%A6-%E0%A6%89%E0%A6%87%E0%A6%95%E0%A6%9F</link>

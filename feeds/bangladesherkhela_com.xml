      <enclosure url="https://bangladesherkhela.com/uploads/rkr_media/1795448006_6b045cc6e137e.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_media/1795448006_6b045cc6e137e.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_media/1795448006_6b045cc6e137e.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ব্যাটিং ধসে ৯১ রানে অলআউট বাংলাদেশ" /&gt;&lt;/p&gt;&lt;p&gt;জোহানেসবার্গে বড় হারের পর সেঞ্চুরিয়নে ঘুরে দাঁড়ানোর প্রত্যয় নিয়ে মাঠে নেমেছিল বাংলাদেশ। কিন্তু সিরিজের দ্বিতীয় ও শেষ টেস্টের প্রথম দিনেই ব্যাটিং বিপর্যয়ে পড়েছে নাজমুল হোসেন শান্তর দল। দক্ষিণ আফ্রিকার পেস তোপে মাত্র ৩৩.৩ ওভারে ৯১ রানেই গুটিয়ে গেছে সফরকারীদের প্রথম ইনিংস। সুপারস্পোর্ট পার্কে টেস্টের প&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%AF%E0%A6%9F-%E0%A6%A7%E0%A6%B8-%E0%A7%AF%E0%A7%A7-%E0%A6%B0%E0%A6%A8-%E0%A6%85%E0%A6%B2%E0%A6%86%E0%A6%89%E0%A6%9F-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6">Education Bangla</source>
    </item>
    <item>
      <title>রণবীরকে শচীন: আমার জন্য বল কোরো</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B0%E0%A6%A3%E0%A6%AC%E0%A6%B0%E0%A6%95-%E0%A6%B6%E0%A6%9A%E0%A6%A8-%E0%A6%86%E0%A6%AE%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A6%AF-%E0%A6%AC%E0%A6%B2-%E0%A6%95%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%B0%E0%A6%A3%E0%A6%AC%E0%A6%B0%E0%A6%95-%E0%A6%B6%E0%A6%9A%E0%A6%A8-%E0%A6%86%E0%A6%AE%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A6%AF-%E0%A6%AC%E0%A6%B2-%E0%A6%95%E0%A6%B0</guid>
      <pubDate>Mon, 23 Nov 2026 13:56:53 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795442213_rkr_6b044625b5a9f.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795442213_rkr_6b044625b5a9f.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795442213_rkr_6b044625b5a9f.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রণবীরকে শচীন: আমার জন্য বল কোরো" /&gt;&lt;/p&gt;&lt;p&gt;অভিনেতা হিসেবে বার বারই নিজেকে ভেঙেছেন বলিউড তারকা রণবীর সিং। তবে এবার অভিনেতার অভিনয়ের প্রশংসা শোনা গেল কিংবদন্তি ক্রিকেটার শচীন টেন্ডুলকারের মুখে। শুধু প্রশংসাই নয়, রণবীরকে ক্রিকেটের মাঠে নেমে বল করার আমন্ত্রণও জানালেন এই মাস্টারব্লাস্টার। &amp;amp;nbsp; শচীনের মতে, ক্রিকেটার হিসেবেও যথেষ্ট ভাল করতে প&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B0%E0%A6%A3%E0%A6%AC%E0%A6%B0%E0%A6%95-%E0%A6%B6%E0%A6%9A%E0%A6%A8-%E0%A6%86%E0%A6%AE%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A6%AF-%E0%A6%AC%E0%A6%B2-%E0%A6%95%E0%A6%B0">Education Bangla</source>
    </item>
    <item>
      <title>সেঞ্চুরিয়ানে মারাত্মক ব্যাটিং বিপর্যয়ে বাংলাদেশ</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%9E%E0%A6%9A%E0%A6%B0%E0%A7%9F%E0%A6%A8-%E0%A6%AE%E0%A6%B0%E0%A6%A4%E0%A6%AE%E0%A6%95-%E0%A6%AC%E0%A6%AF%E0%A6%9F-%E0%A6%AC%E0%A6%AA%E0%A6%B0%E0%A6%AF%E0%A7%9F-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%9E%E0%A6%9A%E0%A6%B0%E0%A7%9F%E0%A6%A8-%E0%A6%AE%E0%A6%B0%E0%A6%A4%E0%A6%AE%E0%A6%95-%E0%A6%AC%E0%A6%AF%E0%A6%9F-%E0%A6%AC%E0%A6%AA%E0%A6%B0%E0%A6%AF%E0%A7%9F-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6</guid>
      <pubDate>Mon, 23 Nov 2026 13:52:41 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_media/1795441994_6b04454adf982.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_media/1795441994_6b04454adf982.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_media/1795441994_6b04454adf982.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সেঞ্চুরিয়ানে মারাত্মক ব্যাটিং বিপর্যয়ে বাংলাদেশ" /&gt;&lt;/p&gt;&lt;p&gt;দুর্দশা যেন পিছু ছাড়ছে না বাংলাদেশ দলের। সেঞ্চুরিয়ানে দক্ষিণ আফ্রিকার বিপক্ষে টেস্টেও সেই পুরোনো সমস্যার পুনরাবৃত্তি। প্রোটিয়া পেসারদের গতির সামনে একের পর এক উইকেট হারিয়ে শুরুতেই চাপে পড়েছে সফরকারীরা। ব্যাটসম্যানদের আসা-যাওয়ার মিছিলে বড় হচ্ছে না স্কোরবোর্ডও। বৃষ্টি বাঁধার পর টস হেরে ব্যাট করতে নেমে.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%9E%E0%A6%9A%E0%A6%B0%E0%A7%9F%E0%A6%A8-%E0%A6%AE%E0%A6%B0%E0%A6%A4%E0%A6%AE%E0%A6%95-%E0%A6%AC%E0%A6%AF%E0%A6%9F-%E0%A6%AC%E0%A6%AA%E0%A6%B0%E0%A6%AF%E0%A7%9F-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6">Education Bangla</source>
    </item>
    <item>
      <title>সৌম্য-সাইফ বাদ, ওয়ানডে দলে ফিরলেন নাঈম-রাব্বি</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%AE%E0%A6%AF-%E0%A6%B8%E0%A6%87%E0%A6%AB-%E0%A6%AC%E0%A6%A6-%E0%A6%93%E0%A7%9F%E0%A6%A8%E0%A6%A1-%E0%A6%A6%E0%A6%B2-%E0%A6%AB%E0%A6%B0%E0%A6%B2%E0%A6%A8-%E0%A6%A8%E0%A6%88%E0%A6%AE-%E0%A6%B0%E0%A6%AC%E0%A6%AC</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%AE%E0%A6%AF-%E0%A6%B8%E0%A6%87%E0%A6%AB-%E0%A6%AC%E0%A6%A6-%E0%A6%93%E0%A7%9F%E0%A6%A8%E0%A6%A1-%E0%A6%A6%E0%A6%B2-%E0%A6%AB%E0%A6%B0%E0%A6%B2%E0%A6%A8-%E0%A6%A8%E0%A6%88%E0%A6%AE-%E0%A6%B0%E0%A6%AC%E0%A6%AC</guid>
      <pubDate>Mon, 23 Nov 2026 13:18:36 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795439916_rkr_6b043d2c91437.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795439916_rkr_6b043d2c91437.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795439916_rkr_6b043d2c91437.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সৌম্য-সাইফ বাদ, ওয়ানডে দলে ফিরলেন নাঈম-রাব্বি" /&gt;&lt;/p&gt;&lt;p&gt;দক্ষিণ আফ্রিকার বিপক্ষে ৩ ম্যাচের ওয়ানডে সিরিজের জন্য ১৫ সদস্যের দল ঘোষণা করেছে বাংলাদেশ ক্রিকেট বোর্ড (বিসিবি)। আজ ঘোষিত এই দলে লিটন কুমার দাসের অধিনায়কত্বে ফিরেছেন নাঈম শেখসহ বেশ কয়েকজন ক্রিকেটার।সর্বশেষ সংযুক্ত আরব আমিরাতে আফগানিস্তান ও জিম্বাবুয়ের বিপক্ষে ত্রিদেশীয় সিরিজের দল থেকে বেশ কয়েকটি পরি&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%AE%E0%A6%AF-%E0%A6%B8%E0%A6%87%E0%A6%AB-%E0%A6%AC%E0%A6%A6-%E0%A6%93%E0%A7%9F%E0%A6%A8%E0%A6%A1-%E0%A6%A6%E0%A6%B2-%E0%A6%AB%E0%A6%B0%E0%A6%B2%E0%A6%A8-%E0%A6%A8%E0%A6%88%E0%A6%AE-%E0%A6%B0%E0%A6%AC%E0%A6%AC">Education Bangla</source>
    </item>
    <item>
      <title>প্রচন্ড ভয় পেয়েই অজ্ঞান হয়ে পড়েছিল পারেদেস, বললেন ডি মারিয়া</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AA%E0%A6%B0%E0%A6%9A%E0%A6%A8%E0%A6%A1-%E0%A6%AD%E0%A7%9F-%E0%A6%AA%E0%A7%9F%E0%A6%87-%E0%A6%85%E0%A6%9C%E0%A6%9E%E0%A6%A8-%E0%A6%B9%E0%A7%9F-%E0%A6%AA%E0%A7%9C%E0%A6%9B%E0%A6%B2-%E0%A6%AA%E0%A6%B0%E0%A6%A6%E0%A6%B8-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A6%A8-%E0%A6%A1-%E0%A6%AE%E0%A6%B0%E0%A7%9F</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AA%E0%A6%B0%E0%A6%9A%E0%A6%A8%E0%A6%A1-%E0%A6%AD%E0%A7%9F-%E0%A6%AA%E0%A7%9F%E0%A6%87-%E0%A6%85%E0%A6%9C%E0%A6%9E%E0%A6%A8-%E0%A6%B9%E0%A7%9F-%E0%A6%AA%E0%A7%9C%E0%A6%9B%E0%A6%B2-%E0%A6%AA%E0%A6%B0%E0%A6%A6%E0%A6%B8-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A6%A8-%E0%A6%A1-%E0%A6%AE%E0%A6%B0%E0%A7%9F</guid>
      <pubDate>Mon, 23 Nov 2026 13:16:57 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795439817_rkr_6b043cc932cb2.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795439817_rkr_6b043cc932cb2.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795439817_rkr_6b043cc932cb2.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রচন্ড ভয় পেয়েই অজ্ঞান হয়ে পড়েছিল পারেদেস, বললেন ডি মারিয়া" /&gt;&lt;/p&gt;&lt;p&gt;কোপা সুদামেরিকানার শিরোপা জয়ের উৎসবের মাঝেই ঘটে যায় এক অনাকাঙ্ক্ষিত ঘটনা। শনিবার কলম্বিয়ার বারানকিয়ায় আতলেতিকো মিনেইরোকে ২-০ গোলে হারিয়ে বোকা জুনিয়র্স চ্যাম্পিয়ন হওয়ার পরপরই লাইভ সাক্ষাৎকার দিতে গিয়ে জ্ঞান হারান দলটির অধিনায়ক লিয়ান্দ্রো পারেদেস। তবে প্রিয় বন্ধু ও জাতীয় দলের সাবেক সতীর্থের এমন ঘটনায়.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AA%E0%A6%B0%E0%A6%9A%E0%A6%A8%E0%A6%A1-%E0%A6%AD%E0%A7%9F-%E0%A6%AA%E0%A7%9F%E0%A6%87-%E0%A6%85%E0%A6%9C%E0%A6%9E%E0%A6%A8-%E0%A6%B9%E0%A7%9F-%E0%A6%AA%E0%A7%9C%E0%A6%9B%E0%A6%B2-%E0%A6%AA%E0%A6%B0%E0%A6%A6%E0%A6%B8-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A6%A8-%E0%A6%A1-%E0%A6%AE%E0%A6%B0%E0%A7%9F">Education Bangla</source>

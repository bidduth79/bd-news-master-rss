    <item>
      <title>কলকাতার মালিকানায় পরিবর্তন</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%95%E0%A6%B2%E0%A6%95%E0%A6%A4%E0%A6%B0-%E0%A6%AE%E0%A6%B2%E0%A6%95%E0%A6%A8%E0%A7%9F-%E0%A6%AA%E0%A6%B0%E0%A6%AC%E0%A6%B0%E0%A6%A4%E0%A6%A8</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%95%E0%A6%B2%E0%A6%95%E0%A6%A4%E0%A6%B0-%E0%A6%AE%E0%A6%B2%E0%A6%95%E0%A6%A8%E0%A7%9F-%E0%A6%AA%E0%A6%B0%E0%A6%AC%E0%A6%B0%E0%A6%A4%E0%A6%A8</guid>
      <pubDate>Wed, 18 Nov 2026 16:17:54 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795018674_rkr_6afdcfb2b4450.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795018674_rkr_6afdcfb2b4450.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795018674_rkr_6afdcfb2b4450.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কলকাতার মালিকানায় পরিবর্তন" /&gt;&lt;/p&gt;&lt;p&gt;আইপিএলের জনপ্রিয় দল কলকাতা নাইট রাইডার্সের মালিকানায় আসছে নতুন বিনিয়োগকারী। ফ্র্যাঞ্চাইজিটির বড় একটি অংশের শেয়ার কিনতে যাচ্ছে যুক্তরাষ্ট্রের বিনিয়োগকারী সংস্থা অ্যারেস ম্যানেজমেন্ট। এ জন্য কেকেআরের অন্যতম মালিক জয় মেহতাকে দিতে হচ্ছে প্রায় ৪০ কোটি ডলার। বাংলাদেশি মুদ্রায় যার পরিমাণ প্রায় ৪ হাজার ৮০০.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%95%E0%A6%B2%E0%A6%95%E0%A6%A4%E0%A6%B0-%E0%A6%AE%E0%A6%B2%E0%A6%95%E0%A6%A8%E0%A7%9F-%E0%A6%AA%E0%A6%B0%E0%A6%AC%E0%A6%B0%E0%A6%A4%E0%A6%A8">Education Bangla</source>
    </item>
    <item>
      <title>অস্ট্রেলিয়ার হয়ে খেলতে আইপিএল থেকে সরে দাঁড়ালেন স্টার্ক</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%85%E0%A6%B8%E0%A6%9F%E0%A6%B0%E0%A6%B2%E0%A7%9F%E0%A6%B0-%E0%A6%B9%E0%A7%9F-%E0%A6%96%E0%A6%B2%E0%A6%A4-%E0%A6%86%E0%A6%87%E0%A6%AA%E0%A6%8F%E0%A6%B2-%E0%A6%A5%E0%A6%95-%E0%A6%B8%E0%A6%B0-%E0%A6%A6%E0%A7%9C%E0%A6%B2%E0%A6%A8-%E0%A6%B8%E0%A6%9F%E0%A6%B0%E0%A6%95</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%85%E0%A6%B8%E0%A6%9F%E0%A6%B0%E0%A6%B2%E0%A7%9F%E0%A6%B0-%E0%A6%B9%E0%A7%9F-%E0%A6%96%E0%A6%B2%E0%A6%A4-%E0%A6%86%E0%A6%87%E0%A6%AA%E0%A6%8F%E0%A6%B2-%E0%A6%A5%E0%A6%95-%E0%A6%B8%E0%A6%B0-%E0%A6%A6%E0%A7%9C%E0%A6%B2%E0%A6%A8-%E0%A6%B8%E0%A6%9F%E0%A6%B0%E0%A6%95</guid>
      <pubDate>Wed, 18 Nov 2026 16:17:08 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795018628_rkr_6afdcf8489294.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795018628_rkr_6afdcf8489294.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795018628_rkr_6afdcf8489294.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অস্ট্রেলিয়ার হয়ে খেলতে আইপিএল থেকে সরে দাঁড়ালেন স্টার্ক" /&gt;&lt;/p&gt;&lt;p&gt;আইপিএলের নতুন মৌসুম শুরুর আগেই অস্ট্রেলিয়ার দুই তারকা সরে দাঁড়ালেন। আগে ট্রাভিস হেড, এবার মিচেল স্টার্ক। আন্তর্জাতিক ক্রিকেটের ব্যস্ত সূচি ও ফিটনেস ধরে রাখার কথা ভেবে ২০২৭ সালের আইপিএলে না খেলার সিদ্ধান্ত নিয়েছেন অস্ট্রেলিয়ার এই বাঁহাতি পেসার। তার সিদ্ধান্তে বড় ধাক্কা খেল দিল্লি ক্যাপিটালস। অন্যদিকে&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%85%E0%A6%B8%E0%A6%9F%E0%A6%B0%E0%A6%B2%E0%A7%9F%E0%A6%B0-%E0%A6%B9%E0%A7%9F-%E0%A6%96%E0%A6%B2%E0%A6%A4-%E0%A6%86%E0%A6%87%E0%A6%AA%E0%A6%8F%E0%A6%B2-%E0%A6%A5%E0%A6%95-%E0%A6%B8%E0%A6%B0-%E0%A6%A6%E0%A7%9C%E0%A6%B2%E0%A6%A8-%E0%A6%B8%E0%A6%9F%E0%A6%B0%E0%A6%95">Education Bangla</source>
    </item>
    <item>
      <title>আলোর স্বল্পতায় আগেভাগে খেলা শেষ, ৫৭ রানে পিছিয়ে বাংলাদেশ</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%B2%E0%A6%B0-%E0%A6%B8%E0%A6%AC%E0%A6%B2%E0%A6%AA%E0%A6%A4%E0%A7%9F-%E0%A6%86%E0%A6%97%E0%A6%AD%E0%A6%97-%E0%A6%96%E0%A6%B2-%E0%A6%B6%E0%A6%B7-%E0%A7%AB%E0%A7%AD-%E0%A6%B0%E0%A6%A8-%E0%A6%AA%E0%A6%9B%E0%A7%9F-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%B2%E0%A6%B0-%E0%A6%B8%E0%A6%AC%E0%A6%B2%E0%A6%AA%E0%A6%A4%E0%A7%9F-%E0%A6%86%E0%A6%97%E0%A6%AD%E0%A6%97-%E0%A6%96%E0%A6%B2-%E0%A6%B6%E0%A6%B7-%E0%A7%AB%E0%A7%AD-%E0%A6%B0%E0%A6%A8-%E0%A6%AA%E0%A6%9B%E0%A7%9F-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6</guid>
      <pubDate>Wed, 18 Nov 2026 16:14:10 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795018450_rkr_6afdced2f08b9.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795018450_rkr_6afdced2f08b9.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795018450_rkr_6afdced2f08b9.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আলোর স্বল্পতায় আগেভাগে খেলা শেষ, ৫৭ রানে পিছিয়ে বাংলাদেশ" /&gt;&lt;/p&gt;&lt;p&gt;প্রথম ইনিংসে ৪০০ রান করেও জোহানেসবার্গ টেস্টে বড় বিপদে বাংলাদেশ। দক্ষিণ আফ্রিকার ৫৫৭ রানের জবাবে চতুর্থ দিনের খেলা শেষ হওয়ার আগে বাংলাদেশের সংগ্রহ ১০০ রানে ৫ উইকেট। আলোর স্বল্পতায় চতুর্থ দিনের খেলা শেষ হওয়ার সময় বাংলাদেশ এখনও ৫৭ রানে পিছিয়ে। হাতে রয়েছে মাত্র পাঁচ উইকেট।১৫৭ রানে পিছিয়ে থেকে ব্যাটিংয়ে&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%B2%E0%A6%B0-%E0%A6%B8%E0%A6%AC%E0%A6%B2%E0%A6%AA%E0%A6%A4%E0%A7%9F-%E0%A6%86%E0%A6%97%E0%A6%AD%E0%A6%97-%E0%A6%96%E0%A6%B2-%E0%A6%B6%E0%A6%B7-%E0%A7%AB%E0%A7%AD-%E0%A6%B0%E0%A6%A8-%E0%A6%AA%E0%A6%9B%E0%A7%9F-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6">Education Bangla</source>
    </item>
    <item>
      <title>সর্বোচ্চ টাকা নিয়ে আইপিএল নিলামে লখনউ, ঝড় তুলবে যে ৬ দল</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%B0%E0%A6%AC%E0%A6%9A%E0%A6%9A-%E0%A6%9F%E0%A6%95-%E0%A6%A8%E0%A6%AF-%E0%A6%86%E0%A6%87%E0%A6%AA%E0%A6%8F%E0%A6%B2-%E0%A6%A8%E0%A6%B2%E0%A6%AE-%E0%A6%B2%E0%A6%96%E0%A6%A8%E0%A6%89-%E0%A6%9D%E0%A6%A1-%E0%A6%A4%E0%A6%B2%E0%A6%AC-%E0%A6%AF-%E0%A7%AC-%E0%A6%A6%E0%A6%B2</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%B0%E0%A6%AC%E0%A6%9A%E0%A6%9A-%E0%A6%9F%E0%A6%95-%E0%A6%A8%E0%A6%AF-%E0%A6%86%E0%A6%87%E0%A6%AA%E0%A6%8F%E0%A6%B2-%E0%A6%A8%E0%A6%B2%E0%A6%AE-%E0%A6%B2%E0%A6%96%E0%A6%A8%E0%A6%89-%E0%A6%9D%E0%A6%A1-%E0%A6%A4%E0%A6%B2%E0%A6%AC-%E0%A6%AF-%E0%A7%AC-%E0%A6%A6%E0%A6%B2</guid>
      <pubDate>Wed, 18 Nov 2026 16:12:48 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795018368_rkr_6afdce8083747.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795018368_rkr_6afdce8083747.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795018368_rkr_6afdce8083747.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সর্বোচ্চ টাকা নিয়ে আইপিএল নিলামে লখনউ, ঝড় তুলবে যে ৬ দল" /&gt;&lt;/p&gt;&lt;p&gt;আরও পড়ুন-‘আইপিএলে ৫ ম্যাচের গোপন তথ্য জুয়াড়িদের দিয়ে ৩ কোটি রুপি পেয়েছি’আইপিএলের নিলাম মানেই নতুন তারকাদের নিয়ে দল সাজানোর লড়াই। কখনো কয়েক কোটি টাকার ব্যবধানে বদলে যায় একটি ফ্র্যাঞ্চাইজির ভবিষ্যৎ পরিকল্পনা, আবার কখনো অল্প বাজেটেই বাজিমাত করে কোনো দল। ২০২৭ সালের আইপিএল নিলামকে সামনে রেখে এবারও সেই হি&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%B0%E0%A6%AC%E0%A6%9A%E0%A6%9A-%E0%A6%9F%E0%A6%95-%E0%A6%A8%E0%A6%AF-%E0%A6%86%E0%A6%87%E0%A6%AA%E0%A6%8F%E0%A6%B2-%E0%A6%A8%E0%A6%B2%E0%A6%AE-%E0%A6%B2%E0%A6%96%E0%A6%A8%E0%A6%89-%E0%A6%9D%E0%A6%A1-%E0%A6%A4%E0%A6%B2%E0%A6%AC-%E0%A6%AF-%E0%A7%AC-%E0%A6%A6%E0%A6%B2">Education Bangla</source>
    </item>
    <item>
      <title>১৪৯ বছরের টেস্ট ইতিহাসে বিরল কীর্তি গড়লেন নাসির</title>
      <link>https://bangladesherkhela.com/news/%E0%A7%A7%E0%A7%AA%E0%A7%AF-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A6%B0-%E0%A6%9F%E0%A6%B8%E0%A6%9F-%E0%A6%87%E0%A6%A4%E0%A6%B9%E0%A6%B8-%E0%A6%AC%E0%A6%B0%E0%A6%B2-%E0%A6%95%E0%A6%B0%E0%A6%A4-%E0%A6%97%E0%A7%9C%E0%A6%B2%E0%A6%A8-%E0%A6%A8%E0%A6%B8%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A7%A7%E0%A7%AA%E0%A7%AF-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A6%B0-%E0%A6%9F%E0%A6%B8%E0%A6%9F-%E0%A6%87%E0%A6%A4%E0%A6%B9%E0%A6%B8-%E0%A6%AC%E0%A6%B0%E0%A6%B2-%E0%A6%95%E0%A6%B0%E0%A6%A4-%E0%A6%97%E0%A7%9C%E0%A6%B2%E0%A6%A8-%E0%A6%A8%E0%A6%B8%E0%A6%B0</guid>
      <pubDate>Wed, 18 Nov 2026 16:11:32 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795018292_rkr_6afdce345d549.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795018292_rkr_6afdce345d549.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795018292_rkr_6afdce345d549.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="১৪৯ বছরের টেস্ট ইতিহাসে বিরল কীর্তি গড়লেন নাসির" /&gt;&lt;/p&gt;&lt;p&gt;শারজায় জিম্বাবুয়ের বিপক্ষে টেস্ট অভিষেকেই রূপকথার জন্ম দিয়েছেন আফগানিস্তানের তরুণ অলরাউন্ডার নাসির খান মারুফখিল। ১৪৯ বছরের দীর্ঘ টেস্ট ইতিহাসে এর আগে কখনো কোনো ক্রিকেটার অভিষেকম্যাচে সেঞ্চুরি ও এক ম্যাচে ৯ উইকেট নেওয়ার অবিশ্বাস্য ডাবল ট্রিপল কীর্তি গড়তে পারেননি। ব্যক্তিগত পারফরম্যান্সের আলোয় রেকর্ড&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A7%A7%E0%A7%AA%E0%A7%AF-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A6%B0-%E0%A6%9F%E0%A6%B8%E0%A6%9F-%E0%A6%87%E0%A6%A4%E0%A6%B9%E0%A6%B8-%E0%A6%AC%E0%A6%B0%E0%A6%B2-%E0%A6%95%E0%A6%B0%E0%A6%A4-%E0%A6%97%E0%A7%9C%E0%A6%B2%E0%A6%A8-%E0%A6%A8%E0%A6%B8%E0%A6%B0">Education Bangla</source>
    </item>
    <item>
      <title>বাবা হলেন এনদ্রিক, সন্তানের নাম রাখলেন কেনদ্রিক</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%AC-%E0%A6%B9%E0%A6%B2%E0%A6%A8-%E0%A6%8F%E0%A6%A8%E0%A6%A6%E0%A6%B0%E0%A6%95-%E0%A6%B8%E0%A6%A8%E0%A6%A4%E0%A6%A8%E0%A6%B0-%E0%A6%A8%E0%A6%AE-%E0%A6%B0%E0%A6%96%E0%A6%B2%E0%A6%A8-%E0%A6%95%E0%A6%A8%E0%A6%A6%E0%A6%B0%E0%A6%95</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%AC-%E0%A6%B9%E0%A6%B2%E0%A6%A8-%E0%A6%8F%E0%A6%A8%E0%A6%A6%E0%A6%B0%E0%A6%95-%E0%A6%B8%E0%A6%A8%E0%A6%A4%E0%A6%A8%E0%A6%B0-%E0%A6%A8%E0%A6%AE-%E0%A6%B0%E0%A6%96%E0%A6%B2%E0%A6%A8-%E0%A6%95%E0%A6%A8%E0%A6%A6%E0%A6%B0%E0%A6%95</guid>

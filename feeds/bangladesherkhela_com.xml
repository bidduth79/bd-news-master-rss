      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795882685_rkr_6b0afebda4477.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795882685_rkr_6b0afebda4477.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অভিষেকের পর টানা ছয় হার, তলানিতে চট্টগ্রাম সিটি" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ ফুটবল লিগে (বিএফএল) অভিষেকটা মোটেও সুখকর হচ্ছে না নবাগত চট্টগ্রাম সিটি এফসির। চলতি মৌসুমে প্রথমবারের মতো দেশের শীর্ষ ফুটবল আসরে খেলতে নেমে এখন পর্যন্ত জয়ের মুখ দেখেনি চট্টলার দলটি।শনিবার ষষ্ঠ ম্যাচেও ব্রাদার্স ইউনিয়নের কাছে ৩-১ গোলে হেরেছে তারা। ফলে লিগে টানা ছয় হারের বিব্রতকর অভিজ্ঞতা নিয়ে&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%85%E0%A6%AD%E0%A6%B7%E0%A6%95%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%9F%E0%A6%A8-%E0%A6%9B%E0%A7%9F-%E0%A6%B9%E0%A6%B0-%E0%A6%A4%E0%A6%B2%E0%A6%A8%E0%A6%A4-%E0%A6%9A%E0%A6%9F%E0%A6%9F%E0%A6%97%E0%A6%B0%E0%A6%AE-%E0%A6%B8%E0%A6%9F">Education Bangla</source>
    </item>
    <item>
      <title>ইতিহাস গড়ল আল নাসর, টানা ১০০ ম্যাচে গোলের রেকর্ড</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%87%E0%A6%A4%E0%A6%B9%E0%A6%B8-%E0%A6%97%E0%A6%A1%E0%A6%B2-%E0%A6%86%E0%A6%B2-%E0%A6%A8%E0%A6%B8%E0%A6%B0-%E0%A6%9F%E0%A6%A8-%E0%A7%A7%E0%A7%A6%E0%A7%A6-%E0%A6%AE%E0%A6%AF%E0%A6%9A-%E0%A6%97%E0%A6%B2%E0%A6%B0-%E0%A6%B0%E0%A6%95%E0%A6%B0%E0%A6%A1</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%87%E0%A6%A4%E0%A6%B9%E0%A6%B8-%E0%A6%97%E0%A6%A1%E0%A6%B2-%E0%A6%86%E0%A6%B2-%E0%A6%A8%E0%A6%B8%E0%A6%B0-%E0%A6%9F%E0%A6%A8-%E0%A7%A7%E0%A7%A6%E0%A7%A6-%E0%A6%AE%E0%A6%AF%E0%A6%9A-%E0%A6%97%E0%A6%B2%E0%A6%B0-%E0%A6%B0%E0%A6%95%E0%A6%B0%E0%A6%A1</guid>
      <pubDate>Sat, 28 Nov 2026 16:14:01 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795882441_rkr_6b0afdc9eca74.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795882441_rkr_6b0afdc9eca74.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795882441_rkr_6b0afdc9eca74.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইতিহাস গড়ল আল নাসর, টানা ১০০ ম্যাচে গোলের রেকর্ড" /&gt;&lt;/p&gt;&lt;p&gt;সৌদি প্রো লিগে &amp;amp;nbsp;নতুন ইতিহাস গড়েছে ক্রিশ্চিয়ানো রোনালদোর দল আল নাসর। টানা ১০০ ম্যাচে গোল করার অনন্য কীর্তি গড়েছে ক্লাবটি। সৌদি প্রো লিগের ইতিহাসে এর আগে কোনো দলই টানা ১০০ ম্যাচে গোল করার রেকর্ড গড়তে পারেনি। খবর গোল ডটকমের।শনিবার (২৮ নভেম্বর) লিগের ১৩তম রাউন্ডের ম্যাচে আল হাজমের মুখোমুখি &lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%87%E0%A6%A4%E0%A6%B9%E0%A6%B8-%E0%A6%97%E0%A6%A1%E0%A6%B2-%E0%A6%86%E0%A6%B2-%E0%A6%A8%E0%A6%B8%E0%A6%B0-%E0%A6%9F%E0%A6%A8-%E0%A7%A7%E0%A7%A6%E0%A7%A6-%E0%A6%AE%E0%A6%AF%E0%A6%9A-%E0%A6%97%E0%A6%B2%E0%A6%B0-%E0%A6%B0%E0%A6%95%E0%A6%B0%E0%A6%A1">Education Bangla</source>
    </item>
    <item>
      <title>ইউরোপা লিগে সংঘর্ষে ১১ জন হাসপাতালে, তদন্তে উয়েফা</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%87%E0%A6%89%E0%A6%B0%E0%A6%AA-%E0%A6%B2%E0%A6%97-%E0%A6%B8%E0%A6%98%E0%A6%B0%E0%A6%B7-%E0%A7%A7%E0%A7%A7-%E0%A6%9C%E0%A6%A8-%E0%A6%B9%E0%A6%B8%E0%A6%AA%E0%A6%A4%E0%A6%B2-%E0%A6%A4%E0%A6%A6%E0%A6%A8%E0%A6%A4-%E0%A6%89%E0%A7%9F%E0%A6%AB</link>

      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794575586_rkr_6af70ce2f25ec.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794575586_rkr_6af70ce2f25ec.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সৌদ শাকিলের দৃঢ়তায় ড্র হলো পাকিস্তান-শ্রীলঙ্কা প্রথম টেস্ট" /&gt;&lt;/p&gt;&lt;p&gt;সৌদ শাকিলের দৃঢ় ব্যাটিং ও বৈরী আবহাওয়ার সহায়তায় শ্রীলঙ্কার জয়ের স্বপ্ন ভেস্তে দিয়েছে পাকিস্তান। শুক্রবার রাওয়ালপিন্ডিতে পঞ্চম ও শেষ দিনে ড্র হয়েছে দুই দলের প্রথম টেস্ট।দিনের প্রথম সেশনে চার উইকেট তুলে নিয়ে জয়ের সুবাস পাচ্ছিল শ্রীলঙ্কা। মধ্যাহ্নভোজের বিরতিতে পাকিস্তানের সংগ্রহ ছিল ৫ উইকেটে ১৫১ রান। ল&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%A6-%E0%A6%B6%E0%A6%95%E0%A6%B2%E0%A6%B0-%E0%A6%A6%E0%A7%9D%E0%A6%A4%E0%A7%9F-%E0%A6%A1%E0%A6%B0-%E0%A6%B9%E0%A6%B2-%E0%A6%AA%E0%A6%95%E0%A6%B8%E0%A6%A4%E0%A6%A8-%E0%A6%B6%E0%A6%B0%E0%A6%B2%E0%A6%99%E0%A6%95-%E0%A6%AA%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%9F%E0%A6%B8%E0%A6%9F">Education Bangla</source>

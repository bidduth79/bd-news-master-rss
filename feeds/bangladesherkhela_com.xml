      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794499650_rkr_6af5e442deff6.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794499650_rkr_6af5e442deff6.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অভিষেকেই সাকিবের সাত উইকেট, পাকিস্তানের দাপুটে দিন" /&gt;&lt;/p&gt;&lt;p&gt;রাওয়ালপিন্ডি টেস্টের চতুর্থ দিনে শ্রীলঙ্কার ইনিংসে ধস নামিয়ে ম্যাচে পাকিস্তানকে দারুণভাবে ফিরিয়েছেন সাকিব খান। অভিষেকেই সাত উইকেট নিয়ে গড়েছেন নজরকাড়া কীর্তি। তার দুর্দান্ত বোলিংয়ে শ্রীলঙ্কা শেষ ছয় উইকেট হারিয়েছে মাত্র ৪২ রানে। তবে দিন শেষে ম্যাচের নিয়ন্ত্রণ পুরোপুরি পাকিস্তানের হাতে আসেনি। আলোকস্বল্&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%85%E0%A6%AD%E0%A6%B7%E0%A6%95%E0%A6%87-%E0%A6%B8%E0%A6%95%E0%A6%AC%E0%A6%B0-%E0%A6%B8%E0%A6%A4-%E0%A6%89%E0%A6%87%E0%A6%95%E0%A6%9F-%E0%A6%AA%E0%A6%95%E0%A6%B8%E0%A6%A4%E0%A6%A8%E0%A6%B0-%E0%A6%A6%E0%A6%AA%E0%A6%9F-%E0%A6%A6%E0%A6%A8">Education Bangla</source>
    </item>

    <item>
      <title>‘হামজা সম্ভবত বাংলাদেশের সর্বকালের সেরা ফুটবলার’</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B9%E0%A6%AE%E0%A6%9C-%E0%A6%B8%E0%A6%AE%E0%A6%AD%E0%A6%AC%E0%A6%A4-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6%E0%A6%B0-%E0%A6%B8%E0%A6%B0%E0%A6%AC%E0%A6%95%E0%A6%B2%E0%A6%B0-%E0%A6%B8%E0%A6%B0-%E0%A6%AB%E0%A6%9F%E0%A6%AC%E0%A6%B2%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%B9%E0%A6%AE%E0%A6%9C-%E0%A6%B8%E0%A6%AE%E0%A6%AD%E0%A6%AC%E0%A6%A4-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6%E0%A6%B0-%E0%A6%B8%E0%A6%B0%E0%A6%AC%E0%A6%95%E0%A6%B2%E0%A6%B0-%E0%A6%B8%E0%A6%B0-%E0%A6%AB%E0%A6%9F%E0%A6%AC%E0%A6%B2%E0%A6%B0</guid>
      <pubDate>Thu, 12 Nov 2026 09:17:37 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794475057_rkr_6af5843132835.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794475057_rkr_6af5843132835.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794475057_rkr_6af5843132835.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘হামজা সম্ভবত বাংলাদেশের সর্বকালের সেরা ফুটবলার’" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশের ফুটবলে দীর্ঘদিনের পরিচিত মুখ জামাল ভূঁইয়া। বছরের পর বছর জাতীয় দলের নেতৃত্ব সামলেছেন, মাঝমাঠে দিয়েছেন অভিজ্ঞতার ছাপ। অধিনায়কের আর্মব্যান্ডও এখন তার হাতে নেই। তবে নেতৃত্বের জায়গা থেকে কাকে এগিয়ে রাখবেন, সে প্রশ্নে এবার কোনো দ্বিধা করলেন না জামাল। তার চোখে, বাংলাদেশের ফুটবলে সম্ভাব্য সর্বকাল&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B9%E0%A6%AE%E0%A6%9C-%E0%A6%B8%E0%A6%AE%E0%A6%AD%E0%A6%AC%E0%A6%A4-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6%E0%A6%B0-%E0%A6%B8%E0%A6%B0%E0%A6%AC%E0%A6%95%E0%A6%B2%E0%A6%B0-%E0%A6%B8%E0%A6%B0-%E0%A6%AB%E0%A6%9F%E0%A6%AC%E0%A6%B2%E0%A6%B0">Education Bangla</source>
    </item>
    <item>
      <title>২৭ বছর পর বিরল কীর্তি বাংলাদেশের</title>
      <link>https://bangladesherkhela.com/news/%E0%A7%A8%E0%A7%AD-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AC%E0%A6%B0%E0%A6%B2-%E0%A6%95%E0%A6%B0%E0%A6%A4-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A7%A8%E0%A7%AD-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AC%E0%A6%B0%E0%A6%B2-%E0%A6%95%E0%A6%B0%E0%A6%A4-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6%E0%A6%B0</guid>
      <pubDate>Thu, 12 Nov 2026 09:05:07 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794474307_rkr_6af58143517eb.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794474307_rkr_6af58143517eb.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794474307_rkr_6af58143517eb.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="২৭ বছর পর বিরল কীর্তি বাংলাদেশের" /&gt;&lt;/p&gt;&lt;p&gt;ইন্দোনেশিয়ার কাছে ৯ গোল হজমের হতাশা, সমর্থকদের দীর্ঘ অপেক্ষা। সবকিছুর জবাব যেন এক ম্যাচেই দিল বাংলাদেশ। শ্রীলঙ্কার বিপক্ষে ৪-০ গোলের জয় শুধু সেমিফাইনালের পথ নিশ্চিত করেনি, ফিরিয়েছে হারানো আত্মবিশ্বাসও। হামজা চৌধুরীর নেতৃত্বে দলটির এমন দাপুটে ফুটবল দেখে নতুন করে স্বপ্ন দেখছেন সমর্থকেরা।বাংলাদেশের ফুট&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A7%A8%E0%A7%AD-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AC%E0%A6%B0%E0%A6%B2-%E0%A6%95%E0%A6%B0%E0%A6%A4-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6%E0%A6%B0">Education Bangla</source>
    </item>

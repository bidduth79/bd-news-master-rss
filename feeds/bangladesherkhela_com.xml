      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795363220_rkr_6b03119477519.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795363220_rkr_6b03119477519.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795363220_rkr_6b03119477519.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="১০ মিনিটের ঝড়ে রোমাঞ্চকর জয়ে সিংহাসন মজবুত বার্সেলোনার" /&gt;&lt;/p&gt;&lt;p&gt;ঘরের মাঠ ক্যাম্প ন্যুতে শ্বাসরুদ্ধকর প্রত্যাবর্তনের গল্প লিখে স্প্যানিশ লা লিগার শীর্ষস্থান আরও মজবুত করল বার্সেলোনা। ম্যাচের শুরুতেই দুই গোল হজম এবং প্রথমার্ধে লামিন ইয়ামালের পেনাল্টি মিসের ধাক্কা সামলে দ্বিতীয়ার্ধে মাত্র ১০ মিনিটের ঝড়ে ভিয়ারিয়ালকে ৩–২ ব্যবধানে হারিয়েছে কাতালানরা। এই রোমাঞ্চকর&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A7%A7%E0%A7%A6-%E0%A6%AE%E0%A6%A8%E0%A6%9F%E0%A6%B0-%E0%A6%9D%E0%A6%A1-%E0%A6%B0%E0%A6%AE%E0%A6%9E%E0%A6%9A%E0%A6%95%E0%A6%B0-%E0%A6%9C%E0%A7%9F-%E0%A6%B8%E0%A6%B9%E0%A6%B8%E0%A6%A8-%E0%A6%AE%E0%A6%9C%E0%A6%AC%E0%A6%A4-%E0%A6%AC%E0%A6%B0%E0%A6%B8%E0%A6%B2%E0%A6%A8%E0%A6%B0">Education Bangla</source>
    </item>
    <item>
      <title>মুশফিকের ১০৮ টেস্টের অভিজ্ঞতা, বিকল্পদের কাছে কী চান সিমন্স?</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%B6%E0%A6%AB%E0%A6%95%E0%A6%B0-%E0%A7%A7%E0%A7%A6%E0%A7%AE-%E0%A6%9F%E0%A6%B8%E0%A6%9F%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%9C%E0%A6%9E%E0%A6%A4-%E0%A6%AC%E0%A6%95%E0%A6%B2%E0%A6%AA%E0%A6%A6%E0%A6%B0-%E0%A6%95%E0%A6%9B-%E0%A6%95-%E0%A6%9A%E0%A6%A8-%E0%A6%B8%E0%A6%AE%E0%A6%A8%E0%A6%B8</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%B6%E0%A6%AB%E0%A6%95%E0%A6%B0-%E0%A7%A7%E0%A7%A6%E0%A7%AE-%E0%A6%9F%E0%A6%B8%E0%A6%9F%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%9C%E0%A6%9E%E0%A6%A4-%E0%A6%AC%E0%A6%95%E0%A6%B2%E0%A6%AA%E0%A6%A6%E0%A6%B0-%E0%A6%95%E0%A6%9B-%E0%A6%95-%E0%A6%9A%E0%A6%A8-%E0%A6%B8%E0%A6%AE%E0%A6%A8%E0%A6%B8</guid>
      <pubDate>Sun, 22 Nov 2026 15:50:32 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795362632_rkr_6b030f488ea51.png" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795362632_rkr_6b030f488ea51.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795362632_rkr_6b030f488ea51.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মুশফিকের ১০৮ টেস্টের অভিজ্ঞতা, বিকল্পদের কাছে কী চান সিমন্স?" /&gt;&lt;/p&gt;&lt;p&gt;কুঁচকির চোটে দক্ষিণ আফ্রিকায় দ্বিতোয় টেস্ট খেলা হচ্ছে না মুশফিকুর রহিমের। আগামীকাল সেঞ্চুরিয়নে শুরু হতে যাওয়া টেস্টে তাই একাদশে বাধ্যতামূলক পরিবর্তন আনতে হচ্ছে বাংলাদেশকে। মুশফিকের ১০৮ টেস্টের অভিজ্ঞতার ঘাটতি পূরণ করা কঠিন। তবে কাউকে না কাউকে দায়িত্ব নিতে হবে। দক্ষিণ আফ্রিকার বিপক্ষে দ্বিতীয় টেস্টের&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%B6%E0%A6%AB%E0%A6%95%E0%A6%B0-%E0%A7%A7%E0%A7%A6%E0%A7%AE-%E0%A6%9F%E0%A6%B8%E0%A6%9F%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%9C%E0%A6%9E%E0%A6%A4-%E0%A6%AC%E0%A6%95%E0%A6%B2%E0%A6%AA%E0%A6%A6%E0%A6%B0-%E0%A6%95%E0%A6%9B-%E0%A6%95-%E0%A6%9A%E0%A6%A8-%E0%A6%B8%E0%A6%AE%E0%A6%A8%E0%A6%B8">Education Bangla</source>
    </item>
    <item>
      <title>মাঠে নেমেই একাদশ চূড়ান্ত, উইকেট দেখে সিদ্ধান্ত বাংলাদেশের</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%A0-%E0%A6%A8%E0%A6%AE%E0%A6%87-%E0%A6%8F%E0%A6%95%E0%A6%A6%E0%A6%B6-%E0%A6%9A%E0%A7%9C%E0%A6%A8%E0%A6%A4-%E0%A6%89%E0%A6%87%E0%A6%95%E0%A6%9F-%E0%A6%A6%E0%A6%96-%E0%A6%B8%E0%A6%A6%E0%A6%A7%E0%A6%A8%E0%A6%A4-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%A0-%E0%A6%A8%E0%A6%AE%E0%A6%87-%E0%A6%8F%E0%A6%95%E0%A6%A6%E0%A6%B6-%E0%A6%9A%E0%A7%9C%E0%A6%A8%E0%A6%A4-%E0%A6%89%E0%A6%87%E0%A6%95%E0%A6%9F-%E0%A6%A6%E0%A6%96-%E0%A6%B8%E0%A6%A6%E0%A6%A7%E0%A6%A8%E0%A6%A4-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6%E0%A6%B0</guid>
      <pubDate>Sun, 22 Nov 2026 15:49:28 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795362568_rkr_6b030f08e8825.png" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795362568_rkr_6b030f08e8825.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795362568_rkr_6b030f08e8825.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মাঠে নেমেই একাদশ চূড়ান্ত, উইকেট দেখে সিদ্ধান্ত বাংলাদেশের" /&gt;&lt;/p&gt;&lt;p&gt;দক্ষিণ আফ্রিকার বিপক্ষে সিরিজের দ্বিতীয় ও শেষ টেস্টে কেমন একাদশ নিয়ে মাঠে নামবে বাংলাদেশ, তা এখনো চূড়ান্ত করেননি হেড কোচ ফিল সিমন্স। সেঞ্চুরিয়নের উইকেট দেখেই এ বিষয়ে সিদ্ধান্ত নিতে চান তিনি। প্রতিপক্ষের পেস আক্রমণে আনরিখ নরকিয়া ফিরলেও সেটি নিয়ে আলাদা কোনো পরিকল্পনা নেই বাংলাদেশের। প্রথম টেস্টের মতো.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%A0-%E0%A6%A8%E0%A6%AE%E0%A6%87-%E0%A6%8F%E0%A6%95%E0%A6%A6%E0%A6%B6-%E0%A6%9A%E0%A7%9C%E0%A6%A8%E0%A6%A4-%E0%A6%89%E0%A6%87%E0%A6%95%E0%A6%9F-%E0%A6%A6%E0%A6%96-%E0%A6%B8%E0%A6%A6%E0%A6%A7%E0%A6%A8%E0%A6%A4-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6%E0%A6%B0">Education Bangla</source>
    </item>
    <item>
      <title>দুই মাসের দায়িত্ব শেষে সোমবার দেশে ফিরছেন ক্রুইফ</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%A6%E0%A6%87-%E0%A6%AE%E0%A6%B8%E0%A6%B0-%E0%A6%A6%E0%A7%9F%E0%A6%A4%E0%A6%AC-%E0%A6%B6%E0%A6%B7-%E0%A6%B8%E0%A6%AE%E0%A6%AC%E0%A6%B0-%E0%A6%A6%E0%A6%B6-%E0%A6%AB%E0%A6%B0%E0%A6%9B%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A6%87%E0%A6%AB</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%A6%E0%A6%87-%E0%A6%AE%E0%A6%B8%E0%A6%B0-%E0%A6%A6%E0%A7%9F%E0%A6%A4%E0%A6%AC-%E0%A6%B6%E0%A6%B7-%E0%A6%B8%E0%A6%AE%E0%A6%AC%E0%A6%B0-%E0%A6%A6%E0%A6%B6-%E0%A6%AB%E0%A6%B0%E0%A6%9B%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A6%87%E0%A6%AB</guid>
      <pubDate>Sun, 22 Nov 2026 15:48:30 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795362510_rkr_6b030ecedd821.png" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795362510_rkr_6b030ecedd821.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795362510_rkr_6b030ecedd821.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দুই মাসের দায়িত্ব শেষে সোমবার দেশে ফিরছেন ক্রুইফ" /&gt;&lt;/p&gt;&lt;p&gt;দুই মাসের চুক্তিতে বাংলাদেশ অনূর্ধ্ব-১৭ ফুটবল দলের দায়িত্ব নিতে ঢাকায় এসেছিলেন লোডভিক ডি ক্রুইফ। তার অধীনে এএফসি অনূর্ধ্ব-১৭ এশিয়ান কাপের বাছাইপর্বে অংশ নেয় বাংলাদেশ। সংযুক্ত আরব আমিরাতে অনুষ্ঠিত ‘সি’ গ্রুপের লড়াইয়ে পাঁচ দলের মধ্যে তৃতীয় হয়ে বাছাইপর্ব থেকেই বিদায় নিতে হয়েছে বাংলাদেশকে।চুক্তির মেয়াদ.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%A6%E0%A6%87-%E0%A6%AE%E0%A6%B8%E0%A6%B0-%E0%A6%A6%E0%A7%9F%E0%A6%A4%E0%A6%AC-%E0%A6%B6%E0%A6%B7-%E0%A6%B8%E0%A6%AE%E0%A6%AC%E0%A6%B0-%E0%A6%A6%E0%A6%B6-%E0%A6%AB%E0%A6%B0%E0%A6%9B%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A6%87%E0%A6%AB">Education Bangla</source>
    </item>
    <item>
      <title>অলিম্পিকের বাছাইপর্ব বাংলাদেশে, ‘মিনি বিশ্বকাপ’ বলছেন তামিম</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%85%E0%A6%B2%E0%A6%AE%E0%A6%AA%E0%A6%95%E0%A6%B0-%E0%A6%AC%E0%A6%9B%E0%A6%87%E0%A6%AA%E0%A6%B0%E0%A6%AC-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6-%E0%A6%AE%E0%A6%A8-%E0%A6%AC%E0%A6%B6%E0%A6%AC%E0%A6%95%E0%A6%AA-%E0%A6%AC%E0%A6%B2%E0%A6%9B%E0%A6%A8-%E0%A6%A4%E0%A6%AE%E0%A6%AE</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%85%E0%A6%B2%E0%A6%AE%E0%A6%AA%E0%A6%95%E0%A6%B0-%E0%A6%AC%E0%A6%9B%E0%A6%87%E0%A6%AA%E0%A6%B0%E0%A6%AC-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6-%E0%A6%AE%E0%A6%A8-%E0%A6%AC%E0%A6%B6%E0%A6%AC%E0%A6%95%E0%A6%AA-%E0%A6%AC%E0%A6%B2%E0%A6%9B%E0%A6%A8-%E0%A6%A4%E0%A6%AE%E0%A6%AE</guid>
      <pubDate>Sun, 22 Nov 2026 15:47:28 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795362448_rkr_6b030e9074f9a.png" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795362448_rkr_6b030e9074f9a.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795362448_rkr_6b030e9074f9a.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অলিম্পিকের বাছাইপর্ব বাংলাদেশে, ‘মিনি বিশ্বকাপ’ বলছেন তামিম" /&gt;&lt;/p&gt;&lt;p&gt;২০২৮ সালের লস অ্যাঞ্জেলেস অলিম্পিকে ক্রিকেটের প্রত্যাবর্তন হতে যাচ্ছে। সেই অলিম্পিকে খেলার স্বপ্ন পূরণের পথে বাংলাদেশের সামনে বড় সুযোগ এনে দিয়েছে আট দলের বাছাইপর্ব। প্রতিযোগিতাটি আয়োজনের স্বত্ব পেয়েছে বাংলাদেশ। বিষয়টিকে দেশের ক্রিকেটের জন্য বড় অর্জন হিসেবে দেখছেন বাংলাদেশ ক্রিকেট বোর্ডের (বিসিবি) সভ&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%85%E0%A6%B2%E0%A6%AE%E0%A6%AA%E0%A6%95%E0%A6%B0-%E0%A6%AC%E0%A6%9B%E0%A6%87%E0%A6%AA%E0%A6%B0%E0%A6%AC-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6-%E0%A6%AE%E0%A6%A8-%E0%A6%AC%E0%A6%B6%E0%A6%AC%E0%A6%95%E0%A6%AA-%E0%A6%AC%E0%A6%B2%E0%A6%9B%E0%A6%A8-%E0%A6%A4%E0%A6%AE%E0%A6%AE">Education Bangla</source>
    </item>

      <pubDate>Wed, 25 Nov 2026 15:41:03 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795621263_rkr_6b07018f60f67.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795621263_rkr_6b07018f60f67.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795621263_rkr_6b07018f60f67.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ট্রিপল সেঞ্চুরিও ‘অসম্ভব নয়’ সূর্যবংশীর" /&gt;&lt;/p&gt;&lt;p&gt;কাতারের দোহার মাঠে গতকাল ৫৩ বলে ২০৪ রানের বিধ্বংসী ইনিংস খেলে ক্রিকেট দুনিয়াকে যেন নাড়িয়ে দিয়েছেন বৈভব সূর্যবংশী। কিন্তু এই ঝড়ে মোটেও বিস্মিত নন তাঁর ছোটবেলার কোচ মণীশ ওঝা। বরং শিষ্যের অবিশ্বাস্য মারকুটে মেজাজ দেখে এবার ওয়ানডেতে ট্রিপল সেঞ্চুরির বড় ভবিষ্যদ্বাণীই করে বসেছেন তিনি।এশিয়া কাপ রাইজিং স্টা&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%9F%E0%A6%B0%E0%A6%AA%E0%A6%B2-%E0%A6%B8%E0%A6%9E%E0%A6%9A%E0%A6%B0%E0%A6%93-%E0%A6%85%E0%A6%B8%E0%A6%AE%E0%A6%AD%E0%A6%AC-%E0%A6%A8%E0%A7%9F-%E0%A6%B8%E0%A6%B0%E0%A6%AF%E0%A6%AC%E0%A6%B6%E0%A6%B0">Education Bangla</source>
    </item>
    <item>
      <title>স্যান্ডপেপার বিতর্ক মেটাতে খাজার শান্তি প্রস্তাব</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%AF%E0%A6%A8%E0%A6%A1%E0%A6%AA%E0%A6%AA%E0%A6%B0-%E0%A6%AC%E0%A6%A4%E0%A6%B0%E0%A6%95-%E0%A6%AE%E0%A6%9F%E0%A6%A4-%E0%A6%96%E0%A6%9C%E0%A6%B0-%E0%A6%B6%E0%A6%A8%E0%A6%A4-%E0%A6%AA%E0%A6%B0%E0%A6%B8%E0%A6%A4%E0%A6%AC</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%AF%E0%A6%A8%E0%A6%A1%E0%A6%AA%E0%A6%AA%E0%A6%B0-%E0%A6%AC%E0%A6%A4%E0%A6%B0%E0%A6%95-%E0%A6%AE%E0%A6%9F%E0%A6%A4-%E0%A6%96%E0%A6%9C%E0%A6%B0-%E0%A6%B6%E0%A6%A8%E0%A6%A4-%E0%A6%AA%E0%A6%B0%E0%A6%B8%E0%A6%A4%E0%A6%AC</guid>
      <pubDate>Wed, 25 Nov 2026 15:40:15 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795621215_rkr_6b07015f9ce79.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795621215_rkr_6b07015f9ce79.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795621215_rkr_6b07015f9ce79.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="স্যান্ডপেপার বিতর্ক মেটাতে খাজার শান্তি প্রস্তাব" /&gt;&lt;/p&gt;&lt;p&gt;স্যান্ডপেপার বিতর্কে সমঝোতার পথ খুঁজতে চেয়েছিলেন উসমান খাজা, কিন্তু অস্ট্রেলিয়ার অধিনায়ক প্যাট কামিন্সের সংবাদ সম্মেলনের কড়া মন্তব্যে রীতিমতো হতবাক ও ব্যথিত হয়েছেন তিনি। এক পডকাস্ট সাক্ষাৎকারে খাজা শুধু কামিন্সের সেই আচরণ নিয়েই আক্ষেপ প্রকাশ করেননি, বরং আট বছর আগের বল টেম্পারিং কাণ্ডে পুরো দলকে দায়.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%AF%E0%A6%A8%E0%A6%A1%E0%A6%AA%E0%A6%AA%E0%A6%B0-%E0%A6%AC%E0%A6%A4%E0%A6%B0%E0%A6%95-%E0%A6%AE%E0%A6%9F%E0%A6%A4-%E0%A6%96%E0%A6%9C%E0%A6%B0-%E0%A6%B6%E0%A6%A8%E0%A6%A4-%E0%A6%AA%E0%A6%B0%E0%A6%B8%E0%A6%A4%E0%A6%AC">Education Bangla</source>
    </item>
    <item>
      <title>ডি ব্রুইনদের সাথে ড্রর ম্যাচে তালমিলের অভাব দেখছেন হালান্ড</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%A1-%E0%A6%AC%E0%A6%B0%E0%A6%87%E0%A6%A8%E0%A6%A6%E0%A6%B0-%E0%A6%B8%E0%A6%A5-%E0%A6%A1%E0%A6%B0%E0%A6%B0-%E0%A6%AE%E0%A6%AF%E0%A6%9A-%E0%A6%A4%E0%A6%B2%E0%A6%AE%E0%A6%B2%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%AC-%E0%A6%A6%E0%A6%96%E0%A6%9B%E0%A6%A8-%E0%A6%B9%E0%A6%B2%E0%A6%A8%E0%A6%A1</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%A1-%E0%A6%AC%E0%A6%B0%E0%A6%87%E0%A6%A8%E0%A6%A6%E0%A6%B0-%E0%A6%B8%E0%A6%A5-%E0%A6%A1%E0%A6%B0%E0%A6%B0-%E0%A6%AE%E0%A6%AF%E0%A6%9A-%E0%A6%A4%E0%A6%B2%E0%A6%AE%E0%A6%B2%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%AC-%E0%A6%A6%E0%A6%96%E0%A6%9B%E0%A6%A8-%E0%A6%B9%E0%A6%B2%E0%A6%A8%E0%A6%A1</guid>
      <pubDate>Wed, 25 Nov 2026 15:39:22 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795621162_rkr_6b07012addf1f.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795621162_rkr_6b07012addf1f.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795621162_rkr_6b07012addf1f.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডি ব্রুইনদের সাথে ড্রর ম্যাচে তালমিলের অভাব দেখছেন হালান্ড" /&gt;&lt;/p&gt;&lt;p&gt;ম্যানচেস্টার সিটি যে তাদের সেরা ছন্দে নেই, তা অকপটেই স্বীকার করে নিলেন আর্লিং হালান্ড। মঙ্গলবার রাতে উয়েফা চ্যাম্পিয়নস লিগে নাপোলির বিপক্ষে ২-২ গোলে ড্রয়ের পর এই নরওয়েজিয়ান স্ট্রাইকার জানিয়েছেন, দলের ভেতর কোথাও একটা তালমিলের অভাব স্পষ্ট। আর এই ছন্দহীনতার মাঝেই আগামী রবিবার প্রিমিয়ার লিগে আর্সেনালের&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%A1-%E0%A6%AC%E0%A6%B0%E0%A6%87%E0%A6%A8%E0%A6%A6%E0%A6%B0-%E0%A6%B8%E0%A6%A5-%E0%A6%A1%E0%A6%B0%E0%A6%B0-%E0%A6%AE%E0%A6%AF%E0%A6%9A-%E0%A6%A4%E0%A6%B2%E0%A6%AE%E0%A6%B2%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%AC-%E0%A6%A6%E0%A6%96%E0%A6%9B%E0%A6%A8-%E0%A6%B9%E0%A6%B2%E0%A6%A8%E0%A6%A1">Education Bangla</source>
    </item>
    <item>
      <title>যুবরাজের যে টোটকায় সূর্যবংশীর এমন বিধ্বংসী রূপ</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AF%E0%A6%AC%E0%A6%B0%E0%A6%9C%E0%A6%B0-%E0%A6%AF-%E0%A6%9F%E0%A6%9F%E0%A6%95%E0%A7%9F-%E0%A6%B8%E0%A6%B0%E0%A6%AF%E0%A6%AC%E0%A6%B6%E0%A6%B0-%E0%A6%8F%E0%A6%AE%E0%A6%A8-%E0%A6%AC%E0%A6%A7%E0%A6%AC%E0%A6%B8-%E0%A6%B0%E0%A6%AA</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AF%E0%A6%AC%E0%A6%B0%E0%A6%9C%E0%A6%B0-%E0%A6%AF-%E0%A6%9F%E0%A6%9F%E0%A6%95%E0%A7%9F-%E0%A6%B8%E0%A6%B0%E0%A6%AF%E0%A6%AC%E0%A6%B6%E0%A6%B0-%E0%A6%8F%E0%A6%AE%E0%A6%A8-%E0%A6%AC%E0%A6%A7%E0%A6%AC%E0%A6%B8-%E0%A6%B0%E0%A6%AA</guid>
      <pubDate>Wed, 25 Nov 2026 15:38:45 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795621125_rkr_6b070105edf81.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795621125_rkr_6b070105edf81.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795621125_rkr_6b070105edf81.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যুবরাজের যে টোটকায় সূর্যবংশীর এমন বিধ্বংসী রূপ" /&gt;&lt;/p&gt;&lt;p&gt;বয়স মাত্র ১৫, কিন্তু ব্যাটের তাণ্ডবে রীতিমতো বিশ্বরেকর্ড ওলটপালট করে দিয়েছেন ভারতের বিস্ময়বালক বৈভব সূর্যবংশী। মঙ্গলবার এশিয়া কাপ রাইজিং স্টারস টুর্নামেন্টে সংযুক্ত আরব আমিরাতের বিপক্ষে ভারত ‘এ’ দলের হয়ে মাত্র ৫৩ বলে ২০৪ রানের এক অতিমানবীয় ইনিংস খেলেছেন তিনি। ২৮ ছক্কায় সাজানো এই বিধ্বংসী ইনিংসের পেছ&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AF%E0%A6%AC%E0%A6%B0%E0%A6%9C%E0%A6%B0-%E0%A6%AF-%E0%A6%9F%E0%A6%9F%E0%A6%95%E0%A7%9F-%E0%A6%B8%E0%A6%B0%E0%A6%AF%E0%A6%AC%E0%A6%B6%E0%A6%B0-%E0%A6%8F%E0%A6%AE%E0%A6%A8-%E0%A6%AC%E0%A6%A7%E0%A6%AC%E0%A6%B8-%E0%A6%B0%E0%A6%AA">Education Bangla</source>
    </item>
    <item>
      <title>সিরিজ হারের পর শান্ত, ‘উই হ্যাভ সাম পজিটিভস’</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%B0%E0%A6%9C-%E0%A6%B9%E0%A6%B0%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%B6%E0%A6%A8%E0%A6%A4-%E0%A6%89%E0%A6%87-%E0%A6%B9%E0%A6%AF%E0%A6%AD-%E0%A6%B8%E0%A6%AE-%E0%A6%AA%E0%A6%9C%E0%A6%9F%E0%A6%AD%E0%A6%B8</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%B0%E0%A6%9C-%E0%A6%B9%E0%A6%B0%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%B6%E0%A6%A8%E0%A6%A4-%E0%A6%89%E0%A6%87-%E0%A6%B9%E0%A6%AF%E0%A6%AD-%E0%A6%B8%E0%A6%AE-%E0%A6%AA%E0%A6%9C%E0%A6%9F%E0%A6%AD%E0%A6%B8</guid>
      <pubDate>Wed, 25 Nov 2026 15:37:52 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795622675_rkr_6b0707134da6b.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795622675_rkr_6b0707134da6b.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795622675_rkr_6b0707134da6b.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সিরিজ হারের পর শান্ত, ‘উই হ্যাভ সাম পজিটিভস’" /&gt;&lt;/p&gt;&lt;p&gt;জোহানেসবার্গে ৯ উইকেটে হারের পর সেঞ্চুরিয়ন টেস্টে ইনিংস ও ২১৯ রানের ব্যবধানে হার। এই দুইয়ে মিলে অবস্থাটা তো কিছু পাওয়ার আশায় এসে অন্ধকার বরণ নেওয়ার মতোনই যেন অবস্থা। তবে সিরিজে হোয়াইটওয়াশের পরও সবকিছুতে অন্ধকার দেখছেন না বাংলাদেশ অধিনায়ক নাজমুল হোসেন শান্ত। বড় পরাজয়ের ধাক্কা সামলে নিজেদের ভেতরের কিছ&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%B0%E0%A6%9C-%E0%A6%B9%E0%A6%B0%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%B6%E0%A6%A8%E0%A6%A4-%E0%A6%89%E0%A6%87-%E0%A6%B9%E0%A6%AF%E0%A6%AD-%E0%A6%B8%E0%A6%AE-%E0%A6%AA%E0%A6%9C%E0%A6%9F%E0%A6%AD%E0%A6%B8">Education Bangla</source>

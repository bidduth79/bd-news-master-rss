      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794499606_rkr_6af5e4162beb0.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794499606_rkr_6af5e4162beb0.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794499606_rkr_6af5e4162beb0.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাফের সেমিফাইনাল-ফাইনালে ভিএআর, নিয়ন্ত্রণ হবে থাইল্যান্ড থেকে" /&gt;&lt;/p&gt;&lt;p&gt;সাফ চ্যাম্পিয়নশিপের ইতিহাসে এবারই প্রথম ব্যবহার হতে যাচ্ছে ভিডিও অ্যাসিস্ট্যান্ট রেফারি (ভিএআর)। টুর্নামেন্টের সেমিফাইনাল ও ফাইনালে থাকবে এই প্রযুক্তির সহায়তা। খেলা বাংলাদেশে হলেও এই প্রযুক্তি পরিচালিত হবে থাইল্যান্ডের কেন্দ্রীয় নিয়ন্ত্রণকক্ষ থেকে।ঢাকা জাতীয় স্টেডিয়ামে খেলা চলার সময় মাঠের ক্যামেরায়.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%AB%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2-%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2-%E0%A6%AD%E0%A6%8F%E0%A6%86%E0%A6%B0-%E0%A6%A8%E0%A7%9F%E0%A6%A8%E0%A6%A4%E0%A6%B0%E0%A6%A3-%E0%A6%B9%E0%A6%AC-%E0%A6%A5%E0%A6%87%E0%A6%B2%E0%A6%AF%E0%A6%A8%E0%A6%A1-%E0%A6%A5%E0%A6%95">Education Bangla</source>
    </item>
    <item>
      <title>সাফে সাংবাদিকদের ওপর পুলিশের হামলা: তদন্ত ও নিরাপত্তা চাইলো তিন সংগঠন</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%AB-%E0%A6%B8%E0%A6%AC%E0%A6%A6%E0%A6%95%E0%A6%A6%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%AA%E0%A6%B2%E0%A6%B6%E0%A6%B0-%E0%A6%B9%E0%A6%AE%E0%A6%B2-%E0%A6%A4%E0%A6%A6%E0%A6%A8%E0%A6%A4-%E0%A6%93-%E0%A6%A8%E0%A6%B0%E0%A6%AA%E0%A6%A4%E0%A6%A4-%E0%A6%9A%E0%A6%87%E0%A6%B2-%E0%A6%A4%E0%A6%A8-%E0%A6%B8%E0%A6%97%E0%A6%A0%E0%A6%A8</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%AB-%E0%A6%B8%E0%A6%AC%E0%A6%A6%E0%A6%95%E0%A6%A6%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%AA%E0%A6%B2%E0%A6%B6%E0%A6%B0-%E0%A6%B9%E0%A6%AE%E0%A6%B2-%E0%A6%A4%E0%A6%A6%E0%A6%A8%E0%A6%A4-%E0%A6%93-%E0%A6%A8%E0%A6%B0%E0%A6%AA%E0%A6%A4%E0%A6%A4-%E0%A6%9A%E0%A6%87%E0%A6%B2-%E0%A6%A4%E0%A6%A8-%E0%A6%B8%E0%A6%97%E0%A6%A0%E0%A6%A8</guid>
      <pubDate>Thu, 12 Nov 2026 16:05:36 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794499536_rkr_6af5e3d0ac3a0.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794499536_rkr_6af5e3d0ac3a0.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794499536_rkr_6af5e3d0ac3a0.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাফে সাংবাদিকদের ওপর পুলিশের হামলা: তদন্ত ও নিরাপত্তা চাইলো তিন সংগঠন" /&gt;&lt;/p&gt;&lt;p&gt;সাফ চ্যাম্পিয়নশিপে বাংলাদেশ-শ্রীলঙ্কা ম্যাচ কাভার করতে গিয়ে পুলিশের হামলার শিকার হয়েছেন কয়েকজন ক্রীড়া সাংবাদিক। এ ঘটনায় জড়িত পুলিশ সদস্যদের বিরুদ্ধে ব্যবস্থা নেওয়া এবং দেশের সব স্টেডিয়ামে সাংবাদিকদের নিরাপত্তা নিশ্চিত করার দাবি জানিয়েছে ক্রীড়া সাংবাদিকদের তিন সংগঠন।বৃহস্পতিবার যুব ও ক্রীড়া প্রতিমন্ত&lt;/p&gt;</description>

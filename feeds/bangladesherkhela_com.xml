      <title>৪৩৪ রানের পর পাকিস্তানের দাপুটে বোলিং, চাপে শ্রীলঙ্কা</title>
      <link>https://bangladesherkhela.com/news/%E0%A7%AA%E0%A7%A9%E0%A7%AA-%E0%A6%B0%E0%A6%A8%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AA%E0%A6%95%E0%A6%B8%E0%A6%A4%E0%A6%A8%E0%A6%B0-%E0%A6%A6%E0%A6%AA%E0%A6%9F-%E0%A6%AC%E0%A6%B2-%E0%A6%9A%E0%A6%AA-%E0%A6%B6%E0%A6%B0%E0%A6%B2%E0%A6%99%E0%A6%95</link>

      <title>তরুণ ফুটবলারদের নিয়ে ধৈর্য ধরতে বললেন স্কালোনি</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%A4%E0%A6%B0%E0%A6%A3-%E0%A6%AB%E0%A6%9F%E0%A6%AC%E0%A6%B2%E0%A6%B0%E0%A6%A6%E0%A6%B0-%E0%A6%A8%E0%A7%9F-%E0%A6%A7%E0%A6%B0%E0%A6%AF-%E0%A6%A7%E0%A6%B0%E0%A6%A4-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A6%A8-%E0%A6%B8%E0%A6%95%E0%A6%B2%E0%A6%A8</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%A4%E0%A6%B0%E0%A6%A3-%E0%A6%AB%E0%A6%9F%E0%A6%AC%E0%A6%B2%E0%A6%B0%E0%A6%A6%E0%A6%B0-%E0%A6%A8%E0%A7%9F-%E0%A6%A7%E0%A6%B0%E0%A6%AF-%E0%A6%A7%E0%A6%B0%E0%A6%A4-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A6%A8-%E0%A6%B8%E0%A6%95%E0%A6%B2%E0%A6%A8</guid>
      <pubDate>Sat, 14 Nov 2026 13:20:55 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794662455_rkr_6af86037dcfb7.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794662455_rkr_6af86037dcfb7.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794662455_rkr_6af86037dcfb7.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="তরুণ ফুটবলারদের নিয়ে ধৈর্য ধরতে বললেন স্কালোনি" /&gt;&lt;/p&gt;&lt;p&gt;লিওনেল মেসি-পরবর্তী যুগের প্রথম ম্যাচে উরুগুয়ের কাছে ২-১ গোলে হতাশাজনক হারের পর দেশের উদীয়মান তরুণ ফুটবলারদের প্রতি ধৈর্য ধরার আহ্বান জানিয়েছেন আর্জেন্টিনার প্রধান কোচ লিওনেল স্কালোনি। তাঁর মতে, এখনই এই তরুণদের ওপর জাতীয় দলকে কাঁধে বয়ে নেওয়ার মতো ভারী দায়িত্ব চাপিয়ে দেওয়া উচিত নয়।লা বোম্বোনেরায় অনুষ&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%A4%E0%A6%B0%E0%A6%A3-%E0%A6%AB%E0%A6%9F%E0%A6%AC%E0%A6%B2%E0%A6%B0%E0%A6%A6%E0%A6%B0-%E0%A6%A8%E0%A7%9F-%E0%A6%A7%E0%A6%B0%E0%A6%AF-%E0%A6%A7%E0%A6%B0%E0%A6%A4-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A6%A8-%E0%A6%B8%E0%A6%95%E0%A6%B2%E0%A6%A8">Education Bangla</source>
    </item>
    <item>
      <title>চার-ছক্কার ফুলঝুরিতে সৈকতের অনবদ্য সেঞ্চুরি</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%9A%E0%A6%B0-%E0%A6%9B%E0%A6%95%E0%A6%95%E0%A6%B0-%E0%A6%AB%E0%A6%B2%E0%A6%9D%E0%A6%B0%E0%A6%A4-%E0%A6%B8%E0%A6%95%E0%A6%A4%E0%A6%B0-%E0%A6%85%E0%A6%A8%E0%A6%AC%E0%A6%A6%E0%A6%AF-%E0%A6%B8%E0%A6%9E%E0%A6%9A%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%9A%E0%A6%B0-%E0%A6%9B%E0%A6%95%E0%A6%95%E0%A6%B0-%E0%A6%AB%E0%A6%B2%E0%A6%9D%E0%A6%B0%E0%A6%A4-%E0%A6%B8%E0%A6%95%E0%A6%A4%E0%A6%B0-%E0%A6%85%E0%A6%A8%E0%A6%AC%E0%A6%A6%E0%A6%AF-%E0%A6%B8%E0%A6%9E%E0%A6%9A%E0%A6%B0</guid>
      <pubDate>Sat, 14 Nov 2026 13:15:58 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794662158_rkr_6af85f0e30010.jpeg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794662158_rkr_6af85f0e30010.jpeg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794662158_rkr_6af85f0e30010.jpeg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চার-ছক্কার ফুলঝুরিতে সৈকতের অনবদ্য সেঞ্চুরি" /&gt;&lt;/p&gt;&lt;p&gt;অনবদ্য এক সেঞ্চুরি হাঁকিয়েছেন মোসাদ্দেক হোসেন সৈকত। জাতীয় দলের বাইরে থাকা এই অলরাউন্ডার ব্যাট হাতে চার-ছক্কার ফুলঝুরি ফুটিয়ে তুলে নিয়েছেন প্রথম শ্রেণির ক্রিকেট ক্যারিয়ারে নিজের ১২তম সেঞ্চুরি। জাতীয় ক্রিকেট লিগের (এনসিএল) সপ্তম তথা শেষ রাউন্ডের প্রথম দিনে আরও ৬ ব্যাটার ফিফটি হাঁকালেও কোনো ব্যাটার সেট&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%9A%E0%A6%B0-%E0%A6%9B%E0%A6%95%E0%A6%95%E0%A6%B0-%E0%A6%AB%E0%A6%B2%E0%A6%9D%E0%A6%B0%E0%A6%A4-%E0%A6%B8%E0%A6%95%E0%A6%A4%E0%A6%B0-%E0%A6%85%E0%A6%A8%E0%A6%AC%E0%A6%A6%E0%A6%AF-%E0%A6%B8%E0%A6%9E%E0%A6%9A%E0%A6%B0">Education Bangla</source>
    </item>
    <item>
      <title>মিরাজকে চ্যালেঞ্জ মনে হচ্ছে বাভুমার</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%B0%E0%A6%9C%E0%A6%95-%E0%A6%9A%E0%A6%AF%E0%A6%B2%E0%A6%9E%E0%A6%9C-%E0%A6%AE%E0%A6%A8-%E0%A6%B9%E0%A6%9A%E0%A6%9B-%E0%A6%AC%E0%A6%AD%E0%A6%AE%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%B0%E0%A6%9C%E0%A6%95-%E0%A6%9A%E0%A6%AF%E0%A6%B2%E0%A6%9E%E0%A6%9C-%E0%A6%AE%E0%A6%A8-%E0%A6%B9%E0%A6%9A%E0%A6%9B-%E0%A6%AC%E0%A6%AD%E0%A6%AE%E0%A6%B0</guid>
      <pubDate>Sat, 14 Nov 2026 13:06:11 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794661571_rkr_6af85cc32185c.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794661571_rkr_6af85cc32185c.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794661571_rkr_6af85cc32185c.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মিরাজকে চ্যালেঞ্জ মনে হচ্ছে বাভুমার" /&gt;&lt;/p&gt;&lt;p&gt;দক্ষিণ আফ্রিকার মাটিতে গুরুত্বপূর্ণ টেস্ট সিরিজ খেলতে নামছে বাংলাদেশ দল। এক দিন আগেই প্রথম টেস্টের দল ঘোষণা করেছে স্বাগতিকরা। চার পেসার নিয়েছে দল সাজিয়েছে স্বাগতিকরা। অধিনায়ক টেম্বা বাভুমা অবশ্য অফ স্পিনে নিজের ক্যারিয়ারের শুরু থেকে দুর্বল। ম্যাচের আগের দিন তাই মেহেদী হাসান মিরাজকে নিয়ে সতর্কতার কথা&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%B0%E0%A6%9C%E0%A6%95-%E0%A6%9A%E0%A6%AF%E0%A6%B2%E0%A6%9E%E0%A6%9C-%E0%A6%AE%E0%A6%A8-%E0%A6%B9%E0%A6%9A%E0%A6%9B-%E0%A6%AC%E0%A6%AD%E0%A6%AE%E0%A6%B0">Education Bangla</source>
    </item>
    <item>
      <title>অস্ট্রেলিয়াকে চাপে ফেলায় বাংলাদেশকে সম্মান করছেন বাভুমা</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%85%E0%A6%B8%E0%A6%9F%E0%A6%B0%E0%A6%B2%E0%A7%9F%E0%A6%95-%E0%A6%9A%E0%A6%AA-%E0%A6%AB%E0%A6%B2%E0%A7%9F-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6%E0%A6%95-%E0%A6%B8%E0%A6%AE%E0%A6%AE%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A6%9B%E0%A6%A8-%E0%A6%AC%E0%A6%AD%E0%A6%AE</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%85%E0%A6%B8%E0%A6%9F%E0%A6%B0%E0%A6%B2%E0%A7%9F%E0%A6%95-%E0%A6%9A%E0%A6%AA-%E0%A6%AB%E0%A6%B2%E0%A7%9F-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6%E0%A6%95-%E0%A6%B8%E0%A6%AE%E0%A6%AE%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A6%9B%E0%A6%A8-%E0%A6%AC%E0%A6%AD%E0%A6%AE</guid>

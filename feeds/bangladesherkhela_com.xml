      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795189851_rkr_6b006c5bbbb5e.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795189851_rkr_6b006c5bbbb5e.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795189851_rkr_6b006c5bbbb5e.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৭ বছর ধরে লোকসান, পিএসএল ছাড়তে চায় যে ফ্র্যাঞ্চাইজি" /&gt;&lt;/p&gt;&lt;p&gt;পাকিস্তান সুপার লিগের (পিএসএল) শুরুর দিকের অন্যতম পরিচিত দল কোয়েটা গ্ল্যাডিয়েটর্স। চারবার ফাইনালে খেলা ও একবার শিরোপা জেতা এই ফ্র্যাঞ্চাইজি ছাড়ার ইঙ্গিত দিয়েছেন মালিক নাদিম ওমর। দীর্ঘ সাত বছরের লোকসান, বাণিজ্যিক সীমাবদ্ধতা এবং ইন্ডিয়ান প্রিমিয়ার লিগের (আইপিএল) সঙ্গে অসম প্রতিযোগিতার বাস্তবতা সামনে এ&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A7%AD-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%A7%E0%A6%B0-%E0%A6%B2%E0%A6%95%E0%A6%B8%E0%A6%A8-%E0%A6%AA%E0%A6%8F%E0%A6%B8%E0%A6%8F%E0%A6%B2-%E0%A6%9B%E0%A6%A1%E0%A6%A4-%E0%A6%9A%E0%A6%AF-%E0%A6%AF-%E0%A6%AB%E0%A6%B0%E0%A6%AF%E0%A6%9E%E0%A6%9A%E0%A6%87%E0%A6%9C">Education Bangla</source>
    </item>
    <item>
      <title>দক্ষিণ আফ্রিকা যাচ্ছেন রিশাদ-তানভীর</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%A6%E0%A6%95%E0%A6%B7%E0%A6%A3-%E0%A6%86%E0%A6%AB%E0%A6%B0%E0%A6%95-%E0%A6%AF%E0%A6%9A%E0%A6%9B%E0%A6%A8-%E0%A6%B0%E0%A6%B6%E0%A6%A6-%E0%A6%A4%E0%A6%A8%E0%A6%AD%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%A6%E0%A6%95%E0%A6%B7%E0%A6%A3-%E0%A6%86%E0%A6%AB%E0%A6%B0%E0%A6%95-%E0%A6%AF%E0%A6%9A%E0%A6%9B%E0%A6%A8-%E0%A6%B0%E0%A6%B6%E0%A6%A6-%E0%A6%A4%E0%A6%A8%E0%A6%AD%E0%A6%B0</guid>
      <pubDate>Fri, 20 Nov 2026 15:33:48 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795188828_rkr_6b00685c02427.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795188828_rkr_6b00685c02427.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795188828_rkr_6b00685c02427.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দক্ষিণ আফ্রিকা যাচ্ছেন রিশাদ-তানভীর" /&gt;&lt;/p&gt;&lt;p&gt;দক্ষিণ আফ্রিকা সফর শেষ না করেই দেশে ফিরছেন বাংলাদেশ দলের ডানহাতি পেসার হাসান মাহমুদ। পুরোনো চোটের কারণে প্রোটিয়াদের বিপক্ষে সিরিজের দ্বিতীয় ও শেষ টেস্টে খেলা হচ্ছে না তার। একই সঙ্গে দক্ষিণ আফ্রিকার বিপক্ষে আসন্ন ওয়ানডে ও টি-টোয়েন্টি সিরিজেও ত্যার খেলা নিয়ে অনিশ্চয়তা তৈরি হয়েছে।আগামী রবিবার সকালে ঢাক&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%A6%E0%A6%95%E0%A6%B7%E0%A6%A3-%E0%A6%86%E0%A6%AB%E0%A6%B0%E0%A6%95-%E0%A6%AF%E0%A6%9A%E0%A6%9B%E0%A6%A8-%E0%A6%B0%E0%A6%B6%E0%A6%A6-%E0%A6%A4%E0%A6%A8%E0%A6%AD%E0%A6%B0">Education Bangla</source>
    </item>
    <item>
      <title>ভিনিসিয়ুস প্রসঙ্গে মরিনহোর হুঁশিয়ারি, ‘কেউ বাড়তি সুবিধা পাবে না’</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AD%E0%A6%A8%E0%A6%B8%E0%A7%9F%E0%A6%B8-%E0%A6%AA%E0%A6%B0%E0%A6%B8%E0%A6%99%E0%A6%97-%E0%A6%AE%E0%A6%B0%E0%A6%A8%E0%A6%B9%E0%A6%B0-%E0%A6%B9%E0%A6%B6%E0%A7%9F%E0%A6%B0-%E0%A6%95%E0%A6%89-%E0%A6%AC%E0%A7%9C%E0%A6%A4-%E0%A6%B8%E0%A6%AC%E0%A6%A7-%E0%A6%AA%E0%A6%AC-%E0%A6%A8</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AD%E0%A6%A8%E0%A6%B8%E0%A7%9F%E0%A6%B8-%E0%A6%AA%E0%A6%B0%E0%A6%B8%E0%A6%99%E0%A6%97-%E0%A6%AE%E0%A6%B0%E0%A6%A8%E0%A6%B9%E0%A6%B0-%E0%A6%B9%E0%A6%B6%E0%A7%9F%E0%A6%B0-%E0%A6%95%E0%A6%89-%E0%A6%AC%E0%A7%9C%E0%A6%A4-%E0%A6%B8%E0%A6%AC%E0%A6%A7-%E0%A6%AA%E0%A6%AC-%E0%A6%A8</guid>
      <pubDate>Fri, 20 Nov 2026 15:32:40 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795188760_rkr_6b0068187d11a.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795188760_rkr_6b0068187d11a.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795188760_rkr_6b0068187d11a.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভিনিসিয়ুস প্রসঙ্গে মরিনহোর হুঁশিয়ারি, ‘কেউ বাড়তি সুবিধা পাবে না’" /&gt;&lt;/p&gt;&lt;p&gt;সান্তিয়াগো বার্নাব্যুতে সেলতা ভিগোর বিপক্ষে লা লিগার ম্যাচ সামনে রেখে ড্রেসিংরুমের উদ্দেশে কঠোর ও স্পষ্ট বার্তা দিলেন রিয়াল মাদ্রিদ কোচ হোসে মরিনহো। তারকাখ্যাতি বা বড় চুক্তির জোরে কারও একাদশে জায়গা নিশ্চিত নয়, প্রাক-ম্যাচ সংবাদ সম্মেলনে এমন হুঁশিয়ারি দিয়ে মূলত ব্রাজিলিয়ান ফরোয়ার্ড ভিনিসিয়ুস জুনিয়রের&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AD%E0%A6%A8%E0%A6%B8%E0%A7%9F%E0%A6%B8-%E0%A6%AA%E0%A6%B0%E0%A6%B8%E0%A6%99%E0%A6%97-%E0%A6%AE%E0%A6%B0%E0%A6%A8%E0%A6%B9%E0%A6%B0-%E0%A6%B9%E0%A6%B6%E0%A7%9F%E0%A6%B0-%E0%A6%95%E0%A6%89-%E0%A6%AC%E0%A7%9C%E0%A6%A4-%E0%A6%B8%E0%A6%AC%E0%A6%A7-%E0%A6%AA%E0%A6%AC-%E0%A6%A8">Education Bangla</source>
    </item>
    <item>
      <title>নেইমারের সঙ্গে জুটি গড়তে রিয়াল মাদ্রিদ তারকাকে চায় সান্তোস</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%A8%E0%A6%87%E0%A6%AE%E0%A6%B0%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A6%97-%E0%A6%9C%E0%A6%9F-%E0%A6%97%E0%A7%9C%E0%A6%A4-%E0%A6%B0%E0%A7%9F%E0%A6%B2-%E0%A6%AE%E0%A6%A6%E0%A6%B0%E0%A6%A6-%E0%A6%A4%E0%A6%B0%E0%A6%95%E0%A6%95-%E0%A6%9A%E0%A7%9F-%E0%A6%B8%E0%A6%A8%E0%A6%A4%E0%A6%B8</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%A8%E0%A6%87%E0%A6%AE%E0%A6%B0%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A6%97-%E0%A6%9C%E0%A6%9F-%E0%A6%97%E0%A7%9C%E0%A6%A4-%E0%A6%B0%E0%A7%9F%E0%A6%B2-%E0%A6%AE%E0%A6%A6%E0%A6%B0%E0%A6%A6-%E0%A6%A4%E0%A6%B0%E0%A6%95%E0%A6%95-%E0%A6%9A%E0%A7%9F-%E0%A6%B8%E0%A6%A8%E0%A6%A4%E0%A6%B8</guid>
      <pubDate>Fri, 20 Nov 2026 15:30:17 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795188617_rkr_6b00678994d52.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795188617_rkr_6b00678994d52.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795188617_rkr_6b00678994d52.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নেইমারের সঙ্গে জুটি গড়তে রিয়াল মাদ্রিদ তারকাকে চায় সান্তোস" /&gt;&lt;/p&gt;&lt;p&gt;দীর্ঘ নয় মাসের কঠিন পুনর্বাসন পেরিয়ে মাঠে ফেরার প্রহর গুনছেন রদ্রিগো, আর ঠিক সেই মুহূর্তেই তাঁকে ঘিরে সান্তোসে তৈরি হয়েছে নতুন উন্মাদনা। নেইমারের সঙ্গী হিসেবে ব্রাজিলেইরাঁওয়ের প্রথমার্ধে রদ্রিগোকে ধারে পাওয়ার আশা করলেও, নিজেদের স্কোয়াডের গভীরতা ও ভবিষ্যতের কথা ভেবে রদ্রিগোকে এই মুহূর্তে ছাড়ার কথা ভা&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%A8%E0%A6%87%E0%A6%AE%E0%A6%B0%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A6%97-%E0%A6%9C%E0%A6%9F-%E0%A6%97%E0%A7%9C%E0%A6%A4-%E0%A6%B0%E0%A7%9F%E0%A6%B2-%E0%A6%AE%E0%A6%A6%E0%A6%B0%E0%A6%A6-%E0%A6%A4%E0%A6%B0%E0%A6%95%E0%A6%95-%E0%A6%9A%E0%A7%9F-%E0%A6%B8%E0%A6%A8%E0%A6%A4%E0%A6%B8">Education Bangla</source>
    </item>
    <item>
      <title>কোয়ার্টার ফাইনালে স্পেন-ফ্রান্স, ইংল্যান্ড-নরওয়ে মুখোমুখি</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%95%E0%A7%9F%E0%A6%B0%E0%A6%9F%E0%A6%B0-%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2-%E0%A6%B8%E0%A6%AA%E0%A6%A8-%E0%A6%AB%E0%A6%B0%E0%A6%A8%E0%A6%B8-%E0%A6%87%E0%A6%B2%E0%A6%AF%E0%A6%A8%E0%A6%A1-%E0%A6%A8%E0%A6%B0%E0%A6%93%E0%A7%9F-%E0%A6%AE%E0%A6%96%E0%A6%AE%E0%A6%96</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%95%E0%A7%9F%E0%A6%B0%E0%A6%9F%E0%A6%B0-%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2-%E0%A6%B8%E0%A6%AA%E0%A6%A8-%E0%A6%AB%E0%A6%B0%E0%A6%A8%E0%A6%B8-%E0%A6%87%E0%A6%B2%E0%A6%AF%E0%A6%A8%E0%A6%A1-%E0%A6%A8%E0%A6%B0%E0%A6%93%E0%A7%9F-%E0%A6%AE%E0%A6%96%E0%A6%AE%E0%A6%96</guid>
      <pubDate>Fri, 20 Nov 2026 14:51:27 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795186287_rkr_6b005e6f02f2d.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795186287_rkr_6b005e6f02f2d.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795186287_rkr_6b005e6f02f2d.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কোয়ার্টার ফাইনালে স্পেন-ফ্রান্স, ইংল্যান্ড-নরওয়ে মুখোমুখি" /&gt;&lt;/p&gt;&lt;p&gt;উয়েফা নেশন্স লিগের কোয়ার্টার ফাইনালে মুখোমুখি হবে বিশ্বচ্যাম্পিয়ন স্পেন ও ফ্রান্স। অন্যদিকে, শেষ আটে ইংল্যান্ডের প্রতিপক্ষ নরওয়ে। শুক্রবার অনুষ্ঠিত ড্রয়ে নির্ধারিত হয়েছে কোয়ার্টার ফাইনালের সূচি।জুলাইয়ে যুক্তরাষ্ট্রে অনুষ্ঠিত বিশ্বকাপের সেমিফাইনালে ফ্রান্সকে ২-০ গোলে হারিয়েছিল স্পেন। এরপর শিরোপাও জেত&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%95%E0%A7%9F%E0%A6%B0%E0%A6%9F%E0%A6%B0-%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2-%E0%A6%B8%E0%A6%AA%E0%A6%A8-%E0%A6%AB%E0%A6%B0%E0%A6%A8%E0%A6%B8-%E0%A6%87%E0%A6%B2%E0%A6%AF%E0%A6%A8%E0%A6%A1-%E0%A6%A8%E0%A6%B0%E0%A6%93%E0%A7%9F-%E0%A6%AE%E0%A6%96%E0%A6%AE%E0%A6%96">Education Bangla</source>
    </item>

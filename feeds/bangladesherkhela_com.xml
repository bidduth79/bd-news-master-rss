      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795796255_rkr_6b09ad1fb2519.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অনুশীলন মাঠে পুলিশের অভিযানে গ্রেপ্তার ব্রাজিলিয়ান ফুটবলার" /&gt;&lt;/p&gt;&lt;p&gt;অনুশীলন শুরুর অপেক্ষায় ছিলেন খেলোয়াড়েরা। এমন সময় দুটি পুলিশের গাড়ি এসে থামে অনুশীলনকেন্দ্রের সামনে। এরপর মাঠে ঢুকে ব্রাজিলের ক্লাব ভাস্কো দা গামার স্ট্রাইকার দাভিদ কোরেয়াকে গ্রেপ্তার করে পুলিশ। মাদক, অস্ত্র ও অর্থ পাচারের অভিযোগে চলা একটি বড় তদন্তের অংশ হিসেবে তাকে গ্রেপ্তার করা হয়েছে।বৃহস্পতিবার (২&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%85%E0%A6%A8%E0%A6%B6%E0%A6%B2%E0%A6%A8-%E0%A6%AE%E0%A6%A0-%E0%A6%AA%E0%A6%B2%E0%A6%B6%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%AF%E0%A6%A8-%E0%A6%97%E0%A6%B0%E0%A6%AA%E0%A6%A4%E0%A6%B0-%E0%A6%AC%E0%A6%B0%E0%A6%9C%E0%A6%B2%E0%A7%9F%E0%A6%A8-%E0%A6%AB%E0%A6%9F%E0%A6%AC%E0%A6%B2%E0%A6%B0">Education Bangla</source>
    </item>
    <item>
      <title>অধিনায়ককে নিয়ে ম্যানইউর বড় সিদ্ধান্ত</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%85%E0%A6%A7%E0%A6%A8%E0%A7%9F%E0%A6%95%E0%A6%95-%E0%A6%A8%E0%A7%9F-%E0%A6%AE%E0%A6%AF%E0%A6%A8%E0%A6%87%E0%A6%89%E0%A6%B0-%E0%A6%AC%E0%A7%9C-%E0%A6%B8%E0%A6%A6%E0%A6%A7%E0%A6%A8%E0%A6%A4</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%85%E0%A6%A7%E0%A6%A8%E0%A7%9F%E0%A6%95%E0%A6%95-%E0%A6%A8%E0%A7%9F-%E0%A6%AE%E0%A6%AF%E0%A6%A8%E0%A6%87%E0%A6%89%E0%A6%B0-%E0%A6%AC%E0%A7%9C-%E0%A6%B8%E0%A6%A6%E0%A6%A7%E0%A6%A8%E0%A6%A4</guid>
      <pubDate>Fri, 27 Nov 2026 16:14:40 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795796080_rkr_6b09ac7056353.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795796080_rkr_6b09ac7056353.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795796080_rkr_6b09ac7056353.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অধিনায়ককে নিয়ে ম্যানইউর বড় সিদ্ধান্ত" /&gt;&lt;/p&gt;&lt;p&gt;আগামী গ্রীষ্মে ব্রুনো ফার্নান্দেসের চুক্তির মেয়াদ শেষ হওয়ার কথা ছিল। কিন্তু ম্যানচেস্টার ইউনাইটেড তাদের অধিনায়কের বর্তমান চুক্তির মেয়াদ আরও এক বছর বাড়ানোর শর্ত কার্যকর করেছে।সূত্রগুলো বলছে, দুই পক্ষই নিজেদের স্বার্থের জন্য শ্রেয় মনে করেই এই চুক্তির শর্ত কার্যকর করার সিদ্ধান্ত নিয়েছে। ২০২৮ সালের জুন.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%85%E0%A6%A7%E0%A6%A8%E0%A7%9F%E0%A6%95%E0%A6%95-%E0%A6%A8%E0%A7%9F-%E0%A6%AE%E0%A6%AF%E0%A6%A8%E0%A6%87%E0%A6%89%E0%A6%B0-%E0%A6%AC%E0%A7%9C-%E0%A6%B8%E0%A6%A6%E0%A6%A7%E0%A6%A8%E0%A6%A4">Education Bangla</source>
    </item>

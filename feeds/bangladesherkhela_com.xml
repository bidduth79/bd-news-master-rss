    <item>
      <title>৩২ বছর বয়সেই ক্রিকেটকে বিদায় জানালেন বাবা অপারাজিথ</title>
      <link>https://bangladesherkhela.com/news/%E0%A7%A9%E0%A7%A8-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%AC%E0%A7%9F%E0%A6%B8%E0%A6%87-%E0%A6%95%E0%A6%B0%E0%A6%95%E0%A6%9F%E0%A6%95-%E0%A6%AC%E0%A6%A6%E0%A7%9F-%E0%A6%9C%E0%A6%A8%E0%A6%B2%E0%A6%A8-%E0%A6%AC%E0%A6%AC-%E0%A6%85%E0%A6%AA%E0%A6%B0%E0%A6%9C%E0%A6%A5</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A7%A9%E0%A7%A8-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%AC%E0%A7%9F%E0%A6%B8%E0%A6%87-%E0%A6%95%E0%A6%B0%E0%A6%95%E0%A6%9F%E0%A6%95-%E0%A6%AC%E0%A6%A6%E0%A7%9F-%E0%A6%9C%E0%A6%A8%E0%A6%B2%E0%A6%A8-%E0%A6%AC%E0%A6%AC-%E0%A6%85%E0%A6%AA%E0%A6%B0%E0%A6%9C%E0%A6%A5</guid>

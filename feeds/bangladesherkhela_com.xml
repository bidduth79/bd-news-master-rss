    <item>
      <title>আইপিএল নিলামে আবারও মোস্তাফিজ</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%87%E0%A6%AA%E0%A6%8F%E0%A6%B2-%E0%A6%A8%E0%A6%B2%E0%A6%AE-%E0%A6%86%E0%A6%AC%E0%A6%B0%E0%A6%93-%E0%A6%AE%E0%A6%B8%E0%A6%A4%E0%A6%AB%E0%A6%9C</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%87%E0%A6%AA%E0%A6%8F%E0%A6%B2-%E0%A6%A8%E0%A6%B2%E0%A6%AE-%E0%A6%86%E0%A6%AC%E0%A6%B0%E0%A6%93-%E0%A6%AE%E0%A6%B8%E0%A6%A4%E0%A6%AB%E0%A6%9C</guid>
      <pubDate>Wed, 11 Nov 2026 16:23:49 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794414229_rkr_6af4969501036.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794414229_rkr_6af4969501036.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794414229_rkr_6af4969501036.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আইপিএল নিলামে আবারও মোস্তাফিজ" /&gt;&lt;/p&gt;&lt;p&gt;গতবার আইপিএলে দল পেয়েও শেষ পর্যন্ত খেলা হয়নি মোস্তাফিজুর রহমানের। কলকাতা নাইট রাইডার্সের হয়ে ৯ কোটি ২০ লাখ রুপির চুক্তি হয়েছিল তার। কিন্তু মাঠে নামার আগেই বিসিসিআইয়ের নির্দেশে দল থেকে বাদ পড়তে হয় বাংলাদেশের এই পেসারকে। সেই অধ্যায়ের পর এবার আবারও আইপিএলে ফেরার সুযোগ তৈরি হয়েছে তার সামনে। আগামী মৌসুমে&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%87%E0%A6%AA%E0%A6%8F%E0%A6%B2-%E0%A6%A8%E0%A6%B2%E0%A6%AE-%E0%A6%86%E0%A6%AC%E0%A6%B0%E0%A6%93-%E0%A6%AE%E0%A6%B8%E0%A6%A4%E0%A6%AB%E0%A6%9C">Education Bangla</source>
    </item>
    <item>
      <title>বাংলাদেশ সিরিজের আগে ঐক্যের শক্তিতে আত্মবিশ্বাসী বাভুমা</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6-%E0%A6%B8%E0%A6%B0%E0%A6%9C%E0%A6%B0-%E0%A6%86%E0%A6%97-%E0%A6%90%E0%A6%95%E0%A6%AF%E0%A6%B0-%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%A4-%E0%A6%86%E0%A6%A4%E0%A6%AE%E0%A6%AC%E0%A6%B6%E0%A6%AC%E0%A6%B8-%E0%A6%AC%E0%A6%AD%E0%A6%AE</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6-%E0%A6%B8%E0%A6%B0%E0%A6%9C%E0%A6%B0-%E0%A6%86%E0%A6%97-%E0%A6%90%E0%A6%95%E0%A6%AF%E0%A6%B0-%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%A4-%E0%A6%86%E0%A6%A4%E0%A6%AE%E0%A6%AC%E0%A6%B6%E0%A6%AC%E0%A6%B8-%E0%A6%AC%E0%A6%AD%E0%A6%AE</guid>
      <pubDate>Wed, 11 Nov 2026 16:22:56 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794414176_rkr_6af49660391df.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794414176_rkr_6af49660391df.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794414176_rkr_6af49660391df.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাংলাদেশ সিরিজের আগে ঐক্যের শক্তিতে আত্মবিশ্বাসী বাভুমা" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশের বিপক্ষে টেস্ট সিরিজ শুরুর আগে দলীয় ঐক্য ও পারস্পরিক বোঝাপড়াকেই নিজেদের বড় শক্তি হিসেবে দেখছেন দক্ষিণ আফ্রিকার অধিনায়ক তেম্বা বাভুমা। তার মতে, কোচ শুকরি কনরাডের পরিকল্পনায় পুরো দল একাট্টা। প্রত্যেকেই দলের লক্ষ্যের সঙ্গে একমত এবং একে অপরের জন্য খেলতে প্রস্তুত।বিশ্ব টেস্ট চ্যাম্পিয়নশিপের বর্&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6-%E0%A6%B8%E0%A6%B0%E0%A6%9C%E0%A6%B0-%E0%A6%86%E0%A6%97-%E0%A6%90%E0%A6%95%E0%A6%AF%E0%A6%B0-%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%A4-%E0%A6%86%E0%A6%A4%E0%A6%AE%E0%A6%AC%E0%A6%B6%E0%A6%AC%E0%A6%B8-%E0%A6%AC%E0%A6%AD%E0%A6%AE">Education Bangla</source>
    </item>
    <item>
      <title>পেনাল্টি গোলে মালদ্বীপকে হারিয়ে সেমিফাইনালে ভারত</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AA%E0%A6%A8%E0%A6%B2%E0%A6%9F-%E0%A6%97%E0%A6%B2-%E0%A6%AE%E0%A6%B2%E0%A6%A6%E0%A6%AC%E0%A6%AA%E0%A6%95-%E0%A6%B9%E0%A6%B0%E0%A7%9F-%E0%A6%B8%E0%A6%AE%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2-%E0%A6%AD%E0%A6%B0%E0%A6%A4</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AA%E0%A6%A8%E0%A6%B2%E0%A6%9F-%E0%A6%97%E0%A6%B2-%E0%A6%AE%E0%A6%B2%E0%A6%A6%E0%A6%AC%E0%A6%AA%E0%A6%95-%E0%A6%B9%E0%A6%B0%E0%A7%9F-%E0%A6%B8%E0%A6%AE%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2-%E0%A6%AD%E0%A6%B0%E0%A6%A4</guid>
      <pubDate>Wed, 11 Nov 2026 16:21:34 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794414094_rkr_6af4960e5b3b2.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794414094_rkr_6af4960e5b3b2.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794414094_rkr_6af4960e5b3b2.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পেনাল্টি গোলে মালদ্বীপকে হারিয়ে সেমিফাইনালে ভারত" /&gt;&lt;/p&gt;&lt;p&gt;ঢাকার জাতীয় স্টেডিয়ামে মালদ্বীপকে ১-০ গোলে হারিয়ে সাফ চ্যাম্পিয়নশিপ ২০২৬-এর সেমিফাইনাল নিশ্চিত করেছে ভারত।পরের রাউন্ডে উঠতে ড্র হলেই চলত ভারতের। তবে প্রথমার্ধে সুহাইল ভাটের পেনাল্টি গোলে পূর্ণ তিন পয়েন্ট নিয়েই মাঠ ছেড়েছে দলটি। এর ফলে গ্রুপ ‘বি’-তে চ্যাম্পিয়ন হয়েই সেমিফাইনালে জায়গা করে নিলো ভা&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AA%E0%A6%A8%E0%A6%B2%E0%A6%9F-%E0%A6%97%E0%A6%B2-%E0%A6%AE%E0%A6%B2%E0%A6%A6%E0%A6%AC%E0%A6%AA%E0%A6%95-%E0%A6%B9%E0%A6%B0%E0%A7%9F-%E0%A6%B8%E0%A6%AE%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2-%E0%A6%AD%E0%A6%B0%E0%A6%A4">Education Bangla</source>
    </item>
    <item>
      <title>শ্রীলঙ্কার জালে এক হালি গোল, গ্রুপসেরা হয়ে সেমিতে বাংলাদেশ</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B6%E0%A6%B0%E0%A6%B2%E0%A6%99%E0%A6%95%E0%A6%B0-%E0%A6%9C%E0%A6%B2-%E0%A6%8F%E0%A6%95-%E0%A6%B9%E0%A6%B2-%E0%A6%97%E0%A6%B2-%E0%A6%97%E0%A6%B0%E0%A6%AA%E0%A6%B8%E0%A6%B0-%E0%A6%B9%E0%A7%9F-%E0%A6%B8%E0%A6%AE%E0%A6%A4-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%B6%E0%A6%B0%E0%A6%B2%E0%A6%99%E0%A6%95%E0%A6%B0-%E0%A6%9C%E0%A6%B2-%E0%A6%8F%E0%A6%95-%E0%A6%B9%E0%A6%B2-%E0%A6%97%E0%A6%B2-%E0%A6%97%E0%A6%B0%E0%A6%AA%E0%A6%B8%E0%A6%B0-%E0%A6%B9%E0%A7%9F-%E0%A6%B8%E0%A6%AE%E0%A6%A4-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6</guid>

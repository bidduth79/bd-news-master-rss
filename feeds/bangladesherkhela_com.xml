      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794499705_rkr_6af5e4797ba65.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794499705_rkr_6af5e4797ba65.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794499705_rkr_6af5e4797ba65.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ব্রাজিলে এন্দ্রিককে সুযোগ দিলে আনচেলত্তির প্রতি কৃতজ্ঞ থাকবেন মরিনহো" /&gt;&lt;/p&gt;&lt;p&gt;রিয়াল মাদ্রিদে নিয়মিত খেলার সুযোগ পাচ্ছেন না এন্দ্রিক। ব্রাজিলিয়ান এই তরুণ ফরোয়ার্ডের প্রত্যাশা, মাঠে আরও বেশি সময় কাটানো। তবে রিয়াল মাদ্রিদের কোচ হোসে মরিনহোর পক্ষে হয়তো তাকে সেই সুযোগ দেওয়া সম্ভব হচ্ছে না। তাই ব্রাজিল জাতীয় দলের কোচ কার্লো আনচেলত্তি আসন্ন আন্তর্জাতিক বিরতিতে এন্দ্রিককে বেশি খেলালে&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%B0%E0%A6%9C%E0%A6%B2-%E0%A6%8F%E0%A6%A8%E0%A6%A6%E0%A6%B0%E0%A6%95%E0%A6%95-%E0%A6%B8%E0%A6%AF%E0%A6%97-%E0%A6%A6%E0%A6%B2-%E0%A6%86%E0%A6%A8%E0%A6%9A%E0%A6%B2%E0%A6%A4%E0%A6%A4%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%A4-%E0%A6%95%E0%A6%A4%E0%A6%9C%E0%A6%9E-%E0%A6%A5%E0%A6%95%E0%A6%AC%E0%A6%A8-%E0%A6%AE%E0%A6%B0%E0%A6%A8%E0%A6%B9">Education Bangla</source>
    </item>
    <item>
      <title>অভিষেকেই সাকিবের সাত উইকেট, পাকিস্তানের দাপুটে দিন</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%85%E0%A6%AD%E0%A6%B7%E0%A6%95%E0%A6%87-%E0%A6%B8%E0%A6%95%E0%A6%AC%E0%A6%B0-%E0%A6%B8%E0%A6%A4-%E0%A6%89%E0%A6%87%E0%A6%95%E0%A6%9F-%E0%A6%AA%E0%A6%95%E0%A6%B8%E0%A6%A4%E0%A6%A8%E0%A6%B0-%E0%A6%A6%E0%A6%AA%E0%A6%9F-%E0%A6%A6%E0%A6%A8</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%85%E0%A6%AD%E0%A6%B7%E0%A6%95%E0%A6%87-%E0%A6%B8%E0%A6%95%E0%A6%AC%E0%A6%B0-%E0%A6%B8%E0%A6%A4-%E0%A6%89%E0%A6%87%E0%A6%95%E0%A6%9F-%E0%A6%AA%E0%A6%95%E0%A6%B8%E0%A6%A4%E0%A6%A8%E0%A6%B0-%E0%A6%A6%E0%A6%AA%E0%A6%9F-%E0%A6%A6%E0%A6%A8</guid>

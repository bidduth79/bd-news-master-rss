    <item>
      <title>মেসি-রোনালদোকে ছাড়িয়ে ইতিহাস গড়লেন হালান্ড</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%B8-%E0%A6%B0%E0%A6%A8%E0%A6%B2%E0%A6%A6%E0%A6%95-%E0%A6%9B%E0%A7%9C%E0%A7%9F-%E0%A6%87%E0%A6%A4%E0%A6%B9%E0%A6%B8-%E0%A6%97%E0%A7%9C%E0%A6%B2%E0%A6%A8-%E0%A6%B9%E0%A6%B2%E0%A6%A8%E0%A6%A1</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%B8-%E0%A6%B0%E0%A6%A8%E0%A6%B2%E0%A6%A6%E0%A6%95-%E0%A6%9B%E0%A7%9C%E0%A7%9F-%E0%A6%87%E0%A6%A4%E0%A6%B9%E0%A6%B8-%E0%A6%97%E0%A7%9C%E0%A6%B2%E0%A6%A8-%E0%A6%B9%E0%A6%B2%E0%A6%A8%E0%A6%A1</guid>
      <pubDate>Sun, 15 Nov 2026 10:42:34 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794739354_rkr_6af98c9ad14c3.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794739354_rkr_6af98c9ad14c3.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794739354_rkr_6af98c9ad14c3.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মেসি-রোনালদোকে ছাড়িয়ে ইতিহাস গড়লেন হালান্ড" /&gt;&lt;/p&gt;&lt;p&gt;ফুটবল ইতিহাসে রেকর্ডের প্রসঙ্গ এলেই সবার আগে আলোচনায় আসেন লিওনেল মেসি ও ক্রিশ্চিয়ানো রোনালদো। দীর্ঘদিন ধরে গোল ও ব্যক্তিগত অর্জনের অসংখ্য রেকর্ড নিজেদের করে রেখেছেন এই দুই মহাতারকা। তবে এবার এমন এক অনন্য কীর্তি গড়েছেন নরওয়ের স্ট্রাইকার আর্লিং হালান্ড, যা নেই মেসি কিংবা রোনালদোর ক্যারিয়ারেও।শুধু তাই.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AE%E0%A6%B8-%E0%A6%B0%E0%A6%A8%E0%A6%B2%E0%A6%A6%E0%A6%95-%E0%A6%9B%E0%A7%9C%E0%A7%9F-%E0%A6%87%E0%A6%A4%E0%A6%B9%E0%A6%B8-%E0%A6%97%E0%A7%9C%E0%A6%B2%E0%A6%A8-%E0%A6%B9%E0%A6%B2%E0%A6%A8%E0%A6%A1">Education Bangla</source>
    </item>
    <item>
      <title>রোনালদোহীন পর্তুগালের ভয়াবহ বিপর্যয়ের পর মুখ খুললেন ব্রুনো ফের্নান্দেজ</title>

    <item>
      <title>বিনা প্রতিদ্বন্দ্বিতায় ফের আর্চারি ফেডারেশনের সভাপতি হচ্ছেন চপল</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%A8-%E0%A6%AA%E0%A6%B0%E0%A6%A4%E0%A6%A6%E0%A6%AC%E0%A6%A8%E0%A6%A6%E0%A6%AC%E0%A6%A4%E0%A7%9F-%E0%A6%AB%E0%A6%B0-%E0%A6%86%E0%A6%B0%E0%A6%9A%E0%A6%B0-%E0%A6%AB%E0%A6%A1%E0%A6%B0%E0%A6%B6%E0%A6%A8%E0%A6%B0-%E0%A6%B8%E0%A6%AD%E0%A6%AA%E0%A6%A4-%E0%A6%B9%E0%A6%9A%E0%A6%9B%E0%A6%A8-%E0%A6%9A%E0%A6%AA%E0%A6%B2</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%A8-%E0%A6%AA%E0%A6%B0%E0%A6%A4%E0%A6%A6%E0%A6%AC%E0%A6%A8%E0%A6%A6%E0%A6%AC%E0%A6%A4%E0%A7%9F-%E0%A6%AB%E0%A6%B0-%E0%A6%86%E0%A6%B0%E0%A6%9A%E0%A6%B0-%E0%A6%AB%E0%A6%A1%E0%A6%B0%E0%A6%B6%E0%A6%A8%E0%A6%B0-%E0%A6%B8%E0%A6%AD%E0%A6%AA%E0%A6%A4-%E0%A6%B9%E0%A6%9A%E0%A6%9B%E0%A6%A8-%E0%A6%9A%E0%A6%AA%E0%A6%B2</guid>
      <pubDate>Sun, 22 Nov 2026 16:25:38 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795364738_rkr_6b031782bac25.png" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795364738_rkr_6b031782bac25.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795364738_rkr_6b031782bac25.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিনা প্রতিদ্বন্দ্বিতায় ফের আর্চারি ফেডারেশনের সভাপতি হচ্ছেন চপল" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ আর্চারি ফেডারেশনের আসন্ন নির্বাচনে সভাপতি পদে বিনা প্রতিদ্বন্দ্বিতায় পুনর্নির্বাচিত হতে যাচ্ছেন বর্তমান সভাপতি কাজী রাজীব উদ্দীন আহমেদ চপল। জাতীয় ক্রীড়া পরিষদে রিটার্নিং কর্মকর্তার কার্যালয়ে মনোনয়নপত্র জমা দেওয়ার শেষ দিনে এই পদে আর কেউ মনোনয়নপত্র জমা দেননি।ফলে একক প্রার্থী হিসেবে তার নির্বা&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%A8-%E0%A6%AA%E0%A6%B0%E0%A6%A4%E0%A6%A6%E0%A6%AC%E0%A6%A8%E0%A6%A6%E0%A6%AC%E0%A6%A4%E0%A7%9F-%E0%A6%AB%E0%A6%B0-%E0%A6%86%E0%A6%B0%E0%A6%9A%E0%A6%B0-%E0%A6%AB%E0%A6%A1%E0%A6%B0%E0%A6%B6%E0%A6%A8%E0%A6%B0-%E0%A6%B8%E0%A6%AD%E0%A6%AA%E0%A6%A4-%E0%A6%B9%E0%A6%9A%E0%A6%9B%E0%A6%A8-%E0%A6%9A%E0%A6%AA%E0%A6%B2">Education Bangla</source>
    </item>
    <item>
      <title>সিমন্সের ভবিষ্যৎ নিয়ে এখনই কিছু বলতে চান না তামিম</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%AE%E0%A6%A8%E0%A6%B8%E0%A6%B0-%E0%A6%AD%E0%A6%AC%E0%A6%B7%E0%A6%AF%E0%A7%8E-%E0%A6%A8%E0%A7%9F-%E0%A6%8F%E0%A6%96%E0%A6%A8%E0%A6%87-%E0%A6%95%E0%A6%9B-%E0%A6%AC%E0%A6%B2%E0%A6%A4-%E0%A6%9A%E0%A6%A8-%E0%A6%A8-%E0%A6%A4%E0%A6%AE%E0%A6%AE</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%AE%E0%A6%A8%E0%A6%B8%E0%A6%B0-%E0%A6%AD%E0%A6%AC%E0%A6%B7%E0%A6%AF%E0%A7%8E-%E0%A6%A8%E0%A7%9F-%E0%A6%8F%E0%A6%96%E0%A6%A8%E0%A6%87-%E0%A6%95%E0%A6%9B-%E0%A6%AC%E0%A6%B2%E0%A6%A4-%E0%A6%9A%E0%A6%A8-%E0%A6%A8-%E0%A6%A4%E0%A6%AE%E0%A6%AE</guid>
      <pubDate>Sun, 22 Nov 2026 16:24:39 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_media/1795364670_6b03173e6a673.png" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_media/1795364670_6b03173e6a673.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_media/1795364670_6b03173e6a673.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সিমন্সের ভবিষ্যৎ নিয়ে এখনই কিছু বলতে চান না তামিম" /&gt;&lt;/p&gt;&lt;p&gt;জাতীয় দলের সাম্প্রতিক ব্যর্থতায় প্রশ্নের মুখে পড়েছে প্রধান কোচ ফিল সিমন্সের পারফরম্যান্স ও ভবিষ্যৎ। তিন সংস্করণ মিলিয়ে বাংলাদেশের টানা নয় ম্যাচের পরাজয়ের পর তার কোচিং নিয়ে আলোচনা জোরালো হয়েছে।এ অবস্থায় সিমন্সের পারফরম্যান্স মূল্যায়ন ও বিসিবির সঙ্গে তার চুক্তির ভবিষ্যৎ জানতে চাওয়া হয়েছিল সভাপতি তামিম&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%AE%E0%A6%A8%E0%A6%B8%E0%A6%B0-%E0%A6%AD%E0%A6%AC%E0%A6%B7%E0%A6%AF%E0%A7%8E-%E0%A6%A8%E0%A7%9F-%E0%A6%8F%E0%A6%96%E0%A6%A8%E0%A6%87-%E0%A6%95%E0%A6%9B-%E0%A6%AC%E0%A6%B2%E0%A6%A4-%E0%A6%9A%E0%A6%A8-%E0%A6%A8-%E0%A6%A4%E0%A6%AE%E0%A6%AE">Education Bangla</source>
    </item>
    <item>
      <title>ভিসা না মেলায় এশিয়ান নারী হ্যান্ডবল চ্যাম্পিয়নশিপে খেলা হচ্ছে না বাংলাদেশের</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AD%E0%A6%B8-%E0%A6%A8-%E0%A6%AE%E0%A6%B2%E0%A7%9F-%E0%A6%8F%E0%A6%B6%E0%A7%9F%E0%A6%A8-%E0%A6%A8%E0%A6%B0-%E0%A6%B9%E0%A6%AF%E0%A6%A8%E0%A6%A1%E0%A6%AC%E0%A6%B2-%E0%A6%9A%E0%A6%AF%E0%A6%AE%E0%A6%AA%E0%A7%9F%E0%A6%A8%E0%A6%B6%E0%A6%AA-%E0%A6%96%E0%A6%B2-%E0%A6%B9%E0%A6%9A%E0%A6%9B-%E0%A6%A8-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AD%E0%A6%B8-%E0%A6%A8-%E0%A6%AE%E0%A6%B2%E0%A7%9F-%E0%A6%8F%E0%A6%B6%E0%A7%9F%E0%A6%A8-%E0%A6%A8%E0%A6%B0-%E0%A6%B9%E0%A6%AF%E0%A6%A8%E0%A6%A1%E0%A6%AC%E0%A6%B2-%E0%A6%9A%E0%A6%AF%E0%A6%AE%E0%A6%AA%E0%A7%9F%E0%A6%A8%E0%A6%B6%E0%A6%AA-%E0%A6%96%E0%A6%B2-%E0%A6%B9%E0%A6%9A%E0%A6%9B-%E0%A6%A8-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6%E0%A6%B0</guid>
      <pubDate>Sun, 22 Nov 2026 16:23:28 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795364608_rkr_6b031700d6402.png" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795364608_rkr_6b031700d6402.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795364608_rkr_6b031700d6402.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভিসা না মেলায় এশিয়ান নারী হ্যান্ডবল চ্যাম্পিয়নশিপে খেলা হচ্ছে না বাংলাদেশের" /&gt;&lt;/p&gt;&lt;p&gt;সব প্রস্তুতি সম্পন্ন থাকলেও শেষ মুহূর্তের ভিসা জটিলতায় ভেস্তে গেল বাংলাদেশ জাতীয় নারী হ্যান্ডবল দলের এশিয়ান চ্যাম্পিয়নশিপ যাত্রা। কাজাখস্তানের আলমাতিতে অনুষ্ঠেয় ২১তম এশিয়ান নারী হ্যান্ডবল চ্যাম্পিয়নশিপে অংশ নিতে দেশটির ভিসা পায়নি বাংলাদেশ দল।এদিকে, টুর্নামেন্টে খেলোয়াড়দের তালিকা ও প্রয়োজনীয় কাগজপত্র&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AD%E0%A6%B8-%E0%A6%A8-%E0%A6%AE%E0%A6%B2%E0%A7%9F-%E0%A6%8F%E0%A6%B6%E0%A7%9F%E0%A6%A8-%E0%A6%A8%E0%A6%B0-%E0%A6%B9%E0%A6%AF%E0%A6%A8%E0%A6%A1%E0%A6%AC%E0%A6%B2-%E0%A6%9A%E0%A6%AF%E0%A6%AE%E0%A6%AA%E0%A7%9F%E0%A6%A8%E0%A6%B6%E0%A6%AA-%E0%A6%96%E0%A6%B2-%E0%A6%B9%E0%A6%9A%E0%A6%9B-%E0%A6%A8-%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6%E0%A6%B0">Education Bangla</source>
    </item>
    <item>
      <title>হাসিমুখে বাংলায় সালাম, মাঠেই জবাব দিতে চান মারে</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B9%E0%A6%B8%E0%A6%AE%E0%A6%96-%E0%A6%AC%E0%A6%B2%E0%A7%9F-%E0%A6%B8%E0%A6%B2%E0%A6%AE-%E0%A6%AE%E0%A6%A0%E0%A6%87-%E0%A6%9C%E0%A6%AC%E0%A6%AC-%E0%A6%A6%E0%A6%A4-%E0%A6%9A%E0%A6%A8-%E0%A6%AE%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%B9%E0%A6%B8%E0%A6%AE%E0%A6%96-%E0%A6%AC%E0%A6%B2%E0%A7%9F-%E0%A6%B8%E0%A6%B2%E0%A6%AE-%E0%A6%AE%E0%A6%A0%E0%A6%87-%E0%A6%9C%E0%A6%AC%E0%A6%AC-%E0%A6%A6%E0%A6%A4-%E0%A6%9A%E0%A6%A8-%E0%A6%AE%E0%A6%B0</guid>
      <pubDate>Sun, 22 Nov 2026 16:22:25 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795364545_rkr_6b0316c1eb252.png" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795364545_rkr_6b0316c1eb252.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795364545_rkr_6b0316c1eb252.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হাসিমুখে বাংলায় সালাম, মাঠেই জবাব দিতে চান মারে" /&gt;&lt;/p&gt;&lt;p&gt;বিকেলের রোদ তখন পশ্চিম আকাশে ঢলে পড়ছে। জাতীয় স্টেডিয়ামের সবুজ ঘাসে ঘাম ঝরাচ্ছেন ঋতুপর্ণা চাকমা, রূপনা চাকমারা।সিঙ্গাপুরের বিপক্ষে আসন্ন দুটি আন্তর্জাতিক প্রীতি ম্যাচকে সামনে রেখে শুরু হয়েছে প্রস্তুতির নতুন অধ্যায়। এতদিন চট্টগ্রামের কোরিয়ান ইপিজেডে (কেইপিজেড) ক্যাম্প শেষে ঢাকায় ফিরেছে নারী ফুটবল দল।র&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B9%E0%A6%B8%E0%A6%AE%E0%A6%96-%E0%A6%AC%E0%A6%B2%E0%A7%9F-%E0%A6%B8%E0%A6%B2%E0%A6%AE-%E0%A6%AE%E0%A6%A0%E0%A6%87-%E0%A6%9C%E0%A6%AC%E0%A6%AC-%E0%A6%A6%E0%A6%A4-%E0%A6%9A%E0%A6%A8-%E0%A6%AE%E0%A6%B0">Education Bangla</source>
    </item>
    <item>
      <title>ক্রীড়াবিদদের এক লাখ টাকা ভাতা দিচ্ছে সরকার</title>

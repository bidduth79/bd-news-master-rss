      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795416756_rkr_6b03e2b44636a.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পচেত্তিনোর অভিষেকেই লিভারপুলের কাছে বিধ্বস্ত ম্যানচেস্টার ইউনাইটেড" /&gt;&lt;/p&gt;&lt;p&gt;ম্যানচেস্টার ইউনাইটেডের কোচ হিসেবে মরিসিও পচেত্তিনোর শুরুটা হলো দুঃস্বপ্নের মতো। চিরপ্রতিদ্বন্দ্বী লিভারপুলের মাঠ অ্যানফিল্ডে ১০ জনের ইউনাইটেডকে ৪-০ গোলে উড়িয়ে দিয়েছে স্বাগতিকরা। ম্যাচের মাত্র আট মিনিটে লেনি ইয়োরোর লাল কার্ডে বড় ধাক্কা খায় ইউনাইটেড। এরপর মাত্র ১৩ মিনিটের মধ্যেই দুই গোল করে ম্যাচের ন&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AA%E0%A6%9A%E0%A6%A4%E0%A6%A4%E0%A6%A8%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%B7%E0%A6%95%E0%A6%87-%E0%A6%B2%E0%A6%AD%E0%A6%B0%E0%A6%AA%E0%A6%B2%E0%A6%B0-%E0%A6%95%E0%A6%9B-%E0%A6%AC%E0%A6%A7%E0%A6%AC%E0%A6%B8%E0%A6%A4-%E0%A6%AE%E0%A6%AF%E0%A6%A8%E0%A6%9A%E0%A6%B8%E0%A6%9F%E0%A6%B0-%E0%A6%87%E0%A6%89%E0%A6%A8%E0%A6%87%E0%A6%9F%E0%A6%A1">Education Bangla</source>

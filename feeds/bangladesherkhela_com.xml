      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%85%E0%A6%AC%E0%A6%B6%E0%A6%B7-%E0%A6%AC%E0%A6%B0%E0%A6%96%E0%A6%B8%E0%A6%A4-%E0%A6%B9%E0%A6%B2%E0%A6%A8-%E0%A6%AE%E0%A6%AF%E0%A6%A8%E0%A6%9A%E0%A6%B8%E0%A6%9F%E0%A6%B0-%E0%A6%87%E0%A6%89%E0%A6%A8%E0%A6%87%E0%A6%9F%E0%A6%A1-%E0%A6%95%E0%A6%9A-%E0%A6%AE%E0%A6%87%E0%A6%95%E0%A6%B2-%E0%A6%95%E0%A6%AF%E0%A6%B0%E0%A6%95</guid>
      <pubDate>Thu, 12 Nov 2026 16:01:21 +0000</pubDate>

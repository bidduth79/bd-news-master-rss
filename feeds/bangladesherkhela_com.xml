    <item>
      <title>বাংলাদেশের ষষ্ঠ স্থান অর্জন</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6%E0%A6%B0-%E0%A6%B7%E0%A6%B7%E0%A6%A0-%E0%A6%B8%E0%A6%A5%E0%A6%A8-%E0%A6%85%E0%A6%B0%E0%A6%9C%E0%A6%A8</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6%E0%A6%B0-%E0%A6%B7%E0%A6%B7%E0%A6%A0-%E0%A6%B8%E0%A6%A5%E0%A6%A8-%E0%A6%85%E0%A6%B0%E0%A6%9C%E0%A6%A8</guid>
      <pubDate>Sat, 14 Nov 2026 15:10:23 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794669023_rkr_6af879df6da3f.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794669023_rkr_6af879df6da3f.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794669023_rkr_6af879df6da3f.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাংলাদেশের ষষ্ঠ স্থান অর্জন" /&gt;&lt;/p&gt;&lt;p&gt;ভিয়েতনামের ফান থিয়েতে অনুষ্ঠিত ‘ডেভিস কাপ ২০২৬ এশিয়া/ওশেনিয়া গ্রুপ-৫’ টেনিস প্রতিযোগিতায় ১৪ দেশের মধ্যে ষষ্ঠ স্থান অর্জন করেছে বাংলাদেশ।গত বছর এই প্রতিযোগিতায় বাংলাদেশ ১২তম হয়েছিল। এবারের লক্ষ্য ছিল গতবারের চেয়ে ভালো ফলাফল করা। সেই লক্ষ্য পূরণে বাংলাদেশ দল সফল হয়েছে।আজ শনিবার পঞ্চম ও ষষ্ঠ স্থান নির্&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AC%E0%A6%B2%E0%A6%A6%E0%A6%B6%E0%A6%B0-%E0%A6%B7%E0%A6%B7%E0%A6%A0-%E0%A6%B8%E0%A6%A5%E0%A6%A8-%E0%A6%85%E0%A6%B0%E0%A6%9C%E0%A6%A8">Education Bangla</source>
    </item>
    <item>
      <title>২২তম জাতীয় দূরপাল্লা সাঁতার প্রতিযোগিতা সোমবার</title>
      <link>https://bangladesherkhela.com/news/%E0%A7%A8%E0%A7%A8%E0%A6%A4%E0%A6%AE-%E0%A6%9C%E0%A6%A4%E0%A7%9F-%E0%A6%A6%E0%A6%B0%E0%A6%AA%E0%A6%B2%E0%A6%B2-%E0%A6%B8%E0%A6%A4%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%A4%E0%A6%AF%E0%A6%97%E0%A6%A4-%E0%A6%B8%E0%A6%AE%E0%A6%AC%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A7%A8%E0%A7%A8%E0%A6%A4%E0%A6%AE-%E0%A6%9C%E0%A6%A4%E0%A7%9F-%E0%A6%A6%E0%A6%B0%E0%A6%AA%E0%A6%B2%E0%A6%B2-%E0%A6%B8%E0%A6%A4%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%A4%E0%A6%AF%E0%A6%97%E0%A6%A4-%E0%A6%B8%E0%A6%AE%E0%A6%AC%E0%A6%B0</guid>
      <pubDate>Sat, 14 Nov 2026 15:08:54 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794668934_rkr_6af87986a677f.png" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794668934_rkr_6af87986a677f.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794668934_rkr_6af87986a677f.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="২২তম জাতীয় দূরপাল্লা সাঁতার প্রতিযোগিতা সোমবার" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ সুইমিং ফেডারেশনের ব্যবস্থাপনায় এবং বাংলাদেশ নৌবাহিনীর পৃষ্ঠপোষকতায় ‘২২তম জাতীয় দূরপাল্লা সাঁতার প্রতিযোগিতা-২০২৬’ আগামী সোমবার রাঙ্গামাটির কাপ্তাই লেকে অনুষ্ঠিত হবে।এবারের প্রতিযোগিতায় ১০ জন পুরুষ ও ১০ জন মহিলা সাঁতারু অংশগ্রহণ করছে। পুরুষ বিভাগে ১০ কিলোমিটার এবং মহিলা বিভাগে ৮ কিলোমিটার সা&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A7%A8%E0%A7%A8%E0%A6%A4%E0%A6%AE-%E0%A6%9C%E0%A6%A4%E0%A7%9F-%E0%A6%A6%E0%A6%B0%E0%A6%AA%E0%A6%B2%E0%A6%B2-%E0%A6%B8%E0%A6%A4%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%A4%E0%A6%AF%E0%A6%97%E0%A6%A4-%E0%A6%B8%E0%A6%AE%E0%A6%AC%E0%A6%B0">Education Bangla</source>
    </item>
    <item>
      <title>শ্বাসরুদ্ধকর ফাইনালে পাকিস্তানকে হারালো ভারত</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B6%E0%A6%AC%E0%A6%B8%E0%A6%B0%E0%A6%A6%E0%A6%A7%E0%A6%95%E0%A6%B0-%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2-%E0%A6%AA%E0%A6%95%E0%A6%B8%E0%A6%A4%E0%A6%A8%E0%A6%95-%E0%A6%B9%E0%A6%B0%E0%A6%B2-%E0%A6%AD%E0%A6%B0%E0%A6%A4</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%B6%E0%A6%AC%E0%A6%B8%E0%A6%B0%E0%A6%A6%E0%A6%A7%E0%A6%95%E0%A6%B0-%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2-%E0%A6%AA%E0%A6%95%E0%A6%B8%E0%A6%A4%E0%A6%A8%E0%A6%95-%E0%A6%B9%E0%A6%B0%E0%A6%B2-%E0%A6%AD%E0%A6%B0%E0%A6%A4</guid>
      <pubDate>Sat, 14 Nov 2026 14:42:30 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794667350_rkr_6af8735651dac.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794667350_rkr_6af8735651dac.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794667350_rkr_6af8735651dac.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শ্বাসরুদ্ধকর ফাইনালে পাকিস্তানকে হারালো ভারত" /&gt;&lt;/p&gt;&lt;p&gt;ইনিংসের একেবারে শেষ বলে চার হাঁকিয়ে অবিশ্বাস্য এক জয় তুলে নিল ভারত। ওমানের আল আমেরাত ক্রিকেট গ্রাউন্ডে অনুষ্ঠিত অনূর্ধ্ব-১৯ এশিয়া কাপের শ্বাসরুদ্ধকর ফাইনালে পাকিস্তানকে ১ উইকেটে হারিয়ে নবমবারের মতো শিরোপা জিতল ভারতীয় যুবারা। পাকিস্তানের ছুড়ে দেওয়া ৩৩৮ রানের বিশাল লক্ষ্য তাড়া করতে নেমে নির্ধারিত ৫০ ও&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B6%E0%A6%AC%E0%A6%B8%E0%A6%B0%E0%A6%A6%E0%A6%A7%E0%A6%95%E0%A6%B0-%E0%A6%AB%E0%A6%87%E0%A6%A8%E0%A6%B2-%E0%A6%AA%E0%A6%95%E0%A6%B8%E0%A6%A4%E0%A6%A8%E0%A6%95-%E0%A6%B9%E0%A6%B0%E0%A6%B2-%E0%A6%AD%E0%A6%B0%E0%A6%A4">Education Bangla</source>
    </item>
    <item>
      <title>স্টেডিয়ামে লাল-সবুজের জার্সি-পতাকায় উৎসব</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%9F%E0%A6%A1%E0%A6%AF%E0%A6%AE-%E0%A6%B2%E0%A6%B2-%E0%A6%B8%E0%A6%AC%E0%A6%9C%E0%A6%B0-%E0%A6%9C%E0%A6%B0%E0%A6%B8-%E0%A6%AA%E0%A6%A4%E0%A6%95%E0%A6%AF-%E0%A6%89%E0%A7%8E%E0%A6%B8%E0%A6%AC</link>

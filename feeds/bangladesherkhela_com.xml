      <enclosure url="https://bangladesherkhela.com/uploads/rkr_media/1794150377_6af08fe99d7ed.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_media/1794150377_6af08fe99d7ed.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_media/1794150377_6af08fe99d7ed.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শিক্ষার্থীদের স্বাধীনতার সঠিক ইতিহাস জানাতে হবে : ক্রীড়া প্রতিমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশের স্বাধীনতা, মুক্তিযুদ্ধ ও রাজনৈতিক ইতিহাস সম্পর্কে শিক্ষার্থীদের সঠিক তথ্য জানানো জরুরি বলে মন্তব্য করেছেন যুব ও ক্রীড়া প্রতিমন্ত্রী আমিনুল হক। তিনি বলেছেন, ‘আমরা চাই, বাংলাদেশের মহান মুক্তিযুদ্ধের আগের ও পরের সব ইতিহাস সম্পর্কে শিক্ষার্থীরা সঠিক তথ্য জানুক। অতীতে দীর্ঘ ১৭ বছর ইতিহাসকে ধাম&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B6%E0%A6%95%E0%A6%B7%E0%A6%B0%E0%A6%A5%E0%A6%A6%E0%A6%B0-%E0%A6%B8%E0%A6%AC%E0%A6%A7%E0%A6%A8%E0%A6%A4%E0%A6%B0-%E0%A6%B8%E0%A6%A0%E0%A6%95-%E0%A6%87%E0%A6%A4%E0%A6%B9%E0%A6%B8-%E0%A6%9C%E0%A6%A8%E0%A6%A4-%E0%A6%B9%E0%A6%AC-%E0%A6%95%E0%A6%B0%E0%A7%9C-%E0%A6%AA%E0%A6%B0%E0%A6%A4%E0%A6%AE%E0%A6%A8%E0%A6%A4%E0%A6%B0">Education Bangla</source>
    </item>
    <item>
      <title>শ্রীলঙ্কার বিপক্ষে লড়াইয়ে প্রস্তুত নতুন পাকিস্তান</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B6%E0%A6%B0%E0%A6%B2%E0%A6%99%E0%A6%95%E0%A6%B0-%E0%A6%AC%E0%A6%AA%E0%A6%95%E0%A6%B7-%E0%A6%B2%E0%A7%9C%E0%A6%87%E0%A7%9F-%E0%A6%AA%E0%A6%B0%E0%A6%B8%E0%A6%A4%E0%A6%A4-%E0%A6%A8%E0%A6%A4%E0%A6%A8-%E0%A6%AA%E0%A6%95%E0%A6%B8%E0%A6%A4%E0%A6%A8</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%B6%E0%A6%B0%E0%A6%B2%E0%A6%99%E0%A6%95%E0%A6%B0-%E0%A6%AC%E0%A6%AA%E0%A6%95%E0%A6%B7-%E0%A6%B2%E0%A7%9C%E0%A6%87%E0%A7%9F-%E0%A6%AA%E0%A6%B0%E0%A6%B8%E0%A6%A4%E0%A6%A4-%E0%A6%A8%E0%A6%A4%E0%A6%A8-%E0%A6%AA%E0%A6%95%E0%A6%B8%E0%A6%A4%E0%A6%A8</guid>
      <pubDate>Sun, 08 Nov 2026 15:05:27 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794150327_rkr_6af08fb719c97.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794150327_rkr_6af08fb719c97.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794150327_rkr_6af08fb719c97.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শ্রীলঙ্কার বিপক্ষে লড়াইয়ে প্রস্তুত নতুন পাকিস্তান" /&gt;&lt;/p&gt;&lt;p&gt;ইংল্যান্ডে হতাশাজনক সিরিজের পর শ্রীলঙ্কার বিপক্ষে সোমবার রাওয়ালপিন্ডিতে শুরু হতে যাওয়া প্রথম টেস্ট দিয়ে পাকিস্তান নতুন করে ঘুরে দাঁড়াবে বলে আশা করছেন অধিনায়ক বাবর আজম।ইংল্যান্ডের মাটিতে ৩-০ ব্যবধানে হোয়াইটওয়াশ হওয়ার পর নতুনভাবে সাজানো পাকিস্তানের এটাই প্রথম সিরিজ। ওই সিরিজে দ্বিতীয় টেস্টের পর সাতজন.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B6%E0%A6%B0%E0%A6%B2%E0%A6%99%E0%A6%95%E0%A6%B0-%E0%A6%AC%E0%A6%AA%E0%A6%95%E0%A6%B7-%E0%A6%B2%E0%A7%9C%E0%A6%87%E0%A7%9F-%E0%A6%AA%E0%A6%B0%E0%A6%B8%E0%A6%A4%E0%A6%A4-%E0%A6%A8%E0%A6%A4%E0%A6%A8-%E0%A6%AA%E0%A6%95%E0%A6%B8%E0%A6%A4%E0%A6%A8">Education Bangla</source>
    </item>
    <item>
      <title>প্রিমিয়ার লিগে উন্নীত ঢাকা ইউনাইটেড</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%AA%E0%A6%B0%E0%A6%AE%E0%A7%9F%E0%A6%B0-%E0%A6%B2%E0%A6%97-%E0%A6%89%E0%A6%A8%E0%A6%A8%E0%A6%A4-%E0%A6%A2%E0%A6%95-%E0%A6%87%E0%A6%89%E0%A6%A8%E0%A6%87%E0%A6%9F%E0%A6%A1</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%AA%E0%A6%B0%E0%A6%AE%E0%A7%9F%E0%A6%B0-%E0%A6%B2%E0%A6%97-%E0%A6%89%E0%A6%A8%E0%A6%A8%E0%A6%A4-%E0%A6%A2%E0%A6%95-%E0%A6%87%E0%A6%89%E0%A6%A8%E0%A6%87%E0%A6%9F%E0%A6%A1</guid>
      <pubDate>Sun, 08 Nov 2026 15:04:31 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794150271_rkr_6af08f7fa6b9e.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794150271_rkr_6af08f7fa6b9e.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794150271_rkr_6af08f7fa6b9e.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রিমিয়ার লিগে উন্নীত ঢাকা ইউনাইটেড" /&gt;&lt;/p&gt;&lt;p&gt;প্রথম বিভাগ হকি লিগে চ্যাম্পিয়ন হয়ে আগামী মৌসুমে প্রিমিয়ার লিগে খেলার যোগ্যতা অর্জন করেছে ঢাকা ইউনাইটেড।আজ মওলানা ভাষানী হকি স্টেডিয়ামে শেষ হয়েছে প্রথম বিভাগ লিগ। এবারের লিগে পুরো টুর্নামেন্টজুড়ে দুর্দান্ত পারফরম্যান্স দেখিয়ে চ্যাম্পিয়ন হওয়ার গৌরব অর্জন করেছে ঢাকা ইউনাইটেড। তারা মোট ১০ ম্যাচ খেলে সর&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%AA%E0%A6%B0%E0%A6%AE%E0%A7%9F%E0%A6%B0-%E0%A6%B2%E0%A6%97-%E0%A6%89%E0%A6%A8%E0%A6%A8%E0%A6%A4-%E0%A6%A2%E0%A6%95-%E0%A6%87%E0%A6%89%E0%A6%A8%E0%A6%87%E0%A6%9F%E0%A6%A1">Education Bangla</source>
    </item>
    <item>
      <title>ইতিহাস গড়ে বিশ্বকাপের শিরোপা জিতল নাইজেরিয়া</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%87%E0%A6%A4%E0%A6%B9%E0%A6%B8-%E0%A6%97%E0%A7%9C-%E0%A6%AC%E0%A6%B6%E0%A6%AC%E0%A6%95%E0%A6%AA%E0%A6%B0-%E0%A6%B6%E0%A6%B0%E0%A6%AA-%E0%A6%9C%E0%A6%A4%E0%A6%B2-%E0%A6%A8%E0%A6%87%E0%A6%9C%E0%A6%B0%E0%A7%9F</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%87%E0%A6%A4%E0%A6%B9%E0%A6%B8-%E0%A6%97%E0%A7%9C-%E0%A6%AC%E0%A6%B6%E0%A6%AC%E0%A6%95%E0%A6%AA%E0%A6%B0-%E0%A6%B6%E0%A6%B0%E0%A6%AA-%E0%A6%9C%E0%A6%A4%E0%A6%B2-%E0%A6%A8%E0%A6%87%E0%A6%9C%E0%A6%B0%E0%A7%9F</guid>
      <pubDate>Sun, 08 Nov 2026 14:25:10 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794147910_rkr_6af08646dc7a7.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794147910_rkr_6af08646dc7a7.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794147910_rkr_6af08646dc7a7.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইতিহাস গড়ে বিশ্বকাপের শিরোপা জিতল নাইজেরিয়া" /&gt;&lt;/p&gt;&lt;p&gt;বিশ্ব ফুটবলে নতুন ইতিহাস গড়েছে নাইজেরিয়া। ফিফার যেকোনো টুর্নামেন্টে প্রথম আফ্রিকান দেশ হিসেবে শিরোপা জয়ের গৌরব অর্জন করেছে তারা। মরক্কোর রাবাতে অবস্থিত মোহাম্মদ ষষ্ঠ ফুটবল কমপ্লেক্সে ফিফা অনূর্ধ্ব-১৭ নারী বিশ্বকাপের ফাইনালে জাপানকে ২–১ গোলে হারিয়ে এই অবিস্মরণীয় সাফল্য অর্জন করে ‘ফ্লেমিঙ্গোস’ খ্যাত.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%87%E0%A6%A4%E0%A6%B9%E0%A6%B8-%E0%A6%97%E0%A7%9C-%E0%A6%AC%E0%A6%B6%E0%A6%AC%E0%A6%95%E0%A6%AA%E0%A6%B0-%E0%A6%B6%E0%A6%B0%E0%A6%AA-%E0%A6%9C%E0%A6%A4%E0%A6%B2-%E0%A6%A8%E0%A6%87%E0%A6%9C%E0%A6%B0%E0%A7%9F">Education Bangla</source>
    </item>
    <item>
      <title>তাইবুরের ডাবল সেঞ্চুরির দিনে তাকরির-প্রীতমের শতক, নাসুম-রনির ফাইফার</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%A4%E0%A6%87%E0%A6%AC%E0%A6%B0%E0%A6%B0-%E0%A6%A1%E0%A6%AC%E0%A6%B2-%E0%A6%B8%E0%A6%9E%E0%A6%9A%E0%A6%B0%E0%A6%B0-%E0%A6%A6%E0%A6%A8-%E0%A6%A4%E0%A6%95%E0%A6%B0%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%A4%E0%A6%AE%E0%A6%B0-%E0%A6%B6%E0%A6%A4%E0%A6%95-%E0%A6%A8%E0%A6%B8%E0%A6%AE-%E0%A6%B0%E0%A6%A8%E0%A6%B0-%E0%A6%AB%E0%A6%87%E0%A6%AB%E0%A6%B0</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%A4%E0%A6%87%E0%A6%AC%E0%A6%B0%E0%A6%B0-%E0%A6%A1%E0%A6%AC%E0%A6%B2-%E0%A6%B8%E0%A6%9E%E0%A6%9A%E0%A6%B0%E0%A6%B0-%E0%A6%A6%E0%A6%A8-%E0%A6%A4%E0%A6%95%E0%A6%B0%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%A4%E0%A6%AE%E0%A6%B0-%E0%A6%B6%E0%A6%A4%E0%A6%95-%E0%A6%A8%E0%A6%B8%E0%A6%AE-%E0%A6%B0%E0%A6%A8%E0%A6%B0-%E0%A6%AB%E0%A6%87%E0%A6%AB%E0%A6%B0</guid>

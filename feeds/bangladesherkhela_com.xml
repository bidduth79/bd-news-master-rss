    </item>
    <item>
      <title>টানা আট জয়ে চ্যাম্পিয়ন শ্রীলঙ্কা</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%9F%E0%A6%A8-%E0%A6%86%E0%A6%9F-%E0%A6%9C%E0%A7%9F-%E0%A6%9A%E0%A6%AF%E0%A6%AE%E0%A6%AA%E0%A7%9F%E0%A6%A8-%E0%A6%B6%E0%A6%B0%E0%A6%B2%E0%A6%99%E0%A6%95</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%9F%E0%A6%A8-%E0%A6%86%E0%A6%9F-%E0%A6%9C%E0%A7%9F-%E0%A6%9A%E0%A6%AF%E0%A6%AE%E0%A6%AA%E0%A7%9F%E0%A6%A8-%E0%A6%B6%E0%A6%B0%E0%A6%B2%E0%A6%99%E0%A6%95</guid>
      <pubDate>Wed, 25 Nov 2026 15:43:08 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795621388_rkr_6b07020c965a4.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795621388_rkr_6b07020c965a4.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795621388_rkr_6b07020c965a4.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টানা আট জয়ে চ্যাম্পিয়ন শ্রীলঙ্কা" /&gt;&lt;/p&gt;&lt;p&gt;আট ম্যাচের আটটিতেই জয়। পুরো আসর জুড়ে অপ্রতিরোধ্য দাপট দেখিয়ে শেষ পর্যন্ত অপরাজিত চ্যাম্পিয়ন হয়েই ২০২৬ আইসিসি উইমেনস ইমার্জিং নেশনস ট্রফির শিরোপা জিতে নিল শ্রীলঙ্কা। সংযুক্ত আরব আমিরাতের আজমানের কারওয়ান স্পোর্টস ক্লাব মাঠে ফাইনালে আয়ারল্যান্ডকে ৬ উইকেটে হারিয়েছে লঙ্কান মেয়েরা।সত্য সন্দীপনির বিধ্বংসী.&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%9F%E0%A6%A8-%E0%A6%86%E0%A6%9F-%E0%A6%9C%E0%A7%9F-%E0%A6%9A%E0%A6%AF%E0%A6%AE%E0%A6%AA%E0%A7%9F%E0%A6%A8-%E0%A6%B6%E0%A6%B0%E0%A6%B2%E0%A6%99%E0%A6%95">Education Bangla</source>
    </item>
    <item>
      <title>চ্যাম্পিয়নস লিগ দিয়েই ঘুরে দাঁড়াতে চান পচেত্তিনো</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%9A%E0%A6%AF%E0%A6%AE%E0%A6%AA%E0%A6%AF%E0%A6%A8%E0%A6%B8-%E0%A6%B2%E0%A6%97-%E0%A6%A6%E0%A7%9F%E0%A6%87-%E0%A6%98%E0%A6%B0-%E0%A6%A6%E0%A7%9C%E0%A6%A4-%E0%A6%9A%E0%A6%A8-%E0%A6%AA%E0%A6%9A%E0%A6%A4%E0%A6%A4%E0%A6%A8</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%9A%E0%A6%AF%E0%A6%AE%E0%A6%AA%E0%A6%AF%E0%A6%A8%E0%A6%B8-%E0%A6%B2%E0%A6%97-%E0%A6%A6%E0%A7%9F%E0%A6%87-%E0%A6%98%E0%A6%B0-%E0%A6%A6%E0%A7%9C%E0%A6%A4-%E0%A6%9A%E0%A6%A8-%E0%A6%AA%E0%A6%9A%E0%A6%A4%E0%A6%A4%E0%A6%A8</guid>
      <pubDate>Wed, 25 Nov 2026 15:42:20 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1795621340_rkr_6b0701dc55f55.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1795621340_rkr_6b0701dc55f55.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1795621340_rkr_6b0701dc55f55.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চ্যাম্পিয়নস লিগ দিয়েই ঘুরে দাঁড়াতে চান পচেত্তিনো" /&gt;&lt;/p&gt;&lt;p&gt;চলতি মৌসুমের হতাশাজনক পারফরম্যান্স কাটিয়ে উঠতে উয়েফা চ্যাম্পিয়নস লিগকেই পাখির চোখ করেছেন ম্যানচেস্টার ইউনাইটেড কোচ মাউরিসিও পচেত্তিনো। আজ রাতে পর্তুগিজ ক্লাব স্পোর্টিং সিপির বিপক্ষে ম্যাচ দিয়ে ইউনাইটেডের ডাগআউটে চ্যাম্পিয়নস লিগে অভিষেক হতে যাচ্ছে এই আর্জেন্টাইন কোচের। লিসবনের এই লড়াই দিয়েই দলের বর&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%9A%E0%A6%AF%E0%A6%AE%E0%A6%AA%E0%A6%AF%E0%A6%A8%E0%A6%B8-%E0%A6%B2%E0%A6%97-%E0%A6%A6%E0%A7%9F%E0%A6%87-%E0%A6%98%E0%A6%B0-%E0%A6%A6%E0%A7%9C%E0%A6%A4-%E0%A6%9A%E0%A6%A8-%E0%A6%AA%E0%A6%9A%E0%A6%A4%E0%A6%A4%E0%A6%A8">Education Bangla</source>
    </item>

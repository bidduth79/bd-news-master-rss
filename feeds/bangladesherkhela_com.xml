      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794143632_rkr_6af075909ded7.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অস্ট্রেলিয়া সিরিজের আগে দুঃসংবাদ পেল ইংল্যান্ড" /&gt;&lt;/p&gt;&lt;p&gt;পায়ের আঙুলের চোটের কারণে অস্ট্রেলিয়ার বিপক্ষে আসন্ন সীমিত ওভারের সাদা বলের সিরিজ থেকে ছিটকে গেছেন ইংল্যান্ডের পেসার জশ টাং। গত মাসে পাকিস্তানে অনুষ্ঠিত ত্রিদেশীয় সিরিজের শেষ দুটি ম্যাচেও খেলতে পারেননি ২৮ বছর বয়সি এই পেসার। চোটের আরও উন্নতির জন্য তিনি দ্রুত যুক্তরাজ্যে ফিরে যাচ্ছেন।আগামী ১৩ নভেম্বর প&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%85%E0%A6%B8%E0%A6%9F%E0%A6%B0%E0%A6%B2%E0%A7%9F-%E0%A6%B8%E0%A6%B0%E0%A6%9C%E0%A6%B0-%E0%A6%86%E0%A6%97-%E0%A6%A6%E0%A6%B8%E0%A6%AC%E0%A6%A6-%E0%A6%AA%E0%A6%B2-%E0%A6%87%E0%A6%B2%E0%A6%AF%E0%A6%A8%E0%A6%A1">Education Bangla</source>
    </item>
    <item>
      <title>এক ম্যাচে সুলিভান ভাইদের তিন গোল ও বিরল ইতিহাস</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%8F%E0%A6%95-%E0%A6%AE%E0%A6%AF%E0%A6%9A-%E0%A6%B8%E0%A6%B2%E0%A6%AD%E0%A6%A8-%E0%A6%AD%E0%A6%87%E0%A6%A6%E0%A6%B0-%E0%A6%A4%E0%A6%A8-%E0%A6%97%E0%A6%B2-%E0%A6%93-%E0%A6%AC%E0%A6%B0%E0%A6%B2-%E0%A6%87%E0%A6%A4%E0%A6%B9%E0%A6%B8</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%8F%E0%A6%95-%E0%A6%AE%E0%A6%AF%E0%A6%9A-%E0%A6%B8%E0%A6%B2%E0%A6%AD%E0%A6%A8-%E0%A6%AD%E0%A6%87%E0%A6%A6%E0%A6%B0-%E0%A6%A4%E0%A6%A8-%E0%A6%97%E0%A6%B2-%E0%A6%93-%E0%A6%AC%E0%A6%B0%E0%A6%B2-%E0%A6%87%E0%A6%A4%E0%A6%B9%E0%A6%B8</guid>
      <pubDate>Sun, 08 Nov 2026 12:59:03 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794142743_rkr_6af072174236b.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794142743_rkr_6af072174236b.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794142743_rkr_6af072174236b.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এক ম্যাচে সুলিভান ভাইদের তিন গোল ও বিরল ইতিহাস" /&gt;&lt;/p&gt;&lt;p&gt;দুই ভাই কুইন ও কাভান সুলিভান, ছবি: ফিলাডেলফিয়া ইউনিয়ননের এক্স-পেজ থেকে নেওয়াদুই ভাই কুইন ও কাভান সুলিভান, ছবি: ফিলাডেলফিয়া ইউনিয়ননের এক্স-পেজ থেকে নেওয়ামেজর লিগ সকারে এক রোমাঞ্চকর ও বিরল পারিবারিক রূপকথার জন্ম দিয়ে ইতিহাস গড়লেন ফিলাডেলফিয়া ইউনিয়নের বাংলাদেশি বংশোদ্ভুত দুই ভাই কাভান সালিভান ও কুইন সা&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%8F%E0%A6%95-%E0%A6%AE%E0%A6%AF%E0%A6%9A-%E0%A6%B8%E0%A6%B2%E0%A6%AD%E0%A6%A8-%E0%A6%AD%E0%A6%87%E0%A6%A6%E0%A6%B0-%E0%A6%A4%E0%A6%A8-%E0%A6%97%E0%A6%B2-%E0%A6%93-%E0%A6%AC%E0%A6%B0%E0%A6%B2-%E0%A6%87%E0%A6%A4%E0%A6%B9%E0%A6%B8">Education Bangla</source>
    </item>
    <item>
      <title>সমালোচনা থেকে অনেক কিছু শেখার আছে: হৃদয়</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%AE%E0%A6%B2%E0%A6%9A%E0%A6%A8-%E0%A6%A5%E0%A6%95-%E0%A6%85%E0%A6%A8%E0%A6%95-%E0%A6%95%E0%A6%9B-%E0%A6%B6%E0%A6%96%E0%A6%B0-%E0%A6%86%E0%A6%9B-%E0%A6%B9%E0%A6%A6%E0%A7%9F</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%AE%E0%A6%B2%E0%A6%9A%E0%A6%A8-%E0%A6%A5%E0%A6%95-%E0%A6%85%E0%A6%A8%E0%A6%95-%E0%A6%95%E0%A6%9B-%E0%A6%B6%E0%A6%96%E0%A6%B0-%E0%A6%86%E0%A6%9B-%E0%A6%B9%E0%A6%A6%E0%A7%9F</guid>
      <pubDate>Sun, 08 Nov 2026 12:33:13 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_media/1794141157_6af06be5a397c.webp" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_media/1794141157_6af06be5a397c.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_media/1794141157_6af06be5a397c.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সমালোচনা থেকে অনেক কিছু শেখার আছে: হৃদয়" /&gt;&lt;/p&gt;&lt;p&gt;ওয়েস্ট ইন্ডিজের বিপক্ষে সিরিজের প্রথম টেস্টে ৮ উইকেটের বড় ব্যবধানে হেরেছিল বাংলাদেশ। যেখানে দুই ইনিংসেই ব্যর্থতার পরিচয় দেন দলের ব্যাটাররা। বিশেষ করে তাওহীদ হৃদয় ও তানজিদ তামিম আউট হন বাজেভাবে। এর মাঝেই আলোচনার কেন্দ্রে ছিল দুই ইনিংসেই একইভাবে হৃদয়ের উইকেট বিলিয়ে দেওয়ার ধরন।বিজ্ঞাপনঅধিনায়ক নাজমুল হো&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%B8%E0%A6%AE%E0%A6%B2%E0%A6%9A%E0%A6%A8-%E0%A6%A5%E0%A6%95-%E0%A6%85%E0%A6%A8%E0%A6%95-%E0%A6%95%E0%A6%9B-%E0%A6%B6%E0%A6%96%E0%A6%B0-%E0%A6%86%E0%A6%9B-%E0%A6%B9%E0%A6%A6%E0%A7%9F">Education Bangla</source>
    </item>
    <item>
      <title>‘আমি লড়াকু, শেষ দেখে ছাড়ব’ ক্যান্সারের সঙ্গে বাটলারের নতুন লড়াই</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%AE-%E0%A6%B2%E0%A7%9C%E0%A6%95-%E0%A6%B6%E0%A6%B7-%E0%A6%A6%E0%A6%96-%E0%A6%9B%E0%A7%9C%E0%A6%AC-%E0%A6%95%E0%A6%AF%E0%A6%A8%E0%A6%B8%E0%A6%B0%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A6%97-%E0%A6%AC%E0%A6%9F%E0%A6%B2%E0%A6%B0%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A6%A8-%E0%A6%B2%E0%A7%9C%E0%A6%87</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%AE-%E0%A6%B2%E0%A7%9C%E0%A6%95-%E0%A6%B6%E0%A6%B7-%E0%A6%A6%E0%A6%96-%E0%A6%9B%E0%A7%9C%E0%A6%AC-%E0%A6%95%E0%A6%AF%E0%A6%A8%E0%A6%B8%E0%A6%B0%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A6%97-%E0%A6%AC%E0%A6%9F%E0%A6%B2%E0%A6%B0%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A6%A8-%E0%A6%B2%E0%A7%9C%E0%A6%87</guid>
      <pubDate>Sun, 08 Nov 2026 12:29:37 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_media/1794140959_6af06b1fbc99d.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_media/1794140959_6af06b1fbc99d.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_media/1794140959_6af06b1fbc99d.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘আমি লড়াকু, শেষ দেখে ছাড়ব’ ক্যান্সারের সঙ্গে বাটলারের নতুন লড়াই" /&gt;&lt;/p&gt;&lt;p&gt;সবুজ গালিচায় তিনি এক নিপুণ কারিগর। তার পরিকল্পনা ও দিকনির্দেশনায় বাংলাদেশের নারী ফুটবল পেয়েছে একের পর এক সাফল্য।সাবিনা-ঋতুপর্ণাদের হাত ধরে দেশের ফুটবলে নতুন ইতিহাস রচনা করেছেন যিনি, সেই পিটার বাটলার এখন জীবনের সবচেয়ে কঠিন লড়াইয়ের মুখোমুখি।বাংলাদেশ নারী ফুটবল দলের এই ইংলিশ কোচের শরীরে ধরা পড়েছে ক্যান&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%86%E0%A6%AE-%E0%A6%B2%E0%A7%9C%E0%A6%95-%E0%A6%B6%E0%A6%B7-%E0%A6%A6%E0%A6%96-%E0%A6%9B%E0%A7%9C%E0%A6%AC-%E0%A6%95%E0%A6%AF%E0%A6%A8%E0%A6%B8%E0%A6%B0%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A6%97-%E0%A6%AC%E0%A6%9F%E0%A6%B2%E0%A6%B0%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A6%A8-%E0%A6%B2%E0%A7%9C%E0%A6%87">Education Bangla</source>
    </item>
    <item>
      <title>‘উল্লাস ২০২৬’ ইন্টার ক্লাব স্পোর্টসফেস্ট সিজন-২ সম্পন্ন</title>
      <link>https://bangladesherkhela.com/news/%E0%A6%89%E0%A6%B2%E0%A6%B2%E0%A6%B8-%E0%A7%A8%E0%A7%A6%E0%A7%A8%E0%A7%AC-%E0%A6%87%E0%A6%A8%E0%A6%9F%E0%A6%B0-%E0%A6%95%E0%A6%B2%E0%A6%AC-%E0%A6%B8%E0%A6%AA%E0%A6%B0%E0%A6%9F%E0%A6%B8%E0%A6%AB%E0%A6%B8%E0%A6%9F-%E0%A6%B8%E0%A6%9C%E0%A6%A8-%E0%A7%A8-%E0%A6%B8%E0%A6%AE%E0%A6%AA%E0%A6%A8%E0%A6%A8</link>
      <guid isPermaLink="true">https://bangladesherkhela.com/news/%E0%A6%89%E0%A6%B2%E0%A6%B2%E0%A6%B8-%E0%A7%A8%E0%A7%A6%E0%A7%A8%E0%A7%AC-%E0%A6%87%E0%A6%A8%E0%A6%9F%E0%A6%B0-%E0%A6%95%E0%A6%B2%E0%A6%AC-%E0%A6%B8%E0%A6%AA%E0%A6%B0%E0%A6%9F%E0%A6%B8%E0%A6%AB%E0%A6%B8%E0%A6%9F-%E0%A6%B8%E0%A6%9C%E0%A6%A8-%E0%A7%A8-%E0%A6%B8%E0%A6%AE%E0%A6%AA%E0%A6%A8%E0%A6%A8</guid>
      <pubDate>Sun, 08 Nov 2026 12:26:12 +0000</pubDate>
      <enclosure url="https://bangladesherkhela.com/uploads/rkr_posts/1794140772_rkr_6af06a643058d.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794140772_rkr_6af06a643058d.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794140772_rkr_6af06a643058d.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘উল্লাস ২০২৬’ ইন্টার ক্লাব স্পোর্টসফেস্ট সিজন-২ সম্পন্ন" /&gt;&lt;/p&gt;&lt;p&gt;গুলশান ইয়ুথ ক্লাব লিমিটেডের আয়োজনে সপ্তাহব্যাপী ‘উল্লাস ২০২৬ ইন্টার ক্লাব স্পোর্টসফেস্ট, সিজন ২’-এর সফল সমাপনী অনুষ্ঠান ৭ নভেম্বর, শনিবার, গুলশান ইয়ুথ ক্লাব বাস্কেটবল কমপ্লেক্স, গুলশান সেন্ট্রাল পার্ক অ্যান্ড স্পোর্টস কমপ্লেক্সে অনুষ্ঠিত হয়।অনুষ্ঠানে প্রধান অতিথি হিসেবে উপস্থিত ছিলেন গণপ্রজাতন্ত&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A6%89%E0%A6%B2%E0%A6%B2%E0%A6%B8-%E0%A7%A8%E0%A7%A6%E0%A7%A8%E0%A7%AC-%E0%A6%87%E0%A6%A8%E0%A6%9F%E0%A6%B0-%E0%A6%95%E0%A6%B2%E0%A6%AC-%E0%A6%B8%E0%A6%AA%E0%A6%B0%E0%A6%9F%E0%A6%B8%E0%A6%AB%E0%A6%B8%E0%A6%9F-%E0%A6%B8%E0%A6%9C%E0%A6%A8-%E0%A7%A8-%E0%A6%B8%E0%A6%AE%E0%A6%AA%E0%A6%A8%E0%A6%A8">Education Bangla</source>
    </item>

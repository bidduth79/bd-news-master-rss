      <media:content url="https://bangladesherkhela.com/uploads/rkr_posts/1794932755_rkr_6afc801353f87.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bangladesherkhela.com/uploads/rkr_posts/1794932755_rkr_6afc801353f87.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="১৯ বছরের আইপিএল ক্যারিয়ারের ইতি টানলেন ধোনি, পেলেন নতুন দায়িত্ব" /&gt;&lt;/p&gt;&lt;p&gt;দীর্ঘ ১৯ বছরের আইপিএল ক্যারিয়ারের ইতি টানলেন ভারতের সাবেক অধিনায়ক মহেন্দ্র সিং ধোনি। ক্রিকেটার হিসেবে বিদায় নিলেও চেন্নাই সুপার কিংসের (সিএসকে) সঙ্গেই থাকছেন তিনি। আইপিএল ২০২৭ মৌসুমে ফ্র্যাঞ্চাইজিটির মেন্টর হিসেবে নতুন দায়িত্ব পালন করবেন ধোনি। খবর ক্রিকইনফোর।মঙ্গলবার (১৭ নভেম্বর) আসন্ন আইপিএল নিলামে&lt;/p&gt;</description>
      <source url="https://bangladesherkhela.com/news/%E0%A7%A7%E0%A7%AF-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A6%B0-%E0%A6%86%E0%A6%87%E0%A6%AA%E0%A6%8F%E0%A6%B2-%E0%A6%95%E0%A6%AF%E0%A6%B0%E0%A7%9F%E0%A6%B0%E0%A6%B0-%E0%A6%87%E0%A6%A4-%E0%A6%9F%E0%A6%A8%E0%A6%B2%E0%A6%A8-%E0%A6%A7%E0%A6%A8-%E0%A6%AA%E0%A6%B2%E0%A6%A8-%E0%A6%A8%E0%A6%A4%E0%A6%A8-%E0%A6%A6%E0%A7%9F%E0%A6%A4%E0%A6%AC">Education Bangla</source>

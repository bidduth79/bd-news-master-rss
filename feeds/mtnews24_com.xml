    <item>
      <title>স্বর্ণের দাম ভরিতে এক লাফে যত কমলো</title>
      <link>https://bn.mtnews24.com/jatio/582287/%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE-%E0%A6%AD%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%8F%E0%A6%95-%E0%A6%B2%E0%A6%BE%E0%A6%AB%E0%A7%87-%E0%A6%AF%E0%A6%A4-%E0%A6%95%E0%A6%AE%E0%A6%B2%E0%A7%8B</link>

      <link>https://bn.mtnews24.com/bdjobs/582033/%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95-%E0%A6%8F%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%8B%E0%A6%97-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A7%8D%E0%A6%9E%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B6</link>
      <guid isPermaLink="true">https://bn.mtnews24.com/bdjobs/582033/%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95-%E0%A6%8F%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%8B%E0%A6%97-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A7%8D%E0%A6%9E%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B6</guid>
      <pubDate>Tue, 10 Nov 2026 13:11:43 +0600</pubDate>
      <enclosure url="https://bn.mtnews24.com/uploads/1698767724.webp" length="0" type="image/jpeg" />
      <media:content url="https://bn.mtnews24.com/uploads/1698767724.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bn.mtnews24.com/uploads/1698767724.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ব্যাংক এশিয়ায় নতুন নিয়োগ বিজ্ঞপ্তি প্রকাশ" /&gt;&lt;/p&gt;&lt;p&gt;এমটিনিউজ২৪জবস : নতুন নিয়োগ বিজ্ঞপ্তি প্রকাশ করেছে ব্যাংক এশিয়া পিএলসি। বেসরকারি বাণিজ্যিক ব্যাংকটির রিটেইল সেলস বিভাগ ‘ইউনিট হেড’ পদে জনবল নিয়োগের জন্য এ বিজ্ঞপ্তি দিয়েছে। 

ইতোমধ্যে আবেদন নেওয়া শুরু হয়েছে। আবেদন&lt;/p&gt;</description>
      <source url="https://bn.mtnews24.com/bdjobs/582033/%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95-%E0%A6%8F%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%8B%E0%A6%97-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A7%8D%E0%A6%9E%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B6">নিউজ ২৪</source>
    </item>
    <item>
      <title>স্বর্ণের দামে আজ আবার বড় পতন</title>

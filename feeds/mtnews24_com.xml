    </item>
    <item>
      <title>টাকার রেট আজ কত জেনে নিন প্রবাসীরা</title>
      <link>https://bn.mtnews24.com/jatio/582221/%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A7%87%E0%A6%9F-%E0%A6%86%E0%A6%9C-%E0%A6%95%E0%A6%A4-%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%80%E0%A6%B0%E0%A6%BE</link>

      <enclosure url="https://bn.mtnews24.com/uploads/1779258702.webp" length="0" type="image/jpeg" />
      <media:content url="https://bn.mtnews24.com/uploads/1779258702.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bn.mtnews24.com/uploads/1779258702.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নতুন পে স্কেলে ভাতা নিয়ে এবার যে প্রজ্ঞাপন জারি" /&gt;&lt;/p&gt;&lt;p&gt;এমটিনিউজ ডেস্ক : নতুন পে স্কেল ধাপে ধাপে বাস্তবায়নের সময় সরকারি কর্মকর্তা-কর্মচারীদের শ্রান্তি ও বিনোদন ভাতা (বিনোদন ভাতা) প্রদানের বিষয়ে নির্দেশনা জারি করেছে সরকার। এ সময় কোনো কর্মচারী যে মাসে&lt;/p&gt;</description>
      <source url="https://bn.mtnews24.com/jatio/582185/%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%AA%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%AD%E0%A6%BE%E0%A6%A4%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AF%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%9C%E0%A7%8D%E0%A6%9E%E0%A6%BE%E0%A6%AA%E0%A6%A8-%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A6%BF">নিউজ ২৪</source>
    </item>
    <item>
      <title>দেশের আকাশে চাঁদ দেখা গেছে, যখন রমজান শুরু</title>
      <link>https://bn.mtnews24.com/jatio/582183/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%95%E0%A6%BE%E0%A6%B6%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%A6-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BE-%E0%A6%97%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%AF%E0%A6%96%E0%A6%A8-%E0%A6%B0%E0%A6%AE%E0%A6%9C%E0%A6%BE%E0%A6%A8-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81</link>
      <guid isPermaLink="true">https://bn.mtnews24.com/jatio/582183/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%95%E0%A6%BE%E0%A6%B6%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%A6-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BE-%E0%A6%97%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%AF%E0%A6%96%E0%A6%A8-%E0%A6%B0%E0%A6%AE%E0%A6%9C%E0%A6%BE%E0%A6%A8-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81</guid>
      <pubDate>Wed, 11 Nov 2026 23:11:16 +0600</pubDate>
      <enclosure url="https://bn.mtnews24.com/uploads/1777037729.webp" length="0" type="image/jpeg" />
      <media:content url="https://bn.mtnews24.com/uploads/1777037729.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bn.mtnews24.com/uploads/1777037729.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দেশের আকাশে চাঁদ দেখা গেছে, যখন রমজান শুরু" /&gt;&lt;/p&gt;&lt;p&gt;এমটিনিউজ ডেস্ক : দেশের আকাশে পবিত্র জমাদিউস সানি মাসের চাঁদ দেখা গেছে। বুধবার (১১ নভেম্বর) থেকে এ মাসের গণনা শুরু হচ্ছে।

হিজরি বর্ষপঞ্জি অনুযায়ী, জমাদিউস সানি বছরের ষষ্ঠ মাস। এর পরের&lt;/p&gt;</description>
      <source url="https://bn.mtnews24.com/jatio/582183/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%95%E0%A6%BE%E0%A6%B6%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%A6-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BE-%E0%A6%97%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%AF%E0%A6%96%E0%A6%A8-%E0%A6%B0%E0%A6%AE%E0%A6%9C%E0%A6%BE%E0%A6%A8-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81">নিউজ ২৪</source>
    </item>

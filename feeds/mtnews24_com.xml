    <item>
      <title>ব্রেকিং নিউজ : ট্রেনে আগুন</title>
      <link>https://bn.mtnews24.com/jatio/582353/%E0%A6%AC%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%BF%E0%A6%82-%E0%A6%A8%E0%A6%BF%E0%A6%89%E0%A6%9C-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</link>
      <guid isPermaLink="true">https://bn.mtnews24.com/jatio/582353/%E0%A6%AC%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%BF%E0%A6%82-%E0%A6%A8%E0%A6%BF%E0%A6%89%E0%A6%9C-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</guid>
      <pubDate>Fri, 13 Nov 2026 19:11:47 +0600</pubDate>
      <enclosure url="https://bn.mtnews24.com/uploads/1794575926.webp" length="0" type="image/jpeg" />
      <media:content url="https://bn.mtnews24.com/uploads/1794575926.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bn.mtnews24.com/uploads/1794575926.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ব্রেকিং নিউজ : ট্রেনে আগুন" /&gt;&lt;/p&gt;&lt;p&gt;এমটিনিউজ ডেস্ক : গাজীপুরের পূবাইলে কিশোরগঞ্জ থেকে ছেড়ে আসা ঢাকাগামী আন্তঃনগর এগারসিন্দুর এক্সপ্রেস ট্রেনের ইঞ্জিনে আগুনের ঘটনা ঘটেছে।

শুক্রবার (১৩ নভেম্বর) বিকেল সাড়ে ৪টার দিকে ট্রেনের ইঞ্জিনে আগুন দেখা যায়। সে&lt;/p&gt;</description>
      <source url="https://bn.mtnews24.com/jatio/582353/%E0%A6%AC%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%BF%E0%A6%82-%E0%A6%A8%E0%A6%BF%E0%A6%89%E0%A6%9C-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8">নিউজ ২৪</source>
    </item>
    <item>

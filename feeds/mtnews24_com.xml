      <title>মারা গেছেন জনপ্রিয় অভিনেতা সোহেল খান</title>
      <link>https://bn.mtnews24.com/binodon/583267/%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%97%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%9C%E0%A6%A8%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A7%9F-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%B8%E0%A7%8B%E0%A6%B9%E0%A7%87%E0%A6%B2-%E0%A6%96%E0%A6%BE%E0%A6%A8</link>
      <guid isPermaLink="true">https://bn.mtnews24.com/binodon/583267/%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%97%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%9C%E0%A6%A8%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A7%9F-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%B8%E0%A7%8B%E0%A6%B9%E0%A7%87%E0%A6%B2-%E0%A6%96%E0%A6%BE%E0%A6%A8</guid>
      <pubDate>Tue, 24 Nov 2026 11:11:58 +0600</pubDate>
      <enclosure url="https://bn.mtnews24.com/uploads/1795497237.webp" length="0" type="image/jpeg" />
      <media:content url="https://bn.mtnews24.com/uploads/1795497237.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bn.mtnews24.com/uploads/1795497237.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মারা গেছেন জনপ্রিয় অভিনেতা সোহেল খান" /&gt;&lt;/p&gt;&lt;p&gt;বিনোদন ডেস্ক : নাটক ও সিনেমার জনপ্রিয় অভিনেতা সোহেল খান মারা গেছেন (ইন্না লিল্লাহি ওয়া ইন্না ইলাইহি রাজিউন)।

মঙ্গলবার (২৪ নভেম্বর) সকাল ১০টার দিকে বগুড়া সম্মিলিত সামরিক হাসপাতালে (সিএমএইচ) শেষ নিঃশ্বাস&lt;/p&gt;</description>
      <source url="https://bn.mtnews24.com/binodon/583267/%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%97%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%9C%E0%A6%A8%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A7%9F-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%B8%E0%A7%8B%E0%A6%B9%E0%A7%87%E0%A6%B2-%E0%A6%96%E0%A6%BE%E0%A6%A8">নিউজ ২৪</source>
    </item>

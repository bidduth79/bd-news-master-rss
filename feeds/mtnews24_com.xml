      <pubDate>Sun, 08 Nov 2026 22:11:55 +0600</pubDate>
      <enclosure url="https://bn.mtnews24.com/uploads/1794156354.webp" length="0" type="image/jpeg" />
      <media:content url="https://bn.mtnews24.com/uploads/1794156354.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bn.mtnews24.com/uploads/1794156354.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজধানীতে দাঁড়িয়ে থাকা স্কুল বাসে আগুন" /&gt;&lt;/p&gt;&lt;p&gt;এমটিনিউজ ডেস্ক : রাজধানীর ভাটারা থানার কাছে ১০০ ফিট রাস্তার পাশে দাঁড়িয়ে থাকা একটি স্কুল বাসে আগুন দিয়েছে দুর্বৃত্তরা।

রোববার (৮ নভেম্বর) সন্ধ্যা সাতটার দিকে বিষয়টি নিশ্চিত করেন বাড্ডা থানার ভারপ্রাপ্ত&lt;/p&gt;</description>
      <source url="https://bn.mtnews24.com/dhaka/581913/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A6%BE%E0%A6%81%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8">নিউজ ২৪</source>
    </item>

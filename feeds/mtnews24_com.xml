      <guid isPermaLink="true">https://bn.mtnews24.com/Coxs-Bazar/583337/%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A7%80-%E0%A6%AC%E0%A6%BE%E0%A6%B8-%E0%A6%93-%E0%A6%B8%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%9C%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%A4-%E0%A6%85%E0%A6%9F%E0%A7%8B%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%B6%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%8B%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A6%BF-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%B0%E0%A7%8D%E0%A6%B7-%E0%A7%AB-%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81</guid>
      <pubDate>Tue, 24 Nov 2026 23:11:50 +0600</pubDate>
      <enclosure url="https://bn.mtnews24.com/uploads/1795539649.webp" length="0" type="image/jpeg" />
      <media:content url="https://bn.mtnews24.com/uploads/1795539649.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bn.mtnews24.com/uploads/1795539649.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যাত্রীবাহী বাস ও সিএনজিচালিত অটোরিকশার মুখোমুখি সংঘর্ষ, ৫ জনের মৃত্যু" /&gt;&lt;/p&gt;&lt;p&gt;এমটিনিউজ ডেস্ক : কক্সবাজারের ঈদগাঁওয়ে যাত্রীবাহী বাস ও সিএনজিচালিত অটোরিকশার মুখোমুখি সংঘর্ষে পাঁচজন নিহত হয়েছেন। মঙ্গলবার (২৪ নভেম্বর) সন্ধ্যা ৭টার দিকে কক্সবাজার-চট্টগ্রাম মহাসড়কের ঈদগাঁও থানা এলাকার ফকিরাবাজারে এ দুর্ঘটনা ঘটে।

নিহতরা&lt;/p&gt;</description>

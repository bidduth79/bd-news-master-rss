      <pubDate>Mon, 16 Nov 2026 14:11:05 +0600</pubDate>
      <enclosure url="https://bn.mtnews24.com/uploads/1695586575.webp" length="0" type="image/jpeg" />
      <media:content url="https://bn.mtnews24.com/uploads/1695586575.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bn.mtnews24.com/uploads/1695586575.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পররাষ্ট্র মন্ত্রণালয়ে পিটার হাস" /&gt;&lt;/p&gt;&lt;p&gt;এমটিনিউজ ডেস্ক : ঢাকা সফরে থাকা যুক্তরাষ্ট্রের সাবেক রাষ্ট্রদূত পিটার হাসকে পররাষ্ট্র মন্ত্রণালয়ে দেখা গেছে। সোমবার (১৬ নভেম্বর) সকালে তিনি সেখানে যান। তবে কী কারণে বা কোন উদ্দেশ্যে তিনি মন্ত্রণালয়ে&lt;/p&gt;</description>
      <source url="https://bn.mtnews24.com/jatio/582595/%E0%A6%AA%E0%A6%B0%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0-%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A3%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87-%E0%A6%AA%E0%A6%BF%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%B8">নিউজ ২৪</source>
    </item>

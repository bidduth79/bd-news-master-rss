    <item>
      <title>এবার টানা ৪ দিনের ছুটির সুযোগ</title>
      <link>https://bn.mtnews24.com/jatio/581907/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%9F%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A7%AA-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%9B%E0%A7%81%E0%A6%9F%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A7%81%E0%A6%AF%E0%A7%8B%E0%A6%97</link>
      <guid isPermaLink="true">https://bn.mtnews24.com/jatio/581907/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%9F%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A7%AA-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%9B%E0%A7%81%E0%A6%9F%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A7%81%E0%A6%AF%E0%A7%8B%E0%A6%97</guid>
      <pubDate>Sun, 08 Nov 2026 21:11:24 +0600</pubDate>
      <enclosure url="https://bn.mtnews24.com/uploads/1718251227.webp" length="0" type="image/jpeg" />
      <media:content url="https://bn.mtnews24.com/uploads/1718251227.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bn.mtnews24.com/uploads/1718251227.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এবার টানা ৪ দিনের ছুটির সুযোগ" /&gt;&lt;/p&gt;&lt;p&gt;এমটিনিউজ ডেস্ক : চলতি বছরের শেষ মাস ডিসেম্বরে চাকরিজীবীদের জন্য অপেক্ষা করছে টানা চার দিনের ছুটি কাটানোর সুযোগ। মাত্র একদিনের বাড়তি ছুটি নিতে পারলেই এই সুযোগ কাজে লাগাতে পারবেন সরকারি-বেসরকারি&lt;/p&gt;</description>

    <item>
      <title>কেন ‘মিডল ফিঙ্গার’ দেখালেন নায়িকা পরীমনি?</title>
      <link>https://bn.mtnews24.com/binodon/581931/%E0%A6%95%E0%A7%87%E0%A6%A8-%E2%80%98%E0%A6%AE%E0%A6%BF%E0%A6%A1%E0%A6%B2-%E0%A6%AB%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE%E0%A6%B0%E2%80%99-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%A8%E0%A6%BE%E0%A7%9F%E0%A6%BF%E0%A6%95%E0%A6%BE-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%AE%E0%A6%A8%E0%A6%BF-</link>

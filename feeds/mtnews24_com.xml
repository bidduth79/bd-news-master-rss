    <item>
      <title>সারজিস আলমকে ‘ভণ্ড’ বলে এনসিপি ছাড়লেন এক নেতা</title>
      <link>https://bn.mtnews24.com/jatio/582037/%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A6%9C%E0%A6%BF%E0%A6%B8-%E0%A6%86%E0%A6%B2%E0%A6%AE%E0%A6%95%E0%A7%87-%E2%80%98%E0%A6%AD%E0%A6%A3%E0%A7%8D%E0%A6%A1%E2%80%99-%E0%A6%AC%E0%A6%B2%E0%A7%87-%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%8F%E0%A6%95-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE</link>
      <guid isPermaLink="true">https://bn.mtnews24.com/jatio/582037/%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A6%9C%E0%A6%BF%E0%A6%B8-%E0%A6%86%E0%A6%B2%E0%A6%AE%E0%A6%95%E0%A7%87-%E2%80%98%E0%A6%AD%E0%A6%A3%E0%A7%8D%E0%A6%A1%E2%80%99-%E0%A6%AC%E0%A6%B2%E0%A7%87-%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%8F%E0%A6%95-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE</guid>

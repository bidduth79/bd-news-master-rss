    <item>
      <title>ধসে পড়ল বহুতল ভবন, ১১ জনের মৃত্যু</title>
      <link>https://bn.mtnews24.com/antorjatik/583661/%E0%A6%A7%E0%A6%B8%E0%A7%87-%E0%A6%AA%E0%A7%9C%E0%A6%B2-%E0%A6%AC%E0%A6%B9%E0%A7%81%E0%A6%A4%E0%A6%B2-%E0%A6%AD%E0%A6%AC%E0%A6%A8-%E0%A7%A7%E0%A7%A7-%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81</link>

      <description>&lt;p&gt;&lt;img src="https://bn.mtnews24.com/uploads/1773677122.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আজ রাতে ঢাকাসহ ১০ জেলায় ঝড়ের শঙ্কা" /&gt;&lt;/p&gt;&lt;p&gt;এমটিনিউজ ডেস্ক : ঢাকাসহ দেশের ১০ জেলায় ঘণ্টায় ৪৫ থেকে ৬০ কিলোমিটার বেগে ঝড়ো হাওয়া বয়ে যেতে পারে। একই সঙ্গে বৃষ্টি অথবা বজ্রসহ বৃষ্টির আশঙ্কা রয়েছে। এ কারণে সংশ্লিষ্ট এলাকার&lt;/p&gt;</description>
      <source url="https://bn.mtnews24.com/jatio/582941/%E0%A6%86%E0%A6%9C-%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B8%E0%A6%B9-%E0%A7%A7%E0%A7%A6-%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%9D%E0%A7%9C%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BE">নিউজ ২৪</source>
    </item>
    <item>
      <title>গোপালগঞ্জে দুই থানার কার্যক্রম বন্ধ</title>
      <link>https://bn.mtnews24.com/gopalgong/582939/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7</link>

      <media:content url="https://bn.mtnews24.com/uploads/1795859375.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bn.mtnews24.com/uploads/1795859375.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চুরি হয়েছে দুই হাজার ভরি স্বর্ণ, নিয়ে গেছে ১২ লাখ টাকা" /&gt;&lt;/p&gt;&lt;p&gt;এমটিনিউজ ডেস্ক : রাতের খাবারে মোরগ পোলাও। সেই খাবার খেয়েই অচেতন হয়ে পড়েন নিরাপত্তাকর্মীরা। আর এই সুযোগে রাজধানীর ধানমন্ডির আনাম র‍্যাংস প্লাজার একটি জুয়েলার্সে ঢুকে বিপুল স্বর্ণালংকার লুট করে নিয়ে&lt;/p&gt;</description>
      <source url="https://bn.mtnews24.com/dhaka/583667/%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%B9%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%AD%E0%A6%B0%E0%A6%BF-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A7%A7%E0%A7%A8-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE">নিউজ ২৪</source>

      <link>https://bn.mtnews24.com/chadpur/582167/%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A6%B2%E0%A7%80%E0%A7%9F-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</link>
      <guid isPermaLink="true">https://bn.mtnews24.com/chadpur/582167/%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A6%B2%E0%A7%80%E0%A7%9F-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</guid>
      <pubDate>Wed, 11 Nov 2026 19:11:54 +0600</pubDate>
      <enclosure url="https://bn.mtnews24.com/uploads/1794403013.webp" length="0" type="image/jpeg" />
      <media:content url="https://bn.mtnews24.com/uploads/1794403013.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bn.mtnews24.com/uploads/1794403013.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিএনপির দলীয় কার্যালয়ে আগুন" /&gt;&lt;/p&gt;&lt;p&gt;এমটিনিউজ ডেস্ক : চাঁদপুরের মতলব উত্তর উপজেলায় বিএনপির সংসদ সদস্য ড. মো. জালাল উদ্দিনের নিজ ইউনিয়নে বিএনপির একটি দলীয় কার্যালয়ে আগুন লাগার ঘটনা ঘটেছে।

মঙ্গলবার (১০ নভেম্বর) দিবাগত রাত আড়াইটার দিকে&lt;/p&gt;</description>
      <source url="https://bn.mtnews24.com/chadpur/582167/%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A6%B2%E0%A7%80%E0%A7%9F-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8">নিউজ ২৪</source>
    </item>

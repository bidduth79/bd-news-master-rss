      <description>&lt;p&gt;&lt;img src="https://bn.mtnews24.com/uploads/1795858846.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পেট্রোলবোমার বিস্ফোরণে ট্রান্সফরমারে আগুন ধরে যায়, এ সময় তিন রাউন্ড গুলিও ছোড়ে হামলাকারীরা" /&gt;&lt;/p&gt;&lt;p&gt;প্রথম রাতে পেট্রোলবোমা ছুড়েও আগুন ধরাতে পারেনি দুর্বৃত্তরা। পর দিন রাতেই আরও সংগঠিতভাবে ফিরে আসে তারা। এবার শুধু পেট্রোলবোমা নয়, সঙ্গে ছিল আগ্নেয়াস্ত্রও। রাজশাহীর খড়খড়ি এলাকায় পল্লী বিদ্যুৎ সমিতির ৩৩&lt;/p&gt;</description>
      <source url="https://bn.mtnews24.com/rajshahi/583663/%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B2%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%B8%E0%A6%AB%E0%A6%B0%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%A7%E0%A6%B0%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A7%9F-%E0%A6%8F-%E0%A6%B8%E0%A6%AE%E0%A7%9F-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%B0%E0%A6%BE%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%A1-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%93-%E0%A6%9B%E0%A7%8B%E0%A7%9C%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%B0%E0%A6%BE">নিউজ ২৪</source>

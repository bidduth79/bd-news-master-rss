      <guid isPermaLink="true">https://bn.mtnews24.com/kheladhula/582989/%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%80%E0%A7%9F-%E0%A6%B8%E0%A6%BF%E0%A6%B0%E0%A6%BF%E0%A6%9C-%E0%A6%86%E0%A7%9F%E0%A7%8B%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%AC</guid>
      <pubDate>Sat, 21 Nov 2026 13:11:24 +0600</pubDate>
      <enclosure url="https://bn.mtnews24.com/uploads/1724220330.webp" length="0" type="image/jpeg" />
      <media:content url="https://bn.mtnews24.com/uploads/1724220330.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bn.mtnews24.com/uploads/1724220330.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ত্রিদেশীয় সিরিজ আয়োজনের প্রস্তাব" /&gt;&lt;/p&gt;&lt;p&gt;স্পোর্টস ডেস্ক : ২০২৭ এশিয়া কাপের আগে দেশের মাটিতে পাকিস্তান ও শ্রীলঙ্কাকে নিয়ে একটি ত্রিদেশীয় সিরিজ আয়োজনের প্রস্তাব দিয়েছে বাংলাদেশ ক্রিকেট বোর্ড (বিসিবি)। প্রস্তাবটিতে ইতিবাচক সাড়া দিয়েছে দুই দেশের বোর্ডই।&lt;/p&gt;</description>
      <source url="https://bn.mtnews24.com/kheladhula/582989/%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%80%E0%A7%9F-%E0%A6%B8%E0%A6%BF%E0%A6%B0%E0%A6%BF%E0%A6%9C-%E0%A6%86%E0%A7%9F%E0%A7%8B%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%AC">নিউজ ২৪</source>
    </item>

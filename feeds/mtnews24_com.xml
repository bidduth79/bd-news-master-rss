      <enclosure url="https://bn.mtnews24.com/uploads/1794849780.webp" length="0" type="image/jpeg" />
      <media:content url="https://bn.mtnews24.com/uploads/1794849780.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bn.mtnews24.com/uploads/1794849780.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজধানীতে যাত্রীবাহী বাসে আগুন, হাতেনাতে দুইজনকে গ্রেপ্তার করল পুলিশ" /&gt;&lt;/p&gt;&lt;p&gt;এমটিনিউজ ডেস্ক : রাজধানীর মিরপুর মডেল থানা এলাকায় রাজধানী পরিবহনের একটি বাসে আগুন দিয়েছে দুর্বৃত্তরা। এ সময় হাতেনাতে দুইজনকে গ্রেপ্তার করে পুলিশ।

সোমবার (১৬ নভেম্বর) রাত দশটা পাঁচ মিনিটের দিকে এই&lt;/p&gt;</description>
      <source url="https://bn.mtnews24.com/jatio/582639/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A7%80-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%A8%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%87%E0%A6%9C%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%B2-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6">নিউজ ২৪</source>

      <enclosure url="https://bn.mtnews24.com/uploads/1794759723.webp" length="0" type="image/jpeg" />
      <media:content url="https://bn.mtnews24.com/uploads/1794759723.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bn.mtnews24.com/uploads/1794759723.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গোপালগঞ্জে পুলিশের গাড়ি ভাঙচুর মামলার বাদী এসআইকে কুপিয়ে জখম" /&gt;&lt;/p&gt;&lt;p&gt;এমটিনিউজ ডেস্ক : গোপালগঞ্জের টুঙ্গিপাড়ায় পুলিশের গাড়ি ভাঙচুর ও অগ্নিসংযোগের ঘটনায় করা মামলার বাদী উপপরিদর্শক (এসআই) মোসলেম আলীকে কুপিয়ে জখম করেছে দুর্বৃত্তরা।

রোববার (১৫ নভেম্বর) বিকেলে উপজেলার পাটগাতি বাজারে দায়িত্ব পালনকালে&lt;/p&gt;</description>
      <source url="https://bn.mtnews24.com/jatio/582541/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%AD%E0%A6%BE%E0%A6%99%E0%A6%9A%E0%A7%81%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A7%80-%E0%A6%8F%E0%A6%B8%E0%A6%86%E0%A6%87%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A7%81%E0%A6%AA%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%9C%E0%A6%96%E0%A6%AE">নিউজ ২৪</source>

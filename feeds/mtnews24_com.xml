      <pubDate>Fri, 27 Nov 2026 12:11:43 +0600</pubDate>
      <enclosure url="https://bn.mtnews24.com/uploads/1790656426.webp" length="0" type="image/jpeg" />
      <media:content url="https://bn.mtnews24.com/uploads/1790656426.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bn.mtnews24.com/uploads/1790656426.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দেশের বাজারে স্বর্ণের দামে আবারও লাফ" /&gt;&lt;/p&gt;&lt;p&gt;এমটিনিউজ ডেস্ক : তেজাবি স্বর্ণের মূল্য বেড়ে যাওয়ায় দেশের বাজারে স্বর্ণের দাম আরও বেড়েছে। বাংলাদেশ জুয়েলার্স অ্যাসোসিয়েশন (বাজুস) এবার ভরিতে ১ হাজার ৫০ টাকা বাড়িয়ে ভ্যাটসহ ২২ ক্যারেটের এক ভরি&lt;/p&gt;</description>
      <source url="https://bn.mtnews24.com/jatio/583583/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%86%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A6%93-%E0%A6%B2%E0%A6%BE%E0%A6%AB">নিউজ ২৪</source>
    </item>

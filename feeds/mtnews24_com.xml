    <item>
      <title>এমপি মালেকের বাড়িতে পেট্রল বোমা নিক্ষেপ</title>
      <link>https://bn.mtnews24.com/jatio/583679/%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF-%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%B2-%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA</link>
      <guid isPermaLink="true">https://bn.mtnews24.com/jatio/583679/%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF-%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%B2-%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA</guid>
      <pubDate>Sat, 28 Nov 2026 19:11:08 +0600</pubDate>
      <enclosure url="https://bn.mtnews24.com/uploads/1795871587.webp" length="0" type="image/jpeg" />
      <media:content url="https://bn.mtnews24.com/uploads/1795871587.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bn.mtnews24.com/uploads/1795871587.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এমপি মালেকের বাড়িতে পেট্রল বোমা নিক্ষেপ" /&gt;&lt;/p&gt;&lt;p&gt;এমটিনিউজ ডেস্ক : সিলেট-৩ আসনের সংসদ সদস্য মোহাম্মদ আব্দুল মালেকের বাড়িতে পেট্রল বোমা নিক্ষেপ করেছে দুর্বৃত্তরা।

শনিবার (২৮ নভেম্বর) ভোরে দক্ষিণ সুরমা উপজেলার ঢাকা-সিলেট মহাসড়কসংলগ্ন তেতলি এলাকায় তার বাড়িতে এ ঘটনা&lt;/p&gt;</description>

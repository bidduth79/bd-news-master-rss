    <item>
      <title>‘শেখ হাসিনা আর ফিরে আসবেন না’</title>
      <link>https://bn.mtnews24.com/jatio/582965/%E2%80%98%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE-%E0%A6%86%E0%A6%B0-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%B8%E0%A6%AC%E0%A7%87%E0%A6%A8-%E0%A6%A8%E0%A6%BE%E2%80%99</link>
      <guid isPermaLink="true">https://bn.mtnews24.com/jatio/582965/%E2%80%98%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE-%E0%A6%86%E0%A6%B0-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%B8%E0%A6%AC%E0%A7%87%E0%A6%A8-%E0%A6%A8%E0%A6%BE%E2%80%99</guid>
      <pubDate>Fri, 20 Nov 2026 23:11:25 +0600</pubDate>
      <enclosure url="https://bn.mtnews24.com/uploads/1795194263.webp" length="0" type="image/jpeg" />
      <media:content url="https://bn.mtnews24.com/uploads/1795194263.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bn.mtnews24.com/uploads/1795194263.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘শেখ হাসিনা আর ফিরে আসবেন না’" /&gt;&lt;/p&gt;&lt;p&gt;এমটিনিউজ ডেস্ক : ‘শেখ হাসিনা আর ফিরে আসবেন না। আপনাদের ফেলে আত্মীয়স্বজন নিয়ে তিনি চলে গেছেন। তার জন্য আপনারা এসব করছেন কেন, তা বোধগম্য নয়। ভুল পথে যাবেন না। আমরা&lt;/p&gt;</description>
      <source url="https://bn.mtnews24.com/jatio/582965/%E2%80%98%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE-%E0%A6%86%E0%A6%B0-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%B8%E0%A6%AC%E0%A7%87%E0%A6%A8-%E0%A6%A8%E0%A6%BE%E2%80%99">নিউজ ২৪</source>
    </item>

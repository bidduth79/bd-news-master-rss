      <enclosure url="https://bn.mtnews24.com/uploads/1772785145.webp" length="0" type="image/jpeg" />
      <media:content url="https://bn.mtnews24.com/uploads/1772785145.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bn.mtnews24.com/uploads/1772785145.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সারজিস আলমকে ‘ভণ্ড’ বলে এনসিপি ছাড়লেন এক নেতা" /&gt;&lt;/p&gt;&lt;p&gt;এমটিনিউজ ডেস্ক : দলের নানা কর্মকাণ্ড নিয়ে ক্ষোভ প্রকাশ করে জাতীয় নাগরিক পার্টি (এনসিপি) ছাড়লেন দলটির হবিগঞ্জ জেলা কমিটির ক্রীড়া সম্পাদক ফজলুল করিম। সোমবার (৯ নভেম্বর) রাত ১০টার দিকে সামাজিক&lt;/p&gt;</description>
      <source url="https://bn.mtnews24.com/jatio/582037/%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A6%9C%E0%A6%BF%E0%A6%B8-%E0%A6%86%E0%A6%B2%E0%A6%AE%E0%A6%95%E0%A7%87-%E2%80%98%E0%A6%AD%E0%A6%A3%E0%A7%8D%E0%A6%A1%E2%80%99-%E0%A6%AC%E0%A6%B2%E0%A7%87-%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%8F%E0%A6%95-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE">নিউজ ২৪</source>
    </item>

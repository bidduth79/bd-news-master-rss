      <media:content url="https://bn.mtnews24.com/uploads/1794385278.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bn.mtnews24.com/uploads/1794385278.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সালাহউদ্দিন আম্মার এবার এক নতুন দায়িত্বে" /&gt;&lt;/p&gt;&lt;p&gt;এমটিনিউজ ডেস্ক : রাজশাহী বিশ্ববিদ্যালয়ের (রাবি) বিভিন্ন কাঠামোগত সংস্কার ও শিক্ষার্থীদের যৌক্তিক দাবিদাওয়া আদায়ের লক্ষ্যে গঠিত ‘রাবি সংস্কার আন্দোলন’-এর আহ্বায়ক কমিটি ঘোষণা করা হয়েছে। ১৯ সদস্যের এ কমিটিতে আহ্বায়ক করা&lt;/p&gt;</description>
      <source url="https://bn.mtnews24.com/jatio/582139/%E0%A6%B8%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%B9%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%86%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%BE%E0%A6%B0-%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%8F%E0%A6%95-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%A6%E0%A6%BE%E0%A7%9F%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A7%87">নিউজ ২৪</source>

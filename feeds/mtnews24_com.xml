      <description>&lt;p&gt;&lt;img src="https://bn.mtnews24.com/uploads/1769951567.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দেশের সব শিক্ষাপ্রতিষ্ঠানের জন্য জরুরি নির্দেশনা, সময় ৩ দিন" /&gt;&lt;/p&gt;&lt;p&gt;এমটিনিউজ ডেস্ক : দেশের সব মাধ্যমিক বিদ্যালয় ও কলেজে ‘মাদক ও ইভটিজিং প্রতিরোধ কমিটি’ গঠনের নির্দেশ দেওয়া হয়েছে। শিক্ষক, অভিভাবক, স্থানীয় কর্মকর্তা ও জনপ্রতিনিধিদের সমন্বয়ে এ কমিটি গঠন করতে হবে।

কমিটি&lt;/p&gt;</description>
      <source url="https://bn.mtnews24.com/jatio/581891/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AC-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%9C%E0%A6%B0%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%A8%E0%A6%BE-%E0%A6%B8%E0%A6%AE%E0%A7%9F-%E0%A7%A9-%E0%A6%A6%E0%A6%BF%E0%A6%A8">নিউজ ২৪</source>

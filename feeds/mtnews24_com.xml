    <item>
      <title>‘ভেঙে পড়ছে সৌদি আরব’</title>
      <link>https://bn.mtnews24.com/antorjatik/582529/%E2%80%98%E0%A6%AD%E0%A7%87%E0%A6%99%E0%A7%87-%E0%A6%AA%E0%A7%9C%E0%A6%9B%E0%A7%87-%E0%A6%B8%E0%A7%8C%E0%A6%A6%E0%A6%BF-%E0%A6%86%E0%A6%B0%E0%A6%AC%E2%80%99</link>
      <guid isPermaLink="true">https://bn.mtnews24.com/antorjatik/582529/%E2%80%98%E0%A6%AD%E0%A7%87%E0%A6%99%E0%A7%87-%E0%A6%AA%E0%A7%9C%E0%A6%9B%E0%A7%87-%E0%A6%B8%E0%A7%8C%E0%A6%A6%E0%A6%BF-%E0%A6%86%E0%A6%B0%E0%A6%AC%E2%80%99</guid>
      <pubDate>Sun, 15 Nov 2026 18:11:23 +0600</pubDate>
      <enclosure url="https://bn.mtnews24.com/uploads/1776396842.webp" length="0" type="image/jpeg" />
      <media:content url="https://bn.mtnews24.com/uploads/1776396842.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bn.mtnews24.com/uploads/1776396842.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘ভেঙে পড়ছে সৌদি আরব’" /&gt;&lt;/p&gt;&lt;p&gt;আন্তর্জাতিক ডেস্ক : সৌদি আরবের বর্তমান পরিস্থিতি নিয়ে নেতিবাচক মন্তব্য করেছেন যুক্তরাষ্ট্রের প্রেসিডেন্ট ডোনাল্ড ট্রাম্প। তার দাবি, সৌদি আরব ‘ভেঙে পড়ছে’। ইরানের বিরুদ্ধে সামরিক অভিযান আরও জোরদার না করতে সৌদি&lt;/p&gt;</description>
      <source url="https://bn.mtnews24.com/antorjatik/582529/%E2%80%98%E0%A6%AD%E0%A7%87%E0%A6%99%E0%A7%87-%E0%A6%AA%E0%A7%9C%E0%A6%9B%E0%A7%87-%E0%A6%B8%E0%A7%8C%E0%A6%A6%E0%A6%BF-%E0%A6%86%E0%A6%B0%E0%A6%AC%E2%80%99">নিউজ ২৪</source>

      <guid isPermaLink="true">https://bn.mtnews24.com/chadpur/581993/%E0%A6%9B%E0%A7%8B%E0%A6%9F-%E0%A6%AD%E0%A6%BE%E0%A6%87%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%B2%E0%A6%BE%E0%A6%B6-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A7%87-%E0%A6%AC%E0%A7%9C-%E0%A6%AD%E0%A6%BE%E0%A6%87%E0%A7%9F%E0%A7%87%E0%A6%B0%E0%A6%93-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81-%E0%A6%8F%E0%A6%B2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%B6%E0%A7%8B%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%9B%E0%A6%BE%E0%A7%9F%E0%A6%BE</guid>
      <pubDate>Mon, 09 Nov 2026 23:11:39 +0600</pubDate>
      <enclosure url="https://bn.mtnews24.com/uploads/1794246517.webp" length="0" type="image/jpeg" />
      <media:content url="https://bn.mtnews24.com/uploads/1794246517.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bn.mtnews24.com/uploads/1794246517.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ছোট ভাইয়ের লাশ দেখে বড় ভাইয়েরও মৃত্যু, এলাকায় শোকের ছায়া" /&gt;&lt;/p&gt;&lt;p&gt;এমটিনিউজ ডেস্ক : চাঁদপুরের মতলবে ছোট ভাইয়ের লাশ দেখে বড় ভাইয়েরও মৃত্যু হয়েছে। সোমবার (৯ নভেম্বর) পৌরসভার নবকলস এলাকার খান বাড়িতে এ ঘটনা ঘটে। মাত্র ৫ ঘণ্টার ব্যবধানে দুই সহোদর&lt;/p&gt;</description>
      <source url="https://bn.mtnews24.com/chadpur/581993/%E0%A6%9B%E0%A7%8B%E0%A6%9F-%E0%A6%AD%E0%A6%BE%E0%A6%87%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%B2%E0%A6%BE%E0%A6%B6-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A7%87-%E0%A6%AC%E0%A7%9C-%E0%A6%AD%E0%A6%BE%E0%A6%87%E0%A7%9F%E0%A7%87%E0%A6%B0%E0%A6%93-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81-%E0%A6%8F%E0%A6%B2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%B6%E0%A7%8B%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%9B%E0%A6%BE%E0%A7%9F%E0%A6%BE">নিউজ ২৪</source>
    </item>

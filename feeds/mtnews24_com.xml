      <pubDate>Sat, 28 Nov 2026 14:11:22 +0600</pubDate>
      <enclosure url="https://bn.mtnews24.com/uploads/1743505463.webp" length="0" type="image/jpeg" />
      <media:content url="https://bn.mtnews24.com/uploads/1743505463.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bn.mtnews24.com/uploads/1743505463.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শেখ হাসিনাকে নিয়ে মহিলা লীগ নেত্রীর অডিও ভাইরাল" /&gt;&lt;/p&gt;&lt;p&gt;এমটিনিউজ ডেস্ক : অডিওতে মোবাইলে এক নারীর সঙ্গে কথা বলতে শোনা যাচ্ছে মাহমুদা বেগমকে। সেখানে হাসিনার বিরুদ্ধে নানা অভিযোগ তুলেছেন মহিলা লীগের এই নেত্রী। তবে ভিডিওটি স্বাধীনভাবে যাচাই করতে পারেনি&lt;/p&gt;</description>
      <source url="https://bn.mtnews24.com/jatio/583659/%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AE%E0%A6%B9%E0%A6%BF%E0%A6%B2%E0%A6%BE-%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%85%E0%A6%A1%E0%A6%BF%E0%A6%93-%E0%A6%AD%E0%A6%BE%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%B2">নিউজ ২৪</source>
    </item>
    <item>

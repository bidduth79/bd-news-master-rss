    <item>
      <title>‘সোহেল স্কয়ার রিসোর্ট’-এ ওই গোপন বৈঠকটি হয়, পুলিশ প্রশাসনে তোলপাড়</title>
      <link>https://bn.mtnews24.com/jatio/582339/%E2%80%98%E0%A6%B8%E0%A7%8B%E0%A6%B9%E0%A7%87%E0%A6%B2-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A6%BF%E0%A6%B8%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%9F%E2%80%99-%E0%A6%8F-%E0%A6%93%E0%A6%87-%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%A8-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95%E0%A6%9F%E0%A6%BF-%E0%A6%B9%E0%A7%9F-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B6%E0%A6%BE%E0%A6%B8%E0%A6%A8%E0%A7%87-%E0%A6%A4%E0%A7%8B%E0%A6%B2%E0%A6%AA%E0%A6%BE%E0%A7%9C</link>
      <guid isPermaLink="true">https://bn.mtnews24.com/jatio/582339/%E2%80%98%E0%A6%B8%E0%A7%8B%E0%A6%B9%E0%A7%87%E0%A6%B2-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A6%BF%E0%A6%B8%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%9F%E2%80%99-%E0%A6%8F-%E0%A6%93%E0%A6%87-%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%A8-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95%E0%A6%9F%E0%A6%BF-%E0%A6%B9%E0%A7%9F-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B6%E0%A6%BE%E0%A6%B8%E0%A6%A8%E0%A7%87-%E0%A6%A4%E0%A7%8B%E0%A6%B2%E0%A6%AA%E0%A6%BE%E0%A7%9C</guid>
      <pubDate>Fri, 13 Nov 2026 18:11:23 +0600</pubDate>
      <enclosure url="https://bn.mtnews24.com/uploads/1794574162.webp" length="0" type="image/jpeg" />
      <media:content url="https://bn.mtnews24.com/uploads/1794574162.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bn.mtnews24.com/uploads/1794574162.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘সোহেল স্কয়ার রিসোর্ট’-এ ওই গোপন বৈঠকটি হয়, পুলিশ প্রশাসনে তোলপাড়" /&gt;&lt;/p&gt;&lt;p&gt;এমটিনিউজ ডেস্ক : রঞ্জিত সরকার। সুনামগঞ্জ-১ আসনের সাবেক সংসদ-সদস্য ও সিলেট জেলা আওয়ামী লীগের (কার্যক্রম নিষিদ্ধ) সাংগঠনিক সম্পাদক তিনি। ৫ আগস্টের পর আত্মগোপনে থাকা কার্যক্রম নিষিদ্ধ রাজনৈতিক দলের এই নেতা&lt;/p&gt;</description>
      <source url="https://bn.mtnews24.com/jatio/582339/%E2%80%98%E0%A6%B8%E0%A7%8B%E0%A6%B9%E0%A7%87%E0%A6%B2-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A6%BF%E0%A6%B8%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%9F%E2%80%99-%E0%A6%8F-%E0%A6%93%E0%A6%87-%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%A8-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95%E0%A6%9F%E0%A6%BF-%E0%A6%B9%E0%A7%9F-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B6%E0%A6%BE%E0%A6%B8%E0%A6%A8%E0%A7%87-%E0%A6%A4%E0%A7%8B%E0%A6%B2%E0%A6%AA%E0%A6%BE%E0%A7%9C">নিউজ ২৪</source>

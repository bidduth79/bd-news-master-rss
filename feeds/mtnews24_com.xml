    <item>
      <title>ফাঁস শেখ হাসিনাকে দেওয়া যে মেসেজ</title>
      <link>https://bn.mtnews24.com/jatio/582887/%E0%A6%AB%E0%A6%BE%E0%A6%81%E0%A6%B8-%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%AF%E0%A7%87-%E0%A6%AE%E0%A7%87%E0%A6%B8%E0%A7%87%E0%A6%9C</link>
      <guid isPermaLink="true">https://bn.mtnews24.com/jatio/582887/%E0%A6%AB%E0%A6%BE%E0%A6%81%E0%A6%B8-%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%AF%E0%A7%87-%E0%A6%AE%E0%A7%87%E0%A6%B8%E0%A7%87%E0%A6%9C</guid>
      <pubDate>Thu, 19 Nov 2026 23:11:52 +0600</pubDate>
      <enclosure url="https://bn.mtnews24.com/uploads/1726993977.webp" length="0" type="image/jpeg" />
      <media:content url="https://bn.mtnews24.com/uploads/1726993977.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bn.mtnews24.com/uploads/1726993977.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফাঁস শেখ হাসিনাকে দেওয়া যে মেসেজ" /&gt;&lt;/p&gt;&lt;p&gt;এমটিনিউজ ডেস্ক : সাবেক শিক্ষামন্ত্রী নুরুল ইসলাম নাহিদ চেষ্টা করেছিলেন ক্ষমতাচ্যুত প্রধানমন্ত্রী শেখ হাসিনার সঙ্গে যোগাযোগ করার। এজন্য হোয়াটসঅ্যাপে বার্তা পাঠানোর পাশাপাশি একাধিকবার কলও করেন তিনি। কিন্তু শেখ হাসিনা কোনো&lt;/p&gt;</description>
      <source url="https://bn.mtnews24.com/jatio/582887/%E0%A6%AB%E0%A6%BE%E0%A6%81%E0%A6%B8-%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%AF%E0%A7%87-%E0%A6%AE%E0%A7%87%E0%A6%B8%E0%A7%87%E0%A6%9C">নিউজ ২৪</source>
    </item>

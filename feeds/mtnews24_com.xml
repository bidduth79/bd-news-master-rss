      <enclosure url="https://bn.mtnews24.com/uploads/1752852126.webp" length="0" type="image/jpeg" />
      <media:content url="https://bn.mtnews24.com/uploads/1752852126.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bn.mtnews24.com/uploads/1752852126.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘শেখ হাসিনাকে ফেরত না দিলে আন্তর্জাতিক আদালতে যাবে বাংলাদেশ’" /&gt;&lt;/p&gt;&lt;p&gt;এমটিনিউজ ডেস্ক : ভারতের কাছ থেকে ক্ষমতাচ্যুত প্রধানমন্ত্রী শেখ হাসিনাকে ফেরত না পেলে আন্তর্জাতিক বিচার আদালতে (আইসিজে) যাওয়ার হুঁশিয়ারি দিয়েছেন জাতীয় সংসদের স্পিকার হাফিজ উদ্দিন আহমদ।

পাকিস্তান সফরে গিয়ে বৃহস্পতিবার (২৬&lt;/p&gt;</description>
      <source url="https://bn.mtnews24.com/jatio/583587/%E2%80%98%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%A4-%E0%A6%A8%E0%A6%BE-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%87-%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%86%E0%A6%A6%E0%A6%BE%E0%A6%B2%E0%A6%A4%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E2%80%99">নিউজ ২৪</source>

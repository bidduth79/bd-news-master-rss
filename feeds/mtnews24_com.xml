    <item>
      <title>আবারও বাড়ল জ্বালানি তেলের দাম</title>
      <link>https://bn.mtnews24.com/antorjatik/583579/%E0%A6%86%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A6%93-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%B2-%E0%A6%9C%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%A4%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE</link>
      <guid isPermaLink="true">https://bn.mtnews24.com/antorjatik/583579/%E0%A6%86%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A6%93-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%B2-%E0%A6%9C%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%A4%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE</guid>
      <pubDate>Fri, 27 Nov 2026 11:11:08 +0600</pubDate>
      <enclosure url="https://bn.mtnews24.com/uploads/1679980250.webp" length="0" type="image/jpeg" />
      <media:content url="https://bn.mtnews24.com/uploads/1679980250.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bn.mtnews24.com/uploads/1679980250.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আবারও বাড়ল জ্বালানি তেলের দাম" /&gt;&lt;/p&gt;&lt;p&gt;আন্তর্জাতিক ডেস্ক : মধ্যপ্রাচ্যে চলমান সংঘাতের জেরে আন্তর্জাতিক বাজারে জ্বালানি তেলের সরবরাহ নিয়ে উদ্বেগ বাড়ছে। বার্তা সংস্থা রয়টার্স জানিয়েছে, হরমুজ প্রণালিতে তেলবাহী জাহাজে হামলা এবং সৌদি আরবের জ্বালানি অবকাঠামোতে আঘাতের&lt;/p&gt;</description>

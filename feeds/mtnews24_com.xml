    <item>
      <title>কীভাবে হবে ইউপি নির্বাচন, জানাল ইসি</title>
      <link>https://bn.mtnews24.com/jatio/581895/%E0%A6%95%E0%A7%80%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%B9%E0%A6%AC%E0%A7%87-%E0%A6%87%E0%A6%89%E0%A6%AA%E0%A6%BF-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%9A%E0%A6%A8-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B2-%E0%A6%87%E0%A6%B8%E0%A6%BF</link>

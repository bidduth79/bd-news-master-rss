      <pubDate>Sun, 08 Nov 2026 23:11:23 +0600</pubDate>
      <enclosure url="https://bn.mtnews24.com/uploads/1794160402.webp" length="0" type="image/jpeg" />
      <media:content url="https://bn.mtnews24.com/uploads/1794160402.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bn.mtnews24.com/uploads/1794160402.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এক ছেলেকে কবরে শায়িত করে আরেক ছেলের আইসিইউর সামনে বাবা-মা" /&gt;&lt;/p&gt;&lt;p&gt;এমটিনিউজ ডেস্ক : চট্টগ্রামে ডেঙ্গুতে আক্রান্ত হয়ে মোহাম্মদ আরাফাত (১০) নামে এক শিশুর মৃত্যু হয়েছে গত শুক্রবার। একই রোগে আক্রান্ত হয়ে তার ছোট ভাই মোহাম্মদ আবু বক্করও (১০ মাস) এখন&lt;/p&gt;</description>
      <source url="https://bn.mtnews24.com/jatio/581915/%E0%A6%8F%E0%A6%95-%E0%A6%9B%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A6%AC%E0%A6%B0%E0%A7%87-%E0%A6%B6%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A6%BF%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%9B%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%87%E0%A6%B8%E0%A6%BF%E0%A6%87%E0%A6%89%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A6%BE-%E0%A6%AE%E0%A6%BE">নিউজ ২৪</source>
    </item>

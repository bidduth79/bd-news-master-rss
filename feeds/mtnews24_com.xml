      <enclosure url="https://bn.mtnews24.com/uploads/1712033719.webp" length="0" type="image/jpeg" />
      <media:content url="https://bn.mtnews24.com/uploads/1712033719.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bn.mtnews24.com/uploads/1712033719.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="১১ নির্দেশনা এইচএসসি সাপ্লিমেন্টারি পরীক্ষার্থীদের জন্য" /&gt;&lt;/p&gt;&lt;p&gt;এমটিনিউজ ডেস্ক : ২০২৬ সালের ও সমমানের সাপ্লিমেন্টারি পরীক্ষার সময়সূচি প্রকাশ করেছে আন্তশিক্ষা বোর্ড পরীক্ষা নিয়ন্ত্রক কমিটি। প্রকাশিত রুটিন অনুযায়ী, আগামী ১ ডিসেম্বর থেকে পরীক্ষা শুরু হয়ে চলবে ১৫ ডিসেম্বর&lt;/p&gt;</description>
      <source url="https://bn.mtnews24.com/jatio/582293/%E0%A7%A7%E0%A7%A7-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%A8%E0%A6%BE-%E0%A6%8F%E0%A6%87%E0%A6%9A%E0%A6%8F%E0%A6%B8%E0%A6%B8%E0%A6%BF-%E0%A6%B8%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A6%BF%E0%A6%AE%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF">নিউজ ২৪</source>

      <guid isPermaLink="true">https://bn.mtnews24.com/kheladhula/583651/%E0%A6%A8%E0%A6%BF%E0%A6%9C-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AB%E0%A7%81%E0%A6%9F%E0%A6%AC%E0%A6%B0-%E0%A6%AB%E0%A7%87%E0%A6%A1%E0%A6%BE%E0%A6%B0%E0%A6%B6%E0%A7%87%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A6%86%E0%A6%87%E0%A6%A8%E0%A6%BF-%E0%A6%9A%E0%A6%BF%E0%A6%A0%E0%A6%BF-%E0%A6%AE%E0%A7%87%E0%A6%B8%E0%A6%BF%E0%A6%B0</guid>

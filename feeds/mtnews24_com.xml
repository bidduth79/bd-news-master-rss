      <title>'বাইরে আওয়ামী লীগের লোকজন চিৎকার-চেঁচামেচি করেছে'</title>
      <link>https://bn.mtnews24.com/jatio/582557/-%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%B2%E0%A7%8B%E0%A6%95%E0%A6%9C%E0%A6%A8-%E0%A6%9A%E0%A6%BF%E0%A7%8E%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%9A%E0%A7%87%E0%A6%81%E0%A6%9A%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%9A%E0%A6%BF-%E0%A6%95%E0%A6%B0%E0%A7%87%E0%A6%9B%E0%A7%87-</link>
      <guid isPermaLink="true">https://bn.mtnews24.com/jatio/582557/-%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%B2%E0%A7%8B%E0%A6%95%E0%A6%9C%E0%A6%A8-%E0%A6%9A%E0%A6%BF%E0%A7%8E%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%9A%E0%A7%87%E0%A6%81%E0%A6%9A%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%9A%E0%A6%BF-%E0%A6%95%E0%A6%B0%E0%A7%87%E0%A6%9B%E0%A7%87-</guid>
      <pubDate>Mon, 16 Nov 2026 00:11:51 +0600</pubDate>
      <enclosure url="https://bn.mtnews24.com/uploads/1794767149.webp" length="0" type="image/jpeg" />
      <media:content url="https://bn.mtnews24.com/uploads/1794767149.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bn.mtnews24.com/uploads/1794767149.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="'বাইরে আওয়ামী লীগের লোকজন চিৎকার-চেঁচামেচি করেছে'" /&gt;&lt;/p&gt;&lt;p&gt;এমটিনিউজ ডেস্ক : যুক্তরাজ্যের কেমব্রিজ বিশ্ববিদ্যালয় ক্যাম্পাসে জাতীয় নাগরিক পার্টির (এনসিপি) আহ্বায়ক ও বিরোধীদলীয় চিফ হুইপ নাহিদ ইসলামকে হেনস্তার চেষ্টা করেছেন আওয়ামী লীগের একদল কর্মী-সমর্থক। তবে এনসিপির যুক্তরাজ্য শাখার নেতাকর্মীদের&lt;/p&gt;</description>
      <source url="https://bn.mtnews24.com/jatio/582557/-%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%B2%E0%A7%8B%E0%A6%95%E0%A6%9C%E0%A6%A8-%E0%A6%9A%E0%A6%BF%E0%A7%8E%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%9A%E0%A7%87%E0%A6%81%E0%A6%9A%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%9A%E0%A6%BF-%E0%A6%95%E0%A6%B0%E0%A7%87%E0%A6%9B%E0%A7%87-">নিউজ ২৪</source>
    </item>

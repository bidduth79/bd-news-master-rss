    <item>
      <title>বুধবার টানা ৯ ঘণ্টা বিদ্যুৎ থাকবে না যেসব এলাকায়</title>
      <link>https://orthosongbad.com/425244/%e0%a6%ac%e0%a7%81%e0%a6%a7%e0%a6%ac%e0%a6%be%e0%a6%b0-%e0%a6%9f%e0%a6%be%e0%a6%a8%e0%a6%be-%e0%a7%af-%e0%a6%98%e0%a6%a3%e0%a7%8d%e0%a6%9f%e0%a6%be-%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%af/</link>

    <item>
      <title>দুদকের ৭ কর্মকর্তা পরিচালক পদে পদোন্নতি পেলেন</title>
      <link>https://orthosongbad.com/425734/%e0%a6%a6%e0%a7%81%e0%a6%a6%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a7%ad-%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%a4%e0%a6%be-%e0%a6%aa%e0%a6%b0%e0%a6%bf%e0%a6%9a%e0%a6%be/</link>

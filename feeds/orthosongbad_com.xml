    <item>
      <title>দেশের ব্যাংক খাতে মোট ঋণের ৩৩.৮০ শতাংশই খেলাপি</title>
      <link>https://orthosongbad.com/427789/%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%87%e0%a6%b0-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95-%e0%a6%96%e0%a6%be%e0%a6%a4%e0%a7%87-%e0%a6%ae%e0%a7%8b%e0%a6%9f-%e0%a6%8b%e0%a6%a3%e0%a7%87/</link>

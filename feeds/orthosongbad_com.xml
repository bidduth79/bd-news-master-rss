    <item>
      <title>হামের উপসর্গে একদিনে ৯ মৃত্যু, দুই মাসের মধ্যে সর্বোচ্চ</title>
      <link>https://orthosongbad.com/427622/%e0%a6%b9%e0%a6%be%e0%a6%ae%e0%a7%87%e0%a6%b0-%e0%a6%89%e0%a6%aa%e0%a6%b8%e0%a6%b0%e0%a7%8d%e0%a6%97%e0%a7%87-%e0%a6%8f%e0%a6%95%e0%a6%a6%e0%a6%bf%e0%a6%a8%e0%a7%87-%e0%a7%af-%e0%a6%ae%e0%a7%83/</link>
      <guid isPermaLink="true">https://orthosongbad.com/427622/%e0%a6%b9%e0%a6%be%e0%a6%ae%e0%a7%87%e0%a6%b0-%e0%a6%89%e0%a6%aa%e0%a6%b8%e0%a6%b0%e0%a7%8d%e0%a6%97%e0%a7%87-%e0%a6%8f%e0%a6%95%e0%a6%a6%e0%a6%bf%e0%a6%a8%e0%a7%87-%e0%a7%af-%e0%a6%ae%e0%a7%83/</guid>
      <pubDate>Sun, 22 Nov 2026 09:57:12 +0000</pubDate>
      <description>দেশে হামের উপসর্গ নিয়ে এক দিনে আরও ৯ জনের মৃত্যু হয়েছে। গত দুই মাসের মধ্যে এক দিনে এটিই সর্বোচ্চ মৃত্যুর ঘটনা। এ নিয়ে এখন পর্যন্ত দেশে হামের উপসর্গে মোট মৃত্যুর সংখ্যা দাঁড়িয়েছে ১ হাজার ৩৫২ জনে। রোববার (২২ নভেম্বর) স্বাস্থ্য অধিদপ্তরের হেলথ ইমার্জেন্সি অপারেশন সেন্টার ও কন্ট্রোল রুম থেকে পাঠানো হাম </description>
      <source url="https://orthosongbad.com/427622/%e0%a6%b9%e0%a6%be%e0%a6%ae%e0%a7%87%e0%a6%b0-%e0%a6%89%e0%a6%aa%e0%a6%b8%e0%a6%b0%e0%a7%8d%e0%a6%97%e0%a7%87-%e0%a6%8f%e0%a6%95%e0%a6%a6%e0%a6%bf%e0%a6%a8%e0%a7%87-%e0%a7%af-%e0%a6%ae%e0%a7%83/">অর্থসংবাদ</source>
    </item>
    <item>
      <title>লেনদেনের শীর্ষে আই পি ডি সি ফাইন্যান্স</title>
      <link>https://orthosongbad.com/427615/%e0%a6%b2%e0%a7%87%e0%a6%a8%e0%a6%a6%e0%a7%87%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%b6%e0%a7%80%e0%a6%b0%e0%a7%8d%e0%a6%b7%e0%a7%87-%e0%a6%86%e0%a6%87-%e0%a6%aa%e0%a6%bf-%e0%a6%a1%e0%a6%bf-%e0%a6%b8-7/</link>
      <guid isPermaLink="true">https://orthosongbad.com/427615/%e0%a6%b2%e0%a7%87%e0%a6%a8%e0%a6%a6%e0%a7%87%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%b6%e0%a7%80%e0%a6%b0%e0%a7%8d%e0%a6%b7%e0%a7%87-%e0%a6%86%e0%a6%87-%e0%a6%aa%e0%a6%bf-%e0%a6%a1%e0%a6%bf-%e0%a6%b8-7/</guid>
      <pubDate>Sun, 22 Nov 2026 09:48:36 +0000</pubDate>
      <description>সপ্তাহের প্রথম কার্যদিবসে প্রধান শেয়ারবাজার ঢাকা স্টক এক্সচেঞ্জে (ডিএসই) লেনদেন শেষে তালিকায় শীর্ষে উঠে এসেছে আই পি ডি সি ফাইন্যান্স পিএলসি। ঢাকা স্টক এক্সচেঞ্জ (ডিএসই) সূত্রে এ তথ্য জানা গেছে। রোববার (২২ নভেম্বর) ডিএসইতে সবোর্চ্চ আই পি ডি সি ফাইন্যান্স পিএলসির ৫৮ কোটি ৮৯ লাখ ১২ হাজার টাকার শেয়ার লে</description>
      <source url="https://orthosongbad.com/427615/%e0%a6%b2%e0%a7%87%e0%a6%a8%e0%a6%a6%e0%a7%87%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%b6%e0%a7%80%e0%a6%b0%e0%a7%8d%e0%a6%b7%e0%a7%87-%e0%a6%86%e0%a6%87-%e0%a6%aa%e0%a6%bf-%e0%a6%a1%e0%a6%bf-%e0%a6%b8-7/">অর্থসংবাদ</source>
    </item>
    <item>
      <title>জুলাই-আগস্টের মানবতাবিরোধী অপরাধ: আমুসহ ছয়জন কারাগারে</title>
      <link>https://orthosongbad.com/427616/%e0%a6%9c%e0%a7%81%e0%a6%b2%e0%a6%be%e0%a6%87-%e0%a6%86%e0%a6%97%e0%a6%b8%e0%a7%8d%e0%a6%9f%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a6%ac%e0%a6%a4%e0%a6%be%e0%a6%ac%e0%a6%bf%e0%a6%b0%e0%a7%8b/</link>

    </item>
    <item>
      <title>৯ মাসে বিদেশে গেছেন প্রায় ৫ লাখ কর্মী, দক্ষ ৩ লাখ ৪০ হাজার</title>
      <link>https://orthosongbad.com/427786/%e0%a7%af-%e0%a6%ae%e0%a6%be%e0%a6%b8%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%87-%e0%a6%97%e0%a7%87%e0%a6%9b%e0%a7%87%e0%a6%a8-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%af/</link>

    <item>
      <title>যমুনা অয়েলের ১২০ শতাংশ লভ্যাংশ ঘোষণা</title>
      <link>https://orthosongbad.com/424517/%e0%a6%af%e0%a6%ae%e0%a7%81%e0%a6%a8%e0%a6%be-%e0%a6%85%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a7%a7%e0%a7%a8%e0%a7%a6-%e0%a6%b6%e0%a6%a4%e0%a6%be%e0%a6%82%e0%a6%b6-%e0%a6%b2/</link>
      <guid isPermaLink="true">https://orthosongbad.com/424517/%e0%a6%af%e0%a6%ae%e0%a7%81%e0%a6%a8%e0%a6%be-%e0%a6%85%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a7%a7%e0%a7%a8%e0%a7%a6-%e0%a6%b6%e0%a6%a4%e0%a6%be%e0%a6%82%e0%a6%b6-%e0%a6%b2/</guid>
      <pubDate>Sun, 08 Nov 2026 13:28:34 +0000</pubDate>
      <description>শেয়ারবাজারে তালিকাভুক্ত জ্বালানি খাতের কোম্পানি যমুনা অয়েল পিএলসি গত ৩০ জুন, ২০২৬ তারিখে সমাপ্ত হিসাববছরের জন্য লভ্যাংশ ঘোষণা করেছে। কোম্পানিটি আলোচিত বছরের জন্য শেয়ারহোল্ডারদের ১২০ শতাংশ নগদ লভ্যাংশ দেবে। রোববার (৮ নভেম্বর) অনুষ্ঠিত কোম্পানি পরিচালনা পর্ষদের বৈঠকে সর্বশেষ হিসাববছরের নিরীক্ষিত আর্থি</description>
      <source url="https://orthosongbad.com/424517/%e0%a6%af%e0%a6%ae%e0%a7%81%e0%a6%a8%e0%a6%be-%e0%a6%85%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a7%a7%e0%a7%a8%e0%a7%a6-%e0%a6%b6%e0%a6%a4%e0%a6%be%e0%a6%82%e0%a6%b6-%e0%a6%b2/">অর্থসংবাদ</source>
    </item>
    <item>
      <title>এনভয় টেক্সটাইলসের প্রথম প্রান্তিক প্রকাশ</title>
      <link>https://orthosongbad.com/424514/%e0%a6%8f%e0%a6%a8%e0%a6%ad%e0%a6%af%e0%a6%bc-%e0%a6%9f%e0%a7%87%e0%a6%95%e0%a7%8d%e0%a6%b8%e0%a6%9f%e0%a6%be%e0%a6%87%e0%a6%b2%e0%a6%b8%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a5%e0%a6%ae/</link>

    <item>
      <title>কপ-৩১ সম্মেলনে তারেক রহমানকে ঘিরে বিশ্বনেতাদের কূটনৈতিক আগ্রহ</title>
      <link>https://orthosongbad.com/425477/%e0%a6%95%e0%a6%aa-%e0%a7%a9%e0%a7%a7-%e0%a6%b8%e0%a6%ae%e0%a7%8d%e0%a6%ae%e0%a7%87%e0%a6%b2%e0%a6%a8%e0%a7%87-%e0%a6%a4%e0%a6%be%e0%a6%b0%e0%a7%87%e0%a6%95-%e0%a6%b0%e0%a6%b9%e0%a6%ae%e0%a6%be/</link>

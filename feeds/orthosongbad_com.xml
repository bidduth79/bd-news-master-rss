    <item>
      <title>বাংলাদেশকে তাঁবেদার রাষ্ট্র হতে দেওয়া হবে না: প্রধানমন্ত্রী</title>
      <link>https://orthosongbad.com/427471/%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a6%95%e0%a7%87-%e0%a6%a4%e0%a6%be%e0%a6%81%e0%a6%ac%e0%a7%87%e0%a6%a6%e0%a6%be%e0%a6%b0-%e0%a6%b0%e0%a6%be%e0%a6%b7%e0%a7%8d/</link>
      <guid isPermaLink="true">https://orthosongbad.com/427471/%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a6%95%e0%a7%87-%e0%a6%a4%e0%a6%be%e0%a6%81%e0%a6%ac%e0%a7%87%e0%a6%a6%e0%a6%be%e0%a6%b0-%e0%a6%b0%e0%a6%be%e0%a6%b7%e0%a7%8d/</guid>
      <pubDate>Sat, 21 Nov 2026 13:23:46 +0000</pubDate>
      <description>দেশপ্রেমিক জনগণ, জনগণের কাছে দায়বদ্ধ জবাবদিহিমূলক গণতান্ত্রিক সরকার এবং সশস্ত্র বাহিনীর মধ্যে ‘সবার আগে বাংলাদেশ’ চেতনা জাগ্রত থাকলে বাংলাদেশকে আর কেউ কখনো তাঁবেদার রাষ্ট্রে পরিণত করার সাহস পাবে না বলে মন্তব্য করেছেন প্রধানমন্ত্রী তারেক রহমান। শনিবার সন্ধ্যায় ঢাকা ক্যান্টনমেন্টে সশস্ত্র বাহিনী দিব</description>
      <source url="https://orthosongbad.com/427471/%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a6%95%e0%a7%87-%e0%a6%a4%e0%a6%be%e0%a6%81%e0%a6%ac%e0%a7%87%e0%a6%a6%e0%a6%be%e0%a6%b0-%e0%a6%b0%e0%a6%be%e0%a6%b7%e0%a7%8d/">অর্থসংবাদ</source>
    </item>
    <item>
      <title>চৌদ্দগ্রামে মাদকবিরোধী সেমিনারে বক্তারা</title>
      <link>https://orthosongbad.com/427467/%e0%a6%9a%e0%a7%8c%e0%a6%a6%e0%a7%8d%e0%a6%a6%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ae%e0%a7%87-%e0%a6%ae%e0%a6%be%e0%a6%a6%e0%a6%95%e0%a6%ac%e0%a6%bf%e0%a6%b0%e0%a7%8b%e0%a6%a7%e0%a7%80-%e0%a6%b8/</link>

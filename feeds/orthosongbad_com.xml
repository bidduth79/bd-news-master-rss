    <item>
      <title>গার্মেন্টস শ্রমিকদের নিম্নতম মজুরি নির্ধারণে কাল বসছে মজুরি বোর্ড</title>
      <link>https://orthosongbad.com/424542/%e0%a6%97%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a7%87%e0%a6%a8%e0%a7%8d%e0%a6%9f%e0%a6%b8-%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a6%ae%e0%a6%bf%e0%a6%95%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a6%bf%e0%a6%ae/</link>

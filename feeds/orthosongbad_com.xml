    <item>
      <title>সিকিমে ৫.৩ মাত্রার ভূমিকম্প, কেঁপে উঠল বাংলাদেশের উত্তরাঞ্চল</title>
      <link>https://orthosongbad.com/427942/%e0%a6%b8%e0%a6%bf%e0%a6%95%e0%a6%bf%e0%a6%ae%e0%a7%87-%e0%a7%ab-%e0%a7%a9-%e0%a6%ae%e0%a6%be%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%b0-%e0%a6%ad%e0%a7%82%e0%a6%ae%e0%a6%bf%e0%a6%95%e0%a6%ae/</link>
      <guid isPermaLink="true">https://orthosongbad.com/427942/%e0%a6%b8%e0%a6%bf%e0%a6%95%e0%a6%bf%e0%a6%ae%e0%a7%87-%e0%a7%ab-%e0%a7%a9-%e0%a6%ae%e0%a6%be%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%b0-%e0%a6%ad%e0%a7%82%e0%a6%ae%e0%a6%bf%e0%a6%95%e0%a6%ae/</guid>
      <pubDate>Tue, 24 Nov 2026 04:50:31 +0000</pubDate>
      <description>ঠাকুরগাঁও, পঞ্চগড়সহ দেশের উত্তরাঞ্চলের বিভিন্ন জেলায় ভূমিকম্প অনুভূত হয়েছে। মঙ্গলবার (২৪ নভেম্বর) সকাল ৭টা ৩২ মিনিটের দিকে আঘাত হানা এ ভূমিকম্পের মাত্রা ছিল রিখটার স্কেলে ৫ দশমিক ৩। বাংলাদেশ ছাড়াও ভারত, নেপাল, ভুটান ও চীনের বিভিন্ন অঞ্চলে কম্পন অনুভূত হয়েছে। হঠাৎ ভূমিকম্পে অনেকের ঘুম ভেঙে যায়। আতঙ্ক</description>
      <source url="https://orthosongbad.com/427942/%e0%a6%b8%e0%a6%bf%e0%a6%95%e0%a6%bf%e0%a6%ae%e0%a7%87-%e0%a7%ab-%e0%a7%a9-%e0%a6%ae%e0%a6%be%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%b0-%e0%a6%ad%e0%a7%82%e0%a6%ae%e0%a6%bf%e0%a6%95%e0%a6%ae/">অর্থসংবাদ</source>
    </item>
    <item>
      <title>দিনে কতটুকু রান্নার তেল খাওয়া স্বাস্থ্যকর?</title>
      <link>https://orthosongbad.com/427938/%e0%a6%a6%e0%a6%bf%e0%a6%a8%e0%a7%87-%e0%a6%95%e0%a6%a4%e0%a6%9f%e0%a7%81%e0%a6%95%e0%a7%81-%e0%a6%b0%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a8%e0%a6%be%e0%a6%b0-%e0%a6%a4%e0%a7%87%e0%a6%b2-%e0%a6%96/</link>

    <item>
      <title>গোসল না করলে কি জুমার নামাজ হবে, কী বলছেন আলেমরা</title>
      <link>https://orthosongbad.com/428663/%e0%a6%97%e0%a7%8b%e0%a6%b8%e0%a6%b2-%e0%a6%a8%e0%a6%be-%e0%a6%95%e0%a6%b0%e0%a6%b2%e0%a7%87-%e0%a6%95%e0%a6%bf-%e0%a6%9c%e0%a7%81%e0%a6%ae%e0%a6%be%e0%a6%b0-%e0%a6%a8%e0%a6%be%e0%a6%ae%e0%a6%be/</link>

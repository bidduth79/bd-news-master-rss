    <item>
      <title>গোপালগঞ্জে বিকাশ-নগদ-রকেটের অনেক হিসাব বন্ধ, লেনদেনে ভোগান্তি</title>
      <link>https://orthosongbad.com/428641/%e0%a6%97%e0%a7%8b%e0%a6%aa%e0%a6%be%e0%a6%b2%e0%a6%97%e0%a6%9e%e0%a7%8d%e0%a6%9c%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%95%e0%a6%be%e0%a6%b6-%e0%a6%a8%e0%a6%97%e0%a6%a6-%e0%a6%b0%e0%a6%95%e0%a7%87/</link>

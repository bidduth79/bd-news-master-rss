    <item>
      <title>৯০ দিনের জ্বালানি তেল মজুতের লক্ষ্য সরকারের</title>
      <link>https://orthosongbad.com/424628/%e0%a7%af%e0%a7%a6-%e0%a6%a6%e0%a6%bf%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%9c%e0%a7%8d%e0%a6%ac%e0%a6%be%e0%a6%b2%e0%a6%be%e0%a6%a8%e0%a6%bf-%e0%a6%a4%e0%a7%87%e0%a6%b2-%e0%a6%ae%e0%a6%9c%e0%a7%81/</link>
      <guid isPermaLink="true">https://orthosongbad.com/424628/%e0%a7%af%e0%a7%a6-%e0%a6%a6%e0%a6%bf%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%9c%e0%a7%8d%e0%a6%ac%e0%a6%be%e0%a6%b2%e0%a6%be%e0%a6%a8%e0%a6%bf-%e0%a6%a4%e0%a7%87%e0%a6%b2-%e0%a6%ae%e0%a6%9c%e0%a7%81/</guid>
      <pubDate>Mon, 09 Nov 2026 05:19:58 +0000</pubDate>
      <description>বৈশ্বিক জ্বালানি বাজারের অস্থিরতা এবং সম্ভাব্য সরবরাহ সংকট মোকাবিলায় দেশে জ্বালানি তেল সংরক্ষণের সক্ষমতা বাড়ানোর উদ্যোগ নিয়েছে সরকার। শিল্পকারখানার উৎপাদন সচল রাখা ও জ্বালানি নিরাপত্তা নিশ্চিত করতে বর্তমানে ৬০ দিনের মজুত সক্ষমতা ২০২৬ সালের ডিসেম্বরের মধ্যে ৭১ দিন এবং ২০২৭ সালের মধ্যে ৯০ দিনে উন্নীত </description>
      <source url="https://orthosongbad.com/424628/%e0%a7%af%e0%a7%a6-%e0%a6%a6%e0%a6%bf%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%9c%e0%a7%8d%e0%a6%ac%e0%a6%be%e0%a6%b2%e0%a6%be%e0%a6%a8%e0%a6%bf-%e0%a6%a4%e0%a7%87%e0%a6%b2-%e0%a6%ae%e0%a6%9c%e0%a7%81/">অর্থসংবাদ</source>
    </item>
    <item>
      <title>রাত ৩টায় ঘুম ভেঙে গেলে যে ৩টি কাজ করবেন না</title>
      <link>https://orthosongbad.com/424624/%e0%a6%b0%e0%a6%be%e0%a6%a4-%e0%a7%a9%e0%a6%9f%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%98%e0%a7%81%e0%a6%ae-%e0%a6%ad%e0%a7%87%e0%a6%99%e0%a7%87-%e0%a6%97%e0%a7%87%e0%a6%b2%e0%a7%87-%e0%a6%af%e0%a7%87/</link>
      <guid isPermaLink="true">https://orthosongbad.com/424624/%e0%a6%b0%e0%a6%be%e0%a6%a4-%e0%a7%a9%e0%a6%9f%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%98%e0%a7%81%e0%a6%ae-%e0%a6%ad%e0%a7%87%e0%a6%99%e0%a7%87-%e0%a6%97%e0%a7%87%e0%a6%b2%e0%a7%87-%e0%a6%af%e0%a7%87/</guid>
      <pubDate>Mon, 09 Nov 2026 05:12:47 +0000</pubDate>
      <description>মাঝরাতে হঠাৎ ঘুম ভেঙে গেল। ঘড়ির দিকে তাকিয়ে দেখলেন রাত ৩টা। এরপর ঘুমানোর বাকি সময় হিসাব করতে গিয়ে দুশ্চিন্তা শুরু করলেন, কিংবা ফোন হাতে নিয়ে সামাজিক যোগাযোগমাধ্যমে ঘুরে বেড়ালেন। অথচ এসব অভ্যাসই আবার ঘুমিয়ে পড়ার পথে বাধা হয়ে দাঁড়াতে পারে। ঘুম বিশেষজ্ঞদের মতে, মাঝরাতে ঘুম ভেঙে যাওয়া অস্বাভাবিক নয়। তবে</description>
      <source url="https://orthosongbad.com/424624/%e0%a6%b0%e0%a6%be%e0%a6%a4-%e0%a7%a9%e0%a6%9f%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%98%e0%a7%81%e0%a6%ae-%e0%a6%ad%e0%a7%87%e0%a6%99%e0%a7%87-%e0%a6%97%e0%a7%87%e0%a6%b2%e0%a7%87-%e0%a6%af%e0%a7%87/">অর্থসংবাদ</source>
    </item>
    <item>
      <title>শিল্পাঞ্চলের নিরাপত্তায় মাঠে বিজিবির ৩৪ প্লাটুন</title>
      <link>https://orthosongbad.com/424620/%e0%a6%b6%e0%a6%bf%e0%a6%b2%e0%a7%8d%e0%a6%aa%e0%a6%be%e0%a6%9e%e0%a7%8d%e0%a6%9a%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a6%bf%e0%a6%b0%e0%a6%be%e0%a6%aa%e0%a6%a4%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%af/</link>
      <guid isPermaLink="true">https://orthosongbad.com/424620/%e0%a6%b6%e0%a6%bf%e0%a6%b2%e0%a7%8d%e0%a6%aa%e0%a6%be%e0%a6%9e%e0%a7%8d%e0%a6%9a%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a6%bf%e0%a6%b0%e0%a6%be%e0%a6%aa%e0%a6%a4%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%af/</guid>
      <pubDate>Mon, 09 Nov 2026 05:05:47 +0000</pubDate>
      <description>পোশাকশ্রমিকদের চলমান অসন্তোষের মধ্যে শিল্পাঞ্চলের নিরাপত্তা নিশ্চিত করতে রাজধানী ঢাকাসহ তিন জেলার গুরুত্বপূর্ণ এলাকায় বর্ডার গার্ড বাংলাদেশ (বিজিবি) মোতায়েন করা হয়েছে। আইনশৃঙ্খলা পরিস্থিতি স্বাভাবিক রাখা এবং যেকোনো অপ্রীতিকর পরিস্থিতি এড়াতে মোট ৩৪ প্লাটুন বিজিবি দায়িত্ব পালন করছে। সোমবার (৯ নভেম্বর)</description>
      <source url="https://orthosongbad.com/424620/%e0%a6%b6%e0%a6%bf%e0%a6%b2%e0%a7%8d%e0%a6%aa%e0%a6%be%e0%a6%9e%e0%a7%8d%e0%a6%9a%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a6%bf%e0%a6%b0%e0%a6%be%e0%a6%aa%e0%a6%a4%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%af/">অর্থসংবাদ</source>
    </item>
    <item>
      <title>সিলেট টেস্টে জিততে বাংলাদেশের লক্ষ্য ৩৬৯ রান</title>
      <link>https://orthosongbad.com/424616/%e0%a6%b8%e0%a6%bf%e0%a6%b2%e0%a7%87%e0%a6%9f-%e0%a6%9f%e0%a7%87%e0%a6%b8%e0%a7%8d%e0%a6%9f%e0%a7%87-%e0%a6%9c%e0%a6%bf%e0%a6%a4%e0%a6%a4%e0%a7%87-%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be/</link>

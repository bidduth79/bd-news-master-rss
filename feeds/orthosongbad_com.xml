    <item>
      <title>ওয়েব কোটসের ৫ শতাংশ নগদ লভ্যাংশ ঘোষণা</title>
      <link>https://orthosongbad.com/428341/%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%ac-%e0%a6%95%e0%a7%8b%e0%a6%9f%e0%a6%b8%e0%a7%87%e0%a6%b0-%e0%a7%ab-%e0%a6%b6%e0%a6%a4%e0%a6%be%e0%a6%82%e0%a6%b6-%e0%a6%a8%e0%a6%97%e0%a6%a6-%e0%a6%b2/</link>
      <guid isPermaLink="true">https://orthosongbad.com/428341/%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%ac-%e0%a6%95%e0%a7%8b%e0%a6%9f%e0%a6%b8%e0%a7%87%e0%a6%b0-%e0%a7%ab-%e0%a6%b6%e0%a6%a4%e0%a6%be%e0%a6%82%e0%a6%b6-%e0%a6%a8%e0%a6%97%e0%a6%a6-%e0%a6%b2/</guid>
      <pubDate>Wed, 25 Nov 2026 12:08:30 +0000</pubDate>
      <description>পুঁজিবাজারে তালিকাভুক্ত কোম্পানি ওয়েব কোটস পিএলসি গত ৩০ জুন, ২০২৬ তারিখে সমাপ্ত হিসাববছরের জন্য লভ্যাংশ ঘোষণা করেছে। কোম্পানিটি আলোচিত বছরের জন্য সাধারণ শেয়ারহোল্ডারদের ৫ শতাংশ নগদ লভ্যাংশ দেবে। বুধবার (২৫ নভেম্বর) অনুষ্ঠিত কোম্পানি পরিচালনা পর্ষদের বৈঠকে সর্বশেষ হিসাববছরের নিরীক্ষিত আর্থিক প্রতিবেদ</description>
      <source url="https://orthosongbad.com/428341/%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%ac-%e0%a6%95%e0%a7%8b%e0%a6%9f%e0%a6%b8%e0%a7%87%e0%a6%b0-%e0%a7%ab-%e0%a6%b6%e0%a6%a4%e0%a6%be%e0%a6%82%e0%a6%b6-%e0%a6%a8%e0%a6%97%e0%a6%a6-%e0%a6%b2/">অর্থসংবাদ</source>
    </item>
    <item>
      <title>ওয়ালটন হাই-টেককে নতুন শেয়ার ইস্যুর অনুমতি দিল বিএসইসি</title>
      <link>https://orthosongbad.com/428338/%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b2%e0%a6%9f%e0%a6%a8-%e0%a6%b9%e0%a6%be%e0%a6%87-%e0%a6%9f%e0%a7%87%e0%a6%95%e0%a6%95%e0%a7%87-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%b6%e0%a7%87/</link>
      <guid isPermaLink="true">https://orthosongbad.com/428338/%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b2%e0%a6%9f%e0%a6%a8-%e0%a6%b9%e0%a6%be%e0%a6%87-%e0%a6%9f%e0%a7%87%e0%a6%95%e0%a6%95%e0%a7%87-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%b6%e0%a7%87/</guid>
      <pubDate>Wed, 25 Nov 2026 11:41:03 +0000</pubDate>
      <description>পুঁজিবাজারে তালিকাভুক্ত প্রকৌশল খাতের কোম্পানি ওয়ালটন হাই-টেক ইন্ডাস্ট্রিজ পিএলসি নতুন ৭ লাখ ৮০ হাজার ২৩৪টি সাধারণ শেয়ার ইস্যু করবে। ওয়ালটন ডিজি-টেক ইন্ডাস্ট্রিজ লিমিটেডকে অধিগ্রহণ প্রক্রিয়ার অংশ হিসেবে এসব শেয়ার ইস্যু করা হবে। এ বিষয়ে গতকাল মঙ্গলবার (২৪ নভেম্বর) কোম্পানিটিকে সম্মতিপত্র দিয়েছে পুঁজি</description>
      <source url="https://orthosongbad.com/428338/%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b2%e0%a6%9f%e0%a6%a8-%e0%a6%b9%e0%a6%be%e0%a6%87-%e0%a6%9f%e0%a7%87%e0%a6%95%e0%a6%95%e0%a7%87-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%b6%e0%a7%87/">অর্থসংবাদ</source>
    </item>
    <item>
      <title>ডিসেম্বর থেকে দেশব্যাপী পরিবার পরিকল্পনা ক্যাম্পেইন শুরু: স্বাস্থ্য প্রতিমন্ত্রী</title>
      <link>https://orthosongbad.com/428335/%e0%a6%a1%e0%a6%bf%e0%a6%b8%e0%a7%87%e0%a6%ae%e0%a7%8d%e0%a6%ac%e0%a6%b0-%e0%a6%a5%e0%a7%87%e0%a6%95%e0%a7%87-%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%aa%e0%a7%80/</link>
      <guid isPermaLink="true">https://orthosongbad.com/428335/%e0%a6%a1%e0%a6%bf%e0%a6%b8%e0%a7%87%e0%a6%ae%e0%a7%8d%e0%a6%ac%e0%a6%b0-%e0%a6%a5%e0%a7%87%e0%a6%95%e0%a7%87-%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%aa%e0%a7%80/</guid>
      <pubDate>Wed, 25 Nov 2026 11:23:59 +0000</pubDate>
      <description>বিগত অন্তর্বর্তী সরকারের ভুল নীতিগত সিদ্ধান্তে দেশের চার-পাঁচ দশকের সফল পরিবার পরিকল্পনা ও টিকাদান কর্মসূচি ক্ষতিগ্রস্ত হয়েছিল বলে মন্তব্য করেছেন স্বাস্থ্য ও পরিবার কল্যাণ প্রতিমন্ত্রী ড. এম এ মুহিত। তিনি বলেন, বর্তমান সরকার দায়িত্ব নেওয়ার পর এ খাতকে সর্বোচ্চ অগ্রাধিকার দিয়েছে। আগামী ১৩ ডিসেম্বর থেক</description>
      <source url="https://orthosongbad.com/428335/%e0%a6%a1%e0%a6%bf%e0%a6%b8%e0%a7%87%e0%a6%ae%e0%a7%8d%e0%a6%ac%e0%a6%b0-%e0%a6%a5%e0%a7%87%e0%a6%95%e0%a7%87-%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%aa%e0%a7%80/">অর্থসংবাদ</source>
    </item>
    <item>
      <title>বাসাবো ও খিলগাঁওয়ের জলাবদ্ধতা নিরসনে খাল পুনঃখনন শুরু</title>
      <link>https://orthosongbad.com/428332/%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a6%be%e0%a6%ac%e0%a7%8b-%e0%a6%93-%e0%a6%96%e0%a6%bf%e0%a6%b2%e0%a6%97%e0%a6%be%e0%a6%81%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%b0-%e0%a6%9c%e0%a6%b2%e0%a6%be/</link>
      <guid isPermaLink="true">https://orthosongbad.com/428332/%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a6%be%e0%a6%ac%e0%a7%8b-%e0%a6%93-%e0%a6%96%e0%a6%bf%e0%a6%b2%e0%a6%97%e0%a6%be%e0%a6%81%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%b0-%e0%a6%9c%e0%a6%b2%e0%a6%be/</guid>
      <pubDate>Wed, 25 Nov 2026 11:14:46 +0000</pubDate>
      <description>জলাবদ্ধতা নিরসন, ডেঙ্গু প্রতিরোধ এবং স্বাভাবিক পানিপ্রবাহ ফিরিয়ে আনতে রাজধানীর বাসাবো-কদমতলা খালের অবৈধ স্থাপনা উচ্ছেদ, পরিষ্কার ও পুনঃখনন কার্যক্রম শুরু করেছে ঢাকা দক্ষিণ সিটি করপোরেশন (ডিএসসিসি)। বুধবার (২৫ নভেম্বর) সকালে রাজধানীর বাসাবো এলাকায় প্রধান অতিথি হিসেবে উপস্থিত থেকে এ কার্যক্রমের উদ্বোধ</description>
      <source url="https://orthosongbad.com/428332/%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a6%be%e0%a6%ac%e0%a7%8b-%e0%a6%93-%e0%a6%96%e0%a6%bf%e0%a6%b2%e0%a6%97%e0%a6%be%e0%a6%81%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%b0-%e0%a6%9c%e0%a6%b2%e0%a6%be/">অর্থসংবাদ</source>
    </item>
    <item>
      <title>বাংলাদেশের রপ্তানি পণ্যে নতুন শুল্ক আরোপের প্রস্তুতি যুক্তরাষ্ট্রের</title>
      <link>https://orthosongbad.com/428326/%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%87%e0%a6%b0-%e0%a6%b0%e0%a6%aa%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%a8%e0%a6%bf-%e0%a6%aa%e0%a6%a3%e0%a7%8d%e0%a6%af%e0%a7%87/</link>

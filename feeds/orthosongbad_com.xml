    </item>
    <item>
      <title>রিভিউ আবেদন খারিজ, ডিএসইর সাবেক সিআরও খায়রুল বাশারের নিষেধাজ্ঞা বহাল</title>
      <link>https://orthosongbad.com/428395/%e0%a6%b0%e0%a6%bf%e0%a6%ad%e0%a6%bf%e0%a6%89-%e0%a6%86%e0%a6%ac%e0%a7%87%e0%a6%a6%e0%a6%a8-%e0%a6%96%e0%a6%be%e0%a6%b0%e0%a6%bf%e0%a6%9c-%e0%a6%a1%e0%a6%bf%e0%a6%8f%e0%a6%b8%e0%a6%87%e0%a6%b0/</link>

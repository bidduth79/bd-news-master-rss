    <item>
      <title>হামের উপসর্গ নিয়ে আরও ৬ জনের মৃত্যু, মোট প্রাণহানি ১২৯৫</title>
      <link>https://orthosongbad.com/425379/%e0%a6%b9%e0%a6%be%e0%a6%ae%e0%a7%87%e0%a6%b0-%e0%a6%89%e0%a6%aa%e0%a6%b8%e0%a6%b0%e0%a7%8d%e0%a6%97-%e0%a6%a8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%86%e0%a6%b0%e0%a6%93-%e0%a7%ac-%e0%a6%9c/</link>

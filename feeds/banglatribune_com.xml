    <item>
      <title>এনসিপির কেন্দ্রীয় এক নেতার বাড়িতে আগুন</title>
      <link>https://www.banglatribune.com/country/mymensing/983309/%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%95%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A7%9F-%E0%A6%8F%E0%A6%95-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/mymensing/983309/%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%95%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A7%9F-%E0%A6%8F%E0%A6%95-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</guid>
      <pubDate>Thu, 26 Nov 2026 09:56:26 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/00855aa9fb0d4fd2bc047873ed36101c-6b07add07658c.jpg?jadewits_media_id=1056991" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/00855aa9fb0d4fd2bc047873ed36101c-6b07add07658c.jpg?jadewits_media_id=1056991" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/00855aa9fb0d4fd2bc047873ed36101c-6b07add07658c.jpg?jadewits_media_id=1056991" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এনসিপির কেন্দ্রীয় এক নেতার বাড়িতে আগুন" /&gt;&lt;/p&gt;&lt;p&gt;নেত্রকোনা পৌর শহরে জাতীয় নাগরিক পার্টির (এনসিপি) কেন্দ্রীয় নেতা ও নেত্রকোনা-২ আসনের সাবেক সংসদ সদস্য পদপ্রার্থী ফাহিম রহমান খান পাঠানের বাসায় অগ্নিসংযোগের ঘটনা ঘটেছে।
বৃহস্পতিবার (২৬ নভেম্বর) ভোর আনুমানিক সাড়ে ৪টার দিকে পৌরসভার ৯নং ওয়ার্ডের হোসেনপুর এলাকায় এ ঘটনা ঘটে। এ ঘটনায় বাসার বারান্দার একটি কক&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/mymensing/983309/%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%95%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A7%9F-%E0%A6%8F%E0%A6%95-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8">বাংলা ট্রিবিউন</source>
    </item>

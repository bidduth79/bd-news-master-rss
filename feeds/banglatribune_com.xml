      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/caaa752af8ac2e9a1df76c9b7c82f196-6b0480ab43265.jpg?jadewits_media_id=1056601" length="0" type="image/jpeg" />

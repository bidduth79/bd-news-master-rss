      <guid isPermaLink="true">https://www.banglatribune.com/national/981244/%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%97%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A7%8D%E0%A6%AF-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81</guid>
      <pubDate>Mon, 16 Nov 2026 15:07:53 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/7a5c49dd2e9b5bc6d7f72a487d6481ea-6afac7e2d108a.jpg?jadewits_media_id=1055255" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/7a5c49dd2e9b5bc6d7f72a487d6481ea-6afac7e2d108a.jpg?jadewits_media_id=1055255" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/7a5c49dd2e9b5bc6d7f72a487d6481ea-6afac7e2d108a.jpg?jadewits_media_id=1055255" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মালয়েশিয়াগামী কর্মীদের স্বাস্থ্য পরীক্ষা শুরু" /&gt;&lt;/p&gt;&lt;p&gt;প্রবাসী কল্যাণ ও বৈদেশিক কর্মসংস্থান মন্ত্রণালয়ের মন্ত্রী আরিফুল হক চৌধুরী জানিয়েছেন, আজ থেকে সরকারের অনুমোদিত মেডিক্যাল সেন্টারগুলোতে মালয়েশিয়াগামী কর্মীদের স্বাস্থ্য পরীক্ষা পূর্ণাঙ্গভাবে শুরু হয়েছে।
সোমবার (১৬ নভেম্বর) প্রবাসী কল্যাণ ও বৈদেশিক কর্মসংস্থান মন্ত্রণালয়ের জনসংযোগ কর্মকর্তা মো. শর&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/981244/%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%97%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A7%8D%E0%A6%AF-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81">বাংলা ট্রিবিউন</source>

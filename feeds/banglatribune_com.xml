      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/50ae92b0abc57ced623b622a0422e5a1-6b0477cd5b197.jpg?jadewits_media_id=1056589" length="0" type="image/jpeg" />

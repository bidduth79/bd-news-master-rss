    <item>
      <title>এবার জঙ্গিগোষ্ঠীর নিশানায় অমিতাভ</title>
      <link>https://www.banglatribune.com/entertainment/981646/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BF%E0%A6%97%E0%A7%8B%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A7%80%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B6%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%85%E0%A6%AE%E0%A6%BF%E0%A6%A4%E0%A6%BE%E0%A6%AD</link>
      <guid isPermaLink="true">https://www.banglatribune.com/entertainment/981646/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BF%E0%A6%97%E0%A7%8B%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A7%80%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B6%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%85%E0%A6%AE%E0%A6%BF%E0%A6%A4%E0%A6%BE%E0%A6%AD</guid>
      <pubDate>Wed, 18 Nov 2026 09:24:18 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/ad8c50b5361fa3f708888dc2fc62a71e-6afd1a3ad243c.jpg?jadewits_media_id=1055589" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/ad8c50b5361fa3f708888dc2fc62a71e-6afd1a3ad243c.jpg?jadewits_media_id=1055589" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/ad8c50b5361fa3f708888dc2fc62a71e-6afd1a3ad243c.jpg?jadewits_media_id=1055589" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এবার জঙ্গিগোষ্ঠীর নিশানায় অমিতাভ" /&gt;&lt;/p&gt;&lt;p&gt;বলিউড অভিনেতা অমিতাভ বচ্চনকে এবার খুনের হুমকি দিয়েছে খলিস্তানপন্থি জঙ্গিগোষ্ঠীর গ্যাংস্টার গোল্ডি ধিলোঁ। নিষিদ্ধ গোষ্ঠীর প্রধান গুরপতবন্ত সিং পান্নুন সরাসরি অভিনেতার ওপর হামলার হুমকি ছুড়েছে। সামাজিক যোগাযোগমাধ্যমে এক রহস্যময় পোস্টে তার বার্তা, &amp;lsquo;বেঁচে গেলেন, নাকি ফেঁসে গেলেন?&amp;rsquo;
একইসঙ্গে &amp;&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/entertainment/981646/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BF%E0%A6%97%E0%A7%8B%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A7%80%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B6%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%85%E0%A6%AE%E0%A6%BF%E0%A6%A4%E0%A6%BE%E0%A6%AD">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>শ্রীপুরে রাতের আঁধারে নিষিদ্ধ ছাত্রলীগের মশাল মিছিল</title>
      <link>https://www.banglatribune.com/country/dhaka/981645/%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%81%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%B6%E0%A6%BE%E0%A6%B2</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/dhaka/981645/%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%81%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%B6%E0%A6%BE%E0%A6%B2</guid>
      <pubDate>Wed, 18 Nov 2026 09:22:17 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/5a5bcfe5c7e7fd0a1b281af419f721c7-6afd19c1b6beb.jpg?jadewits_media_id=1055588" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/5a5bcfe5c7e7fd0a1b281af419f721c7-6afd19c1b6beb.jpg?jadewits_media_id=1055588" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/5a5bcfe5c7e7fd0a1b281af419f721c7-6afd19c1b6beb.jpg?jadewits_media_id=1055588" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শ্রীপুরে রাতের আঁধারে নিষিদ্ধ ছাত্রলীগের মশাল মিছিল" /&gt;&lt;/p&gt;&lt;p&gt;গাজীপুরের শ্রীপুরে কার্যক্রম নিষিদ্ধ ছাত্রলীগের সাবেক উপজেলা সভাপতি জাকিরুল হাসান জিকুর নেতৃত্বে মশাল মিছিল করেছেন সংগঠনটির নেতাকর্মীরা। আগামী ১৯ নভেম্বর কার্যক্রম নিষিদ্ধ আওয়ামী লীগের ঘোষিত লকডাউন কর্মসূচি সফল করার লক্ষ্যে বুধবার (১৮ নভেম্বর) দিবাগত রাতে শ্রীপুর-কাপাসিয়া সড়কে এ মিছিল বের করা হয়।
মি&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/dhaka/981645/%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%81%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%B6%E0%A6%BE%E0%A6%B2">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>অনুমোদনহীন হুটার-হাইড্রোলিক হর্নের বিরুদ্ধে ১ ডিসেম্বর থেকে অভিযান</title>
      <link>https://www.banglatribune.com/law-and-crime/981644/%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AE%E0%A7%8B%E0%A6%A6%E0%A6%A8%E0%A6%B9%E0%A7%80%E0%A6%A8-%E0%A6%B9%E0%A7%81%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%87%E0%A6%A1%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B2%E0%A6%BF%E0%A6%95-%E0%A6%B9%E0%A6%B0%E0%A7%8D%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A7%A7</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/981644/%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AE%E0%A7%8B%E0%A6%A6%E0%A6%A8%E0%A6%B9%E0%A7%80%E0%A6%A8-%E0%A6%B9%E0%A7%81%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%87%E0%A6%A1%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B2%E0%A6%BF%E0%A6%95-%E0%A6%B9%E0%A6%B0%E0%A7%8D%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A7%A7</guid>
      <pubDate>Wed, 18 Nov 2026 09:16:13 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2024/04/28/2-89a603afb89b7a02fe00041c5ffbf9aa.jpg?jadewits_media_id=914112" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2024/04/28/2-89a603afb89b7a02fe00041c5ffbf9aa.jpg?jadewits_media_id=914112" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2024/04/28/2-89a603afb89b7a02fe00041c5ffbf9aa.jpg?jadewits_media_id=914112" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অনুমোদনহীন হুটার-হাইড্রোলিক হর্নের বিরুদ্ধে ১ ডিসেম্বর থেকে অভিযান" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীতে অনুমোদনহীন হুটার, উচ্চ শব্দ সৃষ্টিকারী হাইড্রোলিক হর্ন ও বিকন লাইট ব্যবহার বন্ধে আগামী ১ ডিসেম্বর থেকে সাঁড়াশি অভিযান শুরু করতে যাচ্ছে ঢাকা মহানগর পুলিশ (ডিএমপি)। এর আগেই যানবাহন থেকে এসব অননুমোদিত সরঞ্জাম খুলে ফেলার জন্য মালিক ও চালকদের প্রতি আহ্বান জানানো হয়েছে।
ডিএমপি কমিশনার মোসলেহ উদ্&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/981644/%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AE%E0%A7%8B%E0%A6%A6%E0%A6%A8%E0%A6%B9%E0%A7%80%E0%A6%A8-%E0%A6%B9%E0%A7%81%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%87%E0%A6%A1%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B2%E0%A6%BF%E0%A6%95-%E0%A6%B9%E0%A6%B0%E0%A7%8D%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A7%A7">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>হরমুজ প্রণালিতে মাইনের আঘাতে চার ট্যাংকারে আগুন</title>
      <link>https://www.banglatribune.com/foreign/middle-east/981643/%E0%A6%B9%E0%A6%B0%E0%A6%AE%E0%A7%81%E0%A6%9C-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A3%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%87%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%98%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%9F%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/middle-east/981643/%E0%A6%B9%E0%A6%B0%E0%A6%AE%E0%A7%81%E0%A6%9C-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A3%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%87%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%98%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%9F%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</guid>
      <pubDate>Wed, 18 Nov 2026 09:13:57 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/11d328f5cf77a7e8b100c9d6298248c1-6afd17994ed9d.jpg?jadewits_media_id=1055587" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/11d328f5cf77a7e8b100c9d6298248c1-6afd17994ed9d.jpg?jadewits_media_id=1055587" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/11d328f5cf77a7e8b100c9d6298248c1-6afd17994ed9d.jpg?jadewits_media_id=1055587" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হরমুজ প্রণালিতে মাইনের আঘাতে চার ট্যাংকারে আগুন" /&gt;&lt;/p&gt;&lt;p&gt;হরমুজ প্রণালির পূর্বাঞ্চলে নৌমাইনে আঘাত লেগেছে চতুর্থ একটি ট্যাংকারের। মঙ্গলবার সকালে এ ধরনের চারটি ঘটনা ঘটেছে বলে জানিয়েছে নৌবাহিনী।
এর আগে মঙ্গলবার ইরানের ইসলামিক রেভল্যুশনারি গার্ড কর্পসের (আইআরজিসি) নৌবাহিনী জানায়, হরমুজ প্রণালিতে নৌমাইনে আঘাতের পর একটি সুপারট্যাংকার ও তরলীকৃত পেট্রোলিয়াম গ্যাস &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/middle-east/981643/%E0%A6%B9%E0%A6%B0%E0%A6%AE%E0%A7%81%E0%A6%9C-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A3%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%87%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%98%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%9F%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8">বাংলা ট্রিবিউন</source>

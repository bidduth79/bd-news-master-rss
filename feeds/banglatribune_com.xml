    <item>
      <title>মোটরসাইকেলে ‘লিফট’ নেওয়ার কয়েক ঘণ্টা পর পাঞ্জাবে পুলিশ কর্মকর্তার মরদেহ উদ্ধার</title>
      <link>https://www.banglatribune.com/foreign/asia/981396/%E0%A6%AE%E0%A7%8B%E0%A6%9F%E0%A6%B0%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%87%E0%A6%B2%E0%A7%87-%E2%80%98%E0%A6%B2%E0%A6%BF%E0%A6%AB%E0%A6%9F%E2%80%99-%E0%A6%A8%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A7%9F%E0%A7%87%E0%A6%95-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%AA%E0%A6%B0-%E0%A6%AA%E0%A6%BE%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A6%BE%E0%A6%AC%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/asia/981396/%E0%A6%AE%E0%A7%8B%E0%A6%9F%E0%A6%B0%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%87%E0%A6%B2%E0%A7%87-%E2%80%98%E0%A6%B2%E0%A6%BF%E0%A6%AB%E0%A6%9F%E2%80%99-%E0%A6%A8%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A7%9F%E0%A7%87%E0%A6%95-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%AA%E0%A6%B0-%E0%A6%AA%E0%A6%BE%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A6%BE%E0%A6%AC%E0%A7%87</guid>
      <pubDate>Mon, 16 Nov 2026 23:03:12 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/eb2c886691490973810dca23be9dc8ec-6afb36961827e.jpg?jadewits_media_id=1055376" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/eb2c886691490973810dca23be9dc8ec-6afb36961827e.jpg?jadewits_media_id=1055376" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/eb2c886691490973810dca23be9dc8ec-6afb36961827e.jpg?jadewits_media_id=1055376" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মোটরসাইকেলে ‘লিফট’ নেওয়ার কয়েক ঘণ্টা পর পাঞ্জাবে পুলিশ কর্মকর্তার মরদেহ উদ্ধার" /&gt;&lt;/p&gt;&lt;p&gt;ভারতের পাঞ্জাবের গুরুদাসপুর জেলায় বিনোদ কুমার (৪২) নামে এক পুলিশ কনস্টেবলের মরদেহ উদ্ধার করা হয়েছে। হত্যাকাণ্ডের তদন্তে পাওয়া সিসিটিভি ফুটেজে দেখা গেছে, নিহত হওয়ার কিছুক্ষণ আগে মোটরসাইকেলে থাকা দুই ব্যক্তি তাকে তুলে নিয়ে নিজেদের বাইকে বসিয়ে নিয়ে যাচ্ছেন।

ইয়েমেনে হুথিদের বিরুদ্ধে বিপর্যয়ের পর সামরিক&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/asia/981396/%E0%A6%AE%E0%A7%8B%E0%A6%9F%E0%A6%B0%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%87%E0%A6%B2%E0%A7%87-%E2%80%98%E0%A6%B2%E0%A6%BF%E0%A6%AB%E0%A6%9F%E2%80%99-%E0%A6%A8%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A7%9F%E0%A7%87%E0%A6%95-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%AA%E0%A6%B0-%E0%A6%AA%E0%A6%BE%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A6%BE%E0%A6%AC%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>রাজধানীতে গণঅধিকার পরিষদের মশাল মিছিল</title>
      <link>https://www.banglatribune.com/politics/other-politics/981395/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%97%E0%A6%A3%E0%A6%85%E0%A6%A7%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%B7%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%B6%E0%A6%BE%E0%A6%B2-%E0%A6%AE%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A6%B2</link>
      <guid isPermaLink="true">https://www.banglatribune.com/politics/other-politics/981395/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%97%E0%A6%A3%E0%A6%85%E0%A6%A7%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%B7%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%B6%E0%A6%BE%E0%A6%B2-%E0%A6%AE%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A6%B2</guid>
      <pubDate>Mon, 16 Nov 2026 23:00:47 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/010a55b2223a7ffca17e075bd4a60231-6afb3696a8b58.jpg?jadewits_media_id=1055377" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/010a55b2223a7ffca17e075bd4a60231-6afb3696a8b58.jpg?jadewits_media_id=1055377" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/010a55b2223a7ffca17e075bd4a60231-6afb3696a8b58.jpg?jadewits_media_id=1055377" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজধানীতে গণঅধিকার পরিষদের মশাল মিছিল" /&gt;&lt;/p&gt;&lt;p&gt;দেশব্যাপী নিষিদ্ধ আওয়ামী লীগের &amp;lsquo;সন্ত্রাসী কর্মকাণ্ডের&amp;rsquo; প্রতিবাদে মশাল মিছিল করেছে ঢাকা মহানগর দক্ষিণ গণঅধিকার পরিষদ। সোমবার (১৬ নভেম্বর) সন্ধ্যার পর রাজধানীর আল রাজি কমপ্লেক্সের সামনে থেকে মিছিলটি শুরু হয়। পুরানা পল্টন ও নাইটিংগেল মোড় ঘুরে একই স্থানে সংক্ষিপ্ত সমাবেশের মাধ্যমে মিছিলটি শে&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/politics/other-politics/981395/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%97%E0%A6%A3%E0%A6%85%E0%A6%A7%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%B7%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%B6%E0%A6%BE%E0%A6%B2-%E0%A6%AE%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A6%B2">বাংলা ট্রিবিউন</source>
    </item>

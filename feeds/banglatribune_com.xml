    <item>
      <title>আজ আবারও বসছে মজুরি বোর্ড</title>
      <link>https://www.banglatribune.com/business/industry-and-trade/983316/%E0%A6%86%E0%A6%9C-%E0%A6%86%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A6%93-%E0%A6%AC%E0%A6%B8%E0%A6%9B%E0%A7%87-%E0%A6%AE%E0%A6%9C%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%AC%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%A1</link>
      <guid isPermaLink="true">https://www.banglatribune.com/business/industry-and-trade/983316/%E0%A6%86%E0%A6%9C-%E0%A6%86%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A6%93-%E0%A6%AC%E0%A6%B8%E0%A6%9B%E0%A7%87-%E0%A6%AE%E0%A6%9C%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%AC%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%A1</guid>
      <pubDate>Thu, 26 Nov 2026 10:30:21 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/ec8e512130d27122abbd64f87cc50e74-6b07b5738ce50.jpg?jadewits_media_id=1056996" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/ec8e512130d27122abbd64f87cc50e74-6b07b5738ce50.jpg?jadewits_media_id=1056996" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/ec8e512130d27122abbd64f87cc50e74-6b07b5738ce50.jpg?jadewits_media_id=1056996" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আজ আবারও বসছে মজুরি বোর্ড" /&gt;&lt;/p&gt;&lt;p&gt;তৈরি পোশাকশিল্পে নিয়োজিত শ্রমিক ও কর্মচারীদের নিম্নতম মজুরি চূড়ান্ত করার লক্ষ্যে আজ বৃহস্পতিবার মজুরি বোর্ডের পঞ্চম সভা অনুষ্ঠিত হবে। রাজধানীর সেগুনবাগিচায় বেলা সাড়ে ১১টায় এ সভা হওয়ার কথা রয়েছে।
সভায় সভাপতিত্ব করবেন মজুরি বোর্ডের চেয়ারম্যান ও জেলা ও দায়রা জজ সৈয়দ আজাদ সুবহানী।
এর আগে গত মঙ্গলবার (২৪&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/business/industry-and-trade/983316/%E0%A6%86%E0%A6%9C-%E0%A6%86%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A6%93-%E0%A6%AC%E0%A6%B8%E0%A6%9B%E0%A7%87-%E0%A6%AE%E0%A6%9C%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%AC%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%A1">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>মহাসড়ক অবরোধের চেষ্টা শ্রমিকদের, সাউন্ড গ্রেনেড ছুড়ে সরালো পুলিশ</title>
      <link>https://www.banglatribune.com/country/dhaka/983315/%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A7%9C%E0%A6%95-%E0%A6%85%E0%A6%AC%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A7%87%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%A1-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A7%87%E0%A6%A1</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/dhaka/983315/%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A7%9C%E0%A6%95-%E0%A6%85%E0%A6%AC%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A7%87%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%A1-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A7%87%E0%A6%A1</guid>
      <pubDate>Thu, 26 Nov 2026 10:23:31 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/68bf460cff2e797703a8fd052ac174a4-6b07b42ea624d.jpg?jadewits_media_id=1056995" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/68bf460cff2e797703a8fd052ac174a4-6b07b42ea624d.jpg?jadewits_media_id=1056995" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/68bf460cff2e797703a8fd052ac174a4-6b07b42ea624d.jpg?jadewits_media_id=1056995" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মহাসড়ক অবরোধের চেষ্টা শ্রমিকদের, সাউন্ড গ্রেনেড ছুড়ে সরালো পুলিশ" /&gt;&lt;/p&gt;&lt;p&gt;গাজীপুরের ভোগড়া বাইপাস এলাকায় ঢাকা-ময়মনসিংহ মহাসড়ক অবরোধের চেষ্টা করেছেন কারখানার শ্রমিকরা। তবে তাৎক্ষণিক পুলিশের হস্তক্ষেপে মহাসড়ক ছেড়ে যান তারা। এ ছাড়া কোনাবাড়ি এলাকায় বেশ কিছু কারখানায় ছুটি ঘোষণা করেছে কর্তৃপক্ষ। মহাসড়কের গুরুত্বপূর্ণ বিভিন্ন পয়েন্টে পুলিশ মোতায়েন রয়েছে।
বৃহস্পতিবার (২৬ নভেম্বর) &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/dhaka/983315/%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A7%9C%E0%A6%95-%E0%A6%85%E0%A6%AC%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A7%87%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%A1-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A7%87%E0%A6%A1">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>বিশ্ববাজারে বাড়লো জ্বালানি তেলের দাম</title>
      <link>https://www.banglatribune.com/foreign/america/983314/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%B2%E0%A7%8B-%E0%A6%9C%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%A4%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/america/983314/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%B2%E0%A7%8B-%E0%A6%9C%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%A4%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE</guid>
      <pubDate>Thu, 26 Nov 2026 10:22:14 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/09/25/35ce8443da75d697dedd67a5bb479e67-6ab6257883667.jpg?jadewits_media_id=1045608" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/09/25/35ce8443da75d697dedd67a5bb479e67-6ab6257883667.jpg?jadewits_media_id=1045608" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/09/25/35ce8443da75d697dedd67a5bb479e67-6ab6257883667.jpg?jadewits_media_id=1045608" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিশ্ববাজারে বাড়লো জ্বালানি তেলের দাম" /&gt;&lt;/p&gt;&lt;p&gt;তেলের দামে ঊর্ধ্বমুখী প্রবণতা অব্যাহত রয়েছে। বৃহস্পতিবার (২৬ নভেম্বর) গ্রিনিচ মান সময় ০১টা ৩৭ মিনিটে ব্রেন্ট অপরিশোধিত তেলের ফিউচার্স ১০ সেন্ট বা শূন্য দশমিক ১ শতাংশ বেড়ে ব্যারেলপ্রতি ৯৪ দশমিক ৭১ ডলারে পৌঁছেছে। কাতারভিত্তিক সংবাদমাধ্যম আল জাজিরা এ খবর জানিয়েছে।
যুক্তরাষ্ট্রের ওয়েস্ট টেক্সাস ইন্ট&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/america/983314/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%B2%E0%A7%8B-%E0%A6%9C%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%A4%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE">বাংলা ট্রিবিউন</source>
    </item>

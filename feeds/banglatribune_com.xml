    <item>
      <title>হাওর এক্সপ্রেসের বগিতে দুর্বৃত্তদের আগুন, তদন্তে রেলওয়ে পুলিশ</title>
      <link>https://www.banglatribune.com/country/mymensing/979983/%E0%A6%B9%E0%A6%BE%E0%A6%93%E0%A6%B0-%E0%A6%8F%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%97%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%A4%E0%A6%A6%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/mymensing/979983/%E0%A6%B9%E0%A6%BE%E0%A6%93%E0%A6%B0-%E0%A6%8F%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%97%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%A4%E0%A6%A6%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%87</guid>
      <pubDate>Tue, 10 Nov 2026 13:12:37 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/55db1c1acafeead1be5edd377329d627-6af2c3c542a08.jpg?jadewits_media_id=1054181" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/55db1c1acafeead1be5edd377329d627-6af2c3c542a08.jpg?jadewits_media_id=1054181" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/55db1c1acafeead1be5edd377329d627-6af2c3c542a08.jpg?jadewits_media_id=1054181" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হাওর এক্সপ্রেসের বগিতে দুর্বৃত্তদের আগুন, তদন্তে রেলওয়ে পুলিশ" /&gt;&lt;/p&gt;&lt;p&gt;নেত্রকোনার মোহনগঞ্জ রেলওয়ে স্টেশনে দাঁড়িয়ে থাকা আন্তঃনগর হাওর এক্সপ্রেস ট্রেনের একটি বগিতে অগ্নিসংযোগের ঘটনা ঘটেছে।&amp;nbsp;মঙ্গলবার (১০ নভেম্বর) ভোরে এ ঘটনায় বগিটির অন্তত চারটি আসনের রেক্সিনের কভার পুড়ে গেছে। তবে এতে ট্রেন চলাচলে কোনও বিঘ্ন ঘটেনি।
মোহনগঞ্জ রেলওয়ে স্টেশনের স্টেশন মাস্টার জহিরুল ইসলাম জ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/mymensing/979983/%E0%A6%B9%E0%A6%BE%E0%A6%93%E0%A6%B0-%E0%A6%8F%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%97%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%A4%E0%A6%A6%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>শিশুদের অতিরিক্ত স্ক্রিন-টাইমে বাড়ছে হৃদ্‌রোগের ঝুঁকি?</title>

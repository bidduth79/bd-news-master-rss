      <guid isPermaLink="true">https://www.banglatribune.com/foreign/middle-east/981869/%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B8-%E0%A6%AA%E0%A6%B0-%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%AF-%E0%A6%9B%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A6%B2%E0%A7%8B-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8-%E0%A6%B0%E0%A6%A3%E0%A6%A4%E0%A6%B0%E0%A7%80-%E0%A6%9C%E0%A6%B0%E0%A7%8D%E0%A6%9C</guid>
      <pubDate>Thu, 19 Nov 2026 08:50:37 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/e7d3a8fd434bd0592a6595249780e287-6afe63d9ec8d6.jpg?jadewits_media_id=1055796" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/e7d3a8fd434bd0592a6595249780e287-6afe63d9ec8d6.jpg?jadewits_media_id=1055796" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/e7d3a8fd434bd0592a6595249780e287-6afe63d9ec8d6.jpg?jadewits_media_id=1055796" style="max-width:100%;height:auto;margin-bottom:10px;" alt="তিন মাস পর মধ্যপ্রাচ্য ছাড়লো মার্কিন রণতরী জর্জ ওয়াশিংটন" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাষ্ট্রের বিমানবাহী রণতরী ইউএসএস জর্জ ওয়াশিংটন তিন মাস পর মধ্যপ্রাচ্য ছেড়ে গেছে বলে জানিয়েছে ইউএস নেভাল ইনস্টিটিউটের অনলাইন সংবাদ সেবা। বুধবার এ প্রতিবেদন প্রকাশিত হয়। তুরস্কের রাষ্ট্রীয় সংবাদ সংস্থা আনাদোলু এজেন্সি এ খবর জানিয়েছে।
মার্কিন প্যাসিফিক ফ্লিটের এক মুখপাত্র ইউএসএনআই নিউজকে জানা&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/middle-east/981869/%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B8-%E0%A6%AA%E0%A6%B0-%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%AF-%E0%A6%9B%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A6%B2%E0%A7%8B-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8-%E0%A6%B0%E0%A6%A3%E0%A6%A4%E0%A6%B0%E0%A7%80-%E0%A6%9C%E0%A6%B0%E0%A7%8D%E0%A6%9C">বাংলা ট্রিবিউন</source>

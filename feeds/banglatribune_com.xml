      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/24027db0c4530f40173aae914e6222a3-6b0208ab4a29e.jpg?jadewits_media_id=1056277" length="0" type="image/jpeg" />

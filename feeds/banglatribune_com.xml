      <guid isPermaLink="true">https://www.banglatribune.com/country/mymensing/982160/%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%AA%E0%A6%B0-%E0%A6%B8%E0%A6%9A%E0%A6%B2-%E0%A6%B9%E0%A6%B2%E0%A7%8B-%E0%A6%AE%E0%A7%9F%E0%A6%AE%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%82%E0%A6%B9-%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A6%AA%E0%A7%81%E0%A6%B0-%E0%A6%B0%E0%A7%87%E0%A6%B2%E0%A6%AA%E0%A6%A5</guid>

    <item>
      <title>‘ক্ষমতা হারানোর শঙ্কায় তীব্র আতঙ্কে ভুগছেন নেতানিয়াহু’</title>
      <link>https://www.banglatribune.com/foreign/middle-east/980123/%E2%80%98%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%AE%E0%A6%A4%E0%A6%BE-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8B%E0%A6%B0-%E0%A6%B6%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%A4%E0%A7%80%E0%A6%AC%E0%A7%8D%E0%A6%B0-%E0%A6%86%E0%A6%A4%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A7%87-%E0%A6%AD%E0%A7%81%E0%A6%97%E0%A6%9B%E0%A7%87%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/middle-east/980123/%E2%80%98%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%AE%E0%A6%A4%E0%A6%BE-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8B%E0%A6%B0-%E0%A6%B6%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%A4%E0%A7%80%E0%A6%AC%E0%A7%8D%E0%A6%B0-%E0%A6%86%E0%A6%A4%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A7%87-%E0%A6%AD%E0%A7%81%E0%A6%97%E0%A6%9B%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Tue, 10 Nov 2026 21:46:49 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/0608277a59e392588ec9ef5940e928ff-6af33c24a3ef6.jpg?jadewits_media_id=1054305" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/0608277a59e392588ec9ef5940e928ff-6af33c24a3ef6.jpg?jadewits_media_id=1054305" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/0608277a59e392588ec9ef5940e928ff-6af33c24a3ef6.jpg?jadewits_media_id=1054305" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘ক্ষমতা হারানোর শঙ্কায় তীব্র আতঙ্কে ভুগছেন নেতানিয়াহু’" /&gt;&lt;/p&gt;&lt;p&gt;ইসরায়েলের সাবেক প্রধানমন্ত্রী বেনিয়ামিন নেতানিয়াহু ক্ষমতা হারানোর আশঙ্কায় তীব্র আতঙ্কের মধ্যে দিন কাটাচ্ছেন বলে দাবি করেছেন তার সাবেক ঘনিষ্ঠ উপদেষ্টা নির হেফেজ। মঙ্গলবার ইসরায়েলের ১০৩এফএম রেডিওতে দেওয়া এক সাক্ষাৎকারে তিনি এ কথা জানান।

২৫০ বছরের সামরিক ইতিহাস টেনে অভিশংসনের হুমকি উড়িয়ে দিলেন মার্&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/middle-east/980123/%E2%80%98%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%AE%E0%A6%A4%E0%A6%BE-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8B%E0%A6%B0-%E0%A6%B6%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%A4%E0%A7%80%E0%A6%AC%E0%A7%8D%E0%A6%B0-%E0%A6%86%E0%A6%A4%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A7%87-%E0%A6%AD%E0%A7%81%E0%A6%97%E0%A6%9B%E0%A7%87%E0%A6%A8">বাংলা ট্রিবিউন</source>

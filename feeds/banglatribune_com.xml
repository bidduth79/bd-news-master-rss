      <guid isPermaLink="true">https://www.banglatribune.com/national/980128/%E0%A6%B8%E0%A7%8C%E0%A6%B0%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%B0%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A6%BE%E0%A6%AE-%E0%A6%95%E0%A6%BF%E0%A6%A8%E0%A6%A4%E0%A7%87-%E0%A7%AB-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%A8%E0%A7%8D%E0%A6%A4</guid>
      <pubDate>Tue, 10 Nov 2026 22:15:12 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2019/11/21/05b9afbf80fa07b9aa4788aee89094ae-5dd6b40673033.jpg?jadewits_media_id=635369" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2019/11/21/05b9afbf80fa07b9aa4788aee89094ae-5dd6b40673033.jpg?jadewits_media_id=635369" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2019/11/21/05b9afbf80fa07b9aa4788aee89094ae-5dd6b40673033.jpg?jadewits_media_id=635369" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সৌরবিদ্যুতের সরঞ্জাম কিনতে ৫ কোটি টাকা পর্যন্ত ই-জিপি বাধ্যতামূলক নয়" /&gt;&lt;/p&gt;&lt;p&gt;সরকারি ও বেসরকারি প্রতিষ্ঠানে সৌরবিদ্যুৎ স্থাপন কার্যক্রম দ্রুত সম্প্রসারণে বিশেষ বিধান রেখে &amp;lsquo;বিশেষ সৌরবিদ্যুৎ স্থাপন আইন, ২০২৬&amp;rsquo; বিল করা উত্থাপন করা হয়েছে। মঙ্গলবার (১০ নভেম্বর) বিলটি উত্থাপনের পর সংশ্লিষ্ট মন্ত্রণালয় সংক্রান্ত স্থায়ী কমিটিতে পাঠোনো হয়েছে।
এ সময় সংসদের বৈঠকে সভাপতিত্ব কর&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/980128/%E0%A6%B8%E0%A7%8C%E0%A6%B0%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%B0%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A6%BE%E0%A6%AE-%E0%A6%95%E0%A6%BF%E0%A6%A8%E0%A6%A4%E0%A7%87-%E0%A7%AB-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%A8%E0%A7%8D%E0%A6%A4">বাংলা ট্রিবিউন</source>

    <item>
      <title>পাগলা মসজিদে ৩ ঘণ্টায় গণনা হলো ১০ কোটি টাকা, মিললো স্বর্ণের চামচ-বাটি</title>
      <link>https://www.banglatribune.com/country/dhaka/982343/%E0%A6%AA%E0%A6%BE%E0%A6%97%E0%A6%B2%E0%A6%BE-%E0%A6%AE%E0%A6%B8%E0%A6%9C%E0%A6%BF%E0%A6%A6%E0%A7%87-%E0%A7%A9-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A6%A3%E0%A6%A8%E0%A6%BE-%E0%A6%B9%E0%A6%B2%E0%A7%8B-%E0%A7%A7%E0%A7%A6-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2%E0%A7%8B</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/dhaka/982343/%E0%A6%AA%E0%A6%BE%E0%A6%97%E0%A6%B2%E0%A6%BE-%E0%A6%AE%E0%A6%B8%E0%A6%9C%E0%A6%BF%E0%A6%A6%E0%A7%87-%E0%A7%A9-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A6%A3%E0%A6%A8%E0%A6%BE-%E0%A6%B9%E0%A6%B2%E0%A7%8B-%E0%A7%A7%E0%A7%A6-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2%E0%A7%8B</guid>
      <pubDate>Sat, 21 Nov 2026 15:18:25 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/e68c6c6c524d19b80db86aba553632fb-6b0161c9b9805.jpg?jadewits_media_id=1056187" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/e68c6c6c524d19b80db86aba553632fb-6b0161c9b9805.jpg?jadewits_media_id=1056187" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/e68c6c6c524d19b80db86aba553632fb-6b0161c9b9805.jpg?jadewits_media_id=1056187" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পাগলা মসজিদে ৩ ঘণ্টায় গণনা হলো ১০ কোটি টাকা, মিললো স্বর্ণের চামচ-বাটি" /&gt;&lt;/p&gt;&lt;p&gt;কিশোরগঞ্জের ঐতিহাসিক পাগলা মসজিদের দানবাক্সে এবার মিলেছে ৫১ বস্তা টাকা। নগদ অর্থের পাশাপাশি পাওয়া গেছে স্বর্ণের চামচ ও বাটি। শনিবার (২১ নভেম্বর) সকালে দানবাক্স খোলার পর টাকা ও অন্যান্য সামগ্রী গণনার সময় এসব স্বর্ণালংকারের সন্ধান মেলে। বিষয়টি নিশ্চিত করেছেন পাগলা মসজিদের ইমাম মুফতি মিজবাহ উদ্দীন।
মসজ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/dhaka/982343/%E0%A6%AA%E0%A6%BE%E0%A6%97%E0%A6%B2%E0%A6%BE-%E0%A6%AE%E0%A6%B8%E0%A6%9C%E0%A6%BF%E0%A6%A6%E0%A7%87-%E0%A7%A9-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A6%A3%E0%A6%A8%E0%A6%BE-%E0%A6%B9%E0%A6%B2%E0%A7%8B-%E0%A7%A7%E0%A7%A6-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2%E0%A7%8B">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>সমৃদ্ধ ইউরেনিয়াম নিয়ে অনড় ইরান, তবু ন্যায্য সমাধানের আশা</title>
      <link>https://www.banglatribune.com/foreign/middle-east/982342/%E0%A6%B8%E0%A6%AE%E0%A7%83%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%87%E0%A6%89%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%85%E0%A6%A8%E0%A6%A1%E0%A6%BC-%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8-%E0%A6%A4%E0%A6%AC%E0%A7%81-%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AF%E0%A7%8D%E0%A6%AF</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/middle-east/982342/%E0%A6%B8%E0%A6%AE%E0%A7%83%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%87%E0%A6%89%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%85%E0%A6%A8%E0%A6%A1%E0%A6%BC-%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8-%E0%A6%A4%E0%A6%AC%E0%A7%81-%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AF%E0%A7%8D%E0%A6%AF</guid>
      <pubDate>Sat, 21 Nov 2026 15:12:05 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/d55557cb956e83e7384e16577a57eff7-6b0160076de46.jpg?jadewits_media_id=1056184" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/d55557cb956e83e7384e16577a57eff7-6b0160076de46.jpg?jadewits_media_id=1056184" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/d55557cb956e83e7384e16577a57eff7-6b0160076de46.jpg?jadewits_media_id=1056184" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সমৃদ্ধ ইউরেনিয়াম নিয়ে অনড় ইরান, তবু ন্যায্য সমাধানের আশা" /&gt;&lt;/p&gt;&lt;p&gt;পারমাণবিক কর্মসূচি নিয়ে আলোচনায় নিজেদের অবস্থানের কথা স্পষ্ট করেছে ইরান। দেশটির পররাষ্ট্রমন্ত্রী আব্বাস আরাঘচি বলেছেন, সমৃদ্ধ ইউরেনিয়াম দেশের বাইরে না নেওয়া তেহরানের অন্যতম প্রধান শর্ত। তবে আলোচনার মাধ্যমে একটি &amp;lsquo;ন্যায্য সমাধানে&amp;rsquo; পৌঁছানো সম্ভব বলে মনে করেন তিনি। ব্রিটিশ বার্তা সংস্থা &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/middle-east/982342/%E0%A6%B8%E0%A6%AE%E0%A7%83%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%87%E0%A6%89%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%85%E0%A6%A8%E0%A6%A1%E0%A6%BC-%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8-%E0%A6%A4%E0%A6%AC%E0%A7%81-%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AF%E0%A7%8D%E0%A6%AF">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ট্রাফিক আইন লঙ্ঘনে দুই দিনে ৯০০ মামলা</title>
      <link>https://www.banglatribune.com/law-and-crime/982341/%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AB%E0%A6%BF%E0%A6%95-%E0%A6%86%E0%A6%87%E0%A6%A8-%E0%A6%B2%E0%A6%99%E0%A7%8D%E0%A6%98%E0%A6%A8%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A7%AF%E0%A7%A6%E0%A7%A6-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/982341/%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AB%E0%A6%BF%E0%A6%95-%E0%A6%86%E0%A6%87%E0%A6%A8-%E0%A6%B2%E0%A6%99%E0%A7%8D%E0%A6%98%E0%A6%A8%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A7%AF%E0%A7%A6%E0%A7%A6-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE</guid>
      <pubDate>Sat, 21 Nov 2026 15:11:59 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2025/01/09/-81ed0d274a4671241479e2d3c2a6243b.jpg?jadewits_media_id=956355" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2025/01/09/-81ed0d274a4671241479e2d3c2a6243b.jpg?jadewits_media_id=956355" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2025/01/09/-81ed0d274a4671241479e2d3c2a6243b.jpg?jadewits_media_id=956355" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ট্রাফিক আইন লঙ্ঘনে দুই দিনে ৯০০ মামলা" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর বিভিন্ন এলাকায় ট্রাফিক আইন লঙ্ঘনকারীদের বিরুদ্ধে অভিযান চালিয়ে গত দুই দিনে ৯০০টি মামলা করেছে ডিএমপির ট্রাফিক বিভাগ।&amp;nbsp;
বৃহস্পতি ও শুক্রবার (১৯ ও ২০ নভেম্বর) ডিএমপির ট্রাফিক বিভাগ রাজধানীর বিভিন্ন এলাকায় অভিযান চালিয়ে এসব মামলা করে।
শনিবার ডিএমপির সংবাদ বিজ্ঞপ্তিতে বলা হয়েছে, ট্রাফিক-রমনা&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/982341/%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AB%E0%A6%BF%E0%A6%95-%E0%A6%86%E0%A6%87%E0%A6%A8-%E0%A6%B2%E0%A6%99%E0%A7%8D%E0%A6%98%E0%A6%A8%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A7%AF%E0%A7%A6%E0%A7%A6-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ফ্যাসিবাদমুক্ত বাংলাদেশকে আত্মমর্যাদাশীল রাষ্ট্র হিসেবে প্রতিষ্ঠায় সরকার বদ্ধপরিকর: প্রধানমন্ত্রী</title>
      <link>https://www.banglatribune.com/national/982340/%E0%A6%AB%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%95%E0%A7%87-%E0%A6%86%E0%A6%A4%E0%A7%8D%E0%A6%AE%E0%A6%AE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A6%E0%A6%BE%E0%A6%B6%E0%A7%80%E0%A6%B2-%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/national/982340/%E0%A6%AB%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%95%E0%A7%87-%E0%A6%86%E0%A6%A4%E0%A7%8D%E0%A6%AE%E0%A6%AE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A6%E0%A6%BE%E0%A6%B6%E0%A7%80%E0%A6%B2-%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0</guid>
      <pubDate>Sat, 21 Nov 2026 15:10:01 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/99f662b24cc79710b5d4ab8fde6b616b-6b015f9666673.jpg?jadewits_media_id=1056183" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/99f662b24cc79710b5d4ab8fde6b616b-6b015f9666673.jpg?jadewits_media_id=1056183" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/99f662b24cc79710b5d4ab8fde6b616b-6b015f9666673.jpg?jadewits_media_id=1056183" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফ্যাসিবাদমুক্ত বাংলাদেশকে আত্মমর্যাদাশীল রাষ্ট্র হিসেবে প্রতিষ্ঠায় সরকার বদ্ধপরিকর: প্রধানমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;ফ্যাসিবাদমুক্ত বাংলাদেশকে বিশ্বের দরবারে একটি অনুকরণীয় ও আত্মমর্যাদাশীল রাষ্ট্র হিসেবে পুনঃপ্রতিষ্ঠা করতে বর্তমান সরকার বদ্ধপরিকর বলে জানিয়েছেন প্রধানমন্ত্রী তারেক রহমান। শনিবার (২১ নভেম্বর) সশস্ত্র বাহিনী দিবস উপলক্ষে সশস্ত্র বাহিনীর খেতাবপ্রাপ্ত বীর মুক্তিযোদ্ধা এবং তাদের উত্তরাধিকারীদের জন্যে আয়ো&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/982340/%E0%A6%AB%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%95%E0%A7%87-%E0%A6%86%E0%A6%A4%E0%A7%8D%E0%A6%AE%E0%A6%AE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A6%E0%A6%BE%E0%A6%B6%E0%A7%80%E0%A6%B2-%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ঢাকা মেডিক্যালে কেন্দ্রীয় কারাগারের বন্দির মৃত্যু</title>
      <link>https://www.banglatribune.com/law-and-crime/982339/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%AE%E0%A7%87%E0%A6%A1%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%95%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A7%9F-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%97%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%BF%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/982339/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%AE%E0%A7%87%E0%A6%A1%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%95%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A7%9F-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%97%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%BF%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81</guid>
      <pubDate>Sat, 21 Nov 2026 15:02:33 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2023/12/29/-85c4dcb3c927b6f08a7ec11fb2b903b4.jpg?jadewits_media_id=894970" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2023/12/29/-85c4dcb3c927b6f08a7ec11fb2b903b4.jpg?jadewits_media_id=894970" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2023/12/29/-85c4dcb3c927b6f08a7ec11fb2b903b4.jpg?jadewits_media_id=894970" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঢাকা মেডিক্যালে কেন্দ্রীয় কারাগারের বন্দির মৃত্যু" /&gt;&lt;/p&gt;&lt;p&gt;ঢাকা কেন্দ্রীয় কারাগারের (কেরানীগঞ্জ) এক বন্দির মৃত্যু হয়েছে। তার নাম জাহাঙ্গীর হোসেন (৫৭)। শুক্রবার (২০ নভেম্বর) দিবাগত রাতে তার মৃত্যু হয়।
ঢাকা মেডিক্যাল কলেজ (ঢামেক) পুলিশ ফাঁড়ির উপ-পরিদর্শক (এসআই) মো. সেলিম মিয়া বলেন, অসুস্থ অবস্থায় কারারক্ষীরা ওই বন্দিকে শুক্রবার দিবাগত রাত ১টার দিকে ঢামেক হাস&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/982339/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%AE%E0%A7%87%E0%A6%A1%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%95%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A7%9F-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%97%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%BF%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>আশুলিয়ায় শ্রমিকদের কর্মবিরতি, পুলিশের সঙ্গে ধাওয়া-পাল্টাধাওয়া</title>
      <link>https://www.banglatribune.com/country/dhaka/982338/%E0%A6%86%E0%A6%B6%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A6%A4%E0%A6%BF-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/dhaka/982338/%E0%A6%86%E0%A6%B6%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A6%A4%E0%A6%BF-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87</guid>
      <pubDate>Sat, 21 Nov 2026 15:13:26 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/dbef87a78be28a907309b6145500b262-6b015dba6305d.jpg?jadewits_media_id=1056182" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/dbef87a78be28a907309b6145500b262-6b015dba6305d.jpg?jadewits_media_id=1056182" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/dbef87a78be28a907309b6145500b262-6b015dba6305d.jpg?jadewits_media_id=1056182" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আশুলিয়ায় শ্রমিকদের কর্মবিরতি, পুলিশের সঙ্গে ধাওয়া-পাল্টাধাওয়া" /&gt;&lt;/p&gt;&lt;p&gt;সাভার ও আশুলিয়ার শিল্পাঞ্চলে ন্যূনতম মজুরি ৩০ হাজার টাকা নির্ধারণসহ বিভিন্ন দাবিতে পোশাকশ্রমিকদের চলমান আন্দোলনকে কেন্দ্র করে পুলিশের সঙ্গে শ্রমিকদের ধাওয়া-পাল্টাধাওয়ার ঘটনা ঘটেছে। এ সময় শ্রমিকদের ছত্রভঙ্গ করতে পুলিশ কাঁদানে গ্যাসের শেল ও সাউন্ড গ্রেনেড নিক্ষেপ করে।
শনিবার (২১ নভেম্বর) বেলা পৌনে ১১ট&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/dhaka/982338/%E0%A6%86%E0%A6%B6%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A6%A4%E0%A6%BF-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>শতভাগ দেশীয় পণ্য নিয়ে আগারগাঁওয়ে এসএমই পণ্যমেলা শুরু রবিবার</title>

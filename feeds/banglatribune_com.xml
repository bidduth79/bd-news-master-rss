      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/981174/%E0%A6%AE%E0%A6%B9%E0%A6%BF%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%8F%E0%A6%95%E0%A6%BE%E0%A6%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%A6</guid>
      <pubDate>Mon, 16 Nov 2026 05:30:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/8bdeb2caf7ba8ad302b860d6d772a420-6afa2a3e89ca4.jpg?jadewits_media_id=1055199" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/8bdeb2caf7ba8ad302b860d6d772a420-6afa2a3e89ca4.jpg?jadewits_media_id=1055199" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/8bdeb2caf7ba8ad302b860d6d772a420-6afa2a3e89ca4.jpg?jadewits_media_id=1055199" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মহিউদ্দিন রুদ্রের গ্রেফতারের ঘটনায় একাই প্রতিবাদ জানালেন এক আইনজীবী" /&gt;&lt;/p&gt;&lt;p&gt;&amp;lsquo;মব&amp;rsquo; করে বাংলাদেশ সুপ্রিম কোর্টের নিয়মিত আইনজীবী মহিউদ্দিন রুদ্রকে গ্রেফতারের সময় প্রকাশ্যে হেনস্তা ও অপদস্থ করার অভিযোগ তুলে প্রতিবাদ জানিয়েছেন ব্যারিস্টার এম আশরাফুল ইসলাম।
এ ঘটনায় আইনজীবীদের পেশাগত মর্যাদা, স্বাধীনতা ও নিরাপত্তা নিয়ে প্রশ্ন তুলে রবিবার (১৫ নভেম্বর) সুপ্রিম কোর্ট আইনজী&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/981174/%E0%A6%AE%E0%A6%B9%E0%A6%BF%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%8F%E0%A6%95%E0%A6%BE%E0%A6%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%A6">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>শুরুর আঘাত ইতালির, এরপর গুণে গুণে ৪ গোল দিলো বেলজিয়াম</title>
      <link>https://www.banglatribune.com/sport/football/981177/%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81%E0%A6%B0-%E0%A6%86%E0%A6%98%E0%A6%BE%E0%A6%A4-%E0%A6%87%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%B0-%E0%A6%8F%E0%A6%B0%E0%A6%AA%E0%A6%B0-%E0%A6%97%E0%A7%81%E0%A6%A3%E0%A7%87-%E0%A6%97%E0%A7%81%E0%A6%A3%E0%A7%87-%E0%A7%AA-%E0%A6%97%E0%A7%8B%E0%A6%B2-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%8B</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/football/981177/%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81%E0%A6%B0-%E0%A6%86%E0%A6%98%E0%A6%BE%E0%A6%A4-%E0%A6%87%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%B0-%E0%A6%8F%E0%A6%B0%E0%A6%AA%E0%A6%B0-%E0%A6%97%E0%A7%81%E0%A6%A3%E0%A7%87-%E0%A6%97%E0%A7%81%E0%A6%A3%E0%A7%87-%E0%A7%AA-%E0%A6%97%E0%A7%8B%E0%A6%B2-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%8B</guid>
      <pubDate>Mon, 16 Nov 2026 05:12:49 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/55e532a810a7d169b33c847e8dd27a09-6afa3c523bc41.jpg?jadewits_media_id=1055201" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/55e532a810a7d169b33c847e8dd27a09-6afa3c523bc41.jpg?jadewits_media_id=1055201" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/55e532a810a7d169b33c847e8dd27a09-6afa3c523bc41.jpg?jadewits_media_id=1055201" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শুরুর আঘাত ইতালির, এরপর গুণে গুণে ৪ গোল দিলো বেলজিয়াম" /&gt;&lt;/p&gt;&lt;p&gt;ঘরের মাঠে শুরুতেই বেলজিয়ামকে কাঁপিয়ে দেয় অতিথি ইতালি। তবে সেখান থেকে দুর্দান্ত ক্যামব্যাক করে উয়েফা নেশনস লিগের কোয়ার্টার ফাইনালে জায়গা করে নিয়েছে ডি ব্রুইনারা।
ব্রেন্টফোর্ডের ডিফেন্ডার মাইকেল কায়োডের ক্রস থেকে ইতালি স্ট্রাইকার পিও এসপোসিতো গোল করে ইতালিকে এগিয়ে দেন ১০ মিনিটে। ১৫ ম্যাচে এটি ছিল তার &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/football/981177/%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81%E0%A6%B0-%E0%A6%86%E0%A6%98%E0%A6%BE%E0%A6%A4-%E0%A6%87%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%B0-%E0%A6%8F%E0%A6%B0%E0%A6%AA%E0%A6%B0-%E0%A6%97%E0%A7%81%E0%A6%A3%E0%A7%87-%E0%A6%97%E0%A7%81%E0%A6%A3%E0%A7%87-%E0%A7%AA-%E0%A6%97%E0%A7%8B%E0%A6%B2-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%8B">বাংলা ট্রিবিউন</source>
    </item>

      <pubDate>Wed, 18 Nov 2026 18:02:21 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/03/15/f33ff88e4b0bfe1b6655ba531a3e7b5a-69b6b0759b210.jpg?jadewits_media_id=1015440" length="0" type="image/jpeg" />

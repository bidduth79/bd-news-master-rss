    <item>
      <title>ঢাবিতে ককটেল বিস্ফোরণের পর আটক ব্যক্তি বললেন, ‘আমি বিএনপি করি ভাই’</title>
      <link>https://www.banglatribune.com/law-and-crime/979665/%E0%A6%A2%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A7%87%E0%A6%A8-%E2%80%98%E0%A6%86%E0%A6%AE%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/979665/%E0%A6%A2%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A7%87%E0%A6%A8-%E2%80%98%E0%A6%86%E0%A6%AE%E0%A6%BF</guid>
      <pubDate>Sun, 08 Nov 2026 20:16:03 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/a94138aaa173c943031dab542d5a6d60-6af08379ae0d4.jpg?jadewits_media_id=1053921" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/a94138aaa173c943031dab542d5a6d60-6af08379ae0d4.jpg?jadewits_media_id=1053921" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/a94138aaa173c943031dab542d5a6d60-6af08379ae0d4.jpg?jadewits_media_id=1053921" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঢাবিতে ককটেল বিস্ফোরণের পর আটক ব্যক্তি বললেন, ‘আমি বিএনপি করি ভাই’" /&gt;&lt;/p&gt;&lt;p&gt;ঢাকা বিশ্ববিদ্যালয় এলাকায় ককটেল নিক্ষেপের ঘটনায় দুই জনকে পিটুনি দিয়ে শাহবাগ থানা পুলিশের কাছে হস্তান্তর করা হয়েছে। পিটুনি দেওয়ার পর আটক এক ব্যক্তি কাঁদতে কাঁদতে বলেন, ‘আমি বিএনপি করি ভাই’। 
রবিবার (৮ নভেম্বর) সন্ধ্যায় ঢাকা বিশ্ববিদ্যালয় (ঢাবি) ক্যাম্পাসে অন্তত চারটি ককটেল বিস্ফোরণের খবর পাওয়া গেছে। &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/979665/%E0%A6%A2%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A7%87%E0%A6%A8-%E2%80%98%E0%A6%86%E0%A6%AE%E0%A6%BF">বাংলা ট্রিবিউন</source>

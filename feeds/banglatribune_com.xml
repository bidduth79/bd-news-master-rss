      <link>https://www.banglatribune.com/national/981028/%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A7%9F%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A6%A4%E0%A6%BE-%E0%A6%93-%E0%A6%9C%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A6%A6%E0%A6%BF%E0%A6%B9%E0%A6%BF-%E0%A6%A8%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%9A%E0%A6%BF%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/national/981028/%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A7%9F%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A6%A4%E0%A6%BE-%E0%A6%93-%E0%A6%9C%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A6%A6%E0%A6%BF%E0%A6%B9%E0%A6%BF-%E0%A6%A8%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%9A%E0%A6%BF%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%BE</guid>
      <pubDate>Sun, 15 Nov 2026 14:33:46 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/ac735a0164ba6d620b9eca7d0ec23ef4-6af96e16195d1.jpg?jadewits_media_id=1055081" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/ac735a0164ba6d620b9eca7d0ec23ef4-6af96e16195d1.jpg?jadewits_media_id=1055081" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/ac735a0164ba6d620b9eca7d0ec23ef4-6af96e16195d1.jpg?jadewits_media_id=1055081" style="max-width:100%;height:auto;margin-bottom:10px;" alt="উন্নয়ন প্রকল্পের স্বচ্ছতা ও জবাবদিহি নিশ্চিত করা সংসদ সদস্যদের দায়িত্ব: স্পিকার" /&gt;&lt;/p&gt;&lt;p&gt;আইন প্রণয়নের পাশাপাশি সরকারের উন্নয়ন প্রকল্পের স্বচ্ছতা ও জবাবদিহি নিশ্চিত করাও সংসদ-সদস্যদের অন্যতম দায়িত্ব বলে মন্তব্য করেছেন জাতীয় সংসদের স্পিকার মেজর (অব.) হাফিজ উদ্দিন আহমদ বীর বিক্রম। রবিবার (১৫ নভেম্বর) জাতীয় সংসদের শপথ কক্ষে জাতিসংঘ উন্নয়ন কর্মসূচি (ইউএনডিপি) আয়োজিত এক অরিয়েন্টেশন কর্মসূচিতে&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/981028/%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A7%9F%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A6%A4%E0%A6%BE-%E0%A6%93-%E0%A6%9C%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A6%A6%E0%A6%BF%E0%A6%B9%E0%A6%BF-%E0%A6%A8%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%9A%E0%A6%BF%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%BE">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>দেশে ফেরার পথে আবার অসুস্থ ড. মোশাররফ, সিঙ্গাপুরে হাসপাতালে ভর্তি</title>
      <link>https://www.banglatribune.com/politics/bnp/981027/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%86%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%B8%E0%A7%81%E0%A6%B8%E0%A7%8D%E0%A6%A5-%E0%A6%A1.-%E0%A6%AE%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%B0%E0%A6%B0%E0%A6%AB-%E0%A6%B8%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/politics/bnp/981027/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%86%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%B8%E0%A7%81%E0%A6%B8%E0%A7%8D%E0%A6%A5-%E0%A6%A1.-%E0%A6%AE%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%B0%E0%A6%B0%E0%A6%AB-%E0%A6%B8%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87</guid>
      <pubDate>Sun, 15 Nov 2026 14:32:45 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/6e538f3b2821562094d7b58bb7547146-6af96db65f9bc.jpg?jadewits_media_id=1055079" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/6e538f3b2821562094d7b58bb7547146-6af96db65f9bc.jpg?jadewits_media_id=1055079" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/6e538f3b2821562094d7b58bb7547146-6af96db65f9bc.jpg?jadewits_media_id=1055079" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দেশে ফেরার পথে আবার অসুস্থ ড. মোশাররফ, সিঙ্গাপুরে হাসপাতালে ভর্তি" /&gt;&lt;/p&gt;&lt;p&gt;সিঙ্গাপুরে চিকিৎসাধীন বিএনপির জাতীয় স্থায়ী কমিটির সদস্য ড. খন্দকার মোশাররফ হোসেনের রবিবার (১৫ নভেম্বর) নির্ধারিত ফ্লাইটে দেশে ফেরার কথা ছিল। তবে বিমানবন্দরে আসার সময় তিনি হঠাৎ শারীরিকভাবে অসুস্থবোধ করেন। তাৎক্ষণিকভাবে তাকে সিঙ্গাপুরের ন্যাশনাল ইউনিভার্সিটি হসপিটালে নেওয়া হয় এবং পুনরায় হাসপাতালে&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/politics/bnp/981027/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%86%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%B8%E0%A7%81%E0%A6%B8%E0%A7%8D%E0%A6%A5-%E0%A6%A1.-%E0%A6%AE%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%B0%E0%A6%B0%E0%A6%AB-%E0%A6%B8%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>গাজীপুরে ১৩ পোশাক কারখানা বন্ধ, গুরুত্বপূর্ণ স্থানে পুলিশ মোতায়েন</title>

      <guid isPermaLink="true">https://www.banglatribune.com/others/environment/980955/%E0%A6%9C%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%B0%E0%A7%82%E0%A6%AA%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF-%E0%A6%93-%E0%A6%A8%E0%A6%BE%E0%A6%97%E0%A6%B0%E0%A6%BF%E0%A6%95-%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%9C%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Sun, 15 Nov 2026 00:22:23 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/59a51790751042c0d67d0a4e812a636b-6af8a6d75ff39.jpg?jadewits_media_id=1055023" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/59a51790751042c0d67d0a4e812a636b-6af8a6d75ff39.jpg?jadewits_media_id=1055023" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/59a51790751042c0d67d0a4e812a636b-6af8a6d75ff39.jpg?jadewits_media_id=1055023" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জ্বালানি রূপান্তরে সংসদ সদস্য ও নাগরিক সমাজের ঐক্যবদ্ধ উদ্যোগের আহ্বান" /&gt;&lt;/p&gt;&lt;p&gt;নবায়নযোগ্য জ্বালানিতে দ্রুত উত্তরণ ও প্রয়োজনীয় অর্থায়ন নিশ্চিত করতে সংসদ সদস্য ও নাগরিক সমাজের সমন্বিত উদ্যোগের আহ্বান জানানো হয়েছে। তুরস্কের আনতালিয়ায় চলমান জাতিসংঘের জলবায়ু সম্মেলন কপ৩১-এর বাংলাদেশ প্যাভিলিয়নে ১৩ নভেম্বর আয়োজিত &amp;lsquo;পিপলস এনার্জি ট্রানজিশন রোডম্যাপ&amp;rsquo; বিষয়ক আন্তর্জাতিক সংলাপ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/others/environment/980955/%E0%A6%9C%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%B0%E0%A7%82%E0%A6%AA%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF-%E0%A6%93-%E0%A6%A8%E0%A6%BE%E0%A6%97%E0%A6%B0%E0%A6%BF%E0%A6%95-%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%9C%E0%A7%87%E0%A6%B0">বাংলা ট্রিবিউন</source>

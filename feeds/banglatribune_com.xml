    <item>
      <title>হামজার পর দেশে এসেছেন ফারহান আলী ওয়াহিদ</title>
      <link>https://www.banglatribune.com/sport/football/979935/%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%8F%E0%A6%B8%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%AB%E0%A6%BE%E0%A6%B0%E0%A6%B9%E0%A6%BE%E0%A6%A8-%E0%A6%86%E0%A6%B2%E0%A7%80-%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A6</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/football/979935/%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%8F%E0%A6%B8%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%AB%E0%A6%BE%E0%A6%B0%E0%A6%B9%E0%A6%BE%E0%A6%A8-%E0%A6%86%E0%A6%B2%E0%A7%80-%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A6</guid>
      <pubDate>Tue, 10 Nov 2026 05:08:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/0c6f69b14771302d941a8f0ad299b14d-6af240f5b76f6.jpg?jadewits_media_id=1054143" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/0c6f69b14771302d941a8f0ad299b14d-6af240f5b76f6.jpg?jadewits_media_id=1054143" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/0c6f69b14771302d941a8f0ad299b14d-6af240f5b76f6.jpg?jadewits_media_id=1054143" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হামজার পর দেশে এসেছেন ফারহান আলী ওয়াহিদ" /&gt;&lt;/p&gt;&lt;p&gt;সাফ চ্যাম্পিয়নশিপে বুধবার (১১ নভেম্বর) শ্রীলঙ্কার বিপক্ষে খেলবে বাংলাদেশ। তার আগে জাতীয় ফুটবল দলের ক্যাম্পে যোগ দিতে ঢাকায় এসেছেন ফারহান আলী ওয়াহিদ। সোমবার (৯ নভেম্বর) রাতে দেশে পৌঁছান এই ফুটবলার।
এর আগে জাতীয় দলের আরেক প্রবাসী ফুটবলার হামজা চৌধুরী ঢাকায় এসেছেন। হামজার পর ফারহানের আগমনে পূর্ণতা পাচ্&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/football/979935/%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%8F%E0%A6%B8%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%AB%E0%A6%BE%E0%A6%B0%E0%A6%B9%E0%A6%BE%E0%A6%A8-%E0%A6%86%E0%A6%B2%E0%A7%80-%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A6">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>রাজধানীতে ছাদ থেকে ফেলে শিশুকে হত্যার অভিযোগ, তরুণী আটক</title>
      <link>https://www.banglatribune.com/others/capital-city/979934/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A6%A6-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97</link>
      <guid isPermaLink="true">https://www.banglatribune.com/others/capital-city/979934/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A6%A6-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97</guid>
      <pubDate>Tue, 10 Nov 2026 04:42:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/03/24/c57c1f376827251f8781e0eaee735873-69c25945266d3.jpg?jadewits_media_id=1016515" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/03/24/c57c1f376827251f8781e0eaee735873-69c25945266d3.jpg?jadewits_media_id=1016515" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/03/24/c57c1f376827251f8781e0eaee735873-69c25945266d3.jpg?jadewits_media_id=1016515" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজধানীতে ছাদ থেকে ফেলে শিশুকে হত্যার অভিযোগ, তরুণী আটক" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর যাত্রাবাড়ীর মীর হাজীরবাগে পাঁচতলা একটি ভবনের ছাদ থেকে আবিদা (৪) নামে এক শিশুকে ফেলে দিয়ে হত্যার অভিযোগ উঠেছে। এ ঘটনায় জিজ্ঞাসাবাদের জন্য পাশের ফ্ল্যাটের নিটল (২৬) নামে এক তরুণীকে আটক করেছে পুলিশ।
সোমবার (৯ নভেম্বর) বিকাল সাড়ে ৫টার দিকে মীর হাজীরবাগের ৪৬১ নম্বর বেলাল হোসেনের বাড়িতে এ ঘটনা ঘট&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/others/capital-city/979934/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A6%A6-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>বাসার সামনে স্কুলছাত্রীকে ছুরিকাঘাত করা কিশোর গ্রেফতার</title>
      <link>https://www.banglatribune.com/country/khulna/979933/%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%9B%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%98%E0%A6%BE%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%BE-%E0%A6%95%E0%A6%BF%E0%A6%B6%E0%A7%8B%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/khulna/979933/%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%9B%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%98%E0%A6%BE%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%BE-%E0%A6%95%E0%A6%BF%E0%A6%B6%E0%A7%8B%E0%A6%B0</guid>
      <pubDate>Tue, 10 Nov 2026 04:12:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/41e7a47b291edf616b332e14c6fee71f-6af236232eee7.jpg?jadewits_media_id=1054142" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/41e7a47b291edf616b332e14c6fee71f-6af236232eee7.jpg?jadewits_media_id=1054142" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/41e7a47b291edf616b332e14c6fee71f-6af236232eee7.jpg?jadewits_media_id=1054142" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাসার সামনে স্কুলছাত্রীকে ছুরিকাঘাত করা কিশোর গ্রেফতার" /&gt;&lt;/p&gt;&lt;p&gt;কুষ্টিয়ায় দিনদুপুরে বাসার সামনে দশম শ্রেণির এক স্কুলছাত্রীকে উপর্যুপরি ছুরিকাঘাত করা কিশোরকে গ্রেফতার করেছে জেলা পুলিশ। সোমবার (৯ নভেম্বর) রাতে কুষ্টিয়া জেলা পুলিশের ফেসবুক পেজে দেওয়া এক স্ট্যাটাসে এ তথ্য নিশ্চিত করেছে।
জানা গেছে, সোমবার বেলা ১টা ১১ মিনিটের দিকে কুষ্টিয়া শহরের থানাপাড়া এলাকায় এ ঘটনা&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/khulna/979933/%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%9B%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%98%E0%A6%BE%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%BE-%E0%A6%95%E0%A6%BF%E0%A6%B6%E0%A7%8B%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>দক্ষিণ আফ্রিকা সফরে বাংলাদেশের ব্যাটিং কোচ প্রোটিয়া অলরাউন্ডার</title>
      <link>https://www.banglatribune.com/sport/cricket/979932/%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%A3-%E0%A6%86%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE-%E0%A6%B8%E0%A6%AB%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9F%E0%A6%BF%E0%A6%82-%E0%A6%95%E0%A7%8B%E0%A6%9A</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/cricket/979932/%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%A3-%E0%A6%86%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE-%E0%A6%B8%E0%A6%AB%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9F%E0%A6%BF%E0%A6%82-%E0%A6%95%E0%A7%8B%E0%A6%9A</guid>
      <pubDate>Tue, 10 Nov 2026 03:41:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/1db9b3d9775c744880f5c1ec966b24b6-6af22be187856.jpg?jadewits_media_id=1054141" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/1db9b3d9775c744880f5c1ec966b24b6-6af22be187856.jpg?jadewits_media_id=1054141" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/1db9b3d9775c744880f5c1ec966b24b6-6af22be187856.jpg?jadewits_media_id=1054141" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দক্ষিণ আফ্রিকা সফরে বাংলাদেশের ব্যাটিং কোচ প্রোটিয়া অলরাউন্ডার" /&gt;&lt;/p&gt;&lt;p&gt;দক্ষিণ আফ্রিকা সফরে বাংলাদেশের ব্যাটিং বিশেষজ্ঞ হিসেবে কাজ করবেন সাবেক প্রোটিয়া অলরাউন্ডার ডেল বেনকেনস্টাইন। আসন্ন টেস্ট, ওয়ানডে ও টি-টোয়েন্টি সিরিজে বাংলাদেশ দলের সঙ্গে থাকবেন ৫২ বছর বয়সী এই কোচ।
সোমবার (৯ নভেম্বর) এক সংবাদ বিজ্ঞপ্তিতে বিষয়টি জানিয়েছে বাংলাদেশ ক্রিকেট বোর্ড (বিসিবি)।
প্রথম শ্রেণির &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/cricket/979932/%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%A3-%E0%A6%86%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE-%E0%A6%B8%E0%A6%AB%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9F%E0%A6%BF%E0%A6%82-%E0%A6%95%E0%A7%8B%E0%A6%9A">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>মিরপুরে ককটেল বিস্ফোরণে একজন আহত</title>
      <link>https://www.banglatribune.com/others/capital-city/979931/%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A6%9C%E0%A6%A8-%E0%A6%86%E0%A6%B9%E0%A6%A4</link>
      <guid isPermaLink="true">https://www.banglatribune.com/others/capital-city/979931/%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A6%9C%E0%A6%A8-%E0%A6%86%E0%A6%B9%E0%A6%A4</guid>

      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/5c7ef672219dcf5836a3b20e6a026e5c-6afdf4585f0e2.jpg?jadewits_media_id=1055777" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/5c7ef672219dcf5836a3b20e6a026e5c-6afdf4585f0e2.jpg?jadewits_media_id=1055777" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/5c7ef672219dcf5836a3b20e6a026e5c-6afdf4585f0e2.jpg?jadewits_media_id=1055777" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গার্মেন্টস কর্মী নুপুরের মৃত্যুর খবর গুজব, বিভ্রান্ত না হওয়ার অনুরোধ ডিএমপির" /&gt;&lt;/p&gt;&lt;p&gt;সামাজিক যোগাযোগমাধ্যমে গার্মেন্টস কর্মী নুপুরের মৃত্যুর যে খবর প্রচার করা হচ্ছে, তা সম্পূর্ণ মিথ্যা ও ভিত্তিহীন। তিনি মারা যাননি; বর্তমানে হাসপাতালে চিকিৎসাধীন অবস্থায় আছেন। &amp;nbsp;বুধবার (১৮ নভেম্বর) রাত ১০টায় ভিকটিম নুপুরের পরিবার এই তথ্য নিশ্চিত করেছেন। চিকিৎসকদের বরাত দিয়ে নুপুরের পরিবার জানিয়েছে&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/others/981847/%E0%A6%97%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%B8-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%80-%E0%A6%A8%E0%A7%81%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%B0-%E0%A6%96%E0%A6%AC%E0%A6%B0-%E0%A6%97%E0%A7%81%E0%A6%9C%E0%A6%AC">বাংলা ট্রিবিউন</source>
    </item>

      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/7a12f8faa9fae3a7ace3c1c4f25778e0-6afac0e6c8668.jpg?jadewits_media_id=1055253" medium="image" />

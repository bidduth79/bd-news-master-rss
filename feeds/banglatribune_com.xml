      <guid isPermaLink="true">https://www.banglatribune.com/country/dhaka/981756/%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%BF%E0%A6%B8%E0%A6%BE-%E0%A6%A7%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A6%A3-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A7%9F-%E0%A6%B8%E0%A7%8B%E0%A6%B9%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A6%A3%E0%A7%8D%E0%A6%A1-%E0%A6%AC%E0%A6%B9%E0%A6%BE%E0%A6%B2</guid>
      <pubDate>Wed, 18 Nov 2026 18:25:34 +0600</pubDate>

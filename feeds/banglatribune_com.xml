    <item>
      <title>মেশিন দিয়ে তৈরি করছিলেন ইয়াবা, শিখেছেন ইউটিউব ও চ্যাটজিপিটি থেকে</title>
      <link>https://www.banglatribune.com/country/chitagong/982642/%E0%A6%AE%E0%A7%87%E0%A6%B6%E0%A6%BF%E0%A6%A8-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A4%E0%A7%88%E0%A6%B0%E0%A6%BF-%E0%A6%95%E0%A6%B0%E0%A6%9B%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%87%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A6%BE-%E0%A6%B6%E0%A6%BF%E0%A6%96%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%87%E0%A6%89%E0%A6%9F%E0%A6%BF%E0%A6%89%E0%A6%AC-%E0%A6%93</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/chitagong/982642/%E0%A6%AE%E0%A7%87%E0%A6%B6%E0%A6%BF%E0%A6%A8-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A4%E0%A7%88%E0%A6%B0%E0%A6%BF-%E0%A6%95%E0%A6%B0%E0%A6%9B%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%87%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A6%BE-%E0%A6%B6%E0%A6%BF%E0%A6%96%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%87%E0%A6%89%E0%A6%9F%E0%A6%BF%E0%A6%89%E0%A6%AC-%E0%A6%93</guid>
      <pubDate>Mon, 23 Nov 2026 05:04:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/5cb01f4f49835ceb041a150f1a0485f1-6b0363ad9f7d0.jpg?jadewits_media_id=1056444" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/5cb01f4f49835ceb041a150f1a0485f1-6b0363ad9f7d0.jpg?jadewits_media_id=1056444" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/5cb01f4f49835ceb041a150f1a0485f1-6b0363ad9f7d0.jpg?jadewits_media_id=1056444" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মেশিন দিয়ে তৈরি করছিলেন ইয়াবা, শিখেছেন ইউটিউব ও চ্যাটজিপিটি থেকে" /&gt;&lt;/p&gt;&lt;p&gt;বন্দর নগরী চট্টগ্রামে উদ্ধার হয়েছে মাদক ইয়াবা তৈরির মেশিনসহ বিভিন্ন সরঞ্জাম। এ মেশিনে তৈরি ইয়াবা দীর্ঘ দিন ধরে বিক্রি করা হচ্ছে চট্টগ্রামসহ বিভিন্ন এলাকায়। এ ঘটনায় জড়িত থাকার অভিযোগে পুলিশ একজনকে গ্রেফতার করেছে। শনিবার (২১ নভেম্বর) রাতে এ অভিযান পরিচালনা করা হয়।&amp;nbsp;
গ্রেফতার ব্যক্তির নাম তৌহিদুল আ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/chitagong/982642/%E0%A6%AE%E0%A7%87%E0%A6%B6%E0%A6%BF%E0%A6%A8-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A4%E0%A7%88%E0%A6%B0%E0%A6%BF-%E0%A6%95%E0%A6%B0%E0%A6%9B%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%87%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A6%BE-%E0%A6%B6%E0%A6%BF%E0%A6%96%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%87%E0%A6%89%E0%A6%9F%E0%A6%BF%E0%A6%89%E0%A6%AC-%E0%A6%93">বাংলা ট্রিবিউন</source>

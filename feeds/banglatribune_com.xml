      <title>রাইজিং স্টার্স এশিয়া কাপে বাংলাদেশকে নেতৃত্ব দেবেন সাইফ</title>
      <link>https://www.banglatribune.com/sport/cricket/981033/%E0%A6%B0%E0%A6%BE%E0%A6%87%E0%A6%9C%E0%A6%BF%E0%A6%82-%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B8-%E0%A6%8F%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE-%E0%A6%95%E0%A6%BE%E0%A6%AA%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AC-%E0%A6%A6%E0%A7%87%E0%A6%AC%E0%A7%87%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/cricket/981033/%E0%A6%B0%E0%A6%BE%E0%A6%87%E0%A6%9C%E0%A6%BF%E0%A6%82-%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B8-%E0%A6%8F%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE-%E0%A6%95%E0%A6%BE%E0%A6%AA%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AC-%E0%A6%A6%E0%A7%87%E0%A6%AC%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Sun, 15 Nov 2026 14:52:57 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2023/09/28/saif-816f05bd05c5bef7bcd4bd69040edf8a.jpeg?jadewits_media_id=880288" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2023/09/28/saif-816f05bd05c5bef7bcd4bd69040edf8a.jpeg?jadewits_media_id=880288" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2023/09/28/saif-816f05bd05c5bef7bcd4bd69040edf8a.jpeg?jadewits_media_id=880288" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাইজিং স্টার্স এশিয়া কাপে বাংলাদেশকে নেতৃত্ব দেবেন সাইফ" /&gt;&lt;/p&gt;&lt;p&gt;জাতীয় দলের টেস্ট স্কোয়াডের সঙ্গে দক্ষিণ আফ্রিকায় আছেন মোহাম্মদ নাঈম। তার অনুপস্থিতিতে কাতারে অনুষ্ঠেয় রাইজিং স্টার্স এশিয়া কাপের দলে জায়গা পেয়েছেন সাইফ হাসান। শুধু দলে জায়গা পাওয়াই নয়, বাংলাদেশকে নেতৃত্বও দেবেন এই ব্যাটার। আগামী ১৯ নভেম্বর শুরু হবে টুর্নামেন্টটি।
রবিবার চূড়ান্ত দল ঘোষণা করেছে বাংলাদ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/cricket/981033/%E0%A6%B0%E0%A6%BE%E0%A6%87%E0%A6%9C%E0%A6%BF%E0%A6%82-%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B8-%E0%A6%8F%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE-%E0%A6%95%E0%A6%BE%E0%A6%AA%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AC-%E0%A6%A6%E0%A7%87%E0%A6%AC%E0%A7%87%E0%A6%A8">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>সিএমএইচে চিকিৎসা নিতে চাওয়া মাসুদ উদ্দিনের আবেদনের বিষয়ে আদেশ ১৯ নভেম্বর</title>
      <link>https://www.banglatribune.com/law-and-crime/981032/%E0%A6%B8%E0%A6%BF%E0%A6%8F%E0%A6%AE%E0%A6%8F%E0%A6%87%E0%A6%9A%E0%A7%87-%E0%A6%9A%E0%A6%BF%E0%A6%95%E0%A6%BF%E0%A7%8E%E0%A6%B8%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%81%E0%A6%A6-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%AC%E0%A7%87%E0%A6%A6%E0%A6%A8%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/981032/%E0%A6%B8%E0%A6%BF%E0%A6%8F%E0%A6%AE%E0%A6%8F%E0%A6%87%E0%A6%9A%E0%A7%87-%E0%A6%9A%E0%A6%BF%E0%A6%95%E0%A6%BF%E0%A7%8E%E0%A6%B8%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%81%E0%A6%A6-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%AC%E0%A7%87%E0%A6%A6%E0%A6%A8%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Sun, 15 Nov 2026 14:52:27 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/07/15/6898df17cca81d0ba74041219c59cc73-6a57a4ef66ab0.jpg?jadewits_media_id=1033723" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/07/15/6898df17cca81d0ba74041219c59cc73-6a57a4ef66ab0.jpg?jadewits_media_id=1033723" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/07/15/6898df17cca81d0ba74041219c59cc73-6a57a4ef66ab0.jpg?jadewits_media_id=1033723" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সিএমএইচে চিকিৎসা নিতে চাওয়া মাসুদ উদ্দিনের আবেদনের বিষয়ে আদেশ ১৯ নভেম্বর" /&gt;&lt;/p&gt;&lt;p&gt;ঢাকা মেডিক্যাল কলেজ (ঢামেক) হাসপাতাল থেকে সম্মিলিত সামরিক হাসপাতালে (সিএমএইচ) স্থানান্তর হয়ে চিকিৎসা নিতে চেয়ে মানবতাবিরোধী অপরাধের মামলার আসামি লেফটেন্যান্ট জেনারেল (অব.) মাসুদ উদ্দিন চৌধুরীর করা আবেদনের ওপর শুনানি শেষ হয়েছে। এ বিষয়ে আদেশের জন&amp;zwj;্য আগামী ১৯ নভেম্বর দিন ধার্য করেছেন ট্রাইব্যুনাল।&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/981032/%E0%A6%B8%E0%A6%BF%E0%A6%8F%E0%A6%AE%E0%A6%8F%E0%A6%87%E0%A6%9A%E0%A7%87-%E0%A6%9A%E0%A6%BF%E0%A6%95%E0%A6%BF%E0%A7%8E%E0%A6%B8%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%81%E0%A6%A6-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%AC%E0%A7%87%E0%A6%A6%E0%A6%A8%E0%A7%87%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>স্বাস্থ্যমন্ত্রীর হার্টে ব্লক, বিকালে বসানো হতে পারে রিং</title>
      <link>https://www.banglatribune.com/national/981031/%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A7%8D%E0%A6%AF%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A7%87-%E0%A6%AC%E0%A7%8D%E0%A6%B2%E0%A6%95-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%AC%E0%A6%B8%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%B9%E0%A6%A4%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/national/981031/%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A7%8D%E0%A6%AF%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A7%87-%E0%A6%AC%E0%A7%8D%E0%A6%B2%E0%A6%95-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%AC%E0%A6%B8%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%B9%E0%A6%A4%E0%A7%87</guid>
      <pubDate>Sun, 15 Nov 2026 14:48:44 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/c2d43e93b4b79880096e2b4c865f0611-6af971ab70d2d.jpg?jadewits_media_id=1055083" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/c2d43e93b4b79880096e2b4c865f0611-6af971ab70d2d.jpg?jadewits_media_id=1055083" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/c2d43e93b4b79880096e2b4c865f0611-6af971ab70d2d.jpg?jadewits_media_id=1055083" style="max-width:100%;height:auto;margin-bottom:10px;" alt="স্বাস্থ্যমন্ত্রীর হার্টে ব্লক, বিকালে বসানো হতে পারে রিং" /&gt;&lt;/p&gt;&lt;p&gt;স্বাস্থ্য ও পরিবার কল্যাণমন্ত্রী সরদার মো. সাখাওয়াত হোসেনের হৃদযন্ত্রে ব্লক ধরা পড়েছে। রবিবার (১৫ নভেম্বর) বিকালে তার হৃদযন্ত্রে রিং (স্টেন্ট) বসানোর কথা রয়েছে। স্বাস্থ্য ও পরিবার কল্যাণ মন্ত্রণালয়ের তথ্য ও জনসংযোগ কর্মকর্তা পবন চৌধুরী এ তথ্য জানান।&amp;nbsp;
বাংলা ট্রিবিউনকে তিনি বলেন, আমার জানা মতে গত&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/981031/%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A7%8D%E0%A6%AF%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A7%87-%E0%A6%AC%E0%A7%8D%E0%A6%B2%E0%A6%95-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%AC%E0%A6%B8%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%B9%E0%A6%A4%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>

    <item>
      <title>হাম উপসর্গে আরও পাঁচজনের মৃত্যু</title>
      <link>https://www.banglatribune.com/health/982167/%E0%A6%B9%E0%A6%BE%E0%A6%AE-%E0%A6%89%E0%A6%AA%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A6%AA%E0%A6%BE%E0%A6%81%E0%A6%9A%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81</link>
      <guid isPermaLink="true">https://www.banglatribune.com/health/982167/%E0%A6%B9%E0%A6%BE%E0%A6%AE-%E0%A6%89%E0%A6%AA%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A6%AA%E0%A6%BE%E0%A6%81%E0%A6%9A%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81</guid>
      <pubDate>Fri, 20 Nov 2026 17:02:26 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/08/10/f6ee68cc9a3520685f63a2d1c8da252b-6a79beae86b0b.jpg?jadewits_media_id=1037806" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/08/10/f6ee68cc9a3520685f63a2d1c8da252b-6a79beae86b0b.jpg?jadewits_media_id=1037806" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/08/10/f6ee68cc9a3520685f63a2d1c8da252b-6a79beae86b0b.jpg?jadewits_media_id=1037806" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হাম উপসর্গে আরও পাঁচজনের মৃত্যু" /&gt;&lt;/p&gt;&lt;p&gt;গত ২৪ ঘণ্টায় সারা দেশে হামের উপসর্গ নিয়ে আরও পাঁচ জনের মৃত্যু হয়েছে। বৃহস্পতিবার (১৯ নভেম্বর) সকাল ৮টা থেকে শুক্রবার (২০ নভেম্বর) সকাল ৮টার মধ্যে এ মৃত্যুর ঘটনা ঘটে। তবে এই সময়ের মধ্যে নিশ্চিত হামে কারো মৃত্যু হয়নি। একই সময়ের মধ্যে হাম ও হামের উপসর্গে আক্রান্ত হয়েছে ১ হাজার ২৭০ জন।&amp;nbsp;
স্বাস্থ্য অ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/health/982167/%E0%A6%B9%E0%A6%BE%E0%A6%AE-%E0%A6%89%E0%A6%AA%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A6%AA%E0%A6%BE%E0%A6%81%E0%A6%9A%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81">বাংলা ট্রিবিউন</source>
    </item>
    <item>

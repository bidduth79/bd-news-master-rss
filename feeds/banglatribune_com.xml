      <guid isPermaLink="true">https://www.banglatribune.com/others/980926/%E0%A6%85%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%B0%E0%A6%95%E0%A6%AE-%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%AF%E0%A7%87%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B2%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%95%E0%A7%87-%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A7%87</guid>
      <pubDate>Sat, 14 Nov 2026 22:22:33 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/5498a639902d50cf023ee95c53efbbb9-6af8747e83ba9.jpg?jadewits_media_id=1054989" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/5498a639902d50cf023ee95c53efbbb9-6af8747e83ba9.jpg?jadewits_media_id=1054989" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/5498a639902d50cf023ee95c53efbbb9-6af8747e83ba9.jpg?jadewits_media_id=1054989" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অন্যরকম বাজার, যেখানে ফেলনা প্লাস্টিকে মিলছে নিত্যপণ্য" /&gt;&lt;/p&gt;&lt;p&gt;বাজারে নিত্যপ্রয়োজনীয় পণ্যের দাম যখন সাধারণ মানুষের সংসারে বাড়তি চাপ তৈরি করছে, তখন রাজধানীর মিরপুরের পল্লবী ডিগ্রি কলেজ মাঠে বসেছে অন্যরকম এক বাজার। এখানে চাল, ডাল, তেল, ডিম কিংবা লবণ কিনতে পকেট থেকে টাকা বের করতে হচ্ছে না। দাম মেটাতে হচ্ছে ফেলে দেওয়া প্লাস্টিক দিয়ে। ঘরের কোণে জমিয়ে রাখা তেলের বোতল&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/others/980926/%E0%A6%85%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%B0%E0%A6%95%E0%A6%AE-%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%AF%E0%A7%87%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B2%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%95%E0%A7%87-%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A7%87">বাংলা ট্রিবিউন</source>

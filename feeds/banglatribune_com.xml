    <item>
      <title>নিজেদের আকাশসীমায় রুশ যুদ্ধবিমান, পাল্টা উড়ান জাপানের</title>
      <link>https://www.banglatribune.com/foreign/asia/981538/%E0%A6%A8%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%95%E0%A6%BE%E0%A6%B6%E0%A6%B8%E0%A7%80%E0%A6%AE%E0%A6%BE%E0%A7%9F-%E0%A6%B0%E0%A7%81%E0%A6%B6-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%AC%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%89%E0%A7%9C%E0%A6%BE%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/asia/981538/%E0%A6%A8%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%95%E0%A6%BE%E0%A6%B6%E0%A6%B8%E0%A7%80%E0%A6%AE%E0%A6%BE%E0%A7%9F-%E0%A6%B0%E0%A7%81%E0%A6%B6-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%AC%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%89%E0%A7%9C%E0%A6%BE%E0%A6%A8</guid>
      <pubDate>Tue, 17 Nov 2026 18:10:32 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/18487c25f0eca367bd8b710d6995c398-6afc435a58915.jpg?jadewits_media_id=1055511" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/18487c25f0eca367bd8b710d6995c398-6afc435a58915.jpg?jadewits_media_id=1055511" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/18487c25f0eca367bd8b710d6995c398-6afc435a58915.jpg?jadewits_media_id=1055511" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নিজেদের আকাশসীমায় রুশ যুদ্ধবিমান, পাল্টা উড়ান জাপানের" /&gt;&lt;/p&gt;&lt;p&gt;জাপানের আকাশসীমায় দুটি সন্দেহভাজন রুশ সামরিক বিমানের অনুপ্রবেশের ঘটনায় যুদ্ধবিমান পাঠিয়েছে দেশটির সামরিক বাহিনী। এ ঘটনায় মস্কোর কাছে কড়া প্রতিবাদ জানিয়েছে টোকিও। দুই দেশের মধ্যে চলমান উত্তেজনার মধ্যেই মঙ্গলবার (১৭ অক্টোবর) এ ঘটনা ঘটে। তুরস্কের সরকারি সংবাদমাধ্যম টিআরটি ওয়ার্ল্ড এ খবর জানিয়েছে।
জাপান&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/asia/981538/%E0%A6%A8%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%95%E0%A6%BE%E0%A6%B6%E0%A6%B8%E0%A7%80%E0%A6%AE%E0%A6%BE%E0%A7%9F-%E0%A6%B0%E0%A7%81%E0%A6%B6-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%AC%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%89%E0%A7%9C%E0%A6%BE%E0%A6%A8">বাংলা ট্রিবিউন</source>
    </item>

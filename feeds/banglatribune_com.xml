      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/7e0a19352bd0406ce028daee2c6e0f41-6af20d87e51ff.jpg?jadewits_media_id=1054134" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/7e0a19352bd0406ce028daee2c6e0f41-6af20d87e51ff.jpg?jadewits_media_id=1054134" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/7e0a19352bd0406ce028daee2c6e0f41-6af20d87e51ff.jpg?jadewits_media_id=1054134" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গোপালগঞ্জের কয়েকটি স্থানে ককটেল বিস্ফোরণ" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জ শহরসহ জেলার বিভিন্ন স্থানে ককটেল বিস্ফোরণের ঘটনা ঘটেছে। এ ছাড়াও আগুন জ্বেলে ও মশাল মিছিল দিয়ে মহাসড়ক অবরোধের চেষ্টা করেছে নিষিদ্ধ ঘোষিত সংগঠন ছাত্রলীগ।
সোমবার (৯ নভেম্বর) রাত সাড়ে ৮টার দিকে গোপালগঞ্জ সরকারি জেলা স্কুলের সামনে বিকট শব্দে একটি ককটেল বিস্ফোরিত হয়। এরপর রাত ৯টার দিকে সরকার&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/dhaka/979924/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A7%9F%E0%A7%87%E0%A6%95%E0%A6%9F%E0%A6%BF-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3">বাংলা ট্রিবিউন</source>
    </item>

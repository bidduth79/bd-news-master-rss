    <item>
      <title>বিদ্যালয়ের পরিত্যক্ত কক্ষ থেকে ৫০টি ককটেল ও গান পাউডার উদ্ধার</title>
      <link>https://www.banglatribune.com/country/rajshahi/981624/%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%95%E0%A6%95%E0%A7%8D%E0%A6%B7-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A7%AB%E0%A7%A6%E0%A6%9F%E0%A6%BF-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%93-%E0%A6%97%E0%A6%BE%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/rajshahi/981624/%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%95%E0%A6%95%E0%A7%8D%E0%A6%B7-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A7%AB%E0%A7%A6%E0%A6%9F%E0%A6%BF-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%93-%E0%A6%97%E0%A6%BE%E0%A6%A8</guid>
      <pubDate>Wed, 18 Nov 2026 03:29:50 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/e6fe709d2d4031ccacab83bd4c48d92e-6afcc6ed25137.jpg?jadewits_media_id=1055574" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/e6fe709d2d4031ccacab83bd4c48d92e-6afcc6ed25137.jpg?jadewits_media_id=1055574" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/e6fe709d2d4031ccacab83bd4c48d92e-6afcc6ed25137.jpg?jadewits_media_id=1055574" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিদ্যালয়ের পরিত্যক্ত কক্ষ থেকে ৫০টি ককটেল ও গান পাউডার উদ্ধার" /&gt;&lt;/p&gt;&lt;p&gt;পাবনার সাঁথিয়ায় একটি সরকারি প্রাথমিক বিদ্যালয়ের পরিত্যক্ত কক্ষ থেকে গান পাউডার ও অন্তত ৫০টি ককটেল উদ্ধার করেছে স্পেশাল রেসপন্স ব্যাটালিয়ন (এসআরবি)। মঙ্গলবার (১৭ নভেম্বর) সকালে উপজেলার রাউতি সরকারি প্রাথমিক বিদ্যালয়ে অভিযান চালিয়ে এসব ককটেল উদ্ধার করা হয়।
এসআরবি জানায়, ডিসেম্বরকে সামনে রেখে বড় ধরনের &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/rajshahi/981624/%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%95%E0%A6%95%E0%A7%8D%E0%A6%B7-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A7%AB%E0%A7%A6%E0%A6%9F%E0%A6%BF-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%93-%E0%A6%97%E0%A6%BE%E0%A6%A8">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>রাজধানীর একটি ফ্লাট থেকে তরুণীর হাত বাঁধা মরদেহ উদ্ধার</title>
      <link>https://www.banglatribune.com/law-and-crime/981623/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%8F%E0%A6%95%E0%A6%9F%E0%A6%BF-%E0%A6%AB%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%9F-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%A4%E0%A6%B0%E0%A7%81%E0%A6%A3%E0%A7%80%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%A4-%E0%A6%AC%E0%A6%BE%E0%A6%81%E0%A6%A7%E0%A6%BE-%E0%A6%AE%E0%A6%B0%E0%A6%A6%E0%A7%87%E0%A6%B9</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/981623/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%8F%E0%A6%95%E0%A6%9F%E0%A6%BF-%E0%A6%AB%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%9F-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%A4%E0%A6%B0%E0%A7%81%E0%A6%A3%E0%A7%80%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%A4-%E0%A6%AC%E0%A6%BE%E0%A6%81%E0%A6%A7%E0%A6%BE-%E0%A6%AE%E0%A6%B0%E0%A6%A6%E0%A7%87%E0%A6%B9</guid>
      <pubDate>Wed, 18 Nov 2026 02:57:20 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/3cb2c5a6a22611975cbf1570f18b0b84-6afcbf2b15b7a.jpg?jadewits_media_id=1055573" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/3cb2c5a6a22611975cbf1570f18b0b84-6afcbf2b15b7a.jpg?jadewits_media_id=1055573" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/3cb2c5a6a22611975cbf1570f18b0b84-6afcbf2b15b7a.jpg?jadewits_media_id=1055573" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজধানীর একটি ফ্লাট থেকে তরুণীর হাত বাঁধা মরদেহ উদ্ধার" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর মিরপুর রূপনগর থানাধীন ইস্টার্ন হাউজিংয়ের একটি বাসার ফ্লাট থেকে দুহাত বাঁধা রক্তাক্ত অবস্থায় বিথী আক্তার (২৩) নামে এক তরুণীর লাশ উদ্ধার করেছে পুলিশ। মঙ্গলবার (১৭ নভেম্বর) বিকালে ভবনটির তৃতীয় তলার একটি ফ্লাটের ভেতর থেকে মাথায় আঘাতপ্রাপ্ত মরদেহটি উদ্ধার করা হয়। ঘটনার সত্যতা নিশ্চিত করেছেন রূপন&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/981623/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%8F%E0%A6%95%E0%A6%9F%E0%A6%BF-%E0%A6%AB%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%9F-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%A4%E0%A6%B0%E0%A7%81%E0%A6%A3%E0%A7%80%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%A4-%E0%A6%AC%E0%A6%BE%E0%A6%81%E0%A6%A7%E0%A6%BE-%E0%A6%AE%E0%A6%B0%E0%A6%A6%E0%A7%87%E0%A6%B9">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ডিসেম্বরে শেখ হাসিনা দেশে আসবে না, আসার সাহসও নেই: এমপি আখতার</title>
      <link>https://www.banglatribune.com/country/dhaka/981622/%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%87-%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%86%E0%A6%B8%E0%A6%AC%E0%A7%87-%E0%A6%A8%E0%A6%BE-%E0%A6%86%E0%A6%B8%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%B9%E0%A6%B8%E0%A6%93-%E0%A6%A8%E0%A7%87%E0%A6%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/dhaka/981622/%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%87-%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%86%E0%A6%B8%E0%A6%AC%E0%A7%87-%E0%A6%A8%E0%A6%BE-%E0%A6%86%E0%A6%B8%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%B9%E0%A6%B8%E0%A6%93-%E0%A6%A8%E0%A7%87%E0%A6%87</guid>
      <pubDate>Wed, 18 Nov 2026 02:37:19 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/1e8fb0743909132aab86ed6e7b1eac29-6afcbaaec17fc.jpg?jadewits_media_id=1055572" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/1e8fb0743909132aab86ed6e7b1eac29-6afcbaaec17fc.jpg?jadewits_media_id=1055572" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/1e8fb0743909132aab86ed6e7b1eac29-6afcbaaec17fc.jpg?jadewits_media_id=1055572" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডিসেম্বরে শেখ হাসিনা দেশে আসবে না, আসার সাহসও নেই: এমপি আখতার" /&gt;&lt;/p&gt;&lt;p&gt;জাতীয় নাগরিক পার্টির (এনসিপি) সদস্যসচিব ও সংসদ সদস্য আখতার হোসেন বলেছেন, আওয়ামী লীগ একটি ফ্যাসিবাদী সংগঠন। আওয়ামী লীগ যখন ক্ষমতায় থাকে তখন ফ্যাসিবাদ। আর যখন ক্ষমতার বাইরে থাকে তখন নাশকতাবাদ, জঙ্গিবাদ ও সন্ত্রাসবাদ। সেই সন্ত্রাসী কর্মকাণ্ডগুলোই এখনও তারা করছে। ২৪-এর আগে ক্ষমতায় থাকাকালীন সময়ে তারা আ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/dhaka/981622/%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%87-%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%86%E0%A6%B8%E0%A6%AC%E0%A7%87-%E0%A6%A8%E0%A6%BE-%E0%A6%86%E0%A6%B8%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%B9%E0%A6%B8%E0%A6%93-%E0%A6%A8%E0%A7%87%E0%A6%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>বাড্ডায় বাসে আগুন</title>
      <link>https://www.banglatribune.com/law-and-crime/981621/%E0%A6%AC%E0%A6%BE%E0%A6%A1%E0%A7%8D%E0%A6%A1%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8%C2%A0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/981621/%E0%A6%AC%E0%A6%BE%E0%A6%A1%E0%A7%8D%E0%A6%A1%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8%C2%A0</guid>
      <pubDate>Wed, 18 Nov 2026 02:30:56 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/38413ec896688052d4d6996e9800d2e3-6afb30ee14772.jpg?jadewits_media_id=1055370" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/38413ec896688052d4d6996e9800d2e3-6afb30ee14772.jpg?jadewits_media_id=1055370" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/38413ec896688052d4d6996e9800d2e3-6afb30ee14772.jpg?jadewits_media_id=1055370" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাড্ডায় বাসে আগুন" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর বাড্ডার হোসেন মার্কেটের সামনে বৈশাখী পরিবহনের একটি বাসে আগুন দিয়েছে দুর্বৃত্তরা। মঙ্গলবার (১৮ নভেম্বর) রাত ১০টা ৪৫ মিনিটের দিকে এ ঘটনা ঘটে।&amp;nbsp;
বাড্ডা থানার কর্তব্যরত অফিসার হারুনুর রশিদ বাংলা ট্রিবিউনকে এ তথ্য জানান।&amp;nbsp;
তিনি বলেন, দুর্বৃত্তরা একটি বাসে আগুন দিয়েছে। আমাদের স্যারেরা ঘটন&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/981621/%E0%A6%AC%E0%A6%BE%E0%A6%A1%E0%A7%8D%E0%A6%A1%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8%C2%A0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>রাজশাহী বিশ্ববিদ্যালয়ের প্রধান গেটে ককটেল বিস্ফোরণ, প্রক্টরকে হুমকি নিষিদ্ধ ছাত্রলীগ নেতার</title>
      <link>https://www.banglatribune.com/my-campus/981620/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A7%80-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8-%E0%A6%97%E0%A7%87%E0%A6%9F%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2</link>
      <guid isPermaLink="true">https://www.banglatribune.com/my-campus/981620/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A7%80-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8-%E0%A6%97%E0%A7%87%E0%A6%9F%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2</guid>
      <pubDate>Wed, 18 Nov 2026 02:15:14 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/7584b9495722bd4f4d701dd903725955-6afcb5823bde5.jpg?jadewits_media_id=1055571" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/7584b9495722bd4f4d701dd903725955-6afcb5823bde5.jpg?jadewits_media_id=1055571" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/7584b9495722bd4f4d701dd903725955-6afcb5823bde5.jpg?jadewits_media_id=1055571" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজশাহী বিশ্ববিদ্যালয়ের প্রধান গেটে ককটেল বিস্ফোরণ, প্রক্টরকে হুমকি নিষিদ্ধ ছাত্রলীগ নেতার" /&gt;&lt;/p&gt;&lt;p&gt;রাজশাহী বিশ্ববিদ্যালয়ের (রাবি) প্রধান ফটকের সামনে ককটেল বিস্ফোরণের ঘটনা ঘটেছে। মঙ্গলবার (১৭ নভেম্বর) রাত সাড়ে ৮টার দিকে বিশ্ববিদ্যালয়ের প্রধান ফটকের সামনে এ ঘটনা ঘটে।
এদিকে, আগামী ১৯ নভেম্বর ক্যাম্পাস বন্ধ না রাখলে অস্থিতিশীল পরিস্থিতি সৃষ্টির হুমকি দেওয়া হয়েছে বিশ্ববিদ্যালয়ের প্রক্টরকে। নিষিদ্ধঘোষি&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/my-campus/981620/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A7%80-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8-%E0%A6%97%E0%A7%87%E0%A6%9F%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>তরুণদের ‘নিজেদের ওপর বিশ্বাস রাখো’ মন্ত্র দিয়ে চ্যাম্পিয়ন মুসা</title>
      <link>https://www.banglatribune.com/sport/football/981618/%E0%A6%A4%E0%A6%B0%E0%A7%81%E0%A6%A3%E0%A6%A6%E0%A7%87%E0%A6%B0-%E2%80%98%E0%A6%A8%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8-%E0%A6%B0%E0%A6%BE%E0%A6%96%E0%A7%8B%E2%80%99-%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/football/981618/%E0%A6%A4%E0%A6%B0%E0%A7%81%E0%A6%A3%E0%A6%A6%E0%A7%87%E0%A6%B0-%E2%80%98%E0%A6%A8%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8-%E0%A6%B0%E0%A6%BE%E0%A6%96%E0%A7%8B%E2%80%99-%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87</guid>
      <pubDate>Wed, 18 Nov 2026 02:11:32 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/1f555356df669f4b4e8eed112cb5d1c5-6afcb3967b257.jpg?jadewits_media_id=1055570" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/1f555356df669f4b4e8eed112cb5d1c5-6afcb3967b257.jpg?jadewits_media_id=1055570" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/1f555356df669f4b4e8eed112cb5d1c5-6afcb3967b257.jpg?jadewits_media_id=1055570" style="max-width:100%;height:auto;margin-bottom:10px;" alt="তরুণদের ‘নিজেদের ওপর বিশ্বাস রাখো’ মন্ত্র দিয়ে চ্যাম্পিয়ন মুসা" /&gt;&lt;/p&gt;&lt;p&gt;ফাইনালে শুরুতে পিছিয়ে পড়েও চিরপ্রতিদ্বন্দ্বী পাকিস্তানকে ২-১ গোলে হারিয়ে সাফের দশম শিরোপা জিতেছে ভারত। পুরো টুর্নামেন্টে অপরাজিত থেকে চ্যাম্পিয়ন হওয়ার পর নিজের কৌশলের কথাই তুলে ধরেছেন নওশাদ মুসা।
ঢাকার জাতীয় স্টেডিয়ামে ম্যাচশেষে ভারতীয় কোচ বলেন, ‘আমরা যখন ভারত থেকে রওনা দিই, আমি শুধু খেলোয়াড়দের একটি&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/football/981618/%E0%A6%A4%E0%A6%B0%E0%A7%81%E0%A6%A3%E0%A6%A6%E0%A7%87%E0%A6%B0-%E2%80%98%E0%A6%A8%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8-%E0%A6%B0%E0%A6%BE%E0%A6%96%E0%A7%8B%E2%80%99-%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>যাত্রাবাড়ীতে ফ্লাইওভার থেকে নিচে ছোড়া দুই ককটেল বিস্ফোরণ</title>
      <link>https://www.banglatribune.com/law-and-crime/981617/%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AB%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%93%E0%A6%AD%E0%A6%BE%E0%A6%B0-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%9A%E0%A7%87-%E0%A6%9B%E0%A7%8B%E0%A7%9C%E0%A6%BE-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/981617/%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AB%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%93%E0%A6%AD%E0%A6%BE%E0%A6%B0-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%9A%E0%A7%87-%E0%A6%9B%E0%A7%8B%E0%A7%9C%E0%A6%BE-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2</guid>
      <pubDate>Wed, 18 Nov 2026 01:53:11 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2018/12/23/d2e3a7a4c133ea1d3e6dff22bb6f2cd7-5c1f1e24ef831.jpg?jadewits_media_id=425011" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2018/12/23/d2e3a7a4c133ea1d3e6dff22bb6f2cd7-5c1f1e24ef831.jpg?jadewits_media_id=425011" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2018/12/23/d2e3a7a4c133ea1d3e6dff22bb6f2cd7-5c1f1e24ef831.jpg?jadewits_media_id=425011" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যাত্রাবাড়ীতে ফ্লাইওভার থেকে নিচে ছোড়া দুই ককটেল বিস্ফোরণ" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর যাত্রাবাড়ীর হানিফ ফ্লাইওভার থেকে দুর্বৃত্তদের নিক্ষেপ করা দুটি ককটেল বিস্ফোরণের ঘটনা ঘটেছে। তবে এতে কেউ হতাহত হননি।
মঙ্গলবার (১৭ নভেম্বর) রাত ৯টার দিকে যাত্রাবাড়ী থানার সামাদ সুপার মার্কেটের সামনে এ ঘটনা ঘটে।&amp;nbsp;
বিষয়টি নিশ্চিত করেছেন যাত্রাবাড়ী থানার ভারপ্রাপ্ত কর্মকর্তা (ওসি) রুবেল হাওল&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/981617/%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AB%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%93%E0%A6%AD%E0%A6%BE%E0%A6%B0-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%9A%E0%A7%87-%E0%A6%9B%E0%A7%8B%E0%A7%9C%E0%A6%BE-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>গোপালগঞ্জে আওয়ামী লীগের হামলা-অগ্নিসংযোগের প্রতিবাদে ঢাকায় বিক্ষোভ</title>
      <link>https://www.banglatribune.com/politics/bnp/981616/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E2%80%98%E0%A6%86%E0%A6%93%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%A4%E0%A6%BE%E0%A6%A3%E0%A7%8D%E0%A6%A1%E0%A6%AC%E2%80%99-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/politics/bnp/981616/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E2%80%98%E0%A6%86%E0%A6%93%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%A4%E0%A6%BE%E0%A6%A3%E0%A7%8D%E0%A6%A1%E0%A6%AC%E2%80%99-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A7%87</guid>
      <pubDate>Wed, 18 Nov 2026 01:45:31 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/7246773a6958165ef96de7807ed0ab73-6afcad2843687.jpg?jadewits_media_id=1055569" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/7246773a6958165ef96de7807ed0ab73-6afcad2843687.jpg?jadewits_media_id=1055569" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/7246773a6958165ef96de7807ed0ab73-6afcad2843687.jpg?jadewits_media_id=1055569" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গোপালগঞ্জে আওয়ামী লীগের হামলা-অগ্নিসংযোগের প্রতিবাদে ঢাকায় বিক্ষোভ" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জে &amp;lsquo;কার্যক্রম নিষিদ্ধ আওয়ামী লীগের হামলা ও অগ্নিসংযোগের প্রতিবাদে রাজধানীতে বিক্ষোভ মিছিল ও সমাবেশ করেছে জাতীয়তাবাদী স্বেচ্ছাসেবক দল, ঢাকা মহানগর দক্ষিণ। মঙ্গলবার (১৭ নভেম্বর) বিকালে রাজধানীর বাহাদুর পার্ক থেকে শুরু হয়ে বায়তুল মোকাররমের দক্ষিণ গেটের সামনে সংক্ষিপ্ত সমাবেশের মধ্য দিয়ে ক&lt;/p&gt;</description>

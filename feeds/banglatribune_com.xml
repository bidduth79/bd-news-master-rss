      <title>সাফের সেমিফাইনাল দেখতে দর্শকদের আগেভাগে স্টেডিয়ামে আসার আহ্বান ডিএমপির</title>
      <link>https://www.banglatribune.com/law-and-crime/980792/%E0%A6%B8%E0%A6%BE%E0%A6%AB%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A6%BF%E0%A6%AB%E0%A6%BE%E0%A6%87%E0%A6%A8%E0%A6%BE%E0%A6%B2-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A6%B0%E0%A7%8D%E0%A6%B6%E0%A6%95%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%87%E0%A6%AD%E0%A6%BE%E0%A6%97%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%A1%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/980792/%E0%A6%B8%E0%A6%BE%E0%A6%AB%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A6%BF%E0%A6%AB%E0%A6%BE%E0%A6%87%E0%A6%A8%E0%A6%BE%E0%A6%B2-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A6%B0%E0%A7%8D%E0%A6%B6%E0%A6%95%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%87%E0%A6%AD%E0%A6%BE%E0%A6%97%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%A1%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%87</guid>
      <pubDate>Sat, 14 Nov 2026 03:17:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/a907167acf4b5b02c38c1c90bbd92086-6af76edf6ab22.jpg?jadewits_media_id=1054879" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/a907167acf4b5b02c38c1c90bbd92086-6af76edf6ab22.jpg?jadewits_media_id=1054879" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/a907167acf4b5b02c38c1c90bbd92086-6af76edf6ab22.jpg?jadewits_media_id=1054879" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাফের সেমিফাইনাল দেখতে দর্শকদের আগেভাগে স্টেডিয়ামে আসার আহ্বান ডিএমপির" /&gt;&lt;/p&gt;&lt;p&gt;&amp;lrm;শনিবার (১৪ নভেম্বর) ঢাকার জাতীয় স্টেডিয়ামে সাফ চ্যাম্পিয়নশিপের দুটি সেমিফাইনাল ম্যাচ অনুষ্ঠিত হবে। এ উপলক্ষে স্টেডিয়ামে আগত দর্শকদের পর্যাপ্ত সময় হাতে নিয়ে উপস্থিত হওয়ার জন্য অনুরোধ করছে ঢাকা মেট্রোপলিটন পুলিশ (ডিএমপি)।
&amp;lrm;সূচি অনুযায়ী, আগামীকাল শ&amp;zwnj;নিবার বিকাল ৩টায় প্রথম সেমিফাইনালে ভারত &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/980792/%E0%A6%B8%E0%A6%BE%E0%A6%AB%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A6%BF%E0%A6%AB%E0%A6%BE%E0%A6%87%E0%A6%A8%E0%A6%BE%E0%A6%B2-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A6%B0%E0%A7%8D%E0%A6%B6%E0%A6%95%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%87%E0%A6%AD%E0%A6%BE%E0%A6%97%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%A1%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>

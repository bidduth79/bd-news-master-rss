    <item>
      <title>মধ্যপ্রাচ্যের আরেক দেশে যুক্তরাষ্ট্রের দুই ঘাঁটি লক্ষ্য করে ইরানের হামলা</title>
      <link>https://www.banglatribune.com/foreign/middle-east/982449/%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%98%E0%A6%BE%E0%A6%81%E0%A6%9F%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/middle-east/982449/%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%98%E0%A6%BE%E0%A6%81%E0%A6%9F%E0%A6%BF</guid>
      <pubDate>Sun, 22 Nov 2026 06:57:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/f0887e92dbfc51512203578344954108-6b021e3200976.jpg?jadewits_media_id=1056284" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/f0887e92dbfc51512203578344954108-6b021e3200976.jpg?jadewits_media_id=1056284" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/f0887e92dbfc51512203578344954108-6b021e3200976.jpg?jadewits_media_id=1056284" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মধ্যপ্রাচ্যের আরেক দেশে যুক্তরাষ্ট্রের দুই ঘাঁটি লক্ষ্য করে ইরানের হামলা" /&gt;&lt;/p&gt;&lt;p&gt;বাহরাইনে হামলা চালিয়েছে ইরানের ইসলামিক বিপ্লবী গার্ড (আইআরজিসি)। স্থানীয় সময় শনিবার (২১ নভেম্বর) রাতে দেশটিতে মিসাইল ও ড্রোন ছুড়েছে। বিপ্লবী গার্ড বলেছে, তারা বাহরাইনে থাকা মার্কিনিদের দুটি ঘাঁটিতে থাকা আকাশ প্রতিরক্ষা ব্যবস্থা লক্ষ্য করে হামলা চালিয়েছে।&amp;nbsp;
তবে বাহরাইনের স্বরাষ্ট্র মন্ত্রণালয় জান&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/middle-east/982449/%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%98%E0%A6%BE%E0%A6%81%E0%A6%9F%E0%A6%BF">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>‘গ্যারান্টি দিলাম, আগামী ১০ বছরে সরকার পরিবর্তনের সম্ভাবনা নেই’</title>

    <item>
      <title>বাংলাদেশের বিদায়, জাতীয় স্টেডিয়ামের গ্যালারিতে আগুন</title>
      <link>https://www.banglatribune.com/sport/football/980957/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A6%BE%E0%A7%9F-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%A1%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/football/980957/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A6%BE%E0%A7%9F-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%A1%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%87</guid>
      <pubDate>Sun, 15 Nov 2026 00:51:11 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/422af93b58885a928e43d4798098090a-6af8ad40e8d4c.jpg?jadewits_media_id=1055025" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/422af93b58885a928e43d4798098090a-6af8ad40e8d4c.jpg?jadewits_media_id=1055025" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/422af93b58885a928e43d4798098090a-6af8ad40e8d4c.jpg?jadewits_media_id=1055025" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাংলাদেশের বিদায়, জাতীয় স্টেডিয়ামের গ্যালারিতে আগুন" /&gt;&lt;/p&gt;&lt;p&gt;রেফারির শেষ বাঁশি বাজার সঙ্গে সঙ্গেই কান্নায় ভেঙে পড়লেন বাংলাদেশের ফুটবলাররা। স্তব্ধ পুরো জাতীয় স্টেডিয়াম। ২১ বছর পর সাফের ফাইনালে খেলার যে স্বপ্ন দেখেছিল বাংলাদেশ, তা ভেঙে গেলো পাকিস্তানের কাছে ১-০ গোলে হেরে। তবে মাঠের হতাশা গ্যালারিতে ছড়িয়ে পড়তে বেশি সময় লাগেনি। ম্যাচের শেষ দিকে গোল হজমের পর দর্শক&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/football/980957/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A6%BE%E0%A7%9F-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%A1%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%87">বাংলা ট্রিবিউন</source>

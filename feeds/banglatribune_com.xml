    <item>
      <title>অর্থায়ন ও জীবাশ্ম জ্বালানির ব্যবহার নিয়ে জলবায়ু সম্মেলনে মতবিরোধ</title>
      <link>https://www.banglatribune.com/others/environment/980930/%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A7%9F%E0%A6%A8-%E0%A6%93-%E0%A6%9C%E0%A7%80%E0%A6%AC%E0%A6%BE%E0%A6%B6%E0%A7%8D%E0%A6%AE-%E0%A6%9C%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%B8%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/others/environment/980930/%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A7%9F%E0%A6%A8-%E0%A6%93-%E0%A6%9C%E0%A7%80%E0%A6%AC%E0%A6%BE%E0%A6%B6%E0%A7%8D%E0%A6%AE-%E0%A6%9C%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%B8%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87</guid>
      <pubDate>Sat, 14 Nov 2026 21:15:52 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/ee886c723f216db203c23e119bd6859b-6af879a11a3e0.jpg?jadewits_media_id=1054996" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/ee886c723f216db203c23e119bd6859b-6af879a11a3e0.jpg?jadewits_media_id=1054996" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/ee886c723f216db203c23e119bd6859b-6af879a11a3e0.jpg?jadewits_media_id=1054996" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অর্থায়ন ও জীবাশ্ম জ্বালানির ব্যবহার নিয়ে জলবায়ু সম্মেলনে মতবিরোধ" /&gt;&lt;/p&gt;&lt;p&gt;জলবায়ু অর্থায়ন, অভিযোজন এবং জীবাশ্ম জ্বালানির ব্যবহার থেকে সরে আসার উপায় নিয়ে কপ৩১ সম্মেলনে উন্নত ও উন্নয়নশীল দেশগুলোর মধ্যে তীব্র মতবিরোধ দেখা দিয়েছে। দীর্ঘদিনের জলবায়ু অর্থায়নের প্রতিশ্রুতি বাস্তবে কার্যকর পদক্ষেপে রূপ দেওয়ার দাবি জানাচ্ছে উন্নয়নশীল দেশগুলো।
গত ১১ ও ১২ নভেম্বর বিশ্বনেতাদের সম্মেলন&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/others/environment/980930/%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A7%9F%E0%A6%A8-%E0%A6%93-%E0%A6%9C%E0%A7%80%E0%A6%AC%E0%A6%BE%E0%A6%B6%E0%A7%8D%E0%A6%AE-%E0%A6%9C%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%B8%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>

      <guid isPermaLink="true">https://www.banglatribune.com/press-release/981394/%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B8%E0%A7%87%E0%A6%B2-%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%9C-%E0%A6%95%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%98%E0%A6%B0%E0%A6%AD%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%89%E0%A6%AA%E0%A6%B9%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AE%E0%A7%87%E0%A6%B9%E0%A7%87%E0%A6%B0%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Mon, 16 Nov 2026 22:57:57 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/aac18d83b4d7e29fbc8aed7e7d36f9cc-6afb35f77b39e.jpg?jadewits_media_id=1055375" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/aac18d83b4d7e29fbc8aed7e7d36f9cc-6afb35f77b39e.jpg?jadewits_media_id=1055375" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/aac18d83b4d7e29fbc8aed7e7d36f9cc-6afb35f77b39e.jpg?jadewits_media_id=1055375" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মার্সেল ফ্রিজ কিনে ঘরভর্তি উপহার পেলেন মেহেরপুরের গৃহিণী" /&gt;&lt;/p&gt;&lt;p&gt;মার্সেলের ফ্রিজ কিনে &amp;lsquo;ঘরভর্তি উপহার&amp;rsquo; পেয়েছেন মেহেরপুরের গাংনী উপজেলার বামন্দী ইউনিয়নের গৃহিণী মোছা. লিপিয়ারা। উপহারের তালিকায় রয়েছে ফ্রিজ, এসি, টেলিভিশন, ওয়াশিং মেশিন, মাইক্রোওয়েভ ওভেন, গ্যাস স্টোভ, রাইস কুকার, ব্লেন্ডার, ফ্যানসহ বিভিন্ন ইলেকট্রনিক পণ্য।
রবিবার (১৫ নভেম্বর) বামন্দী বাজার&lt;/p&gt;</description>

      <title>প্রধানমন্ত্রীকে কটূক্তি করে টিকটক, পুলিশ আসার আগে জানালা ভেঙে পালালেন নারী</title>
      <link>https://www.banglatribune.com/country/khulna/982446/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A6%9F%E0%A7%82%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%9F%E0%A6%BF%E0%A6%95%E0%A6%9F%E0%A6%95-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%86%E0%A6%B8%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/khulna/982446/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A6%9F%E0%A7%82%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%9F%E0%A6%BF%E0%A6%95%E0%A6%9F%E0%A6%95-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%86%E0%A6%B8%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%87</guid>
      <pubDate>Sun, 22 Nov 2026 04:20:43 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/273b7ae308997f8dc11d21cfd8ab22ce-6b0219270f4ab.jpg?jadewits_media_id=1056281" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/273b7ae308997f8dc11d21cfd8ab22ce-6b0219270f4ab.jpg?jadewits_media_id=1056281" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/273b7ae308997f8dc11d21cfd8ab22ce-6b0219270f4ab.jpg?jadewits_media_id=1056281" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রধানমন্ত্রীকে কটূক্তি করে টিকটক, পুলিশ আসার আগে জানালা ভেঙে পালালেন নারী" /&gt;&lt;/p&gt;&lt;p&gt;চুয়াডাঙ্গা সদর উপজেলায় প্রধানমন্ত্রী তারেক রহমানকে কটূক্তি করে টিকটকে ভিডিও প্রকাশের অভিযোগ উঠেছে এক নারীর বিরুদ্ধে। ভিডিওটি নজরে আসার পর স্থানীয় বিএনপির নেতাকর্মীরা ওই নারীকে তার বাড়িতে ঘেরাও করেন এবং দরজায় তালা মেরে বসতঘরে আবদ্ধ করে পুলিশে খবর দেন। পরে পুলিশ এসে দেখে ঘরের পেছনের জানালা ভেঙে পালিয়ে&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/khulna/982446/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A6%9F%E0%A7%82%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%9F%E0%A6%BF%E0%A6%95%E0%A6%9F%E0%A6%95-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%86%E0%A6%B8%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>

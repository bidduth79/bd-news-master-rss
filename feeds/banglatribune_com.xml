      <title>স্বাধীন বাংলা দল ও আইসিসি ট্রফির স্মৃতিতে সাজবে জাতীয় স্টেডিয়াম</title>
      <link>https://www.banglatribune.com/sport/other-sports/982709/%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%A7%E0%A7%80%E0%A6%A8-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE-%E0%A6%A6%E0%A6%B2-%E0%A6%93-%E0%A6%86%E0%A6%87%E0%A6%B8%E0%A6%BF%E0%A6%B8%E0%A6%BF-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%AB%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%9C%E0%A6%AC%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/other-sports/982709/%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%A7%E0%A7%80%E0%A6%A8-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE-%E0%A6%A6%E0%A6%B2-%E0%A6%93-%E0%A6%86%E0%A6%87%E0%A6%B8%E0%A6%BF%E0%A6%B8%E0%A6%BF-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%AB%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%9C%E0%A6%AC%E0%A7%87</guid>
      <pubDate>Mon, 23 Nov 2026 14:40:54 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/ff29ffd81f6a5e0b283413c057595728-6b03fbe87421a.jpg?jadewits_media_id=1056497" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/ff29ffd81f6a5e0b283413c057595728-6b03fbe87421a.jpg?jadewits_media_id=1056497" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/ff29ffd81f6a5e0b283413c057595728-6b03fbe87421a.jpg?jadewits_media_id=1056497" style="max-width:100%;height:auto;margin-bottom:10px;" alt="স্বাধীন বাংলা দল ও আইসিসি ট্রফির স্মৃতিতে সাজবে জাতীয় স্টেডিয়াম" /&gt;&lt;/p&gt;&lt;p&gt;দেশের ক্রীড়াঙ্গনের গৌরবোজ্জ্বল ইতিহাস ও ঐতিহ্য তুলে ধরে নতুনভাবে সাজানো হবে ঢাকার জাতীয় স্টেডিয়াম। সেখানে বিশেষ গুরুত্ব পাবে স্বাধীন বাংলা ফুটবল দল, আইসিসি ট্রফি জয় এবং দেশের ক্রীড়াঙ্গনের স্মরণীয় অর্জন ও কৃতী খেলোয়াড়দের স্মৃতি। জাতীয় স্টেডিয়ামকে আরও খেলাধুলাবান্ধব করে গড়ে তুলতে এমন পরিকল্পনা নিয়েছে &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/other-sports/982709/%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%A7%E0%A7%80%E0%A6%A8-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE-%E0%A6%A6%E0%A6%B2-%E0%A6%93-%E0%A6%86%E0%A6%87%E0%A6%B8%E0%A6%BF%E0%A6%B8%E0%A6%BF-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%AB%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%9C%E0%A6%AC%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ব্যারিস্টার ফুয়াদ বললেন ‘স্লিপ অব টাং’, সতর্ক করলেন ট্রাইব্যুনাল</title>
      <link>https://www.banglatribune.com/law-and-crime/982708/%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%AB%E0%A7%81%E0%A7%9F%E0%A6%BE%E0%A6%A6-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A7%87%E0%A6%A8-%E2%80%98%E0%A6%B8%E0%A7%8D%E0%A6%B2%E0%A6%BF%E0%A6%AA-%E0%A6%85%E0%A6%AC-%E0%A6%9F%E0%A6%BE%E0%A6%82%E2%80%99-%E0%A6%B8%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%95</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/982708/%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%AB%E0%A7%81%E0%A7%9F%E0%A6%BE%E0%A6%A6-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A7%87%E0%A6%A8-%E2%80%98%E0%A6%B8%E0%A7%8D%E0%A6%B2%E0%A6%BF%E0%A6%AA-%E0%A6%85%E0%A6%AC-%E0%A6%9F%E0%A6%BE%E0%A6%82%E2%80%99-%E0%A6%B8%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%95</guid>
      <pubDate>Mon, 23 Nov 2026 14:39:11 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/5257f71453bd38b4410a2834e26f934f-6b03fb7a87daa.jpg?jadewits_media_id=1056496" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/5257f71453bd38b4410a2834e26f934f-6b03fb7a87daa.jpg?jadewits_media_id=1056496" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/5257f71453bd38b4410a2834e26f934f-6b03fb7a87daa.jpg?jadewits_media_id=1056496" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ব্যারিস্টার ফুয়াদ বললেন ‘স্লিপ অব টাং’, সতর্ক করলেন ট্রাইব্যুনাল" /&gt;&lt;/p&gt;&lt;p&gt;আন্তর্জাতিক অপরাধ ট্রাইব্যুনালের বিচারপ্রক্রিয়া নিয়ে বিরূপ মন্তব্যের ঘটনায় আদালত অবমাননার অভিযোগে আমার বাংলাদেশ (এবি) পার্টির সাধারণ সম্পাদক ব্যারিস্টার আসাদুজ্জামান ফুয়াদকে সতর্ক করেছেন আন্তর্জাতিক অপরাধ ট্রাইব্যুনাল। একইসঙ্গে ভবিষ্যতে এ ধরনের মন্তব্য করা থেকে বিরত থাকতে তাকে নির্দেশ দিয়ে আদালত অবম&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/982708/%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%AB%E0%A7%81%E0%A7%9F%E0%A6%BE%E0%A6%A6-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A7%87%E0%A6%A8-%E2%80%98%E0%A6%B8%E0%A7%8D%E0%A6%B2%E0%A6%BF%E0%A6%AA-%E0%A6%85%E0%A6%AC-%E0%A6%9F%E0%A6%BE%E0%A6%82%E2%80%99-%E0%A6%B8%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%95">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>স্কুল-কলেজের গভর্নিংবডির নির্বাচন স্থগিত রাখা কেন অবৈধ নয়, জানতে চান হাইকোর্ট</title>
      <link>https://www.banglatribune.com/law-and-crime/982707/%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2-%E0%A6%95%E0%A6%B2%E0%A7%87%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A6%AD%E0%A6%B0%E0%A7%8D%E0%A6%A8%E0%A6%BF%E0%A6%82%E0%A6%AC%E0%A6%A1%E0%A6%BF%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%9A%E0%A6%A8-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%97%E0%A6%BF%E0%A6%A4-%E0%A6%B0%E0%A6%BE%E0%A6%96%E0%A6%BE-%E0%A6%95%E0%A7%87%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/982707/%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2-%E0%A6%95%E0%A6%B2%E0%A7%87%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A6%AD%E0%A6%B0%E0%A7%8D%E0%A6%A8%E0%A6%BF%E0%A6%82%E0%A6%AC%E0%A6%A1%E0%A6%BF%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%9A%E0%A6%A8-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%97%E0%A6%BF%E0%A6%A4-%E0%A6%B0%E0%A6%BE%E0%A6%96%E0%A6%BE-%E0%A6%95%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Mon, 23 Nov 2026 14:31:14 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/03/16/d7a86567049982fe4e2b54db76545e7b-69b7deacb009a.jpg?jadewits_media_id=1015539" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/03/16/d7a86567049982fe4e2b54db76545e7b-69b7deacb009a.jpg?jadewits_media_id=1015539" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/03/16/d7a86567049982fe4e2b54db76545e7b-69b7deacb009a.jpg?jadewits_media_id=1015539" style="max-width:100%;height:auto;margin-bottom:10px;" alt="স্কুল-কলেজের গভর্নিংবডির নির্বাচন স্থগিত রাখা কেন অবৈধ নয়, জানতে চান হাইকোর্ট" /&gt;&lt;/p&gt;&lt;p&gt;বেসরকারি শিক্ষা প্রতিষ্ঠানসমূহের &amp;lsquo;গভর্নিং বডি/ম্যানেজিং কমিটি&amp;rsquo; নির্বাচন স্থগিত করে শিক্ষা বোর্ডের বিজ্ঞপ্তি কেন অবৈধ হবে না, তা জানতে চেয়ে রুল জারি করেছেন হাইকোর্ট। শিক্ষা মন্ত্রণালয় সচিব, ঢাকা শিক্ষা বোর্ডের চেয়ারম্যানসহ সংশ্লিষ্টদের এ রুলের জবাব দিতে বলা হয়েছে।
এ সংক্রান্ত রিট আবেদনের&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/982707/%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2-%E0%A6%95%E0%A6%B2%E0%A7%87%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A6%AD%E0%A6%B0%E0%A7%8D%E0%A6%A8%E0%A6%BF%E0%A6%82%E0%A6%AC%E0%A6%A1%E0%A6%BF%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%9A%E0%A6%A8-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%97%E0%A6%BF%E0%A6%A4-%E0%A6%B0%E0%A6%BE%E0%A6%96%E0%A6%BE-%E0%A6%95%E0%A7%87%E0%A6%A8">বাংলা ট্রিবিউন</source>
    </item>

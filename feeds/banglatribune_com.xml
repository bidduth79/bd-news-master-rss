      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/982420/%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%B0%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%BE-%E0%A6%AD%E0%A7%87%E0%A6%A4%E0%A6%B0%E0%A7%87-%E0%A6%85%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8-%E0%A6%AC%E0%A7%9C-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6</guid>
      <pubDate>Sun, 22 Nov 2026 00:01:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/09/17/2bc06c4a14c0c8489ae36df395dc12a1-6aabf9665a180.jpg?jadewits_media_id=1044284" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/09/17/2bc06c4a14c0c8489ae36df395dc12a1-6aabf9665a180.jpg?jadewits_media_id=1044284" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/09/17/2bc06c4a14c0c8489ae36df395dc12a1-6aabf9665a180.jpg?jadewits_media_id=1044284" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাইরে নাশকতা, ভেতরে অবিশ্বাস: বড় পরীক্ষায় পুলিশ" /&gt;&lt;/p&gt;&lt;p&gt;রাজপথে ককটেল বিস্ফোরণ, যানবাহনে আগুন, শিল্পাঞ্চলে শ্রমিক বিক্ষোভ এবং দেশের বিভিন্ন এলাকায় রাজনৈতিক হামলা-পাল্টা হামলা; একটির পর একটি সহিংস ঘটনা সামাল দিতে চাপে রয়েছে পুলিশ। এর মধ্যে বাহিনীর ভেতরেও তৈরি হয়েছে সন্দেহ ও অবিশ্বাস। কার্যক্রম নিষিদ্ধ আওয়ামী লীগের নেতাদের সঙ্গে কয়েকজন পুলিশ কর্মকর্তার যোগা&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/982420/%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%B0%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%BE-%E0%A6%AD%E0%A7%87%E0%A6%A4%E0%A6%B0%E0%A7%87-%E0%A6%85%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8-%E0%A6%AC%E0%A7%9C-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>তারানা হালিমের খোঁজে বাসায় পুলিশের অভিযান</title>

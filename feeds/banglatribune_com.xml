    <item>
      <title>যৌথ সামরিক মহড়ায় চীন ও কম্বোডিয়া</title>
      <link>https://www.banglatribune.com/foreign/asia/983684/%E0%A6%AF%E0%A7%8C%E0%A6%A5-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%B0%E0%A6%BF%E0%A6%95-%E0%A6%AE%E0%A6%B9%E0%A7%9C%E0%A6%BE%E0%A7%9F-%E0%A6%9A%E0%A7%80%E0%A6%A8-%E0%A6%93-%E0%A6%95%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A7%8B%E0%A6%A1%E0%A6%BF%E0%A7%9F%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/asia/983684/%E0%A6%AF%E0%A7%8C%E0%A6%A5-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%B0%E0%A6%BF%E0%A6%95-%E0%A6%AE%E0%A6%B9%E0%A7%9C%E0%A6%BE%E0%A7%9F-%E0%A6%9A%E0%A7%80%E0%A6%A8-%E0%A6%93-%E0%A6%95%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A7%8B%E0%A6%A1%E0%A6%BF%E0%A7%9F%E0%A6%BE</guid>
      <pubDate>Fri, 27 Nov 2026 23:00:33 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/39fb05df781038c5cee6f9fef0532152-6b09b6eca2cec.jpeg?jadewits_media_id=1057350" length="0" type="image/jpeg" />

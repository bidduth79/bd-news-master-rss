      <title>আওয়ামী লীগের ১০ বছরের চেয়ে ৮ মাসে চট্টগ্রামে বেশি উন্নয়ন হয়েছে: মীর হেলাল</title>
      <link>https://www.banglatribune.com/country/chitagong/980962/%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A7%A7%E0%A7%A6-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A7%87%E0%A7%9F%E0%A7%87-%E0%A7%AE-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%9A%E0%A6%9F%E0%A7%8D%E0%A6%9F%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/chitagong/980962/%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A7%A7%E0%A7%A6-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A7%87%E0%A7%9F%E0%A7%87-%E0%A7%AE-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%9A%E0%A6%9F%E0%A7%8D%E0%A6%9F%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%BF</guid>
      <pubDate>Sun, 15 Nov 2026 03:10:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/6167f2cd9b2a44ac055327371b2d7ddb-6af8c8198b68c.jpg?jadewits_media_id=1055030" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/6167f2cd9b2a44ac055327371b2d7ddb-6af8c8198b68c.jpg?jadewits_media_id=1055030" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/6167f2cd9b2a44ac055327371b2d7ddb-6af8c8198b68c.jpg?jadewits_media_id=1055030" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আওয়ামী লীগের ১০ বছরের চেয়ে ৮ মাসে চট্টগ্রামে বেশি উন্নয়ন হয়েছে: মীর হেলাল" /&gt;&lt;/p&gt;&lt;p&gt;আওয়ামী লীগের ১০ বছরের শাসনামলে যা সম্ভব হয়নি, নিজের আট মাসের দায়িত্বকালেই চট্টগ্রামে তার চেয়ে বেশি উন্নয়ন করা হয়েছে বলে মন্তব্য করেছেন ভূমি ও পাহাড়ি চট্টগ্রাম বিষয়ক প্রতিমন্ত্রী মীর মোহাম্মদ হেলাল উদ্দিন।
শনিবার (১৪ নভেম্বর) চট্টগ্রামে চসিক মেয়র ও প্রশাসক হিসেবে শাহাদাত হোসেনের দুই বছর পূর্তি উপলক্ষ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/chitagong/980962/%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A7%A7%E0%A7%A6-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A7%87%E0%A7%9F%E0%A7%87-%E0%A7%AE-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%9A%E0%A6%9F%E0%A7%8D%E0%A6%9F%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%BF">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ভুটানকে ৪ গোলে উড়িয়ে বাংলাদেশের দাপুটে জয়</title>

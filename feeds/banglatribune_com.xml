      <guid isPermaLink="true">https://www.banglatribune.com/sport/football/979732/%E0%A6%86%E0%A6%A4%E0%A6%B2%E0%A7%87%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A7%8B%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%A0%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B8%E0%A7%87%E0%A6%B2%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%AF-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%A8</guid>
      <pubDate>Mon, 09 Nov 2026 09:58:27 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/9a5080599db2213420f90485a302e0b8-6af143b55d063.jpg?jadewits_media_id=1053974" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/9a5080599db2213420f90485a302e0b8-6af143b55d063.jpg?jadewits_media_id=1053974" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/9a5080599db2213420f90485a302e0b8-6af143b55d063.jpg?jadewits_media_id=1053974" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আতলেতিকোর মাঠে বার্সেলোনার অবিশ্বাস্য প্রত্যাবর্তন" /&gt;&lt;/p&gt;&lt;p&gt;পিছিয়ে পড়েও দারুণভাবে ঘুরে দাঁড়িয়ে জয় তুলে নিয়েছে বার্সেলোনা। স্প্যানিশ লা লিগায় রবিবার রাতে আতলেতিকো মাদ্রিদের মাঠে স্বাগতিকদের ২-১ গোলে হারিয়েছে হান্সি ফ্লিকের দল। এই জয়ে শীর্ষস্থান আরও মজবুত করেছে কাতালান ক্লাবটি। দ্বিতীয় স্থানে থাকা রিয়াল মাদ্রিদের সঙ্গে ব্যবধান বেড়ে দাঁড়িয়েছে তিন পয়েন্টে।
ম্যাচ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/football/979732/%E0%A6%86%E0%A6%A4%E0%A6%B2%E0%A7%87%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A7%8B%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%A0%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B8%E0%A7%87%E0%A6%B2%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%AF-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%A8">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ইরান যুদ্ধ বন্ধে শি-পুতিনের দ্বারস্থ হচ্ছেন ট্রাম্প</title>
      <link>https://www.banglatribune.com/foreign/usa/979731/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%B6%E0%A6%BF-%E0%A6%AA%E0%A7%81%E0%A6%A4%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%A5-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/usa/979731/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%B6%E0%A6%BF-%E0%A6%AA%E0%A7%81%E0%A6%A4%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%A5-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Mon, 09 Nov 2026 09:57:47 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/6b5be75d07b70f40cf5cb50110521f8e-6af1442ec8ae5.jpg?jadewits_media_id=1053975" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/6b5be75d07b70f40cf5cb50110521f8e-6af1442ec8ae5.jpg?jadewits_media_id=1053975" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/6b5be75d07b70f40cf5cb50110521f8e-6af1442ec8ae5.jpg?jadewits_media_id=1053975" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইরান যুদ্ধ বন্ধে শি-পুতিনের দ্বারস্থ হচ্ছেন ট্রাম্প" /&gt;&lt;/p&gt;&lt;p&gt;ইরান যুদ্ধ বন্ধের উপায় নিয়ে আলোচনা করতে চীন ও রাশিয়ার প্রেসিডেন্ট শি জিনপিং এবং ভ্লাদিমির পুতিনের সঙ্গে কথা বলবেন বলে জানিয়েছেন মার্কিন প্রেসিডেন্ট ডোনাল্ড ট্রাম্প। আগামী সপ্তাহে চীনের শেনজেনে এশিয়া-প্যাসিফিক ইকোনমিক কো-অপারেশন (এপেক) সম্মেলনে দুই নেতার সঙ্গে তার বৈঠক হতে পারে বলে তিনি আশা প্রকাশ কর&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/usa/979731/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%B6%E0%A6%BF-%E0%A6%AA%E0%A7%81%E0%A6%A4%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%A5-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87%E0%A6%A8">বাংলা ট্রিবিউন</source>

    <item>
      <title>মেয়ের জন্মদিনে লিটনের সেঞ্চুরি, দেখানো কাগজে কী লেখা ছিল?</title>
      <link>https://www.banglatribune.com/sport/cricket/981243/%E0%A6%AE%E0%A7%87%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AE%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%B2%E0%A6%BF%E0%A6%9F%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%87%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%95%E0%A6%BE%E0%A6%97%E0%A6%9C%E0%A7%87-%E0%A6%95%E0%A7%80</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/cricket/981243/%E0%A6%AE%E0%A7%87%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AE%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%B2%E0%A6%BF%E0%A6%9F%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%87%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%95%E0%A6%BE%E0%A6%97%E0%A6%9C%E0%A7%87-%E0%A6%95%E0%A7%80</guid>
      <pubDate>Mon, 16 Nov 2026 15:00:55 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/4fc17fdf3cfa4cda4451ec733e44bb52-6afac52701619.jpg?jadewits_media_id=1055254" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/4fc17fdf3cfa4cda4451ec733e44bb52-6afac52701619.jpg?jadewits_media_id=1055254" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/4fc17fdf3cfa4cda4451ec733e44bb52-6afac52701619.jpg?jadewits_media_id=1055254" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মেয়ের জন্মদিনে লিটনের সেঞ্চুরি, দেখানো কাগজে কী লেখা ছিল?" /&gt;&lt;/p&gt;&lt;p&gt;ব্যাট হাতে দক্ষিণ আফ্রিকার বোলারদের শাসন করে সেঞ্চুরি তুলে নিলেন, এরপর পকেট থেকে বের করলেন একটি কাগজ। তাতে লেখা, &amp;lsquo;শুভ জন্মদিন আমার রাজকন্যা, এই সেঞ্চুরি তোমার জন্য।&amp;rsquo; ওয়ান্ডারার্সে প্রথম টেস্টের দ্বিতীয় দিন লিটন দাসের উদযাপনটা তাই কেবল একটি সেঞ্চুরির আনন্দে সীমাবদ্ধ থাকেনি, হয়ে উঠেছে বা&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/cricket/981243/%E0%A6%AE%E0%A7%87%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AE%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%B2%E0%A6%BF%E0%A6%9F%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%87%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%95%E0%A6%BE%E0%A6%97%E0%A6%9C%E0%A7%87-%E0%A6%95%E0%A7%80">বাংলা ট্রিবিউন</source>
    </item>

      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/c3edfc46fd716602296bf5eadb05bd4e-6afbc1fa271bb.jpg?jadewits_media_id=1055402" length="0" type="image/jpeg" />

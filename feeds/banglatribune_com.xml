    <item>
      <title>কিছু দেখা, কিছু ভাবনা এবং কিছু প্রশ্ন</title>
      <link>https://www.banglatribune.com/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%B2%E0%A7%87%E0%A6%B7%E0%A6%A3/981128/%E0%A6%95%E0%A6%BF%E0%A6%9B%E0%A7%81-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BE-%E0%A6%95%E0%A6%BF%E0%A6%9B%E0%A7%81-%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A6%A8%E0%A6%BE-%E0%A6%8F%E0%A6%AC%E0%A6%82-%E0%A6%95%E0%A6%BF%E0%A6%9B%E0%A7%81-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B6%E0%A7%8D%E0%A6%A8%C2%A0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%B2%E0%A7%87%E0%A6%B7%E0%A6%A3/981128/%E0%A6%95%E0%A6%BF%E0%A6%9B%E0%A7%81-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BE-%E0%A6%95%E0%A6%BF%E0%A6%9B%E0%A7%81-%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A6%A8%E0%A6%BE-%E0%A6%8F%E0%A6%AC%E0%A6%82-%E0%A6%95%E0%A6%BF%E0%A6%9B%E0%A7%81-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B6%E0%A7%8D%E0%A6%A8%C2%A0</guid>
      <pubDate>Mon, 16 Nov 2026 14:00:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/bd981c8b4a9c8e0afb70259bd6fa79d9-6af9d4015da83.jpg?jadewits_media_id=1055171" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/bd981c8b4a9c8e0afb70259bd6fa79d9-6af9d4015da83.jpg?jadewits_media_id=1055171" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/bd981c8b4a9c8e0afb70259bd6fa79d9-6af9d4015da83.jpg?jadewits_media_id=1055171" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কিছু দেখা, কিছু ভাবনা এবং কিছু প্রশ্ন" /&gt;&lt;/p&gt;&lt;p&gt;একটি জাতির পরিচয় কেবল তার ভূখণ্ড, জনসংখ্যা, ভাষা, ইতিহাস কিংবা অর্থনৈতিক সমৃদ্ধির মধ্যে সীমাবদ্ধ থাকে না। একটি জাতিকে প্রকৃত অর্থে বুঝতে হলে এর মানুষের দৈনন্দিন জীবনযাপন, আচার-আচরণ, পারস্পরিক সম্পর্ক, সামাজিক মূল্যবোধ, চিন্তাভাবনা এবং অন্যের প্রতি দৃষ্টিভঙ্গি পর্যবেক্ষণ করতে হয়। কিছু ছোট ছোট আচরণ জা&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%B2%E0%A7%87%E0%A6%B7%E0%A6%A3/981128/%E0%A6%95%E0%A6%BF%E0%A6%9B%E0%A7%81-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BE-%E0%A6%95%E0%A6%BF%E0%A6%9B%E0%A7%81-%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A6%A8%E0%A6%BE-%E0%A6%8F%E0%A6%AC%E0%A6%82-%E0%A6%95%E0%A6%BF%E0%A6%9B%E0%A7%81-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B6%E0%A7%8D%E0%A6%A8%C2%A0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ফুকেটে বাণিজ্যিক ভবনে আগুন, ধোঁয়ায় শ্বাসরুদ্ধ হয়ে ১১ জনের মৃত্যু</title>
      <link>https://www.banglatribune.com/foreign/asia/981233/%E0%A6%AB%E0%A7%81%E0%A6%95%E0%A7%87%E0%A6%9F%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%A3%E0%A6%BF%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A6%BF%E0%A6%95-%E0%A6%AD%E0%A6%AC%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%A7%E0%A7%8B%E0%A6%81%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%B9%E0%A7%9F%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/asia/981233/%E0%A6%AB%E0%A7%81%E0%A6%95%E0%A7%87%E0%A6%9F%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%A3%E0%A6%BF%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A6%BF%E0%A6%95-%E0%A6%AD%E0%A6%AC%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%A7%E0%A7%8B%E0%A6%81%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%B9%E0%A7%9F%E0%A7%87</guid>
      <pubDate>Mon, 16 Nov 2026 13:58:11 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/9af1b85e3220d005bf6603642ee5b959-6afab70f95f0a.jpg?jadewits_media_id=1055247" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/9af1b85e3220d005bf6603642ee5b959-6afab70f95f0a.jpg?jadewits_media_id=1055247" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/9af1b85e3220d005bf6603642ee5b959-6afab70f95f0a.jpg?jadewits_media_id=1055247" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফুকেটে বাণিজ্যিক ভবনে আগুন, ধোঁয়ায় শ্বাসরুদ্ধ হয়ে ১১ জনের মৃত্যু" /&gt;&lt;/p&gt;&lt;p&gt;থাইল্যান্ডের পর্যটন দ্বীপ ফুকেটে একটি বাণিজ্যিক ভবনে ভয়াবহ অগ্নিকাণ্ডে ১১ জন নিহত হয়েছেন। এ ঘটনায় আহত হয়েছেন আরও ১৬ জন। সোমবার (১৬ নভেম্বর) স্থানীয় সময় ভোরে দ্বীপটির একটি জনপ্রিয় এলাকায় এ দুর্ঘটনা ঘটে। মার্কিন বার্তা সংস্থা এপি এ খবর জানিয়েছে।
থাই কর্তৃপক্ষ জানিয়েছে, স্থানীয় সময় ভোর ৩টা ১৭ মিনিটের দ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/asia/981233/%E0%A6%AB%E0%A7%81%E0%A6%95%E0%A7%87%E0%A6%9F%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%A3%E0%A6%BF%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A6%BF%E0%A6%95-%E0%A6%AD%E0%A6%AC%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%A7%E0%A7%8B%E0%A6%81%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%B9%E0%A7%9F%E0%A7%87">বাংলা ট্রিবিউন</source>

    <item>
      <title>ভেঙে পড়েছে উদ্ধারকারী জাহাজ ‘নির্ভীকের’ ক্রেন</title>
      <link>https://www.banglatribune.com/country/barishal/980245/%E0%A6%AD%E0%A7%87%E0%A6%99%E0%A7%87-%E0%A6%AA%E0%A7%9C%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%9C%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%9C-%E2%80%98%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AD%E0%A7%80%E0%A6%95%E0%A7%87%E0%A6%B0%E2%80%99-%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/barishal/980245/%E0%A6%AD%E0%A7%87%E0%A6%99%E0%A7%87-%E0%A6%AA%E0%A7%9C%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%9C%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%9C-%E2%80%98%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AD%E0%A7%80%E0%A6%95%E0%A7%87%E0%A6%B0%E2%80%99-%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Wed, 11 Nov 2026 15:40:22 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/a5c99b52bed635dd393f4ade51a80b10-6af437c007fb8.jpg?jadewits_media_id=1054416" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/a5c99b52bed635dd393f4ade51a80b10-6af437c007fb8.jpg?jadewits_media_id=1054416" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/a5c99b52bed635dd393f4ade51a80b10-6af437c007fb8.jpg?jadewits_media_id=1054416" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভেঙে পড়েছে উদ্ধারকারী জাহাজ ‘নির্ভীকের’ ক্রেন" /&gt;&lt;/p&gt;&lt;p&gt;কীর্তনখোলা নদীর বরিশাল নগরীর মুক্তিযোদ্ধা পার্ক এলাকায় অবস্থানকারী উদ্ধারকারী জাহাজ নির্ভীকের ক্রেন ভেঙে পড়ে একটি হাউসবোট ক্ষতিগ্রস্ত হয়েছে। তবে এতে কোনও হতাহতের ঘটনা ঘটেনি। এ ঘটনায় তদন্ত কমিটি গঠন করা হবে বলে জানিয়েছেন বরিশালের জেলা প্রশাসক মামুন খন্দকার।
নির্ভীকের ক্রেন উদ্ধারে ঢাকার নারায়ণগঞ্জ থে&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/barishal/980245/%E0%A6%AD%E0%A7%87%E0%A6%99%E0%A7%87-%E0%A6%AA%E0%A7%9C%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%9C%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%9C-%E2%80%98%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AD%E0%A7%80%E0%A6%95%E0%A7%87%E0%A6%B0%E2%80%99-%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A8">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>জবিতে ককটেল বিস্ফোরণ: শিক্ষার্থীর ৩ দিনের রিমান্ড</title>
      <link>https://www.banglatribune.com/law-and-crime/980244/%E0%A6%9C%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%B0-%E0%A7%A9-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/980244/%E0%A6%9C%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%B0-%E0%A7%A9-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1</guid>
      <pubDate>Wed, 11 Nov 2026 15:39:22 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/08517f75aed36816c9692c9da3799851-6af437c224477.jpg?jadewits_media_id=1054417" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/08517f75aed36816c9692c9da3799851-6af437c224477.jpg?jadewits_media_id=1054417" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/08517f75aed36816c9692c9da3799851-6af437c224477.jpg?jadewits_media_id=1054417" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জবিতে ককটেল বিস্ফোরণ: শিক্ষার্থীর ৩ দিনের রিমান্ড" /&gt;&lt;/p&gt;&lt;p&gt;জগন্নাথ বিশ্ববিদ্যালয়ে ককটেল বিস্ফোরণের ঘটনায় রাজধানীর কোতোয়ালি থানার সন্ত্রাসবিরোধী আইনের মামলায় প্রতিষ্ঠানটির শিক্ষার্থী মো. রেজওয়ান আহম্মেদকে (২৪) জিজ্ঞাসাবাদের জন্য তিন দিনের রিমান্ড দিয়েছেন আদালত।
তদন্ত কর্মকর্তার আবেদনের প্রেক্ষিতে বুধবার (১১ নভেম্বর) ঢাকার মেট্রোপলিটন ম্যাজিস্ট্রেট আরিফুল &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/980244/%E0%A6%9C%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%B0-%E0%A7%A9-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1">বাংলা ট্রিবিউন</source>

      <guid isPermaLink="true">https://www.banglatribune.com/country/dhaka/982830/%E0%A6%9C%E0%A7%81%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%BF-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%B6%E0%A7%81%E0%A6%AD%E0%A7%87%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A6%BE</guid>
      <pubDate>Mon, 23 Nov 2026 23:16:05 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/4b72ae17dd923064cee3c9ca886bb2a1-6b0474cf6a9af.jpg?jadewits_media_id=1056588" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/4b72ae17dd923064cee3c9ca886bb2a1-6b0474cf6a9af.jpg?jadewits_media_id=1056588" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/4b72ae17dd923064cee3c9ca886bb2a1-6b0474cf6a9af.jpg?jadewits_media_id=1056588" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জুলাইয়ের মামলার আসামি যুবলীগ নেতাকে শুভেচ্ছা জানিয়ে ছাত্রদল নেতার পোস্ট, সমালোচনা" /&gt;&lt;/p&gt;&lt;p&gt;সাভারে কার্যক্রম নিষিদ্ধ যুবলীগের এক নেতাকে জন্মদিনের শুভেচ্ছা জানিয়ে সমালোচনার মুখে পড়েছেন বিরুলিয়া ইউনিয়ন ছাত্রদলের সাধারণ সম্পাদক সাব্বির শেখ। সামাজিক যোগাযোগমাধ্যম ফেসবুকে দেওয়া তার একটি পোস্ট ঘিরে রাজনৈতিক অঙ্গনে শুরু হয়েছে আলোচনা-সমালোচনা।
স্থানীয় ছাত্রদলের নেতাকর্মীরা বলছেন, দেশে চলমান রাজনৈত&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/dhaka/982830/%E0%A6%9C%E0%A7%81%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%BF-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%B6%E0%A7%81%E0%A6%AD%E0%A7%87%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A6%BE">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>তথ্য কমিশন: পাঁচ দিনে ২৮ অভিযোগ নিষ্পত্তি</title>
      <link>https://www.banglatribune.com/others/982829/%E0%A6%A4%E0%A6%A5%E0%A7%8D%E0%A6%AF-%E0%A6%95%E0%A6%AE%E0%A6%BF%E0%A6%B6%E0%A6%A8-%E0%A6%AA%E0%A6%BE%E0%A6%81%E0%A6%9A-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A7%A8%E0%A7%AE-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.banglatribune.com/others/982829/%E0%A6%A4%E0%A6%A5%E0%A7%8D%E0%A6%AF-%E0%A6%95%E0%A6%AE%E0%A6%BF%E0%A6%B6%E0%A6%A8-%E0%A6%AA%E0%A6%BE%E0%A6%81%E0%A6%9A-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A7%A8%E0%A7%AE-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BF</guid>
      <pubDate>Mon, 23 Nov 2026 23:13:07 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/d9d132dee8833a194afe580c8576f159-6b0473d227228.JPG?jadewits_media_id=1056586" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/d9d132dee8833a194afe580c8576f159-6b0473d227228.JPG?jadewits_media_id=1056586" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/d9d132dee8833a194afe580c8576f159-6b0473d227228.JPG?jadewits_media_id=1056586" style="max-width:100%;height:auto;margin-bottom:10px;" alt="তথ্য কমিশন: পাঁচ দিনে ২৮ অভিযোগ নিষ্পত্তি" /&gt;&lt;/p&gt;&lt;p&gt;তথ্য অধিকার আইনের আওতায় দায়ের করা অভিযোগ নিষ্পত্তিতে কার্যক্রম জোরদার করেছে নবগঠিত তথ্য কমিশন বাংলাদেশ। কমিশন পুনর্গঠনের পর পাঁচ কার্যদিবসে মোট ৩৩টি অভিযোগের শুনানি গ্রহণ করা হয়েছে। এর মধ্যে ২৮টি অভিযোগ নিষ্পত্তি করা হয়েছে এবং অবশিষ্ট পাঁচটির পরবর্তী শুনানির তারিখ নির্ধারণ করা হয়েছে।
সোমবার (২৩ নভেম&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/others/982829/%E0%A6%A4%E0%A6%A5%E0%A7%8D%E0%A6%AF-%E0%A6%95%E0%A6%AE%E0%A6%BF%E0%A6%B6%E0%A6%A8-%E0%A6%AA%E0%A6%BE%E0%A6%81%E0%A6%9A-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A7%A8%E0%A7%AE-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BF">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>লালবাগে আগুন নেভাতে গিয়ে দুই ফায়ারকর্মী আহত</title>
      <link>https://www.banglatribune.com/others/982828/%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A6%97%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%A8%E0%A7%87%E0%A6%AD%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%97%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%AB%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%80-%E0%A6%86%E0%A6%B9%E0%A6%A4</link>
      <guid isPermaLink="true">https://www.banglatribune.com/others/982828/%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A6%97%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%A8%E0%A7%87%E0%A6%AD%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%97%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%AB%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%80-%E0%A6%86%E0%A6%B9%E0%A6%A4</guid>
      <pubDate>Mon, 23 Nov 2026 23:06:36 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2025/05/13/-c7e5d8a68bceded74c19d81deffd13b4-e3e5ce3c6ba73445f09aa0ebd5e10edc.jpg?jadewits_media_id=976163" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2025/05/13/-c7e5d8a68bceded74c19d81deffd13b4-e3e5ce3c6ba73445f09aa0ebd5e10edc.jpg?jadewits_media_id=976163" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2025/05/13/-c7e5d8a68bceded74c19d81deffd13b4-e3e5ce3c6ba73445f09aa0ebd5e10edc.jpg?jadewits_media_id=976163" style="max-width:100%;height:auto;margin-bottom:10px;" alt="লালবাগে আগুন নেভাতে গিয়ে দুই ফায়ারকর্মী আহত" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর লালবাগের&amp;nbsp; ইসলামবাগ&amp;nbsp; এলাকায় একটি প্লাস্টিকের গোডাউনে লাগা আগুন নেভাতে গিয়ে দুই ফায়ারকর্মী আহত হয়েছেন।
তারা হলেন, ফায়ার ফাইটার জয় রায় (৩২) ও আজহারুল (২৬)। সোমবার (২৩ নভেম্বর) সন্ধ্যায় ঘটনাটি ঘটেছে।
আহত অবস্থায় তাদের উদ্ধার করে ঢাকা মেডিক্যাল কলেজ হাসপাতালে নেওয়া হয়।
বিষয়টি নিশ্চিত &lt;/p&gt;</description>

    </item>
    <item>
      <title>নৈরাজ্য সৃষ্টিকারীদের ঐক্যবদ্ধভাবে মোকাবিলার আহ্বান সংস্কৃতিবিষয়ক মন্ত্রীর</title>
      <link>https://www.banglatribune.com/national/982274/%E0%A6%A8%E0%A7%88%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%90%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%AE%E0%A7%8B%E0%A6%95%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%B2%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/national/982274/%E0%A6%A8%E0%A7%88%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%90%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%AE%E0%A7%8B%E0%A6%95%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%B2%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Sat, 21 Nov 2026 05:27:13 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/67d4aadababbd166c03aaa725a64823d-6b00d71d833d9.jpg?jadewits_media_id=1056124" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/67d4aadababbd166c03aaa725a64823d-6b00d71d833d9.jpg?jadewits_media_id=1056124" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/67d4aadababbd166c03aaa725a64823d-6b00d71d833d9.jpg?jadewits_media_id=1056124" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নৈরাজ্য সৃষ্টিকারীদের ঐক্যবদ্ধভাবে মোকাবিলার আহ্বান সংস্কৃতিবিষয়ক মন্ত্রীর" /&gt;&lt;/p&gt;&lt;p&gt;দেশের আইনশৃঙ্খলা পরিস্থিতি স্বাভাবিক রাখা ও জননিরাপত্তা নিশ্চিত করতে ফ্যাসিবাদী শক্তি, পলাতক স্বৈরাচার এবং নৈরাজ্য সৃষ্টিকারীদের ঐক্যবদ্ধভাবে মোকাবিলার আহ্বান জানিয়েছেন সংস্কৃতিবিষয়ক মন্ত্রী নিতাই রায় চৌধুরী। তিনি বলেছেন, যেকোনো অপতৎপরতা কঠোরভাবে মোকাবিলায় সংশ্লিষ্ট সবাইকে দায়িত্বশীল ভূমিকা পালন করত&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/982274/%E0%A6%A8%E0%A7%88%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%90%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%AE%E0%A7%8B%E0%A6%95%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%B2%E0%A6%BE%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>লালমাটিয়ায় গোয়েন্দা সংস্থার সদস্য পরিচয়ে টাকা দাবি, যুবক আটক</title>
      <link>https://www.banglatribune.com/law-and-crime/982273/%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A6%AE%E0%A6%BE%E0%A6%9F%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A7%8B%E0%A7%9F%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%BE-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%9A%E0%A7%9F%E0%A7%87-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/982273/%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A6%AE%E0%A6%BE%E0%A6%9F%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A7%8B%E0%A7%9F%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%BE-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%9A%E0%A7%9F%E0%A7%87-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE</guid>
      <pubDate>Sat, 21 Nov 2026 05:18:07 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/b1863f2b8479cf60a84206d30834b127-6b00d4ad423d5.jpg?jadewits_media_id=1056123" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/b1863f2b8479cf60a84206d30834b127-6b00d4ad423d5.jpg?jadewits_media_id=1056123" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/b1863f2b8479cf60a84206d30834b127-6b00d4ad423d5.jpg?jadewits_media_id=1056123" style="max-width:100%;height:auto;margin-bottom:10px;" alt="লালমাটিয়ায় গোয়েন্দা সংস্থার সদস্য পরিচয়ে টাকা দাবি, যুবক আটক" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর মোহাম্মদপুরের লালমাটিয়ায় গোয়েন্দা সংস্থার সদস্য পরিচয়ে ভয়ভীতি দেখিয়ে টাকা দাবির অভিযোগে মো. সোহাগ বেপারী (৩৭) নামে এক ব্যক্তিকে আটক করেছে পুলিশ। এ ঘটনায় তার সহযোগী রতন মোটরসাইকেল নিয়ে পালিয়ে গেছেন।
শুক্রবার (২০ নভেম্বর) রাত সাড়ে ৮টার দিকে লালমাটিয়ার অক্সফোর্ড ইংলিশ মিডিয়াম স্কুলের পেছনের সড়&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/982273/%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A6%AE%E0%A6%BE%E0%A6%9F%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A7%8B%E0%A7%9F%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%BE-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%9A%E0%A7%9F%E0%A7%87-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>কাঁঠালবাগানে সিলিন্ডার বিস্ফোরণ: মায়ের মৃত্যু, আশঙ্কাজনক সন্তান</title>
      <link>https://www.banglatribune.com/law-and-crime/982270/%E0%A6%95%E0%A6%BE%E0%A6%81%E0%A6%A0%E0%A6%BE%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A6%97%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%B8%E0%A6%BF%E0%A6%B2%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/982270/%E0%A6%95%E0%A6%BE%E0%A6%81%E0%A6%A0%E0%A6%BE%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A6%97%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%B8%E0%A6%BF%E0%A6%B2%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81</guid>
      <pubDate>Sat, 21 Nov 2026 04:29:16 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2024/05/13/-c7e5d8a68bceded74c19d81deffd13b4.jpg?jadewits_media_id=916277" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2024/05/13/-c7e5d8a68bceded74c19d81deffd13b4.jpg?jadewits_media_id=916277" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2024/05/13/-c7e5d8a68bceded74c19d81deffd13b4.jpg?jadewits_media_id=916277" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কাঁঠালবাগানে সিলিন্ডার বিস্ফোরণ: মায়ের মৃত্যু, আশঙ্কাজনক সন্তান" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর কলাবাগানের কাঁঠালবাগানে গ্যাস সিলিন্ডার লিকেজ থেকে অগ্নিকাণ্ডে দগ্ধ সাবা আক্তার (২০) মারা গেছেন। এ ঘটনায় তার দেড় বছর বয়সী সন্তান আর এস রহমানও আশঙ্কাজনক অবস্থায় হাসপাতালে চিকিৎসাধীন। শিশুটির শরীরের ৫৭ শতাংশ দগ্ধ হয়েছে।
শুক্রবার (২০ নভেম্বর) বিকাল সাড়ে ৪টার দিকে জাতীয় বার্ন ও প্লাস্টিক সার্জা&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/982270/%E0%A6%95%E0%A6%BE%E0%A6%81%E0%A6%A0%E0%A6%BE%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A6%97%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%B8%E0%A6%BF%E0%A6%B2%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>মোহাম্মদপুরে ‘কিশোর গ্যাংয়ের লিডার’ রমজান আটক</title>

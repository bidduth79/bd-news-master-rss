      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/39fb05df781038c5cee6f9fef0532152-6b09b6eca2cec.jpeg?jadewits_media_id=1057350" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যৌথ সামরিক মহড়ায় চীন ও কম্বোডিয়া" /&gt;&lt;/p&gt;&lt;p&gt;&amp;lsquo;শান্তি, বন্ধুত্ব ও সহযোগিতা&amp;rsquo;&amp;mdash;এই প্রতিপাদ্যকে সামনে রেখে যৌথ সামরিক মহড়া শুরু করেছে চীন ও কম্বোডিয়া। কম্বোডিয়ার রিয়াম বন্দরে অবস্থিত &amp;lsquo;কম্বোডিয়া-চীন যৌথ সহায়তা ও প্রশিক্ষণ কেন্দ্রে&amp;rsquo; এ মহড়া শুরু হয়। উদ্বোধনী অনুষ্ঠানে দুই দেশের অংশগ্রহণকারী সামরিক কর্মকর্তা ও সেনারা উপস্থ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/asia/983684/%E0%A6%AF%E0%A7%8C%E0%A6%A5-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%B0%E0%A6%BF%E0%A6%95-%E0%A6%AE%E0%A6%B9%E0%A7%9C%E0%A6%BE%E0%A7%9F-%E0%A6%9A%E0%A7%80%E0%A6%A8-%E0%A6%93-%E0%A6%95%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A7%8B%E0%A6%A1%E0%A6%BF%E0%A7%9F%E0%A6%BE">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>মন্ত্রীর বাড়ির পাশে বিএনপির দুই গ্রুপের সংঘর্ষে আহত ১১, মোটরসাইকেলে আগুন</title>
      <link>https://www.banglatribune.com/country/chitagong/983683/%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A6%BE%E0%A6%B6%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%AA%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/chitagong/983683/%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A6%BE%E0%A6%B6%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%AA%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A7%87</guid>
      <pubDate>Fri, 27 Nov 2026 22:59:38 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/882a2d2c9cb95761198e4c719005313e-6b09b6e3ef178.jpg?jadewits_media_id=1057349" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/882a2d2c9cb95761198e4c719005313e-6b09b6e3ef178.jpg?jadewits_media_id=1057349" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/882a2d2c9cb95761198e4c719005313e-6b09b6e3ef178.jpg?jadewits_media_id=1057349" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মন্ত্রীর বাড়ির পাশে বিএনপির দুই গ্রুপের সংঘর্ষে আহত ১১, মোটরসাইকেলে আগুন" /&gt;&lt;/p&gt;&lt;p&gt;ফেনীর দাগনভূঞায় বিএনপির অভ্যন্তরীণ কোন্দলের জেরে আবারও দুই পক্ষের মধ্যে সংঘর্ষ, হামলা ও অগ্নিসংযোগের ঘটনা ঘটেছে। এতে কমপক্ষে ১১ জন আহত হয়েছেন। আহত একজনের আঙুলের কিছু অংশ বিচ্ছিন্ন হয়ে গেছে।
শুক্রবার (২৭ নভেম্বর) বিকালে পৌরসভার আলাইয়ারপুর গ্রামে পরিবেশ, বন ও জলবায়ু পরিবর্তনমন্ত্রী আবদুল আউয়াল মিন্টুর&lt;/p&gt;</description>

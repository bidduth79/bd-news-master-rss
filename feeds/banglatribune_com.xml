    <item>
      <title>গোপনীয়তা ভেঙে বিয়ের ছবি প্রকাশ করলেন মিমি</title>
      <link>https://www.banglatribune.com/entertainment/983490/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%A8%E0%A7%80%E0%A7%9F%E0%A6%A4%E0%A6%BE-%E0%A6%AD%E0%A7%87%E0%A6%99%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%9B%E0%A6%AC%E0%A6%BF-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B6-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AE%E0%A6%BF%E0%A6%AE%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.banglatribune.com/entertainment/983490/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%A8%E0%A7%80%E0%A7%9F%E0%A6%A4%E0%A6%BE-%E0%A6%AD%E0%A7%87%E0%A6%99%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%9B%E0%A6%AC%E0%A6%BF-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B6-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AE%E0%A6%BF%E0%A6%AE%E0%A6%BF</guid>
      <pubDate>Fri, 27 Nov 2026 00:30:25 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/2687969b8208d5f712215ff66e44f229-6b087a8b6cd2b.jpg?jadewits_media_id=1057155" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/2687969b8208d5f712215ff66e44f229-6b087a8b6cd2b.jpg?jadewits_media_id=1057155" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/2687969b8208d5f712215ff66e44f229-6b087a8b6cd2b.jpg?jadewits_media_id=1057155" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গোপনীয়তা ভেঙে বিয়ের ছবি প্রকাশ করলেন মিমি" /&gt;&lt;/p&gt;&lt;p&gt;কয়েক দিন ধরে চলা নানা জল্পনার অবসান ঘটিয়ে অবশেষে নিজের বিয়ের ছবি প্রকাশ করলেন কলকাতার জনপ্রিয় অভিনেত্রী মিমি চক্রবর্তী। পাত্র সিদ্ধার্থ দত্ত, পেশায় মেরিন ইঞ্জিনিয়ার। বৃহস্পতিবার (২৬ নভেম্বর) সন্ধ্যায় দক্ষিণ কলকাতার কসবার বাড়িতে ঘরোয়া আয়োজনে আইনি বিয়ে সেরেছেন তারা।
বাংলাদেশ সময় আজ রাত ১০টা ৪২ মিনিটে &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/entertainment/983490/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%A8%E0%A7%80%E0%A7%9F%E0%A6%A4%E0%A6%BE-%E0%A6%AD%E0%A7%87%E0%A6%99%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%9B%E0%A6%AC%E0%A6%BF-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B6-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AE%E0%A6%BF%E0%A6%AE%E0%A6%BF">বাংলা ট্রিবিউন</source>
    </item>

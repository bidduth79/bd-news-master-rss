      <title>মেসির সপ্তম শ্রেণির পুরোনো মার্কশিট ঘিরে আলোচনা, কোন বিষয়ে কত পেয়েছিলেন?</title>
      <link>https://www.banglatribune.com/sport/football/983452/%E0%A6%AE%E0%A7%87%E0%A6%B8%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%AE-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A3%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%8B%E0%A6%A8%E0%A7%8B-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%B6%E0%A6%BF%E0%A6%9F-%E0%A6%98%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%B2%E0%A7%8B%E0%A6%9A%E0%A6%A8%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/football/983452/%E0%A6%AE%E0%A7%87%E0%A6%B8%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%AE-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A3%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%8B%E0%A6%A8%E0%A7%8B-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%B6%E0%A6%BF%E0%A6%9F-%E0%A6%98%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%B2%E0%A7%8B%E0%A6%9A%E0%A6%A8%E0%A6%BE</guid>
      <pubDate>Thu, 26 Nov 2026 20:49:01 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/95d80d659e0177e3e62de81a7a68bcae-6b0846b6ae607.jpg?jadewits_media_id=1057112" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/95d80d659e0177e3e62de81a7a68bcae-6b0846b6ae607.jpg?jadewits_media_id=1057112" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/95d80d659e0177e3e62de81a7a68bcae-6b0846b6ae607.jpg?jadewits_media_id=1057112" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মেসির সপ্তম শ্রেণির পুরোনো মার্কশিট ঘিরে আলোচনা, কোন বিষয়ে কত পেয়েছিলেন?" /&gt;&lt;/p&gt;&lt;p&gt;ফুটবল মাঠে একের পর এক গোল করে বিশ্বজুড়ে কোটি ভক্তের মন জয় করেছেন লিওনেল মেসি। সর্বকালের অন্যতম সেরা ফুটবলার হিসেবে তার নাম সবার মুখে মুখে। কিন্তু স্কুলজীবনে কেমন ছিলেন এই আর্জেন্টাইন মহাতারকা? পড়াশোনাতেও কি সমান মেধাবী ছিলেন? সামাজিক যোগাযোগমাধ্যমে সম্প্রতি মেসির সপ্তম শ্রেণির একটি মার্কশিট ছড়িয়ে পড়&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/football/983452/%E0%A6%AE%E0%A7%87%E0%A6%B8%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%AE-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A3%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%8B%E0%A6%A8%E0%A7%8B-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%B6%E0%A6%BF%E0%A6%9F-%E0%A6%98%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%B2%E0%A7%8B%E0%A6%9A%E0%A6%A8%E0%A6%BE">বাংলা ট্রিবিউন</source>
    </item>

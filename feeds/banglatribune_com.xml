    <item>
      <title>রাজস্থানের পঞ্চায়েত ভোটে কংগ্রেসের জয়জয়কার, কোণঠাসা বিজেপি</title>
      <link>https://www.banglatribune.com/foreign/india/982418/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%A4-%E0%A6%AD%E0%A7%8B%E0%A6%9F%E0%A7%87-%E0%A6%95%E0%A6%82%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A7%9F%E0%A6%9C%E0%A7%9F%E0%A6%95%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/india/982418/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%A4-%E0%A6%AD%E0%A7%8B%E0%A6%9F%E0%A7%87-%E0%A6%95%E0%A6%82%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A7%9F%E0%A6%9C%E0%A7%9F%E0%A6%95%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Sat, 21 Nov 2026 21:44:35 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/819b579c48435fe734b5d4aa04617587-6b01bbeec138c.jpg?jadewits_media_id=1056249" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/819b579c48435fe734b5d4aa04617587-6b01bbeec138c.jpg?jadewits_media_id=1056249" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/819b579c48435fe734b5d4aa04617587-6b01bbeec138c.jpg?jadewits_media_id=1056249" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজস্থানের পঞ্চায়েত ভোটে কংগ্রেসের জয়জয়কার, কোণঠাসা বিজেপি" /&gt;&lt;/p&gt;&lt;p&gt;ভারতের রাজস্থানে পঞ্চায়েত নির্বাচনে ক্ষমতাসীন বিজেপির বিরুদ্ধে বড় জয় পেয়েছে কংগ্রেস। রাজনৈতিক বিশ্লেষকেরা এই ফলাফলকে আগামী ডিসেম্বরে তিন বছর পূর্ণ করতে যাওয়া ভারতীয় জনতা পার্টি (বিজেপি) সরকারের প্রতি গ্রামীণ ভোটারদের অসন্তোষের ইঙ্গিত হিসেবে দেখছেন। ভারতের সংবাদমাধ্যম দ্য হিন্দুস্তান টাইমস এ খবর জানি&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/india/982418/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%A4-%E0%A6%AD%E0%A7%8B%E0%A6%9F%E0%A7%87-%E0%A6%95%E0%A6%82%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A7%9F%E0%A6%9C%E0%A7%9F%E0%A6%95%E0%A6%BE%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>৯ জেলায় ৫৩ প্লাটুন আনসার মোতায়েন</title>
      <link>https://www.banglatribune.com/law-and-crime/982417/%E0%A7%AF-%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A7%AB%E0%A7%A9-%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%9F%E0%A7%81%E0%A6%A8-%E0%A6%86%E0%A6%A8%E0%A6%B8%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A7%8B%E0%A6%A4%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/982417/%E0%A7%AF-%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A7%AB%E0%A7%A9-%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%9F%E0%A7%81%E0%A6%A8-%E0%A6%86%E0%A6%A8%E0%A6%B8%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A7%8B%E0%A6%A4%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Sat, 21 Nov 2026 21:38:49 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/d996cf64645df7aa7caa1c6fa628d286-6b01b9c138436.jpg?jadewits_media_id=1056247" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/d996cf64645df7aa7caa1c6fa628d286-6b01b9c138436.jpg?jadewits_media_id=1056247" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/d996cf64645df7aa7caa1c6fa628d286-6b01b9c138436.jpg?jadewits_media_id=1056247" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৯ জেলায় ৫৩ প্লাটুন আনসার মোতায়েন" /&gt;&lt;/p&gt;&lt;p&gt;দেশের বিভিন্ন স্থানে জনজীবন ও শিল্পকারখানার কার্যক্রমে স্বাভাবিক গতি ফিরতে শুরু করেছে। গোপালগঞ্জ, ফরিদপুর, মাদারীপুর ও শরীয়তপুরের গুরুত্বপূর্ণ স্থাপনাসহ বিভিন্ন পয়েন্টে পরিস্থিতি শান্ত রয়েছে। গাজীপুর ও নারায়ণগঞ্জের শিল্পাঞ্চলেও শ্রমিকদের কর্মস্থলে ফেরা, কারখানার কার্যক্রম সচল রাখা এবং সড়কে যান &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/982417/%E0%A7%AF-%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A7%AB%E0%A7%A9-%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%9F%E0%A7%81%E0%A6%A8-%E0%A6%86%E0%A6%A8%E0%A6%B8%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A7%8B%E0%A6%A4%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%A8">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>আ.লীগের সাবেক ৪ এমপি-প্রতিমন্ত্রীর বাড়িতে হামলা-ভাঙচুর, পুলিশ বলছে ‘কেউ অভিযোগ করেনি’</title>
      <link>https://www.banglatribune.com/country/barishal/982416/%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A7%AA-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/barishal/982416/%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A7%AA-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87</guid>
      <pubDate>Sat, 21 Nov 2026 21:36:32 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/2f80585ea0ba2cfc52a56697f7933495-6b01ba4823e98.jpg?jadewits_media_id=1056248" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/2f80585ea0ba2cfc52a56697f7933495-6b01ba4823e98.jpg?jadewits_media_id=1056248" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/2f80585ea0ba2cfc52a56697f7933495-6b01ba4823e98.jpg?jadewits_media_id=1056248" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আ.লীগের সাবেক ৪ এমপি-প্রতিমন্ত্রীর বাড়িতে হামলা-ভাঙচুর, পুলিশ বলছে ‘কেউ অভিযোগ করেনি’" /&gt;&lt;/p&gt;&lt;p&gt;পটুয়াখালীতে কার্যক্রম নিষিদ্ধ আওয়ামী লীগের সাবেক চার জন সংসদ সদস্য ও এক পৌর মেয়রের বাড়িতে হামলা-ভাঙচুরের ঘটনা ঘটেছে। গত বুধবার রাত থেকে শুক্রবার রাত ৯টার মধ্যে এসব ঘটনা ঘটে।&amp;nbsp;
স্থানীয় সূত্রে জানা যায়, শুক্রবার রাতে কলাপাড়া উপজেলা শহরে পটুয়াখালী-৪ আসনের সাবেক সংসদ সদস্য মৃত আনোয়ার-উল ইসলাম ও সাবে&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/barishal/982416/%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A7%AA-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>নাশকতা দমনে কঠোর সরকার, বদলাচ্ছে কৌশল</title>
      <link>https://www.banglatribune.com/law-and-crime/982415/%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%BE-%E0%A6%A6%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%95%E0%A6%A0%E0%A7%8B%E0%A6%B0-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%95%E0%A7%8C%E0%A6%B6%E0%A6%B2%C2%A0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/982415/%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%BE-%E0%A6%A6%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%95%E0%A6%A0%E0%A7%8B%E0%A6%B0-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%95%E0%A7%8C%E0%A6%B6%E0%A6%B2%C2%A0</guid>
      <pubDate>Sat, 21 Nov 2026 21:35:34 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/5921f4cce81dda5b60dc21a442db05fd-6afcaaec6e474.jpg?jadewits_media_id=1055568" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/5921f4cce81dda5b60dc21a442db05fd-6afcaaec6e474.jpg?jadewits_media_id=1055568" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/5921f4cce81dda5b60dc21a442db05fd-6afcaaec6e474.jpg?jadewits_media_id=1055568" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নাশকতা দমনে কঠোর সরকার, বদলাচ্ছে কৌশল" /&gt;&lt;/p&gt;&lt;p&gt;অপরাধ ঘটার পর অভিযান নয়। এবার অপরাধ ঘটার আগেই প্রতিরোধ গড়ে তুলতে চায় সরকার। রাজপথে ককটেল বিস্ফোরণ, যানবাহনে অগ্নিসংযোগ, থানা ও সরকারি স্থাপনায় হামলা এবং দেশের বিভিন্ন অঞ্চলে সংঘবদ্ধ সহিংসতার ঘটনায় আইনশৃঙ্খলা পরিস্থিতি মোকাবিলায় বদলে যাচ্ছে সরকারের কৌশল। শুধু গ্রেফতার কিংবা অতিরিক্ত বাহিনী মোতায়েন নয়&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/982415/%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%BE-%E0%A6%A6%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%95%E0%A6%A0%E0%A7%8B%E0%A6%B0-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%95%E0%A7%8C%E0%A6%B6%E0%A6%B2%C2%A0">বাংলা ট্রিবিউন</source>
    </item>

    <item>
      <title>সোমবার শুরু হচ্ছে সংসদের চতুর্থ অধিবেশন</title>
      <link>https://www.banglatribune.com/national/979660/%E0%A6%B8%E0%A7%8B%E0%A6%AE%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%A5-%E0%A6%85%E0%A6%A7%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/national/979660/%E0%A6%B8%E0%A7%8B%E0%A6%AE%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%A5-%E0%A6%85%E0%A6%A7%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%A8</guid>
      <pubDate>Sun, 08 Nov 2026 20:03:14 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/03/15/b92b991a217bb3b5ab970610525971db-69b686a2976fd.jpg?jadewits_media_id=1015418" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/03/15/b92b991a217bb3b5ab970610525971db-69b686a2976fd.jpg?jadewits_media_id=1015418" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/03/15/b92b991a217bb3b5ab970610525971db-69b686a2976fd.jpg?jadewits_media_id=1015418" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সোমবার শুরু হচ্ছে সংসদের চতুর্থ অধিবেশন" /&gt;&lt;/p&gt;&lt;p&gt;ত্রয়োদশ জাতীয় সংসদের চতুর্থ অধিবেশন সোমবার (৯ নভেম্বর) শুরু হচ্ছে। এ অধিবেশন আগামী ১৮ নভেম্বর শেষ হবে। প্রথম দিন বিকাল সাড়ে ৩টায় সংসদের বৈঠক শুরু হবে। এরপর সরকারি ছুটির দিন (শুক্র ও শনিবার) ছাড়া প্রতিদিন বিকাল ৪টা ২০ মিনিটে সংসদের বৈঠক বসবে। অধিবেশনের প্রথম দিন তিনটি অধ্যাদেশ উপস্থাপন করা হবে। এছাড়া&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/979660/%E0%A6%B8%E0%A7%8B%E0%A6%AE%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%A5-%E0%A6%85%E0%A6%A7%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%A8">বাংলা ট্রিবিউন</source>
    </item>

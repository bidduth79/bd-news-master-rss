    <item>
      <title>সিপিএ মহাসচিবের সঙ্গে চিফ হুইপের বৈঠক</title>
      <link>https://www.banglatribune.com/politics/bnp/982637/%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF%E0%A6%8F-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%9A%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%9A%E0%A6%BF%E0%A6%AB-%E0%A6%B9%E0%A7%81%E0%A6%87%E0%A6%AA%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95</link>
      <guid isPermaLink="true">https://www.banglatribune.com/politics/bnp/982637/%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF%E0%A6%8F-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%9A%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%9A%E0%A6%BF%E0%A6%AB-%E0%A6%B9%E0%A7%81%E0%A6%87%E0%A6%AA%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95</guid>
      <pubDate>Mon, 23 Nov 2026 03:37:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/451faa5e6c49f385613b5a1c62b0cfcf-6b0356b0e2f1e.jpg?jadewits_media_id=1056439" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/451faa5e6c49f385613b5a1c62b0cfcf-6b0356b0e2f1e.jpg?jadewits_media_id=1056439" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/451faa5e6c49f385613b5a1c62b0cfcf-6b0356b0e2f1e.jpg?jadewits_media_id=1056439" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সিপিএ মহাসচিবের সঙ্গে চিফ হুইপের বৈঠক" /&gt;&lt;/p&gt;&lt;p&gt;সংসদীয় গণতন্ত্রের বিকাশ, প্রাতিষ্ঠানিক সক্ষমতা বৃদ্ধি এবং আন্তর্জাতিক সংসদীয় সহযোগিতা জোরদারের বিষয়ে কমনওয়েলথ পার্লামেন্টারি অ্যাসোসিয়েশনের (সিপিএ) মহাসচিব স্টিফেন টুইগের সঙ্গে বৈঠক করেছেন জাতীয় সংসদের চিফ হুইপ নূরুল ইসলাম মনি।
রবিবার (২২ নভেম্বর) জাতীয় সংসদের প্রেস ব্জ্ঞিপ্তিতে জানানো হয়, গত ২০ নভে&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/politics/bnp/982637/%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF%E0%A6%8F-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%9A%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%9A%E0%A6%BF%E0%A6%AB-%E0%A6%B9%E0%A7%81%E0%A6%87%E0%A6%AA%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>‘টকশোতে আ.লীগের পক্ষে বললে জুতা দিয়ে পেটাবেন’ বক্তব্যের যে ব্যাখ্যা দিলেন রাশেদ খাঁন</title>
      <link>https://www.banglatribune.com/politics/bnp/982636/%E2%80%98%E0%A6%9F%E0%A6%95%E0%A6%B6%E0%A7%8B%E0%A6%A4%E0%A7%87-%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A7%87-%E0%A6%9C%E0%A7%81%E0%A6%A4%E0%A6%BE-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%A8%E2%80%99</link>
      <guid isPermaLink="true">https://www.banglatribune.com/politics/bnp/982636/%E2%80%98%E0%A6%9F%E0%A6%95%E0%A6%B6%E0%A7%8B%E0%A6%A4%E0%A7%87-%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A7%87-%E0%A6%9C%E0%A7%81%E0%A6%A4%E0%A6%BE-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%A8%E2%80%99</guid>
      <pubDate>Mon, 23 Nov 2026 03:14:38 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/09/16/d198d5c9b2997129d867f04d66f1d2ab-6aaa6a2648edf.jpg?jadewits_media_id=1044049" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/09/16/d198d5c9b2997129d867f04d66f1d2ab-6aaa6a2648edf.jpg?jadewits_media_id=1044049" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/09/16/d198d5c9b2997129d867f04d66f1d2ab-6aaa6a2648edf.jpg?jadewits_media_id=1044049" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘টকশোতে আ.লীগের পক্ষে বললে জুতা দিয়ে পেটাবেন’ বক্তব্যের যে ব্যাখ্যা দিলেন রাশেদ খাঁন" /&gt;&lt;/p&gt;&lt;p&gt;প্রধানমন্ত্রীর রাজনৈতিক সহকারী রাশেদ খাঁন বলেছেন, ‘কেউ টকশোতে আওয়ামী গণহত্যাকারীদের পক্ষে বয়ান উৎপাদন না করলে তো আমার বক্তব্য নিয়ে প্রতিক্রিয়া দেখানোর কথা নয়। গোপালগঞ্জের আগুনসন্ত্রাসীদের পক্ষে যারা কথা বলছে, যারা নড়াইল ও ফরিদপুরে আমার ভাইদের খুনিদের পক্ষে কথা বলছে, আমি তো তাদের বিরুদ্ধে বলেছি। আমি &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/politics/bnp/982636/%E2%80%98%E0%A6%9F%E0%A6%95%E0%A6%B6%E0%A7%8B%E0%A6%A4%E0%A7%87-%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A7%87-%E0%A6%9C%E0%A7%81%E0%A6%A4%E0%A6%BE-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%A8%E2%80%99">বাংলা ট্রিবিউন</source>
    </item>

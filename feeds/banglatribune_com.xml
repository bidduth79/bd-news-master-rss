      <guid isPermaLink="true">https://www.banglatribune.com/sport/cricket/981615/%E0%A6%86%E0%A6%87%E0%A6%AA%E0%A6%BF%E0%A6%8F%E0%A6%B2%E0%A7%87-%E0%A6%A7%E0%A7%8B%E0%A6%A8%E0%A6%BF%E0%A6%B0-%E0%A6%86%E0%A7%9F-%E0%A6%95%E0%A6%A4-%E0%A6%95%E0%A7%8B%E0%A6%A8-%E0%A6%AE%E0%A7%8C%E0%A6%B8%E0%A7%81%E0%A6%AE%E0%A7%87-%E0%A6%AA%E0%A7%87%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%B8%E0%A6%AC%E0%A6%9A%E0%A7%87%E0%A7%9F%E0%A7%87</guid>

    <item>
      <title>ডেঙ্গুতে একদিনে প্রাণ গেলো আরও একজনের, আক্রান্ত ১০০৩</title>
      <link>https://www.banglatribune.com/health/983447/%E0%A6%A1%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%81%E0%A6%A4%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3-%E0%A6%97%E0%A7%87%E0%A6%B2%E0%A7%8B-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A6%8F%E0%A6%95%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4</link>
      <guid isPermaLink="true">https://www.banglatribune.com/health/983447/%E0%A6%A1%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%81%E0%A6%A4%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3-%E0%A6%97%E0%A7%87%E0%A6%B2%E0%A7%8B-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A6%8F%E0%A6%95%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4</guid>
      <pubDate>Thu, 26 Nov 2026 20:40:51 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/10/22/89129c5cb44f6620f4ddcf73be8e7bcb-6ada4d0a920a0.jpg?jadewits_media_id=1050865" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/10/22/89129c5cb44f6620f4ddcf73be8e7bcb-6ada4d0a920a0.jpg?jadewits_media_id=1050865" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/10/22/89129c5cb44f6620f4ddcf73be8e7bcb-6ada4d0a920a0.jpg?jadewits_media_id=1050865" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডেঙ্গুতে একদিনে প্রাণ গেলো আরও একজনের, আক্রান্ত ১০০৩" /&gt;&lt;/p&gt;&lt;p&gt;সারা দেশে গত ২৪ ঘণ্টায় ডেঙ্গুতে আক্রান্ত হয়ে আরও একজনের মৃত্যু হয়েছে। বুধবার (২৫ নভেম্বর) সকাল ৮টা থেকে বৃহস্পতিবার (২৬ নভেম্বর) সকাল ৮টার মধ্যে তাদের মৃত্যু হয়। একই সময়ের মধ্যে ডেঙ্গুতে আক্রান্ত হয়ে নতুন করে হাসপাতালে ভর্তি হয়েছেন ১ হাজার ৩ জন।
বৃহস্পতিবার স্বাস্থ্য অধিদফতরের প্রকাশিত বিজ্ঞপ্তিতে এ&lt;/p&gt;</description>

      <guid isPermaLink="true">https://www.banglatribune.com/my-campus/983265/%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A6%A6-%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BE%E0%A6%B8-%E0%A6%97%E0%A7%9C%E0%A6%A4%E0%A7%87-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A7%AA%E0%A7%AD-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%AC</guid>
      <pubDate>Wed, 25 Nov 2026 23:28:03 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/bf84722d1c02e064c6dcf10b5c01b123-6b07191a8d30e.jpg?jadewits_media_id=1056945" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/bf84722d1c02e064c6dcf10b5c01b123-6b07191a8d30e.jpg?jadewits_media_id=1056945" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/bf84722d1c02e064c6dcf10b5c01b123-6b07191a8d30e.jpg?jadewits_media_id=1056945" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নিরাপদ ক্যাম্পাস গড়তে শিক্ষার্থীদের ৪৭ প্রস্তাব, পুরস্কার পেলো ১১টি" /&gt;&lt;/p&gt;&lt;p&gt;লিঙ্গভিত্তিক সহিংসতা ও যৌন হয়রানিমুক্ত ক্যাম্পাস গড়তে ঢাকা বিশ্ববিদ্যালয়ের শিক্ষার্থীদের কাছ থেকে ৪৭টি প্রস্তাব জমা পড়েছে। এসব প্রস্তাবের মধ্য থেকে ১১টি ধারণাকে পুরস্কৃত করা হয়েছে। বুধবার (২৫ নভেম্বর) বিশ্ববিদ্যালয়ের অধ্যাপক মুজাফফর আহমেদ চৌধুরী মিলনায়তনে আয়োজিত এক আলোচনা অনুষ্ঠানে বিজয়ীদের হাতে পুর&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/my-campus/983265/%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A6%A6-%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BE%E0%A6%B8-%E0%A6%97%E0%A7%9C%E0%A6%A4%E0%A7%87-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A7%AA%E0%A7%AD-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%AC">বাংলা ট্রিবিউন</source>

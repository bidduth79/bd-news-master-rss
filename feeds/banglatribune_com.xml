    <item>
      <title>এইচএসসির ১১ লাখ উত্তরপত্র পুনর্মূল্যায়নের আবেদন, কোন সাবজেক্ট বেশি?</title>
      <link>https://www.banglatribune.com/educations/979715/%E0%A6%8F%E0%A6%87%E0%A6%9A%E0%A6%8F%E0%A6%B8%E0%A6%B8%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A7%A7%E0%A7%A7-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%89%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AA%E0%A7%81%E0%A6%A8%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%82%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A7%9F%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%AC%E0%A7%87%E0%A6%A6%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/educations/979715/%E0%A6%8F%E0%A6%87%E0%A6%9A%E0%A6%8F%E0%A6%B8%E0%A6%B8%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A7%A7%E0%A7%A7-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%89%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AA%E0%A7%81%E0%A6%A8%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%82%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A7%9F%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%AC%E0%A7%87%E0%A6%A6%E0%A6%A8</guid>
      <pubDate>Mon, 09 Nov 2026 04:10:20 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/a6e1f42d481f5c849647f0aa115a6e9d-6af0e64c07c7b.jpg?jadewits_media_id=1053960" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/a6e1f42d481f5c849647f0aa115a6e9d-6af0e64c07c7b.jpg?jadewits_media_id=1053960" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/a6e1f42d481f5c849647f0aa115a6e9d-6af0e64c07c7b.jpg?jadewits_media_id=1053960" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এইচএসসির ১১ লাখ উত্তরপত্র পুনর্মূল্যায়নের আবেদন, কোন সাবজেক্ট বেশি?" /&gt;&lt;/p&gt;&lt;p&gt;চলতি বছরের এইচএসসি ও সমমানের পরীক্ষার ফলাফল প্রকাশের পর মোট ১০ লাখ ৮৭ হাজার ৪১৩টি উত্তরপত্র (বিষয়) পুনর্নিরীক্ষা ও পুনর্মূল্যায়নের আবেদন করা হয়েছে।
উত্তরপত্র পুনর্নিরীক্ষণ ও পুনর্মূল্যায়নের জন্য দেশের ১১টি শিক্ষা বোর্ডে দুই লাখ ৯১ হাজার ২০৯ জন শিক্ষার্থী এই আবেদন করেছেন। তারা ইংরেজি ও আইসিটিসহ বিভিন&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/educations/979715/%E0%A6%8F%E0%A6%87%E0%A6%9A%E0%A6%8F%E0%A6%B8%E0%A6%B8%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A7%A7%E0%A7%A7-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%89%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AA%E0%A7%81%E0%A6%A8%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%82%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A7%9F%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%AC%E0%A7%87%E0%A6%A6%E0%A6%A8">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>মন্দিরে মন্দিরে প্রদীপ জ্বালিয়ে শ্যামা পূজা উদযাপন</title>

    <item>
      <title>দেশে এলে শেখ হাসিনার জন্য দুটি জায়গা প্রস্তুত: হাবিব উন নবী খান</title>
      <link>https://www.banglatribune.com/politics/bnp/982165/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%8F%E0%A6%B2%E0%A7%87-%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%A6%E0%A7%81%E0%A6%9F%E0%A6%BF-%E0%A6%9C%E0%A6%BE%E0%A7%9F%E0%A6%97%E0%A6%BE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%81%E0%A6%A4</link>
      <guid isPermaLink="true">https://www.banglatribune.com/politics/bnp/982165/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%8F%E0%A6%B2%E0%A7%87-%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%A6%E0%A7%81%E0%A6%9F%E0%A6%BF-%E0%A6%9C%E0%A6%BE%E0%A7%9F%E0%A6%97%E0%A6%BE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%81%E0%A6%A4</guid>
      <pubDate>Fri, 20 Nov 2026 16:51:53 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/c8513826120c2555c146cd1182194a01-6b00255a4ad75.jpg?jadewits_media_id=1056026" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/c8513826120c2555c146cd1182194a01-6b00255a4ad75.jpg?jadewits_media_id=1056026" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/c8513826120c2555c146cd1182194a01-6b00255a4ad75.jpg?jadewits_media_id=1056026" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দেশে এলে শেখ হাসিনার জন্য দুটি জায়গা প্রস্তুত: হাবিব উন নবী খান" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ জাতীয়তাবাদী দলের (বিএনপি) যুগ্ম মহাসচিব হাবিব উন নবী খান সোহেল বলেছেন, শেখ হাসিনা দেশে আসুক, আমরা চাই। উনি দেশে এলে রায় আমরা বাস্তবায়ন করবো। আপা, আসবেন, আমরা অপেক্ষায় আছি।
শুক্রবার (২০ নভেম্বর) জাতীয় প্রেসক্লাবের সামনে সারা দেশে আওয়ামী লীগের আন্দোলন ঘিরে সন্ত্রাস-নৈরাজ্যের প্রতিবাদে জাতীয়তা&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/politics/bnp/982165/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%8F%E0%A6%B2%E0%A7%87-%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%A6%E0%A7%81%E0%A6%9F%E0%A6%BF-%E0%A6%9C%E0%A6%BE%E0%A7%9F%E0%A6%97%E0%A6%BE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%81%E0%A6%A4">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>মেক্সিকোয় মহাসড়কের পাশে উড়োজাহাজ বিধ্বস্ত</title>
      <link>https://www.banglatribune.com/foreign/america/982164/%E0%A6%AE%E0%A7%87%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%BF%E0%A6%95%E0%A7%8B%E0%A7%9F-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A7%9C%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%BE%E0%A6%B6%E0%A7%87-%E0%A6%89%E0%A7%9C%E0%A7%8B%E0%A6%9C%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%9C-%E0%A6%AC%E0%A6%BF%E0%A6%A7%E0%A7%8D%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A4</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/america/982164/%E0%A6%AE%E0%A7%87%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%BF%E0%A6%95%E0%A7%8B%E0%A7%9F-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A7%9C%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%BE%E0%A6%B6%E0%A7%87-%E0%A6%89%E0%A7%9C%E0%A7%8B%E0%A6%9C%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%9C-%E0%A6%AC%E0%A6%BF%E0%A6%A7%E0%A7%8D%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A4</guid>
      <pubDate>Fri, 20 Nov 2026 16:45:40 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/cd8adf6a364f108fb9c04a0abf6b96d8-6b0024a036543.jpg?jadewits_media_id=1056025" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/cd8adf6a364f108fb9c04a0abf6b96d8-6b0024a036543.jpg?jadewits_media_id=1056025" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/cd8adf6a364f108fb9c04a0abf6b96d8-6b0024a036543.jpg?jadewits_media_id=1056025" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মেক্সিকোয় মহাসড়কের পাশে উড়োজাহাজ বিধ্বস্ত" /&gt;&lt;/p&gt;&lt;p&gt;মেক্সিকোর মনতেরেই আন্তর্জাতিক বিমানবন্দরের কাছে রানওয়ে থেকে ছিটকে ব্যস্ত মহাসড়কের পাশে বিধ্বস্ত হয়েছে একটি ছোট উড়োজাহাজ। ১৮ নভেম্বরের এ দুর্ঘটনার পর উড়োজাহাজটিতে আগুন ধরে যায়। তবে এতে থাকা ছয় আরোহীই প্রাণে বেঁচে গেছেন। তাদের সামান্য আঘাত লেগেছে।
স্থানীয় সময় দুপুর ১টা ৫০ মিনিটের দিকে এ দুর্ঘটনা ঘটে। &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/america/982164/%E0%A6%AE%E0%A7%87%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%BF%E0%A6%95%E0%A7%8B%E0%A7%9F-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A7%9C%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%BE%E0%A6%B6%E0%A7%87-%E0%A6%89%E0%A7%9C%E0%A7%8B%E0%A6%9C%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%9C-%E0%A6%AC%E0%A6%BF%E0%A6%A7%E0%A7%8D%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A4">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>বৃষ্টির মধ্যে পেট্রোল ঢেলে গ্রামীণ ব্যাংকের জোনাল অফিসে আগুন</title>
      <link>https://www.banglatribune.com/country/chitagong/982163/%E0%A6%AC%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%B0-%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B2-%E0%A6%A2%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%A3-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B2</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/chitagong/982163/%E0%A6%AC%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%B0-%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B2-%E0%A6%A2%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%A3-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B2</guid>
      <pubDate>Fri, 20 Nov 2026 16:38:27 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/dd829c5b4ab8684030a639285c9414e9-6b002319c465e.jpg?jadewits_media_id=1056023" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/dd829c5b4ab8684030a639285c9414e9-6b002319c465e.jpg?jadewits_media_id=1056023" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/dd829c5b4ab8684030a639285c9414e9-6b002319c465e.jpg?jadewits_media_id=1056023" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বৃষ্টির মধ্যে পেট্রোল ঢেলে গ্রামীণ ব্যাংকের জোনাল অফিসে আগুন" /&gt;&lt;/p&gt;&lt;p&gt;নোয়াখালীর বেগমগঞ্জ উপজেলার চৌমুহনী পূর্ব বাজারে গ্রামীণ ব্যাংকের এরিয়া অফিসে পেট্রোল ঢেলে আগুন ও জানালার গ্লাস ভাঙচুর করেছেন কার্যক্রম নিষিদ্ধ যুবলীগের কর্মীরা। এতে অফিসটির একটা দরজা পুড়ে গেছে। পরে স্থানীয় লোকজন আগুন নিয়ন্ত্রণ করেন।
শুক্রবার (২০ নভেম্বর) দুপুর আড়াইটার দিকে চৌমুহনী পূর্ব বাজারে এ ঘটন&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/chitagong/982163/%E0%A6%AC%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%B0-%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B2-%E0%A6%A2%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%A3-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B2">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>জন্মদিনে সুখবর দিলেন বুবলী</title>

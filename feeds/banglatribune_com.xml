      <guid isPermaLink="true">https://www.banglatribune.com/country/mymensing/981762/%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%AA%E0%A7%81%E0%A7%9C%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A6%87-%E0%A6%AA%E0%A6%BE%E0%A6%B6%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Wed, 18 Nov 2026 18:37:17 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/ac01cc2cdf4650e2f8a1bfe7bcdbb9f5-6afd9bf587de2.jpg?jadewits_media_id=1055701" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/ac01cc2cdf4650e2f8a1bfe7bcdbb9f5-6afd9bf587de2.jpg?jadewits_media_id=1055701" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/ac01cc2cdf4650e2f8a1bfe7bcdbb9f5-6afd9bf587de2.jpg?jadewits_media_id=1055701" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নেত্রকোনায় বিএনপির কার্যালয়ে আগুন, পুড়ে ছাই পাশের দোকানও" /&gt;&lt;/p&gt;&lt;p&gt;নেত্রকোনার বারহাট্টা উপজেলার চিরাম ইউনিয়ন বিএনপির দলীয় কার্যালয়ে অগ্নিসংযোগ করেছে দুর্বৃত্তরা। এতে কার্যালয়টির পাশাপাশি পাশের একটি লাকড়ির দোকানও পুড়ে ছাই হয়ে গেছে। বুধবার (১৮ নভেম্বর) ভোর ৪টার দিকে উপজেলার চিরাম ইউনিয়নের বামনগাঁও বাজারে এ ঘটনা ঘটে।
পুলিশ ও স্থানীয় সূত্রে জানা গেছে, ভোরে একদল দুর্বৃত&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/mymensing/981762/%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%AA%E0%A7%81%E0%A7%9C%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A6%87-%E0%A6%AA%E0%A6%BE%E0%A6%B6%E0%A7%87%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>নকল চাবি দিয়ে পুলিশের গাড়ি চুরি, যা দেখা গেলো সিসি ক্যামেরায়</title>

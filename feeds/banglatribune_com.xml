    <item>
      <title>গ্রামীণ ব্যাংকের শাখায় আগুন ধরিয়ে লুটপাট, বিএনপির কয়েকজনের বাড়িতে ভাঙচুর</title>
      <link>https://www.banglatribune.com/country/dhaka/981164/%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%A3-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A6%BE%E0%A6%96%E0%A6%BE%E0%A7%9F-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%A7%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B2%E0%A7%81%E0%A6%9F%E0%A6%AA%E0%A6%BE%E0%A6%9F-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/dhaka/981164/%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%A3-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A6%BE%E0%A6%96%E0%A6%BE%E0%A7%9F-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%A7%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B2%E0%A7%81%E0%A6%9F%E0%A6%AA%E0%A6%BE%E0%A6%9F-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0</guid>
      <pubDate>Mon, 16 Nov 2026 00:08:28 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/78188d4c318e6a36922bd46a9bf750b2-6af9f4eee0611.jpg?jadewits_media_id=1055193" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/78188d4c318e6a36922bd46a9bf750b2-6af9f4eee0611.jpg?jadewits_media_id=1055193" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/78188d4c318e6a36922bd46a9bf750b2-6af9f4eee0611.jpg?jadewits_media_id=1055193" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গ্রামীণ ব্যাংকের শাখায় আগুন ধরিয়ে লুটপাট, বিএনপির কয়েকজনের বাড়িতে ভাঙচুর" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জ সদর ও টুঙ্গিপাড়ায় কার্যক্রম নিষিদ্ধ আওয়ামী লীগ ও সহযোগী সংগঠনের বিক্ষোভ থেকে বিএনপি নেতাদের বাড়ি, অফিস ও ব্যবসাপ্রতিষ্ঠানে হামলা, ভাঙচুর এবং অগ্নিসংযোগ করা হয়েছে। একইসঙ্গে টুঙ্গিপাড়ায় গ্রামীণ ব্যাংকে ভাঙচুর চালিয়ে আগুন ধরিয়ে দিয়েছে নিষিদ্ধ ছাত্রলীগের নেতাকর্মীরা। রবিবার (১৫ নভেম্বর) রাত সা&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/dhaka/981164/%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%A3-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A6%BE%E0%A6%96%E0%A6%BE%E0%A7%9F-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%A7%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B2%E0%A7%81%E0%A6%9F%E0%A6%AA%E0%A6%BE%E0%A6%9F-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0">বাংলা ট্রিবিউন</source>

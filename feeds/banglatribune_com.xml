      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/e59d61274b18021475c8bbcd7efa5fcb-6b088e0b4c89f.jpg?jadewits_media_id=1057161" medium="image" />

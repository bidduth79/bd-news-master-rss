      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/10/12/c433f2fee3372f01efae2cadc60778a8-6accf19051ba2.JPG?jadewits_media_id=1049041" style="max-width:100%;height:auto;margin-bottom:10px;" alt="একনজরে আজকের আলোচিত খবর" /&gt;&lt;/p&gt;&lt;p&gt;নীতিনির্ধারণী সিদ্ধান্ত থেকে শুরু করে আন্তর্জাতিক ভূ-রাজনীতি, ক্রীড়াঙ্গন কিংবা বিনোদন&amp;mdash; প্রতিদিনই বদলে যাচ্ছে ঘটনার প্রেক্ষাপট। বৃহস্পতিবার&amp;nbsp; (২৬ নভেম্বর) বাংলা ট্রিবিউনে প্রকাশিত খবরগুলোর মধ্যে পাঠক মহলে আলোড়ন সৃষ্টি করেছে বেশ কিছু প্রতিবেদন।
অনিশ্চয়তায় গঙ্গা চুক্তি নবায়ন১২ ডিসেম্বর মেয়াদ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/others/983440/%E0%A6%8F%E0%A6%95%E0%A6%A8%E0%A6%9C%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%9C%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%B2%E0%A7%8B%E0%A6%9A%E0%A6%BF%E0%A6%A4-%E0%A6%96%E0%A6%AC%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>চীনসহ ১৪ অর্থনীতির ওপর মার্কিন শুল্ক আরোপের প্রস্তাবের বিরোধিতা বেইজিংয়ের</title>
      <link>https://www.banglatribune.com/foreign/asia/983439/%E0%A6%9A%E0%A7%80%E0%A6%A8%E0%A6%B8%E0%A6%B9-%E0%A7%A7%E0%A7%AA-%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8-%E0%A6%B6%E0%A7%81%E0%A6%B2%E0%A7%8D%E0%A6%95-%E0%A6%86%E0%A6%B0%E0%A7%8B%E0%A6%AA%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/asia/983439/%E0%A6%9A%E0%A7%80%E0%A6%A8%E0%A6%B8%E0%A6%B9-%E0%A7%A7%E0%A7%AA-%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8-%E0%A6%B6%E0%A7%81%E0%A6%B2%E0%A7%8D%E0%A6%95-%E0%A6%86%E0%A6%B0%E0%A7%8B%E0%A6%AA%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Thu, 26 Nov 2026 20:13:33 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/07/19/8413bff1942d473982b5088da3f5fd6e-6a5d09b8290cb.jpg?jadewits_media_id=1034325" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/07/19/8413bff1942d473982b5088da3f5fd6e-6a5d09b8290cb.jpg?jadewits_media_id=1034325" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/07/19/8413bff1942d473982b5088da3f5fd6e-6a5d09b8290cb.jpg?jadewits_media_id=1034325" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চীনসহ ১৪ অর্থনীতির ওপর মার্কিন শুল্ক আরোপের প্রস্তাবের বিরোধিতা বেইজিংয়ের" /&gt;&lt;/p&gt;&lt;p&gt;চীনসহ ১৪টি অর্থনীতির ওপর যুক্তরাষ্ট্রের ৩০১ ধারার আওতায় অতিরিক্ত শুল্ক আরোপের প্রস্তাবের তীব্র বিরোধিতা জানিয়েছে চীন। বৃহস্পতিবার চীনের বাণিজ্য মন্ত্রণালয়ের নিয়মিত সংবাদ সম্মেলনে মুখপাত্র হ্য ইয়া তুং এ বিরোধিতা করেন।

মালয়েশিয়ায় ভিসার শর্ত লঙ্ঘনকারী বিদেশিদের তালিকায় শীর্ষে বাংলাদেশিরা

সম্প্রতি মার&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/asia/983439/%E0%A6%9A%E0%A7%80%E0%A6%A8%E0%A6%B8%E0%A6%B9-%E0%A7%A7%E0%A7%AA-%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8-%E0%A6%B6%E0%A7%81%E0%A6%B2%E0%A7%8D%E0%A6%95-%E0%A6%86%E0%A6%B0%E0%A7%8B%E0%A6%AA%E0%A7%87%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>শহীদের সঙ্গে অন্তরঙ্গ দৃশ্য, শুটিংয়ে স্বস্তি পেয়েছিলেন আদিতি</title>
      <link>https://www.banglatribune.com/entertainment/bollywood/983438/%E0%A6%B6%E0%A6%B9%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%85%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%99%E0%A7%8D%E0%A6%97-%E0%A6%A6%E0%A7%83%E0%A6%B6%E0%A7%8D%E0%A6%AF-%E0%A6%B6%E0%A7%81%E0%A6%9F%E0%A6%BF%E0%A6%82%E0%A7%9F%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.banglatribune.com/entertainment/bollywood/983438/%E0%A6%B6%E0%A6%B9%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%85%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%99%E0%A7%8D%E0%A6%97-%E0%A6%A6%E0%A7%83%E0%A6%B6%E0%A7%8D%E0%A6%AF-%E0%A6%B6%E0%A7%81%E0%A6%9F%E0%A6%BF%E0%A6%82%E0%A7%9F%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BF</guid>
      <pubDate>Thu, 26 Nov 2026 20:12:39 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/0d180ee61cc068f8bee1781b80e480f1-6b083dd45b909.jpeg?jadewits_media_id=1057102" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/0d180ee61cc068f8bee1781b80e480f1-6b083dd45b909.jpeg?jadewits_media_id=1057102" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/0d180ee61cc068f8bee1781b80e480f1-6b083dd45b909.jpeg?jadewits_media_id=1057102" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শহীদের সঙ্গে অন্তরঙ্গ দৃশ্য, শুটিংয়ে স্বস্তি পেয়েছিলেন আদিতি" /&gt;&lt;/p&gt;&lt;p&gt;গত মাসে নেটফ্লিক্সে মুক্তি পেয়েছে &amp;lsquo;গজব রাত&amp;rsquo;। মনোজ বাজপেয়ি, দিব্যা দত্ত, অক্ষয় ওবেরয়, সাকিব সেলিম ও শ্রদ্ধা দাসের মতো তারকাদের নিয়ে সাজানো সিনেমাটিতে অভিনয় করে নজর কেড়েছেন আদিতি সন্ধ্যা শর্মা। এতে আরিয়া সাহনি চরিত্রে অভিনয় করেছেন তিনি। তার আগে তিনি শহীদ কাপুরের সঙ্গে &amp;lsquo;দেবা&amp;rsquo; সি&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/entertainment/bollywood/983438/%E0%A6%B6%E0%A6%B9%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%85%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%99%E0%A7%8D%E0%A6%97-%E0%A6%A6%E0%A7%83%E0%A6%B6%E0%A7%8D%E0%A6%AF-%E0%A6%B6%E0%A7%81%E0%A6%9F%E0%A6%BF%E0%A6%82%E0%A7%9F%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BF">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>মহাসড়কে প্রকাশ্যে নিষিদ্ধ ছাত্রলীগের মিছিল, পুলিশ বলছে ‘কোথায় করেছে, জানা নেই’</title>
      <link>https://www.banglatribune.com/country/dhaka/983437/%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A7%9C%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B6%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/dhaka/983437/%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A7%9C%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B6%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6</guid>
      <pubDate>Thu, 26 Nov 2026 20:10:21 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/321abf7a134a825c6d6b6f7cb9883918-6b083d6fd954e.jpg?jadewits_media_id=1057101" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/321abf7a134a825c6d6b6f7cb9883918-6b083d6fd954e.jpg?jadewits_media_id=1057101" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/321abf7a134a825c6d6b6f7cb9883918-6b083d6fd954e.jpg?jadewits_media_id=1057101" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মহাসড়কে প্রকাশ্যে নিষিদ্ধ ছাত্রলীগের মিছিল, পুলিশ বলছে ‘কোথায় করেছে, জানা নেই’" /&gt;&lt;/p&gt;&lt;p&gt;শেখ হাসিনার দেশে ফেরার ঘোষণাকে স্বাগত জানিয়ে গাজীপুরে প্রকাশ্যে বিক্ষোভ মিছিল করেছে নিষিদ্ধ সংগঠন ছাত্রলীগের জেলা শাখার নেতাকর্মীরা। বৃহস্পতিবার (২৬ নভেম্বর) সকালে ঢাকা-ময়মনসিংহ মহাসড়কে এ মিছিল করা হয়। তবে মহাসড়কের ঠিক কোন স্থানে মিছিলটি হয়েছে, তা নিশ্চিত হওয়া যায়নি। মিছিলের বিষয়টি ফেসবুকে পোস্ট দিয়&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/dhaka/983437/%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A7%9C%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B6%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6">বাংলা ট্রিবিউন</source>

      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/02/12/436a1c525ceeba5ef96042fb75dc156f-698de22520bf9.jpg?jadewits_media_id=1011442" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/02/12/436a1c525ceeba5ef96042fb75dc156f-698de22520bf9.jpg?jadewits_media_id=1011442" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/02/12/436a1c525ceeba5ef96042fb75dc156f-698de22520bf9.jpg?jadewits_media_id=1011442" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভারতে জার্মানি-আর্জেন্টিনার ম্যাচে আম্পায়ার বাংলাদেশের শাহবাজ" /&gt;&lt;/p&gt;&lt;p&gt;আন্তর্জাতিক হকিতে দলীয় সাফল্যে খুব বেশি এগোতে পারেনি বাংলাদেশ। তবে আম্পায়ারিংয়ে নিজেদের দক্ষতার স্বাক্ষর রেখে চলেছেন দেশের প্রতিনিধিরা। এবার হকির মর্যাদাপূর্ণ এফআইএইচ প্রো লিগে আম্পায়ারিংয়ের সুযোগ পেয়েছেন বাংলাদেশের শাহবাজ আলী। আগামী ফেব্রুয়ারিতে ভারতের রাজগিরে অনুষ্ঠেয় এই প্রতিযোগিতার একটি পর্বে দা&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/hockey/983206/%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%86%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%87-%E0%A6%86%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%B0">বাংলা ট্রিবিউন</source>

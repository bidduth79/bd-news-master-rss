    <item>
      <title>সাদুল্লাপুরে বিএনপির কার্যালয়ের সামনে দুই ককটেল বিস্ফোরণ</title>
      <link>https://www.banglatribune.com/country/rangpur/981404/%E0%A6%B8%E0%A6%BE%E0%A6%A6%E0%A7%81%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/rangpur/981404/%E0%A6%B8%E0%A6%BE%E0%A6%A6%E0%A7%81%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2</guid>
      <pubDate>Tue, 17 Nov 2026 01:06:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/cc600f7bdfb86ecd1c990e4c8e0c1ea7-6afb50ecdb447.jpg?jadewits_media_id=1055385" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/cc600f7bdfb86ecd1c990e4c8e0c1ea7-6afb50ecdb447.jpg?jadewits_media_id=1055385" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/cc600f7bdfb86ecd1c990e4c8e0c1ea7-6afb50ecdb447.jpg?jadewits_media_id=1055385" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাদুল্লাপুরে বিএনপির কার্যালয়ের সামনে দুই ককটেল বিস্ফোরণ" /&gt;&lt;/p&gt;&lt;p&gt;গাইবান্ধার সাদুল্লাপুর উপজেলার ৬নং ধাপেরহাট ইউনিয়ন বিএনপির দলীয় কার্যালয়ের সামনে পরপর দুটি ককটেল বিস্ফোরণের ঘটনা ঘটেছে।
সোমবার (১৬ নভেম্বর) সন্ধ্যা ৭টার দিকে ধাপেরহাট বন্দরে রংপুর-ঢাকা মহাসড়কসংলগ্ন দলীয় কার্যালয়ের সামনে এ ঘটনা ঘটে। বিকট শব্দে বিস্ফোরণের পর স্থানীয় ব্যবসায়ী, পথচারী ও আশপাশের মানুষের &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/rangpur/981404/%E0%A6%B8%E0%A6%BE%E0%A6%A6%E0%A7%81%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>সীমান্তে অজ্ঞাতদের দেখে বিজিবির গুলি বর্ষণ, গ্রেফতার ৮</title>
      <link>https://www.banglatribune.com/country/khulna/981402/%E0%A6%B8%E0%A7%80%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%87-%E0%A6%85%E0%A6%9C%E0%A7%8D%E0%A6%9E%E0%A6%BE%E0%A6%A4%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF-%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A6%A3</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/khulna/981402/%E0%A6%B8%E0%A7%80%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%87-%E0%A6%85%E0%A6%9C%E0%A7%8D%E0%A6%9E%E0%A6%BE%E0%A6%A4%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF-%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A6%A3</guid>
      <pubDate>Tue, 17 Nov 2026 00:35:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/2cd694f0df349f910c6c353af1f875a2-6afb497c3597d.jpg?jadewits_media_id=1055383" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/2cd694f0df349f910c6c353af1f875a2-6afb497c3597d.jpg?jadewits_media_id=1055383" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/2cd694f0df349f910c6c353af1f875a2-6afb497c3597d.jpg?jadewits_media_id=1055383" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সীমান্তে অজ্ঞাতদের দেখে বিজিবির গুলি বর্ষণ, গ্রেফতার ৮" /&gt;&lt;/p&gt;&lt;p&gt;অবৈধ অনুপ্রবেশ ও মানবপাচার প্রতিরোধে সাতক্ষীরা সীমান্তে নিরাপত্তা ও নজরদারি জোরদার করেছে সাতক্ষীরা ব্যাটালিয়ন (৩৩ বিজিবি)। সীমান্তের ৫৪ কিলোমিটার এলাকায় অতিরিক্ত জনবল মোতায়েন, টহল বৃদ্ধি এবং গোয়েন্দা নজরদারি বাড়ানো হয়েছে।
সোমবার (১৬ নভেম্বর) ৩৩ বিজিবির এক সংবাদ বিজ্ঞপ্তিতে এ তথ্য জানানো হয়।
বিজ্ঞপ্ত&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/khulna/981402/%E0%A6%B8%E0%A7%80%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%87-%E0%A6%85%E0%A6%9C%E0%A7%8D%E0%A6%9E%E0%A6%BE%E0%A6%A4%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF-%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A6%A3">বাংলা ট্রিবিউন</source>

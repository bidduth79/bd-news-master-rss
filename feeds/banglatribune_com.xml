      <guid isPermaLink="true">https://www.banglatribune.com/others/980393/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A6%E0%A6%97%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A7%A7%E0%A7%AE%E0%A7%AF-%E0%A6%AB%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%9F-%E0%A6%AC%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%B2-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A4%E0%A6%BF%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%A4</guid>
      <pubDate>Thu, 12 Nov 2026 01:49:30 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/10/13/26de4fe7b3c3a3c2178a73113a561244-6ace050b36b88.jpg?jadewits_media_id=1049153" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/10/13/26de4fe7b3c3a3c2178a73113a561244-6ace050b36b88.jpg?jadewits_media_id=1049153" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/10/13/26de4fe7b3c3a3c2178a73113a561244-6ace050b36b88.jpg?jadewits_media_id=1049153" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঢাকা থেকে রিয়াদগামী ১৮৯ ফ্লাইট বাতিল, ক্ষতিগ্রস্ত যাত্রী ২৩২৭৪" /&gt;&lt;/p&gt;&lt;p&gt;সৌদি আরবে নিরাপত্তা পরিস্থিতি কারণে ঢাকা থেকে রিয়াদগামী ১৮৯ ফ্লাইট বাতিল হয়েছে। গত ১০ অক্টোবর থেকে এই ফ্লাইট বাতিল হওয়া শুরু করে। বুধবার (১০ নভেম্বর) পর্যন্ত ফ্লাইট বাতিলের এই সংখ্যা দাঁড়ায়। এ সময় ক্ষতিগ্রস্ত যাত্রীর সংখ্যা ২৩ হাজার ২৭৪ জন।
&amp;nbsp;
বুধবার (১২ নভেম্বর) বেবিচকের জনসংযোগ বিভাগের সহকারী &lt;/p&gt;</description>

    <item>
      <title>নিষিদ্ধ আওয়ামী লীগ নেতা গ্রেফতার, সেই রিসোর্টের মালিক আত্মগোপনে</title>
      <link>https://www.banglatribune.com/country/sylhet/980149/%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%87%E0%A6%87-%E0%A6%B0%E0%A6%BF%E0%A6%B8%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/sylhet/980149/%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%87%E0%A6%87-%E0%A6%B0%E0%A6%BF%E0%A6%B8%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Wed, 11 Nov 2026 02:06:32 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/aa633594033a73b1eecfbc3fa448798b-6af378093c329.jpg?jadewits_media_id=1054327" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/aa633594033a73b1eecfbc3fa448798b-6af378093c329.jpg?jadewits_media_id=1054327" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/aa633594033a73b1eecfbc3fa448798b-6af378093c329.jpg?jadewits_media_id=1054327" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নিষিদ্ধ আওয়ামী লীগ নেতা গ্রেফতার, সেই রিসোর্টের মালিক আত্মগোপনে" /&gt;&lt;/p&gt;&lt;p&gt;শিক্ষা সফরের কথা বলে রিসোর্ট ভাড়া নিয়ে সিলেটের গোয়াইনঘাট উপজেলার রাতারগুলে মতবিনিময় সভা করেছেন কার্যক্রম নিষিদ্ধ আওয়ামী লীগের সিলেট জেলা কমিটির সাংগঠনিক সম্পাদক ও সুনামগঞ্জ-১ আসনের সাবেক সংসদ সদস্য রনজিত সরকার। গত রবিবার সন্ধ্যার পর বিখ্যাত রাতারগুল সোয়াম ফরেস্ট সংলগ্ন &amp;lsquo;সোহেল স্কয়ার ইকো রিসোর্&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/sylhet/980149/%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%87%E0%A6%87-%E0%A6%B0%E0%A6%BF%E0%A6%B8%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ঠিকাদার খুশি হয়ে ইঞ্জিনিয়ারকে উপহার হিসেবে দিলে তা ঘুষ হবে না: স্থানীয় সরকার প্রতিমন্ত্রী</title>
      <link>https://www.banglatribune.com/national/980148/%E0%A6%A0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%A6%E0%A6%BE%E0%A6%B0-%E0%A6%96%E0%A7%81%E0%A6%B6%E0%A6%BF-%E0%A6%B9%E0%A7%9F%E0%A7%87-%E0%A6%87%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A7%87-%E0%A6%89%E0%A6%AA%E0%A6%B9%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A7%87-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%87-%E0%A6%A4%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/national/980148/%E0%A6%A0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%A6%E0%A6%BE%E0%A6%B0-%E0%A6%96%E0%A7%81%E0%A6%B6%E0%A6%BF-%E0%A6%B9%E0%A7%9F%E0%A7%87-%E0%A6%87%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A7%87-%E0%A6%89%E0%A6%AA%E0%A6%B9%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A7%87-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%87-%E0%A6%A4%E0%A6%BE</guid>
      <pubDate>Wed, 11 Nov 2026 01:34:08 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/c53bf79eab22376e276ba25aa2574f15-6af3703c16c9c.jpg?jadewits_media_id=1054326" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/c53bf79eab22376e276ba25aa2574f15-6af3703c16c9c.jpg?jadewits_media_id=1054326" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/c53bf79eab22376e276ba25aa2574f15-6af3703c16c9c.jpg?jadewits_media_id=1054326" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঠিকাদার খুশি হয়ে ইঞ্জিনিয়ারকে উপহার হিসেবে দিলে তা ঘুষ হবে না: স্থানীয় সরকার প্রতিমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;স্থানীয় সরকার প্রতিমন্ত্রী মীর শাহে আলম বলেছেন, ঠিকাদার তার লভ্যাংশ থেকে যদি খুুশি হয়ে একটা উপহার ইঞ্জিনিয়ারকে দেয়, এটা তো ঘুষের মধ্যে পড়বে না। এটা আপনি নিতেই পারেন। মঙ্গলবার (১১ নভেম্বর) রাজধানীর এলজিইডি মিলনায়তনে এলজিইডিতে নবনিযুক্ত প্রকৌশলীদের প্রশিক্ষণ কর্মশালার উদ্বোধন অনুষ্ঠানে প্রধান অতিথির ব&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/980148/%E0%A6%A0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%A6%E0%A6%BE%E0%A6%B0-%E0%A6%96%E0%A7%81%E0%A6%B6%E0%A6%BF-%E0%A6%B9%E0%A7%9F%E0%A7%87-%E0%A6%87%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A7%87-%E0%A6%89%E0%A6%AA%E0%A6%B9%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A7%87-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%87-%E0%A6%A4%E0%A6%BE">বাংলা ট্রিবিউন</source>

      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/831c77dd8f83f6600938e51b7ed48388-6b07b225e621f.jpg?jadewits_media_id=1056994" medium="image" />

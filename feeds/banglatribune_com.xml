      <guid isPermaLink="true">https://www.banglatribune.com/politics/bnp/982423/%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95-%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%B9%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A6%95-%E0%A6%95%E0%A6%AE%E0%A6%BF%E0%A6%9F%E0%A6%BF-%E0%A6%97%E0%A6%A0%E0%A6%A8-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A6%BE</guid>
      <pubDate>Sat, 21 Nov 2026 22:17:50 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/1c7ab396a49efa129cfeaf20a0d5f562-6b01c02f83776.jpg?jadewits_media_id=1056253" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/1c7ab396a49efa129cfeaf20a0d5f562-6b01c02f83776.jpg?jadewits_media_id=1056253" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/1c7ab396a49efa129cfeaf20a0d5f562-6b01c02f83776.jpg?jadewits_media_id=1056253" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শ্রমিক দলের আহ্বায়ক কমিটি গঠন, নেতৃত্বে যারা" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ জাতীয়তাবাদী শ্রমিক দলের কেন্দ্রীয় নির্বাহী কমিটি বিলুপ্ত করে ৫১ সদস্যবিশিষ্ট নতুন আহ্বায়ক কমিটি গঠন করা হয়েছে। কমিটিতে আমান উল্লাহ আমান এমপিকে আহ্বায়ক এবং অ্যাডভোকেট শামছুর রহমান শিমুল বিশ্বাস এমপিকে সদস্য সচিব করা হয়েছে। 
আগামী ছয় মাসের মধ্যে সংগঠনের সপ্তম কেন্দ্রীয় কাউন্সিল ও সম্মেলন সম্প&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/politics/bnp/982423/%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95-%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%B9%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A6%95-%E0%A6%95%E0%A6%AE%E0%A6%BF%E0%A6%9F%E0%A6%BF-%E0%A6%97%E0%A6%A0%E0%A6%A8-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A6%BE">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>শাহজালালে সাড়ে ৭ কেজি স্বর্ণের পেস্টসহ আটক ৩</title>
      <link>https://www.banglatribune.com/law-and-crime/982422/%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A6%9C%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A7%9C%E0%A7%87-%E0%A7%AD-%E0%A6%95%E0%A7%87%E0%A6%9C%E0%A6%BF-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%87%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%B8%E0%A6%B9-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A7%A9</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/982422/%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A6%9C%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A7%9C%E0%A7%87-%E0%A7%AD-%E0%A6%95%E0%A7%87%E0%A6%9C%E0%A6%BF-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%87%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%B8%E0%A6%B9-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A7%A9</guid>
      <pubDate>Sat, 21 Nov 2026 22:00:53 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/bb42c2929ce138dcc7d13922a0749f1f-6b01bff0bf8a5.jpg?jadewits_media_id=1056252" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/bb42c2929ce138dcc7d13922a0749f1f-6b01bff0bf8a5.jpg?jadewits_media_id=1056252" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/bb42c2929ce138dcc7d13922a0749f1f-6b01bff0bf8a5.jpg?jadewits_media_id=1056252" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শাহজালালে সাড়ে ৭ কেজি স্বর্ণের পেস্টসহ আটক ৩" /&gt;&lt;/p&gt;&lt;p&gt;হযরত শাহজালাল আন্তর্জাতিক বিমানবন্দরে প্রায় ৭ কেজি ৫০০ গ্রাম (৬৪৩ ভরি) ওজনের ১৫টি ডিম্বাকৃতির স্বর্ণের পেস্টসহ তিনজনকে আটক করেছে এয়ারপোর্ট আর্মড পুলিশ ব্যাটালিয়ন (এপিবিএন)। উদ্ধার করা স্বর্ণের আনুমানিক বাজারমূল্য ১১ কোটি ৬৭ লাখ টাকা।
শনিবার (২১ নভেম্বর) সকাল সাড়ে ১০টার দিকে বিমানবন্দরের আগমনী ২ নম্ব&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/982422/%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A6%9C%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A7%9C%E0%A7%87-%E0%A7%AD-%E0%A6%95%E0%A7%87%E0%A6%9C%E0%A6%BF-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%87%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%B8%E0%A6%B9-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A7%A9">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>সুনামগঞ্জে সংঘর্ষ, আহত ১৭</title>
      <link>https://www.banglatribune.com/country/sylhet/982421/%E0%A6%B8%E0%A7%81%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%B0%E0%A7%8D%E0%A6%B7-%E0%A6%86%E0%A6%B9%E0%A6%A4-%E0%A7%A7%E0%A7%AD</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/sylhet/982421/%E0%A6%B8%E0%A7%81%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%B0%E0%A7%8D%E0%A6%B7-%E0%A6%86%E0%A6%B9%E0%A6%A4-%E0%A7%A7%E0%A7%AD</guid>
      <pubDate>Sat, 21 Nov 2026 21:53:04 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/af98a8abc88ad80726273b7b61ac6f6b-6b01be59a5715.jpg?jadewits_media_id=1056251" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/af98a8abc88ad80726273b7b61ac6f6b-6b01be59a5715.jpg?jadewits_media_id=1056251" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/af98a8abc88ad80726273b7b61ac6f6b-6b01be59a5715.jpg?jadewits_media_id=1056251" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সুনামগঞ্জে সংঘর্ষ, আহত ১৭" /&gt;&lt;/p&gt;&lt;p&gt;সুনামগঞ্জের দিরাইয়ে জলাশয় দখলকে কেন্দ্র করে দুই গ্রামের বাসিন্দাদের মধ্যে সংঘর্ষের ঘটনা ঘটেছে। এতে অন্তত ১৭ জন আহত হয়েছেন। আহতদের মধ্যে দুজনের অবস্থা গুরুতর হওয়ায় তাদের সিলেট এমএজি ওসমানী মেডিক্যাল কলেজ হাসপাতালে পাঠানো হয়েছে।
শনিবার (২১ নভেম্বর) সকালে দিরাই পৌরসভার ঘাগটিয়া ও সরমঙ্গল ইউনিয়নের চিতলিয়&lt;/p&gt;</description>

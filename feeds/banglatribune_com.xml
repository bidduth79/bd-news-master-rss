      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/185611ec988e90d6366fa24182413942-6afd98e8ee989.jpg?jadewits_media_id=1055695" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/185611ec988e90d6366fa24182413942-6afd98e8ee989.jpg?jadewits_media_id=1055695" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রামিসা ধর্ষণ-হত্যায় সোহেলের মৃত্যুদণ্ড বহাল, স্ত্রী খালাস পাওয়ায় চাচা বললেন ‘মানি না’" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর মিরপুরের পল্লবীতে আট বছরের শিশুকে ধর্ষণের পর নৃশংসভাবে হত্যার মামলায় আসামি সোহেল রানার মৃত্যুদণ্ড বহাল রেখেছেন হাইকোর্ট। তবে মামলার অপর আসামি সোহেলের স্ত্রী স্বপ্না খাতুনকে খালাস দিয়েছেন আদালত। হাইকোর্টের এ রায়ে ক্ষুব্ধ ও হতাশ হয়েছেন নিহতের স্বজন ও এলাকাবাসী। তাদের দাবি, হত্যাকাণ্ডে স্বপ্না&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/dhaka/981756/%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%BF%E0%A6%B8%E0%A6%BE-%E0%A6%A7%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A6%A3-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A7%9F-%E0%A6%B8%E0%A7%8B%E0%A6%B9%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A6%A3%E0%A7%8D%E0%A6%A1-%E0%A6%AC%E0%A6%B9%E0%A6%BE%E0%A6%B2">বাংলা ট্রিবিউন</source>

      <title>আবারও ৭ গোলের স্মৃতি ফেরালো ব্রাজিল!</title>
      <link>https://www.banglatribune.com/sport/football/981536/%E0%A6%86%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A6%93-%E0%A7%AD-%E0%A6%97%E0%A7%8B%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A6%BF-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B2%E0%A7%8B-%E0%A6%AC%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%BF%E0%A6%B2</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/football/981536/%E0%A6%86%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A6%93-%E0%A7%AD-%E0%A6%97%E0%A7%8B%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A6%BF-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B2%E0%A7%8B-%E0%A6%AC%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%BF%E0%A6%B2</guid>
      <pubDate>Tue, 17 Nov 2026 18:21:50 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/8cd134ba54db6ac0d75af3a14fbe4d74-6afc41de86c4a.jpg?jadewits_media_id=1055509" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/8cd134ba54db6ac0d75af3a14fbe4d74-6afc41de86c4a.jpg?jadewits_media_id=1055509" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/8cd134ba54db6ac0d75af3a14fbe4d74-6afc41de86c4a.jpg?jadewits_media_id=1055509" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আবারও ৭ গোলের স্মৃতি ফেরালো ব্রাজিল!" /&gt;&lt;/p&gt;&lt;p&gt;২০১৪ বিশ্বকাপে জার্মানির কাছে ৭-১ গোলে বিধ্বস্ত হওয়ার স্মৃতি আজও কাঁদায় ব্রাজিলকে। আবারও ৭ গোলের স্মৃতি ফিরিয়েছে তারা। তবে এবার নিজেরা ৭ গোলের স্বাদ নিয়েছে। প্রীতি ম্যাচে সিঙ্গাপুরকে বিধ্বস্ত করেছে ৭-০ গোলে।&amp;nbsp;
ভিনিসিয়ুস জুনিয়রের হ্যাটট্রিকের সঙ্গে গোল উৎসব করেছে ব্রাজিল। সিঙ্গাপুরের ন্যাশনাল স্ট&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/football/981536/%E0%A6%86%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A6%93-%E0%A7%AD-%E0%A6%97%E0%A7%8B%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A6%BF-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B2%E0%A7%8B-%E0%A6%AC%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%BF%E0%A6%B2">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>তৈরি পোশাকশিল্প বড় ধরনের ঝুঁকির মুখে পড়েছে, সংসদে আলোচনার প্রস্তাব</title>
      <link>https://www.banglatribune.com/national/981535/%E0%A6%A4%E0%A7%88%E0%A6%B0%E0%A6%BF-%E0%A6%AA%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%95%E0%A6%B6%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%AA-%E0%A6%AC%E0%A7%9C-%E0%A6%A7%E0%A6%B0%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%9D%E0%A7%81%E0%A6%81%E0%A6%95%E0%A6%BF%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%87-%E0%A6%AA%E0%A7%9C%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/national/981535/%E0%A6%A4%E0%A7%88%E0%A6%B0%E0%A6%BF-%E0%A6%AA%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%95%E0%A6%B6%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%AA-%E0%A6%AC%E0%A7%9C-%E0%A6%A7%E0%A6%B0%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%9D%E0%A7%81%E0%A6%81%E0%A6%95%E0%A6%BF%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%87-%E0%A6%AA%E0%A7%9C%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6%E0%A7%87</guid>
      <pubDate>Tue, 17 Nov 2026 17:58:46 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/96ba88bc6863755d2340fb7b0be6e5ef-6afc4146869a1.png?jadewits_media_id=1055508" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/96ba88bc6863755d2340fb7b0be6e5ef-6afc4146869a1.png?jadewits_media_id=1055508" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/96ba88bc6863755d2340fb7b0be6e5ef-6afc4146869a1.png?jadewits_media_id=1055508" style="max-width:100%;height:auto;margin-bottom:10px;" alt="তৈরি পোশাকশিল্প বড় ধরনের ঝুঁকির মুখে পড়েছে, সংসদে আলোচনার প্রস্তাব" /&gt;&lt;/p&gt;&lt;p&gt;জ্বালানি সংকট, শ্রমিক অসন্তোষ ও কাঠামোগত সমস্যার কারণে দেশের তৈরি পোশাকশিল্প খাত বড় ধরনের ঝুঁকির মুখে পড়েছে। ২০২৬ সালের এপ্রিল মাসে জ্বালানি সংকটের কারণে এ খাতের উৎপাদন সক্ষমতা ২৫ থেকে ৩০ শতাংশ পর্যন্ত কমেছে।
এতে আন্তর্জাতিক ক্রয়াদেশ কমে যাওয়া বা বাতিল হওয়া, উৎপাদন ব্যাহত হওয়া এবং নির্ধারিত সময়ে পণ্&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/981535/%E0%A6%A4%E0%A7%88%E0%A6%B0%E0%A6%BF-%E0%A6%AA%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%95%E0%A6%B6%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%AA-%E0%A6%AC%E0%A7%9C-%E0%A6%A7%E0%A6%B0%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%9D%E0%A7%81%E0%A6%81%E0%A6%95%E0%A6%BF%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%87-%E0%A6%AA%E0%A7%9C%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>রামপুরায় কার্যক্রম নিষিদ্ধ আ. লীগ ও অঙ্গসংগঠনের ৬ নেতাকর্মী গ্রেফতার</title>
      <link>https://www.banglatribune.com/law-and-crime/981533/%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%86.-%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%93-%E0%A6%85%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%B8%E0%A6%82%E0%A6%97%E0%A6%A0%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A7%AC</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/981533/%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%86.-%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%93-%E0%A6%85%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%B8%E0%A6%82%E0%A6%97%E0%A6%A0%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A7%AC</guid>
      <pubDate>Tue, 17 Nov 2026 17:52:31 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/791a9412c64837f1f758df79fc46808e-6afc3fac2641c.jpg?jadewits_media_id=1055506" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/791a9412c64837f1f758df79fc46808e-6afc3fac2641c.jpg?jadewits_media_id=1055506" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/791a9412c64837f1f758df79fc46808e-6afc3fac2641c.jpg?jadewits_media_id=1055506" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রামপুরায় কার্যক্রম নিষিদ্ধ আ. লীগ ও অঙ্গসংগঠনের ৬ নেতাকর্মী গ্রেফতার" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর রামপুরা থানা এলাকায় অভিযান চালিয়ে কার্যক্রম নিষিদ্ধ আওয়ামী লীগ ও এর অঙ্গ-সংগঠনের ছয় নেতাকর্মীকে গ্রেফতার করেছে রামপুরা থানা-পুলিশ।
গ্রেফতার ব্যক্তিরা হলো, রামগঞ্জ পৌর আওয়ামী লীগের সাধারণ সম্পাদক ও সাবেক রামগঞ্জ পৌর মেয়র বেলাল আহমেদ (৬০), ২৩ নম্বর ওয়ার্ড শ্রমিক লীগের যুগ্ম সাধারণ সম্পাদক মো&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/981533/%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%86.-%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%93-%E0%A6%85%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%B8%E0%A6%82%E0%A6%97%E0%A6%A0%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A7%AC">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>দুই মহাসড়কে শ্রমিক-পুলিশ পাল্টাপাল্টি ধাওয়া, টিয়ারশেল-সাউন্ড গ্রেনেড নিক্ষেপ</title>
      <link>https://www.banglatribune.com/country/dhaka/981532/%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A7%9C%E0%A6%95%E0%A7%87-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A7%8D%E0%A6%9F%E0%A6%BF-%E0%A6%A7%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/dhaka/981532/%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A7%9C%E0%A6%95%E0%A7%87-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A7%8D%E0%A6%9F%E0%A6%BF-%E0%A6%A7%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE</guid>
      <pubDate>Tue, 17 Nov 2026 17:49:47 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/7e630ea703f24a75029be7ba12c5128d-6afc3f50ba0dd.jpg?jadewits_media_id=1055505" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/7e630ea703f24a75029be7ba12c5128d-6afc3f50ba0dd.jpg?jadewits_media_id=1055505" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/7e630ea703f24a75029be7ba12c5128d-6afc3f50ba0dd.jpg?jadewits_media_id=1055505" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দুই মহাসড়কে শ্রমিক-পুলিশ পাল্টাপাল্টি ধাওয়া, টিয়ারশেল-সাউন্ড গ্রেনেড নিক্ষেপ" /&gt;&lt;/p&gt;&lt;p&gt;ন্যূনতম মজুরি ৩০ হাজার টাকা করার দাবিতে গাজীপুরে শ্রমিকদের বিক্ষোভকে কেন্দ্র করে শ্রমিক ও পুলিশের মধ্যে পাল্টাপাল্টি ধাওয়ার ঘটনা ঘটেছে। মঙ্গলবার (১৭ নভেম্বর) সকাল থেকে নগরের বিভিন্ন এলাকায় বিক্ষোভ শুরু হয়। দুপুরে ঢাকা-টাঙ্গাইল ও ঢাকা-ময়মনসিংহ মহাসড়ক অবরোধ করেন শ্রমিকরা। পরে টিয়ারশেল ও সাউন্ড গ্রেনেড&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/dhaka/981532/%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A7%9C%E0%A6%95%E0%A7%87-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A7%8D%E0%A6%9F%E0%A6%BF-%E0%A6%A7%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE">বাংলা ট্রিবিউন</source>
    </item>

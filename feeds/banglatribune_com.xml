      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/fd59f44b0bfa630faec0922e3f2dfb67-6b01eeb7a173e.jpg?jadewits_media_id=1056274" length="0" type="image/jpeg" />

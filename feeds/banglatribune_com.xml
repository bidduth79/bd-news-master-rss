    <item>
      <title>কেশম দ্বীপে ফের ক্ষেপণাস্ত্র হামলা চালিয়েছে যুক্তরাষ্ট্র, দাবি ইরানের</title>
      <link>https://www.banglatribune.com/foreign/middle-east/982253/%E0%A6%95%E0%A7%87%E0%A6%B6%E0%A6%AE-%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%80%E0%A6%AA%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA%E0%A6%A3%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/middle-east/982253/%E0%A6%95%E0%A7%87%E0%A6%B6%E0%A6%AE-%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%80%E0%A6%AA%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA%E0%A6%A3%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A7%87</guid>
      <pubDate>Fri, 20 Nov 2026 23:11:44 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/08b2f3407180872d35b2efad8977fc4e-6b007f1de46c2.jpg?jadewits_media_id=1056110" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/08b2f3407180872d35b2efad8977fc4e-6b007f1de46c2.jpg?jadewits_media_id=1056110" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/08b2f3407180872d35b2efad8977fc4e-6b007f1de46c2.jpg?jadewits_media_id=1056110" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কেশম দ্বীপে ফের ক্ষেপণাস্ত্র হামলা চালিয়েছে যুক্তরাষ্ট্র, দাবি ইরানের" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাষ্ট্রের ছোড়া একটি ক্ষেপণাস্ত্র দক্ষিণ ইরানের কেশম দ্বীপের উপকণ্ঠে আঘাত হেনেছে বলে জানিয়েছে ইরানের আধা-সরকারি বার্তা সংস্থা তাসনিম। শুক্রবার সন্ধ্যায় এ ঘটনা ঘটে।

পাকিস্তানের প্রাকৃতিক সম্পদের মূল্য ৮-১০ ট্রিলিয়ন ডলার, দাবি পররাষ্ট্রমন্ত্রীর

প্রতিবেদন অনুযায়ী, স্থানীয় সময় সন্ধ্যা সাড়ে&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/middle-east/982253/%E0%A6%95%E0%A7%87%E0%A6%B6%E0%A6%AE-%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%80%E0%A6%AA%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA%E0%A6%A3%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ডিসেম্বর থেকে বন্ধ হচ্ছে কলকাতা ও শিলিগুড়ির বাংলাদেশ ভিসা সেন্টার</title>
      <link>https://www.banglatribune.com/national/982252/%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%95%E0%A6%B2%E0%A6%95%E0%A6%BE%E0%A6%A4%E0%A6%BE-%E0%A6%93-%E0%A6%B6%E0%A6%BF%E0%A6%B2%E0%A6%BF%E0%A6%97%E0%A7%81%E0%A7%9C%E0%A6%BF%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/national/982252/%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%95%E0%A6%B2%E0%A6%95%E0%A6%BE%E0%A6%A4%E0%A6%BE-%E0%A6%93-%E0%A6%B6%E0%A6%BF%E0%A6%B2%E0%A6%BF%E0%A6%97%E0%A7%81%E0%A7%9C%E0%A6%BF%E0%A6%B0</guid>
      <pubDate>Fri, 20 Nov 2026 22:56:55 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/5d46b55c49d5f6f9a7e9c7781ae6b0fc-6b007b8ee2aa0.jpg?jadewits_media_id=1056109" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/5d46b55c49d5f6f9a7e9c7781ae6b0fc-6b007b8ee2aa0.jpg?jadewits_media_id=1056109" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/5d46b55c49d5f6f9a7e9c7781ae6b0fc-6b007b8ee2aa0.jpg?jadewits_media_id=1056109" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডিসেম্বর থেকে বন্ধ হচ্ছে কলকাতা ও শিলিগুড়ির বাংলাদেশ ভিসা সেন্টার" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ সরকারের সঙ্গে ভিসা আউটসোর্সিং প্রতিষ্ঠান ডিইউ ডিজিটাল গ্লোবাল লিমিটেডের চুক্তির মেয়াদ শেষ হচ্ছে। এ কারণে আগামী ৩০ নভেম্বরের পর থেকে কলকাতা ও শিলিগুড়িতে অবস্থিত বাংলাদেশ ভিসা অ্যাপ্লিকেশন সেন্টারগুলো আর পরিচালিত হবে না।
এ বিষয়ে শুক্রবার (২০ নভেম্বর) একটি বিজ্ঞপ্তি জারি করেছে বাংলাদেশ উপ-হাইক&lt;/p&gt;</description>

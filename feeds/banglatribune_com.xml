    <item>
      <title>রাজধানীতে ২৪ ঘণ্টায় গ্রেফতার ৫৪১, মামলা ৪৮</title>
      <link>https://www.banglatribune.com/law-and-crime/979735/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A7%A8%E0%A7%AA-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A7%AB%E0%A7%AA%E0%A7%A7-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A7%AA%E0%A7%AE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/979735/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A7%A8%E0%A7%AA-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A7%AB%E0%A7%AA%E0%A7%A7-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A7%AA%E0%A7%AE</guid>
      <pubDate>Mon, 09 Nov 2026 10:16:44 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/08/25/7573c8093f910e3ec6cca8195624b20a-6a8da8c4b0ca0.jpg?jadewits_media_id=1040239" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/08/25/7573c8093f910e3ec6cca8195624b20a-6a8da8c4b0ca0.jpg?jadewits_media_id=1040239" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/08/25/7573c8093f910e3ec6cca8195624b20a-6a8da8c4b0ca0.jpg?jadewits_media_id=1040239" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজধানীতে ২৪ ঘণ্টায় গ্রেফতার ৫৪১, মামলা ৪৮" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীতে ঢাকা মেট্রোপলিটন পুলিশের নিয়মিত অভিযানে গত ২৪ ঘণ্টায় ৫৪১ জন গ্রেফতার হয়েছে। একই সময়ে ৪৮টি মামলা দায়ের করা হয়েছে।&amp;nbsp;&amp;nbsp;
সোমবার (৯ নভেম্বর) সকালে ডিএমপি মিডিয়া বিভাগ থেকে এ তথ্য জানানো হয়েছে।&amp;nbsp;
গ্রেফতারকৃতদের মধ্যে রমনা বিভাগ ২৪ জন, লালবাগ বিভাগ ৬১ জন, ওয়ারী বিভাগ ৬৭ জন, মতিঝিল বিভ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/979735/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A7%A8%E0%A7%AA-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A7%AB%E0%A7%AA%E0%A7%A7-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A7%AA%E0%A7%AE">বাংলা ট্রিবিউন</source>
    </item>

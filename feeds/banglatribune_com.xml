    <item>
      <title>এনসিপি নেত্রী নুসরাত তাবাসসুমের গ্রামের বাড়িতে আগুন, বোমা নিক্ষেপের অভিযোগ</title>
      <link>https://www.banglatribune.com/politics/980394/%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%A8%E0%A7%81%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%A4-%E0%A6%A4%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%B8%E0%A7%81%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/politics/980394/%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%A8%E0%A7%81%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%A4-%E0%A6%A4%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%B8%E0%A7%81%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE</guid>
      <pubDate>Thu, 12 Nov 2026 02:46:45 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/92bbda5241a47d0c71657952623cde23-6af4cc527e7d1.jpg?jadewits_media_id=1054539" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/92bbda5241a47d0c71657952623cde23-6af4cc527e7d1.jpg?jadewits_media_id=1054539" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/92bbda5241a47d0c71657952623cde23-6af4cc527e7d1.jpg?jadewits_media_id=1054539" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এনসিপি নেত্রী নুসরাত তাবাসসুমের গ্রামের বাড়িতে আগুন, বোমা নিক্ষেপের অভিযোগ" /&gt;&lt;/p&gt;&lt;p&gt;জাতীয় নাগরিক পার্টির (এনসিপি) যুগ্ম আহ্বায়ক ও সংরক্ষিত মহিলা আসনের সংসদ সদস্য নুসরাত তাবাসসুমের কুষ্টিয়ার দৌলতপুরের বাড়িতে পেট্রোল বোমা নিক্ষেপের অভিযোগ উঠেছে। বুধবার (১২ নভেম্বর) দিবাগত রাতে সামাজিক যোগাযোগমাধ্যম ফেসবুকে দেওয়া পোস্টে তিনি নিজেই এ অভিযোগ করেন।&amp;nbsp;
ফেসবুক পোস্টে নুসরাত তাবাসসুম লেখ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/politics/980394/%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%A8%E0%A7%81%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%A4-%E0%A6%A4%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%B8%E0%A7%81%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ঢাকা থেকে রিয়াদগামী ১৮৯ ফ্লাইট বাতিল, ক্ষতিগ্রস্ত যাত্রী ২৩২৭৪</title>

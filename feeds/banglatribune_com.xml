      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/c860b1a3b99b890181023d366f72d31f-6af0ad2311dd1.jpg?jadewits_media_id=1053947" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/c860b1a3b99b890181023d366f72d31f-6af0ad2311dd1.jpg?jadewits_media_id=1053947" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/c860b1a3b99b890181023d366f72d31f-6af0ad2311dd1.jpg?jadewits_media_id=1053947" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আঞ্চলিক সহযোগিতা জোরদারে গণমাধ্যমকে জাতীয়তাবাদী বয়ানের বাইরে আসতে হবে: রিয়াজ আহমেদ" /&gt;&lt;/p&gt;&lt;p&gt;আঞ্চলিক সহযোগিতা জোরদার এবং জনগণের আস্থা অর্জনে গণমাধ্যমকে প্রচলিত জাতীয়তাবাদী বয়ানের বাইরে এসে সহযোগিতামূলক ও তথ্যনির্ভর সাংবাদিকতার চর্চা করতে হবে বলে মন্তব্য করেছেন ঢাকা ট্রিবিউনের সম্পাদক রিয়াজ আহমেদ।
রবিবার (৮ নভেম্বর) বিকালে ঢাকা বিশ্ববিদ্যালয়ের ডেভেলপমেন্ট স্টাডিজ বিভাগের সেমিনার লাইব্রেরিতে &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/others/979700/%E0%A6%86%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%B2%E0%A6%BF%E0%A6%95-%E0%A6%B8%E0%A6%B9%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A6%BF%E0%A6%A4%E0%A6%BE-%E0%A6%9C%E0%A7%8B%E0%A6%B0%E0%A6%A6%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%97%E0%A6%A3%E0%A6%AE%E0%A6%BE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A6%AE%E0%A6%95%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F%E0%A6%A4%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A7%80">বাংলা ট্রিবিউন</source>

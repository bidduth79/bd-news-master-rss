    <item>
      <title>নুসরাত তাবাসসুমের বাড়িতে যাচ্ছে বিরোধী দলীয় সংসদীয় টিম</title>
      <link>https://www.banglatribune.com/politics/other-politics/980646/%E0%A6%A8%E0%A7%81%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%A4-%E0%A6%A4%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%B8%E0%A7%81%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%80-%E0%A6%A6%E0%A6%B2%E0%A7%80%E0%A7%9F-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6%E0%A7%80%E0%A7%9F</link>
      <guid isPermaLink="true">https://www.banglatribune.com/politics/other-politics/980646/%E0%A6%A8%E0%A7%81%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%A4-%E0%A6%A4%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%B8%E0%A7%81%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%80-%E0%A6%A6%E0%A6%B2%E0%A7%80%E0%A7%9F-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6%E0%A7%80%E0%A7%9F</guid>
      <pubDate>Fri, 13 Nov 2026 11:06:03 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/39399fa31619f971f174a850f32620aa-6af69a899d2d7.jpg?jadewits_media_id=1054754" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/39399fa31619f971f174a850f32620aa-6af69a899d2d7.jpg?jadewits_media_id=1054754" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/39399fa31619f971f174a850f32620aa-6af69a899d2d7.jpg?jadewits_media_id=1054754" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নুসরাত তাবাসসুমের বাড়িতে যাচ্ছে বিরোধী দলীয় সংসদীয় টিম" /&gt;&lt;/p&gt;&lt;p&gt;জাতীয় নাগরিক পার্টির (এনসিপি) যুগ্ম আহ্বায়ক ও সংসদ সদস্য নুসরাত তাবাসসুমের পুড়ে যাওয়া বাড়িঘর পরিদর্শনে যাচ্ছে বিরোধী দলীয় সংসদীয় টিম।
শুক্রবার (১৩ নভেম্বর) বিকাল ৩টায় কুষ্টিয়ার দৌলতপুর উপজেলার বাগোয়ান গ্রামে প্রেস ব্রিফিং করবেন সংসদ সদস্যরা।
বিরোধী দলীয় সংসদীয় এই টিমে রয়েছেন&amp;ndash; এনসিপির যুগ্ম আহ্&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/politics/other-politics/980646/%E0%A6%A8%E0%A7%81%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%A4-%E0%A6%A4%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%B8%E0%A7%81%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%80-%E0%A6%A6%E0%A6%B2%E0%A7%80%E0%A7%9F-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6%E0%A7%80%E0%A7%9F">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ফুটবল খেলাকে কেন্দ্র করে দুই গ্রামের সংঘর্ষ, প্রাণ গেলো অটোরিকশাচালকের</title>
      <link>https://www.banglatribune.com/country/chitagong/980645/%E0%A6%AB%E0%A7%81%E0%A6%9F%E0%A6%AC%E0%A6%B2-%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8D%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%B0%E0%A7%8D%E0%A6%B7-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/chitagong/980645/%E0%A6%AB%E0%A7%81%E0%A6%9F%E0%A6%AC%E0%A6%B2-%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8D%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%B0%E0%A7%8D%E0%A6%B7-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3</guid>
      <pubDate>Fri, 13 Nov 2026 11:03:52 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/bb8ed30dbb2de3a5f8385a33832f4ccc-6af699e91bb4d.jpg?jadewits_media_id=1054753" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/bb8ed30dbb2de3a5f8385a33832f4ccc-6af699e91bb4d.jpg?jadewits_media_id=1054753" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/bb8ed30dbb2de3a5f8385a33832f4ccc-6af699e91bb4d.jpg?jadewits_media_id=1054753" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফুটবল খেলাকে কেন্দ্র করে দুই গ্রামের সংঘর্ষ, প্রাণ গেলো অটোরিকশাচালকের" /&gt;&lt;/p&gt;&lt;p&gt;চাঁদপুরের হাজীগঞ্জ ও শাহরাস্তি উপজেলার দুই গ্রামের বাসিন্দাদের মধ্যে ফুটবল খেলাকে কেন্দ্র করে সংঘর্ষে শাহজাহান (৩৫) নামে এক অটোরিকশাচালক নিহত হয়েছেন। এ ঘটনায় আহত হয়েছেন অন্তত ছয়জন।
বৃহস্পতিবার (১২ নভেম্বর) বিকালে শাহরাস্তি উপজেলার ধোপল্লা বাজারে এ সংঘর্ষের ঘটনা ঘটে। নিহত শাহজাহান হাজীগঞ্জ পৌরসভার ৯ &lt;/p&gt;</description>

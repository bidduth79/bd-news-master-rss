    <item>
      <title>অনুষ্ঠানের ব্যানারে ছিল না শহীদ জিয়ার ছবি, বলেছেন বঙ্গবন্ধুর কথা: সেই ডিসি প্রত্যাহার</title>
      <link>https://www.banglatribune.com/country/khulna/981133/%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%A8%E0%A6%BE-%E0%A6%B6%E0%A6%B9%E0%A7%80%E0%A6%A6-%E0%A6%9C%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%9B%E0%A6%AC%E0%A6%BF-%E0%A6%AC%E0%A6%B2%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/khulna/981133/%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%A8%E0%A6%BE-%E0%A6%B6%E0%A6%B9%E0%A7%80%E0%A6%A6-%E0%A6%9C%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%9B%E0%A6%AC%E0%A6%BF-%E0%A6%AC%E0%A6%B2%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Sun, 15 Nov 2026 21:06:35 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/57f6a47467c91a28933e648dc3ee8672-6af9c9e1b8c79.jpg?jadewits_media_id=1055164" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/57f6a47467c91a28933e648dc3ee8672-6af9c9e1b8c79.jpg?jadewits_media_id=1055164" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/57f6a47467c91a28933e648dc3ee8672-6af9c9e1b8c79.jpg?jadewits_media_id=1055164" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অনুষ্ঠানের ব্যানারে ছিল না শহীদ জিয়ার ছবি, বলেছেন বঙ্গবন্ধুর কথা: সেই ডিসি প্রত্যাহার" /&gt;&lt;/p&gt;&lt;p&gt;চুয়াডাঙ্গার জেলা প্রশাসক (ডিসি) ও জেলা ম্যাজিস্ট্রেট লুৎফুন নাহারকে প্রত্যাহার করেছে সরকার। তার স্থলে জনপ্রশাসন মন্ত্রণালয়ের উপসচিব মো. আলমগীর কবীরকে নিয়োগ দেওয়া হয়েছে। গত ৭ নভেম্বর জাতীয় বিপ্লব ও সংহতি দিবসের সরকারি অনুষ্ঠান এবং জেলা প্রশাসকের বক্তব্য ঘিরে সৃষ্ট বিতর্কের আট দিনের মাথায় ডিসি লুৎফুন &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/khulna/981133/%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%A8%E0%A6%BE-%E0%A6%B6%E0%A6%B9%E0%A7%80%E0%A6%A6-%E0%A6%9C%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%9B%E0%A6%AC%E0%A6%BF-%E0%A6%AC%E0%A6%B2%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>মক্কায় হুথিদের দুটি ড্রোন ভূপাতিতের দাবি সৌদি জোটের</title>
      <link>https://www.banglatribune.com/foreign/middle-east/981132/%E0%A6%AE%E0%A6%95%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%B9%E0%A7%81%E0%A6%A5%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%9F%E0%A6%BF-%E0%A6%A1%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%A8-%E0%A6%AD%E0%A7%82%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF-%E0%A6%B8%E0%A7%8C%E0%A6%A6%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/middle-east/981132/%E0%A6%AE%E0%A6%95%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%B9%E0%A7%81%E0%A6%A5%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%9F%E0%A6%BF-%E0%A6%A1%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%A8-%E0%A6%AD%E0%A7%82%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF-%E0%A6%B8%E0%A7%8C%E0%A6%A6%E0%A6%BF</guid>
      <pubDate>Sun, 15 Nov 2026 21:03:35 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/47d552e9e2141ea8169051c804e5faab-6af9c97f7ce11.jpg?jadewits_media_id=1055163" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/47d552e9e2141ea8169051c804e5faab-6af9c97f7ce11.jpg?jadewits_media_id=1055163" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/47d552e9e2141ea8169051c804e5faab-6af9c97f7ce11.jpg?jadewits_media_id=1055163" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মক্কায় হুথিদের দুটি ড্রোন ভূপাতিতের দাবি সৌদি জোটের" /&gt;&lt;/p&gt;&lt;p&gt;সৌদি আরবের পশ্চিমাঞ্চলীয় মক্কা অঞ্চলের আকাশে ইয়েমেনের হুথি বিদ্রোহীদের ছোড়া দুটি ড্রোন ভূপাতিত করার দাবি করেছে সৌদি নেতৃত্বাধীন সামরিক জোট। রবিবার (১৫ নভেম্বর) এক বিবৃতিতে জোটের পক্ষ থেকে এ তথ্য জানানো হয়।
যুক্তরাষ্ট্রভিত্তিক সামাজিক যোগাযোগমাধ্যম এক্সে দেওয়া বিবৃতিতে জোটের মুখপাত্র তুর্কি আল-মালিকি&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/middle-east/981132/%E0%A6%AE%E0%A6%95%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%B9%E0%A7%81%E0%A6%A5%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%9F%E0%A6%BF-%E0%A6%A1%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%A8-%E0%A6%AD%E0%A7%82%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF-%E0%A6%B8%E0%A7%8C%E0%A6%A6%E0%A6%BF">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ডিআরইউ মিডিয়া কাপ ক্রিকেটে চ্যাম্পিয়ন ইন্ডিপেন্ডেন্ট টিভি</title>
      <link>https://www.banglatribune.com/press-release/981131/%E0%A6%A1%E0%A6%BF%E0%A6%86%E0%A6%B0%E0%A6%87%E0%A6%89-%E0%A6%AE%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE-%E0%A6%95%E0%A6%BE%E0%A6%AA-%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%9F%E0%A7%87-%E0%A6%9A%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A7%9F%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/press-release/981131/%E0%A6%A1%E0%A6%BF%E0%A6%86%E0%A6%B0%E0%A6%87%E0%A6%89-%E0%A6%AE%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE-%E0%A6%95%E0%A6%BE%E0%A6%AA-%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%9F%E0%A7%87-%E0%A6%9A%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A7%9F%E0%A6%A8</guid>
      <pubDate>Sun, 15 Nov 2026 21:02:20 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/b2d3d09d9d38be46e00dd2326194b924-6af9c91a20c38.jpg?jadewits_media_id=1055162" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/b2d3d09d9d38be46e00dd2326194b924-6af9c91a20c38.jpg?jadewits_media_id=1055162" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/b2d3d09d9d38be46e00dd2326194b924-6af9c91a20c38.jpg?jadewits_media_id=1055162" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডিআরইউ মিডিয়া কাপ ক্রিকেটে চ্যাম্পিয়ন ইন্ডিপেন্ডেন্ট টিভি" /&gt;&lt;/p&gt;&lt;p&gt;ল্যাবএইড-ওয়ালটন ডিআরইউ মিডিয়া কাপ ক্রিকেট-২০২৬ এ চ্যাম্পিয়ন হয়েছে ইন্ডিপেন্ডেন্ট টেলিভিশন। রবিবার (১৫ নভেম্বর) রাজধানীর পলটনের আউটার স্টেডিয়ামে অনুষ্ঠিত ফাইনালে তারা ৩ উইকেটে চ্যানেল২৪ টেলিভিশনকে হারিয়ে শিরোপা জিতে নেয়।
ঢাকা রিপোর্টার্স ইউনিটির (ডিআরইউ) ক্রীড়া সম্পাদক ওমর ফারুক রুবেলের পরিচা&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/press-release/981131/%E0%A6%A1%E0%A6%BF%E0%A6%86%E0%A6%B0%E0%A6%87%E0%A6%89-%E0%A6%AE%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE-%E0%A6%95%E0%A6%BE%E0%A6%AA-%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%9F%E0%A7%87-%E0%A6%9A%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A7%9F%E0%A6%A8">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ডাবলের পর দক্ষিণ আফ্রিকায় হৃদয়ের সেঞ্চুরি</title>
      <link>https://www.banglatribune.com/sport/cricket/981129/%E0%A6%A1%E0%A6%BE%E0%A6%AC%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%A3-%E0%A6%86%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%B9%E0%A7%83%E0%A6%A6%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%87%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/cricket/981129/%E0%A6%A1%E0%A6%BE%E0%A6%AC%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%A3-%E0%A6%86%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%B9%E0%A7%83%E0%A6%A6%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%87%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF</guid>
      <pubDate>Sun, 15 Nov 2026 21:16:54 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/b6ee2c7531ef58d0de8fd17788c784e4-6af19d1f91493.jpg?jadewits_media_id=1054040" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/b6ee2c7531ef58d0de8fd17788c784e4-6af19d1f91493.jpg?jadewits_media_id=1054040" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/b6ee2c7531ef58d0de8fd17788c784e4-6af19d1f91493.jpg?jadewits_media_id=1054040" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডাবলের পর দক্ষিণ আফ্রিকায় হৃদয়ের সেঞ্চুরি" /&gt;&lt;/p&gt;&lt;p&gt;সর্বশেষ টেস্টে দেশের মাটিতে ডাবল সেঞ্চুরির পর সেই ফর্ম দক্ষিণ আফ্রিকাতেও নিয়ে গেছেন তাওহীদ হৃদয়। জোহানেসবার্গে সিরিজের প্রথম টেস্টের প্রথম দিনেই বাংলাদেশের দ্বিতীয় ব্যাটার হিসেবে দক্ষিণ আফ্রিকার মাটিতে সেঞ্চুরির কীর্তি গড়েছেন হৃদয়। তাতে শুরুর ধাক্কার পর নিজেদের নিয়ন্ত্রণ প্রতিষ্ঠা করেছে বাংলাদেশ। 
দ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/cricket/981129/%E0%A6%A1%E0%A6%BE%E0%A6%AC%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%A3-%E0%A6%86%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%B9%E0%A7%83%E0%A6%A6%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%87%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>বিস্ফোরণ মামলায় কারাগারে যুবদল নেতা রানা</title>
      <link>https://www.banglatribune.com/law-and-crime/981127/%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%97%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%A6%E0%A6%B2-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/981127/%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%97%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%A6%E0%A6%B2-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A6%BE</guid>
      <pubDate>Sun, 15 Nov 2026 20:48:09 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/01/b3ea946a2d60c811bf49a66b2b570c71-6ae7213119acf.JPG?jadewits_media_id=1052579" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/01/b3ea946a2d60c811bf49a66b2b570c71-6ae7213119acf.JPG?jadewits_media_id=1052579" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/01/b3ea946a2d60c811bf49a66b2b570c71-6ae7213119acf.JPG?jadewits_media_id=1052579" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিস্ফোরণ মামলায় কারাগারে যুবদল নেতা রানা" /&gt;&lt;/p&gt;&lt;p&gt;ঢাকার মোহাম্মদপুর থানার মারধরসহ বিস্ফোরক দ্রব্য আইনের মামলায় ছাত্রদলের ঢাকা মহানগর দক্ষিণের সাবেক যুগ্ম আহ্বায়ক ও যুবদল নেতা সজীব আহমেদ রানাকে কারাগারে পাঠানো হয়েছে। তদন্ত কর্মকর্তার আবেদনের পরিপ্রেক্ষিতে রবিবার (১৫ নভেম্বর) ঢাকার মেট্রোপলিটন ম্যাজিস্ট্রেট হাসিবুজ্জামান এ আদেশ দেন।
মামলার তদন্ত কর্ম&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/981127/%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%97%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%A6%E0%A6%B2-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A6%BE">বাংলা ট্রিবিউন</source>

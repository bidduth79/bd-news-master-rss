    <item>
      <title>‘মুক্তিযোদ্ধাদের নির্ভুল তালিকা তৈরিকে অগ্রাধিকার, রাজাকারের তালিকা পরে’</title>
      <link>https://www.banglatribune.com/national/980370/%E2%80%98%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AD%E0%A7%81%E0%A6%B2-%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%95%E0%A6%BE-%E0%A6%A4%E0%A7%88%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A7%87-%E0%A6%85%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A7%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/national/980370/%E2%80%98%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AD%E0%A7%81%E0%A6%B2-%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%95%E0%A6%BE-%E0%A6%A4%E0%A7%88%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A7%87-%E0%A6%85%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A7%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Wed, 11 Nov 2026 23:04:47 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/abfe985ac5daa7dd570ff68cd6665a05-6af49fec5234a.JPG?jadewits_media_id=1054521" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/abfe985ac5daa7dd570ff68cd6665a05-6af49fec5234a.JPG?jadewits_media_id=1054521" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/abfe985ac5daa7dd570ff68cd6665a05-6af49fec5234a.JPG?jadewits_media_id=1054521" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘মুক্তিযোদ্ধাদের নির্ভুল তালিকা তৈরিকে অগ্রাধিকার, রাজাকারের তালিকা পরে’" /&gt;&lt;/p&gt;&lt;p&gt;একাত্তরে মুক্তিযুদ্ধের সময় রাজাকার, আলবদর, আল শামস ও মুক্তিযুদ্ধের বিরোধিতাকারীদের তালিকা তৈরির বিষয়টি পরবর্তী সময়ে বিবেচনা করবে সরকার। বর্তমানে শহীদদের তালিকা প্রস্তুত এবং প্রকৃত মুক্তিযোদ্ধাদের নির্ভুল তালিকা তৈরিকে অগ্রাধিকার দেওয়া হচ্ছে।
বুধবার (১১ নভেম্বর) ত্রয়োদশ জাতীয় সংসদের প্রশ্নোত্তর পর্বে&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/980370/%E2%80%98%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AD%E0%A7%81%E0%A6%B2-%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%95%E0%A6%BE-%E0%A6%A4%E0%A7%88%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A7%87-%E0%A6%85%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A7%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>গোল্ডেন সিল্ক রোড অ্যাওয়ার্ড পেলেন বাংলা ট্রিবিউনের আরশাদসহ ২৬ সাংবাদিক</title>
      <link>https://www.banglatribune.com/others/980369/%E0%A6%97%E0%A7%8B%E0%A6%B2%E0%A7%8D%E0%A6%A1%E0%A7%87%E0%A6%A8-%E0%A6%B8%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%95-%E0%A6%B0%E0%A7%8B%E0%A6%A1-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A6%B8-%E0%A6%AA%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/others/980369/%E0%A6%97%E0%A7%8B%E0%A6%B2%E0%A7%8D%E0%A6%A1%E0%A7%87%E0%A6%A8-%E0%A6%B8%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%95-%E0%A6%B0%E0%A7%8B%E0%A6%A1-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A6%B8-%E0%A6%AA%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE</guid>
      <pubDate>Wed, 11 Nov 2026 23:01:51 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/cd91ec9e6b06f695c4b13d7905e03c90-6af49ee85dc05.jpg?jadewits_media_id=1054520" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/cd91ec9e6b06f695c4b13d7905e03c90-6af49ee85dc05.jpg?jadewits_media_id=1054520" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/cd91ec9e6b06f695c4b13d7905e03c90-6af49ee85dc05.jpg?jadewits_media_id=1054520" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গোল্ডেন সিল্ক রোড অ্যাওয়ার্ড পেলেন বাংলা ট্রিবিউনের আরশাদসহ ২৬ সাংবাদিক" /&gt;&lt;/p&gt;&lt;p&gt;চীন-বাংলাদেশ দ্বিপক্ষীয় সম্পর্ক, উন্নয়ন সহযোগিতা ও দুই দেশের বন্ধুত্ব নিয়ে সাংবাদিকতায় অবদানের স্বীকৃতি হিসেবে ‘গোল্ডেন সিল্ক রোড মিডিয়া অ্যাওয়ার্ডস বাংলাদেশ ২০২৬’ পেয়েছেন ২৬ জন সাংবাদিক ও গণমাধ্যমকর্মী। এর মধ্যে প্রযুক্তি, স্বাস্থ্য ও শিক্ষা বিভাগে প্রথম পুরস্কার পেয়েছেন বাংলা ট্রিবিউনের আরশাদ আলী।&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/others/980369/%E0%A6%97%E0%A7%8B%E0%A6%B2%E0%A7%8D%E0%A6%A1%E0%A7%87%E0%A6%A8-%E0%A6%B8%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%95-%E0%A6%B0%E0%A7%8B%E0%A6%A1-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A6%B8-%E0%A6%AA%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>কোন ইউপিতে কবে ভোট, ১৬ নভেম্বর ঠিক করবে ইসি</title>
      <link>https://www.banglatribune.com/national/980367/%E0%A6%95%E0%A7%8B%E0%A6%A8-%E0%A6%87%E0%A6%89%E0%A6%AA%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A6%AC%E0%A7%87-%E0%A6%AD%E0%A7%8B%E0%A6%9F-%E0%A7%A7%E0%A7%AC-%E0%A6%A8%E0%A6%AD%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%A0%E0%A6%BF%E0%A6%95-%E0%A6%95%E0%A6%B0%E0%A6%AC%E0%A7%87-%E0%A6%87%E0%A6%B8%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.banglatribune.com/national/980367/%E0%A6%95%E0%A7%8B%E0%A6%A8-%E0%A6%87%E0%A6%89%E0%A6%AA%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A6%AC%E0%A7%87-%E0%A6%AD%E0%A7%8B%E0%A6%9F-%E0%A7%A7%E0%A7%AC-%E0%A6%A8%E0%A6%AD%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%A0%E0%A6%BF%E0%A6%95-%E0%A6%95%E0%A6%B0%E0%A6%AC%E0%A7%87-%E0%A6%87%E0%A6%B8%E0%A6%BF</guid>
      <pubDate>Wed, 11 Nov 2026 22:31:16 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2022/01/04/up-dc7013cd05887fe1456f6032d1d7c0cb.jpg?jadewits_media_id=768556" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2022/01/04/up-dc7013cd05887fe1456f6032d1d7c0cb.jpg?jadewits_media_id=768556" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2022/01/04/up-dc7013cd05887fe1456f6032d1d7c0cb.jpg?jadewits_media_id=768556" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কোন ইউপিতে কবে ভোট, ১৬ নভেম্বর ঠিক করবে ইসি" /&gt;&lt;/p&gt;&lt;p&gt;কোন ইউনিয়ন পরিষদে (ইউপি) কবে নির্বাচন হবে, তা নির্ধারণ করতে আগামী ১৬ নভেম্বর কমিশন সভা করবে নির্বাচন কমিশন (ইসি)। ওই বৈঠকে স্মার্ট এনআইডি নিয়েও আলোচনা হবে।
বুধবার (১১ নভেম্বর) রাজধানীর আগারগাঁওয়ের নির্বাচন ভবনে সাংবাদিকদের এ তথ্য জানান ইসির সিনিয়র সচিব আখতার আহমেদ।
আখতার আহমেদ বলেন, প্রধান নির্বাচন &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/980367/%E0%A6%95%E0%A7%8B%E0%A6%A8-%E0%A6%87%E0%A6%89%E0%A6%AA%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A6%AC%E0%A7%87-%E0%A6%AD%E0%A7%8B%E0%A6%9F-%E0%A7%A7%E0%A7%AC-%E0%A6%A8%E0%A6%AD%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%A0%E0%A6%BF%E0%A6%95-%E0%A6%95%E0%A6%B0%E0%A6%AC%E0%A7%87-%E0%A6%87%E0%A6%B8%E0%A6%BF">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>বিরিয়ানির দোকানে ঢুকে ম্যানেজারকে নেতা বললেন, ‘ঠাস কইরা গুলি করমু, মইরা থাকবেন’</title>
      <link>https://www.banglatribune.com/country/dhaka/980366/%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A7%8B%E0%A6%95%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%A2%E0%A7%81%E0%A6%95%E0%A7%87-%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A7%87%E0%A6%A8-%E2%80%98%E0%A6%A0%E0%A6%BE%E0%A6%B8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/dhaka/980366/%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A7%8B%E0%A6%95%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%A2%E0%A7%81%E0%A6%95%E0%A7%87-%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A7%87%E0%A6%A8-%E2%80%98%E0%A6%A0%E0%A6%BE%E0%A6%B8</guid>
      <pubDate>Wed, 11 Nov 2026 22:31:17 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/91ab82186d677350f3931f0b08a8d460-6af49851148c0.jpg?jadewits_media_id=1054519" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/91ab82186d677350f3931f0b08a8d460-6af49851148c0.jpg?jadewits_media_id=1054519" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/91ab82186d677350f3931f0b08a8d460-6af49851148c0.jpg?jadewits_media_id=1054519" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিরিয়ানির দোকানে ঢুকে ম্যানেজারকে নেতা বললেন, ‘ঠাস কইরা গুলি করমু, মইরা থাকবেন’" /&gt;&lt;/p&gt;&lt;p&gt;নারায়ণগঞ্জ জেলা মৎস্যজীবী দলের সভাপতি এইচ এম হোসেনের বিরুদ্ধে একটি বিরিয়ানির দোকানে ঢুকে ম্যানেজারকে প্রকাশ্যে গুলি করে হত্যার হুমকি দেওয়ার ভিডিও ভাইরাল হয়েছে। বুধবার (১১ নভেম্বর) সন্ধ্যায় এ ঘটনার একটি ভিডিও সামাজিক যোগাযোগ মাধ্যমে ছড়িয়ে পড়ে। এরপর সমালোচনা শুরু হয়।
ভাইরাল ভিডিওতে দেখা যায়, জেলা মৎস্&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/dhaka/980366/%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A7%8B%E0%A6%95%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%A2%E0%A7%81%E0%A6%95%E0%A7%87-%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A7%87%E0%A6%A8-%E2%80%98%E0%A6%A0%E0%A6%BE%E0%A6%B8">বাংলা ট্রিবিউন</source>

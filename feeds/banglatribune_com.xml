      <title>স্টেশন মাস্টারের কক্ষ লক্ষ্য করে ককটেল বিস্ফোরণ, প্রাণে বাঁচলেন ৩ রেলকর্মী</title>
      <link>https://www.banglatribune.com/country/chitagong/981245/%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B6%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%95%E0%A7%8D%E0%A6%B7-%E0%A6%B2%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8D%E0%A6%AF-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/chitagong/981245/%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B6%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%95%E0%A7%8D%E0%A6%B7-%E0%A6%B2%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8D%E0%A6%AF-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3</guid>
      <pubDate>Mon, 16 Nov 2026 15:08:15 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/bf0a97ca7dd150c7ab497faf80d36ba8-6afac7e384d4c.jpg?jadewits_media_id=1055256" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/bf0a97ca7dd150c7ab497faf80d36ba8-6afac7e384d4c.jpg?jadewits_media_id=1055256" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/bf0a97ca7dd150c7ab497faf80d36ba8-6afac7e384d4c.jpg?jadewits_media_id=1055256" style="max-width:100%;height:auto;margin-bottom:10px;" alt="স্টেশন মাস্টারের কক্ষ লক্ষ্য করে ককটেল বিস্ফোরণ, প্রাণে বাঁচলেন ৩ রেলকর্মী" /&gt;&lt;/p&gt;&lt;p&gt;ঝিনাইদহের কালীগঞ্জ উপজেলার বারোবাজার রেলস্টেশনে স্টেশন মাস্টারের কক্ষ লক্ষ্য করে পরপর তিনটি ককটেল বিস্ফোরণের ঘটনা ঘটেছে। এতে অল্পের জন্য রক্ষা পেয়েছেন কক্ষের ভেতরে থাকা স্টেশন মাস্টারসহ তিন রেলকর্মী। রবিবার (১৫ নভেম্বর) দিবাগত রাত ৩টার দিকে এ ঘটনা ঘটে।
বারোবাজার রেলস্টেশনের সহকারী স্টেশন মাস্টার মনি&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/chitagong/981245/%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B6%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%95%E0%A7%8D%E0%A6%B7-%E0%A6%B2%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8D%E0%A6%AF-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>মালয়েশিয়াগামী কর্মীদের স্বাস্থ্য পরীক্ষা শুরু</title>

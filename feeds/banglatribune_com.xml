      <title>গণহত্যার উদ্দেশ্য ছিল, আইসিজেতে দোষী সাব্যস্ত মিয়ানমার</title>
      <link>https://www.banglatribune.com/foreign/asia/981961/%E0%A6%97%E0%A6%A3%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%8D%E0%A6%AF-%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%86%E0%A6%87%E0%A6%B8%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%8B%E0%A6%B7%E0%A7%80-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%B8%E0%A7%8D%E0%A6%A4</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/asia/981961/%E0%A6%97%E0%A6%A3%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%8D%E0%A6%AF-%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%86%E0%A6%87%E0%A6%B8%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%8B%E0%A6%B7%E0%A7%80-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%B8%E0%A7%8D%E0%A6%A4</guid>
      <pubDate>Thu, 19 Nov 2026 17:04:44 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/04/c7067fc112c3ef7eeeece9accb695ffa-6aea5cb6d6055.jpg?jadewits_media_id=1053008" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/04/c7067fc112c3ef7eeeece9accb695ffa-6aea5cb6d6055.jpg?jadewits_media_id=1053008" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/04/c7067fc112c3ef7eeeece9accb695ffa-6aea5cb6d6055.jpg?jadewits_media_id=1053008" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গণহত্যার উদ্দেশ্য ছিল, আইসিজেতে দোষী সাব্যস্ত মিয়ানমার" /&gt;&lt;/p&gt;&lt;p&gt;২০১৭ সালে সামরিক অভিযানে ১০ হাজার রোহিঙ্গাকে হত্যার ঘটনায় মিয়ানমারকে &amp;lsquo;গণহত্যার উদ্দেশ্য&amp;rsquo; (জেনোসাইডাল ইনটেন্ট) থাকার দায়ে দোষী সাব্যস্ত করেছেন জাতিসংঘের সর্বোচ্চ আদালত। নেদারল্যান্ডসের হেগে অবস্থিত আন্তর্জাতিক বিচার আদালত (আইসিজে) বৃহস্পতিবার এই রায় ঘোষণা করেন। ওই সামরিক অভিযানের মুখে ৭ ল&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/asia/981961/%E0%A6%97%E0%A6%A3%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%8D%E0%A6%AF-%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%86%E0%A6%87%E0%A6%B8%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%8B%E0%A6%B7%E0%A7%80-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%B8%E0%A7%8D%E0%A6%A4">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>হত্যাচেষ্টা মামলায় জ্যোতিকা জ্যোতিকে কারাগারে আটক রাখার আবেদন</title>
      <link>https://www.banglatribune.com/law-and-crime/981960/%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%87%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A6%BE-%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%97%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%9F%E0%A6%95</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/981960/%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%87%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A6%BE-%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%97%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%9F%E0%A6%95</guid>
      <pubDate>Thu, 19 Nov 2026 17:02:34 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/4e478e1948d5a39a3437d10c2f560c53-6afed648b695d.jpg?jadewits_media_id=1055872" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/4e478e1948d5a39a3437d10c2f560c53-6afed648b695d.jpg?jadewits_media_id=1055872" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/4e478e1948d5a39a3437d10c2f560c53-6afed648b695d.jpg?jadewits_media_id=1055872" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হত্যাচেষ্টা মামলায় জ্যোতিকা জ্যোতিকে কারাগারে আটক রাখার আবেদন" /&gt;&lt;/p&gt;&lt;p&gt;জুলাই আন্দোলনের সময় রাজধানীর ভাটারা থানার এনামুল হক নামে এক ব্যক্তিকে হত্যাচেষ্টা মামলায় অভিনেত্রী জ্যোতিকা জ্যোতিকে কারাগারে আটক রাখার আবেদন করেছে ডিবি পুলিশ। মামলার এজাহারনামীয় ২১৬ নং আসামি তিনি।
মামলার তদন্ত কর্মকর্তা ডিবি পুলিশের গুলশান জোনাল টিমের সাব-ইন্সপেক্টর মুর্শিদুল আলম এ আবেদন করেন।
রাষ্&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/981960/%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%87%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A6%BE-%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%97%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%9F%E0%A6%95">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>সশস্ত্র বাহিনী দিবস শনিবার</title>
      <link>https://www.banglatribune.com/others/981959/%E0%A6%B8%E0%A6%B6%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80-%E0%A6%A6%E0%A6%BF%E0%A6%AC%E0%A6%B8-%E0%A6%B6%E0%A6%A8%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/others/981959/%E0%A6%B8%E0%A6%B6%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80-%E0%A6%A6%E0%A6%BF%E0%A6%AC%E0%A6%B8-%E0%A6%B6%E0%A6%A8%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Thu, 19 Nov 2026 16:56:37 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2023/11/16/387419823_209695788828484_6913788011954758983_n-bff00af2e438f0e806e84d5b226c805b.png?jadewits_media_id=888478" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2023/11/16/387419823_209695788828484_6913788011954758983_n-bff00af2e438f0e806e84d5b226c805b.png?jadewits_media_id=888478" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2023/11/16/387419823_209695788828484_6913788011954758983_n-bff00af2e438f0e806e84d5b226c805b.png?jadewits_media_id=888478" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সশস্ত্র বাহিনী দিবস শনিবার" /&gt;&lt;/p&gt;&lt;p&gt;যথাযোগ্য মর্যাদা ও উৎসাহ-উদ্দীপনার মধ্য দিয়ে আগামী শনিবার (২১ নভেম্বর) সারা দেশে সশস্ত্র বাহিনী দিবস উদযাপিত হবে। দিবসটি উপলক্ষে ঢাকা সেনানিবাসের শিখা অনির্বাণে শ্রদ্ধা নিবেদন, বীর মুক্তিযোদ্ধাদের সংবর্ধনা, সেনাকুঞ্জে বিশেষ অনুষ্ঠান এবং সর্বসাধারণের জন্য নৌবাহিনীর যুদ্ধজাহাজ পরিদর্শনসহ নানা কর্মসূচি&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/others/981959/%E0%A6%B8%E0%A6%B6%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80-%E0%A6%A6%E0%A6%BF%E0%A6%AC%E0%A6%B8-%E0%A6%B6%E0%A6%A8%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>জামায়াতের ৪০ দিনের কর্মসূচি ঘোষণা</title>
      <link>https://www.banglatribune.com/politics/jamat-e-islam/981958/%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A7%AA%E0%A7%A6-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%B8%E0%A7%82%E0%A6%9A%E0%A6%BF-%E0%A6%98%E0%A7%8B%E0%A6%B7%E0%A6%A3%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/politics/jamat-e-islam/981958/%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A7%AA%E0%A7%A6-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%B8%E0%A7%82%E0%A6%9A%E0%A6%BF-%E0%A6%98%E0%A7%8B%E0%A6%B7%E0%A6%A3%E0%A6%BE</guid>
      <pubDate>Thu, 19 Nov 2026 16:32:35 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/a9843c82e063931f6681f874acc7ec1c-6afecfeeba289.jpg?jadewits_media_id=1055871" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/a9843c82e063931f6681f874acc7ec1c-6afecfeeba289.jpg?jadewits_media_id=1055871" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/a9843c82e063931f6681f874acc7ec1c-6afecfeeba289.jpg?jadewits_media_id=1055871" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জামায়াতের ৪০ দিনের কর্মসূচি ঘোষণা" /&gt;&lt;/p&gt;&lt;p&gt;দেশের উদ্ভূত রাজনৈতিক পরিস্থিতি ও বিজয়ের মাস ডিসেম্বর উপলক্ষে টানা ৪০ দিনের কর্মসূচি ঘোষণা করেছে বাংলাদেশ জামায়াতে ইসলামী। বৃহস্পতিবার (১৯ নভেম্বর) বিকালে রাজধানীর মগবাজারে জামায়াতে ইসলামীর কেন্দ্রীয় কার্যালয়ে দেশের সাম্প্রতিক পরিস্থিতি নিয়ে সংবাদ সম্মেলন এ ঘোষণা দেন জামায়াতের সেক্রেটারি জেনারেল মিয়&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/politics/jamat-e-islam/981958/%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A7%AA%E0%A7%A6-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%B8%E0%A7%82%E0%A6%9A%E0%A6%BF-%E0%A6%98%E0%A7%8B%E0%A6%B7%E0%A6%A3%E0%A6%BE">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>পাবলিক বিশ্ববিদ্যালয়ে ভর্তি পরীক্ষা আপাতত স্থগিতই থাকছে, পূর্ণাঙ্গ বেঞ্চে শুনানি ২৩ নভেম্বর</title>
      <link>https://www.banglatribune.com/law-and-crime/981957/%E0%A6%AA%E0%A6%BE%E0%A6%AC%E0%A6%B2%E0%A6%BF%E0%A6%95-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87-%E0%A6%AD%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%86%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%A4-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%97%E0%A6%BF%E0%A6%A4%E0%A6%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/981957/%E0%A6%AA%E0%A6%BE%E0%A6%AC%E0%A6%B2%E0%A6%BF%E0%A6%95-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87-%E0%A6%AD%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%86%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%A4-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%97%E0%A6%BF%E0%A6%A4%E0%A6%87</guid>
      <pubDate>Thu, 19 Nov 2026 16:23:07 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/03/16/d7a86567049982fe4e2b54db76545e7b-69b7deacb009a.jpg?jadewits_media_id=1015539" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/03/16/d7a86567049982fe4e2b54db76545e7b-69b7deacb009a.jpg?jadewits_media_id=1015539" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/03/16/d7a86567049982fe4e2b54db76545e7b-69b7deacb009a.jpg?jadewits_media_id=1015539" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পাবলিক বিশ্ববিদ্যালয়ে ভর্তি পরীক্ষা আপাতত স্থগিতই থাকছে, পূর্ণাঙ্গ বেঞ্চে শুনানি ২৩ নভেম্বর" /&gt;&lt;/p&gt;&lt;p&gt;চলতি বছরের এইচএসসি ও সমমান পরীক্ষায় অকৃতকার্যদের খাতা পুনর্মূল্যায়ন এবং পুনঃপরীক্ষার ফল প্রকাশ না হওয়া পর্যন্ত ঢাকা বিশ্ববিদ্যালয়সহ দেশের সব পাবলিক বিশ্ববিদ্যালয়ে ভর্তি পরীক্ষা না নেওয়ার নির্দেশ সংক্রান্ত হাইকোর্টের আদেশ স্থগিতের আবেদনে সাড়া না দিয়ে আপিল বিভাগের পূর্ণাঙ্গ বেঞ্চে শুনানির জন্য মামলা&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/981957/%E0%A6%AA%E0%A6%BE%E0%A6%AC%E0%A6%B2%E0%A6%BF%E0%A6%95-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87-%E0%A6%AD%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%86%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%A4-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%97%E0%A6%BF%E0%A6%A4%E0%A6%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>সংসদ অধিবেশন পর্যবেক্ষণে মালদ্বীপের হাইকমিশনারকে স্পিকারের আমন্ত্রণ</title>
      <link>https://www.banglatribune.com/national/981956/%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6-%E0%A6%85%E0%A6%A7%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%A8-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A7%87%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A3%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%80%E0%A6%AA%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A6%AE%E0%A6%BF%E0%A6%B6%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/national/981956/%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6-%E0%A6%85%E0%A6%A7%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%A8-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A7%87%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A3%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%80%E0%A6%AA%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A6%AE%E0%A6%BF%E0%A6%B6%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A7%87</guid>
      <pubDate>Thu, 19 Nov 2026 16:14:15 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/1e322799eb7687d7f08cbfd1191f6c45-6afecbab92499.JPG?jadewits_media_id=1055870" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/1e322799eb7687d7f08cbfd1191f6c45-6afecbab92499.JPG?jadewits_media_id=1055870" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/1e322799eb7687d7f08cbfd1191f6c45-6afecbab92499.JPG?jadewits_media_id=1055870" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সংসদ অধিবেশন পর্যবেক্ষণে মালদ্বীপের হাইকমিশনারকে স্পিকারের আমন্ত্রণ" /&gt;&lt;/p&gt;&lt;p&gt;মালদ্বীপের সঙ্গে সংসদীয় সম্পর্ক জোরদারে সংসদীয় মৈত্রী গ্রুপ প্রতিষ্ঠা এবং দুই দেশের সংসদীয় প্রতিনিধি দলের সফর বিনিময়ের ওপর গুরুত্বারোপ করেছেন জাতীয় সংসদের স্পিকার মেজর (অব.) হাফিজ উদ্দিন আহমদ বীর বিক্রম। একই সঙ্গে মালদ্বীপের হাইকমিশনার শিউনীন রশীদকে জাতীয় সংসদের আগামী অধিবেশন পর্যবেক্ষণের আমন্ত্রণ জ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/981956/%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6-%E0%A6%85%E0%A6%A7%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%A8-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A7%87%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A3%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%80%E0%A6%AA%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A6%AE%E0%A6%BF%E0%A6%B6%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A7%87">বাংলা ট্রিবিউন</source>

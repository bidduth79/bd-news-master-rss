    <item>
      <title>‘মেসিকে ছাড়া আমাদের নতুন করে গড়ে উঠতে হবে’</title>
      <link>https://www.banglatribune.com/sport/football/980863/%E2%80%98%E0%A6%AE%E0%A7%87%E0%A6%B8%E0%A6%BF%E0%A6%95%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE-%E0%A6%86%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%97%E0%A7%9C%E0%A7%87-%E0%A6%89%E0%A6%A0%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%AC%E0%A7%87%E2%80%99</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/football/980863/%E2%80%98%E0%A6%AE%E0%A7%87%E0%A6%B8%E0%A6%BF%E0%A6%95%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE-%E0%A6%86%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%97%E0%A7%9C%E0%A7%87-%E0%A6%89%E0%A6%A0%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%AC%E0%A7%87%E2%80%99</guid>
      <pubDate>Sat, 14 Nov 2026 15:47:15 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/07/15/9d927ea2832cc289144917443bf57145-6a56f4ba4a2b4.jpg?jadewits_media_id=1033585" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/07/15/9d927ea2832cc289144917443bf57145-6a56f4ba4a2b4.jpg?jadewits_media_id=1033585" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/07/15/9d927ea2832cc289144917443bf57145-6a56f4ba4a2b4.jpg?jadewits_media_id=1033585" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘মেসিকে ছাড়া আমাদের নতুন করে গড়ে উঠতে হবে’" /&gt;&lt;/p&gt;&lt;p&gt;লিওনেল মেসিকে ছাড়া নতুন পথচলা শুরু হয়েছে আর্জেন্টিনার। তবে সেই যাত্রার প্রথম ম্যাচটা সুখকর হলো না বিশ্বকাপের রানার্সআপদের জন্য। শুক্রবার বুয়েনস এইরেসের লা বোম্বোনেরায় প্রীতি ম্যাচে উরুগুয়ের কাছে ২-১ গোলে হেরেছে আর্জেন্টিনা। অক্টোবরের শুরুতে আন্তর্জাতিক ফুটবল থেকে মেসির অবসরের পর এটাই ছিল দলটির প্রথম&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/football/980863/%E2%80%98%E0%A6%AE%E0%A7%87%E0%A6%B8%E0%A6%BF%E0%A6%95%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE-%E0%A6%86%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%97%E0%A7%9C%E0%A7%87-%E0%A6%89%E0%A6%A0%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%AC%E0%A7%87%E2%80%99">বাংলা ট্রিবিউন</source>
    </item>

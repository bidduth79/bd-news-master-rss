    <item>
      <title>পিছিয়ে পড়েও অ্যাতলেতিকো মাদ্রিদকে হারিয়েছে বার্সেলোনা</title>
      <link>https://www.banglatribune.com/sport/football/979718/%E0%A6%AA%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AA%E0%A7%9C%E0%A7%87%E0%A6%93-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A6%B2%E0%A7%87%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A7%8B-%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%A6%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/football/979718/%E0%A6%AA%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AA%E0%A7%9C%E0%A7%87%E0%A6%93-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A6%B2%E0%A7%87%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A7%8B-%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%A6%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A7%87</guid>
      <pubDate>Mon, 09 Nov 2026 04:35:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/6f91bc636e33f84d8c0e346e7b82409b-6af0f6535406b.jpg?jadewits_media_id=1053962" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/6f91bc636e33f84d8c0e346e7b82409b-6af0f6535406b.jpg?jadewits_media_id=1053962" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/6f91bc636e33f84d8c0e346e7b82409b-6af0f6535406b.jpg?jadewits_media_id=1053962" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পিছিয়ে পড়েও অ্যাতলেতিকো মাদ্রিদকে হারিয়েছে বার্সেলোনা" /&gt;&lt;/p&gt;&lt;p&gt;সমীকরণ ছিল যে দল জিততো তারাই হয়ে যেতো স্প্যানিশ লা-লিগার টেবিলের এক নম্বর দল। অ্যাতলেতিকো মাদ্রিদ নিজেদের মাঠ মেট্রোপলিতানোতে শুরুটাও করেছিল দুর্দান্ত। এগিয়ে যায় শুরুতেই। তবে সেখান থেকে অসাধারণ কামব্যাক দিয়ে জয় তুলে নিয়েছে বার্সেলোনা।
রবিবারের (৮ নভেম্বর) সন্ধ্যার এ ম্যাচে ম্যাচে আতলেতিকো দারুণ শুরু&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/football/979718/%E0%A6%AA%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AA%E0%A7%9C%E0%A7%87%E0%A6%93-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A6%B2%E0%A7%87%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A7%8B-%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%A6%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A7%87">বাংলা ট্রিবিউন</source>

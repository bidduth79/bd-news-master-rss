    <item>
      <title>রেকর্ড গড়ে গোল, ইংল্যান্ডকে জেতালেন হ্যারি কেইন</title>
      <link>https://www.banglatribune.com/sport/football/980617/%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A1-%E0%A6%97%E0%A7%9C%E0%A7%87-%E0%A6%97%E0%A7%8B%E0%A6%B2-%E0%A6%87%E0%A6%82%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A6%95%E0%A7%87-%E0%A6%9C%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%B9%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%95%E0%A7%87%E0%A6%87%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/football/980617/%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A1-%E0%A6%97%E0%A7%9C%E0%A7%87-%E0%A6%97%E0%A7%8B%E0%A6%B2-%E0%A6%87%E0%A6%82%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A6%95%E0%A7%87-%E0%A6%9C%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%B9%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%95%E0%A7%87%E0%A6%87%E0%A6%A8</guid>
      <pubDate>Fri, 13 Nov 2026 05:13:44 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/749cafc736add9ee1cd605141d25288e-6af647f90a770.jpg?jadewits_media_id=1054731" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/749cafc736add9ee1cd605141d25288e-6af647f90a770.jpg?jadewits_media_id=1054731" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/749cafc736add9ee1cd605141d25288e-6af647f90a770.jpg?jadewits_media_id=1054731" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রেকর্ড গড়ে গোল, ইংল্যান্ডকে জেতালেন হ্যারি কেইন" /&gt;&lt;/p&gt;&lt;p&gt;ইংল্যান্ডের জার্সিতে সবচেয়ে বেশি ম্যাচ খেলার রেকর্ড গড়ার রাতে গোল করেও দলকে জয় উপহার দিলেন অধিনায়ক হ্যারি কেইন। উয়েফা নেশন্স লিগে ওয়েম্বলিতে ক্রোয়েশিয়াকে ২-১ গোলে হারিয়েছে ইংল্যান্ড। এই জয়ে আগামী বছরের কোয়ার্টার ফাইনাল নিশ্চিত করেছে থমাস টুখেলের দল।
বৃহস্পতিবার রাতে ওয়েম্বলিতে ক্রোয়েশিয়ার বিপক্ষে মা&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/football/980617/%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A1-%E0%A6%97%E0%A7%9C%E0%A7%87-%E0%A6%97%E0%A7%8B%E0%A6%B2-%E0%A6%87%E0%A6%82%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A6%95%E0%A7%87-%E0%A6%9C%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%B9%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%95%E0%A7%87%E0%A6%87%E0%A6%A8">বাংলা ট্রিবিউন</source>
    </item>

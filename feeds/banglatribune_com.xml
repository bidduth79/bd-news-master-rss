      <guid isPermaLink="true">https://www.banglatribune.com/health/979936/%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A6%AE%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B0%E0%A6%AE%E0%A7%8D%E0%A6%AD%E0%A6%BF%E0%A6%95-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B6</guid>
      <pubDate>Tue, 10 Nov 2026 05:44:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/b9b64905a27513b7dd67b36391e35676-6af245ce09f45.jpg?jadewits_media_id=1054144" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/b9b64905a27513b7dd67b36391e35676-6af245ce09f45.jpg?jadewits_media_id=1054144" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/b9b64905a27513b7dd67b36391e35676-6af245ce09f45.jpg?jadewits_media_id=1054144" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সরকারি সেবাব্যবস্থার মাধ্যমে প্রারম্ভিক শিশু বিকাশ সহায়তা দেওয়া সম্ভব: গবেষণা" /&gt;&lt;/p&gt;&lt;p&gt;বিদ্যমান সরকারি সেবাব্যবস্থার মাধ্যমে প্রারম্ভিক শিশু বিকাশ (ইসিডি) সহায়তা দেওয়া সম্ভব এবং এর মাধ্যমে শিশু প্রতিপালনের চর্চা ও ঘরে শিশুর শেখা ও বিকাশে সহায়ক কার্যক্রম উন্নত হতে পারে বলে উঠে এসেছে &amp;lsquo;থ্রাইভ কর্মসূচির&amp;rsquo; গবেষণায়।
সোমবার (৯ নভেম্বর) রাজধানীতে &amp;lsquo;বাংলাদেশে প্রারম্ভিক শিশু বি&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/health/979936/%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A6%AE%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B0%E0%A6%AE%E0%A7%8D%E0%A6%AD%E0%A6%BF%E0%A6%95-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B6">বাংলা ট্রিবিউন</source>

    <item>
      <title>কীভাবে মিছিল করলো, আ.লীগ নেতা ইকবালের বাড়ির ইট তো থাকার কথা নয়: বিএনপি নেতার হুঁশিয়ারি</title>
      <link>https://www.banglatribune.com/country/chitagong/983896/%E0%A6%95%E0%A7%80%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%8B-%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%87%E0%A6%95%E0%A6%AC%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%B0-%E0%A6%87%E0%A6%9F-%E0%A6%A4%E0%A7%8B</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/chitagong/983896/%E0%A6%95%E0%A7%80%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%8B-%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%87%E0%A6%95%E0%A6%AC%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%B0-%E0%A6%87%E0%A6%9F-%E0%A6%A4%E0%A7%8B</guid>
      <pubDate>Sat, 28 Nov 2026 23:26:26 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/684a952cb5644375675c490a820b5ea6-6b0b0ebe77162.jpg?jadewits_media_id=1057569" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/684a952cb5644375675c490a820b5ea6-6b0b0ebe77162.jpg?jadewits_media_id=1057569" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/684a952cb5644375675c490a820b5ea6-6b0b0ebe77162.jpg?jadewits_media_id=1057569" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কীভাবে মিছিল করলো, আ.লীগ নেতা ইকবালের বাড়ির ইট তো থাকার কথা নয়: বিএনপি নেতার হুঁশিয়ারি" /&gt;&lt;/p&gt;&lt;p&gt;ব্রাহ্মণবাড়িয়ার আখাউড়া উপজেলায় মিছিল করলে কার্যক্রম নিষিদ্ধ আওয়ামী লীগ এবং এর সহযোগী ও ভ্রাতৃপ্রতিম সংগঠনের নেতাকর্মীদের বাড়িঘর গুঁড়িয়ে দেওয়ার হুঁশিয়ারি দিয়েছেন জেলা পরিষদের প্রশাসক ও জেলা বিএনপির সাধারণ সম্পাদক মো. সিরাজুল ইসলাম।
শুক্রবার সন্ধ্যায় আখাউড়া পৌরসভার আদর আলী কমপ্লেক্সের সামনে এক সমাব&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/chitagong/983896/%E0%A6%95%E0%A7%80%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%8B-%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%87%E0%A6%95%E0%A6%AC%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%B0-%E0%A6%87%E0%A6%9F-%E0%A6%A4%E0%A7%8B">বাংলা ট্রিবিউন</source>

    <item>
      <title>শাহজালালেও নাশকতার আশঙ্কা, বাড়ানো হয়েছে নজরদারি</title>
      <link>https://www.banglatribune.com/law-and-crime/982060/%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A6%9C%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%93-%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%B6%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%B9%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%A8%E0%A6%9C%E0%A6%B0%E0%A6%A6%E0%A6%BE%E0%A6%B0%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/982060/%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A6%9C%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%93-%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%B6%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%B9%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%A8%E0%A6%9C%E0%A6%B0%E0%A6%A6%E0%A6%BE%E0%A6%B0%E0%A6%BF</guid>
      <pubDate>Fri, 20 Nov 2026 08:00:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/7bc4767adbfe2bab9a5e65ff33783061-6af2abeb76567.jpg?jadewits_media_id=1054167" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/7bc4767adbfe2bab9a5e65ff33783061-6af2abeb76567.jpg?jadewits_media_id=1054167" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/7bc4767adbfe2bab9a5e65ff33783061-6af2abeb76567.jpg?jadewits_media_id=1054167" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শাহজালালেও নাশকতার আশঙ্কা, বাড়ানো হয়েছে নজরদারি" /&gt;&lt;/p&gt;&lt;p&gt;হযরত শাহজালাল আন্তর্জাতিক বিমানবন্দরের থার্ড টার্মিনাল ও হ্যাঙ্গার গেট ঘিরে নাশকতার পরিকল্পনার তথ্য পেয়েছেন গোয়েন্দারা। আগামী ১৬ ডিসেম্বর উদ্বোধনের অপেক্ষায় থাকা থার্ড টার্মিনাল এবং বিমানবন্দরের গুরুত্বপূর্ণ স্থাপনা হ্যাঙ্গার গেটকে লক্ষ্যবস্তু করা হতে পারে বলে আশঙ্কা করছেন তারা। এমন তথ্য পাওয়ার পরপর&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/982060/%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A6%9C%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%93-%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%B6%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%B9%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%A8%E0%A6%9C%E0%A6%B0%E0%A6%A6%E0%A6%BE%E0%A6%B0%E0%A6%BF">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>সাকিব-তামিমদের পেছনে ফেলে যে রেকর্ডে দ্রুততম মুশফিক-লিটন</title>
      <link>https://www.banglatribune.com/sport/cricket/982019/%E0%A6%B8%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%AC-%E0%A6%A4%E0%A6%BE%E0%A6%AE%E0%A6%BF%E0%A6%AE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%87%E0%A6%9B%E0%A6%A8%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%AF%E0%A7%87-%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A7%87-%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%A4%E0%A6%A4%E0%A6%AE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/cricket/982019/%E0%A6%B8%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%AC-%E0%A6%A4%E0%A6%BE%E0%A6%AE%E0%A6%BF%E0%A6%AE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%87%E0%A6%9B%E0%A6%A8%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%AF%E0%A7%87-%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A7%87-%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%A4%E0%A6%A4%E0%A6%AE</guid>
      <pubDate>Fri, 20 Nov 2026 08:00:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2025/11/20/b3b01775a78019ab798dc26df030c9c0-691ebd73d8a0e.jpg?jadewits_media_id=1001617" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2025/11/20/b3b01775a78019ab798dc26df030c9c0-691ebd73d8a0e.jpg?jadewits_media_id=1001617" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2025/11/20/b3b01775a78019ab798dc26df030c9c0-691ebd73d8a0e.jpg?jadewits_media_id=1001617" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাকিব-তামিমদের পেছনে ফেলে যে রেকর্ডে দ্রুততম মুশফিক-লিটন" /&gt;&lt;/p&gt;&lt;p&gt;দক্ষিণ আফ্রিকার বিপক্ষে জোহানেসবার্গ টেস্টে হারের দিনে বাংলাদেশের ক্রিকেটে নতুন রেকর্ড গড়েছেন মুশফিকুর রহিম ও লিটন দাস। টেস্ট ক্রিকেটে বাংলাদেশের দ্রুততম ব্যাটিং জুটি হিসেবে ২ হাজার রানের মাইলফলক ছুঁয়েছেন তারা। মাত্র ৩৪ ইনিংসেই এই কীর্তি গড়েছেন দুজন।
টেস্টের শেষ দিনে বৃহস্পতিবার দক্ষিণ আফ্রিকার পেসা&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/cricket/982019/%E0%A6%B8%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%AC-%E0%A6%A4%E0%A6%BE%E0%A6%AE%E0%A6%BF%E0%A6%AE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%87%E0%A6%9B%E0%A6%A8%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%AF%E0%A7%87-%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A7%87-%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%A4%E0%A6%A4%E0%A6%AE">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>নাশকতার টার্গেটে সরকারি স্থাপনা, নজরদারি বাড়িয়েছে পুলিশ</title>
      <link>https://www.banglatribune.com/law-and-crime/982079/%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%97%E0%A7%87%E0%A6%9F%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%AA%E0%A6%A8%E0%A6%BE-%E0%A6%A8%E0%A6%9C%E0%A6%B0%E0%A6%A6%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/982079/%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%97%E0%A7%87%E0%A6%9F%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%AA%E0%A6%A8%E0%A6%BE-%E0%A6%A8%E0%A6%9C%E0%A6%B0%E0%A6%A6%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A7%87</guid>
      <pubDate>Fri, 20 Nov 2026 06:48:35 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/b8626c939ceb4f0da2d5428831f0bb39-6afc7a3846f53.jpg?jadewits_media_id=1055549" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/b8626c939ceb4f0da2d5428831f0bb39-6afc7a3846f53.jpg?jadewits_media_id=1055549" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/b8626c939ceb4f0da2d5428831f0bb39-6afc7a3846f53.jpg?jadewits_media_id=1055549" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নাশকতার টার্গেটে সরকারি স্থাপনা, নজরদারি বাড়িয়েছে পুলিশ" /&gt;&lt;/p&gt;&lt;p&gt;দেশে কার্যক্রম নিষিদ্ধ আওয়ামী লীগের কর্মসূচিকে কেন্দ্র করে নাশকতামূলক কর্মকাণ্ড বাড়ছে। রাজধানীর পাশাপাশি দেশের বিভিন্ন জেলায় মিছিল, ভাঙচুর ও অগ্নিসংযোগের ঘটনা ঘটছে। এসব ঘটনায় সরকারি স্থাপনাও টার্গেট হচ্ছে। পরিস্থিতি বিবেচনায় নজরদারি ও নিরাপত্তা বাড়িয়েছে পুলিশ।
পুলিশ সদর দফতরের তথ্য অনুযায়ী, গত ৭ নভে&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/982079/%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%97%E0%A7%87%E0%A6%9F%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%AA%E0%A6%A8%E0%A6%BE-%E0%A6%A8%E0%A6%9C%E0%A6%B0%E0%A6%A6%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ঢাকার সিএনজি গ্যারেজ থেকে চুরি, গাইবান্ধায় ২২ ভরি স্বর্ণালংকারসহ গ্রেফতার ২</title>
      <link>https://www.banglatribune.com/law-and-crime/982078/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%9C%E0%A6%BF-%E0%A6%97%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%9C-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%97%E0%A6%BE%E0%A6%87%E0%A6%AC%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A7%9F-%E0%A7%A8%E0%A7%A8-%E0%A6%AD%E0%A6%B0%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/982078/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%9C%E0%A6%BF-%E0%A6%97%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%9C-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%97%E0%A6%BE%E0%A6%87%E0%A6%AC%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A7%9F-%E0%A7%A8%E0%A7%A8-%E0%A6%AD%E0%A6%B0%E0%A6%BF</guid>
      <pubDate>Fri, 20 Nov 2026 06:36:58 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/cba23743210e629ca964199f235b662e-6aff95f7643a3.jpg?jadewits_media_id=1055948" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/cba23743210e629ca964199f235b662e-6aff95f7643a3.jpg?jadewits_media_id=1055948" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/cba23743210e629ca964199f235b662e-6aff95f7643a3.jpg?jadewits_media_id=1055948" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঢাকার সিএনজি গ্যারেজ থেকে চুরি, গাইবান্ধায় ২২ ভরি স্বর্ণালংকারসহ গ্রেফতার ২" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর যাত্রাবাড়ীতে সিএনজি গ্যারেজ থেকে ২২ ভরি স্বর্ণালংকার ও ১ লাখ ৯০ হাজার টাকা চুরির ঘটনায় দুজনকে গ্রেফতার করেছে পুলিশ। বুধবার (১৮ নভেম্বর) গাইবান্ধা সদর উপজেলার নিউমার্কেট সংলগ্ন এলাকা থেকে তাদের গ্রেফতার করা হয়।
গ্রেফতারকৃতরা হলেন মো. পাভেল ইসলাম ওরফে বুলেট (২৭) ও মোছা. তানিয়া (২২)।
ডিএমপির এ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/982078/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%9C%E0%A6%BF-%E0%A6%97%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%9C-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%97%E0%A6%BE%E0%A6%87%E0%A6%AC%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A7%9F-%E0%A7%A8%E0%A7%A8-%E0%A6%AD%E0%A6%B0%E0%A6%BF">বাংলা ট্রিবিউন</source>

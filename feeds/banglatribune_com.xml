    <item>
      <title>আসিফ নজরুলের মোবাইল ফোন ছিনতাই</title>
      <link>https://www.banglatribune.com/law-and-crime/980379/%E0%A6%86%E0%A6%B8%E0%A6%BF%E0%A6%AB-%E0%A6%A8%E0%A6%9C%E0%A6%B0%E0%A7%81%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%8B%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%B2-%E0%A6%AB%E0%A7%8B%E0%A6%A8-%E0%A6%9B%E0%A6%BF%E0%A6%A8%E0%A6%A4%E0%A6%BE%E0%A6%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/980379/%E0%A6%86%E0%A6%B8%E0%A6%BF%E0%A6%AB-%E0%A6%A8%E0%A6%9C%E0%A6%B0%E0%A7%81%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%8B%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%B2-%E0%A6%AB%E0%A7%8B%E0%A6%A8-%E0%A6%9B%E0%A6%BF%E0%A6%A8%E0%A6%A4%E0%A6%BE%E0%A6%87</guid>
      <pubDate>Thu, 12 Nov 2026 00:26:55 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/09/15/c597593235aaedc34b926336ee4f6d86-6aa935080e904.jpg?jadewits_media_id=1043885" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/09/15/c597593235aaedc34b926336ee4f6d86-6aa935080e904.jpg?jadewits_media_id=1043885" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/09/15/c597593235aaedc34b926336ee4f6d86-6aa935080e904.jpg?jadewits_media_id=1043885" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আসিফ নজরুলের মোবাইল ফোন ছিনতাই" /&gt;&lt;/p&gt;&lt;p&gt;সাবেক অন্তর্বর্তী সরকারের আইন উপদেষ্টা অধ্যাপক আসিফ নজরুলের মোবাইল ফোন ছিনতাই হয়েছে। বুধবার (১১ নভেম্বর) রাত সাড়ে ৭টার দিকে এ ঘটনা ঘটে। বিষয়টি নিজেই সামাজিক যোগাযোগমাধ্যম ফেসবুকে এক পোস্টের মাধ্যমে জানিয়েছেন আসিফ নজরুল।
পোস্টে তিনি লেখেন, &amp;lsquo;আমার গাড়ির জানালা খোলা ছিল। এক সেকেন্ডে মোবাইল ফোনটা ছ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/980379/%E0%A6%86%E0%A6%B8%E0%A6%BF%E0%A6%AB-%E0%A6%A8%E0%A6%9C%E0%A6%B0%E0%A7%81%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%8B%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%B2-%E0%A6%AB%E0%A7%8B%E0%A6%A8-%E0%A6%9B%E0%A6%BF%E0%A6%A8%E0%A6%A4%E0%A6%BE%E0%A6%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ঠিকাদারের ‘উপহার’ ইস্যুতে ক্ষমা চেয়েছেন প্রতিমন্ত্রী</title>

      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/44f8474da398beac4a51344ff22c59d5-6b033caa3b980.jpg?jadewits_media_id=1056425" length="0" type="image/jpeg" />

    <item>
      <title>মোটরসাইকেল আরোহী নিহতের পর গোপালগঞ্জে বাসে আগুন</title>
      <link>https://www.banglatribune.com/country/dhaka/980954/%E0%A6%AE%E0%A7%8B%E0%A6%9F%E0%A6%B0%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%87%E0%A6%B2-%E0%A6%86%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A7%80-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/dhaka/980954/%E0%A6%AE%E0%A7%8B%E0%A6%9F%E0%A6%B0%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%87%E0%A6%B2-%E0%A6%86%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A7%80-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</guid>
      <pubDate>Sun, 15 Nov 2026 00:06:12 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/39ba5124877f1b8d19c2b94964c9c96c-6af8a3004f36e.jpg?jadewits_media_id=1055022" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/39ba5124877f1b8d19c2b94964c9c96c-6af8a3004f36e.jpg?jadewits_media_id=1055022" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/39ba5124877f1b8d19c2b94964c9c96c-6af8a3004f36e.jpg?jadewits_media_id=1055022" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মোটরসাইকেল আরোহী নিহতের পর গোপালগঞ্জে বাসে আগুন" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জে যাত্রীবাহী বাসের চাপায় মহিবুল্লাহ (৪৫) নামে এক মোটরসাইকেল আরোহী নিহত হয়েছেন। এ ঘটনায় ইজিবাইকের আরও তিন যাত্রী গুরুতর আহত হয়েছেন। দুর্ঘটনার পর বিক্ষুব্ধ লোকজন বাসটিতে আগুন ধরিয়ে দেন।&amp;nbsp;
শনিবার (১৪ নভেম্বর) বিকাল সাড়ে ৪টার দিকে ঢাকা-খুলনা মহাসড়কের গোপালগঞ্জ সদর উপজেলার চন্দ্রদিঘলীয়া এলা&lt;/p&gt;</description>

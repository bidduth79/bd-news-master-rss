      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/982433/%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%B9%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%96%E0%A7%8B%E0%A6%81%E0%A6%9C%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8</guid>
      <pubDate>Sat, 21 Nov 2026 23:56:02 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/e0caa50fc39c1b1b7189ea642d5d46d5-6b01db2be9861.jpg?jadewits_media_id=1056269" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/e0caa50fc39c1b1b7189ea642d5d46d5-6b01db2be9861.jpg?jadewits_media_id=1056269" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/e0caa50fc39c1b1b7189ea642d5d46d5-6b01db2be9861.jpg?jadewits_media_id=1056269" style="max-width:100%;height:auto;margin-bottom:10px;" alt="তারানা হালিমের খোঁজে বাসায় পুলিশের অভিযান" /&gt;&lt;/p&gt;&lt;p&gt;কার্যক্রম নিষিদ্ধ আওয়ামী লীগের সাবেক সংসদ সদস্য ও প্রতিমন্ত্রী তারানা হালিমের খোঁজে গুলশানের একটি বাসায় অভিযান চালিয়েছে পুলিশ।&amp;nbsp;
শনিবার (২১ নভেম্বর) বিকালে গুলশান-২ এলাকার ওই বাসায় অভিযান চালায় পুলিশ। তবে তারানা হালিমকে ওই বাসায় পাওয়া যায়নি ব&amp;zwnj;লে জা&amp;zwnj;নি&amp;zwnj;য়ে&amp;zwnj;ছে পু&amp;zwnj;লি&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/982433/%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%B9%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%96%E0%A7%8B%E0%A6%81%E0%A6%9C%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>বধূ সেজে অপেক্ষা, অতিথিদের রান্নাবান্নাও শেষ: এলো না বরপক্ষ</title>
      <link>https://www.banglatribune.com/country/sylhet/982432/%E0%A6%AC%E0%A6%A7%E0%A7%82-%E0%A6%B8%E0%A7%87%E0%A6%9C%E0%A7%87-%E0%A6%85%E0%A6%AA%E0%A7%87%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%85%E0%A6%A4%E0%A6%BF%E0%A6%A5%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A6%BE%E0%A6%93-%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%8F%E0%A6%B2%E0%A7%87%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/sylhet/982432/%E0%A6%AC%E0%A6%A7%E0%A7%82-%E0%A6%B8%E0%A7%87%E0%A6%9C%E0%A7%87-%E0%A6%85%E0%A6%AA%E0%A7%87%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%85%E0%A6%A4%E0%A6%BF%E0%A6%A5%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A6%BE%E0%A6%93-%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%8F%E0%A6%B2%E0%A7%87%E0%A6%BE</guid>
      <pubDate>Sat, 21 Nov 2026 23:34:49 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/ce72ed01968e6bf865536d0f1c4d0a22-6b01d613a89e2.jpg?jadewits_media_id=1056268" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/ce72ed01968e6bf865536d0f1c4d0a22-6b01d613a89e2.jpg?jadewits_media_id=1056268" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/ce72ed01968e6bf865536d0f1c4d0a22-6b01d613a89e2.jpg?jadewits_media_id=1056268" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বধূ সেজে অপেক্ষা, অতিথিদের রান্নাবান্নাও শেষ: এলো না বরপক্ষ" /&gt;&lt;/p&gt;&lt;p&gt;বিয়ের আয়োজন ও অতিথি আপ্যায়নের রান্নাবান্না শেষ। বরপক্ষের অপেক্ষায় কনেপক্ষ। কিন্তু শেষ মুহূর্তে যৌতুকের টাকা না পেয়ে বিয়ের আসরে আসেননি বর ও পরিবারের লোকজন। শুক্রবার (২০ নভেম্বর) দুপুরে মৌলভীবাজারের কমলগঞ্জের আদমপুর ইউনিয়নের কাউয়ারগলা গ্রামে এ ঘটনা ঘটে।
এ ঘটনায় প্রতারণা, অর্থ আত্মসাৎ ও যৌতুকের দাবিতে &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/sylhet/982432/%E0%A6%AC%E0%A6%A7%E0%A7%82-%E0%A6%B8%E0%A7%87%E0%A6%9C%E0%A7%87-%E0%A6%85%E0%A6%AA%E0%A7%87%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%85%E0%A6%A4%E0%A6%BF%E0%A6%A5%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A6%BE%E0%A6%93-%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%8F%E0%A6%B2%E0%A7%87%E0%A6%BE">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>স্বর্ণের দামে বড় পতন</title>
      <link>https://www.banglatribune.com/business/industry-and-trade/982431/%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%AC%E0%A7%9C-%E0%A6%AA%E0%A6%A4%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/business/industry-and-trade/982431/%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%AC%E0%A7%9C-%E0%A6%AA%E0%A6%A4%E0%A6%A8</guid>
      <pubDate>Sat, 21 Nov 2026 23:17:59 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/04/15/86529e221aa8c5ffc75e1d47a11c1c70-69df1829b83aa.jpg?jadewits_media_id=1019469" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/04/15/86529e221aa8c5ffc75e1d47a11c1c70-69df1829b83aa.jpg?jadewits_media_id=1019469" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/04/15/86529e221aa8c5ffc75e1d47a11c1c70-69df1829b83aa.jpg?jadewits_media_id=1019469" style="max-width:100%;height:auto;margin-bottom:10px;" alt="স্বর্ণের দামে বড় পতন" /&gt;&lt;/p&gt;&lt;p&gt;দেশের বাজারে স্বর্ণের দাম একের পর এক কমছে। গত ১০ মাসের ব্যবধানে ২২ ক্যারেটের এক ভরি স্বর্ণের দাম কমেছে প্রায় ৯১ হাজার টাকা। সর্বশেষ সিদ্ধান্ত অনুযায়ী, আগামীকাল রবিবার (২২ নভেম্বর) থেকে ২২ ক্যারেটের এক ভরি স্বর্ণ বিক্রি হবে ১ লাখ ৯৪ হাজার ৯৬৪ টাকায়। অথচ চলতি বছরের ৩০ জানুয়ারি একই পরিমাণ স্বর্ণের দাম &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/business/industry-and-trade/982431/%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%AC%E0%A7%9C-%E0%A6%AA%E0%A6%A4%E0%A6%A8">বাংলা ট্রিবিউন</source>
    </item>

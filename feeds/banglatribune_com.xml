      <pubDate>Mon, 09 Nov 2026 05:02:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/af6da2fbcaf70f807c8e3c4bcd46d283-6af0eef697fa5.jpg?jadewits_media_id=1053961" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/af6da2fbcaf70f807c8e3c4bcd46d283-6af0eef697fa5.jpg?jadewits_media_id=1053961" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/af6da2fbcaf70f807c8e3c4bcd46d283-6af0eef697fa5.jpg?jadewits_media_id=1053961" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মহেশখালীতে হচ্ছে আরও ৩ এলএনজি টার্মিনাল: মুখ্য সচিব" /&gt;&lt;/p&gt;&lt;p&gt;প্রধানমন্ত্রীর মুখ্য সচিব এ বি এম আব্দুস সাত্তার বলেছেন, কক্সবাজারের মহেশখালীতে আরও তিনটি এলএনজি টার্মিনাল হচ্ছে।
রবিবার (৮ নভেম্বর) মহেশখালী সমন্বিত উন্নয়ন কর্তৃপক্ষের অধীন মাতারবাড়ীতে নির্মাণাধীন গভীর সমুদ্র বন্দর কয়লানির্ভর বিদ্যুৎ কেন্দ্র, ধলঘাটা মাতারবাড়ী রাজঘাট এলাকা পরিদর্শন শেষে ব্রিফিংয়ে এ &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/chitagong/979716/%E0%A6%AE%E0%A6%B9%E0%A7%87%E0%A6%B6%E0%A6%96%E0%A6%BE%E0%A6%B2%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A7%A9-%E0%A6%8F%E0%A6%B2%E0%A6%8F%E0%A6%A8%E0%A6%9C%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B2-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%8D%E0%A6%AF">বাংলা ট্রিবিউন</source>

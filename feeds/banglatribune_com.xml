    <item>
      <title>১৫ শিক্ষার্থীর চুল কেটে সমালোচনার মুখে প্রধান শিক্ষক, অভিভাবকদের ক্ষোভ: তদন্তের নির্দেশ</title>
      <link>https://www.banglatribune.com/country/rajshahi/979695/%E0%A7%A7%E0%A7%AB-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%B0-%E0%A6%9A%E0%A7%81%E0%A6%B2-%E0%A6%95%E0%A7%87%E0%A6%9F%E0%A7%87-%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A7%8B%E0%A6%9A%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/rajshahi/979695/%E0%A7%A7%E0%A7%AB-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%B0-%E0%A6%9A%E0%A7%81%E0%A6%B2-%E0%A6%95%E0%A7%87%E0%A6%9F%E0%A7%87-%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A7%8B%E0%A6%9A%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8</guid>
      <pubDate>Sun, 08 Nov 2026 22:42:46 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/c1e081e04e45f0fc40535e82e1f930a9-6af0a680465db.jpg?jadewits_media_id=1053943" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/c1e081e04e45f0fc40535e82e1f930a9-6af0a680465db.jpg?jadewits_media_id=1053943" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/c1e081e04e45f0fc40535e82e1f930a9-6af0a680465db.jpg?jadewits_media_id=1053943" style="max-width:100%;height:auto;margin-bottom:10px;" alt="১৫ শিক্ষার্থীর চুল কেটে সমালোচনার মুখে প্রধান শিক্ষক, অভিভাবকদের ক্ষোভ: তদন্তের নির্দেশ" /&gt;&lt;/p&gt;&lt;p&gt;নওগাঁর বদলগাছীতে একটি সরকারি প্রাথমিক বিদ্যালয়ের চতুর্থ ও পঞ্চম শ্রেণির অন্তত ১৫ শিক্ষার্থীর মাথার চুল কাঁচি দিয়ে খোপ খোপ করে কেটে দিয়েছেন প্রধান শিক্ষক শহিদুল ইসলাম। গতকাল শনিবার দুপুরে উপজেলার কোলা ইউনিয়নের কোলার পালশা সরকারি প্রাথমিক বিদ্যালয়ে এ ঘটনা ঘটে। এ ঘটনায় ক্ষুব্ধ হয়ে উঠেছেন অভিভাবকরা।&amp;nbs&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/rajshahi/979695/%E0%A7%A7%E0%A7%AB-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%B0-%E0%A6%9A%E0%A7%81%E0%A6%B2-%E0%A6%95%E0%A7%87%E0%A6%9F%E0%A7%87-%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A7%8B%E0%A6%9A%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8">বাংলা ট্রিবিউন</source>
    </item>

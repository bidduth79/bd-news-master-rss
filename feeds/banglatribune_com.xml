    <item>
      <title>মহাকাশ-ভিত্তিক কম্পিউটিং নেটওয়ার্ক গড়ে তুলছে চীন</title>
      <link>https://www.banglatribune.com/tech-and-gadget/980256/%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B6-%E0%A6%AD%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%95%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A6%89%E0%A6%9F%E0%A6%BF%E0%A6%82-%E0%A6%A8%E0%A7%87%E0%A6%9F%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95-%E0%A6%97%E0%A7%9C%E0%A7%87-%E0%A6%A4%E0%A7%81%E0%A6%B2%E0%A6%9B%E0%A7%87-%E0%A6%9A%E0%A7%80%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/tech-and-gadget/980256/%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B6-%E0%A6%AD%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%95%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A6%89%E0%A6%9F%E0%A6%BF%E0%A6%82-%E0%A6%A8%E0%A7%87%E0%A6%9F%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95-%E0%A6%97%E0%A7%9C%E0%A7%87-%E0%A6%A4%E0%A7%81%E0%A6%B2%E0%A6%9B%E0%A7%87-%E0%A6%9A%E0%A7%80%E0%A6%A8</guid>
      <pubDate>Wed, 11 Nov 2026 16:29:01 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/df04e5200dcba3abe7e16a0a7a18604f-6af44322c8308.jpg?jadewits_media_id=1054428" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/df04e5200dcba3abe7e16a0a7a18604f-6af44322c8308.jpg?jadewits_media_id=1054428" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/df04e5200dcba3abe7e16a0a7a18604f-6af44322c8308.jpg?jadewits_media_id=1054428" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মহাকাশ-ভিত্তিক কম্পিউটিং নেটওয়ার্ক গড়ে তুলছে চীন" /&gt;&lt;/p&gt;&lt;p&gt;স্যাটেলাইট থেকে পাওয়া তথ্য তাৎক্ষণিকভাবে প্রক্রিয়াকরণ এবং পৃথিবীর কক্ষপথে সুপার কম্পিউটিং সক্ষমতা গড়তে মহাকাশভিত্তিক কম্পিউটিং নেটওয়ার্ক তৈরি করছেন চীনা বিজ্ঞানী ও প্রকৌশলীরা। চীনের সংবাদ মাধ্যম চায়না টুডে এ খবর জানিয়েছে।
চীনা একাডেমি অব সায়েন্সেসের অ্যারোস্পেস ইনফরমেশন রিসার্চ ইনস্টিটিউটের নেত&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/tech-and-gadget/980256/%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B6-%E0%A6%AD%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%95%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A6%89%E0%A6%9F%E0%A6%BF%E0%A6%82-%E0%A6%A8%E0%A7%87%E0%A6%9F%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95-%E0%A6%97%E0%A7%9C%E0%A7%87-%E0%A6%A4%E0%A7%81%E0%A6%B2%E0%A6%9B%E0%A7%87-%E0%A6%9A%E0%A7%80%E0%A6%A8">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>গুমের পর ফিরে না আসা ২৮০ জনের মামলার তদন্ত শেষ পর্যায়ে</title>
      <link>https://www.banglatribune.com/law-and-crime/980255/%E0%A6%97%E0%A7%81%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A6%A8%E0%A6%BE-%E0%A6%86%E0%A6%B8%E0%A6%BE-%E0%A7%A8%E0%A7%AE%E0%A7%A6-%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%A4%E0%A6%A6%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%B6%E0%A7%87%E0%A6%B7</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/980255/%E0%A6%97%E0%A7%81%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A6%A8%E0%A6%BE-%E0%A6%86%E0%A6%B8%E0%A6%BE-%E0%A7%A8%E0%A7%AE%E0%A7%A6-%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%A4%E0%A6%A6%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%B6%E0%A7%87%E0%A6%B7</guid>
      <pubDate>Wed, 11 Nov 2026 16:26:13 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/d8382b993a3980f4be3767dd60b7d9de-6af4428aea9bf.jpg?jadewits_media_id=1054427" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/d8382b993a3980f4be3767dd60b7d9de-6af4428aea9bf.jpg?jadewits_media_id=1054427" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/d8382b993a3980f4be3767dd60b7d9de-6af4428aea9bf.jpg?jadewits_media_id=1054427" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গুমের পর ফিরে না আসা ২৮০ জনের মামলার তদন্ত শেষ পর্যায়ে" /&gt;&lt;/p&gt;&lt;p&gt;আওয়ামী লীগ সরকারের আমলে গুমের শিকার হওয়ার পর আর ফিরে না আসা ২৮০ জনের ঘটনায় দায়ের করা মামলার তদন্ত শেষ পর্যায়ে রয়েছে। যাচাই-বাছাই শেষে এ ঘটনায় আনুষ্ঠানিক অভিযোগ দাখিল করা হবে বলে জানিয়েছেন আন্তর্জাতিক অপরাধ ট্রাইব্যুনালের চিফ প্রসিকিউটর আমিনুল ইসলাম।
বুধবার (১১ নভেম্বর) গুমের শিকার ব্যক্তিদের পরিবারে&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/980255/%E0%A6%97%E0%A7%81%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A6%A8%E0%A6%BE-%E0%A6%86%E0%A6%B8%E0%A6%BE-%E0%A7%A8%E0%A7%AE%E0%A7%A6-%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%A4%E0%A6%A6%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%B6%E0%A7%87%E0%A6%B7">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>হাম উপসর্গে একদিনে ৬ জনের মৃত্যু</title>
      <link>https://www.banglatribune.com/health/980254/%E0%A6%B9%E0%A6%BE%E0%A6%AE-%E0%A6%89%E0%A6%AA%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A7%AC-%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81</link>
      <guid isPermaLink="true">https://www.banglatribune.com/health/980254/%E0%A6%B9%E0%A6%BE%E0%A6%AE-%E0%A6%89%E0%A6%AA%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A7%AC-%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81</guid>
      <pubDate>Wed, 11 Nov 2026 16:12:26 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/08/10/f6ee68cc9a3520685f63a2d1c8da252b-6a79beae86b0b.jpg?jadewits_media_id=1037806" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/08/10/f6ee68cc9a3520685f63a2d1c8da252b-6a79beae86b0b.jpg?jadewits_media_id=1037806" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/08/10/f6ee68cc9a3520685f63a2d1c8da252b-6a79beae86b0b.jpg?jadewits_media_id=1037806" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হাম উপসর্গে একদিনে ৬ জনের মৃত্যু" /&gt;&lt;/p&gt;&lt;p&gt;দেশে গত ২৪ ঘণ্টায় হামের উপসর্গ নিয়ে আরও ছয় জনের মৃত্যু হয়েছে। মঙ্গলবার (১০ নভেম্বর) সকাল ৮টা থেকে বুধবার (১১ নভেম্বর) সকাল ৮টার মধ্যে এই মৃত্যুর ঘটনা ঘটে। তবে এই সময়ের মধ্যে নিশ্চিত হামে কারও মৃত্যু হয়নি। একই সময়ের মধ্যে হাম ও হামের উপসর্গে আক্রান্ত হয়েছে ১ হাজার ৪৬৪ জন।
স্বাস্থ্য অধিদফতরের এক সংবাদ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/health/980254/%E0%A6%B9%E0%A6%BE%E0%A6%AE-%E0%A6%89%E0%A6%AA%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A7%AC-%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ইরান যুদ্ধের খরচ শোধ করতে হবে ইসরায়েল ও উপসাগরীয় মিত্রদের: ট্রাম্প</title>
      <link>https://www.banglatribune.com/foreign/america/980253/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A6%96%E0%A6%B0%E0%A6%9A-%E0%A6%B6%E0%A7%8B%E0%A6%A7-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%AC%E0%A7%87-%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%B2-%E0%A6%93-%E0%A6%89%E0%A6%AA%E0%A6%B8%E0%A6%BE%E0%A6%97%E0%A6%B0%E0%A7%80%E0%A6%AF%E0%A6%BC</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/america/980253/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A6%96%E0%A6%B0%E0%A6%9A-%E0%A6%B6%E0%A7%8B%E0%A6%A7-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%AC%E0%A7%87-%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%B2-%E0%A6%93-%E0%A6%89%E0%A6%AA%E0%A6%B8%E0%A6%BE%E0%A6%97%E0%A6%B0%E0%A7%80%E0%A6%AF%E0%A6%BC</guid>
      <pubDate>Wed, 11 Nov 2026 16:10:05 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/9761b3821005bcd1d66a2bb5db7288f1-6af43e3bade78.jpg?jadewits_media_id=1054425" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/9761b3821005bcd1d66a2bb5db7288f1-6af43e3bade78.jpg?jadewits_media_id=1054425" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/9761b3821005bcd1d66a2bb5db7288f1-6af43e3bade78.jpg?jadewits_media_id=1054425" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইরান যুদ্ধের খরচ শোধ করতে হবে ইসরায়েল ও উপসাগরীয় মিত্রদের: ট্রাম্প" /&gt;&lt;/p&gt;&lt;p&gt;ইরান যুদ্ধে যেসব দেশকে যুক্তরাষ্ট্র রক্ষা করেছে, তাদের কাছ থেকে ক্ষতিপূরণ চাইবে ওয়াশিংটন, জানিয়েছেন প্রেসিডেন্ট ডোনাল্ড ট্রাম্প। রবিবার প্রচারিত সিবিএস নিউজের সাক্ষাৎকারে উপস্থাপক রস ডাউথাটকে তিনি বলেন, ওই দেশগুলো যুদ্ধে যুক্তরাষ্ট্রের যাবতীয় খরচ মিটিয়ে দেবে।
ট্রাম্প বলেন, আমরা এই সব টাকা ফেরত প&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/america/980253/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A6%96%E0%A6%B0%E0%A6%9A-%E0%A6%B6%E0%A7%8B%E0%A6%A7-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%AC%E0%A7%87-%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%B2-%E0%A6%93-%E0%A6%89%E0%A6%AA%E0%A6%B8%E0%A6%BE%E0%A6%97%E0%A6%B0%E0%A7%80%E0%A6%AF%E0%A6%BC">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>বিশ্ববিদ্যালয় শিক্ষার্থী ও তার মাকে হত্যা, সেই কবিরাজের মৃত্যুদণ্ড</title>

    <item>
      <title>নারী শিক্ষার্থীকে হেনস্তার অভিযোগ, ঢাবিতে ঠিকানা পরিবহনের ২০ বাস আটক</title>
      <link>https://www.banglatribune.com/others/983764/%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A7%87%E0%A6%A8%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%A2%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%A0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%A8%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/others/983764/%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A7%87%E0%A6%A8%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%A2%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%A0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%A8%E0%A6%BE</guid>
      <pubDate>Sat, 28 Nov 2026 14:42:38 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/dc4676c00672d8689ce2376978582129-6b0a90349da52.jpg?jadewits_media_id=1057443" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/dc4676c00672d8689ce2376978582129-6b0a90349da52.jpg?jadewits_media_id=1057443" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/dc4676c00672d8689ce2376978582129-6b0a90349da52.jpg?jadewits_media_id=1057443" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নারী শিক্ষার্থীকে হেনস্তার অভিযোগ, ঢাবিতে ঠিকানা পরিবহনের ২০ বাস আটক" /&gt;&lt;/p&gt;&lt;p&gt;ঢাকা বিশ্ববিদ্যালয়ের (ঢাবি) এক নারী শিক্ষার্থীর সঙ্গে শিক্ষার্থী ভাড়া নিয়ে বিরোধের জেরে অসদাচরণ ও হেনস্তার অভিযোগ উঠেছে ঠিকানা পরিবহনের কর্মীদের বিরুদ্ধে। শুক্রবার (২৭ নভেম্বর) এ ঘটনা ঘটে। এর প্রতিবাদে ও বিচারের দাবিতে শনিবার (২৮ নভেম্বর) পরিবহনটির ২০টি বাস আটকে রেখেছেন বিশ্ববিদ্যালয়ের শিক্ষার্থীরা।&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/others/983764/%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A7%87%E0%A6%A8%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%A2%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%A0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%A8%E0%A6%BE">বাংলা ট্রিবিউন</source>

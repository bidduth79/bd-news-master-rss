      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/865e777848cc0c2181f0682efd7241e6-6b09e193995bc.jpg?jadewits_media_id=1057360" length="0" type="image/jpeg" />

    <item>
      <title>খুলনার সন্ত্রাস নির্মূলে কঠোর ব্যবস্থা নেওয়ার নির্দেশ প্রধানমন্ত্রীর</title>
      <link>https://www.banglatribune.com/politics/bnp/981171/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B8-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%82%E0%A6%B2%E0%A7%87-%E0%A6%95%E0%A6%A0%E0%A7%8B%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE-%E0%A6%A8%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/politics/bnp/981171/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B8-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%82%E0%A6%B2%E0%A7%87-%E0%A6%95%E0%A6%A0%E0%A7%8B%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE-%E0%A6%A8%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Mon, 16 Nov 2026 03:21:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/05/11/da2c5e3b0a2a42215fc5d15457ce1899-6a019c0b350cf.jpg?jadewits_media_id=1023254" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/05/11/da2c5e3b0a2a42215fc5d15457ce1899-6a019c0b350cf.jpg?jadewits_media_id=1023254" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/05/11/da2c5e3b0a2a42215fc5d15457ce1899-6a019c0b350cf.jpg?jadewits_media_id=1023254" style="max-width:100%;height:auto;margin-bottom:10px;" alt="খুলনার সন্ত্রাস নির্মূলে কঠোর ব্যবস্থা নেওয়ার নির্দেশ প্রধানমন্ত্রীর" /&gt;&lt;/p&gt;&lt;p&gt;খুলনার অবনতিশীল আইনশৃঙ্খলা পরিস্থিতি স্বাভাবিক করতে কঠোর পদক্ষেপ নেওয়ার নির্দেশ দিয়েছেন প্রধানমন্ত্রী তারেক রহমান। খুন, চাঁদাবাজি, লুটপাট ও ভাঙচুর বন্ধে কোনও ধরনের ছাড় না দিয়ে অপরাধী চক্রের নেটওয়ার্ক ভেঙে ফেলার সিদ্ধান্ত হয়েছে। সন্ত্রাসীদের চিহ্নিত করতে বিশেষ উদ্যোগে একাধিক দল কাজ শুরু করেছে।
শনিবার&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/politics/bnp/981171/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B8-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%82%E0%A6%B2%E0%A7%87-%E0%A6%95%E0%A6%A0%E0%A7%8B%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE-%E0%A6%A8%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>এবার সেই কুরিয়ারের ওয়্যারহাউসে হামলা চালিয়ে লুটপাট, দুই গাড়িতে আগুন</title>
      <link>https://www.banglatribune.com/others/capital-city/981170/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%87%E0%A6%87-%E0%A6%95%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A7%9F%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A6%B9%E0%A6%BE%E0%A6%89%E0%A6%B8%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/others/capital-city/981170/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%87%E0%A6%87-%E0%A6%95%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A7%9F%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A6%B9%E0%A6%BE%E0%A6%89%E0%A6%B8%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A7%87</guid>
      <pubDate>Mon, 16 Nov 2026 02:42:07 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/21cf1adfad191c0195f71b644276b53c-6afa1910b9742.jpg?jadewits_media_id=1055198" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/21cf1adfad191c0195f71b644276b53c-6afa1910b9742.jpg?jadewits_media_id=1055198" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/21cf1adfad191c0195f71b644276b53c-6afa1910b9742.jpg?jadewits_media_id=1055198" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এবার সেই কুরিয়ারের ওয়্যারহাউসে হামলা চালিয়ে লুটপাট, দুই গাড়িতে আগুন" /&gt;&lt;/p&gt;&lt;p&gt;এজেআর কুরিয়ার সার্ভিসের&amp;nbsp; আবারও হামলা, ভাঙচুর, লুটপাট ও দুটি পরিবহনে আগুন দিয়েছে সন্ত্রাসীরা। রবিবার (১৫ নভেম্বর) রাত ১০টার কিছু পর হাজারীবাগ শাখায় এ ঘটনা ঘটে।
এর আগে বিকাল ৪টার দিকে মোহাম্মদপুরে হামলা ও ভাঙচুরের ঘটনা ঘটে। ৬ ঘণ্টার ব্যবধানে দুটো হামলার ঘটনা ঘটলো।
জানা গেছে, রবিবার রাত ১০টার দিকে&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/others/capital-city/981170/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%87%E0%A6%87-%E0%A6%95%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A7%9F%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A6%B9%E0%A6%BE%E0%A6%89%E0%A6%B8%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>এবার গোপালগঞ্জের ৩ থানার ওসি বদলি</title>
      <link>https://www.banglatribune.com/country/dhaka/981169/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A7%A9-%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%93%E0%A6%B8%E0%A6%BF-%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/dhaka/981169/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A7%A9-%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%93%E0%A6%B8%E0%A6%BF-%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A6%BF</guid>
      <pubDate>Mon, 16 Nov 2026 02:19:22 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/8cdb412d9039ed0a7d73673894ead3f4-6afa13b499aa0.jpg?jadewits_media_id=1055197" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/8cdb412d9039ed0a7d73673894ead3f4-6afa13b499aa0.jpg?jadewits_media_id=1055197" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/8cdb412d9039ed0a7d73673894ead3f4-6afa13b499aa0.jpg?jadewits_media_id=1055197" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এবার গোপালগঞ্জের ৩ থানার ওসি বদলি" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জের জেলা প্রশাসক ও পুলিশ সুপারকে বদলির পর জেলার তিনটি থানার ওসি বদলি করা হয়েছে। রবিবার (১৫ নভেম্বর) রাতে ঢাকা রেঞ্জের ডিআইজি মো. মোস্তাফিজুর রহমান স্বাক্ষরিত এক পত্রে এ তথ্য জানা গেছে।
বদলি করা ওসিরা হলেন- টুঙ্গিপাড়া থানার ওসি আইয়ুব আলী, কোটালীপাড়া থানার ওসি রিয়াদ মাহমুদ ও কাশিয়ানী থানার ওসি&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/dhaka/981169/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A7%A9-%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%93%E0%A6%B8%E0%A6%BF-%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A6%BF">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>বিএনপি ও অঙ্গসংগঠনের শীর্ষ নেতাদের নিয়ে প্রধানমন্ত্রীর বৈঠক, যে নির্দেশ দিলেন</title>
      <link>https://www.banglatribune.com/politics/bnp/981168/%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%93-%E0%A6%85%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%B8%E0%A6%82%E0%A6%97%E0%A6%A0%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A7%80%E0%A6%B0%E0%A7%8D%E0%A6%B7-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/politics/bnp/981168/%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%93-%E0%A6%85%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%B8%E0%A6%82%E0%A6%97%E0%A6%A0%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A7%80%E0%A6%B0%E0%A7%8D%E0%A6%B7-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87</guid>
      <pubDate>Mon, 16 Nov 2026 02:03:09 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/04/29/e53409687394320a71568bef9fbe2946-69f1b79bb0805.jpg?jadewits_media_id=1021441" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/04/29/e53409687394320a71568bef9fbe2946-69f1b79bb0805.jpg?jadewits_media_id=1021441" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/04/29/e53409687394320a71568bef9fbe2946-69f1b79bb0805.jpg?jadewits_media_id=1021441" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিএনপি ও অঙ্গসংগঠনের শীর্ষ নেতাদের নিয়ে প্রধানমন্ত্রীর বৈঠক, যে নির্দেশ দিলেন" /&gt;&lt;/p&gt;&lt;p&gt;বিজয়ের মাস ডিসেম্বরকে সামনে রেখে রাজনৈতিক কর্মসূচি নিয়ে নেতাকর্মীদের ব্যস্ত রাখার সিদ্ধান্ত নিয়েছে ক্ষমতাসীন বিএনপি। এরই আলোকে মূল দলের পাশাপাশি সহযোগী সংগঠন ছাত্রদল, যুবদল ও স্বেচ্ছাসেবক দলকে মাঠে নামার নির্দেশ দিয়েছেন দলীয় চেয়ারম্যান ও প্রধানমন্ত্রী তারেক রহমান।
রবিবার (১৫ নভেম্বর) রাতে জাতীয় সংসদ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/politics/bnp/981168/%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%93-%E0%A6%85%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%B8%E0%A6%82%E0%A6%97%E0%A6%A0%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A7%80%E0%A6%B0%E0%A7%8D%E0%A6%B7-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>এবার খুলনা নগর ভবনে পেট্রোল বোমা নিক্ষেপ, ধরে গেছে আগুন</title>
      <link>https://www.banglatribune.com/country/khulna/981167/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE-%E0%A6%A8%E0%A6%97%E0%A6%B0-%E0%A6%AD%E0%A6%AC%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B2-%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA-%E0%A6%A7%E0%A6%B0%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%9B%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/khulna/981167/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE-%E0%A6%A8%E0%A6%97%E0%A6%B0-%E0%A6%AD%E0%A6%AC%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B2-%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA-%E0%A6%A7%E0%A6%B0%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%9B%E0%A7%87</guid>
      <pubDate>Mon, 16 Nov 2026 01:32:13 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/af50e7347fa2b019890e824d56fcc106-6afa08a4d6107.jpg?jadewits_media_id=1055196" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/af50e7347fa2b019890e824d56fcc106-6afa08a4d6107.jpg?jadewits_media_id=1055196" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/af50e7347fa2b019890e824d56fcc106-6afa08a4d6107.jpg?jadewits_media_id=1055196" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এবার খুলনা নগর ভবনে পেট্রোল বোমা নিক্ষেপ, ধরে গেছে আগুন" /&gt;&lt;/p&gt;&lt;p&gt;এবার খুলনা নগর ভবনে পেট্রোল বোমা নিক্ষেপ করেছে দুর্বৃত্তরা। নিক্ষিপ্ত বোমাটি নগর ভবনের সামনের বড় সিঁড়ির মাঝে পড়ে বিস্ফোরিত হয়। সঙ্গে সঙ্গে আগুন ছড়িয়ে পড়েছে।
রবিবার (১৫ নভেম্বর) দিনগত রাত সাড়ে ১২টার দিকে এ ঘটনা ঘটে। তবে এই ঘটনায় কোনও ক্ষয়ক্ষতির খবর পাওয়া যায়নি। নিরাপত্তারক্ষীরা দ্রুত আগুন নিভিয়ে ফেলে&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/khulna/981167/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE-%E0%A6%A8%E0%A6%97%E0%A6%B0-%E0%A6%AD%E0%A6%AC%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B2-%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA-%E0%A6%A7%E0%A6%B0%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%9B%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>এবার আরেক জেলা শহরে ‘জয় বাংলা’ স্লোগান দিয়ে শতাধিক রাউন্ড গুলি নিক্ষেপ</title>

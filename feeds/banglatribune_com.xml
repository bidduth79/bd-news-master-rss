    </item>
    <item>
      <title>আমু-শাজাহানসহ ৬ নেতা কারাগারে, মির্জা আজমকে নিয়ে বিজ্ঞপ্তির নির্দেশ</title>
      <link>https://www.banglatribune.com/law-and-crime/982526/%E0%A6%86%E0%A6%AE%E0%A7%81-%E0%A6%B6%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%A8%E0%A6%B8%E0%A6%B9-%E0%A7%AC-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%97%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A6%BE-%E0%A6%86%E0%A6%9C%E0%A6%AE%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/982526/%E0%A6%86%E0%A6%AE%E0%A7%81-%E0%A6%B6%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%A8%E0%A6%B8%E0%A6%B9-%E0%A7%AC-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%97%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A6%BE-%E0%A6%86%E0%A6%9C%E0%A6%AE%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87</guid>
      <pubDate>Sun, 22 Nov 2026 16:48:42 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/b70c0caa4ff75a66ce9ace4514d39366-6b02c85a48066.jpg?jadewits_media_id=1056349" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/b70c0caa4ff75a66ce9ace4514d39366-6b02c85a48066.jpg?jadewits_media_id=1056349" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/b70c0caa4ff75a66ce9ace4514d39366-6b02c85a48066.jpg?jadewits_media_id=1056349" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আমু-শাজাহানসহ ৬ নেতা কারাগারে, মির্জা আজমকে নিয়ে বিজ্ঞপ্তির নির্দেশ" /&gt;&lt;/p&gt;&lt;p&gt;চব্বিশের জুলাই-আগস্ট গণঅভ্যুত্থানের সময় সংঘটিত মানবতাবিরোধী অপরাধের মামলায় আওয়ামী লীগের সভাপতিমণ্ডলীর সদস্য আমির হোসেন আমুসহ ছয় জনকে গ্রেফতার দেখিয়ে কারাগারে পাঠানোর নির্দেশ দিয়েছেন আন্তর্জাতিক অপরাধ ট্রাইব্যুনাল। একই মামলায় আওয়ামী লীগের সাংগঠনিক সম্পাদক মির্জা আজমকে হাজির করতে দুটি জাতীয় দৈনিক পত্র&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/982526/%E0%A6%86%E0%A6%AE%E0%A7%81-%E0%A6%B6%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%A8%E0%A6%B8%E0%A6%B9-%E0%A7%AC-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%97%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A6%BE-%E0%A6%86%E0%A6%9C%E0%A6%AE%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>শিক্ষাপ্রতিষ্ঠানকে বেকার তৈরির কারখানা বানানো যাবে না: শিক্ষামন্ত্রী</title>

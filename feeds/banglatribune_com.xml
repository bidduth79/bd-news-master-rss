      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/09/15/e5e379af8648db20d90418d77f521e07-6aa968db3c327.jpg?jadewits_media_id=1043942" length="0" type="image/jpeg" />

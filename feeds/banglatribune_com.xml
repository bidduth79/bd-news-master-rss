    <item>
      <title>ঢাবিতে ছাত্রশক্তির বিক্ষোভ, স্বরাষ্ট্রমন্ত্রীর পদত্যাগ দাবি</title>
      <link>https://www.banglatribune.com/politics/ncp/980147/%E0%A6%A2%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8B%E0%A6%AD-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/politics/ncp/980147/%E0%A6%A2%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8B%E0%A6%AD-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0</guid>
      <pubDate>Wed, 11 Nov 2026 01:08:54 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/25d445e04fab414884aeaa319a18f262-6af36b102681b.jpg?jadewits_media_id=1054325" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/25d445e04fab414884aeaa319a18f262-6af36b102681b.jpg?jadewits_media_id=1054325" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/25d445e04fab414884aeaa319a18f262-6af36b102681b.jpg?jadewits_media_id=1054325" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঢাবিতে ছাত্রশক্তির বিক্ষোভ, স্বরাষ্ট্রমন্ত্রীর পদত্যাগ দাবি" /&gt;&lt;/p&gt;&lt;p&gt;সারা দেশে আওয়ামী লীগের নাশকতা, অগ্নিসংযোগ ও ককটেল বিস্ফোরণের প্রতিবাদ এবং ঢাকা বিশ্ববিদ্যালয় (ঢাবি) শাখা জাতীয় ছাত্রশক্তির সভাপতি হাসিবুল ইসলামের ওপর হামলার ঘটনায় বিক্ষোভ মিছিল ও সমাবেশ করেছেন সংগঠনটির নেতাকর্মীরা। সমাবেশ থেকে স্বরাষ্ট্রমন্ত্রী সালাহউদ্দিন আহমেদের পদত্যাগ দাবি করা হয়েছে। একইসঙ্গে সা&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/politics/ncp/980147/%E0%A6%A2%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8B%E0%A6%AD-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ককটেল-বাসে আগুনে আতঙ্ক, রাস্তায় নামতে ভয়</title>
      <link>https://www.banglatribune.com/law-and-crime/980125/%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%A4%E0%A6%99%E0%A7%8D%E0%A6%95-%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A6%A4%E0%A7%87%E0%A6%87-%E0%A6%AD%E0%A7%9F</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/980125/%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%A4%E0%A6%99%E0%A7%8D%E0%A6%95-%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A6%A4%E0%A7%87%E0%A6%87-%E0%A6%AD%E0%A7%9F</guid>
      <pubDate>Wed, 11 Nov 2026 00:11:32 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/147109206c9d48cce355468a73487e9b-6af33dda53689.jpg?jadewits_media_id=1054307" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/147109206c9d48cce355468a73487e9b-6af33dda53689.jpg?jadewits_media_id=1054307" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/147109206c9d48cce355468a73487e9b-6af33dda53689.jpg?jadewits_media_id=1054307" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ককটেল-বাসে আগুনে আতঙ্ক, রাস্তায় নামতে ভয়" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানী থেকে শুরু করে দেশের বিভিন্ন জেলায় একের পর এক ককটেল বিস্ফোরণ, বাসে অগ্নিসংযোগ ও নাশকতার ঘটনায় জনজীবনে দেখা দিয়েছে নিরাপত্তাহীনতা। এরই মধ্যে ফরিদপুরে বাসে আগুনে প্রাণ গেছে ঘুমন্ত চালকের। কোথাও চলন্ত গাড়ি লক্ষ্য করে ককটেল ছোড়া হচ্ছে, কোথাও মহাসড়কে আগুন জ্বালিয়ে যান চলাচলে বাধা দেওয়া হচ্ছে। এমন &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/980125/%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%A4%E0%A6%99%E0%A7%8D%E0%A6%95-%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A6%A4%E0%A7%87%E0%A6%87-%E0%A6%AD%E0%A7%9F">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>বেগম রোকেয়া বিশ্ববিদ্যালয়ে ৩৫ পদে নিয়োগ</title>

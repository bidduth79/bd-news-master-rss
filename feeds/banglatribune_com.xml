      <guid isPermaLink="true">https://www.banglatribune.com/country/dhaka/979928/%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%B8%E0%A7%82%E0%A6%9A%E0%A6%BF%E0%A6%B0-%E0%A7%AB%E0%A7%A6%E0%A7%A6-%E0%A6%AA%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%95%E0%A7%87%E0%A6%9F</guid>
      <pubDate>Tue, 10 Nov 2026 02:05:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/54f175528c58ef58cf355c676a795ff3-6af219cc2276a.jpg?jadewits_media_id=1054138" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/54f175528c58ef58cf355c676a795ff3-6af219cc2276a.jpg?jadewits_media_id=1054138" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/54f175528c58ef58cf355c676a795ff3-6af219cc2276a.jpg?jadewits_media_id=1054138" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কার্যক্রম নিষিদ্ধ আ.লীগের কর্মসূচির ৫০০ প্যাকেট খিচুড়ি জব্দ" /&gt;&lt;/p&gt;&lt;p&gt;শরীয়তপুরের জাজিরা উপজেলার নাওডোবা বাজারের একটি দোকান থেকে ৫০০ প্যাকেট রান্না করা খিচুড়ি জব্দ করেছে পদ্মা সেতু (দক্ষিণ) থানা পুলিশ। মঙ্গলবার (১০ নভেম্বর) কার্যক্রম নিষিদ্ধ আওয়ামী লীগ ও নিষিদ্ধ ছাত্রলীগের ঘোষিত কর্মসূচিতে অংশ নেওয়া নেতাকর্মীদের খাবার হিসেবে এসব খিচুড়ি ব্যবহার করা হতে পারে বলে ধারণা পু&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/dhaka/979928/%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%B8%E0%A7%82%E0%A6%9A%E0%A6%BF%E0%A6%B0-%E0%A7%AB%E0%A7%A6%E0%A7%A6-%E0%A6%AA%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%95%E0%A7%87%E0%A6%9F">বাংলা ট্রিবিউন</source>

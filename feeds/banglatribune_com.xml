    <item>
      <title>পাঁচ বছর পর তৃতীয় লিঙ্গের সদস্য জোসু হত্যার রহস্য উদঘাটন</title>
      <link>https://www.banglatribune.com/law-and-crime/982074/%E0%A6%AA%E0%A6%BE%E0%A6%81%E0%A6%9A-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%A4%E0%A7%83%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%B2%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF-%E0%A6%9C%E0%A7%8B%E0%A6%B8%E0%A7%81-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A6%B9%E0%A6%B8%E0%A7%8D%E0%A6%AF</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/982074/%E0%A6%AA%E0%A6%BE%E0%A6%81%E0%A6%9A-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%A4%E0%A7%83%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%B2%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF-%E0%A6%9C%E0%A7%8B%E0%A6%B8%E0%A7%81-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A6%B9%E0%A6%B8%E0%A7%8D%E0%A6%AF</guid>
      <pubDate>Fri, 20 Nov 2026 04:28:01 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/b322fdb23f194ef2e6755aedf6afa174-6aff76972ae9f.jpg?jadewits_media_id=1055944" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/b322fdb23f194ef2e6755aedf6afa174-6aff76972ae9f.jpg?jadewits_media_id=1055944" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/b322fdb23f194ef2e6755aedf6afa174-6aff76972ae9f.jpg?jadewits_media_id=1055944" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পাঁচ বছর পর তৃতীয় লিঙ্গের সদস্য জোসু হত্যার রহস্য উদঘাটন" /&gt;&lt;/p&gt;&lt;p&gt;হত্যাকাণ্ডের পাঁচ বছর পর তৃতীয় লিঙ্গের সদস্য বাদল মিয়া ওরফে জোসু (৪০) হত্যার রহস্য উদঘাটন করেছে পুলিশ ব্যুরো অব ইনভেস্টিগেশন (পিবিআই)। এ ঘটনায় জড়িত থাকার অভিযোগে মো. শাওন আহম্মেদ সুজন (২৮) নামে একজনকে গ্রেফতার করা হয়েছে। গ্রেফতারের পর তিনি আদালতে হত্যার দায় স্বীকার করে জবানবন্দি দিয়েছেন।
পিবিআইয়ের ত&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/982074/%E0%A6%AA%E0%A6%BE%E0%A6%81%E0%A6%9A-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%A4%E0%A7%83%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%B2%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF-%E0%A6%9C%E0%A7%8B%E0%A6%B8%E0%A7%81-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A6%B9%E0%A6%B8%E0%A7%8D%E0%A6%AF">বাংলা ট্রিবিউন</source>

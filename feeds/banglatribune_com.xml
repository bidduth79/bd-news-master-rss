      <guid isPermaLink="true">https://www.banglatribune.com/national/979988/%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%B8%E0%A6%BF%E0%A6%87%E0%A6%AA%E0%A6%BF%E0%A6%8F%E2%80%99%E0%A6%B0-%E0%A6%96%E0%A6%B8%E0%A7%9C%E0%A6%BE-%E0%A6%9A%E0%A7%82%E0%A7%9C%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A6%AE%E0%A6%A4</guid>
      <pubDate>Tue, 10 Nov 2026 13:32:29 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/c91ef542a56ae93cfb80612a39a2044f-6af2c881e4d64.jpg?jadewits_media_id=1054185" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/c91ef542a56ae93cfb80612a39a2044f-6af2c881e4d64.jpg?jadewits_media_id=1054185" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/c91ef542a56ae93cfb80612a39a2044f-6af2c881e4d64.jpg?jadewits_media_id=1054185" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডিসেম্বরের মধ্যে সিইপিএ’র খসড়া চূড়ান্ত করতে একমত বাংলাদেশ-দক্ষিণ কোরিয়া" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ ও দক্ষিণ কোরিয়ার মধ্যে বিস্তৃত অর্থনৈতিক অংশীদারত্ব চুক্তির (সিইপিএ) খসড়া আগামী ডিসেম্বরের মধ্যে চূড়ান্ত করার বিষয়ে একমত হয়েছে দুই দেশ। খসড়া চূড়ান্ত হওয়ার পর উচ্চপর্যায়ে আনুষ্ঠানিক স্বাক্ষরের প্রস্তুতি নেওয়া হবে।
মঙ্গলবার (১০ নভেম্বর) সচিবালয়ে বাণিজ্যমন্ত্রী খন্দকার আব্দুল মুক্তাদিরের সঙ্গে&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/979988/%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%B8%E0%A6%BF%E0%A6%87%E0%A6%AA%E0%A6%BF%E0%A6%8F%E2%80%99%E0%A6%B0-%E0%A6%96%E0%A6%B8%E0%A7%9C%E0%A6%BE-%E0%A6%9A%E0%A7%82%E0%A7%9C%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A6%AE%E0%A6%A4">বাংলা ট্রিবিউন</source>
    </item>
    <item>

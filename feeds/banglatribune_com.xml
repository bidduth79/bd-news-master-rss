      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/983697/%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A6%9A%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B2%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%BE%E0%A6%B6%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3</guid>
      <pubDate>Sat, 28 Nov 2026 04:04:55 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/dbda0141b7f16dc7e7509beb718c98f5-6af1c9a6eb772.jpg?jadewits_media_id=1054073" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/dbda0141b7f16dc7e7509beb718c98f5-6af1c9a6eb772.jpg?jadewits_media_id=1054073" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/dbda0141b7f16dc7e7509beb718c98f5-6af1c9a6eb772.jpg?jadewits_media_id=1054073" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মধ্যরাতে সচিবালয়ের পাশে দুই ককটেল বিস্ফোরণ" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর তোপখানা রো&amp;zwnj;ডের সচিবালয়ের পাশে মেট্রো স্টেশনের নিচে দুটি ককটেল বিস্ফোরণ ঘটিয়েছে দুর্বৃত্তরা।
শুক্রবার (২৭ নভেম্বর) দিবাগত রাত ১টা ৩৭ মিনিটের দিকে এই ঘটনা ঘটে।
শাহবাগ থানার এসআই আশরাফ আলী জানান, রাত ১টা ৩৭ মিনিটের দিকে প্রেসক্লাবের পূর্ব পাশে মেট্রো স্টেশনের নিচে ককটেল বিস্ফোরণের ঘটন&lt;/p&gt;</description>

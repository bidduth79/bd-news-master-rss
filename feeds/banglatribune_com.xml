    <item>
      <title>রাজধানীতে গাড়ির ধাক্কায় দুই মোটরসাইকেল আরোহী নিহত</title>
      <link>https://www.banglatribune.com/others/capital-city/980743/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%97%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%B0-%E0%A6%A7%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%AE%E0%A7%8B%E0%A6%9F%E0%A6%B0%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%87%E0%A6%B2-%E0%A6%86%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A7%80-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4</link>
      <guid isPermaLink="true">https://www.banglatribune.com/others/capital-city/980743/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%97%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%B0-%E0%A6%A7%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%AE%E0%A7%8B%E0%A6%9F%E0%A6%B0%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%87%E0%A6%B2-%E0%A6%86%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A7%80-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4</guid>
      <pubDate>Fri, 13 Nov 2026 19:53:06 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/ed47477d63f17b9a161a48be6890fa26-6af715ca2379d.jpg?jadewits_media_id=1054843" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/ed47477d63f17b9a161a48be6890fa26-6af715ca2379d.jpg?jadewits_media_id=1054843" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/ed47477d63f17b9a161a48be6890fa26-6af715ca2379d.jpg?jadewits_media_id=1054843" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজধানীতে গাড়ির ধাক্কায় দুই মোটরসাইকেল আরোহী নিহত" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর বিমানবন্দর এলাকায় পাজারো জিপের ধাক্কায় দুই মোটরসাইকেল আরোহী নিহত হয়েছেন। তারা হলেন মোবারক হোসেন রাজু (২৪) ও ফরিদুল ইসলাম সরদার। তারা পেশায় নির্মাণশ্রমিক বলে জানা গেছে।
শুক্রবার (১৩ নভেম্বর) দুপুর ২টার দিকে বিমানবন্দর এলাকার স্কলাস্টিকা স্কুলের সামনে এ দুর্ঘটনা ঘটে।&amp;nbsp;
দুর্ঘটনার পর গুরুত&lt;/p&gt;</description>

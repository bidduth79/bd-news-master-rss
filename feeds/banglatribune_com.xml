      <link>https://www.banglatribune.com/country/chitagong/982641/%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%93-%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A7%9F</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/chitagong/982641/%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%93-%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A7%9F</guid>
      <pubDate>Mon, 23 Nov 2026 05:36:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/56a216e7da960dcf2b1edd23f536c8db-6b0361f3f2f67.jpg?jadewits_media_id=1056443" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/56a216e7da960dcf2b1edd23f536c8db-6b0361f3f2f67.jpg?jadewits_media_id=1056443" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/56a216e7da960dcf2b1edd23f536c8db-6b0361f3f2f67.jpg?jadewits_media_id=1056443" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এনসিপি নেতাকে গ্রেফতারের পর পুলিশের ওপর ও থানায় হামলা, ৭ পুলিশ আহত" /&gt;&lt;/p&gt;&lt;p&gt;ব্রাহ্মণবাড়িয়ার আখাউড়ায় বিস্ফোরক মামলার এজাহারভুক্ত আসামি ও উপজেলা জাতীয় নাগরিক পার্টির (এনসিপি) যুগ্ম আহ্বায়ক ছায়েব আলীকে গ্রেফতার করেছে পুলিশ। তার গ্রেফতারকে কেন্দ্র করে আখাউড়া থানায় হামলা, বিক্ষোভ ও পুলিশের সঙ্গে সংঘর্ষের ঘটনা ঘটেছে। এতে অন্তত সাত পুলিশ সদস্য আহত হয়েছেন। পরে বিএনপির অঙ্গ ও সহযোগী&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/chitagong/982641/%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%93-%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A7%9F">বাংলা ট্রিবিউন</source>

      <guid isPermaLink="true">https://www.banglatribune.com/politics/jamat-e-islam/983776/%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A8%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%95%E0%A6%BF-%E0%A6%8F%E0%A6%B2%E0%A7%87%E0%A6%93-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Sat, 28 Nov 2026 15:19:01 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/b810ee3e8d2940362d2227853fe0c8f7-6b0a9c504551d.jpg?jadewits_media_id=1057451" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/b810ee3e8d2940362d2227853fe0c8f7-6b0a9c504551d.jpg?jadewits_media_id=1057451" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/b810ee3e8d2940362d2227853fe0c8f7-6b0a9c504551d.jpg?jadewits_media_id=1057451" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভারত থেকে বাংলাদেশ নিয়ে নেওয়ার হুমকি এলেও সরকারের অবস্থান দেখছে না জামায়াত" /&gt;&lt;/p&gt;&lt;p&gt;ভারত থেকে বাংলাদেশ নিয়ে নেওয়ার কথা বলা হচ্ছে, হুমকি দেওয়া হচ্ছে, এ নিয়ে সরকারের কোনও অবস্থান দেখছে না জামায়াতে ইসলামী&amp;mdash; এমন মন্তব্য করেছেন দলটির আমির ডা. শফিকুর রহমান।
শনিবার (২৮ নভেম্বর) সকালে রাজধানীর মগবাজারে দলের কেন্দ্রীয় মজলিসে শূরার অধিবেশনে তিনি এ মন্তব্য করেন।
জুলাই সনদ বাস্তবায়ন না হও&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/politics/jamat-e-islam/983776/%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A8%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%95%E0%A6%BF-%E0%A6%8F%E0%A6%B2%E0%A7%87%E0%A6%93-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0">বাংলা ট্রিবিউন</source>

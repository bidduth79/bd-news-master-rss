      <guid isPermaLink="true">https://www.banglatribune.com/health/980937/%E0%A6%A1%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%9F%E0%A6%BF%E0%A6%B8-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A7%81-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E2%80%98%E0%A6%A1%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%9F%E0%A6%BF%E0%A6%B8-%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%BE%E2%80%99</guid>
      <pubDate>Sat, 14 Nov 2026 21:49:26 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/3140828e2b625326cc840f5d5ae60f92-6af882987f726.jpg?jadewits_media_id=1055001" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/3140828e2b625326cc840f5d5ae60f92-6af882987f726.jpg?jadewits_media_id=1055001" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/3140828e2b625326cc840f5d5ae60f92-6af882987f726.jpg?jadewits_media_id=1055001" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডায়াবেটিস নিয়ন্ত্রণে চালু হচ্ছে ‘ডায়াবেটিস মেলা’ অ্যাপ" /&gt;&lt;/p&gt;&lt;p&gt;দেশে ডায়াবেটিসে আক্রান্ত রোগী ও ঝুঁকিতে থাকা ব্যক্তিদের সচেতনতা বাড়ানো এবং রোগ ব্যবস্থাপনায় সহায়তা দিতে চালু হতে যাচ্ছে &amp;lsquo;ডায়াবেটিস মেলা&amp;rsquo; নামের অ্যাপ। শনিবার (১৪ নভেম্বর) ঢাকা রিপোর্টার্স ইউনিটির সম্মেলন কক্ষে ডায়াবেটিস মেলা আয়োজিত এক সংবাদ সম্মেলনে এ তথ্য জানানো হয়।
সংবাদ সম্মেলনে ডায়াবে&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/health/980937/%E0%A6%A1%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%9F%E0%A6%BF%E0%A6%B8-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A7%81-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E2%80%98%E0%A6%A1%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%9F%E0%A6%BF%E0%A6%B8-%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%BE%E2%80%99">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>রেলওয়ে ওভারপাসে বোমাসদৃশ বস্তু, ঘিরে রেখেছে পুলিশ</title>
      <link>https://www.banglatribune.com/country/mymensing/980936/%E0%A6%B0%E0%A7%87%E0%A6%B2%E0%A6%93%E0%A7%9F%E0%A7%87-%E0%A6%93%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%AA%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A6%A6%E0%A7%83%E0%A6%B6-%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%81-%E0%A6%98%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A6%B0%E0%A7%87%E0%A6%96%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/mymensing/980936/%E0%A6%B0%E0%A7%87%E0%A6%B2%E0%A6%93%E0%A7%9F%E0%A7%87-%E0%A6%93%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%AA%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A6%A6%E0%A7%83%E0%A6%B6-%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%81-%E0%A6%98%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A6%B0%E0%A7%87%E0%A6%96%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6</guid>
      <pubDate>Sat, 14 Nov 2026 21:41:47 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/ea950d39f12e2588b384671411975af6-6af88136d3cbc.jpg?jadewits_media_id=1055000" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/ea950d39f12e2588b384671411975af6-6af88136d3cbc.jpg?jadewits_media_id=1055000" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/ea950d39f12e2588b384671411975af6-6af88136d3cbc.jpg?jadewits_media_id=1055000" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রেলওয়ে ওভারপাসে বোমাসদৃশ বস্তু, ঘিরে রেখেছে পুলিশ" /&gt;&lt;/p&gt;&lt;p&gt;জামালপুর শহরের রেলওয়ে ওভারপাসে লাল প্লাস্টিকে মোড়ানো তারযুক্ত বোমাসদৃশ একটি বস্তু পড়ে থাকতে দেখা গেছে। শনিবার (১৪ নভেম্বর) সন্ধ্যায় বস্তুটি দেখতে পেয়ে স্থানীয়দের মধ্যে আতঙ্ক ছড়িয়ে পড়ে। খবর পেয়ে পুলিশ ও ফায়ার সার্ভিসের সদস্যরা ঘটনাস্থলে গিয়ে বস্তুটির চারপাশ ঘিরে রেখেছেন।
পুলিশ ও স্থানীয় সূত্রে জানা গ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/mymensing/980936/%E0%A6%B0%E0%A7%87%E0%A6%B2%E0%A6%93%E0%A7%9F%E0%A7%87-%E0%A6%93%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%AA%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A6%A6%E0%A7%83%E0%A6%B6-%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%81-%E0%A6%98%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A6%B0%E0%A7%87%E0%A6%96%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6">বাংলা ট্রিবিউন</source>

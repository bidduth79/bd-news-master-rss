      <title>স্ত্রীসহ পল্লবী থানার সাবেক ওসি অপূর্বের ৬৫৫ শতাংশ জমি জব্দ, ব্যাংক হিসাব অবরুদ্ধ</title>
      <link>https://www.banglatribune.com/law-and-crime/983451/%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B8%E0%A6%B9-%E0%A6%AA%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%AC%E0%A7%80-%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%93%E0%A6%B8%E0%A6%BF-%E0%A6%85%E0%A6%AA%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A7%AC%E0%A7%AB%E0%A7%AB-%E0%A6%B6%E0%A6%A4%E0%A6%BE%E0%A6%82%E0%A6%B6</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/983451/%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B8%E0%A6%B9-%E0%A6%AA%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%AC%E0%A7%80-%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%93%E0%A6%B8%E0%A6%BF-%E0%A6%85%E0%A6%AA%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A7%AC%E0%A7%AB%E0%A7%AB-%E0%A6%B6%E0%A6%A4%E0%A6%BE%E0%A6%82%E0%A6%B6</guid>
      <pubDate>Thu, 26 Nov 2026 20:48:06 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/af56d8035d9869eddd691fafa15d525c-6b08469ddbeb9.jpg?jadewits_media_id=1057111" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/af56d8035d9869eddd691fafa15d525c-6b08469ddbeb9.jpg?jadewits_media_id=1057111" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/af56d8035d9869eddd691fafa15d525c-6b08469ddbeb9.jpg?jadewits_media_id=1057111" style="max-width:100%;height:auto;margin-bottom:10px;" alt="স্ত্রীসহ পল্লবী থানার সাবেক ওসি অপূর্বের ৬৫৫ শতাংশ জমি জব্দ, ব্যাংক হিসাব অবরুদ্ধ" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর পল্লবী থানার সাবেক ভারপ্রাপ্ত কর্মকর্তা (ওসি) অপূর্ব হাসান ও তার স্ত্রী ফাতিমা রহমানের গোপালগঞ্জ এবং ঢাকায় ৬৫৫ শতাংশ জমি জব্দ, দুটি ব্যাংক ও একটি বিমা হিসাব অবরুদ্ধের আদেশ দিয়েছেন আদালত।
বৃহস্পতিবার (২৬ নভেম্বর) দুদকের আবেদনের প্রেক্ষিতে ঢাকা মহানগর সিনিয়র স্পেশাল জজ মো. শাহজাহান কবিরের আদা&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/983451/%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B8%E0%A6%B9-%E0%A6%AA%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%AC%E0%A7%80-%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%93%E0%A6%B8%E0%A6%BF-%E0%A6%85%E0%A6%AA%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A7%AC%E0%A7%AB%E0%A7%AB-%E0%A6%B6%E0%A6%A4%E0%A6%BE%E0%A6%82%E0%A6%B6">বাংলা ট্রিবিউন</source>

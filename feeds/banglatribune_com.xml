    <item>
      <title>রাজধানীতে রেস্তোরাঁয় আগুনে ৬ জন দগ্ধ</title>
      <link>https://www.banglatribune.com/others/capital-city/982622/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%B0%E0%A7%87%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8B%E0%A6%B0%E0%A6%BE%E0%A6%81%E0%A7%9F-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8%E0%A7%87-%E0%A7%AC-%E0%A6%9C%E0%A6%A8-%E0%A6%A6%E0%A6%97%E0%A7%8D%E0%A6%A7</link>
      <guid isPermaLink="true">https://www.banglatribune.com/others/capital-city/982622/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%B0%E0%A7%87%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8B%E0%A6%B0%E0%A6%BE%E0%A6%81%E0%A7%9F-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8%E0%A7%87-%E0%A7%AC-%E0%A6%9C%E0%A6%A8-%E0%A6%A6%E0%A6%97%E0%A7%8D%E0%A6%A7</guid>
      <pubDate>Mon, 23 Nov 2026 00:17:11 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2024/12/02/-fad56c2ec452e8f671599c6da0c85266.jpg?jadewits_media_id=950139" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2024/12/02/-fad56c2ec452e8f671599c6da0c85266.jpg?jadewits_media_id=950139" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2024/12/02/-fad56c2ec452e8f671599c6da0c85266.jpg?jadewits_media_id=950139" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজধানীতে রেস্তোরাঁয় আগুনে ৬ জন দগ্ধ" /&gt;&lt;/p&gt;&lt;p&gt;লালবাগে কাচ্চি খানাস রেস্তোরাঁয় গ্যাস লাইন মেরামতের সময়ে &amp;nbsp;আগুন লেগে ৬ কর্মচারী দগ্ধ হয়েছেন। রবিবার (২২ নভেম্বর) রাত সাড়ে ৮টায় ঘটনাটি ঘটে।
দগ্ধরা হলেন- নয়ন (২৪) জনি (১৮) নিরব (২৪) নয়ন (২৬), রবিন (২৫) পলাশ (৪০)।
আহত অবস্থায় তাদেরকে উদ্ধার করে জাতীয় বার্ন অ্যান্ড প্লাস্টিক সার্জারি ইনিস্টিটিউটের&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/others/capital-city/982622/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%B0%E0%A7%87%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8B%E0%A6%B0%E0%A6%BE%E0%A6%81%E0%A7%9F-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8%E0%A7%87-%E0%A7%AC-%E0%A6%9C%E0%A6%A8-%E0%A6%A6%E0%A6%97%E0%A7%8D%E0%A6%A7">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ডিসেম্বরে বিতর্কিত কেউ যাতে দেশে ঢুকতে না পারে, সেজন্য সীমান্তে নিরাপত্তা জোরদার: বিজিবির ডিজি</title>
      <link>https://www.banglatribune.com/country/chitagong/982621/%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A4-%E0%A6%95%E0%A7%87%E0%A6%89-%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%A2%E0%A7%81%E0%A6%95%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/chitagong/982621/%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A4-%E0%A6%95%E0%A7%87%E0%A6%89-%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%A2%E0%A7%81%E0%A6%95%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87</guid>
      <pubDate>Mon, 23 Nov 2026 00:12:22 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/a3f7371d9be7ea2ffeae6bf3aa63a3f5-6b03306ad7a68.jpg?jadewits_media_id=1056422" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/a3f7371d9be7ea2ffeae6bf3aa63a3f5-6b03306ad7a68.jpg?jadewits_media_id=1056422" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/a3f7371d9be7ea2ffeae6bf3aa63a3f5-6b03306ad7a68.jpg?jadewits_media_id=1056422" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডিসেম্বরে বিতর্কিত কেউ যাতে দেশে ঢুকতে না পারে, সেজন্য সীমান্তে নিরাপত্তা জোরদার: বিজিবির ডিজি" /&gt;&lt;/p&gt;&lt;p&gt;ফেনীর পর ব্রাহ্মণবাড়িয়ার আখাউড়া স্থলবন্দর এলাকায় ভারত-বাংলাদেশ সীমান্ত পরিদর্শন করেছেন বর্ডার গার্ড বাংলাদেশের (বিজিবি) মহাপরিচালক (ডিজি) মেজর জেনারেল মোহাম্মদ আশরাফুজ্জামান সিদ্দিকী। রবিবার (২২ নভেম্বর) বিকালে হেলিকপ্টারযোগে আখাউড়া পৌঁছে ভারত-বাংলাদেশের সীমান্ত এলাকা পরিদর্শন করেন। বিকাল সাড়ে ৩টায় &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/chitagong/982621/%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A4-%E0%A6%95%E0%A7%87%E0%A6%89-%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%A2%E0%A7%81%E0%A6%95%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>বিনোদন-অ্যাডভেঞ্চারে সাজছে কক্সবাজার, চলবে তিন মাস কার্নিভাল</title>
      <link>https://www.banglatribune.com/country/chitagong/982620/%E0%A6%AC%E0%A6%BF%E0%A6%A8%E0%A7%8B%E0%A6%A6%E0%A6%A8-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A1%E0%A6%AD%E0%A7%87%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%9C%E0%A6%9B%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%9A%E0%A6%B2%E0%A6%AC%E0%A7%87-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/chitagong/982620/%E0%A6%AC%E0%A6%BF%E0%A6%A8%E0%A7%8B%E0%A6%A6%E0%A6%A8-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A1%E0%A6%AD%E0%A7%87%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%9C%E0%A6%9B%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%9A%E0%A6%B2%E0%A6%AC%E0%A7%87-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B8</guid>
      <pubDate>Mon, 23 Nov 2026 00:10:05 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/aa9bfd032f7b659f0245974a4b11f7b6-6b032ff31de99.jpg?jadewits_media_id=1056421" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/aa9bfd032f7b659f0245974a4b11f7b6-6b032ff31de99.jpg?jadewits_media_id=1056421" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/aa9bfd032f7b659f0245974a4b11f7b6-6b032ff31de99.jpg?jadewits_media_id=1056421" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিনোদন-অ্যাডভেঞ্চারে সাজছে কক্সবাজার, চলবে তিন মাস কার্নিভাল" /&gt;&lt;/p&gt;&lt;p&gt;পর্যটন মৌসুমকে ঘিরে কক্সবাজারে শুরু হয়েছে তিন মাসব্যাপী &amp;lsquo;পর্যটন কার্নিভাল-২০২৬&amp;rsquo;। বিশ্বের দীর্ঘতম সমুদ্রসৈকতকে কেন্দ্র করে আয়োজিত এ কার্নিভালে পর্যটকদের জন্য রাখা হয়েছে বিনোদন, সংস্কৃতি ও অ্যাডভেঞ্চারভিত্তিক নানা আয়োজন। আয়োজকদের প্রত্যাশা, এ উদ্যোগ দেশি-বিদেশি পর্যটকের আগমন বাড়ানোর পাশাপা&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/chitagong/982620/%E0%A6%AC%E0%A6%BF%E0%A6%A8%E0%A7%8B%E0%A6%A6%E0%A6%A8-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A1%E0%A6%AD%E0%A7%87%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%9C%E0%A6%9B%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%9A%E0%A6%B2%E0%A6%AC%E0%A7%87-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B8">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>প্রধানমন্ত্রীর সংলাপ: ঐক্যের উদ্যোগ, নাকি রাজনৈতিক সমীকরণ?</title>
      <link>https://www.banglatribune.com/national/982615/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%B8%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%AA-%E0%A6%90%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%A8%E0%A6%BE%E0%A6%95%E0%A6%BF-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A8%E0%A7%88%E0%A6%A4%E0%A6%BF%E0%A6%95</link>
      <guid isPermaLink="true">https://www.banglatribune.com/national/982615/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%B8%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%AA-%E0%A6%90%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%A8%E0%A6%BE%E0%A6%95%E0%A6%BF-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A8%E0%A7%88%E0%A6%A4%E0%A6%BF%E0%A6%95</guid>
      <pubDate>Mon, 23 Nov 2026 00:17:43 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/666a4c13cb8ce64ea1077a2676253518-6b03263cda4bd.jpg?jadewits_media_id=1056415" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/666a4c13cb8ce64ea1077a2676253518-6b03263cda4bd.jpg?jadewits_media_id=1056415" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/666a4c13cb8ce64ea1077a2676253518-6b03263cda4bd.jpg?jadewits_media_id=1056415" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রধানমন্ত্রীর সংলাপ: ঐক্যের উদ্যোগ, নাকি রাজনৈতিক সমীকরণ?" /&gt;&lt;/p&gt;&lt;p&gt;দেশের চলমান পরিস্থিতিতে জুলাই আন্দোলনের পক্ষের রাজনৈতিক দলগুলোর সঙ্গে জাতীয় সংলাপের উদ্যোগ নিয়েছে সরকার। এর অংশ হিসেবে সোমবার (২৩ নভেম্বর) দুপুরে প্রধানমন্ত্রীর বাসভবন যমুনায় তার সঙ্গে বৈঠকে বসবেন জাতীয় নাগরিক পার্টির (এনসিপি) নেতারা। পর্যায়ক্রমে অন্য রাজনৈতিক দলগুলোকেও সংলাপে আমন্ত্রণ জানানোর কথা র&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/982615/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%B8%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%AA-%E0%A6%90%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%A8%E0%A6%BE%E0%A6%95%E0%A6%BF-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A8%E0%A7%88%E0%A6%A4%E0%A6%BF%E0%A6%95">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>গোপালগঞ্জে বিজিবির কার্যক্রম কী, স্পষ্ট করলো বাহিনীটি</title>
      <link>https://www.banglatribune.com/law-and-crime/982619/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%95%E0%A7%80-%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A6%B7%E0%A7%8D%E0%A6%9F-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%8B</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/982619/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%95%E0%A7%80-%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A6%B7%E0%A7%8D%E0%A6%9F-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%8B</guid>
      <pubDate>Sun, 22 Nov 2026 23:59:21 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/1c74abc1475c2df56ff66294c2451a1d-6b032d48e0bca.jpg?jadewits_media_id=1056420" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/1c74abc1475c2df56ff66294c2451a1d-6b032d48e0bca.jpg?jadewits_media_id=1056420" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/1c74abc1475c2df56ff66294c2451a1d-6b032d48e0bca.jpg?jadewits_media_id=1056420" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গোপালগঞ্জে বিজিবির কার্যক্রম কী, স্পষ্ট করলো বাহিনীটি" /&gt;&lt;/p&gt;&lt;p&gt;বর্ডার গার্ড বাংলাদেশ (বিজিবি) জানিয়েছে, অন্যান্য আইনশৃঙ্খলা বাহিনীর পাশাপাশি বিজিবি সদস্যরা গোপালগঞ্জে ম্যাজিস্ট্রেটের উপস্থিতিতে শহরের গুরুত্বপূর্ণ সড়কে টহল দিচ্ছে, যাতে কোনও নাশকতার ঘটনা না ঘটে। রবিবার (২২ নভেম্বর) রাতে এক বিবৃতিতে তারা এ কথা জানায়।
বিবৃতিতে বলা হয়, বিভিন্ন ফেসবুক পেজ ও সামাজিক &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/982619/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%95%E0%A7%80-%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A6%B7%E0%A7%8D%E0%A6%9F-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%8B">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>কৃষক দল নেতাকে হত্যার ঘটনায় মামলা: প্রধান আসামি নিক্সন চৌধুরী</title>
      <link>https://www.banglatribune.com/country/dhaka/982617/%E0%A6%95%E0%A7%83%E0%A6%B7%E0%A6%95-%E0%A6%A6%E0%A6%B2-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8-%E0%A6%86%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%BF-%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%A8-%E0%A6%9A%E0%A7%8C%E0%A6%A7%E0%A7%81%E0%A6%B0%E0%A7%80</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/dhaka/982617/%E0%A6%95%E0%A7%83%E0%A6%B7%E0%A6%95-%E0%A6%A6%E0%A6%B2-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8-%E0%A6%86%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%BF-%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%A8-%E0%A6%9A%E0%A7%8C%E0%A6%A7%E0%A7%81%E0%A6%B0%E0%A7%80</guid>
      <pubDate>Sun, 22 Nov 2026 23:51:59 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/7f967cce3fb732411f14c81d471eeb1c-6b0328686fb09.jpg?jadewits_media_id=1056417" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/7f967cce3fb732411f14c81d471eeb1c-6b0328686fb09.jpg?jadewits_media_id=1056417" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/7f967cce3fb732411f14c81d471eeb1c-6b0328686fb09.jpg?jadewits_media_id=1056417" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কৃষক দল নেতাকে হত্যার ঘটনায় মামলা: প্রধান আসামি নিক্সন চৌধুরী" /&gt;&lt;/p&gt;&lt;p&gt;ফরিদপুরের ভাঙ্গায় উপজেলা কৃষক দলের সহ-সাংগঠনিক সম্পাদক রাজু মোল্লাকে (৪০) হত্যার ঘটনায় সাবেক সংসদ সদস্য মজিবুর রহমান চৌধুরী নিক্সনকে প্রধান আসামি করে ৯৬ জনের নাম উল্লেখ করে মামলা করা হয়েছে। এ ছাড়া অজ্ঞাতনামা আরও ১০০ থেকে ১৫০ জনকে আসামি করা হয়।
শনিবার দিবাগত রাত ১২টার দিকে ভাঙ্গা থানায় মামলাটি করেন ন&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/dhaka/982617/%E0%A6%95%E0%A7%83%E0%A6%B7%E0%A6%95-%E0%A6%A6%E0%A6%B2-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8-%E0%A6%86%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%BF-%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%A8-%E0%A6%9A%E0%A7%8C%E0%A6%A7%E0%A7%81%E0%A6%B0%E0%A7%80">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>নাশকতা ও মাদকের বিরুদ্ধে কঠোর ব্যবস্থার নির্দেশ ডিএমপি কমিশনারের</title>
      <link>https://www.banglatribune.com/law-and-crime/982616/%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%BE-%E0%A6%93-%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%95%E0%A6%A0%E0%A7%8B%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A7%87%E0%A6%B6</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/982616/%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%BE-%E0%A6%93-%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%95%E0%A6%A0%E0%A7%8B%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A7%87%E0%A6%B6</guid>
      <pubDate>Sun, 22 Nov 2026 23:37:14 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/75540b976678f5de7b1a2270c6ecf5f1-6b0327e9b5b6b.jpg?jadewits_media_id=1056416" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/75540b976678f5de7b1a2270c6ecf5f1-6b0327e9b5b6b.jpg?jadewits_media_id=1056416" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/75540b976678f5de7b1a2270c6ecf5f1-6b0327e9b5b6b.jpg?jadewits_media_id=1056416" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নাশকতা ও মাদকের বিরুদ্ধে কঠোর ব্যবস্থার নির্দেশ ডিএমপি কমিশনারের" /&gt;&lt;/p&gt;&lt;p&gt;আইনশৃঙ্খলা রক্ষা ও অপরাধ নিয়ন্ত্রণে প্রত্যেক পুলিশ সদস্যকে নিজ নিজ অর্পিত দায়িত্ব যথাযথভাবে পালনের নির্দেশ দিয়েছেন ঢাকা মেট্রোপলিটন পুলিশ (ডিএমপি) কমিশনার মোসলেহ্ উদ্দিন আহমদ। তিনি নাশকতামূলক কর্মকাণ্ড, মাদক, অবৈধ অস্ত্র, ছিনতাই ও চাঁদাবাজির বিরুদ্ধে কঠোর আইনানুগ ব্যবস্থা গ্রহণের নির্দেশ দেন।
রবিবার&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/982616/%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%BE-%E0%A6%93-%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%95%E0%A6%A0%E0%A7%8B%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A7%87%E0%A6%B6">বাংলা ট্রিবিউন</source>

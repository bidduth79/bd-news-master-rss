      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/07d171cc08d4152cb950ecdd9cc9c7b9-6b0028014b953.JPG?jadewits_media_id=1056027" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/07d171cc08d4152cb950ecdd9cc9c7b9-6b0028014b953.JPG?jadewits_media_id=1056027" medium="image" />

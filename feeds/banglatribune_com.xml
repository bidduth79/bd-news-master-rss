    <item>
      <title>তিতাসের চাকরি ছেড়ে যেভাবে চলচ্চিত্রে এসেছিলেন রাজীব</title>
      <link>https://www.banglatribune.com/entertainment/dhallywood/980861/%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A6%BE%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%BE%E0%A6%95%E0%A6%B0%E0%A6%BF-%E0%A6%9B%E0%A7%87%E0%A7%9C%E0%A7%87-%E0%A6%AF%E0%A7%87%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%9A%E0%A6%B2%E0%A6%9A%E0%A7%8D%E0%A6%9A%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%87-%E0%A6%8F%E0%A6%B8%E0%A7%87%E0%A6%9B%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/entertainment/dhallywood/980861/%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A6%BE%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%BE%E0%A6%95%E0%A6%B0%E0%A6%BF-%E0%A6%9B%E0%A7%87%E0%A7%9C%E0%A7%87-%E0%A6%AF%E0%A7%87%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%9A%E0%A6%B2%E0%A6%9A%E0%A7%8D%E0%A6%9A%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%87-%E0%A6%8F%E0%A6%B8%E0%A7%87%E0%A6%9B%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Sat, 14 Nov 2026 14:54:54 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/efd856e2b25878e94e810d2f3880ecb6-6af821163be08.jpg?jadewits_media_id=1054939" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/efd856e2b25878e94e810d2f3880ecb6-6af821163be08.jpg?jadewits_media_id=1054939" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/efd856e2b25878e94e810d2f3880ecb6-6af821163be08.jpg?jadewits_media_id=1054939" style="max-width:100%;height:auto;margin-bottom:10px;" alt="তিতাসের চাকরি ছেড়ে যেভাবে চলচ্চিত্রে এসেছিলেন রাজীব" /&gt;&lt;/p&gt;&lt;p&gt;গম্ভীর ঝাঁজালো কণ্ঠ, রহস্যভরা চোখের চাহনি, বৈচিত্র্যময় অভিব্যক্তি যেমন দর্শককে দিত টানটান উত্তেজনা, তেমনি করতো আতঙ্কিত। বলছি ঢাকাই সিনেমার বর্ষীয়ান অভিনেতা রাজীবের কথা। যার আসল নাম ওয়াসীমুল বারী রাজীব।
২০০৪ সালের (১৪ নভেম্বর) আজকের এই দিনে ৫২ বছর বয়সে ক্যানসারে মারা তিনি। ১ জানুয়ারি ১৯৫২ সালে পটুয়&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/entertainment/dhallywood/980861/%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A6%BE%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%BE%E0%A6%95%E0%A6%B0%E0%A6%BF-%E0%A6%9B%E0%A7%87%E0%A7%9C%E0%A7%87-%E0%A6%AF%E0%A7%87%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%9A%E0%A6%B2%E0%A6%9A%E0%A7%8D%E0%A6%9A%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%87-%E0%A6%8F%E0%A6%B8%E0%A7%87%E0%A6%9B%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8">বাংলা ট্রিবিউন</source>

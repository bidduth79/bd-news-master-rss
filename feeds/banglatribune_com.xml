      <guid isPermaLink="true">https://www.banglatribune.com/press-release/982072/%E0%A6%A4%E0%A6%B0%E0%A7%81%E0%A6%A3-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A7%A8%E0%A7%A6-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A7%9F%E0%A6%A8</guid>
      <pubDate>Fri, 20 Nov 2026 04:11:38 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/d6ea3782847775b4d4b67a2fae97b739-6aff73d4d4907.jpg?jadewits_media_id=1055942" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/d6ea3782847775b4d4b67a2fae97b739-6aff73d4d4907.jpg?jadewits_media_id=1055942" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/d6ea3782847775b4d4b67a2fae97b739-6aff73d4d4907.jpg?jadewits_media_id=1055942" style="max-width:100%;height:auto;margin-bottom:10px;" alt="তরুণ উদ্যোক্তাদের জন্য ২০ লাখ টাকা পর্যন্ত অর্থায়ন দেবে সিটি ব্যাংক" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ ব্যাংকের &amp;lsquo;উদ্যোগ&amp;rsquo; কর্মসূচির আওতায় তরুণ উদ্যোক্তাদের সর্বোচ্চ ২০ লাখ টাকা পর্যন্ত অর্থায়ন সুবিধা দেবে সিটি ব্যাংক। এর মধ্যে ১০ লাখ টাকা ব্যাংকঋণ এবং সমপরিমাণ ১০ লাখ টাকা অনুদান হিসেবে দেওয়া হবে।
বৃহস্পতিবার (১৯ নভেম্বর) মুন্সীগঞ্জের দরবার পার্টি প্যালেসে বাংলাদেশ ব্যাংকের &amp;lsquo;&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/press-release/982072/%E0%A6%A4%E0%A6%B0%E0%A7%81%E0%A6%A3-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A7%A8%E0%A7%A6-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A7%9F%E0%A6%A8">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>গ্রামীণ ব্যাংকের ৭২ কার্যালয় হামলার শিকার: নিরাপত্তা চেয়ে স্বরাষ্ট্রমন্ত্রীকে চিঠি</title>
      <link>https://www.banglatribune.com/law-and-crime/982071/%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%A3-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A7%AD%E0%A7%A8-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/982071/%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%A3-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A7%AD%E0%A7%A8-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Fri, 20 Nov 2026 04:00:07 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2021/09/23/ca9dce60c1c19d1eb4ebfdc4e9f46dde-614c89e14f254.png?jadewits_media_id=749700" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2021/09/23/ca9dce60c1c19d1eb4ebfdc4e9f46dde-614c89e14f254.png?jadewits_media_id=749700" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2021/09/23/ca9dce60c1c19d1eb4ebfdc4e9f46dde-614c89e14f254.png?jadewits_media_id=749700" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গ্রামীণ ব্যাংকের ৭২ কার্যালয় হামলার শিকার: নিরাপত্তা চেয়ে স্বরাষ্ট্রমন্ত্রীকে চিঠি" /&gt;&lt;/p&gt;&lt;p&gt;দেশের বিভিন্ন স্থানে গ্রামীণ ব্যাংকের ৭২টি শাখা ও কার্যালয়ে অগ্নিসংযোগ, ভাঙচুর ও হামলার ঘটনা ঘটেছে। এসব ঘটনায় নিরাপত্তা চেয়ে স্বরাষ্ট্রমন্ত্রীর কাছে চিঠি দিয়েছে ব্যাংক কর্তৃপক্ষ। বৃহস্পতিবার (১৯ নভেম্বর) ব্যাংকের ব্যবস্থাপনা পরিচালক সরদার আকতার হামিদ স্বরাষ্ট্রমন্ত্রী বরাবর এ চিঠি পাঠান।
গ্রামীণ ব্য&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/982071/%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%A3-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A7%AD%E0%A7%A8-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>অভিনেতা তমাল মাহবুব ডিবি হেফাজতে</title>
      <link>https://www.banglatribune.com/law-and-crime/982070/%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%A4%E0%A6%AE%E0%A6%BE%E0%A6%B2-%E0%A6%AE%E0%A6%BE%E0%A6%B9%E0%A6%AC%E0%A7%81%E0%A6%AC-%E0%A6%A1%E0%A6%BF%E0%A6%AC%E0%A6%BF-%E0%A6%B9%E0%A7%87%E0%A6%AB%E0%A6%BE%E0%A6%9C%E0%A6%A4%E0%A7%87%C2%A0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/982070/%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%A4%E0%A6%AE%E0%A6%BE%E0%A6%B2-%E0%A6%AE%E0%A6%BE%E0%A6%B9%E0%A6%AC%E0%A7%81%E0%A6%AC-%E0%A6%A1%E0%A6%BF%E0%A6%AC%E0%A6%BF-%E0%A6%B9%E0%A7%87%E0%A6%AB%E0%A6%BE%E0%A6%9C%E0%A6%A4%E0%A7%87%C2%A0</guid>
      <pubDate>Fri, 20 Nov 2026 02:45:14 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/6e5a5c2c8bf12756390e51e043146c11-6aff5fa48756b.jpg?jadewits_media_id=1055941" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/6e5a5c2c8bf12756390e51e043146c11-6aff5fa48756b.jpg?jadewits_media_id=1055941" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/6e5a5c2c8bf12756390e51e043146c11-6aff5fa48756b.jpg?jadewits_media_id=1055941" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অভিনেতা তমাল মাহবুব ডিবি হেফাজতে" /&gt;&lt;/p&gt;&lt;p&gt;অভিনেতা তমাল মাহবুবকে হেফাজতে নিয়েছে ঢাকা মহানগর গোয়েন্দা পুলিশ (ডিবি)। বর্তমা&amp;zwnj;নে তা&amp;zwnj;কে রাজধানীর মিন্টু&amp;zwnj; রো&amp;zwnj;ডের ডি&amp;zwnj;বি কার্যাল&amp;zwnj;য়ে রাখা হ&amp;zwnj;য়ে&amp;zwnj;ছে।
এর আগে বৃহস্পতিবার (১৯ ন&amp;zwnj;ভেম্বর) রাত সাড়ে ১০টার পর রাজধানীর আজিমপুরের ইরানি মাঠের পাশ থেকে তাকে আটক ক&amp;zwnj;র&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/982070/%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%A4%E0%A6%AE%E0%A6%BE%E0%A6%B2-%E0%A6%AE%E0%A6%BE%E0%A6%B9%E0%A6%AC%E0%A7%81%E0%A6%AC-%E0%A6%A1%E0%A6%BF%E0%A6%AC%E0%A6%BF-%E0%A6%B9%E0%A7%87%E0%A6%AB%E0%A6%BE%E0%A6%9C%E0%A6%A4%E0%A7%87%C2%A0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>রোহিঙ্গা গণহত্যার দায়ে মিয়ানমারকে দায়ী করে আইসিজের রায়, স্বাগত জানালো বাংলাদেশ</title>
      <link>https://www.banglatribune.com/national/982069/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%97%E0%A6%A3%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A7%9F%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A7%87-%E0%A6%A6%E0%A6%BE%E0%A7%9F%E0%A7%80-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%87%E0%A6%B8%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/national/982069/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%97%E0%A6%A3%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A7%9F%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A7%87-%E0%A6%A6%E0%A6%BE%E0%A7%9F%E0%A7%80-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%87%E0%A6%B8%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Fri, 20 Nov 2026 02:37:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/10/11/b9e477539e66ff74b951ab90678c4cdd-6acb13b65ffde.jpg?jadewits_media_id=1048681" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/10/11/b9e477539e66ff74b951ab90678c4cdd-6acb13b65ffde.jpg?jadewits_media_id=1048681" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/10/11/b9e477539e66ff74b951ab90678c4cdd-6acb13b65ffde.jpg?jadewits_media_id=1048681" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রোহিঙ্গা গণহত্যার দায়ে মিয়ানমারকে দায়ী করে আইসিজের রায়, স্বাগত জানালো বাংলাদেশ" /&gt;&lt;/p&gt;&lt;p&gt;রোহিঙ্গা গণহত্যার দায়ে মিয়ানমারকে দায়ী করে আন্তর্জাতিক বিচার আদালতের (আইসিজে) দেওয়া ঐতিহাসিক রায়কে স্বাগত জানিয়েছে বাংলাদেশ সরকার। একই সঙ্গে রায়টি দ্রুত ও পূর্ণাঙ্গভাবে বাস্তবায়নে মিয়ানমার এবং আন্তর্জাতিক সম্প্রদায়ের প্রতি আহ্বান জানিয়েছে ঢাকা। বৃহস্পতিবার (১৯ নভেম্বর) পররাষ্ট্র মন্ত্রণালয়ের এক সংবা&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/982069/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%97%E0%A6%A3%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A7%9F%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A7%87-%E0%A6%A6%E0%A6%BE%E0%A7%9F%E0%A7%80-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%87%E0%A6%B8%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>সাতক্ষীরার সাবেক এমপি দোলন ঢাকায় গ্রেফতার</title>
      <link>https://www.banglatribune.com/law-and-crime/982068/%E0%A6%B8%E0%A6%BE%E0%A6%A4%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%80%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF-%E0%A6%A6%E0%A7%8B%E0%A6%B2%E0%A6%A8-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/982068/%E0%A6%B8%E0%A6%BE%E0%A6%A4%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%80%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF-%E0%A6%A6%E0%A7%8B%E0%A6%B2%E0%A6%A8-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Fri, 20 Nov 2026 02:27:58 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/b4d870232c681db84d157b81db29971f-6aff5b683d52f.jpg?jadewits_media_id=1055940" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/b4d870232c681db84d157b81db29971f-6aff5b683d52f.jpg?jadewits_media_id=1055940" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/b4d870232c681db84d157b81db29971f-6aff5b683d52f.jpg?jadewits_media_id=1055940" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাতক্ষীরার সাবেক এমপি দোলন ঢাকায় গ্রেফতার" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর বারিধারা ডিওএইচএস এলাকা থেকে সাতক্ষীরা-৪ আসনের সাবেক সংসদ সদস্য এস এম আতাউল হক দোলনকে গ্রেফতার করেছে এসআরবি-১। বৃহস্পতিবার (১৯ নভেম্বর) রাত সোয়া ১১টার দিকে গোয়েন্দা তথ্যের ভিত্তিতে বিশেষ অভিযান চালিয়ে তাকে গ্রেফতার করা হয়। তাকে ঢাকা মহানগর গোয়েন্দা পুলিশের (ডিবি) কাছে হস্তান্তরের প্রক্রিয়া &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/982068/%E0%A6%B8%E0%A6%BE%E0%A6%A4%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%80%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF-%E0%A6%A6%E0%A7%8B%E0%A6%B2%E0%A6%A8-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>

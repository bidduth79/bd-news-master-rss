      <guid isPermaLink="true">https://www.banglatribune.com/national/981964/%E0%A6%AA%E0%A6%B0%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AF%E0%A6%BE-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Thu, 19 Nov 2026 17:11:41 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/09a05b4bf529503737ab4852eda23fc4-6afed92c9a848.jpg?jadewits_media_id=1055874" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/09a05b4bf529503737ab4852eda23fc4-6afed92c9a848.jpg?jadewits_media_id=1055874" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/09a05b4bf529503737ab4852eda23fc4-6afed92c9a848.jpg?jadewits_media_id=1055874" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পররাষ্ট্রমন্ত্রীর সঙ্গে সাক্ষাতের পর যা বললেন দীনেশ ত্রিবেদী" /&gt;&lt;/p&gt;&lt;p&gt;পররাষ্ট্রমন্ত্রী খলিলুর রহমানের সঙ্গে সাক্ষাৎ করেছেন ঢাকায় নিযুক্ত ভারতীয় হাইকমিশনার দীনেশ ত্রিবেদী। বৃহস্পতিবার (১৯ নভেম্বর) সকালে পররাষ্ট্র মন্ত্রণালয়ে এ সাক্ষাৎ অনুষ্ঠিত হয়।&amp;nbsp;
ওই সাক্ষাতের পর সাংবাদিকদের মুখোমুখি হন দীনেশ ত্রিবেদী। তিনি বলেন, &amp;lsquo;খলিলুর রহমান জাতিসংঘের সংস্কার নিয়ে অনেক কথ&lt;/p&gt;</description>

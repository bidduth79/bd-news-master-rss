    <item>
      <title>মিরপুরে যুবকের ছুরিকাঘাতে আহত পোশাককর্মীর অবস্থা অপরিবর্তিত</title>
      <link>https://www.banglatribune.com/law-and-crime/982063/%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%9B%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%98%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%B9%E0%A6%A4-%E0%A6%AA%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%95%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%80%E0%A6%B0-%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/982063/%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%9B%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%98%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%B9%E0%A6%A4-%E0%A6%AA%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%95%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%80%E0%A6%B0-%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE</guid>
      <pubDate>Fri, 20 Nov 2026 01:27:30 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/292d67246646d39dcf6532170ca64538-6afd987babca8.jpg?jadewits_media_id=1055694" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/292d67246646d39dcf6532170ca64538-6afd987babca8.jpg?jadewits_media_id=1055694" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/292d67246646d39dcf6532170ca64538-6afd987babca8.jpg?jadewits_media_id=1055694" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মিরপুরে যুবকের ছুরিকাঘাতে আহত পোশাককর্মীর অবস্থা অপরিবর্তিত" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর মিরপুরের রূপনগরে দুর্বৃত্তের ছুরিকাঘাতে গুরুতর আহত পোশাককর্মী নুপুর আক্তারের (২৬) শারীরিক অবস্থার কোনও পরিবর্তন হয়নি। তিনি ঢাকা মেডিক্যাল কলেজ হাসপাতালের (ঢামেক) নিবিড় পরিচর্যা কেন্দ্রে (আইসিইউ) চিকিৎসাধীন রয়েছেন।
হাসপাতালের চিকিৎসকদের বরাত দিয়ে ঢামেক পুলিশ ফাঁড়ির ইনচার্জ হাবিবুর রহমান এ তথ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/982063/%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%9B%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%98%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%B9%E0%A6%A4-%E0%A6%AA%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%95%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%80%E0%A6%B0-%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>রোহিঙ্গা গণহত্যা নিয়ে আইসিজের রায় বাংলাদেশের জন্য কতটা গুরুত্বপূর্ণ?</title>
      <link>https://www.banglatribune.com/country/chitagong/982062/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%97%E0%A6%A3%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%86%E0%A6%87%E0%A6%B8%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/chitagong/982062/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%97%E0%A6%A3%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%86%E0%A6%87%E0%A6%B8%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF</guid>
      <pubDate>Fri, 20 Nov 2026 00:53:32 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2023/06/19/-81eaee56f433f886a2883e7d46d0170d.jpg?jadewits_media_id=864254" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2023/06/19/-81eaee56f433f886a2883e7d46d0170d.jpg?jadewits_media_id=864254" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2023/06/19/-81eaee56f433f886a2883e7d46d0170d.jpg?jadewits_media_id=864254" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রোহিঙ্গা গণহত্যা নিয়ে আইসিজের রায় বাংলাদেশের জন্য কতটা গুরুত্বপূর্ণ?" /&gt;&lt;/p&gt;&lt;p&gt;২০১৭ সালে রোহিঙ্গা মুসলিমদের ওপর গণহত্যা চালানোর দায়ে মিয়ানমারকে দায়ী করে ঐতিহাসিক রায় দিয়েছেন আন্তর্জাতিক বিচার আদালত (আইসিজে)। বৃহস্পতিবার (১৯ নভেম্বর) দেওয়া এই রায়ের মধ্য দিয়ে প্রথমবারের মতো কোনও রাষ্ট্রকে গণহত্যার জন্য দায়ী করলেন আদালত। রাখাইন রাজ্যের উত্তরাঞ্চলে সামরিক অভিযানের সময় সং&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/chitagong/982062/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%97%E0%A6%A3%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%86%E0%A6%87%E0%A6%B8%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>রোহিঙ্গা গণহত্যার রায় গাজায় ইসরায়েলের মামলায় প্রাসঙ্গিক হবে: আসিফ নজরুল</title>

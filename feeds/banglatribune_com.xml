      <guid isPermaLink="true">https://www.banglatribune.com/country/khulna/982259/%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%A3-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%9A%E0%A7%87%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BE</guid>
      <pubDate>Sat, 21 Nov 2026 00:29:10 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/e824ab78f0ff2bbc66ceb0d739fab3b2-6b009105ade32.jpg?jadewits_media_id=1056116" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/e824ab78f0ff2bbc66ceb0d739fab3b2-6b009105ade32.jpg?jadewits_media_id=1056116" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/e824ab78f0ff2bbc66ceb0d739fab3b2-6b009105ade32.jpg?jadewits_media_id=1056116" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গ্রামীণ ব্যাংকের কার্যালয়ে আগুন দেওয়ার চেষ্টা, ফুটেজ দেখে যুবক আটক" /&gt;&lt;/p&gt;&lt;p&gt;বাগেরহাটের মোংলায় গ্রামীণ ব্যাংকের একটি শাখায় পেট্রোল বোমা নিক্ষেপ করে আগুন দেওয়ার চেষ্টার ঘটনায় এক যুবককে আটক করেছে পুলিশ। ঘটনার তিন দিন পর শুক্রবার (২০ নভেম্বর) রাতে তাকে আটক করা হয়।
আটক যুবকের নাম মো. রাকিব খান (২৬)। শুক্রবার রাত ৮টার দিকে উপজেলার জয়মনি সাইলো এলাকার নিজ বাড়ি থেকে আটক করা হয়।
পুলি&lt;/p&gt;</description>

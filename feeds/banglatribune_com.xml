      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/980466/%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%A4%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%80-%E0%A6%85%E0%A6%AA%E0%A6%B0%E0%A6%BE%E0%A6%A7-%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%AB%E0%A7%81%E0%A6%AB%E0%A6%BE%E0%A6%A4%E0%A7%8B-%E0%A6%AD%E0%A6%BE%E0%A6%87%E0%A6%B8%E0%A6%B9-%E0%A6%9A%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Thu, 12 Nov 2026 14:38:44 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2016/05/25/ab80b442048a470cb4bb61e0226ed972-574591a4542b9.png?jadewits_media_id=97169" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2016/05/25/ab80b442048a470cb4bb61e0226ed972-574591a4542b9.png?jadewits_media_id=97169" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2016/05/25/ab80b442048a470cb4bb61e0226ed972-574591a4542b9.png?jadewits_media_id=97169" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মানবতাবিরোধী অপরাধ: শেখ হাসিনার ফুফাতো ভাইসহ চার জনের মামলায় যুক্তিতর্ক ৭ ডিসেম্বর" /&gt;&lt;/p&gt;&lt;p&gt;বরিশালের আগৈলঝাড়ায় ক্রসফায়ারে দুজনকে হত্যার ঘটনায় মানবতাবিরোধী অপরাধের মামলায় শেখ হাসিনার ফুফাতো ভাই ও সাবেক সংসদ সদস্য আবুল হাসানাত আবদুল্লাহসহ চার আসামির বিরুদ্ধে তদন্ত কর্মকর্তার সাক্ষ্যগ্রহণ শেষে যুক্তিতর্ক উপস্থাপনের জন্য আগামী ৭ ডিসেম্বর দিন ধার্য করেছেন আন্তর্জাতিক অপরাধ ট্রাইব্যুনাল।
বৃহস্পত&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/980466/%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%A4%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%80-%E0%A6%85%E0%A6%AA%E0%A6%B0%E0%A6%BE%E0%A6%A7-%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%AB%E0%A7%81%E0%A6%AB%E0%A6%BE%E0%A6%A4%E0%A7%8B-%E0%A6%AD%E0%A6%BE%E0%A6%87%E0%A6%B8%E0%A6%B9-%E0%A6%9A%E0%A6%BE%E0%A6%B0">বাংলা ট্রিবিউন</source>

      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/8e50d4feb168dd3e3e0b589a9f994888-6af5fd5e3589c.jpg?jadewits_media_id=1054721" length="0" type="image/jpeg" />

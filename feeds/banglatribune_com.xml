      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/0ceee54b9848dab7a1d0be4e92faa470-6b031a9976036.jpg?jadewits_media_id=1056407" length="0" type="image/jpeg" />

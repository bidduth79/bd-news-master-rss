    <item>
      <title>হর্ন-আতশবাজি নিয়ন্ত্রণ ও নীরব এলাকায় অভিযানের নির্দেশ হাইকোর্টের</title>
      <link>https://www.banglatribune.com/law-and-crime/981175/%E0%A6%B9%E0%A6%B0%E0%A7%8D%E0%A6%A8-%E0%A6%86%E0%A6%A4%E0%A6%B6%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BF-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A3-%E0%A6%93-%E0%A6%A8%E0%A7%80%E0%A6%B0%E0%A6%AC-%E0%A6%8F%E0%A6%B2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/981175/%E0%A6%B9%E0%A6%B0%E0%A7%8D%E0%A6%A8-%E0%A6%86%E0%A6%A4%E0%A6%B6%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BF-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A3-%E0%A6%93-%E0%A6%A8%E0%A7%80%E0%A6%B0%E0%A6%AC-%E0%A6%8F%E0%A6%B2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Mon, 16 Nov 2026 06:07:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/03/16/d7a86567049982fe4e2b54db76545e7b-69b7deacb009a.jpg?jadewits_media_id=1015539" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/03/16/d7a86567049982fe4e2b54db76545e7b-69b7deacb009a.jpg?jadewits_media_id=1015539" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/03/16/d7a86567049982fe4e2b54db76545e7b-69b7deacb009a.jpg?jadewits_media_id=1015539" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হর্ন-আতশবাজি নিয়ন্ত্রণ ও নীরব এলাকায় অভিযানের নির্দেশ হাইকোর্টের" /&gt;&lt;/p&gt;&lt;p&gt;শব্দদূষণ নিয়ন্ত্রণে নীরব এলাকাগুলোতে নিয়মিত অভিযান পরিচালনা এবং অপ্রয়োজনীয় হর্ন, আতশবাজি ও পটকার ব্যবহার নিয়ন্ত্রণের নির্দেশ দিয়েছেন হাইকোর্ট।
বাংলাদেশ পরিবেশ আইনবিদ সমিতির (বেলা) করা এক জনস্বার্থমূলক মামলার প্রাথমিক শুনানি নিয়ে রবিবার (১৫ নভেম্বর) বিচারপতি শিকদার মাহমুদুর রাজী ও বিচারপতি ফাতেমা আনো&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/981175/%E0%A6%B9%E0%A6%B0%E0%A7%8D%E0%A6%A8-%E0%A6%86%E0%A6%A4%E0%A6%B6%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BF-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A3-%E0%A6%93-%E0%A6%A8%E0%A7%80%E0%A6%B0%E0%A6%AC-%E0%A6%8F%E0%A6%B2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>টিভিতে আজকের খেলা (১৬ নভেম্বর, ২০২৬)</title>
      <link>https://www.banglatribune.com/sport/other-sports/981118/%E0%A6%9F%E0%A6%BF%E0%A6%AD%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%9C%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A6%BE-%E0%A7%A7%E0%A7%AC-%E0%A6%A8%E0%A6%AD%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A7%A8%E0%A7%A6%E0%A7%A8%E0%A7%AC</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/other-sports/981118/%E0%A6%9F%E0%A6%BF%E0%A6%AD%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%9C%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A6%BE-%E0%A7%A7%E0%A7%AC-%E0%A6%A8%E0%A6%AD%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A7%A8%E0%A7%A6%E0%A7%A8%E0%A7%AC</guid>

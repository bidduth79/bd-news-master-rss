      <pubDate>Wed, 18 Nov 2026 18:39:34 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/b00bb77f40528e79369b93c8aff8add9-6afd9c49223da.jpg?jadewits_media_id=1055702" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/b00bb77f40528e79369b93c8aff8add9-6afd9c49223da.jpg?jadewits_media_id=1055702" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/b00bb77f40528e79369b93c8aff8add9-6afd9c49223da.jpg?jadewits_media_id=1055702" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নাশকতার উদ্দেশ্যে সীমান্ত দিয়ে ঢাকায় গান পাউডার আসছে: ডিবি" /&gt;&lt;/p&gt;&lt;p&gt;দেশে নাশকতার উদ্দেশে সীমান্তবর্তী এলাকা থেকে গান পাউডার নিয়ে আসা হচ্ছে বলে জানিয়েছেন ঢাকা মহানগর পুলিশের (ডিএমপি) গোয়েন্দা শাখার (ডিবি) প্রধান শফিকুল ইসলাম। তিনি বলেন, &amp;lsquo;দুই কেজির বেশি গান পাউডারসহ তিনজনকে গ্রেফতার করা হয়েছে। তাদের একজনের হোয়াটসঅ্যাপ থেকে গান পাউডার বিতরণের তথ্য পাওয়া গেছে&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/981763/%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%B8%E0%A7%80%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A6%BE%E0%A6%A8-%E0%A6%AA%E0%A6%BE%E0%A6%89%E0%A6%A1%E0%A6%BE%E0%A6%B0">বাংলা ট্রিবিউন</source>

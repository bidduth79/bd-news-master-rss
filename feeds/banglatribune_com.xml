      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/03/26/14f795722664e894e73b7aea737b7c52-69c4739fab600.jpg?jadewits_media_id=1016785" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/03/26/14f795722664e894e73b7aea737b7c52-69c4739fab600.jpg?jadewits_media_id=1016785" medium="image" />

    <item>
      <title>পুরুষকে ঘিরে ঈর্ষা-দ্বন্দ্ব: যুক্তরা‌জ্যে বাড়‌ছে নারীর হাতে নারী খু‌ন</title>
      <link>https://www.banglatribune.com/foreign/uk/980924/%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%81%E0%A6%B7%E0%A6%95%E0%A7%87-%E0%A6%98%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A6%88%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8D%E0%A6%AC-%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E2%80%8C%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E2%80%8C%E0%A6%9B%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/uk/980924/%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%81%E0%A6%B7%E0%A6%95%E0%A7%87-%E0%A6%98%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A6%88%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8D%E0%A6%AC-%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E2%80%8C%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E2%80%8C%E0%A6%9B%E0%A7%87</guid>
      <pubDate>Sat, 14 Nov 2026 20:44:54 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/d0fd1cafda4d957d210f3beceaa720ff-6af87322bd811.jpg?jadewits_media_id=1054986" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/d0fd1cafda4d957d210f3beceaa720ff-6af87322bd811.jpg?jadewits_media_id=1054986" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/d0fd1cafda4d957d210f3beceaa720ff-6af87322bd811.jpg?jadewits_media_id=1054986" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পুরুষকে ঘিরে ঈর্ষা-দ্বন্দ্ব: যুক্তরা‌জ্যে বাড়‌ছে নারীর হাতে নারী খু‌ন" /&gt;&lt;/p&gt;&lt;p&gt;প্রেম ও সম্পর্কজনিত বিরোধের জেরে এক নারীর হাতে আরেক নারী হত্যার অভিযোগ ঘিরে ইংল্যান্ড ও আয়ারল্যান্ডে দুটি মামলা চলছে। দুই মামলাতেই অভিযোগের কেন্দ্রে রয়েছে প্রেমের সম্পর্ক, ঈর্ষা ও পূর্বপরিকল্পিত হামলা। ঘটনাগুলো নতুন করে প্রশ্ন তুলেছে, প্রেমের প্রতিদ্বন্দ্বিতায় কেন এক নারী আরেক নারীর হত্যার অভিযোগে অ&lt;/p&gt;</description>

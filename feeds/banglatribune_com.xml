      <guid isPermaLink="true">https://www.banglatribune.com/country/chitagong/981852/%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A3%E0%A6%BF%E0%A6%95-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%AA%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%A1.-%E0%A6%87%E0%A6%89%E0%A6%A8%E0%A7%82%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A7%9F</guid>
      <pubDate>Thu, 19 Nov 2026 02:54:33 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/6f41e9e7821710307749cb211c073d98-6afe103f41a57.jpg?jadewits_media_id=1055780" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/6f41e9e7821710307749cb211c073d98-6afe103f41a57.jpg?jadewits_media_id=1055780" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/6f41e9e7821710307749cb211c073d98-6afe103f41a57.jpg?jadewits_media_id=1055780" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সার্বক্ষণিক পুলিশ পাহারায় থাকা ড. ইউনূসের বাসায় কীভাবে আগুন দিলো দুর্বৃত্তরা?" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রাম নগরীতে সাবেক অন্তর্বর্তী সরকারের প্রধান উপদেষ্টা অধ্যাপক মুহাম্মদ ইউনূসের পৈতৃক বাড়িতে আগুন দিয়েছে দুর্বৃত্তরা। তবে সার্বক্ষণিক পুলিশ পাহারায় থাকার পরও বাসাটিতে অগ্নিসংযোগের ঘটনা কীভাবে ঘটলো তা নিয়ে প্রশ্ন উঠেছে। তবে পুলিশ বলছে, কার্যক্রম নিষিদ্ধ আওয়ামী লীগের নেতাকর্মীরা পেট্রোল বোমা ছুড়েছ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/chitagong/981852/%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A3%E0%A6%BF%E0%A6%95-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%AA%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%A1.-%E0%A6%87%E0%A6%89%E0%A6%A8%E0%A7%82%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A7%9F">বাংলা ট্রিবিউন</source>

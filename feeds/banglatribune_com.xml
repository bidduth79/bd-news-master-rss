    <item>
      <title>রামপুরায় পুলিশ বক্সের সামনে বাসে আগুন</title>
      <link>https://www.banglatribune.com/law-and-crime/981614/%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%AC%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/981614/%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%AC%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</guid>
      <pubDate>Wed, 18 Nov 2026 01:28:53 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/5921f4cce81dda5b60dc21a442db05fd-6afcaaec6e474.jpg?jadewits_media_id=1055568" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/5921f4cce81dda5b60dc21a442db05fd-6afcaaec6e474.jpg?jadewits_media_id=1055568" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/5921f4cce81dda5b60dc21a442db05fd-6afcaaec6e474.jpg?jadewits_media_id=1055568" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রামপুরায় পুলিশ বক্সের সামনে বাসে আগুন" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর রামপুরা পুলিশ বক্সের সামনে রাইদা পরিবহনের একটি বাসে আগুন দিয়েছে দুর্বৃত্তরা। মঙ্গলবার (১৮ নভেম্বর) রাত সোয়া ১১টার দিকে এ ঘটনা ঘটে। রামপুরা থানার ওসি জাহাঙ্গীর আলম এ তথ্য নিশ্চিত করেছেন।  
তিনি জানান, দুর্বৃত্তরা বাসে আগুন দিয়েছে। আমরা সড়কে নিরাপত্তা জোরদার করেছি।  
 						বিস্তারিত&lt;/p&gt;</description>

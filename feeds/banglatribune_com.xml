    <item>
      <title>নারায়ণগঞ্জে শামীম ওসমানের বাড়িতে আগুন</title>
      <link>https://www.banglatribune.com/country/dhaka/981841/%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A6%A3%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%B6%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%AE-%E0%A6%93%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/dhaka/981841/%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A6%A3%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%B6%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%AE-%E0%A6%93%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</guid>
      <pubDate>Wed, 18 Nov 2026 23:06:17 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/6eb412116e51ecf723555ee98c4077a8-6afddb04af71c.jpg?jadewits_media_id=1055772" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/6eb412116e51ecf723555ee98c4077a8-6afddb04af71c.jpg?jadewits_media_id=1055772" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/6eb412116e51ecf723555ee98c4077a8-6afddb04af71c.jpg?jadewits_media_id=1055772" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নারায়ণগঞ্জে শামীম ওসমানের বাড়িতে আগুন" /&gt;&lt;/p&gt;&lt;p&gt;নারায়ণগঞ্জ-৪ আসনের সাবেক সংসদ সদস্য ও কার্যক্রম নিষিদ্ধ আওয়ামী লীগ নেতা এ কে এম শামীম ওসমানের বাড়িতে আগুন দিয়েছে একদল যুবক।
বুধবার (১৮ নভেম্বর) রাতে ফতুল্লার জামতলা এলাকায় সাবেক সংসদ সদস্যের পরিত্যক্ত বাড়িতে আগুন দেওয়া হয়।
স্থানীয় সূত্রে জানা গেছে, রাতে &amp;nbsp;সরকারি কদম রসুল কলেজ ছাত্র সংসদের সাবেক &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/dhaka/981841/%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A6%A3%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%B6%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%AE-%E0%A6%93%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>পদ্মা সেতু হয়ে সকল রুটে বাস চলাচল বন্ধ, মালিক সমিতি বলছে ‘নিরাপত্তার অভাব’</title>
      <link>https://www.banglatribune.com/country/khulna/981840/%E0%A6%AA%E0%A6%A6%E0%A7%8D%E0%A6%AE%E0%A6%B8%E0%A7%87%E0%A6%A4%E0%A7%81-%E0%A6%B9%E0%A7%9F%E0%A7%87-%E0%A6%B8%E0%A6%95%E0%A6%B2-%E0%A6%B0%E0%A7%81%E0%A6%9F%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B8-%E0%A6%9A%E0%A6%B2%E0%A6%BE%E0%A6%9A%E0%A6%B2-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7-%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%95-%E0%A6%B8%E0%A6%AE%E0%A6%BF%E0%A6%A4%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/khulna/981840/%E0%A6%AA%E0%A6%A6%E0%A7%8D%E0%A6%AE%E0%A6%B8%E0%A7%87%E0%A6%A4%E0%A7%81-%E0%A6%B9%E0%A7%9F%E0%A7%87-%E0%A6%B8%E0%A6%95%E0%A6%B2-%E0%A6%B0%E0%A7%81%E0%A6%9F%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B8-%E0%A6%9A%E0%A6%B2%E0%A6%BE%E0%A6%9A%E0%A6%B2-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7-%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%95-%E0%A6%B8%E0%A6%AE%E0%A6%BF%E0%A6%A4%E0%A6%BF</guid>
      <pubDate>Wed, 18 Nov 2026 23:06:50 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/aa80cb281a84e10cc2f6dce2a97d183a-6afddb1ac2154.jpg?jadewits_media_id=1055773" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/aa80cb281a84e10cc2f6dce2a97d183a-6afddb1ac2154.jpg?jadewits_media_id=1055773" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/aa80cb281a84e10cc2f6dce2a97d183a-6afddb1ac2154.jpg?jadewits_media_id=1055773" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পদ্মা সেতু হয়ে সকল রুটে বাস চলাচল বন্ধ, মালিক সমিতি বলছে ‘নিরাপত্তার অভাব’" /&gt;&lt;/p&gt;&lt;p&gt;নিরাপত্তাজনিত কারণে খুলনা থেকে পদ্মা সেতু হয়ে চলাচলকারী সব রুটে বাস চলাচল বন্ধ রেখেছে বাস মালিক সমিতি। এতে ভোগান্তিতে পড়েছেন স্বল্প সময়ের মধ্যে ঢাকা-খুলনাসহ চট্টগ্রাম-কক্সবাজার যাতায়াতকারী যাত্রীরা। গোপালগঞ্জ হয়ে বরিশালেও কোনও বাস চলাচল করছে না। ফলে অনেকেই খুলনার বাস টার্মিনালসহ বিভিন্ন পয়েন্টের কাউ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/khulna/981840/%E0%A6%AA%E0%A6%A6%E0%A7%8D%E0%A6%AE%E0%A6%B8%E0%A7%87%E0%A6%A4%E0%A7%81-%E0%A6%B9%E0%A7%9F%E0%A7%87-%E0%A6%B8%E0%A6%95%E0%A6%B2-%E0%A6%B0%E0%A7%81%E0%A6%9F%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B8-%E0%A6%9A%E0%A6%B2%E0%A6%BE%E0%A6%9A%E0%A6%B2-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7-%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%95-%E0%A6%B8%E0%A6%AE%E0%A6%BF%E0%A6%A4%E0%A6%BF">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>মহাসড়কে বিশ্ববিদ্যালয়ের বাসে আগুন দেওয়ার চেষ্টা, অল্পের জন্য বাঁচলেন শিক্ষার্থীরা</title>
      <link>https://www.banglatribune.com/country/chitagong/981839/%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A7%9C%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%9A%E0%A7%87%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/chitagong/981839/%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A7%9C%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%9A%E0%A7%87%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BE</guid>
      <pubDate>Wed, 18 Nov 2026 22:58:31 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/917bb289d55880780789a8d76ba7ce45-6afdd9253320d.jpg?jadewits_media_id=1055769" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/917bb289d55880780789a8d76ba7ce45-6afdd9253320d.jpg?jadewits_media_id=1055769" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/917bb289d55880780789a8d76ba7ce45-6afdd9253320d.jpg?jadewits_media_id=1055769" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মহাসড়কে বিশ্ববিদ্যালয়ের বাসে আগুন দেওয়ার চেষ্টা, অল্পের জন্য বাঁচলেন শিক্ষার্থীরা" /&gt;&lt;/p&gt;&lt;p&gt;কুমিল্লা শহরের কান্দিরপাড় থেকে ক্যাম্পাসে ফেরার পথে কুমিল্লা বিশ্ববিদ্যালয়ের (কুবি) শিক্ষার্থী বহনকারী একটি বাসে আগুন দেওয়ার চেষ্টা করেছে দুর্বৃত্তরা। এতে অল্পের জন্য প্রাণে রক্ষা পেয়েছেন বাসে থাকা শিক্ষার্থীরা।
বুধবার (১৮ নভেম্বর) রাত ৯টার দিকে ঢাকা-চট্টগ্রাম মহাসড়কের কুমিল্লার কোটবাড়ি এলাকায় বিএসট&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/chitagong/981839/%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A7%9C%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%9A%E0%A7%87%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BE">বাংলা ট্রিবিউন</source>
    </item>

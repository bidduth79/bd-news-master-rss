    <item>
      <title>খুলনায় ২৪ ঘণ্টায় গ্রেফতার ৪২; উদ্ধার গাঁজা-ইয়াবা</title>
      <link>https://www.banglatribune.com/country/khulna/982871/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A7%A8%E0%A7%AA-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A7%AA%E0%A7%A8-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0-%E0%A6%97%E0%A6%BE%E0%A6%81%E0%A6%9C%E0%A6%BE-%E0%A6%87%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/khulna/982871/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A7%A8%E0%A7%AA-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A7%AA%E0%A7%A8-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0-%E0%A6%97%E0%A6%BE%E0%A6%81%E0%A6%9C%E0%A6%BE-%E0%A6%87%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A6%BE</guid>
      <pubDate>Tue, 24 Nov 2026 10:43:25 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/0c62361b8459f804f7a311776d002587-6b0515e502216.jpg?jadewits_media_id=1056630" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/0c62361b8459f804f7a311776d002587-6b0515e502216.jpg?jadewits_media_id=1056630" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/0c62361b8459f804f7a311776d002587-6b0515e502216.jpg?jadewits_media_id=1056630" style="max-width:100%;height:auto;margin-bottom:10px;" alt="খুলনায় ২৪ ঘণ্টায় গ্রেফতার ৪২; উদ্ধার গাঁজা-ইয়াবা" /&gt;&lt;/p&gt;&lt;p&gt;খুলনা জেলা পুলিশের গত ২৪ ঘণ্টার বিশেষ অভিযানে ৪২ জনকে গ্রেফতার করা হয়েছে। এ সময় ১০ কেজি ২০ গ্রাম গাঁজা ও ১০ পিস ইয়াবা উদ্ধার করেছে পুলিশ। একই সময়ে বিভিন্ন সড়কে ৬৪০টি যানবাহনে তল্লাশি চালানো হয়েছে।
খুলনা জেলা পুলিশের এএসপি আবির সিদ্দিক শুভ্র জানান, জেলার সার্বিক আইনশৃঙ্খলা পরিস্থিতি স্বাভাবিক রাখা এব&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/khulna/982871/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A7%A8%E0%A7%AA-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A7%AA%E0%A7%A8-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0-%E0%A6%97%E0%A6%BE%E0%A6%81%E0%A6%9C%E0%A6%BE-%E0%A6%87%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A6%BE">বাংলা ট্রিবিউন</source>

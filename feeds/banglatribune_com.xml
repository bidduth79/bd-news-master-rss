      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/909fe7f434e1fc3b4e1d21df3deadbf6-6af072a481f3b.jpg?jadewits_media_id=1053905" length="0" type="image/jpeg" />

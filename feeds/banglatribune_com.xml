    <item>
      <title>কোথায় গিয়ে দাঁড়াবে দেশের পোশাক খাত</title>
      <link>https://www.banglatribune.com/business/industry-and-trade/982275/%E0%A6%95%E0%A7%8B%E0%A6%A5%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%97%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%A6%E0%A6%BE%E0%A6%81%E0%A6%A1%E0%A6%BC%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%95-%E0%A6%96%E0%A6%BE%E0%A6%A4</link>
      <guid isPermaLink="true">https://www.banglatribune.com/business/industry-and-trade/982275/%E0%A6%95%E0%A7%8B%E0%A6%A5%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%97%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%A6%E0%A6%BE%E0%A6%81%E0%A6%A1%E0%A6%BC%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%95-%E0%A6%96%E0%A6%BE%E0%A6%A4</guid>
      <pubDate>Sat, 21 Nov 2026 06:25:25 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/05/23/682fbc6b1a6a218a47dc74c63c837002-6a11cf9276119.jpg?jadewits_media_id=1025291" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/05/23/682fbc6b1a6a218a47dc74c63c837002-6a11cf9276119.jpg?jadewits_media_id=1025291" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/05/23/682fbc6b1a6a218a47dc74c63c837002-6a11cf9276119.jpg?jadewits_media_id=1025291" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কোথায় গিয়ে দাঁড়াবে দেশের পোশাক খাত" /&gt;&lt;/p&gt;&lt;p&gt;মজুরি বৃদ্ধির দাবিতে শ্রমিক অসন্তোষে বড় ধরনের সংকটে পড়েছে দেশের তৈরি পোশাকশিল্প। সাভার, আশুলিয়া, গাজীপুর ও মিরপুর শিল্পাঞ্চলে একের পর এক কারখানায় উৎপাদন বন্ধ হচ্ছে। কোথাও শ্রমিকদের বিক্ষোভ ও সংঘর্ষ, কোথাও নিরাপত্তার শঙ্কায় কারখানায় ছুটি ঘোষণা করছেন মালিকরা। কয়েক সপ্তাহের অস্থিরতায় পোশাক খাতে ৩ থেকে &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/business/industry-and-trade/982275/%E0%A6%95%E0%A7%8B%E0%A6%A5%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%97%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%A6%E0%A6%BE%E0%A6%81%E0%A6%A1%E0%A6%BC%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%95-%E0%A6%96%E0%A6%BE%E0%A6%A4">বাংলা ট্রিবিউন</source>
    </item>

      <guid isPermaLink="true">https://www.banglatribune.com/country/khulna/981167/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE-%E0%A6%A8%E0%A6%97%E0%A6%B0-%E0%A6%AD%E0%A6%AC%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B2-%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA-%E0%A6%A7%E0%A6%B0%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%9B%E0%A7%87</guid>
      <pubDate>Mon, 16 Nov 2026 01:32:13 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/af50e7347fa2b019890e824d56fcc106-6afa08a4d6107.jpg?jadewits_media_id=1055196" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/af50e7347fa2b019890e824d56fcc106-6afa08a4d6107.jpg?jadewits_media_id=1055196" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/af50e7347fa2b019890e824d56fcc106-6afa08a4d6107.jpg?jadewits_media_id=1055196" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এবার খুলনা নগর ভবনে পেট্রোল বোমা নিক্ষেপ, ধরে গেছে আগুন" /&gt;&lt;/p&gt;&lt;p&gt;এবার খুলনা নগর ভবনে পেট্রোল বোমা নিক্ষেপ করেছে দুর্বৃত্তরা। নিক্ষিপ্ত বোমাটি নগর ভবনের সামনের বড় সিঁড়ির মাঝে পড়ে বিস্ফোরিত হয়। সঙ্গে সঙ্গে আগুন ছড়িয়ে পড়েছে।
রবিবার (১৫ নভেম্বর) দিনগত রাত সাড়ে ১২টার দিকে এ ঘটনা ঘটে। তবে এই ঘটনায় কোনও ক্ষয়ক্ষতির খবর পাওয়া যায়নি। নিরাপত্তারক্ষীরা দ্রুত আগুন নিভিয়ে ফেলে&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/khulna/981167/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE-%E0%A6%A8%E0%A6%97%E0%A6%B0-%E0%A6%AD%E0%A6%AC%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B2-%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA-%E0%A6%A7%E0%A6%B0%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%9B%E0%A7%87">বাংলা ট্রিবিউন</source>

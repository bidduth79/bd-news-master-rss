    <item>
      <title>আরেক জেলায় বিএনপির মিছিলে হামলা আ.লীগের, ১৫টি গাড়ি ভাঙচুর: তিনটিতে আগুন</title>
      <link>https://www.banglatribune.com/country/chitagong/982430/%E0%A6%86%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A6%B2%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A7%A7%E0%A7%AB%E0%A6%9F%E0%A6%BF-%E0%A6%97%E0%A6%BE%E0%A7%9C%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/chitagong/982430/%E0%A6%86%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A6%B2%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A7%A7%E0%A7%AB%E0%A6%9F%E0%A6%BF-%E0%A6%97%E0%A6%BE%E0%A7%9C%E0%A6%BF</guid>
      <pubDate>Sat, 21 Nov 2026 23:11:50 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/5bc694dd9c65ff10286f7626ab19a9df-6b01cf5ebb381.jpg?jadewits_media_id=1056267" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/5bc694dd9c65ff10286f7626ab19a9df-6b01cf5ebb381.jpg?jadewits_media_id=1056267" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/5bc694dd9c65ff10286f7626ab19a9df-6b01cf5ebb381.jpg?jadewits_media_id=1056267" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আরেক জেলায় বিএনপির মিছিলে হামলা আ.লীগের, ১৫টি গাড়ি ভাঙচুর: তিনটিতে আগুন" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রামের ফটিকছড়িতে সন্ত্রাস ও নৈরাজ্যের প্রতিবাদে বিএনপির নেতাকর্মীদের বের করা মিছিলে হামলা করেছেন কার্যক্রম নিষিদ্ধ আওয়ামী লীগের নেতাকর্মীরা। এ সময় তিনটি মোটরসাইকেলে আগুন দেওয়ার পাশাপাশি ১৫টি মোটরসাইকেল ভাঙচুর করা হয়েছে। হামলায় বিএনপি ও অঙ্গ সহযোগী সংগঠনের পাঁচজন নেতাকর্মী আহত হয়েছেন বলে জানিয়েছ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/chitagong/982430/%E0%A6%86%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A6%B2%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A7%A7%E0%A7%AB%E0%A6%9F%E0%A6%BF-%E0%A6%97%E0%A6%BE%E0%A7%9C%E0%A6%BF">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>শেখ হাসিনাকে নিয়ে পাগলা মসজিদের দানবাক্সে চিঠি, কী লেখা তাতে</title>
      <link>https://www.banglatribune.com/country/dhaka/982429/%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%97%E0%A6%B2%E0%A6%BE-%E0%A6%AE%E0%A6%B8%E0%A6%9C%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A7%87-%E0%A6%9A%E0%A6%BF%E0%A6%A0%E0%A6%BF-%E0%A6%95%E0%A7%80</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/dhaka/982429/%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%97%E0%A6%B2%E0%A6%BE-%E0%A6%AE%E0%A6%B8%E0%A6%9C%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A7%87-%E0%A6%9A%E0%A6%BF%E0%A6%A0%E0%A6%BF-%E0%A6%95%E0%A7%80</guid>
      <pubDate>Sat, 21 Nov 2026 23:06:41 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/5b51dccf36bbabc499e1daaf58772990-6b01cf0f0da27.png?jadewits_media_id=1056266" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/5b51dccf36bbabc499e1daaf58772990-6b01cf0f0da27.png?jadewits_media_id=1056266" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/5b51dccf36bbabc499e1daaf58772990-6b01cf0f0da27.png?jadewits_media_id=1056266" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শেখ হাসিনাকে নিয়ে পাগলা মসজিদের দানবাক্সে চিঠি, কী লেখা তাতে" /&gt;&lt;/p&gt;&lt;p&gt;কিশোপারগঞ্জের ঐতিহ্যবাহী পাগলা মসজিদের দান বাক্স থেকে এবার মিলেছে ১৮ কোটি ২১ লাখ ৬৯ হাজার ৫১৭ টাকা। এছাড়াও রয়েছে বিপুল পরিমাণ স্বর্ণালঙ্কার ও বৈদেশিক মুদ্রা। আজ সকাল ৯টায় শুরু হয়ে ১৩ ঘণ্টায় ৫১টি বস্তার টাকা গণনা শেষে চূড়ান্ত হিসাব দেন জেলা প্রশাসক সোহানা নাসরিন।
এর আগে সকালে দানবাক্স খুলে সেখানে পাও&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/dhaka/982429/%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%97%E0%A6%B2%E0%A6%BE-%E0%A6%AE%E0%A6%B8%E0%A6%9C%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A7%87-%E0%A6%9A%E0%A6%BF%E0%A6%A0%E0%A6%BF-%E0%A6%95%E0%A7%80">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>স্মৃতিচারণে আবেগাপ্লুত প্রধানমন্ত্রী, বললেন ‘এটাই ছিল মায়ের জীবনের শেষ অনুষ্ঠান’</title>
      <link>https://www.banglatribune.com/national/982428/%E0%A6%B8%E0%A7%8D%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%86%E0%A6%AC%E0%A7%87%E0%A6%97%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A7%81%E0%A6%A4-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A7%87%E0%A6%A8-%E2%80%98%E0%A6%8F%E0%A6%9F%E0%A6%BE%E0%A6%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/national/982428/%E0%A6%B8%E0%A7%8D%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%86%E0%A6%AC%E0%A7%87%E0%A6%97%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A7%81%E0%A6%A4-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A7%87%E0%A6%A8-%E2%80%98%E0%A6%8F%E0%A6%9F%E0%A6%BE%E0%A6%87</guid>
      <pubDate>Sat, 21 Nov 2026 22:51:10 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/a9d4c29928b29261672aeb9c8a9d52bf-6b01cb3fb7b40.jpg?jadewits_media_id=1056261" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/a9d4c29928b29261672aeb9c8a9d52bf-6b01cb3fb7b40.jpg?jadewits_media_id=1056261" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/a9d4c29928b29261672aeb9c8a9d52bf-6b01cb3fb7b40.jpg?jadewits_media_id=1056261" style="max-width:100%;height:auto;margin-bottom:10px;" alt="স্মৃতিচারণে আবেগাপ্লুত প্রধানমন্ত্রী, বললেন ‘এটাই ছিল মায়ের জীবনের শেষ অনুষ্ঠান’" /&gt;&lt;/p&gt;&lt;p&gt;প্রয়াত মা ও সাবেক প্রধানমন্ত্রী বেগম খালেদা জিয়ার স্মৃতিচারণ করতে গিয়ে আবেগাপ্লুত হয়ে পড়েছেন প্রধানমন্ত্রী তারেক রহমান। মায়ের সঙ্গে সশস্ত্র বাহিনী দিবসের স্মৃতিবিজড়িত মুহূর্তের কথা উল্লেখ করে প্রধানমন্ত্রী জানান, ২০২৫ সালের সশস্ত্র বাহিনী দিবসের অনুষ্ঠানটিই ছিল তার মায়ের জীবনের শেষ অনুষ্ঠান।
শনিবার &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/982428/%E0%A6%B8%E0%A7%8D%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%86%E0%A6%AC%E0%A7%87%E0%A6%97%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A7%81%E0%A6%A4-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A7%87%E0%A6%A8-%E2%80%98%E0%A6%8F%E0%A6%9F%E0%A6%BE%E0%A6%87">বাংলা ট্রিবিউন</source>
    </item>

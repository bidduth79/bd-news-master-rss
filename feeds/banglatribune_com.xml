      <guid isPermaLink="true">https://www.banglatribune.com/entertainment/hollywood/981341/%E0%A6%9C%E0%A6%A8%E0%A6%BF-%E0%A6%A1%E0%A7%87%E0%A6%AA%E0%A7%87%E0%A6%B0-%E2%80%98%E0%A6%8F%E0%A6%AC%E0%A7%87%E0%A6%A8%E0%A7%87%E0%A6%9C%E0%A6%BE%E0%A6%B0%E2%80%99-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A6%A4-%E0%A6%86%E0%A7%9F</guid>
      <pubDate>Tue, 17 Nov 2026 09:00:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/40f64c9208851fda6afd17731aeecf86-6afb0f50387f6.jpg?jadewits_media_id=1055344" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/40f64c9208851fda6afd17731aeecf86-6afb0f50387f6.jpg?jadewits_media_id=1055344" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/40f64c9208851fda6afd17731aeecf86-6afb0f50387f6.jpg?jadewits_media_id=1055344" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জনি ডেপের ‘এবেনেজার’, বাংলাদেশি টাকায় কত আয়" /&gt;&lt;/p&gt;&lt;p&gt;জনি ডেপের &amp;lsquo;এবেনেজার&amp;rsquo; বিশ্বজুড়ে বক্স অফিসের শীর্ষস্থান দখল করেছে। টিম ওয়েস্ট পরিচালিত ছবিটি প্রথম সপ্তাহান্তে বিশ্বজুড়ে আনুমানিক ৪ কোটি ২০ লাখ ডলার আয় করেছে। এটি বাংলাদেশি টাকায় প্রায় ৫২৫ কোটি।
চার্লস ডিকেন্সের বিখ্যাত উপন্যাস &amp;lsquo;আ ক্রিসমাস ক্যারল&amp;rsquo;-এর অন্ধকারাচ্ছন্ন নতুন রূপায়ণ &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/entertainment/hollywood/981341/%E0%A6%9C%E0%A6%A8%E0%A6%BF-%E0%A6%A1%E0%A7%87%E0%A6%AA%E0%A7%87%E0%A6%B0-%E2%80%98%E0%A6%8F%E0%A6%AC%E0%A7%87%E0%A6%A8%E0%A7%87%E0%A6%9C%E0%A6%BE%E0%A6%B0%E2%80%99-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A6%A4-%E0%A6%86%E0%A7%9F">বাংলা ট্রিবিউন</source>

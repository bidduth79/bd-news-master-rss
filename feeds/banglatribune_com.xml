      <guid isPermaLink="true">https://www.banglatribune.com/foreign/asia/980860/%E0%A6%AF%E0%A7%87%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%B0%E0%A7%87-%E0%A6%AF%E0%A7%87%E0%A6%A4%E0%A7%87%E0%A6%87-%E0%A6%B2%E0%A6%BE%E0%A6%97%E0%A7%87-%E0%A6%AD%E0%A6%BF%E0%A6%B8%E0%A6%BE-%E0%A7%A7%E0%A7%AA</guid>

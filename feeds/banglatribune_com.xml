    <item>
      <title>গুলেরের দুর্দান্ত ফ্রি-কিকেও হার এড়াতে পারলো না তুরস্ক, বেলজিয়ামের জয়</title>
      <link>https://www.banglatribune.com/sport/football/980615/%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A7%87%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BF-%E0%A6%95%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%93-%E0%A6%B9%E0%A6%BE%E0%A6%B0-%E0%A6%8F%E0%A7%9C%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%B2%E0%A7%8B-%E0%A6%A8%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/football/980615/%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A7%87%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BF-%E0%A6%95%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%93-%E0%A6%B9%E0%A6%BE%E0%A6%B0-%E0%A6%8F%E0%A7%9C%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%B2%E0%A7%8B-%E0%A6%A8%E0%A6%BE</guid>
      <pubDate>Fri, 13 Nov 2026 03:24:27 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/46f48c5cb0336408d23e772846e37e1b-6af622c8ccd58.jpg?jadewits_media_id=1054729" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/46f48c5cb0336408d23e772846e37e1b-6af622c8ccd58.jpg?jadewits_media_id=1054729" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/46f48c5cb0336408d23e772846e37e1b-6af622c8ccd58.jpg?jadewits_media_id=1054729" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গুলেরের দুর্দান্ত ফ্রি-কিকেও হার এড়াতে পারলো না তুরস্ক, বেলজিয়ামের জয়" /&gt;&lt;/p&gt;&lt;p&gt;উয়েফা নেশন্স লিগে টানা পাঁচ ম্যাচে হারের মুখ দেখলো তুরস্ক। ঘরের মাঠে বেলজিয়ামের বিপক্ষে শুরুতে এগিয়ে গিয়েও শেষ পর্যন্ত ২-১ গোলে হেরেছে দলটি। তুরস্কের হয়ে দুর্দান্ত এক ফ্রি-কিকে গোল করেন আর্দা গুলের। তবে সাত মিনিটের ব্যবধানে দুই গোল করে ম্যাচের নিয়ন্ত্রণ নিয়ে নেয় বেলজিয়াম। দলটির হয়ে গোল করেন কেভিন ডি&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/football/980615/%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A7%87%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BF-%E0%A6%95%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%93-%E0%A6%B9%E0%A6%BE%E0%A6%B0-%E0%A6%8F%E0%A7%9C%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%B2%E0%A7%8B-%E0%A6%A8%E0%A6%BE">বাংলা ট্রিবিউন</source>
    </item>

    <item>
      <title>ভাড়া নিয়ে বিরোধ, চলন্ত বাস থেকে ফেলে দুই যাত্রীকে হত্যা</title>
      <link>https://www.banglatribune.com/country/rangpur/981029/%E0%A6%AD%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7-%E0%A6%9A%E0%A6%B2%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%AC%E0%A6%BE%E0%A6%B8-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/rangpur/981029/%E0%A6%AD%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7-%E0%A6%9A%E0%A6%B2%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%AC%E0%A6%BE%E0%A6%B8-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%87</guid>
      <pubDate>Sun, 15 Nov 2026 14:46:29 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/172c887191377be057059b2088278115-6af9714ed3d67.jpg?jadewits_media_id=1055082" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/172c887191377be057059b2088278115-6af9714ed3d67.jpg?jadewits_media_id=1055082" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/172c887191377be057059b2088278115-6af9714ed3d67.jpg?jadewits_media_id=1055082" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভাড়া নিয়ে বিরোধ, চলন্ত বাস থেকে ফেলে দুই যাত্রীকে হত্যা" /&gt;&lt;/p&gt;&lt;p&gt;রংপুরের তারাগঞ্জে চলন্ত বাস থেকে ধাক্কা দিয়ে ফেলে দুই যাত্রীকে হত্যার অভিযোগ উঠেছে। এ ঘটনায় বাসটির চালক ও হেলপারকে আটক করেছে পুলিশ। রবিবার (১৫ নভেম্বর) সকালে উপজেলার জিগাতলা এলাকায় রংপুর-দিনাজপুর মহাসড়কে এ ঘটনা ঘটে।
নিহত মুকুল মিয়া &amp;nbsp;(৩৩) &amp;nbsp;নীলফামারী সদর উপজেলার চড়াইখোলা ইউনিয়নের বসুনিয়াপাড়া&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/rangpur/981029/%E0%A6%AD%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7-%E0%A6%9A%E0%A6%B2%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%AC%E0%A6%BE%E0%A6%B8-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>

      <guid isPermaLink="true">https://www.banglatribune.com/country/dhaka/983443/%E2%80%98%E0%A6%AC%E0%A6%A1%E0%A6%BC-%E0%A6%B2%E0%A7%87%E0%A6%AD%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%87%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A6%BE%E2%80%99-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87</guid>

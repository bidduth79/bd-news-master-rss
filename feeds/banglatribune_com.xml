      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/979882/%E0%A6%AA%E0%A6%A6%E0%A7%8B%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A6%A4%E0%A6%BF%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%A4-%E0%A7%A7%E0%A7%A6-%E0%A6%B8%E0%A6%B9%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%95%E0%A6%AE%E0%A6%BF%E0%A6%B6%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A7%87-%E0%A6%B0%E2%80%8D%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95</guid>
      <pubDate>Mon, 09 Nov 2026 20:39:58 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/ac7c762431ca342dfe897aab7311ab82-6af1db10e1bf9.jpg?jadewits_media_id=1054095" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/ac7c762431ca342dfe897aab7311ab82-6af1db10e1bf9.jpg?jadewits_media_id=1054095" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/ac7c762431ca342dfe897aab7311ab82-6af1db10e1bf9.jpg?jadewits_media_id=1054095" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পদোন্নতিপ্রাপ্ত ১০ সহকারী পুলিশ কমিশনারকে র‍্যাংক ব্যাজ পরালেন ডিএমপি কমিশনার" /&gt;&lt;/p&gt;&lt;p&gt;ঢাকা মেট্রোপলিটন পুলিশের পদোন্নতিপ্রাপ্ত ১০ জন সহকারী পুলিশ কমিশনারকে র&amp;zwj;্যাংক ব্যাজ পরিয়ে দিয়েছেন ডিএমপি কমিশনার মোসলেহ্ উদ্দিন আহমদ।
আজ সোমবার (৯ নভেম্বর) দুপুর সাড়ে ১২ টায় ডিএমপি হেডকোয়ার্টার্সের সম্মেলন কক্ষে আয়োজিত এক অনুষ্ঠানে পদোন্নতিপ্রাপ্ত কর্মকর্তাদের &amp;nbsp;র&amp;zwj;্যাঙ্ক ব্যাজ পরিয়ে দেন &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/979882/%E0%A6%AA%E0%A6%A6%E0%A7%8B%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A6%A4%E0%A6%BF%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%A4-%E0%A7%A7%E0%A7%A6-%E0%A6%B8%E0%A6%B9%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%95%E0%A6%AE%E0%A6%BF%E0%A6%B6%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A7%87-%E0%A6%B0%E2%80%8D%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95">বাংলা ট্রিবিউন</source>

      <guid isPermaLink="true">https://www.banglatribune.com/foreign/982076/%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0</guid>
      <pubDate>Fri, 20 Nov 2026 05:36:47 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/dd5595b1927cb07b3f45b3a8fd351405-6aff876a301b5.jpg?jadewits_media_id=1055946" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/dd5595b1927cb07b3f45b3a8fd351405-6aff876a301b5.jpg?jadewits_media_id=1055946" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/dd5595b1927cb07b3f45b3a8fd351405-6aff876a301b5.jpg?jadewits_media_id=1055946" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সন্তানদের নির্যাতনের হাতিয়ার বানিয়ে স্ত্রীর ওপর অত্যাচার, যুক্তরাজ্যে যুবকের কারাদণ্ড" /&gt;&lt;/p&gt;&lt;p&gt;নিজের পাঁচ সন্তানকে নির্যাতনের হাতিয়ার হিসেবে ব্যবহার করে সঙ্গীর ওপর দীর্ঘদিন শারীরিক ও মানসিক নির্যাতন চালানোর দায়ে যুক্তরাজ্যে এক যুবককে ১৯ মাসের কারাদণ্ড দিয়েছেন আদালত। দণ্ডপ্রাপ্ত অ্যারন রেজিসের বয়স ২৭ বছর। পেশায় ডিজে অ্যারন কেন্টের র&amp;zwj;্যামসগেট এলাকার বাসিন্দা।
গত ১১ নভেম্বর ক্যান্টারবেরি ক্র&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/982076/%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0">বাংলা ট্রিবিউন</source>

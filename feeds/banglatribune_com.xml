    <item>
      <title>ভুটান-শ্রীলঙ্কার ড্রয়ে সেমিফাইনালে বাংলাদেশ</title>
      <link>https://www.banglatribune.com/sport/football/979692/%E0%A6%AD%E0%A7%81%E0%A6%9F%E0%A6%BE%E0%A6%A8-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B2%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%A1%E0%A7%8D%E0%A6%B0%E0%A7%9F%E0%A7%87-%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A6%BF%E0%A6%AB%E0%A6%BE%E0%A6%87%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/football/979692/%E0%A6%AD%E0%A7%81%E0%A6%9F%E0%A6%BE%E0%A6%A8-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B2%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%A1%E0%A7%8D%E0%A6%B0%E0%A7%9F%E0%A7%87-%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A6%BF%E0%A6%AB%E0%A6%BE%E0%A6%87%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6</guid>
      <pubDate>Sun, 08 Nov 2026 22:22:26 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/476f2513fb27c7a8a8e204aa57e28812-6af0a14f3ecf2.jpg?jadewits_media_id=1053940" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/476f2513fb27c7a8a8e204aa57e28812-6af0a14f3ecf2.jpg?jadewits_media_id=1053940" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/476f2513fb27c7a8a8e204aa57e28812-6af0a14f3ecf2.jpg?jadewits_media_id=1053940" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভুটান-শ্রীলঙ্কার ড্রয়ে সেমিফাইনালে বাংলাদেশ" /&gt;&lt;/p&gt;&lt;p&gt;সাফ চ্যাম্পিয়নশিপের সেমিফাইনালে ওঠার জন্য বাংলাদেশের অপেক্ষা ছিল ভুটান-শ্রীলঙ্কা ম্যাচের ফলের দিকে। আজ রবিবার দুই দলের লড়াইয়ে শেষ পর্যন্ত কেউ জিততে পারেনি। ২-২ গোলে ম্যাচটি ড্র হওয়ায় এক ম্যাচ হাতে রেখেই সেরা চারে জায়গা নিশ্চিত করেছে বাংলাদেশ।
জাতীয় স্টেডিয়ামে &amp;lsquo;এ&amp;rsquo; গ্রুপের ম্যাচে শুরুতে এগ&lt;/p&gt;</description>

    <item>
      <title>অস্ত্রের মুখে জিম্মি করে ঢাকা ট্রিবিউনের ৩ সাংবাদিককে নির্যাতন করেছে মাদক কারবারিরা</title>
      <link>https://www.banglatribune.com/law-and-crime/979702/%E0%A6%85%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%87-%E0%A6%9C%E0%A6%BF%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%BF-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%89%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A7%A9</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/979702/%E0%A6%85%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%87-%E0%A6%9C%E0%A6%BF%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%BF-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%89%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A7%A9</guid>
      <pubDate>Sun, 08 Nov 2026 23:29:17 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/f53094965d6470ad12fd42ab573c6b43-6af0b15b7886a.jpg?jadewits_media_id=1053950" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/f53094965d6470ad12fd42ab573c6b43-6af0b15b7886a.jpg?jadewits_media_id=1053950" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/f53094965d6470ad12fd42ab573c6b43-6af0b15b7886a.jpg?jadewits_media_id=1053950" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অস্ত্রের মুখে জিম্মি করে ঢাকা ট্রিবিউনের ৩ সাংবাদিককে নির্যাতন করেছে মাদক কারবারিরা" /&gt;&lt;/p&gt;&lt;p&gt;গাজীপুরের টঙ্গীতে মাদক কারবারের অনুসন্ধান করতে গিয়ে ইংরেজি দৈনিক ঢাকা ট্রিবিউনের তিন সাংবাদিককে তিন ঘণ্টা জিম্মি করে অস্ত্রের মুখে নির্যাতন ও হত্যার হুমকি দেওয়া হয়েছে। সেই সঙ্গে ঘুমের ওষুধ খাইয়ে ও বানোয়াট ভিডিও ধারণ করে চলে ব্ল্যাকমেইলের চেষ্টা। প্রায় দুই সপ্তাহ আগে ঠিক একই এলাকায় আরেক সাংবাদিক অপহৃ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/979702/%E0%A6%85%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%87-%E0%A6%9C%E0%A6%BF%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%BF-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%89%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A7%A9">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>‘ভারত ও বাংলাদেশকে ফাইনালে দেখতে চাইলে বাকি দলগুলোকে বাড়ি পাঠিয়ে দিন’</title>
      <link>https://www.banglatribune.com/sport/football/979701/%E2%80%98%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4-%E0%A6%93-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%95%E0%A7%87-%E0%A6%AB%E0%A6%BE%E0%A6%87%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%A4%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%95%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/football/979701/%E2%80%98%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4-%E0%A6%93-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%95%E0%A7%87-%E0%A6%AB%E0%A6%BE%E0%A6%87%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%A4%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%95%E0%A6%BF</guid>
      <pubDate>Sun, 08 Nov 2026 23:22:32 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/ef6cca78f80e3a1e5401155a313d319b-6af0af3b0ef94.jpg?jadewits_media_id=1053949" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/ef6cca78f80e3a1e5401155a313d319b-6af0af3b0ef94.jpg?jadewits_media_id=1053949" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/ef6cca78f80e3a1e5401155a313d319b-6af0af3b0ef94.jpg?jadewits_media_id=1053949" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘ভারত ও বাংলাদেশকে ফাইনালে দেখতে চাইলে বাকি দলগুলোকে বাড়ি পাঠিয়ে দিন’" /&gt;&lt;/p&gt;&lt;p&gt;সাফ চ্যাম্পিয়নশিপে ভুটানের বিপক্ষে শেষ মুহূর্তে &amp;nbsp;২-২ গোলে ড্র হওয়া ম্যাচের পর রেফারিং নিয়ে তীব্র অসন্তোষ প্রকাশ করেছেন শ্রীলঙ্কার কোচ আব্দুল্লাহ আল মুতাইরি। শুধু রেফারির সিদ্ধান্তই নয়, টুর্নামেন্টের আয়োজকদের বিরুদ্ধেও পক্ষপাতিত্বের অভিযোগ তুলেছেন তিনি।
ম্যাচ শেষে সংবাদ সম্মেলনে আল মুতাইরি বলেন,&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/football/979701/%E2%80%98%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4-%E0%A6%93-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%95%E0%A7%87-%E0%A6%AB%E0%A6%BE%E0%A6%87%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%A4%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%95%E0%A6%BF">বাংলা ট্রিবিউন</source>
    </item>

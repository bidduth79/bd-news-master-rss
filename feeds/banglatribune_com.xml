    <item>
      <title>জাল সনদে চাকরি, যবিপ্রবির ৭ জনের বিরুদ্ধে দুদকের চার্জশিট</title>
      <link>https://www.banglatribune.com/country/khulna/982455/%E0%A6%9C%E0%A6%BE%E0%A6%B2-%E0%A6%B8%E0%A6%A8%E0%A6%A6%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%95%E0%A6%B0%E0%A6%BF-%E0%A6%AF%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A7%AD-%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%A6%E0%A6%95%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/khulna/982455/%E0%A6%9C%E0%A6%BE%E0%A6%B2-%E0%A6%B8%E0%A6%A8%E0%A6%A6%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%95%E0%A6%B0%E0%A6%BF-%E0%A6%AF%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A7%AD-%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%A6%E0%A6%95%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Sun, 22 Nov 2026 08:48:24 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/8703e58259154b71ae70c8765c3537d3-6b0257dac6502.jpg?jadewits_media_id=1056287" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/8703e58259154b71ae70c8765c3537d3-6b0257dac6502.jpg?jadewits_media_id=1056287" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/8703e58259154b71ae70c8765c3537d3-6b0257dac6502.jpg?jadewits_media_id=1056287" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জাল সনদে চাকরি, যবিপ্রবির ৭ জনের বিরুদ্ধে দুদকের চার্জশিট" /&gt;&lt;/p&gt;&lt;p&gt;যশোর বিজ্ঞান ও প্রযুক্তি বিশ্ববিদ্যালয়ের (যবিপ্রবি) সনদ জালিয়াতির ঘটনায় সাবেক দুই রেজিস্ট্রারসহ সাতজনের বিরুদ্ধে আদালতে চার্জশিট দাখিল করেছে দুর্নীতি দমন কমিশন (দুদক)। অভিযুক্তদের মধ্যে রয়েছেন পাঁচ কর্মকর্তা-কর্মচারীর জাল সনদের বিষয়ে থানায় জিডি করা তৎকালীন রেজিস্ট্রার প্রকৌশলী আহসান হাবীবও।
শনিবার (&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/khulna/982455/%E0%A6%9C%E0%A6%BE%E0%A6%B2-%E0%A6%B8%E0%A6%A8%E0%A6%A6%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%95%E0%A6%B0%E0%A6%BF-%E0%A6%AF%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A7%AD-%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%A6%E0%A6%95%E0%A7%87%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>সাদিক কায়েমের বাড়িতে পেট্রোল বোমা নিক্ষেপ ও অগ্নিসংযোগের ঘটনায় জামায়াত সেক্রেটারির নিন্দা</title>
      <link>https://www.banglatribune.com/politics/jamat-e-islam/982454/%E0%A6%B8%E0%A6%BE%E0%A6%A6%E0%A6%BF%E0%A6%95-%E0%A6%95%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B2-%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA-%E0%A6%93</link>
      <guid isPermaLink="true">https://www.banglatribune.com/politics/jamat-e-islam/982454/%E0%A6%B8%E0%A6%BE%E0%A6%A6%E0%A6%BF%E0%A6%95-%E0%A6%95%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B2-%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA-%E0%A6%93</guid>
      <pubDate>Sun, 22 Nov 2026 08:48:20 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/08/10/6c5254c10869bc4cb143b99d128bbda0-6a79910927a2d.jpg?jadewits_media_id=1037772" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/08/10/6c5254c10869bc4cb143b99d128bbda0-6a79910927a2d.jpg?jadewits_media_id=1037772" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/08/10/6c5254c10869bc4cb143b99d128bbda0-6a79910927a2d.jpg?jadewits_media_id=1037772" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাদিক কায়েমের বাড়িতে পেট্রোল বোমা নিক্ষেপ ও অগ্নিসংযোগের ঘটনায় জামায়াত সেক্রেটারির নিন্দা" /&gt;&lt;/p&gt;&lt;p&gt;ডাকসুর ভিপি এবং বাংলাদেশ জামায়াতে ইসলামী মনোনীত ঢাকা দক্ষিণ সিটি করপোরেশনের মেয়র প্রার্থী সাদিক কায়েমের খাগড়াছড়ির গ্রামের বাড়িতে পেট্রোল বোমা নিক্ষেপ ও কেরোসিন ঢেলে অগ্নিসংযোগের ঘটনা ঘটেছে। এ ঘটনায় তীব্র নিন্দা জানিয়েছেন জামায়াতে সেক্রেটারি জেনারেল মিয়া গোলাম পরওয়ার।
রবিবার (২২ নভেম্বর) এক বিবৃ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/politics/jamat-e-islam/982454/%E0%A6%B8%E0%A6%BE%E0%A6%A6%E0%A6%BF%E0%A6%95-%E0%A6%95%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B2-%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA-%E0%A6%93">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>গাজায় খাবার বিতরণের গাড়িতে ইসরায়েলি হামলা, প্রাণ গেলো ৩ জনের</title>
      <link>https://www.banglatribune.com/foreign/middle-east/982453/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%96%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A6%B0%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%B2%E0%A6%BF-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/middle-east/982453/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%96%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A6%B0%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%B2%E0%A6%BF-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE</guid>
      <pubDate>Sun, 22 Nov 2026 08:42:30 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/8a3ca7e7f6a4c00fffd24dc3b2300c2a-6b0255cf3268c.jpg?jadewits_media_id=1056286" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/8a3ca7e7f6a4c00fffd24dc3b2300c2a-6b0255cf3268c.jpg?jadewits_media_id=1056286" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/8a3ca7e7f6a4c00fffd24dc3b2300c2a-6b0255cf3268c.jpg?jadewits_media_id=1056286" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গাজায় খাবার বিতরণের গাড়িতে ইসরায়েলি হামলা, প্রাণ গেলো ৩ জনের" /&gt;&lt;/p&gt;&lt;p&gt;গত বছরের যুদ্ধবিরতি লঙ্ঘন করে গাজায় ইসরায়েলি হামলায় অন্তত চার ফিলিস্তিনি নিহত হয়েছেন। এর মধ্যে বাস্তুচ্যুত মানুষের জন্য খাদ্যসহায়তা নিয়ে যাওয়া একটি গাড়িতে ইসরায়েলি ড্রোন হামলায় প্রাণ হারিয়েছেন অন্তত তিনজন। এদিকে শীতকালীন বৃষ্টিতে সৃষ্ট বন্যায় উপত্যকাটিতে মানবিক সংকট আরও গভীর হয়েছে। কাতারভিত্তিক সংবা&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/middle-east/982453/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%96%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A6%B0%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%B2%E0%A6%BF-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>যার আয় কম, তার করের চাপ বেশি</title>
      <link>https://www.banglatribune.com/business/business-all/982452/%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A7%9F-%E0%A6%95%E0%A6%AE-%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%BE%E0%A6%AA-%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.banglatribune.com/business/business-all/982452/%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A7%9F-%E0%A6%95%E0%A6%AE-%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%BE%E0%A6%AA-%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%BF</guid>
      <pubDate>Sun, 22 Nov 2026 08:37:55 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/12ba580e6543c5a3fe8873548b00ed58-6b0253bf7bb1c.jpg?jadewits_media_id=1056285" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/12ba580e6543c5a3fe8873548b00ed58-6b0253bf7bb1c.jpg?jadewits_media_id=1056285" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/12ba580e6543c5a3fe8873548b00ed58-6b0253bf7bb1c.jpg?jadewits_media_id=1056285" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যার আয় কম, তার করের চাপ বেশি" /&gt;&lt;/p&gt;&lt;p&gt;দেশে ধনী-গরিব সবাই পণ্য ও সেবা কেনার সময় মূল্য সংযোজন কর (ভ্যাট) দেন। কিন্তু এই করের বোঝা সবার জন্য সমান নয়। আয় যত কম, আয়ের তুলনায় ভ্যাটের চাপ তত বেশি। ফলে ধনীদের তুলনায় দরিদ্র মানুষকে নিজের আয়ের অনেক বড় অংশ পরোক্ষ কর হিসেবে দিতে হচ্ছে। অথচ যাদের আয় ও সম্পদ বেশি, তাদের ক্ষেত্রে এই চাপ তুলনামূলক অনেক&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/business/business-all/982452/%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A7%9F-%E0%A6%95%E0%A6%AE-%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%BE%E0%A6%AA-%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%BF">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ট্যুরিস্ট ভিসায় গিয়ে কাজ, মালয়েশিয়ায় ঝুঁকিতে দেড় লাখেরও বেশি বাংলাদেশি</title>
      <link>https://www.banglatribune.com/others/982413/%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%9F%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%9F-%E0%A6%AD%E0%A6%BF%E0%A6%B8%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A6%BE%E0%A6%9C%E0%A7%87-%E0%A6%97%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%9D%E0%A7%81%E0%A6%81%E0%A6%95%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%A1%E0%A6%BC</link>
      <guid isPermaLink="true">https://www.banglatribune.com/others/982413/%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%9F%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%9F-%E0%A6%AD%E0%A6%BF%E0%A6%B8%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A6%BE%E0%A6%9C%E0%A7%87-%E0%A6%97%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%9D%E0%A7%81%E0%A6%81%E0%A6%95%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%A1%E0%A6%BC</guid>
      <pubDate>Sun, 22 Nov 2026 08:00:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/06/22/8f31197197263023b4f93b80ba5fffed-6a39169783d45.jpg?jadewits_media_id=1030120" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/06/22/8f31197197263023b4f93b80ba5fffed-6a39169783d45.jpg?jadewits_media_id=1030120" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/06/22/8f31197197263023b4f93b80ba5fffed-6a39169783d45.jpg?jadewits_media_id=1030120" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ট্যুরিস্ট ভিসায় গিয়ে কাজ, মালয়েশিয়ায় ঝুঁকিতে দেড় লাখেরও বেশি বাংলাদেশি" /&gt;&lt;/p&gt;&lt;p&gt;মালয়েশিয়ায় ট্যুরিস্ট ভিসায় গিয়ে কাজ করায় ঝুঁকিতে রয়েছেন দেড় লাখেরও বেশি বাংলাদেশি। বৈধ ওয়ার্ক পারমিট ছাড়াই কারখানা, নির্মাণ সাইট, রেস্তোরাঁ ও বিভিন্ন প্রতিষ্ঠানে কাজ করায় প্রতিদিনই দেশটির অভিবাসন বিভাগের ধরপাকড়ে গ্রেফতার হচ্ছেন তারা। বড় অঙ্কের অর্থ খরচ করে দালালদের আশ্বাসে অনেকেই ট্যুরিস্&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/others/982413/%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%9F%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%9F-%E0%A6%AD%E0%A6%BF%E0%A6%B8%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A6%BE%E0%A6%9C%E0%A7%87-%E0%A6%97%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%9D%E0%A7%81%E0%A6%81%E0%A6%95%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%A1%E0%A6%BC">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>‘মেসির পর আর্জেন্টিনার স্বপ্ন হতে পারে এই দুই তরুণ’</title>
      <link>https://www.banglatribune.com/sport/football/982398/%E2%80%98%E0%A6%AE%E0%A7%87%E0%A6%B8%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%86%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%AA%E0%A7%8D%E0%A6%A8-%E0%A6%B9%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%8F%E0%A6%87-%E0%A6%A6%E0%A7%81%E0%A6%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/football/982398/%E2%80%98%E0%A6%AE%E0%A7%87%E0%A6%B8%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%86%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%AA%E0%A7%8D%E0%A6%A8-%E0%A6%B9%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%8F%E0%A6%87-%E0%A6%A6%E0%A7%81%E0%A6%87</guid>
      <pubDate>Sun, 22 Nov 2026 08:00:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/09/25/b4c8c0e09ecb5847d92871fd01e829c6-6ab69e213e895.JPG?jadewits_media_id=1045743" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/09/25/b4c8c0e09ecb5847d92871fd01e829c6-6ab69e213e895.JPG?jadewits_media_id=1045743" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/09/25/b4c8c0e09ecb5847d92871fd01e829c6-6ab69e213e895.JPG?jadewits_media_id=1045743" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘মেসির পর আর্জেন্টিনার স্বপ্ন হতে পারে এই দুই তরুণ’" /&gt;&lt;/p&gt;&lt;p&gt;লিওনেল মেসি ও ডিয়েগো ম্যারাডোনা আর্জেন্টিনার ফুটবল ইতিহাসের দুই মহাতারকা। তাদের সঙ্গে তুলনা করার আগে যে কারও দুবার ভাবার কথা। তবে ২২ বছর বয়সী নিকো পাজের প্রতিভা দেখে সেই তুলনাই টেনে আনলেন আর্জেন্টিনার সাবেক মিডফিল্ডার হুয়ান সেবাস্তিয়ান ভেরন। তার মতে, এই বয়সে পাজের মতো কিছু কাজ কেবল মেসি ও ম্যারাডোনা&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/football/982398/%E2%80%98%E0%A6%AE%E0%A7%87%E0%A6%B8%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%86%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%AA%E0%A7%8D%E0%A6%A8-%E0%A6%B9%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%8F%E0%A6%87-%E0%A6%A6%E0%A7%81%E0%A6%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>‘জীবনে একটু প্রেম-যৌনতা দরকার’</title>
      <link>https://www.banglatribune.com/entertainment/tallywood/982393/%E2%80%98%E0%A6%9C%E0%A7%80%E0%A6%AC%E0%A6%A8%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A6%9F%E0%A7%81-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AE-%E0%A6%AF%E0%A7%8C%E0%A6%A8%E0%A6%A4%E0%A6%BE-%E0%A6%A6%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E2%80%99</link>
      <guid isPermaLink="true">https://www.banglatribune.com/entertainment/tallywood/982393/%E2%80%98%E0%A6%9C%E0%A7%80%E0%A6%AC%E0%A6%A8%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A6%9F%E0%A7%81-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AE-%E0%A6%AF%E0%A7%8C%E0%A6%A8%E0%A6%A4%E0%A6%BE-%E0%A6%A6%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E2%80%99</guid>
      <pubDate>Sun, 22 Nov 2026 08:00:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/246e01490ce270e87e956117e11dc6ee-6b01a01ca9753.jpg?jadewits_media_id=1056233" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/246e01490ce270e87e956117e11dc6ee-6b01a01ca9753.jpg?jadewits_media_id=1056233" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/246e01490ce270e87e956117e11dc6ee-6b01a01ca9753.jpg?jadewits_media_id=1056233" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘জীবনে একটু প্রেম-যৌনতা দরকার’" /&gt;&lt;/p&gt;&lt;p&gt;টলিউডের অন্যতম স্পষ্টভাষী ও সাহসী অভিনেত্রী ঋ সেন। রাখঢাক না করে সোজাসাপ্টা কথা বলতেই পছন্দ করেন তিনি। সম্প্রতি &amp;lsquo;বিগ বস বাংলা&amp;rsquo;-র অন্যতম আলোচিত প্রতিযোগী রাজবীর দেকে নিয়ে প্রশ্নের মুখে পড়েছেন তিনি।
রাজবীরকে দেখে প্রেমে পড়ার প্রসঙ্গ উঠতেই ঋ-র সোজাসাপ্টা জবাব&amp;mdash; বিগ বসের ঘরে থাকলে তিনি &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/entertainment/tallywood/982393/%E2%80%98%E0%A6%9C%E0%A7%80%E0%A6%AC%E0%A6%A8%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A6%9F%E0%A7%81-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AE-%E0%A6%AF%E0%A7%8C%E0%A6%A8%E0%A6%A4%E0%A6%BE-%E0%A6%A6%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E2%80%99">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>সাদিক কায়েমের বাড়িতে পেট্রোলবোমা মেরে অগ্নিসংযোগ, যা বললেন ডাকসু ভিপি</title>
      <link>https://www.banglatribune.com/country/chitagong/982451/%E0%A6%B8%E0%A6%BE%E0%A6%A6%E0%A6%BF%E0%A6%95-%E0%A6%95%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B2%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE-%E0%A6%AE%E0%A7%87%E0%A6%B0%E0%A7%87-%E0%A6%85%E0%A6%97%E0%A7%8D%E0%A6%A8%E0%A6%BF%E0%A6%B8%E0%A6%82%E0%A6%AF%E0%A7%8B%E0%A6%97</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/chitagong/982451/%E0%A6%B8%E0%A6%BE%E0%A6%A6%E0%A6%BF%E0%A6%95-%E0%A6%95%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B2%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE-%E0%A6%AE%E0%A7%87%E0%A6%B0%E0%A7%87-%E0%A6%85%E0%A6%97%E0%A7%8D%E0%A6%A8%E0%A6%BF%E0%A6%B8%E0%A6%82%E0%A6%AF%E0%A7%8B%E0%A6%97</guid>
      <pubDate>Sun, 22 Nov 2026 07:42:16 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/07/13/d190fa683f822cd0e3642481b81b23ec-6a54cd7b36d3f.jpg?jadewits_media_id=1033318" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/07/13/d190fa683f822cd0e3642481b81b23ec-6a54cd7b36d3f.jpg?jadewits_media_id=1033318" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/07/13/d190fa683f822cd0e3642481b81b23ec-6a54cd7b36d3f.jpg?jadewits_media_id=1033318" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাদিক কায়েমের বাড়িতে পেট্রোলবোমা মেরে অগ্নিসংযোগ, যা বললেন ডাকসু ভিপি" /&gt;&lt;/p&gt;&lt;p&gt;ঢাকা বিশ্ববিদ্যালয় কেন্দ্রীয় ছাত্র সংসদের (ডাকসু) ভিপি সাদিক কায়েমের খাগড়াছড়ির বাড়িতে পেট্রোলবোমা ও কেরোসিন ঢেলে অগ্নিসংযোগ করেছে কার্যক্রম নিষিদ্ধ আওয়ামী লীগের নেতাকর্মীরা। রবিবার (২২ নভেম্বর) ভোররাত সাড়ে ৩টার দিকে এ ঘটনা ঘটে।
এ দিন ভোর সাড়ে ৫টায় দেওয়া এক ফেসবুক পোস্টে এ অভিযোগ করেন তিনি। এ সময় ব&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/chitagong/982451/%E0%A6%B8%E0%A6%BE%E0%A6%A6%E0%A6%BF%E0%A6%95-%E0%A6%95%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B2%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE-%E0%A6%AE%E0%A7%87%E0%A6%B0%E0%A7%87-%E0%A6%85%E0%A6%97%E0%A7%8D%E0%A6%A8%E0%A6%BF%E0%A6%B8%E0%A6%82%E0%A6%AF%E0%A7%8B%E0%A6%97">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>আজও হতে পারে বৃষ্টি, তাপমাত্রা বাড়বে নাকি কমবে?</title>

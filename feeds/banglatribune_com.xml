    <item>
      <title>অলিম্পিকের বাছাইপর্বের আয়োজক বাংলাদেশ</title>
      <link>https://www.banglatribune.com/sport/cricket/981136/%E0%A6%85%E0%A6%B2%E0%A6%BF%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%9B%E0%A6%BE%E0%A6%87%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A7%9F%E0%A7%8B%E0%A6%9C%E0%A6%95-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/cricket/981136/%E0%A6%85%E0%A6%B2%E0%A6%BF%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%9B%E0%A6%BE%E0%A6%87%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A7%9F%E0%A7%8B%E0%A6%9C%E0%A6%95-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6</guid>
      <pubDate>Sun, 15 Nov 2026 21:40:47 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/c22fa78a7e23402dc8b489350897f6f6-6af9cf7fe92ea.jpg?jadewits_media_id=1055168" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/c22fa78a7e23402dc8b489350897f6f6-6af9cf7fe92ea.jpg?jadewits_media_id=1055168" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/c22fa78a7e23402dc8b489350897f6f6-6af9cf7fe92ea.jpg?jadewits_media_id=1055168" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অলিম্পিকের বাছাইপর্বের আয়োজক বাংলাদেশ" /&gt;&lt;/p&gt;&lt;p&gt;২০২৮ লস অ্যাঞ্জেলেস অলিম্পিক গেমস ক্রিকেটের মূল পর্বের আগে গুরুত্বপূর্ণ দায়িত্ব পেয়েছে বাংলাদেশ। পুরুষদের চূড়ান্ত বাছাইপর্বের আয়োজক হবে বাংলাদেশ, আর মেয়েদের বাছাইপর্ব আয়োজন করবে যুক্তরাষ্ট্র। বালিতে অনুষ্ঠিত সভায় আন্তর্জাতিক ক্রিকেট কাউন্সিল (আইসিসি) এই সিদ্ধান্ত চূড়ান্ত করেছে। একই সভায় ২০৩৫ সাল পর্&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/cricket/981136/%E0%A6%85%E0%A6%B2%E0%A6%BF%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%9B%E0%A6%BE%E0%A6%87%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A7%9F%E0%A7%8B%E0%A6%9C%E0%A6%95-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>গোপালগঞ্জে হামলা-ভাঙচুর: দেড় হাজার বিজিবি-পুলিশ মোতায়েন, কঠোরভাবে প্রতিহত করার হুঁশিয়ারি</title>
      <link>https://www.banglatribune.com/country/dhaka/981134/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%AD%E0%A6%BE%E0%A6%99%E0%A6%9A%E0%A7%81%E0%A6%B0-%E0%A6%A6%E0%A7%87%E0%A7%9C-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%AC%E0%A6%BF-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/dhaka/981134/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%AD%E0%A6%BE%E0%A6%99%E0%A6%9A%E0%A7%81%E0%A6%B0-%E0%A6%A6%E0%A7%87%E0%A7%9C-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%AC%E0%A6%BF-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6</guid>
      <pubDate>Sun, 15 Nov 2026 21:16:36 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/38c6111293a821da4a0dfd119130a3c7-6af9ccbe200e0.jpg?jadewits_media_id=1055166" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/38c6111293a821da4a0dfd119130a3c7-6af9ccbe200e0.jpg?jadewits_media_id=1055166" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/38c6111293a821da4a0dfd119130a3c7-6af9ccbe200e0.jpg?jadewits_media_id=1055166" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গোপালগঞ্জে হামলা-ভাঙচুর: দেড় হাজার বিজিবি-পুলিশ মোতায়েন, কঠোরভাবে প্রতিহত করার হুঁশিয়ারি" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জ জেলার সার্বিক আইনশৃঙ্খলা পরিস্থিতি স্বাভাবিক রাখতে এবং জননিরাপত্তা নিশ্চিত করতে দেড় হাজার বিজিবি ও পুলিশ সদস্য মোতায়েন করা হয়েছে। রবিবার (১৫ নভেম্বর) বিকালে গোপালগঞ্জ সার্কিট হাউসে আয়োজিত এক প্রেস ব্রিফিংয়ে আইনশৃঙ্খলা রক্ষাকারী বাহিনীর ঊর্ধ্বতন কর্মকর্তারা এ তথ্য জানান।
স্থানীয় সূত্রে জানা&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/dhaka/981134/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%AD%E0%A6%BE%E0%A6%99%E0%A6%9A%E0%A7%81%E0%A6%B0-%E0%A6%A6%E0%A7%87%E0%A7%9C-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%AC%E0%A6%BF-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6">বাংলা ট্রিবিউন</source>

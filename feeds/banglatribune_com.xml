      <guid isPermaLink="true">https://www.banglatribune.com/literature/%E0%A6%B8%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A4%E2%80%8D%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A6%82%E0%A6%AC%E0%A6%BE%E0%A6%A6/982254/%E0%A6%B8%E0%A6%BF%E0%A6%9F%E0%A6%BF-%E0%A6%87%E0%A6%89%E0%A6%A8%E0%A6%BF%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B8%E0%A6%BF%E0%A6%9F%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%87%E0%A6%B8%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A6%BF-%E0%A7%A8%E0%A7%A6%E0%A7%A8%E0%A7%AC-%E0%A6%8F%E0%A6%B0-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%8B%E0%A6%A7%E0%A6%A8</guid>
      <pubDate>Fri, 20 Nov 2026 23:17:14 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/7c1afd5f349935b80e3c2fd5c1c93343-6b00803148b50.jpg?jadewits_media_id=1056111" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/7c1afd5f349935b80e3c2fd5c1c93343-6b00803148b50.jpg?jadewits_media_id=1056111" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/7c1afd5f349935b80e3c2fd5c1c93343-6b00803148b50.jpg?jadewits_media_id=1056111" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সিটি ইউনিভার্সিটিতে আইসিবিসি ২০২৬-এর উদ্বোধন" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশি-আমেরিকান তাত্ত্বিক ও সাহিত্যসমালোচক অধ্যাপক ড. আজফার হোসেনের কী-নোট বক্তব্যের মধ্য দিয়ে শুরু হয়েছে &amp;lsquo;বিভিন্ন সংস্কৃতির সেতুবন্ধন: উন্নততর চিন্তাচর্চা&amp;rsquo; (আইসিবিসি ২০২৬) শীর্ষক আন্তর্জাতিক সম্মেলনের দ্বিতীয় পর্বের আয়োজন।
আজ (২০ নভেম্বর) অনলাইনে অনুষ্ঠিত হয় সম্মেলনের উদ্বোধনী অনুষ্ঠ&lt;/p&gt;</description>

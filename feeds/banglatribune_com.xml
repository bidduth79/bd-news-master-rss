    <item>
      <title>প্রকাশ্যে চুম্বনের অভিযোগ: ইন্দোনেশিয়ায় নারীসহ ছয়জনকে বেত্রাঘাত</title>
      <link>https://www.banglatribune.com/foreign/asia/980596/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B6%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%9A%E0%A7%81%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%87%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8B%E0%A6%A8%E0%A7%87%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%B8%E0%A6%B9</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/asia/980596/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B6%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%9A%E0%A7%81%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%87%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8B%E0%A6%A8%E0%A7%87%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%B8%E0%A6%B9</guid>
      <pubDate>Thu, 12 Nov 2026 22:54:49 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/fb8e9ae16ad0e15d332f2b48ee5b9c20-6af5ef2e73148.jpg?jadewits_media_id=1054711" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/fb8e9ae16ad0e15d332f2b48ee5b9c20-6af5ef2e73148.jpg?jadewits_media_id=1054711" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/fb8e9ae16ad0e15d332f2b48ee5b9c20-6af5ef2e73148.jpg?jadewits_media_id=1054711" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রকাশ্যে চুম্বনের অভিযোগ: ইন্দোনেশিয়ায় নারীসহ ছয়জনকে বেত্রাঘাত" /&gt;&lt;/p&gt;&lt;p&gt;ইন্দোনেশিয়ার আচেহ প্রদেশে কঠোর শরিয়াহ আইনের আওতায় প্রকাশ্যে ভালোবাসা প্রদর্শনের অভিযোগে এক নারীকে বেত্রাঘাত করা হয়েছে। বেত্রাঘাতের পর দাঁড়িয়ে থাকতে তাকে অন্যের সহায়তা নিতে দেখা যায়। মুসলিম-সংখ্যাগরিষ্ঠ ইন্দোনেশিয়ার একমাত্র শরিয়াহ আইন কার্যকর থাকা এই প্রদেশে বৃহস্পতিবার প্রকাশ্যে বেত্রাঘাতের শিকার ছ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/asia/980596/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B6%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%9A%E0%A7%81%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%87%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8B%E0%A6%A8%E0%A7%87%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%B8%E0%A6%B9">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>দেশের পথে প্রধানমন্ত্রী, ইস্তাম্বুলে যাত্রাবিরতি</title>
      <link>https://www.banglatribune.com/national/980595/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%87%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A7%81%E0%A6%B2%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A6%A4%E0%A6%BF%C2%A0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/national/980595/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%87%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A7%81%E0%A6%B2%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A6%A4%E0%A6%BF%C2%A0</guid>
      <pubDate>Thu, 12 Nov 2026 22:54:41 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/32bebdf1bfe1810793829bcb9d563739-6af5eeb53f5a4.jpg?jadewits_media_id=1054710" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/32bebdf1bfe1810793829bcb9d563739-6af5eeb53f5a4.jpg?jadewits_media_id=1054710" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/32bebdf1bfe1810793829bcb9d563739-6af5eeb53f5a4.jpg?jadewits_media_id=1054710" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দেশের পথে প্রধানমন্ত্রী, ইস্তাম্বুলে যাত্রাবিরতি" /&gt;&lt;/p&gt;&lt;p&gt;প্রধানমন্ত্রী তারেক রহমান জাতিসংঘ জলবায়ু পরিবর্তনবিষয়ক শীর্ষ সম্মেলনে (কপ৩১) অংশগ্রহণ শেষে দেশে ফেরার পথে তুরস্কের ইস্তাম্বুলে যাত্রাবিরতি করেছেন। বৃহস্পতিবার স্থানীয় সময় সন্ধ্যা সাড়ে ৬টায় প্রধানমন্ত্রী ও তাঁর সফরসঙ্গীদের বহনকারী টার্কিশ এয়ারলাইনসের ফ্লাইটটি ইস্তাম্বুল বিমানবন্দরে অবতরণ করে। প্রধানম&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/980595/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%87%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A7%81%E0%A6%B2%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A6%A4%E0%A6%BF%C2%A0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ক্রীড়া সাংবাদিকদের ওপর পুলিশের হামলার প্রতিবাদে তিন সংগঠনের চিঠি, কী বলছেন ক্রীড়া প্রতিমন্ত্রী</title>
      <link>https://www.banglatribune.com/sport/football/980594/%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A7%9C%E0%A6%BE-%E0%A6%B8%E0%A6%BE%E0%A6%82%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A6%BF%E0%A6%95%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/football/980594/%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A7%9C%E0%A6%BE-%E0%A6%B8%E0%A6%BE%E0%A6%82%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A6%BF%E0%A6%95%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A7%87</guid>
      <pubDate>Thu, 12 Nov 2026 22:46:36 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/10/14/faa217fa2556bbac1ebb8921599841ce-6acf746f7dc72.jpg?jadewits_media_id=1049360" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/10/14/faa217fa2556bbac1ebb8921599841ce-6acf746f7dc72.jpg?jadewits_media_id=1049360" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/10/14/faa217fa2556bbac1ebb8921599841ce-6acf746f7dc72.jpg?jadewits_media_id=1049360" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ক্রীড়া সাংবাদিকদের ওপর পুলিশের হামলার প্রতিবাদে তিন সংগঠনের চিঠি, কী বলছেন ক্রীড়া প্রতিমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;সাফ চ্যাম্পিয়নশিপে বাংলাদেশ-শ্রীলঙ্কা ম্যাচ শেষে জাতীয় স্টেডিয়ামের মিক্সড জোনে দায়িত্ব পালনকালে পুলিশের হামলার শিকার হয়েছেন ক্রীড়া সাংবাদিকরা। এ ঘটনায় তীব্র নিন্দা ও প্রতিবাদ জানিয়েছে দেশের ক্রীড়া সাংবাদিকদের তিন সংগঠন। ঘটনার নিরপেক্ষ তদন্ত, দায়ী পুলিশ সদস্যদের শনাক্ত করে শাস্তিমূলক ব্যবস্থা গ্রহণসহ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/football/980594/%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A7%9C%E0%A6%BE-%E0%A6%B8%E0%A6%BE%E0%A6%82%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A6%BF%E0%A6%95%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>দিনের গুরুত্বপূর্ণ আন্তর্জাতিক খবর</title>
      <link>https://www.banglatribune.com/foreign/980593/%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A7%81%E0%A6%B0%E0%A7%81%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A6%AA%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%A3-%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%96%E0%A6%AC%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/980593/%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A7%81%E0%A6%B0%E0%A7%81%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A6%AA%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%A3-%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%96%E0%A6%AC%E0%A6%B0</guid>
      <pubDate>Thu, 12 Nov 2026 22:43:40 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/05/30/85b27ed9cf8c7ae2b5b949879cb1cdda-6a1af6ff8f48a.jpg?jadewits_media_id=1026404" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/05/30/85b27ed9cf8c7ae2b5b949879cb1cdda-6a1af6ff8f48a.jpg?jadewits_media_id=1026404" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/05/30/85b27ed9cf8c7ae2b5b949879cb1cdda-6a1af6ff8f48a.jpg?jadewits_media_id=1026404" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দিনের গুরুত্বপূর্ণ আন্তর্জাতিক খবর" /&gt;&lt;/p&gt;&lt;p&gt;বিশ্বের রাজনৈতিক আকাশে প্রতিদিনই নতুন মেঘ জমছে, নতুন ঝড় উঠছে। বৈশ্বিক নীতি-নির্ধারণের নীরব সিদ্ধান্ত থেকে শুরু করে ভূ-রাজনীতির জটিল খেলা, কূটনীতির অদৃশ্য সুতো, সংঘাতের আগুন এবং প্রতিরক্ষা খাতের নীরব প্রস্তুতি-সবকিছু মিলিয়ে যেন এক অবিরাম পরিবর্তন চলছে। এই পরিবর্তনের প্রতিটি দৃশ্য আজকের বিশ্বব্যবস্থাক&lt;/p&gt;</description>

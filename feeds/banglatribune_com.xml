      <guid isPermaLink="true">https://www.banglatribune.com/country/dhaka/979651/%E0%A6%95%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B9%E0%A7%80%E0%A6%A8-%E0%A6%95%E0%A6%BE%E0%A6%9C-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%8B</guid>
      <pubDate>Sun, 08 Nov 2026 19:28:41 +0600</pubDate>
      <description>মুক্তিযুদ্ধবিষয়ক মন্ত্রী আহমেদ আজম খান বলেছেন, &amp;lsquo;আপনাদের ভোটে সরকার গঠন করে আজ ক্লান্তিহীনভাবে কাজ করে যাচ্ছেন প্রধানমন্ত্রী তারেক রহমান। পুরো বাংলাদেশ যখন প্রধানমন্ত্রীর প্রশংসায় উদ্ভাসিত ঠিক তখন আমরা দেখছি দেশটা ধবংস করার জন্য গার্মেন্টস শিল্পে অস্থিতিশীলতা সৃষ্টি করা হচ্ছে।&amp;rsquo;&amp;nbsp;
রবিব</description>

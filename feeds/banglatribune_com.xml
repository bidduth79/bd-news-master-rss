    <item>
      <title>১০-১২ নভেম্বর তুরস্ক সফর করবেন প্রধানমন্ত্রী</title>
      <link>https://www.banglatribune.com/national/979741/%E0%A7%A7%E0%A7%A6-%E0%A7%A7%E0%A7%A8-%E0%A6%A8%E0%A6%AD%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%95-%E0%A6%B8%E0%A6%AB%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%AC%E0%A7%87%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80</link>
      <guid isPermaLink="true">https://www.banglatribune.com/national/979741/%E0%A7%A7%E0%A7%A6-%E0%A7%A7%E0%A7%A8-%E0%A6%A8%E0%A6%AD%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%95-%E0%A6%B8%E0%A6%AB%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%AC%E0%A7%87%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80</guid>
      <pubDate>Mon, 09 Nov 2026 11:24:39 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/93662acb99975c7fc17fc335a0d06a21-6af158885f5e1.jpg?jadewits_media_id=1053983" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/93662acb99975c7fc17fc335a0d06a21-6af158885f5e1.jpg?jadewits_media_id=1053983" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/93662acb99975c7fc17fc335a0d06a21-6af158885f5e1.jpg?jadewits_media_id=1053983" style="max-width:100%;height:auto;margin-bottom:10px;" alt="১০-১২ নভেম্বর তুরস্ক সফর করবেন প্রধানমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;৩১তম জলবায়ু সম্মেলনে যোগ দিতে প্রধানমন্ত্রী তারেক রহমান আগামী ১০ থেকে ১২ নভেম্বর তুরস্ক সফর করবেন বলে জানিয়েছেন পররাষ্ট্র সচিব সালাহউদ্দিন নোমান চৌধুরী।
সোমবার (৯ নভেম্বর) পররাষ্ট্র মন্ত্রণালয়ে এক সংবাদ সম্মেলনে এ কথা জানান তিনি।
পররাষ্ট্র সচিব জানান, ১২ নভেম্বর জলবায়ু সম্মেলনে বক্তব্য দেবেন প্রধানম&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/979741/%E0%A7%A7%E0%A7%A6-%E0%A7%A7%E0%A7%A8-%E0%A6%A8%E0%A6%AD%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%95-%E0%A6%B8%E0%A6%AB%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%AC%E0%A7%87%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>শেখ হাসিনার নামে খাবার বিতরণ, জাবি ক্যাম্পাসে আটক পাবিপ্রবি ছাত্রলীগ নেতা</title>
      <link>https://www.banglatribune.com/country/dhaka/979740/%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%96%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A6%B0%E0%A6%A3-%E0%A6%9C%E0%A6%BE%E0%A6%AC%E0%A6%BF-%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%9F%E0%A6%95</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/dhaka/979740/%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%96%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A6%B0%E0%A6%A3-%E0%A6%9C%E0%A6%BE%E0%A6%AC%E0%A6%BF-%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%9F%E0%A6%95</guid>
      <pubDate>Mon, 09 Nov 2026 10:57:42 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/badd4e7911b8a94e918cfcf935dcca75-6af152bb86888.jpg?jadewits_media_id=1053982" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/badd4e7911b8a94e918cfcf935dcca75-6af152bb86888.jpg?jadewits_media_id=1053982" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/badd4e7911b8a94e918cfcf935dcca75-6af152bb86888.jpg?jadewits_media_id=1053982" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শেখ হাসিনার নামে খাবার বিতরণ, জাবি ক্যাম্পাসে আটক পাবিপ্রবি ছাত্রলীগ নেতা" /&gt;&lt;/p&gt;&lt;p&gt;জাহাঙ্গীরনগর বিশ্ববিদ্যালয় (জাবি) ক্যাম্পাসে ছাত্রলীগের পোস্টার লাগানোর অভিযোগে পাবনা বিজ্ঞান ও প্রযুক্তি বিশ্ববিদ্যালয় (পাবিপ্রবি) শাখা ছাত্রলীগের এক নেতাকে আটক করে পুলিশের হাতে তুলে দিয়েছেন জাবি শাখা ছাত্রদলের নেতাকর্মীরা।
রবিবার (৮ নভেম্বর) বিকালে বিশ্ববিদ্যালয়ের পরিবহন চত্বর এলাকার একটি চায়ের দো&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/dhaka/979740/%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%96%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A6%B0%E0%A6%A3-%E0%A6%9C%E0%A6%BE%E0%A6%AC%E0%A6%BF-%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%9F%E0%A6%95">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>‘বাংলাদেশিরা ওত পেতে আছে, ফাঁক পেলে হু-হু করে ঢুকে পড়বে ভারতে’</title>
      <link>https://www.banglatribune.com/foreign/india/979739/%E2%80%98%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF%E0%A6%B0%E0%A6%BE-%E0%A6%93%E0%A6%A4-%E0%A6%AA%E0%A7%87%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%9B%E0%A7%87-%E0%A6%AB%E0%A6%BE%E0%A6%81%E0%A6%95-%E0%A6%AA%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%B9%E0%A7%81-%E0%A6%B9%E0%A7%81-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%A2%E0%A7%81%E0%A6%95%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/india/979739/%E2%80%98%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF%E0%A6%B0%E0%A6%BE-%E0%A6%93%E0%A6%A4-%E0%A6%AA%E0%A7%87%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%9B%E0%A7%87-%E0%A6%AB%E0%A6%BE%E0%A6%81%E0%A6%95-%E0%A6%AA%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%B9%E0%A7%81-%E0%A6%B9%E0%A7%81-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%A2%E0%A7%81%E0%A6%95%E0%A7%87</guid>
      <pubDate>Mon, 09 Nov 2026 10:49:39 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/a5a2e4dc57dc0d2a646035106b652f79-6af15076c7e4c.jpg?jadewits_media_id=1053981" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/a5a2e4dc57dc0d2a646035106b652f79-6af15076c7e4c.jpg?jadewits_media_id=1053981" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/a5a2e4dc57dc0d2a646035106b652f79-6af15076c7e4c.jpg?jadewits_media_id=1053981" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘বাংলাদেশিরা ওত পেতে আছে, ফাঁক পেলে হু-হু করে ঢুকে পড়বে ভারতে’" /&gt;&lt;/p&gt;&lt;p&gt;দীপাবলি উপলক্ষে ভারত-বাংলাদেশ সীমান্তবর্তী পশ্চিমবঙ্গের হিঙ্গলগঞ্জে সীমান্তরক্ষী বাহিনীর (বিএসএফ) সদস্যদের সঙ্গে উৎসব উদ্&amp;zwnj;যাপন করেছেন রাজ্যের মুখ্যমন্ত্রী শুভেন্দু অধিকারী। এ সময় অনুপ্রবেশের বিরুদ্ধে কঠোর অবস্থানের কথা জানিয়ে তিনি বলেছেন, পশ্চিমবঙ্গে একজন অনুপ্রবেশকারীকেও থাকতে দেওয়া হবে না। অন&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/india/979739/%E2%80%98%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF%E0%A6%B0%E0%A6%BE-%E0%A6%93%E0%A6%A4-%E0%A6%AA%E0%A7%87%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%9B%E0%A7%87-%E0%A6%AB%E0%A6%BE%E0%A6%81%E0%A6%95-%E0%A6%AA%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%B9%E0%A7%81-%E0%A6%B9%E0%A7%81-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%A2%E0%A7%81%E0%A6%95%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ঢাকা, গাজীপুর ও নারায়ণগঞ্জে ৩৪ প্লাটুন বিজিবি মোতায়েন</title>
      <link>https://www.banglatribune.com/law-and-crime/979738/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A7%80%E0%A6%AA%E0%A7%81%E0%A6%B0-%E0%A6%93-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A6%A3%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A7%A9%E0%A7%AA-%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%9F%E0%A7%81%E0%A6%A8-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%AC%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/979738/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A7%80%E0%A6%AA%E0%A7%81%E0%A6%B0-%E0%A6%93-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A6%A3%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A7%A9%E0%A7%AA-%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%9F%E0%A7%81%E0%A6%A8-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%AC%E0%A6%BF</guid>
      <pubDate>Mon, 09 Nov 2026 10:43:36 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/1bbb8a80b91c8ac55d763a83b9fa7d9b-6af14f6d813a0.jpg?jadewits_media_id=1053980" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/1bbb8a80b91c8ac55d763a83b9fa7d9b-6af14f6d813a0.jpg?jadewits_media_id=1053980" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/1bbb8a80b91c8ac55d763a83b9fa7d9b-6af14f6d813a0.jpg?jadewits_media_id=1053980" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঢাকা, গাজীপুর ও নারায়ণগঞ্জে ৩৪ প্লাটুন বিজিবি মোতায়েন" /&gt;&lt;/p&gt;&lt;p&gt;চলমান শ্রমিক অসন্তোষের প্রেক্ষাপটে শিল্পাঞ্চলের সার্বিক নিরাপত্তা নিশ্চিত করা, আইনশৃঙ্খলা পরিস্থিতি স্বাভাবিক রাখা এবং যেকোনও ধরনের অপ্রীতিকর পরিস্থিতি প্রতিরোধে ঢাকা, গাজীপুর ও নারায়ণগঞ্জের বিভিন্ন গুরুত্বপূর্ণ শিল্পাঞ্চলে ৩৪ প্লাটুন বিজিবি মোতায়েন রয়েছে।&amp;nbsp;
সোমবার (৯ নভেম্বর) বিজিবি মিডিয়া বিভা&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/979738/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A7%80%E0%A6%AA%E0%A7%81%E0%A6%B0-%E0%A6%93-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A6%A3%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A7%A9%E0%A7%AA-%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%9F%E0%A7%81%E0%A6%A8-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%AC%E0%A6%BF">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>বাকৃবি ক্যাম্পাসে ছুরি দেখিয়ে ছিনতাই, ধাওয়া করে ধরলেন শিক্ষার্থীরা</title>
      <link>https://www.banglatribune.com/country/mymensing/979737/%E0%A6%AC%E0%A6%BE%E0%A6%95%E0%A7%83%E0%A6%AC%E0%A6%BF-%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%9B%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%9B%E0%A6%BF%E0%A6%A8%E0%A6%A4%E0%A6%BE%E0%A6%87-%E0%A6%A7%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/mymensing/979737/%E0%A6%AC%E0%A6%BE%E0%A6%95%E0%A7%83%E0%A6%AC%E0%A6%BF-%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%9B%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%9B%E0%A6%BF%E0%A6%A8%E0%A6%A4%E0%A6%BE%E0%A6%87-%E0%A6%A7%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A7%87</guid>
      <pubDate>Mon, 09 Nov 2026 10:53:05 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/382b0cd2f0a82dcb08b83d782d711c24-6af14dc987c18.jpg?jadewits_media_id=1053979" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/382b0cd2f0a82dcb08b83d782d711c24-6af14dc987c18.jpg?jadewits_media_id=1053979" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/382b0cd2f0a82dcb08b83d782d711c24-6af14dc987c18.jpg?jadewits_media_id=1053979" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাকৃবি ক্যাম্পাসে ছুরি দেখিয়ে ছিনতাই, ধাওয়া করে ধরলেন শিক্ষার্থীরা" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ কৃষি বিশ্ববিদ্যালয়ের (বাকৃবি) ক্যাম্পাসে ছুরি দেখিয়ে এক ব্যক্তির মোবাইল ফোন ছিনতাইয়ের অভিযোগে এক অটোচালককে আটক করেছেন শিক্ষার্থীরা। রবিবার (৮ নভেম্বর) রাতে বিশ্ববিদ্যালয়ের রেললাইনসংলগ্ন নির্জন এলাকায় এ ঘটনা ঘটে। পরে শিক্ষার্থীদের ধাওয়ায় তাকে আটক করা হয়। এ সময় তার কাছ থেকে ছিনতাই হওয়া মোবাইল&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/mymensing/979737/%E0%A6%AC%E0%A6%BE%E0%A6%95%E0%A7%83%E0%A6%AC%E0%A6%BF-%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%9B%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%9B%E0%A6%BF%E0%A6%A8%E0%A6%A4%E0%A6%BE%E0%A6%87-%E0%A6%A7%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>

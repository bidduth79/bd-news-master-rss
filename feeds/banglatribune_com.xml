    <item>
      <title>‘আক্রমণ করলে পুলিশ কি রসগোল্লা ছুড়বে?’</title>
      <link>https://www.banglatribune.com/foreign/asia/979891/%E2%80%98%E0%A6%86%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%A3-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%95%E0%A6%BF-%E0%A6%B0%E0%A6%B8%E0%A6%97%E0%A7%8B%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BE-%E0%A6%9B%E0%A7%81%E0%A7%9C%E0%A6%AC%E0%A7%87%E2%80%99</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/asia/979891/%E2%80%98%E0%A6%86%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%A3-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%95%E0%A6%BF-%E0%A6%B0%E0%A6%B8%E0%A6%97%E0%A7%8B%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BE-%E0%A6%9B%E0%A7%81%E0%A7%9C%E0%A6%AC%E0%A7%87%E2%80%99</guid>
      <pubDate>Mon, 09 Nov 2026 21:11:17 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/1606e74869200cabefc15af073a5dae0-6af1e233a28dd.jpg?jadewits_media_id=1054102" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/1606e74869200cabefc15af073a5dae0-6af1e233a28dd.jpg?jadewits_media_id=1054102" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/1606e74869200cabefc15af073a5dae0-6af1e233a28dd.jpg?jadewits_media_id=1054102" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘আক্রমণ করলে পুলিশ কি রসগোল্লা ছুড়বে?’" /&gt;&lt;/p&gt;&lt;p&gt;ভারতের পশ্চিমবঙ্গের উত্তর দিনাজপুরে নাবালিকা ধর্ষণ ও খুনের ঘটনায় অভিযুক্ত ব্যক্তি পুলিশের সঙ্গে গোলাগুলিতে নিহত হওয়ার ঘটনায় কড়া প্রতিক্রিয়া জানিয়েছেন পশ্চিমবঙ্গের মুখ্যমন্ত্রী শুভেন্দু অধিকারী। সোমবার এই এনকাউন্টারের জোরালো পক্ষ নিয়ে সমালোচকদের উদ্দেশে তিনি প্রশ্ন তোলেন, আক্রমণ করা হলে পুলিশ কি তাদে&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/asia/979891/%E2%80%98%E0%A6%86%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%A3-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%95%E0%A6%BF-%E0%A6%B0%E0%A6%B8%E0%A6%97%E0%A7%8B%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BE-%E0%A6%9B%E0%A7%81%E0%A7%9C%E0%A6%AC%E0%A7%87%E2%80%99">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>সংসদ সদস্যদের রাজপথে সক্রিয় থাকার নির্দেশ প্রধানমন্ত্রীর</title>
      <link>https://www.banglatribune.com/national/979889/%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%B8%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A7%9F-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A7%87%E0%A6%B6</link>
      <guid isPermaLink="true">https://www.banglatribune.com/national/979889/%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%B8%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A7%9F-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A7%87%E0%A6%B6</guid>
      <pubDate>Mon, 09 Nov 2026 20:59:02 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/07/15/2acf7493d9836538ac5ca2ef1dfe1231-6a579f8402930.jpg?jadewits_media_id=1033720" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/07/15/2acf7493d9836538ac5ca2ef1dfe1231-6a579f8402930.jpg?jadewits_media_id=1033720" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/07/15/2acf7493d9836538ac5ca2ef1dfe1231-6a579f8402930.jpg?jadewits_media_id=1033720" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সংসদ সদস্যদের রাজপথে সক্রিয় থাকার নির্দেশ প্রধানমন্ত্রীর" /&gt;&lt;/p&gt;&lt;p&gt;দলীয় সংসদ সদস্যদের রাজপথে সক্রিয় থাকার এবং দেশে যেকোনও ধরনের অস্থিরতা বা বিশৃঙ্খলা সৃষ্টির চেষ্টা হলে তা প্রতিহত করার নির্দেশ দিয়েছেন প্রধানমন্ত্রী ও বিএনপির চেয়ারম্যান তারেক রহমান। সোমবার (৯ নভেম্বর) বিএনপির সংসদীয় দলের বৈঠকে উপস্থিত একাধিক সূত্র এ তথ্য জানিয়েছে।
তারেক রহমান সতর্ক করে বলেন, দেশে আই&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/979889/%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%B8%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A7%9F-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A7%87%E0%A6%B6">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>কে সেই কিশোর, কেন করলো ছুরিকাঘাত: কেমন আছে আহত সেই ছাত্রী</title>
      <link>https://www.banglatribune.com/country/khulna/979888/%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A7%87%E0%A6%87-%E0%A6%95%E0%A6%BF%E0%A6%B6%E0%A7%8B%E0%A6%B0-%E0%A6%95%E0%A7%87%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%8B-%E0%A6%9B%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%98%E0%A6%BE%E0%A6%A4-%E0%A6%95%E0%A7%87%E0%A6%AE%E0%A6%A8-%E0%A6%86%E0%A6%9B%E0%A7%87-%E0%A6%86%E0%A6%B9%E0%A6%A4-%E0%A6%B8%E0%A7%87%E0%A6%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/khulna/979888/%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A7%87%E0%A6%87-%E0%A6%95%E0%A6%BF%E0%A6%B6%E0%A7%8B%E0%A6%B0-%E0%A6%95%E0%A7%87%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%8B-%E0%A6%9B%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%98%E0%A6%BE%E0%A6%A4-%E0%A6%95%E0%A7%87%E0%A6%AE%E0%A6%A8-%E0%A6%86%E0%A6%9B%E0%A7%87-%E0%A6%86%E0%A6%B9%E0%A6%A4-%E0%A6%B8%E0%A7%87%E0%A6%87</guid>
      <pubDate>Mon, 09 Nov 2026 20:55:13 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/e0d6b527453534b7f061865cdac42a78-6af1dec67a63a.jpg?jadewits_media_id=1054100" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/e0d6b527453534b7f061865cdac42a78-6af1dec67a63a.jpg?jadewits_media_id=1054100" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/e0d6b527453534b7f061865cdac42a78-6af1dec67a63a.jpg?jadewits_media_id=1054100" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কে সেই কিশোর, কেন করলো ছুরিকাঘাত: কেমন আছে আহত সেই ছাত্রী" /&gt;&lt;/p&gt;&lt;p&gt;কুষ্টিয়া শহরে বাসার সামনে এক স্কুলছাত্রীকে পেছন থেকে একের পর এক ছুরিকাঘাত করেছে এক কিশোর। এতে গুরুতর আহত হয় ওই ছাত্রী। পরে তাকে কুষ্টিয়া জেনারেল হাসপাতালে ভর্তি করা হয়েছে।
সোমবার (৯ নভেম্বর) বেলা ১টা ১১ মিনিটের দিকে কুষ্টিয়া শহরের থানাপাড়া এলাকায় এ ঘটনা ঘটে। ঘটনার পরপরই অভিযুক্ত তরুণ ছুরি ফেলে দৌড়ে &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/khulna/979888/%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A7%87%E0%A6%87-%E0%A6%95%E0%A6%BF%E0%A6%B6%E0%A7%8B%E0%A6%B0-%E0%A6%95%E0%A7%87%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%8B-%E0%A6%9B%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%98%E0%A6%BE%E0%A6%A4-%E0%A6%95%E0%A7%87%E0%A6%AE%E0%A6%A8-%E0%A6%86%E0%A6%9B%E0%A7%87-%E0%A6%86%E0%A6%B9%E0%A6%A4-%E0%A6%B8%E0%A7%87%E0%A6%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>২০ কর্মীকে লক্ষাধিক রুপি বোনাস, ভাইরাল সুরাটের ব্যবসায়ী</title>
      <link>https://www.banglatribune.com/foreign/asia/979887/%E0%A7%A8%E0%A7%A6-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%B2%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%A7%E0%A6%BF%E0%A6%95-%E0%A6%B0%E0%A7%81%E0%A6%AA%E0%A6%BF-%E0%A6%AC%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B8-%E0%A6%AD%E0%A6%BE%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%B2-%E0%A6%B8%E0%A7%81%E0%A6%B0%E0%A6%BE%E0%A6%9F%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/asia/979887/%E0%A7%A8%E0%A7%A6-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%B2%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%A7%E0%A6%BF%E0%A6%95-%E0%A6%B0%E0%A7%81%E0%A6%AA%E0%A6%BF-%E0%A6%AC%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B8-%E0%A6%AD%E0%A6%BE%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%B2-%E0%A6%B8%E0%A7%81%E0%A6%B0%E0%A6%BE%E0%A6%9F%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Mon, 09 Nov 2026 20:53:06 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/74d0a4635a48aaa7ed1f4466e16206bf-6af1dd9227de4.jpg?jadewits_media_id=1054099" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/74d0a4635a48aaa7ed1f4466e16206bf-6af1dd9227de4.jpg?jadewits_media_id=1054099" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/74d0a4635a48aaa7ed1f4466e16206bf-6af1dd9227de4.jpg?jadewits_media_id=1054099" style="max-width:100%;height:auto;margin-bottom:10px;" alt="২০ কর্মীকে লক্ষাধিক রুপি বোনাস, ভাইরাল সুরাটের ব্যবসায়ী" /&gt;&lt;/p&gt;&lt;p&gt;ভারতের গুজরাটের সুরাটের এক ব্যবসায়ী দীপাবলি উপলক্ষে তার ২০ কর্মীর প্রত্যেককে ১ লাখ রুপির বেশি বোনাস দিয়ে সামাজিক যোগাযোগমাধ্যমে প্রশংসা কুড়াচ্ছেন। শহরের ভারাচ্ছা এলাকায় পোশাকের ব্যবসা চালান রামস্বরূপ মুন্ড। সাজানো রুপালি রঙের পূজার থালায় করে নগদ টাকা তুলে দিলে বেশ কয়েকজন কর্মীকে আবেগাপ্লুত হতে&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/asia/979887/%E0%A7%A8%E0%A7%A6-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%B2%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%A7%E0%A6%BF%E0%A6%95-%E0%A6%B0%E0%A7%81%E0%A6%AA%E0%A6%BF-%E0%A6%AC%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B8-%E0%A6%AD%E0%A6%BE%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%B2-%E0%A6%B8%E0%A7%81%E0%A6%B0%E0%A6%BE%E0%A6%9F%E0%A7%87%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>

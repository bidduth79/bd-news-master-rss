    <item>
      <title>আবু বাকেরকে প্রাণনাশের হুমকি, বাড়িতে কাফনের কাপড় পাঠানোর অভিযোগ</title>
      <link>https://www.banglatribune.com/politics/983067/%E0%A6%86%E0%A6%AC%E0%A7%81-%E0%A6%AC%E0%A6%BE%E0%A6%95%E0%A7%87%E0%A6%B0%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%95%E0%A6%BF-%E0%A6%AC%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%AB%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%AA%E0%A6%A1%E0%A6%BC</link>
      <guid isPermaLink="true">https://www.banglatribune.com/politics/983067/%E0%A6%86%E0%A6%AC%E0%A7%81-%E0%A6%AC%E0%A6%BE%E0%A6%95%E0%A7%87%E0%A6%B0%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%95%E0%A6%BF-%E0%A6%AC%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%AB%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%AA%E0%A6%A1%E0%A6%BC</guid>
      <pubDate>Wed, 25 Nov 2026 02:13:41 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/281793ea260e9cd0b040b1dedf175467-6b05ef0e60e52.jpg?jadewits_media_id=1056793" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/281793ea260e9cd0b040b1dedf175467-6b05ef0e60e52.jpg?jadewits_media_id=1056793" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/281793ea260e9cd0b040b1dedf175467-6b05ef0e60e52.jpg?jadewits_media_id=1056793" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আবু বাকেরকে প্রাণনাশের হুমকি, বাড়িতে কাফনের কাপড় পাঠানোর অভিযোগ" /&gt;&lt;/p&gt;&lt;p&gt;জুলাই গণঅভ্যুত্থানের সম্মুখসারির নেতা, বৈষম্যবিরোধী ছাত্র আন্দোলনের সাবেক সমন্বয়ক ও জাতীয় ছাত্রশক্তির কেন্দ্রীয় সভাপতি আবু বাকের মজুমদারকে প্রাণনাশের হুমকি দেওয়া হয়েছে বলে অভিযোগ করেছেন জাতীয় নাগরিক পার্টির (এনসিপি) আহ্বায়ক নাহিদ ইসলাম। তার বাড়িতে কাফনের কাপড় ও হুমকিসংবলিত চিরকুট পাঠানো হয়েছে বলেও জ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/politics/983067/%E0%A6%86%E0%A6%AC%E0%A7%81-%E0%A6%AC%E0%A6%BE%E0%A6%95%E0%A7%87%E0%A6%B0%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%95%E0%A6%BF-%E0%A6%AC%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%AB%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%AA%E0%A6%A1%E0%A6%BC">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ভিসা পরিবর্তন করে ফেরার পথে আমিরাতে বাস-ট্রাক সংঘর্ষ, ভারতীয়সহ নিহত ১৩</title>
      <link>https://www.banglatribune.com/foreign/middle-east/983066/%E0%A6%AD%E0%A6%BF%E0%A6%B8%E0%A6%BE-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%86%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B8-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%95</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/middle-east/983066/%E0%A6%AD%E0%A6%BF%E0%A6%B8%E0%A6%BE-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%86%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B8-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%95</guid>
      <pubDate>Wed, 25 Nov 2026 01:26:35 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/2dd7f455fe957d63c8e5e70790a3b795-6b05e3ea7ea30.jpg?jadewits_media_id=1056792" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/2dd7f455fe957d63c8e5e70790a3b795-6b05e3ea7ea30.jpg?jadewits_media_id=1056792" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/2dd7f455fe957d63c8e5e70790a3b795-6b05e3ea7ea30.jpg?jadewits_media_id=1056792" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভিসা পরিবর্তন করে ফেরার পথে আমিরাতে বাস-ট্রাক সংঘর্ষ, ভারতীয়সহ নিহত ১৩" /&gt;&lt;/p&gt;&lt;p&gt;সংযুক্ত আরব আমিরাতের রাস আল খাইমাহতে বাস ও ট্রাকের ভয়াবহ সংঘর্ষে ১৩ জন নিহত হয়েছেন। এ ঘটনায় আহত হয়েছেন আরও ১৪ জন। দুবাইভিত্তিক সংবাদমাধ্যম গালফ নিউজ এ খবর জানিয়েছে।&amp;nbsp;
পুলিশ জানায়, মঙ্গলবার ভোরের দিকে দক্ষিণাঞ্চলীয় বেল্টের আল ওয়াতান সড়কে এ দুর্ঘটনা ঘটে। কারিগরি ত্রুটির কারণে রাস্তার পাশে দাঁড়ি&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/middle-east/983066/%E0%A6%AD%E0%A6%BF%E0%A6%B8%E0%A6%BE-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%86%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B8-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%95">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ধারণ ক্ষমতার আড়াইগুণ বেশি বন্দি, কারাগারে মানবিক সংকট</title>
      <link>https://www.banglatribune.com/law-and-crime/983028/%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A6%A3-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%AE%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%A1%E0%A6%BC%E0%A6%BE%E0%A6%87%E0%A6%97%E0%A7%81%E0%A6%A3-%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%BF-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%BF-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%97%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%BF%E0%A6%95</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/983028/%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A6%A3-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%AE%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%A1%E0%A6%BC%E0%A6%BE%E0%A6%87%E0%A6%97%E0%A7%81%E0%A6%A3-%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%BF-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%BF-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%97%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%BF%E0%A6%95</guid>
      <pubDate>Wed, 25 Nov 2026 00:00:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2025/11/06/-bfb1ac85652728404bef2bd324956d4d-88f6ef24d25c5aeaf793ec127b23aabe-bc6cfcdc2264a264d36c643dede42eb7.jpg?jadewits_media_id=999920" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2025/11/06/-bfb1ac85652728404bef2bd324956d4d-88f6ef24d25c5aeaf793ec127b23aabe-bc6cfcdc2264a264d36c643dede42eb7.jpg?jadewits_media_id=999920" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2025/11/06/-bfb1ac85652728404bef2bd324956d4d-88f6ef24d25c5aeaf793ec127b23aabe-bc6cfcdc2264a264d36c643dede42eb7.jpg?jadewits_media_id=999920" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ধারণ ক্ষমতার আড়াইগুণ বেশি বন্দি, কারাগারে মানবিক সংকট" /&gt;&lt;/p&gt;&lt;p&gt;দেশের কারাগারগুলোতে ৪৫ হাজার বন্দি রাখার জায়গা আছে। অথচ সেখানে থাকতে হচ্ছে প্রায় এক লাখ ১৭ হাজার বন্দিকে। এতে প্রতি ১০০ জনের জন্য নির্ধারিত জায়গায় গড়ে অবস্থান করছেন ২৫৯ জন বন্দি। ধারণ ক্ষমতার আড়াই গুণের বেশি বন্দির চাপে কার্যত বিপর্যস্ত হয়ে পড়ছে কারাগারের আবাসন, স্যানিটেশন, চিকিৎসা ও দৈনন্দিন ব্যবস্&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/983028/%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A6%A3-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%AE%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%A1%E0%A6%BC%E0%A6%BE%E0%A6%87%E0%A6%97%E0%A7%81%E0%A6%A3-%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%BF-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%BF-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%97%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%BF%E0%A6%95">বাংলা ট্রিবিউন</source>
    </item>

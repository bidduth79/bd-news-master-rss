    <item>
      <title>রমজানে ১০ পণ্যের আমদানি ও এলসি শর্ত সহজ করতে কেন্দ্রীয় ব্যাংকের নির্দেশ</title>
      <link>https://www.banglatribune.com/business/news/979711/%E0%A6%B0%E0%A6%AE%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A7%A7%E0%A7%A6-%E0%A6%AA%E0%A6%A3%E0%A7%8D%E0%A6%AF-%E0%A6%86%E0%A6%AE%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%93-%E0%A6%8F%E0%A6%B2%E0%A6%B8%E0%A6%BF-%E0%A6%B6%E0%A6%B0%E0%A7%8D%E0%A6%A4-%E0%A6%B8%E0%A6%B9%E0%A6%9C-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/business/news/979711/%E0%A6%B0%E0%A6%AE%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A7%A7%E0%A7%A6-%E0%A6%AA%E0%A6%A3%E0%A7%8D%E0%A6%AF-%E0%A6%86%E0%A6%AE%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%93-%E0%A6%8F%E0%A6%B2%E0%A6%B8%E0%A6%BF-%E0%A6%B6%E0%A6%B0%E0%A7%8D%E0%A6%A4-%E0%A6%B8%E0%A6%B9%E0%A6%9C-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87</guid>
      <pubDate>Mon, 09 Nov 2026 02:21:55 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2017/05/04/ee44ef133b68e91ae8efec62e7294a87-590a865687210.jpg?jadewits_media_id=202601" length="0" type="image/jpeg" />

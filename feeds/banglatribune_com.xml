    <item>
      <title>বিএনপি নেতাকে ছুরিকাঘাতের সূত্র ধরে মিললো ১১টি ‘শক্তিশালী আইইডি’ বোমা, কে এই সুজন?</title>
      <link>https://www.banglatribune.com/country/chitagong/980598/%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%9B%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%98%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%82%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%A7%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2%E0%A7%8B-%E0%A7%A7%E0%A7%A7%E0%A6%9F%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/chitagong/980598/%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%9B%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%98%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%82%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%A7%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2%E0%A7%8B-%E0%A7%A7%E0%A7%A7%E0%A6%9F%E0%A6%BF</guid>
      <pubDate>Thu, 12 Nov 2026 23:09:14 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/d7f56ddcd0d531da8a07843fd4b02192-6af5f2a7533e6.jpg?jadewits_media_id=1054714" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/d7f56ddcd0d531da8a07843fd4b02192-6af5f2a7533e6.jpg?jadewits_media_id=1054714" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/d7f56ddcd0d531da8a07843fd4b02192-6af5f2a7533e6.jpg?jadewits_media_id=1054714" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিএনপি নেতাকে ছুরিকাঘাতের সূত্র ধরে মিললো ১১টি ‘শক্তিশালী আইইডি’ বোমা, কে এই সুজন?" /&gt;&lt;/p&gt;&lt;p&gt;লক্ষ্মীপুরের রায়পুর উপজেলায় বাড়ির উঠানে গর্ত করে দুধের কৌটায় পুঁতে রাখা ১১টি &amp;lsquo;শক্তিশালী&amp;rsquo; আইইডি (ইম্প্রোভাইজড এক্সপ্লোসিভ ডিভাইস) বোমা উদ্ধার করা হয়েছে বলে জানিয়েছে পুলিশ। পরে বোমাগুলো নিষ্ক্রিয় করেছে ঢাকা মহানগর পুলিশের (ডিএমপি) বোমা নিষ্ক্রিয়করণ দল। এর মধ্যে ছয়টি বড় ও পাঁচটি ছোট বোমা ছ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/chitagong/980598/%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%9B%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%98%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%82%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%A7%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2%E0%A7%8B-%E0%A7%A7%E0%A7%A7%E0%A6%9F%E0%A6%BF">বাংলা ট্রিবিউন</source>

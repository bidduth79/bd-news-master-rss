      <title>কিশোরগঞ্জ-৩ উপনির্বাচনে জামায়াতের প্রার্থী হচ্ছেন সাবেক রাষ্ট্রপতি আবদুল হামিদের শ্যালক</title>
      <link>https://www.banglatribune.com/country/dhaka/983549/%E0%A6%95%E0%A6%BF%E0%A6%B6%E0%A7%8B%E0%A6%B0%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C-%E0%A7%A9-%E0%A6%89%E0%A6%AA%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%9A%E0%A6%A8%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/dhaka/983549/%E0%A6%95%E0%A6%BF%E0%A6%B6%E0%A7%8B%E0%A6%B0%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C-%E0%A7%A9-%E0%A6%89%E0%A6%AA%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%9A%E0%A6%A8%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Fri, 27 Nov 2026 13:29:10 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/167b56f0752cbdfe5d42caeed444794d-6b09312503d51.jpg?jadewits_media_id=1057209" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/167b56f0752cbdfe5d42caeed444794d-6b09312503d51.jpg?jadewits_media_id=1057209" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/167b56f0752cbdfe5d42caeed444794d-6b09312503d51.jpg?jadewits_media_id=1057209" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কিশোরগঞ্জ-৩ উপনির্বাচনে জামায়াতের প্রার্থী হচ্ছেন সাবেক রাষ্ট্রপতি আবদুল হামিদের শ্যালক" /&gt;&lt;/p&gt;&lt;p&gt;কিশোরগঞ্জ-৩ (করিমগঞ্জ-তাড়াইল) আসনের উপনির্বাচনে জামায়াতে ইসলামীর সম্ভাব্য প্রার্থী হিসেবে কর্নেল (অব.) অধ্যাপক জিহাদ খানের নাম সামনে এসেছে। ত্রয়োদশ জাতীয় সংসদ নির্বাচনেও এ আসনে জামায়াতের প্রার্থী হিসেবে প্রতিদ্বন্দ্বিতা করেছিলেন তিনি। এবারও তাকে প্রার্থী করে নির্বাচনী কার্যক্রম এগিয়ে নেওয়ার কথা জানি&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/dhaka/983549/%E0%A6%95%E0%A6%BF%E0%A6%B6%E0%A7%8B%E0%A6%B0%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C-%E0%A7%A9-%E0%A6%89%E0%A6%AA%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%9A%E0%A6%A8%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87%E0%A6%A8">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>বন্দে ভারত স্লিপারের ফার্স্ট এসি বনাম পুরনো ফার্স্ট এসি</title>

      <guid isPermaLink="true">https://www.banglatribune.com/country/chitagong/983052/%E0%A6%95%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%A7%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%85%E0%A6%9F%E0%A7%8B%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%B6%E0%A6%BE%E0%A6%B0-%E0%A7%AB-%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4</guid>
      <pubDate>Tue, 24 Nov 2026 22:51:32 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/906b65852de9a3b523d85b38b607d294-6b05c086ed24b.jpg?jadewits_media_id=1056778" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/906b65852de9a3b523d85b38b607d294-6b05c086ed24b.jpg?jadewits_media_id=1056778" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/906b65852de9a3b523d85b38b607d294-6b05c086ed24b.jpg?jadewits_media_id=1056778" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কক্সবাজারে বাসের ধাক্কায় অটোরিকশার ৫ যাত্রী নিহত" /&gt;&lt;/p&gt;&lt;p&gt;কক্সবাজারের ঈদগাঁও উপজেলায় বাসের ধাক্কায় সিএনজিচালিত অটোরিকশার পাঁচ যাত্রী নিহত হয়েছেন। মঙ্গলবার (২৪ নভেম্বর) সন্ধ্যা সাড়ে ৬টার দিকে ঈদগাঁও থানার ফকিরাবাজার এলাকায় চট্টগ্রাম-কক্সবাজার মহাসড়কে এ দুর্ঘটনা ঘটে। ঈদগাঁও থানার ভারপ্রাপ্ত কর্মকর্তা (ওসি) এ টি এম সিফাতুল মাজদার বিষয়টি নিশ্চিত করেছেন।
পুলিশ &lt;/p&gt;</description>

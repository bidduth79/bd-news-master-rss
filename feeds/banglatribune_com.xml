      <guid isPermaLink="true">https://www.banglatribune.com/national/980611/%E0%A6%97%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%B0%E0%A6%AC%E0%A6%B0%E0%A6%BE%E0%A6%B9-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%B2%E0%A7%87-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7-%E0%A6%B8%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%A5%E0%A6%BE</guid>
      <pubDate>Fri, 13 Nov 2026 00:37:43 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/64d9015e9438ba4c7e57bc6c3b0ffeb6-6af607474482f.jpg?jadewits_media_id=1054725" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/64d9015e9438ba4c7e57bc6c3b0ffeb6-6af607474482f.jpg?jadewits_media_id=1054725" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/64d9015e9438ba4c7e57bc6c3b0ffeb6-6af607474482f.jpg?jadewits_media_id=1054725" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গ্যাসের সরবরাহ বাড়লে বন্ধ সার কারখানায় দেওয়ার কথা ভাববে সরকার: জ্বালানিমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;দেশে গ্যাসের প্রাপ্যতা বাড়লে বর্তমানে গ্যাস সংকটে বন্ধ থাকা সার কারখানাগুলোতে আবারও সরবরাহের বিষয়টি বিবেচনা করবে সরকার। বৃহস্পতিবার (১২ নভেম্বর) জাতীয় সংসদে এ কথা জানিয়েছেন জ্বালানিমন্ত্রী ইকবাল হাসান মাহমুদ টুকু।
ব্রাহ্মণবাড়িয়ার সংসদ সদস্য নাদিয়া পাঠান পাপনের এক সম্পূরক প্রশ্নের জবাবে তিনি এ কথা বল&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/980611/%E0%A6%97%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%B0%E0%A6%AC%E0%A6%B0%E0%A6%BE%E0%A6%B9-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%B2%E0%A7%87-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7-%E0%A6%B8%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%A5%E0%A6%BE">বাংলা ট্রিবিউন</source>

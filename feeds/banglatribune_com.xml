      <guid isPermaLink="true">https://www.banglatribune.com/educations/980798/%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%B9%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A6%BF%E0%A6%A4%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A7%87%E0%A6%A1%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2-%E0%A6%B8%E0%A6%BF%E0%A6%9F%E0%A6%BF</guid>
      <pubDate>Sat, 14 Nov 2026 04:43:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/fff4e885cb0f29260d8a406e96b7dd8d-6af789f03b274.jpg?jadewits_media_id=1054884" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/fff4e885cb0f29260d8a406e96b7dd8d-6af789f03b274.jpg?jadewits_media_id=1054884" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/fff4e885cb0f29260d8a406e96b7dd8d-6af789f03b274.jpg?jadewits_media_id=1054884" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যুক্তরাষ্ট্রের হাসপাতালের সহযোগিতায় মেডিক্যাল সিটি প্রতিষ্ঠার উদ্যোগ" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাষ্ট্রের নিউইয়র্কের ব্রুকডেল ইউনিভার্সিটি হাসপাতালের সহযোগিতায় বাংলাদেশে &amp;lsquo;ন্যাশনাল ইউনিভার্সিটি মেডিক্যাল সিটি&amp;rsquo; প্রতিষ্ঠার উদ্যোগ নেওয়া হয়েছে। এ লক্ষ্যে হাসপাতালটির পরিচালক ড. মুজিবুর আর. মজুমদারের সঙ্গে বৈঠক করেছেন জাতীয় বিশ্ববিদ্যালয়ের উপাচার্য অধ্যাপক ড. এ এস এম আমানুল্লাহ।
শুক্&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/educations/980798/%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%B9%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A6%BF%E0%A6%A4%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A7%87%E0%A6%A1%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2-%E0%A6%B8%E0%A6%BF%E0%A6%9F%E0%A6%BF">বাংলা ট্রিবিউন</source>

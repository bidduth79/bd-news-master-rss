      <guid isPermaLink="true">https://www.banglatribune.com/country/chitagong/981405/%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%B7%E0%A6%A6-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B6%E0%A6%BE%E0%A6%B8%E0%A6%95%E0%A6%95%E0%A7%87-%E0%A6%AD%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A6%93-%E0%A6%95%E0%A6%B2-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%86%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A6%B0-%E0%A6%9B%E0%A6%AC%E0%A6%BF</guid>
      <pubDate>Tue, 17 Nov 2026 01:30:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/0df29b70969b9c03af1ee96f23c83808-6afb52a5349e6.jpg?jadewits_media_id=1055386" length="0" type="image/jpeg" />

    <item>
      <title>গার্মেন্টস কর্মী নুপুরের মৃত্যুর খবর গুজব, বিভ্রান্ত না হওয়ার অনুরোধ ডিএমপির</title>
      <link>https://www.banglatribune.com/others/981847/%E0%A6%97%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%B8-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%80-%E0%A6%A8%E0%A7%81%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%B0-%E0%A6%96%E0%A6%AC%E0%A6%B0-%E0%A6%97%E0%A7%81%E0%A6%9C%E0%A6%AC</link>
      <guid isPermaLink="true">https://www.banglatribune.com/others/981847/%E0%A6%97%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%B8-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%80-%E0%A6%A8%E0%A7%81%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%B0-%E0%A6%96%E0%A6%AC%E0%A6%B0-%E0%A6%97%E0%A7%81%E0%A6%9C%E0%A6%AC</guid>

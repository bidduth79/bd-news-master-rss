      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2021/10/08/1c874b95d47bb47997f49587af99b4d3-615fdb9d9482b.jpg?jadewits_media_id=752435" medium="image" />

      <guid isPermaLink="true">https://www.banglatribune.com/country/rajshahi/983769/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A7%80-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A7%8E-%E0%A6%89%E0%A6%AA%E0%A6%95%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%87-%E2%80%98%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B2-%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE%E2%80%99</guid>
      <pubDate>Sat, 28 Nov 2026 15:00:08 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/5fc97089be4be9def4f7d4fa772aa880-6b0a97e655f11.jpg?jadewits_media_id=1057448" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/5fc97089be4be9def4f7d4fa772aa880-6b0a97e655f11.jpg?jadewits_media_id=1057448" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/5fc97089be4be9def4f7d4fa772aa880-6b0a97e655f11.jpg?jadewits_media_id=1057448" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজশাহীতে পল্লী বিদ্যুৎ উপকেন্দ্রে ‘পেট্রোল বোমা’ নিক্ষেপ-গুলিবর্ষণ" /&gt;&lt;/p&gt;&lt;p&gt;রাজশাহীতে পল্লী বিদ্যুৎ সমিতির উপকেন্দ্রে টানা দুই দিন পেট্রোল বোমা নিক্ষেপ ও গুলিবর্ষণের ঘটনায় কর্মকর্তা-কর্মচারীদের মধ্যে আতঙ্ক ছড়িয়ে পড়েছে। সর্বশেষ শুক্রবার (২৭ নভেম্বর) গভীর রাতে পবা উপজেলার পারিলা ইউনিয়নের খড়খড়ি এলাকায় পল্লী বিদ্যুৎ সমিতির পবা-২ উপকেন্দ্রে হামলা চালায় ৮ থেকে ১০ জন দুর্বৃত্ত। এ &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/rajshahi/983769/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A7%80-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A7%8E-%E0%A6%89%E0%A6%AA%E0%A6%95%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%87-%E2%80%98%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B2-%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE%E2%80%99">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>স্থানীয় এলসিতে সুইফটের বিকল্প ‘বার্তা’, বছরে সাশ্রয় হবে ৬০ লাখ ডলার</title>
      <link>https://www.banglatribune.com/business/news/983768/%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A7%9F-%E0%A6%8F%E0%A6%B2%E0%A6%B8%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A7%81%E0%A6%87%E0%A6%AB%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA-%E2%80%98%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE%E2%80%99-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/business/news/983768/%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A7%9F-%E0%A6%8F%E0%A6%B2%E0%A6%B8%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A7%81%E0%A6%87%E0%A6%AB%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA-%E2%80%98%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE%E2%80%99-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87</guid>
      <pubDate>Sat, 28 Nov 2026 14:56:14 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/45ef6884c23a95c3ad52477bff25dfaa-6b0a96cc39017.jpg?jadewits_media_id=1057447" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/45ef6884c23a95c3ad52477bff25dfaa-6b0a96cc39017.jpg?jadewits_media_id=1057447" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/45ef6884c23a95c3ad52477bff25dfaa-6b0a96cc39017.jpg?jadewits_media_id=1057447" style="max-width:100%;height:auto;margin-bottom:10px;" alt="স্থানীয় এলসিতে সুইফটের বিকল্প ‘বার্তা’, বছরে সাশ্রয় হবে ৬০ লাখ ডলার" /&gt;&lt;/p&gt;&lt;p&gt;স্থানীয় ঋণপত্র (এলসি) খোলার ক্ষেত্রে আন্তর্জাতিক লেনদেন ব্যবস্থা সুইফটের ওপর নির্ভরতা কমাতে দেশীয় প্রযুক্তিতে &amp;lsquo;বার্তা&amp;rsquo; নামে নতুন একটি ডিজিটাল প্ল্যাটফর্ম চালু করেছে বাংলাদেশ ব্যাংক। এর মাধ্যমে স্থানীয় এলসির তথ্য আদান-প্রদান ও নিষ্পত্তি কার্যক্রম পরিচালিত হবে। এতে ব্যাংক ও ব্যবসায়ীদের লেন&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/business/news/983768/%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A7%9F-%E0%A6%8F%E0%A6%B2%E0%A6%B8%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A7%81%E0%A6%87%E0%A6%AB%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA-%E2%80%98%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE%E2%80%99-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>‘হামজা আমার অনুপ্রেরণা’</title>
      <link>https://www.banglatribune.com/sport/football/983767/%E2%80%98%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%9C%E0%A6%BE-%E0%A6%86%E0%A6%AE%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B0%E0%A6%A3%E0%A6%BE%E2%80%99</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/football/983767/%E2%80%98%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%9C%E0%A6%BE-%E0%A6%86%E0%A6%AE%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B0%E0%A6%A3%E0%A6%BE%E2%80%99</guid>
      <pubDate>Sat, 28 Nov 2026 14:50:40 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/d8e8808b949d01e07ffc8bd58ea7c970-6af48ff34d0e5.jpg?jadewits_media_id=1054515" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/d8e8808b949d01e07ffc8bd58ea7c970-6af48ff34d0e5.jpg?jadewits_media_id=1054515" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/d8e8808b949d01e07ffc8bd58ea7c970-6af48ff34d0e5.jpg?jadewits_media_id=1054515" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘হামজা আমার অনুপ্রেরণা’" /&gt;&lt;/p&gt;&lt;p&gt;শ্রীলঙ্কার বিপক্ষে সাফ চ্যাম্পিয়নশিপে ফারহান আলী ওয়াহিদের অবিশ্বাস্য একক গোল জালে জড়াতেই অবিশ্বাসে মুখ হাঁ হয়ে যায় হামজা চৌধুরীর। বাংলাদেশের অধিনায়ক প্রতিপক্ষ গোলরক্ষককে পরাস্ত করে বলের জালে ঢুকে পড়া দেখছিলেন, দুই হাত তুলে বিস্ময় প্রকাশ করলেন। এরপর সতীর্থদের সঙ্গে যোগ দেন উদযাপনে।
উচ্ছ্বাস কিছুটা কম&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/football/983767/%E2%80%98%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%9C%E0%A6%BE-%E0%A6%86%E0%A6%AE%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B0%E0%A6%A3%E0%A6%BE%E2%80%99">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>কাশবনে সবাই ছবি তোলে, মৌসুম শেষ হলে কাশবনের কি হয়</title>

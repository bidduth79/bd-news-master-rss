      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/2bff118d09e1c4396a93b104bc5a2334-6af8be2a4767e.jpg?jadewits_media_id=1055028" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/2bff118d09e1c4396a93b104bc5a2334-6af8be2a4767e.jpg?jadewits_media_id=1055028" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/2bff118d09e1c4396a93b104bc5a2334-6af8be2a4767e.jpg?jadewits_media_id=1055028" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গোপালগঞ্জে বিএনপির দুটি কার্যালয়ে ভাঙচুর, অগ্নিসংযোগ" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জের টুঙ্গিপাড়ায় বিএনপি ও যুবদলের দুটি কার্যালয়ে ভাঙচুর ও অগ্নিসংযোগের ঘটনা ঘটেছে। কার্যক্রম নিষিদ্ধ আওয়ামী লীগ ও এর সহযোগী সংগঠনের নেতাকর্মীরা এ ঘটনা ঘটিয়েছে বলে জানিয়েছেন বিএনপির নেতাকর্মীরা।
শনিবার (১৪ নভেম্বর) রাতে টুঙ্গিপাড়া উপজেলার নিলফা বাজার ও বর্ণি বাজারে পৃথকভাবে এ ঘটনা ঘটে।
স্থানীয়&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/dhaka/980960/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%9F%E0%A6%BF-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87-%E0%A6%AD%E0%A6%BE%E0%A6%99%E0%A6%9A%E0%A7%81%E0%A6%B0">বাংলা ট্রিবিউন</source>

      <pubDate>Sat, 14 Nov 2026 15:49:15 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/b88ee35d1d8a7300681cd0e5d2ba1731-6af82cab2dfcf.jpg?jadewits_media_id=1054945" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/b88ee35d1d8a7300681cd0e5d2ba1731-6af82cab2dfcf.jpg?jadewits_media_id=1054945" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/b88ee35d1d8a7300681cd0e5d2ba1731-6af82cab2dfcf.jpg?jadewits_media_id=1054945" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মৃত্যুর সাড়ে সাত মাস পর ককটেল বিস্ফোরণ মামলার আসামি বীর মুক্তিযোদ্ধা!" /&gt;&lt;/p&gt;&lt;p&gt;পদ্মা সেতুর দক্ষিণ প্রান্তের টোলপ্লাজায় সড়ক অবরোধ, যানবাহন ভাঙচুর ও ককটেল বিস্ফোরণের ঘটনায় করা মামলায় আসামির তালিকায় নাম এসেছে এক মৃত ব্যক্তির। সামচু ঢালী নামের ওই ব্যক্তি একজন বীর মুক্তিযোদ্ধা এবং কুতুবপুর ইউনিয়ন আওয়ামী লীগের ভারপ্রাপ্ত সভাপতি ছিলেন। গত ২৯ মার্চ তার মৃত্যু হয়। অথচ প্রায় সাড়ে সাত মা&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/dhaka/980871/%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A7%9C%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%A4-%E0%A6%AE%E0%A6%BE%E0%A6%B8-%E0%A6%AA%E0%A6%B0-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>

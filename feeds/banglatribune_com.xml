      <guid isPermaLink="true">https://www.banglatribune.com/national/983698/%E0%A6%B6%E0%A6%A8%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B7-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%A8</guid>
      <pubDate>Sat, 28 Nov 2026 04:11:33 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/666a4c13cb8ce64ea1077a2676253518-6b03263cda4bd.jpg?jadewits_media_id=1056415" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/666a4c13cb8ce64ea1077a2676253518-6b03263cda4bd.jpg?jadewits_media_id=1056415" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/666a4c13cb8ce64ea1077a2676253518-6b03263cda4bd.jpg?jadewits_media_id=1056415" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শনিবার জাতীয় বিশ্ববিদ্যালয়ের অধ্যক্ষ সম্মিলন, থাকবেন প্রধানমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;জাতীয় বিশ্ববিদ্যালয়ের অধিভুক্ত কলেজগুলোর শিক্ষা কার্যক্রমের মানোন্নয়ন, প্রশাসনিক দক্ষতা বৃদ্ধি ও উচ্চশিক্ষার ভবিষ্যৎ পরিকল্পনা নিয়ে শনিবার (২৮ নভেম্বর) অনুষ্ঠিত হবে &amp;lsquo;অধ্যক্ষ সম্মিলন ২০২৬&amp;rsquo;। এতে দেশের ২ হাজার ৩১৮টি অধিভুক্ত কলেজের অধ্যক্ষ অংশ নেবেন।
রাজধানীর মিরপুরে শহীদ সোহরাওয়ার্দী ইনডোর&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/983698/%E0%A6%B6%E0%A6%A8%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B7-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%A8">বাংলা ট্রিবিউন</source>
    </item>

      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/979652/%E0%A6%AC%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%82%E0%A6%AA-%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A7%87%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Sun, 08 Nov 2026 19:30:03 +0600</pubDate>
      <description>কোনও প্রমাণ ছাড়াই সংবাদ সম্মেলন করে বিচারককে নিয়ে বিষোদগার করায় সুপ্রিম কোর্টের আইনজীবী ব্যারিস্টার এম সারোয়ার হোসেনকে তলব করেছেন হাইকোর্ট। আগামী ২৬ নভেম্বর তাকে আদালতে হাজির হয়ে এ বিষয়ে ব্যাখ্যা দিতে বলা হয়। একইসঙ্গে বিচারককে নিয়ে তার বক্তব্য সামাজি</description>
      <source url="https://www.banglatribune.com/law-and-crime/979652/%E0%A6%AC%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%82%E0%A6%AA-%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A7%87%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0">বাংলা ট্রিবিউন</source>

      <source url="https://www.banglatribune.com/law-and-crime/979899/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%9C%E0%A7%81%E0%A7%9C%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%BE-%E0%A6%B8%E0%A6%B9%E0%A6%BF%E0%A6%82%E0%A6%B8%E0%A6%A4%E0%A6%BE%E0%A7%9F-%E0%A6%86%E0%A6%87%E0%A6%A8%E0%A6%B6%E0%A7%83%E0%A6%99%E0%A7%8D%E0%A6%96%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%AC%E0%A6%A8%E0%A6%A4%E0%A6%BF-%E0%A6%9C%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%87">বাংলা ট্রিবিউন</source>

    <item>
      <title>এবার সৌদি আরবের বন্দরে হুথিদের ক্ষেপণাস্ত্র হামলা</title>
      <link>https://www.banglatribune.com/foreign/middle-east/983312/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%8C%E0%A6%A6%E0%A6%BF-%E0%A6%86%E0%A6%B0%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%B0%E0%A7%87-%E0%A6%B9%E0%A7%81%E0%A6%A5%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA%E0%A6%A3%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/middle-east/983312/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%8C%E0%A6%A6%E0%A6%BF-%E0%A6%86%E0%A6%B0%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%B0%E0%A7%87-%E0%A6%B9%E0%A7%81%E0%A6%A5%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA%E0%A6%A3%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE</guid>
      <pubDate>Thu, 26 Nov 2026 10:10:59 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/1b70a406778884984f7516236e7307b0-6b07af7897977.jpg?jadewits_media_id=1056993" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/1b70a406778884984f7516236e7307b0-6b07af7897977.jpg?jadewits_media_id=1056993" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/1b70a406778884984f7516236e7307b0-6b07af7897977.jpg?jadewits_media_id=1056993" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এবার সৌদি আরবের বন্দরে হুথিদের ক্ষেপণাস্ত্র হামলা" /&gt;&lt;/p&gt;&lt;p&gt;ইয়েমেনের হুথি গোষ্ঠী সৌদি আরবের লোহিত সাগর উপকূলের জিজান বন্দরে হামলা চালিয়েছে। ইয়েমেনের তাইজ শহরের কাছে লড়াই তীব্র হওয়ার মধ্যেই এ হামলা হয়। কাতারভিত্তিক সংবাদমাধ্যম আল জাজিরা এ খবর জানিয়েছে।
সৌদি নেতৃত্বাধীন সামরিক জোট জানায়, বুধবার জিজানে হুথি হামলায় সামান্য ক্ষতি হয়েছে, কোনও বেসামরিক হতা&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/middle-east/983312/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%8C%E0%A6%A6%E0%A6%BF-%E0%A6%86%E0%A6%B0%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%B0%E0%A7%87-%E0%A6%B9%E0%A7%81%E0%A6%A5%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA%E0%A6%A3%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>‘ট্রাভেল কম্প্যানিয়ন’: ভ্রমণসঙ্গী হওয়াই যাদের পেশা</title>
      <link>https://www.banglatribune.com/journey/983284/%E2%80%98%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AD%E0%A7%87%E0%A6%B2-%E0%A6%95%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%A8%E2%80%99-%E0%A6%AD%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%A3%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%80-%E0%A6%B9%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%87-%E0%A6%AF%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%87%E0%A6%B6%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/journey/983284/%E2%80%98%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AD%E0%A7%87%E0%A6%B2-%E0%A6%95%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%A8%E2%80%99-%E0%A6%AD%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%A3%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%80-%E0%A6%B9%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%87-%E0%A6%AF%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%87%E0%A6%B6%E0%A6%BE</guid>
      <pubDate>Thu, 26 Nov 2026 10:10:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/20ff543a4af30423b79999e2247ea323-6b0756dad131f.jpg?jadewits_media_id=1056972" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/20ff543a4af30423b79999e2247ea323-6b0756dad131f.jpg?jadewits_media_id=1056972" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/20ff543a4af30423b79999e2247ea323-6b0756dad131f.jpg?jadewits_media_id=1056972" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘ট্রাভেল কম্প্যানিয়ন’: ভ্রমণসঙ্গী হওয়াই যাদের পেশা" /&gt;&lt;/p&gt;&lt;p&gt;&amp;nbsp;
&amp;nbsp;
ভ্রমণ করতে ভালোবাসেন না, এমন মানুষ খুঁজে পাওয়া কঠিন। নতুন দেশ দেখা, অচেনা শহরে ঘুরে বেড়ানো কিংবা ব্যস্ত জীবন থেকে কিছুটা বিরতি নেওয়া- ভ্রমণের আনন্দই আলাদা। তবে চীনের একদল তরুণের কাছে ভ্রমণ এখন শুধু শখ নয়, পেশাও। বিমানে একা যাত্রা করতে অনিচ্ছুক কিংবা যাদের বিশেষ সহায়তা প্রয়োজন, তাদের সঙ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/journey/983284/%E2%80%98%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AD%E0%A7%87%E0%A6%B2-%E0%A6%95%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%A8%E2%80%99-%E0%A6%AD%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%A3%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%80-%E0%A6%B9%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%87-%E0%A6%AF%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%87%E0%A6%B6%E0%A6%BE">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>আধুনিক প্রযুক্তিতে সাত জেলা পর্যবেক্ষণ করছে ১০৯ প্লাটুন বিজিবি</title>
      <link>https://www.banglatribune.com/law-and-crime/983311/%E0%A6%86%E0%A6%A7%E0%A7%81%E0%A6%A8%E0%A6%BF%E0%A6%95-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%A4-%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A7%87%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A3-%E0%A6%95%E0%A6%B0%E0%A6%9B%E0%A7%87-%E0%A7%A7%E0%A7%A6%E0%A7%AF</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/983311/%E0%A6%86%E0%A6%A7%E0%A7%81%E0%A6%A8%E0%A6%BF%E0%A6%95-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%A4-%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A7%87%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A3-%E0%A6%95%E0%A6%B0%E0%A6%9B%E0%A7%87-%E0%A7%A7%E0%A7%A6%E0%A7%AF</guid>
      <pubDate>Thu, 26 Nov 2026 10:03:30 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/21a7d241d40728780cec1beb8d3ba5e5-6af2a2015e68f.jpg?jadewits_media_id=1054160" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/21a7d241d40728780cec1beb8d3ba5e5-6af2a2015e68f.jpg?jadewits_media_id=1054160" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/21a7d241d40728780cec1beb8d3ba5e5-6af2a2015e68f.jpg?jadewits_media_id=1054160" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আধুনিক প্রযুক্তিতে সাত জেলা পর্যবেক্ষণ করছে ১০৯ প্লাটুন বিজিবি" /&gt;&lt;/p&gt;&lt;p&gt;আইনশৃঙ্খলা পরিস্থিতি নিয়ন্ত্রণ, জননিরাপত্তা নিশ্চিতকরণ এবং যেকোনও ধরনের অনাকাঙ্ক্ষিত পরিস্থিতি মোকাবিলায় ঢাকা, নারায়ণগঞ্জ, গাজীপুর, ময়মনসিংহ, গোপালগঞ্জ, চট্টগ্রাম ও কক্সবাজারে ১০৯ প্লাটুন বিজিবি মোতায়েন করা হয়েছে। বৃহস্পতিবার (২৬ নভেম্বর) এক সংবাদ বিজ্ঞপ্তি এ তথ্য জানায় বিজিবি।&amp;nbsp;
এতে বলা হয়, ঢাক&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/983311/%E0%A6%86%E0%A6%A7%E0%A7%81%E0%A6%A8%E0%A6%BF%E0%A6%95-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%A4-%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A7%87%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A3-%E0%A6%95%E0%A6%B0%E0%A6%9B%E0%A7%87-%E0%A7%A7%E0%A7%A6%E0%A7%AF">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ভারত থেকে সীমান্ত দিয়ে ঢুকছে অস্ত্র, যাচ্ছে বিভিন্ন জেলায়</title>
      <link>https://www.banglatribune.com/country/rajshahi/983272/%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A7%80%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A2%E0%A7%81%E0%A6%95%E0%A6%9B%E0%A7%87-%E0%A6%85%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/rajshahi/983272/%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A7%80%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A2%E0%A7%81%E0%A6%95%E0%A6%9B%E0%A7%87-%E0%A6%85%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87</guid>
      <pubDate>Thu, 26 Nov 2026 10:01:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/5e235af89e9c9fbac463568f61ce9c24-6b07288316edc.jpg?jadewits_media_id=1056952" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/5e235af89e9c9fbac463568f61ce9c24-6b07288316edc.jpg?jadewits_media_id=1056952" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/5e235af89e9c9fbac463568f61ce9c24-6b07288316edc.jpg?jadewits_media_id=1056952" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভারত থেকে সীমান্ত দিয়ে ঢুকছে অস্ত্র, যাচ্ছে বিভিন্ন জেলায়" /&gt;&lt;/p&gt;&lt;p&gt;ভারতীয় সীমান্তঘেঁষা রাজশাহী অঞ্চলে বাড়ছে অবৈধ অস্ত্রের আনাগোনা। সীমান্তের পদ্মার চর, পরিত্যক্ত মোটরসাইকেল, যাত্রীবাহী বাস কিংবা ব্যক্তিগত যানবাহন&amp;mdash;বিভিন্ন জায়গায় মিলছে বিদেশি পিস্তল, রিভলবার, ম্যাগাজিন ও গুলি। শুধু গত এক সপ্তাহেই তিনটি অভিযানে ছয়টি বিদেশি পিস্তল উদ্ধার করেছে আইনশৃঙ্খলা রক্ষাকার&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/rajshahi/983272/%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A7%80%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A2%E0%A7%81%E0%A6%95%E0%A6%9B%E0%A7%87-%E0%A6%85%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>মেসিকে ফোনই করেননি গার্দিওলা, কেন?</title>
      <link>https://www.banglatribune.com/sport/football/983274/%E0%A6%AE%E0%A7%87%E0%A6%B8%E0%A6%BF%E0%A6%95%E0%A7%87-%E0%A6%AB%E0%A7%8B%E0%A6%A8%E0%A6%87-%E0%A6%95%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A6%A8%E0%A6%BF-%E0%A6%97%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A6%BF%E0%A6%93%E0%A6%B2%E0%A6%BE-%E0%A6%95%E0%A7%87%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/football/983274/%E0%A6%AE%E0%A7%87%E0%A6%B8%E0%A6%BF%E0%A6%95%E0%A7%87-%E0%A6%AB%E0%A7%8B%E0%A6%A8%E0%A6%87-%E0%A6%95%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A6%A8%E0%A6%BF-%E0%A6%97%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A6%BF%E0%A6%93%E0%A6%B2%E0%A6%BE-%E0%A6%95%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Thu, 26 Nov 2026 10:00:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/f5e3600b4a85a52e6ac0eee97a77306f-6b073671c3d55.jpg?jadewits_media_id=1056954" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/f5e3600b4a85a52e6ac0eee97a77306f-6b073671c3d55.jpg?jadewits_media_id=1056954" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/f5e3600b4a85a52e6ac0eee97a77306f-6b073671c3d55.jpg?jadewits_media_id=1056954" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মেসিকে ফোনই করেননি গার্দিওলা, কেন?" /&gt;&lt;/p&gt;&lt;p&gt;লিওনেল মেসিকে আবার নিজের অধীনে পেতে চাইলেই পারতেন পেপ গার্দিওলা। বার্সেলোনার বাইরে অন্য কোনো ক্লাবে দায়িত্ব নেওয়ার পর আর্জেন্টাইন মহাতারকাকে দলে টানার সুযোগও ছিল তাঁর সামনে। কিন্তু কখনোই সে পথে হাঁটেননি স্প্যানিশ কোচ। কেন? কারণ, মেসিকে বার্সেলোনাতেই দেখতে চেয়েছিলেন তিনি। অর্থনৈতিক কিংবা ফুটবলীয় কোনো&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/football/983274/%E0%A6%AE%E0%A7%87%E0%A6%B8%E0%A6%BF%E0%A6%95%E0%A7%87-%E0%A6%AB%E0%A7%8B%E0%A6%A8%E0%A6%87-%E0%A6%95%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A6%A8%E0%A6%BF-%E0%A6%97%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A6%BF%E0%A6%93%E0%A6%B2%E0%A6%BE-%E0%A6%95%E0%A7%87%E0%A6%A8">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ইরানের সঙ্গে বৈঠকের কথা স্বীকার করলেন ট্রাম্পের বিশেষ দূত কুশনার</title>
      <link>https://www.banglatribune.com/foreign/america/983310/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%A5%E0%A6%BE-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A7%80%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/america/983310/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%A5%E0%A6%BE-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A7%80%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Thu, 26 Nov 2026 09:57:32 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/b8347238ed75dd56ef62cee1773edcdb-6b07adeac8e0d.jpg?jadewits_media_id=1056992" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/b8347238ed75dd56ef62cee1773edcdb-6b07adeac8e0d.jpg?jadewits_media_id=1056992" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/b8347238ed75dd56ef62cee1773edcdb-6b07adeac8e0d.jpg?jadewits_media_id=1056992" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইরানের সঙ্গে বৈঠকের কথা স্বীকার করলেন ট্রাম্পের বিশেষ দূত কুশনার" /&gt;&lt;/p&gt;&lt;p&gt;ইরানের সঙ্গে চলমান সংঘাতের মধ্যে দেশটির কর্মকর্তাদের সঙ্গে একাধিকবার বৈঠক করার কথা স্বীকার করেছেন মার্কিন বিশেষ দূত ও প্রেসিডেন্ট ডোনাল্ড ট্রাম্পের জামাতা জ্যারেড কুশনার। একইসঙ্গে তিনি জানিয়েছেন, ইরান ইস্যুতে ট্রাম্প প্রশাসন &amp;lsquo;সব ধরনের বিকল্প খোলা রেখেছে&amp;rsquo; এবং ভাইস প্রেসিডেন্ট জেডি ভ্যান্স&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/america/983310/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%A5%E0%A6%BE-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A7%80%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A7%87%E0%A6%B0">বাংলা ট্রিবিউন</source>

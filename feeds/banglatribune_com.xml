      <guid isPermaLink="true">https://www.banglatribune.com/entertainment/bollywood/979658/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%96-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B6-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9F%E0%A6%B0%E0%A6%BF%E0%A6%A8%E0%A6%BE-%E0%A6%AD%E0%A6%BF%E0%A6%95%E0%A6%BF</guid>
      <pubDate>Sun, 08 Nov 2026 19:48:36 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/b369bd7ec0e6f20f5267a2dbc90a4f4c-6af07d5753e9b.jpg?jadewits_media_id=1053916" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/b369bd7ec0e6f20f5267a2dbc90a4f4c-6af07d5753e9b.jpg?jadewits_media_id=1053916" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/b369bd7ec0e6f20f5267a2dbc90a4f4c-6af07d5753e9b.jpg?jadewits_media_id=1053916" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রথমবার সন্তানের মুখ প্রকাশ করলেন ক্যাটরিনা-ভিকি" /&gt;&lt;/p&gt;&lt;p&gt;দীপাবলির শুভক্ষণে ভক্তদের বড় সারপ্রাইজ দিলেন বলিউড তারকা দম্পতি ক্যাটরিনা কাইফ ও ভিকি কৌশল। এক বছর বয়সে পা দেওয়ার পর অবশেষে নিজেদের ছেলে বিহানের মুখ প্রথমবার প্রকাশ্যে আনলেন তারা।

কয়েক শতাব্দীর ভয়ংকর আত্মা নিয়ে ফিরছেন ড্যাভিকা!

গত ৭ নভেম্বর বিহানের প্রথম জন্মদিন পালনের ঠিক পরদিনই দীপাবলিতে ইনস্টাগ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/entertainment/bollywood/979658/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%96-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B6-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9F%E0%A6%B0%E0%A6%BF%E0%A6%A8%E0%A6%BE-%E0%A6%AD%E0%A6%BF%E0%A6%95%E0%A6%BF">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>যুক্তরাষ্ট্রে এবার ৯৭ মুসলিম প্রার্থী জয়ী, নেপথ্যে কী?</title>
      <link>https://www.banglatribune.com/foreign/america/979656/%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87-%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A7%AF%E0%A7%AD-%E0%A6%AE%E0%A7%81%E0%A6%B8%E0%A6%B2%E0%A6%BF%E0%A6%AE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80-%E0%A6%9C%E0%A7%9F%E0%A7%80-%E0%A6%A8%E0%A7%87%E0%A6%AA%E0%A6%A5%E0%A7%8D%E0%A6%AF%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/america/979656/%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87-%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A7%AF%E0%A7%AD-%E0%A6%AE%E0%A7%81%E0%A6%B8%E0%A6%B2%E0%A6%BF%E0%A6%AE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80-%E0%A6%9C%E0%A7%9F%E0%A7%80-%E0%A6%A8%E0%A7%87%E0%A6%AA%E0%A6%A5%E0%A7%8D%E0%A6%AF%E0%A7%87</guid>
      <pubDate>Sun, 08 Nov 2026 19:38:51 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/fdd3aabe64a9af2df931de5ffd268498-6af07aeb70c4e.jpg?jadewits_media_id=1053914" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/fdd3aabe64a9af2df931de5ffd268498-6af07aeb70c4e.jpg?jadewits_media_id=1053914" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/fdd3aabe64a9af2df931de5ffd268498-6af07aeb70c4e.jpg?jadewits_media_id=1053914" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যুক্তরাষ্ট্রে এবার ৯৭ মুসলিম প্রার্থী জয়ী, নেপথ্যে কী?" /&gt;&lt;/p&gt;&lt;p&gt;ইসলামোফোবিয়া ও ইসলামবিরোধী প্রচারণার রেকর্ড বৃদ্ধির মধ্যেও যুক্তরাষ্ট্রের সদ্য সমাপ্ত মধ্যবর্তী নির্বাচনে বিভিন্ন স্তরে রেকর্ড সংখ্যক মুসলিম আমেরিকান জয়ী হয়েছেন। কাউন্সিল অন আমেরিকান ইসলামিক রিলেশনসের (কেয়ার) তথ্য অনুযায়ী, ফেডারেল, অঙ্গরাজ্য ও স্থানীয় পর্যায় মিলিয়ে অন্তত ৯৭ জন মুসলিম আমেরিকান প্রা&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/america/979656/%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87-%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A7%AF%E0%A7%AD-%E0%A6%AE%E0%A7%81%E0%A6%B8%E0%A6%B2%E0%A6%BF%E0%A6%AE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80-%E0%A6%9C%E0%A7%9F%E0%A7%80-%E0%A6%A8%E0%A7%87%E0%A6%AA%E0%A6%A5%E0%A7%8D%E0%A6%AF%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>সীমান্ত থেকে সাইবার স্পেস: মাদকের বিস্তার রোধে নোটিশ</title>

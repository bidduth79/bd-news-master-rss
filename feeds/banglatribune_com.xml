      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/08/03/6192d6051c8aec3209607c2c3652a4e0-6a7037190edfa.jpg?jadewits_media_id=1036612" length="0" type="image/jpeg" />

      <guid isPermaLink="true">https://www.banglatribune.com/country/barishal/982077/%E0%A6%AC%E0%A6%B0%E0%A6%BF%E0%A6%B6%E0%A6%BE%E0%A6%B2-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%AF%E0%A7%87%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A6%BF-%E0%A6%A6%E0%A7%82%E0%A6%B0%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A7%8B%E0%A6%A8%E0%A6%93-%E0%A6%AC%E0%A6%BE%E0%A6%B8</guid>
      <pubDate>Fri, 20 Nov 2026 05:54:28 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/f828a83d1acb955e21a5843bdf06b08f-6aff8bdf49c9a.jpg?jadewits_media_id=1055947" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/f828a83d1acb955e21a5843bdf06b08f-6aff8bdf49c9a.jpg?jadewits_media_id=1055947" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/f828a83d1acb955e21a5843bdf06b08f-6aff8bdf49c9a.jpg?jadewits_media_id=1055947" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বরিশাল থেকে ঢাকায় যেতে পারেনি দূরপাল্লার কোনও বাস" /&gt;&lt;/p&gt;&lt;p&gt;নিষিদ্ধ ঘোষিত আওয়ামী লীগের ডাকা লকডাউনের কারণে বরিশাল থেকে ঢাকাগামী দূরপাল্লার বাস চলাচল ব্যাহত হয়েছে। বৃহস্পতিবার সকাল থেকে বিকাল ৫টা পর্যন্ত বরিশাল থেকে ছেড়ে যাওয়া কোনও বাস ঢাকায় পৌঁছাতে পারেনি। মহাসড়কে বাধার মুখে টেকেরহাট এলাকা থেকে বাসগুলোকে ফিরে আসতে হয়েছে।
নথুল্লাবাদ কেন্দ্রীয় বাস টার্মিনালের &lt;/p&gt;</description>

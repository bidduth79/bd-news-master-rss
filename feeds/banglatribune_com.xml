      <title>৪ হাসপাতাল ঘুরেও ছেলেকে বাঁচাতে পারেননি বাবা, আরেক ছেলে আইসিইউতে</title>
      <link>https://www.banglatribune.com/country/chitagong/979673/%E0%A7%AA-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B2-%E0%A6%98%E0%A7%81%E0%A6%B0%E0%A7%87%E0%A6%93-%E0%A6%9B%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%81%E0%A6%9A%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A6%A8%E0%A6%BF-%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A6%BE-%E0%A6%86%E0%A6%B0%E0%A7%87%E0%A6%95</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/chitagong/979673/%E0%A7%AA-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B2-%E0%A6%98%E0%A7%81%E0%A6%B0%E0%A7%87%E0%A6%93-%E0%A6%9B%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%81%E0%A6%9A%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A6%A8%E0%A6%BF-%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A6%BE-%E0%A6%86%E0%A6%B0%E0%A7%87%E0%A6%95</guid>
      <pubDate>Sun, 08 Nov 2026 20:36:48 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/54b6d3d1a301477cc3e39812edaffeb9-6af088e40155f.jpg?jadewits_media_id=1053926" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/54b6d3d1a301477cc3e39812edaffeb9-6af088e40155f.jpg?jadewits_media_id=1053926" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/54b6d3d1a301477cc3e39812edaffeb9-6af088e40155f.jpg?jadewits_media_id=1053926" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৪ হাসপাতাল ঘুরেও ছেলেকে বাঁচাতে পারেননি বাবা, আরেক ছেলে আইসিইউতে" /&gt;&lt;/p&gt;&lt;p&gt;এক সন্তানকে বাঁচাতে চার হাসপাতালে ছুটেছেন বাবা মোহাম্মদ কবীর। এক হাসপাতাল থেকে আরেক হাসপাতালে নিয়েছেন ছেলেকে। শেষে দিনের পর দিন আইসিইউতে চলেছে চিকিৎসা। কিন্তু শেষ পর্যন্ত নয় বছরের সন্তান নূর মোহাম্মদ আরাফাতকে বাঁচাতে পারেননি তিনি।&amp;nbsp;
গত শুক্রবার চট্টগ্রাম মা ও শিশু হাসপাতালে আইসিইউতে চিকিৎসাধীন অ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/chitagong/979673/%E0%A7%AA-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B2-%E0%A6%98%E0%A7%81%E0%A6%B0%E0%A7%87%E0%A6%93-%E0%A6%9B%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%81%E0%A6%9A%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A6%A8%E0%A6%BF-%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A6%BE-%E0%A6%86%E0%A6%B0%E0%A7%87%E0%A6%95">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>সৌদিগামী ১৮৬ ফ্লাইট বাতিল, ক্ষতিগ্রস্ত ২৩১৬১ যাত্রী</title>
      <link>https://www.banglatribune.com/others/979672/%E0%A6%B8%E0%A7%8C%E0%A6%A6%E0%A6%BF%E0%A6%97%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A7%A7%E0%A7%AE%E0%A7%AC-%E0%A6%AB%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%9F-%E0%A6%AC%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%B2-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A4%E0%A6%BF%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%A4-%E0%A7%A8%E0%A7%A9%E0%A7%A7%E0%A7%AC%E0%A7%A7</link>
      <guid isPermaLink="true">https://www.banglatribune.com/others/979672/%E0%A6%B8%E0%A7%8C%E0%A6%A6%E0%A6%BF%E0%A6%97%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A7%A7%E0%A7%AE%E0%A7%AC-%E0%A6%AB%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%9F-%E0%A6%AC%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%B2-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A4%E0%A6%BF%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%A4-%E0%A7%A8%E0%A7%A9%E0%A7%A7%E0%A7%AC%E0%A7%A7</guid>
      <pubDate>Sun, 08 Nov 2026 20:36:07 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/10/11/da1946fe640fad73cc51839ef8cf0b6d-6acb31cc18d11.jpg?jadewits_media_id=1048705" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/10/11/da1946fe640fad73cc51839ef8cf0b6d-6acb31cc18d11.jpg?jadewits_media_id=1048705" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/10/11/da1946fe640fad73cc51839ef8cf0b6d-6acb31cc18d11.jpg?jadewits_media_id=1048705" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সৌদিগামী ১৮৬ ফ্লাইট বাতিল, ক্ষতিগ্রস্ত ২৩১৬১ যাত্রী" /&gt;&lt;/p&gt;&lt;p&gt;নিরাপত্তা পরিস্থিতির কারণে গত ১০ অক্টোবর থেকে এ পর্যন্ত ঢাকা থেকে সৌদি আরবের রিয়াদগামী ১৮৬টি ফ্লাইট বাতিল হয়েছে। এতে ক্ষতিগ্রস্ত হয়েছেন ২৩ হাজার ১৬১ যাত্রী।
বেবিচকের জনসংযোগ বিভাগের সহকারী পরিচালক কাওছার মাহমুদ রবিবার (৮ নভেম্বর) এ তথ্য জানান।
তিনি বলেন, বাতিল হওয়া ফ্লাইটের মধ্যে সরাসরি ফ্লাইট ১০৯টি&lt;/p&gt;</description>

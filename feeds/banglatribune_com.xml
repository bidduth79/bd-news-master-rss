      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/17bb3a9fb74af1867c1bea8a2a5279b1-6af8c5c6ae1bd.jpg?jadewits_media_id=1055029" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/17bb3a9fb74af1867c1bea8a2a5279b1-6af8c5c6ae1bd.jpg?jadewits_media_id=1055029" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভুটানকে ৪ গোলে উড়িয়ে বাংলাদেশের দাপুটে জয়" /&gt;&lt;/p&gt;&lt;p&gt;এএফসি অনূর্ধ্ব-১৭ এশিয়ান কাপের বাছাইপর্বে দ্বিতীয় ম্যাচে দুর্দান্ত জয় পেয়েছে বাংলাদেশ। ভুটানকে ৪-০ গোলে উড়িয়ে দিয়েছে লোডভিক ডি ক্রুইফের দল। ম্যাচের প্রথমার্ধেই তিন গোল করে জয় অনেকটা নিশ্চিত করে বাংলাদেশ। দ্বিতীয়ার্ধে আসে আরও একটি গোল।
শনিবার (১৪ নভেম্বর) সংযুক্ত আরব আমিরাতের সৌদ বিন সাকর আল কাসিমি স&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/football/980961/%E0%A6%AD%E0%A7%81%E0%A6%9F%E0%A6%BE%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A7%AA-%E0%A6%97%E0%A7%8B%E0%A6%B2%E0%A7%87-%E0%A6%89%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AA%E0%A7%81%E0%A6%9F%E0%A7%87-%E0%A6%9C%E0%A7%9F">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>গোপালগঞ্জে বিএনপির দুটি কার্যালয়ে ভাঙচুর, অগ্নিসংযোগ</title>
      <link>https://www.banglatribune.com/country/dhaka/980960/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%9F%E0%A6%BF-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87-%E0%A6%AD%E0%A6%BE%E0%A6%99%E0%A6%9A%E0%A7%81%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/dhaka/980960/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%9F%E0%A6%BF-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87-%E0%A6%AD%E0%A6%BE%E0%A6%99%E0%A6%9A%E0%A7%81%E0%A6%B0</guid>

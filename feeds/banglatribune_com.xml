      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/19f852f3a03d799c746dd6ce5c725f13-6af1bfd97862e.jpg?jadewits_media_id=1054061" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/19f852f3a03d799c746dd6ce5c725f13-6af1bfd97862e.jpg?jadewits_media_id=1054061" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/19f852f3a03d799c746dd6ce5c725f13-6af1bfd97862e.jpg?jadewits_media_id=1054061" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সুনামগঞ্জে যানবাহন থেকে চাঁদাবাজির অভিযোগ, ব্যবস্থা নেওয়ার আশ্বাস মন্ত্রীর" /&gt;&lt;/p&gt;&lt;p&gt;সুনামগঞ্জের বিভিন্ন স্থানে বালু, চুনাপাথর ও কয়লাবাহী যানবাহন থেকে চাঁদা আদায়ের উৎসব চলছে বলে জাতীয় সংসদে অভিযোগ করেছেন সুনামগঞ্জ-১ আসনের সংসদ সদস্য কামরুজ্জামান কামরুল। তিনি বলেছেন, এক কিলোমিটারেরও কম দূরত্বের মধ্যে একাধিক স্থানে ব্যবসায়ীদের কাছ থেকে চাঁদা আদায় করা হচ্ছে। বিগত আওয়ামী লীগ সরকারের আমল&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/981542/%E0%A6%B8%E0%A7%81%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%A8-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BF%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%87%E0%A6%BE%E0%A6%97">বাংলা ট্রিবিউন</source>

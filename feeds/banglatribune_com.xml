      <title>রোনালদোকে বিদায় জানানোর রাতে পর্তুগালের জালে ডেনমার্কের গোল উৎসব</title>
      <link>https://www.banglatribune.com/sport/football/980970/%E0%A6%B0%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A6%A6%E0%A7%8B%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A6%BE%E0%A7%9F-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%A8%E0%A7%8B%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A7%81%E0%A6%97%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%BE%E0%A6%B2%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/football/980970/%E0%A6%B0%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A6%A6%E0%A7%8B%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A6%BE%E0%A7%9F-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%A8%E0%A7%8B%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A7%81%E0%A6%97%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%BE%E0%A6%B2%E0%A7%87</guid>
      <pubDate>Sun, 15 Nov 2026 06:59:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/d02995f3ddbf814e5472d59061bc7b29-6af901b967caa.jpg?jadewits_media_id=1055038" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/d02995f3ddbf814e5472d59061bc7b29-6af901b967caa.jpg?jadewits_media_id=1055038" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/d02995f3ddbf814e5472d59061bc7b29-6af901b967caa.jpg?jadewits_media_id=1055038" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রোনালদোকে বিদায় জানানোর রাতে পর্তুগালের জালে ডেনমার্কের গোল উৎসব" /&gt;&lt;/p&gt;&lt;p&gt;ক্রিশ্চিয়ানো রোনালদোর আন্তর্জাতিক ফুটবল থেকে অবসরের পর প্রথম ম্যাচেই ঘরের মাঠে বড় ব্যবধানে হেরেছে পর্তুগাল। শনিবার রাতে উয়েফা নেশনস লিগের ম্যাচে রোনালদোকে বিদায়ী সংবর্ধনা দেওয়ার দিনে ডেনমার্কের কাছে ৪-১ গোলে বিধ্বস্ত হয়েছে স্বাগতিকরা।
ম্যাচের শুরুটা ছিল পুরোপুরি রোনালদোময়। গত সপ্তাহে সামাজিক যোগাযোগ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/football/980970/%E0%A6%B0%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A6%A6%E0%A7%8B%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A6%BE%E0%A7%9F-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%A8%E0%A7%8B%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A7%81%E0%A6%97%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%BE%E0%A6%B2%E0%A7%87">বাংলা ট্রিবিউন</source>

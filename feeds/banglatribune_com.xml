    <item>
      <title>জাফরানের গুণে ভালো থাকতে পারে মন ও চোখ</title>
      <link>https://www.banglatribune.com/lifestyle/980473/%E0%A6%9C%E0%A6%BE%E0%A6%AB%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A7%81%E0%A6%A3%E0%A7%87-%E0%A6%AD%E0%A6%BE%E0%A6%B2%E0%A7%8B-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A6%A8-%E0%A6%93-%E0%A6%9A%E0%A7%8B%E0%A6%96</link>
      <guid isPermaLink="true">https://www.banglatribune.com/lifestyle/980473/%E0%A6%9C%E0%A6%BE%E0%A6%AB%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A7%81%E0%A6%A3%E0%A7%87-%E0%A6%AD%E0%A6%BE%E0%A6%B2%E0%A7%8B-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A6%A8-%E0%A6%93-%E0%A6%9A%E0%A7%8B%E0%A6%96</guid>
      <pubDate>Thu, 12 Nov 2026 15:22:08 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/2cb49857eb70c8115586b7ff2ced52fc-6af584fa45c82.jpg?jadewits_media_id=1054613" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/2cb49857eb70c8115586b7ff2ced52fc-6af584fa45c82.jpg?jadewits_media_id=1054613" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/2cb49857eb70c8115586b7ff2ced52fc-6af584fa45c82.jpg?jadewits_media_id=1054613" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জাফরানের গুণে ভালো থাকতে পারে মন ও চোখ" /&gt;&lt;/p&gt;&lt;p&gt;রান্নায় স্বাদ, ঘ্রাণ ও রং বাড়াতে জাফরানের ব্যবহার বেশ পরিচিত। তবে শুধু খাবারের স্বাদ বাড়ানোই নয়, মানসিক ও চোখের স্বাস্থ্যের জন্যও উপকারী হতে পারে দামি এই মসলা। ক্রোকাস স্যাটিভাস নামের ফুল থেকে সংগ্রহ করা হয় জাফরান।
বিভিন্ন গবেষণায় দেখা গেছে, জাফরান বিষণ্নতা ও উদ্বেগের উপসর্গ কমাতে এবং বয়সজনিত চোখের &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/lifestyle/980473/%E0%A6%9C%E0%A6%BE%E0%A6%AB%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A7%81%E0%A6%A3%E0%A7%87-%E0%A6%AD%E0%A6%BE%E0%A6%B2%E0%A7%8B-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A6%A8-%E0%A6%93-%E0%A6%9A%E0%A7%8B%E0%A6%96">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>মালয়েশিয়া যেতে অভিবাসন ব্যয় কত, জানালেন প্রবাসীকল্যাণ মন্ত্রী</title>
      <link>https://www.banglatribune.com/national/980472/%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE-%E0%A6%AF%E0%A7%87%E0%A6%A4%E0%A7%87-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%A8-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A7%9F-%E0%A6%95%E0%A6%A4-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/national/980472/%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE-%E0%A6%AF%E0%A7%87%E0%A6%A4%E0%A7%87-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%A8-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A7%9F-%E0%A6%95%E0%A6%A4-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Thu, 12 Nov 2026 15:11:36 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/d687bf0ace3090c2b045061931a160de-6af5828ee1ae3.jpg?jadewits_media_id=1054612" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/d687bf0ace3090c2b045061931a160de-6af5828ee1ae3.jpg?jadewits_media_id=1054612" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/d687bf0ace3090c2b045061931a160de-6af5828ee1ae3.jpg?jadewits_media_id=1054612" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মালয়েশিয়া যেতে অভিবাসন ব্যয় কত, জানালেন প্রবাসীকল্যাণ মন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;চলতি বছরে মালয়েশিয়া যেতে কর্মীদের অভিবাসন ব্যয় ১ লাখ ৫৪ হাজার টাকা নির্ধারণ করা হয়েছে বলে জানিয়েছেন প্রবাসীকল্যাণ মন্ত্রী আরিফুল হক চৌধুরী। বৃহস্পতিবার (১২ নভেম্বর) সকালে রাজধানীর প্রবাসী কল্যাণ ভবনে সাংবাদিকদের এ কথা জানান তিনি।
মন্ত্রী জানান, এ জন্য আগামী সপ্তাহের মধ্যেই মেডিক্যাল সেন্টারের চূড়ান্&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/980472/%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE-%E0%A6%AF%E0%A7%87%E0%A6%A4%E0%A7%87-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%A8-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A7%9F-%E0%A6%95%E0%A6%A4-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A8">বাংলা ট্রিবিউন</source>
    </item>

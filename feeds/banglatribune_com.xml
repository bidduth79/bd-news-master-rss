    <item>
      <title>খুলনায় অস্ত্রসহ সন্ত্রাসী গ্রেফতার, এলাকাবাসীর হাতে মারধরের শিকার</title>
      <link>https://www.banglatribune.com/country/khulna/982639/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%85%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A6%B9-%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A7%80-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%8F%E0%A6%B2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%80%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/khulna/982639/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%85%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A6%B9-%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A7%80-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%8F%E0%A6%B2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%80%E0%A6%B0</guid>
      <pubDate>Mon, 23 Nov 2026 04:35:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/5599895fae02e8ce2198a244782abf8c-6b035b9a4ff7a.jpg?jadewits_media_id=1056441" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/5599895fae02e8ce2198a244782abf8c-6b035b9a4ff7a.jpg?jadewits_media_id=1056441" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/5599895fae02e8ce2198a244782abf8c-6b035b9a4ff7a.jpg?jadewits_media_id=1056441" style="max-width:100%;height:auto;margin-bottom:10px;" alt="খুলনায় অস্ত্রসহ সন্ত্রাসী গ্রেফতার, এলাকাবাসীর হাতে মারধরের শিকার" /&gt;&lt;/p&gt;&lt;p&gt;কামরান শেখ নামে এক সন্ত্রাসীকে গ্রেফতার করেছে মহানগর পুলিশ। রবিবার (২২ নভেম্বর) বিকালে টুটপাড়া ফরিদ মোল্লার মোড় থেকে তাকে গ্রেফতার করা হয়। তিনি ওই এলাকার কামাল শেখের ছেলে। এ সময় তার কাছ থেকে আগ্নেয়াস্ত্র ও ধারলো অস্ত্র উদ্ধার করা হয়।
খুলনা সদর থানার ওসি লোকমান হোসেন বলেন, মহানগরীর শীর্ষ একটি সন্ত্রা&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/khulna/982639/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%85%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A6%B9-%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A7%80-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%8F%E0%A6%B2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%80%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>
    <item>

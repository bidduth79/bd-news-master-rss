      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/4d25aa6229c044b9149eaea6b43673b2-6afdd9cd2fee5.jpg?jadewits_media_id=1055770" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/4d25aa6229c044b9149eaea6b43673b2-6afdd9cd2fee5.jpg?jadewits_media_id=1055770" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/4d25aa6229c044b9149eaea6b43673b2-6afdd9cd2fee5.jpg?jadewits_media_id=1055770" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘জর্দা শামীমের’ অস্ত্রভাণ্ডারের সন্ধান, ৩ সহযোগী গ্রেফতার" /&gt;&lt;/p&gt;&lt;p&gt;আলোচিত ব্যবসায়ী মোহাম্মদ শামীম আহমেদ ওরফে &amp;lsquo;জর্দা শামীমের&amp;rsquo; অস্ত্রভাণ্ডারের সন্ধানের কথা জানিয়েছে স্পেশাল রেসপন্স ব্যাটালিয়ন (এসআরবি)। সেখান থেকে চারটি বিদেশি পিস্তল, তিনটি রিভলভার ও একটি এয়ারগানসহ আটটি অস্ত্র, ২ হাজার ৭৬১ রাউন্ড গুলি এবং অস্ত্রের বিপুল সরঞ্জাম উদ্ধার করা হয়েছে। এ ঘটনায় শা&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/981842/%E2%80%98%E0%A6%9C%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A6%BE-%E0%A6%B6%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%AE%E0%A7%87%E0%A6%B0%E2%80%99-%E0%A6%85%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%AD%E0%A6%BE%E0%A6%A3%E0%A7%8D%E0%A6%A1%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%A8-%E0%A7%A9-%E0%A6%B8%E0%A6%B9%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%80">বাংলা ট্রিবিউন</source>

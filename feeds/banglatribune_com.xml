      <guid isPermaLink="true">https://www.banglatribune.com/my-campus/982434/%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8B%E0%A6%B2%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%87-%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%AE%E0%A7%81%E0%A6%9C%E0%A6%BF%E0%A6%AC-%E0%A6%B9%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%95%E0%A7%87%E0%A6%9F-%E0%A6%97%E0%A7%87%E0%A6%9F-%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A7%87-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%8B</guid>
      <pubDate>Sun, 22 Nov 2026 00:08:45 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/6a31e28a2afbace2fc7d3ceceed2c898-6b01de0f9a4d7.jpg?jadewits_media_id=1056270" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/6a31e28a2afbace2fc7d3ceceed2c898-6b01de0f9a4d7.jpg?jadewits_media_id=1056270" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/6a31e28a2afbace2fc7d3ceceed2c898-6b01de0f9a4d7.jpg?jadewits_media_id=1056270" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আন্দোলনের মুখে শেখ মুজিব হলের পকেট গেট খুলে দিলো প্রশাসন" /&gt;&lt;/p&gt;&lt;p&gt;শিক্ষার্থীদের আন্দোলনের মুখে ঢাকা বিশ্ববিদ্যালয়ের (ঢাবি) শেখ মুজিবুর রহমান হল সংলগ্ন পকেট গেটের তালা খুলে দিয়েছে বিশ্ববিদ্যালয় প্রশাসন। শনিবার (২১ নভেম্বর) রাত ১০টা ২০মিনিটে গেটটি খুলে দেওয়া হয়। এর আগে রাত ৯টা ৫০ মিনিটের দিকে গেটটি খুলে দেওয়ার দাবিতে বিক্ষোভ শুরু করেন শিক্ষার্থীরা।
জানা গেছে, রাত ৯ট&lt;/p&gt;</description>

    <item>
      <title>কার্যক্রম নিষিদ্ধ আওয়ামী লীগের ‘গোপন বৈঠক’, সারদা হলে তালা দিলো জাসাস</title>
      <link>https://www.banglatribune.com/country/sylhet/981392/%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E2%80%98%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%A8-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95%E2%80%99-%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A6%A6%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/sylhet/981392/%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E2%80%98%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%A8-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95%E2%80%99-%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A6%A6%E0%A6%BE</guid>
      <pubDate>Mon, 16 Nov 2026 22:49:26 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/219ea5e96c731cceba7a122221041d31-6afb33f717585.jpg?jadewits_media_id=1055373" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/219ea5e96c731cceba7a122221041d31-6afb33f717585.jpg?jadewits_media_id=1055373" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/219ea5e96c731cceba7a122221041d31-6afb33f717585.jpg?jadewits_media_id=1055373" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কার্যক্রম নিষিদ্ধ আওয়ামী লীগের ‘গোপন বৈঠক’, সারদা হলে তালা দিলো জাসাস" /&gt;&lt;/p&gt;&lt;p&gt;সিলেটের সারদা স্মৃতি হলে কার্যক্রম নিষিদ্ধ আওয়ামী লীগের গোপন বৈঠকের অভিযোগ উঠেছে। এ ঘটনায় সারদা হলে তালা ঝুলিয়ে দিয়েছেন জাতীয়তাবাদী সামাজিক সাংস্কৃতিক সংস্থার (জাসাস) নেতারা।
এ সময় হলের ভেতরে দেয়ালে থাকা বঙ্গবন্ধু শেখ মুজিবুর রহমানের ছবিসহ সম্মিলিত সাংস্কৃতিক জোটের নানা কার্যক্রমের ছবি নামিয়ে ফেলেন &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/sylhet/981392/%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E2%80%98%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%A8-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95%E2%80%99-%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A6%A6%E0%A6%BE">বাংলা ট্রিবিউন</source>
    </item>

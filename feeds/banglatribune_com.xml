      <guid isPermaLink="true">https://www.banglatribune.com/foreign/asia/981866/%E0%A6%9A%E0%A7%80%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B6%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%A4%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E2%80%98%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%AE%E0%A6%BE%E0%A6%A3%E0%A6%AC%E0%A6%BF%E0%A6%95-%E0%A6%AC%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%AB%E0%A6%95%E0%A7%87%E0%A6%B8%E2%80%99-%E0%A6%AD%E0%A7%87%E0%A6%A4%E0%A6%B0%E0%A7%87</guid>
      <pubDate>Thu, 19 Nov 2026 08:36:37 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/44f420860f2361c9a2492f4d35f2d578-6afe6062db7d5.jpg?jadewits_media_id=1055793" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/44f420860f2361c9a2492f4d35f2d578-6afe6062db7d5.jpg?jadewits_media_id=1055793" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/44f420860f2361c9a2492f4d35f2d578-6afe6062db7d5.jpg?jadewits_media_id=1055793" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চীনে প্রকাশ্যে পুতিনের ‘পারমাণবিক ব্রিফকেস’, ভেতরে কী আছে?" /&gt;&lt;/p&gt;&lt;p&gt;রাশিয়ার প্রেসিডেন্ট ভ্লাদিমির পুতিনের সঙ্গে থাকা পারমাণবিক হামলার নির্দেশ দেওয়ার কাজে ব্যবহৃত বিশেষ ব্রিফকেসের দেখা মিলেছে চীনে। দেশটির শেনজেনে এশিয়া-প্যাসিফিক অর্থনৈতিক সহযোগিতা (এপেক) সম্মেলনের ভেন্যুর বাইরে বুধবার এক রুশ নৌবাহিনীর কর্মকর্তার হাতে এটি দেখা যায়।
রাশিয়ার রাষ্ট্রীয় টেলিভিশন চ্যানেল র&lt;/p&gt;</description>

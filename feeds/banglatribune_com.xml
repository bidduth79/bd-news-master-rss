      <guid isPermaLink="true">https://www.banglatribune.com/country/khulna/980643/%E2%80%98%E0%A6%A8%E0%A7%81%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%BF%E0%A6%AE-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80%E0%A6%B0%E2%80%99-%E0%A6%B6%E0%A7%80%E0%A6%B0%E0%A7%8D%E0%A6%B7-%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A7%80-%E0%A6%B0%E0%A6%95%E0%A6%BF-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Fri, 13 Nov 2026 10:46:26 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/cc49588b5b11f2a89dade9baea0cfd8a-6af6960baadcb.jpg?jadewits_media_id=1054752" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/cc49588b5b11f2a89dade9baea0cfd8a-6af6960baadcb.jpg?jadewits_media_id=1054752" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/cc49588b5b11f2a89dade9baea0cfd8a-6af6960baadcb.jpg?jadewits_media_id=1054752" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘নুরাজিম বাহিনীর’ শীর্ষ সন্ত্রাসী রকি গ্রেফতার" /&gt;&lt;/p&gt;&lt;p&gt;খুলনার আলোচিত সন্ত্রাসী নুরাজিমের সহোদর ও তার বাহিনীর শীর্ষ সদস্য শাহরিয়ার ইসলাম রকিকে গ্রেফতার করেছে স্পেশাল রেসপন্স ব্যাটালিয়ন (এসআরবি)।
বৃহস্পতিবার বিকাল সাড়ে ৩টার দিকে মাদারীপুর জেলার শিবচর থানাধীন ডিসি রোড এলাকায় গোপন সংবাদের ভিত্তিতে বিশেষ অভিযান চালিয়ে তাকে গ্রেফতার করে এসআরবি-৬ ও এসআরবি-৮-এ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/khulna/980643/%E2%80%98%E0%A6%A8%E0%A7%81%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%BF%E0%A6%AE-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80%E0%A6%B0%E2%80%99-%E0%A6%B6%E0%A7%80%E0%A6%B0%E0%A7%8D%E0%A6%B7-%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A7%80-%E0%A6%B0%E0%A6%95%E0%A6%BF-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>আ.লীগের মিছিল নিয়ে শ্রমিকদল নেতার মামলা, আসামি ছাত্রদল নেতা</title>
      <link>https://www.banglatribune.com/country/mymensing/980642/%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%A8%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95%E0%A6%A6%E0%A6%B2-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%86%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/mymensing/980642/%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%A8%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95%E0%A6%A6%E0%A6%B2-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%86%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%BF</guid>
      <pubDate>Fri, 13 Nov 2026 10:31:32 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/914dc745eccce295a2deb63b8e29d3ae-6af692a13fc85.jpg?jadewits_media_id=1054751" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/914dc745eccce295a2deb63b8e29d3ae-6af692a13fc85.jpg?jadewits_media_id=1054751" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/914dc745eccce295a2deb63b8e29d3ae-6af692a13fc85.jpg?jadewits_media_id=1054751" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আ.লীগের মিছিল নিয়ে শ্রমিকদল নেতার মামলা, আসামি ছাত্রদল নেতা" /&gt;&lt;/p&gt;&lt;p&gt;জামালপুরে নিষিদ্ধ ঘোষিত আওয়ামী লীগের ঝটিকা মিছিলের ঘটনায় সন্ত্রাসবিরোধী আইনে মামলা করেছেন জেলা শ্রমিক দলের এক নেতা। তবে ওই মামলায় আসামি করা হয়েছে ছাত্রদলের এক নেতাকেও। এ নিয়ে স্থানীয় রাজনৈতিক অঙ্গনে আলোচনা-সমালোচনা তৈরি হয়েছে।
সোমবার (৯ নভেম্বর) রাত ২টার দিকে জামালপুর থানায় মামলাটি করেন জেলা শ্রমিক &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/mymensing/980642/%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%A8%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95%E0%A6%A6%E0%A6%B2-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%86%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%BF">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>টানা তিন দিনে তিন দফা কমলো স্বর্ণের দাম</title>
      <link>https://www.banglatribune.com/business/980641/%E0%A6%9F%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%A6%E0%A6%AB%E0%A6%BE-%E0%A6%95%E0%A6%AE%E0%A6%B2%E0%A7%8B-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/business/980641/%E0%A6%9F%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%A6%E0%A6%AB%E0%A6%BE-%E0%A6%95%E0%A6%AE%E0%A6%B2%E0%A7%8B-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE</guid>
      <pubDate>Fri, 13 Nov 2026 10:23:52 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2024/05/02/istockphoto-1277517088-612x612-b7caac771870c853bcbafd43856e1f11.jpg?jadewits_media_id=914718" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2024/05/02/istockphoto-1277517088-612x612-b7caac771870c853bcbafd43856e1f11.jpg?jadewits_media_id=914718" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2024/05/02/istockphoto-1277517088-612x612-b7caac771870c853bcbafd43856e1f11.jpg?jadewits_media_id=914718" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টানা তিন দিনে তিন দফা কমলো স্বর্ণের দাম" /&gt;&lt;/p&gt;&lt;p&gt;দেশের বাজারে টানা তৃতীয় দিনের মতো কমেছে স্বর্ণের দাম। এবার ২২ ক্যারেটের প্রতি ভরি স্বর্ণের দাম আরও ২ হাজার ১৫৮ টাকা কমিয়েছে বাংলাদেশ জুয়েলার্স অ্যাসোসিয়েশন (বাজুস)। শুক্রবার (১৩ নভেম্বর) সকাল ১০টা থেকে নতুন এ দাম কার্যকর হয়েছে।
তেজাবি স্বর্ণের (পিওর গোল্ড) দাম কমে যাওয়ায় স্থানীয় বাজারে স্বর্ণের দাম &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/business/980641/%E0%A6%9F%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%A6%E0%A6%AB%E0%A6%BE-%E0%A6%95%E0%A6%AE%E0%A6%B2%E0%A7%8B-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>বিশ্ববাজারে ফের কমলো জ্বালানি তেলের দাম</title>
      <link>https://www.banglatribune.com/foreign/middle-east/980640/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%AE%E0%A6%B2%E0%A7%8B-%E0%A6%9C%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%A4%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/middle-east/980640/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%AE%E0%A6%B2%E0%A7%8B-%E0%A6%9C%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%A4%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE</guid>
      <pubDate>Fri, 13 Nov 2026 10:18:16 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/e58cfbc5397e391bbfe3bc2320affa78-6af68f3fec2d4.jpg?jadewits_media_id=1054750" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/e58cfbc5397e391bbfe3bc2320affa78-6af68f3fec2d4.jpg?jadewits_media_id=1054750" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/e58cfbc5397e391bbfe3bc2320affa78-6af68f3fec2d4.jpg?jadewits_media_id=1054750" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিশ্ববাজারে ফের কমলো জ্বালানি তেলের দাম" /&gt;&lt;/p&gt;&lt;p&gt;ইরানের ওপর অবরোধ বহাল রাখার পরিকল্পনা যুক্তরাষ্ট্রের। এতে মধ্যপ্রাচ্যের সরবরাহে বিঘ্ন ঘটাতে পারে এমন নতুন বড় আকারের লড়াইয়ের আশঙ্কা কমেছে। তবে জাহাজে হামলার ঝুঁকি থেকেই যাচ্ছে। শুক্রবার (১৩ নভেম্বর) তেলের দাম মিশ্র প্রবণতায় থাকলেও টানা দ্বিতীয় সাপ্তাহিক পতনের পথে রয়েছে। ব্রিটিশ বার্তা সংস্থা রয়&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/middle-east/980640/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%AE%E0%A6%B2%E0%A7%8B-%E0%A6%9C%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%A4%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>শীতে বেড়ানোর আদর্শ ঠিকানা, ব্রিটেনের ১০ মনোরম জায়গা</title>
      <link>https://www.banglatribune.com/journey/980442/%E0%A6%B6%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A7%87%E0%A6%A1%E0%A6%BC%E0%A6%BE%E0%A6%A8%E0%A7%8B%E0%A6%B0-%E0%A6%86%E0%A6%A6%E0%A6%B0%E0%A7%8D%E0%A6%B6-%E0%A6%A0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%AC%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%9F%E0%A7%87%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A7%A7%E0%A7%A6-%E0%A6%AE%E0%A6%A8%E0%A7%8B%E0%A6%B0%E0%A6%AE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/journey/980442/%E0%A6%B6%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A7%87%E0%A6%A1%E0%A6%BC%E0%A6%BE%E0%A6%A8%E0%A7%8B%E0%A6%B0-%E0%A6%86%E0%A6%A6%E0%A6%B0%E0%A7%8D%E0%A6%B6-%E0%A6%A0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%AC%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%9F%E0%A7%87%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A7%A7%E0%A7%A6-%E0%A6%AE%E0%A6%A8%E0%A7%8B%E0%A6%B0%E0%A6%AE</guid>
      <pubDate>Fri, 13 Nov 2026 10:10:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/b6d7bbce1673582804a714ecef6686ce-6af5612091584.jpg?jadewits_media_id=1054581" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/b6d7bbce1673582804a714ecef6686ce-6af5612091584.jpg?jadewits_media_id=1054581" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/b6d7bbce1673582804a714ecef6686ce-6af5612091584.jpg?jadewits_media_id=1054581" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শীতে বেড়ানোর আদর্শ ঠিকানা, ব্রিটেনের ১০ মনোরম জায়গা" /&gt;&lt;/p&gt;&lt;p&gt;শীত মানেই শুধু ঘরের কোণে বসে থাকা নয়। বরং এই সময় প্রকৃতির অন্য রূপ দেখতে বেরিয়ে পড়তে পারেন। কোথাও হাজার হাজার পাখির আকাশজুড়ে ওড়ার দৃশ্য, কোথাও সমুদ্রের উত্তাল ঢেউ, আবার কোথাও বরফে ঢাকা পাহাড়ে স্কি করার সুযোগ। শীতের ছুটিতে এমনই কিছু অন্য রকম অভিজ্ঞতার সন্ধান দিয়েছে ব্রিটেনের সংবাদপত্র &amp;lsquo;দ্য &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/journey/980442/%E0%A6%B6%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A7%87%E0%A6%A1%E0%A6%BC%E0%A6%BE%E0%A6%A8%E0%A7%8B%E0%A6%B0-%E0%A6%86%E0%A6%A6%E0%A6%B0%E0%A7%8D%E0%A6%B6-%E0%A6%A0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%AC%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%9F%E0%A7%87%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A7%A7%E0%A7%A6-%E0%A6%AE%E0%A6%A8%E0%A7%8B%E0%A6%B0%E0%A6%AE">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>গত দুই বছরকে ছাড়িয়ে গেছে ডেঙ্গু</title>
      <link>https://www.banglatribune.com/country/chitagong/980609/%E0%A6%97%E0%A6%A4-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A6%95%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%A1%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%81-%E0%A6%93%E0%A6%B7%E0%A7%81%E0%A6%A7-%E0%A6%9B%E0%A6%BF%E0%A6%9F%E0%A6%BE%E0%A6%87%E0%A6%A4%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/chitagong/980609/%E0%A6%97%E0%A6%A4-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A6%95%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%A1%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%81-%E0%A6%93%E0%A6%B7%E0%A7%81%E0%A6%A7-%E0%A6%9B%E0%A6%BF%E0%A6%9F%E0%A6%BE%E0%A6%87%E0%A6%A4%E0%A7%87</guid>
      <pubDate>Fri, 13 Nov 2026 10:14:36 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/7145586acc06229014580bd1082c3327-6af602c4aeb94.jpg?jadewits_media_id=1054724" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/7145586acc06229014580bd1082c3327-6af602c4aeb94.jpg?jadewits_media_id=1054724" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/7145586acc06229014580bd1082c3327-6af602c4aeb94.jpg?jadewits_media_id=1054724" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গত দুই বছরকে ছাড়িয়ে গেছে ডেঙ্গু" /&gt;&lt;/p&gt;&lt;p&gt;মাত্র দুই দিনের ব্যবধান। প্রথমে ডেঙ্গু ও হামে আক্রান্ত হয়ে মারা যায় ১০ বছর বয়সী বড় ছেলে। সেই শোক কাটিয়ে ওঠার আগেই একই রোগে প্রাণ হারায় ১০ মাস বয়সী ছোট সন্তান। দুই সন্তানকে হারিয়ে এখন শূন্য ঘর মোহাম্মদ কবির ও আমেনা বেগম দম্পতির। চট্টগ্রাম নগরের পাঁচলাইশ থানার হিলভিউ আবাসিক এলাকার এই পরিবারে নেমে এসেছ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/chitagong/980609/%E0%A6%97%E0%A6%A4-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A6%95%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%A1%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%81-%E0%A6%93%E0%A6%B7%E0%A7%81%E0%A6%A7-%E0%A6%9B%E0%A6%BF%E0%A6%9F%E0%A6%BE%E0%A6%87%E0%A6%A4%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>‘ডে ওয়ানস’ দিয়ে বিনোদন জগতে নতুন ইনিংস রোনালদোর</title>
      <link>https://www.banglatribune.com/sport/football/980571/%E2%80%98%E0%A6%A1%E0%A7%87-%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%B8%E2%80%99-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%A8%E0%A7%8B%E0%A6%A6%E0%A6%A8-%E0%A6%9C%E0%A6%97%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%87%E0%A6%A8%E0%A6%BF%E0%A6%82%E0%A6%B8-%E0%A6%B0%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A6%A6%E0%A7%8B%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/football/980571/%E2%80%98%E0%A6%A1%E0%A7%87-%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%B8%E2%80%99-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%A8%E0%A7%8B%E0%A6%A6%E0%A6%A8-%E0%A6%9C%E0%A6%97%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%87%E0%A6%A8%E0%A6%BF%E0%A6%82%E0%A6%B8-%E0%A6%B0%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A6%A6%E0%A7%8B%E0%A6%B0</guid>
      <pubDate>Fri, 13 Nov 2026 10:00:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2023/01/03/-7fc12721a2077f068cf930cfd421e314.jpg?jadewits_media_id=833155" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2023/01/03/-7fc12721a2077f068cf930cfd421e314.jpg?jadewits_media_id=833155" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2023/01/03/-7fc12721a2077f068cf930cfd421e314.jpg?jadewits_media_id=833155" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘ডে ওয়ানস’ দিয়ে বিনোদন জগতে নতুন ইনিংস রোনালদোর" /&gt;&lt;/p&gt;&lt;p&gt;ফুটবল মাঠের বাইরেও নিজের সাম্রাজ্য বিস্তারে ব্যস্ত ক্রিস্টিয়ানো রোনালদো। এবার টেলিভিশন সিরিজ প্রযোজনায় নাম লেখাচ্ছেন পর্তুগিজ এই মহাতারকা। তার প্রথম টিভি সিরিজ &amp;lsquo;ডে ওয়ানস&amp;rsquo;-এর নির্মাণকাজ শুরু হয়েছে। পর্তুগালের হয়ে আন্তর্জাতিক ফুটবল থেকে অবসরের কয়েক দিন পরই নতুন এই উদ্যোগের কথা জানালেন ৪১ ব&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/football/980571/%E2%80%98%E0%A6%A1%E0%A7%87-%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%B8%E2%80%99-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%A8%E0%A7%8B%E0%A6%A6%E0%A6%A8-%E0%A6%9C%E0%A6%97%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%87%E0%A6%A8%E0%A6%BF%E0%A6%82%E0%A6%B8-%E0%A6%B0%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A6%A6%E0%A7%8B%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>জামালপুরে নানা আয়োজনে হুমায়ূন উৎসব পালিত</title>
      <link>https://www.banglatribune.com/country/mymensing/980639/%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%86%E0%A7%9F%E0%A7%8B%E0%A6%9C%E0%A6%A8%E0%A7%87-%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A7%82%E0%A6%A8-%E0%A6%89%E0%A7%8E%E0%A6%B8%E0%A6%AC-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%A4</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/mymensing/980639/%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%86%E0%A7%9F%E0%A7%8B%E0%A6%9C%E0%A6%A8%E0%A7%87-%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A7%82%E0%A6%A8-%E0%A6%89%E0%A7%8E%E0%A6%B8%E0%A6%AC-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%A4</guid>
      <pubDate>Fri, 13 Nov 2026 09:59:21 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/378e64efc3b032b94ee0e947c052e9b7-6af68ae591292.jpg?jadewits_media_id=1054749" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/378e64efc3b032b94ee0e947c052e9b7-6af68ae591292.jpg?jadewits_media_id=1054749" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/378e64efc3b032b94ee0e947c052e9b7-6af68ae591292.jpg?jadewits_media_id=1054749" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জামালপুরে নানা আয়োজনে হুমায়ূন উৎসব পালিত" /&gt;&lt;/p&gt;&lt;p&gt;কথাসাহিত্যিক হুমায়ূন আহমেদের ৭৮তম জন্মদিন উপলক্ষে জামালপুরে পাঠচক্র ও হুমায়ূন উৎসব অনুষ্ঠিত হয়েছে। এ উপলক্ষে আলোচনা সভা, কেক কাটা, কুইজ প্রতিযোগিতা ও সাংস্কৃতিক অনুষ্ঠানের আয়োজন করে সরকারি আশেক মাহমুদ কলেজ রিডার্স ক্লাব।
বৃহস্পতিবার (১২ নভেম্বর) বিকালে সরকারি আশেক মাহমুদ কলেজের গ্রন্থকাননে এসব আয়োজন&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/mymensing/980639/%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%86%E0%A7%9F%E0%A7%8B%E0%A6%9C%E0%A6%A8%E0%A7%87-%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A7%82%E0%A6%A8-%E0%A6%89%E0%A7%8E%E0%A6%B8%E0%A6%AC-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%A4">বাংলা ট্রিবিউন</source>
    </item>

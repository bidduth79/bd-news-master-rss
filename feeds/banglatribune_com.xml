    <item>
      <title>ঘটছে ককটেল বিস্ফোরণ ও বাসে আগুন, জনমনে আতঙ্ক</title>
      <link>https://www.banglatribune.com/others/capital-city/979927/%E0%A6%98%E0%A6%9F%E0%A6%9B%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%93-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%9C%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%A4%E0%A6%99%E0%A7%8D%E0%A6%95</link>
      <guid isPermaLink="true">https://www.banglatribune.com/others/capital-city/979927/%E0%A6%98%E0%A6%9F%E0%A6%9B%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%93-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%9C%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%A4%E0%A6%99%E0%A7%8D%E0%A6%95</guid>
      <pubDate>Tue, 10 Nov 2026 01:31:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/1645887864282d06aa1c4cdd4985d4bc-6af213fba2125.jpg?jadewits_media_id=1054137" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/1645887864282d06aa1c4cdd4985d4bc-6af213fba2125.jpg?jadewits_media_id=1054137" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/1645887864282d06aa1c4cdd4985d4bc-6af213fba2125.jpg?jadewits_media_id=1054137" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঘটছে ককটেল বিস্ফোরণ ও বাসে আগুন, জনমনে আতঙ্ক" /&gt;&lt;/p&gt;&lt;p&gt;সন্ধ্যা হলেই যেন রাজধানীতে বাড়ছে আতঙ্ক। বিভিন্ন স্থানে ধারাবাহিকভাবে ঘটছে ককটেল বিস্ফোরণ ও বাসে আগুনের ঘটনা।
সোমবার (৯ নভেম্বর) রাজধানীর বিভিন্ন এলাকায় ১৫টি ককটেল বিস্ফোরিত হয়েছে। আর আগুন দেওয়া হয়েছে দুটি বাসে। এসব ঘটনায় আটক হয়েছেন কমপক্ষে ২৬ জন।
রাত সাড়ে ৯টায় রাজধানীর মিরপুর সাড়ে ১১ পোস্ট অফিসের সা&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/others/capital-city/979927/%E0%A6%98%E0%A6%9F%E0%A6%9B%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%93-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%9C%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%A4%E0%A6%99%E0%A7%8D%E0%A6%95">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ঠাকুরগাঁওয়ের ছাত্রলীগ নেতা পেট্রোল বোমাসহ রাজধানীতে গ্রেফতার</title>
      <link>https://www.banglatribune.com/others/capital-city/979926/%E0%A6%A0%E0%A6%BE%E0%A6%95%E0%A7%81%E0%A6%B0%E0%A6%97%E0%A6%BE%E0%A6%81%E0%A6%93%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B2-%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A6%B9</link>
      <guid isPermaLink="true">https://www.banglatribune.com/others/capital-city/979926/%E0%A6%A0%E0%A6%BE%E0%A6%95%E0%A7%81%E0%A6%B0%E0%A6%97%E0%A6%BE%E0%A6%81%E0%A6%93%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B2-%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A6%B9</guid>
      <pubDate>Tue, 10 Nov 2026 01:03:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/e0c954439ba6292f2d7797e040f21d55-6af211844c867.jpg?jadewits_media_id=1054136" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/e0c954439ba6292f2d7797e040f21d55-6af211844c867.jpg?jadewits_media_id=1054136" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/e0c954439ba6292f2d7797e040f21d55-6af211844c867.jpg?jadewits_media_id=1054136" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঠাকুরগাঁওয়ের ছাত্রলীগ নেতা পেট্রোল বোমাসহ রাজধানীতে গ্রেফতার" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর আদাবর এলাকা থেকে নাশকতার চেষ্টাকালে ছয়টি পেট্রোল বোমা ও ৯৫০ গ্রাম গান পাউডারসহ ২ দুষ্কৃতিকারীকে গ্রেফতার করেছে এসআরবি-২ ।
সোমবার (৯ নভেম্বর) ভোরে এসআরবি-২ নিজস্ব গোয়েন্দা তথ্যের ভিত্তিতে জানতে পারে, কতিপয় দুষ্কৃতিকারী নাশকতা সৃষ্টির উদ্দেশে রাজধানীর আদাবর থানাধীন শ্যামলী লিং রোডে মোটরবাইক ন&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/others/capital-city/979926/%E0%A6%A0%E0%A6%BE%E0%A6%95%E0%A7%81%E0%A6%B0%E0%A6%97%E0%A6%BE%E0%A6%81%E0%A6%93%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B2-%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A6%B9">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>বনানী পুলিশ ফাঁড়ি লক্ষ্য করে ককটেল নিক্ষেপ</title>
      <link>https://www.banglatribune.com/others/capital-city/979925/%E0%A6%AC%E0%A6%A8%E0%A6%BE%E0%A6%A8%E0%A7%80-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%AB%E0%A6%BE%E0%A6%81%E0%A7%9C%E0%A6%BF-%E0%A6%B2%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8D%E0%A6%AF-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA</link>
      <guid isPermaLink="true">https://www.banglatribune.com/others/capital-city/979925/%E0%A6%AC%E0%A6%A8%E0%A6%BE%E0%A6%A8%E0%A7%80-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%AB%E0%A6%BE%E0%A6%81%E0%A7%9C%E0%A6%BF-%E0%A6%B2%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8D%E0%A6%AF-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA</guid>
      <pubDate>Tue, 10 Nov 2026 00:37:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/4763017a41911b71209e9ca406eaa7ba-6af20f46e1d44.jpg?jadewits_media_id=1054135" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/4763017a41911b71209e9ca406eaa7ba-6af20f46e1d44.jpg?jadewits_media_id=1054135" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/4763017a41911b71209e9ca406eaa7ba-6af20f46e1d44.jpg?jadewits_media_id=1054135" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বনানী পুলিশ ফাঁড়ি লক্ষ্য করে ককটেল নিক্ষেপ" /&gt;&lt;/p&gt;&lt;p&gt;বনানী পুলিশ ফাঁড়ি লক্ষ্য করে ককটেল হামলা হয়েছে। সোমবার (১০ নভেম্বর) দিবাগত রাত সাড়ে ১১টার দিকে এ ঘটনা ঘটে।&amp;nbsp;
বনানী থানার কর্তব্যরত অফিসার জানান, মোটরসাইকেল করে দুষ্কৃতিকারীরা এসে ককটেল বিস্ফোরণ ঘটিয়ে পালিয়ে যায়। &amp;nbsp;
তাদের গ্রেফতারে অভিযান চলছে বলেও জানিয়েছেন পুলিশের এ কর্মকর্তা।						বিস্তারি&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/others/capital-city/979925/%E0%A6%AC%E0%A6%A8%E0%A6%BE%E0%A6%A8%E0%A7%80-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%AB%E0%A6%BE%E0%A6%81%E0%A7%9C%E0%A6%BF-%E0%A6%B2%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8D%E0%A6%AF-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA">বাংলা ট্রিবিউন</source>
    </item>
    <item>

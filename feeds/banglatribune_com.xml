      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/2ded9348c1ddc9bbd0404b2e68595b21-6af81fd526fb8.jpg?jadewits_media_id=1054937" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/2ded9348c1ddc9bbd0404b2e68595b21-6af81fd526fb8.jpg?jadewits_media_id=1054937" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/2ded9348c1ddc9bbd0404b2e68595b21-6af81fd526fb8.jpg?jadewits_media_id=1054937" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যেখানে বিমানবন্দরের বাইরে যেতেই লাগে ভিসা, ১৪ ঘন্টা আটকের অভিজ্ঞতা পর্যটকের" /&gt;&lt;/p&gt;&lt;p&gt;দিল্লিতে ১৪ ঘণ্টার লেওভার শহর ঘুরে দেখা, ভালো খাবার খাওয়া আর ভ্রমণ-তালিকায় আরেকটি গন্তব্য যোগ করার দারুণ সুযোগ মনে হতে পারে। এক নারী পর্যটকও ঠিক তা-ই ভেবেছিলেন। কিন্তু পরে জানতে পারেন, বিমানবন্দরের বাইরে যেতেই ভিসা লাগবে।
হংকং থেকে লন্ডনগামী ওই পর্যটক দিল্লিতে ১৪ ঘণ্টার লেওভারসহ ফ্লাইট বুক করেছিলে&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/asia/980860/%E0%A6%AF%E0%A7%87%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%B0%E0%A7%87-%E0%A6%AF%E0%A7%87%E0%A6%A4%E0%A7%87%E0%A6%87-%E0%A6%B2%E0%A6%BE%E0%A6%97%E0%A7%87-%E0%A6%AD%E0%A6%BF%E0%A6%B8%E0%A6%BE-%E0%A7%A7%E0%A7%AA">বাংলা ট্রিবিউন</source>

    <item>
      <title>রাজধানীতে নিষিদ্ধ সংগঠনের মিছিল: ককটেলসহ গ্রেফতার ১৫</title>
      <link>https://www.banglatribune.com/law-and-crime/980738/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%B8%E0%A6%82%E0%A6%97%E0%A6%A0%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2%E0%A6%B8%E0%A6%B9-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/980738/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%B8%E0%A6%82%E0%A6%97%E0%A6%A0%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2%E0%A6%B8%E0%A6%B9-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Fri, 13 Nov 2026 19:35:19 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/08/25/7573c8093f910e3ec6cca8195624b20a-6a8da8c4b0ca0.jpg?jadewits_media_id=1040239" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/08/25/7573c8093f910e3ec6cca8195624b20a-6a8da8c4b0ca0.jpg?jadewits_media_id=1040239" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/08/25/7573c8093f910e3ec6cca8195624b20a-6a8da8c4b0ca0.jpg?jadewits_media_id=1040239" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজধানীতে নিষিদ্ধ সংগঠনের মিছিল: ককটেলসহ গ্রেফতার ১৫" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর বিভিন্ন থানা এলাকায় মিছিল করার চেষ্টাকালে নিষিদ্ধঘোষিত সংগঠনের ১৫ সদস্যকে ককটেলসহ গ্রেফতার করেছে ঢাকা মহানগর পুলিশ (ডিএমপি)। শুক্রবার (১৩ নভেম্বর) ডিএমপির ডিসি (মিডিয়া অ্যান্ড পাবলিক রিলেশন্স) মো. আকতার হোসেন এ তথ্য জানান।
তিনি জানান, রাজধানীর ডেমরা, তুরাগ, দারুস সালাম ও মিরপুর মডেল থানা এল&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/980738/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%B8%E0%A6%82%E0%A6%97%E0%A6%A0%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2%E0%A6%B8%E0%A6%B9-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>৪ হাজার কোটির ‘রামায়ণ’ কি ফ্লপ হচ্ছে?</title>
      <link>https://www.banglatribune.com/entertainment/film/980727/%E0%A7%AA-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF%E0%A6%B0-%E2%80%98%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A6%A3%E2%80%99-%E0%A6%95%E0%A6%BF-%E0%A6%AB%E0%A7%8D%E0%A6%B2%E0%A6%AA-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/entertainment/film/980727/%E0%A7%AA-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF%E0%A6%B0-%E2%80%98%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A6%A3%E2%80%99-%E0%A6%95%E0%A6%BF-%E0%A6%AB%E0%A7%8D%E0%A6%B2%E0%A6%AA-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87</guid>
      <pubDate>Fri, 13 Nov 2026 19:34:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/73552efa5cf500d11a4d39dc1e9a4fd4-6af703eae9e6d.jpg?jadewits_media_id=1054833" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/73552efa5cf500d11a4d39dc1e9a4fd4-6af703eae9e6d.jpg?jadewits_media_id=1054833" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/73552efa5cf500d11a4d39dc1e9a4fd4-6af703eae9e6d.jpg?jadewits_media_id=1054833" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৪ হাজার কোটির ‘রামায়ণ’ কি ফ্লপ হচ্ছে?" /&gt;&lt;/p&gt;&lt;p&gt;মুক্তির মাত্র আট দিনের মাথায় বিশ্বজুড়ে বক্স অফিসে এক হাজার কোটি রুপির মাইলফলক পেরিয়ে গেছে ভারতীয় চলচ্চিত্রের ইতিহাসের অন্যতম ব্যয়বহুল সিনেমা &amp;lsquo;রামায়ণ: পার্ট ১&amp;rsquo;। নীতিশ তিওয়ারি পরিচালিত এই ছবিতে রামের চরিত্রে রণবীর কাপুর এবং রাবণের চরিত্রে অভিনয় করেছেন যশ। কিন্তু আকাশচুম্বী বাজেট, দুর্বল চি&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/entertainment/film/980727/%E0%A7%AA-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF%E0%A6%B0-%E2%80%98%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A6%A3%E2%80%99-%E0%A6%95%E0%A6%BF-%E0%A6%AB%E0%A7%8D%E0%A6%B2%E0%A6%AA-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>

    <item>
      <title>‘তালিকাভুক্ত চাঁদাবাজ’ পিচ্চি মাসুদ গ্রেফতার</title>
      <link>https://www.banglatribune.com/law-and-crime/980597/%E2%80%98%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%AD%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%9C%E2%80%99-%E0%A6%AA%E0%A6%BF%E0%A6%9A%E0%A7%8D%E0%A6%9A%E0%A6%BF-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%81%E0%A6%A6-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/980597/%E2%80%98%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%AD%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%9C%E2%80%99-%E0%A6%AA%E0%A6%BF%E0%A6%9A%E0%A7%8D%E0%A6%9A%E0%A6%BF-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%81%E0%A6%A6-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Thu, 12 Nov 2026 23:02:16 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/5d51e289cbcdbe9b48a2e4565ef82e0c-6af5f0d45389b.jpg?jadewits_media_id=1054712" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/5d51e289cbcdbe9b48a2e4565ef82e0c-6af5f0d45389b.jpg?jadewits_media_id=1054712" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/5d51e289cbcdbe9b48a2e4565ef82e0c-6af5f0d45389b.jpg?jadewits_media_id=1054712" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘তালিকাভুক্ত চাঁদাবাজ’ পিচ্চি মাসুদ গ্রেফতার" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর তুরাগে বিশেষ অভিযান চা&amp;zwnj;লি&amp;zwnj;য়ে তালিকাভুক্ত চাঁদাবাজ মো. মাসুদ রানা ওরফে পিচ্চি মাসুদ&amp;zwnj;কে (২৫) গ্রেফতার করেছে ঢাকা মেট্রোপলিটন পুলিশের (ডিএমপি) তুরাগ থানা পুলিশ।
তুরাগ থানা পু&amp;zwnj;লি&amp;zwnj;শের বরাত দি&amp;zwnj;য়ে ডিএম&amp;zwnj;পির গণমাধ&amp;zwnj;্যম শাখা জানায়, বৃহস্পতিবার (১২ নভেম্বর) দুপুর&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/980597/%E2%80%98%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%AD%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%9C%E2%80%99-%E0%A6%AA%E0%A6%BF%E0%A6%9A%E0%A7%8D%E0%A6%9A%E0%A6%BF-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%81%E0%A6%A6-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0">বাংলা ট্রিবিউন</source>

      <guid isPermaLink="true">https://www.banglatribune.com/others/capital-city/979713/%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A7%80%E0%A6%AA-%E0%A6%9C%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A6%BE-%E0%A6%AA%E0%A7%82%E0%A6%9C%E0%A6%BE-%E0%A6%89%E0%A6%A6%E0%A6%AF%E0%A6%BE%E0%A6%AA%E0%A6%A8</guid>
      <pubDate>Mon, 09 Nov 2026 03:35:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/a767ea9f87dd2ff43d6cd7405bbb69af-6af0e1068093f.jpg?jadewits_media_id=1053958" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/a767ea9f87dd2ff43d6cd7405bbb69af-6af0e1068093f.jpg?jadewits_media_id=1053958" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/a767ea9f87dd2ff43d6cd7405bbb69af-6af0e1068093f.jpg?jadewits_media_id=1053958" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মন্দিরে মন্দিরে প্রদীপ জ্বালিয়ে শ্যামা পূজা উদযাপন" /&gt;&lt;/p&gt;&lt;p&gt;মন্দিরে মন্দিরে প্রদীপ জ্বালিয়ে ও আলোকসজ্জার মধ্য দিয়ে উদযাপিত হয়েছে হিন্দু সম্প্রদায়ের অন্যতম প্রধান ধর্মীয় উৎসব শ্রী শ্রী শ্যামা (কালী) পূজা ও দীপাবলি।
এ উপলক্ষে রবিবার (৮ নভেম্বর) সন্ধ্যা থেকেই রাজধানীর পূজামণ্ডপ ও মন্দিরগুলো সেজে ওঠে দৃষ্টিনন্দন আলোকসজ্জায়।
এদিন গভীর রাতে পূজা শেষে ভক্তদের মধ্যে&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/others/capital-city/979713/%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A7%80%E0%A6%AA-%E0%A6%9C%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A6%BE-%E0%A6%AA%E0%A7%82%E0%A6%9C%E0%A6%BE-%E0%A6%89%E0%A6%A6%E0%A6%AF%E0%A6%BE%E0%A6%AA%E0%A6%A8">বাংলা ট্রিবিউন</source>

    <item>
      <title>রিয়াদের পিআইএফ টাওয়ারে ফের হুথি হামলা, আহত ১১</title>
      <link>https://www.banglatribune.com/foreign/middle-east/983050/%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%9F%E0%A6%BF%E0%A6%86%E0%A6%87%E0%A6%8F%E0%A6%AB-%E0%A6%9F%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A7%81%E0%A6%A5%E0%A6%BF-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%86%E0%A6%B9%E0%A6%A4-%E0%A7%A7%E0%A7%A7</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/middle-east/983050/%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%9F%E0%A6%BF%E0%A6%86%E0%A6%87%E0%A6%8F%E0%A6%AB-%E0%A6%9F%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A7%81%E0%A6%A5%E0%A6%BF-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%86%E0%A6%B9%E0%A6%A4-%E0%A7%A7%E0%A7%A7</guid>
      <pubDate>Tue, 24 Nov 2026 22:52:13 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/174db61d267e1cbbdd7088a668c141d6-6b05bed35da95.jpg?jadewits_media_id=1056776" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/174db61d267e1cbbdd7088a668c141d6-6b05bed35da95.jpg?jadewits_media_id=1056776" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/174db61d267e1cbbdd7088a668c141d6-6b05bed35da95.jpg?jadewits_media_id=1056776" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রিয়াদের পিআইএফ টাওয়ারে ফের হুথি হামলা, আহত ১১" /&gt;&lt;/p&gt;&lt;p&gt;সৌদি আরবের রাজধানী রিয়াদের আর্থিক কেন্দ্রে পিআইএফ টাওয়ার লক্ষ্য করে হুথিদের হামলায় মঙ্গলবার ১১ জন আহত হয়েছেন বলে জানিয়েছে সৌদি সিভিল ডিফেন্স।

চীনে কমিউনিস্ট পার্টির পলিটব্যুরোর আরেক শীর্ষ কর্মকর্তার বিরুদ্ধে তদন্ত

এক বিবৃতিতে সংস্থাটি জানায়, আহতদের মধ্যে দুজন সৌদি নাগরিক, দুজন ভারতীয়, তিনজন নেপালি&lt;/p&gt;</description>

    <item>
      <title>‘একটি বাড়ি একটি খামার’ প্রকল্পের অনিয়ম তদন্তের এখতিয়ার নেই পল্লী উন্নয়ন বিভাগের</title>
      <link>https://www.banglatribune.com/national/979897/%E2%80%98%E0%A6%8F%E0%A6%95%E0%A6%9F%E0%A6%BF-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%8F%E0%A6%95%E0%A6%9F%E0%A6%BF-%E0%A6%96%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%B0%E2%80%99-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%AE-%E0%A6%A4%E0%A6%A6%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/national/979897/%E2%80%98%E0%A6%8F%E0%A6%95%E0%A6%9F%E0%A6%BF-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%8F%E0%A6%95%E0%A6%9F%E0%A6%BF-%E0%A6%96%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%B0%E2%80%99-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%AE-%E0%A6%A4%E0%A6%A6%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Mon, 09 Nov 2026 21:30:03 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/10/22/df62c374f88617f5b9e9076dc57d897e-6ad9e8ed78a69.png?jadewits_media_id=1050778" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/10/22/df62c374f88617f5b9e9076dc57d897e-6ad9e8ed78a69.png?jadewits_media_id=1050778" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/10/22/df62c374f88617f5b9e9076dc57d897e-6ad9e8ed78a69.png?jadewits_media_id=1050778" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘একটি বাড়ি একটি খামার’ প্রকল্পের অনিয়ম তদন্তের এখতিয়ার নেই পল্লী উন্নয়ন বিভাগের" /&gt;&lt;/p&gt;&lt;p&gt;আওয়ামী লীগ সরকারের আমলে বাস্তবায়িত &amp;lsquo;একটি বাড়ি একটি খামার&amp;rsquo; প্রকল্পে বরাদ্দ ও ব্যয়ের অনিয়ম তদন্ত করা পল্লী উন্নয়ন ও সমবায় বিভাগের এখতিয়ারভুক্ত নয় বলে জানিয়েছেন স্থানীয় সরকার, পল্লী উন্নয়ন ও সমবায়মন্ত্রী ড. আবদুল মঈন খান।
সোমবার (৯ নভেম্বর) জাতীয় সংসদের চতুর্থ অধিবেশনে সংসদ সদস্য শামছুর রহম&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/979897/%E2%80%98%E0%A6%8F%E0%A6%95%E0%A6%9F%E0%A6%BF-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%8F%E0%A6%95%E0%A6%9F%E0%A6%BF-%E0%A6%96%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%B0%E2%80%99-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%AE-%E0%A6%A4%E0%A6%A6%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%87%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>পোশাক খাতের উৎপাদন কমেছে ৩০ শতাংশ, সংসদে বিরোধীদলের নোটিশ</title>
      <link>https://www.banglatribune.com/national/979896/%E0%A6%AA%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%95-%E0%A6%96%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%89%E0%A7%8E%E0%A6%AA%E0%A6%BE%E0%A6%A6%E0%A6%A8-%E0%A6%95%E0%A6%AE%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A7%A9%E0%A7%A6-%E0%A6%B6%E0%A6%A4%E0%A6%BE%E0%A6%82%E0%A6%B6-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/national/979896/%E0%A6%AA%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%95-%E0%A6%96%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%89%E0%A7%8E%E0%A6%AA%E0%A6%BE%E0%A6%A6%E0%A6%A8-%E0%A6%95%E0%A6%AE%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A7%A9%E0%A7%A6-%E0%A6%B6%E0%A6%A4%E0%A6%BE%E0%A6%82%E0%A6%B6-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6%E0%A7%87</guid>
      <pubDate>Mon, 09 Nov 2026 21:24:08 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/9b7a38150e5ac1431e78412e7f05506b-6af1e53090d62.jpg?jadewits_media_id=1054107" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/9b7a38150e5ac1431e78412e7f05506b-6af1e53090d62.jpg?jadewits_media_id=1054107" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/9b7a38150e5ac1431e78412e7f05506b-6af1e53090d62.jpg?jadewits_media_id=1054107" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পোশাক খাতের উৎপাদন কমেছে ৩০ শতাংশ, সংসদে বিরোধীদলের নোটিশ" /&gt;&lt;/p&gt;&lt;p&gt;নিরবচ্ছিন্ন গ্যাস ও বিদ্যুৎ সরবরাহের অভাব এবং জ্বালানি সংকটে দেশের তৈরি পোশাক কারখানাগুলোর উৎপাদন সক্ষমতা ২৫ থেকে ৩০ শতাংশ পর্যন্ত কমে গেছে। এর ফলে আন্তর্জাতিক বাজারে ক্রেতারা ক্রয়াদেশ বাতিল করছেন এবং শিল্পটি বড় ধরনের ক্ষতির মুখে পড়ছে। এ পরিস্থিতিতে কারখানার উৎপাদন সচল রাখা ও জাতীয় অর্থনীতি রক্ষায় জ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/979896/%E0%A6%AA%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%95-%E0%A6%96%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%89%E0%A7%8E%E0%A6%AA%E0%A6%BE%E0%A6%A6%E0%A6%A8-%E0%A6%95%E0%A6%AE%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A7%A9%E0%A7%A6-%E0%A6%B6%E0%A6%A4%E0%A6%BE%E0%A6%82%E0%A6%B6-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>অ্যান্ড্রয়েড ফোনে গুগল মেসেজেসের যে পাঁচ সেটিংস বন্ধ রাখা ভালো</title>
      <link>https://www.banglatribune.com/tech-and-gadget/979895/%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A7%8D%E0%A6%B0%E0%A7%9F%E0%A7%87%E0%A6%A1-%E0%A6%AB%E0%A7%8B%E0%A6%A8%E0%A7%87-%E0%A6%97%E0%A7%81%E0%A6%97%E0%A6%B2-%E0%A6%AE%E0%A7%87%E0%A6%B8%E0%A7%87%E0%A6%9C%E0%A7%87%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%AF%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%81%E0%A6%9A-%E0%A6%B8%E0%A7%87%E0%A6%9F%E0%A6%BF%E0%A6%82%E0%A6%B8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/tech-and-gadget/979895/%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A7%8D%E0%A6%B0%E0%A7%9F%E0%A7%87%E0%A6%A1-%E0%A6%AB%E0%A7%8B%E0%A6%A8%E0%A7%87-%E0%A6%97%E0%A7%81%E0%A6%97%E0%A6%B2-%E0%A6%AE%E0%A7%87%E0%A6%B8%E0%A7%87%E0%A6%9C%E0%A7%87%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%AF%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%81%E0%A6%9A-%E0%A6%B8%E0%A7%87%E0%A6%9F%E0%A6%BF%E0%A6%82%E0%A6%B8</guid>
      <pubDate>Mon, 09 Nov 2026 21:23:39 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/3b5e11d05400f29c0833ccaad5974535-6af1e51a80863.jpg?jadewits_media_id=1054106" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/3b5e11d05400f29c0833ccaad5974535-6af1e51a80863.jpg?jadewits_media_id=1054106" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/3b5e11d05400f29c0833ccaad5974535-6af1e51a80863.jpg?jadewits_media_id=1054106" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অ্যান্ড্রয়েড ফোনে গুগল মেসেজেসের যে পাঁচ সেটিংস বন্ধ রাখা ভালো" /&gt;&lt;/p&gt;&lt;p&gt;বর্তমানে অধিকাংশ অ্যান্ড্রয়েড স্মার্টফোনে মেসেজ আদান-প্রদানের প্রাথমিক অ্যাপ হিসেবে গুগল মেসেজেস ব্যবহৃত হচ্ছে। এসএমএসের পাশাপাশি অ্যাপটিতে রয়েছে ইন্টারনেটভিত্তিক বার্তা আদান-প্রদানের বিভিন্ন সুবিধা। তবে এর কিছু ডিফল্ট সেটিংস ব্যবহারকারীর ব্যক্তিগত গোপনীয়তা ও স্বাচ্ছন্দ্যে প্রভাব ফেলতে পারে। তবে কয়ে&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/tech-and-gadget/979895/%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A7%8D%E0%A6%B0%E0%A7%9F%E0%A7%87%E0%A6%A1-%E0%A6%AB%E0%A7%8B%E0%A6%A8%E0%A7%87-%E0%A6%97%E0%A7%81%E0%A6%97%E0%A6%B2-%E0%A6%AE%E0%A7%87%E0%A6%B8%E0%A7%87%E0%A6%9C%E0%A7%87%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%AF%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%81%E0%A6%9A-%E0%A6%B8%E0%A7%87%E0%A6%9F%E0%A6%BF%E0%A6%82%E0%A6%B8">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>তুরস্ক যাচ্ছেন ড. খলিলুর রহমান</title>
      <link>https://www.banglatribune.com/national/979894/%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%95-%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%A1.-%E0%A6%96%E0%A6%B2%E0%A6%BF%E0%A6%B2%E0%A7%81%E0%A6%B0-%E0%A6%B0%E0%A6%B9%E0%A6%AE%E0%A6%BE%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/national/979894/%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%95-%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%A1.-%E0%A6%96%E0%A6%B2%E0%A6%BF%E0%A6%B2%E0%A7%81%E0%A6%B0-%E0%A6%B0%E0%A6%B9%E0%A6%AE%E0%A6%BE%E0%A6%A8</guid>
      <pubDate>Mon, 09 Nov 2026 21:28:41 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/cc2dc130ef13c886dfbfccdf2b57066e-6af1e3e878e11.JPG?jadewits_media_id=1054105" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/cc2dc130ef13c886dfbfccdf2b57066e-6af1e3e878e11.JPG?jadewits_media_id=1054105" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/cc2dc130ef13c886dfbfccdf2b57066e-6af1e3e878e11.JPG?jadewits_media_id=1054105" style="max-width:100%;height:auto;margin-bottom:10px;" alt="তুরস্ক যাচ্ছেন ড. খলিলুর রহমান" /&gt;&lt;/p&gt;&lt;p&gt;জাতিসংঘের জলবায়ু সম্মেলন কপ-৩১ এর ওয়ার্ল্ড লিডার্স সামিটে যোগ দিতে মঙ্গলবার (১০ নভেম্বর) তিন দিনের সরকারি সফরে তুরস্ক যাচ্ছেন প্রধানমন্ত্রী তারেক রহমান।  তুরস্কের উপকূলীয় শহর আন্তালিয়ায় ১১ ও ১২ নভেম্বর এই শীর্ষ সম্মেলন অনুষ্ঠিত হবে।
প্রধানমন্ত্রী ১২ নভেম্বর প্লেনারি অধিবেশনে বাংলাদেশের বক্তব্য &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/979894/%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%95-%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%A1.-%E0%A6%96%E0%A6%B2%E0%A6%BF%E0%A6%B2%E0%A7%81%E0%A6%B0-%E0%A6%B0%E0%A6%B9%E0%A6%AE%E0%A6%BE%E0%A6%A8">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>সড়কের পাশে দাঁড়িয়ে থাকা আরেক বাসে আগুন, মালিক আটক</title>
      <link>https://www.banglatribune.com/country/dhaka/979893/%E0%A6%B8%E0%A7%9C%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%BE%E0%A6%B6%E0%A7%87-%E0%A6%A6%E0%A6%BE%E0%A6%81%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%95-%E0%A6%86%E0%A6%9F%E0%A6%95</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/dhaka/979893/%E0%A6%B8%E0%A7%9C%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%BE%E0%A6%B6%E0%A7%87-%E0%A6%A6%E0%A6%BE%E0%A6%81%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%95-%E0%A6%86%E0%A6%9F%E0%A6%95</guid>
      <pubDate>Mon, 09 Nov 2026 21:12:55 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/715df8149c189d733f0c2ebb83fdf391-6af1e29163eb6.JPG?jadewits_media_id=1054104" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/715df8149c189d733f0c2ebb83fdf391-6af1e29163eb6.JPG?jadewits_media_id=1054104" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/715df8149c189d733f0c2ebb83fdf391-6af1e29163eb6.JPG?jadewits_media_id=1054104" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সড়কের পাশে দাঁড়িয়ে থাকা আরেক বাসে আগুন, মালিক আটক" /&gt;&lt;/p&gt;&lt;p&gt;গাজীপুরের কালিয়াকৈর উপজেলায় দাঁড়িয়ে থাকা আরেকটি বাসে আগুন দিয়েছে দুর্বৃত্তরা। সোমবার (৯ নভেম্বর) সন্ধ্যা সাড়ে ৬টার দিকে উপজেলার চন্দ্রা এলাকার কাজলী সিএনজি পাম্পের সামনে এ ঘটনা ঘটে।
প্রত্যক্ষদর্শীরা জানান, সন্ধ্যায় হঠাৎ বাসটির পেছনের অংশ থেকে ধোঁয়া বের হতে দেখেন স্থানীয় লোকজন। মুহূর্তেই আগুন পু&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/dhaka/979893/%E0%A6%B8%E0%A7%9C%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%BE%E0%A6%B6%E0%A7%87-%E0%A6%A6%E0%A6%BE%E0%A6%81%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%95-%E0%A6%86%E0%A6%9F%E0%A6%95">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>টিএসসিতে ককটেল বিস্ফোরণের পর আটক দুজনের পরিচয় মিলেছে</title>

      <guid isPermaLink="true">https://www.banglatribune.com/national/983507/%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%B8-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%93%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A1-%E0%A6%AA%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Fri, 27 Nov 2026 05:01:55 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/0c35099b39f4f90552a498301fe5b1e8-6b08ba2f9a9a3.jpg?jadewits_media_id=1057174" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/0c35099b39f4f90552a498301fe5b1e8-6b08ba2f9a9a3.jpg?jadewits_media_id=1057174" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/0c35099b39f4f90552a498301fe5b1e8-6b08ba2f9a9a3.jpg?jadewits_media_id=1057174" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যুক্তরাজ্যে এক্সিলেন্স অ্যাওয়ার্ড পেলেন বাংলাদেশের হাইকমিশনার" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাজ্যে নিযুক্ত বাংলাদেশের হাইকমিশনার রাষ্ট্রদূত মুহাম্মদ আবদুল মুহিত &amp;lsquo;এশিয়াওয়ান ডিপ্লোম্যাটিক এক্সিলেন্স অ্যাওয়ার্ড ২০২৬&amp;rsquo; পেয়েছেন। কূটনীতিতে আজীবন অবদান, বিশেষ করে বহুপাক্ষিকতা ও আন্তর্জাতিক সহযোগিতা এগিয়ে নেওয়ার ক্ষেত্রে ভূমিকার স্বীকৃতি হিসেবে তাকে এ পুরস্কার দেওয়া হয়েছে বলে জা&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/983507/%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%B8-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%93%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A1-%E0%A6%AA%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%A8">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>টঙ্গীতে মাদরাসায় হামলার মামলায় জামিন পেলেন ‘থাপ্পড়ম্যান’ শাহজালাল রুমি</title>
      <link>https://www.banglatribune.com/country/dhaka/983506/%E0%A6%9F%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A7%9F-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BF%E0%A6%A8-%E0%A6%AA%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/dhaka/983506/%E0%A6%9F%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A7%9F-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BF%E0%A6%A8-%E0%A6%AA%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Fri, 27 Nov 2026 04:38:08 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/10/27/4b5e3cb7d122709ac8523c7221122744-6ae09e9ec8c74.JPG?jadewits_media_id=1051645" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/10/27/4b5e3cb7d122709ac8523c7221122744-6ae09e9ec8c74.JPG?jadewits_media_id=1051645" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/10/27/4b5e3cb7d122709ac8523c7221122744-6ae09e9ec8c74.JPG?jadewits_media_id=1051645" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টঙ্গীতে মাদরাসায় হামলার মামলায় জামিন পেলেন ‘থাপ্পড়ম্যান’ শাহজালাল রুমি" /&gt;&lt;/p&gt;&lt;p&gt;গাজীপুরের টঙ্গীতে মাদ্রাসায় হামলা, ভাঙচুর ও শিক্ষককে মারধরের অভিযোগে দায়ের করা মামলায় আদালতে আত্মসমর্পণ করে জামিন পেয়েছেন ভুক্তভোগী শিশুর অভিভাবক শাহজালাল রুমি।
বৃহস্পতিবার (২৬ নভেম্বর) গাজীপুর আদালতে হাজির হয়ে আত্মসমর্পণ করলে আদালত তার জামিন মঞ্জুর করেন।
এর আগে গত ৩ নভেম্বর হাইকোর্টের বিচারপতি মো. &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/dhaka/983506/%E0%A6%9F%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A7%9F-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BF%E0%A6%A8-%E0%A6%AA%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%A8">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ভাটারা থেকে বিদেশি পিস্তল-গুলিসহ গ্রেফতার ২</title>
      <link>https://www.banglatribune.com/law-and-crime/983505/%E0%A6%AD%E0%A6%BE%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF-%E0%A6%AA%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%B2-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B8%E0%A6%B9-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A7%A8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/983505/%E0%A6%AD%E0%A6%BE%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF-%E0%A6%AA%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%B2-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B8%E0%A6%B9-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A7%A8</guid>
      <pubDate>Fri, 27 Nov 2026 03:42:28 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/e1ea81e65fc938bf4b2be6f04792ef37-6b08a7a5e84c6.jpg?jadewits_media_id=1057173" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/e1ea81e65fc938bf4b2be6f04792ef37-6b08a7a5e84c6.jpg?jadewits_media_id=1057173" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/e1ea81e65fc938bf4b2be6f04792ef37-6b08a7a5e84c6.jpg?jadewits_media_id=1057173" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভাটারা থেকে বিদেশি পিস্তল-গুলিসহ গ্রেফতার ২" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর ভাটারা থানা এলাকায় বিশেষ অভিযান চালিয়ে দুইটি বিদেশি পিস্তল ও ৯ রাউন্ড গুলিসহ দুইজনকে গ্রেফতার করেছে ভাটারা থানা পুলিশ। গ্রেফতারকৃতরা হলো, রুহুল আমিন (৩১) ও ইয়াসিন (২৬)।
বৃহস্পতিবার (২৬ নভেম্বর) পৌ&amp;zwnj;নে ৮টার দি&amp;zwnj;কে ভাটারার নূরের চালা বোটঘাট এলাকায় বিশেষ অভিযান চা&amp;zwnj;লায় পু&amp;zwnj;লিশ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/983505/%E0%A6%AD%E0%A6%BE%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF-%E0%A6%AA%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%B2-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B8%E0%A6%B9-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A7%A8">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>কাশ্মীরের প্রথম কেবল-স্টেড রেলসেতু পেরোলো বন্দে ভারত</title>
      <link>https://www.banglatribune.com/journey/983503/%E0%A6%95%E0%A6%BE%E0%A6%B6%E0%A7%8D%E0%A6%AE%E0%A7%80%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%95%E0%A7%87%E0%A6%AC%E0%A6%B2-%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%A1-%E0%A6%B0%E0%A7%87%E0%A6%B2%E0%A6%B8%E0%A7%87%E0%A6%A4%E0%A7%81-%E0%A6%AA%E0%A7%87%E0%A6%B0%E0%A7%8B%E0%A6%B2%E0%A7%8B-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/journey/983503/%E0%A6%95%E0%A6%BE%E0%A6%B6%E0%A7%8D%E0%A6%AE%E0%A7%80%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%95%E0%A7%87%E0%A6%AC%E0%A6%B2-%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%A1-%E0%A6%B0%E0%A7%87%E0%A6%B2%E0%A6%B8%E0%A7%87%E0%A6%A4%E0%A7%81-%E0%A6%AA%E0%A7%87%E0%A6%B0%E0%A7%8B%E0%A6%B2%E0%A7%8B-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%87</guid>
      <pubDate>Fri, 27 Nov 2026 02:49:49 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/f63fb88d3e7c0b3909a611a8437a0f94-6b089ad978f11.jpg?jadewits_media_id=1057171" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/f63fb88d3e7c0b3909a611a8437a0f94-6b089ad978f11.jpg?jadewits_media_id=1057171" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/f63fb88d3e7c0b3909a611a8437a0f94-6b089ad978f11.jpg?jadewits_media_id=1057171" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কাশ্মীরের প্রথম কেবল-স্টেড রেলসেতু পেরোলো বন্দে ভারত" /&gt;&lt;/p&gt;&lt;p&gt;কাশ্মীরের পথে ট্রেনযাত্রা মানেই চোখজুড়ানো প্রাকৃতিক সৌন্দর্য। বরফে ঢাকা পাহাড়, গভীর উপত্যকা আর পাহাড়ের বুক চিরে এগিয়ে চলা রেলপথ! এই যাত্রা যেন ছবির মতো সুন্দর। তার সঙ্গে যদি জুড়ে যায় আধুনিক প্রযুক্তির বিস্ময়, তা হলে অভিজ্ঞতা হয়ে ওঠে আরও রোমাঞ্চকর। সম্প্রতি এমনই এক দৃশ্য নজর কেড়েছে নেটদুনিয়ায়। ক&lt;/p&gt;</description>

    <item>
      <title>প্রেমের টানে বরিশালে এসে কিশোরীকে বিয়ে ভারতীয় যুবকের, বললেন ‘বাকি জীবন বাংলাদেশে কাটাতে চাই’</title>
      <link>https://www.banglatribune.com/country/barishal/983264/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%9F%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A6%B0%E0%A6%BF%E0%A6%B6%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%8F%E0%A6%B8%E0%A7%87-%E0%A6%95%E0%A6%BF%E0%A6%B6%E0%A7%8B%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%80%E0%A6%AF%E0%A6%BC</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/barishal/983264/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%9F%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A6%B0%E0%A6%BF%E0%A6%B6%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%8F%E0%A6%B8%E0%A7%87-%E0%A6%95%E0%A6%BF%E0%A6%B6%E0%A7%8B%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%80%E0%A6%AF%E0%A6%BC</guid>
      <pubDate>Wed, 25 Nov 2026 23:46:38 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/c4060af93ff83a5843e606658f3a0f33-6b071840af4c2.jpg?jadewits_media_id=1056944" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/c4060af93ff83a5843e606658f3a0f33-6b071840af4c2.jpg?jadewits_media_id=1056944" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/c4060af93ff83a5843e606658f3a0f33-6b071840af4c2.jpg?jadewits_media_id=1056944" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রেমের টানে বরিশালে এসে কিশোরীকে বিয়ে ভারতীয় যুবকের, বললেন ‘বাকি জীবন বাংলাদেশে কাটাতে চাই’" /&gt;&lt;/p&gt;&lt;p&gt;প্রেমের টানে ভারতের গুজরাট থেকে বরিশালের গৌরনদীতে এসে কিশোরীকে বিয়ে করেছেন সোরঠিয়া ফাইজান শাহ ওরফে হামজা (২০) নামে এক যুবক। তবে কিশোরীকে বিয়ে করায় এলাকায় চলছে নানা আলোচনা।
সোরঠিয়া ফাইজান শাহ ওরফে হামজা গুজরাটের বাসিন্দা এবং ওই এলাকার রেজওয়ান শাহর ছেলে। তিনি ছয় মাসের ট্যুরিস্ট ভিসায় গত ২২ নভেম&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/barishal/983264/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%9F%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A6%B0%E0%A6%BF%E0%A6%B6%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%8F%E0%A6%B8%E0%A7%87-%E0%A6%95%E0%A6%BF%E0%A6%B6%E0%A7%8B%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%80%E0%A6%AF%E0%A6%BC">বাংলা ট্রিবিউন</source>
    </item>

      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/d96e623012f21e8a92cbc16a6a8dffe9-6b08428c20309.jpg?jadewits_media_id=1057105" length="0" type="image/jpeg" />

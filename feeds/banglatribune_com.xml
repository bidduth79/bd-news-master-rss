      <pubDate>Fri, 13 Nov 2026 19:12:35 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/09/14/27efd0f534985f7e272b773ddc948c2a-6aa7b6e4c23a3.jpg?jadewits_media_id=1043670" length="0" type="image/jpeg" />

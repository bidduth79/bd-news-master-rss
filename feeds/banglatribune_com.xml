    <item>
      <title>সাংস্কৃতিক আন্দোলনের নেতৃত্ব দিতে হবে কবি-সাহিত্যিক-শিল্পীদের: গোলাম পরওয়ার</title>
      <link>https://www.banglatribune.com/politics/jamat-e-islam/980747/%E0%A6%B8%E0%A6%BE%E0%A6%82%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%83%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8B%E0%A6%B2%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AC-%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%AC%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/politics/jamat-e-islam/980747/%E0%A6%B8%E0%A6%BE%E0%A6%82%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%83%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8B%E0%A6%B2%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AC-%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%AC%E0%A7%87</guid>
      <pubDate>Fri, 13 Nov 2026 20:08:33 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/08/10/6c5254c10869bc4cb143b99d128bbda0-6a79910927a2d.jpg?jadewits_media_id=1037772" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/08/10/6c5254c10869bc4cb143b99d128bbda0-6a79910927a2d.jpg?jadewits_media_id=1037772" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/08/10/6c5254c10869bc4cb143b99d128bbda0-6a79910927a2d.jpg?jadewits_media_id=1037772" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাংস্কৃতিক আন্দোলনের নেতৃত্ব দিতে হবে কবি-সাহিত্যিক-শিল্পীদের: গোলাম পরওয়ার" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ জামায়াতে ইসলামীর সেক্রেটারি জেনারেল মিয়া গোলাম পরওয়ার বলেছেন, &amp;ldquo;ঢাকা শুধু প্রশাসনিক রাজধানী নয়, সাহিত্য ও সংস্কৃতিরও রাজধানী। তাই সারা দেশে সাংস্কৃতিক বিপ্লব সৃষ্টির দায়িত্ব ঢাকা মহানগরীর কবি, সাহিত্যিক ও শিল্পীদের। অশ্লীলতার মোকাবিলায় মানুষের মাঝে ইসলামের সুন্দর, মননশীল ও বিশুদ্ধ গান,&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/politics/jamat-e-islam/980747/%E0%A6%B8%E0%A6%BE%E0%A6%82%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%83%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8B%E0%A6%B2%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AC-%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%AC%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ব্যবসা-বাণিজ্যে স্থবিরতা, ব্যাংক হিসাব জব্দ: আতঙ্কে উদ্যোক্তারা</title>
      <link>https://www.banglatribune.com/business/news/980746/%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A6%A3%E0%A6%BF%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A6%A4%E0%A6%BE-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95-%E0%A6%B9%E0%A6%BF%E0%A6%B8%E0%A6%BE%E0%A6%AC-%E0%A6%9C%E0%A6%AC%E0%A7%8D%E0%A6%A6</link>
      <guid isPermaLink="true">https://www.banglatribune.com/business/news/980746/%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A6%A3%E0%A6%BF%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A6%A4%E0%A6%BE-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95-%E0%A6%B9%E0%A6%BF%E0%A6%B8%E0%A6%BE%E0%A6%AC-%E0%A6%9C%E0%A6%AC%E0%A7%8D%E0%A6%A6</guid>
      <pubDate>Fri, 13 Nov 2026 20:09:17 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2020/05/04/86dd4f020e72faf2b24b07821f338800-5eb03a1ad7236.jpg?jadewits_media_id=667461" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2020/05/04/86dd4f020e72faf2b24b07821f338800-5eb03a1ad7236.jpg?jadewits_media_id=667461" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2020/05/04/86dd4f020e72faf2b24b07821f338800-5eb03a1ad7236.jpg?jadewits_media_id=667461" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ব্যবসা-বাণিজ্যে স্থবিরতা, ব্যাংক হিসাব জব্দ: আতঙ্কে উদ্যোক্তারা" /&gt;&lt;/p&gt;&lt;p&gt;দেশের ব্যবসা-বাণিজ্যে একধরনের স্থবিরতা বিরাজ করছে। চার কারণে চাপে রয়েছেন ব্যবসায়ীরা- বিনিয়োগে ধীরগতি, উচ্চ সুদহার, উৎপাদন ব্যয় বৃদ্ধি এবং রাজনৈতিক - অর্থনৈতিক অনিশ্চয়তা। এমন পরিস্থিতিতে তৈরি পোশাকশিল্পে শ্রমিক অসন্তোষে ইন্ধন দেওয়ার অভিযোগে দুই শতাধিক ব্যক্তি ও প্রতিষ্ঠানের ব্যাংক হিসাব তলব এবং প্রায়&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/business/news/980746/%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A6%A3%E0%A6%BF%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A6%A4%E0%A6%BE-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95-%E0%A6%B9%E0%A6%BF%E0%A6%B8%E0%A6%BE%E0%A6%AC-%E0%A6%9C%E0%A6%AC%E0%A7%8D%E0%A6%A6">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>এমপির বাড়িতে বিদ্যুৎ থেকে আগুনের কোনও আলামত পায়নি পল্লী বিদ্যুৎ</title>

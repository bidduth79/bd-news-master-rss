    </item>
    <item>
      <title>বিশ্ব ডায়াবেটিস দিবস আজ</title>
      <link>https://www.banglatribune.com/national/980775/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC-%E0%A6%A1%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%9F%E0%A6%BF%E0%A6%B8-%E0%A6%A6%E0%A6%BF%E0%A6%AC%E0%A6%B8-%E0%A6%86%E0%A6%9C</link>
      <guid isPermaLink="true">https://www.banglatribune.com/national/980775/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC-%E0%A6%A1%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%9F%E0%A6%BF%E0%A6%B8-%E0%A6%A6%E0%A6%BF%E0%A6%AC%E0%A6%B8-%E0%A6%86%E0%A6%9C</guid>
      <pubDate>Sat, 14 Nov 2026 00:01:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/fb9f5b46b18b415074c987463c523f19-6af73c557f29c.JPG?jadewits_media_id=1054864" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/fb9f5b46b18b415074c987463c523f19-6af73c557f29c.JPG?jadewits_media_id=1054864" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/fb9f5b46b18b415074c987463c523f19-6af73c557f29c.JPG?jadewits_media_id=1054864" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিশ্ব ডায়াবেটিস দিবস আজ" /&gt;&lt;/p&gt;&lt;p&gt;আজ শনিবার (১৪ নভেম্বর) বিশ্ব ডায়াবেটিস দিবস। বিশ্বের অন্যান্য দেশের মতো বাংলাদেশেও বিভিন্ন কর্মসূচির মধ্য দিয়ে দিবসটি পালন করা হবে।
দিবসটির এবারের প্রতিপাদ্য হচ্ছে&amp;nbsp; &amp;lsquo;ডায়াবেটিসে দেরি নয়, ব্যবস্থা নিন এখনই&amp;rsquo;।
ডায়াবেটিস এমন একটি রোগ, যার কারণে দেহের গুরুত্বপূর্ণ অঙ্গের কার্যক্ষমতা হ্রাস&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/980775/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC-%E0%A6%A1%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%9F%E0%A6%BF%E0%A6%B8-%E0%A6%A6%E0%A6%BF%E0%A6%AC%E0%A6%B8-%E0%A6%86%E0%A6%9C">বাংলা ট্রিবিউন</source>
    </item>

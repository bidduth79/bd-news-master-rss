    <item>
      <title>ক্লিনিকে হামলা চালিয়ে ৩ জনকে পেটানোর অভিযোগ জামায়াতের কর্মীদের বিরুদ্ধে</title>
      <link>https://www.banglatribune.com/country/khulna/980465/%E0%A6%95%E0%A7%8D%E0%A6%B2%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A7%A9-%E0%A6%9C%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A6%BE%E0%A6%A8%E0%A7%8B%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/khulna/980465/%E0%A6%95%E0%A7%8D%E0%A6%B2%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A7%A9-%E0%A6%9C%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A6%BE%E0%A6%A8%E0%A7%8B%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97</guid>
      <pubDate>Thu, 12 Nov 2026 14:35:53 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/93d3cff0b3ee3759f1be0af5a8f06ff8-6af57a5eb7511.jpg?jadewits_media_id=1054610" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/93d3cff0b3ee3759f1be0af5a8f06ff8-6af57a5eb7511.jpg?jadewits_media_id=1054610" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/93d3cff0b3ee3759f1be0af5a8f06ff8-6af57a5eb7511.jpg?jadewits_media_id=1054610" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ক্লিনিকে হামলা চালিয়ে ৩ জনকে পেটানোর অভিযোগ জামায়াতের কর্মীদের বিরুদ্ধে" /&gt;&lt;/p&gt;&lt;p&gt;ঝিনাইদহের কালীগঞ্জে তুচ্ছ ঘটনাকে কেন্দ্র করে একটি বেসরকারি ক্লিনিকে ঢুকে মালিকসহ তিন জনকে পিটিয়ে ও কুপিয়ে জখম করার অভিযোগ উঠেছে জামায়াতের কয়েকজন নেতাকর্মীর বিরুদ্ধে। এ সময় ক্লিনিকে ভাঙচুর, নগদ টাকা ও স্বর্ণের চেইন লুট এবং চিকিৎসাধীন রোগী ও তাদের স্বজনদের সঙ্গে দুর্ব্যবহারের অভিযোগও উঠেছে।
বুধবার (১১&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/khulna/980465/%E0%A6%95%E0%A7%8D%E0%A6%B2%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A7%A9-%E0%A6%9C%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A6%BE%E0%A6%A8%E0%A7%8B%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97">বাংলা ট্রিবিউন</source>

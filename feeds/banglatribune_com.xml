      <guid isPermaLink="true">https://www.banglatribune.com/country/rajshahi/981166/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE-%E0%A6%B6%E0%A6%B9%E0%A6%B0%E0%A7%87-%E2%80%98%E0%A6%9C%E0%A7%9F-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E2%80%99-%E0%A6%B8%E0%A7%8D%E0%A6%B2%E0%A7%8B%E0%A6%97%E0%A6%BE%E0%A6%A8-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B6%E0%A6%A4%E0%A6%BE%E0%A6%A7%E0%A6%BF%E0%A6%95</guid>
      <pubDate>Mon, 16 Nov 2026 00:56:40 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/42d02b745f0cca8567910d4b1d88d819-6af9ffdad9fbb.jpg?jadewits_media_id=1055195" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/42d02b745f0cca8567910d4b1d88d819-6af9ffdad9fbb.jpg?jadewits_media_id=1055195" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/42d02b745f0cca8567910d4b1d88d819-6af9ffdad9fbb.jpg?jadewits_media_id=1055195" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এবার আরেক জেলা শহরে ‘জয় বাংলা’ স্লোগান দিয়ে শতাধিক রাউন্ড গুলি নিক্ষেপ" /&gt;&lt;/p&gt;&lt;p&gt;নাটোর সদরের দত্তপাড়া বাজারে ‘জয় বাংলা’ স্লোগান দিয়ে মুহুর্মুহু ফাঁকা গুলি ছুড়েছে দুর্বৃত্তরা। এ সময় পর পর কয়েকটি ককটেলের বিস্ফোরণও ঘটানো হয়।
রবিবার (১৫ নভেম্বর) রাত পৌনে ১১টার দিকে ঘটনাটি ঘটেছে। ঘটনার পর থেকে স্থানীয় বাসিন্দাদের মধ্যে চরম আতঙ্ক ছড়িয়ে পড়েছে। ঘটনার সত্যতা নিশ্চিত করেছেন নাটোর সদর থ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/rajshahi/981166/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE-%E0%A6%B6%E0%A6%B9%E0%A6%B0%E0%A7%87-%E2%80%98%E0%A6%9C%E0%A7%9F-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E2%80%99-%E0%A6%B8%E0%A7%8D%E0%A6%B2%E0%A7%8B%E0%A6%97%E0%A6%BE%E0%A6%A8-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B6%E0%A6%A4%E0%A6%BE%E0%A6%A7%E0%A6%BF%E0%A6%95">বাংলা ট্রিবিউন</source>

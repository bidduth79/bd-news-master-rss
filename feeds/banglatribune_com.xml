      <guid isPermaLink="true">https://www.banglatribune.com/national/981172/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%B8%E0%A7%8C%E0%A6%B0%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A7%8E-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%AA%E0%A6%A8-%E0%A6%AC%E0%A6%BF%E0%A6%B2-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%9B%E0%A7%87</guid>
      <pubDate>Mon, 16 Nov 2026 04:06:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/04/23/9ede2dea658c08e49711af169ac438d5-69e90d38c1f1a.jpg?jadewits_media_id=1020523" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/04/23/9ede2dea658c08e49711af169ac438d5-69e90d38c1f1a.jpg?jadewits_media_id=1020523" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/04/23/9ede2dea658c08e49711af169ac438d5-69e90d38c1f1a.jpg?jadewits_media_id=1020523" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিশেষ সৌরবিদ্যুৎ স্থাপন বিল পরীক্ষা-নিরীক্ষা করছে সংসদীয় কমিটি" /&gt;&lt;/p&gt;&lt;p&gt;&amp;lsquo;বিশেষ সৌরবিদ্যুৎ স্থাপন বিল, ২০২৬&amp;rsquo; অধিকতর পরীক্ষা-নিরীক্ষা ও পর্যবেক্ষণের সিদ্ধান্ত নিয়েছে বিদ্যুৎ, জ্বালানি ও খনিজ সম্পদ মন্ত্রণালয় সম্পর্কিত সংসদীয় স্থায়ী কমিটি। প্রয়োজনীয় সংশোধনী অন্তর্ভুক্ত করে দ্রুততম সময়ের মধ্যে জাতীয় সংসদে প্রতিবেদন আকারে বিলটি উপস্থাপন করা হবে।
রবিবার (১৫ নভেম্ব&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/981172/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%B8%E0%A7%8C%E0%A6%B0%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A7%8E-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%AA%E0%A6%A8-%E0%A6%AC%E0%A6%BF%E0%A6%B2-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%9B%E0%A7%87">বাংলা ট্রিবিউন</source>

      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/cd5844520bf2c5b9e91d21284283c0da-6af4654d7f6c3.JPG?jadewits_media_id=1054469" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/cd5844520bf2c5b9e91d21284283c0da-6af4654d7f6c3.JPG?jadewits_media_id=1054469" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/cd5844520bf2c5b9e91d21284283c0da-6af4654d7f6c3.JPG?jadewits_media_id=1054469" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এবার ১০০ কোটির পথে শচীনের ব্র্যান্ড!" /&gt;&lt;/p&gt;&lt;p&gt;ক্রিকেট কিংবদন্তি শচীন টেন্ডুলকারের বিনিয়োগ ও সম্পৃক্ততায় গড়ে ওঠা খেলাধুলা বা ব্যায়ামের উপযোগী পণ্যের ব্র্যান্ড ‘টেন এক্স ইউ’ প্রথম বছরেই এক লাখ ক্রেতার মাইলফলক ছুঁয়েছে। এবার আগামী চার থেকে পাঁচ মাসের মধ্যে ১০০ কোটি রুপি অর্জনের লক্ষ্য নিয়েছে প্রতিষ্ঠানটি। ২০২৫ সালের অক্টোবরে যাত্রা শুরু করা ব্র্যা&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/cricket/983023/%E0%A6%8F%E0%A6%95-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%87-%E0%A6%B2%E0%A6%BE%E0%A6%96%E0%A7%8B-%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A7%A7%E0%A7%A6%E0%A7%A6-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%B6%E0%A6%9A%E0%A7%80%E0%A6%A8%E0%A7%87%E0%A6%B0">বাংলা ট্রিবিউন</source>

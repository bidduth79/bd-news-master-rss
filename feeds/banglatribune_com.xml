    <item>
      <title>দেশে অ্যান্টিবায়োটিক রেজিস্ট্যান্সের কারণে বছরে মারা যান সোয়া লাখ মানুষ</title>
      <link>https://www.banglatribune.com/health/982842/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A7%8B%E0%A6%9F%E0%A6%BF%E0%A6%95-%E0%A6%B0%E0%A7%87%E0%A6%9C%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/health/982842/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A7%8B%E0%A6%9F%E0%A6%BF%E0%A6%95-%E0%A6%B0%E0%A7%87%E0%A6%9C%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87</guid>
      <pubDate>Tue, 24 Nov 2026 01:08:04 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/6fbecc0a9a54b813331620faabd47f82-6b048eac00075.jpg?jadewits_media_id=1056608" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/6fbecc0a9a54b813331620faabd47f82-6b048eac00075.jpg?jadewits_media_id=1056608" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/6fbecc0a9a54b813331620faabd47f82-6b048eac00075.jpg?jadewits_media_id=1056608" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দেশে অ্যান্টিবায়োটিক রেজিস্ট্যান্সের কারণে বছরে মারা যান সোয়া লাখ মানুষ" /&gt;&lt;/p&gt;&lt;p&gt;দেশে অ্যান্টিবায়োটিক রেজিস্ট্যান্সের কারণে প্রতি বছর সোয়া লাখ মানুষ মৃত্যুবরণ করেন বলে জানিয়েছেন স্বাস্থ্য ও পরিবার কল্যাণ প্রতিমন্ত্রী ড. এম এ মুহিত। সোমবার (২৩ নভেম্বর) রাজধানীর একটি হোটেলে আয়োজিত এক কর্মশালায় প্রধান অতিথির বক্তব্যে তিনি এসব কথা বলেন।&amp;nbsp;
বিশ্ব স্বাস্থ্য সংস্থার (ডব্লিউএইচও) &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/health/982842/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A7%8B%E0%A6%9F%E0%A6%BF%E0%A6%95-%E0%A6%B0%E0%A7%87%E0%A6%9C%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>শীতেও ত্বক থাকবে কোমল, ভাগ্যশ্রীর বিশেষ পানীয়</title>
      <link>https://www.banglatribune.com/lifestyle/982841/%E0%A6%B6%E0%A7%80%E0%A6%A4%E0%A7%87%E0%A6%93-%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A6%95-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%AC%E0%A7%87-%E0%A6%95%E0%A7%8B%E0%A6%AE%E0%A6%B2-%E0%A6%AD%E0%A6%BE%E0%A6%97%E0%A7%8D%E0%A6%AF%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%AA%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A7%9F</link>
      <guid isPermaLink="true">https://www.banglatribune.com/lifestyle/982841/%E0%A6%B6%E0%A7%80%E0%A6%A4%E0%A7%87%E0%A6%93-%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A6%95-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%AC%E0%A7%87-%E0%A6%95%E0%A7%8B%E0%A6%AE%E0%A6%B2-%E0%A6%AD%E0%A6%BE%E0%A6%97%E0%A7%8D%E0%A6%AF%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%AA%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A7%9F</guid>
      <pubDate>Tue, 24 Nov 2026 00:58:17 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/0937ebdd6c7d5eccb7b24c3847268549-6b048c90503d6.jpg?jadewits_media_id=1056607" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/0937ebdd6c7d5eccb7b24c3847268549-6b048c90503d6.jpg?jadewits_media_id=1056607" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/0937ebdd6c7d5eccb7b24c3847268549-6b048c90503d6.jpg?jadewits_media_id=1056607" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শীতেও ত্বক থাকবে কোমল, ভাগ্যশ্রীর বিশেষ পানীয়" /&gt;&lt;/p&gt;&lt;p&gt;শীতের হাওয়া বইতে শুরু করলেই ত্বকে টান ধরতে থাকে। আর্দ্রতা কমে যাওয়ায় মুখের চামড়া হয়ে ওঠে রুক্ষ ও শুষ্ক। এই সময়ে ত্বকের যত্নে শুধু প্রসাধনী ব্যবহার করলেই হবে না, শরীরের ভেতর থেকেও প্রয়োজন পুষ্টি ও পর্যাপ্ত পানির জোগান। শীতের দিনে ত্বকের যত্নে এমনই এক বিশেষ পানীয় তৈরির পরামর্শ দিয়েছেন অভিনেত্রী ভাগ্য&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/lifestyle/982841/%E0%A6%B6%E0%A7%80%E0%A6%A4%E0%A7%87%E0%A6%93-%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A6%95-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%AC%E0%A7%87-%E0%A6%95%E0%A7%8B%E0%A6%AE%E0%A6%B2-%E0%A6%AD%E0%A6%BE%E0%A6%97%E0%A7%8D%E0%A6%AF%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%AA%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A7%9F">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ভূমধ্যসাগর থেকে উদ্ধার আরও ১৭৪ বাংলাদেশি দেশে ফিরছেন আজ</title>
      <link>https://www.banglatribune.com/national/982837/%E0%A6%AD%E0%A7%82%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A6%B8%E0%A6%BE%E0%A6%97%E0%A6%B0-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A7%A7%E0%A7%AD%E0%A7%AA-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/national/982837/%E0%A6%AD%E0%A7%82%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A6%B8%E0%A6%BE%E0%A6%97%E0%A6%B0-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A7%A7%E0%A7%AD%E0%A7%AA-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87</guid>
      <pubDate>Tue, 24 Nov 2026 00:26:03 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/6a3950055494dc57ac39cfd7f5399699-6b0484de3773a.jpg?jadewits_media_id=1056603" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/6a3950055494dc57ac39cfd7f5399699-6b0484de3773a.jpg?jadewits_media_id=1056603" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/6a3950055494dc57ac39cfd7f5399699-6b0484de3773a.jpg?jadewits_media_id=1056603" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভূমধ্যসাগর থেকে উদ্ধার আরও ১৭৪ বাংলাদেশি দেশে ফিরছেন আজ" /&gt;&lt;/p&gt;&lt;p&gt;লিবিয়ার বেনগাজীর গানফুদা ডিটেনশন সেন্টারে আটক থাকা আরও ১৭৪ জন বাংলাদেশি নাগরিককে দেশে ফিরিয়ে আনা হচ্ছে। আন্তর্জাতিক অভিবাসন সংস্থার (আইওএম) সহায়তায় সোমবার (২৩ নভেম্বর) তাদের প্রত্যাবাসন প্রক্রিয়া সম্পন্ন করে লিবিয়ায় অবস্থিত বাংলাদেশ দূতাবাস। বুরাক এয়ারের একটি বিশেষ ফ্লাইটে মঙ্গলবার (২৪ নভেম্বর) সকাল&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/982837/%E0%A6%AD%E0%A7%82%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A6%B8%E0%A6%BE%E0%A6%97%E0%A6%B0-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A7%A7%E0%A7%AD%E0%A7%AA-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>চুরির ঘটনায় ধরা পড়লেন চাকরিচ্যুত পুলিশ কর্মকর্তা</title>
      <link>https://www.banglatribune.com/country/khulna/982836/%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%B0-%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%A7%E0%A6%B0%E0%A6%BE-%E0%A6%AA%E0%A7%9C%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%9A%E0%A6%BE%E0%A6%95%E0%A6%B0%E0%A6%BF%E0%A6%9A%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%A4-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/khulna/982836/%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%B0-%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%A7%E0%A6%B0%E0%A6%BE-%E0%A6%AA%E0%A7%9C%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%9A%E0%A6%BE%E0%A6%95%E0%A6%B0%E0%A6%BF%E0%A6%9A%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%A4-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE</guid>
      <pubDate>Tue, 24 Nov 2026 00:19:09 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/558c0e6590d4db396ebc335dbfbc6cc4-6b048394c144f.jpg?jadewits_media_id=1056602" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/558c0e6590d4db396ebc335dbfbc6cc4-6b048394c144f.jpg?jadewits_media_id=1056602" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/558c0e6590d4db396ebc335dbfbc6cc4-6b048394c144f.jpg?jadewits_media_id=1056602" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চুরির ঘটনায় ধরা পড়লেন চাকরিচ্যুত পুলিশ কর্মকর্তা" /&gt;&lt;/p&gt;&lt;p&gt;ইজিবাইক চুরির ঘটনায় পুলিশের চাকরিচ্যুত এএসআই মিরান শেখকে গ্রেফতার করেছে খুলনা মহানগর গোয়েন্দা পুলিশ (ডিবি)। রবিবার রাত সাড়ে ১২টার দিকে সদর থানার টুটপাড়া এলাকার মওলার বাড়ির মোড় থেকে গ্রেফতার করা হয়। তিনি বাটিয়াঘাটা উপজেলার ভাণ্ডারকোর্ট পূর্বপাড়া এলাকার আহমেদ শেখের ছেলে।
পুলিশের একটি সূত্র জা&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/khulna/982836/%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%B0-%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%A7%E0%A6%B0%E0%A6%BE-%E0%A6%AA%E0%A7%9C%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%9A%E0%A6%BE%E0%A6%95%E0%A6%B0%E0%A6%BF%E0%A6%9A%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%A4-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE">বাংলা ট্রিবিউন</source>

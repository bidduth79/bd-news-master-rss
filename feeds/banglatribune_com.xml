      <guid isPermaLink="true">https://www.banglatribune.com/lifestyle/979982/%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%A4%E0%A6%BF%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%A8-%E0%A6%9F%E0%A6%BE%E0%A6%87%E0%A6%AE%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A6%9B%E0%A7%87-%E0%A6%B9%E0%A7%83%E0%A6%A6%E0%A7%8D%E2%80%8C%E0%A6%B0%E0%A7%8B%E0%A6%97%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Tue, 10 Nov 2026 13:08:41 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/2cd20caab2922bc475a985e76736c877-6af2c25d4fbe6.jpg?jadewits_media_id=1054180" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/2cd20caab2922bc475a985e76736c877-6af2c25d4fbe6.jpg?jadewits_media_id=1054180" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/2cd20caab2922bc475a985e76736c877-6af2c25d4fbe6.jpg?jadewits_media_id=1054180" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শিশুদের অতিরিক্ত স্ক্রিন-টাইমে বাড়ছে হৃদ্‌রোগের ঝুঁকি?" /&gt;&lt;/p&gt;&lt;p&gt;মোবাইলের পর্দায় কার্টুন, ভিডিও গেম কিংবা একের পর এক রিল। শিশুদের অবসর কাটানোর অন্যতম মাধ্যম হয়ে উঠেছে ডিজিটাল স্ক্রিন। টিভি, মোবাইল, ট্যাব বা ল্যাপটপে ঘণ্টার পর ঘণ্টা সময় কাটাচ্ছে শিশুরা। অনেক অভিভাবকও শিশুকে খাওয়ানো বা শান্ত রাখার জন্য হাতে তুলে দিচ্ছেন মোবাইল। কিন্তু দীর্ঘ সময় ধরে এই অভ্যাসের প্রভ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/lifestyle/979982/%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%A4%E0%A6%BF%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%A8-%E0%A6%9F%E0%A6%BE%E0%A6%87%E0%A6%AE%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A6%9B%E0%A7%87-%E0%A6%B9%E0%A7%83%E0%A6%A6%E0%A7%8D%E2%80%8C%E0%A6%B0%E0%A7%8B%E0%A6%97%E0%A7%87%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>কূটনৈতিক পাড়ায় কী হচ্ছে জানি না: শেখ হাসিনার পাসপোর্ট ইস্যুতে তথ্য উপদেষ্টা</title>
      <link>https://www.banglatribune.com/national/979981/%E0%A6%95%E0%A7%82%E0%A6%9F%E0%A6%A8%E0%A7%88%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%AA%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A7%80-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%A8%E0%A6%BE-%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/national/979981/%E0%A6%95%E0%A7%82%E0%A6%9F%E0%A6%A8%E0%A7%88%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%AA%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A7%80-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%A8%E0%A6%BE-%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Tue, 10 Nov 2026 13:11:46 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/c295d89b983c819694b3a23d5a464de0-6af2c1f9efb52.jpg?jadewits_media_id=1054179" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/c295d89b983c819694b3a23d5a464de0-6af2c1f9efb52.jpg?jadewits_media_id=1054179" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/c295d89b983c819694b3a23d5a464de0-6af2c1f9efb52.jpg?jadewits_media_id=1054179" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কূটনৈতিক পাড়ায় কী হচ্ছে জানি না: শেখ হাসিনার পাসপোর্ট ইস্যুতে তথ্য উপদেষ্টা" /&gt;&lt;/p&gt;&lt;p&gt;‘কূটনৈতিক পাড়ায় কী হচ্ছে না হচ্ছে আমরা আসলে জানি না। সুতরাং এটা নিয়ে প্রতিক্রিয়া জানানোর কিছু নাই।’ 
শেখ হাসিনার পাসপোর্টকে কেন্দ্র করে কূটনৈতিক পাড়ায় কী আলোচনা হচ্ছে এবং এনিয়ে সরকারের প্রতিক্রিয়া কী— এমন প্রশ্নের জবাবে প্রধানমন্ত্রীর তথ্য ও সম্প্রচার বিষয়ক উপদেষ্টা ডা. জাহেদ উর রহমান এই মন&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/979981/%E0%A6%95%E0%A7%82%E0%A6%9F%E0%A6%A8%E0%A7%88%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%AA%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A7%80-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%A8%E0%A6%BE-%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0">বাংলা ট্রিবিউন</source>

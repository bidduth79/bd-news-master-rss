      <pubDate>Sat, 28 Nov 2026 02:44:54 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/65df067af2a0deb187a5ea48656a0ceb-6b09eb97d397c.jpg?jadewits_media_id=1057362" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/65df067af2a0deb187a5ea48656a0ceb-6b09eb97d397c.jpg?jadewits_media_id=1057362" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/65df067af2a0deb187a5ea48656a0ceb-6b09eb97d397c.jpg?jadewits_media_id=1057362" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজধানীতে ৪ স্থানে ককটেল বিস্ফোরণ, আটক ১" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর কলাবাগান, ওয়ারী, কাফরুল ও ধানমন্ডি থানা এলাকার ৪টি পৃথক স্থানে ককটেল বিস্ফোরণের ঘটনা ঘটেছে। এতে কোনও হতাহতের খবর পাওয়া যায়‌নি। পুলিশ জড়িত একজনকে আটক ক‌রে‌ছে। 
শুক্রবার (২৭ নভেম্বর) বিকেল থেকে রাতের মধ্যে এসব বিস্ফোরণের ঘটনা ঘটে। 
এদিন রাত ১০টা ২৩ মিনিটের দিকে মিরপুর-১০ গোলচত্বর এলাকায় ককটেল&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/983694/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A7%AA-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A7%A7">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>পল্লবীতে যাত্রীবেশে বাসে আগুন</title>
      <link>https://www.banglatribune.com/law-and-crime/983693/%E0%A6%AA%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%AC%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/983693/%E0%A6%AA%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%AC%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</guid>
      <pubDate>Sat, 28 Nov 2026 02:31:59 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/4e2c1d997376ae113e6661926a4a0bdc-6b09e279cb4ba.jpg?jadewits_media_id=1057361" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/4e2c1d997376ae113e6661926a4a0bdc-6b09e279cb4ba.jpg?jadewits_media_id=1057361" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/4e2c1d997376ae113e6661926a4a0bdc-6b09e279cb4ba.jpg?jadewits_media_id=1057361" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পল্লবীতে যাত্রীবেশে বাসে আগুন" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর মিরপুরের কালশী এলাকায় যাত্রীবেশে একটি যাত্রীবাহী বাসে কেরোসিন ঢেলে আগুন দিয়েছে দুর্বৃত্তরা।
শুক্রবার (২৭ নভেম্বর) রাত ১১টার দিকে এ ঘটনা ঘটে।
পল্লবী থানার ভারপ্রাপ্ত কর্মকর্তা (ওসি) মো. জালাল উদ্দিন বলেন, যাত্রীবেশে দুর্বৃত্তরা একেবারে পেছনের সিটে বসে কেরোসিন ঢেলে বা‌সে আগুন ধরিয়ে দেয়। পরে ব&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/983693/%E0%A6%AA%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%AC%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ঢাকা-চট্টগ্রাম মহাসড়কে যাত্রীবেশে বাসে আগুন</title>

      <link>https://www.banglatribune.com/country/chitagong/980741/%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%9A%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%BF%E0%A6%A4-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A6%B2-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%BE-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/chitagong/980741/%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%9A%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%BF%E0%A6%A4-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A6%B2-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%BE-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF</guid>
      <pubDate>Fri, 13 Nov 2026 19:40:52 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/2d72cf348975bf4226c2ec05d09d48ec-6af7134e667e2.jpg?jadewits_media_id=1054841" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/2d72cf348975bf4226c2ec05d09d48ec-6af7134e667e2.jpg?jadewits_media_id=1054841" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/2d72cf348975bf4226c2ec05d09d48ec-6af7134e667e2.jpg?jadewits_media_id=1054841" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নির্বাচনে পরাজিত প্রার্থীকে কল দিয়ে চাঁদা দাবি, বললো ‘না দিলে মেরে ফেলবো’" /&gt;&lt;/p&gt;&lt;p&gt;সন্ত্রাসের জনপদ হিসেবে পরিচিত চট্টগ্রামের রাউজান উপজেলায় এবার চাঁদা চেয়ে মাদ্রাসার এক অধ্যক্ষকে মেরে ফেলার হুমকি দিয়েছে সন্ত্রাসীরা। এ ঘটনায় ভুক্তভোগী অধ্যক্ষ মাওলানা ইলিয়াস নূরী জীবনের নিরাপত্তা চেয়ে রাউজান থানায় সাধারণ ডায়েরি (জিডি) করেছেন।
চাঁদার জন্য মোবাইল ফোনে হুমকি পাওয়া অধ্যক্ষ মাওলানা ইলিয়া&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/chitagong/980741/%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%9A%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%BF%E0%A6%A4-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A6%B2-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%BE-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF">বাংলা ট্রিবিউন</source>

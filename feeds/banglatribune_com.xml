    </item>
    <item>
      <title>হঠাৎ যত্রতত্র ককটেল, পুলিশ ধরছে নিক্ষেপকারী নাকি সন্দেহভাজনদের?</title>
      <link>https://www.banglatribune.com/law-and-crime/979690/%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%9B%E0%A7%81%E0%A7%9C%E0%A6%9B%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%A7%E0%A6%B0%E0%A6%9B%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%95%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/979690/%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%9B%E0%A7%81%E0%A7%9C%E0%A6%9B%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%A7%E0%A6%B0%E0%A6%9B%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%95%E0%A6%BF</guid>
      <pubDate>Mon, 09 Nov 2026 01:45:29 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/06/18/27f2d8396ea57ac87d66241e58f09d52-6a33b1e507282.jpg?jadewits_media_id=1029459" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/06/18/27f2d8396ea57ac87d66241e58f09d52-6a33b1e507282.jpg?jadewits_media_id=1029459" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/06/18/27f2d8396ea57ac87d66241e58f09d52-6a33b1e507282.jpg?jadewits_media_id=1029459" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হঠাৎ যত্রতত্র ককটেল, পুলিশ ধরছে নিক্ষেপকারী নাকি সন্দেহভাজনদের?" /&gt;&lt;/p&gt;&lt;p&gt;সন্ধ্যার ব্যস্ততা তখনও কমেনি ঢাকা বিশ্ববিদ্যালয় ক্যাম্পাসে। হঠাৎ টিএসসি এলাকায় পরপর দুটি বিকট শব্দ। মুহূর্তের মধ্যে ছড়িয়ে পড়ে আতঙ্ক। কিছুক্ষণ পর একই শব্দ শোনা যায় বিশ্ববিদ্যালয়ের প্রশাসনিক ভবনের পাশে, ভিসি চত্বর ও মুক্তি-গণতন্ত্র তোরণের সামনে। দৌড়ে পালানোর সময় কয়েকজনকে আটক করেন শিক্ষার্থীরা। রবিবার &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/979690/%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%9B%E0%A7%81%E0%A7%9C%E0%A6%9B%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%A7%E0%A6%B0%E0%A6%9B%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%95%E0%A6%BF">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>বিএনপির র‍্যালিতে মুহুর্মুহু বিস্ফোরণ: হেলমেট পরে আলাদা পোশাকে তারা কারা?</title>
      <link>https://www.banglatribune.com/country/chitagong/979703/%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%B0%E2%80%8D%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AE%E0%A7%81%E0%A6%B9%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%81%E0%A6%B9%E0%A7%81-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%B9%E0%A7%87%E0%A6%B2%E0%A6%AE%E0%A7%87%E0%A6%9F-%E0%A6%AA%E0%A6%B0%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/chitagong/979703/%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%B0%E2%80%8D%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AE%E0%A7%81%E0%A6%B9%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%81%E0%A6%B9%E0%A7%81-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%B9%E0%A7%87%E0%A6%B2%E0%A6%AE%E0%A7%87%E0%A6%9F-%E0%A6%AA%E0%A6%B0%E0%A7%87</guid>
      <pubDate>Sun, 08 Nov 2026 23:47:15 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/529f552abdf7f134061f9905c3c8da29-6af0b599c8c51.jpg?jadewits_media_id=1053951" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/529f552abdf7f134061f9905c3c8da29-6af0b599c8c51.jpg?jadewits_media_id=1053951" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/529f552abdf7f134061f9905c3c8da29-6af0b599c8c51.jpg?jadewits_media_id=1053951" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিএনপির র‍্যালিতে মুহুর্মুহু বিস্ফোরণ: হেলমেট পরে আলাদা পোশাকে তারা কারা?" /&gt;&lt;/p&gt;&lt;p&gt;জাতীয় বিপ্লব ও সংহতি দিবস উপলক্ষে বিএনপির র&amp;zwj;্যালিকে ঘিরে ফেনীর দাগনভূঞা পৌর শহরে মুহুর্মুহু ককটেল বিস্ফোরণ ও বিশেষ পোশাক পরা ব্যক্তিদের অস্ত্র হাতে মহড়ায় আতঙ্ক ছড়িয়ে পড়েছে। বিস্ফোরণের শব্দে বন্ধ হয়ে যায় অধিকাংশ দোকানপাট। ব্যাহত হয় যান চলাচল, ভোগান্তিতে পড়েন সাধারণ মানুষজন। এ ঘটনায় বিএনপির একাধিক&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/chitagong/979703/%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%B0%E2%80%8D%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AE%E0%A7%81%E0%A6%B9%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%81%E0%A6%B9%E0%A7%81-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%B9%E0%A7%87%E0%A6%B2%E0%A6%AE%E0%A7%87%E0%A6%9F-%E0%A6%AA%E0%A6%B0%E0%A7%87">বাংলা ট্রিবিউন</source>

    <item>
      <title>গাড়ি পেয়েছেন বৈভব, কিন্তু চালানোর লাইসেন্স পেতে থাকতে হচ্ছে অপেক্ষায়!</title>
      <link>https://www.banglatribune.com/sport/cricket/980095/%E0%A6%97%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%AA%E0%A7%87%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%AC%E0%A7%88%E0%A6%AD%E0%A6%AC-%E0%A6%95%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%81-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A7%8B%E0%A6%B0-%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%B8%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%B8-%E0%A6%AA%E0%A7%87%E0%A6%A4%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/cricket/980095/%E0%A6%97%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%AA%E0%A7%87%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%AC%E0%A7%88%E0%A6%AD%E0%A6%AC-%E0%A6%95%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%81-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A7%8B%E0%A6%B0-%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%B8%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%B8-%E0%A6%AA%E0%A7%87%E0%A6%A4%E0%A7%87</guid>

    <item>
      <title>হৃদয় মনে করেন, ৩৫০ রানও তাড়া করা সম্ভব</title>
      <link>https://www.banglatribune.com/sport/cricket/979653/%E0%A6%B9%E0%A7%83%E0%A6%A6%E0%A7%9F-%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%95%E0%A6%B0%E0%A7%87%E0%A6%A8-%E0%A7%A9%E0%A7%AB%E0%A7%A6-%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A6%93-%E0%A6%A4%E0%A6%BE%E0%A7%9C%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%BE-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AD%E0%A6%AC</link>

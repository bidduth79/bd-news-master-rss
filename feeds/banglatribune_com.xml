    <item>
      <title>আফগানিস্তানে নারী রোগী দেখায় পুরুষ চিকিৎসকদের ওপর অঘোষিত নিষেধাজ্ঞা</title>
      <link>https://www.banglatribune.com/foreign/asia/980650/%E0%A6%86%E0%A6%AB%E0%A6%97%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%B0%E0%A7%8B%E0%A6%97%E0%A7%80-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%81%E0%A6%B7-%E0%A6%9A%E0%A6%BF%E0%A6%95%E0%A6%BF%E0%A7%8E%E0%A6%B8%E0%A6%95%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/asia/980650/%E0%A6%86%E0%A6%AB%E0%A6%97%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%B0%E0%A7%8B%E0%A6%97%E0%A7%80-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%81%E0%A6%B7-%E0%A6%9A%E0%A6%BF%E0%A6%95%E0%A6%BF%E0%A7%8E%E0%A6%B8%E0%A6%95%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0</guid>
      <pubDate>Fri, 13 Nov 2026 11:43:58 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/155c6f0811d31fdecbbf1a31e60d0647-6af6a3264f427.jpg?jadewits_media_id=1054758" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/155c6f0811d31fdecbbf1a31e60d0647-6af6a3264f427.jpg?jadewits_media_id=1054758" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/155c6f0811d31fdecbbf1a31e60d0647-6af6a3264f427.jpg?jadewits_media_id=1054758" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আফগানিস্তানে নারী রোগী দেখায় পুরুষ চিকিৎসকদের ওপর অঘোষিত নিষেধাজ্ঞা" /&gt;&lt;/p&gt;&lt;p&gt;হেরাতের ৩৭ বছর বয়সী ফরিদা (ছদ্মনাম) এক রাতে দাঁতের তীব্র ব্যথায় ঘুম থেকে জেগে ওঠেন। পরের কয়েক দিনে ব্যথা বাড়তে থাকে। তিনি বলেন, আমার দাঁত বছরের পর বছর ধরে নষ্ট ছিল। মুখের দুই পাশের মোলার দাঁত মারাত্মক ক্ষতিগ্রস্ত ছিল। রাতে ঘুমাতে পারতাম না, প্রায় কিছুই খেতে পারতাম না।
চলতি বছরের শুরুতে ইরান থেক&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/asia/980650/%E0%A6%86%E0%A6%AB%E0%A6%97%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%B0%E0%A7%8B%E0%A6%97%E0%A7%80-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%81%E0%A6%B7-%E0%A6%9A%E0%A6%BF%E0%A6%95%E0%A6%BF%E0%A7%8E%E0%A6%B8%E0%A6%95%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>শীতের আগমনী বার্তায়ও কমেনি সবজির দাম, চড়া মাছ-মাংসের বাজার</title>
      <link>https://www.banglatribune.com/business/news/980649/%E0%A6%B6%E0%A7%80%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A6%AE%E0%A6%A8%E0%A7%80-%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A7%9F%E0%A6%93-%E0%A6%95%E0%A6%AE%E0%A7%87%E0%A6%A8%E0%A6%BF-%E0%A6%B8%E0%A6%AC%E0%A6%9C%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE-%E0%A6%9A%E0%A7%9C%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/business/news/980649/%E0%A6%B6%E0%A7%80%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A6%AE%E0%A6%A8%E0%A7%80-%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A7%9F%E0%A6%93-%E0%A6%95%E0%A6%AE%E0%A7%87%E0%A6%A8%E0%A6%BF-%E0%A6%B8%E0%A6%AC%E0%A6%9C%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE-%E0%A6%9A%E0%A7%9C%E0%A6%BE</guid>
      <pubDate>Fri, 13 Nov 2026 11:31:53 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/de8489b963a62915901622589120fb6e-6af6a08d0cfa4.jpg?jadewits_media_id=1054757" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/de8489b963a62915901622589120fb6e-6af6a08d0cfa4.jpg?jadewits_media_id=1054757" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/de8489b963a62915901622589120fb6e-6af6a08d0cfa4.jpg?jadewits_media_id=1054757" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শীতের আগমনী বার্তায়ও কমেনি সবজির দাম, চড়া মাছ-মাংসের বাজার" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীতে শীতের আগমনী বার্তা পাওয়া গেলেও এখনও পুরোপুরি জেঁকে বসেনি শীত। সাধারণত শীতের আগমনের সঙ্গে বাজারে শীতকালীন সবজির সরবরাহ বাড়ে এবং দামও কমতে শুরু করে। তবে এবার এখনও সেই চিত্র দেখা যাচ্ছে না। রাজধানীর বাজারগুলোতে প্রায় সব ধরনের সবজি বিক্রি হচ্ছে চড়া দামে। শুধু সবজি নয়, মাছ, মাংস ও ডিমের বাজারেও&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/business/news/980649/%E0%A6%B6%E0%A7%80%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A6%AE%E0%A6%A8%E0%A7%80-%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A7%9F%E0%A6%93-%E0%A6%95%E0%A6%AE%E0%A7%87%E0%A6%A8%E0%A6%BF-%E0%A6%B8%E0%A6%AC%E0%A6%9C%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE-%E0%A6%9A%E0%A7%9C%E0%A6%BE">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>রাজনৈতিক বক্তব্য না দেওয়ার শর্তে আমির হামজার মাহফিলে সম্মতি</title>
      <link>https://www.banglatribune.com/country/khulna/980648/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A8%E0%A7%88%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%AC%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%AC%E0%A7%8D%E0%A6%AF-%E0%A6%A8%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%B6%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%AE%E0%A6%BF%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%9C%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/khulna/980648/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A8%E0%A7%88%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%AC%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%AC%E0%A7%8D%E0%A6%AF-%E0%A6%A8%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%B6%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%AE%E0%A6%BF%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%9C%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Fri, 13 Nov 2026 11:42:07 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/6d01d4259f85dc2aea9578b6277f67df-6af69f230def4.jpg?jadewits_media_id=1054756" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/6d01d4259f85dc2aea9578b6277f67df-6af69f230def4.jpg?jadewits_media_id=1054756" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/6d01d4259f85dc2aea9578b6277f67df-6af69f230def4.jpg?jadewits_media_id=1054756" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজনৈতিক বক্তব্য না দেওয়ার শর্তে আমির হামজার মাহফিলে সম্মতি" /&gt;&lt;/p&gt;&lt;p&gt;রাজনৈতিক বক্তব্য না দেওয়ার শর্তে ঝিনাইদহের কালীগঞ্জে সংসদ সদস্য মুফতি আমির হামজার তাফসিরুল কোরআন মাহফিল আয়োজন নিয়ে সমঝোতায় পৌঁছেছে উপজেলা বিএনপি ও জামায়াত। 
বৃহস্পতিবার (১২ নভেম্বর) রাত ১১টার দিকে কালীগঞ্জ থানায় অনুষ্ঠিত এক জরুরি বৈঠকে উপজেলা প্রশাসনের মধ্যস্থতায় এ সমঝোতা হয়।
বৈঠক শেষে ঝিনাইদহ-৪ আসন&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/khulna/980648/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A8%E0%A7%88%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%AC%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%AC%E0%A7%8D%E0%A6%AF-%E0%A6%A8%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%B6%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%AE%E0%A6%BF%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%9C%E0%A6%BE%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>এনভিডিয়া কেলেঙ্কারি: পদ হারাতে পারেন মার্কিন বাণিজ্যমন্ত্রী লুটনিক</title>
      <link>https://www.banglatribune.com/tech-and-gadget/980647/%E0%A6%8F%E0%A6%A8%E0%A6%AD%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE-%E0%A6%95%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%AA%E0%A6%A6-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/tech-and-gadget/980647/%E0%A6%8F%E0%A6%A8%E0%A6%AD%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE-%E0%A6%95%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%AA%E0%A6%A6-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8</guid>
      <pubDate>Fri, 13 Nov 2026 11:15:15 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/87ddf252f0bf98e823460ce274b1b99e-6af69c5182ce5.jpg?jadewits_media_id=1054755" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/87ddf252f0bf98e823460ce274b1b99e-6af69c5182ce5.jpg?jadewits_media_id=1054755" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/87ddf252f0bf98e823460ce274b1b99e-6af69c5182ce5.jpg?jadewits_media_id=1054755" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এনভিডিয়া কেলেঙ্কারি: পদ হারাতে পারেন মার্কিন বাণিজ্যমন্ত্রী লুটনিক" /&gt;&lt;/p&gt;&lt;p&gt;এনভিডিয়ার সাবেক প্রধান নির্বাহী জেনসেন হুয়াংকে ঘিরে গুপ্তচর কেলেঙ্কারির মধ্যে বাণিজ্যমন্ত্রী হাওয়ার্ড লুটনিককে সরিয়ে দেওয়া হবে কি না, তা নিয়ে আলোচনা করছেন হোয়াইট হাউসের জ্যেষ্ঠ কর্মকর্তারা। বিষয়টি সম্পর্কে অবগত দুজন ব্যক্তি বৃহস্পতিবার রয়টার্সকে এ তথ্য জানিয়েছেন।
যুক্তরাষ্ট্রের একটি গুরুত্&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/tech-and-gadget/980647/%E0%A6%8F%E0%A6%A8%E0%A6%AD%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE-%E0%A6%95%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%AA%E0%A6%A6-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8">বাংলা ট্রিবিউন</source>

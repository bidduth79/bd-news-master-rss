      <guid isPermaLink="true">https://www.banglatribune.com/country/sylhet/980787/%E0%A7%AD-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95-%E0%A6%B6%E0%A6%B0%E0%A7%8D%E0%A6%A4-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%96%E0%A7%8B%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%98%E0%A7%8B%E0%A6%B7%E0%A6%A3%E0%A6%BE-%E0%A6%AB%E0%A6%BF%E0%A6%A8%E0%A6%B2%E0%A7%87-%E0%A6%9A%E0%A6%BE</guid>
      <pubDate>Sat, 14 Nov 2026 01:15:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/0313975d1b298f3df15b71e2ad1caedd-6af75de0e64b5.jpg?jadewits_media_id=1054876" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/0313975d1b298f3df15b71e2ad1caedd-6af75de0e64b5.jpg?jadewits_media_id=1054876" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/0313975d1b298f3df15b71e2ad1caedd-6af75de0e64b5.jpg?jadewits_media_id=1054876" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৭ ঘণ্টার বৈঠক, শর্ত দিয়ে খোলার ঘোষণা ফিনলে চা কোম্পানির কারখানা" /&gt;&lt;/p&gt;&lt;p&gt;শ্রমিক অসন্তোষ ও উত্তেজনার জেরে অনির্দিষ্টকালের জন্য বন্ধ ঘোষিত মৌলভীবাজারের শ্রীমঙ্গলে ফিনলে টি কোম্পানির ডিনস্টন ডিভিশনের আওতাধীন খেজুরিছড়া চা-বাগান ও কারখানা অবশেষে খুলে দেওয়া হয়েছে।&amp;nbsp;
শুক্রবার (১৩ নভেম্বর) উপজেলা প্রশাসনের উদ্যোগে আয়োজিত দীর্ঘ সাত ঘণ্টার রুদ্ধশ্বাস বৈঠক শেষে বাগান কর্তৃপক&lt;/p&gt;</description>

    <item>
      <title>‘হামজাকে আটকে রাখাই ছিল আমাদের পরিকল্পনা’</title>
      <link>https://www.banglatribune.com/sport/football/980959/%E2%80%98%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%9C%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%86%E0%A6%9F%E0%A6%95%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%96%E0%A6%BE%E0%A6%87-%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%86%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A6%A8%E0%A6%BE%E2%80%99</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/football/980959/%E2%80%98%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%9C%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%86%E0%A6%9F%E0%A6%95%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%96%E0%A6%BE%E0%A6%87-%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%86%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A6%A8%E0%A6%BE%E2%80%99</guid>
      <pubDate>Sun, 15 Nov 2026 01:44:11 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/ee53f9ffabd336a97b9ac9f1a140b2ae-6af8b98b5db99.jpg?jadewits_media_id=1055027" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/ee53f9ffabd336a97b9ac9f1a140b2ae-6af8b98b5db99.jpg?jadewits_media_id=1055027" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/ee53f9ffabd336a97b9ac9f1a140b2ae-6af8b98b5db99.jpg?jadewits_media_id=1055027" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘হামজাকে আটকে রাখাই ছিল আমাদের পরিকল্পনা’" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশকে হারিয়ে সাফ চ্যাম্পিয়নশিপের ফাইনালে প্রথমবার উঠেছে পাকিস্তান। স্বাগতিকদের ১-০ গোলে হারানোর পর পাকিস্তানের কোচ নলবার্তো সোলানো জানিয়েছেন, বাংলাদেশের বিপক্ষে তাদের কৌশল ছিল হামজা দেওয়ান চৌধুরীকে আটকে রাখা। সেই পরিকল্পনা সফল হওয়াতেই সেমিফাইনালে জয় পেয়েছে তার দল।
শনিবার (১৪ নভেম্বর) দ্বিতীয় সে&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/football/980959/%E2%80%98%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%9C%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%86%E0%A6%9F%E0%A6%95%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%96%E0%A6%BE%E0%A6%87-%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%86%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A6%A8%E0%A6%BE%E2%80%99">বাংলা ট্রিবিউন</source>

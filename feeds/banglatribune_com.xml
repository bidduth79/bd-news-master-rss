      <guid isPermaLink="true">https://www.banglatribune.com/business/982337/%E0%A6%B6%E0%A6%A4%E0%A6%AD%E0%A6%BE%E0%A6%97-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%80%E0%A7%9F-%E0%A6%AA%E0%A6%A3%E0%A7%8D%E0%A6%AF-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A6%BE%E0%A6%B0%E0%A6%97%E0%A6%BE%E0%A6%81%E0%A6%93%E0%A7%9F%E0%A7%87-%E0%A6%8F%E0%A6%B8%E0%A6%8F%E0%A6%AE%E0%A6%87-%E0%A6%AA%E0%A6%A3%E0%A7%8D%E0%A6%AF%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%BE</guid>

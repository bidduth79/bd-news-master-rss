      <title>রাজধানীর হাসপাতালের সামনে ককটেল বিস্ফোরণ, পালানোর সময় আটক ৩</title>
      <link>https://www.banglatribune.com/others/capital-city/981406/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A7%8B%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/others/capital-city/981406/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A7%8B%E0%A6%B0</guid>
      <pubDate>Tue, 17 Nov 2026 02:00:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/e661f4c700f1ed4cc32f2327c103f4ad-6afb5a484f0b3.jpg?jadewits_media_id=1055387" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/e661f4c700f1ed4cc32f2327c103f4ad-6afb5a484f0b3.jpg?jadewits_media_id=1055387" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/e661f4c700f1ed4cc32f2327c103f4ad-6afb5a484f0b3.jpg?jadewits_media_id=1055387" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজধানীর হাসপাতালের সামনে ককটেল বিস্ফোরণ, পালানোর সময় আটক ৩" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর গুলশান থানার শাহজাদপুর পপুলার হাসপাতালের সামনে তিনটি ককটেল বিস্ফোরণের ঘটনা ঘটেছে। এ ঘটনার পর দৌড়ে পালিয়ে যাওয়ার সময় তিন জনকে আটক করেছে পুলিশ।
সোমবার (১৬ নভেম্বর) রাত ৯টার দিকে পপুলার হাসপাতালের সামনে এ ঘটনা ঘটে।
এ বিষয়ে জানতে চাইলে গুলশান থানার ওসি আবু জায়েদ মো. নাজমুন নুর বলেন, ককটেল&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/others/capital-city/981406/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A7%8B%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>জেলা পরিষদ প্রশাসককে ভিডিও কল দিয়ে আপত্তিকর ছবি প্রদর্শন</title>

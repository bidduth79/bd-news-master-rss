      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/85029aa44eba736516341c67e0e233c4-6af0a4e338a1c.jpg?jadewits_media_id=1053942" medium="image" />

      <guid isPermaLink="true">https://www.banglatribune.com/national/982058/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%B0%E0%A6%B9%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A7%AC%E0%A7%A8%E0%A6%A4%E0%A6%AE-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AE%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%86%E0%A6%9C</guid>
      <pubDate>Fri, 20 Nov 2026 00:03:09 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/09/26/a566d7f9003717df3a01cd4bf0acfb4e-6ab6fb45c22bc.jpg?jadewits_media_id=1045757" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/09/26/a566d7f9003717df3a01cd4bf0acfb4e-6ab6fb45c22bc.jpg?jadewits_media_id=1045757" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/09/26/a566d7f9003717df3a01cd4bf0acfb4e-6ab6fb45c22bc.jpg?jadewits_media_id=1045757" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রধানমন্ত্রী তারেক রহমানের ৬২তম জন্মদিন আজ" /&gt;&lt;/p&gt;&lt;p&gt;বিএনপির চেয়ারম্যান ও প্রধানমন্ত্রী তারেক রহমানের ৬২তম জন্মদিন আজ শুক্রবার। ১৯৬৫ সালের ২০ নভেম্বর তিনি জন্মগ্রহণ করেন। তিনি প্রয়াত রাষ্ট্রপতি জিয়াউর রহমান ও সাবেক প্রধানমন্ত্রী খালেদা জিয়ার বড় সন্তান। তার সহধর্মিণী ডা. জুবাইদা রহমান ও একমাত্র কন্যা ব্যরিস্টার জাইমা রহমান।
প্রধানমন্ত্রী তারেক রহমানের &lt;/p&gt;</description>

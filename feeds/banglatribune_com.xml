    <item>
      <title>শতাধিক মানুষের সাক্ষাৎকারে টেলর সুইফটের বিরুদ্ধে ‘অন্যকে হেয় করার’ অভিযোগ</title>
      <link>https://www.banglatribune.com/entertainment/hollywood/982997/%E0%A6%B6%E0%A6%A4%E0%A6%BE%E0%A6%A7%E0%A6%BF%E0%A6%95-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A7%8E%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%9F%E0%A7%87%E0%A6%B2%E0%A6%B0-%E0%A6%B8%E0%A7%81%E0%A6%87%E0%A6%AB%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/entertainment/hollywood/982997/%E0%A6%B6%E0%A6%A4%E0%A6%BE%E0%A6%A7%E0%A6%BF%E0%A6%95-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A7%8E%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%9F%E0%A7%87%E0%A6%B2%E0%A6%B0-%E0%A6%B8%E0%A7%81%E0%A6%87%E0%A6%AB%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87</guid>
      <pubDate>Wed, 25 Nov 2026 08:00:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/0280b6283e659b413942df3cb35d938d-6b05941c2529c.jpg?jadewits_media_id=1056738" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/0280b6283e659b413942df3cb35d938d-6b05941c2529c.jpg?jadewits_media_id=1056738" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/0280b6283e659b413942df3cb35d938d-6b05941c2529c.jpg?jadewits_media_id=1056738" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শতাধিক মানুষের সাক্ষাৎকারে টেলর সুইফটের বিরুদ্ধে ‘অন্যকে হেয় করার’ অভিযোগ" /&gt;&lt;/p&gt;&lt;p&gt;জনপ্রিয় মার্কিন সংগীতশিল্পী টেলর সুইফটকে নিয়ে প্রকাশিত একটি বিস্ফোরক প্রতিবেদন ঘিরে সরগরম আন্তর্জাতিক বিনোদন অঙ্গন। &amp;lsquo;অন্যকে হেয় করেন, আবার নিজেও ভুক্তভোগী&amp;rsquo;&amp;mdash;এমন একজন মানুষ হিসেবে তাকে তুলে ধরা হয়েছে প্রতিবেদনে। তবে এ প্রতিবেদনকে ঘিরে সামাজিক যোগাযোগমাধ্যমে শুরু হয়েছে বিতর্ক।
টেলরের &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/entertainment/hollywood/982997/%E0%A6%B6%E0%A6%A4%E0%A6%BE%E0%A6%A7%E0%A6%BF%E0%A6%95-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A7%8E%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%9F%E0%A7%87%E0%A6%B2%E0%A6%B0-%E0%A6%B8%E0%A7%81%E0%A6%87%E0%A6%AB%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>বাজারে ৯ মাসে ১০ হাজার অভিযান: তবু স্বস্তি নেই কেন</title>
      <link>https://www.banglatribune.com/business/982975/%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A7%AF-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A7%A7%E0%A7%A6-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A6%A4%E0%A6%AC%E0%A7%81-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%95%E0%A7%87%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/business/982975/%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A7%AF-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A7%A7%E0%A7%A6-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A6%A4%E0%A6%AC%E0%A7%81-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%95%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Wed, 25 Nov 2026 08:00:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2025/11/14/image_123650291-9-e3094ec0f70e919247f2396cb09ac7eb.JPG?jadewits_media_id=1000938" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2025/11/14/image_123650291-9-e3094ec0f70e919247f2396cb09ac7eb.JPG?jadewits_media_id=1000938" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2025/11/14/image_123650291-9-e3094ec0f70e919247f2396cb09ac7eb.JPG?jadewits_media_id=1000938" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাজারে ৯ মাসে ১০ হাজার অভিযান: তবু স্বস্তি নেই কেন" /&gt;&lt;/p&gt;&lt;p&gt;বাজারে ঢোকার আগে ক্রেতার হাতে থাকে পণ্যের তালিকা। ফেরার সময় হাতে থাকে হিসাব মেলানোর দুশ্চিন্তা। কোথাও শীতের সবজি ও পেঁয়াজের দাম কমেছে, কোথাও ভোজ্যতেল, চিনি কিংবা নিত্যব্যবহার্য অন্য পণ্যের দাম কমছে না। এর মধ্যেই বাজার নিয়ন্ত্রণে হাজার হাজার অভিযান চালিয়েছে সরকার। আদায় করা হয়েছে ১৫ কোটি টাকার বেশি জর&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/business/982975/%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A7%AF-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A7%A7%E0%A7%A6-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A6%A4%E0%A6%AC%E0%A7%81-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%95%E0%A7%87%E0%A6%A8">বাংলা ট্রিবিউন</source>

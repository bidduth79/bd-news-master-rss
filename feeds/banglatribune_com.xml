      <guid isPermaLink="true">https://www.banglatribune.com/country/dhaka/979993/%E0%A6%B2%E0%A6%97%E0%A6%BF-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AA%E0%A6%A6%E0%A7%8D%E0%A6%AE%E0%A6%BE-%E0%A6%B8%E0%A7%87%E0%A6%A4%E0%A7%81%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%9B%E0%A7%87-%E0%A6%85%E0%A6%AC%E0%A6%B0%E0%A7%8B%E0%A6%A7%E2%80%93%E0%A6%AD%E0%A6%BE%E0%A6%99%E0%A6%9A%E0%A7%81%E0%A6%B0-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2</guid>
      <pubDate>Tue, 10 Nov 2026 14:01:08 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/120cb4734d567ba7c1d6b17e01a14d12-6af2ced603c63.jpg?jadewits_media_id=1054189" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/120cb4734d567ba7c1d6b17e01a14d12-6af2ced603c63.jpg?jadewits_media_id=1054189" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/120cb4734d567ba7c1d6b17e01a14d12-6af2ced603c63.jpg?jadewits_media_id=1054189" style="max-width:100%;height:auto;margin-bottom:10px;" alt="লগি-বৈঠা নিয়ে পদ্মা সেতুর কাছে অবরোধ–ভাঙচুর, ককটেল বিস্ফোরণ" /&gt;&lt;/p&gt;&lt;p&gt;পদ্মা সেতুর জাজিরা প্রান্তের টোল প্লাজার সামনে লগি-বইঠা হাতে ঢাকা&amp;ndash;ভাঙ্গা এক্সপ্রেসওয়ে অবরোধ করে বিক্ষোভ করেছেন কার্যক্রম নিষিদ্ধ আওয়ামী লীগ ও ছাত্রলীগের নেতাকর্মীরা। এ সময় &amp;lsquo;জয় বাংলা&amp;rsquo;, &amp;lsquo;জয় বঙ্গবন্ধু&amp;rsquo;সহ বিভিন্ন স্লোগান দেন তারা। পাশাপাশি কয়েকটি ককটেল বিস্ফোরণ ও দুটি ট্রাক&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/dhaka/979993/%E0%A6%B2%E0%A6%97%E0%A6%BF-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AA%E0%A6%A6%E0%A7%8D%E0%A6%AE%E0%A6%BE-%E0%A6%B8%E0%A7%87%E0%A6%A4%E0%A7%81%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%9B%E0%A7%87-%E0%A6%85%E0%A6%AC%E0%A6%B0%E0%A7%8B%E0%A6%A7%E2%80%93%E0%A6%AD%E0%A6%BE%E0%A6%99%E0%A6%9A%E0%A7%81%E0%A6%B0-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>সিফাত হত্যা: শেখ হাসিনাসহ ২৬ জনের মামলায় অধিকতর প্রতিবেদন ১৪ ডিসেম্বর</title>
      <link>https://www.banglatribune.com/law-and-crime/979992/%E0%A6%B8%E0%A6%BF%E0%A6%AB%E0%A6%BE%E0%A6%A4-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B8%E0%A6%B9-%E0%A7%A8%E0%A7%AC-%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%85%E0%A6%A7%E0%A6%BF%E0%A6%95%E0%A6%A4%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/979992/%E0%A6%B8%E0%A6%BF%E0%A6%AB%E0%A6%BE%E0%A6%A4-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B8%E0%A6%B9-%E0%A7%A8%E0%A7%AC-%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%85%E0%A6%A7%E0%A6%BF%E0%A6%95%E0%A6%A4%E0%A6%B0</guid>
      <pubDate>Tue, 10 Nov 2026 13:52:43 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2024/08/14/Sheakh-Hasina-9e0864d1ccdfba89a67b293c364a71de.jpg?jadewits_media_id=930487" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2024/08/14/Sheakh-Hasina-9e0864d1ccdfba89a67b293c364a71de.jpg?jadewits_media_id=930487" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2024/08/14/Sheakh-Hasina-9e0864d1ccdfba89a67b293c364a71de.jpg?jadewits_media_id=930487" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সিফাত হত্যা: শেখ হাসিনাসহ ২৬ জনের মামলায় অধিকতর প্রতিবেদন ১৪ ডিসেম্বর" /&gt;&lt;/p&gt;&lt;p&gt;জুলাই আন্দোলনকে কেন্দ্র করে ঢাকার মিরপুর-১০ এলাকায় মো. সিফাত হোসেন (২৬) নামে এক যুবক নিহতের ঘটনায় করা মামলায় সাবেক প্রধানমন্ত্রী শেখ হাসিনাসহ ২৬ জনের বিরুদ্ধে অধিকতর তদন্ত প্রতিবেদনের তারিখ পিছিয়ে আগামী ১৪ ডিসেম্বর নির্ধারণ করেছেন আদালত।&amp;nbsp;
সোমবার (১০ নভেম্বর) মামলাটির অধিকতর তদন্ত প্রতিবেদন দাখি&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/979992/%E0%A6%B8%E0%A6%BF%E0%A6%AB%E0%A6%BE%E0%A6%A4-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B8%E0%A6%B9-%E0%A7%A8%E0%A7%AC-%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%85%E0%A6%A7%E0%A6%BF%E0%A6%95%E0%A6%A4%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>দিতির বাসায় পালিয়ে বিয়ে বাপ্পার, তারপর যা ঘটেছিল</title>
      <link>https://www.banglatribune.com/entertainment/dhallywood/979991/%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%AA%E0%A6%B0-%E0%A6%AF%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/entertainment/dhallywood/979991/%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%AA%E0%A6%B0-%E0%A6%AF%E0%A6%BE</guid>
      <pubDate>Tue, 10 Nov 2026 13:56:35 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/70868eee65a6e1d7b10aa289c8c7c124-6af2cbf8c40ad.jpg?jadewits_media_id=1054188" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/70868eee65a6e1d7b10aa289c8c7c124-6af2cbf8c40ad.jpg?jadewits_media_id=1054188" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/70868eee65a6e1d7b10aa289c8c7c124-6af2cbf8c40ad.jpg?jadewits_media_id=1054188" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দিতির বাসায় পালিয়ে বিয়ে বাপ্পার, তারপর যা ঘটেছিল" /&gt;&lt;/p&gt;&lt;p&gt;নায়করাজ রাজ্জাকের ছেলে বাপ্পারাজের প্রেম ও বিয়ে যেন ঠিক কোনও সিনেমার গল্প। ভালোবাসার মানুষটিকে নিজের করে চেয়েছিলেন তিনি। কিন্তু বাধা হয়ে দাঁড়ায় পরিবার। তবুও ভালোবাসার কাছে হার মানতে চাননি তারা।
এক সময় ভালোবাসার মানুষকে নিয়ে পালিয়ে আসেন অভিনেতা। এরপর দুজন আশ্রয় নেন প্রয়াত সোহেল চৌধুরী ও অভিনেত্রী দিত&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/entertainment/dhallywood/979991/%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%AA%E0%A6%B0-%E0%A6%AF%E0%A6%BE">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>‘প্রধানমন্ত্রী হওয়ার আকাঙ্ক্ষা ছিল প্রণবের’, আত্মজীবনীতে জানালেন সোনিয়া</title>
      <link>https://www.banglatribune.com/foreign/india/979990/%E2%80%98%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%B9%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%95%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A3%E0%A6%AC%E0%A7%87%E0%A6%B0%E2%80%99</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/india/979990/%E2%80%98%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%B9%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%95%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A3%E0%A6%AC%E0%A7%87%E0%A6%B0%E2%80%99</guid>
      <pubDate>Tue, 10 Nov 2026 13:45:04 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/bfa0fd2ded47ea1cd212b8d854ab3e53-6af2caa123e01.jpg?jadewits_media_id=1054186" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/bfa0fd2ded47ea1cd212b8d854ab3e53-6af2caa123e01.jpg?jadewits_media_id=1054186" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/bfa0fd2ded47ea1cd212b8d854ab3e53-6af2caa123e01.jpg?jadewits_media_id=1054186" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘প্রধানমন্ত্রী হওয়ার আকাঙ্ক্ষা ছিল প্রণবের’, আত্মজীবনীতে জানালেন সোনিয়া" /&gt;&lt;/p&gt;&lt;p&gt;ভারতের সাবেক রাষ্ট্রপতি প্রণব মুখার্জি প্রধানমন্ত্রী হওয়ার দীর্ঘদিনের আকাঙ্ক্ষার কথা একবার পরোক্ষভাবে জানিয়েছিলেন বলে দাবি করেছেন কংগ্রেসের সাবেক সভাপতি সোনিয়া গান্ধী। ২০১০ সালে তাদের এক কথোপকথনে প্রণব মুখার্জি নেতৃত্বে পরিবর্তনের সময় এসেছে বলে ইঙ্গিত দিয়েছিলেন। সোনিয়ার আত্মজীবনীতে উঠে এসেছে এ তথ্য।&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/india/979990/%E2%80%98%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%B9%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%95%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A3%E0%A6%AC%E0%A7%87%E0%A6%B0%E2%80%99">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>গোপালগঞ্জে পুলিশের গাড়িতে আগুন, ছাত্রলীগ-যুবলীগের সঙ্গে ধাওয়া-পাল্টাধাওয়া</title>
      <link>https://www.banglatribune.com/country/dhaka/979989/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/dhaka/979989/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Tue, 10 Nov 2026 13:54:23 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/61772aabe78870eb7aaaff8268eaccf5-6af2cb16a48f6.jpg?jadewits_media_id=1054187" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/61772aabe78870eb7aaaff8268eaccf5-6af2cb16a48f6.jpg?jadewits_media_id=1054187" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/61772aabe78870eb7aaaff8268eaccf5-6af2cb16a48f6.jpg?jadewits_media_id=1054187" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গোপালগঞ্জে পুলিশের গাড়িতে আগুন, ছাত্রলীগ-যুবলীগের সঙ্গে ধাওয়া-পাল্টাধাওয়া" /&gt;&lt;/p&gt;&lt;p&gt;কার্যক্রম নিষিদ্ধ আওয়ামী লীগের ডাকা দেশব্যাপী ধর্মঘটের কর্মসূচিকে ঘিরে গোপালগঞ্জের টুঙ্গিপাড়ায় বিক্ষোভ করেছেন নিষিদ্ধ ছাত্রলীগ ও যুবলীগের নেতাকর্মীরা। এ সময় পুলিশের সঙ্গে তাদের কয়েক দফা ধাওয়া-পাল্টাধাওয়ার ঘটনা ঘটে। একপর্যায়ে পুলিশের একটি গাড়িতে আগুন দেওয়ার পাশাপাশি উপজেলা বিএনপি কার্যালয় ভাঙচুর করেন&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/dhaka/979989/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0">বাংলা ট্রিবিউন</source>

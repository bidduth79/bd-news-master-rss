    <item>
      <title>রমজানে নিত্যপণ্যের দাম স্থিতিশীল থাকবে: বাণিজ্যমন্ত্রী</title>
      <link>https://www.banglatribune.com/business/983676/%E0%A6%B0%E0%A6%AE%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%AA%E0%A6%A3%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BF%E0%A6%A4%E0%A6%BF%E0%A6%B6%E0%A7%80%E0%A6%B2-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%AC%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/business/983676/%E0%A6%B0%E0%A6%AE%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%AA%E0%A6%A3%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BF%E0%A6%A4%E0%A6%BF%E0%A6%B6%E0%A7%80%E0%A6%B2-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%AC%E0%A7%87</guid>
      <pubDate>Fri, 27 Nov 2026 21:58:03 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/ce01d379b2ea3977be5862ff3f7138c2-6b09a81e44ae2.jpg?jadewits_media_id=1057344" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/ce01d379b2ea3977be5862ff3f7138c2-6b09a81e44ae2.jpg?jadewits_media_id=1057344" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/ce01d379b2ea3977be5862ff3f7138c2-6b09a81e44ae2.jpg?jadewits_media_id=1057344" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রমজানে নিত্যপণ্যের দাম স্থিতিশীল থাকবে: বাণিজ্যমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;বাণিজ্য ও পাটমন্ত্রী খন্দকার আব্দুল মুক্তাদির বলেছেন, আসন্ন রমজানে নিত্যপ্রয়োজনীয় পণ্যের সরবরাহ পরিস্থিতি ভালো রয়েছে। ফলে বাজারে পণ্যের দাম স্থিতিশীল থাকবে বলে সরকার আশাবাদী।
শুক্রবার (২৭ নভেম্বর) সন্ধ্যায় সিলেট জেলা পরিষদ মিলনায়তনে এক সভা শেষে সাংবাদিকদের প্রশ্নের জবাবে এ সব কথা বলেন তিনি।
ভোজ্যতেল&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/business/983676/%E0%A6%B0%E0%A6%AE%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%AA%E0%A6%A3%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BF%E0%A6%A4%E0%A6%BF%E0%A6%B6%E0%A7%80%E0%A6%B2-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%AC%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ইলিশ সংরক্ষণের পাশাপাশি জেলেদের জীবিকা সুরক্ষায় গুরুত্ব দিতে হবে: প্রাণিসম্পদ মন্ত্রী</title>
      <link>https://www.banglatribune.com/national/983672/%E0%A6%87%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%B8%E0%A6%82%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%BE%E0%A6%B6%E0%A6%BE%E0%A6%AA%E0%A6%BE%E0%A6%B6%E0%A6%BF-%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A7%80%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A6%BE-%E0%A6%B8%E0%A7%81%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A7%9F</link>
      <guid isPermaLink="true">https://www.banglatribune.com/national/983672/%E0%A6%87%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%B8%E0%A6%82%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%BE%E0%A6%B6%E0%A6%BE%E0%A6%AA%E0%A6%BE%E0%A6%B6%E0%A6%BF-%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A7%80%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A6%BE-%E0%A6%B8%E0%A7%81%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A7%9F</guid>
      <pubDate>Fri, 27 Nov 2026 21:46:35 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/a5a3ad3a2545825b8279ded48790ac0b-6b09a5219e22e.jpg?jadewits_media_id=1057341" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/a5a3ad3a2545825b8279ded48790ac0b-6b09a5219e22e.jpg?jadewits_media_id=1057341" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/a5a3ad3a2545825b8279ded48790ac0b-6b09a5219e22e.jpg?jadewits_media_id=1057341" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইলিশ সংরক্ষণের পাশাপাশি জেলেদের জীবিকা সুরক্ষায় গুরুত্ব দিতে হবে: প্রাণিসম্পদ মন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;মৎস্য ও প্রাণিসম্পদ এবং কৃষিমন্ত্রী মোহাম্মদ আমিন উর রশিদ বলেছেন, ইলিশ সংরক্ষণের উদ্যোগে মাছের পাশাপাশি জেলেদের জীবিকা, মর্যাদা ও ভবিষ্যৎ সুরক্ষাকে সমান গুরুত্ব দিতে হবে।
তিনি বলেন, ইলিশ বাংলাদেশের জাতীয় পরিচয়, ঐতিহ্য ও খাদ্যসংস্কৃতির অবিচ্ছেদ্য অংশ। এটি দেশের অর্থনীতি এবং অসংখ্য মানুষের জীবিকা, খাদ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/983672/%E0%A6%87%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%B8%E0%A6%82%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%BE%E0%A6%B6%E0%A6%BE%E0%A6%AA%E0%A6%BE%E0%A6%B6%E0%A6%BF-%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A7%80%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A6%BE-%E0%A6%B8%E0%A7%81%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A7%9F">বাংলা ট্রিবিউন</source>

      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/50d1e4ef0b87db14942905918ae74bbe-6af747bac7faa.jpg?jadewits_media_id=1054870" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজধানীতে মিছিলের প্রস্তুতির সময় নিষিদ্ধ ছাত্রলীগের দুই সদস্য গ্রেফতার" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর তুরাগে মিছিলের প্রস্তুতির সময় নিষিদ্ধঘোষিত সংগঠন ছাত্রলীগের দুই সদস্যকে গ্রেফতার করেছে তুরাগ থানা পুলিশ। তারা হলো মো. ইয়াসিন (২০) ও মো. রিফাত (২০)।
তুরাগ থানা পুু&amp;zwnj;লি&amp;zwnj;শের বরাত দি&amp;zwnj;য়ে ডিএম&amp;zwnj;পির ডি&amp;zwnj;সি (মি&amp;zwnj;ডিয়া) মো. আকতার হো&amp;zwnj;সেন জানান, শুক্রবার (১৩ নভেম্বর) জু&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/980782/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%81%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A7%9F-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>সাত দিন ধরে হত্যার হুমকি পাচ্ছি: মাহমুদা মিতু</title>
      <link>https://www.banglatribune.com/politics/ncp/980781/%E0%A6%B8%E0%A6%BE%E0%A6%A4-%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%A7%E0%A6%B0%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%95%E0%A6%BF-%E0%A6%AA%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A6%BF-%E0%A6%AE%E0%A6%BE%E0%A6%B9%E0%A6%AE%E0%A7%81%E0%A6%A6%E0%A6%BE-%E0%A6%AE%E0%A6%BF%E0%A6%A4%E0%A7%81</link>
      <guid isPermaLink="true">https://www.banglatribune.com/politics/ncp/980781/%E0%A6%B8%E0%A6%BE%E0%A6%A4-%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%A7%E0%A6%B0%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%95%E0%A6%BF-%E0%A6%AA%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A6%BF-%E0%A6%AE%E0%A6%BE%E0%A6%B9%E0%A6%AE%E0%A7%81%E0%A6%A6%E0%A6%BE-%E0%A6%AE%E0%A6%BF%E0%A6%A4%E0%A7%81</guid>
      <pubDate>Fri, 13 Nov 2026 23:11:09 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/047c73dd89a7b5d0beee26071ad5d85a-6af7447a1ff04.jpg?jadewits_media_id=1054869" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/047c73dd89a7b5d0beee26071ad5d85a-6af7447a1ff04.jpg?jadewits_media_id=1054869" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/047c73dd89a7b5d0beee26071ad5d85a-6af7447a1ff04.jpg?jadewits_media_id=1054869" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাত দিন ধরে হত্যার হুমকি পাচ্ছি: মাহমুদা মিতু" /&gt;&lt;/p&gt;&lt;p&gt;সাতদিন ধরে ফোনে ও হোয়াটসঅ্যাপে হত্যার হুমকি পাচ্ছেন বলে অভিযোগ করেছেন জাতীয় নাগরিক পার্টির (এনসিপি) রাজনৈতিক পর্ষদের সদস্য ও সংসদ সদস্য ডা. মাহমুদা মিতু। শুক্রবার (১৩ নভেম্বর) সন্ধ্যায় নিজের ভেরিফায়েড ফেসবুক আইডিতে দেওয়া এক পোস্টে এই অভিযোগ করেন তিনি।
পোস্ট তিনি লেখেন, বৃহস্পতিবার (১২ নভেম্বর) সংসদে&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/politics/ncp/980781/%E0%A6%B8%E0%A6%BE%E0%A6%A4-%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%A7%E0%A6%B0%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%95%E0%A6%BF-%E0%A6%AA%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A6%BF-%E0%A6%AE%E0%A6%BE%E0%A6%B9%E0%A6%AE%E0%A7%81%E0%A6%A6%E0%A6%BE-%E0%A6%AE%E0%A6%BF%E0%A6%A4%E0%A7%81">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>প্রথমবার মিললো ‘ডার্ক ম্যাজিক মাশরুম’</title>
      <link>https://www.banglatribune.com/foreign/america/980780/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2%E0%A7%8B-%E2%80%98%E0%A6%A1%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95-%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9C%E0%A6%BF%E0%A6%95-%E0%A6%AE%E0%A6%BE%E0%A6%B6%E0%A6%B0%E0%A7%81%E0%A6%AE%E2%80%99</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/america/980780/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2%E0%A7%8B-%E2%80%98%E0%A6%A1%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95-%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9C%E0%A6%BF%E0%A6%95-%E0%A6%AE%E0%A6%BE%E0%A6%B6%E0%A6%B0%E0%A7%81%E0%A6%AE%E2%80%99</guid>
      <pubDate>Fri, 13 Nov 2026 23:01:46 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/95c3e4ab46b512d19d113a36ab7f9c55-6af742109600e.jpg?jadewits_media_id=1054868" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/95c3e4ab46b512d19d113a36ab7f9c55-6af742109600e.jpg?jadewits_media_id=1054868" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/95c3e4ab46b512d19d113a36ab7f9c55-6af742109600e.jpg?jadewits_media_id=1054868" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রথমবার মিললো ‘ডার্ক ম্যাজিক মাশরুম’" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাষ্ট্রের ফ্লোরিডায় বিশ্বের প্রথম ডার্ক ম্যাজিক মাশরুম বা ভেষজ ছত্রাকের সন্ধান পাওয়া গেছে, যা একই সঙ্গে হ্যালুসিনেশন এবং মৃত্যুর কারণ হতে পারে। বৈজ্ঞানিক জার্নাল কারেন্ট বায়োলজি-তে প্রকাশিত গবেষণায় মাইকোলজিস্টরা জানিয়েছেন, গ্যালেরিনা ইন্ডিকা নামের এই প্রজাতিটি বিশ্বজুড়ে প্রথম যার মধ্যে সাইকেডে&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/america/980780/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2%E0%A7%8B-%E2%80%98%E0%A6%A1%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95-%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9C%E0%A6%BF%E0%A6%95-%E0%A6%AE%E0%A6%BE%E0%A6%B6%E0%A6%B0%E0%A7%81%E0%A6%AE%E2%80%99">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>সংসদ সচিবালয়ে ১৫৫ পদে নিয়োগ</title>
      <link>https://www.banglatribune.com/jobs/980779/%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6-%E0%A6%B8%E0%A6%9A%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87-%E0%A7%A7%E0%A7%AB%E0%A7%AB-%E0%A6%AA%E0%A6%A6%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%8B%E0%A6%97</link>
      <guid isPermaLink="true">https://www.banglatribune.com/jobs/980779/%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6-%E0%A6%B8%E0%A6%9A%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87-%E0%A7%A7%E0%A7%AB%E0%A7%AB-%E0%A6%AA%E0%A6%A6%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%8B%E0%A6%97</guid>
      <pubDate>Fri, 13 Nov 2026 22:59:34 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/ed0faf0bf57cdb187801b2ee52964861-6af7419120254.jpg?jadewits_media_id=1054867" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/ed0faf0bf57cdb187801b2ee52964861-6af7419120254.jpg?jadewits_media_id=1054867" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/ed0faf0bf57cdb187801b2ee52964861-6af7419120254.jpg?jadewits_media_id=1054867" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সংসদ সচিবালয়ে ১৫৫ পদে নিয়োগ" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ জাতীয় সংসদ সচিবালয়ে ১১ থেকে ২০তম গ্রেডে ২৮ ধরনের পদে ১৫৫ জনকে নিয়োগ দেওয়া হবে। এ নিয়োগের বিজ্ঞপ্তি প্রকাশ করেছে জাতীয় সংসদ সচিবালয়। আগ্রহী প্রার্থীদের অনলাইনে আবেদন করতে হবে। আবেদন শুরু হয়েছে ১২ নভেম্বর থেকে। চলবে আগামী ২ ডিসেম্বর পর্যন্ত।
যেসব পদে নিয়োগ
নিয়োগ বিজ্ঞপ্তি অনুযায়ী, গাইড পদে এক&lt;/p&gt;</description>

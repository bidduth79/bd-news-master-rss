      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/913ad01ca0ac6eec7b4ea7fe78f54198-6b0930b90cf97.jpg?jadewits_media_id=1057208" length="0" type="image/jpeg" />

      <pubDate>Wed, 11 Nov 2026 06:00:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/05/9e6d2e18d5efe6da7a4203eca889db70-6aeca94a1603a.jpg?jadewits_media_id=1053374" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/05/9e6d2e18d5efe6da7a4203eca889db70-6aeca94a1603a.jpg?jadewits_media_id=1053374" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/05/9e6d2e18d5efe6da7a4203eca889db70-6aeca94a1603a.jpg?jadewits_media_id=1053374" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টিভিতে আজকের খেলা (১১ নভেম্বর, ২০২৬)" /&gt;&lt;/p&gt;&lt;p&gt;&amp;nbsp;
&amp;nbsp;
&amp;nbsp;
&amp;nbsp;
&amp;nbsp;
প্রতিদিনের মতো আজও টেলিভিশনের পর্দায় থাকছে বিভিন্ন খেলা। দেশের ও আন্তর্জাতিক অঙ্গনের এসব ম্যাচের মধ্যে কোনগুলো কখন, কোন চ্যানেলে সরাসরি দেখা যাবে&amp;mdash;চলুন জেনে নেওয়া যাক আজকের টিভিতে খেলার সূচি।
ক্রিকেটশ্রীলঙ্কা-পাকিস্তানপ্রথম টেস্ট, তৃতীয় দিনসরাসরি, সকাল ১০-৩০ ম&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/other-sports/980099/%E0%A6%9F%E0%A6%BF%E0%A6%AD%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%9C%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A6%BE-%E0%A7%A7%E0%A7%A7-%E0%A6%A8%E0%A6%AD%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A7%A8%E0%A7%A6%E0%A7%A8%E0%A7%AC">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>যুবলীগ নেতাকে ছাড়াতে তদবির, ছাত্রদল নেতা বহিষ্কার</title>
      <link>https://www.banglatribune.com/country/chitagong/980153/%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%A4%E0%A6%A6%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%97%E0%A6%BF%E0%A7%9F%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/chitagong/980153/%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%A4%E0%A6%A6%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%97%E0%A6%BF%E0%A7%9F%E0%A7%87</guid>
      <pubDate>Wed, 11 Nov 2026 06:21:40 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/42f4a38f44a2435322339a52ebe741fe-6af38aa3f321c.jpg?jadewits_media_id=1054331" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/42f4a38f44a2435322339a52ebe741fe-6af38aa3f321c.jpg?jadewits_media_id=1054331" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/42f4a38f44a2435322339a52ebe741fe-6af38aa3f321c.jpg?jadewits_media_id=1054331" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যুবলীগ নেতাকে ছাড়াতে তদবির, ছাত্রদল নেতা বহিষ্কার" /&gt;&lt;/p&gt;&lt;p&gt;কুমিল্লার ব্রাহ্মণপাড়া উপজেলা ছাত্রদলের সদস্যসচিব ফয়সাল কবির আখন্দকে স্থায়ীভাবে বহিষ্কার করা হয়েছে। মঙ্গলবার (১১ নভেম্বর) কেন্দ্রীয় ছাত্রদল তাকে বহিষ্কার করে। গ্রেফতার এক যুবলীগ নেতাকে ছাড়িয়ে নিতে থানার ভারপ্রাপ্ত কর্মকর্তার (ওসি) কক্ষে গিয়ে তদবির করার অভিযোগে তাকে বহিষ্কার করা হয় বলে জানা গেছে।   ছ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/chitagong/980153/%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%A4%E0%A6%A6%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%97%E0%A6%BF%E0%A7%9F%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>কার্বারী অ্যাসোসিয়েন বিলুপ্ত, সাজেকের অবরোধ প্রত্যাহার ঘোষণা</title>
      <link>https://www.banglatribune.com/country/chitagong/980152/%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B8%E0%A7%8B%E0%A6%B8%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%A8-%E0%A6%AC%E0%A6%BF%E0%A6%B2%E0%A7%81%E0%A6%AA%E0%A7%8D%E0%A6%A4-%E0%A6%B8%E0%A6%BE%E0%A6%9C%E0%A7%87%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AC%E0%A6%B0%E0%A7%8B%E0%A6%A7</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/chitagong/980152/%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B8%E0%A7%8B%E0%A6%B8%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%A8-%E0%A6%AC%E0%A6%BF%E0%A6%B2%E0%A7%81%E0%A6%AA%E0%A7%8D%E0%A6%A4-%E0%A6%B8%E0%A6%BE%E0%A6%9C%E0%A7%87%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AC%E0%A6%B0%E0%A7%8B%E0%A6%A7</guid>
      <pubDate>Wed, 11 Nov 2026 02:57:39 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/d705944489bc7bf5a73430e47d477b1c-6af3848066cb9.jpg?jadewits_media_id=1054330" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/d705944489bc7bf5a73430e47d477b1c-6af3848066cb9.jpg?jadewits_media_id=1054330" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/d705944489bc7bf5a73430e47d477b1c-6af3848066cb9.jpg?jadewits_media_id=1054330" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কার্বারী অ্যাসোসিয়েন বিলুপ্ত, সাজেকের অবরোধ প্রত্যাহার ঘোষণা" /&gt;&lt;/p&gt;&lt;p&gt;সাজেক কার্বারী অ্যাসোসিয়েশনের সভাপতি পদ থেকে পদত্যাগ করে সংগঠনটির কমিটি বিলুপ্ত ঘোষণা করেছেন সংগঠনটির সভাপতি নতুন জয় চাকমা। মঙ্গলবার রাতে এক ভিডিও বার্তায় তিনি এ ঘোষণা দেন।&amp;nbsp;
তবে, ৭ নভেম্বর গঠিত সাজেক পর্যটন সড়ক অবরোধ বাস্তবায়ন গণকমিটির অবরোধ চলমান থাকবে বলে জানিয়েছেন কমিটির সদস্য সচিব বিজয় কান্&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/chitagong/980152/%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B8%E0%A7%8B%E0%A6%B8%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%A8-%E0%A6%AC%E0%A6%BF%E0%A6%B2%E0%A7%81%E0%A6%AA%E0%A7%8D%E0%A6%A4-%E0%A6%B8%E0%A6%BE%E0%A6%9C%E0%A7%87%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AC%E0%A6%B0%E0%A7%8B%E0%A6%A7">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>যুবলীগের ঝটিকা মিছিল থেকে পুলিশের ওপর হামলা, দায়ের কোপে এসআই আহত</title>

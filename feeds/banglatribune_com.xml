      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/ed67d9a4f8998adfa8f2c4dfab6983ae-6b0a9c7fef967.jpg?jadewits_media_id=1057452" medium="image" />

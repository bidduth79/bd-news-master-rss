      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/09/05/2602b9da0b54ea106a006e692b072bb4-6a9bff3bc27a6.jpg?jadewits_media_id=1042100" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/09/05/2602b9da0b54ea106a006e692b072bb4-6a9bff3bc27a6.jpg?jadewits_media_id=1042100" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘একঘরে’ হওয়ার পথে ইসরায়েল, বলছেন খোদ কুশনার" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাষ্ট্রের প্রেসিডেন্ট ডোনাল্ড ট্রাম্পের জামাতা ও কূটনৈতিক দূত জ্যারেড কুশনার বলেছেন, গাজায় গণহত্যার কারণে ইসরায়েল বিশ্বে একঘরে হওয়ার পথে। সোমবার প্রকাশিত নিউ ইয়র্ক ম্যাগাজিনকে দেওয়া সাক্ষাৎকারে তিনি বলেন, ইসরায়েল ৭ অক্টোবরের ট্র্যাজেডি থেকে উঠে দাঁড়িয়ে আরও নিরাপদ ও বিশ্বের সঙ্গে আরও সম্&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/middle-east/983200/%E2%80%98%E0%A6%8F%E0%A6%95%E0%A6%98%E0%A6%B0%E0%A7%87%E2%80%99-%E0%A6%B9%E0%A6%93%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%B2%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%96%E0%A7%8B%E0%A6%A6-%E0%A6%95%E0%A7%81%E0%A6%B6%E0%A6%A8%E0%A6%BE%E0%A6%B0">বাংলা ট্রিবিউন</source>

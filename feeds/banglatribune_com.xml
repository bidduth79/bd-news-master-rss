    <item>
      <title>শেখ হাসিনার সাবেক উপ-প্রেস সচিব শাখাওয়াতকে আটক করে পুলিশে দিলো ছাত্রদল</title>
      <link>https://www.banglatribune.com/law-and-crime/983285/%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%89%E0%A6%AA-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B8-%E0%A6%B8%E0%A6%9A%E0%A6%BF%E0%A6%AC-%E0%A6%B6%E0%A6%BE%E0%A6%96%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%A4%E0%A6%95%E0%A7%87-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A6%95%E0%A6%B0%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/983285/%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%89%E0%A6%AA-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B8-%E0%A6%B8%E0%A6%9A%E0%A6%BF%E0%A6%AC-%E0%A6%B6%E0%A6%BE%E0%A6%96%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%A4%E0%A6%95%E0%A7%87-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A6%95%E0%A6%B0%E0%A7%87</guid>
      <pubDate>Thu, 26 Nov 2026 03:49:24 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/fa80087efcf6c7847a389cfc8b91c7a8-6b0756295ae4e.jpg?jadewits_media_id=1056970" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/fa80087efcf6c7847a389cfc8b91c7a8-6b0756295ae4e.jpg?jadewits_media_id=1056970" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/fa80087efcf6c7847a389cfc8b91c7a8-6b0756295ae4e.jpg?jadewits_media_id=1056970" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শেখ হাসিনার সাবেক উপ-প্রেস সচিব শাখাওয়াতকে আটক করে পুলিশে দিলো ছাত্রদল" /&gt;&lt;/p&gt;&lt;p&gt;জুলাই আন্দোল&amp;zwnj;নে ক্ষমতাচ্যুত প্রধানমন্ত্রী শেখ হাসিনার সাবেক উপ-প্রেস সচিব কে এম শাখাওয়াতকে আটকের পর পু&amp;zwnj;লি&amp;zwnj;শের হা&amp;zwnj;তে তু&amp;zwnj;লে দি&amp;zwnj;য়ে&amp;zwnj;ছেন ছাত্রদলের নেতা-কর্মীরা। &amp;nbsp;
বুধবার (২৫ ন&amp;zwnj;ভেম্বর) দিবাগত রাত একটার দিকে রাজধানীর ধানমন্ডি-২৭ নম্বর এলাকা থেকে শাখাওয়াতকে আটক &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/983285/%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%89%E0%A6%AA-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B8-%E0%A6%B8%E0%A6%9A%E0%A6%BF%E0%A6%AC-%E0%A6%B6%E0%A6%BE%E0%A6%96%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%A4%E0%A6%95%E0%A7%87-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A6%95%E0%A6%B0%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>টিকটকে পরিচয়, বিয়ের আশ্বাসে কিশোরীকে ধর্ষণের অভিযোগে চীনা নাগরিক গ্রেফতার</title>
      <link>https://www.banglatribune.com/country/dhaka/983277/%E0%A6%9F%E0%A6%BF%E0%A6%95%E0%A6%9F%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%9A%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%95%E0%A6%BF%E0%A6%B6%E0%A7%8B%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%8F%E0%A6%A8%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/dhaka/983277/%E0%A6%9F%E0%A6%BF%E0%A6%95%E0%A6%9F%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%9A%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%95%E0%A6%BF%E0%A6%B6%E0%A7%8B%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%8F%E0%A6%A8%E0%A7%87</guid>
      <pubDate>Thu, 26 Nov 2026 03:07:28 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/d783c10c0a78ee18c4d268dfb42566fb-6b074ad90ff6b.jpg?jadewits_media_id=1056957" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/d783c10c0a78ee18c4d268dfb42566fb-6b074ad90ff6b.jpg?jadewits_media_id=1056957" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/d783c10c0a78ee18c4d268dfb42566fb-6b074ad90ff6b.jpg?jadewits_media_id=1056957" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টিকটকে পরিচয়, বিয়ের আশ্বাসে কিশোরীকে ধর্ষণের অভিযোগে চীনা নাগরিক গ্রেফতার" /&gt;&lt;/p&gt;&lt;p&gt;টিকটকে পরিচয়ের সূত্র ধরে বিয়ের আশ্বাস দিয়ে মানিকগঞ্জের এক কিশোরীকে ঢাকায় নিয়ে একটি বাসায় আটকে রেখে একাধিকবার ধর্ষণের অভিযোগ উঠেছে চীনা নাগরিক চেন ইয়ংয়ের (৪১) বিরুদ্ধে। নিখোঁজের ছয় দিন পর মঙ্গলবার রাতে রাজধানীর উত্তরার একটি ভাড়া বাসা থেকে ওই কিশোরীকে উদ্ধার করেছে মানিকগঞ্জ সদর থানা-পুলিশ। এ ঘটনায় অভি&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/dhaka/983277/%E0%A6%9F%E0%A6%BF%E0%A6%95%E0%A6%9F%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%9A%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%95%E0%A6%BF%E0%A6%B6%E0%A7%8B%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%8F%E0%A6%A8%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>গর্ডনের জোড়া গোলে সাবাহকে উড়িয়ে দিলো বার্সেলোনা</title>
      <link>https://www.banglatribune.com/sport/football/983276/%E0%A6%97%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A7%8B%E0%A7%9C%E0%A6%BE-%E0%A6%97%E0%A7%8B%E0%A6%B2%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%95%E0%A7%87-%E0%A6%89%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%8B-%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B8%E0%A7%87%E0%A6%B2%E0%A7%8B%E0%A6%A8%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/football/983276/%E0%A6%97%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A7%8B%E0%A7%9C%E0%A6%BE-%E0%A6%97%E0%A7%8B%E0%A6%B2%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%95%E0%A7%87-%E0%A6%89%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%8B-%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B8%E0%A7%87%E0%A6%B2%E0%A7%8B%E0%A6%A8%E0%A6%BE</guid>
      <pubDate>Thu, 26 Nov 2026 02:12:15 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/81a5e171841caaf0fa2a12688da03a1d-6b0740693671f.jpg?jadewits_media_id=1056956" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/81a5e171841caaf0fa2a12688da03a1d-6b0740693671f.jpg?jadewits_media_id=1056956" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/81a5e171841caaf0fa2a12688da03a1d-6b0740693671f.jpg?jadewits_media_id=1056956" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গর্ডনের জোড়া গোলে সাবাহকে উড়িয়ে দিলো বার্সেলোনা" /&gt;&lt;/p&gt;&lt;p&gt;চ্যাম্পিয়ন্স লিগে দাপুটে জয় পেয়েছে বার্সেলোনা। আজারবাইজানের ক্লাব সাবাহ এফসিকে ৪-১ গোলে হারিয়েছে স্প্যানিশ জায়ান্টরা। জয়ের পথে জোড়া গোল করেছেন ইংল্যান্ডের উইঙ্গার অ্যান্থনি গর্ডন।
খেলার ৩০ মিনিট পেরিয়ে যাওয়ার পর করিম আদেয়েমির ক্রস সাবাহ গোলরক্ষক স্তাস পোকাতিলভের হাত ফসকে সামনে এলে ট্যাপ-ইনে গোল করে &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/football/983276/%E0%A6%97%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A7%8B%E0%A7%9C%E0%A6%BE-%E0%A6%97%E0%A7%8B%E0%A6%B2%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%95%E0%A7%87-%E0%A6%89%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%8B-%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B8%E0%A7%87%E0%A6%B2%E0%A7%8B%E0%A6%A8%E0%A6%BE">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>স্পেনে অভিবাসীর ঢল, এক দিনেই এলেন প্রায় ২ হাজার</title>
      <link>https://www.banglatribune.com/foreign/europe/983275/%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A7%87%E0%A6%A8%E0%A7%87-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%80%E0%A6%B0-%E0%A6%A2%E0%A6%B2-%E0%A6%8F%E0%A6%95-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%8F%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A7%A8-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/europe/983275/%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A7%87%E0%A6%A8%E0%A7%87-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%80%E0%A6%B0-%E0%A6%A2%E0%A6%B2-%E0%A6%8F%E0%A6%95-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%8F%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A7%A8-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Thu, 26 Nov 2026 01:34:30 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/96abdb27efcd08eccf791c9d8e9d8104-6b0737a19cac9.jpg?jadewits_media_id=1056955" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/96abdb27efcd08eccf791c9d8e9d8104-6b0737a19cac9.jpg?jadewits_media_id=1056955" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/96abdb27efcd08eccf791c9d8e9d8104-6b0737a19cac9.jpg?jadewits_media_id=1056955" style="max-width:100%;height:auto;margin-bottom:10px;" alt="স্পেনে অভিবাসীর ঢল, এক দিনেই এলেন প্রায় ২ হাজার" /&gt;&lt;/p&gt;&lt;p&gt;স্পেনের ক্যানারি দ্বীপপুঞ্জে মঙ্গলবার একদিনে প্রায় ২ হাজার অভিবাসী পৌঁছেছেন। দ্বীপপুঞ্জটিতে একদিনে অভিবাসী আগমনের ক্ষেত্রে এটিই সর্বোচ্চ রেকর্ড। স্প্যানিশ কর্তৃপক্ষ এ তথ্য নিশ্চিত করেছে। মার্কিন বার্তা সংস্থা এপি এ খবর জানিয়েছে।

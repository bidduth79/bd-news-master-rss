      <link>https://www.banglatribune.com/sport/cricket/979736/%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A7%80%E0%A7%9F%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%87%E0%A6%A8%E0%A6%BF%E0%A6%82%E0%A6%B8-%E0%A6%98%E0%A7%8B%E0%A6%B7%E0%A6%A3%E0%A6%BE-%E0%A6%9C%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/cricket/979736/%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A7%80%E0%A7%9F%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%87%E0%A6%A8%E0%A6%BF%E0%A6%82%E0%A6%B8-%E0%A6%98%E0%A7%8B%E0%A6%B7%E0%A6%A3%E0%A6%BE-%E0%A6%9C%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Mon, 09 Nov 2026 10:35:38 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/b96b3b5edb450cb9b4354a8ba362aaa1-6af14d92753cd.jpg?jadewits_media_id=1053978" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/b96b3b5edb450cb9b4354a8ba362aaa1-6af14d92753cd.jpg?jadewits_media_id=1053978" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/b96b3b5edb450cb9b4354a8ba362aaa1-6af14d92753cd.jpg?jadewits_media_id=1053978" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ক্যারিবীয়দের ইনিংস ঘোষণা: জয়ের জন্য বাংলাদেশের প্রয়োজন ৩৬৯ রান" /&gt;&lt;/p&gt;&lt;p&gt;ওয়েস্ট ইন্ডিজের বিপক্ষে টেস্ট ম্যাচের পঞ্চম ও শেষ দিনে জয়ের জন্য বাংলাদেশের সামনে ৩৬৯ রানের পাহাড়সম লক্ষ্য দাঁড় করিয়েছে ক্যারিবীয়রা। পঞ্চম দিনে নিজেদের দ্বিতীয় ইনিংসে ব্যাট করে ইনিংস ঘোষণা করেছে ওয়েস্ট ইন্ডিজ। ফলে ম্যাচ জিততে কিংবা ড্র করতে টাইগারদের সামনে এখন কঠিন পরীক্ষা অপেক্ষা করছে।&amp;nbsp;
ওয়েস্ট&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/cricket/979736/%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A7%80%E0%A7%9F%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%87%E0%A6%A8%E0%A6%BF%E0%A6%82%E0%A6%B8-%E0%A6%98%E0%A7%8B%E0%A6%B7%E0%A6%A3%E0%A6%BE-%E0%A6%9C%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0">বাংলা ট্রিবিউন</source>

    <item>
      <title>ক্যামব্রিজে নাহিদ ইসলামকে হেনস্তার চেষ্টা, কড়া নিরাপত্তায় ক্যাম্পাস ত্যাগ</title>
      <link>https://www.banglatribune.com/foreign/europe/981158/%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A6%AC%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%9C%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A6-%E0%A6%87%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A7%87%E0%A6%A8%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%9A%E0%A7%87%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%95%E0%A7%9C%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/europe/981158/%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A6%AC%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%9C%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A6-%E0%A6%87%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A7%87%E0%A6%A8%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%9A%E0%A7%87%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%95%E0%A7%9C%E0%A6%BE</guid>
      <pubDate>Sun, 15 Nov 2026 23:13:11 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/0bdab2890f765bd1bacc08b7727920bc-6af9e7d74b07f.jpg?jadewits_media_id=1055188" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/0bdab2890f765bd1bacc08b7727920bc-6af9e7d74b07f.jpg?jadewits_media_id=1055188" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/0bdab2890f765bd1bacc08b7727920bc-6af9e7d74b07f.jpg?jadewits_media_id=1055188" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ক্যামব্রিজে নাহিদ ইসলামকে হেনস্তার চেষ্টা, কড়া নিরাপত্তায় ক্যাম্পাস ত্যাগ" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাজ্যের ক্যামব্রিজ বিশ্ববিদ্যালয়ে একটি নির্ধারিত অনুষ্ঠান শেষে দলের নেতা-কর্মীদের কড়া নিরাপত্তায় ক্যাম্পাস ছেড়েছেন জাতীয় নাগরিক পার্টির (এনসিপি) আহ্বায়ক ও বিরোধীদলীয় চিফ হুইপ নাহিদ ইসলাম। তাকে প্রতিহত ও হেনস্তা করতে বিশ্ববিদ্যালয় চত্বরে দেশে কার্যক্রম নিষিদ্ধ আওয়ামী লীগের একদল কর্মী-সমর্থক জড়ো &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/europe/981158/%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A6%AC%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%9C%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A6-%E0%A6%87%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A7%87%E0%A6%A8%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%9A%E0%A7%87%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%95%E0%A7%9C%E0%A6%BE">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>নৈরাজ্যের প্রতিবাদে ঢাবিতে ছাত্রদলের বিক্ষোভ</title>
      <link>https://www.banglatribune.com/politics/bnp/981157/%E0%A6%A8%E0%A7%88%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A7%87-%E0%A6%A2%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8B%E0%A6%AD</link>
      <guid isPermaLink="true">https://www.banglatribune.com/politics/bnp/981157/%E0%A6%A8%E0%A7%88%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A7%87-%E0%A6%A2%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8B%E0%A6%AD</guid>
      <pubDate>Sun, 15 Nov 2026 23:06:38 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/5a5e65fc0f756ecfd4365eabb0119fc3-6af9e62975c13.JPG?jadewits_media_id=1055187" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/5a5e65fc0f756ecfd4365eabb0119fc3-6af9e62975c13.JPG?jadewits_media_id=1055187" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/5a5e65fc0f756ecfd4365eabb0119fc3-6af9e62975c13.JPG?jadewits_media_id=1055187" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নৈরাজ্যের প্রতিবাদে ঢাবিতে ছাত্রদলের বিক্ষোভ" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জসহ সারা দেশে&amp;nbsp; নৈরাজ্যের বিরুদ্ধে ঢাকা বিশ্ববিদ্যালয় ক্যাম্পাসে বিক্ষোভ মিছিল করেছে জাতীয়তাবাদী ছাত্রদল।
রবিবার (১৫ নভেম্বর) সন্ধ্যায় মধুর ক্যান্টিন থেকে শুরু হয়ে মিছিলটি ক্যাম্পাস প্রদিক্ষণ করে শাহবাগে গিয়ে শেষ হয়। এ সময় উপস্থিত ছিলেন কেন্দ্রীয় সংসদের সহ সভাপতি মনজুরুল আলম রিয়াদ, সাফি &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/politics/bnp/981157/%E0%A6%A8%E0%A7%88%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A7%87-%E0%A6%A2%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8B%E0%A6%AD">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>মোহাম্মদপুরে ফার্মেসিতে গুলির ঘটনায় ‘চাঁদাবাজি’, নেপথ্যে কারা</title>
      <link>https://www.banglatribune.com/law-and-crime/981156/%E0%A6%AE%E0%A7%8B%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%A6%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%AB%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B8%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B0-%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E2%80%98%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BF%E2%80%99</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/981156/%E0%A6%AE%E0%A7%8B%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%A6%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%AB%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B8%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B0-%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E2%80%98%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BF%E2%80%99</guid>
      <pubDate>Sun, 15 Nov 2026 23:05:27 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/4fd92f671441e3701e746f0c6c257d18-6af9e60e2e658.jpg?jadewits_media_id=1055186" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/4fd92f671441e3701e746f0c6c257d18-6af9e60e2e658.jpg?jadewits_media_id=1055186" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/4fd92f671441e3701e746f0c6c257d18-6af9e60e2e658.jpg?jadewits_media_id=1055186" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মোহাম্মদপুরে ফার্মেসিতে গুলির ঘটনায় ‘চাঁদাবাজি’, নেপথ্যে কারা" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর মোহাম্মদপুরে বাবর রোডের অনুরাগ ফার্মেসিতে গুলির ঘটনার নেপথ্যে ৫০ লাখ টাকা চাঁদা দাবির অভিযোগ উঠেছে। শীর্ষ সন্ত্রাসী &amp;lsquo;কিলার বাদল&amp;rsquo; ও &amp;lsquo;কিলার পাপ্পু&amp;rsquo;র নাম ব্যবহার করে একটি সন্ত্রাসী চক্র এই টাকা দাবি করে বলে অভিযোগ করেছেন প্রতিষ্ঠানটির মালিক সৈয়দ হাসান নূর ইসলাম রাষ্টন। &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/981156/%E0%A6%AE%E0%A7%8B%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%A6%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%AB%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B8%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B0-%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E2%80%98%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BF%E2%80%99">বাংলা ট্রিবিউন</source>

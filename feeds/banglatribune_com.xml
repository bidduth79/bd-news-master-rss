    <item>
      <title>রফতানি বাড়াতে সরকারের নতুন উদ্যোগ</title>
      <link>https://www.banglatribune.com/business/money-and-investment/981636/%E0%A6%B0%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%97%C2%A0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/business/money-and-investment/981636/%E0%A6%B0%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%97%C2%A0</guid>
      <pubDate>Wed, 18 Nov 2026 07:26:39 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/06/24/b5c28a25a2dbd1568e6c93615232d181-6a3c01223e3e0.jpg?jadewits_media_id=1030486" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/06/24/b5c28a25a2dbd1568e6c93615232d181-6a3c01223e3e0.jpg?jadewits_media_id=1030486" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/06/24/b5c28a25a2dbd1568e6c93615232d181-6a3c01223e3e0.jpg?jadewits_media_id=1030486" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রফতানি বাড়াতে সরকারের নতুন উদ্যোগ" /&gt;&lt;/p&gt;&lt;p&gt;দেশের তৈরি পোশাক ও বস্ত্র খাতের বিকাশ ধরে রাখতে ব্যবসা সহজীকরণ, উচ্চমূল্য সংযোজিত পণ্য উৎপাদন, নতুন বাজারে প্রবেশ এবং নিরবচ্ছিন্ন জ্বালানি সরবরাহ নিশ্চিত করার উদ্যোগ নিয়েছে সরকার। এ ছাড়া ইউরোপীয় ইউনিয়নের (ইইউ) সঙ্গে মুক্ত বাণিজ্য চুক্তি (এফটিএ) নিয়ে আগামী ১৫ ডিসেম্বর প্রথম দফার আলোচনা শুরু হবে। জাপা&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/business/money-and-investment/981636/%E0%A6%B0%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%97%C2%A0">বাংলা ট্রিবিউন</source>
    </item>

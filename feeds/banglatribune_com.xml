    <item>
      <title>ইরান কি এবার ‘অলআউট’ যুদ্ধের প্রস্তুতি নিচ্ছে?</title>
      <link>https://www.banglatribune.com/foreign/middle-east/979649/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8-%E0%A6%95%E0%A6%BF-%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E2%80%98%E0%A6%85%E0%A6%B2%E0%A6%86%E0%A6%89%E0%A6%9F%E2%80%99-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%81%E0%A6%A4%E0%A6%BF-%E0%A6%A8%E0%A6%BF%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87</link>

      <guid isPermaLink="true">https://www.banglatribune.com/press-release/981537/%E0%A6%86%E0%A6%87%E0%A6%8F%E0%A6%B8%E0%A6%87%E0%A6%89-%E0%A6%AB%E0%A7%81%E0%A6%9F%E0%A6%AC%E0%A6%B2-%E0%A6%AB%E0%A7%87%E0%A6%B8%E0%A7%8D%E0%A6%9F-%E0%A6%B8%E0%A6%BF%E0%A6%9C%E0%A6%A8-%E0%A7%A8-%E0%A6%8F%E0%A6%B0-%E0%A6%9A%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A7%9F%E0%A6%A8-%E0%A6%B2%E0%A7%87%E0%A6%97%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B8%E0%A6%BF</guid>
      <pubDate>Tue, 17 Nov 2026 18:03:03 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/ff347c4045cea027ca599cd61e3be5ed-6afc4245a7826.jpg?jadewits_media_id=1055510" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/ff347c4045cea027ca599cd61e3be5ed-6afc4245a7826.jpg?jadewits_media_id=1055510" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/ff347c4045cea027ca599cd61e3be5ed-6afc4245a7826.jpg?jadewits_media_id=1055510" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আইএসইউ ফুটবল ফেস্ট সিজন-২ এর চ্যাম্পিয়ন লেগ্যাসি ইউনাইটেড" /&gt;&lt;/p&gt;&lt;p&gt;ইন্টারন্যাশনাল স্ট্যান্ডার্ড ইউনিভার্সিটি (আইএসইউ) স্পোর্টস ক্লাবের আয়োজনে &amp;lsquo;আইএসইউ ফুটবল ফেস্ট, সিজন-২&amp;rsquo; এর চ্যাম্পিয়ন হয়েছে লেগ্যাসি ইউনাইটেড। রবিবার (১৫ নভেম্বর) রাজধানীর পূর্বাচলে ১১ নম্বর সেক্টর ফুটবল মাঠে অনুষ্ঠিত ফাইনাল ম্যাচ শেষে চ্যাম্পিয়ন এবং রানার্সআপ দলের হাতে ট্রফি তুলে দেওয়া &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/press-release/981537/%E0%A6%86%E0%A6%87%E0%A6%8F%E0%A6%B8%E0%A6%87%E0%A6%89-%E0%A6%AB%E0%A7%81%E0%A6%9F%E0%A6%AC%E0%A6%B2-%E0%A6%AB%E0%A7%87%E0%A6%B8%E0%A7%8D%E0%A6%9F-%E0%A6%B8%E0%A6%BF%E0%A6%9C%E0%A6%A8-%E0%A7%A8-%E0%A6%8F%E0%A6%B0-%E0%A6%9A%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A7%9F%E0%A6%A8-%E0%A6%B2%E0%A7%87%E0%A6%97%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B8%E0%A6%BF">বাংলা ট্রিবিউন</source>

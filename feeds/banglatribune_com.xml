    <item>
      <title>বিসিবির প্রস্তাবে ইতিবাচক পাকিস্তান ও শ্রীলঙ্কা</title>
      <link>https://www.banglatribune.com/sport/cricket/982332/%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%87%E0%A6%A4%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%9A%E0%A6%95-%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8-%E0%A6%93-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B2%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/cricket/982332/%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%87%E0%A6%A4%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%9A%E0%A6%95-%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8-%E0%A6%93-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B2%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BE</guid>
      <pubDate>Sat, 21 Nov 2026 14:35:57 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2022/06/19/-99-a400bba982c69a1a38df79cf735e59e7.jpg?jadewits_media_id=798390" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2022/06/19/-99-a400bba982c69a1a38df79cf735e59e7.jpg?jadewits_media_id=798390" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2022/06/19/-99-a400bba982c69a1a38df79cf735e59e7.jpg?jadewits_media_id=798390" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিসিবির প্রস্তাবে ইতিবাচক পাকিস্তান ও শ্রীলঙ্কা" /&gt;&lt;/p&gt;&lt;p&gt;২০২৭ এশিয়া কাপের আগে ঘরের মাঠে পাকিস্তান ও শ্রীলঙ্কাকে নিয়ে ত্রিদেশীয় সিরিজ আয়োজন করতে চায় বাংলাদেশ ক্রিকেট বোর্ড (বিসিবি)। এ নিয়ে দুই দেশের ক্রিকেট বোর্ডের কাছে প্রস্তাবও পাঠিয়েছে তারা। প্রস্তাবে ইতিবাচক সাড়া মিলেছে বলে জানা গেছে। তবে এখনো চূড়ান্ত সিদ্ধান্ত আসেনি।
ক্রিকেটবিষয়ক ওয়েবসাইট ক্রিকবাজ জান&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/cricket/982332/%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%87%E0%A6%A4%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%9A%E0%A6%95-%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8-%E0%A6%93-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B2%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BE">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>সেন্টমার্টিনে আটকা দেড় হাজার পর্যটক, ট্রলারে ফিরছেন ৩৫০ জন</title>
      <link>https://www.banglatribune.com/country/chitagong/982331/%E0%A6%B8%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%9F%E0%A6%95%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A7%9C-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%9F%E0%A6%95-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A6%BE%E0%A6%B0%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/chitagong/982331/%E0%A6%B8%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%9F%E0%A6%95%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A7%9C-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%9F%E0%A6%95-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A6%BE%E0%A6%B0%E0%A7%87</guid>
      <pubDate>Sat, 21 Nov 2026 14:36:40 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/8149c60df6c2c6d7504e9c4537caa4b2-6b0157060acbb.jpg?jadewits_media_id=1056176" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/8149c60df6c2c6d7504e9c4537caa4b2-6b0157060acbb.jpg?jadewits_media_id=1056176" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/8149c60df6c2c6d7504e9c4537caa4b2-6b0157060acbb.jpg?jadewits_media_id=1056176" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সেন্টমার্টিনে আটকা দেড় হাজার পর্যটক, ট্রলারে ফিরছেন ৩৫০ জন" /&gt;&lt;/p&gt;&lt;p&gt;বৈরী আবহাওয়ার কারণে সেন্টমার্টিন দ্বীপে আটকা পড়া পর্যটকদের মধ্যে সাড়ে তিনশ জন ট্রলারে করে টেকনাফে ফিরেছেন। শনিবার (২১ নভেম্বর) সকাল সাড়ে ৮টা থেকে দুপুর সাড়ে ১২টা পর্যন্ত ১০টি ট্রলারে করে তারা দ্বীপ ছাড়েন। তবে ট্রলারের সংকট থাকায় এখনো অনেক পর্যটক দ্বীপের জেটিঘাটে অপেক্ষা করছেন।
বৈরী আবহাওয়ার কারণে গত&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/chitagong/982331/%E0%A6%B8%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%9F%E0%A6%95%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A7%9C-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%9F%E0%A6%95-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A6%BE%E0%A6%B0%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ভালোবাসা আর সমর্থনই মাহির বড় শক্তি</title>
      <link>https://www.banglatribune.com/entertainment/television/982330/%E0%A6%AD%E0%A6%BE%E0%A6%B2%E0%A7%8B%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%BE-%E0%A6%86%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%A8%E0%A6%87-%E0%A6%AE%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A7%9C-%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.banglatribune.com/entertainment/television/982330/%E0%A6%AD%E0%A6%BE%E0%A6%B2%E0%A7%8B%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%BE-%E0%A6%86%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%A8%E0%A6%87-%E0%A6%AE%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A7%9C-%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF</guid>
      <pubDate>Sat, 21 Nov 2026 14:29:31 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/2f7fbc71b160dda09c8739e189675bb5-6b015659bf64d.jpg?jadewits_media_id=1056175" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/2f7fbc71b160dda09c8739e189675bb5-6b015659bf64d.jpg?jadewits_media_id=1056175" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/2f7fbc71b160dda09c8739e189675bb5-6b015659bf64d.jpg?jadewits_media_id=1056175" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভালোবাসা আর সমর্থনই মাহির বড় শক্তি" /&gt;&lt;/p&gt;&lt;p&gt;৭৫তম মিস ইউনিভার্স প্রতিযোগিতায় বাংলাদেশের প্রতিনিধিত্ব করছেন মডেল-অভিনেত্রী সামিরা খান মাহি। প্রতিদিনই সামাজিক যোগাযোগমাধ্যমে তিনি সেখানের আপডেট দিচ্ছেন। দিন থেকে রাত কখন কী করছেন জানাছেন এই গ্ল্যামারকন্যা।
সামাজিক যোগাযোগমাধ্যম ফেসবুকে মাহি জানান, তিনি এখন ৩য় অবস্থানে আছেন! এই পথচলায় সবাই যেভাবে ত&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/entertainment/television/982330/%E0%A6%AD%E0%A6%BE%E0%A6%B2%E0%A7%8B%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%BE-%E0%A6%86%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%A8%E0%A6%87-%E0%A6%AE%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A7%9C-%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>রাজধানীতে ডিএমপির অভিযানে গ্রেফতার ২৯৯</title>

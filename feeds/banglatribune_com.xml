    <item>
      <title>ঢাকার মঞ্চে ভারত-পাকিস্তান, কার হাতে উঠবে সাফ ট্রফি?</title>
      <link>https://www.banglatribune.com/sport/football/981345/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A7%87-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4-%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8-%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%89%E0%A6%A0%E0%A6%AC%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%AB</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/football/981345/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A7%87-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4-%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8-%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%89%E0%A6%A0%E0%A6%AC%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%AB</guid>
      <pubDate>Tue, 17 Nov 2026 08:00:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/82dcccf481f6354243966d940b55da90-6afb11767cdf6.JPG?jadewits_media_id=1055346" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/82dcccf481f6354243966d940b55da90-6afb11767cdf6.JPG?jadewits_media_id=1055346" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/82dcccf481f6354243966d940b55da90-6afb11767cdf6.JPG?jadewits_media_id=1055346" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঢাকার মঞ্চে ভারত-পাকিস্তান, কার হাতে উঠবে সাফ ট্রফি?" /&gt;&lt;/p&gt;&lt;p&gt;একদিকে প্রথমবারের মতো সাফ চ্যাম্পিয়ন হওয়ার হাতছানি, অন্যদিকে দশম শিরোপার হাতছানি। দুই চিরপ্রতিদ্বন্দ্বী ভারত ও পাকিস্তান আজ মঙ্গলবার মুখোমুখি হচ্ছে দক্ষিণ এশিয়ার ফুটবলের শ্রেষ্ঠত্বের লড়াইয়ে। ঢাকার জাতীয় স্টেডিয়ামে রাত ৮টায় শুরু হবে সাফ চ্যাম্পিয়নশিপের ফাইনাল। ম্যাচটি সরাসরি সম্প্রচার করবে টি স্পোর্ট&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/football/981345/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A7%87-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4-%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8-%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%89%E0%A6%A0%E0%A6%AC%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%AB">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ইলন মাস্ক, বিল গেটসদের সঙ্গে রাবণের তুলনা, টুইঙ্কলের মজার মন্তব্য</title>
      <link>https://www.banglatribune.com/entertainment/bollywood/981332/%E0%A6%87%E0%A6%B2%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%95-%E0%A6%AC%E0%A6%BF%E0%A6%B2-%E0%A6%97%E0%A7%87%E0%A6%9F%E0%A6%B8%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%AC%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%A4%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/entertainment/bollywood/981332/%E0%A6%87%E0%A6%B2%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%95-%E0%A6%AC%E0%A6%BF%E0%A6%B2-%E0%A6%97%E0%A7%87%E0%A6%9F%E0%A6%B8%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%AC%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%A4%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE</guid>
      <pubDate>Tue, 17 Nov 2026 08:00:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/f903e897ca92667b8f03720026590614-6afb0a32e1edf.jpg?jadewits_media_id=1055339" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/f903e897ca92667b8f03720026590614-6afb0a32e1edf.jpg?jadewits_media_id=1055339" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/f903e897ca92667b8f03720026590614-6afb0a32e1edf.jpg?jadewits_media_id=1055339" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইলন মাস্ক, বিল গেটসদের সঙ্গে রাবণের তুলনা, টুইঙ্কলের মজার মন্তব্য" /&gt;&lt;/p&gt;&lt;p&gt;রাবণের সঙ্গে বর্তমান বিশ্বের প্রযুক্তি জগতের কয়েকজন শীর্ষ ধনকুবেরের মিল খুঁজে পেলেন বলিউড অভিনেত্রী টুইঙ্কল খান্না। নিজের সাম্প্রতিক একটি কলামে লঙ্কার রাজা রাবণের সঙ্গে ইলন মাস্ক, বিল গেটস এবং জেনসেন হুয়াংয়ের তুলনা করেছেন তিনি।
মজার ছলে রাবণকে আখ্যা দিয়েছেন আসল &amp;lsquo;টেক ব্রো&amp;rsquo; বা প্রযুক্তি জগ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/entertainment/bollywood/981332/%E0%A6%87%E0%A6%B2%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%95-%E0%A6%AC%E0%A6%BF%E0%A6%B2-%E0%A6%97%E0%A7%87%E0%A6%9F%E0%A6%B8%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%AC%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%A4%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>লন্ডনে আ.লীগ ও এনসিপির সংঘর্ষ, আহত ৪</title>
      <link>https://www.banglatribune.com/foreign/uk/981417/%E0%A6%B2%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A6%A8%E0%A7%87-%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%93-%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A7%87-%E0%A6%86%E0%A6%B9%E0%A6%A4-%E0%A7%AA-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%80%E0%A6%B0%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/uk/981417/%E0%A6%B2%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A6%A8%E0%A7%87-%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%93-%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A7%87-%E0%A6%86%E0%A6%B9%E0%A6%A4-%E0%A7%AA-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%80%E0%A6%B0%E0%A6%BE</guid>
      <pubDate>Tue, 17 Nov 2026 08:30:16 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/b9eb4d9b28652147236777eb7cb9ac12-6afbad7258ecd.jpg?jadewits_media_id=1055397" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/b9eb4d9b28652147236777eb7cb9ac12-6afbad7258ecd.jpg?jadewits_media_id=1055397" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/b9eb4d9b28652147236777eb7cb9ac12-6afbad7258ecd.jpg?jadewits_media_id=1055397" style="max-width:100%;height:auto;margin-bottom:10px;" alt="লন্ডনে আ.লীগ ও এনসিপির সংঘর্ষ, আহত ৪" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাজ্য সফররত জাতীয় নাগরিক পার্টির (এনসিপি) আহ্বায়ক ও বিরোধীদলীয় চিফ হুইপ নাহিদ ইসলামের সংবর্ধনা অনুষ্ঠান শেষে লন্ডনের ‘মে ফেয়ার’ হলের পেছনের সড়কে কার্যক্রম নিষিদ্ধ আওয়ামী লীগ ও এনসিপির নেতাকর্মীদের মধ্যে হাতাহাতি ও সংঘর্ষের ঘটনা ঘটেছে। স্থানীয় সময় সোমবার (১৬ নভেম্বর) রাতে এ সংঘর্ষে কমপক্ষে চারজন&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/uk/981417/%E0%A6%B2%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A6%A8%E0%A7%87-%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%93-%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A7%87-%E0%A6%86%E0%A6%B9%E0%A6%A4-%E0%A7%AA-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%80%E0%A6%B0%E0%A6%BE">বাংলা ট্রিবিউন</source>

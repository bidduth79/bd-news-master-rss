      <guid isPermaLink="true">https://www.banglatribune.com/educations/983202/%E0%A6%AA%E0%A7%87%E0%A6%B6%E0%A6%BE%E0%A6%97%E0%A6%A4-%E0%A6%B8%E0%A6%BE%E0%A6%AB%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%BE%E0%A6%B6%E0%A6%BE%E0%A6%AA%E0%A6%BE%E0%A6%B6%E0%A6%BF-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A7%9F%E0%A6%A8%E0%A7%87%E0%A6%93-%E0%A6%95%E0%A6%BE%E0%A6%9C-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87</guid>
      <pubDate>Wed, 25 Nov 2026 17:58:44 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/1935f9c439f1b048f0ba9131c0445e4c-6b06cd2482392.jpg?jadewits_media_id=1056905" length="0" type="image/jpeg" />

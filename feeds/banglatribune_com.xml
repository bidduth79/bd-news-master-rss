      <guid isPermaLink="true">https://www.banglatribune.com/others/980949/%E2%80%98%E0%A6%86%E0%A6%AE%E0%A6%BF-%E0%A6%95%E0%A7%87-%E0%A6%A4%E0%A7%8B%E0%A6%B0%E0%A7%87-%E0%A6%9A%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%87%E0%A6%A4%E0%A7%87%E0%A6%9B%E0%A6%BF%E2%80%99-%E0%A6%AC%E0%A6%B2%E0%A7%87%E0%A6%87-%E0%A6%A6%E0%A7%82%E0%A6%B0%E0%A6%AC%E0%A7%80%E0%A6%A8-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%A4%E0%A6%BE%E0%A6%A3%E0%A7%8D%E0%A6%A1%E0%A6%AC</guid>
      <pubDate>Sat, 14 Nov 2026 23:01:40 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/60f0b026df5cbb8d0dcd760595b5df95-6af8926fec231.jpeg?jadewits_media_id=1055015" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/60f0b026df5cbb8d0dcd760595b5df95-6af8926fec231.jpeg?jadewits_media_id=1055015" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/60f0b026df5cbb8d0dcd760595b5df95-6af8926fec231.jpeg?jadewits_media_id=1055015" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘আমি কে তোরে চিনাইতেছি’ বলেই দূরবীন বাংলায় তাণ্ডব চালালো কারা?" /&gt;&lt;/p&gt;&lt;p&gt;একটি টেবিলে বসার জন্য কিছুক্ষণ অপেক্ষা করতে বলা হয়েছিল এক যুবককে। জবাবে তিনি বলেন, &amp;lsquo;আমি কে তোরে চিনাইতেছি।&amp;rsquo; এরপর ফোন করে ডেকে আনেন আরও কয়েকজনকে। মুহূর্তের মধ্যে শুরু হয় হামলা, মারধর ও ভাঙচুর। প্রায় আধাঘণ্টার তাণ্ডবে তছনছ হয়ে যায় রাজধানীর মহাখালীর জনপ্রিয় রেস্তোরাঁ &amp;lsquo;দূরবীন বাংলা&amp;rsq&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/others/980949/%E2%80%98%E0%A6%86%E0%A6%AE%E0%A6%BF-%E0%A6%95%E0%A7%87-%E0%A6%A4%E0%A7%8B%E0%A6%B0%E0%A7%87-%E0%A6%9A%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%87%E0%A6%A4%E0%A7%87%E0%A6%9B%E0%A6%BF%E2%80%99-%E0%A6%AC%E0%A6%B2%E0%A7%87%E0%A6%87-%E0%A6%A6%E0%A7%82%E0%A6%B0%E0%A6%AC%E0%A7%80%E0%A6%A8-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%A4%E0%A6%BE%E0%A6%A3%E0%A7%8D%E0%A6%A1%E0%A6%AC">বাংলা ট্রিবিউন</source>

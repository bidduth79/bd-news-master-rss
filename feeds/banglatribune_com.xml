    <item>
      <title>পুলিশ ও প্রশাসনে শুদ্ধি অভিযান: নজরদারিতে কারা</title>
      <link>https://www.banglatribune.com/law-and-crime/981385/%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%93-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B6%E0%A6%BE%E0%A6%B8%E0%A6%A8%E0%A7%87-%E0%A6%B6%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BF-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A6%A8%E0%A6%9C%E0%A6%B0%E0%A6%A6%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/981385/%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%93-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B6%E0%A6%BE%E0%A6%B8%E0%A6%A8%E0%A7%87-%E0%A6%B6%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BF-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A6%A8%E0%A6%9C%E0%A6%B0%E0%A6%A6%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BE</guid>
      <pubDate>Tue, 17 Nov 2026 00:01:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/09/17/2bc06c4a14c0c8489ae36df395dc12a1-6aabf9665a180.jpg?jadewits_media_id=1044284" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/09/17/2bc06c4a14c0c8489ae36df395dc12a1-6aabf9665a180.jpg?jadewits_media_id=1044284" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/09/17/2bc06c4a14c0c8489ae36df395dc12a1-6aabf9665a180.jpg?jadewits_media_id=1044284" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পুলিশ ও প্রশাসনে শুদ্ধি অভিযান: নজরদারিতে কারা" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জের ডিসি-এসপিসহ পাঁচ কর্মকর্তার বদলি, চট্টগ্রামে পুলিশ সুপার গ্রেফতার, কক্সবাজারে শতাধিক পুলিশ সদস্যকে সরিয়ে দেওয়া এবং চুয়াডাঙ্গার জেলা প্রশাসক (ডিসি) ও জেলা ম্যাজিস্ট্রেট লুৎফুন নাহারকে প্রত্যাহার করা হয়েছে। একের পর এক ঘটনায় পুলিশ ও জনপ্রশাসনের ভেতরে নজরদারি, দায়িত্ব পালনে অনীহা এবং শুদ্ধি&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/981385/%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%93-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B6%E0%A6%BE%E0%A6%B8%E0%A6%A8%E0%A7%87-%E0%A6%B6%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BF-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A6%A8%E0%A6%9C%E0%A6%B0%E0%A6%A6%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BE">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>কৃষক শ্রমিক জনতা লীগের ভারপ্রাপ্ত সেক্রেটারি ডিবি হেফাজতে</title>

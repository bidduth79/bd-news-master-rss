    <item>
      <title>আসিয়ানকে ‘বৈষম্যমূলক’ আখ্যা দিলো মিয়ানমারের জান্তা সরকার</title>
      <link>https://www.banglatribune.com/foreign/asia/982527/%E0%A6%86%E0%A6%B8%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%95%E0%A7%87-%E2%80%98%E0%A6%AC%E0%A7%88%E0%A6%B7%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%AE%E0%A7%82%E0%A6%B2%E0%A6%95%E2%80%99-%E0%A6%86%E0%A6%96%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%8B-%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/asia/982527/%E0%A6%86%E0%A6%B8%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%95%E0%A7%87-%E2%80%98%E0%A6%AC%E0%A7%88%E0%A6%B7%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%AE%E0%A7%82%E0%A6%B2%E0%A6%95%E2%80%99-%E0%A6%86%E0%A6%96%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%8B-%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE</guid>
      <pubDate>Sun, 22 Nov 2026 16:49:47 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/386a171e44a8734aead9b75d2e61a2ed-6b02c68f39464.jpg?jadewits_media_id=1056347" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/386a171e44a8734aead9b75d2e61a2ed-6b02c68f39464.jpg?jadewits_media_id=1056347" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/386a171e44a8734aead9b75d2e61a2ed-6b02c68f39464.jpg?jadewits_media_id=1056347" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আসিয়ানকে ‘বৈষম্যমূলক’ আখ্যা দিলো মিয়ানমারের জান্তা সরকার" /&gt;&lt;/p&gt;&lt;p&gt;আসিয়ানের সম্মেলনে পূর্ণ প্রতিনিধিত্ব না দেওয়ার সিদ্ধান্তকে &amp;lsquo;অন্যায্য ও ভারসাম্যহীন&amp;rsquo; আখ্যা দিয়েছে মিয়ানমারের সেনাসমর্থিত সরকার। শনিবার দেশটির পররাষ্ট্র মন্ত্রণালয় দক্ষিণ-পূর্ব এশিয়ার দেশগুলোর এই জোটের বিরুদ্ধে বৈষম্যমূলক আচরণের অভিযোগ তোলে। ব্রিটিশ বার্তা সংস্থা রয়টার্স এ খবর জানিয়েছে।
মন&lt;/p&gt;</description>

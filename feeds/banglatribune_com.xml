      <guid isPermaLink="true">https://www.banglatribune.com/others/981853/%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%A8%E0%A7%81%E0%A6%B0%E0%A7%81%E0%A6%B2-%E0%A6%87%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE-%E0%A6%A8%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A6-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Thu, 19 Nov 2026 03:00:11 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/8638de21061c548a0a5f786336e1f9a0-6afe117624953.jpg?jadewits_media_id=1055781" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/8638de21061c548a0a5f786336e1f9a0-6afe117624953.jpg?jadewits_media_id=1055781" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/8638de21061c548a0a5f786336e1f9a0-6afe117624953.jpg?jadewits_media_id=1055781" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাবেক শিক্ষামন্ত্রী নুরুল ইসলাম নাহিদ গ্রেফতার" /&gt;&lt;/p&gt;&lt;p&gt;সাবেক শিক্ষামন্ত্রী নুরুল ইসলাম নাহিদকে গ্রেফতার করেছে পুলিশ।&amp;nbsp;
বুধবার (১৮ নভেম্বর) দিবাগত রাত ২টা ২০ মিনিটের দিকে রাজধানীর উত্তরার বাসায় অভিযান চালিয়ে তাকে গ্রেফতার করা হয়েছে।
উত্তরা পশ্চিম থানার ভারপ্রাপ্ত কর্মকর্তা (ওসি) মোহাম্মদ খালিদ মনসুর গ্রেফতারের বিষয়টি নিশ্চিত করেছেন।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/others/981853/%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%A8%E0%A7%81%E0%A6%B0%E0%A7%81%E0%A6%B2-%E0%A6%87%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE-%E0%A6%A8%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A6-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>সার্বক্ষণিক পুলিশ পাহারায় থাকা ড. ইউনূসের বাসায় কীভাবে আগুন দিলো দুর্বৃত্তরা?</title>

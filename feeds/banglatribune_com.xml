      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/b1af71f96ab87e00ce7b043a953a7401-6b02b844c21c9.jpg?jadewits_media_id=1056338" length="0" type="image/jpeg" />

    <item>
      <title>আনচেলত্তির কাছে যে অনুরোধ মরিনহোর</title>
      <link>https://www.banglatribune.com/sport/football/979708/%E0%A6%86%E0%A6%A8%E0%A6%9A%E0%A7%87%E0%A6%B2%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%9B%E0%A7%87-%E0%A6%AF%E0%A7%87-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%B0%E0%A7%8B%E0%A6%A7-%E0%A6%AE%E0%A6%B0%E0%A6%BF%E0%A6%A8%E0%A6%B9%E0%A7%8B%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/football/979708/%E0%A6%86%E0%A6%A8%E0%A6%9A%E0%A7%87%E0%A6%B2%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%9B%E0%A7%87-%E0%A6%AF%E0%A7%87-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%B0%E0%A7%8B%E0%A6%A7-%E0%A6%AE%E0%A6%B0%E0%A6%BF%E0%A6%A8%E0%A6%B9%E0%A7%8B%E0%A6%B0</guid>
      <pubDate>Mon, 09 Nov 2026 10:00:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/057a841d5c36857093b6aee6febde31b-6af0bfc896c9f.JPG?jadewits_media_id=1053954" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/057a841d5c36857093b6aee6febde31b-6af0bfc896c9f.JPG?jadewits_media_id=1053954" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/057a841d5c36857093b6aee6febde31b-6af0bfc896c9f.JPG?jadewits_media_id=1053954" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আনচেলত্তির কাছে যে অনুরোধ মরিনহোর" /&gt;&lt;/p&gt;&lt;p&gt;রিয়াল মাদ্রিদে খুব একটা সুযোগ পাচ্ছেন না ব্রাজিলিয়ান ফরোয়ার্ড এন্দ্রিক। তাই আসন্ন আন্তর্জাতিক বিরতিতে তাকে খেলানোর জন্য ব্রাজিল কোচ কার্লো আনচেলত্তির প্রতি সরাসরি বার্তা দিয়েছেন হোসে মরিনহো।&amp;nbsp;
ভ্যালেন্সিয়ার মাঠে মেস্তায়া স্টেডিয়ামে রিয়াল মাদ্রিদের ৩-০ গোলের জয়ের পর এন্দ্রিককে নিয়ে কথা বলেন মরিনহ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/football/979708/%E0%A6%86%E0%A6%A8%E0%A6%9A%E0%A7%87%E0%A6%B2%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%9B%E0%A7%87-%E0%A6%AF%E0%A7%87-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%B0%E0%A7%8B%E0%A6%A7-%E0%A6%AE%E0%A6%B0%E0%A6%BF%E0%A6%A8%E0%A6%B9%E0%A7%8B%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>শেরে বাংলা এ কে ফজলুল হকের 'বেঙ্গল টুডে' ।। পর্ব—০২</title>
      <link>https://www.banglatribune.com/literature/series/979579/%E0%A6%B6%E0%A7%87%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE-%E0%A6%8F-%E0%A6%95%E0%A7%87-%E0%A6%AB%E0%A6%9C%E0%A6%B2%E0%A7%81%E0%A6%B2-%E0%A6%B9%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%B2-%E0%A6%9F%E0%A7%81%E0%A6%A1%E0%A7%87-%E0%A5%A4%E0%A5%A4</link>
      <guid isPermaLink="true">https://www.banglatribune.com/literature/series/979579/%E0%A6%B6%E0%A7%87%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE-%E0%A6%8F-%E0%A6%95%E0%A7%87-%E0%A6%AB%E0%A6%9C%E0%A6%B2%E0%A7%81%E0%A6%B2-%E0%A6%B9%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%B2-%E0%A6%9F%E0%A7%81%E0%A6%A1%E0%A7%87-%E0%A5%A4%E0%A5%A4</guid>
      <pubDate>Mon, 09 Nov 2026 10:00:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/4d138cc9839a135a84f8d23901e89d5a-6af051434986e.png?jadewits_media_id=1053835" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/4d138cc9839a135a84f8d23901e89d5a-6af051434986e.png?jadewits_media_id=1053835" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/4d138cc9839a135a84f8d23901e89d5a-6af051434986e.png?jadewits_media_id=1053835" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শেরে বাংলা এ কে ফজলুল হকের 'বেঙ্গল টুডে' ।। পর্ব—০২" /&gt;&lt;/p&gt;&lt;p&gt;এবার স্যার জন হার্বার্টের প্রসঙ্গে আসি। আমাকে পরিষদকে বলতে হবে যে, আমরা একসাথে কাজ শুরু করার পর কিছু সময় পর্যন্ত তিনি আমার প্রতি একজন বিবেচনাশীল বন্ধু ছিলেন। তিনি আমাকে বলেছিলেন যে, বাংলায় আমিই প্রথম ব্যক্তি যার সাথে তিনি কথা বলেছেন। তিনি আমাকে আশ্বাস দিয়েছিলেন যে তিনি একজন সাংবিধানিক গভর্নর হিসেবে &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/literature/series/979579/%E0%A6%B6%E0%A7%87%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE-%E0%A6%8F-%E0%A6%95%E0%A7%87-%E0%A6%AB%E0%A6%9C%E0%A6%B2%E0%A7%81%E0%A6%B2-%E0%A6%B9%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%B2-%E0%A6%9F%E0%A7%81%E0%A6%A1%E0%A7%87-%E0%A5%A4%E0%A5%A4">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>আতলেতিকোর মাঠে বার্সেলোনার অবিশ্বাস্য প্রত্যাবর্তন</title>

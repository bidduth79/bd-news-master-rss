      <guid isPermaLink="true">https://www.banglatribune.com/country/khulna/980928/%E0%A6%98%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF-%E0%A6%A8%E0%A7%81%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Sat, 14 Nov 2026 20:56:35 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/3edb973ccd78dbb253d19d4763d8d5c2-6af8768c746b5.jpg?jadewits_media_id=1054994" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/3edb973ccd78dbb253d19d4763d8d5c2-6af8768c746b5.jpg?jadewits_media_id=1054994" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/3edb973ccd78dbb253d19d4763d8d5c2-6af8768c746b5.jpg?jadewits_media_id=1054994" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঘরে আগুনের ঘটনার মধ্যে এমপি নুসরাতের বাবার বিরুদ্ধে থানায় মামলা" /&gt;&lt;/p&gt;&lt;p&gt;কুষ্টিয়ার দৌলতপুরে সংরক্ষিত নারী আসনের সংসদ সদস্য ও জাতীয় নাগরিক পার্টির (এনসিপি) যুগ্ম আহ্বায়ক নুসরাত তাবাসসুমের বাবা মো. আব্দুল হালিমের বিরুদ্ধে মামলা করা হয়েছে। সেখানে তার বিরুদ্ধে জমি দখলকে কেন্দ্র করে বসতবাড়ি ভাঙচুর, স্বামী-স্ত্রীকে মারধর, মালামাল লুট ও প্রাণনাশের হুমকির অভিযোগ আনা হয়েছে।
শনিবা&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/khulna/980928/%E0%A6%98%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF-%E0%A6%A8%E0%A7%81%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B0">বাংলা ট্রিবিউন</source>

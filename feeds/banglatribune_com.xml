    <item>
      <title>বন্দি বিনিময় চুক্তিতে ফেরা দুই জন প্যারোলে মুক্তি পেলেন ২৮ দিনের জন্য</title>
      <link>https://www.banglatribune.com/country/khulna/983049/%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%BF-%E0%A6%AC%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A6%AE%E0%A7%9F-%E0%A6%9A%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%9C%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A7%8B%E0%A6%B2%E0%A7%87-%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/khulna/983049/%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%BF-%E0%A6%AC%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A6%AE%E0%A7%9F-%E0%A6%9A%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%9C%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A7%8B%E0%A6%B2%E0%A7%87-%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF</guid>
      <pubDate>Tue, 24 Nov 2026 22:43:26 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/4631b41c678ae8040fe6e31febbbebba-6b05be86a3838.jpg?jadewits_media_id=1056775" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/4631b41c678ae8040fe6e31febbbebba-6b05be86a3838.jpg?jadewits_media_id=1056775" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/4631b41c678ae8040fe6e31febbbebba-6b05be86a3838.jpg?jadewits_media_id=1056775" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বন্দি বিনিময় চুক্তিতে ফেরা দুই জন প্যারোলে মুক্তি পেলেন ২৮ দিনের জন্য" /&gt;&lt;/p&gt;&lt;p&gt;দীর্ঘ কারাবাসে থাকার পর ২৮ দিনের জন্য প্যারোলে মুক্তি পেয়েছেন বাগেরহাটের দুই ব্যক্তি বাদল ফরাজী ও মাইদুল ওরফে আফজাল। তাদের মধ্যে বাদল ফরাজী ১৮ বছর ও মাইদুল ওরফে আফজাল প্রায় ২৪ বছর ধরে কারাবন্দি হিসেবে আছেন।
দীর্ঘদিন পর পরিবারের কাছে ফেরার সুযোগ পাওয়ায় তাদের স্বজনদের মধ্যে স্বস্তি ও আবেগের সৃষ্টি হয়ে&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/khulna/983049/%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%BF-%E0%A6%AC%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A6%AE%E0%A7%9F-%E0%A6%9A%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%9C%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A7%8B%E0%A6%B2%E0%A7%87-%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>প্রোটিয়াদের রানের পাহাড়</title>
      <link>https://www.banglatribune.com/sport/cricket/983048/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%9F%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A7%9C</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/cricket/983048/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%9F%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A7%9C</guid>
      <pubDate>Tue, 24 Nov 2026 22:26:41 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/2e7be1829ae8a0f4cd1c84ed75515a85-6b05bab8cc9c0.jpg?jadewits_media_id=1056774" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/2e7be1829ae8a0f4cd1c84ed75515a85-6b05bab8cc9c0.jpg?jadewits_media_id=1056774" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/2e7be1829ae8a0f4cd1c84ed75515a85-6b05bab8cc9c0.jpg?jadewits_media_id=1056774" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রোটিয়াদের রানের পাহাড়" /&gt;&lt;/p&gt;&lt;p&gt;সেঞ্চুরিয়ন টেস্টে টানা দ্বিতীয় দিন দাপট দেখালো দক্ষিণ আফ্রিকা। ৯৭ ওভার বোলিং করে ৬টি উইকেট নিতে পেরেছে বাংলাদেশ। বিপরীতে রানের পাহাড় গড়েছে স্বাগতিক দল। মার্কেস অ্যাকারম্যান ও ভিয়ান মুল্ডারের সেঞ্চুরিতে ভর করে ৭ উইকেটে ৪৯৪ রানে দ্বিতীয় দিন শেষ করেছে দক্ষিণ আফ্রিকা। তাদের লিড এখন ৪০৩ রানের।&amp;nbsp;
দিনে&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/cricket/983048/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%9F%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A7%9C">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>খুন হচ্ছে পুলিশ, পুড়ছে থানা: নিরাপত্তা নিয়ে উদ্বিগ্ন মানুষ</title>
      <link>https://www.banglatribune.com/law-and-crime/983047/%E0%A6%96%E0%A7%81%E0%A6%A8-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%AA%E0%A7%81%E0%A6%A1%E0%A6%BC%E0%A6%9B%E0%A7%87-%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/983047/%E0%A6%96%E0%A7%81%E0%A6%A8-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%AA%E0%A7%81%E0%A6%A1%E0%A6%BC%E0%A6%9B%E0%A7%87-%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87</guid>
      <pubDate>Tue, 24 Nov 2026 22:16:12 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/1c416c0a3670223cc783605bcb9c015b-6afea6456af16.jpg?jadewits_media_id=1055830" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/1c416c0a3670223cc783605bcb9c015b-6afea6456af16.jpg?jadewits_media_id=1055830" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/1c416c0a3670223cc783605bcb9c015b-6afea6456af16.jpg?jadewits_media_id=1055830" style="max-width:100%;height:auto;margin-bottom:10px;" alt="খুন হচ্ছে পুলিশ, পুড়ছে থানা: নিরাপত্তা নিয়ে উদ্বিগ্ন মানুষ" /&gt;&lt;/p&gt;&lt;p&gt;অপরাধী ধরতে গিয়ে খুন হচ্ছেন পুলিশ সদস্য। হাতকড়া পরানো আসামিকে ছিনিয়ে নেওয়া হচ্ছে পুলিশের কাছ থেকে। হামলা হচ্ছে টহল দলের ওপর। লুট হচ্ছে সরকারি অস্ত্র ও আগুনে পুড়ছে বিভিন্ন থানা। যে বাহিনীর ওপর মানুষের জানমালের নিরাপত্তা নিশ্চিত করার দায়িত্ব, সেই বাহিনীর সদস্যদের নিরাপত্তাই এখন বড় প্রশ্ন হয়ে দাঁড়িয়েছে&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/983047/%E0%A6%96%E0%A7%81%E0%A6%A8-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%AA%E0%A7%81%E0%A6%A1%E0%A6%BC%E0%A6%9B%E0%A7%87-%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>মাথায় ও বুকে গুলি করে আওয়ামী লীগ নেতাকে হত্যা</title>
      <link>https://www.banglatribune.com/country/khulna/983046/%E0%A6%AE%E0%A6%BE%E0%A6%A5%E0%A6%BE%E0%A7%9F-%E0%A6%93-%E0%A6%AC%E0%A7%81%E0%A6%95%E0%A7%87-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/khulna/983046/%E0%A6%AE%E0%A6%BE%E0%A6%A5%E0%A6%BE%E0%A7%9F-%E0%A6%93-%E0%A6%AC%E0%A7%81%E0%A6%95%E0%A7%87-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE</guid>
      <pubDate>Tue, 24 Nov 2026 22:10:27 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/395c63ea7872ee6e08c81c97763f39b3-6b05b146970c3.jpg?jadewits_media_id=1056770" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/395c63ea7872ee6e08c81c97763f39b3-6b05b146970c3.jpg?jadewits_media_id=1056770" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/395c63ea7872ee6e08c81c97763f39b3-6b05b146970c3.jpg?jadewits_media_id=1056770" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মাথায় ও বুকে গুলি করে আওয়ামী লীগ নেতাকে হত্যা" /&gt;&lt;/p&gt;&lt;p&gt;খুলনায় গুলিতে হালিম শেখ (৪৫) নামে কার্যক্রম নিষিদ্ধ এক আওয়ামী লীগ নেতা নিহত হয়েছেন। মঙ্গলবার (২৪ নভেম্বর) রাত ৮টার দিকে দৌলতপুর থানার কল্পতরু মার্কেট এলাকায় এ ঘটনা ঘটে। গুলিবিদ্ধ ও রক্তাক্ত অবস্থায় তাকে খুলনা মেডিক্যাল কলেজ হাসপাতালে নেওয়া হলে চিকিৎসকরা পরীক্ষার পর তাকে মৃত ঘোষণা করেন।
নিহত আব্দুল &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/khulna/983046/%E0%A6%AE%E0%A6%BE%E0%A6%A5%E0%A6%BE%E0%A7%9F-%E0%A6%93-%E0%A6%AC%E0%A7%81%E0%A6%95%E0%A7%87-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE">বাংলা ট্রিবিউন</source>

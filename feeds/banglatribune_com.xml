    <item>
      <title>আম্পায়ারদের সঙ্গে অসদাচরণ, হৃদয়ের শাস্তি</title>
      <link>https://www.banglatribune.com/sport/cricket/982156/%E0%A6%86%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%85%E0%A6%B8%E0%A6%A6%E0%A6%BE%E0%A6%9A%E0%A6%B0%E0%A6%A3-%E0%A6%B9%E0%A7%83%E0%A6%A6%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/cricket/982156/%E0%A6%86%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%85%E0%A6%B8%E0%A6%A6%E0%A6%BE%E0%A6%9A%E0%A6%B0%E0%A6%A3-%E0%A6%B9%E0%A7%83%E0%A6%A6%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BF</guid>
      <pubDate>Fri, 20 Nov 2026 16:03:57 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/ff70466cb59e70844f37b6f26ae33403-6b001acb147d0.jpg?jadewits_media_id=1056013" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/ff70466cb59e70844f37b6f26ae33403-6b001acb147d0.jpg?jadewits_media_id=1056013" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/ff70466cb59e70844f37b6f26ae33403-6b001acb147d0.jpg?jadewits_media_id=1056013" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আম্পায়ারদের সঙ্গে অসদাচরণ, হৃদয়ের শাস্তি" /&gt;&lt;/p&gt;&lt;p&gt;জোহানেসবার্গ টেস্টে আম্পায়ারদের সিদ্ধান্তের প্রতি অসন্তোষ প্রকাশ করে আইসিসির আচরণবিধি ভঙ্গ করেছেন বাংলাদেশের ব্যাটার তাওহীদ হৃদয়। এ অপরাধে তার ম্যাচ ফির ৪০ শতাংশ জরিমানা করেছে আন্তর্জাতিক ক্রিকেট কাউন্সিল (আইসিসি)। পাশাপাশি তার শৃঙ্খলাজনিত রেকর্ডে যুক্ত হয়েছে দুটি ডিমেরিট পয়েন্ট।
খেলোয়াড় ও সাপোর্ট স&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/cricket/982156/%E0%A6%86%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%85%E0%A6%B8%E0%A6%A6%E0%A6%BE%E0%A6%9A%E0%A6%B0%E0%A6%A3-%E0%A6%B9%E0%A7%83%E0%A6%A6%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BF">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>আন্তর্জাতিক আদালতের রায়ের প্রতিক্রিয়ায় যা বললো মিয়ানমার</title>
      <link>https://www.banglatribune.com/foreign/asia/982155/%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%86%E0%A6%A6%E0%A6%BE%E0%A6%B2%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%AF%E0%A6%BE-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A7%8B</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/asia/982155/%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%86%E0%A6%A6%E0%A6%BE%E0%A6%B2%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%AF%E0%A6%BE-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A7%8B</guid>
      <pubDate>Fri, 20 Nov 2026 15:59:51 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/5b4c29904194865ac55659085500ec7e-6b0019da116c5.jpg?jadewits_media_id=1056012" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/5b4c29904194865ac55659085500ec7e-6b0019da116c5.jpg?jadewits_media_id=1056012" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/5b4c29904194865ac55659085500ec7e-6b0019da116c5.jpg?jadewits_media_id=1056012" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আন্তর্জাতিক আদালতের রায়ের প্রতিক্রিয়ায় যা বললো মিয়ানমার" /&gt;&lt;/p&gt;&lt;p&gt;রোহিঙ্গা জনগোষ্ঠীর ওপর গণহত্যার দায়ে মিয়ানমারকে দায়ী করে আন্তর্জাতিক বিচার আদালতের (আইসিজে) দেওয়া ঐতিহাসিক রায়কে &amp;lsquo;ন্যায্য নয়&amp;rsquo; বলে মন্তব্য করেছে দেশটির প্রেসিডেন্টের মুখপাত্র। বৃহস্পতিবার ১৫ বিচারকের মধ্যে ৯-৬ ভোটে দেওয়া রায়ে মিয়ানমারের বিরুদ্ধে রোহিঙ্গাদের ওপর নৃশংসতার প্রমাণ তুলে ধরে আদ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/asia/982155/%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%86%E0%A6%A6%E0%A6%BE%E0%A6%B2%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%AF%E0%A6%BE-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A7%8B">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ভারতকে ‘সাইড প্লেয়ার’ বললেন রাহুল, পাল্টা বিজেপির ‘পাকিস্তানপ্রেমী’ খোঁচা</title>
      <link>https://www.banglatribune.com/foreign/india/982154/%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A6%95%E0%A7%87-%E2%80%98%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%A1-%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A7%87%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%B0%E2%80%99-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%B0%E0%A6%BE%E0%A6%B9%E0%A7%81%E0%A6%B2-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%AA%E0%A6%BF%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/india/982154/%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A6%95%E0%A7%87-%E2%80%98%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%A1-%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A7%87%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%B0%E2%80%99-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%B0%E0%A6%BE%E0%A6%B9%E0%A7%81%E0%A6%B2-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%AA%E0%A6%BF%E0%A6%B0</guid>
      <pubDate>Fri, 20 Nov 2026 15:56:59 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/05/13/0a6ffbcb7b350a1c6442316c7a1f7e7b-6a03f8166e9c0.jpg?jadewits_media_id=1023523" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/05/13/0a6ffbcb7b350a1c6442316c7a1f7e7b-6a03f8166e9c0.jpg?jadewits_media_id=1023523" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/05/13/0a6ffbcb7b350a1c6442316c7a1f7e7b-6a03f8166e9c0.jpg?jadewits_media_id=1023523" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভারতকে ‘সাইড প্লেয়ার’ বললেন রাহুল, পাল্টা বিজেপির ‘পাকিস্তানপ্রেমী’ খোঁচা" /&gt;&lt;/p&gt;&lt;p&gt;বিশ্ব রাজনীতিতে ভারতের প্রভাব কমে যাচ্ছে এবং গুরুত্বপূর্ণ আন্তর্জাতিক আলোচনায় দেশটি ক্রমেই গুরুত্ব হারাচ্ছে বলে মন্তব্য করেছেন কংগ্রেস নেতা ও লোকসভার বিরোধীদলীয় নেতা রাহুল গান্ধী। তার দাবি, ভারত যখন বৈশ্বিক ভূরাজনীতিতে &amp;lsquo;পার্শ্বচরিত্র&amp;rsquo; হয়ে পড়ছে, তখন পাকিস্তান যুক্তরাষ্ট্র ও ইরানের মতো গুর&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/india/982154/%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A6%95%E0%A7%87-%E2%80%98%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%A1-%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A7%87%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%B0%E2%80%99-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%B0%E0%A6%BE%E0%A6%B9%E0%A7%81%E0%A6%B2-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%AA%E0%A6%BF%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>‘সাগরে মাছ নেই, ঘরে টাকা নেই’, ঋণের বোঝায় বিপর্যস্ত জেলেরা</title>
      <link>https://www.banglatribune.com/country/khulna/982152/%E2%80%98%E0%A6%B8%E0%A6%BE%E0%A6%97%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%9B-%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%98%E0%A6%B0%E0%A7%87-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%A8%E0%A7%87%E0%A6%87%E2%80%99-%E0%A6%8B%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%8B%E0%A6%9D%E0%A6%BE%E0%A7%9F</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/khulna/982152/%E2%80%98%E0%A6%B8%E0%A6%BE%E0%A6%97%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%9B-%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%98%E0%A6%B0%E0%A7%87-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%A8%E0%A7%87%E0%A6%87%E2%80%99-%E0%A6%8B%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%8B%E0%A6%9D%E0%A6%BE%E0%A7%9F</guid>
      <pubDate>Fri, 20 Nov 2026 15:50:54 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/a9ef8c09fb98e6672efc1c8d64bcdf78-6b0017e7076c0.jpg?jadewits_media_id=1056010" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/a9ef8c09fb98e6672efc1c8d64bcdf78-6b0017e7076c0.jpg?jadewits_media_id=1056010" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/a9ef8c09fb98e6672efc1c8d64bcdf78-6b0017e7076c0.jpg?jadewits_media_id=1056010" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘সাগরে মাছ নেই, ঘরে টাকা নেই’, ঋণের বোঝায় বিপর্যস্ত জেলেরা" /&gt;&lt;/p&gt;&lt;p&gt;সুন্দরবনের শেষ প্রান্তে সাগরের মোহনায় অবস্থিত দুবলার চরে ঘূর্ণিঝড় আকভানের প্রভাবে উত্তাল হয়ে উঠেছে সাগর। উপকূলে আছড়ে পড়ছে বড় বড় ঢেউ। টানা বৃষ্টি ও রোদের অভাবে চাতালে শুকাতে দেওয়া বিপুল পরিমাণ মাছ পচে নষ্ট হচ্ছে। শুঁটকি মৌসুমের শুরুতেই পরপর তিনটি ঘূর্ণিঝড়ের প্রভাবে বিপর্যস্ত হয়ে পড়েছেন সেখানে অবস্থান&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/khulna/982152/%E2%80%98%E0%A6%B8%E0%A6%BE%E0%A6%97%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%9B-%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%98%E0%A6%B0%E0%A7%87-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%A8%E0%A7%87%E0%A6%87%E2%80%99-%E0%A6%8B%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%8B%E0%A6%9D%E0%A6%BE%E0%A7%9F">বাংলা ট্রিবিউন</source>
    </item>

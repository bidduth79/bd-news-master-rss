      <guid isPermaLink="true">https://www.banglatribune.com/entertainment/dhallywood/982162/%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AE%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%B8%E0%A7%81%E0%A6%96%E0%A6%AC%E0%A6%B0-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AC%E0%A7%81%E0%A6%AC%E0%A6%B2%E0%A7%80</guid>

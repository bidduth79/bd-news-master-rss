    <item>
      <title>বাবা হত্যার প্রতিশোধ, রাজস্থানে ৭ বছর পর খুনিকে কুঠার দিয়ে হত্যা ছেলের</title>
      <link>https://www.banglatribune.com/foreign/asia/980463/%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A6%BE-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B6%E0%A7%8B%E0%A6%A7-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A7%AD-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%96%E0%A7%81%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/asia/980463/%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A6%BE-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B6%E0%A7%8B%E0%A6%A7-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A7%AD-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%96%E0%A7%81%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%87</guid>
      <pubDate>Thu, 12 Nov 2026 14:22:48 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/78ee6a21b4d83a39ad643b9eccbd9119-6af57726651dd.jpg?jadewits_media_id=1054608" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/78ee6a21b4d83a39ad643b9eccbd9119-6af57726651dd.jpg?jadewits_media_id=1054608" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/78ee6a21b4d83a39ad643b9eccbd9119-6af57726651dd.jpg?jadewits_media_id=1054608" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাবা হত্যার প্রতিশোধ, রাজস্থানে ৭ বছর পর খুনিকে কুঠার দিয়ে হত্যা ছেলের" /&gt;&lt;/p&gt;&lt;p&gt;ভারতের রাজস্থানের জয়পুরে সাত বছরের পুরনো একটি হত্যাকাণ্ডের প্রতিশোধ নিতে এক ব্যক্তিকে কুড়াল দিয়ে কুপিয়ে হত্যা করা হয়েছে। অভিযুক্ত ব্যক্তি এক খুনের শিকার ব্যক্তির ছেলে। জগদম্বা নগর এলাকায় দুই পক্ষের ব্যক্তিগত শত্রুতার জেরে এ ঘটনা ঘটে।
পুলিশ জানায়, অপরাধের রেকর্ড থাকা বিজয় বাজিয়া ২০১৯ সালে এক&lt;/p&gt;</description>

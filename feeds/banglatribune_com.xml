      <title>নাশকতার উদ্দেশ্যে সীমান্ত দিয়ে ঢাকায় গান পাউডার আসছে: ডিবি</title>
      <link>https://www.banglatribune.com/law-and-crime/981763/%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%B8%E0%A7%80%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A6%BE%E0%A6%A8-%E0%A6%AA%E0%A6%BE%E0%A6%89%E0%A6%A1%E0%A6%BE%E0%A6%B0</link>

      <guid isPermaLink="true">https://www.banglatribune.com/foreign/usa/979733/%E0%A6%9C%E0%A6%A8%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%A4%E0%A6%BE-%E0%A6%A8%E0%A6%AF%E0%A6%BC-%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%AE%E0%A6%BE%E0%A6%A3%E0%A7%81-%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%95%E0%A6%BF-%E0%A6%A0%E0%A7%87%E0%A6%95%E0%A6%BE%E0%A6%A8%E0%A7%8B%E0%A6%87-%E0%A6%9B%E0%A6%BF%E0%A6%B2</guid>
      <pubDate>Mon, 09 Nov 2026 10:11:52 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/b55fb7aa86b239348164778c0857b330-6af1479c0e838.jpg?jadewits_media_id=1053976" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/b55fb7aa86b239348164778c0857b330-6af1479c0e838.jpg?jadewits_media_id=1053976" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/b55fb7aa86b239348164778c0857b330-6af1479c0e838.jpg?jadewits_media_id=1053976" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জনপ্রিয়তা নয়, ইরানের পরমাণু হুমকি ঠেকানোই ছিল ট্রাম্পের লক্ষ্য: রুবিও" /&gt;&lt;/p&gt;&lt;p&gt;ইরানের পারমাণবিক উচ্চাকাঙ্ক্ষা থেকে বিশ্বকে সুরক্ষিত রাখতেই মার্কিন প্রেসিডেন্ট ডোনাল্ড ট্রাম্প দেশটির বিরুদ্ধে যুদ্ধ শুরু করেছিলেন বলে মন্তব্য করেছেন মার্কিন পররাষ্ট্রমন্ত্রী মার্কো রুবিও। তিনি বলেছেন, যুদ্ধ শুরুর সিদ্ধান্তটি হয়তো জনপ্রিয় ছিল না, তবে যুক্তরাষ্ট্রের নিরাপত্তার স্বার্থে তা প্রয়োজনীয় &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/usa/979733/%E0%A6%9C%E0%A6%A8%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%A4%E0%A6%BE-%E0%A6%A8%E0%A6%AF%E0%A6%BC-%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%AE%E0%A6%BE%E0%A6%A3%E0%A7%81-%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%95%E0%A6%BF-%E0%A6%A0%E0%A7%87%E0%A6%95%E0%A6%BE%E0%A6%A8%E0%A7%8B%E0%A6%87-%E0%A6%9B%E0%A6%BF%E0%A6%B2">বাংলা ট্রিবিউন</source>

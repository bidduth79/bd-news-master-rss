      <guid isPermaLink="true">https://www.banglatribune.com/country/chitagong/980141/%E0%A6%8F%E0%A6%95-%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A7%80%E0%A6%B0-%E0%A7%AD%E0%A7%AA-%E0%A6%9C%E0%A6%AE%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A6%B2%E0%A6%BF%E0%A6%B2-%E0%A6%B0%E0%A7%87%E0%A6%9C%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BF-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE</guid>
      <pubDate>Tue, 10 Nov 2026 23:23:03 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/94fbc5f6ea592b4f5d751591d6f1dff2-6af352d32aeb0.jpg?jadewits_media_id=1054319" length="0" type="image/jpeg" />

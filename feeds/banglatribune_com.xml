    <item>
      <title>রোহিঙ্গাদের মধ্যে নতুন আশা, দেশে ফেরার পথ কতটা খুললো?</title>
      <link>https://www.banglatribune.com/country/chitagong/982243/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%86%E0%A6%B6%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%A5-%E0%A6%95%E0%A6%A4%E0%A6%9F%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/chitagong/982243/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%86%E0%A6%B6%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%A5-%E0%A6%95%E0%A6%A4%E0%A6%9F%E0%A6%BE</guid>
      <pubDate>Sat, 21 Nov 2026 00:00:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/cfcec904c5b6529304c671305b45a083-6b006c782246c.jpg?jadewits_media_id=1056101" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/cfcec904c5b6529304c671305b45a083-6b006c782246c.jpg?jadewits_media_id=1056101" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/cfcec904c5b6529304c671305b45a083-6b006c782246c.jpg?jadewits_media_id=1056101" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রোহিঙ্গাদের মধ্যে নতুন আশা, দেশে ফেরার পথ কতটা খুললো?" /&gt;&lt;/p&gt;&lt;p&gt;রোহিঙ্গাদের ওপর মিয়ানমার সরকারি বাহিনীর চালানো নিপীড়নের ঘটনায় দেশটিকে দোষী সাব্যস্ত করেছে আন্তর্জাতিক বিচার আদালত (আইসিজে)। মিয়ানমারের &amp;lsquo;গণহত্যার উদ্দেশ্য&amp;rsquo; ছিল বলেও রায়ে উল্লেখ করা হয়েছে। এই রায়ের পর বাংলাদেশের আশ্রিত রোহিঙ্গা শিবিরে নতুন আশার সঞ্চার হয়েছে। তারা রায়ের বাস্তবায়নের পাশাপাশি&lt;/p&gt;</description>

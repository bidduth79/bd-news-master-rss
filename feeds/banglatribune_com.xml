      <guid isPermaLink="true">https://www.banglatribune.com/sport/football/980961/%E0%A6%AD%E0%A7%81%E0%A6%9F%E0%A6%BE%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A7%AA-%E0%A6%97%E0%A7%8B%E0%A6%B2%E0%A7%87-%E0%A6%89%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AA%E0%A7%81%E0%A6%9F%E0%A7%87-%E0%A6%9C%E0%A7%9F</guid>

      <guid isPermaLink="true">https://www.banglatribune.com/national/981234/%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A7%9F-%E0%A6%A6%E0%A6%BF%E0%A6%AC%E0%A6%B8%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%9B%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%9A%E0%A6%BF%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%9C%E0%A7%8B%E0%A6%B0</guid>
      <pubDate>Mon, 16 Nov 2026 14:07:32 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/d08fce5d928e5eab3892426218dbcceb-6afab999b4df4.jpg?jadewits_media_id=1055248" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/d08fce5d928e5eab3892426218dbcceb-6afab999b4df4.jpg?jadewits_media_id=1055248" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/d08fce5d928e5eab3892426218dbcceb-6afab999b4df4.jpg?jadewits_media_id=1055248" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিজয় দিবসে নিশ্ছিদ্র নিরাপত্তা নিশ্চিতের ওপর জোর স্বরাষ্ট্রমন্ত্রীর" /&gt;&lt;/p&gt;&lt;p&gt;মহান বিজয় দিবস উদযাপন ঘিরে কোনও ধরনের বিশৃঙ্খলা বা অনভিপ্রেত পরিস্থিতি এড়াতে গোয়েন্দা নজরদারি জোরদার এবং জাতীয় স্মৃতিসৌধসহ দেশের সব অনুষ্ঠানস্থলে নিশ্ছিদ্র নিরাপত্তা নিশ্চিত করার ওপর গুরুত্ব দিয়েছেন স্বরাষ্ট্রমন্ত্রী সালাহ উদ্দিন আহমদ। এ লক্ষ্যে আইনশৃঙ্খলা রক্ষাকারী বাহিনী ও গোয়েন্দা সংস্থাগুলোর মধ্&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/981234/%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A7%9F-%E0%A6%A6%E0%A6%BF%E0%A6%AC%E0%A6%B8%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%9B%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%9A%E0%A6%BF%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%9C%E0%A7%8B%E0%A6%B0">বাংলা ট্রিবিউন</source>

      <guid isPermaLink="true">https://www.banglatribune.com/country/barishal/979699/%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%9C%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%BE-%E0%A6%A8%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%A0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%A6%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87</guid>
      <pubDate>Sun, 08 Nov 2026 23:12:01 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/bdd62990c79963965a297b2392646f80-6af0ad5a735c8.jpg?jadewits_media_id=1053948" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/bdd62990c79963965a297b2392646f80-6af0ad5a735c8.jpg?jadewits_media_id=1053948" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/bdd62990c79963965a297b2392646f80-6af0ad5a735c8.jpg?jadewits_media_id=1053948" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাস্তার কাজে চাঁদা না দেওয়ায় ঠিকাদারের গাড়ি নিয়ে গেলেন বিএনপি নেতা" /&gt;&lt;/p&gt;&lt;p&gt;বরিশালের বাবুগঞ্জ উপজেলার মাধবপাশা ইউনিয়নে সড়ক নির্মাণ কাজে বাধা দিয়ে ঠিকাদারের কাছে ৩ লাখ টাকা চাঁদা দাবি করেছেন স্থানীয় এক বিএনপি নেতাসহ চার জন। শেষ পর্যন্ত চাঁদা না দেওয়ায় ঠিকাদারের ছেলেকে মারধর করে তার ব্যবহৃত মোটরসাইকেল নিয়ে যান অভিযুক্তরা। ওই মোটরসাইকেলের দাম ১ লাখ টাকা ধরে আরও ২ লাখ টাকা চ&lt;/p&gt;</description>

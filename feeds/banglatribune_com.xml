    <item>
      <title>বিনোদন-অ্যাডভেঞ্চারে সাজছে কক্সবাজার, চলবে তিন মাস কার্নিভাল</title>
      <link>https://www.banglatribune.com/country/chitagong/982620/%E0%A6%AC%E0%A6%BF%E0%A6%A8%E0%A7%8B%E0%A6%A6%E0%A6%A8-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A1%E0%A6%AD%E0%A7%87%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%9C%E0%A6%9B%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%9A%E0%A6%B2%E0%A6%AC%E0%A7%87-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/chitagong/982620/%E0%A6%AC%E0%A6%BF%E0%A6%A8%E0%A7%8B%E0%A6%A6%E0%A6%A8-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A1%E0%A6%AD%E0%A7%87%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%9C%E0%A6%9B%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%9A%E0%A6%B2%E0%A6%AC%E0%A7%87-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B8</guid>
      <pubDate>Mon, 23 Nov 2026 00:10:05 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/aa9bfd032f7b659f0245974a4b11f7b6-6b032ff31de99.jpg?jadewits_media_id=1056421" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/aa9bfd032f7b659f0245974a4b11f7b6-6b032ff31de99.jpg?jadewits_media_id=1056421" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/aa9bfd032f7b659f0245974a4b11f7b6-6b032ff31de99.jpg?jadewits_media_id=1056421" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিনোদন-অ্যাডভেঞ্চারে সাজছে কক্সবাজার, চলবে তিন মাস কার্নিভাল" /&gt;&lt;/p&gt;&lt;p&gt;পর্যটন মৌসুমকে ঘিরে কক্সবাজারে শুরু হয়েছে তিন মাসব্যাপী &amp;lsquo;পর্যটন কার্নিভাল-২০২৬&amp;rsquo;। বিশ্বের দীর্ঘতম সমুদ্রসৈকতকে কেন্দ্র করে আয়োজিত এ কার্নিভালে পর্যটকদের জন্য রাখা হয়েছে বিনোদন, সংস্কৃতি ও অ্যাডভেঞ্চারভিত্তিক নানা আয়োজন। আয়োজকদের প্রত্যাশা, এ উদ্যোগ দেশি-বিদেশি পর্যটকের আগমন বাড়ানোর পাশাপা&lt;/p&gt;</description>

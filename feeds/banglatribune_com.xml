    <item>
      <title>আর্জেন্টিনা দলে কার ওপর ‘আলাদাভাবে যত্ন’ নেওয়ার প্রতিশ্রুতি দিলেন স্ক্যালোনি</title>
      <link>https://www.banglatribune.com/sport/football/981753/%E0%A6%86%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%A8%E0%A6%BE-%E0%A6%A6%E0%A6%B2%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E2%80%98%E0%A6%86%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A6%BE%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%AF%E0%A6%A4%E0%A7%8D%E0%A6%A8%E2%80%99-%E0%A6%A8%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/football/981753/%E0%A6%86%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%A8%E0%A6%BE-%E0%A6%A6%E0%A6%B2%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E2%80%98%E0%A6%86%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A6%BE%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%AF%E0%A6%A4%E0%A7%8D%E0%A6%A8%E2%80%99-%E0%A6%A8%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Wed, 18 Nov 2026 18:11:29 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/842a870192393ff1487eead6e695ed7f-6afd95e651e65.jpg?jadewits_media_id=1055690" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/842a870192393ff1487eead6e695ed7f-6afd95e651e65.jpg?jadewits_media_id=1055690" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/842a870192393ff1487eead6e695ed7f-6afd95e651e65.jpg?jadewits_media_id=1055690" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আর্জেন্টিনা দলে কার ওপর ‘আলাদাভাবে যত্ন’ নেওয়ার প্রতিশ্রুতি দিলেন স্ক্যালোনি" /&gt;&lt;/p&gt;&lt;p&gt;লিওনেল মেসির পর আর্জেন্টিনার ভবিষ্যৎ দল গড়ার পরিকল্পনায় তরুণদের ওপর ভরসা রাখছেন কোচ লিওনেল স্ক্যালোনি। সেই তালিকায় অন্যতম গুরুত্বপূর্ণ নাম নিকো পাজ। ২২ বছর বয়সী এই মিডফিল্ডারের প্রতিভায় মুগ্ধ বিশ্বকাপজয়ী কোচ। তবে এখনই তার কাঁধে বড় দায়িত্ব চাপিয়ে দিতে চান না স্ক্যালোনি। বরং পাজের বিকাশে আলাদাভাবে যত্&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/football/981753/%E0%A6%86%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%A8%E0%A6%BE-%E0%A6%A6%E0%A6%B2%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E2%80%98%E0%A6%86%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A6%BE%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%AF%E0%A6%A4%E0%A7%8D%E0%A6%A8%E2%80%99-%E0%A6%A8%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0">বাংলা ট্রিবিউন</source>

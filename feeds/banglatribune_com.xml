    <item>
      <title>কী কী শর্তে এলএনজি টার্মিনালের কাজ পেলো চীনা কোম্পানি</title>
      <link>https://www.banglatribune.com/business/power-and-fuel/981613/%E0%A6%95%E0%A7%80-%E0%A6%95%E0%A7%80-%E0%A6%B6%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A7%87-%E0%A6%8F%E0%A6%B2%E0%A6%8F%E0%A6%A8%E0%A6%9C%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%9C-%E0%A6%AA%E0%A7%87%E0%A6%B2%E0%A7%8B-%E0%A6%9A%E0%A7%80%E0%A6%A8%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/business/power-and-fuel/981613/%E0%A6%95%E0%A7%80-%E0%A6%95%E0%A7%80-%E0%A6%B6%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A7%87-%E0%A6%8F%E0%A6%B2%E0%A6%8F%E0%A6%A8%E0%A6%9C%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%9C-%E0%A6%AA%E0%A7%87%E0%A6%B2%E0%A7%8B-%E0%A6%9A%E0%A7%80%E0%A6%A8%E0%A6%BE</guid>
      <pubDate>Wed, 18 Nov 2026 08:42:49 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/07/31/0ed6c02c566de3e7fe9f4f51f84c459a-6a6ca3078b03b.jpg?jadewits_media_id=1036213" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/07/31/0ed6c02c566de3e7fe9f4f51f84c459a-6a6ca3078b03b.jpg?jadewits_media_id=1036213" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/07/31/0ed6c02c566de3e7fe9f4f51f84c459a-6a6ca3078b03b.jpg?jadewits_media_id=1036213" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কী কী শর্তে এলএনজি টার্মিনালের কাজ পেলো চীনা কোম্পানি" /&gt;&lt;/p&gt;&lt;p&gt;চায়না ন্যাশনাল এনার্জি ইঞ্জিনিয়ারিং অ্যান্ড কনস্ট্রাকশন কোম্পানি (সিএনইই) দেশে তৃতীয় এলএনজি টার্মিনাল নির্মাণ এবং পরিচালনার দায়িত্ব পাচ্ছে। সম্প্রতি সরকারের ক্রয় সংক্রান্ত মন্ত্রিসভা কমিটি সিএনইই’র প্রস্তাব অনুমোদন করেছে।
মহেশখালীর কুতুবজোমে ভাসমান টার্মিনালটি নির্মাণ করা হবে। এর আগেও মহেশখালীতে দুট&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/business/power-and-fuel/981613/%E0%A6%95%E0%A7%80-%E0%A6%95%E0%A7%80-%E0%A6%B6%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A7%87-%E0%A6%8F%E0%A6%B2%E0%A6%8F%E0%A6%A8%E0%A6%9C%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%9C-%E0%A6%AA%E0%A7%87%E0%A6%B2%E0%A7%8B-%E0%A6%9A%E0%A7%80%E0%A6%A8%E0%A6%BE">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>বাংলাদেশ নাট্যোৎসবে হুমায়ূন আহমেদের ‘নৃপতি’</title>
      <link>https://www.banglatribune.com/entertainment/stage/981534/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%A8%E0%A6%BE%E0%A6%9F%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A7%8E%E0%A6%B8%E0%A6%AC%E0%A7%87-%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A7%82%E0%A6%A8-%E0%A6%86%E0%A6%B9%E0%A6%AE%E0%A7%87%E0%A6%A6%E0%A7%87%E0%A6%B0-%E2%80%98%E0%A6%A8%E0%A7%83%E0%A6%AA%E0%A6%A4%E0%A6%BF%E2%80%99</link>
      <guid isPermaLink="true">https://www.banglatribune.com/entertainment/stage/981534/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%A8%E0%A6%BE%E0%A6%9F%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A7%8E%E0%A6%B8%E0%A6%AC%E0%A7%87-%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A7%82%E0%A6%A8-%E0%A6%86%E0%A6%B9%E0%A6%AE%E0%A7%87%E0%A6%A6%E0%A7%87%E0%A6%B0-%E2%80%98%E0%A6%A8%E0%A7%83%E0%A6%AA%E0%A6%A4%E0%A6%BF%E2%80%99</guid>
      <pubDate>Wed, 18 Nov 2026 08:00:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/77c79f005c06ef5763ff380cd745ec26-6afc40fb22aa8.jpg?jadewits_media_id=1055507" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/77c79f005c06ef5763ff380cd745ec26-6afc40fb22aa8.jpg?jadewits_media_id=1055507" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/77c79f005c06ef5763ff380cd745ec26-6afc40fb22aa8.jpg?jadewits_media_id=1055507" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাংলাদেশ নাট্যোৎসবে হুমায়ূন আহমেদের ‘নৃপতি’" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ থিয়েটারের চার দশক পূর্তি উপলক্ষে আয়োজিত &amp;lsquo;বাংলাদেশ নাট্যোৎসব&amp;rsquo;-এ মঞ্চস্থ হতে যাচ্ছে নান্দনিক নাট্য সম্প্রদায়ের অষ্টম প্রযোজনা &amp;lsquo;নৃপতি&amp;rsquo;। নন্দিত কথাসাহিত্যিক হুমায়ূন আহমেদ রচিত প্রথম মঞ্চনাটক &amp;lsquo;নৃপতি&amp;rsquo;র নির্দেশনায় রয়েছেন বদরুদ্দোজা।
বুধবার (১৮ নভেম্বর) সন্ধ্যা ৬&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/entertainment/stage/981534/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%A8%E0%A6%BE%E0%A6%9F%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A7%8E%E0%A6%B8%E0%A6%AC%E0%A7%87-%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A7%82%E0%A6%A8-%E0%A6%86%E0%A6%B9%E0%A6%AE%E0%A7%87%E0%A6%A6%E0%A7%87%E0%A6%B0-%E2%80%98%E0%A6%A8%E0%A7%83%E0%A6%AA%E0%A6%A4%E0%A6%BF%E2%80%99">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>শক্তি বাড়াচ্ছে ঘূর্ণিঝড় ‘আকভান’, কোথায় কখন আঘাত</title>
      <link>https://www.banglatribune.com/weather/981637/%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%98%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A6%BF%E0%A6%9D%E0%A7%9C-%E2%80%98%E0%A6%86%E0%A6%95%E0%A6%AD%E0%A6%BE%E0%A6%A8%E2%80%99-%E0%A6%95%E0%A7%8B%E0%A6%A5%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A6%96%E0%A6%A8-%E0%A6%86%E0%A6%98%E0%A6%BE%E0%A6%A4</link>
      <guid isPermaLink="true">https://www.banglatribune.com/weather/981637/%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%98%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A6%BF%E0%A6%9D%E0%A7%9C-%E2%80%98%E0%A6%86%E0%A6%95%E0%A6%AD%E0%A6%BE%E0%A6%A8%E2%80%99-%E0%A6%95%E0%A7%8B%E0%A6%A5%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A6%96%E0%A6%A8-%E0%A6%86%E0%A6%98%E0%A6%BE%E0%A6%A4</guid>
      <pubDate>Wed, 18 Nov 2026 07:55:13 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2020/05/17/33d67e2f9d8b2e9e91bd28d031544555-5ec034dc55089.jpg?jadewits_media_id=669463" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2020/05/17/33d67e2f9d8b2e9e91bd28d031544555-5ec034dc55089.jpg?jadewits_media_id=669463" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2020/05/17/33d67e2f9d8b2e9e91bd28d031544555-5ec034dc55089.jpg?jadewits_media_id=669463" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শক্তি বাড়াচ্ছে ঘূর্ণিঝড় ‘আকভান’, কোথায় কখন আঘাত" /&gt;&lt;/p&gt;&lt;p&gt;বঙ্গোপসাগরে সৃষ্ট ঘূর্ণিঝড় &amp;lsquo;আকভান&amp;rsquo; শক্তি বাড়াচ্ছে। এটি দক্ষিণ-পশ্চিম বঙ্গোপসাগর ও তৎসংলগ্ন পশ্চিম-মধ্য বঙ্গোপসাগরে থেকে সামান্য উত্তর-পশ্চিম দিকে অগ্রসর হয়েছে। বর্তমানে এটি একই এলাকায় অবস্থান করছে। বুধবার (১৮ নভেম্বর) আবহাওয়া অধিদফতরের বিশেষ বুলেটিনে এ তথ্য জানানো হয়েছে।&amp;nbsp;
অধিদফতর জা&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/weather/981637/%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%98%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A6%BF%E0%A6%9D%E0%A7%9C-%E2%80%98%E0%A6%86%E0%A6%95%E0%A6%AD%E0%A6%BE%E0%A6%A8%E2%80%99-%E0%A6%95%E0%A7%8B%E0%A6%A5%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A6%96%E0%A6%A8-%E0%A6%86%E0%A6%98%E0%A6%BE%E0%A6%A4">বাংলা ট্রিবিউন</source>

      <title>স্ত্রীকে পিটিয়ে হত্যা করেছিল নুরুল, দেওয়া হলো মৃত্যুদণ্ড</title>
      <link>https://www.banglatribune.com/law-and-crime/982698/%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%BF%E0%A6%9F%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A7%87%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%A8%E0%A7%81%E0%A6%B0%E0%A7%81%E0%A6%B2-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%B9%E0%A6%B2%E0%A7%8B</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/982698/%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%BF%E0%A6%9F%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A7%87%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%A8%E0%A7%81%E0%A6%B0%E0%A7%81%E0%A6%B2-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%B9%E0%A6%B2%E0%A7%8B</guid>
      <pubDate>Mon, 23 Nov 2026 14:03:36 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/a6610fa2b47919331cfca03aa8002ccc-6b03f2449de37.jpg?jadewits_media_id=1056488" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/a6610fa2b47919331cfca03aa8002ccc-6b03f2449de37.jpg?jadewits_media_id=1056488" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/a6610fa2b47919331cfca03aa8002ccc-6b03f2449de37.jpg?jadewits_media_id=1056488" style="max-width:100%;height:auto;margin-bottom:10px;" alt="স্ত্রীকে পিটিয়ে হত্যা করেছিল নুরুল, দেওয়া হলো মৃত্যুদণ্ড" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর মোহাম্মদপুরে স্ত্রী খাবিরুন নেছাকে পিটিয়ে হত্যার দায়ে স্বামী মো. নুরুল আবসারকে মৃত্যুদণ্ড দিয়েছেন আদালত। একইসঙ্গে তাকে ২০ হাজার টাকা অর্থদণ্ড দেওয়া হয়েছে।
সোমবার (২৩ নভেম্বর) ঢাকার অতিরিক্ত মহানগর দায়রা জজ-১৩ আদালতের বিচারক মো. জাহিদুল ইসলাম এ রায় ঘোষণা করেন। রায় ঘোষণার সময় আসামি আদালতে উপস&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/982698/%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%BF%E0%A6%9F%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A7%87%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%A8%E0%A7%81%E0%A6%B0%E0%A7%81%E0%A6%B2-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%B9%E0%A6%B2%E0%A7%8B">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>প্রধানমন্ত্রীর সঙ্গে বৈঠক করতে সচিবালয়ে এনসিপি নেতারা</title>
      <link>https://www.banglatribune.com/politics/ncp/982696/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A6%9A%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B2%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.banglatribune.com/politics/ncp/982696/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A6%9A%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B2%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF</guid>
      <pubDate>Mon, 23 Nov 2026 13:56:21 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/eaad988fd64eed98801161a63249c240-6b03f1143ad39.jpg?jadewits_media_id=1056487" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/eaad988fd64eed98801161a63249c240-6b03f1143ad39.jpg?jadewits_media_id=1056487" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/eaad988fd64eed98801161a63249c240-6b03f1143ad39.jpg?jadewits_media_id=1056487" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রধানমন্ত্রীর সঙ্গে বৈঠক করতে সচিবালয়ে এনসিপি নেতারা" /&gt;&lt;/p&gt;&lt;p&gt;প্রধানমন্ত্রী তারেক রহমানের সঙ্গে মতবিনিময় সভায় অংশ নিতে সচিবালয়ে পৌঁছেছেন জাতীয় নাগরিক পার্টির (এনসিপি) চার সদস্যের একটি প্রতিনিধিদল। সোমবার (২৩ নভেম্বর) দুপুর ১টার দিকে এনসিপির আহ্বায়ক নাহিদ ইসলামের নেতৃত্বে প্রতিনিধিদলটি সচিবালয়ে পৌঁছায়।
কার্যক্রম নিষিদ্ধ থাকা আওয়ামী লীগের নেতাকর্মীদের সা&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/politics/ncp/982696/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A6%9A%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B2%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>চাকরির সাক্ষাৎকার দিতে এসে আটক নিষিদ্ধ ছাত্রলীগের কেন্দ্রীয় নেত্রী</title>
      <link>https://www.banglatribune.com/country/dhaka/982695/%E0%A6%9A%E0%A6%BE%E0%A6%95%E0%A6%B0%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A7%8E%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%8F%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/dhaka/982695/%E0%A6%9A%E0%A6%BE%E0%A6%95%E0%A6%B0%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A7%8E%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%8F%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Mon, 23 Nov 2026 13:53:36 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/4eb29785213641ffabdfed7170f7ecc0-6b03f011cfc5d.jpg?jadewits_media_id=1056485" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/4eb29785213641ffabdfed7170f7ecc0-6b03f011cfc5d.jpg?jadewits_media_id=1056485" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/4eb29785213641ffabdfed7170f7ecc0-6b03f011cfc5d.jpg?jadewits_media_id=1056485" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চাকরির সাক্ষাৎকার দিতে এসে আটক নিষিদ্ধ ছাত্রলীগের কেন্দ্রীয় নেত্রী" /&gt;&lt;/p&gt;&lt;p&gt;সামাজিক যোগাযোগমাধ্যমে হকিস্টিক হাতে নিজের ছবি পোস্ট করে আলোচনায় আসা নিষিদ্ধঘোষিত সংগঠন ছাত্রলীগের কেন্দ্রীয় কমিটির উপ-প্রশিক্ষণবিষয়ক সম্পাদক তানিয়া আক্তার তাপসীকে আটক করেছে পুলিশ। চাকরির সাক্ষাৎকার দিতে গিয়ে তিনি আটক হন।
রবিবার (২২ নভেম্বর) সন্ধ্যায় টঙ্গী বাজার এলাকার সেনা কল্যাণ সংস্থার মার্কেটের &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/dhaka/982695/%E0%A6%9A%E0%A6%BE%E0%A6%95%E0%A6%B0%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A7%8E%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%8F%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>যে মামলায় গ্রেফতার দেখানো হলো সুইডেন আসলামকে</title>
      <link>https://www.banglatribune.com/law-and-crime/982694/%E0%A6%AF%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%B9%E0%A6%B2%E0%A7%8B-%E0%A6%B8%E0%A7%81%E0%A6%87%E0%A6%A1%E0%A7%87%E0%A6%A8-%E0%A6%86%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A6%95%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/982694/%E0%A6%AF%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%B9%E0%A6%B2%E0%A7%8B-%E0%A6%B8%E0%A7%81%E0%A6%87%E0%A6%A1%E0%A7%87%E0%A6%A8-%E0%A6%86%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A6%95%E0%A7%87</guid>
      <pubDate>Mon, 23 Nov 2026 13:42:40 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/91c8ac045c7185a8d72a204108a81739-6b03bfa5b9432.jpg?jadewits_media_id=1056457" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/91c8ac045c7185a8d72a204108a81739-6b03bfa5b9432.jpg?jadewits_media_id=1056457" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/91c8ac045c7185a8d72a204108a81739-6b03bfa5b9432.jpg?jadewits_media_id=1056457" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যে মামলায় গ্রেফতার দেখানো হলো সুইডেন আসলামকে" /&gt;&lt;/p&gt;&lt;p&gt;শীর্ষ সন্ত্রাসী এস এম আসলাম ওরফে সুইডেন আসলামকে রাজধানীর নিউ মার্কেট থানার আরেক সন্ত্রাসী টিটন হত্যা মামলায় গ্রেফতার দেখানো হয়েছে বলে জানিয়েছেন ডিএমপির মিডিয়া বিভাগের উপকমিশনার আকতার হোসেন।
তিনি জানান, তাকে আজই আদালতে তুলে রিমান্ড চাওয়া হবে। সোমবার (২৩ নভেম্বর) দুপুরে ডিবি কার্যালয়ে এক প্রেস ব্রিফ&lt;/p&gt;</description>

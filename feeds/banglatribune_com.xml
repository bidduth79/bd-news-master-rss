      <guid isPermaLink="true">https://www.banglatribune.com/foreign/982054/%E0%A6%AD%E0%A6%BF%E0%A6%B8%E0%A6%BE-%E0%A6%86%E0%A6%AC%E0%A7%87%E0%A6%A6%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A1%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A7%87-%E0%A6%96%E0%A7%81%E0%A6%A8</guid>
      <pubDate>Thu, 19 Nov 2026 23:36:22 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/b810a6c77f7ee90f4afdf71e9e39f9b8-6aff32f9ab210.jpg?jadewits_media_id=1055934" length="0" type="image/jpeg" />

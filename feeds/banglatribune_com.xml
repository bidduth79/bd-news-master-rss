    <item>
      <title>নাশকতা ঠেকাতে সরকারি ও বিরোধী দলের ঐকমত্য সম্ভব?</title>
      <link>https://www.banglatribune.com/politics/980368/%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%BE-%E0%A6%A0%E0%A7%87%E0%A6%95%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%93-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%80-%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%90%E0%A6%95%E0%A6%AE%E0%A6%A4%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AD%E0%A6%AC</link>
      <guid isPermaLink="true">https://www.banglatribune.com/politics/980368/%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%BE-%E0%A6%A0%E0%A7%87%E0%A6%95%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%93-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%80-%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%90%E0%A6%95%E0%A6%AE%E0%A6%A4%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AD%E0%A6%AC</guid>
      <pubDate>Thu, 12 Nov 2026 00:01:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/09/13/b84ce02cf65281706514197e06ec9c6e-6aa6d0ca3b308.jpg?jadewits_media_id=1043602" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/09/13/b84ce02cf65281706514197e06ec9c6e-6aa6d0ca3b308.jpg?jadewits_media_id=1043602" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/09/13/b84ce02cf65281706514197e06ec9c6e-6aa6d0ca3b308.jpg?jadewits_media_id=1043602" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নাশকতা ঠেকাতে সরকারি ও বিরোধী দলের ঐকমত্য সম্ভব?" /&gt;&lt;/p&gt;&lt;p&gt;একদিকে দেশের বিভিন্ন স্থানে ককটেল বিস্ফোরণ, বাসে অগ্নিসংযোগসহ নাশকতার ঘটনা, অন্যদিকে এসব ঘটনায় একে অপরের বিরুদ্ধে আঁতাতের অভিযোগ তুলছে সরকার ও বিরোধী দল। কার্যক্রম নিষিদ্ধ আওয়ামী লীগ ও এর সহযোগী সংগঠনগুলোর কর্মসূচি ঘিরে কয়েক দিন ধরে উত্তপ্ত রাজনৈতিক পরিস্থিতির মধ্যে নতুন করে সামনে এসেছে জাতীয় ঐক্যের&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/politics/980368/%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%BE-%E0%A6%A0%E0%A7%87%E0%A6%95%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%93-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%80-%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%90%E0%A6%95%E0%A6%AE%E0%A6%A4%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AD%E0%A6%AC">বাংলা ট্রিবিউন</source>

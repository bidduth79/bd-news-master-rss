      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2024/12/04/-0768d38bd877cb1f7ba42a9475f07470.JPG?jadewits_media_id=950459" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2024/12/04/-0768d38bd877cb1f7ba42a9475f07470.JPG?jadewits_media_id=950459" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2024/12/04/-0768d38bd877cb1f7ba42a9475f07470.JPG?jadewits_media_id=950459" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সন্ত্রাস ত্যাগের ঘোষণা ছাড়া আওয়ামী লীগ রিকন্সিলিয়েশনের আলাপ অসম্ভব: মাহফুজ" /&gt;&lt;/p&gt;&lt;p&gt;সন্ত্রাস-খুনের রাজনীতি চালিয়ে গেলে শিল্প-বাণিজ্য ধ্বংসের জন্য আওয়ামী লীগ দায়ী থাকবে এবং &amp;nbsp;সন্ত্রাস ত্যাগের ঘোষণা ছাড়া আওয়ামী লীগ রিকন্সিলিয়েশনের আলাপ অসম্ভব বলে মন্তব্য করেছেন সাবেক অন্তর্বর্তী সরকারের উপদেষ্টা মাহফুজ আলম। শুক্রবার (২০ নভেম্বর) রাতে সামাজিক যোগাযোগ মাধ্যমে দেওয়া এক পোস্টে তিনি এ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/politics/other-politics/982256/%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B8-%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%98%E0%A7%8B%E0%A6%B7%E0%A6%A3%E0%A6%BE-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>পাঠদানে এআই নিষিদ্ধ নয়, দায়িত্বশীল ব্যবহারে গুরুত্বারোপ ইউজিসি চেয়ারম্যানের</title>
      <link>https://www.banglatribune.com/educations/982255/%E0%A6%AA%E0%A6%BE%E0%A6%A0%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%8F%E0%A6%86%E0%A6%87-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%A8%E0%A7%9F-%E0%A6%A6%E0%A6%BE%E0%A7%9F%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A6%B6%E0%A7%80%E0%A6%B2-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/educations/982255/%E0%A6%AA%E0%A6%BE%E0%A6%A0%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%8F%E0%A6%86%E0%A6%87-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%A8%E0%A7%9F-%E0%A6%A6%E0%A6%BE%E0%A7%9F%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A6%B6%E0%A7%80%E0%A6%B2-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A7%87</guid>
      <pubDate>Fri, 20 Nov 2026 23:18:38 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/1e120f90938e952d8444bad9385fa13e-6b0080afa8d0b.jpg?jadewits_media_id=1056113" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/1e120f90938e952d8444bad9385fa13e-6b0080afa8d0b.jpg?jadewits_media_id=1056113" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/1e120f90938e952d8444bad9385fa13e-6b0080afa8d0b.jpg?jadewits_media_id=1056113" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পাঠদানে এআই নিষিদ্ধ নয়, দায়িত্বশীল ব্যবহারে গুরুত্বারোপ ইউজিসি চেয়ারম্যানের" /&gt;&lt;/p&gt;&lt;p&gt;শিক্ষার্থীদের লেখালেখি ও শিক্ষকদের পাঠদানে কৃত্রিম বুদ্ধিমত্তার (এআই) ব্যবহার বাড়ছে। এতে শিক্ষার্থীদের কাজের মূল্যায়ন ও অ্যাকাডেমিক সততা রক্ষায় নতুন চ্যালেঞ্জ তৈরি হয়েছে। এআইয়ের ব্যবহার নিষিদ্ধ না করে দায়িত্বশীল, ন্যায়সংগত ও নৈতিক ব্যবহার নিশ্চিত করার ওপর গুরুত্ব দিয়েছেন বাংলাদেশ বিশ্ববিদ্যালয় মঞ্জু&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/educations/982255/%E0%A6%AA%E0%A6%BE%E0%A6%A0%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%8F%E0%A6%86%E0%A6%87-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%A8%E0%A7%9F-%E0%A6%A6%E0%A6%BE%E0%A7%9F%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A6%B6%E0%A7%80%E0%A6%B2-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>সিটি ইউনিভার্সিটিতে আইসিবিসি ২০২৬-এর উদ্বোধন</title>

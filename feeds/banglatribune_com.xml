    <item>
      <title>ঢাকার বাতাস আজ ‘সহনীয়’, লাহোর-দিল্লিতে মারাত্মক ‘ঝুঁকিপূর্ণ’</title>
      <link>https://www.banglatribune.com/weather/980162/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B8-%E0%A6%86%E0%A6%9C-%E2%80%98%E0%A6%B8%E0%A6%B9%E0%A6%A8%E0%A7%80%E0%A7%9F%E2%80%99-%E0%A6%B2%E0%A6%BE%E0%A6%B9%E0%A7%8B%E0%A6%B0-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%AE%E0%A6%95</link>
      <guid isPermaLink="true">https://www.banglatribune.com/weather/980162/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B8-%E0%A6%86%E0%A6%9C-%E2%80%98%E0%A6%B8%E0%A6%B9%E0%A6%A8%E0%A7%80%E0%A7%9F%E2%80%99-%E0%A6%B2%E0%A6%BE%E0%A6%B9%E0%A7%8B%E0%A6%B0-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%AE%E0%A6%95</guid>
      <pubDate>Wed, 11 Nov 2026 08:31:42 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2022/07/01/-b28225b98d187428958bbcb7120ce927.jpg?jadewits_media_id=800614" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2022/07/01/-b28225b98d187428958bbcb7120ce927.jpg?jadewits_media_id=800614" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2022/07/01/-b28225b98d187428958bbcb7120ce927.jpg?jadewits_media_id=800614" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঢাকার বাতাস আজ ‘সহনীয়’, লাহোর-দিল্লিতে মারাত্মক ‘ঝুঁকিপূর্ণ’" /&gt;&lt;/p&gt;&lt;p&gt;ঢাকার বাতাসে কিছুটা উন্নতি হয়েছে আজ। বুধবার (১১ নভেম্বর) আন্তর্জাতিক বায়ুমান পর্যবেক্ষণকারী সংস্থা আইকিউএয়ার-এর সর্বশেষ তথ্য অনুযায়ী, ৪৫৩ একিউআই স্কোর নিয়ে বিশ্বের প্রধান শহরগুলোর মধ্যে দূষণের শীর্ষে রয়েছে পাকিস্তানের লাহোর। তবে এই তালিকায় বাংলাদেশের রাজধানী ঢাকা ৭৮ স্কোর নিয়ে রয়েছে ২৫তম অবস্থানে।
এ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/weather/980162/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B8-%E0%A6%86%E0%A6%9C-%E2%80%98%E0%A6%B8%E0%A6%B9%E0%A6%A8%E0%A7%80%E0%A7%9F%E2%80%99-%E0%A6%B2%E0%A6%BE%E0%A6%B9%E0%A7%8B%E0%A6%B0-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%AE%E0%A6%95">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>পাথর, পাহাড় আর স্বচ্ছ জলধারা, বাংলাদেশের কাশ্মীর খ্যাত এই জায়গা কোথায়</title>
      <link>https://www.banglatribune.com/journey/980035/%E0%A6%AA%E0%A6%BE%E0%A6%A5%E0%A6%B0-%E0%A6%AA%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A7%9C-%E0%A6%86%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%9A%E0%A7%8D%E0%A6%9B-%E0%A6%9C%E0%A6%B2%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B6%E0%A7%8D%E0%A6%AE%E0%A7%80%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/journey/980035/%E0%A6%AA%E0%A6%BE%E0%A6%A5%E0%A6%B0-%E0%A6%AA%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A7%9C-%E0%A6%86%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%9A%E0%A7%8D%E0%A6%9B-%E0%A6%9C%E0%A6%B2%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B6%E0%A7%8D%E0%A6%AE%E0%A7%80%E0%A6%B0</guid>
      <pubDate>Wed, 11 Nov 2026 08:30:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/ab789f2bb3a25ee1d0990aab0edf1a74-6af2f8b1115e9.jpg?jadewits_media_id=1054223" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/ab789f2bb3a25ee1d0990aab0edf1a74-6af2f8b1115e9.jpg?jadewits_media_id=1054223" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/ab789f2bb3a25ee1d0990aab0edf1a74-6af2f8b1115e9.jpg?jadewits_media_id=1054223" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পাথর, পাহাড় আর স্বচ্ছ জলধারা, বাংলাদেশের কাশ্মীর খ্যাত এই জায়গা কোথায়" /&gt;&lt;/p&gt;&lt;p&gt;শুধু ভারত বা পাকিস্তান নয়, বাংলাদেশেও রয়েছে কাশ্মীর। কী অবাক হচ্ছেন? দেশেই এমন এক জায়গা রয়েছে, যার সৌন্দর্য দেখে তাকে বলা হয় বাংলাদেশের কাশ্মীর। সেখানকার পাহাড়, ঝরনা আর পাথুরে নদীর অপরূপ সৌন্দর্যে মুগ্ধ হন পর্যটকেরা। সিলেটের গোয়াইনঘাটে তেমনই এক মনোরম জায়গা লক্ষনছড়া। ভারতের পাহাড়ি ঝরনা থেকে নেমে আসা &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/journey/980035/%E0%A6%AA%E0%A6%BE%E0%A6%A5%E0%A6%B0-%E0%A6%AA%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A7%9C-%E0%A6%86%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%9A%E0%A7%8D%E0%A6%9B-%E0%A6%9C%E0%A6%B2%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B6%E0%A7%8D%E0%A6%AE%E0%A7%80%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ঘরেই বানিয়ে নিন মিষ্টি-মুচমুচে কাঁচা পেঁপের ক্যান্ডি</title>
      <link>https://www.banglatribune.com/lifestyle/980026/%E0%A6%98%E0%A6%B0%E0%A7%87%E0%A6%87-%E0%A6%AC%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%A8-%E0%A6%AE%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF-%E0%A6%AE%E0%A7%81%E0%A6%9A%E0%A6%AE%E0%A7%81%E0%A6%9A%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%81%E0%A6%9A%E0%A6%BE-%E0%A6%AA%E0%A7%87%E0%A6%81%E0%A6%AA%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/lifestyle/980026/%E0%A6%98%E0%A6%B0%E0%A7%87%E0%A6%87-%E0%A6%AC%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%A8-%E0%A6%AE%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF-%E0%A6%AE%E0%A7%81%E0%A6%9A%E0%A6%AE%E0%A7%81%E0%A6%9A%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%81%E0%A6%9A%E0%A6%BE-%E0%A6%AA%E0%A7%87%E0%A6%81%E0%A6%AA%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Wed, 11 Nov 2026 08:15:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/29d87a419fed285d92e6eea2cb3d7e1e-6af2f64066d9f.jpg?jadewits_media_id=1054217" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/29d87a419fed285d92e6eea2cb3d7e1e-6af2f64066d9f.jpg?jadewits_media_id=1054217" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/29d87a419fed285d92e6eea2cb3d7e1e-6af2f64066d9f.jpg?jadewits_media_id=1054217" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঘরেই বানিয়ে নিন মিষ্টি-মুচমুচে কাঁচা পেঁপের ক্যান্ডি" /&gt;&lt;/p&gt;&lt;p&gt;বাজারে নানা রকম ক্যান্ডি তো খেয়েছেন। তবে ঘরেই যদি তৈরি করা যায় মিষ্টি, নরম ও চিবোতে মজার কাঁচা পেঁপের ক্যান্ডি, তা হলে মন্দ কী! খুব বেশি উপকরণেরও প্রয়োজন নেই। কাঁচা পেঁপে, চিনি আর সামান্য লেবুর রস দিয়েই বানিয়ে নিতে পারেন সুস্বাদু এই মিষ্টি। শিশুদের টিফিন থেকে শুরু করে বিকালের নাশতা সব সময়েই জমে যাবে&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/lifestyle/980026/%E0%A6%98%E0%A6%B0%E0%A7%87%E0%A6%87-%E0%A6%AC%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%A8-%E0%A6%AE%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF-%E0%A6%AE%E0%A7%81%E0%A6%9A%E0%A6%AE%E0%A7%81%E0%A6%9A%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%81%E0%A6%9A%E0%A6%BE-%E0%A6%AA%E0%A7%87%E0%A6%81%E0%A6%AA%E0%A7%87%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>সিদ্ধার্থ-কিয়ারার দাম্পত্যে কেমন চলছে রোমান্স, ফাঁস বেডরুমের গোপন খবর</title>
      <link>https://www.banglatribune.com/entertainment/980160/%E0%A6%B8%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5-%E0%A6%95%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%95%E0%A7%87%E0%A6%AE%E0%A6%A8-%E0%A6%9A%E0%A6%B2%E0%A6%9B%E0%A7%87-%E0%A6%B0%E0%A7%8B%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%B8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/entertainment/980160/%E0%A6%B8%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5-%E0%A6%95%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%95%E0%A7%87%E0%A6%AE%E0%A6%A8-%E0%A6%9A%E0%A6%B2%E0%A6%9B%E0%A7%87-%E0%A6%B0%E0%A7%8B%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%B8</guid>
      <pubDate>Wed, 11 Nov 2026 08:10:24 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/39ba76cf31f33b6a674bc63e27529405-6af3ce2ec46c3.jpg?jadewits_media_id=1054338" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/39ba76cf31f33b6a674bc63e27529405-6af3ce2ec46c3.jpg?jadewits_media_id=1054338" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/39ba76cf31f33b6a674bc63e27529405-6af3ce2ec46c3.jpg?jadewits_media_id=1054338" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সিদ্ধার্থ-কিয়ারার দাম্পত্যে কেমন চলছে রোমান্স, ফাঁস বেডরুমের গোপন খবর" /&gt;&lt;/p&gt;&lt;p&gt;&amp;lsquo;কফি উইথ করণ&amp;rsquo; মানেই বলিউড নিয়ে করণ জোহরের ফোড়ণ! আর কাউচে তাবড় সব সেলিব্রিটি। সঙ্গে গরম কফি।কারণ সেলেবদের হাঁড়ির খবর বের করতে করণের জুড়ি মেলা ভার! তাদের জীবনশৈলী থেকে বেডরুম সিক্রেট, সবইতে নজর প্রযোজক-সঞ্চালকের।&amp;nbsp;
এবার সিদ্ধার্থ ও কিয়ারার দাম্পত্য চাঙ্গা রাখার &amp;lsquo;টনিক&amp;rsquo; ব&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/entertainment/980160/%E0%A6%B8%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5-%E0%A6%95%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%95%E0%A7%87%E0%A6%AE%E0%A6%A8-%E0%A6%9A%E0%A6%B2%E0%A6%9B%E0%A7%87-%E0%A6%B0%E0%A7%8B%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%B8">বাংলা ট্রিবিউন</source>

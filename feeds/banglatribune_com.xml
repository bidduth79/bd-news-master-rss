      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2024/04/01/-2144ad03837f3e8a01c7c271481e013a.jpg?jadewits_media_id=910143" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2024/04/01/-2144ad03837f3e8a01c7c271481e013a.jpg?jadewits_media_id=910143" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সমঝোতা ছাড়াই বৈঠক শেষ, মঙ্গলবার ফের বসছে মজুরি বোর্ড" /&gt;&lt;/p&gt;&lt;p&gt;তৈরি পোশাকশিল্পের শ্রমিকদের নতুন ন্যূনতম মজুরি নির্ধারণে মালিক ও শ্রমিকপক্ষের প্রস্তাবে বড় ব্যবধান দেখা দিয়েছে। সোমবার (২৩ নভেম্বর) অনুষ্ঠিত নিম্নতম মজুরি বোর্ডের তৃতীয় সভায় মালিকপক্ষ তাদের প্রাথমিক প্রস্তাব উপস্থাপন করলেও দুই পক্ষের মধ্যে সমঝোতা হয়নি। ফলে আলোচনা অসমাপ্ত রেখে সভা মুলতুবি করা হয়েছে। &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/business/news/982833/%E0%A6%B8%E0%A6%AE%E0%A6%9D%E0%A7%8B%E0%A6%A4%E0%A6%BE-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%87-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95-%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%AE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AB%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%B8%E0%A6%9B%E0%A7%87-%E0%A6%AE%E0%A6%9C%E0%A7%81%E0%A6%B0%E0%A6%BF">বাংলা ট্রিবিউন</source>

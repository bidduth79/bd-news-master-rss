      <guid isPermaLink="true">https://www.banglatribune.com/country/chitagong/980252/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80-%E0%A6%93-%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%B8%E0%A7%87%E0%A6%87</guid>
      <pubDate>Wed, 11 Nov 2026 16:08:54 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/f5b8ddf04e96d8bf9d6203e122a2b0a3-6af43eac35b89.jpg?jadewits_media_id=1054426" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/f5b8ddf04e96d8bf9d6203e122a2b0a3-6af43eac35b89.jpg?jadewits_media_id=1054426" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/f5b8ddf04e96d8bf9d6203e122a2b0a3-6af43eac35b89.jpg?jadewits_media_id=1054426" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিশ্ববিদ্যালয় শিক্ষার্থী ও তার মাকে হত্যা, সেই কবিরাজের মৃত্যুদণ্ড" /&gt;&lt;/p&gt;&lt;p&gt;কুমিল্লা বিশ্ববিদ্যালয়ের (কুবি) লোকপ্রশাসন বিভাগের শিক্ষার্থী সুমাইয়া আফরিন ও তার মা তাহমিনা বেগম হত্যা মামলায় একমাত্র আসামি মোবারক হোসেনকে মৃত্যুদণ্ড দিয়েছেন আদালত। একই সঙ্গে তাকে অর্থদণ্ড দেওয়া হয়েছে।
বুধবার (১১ নভেম্বর) দুপুর ১২টার দিকে কুমিল্লার নারী ও শিশু নির্যাতন দমন ট্রাইব্যুনাল-১ এর বিচারক &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/chitagong/980252/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80-%E0%A6%93-%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%B8%E0%A7%87%E0%A6%87">বাংলা ট্রিবিউন</source>

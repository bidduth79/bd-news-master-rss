      <title>বিচারকের ছেলেকে হত্যায় লিমনের মৃত্যুদণ্ড, এক বছরেই শেষ বিচারকাজ</title>
      <link>https://www.banglatribune.com/country/rajshahi/980604/%E0%A6%AC%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%9B%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A7%9F-%E0%A6%B2%E0%A6%BF%E0%A6%AE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A6%A3%E0%A7%8D%E0%A6%A1-%E0%A6%8F%E0%A6%95-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/rajshahi/980604/%E0%A6%AC%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%9B%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A7%9F-%E0%A6%B2%E0%A6%BF%E0%A6%AE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A6%A3%E0%A7%8D%E0%A6%A1-%E0%A6%8F%E0%A6%95-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%87</guid>
      <pubDate>Thu, 12 Nov 2026 23:43:52 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/ff8380504177badd955a78ecf13011f5-6af5fad2a1842.jpg?jadewits_media_id=1054719" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/ff8380504177badd955a78ecf13011f5-6af5fad2a1842.jpg?jadewits_media_id=1054719" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/ff8380504177badd955a78ecf13011f5-6af5fad2a1842.jpg?jadewits_media_id=1054719" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিচারকের ছেলেকে হত্যায় লিমনের মৃত্যুদণ্ড, এক বছরেই শেষ বিচারকাজ" /&gt;&lt;/p&gt;&lt;p&gt;রাজশাহীতে বিচারকের ১৬ বছর বয়সী ছেলে তাওসিফ রহমান সুমনকে ছুরিকাঘাতে হত্যার দায়ে লিমন মিয়া (৩৫) নামে এক যুবককে মৃত্যুদণ্ড দিয়েছেন আদালত। একই মামলায় পৃথক দুটি ধারায় তাকে ১০ বছর করে কারাদণ্ড ও মোট তিন লাখ টাকা জরিমানা করা হয়েছে।
বৃহস্পতিবার (১২ নভেম্বর) দুপুরে রাজশাহীর অতিরিক্ত মহানগর দায়রা জজ আদালত-২-এ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/rajshahi/980604/%E0%A6%AC%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%9B%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A7%9F-%E0%A6%B2%E0%A6%BF%E0%A6%AE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A6%A3%E0%A7%8D%E0%A6%A1-%E0%A6%8F%E0%A6%95-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%87">বাংলা ট্রিবিউন</source>

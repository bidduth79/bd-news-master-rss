    <item>
      <title>ইত্তেফাকের প্রকাশক পদ থেকে সরিয়ে দেওয়ার চেষ্টায় জাল নথি ব্যবহারের অভিযোগ তারিনের</title>
      <link>https://www.banglatribune.com/others/981969/%E0%A6%87%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A7%87%E0%A6%AB%E0%A6%BE%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B6%E0%A6%95-%E0%A6%AA%E0%A6%A6-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%9A%E0%A7%87%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A7%9F</link>
      <guid isPermaLink="true">https://www.banglatribune.com/others/981969/%E0%A6%87%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A7%87%E0%A6%AB%E0%A6%BE%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B6%E0%A6%95-%E0%A6%AA%E0%A6%A6-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%9A%E0%A7%87%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A7%9F</guid>
      <pubDate>Thu, 19 Nov 2026 17:27:46 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/89cd9cf5367c3db84a20e5544b0d5e71-6afedcfa09aa2.jpg?jadewits_media_id=1055877" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/89cd9cf5367c3db84a20e5544b0d5e71-6afedcfa09aa2.jpg?jadewits_media_id=1055877" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/89cd9cf5367c3db84a20e5544b0d5e71-6afedcfa09aa2.jpg?jadewits_media_id=1055877" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইত্তেফাকের প্রকাশক পদ থেকে সরিয়ে দেওয়ার চেষ্টায় জাল নথি ব্যবহারের অভিযোগ তারিনের" /&gt;&lt;/p&gt;&lt;p&gt;ভুয়া আবেদন ও জাল নথির মাধ্যমে দৈনিক ইত্তেফাকের প্রকাশক পদ থেকে তাকে সরিয়ে দেওয়ার কথিত প্রচেষ্টার প্রতিবাদ জানিয়েছেন তারিন হোসেন। বৃহস্পতিবার এক বিবৃতিতে তিনি বলেন, পত্রিকার প্রকাশক পরিবর্তনের জন্য তিনি কখনও ঢাকা জেলা ম্যাজিস্ট্রেটের কার্যালয়ে আবেদন করেননি, এ-সংক্রান্ত কোনও নথিতে স্বাক্ষর করেননি, কি&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/others/981969/%E0%A6%87%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A7%87%E0%A6%AB%E0%A6%BE%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B6%E0%A6%95-%E0%A6%AA%E0%A6%A6-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%9A%E0%A7%87%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A7%9F">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>মিয়ানমারের উদ্দেশ্য ছিল রোহিঙ্গাদের জন্মহার কমানো: আইসিজে বিচারক</title>
      <link>https://www.banglatribune.com/foreign/asia/981968/%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%8D%E0%A6%AF-%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8B</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/asia/981968/%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%8D%E0%A6%AF-%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8B</guid>
      <pubDate>Thu, 19 Nov 2026 17:19:30 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2018/12/20/580fb450323adf1f98f3ae80b30e31f9-5c1ba690c4226.jpg?jadewits_media_id=424223" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2018/12/20/580fb450323adf1f98f3ae80b30e31f9-5c1ba690c4226.jpg?jadewits_media_id=424223" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2018/12/20/580fb450323adf1f98f3ae80b30e31f9-5c1ba690c4226.jpg?jadewits_media_id=424223" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মিয়ানমারের উদ্দেশ্য ছিল রোহিঙ্গাদের জন্মহার কমানো: আইসিজে বিচারক" /&gt;&lt;/p&gt;&lt;p&gt;রোহিঙ্গা জনগোষ্ঠীর বংশবৃদ্ধি রোধ ও জন্মহার কমিয়ে আনার উদ্দেশ্যেই মিয়ানমার বিভিন্ন বিধিনিষেধ আরোপ করেছিল বলে রায়ে উল্লেখ করেছেন আন্তর্জাতিক বিচার আদালতের (আইসিজে) বিচারক ইওয়াসাওয়া ইউজি।

গণহত্যার উদ্দেশ্য ছিল, আইসিজেতে দোষী সাব্যস্ত মিয়ানমার

রায়ে বিচারক ইউজি বলেন, মিয়ানমার এমন একটি আদেশ জারি করেছি&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/asia/981968/%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%8D%E0%A6%AF-%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8B">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>লর্ডসে প্রথমবার টি-টোয়েন্টি খেলবে বাংলাদেশ, প্রতিপক্ষ কে?</title>
      <link>https://www.banglatribune.com/sport/cricket/981967/%E0%A6%B2%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A6%B8%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A7%8B%E0%A7%9F%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BF-%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A6%AC%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/cricket/981967/%E0%A6%B2%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A6%B8%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A7%8B%E0%A7%9F%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BF-%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A6%AC%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6</guid>
      <pubDate>Thu, 19 Nov 2026 17:24:23 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2024/06/17/1000047633-b9ea678c71af9beb730827c283bf70f6.jpg?jadewits_media_id=922016" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2024/06/17/1000047633-b9ea678c71af9beb730827c283bf70f6.jpg?jadewits_media_id=922016" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2024/06/17/1000047633-b9ea678c71af9beb730827c283bf70f6.jpg?jadewits_media_id=922016" style="max-width:100%;height:auto;margin-bottom:10px;" alt="লর্ডসে প্রথমবার টি-টোয়েন্টি খেলবে বাংলাদেশ, প্রতিপক্ষ কে?" /&gt;&lt;/p&gt;&lt;p&gt;লর্ডসের ঐতিহাসিক মাঠে আবারও খেলতে যাচ্ছে বাংলাদেশ। ২০২৭ সালের জুনে নেপালের বিপক্ষে একটি টি-টোয়েন্টি ম্যাচ খেলবে টাইগাররা। ক্রিকেটের ‘হোম অব ক্রিকেট’ খ্যাত এই মাঠে বাংলাদেশের পুরুষ দলের প্রথম টি-টোয়েন্টি ম্যাচটি অনুষ্ঠিত হবে আগামী বছরের ৩ জুন। বৃহস্পতিবার মেরিলিবোন ক্রিকেট ক্লাব (এমসিসি) ম্যাচটির সূচ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/cricket/981967/%E0%A6%B2%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A6%B8%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A7%8B%E0%A7%9F%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BF-%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A6%AC%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>‘২০১৭ সালে প্রায় আট লাখ ১৫ হাজার রোহিঙ্গা মিয়ানমার বাহিনীর টার্গেট হয়েছিল’</title>
      <link>https://www.banglatribune.com/foreign/asia/981965/%E0%A7%A8%E0%A7%A6%E0%A7%A7%E0%A7%AD-%E0%A6%B8%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%86%E0%A6%9F-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A7%A7%E0%A7%AB-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/asia/981965/%E0%A7%A8%E0%A7%A6%E0%A7%A7%E0%A7%AD-%E0%A6%B8%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%86%E0%A6%9F-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A7%A7%E0%A7%AB-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Thu, 19 Nov 2026 17:12:36 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2019/04/05/33b16d585ca542ab33636f6aaf9689b0-5ca75f4eee6c2.jpg?jadewits_media_id=474417" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2019/04/05/33b16d585ca542ab33636f6aaf9689b0-5ca75f4eee6c2.jpg?jadewits_media_id=474417" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2019/04/05/33b16d585ca542ab33636f6aaf9689b0-5ca75f4eee6c2.jpg?jadewits_media_id=474417" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘২০১৭ সালে প্রায় আট লাখ ১৫ হাজার রোহিঙ্গা মিয়ানমার বাহিনীর টার্গেট হয়েছিল’" /&gt;&lt;/p&gt;&lt;p&gt;২০১৭ সালের শুদ্ধি অভিযানের আগে উত্তর রাখাইন রাজ্যে বসবাসকারী প্রায় আট লাখ ১৫ হাজার রোহিঙ্গা মিয়ানমারের লক্ষ্যবস্তুতে পরিণত হয়েছিল বলে আইসিজের রায়ে উল্লেখ করা হয়েছে।

গণহত্যার উদ্দেশ্য ছিল, আইসিজেতে দোষী সাব্যস্ত মিয়ানমার

বিচারক বলেন, “এই সংখ্যাটি স্পষ্টতই উল্লেখযোগ্য।”
রায়ে বিচারক আরও বলেন, জনসংখ্য&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/asia/981965/%E0%A7%A8%E0%A7%A6%E0%A7%A7%E0%A7%AD-%E0%A6%B8%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%86%E0%A6%9F-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A7%A7%E0%A7%AB-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0">বাংলা ট্রিবিউন</source>

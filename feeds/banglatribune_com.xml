      <guid isPermaLink="true">https://www.banglatribune.com/foreign/america/980119/%E0%A7%A8%E0%A7%AB%E0%A7%A6-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%B0%E0%A6%BF%E0%A6%95-%E0%A6%87%E0%A6%A4%E0%A6%BF%E0%A6%B9%E0%A6%BE%E0%A6%B8-%E0%A6%9F%E0%A7%87%E0%A6%A8%E0%A7%87-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%B6%E0%A6%82%E0%A6%B8%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%95%E0%A6%BF-%E0%A6%89%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A7%87</guid>
      <pubDate>Tue, 10 Nov 2026 21:28:24 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/05/30/4fb429d252655f0f134f7a30a983f893-6a1aa06916ac7.jpg?jadewits_media_id=1026335" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/05/30/4fb429d252655f0f134f7a30a983f893-6a1aa06916ac7.jpg?jadewits_media_id=1026335" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/05/30/4fb429d252655f0f134f7a30a983f893-6a1aa06916ac7.jpg?jadewits_media_id=1026335" style="max-width:100%;height:auto;margin-bottom:10px;" alt="২৫০ বছরের সামরিক ইতিহাস টেনে অভিশংসনের হুমকি উড়িয়ে দিলেন মার্কিন প্রতিরক্ষামন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাষ্ট্রের ২৫০ বছরের সামরিক ইতিহাসের উদাহরণ টেনে নিজের বিরুদ্ধে আনা অভিশংসনের উদ্যোগ খারিজ করে দিয়েছেন মার্কিন প্রতিরক্ষামন্ত্রী পিট হেগসেথ। কমান্ডার-ইন-চিফের আদেশে কিংবা ওয়ার পাওয়ার্স রেজুলেশন-এর আওতায় পরিচালিত আগের বৈধ সামরিক অভিযানের জন্য কোনও প্রতিরক্ষামন্ত্রীকে অভিশংসিত হতে হয়নি উল্লেখ করে &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/america/980119/%E0%A7%A8%E0%A7%AB%E0%A7%A6-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%B0%E0%A6%BF%E0%A6%95-%E0%A6%87%E0%A6%A4%E0%A6%BF%E0%A6%B9%E0%A6%BE%E0%A6%B8-%E0%A6%9F%E0%A7%87%E0%A6%A8%E0%A7%87-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%B6%E0%A6%82%E0%A6%B8%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%95%E0%A6%BF-%E0%A6%89%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>মার্কিন প্রতিরক্ষামন্ত্রীকে অভিশংসনের প্রস্তাব নিজ দলের রিপাবলিকান কংগ্রেসম্যানের</title>

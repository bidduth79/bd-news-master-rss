      <title>মারধর ও জিম্মি করে ২৩ ভরি স্বর্ণালংকার ডাকাতি</title>
      <link>https://www.banglatribune.com/country/chitagong/980477/%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%A7%E0%A6%B0-%E0%A6%93-%E0%A6%9C%E0%A6%BF%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%BF-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A7%A8%E0%A7%A9-%E0%A6%AD%E0%A6%B0%E0%A6%BF-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A6%BE%E0%A6%B2%E0%A6%82%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%A1%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%A4%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/chitagong/980477/%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%A7%E0%A6%B0-%E0%A6%93-%E0%A6%9C%E0%A6%BF%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%BF-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A7%A8%E0%A7%A9-%E0%A6%AD%E0%A6%B0%E0%A6%BF-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A6%BE%E0%A6%B2%E0%A6%82%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%A1%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%A4%E0%A6%BF</guid>
      <pubDate>Thu, 12 Nov 2026 15:28:21 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/7e4e776fed46cdd59f169d520cfec0a4-6af586a4abc4f.jpg?jadewits_media_id=1054616" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/7e4e776fed46cdd59f169d520cfec0a4-6af586a4abc4f.jpg?jadewits_media_id=1054616" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/7e4e776fed46cdd59f169d520cfec0a4-6af586a4abc4f.jpg?jadewits_media_id=1054616" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মারধর ও জিম্মি করে ২৩ ভরি স্বর্ণালংকার ডাকাতি" /&gt;&lt;/p&gt;&lt;p&gt;ফেনীর দাগনভূঞা উপজেলার জায়লস্কর ইউনিয়নে বাড়ির দরজা ভেঙে পরিবারের সদস্যদের মারধর ও জিম্মি করে ২৩ ভরি স্বর্ণালংকার এবং নগদ ৫৫ হাজার টাকা লুট করেছে ডাকাত দল। বুধবার (১১ নভেম্বর) রাত আনুমানিক ৩টার দিকে ইউনিয়নের মোল্লাঘাটা বাজারসংলগ্ন বারাহী গোবিন্দ গ্রামের শেখ আহমেদ খাদেমের বাড়িতে এ ঘটনা ঘটে। ডাকাত দলে &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/chitagong/980477/%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%A7%E0%A6%B0-%E0%A6%93-%E0%A6%9C%E0%A6%BF%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%BF-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A7%A8%E0%A7%A9-%E0%A6%AD%E0%A6%B0%E0%A6%BF-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A6%BE%E0%A6%B2%E0%A6%82%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%A1%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%A4%E0%A6%BF">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>শেয়ারবাজারে অভিষেকে ১ দশমিক ৪ ট্রিলিয়ন ডলারের মূল্যায়ন চায় অ্যানথ্রোপিক</title>
      <link>https://www.banglatribune.com/tech-and-gadget/980476/%E0%A6%B6%E0%A7%87%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%B7%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A7%A7-%E0%A6%A6%E0%A6%B6%E0%A6%AE%E0%A6%BF%E0%A6%95-%E0%A7%AA-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%A8-%E0%A6%A1%E0%A6%B2%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/tech-and-gadget/980476/%E0%A6%B6%E0%A7%87%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%B7%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A7%A7-%E0%A6%A6%E0%A6%B6%E0%A6%AE%E0%A6%BF%E0%A6%95-%E0%A7%AA-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%A8-%E0%A6%A1%E0%A6%B2%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Thu, 12 Nov 2026 15:24:17 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/91a8befe97c79d7a32dae6c4eb5cee5d-6af58588752e6.jpg?jadewits_media_id=1054615" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/91a8befe97c79d7a32dae6c4eb5cee5d-6af58588752e6.jpg?jadewits_media_id=1054615" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/91a8befe97c79d7a32dae6c4eb5cee5d-6af58588752e6.jpg?jadewits_media_id=1054615" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শেয়ারবাজারে অভিষেকে ১ দশমিক ৪ ট্রিলিয়ন ডলারের মূল্যায়ন চায় অ্যানথ্রোপিক" /&gt;&lt;/p&gt;&lt;p&gt;ক্লড এআই চ্যাটবটের নির্মাতা অ্যানথ্রপিক আসন্ন আইপিওতে ১ দশমিক ৪ ট্রিলিয়ন ডলার মূল্যায়ন চাইছে। প্রতিষ্ঠানটি ৬ হাজার ৪৪০ কোটি ডলার পর্যন্ত তুলতে চায়, যা ইতিহাসের অন্যতম বৃহৎ শেয়ারবাজার অভিষেক হতে পারে। মঙ্গলবার বিনিয়োগকারীদের সঙ্গে রোডশো শুরু করেছে প্রতিষ্ঠানটি। খবরে বলা হয়েছে, আগামী সপ্তাহেই তা&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/tech-and-gadget/980476/%E0%A6%B6%E0%A7%87%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%B7%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A7%A7-%E0%A6%A6%E0%A6%B6%E0%A6%AE%E0%A6%BF%E0%A6%95-%E0%A7%AA-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%A8-%E0%A6%A1%E0%A6%B2%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>সাবেক এমপি পুত্রসহ ১২ জনের বিরুদ্ধে অভিযোগ গঠনের আদেশ ২৫ নভেম্বর</title>
      <link>https://www.banglatribune.com/law-and-crime/980475/%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF-%E0%A6%AA%E0%A7%81%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A6%B9-%E0%A7%A7%E0%A7%A8-%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%97%E0%A6%A0%E0%A6%A8%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/980475/%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF-%E0%A6%AA%E0%A7%81%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A6%B9-%E0%A7%A7%E0%A7%A8-%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%97%E0%A6%A0%E0%A6%A8%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Thu, 12 Nov 2026 15:24:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/07/15/6898df17cca81d0ba74041219c59cc73-6a57a4ef66ab0.jpg?jadewits_media_id=1033723" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/07/15/6898df17cca81d0ba74041219c59cc73-6a57a4ef66ab0.jpg?jadewits_media_id=1033723" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/07/15/6898df17cca81d0ba74041219c59cc73-6a57a4ef66ab0.jpg?jadewits_media_id=1033723" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাবেক এমপি পুত্রসহ ১২ জনের বিরুদ্ধে অভিযোগ গঠনের আদেশ ২৫ নভেম্বর" /&gt;&lt;/p&gt;&lt;p&gt;চব্বিশের জুলাই গণঅভ্যুত্থানের সময় ময়মনসিংহের গৌরীপুরে তিন জনকে হত্যার ঘটনায় দায়ের করা মানবতাবিরোধী অপরাধের মামলায় ময়মনসিংহ-৩ (গৌরীপুর) আসনের সাবেক এমপি নাজিম উদ্দিন আহমেদের ছেলে তানজির আহমেদ রাজিবসহ ১২ জনের বিরুদ্ধে আনুষ্ঠানিক অভিযোগ গঠন নিয়ে প্রসিকিউশন ও আসামিপক্ষের শুনানি শেষ হয়েছে। পরে এ বিষয়ে আদ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/980475/%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF-%E0%A6%AA%E0%A7%81%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A6%B9-%E0%A7%A7%E0%A7%A8-%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%97%E0%A6%A0%E0%A6%A8%E0%A7%87%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>

      <guid isPermaLink="true">https://www.banglatribune.com/country/khulna/980788/%E0%A6%86%E0%A6%AE%E0%A6%B0%E0%A6%BE-%E0%A7%A7%E0%A7%AA-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B7-%E0%A6%9C%E0%A6%BF%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%BF-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%AB%E0%A6%BF%E0%A6%89-%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Sat, 14 Nov 2026 00:59:25 +0600</pubDate>

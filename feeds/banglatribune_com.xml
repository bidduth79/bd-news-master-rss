    <item>
      <title>গুরুত্বপূর্ণ স্থাপনায় ককটেল বিস্ফোরণ ও বাসে আগুন, যা বলছে পুলিশ</title>
      <link>https://www.banglatribune.com/others/capital-city/979709/%E0%A6%97%E0%A7%81%E0%A6%B0%E0%A7%81%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A6%AA%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%A3-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%AA%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%93-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/others/capital-city/979709/%E0%A6%97%E0%A7%81%E0%A6%B0%E0%A7%81%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A6%AA%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%A3-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%AA%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%93-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</guid>
      <pubDate>Mon, 09 Nov 2026 01:11:11 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/ab78fe8c6614be3709db7bb85a6a800c-6af0c940aa4e7.jpg?jadewits_media_id=1053955" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/ab78fe8c6614be3709db7bb85a6a800c-6af0c940aa4e7.jpg?jadewits_media_id=1053955" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/ab78fe8c6614be3709db7bb85a6a800c-6af0c940aa4e7.jpg?jadewits_media_id=1053955" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গুরুত্বপূর্ণ স্থাপনায় ককটেল বিস্ফোরণ ও বাসে আগুন, যা বলছে পুলিশ" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর সিআইডি সদরদফতর, পল্লবী থানা, খিলক্ষেত থানা, হোটেল রেডিসনের সামনে ও ঢাকা বিশ্ববিদ্যালয়সহ একাধিক গুরুত্বপূর্ণ স্থাপনায় ককটেল বিস্ফোরণের ঘটনা ঘটেছে। এ ছাড়া ১০০ ফিট এলাকায় ভাটারা থানার সামনে একটি বাসে আগুন দিয়েছে দুর্বৃত্তরা। এতে নগরজুড়ে আতঙ্ক ছড়িয়ে পড়ে।
রবিবার (৮ নভেম্বর) সন্ধ্যা থেকে রাতে এসব&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/others/capital-city/979709/%E0%A6%97%E0%A7%81%E0%A6%B0%E0%A7%81%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A6%AA%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%A3-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%AA%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%93-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>এবার খিলক্ষেত থানা ও রেডিসন হোটেলের সামনে ককটেল বিস্ফোরণ</title>
      <link>https://www.banglatribune.com/others/capital-city/979704/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%93-%E0%A6%B0%E0%A7%87%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A6%A8-%E0%A6%B9%E0%A7%8B%E0%A6%9F%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3</link>
      <guid isPermaLink="true">https://www.banglatribune.com/others/capital-city/979704/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%93-%E0%A6%B0%E0%A7%87%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A6%A8-%E0%A6%B9%E0%A7%8B%E0%A6%9F%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3</guid>
      <pubDate>Mon, 09 Nov 2026 00:20:37 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/08/13/ea9995986ff6aadc9fcdbede7bb80d8d-6a7ddf3c3edf8.jpg?jadewits_media_id=1038321" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/08/13/ea9995986ff6aadc9fcdbede7bb80d8d-6a7ddf3c3edf8.jpg?jadewits_media_id=1038321" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/08/13/ea9995986ff6aadc9fcdbede7bb80d8d-6a7ddf3c3edf8.jpg?jadewits_media_id=1038321" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এবার খিলক্ষেত থানা ও রেডিসন হোটেলের সামনে ককটেল বিস্ফোরণ" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর খিলক্ষেত থানার সামনে দুটি ককটেল বিস্ফোরণের ঘটনা ঘটেছে। রবিবার (৮ নভেম্বর) রাত ১১টার দিকে থানার ফটকের সামনে বিকট শব্দে ককটেল দুটির বিস্ফোরণ ঘটে।
থানার ডিউটি অফিসার এসআই সোহেল আহমেদ ঘটনার সত্যতা নিশ্চিত করে বলেন, দুটি শব্দ আমরা শুনেছি।  আমাদের ঊর্ধ্বতন কর্মকর্তারা বিষয়টি দেখছেন।
এদিকে এর কিছু&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/others/capital-city/979704/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%93-%E0%A6%B0%E0%A7%87%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A6%A8-%E0%A6%B9%E0%A7%8B%E0%A6%9F%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>হঠাৎ যত্রতত্র ককটেল, পুলিশ ধরছে নিক্ষেপকারীদের নাকি সন্দেহভাজনদের?</title>
      <link>https://www.banglatribune.com/law-and-crime/979690/%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%9B%E0%A7%81%E0%A7%9C%E0%A6%9B%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%A7%E0%A6%B0%E0%A6%9B%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%95%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/979690/%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%9B%E0%A7%81%E0%A7%9C%E0%A6%9B%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%A7%E0%A6%B0%E0%A6%9B%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%95%E0%A6%BF</guid>
      <pubDate>Mon, 09 Nov 2026 00:01:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/06/18/27f2d8396ea57ac87d66241e58f09d52-6a33b1e507282.jpg?jadewits_media_id=1029459" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/06/18/27f2d8396ea57ac87d66241e58f09d52-6a33b1e507282.jpg?jadewits_media_id=1029459" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/06/18/27f2d8396ea57ac87d66241e58f09d52-6a33b1e507282.jpg?jadewits_media_id=1029459" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হঠাৎ যত্রতত্র ককটেল, পুলিশ ধরছে নিক্ষেপকারীদের নাকি সন্দেহভাজনদের?" /&gt;&lt;/p&gt;&lt;p&gt;সন্ধ্যার ব্যস্ততা তখনও কমেনি ঢাকা বিশ্ববিদ্যালয় ক্যাম্পাসে। হঠাৎ টিএসসি এলাকায় পরপর দুটি বিকট শব্দ। মুহূর্তের মধ্যে ছড়িয়ে পড়ে আতঙ্ক। কিছুক্ষণ পর একই শব্দ শোনা যায় বিশ্ববিদ্যালয়ের প্রশাসনিক ভবনের পাশে, ভিসি চত্বর ও মুক্তি-গণতন্ত্র তোরণের সামনে। দৌড়ে পালানোর সময় কয়েকজনকে আটক করেন শিক্ষার্থীরা। রবিবার &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/979690/%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%9B%E0%A7%81%E0%A7%9C%E0%A6%9B%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%A7%E0%A6%B0%E0%A6%9B%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%95%E0%A6%BF">বাংলা ট্রিবিউন</source>
    </item>

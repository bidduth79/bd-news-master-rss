      <guid isPermaLink="true">https://www.banglatribune.com/country/dhaka/982831/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B8%E0%A6%AC%E0%A7%81%E0%A6%95%E0%A7%87-%E0%A6%AD%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A6%93-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%B8%E0%A7%87%E0%A6%87</guid>
      <pubDate>Mon, 23 Nov 2026 23:30:41 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/c075982e886a88d4a009cc1a0909dc66-6b04782c8b213.jpg?jadewits_media_id=1056590" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/c075982e886a88d4a009cc1a0909dc66-6b04782c8b213.jpg?jadewits_media_id=1056590" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/c075982e886a88d4a009cc1a0909dc66-6b04782c8b213.jpg?jadewits_media_id=1056590" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গোপালগঞ্জে থানায় আগুন দিয়ে ফেসবুকে ভিডিও দেওয়া সেই ছাত্রলীগ কর্মী গ্রেফতার" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জের মুকসুদপুর থানায় ভাঙচুর ও অগ্নিসংযোগ এবং ফেসবুকে সেই ঘটনার ভিডিও দিয়ে উল্লাস করা নিষিদ্ধ ছাত্রলীগ কর্মী জয়নাল মুন্সী ওরফে জিসানকে (২৮) গ্রেফতার করেছে পুলিশ। রবিবার রাতে ফরিদপুরের নগরকান্দা উপজেলার চরযশোরদী গ্রাম থেকে তাকে গ্রেফতার করা হয়।
গ্রেফতার জয়নাল মুন্সীর বাড়ি নগরকান্দা উপজেলার চরযশ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/dhaka/982831/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B8%E0%A6%AC%E0%A7%81%E0%A6%95%E0%A7%87-%E0%A6%AD%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A6%93-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%B8%E0%A7%87%E0%A6%87">বাংলা ট্রিবিউন</source>
    </item>

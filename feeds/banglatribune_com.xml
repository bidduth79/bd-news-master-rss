    <item>
      <title>রাজধানীর শ্যামলীতে বাসে আগুন</title>
      <link>https://www.banglatribune.com/law-and-crime/980127/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%B6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/980127/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%B6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</guid>
      <pubDate>Tue, 10 Nov 2026 21:59:48 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/c11a3caa1e4d4553d67aba4d4205fdc0-6af33f4ca7180.jpg?jadewits_media_id=1054308" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/c11a3caa1e4d4553d67aba4d4205fdc0-6af33f4ca7180.jpg?jadewits_media_id=1054308" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/c11a3caa1e4d4553d67aba4d4205fdc0-6af33f4ca7180.jpg?jadewits_media_id=1054308" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজধানীর শ্যামলীতে বাসে আগুন" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর শ্যামলী এলাকায় জাতীয় মানসিক স্বাস্থ্য ইনস্টিটিউটের সামনে &amp;lsquo;ঠিকানা&amp;rsquo; পরিবহনের বাসে আগুন দিয়েছে দুর্বৃত্তরা। মঙ্গলবার (১০ নভেম্বর) রাত সোয়া ৯টার দিকে এ ঘটনা ঘটে।
ফায়ার সার্ভিস কন্ট্রোল রুমের ফায়ার ফাইটার সিহাব সরকার বলেন, &amp;lsquo;খবর পাওয়ার পর আমাদের দুটি ইউনিট ঘটনাস্থলে গিয়ে ৯টা ৩৯&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/980127/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%B6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8">বাংলা ট্রিবিউন</source>
    </item>

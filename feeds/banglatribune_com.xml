    <item>
      <title>গোয়েন্দা তথ্য নিতে গিয়ে হামলায় পুলিশ সদস্য নিহত, দৌড়ে বাঁচলেন এএসআই</title>
      <link>https://www.banglatribune.com/country/dhaka/982624/%E0%A6%97%E0%A7%8B%E0%A7%9F%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%BE-%E0%A6%A4%E0%A6%A5%E0%A7%8D%E0%A6%AF-%E0%A6%A8%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%97%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/dhaka/982624/%E0%A6%97%E0%A7%8B%E0%A7%9F%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%BE-%E0%A6%A4%E0%A6%A5%E0%A7%8D%E0%A6%AF-%E0%A6%A8%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%97%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4</guid>
      <pubDate>Mon, 23 Nov 2026 00:36:19 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/658310a822707328ce2f5cb684e119a2-6b03361052d70.jpg?jadewits_media_id=1056424" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/658310a822707328ce2f5cb684e119a2-6b03361052d70.jpg?jadewits_media_id=1056424" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/658310a822707328ce2f5cb684e119a2-6b03361052d70.jpg?jadewits_media_id=1056424" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গোয়েন্দা তথ্য নিতে গিয়ে হামলায় পুলিশ সদস্য নিহত, দৌড়ে বাঁচলেন এএসআই" /&gt;&lt;/p&gt;&lt;p&gt;নারায়ণগঞ্জের ফতুল্লায় সাদা পোশাকে গোয়েন্দা তথ্য সংগ্রহ করতে গিয়ে ছুরিকাঘাতে এক পুলিশ কনস্টেবল নিহত হয়েছেন। রবিবার (২২ নভেম্বর) রাত সাড়ে ১০টার দিকে কাশীপুর ইউনিয়নের হাশেমবাগ এলাকায় এ ঘটনা ঘটে। নিহত আনোয়ার হোসেন (৩২) সদর মডেল থানাধীন শীতলক্ষ্যা পুলিশ ফাঁড়িতে কর্মরত ছিলেন।
অতিরিক্ত পুলিশ সুপা&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/dhaka/982624/%E0%A6%97%E0%A7%8B%E0%A7%9F%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%BE-%E0%A6%A4%E0%A6%A5%E0%A7%8D%E0%A6%AF-%E0%A6%A8%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%97%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>রাজধানীতে রেস্তোরাঁয় আগুনে ৬ জন দগ্ধ</title>
      <link>https://www.banglatribune.com/others/capital-city/982622/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%B0%E0%A7%87%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8B%E0%A6%B0%E0%A6%BE%E0%A6%81%E0%A7%9F-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8%E0%A7%87-%E0%A7%AC-%E0%A6%9C%E0%A6%A8-%E0%A6%A6%E0%A6%97%E0%A7%8D%E0%A6%A7</link>
      <guid isPermaLink="true">https://www.banglatribune.com/others/capital-city/982622/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%B0%E0%A7%87%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8B%E0%A6%B0%E0%A6%BE%E0%A6%81%E0%A7%9F-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8%E0%A7%87-%E0%A7%AC-%E0%A6%9C%E0%A6%A8-%E0%A6%A6%E0%A6%97%E0%A7%8D%E0%A6%A7</guid>
      <pubDate>Mon, 23 Nov 2026 00:17:11 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2024/12/02/-fad56c2ec452e8f671599c6da0c85266.jpg?jadewits_media_id=950139" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2024/12/02/-fad56c2ec452e8f671599c6da0c85266.jpg?jadewits_media_id=950139" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2024/12/02/-fad56c2ec452e8f671599c6da0c85266.jpg?jadewits_media_id=950139" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজধানীতে রেস্তোরাঁয় আগুনে ৬ জন দগ্ধ" /&gt;&lt;/p&gt;&lt;p&gt;লালবাগে কাচ্চি খানাস রেস্তোরাঁয় গ্যাস লাইন মেরামতের সময়ে &amp;nbsp;আগুন লেগে ৬ কর্মচারী দগ্ধ হয়েছেন। রবিবার (২২ নভেম্বর) রাত সাড়ে ৮টায় ঘটনাটি ঘটে।
দগ্ধরা হলেন- নয়ন (২৪) জনি (১৮) নিরব (২৪) নয়ন (২৬), রবিন (২৫) পলাশ (৪০)।
আহত অবস্থায় তাদেরকে উদ্ধার করে জাতীয় বার্ন অ্যান্ড প্লাস্টিক সার্জারি ইনিস্টিটিউটের&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/others/capital-city/982622/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%B0%E0%A7%87%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8B%E0%A6%B0%E0%A6%BE%E0%A6%81%E0%A7%9F-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8%E0%A7%87-%E0%A7%AC-%E0%A6%9C%E0%A6%A8-%E0%A6%A6%E0%A6%97%E0%A7%8D%E0%A6%A7">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ডিসেম্বরে বিতর্কিত কেউ যাতে দেশে ঢুকতে না পারে, সেজন্য সীমান্তে নিরাপত্তা জোরদার: বিজিবির ডিজি</title>
      <link>https://www.banglatribune.com/country/chitagong/982621/%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A4-%E0%A6%95%E0%A7%87%E0%A6%89-%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%A2%E0%A7%81%E0%A6%95%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/chitagong/982621/%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A4-%E0%A6%95%E0%A7%87%E0%A6%89-%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%A2%E0%A7%81%E0%A6%95%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87</guid>
      <pubDate>Mon, 23 Nov 2026 00:12:22 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/a3f7371d9be7ea2ffeae6bf3aa63a3f5-6b03306ad7a68.jpg?jadewits_media_id=1056422" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/a3f7371d9be7ea2ffeae6bf3aa63a3f5-6b03306ad7a68.jpg?jadewits_media_id=1056422" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/a3f7371d9be7ea2ffeae6bf3aa63a3f5-6b03306ad7a68.jpg?jadewits_media_id=1056422" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডিসেম্বরে বিতর্কিত কেউ যাতে দেশে ঢুকতে না পারে, সেজন্য সীমান্তে নিরাপত্তা জোরদার: বিজিবির ডিজি" /&gt;&lt;/p&gt;&lt;p&gt;ফেনীর পর ব্রাহ্মণবাড়িয়ার আখাউড়া স্থলবন্দর এলাকায় ভারত-বাংলাদেশ সীমান্ত পরিদর্শন করেছেন বর্ডার গার্ড বাংলাদেশের (বিজিবি) মহাপরিচালক (ডিজি) মেজর জেনারেল মোহাম্মদ আশরাফুজ্জামান সিদ্দিকী। রবিবার (২২ নভেম্বর) বিকালে হেলিকপ্টারযোগে আখাউড়া পৌঁছে ভারত-বাংলাদেশের সীমান্ত এলাকা পরিদর্শন করেন। বিকাল সাড়ে ৩টায় &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/chitagong/982621/%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A4-%E0%A6%95%E0%A7%87%E0%A6%89-%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%A2%E0%A7%81%E0%A6%95%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87">বাংলা ট্রিবিউন</source>

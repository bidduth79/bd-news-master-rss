    <item>
      <title>দিল্লিতে কাপড়ের দোকানের কর্মীকে ট্রায়াল রুমে গলা কেটে হত্যা</title>
      <link>https://www.banglatribune.com/foreign/asia/981144/%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%AA%E0%A7%9C%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%8B%E0%A6%95%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%B2-%E0%A6%B0%E0%A7%81%E0%A6%AE%E0%A7%87-%E0%A6%97%E0%A6%B2%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/asia/981144/%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%AA%E0%A7%9C%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%8B%E0%A6%95%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%B2-%E0%A6%B0%E0%A7%81%E0%A6%AE%E0%A7%87-%E0%A6%97%E0%A6%B2%E0%A6%BE</guid>
      <pubDate>Sun, 15 Nov 2026 22:09:50 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/edac2d2dca0a87cbcc0df14fb5070665-6af9d93091417.jpg?jadewits_media_id=1055175" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/edac2d2dca0a87cbcc0df14fb5070665-6af9d93091417.jpg?jadewits_media_id=1055175" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/edac2d2dca0a87cbcc0df14fb5070665-6af9d93091417.jpg?jadewits_media_id=1055175" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দিল্লিতে কাপড়ের দোকানের কর্মীকে ট্রায়াল রুমে গলা কেটে হত্যা" /&gt;&lt;/p&gt;&lt;p&gt;ভারতের রাজধানী দিল্লিতে একটি পোশাকের শোরুমের ট্রায়াল রুমে শবনম নামে ১৮ বছর বয়সী এক কর্মীকে গলা কেটে হত্যার অভিযোগ উঠেছে। শনিবার সন্ধ্যায় এ ঘটনা ঘটে। ব্যক্তিগত সম্পর্কের টানাপোড়েন ও একতরফা ভালোবাসার জেরে এ হত্যাকাণ্ড ঘটে থাকতে পারে বলে প্রাথমিকভাবে ধারণা করছে পুলিশ। এ ঘটনায় সূরজ নামে এক ব্যক্তিকে গ্র&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/asia/981144/%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%AA%E0%A7%9C%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%8B%E0%A6%95%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%B2-%E0%A6%B0%E0%A7%81%E0%A6%AE%E0%A7%87-%E0%A6%97%E0%A6%B2%E0%A6%BE">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>এবার গোপালগঞ্জে পুলিশ কর্মকর্তাকে কুপিয়ে জখম</title>
      <link>https://www.banglatribune.com/country/dhaka/981143/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A7%81%E0%A6%AA%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%9C%E0%A6%96%E0%A6%AE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/dhaka/981143/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A7%81%E0%A6%AA%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%9C%E0%A6%96%E0%A6%AE</guid>
      <pubDate>Sun, 15 Nov 2026 22:05:36 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/9d13aeb51c110c2c9f95a4f5fce494cd-6af9d84c7786d.jpg?jadewits_media_id=1055174" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/9d13aeb51c110c2c9f95a4f5fce494cd-6af9d84c7786d.jpg?jadewits_media_id=1055174" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/9d13aeb51c110c2c9f95a4f5fce494cd-6af9d84c7786d.jpg?jadewits_media_id=1055174" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এবার গোপালগঞ্জে পুলিশ কর্মকর্তাকে কুপিয়ে জখম" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জের টুঙ্গিপাড়ায় পুলিশের গাড়ি ভাঙচুর ও অগ্নিসংযোগ মামলার বাদী পুলিশের উপপরিদর্শক (এসআই) মোসলেম আলীকে কুপিয়ে জখম করেছে একদল লোক। রবিবার (১৫ নভেম্বর) বিকালে উপজেলার পাটগাতী ইউনিয়নের চৌরঙ্গী মোড় এলাকায় এ ঘটনা ঘটে। বর্তমানে তিনি টুঙ্গিপাড়া উপজেলা স্বাস্থ্য কমপ্লেক্সে চিকিৎসাধীন রয়েছেন।&amp;nbsp;
এর আ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/dhaka/981143/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A7%81%E0%A6%AA%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%9C%E0%A6%96%E0%A6%AE">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>রাজনৈতিক দলগুলোতে নারীর প্রতিনিধিত্ব কতটা নিশ্চিত হচ্ছে?</title>
      <link>https://www.banglatribune.com/politics/981130/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A8%E0%A7%88%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%A6%E0%A6%B2%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A7%8B%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A6%A7%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%AC-%E0%A6%95%E0%A6%A4%E0%A6%9F%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%9A%E0%A6%BF%E0%A6%A4</link>
      <guid isPermaLink="true">https://www.banglatribune.com/politics/981130/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A8%E0%A7%88%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%A6%E0%A6%B2%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A7%8B%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A6%A7%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%AC-%E0%A6%95%E0%A6%A4%E0%A6%9F%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%9A%E0%A6%BF%E0%A6%A4</guid>
      <pubDate>Sun, 15 Nov 2026 22:00:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/27b2ab44d945c168aa722430c6a1e9fc-6af9c7600b7f4.jpg?jadewits_media_id=1055161" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/27b2ab44d945c168aa722430c6a1e9fc-6af9c7600b7f4.jpg?jadewits_media_id=1055161" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/27b2ab44d945c168aa722430c6a1e9fc-6af9c7600b7f4.jpg?jadewits_media_id=1055161" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজনৈতিক দলগুলোতে নারীর প্রতিনিধিত্ব কতটা নিশ্চিত হচ্ছে?" /&gt;&lt;/p&gt;&lt;p&gt;জাতীয় নাগরিক পার্টির (এনসিপি) যুগ্ম আহ্বায়ক সামান্তা শারমিনের পদত্যাগ বাংলাদেশের রাজনৈতিক দলগুলোতে নারীর প্রতিনিধিত্ব ও সিদ্ধান্ত গ্রহণের ক্ষমতা নিয়ে নতুন করে আলোচনা তৈরি করেছে। দলটি প্রতিষ্ঠাকালীন আদর্শ থেকে সরে এসেছে, নারীদের কোণঠাসা করেছে এবং দলের অভ্যন্তরীণ গণতন্ত্র দুর্বল করেছে; এমন অভিযোগ তুলে&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/politics/981130/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A8%E0%A7%88%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%A6%E0%A6%B2%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A7%8B%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A6%A7%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%AC-%E0%A6%95%E0%A6%A4%E0%A6%9F%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%9A%E0%A6%BF%E0%A6%A4">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>দিনের শেষ বলে আউট হৃদয়</title>
      <link>https://www.banglatribune.com/sport/cricket/981142/%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%AC%E0%A6%B2%E0%A7%87-%E0%A6%86%E0%A6%89%E0%A6%9F-%E0%A6%B9%E0%A7%83%E0%A6%A6%E0%A7%9F%C2%A0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/cricket/981142/%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%AC%E0%A6%B2%E0%A7%87-%E0%A6%86%E0%A6%89%E0%A6%9F-%E0%A6%B9%E0%A7%83%E0%A6%A6%E0%A7%9F%C2%A0</guid>
      <pubDate>Sun, 15 Nov 2026 21:59:36 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/6060ebcf091d3f78bf1e6828d1e71e57-6af9d6e04c43a.jpg?jadewits_media_id=1055173" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/6060ebcf091d3f78bf1e6828d1e71e57-6af9d6e04c43a.jpg?jadewits_media_id=1055173" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/6060ebcf091d3f78bf1e6828d1e71e57-6af9d6e04c43a.jpg?jadewits_media_id=1055173" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দিনের শেষ বলে আউট হৃদয়" /&gt;&lt;/p&gt;&lt;p&gt;প্রথম টেস্টে টস জিতে ২২ রানে ৩ উইকেট হারিয়ে দিনের শুরুতে বাজে কিছুর ইঙ্গিত দিয়েছিল বাংলাদেশ। কিন্তু শেষ পর্যন্ত পুরো দিনে আলো ছড়ালেন তাওহীদ হৃদয়। তার অবিশ্বাস্য ১৩৭ রানের ইনিংসের কারণেই প্রথম দিন দক্ষিণ আফ্রিকার বিপক্ষে স্বস্তিতে শেষ করেছে সফরকারীরা। তবে আক্ষেপের জায়গাটি হচ্ছে তৃতীয় সেশন পর্যন্ত দাপ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/cricket/981142/%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%AC%E0%A6%B2%E0%A7%87-%E0%A6%86%E0%A6%89%E0%A6%9F-%E0%A6%B9%E0%A7%83%E0%A6%A6%E0%A7%9F%C2%A0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>দিনের গুরুত্বপূর্ণ আন্তর্জাতিক খবর</title>
      <link>https://www.banglatribune.com/foreign/981141/%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A7%81%E0%A6%B0%E0%A7%81%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A6%AA%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%A3-%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%96%E0%A6%AC%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/981141/%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A7%81%E0%A6%B0%E0%A7%81%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A6%AA%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%A3-%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%96%E0%A6%AC%E0%A6%B0</guid>
      <pubDate>Sun, 15 Nov 2026 21:54:22 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/10/25/c93cec1b4a238b5189d8508ae755a8c8-6ade1e0cc99f3.jpg?jadewits_media_id=1051363" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/10/25/c93cec1b4a238b5189d8508ae755a8c8-6ade1e0cc99f3.jpg?jadewits_media_id=1051363" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/10/25/c93cec1b4a238b5189d8508ae755a8c8-6ade1e0cc99f3.jpg?jadewits_media_id=1051363" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দিনের গুরুত্বপূর্ণ আন্তর্জাতিক খবর" /&gt;&lt;/p&gt;&lt;p&gt;বিশ্বের রাজনৈতিক আকাশে প্রতিদিনই নতুন মেঘ জমছে, নতুন ঝড় উঠছে। বৈশ্বিক নীতি-নির্ধারণের নীরব সিদ্ধান্ত থেকে শুরু করে ভূ-রাজনীতির জটিল খেলা, কূটনীতির অদৃশ্য সুতো, সংঘাতের আগুন এবং প্রতিরক্ষা খাতের নীরব প্রস্তুতি-সবকিছু মিলিয়ে যেন এক অবিরাম পরিবর্তন চলছে। এই পরিবর্তনের প্রতিটি দৃশ্য আজকের বিশ্বব্যবস্থাক&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/981141/%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A7%81%E0%A6%B0%E0%A7%81%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A6%AA%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%A3-%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%96%E0%A6%AC%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>‘টাকা দিলি না কেন’ বলেই প্রতিষ্ঠানে ঢুকে গুলি, মুখে ছিল মাস্ক মাথায় ক্যাপ</title>
      <link>https://www.banglatribune.com/law-and-crime/981140/%E2%80%98%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A6%BF-%E0%A6%A8%E0%A6%BE-%E0%A6%95%E0%A7%87%E0%A6%A8%E2%80%99-%E0%A6%AC%E0%A6%B2%E0%A7%87%E0%A6%87-%E0%A6%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A6%A8%E0%A7%87%E0%A6%9F-%E0%A6%B8%E0%A6%B0%E0%A6%AC%E0%A6%B0%E0%A6%BE%E0%A6%B9%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%80</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/981140/%E2%80%98%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A6%BF-%E0%A6%A8%E0%A6%BE-%E0%A6%95%E0%A7%87%E0%A6%A8%E2%80%99-%E0%A6%AC%E0%A6%B2%E0%A7%87%E0%A6%87-%E0%A6%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A6%A8%E0%A7%87%E0%A6%9F-%E0%A6%B8%E0%A6%B0%E0%A6%AC%E0%A6%B0%E0%A6%BE%E0%A6%B9%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%80</guid>
      <pubDate>Sun, 15 Nov 2026 21:54:49 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/5388dcbde3938b6a769161a384bfa61d-6af9d4e37cf9b.jpg?jadewits_media_id=1055172" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/5388dcbde3938b6a769161a384bfa61d-6af9d4e37cf9b.jpg?jadewits_media_id=1055172" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/5388dcbde3938b6a769161a384bfa61d-6af9d4e37cf9b.jpg?jadewits_media_id=1055172" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘টাকা দিলি না কেন’ বলেই প্রতিষ্ঠানে ঢুকে গুলি, মুখে ছিল মাস্ক মাথায় ক্যাপ" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর রামপুরায় চাঁদা না পেয়ে একটি ইন্টারনেট সরবরাহকারী প্রতিষ্ঠানে ঢুকে গুলি চালিয়েছে দুর্বৃত্তরা। এতে প্রতিষ্ঠানটির দুই কর্মী সাজু আহমেদ রুবেল (২৮) ও হাবিব (২৭) আহত হয়েছেন। তাদের ঢাকা মেডিক্যাল কলেজ হাসপাতালের জরুরি বিভাগে নেওয়া হয়েছে।
রবিবার (১৫ নভেম্বর) সন্ধ্যায় রামপুরার ওয়াবদা রোডে তাকওয়া মসজ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/981140/%E2%80%98%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A6%BF-%E0%A6%A8%E0%A6%BE-%E0%A6%95%E0%A7%87%E0%A6%A8%E2%80%99-%E0%A6%AC%E0%A6%B2%E0%A7%87%E0%A6%87-%E0%A6%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A6%A8%E0%A7%87%E0%A6%9F-%E0%A6%B8%E0%A6%B0%E0%A6%AC%E0%A6%B0%E0%A6%BE%E0%A6%B9%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%80">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ডিসেম্বর ঘিরে উত্তাপের শঙ্কা: সরকার বলছে ‘পরিস্থিতি নিয়ন্ত্রণে’</title>
      <link>https://www.banglatribune.com/law-and-crime/981139/%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%98%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A6%89%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%AA%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BE-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%B2%E0%A6%9B%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/981139/%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%98%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A6%89%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%AA%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BE-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%B2%E0%A6%9B%E0%A7%87</guid>
      <pubDate>Sun, 15 Nov 2026 21:38:40 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/b943d43a3d45a69205d5d449102638fb-6af44fa3e5bac.jpg?jadewits_media_id=1054436" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/b943d43a3d45a69205d5d449102638fb-6af44fa3e5bac.jpg?jadewits_media_id=1054436" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/b943d43a3d45a69205d5d449102638fb-6af44fa3e5bac.jpg?jadewits_media_id=1054436" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডিসেম্বর ঘিরে উত্তাপের শঙ্কা: সরকার বলছে ‘পরিস্থিতি নিয়ন্ত্রণে’" /&gt;&lt;/p&gt;&lt;p&gt;বিজয়ের মাস ডিসেম্বর সামনে রেখে দেশের রাজনৈতিক পরিস্থিতি ও জননিরাপত্তা নিয়ে আলোচনা বাড়ছে। রাজধানী ঢাকাসহ দেশের বিভিন্ন স্থানে ককটেল বিস্ফোরণ, যানবাহনে অগ্নিসংযোগ এবং রাজনৈতিক দলগুলোর পাল্টাপাল্টি বক্তব্যের মধ্যে ডিসেম্বরের পরিস্থিতি কেমন থাকবে, তা নিয়ে উদ্বেগ রয়েছে। সরকার বলছে, দেশের আইনশৃঙ্খলা পরিস্&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/981139/%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%98%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A6%89%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%AA%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BE-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%B2%E0%A6%9B%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>এক সার্চেই মিলবে বিভিন্ন বিষয়ের তথ্য, গুগল সার্চে যুক্ত হলো নতুন এআই</title>
      <link>https://www.banglatribune.com/tech-and-gadget/981138/%E0%A6%8F%E0%A6%95-%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%9A%E0%A7%87%E0%A6%87-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%AC%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%A8-%E0%A6%AC%E0%A6%BF%E0%A6%B7%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%A4%E0%A6%A5%E0%A7%8D%E0%A6%AF-%E0%A6%97%E0%A7%81%E0%A6%97%E0%A6%B2-%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%9A%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/tech-and-gadget/981138/%E0%A6%8F%E0%A6%95-%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%9A%E0%A7%87%E0%A6%87-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%AC%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%A8-%E0%A6%AC%E0%A6%BF%E0%A6%B7%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%A4%E0%A6%A5%E0%A7%8D%E0%A6%AF-%E0%A6%97%E0%A7%81%E0%A6%97%E0%A6%B2-%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%9A%E0%A7%87</guid>
      <pubDate>Sun, 15 Nov 2026 21:35:40 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/cba4a14ac74fb28682b656bcbba658b3-6af9d0dea1634.jpg?jadewits_media_id=1055170" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/cba4a14ac74fb28682b656bcbba658b3-6af9d0dea1634.jpg?jadewits_media_id=1055170" medium="image" />

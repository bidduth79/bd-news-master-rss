      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/16077d350251b92ae42234d9f2f53fc6-6af0d290f38be.jpg?jadewits_media_id=1053956" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/16077d350251b92ae42234d9f2f53fc6-6af0d290f38be.jpg?jadewits_media_id=1053956" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/16077d350251b92ae42234d9f2f53fc6-6af0d290f38be.jpg?jadewits_media_id=1053956" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অগ্রণী ব্যাংকে জমা রাখা ৩০ কোটি টাকা উধাও, কেন্দ্রীয় ব্যাংকের সামনে গ্রাহকরা" /&gt;&lt;/p&gt;&lt;p&gt;রাষ্ট্রায়ত্ত অগ্রণী ব্যাংকের মুন্সীগঞ্জের শ্রীনগর শাখায় ৩১৫ গ্রাহকের প্রায় ৩০ কোটি টাকা আত্মসাতের অভিযোগ উঠেছে। ব্যাংকে নিয়ম মেনে টাকা জমা রাখার পরও এখন গ্রাহকদের অনেকেই নিজেদের হিসাবের অস্তিত্ব খুঁজে পাচ্ছেন না। কারও কাছে টাকা জমার মোবাইল বার্তা রয়েছে, কারও কাছে রয়েছে ব্যাংকের রসিদ ও স্থায়ী আমানতের&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/business/money-and-investment/979710/%E0%A6%85%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%A3%E0%A7%80-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A7%87-%E0%A6%9C%E0%A6%AE%E0%A6%BE-%E0%A6%B0%E0%A6%BE%E0%A6%96%E0%A6%BE-%E0%A7%A9%E0%A7%A6-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%89%E0%A6%A7%E0%A6%BE%E0%A6%93">বাংলা ট্রিবিউন</source>
    </item>

    <item>
      <title>জল্পনার অবসান, আইপিএল নিলামে নেই মোস্তাফিজের নাম</title>
      <link>https://www.banglatribune.com/sport/cricket/983054/%E0%A6%9C%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A6%BE%E0%A6%A8-%E0%A6%86%E0%A6%87%E0%A6%AA%E0%A6%BF%E0%A6%8F%E0%A6%B2-%E0%A6%A8%E0%A6%BF%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%AE%E0%A7%8B%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%AB%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/cricket/983054/%E0%A6%9C%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A6%BE%E0%A6%A8-%E0%A6%86%E0%A6%87%E0%A6%AA%E0%A6%BF%E0%A6%8F%E0%A6%B2-%E0%A6%A8%E0%A6%BF%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%AE%E0%A7%8B%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%AB%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE</guid>
      <pubDate>Tue, 24 Nov 2026 23:09:44 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2024/04/15/-588fdb1994a2ed2b1d283da0358b41a7.png?jadewits_media_id=912258" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2024/04/15/-588fdb1994a2ed2b1d283da0358b41a7.png?jadewits_media_id=912258" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2024/04/15/-588fdb1994a2ed2b1d283da0358b41a7.png?jadewits_media_id=912258" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জল্পনার অবসান, আইপিএল নিলামে নেই মোস্তাফিজের নাম" /&gt;&lt;/p&gt;&lt;p&gt;আগের জল্পনা থাকলেও আসন্ন আইপিএল নিলামে থাকছে না বাংলাদেশের পেসার মোস্তাফিজুর রহমানের নাম। ১৬ ডিসেম্বর অনুষ্ঠেয় নিলামের জন্য ফ্র্যাঞ্চাইজিগুলোর কাছে পাঠানো প্রাথমিক তালিকায় জায়গা হয়নি বাঁহাতি এই পেসারের।

প্রোটিয়াদের রানের পাহাড়

গত মৌসুমের নিলামে ৯ কোটি ২০ লাখ রুপিতে মোস্তাফিজকে দলে নিয়েছিল কলকাতা ন&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/cricket/983054/%E0%A6%9C%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A6%BE%E0%A6%A8-%E0%A6%86%E0%A6%87%E0%A6%AA%E0%A6%BF%E0%A6%8F%E0%A6%B2-%E0%A6%A8%E0%A6%BF%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%AE%E0%A7%8B%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%AB%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>বাজার থেকে হেঁটে বাড়ি ফিরছিলেন, পেছন থেকে মাথায় গুলি করা হত্যা</title>
      <link>https://www.banglatribune.com/country/dhaka/983053/%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A7%87%E0%A6%81%E0%A6%9F%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A6%9B%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AA%E0%A7%87%E0%A6%9B%E0%A6%A8-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%A5%E0%A6%BE%E0%A7%9F</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/dhaka/983053/%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A7%87%E0%A6%81%E0%A6%9F%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A6%9B%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AA%E0%A7%87%E0%A6%9B%E0%A6%A8-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%A5%E0%A6%BE%E0%A7%9F</guid>
      <pubDate>Tue, 24 Nov 2026 23:08:06 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/d25e449953385e27d1cf595ab9849050-6b05c46d7ff1f.jpg?jadewits_media_id=1056779" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/d25e449953385e27d1cf595ab9849050-6b05c46d7ff1f.jpg?jadewits_media_id=1056779" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/d25e449953385e27d1cf595ab9849050-6b05c46d7ff1f.jpg?jadewits_media_id=1056779" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাজার থেকে হেঁটে বাড়ি ফিরছিলেন, পেছন থেকে মাথায় গুলি করা হত্যা" /&gt;&lt;/p&gt;&lt;p&gt;নরসিংদীর শিবপুরে আলম মিয়া (৩৫) নামে এক দিনমজুরকে গুলি করে হত্যা করেছে দুর্বৃত্তরা। মঙ্গলবার (২৪ নভেম্বর) সন্ধ্যা ৭টার দিকে উপজেলার বাঘাব ইউনিয়নের বংপুর গ্রামে এ ঘটনা ঘটে। বিষয়টি বাংলা ট্রিবিউনকে নিশ্চিত করেছেন শিবপুর থানার ভারপ্রাপ্ত কর্মকর্তা (ওসি) মো. কোহিনূর মিয়া।
নিহত আলম মিয়া ওই গ্রামের মৃত আফ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/dhaka/983053/%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A7%87%E0%A6%81%E0%A6%9F%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A6%9B%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AA%E0%A7%87%E0%A6%9B%E0%A6%A8-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%A5%E0%A6%BE%E0%A7%9F">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>কক্সবাজারে বাসের ধাক্কায় অটোরিকশার ৫ যাত্রী নিহত</title>

    <item>
      <title>‘বিছানায় শুয়ে পাকিস্তানের কাছে হার দেখে অনেক খারাপ লেগেছে’</title>
      <link>https://www.banglatribune.com/sport/football/982514/%E2%80%98%E0%A6%AC%E0%A6%BF%E0%A6%9B%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%B6%E0%A7%81%E0%A7%9F%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%9B%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A7%87-%E0%A6%85%E0%A6%A8%E0%A7%87%E0%A6%95-%E0%A6%96%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%AA</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/football/982514/%E2%80%98%E0%A6%AC%E0%A6%BF%E0%A6%9B%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%B6%E0%A7%81%E0%A7%9F%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%9B%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A7%87-%E0%A6%85%E0%A6%A8%E0%A7%87%E0%A6%95-%E0%A6%96%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%AA</guid>
      <pubDate>Sun, 22 Nov 2026 15:35:13 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/dead7bc721cd44b4295206f7bc9ceb3e-6b02b71e5e19f.jpg?jadewits_media_id=1056337" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/dead7bc721cd44b4295206f7bc9ceb3e-6b02b71e5e19f.jpg?jadewits_media_id=1056337" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/dead7bc721cd44b4295206f7bc9ceb3e-6b02b71e5e19f.jpg?jadewits_media_id=1056337" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘বিছানায় শুয়ে পাকিস্তানের কাছে হার দেখে অনেক খারাপ লেগেছে’" /&gt;&lt;/p&gt;&lt;p&gt;সাফ চ্যাম্পিয়নশিপে দেশের মাটিতে শিরোপা জয়ের স্বপ্ন দেখেছিল বাংলাদেশ। কিন্তু সেই স্বপ্ন পূরণের লড়াইয়ে এবার দলের পাশে থাকতে পারছেন না সাদউদ্দিন। শ্রীলঙ্কার বিপক্ষে ম্যাচে পাওয়া চোট তাকে ছিটকে দিয়েছে দীর্ঘ সময়ের জন্য। উন্নত চিকিৎসার জন্য ভারতের মুম্বাইয়ে যাওয়ার প্রস্তুতি নিচ্ছেন জাতীয় দলের এই ডিফেন্ডার&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/football/982514/%E2%80%98%E0%A6%AC%E0%A6%BF%E0%A6%9B%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%B6%E0%A7%81%E0%A7%9F%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%9B%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A7%87-%E0%A6%85%E0%A6%A8%E0%A7%87%E0%A6%95-%E0%A6%96%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%AA">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>খুলনায় রবীন্দ্রনাথের গ্রাফিতিতে আবারও কালি লেপন</title>

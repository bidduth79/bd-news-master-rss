    <item>
      <title>এক দিনেই মোটা অংকের অর্থ হারিয়ে ধনীদের তালিকায় পতন এনভিডিয়া প্রধানের</title>
      <link>https://www.banglatribune.com/tech-and-gadget/979984/%E0%A6%8F%E0%A6%95-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%AE%E0%A7%8B%E0%A6%9F%E0%A6%BE-%E0%A6%85%E0%A6%82%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A5-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A7%E0%A6%A8%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A6%A4%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/tech-and-gadget/979984/%E0%A6%8F%E0%A6%95-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%AE%E0%A7%8B%E0%A6%9F%E0%A6%BE-%E0%A6%85%E0%A6%82%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A5-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A7%E0%A6%A8%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A6%A4%E0%A6%A8</guid>
      <pubDate>Tue, 10 Nov 2026 13:15:23 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/305b4c1a6271cbfc2984fd73aa22eb83-6af2c3dc62e75.jpg?jadewits_media_id=1054182" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/305b4c1a6271cbfc2984fd73aa22eb83-6af2c3dc62e75.jpg?jadewits_media_id=1054182" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/305b4c1a6271cbfc2984fd73aa22eb83-6af2c3dc62e75.jpg?jadewits_media_id=1054182" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এক দিনেই মোটা অংকের অর্থ হারিয়ে ধনীদের তালিকায় পতন এনভিডিয়া প্রধানের" /&gt;&lt;/p&gt;&lt;p&gt;কৃত্রিম বুদ্ধিমত্তা বিপ্লবের কারিগর হিসেবে এনভিডিয়া সিইও জেনসেন হুয়াং নিয়মিত শিরোনামে থাকেন। তবে এবার আলোচনার কেন্দ্রে রয়েছে তার ব্যক্তিগত জীবন, যার প্রভাব পড়ছে তার বিশাল সম্পদেও। যুক্তরাষ্ট্রের গোয়েন্দা সংস্থার সন্দেহ অনুযায়ী, চীনের জন্য তথ্য সংগ্রহে নিয়োজিত এক নারী ব্যবসায়িক নির্বাহীর সঙ্গে হুয়াং &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/tech-and-gadget/979984/%E0%A6%8F%E0%A6%95-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%AE%E0%A7%8B%E0%A6%9F%E0%A6%BE-%E0%A6%85%E0%A6%82%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A5-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A7%E0%A6%A8%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A6%A4%E0%A6%A8">বাংলা ট্রিবিউন</source>

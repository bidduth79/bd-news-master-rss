      <guid isPermaLink="true">https://www.banglatribune.com/educations/982525/%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A7%87%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%A4%E0%A7%88%E0%A6%B0%E0%A6%BF%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%AF%E0%A6%BE%E0%A6%AC%E0%A7%87</guid>
      <pubDate>Sun, 22 Nov 2026 16:34:04 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/4e44f097e31975e188877836c80f4ae0-6b02c4d6315b5.jpg?jadewits_media_id=1056346" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/4e44f097e31975e188877836c80f4ae0-6b02c4d6315b5.jpg?jadewits_media_id=1056346" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/4e44f097e31975e188877836c80f4ae0-6b02c4d6315b5.jpg?jadewits_media_id=1056346" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শিক্ষাপ্রতিষ্ঠানকে বেকার তৈরির কারখানা বানানো যাবে না: শিক্ষামন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;শিক্ষামন্ত্রী ড. আ ন ম এহছানুল হক মিলন বলেছেন, শিক্ষাপ্রতিষ্ঠানগুলোকে বেকার তৈরির কারখানায় পরিণত করা যাবে না। শ্রমবাজারের চাহিদা অনুযায়ী দক্ষ মানবসম্পদ গড়ে তুলতে বিশ্ববিদ্যালয় ও শিল্প খাতের মধ্যে কার্যকর সংযোগ তৈরি করতে হবে।&amp;nbsp;&amp;nbsp;রবিবার (২২ নভেম্বর) সকালে ঢাকা বিশ্ববিদ্যালয়ের (ঢাবি) নবাব নওয়াব&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/educations/982525/%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A7%87%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%A4%E0%A7%88%E0%A6%B0%E0%A6%BF%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%AF%E0%A6%BE%E0%A6%AC%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>

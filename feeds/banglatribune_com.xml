      <guid isPermaLink="true">https://www.banglatribune.com/country/chitagong/983540/%E0%A6%B6%E0%A6%BE%E0%A6%9F%E0%A6%A1%E0%A6%BE%E0%A6%89%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%9C%E0%A6%95-%E0%A6%85%E0%A6%AC%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A6%98%E0%A7%8B%E0%A6%B7%E0%A6%A3%E0%A6%BE-%E0%A6%9A%E0%A7%81%E0%A7%9F%E0%A7%87%E0%A6%9F</guid>
      <pubDate>Fri, 27 Nov 2026 12:43:17 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/79b62ae5234d3ecdfd1d68ccf5977e1c-6b092658b6933.jpg?jadewits_media_id=1057201" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/79b62ae5234d3ecdfd1d68ccf5977e1c-6b092658b6933.jpg?jadewits_media_id=1057201" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/79b62ae5234d3ecdfd1d68ccf5977e1c-6b092658b6933.jpg?jadewits_media_id=1057201" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শাটডাউনের পর এবার সড়ক অবরোধের ঘোষণা চুয়েট শিক্ষার্থীদের" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রাম প্রকৌশল ও প্রযুক্তি বিশ্ববিদ্যালয়ে (চুয়েট) উপাচার্য নিয়োগ নিয়ে চলমান বিরোধের স্থায়ী সমাধান চেয়ে এবার কাপ্তাই সড়ক অবরোধের ঘোষণা দিয়েছেন আন্দোলনরত শিক্ষার্থীরা। শুক্রবার (২৭ নভেম্বর) জুমার নামাজের পর বিশ্ববিদ্যালয়ের সামনের সড়কে এ কর্মসূচি পালন করবেন তারা। বৃহস্পতিবার রাতে এক ঘোষণায় এ কর্মসূচ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/chitagong/983540/%E0%A6%B6%E0%A6%BE%E0%A6%9F%E0%A6%A1%E0%A6%BE%E0%A6%89%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%9C%E0%A6%95-%E0%A6%85%E0%A6%AC%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A6%98%E0%A7%8B%E0%A6%B7%E0%A6%A3%E0%A6%BE-%E0%A6%9A%E0%A7%81%E0%A7%9F%E0%A7%87%E0%A6%9F">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>সাইবার হামলার শিকার এএফপি, বন্ধ কনটেন্ট প্ল্যাটফর্ম</title>
      <link>https://www.banglatribune.com/tech-and-gadget/983539/%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%8F%E0%A6%8F%E0%A6%AB%E0%A6%AA%E0%A6%BF-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7-%E0%A6%95%E0%A6%A8%E0%A6%9F%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F</link>
      <guid isPermaLink="true">https://www.banglatribune.com/tech-and-gadget/983539/%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%8F%E0%A6%8F%E0%A6%AB%E0%A6%AA%E0%A6%BF-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7-%E0%A6%95%E0%A6%A8%E0%A6%9F%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F</guid>
      <pubDate>Fri, 27 Nov 2026 12:31:49 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/9adad97e2d5a7f21e9cdb254731a56ec-6b09235b8f3f7.png?jadewits_media_id=1057199" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/9adad97e2d5a7f21e9cdb254731a56ec-6b09235b8f3f7.png?jadewits_media_id=1057199" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/9adad97e2d5a7f21e9cdb254731a56ec-6b09235b8f3f7.png?jadewits_media_id=1057199" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাইবার হামলার শিকার এএফপি, বন্ধ কনটেন্ট প্ল্যাটফর্ম" /&gt;&lt;/p&gt;&lt;p&gt;ফ্রান্সভিত্তিক আন্তর্জাতিক সংবাদ সংস্থা এজেন্স ফ্রান্স-প্রেস (এএফপি) সাইবার হামলার শিকার হয়েছে। এ ঘটনার পর সংস্থাটির কনটেন্ট প্ল্যাটফর্ম &amp;lsquo;এএফপি ফোরাম&amp;rsquo; বন্ধ করে রাখা হয়েছে। হামলার পেছনে কারা রয়েছে, তা জানতে তদন্ত শুরু করেছে এএফপি কর্তৃপক্ষ। কাতারভিত্তিক সংবাদমাধ্যম আল জাজিরা এ খবর জানিয়েছ&lt;/p&gt;</description>

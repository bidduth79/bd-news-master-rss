    <item>
      <title>টেস্ট ক্রিকেটে বাংলাদেশের ২৬ বছর, সাফল্যের পাল্লা কতটা ভারী?</title>
      <link>https://www.banglatribune.com/sport/cricket/979994/%E0%A6%9F%E0%A7%87%E0%A6%B8%E0%A7%8D%E0%A6%9F-%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%9F%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A7%A8%E0%A7%AC-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AB%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/cricket/979994/%E0%A6%9F%E0%A7%87%E0%A6%B8%E0%A7%8D%E0%A6%9F-%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%9F%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A7%A8%E0%A7%AC-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AB%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BE</guid>
      <pubDate>Tue, 10 Nov 2026 14:02:08 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2020/11/10/54d21692f604710e7d1e3ec2e48f77e9-5faa495aa3a3e.jpg?jadewits_media_id=698218" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2020/11/10/54d21692f604710e7d1e3ec2e48f77e9-5faa495aa3a3e.jpg?jadewits_media_id=698218" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2020/11/10/54d21692f604710e7d1e3ec2e48f77e9-5faa495aa3a3e.jpg?jadewits_media_id=698218" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টেস্ট ক্রিকেটে বাংলাদেশের ২৬ বছর, সাফল্যের পাল্লা কতটা ভারী?" /&gt;&lt;/p&gt;&lt;p&gt;২০০০ সালের ১০ নভেম্বর। শীতের এক সকালে ভারতের বিপক্ষে তৎকালীন বঙ্গবন্ধু জাতীয় স্টেডিয়ামে প্রথমবারের মতো টেস্ট ক্রিকেটে অভিষেক হয় বাংলাদেশের। দেখতে দেখতে আন্তর্জাতিক ক্রিকেটের দীর্ঘতম সংস্করণে ২৬ বছর পূর্ণ করল লাল-সবুজের দল। শুরুতে টেস্ট ক্রিকেটে নিজেদের সামর্থ্য প্রমাণ করতে বেশ কঠিন সময় পার করতে হয়েছ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/cricket/979994/%E0%A6%9F%E0%A7%87%E0%A6%B8%E0%A7%8D%E0%A6%9F-%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%9F%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A7%A8%E0%A7%AC-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AB%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BE">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>লগি-বৈঠা নিয়ে পদ্মা সেতুর কাছে অবরোধ–ভাঙচুর, ককটেল বিস্ফোরণ</title>

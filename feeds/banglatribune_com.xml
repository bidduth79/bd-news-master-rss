    <item>
      <title>সারের ডিলার নিয়োগে দলীয়করণের অভিযোগ, সংসদে আলোচনা চায় জামায়াত</title>
      <link>https://www.banglatribune.com/national/979885/%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%A1%E0%A6%BF%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%8B%E0%A6%97%E0%A7%87-%E0%A6%A6%E0%A6%B2%E0%A7%80%E0%A7%9F%E0%A6%95%E0%A6%B0%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6%E0%A7%87-%E0%A6%86%E0%A6%B2%E0%A7%8B%E0%A6%9A%E0%A6%A8%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/national/979885/%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%A1%E0%A6%BF%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%8B%E0%A6%97%E0%A7%87-%E0%A6%A6%E0%A6%B2%E0%A7%80%E0%A7%9F%E0%A6%95%E0%A6%B0%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6%E0%A7%87-%E0%A6%86%E0%A6%B2%E0%A7%8B%E0%A6%9A%E0%A6%A8%E0%A6%BE</guid>
      <pubDate>Mon, 09 Nov 2026 20:45:50 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/19f852f3a03d799c746dd6ce5c725f13-6af1bfd97862e.jpg?jadewits_media_id=1054061" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/19f852f3a03d799c746dd6ce5c725f13-6af1bfd97862e.jpg?jadewits_media_id=1054061" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/19f852f3a03d799c746dd6ce5c725f13-6af1bfd97862e.jpg?jadewits_media_id=1054061" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সারের ডিলার নিয়োগে দলীয়করণের অভিযোগ, সংসদে আলোচনা চায় জামায়াত" /&gt;&lt;/p&gt;&lt;p&gt;দেশের বিভিন্ন অঞ্চলে কৃষকদের সারপ্রাপ্তিতে সংকট, অতিরিক্ত দামে কালোবাজারে সার বিক্রি এবং ডিলার নিয়োগে অনিয়ম ও দলীয়করণের অভিযোগ তুলে জাতীয় সংসদে জরুরি আলোচনার দাবি জানিয়েছে বিরোধীদল জামায়াতে ইসলামী। কার্যপ্রণালি বিধির ৬৮ বিধি অনুযায়ী জনগুরুত্বসম্পন্ন এ বিষয়ে আলোচনার জন্য সংসদ সচিবালয়ে নোটিশ জমা দেওয়া&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/979885/%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%A1%E0%A6%BF%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%8B%E0%A6%97%E0%A7%87-%E0%A6%A6%E0%A6%B2%E0%A7%80%E0%A7%9F%E0%A6%95%E0%A6%B0%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6%E0%A7%87-%E0%A6%86%E0%A6%B2%E0%A7%8B%E0%A6%9A%E0%A6%A8%E0%A6%BE">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>লালবাগে বিপ্লব হত্যা মামলার প্রধান দুই আসামি গ্রেফতার</title>
      <link>https://www.banglatribune.com/law-and-crime/979884/%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A6%97%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A6%AC-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%86%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/979884/%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A6%97%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A6%AC-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%86%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%BF</guid>
      <pubDate>Mon, 09 Nov 2026 20:45:30 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/43b142804dfa0e3c36b57fab8abe3c89-6af1dc6415cd4.jpg?jadewits_media_id=1054097" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/43b142804dfa0e3c36b57fab8abe3c89-6af1dc6415cd4.jpg?jadewits_media_id=1054097" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/43b142804dfa0e3c36b57fab8abe3c89-6af1dc6415cd4.jpg?jadewits_media_id=1054097" style="max-width:100%;height:auto;margin-bottom:10px;" alt="লালবাগে বিপ্লব হত্যা মামলার প্রধান দুই আসামি গ্রেফতার" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর লালবাগে আধিপত্য বিস্তার ও পূর্বশত্রুতার জেরে বিপ্লব হোসেন (২৭) হত্যা মামলার প্রধান দুই আসামিকে গ্রেফতার করেছে ঢাকা মেট্রোপলিটন পুলিশের (ডিএমপি) লালবাগ থানা পুলিশ।
গ্রেফতার ব্যক্তিরা হলেন মো. মাইনু (২৬) ও আল-আমিন ওরফে স্বাধীন ওরফে ডিপজল (২২)।
লালবাগ থানা সূত্রে জানা যায়, গত ১ নভেম্বর দুপুর আ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/979884/%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A6%97%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A6%AC-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%86%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%BF">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>দুই ইনিংসেই ৫০০ ছাড়ানো প্রথম দল জিম্বাবুয়ে!</title>
      <link>https://www.banglatribune.com/sport/cricket/979883/%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%87%E0%A6%A8%E0%A6%BF%E0%A6%82%E0%A6%B8%E0%A7%87%E0%A6%87-%E0%A7%AB%E0%A7%A6%E0%A7%A6-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%A6%E0%A6%B2-%E0%A6%9C%E0%A6%BF%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A7%81%E0%A7%9F%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/cricket/979883/%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%87%E0%A6%A8%E0%A6%BF%E0%A6%82%E0%A6%B8%E0%A7%87%E0%A6%87-%E0%A7%AB%E0%A7%A6%E0%A7%A6-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%A6%E0%A6%B2-%E0%A6%9C%E0%A6%BF%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A7%81%E0%A7%9F%E0%A7%87</guid>
      <pubDate>Mon, 09 Nov 2026 20:45:02 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/abd97e1e8e121728db05668c7f19805d-6af1dc2e4ca29.jpg?jadewits_media_id=1054096" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/abd97e1e8e121728db05668c7f19805d-6af1dc2e4ca29.jpg?jadewits_media_id=1054096" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/abd97e1e8e121728db05668c7f19805d-6af1dc2e4ca29.jpg?jadewits_media_id=1054096" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দুই ইনিংসেই ৫০০ ছাড়ানো প্রথম দল জিম্বাবুয়ে!" /&gt;&lt;/p&gt;&lt;p&gt;ড্র হয়েছে ম্যাচ, কিন্তু ব্যাট হাতে ইতিহাস গড়েছে জিম্বাবুয়ে। টেস্ট ক্রিকেটে প্রথম দল হিসেবে এক ম্যাচের দুই ইনিংসেই ৫০০ বা তার বেশি রান করার কীর্তি গড়েছে তারা। সোমবার শারজা ক্রিকেট স্টেডিয়ামে আফগানিস্তানের বিপক্ষে সিরিজের প্রথম টেস্টে এই রেকর্ড গড়েছে জিম্বাবুয়ে।

এশিয়া কাপের সেমিফাইনালে বাংলাদেশ

প্রথ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/cricket/979883/%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%87%E0%A6%A8%E0%A6%BF%E0%A6%82%E0%A6%B8%E0%A7%87%E0%A6%87-%E0%A7%AB%E0%A7%A6%E0%A7%A6-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%A6%E0%A6%B2-%E0%A6%9C%E0%A6%BF%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A7%81%E0%A7%9F%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>পদোন্নতিপ্রাপ্ত ১০ সহকারী পুলিশ কমিশনারকে র‍্যাংক ব্যাজ পরালেন ডিএমপি কমিশনার</title>

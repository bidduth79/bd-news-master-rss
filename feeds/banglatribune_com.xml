      <link>https://www.banglatribune.com/educations/982638/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A6%A8-%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A5%E0%A6%B2%E0%A6%BF%E0%A6%95</link>
      <guid isPermaLink="true">https://www.banglatribune.com/educations/982638/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A6%A8-%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A5%E0%A6%B2%E0%A6%BF%E0%A6%95</guid>
      <pubDate>Mon, 23 Nov 2026 04:08:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/411e3e41cc3c245a12abc2648e7f5749-6b0359c06dbeb.jpg?jadewits_media_id=1056440" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/411e3e41cc3c245a12abc2648e7f5749-6b0359c06dbeb.jpg?jadewits_media_id=1056440" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/411e3e41cc3c245a12abc2648e7f5749-6b0359c06dbeb.jpg?jadewits_media_id=1056440" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রধান শিক্ষকের ওপর অভিভাবকের নির্যাতন, ক্যাথলিক শিক্ষা বোর্ডের নিন্দা" /&gt;&lt;/p&gt;&lt;p&gt;যশোরের ঝিকরগাছায় সেন্ট লুইস মাধ্যমিক বিদ্যালয়ের প্রধান শিক্ষকের ওপর অভিভাবকের শারীরিক নির্যাতনের ঘটনায় তীব্র নিন্দা ও উদ্বেগ জানিয়েছে বাংলাদেশ ক্যাথলিক শিক্ষা বোর্ড (বিসিইবি)। গত ১৭ নভেম্বর সংঘটিত এ ঘটনায় সংশ্লিষ্ট অভিভাবককে গ্রেফতার করায় আইনশৃঙ্খলা রক্ষাকারী বাহিনীর প্রতি কৃতজ্ঞতা প্রকাশ করেছে বোর্&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/educations/982638/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A6%A8-%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A5%E0%A6%B2%E0%A6%BF%E0%A6%95">বাংলা ট্রিবিউন</source>

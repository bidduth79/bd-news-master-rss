      <guid isPermaLink="true">https://www.banglatribune.com/country/khulna/980744/%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A7%8E-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A7%8B%E0%A6%A8%E0%A6%93-%E0%A6%86%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A6%A4-%E0%A6%AA%E0%A6%BE%E0%A7%9F%E0%A6%A8%E0%A6%BF</guid>
      <pubDate>Fri, 13 Nov 2026 19:58:32 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/bde3b1964d1462e5b928388b954249b4-6af717771c559.jpg?jadewits_media_id=1054844" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/bde3b1964d1462e5b928388b954249b4-6af717771c559.jpg?jadewits_media_id=1054844" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/bde3b1964d1462e5b928388b954249b4-6af717771c559.jpg?jadewits_media_id=1054844" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এমপির বাড়িতে বিদ্যুৎ থেকে আগুনের কোনও আলামত পায়নি পল্লী বিদ্যুৎ" /&gt;&lt;/p&gt;&lt;p&gt;কুষ্টিয়ার দৌলতপুরে জাতীয় নাগরিক পার্টির (এনসিপি) সংরক্ষিত আসনের সংসদ সদস্য নুসরাত তাবাসসুমের গ্রামের বাড়িতে অগ্নিকাণ্ডের ঘটনায় বৈদ্যুতিক শর্টসার্কিটের কোনও আলামত পাওয়া যায়নি বলে জানিয়েছেন কুষ্টিয়া পল্লী বিদ্যুৎ সমিতির প্রাগপুর সাব-জোনাল অফিসের এজিএম মো. তোজাম্মেল হক।
শুক্রবার (১৩ নভেম্বর) বি&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/khulna/980744/%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A7%8E-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A7%8B%E0%A6%A8%E0%A6%93-%E0%A6%86%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A6%A4-%E0%A6%AA%E0%A6%BE%E0%A7%9F%E0%A6%A8%E0%A6%BF">বাংলা ট্রিবিউন</source>

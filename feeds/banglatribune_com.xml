    <item>
      <title>জোহানেসবার্গে যে অনন্য কীর্তি গড়েছেন লিটন</title>
      <link>https://www.banglatribune.com/sport/cricket/981809/%E0%A6%9C%E0%A7%8B%E0%A6%B9%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B8%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%AF%E0%A7%87-%E0%A6%85%E0%A6%A8%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%95%E0%A7%80%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%97%E0%A7%9C%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%B2%E0%A6%BF%E0%A6%9F%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/cricket/981809/%E0%A6%9C%E0%A7%8B%E0%A6%B9%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B8%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%AF%E0%A7%87-%E0%A6%85%E0%A6%A8%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%95%E0%A7%80%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%97%E0%A7%9C%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%B2%E0%A6%BF%E0%A6%9F%E0%A6%A8</guid>
      <pubDate>Thu, 19 Nov 2026 09:00:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/d37a2f10e3d0ff73716f1ae5877830dc-6afd870bc9d19.jpg?jadewits_media_id=1055677" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/d37a2f10e3d0ff73716f1ae5877830dc-6afd870bc9d19.jpg?jadewits_media_id=1055677" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/d37a2f10e3d0ff73716f1ae5877830dc-6afd870bc9d19.jpg?jadewits_media_id=1055677" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জোহানেসবার্গে যে অনন্য কীর্তি গড়েছেন লিটন" /&gt;&lt;/p&gt;&lt;p&gt;ব্যাট হাতে সেঞ্চুরির সঙ্গে উইকেটের পেছনে বিশ্বরেকর্ড! জোহানেসবার্গে দক্ষিণ আফ্রিকার বিপক্ষে প্রথম টেস্টে অনন্য এই কীর্তি গড়েছেন লিটন দাস। টেস্ট ক্রিকেটের এক ইনিংসে উইকেটরক্ষক হিসেবে সর্বোচ্চ আটটি ডিসমিসালের বিশ্বরেকর্ড এখন তার দখলে। তার চেয়েও বড় বিষয় হচ্ছে একই ইনিংসে সেঞ্চুরি ও আটটি ডিসমিসালের কীর্ত&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/cricket/981809/%E0%A6%9C%E0%A7%8B%E0%A6%B9%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B8%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%AF%E0%A7%87-%E0%A6%85%E0%A6%A8%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%95%E0%A7%80%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%97%E0%A7%9C%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%B2%E0%A6%BF%E0%A6%9F%E0%A6%A8">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>হঠাৎ জেঁকে বসেছে শীত, পঞ্চগড়ে মৌসুমের সর্বনিম্ন তাপমাত্রা</title>
      <link>https://www.banglatribune.com/country/rangpur/981870/%E0%A6%B9%E0%A6%A0%E0%A6%BE%E0%A7%8E-%E0%A6%9C%E0%A7%87%E0%A6%81%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%B8%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%B6%E0%A7%80%E0%A6%A4-%E0%A6%AA%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%97%E0%A7%9C%E0%A7%87-%E0%A6%AE%E0%A7%8C%E0%A6%B8%E0%A7%81%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%A8%E0%A6%BF%E0%A6%AE%E0%A7%8D%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/rangpur/981870/%E0%A6%B9%E0%A6%A0%E0%A6%BE%E0%A7%8E-%E0%A6%9C%E0%A7%87%E0%A6%81%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%B8%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%B6%E0%A7%80%E0%A6%A4-%E0%A6%AA%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%97%E0%A7%9C%E0%A7%87-%E0%A6%AE%E0%A7%8C%E0%A6%B8%E0%A7%81%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%A8%E0%A6%BF%E0%A6%AE%E0%A7%8D%E0%A6%A8</guid>
      <pubDate>Thu, 19 Nov 2026 08:58:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2024/01/22/-4-65ed1cab5c18fe7d7bdbc7830245e235.jpg?jadewits_media_id=898855" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2024/01/22/-4-65ed1cab5c18fe7d7bdbc7830245e235.jpg?jadewits_media_id=898855" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2024/01/22/-4-65ed1cab5c18fe7d7bdbc7830245e235.jpg?jadewits_media_id=898855" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হঠাৎ জেঁকে বসেছে শীত, পঞ্চগড়ে মৌসুমের সর্বনিম্ন তাপমাত্রা" /&gt;&lt;/p&gt;&lt;p&gt;শীতের বার্তা নিয়ে এসেছে অগ্রহায়ণ। মাসটির শুরুতেই উত্তরের জেলা পঞ্চগড়ে জেঁকে বসতে শুরু করেছে শীত। কয়েক দিনের ব্যবধানে তাপমাত্রা কমে বৃহস্পতিবার (১৯ নভেম্বর) সকালে নেমেছে ১২ দশমিক ৫ ডিগ্রি সেলসিয়াসে। এটি চলতি মৌসুমে জেলার সর্বনিম্ন তাপমাত্রা।
বৃহস্পতিবার (১৯ নভেম্বর) সকাল ৬টায় জেলার তেঁতুলিয়া আবহাওয়া &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/rangpur/981870/%E0%A6%B9%E0%A6%A0%E0%A6%BE%E0%A7%8E-%E0%A6%9C%E0%A7%87%E0%A6%81%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%B8%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%B6%E0%A7%80%E0%A6%A4-%E0%A6%AA%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%97%E0%A7%9C%E0%A7%87-%E0%A6%AE%E0%A7%8C%E0%A6%B8%E0%A7%81%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%A8%E0%A6%BF%E0%A6%AE%E0%A7%8D%E0%A6%A8">বাংলা ট্রিবিউন</source>

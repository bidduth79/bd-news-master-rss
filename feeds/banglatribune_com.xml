      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/980249/%E0%A6%A8%E0%A6%BF%E0%A6%96%E0%A7%8B%E0%A6%81%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%9D%E0%A7%8B%E0%A6%AA%E0%A6%9D%E0%A6%BE%E0%A7%9C-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A7%E0%A6%97%E0%A6%B2%E0%A6%BF%E0%A6%A4-%E0%A6%B2%E0%A6%BE%E0%A6%B6-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Wed, 11 Nov 2026 15:59:58 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/46c915424d98a53050af5587a978e579-6af43c76defaf.jpg?jadewits_media_id=1054421" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/46c915424d98a53050af5587a978e579-6af43c76defaf.jpg?jadewits_media_id=1054421" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/46c915424d98a53050af5587a978e579-6af43c76defaf.jpg?jadewits_media_id=1054421" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নিখোঁজের পর ঝোপঝাড় থেকে অর্ধগলিত লাশ উদ্ধার" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর ডেমরায় নিখোঁজের ৪ দিন পর নড়াইবাগ বালুর ঝোপঝাড় থেকে প্রতিবন্ধী&amp;nbsp; হামিদুল ইসলামের (১৩) অর্ধগলিত লাশ উদ্ধার করেছে পুলিশ।&amp;nbsp;
এ ঘটনায় আরিফ (১৯) নামের একজনকে গ্রেফতার করা হয়েছে।&amp;nbsp;
ডেমরা থানার এসআই শায়ক খসরু বলেন, হামিদুল ছিল প্রতিবন্ধী, ৪ দিন যাবত তাকে খুঁজে পাচ্ছিলেন না তার পরিবার। বি&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/980249/%E0%A6%A8%E0%A6%BF%E0%A6%96%E0%A7%8B%E0%A6%81%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%9D%E0%A7%8B%E0%A6%AA%E0%A6%9D%E0%A6%BE%E0%A7%9C-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A7%E0%A6%97%E0%A6%B2%E0%A6%BF%E0%A6%A4-%E0%A6%B2%E0%A6%BE%E0%A6%B6-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0">বাংলা ট্রিবিউন</source>

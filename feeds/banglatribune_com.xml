    <item>
      <title>খুলনার সন্ত্রাস নির্মূলে কঠোর ব্যবস্থা নেওয়ার নির্দেশ প্রধানমন্ত্রীর</title>
      <link>https://www.banglatribune.com/politics/bnp/981171/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B8-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%82%E0%A6%B2%E0%A7%87-%E0%A6%95%E0%A6%A0%E0%A7%8B%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE-%E0%A6%A8%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/politics/bnp/981171/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B8-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%82%E0%A6%B2%E0%A7%87-%E0%A6%95%E0%A6%A0%E0%A7%8B%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE-%E0%A6%A8%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Mon, 16 Nov 2026 03:21:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/05/11/da2c5e3b0a2a42215fc5d15457ce1899-6a019c0b350cf.jpg?jadewits_media_id=1023254" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/05/11/da2c5e3b0a2a42215fc5d15457ce1899-6a019c0b350cf.jpg?jadewits_media_id=1023254" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/05/11/da2c5e3b0a2a42215fc5d15457ce1899-6a019c0b350cf.jpg?jadewits_media_id=1023254" style="max-width:100%;height:auto;margin-bottom:10px;" alt="খুলনার সন্ত্রাস নির্মূলে কঠোর ব্যবস্থা নেওয়ার নির্দেশ প্রধানমন্ত্রীর" /&gt;&lt;/p&gt;&lt;p&gt;খুলনার অবনতিশীল আইনশৃঙ্খলা পরিস্থিতি স্বাভাবিক করতে কঠোর পদক্ষেপ নেওয়ার নির্দেশ দিয়েছেন প্রধানমন্ত্রী তারেক রহমান। খুন, চাঁদাবাজি, লুটপাট ও ভাঙচুর বন্ধে কোনও ধরনের ছাড় না দিয়ে অপরাধী চক্রের নেটওয়ার্ক ভেঙে ফেলার সিদ্ধান্ত হয়েছে। সন্ত্রাসীদের চিহ্নিত করতে বিশেষ উদ্যোগে একাধিক দল কাজ শুরু করেছে।
শনিবার&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/politics/bnp/981171/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B8-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%82%E0%A6%B2%E0%A7%87-%E0%A6%95%E0%A6%A0%E0%A7%8B%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE-%E0%A6%A8%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>সেই কুরিয়ারের ওয়্যারহাউসে হামলা চালিয়ে লুটপাট, দুই গাড়িতে আগুন</title>
      <link>https://www.banglatribune.com/others/capital-city/981170/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%87%E0%A6%87-%E0%A6%95%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A7%9F%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A6%B9%E0%A6%BE%E0%A6%89%E0%A6%B8%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/others/capital-city/981170/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%87%E0%A6%87-%E0%A6%95%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A7%9F%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A6%B9%E0%A6%BE%E0%A6%89%E0%A6%B8%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A7%87</guid>
      <pubDate>Mon, 16 Nov 2026 04:59:52 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/21cf1adfad191c0195f71b644276b53c-6afa1910b9742.jpg?jadewits_media_id=1055198" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/21cf1adfad191c0195f71b644276b53c-6afa1910b9742.jpg?jadewits_media_id=1055198" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/21cf1adfad191c0195f71b644276b53c-6afa1910b9742.jpg?jadewits_media_id=1055198" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সেই কুরিয়ারের ওয়্যারহাউসে হামলা চালিয়ে লুটপাট, দুই গাড়িতে আগুন" /&gt;&lt;/p&gt;&lt;p&gt;এজেআর কুরিয়ার সার্ভিসের  আবারও হামলা, ভাঙচুর, লুটপাট ও দুটি পরিবহনে আগুন দিয়েছে সন্ত্রাসীরা। রবিবার (১৫ নভেম্বর) রাত ১০টার কিছু পর হাজারীবাগ শাখায় এ ঘটনা ঘটে।
এর আগে বিকাল ৪টার দিকে মোহাম্মদপুরে হামলা ও ভাঙচুরের ঘটনা ঘটে। ৬ ঘণ্টার ব্যবধানে দুটো হামলার ঘটনা ঘটলো।
জানা গেছে, রবিবার রাত ১০টার দিকে এজেআ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/others/capital-city/981170/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%87%E0%A6%87-%E0%A6%95%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A7%9F%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A6%B9%E0%A6%BE%E0%A6%89%E0%A6%B8%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>

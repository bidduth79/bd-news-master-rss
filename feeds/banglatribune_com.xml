      <guid isPermaLink="true">https://www.banglatribune.com/country/rajshahi/981865/%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A7%9C%E0%A6%95-%E0%A7%A9-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%85%E0%A6%AC%E0%A6%B0%E0%A7%8B%E0%A6%A7-%E0%A6%9B%E0%A6%BF%E0%A6%B2</guid>
      <pubDate>Thu, 19 Nov 2026 08:35:03 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/d6647fd7e053c8eb8ab55cabc009f03c-6afe60390e6f5.jpg?jadewits_media_id=1055792" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/d6647fd7e053c8eb8ab55cabc009f03c-6afe60390e6f5.jpg?jadewits_media_id=1055792" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/d6647fd7e053c8eb8ab55cabc009f03c-6afe60390e6f5.jpg?jadewits_media_id=1055792" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নিষিদ্ধ ছাত্রলীগের দাবি মহাসড়ক ৩ ঘণ্টা অবরোধ ছিল, পুলিশ বলছে ‘সুযোগ দেইনি’" /&gt;&lt;/p&gt;&lt;p&gt;কার্যক্রম নিষিদ্ধ আওয়ামী লীগ ও অঙ্গ সংগঠনের নেতাকর্মীরা পাবনার বিভিন্ন স্থানে মশাল মিছিল ও মহাসড়ক অবরোধ করেছেন। জেলার আতাইকুলা, ভাঙ্গুড়া, সাঁথিয়া, বেড়া ও ঈশ্বরদী এলাকায় এসব কর্মসূচি পালন করা হয়েছে।
পাবনা জেলা নিষিদ্ধ ছাত্রলীগের ফেসবুক থেকে প্রচারিত ছবি ও তথ্য অনুযায়ী, আতাইকুলা থানা এলাকায় পাবনা-ঢাকা&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/rajshahi/981865/%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A7%9C%E0%A6%95-%E0%A7%A9-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%85%E0%A6%AC%E0%A6%B0%E0%A7%8B%E0%A6%A7-%E0%A6%9B%E0%A6%BF%E0%A6%B2">বাংলা ট্রিবিউন</source>

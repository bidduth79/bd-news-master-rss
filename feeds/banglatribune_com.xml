      <guid isPermaLink="true">https://www.banglatribune.com/politics/other-politics/982061/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%97%E0%A6%A3%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A7%9F-%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F</guid>
      <pubDate>Fri, 20 Nov 2026 00:46:15 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/09/15/c597593235aaedc34b926336ee4f6d86-6aa935080e904.jpg?jadewits_media_id=1043885" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/09/15/c597593235aaedc34b926336ee4f6d86-6aa935080e904.jpg?jadewits_media_id=1043885" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/09/15/c597593235aaedc34b926336ee4f6d86-6aa935080e904.jpg?jadewits_media_id=1043885" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রোহিঙ্গা গণহত্যার রায় গাজায় ইসরায়েলের মামলায় প্রাসঙ্গিক হবে: আসিফ নজরুল" /&gt;&lt;/p&gt;&lt;p&gt;রোহিঙ্গা জনগোষ্ঠীর বিরুদ্ধে ২০১৭ সালে গণহত্যা চালানোর দায়ে মিয়ানমারের বিরুদ্ধে আন্তর্জাতিক বিচার আদালতের (আইসিজে) দেওয়া রায় গাজায় গণহত্যার অভিযোগে ইসরায়েলের বিরুদ্ধে চলমান মামলায় অত্যন্ত প্রাসঙ্গিক হবে বলে মন্তব্য করেছেন সাবেক অন্তর্বর্তী সরকারের উপদেষ্টা আসিফ নজরুল।
বৃহস্পতিবার (১৯ নভেম্বর) দিবাগত &lt;/p&gt;</description>

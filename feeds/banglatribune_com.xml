    <item>
      <title>ইসলামি ব্যাংকগুলোর তারল্য বাড়াতে ৩২ হাজার কোটি টাকার সুকুক ছাড়া হবে</title>
      <link>https://www.banglatribune.com/business/983040/%E0%A6%87%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A6%BF-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A7%8B%E0%A6%B0-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%B2%E0%A7%8D%E0%A6%AF-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A7%A9%E0%A7%A8-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.banglatribune.com/business/983040/%E0%A6%87%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A6%BF-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A7%8B%E0%A6%B0-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%B2%E0%A7%8D%E0%A6%AF-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A7%A9%E0%A7%A8-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF</guid>
      <pubDate>Tue, 24 Nov 2026 22:04:52 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/10/22/0d05e75570e6c21a0e6d17ec383f7242-6ada11eb3bd8c.jpg?jadewits_media_id=1050824" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/10/22/0d05e75570e6c21a0e6d17ec383f7242-6ada11eb3bd8c.jpg?jadewits_media_id=1050824" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/10/22/0d05e75570e6c21a0e6d17ec383f7242-6ada11eb3bd8c.jpg?jadewits_media_id=1050824" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইসলামি ব্যাংকগুলোর তারল্য বাড়াতে ৩২ হাজার কোটি টাকার সুকুক ছাড়া হবে" /&gt;&lt;/p&gt;&lt;p&gt;ইসলামি ব্যাংকগুলোর তারল্য সংকট কমানো এবং শরিয়াহসম্মত বিনিয়োগের সুযোগ সম্প্রসারণে ২০২৬-২৭ অর্থবছরে ৩২ হাজার কোটি টাকার বাংলাদেশ গভর্নমেন্ট ইনভেস্টমেন্ট সুকুক ইস্যু করার পরিকল্পনা করেছে বাংলাদেশ ব্যাংক।
এই উদ্যোগের ফলে শরিয়াহসম্মত বিনিয়োগ উপকরণের ঘাটতি কমবে, ইসলামি ব্যাংকগুলোর তারল্য ব্যবস্থাপনা শক্তি&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/business/983040/%E0%A6%87%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A6%BF-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A7%8B%E0%A6%B0-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%B2%E0%A7%8D%E0%A6%AF-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A7%A9%E0%A7%A8-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>রিভলবার ও গুলিসহ এক রোহিঙ্গা গ্রেফতার</title>
      <link>https://www.banglatribune.com/country/chitagong/983039/%E0%A6%B0%E0%A6%BF%E0%A6%AD%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%93-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B8%E0%A6%B9-%E0%A6%8F%E0%A6%95-%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/chitagong/983039/%E0%A6%B0%E0%A6%BF%E0%A6%AD%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%93-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B8%E0%A6%B9-%E0%A6%8F%E0%A6%95-%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Tue, 24 Nov 2026 21:25:05 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/82e9696a63c58084bea2704bb6623d0e-6b05ac3c17f15.jpg?jadewits_media_id=1056766" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/82e9696a63c58084bea2704bb6623d0e-6b05ac3c17f15.jpg?jadewits_media_id=1056766" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/82e9696a63c58084bea2704bb6623d0e-6b05ac3c17f15.jpg?jadewits_media_id=1056766" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রিভলবার ও গুলিসহ এক রোহিঙ্গা গ্রেফতার" /&gt;&lt;/p&gt;&lt;p&gt;কক্সবাজারের উখিয়ার রোহিঙ্গা ক্যাম্প থেকে একটি রিভলবার, এক রাউন্ড তাজা গুলি, একটি খালি খোসা ও চাবুকসহ এক রোহিঙ্গাকে গ্রেফতার করেছে স্পেশাল রেসপন্স ব্যাটালিয়ন (এসআরবি)-১৫।&amp;nbsp;
মঙ্গলবার (২৪ নভেম্বর) সকালে ক্যাম্প-১৭ এলাকায় অভিযান চালিয়ে তাকে গ্রেফতার করা হয়।
গ্রেফতার ব্যক্তি ক্যাম্প-১৭-জোরহমান এর ছেল&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/chitagong/983039/%E0%A6%B0%E0%A6%BF%E0%A6%AD%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%93-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B8%E0%A6%B9-%E0%A6%8F%E0%A6%95-%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>

    <item>
      <title>বাংলাদেশের কাছে হারের পর মুতাইরির বিস্ফোরণ, ‘মধ্যরাতের মেইলেই বুঝেছিলাম আমরা হারতে যাচ্ছি’</title>
      <link>https://www.banglatribune.com/sport/football/980392/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%9B%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%A4%E0%A6%BE%E0%A6%87%E0%A6%B0%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/football/980392/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%9B%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%A4%E0%A6%BE%E0%A6%87%E0%A6%B0%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3</guid>
      <pubDate>Thu, 12 Nov 2026 01:37:49 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/a76de2ff1fe4c35d127abda3633f6b07-6af4c3a6f3792.jpg?jadewits_media_id=1054538" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/a76de2ff1fe4c35d127abda3633f6b07-6af4c3a6f3792.jpg?jadewits_media_id=1054538" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/a76de2ff1fe4c35d127abda3633f6b07-6af4c3a6f3792.jpg?jadewits_media_id=1054538" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাংলাদেশের কাছে হারের পর মুতাইরির বিস্ফোরণ, ‘মধ্যরাতের মেইলেই বুঝেছিলাম আমরা হারতে যাচ্ছি’" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশের কাছে ৪-০ গোলের বড় ব্যবধানে হারের পর সংবাদ সম্মেলনে এসে যেন ক্ষোভের বিস্ফোরণ ঘটালেন শ্রীলঙ্কার প্রধান কোচ আবদুল্লাহ আল মুতাইরি। মাঠের পারফরম্যান্স নিয়ে সংক্ষিপ্ত মন্তব্যের পরই সাফের আইন বিভাগের প্রধান তানজিমের বিরুদ্ধে একের পর এক অভিযোগ তুলেছেন তিনি। ২০২১ ও ২০২৩ সালের সাফ চ্যাম্পিয়নশিপের ব&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/football/980392/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%9B%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%A4%E0%A6%BE%E0%A6%87%E0%A6%B0%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>হামজাকে ১০ এ ১০ দিলেন ডুলি</title>
      <link>https://www.banglatribune.com/sport/980391/%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%9C%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A7%A7%E0%A7%A6-%E0%A6%8F-%E0%A7%A7%E0%A7%A6-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%A1%E0%A7%81%E0%A6%B2%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/980391/%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%9C%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A7%A7%E0%A7%A6-%E0%A6%8F-%E0%A7%A7%E0%A7%A6-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%A1%E0%A7%81%E0%A6%B2%E0%A6%BF</guid>
      <pubDate>Thu, 12 Nov 2026 01:32:28 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/19dcc9e318151acb9cf3d84601ae565b-6af4c27e02a56.jpg?jadewits_media_id=1054537" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/19dcc9e318151acb9cf3d84601ae565b-6af4c27e02a56.jpg?jadewits_media_id=1054537" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/19dcc9e318151acb9cf3d84601ae565b-6af4c27e02a56.jpg?jadewits_media_id=1054537" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হামজাকে ১০ এ ১০ দিলেন ডুলি" /&gt;&lt;/p&gt;&lt;p&gt;ইংল্যান্ডের ক্লাব ফুটবলে হামজাকে সাধারণত ডিফেন্সিভ মিডফিল্ডার হিসেবে খেলতে দেখা যায়। কিন্তু ডুলি তাকে বাংলাদেশের হয়ে অপেক্ষাকৃত আক্রমণাত্মক ভূমিকায় ব্যবহার করছেন। শ্রীলঙ্কার বিপক্ষেও ১০ নম্বর পজিশনে খেলেছেন হামজা। এর ব্যাখ্যায় কোচ জানিয়েছেন, মাঝমাঠের রক্ষণ সামলানোর দায়িত্ব অন্যদের দিয়ে হামজার আক্রমণ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/980391/%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%9C%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A7%A7%E0%A7%A6-%E0%A6%8F-%E0%A7%A7%E0%A7%A6-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%A1%E0%A7%81%E0%A6%B2%E0%A6%BF">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>তুরস্কের প্রেসিডেন্টের নৈশভোজে সস্ত্রীক প্রধানমন্ত্রী তারেক রহমান</title>
      <link>https://www.banglatribune.com/national/980390/%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B8%E0%A6%BF%E0%A6%A1%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A7%88%E0%A6%B6%E0%A6%AD%E0%A7%8B%E0%A6%9C%E0%A7%87-%E0%A6%B8%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%95</link>
      <guid isPermaLink="true">https://www.banglatribune.com/national/980390/%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B8%E0%A6%BF%E0%A6%A1%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A7%88%E0%A6%B6%E0%A6%AD%E0%A7%8B%E0%A6%9C%E0%A7%87-%E0%A6%B8%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%95</guid>
      <pubDate>Thu, 12 Nov 2026 01:28:37 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/37e90a79dfefdd5e47fd28003f0e3eeb-6af4c17c09846.jpg?jadewits_media_id=1054536" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/37e90a79dfefdd5e47fd28003f0e3eeb-6af4c17c09846.jpg?jadewits_media_id=1054536" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/37e90a79dfefdd5e47fd28003f0e3eeb-6af4c17c09846.jpg?jadewits_media_id=1054536" style="max-width:100%;height:auto;margin-bottom:10px;" alt="তুরস্কের প্রেসিডেন্টের নৈশভোজে সস্ত্রীক প্রধানমন্ত্রী তারেক রহমান" /&gt;&lt;/p&gt;&lt;p&gt;তুরস্কের প্রেসিডেন্ট রিসেপ তাইয়েপ এরদোয়ান ও ফার্স্ট লেডি এমিনে এরদোয়ানের আয়োজনে বিশ্বনেতাদের সম্মানে দেওয়া নৈশভোজে অংশ নিয়েছেন বাংলাদেশের প্রধানমন্ত্রী তারেক রহমান। তার সঙ্গে ছিলেন সহধর্মিণী ডা. জুবাইদা রহমান। নৈশভোজে বিশ্বের বিভিন্ন দেশের রাষ্ট্র ও সরকারপ্রধান এবং তাদের সহধর্মিণীদের সঙ্গে প্রধানমন্&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/980390/%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B8%E0%A6%BF%E0%A6%A1%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A7%88%E0%A6%B6%E0%A6%AD%E0%A7%8B%E0%A6%9C%E0%A7%87-%E0%A6%B8%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%95">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>কপ-৩১ সম্মেলনে বাংলাদেশ প্যাভিলিয়ন পরিদর্শন করলেন প্রধানমন্ত্রী তারেক রহমান</title>
      <link>https://www.banglatribune.com/national/980389/%E0%A6%95%E0%A6%AA-%E0%A7%A9%E0%A7%A7-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%AA%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AD%E0%A6%BF%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%A8-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%A6%E0%A6%B0%E0%A7%8D%E0%A6%B6%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/national/980389/%E0%A6%95%E0%A6%AA-%E0%A7%A9%E0%A7%A7-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%AA%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AD%E0%A6%BF%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%A8-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%A6%E0%A6%B0%E0%A7%8D%E0%A6%B6%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Thu, 12 Nov 2026 01:11:22 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/62619363cc952a0a8730e3ad058c413d-6af4bdbd6f526.jpg?jadewits_media_id=1054535" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/62619363cc952a0a8730e3ad058c413d-6af4bdbd6f526.jpg?jadewits_media_id=1054535" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/62619363cc952a0a8730e3ad058c413d-6af4bdbd6f526.jpg?jadewits_media_id=1054535" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কপ-৩১ সম্মেলনে বাংলাদেশ প্যাভিলিয়ন পরিদর্শন করলেন প্রধানমন্ত্রী তারেক রহমান" /&gt;&lt;/p&gt;&lt;p&gt;তুরস্কের আন্তালিয়ায় জাতিসংঘের জলবায়ু পরিবর্তনবিষয়ক সম্মেলনে (কপ-৩১) বাংলাদেশ প্যাভিলিয়ন পরিদর্শন করেছেন প্রধানমন্ত্রী তারেক রহমান। এ সময় তিনি প্যাভিলিয়নে প্রদর্শিত পরিবেশবান্ধব পাটজাত পণ্যের প্রদর্শনী ঘুরে দেখেন। পাশাপাশি পরিবেশ সংরক্ষণে বাংলাদেশের নেওয়া বিভিন্ন উদ্যোগের উপস্থাপনাও পর্যবেক্ষণ করেন।
&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/980389/%E0%A6%95%E0%A6%AA-%E0%A7%A9%E0%A7%A7-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%AA%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AD%E0%A6%BF%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%A8-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%A6%E0%A6%B0%E0%A7%8D%E0%A6%B6%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>‘ফারহান যেভাবে তিন-চারজনকে ড্রিবল করে কাটিয়ে গেলো, তা সত্যিই অসাধারণ’</title>
      <link>https://www.banglatribune.com/sport/football/980388/%E2%80%98%E0%A6%AB%E0%A6%BE%E0%A6%B0%E0%A6%B9%E0%A6%BE%E0%A6%A8-%E0%A6%AF%E0%A7%87%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A6%9C%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A6%A1%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%B2-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%9F%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%B2%E0%A7%8B</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/football/980388/%E2%80%98%E0%A6%AB%E0%A6%BE%E0%A6%B0%E0%A6%B9%E0%A6%BE%E0%A6%A8-%E0%A6%AF%E0%A7%87%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A6%9C%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A6%A1%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%B2-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%9F%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%B2%E0%A7%8B</guid>
      <pubDate>Thu, 12 Nov 2026 01:09:01 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/fa14e6dfc3b9c87c4ca24a7989f99dc0-6af4bce513b26.jpg?jadewits_media_id=1054534" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/fa14e6dfc3b9c87c4ca24a7989f99dc0-6af4bce513b26.jpg?jadewits_media_id=1054534" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/fa14e6dfc3b9c87c4ca24a7989f99dc0-6af4bce513b26.jpg?jadewits_media_id=1054534" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘ফারহান যেভাবে তিন-চারজনকে ড্রিবল করে কাটিয়ে গেলো, তা সত্যিই অসাধারণ’" /&gt;&lt;/p&gt;&lt;p&gt;শ্রীলঙ্কার বিপক্ষে বড় জয়ের পর বাংলাদেশ দলের পারফরম্যান্সে দারুণ সন্তুষ্ট প্রধান কোচ টমাস ডুলি। শুধু ফল নয়, দলের খেলার ধরন, আক্রমণাত্মক ফুটবল, রক্ষণভাগের সংগঠন এবং খেলোয়াড়দের লড়াকু মানসিকতায়ও মুগ্ধ তিনি। বিশেষ করে হামজা দেওয়ান চৌধুরীর পারফরম্যান্সে এতটাই খুশি যে তাকে ১০-এর মধ্যে ১০ দিয়েছেন এই জার্মান&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/football/980388/%E2%80%98%E0%A6%AB%E0%A6%BE%E0%A6%B0%E0%A6%B9%E0%A6%BE%E0%A6%A8-%E0%A6%AF%E0%A7%87%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A6%9C%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A6%A1%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%B2-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%9F%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%B2%E0%A7%8B">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>বর্জ্যকে কোনও ব্যবহার ছাড়াই নষ্ট হতে দেওয়া উচিত নয়: জুবাইদা রহমান</title>
      <link>https://www.banglatribune.com/national/980387/%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A7%8B%E0%A6%A8%E0%A6%93-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B9%E0%A6%BE%E0%A6%B0-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%87-%E0%A6%A8%E0%A6%B7%E0%A7%8D%E0%A6%9F-%E0%A6%B9%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%89%E0%A6%9A%E0%A6%BF%E0%A6%A4</link>
      <guid isPermaLink="true">https://www.banglatribune.com/national/980387/%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A7%8B%E0%A6%A8%E0%A6%93-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B9%E0%A6%BE%E0%A6%B0-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%87-%E0%A6%A8%E0%A6%B7%E0%A7%8D%E0%A6%9F-%E0%A6%B9%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%89%E0%A6%9A%E0%A6%BF%E0%A6%A4</guid>
      <pubDate>Thu, 12 Nov 2026 01:05:08 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/e9fd68d66ec8b85c149ef112870503c3-6af4bc33b4e03.jpg?jadewits_media_id=1054533" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/e9fd68d66ec8b85c149ef112870503c3-6af4bc33b4e03.jpg?jadewits_media_id=1054533" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/e9fd68d66ec8b85c149ef112870503c3-6af4bc33b4e03.jpg?jadewits_media_id=1054533" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বর্জ্যকে কোনও ব্যবহার ছাড়াই নষ্ট হতে দেওয়া উচিত নয়: জুবাইদা রহমান" /&gt;&lt;/p&gt;&lt;p&gt;প্রধানমন্ত্রীর সহধর্মিনী ডা. জুবাইদা রহমান বলেছেন, &amp;lsquo;বর্জ্যকে কোনও ব্যবহার ছাড়াই নষ্ট হতে দেওয়া উচিত নয়। বরং একে সম্পদে, শক্তির উৎসে এবং প্রবৃদ্ধির সুযোগে পরিণত করা উচিত। আসুন, আমরা বর্জ্যকে সম্পদে, দূষণকে সমাধানে এবং প্রতিশ্রুতিকে কার্যকর পদক্ষেপে রূপান্তরিত করি।&amp;rsquo; বাংলাদেশ বিশ্বব্যাপী সহ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/980387/%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A7%8B%E0%A6%A8%E0%A6%93-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B9%E0%A6%BE%E0%A6%B0-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%87-%E0%A6%A8%E0%A6%B7%E0%A7%8D%E0%A6%9F-%E0%A6%B9%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%89%E0%A6%9A%E0%A6%BF%E0%A6%A4">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>উত্তরায় কিশোর গ্যাংয়ের মূল হোতাসহ গ্রেফতার ৩</title>
      <link>https://www.banglatribune.com/law-and-crime/980386/%E0%A6%89%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A6%BF%E0%A6%B6%E0%A7%8B%E0%A6%B0-%E0%A6%97%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%82%E0%A6%B2-%E0%A6%B9%E0%A7%8B%E0%A6%A4%E0%A6%BE%E0%A6%B8%E0%A6%B9-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A7%A9</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/980386/%E0%A6%89%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A6%BF%E0%A6%B6%E0%A7%8B%E0%A6%B0-%E0%A6%97%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%82%E0%A6%B2-%E0%A6%B9%E0%A7%8B%E0%A6%A4%E0%A6%BE%E0%A6%B8%E0%A6%B9-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A7%A9</guid>
      <pubDate>Thu, 12 Nov 2026 00:59:30 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/cab0dd109e5bd5c3b96d9fbb42c17585-6af4ba7ea0229.jpg?jadewits_media_id=1054532" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/cab0dd109e5bd5c3b96d9fbb42c17585-6af4ba7ea0229.jpg?jadewits_media_id=1054532" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/cab0dd109e5bd5c3b96d9fbb42c17585-6af4ba7ea0229.jpg?jadewits_media_id=1054532" style="max-width:100%;height:auto;margin-bottom:10px;" alt="উত্তরায় কিশোর গ্যাংয়ের মূল হোতাসহ গ্রেফতার ৩" /&gt;&lt;/p&gt;&lt;p&gt;ঢাকা মেট্রোপলিটন পুলিশের (ডিএমপি) উত্তরা পূর্ব থানার অভিযানে কিশোর গ্যাংয়ের মূল হোতাসহ ৩ জন সক্রিয় সদস্য গ্রেফতার হয়েছে।
গ্রেফতারকৃত&amp;zwnj;দের নাম- মো: ফাহিম, মোহাম্মদ মাফুজুর রশিদ লাবিব (১৯) ও &amp;nbsp;মাহি বি চৌধুরী রাতুল (২০)।

আসিফ নজরুলের মোবাইল ফোন ছিনতাই

উত্তরা পূর্ব থানার বরাত দি&amp;zwnj;য়ে ডিএম&amp;z&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/980386/%E0%A6%89%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A6%BF%E0%A6%B6%E0%A7%8B%E0%A6%B0-%E0%A6%97%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%82%E0%A6%B2-%E0%A6%B9%E0%A7%8B%E0%A6%A4%E0%A6%BE%E0%A6%B8%E0%A6%B9-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A7%A9">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>সরকারি ক্রয় আইনে বড় পরিবর্তনের প্রস্তাব</title>
      <link>https://www.banglatribune.com/national/980385/%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%9F-%E0%A6%86%E0%A6%87%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A7%9C-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%AC</link>
      <guid isPermaLink="true">https://www.banglatribune.com/national/980385/%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%9F-%E0%A6%86%E0%A6%87%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A7%9C-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%AC</guid>
      <pubDate>Thu, 12 Nov 2026 00:58:57 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/03/18/3a299f4d4caf8fc1c316afe3fb80180e-69ba677760d45.jpg?jadewits_media_id=1015808" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/03/18/3a299f4d4caf8fc1c316afe3fb80180e-69ba677760d45.jpg?jadewits_media_id=1015808" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/03/18/3a299f4d4caf8fc1c316afe3fb80180e-69ba677760d45.jpg?jadewits_media_id=1015808" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সরকারি ক্রয় আইনে বড় পরিবর্তনের প্রস্তাব" /&gt;&lt;/p&gt;&lt;p&gt;সরকারি ক্রয় কার্যক্রমে দরপত্রে অংশগ্রহণের যোগ্যতা বাড়ানো, সীমিত দরপত্র পদ্ধতির ব্যবহার সম্প্রসারণ, দেশীয় পণ্যকে অগ্রাধিকার এবং দরপত্র মূল্যায়নে কারিগরি মান ও টেকসই বৈশিষ্ট্য বিবেচনার প্রস্তাব করা হয়েছে। এসব বিধান যুক্ত করে প্রণীত &amp;lsquo;পাবলিক প্রকিউরমেন্ট (দ্বিতীয় সংশোধন) আইন, ২০২৬&amp;rsquo; বিলটি জাত&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/980385/%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%9F-%E0%A6%86%E0%A6%87%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A7%9C-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%AC">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>নারায়ণগঞ্জে মাদরাসায় আগুন: ছাড়পত্র পেয়েছেন ৮৫ জন, চিকিৎসাধীন আরও ৯</title>
      <link>https://www.banglatribune.com/law-and-crime/980384/%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A6%A3%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A7%9F-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AA%E0%A7%87%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A7%AE%E0%A7%AB-%E0%A6%9C%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/980384/%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A6%A3%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A7%9F-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AA%E0%A7%87%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A7%AE%E0%A7%AB-%E0%A6%9C%E0%A6%A8</guid>
      <pubDate>Thu, 12 Nov 2026 00:55:02 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/09/30/9af2f8e4e9d6bc577ab1c117334b47fb-6abc32d7361d1.jpg?jadewits_media_id=1046493" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/09/30/9af2f8e4e9d6bc577ab1c117334b47fb-6abc32d7361d1.jpg?jadewits_media_id=1046493" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/09/30/9af2f8e4e9d6bc577ab1c117334b47fb-6abc32d7361d1.jpg?jadewits_media_id=1046493" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নারায়ণগঞ্জে মাদরাসায় আগুন: ছাড়পত্র পেয়েছেন ৮৫ জন, চিকিৎসাধীন আরও ৯" /&gt;&lt;/p&gt;&lt;p&gt;নারায়ণগঞ্জের ফতুল্লার সাইনবোর্ড এলাকায় জামিয়া আশরাফিয়া মাদরাসায় অগ্নিকাণ্ডের ঘটনায় আহত ৯ শিক্ষার্থী এখনও হাসপাতালে চিকিৎসাধীন। এ ঘটনায় এখন পর্যন্ত জাতীয় বার্ন ও প্লাস্টিক সার্জারি ইনস্টিটিউটে ৯৪ জন শিক্ষার্থী ভর্তি হয়েছিল। তাদের মধ্যে ৮৫ জন চিকিৎসা শেষে ছাড়পত্র পেয়েছে।
বুধবার (১১ নভেম্বর) জাতীয় বার্&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/980384/%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A6%A3%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A7%9F-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AA%E0%A7%87%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A7%AE%E0%A7%AB-%E0%A6%9C%E0%A6%A8">বাংলা ট্রিবিউন</source>

    <item>
      <title>বলিউড তারকাদের ঘিরে আতঙ্ক, বিশেষ বিধিনিষেধ জারি মুম্বাই পুলিশের</title>
      <link>https://www.banglatribune.com/entertainment/bollywood/980243/%E0%A6%AC%E0%A6%B2%E0%A6%BF%E0%A6%89%E0%A6%A1-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%98%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%A4%E0%A6%99%E0%A7%8D%E0%A6%95-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%AC%E0%A6%BF%E0%A6%A7%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A7%87%E0%A6%A7-%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.banglatribune.com/entertainment/bollywood/980243/%E0%A6%AC%E0%A6%B2%E0%A6%BF%E0%A6%89%E0%A6%A1-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%98%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%A4%E0%A6%99%E0%A7%8D%E0%A6%95-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%AC%E0%A6%BF%E0%A6%A7%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A7%87%E0%A6%A7-%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A6%BF</guid>
      <pubDate>Wed, 11 Nov 2026 15:34:29 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/6ba745da799981c2b318b17fbe6dd79b-6af436596d63c.jpg?jadewits_media_id=1054415" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/6ba745da799981c2b318b17fbe6dd79b-6af436596d63c.jpg?jadewits_media_id=1054415" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/6ba745da799981c2b318b17fbe6dd79b-6af436596d63c.jpg?jadewits_media_id=1054415" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বলিউড তারকাদের ঘিরে আতঙ্ক, বিশেষ বিধিনিষেধ জারি মুম্বাই পুলিশের" /&gt;&lt;/p&gt;&lt;p&gt;সুরক্ষিত নেই কোনও বলিউড তারকা। গত কয়েক মাসে সালমান খান, অক্ষয় কুমার, আয়ুষ্মান খুরানা, সঞ্জয় দত্ত, আমির খান, অমিতাভ বচ্চন, রণবীর কাপুরসহ অনেক তারকাকে হুমকি দেওয়া হয়েছে। পুলিশ সূত্রে খবর, এই তারকারা লরেন্স বিষ্ণোই গ্যাংয়ের নিশানায় রয়েছেন।
এবার বলিউডের হেভিওয়েট তারকাদের সুরক্ষায় বিশেষ বিধি নিষেধ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/entertainment/bollywood/980243/%E0%A6%AC%E0%A6%B2%E0%A6%BF%E0%A6%89%E0%A6%A1-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%98%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%A4%E0%A6%99%E0%A7%8D%E0%A6%95-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%AC%E0%A6%BF%E0%A6%A7%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A7%87%E0%A6%A7-%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A6%BF">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>পাইপলাইনে ৯০ হাজার কোটি টাকার উন্নয়ন প্রকল্প: শাহে আলম</title>
      <link>https://www.banglatribune.com/national/980241/%E0%A6%AA%E0%A6%BE%E0%A6%87%E0%A6%AA%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%A8%E0%A7%87-%E0%A7%AF%E0%A7%A6-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A6%AF%E0%A6%BC%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA</link>
      <guid isPermaLink="true">https://www.banglatribune.com/national/980241/%E0%A6%AA%E0%A6%BE%E0%A6%87%E0%A6%AA%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%A8%E0%A7%87-%E0%A7%AF%E0%A7%A6-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A6%AF%E0%A6%BC%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA</guid>
      <pubDate>Wed, 11 Nov 2026 15:31:38 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/13a5ab758243c74177f292f0a1ee609f-6af435f09e2ea.jpg?jadewits_media_id=1054414" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/13a5ab758243c74177f292f0a1ee609f-6af435f09e2ea.jpg?jadewits_media_id=1054414" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/13a5ab758243c74177f292f0a1ee609f-6af435f09e2ea.jpg?jadewits_media_id=1054414" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পাইপলাইনে ৯০ হাজার কোটি টাকার উন্নয়ন প্রকল্প: শাহে আলম" /&gt;&lt;/p&gt;&lt;p&gt;দেশের অবকাঠামো উন্নয়ন ও সামাজিক সুরক্ষা কর্মসূচিকে গুরুত্ব দিয়ে প্রায় ৯০ হাজার কোটি টাকার প্রকল্প সরকারের পাইপলাইনে আছে বলে জানিয়েছেন স্থানীয় সরকার ও পল্লী উন্নয়ন ও সমবায় প্রতিমন্ত্রী মীর শাহে আলম।
বুধবার (১১ নভেম্বর) রাজধানীর আগারগাঁওয়ে এলজিইডি ভবনে পৌরসভার প্রশাসক ও সংশ্লিষ্টদের নিয়ে আয়োজিত প্রি&lt;/p&gt;</description>

      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/8b9aaed5ed2daa705aaeb278f31a32d9-6b03f98e332e4.jpg?jadewits_media_id=1056495" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কিশোরগঞ্জে দুদক কার্যালয়ে পেট্রোল বোমা নিক্ষেপ" /&gt;&lt;/p&gt;&lt;p&gt;কিশোরগঞ্জ শহরের নগুয়া বটতলা এলাকায় দুর্নীতি দমন কমিশনের (দুদক) কার্যালয় লক্ষ্য করে দুটি পেট্রোল বোমা নিক্ষেপ করেছে দুর্বৃত্তরা। রবিবার (২১ নভেম্বর) রাত ১১টার দিকে এ ঘটনা ঘটে। এতে কার্যালয়ের বারান্দায় আগুন ধরলেও কোনও ক্ষয়ক্ষতি হয়নি।
দুদক ও পুলিশ সূত্রে জানা গেছে, রাত ১১টার দিকে কার্যালয়ের নিচতলার ফটক&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/dhaka/982706/%E0%A6%95%E0%A6%BF%E0%A6%B6%E0%A7%8B%E0%A6%B0%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE-%E0%A6%A6%E0%A7%81%E0%A6%A6%E0%A6%95-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B2-%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>রেকর্ড রানবন্যার পরও ভারতকে জয়বঞ্চিত করলো নিউজিল্যান্ড</title>
      <link>https://www.banglatribune.com/sport/cricket/982705/%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A1-%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%93-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A6%95%E0%A7%87-%E0%A6%9C%E0%A7%9F%E0%A6%AC%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%BF%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%8B</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/cricket/982705/%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A1-%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%93-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A6%95%E0%A7%87-%E0%A6%9C%E0%A7%9F%E0%A6%AC%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%BF%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%8B</guid>
      <pubDate>Mon, 23 Nov 2026 14:29:58 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/e9016b8a65511266d31d900c30e8b8dd-6b03f92d8b3a2.jpg?jadewits_media_id=1056494" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/e9016b8a65511266d31d900c30e8b8dd-6b03f92d8b3a2.jpg?jadewits_media_id=1056494" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/e9016b8a65511266d31d900c30e8b8dd-6b03f92d8b3a2.jpg?jadewits_media_id=1056494" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রেকর্ড রানবন্যার পরও ভারতকে জয়বঞ্চিত করলো নিউজিল্যান্ড" /&gt;&lt;/p&gt;&lt;p&gt;রানের পাহাড় গড়েও জয় পাওয়া হলো না ভারতের। ওয়েলিংটনে রেকর্ডের পর রেকর্ড গড়া প্রথম টেস্টে শেষ পর্যন্ত হার মানেনি নিউজিল্যান্ড। স্বাগতিকদের দৃঢ় প্রতিরোধে সোমবার ড্র হয়েছে ম্যাচটি। প্রথম ইনিংসে বিশাল লিড নিয়েও জয়ের জন্য প্রয়োজনীয় পাঁচটি উইকেট নিতে পারেনি ভারত।
ম্যাচের শেষ দিনে সিরিজে ১-০ ব্যবধানে এগিয়ে য&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/cricket/982705/%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A1-%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%93-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A6%95%E0%A7%87-%E0%A6%9C%E0%A7%9F%E0%A6%AC%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%BF%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%8B">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>পাকিস্তান গেলেন স্পিকার</title>
      <link>https://www.banglatribune.com/national/982703/%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8-%E0%A6%97%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0%C2%A0</link>

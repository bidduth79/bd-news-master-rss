    <item>
      <title>হৃদয় মনে করেন, ৩৫০ রানও তাড়া করা সম্ভব</title>
      <link>https://www.banglatribune.com/sport/cricket/979653/%E0%A6%B9%E0%A7%83%E0%A6%A6%E0%A7%9F-%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%95%E0%A6%B0%E0%A7%87%E0%A6%A8-%E0%A7%A9%E0%A7%AB%E0%A7%A6-%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A6%93-%E0%A6%A4%E0%A6%BE%E0%A7%9C%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%BE-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AD%E0%A6%AC</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/cricket/979653/%E0%A6%B9%E0%A7%83%E0%A6%A6%E0%A7%9F-%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%95%E0%A6%B0%E0%A7%87%E0%A6%A8-%E0%A7%A9%E0%A7%AB%E0%A7%A6-%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A6%93-%E0%A6%A4%E0%A6%BE%E0%A7%9C%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%BE-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AD%E0%A6%AC</guid>
      <pubDate>Sun, 08 Nov 2026 19:35:07 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/989c16fce0e3fd8d4d7bcfec5875644c-6af079d8236bf.png?jadewits_media_id=1053912" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/989c16fce0e3fd8d4d7bcfec5875644c-6af079d8236bf.png?jadewits_media_id=1053912" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/989c16fce0e3fd8d4d7bcfec5875644c-6af079d8236bf.png?jadewits_media_id=1053912" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হৃদয় মনে করেন, ৩৫০ রানও তাড়া করা সম্ভব" /&gt;&lt;/p&gt;&lt;p&gt;ওয়েস্ট ইন্ডিজের বিপক্ষে সিলেট টেস্টের শেষ দিনে ৩৫০ রানের লক্ষ্য তাড়া করা সম্ভব বলে মনে করেন তাওহীদ হৃদয়।&amp;nbsp;
সিলেটে দ্বিতীয় টেস্টের চতুর্থ দিন শেষে দ্বিতীয় ইনিংসে ওয়েস্ট ইন্ডিজের সংগ্রহ ৩ উইকেটে ৩৪৫ রান। তাতে তাদের লিড দাঁড়িয়েছে ৩১৫ রানে। কাভেম হজ ১৪০ রানে অপরাজিত আছেন, সঙ্গে আমির জাঙ্গু ২০ রানে ব&lt;/p&gt;</description>

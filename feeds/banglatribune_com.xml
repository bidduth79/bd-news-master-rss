    <item>
      <title>মুখোমুখি বিএনপির দুই পক্ষ, এমপির গাড়ি ভাঙচুর</title>
      <link>https://www.banglatribune.com/country/chitagong/979712/%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%8B%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A6%BF-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%AA%E0%A6%95%E0%A7%8D%E0%A6%B7-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%97%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%AD%E0%A6%BE%E0%A6%99%E0%A6%9A%E0%A7%81%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/chitagong/979712/%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%8B%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A6%BF-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%AA%E0%A6%95%E0%A7%8D%E0%A6%B7-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%97%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%AD%E0%A6%BE%E0%A6%99%E0%A6%9A%E0%A7%81%E0%A6%B0</guid>
      <pubDate>Mon, 09 Nov 2026 03:04:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/818f2b07b3bfe49e3c480853d9dd0bf2-6af0df4c7821f.jpg?jadewits_media_id=1053957" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/818f2b07b3bfe49e3c480853d9dd0bf2-6af0df4c7821f.jpg?jadewits_media_id=1053957" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/818f2b07b3bfe49e3c480853d9dd0bf2-6af0df4c7821f.jpg?jadewits_media_id=1053957" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মুখোমুখি বিএনপির দুই পক্ষ, এমপির গাড়ি ভাঙচুর" /&gt;&lt;/p&gt;&lt;p&gt;বিপ্লব ও সংহতি দিবস উপলক্ষে কুমিল্লার দেবীদ্বারে বিএনপির দুই পক্ষ পাল্টাপাল্টি মিছিল ও সমাবেশ করেছে। এ সময় সংরক্ষিত নারী আসনের সংসদ সদস্য রাশেদা বেগমের (হীরা) গাড়িবহরে হামলা ও ভাঙচুর করা হয়েছে। রবিবার (৮ নভেম্বর) বিকালে দেবীদ্বার পৌরসভার কালাচাঁন মার্কেট এলাকায় এ ঘটনা ঘটে।
বিএনপি ও স্থানীয় সূত্রে জা&lt;/p&gt;</description>

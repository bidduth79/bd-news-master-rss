      <guid isPermaLink="true">https://www.banglatribune.com/foreign/middle-east/982516/%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8-%E0%A6%85%E0%A6%AC%E0%A6%B0%E0%A7%8B%E0%A6%A7-%E0%A6%AD%E0%A6%BE%E0%A6%99%E0%A6%A4%E0%A7%87-%E0%A7%A7%E0%A7%AA-%E0%A6%9F%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%81%E0%A6%A4-%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Sun, 22 Nov 2026 15:55:24 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/04/28/bfc11e33be727462313c0f37a2d3e980-69f0539d60acf.jpg?jadewits_media_id=1021255" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/04/28/bfc11e33be727462313c0f37a2d3e980-69f0539d60acf.jpg?jadewits_media_id=1021255" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/04/28/bfc11e33be727462313c0f37a2d3e980-69f0539d60acf.jpg?jadewits_media_id=1021255" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মার্কিন অবরোধ ভাঙতে ১৪ ট্যাংকার প্রস্তুত ইরানের, উপসাগরে হামলার হুঁশিয়ারি" /&gt;&lt;/p&gt;&lt;p&gt;মার্কিন নৌ-অবরোধ উপেক্ষা করে আগামী কয়েক দিনের মধ্যে ১৪টির বেশি তেলবাহী ট্যাংকার পাঠানোর প্রস্তুতি নিচ্ছে ইরান। এসব জাহাজ আটকে দেওয়ার চেষ্টা করা হলে উপসাগরীয় অঞ্চলের জ্বালানি স্থাপনায় হামলা চালানোর হুঁশিয়ারি দিয়েছে তেহরান-সমর্থিত সংবাদমাধ্যম।
&amp;lsquo;অপারেশন ফেরেইদুন&amp;rsquo; নামে প্রস্তাবিত এই অভিযানে &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/middle-east/982516/%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8-%E0%A6%85%E0%A6%AC%E0%A6%B0%E0%A7%8B%E0%A6%A7-%E0%A6%AD%E0%A6%BE%E0%A6%99%E0%A6%A4%E0%A7%87-%E0%A7%A7%E0%A7%AA-%E0%A6%9F%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%81%E0%A6%A4-%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0">বাংলা ট্রিবিউন</source>

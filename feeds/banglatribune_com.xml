    <item>
      <title>এই দিনে পোড়া লাশের গন্ধে ভারী হয়ে উঠেছিল নিশ্চিন্তপুর</title>
      <link>https://www.banglatribune.com/others/982819/%E0%A6%8F%E0%A6%87-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%8B%E0%A7%9C%E0%A6%BE-%E0%A6%B2%E0%A6%BE%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%B9%E0%A7%9F%E0%A7%87-%E0%A6%89%E0%A6%A0%E0%A7%87%E0%A6%9B%E0%A6%BF%E0%A6%B2</link>
      <guid isPermaLink="true">https://www.banglatribune.com/others/982819/%E0%A6%8F%E0%A6%87-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%8B%E0%A7%9C%E0%A6%BE-%E0%A6%B2%E0%A6%BE%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%B9%E0%A7%9F%E0%A7%87-%E0%A6%89%E0%A6%A0%E0%A7%87%E0%A6%9B%E0%A6%BF%E0%A6%B2</guid>
      <pubDate>Tue, 24 Nov 2026 00:09:48 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/3c555af5cdcb4c8ab9e43263bce60fe6-6b0463528be76.jpg?jadewits_media_id=1056577" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/3c555af5cdcb4c8ab9e43263bce60fe6-6b0463528be76.jpg?jadewits_media_id=1056577" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/3c555af5cdcb4c8ab9e43263bce60fe6-6b0463528be76.jpg?jadewits_media_id=1056577" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এই দিনে পোড়া লাশের গন্ধে ভারী হয়ে উঠেছিল নিশ্চিন্তপুর" /&gt;&lt;/p&gt;&lt;p&gt;দেশের পোশাকশিল্পের ইতিহাসে এক কালো অধ্যায় তাজরীন ট্র্যাজেডি। ২০১২ সালের ২৪ নভেম্বর আশুলিয়ার ইয়ারপুর ইউনিয়নের নিশ্চিন্তপুরে তাজরীন ফ্যাশনসে ভয়াবহ অগ্নিকাণ্ডে ১১৩ জন শ্রমিকের মৃত্যু হয়। পরে চিকিৎসাধীন অবস্থায় মারা যান আরও চারজন। সেই দিন পোড়া লাশের গন্ধে ভারী হয়ে উঠেছিল পুরো এলাকা।
কারখানাটিতে এক হাজার&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/others/982819/%E0%A6%8F%E0%A6%87-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%8B%E0%A7%9C%E0%A6%BE-%E0%A6%B2%E0%A6%BE%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%B9%E0%A7%9F%E0%A7%87-%E0%A6%89%E0%A6%A0%E0%A7%87%E0%A6%9B%E0%A6%BF%E0%A6%B2">বাংলা ট্রিবিউন</source>
    </item>

    <item>
      <title>বাংলাদেশের পোশাকের অর্ডার কি সত্যিই ভারতে চলে গেছে?</title>
      <link>https://www.banglatribune.com/business/983884/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%BF-%E0%A6%B8%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BF%E0%A6%87-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%9A%E0%A6%B2%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/business/983884/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%BF-%E0%A6%B8%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BF%E0%A6%87-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%9A%E0%A6%B2%E0%A7%87</guid>
      <pubDate>Sun, 29 Nov 2026 00:01:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/f688aa65e85ac6cf576fa3c882584094-6af0795bda949.jpg?jadewits_media_id=1053911" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/f688aa65e85ac6cf576fa3c882584094-6af0795bda949.jpg?jadewits_media_id=1053911" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/f688aa65e85ac6cf576fa3c882584094-6af0795bda949.jpg?jadewits_media_id=1053911" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাংলাদেশের পোশাকের অর্ডার কি সত্যিই ভারতে চলে গেছে?" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশের তৈরি পোশাকশিল্প থেকে বিপুল পরিমাণ ক্রয়াদেশ অন্য দেশে চলে যাওয়ার খবর নতুন করে উদ্বেগ তৈরি করেছে। বিশেষ করে ভারতের দিকে বাংলাদেশের পোশাকের অর্ডার স্থানান্তরের দাবি সামনে আসার পর প্রশ্ন উঠেছে, আন্তর্জাতিক ক্রেতারা কি সত্যিই বাংলাদেশ থেকে মুখ ফিরিয়ে নিচ্ছেন? শ্রমিক অসন্তোষ ও উৎপাদন ব্যাহত হওয়&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/business/983884/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%BF-%E0%A6%B8%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BF%E0%A6%87-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%9A%E0%A6%B2%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>সভাপতি-সম্পাদকসহ ৯ পদে বিএনপি, দুটিতে জামায়াত-আ.লীগ বিজয়ী</title>
      <link>https://www.banglatribune.com/country/khulna/983899/%E0%A6%B8%E0%A6%AD%E0%A6%BE%E0%A6%AA%E0%A6%A4%E0%A6%BF-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BE%E0%A6%A6%E0%A6%95%E0%A6%B8%E0%A6%B9-%E0%A7%AF-%E0%A6%AA%E0%A6%A6%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%A6%E0%A7%81%E0%A6%9F%E0%A6%BF%E0%A6%A4%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/khulna/983899/%E0%A6%B8%E0%A6%AD%E0%A6%BE%E0%A6%AA%E0%A6%A4%E0%A6%BF-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BE%E0%A6%A6%E0%A6%95%E0%A6%B8%E0%A6%B9-%E0%A7%AF-%E0%A6%AA%E0%A6%A6%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%A6%E0%A7%81%E0%A6%9F%E0%A6%BF%E0%A6%A4%E0%A7%87</guid>
      <pubDate>Sat, 28 Nov 2026 23:53:42 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/9d147a2ae4e637bddd18d05fa138cae9-6b0b151f85177.jpg?jadewits_media_id=1057572" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/9d147a2ae4e637bddd18d05fa138cae9-6b0b151f85177.jpg?jadewits_media_id=1057572" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/9d147a2ae4e637bddd18d05fa138cae9-6b0b151f85177.jpg?jadewits_media_id=1057572" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সভাপতি-সম্পাদকসহ ৯ পদে বিএনপি, দুটিতে জামায়াত-আ.লীগ বিজয়ী" /&gt;&lt;/p&gt;&lt;p&gt;যশোর জেলা আইনজীবী সমিতির নির্বাচনে ১১টি পদের মধ্যে নয়টিতে বিএনপি-সমর্থিত জাতীয়তাবাদী আইনজীবী ফোরামের প্রার্থীরা বিজয়ী হয়েছেন। সভাপতি, সাধারণ সম্পাদক ও যুগ্ম সম্পাদক পদেও এই প্যানেলের প্রার্থীরা নির্বাচিত হয়েছেন।&amp;nbsp;
বাকি দুটি পদের একটিতে জামায়াতে ইসলামীপন্থি ও অন্যটিতে আওয়ামী লীগপন্থি প্রার্&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/khulna/983899/%E0%A6%B8%E0%A6%AD%E0%A6%BE%E0%A6%AA%E0%A6%A4%E0%A6%BF-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BE%E0%A6%A6%E0%A6%95%E0%A6%B8%E0%A6%B9-%E0%A7%AF-%E0%A6%AA%E0%A6%A6%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%A6%E0%A7%81%E0%A6%9F%E0%A6%BF%E0%A6%A4%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ছবি দিয়ে রাজনৈতিক পরিচয় নির্ধারণের চেষ্টা অনৈতিক: মঞ্জুর মুর্শেদ</title>
      <link>https://www.banglatribune.com/educations/983897/%E0%A6%9B%E0%A6%AC%E0%A6%BF-%E0%A6%A6%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A8%E0%A7%88%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%9A%E0%A6%AF%E0%A6%BC-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A7%87%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/educations/983897/%E0%A6%9B%E0%A6%AC%E0%A6%BF-%E0%A6%A6%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A8%E0%A7%88%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%9A%E0%A6%AF%E0%A6%BC-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A7%87%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BE</guid>
      <pubDate>Sat, 28 Nov 2026 23:37:23 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/81762740cec49046c80b54eda65209b9-6b0b110f32a2c.jpg?jadewits_media_id=1057570" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/81762740cec49046c80b54eda65209b9-6b0b110f32a2c.jpg?jadewits_media_id=1057570" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/81762740cec49046c80b54eda65209b9-6b0b110f32a2c.jpg?jadewits_media_id=1057570" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ছবি দিয়ে রাজনৈতিক পরিচয় নির্ধারণের চেষ্টা অনৈতিক: মঞ্জুর মুর্শেদ" /&gt;&lt;/p&gt;&lt;p&gt;ডিন হিসেবে দায়িত্ব পালনের সময়ের ছবি সামাজিক যোগাযোগমাধ্যমে ভিন্ন রাজনৈতিক বয়ানে প্রচার করে হেয় প্রতিপন্ন করার অপচেষ্টার প্রতিবাদ জানিয়েছেন জগন্নাথ বিশ্ববিদ্যালয় (জবি) শিক্ষক সমিতির ভারপ্রাপ্ত সভাপতি অধ্যাপক মঞ্জুর মুর্শেদ। তিনি বলেন, খণ্ডিত ছবি দিয়ে কারও রাজনৈতিক পরিচয় নির্ধারণ করা বিভ্রান্ত&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/educations/983897/%E0%A6%9B%E0%A6%AC%E0%A6%BF-%E0%A6%A6%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A8%E0%A7%88%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%9A%E0%A6%AF%E0%A6%BC-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A7%87%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BE">বাংলা ট্রিবিউন</source>

      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/e691d88f8d648348be60a92b479d2810-6afe08f0c953d.jpg?jadewits_media_id=1055779" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ড. ইউনূসের বাড়িতে আগুন, কার্যক্রম নিষিদ্ধ আ.লীগের সাবেক মেয়রের বাসায় অভিযান" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রাম নগরীতে সাবেক অন্তর্বর্তী সরকারের প্রধান উপদেষ্টা অধ্যাপক মুহাম্মদ ইউনূসের পৈতৃক বাড়িতে আগুন দেওয়া হয়েছে। কার্যক্রম নিষিদ্ধ আওয়ামী লীগের নেতাকর্মীরা এই আগুন দিয়েছেন বলে ধারণা করছে পুলিশ।
বুধবার রাত সাড়ে ১১টার দিকে নগরের পাঁচলাইশ এলাকার বাড়িটিতে আগুন দেওয়া হয়। তবে আগুন বড় আকার ধারণ করা&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/chitagong/981850/%E0%A6%A1.-%E0%A6%87%E0%A6%89%E0%A6%A8%E0%A7%82%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>দীপু মনি ও সুজিত নন্দীর বাড়িতে আগুন</title>
      <link>https://www.banglatribune.com/country/chitagong/981849/%E0%A6%A6%E0%A7%80%E0%A6%AA%E0%A7%81-%E0%A6%AE%E0%A6%A8%E0%A6%BF-%E0%A6%93-%E0%A6%B8%E0%A7%81%E0%A6%9C%E0%A6%BF%E0%A6%A4-%E0%A6%A8%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%80%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/chitagong/981849/%E0%A6%A6%E0%A7%80%E0%A6%AA%E0%A7%81-%E0%A6%AE%E0%A6%A8%E0%A6%BF-%E0%A6%93-%E0%A6%B8%E0%A7%81%E0%A6%9C%E0%A6%BF%E0%A6%A4-%E0%A6%A8%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%80%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</guid>
      <pubDate>Thu, 19 Nov 2026 01:43:40 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/d3ceb500cab73697ef6412c616664ee3-6afdfee86db8d.jpg?jadewits_media_id=1055778" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/d3ceb500cab73697ef6412c616664ee3-6afdfee86db8d.jpg?jadewits_media_id=1055778" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/d3ceb500cab73697ef6412c616664ee3-6afdfee86db8d.jpg?jadewits_media_id=1055778" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দীপু মনি ও সুজিত নন্দীর বাড়িতে আগুন" /&gt;&lt;/p&gt;&lt;p&gt;চাঁদপুরে সাবেক শিক্ষামন্ত্রী ও কার্যক্রম নিষিদ্ধ আওয়ামী লীগের যুগ্ম সাধারণ সম্পাদক দীপু মনি এবং দলটির সাংগঠনিক সম্পাদক সুজিত রায় নন্দীর পরিত্যক্ত বাড়িতে আগুন দিয়েছে দুর্বৃত্তরা।
বুধবার রাত ৯টার দিকে শহরের নতুন বাজারের কদমতলা মার্কেটের তিনতলায় দীপু মনির বাসায় আগুন দেওয়া হয়। পরে ভবনের বাসিন্দা ও আশপা&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/chitagong/981849/%E0%A6%A6%E0%A7%80%E0%A6%AA%E0%A7%81-%E0%A6%AE%E0%A6%A8%E0%A6%BF-%E0%A6%93-%E0%A6%B8%E0%A7%81%E0%A6%9C%E0%A6%BF%E0%A6%A4-%E0%A6%A8%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%80%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8">বাংলা ট্রিবিউন</source>

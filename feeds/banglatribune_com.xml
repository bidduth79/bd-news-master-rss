      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/06/14/e8cf1becd29a4214a60d981bc9a892df-6a2ea19cecd1c.jpg?jadewits_media_id=1028876" medium="image" />

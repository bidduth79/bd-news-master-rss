      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/702854afd8e330878a348bb1808fb2f1-6af08502dfc14.jpg?jadewits_media_id=1053923" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/702854afd8e330878a348bb1808fb2f1-6af08502dfc14.jpg?jadewits_media_id=1053923" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/702854afd8e330878a348bb1808fb2f1-6af08502dfc14.jpg?jadewits_media_id=1053923" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এবার গাইবান্ধায় পরীমণিকে বয়কটের ঘোষণা, বিক্ষোভ" /&gt;&lt;/p&gt;&lt;p&gt;সাংবাদিকের সঙ্গে অসৌজন্যমূলক আচরণের অভিযোগে এবার চিত্রনায়িকা পরীমণিকে বয়কটের ঘোষণা দিয়েছেন গাইবান্ধার সাংবাদিকরা। এ ঘটনায় ক্ষোভ প্রকাশ করে অভিনেত্রীর বিরুদ্ধে প্রতিবাদ ও বিক্ষোভ সমাবেশ করেছেন জেলার বিভিন্ন গণমাধ্যমকর্মীরা।
রবিবার (৮ নভেম্বর) দুপুর ১২টার দিকে গাইবান্ধা শহরের জেলা পুলিশ লাইনস রোডে এ প&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/rangpur/979668/%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%97%E0%A6%BE%E0%A6%87%E0%A6%AC%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%AE%E0%A6%A3%E0%A6%BF%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A7%9F%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%98%E0%A7%8B%E0%A6%B7%E0%A6%A3%E0%A6%BE-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8B%E0%A6%AD">বাংলা ট্রিবিউন</source>

      <guid isPermaLink="true">https://www.banglatribune.com/health/981393/%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A6%A4%E0%A6%BE%E0%A7%9F-%E0%A6%AD%E0%A7%81%E0%A6%97%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A7%AD%E0%A7%AE-%E0%A6%B6%E0%A6%A4%E0%A6%BE%E0%A6%82%E0%A6%B6-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%9D%E0%A7%81%E0%A6%81%E0%A6%95%E0%A6%BF-%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%81%E0%A6%B7%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Tue, 17 Nov 2026 08:00:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/780530cd6387f91520b8ca5f6f05e3fc-6afb34e469590.jpg?jadewits_media_id=1055374" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/780530cd6387f91520b8ca5f6f05e3fc-6afb34e469590.jpg?jadewits_media_id=1055374" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/780530cd6387f91520b8ca5f6f05e3fc-6afb34e469590.jpg?jadewits_media_id=1055374" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রক্তস্বল্পতায় ভুগছেন ৭৮ শতাংশ নারী, ঝুঁকি পুরুষের তুলনায় বেশি" /&gt;&lt;/p&gt;&lt;p&gt;শরীরের প্রয়োজনীয় পুষ্টি না পাওয়া, মাসিকের সময় অতিরিক্ত রক্তক্ষরণ, অল্প বয়সে বিয়ে ও মাতৃত্ব&amp;mdash;বিভিন্ন কারণে নারীদের মধ্যে রক্তস্বল্পতার ঝুঁকি বাড়ছে। এর সঙ্গে যুক্ত হয়েছে পরিবারের অন্য সদস্যদের তুলনায় নিজের খাবার ও স্বাস্থ্যের প্রতি নারীদের কম মনোযোগ। ফলে পুরুষের তুলনায় নারীরা প্রায় দ্বিগুণ হারে র&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/health/981393/%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A6%A4%E0%A6%BE%E0%A7%9F-%E0%A6%AD%E0%A7%81%E0%A6%97%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A7%AD%E0%A7%AE-%E0%A6%B6%E0%A6%A4%E0%A6%BE%E0%A6%82%E0%A6%B6-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%9D%E0%A7%81%E0%A6%81%E0%A6%95%E0%A6%BF-%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%81%E0%A6%B7%E0%A7%87%E0%A6%B0">বাংলা ট্রিবিউন</source>

      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/983201/%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AB%E0%A6%BF%E0%A6%95-%E0%A6%86%E0%A6%87%E0%A6%A8-%E0%A6%B2%E0%A6%99%E0%A7%8D%E0%A6%98%E0%A6%A8%E0%A7%87-%E0%A7%A8%E0%A7%AA-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A7%9F-%E0%A7%AA%E0%A7%A7%E0%A7%AF%E0%A7%A7-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE</guid>
      <pubDate>Wed, 25 Nov 2026 17:54:15 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/03/29/4595525a1934e283033f470e84cc8d6f-69c8d5da971f2.jpg?jadewits_media_id=1017157" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/03/29/4595525a1934e283033f470e84cc8d6f-69c8d5da971f2.jpg?jadewits_media_id=1017157" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/03/29/4595525a1934e283033f470e84cc8d6f-69c8d5da971f2.jpg?jadewits_media_id=1017157" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ট্রাফিক আইন লঙ্ঘনে ২৪ ঘণ্টায় ৪১৯১ মামলা" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানী ঢাকার বিভিন্ন এলাকায় ট্রাফিক আইন লঙ্ঘনকারীদের বিরুদ্ধে অভিযান চা&amp;zwnj;লি&amp;zwnj;য়ে গত ২৪ ঘণ্টায় ৪ হাজার ১৯১টি মামলা করেছে ডিএমপির ট্রাফিক বিভাগ। মঙ্গলবার (২৪ নভেম্বর) ডিএমপির ট্রাফিক বিভাগ রাজধানীর বিভিন্ন এলাকায় অভিযান চা&amp;zwnj;লি&amp;zwnj;য়ে এসব মামলা করে।।
বুধবার ডিএমপির পক্ষ থে&amp;zwnj;কে জানা&amp;zwn&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/983201/%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AB%E0%A6%BF%E0%A6%95-%E0%A6%86%E0%A6%87%E0%A6%A8-%E0%A6%B2%E0%A6%99%E0%A7%8D%E0%A6%98%E0%A6%A8%E0%A7%87-%E0%A7%A8%E0%A7%AA-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A7%9F-%E0%A7%AA%E0%A7%A7%E0%A7%AF%E0%A7%A7-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE">বাংলা ট্রিবিউন</source>
    </item>

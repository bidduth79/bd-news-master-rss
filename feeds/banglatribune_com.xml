    <item>
      <title>আবারও পেছালো এসএ গেমস</title>
      <link>https://www.banglatribune.com/sport/other-sports/983691/%E0%A6%86%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A6%93-%E0%A6%AA%E0%A7%87%E0%A6%9B%E0%A6%BE%E0%A6%B2%E0%A7%8B-%E0%A6%8F%E0%A6%B8%E0%A6%8F-%E0%A6%97%E0%A7%87%E0%A6%AE%E0%A6%B8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/other-sports/983691/%E0%A6%86%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A6%93-%E0%A6%AA%E0%A7%87%E0%A6%9B%E0%A6%BE%E0%A6%B2%E0%A7%8B-%E0%A6%8F%E0%A6%B8%E0%A6%8F-%E0%A6%97%E0%A7%87%E0%A6%AE%E0%A6%B8</guid>
      <pubDate>Sat, 28 Nov 2026 01:22:40 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/1b8f12f21a1f5c499c0fc3f15a0254dc-6b09d8782d664.jpg?jadewits_media_id=1057359" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/1b8f12f21a1f5c499c0fc3f15a0254dc-6b09d8782d664.jpg?jadewits_media_id=1057359" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/1b8f12f21a1f5c499c0fc3f15a0254dc-6b09d8782d664.jpg?jadewits_media_id=1057359" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আবারও পেছালো এসএ গেমস" /&gt;&lt;/p&gt;&lt;p&gt;দক্ষিণ এশিয়ান (এসএ) গেমস আয়োজন নিয়ে অনিশ্চয়তা যেন কাটছেই না। একের পর এক সূচি পরিবর্তনের পর আবারও পিছিয়ে গেলো প্রতিযোগিতাটির ১৪তম আসর। আগামী এপ্রিলে মাঠে গড়ানোর কথা থাকলেও শেষ পর্যন্ত পাঁচ মাস পিছিয়ে ২০২৭ সালের সেপ্টেম্বরে নতুন তারিখ নির্ধারণ করা হয়েছে।&amp;nbsp;
বিষয়টি এক বিজ্ঞপ্তিতে জানিয়েছে পাকিস্তান &lt;/p&gt;</description>

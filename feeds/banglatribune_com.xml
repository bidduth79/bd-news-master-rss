      <guid isPermaLink="true">https://www.banglatribune.com/national/979662/%E0%A6%A7%E0%A7%82%E0%A6%AE%E0%A6%AA%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%8F%E0%A6%B2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6-%E0%A6%9A%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A6%B0</guid>
      <pubDate>Sun, 08 Nov 2026 20:08:56 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2020/09/02/b9f18d41ebfaa4ba118052a0c38bbcd5-5f4f858e2d04e.jpg?jadewits_media_id=686524" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2020/09/02/b9f18d41ebfaa4ba118052a0c38bbcd5-5f4f858e2d04e.jpg?jadewits_media_id=686524" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2020/09/02/b9f18d41ebfaa4ba118052a0c38bbcd5-5f4f858e2d04e.jpg?jadewits_media_id=686524" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ধূমপানমুক্ত এলাকা হচ্ছে জাতীয় সংসদ চত্বর" /&gt;&lt;/p&gt;&lt;p&gt;জাতীয় সংসদ চত্বরকে ধূমপানমুক্ত এলাকা ঘোষণা করা হচ্ছে। প্রধানমন্ত্রী ও সংসদ নেতা তারেক রহমানের প্রস্তাবে কার্য উপদেষ্টা কমিটির সদস্যরা সর্বসম্মতিক্রমে সম্মতি দিয়েছেন।
রবিবার (৮ নভেম্বর) জাতীয় সংসদ ভবনের কেবিনেট কক্ষে ত্রয়োদশ জাতীয় সংসদের কার্য উপদেষ্টা কমিটির পঞ্চম বৈঠকে এ প্রস্তাব দেওয়া হয়। বৈঠকে সভ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/979662/%E0%A6%A7%E0%A7%82%E0%A6%AE%E0%A6%AA%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%8F%E0%A6%B2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6-%E0%A6%9A%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A6%B0">বাংলা ট্রিবিউন</source>

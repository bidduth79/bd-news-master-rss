      <pubDate>Sun, 08 Nov 2026 19:37:23 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2018/01/31/9feb8fcc31b2f9801a956e54a92abb81-5a717eb783c1c.jpg?jadewits_media_id=301341" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2018/01/31/9feb8fcc31b2f9801a956e54a92abb81-5a717eb783c1c.jpg?jadewits_media_id=301341" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2018/01/31/9feb8fcc31b2f9801a956e54a92abb81-5a717eb783c1c.jpg?jadewits_media_id=301341" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সীমান্ত থেকে সাইবার স্পেস: মাদকের বিস্তার রোধে নোটিশ" /&gt;&lt;/p&gt;&lt;p&gt;দেশে মাদকদ্রব্যের অবৈধ অনুপ্রবেশ, পাচার ও সরবরাহ প্রতিরোধে বিদ্যমান আইনগত ও প্রশাসনিক ব্যবস্থার দুর্বলতা চিহ্নিত করে প্রয়োজনীয় সংশোধনমূলক পদক্ষেপ নিতে আইনি নোটিশ পাঠানো হয়েছে।
একইসঙ্গে বর্ডার গার্ড বাংলাদেশ (বিজিবি), বাংলাদেশ কোস্ট গার্ড, পুলিশ, র&amp;zwj;্যাব, কাস্টমস এবং মাদকদ্রব্য নিয়ন্ত্রণ অধিদফতরের&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/979654/%E0%A6%B8%E0%A7%80%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A7%87%E0%A6%B8-%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%87">বাংলা ট্রিবিউন</source>

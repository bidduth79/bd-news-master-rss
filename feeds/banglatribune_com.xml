    <item>
      <title>দফায় দফায় পুলিশের সঙ্গে শ্রমিকদের সংঘর্ষ: পাল্টাপাল্টি ধাওয়া, সাউন্ড গ্রেনেড নিক্ষেপ</title>
      <link>https://www.banglatribune.com/country/dhaka/980376/%E0%A6%A6%E0%A6%AB%E0%A6%BE%E0%A7%9F-%E0%A6%A6%E0%A6%AB%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%B0%E0%A7%8D%E0%A6%B7</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/dhaka/980376/%E0%A6%A6%E0%A6%AB%E0%A6%BE%E0%A7%9F-%E0%A6%A6%E0%A6%AB%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%B0%E0%A7%8D%E0%A6%B7</guid>
      <pubDate>Wed, 11 Nov 2026 23:56:14 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/3f21d44c079c47054f4d0e202afdbf5d-6af4ac2a891b3.jpg?jadewits_media_id=1054525" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/3f21d44c079c47054f4d0e202afdbf5d-6af4ac2a891b3.jpg?jadewits_media_id=1054525" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/3f21d44c079c47054f4d0e202afdbf5d-6af4ac2a891b3.jpg?jadewits_media_id=1054525" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দফায় দফায় পুলিশের সঙ্গে শ্রমিকদের সংঘর্ষ: পাল্টাপাল্টি ধাওয়া, সাউন্ড গ্রেনেড নিক্ষেপ" /&gt;&lt;/p&gt;&lt;p&gt;সাভারের হেমায়েতপুরে বেতন বৃদ্ধির দাবিতে দফায় দফায় পোশাক শ্রমিকদের বিক্ষোভ, ধাওয়া-পাল্টা ধাওয়া ও সংঘর্ষের ঘটনা ঘটেছে। বুধবার (১১ নভেম্বর) দুপুরের পর থেকে বিকাল পর্যন্ত এসব ঘটনা ঘটেছে।
সকালে উত্তেজনার পর কিছুটা শান্ত হয়ে দুপুরে পদ্মার মোড়ে শ্রমিকরা ফের জড়ো হয়ে প্রতিরোধের চেষ্টা চালালে পুলিশ টিয়ারশেল &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/dhaka/980376/%E0%A6%A6%E0%A6%AB%E0%A6%BE%E0%A7%9F-%E0%A6%A6%E0%A6%AB%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%B0%E0%A7%8D%E0%A6%B7">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>বিএনপির দুই পক্ষের সংঘর্ষ: একাধিক ককটেল বিস্ফোরণ, আহত ১৫</title>

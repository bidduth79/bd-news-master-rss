    </item>
    <item>
      <title>খালেদা জিয়ার আসনে এমপি হওয়া ক্রীড়া সংগঠক হারুনুর রশিদ মারা গেছেন</title>
      <link>https://www.banglatribune.com/sport/other-sports/979930/%E0%A6%96%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A6%E0%A6%BE-%E0%A6%9C%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%B8%E0%A6%A8%E0%A7%87-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF-%E0%A6%B9%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A7%9C%E0%A6%BE-%E0%A6%B8%E0%A6%82%E0%A6%97%E0%A6%A0%E0%A6%95-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A7%81%E0%A6%A8%E0%A7%81%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/other-sports/979930/%E0%A6%96%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A6%E0%A6%BE-%E0%A6%9C%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%B8%E0%A6%A8%E0%A7%87-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF-%E0%A6%B9%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A7%9C%E0%A6%BE-%E0%A6%B8%E0%A6%82%E0%A6%97%E0%A6%A0%E0%A6%95-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A7%81%E0%A6%A8%E0%A7%81%E0%A6%B0</guid>
      <pubDate>Tue, 10 Nov 2026 02:42:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/daa4f17270ad6c5974aa8b8a8276b1c9-6af2274b09ed2.jpg?jadewits_media_id=1054140" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/daa4f17270ad6c5974aa8b8a8276b1c9-6af2274b09ed2.jpg?jadewits_media_id=1054140" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/daa4f17270ad6c5974aa8b8a8276b1c9-6af2274b09ed2.jpg?jadewits_media_id=1054140" style="max-width:100%;height:auto;margin-bottom:10px;" alt="খালেদা জিয়ার আসনে এমপি হওয়া ক্রীড়া সংগঠক হারুনুর রশিদ মারা গেছেন" /&gt;&lt;/p&gt;&lt;p&gt;আবাহনী ক্রীড়া চক্রের প্রতিষ্ঠাতা সাধারণ সম্পাদক হারুনুর রশিদ আর নেই । রাজধানীর ল্যাবএইড হাসপাতালে চিকিৎসাধীন অবস্থায় সোমবার (৯ নভেম্বর) মধ্যরাতে মৃত্যুবরণ করেন (ইন্না লিল্লাহি ওয়া ইন্না ইলাহি রাজিউন)। ৭৭ বছর বয়সে পৃথিবী ছেড়ে যাওয়ার সময় প্রথিতযশা সংগঠন, স্ত্রী ও দুই মেয়ে সহ অসংখ্য গুণগ্রাহী রেখে গেছে&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/other-sports/979930/%E0%A6%96%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A6%E0%A6%BE-%E0%A6%9C%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%B8%E0%A6%A8%E0%A7%87-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF-%E0%A6%B9%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A7%9C%E0%A6%BE-%E0%A6%B8%E0%A6%82%E0%A6%97%E0%A6%A0%E0%A6%95-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A7%81%E0%A6%A8%E0%A7%81%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>খুলনায় হুমকিতে যে ডায়াগনস্টিক সেন্টার বন্ধ হলো, সেটি আবার হুমকিতে চালু</title>
      <link>https://www.banglatribune.com/country/khulna/979929/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%95%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AF%E0%A7%87-%E0%A6%A1%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%97%E0%A6%A8%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%95-%E0%A6%B8%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7-%E0%A6%B9%E0%A6%B2%E0%A7%8B</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/khulna/979929/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%95%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AF%E0%A7%87-%E0%A6%A1%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%97%E0%A6%A8%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%95-%E0%A6%B8%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7-%E0%A6%B9%E0%A6%B2%E0%A7%8B</guid>
      <pubDate>Tue, 10 Nov 2026 02:24:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/7d648d89c9722ffde14a9d3228bf4086-6af2239354814.jpg?jadewits_media_id=1054139" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/7d648d89c9722ffde14a9d3228bf4086-6af2239354814.jpg?jadewits_media_id=1054139" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/7d648d89c9722ffde14a9d3228bf4086-6af2239354814.jpg?jadewits_media_id=1054139" style="max-width:100%;height:auto;margin-bottom:10px;" alt="খুলনায় হুমকিতে যে ডায়াগনস্টিক সেন্টার বন্ধ হলো, সেটি আবার হুমকিতে চালু" /&gt;&lt;/p&gt;&lt;p&gt;দাবি করা চাঁদার টাকা পরিশোধ করতে না পারায় রবিবার (৯ নভেম্বর) রাতে বন্ধ করে দেওয়া হয় খুলনা নগরীর পিটিআই মোড়ে অবস্থিত নিউ অ্যাপোলো ডায়াগনস্টিক অ্যান্ড কনসালটেশন সেন্টার। একদিন আগেই প্রতিষ্ঠানটিতে হামলা চালিয়ে ব্যাপক ভাঙচুর করে সন্ত্রাসীরা। হামলার পর রোববারের মধ্যে মোটা অঙ্কের টাকা পরিশোধের চাপ ছিল। নি&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/khulna/979929/%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%95%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AF%E0%A7%87-%E0%A6%A1%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%97%E0%A6%A8%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%95-%E0%A6%B8%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7-%E0%A6%B9%E0%A6%B2%E0%A7%8B">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>কার্যক্রম নিষিদ্ধ আ.লীগের কর্মসূচির ৫০০ প্যাকেট খিচুড়ি জব্দ</title>

      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/5f588c3f15139d2ed55064084a17df8c-6b001e9cb09a9.jpg?jadewits_media_id=1056020" length="0" type="image/jpeg" />

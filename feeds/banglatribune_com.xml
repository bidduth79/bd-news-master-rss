    <item>
      <title>রোহিঙ্গা গণহত্যা মামলা: মিয়ানমারের বিরুদ্ধে ঐতিহাসিক রায়ের আগে যা জানা প্রয়োজন</title>
      <link>https://www.banglatribune.com/foreign/europe/981752/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%97%E0%A6%A3%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/europe/981752/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%97%E0%A6%A3%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87</guid>
      <pubDate>Wed, 18 Nov 2026 18:10:19 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/1e4793b6a0c700a7f06d80c25e181e78-6afd955d865f0.jpg?jadewits_media_id=1055689" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/1e4793b6a0c700a7f06d80c25e181e78-6afd955d865f0.jpg?jadewits_media_id=1055689" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/1e4793b6a0c700a7f06d80c25e181e78-6afd955d865f0.jpg?jadewits_media_id=1055689" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রোহিঙ্গা গণহত্যা মামলা: মিয়ানমারের বিরুদ্ধে ঐতিহাসিক রায়ের আগে যা জানা প্রয়োজন" /&gt;&lt;/p&gt;&lt;p&gt;সংখ্যালঘু রোহিঙ্গা মুসলিমদের ওপর গণহত্যা চালানোর অভিযোগে মিয়ানমারের বিরুদ্ধে করা ঐতিহাসিক মামলার রায় বৃহস্পতিবার ঘোষণা করবে আন্তর্জাতিক বিচারিক আদালত (আইসিজে)। আইনি প্রক্রিয়া শুরুর প্রায় সাত বছর পর নেদারল্যান্ডসের হেগের পিস প্যালেসে স্থানীয় সময় সকাল ১০টায় (বাংলাদেশ সময় বিকাল ৩টা) এই রায় পড়া শুরু করব&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/europe/981752/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%97%E0%A6%A3%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>গ্রামীণ ব্যাংকে একের পর এক হামলা, ‘চাকরি ছাড়ার পরিকল্পনা’ কর্মকর্তা-কর্মচারীদের</title>
      <link>https://www.banglatribune.com/country/khulna/981751/%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%A3-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%8F%E0%A6%95-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E2%80%98%E0%A6%9A%E0%A6%BE%E0%A6%95%E0%A6%B0%E0%A6%BF-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/khulna/981751/%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%A3-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%8F%E0%A6%95-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E2%80%98%E0%A6%9A%E0%A6%BE%E0%A6%95%E0%A6%B0%E0%A6%BF-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Wed, 18 Nov 2026 18:06:14 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/b05d0aa451ba9dab6bd831c462837f88-6afd949b0e24d.jpg?jadewits_media_id=1055688" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/b05d0aa451ba9dab6bd831c462837f88-6afd949b0e24d.jpg?jadewits_media_id=1055688" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/b05d0aa451ba9dab6bd831c462837f88-6afd949b0e24d.jpg?jadewits_media_id=1055688" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গ্রামীণ ব্যাংকে একের পর এক হামলা, ‘চাকরি ছাড়ার পরিকল্পনা’ কর্মকর্তা-কর্মচারীদের" /&gt;&lt;/p&gt;&lt;p&gt;যশোরে গত এক সপ্তাহে গ্রামীণ ব্যাংকের চারটি শাখায় অগ্নিসংযোগ ও ককটেল বিস্ফারণের ঘটনা ঘটেছে। একের পর এক দুর্বৃত্তদের অগ্নিসংযোগ ও হামলা শাখাগুলোর তেমন ক্ষয়ক্ষতি না হলেও এসব ঘটনায় আতঙ্কিত হচ্ছেন কর্মকর্তা ও কর্মচারীরা। তবে এসব ঘটনায় একটিও মামলা করেনি কর্তৃপক্ষ। নিরাপত্তা নিশ্চিত করণে সব কেন্দ্রেই বসানো&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/khulna/981751/%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%A3-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%8F%E0%A6%95-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E2%80%98%E0%A6%9A%E0%A6%BE%E0%A6%95%E0%A6%B0%E0%A6%BF-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>

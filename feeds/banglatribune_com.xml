    <item>
      <title>দিবস আসে দিবস যায়, সহিংসতা কমে না: প্রতিরোধে ব্যবস্থা কোথায়?</title>
      <link>https://www.banglatribune.com/others/983051/%E0%A6%A6%E0%A6%BF%E0%A6%AC%E0%A6%B8-%E0%A6%86%E0%A6%B8%E0%A7%87-%E0%A6%A6%E0%A6%BF%E0%A6%AC%E0%A6%B8-%E0%A6%AF%E0%A6%BE%E0%A7%9F-%E0%A6%B8%E0%A6%B9%E0%A6%BF%E0%A6%82%E0%A6%B8%E0%A6%A4%E0%A6%BE-%E0%A6%95%E0%A6%AE%E0%A7%87-%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/others/983051/%E0%A6%A6%E0%A6%BF%E0%A6%AC%E0%A6%B8-%E0%A6%86%E0%A6%B8%E0%A7%87-%E0%A6%A6%E0%A6%BF%E0%A6%AC%E0%A6%B8-%E0%A6%AF%E0%A6%BE%E0%A7%9F-%E0%A6%B8%E0%A6%B9%E0%A6%BF%E0%A6%82%E0%A6%B8%E0%A6%A4%E0%A6%BE-%E0%A6%95%E0%A6%AE%E0%A7%87-%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%87</guid>
      <pubDate>Wed, 25 Nov 2026 08:01:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/90b8b9065fee23f6a4773f2f3021d32e-6b05bef8b0cb0.jpg?jadewits_media_id=1056777" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/90b8b9065fee23f6a4773f2f3021d32e-6b05bef8b0cb0.jpg?jadewits_media_id=1056777" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/90b8b9065fee23f6a4773f2f3021d32e-6b05bef8b0cb0.jpg?jadewits_media_id=1056777" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দিবস আসে দিবস যায়, সহিংসতা কমে না: প্রতিরোধে ব্যবস্থা কোথায়?" /&gt;&lt;/p&gt;&lt;p&gt;নারীর প্রতি সহিংসতা প্রতিরোধে দেশে আইন, নীতিমালা ও সচেতনতামূলক কর্মসূচি থাকলেও সহিংসতার ঘটনা কমছে না। বরং চলতি বছরের প্রথম নয় মাসে নারী ও কন্যাশিশুর ওপর সহিংসতা আগের বছরের একই সময়ের তুলনায় প্রায় ৫৯ শতাংশ বেড়েছে। অপরাধের বিচার নিশ্চিত করা, ভুক্তভোগীদের সুরক্ষা এবং সহিংসতা প্রতিরোধে কার্যকর উদ্যোগের ঘ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/others/983051/%E0%A6%A6%E0%A6%BF%E0%A6%AC%E0%A6%B8-%E0%A6%86%E0%A6%B8%E0%A7%87-%E0%A6%A6%E0%A6%BF%E0%A6%AC%E0%A6%B8-%E0%A6%AF%E0%A6%BE%E0%A7%9F-%E0%A6%B8%E0%A6%B9%E0%A6%BF%E0%A6%82%E0%A6%B8%E0%A6%A4%E0%A6%BE-%E0%A6%95%E0%A6%AE%E0%A7%87-%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>এবার ১০০ কোটির পথে শচীনের ব্র্যান্ড!</title>
      <link>https://www.banglatribune.com/sport/cricket/983023/%E0%A6%8F%E0%A6%95-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%87-%E0%A6%B2%E0%A6%BE%E0%A6%96%E0%A7%8B-%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A7%A7%E0%A7%A6%E0%A7%A6-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%B6%E0%A6%9A%E0%A7%80%E0%A6%A8%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/cricket/983023/%E0%A6%8F%E0%A6%95-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%87-%E0%A6%B2%E0%A6%BE%E0%A6%96%E0%A7%8B-%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A7%A7%E0%A7%A6%E0%A7%A6-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%B6%E0%A6%9A%E0%A7%80%E0%A6%A8%E0%A7%87%E0%A6%B0</guid>

    <item>
      <title>পয়েন্ট হারালো প্রিমিয়ার লিগের শীর্ষ দল, হারতে হারতে ড্র</title>
      <link>https://www.banglatribune.com/sport/football/982441/%E0%A6%AA%E0%A7%9F%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%B2%E0%A7%8B-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%B2%E0%A6%BF%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A7%80%E0%A6%B0%E0%A7%8D%E0%A6%B7-%E0%A6%A6%E0%A6%B2-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/football/982441/%E0%A6%AA%E0%A7%9F%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%B2%E0%A7%8B-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%B2%E0%A6%BF%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A7%80%E0%A6%B0%E0%A7%8D%E0%A6%B7-%E0%A6%A6%E0%A6%B2-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%87</guid>
      <pubDate>Sun, 22 Nov 2026 02:54:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/98aecd77e28ceeab9d1b6c27dd873a19-6b01fddc04486.jpg?jadewits_media_id=1056276" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/98aecd77e28ceeab9d1b6c27dd873a19-6b01fddc04486.jpg?jadewits_media_id=1056276" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/98aecd77e28ceeab9d1b6c27dd873a19-6b01fddc04486.jpg?jadewits_media_id=1056276" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পয়েন্ট হারালো প্রিমিয়ার লিগের শীর্ষ দল, হারতে হারতে ড্র" /&gt;&lt;/p&gt;&lt;p&gt;নিউক্যাসল ইউনাইটেডের মাঠে ২-২ গোলে ড্র করায় প্রিমিয়ার লিগের শীর্ষে ৮ পয়েন্টের লিড নেওয়ার সুযোগ হাতছাড়া করেছে আর্সেনাল। স্বাগতিকদের উজ্জীবিত পারফরম্যান্সের সামনে ২-১ গোলে পিছিয়ে পড়ার পর মিকেল আরতেতার দলকে লড়াই করে সমতা ফিরতে হয়েছে।
শনিবারের (২১ নভেম্বর) এই ম্যাচে প্রথমার্ধে আর্সেনালকে বেশ স্বচ্ছন্দই &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/football/982441/%E0%A6%AA%E0%A7%9F%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%B2%E0%A7%8B-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%B2%E0%A6%BF%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A7%80%E0%A6%B0%E0%A7%8D%E0%A6%B7-%E0%A6%A6%E0%A6%B2-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>পিছিয়ে পড়েও জয় তুলে নিলো পিএসজি</title>
      <link>https://www.banglatribune.com/sport/football/982440/%E0%A6%AA%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AA%E0%A7%9C%E0%A7%87%E0%A6%93-%E0%A6%9C%E0%A7%9F-%E0%A6%A4%E0%A7%81%E0%A6%B2%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B2%E0%A7%8B-%E0%A6%AA%E0%A6%BF%E0%A6%8F%E0%A6%B8%E0%A6%9C%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/football/982440/%E0%A6%AA%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AA%E0%A7%9C%E0%A7%87%E0%A6%93-%E0%A6%9C%E0%A7%9F-%E0%A6%A4%E0%A7%81%E0%A6%B2%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B2%E0%A7%8B-%E0%A6%AA%E0%A6%BF%E0%A6%8F%E0%A6%B8%E0%A6%9C%E0%A6%BF</guid>
      <pubDate>Sun, 22 Nov 2026 02:07:33 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/93dbdd851618b16fad8b43ddd485d77a-6b01f9f043838.jpg?jadewits_media_id=1056275" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/93dbdd851618b16fad8b43ddd485d77a-6b01f9f043838.jpg?jadewits_media_id=1056275" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/93dbdd851618b16fad8b43ddd485d77a-6b01f9f043838.jpg?jadewits_media_id=1056275" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পিছিয়ে পড়েও জয় তুলে নিলো পিএসজি" /&gt;&lt;/p&gt;&lt;p&gt;নিসের বিপক্ষে শুরুতেই পিছিয়ে পড়ার পরও ঘুরে দাঁড়িয়ে ৩-২ গোলে জিতে লিগ ওয়ানে নিজেদের শীর্ষস্থান ধরে রেখেছে চ্যাম্পিয়ন প্যারিস সেন্ট জার্মেইন (পিএসজি)। তবে এই জয়টি তাদের জন্য বড় ধরনের শঙ্কা নিয়ে এসেছে।
পিএসজিকে ২-১ ব্যবধানে এগিয়ে দেওয়ার কিছুক্ষণ পরই হাঁটুতে চোট পান ফরাসি আন্তর্জাতিক ফুটবলার দেজিরে দুয়ে&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/football/982440/%E0%A6%AA%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AA%E0%A7%9C%E0%A7%87%E0%A6%93-%E0%A6%9C%E0%A7%9F-%E0%A6%A4%E0%A7%81%E0%A6%B2%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B2%E0%A7%8B-%E0%A6%AA%E0%A6%BF%E0%A6%8F%E0%A6%B8%E0%A6%9C%E0%A6%BF">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>বসে ছিল ওতপেতে, বাড়ি ফেরার সময় বিএনপি নেতাকে একে একে ৩ গুলি</title>
      <link>https://www.banglatribune.com/country/khulna/982439/%E0%A6%AC%E0%A6%B8%E0%A7%87-%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%93%E0%A6%A4%E0%A6%AA%E0%A7%87%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/khulna/982439/%E0%A6%AC%E0%A6%B8%E0%A7%87-%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%93%E0%A6%A4%E0%A6%AA%E0%A7%87%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A7%87</guid>
      <pubDate>Sun, 22 Nov 2026 01:37:08 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/10/21/48255b69421a1173aa1fbb96945f841d-6ad7b3dc85bf5.jpg?jadewits_media_id=1050511" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/10/21/48255b69421a1173aa1fbb96945f841d-6ad7b3dc85bf5.jpg?jadewits_media_id=1050511" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/10/21/48255b69421a1173aa1fbb96945f841d-6ad7b3dc85bf5.jpg?jadewits_media_id=1050511" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বসে ছিল ওতপেতে, বাড়ি ফেরার সময় বিএনপি নেতাকে একে একে ৩ গুলি" /&gt;&lt;/p&gt;&lt;p&gt;খুলনার তেরখাদা উপজেলায় মধুপুর ইউনিয়ন বিএনপির সম্মেলন প্রস্তুতি কমিটির সদস্য মাফিজুর রহমান (৪৭) দুর্বৃত্তদের গুলিতে আহত হয়েছেন। শনিবার (২১ নভেম্বর) দিনগত রাত ১০টার দিকে এ ঘটনা ঘটে।
খুলনা জেলা পুলিশের অতিরিক্ত পুলিশ সুপার আবির সিদ্দিক শুভ্র এ তথ্য নিশ্চিত করেছেন। তিনি জানান, মাফিজুর রহমান মোকামপুর বাজ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/khulna/982439/%E0%A6%AC%E0%A6%B8%E0%A7%87-%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%93%E0%A6%A4%E0%A6%AA%E0%A7%87%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A7%87">বাংলা ট্রিবিউন</source>

    <item>
      <title>দেশের সব স্কুলে ভর্তি পরীক্ষা বাতিল চাওয়া রিট খারিজ</title>
      <link>https://www.banglatribune.com/law-and-crime/981023/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AC-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2%E0%A7%87-%E0%A6%AD%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%B2-%E0%A6%9A%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%B0%E0%A6%BF%E0%A6%9F</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/981023/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AC-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2%E0%A7%87-%E0%A6%AD%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%B2-%E0%A6%9A%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%B0%E0%A6%BF%E0%A6%9F</guid>
      <pubDate>Sun, 15 Nov 2026 14:22:12 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2016/01/21/4f98317d9845c1f0058ab64f43cc41f1-.jpg?jadewits_media_id=57265" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2016/01/21/4f98317d9845c1f0058ab64f43cc41f1-.jpg?jadewits_media_id=57265" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2016/01/21/4f98317d9845c1f0058ab64f43cc41f1-.jpg?jadewits_media_id=57265" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দেশের সব স্কুলে ভর্তি পরীক্ষা বাতিল চাওয়া রিট খারিজ" /&gt;&lt;/p&gt;&lt;p&gt;২০২৭ সালে দেশের সব স্কুলে ভর্তি পরীক্ষা বাতিল চেয়ে করা রিট আবেদনটি খারিজ করে দিয়েছেন হাইকোর্ট। রবিবার (১৫ নভেম্বর) বিচারপতি শিকদার মাহমুদুর রাজী ও বিচারপতি ফাতেমা আনোয়ারের সমন্বয়ে গঠিত হাইকোর্ট বেঞ্চ এ আদেশ দেন।
আদালতে রিটের পক্ষে ছিলেন আইনজীবী জাহিদ তালুকদার। রাষ্ট্রপক্ষে ছিলেন ডেপুটি অ্যাটর্নি জে&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/981023/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AC-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2%E0%A7%87-%E0%A6%AD%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%B2-%E0%A6%9A%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%B0%E0%A6%BF%E0%A6%9F">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>রাষ্ট্রদ্রোহ মামলায় গ্রেফতার এসপি, ফোনে মিললো আওয়ামী লীগ পুনর্বাসনের যে দুই বার্তা</title>
      <link>https://www.banglatribune.com/country/chitagong/981022/%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B9-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%8F%E0%A6%B8%E0%A6%AA%E0%A6%BF-%E0%A6%AB%E0%A7%8B%E0%A6%A8%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2%E0%A7%8B</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/chitagong/981022/%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B9-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%8F%E0%A6%B8%E0%A6%AA%E0%A6%BF-%E0%A6%AB%E0%A7%8B%E0%A6%A8%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2%E0%A7%8B</guid>
      <pubDate>Sun, 15 Nov 2026 14:14:20 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/89fb8a1cdedc671a9d0ecf215a9210b3-6af969d0e8556.jpg?jadewits_media_id=1055076" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/89fb8a1cdedc671a9d0ecf215a9210b3-6af969d0e8556.jpg?jadewits_media_id=1055076" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/89fb8a1cdedc671a9d0ecf215a9210b3-6af969d0e8556.jpg?jadewits_media_id=1055076" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাষ্ট্রদ্রোহ মামলায় গ্রেফতার এসপি, ফোনে মিললো আওয়ামী লীগ পুনর্বাসনের যে দুই বার্তা" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রাম রেঞ্জ রিজার্ভ ফোর্সের (আরআরএফ) এসপি জাহাঙ্গীর আলমের বিরুদ্ধে রাষ্ট্রদ্রোহ এবং রাষ্ট্রের বিরুদ্ধে ষড়যন্ত্রে উসকানির অভিযোগ পাওয়া গেছে বলে জানিয়েছেন চট্টগ্রাম রেঞ্জের উপমহাপরিদর্শক (ডিআইজি) আব্দুল কুদ্দুস চৌধুরী।
তিনি বলেন, জাহাঙ্গীর আলমের বিরুদ্ধে সুনির্দিষ্ট দুটি অভিযোগ পাওয়া গেছে। এর মধ্য&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/chitagong/981022/%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B9-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%8F%E0%A6%B8%E0%A6%AA%E0%A6%BF-%E0%A6%AB%E0%A7%8B%E0%A6%A8%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2%E0%A7%8B">বাংলা ট্রিবিউন</source>

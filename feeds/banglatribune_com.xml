      <guid isPermaLink="true">https://www.banglatribune.com/sport/hockey/983545/%E0%A6%93%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%95%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%B2-%E0%A6%B0%E0%A6%95%E0%A6%BF-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A6%AC</guid>
      <pubDate>Fri, 27 Nov 2026 13:09:50 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/963bfd0fc104b6a75523202b76a2961d-6b092c810a214.jpg?jadewits_media_id=1057205" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/963bfd0fc104b6a75523202b76a2961d-6b092c810a214.jpg?jadewits_media_id=1057205" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/963bfd0fc104b6a75523202b76a2961d-6b092c810a214.jpg?jadewits_media_id=1057205" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ওমানের হকিতে বাংলাদেশের আমিরুল-রকি-বিপ্লব" /&gt;&lt;/p&gt;&lt;p&gt;ওমানের ঘরোয়া হকির বড় আসর ৫৬তম হিজ ম্যাজেস্টি&amp;rsquo;স হকি কাপ (ওমান কাপ) খেলতে যাচ্ছেন বাংলাদেশের তিন হকি খেলোয়াড়। ডিফেন্ডার আমিরুল ইসলাম, স্ট্রাইকার রকিবুল ইসলাম রকি ও গোলকিপার বিপ্লব কুজুর খেলবেন আল-ইত্তিহাদ স্পোর্টস ক্লাবের হয়ে।
আগামী ৮ থেকে ২৩ ডিসেম্বর মাসকাটে অনুষ্ঠিত হবে ৫৬তম আসরটি। এবারের প্রত&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/hockey/983545/%E0%A6%93%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%95%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%B2-%E0%A6%B0%E0%A6%95%E0%A6%BF-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A6%AC">বাংলা ট্রিবিউন</source>

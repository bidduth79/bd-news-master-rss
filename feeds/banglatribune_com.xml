      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/24dd61c38f8861231f809991e0ab45ab-6b06c9e2dae31.jpg?jadewits_media_id=1056901" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/24dd61c38f8861231f809991e0ab45ab-6b06c9e2dae31.jpg?jadewits_media_id=1056901" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/24dd61c38f8861231f809991e0ab45ab-6b06c9e2dae31.jpg?jadewits_media_id=1056901" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ট্রিলিয়ন ডলারের অর্থনীতি গড়তে মানসম্মত শিক্ষা-গবেষণায় গুরুত্ব দিচ্ছে সরকার" /&gt;&lt;/p&gt;&lt;p&gt;দেশের অর্থনীতির বর্তমান আকার প্রায় ৫০০ বিলিয়ন ডলার। আগামী পাঁচ বছরে অর্থনীতির আকার এক ট্রিলিয়ন ডলারে উন্নীত করার পাশাপাশি এক কোটি উচ্চমূল্যের কর্মসংস্থান সৃষ্টির লক্ষ্য রয়েছে সরকারের। এ লক্ষ্য অর্জনে বিশ্ববিদ্যালয়গুলোকে মানসম্মত শিক্ষা, গবেষণা ও দক্ষ জনশক্তি তৈরিতে আরও কার্যকর ভূমিকা রাখার আহ্বান জা&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/educations/983196/%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%A8-%E0%A6%A1%E0%A6%B2%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A6%BF-%E0%A6%97%E0%A7%9C%E0%A6%A4%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%A4">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ফোনে মহিলালীগ নেত্রীকে বাংলোয় ডাকলেন ওসি, বললেন ‘এলে সব ঠিক হয়ে যাবে’</title>
      <link>https://www.banglatribune.com/country/chitagong/983195/%E0%A6%AB%E0%A7%8B%E0%A6%A8%E0%A7%87-%E0%A6%AE%E0%A6%B9%E0%A6%BF%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A7%8B%E0%A7%9F-%E0%A6%A1%E0%A6%BE%E0%A6%95%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%93%E0%A6%B8%E0%A6%BF-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A7%87%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/chitagong/983195/%E0%A6%AB%E0%A7%8B%E0%A6%A8%E0%A7%87-%E0%A6%AE%E0%A6%B9%E0%A6%BF%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A7%8B%E0%A7%9F-%E0%A6%A1%E0%A6%BE%E0%A6%95%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%93%E0%A6%B8%E0%A6%BF-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Wed, 25 Nov 2026 17:44:43 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/08b21535db1ac66d7e3004db0d3a6b7b-6b06ca1210a5f.jpg?jadewits_media_id=1056902" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/08b21535db1ac66d7e3004db0d3a6b7b-6b06ca1210a5f.jpg?jadewits_media_id=1056902" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/08b21535db1ac66d7e3004db0d3a6b7b-6b06ca1210a5f.jpg?jadewits_media_id=1056902" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফোনে মহিলালীগ নেত্রীকে বাংলোয় ডাকলেন ওসি, বললেন ‘এলে সব ঠিক হয়ে যাবে’" /&gt;&lt;/p&gt;&lt;p&gt;ফেনীর দাগনভূঞা থানার ওসি ফয়জুল আজিম নোমানের সঙ্গে যুব মহিলা লীগের এক নেত্রীর ফোনালাপ ফাঁস হয়েছে। ফোনালাপে ওই নারীকে বারবার নিজের বাংলোয় আসার অনুরোধ করতে শোনা যায় ওসিকে।
ফোনালাপের কথা স্বীকার করে ওসি দাবি করেছেন, সনি একটি মামলায় গ্রেফতারের পর জামিনে মুক্তি পেয়ে তিনি পালিয়ে গেছেন। তাকে আবার পুল&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/chitagong/983195/%E0%A6%AB%E0%A7%8B%E0%A6%A8%E0%A7%87-%E0%A6%AE%E0%A6%B9%E0%A6%BF%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A7%80%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A7%8B%E0%A7%9F-%E0%A6%A1%E0%A6%BE%E0%A6%95%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%93%E0%A6%B8%E0%A6%BF-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A7%87%E0%A6%A8">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>রাজধানী‌তে ২৪ ঘণ্টায় গ্রেফতার ৪৯৭</title>
      <link>https://www.banglatribune.com/law-and-crime/983194/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E2%80%8C%E0%A6%A4%E0%A7%87-%E0%A7%A8%E0%A7%AA-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A7%AA%E0%A7%AF%E0%A7%AD</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/983194/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E2%80%8C%E0%A6%A4%E0%A7%87-%E0%A7%A8%E0%A7%AA-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A7%AA%E0%A7%AF%E0%A7%AD</guid>
      <pubDate>Wed, 25 Nov 2026 17:41:53 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/07/16/2d2a4561261d6f45003889006a8fbbce-6a58a2aa240f1.jpg?jadewits_media_id=1033813" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/07/16/2d2a4561261d6f45003889006a8fbbce-6a58a2aa240f1.jpg?jadewits_media_id=1033813" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/07/16/2d2a4561261d6f45003889006a8fbbce-6a58a2aa240f1.jpg?jadewits_media_id=1033813" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজধানী‌তে ২৪ ঘণ্টায় গ্রেফতার ৪৯৭" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীতে ঢাকা মেট্রোপলিটন পুলিশের (ডিএমপি) অভিযানে গত ২৪ ঘণ্টায় ৪৯৭ জন গ্রেফতার হয়েছে। একই সময়ে ৪৪টি মামলা দায়ের করা হয়েছে।
মঙ্গলবার (২৪ নভেম্বর) রাজধানীর বিভিন্ন থানা এলাকায় অভিযান চা&amp;zwnj;লি&amp;zwnj;য়ে তাদের গ্রেফতার করা হয়।
বুধবার ডিএম&amp;zwnj;পির সংবাদ বিজ্ঞ&amp;zwnj;প্তি&amp;zwnj;তে বলা হয়, গ্রেফতারকৃতদের ম&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/983194/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E2%80%8C%E0%A6%A4%E0%A7%87-%E0%A7%A8%E0%A7%AA-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A7%AA%E0%A7%AF%E0%A7%AD">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ইউক্রেন যুদ্ধে প্রায় ৫ লাখ রুশ সেনার মৃত্যু</title>
      <link>https://www.banglatribune.com/foreign/europe/983193/%E0%A6%87%E0%A6%89%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A8-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A7%AB-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%B0%E0%A7%81%E0%A6%B6-%E0%A6%B8%E0%A7%87%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/europe/983193/%E0%A6%87%E0%A6%89%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A8-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A7%AB-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%B0%E0%A7%81%E0%A6%B6-%E0%A6%B8%E0%A7%87%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81</guid>
      <pubDate>Wed, 25 Nov 2026 17:37:26 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/04/21/fa127ff966b210e79395708134e37817-69e75dcfd6e55.jpg?jadewits_media_id=1020295" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/04/21/fa127ff966b210e79395708134e37817-69e75dcfd6e55.jpg?jadewits_media_id=1020295" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/04/21/fa127ff966b210e79395708134e37817-69e75dcfd6e55.jpg?jadewits_media_id=1020295" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইউক্রেন যুদ্ধে প্রায় ৫ লাখ রুশ সেনার মৃত্যু" /&gt;&lt;/p&gt;&lt;p&gt;২০২২ সাল থেকে ইউক্রেন যুদ্ধে অন্তত ৪ লাখ ৯০ হাজার ৩৩৪ রুশ সেনা নিহত হয়েছেন। রাশিয়ার সরকারি পরিসংখ্যান বিশ্লেষণ করে ব্রিটিশ সংবাদমাধ্যম বিবিসি এ তথ্য পেয়েছে। রুশ প্রেসিডেন্ট ভ্লাদিমির পুতিন ধারণা করেছিলেন যুদ্ধ কয়েক দিনেই শেষ হবে, কিন্তু তা এখন প্রায় পাঁচ বছরে গড়াচ্ছে।

তীব্র শীতে কাঁপছে কাশ্মী&lt;/p&gt;</description>

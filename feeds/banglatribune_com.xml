    <item>
      <title>ঢাকায় গড়ে পৌনে ২ লাখ মানুষের জন্য একটি করে গণশৌচাগার</title>
      <link>https://www.banglatribune.com/others/capital-city/981831/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A7%9C%E0%A7%87-%E0%A6%AA%E0%A7%8C%E0%A6%A8%E0%A7%87-%E0%A7%A8-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%8F%E0%A6%95%E0%A6%9F%E0%A6%BF-%E0%A6%95%E0%A6%B0%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/others/capital-city/981831/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A7%9C%E0%A7%87-%E0%A6%AA%E0%A7%8C%E0%A6%A8%E0%A7%87-%E0%A7%A8-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%8F%E0%A6%95%E0%A6%9F%E0%A6%BF-%E0%A6%95%E0%A6%B0%E0%A7%87</guid>
      <pubDate>Thu, 19 Nov 2026 09:00:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/3533c466f9de80b52e1c0f39f30ea688-6afdc6f644883.jpg?jadewits_media_id=1055755" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/3533c466f9de80b52e1c0f39f30ea688-6afdc6f644883.jpg?jadewits_media_id=1055755" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/3533c466f9de80b52e1c0f39f30ea688-6afdc6f644883.jpg?jadewits_media_id=1055755" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঢাকায় গড়ে পৌনে ২ লাখ মানুষের জন্য একটি করে গণশৌচাগার" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানী ঢাকায় প্রতি ১ লাখ ৭২ হাজার ৬৪১ মানুষের জন্য রয়েছে মাত্র একটি গণশৌচাগার। বিপুল জনসংখ্যার বিপরীতে গণশৌচাগারের এই স্বল্পতার পাশাপাশি বিদ্যমান অনেকগুলোও বন্ধ, অপরিচ্ছন্ন কিংবা ব্যবহার অনুপযোগী। ফলে প্রয়োজনের সময় শৌচাগার না পেয়ে অনেকে সড়ক ও ফুটপাতে মূত্রত্যাগ করছেন। সবচেয়ে বেশি ভোগান্তিতে পড়ছেন দ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/others/capital-city/981831/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A7%9C%E0%A7%87-%E0%A6%AA%E0%A7%8C%E0%A6%A8%E0%A7%87-%E0%A7%A8-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%8F%E0%A6%95%E0%A6%9F%E0%A6%BF-%E0%A6%95%E0%A6%B0%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>একটি শব্দের অপেক্ষায় রোহিঙ্গারা, ফিরতে চান নাগরিক অধিকার নিয়ে</title>

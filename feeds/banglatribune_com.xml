    <item>
      <title>দ্বিতীয় মেয়াদে আইসিসি চেয়ারম্যান নির্বাচিত জয় শাহ</title>
      <link>https://www.banglatribune.com/sport/cricket/981238/%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%80%E0%A6%AF%E0%A6%BC-%E0%A6%AE%E0%A7%87%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%A6%E0%A7%87-%E0%A6%86%E0%A6%87%E0%A6%B8%E0%A6%BF%E0%A6%B8%E0%A6%BF-%E0%A6%9A%E0%A7%87%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%B0%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%9A%E0%A6%BF%E0%A6%A4-%E0%A6%9C%E0%A6%AF%E0%A6%BC</link>
      <guid isPermaLink="true">https://www.banglatribune.com/sport/cricket/981238/%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%80%E0%A6%AF%E0%A6%BC-%E0%A6%AE%E0%A7%87%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%A6%E0%A7%87-%E0%A6%86%E0%A6%87%E0%A6%B8%E0%A6%BF%E0%A6%B8%E0%A6%BF-%E0%A6%9A%E0%A7%87%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%B0%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%9A%E0%A6%BF%E0%A6%A4-%E0%A6%9C%E0%A6%AF%E0%A6%BC</guid>
      <pubDate>Mon, 16 Nov 2026 14:23:32 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/731a3e81f55b8dd22682a159339dd2d5-6afabd78ef71a.JPG?jadewits_media_id=1055252" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/731a3e81f55b8dd22682a159339dd2d5-6afabd78ef71a.JPG?jadewits_media_id=1055252" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/731a3e81f55b8dd22682a159339dd2d5-6afabd78ef71a.JPG?jadewits_media_id=1055252" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দ্বিতীয় মেয়াদে আইসিসি চেয়ারম্যান নির্বাচিত জয় শাহ" /&gt;&lt;/p&gt;&lt;p&gt;আন্তর্জাতিক ক্রিকেট কাউন্সিলের (আইসিসি) চেয়ারম্যান হিসেবে দ্বিতীয় দুই বছরের মেয়াদে বিনা প্রতিদ্বন্দ্বিতায় পুনর্নির্বাচিত হয়েছেন জয় শাহ। বালিতে অনুষ্ঠিত আইসিসির বোর্ড সভায় পরিচালকদের প্রস্তাবের পর তিনি পুনরায় এই দায়িত্ব পেয়েছেন।
৩৮ বছর বয়সী জয় শাহই ছিলেন চেয়ারম্যান পদের একমাত্র প্রার্থী। &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/sport/cricket/981238/%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%80%E0%A6%AF%E0%A6%BC-%E0%A6%AE%E0%A7%87%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%A6%E0%A7%87-%E0%A6%86%E0%A6%87%E0%A6%B8%E0%A6%BF%E0%A6%B8%E0%A6%BF-%E0%A6%9A%E0%A7%87%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%B0%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%9A%E0%A6%BF%E0%A6%A4-%E0%A6%9C%E0%A6%AF%E0%A6%BC">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>সিসিইউ থেকে কেবিনে স্থানান্তর করা হলো স্বাস্থ্যমন্ত্রীকে</title>
      <link>https://www.banglatribune.com/health/981237/%E0%A6%B8%E0%A6%BF%E0%A6%B8%E0%A6%BF%E0%A6%87%E0%A6%89-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A7%87%E0%A6%AC%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%BE-%E0%A6%B9%E0%A6%B2%E0%A7%8B</link>
      <guid isPermaLink="true">https://www.banglatribune.com/health/981237/%E0%A6%B8%E0%A6%BF%E0%A6%B8%E0%A6%BF%E0%A6%87%E0%A6%89-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A7%87%E0%A6%AC%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%BE-%E0%A6%B9%E0%A6%B2%E0%A7%8B</guid>
      <pubDate>Mon, 16 Nov 2026 14:15:45 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/5d8d5210f71702f5596a906382a4cd20-6afabba95c9d8.jpg?jadewits_media_id=1055251" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/5d8d5210f71702f5596a906382a4cd20-6afabba95c9d8.jpg?jadewits_media_id=1055251" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/5d8d5210f71702f5596a906382a4cd20-6afabba95c9d8.jpg?jadewits_media_id=1055251" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সিসিইউ থেকে কেবিনে স্থানান্তর করা হলো স্বাস্থ্যমন্ত্রীকে" /&gt;&lt;/p&gt;&lt;p&gt;স্বাস্থ্য ও পরিবার কল্যাণ মন্ত্রী সরদার মো. সাখাওয়াত হোসেনকে সিসিইউ থেকে কেবিনে স্থানান্তর করা হয়েছে। তিনি শারীরিকভাবে এখন সুস্থ আছেন। সোমবার (১৬ নভেম্বর) স্বাস্থ্য মন্ত্রণালয় থেকে এ তথ্য জানানো হয়েছে।&amp;nbsp;
এর আগে গতকাল রবিবার (১৫ নভেম্বর) বিকাল ৪টা ৩০ মিনিটে রাজধানীর একটি হাসপাতালে স্বাস্থ্যমন্&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/health/981237/%E0%A6%B8%E0%A6%BF%E0%A6%B8%E0%A6%BF%E0%A6%87%E0%A6%89-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A7%87%E0%A6%AC%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%BE-%E0%A6%B9%E0%A6%B2%E0%A7%8B">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>যৌথ বাহিনীর টহল জোরদার, গোপালগঞ্জে আইনশৃঙ্খলা পরিস্থিতি স্বাভাবিক</title>
      <link>https://www.banglatribune.com/country/dhaka/981236/%E0%A6%AF%E0%A7%8C%E0%A6%A5-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%9F%E0%A6%B9%E0%A6%B2-%E0%A6%9C%E0%A7%8B%E0%A6%B0%E0%A6%A6%E0%A6%BE%E0%A6%B0-%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%95</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/dhaka/981236/%E0%A6%AF%E0%A7%8C%E0%A6%A5-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%9F%E0%A6%B9%E0%A6%B2-%E0%A6%9C%E0%A7%8B%E0%A6%B0%E0%A6%A6%E0%A6%BE%E0%A6%B0-%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%95</guid>
      <pubDate>Mon, 16 Nov 2026 14:33:09 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/4d84e2231694c6cd95dcd03a0395891b-6afabb2fb500c.jpg?jadewits_media_id=1055250" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/4d84e2231694c6cd95dcd03a0395891b-6afabb2fb500c.jpg?jadewits_media_id=1055250" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/4d84e2231694c6cd95dcd03a0395891b-6afabb2fb500c.jpg?jadewits_media_id=1055250" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যৌথ বাহিনীর টহল জোরদার, গোপালগঞ্জে আইনশৃঙ্খলা পরিস্থিতি স্বাভাবিক" /&gt;&lt;/p&gt;&lt;p&gt;সহিংসতা ও অস্থিরতার পর গোপালগঞ্জে আইনশৃঙ্খলা পরিস্থিতি স্বাভাবিক হয়েছে। বিজিবি মোতায়েন এবং যৌথ বাহিনীর টহল জোরদারের পর সোমবার (১৬ নভেম্বর) সকাল থেকে জেলার সরকারি-বেসরকারি অফিস, আদালত ও দোকানপাট খুলেছে। ঢাকা-খুলনা মহাসড়কসহ জেলা শহরের অভ্যন্তরীণ সড়কগুলোতে যান চলাচলও স্বাভাবিক রয়েছে।
তবে নতুন করে কোনও &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/dhaka/981236/%E0%A6%AF%E0%A7%8C%E0%A6%A5-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%9F%E0%A6%B9%E0%A6%B2-%E0%A6%9C%E0%A7%8B%E0%A6%B0%E0%A6%A6%E0%A6%BE%E0%A6%B0-%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%95">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>প্রেমের টানে চীন থেকে রাজবাড়ী, করলেন মুসলিম রীতিতে বিয়ে</title>
      <link>https://www.banglatribune.com/country/dhaka/981235/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%9F%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%9A%E0%A7%80%E0%A6%A8-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A7%80-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AE%E0%A7%81%E0%A6%B8%E0%A6%B2%E0%A6%BF%E0%A6%AE-%E0%A6%B0%E0%A7%80%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/dhaka/981235/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%9F%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%9A%E0%A7%80%E0%A6%A8-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A7%80-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AE%E0%A7%81%E0%A6%B8%E0%A6%B2%E0%A6%BF%E0%A6%AE-%E0%A6%B0%E0%A7%80%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87</guid>
      <pubDate>Mon, 16 Nov 2026 14:07:34 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/8b0ed99bd2ae36b35ccbec8c70fd1e77-6afab9aeb29e4.jpg?jadewits_media_id=1055249" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/8b0ed99bd2ae36b35ccbec8c70fd1e77-6afab9aeb29e4.jpg?jadewits_media_id=1055249" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/8b0ed99bd2ae36b35ccbec8c70fd1e77-6afab9aeb29e4.jpg?jadewits_media_id=1055249" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রেমের টানে চীন থেকে রাজবাড়ী, করলেন মুসলিম রীতিতে বিয়ে" /&gt;&lt;/p&gt;&lt;p&gt;ভাইয়ের কর্মস্থলে পরিচয়, সেখান থেকে বন্ধুত্ব। সেই বন্ধুত্বই একসময় গড়ায় প্রেমে। আর ভালোবাসার টানে হাজারও কিলোমিটার পাড়ি দিয়ে চীন থেকে বাংলাদেশে ছুটে আসেন জ্যাকি চেউং। অবশেষে রাজবাড়ীর গোয়ালন্দ উপজেলার তরুণী নার্গিস আক্তারকে (২৮) বিয়ে করেছেন এই চীনা নাগরিক। দুই দেশের দুই নাগরিকের এই বিয়ে ঘিরে গোয়ালন্দের&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/dhaka/981235/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%9F%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%9A%E0%A7%80%E0%A6%A8-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A7%80-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AE%E0%A7%81%E0%A6%B8%E0%A6%B2%E0%A6%BF%E0%A6%AE-%E0%A6%B0%E0%A7%80%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87">বাংলা ট্রিবিউন</source>

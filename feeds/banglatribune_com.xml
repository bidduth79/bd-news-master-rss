      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/53e233e9bdd561d15d76585c2f3d8c67-6b0b0300ba433.jpg?jadewits_media_id=1057562" length="0" type="image/jpeg" />

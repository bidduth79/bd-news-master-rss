    <item>
      <title>ডিসেম্বর ঘিরে রাজনৈতিক দলগুলোর কী পরিকল্পনা?</title>
      <link>https://www.banglatribune.com/politics/981160/%C2%A0%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%98%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A8%E0%A7%88%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%A6%E0%A6%B2%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A7%8B%E0%A6%B0-%E0%A6%95%E0%A7%80-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A6%A8%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/politics/981160/%C2%A0%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%98%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A8%E0%A7%88%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%A6%E0%A6%B2%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A7%8B%E0%A6%B0-%E0%A6%95%E0%A7%80-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A6%A8%E0%A6%BE</guid>
      <pubDate>Mon, 16 Nov 2026 00:01:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/06/22/1cdb968808587e149d0fd74475db3185-6a3966420d37b.jpg?jadewits_media_id=1030186" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/06/22/1cdb968808587e149d0fd74475db3185-6a3966420d37b.jpg?jadewits_media_id=1030186" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/06/22/1cdb968808587e149d0fd74475db3185-6a3966420d37b.jpg?jadewits_media_id=1030186" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডিসেম্বর ঘিরে রাজনৈতিক দলগুলোর কী পরিকল্পনা?" /&gt;&lt;/p&gt;&lt;p&gt;ডিসেম্বরে সাবেক প্রধানমন্ত্রী শেখ হাসিনার দেশে ফেরার ঘোষণাকে কেন্দ্র করে রাজনীতিতে নতুন উত্তাপ শুরু হয়েছে। এ পরিস্থিতি মোকাবিলায় দেশের প্রধান রাজনৈতিক দলগুলো কোন প্রক্রিয়ায় এগোতে চায়, এমন প্রশ্ন সামনে এসেছে। বিশেষ করে প্রশাসনের বাইরে&amp;nbsp; সরকার ও বিরোধীদলের পক্ষ থেকে রাজনৈতিক কোনও পরিকল্পনা নেওয়া হ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/politics/981160/%C2%A0%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%98%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A8%E0%A7%88%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%A6%E0%A6%B2%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A7%8B%E0%A6%B0-%E0%A6%95%E0%A7%80-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A6%A8%E0%A6%BE">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ইরানের কাছে এখনও ২৫০০ ক্ষেপণাস্ত্র বলে মনে করে যুক্তরাষ্ট্র, ইসরায়েলের ধারণা কত?</title>
      <link>https://www.banglatribune.com/foreign/middle-east/981163/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%9B%E0%A7%87-%E0%A6%8F%E0%A6%96%E0%A6%A8%E0%A6%93-%E0%A7%A8%E0%A7%AB%E0%A7%A6%E0%A7%A6-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA%E0%A6%A3%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/middle-east/981163/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%9B%E0%A7%87-%E0%A6%8F%E0%A6%96%E0%A6%A8%E0%A6%93-%E0%A7%A8%E0%A7%AB%E0%A7%A6%E0%A7%A6-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA%E0%A6%A3%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0</guid>
      <pubDate>Mon, 16 Nov 2026 00:00:36 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/f9b59400bd757e67c42f7c67cc2e72ed-6af9f299e6ca3.jpg?jadewits_media_id=1055192" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/f9b59400bd757e67c42f7c67cc2e72ed-6af9f299e6ca3.jpg?jadewits_media_id=1055192" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/f9b59400bd757e67c42f7c67cc2e72ed-6af9f299e6ca3.jpg?jadewits_media_id=1055192" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইরানের কাছে এখনও ২৫০০ ক্ষেপণাস্ত্র বলে মনে করে যুক্তরাষ্ট্র, ইসরায়েলের ধারণা কত?" /&gt;&lt;/p&gt;&lt;p&gt;ইরানের কাছে এখনও ১ হাজার ৫০০ থেকে ২ হাজার ৫০০টি ব্যালিস্টিক ক্ষেপণাস্ত্র মজুত রয়েছে বলে মনে করছে মার্কিন গোয়েন্দা সংস্থা। শনিবার মার্কিন সংবাদমাধ্যম দ্য ওয়াল স্ট্রিট জার্নাল-এর এক প্রতিবেদনে কর্মকর্তাদের বরাতে এ তথ্য জানানো হয়েছে। উপসাগরীয় অঞ্চলে একটি মার্কিন ঘাঁটি লক্ষ্য করে ইরানের ড্রোন হামলার কয়ে&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/middle-east/981163/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%9B%E0%A7%87-%E0%A6%8F%E0%A6%96%E0%A6%A8%E0%A6%93-%E0%A7%A8%E0%A7%AB%E0%A7%A6%E0%A7%A6-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA%E0%A6%A3%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ব্যাংক থেকে টাকা তুলে বাড়ি ফেরার পথে নারীকে মাইক্রোবাসে তুলে ১৬ লাখ টাকা লুট</title>
      <link>https://www.banglatribune.com/country/dhaka/981162/%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%A4%E0%A7%81%E0%A6%B2%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/dhaka/981162/%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%A4%E0%A7%81%E0%A6%B2%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%87</guid>
      <pubDate>Sun, 15 Nov 2026 23:47:43 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/ef4a053ee3aff15ea7d18b3b65d3049a-6af9f03305fe8.jpg?jadewits_media_id=1055191" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/ef4a053ee3aff15ea7d18b3b65d3049a-6af9f03305fe8.jpg?jadewits_media_id=1055191" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/ef4a053ee3aff15ea7d18b3b65d3049a-6af9f03305fe8.jpg?jadewits_media_id=1055191" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ব্যাংক থেকে টাকা তুলে বাড়ি ফেরার পথে নারীকে মাইক্রোবাসে তুলে ১৬ লাখ টাকা লুট" /&gt;&lt;/p&gt;&lt;p&gt;মাদারীপুরের শিবচরে ব্যাংক থেকে ১৬ লাখ টাকা তুলে বাড়ি ফেরার পথে এক নারীকে মাইক্রোবাসে তুলে নেওয়ার অভিযোগ উঠেছে। পরে মারধর করে হাত-পা বেঁধে নির্জন স্থানে ফেলে তার কাছ থেকে ১৬ লাখ টাকা ছিনিয়ে নেওয়া হয়েছে বলে অভিযোগ করেছেন ভুক্তভোগী হাসিনা বেগম (৫২)।
রবিবার (১৫ নভেম্বর) দুপুর ১২টার দিকে উপজেলার উমেদপুর &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/dhaka/981162/%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%A4%E0%A7%81%E0%A6%B2%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>বাজারে এলো লিলির নতুন সিরাম গ্লো সোপ, উদ্বোধনে সাবিলা নূর</title>
      <link>https://www.banglatribune.com/press-release/981161/%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%8F%E0%A6%B2%E0%A7%8B-%E0%A6%B2%E0%A6%BF%E0%A6%B2%E0%A6%BF%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%B8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%AE-%E0%A6%97%E0%A7%8D%E0%A6%B2%E0%A7%8B-%E0%A6%B8%E0%A7%8B%E0%A6%AA-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%8B%E0%A6%A7%E0%A6%A8%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/press-release/981161/%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%8F%E0%A6%B2%E0%A7%8B-%E0%A6%B2%E0%A6%BF%E0%A6%B2%E0%A6%BF%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%B8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%AE-%E0%A6%97%E0%A7%8D%E0%A6%B2%E0%A7%8B-%E0%A6%B8%E0%A7%8B%E0%A6%AA-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%8B%E0%A6%A7%E0%A6%A8%E0%A7%87</guid>
      <pubDate>Sun, 15 Nov 2026 23:32:13 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/9ced026c2ba2934ddab5b2d20e15efec-6af9ec8116d31.jpg?jadewits_media_id=1055190" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/9ced026c2ba2934ddab5b2d20e15efec-6af9ec8116d31.jpg?jadewits_media_id=1055190" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/9ced026c2ba2934ddab5b2d20e15efec-6af9ec8116d31.jpg?jadewits_media_id=1055190" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাজারে এলো লিলির নতুন সিরাম গ্লো সোপ, উদ্বোধনে সাবিলা নূর" /&gt;&lt;/p&gt;&lt;p&gt;সিরাম, ভিটামিন সি, ভিটামিন ই ও শিয়াবাটারের সমন্বয়ে নতুন ফর্মুলেশনের সাবান &amp;lsquo;লিলি সিরাম গ্লো সোপ&amp;rsquo; বাজারে এনেছে রিমার্ক এইচবি লিমিটেড। ফ্রেঞ্চ রোজ, হোয়াইট জেসমিন ও লেমন স্প্ল্যাশ&amp;mdash;এই তিনটি ভ্যারিয়েন্টে পাওয়া যাবে পণ্যটি।
রবিবার (১৫ নভেম্বর) রাজধানীর গুলশানের হোটেল লেকশোরে আয়োজিত অনুষ্ঠ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/press-release/981161/%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%8F%E0%A6%B2%E0%A7%8B-%E0%A6%B2%E0%A6%BF%E0%A6%B2%E0%A6%BF%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%B8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%AE-%E0%A6%97%E0%A7%8D%E0%A6%B2%E0%A7%8B-%E0%A6%B8%E0%A7%8B%E0%A6%AA-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%8B%E0%A6%A7%E0%A6%A8%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>

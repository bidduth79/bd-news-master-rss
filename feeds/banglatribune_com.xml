    <item>
      <title>প্রত্যেক এমপির জন্য ৫ কোটি টাকা: কেন এই বিশেষ বরাদ্দের প্রস্তাব</title>
      <link>https://www.banglatribune.com/national/980938/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%95-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A7%AB-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%95%E0%A7%87%E0%A6%A8-%E0%A6%8F%E0%A6%87-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B7</link>
      <guid isPermaLink="true">https://www.banglatribune.com/national/980938/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%95-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A7%AB-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%95%E0%A7%87%E0%A6%A8-%E0%A6%8F%E0%A6%87-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B7</guid>
      <pubDate>Sat, 14 Nov 2026 22:00:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/07/12/e46301da63e1872b76ae3237dda7642b-6a536a33a6105.jpg?jadewits_media_id=1033160" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/07/12/e46301da63e1872b76ae3237dda7642b-6a536a33a6105.jpg?jadewits_media_id=1033160" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/07/12/e46301da63e1872b76ae3237dda7642b-6a536a33a6105.jpg?jadewits_media_id=1033160" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রত্যেক এমপির জন্য ৫ কোটি টাকা: কেন এই বিশেষ বরাদ্দের প্রস্তাব" /&gt;&lt;/p&gt;&lt;p&gt;প্রত্যেক সংসদ সদস্যের (এমপি) জন্য ৫ কোটি টাকা করে বিশেষ উন্নয়ন বরাদ্দ চেয়েছে স্থানীয় সরকার বিভাগ। ৩০০ সংসদ সদস্যের জন্য মোট ১ হাজার ৫০০ কোটি টাকার এই প্রস্তাবে বলা হয়েছে, নির্বাচনী এলাকার মানুষের জরুরি চাহিদা পূরণে অর্থ ব্যয় করা হবে। তবে প্রস্তাবিত অর্থের উৎস উপজেলা পরিষদ ও সিটি করপোরেশনের উন্নয়ন তহ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/980938/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%95-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A7%AB-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%95%E0%A7%87%E0%A6%A8-%E0%A6%8F%E0%A6%87-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B7">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>প্রতিষ্ঠাতা বিদায় নিলে কী হয় প্রযুক্তি প্রতিষ্ঠানের?</title>
      <link>https://www.banglatribune.com/foreign/usa/980939/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A4%E0%A6%BE-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%BF%E0%A6%B2%E0%A7%87-%E0%A6%95%E0%A7%80-%E0%A6%B9%E0%A7%9F-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/usa/980939/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A4%E0%A6%BE-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%BF%E0%A6%B2%E0%A7%87-%E0%A6%95%E0%A7%80-%E0%A6%B9%E0%A7%9F-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF</guid>
      <pubDate>Sat, 14 Nov 2026 21:56:34 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/b8e260c092e3514edb1edd65bf5c587b-6af883e276d34.jpg?jadewits_media_id=1055002" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/b8e260c092e3514edb1edd65bf5c587b-6af883e276d34.jpg?jadewits_media_id=1055002" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/b8e260c092e3514edb1edd65bf5c587b-6af883e276d34.jpg?jadewits_media_id=1055002" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রতিষ্ঠাতা বিদায় নিলে কী হয় প্রযুক্তি প্রতিষ্ঠানের?" /&gt;&lt;/p&gt;&lt;p&gt;প্রযুক্তি প্রতিষ্ঠানের প্রতিষ্ঠাতা ও দীর্ঘদিনের প্রধান নির্বাহী কর্মকর্তা (সিইও) বিদায় নিলে কোম্পানির ভবিষ্যৎ কী হয়? এনভিডিয়ার প্রধান নির্বাহী জেনসেন হুয়াংয়ের পদত্যাগের পর নতুন করে সামনে এসেছে এ প্রশ্ন। ১৯৯৩ সালে সহপ্রতিষ্ঠাতা হিসেবে এনভিডিয়া গড়ে তোলার পর থেকে প্রতিষ্ঠানটির নেতৃত্বে ছিলেন হুয়াং। তার&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/usa/980939/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A4%E0%A6%BE-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%BF%E0%A6%B2%E0%A7%87-%E0%A6%95%E0%A7%80-%E0%A6%B9%E0%A7%9F-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ডায়াবেটিস নিয়ন্ত্রণে চালু হচ্ছে ‘ডায়াবেটিস মেলা’ অ্যাপ</title>

      <guid isPermaLink="true">https://www.banglatribune.com/national/982245/%E0%A6%B8%E0%A6%B6%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80-%E0%A6%A6%E0%A6%BF%E0%A6%AC%E0%A6%B8-%E0%A6%86%E0%A6%9C-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%9B%E0%A7%87-%E0%A6%AF%E0%A7%87%E0%A6%B8%E0%A6%AC-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%B8%E0%A7%82%E0%A6%9A%E0%A6%BF</guid>
      <pubDate>Sat, 21 Nov 2026 00:02:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2023/11/16/387419823_209695788828484_6913788011954758983_n-bff00af2e438f0e806e84d5b226c805b.png?jadewits_media_id=888478" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2023/11/16/387419823_209695788828484_6913788011954758983_n-bff00af2e438f0e806e84d5b226c805b.png?jadewits_media_id=888478" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2023/11/16/387419823_209695788828484_6913788011954758983_n-bff00af2e438f0e806e84d5b226c805b.png?jadewits_media_id=888478" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সশস্ত্র বাহিনী দিবস আজ, থাকছে যেসব কর্মসূচি" /&gt;&lt;/p&gt;&lt;p&gt;আজ শনিবার (২১ নভেম্বর) সশস্ত্র বাহিনী দিবস। দেশের সব সেনানিবাস, নৌ-ঘাঁটি এবং বিমানবাহিনী ঘাঁটির মসজিদগুলোতে দেশের কল্যাণ ও সমৃদ্ধি, সশস্ত্র বাহিনীর উত্তরোত্তর উন্নতি ও অগ্রগতি এবং স্বাধীনতা যুদ্ধে আত্মোৎসর্গকারী সশস্ত্র বাহিনীর শহীদদের রুহের মাগফিরতে কামনায় ফজরের নামাজের পর বিশেষ মোনাজাতের মাধ্যমে দ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/982245/%E0%A6%B8%E0%A6%B6%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80-%E0%A6%A6%E0%A6%BF%E0%A6%AC%E0%A6%B8-%E0%A6%86%E0%A6%9C-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%9B%E0%A7%87-%E0%A6%AF%E0%A7%87%E0%A6%B8%E0%A6%AC-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%B8%E0%A7%82%E0%A6%9A%E0%A6%BF">বাংলা ট্রিবিউন</source>

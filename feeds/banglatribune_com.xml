    <item>
      <title>অনির্দিষ্টকালের জন্য বন্ধ হয়ে গেলো আরও দুটি পোশাক কারখানা, যা বলছেন মালিকরা</title>
      <link>https://www.banglatribune.com/country/dhaka/982610/%E0%A6%85%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%95%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7-%E0%A6%B9%E0%A7%9F%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%B2%E0%A7%8B-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A6%A6%E0%A7%81%E0%A6%9F%E0%A6%BF-%E0%A6%AA%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%95</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/dhaka/982610/%E0%A6%85%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%95%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7-%E0%A6%B9%E0%A7%9F%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%B2%E0%A7%8B-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A6%A6%E0%A7%81%E0%A6%9F%E0%A6%BF-%E0%A6%AA%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%95</guid>
      <pubDate>Sun, 22 Nov 2026 23:02:37 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/623ac3eedf4de804576196912d9e07c8-6b03201a53e10.jpg?jadewits_media_id=1056410" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/623ac3eedf4de804576196912d9e07c8-6b03201a53e10.jpg?jadewits_media_id=1056410" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/623ac3eedf4de804576196912d9e07c8-6b03201a53e10.jpg?jadewits_media_id=1056410" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অনির্দিষ্টকালের জন্য বন্ধ হয়ে গেলো আরও দুটি পোশাক কারখানা, যা বলছেন মালিকরা" /&gt;&lt;/p&gt;&lt;p&gt;ন্যূনতম মজুরি ৩০ হাজার টাকা নির্ধারণসহ বিভিন্ন দাবিতে শ্রমিকদের চলমান আন্দোলনের জেরে গাজীপুরের দুটি পোশাক কারখানা অনির্দিষ্টকালের জন্য বন্ধ ঘোষণা করেছে মালিকপক্ষ। এ সংক্রান্ত নোটিশ স্ব স্ব কারখানার গেটে টানিয়ে দেওয়া হয়। রবিবার (২২ নভেম্বর) এবং শনিবার (২১ নভেম্বর) কারখানা দুটি বন্ধ ঘোষণা করা হয়েছে।
ব&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/dhaka/982610/%E0%A6%85%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%95%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7-%E0%A6%B9%E0%A7%9F%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%B2%E0%A7%8B-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A6%A6%E0%A7%81%E0%A6%9F%E0%A6%BF-%E0%A6%AA%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%95">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>জাতীয় ঐক্যে যেসব শর্ত দিলেন নাহিদ ইসলাম</title>
      <link>https://www.banglatribune.com/politics/ncp/982609/%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A6%AF%E0%A6%BC-%E0%A6%90%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%AF%E0%A7%87%E0%A6%B8%E0%A6%AC-%E0%A6%B6%E0%A6%B0%E0%A7%8D%E0%A6%A4-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%A8%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A6-%E0%A6%87%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE</link>
      <guid isPermaLink="true">https://www.banglatribune.com/politics/ncp/982609/%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A6%AF%E0%A6%BC-%E0%A6%90%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%AF%E0%A7%87%E0%A6%B8%E0%A6%AC-%E0%A6%B6%E0%A6%B0%E0%A7%8D%E0%A6%A4-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%A8%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A6-%E0%A6%87%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE</guid>
      <pubDate>Sun, 22 Nov 2026 22:47:20 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/39356445f95a786dc1cbf45aff79a0a3-6b031c48961e6.jpg?jadewits_media_id=1056409" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/39356445f95a786dc1cbf45aff79a0a3-6b031c48961e6.jpg?jadewits_media_id=1056409" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/39356445f95a786dc1cbf45aff79a0a3-6b031c48961e6.jpg?jadewits_media_id=1056409" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জাতীয় ঐক্যে যেসব শর্ত দিলেন নাহিদ ইসলাম" /&gt;&lt;/p&gt;&lt;p&gt;জাতীয় ঐক্যের প্রথম পদক্ষেপ হিসেবে একদলীয় সংবিধান সংশোধন কমিটি বাতিলের দাবি জানিয়েছেন জাতীয় নাগরিক পার্টির (এনসিপি) আহ্বায়ক ও বিরোধীদলীয় চিফ হুইপ নাহিদ ইসলাম। রবিবার (২২ নভেম্বর) এক সপ্তাহের সফর শেষে দেশে ফিরে শাহজালাল আন্তর্জাতিক বিমানবন্দরে ব্রিফিংয়ে এ দাবি জানান তিনি।&amp;nbsp;
নাহিদ বলেন, আমাদের দা&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/politics/ncp/982609/%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A6%AF%E0%A6%BC-%E0%A6%90%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%AF%E0%A7%87%E0%A6%B8%E0%A6%AC-%E0%A6%B6%E0%A6%B0%E0%A7%8D%E0%A6%A4-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%A8%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A6-%E0%A6%87%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>তীব্র শীতের আগে সীমান্তে উত্তাপ কমাতে বৈঠকে ভারত-চীন</title>
      <link>https://www.banglatribune.com/foreign/asia/982608/%E0%A6%A4%E0%A7%80%E0%A6%AC%E0%A7%8D%E0%A6%B0-%E0%A6%B6%E0%A7%80%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%87-%E0%A6%B8%E0%A7%80%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%87-%E0%A6%89%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%AA-%E0%A6%95%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/asia/982608/%E0%A6%A4%E0%A7%80%E0%A6%AC%E0%A7%8D%E0%A6%B0-%E0%A6%B6%E0%A7%80%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%87-%E0%A6%B8%E0%A7%80%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%87-%E0%A6%89%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%AA-%E0%A6%95%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95%E0%A7%87</guid>
      <pubDate>Sun, 22 Nov 2026 22:44:36 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/0fdf84cf5c9a4edc49d292aa7638833d-6b031b95c4e1e.jpg?jadewits_media_id=1056408" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/0fdf84cf5c9a4edc49d292aa7638833d-6b031b95c4e1e.jpg?jadewits_media_id=1056408" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/0fdf84cf5c9a4edc49d292aa7638833d-6b031b95c4e1e.jpg?jadewits_media_id=1056408" style="max-width:100%;height:auto;margin-bottom:10px;" alt="তীব্র শীতের আগে সীমান্তে উত্তাপ কমাতে বৈঠকে ভারত-চীন" /&gt;&lt;/p&gt;&lt;p&gt;ভারত ও চীনের মধ্যে বিতর্কিত অরুণাচল প্রদেশ সীমান্তে নতুন দফায় উচ্চপর্যায়ের সামরিক আলোচনা হয়েছে। প্রতিবেদন অনুযায়ী, কঠোর শীত শুরুর আগে মাঠপর্যায়ে সেনাদের মধ্যে সংঘাত ঠেকাতে এবং প্রকৃত নিয়ন্ত্রণরেখায় (এলএসি) উত্তেজনা কমাতেই এ আলোচনা।

ফোন ধরেননি, চিঠিও খোলেননি: ট্রাম্পকে পাত্তা দিচ্ছেন না কিম

&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/asia/982608/%E0%A6%A4%E0%A7%80%E0%A6%AC%E0%A7%8D%E0%A6%B0-%E0%A6%B6%E0%A7%80%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%87-%E0%A6%B8%E0%A7%80%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%87-%E0%A6%89%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%AA-%E0%A6%95%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95%E0%A7%87">বাংলা ট্রিবিউন</source>

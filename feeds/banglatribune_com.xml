    <item>
      <title>ফ্লাইট ও মাইক্রোসফটের পর এবার যুক্তরাষ্ট্রের ব্যাংকিং সেবায় বিপর্যয়</title>
      <link>https://www.banglatribune.com/foreign/usa/981426/%E0%A6%AB%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%9F-%E0%A6%93-%E0%A6%AE%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B8%E0%A6%AB%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/usa/981426/%E0%A6%AB%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%9F-%E0%A6%93-%E0%A6%AE%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B8%E0%A6%AB%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Tue, 17 Nov 2026 09:21:52 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/faaed598fa6d346d32cacd3025577cf7-6afbc796cff66.jpg?jadewits_media_id=1055405" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/faaed598fa6d346d32cacd3025577cf7-6afbc796cff66.jpg?jadewits_media_id=1055405" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/faaed598fa6d346d32cacd3025577cf7-6afbc796cff66.jpg?jadewits_media_id=1055405" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফ্লাইট ও মাইক্রোসফটের পর এবার যুক্তরাষ্ট্রের ব্যাংকিং সেবায় বিপর্যয়" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাষ্ট্রের জেপি মরগান চেজ, ব্যাংক অব আমেরিকা এবং ইউএস ব্যাংকসহ বেশ কয়েকটি বড় আর্থিক প্রতিষ্ঠানে সোমবার সেবা বিঘ্নিত হওয়ার অভিযোগ করেছেন গ্রাহকরা। সেবা পর্যবেক্ষণকারী ওয়েবসাইট ডাউনডিটেক্টর ডটকমের তথ্যমতে, অ্যাকাউন্টে প্রবেশ সংক্রান্ত অভিযোগ বেড়ে যাওয়া অন্য ব্যাংকগুলোর মধ্যে রয়েছে ক্যাপিটাল ওয়ান, &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/foreign/usa/981426/%E0%A6%AB%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%9F-%E0%A6%93-%E0%A6%AE%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B8%E0%A6%AB%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>অবরুদ্ধের ১২ ঘণ্টা পর মুক্ত ভিসি, অচলাবস্থা কাটাতে তিন দিন বন্ধ জাতীয় বিশ্ববিদ্যালয়</title>
      <link>https://www.banglatribune.com/country/dhaka/981425/%E0%A6%85%E0%A6%AC%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A7%A7%E0%A7%A8-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%AA%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%AD%E0%A6%BF%E0%A6%B8%E0%A6%BF-%E0%A6%85%E0%A6%9A%E0%A6%B2%E0%A6%BE%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE-%E0%A6%95%E0%A6%BE%E0%A6%9F%E0%A6%BE%E0%A6%A4%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/dhaka/981425/%E0%A6%85%E0%A6%AC%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A7%A7%E0%A7%A8-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%AA%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%AD%E0%A6%BF%E0%A6%B8%E0%A6%BF-%E0%A6%85%E0%A6%9A%E0%A6%B2%E0%A6%BE%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE-%E0%A6%95%E0%A6%BE%E0%A6%9F%E0%A6%BE%E0%A6%A4%E0%A7%87</guid>
      <pubDate>Tue, 17 Nov 2026 09:14:27 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/5c85e8f8ace6b797a1802e67296a32a2-6afbc67d71065.jpg?jadewits_media_id=1055404" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/5c85e8f8ace6b797a1802e67296a32a2-6afbc67d71065.jpg?jadewits_media_id=1055404" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/5c85e8f8ace6b797a1802e67296a32a2-6afbc67d71065.jpg?jadewits_media_id=1055404" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অবরুদ্ধের ১২ ঘণ্টা পর মুক্ত ভিসি, অচলাবস্থা কাটাতে তিন দিন বন্ধ জাতীয় বিশ্ববিদ্যালয়" /&gt;&lt;/p&gt;&lt;p&gt;দীর্ঘ ১২ ঘণ্টা অবরুদ্ধ থাকার পর মুক্ত হয়েছেন জাতীয় বিশ্ববিদ্যালয়ের উপাচার্য (ভিসি) অধ্যাপক ড. এ এস এম আমানুল্লাহ। চাকরিতে পুনর্বহাল হওয়া ৯৮৮ কর্মকর্তা-কর্মচারীর বিভিন্ন দাবিতে দিনভর ঘেরাও ও অবস্থান কর্মসূচির মুখে নিজ কার্যালয়ে অবরুদ্ধ ছিলেন তিনি। সোমবার (১৬ নভেম্বর) রাত সাড়ে ১১টার দিকে কার্যালয় থেকে&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/dhaka/981425/%E0%A6%85%E0%A6%AC%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A7%A7%E0%A7%A8-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%AA%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%AD%E0%A6%BF%E0%A6%B8%E0%A6%BF-%E0%A6%85%E0%A6%9A%E0%A6%B2%E0%A6%BE%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE-%E0%A6%95%E0%A6%BE%E0%A6%9F%E0%A6%BE%E0%A6%A4%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>কার্যক্রম নিষিদ্ধ আ.লীগের সঙ্গে সম্পৃক্ততার অভিযোগে জবির পাঁচ কর্মকর্তা বরখাস্ত</title>
      <link>https://www.banglatribune.com/my-campus/981424/%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A7%83%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%A4%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/my-campus/981424/%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A7%83%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%A4%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Tue, 17 Nov 2026 09:07:37 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/ab87926b5c4c50b943983a78cc3f58c5-6afbc38de3919.jpg?jadewits_media_id=1055403" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/ab87926b5c4c50b943983a78cc3f58c5-6afbc38de3919.jpg?jadewits_media_id=1055403" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/ab87926b5c4c50b943983a78cc3f58c5-6afbc38de3919.jpg?jadewits_media_id=1055403" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কার্যক্রম নিষিদ্ধ আ.লীগের সঙ্গে সম্পৃক্ততার অভিযোগে জবির পাঁচ কর্মকর্তা বরখাস্ত" /&gt;&lt;/p&gt;&lt;p&gt;কার্যক্রম নিষিদ্ধ রাজনৈতিক সংগঠন বাংলাদেশ আওয়ামী লীগের সঙ্গে সম্পৃক্ততার অভিযোগে জগন্নাথ বিশ্ববিদ্যালয়ের (জবি) পাঁচ কর্মকর্তাকে সাময়িক বরখাস্ত করেছে বিশ্ববিদ্যালয় প্রশাসন।
সোমবার (১৬ নভেম্বর) রাত ১০টার দিকে উপাচার্যের সম্মেলন কক্ষে আয়োজিত জরুরি সংবাদ সম্মেলনে এ সিদ্ধান্তের কথা জানান উপাচার্য অধ্যাপক&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/my-campus/981424/%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A7%83%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%A4%E0%A6%BE%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>

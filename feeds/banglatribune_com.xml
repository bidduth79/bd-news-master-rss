    <item>
      <title>চেম্বারে ঢুকে চিকিৎসককে পিটিয়ে নিষিদ্ধ ছাত্রলীগ নেতার বাড়িতে আশ্রয়, যুবদল নেতা গ্রেফতার</title>
      <link>https://www.banglatribune.com/country/barishal/980143/%E0%A6%9A%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%A2%E0%A7%81%E0%A6%95%E0%A7%87-%E0%A6%9A%E0%A6%BF%E0%A6%95%E0%A6%BF%E0%A7%8E%E0%A6%B8%E0%A6%95%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%BF%E0%A6%9F%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%80%E0%A6%97</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/barishal/980143/%E0%A6%9A%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%A2%E0%A7%81%E0%A6%95%E0%A7%87-%E0%A6%9A%E0%A6%BF%E0%A6%95%E0%A6%BF%E0%A7%8E%E0%A6%B8%E0%A6%95%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%BF%E0%A6%9F%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%80%E0%A6%97</guid>
      <pubDate>Tue, 10 Nov 2026 23:37:51 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/1ff8846b71c1107842551a2ad6f80bbc-6af356088bf9f.jpg?jadewits_media_id=1054321" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/1ff8846b71c1107842551a2ad6f80bbc-6af356088bf9f.jpg?jadewits_media_id=1054321" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/1ff8846b71c1107842551a2ad6f80bbc-6af356088bf9f.jpg?jadewits_media_id=1054321" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চেম্বারে ঢুকে চিকিৎসককে পিটিয়ে নিষিদ্ধ ছাত্রলীগ নেতার বাড়িতে আশ্রয়, যুবদল নেতা গ্রেফতার" /&gt;&lt;/p&gt;&lt;p&gt;বরিশালের বাকেরগঞ্জ উপজেলা স্বাস্থ্য কমপ্লেক্সে চিকিৎসককে মারধরের ঘটনায় করা মামলার প্রধান আসামি পৌর যুবদলের জ্যেষ্ঠ যুগ্ম আহ্বায়ক ইমরান খানকে গ্রেফতার করেছে পুলিশ। মঙ্গলবার (১০ নভেম্বর) বিকালে উপজেলার ভরপাশা ইউনিয়নে নিষিদ্ধ উপজেলা ছাত্রলীগের সহসভাপতি সোহেল রানার বাড়ি থেকে তাকে গ্রেফতার করা হয়।
পুলিশ &lt;/p&gt;</description>

      <pubDate>Sat, 21 Nov 2026 14:27:44 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2024/04/28/2-89a603afb89b7a02fe00041c5ffbf9aa.jpg?jadewits_media_id=914112" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2024/04/28/2-89a603afb89b7a02fe00041c5ffbf9aa.jpg?jadewits_media_id=914112" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2024/04/28/2-89a603afb89b7a02fe00041c5ffbf9aa.jpg?jadewits_media_id=914112" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজধানীতে ডিএমপির অভিযানে গ্রেফতার ২৯৯" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীতে ঢাকা মেট্রোপলিটন পুলিশের (ডিএমপি) অভিযানে ২৯৯ জনকে গ্রেফতার করা হয়েছে। শুক্রবার (২০ নভেম্বর) রাজধানীর বিভিন্ন থানা এলাকায় অভিযান চালিয়ে তাদের গ্রেফতার করা হয়। একই সময়ে ৩২টি মামলা দায়ের করা হয়েছে।
ডিএমপি জানায়, রমনা বিভাগ ২৩ জন, লালবাগ বিভাগ ১৯ জন, ওয়ারী বিভাগ ৩৭ জন, মতিঝিল বিভাগ ২৬ জন, তেজ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/982329/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%A1%E0%A6%BF%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AB%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A7%A8%E0%A7%AF%E0%A7%AF%C2%A0">বাংলা ট্রিবিউন</source>

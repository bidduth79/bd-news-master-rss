      <guid isPermaLink="true">https://www.banglatribune.com/business/money-and-investment/979655/%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A7%8B%E0%A6%A5%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A7%87%E0%A6%AE%E0%A6%A8</guid>
      <pubDate>Sun, 08 Nov 2026 20:00:00 +0600</pubDate>
      <description>দেশের তৈরি পোশাক (আরএমজি) রফতানিতে ইতিবাচক প্রবৃদ্ধি ধরে রেখেছে বাংলাদেশ। চলতি ২০২৬-২৭ অর্থবছরের প্রথম চার মাসে (জুলাই-অক্টোবর) তৈরি পোশাক রফতানি থেকে আয় হয়েছে ১ হাজার ৩৭৪ কোটি ৬৩ লাখ ডলার। গত অর্থবছরের একই সময়ে এই আয় ছিল ১ হাজার ২৯৯ কোটি ৪ লাখ ডলার। সেই হিসাবে এক বছরের ব্যবধানে পোশাক রফতানি আয় বেড়ে</description>
      <source url="https://www.banglatribune.com/business/money-and-investment/979655/%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A7%8B%E0%A6%A5%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A7%87%E0%A6%AE%E0%A6%A8">বাংলা ট্রিবিউন</source>

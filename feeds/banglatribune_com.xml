      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/292d67246646d39dcf6532170ca64538-6afd987babca8.jpg?jadewits_media_id=1055694" length="0" type="image/jpeg" />

    <item>
      <title>আন্তালিয়ায় এরদোয়ানের সঙ্গে বৈঠকে প্রধানমন্ত্রী তারেক রহমান</title>
      <link>https://www.banglatribune.com/national/980132/%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%8F%E0%A6%B0%E0%A6%A6%E0%A7%8B%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80</link>
      <guid isPermaLink="true">https://www.banglatribune.com/national/980132/%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%8F%E0%A6%B0%E0%A6%A6%E0%A7%8B%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80</guid>
      <pubDate>Tue, 10 Nov 2026 22:45:49 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/a52ab6f0283bcbbbaf5d86a5c73fdbd6-6af348ff1c1fc.jpg?jadewits_media_id=1054313" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/a52ab6f0283bcbbbaf5d86a5c73fdbd6-6af348ff1c1fc.jpg?jadewits_media_id=1054313" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/a52ab6f0283bcbbbaf5d86a5c73fdbd6-6af348ff1c1fc.jpg?jadewits_media_id=1054313" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আন্তালিয়ায় এরদোয়ানের সঙ্গে বৈঠকে প্রধানমন্ত্রী তারেক রহমান" /&gt;&lt;/p&gt;&lt;p&gt;আন্তোলিয়ায় তুরস্কের প্রেসিডেন্ট রিসেপ তাইয়েপ এরদোয়ানের সঙ্গে বাংলাদেশের প্রধানমন্ত্রী তারেক রহমানের দ্বিপক্ষীয় বৈঠক শুরু হয়েছে।
মঙ্গলবার (১০ নভেম্বর) তুরস্কের স্থানীয় সময় সন্ধ্যা সোয়া ৭টায় আন্তালিয়ার ম্যাক্স রয়েল হোটেলে এ বৈঠক শুরু হয়। বৈঠকে পররাষ্ট্রমন্ত্রী খলিলুর রহমান, প্রতিমন্ত্রী-১ হুমায়ুন কব&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/980132/%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%8F%E0%A6%B0%E0%A6%A6%E0%A7%8B%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>মোহাম্মদপুরে দিনেদুপুরে সবার সামনে যুবককে কুপিয়ে সব লুট</title>
      <link>https://www.banglatribune.com/law-and-crime/980131/%E0%A6%AE%E0%A7%8B%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%A6%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%A6%E0%A7%81%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%95%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A7%81%E0%A6%AA%E0%A6%BF%E0%A7%9F%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/980131/%E0%A6%AE%E0%A7%8B%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%A6%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%A6%E0%A7%81%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%95%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A7%81%E0%A6%AA%E0%A6%BF%E0%A7%9F%E0%A7%87</guid>
      <pubDate>Tue, 10 Nov 2026 22:39:29 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/fafbf604227209a262c712def5751d6b-6af3484005a74.jpg?jadewits_media_id=1054312" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/fafbf604227209a262c712def5751d6b-6af3484005a74.jpg?jadewits_media_id=1054312" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/fafbf604227209a262c712def5751d6b-6af3484005a74.jpg?jadewits_media_id=1054312" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মোহাম্মদপুরে দিনেদুপুরে সবার সামনে যুবককে কুপিয়ে সব লুট" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর মোহাম্মদপুরে দিনদুপুরে চাপাতিসহ ধারালো অস্ত্র নিয়ে এক যুবককে কুপিয়ে আইফোন ও টাকাসহ ওয়ালেট ছিনিয়ে নিয়েছে দুর্বৃত্তরা। মঙ্গলবার (১০ নভেম্বর) বেলা দেড়টার দিকে মোহাম্মদপুর বাসস্ট্যান্ড এলাকায় আল্লাহ করিম মসজিদের পাশে এ ঘটনা ঘটে।
আহত যুবকের নাম তানভীর (২৯)। তিনি ৪৩তম বিসিএসে নন-ক্যাডার পদে উত্তী&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/980131/%E0%A6%AE%E0%A7%8B%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%A6%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%A6%E0%A7%81%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%95%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A7%81%E0%A6%AA%E0%A6%BF%E0%A7%9F%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>আ.লীগের সাবেক সেই এমপি বললেন ‘আমি এখনও দেশেই আছি, দেখি পুলিশ খুঁজে বের করুক’</title>
      <link>https://www.banglatribune.com/country/sylhet/980130/%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%B8%E0%A7%87%E0%A6%87-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A7%87%E0%A6%A8-%E2%80%98%E0%A6%86%E0%A6%AE%E0%A6%BF-%E0%A6%8F%E0%A6%96%E0%A6%A8%E0%A6%93-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%87-%E0%A6%86%E0%A6%9B%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/sylhet/980130/%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%B8%E0%A7%87%E0%A6%87-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A7%87%E0%A6%A8-%E2%80%98%E0%A6%86%E0%A6%AE%E0%A6%BF-%E0%A6%8F%E0%A6%96%E0%A6%A8%E0%A6%93-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%87-%E0%A6%86%E0%A6%9B%E0%A6%BF</guid>
      <pubDate>Tue, 10 Nov 2026 22:20:46 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/17fc9d985097e9d97858322c8965990a-6af3442ea72e9.jpg?jadewits_media_id=1054311" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/17fc9d985097e9d97858322c8965990a-6af3442ea72e9.jpg?jadewits_media_id=1054311" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/17fc9d985097e9d97858322c8965990a-6af3442ea72e9.jpg?jadewits_media_id=1054311" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আ.লীগের সাবেক সেই এমপি বললেন ‘আমি এখনও দেশেই আছি, দেখি পুলিশ খুঁজে বের করুক’" /&gt;&lt;/p&gt;&lt;p&gt;কার্যক্রম নিষিদ্ধ আওয়ামী লীগের সিলেট জেলার সাংগঠনিক সম্পাদক ও সুনামগঞ্জ-১ আসনের সাবেক সংসদ সদস্য অ্যাডভোকেট রনজিত সরকারের একটি ভিডিও ঘিরে আলোচনা-সমালোচনা শুরু হয়েছে। ভিডিওটি কোথায় ধারণ করা হয়েছে&amp;mdash;ভারতে নাকি বাংলাদেশের ভেতরে&amp;mdash;তা নিয়ে তৈরি হয়েছে রহস্য।
তবে রনজিত সরকার দাবি করেছেন, ভারতের মেঘ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/sylhet/980130/%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%B8%E0%A7%87%E0%A6%87-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF-%E0%A6%AC%E0%A6%B2%E0%A6%B2%E0%A7%87%E0%A6%A8-%E2%80%98%E0%A6%86%E0%A6%AE%E0%A6%BF-%E0%A6%8F%E0%A6%96%E0%A6%A8%E0%A6%93-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%87-%E0%A6%86%E0%A6%9B%E0%A6%BF">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>হাসিবের ওপর হামলার প্রতিবাদে রাজধানীতে স্বেচ্ছাসেবক শক্তির মশাল মিছিল</title>
      <link>https://www.banglatribune.com/politics/ncp/980129/%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/politics/ncp/980129/%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87</guid>
      <pubDate>Tue, 10 Nov 2026 22:19:57 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/f7fc193e603c0777ee47ca9ab5dfebdd-6af343dfc38ae.jpg?jadewits_media_id=1054310" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/f7fc193e603c0777ee47ca9ab5dfebdd-6af343dfc38ae.jpg?jadewits_media_id=1054310" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/f7fc193e603c0777ee47ca9ab5dfebdd-6af343dfc38ae.jpg?jadewits_media_id=1054310" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হাসিবের ওপর হামলার প্রতিবাদে রাজধানীতে স্বেচ্ছাসেবক শক্তির মশাল মিছিল" /&gt;&lt;/p&gt;&lt;p&gt;জাতীয় ছাত্রশক্তির ঢাকা বিশ্ববিদ্যালয় শাখার সভাপতি হাসিব আল ইসলামের ওপর হামলা এবং ফরিদপুরে বাসে আগুনে চালকের মৃত্যুর প্রতিবাদে রাজধানীতে মশাল ও বিক্ষোভ মিছিল করেছে জাতীয় স্বেচ্ছাসেবক শক্তি।
মঙ্গলবার (১০ নভেম্বর) রাত ৮টায় রাজধানীর বাংলামোটরে জাতীয় নাগরিক পার্টির (এনসিপি) কেন্দ্রীয় কার্যালয়ের সামনে থেক&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/politics/ncp/980129/%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>সৌরবিদ্যুতের সরঞ্জাম কিনতে ৫ কোটি টাকা পর্যন্ত ই-জিপি বাধ্যতামূলক নয়</title>

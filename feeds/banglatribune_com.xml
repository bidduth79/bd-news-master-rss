      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/982851/%E0%A6%A4%E0%A6%BE%E0%A6%9C%E0%A6%B0%E0%A7%80%E0%A6%A8-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9C%E0%A7%87%E0%A6%A1%E0%A6%BF%E0%A6%B0-%E0%A7%A7%E0%A7%AA-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%9A%E0%A7%82%E0%A7%9C%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%B6%E0%A7%81%E0%A6%A8%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%B9%E0%A7%9F%E0%A6%A8%E0%A6%BF</guid>
      <pubDate>Tue, 24 Nov 2026 10:00:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2018/11/24/f4645ceea70d5cc6ffdaf35f0d40142c-5bf8a3831c347.jpg?jadewits_media_id=413931" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2018/11/24/f4645ceea70d5cc6ffdaf35f0d40142c-5bf8a3831c347.jpg?jadewits_media_id=413931" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2018/11/24/f4645ceea70d5cc6ffdaf35f0d40142c-5bf8a3831c347.jpg?jadewits_media_id=413931" style="max-width:100%;height:auto;margin-bottom:10px;" alt="তাজরীন ট্র্যাজেডির ১৪ বছর: চূড়ান্ত শুনানি হয়নি ক্ষতিপূরণসংক্রান্ত ২ রিট মামলা" /&gt;&lt;/p&gt;&lt;p&gt;তাজরীন ফ্যাশনসে অগ্নিকাণ্ডে নিহত শ্রমিকদের পরিবার ও আহত শ্রমিকদের ক্ষতিপূরণ নিশ্চিত করতে হাইকোর্টে দায়ের করা দুটি রিট মামলার চূড়ান্ত শুনানি প্রায় ১৩ বছরেও শেষ হয়নি। রিট দুটিতে আদালত রুল জারি করলেও সেগুলোর চূড়ান্ত নিষ্পত্তি হয়নি। ফলে অগ্নিকাণ্ডে ক্ষতিগ্রস্ত শ্রমিক ও নিহতদের স্বজনদের জন্য পর্যাপ্ত ক্ষ&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/982851/%E0%A6%A4%E0%A6%BE%E0%A6%9C%E0%A6%B0%E0%A7%80%E0%A6%A8-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9C%E0%A7%87%E0%A6%A1%E0%A6%BF%E0%A6%B0-%E0%A7%A7%E0%A7%AA-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%9A%E0%A7%82%E0%A7%9C%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%B6%E0%A7%81%E0%A6%A8%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%B9%E0%A7%9F%E0%A6%A8%E0%A6%BF">বাংলা ট্রিবিউন</source>

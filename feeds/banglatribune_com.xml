      <guid isPermaLink="true">https://www.banglatribune.com/national/982257/%E0%A6%AC%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%9A%E0%A6%B2%E0%A6%BE%E0%A6%9A%E0%A6%B2-%E0%A6%96%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A7%9F%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%87%E0%A6%95%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%B9%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A6%BF%E0%A6%A4%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%8B</guid>
      <pubDate>Sat, 21 Nov 2026 00:09:04 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/e64bd348be4503524594618097b724ea-6b008c2921f77.jpg?jadewits_media_id=1056114" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/e64bd348be4503524594618097b724ea-6b008c2921f77.jpg?jadewits_media_id=1056114" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/e64bd348be4503524594618097b724ea-6b008c2921f77.jpg?jadewits_media_id=1056114" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিমান চলাচল খাতের উন্নয়নে আইকাওয়ের সহযোগিতা চাইলো বাংলাদেশ" /&gt;&lt;/p&gt;&lt;p&gt;বেসামরিক বিমান চলাচল খাতের উন্নয়ন, বিনিয়োগ ও প্রাতিষ্ঠানিক সক্ষমতা বৃদ্ধিতে সহযোগিতা জোরদারের বিষয়ে আন্তর্জাতিক বেসামরিক বিমান চলাচল সংস্থার (আইকাও) সঙ্গে আলোচনা করেছে বাংলাদেশ।
কানাডার মন্ট্রিলে আইকাওয়ের ৪৩তম বিশেষ অধিবেশনের সাইডলাইনে সংস্থাটির মহাসচিব হুয়ান কার্লোস সালাজার গোমেজের সঙ্গে দ্বিপাক্ষি&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/national/982257/%E0%A6%AC%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%9A%E0%A6%B2%E0%A6%BE%E0%A6%9A%E0%A6%B2-%E0%A6%96%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A7%9F%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%87%E0%A6%95%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%B9%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A6%BF%E0%A6%A4%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%8B">বাংলা ট্রিবিউন</source>

      <title>প্রেমে টানে আসা চীনা তরুণের সঙ্গে মেয়ের বিয়ে দেননি কৃষক বাবা, দিলেন যেসব শর্ত</title>
      <link>https://www.banglatribune.com/country/chitagong/983888/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AE%E0%A7%87-%E0%A6%9F%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%B8%E0%A6%BE-%E0%A6%9A%E0%A7%80%E0%A6%A8%E0%A6%BE-%E0%A6%A4%E0%A6%B0%E0%A7%81%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%AE%E0%A7%87%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%A8%E0%A6%A8%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/chitagong/983888/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AE%E0%A7%87-%E0%A6%9F%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%B8%E0%A6%BE-%E0%A6%9A%E0%A7%80%E0%A6%A8%E0%A6%BE-%E0%A6%A4%E0%A6%B0%E0%A7%81%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%AE%E0%A7%87%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%A8%E0%A6%A8%E0%A6%BF</guid>
      <pubDate>Sat, 28 Nov 2026 22:11:05 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/14f67d3fbe78f9feab7a05b41ed438a7-6b0afcecaa2b3.jpg?jadewits_media_id=1057561" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/14f67d3fbe78f9feab7a05b41ed438a7-6b0afcecaa2b3.jpg?jadewits_media_id=1057561" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/14f67d3fbe78f9feab7a05b41ed438a7-6b0afcecaa2b3.jpg?jadewits_media_id=1057561" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রেমে টানে আসা চীনা তরুণের সঙ্গে মেয়ের বিয়ে দেননি কৃষক বাবা, দিলেন যেসব শর্ত" /&gt;&lt;/p&gt;&lt;p&gt;প্রেমিকার সঙ্গে দেখা করতে সুদূর চীন থেকে কুমিল্লার দেবীদ্বারে এসেছিলেন ৩৪ বছর বয়সী তরুণ জিয়াকিয়ান। প্রায় ছয় মাসের পরিচয় থেকে গড়ে ওঠা প্রেমের সম্পর্ককে বিয়েতে রূপ দিতে এক সপ্তাহ আগে তিনি বাংলাদেশে আসেন। ঢাকায় হোটেলে অবস্থানের পর শুক্রবার (২৭ নভেম্বর) প্রেমিকার বাড়িতেও পৌঁছান। কিন্তু প্রেমিকার পরিবার&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/country/chitagong/983888/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AE%E0%A7%87-%E0%A6%9F%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%B8%E0%A6%BE-%E0%A6%9A%E0%A7%80%E0%A6%A8%E0%A6%BE-%E0%A6%A4%E0%A6%B0%E0%A7%81%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%AE%E0%A7%87%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%A8%E0%A6%A8%E0%A6%BF">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>তুর্যের মৃত্যু হৃদয়বিদারক, মায়ের প্যারোলে মুক্তিতে সরকারের বিধিনিষেধ ছিল না: রাশেদ খাঁন</title>
      <link>https://www.banglatribune.com/politics/bnp/983887/%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81-%E0%A6%B9%E0%A7%83%E0%A6%A6%E0%A7%9F%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A6%BE%E0%A6%B0%E0%A6%95-%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A7%8B%E0%A6%B2%E0%A7%87-%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/politics/bnp/983887/%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81-%E0%A6%B9%E0%A7%83%E0%A6%A6%E0%A7%9F%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A6%BE%E0%A6%B0%E0%A6%95-%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A7%8B%E0%A6%B2%E0%A7%87-%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87</guid>
      <pubDate>Sat, 28 Nov 2026 22:06:38 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/9320de67bef88d964410102169fb073e-6b0afb79682c9.jpg?jadewits_media_id=1057560" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/9320de67bef88d964410102169fb073e-6b0afb79682c9.jpg?jadewits_media_id=1057560" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/9320de67bef88d964410102169fb073e-6b0afb79682c9.jpg?jadewits_media_id=1057560" style="max-width:100%;height:auto;margin-bottom:10px;" alt="তুর্যের মৃত্যু হৃদয়বিদারক, মায়ের প্যারোলে মুক্তিতে সরকারের বিধিনিষেধ ছিল না: রাশেদ খাঁন" /&gt;&lt;/p&gt;&lt;p&gt;যুব মহিলা লীগের সাবেক কেন্দ্রীয় সাংগঠনিক সম্পাদক শারমিন সুলতানা শর্মীর বিশেষ চাহিদাসম্পন্ন ১৫ বছর বয়সী ছেলে তুর্যের মৃত্যুতে শোক প্রকাশ করেছেন প্রধানমন্ত্রীর রাজনৈতিক সহকারী রাশেদ খাঁন। তিনি বলেছেন, ছেলের মৃত্যুর পর শারমিন সুলতানাকে প্যারোলে মুক্তি দেওয়ার বিষয়ে সরকারের পক্ষ থেকে কোনও বিধিনিষেধ ছিল ন&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/politics/bnp/983887/%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81-%E0%A6%B9%E0%A7%83%E0%A6%A6%E0%A7%9F%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A6%BE%E0%A6%B0%E0%A6%95-%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A7%8B%E0%A6%B2%E0%A7%87-%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>রাজনৈতিক কর্মসূচি ঘিরে বাড়ছে উদ্বেগ, সতর্ক আইনশৃঙ্খলা বাহিনী</title>
      <link>https://www.banglatribune.com/law-and-crime/983877/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A8%E0%A7%88%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%B8%E0%A7%82%E0%A6%9A%E0%A6%BF-%E0%A6%98%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%9B%E0%A7%87-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%87%E0%A6%97-%E0%A6%B8%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%95</link>
      <guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/983877/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A8%E0%A7%88%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%B8%E0%A7%82%E0%A6%9A%E0%A6%BF-%E0%A6%98%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%9B%E0%A7%87-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%87%E0%A6%97-%E0%A6%B8%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%95</guid>
      <pubDate>Sat, 28 Nov 2026 22:23:34 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/09/19/e1b5f438d3bbf7ee2cab359a867d6e75-6aae74cc9f5bf.jpg?jadewits_media_id=1044549" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/09/19/e1b5f438d3bbf7ee2cab359a867d6e75-6aae74cc9f5bf.jpg?jadewits_media_id=1044549" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/09/19/e1b5f438d3bbf7ee2cab359a867d6e75-6aae74cc9f5bf.jpg?jadewits_media_id=1044549" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজনৈতিক কর্মসূচি ঘিরে বাড়ছে উদ্বেগ, সতর্ক আইনশৃঙ্খলা বাহিনী" /&gt;&lt;/p&gt;&lt;p&gt;নভেম্বরের রাজনৈতিক সহিংসতার রেশ কাটতে না কাটতেই ডিসেম্বর ঘিরে নতুন করে জননিরাপত্তা নিয়ে উদ্বেগ তৈরি হয়েছে। কার্যক্রম নিষিদ্ধ আওয়ামী লীগের একের পর এক কর্মসূচির ঘোষণা, সাম্প্রতিক অগ্নিসংযোগ ও হামলার ঘটনা এবং বিএনপি, জামায়াতে ইসলামী ও জাতীয় নাগরিক পার্টির (এনসিপি) পাল্টা মাঠে থাকার ঘোষণায় রাজনৈতিক উত্ত&lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/law-and-crime/983877/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A8%E0%A7%88%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%B8%E0%A7%82%E0%A6%9A%E0%A6%BF-%E0%A6%98%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%9B%E0%A7%87-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%87%E0%A6%97-%E0%A6%B8%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%95">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>এক জেলার আইনজীবীদের নির্বাচনে এক প্যানেলের নিরঙ্কুশ জয়, এক পদেও জেতেনি জামায়াতপন্থিরা</title>
      <link>https://www.banglatribune.com/country/rajshahi/983886/%E0%A6%8F%E0%A6%95-%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%87%E0%A6%A8%E0%A6%9C%E0%A7%80%E0%A6%AC%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%9A%E0%A6%A8%E0%A7%87-%E0%A6%8F%E0%A6%95-%E0%A6%AA%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/country/rajshahi/983886/%E0%A6%8F%E0%A6%95-%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%87%E0%A6%A8%E0%A6%9C%E0%A7%80%E0%A6%AC%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%9A%E0%A6%A8%E0%A7%87-%E0%A6%8F%E0%A6%95-%E0%A6%AA%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Sat, 28 Nov 2026 21:55:46 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/fac9751ff7653d99efd66e4f7082305a-6b0af971b3271.jpg?jadewits_media_id=1057558" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/fac9751ff7653d99efd66e4f7082305a-6b0af971b3271.jpg?jadewits_media_id=1057558" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/fac9751ff7653d99efd66e4f7082305a-6b0af971b3271.jpg?jadewits_media_id=1057558" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এক জেলার আইনজীবীদের নির্বাচনে এক প্যানেলের নিরঙ্কুশ জয়, এক পদেও জেতেনি জামায়াতপন্থিরা" /&gt;&lt;/p&gt;&lt;p&gt;জয়পুরহাট জেলা আইনজীবী সমিতির ২০২৬-২৭ মেয়াদের কার্যনির্বাহী কমিটির নির্বাচনে জাতীয়তাবাদী আইনজীবী ফোরাম মনোনীত প্যানেল নিরঙ্কুশ বিজয় অর্জন করেছে। সভাপতি ও সাধারণ সম্পাদকসহ সবকটি পদেই জয় পেয়েছেন এ প্যানেলের প্রার্থীরা।
নির্বাচনে প্রতিদ্বন্দ্বিতা করে জামায়াতে ইসলামী লইয়ার্স কাউন্সিল মনোনীত প্যানেল। তবে &lt;/p&gt;</description>

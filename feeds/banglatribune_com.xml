      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/5e9237cb6dfb5abcda56cd1b6fa667aa-6af577fd7bc55.jpg?jadewits_media_id=1054609" length="0" type="image/jpeg" />

    <item>
      <title>চীন-ইইউ’র বাণিজ্যিক উদ্বেগ নিরসনে আলোচনা চায় বেইজিং</title>
      <link>https://www.banglatribune.com/foreign/asia/979663/%E0%A6%9A%E0%A7%80%E0%A6%A8-%E0%A6%87%E0%A6%87%E0%A6%89%E2%80%99%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%A3%E0%A6%BF%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A6%BF%E0%A6%95-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%87%E0%A6%97-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%B8%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%B2%E0%A7%8B%E0%A6%9A%E0%A6%A8%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A7%9F</link>
      <guid isPermaLink="true">https://www.banglatribune.com/foreign/asia/979663/%E0%A6%9A%E0%A7%80%E0%A6%A8-%E0%A6%87%E0%A6%87%E0%A6%89%E2%80%99%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%A3%E0%A6%BF%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A6%BF%E0%A6%95-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%87%E0%A6%97-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%B8%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%B2%E0%A7%8B%E0%A6%9A%E0%A6%A8%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A7%9F</guid>
      <pubDate>Sun, 08 Nov 2026 20:11:51 +0600</pubDate>
      <description>চীন ও ইউরোপীয় ইউনিয়নের (ইইউ) মধ্যে বিদ্যমান অর্থনৈতিক ও বাণিজ্যিক উদ্বেগ নিরসনে সংলাপ ও আলোচনার মাধ্যমে সমাধানের পথ খুঁজে বের করার আহ্বান জানিয়েছে বেইজিং। নিজেদের অর্থনৈতিক ও বাণিজ্যিক সমস্যার মুখোমুখি হতে ইইউ&amp;rsquo;র প্রতি এ জানায় দেশটি। চীনের বাণিজ্য মন্ত্রণালয়ের এক মুখপাত্র গণমাধ্যমের প্রশ্নের জব</description>
      <source url="https://www.banglatribune.com/foreign/asia/979663/%E0%A6%9A%E0%A7%80%E0%A6%A8-%E0%A6%87%E0%A6%87%E0%A6%89%E2%80%99%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%A3%E0%A6%BF%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A6%BF%E0%A6%95-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%87%E0%A6%97-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%B8%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%B2%E0%A7%8B%E0%A6%9A%E0%A6%A8%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A7%9F">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ধূমপানমুক্ত এলাকা হচ্ছে জাতীয় সংসদ চত্বর</title>
      <link>https://www.banglatribune.com/national/979662/%E0%A6%A7%E0%A7%82%E0%A6%AE%E0%A6%AA%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%8F%E0%A6%B2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6-%E0%A6%9A%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.banglatribune.com/national/979662/%E0%A6%A7%E0%A7%82%E0%A6%AE%E0%A6%AA%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%8F%E0%A6%B2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6-%E0%A6%9A%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A6%B0</guid>
      <pubDate>Sun, 08 Nov 2026 20:08:56 +0600</pubDate>
      <description>জাতীয় সংসদ চত্বরকে ধূমপানমুক্ত এলাকা ঘোষণা করা হচ্ছে। প্রধানমন্ত্রী ও সংসদ নেতা তারেক রহমানের প্রস্তাবে কার্য উপদেষ্টা কমিটির সদস্যরা সর্বসম্মতিক্রমে সম্মতি দিয়েছেন।
রবিবার (৮ নভেম্বর) জাতীয় সংসদ ভবনের কেবিনেট কক্ষে ত্রয়োদশ জাতীয় সংসদের কার্য উপদেষ্টা কমিটির পঞ্চম বৈঠকে এ প্রস্তাব দেওয়া হয়। বৈঠকে সভ</description>
      <source url="https://www.banglatribune.com/national/979662/%E0%A6%A7%E0%A7%82%E0%A6%AE%E0%A6%AA%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%8F%E0%A6%B2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6-%E0%A6%9A%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A6%B0">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>ব্যাংক ও ক্রেডিট কার্ডের লেনদেন বিশ্লেষণ করবে ক্লড, জানাবে আয়-ব্যয়ের হিসাব</title>
      <link>https://www.banglatribune.com/tech-and-gadget/979661/%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95-%E0%A6%93-%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A1%E0%A6%BF%E0%A6%9F-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A7%87%E0%A6%B0-%E0%A6%B2%E0%A7%87%E0%A6%A8%E0%A6%A6%E0%A7%87%E0%A6%A8-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%B2%E0%A7%87%E0%A6%B7%E0%A6%A3-%E0%A6%95%E0%A6%B0%E0%A6%AC%E0%A7%87</link>
      <guid isPermaLink="true">https://www.banglatribune.com/tech-and-gadget/979661/%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95-%E0%A6%93-%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A1%E0%A6%BF%E0%A6%9F-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A7%87%E0%A6%B0-%E0%A6%B2%E0%A7%87%E0%A6%A8%E0%A6%A6%E0%A7%87%E0%A6%A8-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%B2%E0%A7%87%E0%A6%B7%E0%A6%A3-%E0%A6%95%E0%A6%B0%E0%A6%AC%E0%A7%87</guid>
      <pubDate>Sun, 08 Nov 2026 20:07:08 +0600</pubDate>
      <description>মাসজুড়ে কোথায় কত টাকা খরচ হয়েছে, কোন খাতে ব্যয় বেড়েছে কিংবা অপ্রত্যাশিত কোনও চার্জ কাটা হয়েছে কি না, এসব তথ্য জানতে এবার সরাসরি ব্যাংক ও ক্রেডিট কার্ডের হিসাব বিশ্লেষণ করতে পারবে কৃত্রিম বুদ্ধিমত্তাভিত্তিক চ্যাটবট ক্লড। এ জন্য &amp;lsquo;পার্সোনাল ফাইন্যান্স&amp;rsquo;নামের নতুন একটি সুবিধা চালু করছে ক্লডের</description>
      <source url="https://www.banglatribune.com/tech-and-gadget/979661/%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95-%E0%A6%93-%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A1%E0%A6%BF%E0%A6%9F-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A7%87%E0%A6%B0-%E0%A6%B2%E0%A7%87%E0%A6%A8%E0%A6%A6%E0%A7%87%E0%A6%A8-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%B2%E0%A7%87%E0%A6%B7%E0%A6%A3-%E0%A6%95%E0%A6%B0%E0%A6%AC%E0%A7%87">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>সোমবার শুরু হচ্ছে সংসদের চতুর্থ অধিবেশন</title>
      <link>https://www.banglatribune.com/national/979660/%E0%A6%B8%E0%A7%8B%E0%A6%AE%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%A5-%E0%A6%85%E0%A6%A7%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/national/979660/%E0%A6%B8%E0%A7%8B%E0%A6%AE%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%A5-%E0%A6%85%E0%A6%A7%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%A8</guid>
      <pubDate>Sun, 08 Nov 2026 20:03:14 +0600</pubDate>
      <description>ত্রয়োদশ জাতীয় সংসদের চতুর্থ অধিবেশন সোমবার (৯ নভেম্বর) শুরু হচ্ছে। এ অধিবেশন আগামী ১৮ নভেম্বর শেষ হবে। প্রথম দিন বিকাল সাড়ে ৩টায় সংসদের বৈঠক শুরু হবে। এরপর সরকারি ছুটির দিন (শুক্র ও শনিবার) ছাড়া প্রতিদিন বিকাল ৪টা ২০ মিনিটে সংসদের বৈঠক বসবে। অধিবেশনের প্রথম দিন তিনটি অধ্যাদেশ উপস্থাপন করা হবে। এছাড়া</description>
      <source url="https://www.banglatribune.com/national/979660/%E0%A6%B8%E0%A7%8B%E0%A6%AE%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%A5-%E0%A6%85%E0%A6%A7%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%A8">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>যে মুসলিম কবি ‘মা কালী’র জন্য গেয়েছিলেন, লিখেছিলেন শ্যামাসংগীত</title>
      <link>https://www.banglatribune.com/entertainment/songs/979659/%E0%A6%AF%E0%A7%87-%E0%A6%AE%E0%A7%81%E0%A6%B8%E0%A6%B2%E0%A6%BF%E0%A6%AE-%E0%A6%95%E0%A6%AC%E0%A6%BF-%E2%80%98%E0%A6%AE%E0%A6%BE-%E0%A6%95%E0%A6%BE%E0%A6%B2%E0%A7%80%E2%80%99%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%97%E0%A7%87%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%B2%E0%A6%BF%E0%A6%96%E0%A7%87%E0%A6%9B%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.banglatribune.com/entertainment/songs/979659/%E0%A6%AF%E0%A7%87-%E0%A6%AE%E0%A7%81%E0%A6%B8%E0%A6%B2%E0%A6%BF%E0%A6%AE-%E0%A6%95%E0%A6%AC%E0%A6%BF-%E2%80%98%E0%A6%AE%E0%A6%BE-%E0%A6%95%E0%A6%BE%E0%A6%B2%E0%A7%80%E2%80%99%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%97%E0%A7%87%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%B2%E0%A6%BF%E0%A6%96%E0%A7%87%E0%A6%9B%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Sun, 08 Nov 2026 20:02:05 +0600</pubDate>
      <description>ধর্মের সঙ্গে বাংলার সম্পর্ক রাজনীতির সংকীর্ণ ন্যারেটিভের চেয়েও সর্বদাই জটিল এবং আকর্ষণীয়। এই সাংস্কৃতিক ইতিহাসের পাতায় জড়িয়ে রয়েছে এক সম্প্রদায়ের ঐতিহ্য অন্য সম্প্রদায়ের আপন করে নেওয়ার অজস্র উদাহরণ। এই যৌথ উত্তরাধিকারকে বিদ্রোহী কবি কাজী নজরুল ইসলামের চেয়ে সার্থকভাবে আর কেউ বহন করেননি। মুসলিম পরিবার</description>

      <guid isPermaLink="true">https://www.banglatribune.com/national/980870/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A6%A4%E0%A6%BE-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A6%97%E0%A6%A4%E0%A6%BF%E0%A6%B6%E0%A7%80%E0%A6%B2-%E0%A6%95%E0%A6%B0%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Sat, 14 Nov 2026 15:46:03 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/e40f7cdac116826c70fce727787ed588-6af82d8290a0e.jpg?jadewits_media_id=1054946" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/e40f7cdac116826c70fce727787ed588-6af82d8290a0e.jpg?jadewits_media_id=1054946" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/e40f7cdac116826c70fce727787ed588-6af82d8290a0e.jpg?jadewits_media_id=1054946" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজধানীর পরিচ্ছন্নতা কার্যক্রম আরও গতিশীল করার তাগিদ প্রধানমন্ত্রীর" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর পরিচ্ছন্নতা কার্যক্রম আরও গতিশীল ও কার্যকর করতে গঠিত কমিটির কাজের সর্বশেষ অগ্রগতি পর্যালোচনা করেছেন প্রধানমন্ত্রী তারেক রহমান। এ সময় সংশ্লিষ্ট কাজ আরও দ্রুত এবং গতিশীল করার তাগিদ দেন তিনি।
শনিবার (১৪ নভেম্বর) দুপুরে রাজধানীর তেজগাঁওয়ে নিজ কার্যালয়ে পর্যালোচনা সভায় সভাপতির বক্তব্যে তিনি এসব &lt;/p&gt;</description>

      <guid isPermaLink="true">https://www.banglatribune.com/country/dhaka/981400/%E0%A6%95%E0%A7%83%E0%A6%B7%E0%A6%95-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95-%E0%A6%9C%E0%A6%A8%E0%A6%A4%E0%A6%BE-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A7%8D%E0%A6%A4-%E0%A6%B8%E0%A7%87%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%A1%E0%A6%BF%E0%A6%AC%E0%A6%BF</guid>

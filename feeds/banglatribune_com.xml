      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/a74029d8f8862f74b304ba4248df58b6-6b015d85c2eb9.jpg?jadewits_media_id=1056181" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/a74029d8f8862f74b304ba4248df58b6-6b015d85c2eb9.jpg?jadewits_media_id=1056181" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/a74029d8f8862f74b304ba4248df58b6-6b015d85c2eb9.jpg?jadewits_media_id=1056181" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শতভাগ দেশীয় পণ্য নিয়ে আগারগাঁওয়ে এসএমই পণ্যমেলা শুরু রবিবার" /&gt;&lt;/p&gt;&lt;p&gt;ক্ষুদ্র, কুটির, মাইক্রো ও মাঝারি (সিএমএসএমই) শিল্পের বিকাশ, উদ্যোক্তা সৃষ্টি, কর্মসংস্থান বৃদ্ধি এবং দেশীয় পণ্যের বাজার সম্প্রসারণের লক্ষ্যে আগামীকাল রবিবার রাজধানীতে শুরু হচ্ছে সাত দিনব্যাপী ১৩তম জাতীয় এসএমই পণ্যমেলা-২০২৬।
আগামী ২২ থেকে ২৮ নভেম্বর আগারগাঁওয়ের বাংলাদেশ-চীন মৈত্রী সম্মেলন কেন্দ্রে এ &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/business/982337/%E0%A6%B6%E0%A6%A4%E0%A6%AD%E0%A6%BE%E0%A6%97-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%80%E0%A7%9F-%E0%A6%AA%E0%A6%A3%E0%A7%8D%E0%A6%AF-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A6%BE%E0%A6%B0%E0%A6%97%E0%A6%BE%E0%A6%81%E0%A6%93%E0%A7%9F%E0%A7%87-%E0%A6%8F%E0%A6%B8%E0%A6%8F%E0%A6%AE%E0%A6%87-%E0%A6%AA%E0%A6%A3%E0%A7%8D%E0%A6%AF%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%BE">বাংলা ট্রিবিউন</source>

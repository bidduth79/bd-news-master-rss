    <item>
      <title>জিমে যাওয়ার সময় নেই? বাড়ির এক কোণেই বানান ছোট্ট ফিটনেস কর্নার</title>
      <link>https://www.banglatribune.com/lifestyle/983118/%E0%A6%9C%E0%A6%BF%E0%A6%AE%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A7%9F-%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%AC%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A6%BF%E0%A6%B0-%E0%A6%8F%E0%A6%95-%E0%A6%95%E0%A7%8B%E0%A6%A3%E0%A7%87%E0%A6%87-%E0%A6%AC%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%A8-%E0%A6%9B%E0%A7%8B%E0%A6%9F%E0%A7%8D%E0%A6%9F</link>
      <guid isPermaLink="true">https://www.banglatribune.com/lifestyle/983118/%E0%A6%9C%E0%A6%BF%E0%A6%AE%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A7%9F-%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%AC%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A6%BF%E0%A6%B0-%E0%A6%8F%E0%A6%95-%E0%A6%95%E0%A7%8B%E0%A6%A3%E0%A7%87%E0%A6%87-%E0%A6%AC%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%A8-%E0%A6%9B%E0%A7%8B%E0%A6%9F%E0%A7%8D%E0%A6%9F</guid>
      <pubDate>Wed, 25 Nov 2026 18:00:00 +0600</pubDate>
      <enclosure url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/3f8cae5c474844e8919fcaae6531d96c-6b067f24c24f6.jpg?jadewits_media_id=1056837" length="0" type="image/jpeg" />
      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/3f8cae5c474844e8919fcaae6531d96c-6b067f24c24f6.jpg?jadewits_media_id=1056837" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/3f8cae5c474844e8919fcaae6531d96c-6b067f24c24f6.jpg?jadewits_media_id=1056837" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জিমে যাওয়ার সময় নেই? বাড়ির এক কোণেই বানান ছোট্ট ফিটনেস কর্নার" /&gt;&lt;/p&gt;&lt;p&gt;দিনভর অফিসের কাজ, সংসারের দায়িত্ব সামলে জিমে যাওয়ার সময় বা শক্তি কোনওটাই যেন অবশিষ্ট থাকে না। অথচ শরীরচর্চা না করলে শরীর ও মন, দু&amp;rsquo;টির উপরেই তার প্রভাব পড়তে পারে। অনেকেই তাই বাড়িতে ব্যায়াম শুরু করার কথা ভাবেন। কিন্তু ঘরের মধ্যে পর্যাপ্ত জায়গা না থাকলে সমস্যা তৈরি হয়। কখনও স্ট্রেচিং করতে গিয়ে &lt;/p&gt;</description>
      <source url="https://www.banglatribune.com/lifestyle/983118/%E0%A6%9C%E0%A6%BF%E0%A6%AE%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A7%9F-%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%AC%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A6%BF%E0%A6%B0-%E0%A6%8F%E0%A6%95-%E0%A6%95%E0%A7%8B%E0%A6%A3%E0%A7%87%E0%A6%87-%E0%A6%AC%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%A8-%E0%A6%9B%E0%A7%8B%E0%A6%9F%E0%A7%8D%E0%A6%9F">বাংলা ট্রিবিউন</source>
    </item>
    <item>
      <title>মহাকাশে ৯০টি বৈজ্ঞানিক পরীক্ষা চালাবে চীনের শেনচৌ-২৪ মিশন</title>

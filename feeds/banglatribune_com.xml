      <media:content url="https://cdn.banglatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/636f56bb0439a89034f45143dd447702-6b05ac0fa7ff6.jpg?jadewits_media_id=1056765" medium="image" />

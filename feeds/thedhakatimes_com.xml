      <enclosure url="https://thedhakatimes.com/wp-content/uploads/2026/11/657545.jpeg" length="0" type="image/jpeg" />
      <media:content url="https://thedhakatimes.com/wp-content/uploads/2026/11/657545.jpeg" medium="image" />

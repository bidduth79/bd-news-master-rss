    <item>
      <title>চট্টগ্রামের চার উপজেলার ৫৩ ইউনিয়নে ভোট ২১ জানুয়ারি</title>
      <link>https://dainikazadi.net/%e0%a6%9a%e0%a6%9f%e0%a7%8d%e0%a6%9f%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ae%e0%a7%87%e0%a6%b0-%e0%a6%9a%e0%a6%be%e0%a6%b0-%e0%a6%89%e0%a6%aa%e0%a6%9c%e0%a7%87%e0%a6%b2%e0%a6%be%e0%a6%b0/</link>
      <guid isPermaLink="true">https://dainikazadi.net/%e0%a6%9a%e0%a6%9f%e0%a7%8d%e0%a6%9f%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ae%e0%a7%87%e0%a6%b0-%e0%a6%9a%e0%a6%be%e0%a6%b0-%e0%a6%89%e0%a6%aa%e0%a6%9c%e0%a7%87%e0%a6%b2%e0%a6%be%e0%a6%b0/</guid>
      <pubDate>Tue, 17 Nov 2026 00:28:22 +0000</pubDate>
      <description>ইউনিয়ন পরিষদ নির্বাচনের প্রথম ধাপে আগামী ২১ জানুয়ারি চট্টগ্রামের চার উপজেলার ৫৩টি ইউনিয়নে ভোটগ্রহণের প্রাথমিক পরিকল্পনা নিয়েছে নির্বাচন কমিশন (ইসি)। আগামী ২১ জানুয়ারি প্রথমধাপে সারাদেশের ১০২৬ ইউনিয়ন পরিষদে (ইউপি) ভোট অনুষ্ঠিত হবে বলে জানিয়েছেন নির্বাচন কমিশনার (ইসি) আবুল ফজল মোহাম্মদ সানাউল্লাহ। তিন</description>
      <source url="https://dainikazadi.net/%e0%a6%9a%e0%a6%9f%e0%a7%8d%e0%a6%9f%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ae%e0%a7%87%e0%a6%b0-%e0%a6%9a%e0%a6%be%e0%a6%b0-%e0%a6%89%e0%a6%aa%e0%a6%9c%e0%a7%87%e0%a6%b2%e0%a6%be%e0%a6%b0/">দৈনিক আজাদী</source>
    </item>
    <item>
      <title>মাতামুহুরীসহ নতুন দুই থানা ও দুই পৌরসভা গঠনের অনুমোদন</title>
      <link>https://dainikazadi.net/%e0%a6%ae%e0%a6%be%e0%a6%a4%e0%a6%be%e0%a6%ae%e0%a7%81%e0%a6%b9%e0%a7%81%e0%a6%b0%e0%a7%80%e0%a6%b8%e0%a6%b9-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%a6%e0%a7%81%e0%a6%87-%e0%a6%a5%e0%a6%be/</link>
      <guid isPermaLink="true">https://dainikazadi.net/%e0%a6%ae%e0%a6%be%e0%a6%a4%e0%a6%be%e0%a6%ae%e0%a7%81%e0%a6%b9%e0%a7%81%e0%a6%b0%e0%a7%80%e0%a6%b8%e0%a6%b9-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%a6%e0%a7%81%e0%a6%87-%e0%a6%a5%e0%a6%be/</guid>
      <pubDate>Tue, 17 Nov 2026 00:23:44 +0000</pubDate>
      <description>বাংলাদেশের প্রশাসনিক পুনর্বিন্যাস সংক্রান্ত জাতীয় বাস্তবায়ন কমিটির (নিকার) সভায় নতুন দুই থানা ও দুই পৌরসভা গঠনের অনুমোদন দেওয়া হয়েছে। একই সঙ্গে একটি থানার নাম পরিবর্তন এবং দুটি উপজেলার প্রশাসনিক সদর দপ্তর স্থানান্তরের অনুমোদন দেওয়া হয়। দেশের প্রশাসনিক কার্যক্রম আরও গতিশীল করতে নতুন দুটি থানা ও দুটি </description>
      <source url="https://dainikazadi.net/%e0%a6%ae%e0%a6%be%e0%a6%a4%e0%a6%be%e0%a6%ae%e0%a7%81%e0%a6%b9%e0%a7%81%e0%a6%b0%e0%a7%80%e0%a6%b8%e0%a6%b9-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%a6%e0%a7%81%e0%a6%87-%e0%a6%a5%e0%a6%be/">দৈনিক আজাদী</source>
    </item>
    <item>
      <title>রূপপুরের বিদ্যুৎ জাতীয় গ্রিডে দেওয়ার পরীক্ষা শুরু হতে পারে আজ</title>
      <link>https://dainikazadi.net/%e0%a6%b0%e0%a7%82%e0%a6%aa%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a7%81%e0%a7%8e-%e0%a6%9c%e0%a6%be%e0%a6%a4%e0%a7%80%e0%a7%9f-%e0%a6%97/</link>
      <guid isPermaLink="true">https://dainikazadi.net/%e0%a6%b0%e0%a7%82%e0%a6%aa%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a7%81%e0%a7%8e-%e0%a6%9c%e0%a6%be%e0%a6%a4%e0%a7%80%e0%a7%9f-%e0%a6%97/</guid>
      <pubDate>Tue, 17 Nov 2026 00:22:26 +0000</pubDate>
      <description>রূপপুর পারমাণবিক বিদ্যুৎকেন্দ্রে উৎপাদিত বিদ্যুৎ জাতীয় সঞ্চালন লাইনে দেওয়ার পরীক্ষা চালানো হতে পারে আজ। রূপপুর পারমাণবিক বিদ্যুৎকেন্দ্র নির্মাণ প্রকল্পের পরিচালক কবীর হোসেন গতকাল সোমবার বলেন, মঙ্গলবার (আজ) গ্রিড সিনক্রোনাইজেশনের পরীক্ষা চালানো হতে পারে। পরীক্ষার অংশ হিসাবে গ্রিডে বিদ্যুৎ দেওয়ার পরিক</description>
      <source url="https://dainikazadi.net/%e0%a6%b0%e0%a7%82%e0%a6%aa%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a7%81%e0%a7%8e-%e0%a6%9c%e0%a6%be%e0%a6%a4%e0%a7%80%e0%a7%9f-%e0%a6%97/">দৈনিক আজাদী</source>
    </item>
    <item>
      <title>চমেক হাসপাতালে ডেঙ্গু রোগীর চাপ কমছে</title>
      <link>https://dainikazadi.net/%e0%a6%9a%e0%a6%ae%e0%a7%87%e0%a6%95-%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%aa%e0%a6%be%e0%a6%a4%e0%a6%be%e0%a6%b2%e0%a7%87-%e0%a6%a1%e0%a7%87%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%81-%e0%a6%b0%e0%a7%8b-2/</link>
      <guid isPermaLink="true">https://dainikazadi.net/%e0%a6%9a%e0%a6%ae%e0%a7%87%e0%a6%95-%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%aa%e0%a6%be%e0%a6%a4%e0%a6%be%e0%a6%b2%e0%a7%87-%e0%a6%a1%e0%a7%87%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%81-%e0%a6%b0%e0%a7%8b-2/</guid>
      <pubDate>Tue, 17 Nov 2026 00:21:37 +0000</pubDate>
      <description>চট্টগ্রাম মেডিকেল কলেজ (চমেক) হাসপাতালে কমছে ডেঙ্গুর রোগীর চাপ। দুই সপ্তাহ আগেও ডেঙ্গু ওয়ার্ডে শয্যা ছাড়িয়ে বেশিরভাগ রোগীদের বারান্দার মেঝেতেও চিকিৎসা নিতে হতো। রোগী ভর্তি থাকতো ১১০ থেকে ১২০ জন। এখন সেই চিত্র পাল্টেছে। ওয়ার্ডে ভর্তির রোগীর এখন অর্ধেক কমেছে। গতকাল ওয়ার্ডে ভর্তি রোগী নেমে এসেছে ৫০ এর </description>
      <source url="https://dainikazadi.net/%e0%a6%9a%e0%a6%ae%e0%a7%87%e0%a6%95-%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%aa%e0%a6%be%e0%a6%a4%e0%a6%be%e0%a6%b2%e0%a7%87-%e0%a6%a1%e0%a7%87%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%81-%e0%a6%b0%e0%a7%8b-2/">দৈনিক আজাদী</source>
    </item>
    <item>
      <title>ব্যাংক খাতে খেলাপি ঋণ ৫ লাখ ৯৭ হাজার ১৫৪ কোটি টাকা</title>
      <link>https://dainikazadi.net/%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95-%e0%a6%96%e0%a6%be%e0%a6%a4%e0%a7%87-%e0%a6%96%e0%a7%87%e0%a6%b2%e0%a6%be%e0%a6%aa%e0%a6%bf-%e0%a6%8b%e0%a6%a3-%e0%a7%ab-%e0%a6%b2%e0%a6%be/</link>
      <guid isPermaLink="true">https://dainikazadi.net/%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95-%e0%a6%96%e0%a6%be%e0%a6%a4%e0%a7%87-%e0%a6%96%e0%a7%87%e0%a6%b2%e0%a6%be%e0%a6%aa%e0%a6%bf-%e0%a6%8b%e0%a6%a3-%e0%a7%ab-%e0%a6%b2%e0%a6%be/</guid>
      <pubDate>Tue, 17 Nov 2026 00:20:39 +0000</pubDate>
      <description>দেশের ব্যাংক খাতে খেলাপি ঋণের পরিমাণ বেড়ে ৫ লাখ ৯৭ হাজার ১৫৪ কোটি ৯৩ লাখ টাকায় দাঁড়িয়েছে। গত সেপ্টেম্বর পর্যন্ত ব্যাংকগুলোর বিতরণ করা মোট ঋণের ৩২ দশমিক ১৭ শতাংশই খেলাপি। জাতীয় সংসদে গতকাল সোমবার সিরাজগঞ্জ&amp;#8211;৪ আসনের জামায়াতে ইসলামীর সংসদ সদস্য রফিকুল ইসলাম খানের এক প্রশ্নের লিখিত জবাবে অর্থমন্ত্র</description>
      <source url="https://dainikazadi.net/%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95-%e0%a6%96%e0%a6%be%e0%a6%a4%e0%a7%87-%e0%a6%96%e0%a7%87%e0%a6%b2%e0%a6%be%e0%a6%aa%e0%a6%bf-%e0%a6%8b%e0%a6%a3-%e0%a7%ab-%e0%a6%b2%e0%a6%be/">দৈনিক আজাদী</source>
    </item>
    <item>
      <title>আজ বিল্ডিংয়ে গুলি করেছি, কাল তোর শরীরে করব</title>
      <link>https://dainikazadi.net/%e0%a6%86%e0%a6%9c-%e0%a6%ac%e0%a6%bf%e0%a6%b2%e0%a7%8d%e0%a6%a1%e0%a6%bf%e0%a6%82%e0%a7%9f%e0%a7%87-%e0%a6%97%e0%a7%81%e0%a6%b2%e0%a6%bf-%e0%a6%95%e0%a6%b0%e0%a7%87%e0%a6%9b%e0%a6%bf-%e0%a6%95/</link>
      <guid isPermaLink="true">https://dainikazadi.net/%e0%a6%86%e0%a6%9c-%e0%a6%ac%e0%a6%bf%e0%a6%b2%e0%a7%8d%e0%a6%a1%e0%a6%bf%e0%a6%82%e0%a7%9f%e0%a7%87-%e0%a6%97%e0%a7%81%e0%a6%b2%e0%a6%bf-%e0%a6%95%e0%a6%b0%e0%a7%87%e0%a6%9b%e0%a6%bf-%e0%a6%95/</guid>
      <pubDate>Tue, 17 Nov 2026 00:19:56 +0000</pubDate>
      <description>নগরীতে ২০ লাখ টাকা চাঁদা না পেয়ে এক ভূমি ব্যবসায়ীর বাড়িতে গুলি চালিয়েছে সন্ত্রাসীরা। গুলি করার পর মোবাইলে ফোন করে ওই ব্যবসায়ীকে প্রাণনাশের হুমকিও দেওয়া হয়েছে। ফোনে বলা হয়েছে, ‘আজ বিল্ডিংয়ে গুলি করেছি, কাল তোর শরীরে করব। কাফনের কাপড় কিনে রাখিস।’ এই ঘটনায় আবারো সন্ত্রাসী বড় সাজ্জাদের নাম আলোচনায় এসেছে</description>
      <source url="https://dainikazadi.net/%e0%a6%86%e0%a6%9c-%e0%a6%ac%e0%a6%bf%e0%a6%b2%e0%a7%8d%e0%a6%a1%e0%a6%bf%e0%a6%82%e0%a7%9f%e0%a7%87-%e0%a6%97%e0%a7%81%e0%a6%b2%e0%a6%bf-%e0%a6%95%e0%a6%b0%e0%a7%87%e0%a6%9b%e0%a6%bf-%e0%a6%95/">দৈনিক আজাদী</source>
    </item>
    <item>
      <title>রানি রাসমণি ঘাটে আগুনে পুড়ল ৭০টি জালঘর</title>
      <link>https://dainikazadi.net/%e0%a6%b0%e0%a6%be%e0%a6%a8%e0%a6%bf-%e0%a6%b0%e0%a6%be%e0%a6%b8%e0%a6%ae%e0%a6%a3%e0%a6%bf-%e0%a6%98%e0%a6%be%e0%a6%9f%e0%a7%87-%e0%a6%86%e0%a6%97%e0%a7%81%e0%a6%a8%e0%a7%87-%e0%a6%aa%e0%a7%81/</link>
      <guid isPermaLink="true">https://dainikazadi.net/%e0%a6%b0%e0%a6%be%e0%a6%a8%e0%a6%bf-%e0%a6%b0%e0%a6%be%e0%a6%b8%e0%a6%ae%e0%a6%a3%e0%a6%bf-%e0%a6%98%e0%a6%be%e0%a6%9f%e0%a7%87-%e0%a6%86%e0%a6%97%e0%a7%81%e0%a6%a8%e0%a7%87-%e0%a6%aa%e0%a7%81/</guid>
      <pubDate>Tue, 17 Nov 2026 00:19:20 +0000</pubDate>
      <description>নগরীর কাট্টলী রানি রাসমণি ঘাট এলাকায় অগ্নিকাণ্ডে একে একে পুড়ে যায় ৭০টির বেশি জালঘর, ১৫টি মাছের গদি, চারটি বরফকল ও কয়েকটি দোকান। চোখের সামনে পুড়ে ছাই হয়ে যায় ব্যবসায়ীদের বছরের পর বছর ধরে গড়ে তোলা সম্পদ। তাদের অভিযোগ এসব জালঘরে ছিল না বিদ্যুৎ সংযোগ। ছিল না গ্যাসের চুলা কিংবা আগুনের কোনো দৃশ্যমান উৎস। </description>
      <source url="https://dainikazadi.net/%e0%a6%b0%e0%a6%be%e0%a6%a8%e0%a6%bf-%e0%a6%b0%e0%a6%be%e0%a6%b8%e0%a6%ae%e0%a6%a3%e0%a6%bf-%e0%a6%98%e0%a6%be%e0%a6%9f%e0%a7%87-%e0%a6%86%e0%a6%97%e0%a7%81%e0%a6%a8%e0%a7%87-%e0%a6%aa%e0%a7%81/">দৈনিক আজাদী</source>
    </item>
    <item>
      <title>৬০ বছরের স্মৃতি-ঐতিহ্য, উৎসবের অপেক্ষায় চবি</title>
      <link>https://dainikazadi.net/%e0%a7%ac%e0%a7%a6-%e0%a6%ac%e0%a6%9b%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a7%8d%e0%a6%ae%e0%a7%83%e0%a6%a4%e0%a6%bf-%e0%a6%90%e0%a6%a4%e0%a6%bf%e0%a6%b9%e0%a7%8d%e0%a6%af-%e0%a6%89%e0%a7%8e/</link>

    <item>
      <title>ইরান যুদ্ধ শুরুর পর থেকে হরমুজ প্রণালি ও আশপাশে অন্তত ২৫ নাবিক নিহত</title>
      <link>https://dainikazadi.net/%e0%a6%87%e0%a6%b0%e0%a6%be%e0%a6%a8-%e0%a6%af%e0%a7%81%e0%a6%a6%e0%a7%8d%e0%a6%a7-%e0%a6%b6%e0%a7%81%e0%a6%b0%e0%a7%81%e0%a6%b0-%e0%a6%aa%e0%a6%b0-%e0%a6%a5%e0%a7%87%e0%a6%95%e0%a7%87-%e0%a6%b9/</link>

    </item>
    <item>
      <title>ক্যাম্পাসের স্মৃতির উঠোনে চবির হীরকজয়ন্তী উৎসব</title>
      <link>https://dainikazadi.net/%e0%a6%95%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%ae%e0%a7%8d%e0%a6%aa%e0%a6%be%e0%a6%b8%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a7%8d%e0%a6%ae%e0%a7%83%e0%a6%a4%e0%a6%bf%e0%a6%b0-%e0%a6%89%e0%a6%a0%e0%a7%8b%e0%a6%a8/</link>

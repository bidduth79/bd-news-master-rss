    <item>
      <title>লেকসিটি বিজয় নগরে পাহাড় কেটে নির্মাণ হচ্ছে পাকা ঘর</title>
      <link>https://dainikazadi.net/%e0%a6%b2%e0%a7%87%e0%a6%95%e0%a6%b8%e0%a6%bf%e0%a6%9f%e0%a6%bf-%e0%a6%ac%e0%a6%bf%e0%a6%9c%e0%a7%9f-%e0%a6%a8%e0%a6%97%e0%a6%b0%e0%a7%87-%e0%a6%aa%e0%a6%be%e0%a6%b9%e0%a6%be%e0%a7%9c-%e0%a6%95/</link>

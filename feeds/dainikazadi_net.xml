    <item>
      <title>জাতীয় যুবশক্তি চট্টগ্রামের বাইক শোডাউন</title>
      <link>https://dainikazadi.net/%e0%a6%9c%e0%a6%be%e0%a6%a4%e0%a7%80%e0%a7%9f-%e0%a6%af%e0%a7%81%e0%a6%ac%e0%a6%b6%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%bf-%e0%a6%9a%e0%a6%9f%e0%a7%8d%e0%a6%9f%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ae/</link>

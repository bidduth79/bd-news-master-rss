    <item>
      <title>পশ্চিম গুজরায় দুইদিনব্যাপী জগদ্ধাত্রী পূজা অনুষ্ঠান</title>
      <link>https://dainikazadi.net/%e0%a6%aa%e0%a6%b6%e0%a7%8d%e0%a6%9a%e0%a6%bf%e0%a6%ae-%e0%a6%97%e0%a7%81%e0%a6%9c%e0%a6%b0%e0%a6%be%e0%a7%9f-%e0%a6%a6%e0%a7%81%e0%a6%87%e0%a6%a6%e0%a6%bf%e0%a6%a8%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be/</link>
      <guid isPermaLink="true">https://dainikazadi.net/%e0%a6%aa%e0%a6%b6%e0%a7%8d%e0%a6%9a%e0%a6%bf%e0%a6%ae-%e0%a6%97%e0%a7%81%e0%a6%9c%e0%a6%b0%e0%a6%be%e0%a7%9f-%e0%a6%a6%e0%a7%81%e0%a6%87%e0%a6%a6%e0%a6%bf%e0%a6%a8%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be/</guid>
      <pubDate>Mon, 09 Nov 2026 05:19:02 +0000</pubDate>
      <description>শ্রীশ্রী জগদ্বাত্রী পূজা উদ্‌যাপন পরিষদের উদ্যোগে আসন্ন জগদ্বাত্রী মায়ের পূজা উপলক্ষে এক সভা অনুষ্ঠিত হয়েছে। উক্ত সভায় সভাপতিত্ব করেন কার্যকরী কমিটির সভাপতি আশুতোষ মহাজন। কার্যকরী কমিটির সাধারণ সম্পাদক কানু রাম দাশের সঞ্চালনায় পবিত্র গীতা পাঠের মধ্যে দিয়ে সভার কার্যক্রম শুরু হয়। দুইদিন ব্যাপী অনুষ্ঠ</description>
      <source url="https://dainikazadi.net/%e0%a6%aa%e0%a6%b6%e0%a7%8d%e0%a6%9a%e0%a6%bf%e0%a6%ae-%e0%a6%97%e0%a7%81%e0%a6%9c%e0%a6%b0%e0%a6%be%e0%a7%9f-%e0%a6%a6%e0%a7%81%e0%a6%87%e0%a6%a6%e0%a6%bf%e0%a6%a8%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be/">দৈনিক আজাদী</source>
    </item>
    <item>
      <title>বোয়ালখালীতে মুক্তিযোদ্ধা সংসদের বিপ্লব ও সংহতি দিবস উদযাপন</title>
      <link>https://dainikazadi.net/%e0%a6%ac%e0%a7%8b%e0%a7%9f%e0%a6%be%e0%a6%b2%e0%a6%96%e0%a6%be%e0%a6%b2%e0%a7%80%e0%a6%a4%e0%a7%87-%e0%a6%ae%e0%a7%81%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%bf%e0%a6%af%e0%a7%8b%e0%a6%a6%e0%a7%8d-2/</link>
      <guid isPermaLink="true">https://dainikazadi.net/%e0%a6%ac%e0%a7%8b%e0%a7%9f%e0%a6%be%e0%a6%b2%e0%a6%96%e0%a6%be%e0%a6%b2%e0%a7%80%e0%a6%a4%e0%a7%87-%e0%a6%ae%e0%a7%81%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%bf%e0%a6%af%e0%a7%8b%e0%a6%a6%e0%a7%8d-2/</guid>
      <pubDate>Mon, 09 Nov 2026 05:18:28 +0000</pubDate>
      <description>বোয়ালখালীতে মুক্তিযোদ্ধা সংসদ বোয়ালখালী উপজেলা কমান্ডের আয়োজনে জাতীয় বিপ্লব ও সংহতি দিবস উপলক্ষে আলোচনা সভা অনুষ্ঠিত হয়েছে। শনিবার (৭ নভেম্বর) সকালে উপজেলা মুক্তিযোদ্ধা সংসদের আহবায়ক মুক্তিযোদ্ধা আবদুল লতিফের সভাপতিত্বে ও উপজেলা মুক্তিযোদ্ধা সংসদের সদস্য সচিব মুক্তিযোদ্ধা শরৎ বড়ুয়ার সঞ্চালনায় এতে বক</description>
      <source url="https://dainikazadi.net/%e0%a6%ac%e0%a7%8b%e0%a7%9f%e0%a6%be%e0%a6%b2%e0%a6%96%e0%a6%be%e0%a6%b2%e0%a7%80%e0%a6%a4%e0%a7%87-%e0%a6%ae%e0%a7%81%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%bf%e0%a6%af%e0%a7%8b%e0%a6%a6%e0%a7%8d-2/">দৈনিক আজাদী</source>
    </item>
    <item>
      <title>চসিক জাতীয়তাবাদী শ্রমিক কর্মচারী ইউনিয়নের পূষ্পার্ঘ অর্পণ</title>
      <link>https://dainikazadi.net/%e0%a6%9a%e0%a6%b8%e0%a6%bf%e0%a6%95-%e0%a6%9c%e0%a6%be%e0%a6%a4%e0%a7%80%e0%a7%9f%e0%a6%a4%e0%a6%be%e0%a6%ac%e0%a6%be%e0%a6%a6%e0%a7%80-%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a6%ae%e0%a6%bf%e0%a6%95-4/</link>
      <guid isPermaLink="true">https://dainikazadi.net/%e0%a6%9a%e0%a6%b8%e0%a6%bf%e0%a6%95-%e0%a6%9c%e0%a6%be%e0%a6%a4%e0%a7%80%e0%a7%9f%e0%a6%a4%e0%a6%be%e0%a6%ac%e0%a6%be%e0%a6%a6%e0%a7%80-%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a6%ae%e0%a6%bf%e0%a6%95-4/</guid>
      <pubDate>Mon, 09 Nov 2026 05:17:15 +0000</pubDate>
      <description>মহান জাতীয় বিপ্লব ও সংহতি দিবসে ঐতিহাসিক বিপ্লব উদ্যানে বিদ্রোহ বেদিতে শহীদ প্রেসিডেন্ট জিয়াউর রহমানের প্রতি চসিক জাতীয়তাবাদী শ্রমিক&amp;#8211; কর্মচারী ইউনিয়ন সিবিএ (রেজিঃ নং চট্ট&amp;#8211;২১)এর নেতৃবৃন্দ চট্টগ্রাম সিটি কর্পোরেশনের প্রশাসক ডা. শাহাদাত হোসেনের নেতৃত্বে ফুলেল শ্রদ্ধা নিবেদন করেন। এসময় উপস্থ</description>
      <source url="https://dainikazadi.net/%e0%a6%9a%e0%a6%b8%e0%a6%bf%e0%a6%95-%e0%a6%9c%e0%a6%be%e0%a6%a4%e0%a7%80%e0%a7%9f%e0%a6%a4%e0%a6%be%e0%a6%ac%e0%a6%be%e0%a6%a6%e0%a7%80-%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a6%ae%e0%a6%bf%e0%a6%95-4/">দৈনিক আজাদী</source>
    </item>
    <item>
      <title>পলোগ্রাউন্ড বহুমুখী উচ্চ বিদ্যালয়ে আলোচনা সভা</title>
      <link>https://dainikazadi.net/%e0%a6%aa%e0%a6%b2%e0%a7%8b%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%89%e0%a6%a8%e0%a7%8d%e0%a6%a1-%e0%a6%ac%e0%a6%b9%e0%a7%81%e0%a6%ae%e0%a7%81%e0%a6%96%e0%a7%80-%e0%a6%89%e0%a6%9a%e0%a7%8d-2/</link>
      <guid isPermaLink="true">https://dainikazadi.net/%e0%a6%aa%e0%a6%b2%e0%a7%8b%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%89%e0%a6%a8%e0%a7%8d%e0%a6%a1-%e0%a6%ac%e0%a6%b9%e0%a7%81%e0%a6%ae%e0%a7%81%e0%a6%96%e0%a7%80-%e0%a6%89%e0%a6%9a%e0%a7%8d-2/</guid>
      <pubDate>Mon, 09 Nov 2026 05:16:52 +0000</pubDate>
      <description>নগরের পলোগ্রাউন্ড বহুমুখী উচ্চ বিদ্যালয়ে গত ৭ নভেম্বর জাতীয় বিপ্লব ও সংহতি দিবস পালিত হয়েছে। কর্মসূচিতে ছিল জাতীয় পতাকা উত্তোলন, রচনা প্রতিযোগিতা, আলোচনা সভা ও পুরস্কার বিতরণ। আলোচনা সভায় সভাপতিত্ব করেন প্রধান শিক্ষক মোহাম্মদ জানে আলম। শিক্ষক চুমকি দত্তের সঞ্চালনায় এতে বক্তব্য দেন ভারপ্রাপ্ত সহকারী </description>
      <source url="https://dainikazadi.net/%e0%a6%aa%e0%a6%b2%e0%a7%8b%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%89%e0%a6%a8%e0%a7%8d%e0%a6%a1-%e0%a6%ac%e0%a6%b9%e0%a7%81%e0%a6%ae%e0%a7%81%e0%a6%96%e0%a7%80-%e0%a6%89%e0%a6%9a%e0%a7%8d-2/">দৈনিক আজাদী</source>
    </item>
    <item>
      <title>নৈতিক ও মানবিক বোধ সম্পন্ন প্রজন্মই স্বপ্নের দেশ গড়বে</title>
      <link>https://dainikazadi.net/%e0%a6%a8%e0%a7%88%e0%a6%a4%e0%a6%bf%e0%a6%95-%e0%a6%93-%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a6%ac%e0%a6%bf%e0%a6%95-%e0%a6%ac%e0%a7%8b%e0%a6%a7-%e0%a6%b8%e0%a6%ae%e0%a7%8d%e0%a6%aa%e0%a6%a8%e0%a7%8d/</link>
      <guid isPermaLink="true">https://dainikazadi.net/%e0%a6%a8%e0%a7%88%e0%a6%a4%e0%a6%bf%e0%a6%95-%e0%a6%93-%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a6%ac%e0%a6%bf%e0%a6%95-%e0%a6%ac%e0%a7%8b%e0%a6%a7-%e0%a6%b8%e0%a6%ae%e0%a7%8d%e0%a6%aa%e0%a6%a8%e0%a7%8d/</guid>
      <pubDate>Mon, 09 Nov 2026 05:16:21 +0000</pubDate>
      <description>চট্টগ্রামে ধর্মীয় মূল্যবোধ, নৈতিক শিক্ষা ও দ্বীনি শিক্ষার প্রসারে এস এ ফ্যামিলির অন্তর্ভুক্ত আল হামিম ইনস্টিটিউট, আন&amp;#8211;নিসা একাডেমি ও তাওহিদুল উম্মাহ মাদরাসার উদ্যোগে বার্ষিক সভা ও দোয়া মাহফিল অনুষ্ঠিত হয়েছে। এস এ ফ্যামিলির চেয়ারম্যান মোহাম্মদ শাহ আলমের সভাপতিত্বে অনুষ্ঠিত বার্ষিক সভা ও দোয়া মাহ</description>
      <source url="https://dainikazadi.net/%e0%a6%a8%e0%a7%88%e0%a6%a4%e0%a6%bf%e0%a6%95-%e0%a6%93-%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a6%ac%e0%a6%bf%e0%a6%95-%e0%a6%ac%e0%a7%8b%e0%a6%a7-%e0%a6%b8%e0%a6%ae%e0%a7%8d%e0%a6%aa%e0%a6%a8%e0%a7%8d/">দৈনিক আজাদী</source>
    </item>
    <item>
      <title>দেশ গঠনে জিয়ার দর্শন সর্বদা সময়োপযোগী</title>
      <link>https://dainikazadi.net/%e0%a6%a6%e0%a7%87%e0%a6%b6-%e0%a6%97%e0%a6%a0%e0%a6%a8%e0%a7%87-%e0%a6%9c%e0%a6%bf%e0%a7%9f%e0%a6%be%e0%a6%b0-%e0%a6%a6%e0%a6%b0%e0%a7%8d%e0%a6%b6%e0%a6%a8-%e0%a6%b8%e0%a6%b0%e0%a7%8d%e0%a6%ac/</link>
      <guid isPermaLink="true">https://dainikazadi.net/%e0%a6%a6%e0%a7%87%e0%a6%b6-%e0%a6%97%e0%a6%a0%e0%a6%a8%e0%a7%87-%e0%a6%9c%e0%a6%bf%e0%a7%9f%e0%a6%be%e0%a6%b0-%e0%a6%a6%e0%a6%b0%e0%a7%8d%e0%a6%b6%e0%a6%a8-%e0%a6%b8%e0%a6%b0%e0%a7%8d%e0%a6%ac/</guid>
      <pubDate>Mon, 09 Nov 2026 05:15:45 +0000</pubDate>
      <description>বিএনপি চেয়ারম্যানের উপদেষ্টা ও সাবেক যুগ্ম&amp;#8211;মহানচিব মোহাম্মদ আসলাম চৌধুরী বলেছেন, ৭ নভেম্বর বাংলাদেশের ইতিহাসে এক গুরুত্বপূর্ণ অধ্যায়। জাতিকে ঐক্যবদ্ধ করে স্বাধীনতার চেতনা ও জাতীয় সংহতির প্রতীক হিসেবে এ দিবসের গুরুত্ব অনস্বীকার্য। ৭ নভেম্বরের বিপ্লব আমাদের অনুপ্রেরণা। এদিনে আমরা পরাধীনতার শৃঙ্খ</description>
      <source url="https://dainikazadi.net/%e0%a6%a6%e0%a7%87%e0%a6%b6-%e0%a6%97%e0%a6%a0%e0%a6%a8%e0%a7%87-%e0%a6%9c%e0%a6%bf%e0%a7%9f%e0%a6%be%e0%a6%b0-%e0%a6%a6%e0%a6%b0%e0%a7%8d%e0%a6%b6%e0%a6%a8-%e0%a6%b8%e0%a6%b0%e0%a7%8d%e0%a6%ac/">দৈনিক আজাদী</source>
    </item>
    <item>
      <title>রোটারি ক্লাব অব চিটাগং খুলশী সেন্ট্রালের সভা</title>
      <link>https://dainikazadi.net/%e0%a6%b0%e0%a7%8b%e0%a6%9f%e0%a6%be%e0%a6%b0%e0%a6%bf-%e0%a6%95%e0%a7%8d%e0%a6%b2%e0%a6%be%e0%a6%ac-%e0%a6%85%e0%a6%ac-%e0%a6%9a%e0%a6%bf%e0%a6%9f%e0%a6%be%e0%a6%97%e0%a6%82-%e0%a6%96%e0%a7%81-3/</link>
      <guid isPermaLink="true">https://dainikazadi.net/%e0%a6%b0%e0%a7%8b%e0%a6%9f%e0%a6%be%e0%a6%b0%e0%a6%bf-%e0%a6%95%e0%a7%8d%e0%a6%b2%e0%a6%be%e0%a6%ac-%e0%a6%85%e0%a6%ac-%e0%a6%9a%e0%a6%bf%e0%a6%9f%e0%a6%be%e0%a6%97%e0%a6%82-%e0%a6%96%e0%a7%81-3/</guid>
      <pubDate>Mon, 09 Nov 2026 05:15:21 +0000</pubDate>
      <description>রোটারি ক্লাব অব চিটাগং খুলশী সেন্ট্রালের ৭১তম নিয়মিত সভা গত বুধবার চট্টগ্রাম ক্লাবের কনফারেন্স হলে অনুষ্ঠিত হয়। ক্লাবের ভাইস প্রেসিডেন্ট রোটারিয়ান আহমেদ জামাল নাসের চৌধুরীর সভাপতিত্বে সভায় উপস্থিত ছিলেন রোটারিয়ান সৈয়দ মো. আজিজ নাজিম উদ্দিন, ড. ইঞ্জিনিয়ার সুদীপ কুমার পাল, রাটারিয়ান মোহাম্মদ মহিউদ্দিন</description>
      <source url="https://dainikazadi.net/%e0%a6%b0%e0%a7%8b%e0%a6%9f%e0%a6%be%e0%a6%b0%e0%a6%bf-%e0%a6%95%e0%a7%8d%e0%a6%b2%e0%a6%be%e0%a6%ac-%e0%a6%85%e0%a6%ac-%e0%a6%9a%e0%a6%bf%e0%a6%9f%e0%a6%be%e0%a6%97%e0%a6%82-%e0%a6%96%e0%a7%81-3/">দৈনিক আজাদী</source>
    </item>
    <item>
      <title>সার্ক মানবাধিকার ফাউন্ডেশন চট্টগ্রাম জেলা আঞ্চলিক কমিটির পরিচিতি সভা</title>
      <link>https://dainikazadi.net/%e0%a6%b8%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%95-%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a6%ac%e0%a6%be%e0%a6%a7%e0%a6%bf%e0%a6%95%e0%a6%be%e0%a6%b0-%e0%a6%ab%e0%a6%be%e0%a6%89%e0%a6%a8%e0%a7%8d%e0%a6%a1-22/</link>
      <guid isPermaLink="true">https://dainikazadi.net/%e0%a6%b8%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%95-%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a6%ac%e0%a6%be%e0%a6%a7%e0%a6%bf%e0%a6%95%e0%a6%be%e0%a6%b0-%e0%a6%ab%e0%a6%be%e0%a6%89%e0%a6%a8%e0%a7%8d%e0%a6%a1-22/</guid>
      <pubDate>Mon, 09 Nov 2026 05:14:55 +0000</pubDate>
      <description>মানবাধিকার সংগঠন সার্ক মানবাধিকার ফাউন্ডেশনের ২০২৬&amp;#8211;২০২৮ বর্ষের চট্টগ্রাম জেলা আঞ্চলিক কমিটির পরিচিতি সভা ও অভিষেক অনুষ্ঠানের প্রস্তুতি সভা গত ৫ নভেম্বর জিইসি মোড়স্থ একটি রেস্টুরেন্টে অনুষ্ঠিত হয়। ফাউন্ডেশনের সভাপতি লায়ন ইঞ্জিনিয়ার চন্দন দাশের সভাপতিত্বে ও সাধারন সম্পাদক অ্যাড. শুভাশীষ চৌধুরীর </description>
      <source url="https://dainikazadi.net/%e0%a6%b8%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%95-%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a6%ac%e0%a6%be%e0%a6%a7%e0%a6%bf%e0%a6%95%e0%a6%be%e0%a6%b0-%e0%a6%ab%e0%a6%be%e0%a6%89%e0%a6%a8%e0%a7%8d%e0%a6%a1-22/">দৈনিক আজাদী</source>
    </item>
    <item>
      <title>বাঁশখালীতে আগুনে পুড়েছে ৬ বসতঘর</title>
      <link>https://dainikazadi.net/%e0%a6%ac%e0%a6%be%e0%a6%81%e0%a6%b6%e0%a6%96%e0%a6%be%e0%a6%b2%e0%a7%80%e0%a6%a4%e0%a7%87-%e0%a6%86%e0%a6%97%e0%a7%81%e0%a6%a8%e0%a7%87-%e0%a6%aa%e0%a7%81%e0%a7%9c%e0%a7%87%e0%a6%9b%e0%a7%87-5/</link>
      <guid isPermaLink="true">https://dainikazadi.net/%e0%a6%ac%e0%a6%be%e0%a6%81%e0%a6%b6%e0%a6%96%e0%a6%be%e0%a6%b2%e0%a7%80%e0%a6%a4%e0%a7%87-%e0%a6%86%e0%a6%97%e0%a7%81%e0%a6%a8%e0%a7%87-%e0%a6%aa%e0%a7%81%e0%a7%9c%e0%a7%87%e0%a6%9b%e0%a7%87-5/</guid>
      <pubDate>Mon, 09 Nov 2026 05:14:34 +0000</pubDate>
      <description>বাঁশখালী উপজেলায় পৃথক অগ্নিকাণ্ডে ছয়টি বসতঘর পুড়ে ছাই হয়ে গেছে। গতকাল রোববার গন্ডামারা ও সরল ইউনিয়নে এসব অগ্নিকাণ্ডের ঘটনা ঘটে। স্থানীয় সূত্রে জানা গেছে, রোববার ভোর ভোরে উপজেলার গন্ডামারা ইউনিয়নের ৮ নম্বর ওয়ার্ডের পূর্ব বড়ঘোনা এলাকার আমির হামজা বাপের বাড়িতে অগ্নিকাণ্ডের ঘটনা ঘটে। আগুন দ্রুত ছড়িয়ে পড়</description>
      <source url="https://dainikazadi.net/%e0%a6%ac%e0%a6%be%e0%a6%81%e0%a6%b6%e0%a6%96%e0%a6%be%e0%a6%b2%e0%a7%80%e0%a6%a4%e0%a7%87-%e0%a6%86%e0%a6%97%e0%a7%81%e0%a6%a8%e0%a7%87-%e0%a6%aa%e0%a7%81%e0%a7%9c%e0%a7%87%e0%a6%9b%e0%a7%87-5/">দৈনিক আজাদী</source>
    </item>
    <item>
      <title>মিশরে দুই ট্রেনের সংঘর্ষে নিহত ৪, আহত ৮৮</title>
      <link>https://dainikazadi.net/%e0%a6%ae%e0%a6%bf%e0%a6%b6%e0%a6%b0%e0%a7%87-%e0%a6%a6%e0%a7%81%e0%a6%87-%e0%a6%9f%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%82%e0%a6%98%e0%a6%b0%e0%a7%8d%e0%a6%b7/</link>

    <item>
      <title>যুক্তরাষ্ট্রে চার ঘণ্টা উড়েনি উড়োজাহাজ, আটকা পড়েন হাজার হাজার যাত্রী</title>
      <link>https://dainikazadi.net/%e0%a6%af%e0%a7%81%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%b0%e0%a6%be%e0%a6%b7%e0%a7%8d%e0%a6%9f%e0%a7%8d%e0%a6%b0%e0%a7%87-%e0%a6%9a%e0%a6%be%e0%a6%b0-%e0%a6%98%e0%a6%a3%e0%a7%8d%e0%a6%9f%e0%a6%be/</link>

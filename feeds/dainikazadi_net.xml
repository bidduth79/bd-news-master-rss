    <item>
      <title>ওসমান ফারুকের পদত্যাগ, শূন্য হওয়া আসনে ৯০ দিনের মধ্যে ভোট</title>
      <link>https://dainikazadi.net/%e0%a6%93%e0%a6%b8%e0%a6%ae%e0%a6%be%e0%a6%a8-%e0%a6%ab%e0%a6%be%e0%a6%b0%e0%a7%81%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a6%a6%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%97-%e0%a6%b6%e0%a7%82/</link>

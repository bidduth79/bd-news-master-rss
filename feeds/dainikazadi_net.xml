    <item>
      <title>কেলেঙ্কারির জেরে এনভিডিয়া সিইও জেনসেন হুয়াংয়ের পদত্যাগ</title>
      <link>https://dainikazadi.net/%e0%a6%95%e0%a7%87%e0%a6%b2%e0%a7%87%e0%a6%99%e0%a7%8d%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%bf%e0%a6%b0-%e0%a6%9c%e0%a7%87%e0%a6%b0%e0%a7%87-%e0%a6%8f%e0%a6%a8%e0%a6%ad%e0%a6%bf%e0%a6%a1%e0%a6%bf%e0%a7%9f/</link>
      <guid isPermaLink="true">https://dainikazadi.net/%e0%a6%95%e0%a7%87%e0%a6%b2%e0%a7%87%e0%a6%99%e0%a7%8d%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%bf%e0%a6%b0-%e0%a6%9c%e0%a7%87%e0%a6%b0%e0%a7%87-%e0%a6%8f%e0%a6%a8%e0%a6%ad%e0%a6%bf%e0%a6%a1%e0%a6%bf%e0%a7%9f/</guid>
      <pubDate>Fri, 13 Nov 2026 00:28:48 +0000</pubDate>
      <description>চীনা গুপ্তচর হিসেবে সন্দেহভাজন এক ব্যবসায়ী নারীর সঙ্গে সম্পর্কের জেরে চিপ জায়ান্ট এনভিডিয়ার প্রধান নির্বাহীর পদ ছাড়তে বাধ্য হলেন কোম্পানির সহ প্রতিষ্ঠাতা জেনসেন হুয়াং, কৃত্রিম বুদ্ধিমত্তা (এআই) প্রযুক্তির প্রসারে যার গুরুত্বপূর্ণ অবদান রয়েছে। আন্তর্জাতিক সংবাদমাধ্যমগুলো বলছে, গত কয়েক দিন ধরে নানা আল</description>
      <source url="https://dainikazadi.net/%e0%a6%95%e0%a7%87%e0%a6%b2%e0%a7%87%e0%a6%99%e0%a7%8d%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%bf%e0%a6%b0-%e0%a6%9c%e0%a7%87%e0%a6%b0%e0%a7%87-%e0%a6%8f%e0%a6%a8%e0%a6%ad%e0%a6%bf%e0%a6%a1%e0%a6%bf%e0%a7%9f/">দৈনিক আজাদী</source>
    </item>
    <item>
      <title>মহাকাশে প্রথম ‘উধাও’ গ্রহের সন্ধান, নেপথ্যে প্রতিবেশীর কারসাজি</title>
      <link>https://dainikazadi.net/%e0%a6%ae%e0%a6%b9%e0%a6%be%e0%a6%95%e0%a6%be%e0%a6%b6%e0%a7%87-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a5%e0%a6%ae-%e0%a6%89%e0%a6%a7%e0%a6%be%e0%a6%93-%e0%a6%97%e0%a7%8d%e0%a6%b0/</link>
      <guid isPermaLink="true">https://dainikazadi.net/%e0%a6%ae%e0%a6%b9%e0%a6%be%e0%a6%95%e0%a6%be%e0%a6%b6%e0%a7%87-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a5%e0%a6%ae-%e0%a6%89%e0%a6%a7%e0%a6%be%e0%a6%93-%e0%a6%97%e0%a7%8d%e0%a6%b0/</guid>
      <pubDate>Fri, 13 Nov 2026 00:28:30 +0000</pubDate>
      <description>জ্যোতির্বিজ্ঞানীরা নতুন এক গ্রহের খোঁজ পেয়েছেন, যাকে তারা মহাকাশের ইতিহাসে প্রথম ‘উধাও হয়ে যাওয়া’ বা ‘গায়েব হওয়া’ গ্রহ বলে ধারণা করছেন। দূরবর্তী ওই গ্রহটির নাম ‘টিওআই&amp;#8211;২৫৩৫ বি’। এটা ‘হট জুপিটার’ বা উত্তপ্ত বৃহস্পতির মতো বড় এক গ্রহ, যেখানে একটি পুরো বছর হতে সময় লাগে সোয়া আট দিন। খবর বিডিনিউজের। </description>
      <source url="https://dainikazadi.net/%e0%a6%ae%e0%a6%b9%e0%a6%be%e0%a6%95%e0%a6%be%e0%a6%b6%e0%a7%87-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a5%e0%a6%ae-%e0%a6%89%e0%a6%a7%e0%a6%be%e0%a6%93-%e0%a6%97%e0%a7%8d%e0%a6%b0/">দৈনিক আজাদী</source>
    </item>
    <item>
      <title>ইতিহাস থামানো যাবে না, তাইওয়ানকে এক হতেই হবে : শি জিনপিং</title>
      <link>https://dainikazadi.net/%e0%a6%87%e0%a6%a4%e0%a6%bf%e0%a6%b9%e0%a6%be%e0%a6%b8-%e0%a6%a5%e0%a6%be%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a7%8b-%e0%a6%af%e0%a6%be%e0%a6%ac%e0%a7%87-%e0%a6%a8%e0%a6%be-%e0%a6%a4%e0%a6%be%e0%a6%87/</link>
      <guid isPermaLink="true">https://dainikazadi.net/%e0%a6%87%e0%a6%a4%e0%a6%bf%e0%a6%b9%e0%a6%be%e0%a6%b8-%e0%a6%a5%e0%a6%be%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a7%8b-%e0%a6%af%e0%a6%be%e0%a6%ac%e0%a7%87-%e0%a6%a8%e0%a6%be-%e0%a6%a4%e0%a6%be%e0%a6%87/</guid>
      <pubDate>Fri, 13 Nov 2026 00:28:11 +0000</pubDate>
      <description>‘ইতিহাসের স্রোত থামানো যাবে না’ মন্তব্য করে তাইওয়ানের সঙ্গে শান্তিপূর্ণ ‘পুনরেকত্রীকরণের’ আহ্বান জানিয়েছেন চীনের প্রেসিডেন্ট শি জিনপিং। গতকাল বৃহস্পতিবার দেওয়া এক ভাষণে তিনি বলপ্রয়োগের কোনও উল্লেখ না করলেও তাইপের পক্ষ থেকে তার এই বক্তব্য দৃঢ়ভাবে প্রত্যাখ্যান করা হয়েছে। গণতান্ত্রিকভাবে শাসিত তাইওয়ানক</description>
      <source url="https://dainikazadi.net/%e0%a6%87%e0%a6%a4%e0%a6%bf%e0%a6%b9%e0%a6%be%e0%a6%b8-%e0%a6%a5%e0%a6%be%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a7%8b-%e0%a6%af%e0%a6%be%e0%a6%ac%e0%a7%87-%e0%a6%a8%e0%a6%be-%e0%a6%a4%e0%a6%be%e0%a6%87/">দৈনিক আজাদী</source>
    </item>
    <item>
      <title>কারাগার থেকে মুক্তি পেলেন ইমরান খানের দুই বোন</title>
      <link>https://dainikazadi.net/%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%be%e0%a6%97%e0%a6%be%e0%a6%b0-%e0%a6%a5%e0%a7%87%e0%a6%95%e0%a7%87-%e0%a6%ae%e0%a7%81%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%bf-%e0%a6%aa%e0%a7%87%e0%a6%b2%e0%a7%87-2/</link>
      <guid isPermaLink="true">https://dainikazadi.net/%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%be%e0%a6%97%e0%a6%be%e0%a6%b0-%e0%a6%a5%e0%a7%87%e0%a6%95%e0%a7%87-%e0%a6%ae%e0%a7%81%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%bf-%e0%a6%aa%e0%a7%87%e0%a6%b2%e0%a7%87-2/</guid>
      <pubDate>Fri, 13 Nov 2026 00:27:49 +0000</pubDate>
      <description>পাকিস্তানের সাবেক প্রধানমন্ত্রী ইমরান খানের দুই বোনকে কারাগার থেকে মুক্তি দেওয়া হয়েছে। গতকাল বৃহস্পতিবার তাদের মুক্তি দেওয়া হয় বলে জানিয়েছেন তাদের আইনজীবী। ইমরান খানের দলের পূর্বপরিকল্পিত একটি সরকারবিরোধী পদযাত্রার আগে তাদের আটক করা হয়েছিল। কয়েক সপ্তাহ আটক থাকার পর তারা মুক্তি পেলেন। খবর বিডিনিউজের।</description>
      <source url="https://dainikazadi.net/%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%be%e0%a6%97%e0%a6%be%e0%a6%b0-%e0%a6%a5%e0%a7%87%e0%a6%95%e0%a7%87-%e0%a6%ae%e0%a7%81%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%bf-%e0%a6%aa%e0%a7%87%e0%a6%b2%e0%a7%87-2/">দৈনিক আজাদী</source>
    </item>
    <item>
      <title>সিএসইতে লেনদেন ১৯.২৬ কোটি টাকা</title>
      <link>https://dainikazadi.net/%e0%a6%b8%e0%a6%bf%e0%a6%8f%e0%a6%b8%e0%a6%87%e0%a6%a4%e0%a7%87-%e0%a6%b2%e0%a7%87%e0%a6%a8%e0%a6%a6%e0%a7%87%e0%a6%a8-%e0%a7%a7%e0%a7%af-%e0%a7%a8%e0%a7%ac-%e0%a6%95%e0%a7%8b%e0%a6%9f%e0%a6%bf/</link>
      <guid isPermaLink="true">https://dainikazadi.net/%e0%a6%b8%e0%a6%bf%e0%a6%8f%e0%a6%b8%e0%a6%87%e0%a6%a4%e0%a7%87-%e0%a6%b2%e0%a7%87%e0%a6%a8%e0%a6%a6%e0%a7%87%e0%a6%a8-%e0%a7%a7%e0%a7%af-%e0%a7%a8%e0%a7%ac-%e0%a6%95%e0%a7%8b%e0%a6%9f%e0%a6%bf/</guid>
      <pubDate>Fri, 13 Nov 2026 00:27:22 +0000</pubDate>
      <description>চিটাগং স্টক এক্সচেঞ্জ পিএলসিতে গতকাল বৃহস্পতিবার লেনদেন হয়েছ ১৯.৪২ কোটি টাকা। মোট ১,৩৪৪ টি লেনদেনের মাধ্যমে মোট ৪২.৭৮ লাখ শেয়ার হাতবদল হয়েছে। গতকাল প্রধান ইনডেক্স সিএসই সার্বিক শেয়ার মূল্যসূচক আগের দিনের চাইতে ৩৫.৫৭ পয়েন্ট বেড়েছে, যা হলো ১৪,৫৬১.৯৮ পয়েন্ট এবং সিএসই&amp;#8211;৫০ মূল্যসূচক ২.৪৭ পয়েন্ট কমেছ</description>
      <source url="https://dainikazadi.net/%e0%a6%b8%e0%a6%bf%e0%a6%8f%e0%a6%b8%e0%a6%87%e0%a6%a4%e0%a7%87-%e0%a6%b2%e0%a7%87%e0%a6%a8%e0%a6%a6%e0%a7%87%e0%a6%a8-%e0%a7%a7%e0%a7%af-%e0%a7%a8%e0%a7%ac-%e0%a6%95%e0%a7%8b%e0%a6%9f%e0%a6%bf/">দৈনিক আজাদী</source>
    </item>
    <item>
      <title>জোসেফ হাওয়াইয়ান গিটার পরিষদের সুরের ইন্দ্রধনু</title>
      <link>https://dainikazadi.net/%e0%a6%9c%e0%a7%8b%e0%a6%b8%e0%a7%87%e0%a6%ab-%e0%a6%b9%e0%a6%be%e0%a6%93%e0%a7%9f%e0%a6%be%e0%a6%87%e0%a7%9f%e0%a6%be%e0%a6%a8-%e0%a6%97%e0%a6%bf%e0%a6%9f%e0%a6%be%e0%a6%b0-%e0%a6%aa%e0%a6%b0/</link>
      <guid isPermaLink="true">https://dainikazadi.net/%e0%a6%9c%e0%a7%8b%e0%a6%b8%e0%a7%87%e0%a6%ab-%e0%a6%b9%e0%a6%be%e0%a6%93%e0%a7%9f%e0%a6%be%e0%a6%87%e0%a7%9f%e0%a6%be%e0%a6%a8-%e0%a6%97%e0%a6%bf%e0%a6%9f%e0%a6%be%e0%a6%b0-%e0%a6%aa%e0%a6%b0/</guid>
      <pubDate>Fri, 13 Nov 2026 00:26:42 +0000</pubDate>
      <description>জোসেফ হাওয়াইয়ান গিটার পরিষদ, চট্টগ্রামের ৪২ তম প্রতিষ্ঠাবার্ষিকী উপলক্ষে সুরের ইদ্রধনু শীর্ষক গিটার সন্ধ্যা গত ৬ নভেম্বর নগরীর থিয়েটার ইনস্টিটিউট মিলনায়তনে অনুষ্ঠিত হয়। উপস্থিত ছিলেন লায়ন জি, কে লালা, লে. কর্নেল আমির আরিফ, ড. রঞ্জিত কুমার চৌধুরী, প্রফেসর মাইনুল আহসান চৌধুরী। গিটার সন্ধ্যায় অংশগ্রহণ </description>
      <source url="https://dainikazadi.net/%e0%a6%9c%e0%a7%8b%e0%a6%b8%e0%a7%87%e0%a6%ab-%e0%a6%b9%e0%a6%be%e0%a6%93%e0%a7%9f%e0%a6%be%e0%a6%87%e0%a7%9f%e0%a6%be%e0%a6%a8-%e0%a6%97%e0%a6%bf%e0%a6%9f%e0%a6%be%e0%a6%b0-%e0%a6%aa%e0%a6%b0/">দৈনিক আজাদী</source>
    </item>
    <item>
      <title>লাইফ সাপোর্টে ‘রোকযানা’ গানের শিল্পী সাহেদ</title>
      <link>https://dainikazadi.net/%e0%a6%b2%e0%a6%be%e0%a6%87%e0%a6%ab-%e0%a6%b8%e0%a6%be%e0%a6%aa%e0%a7%8b%e0%a6%b0%e0%a7%8d%e0%a6%9f%e0%a7%87-%e0%a6%b0%e0%a7%8b%e0%a6%95%e0%a6%af%e0%a6%be%e0%a6%a8%e0%a6%be/</link>
      <guid isPermaLink="true">https://dainikazadi.net/%e0%a6%b2%e0%a6%be%e0%a6%87%e0%a6%ab-%e0%a6%b8%e0%a6%be%e0%a6%aa%e0%a7%8b%e0%a6%b0%e0%a7%8d%e0%a6%9f%e0%a7%87-%e0%a6%b0%e0%a7%8b%e0%a6%95%e0%a6%af%e0%a6%be%e0%a6%a8%e0%a6%be/</guid>
      <pubDate>Fri, 13 Nov 2026 00:26:11 +0000</pubDate>
      <description>‘রোকযানা’ গানের শিল্পী শেখ সাহেদ আলীর শারীরিক অবস্থার অবনতি হয়েছে। গুরুতর রক্তক্ষরণসহ একাধিক জটিলতা দেখা দেওয়ায় গতকাল বৃহস্পতিবার লাইফ সাপোর্টে নেওয়া হয়েছে তাকে। রাজধানীর একটি বেসরকারি হাসপাতালের নিবিড় পরিচর্যা কেন্দ্রে (আইসিইউ) চিকিৎসাধীন রয়েছেন এই শিল্পী। তার বন্ধু ও গণমাধ্যমকর্মী এরশাদুল হক খবরটি</description>
      <source url="https://dainikazadi.net/%e0%a6%b2%e0%a6%be%e0%a6%87%e0%a6%ab-%e0%a6%b8%e0%a6%be%e0%a6%aa%e0%a7%8b%e0%a6%b0%e0%a7%8d%e0%a6%9f%e0%a7%87-%e0%a6%b0%e0%a7%8b%e0%a6%95%e0%a6%af%e0%a6%be%e0%a6%a8%e0%a6%be/">দৈনিক আজাদী</source>
    </item>
    <item>
      <title>সেমিফাইনালে পাকিস্তানকে নিয়ে সতর্ক জামাল ভূঁইয়া</title>
      <link>https://dainikazadi.net/%e0%a6%b8%e0%a7%87%e0%a6%ae%e0%a6%bf%e0%a6%ab%e0%a6%be%e0%a6%87%e0%a6%a8%e0%a6%be%e0%a6%b2%e0%a7%87-%e0%a6%aa%e0%a6%be%e0%a6%95%e0%a6%bf%e0%a6%b8%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%a8%e0%a6%95%e0%a7%87/</link>
      <guid isPermaLink="true">https://dainikazadi.net/%e0%a6%b8%e0%a7%87%e0%a6%ae%e0%a6%bf%e0%a6%ab%e0%a6%be%e0%a6%87%e0%a6%a8%e0%a6%be%e0%a6%b2%e0%a7%87-%e0%a6%aa%e0%a6%be%e0%a6%95%e0%a6%bf%e0%a6%b8%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%a8%e0%a6%95%e0%a7%87/</guid>
      <pubDate>Fri, 13 Nov 2026 00:25:42 +0000</pubDate>
      <description>পাকিস্তানের বিপক্ষে সেমি&amp;#8211;ফাইনাল নিয়ে সতর্ক জামাল ভূঁইয়া। এই ডিফেন্সিভ মিডফিল্ডারের মনে হচ্ছে, শ্রীলঙ্কা ম্যাচের চেয়ে আরও বেশি চ্যালেঞ্জের মুখোমুখি তাদের হতে হবে সেমি&amp;#8211;ফাইনালে। ফাইনালে ওঠার লড়াইয়ে জাতীয় স্টেডিয়ামে শনিবার পাকিস্তানের বিপক্ষে খেলবে বাংলাদেশ। সাফ চ্যাম্পিয়নশিপে আজও শিরোপা স্ব</description>
      <source url="https://dainikazadi.net/%e0%a6%b8%e0%a7%87%e0%a6%ae%e0%a6%bf%e0%a6%ab%e0%a6%be%e0%a6%87%e0%a6%a8%e0%a6%be%e0%a6%b2%e0%a7%87-%e0%a6%aa%e0%a6%be%e0%a6%95%e0%a6%bf%e0%a6%b8%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%a8%e0%a6%95%e0%a7%87/">দৈনিক আজাদী</source>
    </item>
    <item>
      <title>ঋতুপর্ণাদের বাটলারের ছকেই রাখতে চান নতুন কোচ এরিক</title>
      <link>https://dainikazadi.net/%e0%a6%8b%e0%a6%a4%e0%a7%81%e0%a6%aa%e0%a6%b0%e0%a7%8d%e0%a6%a3%e0%a6%be%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%ac%e0%a6%be%e0%a6%9f%e0%a6%b2%e0%a6%be%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%9b%e0%a6%95%e0%a7%87/</link>
      <guid isPermaLink="true">https://dainikazadi.net/%e0%a6%8b%e0%a6%a4%e0%a7%81%e0%a6%aa%e0%a6%b0%e0%a7%8d%e0%a6%a3%e0%a6%be%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%ac%e0%a6%be%e0%a6%9f%e0%a6%b2%e0%a6%be%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%9b%e0%a6%95%e0%a7%87/</guid>
      <pubDate>Fri, 13 Nov 2026 00:24:40 +0000</pubDate>
      <description>বাংলাদেশ জাতীয় নারী ফুটবল দল আগামী মাসে সিঙ্গাপুরের বিপক্ষে দুটি ফিফা আন্তর্জাতিক প্রীতি ম্যাচ খেলবে। ম্যাচ দুটিকে সামনে রেখে চট্টগ্রামের আনোয়ারায় কোরিয়ান এক্সপোর্ট প্রসেসিং জোনের (কেইপিজেড) সবুজ মাঠে নিবিড় অনুশীলনে ব্যস্ত সময় পার করছেন এখন নারী ফুটবল দলের সদস্যরা। সুরক্ষিত, নিরিবিলি ও মনোরম পরিবেশে</description>
      <source url="https://dainikazadi.net/%e0%a6%8b%e0%a6%a4%e0%a7%81%e0%a6%aa%e0%a6%b0%e0%a7%8d%e0%a6%a3%e0%a6%be%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%ac%e0%a6%be%e0%a6%9f%e0%a6%b2%e0%a6%be%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%9b%e0%a6%95%e0%a7%87/">দৈনিক আজাদী</source>
    </item>
    <item>
      <title>সেমিফাইনালে আইআইইউসি ও সাউদার্ন ইউনিভার্সিটি</title>
      <link>https://dainikazadi.net/%e0%a6%b8%e0%a7%87%e0%a6%ae%e0%a6%bf%e0%a6%ab%e0%a6%be%e0%a6%87%e0%a6%a8%e0%a6%be%e0%a6%b2%e0%a7%87-%e0%a6%86%e0%a6%87%e0%a6%86%e0%a6%87%e0%a6%87%e0%a6%89%e0%a6%b8%e0%a6%bf-%e0%a6%93-%e0%a6%b8/</link>

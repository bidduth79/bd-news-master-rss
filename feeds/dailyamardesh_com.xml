    <item>
      <title>গাজায় ভারী বৃষ্টিতে বিপর্যস্ত ২ লক্ষাধিক মানুষ</title>
      <link>https://www.dailyamardesh.com/world/middle-east/amd1aez3qdwtp</link>
      <guid isPermaLink="true">https://www.dailyamardesh.com/world/middle-east/amd1aez3qdwtp</guid>

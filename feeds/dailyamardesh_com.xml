    <item>
      <title>আইনশৃঙ্খলার অবনতি অব্যাহত থাকলে ছয় মাসের মধ্যে সরকারের পতন হবে: আল মামুন</title>
      <link>https://www.dailyamardesh.com/bangladesh/rangpur/amdtwtj0nr356</link>
      <guid isPermaLink="true">https://www.dailyamardesh.com/bangladesh/rangpur/amdtwtj0nr356</guid>
      <pubDate>Tue, 24 Nov 2026 17:14:04 GMT</pubDate>

    <item>
      <title>গঙ্গাচড়ায় ৭৬ শিক্ষার্থীর কুরআনের ছবক, কৃতি ১১০ জনকে সংবর্ধনা</title>
      <link>https://www.dailyamardesh.com/bangladesh/rangpur/amdqc71m2ivl4</link>
      <guid isPermaLink="true">https://www.dailyamardesh.com/bangladesh/rangpur/amdqc71m2ivl4</guid>
      <pubDate>Sat, 21 Nov 2026 16:58:05 GMT</pubDate>
      <enclosure url="https://images.dailyamardesh.com/original_images/amardesh_quran-2877d2.jpg" length="0" type="image/jpeg" />
      <media:content url="https://images.dailyamardesh.com/original_images/amardesh_quran-2877d2.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://images.dailyamardesh.com/original_images/amardesh_quran-2877d2.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গঙ্গাচড়ায় ৭৬ শিক্ষার্থীর কুরআনের ছবক, কৃতি ১১০ জনকে সংবর্ধনা" /&gt;&lt;/p&gt;&lt;p&gt;রংপুরের গঙ্গাচড়ায় অভিভাবক সমাবেশ, কৃতি শিক্ষার্থীদের সংবর্ধনা ও পবিত্র কুরআনুল কারীমের ছবক প্রদান অনুষ্ঠান অনুষ্ঠিত হয়েছে। এতে ৭৬ জন শিক্ষার্থীকে পবিত্র কুরআনের ছবক দেওয়া হয়। পাশাপাশি বিভিন্ন পরীক্ষায় কৃতিত্ব অর্জনকারী ১১০ জন শিক্ষার্থীকে ক্রেস্ট দিয়ে সংবর্ধিত করা হয়েছে।

শনিবার বিদ্যালয় প
        ব&lt;/p&gt;</description>
      <source url="https://www.dailyamardesh.com/bangladesh/rangpur/amdqc71m2ivl4">আমার দেশ</source>
    </item>
    <item>

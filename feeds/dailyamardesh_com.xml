      <link>https://www.dailyamardesh.com/bangladesh/sylhet/amd5tb0igvjx0</link>
      <guid isPermaLink="true">https://www.dailyamardesh.com/bangladesh/sylhet/amd5tb0igvjx0</guid>
      <pubDate>Thu, 26 Nov 2026 04:27:17 GMT</pubDate>
      <enclosure url="https://images.dailyamardesh.com/original_images/shanthigonj-news-pic-144dd8.jpg" length="0" type="image/jpeg" />

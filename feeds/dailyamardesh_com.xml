    </item>
    <item>
      <title>সুনামগঞ্জের ৯০ কিলোমিটার সীমান্তে বসছে ক্যামেরা, ড্রোন ও সার্চলাইট</title>
      <link>https://www.dailyamardesh.com/bangladesh/sylhet/amdt44xjgaywn</link>
      <guid isPermaLink="true">https://www.dailyamardesh.com/bangladesh/sylhet/amdt44xjgaywn</guid>
      <pubDate>Mon, 16 Nov 2026 08:12:54 GMT</pubDate>
      <enclosure url="https://images.dailyamardesh.com/original_images/shunamgonjnewspic-9a5037.jpg" length="0" type="image/jpeg" />

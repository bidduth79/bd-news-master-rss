    <item>
      <title>চকরিয়ায় বন্য হাতির আক্রমণে প্রাণ গেল বৃদ্ধের</title>
      <link>https://www.dailyamardesh.com/bangladesh/chattogram/amd26efb4ff83</link>
      <guid isPermaLink="true">https://www.dailyamardesh.com/bangladesh/chattogram/amd26efb4ff83</guid>
      <pubDate>Sat, 14 Nov 2026 19:31:30 GMT</pubDate>

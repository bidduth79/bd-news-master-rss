    <item>
      <title>আ.লীগের নৈরাজ্যের প্রতিবাদে পটিয়ায় বিএনপির বিক্ষোভ</title>
      <link>https://www.dailyamardesh.com/bangladesh/chattogram/amdhokihq0tn1</link>
      <guid isPermaLink="true">https://www.dailyamardesh.com/bangladesh/chattogram/amdhokihq0tn1</guid>

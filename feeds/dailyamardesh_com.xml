    <item>
      <title>তিন বছর ধরে অচল, বাড়ছে ভোগান্তি</title>
      <link>https://www.dailyamardesh.com/bangladesh/khulna/amdpsaz0g93s7</link>
      <guid isPermaLink="true">https://www.dailyamardesh.com/bangladesh/khulna/amdpsaz0g93s7</guid>
      <pubDate>Tue, 10 Nov 2026 22:02:28 GMT</pubDate>
      <enclosure url="https://images.dailyamardesh.com/original_images/বেনাপোল-বন্দরে-মোবাইল-স্ক্যানিং-মেশিন-740a83.jpg" length="0" type="image/jpeg" />
      <media:content url="https://images.dailyamardesh.com/original_images/বেনাপোল-বন্দরে-মোবাইল-স্ক্যানিং-মেশিন-740a83.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://images.dailyamardesh.com/original_images/বেনাপোল-বন্দরে-মোবাইল-স্ক্যানিং-মেশিন-740a83.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="তিন বছর ধরে অচল, বাড়ছে ভোগান্তি" /&gt;&lt;/p&gt;&lt;p&gt;দেশের সর্ববৃহৎ স্থলবন্দর বেনাপোলে প্রায় পাঁচ কোটি টাকা ব্যয়ে স্থাপন করা অত্যাধুনিক কনটেইনার মোবাইল স্ক্যানিং মেশিন দীর্ঘ তিন বছর ধরে অচল পড়ে রয়েছে। গুরুত্বপূর্ণ এ প্রযুক্তিনির্ভর যন্ত্রটি বিকল থাকায়, আমদানি করা পণ্যবাহী ট্রাকের ভেতরে থাকা মালামাল পরীক্ষা করতে হচ্ছে প্রচলিত কায়িক পদ্ধ
        ব&lt;/p&gt;</description>
      <source url="https://www.dailyamardesh.com/bangladesh/khulna/amdpsaz0g93s7">আমার দেশ</source>
    </item>

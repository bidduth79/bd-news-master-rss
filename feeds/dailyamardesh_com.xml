    <item>
      <title>বর্জ্য ব্যবস্থাপনায় ব্যর্থ পৌর কর্মকর্তাদের বরখাস্তের হুঁশিয়ারি</title>
      <link>https://www.dailyamardesh.com/national/amdsmm7c77jgi</link>
      <guid isPermaLink="true">https://www.dailyamardesh.com/national/amdsmm7c77jgi</guid>

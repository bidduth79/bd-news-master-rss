    <item>
      <title>ডিসি-এসপির পর এবার গোপালগঞ্জের তিন থানার ওসি বদলি</title>
      <link>https://www.dailyamardesh.com/national/amd1akdcv8qu7</link>
      <guid isPermaLink="true">https://www.dailyamardesh.com/national/amd1akdcv8qu7</guid>
      <pubDate>Sun, 15 Nov 2026 19:08:06 GMT</pubDate>

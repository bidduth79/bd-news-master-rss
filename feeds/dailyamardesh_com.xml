      <link>https://www.dailyamardesh.com/world/middle-east/amdfrsipzczac</link>
      <guid isPermaLink="true">https://www.dailyamardesh.com/world/middle-east/amdfrsipzczac</guid>
      <pubDate>Fri, 20 Nov 2026 17:24:58 GMT</pubDate>
      <enclosure url="https://images.dailyamardesh.com/original_images/news-image-2026-11-20t232444.305-a40248.jpg" length="0" type="image/jpeg" />

    <item>
      <title>আসামে মুসলিমদের ঘরবাড়ি থেকে উচ্ছেদ, গুঁড়িয়ে দেওয়া হলো মসজিদ</title>
      <link>https://www.dailyamardesh.com/world/india/amd7uvu3u7f8q</link>
      <guid isPermaLink="true">https://www.dailyamardesh.com/world/india/amd7uvu3u7f8q</guid>
      <pubDate>Sat, 14 Nov 2026 15:45:16 GMT</pubDate>
      <enclosure url="https://images.dailyamardesh.com/original_images/বুলডোজার-03fb1f.jpg" length="0" type="image/jpeg" />
      <media:content url="https://images.dailyamardesh.com/original_images/বুলডোজার-03fb1f.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://images.dailyamardesh.com/original_images/বুলডোজার-03fb1f.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আসামে মুসলিমদের ঘরবাড়ি থেকে উচ্ছেদ, গুঁড়িয়ে দেওয়া হলো মসজিদ" /&gt;&lt;/p&gt;&lt;p&gt;ভারতের আসাম রাজ্যে ১৯৮৩ সালের সাম্প্রদায়িক সহিংসতায় ঘরবাড়ি হারিয়েছিলেন বেশ কয়েকটি বাঙালি মুসলিম পরিবার। পরে রাজ্য প্রশাসনই তাদের পুনর্বাসনের জন্য জমি বরাদ্দ দিয়েছিল। চার দশকের বেশি সময় ধরে সেখানে বসবাসের পর এবার সেই পরিবারগুলোর ঘরবাড়ি ও একটি মসজিদ বুলডোজার দিয়ে গুঁড়িয়ে দিয়েছে প্রশাসন।
        বিস্তা&lt;/p&gt;</description>
      <source url="https://www.dailyamardesh.com/world/india/amd7uvu3u7f8q">আমার দেশ</source>
    </item>

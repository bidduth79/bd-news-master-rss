      <guid isPermaLink="true">https://www.dailyamardesh.com/world/europe/amdhgyk6dlco8</guid>
      <pubDate>Sun, 08 Nov 2026 16:28:29 GMT</pubDate>
      <enclosure url="https://images.dailyamardesh.com/original_images/নৌকাডুবি-e95303.jpg" length="0" type="image/jpeg" />

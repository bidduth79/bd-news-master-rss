    <item>
      <title>বাসে আগুন ও ককটেল নিক্ষেপ: জড়িতদের দ্রুত আইনের আওতায় আনার দাবি সিটিজেন ইনিশিয়েটিভের</title>
      <link>https://www.dailyamardesh.com/national/amduk1cwmuxfu</link>
      <guid isPermaLink="true">https://www.dailyamardesh.com/national/amduk1cwmuxfu</guid>

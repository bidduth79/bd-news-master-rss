    <item>
      <title>পাগলা মসজিদের রেকর্ড, দানবাক্সে মিলল ১৮ কোটি ২১ লাখ টাকা</title>
      <link>https://www.dailyamardesh.com/bangladesh/dhaka/amdyknmwuelkw</link>
      <guid isPermaLink="true">https://www.dailyamardesh.com/bangladesh/dhaka/amdyknmwuelkw</guid>

    <item>
      <title>পীরগাছায় আনোয়ার হোসেনের রাজনৈতিক পরিচয় নিয়ে বিতর্ক, জামিনে মুক্ত</title>
      <link>https://www.dailyamardesh.com/bangladesh/rangpur/amdbmof85js0g</link>
      <guid isPermaLink="true">https://www.dailyamardesh.com/bangladesh/rangpur/amdbmof85js0g</guid>

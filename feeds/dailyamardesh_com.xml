    <item>
      <title>মক্কা প্রতিরক্ষা চুক্তিতে কোনো আঞ্চলিক শত্রুর নাম নেই</title>
      <link>https://www.dailyamardesh.com/world/middle-east/amd6jfy1o2jrp</link>
      <guid isPermaLink="true">https://www.dailyamardesh.com/world/middle-east/amd6jfy1o2jrp</guid>
      <pubDate>Sat, 21 Nov 2026 08:08:07 GMT</pubDate>
      <enclosure url="https://images.dailyamardesh.com/original_images/Meccapact-dad913.png" length="0" type="image/jpeg" />

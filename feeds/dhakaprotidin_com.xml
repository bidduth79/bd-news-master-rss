    <item>
      <title>কাপ্তাইয়ে বাংলাদেশ স্কাউটসের দিনব্যাপী ডে-ক্যাম্প অনুষ্ঠিত</title>
      <link>https://www.dhakaprotidin.com/%e0%a6%95%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%87%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%a6%e0%a7%87%e0%a6%b6-%e0%a6%b8%e0%a7%8d%e0%a6%95%e0%a6%be/</link>

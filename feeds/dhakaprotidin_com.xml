    <item>
      <title>ফটিকছড়িতে অবৈধভাবে মাটি ও টিলা কাটায় ৫০ হাজার টাকা জরিমানা</title>
      <link>https://www.dhakaprotidin.com/%e0%a6%ab%e0%a6%9f%e0%a6%bf%e0%a6%95%e0%a6%9b%e0%a6%a1%e0%a6%bc%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%85%e0%a6%ac%e0%a7%88%e0%a6%a7%e0%a6%ad%e0%a6%be%e0%a6%ac%e0%a7%87-%e0%a6%ae%e0%a6%be%e0%a6%9f%e0%a6%bf/</link>

    </item>
    <item>
      <title>[Dhaka Protidin] চাঁপাইনবাবগঞ্জ পৌরসভার ৬ নম্বর ওয়ার্ডে ডেঙ্গু প্রতিরোধে মশক নিধন অভিযান</title>
      <link>https://www.dhakaprotidin.com/%e0%a6%9a%e0%a6%be%e0%a6%81%e0%a6%aa%e0%a6%be%e0%a6%87%e0%a6%a8%e0%a6%ac%e0%a6%be%e0%a6%ac%e0%a6%97%e0%a6%9e%e0%a7%8d%e0%a6%9c-%e0%a6%aa%e0%a7%8c%e0%a6%b0%e0%a6%b8%e0%a6%ad%e0%a6%be%e0%a6%b0-%e0%a7%ac/</link>

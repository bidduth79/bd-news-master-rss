    <item>
      <title>পলিথিনের ঝুপড়ি ঘরে বৃদ্ধ দম্পতির বসবাস</title>
      <link>https://www.dhakaprotidin.com/%e0%a6%aa%e0%a6%b2%e0%a6%bf%e0%a6%a5%e0%a6%bf%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%9d%e0%a7%81%e0%a6%aa%e0%a6%a1%e0%a6%bc%e0%a6%bf-%e0%a6%98%e0%a6%b0%e0%a7%87-%e0%a6%ac%e0%a7%83%e0%a6%a6%e0%a7%8d/</link>

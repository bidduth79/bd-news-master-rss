    <item>
      <title>সরিষাবাড়ীতে নানা আয়োজনে ৫৫তম জাতীয় সমবায় দিবস উদযাপিত</title>
      <link>https://www.dhakaprotidin.com/%e0%a6%b8%e0%a6%b0%e0%a6%bf%e0%a6%b7%e0%a6%be%e0%a6%ac%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a7%80%e0%a6%a4%e0%a7%87-%e0%a6%a8%e0%a6%be%e0%a6%a8%e0%a6%be-%e0%a6%86%e0%a6%af%e0%a6%bc%e0%a7%8b%e0%a6%9c%e0%a6%a8/</link>

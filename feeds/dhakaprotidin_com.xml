    <item>
      <title>ফটিকছড়ি উত্তর উপজেলায় সরকারি দুই বাগানের রাবার চুরি ও পাচারের হিড়িক</title>
      <link>https://www.dhakaprotidin.com/%e0%a6%ab%e0%a6%9f%e0%a6%bf%e0%a6%95%e0%a6%9b%e0%a6%a1%e0%a6%bc%e0%a6%bf-%e0%a6%89%e0%a6%a4%e0%a7%8d%e0%a6%a4%e0%a6%b0-%e0%a6%89%e0%a6%aa%e0%a6%9c%e0%a7%87%e0%a6%b2%e0%a6%be%e0%a6%af%e0%a6%bc-4/</link>
      <guid isPermaLink="true">https://www.dhakaprotidin.com/%e0%a6%ab%e0%a6%9f%e0%a6%bf%e0%a6%95%e0%a6%9b%e0%a6%a1%e0%a6%bc%e0%a6%bf-%e0%a6%89%e0%a6%a4%e0%a7%8d%e0%a6%a4%e0%a6%b0-%e0%a6%89%e0%a6%aa%e0%a6%9c%e0%a7%87%e0%a6%b2%e0%a6%be%e0%a6%af%e0%a6%bc-4/</guid>
      <pubDate>Sun, 22 Nov 2026 09:44:18 +0000</pubDate>
      <description>নবগঠিত ফটিকছড়ি উত্তর উপজেলার দাঁতমারা ও তারাখোঁ সরকারি রাবার বাগান থেকে প্রতিনিয়ত রাবার চুরি ও পাচারের হিড়িক দীর্ঘদিন ধরে চলছে। বিভিন্ন সময়ে পুলিশের অভিযানও হয়েছে। আটক হয়েছে রাবার বোঝাই ট্রাক ও কাভার্ডভ্যান। এরপরও বন্ধ হয়নি পাচার। রাজনৈতিক দলের কতিপয় নেতা ও কর্মকর্তাদের যোগসাঁজশে চলছে রাবারের হরিলুট</description>
      <source url="https://www.dhakaprotidin.com/%e0%a6%ab%e0%a6%9f%e0%a6%bf%e0%a6%95%e0%a6%9b%e0%a6%a1%e0%a6%bc%e0%a6%bf-%e0%a6%89%e0%a6%a4%e0%a7%8d%e0%a6%a4%e0%a6%b0-%e0%a6%89%e0%a6%aa%e0%a6%9c%e0%a7%87%e0%a6%b2%e0%a6%be%e0%a6%af%e0%a6%bc-4/">Dhaka Protidin</source>
    </item>
    <item>

    <item>
      <title>সালথা আ’লীগের নতুন কমিটি ঘোষণা, আহ্বায়ক ওয়াদুদ মাতুব্বার</title>
      <link>https://www.dhakaprotidin.com/%e0%a6%b8%e0%a6%be%e0%a6%b2%e0%a6%a5%e0%a6%be-%e0%a6%86%e0%a6%b2%e0%a7%80%e0%a6%97%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%95%e0%a6%ae%e0%a6%bf%e0%a6%9f%e0%a6%bf-%e0%a6%98/</link>

    </item>
    <item>
      <title>ফটিকছড়ি উত্তরে পঞ্চবটি চা বাগানের ছিনতাইকৃত ৫ লাখ ৩৩ হাজার টাকা উদ্ধার</title>
      <link>https://www.dhakaprotidin.com/%e0%a6%ab%e0%a6%9f%e0%a6%bf%e0%a6%95%e0%a6%9b%e0%a6%a1%e0%a6%bc%e0%a6%bf-%e0%a6%89%e0%a6%a4%e0%a7%8d%e0%a6%a4%e0%a6%b0%e0%a7%87-%e0%a6%aa%e0%a6%9e%e0%a7%8d%e0%a6%9a%e0%a6%ac%e0%a6%9f%e0%a6%bf/</link>
      <guid isPermaLink="true">https://www.dhakaprotidin.com/%e0%a6%ab%e0%a6%9f%e0%a6%bf%e0%a6%95%e0%a6%9b%e0%a6%a1%e0%a6%bc%e0%a6%bf-%e0%a6%89%e0%a6%a4%e0%a7%8d%e0%a6%a4%e0%a6%b0%e0%a7%87-%e0%a6%aa%e0%a6%9e%e0%a7%8d%e0%a6%9a%e0%a6%ac%e0%a6%9f%e0%a6%bf/</guid>
      <pubDate>Sun, 22 Nov 2026 09:47:45 +0000</pubDate>
      <description>ফটিকছড়ি উত্তর উপজেলান পঞ্চবটি চা বাগানের শ্রমিকদের সাপ্তাহিক বেতন ও পূজার বোনাসের ৭ লাখ ৩৩ হাজার টাকা ছিনতাইয়ের ঘটনায় ৫ লাখ ৩৩ হাজার টাকা উদ্ধার করেছে ভূজপুর থানা পুলিশ। এ ঘটনায় এ পর্যন্ত ৭ জন ছিনতাইকারীকে গ্রেফতার করা হয়েছে। গত শুক্রবার রাতে প্রধান আসামি জাবেদের বসতঘরের বাঁশের চাটাইয়ের সিলিংয়ের ওপর</description>
      <source url="https://www.dhakaprotidin.com/%e0%a6%ab%e0%a6%9f%e0%a6%bf%e0%a6%95%e0%a6%9b%e0%a6%a1%e0%a6%bc%e0%a6%bf-%e0%a6%89%e0%a6%a4%e0%a7%8d%e0%a6%a4%e0%a6%b0%e0%a7%87-%e0%a6%aa%e0%a6%9e%e0%a7%8d%e0%a6%9a%e0%a6%ac%e0%a6%9f%e0%a6%bf/">Dhaka Protidin</source>
    </item>
    <item>
      <title>যুব বিভাগের উদ্যোগে আমিরাবাদে অনুষ্ঠিত হল যুব সম্মেলন</title>
      <link>https://www.dhakaprotidin.com/%e0%a6%af%e0%a7%81%e0%a6%ac-%e0%a6%ac%e0%a6%bf%e0%a6%ad%e0%a6%be%e0%a6%97%e0%a7%87%e0%a6%b0-%e0%a6%89%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a7%8b%e0%a6%97%e0%a7%87-%e0%a6%86%e0%a6%ae%e0%a6%bf%e0%a6%b0/</link>

    <item>
      <title>[Dhaka Protidin] ফুলপুরে যথাযোগ্য মর্যাদায় ৫৫তম জাতীয় সমবায় দিবস উদযাপন</title>
      <link>https://www.dhakaprotidin.com/%e0%a6%ab%e0%a7%81%e0%a6%b2%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87-%e0%a6%af%e0%a6%a5%e0%a6%be%e0%a6%af%e0%a7%8b%e0%a6%97%e0%a7%8d%e0%a6%af-%e0%a6%ae%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%a6-2/</link>
      <guid isPermaLink="true">https://www.dhakaprotidin.com/%e0%a6%ab%e0%a7%81%e0%a6%b2%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87-%e0%a6%af%e0%a6%a5%e0%a6%be%e0%a6%af%e0%a7%8b%e0%a6%97%e0%a7%8d%e0%a6%af-%e0%a6%ae%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%a6-2/</guid>
      <pubDate>Sun, 08 Nov 2026 13:32:38 +0000</pubDate>
      <description>‘করব সমবায়, গড়ব দেশ, সবার জন্য বাংলাদেশ’—এই প্রতিপাদ্যকে সামনে রেখে ময়মনসিংহের ফুলপুরে নানা আয়োজনের মধ্য দিয়ে যথাযোগ্য মর্যাদায় ৫৫তম জাতীয় সমবায় দিবস-২০২৬ উদযাপন করা হয়েছে। দিবসটি উপলক্ষে বর্ণাঢ্য র‍্যালি, আলোচনা সভা এবং সমবায় খাতে বিশেষ অবদানের স্বী</description>
      <source url="https://www.dhakaprotidin.com/%e0%a6%ab%e0%a7%81%e0%a6%b2%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87-%e0%a6%af%e0%a6%a5%e0%a6%be%e0%a6%af%e0%a7%8b%e0%a6%97%e0%a7%8d%e0%a6%af-%e0%a6%ae%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%a6-2/">Dhaka Protidin</source>
    </item>
    <item>
      <title>[Dhaka Protidin] পাইকগাছায় গদারডাঙ্গা সরকারি প্রাথমিক বিদ্যালয়ের দুই শিক্ষকের বিদায় সংবর্ধনা অনুষ্ঠিত</title>
      <link>https://www.dhakaprotidin.com/%e0%a6%aa%e0%a6%be%e0%a6%87%e0%a6%95%e0%a6%97%e0%a6%be%e0%a6%9b%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%97%e0%a6%a6%e0%a6%be%e0%a6%b0%e0%a6%a1%e0%a6%be%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a6%be-%e0%a6%b8%e0%a6%b0/</link>

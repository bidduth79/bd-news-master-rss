    <item>
      <title>ফরিদপুর বিভাগে যুবদলের সাংগঠনিক দায়িত্বে পিরোজপুরের সোহাগ</title>
      <link>https://www.dhakaprotidin.com/%e0%a6%ab%e0%a6%b0%e0%a6%bf%e0%a6%a6%e0%a6%aa%e0%a7%81%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%ad%e0%a6%be%e0%a6%97%e0%a7%87-%e0%a6%af%e0%a7%81%e0%a6%ac%e0%a6%a6%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a6%b8/</link>

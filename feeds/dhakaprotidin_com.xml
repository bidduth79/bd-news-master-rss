    <item>
      <title>ভাড়া বাসায় ইয়াবা তৈরির কারখানা, হাটহাজারীতে গ্রেপ্তার ১</title>
      <link>https://www.dhakaprotidin.com/%e0%a6%ad%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a6%be-%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%87%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%ac%e0%a6%be-%e0%a6%a4%e0%a7%88%e0%a6%b0%e0%a6%bf/</link>

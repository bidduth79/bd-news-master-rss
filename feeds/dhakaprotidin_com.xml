    <item>
      <title>আনোয়ারায় নেওয়াজ তালুকদার বাড়ি সমবায় সমিতির বর্ষপূর্তি ও সাধারণ সভা</title>
      <link>https://www.dhakaprotidin.com/%e0%a6%86%e0%a6%a8%e0%a7%8b%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%a8%e0%a7%87%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%9c-%e0%a6%a4%e0%a6%be%e0%a6%b2%e0%a7%81%e0%a6%95/</link>
      <guid isPermaLink="true">https://www.dhakaprotidin.com/%e0%a6%86%e0%a6%a8%e0%a7%8b%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%a8%e0%a7%87%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%9c-%e0%a6%a4%e0%a6%be%e0%a6%b2%e0%a7%81%e0%a6%95/</guid>
      <pubDate>Sat, 14 Nov 2026 09:55:22 +0000</pubDate>
      <description>আনোয়ারা উপজেলার বৈরাগ ইউনিয়নে নেওয়াজ তালুকদার বাড়ি সমবায় সমিতির ৩য় বর্ষপূর্তি ও সাধারণ সভা অনুষ্ঠিত হয়েছে। গতকাল শুক্রবার (১৩ নভেম্বর) বিকেল ৪টায় এ অনুষ্ঠানের আয়োজন করা হয়। ​সমিতির সভাপতি মোক্তার সওদাগরের সভাপতিত্বে এবং তানজিমুল হাসানের সঞ্চালনায় অনুষ্ঠানে প্রধান অতিথি ছিলেন দক্ষিণ বন্দর উচ্চ বিদ্যা</description>
      <source url="https://www.dhakaprotidin.com/%e0%a6%86%e0%a6%a8%e0%a7%8b%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%a8%e0%a7%87%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%9c-%e0%a6%a4%e0%a6%be%e0%a6%b2%e0%a7%81%e0%a6%95/">Dhaka Protidin</source>
    </item>
    <item>
      <title>কক্সবাজারে বাংলাদেশ তৃণমূল সাংবাদিক কল্যাণ সোসাইটির প্রতিনিধি সভা সম্পন্ন</title>
      <link>https://www.dhakaprotidin.com/%e0%a6%95%e0%a6%95%e0%a7%8d%e0%a6%b8%e0%a6%ac%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0%e0%a7%87-%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%a6%e0%a7%87%e0%a6%b6-%e0%a6%a4%e0%a7%83%e0%a6%a3%e0%a6%ae/</link>
      <guid isPermaLink="true">https://www.dhakaprotidin.com/%e0%a6%95%e0%a6%95%e0%a7%8d%e0%a6%b8%e0%a6%ac%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0%e0%a7%87-%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%a6%e0%a7%87%e0%a6%b6-%e0%a6%a4%e0%a7%83%e0%a6%a3%e0%a6%ae/</guid>
      <pubDate>Sat, 14 Nov 2026 09:53:37 +0000</pubDate>
      <description>চট্টগ্রামের পর্যটন নগরী কক্সবাজারের ঐতিহ্যবাহী স্টেডিয়াম সংলগ্ন দিল্লি কিচেন রেস্টুরেন্টের হল রুমে চট্টগ্রাম বিভাগীয় প্রতিনিধি সভা অনুষ্ঠিত হয়। ১৩ ই নভেম্বর (শুক্রবার) বিকাল ৪ টায় উক্ত সভা অনুষ্ঠিত হয়। অনুষ্ঠানে বক্তারা বলেন,বাংলাদেশ তৃণমূল সাংবাদিক কল্যাণ সোসাইটির মূল লক্ষ্য উদ্দেশ্য হচ্ছে সাংবাদিক</description>
      <source url="https://www.dhakaprotidin.com/%e0%a6%95%e0%a6%95%e0%a7%8d%e0%a6%b8%e0%a6%ac%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0%e0%a7%87-%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%a6%e0%a7%87%e0%a6%b6-%e0%a6%a4%e0%a7%83%e0%a6%a3%e0%a6%ae/">Dhaka Protidin</source>
    </item>

    <item>
      <title>সরকারি বাসা ছাড়তে বাধ্য প্রশিক্ষক ও কর্মচারীরা</title>
      <link>https://dailykhowai.com/%e0%a6%b8%e0%a6%b0%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%bf-%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a6%be-%e0%a6%9b%e0%a6%be%e0%a7%9c%e0%a6%a4%e0%a7%87-%e0%a6%ac%e0%a6%be%e0%a6%a7%e0%a7%8d%e0%a6%af-%e0%a6%aa/</link>

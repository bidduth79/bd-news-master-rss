      <pubDate>Mon, 23 Nov 2026 05:09:38 GMT</pubDate>
      <enclosure url="https://ichef.bbci.co.uk/ace/ws/240/cpsprodpb/bd97/live/6cb5b1f0-e6fc-11f1-9177-bfaafe54e5e5.jpg" length="0" type="image/jpeg" />
      <media:content url="https://ichef.bbci.co.uk/ace/ws/240/cpsprodpb/bd97/live/6cb5b1f0-e6fc-11f1-9177-bfaafe54e5e5.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://ichef.bbci.co.uk/ace/ws/240/cpsprodpb/bd97/live/6cb5b1f0-e6fc-11f1-9177-bfaafe54e5e5.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চুক্তিতে পৌঁছাতে ব্যর্থ হলো জাতিসংঘ জলবায়ু সম্মেলন" /&gt;&lt;/p&gt;&lt;p&gt;দুই সপ্তাহের আলোচনা শেষে অচলাবস্থা কাটানোর চেষ্টায় রোববার ভোরে ক্লান্ত প্রতিনিধিদের সামনে চুক্তির একটি নতুন খসড়া উপস্থাপন করা হয়েছিল। কিন্তু ওই নথিতে কোথাও 'জীবাশ্ম জ্বালানি' শব্দ দুটি ছিল না। সম্মেলনের যৌথ আয়োজক দেশ অস্ট্রেলিয়ার প্রধানমন্ত্রী অ্যান্থনি আলবানিজ ব্যর্থতার জন্য 'কঠিন ভূরাজনৈতিক সম&lt;/p&gt;</description>

    </item>
    <item>
      <title>শোধন ছাড়াই নদী-খালে যাচ্ছে পয়োবর্জ্য : বাড়ছে স্বাস্থ্যঝুঁকি</title>
      <link>https://bartabangla.com/117851/</link>
      <guid isPermaLink="true">https://bartabangla.com/117851/</guid>
      <pubDate>Thu, 19 Nov 2026 05:11:54 +0000</pubDate>
      <enclosure url="https://bartabangla.com/wp-content/uploads/2026/11/শোধন-ছাড়াই-নদী-খালে-যাচ্ছে-পয়োবর্জ্য-1024x576.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bartabangla.com/wp-content/uploads/2026/11/শোধন-ছাড়াই-নদী-খালে-যাচ্ছে-পয়োবর্জ্য-1024x576.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bartabangla.com/wp-content/uploads/2026/11/শোধন-ছাড়াই-নদী-খালে-যাচ্ছে-পয়োবর্জ্য-1024x576.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শোধন ছাড়াই নদী-খালে যাচ্ছে পয়োবর্জ্য : বাড়ছে স্বাস্থ্যঝুঁকি" /&gt;&lt;/p&gt;&lt;p&gt;ঘরের টয়লেট থেকে বর্জ্য দূর হয়ে গেলেও তার নিরাপদ গন্তব্য নিয়ে তৈরি হয়েছে এক নীরব সংকট। দেশের বিভিন্ন প্রান্তে অপরিশোধিত পয়োবর্জ্য সরাসরি নদী-খাল, জলাশয় ও মাটিতে মিশে পরিবেশের অপূরণীয় ক্ষতি করছে। যদিও খোলা জায়গায় মলত্যাগ রোধে বাংলাদেশ প্রশংসনীয় সাফল্য দেখিয়েছে, তবুও বর্জ্য সংগ্রহ, সঠিক পরিবহন ও তা শোধ&lt;/p&gt;</description>
      <source url="https://bartabangla.com/117851/">বার্তা বাংলা</source>
    </item>
    <item>
      <title>এ যেন সিনেমার গল্প : মাথায় আঘাতের পর স্মৃতিশক্তি ফিরে পেলেন বেবী</title>
      <link>https://bartabangla.com/117848/</link>
      <guid isPermaLink="true">https://bartabangla.com/117848/</guid>
      <pubDate>Thu, 19 Nov 2026 04:50:05 +0000</pubDate>
      <enclosure url="https://bartabangla.com/wp-content/uploads/2026/11/মাথায়-আঘাতের-পর-স্মৃতি-ফিরে-পেলেন-বেবী-1024x576.jpg" length="0" type="image/jpeg" />
      <media:content url="https://bartabangla.com/wp-content/uploads/2026/11/মাথায়-আঘাতের-পর-স্মৃতি-ফিরে-পেলেন-বেবী-1024x576.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://bartabangla.com/wp-content/uploads/2026/11/মাথায়-আঘাতের-পর-স্মৃতি-ফিরে-পেলেন-বেবী-1024x576.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এ যেন সিনেমার গল্প : মাথায় আঘাতের পর স্মৃতিশক্তি ফিরে পেলেন বেবী" /&gt;&lt;/p&gt;&lt;p&gt;চলচ্চিত্রে আমরা প্রায়ই দেখি, ভালোবাসার মানুষের বিচ্ছেদের কষ্ট সইতে না পেরে কেউ মানসিক ভারসাম্য হারিয়ে ফেলেছেন। এরপর আকস্মিক কোনো দুর্ঘটনায় মাথায় আঘাত পাওয়ার পর তার আবার স্মৃতিশক্তি ফিরে আসে। কিন্তু সিনেমার এই চিত্রনাট্য যে বাস্তবেও সত্যি হতে পারে, তার এক অবিশ্বাস্য প্রমাণ মিলল রাজশাহীর পবা উপজেলায়&lt;/p&gt;</description>
      <source url="https://bartabangla.com/117848/">বার্তা বাংলা</source>
    </item>

    <item>
      <title>কুড়িয়ে পাওয়া তিন ভরি সোনা ফিরিয়ে দিলেন চানাচুর বিক্রেতা</title>
      <link>https://bartabangla.com/117864/</link>
      <guid isPermaLink="true">https://bartabangla.com/117864/</guid>
      <pubDate>Mon, 23 Nov 2026 07:04:26 +0000</pubDate>
      <enclosure url="https://bartabangla.com/wp-content/uploads/2026/11/কুড়িয়ে-পাওয়া-সোনা-ফিরিয়ে-দিলেন-চানাচুর-বিক্রেতা-1024x576.jpg" length="0" type="image/jpeg" />

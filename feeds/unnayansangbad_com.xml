    <item>
      <title>মুহাম্মদ আলী জিন্নাহর সমাধিতে স্পিকারের শ্রদ্ধা</title>
      <link>https://www.unnayansangbad.com/122380/%e0%a6%ae%e0%a7%81%e0%a6%b9%e0%a6%be%e0%a6%ae%e0%a7%8d%e0%a6%ae%e0%a6%a6-%e0%a6%86%e0%a6%b2%e0%a7%80-%e0%a6%9c%e0%a6%bf%e0%a6%a8%e0%a7%8d%e0%a6%a8%e0%a6%be%e0%a6%b9%e0%a6%b0-%e0%a6%b8%e0%a6%ae/</link>

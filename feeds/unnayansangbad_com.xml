    <item>
      <title>দেশের চাহিদা পূরণ করে রপ্তানিমুখী হচ্ছে প্রাণিসম্পদ খাত: প্রধানমন্ত্রী</title>
      <link>https://www.unnayansangbad.com/122316/%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%87%e0%a6%b0-%e0%a6%9a%e0%a6%be%e0%a6%b9%e0%a6%bf%e0%a6%a6%e0%a6%be-%e0%a6%aa%e0%a7%82%e0%a6%b0%e0%a6%a3-%e0%a6%95%e0%a6%b0%e0%a7%87-%e0%a6%b0%e0%a6%aa%e0%a7%8d/</link>

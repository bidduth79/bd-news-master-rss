      <pubDate>Fri, 20 Nov 2026 14:28:47 +0000</pubDate>
      <description>হেমন্তের শেষ সময়ে এসে বৃষ্টিতে ভিজছে রাজধানী ঢাকাসহ দেশের বিভিন্ন অঞ্চল। কোথাও হালকা, কোথাও মাঝারি, আবার কোথাও অতি ভারী বৃষ্টিও হচ্ছে। ঘূর্ণিঝড় আকভানের প্রভাবে সৃষ্ট এই বৃষ্টিপাত আরও প্রায় দুই দিন অব্যাহত থাকতে পারে। বৃষ্টির কারণে সাময়িকভাবে তাপমাত্রা কমে ঠান্ডা অনুভূত হলেও এখনই শীতের স্থায়ী আগমনের </description>
      <source url="https://www.unnayansangbad.com/122105/%e0%a6%8f%e0%a6%87-%e0%a6%ac%e0%a7%83%e0%a6%b7%e0%a7%8d%e0%a6%9f%e0%a6%bf%e0%a6%a4%e0%a7%87%e0%a6%87-%e0%a6%a8%e0%a6%be%e0%a6%ae%e0%a6%ac%e0%a7%87-%e0%a6%b6%e0%a7%80%e0%a6%a4-%e0%a6%95%e0%a7%80/">উন্নয়নসংবাদডটকম</source>
    </item>
    <item>
      <title>আপনাদের থানা আপনারা পুড়িয়ে দিলে পুলিশ কাজ কীভাবে করবে: গোপালগঞ্জে আইজিপি</title>
      <link>https://www.unnayansangbad.com/122102/%e0%a6%86%e0%a6%aa%e0%a6%a8%e0%a6%be%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%a5%e0%a6%be%e0%a6%a8%e0%a6%be-%e0%a6%86%e0%a6%aa%e0%a6%a8%e0%a6%be%e0%a6%b0%e0%a6%be-%e0%a6%aa%e0%a7%81%e0%a6%a1%e0%a6%bc/</link>

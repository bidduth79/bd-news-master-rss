    <item>
      <title>হামের উপসর্গে আরও ৮ মৃত্যু, শনাক্ত ৯৯৭</title>
      <link>https://www.unnayansangbad.com/122390/%e0%a6%b9%e0%a6%be%e0%a6%ae%e0%a7%87%e0%a6%b0-%e0%a6%89%e0%a6%aa%e0%a6%b8%e0%a6%b0%e0%a7%8d%e0%a6%97%e0%a7%87-%e0%a6%86%e0%a6%b0%e0%a6%93-%e0%a7%ae-%e0%a6%ae%e0%a7%83%e0%a6%a4%e0%a7%8d%e0%a6%af/</link>
      <guid isPermaLink="true">https://www.unnayansangbad.com/122390/%e0%a6%b9%e0%a6%be%e0%a6%ae%e0%a7%87%e0%a6%b0-%e0%a6%89%e0%a6%aa%e0%a6%b8%e0%a6%b0%e0%a7%8d%e0%a6%97%e0%a7%87-%e0%a6%86%e0%a6%b0%e0%a6%93-%e0%a7%ae-%e0%a6%ae%e0%a7%83%e0%a6%a4%e0%a7%8d%e0%a6%af/</guid>
      <pubDate>Sat, 28 Nov 2026 12:15:15 +0000</pubDate>
      <description>দেশে হামের উপসর্গে মৃত্যু বেড়েই চলেছে। গত ২৪ ঘণ্টায় হামের উপসর্গ নিয়ে আরও ৮ জনের মৃত্যু হয়েছে। এ সময়ে ৯৯৭ জনের মধ্যে হামের উপসর্গ দেখা গেছে। একই সময়ে ৫৪ জনের শরীরে নিশ্চিত হাম শনাক্ত হয়েছে। আজ শনিবার স্বাস্থ্য অধিদপ্তরের হামবিষয়ক বিজ্ঞপ্তিতে এসব তথ্য জানানো হয়েছে। এতে গতকাল শুক্রবার সকাল ৮টা থেকে আজ</description>
      <source url="https://www.unnayansangbad.com/122390/%e0%a6%b9%e0%a6%be%e0%a6%ae%e0%a7%87%e0%a6%b0-%e0%a6%89%e0%a6%aa%e0%a6%b8%e0%a6%b0%e0%a7%8d%e0%a6%97%e0%a7%87-%e0%a6%86%e0%a6%b0%e0%a6%93-%e0%a7%ae-%e0%a6%ae%e0%a7%83%e0%a6%a4%e0%a7%8d%e0%a6%af/">উন্নয়নসংবাদডটকম</source>
    </item>
    <item>
      <title>ধানমন্ডিতে ‘মোরগ পোলাও খাইয়ে’ ২ হাজার ভরি স্বর্ণালংকার চুরি</title>
      <link>https://www.unnayansangbad.com/122387/%e0%a6%a7%e0%a6%be%e0%a6%a8%e0%a6%ae%e0%a6%a8%e0%a7%8d%e0%a6%a1%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%ae%e0%a7%8b%e0%a6%b0%e0%a6%97-%e0%a6%aa%e0%a7%8b%e0%a6%b2%e0%a6%be%e0%a6%93-%e0%a6%96/</link>
      <guid isPermaLink="true">https://www.unnayansangbad.com/122387/%e0%a6%a7%e0%a6%be%e0%a6%a8%e0%a6%ae%e0%a6%a8%e0%a7%8d%e0%a6%a1%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%ae%e0%a7%8b%e0%a6%b0%e0%a6%97-%e0%a6%aa%e0%a7%8b%e0%a6%b2%e0%a6%be%e0%a6%93-%e0%a6%96/</guid>
      <pubDate>Sat, 28 Nov 2026 12:13:12 +0000</pubDate>
      <description>রাজধানীর ধানমন্ডিতে একটি শপিং মলে গয়নার দোকানে দুর্ধর্ষ চুরির ঘটনা ঘটেছে। দুর্বৃত্তরা নিরাপত্তাকর্মীদের মোরগ পোলাও খাইয়ে অচেতন করে পূরবী জুয়েলার্স থেকে প্রায় দুই হাজার ভরি গয়না ও ১০ থেকে ১২ লাখ টাকা চুরি করে নিয়ে গেছে বলে অভিযোগ করেছেন দোকানটির মালিক। গতকাল শুক্রবার (২৭ নভেম্বর) দিবাগত রাত আনুমানিক </description>
      <source url="https://www.unnayansangbad.com/122387/%e0%a6%a7%e0%a6%be%e0%a6%a8%e0%a6%ae%e0%a6%a8%e0%a7%8d%e0%a6%a1%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%ae%e0%a7%8b%e0%a6%b0%e0%a6%97-%e0%a6%aa%e0%a7%8b%e0%a6%b2%e0%a6%be%e0%a6%93-%e0%a6%96/">উন্নয়নসংবাদডটকম</source>
    </item>

    <item>
      <title>আওয়ামী লীগকে ‘সন্ত্রাসী সংগঠন’ ঘোষণার দাবিতে হাইকোর্টে রিট</title>
      <link>https://www.unnayansangbad.com/122303/%e0%a6%86%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%ae%e0%a7%80-%e0%a6%b2%e0%a7%80%e0%a6%97%e0%a6%95%e0%a7%87-%e0%a6%b8%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%b8%e0%a7%80/</link>

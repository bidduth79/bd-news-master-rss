    </item>
    <item>
      <title>সাত জেলার এসপি বদলসহ ১৪ কর্মকর্তার বদলি-পদায়ন</title>
      <link>https://www.unnayansangbad.com/122300/%e0%a6%b8%e0%a6%be%e0%a6%a4-%e0%a6%9c%e0%a7%87%e0%a6%b2%e0%a6%be%e0%a6%b0-%e0%a6%8f%e0%a6%b8%e0%a6%aa%e0%a6%bf-%e0%a6%ac%e0%a6%a6%e0%a6%b2%e0%a6%b8%e0%a6%b9-%e0%a7%a7%e0%a7%aa-%e0%a6%95%e0%a6%b0/</link>

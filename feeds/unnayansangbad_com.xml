    <item>
      <title>সরকারকে অস্থিতিশীল করতে ‘রাষ্ট্রবিরোধী তৎপরতা’ চালাচ্ছে হাসিনার সমর্থকরা</title>
      <link>https://www.unnayansangbad.com/122184/%e0%a6%b8%e0%a6%b0%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%95%e0%a7%87-%e0%a6%85%e0%a6%b8%e0%a7%8d%e0%a6%a5%e0%a6%bf%e0%a6%a4%e0%a6%bf%e0%a6%b6%e0%a7%80%e0%a6%b2-%e0%a6%95%e0%a6%b0%e0%a6%a4%e0%a7%87/</link>
      <guid isPermaLink="true">https://www.unnayansangbad.com/122184/%e0%a6%b8%e0%a6%b0%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%95%e0%a7%87-%e0%a6%85%e0%a6%b8%e0%a7%8d%e0%a6%a5%e0%a6%bf%e0%a6%a4%e0%a6%bf%e0%a6%b6%e0%a7%80%e0%a6%b2-%e0%a6%95%e0%a6%b0%e0%a6%a4%e0%a7%87/</guid>
      <pubDate>Sun, 22 Nov 2026 16:52:45 +0000</pubDate>
      <description>হাসিনার সমর্থকদের বিরুদ্ধে সরকারকে অস্থিতিশীল করার চেষ্টার অভিযোগ তুলেছে যুক্তরাষ্ট্রভিত্তিক সংবাদমাধ্যম দ্য নিউইয়র্ক টাইমস (এনওয়াইটি)। সংবাদমাধ্যমটির এক প্রতিবেদনে সাম্প্রতিক সহিংস কর্মকাণ্ডকে ‘ছোট পরিসরে রাষ্ট্রবিরোধী তৎপরতা’ হিসেবে উল্লেখ করা হয়েছে। শনিবার প্রকাশিত এবং রোববার হালনাগাদ করা প্রতিবে</description>
      <source url="https://www.unnayansangbad.com/122184/%e0%a6%b8%e0%a6%b0%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%95%e0%a7%87-%e0%a6%85%e0%a6%b8%e0%a7%8d%e0%a6%a5%e0%a6%bf%e0%a6%a4%e0%a6%bf%e0%a6%b6%e0%a7%80%e0%a6%b2-%e0%a6%95%e0%a6%b0%e0%a6%a4%e0%a7%87/">উন্নয়নসংবাদডটকম</source>
    </item>
    <item>
      <title>বেনাপোল সীমান্তে নিরাপত্তা জোরদার, সর্বোচ্চ সতর্ক অবস্থানে বিজিবি</title>
      <link>https://www.unnayansangbad.com/122180/%e0%a6%ac%e0%a7%87%e0%a6%a8%e0%a6%be%e0%a6%aa%e0%a7%8b%e0%a6%b2-%e0%a6%b8%e0%a7%80%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%87-%e0%a6%a8%e0%a6%bf%e0%a6%b0%e0%a6%be%e0%a6%aa%e0%a6%a4%e0%a7%8d/</link>
      <guid isPermaLink="true">https://www.unnayansangbad.com/122180/%e0%a6%ac%e0%a7%87%e0%a6%a8%e0%a6%be%e0%a6%aa%e0%a7%8b%e0%a6%b2-%e0%a6%b8%e0%a7%80%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%87-%e0%a6%a8%e0%a6%bf%e0%a6%b0%e0%a6%be%e0%a6%aa%e0%a6%a4%e0%a7%8d/</guid>
      <pubDate>Sun, 22 Nov 2026 16:49:36 +0000</pubDate>
      <description>ভারতের পেট্রাপোল সীমান্তে হিন্দু সুরক্ষা সমিতি ও মতুয়া সম্প্রদায়ের কয়েকটি সংগঠনের বিক্ষোভ ও সমাবেশকে কেন্দ্র করে এবং অবৈধ অনুপ্রবেশ ঠেকাতে বেনাপোল সীমান্তে নিরাপত্তা জোরদার করেছে বর্ডার গার্ড বাংলাদেশ (বিজিবি)। এছাড়া কার্যক্রম নিষিদ্ধ আওয়ামী লীগ নানা অপপ্রচার চালাচ্ছে। এরই অংশ হিসেবে শেখ হাসিনা </description>
      <source url="https://www.unnayansangbad.com/122180/%e0%a6%ac%e0%a7%87%e0%a6%a8%e0%a6%be%e0%a6%aa%e0%a7%8b%e0%a6%b2-%e0%a6%b8%e0%a7%80%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%87-%e0%a6%a8%e0%a6%bf%e0%a6%b0%e0%a6%be%e0%a6%aa%e0%a6%a4%e0%a7%8d/">উন্নয়নসংবাদডটকম</source>
    </item>
    <item>
      <title>ডাকাতের কবলে প্রসূতি, ভয়ে অ্যাম্বুলেন্সেই সন্তান প্রসব, নবজাতকের মৃত্যু</title>
      <link>https://www.unnayansangbad.com/122177/%e0%a6%a1%e0%a6%be%e0%a6%95%e0%a6%be%e0%a6%a4%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a6%ac%e0%a6%b2%e0%a7%87-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%b8%e0%a7%82%e0%a6%a4%e0%a6%bf-%e0%a6%ad%e0%a6%af%e0%a6%bc/</link>
      <guid isPermaLink="true">https://www.unnayansangbad.com/122177/%e0%a6%a1%e0%a6%be%e0%a6%95%e0%a6%be%e0%a6%a4%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a6%ac%e0%a6%b2%e0%a7%87-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%b8%e0%a7%82%e0%a6%a4%e0%a6%bf-%e0%a6%ad%e0%a6%af%e0%a6%bc/</guid>
      <pubDate>Sun, 22 Nov 2026 16:45:59 +0000</pubDate>
      <description>ঝিনাইদহের কালীগঞ্জে সড়কে গাছ ফেলে অ্যাম্বুলেন্সের গতিরোধ করে ডাকাতি করেছে মুখোশধারীরা। এ সময় ডাকাতদের কবলে পড়ে চরম আতঙ্কিত হয়ে অ্যাম্বুলেন্সের মধ্যেই সন্তান প্রসব করেন এক প্রসূতি। পরে নবজাতকের মৃত্যু হয়। ডাকাতেরা পরিবারের সদস্যদের কাছ থেকে নগদ এক লাখ টাকা, মোবাইল ফোন ও স্বর্ণালংকার লুট করে নিয়ে যায়।</description>
      <source url="https://www.unnayansangbad.com/122177/%e0%a6%a1%e0%a6%be%e0%a6%95%e0%a6%be%e0%a6%a4%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a6%ac%e0%a6%b2%e0%a7%87-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%b8%e0%a7%82%e0%a6%a4%e0%a6%bf-%e0%a6%ad%e0%a6%af%e0%a6%bc/">উন্নয়নসংবাদডটকম</source>
    </item>
    <item>
      <title>৩১ ডিসেম্বর পর্যন্ত নোট-গাইড বই ছাপা বন্ধের নির্দেশ</title>
      <link>https://www.unnayansangbad.com/122174/%e0%a7%a9%e0%a7%a7-%e0%a6%a1%e0%a6%bf%e0%a6%b8%e0%a7%87%e0%a6%ae%e0%a7%8d%e0%a6%ac%e0%a6%b0-%e0%a6%aa%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%a8%e0%a7%8d%e0%a6%a4-%e0%a6%a8%e0%a7%8b%e0%a6%9f-%e0%a6%97/</link>
      <guid isPermaLink="true">https://www.unnayansangbad.com/122174/%e0%a7%a9%e0%a7%a7-%e0%a6%a1%e0%a6%bf%e0%a6%b8%e0%a7%87%e0%a6%ae%e0%a7%8d%e0%a6%ac%e0%a6%b0-%e0%a6%aa%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%a8%e0%a7%8d%e0%a6%a4-%e0%a6%a8%e0%a7%8b%e0%a6%9f-%e0%a6%97/</guid>
      <pubDate>Sun, 22 Nov 2026 16:43:30 +0000</pubDate>
      <description>২০২৭ শিক্ষাবর্ষের বিনামূল্যের পাঠ্যবই শিক্ষার্থীদের হাতে পৌঁছে দেওয়ার কাজ শেষ না হওয়া পর্যন্ত সব ধরনের নোট, গাইড ও অনুশীলনমূলক সহায়ক বই ছাপা বন্ধ রাখার নির্দেশ দিয়েছে জাতীয় শিক্ষাক্রম ও পাঠ্যপুস্তক বোর্ড (এনসিটিবি)। আগামী ৩১ ডিসেম্বর পর্যন্ত এসব বইয়ের মুদ্রণ ও বাঁধাই কার্যক্রম বন্ধ রাখতে বলা হয়েছে। </description>
      <source url="https://www.unnayansangbad.com/122174/%e0%a7%a9%e0%a7%a7-%e0%a6%a1%e0%a6%bf%e0%a6%b8%e0%a7%87%e0%a6%ae%e0%a7%8d%e0%a6%ac%e0%a6%b0-%e0%a6%aa%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%a8%e0%a7%8d%e0%a6%a4-%e0%a6%a8%e0%a7%8b%e0%a6%9f-%e0%a6%97/">উন্নয়নসংবাদডটকম</source>
    </item>
    <item>
      <title>ময়মনসিংহে ‘সাইকো গ্যাং কিলার’-এর মিছিল, আটক ৬ কিশোর</title>
      <link>https://www.unnayansangbad.com/122171/%e0%a6%ae%e0%a6%af%e0%a6%bc%e0%a6%ae%e0%a6%a8%e0%a6%b8%e0%a6%bf%e0%a6%82%e0%a6%b9%e0%a7%87-%e0%a6%b8%e0%a6%be%e0%a6%87%e0%a6%95%e0%a7%8b-%e0%a6%97%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82/</link>
      <guid isPermaLink="true">https://www.unnayansangbad.com/122171/%e0%a6%ae%e0%a6%af%e0%a6%bc%e0%a6%ae%e0%a6%a8%e0%a6%b8%e0%a6%bf%e0%a6%82%e0%a6%b9%e0%a7%87-%e0%a6%b8%e0%a6%be%e0%a6%87%e0%a6%95%e0%a7%8b-%e0%a6%97%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82/</guid>
      <pubDate>Sun, 22 Nov 2026 16:40:58 +0000</pubDate>
      <description>ময়মনসিংহ নগরে ‘সাইকো গ্যাং কিলার’ (পিজিকে) নামে একটি কিশোর গ্যাংয়ের তৎপরতা ও মিছিলের ভিডিও সামাজিক যোগাযোগমাধ্যমে ছড়িয়ে পড়েছে। এ ঘটনায় অভিযান চালিয়ে ১৪ থেকে ১৭ বছর বয়সী ছয় কিশোরকে আটক করেছে পুলিশ। শুক্রবার (২০ নভেম্বর) দুপুরে নগরের জেলা পুলিশ লাইনস ও কাশর এলাকায় কয়েকশ কিশোরকে নিয়ে মিছিল বের করা হয়। </description>
      <source url="https://www.unnayansangbad.com/122171/%e0%a6%ae%e0%a6%af%e0%a6%bc%e0%a6%ae%e0%a6%a8%e0%a6%b8%e0%a6%bf%e0%a6%82%e0%a6%b9%e0%a7%87-%e0%a6%b8%e0%a6%be%e0%a6%87%e0%a6%95%e0%a7%8b-%e0%a6%97%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82/">উন্নয়নসংবাদডটকম</source>
    </item>
    <item>
      <title>সোমবার টানা ৯ ঘণ্টা দেশের যেসব এলাকায় বিদ্যুৎ থাকবে না</title>
      <link>https://www.unnayansangbad.com/122167/%e0%a6%b8%e0%a7%8b%e0%a6%ae%e0%a6%ac%e0%a6%be%e0%a6%b0-%e0%a6%9f%e0%a6%be%e0%a6%a8%e0%a6%be-%e0%a7%af-%e0%a6%98%e0%a6%a3%e0%a7%8d%e0%a6%9f%e0%a6%be-%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%87%e0%a6%b0/</link>
      <guid isPermaLink="true">https://www.unnayansangbad.com/122167/%e0%a6%b8%e0%a7%8b%e0%a6%ae%e0%a6%ac%e0%a6%be%e0%a6%b0-%e0%a6%9f%e0%a6%be%e0%a6%a8%e0%a6%be-%e0%a7%af-%e0%a6%98%e0%a6%a3%e0%a7%8d%e0%a6%9f%e0%a6%be-%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%87%e0%a6%b0/</guid>
      <pubDate>Sun, 22 Nov 2026 16:37:39 +0000</pubDate>
      <description>বার্ষিক রক্ষণাবেক্ষণ কাজের জন্য সোমবার (২৩ নভেম্বর) সকাল থেকে টানা ৯ ঘণ্টা দেশের কয়েকটি এলাকায় বিদ্যুৎ সরবরাহ বন্ধ থাকবে। রোববার (২২ নভেম্বর) ঢাকা পল্লী বিদ্যুৎ সমিতি-৪ এর এক বিজ্ঞপ্তিতে এ তথ্য জানানো হয়েছে। বিজ্ঞপ্তিতে জানানো হয়, হাসনাবাদ গ্রিড উপকেন্দ্রের বার্ষিক রক্ষণাবেক্ষণের পাশাপাশি ১১ কেভি ফি</description>
      <source url="https://www.unnayansangbad.com/122167/%e0%a6%b8%e0%a7%8b%e0%a6%ae%e0%a6%ac%e0%a6%be%e0%a6%b0-%e0%a6%9f%e0%a6%be%e0%a6%a8%e0%a6%be-%e0%a7%af-%e0%a6%98%e0%a6%a3%e0%a7%8d%e0%a6%9f%e0%a6%be-%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%87%e0%a6%b0/">উন্নয়নসংবাদডটকম</source>
    </item>
    <item>
      <title>তিন হাজার কোটি টাকার বেশি অর্ডার অন্য দেশে সরে গেছে: বিজিএমইএ</title>

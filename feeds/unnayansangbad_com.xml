    <item>
      <title>শেরপুরে গজনী পর্যটন কেন্দ্র পরিদর্শনে ট্যুরিস্ট পুলিশ সুপার</title>
      <link>https://www.unnayansangbad.com/122282/%e0%a6%b6%e0%a7%87%e0%a6%b0%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87-%e0%a6%97%e0%a6%9c%e0%a6%a8%e0%a7%80-%e0%a6%aa%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%9f%e0%a6%a8-%e0%a6%95%e0%a7%87%e0%a6%a8%e0%a7%8d/</link>
      <guid isPermaLink="true">https://www.unnayansangbad.com/122282/%e0%a6%b6%e0%a7%87%e0%a6%b0%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87-%e0%a6%97%e0%a6%9c%e0%a6%a8%e0%a7%80-%e0%a6%aa%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%9f%e0%a6%a8-%e0%a6%95%e0%a7%87%e0%a6%a8%e0%a7%8d/</guid>
      <pubDate>Wed, 25 Nov 2026 09:38:01 +0000</pubDate>
      <enclosure url="https://www.unnayansangbad.com/wp-content/uploads/2026/11/IMG-20261125-WA0012-300x225.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.unnayansangbad.com/wp-content/uploads/2026/11/IMG-20261125-WA0012-300x225.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.unnayansangbad.com/wp-content/uploads/2026/11/IMG-20261125-WA0012-300x225.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শেরপুরে গজনী পর্যটন কেন্দ্র পরিদর্শনে ট্যুরিস্ট পুলিশ সুপার" /&gt;&lt;/p&gt;&lt;p&gt;শীত মৌসুম ঘিরে পর্যটকদের আগমনে নতুন প্রাণচাঞ্চল্য ফিরে আসতে শুরু করেছে দেশের বিভিন্ন পর্যটনকেন্দ্রে। প্রকৃতির অপরূপ সৌন্দর্য আর বিনোদনের টানে ভ্রমণপিপাসু মানুষের অন্যতম আকর্ষণ শেরপুরের গজনী পর্যটন ও অবকাশ কেন্দ্রও প্রস্তুত হচ্ছে নতুন মৌসুমের জন্য। তবে পর্যটকদের কাছে ভ্রমণ আনন্দময় করে তোলার পাশাপাশি &lt;/p&gt;</description>
      <source url="https://www.unnayansangbad.com/122282/%e0%a6%b6%e0%a7%87%e0%a6%b0%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87-%e0%a6%97%e0%a6%9c%e0%a6%a8%e0%a7%80-%e0%a6%aa%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%9f%e0%a6%a8-%e0%a6%95%e0%a7%87%e0%a6%a8%e0%a7%8d/">উন্নয়নসংবাদডটকম</source>
    </item>

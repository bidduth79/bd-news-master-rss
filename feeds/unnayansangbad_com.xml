      <guid isPermaLink="true">https://www.unnayansangbad.com/122164/%e0%a6%a4%e0%a6%bf%e0%a6%a8-%e0%a6%b9%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0-%e0%a6%95%e0%a7%8b%e0%a6%9f%e0%a6%bf-%e0%a6%9f%e0%a6%be%e0%a6%95%e0%a6%be%e0%a6%b0-%e0%a6%ac%e0%a7%87%e0%a6%b6%e0%a6%bf/</guid>
      <pubDate>Sun, 22 Nov 2026 16:30:15 +0000</pubDate>
      <description>দেশের তৈরি পোশাকশিল্পে চলমান অস্থিরতা ও উৎপাদন বিঘ্নের কারণে বড় ধরনের ক্ষতির আশঙ্কা তৈরি হয়েছে। নভেম্বরের প্রথম ১৮ দিনে ৩১৭টি পোশাক কারখানায় উৎপাদন ক্ষতি হয়েছে প্রায় ৪২ কোটি ৮০ লাখ মার্কিন ডলার। একই সময়ে বিদেশি ক্রেতারা প্রায় ২৫ কোটি ৪০ লাখ ডলারের (বাংলাদেশি মুদ্রায় ৩ হাজার ১৫৪ কোটি ৩ লাখ টাকা প্রায়</description>
      <source url="https://www.unnayansangbad.com/122164/%e0%a6%a4%e0%a6%bf%e0%a6%a8-%e0%a6%b9%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0-%e0%a6%95%e0%a7%8b%e0%a6%9f%e0%a6%bf-%e0%a6%9f%e0%a6%be%e0%a6%95%e0%a6%be%e0%a6%b0-%e0%a6%ac%e0%a7%87%e0%a6%b6%e0%a6%bf/">উন্নয়নসংবাদডটকম</source>
    </item>
    <item>
      <title>হাসিনার প্রবেশের পথ খুঁজতে সীমান্তে চার নেতা, ইমিগ্রেশনে রুদ্ধদ্বার বৈঠক</title>
      <link>https://www.unnayansangbad.com/122161/%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%a8%e0%a6%be%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%ac%e0%a7%87%e0%a6%b6%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a6%a5-%e0%a6%96%e0%a7%81%e0%a6%81%e0%a6%9c/</link>

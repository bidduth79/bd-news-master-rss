    <item>
      <title>আন্তর্জাতিক আদালতে রোহিঙ্গা গণহত্যা মামলার রায় আজ</title>
      <link>https://www.unnayansangbad.com/122067/%e0%a6%86%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a6%b0%e0%a7%8d%e0%a6%9c%e0%a6%be%e0%a6%a4%e0%a6%bf%e0%a6%95-%e0%a6%86%e0%a6%a6%e0%a6%be%e0%a6%b2%e0%a6%a4%e0%a7%87-%e0%a6%b0%e0%a7%8b%e0%a6%b9%e0%a6%bf%e0%a6%99/</link>

    </item>
    <item>
      <title>কম জমিতে বেশি ফসল: কৃষির সংকট মোকাবিলায় পথ দেখাচ্ছে বাকৃবির গবেষণা</title>
      <link>https://www.unnayansangbad.com/121992/%e0%a6%95%e0%a6%ae-%e0%a6%9c%e0%a6%ae%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%ac%e0%a7%87%e0%a6%b6%e0%a6%bf-%e0%a6%ab%e0%a6%b8%e0%a6%b2-%e0%a6%95%e0%a7%83%e0%a6%b7%e0%a6%bf%e0%a6%b0-%e0%a6%b8%e0%a6%82/</link>

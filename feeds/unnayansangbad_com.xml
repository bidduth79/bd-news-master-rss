      <pubDate>Thu, 19 Nov 2026 05:55:25 +0000</pubDate>
      <description>গ্যাসের আবাসিক গ্রাহকদের প্রিপেইড মিটার দেবে না বিতরণ কোম্পানিগুলো। প্রিপেইড মিটার স্থাপনের সব প্রকল্প বাতিল, এমনকি ঢাকা-নারায়ণগঞ্জের পুরাতন পাইপলাইন পরিবর্তনের প্রকল্পও বাতিল করা হয়েছে। বিদ্যুতের প্রিপেইড মিটারের বিরুদ্ধে নানা রকম অভিযোগ-আন্দোলন হলেও গ্যাসের মিটারের জন্য উন্মুখ হয়ে রয়েছে গ্রাহকরা। </description>
      <source url="https://www.unnayansangbad.com/122076/%e0%a6%86%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%95-%e0%a6%97%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%b8%e0%a7%87-%e0%a6%86%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%bf%e0%a6%aa%e0%a7%87%e0%a6%87/">উন্নয়নসংবাদডটকম</source>
    </item>
    <item>
      <title>আওয়ামী লীগকে বাদ দিয়ে কোনো আলোচনা ‘জাতীয় সংলাপ’ হবে না: রুমিন ফারহানা</title>
      <link>https://www.unnayansangbad.com/122073/%e0%a6%86%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%ae%e0%a7%80-%e0%a6%b2%e0%a7%80%e0%a6%97%e0%a6%95%e0%a7%87-%e0%a6%ac%e0%a6%be%e0%a6%a6-%e0%a6%a6%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%95/</link>

    <item>
      <title>রোহিঙ্গা নির্মূল অভিযানে প্রায় ১০ হাজার মানুষ হত্যার প্রমাণ পেয়েছে আইসিজে</title>
      <link>https://www.unnayansangbad.com/122080/%e0%a6%b0%e0%a7%8b%e0%a6%b9%e0%a6%bf%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a6%be-%e0%a6%a8%e0%a6%bf%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a7%82%e0%a6%b2-%e0%a6%85%e0%a6%ad%e0%a6%bf%e0%a6%af%e0%a6%be%e0%a6%a8%e0%a7%87/</link>

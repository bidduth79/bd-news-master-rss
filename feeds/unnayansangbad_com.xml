    <item>
      <title>আফগানিস্তানে নারীদের আসল নাম ব্যবহার নিষিদ্ধ, ‘বিবি’ সম্বোধনের নির্দেশ</title>
      <link>https://www.unnayansangbad.com/122402/%e0%a6%86%e0%a6%ab%e0%a6%97%e0%a6%be%e0%a6%a8%e0%a6%bf%e0%a6%b8%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%a8%e0%a6%be%e0%a6%b0%e0%a7%80%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%86%e0%a6%b8%e0%a6%b2/</link>
      <guid isPermaLink="true">https://www.unnayansangbad.com/122402/%e0%a6%86%e0%a6%ab%e0%a6%97%e0%a6%be%e0%a6%a8%e0%a6%bf%e0%a6%b8%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%a8%e0%a6%be%e0%a6%b0%e0%a7%80%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%86%e0%a6%b8%e0%a6%b2/</guid>
      <pubDate>Sat, 28 Nov 2026 12:30:04 +0000</pubDate>
      <description>আফগানিস্তানের উত্তরাঞ্চলীয় বালখ প্রদেশে সরকারি নথিপত্রে নারীদের প্রকৃত নাম ব্যবহার নিষিদ্ধ করেছে তালেবান সরকার। নারীদের নামের পরিবর্তে ‘বিবি’ বলে সম্বোধন করার নির্দেশ দেওয়া হয়েছে স্বাস্থ্যকর্মী ও সরকারি কর্মচারীদের। এ নিয়ে উদ্বেগ প্রকাশ করেছেন নারী অধিকারকর্মীরা। স্পেনের সংবাদমাধ্যম এল পাইসের প্রতিব</description>
      <source url="https://www.unnayansangbad.com/122402/%e0%a6%86%e0%a6%ab%e0%a6%97%e0%a6%be%e0%a6%a8%e0%a6%bf%e0%a6%b8%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%a8%e0%a6%be%e0%a6%b0%e0%a7%80%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%86%e0%a6%b8%e0%a6%b2/">উন্নয়নসংবাদডটকম</source>
    </item>
    <item>
      <title>শেখ হাসিনা ডিসেম্বরে আসবেন না, কোনো সম্ভাবনাই নেই</title>
      <link>https://www.unnayansangbad.com/122399/%e0%a6%b6%e0%a7%87%e0%a6%96-%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%a8%e0%a6%be-%e0%a6%a1%e0%a6%bf%e0%a6%b8%e0%a7%87%e0%a6%ae%e0%a7%8d%e0%a6%ac%e0%a6%b0%e0%a7%87-%e0%a6%86%e0%a6%b8%e0%a6%ac/</link>
      <guid isPermaLink="true">https://www.unnayansangbad.com/122399/%e0%a6%b6%e0%a7%87%e0%a6%96-%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%a8%e0%a6%be-%e0%a6%a1%e0%a6%bf%e0%a6%b8%e0%a7%87%e0%a6%ae%e0%a7%8d%e0%a6%ac%e0%a6%b0%e0%a7%87-%e0%a6%86%e0%a6%b8%e0%a6%ac/</guid>
      <pubDate>Sat, 28 Nov 2026 12:25:40 +0000</pubDate>
      <description>প্রধানমন্ত্রীর তথ্য ও সম্প্রচারবিষয়ক উপদেষ্টা ডা. জাহেদ উর রহমান বলেছেন, ডিসেম্বর আসছে। এক পালিয়ে যাওয়া স্বৈরাচার শেখ হাসিনা দেশে ফিরে আসার আওয়াজ তুলছেন। তবে তার ফিরে আসার কোনো সম্ভাবনাই নেই। শনিবার (২৮ নভেম্বর) সকালে জুলাই গণঅভ্যুত্থান স্মৃতি জাদুঘরে জুলাই বিপ্লবের শহীদদের স্মৃতিচিহ্ন নিয়ে প্রদর্শন</description>
      <source url="https://www.unnayansangbad.com/122399/%e0%a6%b6%e0%a7%87%e0%a6%96-%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%a8%e0%a6%be-%e0%a6%a1%e0%a6%bf%e0%a6%b8%e0%a7%87%e0%a6%ae%e0%a7%8d%e0%a6%ac%e0%a6%b0%e0%a7%87-%e0%a6%86%e0%a6%b8%e0%a6%ac/">উন্নয়নসংবাদডটকম</source>
    </item>
    <item>
      <title>অগ্নিসন্ত্রাসের মধ্যেও ধৈর্যের সঙ্গে পরিস্থিতি মোকাবিলা করছে সরকার: রিজভী</title>
      <link>https://www.unnayansangbad.com/122396/%e0%a6%85%e0%a6%97%e0%a7%8d%e0%a6%a8%e0%a6%bf%e0%a6%b8%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%b8%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a6%a7%e0%a7%8d%e0%a6%af%e0%a7%87%e0%a6%93-%e0%a6%a7/</link>
      <guid isPermaLink="true">https://www.unnayansangbad.com/122396/%e0%a6%85%e0%a6%97%e0%a7%8d%e0%a6%a8%e0%a6%bf%e0%a6%b8%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%b8%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a6%a7%e0%a7%8d%e0%a6%af%e0%a7%87%e0%a6%93-%e0%a6%a7/</guid>
      <pubDate>Sat, 28 Nov 2026 12:23:58 +0000</pubDate>
      <description>অগ্নিসন্ত্রাস ও রক্তপাতের মধ্যেও তারেক রহমানের সরকার গণতন্ত্র ও মানবাধিকারের নীতিমালা মেনে ধৈর্যের সঙ্গে পরিস্থিতি মোকাবিলা করছে বলে মন্তব্য করেছেন বিএনপির ভারপ্রাপ্ত মহাসচিব রুহুল কবির রিজভী। শনিবার (২৮ নভেম্বর) দুপুরে রাজধানীর নয়াপল্টনে বিএনপির কেন্দ্রীয় কার্যালয়ে আয়োজিত সংবাদ সম্মেলনে তিনি এ মন্ত</description>
      <source url="https://www.unnayansangbad.com/122396/%e0%a6%85%e0%a6%97%e0%a7%8d%e0%a6%a8%e0%a6%bf%e0%a6%b8%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%b8%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a6%a7%e0%a7%8d%e0%a6%af%e0%a7%87%e0%a6%93-%e0%a6%a7/">উন্নয়নসংবাদডটকম</source>
    </item>
    <item>
      <title>পরিকল্পনা ছাড়া অনার্স কোর্স: কোথাও শিক্ষক আছে ছাত্র নেই, কোথাও উল্টোটা, ক্ষোভ শিক্ষামন্ত্রীর</title>
      <link>https://www.unnayansangbad.com/122393/%e0%a6%aa%e0%a6%b0%e0%a6%bf%e0%a6%95%e0%a6%b2%e0%a7%8d%e0%a6%aa%e0%a6%a8%e0%a6%be-%e0%a6%9b%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a6%be-%e0%a6%85%e0%a6%a8%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%b8-%e0%a6%95/</link>

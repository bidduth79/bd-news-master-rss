    <item>
      <title>কক্সবাজারে বাস-অটোরিকশা সংঘর্ষ, নিহত বেড়ে ৫</title>
      <link>https://www.unnayansangbad.com/122265/%e0%a6%95%e0%a6%95%e0%a7%8d%e0%a6%b8%e0%a6%ac%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0%e0%a7%87-%e0%a6%ac%e0%a6%be%e0%a6%b8-%e0%a6%85%e0%a6%9f%e0%a7%8b%e0%a6%b0%e0%a6%bf%e0%a6%95%e0%a6%b6%e0%a6%be/</link>
      <guid isPermaLink="true">https://www.unnayansangbad.com/122265/%e0%a6%95%e0%a6%95%e0%a7%8d%e0%a6%b8%e0%a6%ac%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0%e0%a7%87-%e0%a6%ac%e0%a6%be%e0%a6%b8-%e0%a6%85%e0%a6%9f%e0%a7%8b%e0%a6%b0%e0%a6%bf%e0%a6%95%e0%a6%b6%e0%a6%be/</guid>
      <pubDate>Tue, 24 Nov 2026 16:15:37 +0000</pubDate>
      <description>কক্সবাজার-চট্টগ্রাম মহাসড়কের ঈদগাঁওতে যাত্রীবাহী হানিফ পরিবহনের একটি বাসের সঙ্গে অটোরিকশার মুখোমুখি সংঘর্ষে পাঁচজন নিহত হয়েছেন। মঙ্গলবার (২৪ নভেম্বর) সন্ধ্যা সোয়া ৬টার দিকে ঈদগাঁও থানাসংলগ্ন কক্সবাজার-চট্টগ্রাম মহাসড়কে এ দুর্ঘটনা ঘটে। নিহতের মধ্যে তিনজনের পরিচয় পাওয়া গেছে। তারা হলেন চকরিয়‍ার খুটাখাল</description>
      <source url="https://www.unnayansangbad.com/122265/%e0%a6%95%e0%a6%95%e0%a7%8d%e0%a6%b8%e0%a6%ac%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0%e0%a7%87-%e0%a6%ac%e0%a6%be%e0%a6%b8-%e0%a6%85%e0%a6%9f%e0%a7%8b%e0%a6%b0%e0%a6%bf%e0%a6%95%e0%a6%b6%e0%a6%be/">উন্নয়নসংবাদডটকম</source>
    </item>
    <item>
      <title>ময়মনসিংহে ডেটিং অ্যাপে নারীদের ছবি ব্যবহার করে প্রতারণা, গ্রেপ্তার ৭</title>
      <link>https://www.unnayansangbad.com/122262/%e0%a6%ae%e0%a6%af%e0%a6%bc%e0%a6%ae%e0%a6%a8%e0%a6%b8%e0%a6%bf%e0%a6%82%e0%a6%b9%e0%a7%87-%e0%a6%a1%e0%a7%87%e0%a6%9f%e0%a6%bf%e0%a6%82-%e0%a6%85%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%aa%e0%a7%87/</link>
      <guid isPermaLink="true">https://www.unnayansangbad.com/122262/%e0%a6%ae%e0%a6%af%e0%a6%bc%e0%a6%ae%e0%a6%a8%e0%a6%b8%e0%a6%bf%e0%a6%82%e0%a6%b9%e0%a7%87-%e0%a6%a1%e0%a7%87%e0%a6%9f%e0%a6%bf%e0%a6%82-%e0%a6%85%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%aa%e0%a7%87/</guid>
      <pubDate>Tue, 24 Nov 2026 16:11:50 +0000</pubDate>
      <description>ময়মনসিংহে ‘মেগা পার্সনাল’ নামক ডেটিং অ্যাপ ব্যবহার করে নারীদের ছবি ও পরিচয়ের আড়ালে বিভিন্ন শ্রেণি-পেশার মানুষের সঙ্গে প্রতারণা করে টাকা হাতিয়ে নেওয়ার অভিযোগে একটি চক্রের ৭ সদস্যকে গ্রেপ্তার করেছে পুলিশ। মঙ্গলবার দুপুরে নিজ কার্যালয়ে আয়োজিত এক সংবাদ সম্মেলনে এসব তথ্য জানান ময়মনসিংহের পুলিশ সুপার মোহা</description>
      <source url="https://www.unnayansangbad.com/122262/%e0%a6%ae%e0%a6%af%e0%a6%bc%e0%a6%ae%e0%a6%a8%e0%a6%b8%e0%a6%bf%e0%a6%82%e0%a6%b9%e0%a7%87-%e0%a6%a1%e0%a7%87%e0%a6%9f%e0%a6%bf%e0%a6%82-%e0%a6%85%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%aa%e0%a7%87/">উন্নয়নসংবাদডটকম</source>
    </item>
    <item>
      <title>৫৫ দলের সঙ্গে সংলাপে বসছে ইসি, তালিকায় যারা</title>
      <link>https://www.unnayansangbad.com/122259/%e0%a7%ab%e0%a7%ab-%e0%a6%a6%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%87-%e0%a6%b8%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%aa%e0%a7%87-%e0%a6%ac%e0%a6%b8%e0%a6%9b%e0%a7%87/</link>
      <guid isPermaLink="true">https://www.unnayansangbad.com/122259/%e0%a7%ab%e0%a7%ab-%e0%a6%a6%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%87-%e0%a6%b8%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%aa%e0%a7%87-%e0%a6%ac%e0%a6%b8%e0%a6%9b%e0%a7%87/</guid>
      <pubDate>Tue, 24 Nov 2026 15:58:23 +0000</pubDate>
      <description>আসন্ন ইউনিয়ন পরিষদ (ইউপি) নির্বাচন অবাধ, সুষ্ঠু ও গ্রহণযোগ্য করতে রাজনৈতিক দলগুলোর সঙ্গে ধারাবাহিক সংলাপের উদ্যোগ নিয়েছে নির্বাচন কমিশন (ইসি)। আগামী ২৯ নভেম্বর থেকে শুরু হয়ে ১ ডিসেম্বর পর্যন্ত তিন দিনব্যাপী এ সংলাপ অনুষ্ঠিত হবে। এতে অংশ নিতে দেশের ৫৫টি রাজনৈতিক দলকে আমন্ত্রণ জানিয়েছে কমিশন। মঙ্গলবার</description>
      <source url="https://www.unnayansangbad.com/122259/%e0%a7%ab%e0%a7%ab-%e0%a6%a6%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%87-%e0%a6%b8%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%aa%e0%a7%87-%e0%a6%ac%e0%a6%b8%e0%a6%9b%e0%a7%87/">উন্নয়নসংবাদডটকম</source>
    </item>
    <item>
      <title>সৌদির রাজধানীতে আকাশচুম্বী ভবনে হুথিদের হামলা, আহত ১১</title>
      <link>https://www.unnayansangbad.com/122256/%e0%a6%b8%e0%a7%8c%e0%a6%a6%e0%a6%bf%e0%a6%b0-%e0%a6%b0%e0%a6%be%e0%a6%9c%e0%a6%a7%e0%a6%be%e0%a6%a8%e0%a7%80%e0%a6%a4%e0%a7%87-%e0%a6%86%e0%a6%95%e0%a6%be%e0%a6%b6%e0%a6%9a%e0%a7%81%e0%a6%ae%e0%a7%8d/</link>
      <guid isPermaLink="true">https://www.unnayansangbad.com/122256/%e0%a6%b8%e0%a7%8c%e0%a6%a6%e0%a6%bf%e0%a6%b0-%e0%a6%b0%e0%a6%be%e0%a6%9c%e0%a6%a7%e0%a6%be%e0%a6%a8%e0%a7%80%e0%a6%a4%e0%a7%87-%e0%a6%86%e0%a6%95%e0%a6%be%e0%a6%b6%e0%a6%9a%e0%a7%81%e0%a6%ae%e0%a7%8d/</guid>
      <pubDate>Tue, 24 Nov 2026 15:55:13 +0000</pubDate>
      <description>মধ্যপ্রাচ্যের দেশ সৌদি আরবের রাজধানী রিয়াদের আকাশচুম্বী এক ভবনে ইয়েমেনের হুথি যোদ্ধাদের হামলায় অন্তত ১১ জন আহত হয়েছেন। মঙ্গলবার রিয়াদের আকাশচুম্বী ওই ভবনে হামলার ঘটনা ঘটে বলে দেশটির সিভিল ডিফেন্স জানিয়েছে। দেশটির রাষ্ট্রায়ত্ত সংবাদমাধ্যম সৌদি প্রেস এজেন্সির (এসপিএ) প্রতিবেদনে বলা হয়েছে, রিয়াদের আর্থ</description>
      <source url="https://www.unnayansangbad.com/122256/%e0%a6%b8%e0%a7%8c%e0%a6%a6%e0%a6%bf%e0%a6%b0-%e0%a6%b0%e0%a6%be%e0%a6%9c%e0%a6%a7%e0%a6%be%e0%a6%a8%e0%a7%80%e0%a6%a4%e0%a7%87-%e0%a6%86%e0%a6%95%e0%a6%be%e0%a6%b6%e0%a6%9a%e0%a7%81%e0%a6%ae%e0%a7%8d/">উন্নয়নসংবাদডটকম</source>
    </item>
    <item>
      <title>বিশ্বদরবারে সশস্ত্র বাহিনীর সক্ষমতা তুলে ধরবে যৌথ মহড়া: প্রধানমন্ত্রী</title>
      <link>https://www.unnayansangbad.com/122253/%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%ac%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%b0%e0%a7%87-%e0%a6%b8%e0%a6%b6%e0%a6%b8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0-%e0%a6%ac%e0%a6%be%e0%a6%b9%e0%a6%bf/</link>
      <guid isPermaLink="true">https://www.unnayansangbad.com/122253/%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%ac%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%b0%e0%a7%87-%e0%a6%b8%e0%a6%b6%e0%a6%b8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0-%e0%a6%ac%e0%a6%be%e0%a6%b9%e0%a6%bf/</guid>
      <pubDate>Tue, 24 Nov 2026 15:48:39 +0000</pubDate>
      <description>প্রধানমন্ত্রী তারেক রহমান বলেছেন, তিন বাহিনীর যৌথ সামরিক মহড়া বিশ্বদরবারে বাংলাদেশের সশস্ত্র বাহিনীর সক্ষমতা তুলে ধরবে। তিনি বলেন, বাংলাদেশের সামরিক বাহিনীর ইতিহাসে আজ একটি নতুন অধ্যায়ের সূচনা হয়েছে। দেশের ইতিহাসে প্রথমবারের মতো তিন বাহিনীর স্পেশাল ফোর্সের সমন্বয়ে অনুষ্ঠিত যৌথ সামরিক মহড়ার সাক্ষী হত</description>
      <source url="https://www.unnayansangbad.com/122253/%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%ac%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%b0%e0%a7%87-%e0%a6%b8%e0%a6%b6%e0%a6%b8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0-%e0%a6%ac%e0%a6%be%e0%a6%b9%e0%a6%bf/">উন্নয়নসংবাদডটকম</source>
    </item>
    <item>
      <title>ভাগ্যিস শেখ হাসিনা প্রধানমন্ত্রীর দায়িত্ব চাননি: জাহেদ উর রহমান</title>
      <link>https://www.unnayansangbad.com/122249/%e0%a6%ad%e0%a6%be%e0%a6%97%e0%a7%8d%e0%a6%af%e0%a6%bf%e0%a6%b8-%e0%a6%b6%e0%a7%87%e0%a6%96-%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%a8%e0%a6%be-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a7%e0%a6%be/</link>
      <guid isPermaLink="true">https://www.unnayansangbad.com/122249/%e0%a6%ad%e0%a6%be%e0%a6%97%e0%a7%8d%e0%a6%af%e0%a6%bf%e0%a6%b8-%e0%a6%b6%e0%a7%87%e0%a6%96-%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%a8%e0%a6%be-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a7%e0%a6%be/</guid>
      <pubDate>Tue, 24 Nov 2026 15:46:53 +0000</pubDate>
      <description>প্রধানমন্ত্রীর তথ্য ও সম্প্রচার উপদেষ্টা জাহেদ উর রহমান বলেছেন, শেখ হাসিনা বাংলাদেশ বিমানে আসতে চান। ভাগ্যিস তিনি বলছেন না, তাকে বাংলাদেশের প্রধানমন্ত্রী করা হোক। ভারতে অবস্থানরত ক্ষমতাচ্যুত প্রধানমন্ত্রী শেখ হাসিনা আগামী ১৬ ডিসেম্বর বিজয় দিবসে বিমান বাংলাদেশ এয়ারলাইনসের করে দিল্লি থেকে দেশে ফিরতে</description>
      <source url="https://www.unnayansangbad.com/122249/%e0%a6%ad%e0%a6%be%e0%a6%97%e0%a7%8d%e0%a6%af%e0%a6%bf%e0%a6%b8-%e0%a6%b6%e0%a7%87%e0%a6%96-%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%a8%e0%a6%be-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a7%e0%a6%be/">উন্নয়নসংবাদডটকম</source>
    </item>
    <item>
      <title>পুলিশের ঊর্ধ্বতন ১৪ কর্মকর্তাকে বদলি</title>

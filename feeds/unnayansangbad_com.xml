    <item>
      <title>সন্ত্রাসীদের পাসপোর্ট নয়, হ্যান্ডকাফ লাগে: পররাষ্ট্র প্রতিমন্ত্রী</title>
      <link>https://www.unnayansangbad.com/122115/%e0%a6%b8%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%b8%e0%a7%80%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a6%be%e0%a6%b8%e0%a6%aa%e0%a7%8b%e0%a6%b0%e0%a7%8d%e0%a6%9f-%e0%a6%a8%e0%a6%af/</link>

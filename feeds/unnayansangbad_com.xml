    <item>
      <title>টুঙ্গীপাড়া থানায় আগুন দিল আওয়ামী লীগ ও ছাত্রলীগের কর্মীরা</title>
      <link>https://www.unnayansangbad.com/122017/%e0%a6%9f%e0%a7%81%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%80%e0%a6%aa%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a6%be-%e0%a6%a5%e0%a6%be%e0%a6%a8%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%86%e0%a6%97%e0%a7%81%e0%a6%a8/</link>
      <guid isPermaLink="true">https://www.unnayansangbad.com/122017/%e0%a6%9f%e0%a7%81%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%80%e0%a6%aa%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a6%be-%e0%a6%a5%e0%a6%be%e0%a6%a8%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%86%e0%a6%97%e0%a7%81%e0%a6%a8/</guid>
      <pubDate>Tue, 17 Nov 2026 16:38:35 +0000</pubDate>
      <description>গোপালগঞ্জের টুঙ্গিপাড়া থানায় হামলা, ভাঙচুর ও অগ্নিসংযোগের ঘটনা ঘটেছে। কার্যক্রম নিষিদ্ধ আওয়ামী লীগ ও নিষিদ্ধ ছাত্রলীগের নেতাকর্মীরা থানা ঘেরাও করে এ হামলা চালিয়ে। আজ মঙ্গলবার সন্ধ্যা ৭টার দিকে এ ঘটনা ঘটে। রাত ৮টার পরও থানায় হামলা ও তাণ্ডব চলছিল। স্থানীয় সূত্রে জানা যায়, গত ১০ ও ১৫ নভেম্বর আওয</description>
      <source url="https://www.unnayansangbad.com/122017/%e0%a6%9f%e0%a7%81%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%80%e0%a6%aa%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a6%be-%e0%a6%a5%e0%a6%be%e0%a6%a8%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%86%e0%a6%97%e0%a7%81%e0%a6%a8/">উন্নয়নসংবাদডটকম</source>
    </item>
    <item>
      <title>গোপালগঞ্জে বিএনপির এমপি জিলানীর বাড়িতে আগুন</title>
      <link>https://www.unnayansangbad.com/122014/%e0%a6%97%e0%a7%8b%e0%a6%aa%e0%a6%be%e0%a6%b2%e0%a6%97%e0%a6%9e%e0%a7%8d%e0%a6%9c%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%8f%e0%a6%a8%e0%a6%aa%e0%a6%bf%e0%a6%b0-%e0%a6%8f%e0%a6%ae%e0%a6%aa%e0%a6%bf/</link>
      <guid isPermaLink="true">https://www.unnayansangbad.com/122014/%e0%a6%97%e0%a7%8b%e0%a6%aa%e0%a6%be%e0%a6%b2%e0%a6%97%e0%a6%9e%e0%a7%8d%e0%a6%9c%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%8f%e0%a6%a8%e0%a6%aa%e0%a6%bf%e0%a6%b0-%e0%a6%8f%e0%a6%ae%e0%a6%aa%e0%a6%bf/</guid>
      <pubDate>Tue, 17 Nov 2026 16:36:17 +0000</pubDate>
      <description>গোপালগঞ্জ-৩ আসনে বিএনপি দলীয় সংসদ সদস্য (এমপি) এস এম জিলানীর বাড়িতে আগুন দিয়েছে কার্যক্রম নিষিদ্ধ আওয়ামী লীগ ও সহযোগী সংগঠনের নেতাকর্মীরা। আজ মঙ্গলবার রাত পৌনে ৯টার দিকে তার বাসায় আগুন দেওয়া হয়। এর আগে নিষিদ্ধ ছাত্রলীগের নেতাকর্মীদের গ্রেপ্তারের প্রতিবাদে লাঠিসোঁটা নিয়ে গোপালগঞ্জের টুঙ্গিপাড</description>
      <source url="https://www.unnayansangbad.com/122014/%e0%a6%97%e0%a7%8b%e0%a6%aa%e0%a6%be%e0%a6%b2%e0%a6%97%e0%a6%9e%e0%a7%8d%e0%a6%9c%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%8f%e0%a6%a8%e0%a6%aa%e0%a6%bf%e0%a6%b0-%e0%a6%8f%e0%a6%ae%e0%a6%aa%e0%a6%bf/">উন্নয়নসংবাদডটকম</source>
    </item>
    <item>
      <title>লেখাপড়ার পাশাপাশি খেলাধুলা-সংস্কৃতিতেও দক্ষ হতে হবে: প্রধানমন্ত্রী</title>
      <link>https://www.unnayansangbad.com/122010/%e0%a6%b2%e0%a7%87%e0%a6%96%e0%a6%be%e0%a6%aa%e0%a6%a1%e0%a6%bc%e0%a6%be%e0%a6%b0-%e0%a6%aa%e0%a6%be%e0%a6%b6%e0%a6%be%e0%a6%aa%e0%a6%be%e0%a6%b6%e0%a6%bf-%e0%a6%96%e0%a7%87%e0%a6%b2%e0%a6%be%e0%a6%a7/</link>
      <guid isPermaLink="true">https://www.unnayansangbad.com/122010/%e0%a6%b2%e0%a7%87%e0%a6%96%e0%a6%be%e0%a6%aa%e0%a6%a1%e0%a6%bc%e0%a6%be%e0%a6%b0-%e0%a6%aa%e0%a6%be%e0%a6%b6%e0%a6%be%e0%a6%aa%e0%a6%be%e0%a6%b6%e0%a6%bf-%e0%a6%96%e0%a7%87%e0%a6%b2%e0%a6%be%e0%a6%a7/</guid>
      <pubDate>Tue, 17 Nov 2026 13:49:30 +0000</pubDate>
      <description>লেখাপড়ার পাশাপাশি খেলাধুলা ও শিল্প-সংস্কৃতিতেও নিজেদের দক্ষ করে গড়ে তুলেতে শিক্ষার্থীদের প্রতি আহব্বান জানিয়েছেন প্রধানমন্ত্রী তারেক রহমান। মঙ্গলবার (১৭ নভেম্বর) জাতীয় সংসদ সচিবালয়ে হবিগঞ্জের বিভিন্ন শিক্ষাপ্রতিষ্ঠানের ১২৪ জন শিক্ষার্থী ও ২৬ জন শিক্ষক সৌজন্য সাক্ষাৎ করতে এলে প্রধানমন্ত্রী এসব কথা বল</description>
      <source url="https://www.unnayansangbad.com/122010/%e0%a6%b2%e0%a7%87%e0%a6%96%e0%a6%be%e0%a6%aa%e0%a6%a1%e0%a6%bc%e0%a6%be%e0%a6%b0-%e0%a6%aa%e0%a6%be%e0%a6%b6%e0%a6%be%e0%a6%aa%e0%a6%be%e0%a6%b6%e0%a6%bf-%e0%a6%96%e0%a7%87%e0%a6%b2%e0%a6%be%e0%a6%a7/">উন্নয়নসংবাদডটকম</source>
    </item>
    <item>
      <title>জুলাই হত্যা মামলায় সাঈদ খোকন ৭ দিনের রিমান্ডে</title>
      <link>https://www.unnayansangbad.com/122007/%e0%a6%9c%e0%a7%81%e0%a6%b2%e0%a6%be%e0%a6%87-%e0%a6%b9%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a6%be-%e0%a6%ae%e0%a6%be%e0%a6%ae%e0%a6%b2%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%b8%e0%a6%be%e0%a6%88%e0%a6%a6/</link>
      <guid isPermaLink="true">https://www.unnayansangbad.com/122007/%e0%a6%9c%e0%a7%81%e0%a6%b2%e0%a6%be%e0%a6%87-%e0%a6%b9%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a6%be-%e0%a6%ae%e0%a6%be%e0%a6%ae%e0%a6%b2%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%b8%e0%a6%be%e0%a6%88%e0%a6%a6/</guid>
      <pubDate>Tue, 17 Nov 2026 13:32:55 +0000</pubDate>
      <description>বৈষম্যবিরোধী আন্দোলনের সময় রাজধানীর ধানমন্ডির জিগাতলায় আবদুল মোতালিব নামে এক কিশোর নিহতের মামলায় গ্রেপ্তার ঢাকা দক্ষিণ সিটি করপোরেশনের (ডিএসসিসি) সাবেক মেয়র মোহাম্মদ সাঈদ খোকনকে জিজ্ঞেসাবাদের জন্য ৭ দিনের রিমান্ড মঞ্জুর করেছেন আদালত। মঙ্গলবার (১৭ নভেম্বর) রাতে ঢাকার মেট্রোপলিটন ম্যাজিস্ট্রেট মেহেদী</description>
      <source url="https://www.unnayansangbad.com/122007/%e0%a6%9c%e0%a7%81%e0%a6%b2%e0%a6%be%e0%a6%87-%e0%a6%b9%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a6%be-%e0%a6%ae%e0%a6%be%e0%a6%ae%e0%a6%b2%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%b8%e0%a6%be%e0%a6%88%e0%a6%a6/">উন্নয়নসংবাদডটকম</source>
    </item>
    <item>
      <title>পদত্যাগপত্রে কী লিখেছেন ওসমান ফারুক</title>
      <link>https://www.unnayansangbad.com/122004/%e0%a6%aa%e0%a6%a6%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%97%e0%a6%aa%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a7%87-%e0%a6%95%e0%a7%80-%e0%a6%b2%e0%a6%bf%e0%a6%96%e0%a7%87%e0%a6%9b%e0%a7%87%e0%a6%a8-2/</link>
      <guid isPermaLink="true">https://www.unnayansangbad.com/122004/%e0%a6%aa%e0%a6%a6%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%97%e0%a6%aa%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a7%87-%e0%a6%95%e0%a7%80-%e0%a6%b2%e0%a6%bf%e0%a6%96%e0%a7%87%e0%a6%9b%e0%a7%87%e0%a6%a8-2/</guid>
      <pubDate>Tue, 17 Nov 2026 13:30:28 +0000</pubDate>
      <description>শারীরিক অসুস্থতা ও চিকিৎসাধীন থাকার কারণ দেখিয়ে জাতীয় সংসদ সদস্য পদ থেকে পদত্যাগ করেছেন বিএনপির ভাইস চেয়ারম্যান ও সাবেক শিক্ষামন্ত্রী ড. ওসমান ফারুক। জাতীয় সংসদের স্পিকার বরাবর পাঠানো পদত্যাগপত্রে তিনি উল্লেখ করেছেন, পদত্যাগের এই সিদ্ধান্ত নেওয়াটা তার জন্য অত্যন্ত কঠিন ও বেদনাদায়ক ছিল। সংশ্লিষ</description>
      <source url="https://www.unnayansangbad.com/122004/%e0%a6%aa%e0%a6%a6%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%97%e0%a6%aa%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a7%87-%e0%a6%95%e0%a7%80-%e0%a6%b2%e0%a6%bf%e0%a6%96%e0%a7%87%e0%a6%9b%e0%a7%87%e0%a6%a8-2/">উন্নয়নসংবাদডটকম</source>
    </item>
    <item>
      <title>গাজীপুরে ন্যূনতম মজুরির দাবিতে শ্রমিক বিক্ষোভ, টিয়ারশেল ও সাউন্ড গ্রেনেড নিক্ষেপ</title>
      <link>https://www.unnayansangbad.com/122001/%e0%a6%97%e0%a6%be%e0%a6%9c%e0%a7%80%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87-%e0%a6%a8%e0%a7%8d%e0%a6%af%e0%a7%82%e0%a6%a8%e0%a6%a4%e0%a6%ae-%e0%a6%ae%e0%a6%9c%e0%a7%81%e0%a6%b0%e0%a6%bf%e0%a6%b0/</link>

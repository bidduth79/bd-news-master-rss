      <pubDate>Fri, 27 Nov 2026 06:04:51 +0000</pubDate>
      <description>রাজধানীতে জনসংখ্যা ও আবাসনের চাপ কমাতে কেরানীগঞ্জে তিন হাজার একর জমিতে সেকেন্ডারি সিটি গড়ে তোলার পরিকল্পনা গ্রহণ করেছে সরকার। রাজধানীর পাশে নাগরিক সুবিধাসম্পন্ন পরিকল্পিত জনবসতি গড়ে তোলাই সেকেন্ডারি সিটির মূল লক্ষ্য। এর মাধ্যমে ঢাকার মূল নগর এলাকার বাইরে বসবাসের বিকল্প সুযোগ তৈরি হবে। সংশ্লিষ্ট কর্ম</description>
      <source url="https://www.unnayansangbad.com/122337/%e0%a6%a2%e0%a6%be%e0%a6%95%e0%a6%be%e0%a6%b0-%e0%a6%86%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%9a%e0%a6%be%e0%a6%aa-%e0%a6%95%e0%a6%ae%e0%a6%be%e0%a6%a4%e0%a7%87-%e0%a6%b8/">উন্নয়নসংবাদডটকম</source>
    </item>
    <item>
      <title>দেশি বলে বিক্রি হচ্ছে রং মেশানো মাছ, বাড়ছে ক্যান্সার-টিউমারের ঝুঁকি</title>
      <link>https://www.unnayansangbad.com/122334/%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a6%bf-%e0%a6%ac%e0%a6%b2%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b0%e0%a6%bf-%e0%a6%b9%e0%a6%9a%e0%a7%8d%e0%a6%9b%e0%a7%87-%e0%a6%b0%e0%a6%82-%e0%a6%ae/</link>

    <item>
      <title>খেলাপি ঋণ আরও ২০ হাজার কোটি বেড়ে ৬ লাখ ২৭ হাজার</title>
      <link>https://www.unnayansangbad.com/122200/%e0%a6%96%e0%a7%87%e0%a6%b2%e0%a6%be%e0%a6%aa%e0%a6%bf-%e0%a6%8b%e0%a6%a3-%e0%a6%86%e0%a6%b0%e0%a6%93-%e0%a7%a8%e0%a7%a6-%e0%a6%b9%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0-%e0%a6%95%e0%a7%8b%e0%a6%9f/</link>
      <guid isPermaLink="true">https://www.unnayansangbad.com/122200/%e0%a6%96%e0%a7%87%e0%a6%b2%e0%a6%be%e0%a6%aa%e0%a6%bf-%e0%a6%8b%e0%a6%a3-%e0%a6%86%e0%a6%b0%e0%a6%93-%e0%a7%a8%e0%a7%a6-%e0%a6%b9%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0-%e0%a6%95%e0%a7%8b%e0%a6%9f/</guid>
      <pubDate>Mon, 23 Nov 2026 06:14:16 +0000</pubDate>
      <description>গত তিন মাসের ব্যবধানে খেলাপি ঋণ বেড়েছে আরও ২০ হাজার কোটি টাকার বেশি। সেপ্টেম্বর শেষে দেশের মোট খেলাপি ঋণের পরিমাণ দাঁড়িয়েছে ৬ লাখ ২৭ হাজার ৪০৪ কোটি টাকা; যা বিতরণ করা ঋণের ৩৩ দশমিক ৮০ শতাংশ। বাংলাদেশ ব্যাংকের সবশেষ হিসাবে এ তথ্য উঠে এসেছে। বাংলাদেশ ব্যাংকের হিসাব অনুযায়ী, গত তিন মাসে সরকারি ব্যাংকে</description>
      <source url="https://www.unnayansangbad.com/122200/%e0%a6%96%e0%a7%87%e0%a6%b2%e0%a6%be%e0%a6%aa%e0%a6%bf-%e0%a6%8b%e0%a6%a3-%e0%a6%86%e0%a6%b0%e0%a6%93-%e0%a7%a8%e0%a7%a6-%e0%a6%b9%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0-%e0%a6%95%e0%a7%8b%e0%a6%9f/">উন্নয়নসংবাদডটকম</source>
    </item>
    <item>
      <title>চিকিৎসা নিতে বছরে বাংলাদেশীরা বিদেশে নেন ৫০০ কোটি ডলার: ডিসিসিআই</title>
      <link>https://www.unnayansangbad.com/122197/%e0%a6%9a%e0%a6%bf%e0%a6%95%e0%a6%bf%e0%a7%8e%e0%a6%b8%e0%a6%be-%e0%a6%a8%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%ac%e0%a6%9b%e0%a6%b0%e0%a7%87-%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%a6/</link>
      <guid isPermaLink="true">https://www.unnayansangbad.com/122197/%e0%a6%9a%e0%a6%bf%e0%a6%95%e0%a6%bf%e0%a7%8e%e0%a6%b8%e0%a6%be-%e0%a6%a8%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%ac%e0%a6%9b%e0%a6%b0%e0%a7%87-%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%a6/</guid>
      <pubDate>Mon, 23 Nov 2026 06:02:12 +0000</pubDate>
      <description>চিকিৎসা নিতে বাংলাদেশীদের মধ্যে বাড়ছে বিদেশমুখী প্রবণতা। সম্প্রতি এক বক্তব্যে প্রধানমন্ত্রী তারেক রহমান জানিয়েছেন, প্রতি বছর বিদেশে চিকিৎসার জন্য বাংলাদেশীরা খরচ করছেন ৫০০ কোটি ডলার। ঢাকা চেম্বার অব কমার্স অ্যান্ড ইন্ডাস্ট্রির (ডিসিসিআই) দেয়া এক প্রতিবেদনেও উঠে আসে একই তথ্য। তবে এই তথ্যের সঙ্গে মেলে</description>
      <source url="https://www.unnayansangbad.com/122197/%e0%a6%9a%e0%a6%bf%e0%a6%95%e0%a6%bf%e0%a7%8e%e0%a6%b8%e0%a6%be-%e0%a6%a8%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%ac%e0%a6%9b%e0%a6%b0%e0%a7%87-%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%a6/">উন্নয়নসংবাদডটকম</source>
    </item>
    <item>
      <title>নির্ধারিত সময়ে বিশ্ববিদ্যালয়ে ভর্তি পরীক্ষায় বাধা নেই: আপিল বিভাগ</title>
      <link>https://www.unnayansangbad.com/122194/%e0%a6%a8%e0%a6%bf%e0%a6%b0%e0%a7%8d%e0%a6%a7%e0%a6%be%e0%a6%b0%e0%a6%bf%e0%a6%a4-%e0%a6%b8%e0%a6%ae%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%ac%e0%a6%ac%e0%a6%bf%e0%a6%a6/</link>

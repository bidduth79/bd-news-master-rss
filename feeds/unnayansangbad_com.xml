    <item>
      <title>স্বৈরাচার আমলে ব্যাংক বিমা পুঁজিবাজারকে পরিকল্পিতভাবে ধ্বংস করা হয়েছে: রাষ্ট্রপ্রতি</title>
      <link>https://www.unnayansangbad.com/122371/%e0%a6%b8%e0%a7%8d%e0%a6%ac%e0%a7%88%e0%a6%b0%e0%a6%be%e0%a6%9a%e0%a6%be%e0%a6%b0-%e0%a6%86%e0%a6%ae%e0%a6%b2%e0%a7%87-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95-%e0%a6%ac%e0%a6%bf/</link>

    <item>
      <title>বাংলাদেশ থেকে সরিয়ে কয়েক শ মিলিয়ন ডলারের অর্ডার ভারতকে দিয়েছে বৈশ্বিক ব্র্যান্ডগুলো</title>
      <link>https://www.unnayansangbad.com/122347/%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%a6%e0%a7%87%e0%a6%b6-%e0%a6%a5%e0%a7%87%e0%a6%95%e0%a7%87-%e0%a6%b8%e0%a6%b0%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%95%e0%a6%af%e0%a6%bc/</link>

    <item>
      <title>চিকিৎসা নিতে বছরে বাংলাদেশীরা বিদেশে নেন ৫০০ কোটি ডলার: ডিসিসিআই</title>
      <link>https://www.unnayansangbad.com/122197/%e0%a6%9a%e0%a6%bf%e0%a6%95%e0%a6%bf%e0%a7%8e%e0%a6%b8%e0%a6%be-%e0%a6%a8%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%ac%e0%a6%9b%e0%a6%b0%e0%a7%87-%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%a6/</link>

    </item>
    <item>
      <title>সহিংসতার প্রতিবাদে বিক্ষোভের ডাক জামায়াতের</title>
      <link>https://www.unnayansangbad.com/122027/%e0%a6%b8%e0%a6%b9%e0%a6%bf%e0%a6%82%e0%a6%b8%e0%a6%a4%e0%a6%be%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4%e0%a6%bf%e0%a6%ac%e0%a6%be%e0%a6%a6%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7/</link>

    <item>
      <title>পঞ্চম অধিবেশনের আগেই সংসদ ভবনে বসছে সোলার প্যানেল</title>
      <link>https://www.unnayansangbad.com/122034/%e0%a6%aa%e0%a6%9e%e0%a7%8d%e0%a6%9a%e0%a6%ae-%e0%a6%85%e0%a6%a7%e0%a6%bf%e0%a6%ac%e0%a7%87%e0%a6%b6%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%86%e0%a6%97%e0%a7%87%e0%a6%87-%e0%a6%b8%e0%a6%82%e0%a6%b8/</link>
      <guid isPermaLink="true">https://www.unnayansangbad.com/122034/%e0%a6%aa%e0%a6%9e%e0%a7%8d%e0%a6%9a%e0%a6%ae-%e0%a6%85%e0%a6%a7%e0%a6%bf%e0%a6%ac%e0%a7%87%e0%a6%b6%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%86%e0%a6%97%e0%a7%87%e0%a6%87-%e0%a6%b8%e0%a6%82%e0%a6%b8/</guid>
      <pubDate>Wed, 18 Nov 2026 12:31:51 +0000</pubDate>
      <description>ত্রয়োদশ জাতীয় সংসদের পঞ্চম অধিবেশন শুরুর আগেই সংসদ ভবনে সৌরবিদ্যুৎ ব্যবস্থা চালু করার বিষয়ে সিদ্ধান্ত নিয়েছে এ সংক্রান্ত কমিটি। বুধবার (১৮ নভেম্বর) সংসদ ভবনে অনুষ্ঠিত জাতীয় সংসদ ভবন এলাকায় সৌরবিদ্যুৎ (সোলার প্যানেল) স্থাপনের সম্ভাব্যতা যাচাই, বিদ্যুতের সাশ্রয়ী ব্যবহার নিশ্চিতকরণ এবং জ্বালানি ব্যবস্থ</description>
      <source url="https://www.unnayansangbad.com/122034/%e0%a6%aa%e0%a6%9e%e0%a7%8d%e0%a6%9a%e0%a6%ae-%e0%a6%85%e0%a6%a7%e0%a6%bf%e0%a6%ac%e0%a7%87%e0%a6%b6%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%86%e0%a6%97%e0%a7%87%e0%a6%87-%e0%a6%b8%e0%a6%82%e0%a6%b8/">উন্নয়নসংবাদডটকম</source>
    </item>
    <item>
      <title>শ্রেণিকক্ষে শিক্ষক-শিক্ষার্থীদের মোবাইল ফোন ব্যবহার নিষিদ্ধ</title>
      <link>https://www.unnayansangbad.com/122030/%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%a3%e0%a6%bf%e0%a6%95%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a7%87-%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%95-%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7/</link>

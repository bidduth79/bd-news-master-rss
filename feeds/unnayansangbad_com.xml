    </item>
    <item>
      <title>দেশের বৈদেশিক মুদ্রার রিজার্ভ বেড়ে ৩৬.৩৫ বিলিয়ন ডলার: প্রধানমন্ত্রী</title>
      <link>https://www.unnayansangbad.com/122024/%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%87%e0%a6%b0-%e0%a6%ac%e0%a7%88%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a6%bf%e0%a6%95-%e0%a6%ae%e0%a7%81%e0%a6%a6%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%b0-%e0%a6%b0%e0%a6%bf-7/</link>
      <guid isPermaLink="true">https://www.unnayansangbad.com/122024/%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%87%e0%a6%b0-%e0%a6%ac%e0%a7%88%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a6%bf%e0%a6%95-%e0%a6%ae%e0%a7%81%e0%a6%a6%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%b0-%e0%a6%b0%e0%a6%bf-7/</guid>
      <pubDate>Wed, 18 Nov 2026 12:19:51 +0000</pubDate>
      <description>প্রধানমন্ত্রী তারেক রহমান জানিয়েছেন, দেশের বৈদেশিক মুদ্রার রিজার্ভ বর্তমানে ৩৬ দশমিক ৩৫ বিলিয়ন মার্কিন ডলার। তিনি বলেন, ২০২৪ সালের ৮ আগস্ট বাংলাদেশ ব্যাংকের সাপ্তাহিক হিসাব অনুযায়ী দেশের রিজার্ভ ছিল ২৫ দশমিক ৯০ বিলিয়ন মার্কিন ডলার। বর্তমানে তা বেড়ে ৩৬ দশমিক ৩৫ বিলিয়ন ডলারে উন্নীত হয়েছে। বৃহস্পতিবার </description>
      <source url="https://www.unnayansangbad.com/122024/%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%87%e0%a6%b0-%e0%a6%ac%e0%a7%88%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a6%bf%e0%a6%95-%e0%a6%ae%e0%a7%81%e0%a6%a6%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%b0-%e0%a6%b0%e0%a6%bf-7/">উন্নয়নসংবাদডটকম</source>
    </item>
    <item>
      <title>সীমান্ত দিয়ে আসছে গান পাউডার, হোয়াটসঅ্যাপে মিলল চাঞ্চল্যকর তথ্য</title>
      <link>https://www.unnayansangbad.com/122020/%e0%a6%b8%e0%a7%80%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a4-%e0%a6%a6%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%86%e0%a6%b8%e0%a6%9b%e0%a7%87-%e0%a6%97%e0%a6%be%e0%a6%a8-%e0%a6%aa%e0%a6%be/</link>

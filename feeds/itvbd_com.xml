      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/81d5eca0bdd6184d31ccbbe2224eb2ee-6af2ca7795b08.jpg?jadewits_media_id=167715" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/81d5eca0bdd6184d31ccbbe2224eb2ee-6af2ca7795b08.jpg?jadewits_media_id=167715" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অভিনেত্রী মেঘলা মুক্তার বাবা নিখোঁজ" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর উত্তরখান থেকে বসুন্ধরা আবাসিক এলাকার বাসায় ফেরার পথে নিখোঁজ হয়েছেন অভিনেত্রী মেঘলা মুক্তার বাবা মিজানুর রহমান দুলাল। সোমবার (৯ নভেম্বর) রাত পৌনে ৯টার পর থেকে তাঁর ব্যবহৃত মোবাইল ফোনটি বন্ধ রয়েছে।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/entertainment/dhallywood/277846/%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%AE%E0%A7%87%E0%A6%98%E0%A6%B2%E0%A6%BE-%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%96%E0%A7%8B%E0%A6%81%E0%A6%9C">Independent Television</source>
    </item>
    <item>
      <title>গণমাধ্যমকে চাপে রেখে নিয়ন্ত্রণ করতে চায় না সরকার: তথ্য প্রতিমন্ত্রী</title>

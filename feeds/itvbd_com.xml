    <item>
      <title>কার্যক্রম নিষিদ্ধ আ.লীগের আটক নেতাকে হাতকড়াসহ ছিনিয়ে নেওয়ার অভিযোগ</title>
      <link>https://www.itvbd.com/country/sylhet/277835/%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A6%95%E0%A7%9C%E0%A6%BE%E0%A6%B8%E0%A6%B9</link>
      <guid isPermaLink="true">https://www.itvbd.com/country/sylhet/277835/%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A6%95%E0%A7%9C%E0%A6%BE%E0%A6%B8%E0%A6%B9</guid>
      <pubDate>Tue, 10 Nov 2026 11:11:17 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/dde984ecd65d9fca7330a6e9893f745b-6af2a77095f3a.jpeg?jadewits_media_id=167710" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/dde984ecd65d9fca7330a6e9893f745b-6af2a77095f3a.jpeg?jadewits_media_id=167710" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/dde984ecd65d9fca7330a6e9893f745b-6af2a77095f3a.jpeg?jadewits_media_id=167710" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কার্যক্রম নিষিদ্ধ আ.লীগের আটক নেতাকে হাতকড়াসহ ছিনিয়ে নেওয়ার অভিযোগ" /&gt;&lt;/p&gt;&lt;p&gt;সিলেটের জৈন্তাপুরে পুলিশের ওপর হামলা চালিয়ে কার্যক্রম নিষিদ্ধ আওয়ামী লীগের আটককৃত এক নেতাকে হাতকড়াসহ ছিনিয়ে নেওয়া হয়েছে। সোমবার সন্ধ্যায় জৈন্তাপুর উপজেলার হরিপুর এলাকায় এ ঘটনা হয়। এসময় পুলিশের গাড়িও ভাঙচুর করা হয়। ছিনিয়ে নেওয়া জাকারিয়া মাহমুদ জৈন্তাপুর উপজেলা আওয়ামী লীগের দপ্তর সম্পাদক।						বিস্তার&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/country/sylhet/277835/%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A6%95%E0%A7%9C%E0%A6%BE%E0%A6%B8%E0%A6%B9">Independent Television</source>

    <item>
      <title>কে হচ্ছেন জাতিসংঘের পরবর্তী মহাসচিব?</title>
      <link>https://www.itvbd.com/world/278416/%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A7%80-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%9A%E0%A6%BF%E0%A6%AC</link>
      <guid isPermaLink="true">https://www.itvbd.com/world/278416/%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A7%80-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%9A%E0%A6%BF%E0%A6%AC</guid>
      <pubDate>Sat, 21 Nov 2026 20:00:22 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/5e3db4cf9cfb3830ededc7ef01c39373-6b01a3e4d794a.jpg?jadewits_media_id=168073" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/5e3db4cf9cfb3830ededc7ef01c39373-6b01a3e4d794a.jpg?jadewits_media_id=168073" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/5e3db4cf9cfb3830ededc7ef01c39373-6b01a3e4d794a.jpg?jadewits_media_id=168073" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কে হচ্ছেন জাতিসংঘের পরবর্তী মহাসচিব?" /&gt;&lt;/p&gt;&lt;p&gt;জাতিসংঘের পরবর্তী মহাসচিব কে হবেন, তা নিয়ে চলছে অচলাবস্থা। এ অচলাবস্থার মূলে জাতিসংঘের স্থায়ী পাঁচ সদস্য। কোনো প্রার্থীর বিষয়েই তারা একমত হতে পারছে না। শুক্রবার জাতিসংঘের নিরাপত্তা পরিষদের অনানুষ্ঠানিক ভোটেও কোনো প্রার্থীকে চূড়ান্তভাবে বেছে নেওয়া সম্ভব হয়নি। 						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/world/278416/%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A7%80-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%9A%E0%A6%BF%E0%A6%AC">Independent Television</source>
    </item>

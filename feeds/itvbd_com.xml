      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/f04ec4ad244a844e513ede85d9e3d0d5-6af487041279f.jpg?jadewits_media_id=167775" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আয়াতুল কুরসি খোদাই করা লকেট পরায় বিপাকে কারিনা" /&gt;&lt;/p&gt;&lt;p&gt;পবিত্র কোরআনের আয়াত খোদাই করা একটি ঐতিহাসিক পান্নার লকেট পরায় আইনি নোটিশ পেলেন বলিউড অভিনেত্রী কারিনা কাপুর খান। ভোপাল রাজপরিবারের এই ঐতিহ্যবাহী গয়নাটি নিয়ে আপত্তি তুলেছেন সমাজকর্মী আব্বাস হাফিজসহ মুসলিম সম্প্রদায়ের বেশ কয়েকজন সদস্য।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/entertainment/bollywood/277927/%E0%A6%86%E0%A7%9F%E0%A6%BE%E0%A6%A4%E0%A7%81%E0%A6%B2-%E0%A6%95%E0%A7%81%E0%A6%B0%E0%A6%B8%E0%A6%BF-%E0%A6%96%E0%A7%8B%E0%A6%A6%E0%A6%BE%E0%A6%87-%E0%A6%95%E0%A6%B0%E0%A6%BE-%E0%A6%B2%E0%A6%95%E0%A7%87%E0%A6%9F-%E0%A6%AA%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%A8%E0%A6%BE">Independent Television</source>
    </item>
    <item>
      <title>চলে গেলেন সত্যজিৎ রায়ের ক্যামেরাম্যান হীরক সেন</title>
      <link>https://www.itvbd.com/entertainment/tollywood/277926/%E0%A6%9A%E0%A6%B2%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%B8%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%9C%E0%A6%BF%E0%A7%8E-%E0%A6%B0%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A6%B9%E0%A7%80%E0%A6%B0%E0%A6%95-%E0%A6%B8%E0%A7%87%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.itvbd.com/entertainment/tollywood/277926/%E0%A6%9A%E0%A6%B2%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%B8%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%9C%E0%A6%BF%E0%A7%8E-%E0%A6%B0%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A6%B9%E0%A7%80%E0%A6%B0%E0%A6%95-%E0%A6%B8%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Wed, 11 Nov 2026 21:07:15 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/4c1dde62b21ea713982af5369cea1360-6af484286fb3d.jpg?jadewits_media_id=167774" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/4c1dde62b21ea713982af5369cea1360-6af484286fb3d.jpg?jadewits_media_id=167774" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/4c1dde62b21ea713982af5369cea1360-6af484286fb3d.jpg?jadewits_media_id=167774" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চলে গেলেন সত্যজিৎ রায়ের ক্যামেরাম্যান হীরক সেন" /&gt;&lt;/p&gt;&lt;p&gt;চলে গেলেন পশ্চিমবঙ্গের প্রখ্যাত ক্যামেরাম্যান হীরক সেন। বুধবার (১১ নভেম্বর) সকালে ৭১ বছর বয়সে শেষ নিশ্বাস ত্যাগ করেন তিনি। তাঁর ক্যামেরায় ধরা পড়া অসংখ্য মুহূর্ত বাংলা চলচ্চিত্রের ইতিহাসে চিরস্মরণীয় হয়ে আছে। তবে সব ছাপিয়ে তাঁর সবচেয়ে বড় পরিচয়, তিনি ছিলেন কিংবদন্তি নির্মাতা সত্যজিৎ রায়ের বিশ্বস্ত ক্যা&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/entertainment/tollywood/277926/%E0%A6%9A%E0%A6%B2%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%B8%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%9C%E0%A6%BF%E0%A7%8E-%E0%A6%B0%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A6%B9%E0%A7%80%E0%A6%B0%E0%A6%95-%E0%A6%B8%E0%A7%87%E0%A6%A8">Independent Television</source>
    </item>
    <item>
      <title>ভাঙচুর-আগুন, ককটেল বিস্ফোরণে আতঙ্ক, মানুষের নিরাপত্তা কোথায়?</title>
      <link>https://www.itvbd.com/analysis/277925/%E0%A6%AD%E0%A6%BE%E0%A6%99%E0%A6%9A%E0%A7%81%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%86%E0%A6%A4%E0%A6%99%E0%A7%8D%E0%A6%95-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.itvbd.com/analysis/277925/%E0%A6%AD%E0%A6%BE%E0%A6%99%E0%A6%9A%E0%A7%81%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%86%E0%A6%A4%E0%A6%99%E0%A7%8D%E0%A6%95-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Wed, 11 Nov 2026 20:53:44 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/fcbedd98c31faf7220ef1a8207eb6956-6af481615ed80.jpg?jadewits_media_id=167773" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/fcbedd98c31faf7220ef1a8207eb6956-6af481615ed80.jpg?jadewits_media_id=167773" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/fcbedd98c31faf7220ef1a8207eb6956-6af481615ed80.jpg?jadewits_media_id=167773" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভাঙচুর-আগুন, ককটেল বিস্ফোরণে আতঙ্ক, মানুষের নিরাপত্তা কোথায়?" /&gt;&lt;/p&gt;&lt;p&gt;গত কয়েক দিন ধরে রাজধানীসহ বিভিন্ন জেলায় ককটেল বিস্ফোরণ, বাসে অগ্নিসংযোগ, সড়ক অবরোধ ও ভাঙচুরের খবর আসছে। এক দিনে ১১ জেলায় ২২টি যানবাহনে আগুন এবং ঢাকার ১৯টি স্থানে ককটেল বিস্ফোরণের খবর পাওয়া গেছে। গণমাধ্যমে প্রকাশিত খবর অনুযায়ী, ঢাকায় কয়েক দিনে ৫০টিরও বেশি বিস্ফোরণ এবং অন্তত ৮টি বাসে আগুনের তথ্য এসেছে&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/analysis/277925/%E0%A6%AD%E0%A6%BE%E0%A6%99%E0%A6%9A%E0%A7%81%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%86%E0%A6%A4%E0%A6%99%E0%A7%8D%E0%A6%95-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A7%87%E0%A6%B0">Independent Television</source>
    </item>

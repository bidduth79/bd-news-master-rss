      <title>টানা চার দফা কমল সোনার দাম</title>
      <link>https://www.itvbd.com/economy/278030/%E0%A6%9F%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%AB%E0%A6%BE-%E0%A6%95%E0%A6%AE%E0%A6%B2-%E0%A6%B8%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE</link>
      <guid isPermaLink="true">https://www.itvbd.com/economy/278030/%E0%A6%9F%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%AB%E0%A6%BE-%E0%A6%95%E0%A6%AE%E0%A6%B2-%E0%A6%B8%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE</guid>
      <pubDate>Fri, 13 Nov 2026 20:02:55 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/01/25/e76e1a92568172b262c373988e889ea2-69760200c23cc.jpg?jadewits_media_id=152771" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/01/25/e76e1a92568172b262c373988e889ea2-69760200c23cc.jpg?jadewits_media_id=152771" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/01/25/e76e1a92568172b262c373988e889ea2-69760200c23cc.jpg?jadewits_media_id=152771" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টানা চার দফা কমল সোনার দাম" /&gt;&lt;/p&gt;&lt;p&gt;দেশের বাজারে টানা চতুর্থ দফায় কমেছে সোনার দাম। এবার প্রতি ভরিতে ২ হাজার ১৫৮ টাকা কমানোর সিদ্ধান্ত নিয়েছে বাংলাদেশ জুয়েলার্স সমিতি- বাজুস।						বিস্তারিত&lt;/p&gt;</description>

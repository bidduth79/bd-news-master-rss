    <item>
      <title>ইরান যুদ্ধ বন্ধে পুরোনো কৌশলে ডেমোক্র্যাটরা, ট্রাম্পকে থামানো যাবে?</title>
      <link>https://www.itvbd.com/world/278671/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%8B%E0%A6%A8%E0%A7%8B-%E0%A6%95%E0%A7%8C%E0%A6%B6%E0%A6%B2%E0%A7%87-%E0%A6%A1%E0%A7%87%E0%A6%AE%E0%A7%8B%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9F%E0%A6%B0%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.itvbd.com/world/278671/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%8B%E0%A6%A8%E0%A7%8B-%E0%A6%95%E0%A7%8C%E0%A6%B6%E0%A6%B2%E0%A7%87-%E0%A6%A1%E0%A7%87%E0%A6%AE%E0%A7%8B%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9F%E0%A6%B0%E0%A6%BE</guid>
      <pubDate>Wed, 25 Nov 2026 20:40:27 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/04/8ea7964f87a426358e3cbab790d1a43e-6aead48204755.jpg?jadewits_media_id=167514" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/04/8ea7964f87a426358e3cbab790d1a43e-6aead48204755.jpg?jadewits_media_id=167514" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/04/8ea7964f87a426358e3cbab790d1a43e-6aead48204755.jpg?jadewits_media_id=167514" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইরান যুদ্ধ বন্ধে পুরোনো কৌশলে ডেমোক্র্যাটরা, ট্রাম্পকে থামানো যাবে?" /&gt;&lt;/p&gt;&lt;p&gt;ভিয়েতনাম যুদ্ধের অবসানে গুরুত্বপূর্ণ ভূমিকা রেখেছিল মার্কিন কংগ্রেসের অর্থায়ন বন্ধের সিদ্ধান্ত। এবার ইরান যুদ্ধ বন্ধেও একই কৌশল নিতে চান ডেমোক্র্যাটরা। প্রেসিডেন্ট ট্রাম্পের সামরিক অভিযানে অর্থায়ন বন্ধে ডিসেম্বরেই চাপ সৃষ্টির পরিকল্পনা করছেন তারা। তবে এতে আমেরিকায় আবারও সরকার অচল হওয়ার আশঙ্কা রয়েছে।&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/world/278671/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%8B%E0%A6%A8%E0%A7%8B-%E0%A6%95%E0%A7%8C%E0%A6%B6%E0%A6%B2%E0%A7%87-%E0%A6%A1%E0%A7%87%E0%A6%AE%E0%A7%8B%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9F%E0%A6%B0%E0%A6%BE">Independent Television</source>
    </item>

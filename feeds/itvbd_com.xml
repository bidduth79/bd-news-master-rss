      <pubDate>Sun, 15 Nov 2026 09:42:22 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/b66cc881c17e86792ba073b3b601929e-6af929ff42f1b.jpg?jadewits_media_id=167881" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/b66cc881c17e86792ba073b3b601929e-6af929ff42f1b.jpg?jadewits_media_id=167881" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/b66cc881c17e86792ba073b3b601929e-6af929ff42f1b.jpg?jadewits_media_id=167881" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গাজীপুরে ফের শ্রমিকদের মহাসড়ক অবরোধ, ছত্রভঙ্গ করল আইনশৃঙ্খলা বাহিনী" /&gt;&lt;/p&gt;&lt;p&gt;গাজীপুরে বেতন বাড়ানোর দাবিতে আজও শ্রমিক অসন্তোষ দেখা দিয়েছে। দাবি আদায়ে সকালে ঢাকা-টাঙ্গাইল মহাসড়কের মৌচাক এলাকায় অবরোধ সৃষ্টি করে বিক্ষোভ করেন শ্রমিকরা। এতে প্রায় আধা ঘণ্টা যান চলাচল বন্ধ হয়ে যায়। পরে আইনশৃঙ্খলা বাহিনীর সদস্যরা ঘটনাস্থলে গিয়ে পরিস্থিতি নিয়ন্ত্রণে আনে। 						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/country/dhaka/278087/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A7%80%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A7%9C%E0%A6%95-%E0%A6%85%E0%A6%AC%E0%A6%B0%E0%A7%8B%E0%A6%A7-%E0%A6%9B%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%AD%E0%A6%99%E0%A7%8D%E0%A6%97-%E0%A6%95%E0%A6%B0%E0%A6%B2">Independent Television</source>

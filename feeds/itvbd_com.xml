      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/06/10/4c834e49514580ebe627a349809563f5-6a28e5440e0a6.jpg?jadewits_media_id=162435" length="0" type="image/jpeg" />

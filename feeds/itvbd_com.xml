      <guid isPermaLink="true">https://www.itvbd.com/economy/278348/%E0%A6%B8%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE-%E0%A6%8F%E0%A6%95%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%95%E0%A6%AE%E0%A6%B2-%E0%A6%AD%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A7%A7%E0%A7%A7-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE</guid>
      <pubDate>Fri, 20 Nov 2026 13:44:55 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/07/10/c167629c3b683ae6e72ed0926a40cc8a-6a509d468135f.jpg?jadewits_media_id=163666" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/07/10/c167629c3b683ae6e72ed0926a40cc8a-6a509d468135f.jpg?jadewits_media_id=163666" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/07/10/c167629c3b683ae6e72ed0926a40cc8a-6a509d468135f.jpg?jadewits_media_id=163666" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সোনার দাম একদিনেই কমল ভরিতে প্রায় ১১ হাজার টাকা" /&gt;&lt;/p&gt;&lt;p&gt;সবচেয়ে ভালো মানের বা ২২ ক্যারেটের প্রতি ভরি সোনার দাম ১০ হাজার ৯৫৪ টাকা কমে হয়েছে ২ লাখ ১ হাজার ১৪৬ টাকা। ২১ ক্যারেটের এক ভরি সোনার দাম ১০ হাজার ৪৩৯ টাকা কমে দাঁড়িয়েছে ১ লাখ ৯২ হাজার ১০৬ টাকা।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/economy/278348/%E0%A6%B8%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE-%E0%A6%8F%E0%A6%95%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%95%E0%A6%AE%E0%A6%B2-%E0%A6%AD%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A7%A7%E0%A7%A7-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE">Independent Television</source>
    </item>
    <item>
      <title>দুর্ঘটনার কবলে ঋতুপর্ণার গাড়ি, চালক আটক</title>
      <link>https://www.itvbd.com/entertainment/tollywood/278347/%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%AC%E0%A6%B2%E0%A7%87-%E0%A6%8B%E0%A6%A4%E0%A7%81%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A6%BE%E0%A6%B0-%E0%A6%97%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A6%BF-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%95-%E0%A6%86%E0%A6%9F%E0%A6%95</link>
      <guid isPermaLink="true">https://www.itvbd.com/entertainment/tollywood/278347/%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%AC%E0%A6%B2%E0%A7%87-%E0%A6%8B%E0%A6%A4%E0%A7%81%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A6%BE%E0%A6%B0-%E0%A6%97%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A6%BF-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%95-%E0%A6%86%E0%A6%9F%E0%A6%95</guid>
      <pubDate>Fri, 20 Nov 2026 13:34:01 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/a379e01a4d161fe39410ce869c15403d-6afff729ccd48.jpg?jadewits_media_id=168041" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/a379e01a4d161fe39410ce869c15403d-6afff729ccd48.jpg?jadewits_media_id=168041" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/a379e01a4d161fe39410ce869c15403d-6afff729ccd48.jpg?jadewits_media_id=168041" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দুর্ঘটনার কবলে ঋতুপর্ণার গাড়ি, চালক আটক" /&gt;&lt;/p&gt;&lt;p&gt;বড় দুর্ঘটনার হাত থেকে রক্ষা পেলেন অভিনেত্রী ঋতুপর্ণা সেনগুপ্ত। বৃহস্পতিবার (১৯ নভেম্বর) সকালে তাঁর বাড়ির সামনে পার্ক করে রাখা গাড়িতে সজোরে ধাক্কা মারে একটি ম্যাটাডোর। এ ঘটনায় অভিনেত্রীর গাড়িটি ব্যাপকভাবে ক্ষতিগ্রস্ত হলেও অল্পের জন্য প্রাণে বেঁচে গেছেন আশপাশের মানুষ।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/entertainment/tollywood/278347/%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%AC%E0%A6%B2%E0%A7%87-%E0%A6%8B%E0%A6%A4%E0%A7%81%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A6%BE%E0%A6%B0-%E0%A6%97%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A6%BF-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%95-%E0%A6%86%E0%A6%9F%E0%A6%95">Independent Television</source>
    </item>
    <item>
      <title>বাজারে সবজির দাম কমতির দিকে</title>
      <link>https://www.itvbd.com/economy/278346/%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A6%AC%E0%A6%9C%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE-%E0%A6%95%E0%A6%AE%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A6%BF%E0%A6%95%E0%A7%87%C2%A0</link>
      <guid isPermaLink="true">https://www.itvbd.com/economy/278346/%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A6%AC%E0%A6%9C%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE-%E0%A6%95%E0%A6%AE%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A6%BF%E0%A6%95%E0%A7%87%C2%A0</guid>
      <pubDate>Fri, 20 Nov 2026 13:31:17 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/12/05/63ef835aa7cbd2152bb9c97988234c0e-6932d2f5adc6b.JPG?jadewits_media_id=148176" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/12/05/63ef835aa7cbd2152bb9c97988234c0e-6932d2f5adc6b.JPG?jadewits_media_id=148176" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/12/05/63ef835aa7cbd2152bb9c97988234c0e-6932d2f5adc6b.JPG?jadewits_media_id=148176" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাজারে সবজির দাম কমতির দিকে" /&gt;&lt;/p&gt;&lt;p&gt;গত কয়েক সপ্তাহে শীতের সবজি বাজারে আসতে শুরু করায় কমতির দিকে সবজির দাম। বিক্রেতারা বলছেন বৈরী আবহাওয়া ও রাজনৈতিক অস্থিরতায় সবজির সরবরাহ দুদিন ধরে কিছুটা কম। আজ শুক্রবার রাজধানীর কয়েকটি কাঁচাবাজার ঘুরে এমনটা জানা গেছে। 						বিস্তারিত&lt;/p&gt;</description>

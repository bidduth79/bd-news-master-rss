    <item>
      <title>গেজেটের বাইরে থাকা জুলাই আহতদের স্বীকৃতি দিতে নতুন উদ্যোগ</title>
      <link>https://www.itvbd.com/national/277899/%E0%A6%97%E0%A7%87%E0%A6%9C%E0%A7%87%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%B0%E0%A7%87-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%9C%E0%A7%81%E0%A6%B2%E0%A6%BE%E0%A6%87-%E0%A6%86%E0%A6%B9%E0%A6%A4%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A7%80%E0%A6%95%E0%A7%83%E0%A6%A4%E0%A6%BF-%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.itvbd.com/national/277899/%E0%A6%97%E0%A7%87%E0%A6%9C%E0%A7%87%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%B0%E0%A7%87-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%9C%E0%A7%81%E0%A6%B2%E0%A6%BE%E0%A6%87-%E0%A6%86%E0%A6%B9%E0%A6%A4%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A7%80%E0%A6%95%E0%A7%83%E0%A6%A4%E0%A6%BF-%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8</guid>
      <pubDate>Wed, 11 Nov 2026 16:09:04 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/09/23/38d876644754aad698e710a27a3c3a77-68d2cc8c57fba.jpg?jadewits_media_id=139173" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/09/23/38d876644754aad698e710a27a3c3a77-68d2cc8c57fba.jpg?jadewits_media_id=139173" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/09/23/38d876644754aad698e710a27a3c3a77-68d2cc8c57fba.jpg?jadewits_media_id=139173" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গেজেটের বাইরে থাকা জুলাই আহতদের স্বীকৃতি দিতে নতুন উদ্যোগ" /&gt;&lt;/p&gt;&lt;p&gt;জুলাই গণঅভ্যুত্থান ২০২৪-এ ছাত্র-জনতার আন্দোলনে অংশ নিয়ে আহত হলেও এখনো জুলাই যোদ্ধা হিসেবে গেজেটভুক্ত হননি, এমন ব্যক্তিদের রাষ্ট্রীয় স্বীকৃতি দেওয়ার উদ্যোগ নিয়েছে সরকার। এ লক্ষ্যে তাদের নতুন করে তালিকাভুক্ত করতে গণবিজ্ঞপ্তি প্রকাশের প্রয়োজনীয় ব্যবস্থা নিতে সংশ্লিষ্ট কর্তৃপক্ষকে নির্দেশ দিয়েছে মুক্তিয&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/national/277899/%E0%A6%97%E0%A7%87%E0%A6%9C%E0%A7%87%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%B0%E0%A7%87-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%9C%E0%A7%81%E0%A6%B2%E0%A6%BE%E0%A6%87-%E0%A6%86%E0%A6%B9%E0%A6%A4%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A7%80%E0%A6%95%E0%A7%83%E0%A6%A4%E0%A6%BF-%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8">Independent Television</source>
    </item>
    <item>
      <title>জলবায়ু সম্মেলনে বিশ্বনেতাদের সঙ্গে প্রধানমন্ত্রীর শুভেচ্ছা বিনিময়</title>

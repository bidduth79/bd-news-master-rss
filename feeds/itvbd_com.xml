      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/05/15/efd609c4b0c52f5aa2b0ad0d02bb0124-6a06afbf08407.jpg?jadewits_media_id=161600" length="0" type="image/jpeg" />

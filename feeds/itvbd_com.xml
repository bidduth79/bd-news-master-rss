      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/e957ceae7814e1cf66a7a941feb9a147-6af48ac5b0543.jpg?jadewits_media_id=167777" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/e957ceae7814e1cf66a7a941feb9a147-6af48ac5b0543.jpg?jadewits_media_id=167777" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পাকিস্তানে পুলিশের ওপর হামলায় নিহত ১০" /&gt;&lt;/p&gt;&lt;p&gt;পাকিস্তানের খাইবার পাখতুনখাওয়া প্রদেশে পুলিশের একটি দলের ওপর হামলায় অন্তত ১০ সদস্য নিহত হয়েছেন। বুধবার অবৈধ খননের বিরুদ্ধে অভিযান চলাকালে অপরাধীদের সংশ্লিষ্ট একটি চক্র হামলা চালায় বলে জানিয়েছে প্রাদেশিক গভর্নরের দপ্তর। 						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/world/pakistan/277929/%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A7%A7%E0%A7%A6">Independent Television</source>
    </item>
    <item>
      <title>ইতালিতে বোমা হামলার হুমকিতে ৩ শতাধিক স্কুল খালি</title>

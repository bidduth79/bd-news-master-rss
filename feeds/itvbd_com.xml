      <title>একনেকে ৩৩ হাজার ২৯৮ কোটি টাকার ১৬ প্রকল্প অনুমোদন</title>
      <link>https://www.itvbd.com/national/278238/%E0%A6%8F%E0%A6%95%E0%A6%A8%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A7%A9%E0%A7%A9-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A7%A8%E0%A7%AF%E0%A7%AE-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A7%A7%E0%A7%AC-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AE%E0%A7%8B%E0%A6%A6%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.itvbd.com/national/278238/%E0%A6%8F%E0%A6%95%E0%A6%A8%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A7%A9%E0%A7%A9-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A7%A8%E0%A7%AF%E0%A7%AE-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A7%A7%E0%A7%AC-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AE%E0%A7%8B%E0%A6%A6%E0%A6%A8</guid>
      <pubDate>Wed, 18 Nov 2026 16:28:16 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/ccd622d34adac4018336560454e5a6d1-6afd7db4312cc.jpg?jadewits_media_id=167974" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/ccd622d34adac4018336560454e5a6d1-6afd7db4312cc.jpg?jadewits_media_id=167974" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/ccd622d34adac4018336560454e5a6d1-6afd7db4312cc.jpg?jadewits_media_id=167974" style="max-width:100%;height:auto;margin-bottom:10px;" alt="একনেকে ৩৩ হাজার ২৯৮ কোটি টাকার ১৬ প্রকল্প অনুমোদন" /&gt;&lt;/p&gt;&lt;p&gt;জাতীয় অর্থনৈতিক পরিষদের নির্বাহী কমিটির (একনেক) সভায় ৩৩ হাজার ২৯৮ কোটি ৪৮ লাখ টাকা ব্যয়ে ১৬টি উন্নয়ন প্রকল্প অনুমোদন দেওয়া হয়েছে। অনুমোদিত প্রকল্পগুলোর মধ্যে গ্রামীণ সড়কে দীর্ঘ সেতু নির্মাণ, নদীভাঙন প্রতিরোধ, খাল ও ছোট নদী পুনঃখনন, গ্রামীণ অবকাঠামো উন্নয়ন এবং সড়ক যোগাযোগব্যবস্থার উন্নয়নে বেশ কয়েকটি &lt;/p&gt;</description>
      <source url="https://www.itvbd.com/national/278238/%E0%A6%8F%E0%A6%95%E0%A6%A8%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A7%A9%E0%A7%A9-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A7%A8%E0%A7%AF%E0%A7%AE-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A7%A7%E0%A7%AC-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AE%E0%A7%8B%E0%A6%A6%E0%A6%A8">Independent Television</source>
    </item>

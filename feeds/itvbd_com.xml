      <title>মিয়ানমারের ওপর নিষেধাজ্ঞা শিথিলে আসিয়ানে বাড়ছে চাপ</title>
      <link>https://www.itvbd.com/world/asia/278118/%E0%A6%AE%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A7%87%E0%A6%A7%E0%A6%BE%E0%A6%9C%E0%A7%8D%E0%A6%9E%E0%A6%BE-%E0%A6%B6%E0%A6%BF%E0%A6%A5%E0%A6%BF%E0%A6%B2%E0%A7%87-%E0%A6%86%E0%A6%B8%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A6%9B%E0%A7%87</link>
      <guid isPermaLink="true">https://www.itvbd.com/world/asia/278118/%E0%A6%AE%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A7%87%E0%A6%A7%E0%A6%BE%E0%A6%9C%E0%A7%8D%E0%A6%9E%E0%A6%BE-%E0%A6%B6%E0%A6%BF%E0%A6%A5%E0%A6%BF%E0%A6%B2%E0%A7%87-%E0%A6%86%E0%A6%B8%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A6%9B%E0%A7%87</guid>
      <pubDate>Sun, 15 Nov 2026 22:01:33 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/dcec142c7f10ac9ba23184fdca3986ca-6af9d70809b7a.jpg?jadewits_media_id=167898" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/dcec142c7f10ac9ba23184fdca3986ca-6af9d70809b7a.jpg?jadewits_media_id=167898" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/dcec142c7f10ac9ba23184fdca3986ca-6af9d70809b7a.jpg?jadewits_media_id=167898" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মিয়ানমারের ওপর নিষেধাজ্ঞা শিথিলে আসিয়ানে বাড়ছে চাপ" /&gt;&lt;/p&gt;&lt;p&gt;আসিয়ানের শীর্ষ সম্মেলনে মিয়ানমারের নেতাদের যোগদানে আরোপিত নিষেধাজ্ঞা শিথিলে চাপ বাড়ছে। থাইল্যান্ড, মালয়েশিয়াসহ আসিয়ানের ৫ সদস্য দেশ এই তাগিদ দিচ্ছে। তবে বিশেষজ্ঞরা বলছেন, সামরিক অভ্যুত্থান পরবর্তী পরিস্থিতির উন্নতি না হওয়া পর্যন্ত রাজনৈতিক স্বীকৃতি দেয়া উচিত নয়। 						বিস্তারিত&lt;/p&gt;</description>

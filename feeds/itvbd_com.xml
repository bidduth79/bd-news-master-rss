      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/11/28/c76f70382702da1db6dad1b0f7f5efaf-6747d4d5a69c2.jpg?jadewits_media_id=90783" length="0" type="image/jpeg" />

      <guid isPermaLink="true">https://www.itvbd.com/politics/277924/%E0%A6%B0%E0%A7%81%E0%A6%B9%E0%A7%81%E0%A6%B2-%E0%A6%95%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%B0%E0%A6%BF%E0%A6%9C%E0%A6%AD%E0%A7%80%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%A3-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0</guid>
      <pubDate>Wed, 11 Nov 2026 20:46:05 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/e397e1f6bd8a9c82d06ed488be9b11c2-6af47f5724cea.jpg?jadewits_media_id=167772" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/e397e1f6bd8a9c82d06ed488be9b11c2-6af47f5724cea.jpg?jadewits_media_id=167772" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/e397e1f6bd8a9c82d06ed488be9b11c2-6af47f5724cea.jpg?jadewits_media_id=167772" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রুহুল কবির রিজভীর সঙ্গে ঢাকা দক্ষিণ বিএনপির আহ্বায়কের নেতৃত্বে নবগঠিত কমিটির সাক্ষাৎ" /&gt;&lt;/p&gt;&lt;p&gt;রুহুল কবির রিজভীর সঙ্গে ঢাকা দক্ষিণ বিএনপির আহ্বায়কের নেতৃত্বে নবগঠিত কমিটির সাক্ষাৎ
নিজস্ব প্রতিবেদক
বিএনপির ভারপ্রাপ্ত মহাসচিব অ্যাডভোকেট রুহুল কবির রিজভীর সঙ্গে সৌজন্য সাক্ষাৎ করেছেন ঢাকা মহানগর বিএনপির নবগঠিত কমিটির আহ্বায়ক ও সদস্য সচিব।
বুধবার নয়াপল্টনে বিএনপির কেন্দ্রীয় কার্যালয়ে এ সাক্ষাৎ অনু&lt;/p&gt;</description>

    <item>
      <title>শাহজালালে যাত্রীর শরীরে মিলল পৌনে ৪ কোটি টাকার সোনা</title>
      <link>https://www.itvbd.com/country/dhaka/278496/%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A6%9C%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%B6%E0%A6%B0%E0%A7%80%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2-%E0%A6%AA%E0%A7%8C%E0%A6%A8%E0%A7%87-%E0%A7%AA-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.itvbd.com/country/dhaka/278496/%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A6%9C%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%B6%E0%A6%B0%E0%A7%80%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2-%E0%A6%AA%E0%A7%8C%E0%A6%A8%E0%A7%87-%E0%A7%AA-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Mon, 23 Nov 2026 12:34:44 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/11/26/c57eb643476e34a0ce9e882d6f8c75ac-67454aa9b97f5.jpg?jadewits_media_id=90352" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/11/26/c57eb643476e34a0ce9e882d6f8c75ac-67454aa9b97f5.jpg?jadewits_media_id=90352" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/11/26/c57eb643476e34a0ce9e882d6f8c75ac-67454aa9b97f5.jpg?jadewits_media_id=90352" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শাহজালালে যাত্রীর শরীরে মিলল পৌনে ৪ কোটি টাকার সোনা" /&gt;&lt;/p&gt;&lt;p&gt;ঢাকার হযরত শাহজালাল আন্তর্জাতিক বিমানবন্দরে দুবাই থেকে আসা এক যাত্রীর কাছ থেকে ১৮টি সোনার বার জব্দ করেছে কাস্টমস গোয়েন্দা ও তদন্ত অধিদপ্তর (সিআইআইডি)। জব্দ করা বারগুলোর বাজারমূল্য প্রায় ৩ কোটি ৭৮ লাখ টাকা। আজ সোমবার সকাল সাড়ে ৮টার দিকে বিমানবন্দরের কাস্টমস হল এলাকার গ্রিন চ্যানেলে এ অভিযান চালানো হয়&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/country/dhaka/278496/%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A6%9C%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%B6%E0%A6%B0%E0%A7%80%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2-%E0%A6%AA%E0%A7%8C%E0%A6%A8%E0%A7%87-%E0%A7%AA-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0">Independent Television</source>
    </item>

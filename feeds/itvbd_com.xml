      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/5a929e5430d7fa6724f751513743225d-6af99b927032a.jpg?jadewits_media_id=167894" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/5a929e5430d7fa6724f751513743225d-6af99b927032a.jpg?jadewits_media_id=167894" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঋণের গুণগত মান ও অর্থের যথাযথ ব্যবহার নিশ্চিত করতে হবে: অর্থমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;দেশের অর্থনৈতিক প্রবৃদ্ধি ধরে রাখতে ঋণ ব্যবস্থাপনায় আরও সতর্ক হওয়ার পাশাপাশি ঋণের গুণগত মান নিশ্চিত করতে হবে বলে মন্তব্য করেছেন অর্থ ও পরিকল্পনামন্ত্রী আমীর খসরু মাহমুদ চৌধুরী। তিনি বলেন, ‌‘শুধু ঋণ গ্রহণ করলেই হবে না, সেই অর্থের যথাযথ ব্যবহার নিশ্চিত করতে হবে। বিনিয়োগের বিপরীতে সুফল, কর্মসংস্থান সৃষ&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/economy/278111/%E0%A6%8B%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A7%81%E0%A6%A3%E0%A6%97%E0%A6%A4-%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%93-%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%87%E0%A6%B0-%E0%A6%AF%E0%A6%A5%E0%A6%BE%E0%A6%AF%E0%A6%A5-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B9%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%9A%E0%A6%BF%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87">Independent Television</source>
    </item>

      <guid isPermaLink="true">https://www.itvbd.com/world/middle-east/278124/%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A7%A9-%E0%A6%B0%E0%A6%A3%E0%A6%A4%E0%A6%B0%E0%A6%BF-%E0%A6%AE%E0%A7%8B%E0%A6%A4%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%A8-%E0%A6%86%E0%A6%97%E0%A6%BE%E0%A6%AE</guid>
      <pubDate>Mon, 16 Nov 2026 09:59:52 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/28bb1c1e02b729a0fa47bba4e0d0cd46-6afa7f8f46d6d.jpg?jadewits_media_id=167902" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/28bb1c1e02b729a0fa47bba4e0d0cd46-6afa7f8f46d6d.jpg?jadewits_media_id=167902" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/28bb1c1e02b729a0fa47bba4e0d0cd46-6afa7f8f46d6d.jpg?jadewits_media_id=167902" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মধ্যপ্রাচ্যে যুক্তরাষ্ট্রের ৩ রণতরি মোতায়েন, আগাম হামলার হুঁশিয়ারি ইরানের" /&gt;&lt;/p&gt;&lt;p&gt;মধ্যপ্রাচ্যে পৌঁছেছে আরও একটি মার্কিন বিমানবাহী রণতরি ইউএসএস থিওডোর রুজভেল্ট। এর মধ্য দিয়ে যুক্তরাষ্ট্রের সেন্ট্রাল কমান্ডের আওতাধীন অঞ্চলে মোতায়েন করা বিমানবাহী রণতরির সংখ্যা দাঁড়াল তিনটিতে। 						বিস্তারিত&lt;/p&gt;</description>

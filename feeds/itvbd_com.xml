    </item>
    <item>
      <title>আয়াতুল কুরসি খোদাই করা লকেট পরায় বিপাকে কারিনা</title>
      <link>https://www.itvbd.com/entertainment/bollywood/277927/%E0%A6%86%E0%A7%9F%E0%A6%BE%E0%A6%A4%E0%A7%81%E0%A6%B2-%E0%A6%95%E0%A7%81%E0%A6%B0%E0%A6%B8%E0%A6%BF-%E0%A6%96%E0%A7%8B%E0%A6%A6%E0%A6%BE%E0%A6%87-%E0%A6%95%E0%A6%B0%E0%A6%BE-%E0%A6%B2%E0%A6%95%E0%A7%87%E0%A6%9F-%E0%A6%AA%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%A8%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.itvbd.com/entertainment/bollywood/277927/%E0%A6%86%E0%A7%9F%E0%A6%BE%E0%A6%A4%E0%A7%81%E0%A6%B2-%E0%A6%95%E0%A7%81%E0%A6%B0%E0%A6%B8%E0%A6%BF-%E0%A6%96%E0%A7%8B%E0%A6%A6%E0%A6%BE%E0%A6%87-%E0%A6%95%E0%A6%B0%E0%A6%BE-%E0%A6%B2%E0%A6%95%E0%A7%87%E0%A6%9F-%E0%A6%AA%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%A8%E0%A6%BE</guid>

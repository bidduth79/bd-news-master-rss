    <item>
      <title>মিয়ানমারে গণহত্যা মামলার ঐতিহাসিক রায় আজ, ন্যায়বিচারের প্রত্যাশা রোহিঙ্গাদের</title>
      <link>https://www.itvbd.com/world/asia/278272/%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%97%E0%A6%A3%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%90%E0%A6%A4%E0%A6%BF%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%95-%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%86%E0%A6%9C</link>
      <guid isPermaLink="true">https://www.itvbd.com/world/asia/278272/%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%97%E0%A6%A3%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%90%E0%A6%A4%E0%A6%BF%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%95-%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%86%E0%A6%9C</guid>
      <pubDate>Thu, 19 Nov 2026 08:42:51 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/edd10be5a4084cf11935bfdbbf16a130-6afbdc850f979.jpg?jadewits_media_id=167934" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/edd10be5a4084cf11935bfdbbf16a130-6afbdc850f979.jpg?jadewits_media_id=167934" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/edd10be5a4084cf11935bfdbbf16a130-6afbdc850f979.jpg?jadewits_media_id=167934" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মিয়ানমারে গণহত্যা মামলার ঐতিহাসিক রায় আজ, ন্যায়বিচারের প্রত্যাশা রোহিঙ্গাদের" /&gt;&lt;/p&gt;&lt;p&gt;মিয়ানমারের বিরুদ্ধে রোহিঙ্গা গণহত্যা মামলার রায় আজ ঘোষণা করবে আন্তর্জাতিক বিচার আদালত (আইসিজে)। রায়ে দেশটি দোষী সাব্যস্ত হলে, আসতে পারে আন্তর্জাতিক চাপসহ নানা পদক্ষেপ। একইসাথে রোহিঙ্গাদের ন্যায়বিচার ও নিরাপদ প্রত্যাবাসনে তৈরি হতে পারে নতুন সম্ভাবনা। 						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/world/asia/278272/%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%97%E0%A6%A3%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%90%E0%A6%A4%E0%A6%BF%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%95-%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%86%E0%A6%9C">Independent Television</source>
    </item>

      <guid isPermaLink="true">https://www.itvbd.com/health/278767/%E0%A6%9F%E0%A7%87%E0%A6%95%E0%A6%B8%E0%A6%87-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A7%8D%E0%A6%AF-%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%93-%E0%A6%87%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8B%E0%A6%A8%E0%A7%87%E0%A6%B6%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Fri, 27 Nov 2026 20:24:47 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/0c1d32d32852e45f19ccbd0eee3d5fd9-6b0992a2c0df5.jpg?jadewits_media_id=168275" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/0c1d32d32852e45f19ccbd0eee3d5fd9-6b0992a2c0df5.jpg?jadewits_media_id=168275" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/0c1d32d32852e45f19ccbd0eee3d5fd9-6b0992a2c0df5.jpg?jadewits_media_id=168275" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টেকসই স্বাস্থ্য অর্থায়নে বাংলাদেশ ও ইন্দোনেশিয়ার মধ্যে সহযোগিতা জোরদারের উদ্যোগ" /&gt;&lt;/p&gt;&lt;p&gt;স্বাস্থ্য খাতে টেকসই অর্থায়ন ব্যবস্থা গড়ে তোলা, চিকিৎসাব্যয়জনিত আর্থিক বিপর্যয় রোধ, ব্যক্তির নিজ পকেট থেকে স্বাস্থ্যব্যয় হ্রাস এবং দরিদ্র ও প্রান্তিক জনগোষ্ঠীর আর্থিক সুরক্ষা নিশ্চিত করার লক্ষ্যে বাংলাদেশ ও ইন্দোনেশিয়া পারস্পরিক সহযোগিতা জোরদারের দৃঢ় প্রত্যয় ব্যক্ত করেছে।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/health/278767/%E0%A6%9F%E0%A7%87%E0%A6%95%E0%A6%B8%E0%A6%87-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A7%8D%E0%A6%AF-%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%93-%E0%A6%87%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8B%E0%A6%A8%E0%A7%87%E0%A6%B6%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%B0">Independent Television</source>
    </item>
    <item>
      <title>রমজানে নিত্যপণ্যের বাজার নিয়ন্ত্রণে আলাদা পরিকল্পনার তাগিদ বিশেষজ্ঞদের</title>
      <link>https://www.itvbd.com/economy/278766/%E0%A6%B0%E0%A6%AE%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%AA%E0%A6%A3%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%86%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.itvbd.com/economy/278766/%E0%A6%B0%E0%A6%AE%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%AA%E0%A6%A3%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%86%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A6%BE</guid>
      <pubDate>Fri, 27 Nov 2026 20:14:54 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/10/18/10651abb828f3cca621a2e735a77cfd6-6711f9d66d262.jpg?jadewits_media_id=82318" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/10/18/10651abb828f3cca621a2e735a77cfd6-6711f9d66d262.jpg?jadewits_media_id=82318" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/10/18/10651abb828f3cca621a2e735a77cfd6-6711f9d66d262.jpg?jadewits_media_id=82318" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রমজানে নিত্যপণ্যের বাজার নিয়ন্ত্রণে আলাদা পরিকল্পনার তাগিদ বিশেষজ্ঞদের" /&gt;&lt;/p&gt;&lt;p&gt;উচ্চ মূল্যস্ফীতির বাজারে রোজায় পণ্যের দাম নিয়ে দুশ্চিন্তায় ভোক্তারা। এমন পরিস্থিতিতে আসন্ন রমজানে নিত্যপণ্যের বাজার নিয়ন্ত্রণে এখনই আলাদা পরিকল্পনার তাগিদ বিশেষজ্ঞদের।  ভোক্তা অধিকার সংরক্ষণ অধিদপ্তর বলছে, রোজার মাসে বাড়ানো হবে তদারকি দল, অনিয়ম পেলেই নেওয়া হবে কঠোর ব্যবস্থা।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/economy/278766/%E0%A6%B0%E0%A6%AE%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%AA%E0%A6%A3%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%86%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A6%BE">Independent Television</source>
    </item>
    <item>
      <title>শিক্ষাকে শুধু পাঠ্যবইয়ে সীমাবদ্ধ রাখলে হবে না: শিক্ষামন্ত্রী</title>
      <link>https://www.itvbd.com/education/278765/%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%B6%E0%A7%81%E0%A6%A7%E0%A7%81-%E0%A6%AA%E0%A6%BE%E0%A6%A0%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%87%E0%A7%9F%E0%A7%87-%E0%A6%B8%E0%A7%80%E0%A6%AE%E0%A6%BE%E0%A6%AC%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%B0%E0%A6%BE%E0%A6%96%E0%A6%B2%E0%A7%87-%E0%A6%B9%E0%A6%AC%E0%A7%87-%E0%A6%A8%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.itvbd.com/education/278765/%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%B6%E0%A7%81%E0%A6%A7%E0%A7%81-%E0%A6%AA%E0%A6%BE%E0%A6%A0%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%87%E0%A7%9F%E0%A7%87-%E0%A6%B8%E0%A7%80%E0%A6%AE%E0%A6%BE%E0%A6%AC%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%B0%E0%A6%BE%E0%A6%96%E0%A6%B2%E0%A7%87-%E0%A6%B9%E0%A6%AC%E0%A7%87-%E0%A6%A8%E0%A6%BE</guid>
      <pubDate>Fri, 27 Nov 2026 19:19:10 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/f184b4b4a5770fd30779b39889957927-6b0983238632b.jpg?jadewits_media_id=168274" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/f184b4b4a5770fd30779b39889957927-6b0983238632b.jpg?jadewits_media_id=168274" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/f184b4b4a5770fd30779b39889957927-6b0983238632b.jpg?jadewits_media_id=168274" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শিক্ষাকে শুধু পাঠ্যবইয়ে সীমাবদ্ধ রাখলে হবে না: শিক্ষামন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;শিক্ষার্থীদের পাঠ্যবইয়ের বাইরেও খেলাধুলা, সংস্কৃতি ও সৃজনশীল কাজে দক্ষ করে গড়ে তোলার আহ্বান জানিয়েছেন শিক্ষা এবং প্রাথমিক ও গণশিক্ষা মন্ত্রী ড. আ ন ম এহছানুল হক মিলন। 						বিস্তারিত&lt;/p&gt;</description>

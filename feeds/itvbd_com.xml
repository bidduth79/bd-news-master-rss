      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/07/26/ff4befd08112a8ddf97f17c3bb10f0a1-6a65d6b67d937.JPG?jadewits_media_id=164360" length="0" type="image/jpeg" />

    <item>
      <title>আমেরিকাকে ছাড়াই ইরানে বড় হামলার হুমকি ইসরায়েলের</title>
      <link>https://www.itvbd.com/world/middle-east/278730/%E0%A6%86%E0%A6%AE%E0%A7%87%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%87-%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A7%9C-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%95%E0%A6%BF-%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.itvbd.com/world/middle-east/278730/%E0%A6%86%E0%A6%AE%E0%A7%87%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%87-%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A7%9C-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%95%E0%A6%BF-%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Thu, 26 Nov 2026 23:01:10 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/09/30/897aecc9e0c74bb70811f7a3f24e183d-6abc771875a3d.jpg?jadewits_media_id=166567" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/09/30/897aecc9e0c74bb70811f7a3f24e183d-6abc771875a3d.jpg?jadewits_media_id=166567" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/09/30/897aecc9e0c74bb70811f7a3f24e183d-6abc771875a3d.jpg?jadewits_media_id=166567" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আমেরিকাকে ছাড়াই ইরানে বড় হামলার হুমকি ইসরায়েলের" /&gt;&lt;/p&gt;&lt;p&gt;ইরানে হামলা চালাতে আমেরিকার সামরিক সহায়তার প্রয়োজন নেই বলে হুঁশিয়ারি দিয়েছে ইসরায়েল। সেইসঙ্গে ওয়াশিংটনকে ছাড়াই যেকোনো মুহূর্তে ইরানে বড় ধরনের হামলা চালাতে ইসরায়েলি বাহিনী প্রস্তুত বলেও জানিয়েছেন সামরিক বাহিনীর মুখপাত্র এফি ডেফরিন।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/world/middle-east/278730/%E0%A6%86%E0%A6%AE%E0%A7%87%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%87-%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A7%9C-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%95%E0%A6%BF-%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0">Independent Television</source>
    </item>
    <item>
      <title>টুঙ্গিপাড়া থানায় হামলার ঘটনায় মামলা</title>
      <link>https://www.itvbd.com/country/dhaka/278729/%E0%A6%9F%E0%A7%81%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BF%E0%A6%AA%E0%A6%BE%E0%A7%9C%E0%A6%BE-%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%C2%A0</link>
      <guid isPermaLink="true">https://www.itvbd.com/country/dhaka/278729/%E0%A6%9F%E0%A7%81%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BF%E0%A6%AA%E0%A6%BE%E0%A7%9C%E0%A6%BE-%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%C2%A0</guid>
      <pubDate>Thu, 26 Nov 2026 22:55:35 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/02/03/9a309269e705269065595f6c8f75dd56-67a0656c197e1.JPG?jadewits_media_id=104008" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/02/03/9a309269e705269065595f6c8f75dd56-67a0656c197e1.JPG?jadewits_media_id=104008" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/02/03/9a309269e705269065595f6c8f75dd56-67a0656c197e1.JPG?jadewits_media_id=104008" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টুঙ্গিপাড়া থানায় হামলার ঘটনায় মামলা" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জের টুঙ্গিপাড়া থানায় হামলা, ভাঙচুর ও অগ্নিসংযোগের ঘটনায় সন্ত্রাসবিরোধী আইনে ৮ হাজার ২৬ জনকে আসামি করে মামলা করেছে পুলিশ। গত ২২ নভেম্বর টুঙ্গিপাড়া থানার উপপরিদর্শক কামরুল আহম্মেদ বাদী হয়ে মামলাটি দায়ের করেন। তবে এতদিন মামলার বিষয়টি প্রকাশ করা হয়নি। 						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/country/dhaka/278729/%E0%A6%9F%E0%A7%81%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BF%E0%A6%AA%E0%A6%BE%E0%A7%9C%E0%A6%BE-%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%C2%A0">Independent Television</source>
    </item>
    <item>
      <title>পারমাণবিক অস্ত্রের সক্ষমতা আরও বাড়াতে নির্দেশ কিম জং উনের</title>

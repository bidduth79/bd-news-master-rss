      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/08/26/9d18773adb6499e836575dfcf39e3d41-6a8e944b319b4.jpg?jadewits_media_id=165497" length="0" type="image/jpeg" />

      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/3805d335b63bf61c2d087ce26254b887-6af6fad5e8c63.jpg?jadewits_media_id=167843" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/3805d335b63bf61c2d087ce26254b887-6af6fad5e8c63.jpg?jadewits_media_id=167843" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/3805d335b63bf61c2d087ce26254b887-6af6fad5e8c63.jpg?jadewits_media_id=167843" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শেরপুরে অস্ত্রের মুখে রাবির ৮ শিক্ষার্থীকে জিম্মি করে ছিনতাই" /&gt;&lt;/p&gt;&lt;p&gt;শেরপুরের ঝিনাইগাতী উপজেলার গারো পাহাড়ের পর্যটনকেন্দ্র গজনী অবকাশের একটি পাহাড়ে অস্ত্রের মুখে জিম্মি করে রাজশাহী বিশ্ববিদ্যালয়ের (রাবি) আট শিক্ষার্থীকে মারধর ও ছিনতাইয়ের অভিযোগ উঠেছে। শুক্রবার সকাল ৯টার দিকে এ ঘটনা ঘটে। এ সময় শিক্ষার্থীদের মুঠোফোন, মানিব্যাগ ও নগদ টাকা ছিনিয়ে নিয়ে যায় দুর্বৃত্তরা।			&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/country/mymensingh/278026/%E0%A6%B6%E0%A7%87%E0%A6%B0%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%85%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A7%AE-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%9C%E0%A6%BF%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%BF">Independent Television</source>

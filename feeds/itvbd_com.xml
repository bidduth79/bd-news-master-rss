    <item>
      <title>সাব্বির-সাইফকে নিয়ে দল ঘোষণা বাংলাদেশের, আরও সুযোগ পেলেন যারা</title>
      <link>https://www.itvbd.com/sports/cricket/278093/%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%AB%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A6%E0%A6%B2-%E0%A6%98%E0%A7%8B%E0%A6%B7%E0%A6%A3%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A6%B8%E0%A7%81%E0%A6%AF%E0%A7%8B%E0%A6%97</link>
      <guid isPermaLink="true">https://www.itvbd.com/sports/cricket/278093/%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%AB%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A6%E0%A6%B2-%E0%A6%98%E0%A7%8B%E0%A6%B7%E0%A6%A3%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A6%B8%E0%A7%81%E0%A6%AF%E0%A7%8B%E0%A6%97</guid>
      <pubDate>Sun, 15 Nov 2026 11:12:48 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/4b1216830e3b6f25115423950dc0c609-6af93ef5e6de3.jpg?jadewits_media_id=167886" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/4b1216830e3b6f25115423950dc0c609-6af93ef5e6de3.jpg?jadewits_media_id=167886" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/4b1216830e3b6f25115423950dc0c609-6af93ef5e6de3.jpg?jadewits_media_id=167886" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাব্বির-সাইফকে নিয়ে দল ঘোষণা বাংলাদেশের, আরও সুযোগ পেলেন যারা" /&gt;&lt;/p&gt;&lt;p&gt;১৯ নভেম্বর থেকে ২৯ নভেম্বর পর্যন্ত হতে যাওয়া এবারের টুর্নামেন্টে বাংলাদেশ ‘এ’ দল প্রথম ম্যাচ খেলবে ১৯ নভেম্বর হংকংয়ের বিপক্ষে। এরপর ২১ নভেম্বর আফগানিস্তানের বিপক্ষে খেলবেন সাইফরা। আর গ্রুপপর্বে বাংলাদেশের শেষ ম্যাচ শ্রীলঙ্কার বিপক্ষে। সেই ম্যাচটি হবে ২৩ নভেম্বর।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/sports/cricket/278093/%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%AB%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A6%E0%A6%B2-%E0%A6%98%E0%A7%8B%E0%A6%B7%E0%A6%A3%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A6%B8%E0%A7%81%E0%A6%AF%E0%A7%8B%E0%A6%97">Independent Television</source>
    </item>
    <item>
      <title>ভারতীয় ভিসায় নতুন যেসব নিয়ম</title>
      <link>https://www.itvbd.com/analysis/278092/%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%AD%E0%A6%BF%E0%A6%B8%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%AF%E0%A7%87%E0%A6%B8%E0%A6%AC-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%AE</link>
      <guid isPermaLink="true">https://www.itvbd.com/analysis/278092/%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%AD%E0%A6%BF%E0%A6%B8%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%AF%E0%A7%87%E0%A6%B8%E0%A6%AC-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%AE</guid>
      <pubDate>Sun, 15 Nov 2026 11:09:59 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/06/28/8a8ea0bdcf98956fa9dae73403736831-6a40a33e5c990.jpg?jadewits_media_id=163136" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/06/28/8a8ea0bdcf98956fa9dae73403736831-6a40a33e5c990.jpg?jadewits_media_id=163136" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/06/28/8a8ea0bdcf98956fa9dae73403736831-6a40a33e5c990.jpg?jadewits_media_id=163136" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভারতীয় ভিসায় নতুন যেসব নিয়ম" /&gt;&lt;/p&gt;&lt;p&gt;ভারতের ভিসা ব্যবস্থায় বড় ধরনের পরিবর্তন আসছে। এতদিন জটিল আবেদন প্রক্রিয়া নিয়ে পর্যটকদের মনে যে অস্বস্তি ছিল, তা দূর করতেই ভিসা ব্যবস্থায় সংস্কার এনেছে দেশটির স্বরাষ্ট্র মন্ত্রণালয়। প্রশ্ন হচ্ছে, ঠিক কী কী পরিবর্তন আসছে? কোন ৯টি ক্যাটাগরির অধীনে এখন থেকে ভিসা দেওয়া হবে? আর নতুন নিয়মে আবেদন প্রক&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/analysis/278092/%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%AD%E0%A6%BF%E0%A6%B8%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%AF%E0%A7%87%E0%A6%B8%E0%A6%AC-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%AE">Independent Television</source>
    </item>

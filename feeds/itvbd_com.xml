      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/d40ca8c5986d550443cc92fec93f6847-6afdb770d4c55.jpg?jadewits_media_id=167986" length="0" type="image/jpeg" />

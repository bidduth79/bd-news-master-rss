    <item>
      <title>সাবেক প্রধানমন্ত্রী বেগম খালেদা জিয়ার নামে যুক্তরাষ্ট্রে সড়কের নামফলক উন্মোচন</title>
      <link>https://www.itvbd.com/probash/278493/%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%AC%E0%A7%87%E0%A6%97%E0%A6%AE-%E0%A6%96%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A6%E0%A6%BE-%E0%A6%9C%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A7%87</link>
      <guid isPermaLink="true">https://www.itvbd.com/probash/278493/%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%AC%E0%A7%87%E0%A6%97%E0%A6%AE-%E0%A6%96%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A6%E0%A6%BE-%E0%A6%9C%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A7%87</guid>
      <pubDate>Mon, 23 Nov 2026 11:21:48 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/514a15545fc7488bacc51498c09e0dc3-6b03cd5db639f.jpg?jadewits_media_id=168119" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/514a15545fc7488bacc51498c09e0dc3-6b03cd5db639f.jpg?jadewits_media_id=168119" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/514a15545fc7488bacc51498c09e0dc3-6b03cd5db639f.jpg?jadewits_media_id=168119" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাবেক প্রধানমন্ত্রী বেগম খালেদা জিয়ার নামে যুক্তরাষ্ট্রে সড়কের নামফলক উন্মোচন" /&gt;&lt;/p&gt;&lt;p&gt;সাবেক প্রধানমন্ত্রী বেগম খালেদা জিয়ার নামে যুক্তরাষ্ট্রে সড়কের নামফলক উন্মোচন করা হয়েছে। গতকাল রোববার স্থানীয় সময় দুপুরে যুক্তরাষ্ট্রের শিকাগো শহরের ঐতিহাসিক শিয়ার্স টাওয়ারের (বর্তমানে উইলিস টাওয়ার) পাদদেশে ‘মাদার অব ডেমোক্রেসি বেগম খালেদা জিয়া’ নামে একটি সড়কের আনুষ্ঠানিক উদ্বোধন করা হলো। সিটি&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/probash/278493/%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%AC%E0%A7%87%E0%A6%97%E0%A6%AE-%E0%A6%96%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A6%E0%A6%BE-%E0%A6%9C%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A7%87">Independent Television</source>
    </item>
    <item>
      <title>সোনার দাম এবার বাড়ল</title>
      <link>https://www.itvbd.com/economy/278492/%E0%A6%B8%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE-%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%B2</link>
      <guid isPermaLink="true">https://www.itvbd.com/economy/278492/%E0%A6%B8%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE-%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%B2</guid>
      <pubDate>Mon, 23 Nov 2026 10:44:50 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/01/25/e76e1a92568172b262c373988e889ea2-69760200c23cc.jpg?jadewits_media_id=152771" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/01/25/e76e1a92568172b262c373988e889ea2-69760200c23cc.jpg?jadewits_media_id=152771" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/01/25/e76e1a92568172b262c373988e889ea2-69760200c23cc.jpg?jadewits_media_id=152771" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সোনার দাম এবার বাড়ল" /&gt;&lt;/p&gt;&lt;p&gt;দেশের বাজারে টানা ৯ দফা কমার পর এবার সোনার দাম কিছুটা বেড়েছে। ভরিতে সর্বোচ্চ বেড়েছে ৩ হাজার ১৪৯ টাকা। আজ সোমবার বাংলাদেশ জুয়েলার্স সমিতি (বাজুস) নতুন দর নির্ধারণ করেছে। সকাল ১০টা থেকেই তা কার্যকর হয়েছে।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/economy/278492/%E0%A6%B8%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE-%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%B2">Independent Television</source>
    </item>
    <item>
      <title>চট্টগ্রামে মদ পানের পর দুইজনের মৃত্যু</title>
      <link>https://www.itvbd.com/country/chittagong/278491/%E0%A6%9A%E0%A6%9F%E0%A7%8D%E0%A6%9F%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%AE%E0%A6%A6-%E0%A6%AA%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%87%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81</link>
      <guid isPermaLink="true">https://www.itvbd.com/country/chittagong/278491/%E0%A6%9A%E0%A6%9F%E0%A7%8D%E0%A6%9F%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%AE%E0%A6%A6-%E0%A6%AA%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%87%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81</guid>
      <pubDate>Mon, 23 Nov 2026 10:38:52 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/01/11/9a65765aa7a50a0c7491d114c34a583b-67822aa2c59c1.jpg?jadewits_media_id=99443" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/01/11/9a65765aa7a50a0c7491d114c34a583b-67822aa2c59c1.jpg?jadewits_media_id=99443" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/01/11/9a65765aa7a50a0c7491d114c34a583b-67822aa2c59c1.jpg?jadewits_media_id=99443" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চট্টগ্রামে মদ পানের পর দুইজনের মৃত্যু" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রামের চান্দগাঁও থানার মোহরা খেজুরতলা এলাকায় দুইজনের মৃত্যু হয়েছে। মদ পানের পর অসুস্থ হয়ে চিকিৎসাধীন অবস্থায় তাঁদের মৃত্যু হয়। এই ঘটনায় আরও অন্তত দুইজন চট্টগ্রাম মেডিকেল কলেজ হাসপাতালে চিকিৎসাধীন। 						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/country/chittagong/278491/%E0%A6%9A%E0%A6%9F%E0%A7%8D%E0%A6%9F%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%AE%E0%A6%A6-%E0%A6%AA%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%87%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81">Independent Television</source>
    </item>
    <item>
      <title>সিনিয়র স্টাফ নার্স নিয়োগ পরীক্ষার ফল প্রকাশ</title>
      <link>https://www.itvbd.com/education/278490/%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%AB-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B8-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%8B%E0%A6%97-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0-%E0%A6%AB%E0%A6%B2-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B6</link>
      <guid isPermaLink="true">https://www.itvbd.com/education/278490/%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%AB-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B8-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%8B%E0%A6%97-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0-%E0%A6%AB%E0%A6%B2-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B6</guid>
      <pubDate>Mon, 23 Nov 2026 10:19:31 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/c289fe11a3b9093e5397e2b2aa70b62b-6b03bec60d28e.jpg?jadewits_media_id=168118" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/c289fe11a3b9093e5397e2b2aa70b62b-6b03bec60d28e.jpg?jadewits_media_id=168118" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/c289fe11a3b9093e5397e2b2aa70b62b-6b03bec60d28e.jpg?jadewits_media_id=168118" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সিনিয়র স্টাফ নার্স নিয়োগ পরীক্ষার ফল প্রকাশ" /&gt;&lt;/p&gt;&lt;p&gt;স্বাস্থ্য সেবা বিভাগের অধীন নার্সিং ও মিডওয়াইফারি অধিদপ্তরের সিনিয়র স্টাফ নার্স পদে নিয়োগের বাছাই (এমসিকিউ) পরীক্ষার ফল প্রকাশ করেছে সরকারি কর্ম কমিশন (পিএসসি)। এতে মোট ৭ হাজার ১৫০ জন প্রার্থী লিখিত পরীক্ষার জন্য উত্তীর্ণ হয়েছেন।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/education/278490/%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%AB-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B8-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%8B%E0%A6%97-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0-%E0%A6%AB%E0%A6%B2-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B6">Independent Television</source>

      <guid isPermaLink="true">https://www.itvbd.com/sports/cricket/278117/%E0%A6%B9%E0%A7%83%E0%A6%A6%E0%A7%9F%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%87%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A6%BE%E0%A6%A7%E0%A6%BF%E0%A6%95-%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A1-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Sun, 15 Nov 2026 21:45:21 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/b49c537591b1c4691c9832e8c66ea3f2-6af9d279523b3.jpg?jadewits_media_id=167897" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/b49c537591b1c4691c9832e8c66ea3f2-6af9d279523b3.jpg?jadewits_media_id=167897" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/b49c537591b1c4691c9832e8c66ea3f2-6af9d279523b3.jpg?jadewits_media_id=167897" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হৃদয়ের সেঞ্চুরির দিনে একাধিক রেকর্ড বাংলাদেশের" /&gt;&lt;/p&gt;&lt;p&gt;সাউথ আফ্রিকায় বাংলাদেশের টেস্টের পরিসংখ্যান খুব একটা ভালো নয়। ২০২২ সালের আগে তো কেউই সাদা পোশাকে সাউথ আফ্রিকায় সেঞ্চুরি করতে পারেননি। তবে ২০২২-এ মাহমুদুল হাসান জয়ের পর এবার দ্বিতীয় বাংলাদেশি হিসেবে সেঞ্চুরির কীর্তি গড়েছেন তাওহীদ হৃদয়। 						বিস্তারিত&lt;/p&gt;</description>

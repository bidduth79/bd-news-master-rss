      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/b76f32b8b3d8f6a54c15a79c4788a602-6b059cae45e5e.jpg?jadewits_media_id=168183" length="0" type="image/jpeg" />

    </item>
    <item>
      <title>সাবেক শিক্ষামন্ত্রী ওসমান ফারুক এমপি পদ ছাড়লেন যে কারণে</title>
      <link>https://www.itvbd.com/politics/278214/%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%93%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%AB%E0%A6%BE%E0%A6%B0%E0%A7%81%E0%A6%95-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF-%E0%A6%AA%E0%A6%A6-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AF%E0%A7%87</link>
      <guid isPermaLink="true">https://www.itvbd.com/politics/278214/%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%93%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%AB%E0%A6%BE%E0%A6%B0%E0%A7%81%E0%A6%95-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF-%E0%A6%AA%E0%A6%A6-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AF%E0%A7%87</guid>
      <pubDate>Tue, 17 Nov 2026 22:15:57 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/02/13/06d2d236cba718bd9e5e10474745d9db-698e21a949537.jpg?jadewits_media_id=154644" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/02/13/06d2d236cba718bd9e5e10474745d9db-698e21a949537.jpg?jadewits_media_id=154644" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/02/13/06d2d236cba718bd9e5e10474745d9db-698e21a949537.jpg?jadewits_media_id=154644" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাবেক শিক্ষামন্ত্রী ওসমান ফারুক এমপি পদ ছাড়লেন যে কারণে" /&gt;&lt;/p&gt;&lt;p&gt;শারীরিক অসুস্থতার কারণে কিশোরগঞ্জ-৩ আসনে বিএনপির সংসদ সদস্য ওসমান ফারুক পদত্যাগপত্র জমা দিয়েছেন। আজ মঙ্গলবার তিনি এ সিদ্ধান্ত নিয়েছেন বলে সংসদ সচিবালয়ের একটি সূত্রে জানা গেছে। সম্প্রতি জাতীয় সংসদের স্পিকার হাফিজ উদ্দিন আহমদের কাছে ই-মেইলে পদত্যাগপত্র পাঠিয়েছেন তিনি।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/politics/278214/%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%93%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%AB%E0%A6%BE%E0%A6%B0%E0%A7%81%E0%A6%95-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF-%E0%A6%AA%E0%A6%A6-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AF%E0%A7%87">Independent Television</source>
    </item>

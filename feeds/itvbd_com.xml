      <title>শেখ হাসিনা তাঁর অনুচরদের দিয়ে দেশে হত্যাকাণ্ড ঘটাচ্ছে: রিজভী</title>
      <link>https://www.itvbd.com/politics/278360/%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE-%E0%A6%A4%E0%A6%BE%E0%A6%81%E0%A6%B0-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%9A%E0%A6%B0%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%A3%E0%A7%8D%E0%A6%A1</link>
      <guid isPermaLink="true">https://www.itvbd.com/politics/278360/%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE-%E0%A6%A4%E0%A6%BE%E0%A6%81%E0%A6%B0-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%9A%E0%A6%B0%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%A3%E0%A7%8D%E0%A6%A1</guid>
      <pubDate>Fri, 20 Nov 2026 17:00:57 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/08/18/145b1ed6de3fe1a7c1109755dfdca795-6a8434cdc49d5.jpg?jadewits_media_id=165200" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/08/18/145b1ed6de3fe1a7c1109755dfdca795-6a8434cdc49d5.jpg?jadewits_media_id=165200" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/08/18/145b1ed6de3fe1a7c1109755dfdca795-6a8434cdc49d5.jpg?jadewits_media_id=165200" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শেখ হাসিনা তাঁর অনুচরদের দিয়ে দেশে হত্যাকাণ্ড ঘটাচ্ছে: রিজভী" /&gt;&lt;/p&gt;&lt;p&gt;প্রতিবেশি দেশে বসে শেখ হাসিনা তাঁর অনুচরদের দিয়ে দেশে একের পর এক হত্যাকাণ্ড ঘটাচ্ছে বলে মন্তব্য করেছেন বিএনপির ভারপ্রাপ্ত মহাসচিব রুহুল কবীর রিজভী। শুক্রবার দুপুরে নড়াইলের কালিয়ায় সন্ত্রাসী হামলায় নিহত কৃষক দল সাধারণ সম্পাদক শাহিনুর শেখ ও উপজেলা জাসাস এর সাধারণ সম্পাদক সোহেল মোল্যার কবর জিয়ারতের পর &lt;/p&gt;</description>
      <source url="https://www.itvbd.com/politics/278360/%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE-%E0%A6%A4%E0%A6%BE%E0%A6%81%E0%A6%B0-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%9A%E0%A6%B0%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%A3%E0%A7%8D%E0%A6%A1">Independent Television</source>
    </item>
    <item>
      <title>আকভানের প্রভাবে বৃষ্টি: সবজি ও ধান নিয়ে বিপাকে কৃষক</title>
      <link>https://www.itvbd.com/country/278359/%E0%A6%86%E0%A6%95%E0%A6%AD%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%AC%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF-%E0%A6%B8%E0%A6%AC%E0%A6%9C%E0%A6%BF-%E0%A6%93-%E0%A6%A7%E0%A6%BE%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A7%87</link>
      <guid isPermaLink="true">https://www.itvbd.com/country/278359/%E0%A6%86%E0%A6%95%E0%A6%AD%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%AC%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF-%E0%A6%B8%E0%A6%AC%E0%A6%9C%E0%A6%BF-%E0%A6%93-%E0%A6%A7%E0%A6%BE%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A7%87</guid>
      <pubDate>Fri, 20 Nov 2026 16:45:58 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/662929bcda6524cfb0f6d4355d18bd25-6b0024bdbca63.jpg?jadewits_media_id=168046" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/662929bcda6524cfb0f6d4355d18bd25-6b0024bdbca63.jpg?jadewits_media_id=168046" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/662929bcda6524cfb0f6d4355d18bd25-6b0024bdbca63.jpg?jadewits_media_id=168046" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আকভানের প্রভাবে বৃষ্টি: সবজি ও ধান নিয়ে বিপাকে কৃষক" /&gt;&lt;/p&gt;&lt;p&gt;ঘূর্ণিঝড় আকভানের প্রভাবে উপকূলসহ বিভিন্ন স্থানে বৃষ্টি অব্যাহত রয়েছে। টানা বৃষ্টিতে বেড়েছে মানুষের ভোগান্তি। জমিতে পানি জমায় সবজি ও ধান নিয়ে বিপাকে অনেক কৃষক। এছাড়া কাজ বন্ধ থাকায় খেটে খাওয়া অনেক মানুষের রোজগার বন্ধ রয়েছে।  আগামী রোববার পর্যন্ত বৃষ্টি অব্যাহত থাকতে পারে বলে আবহওয়ার পূর্বাভাসে জানানো&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/country/278359/%E0%A6%86%E0%A6%95%E0%A6%AD%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%AC%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF-%E0%A6%B8%E0%A6%AC%E0%A6%9C%E0%A6%BF-%E0%A6%93-%E0%A6%A7%E0%A6%BE%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A7%87">Independent Television</source>
    </item>
    <item>
      <title>হিমাগারের অভাবে বিপাকে নরসিংদীর সবজি চাষিরা</title>
      <link>https://www.itvbd.com/country/dhaka/278358/%E0%A6%B9%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%97%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%B0%E0%A6%B8%E0%A6%BF%E0%A6%82%E0%A6%A6%E0%A7%80%E0%A6%B0-%E0%A6%B8%E0%A6%AC%E0%A6%9C%E0%A6%BF-%E0%A6%9A%E0%A6%BE%E0%A6%B7%E0%A6%BF%E0%A6%B0%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.itvbd.com/country/dhaka/278358/%E0%A6%B9%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%97%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%B0%E0%A6%B8%E0%A6%BF%E0%A6%82%E0%A6%A6%E0%A7%80%E0%A6%B0-%E0%A6%B8%E0%A6%AC%E0%A6%9C%E0%A6%BF-%E0%A6%9A%E0%A6%BE%E0%A6%B7%E0%A6%BF%E0%A6%B0%E0%A6%BE</guid>
      <pubDate>Fri, 20 Nov 2026 16:24:40 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/12/06/2586cb6181b32a90dd18298b7b907eb7-6752b83bdf084.jpg?jadewits_media_id=92531" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/12/06/2586cb6181b32a90dd18298b7b907eb7-6752b83bdf084.jpg?jadewits_media_id=92531" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/12/06/2586cb6181b32a90dd18298b7b907eb7-6752b83bdf084.jpg?jadewits_media_id=92531" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হিমাগারের অভাবে বিপাকে নরসিংদীর সবজি চাষিরা" /&gt;&lt;/p&gt;&lt;p&gt;হিমাগার না থাকায় বিপাকে দেশের সবজি উৎপাদনের অন্যতম জেলা নরসিংদীর কৃষকরা। ভালো ফলন হলেও সংরক্ষণের সুযোগ না থাকায় ন্যায্য দাম পান না তারা। এছাড়া, প্রতি বছর সার, কীটনাশকসহ কৃষি উপকরণের দাম বাড়ায় শাকসবজির উৎপাদন খরচ বাড়তি, বলছেন চাষিরা। তবে কৃষি কর্মকর্তারা বলছেন, সরবরাহ ঘাটতি নেই, বরং অসাধু ব্যবসায়ীরা&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/country/dhaka/278358/%E0%A6%B9%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%97%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%B0%E0%A6%B8%E0%A6%BF%E0%A6%82%E0%A6%A6%E0%A7%80%E0%A6%B0-%E0%A6%B8%E0%A6%AC%E0%A6%9C%E0%A6%BF-%E0%A6%9A%E0%A6%BE%E0%A6%B7%E0%A6%BF%E0%A6%B0%E0%A6%BE">Independent Television</source>
    </item>
    <item>
      <title>প্রাণ-আরএফএল প্রেজেন্টস প্রিজম এআই ক্রিয়েটিভ সামিট অ্যান্ড অ্যাওয়ার্ড শো অনুষ্ঠিত</title>
      <link>https://www.itvbd.com/economy/corporate/278357/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3-%E0%A6%86%E0%A6%B0%E0%A6%8F%E0%A6%AB%E0%A6%8F%E0%A6%B2-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%B8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%9C%E0%A6%AE-%E0%A6%8F%E0%A6%86%E0%A6%87-%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%9F%E0%A6%BF%E0%A6%AD</link>
      <guid isPermaLink="true">https://www.itvbd.com/economy/corporate/278357/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3-%E0%A6%86%E0%A6%B0%E0%A6%8F%E0%A6%AB%E0%A6%8F%E0%A6%B2-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%B8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%9C%E0%A6%AE-%E0%A6%8F%E0%A6%86%E0%A6%87-%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%9F%E0%A6%BF%E0%A6%AD</guid>
      <pubDate>Fri, 20 Nov 2026 16:22:46 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/c95bc8f1c5b3836cf16681dcbfaf2796-6b001f62e6f2a.jpg?jadewits_media_id=168045" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/c95bc8f1c5b3836cf16681dcbfaf2796-6b001f62e6f2a.jpg?jadewits_media_id=168045" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/c95bc8f1c5b3836cf16681dcbfaf2796-6b001f62e6f2a.jpg?jadewits_media_id=168045" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রাণ-আরএফএল প্রেজেন্টস প্রিজম এআই ক্রিয়েটিভ সামিট অ্যান্ড অ্যাওয়ার্ড শো অনুষ্ঠিত" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশের এআই-নির্ভর সৃজনশীলতার নতুন সম্ভাবনা তুলে ধরা, উদীয়মান ক্রিয়েটরদের স্বীকৃতি দেওয়া এবং প্রযুক্তি ও সৃজনশীল শিল্পের মধ্যে সংযোগ তৈরির লক্ষ্যে প্রাণ-আরএফএল প্রেজেন্টস প্রিজম এআই ক্রিয়েটিভ সামিট অ্যান্ড অ্যাওয়ার্ড শো অনুষ্ঠিত হয়েছে। ১৯ নভেম্বর ঢাকার তেজগাঁওয়ের এলিট কনভেনশন হলে এই আয়োজন অনুষ্&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/economy/corporate/278357/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3-%E0%A6%86%E0%A6%B0%E0%A6%8F%E0%A6%AB%E0%A6%8F%E0%A6%B2-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%B8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%9C%E0%A6%AE-%E0%A6%8F%E0%A6%86%E0%A6%87-%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%9F%E0%A6%BF%E0%A6%AD">Independent Television</source>
    </item>
    <item>
      <title>কৃত্রিম ডাক ও নতুন কৌশলে চলছে পাখি নিধন</title>

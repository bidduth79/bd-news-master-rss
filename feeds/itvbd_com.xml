      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2023/08/03/rohingya-ft-5b699449e9371fe58b7545694a05f548.jpg?jadewits_media_id=2197" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2023/08/03/rohingya-ft-5b699449e9371fe58b7545694a05f548.jpg?jadewits_media_id=2197" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জাতিসংঘের সর্বোচ্চ আদালতের রায় ঘিরে নতুন আশার আলো দেখছেন রোহিঙ্গারা" /&gt;&lt;/p&gt;&lt;p&gt;দীর্ঘ প্রতীক্ষার পর জাতিসংঘের সর্বোচ্চ আদালতের রায় ঘিরে নতুন করে আশার আলো দেখছেন রোহিঙ্গারা। ২০১৭ সালে রাখাইনে ভয়াবহ সামরিক অভিযানের মুখে প্রাণ বাঁচাতে পালিয়ে আসা লাখো মানুষের কাছে এ রায় শুধু বিচারিক সিদ্ধান্ত নয়, বরং দীর্ঘদিনের নির্যাতন ও বঞ্চনার স্বীকৃতি বলে জানিয়েছে হিউম্যান রাইটস ওয়াচ। পাশাপাশি &lt;/p&gt;</description>
      <source url="https://www.itvbd.com/national/278316/%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A7%8B%E0%A6%9A%E0%A7%8D%E0%A6%9A-%E0%A6%86%E0%A6%A6%E0%A6%BE%E0%A6%B2%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%98%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%86%E0%A6%B6%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%B2%E0%A7%8B">Independent Television</source>

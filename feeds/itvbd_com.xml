      <title>৩০ হাজার টাকায় শিশুকে বিক্রি, ইউএনওর হস্তক্ষেপে উদ্ধার</title>
      <link>https://www.itvbd.com/country/khulna/278022/%E0%A7%A9%E0%A7%A6-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF-%E0%A6%87%E0%A6%89%E0%A6%8F%E0%A6%A8%E0%A6%93%E0%A6%B0-%E0%A6%B9%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA%E0%A7%87</link>
      <guid isPermaLink="true">https://www.itvbd.com/country/khulna/278022/%E0%A7%A9%E0%A7%A6-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF-%E0%A6%87%E0%A6%89%E0%A6%8F%E0%A6%A8%E0%A6%93%E0%A6%B0-%E0%A6%B9%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA%E0%A7%87</guid>
      <pubDate>Fri, 13 Nov 2026 17:17:06 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/7f66917e2965f9a2898a36cac273deee-6af6f16757799.jpg?jadewits_media_id=167842" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/7f66917e2965f9a2898a36cac273deee-6af6f16757799.jpg?jadewits_media_id=167842" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/7f66917e2965f9a2898a36cac273deee-6af6f16757799.jpg?jadewits_media_id=167842" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৩০ হাজার টাকায় শিশুকে বিক্রি, ইউএনওর হস্তক্ষেপে উদ্ধার" /&gt;&lt;/p&gt;&lt;p&gt;বাগেরহাটের মোরেলগঞ্জে অভাব-অনটন ও স্বামীর অবহেলার কারণে ৩০ হাজার টাকায় বিক্রি করে দেওয়া ১৫ মাস বয়সী এক শিশুকে উদ্ধার করা হয়েছে। উপজেলা নির্বাহী কর্মকর্তার (ইউএনও) হস্তক্ষেপে শুক্রবার দুপুরে শিশুটিকে উদ্ধার করা হয়। এ সময় সংশ্লিষ্ট পক্ষগুলোকে মোরেলগঞ্জ উপজেলা নির্বাহী কর্মকর্তার কার্যালয়ে হাজির করা হয়&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/country/khulna/278022/%E0%A7%A9%E0%A7%A6-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF-%E0%A6%87%E0%A6%89%E0%A6%8F%E0%A6%A8%E0%A6%93%E0%A6%B0-%E0%A6%B9%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA%E0%A7%87">Independent Television</source>
    </item>
    <item>
      <title>হামের উপসর্গে একদিনে আরও ৫ শিশুর মৃত্যু</title>

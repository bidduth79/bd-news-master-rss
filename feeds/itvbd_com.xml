    <item>
      <title>আইজেনকটের জোট ভাঙার ছক কষছেন নেতানিয়াহু?</title>
      <link>https://www.itvbd.com/world/middle-east/278482/%E0%A6%86%E0%A6%87%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A7%8B%E0%A6%9F-%E0%A6%AD%E0%A6%BE%E0%A6%99%E0%A6%BE%E0%A6%B0-%E0%A6%9B%E0%A6%95-%E0%A6%95%E0%A6%B7%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%B9%E0%A7%81</link>
      <guid isPermaLink="true">https://www.itvbd.com/world/middle-east/278482/%E0%A6%86%E0%A6%87%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A7%8B%E0%A6%9F-%E0%A6%AD%E0%A6%BE%E0%A6%99%E0%A6%BE%E0%A6%B0-%E0%A6%9B%E0%A6%95-%E0%A6%95%E0%A6%B7%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%B9%E0%A7%81</guid>
      <pubDate>Sun, 22 Nov 2026 22:13:30 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/11/30/a6a39cbd0f96b04d625e330c613dbb27-674a97119617f.jpg?jadewits_media_id=91194" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/11/30/a6a39cbd0f96b04d625e330c613dbb27-674a97119617f.jpg?jadewits_media_id=91194" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/11/30/a6a39cbd0f96b04d625e330c613dbb27-674a97119617f.jpg?jadewits_media_id=91194" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আইজেনকটের জোট ভাঙার ছক কষছেন নেতানিয়াহু?" /&gt;&lt;/p&gt;&lt;p&gt;ইসরায়েলে নতুন সরকার গঠন করতে হলে গাদি আইজেনকটকে কাটিয়ে উঠতে হবে আদর্শগত বিভাজন আর সংকীর্ণতা। সংখ্যাগরিষ্ঠতা অর্জনে সমর্থন আদায় করতে হবে আরও ১৩টি আসনের নেতাদের। এদিকে, তত্ত্বাবধায়ক প্রধানমন্ত্রী বেনিয়ামিন নেতানিয়াহুর বিরুদ্ধে অভিযোগ, আইজেনকটের জোটে ফাটল ধরানোর চেষ্টা করছেন তিনি।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/world/middle-east/278482/%E0%A6%86%E0%A6%87%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A7%8B%E0%A6%9F-%E0%A6%AD%E0%A6%BE%E0%A6%99%E0%A6%BE%E0%A6%B0-%E0%A6%9B%E0%A6%95-%E0%A6%95%E0%A6%B7%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%B9%E0%A7%81">Independent Television</source>
    </item>
    <item>
      <title>হুতিদের যুদ্ধের টাকার উৎস কী?</title>
      <link>https://www.itvbd.com/world/278481/%E0%A6%B9%E0%A7%81%E0%A6%A4%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%89%E0%A7%8E%E0%A6%B8-%E0%A6%95%E0%A7%80</link>
      <guid isPermaLink="true">https://www.itvbd.com/world/278481/%E0%A6%B9%E0%A7%81%E0%A6%A4%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%89%E0%A7%8E%E0%A6%B8-%E0%A6%95%E0%A7%80</guid>
      <pubDate>Sun, 22 Nov 2026 21:19:50 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/01/12/d3a4c7f4f91350029fcae49c121f5a5a-65a0bd1cb550e.jpg?jadewits_media_id=31992" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/01/12/d3a4c7f4f91350029fcae49c121f5a5a-65a0bd1cb550e.jpg?jadewits_media_id=31992" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/01/12/d3a4c7f4f91350029fcae49c121f5a5a-65a0bd1cb550e.jpg?jadewits_media_id=31992" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হুতিদের যুদ্ধের টাকার উৎস কী?" /&gt;&lt;/p&gt;&lt;p&gt;ইয়েমেনে যুদ্ধ চালাতে নিজেদের অর্থের জোগান ব্যবস্থা আরও শক্ত করেছে হুতিরা। কর, শুল্ক, বিভিন্ন ধরনের ফি, তেল বিক্রি এবং সাধারণ মানুষের কাছ থেকে নেয়া অনুদান, বিভিন্ন উৎস থেকে আসা অর্থের বড় অংশই যাচ্ছে সামরিক ও নিরাপত্তা খাতে। এই অর্থনৈতিক নিয়ন্ত্রণই হুতিদের সামরিক শক্তি বাড়ানোর পাশাপাশি ইয়েমেনের বিস্তী&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/world/278481/%E0%A6%B9%E0%A7%81%E0%A6%A4%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%89%E0%A7%8E%E0%A6%B8-%E0%A6%95%E0%A7%80">Independent Television</source>
    </item>
    <item>
      <title>মাতৃত্বকালীন ছুটিসহ নারী ক্রিকেটারদের আরও যেসব সুবিধা দিচ্ছে বিসিবি</title>
      <link>https://www.itvbd.com/sports/cricket/278480/%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A6%95%E0%A6%BE%E0%A6%B2%E0%A7%80%E0%A6%A8-%E0%A6%9B%E0%A7%81%E0%A6%9F%E0%A6%BF%E0%A6%B8%E0%A6%B9-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A6%AF%E0%A7%87%E0%A6%B8%E0%A6%AC</link>
      <guid isPermaLink="true">https://www.itvbd.com/sports/cricket/278480/%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A6%95%E0%A6%BE%E0%A6%B2%E0%A7%80%E0%A6%A8-%E0%A6%9B%E0%A7%81%E0%A6%9F%E0%A6%BF%E0%A6%B8%E0%A6%B9-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A6%AF%E0%A7%87%E0%A6%B8%E0%A6%AC</guid>
      <pubDate>Sun, 22 Nov 2026 20:42:43 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/73161eef4b6d388550217a4e01901d1d-6b02ff57dfb02.jpg?jadewits_media_id=168111" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/73161eef4b6d388550217a4e01901d1d-6b02ff57dfb02.jpg?jadewits_media_id=168111" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/73161eef4b6d388550217a4e01901d1d-6b02ff57dfb02.jpg?jadewits_media_id=168111" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মাতৃত্বকালীন ছুটিসহ নারী ক্রিকেটারদের আরও যেসব সুবিধা দিচ্ছে বিসিবি" /&gt;&lt;/p&gt;&lt;p&gt;নারী ক্রিকেটারদের পেশাগত নিরাপত্তা ও সুযোগ-সুবিধা বাড়াতে নতুন পথে হাঁটছে বিসিবি। যা এতদিন হয়নি তা-ই বাস্তবায়নের করতে যাচ্ছে তামিম ইকবালের বোর্ড। আজ (২২ নভেম্বর) বিসিবি সভাপতি তামিম ইকবাল নারী ক্রিকেটারদের জন্য মাতৃত্বকালীন ছুটিসহ আরও একাধিক নীতিমালা গ্রহণের কথা জানিয়েছেন।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/sports/cricket/278480/%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A6%95%E0%A6%BE%E0%A6%B2%E0%A7%80%E0%A6%A8-%E0%A6%9B%E0%A7%81%E0%A6%9F%E0%A6%BF%E0%A6%B8%E0%A6%B9-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A6%AF%E0%A7%87%E0%A6%B8%E0%A6%AC">Independent Television</source>
    </item>
    <item>
      <title>শ্রমবাজারের চাহিদা অনুযায়ী দক্ষ মানবসম্পদ গড়ে তোলার আহ্বান রাষ্ট্রপতির</title>
      <link>https://www.itvbd.com/national/278479/%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A6%E0%A6%BE-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AF%E0%A6%BE%E0%A7%9F%E0%A7%80-%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%A6-%E0%A6%97%E0%A7%9C%E0%A7%87</link>
      <guid isPermaLink="true">https://www.itvbd.com/national/278479/%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A6%E0%A6%BE-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AF%E0%A6%BE%E0%A7%9F%E0%A7%80-%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%A6-%E0%A6%97%E0%A7%9C%E0%A7%87</guid>
      <pubDate>Sun, 22 Nov 2026 20:39:37 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/cc091973f9a0ba4b32f90f0471177858-6b02fe903c7ca.jpg?jadewits_media_id=168110" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/cc091973f9a0ba4b32f90f0471177858-6b02fe903c7ca.jpg?jadewits_media_id=168110" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/cc091973f9a0ba4b32f90f0471177858-6b02fe903c7ca.jpg?jadewits_media_id=168110" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শ্রমবাজারের চাহিদা অনুযায়ী দক্ষ মানবসম্পদ গড়ে তোলার আহ্বান রাষ্ট্রপতির" /&gt;&lt;/p&gt;&lt;p&gt;দেশ ও বিদেশের শ্রমবাজারের চাহিদা অনুযায়ী দক্ষ ও যোগ্য মানবসম্পদ গড়ে তোলার আহ্বান জানিয়েছেন রাষ্ট্রপতি মির্জা ফখরুল ইসলাম আলমগীর। পাশাপাশি তিনি দেশের বিশ্ববিদ্যালয়গুলোর বৈশ্বিক র‌্যাংকিংয়ে অবস্থান উন্নীত করার বিষয়ে গুরুত্বারোপ করারও আহ্বান জানিয়েছেন। 						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/national/278479/%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A6%E0%A6%BE-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AF%E0%A6%BE%E0%A7%9F%E0%A7%80-%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%A6-%E0%A6%97%E0%A7%9C%E0%A7%87">Independent Television</source>
    </item>
    <item>
      <title>বৃষ্টিতে রাজবাড়ীতে ফসলের ক্ষতির আশঙ্কা, দুশ্চিন্তায় হাজারো কৃষক</title>
      <link>https://www.itvbd.com/country/dhaka/278478/%E0%A6%AC%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AB%E0%A6%B8%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%86%E0%A6%B6%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BE</link>

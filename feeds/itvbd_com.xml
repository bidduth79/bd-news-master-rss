    <item>
      <title>গণতন্ত্র রক্ষায় আইনজীবীদের ঐক্যবদ্ধ থাকার আহ্বান রাষ্ট্রপতির</title>
      <link>https://www.itvbd.com/national/278613/%E0%A6%97%E0%A6%A3%E0%A6%A4%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A7%9F-%E0%A6%86%E0%A6%87%E0%A6%A8%E0%A6%9C%E0%A7%80%E0%A6%AC%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%90%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%B9%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.itvbd.com/national/278613/%E0%A6%97%E0%A6%A3%E0%A6%A4%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A7%9F-%E0%A6%86%E0%A6%87%E0%A6%A8%E0%A6%9C%E0%A7%80%E0%A6%AC%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%90%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%B9%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%A8</guid>
      <pubDate>Tue, 24 Nov 2026 22:08:51 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/ec079a9e4f92eb171e5cf0082dc90b81-6b05b68f3e810.jpg?jadewits_media_id=168187" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/ec079a9e4f92eb171e5cf0082dc90b81-6b05b68f3e810.jpg?jadewits_media_id=168187" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/ec079a9e4f92eb171e5cf0082dc90b81-6b05b68f3e810.jpg?jadewits_media_id=168187" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গণতন্ত্র রক্ষায় আইনজীবীদের ঐক্যবদ্ধ থাকার আহ্বান রাষ্ট্রপতির" /&gt;&lt;/p&gt;&lt;p&gt;গণতন্ত্র ও আইনের শাসন রক্ষায় ঐক্যবদ্ধভাবে কাজ করার জন্য আইনজীবীদের প্রতি আহ্বান জানিয়েছেন রাষ্ট্রপতি মির্জা ফখরুল ইসলাম আলমগীর। আজ মঙ্গলবার দুপুরে বঙ্গভবনে বাংলাদেশ সুপ্রিম কোর্ট আইনজীবী সমিতির একটি প্রতিনিধিদলের সঙ্গে সৌজন্য সাক্ষাৎকালে রাষ্ট্রপতি এ আহ্বান জানান।						বিস্তারিত&lt;/p&gt;</description>

    <item>
      <title>'গাজার ধ্বংসযজ্ঞের সিনেমার ভিডিও আদালতের প্রমাণ হতে পারে'</title>
      <link>https://www.itvbd.com/entertainment/dakshini-and-others/278554/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%A7%E0%A7%8D%E0%A6%AC%E0%A6%82%E0%A6%B8%E0%A6%AF%E0%A6%9C%E0%A7%8D%E0%A6%9E%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%AE%E0%A6%BE%E0%A6%B0-%E0%A6%AD%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A6%93-%E0%A6%86%E0%A6%A6%E0%A6%BE%E0%A6%B2%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BE%E0%A6%A3</link>
      <guid isPermaLink="true">https://www.itvbd.com/entertainment/dakshini-and-others/278554/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%A7%E0%A7%8D%E0%A6%AC%E0%A6%82%E0%A6%B8%E0%A6%AF%E0%A6%9C%E0%A7%8D%E0%A6%9E%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%AE%E0%A6%BE%E0%A6%B0-%E0%A6%AD%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A6%93-%E0%A6%86%E0%A6%A6%E0%A6%BE%E0%A6%B2%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BE%E0%A6%A3</guid>
      <pubDate>Tue, 24 Nov 2026 00:15:33 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/8b4afb987c85c23fc5583fe3d02f3991-6b048284cff3e.jpg?jadewits_media_id=168152" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/8b4afb987c85c23fc5583fe3d02f3991-6b048284cff3e.jpg?jadewits_media_id=168152" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/8b4afb987c85c23fc5583fe3d02f3991-6b048284cff3e.jpg?jadewits_media_id=168152" style="max-width:100%;height:auto;margin-bottom:10px;" alt="'গাজার ধ্বংসযজ্ঞের সিনেমার ভিডিও আদালতের প্রমাণ হতে পারে'" /&gt;&lt;/p&gt;&lt;p&gt;গাজার বিধ্বস্ত হাসপাতাল, চিকিৎসকদের অসহায়ত্ব আর প্রতিদিন মৃত্যুর সঙ্গে লড়াই করা মানুষের বাস্তব চিত্র নিয়ে নির্মিত হয়েছে তথ্যচিত্র &amp;lsquo;লাইফ সাপোর্ট&amp;rsquo;। দোহা ফিল্ম ফেস্টিভ্যালে চলচ্চিত্রটির মধ্যপ্রাচ্য ও উত্তর আফ্রিকা অঞ্চলের প্রিমিয়ার ঘিরে আলোচনায় উঠে এসেছে গাজার স্বাস্থ্যব্যবস্থার ভয়াবহ পরিস্&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/entertainment/dakshini-and-others/278554/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%A7%E0%A7%8D%E0%A6%AC%E0%A6%82%E0%A6%B8%E0%A6%AF%E0%A6%9C%E0%A7%8D%E0%A6%9E%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%AE%E0%A6%BE%E0%A6%B0-%E0%A6%AD%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A6%93-%E0%A6%86%E0%A6%A6%E0%A6%BE%E0%A6%B2%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BE%E0%A6%A3">Independent Television</source>
    </item>
    <item>
      <title>পরিবারের গল্প নিয়ে ‘পেপার টাইগার’ বানালেন জেমস গ্রে</title>

    </item>
    <item>
      <title>আর্থিক সেবার বাইরে ৩৫ শতাংশ মানুষ: র‍্যাপিডের গবেষণা</title>
      <link>https://www.itvbd.com/economy/278247/%E0%A6%86%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%BF%E0%A6%95-%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%B0%E0%A7%87-%E0%A7%A9%E0%A7%AB-%E0%A6%B6%E0%A6%A4%E0%A6%BE%E0%A6%82%E0%A6%B6-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B7-%E0%A6%B0%E2%80%8D%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AA%E0%A6%BF%E0%A6%A1%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.itvbd.com/economy/278247/%E0%A6%86%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%BF%E0%A6%95-%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%B0%E0%A7%87-%E0%A7%A9%E0%A7%AB-%E0%A6%B6%E0%A6%A4%E0%A6%BE%E0%A6%82%E0%A6%B6-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B7-%E0%A6%B0%E2%80%8D%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AA%E0%A6%BF%E0%A6%A1%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Wed, 18 Nov 2026 18:01:11 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/06/09/eacfe59c63603311c8b10e88c1dad9d3-6a280723abf6e.jpg?jadewits_media_id=162426" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/06/09/eacfe59c63603311c8b10e88c1dad9d3-6a280723abf6e.jpg?jadewits_media_id=162426" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/06/09/eacfe59c63603311c8b10e88c1dad9d3-6a280723abf6e.jpg?jadewits_media_id=162426" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আর্থিক সেবার বাইরে ৩৫ শতাংশ মানুষ: র‍্যাপিডের গবেষণা" /&gt;&lt;/p&gt;&lt;p&gt;দেশে ৩৫ শতাংশের বেশি মানুষ এখন আর্থিক সেবার বাইরে। ব্যাংকিং ও আর্থিক সেবায় পুরুষের তুলনায় নারীদের ব্যবধান ৮ দশমিক ৬ শতাংশ পয়েন্ট। বাংলাদেশ ন্যাশনাল ফাইন্যান্সিয়াল ইনক্লুশন সার্ভে-২০২৫ এ এসব তথ্য উঠে এসেছে। আর্থিক সেবা ৭০ শতাংশে উন্নীত করতে প্রতিবেদনে নারীদের বিশেষ সেবা ও গ্রামীণ ব্যাংকিং বাড়ানোর সুপ&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/economy/278247/%E0%A6%86%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%BF%E0%A6%95-%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%B0%E0%A7%87-%E0%A7%A9%E0%A7%AB-%E0%A6%B6%E0%A6%A4%E0%A6%BE%E0%A6%82%E0%A6%B6-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B7-%E0%A6%B0%E2%80%8D%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AA%E0%A6%BF%E0%A6%A1%E0%A7%87%E0%A6%B0">Independent Television</source>
    </item>
    <item>
      <title>এজেন্ট ব্যাংকিংয়ে অর্ধেক হিসাবই নারীদের: বাংলাদেশ ব্যাংক</title>
      <link>https://www.itvbd.com/economy/278246/%E0%A6%8F%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A6%BF%E0%A6%82-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A7%9F-%E0%A6%96%E0%A7%8B%E0%A6%B2%E0%A6%BE-%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A7%E0%A7%87%E0%A6%95-%E0%A6%B9%E0%A6%BF%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A6%87</link>
      <guid isPermaLink="true">https://www.itvbd.com/economy/278246/%E0%A6%8F%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A6%BF%E0%A6%82-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A7%9F-%E0%A6%96%E0%A7%8B%E0%A6%B2%E0%A6%BE-%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A7%E0%A7%87%E0%A6%95-%E0%A6%B9%E0%A6%BF%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A6%87</guid>
      <pubDate>Wed, 18 Nov 2026 18:30:07 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/10/14/1dfca006a8ccb8e742435e748121ab36-68edd6f46b368.jpg?jadewits_media_id=141988" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/10/14/1dfca006a8ccb8e742435e748121ab36-68edd6f46b368.jpg?jadewits_media_id=141988" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/10/14/1dfca006a8ccb8e742435e748121ab36-68edd6f46b368.jpg?jadewits_media_id=141988" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এজেন্ট ব্যাংকিংয়ে অর্ধেক হিসাবই নারীদের: বাংলাদেশ ব্যাংক" /&gt;&lt;/p&gt;&lt;p&gt;দেশের এজেন্ট ব্যাংকিং ব্যবস্থায় নারীদের অংশগ্রহণ উল্লেখযোগ্যভাবে বাড়ছে। বর্তমানে এ ব্যবস্থায় খোলা মোট ব্যাংক হিসাবের প্রায় অর্ধেকই নারীদের নামে। বাংলাদেশ ব্যাংকের সর্বশেষ প্রতিবেদনে উঠে এসেছে এ তথ্য। কেন্দ্রীয় ব্যাংকের তথ্য অনুযায়ী, চলতি বছরের সেপ্টেম্বর পর্যন্ত এজেন্ট ব্যাংকিংয়ে হিসাব খোলা হয়েছে &lt;/p&gt;</description>
      <source url="https://www.itvbd.com/economy/278246/%E0%A6%8F%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A6%BF%E0%A6%82-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A7%9F-%E0%A6%96%E0%A7%8B%E0%A6%B2%E0%A6%BE-%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A7%E0%A7%87%E0%A6%95-%E0%A6%B9%E0%A6%BF%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A6%87">Independent Television</source>

      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/a9fa07087bd23875d953c1cce3acbfce-6b096aed1ba68.jpg?jadewits_media_id=168271" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/a9fa07087bd23875d953c1cce3acbfce-6b096aed1ba68.jpg?jadewits_media_id=168271" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফিলিস্তিনি নিধনে ইসরায়েলের সঙ্গে জড়িয়ে পড়ছে অ্যামাজন-গুগল-মাইক্রোসফট" /&gt;&lt;/p&gt;&lt;p&gt;ফিলিস্তিনিদের ওপর নজরদারি, গতিবিধি অনুসরণ এবং সামরিক হামলার লক্ষ্যবস্তু নির্ধারণে যুক্তরাষ্ট্রের শীর্ষ প্রযুক্তিপ্রতিষ্ঠানগুলোর সহায়তা নিচ্ছে ইসরায়েল। অ্যামাজন, গুগল, মাইক্রোসফট, প্যালান্টির ও এনভিডিয়ার মতো প্রতিষ্ঠানগুলোর প্রযুক্তি ইসরায়েলের সামরিক ও অর্থনৈতিক ব্যবস্থার সঙ্গে যুক্ত হয়ে পড়েছে বলে অভ&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/world/middle-east/278760/%E0%A6%AB%E0%A6%BF%E0%A6%B2%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%A8%E0%A6%BF-%E0%A6%A8%E0%A6%BF%E0%A6%A7%E0%A6%A8%E0%A7%87-%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%9C%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AA%E0%A7%9C%E0%A6%9B%E0%A7%87">Independent Television</source>

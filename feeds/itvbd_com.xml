      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/49d6e5e44231921449719b74462ea1e0-6af42a15c5778.jpg?jadewits_media_id=167751" length="0" type="image/jpeg" />

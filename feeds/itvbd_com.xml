      <guid isPermaLink="true">https://www.itvbd.com/country/dhaka/278552/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%86%E0%A6%93%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%AA%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%B0%E0%A7%8D%E0%A6%B7</guid>
      <pubDate>Tue, 24 Nov 2026 00:32:27 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/408d37cce40411f2d07f16b5caacf947-6b048253a9ce1.jpg?jadewits_media_id=168151" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/408d37cce40411f2d07f16b5caacf947-6b048253a9ce1.jpg?jadewits_media_id=168151" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/408d37cce40411f2d07f16b5caacf947-6b048253a9ce1.jpg?jadewits_media_id=168151" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গোপালগঞ্জে কার্যক্রম নিষিদ্ধ আওয়ামী লীগের দুই গ্রুপের মধ্যে সংঘর্ষ, ককটেল বিস্ফোরণ, আহত ২০" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জে আওয়ামী লীগের দুই পক্ষের সমর্থক হিসেবে পরিচিত চরমানিকদাহ ও ঘোষেরচর গ্রামের বাসিন্দাদের মধ্যে সংঘর্ষের ঘটনা ঘটেছে। এতে অন্তত ২০ জন আহত হয়েছেন। এ সময় চারটি ককটেল বিস্ফোরণ ও কয়েকটি দোকান ভাঙচুরের ঘটনা ঘটে।						বিস্তারিত&lt;/p&gt;</description>

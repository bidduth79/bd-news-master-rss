    </item>
    <item>
      <title>গাজায় ইসরায়েলি হামলায় চলতি নভেম্বরে ১৬ স্কুলশিক্ষার্থী নিহত</title>
      <link>https://www.itvbd.com/world/middle-east/278743/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A7%9F-%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B2%E0%A6%BF-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%9A%E0%A6%B2%E0%A6%A4%E0%A6%BF-%E0%A6%A8%E0%A6%AD%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%87-%E0%A7%A7%E0%A7%AC</link>
      <guid isPermaLink="true">https://www.itvbd.com/world/middle-east/278743/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A7%9F-%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B2%E0%A6%BF-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%9A%E0%A6%B2%E0%A6%A4%E0%A6%BF-%E0%A6%A8%E0%A6%AD%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%87-%E0%A7%A7%E0%A7%AC</guid>
      <pubDate>Fri, 27 Nov 2026 12:34:00 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/54dc4e8bcd0c22fa9ea7437a87695733-6b09243f1ddf2.jpg?jadewits_media_id=168258" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/54dc4e8bcd0c22fa9ea7437a87695733-6b09243f1ddf2.jpg?jadewits_media_id=168258" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/54dc4e8bcd0c22fa9ea7437a87695733-6b09243f1ddf2.jpg?jadewits_media_id=168258" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গাজায় ইসরায়েলি হামলায় চলতি নভেম্বরে ১৬ স্কুলশিক্ষার্থী নিহত" /&gt;&lt;/p&gt;&lt;p&gt;চলতি নভেম্বরের প্রথম ২৬ দিনে গাজায় ইসরায়েলি হামলায় অন্তত ১৬ জন স্কুলশিক্ষার্থী নিহত হয়েছে। যুদ্ধবিরতি সত্ত্বেও গাজাজুড়ে হামলা অব্যাহত রয়েছে। পাশাপাশি খাবার, বিশুদ্ধ পানি ও আশ্রয়ের সংকটে দিন কাটাচ্ছে শিশুরা। ব্রিটিশ সংবাদমাধ্যম দ্য গার্ডিয়ানের প্রতিবেদনে এসব তথ্য জানা যায়।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/world/middle-east/278743/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A7%9F-%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B2%E0%A6%BF-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%9A%E0%A6%B2%E0%A6%A4%E0%A6%BF-%E0%A6%A8%E0%A6%AD%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%87-%E0%A7%A7%E0%A7%AC">Independent Television</source>
    </item>
    <item>
      <title>টুঙ্গিপাড়া থানায় হামলার ঘটনায় মামলা, আসামি ১৩ হাজার</title>
      <link>https://www.itvbd.com/country/dhaka/278742/%E0%A6%9F%E0%A7%81%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BF%E0%A6%AA%E0%A6%BE%E0%A7%9C%E0%A6%BE-%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%86%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%BF-%E0%A7%A7%E0%A7%A9</link>
      <guid isPermaLink="true">https://www.itvbd.com/country/dhaka/278742/%E0%A6%9F%E0%A7%81%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BF%E0%A6%AA%E0%A6%BE%E0%A7%9C%E0%A6%BE-%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%86%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%BF-%E0%A7%A7%E0%A7%A9</guid>
      <pubDate>Fri, 27 Nov 2026 12:29:00 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/02/03/9a309269e705269065595f6c8f75dd56-67a0656c197e1.JPG?jadewits_media_id=104008" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/02/03/9a309269e705269065595f6c8f75dd56-67a0656c197e1.JPG?jadewits_media_id=104008" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/02/03/9a309269e705269065595f6c8f75dd56-67a0656c197e1.JPG?jadewits_media_id=104008" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টুঙ্গিপাড়া থানায় হামলার ঘটনায় মামলা, আসামি ১৩ হাজার" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জের টুঙ্গিপাড়া থানায় হামলা, ভাঙচুর ও আগুনের ঘটনায় সন্ত্রাসবিরোধী আইনে ১৩ হাজার ৩৪ জনকে আসামি করে দুটি মামলা করেছে পুলিশ ও বিজিবি। এর মধ্যে পুলিশের মামলায় ২৬ জনের নাম উল্লেখ করে অজ্ঞাতনামা ৮ হাজার জন এবং বিজিবির মামলায় ৮ জনের নাম উল্লেখ করে অজ্ঞাতনামা ৫ হাজার জনকে আসামি করা হয়েছে।						বিস্তা&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/country/dhaka/278742/%E0%A6%9F%E0%A7%81%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BF%E0%A6%AA%E0%A6%BE%E0%A7%9C%E0%A6%BE-%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%86%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%BF-%E0%A7%A7%E0%A7%A9">Independent Television</source>
    </item>

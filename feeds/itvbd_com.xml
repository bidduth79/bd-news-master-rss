      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/09/16/e401145c713b46ab71f0634f63b03d9b-66e8233ce648f.jpg?jadewits_media_id=76073" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পারমাণবিক অস্ত্রের সক্ষমতা আরও বাড়াতে নির্দেশ কিম জং উনের" /&gt;&lt;/p&gt;&lt;p&gt;উত্তর কোরিয়ার কৌশলগত পারমাণবিক অস্ত্রের সক্ষমতা আরও বাড়ানোর নির্দেশ দিয়েছেন দেশটির নেতা কিম জং উন। বিভিন্ন সামরিক ক্ষেত্রে ভিন্ন ভিন্ন মিশনে এসব অস্ত্র মোতায়েনের ওপর গুরুত্ব দিয়েছেন তিনি। 						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/world/asia/278728/%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%AE%E0%A6%BE%E0%A6%A3%E0%A6%AC%E0%A6%BF%E0%A6%95-%E0%A6%85%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%AE%E0%A6%A4%E0%A6%BE-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%95%E0%A6%BF%E0%A6%AE">Independent Television</source>
    </item>
    <item>
      <title>অনলাইন প্লাটফর্মের বিক্রির সঙ্গে ২৯ রেস্তোরাঁর ভ্যাটের তথ্যে বড় গরমিল</title>
      <link>https://www.itvbd.com/economy/278727/%E0%A6%85%E0%A6%A8%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%9F%E0%A6%AB%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A7%A8%E0%A7%AF-%E0%A6%B0%E0%A7%87%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8B%E0%A6%B0%E0%A6%BE%E0%A6%81%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.itvbd.com/economy/278727/%E0%A6%85%E0%A6%A8%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%9F%E0%A6%AB%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A7%A8%E0%A7%AF-%E0%A6%B0%E0%A7%87%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8B%E0%A6%B0%E0%A6%BE%E0%A6%81%E0%A6%B0</guid>
      <pubDate>Thu, 26 Nov 2026 21:26:55 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/07/29/dd1da8e4a22e06d05c5430aba513c420-66a72b439fb84.jpg?jadewits_media_id=66780" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/07/29/dd1da8e4a22e06d05c5430aba513c420-66a72b439fb84.jpg?jadewits_media_id=66780" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/07/29/dd1da8e4a22e06d05c5430aba513c420-66a72b439fb84.jpg?jadewits_media_id=66780" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অনলাইন প্লাটফর্মের বিক্রির সঙ্গে ২৯ রেস্তোরাঁর ভ্যাটের তথ্যে বড় গরমিল" /&gt;&lt;/p&gt;&lt;p&gt;অনলাইনে খাবার সরবরাহকারী প্ল্যাটফর্ম ফুডপান্ডা, ফুডি ও পাঠাও ফুডের বিক্রির তথ্যের সঙ্গে নামীদামি ২৯টি রেস্তোরাঁর ভ্যাট দাখিলপত্রে বড় ধরনের গরমিল পেয়েছে জাতীয় রাজস্ব বোর্ড-এনবিআর। একই সঙ্গে সারা দেশের ৬ থেকে ৭ হাজার রেস্তোরাঁকে নজরদারিতে আনছে প্রতিষ্ঠানটি।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/economy/278727/%E0%A6%85%E0%A6%A8%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%9F%E0%A6%AB%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A7%A8%E0%A7%AF-%E0%A6%B0%E0%A7%87%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8B%E0%A6%B0%E0%A6%BE%E0%A6%81%E0%A6%B0">Independent Television</source>
    </item>
    <item>
      <title>বিনা খরচে মালয়েশিয়ার পথে ১১২ কর্মী, শুভেচ্ছা জানালেন প্রধানমন্ত্রী</title>

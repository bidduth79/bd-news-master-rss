    <item>
      <title>ফেনীতে হাসপাতালে চোরের উপদ্রব</title>
      <link>https://www.itvbd.com/country/chittagong/278474/%E0%A6%AB%E0%A7%87%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%9A%E0%A7%87%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%89%E0%A6%AA%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A6%AC</link>
      <guid isPermaLink="true">https://www.itvbd.com/country/chittagong/278474/%E0%A6%AB%E0%A7%87%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%9A%E0%A7%87%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%89%E0%A6%AA%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A6%AC</guid>
      <pubDate>Sun, 22 Nov 2026 18:32:19 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2023/09/29/46d964089bc635231dc0cfe4d01e22f8-6516ebe628f6d.jpg?jadewits_media_id=11905" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2023/09/29/46d964089bc635231dc0cfe4d01e22f8-6516ebe628f6d.jpg?jadewits_media_id=11905" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2023/09/29/46d964089bc635231dc0cfe4d01e22f8-6516ebe628f6d.jpg?jadewits_media_id=11905" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফেনীতে হাসপাতালে চোরের উপদ্রব" /&gt;&lt;/p&gt;&lt;p&gt;ফেনীর আড়াইশ শয্যা জেনারেল হাসপাতালে চোরের উপদ্রবে নিরাপত্তা উদ্বেগে রোগী ও স্বজনরা। এর মাঝে সাবস্টেশন থেকে ট্রান্সফরমার ও জেনারেটরের যন্ত্রাংশ চুরির ঘটনাও ঘটেছে। অভিযোগ উঠেছে, প্রায়ই ছোটোখাটো চুরির ঘটনা ঘটলেও উদাসীন কর্তৃপক্ষ। যদিও নিরাপত্তা জোরদারে নানা উদ্যোগ নেওয়ার কথা বলছে কর্তৃপক্ষ। 						বিস্ত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/country/chittagong/278474/%E0%A6%AB%E0%A7%87%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%9A%E0%A7%87%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%89%E0%A6%AA%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A6%AC">Independent Television</source>
    </item>

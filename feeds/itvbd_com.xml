      <link>https://www.itvbd.com/country/dhaka/278027/%E0%A6%A2%E0%A6%BE%E0%A6%AC%E0%A6%BF-%E0%A6%9C%E0%A6%97%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A6%BE%E0%A6%A5-%E0%A6%B9%E0%A6%B2-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A6%BE%E0%A6%87-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B8%E0%A7%8B%E0%A6%B8%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%B6%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%95</link>
      <guid isPermaLink="true">https://www.itvbd.com/country/dhaka/278027/%E0%A6%A2%E0%A6%BE%E0%A6%AC%E0%A6%BF-%E0%A6%9C%E0%A6%97%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A6%BE%E0%A6%A5-%E0%A6%B9%E0%A6%B2-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A6%BE%E0%A6%87-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B8%E0%A7%8B%E0%A6%B8%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%B6%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%95</guid>
      <pubDate>Fri, 13 Nov 2026 18:10:46 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/27cafd7d771dc7290dbddd8ebc840a35-6af6fe2ad85e5.jpg?jadewits_media_id=167844" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/27cafd7d771dc7290dbddd8ebc840a35-6af6fe2ad85e5.jpg?jadewits_media_id=167844" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/27cafd7d771dc7290dbddd8ebc840a35-6af6fe2ad85e5.jpg?jadewits_media_id=167844" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঢাবি জগন্নাথ হল অ্যালামনাই অ্যাসোসিয়েশনের বার্ষিক সভা ও সম্মেলন অনুষ্ঠিত" /&gt;&lt;/p&gt;&lt;p&gt;ঢাকা বিশ্ববিদ্যালয় (ঢাবি) জগন্নাথ হল অ্যালামনাই অ্যাসোসিয়েশনের বার্ষিক সাধারণ সভা ও সম্মেলন অনুষ্ঠিত হয়েছে। আজ শুক্রবার কিশোরী লাল রায় চৌধুরী মিলনায়তনে বিশ্ববিদ্যালয়ের উপাচার্য অধ্যাপক ড. এ বি এম ওবায়দুল ইসলাম অনুষ্ঠান উদ্বোধন করেন।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/country/dhaka/278027/%E0%A6%A2%E0%A6%BE%E0%A6%AC%E0%A6%BF-%E0%A6%9C%E0%A6%97%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A6%BE%E0%A6%A5-%E0%A6%B9%E0%A6%B2-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A6%BE%E0%A6%87-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B8%E0%A7%8B%E0%A6%B8%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%B6%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%95">Independent Television</source>

      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/d525ea604dada78af05f6f0a4f57e08d-6afda06e35ef2.jpg?jadewits_media_id=167978" length="0" type="image/jpeg" />

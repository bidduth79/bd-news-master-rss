      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/c14a8fe06cdd07df356e822e7a5c5f3c-6afc2c8575c44.jpg?jadewits_media_id=167941" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/c14a8fe06cdd07df356e822e7a5c5f3c-6afc2c8575c44.jpg?jadewits_media_id=167941" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/c14a8fe06cdd07df356e822e7a5c5f3c-6afc2c8575c44.jpg?jadewits_media_id=167941" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শুরু হচ্ছে ‘ফ্যামিলি ফিউড বাংলাদেশ সিজন ৩’, মঞ্চে আবারও তাহসান" /&gt;&lt;/p&gt;&lt;p&gt;দেশের শীর্ষস্থানীয় স্ট্রিমিং প্ল্যাটফর্ম ‘বঙ্গ’র প্রযোজনায় জনপ্রিয় গেম শো ‘ফ্যামিলি ফিউড বাংলাদেশ’ আসছে বহুল প্রতিক্ষীত তৃতীয় সিজন নিয়ে। আরও বড় পরিসর ও প্রতিযোগিতামূলক পরিবেশের প্রতিশ্রুতি নিয়ে এবারের সিজন আসছে এক নতুন ও আকর্ষণীয় ফরম্যাটে। যেখানে পরিবারগুলো ধাপে ধাপে প্রতিদ্বন্দ্বিতা করে সেরা হওয়ার&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/entertainment/ott/278186/%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E2%80%98%E0%A6%AB%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%BF-%E0%A6%AB%E0%A6%BF%E0%A6%89%E0%A6%A1-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%B8%E0%A6%BF%E0%A6%9C%E0%A6%A8-%E0%A7%A9%E2%80%99-%E0%A6%AE%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A7%87">Independent Television</source>

      <guid isPermaLink="true">https://www.itvbd.com/world/middle-east/278128/%E0%A6%A6%E0%A7%80%E0%A6%B0%E0%A7%8D%E0%A6%98-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A7%87%E0%A6%93-%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A7%9C%E0%A6%BE%E0%A6%87-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Mon, 16 Nov 2026 12:37:55 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/b456f26c231abac21161ec067f1e3bb3-6afaa4b83083a.jpg?jadewits_media_id=167906" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/b456f26c231abac21161ec067f1e3bb3-6afaa4b83083a.jpg?jadewits_media_id=167906" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/b456f26c231abac21161ec067f1e3bb3-6afaa4b83083a.jpg?jadewits_media_id=167906" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দীর্ঘ যুদ্ধের পরেও ইরানের হাতে আড়াই হাজার ক্ষেপণাস্ত্র, চিন্তায় ওয়াশিংটন" /&gt;&lt;/p&gt;&lt;p&gt;দীর্ঘ যুদ্ধের পরও ইরানের ভাণ্ডারে এখনো আড়াই হাজার ক্ষেপণাস্ত্র মজুত আছে। মার্কিন গোয়েন্দাদের বরাতে এক প্রতিবেদনে এই তথ্য জানিয়েছে সংবাদমাধ্যম ওয়ালস্ট্রিট জার্নাল। মার্কিন কর্মকর্তারা বলছেন, ইরানের কাছে বিপুল ক্ষেপণাস্ত্র থাকায় তেহরানে নতুন কোরে হামলার বিষয়ে সিদ্ধান্তহীনতায় ভুগছেন প্রেসিডেন্ট ডোনাল্&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/world/middle-east/278128/%E0%A6%A6%E0%A7%80%E0%A6%B0%E0%A7%8D%E0%A6%98-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A7%87%E0%A6%93-%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A7%9C%E0%A6%BE%E0%A6%87-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0">Independent Television</source>
    </item>

    <item>
      <title>খেলাপি ঋণ কমাতে বিশেষ ট্রাইব্যুনাল গঠনের তাগিদ</title>
      <link>https://www.itvbd.com/economy/278194/%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A6%AA%E0%A6%BF-%E0%A6%8B%E0%A6%A3-%E0%A6%95%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%87%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%A8%E0%A6%BE%E0%A6%B2-%E0%A6%97%E0%A6%A0%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A4%E0%A6%BE%E0%A6%97%E0%A6%BF%E0%A6%A6</link>
      <guid isPermaLink="true">https://www.itvbd.com/economy/278194/%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A6%AA%E0%A6%BF-%E0%A6%8B%E0%A6%A3-%E0%A6%95%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%87%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%A8%E0%A6%BE%E0%A6%B2-%E0%A6%97%E0%A6%A0%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A4%E0%A6%BE%E0%A6%97%E0%A6%BF%E0%A6%A6</guid>
      <pubDate>Tue, 17 Nov 2026 18:18:20 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/07/08/75306da8a956df2fed2664b6992f4a8f-6a4e5724d684c.jpg?jadewits_media_id=163605" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/07/08/75306da8a956df2fed2664b6992f4a8f-6a4e5724d684c.jpg?jadewits_media_id=163605" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/07/08/75306da8a956df2fed2664b6992f4a8f-6a4e5724d684c.jpg?jadewits_media_id=163605" style="max-width:100%;height:auto;margin-bottom:10px;" alt="খেলাপি ঋণ কমাতে বিশেষ ট্রাইব্যুনাল গঠনের তাগিদ" /&gt;&lt;/p&gt;&lt;p&gt;খেলাপি ঋণ কমাতে বিশেষ ট্রাইব্যুনাল গঠনের পাশাপাশি বাংলাদেশ ব্যাংককে কঠোর পদক্ষেপ নেয়ার তাগিদ দিয়েছেন বিশ্লেষকেরা। কারণ টাকা আদায়ে দেরি হলে ব্যাংক খাতে নেতিবাচক প্রভাব পড়ার শঙ্কা তাদের। এদিকে, বাংলাদেশ ব্যাংক বলছে, খেলাপি ঋণ আদায়ে বিভিন্ন নীতি সহায়তার পাশাপাশি ব্যাংকগুলোকে নির্দেশনা দেয়া হয়েছে।					&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/economy/278194/%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A6%AA%E0%A6%BF-%E0%A6%8B%E0%A6%A3-%E0%A6%95%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%87%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%A8%E0%A6%BE%E0%A6%B2-%E0%A6%97%E0%A6%A0%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A4%E0%A6%BE%E0%A6%97%E0%A6%BF%E0%A6%A6">Independent Television</source>
    </item>
    <item>
      <title>ফ্যাসিস্টের দোসররা দেশকে অস্থিতিশীল করতে চাইছে: জয়নুল আবদিন ফারুক</title>
      <link>https://www.itvbd.com/politics/278193/%E0%A6%AB%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%8B%E0%A6%B8%E0%A6%B0%E0%A6%B0%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%95%E0%A7%87-%E0%A6%85%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BF%E0%A6%A4%E0%A6%BF%E0%A6%B6%E0%A7%80%E0%A6%B2-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%87%E0%A6%9B%E0%A7%87</link>
      <guid isPermaLink="true">https://www.itvbd.com/politics/278193/%E0%A6%AB%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%8B%E0%A6%B8%E0%A6%B0%E0%A6%B0%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%95%E0%A7%87-%E0%A6%85%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BF%E0%A6%A4%E0%A6%BF%E0%A6%B6%E0%A7%80%E0%A6%B2-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%87%E0%A6%9B%E0%A7%87</guid>
      <pubDate>Tue, 17 Nov 2026 18:16:22 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/cec7ca1bb6b415989ded41c2c9a5f70e-6afc4593c26f6.jpg?jadewits_media_id=167946" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/cec7ca1bb6b415989ded41c2c9a5f70e-6afc4593c26f6.jpg?jadewits_media_id=167946" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/cec7ca1bb6b415989ded41c2c9a5f70e-6afc4593c26f6.jpg?jadewits_media_id=167946" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফ্যাসিস্টের দোসররা দেশকে অস্থিতিশীল করতে চাইছে: জয়নুল আবদিন ফারুক" /&gt;&lt;/p&gt;&lt;p&gt;‘দেশ যখন সুন্দরভাবে পরিচালিত হচ্ছে, তখন কিছু ফ্যাসিস্টের দোসর সীমান্তের ওপারে বসে দেশে ফেরার মিথ্যা তথ্য দিয়ে দেশকে অস্থিতিশীল করে তুলতে চাইছে।’ এই মন্তব্য করেছেন বিএনপি চেয়ারম্যান উপদেষ্টা কাউন্সিল সদস্য ও সংসদ সদস্য জয়নুল আবদিন ফারুক। 						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/politics/278193/%E0%A6%AB%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%8B%E0%A6%B8%E0%A6%B0%E0%A6%B0%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%95%E0%A7%87-%E0%A6%85%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BF%E0%A6%A4%E0%A6%BF%E0%A6%B6%E0%A7%80%E0%A6%B2-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%87%E0%A6%9B%E0%A7%87">Independent Television</source>
    </item>
    <item>
      <title>আমেরিকায় ‘ডার্টি বোমা’ হামলার পরিকল্পনা ইরানের</title>

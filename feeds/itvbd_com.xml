    <item>
      <title>শেখ হাসিনা কখনোই আসবেন না: এমপি কয়ছর</title>
      <link>https://www.itvbd.com/country/dhaka/278321/%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE-%E0%A6%95%E0%A6%96%E0%A6%A8%E0%A7%8B%E0%A6%87-%E0%A6%86%E0%A6%B8%E0%A6%AC%E0%A7%87%E0%A6%A8-%E0%A6%A8%E0%A6%BE-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF-%E0%A6%95%E0%A7%9F%E0%A6%9B%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.itvbd.com/country/dhaka/278321/%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE-%E0%A6%95%E0%A6%96%E0%A6%A8%E0%A7%8B%E0%A6%87-%E0%A6%86%E0%A6%B8%E0%A6%AC%E0%A7%87%E0%A6%A8-%E0%A6%A8%E0%A6%BE-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF-%E0%A6%95%E0%A7%9F%E0%A6%9B%E0%A6%B0</guid>
      <pubDate>Thu, 19 Nov 2026 20:34:19 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/25788489cc188ce7f61a124585c0f0fb-6aff08e78bc9c.jpeg?jadewits_media_id=168025" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/25788489cc188ce7f61a124585c0f0fb-6aff08e78bc9c.jpeg?jadewits_media_id=168025" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/25788489cc188ce7f61a124585c0f0fb-6aff08e78bc9c.jpeg?jadewits_media_id=168025" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শেখ হাসিনা কখনোই আসবেন না: এমপি কয়ছর" /&gt;&lt;/p&gt;&lt;p&gt;‘শেখ হাসিনা চৌদ্দ গোষ্ঠী নিয়ে পালিয়েছে, ওরা কখনও আসবে না’ বলে মন্তব্য করেছেন বিএনপির জাতীয় নির্বাহী কমিটির সদস্য ও সুনামগঞ্জ-৩ আসনের সংসদ সদস্য মোহাম্মদ কয়ছর আহমেদ। বৃহস্পতিবার বিকেলে সুনামগঞ্জের জগন্নাথপুর থানার নবনির্মিত ভবন উদ্বোধন ও কমিউনিটি পুলিশিং সভা শেষে সাংবাদিকদের এক প্রশ্নের জবাবে তিনি এ &lt;/p&gt;</description>
      <source url="https://www.itvbd.com/country/dhaka/278321/%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE-%E0%A6%95%E0%A6%96%E0%A6%A8%E0%A7%8B%E0%A6%87-%E0%A6%86%E0%A6%B8%E0%A6%AC%E0%A7%87%E0%A6%A8-%E0%A6%A8%E0%A6%BE-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF-%E0%A6%95%E0%A7%9F%E0%A6%9B%E0%A6%B0">Independent Television</source>
    </item>

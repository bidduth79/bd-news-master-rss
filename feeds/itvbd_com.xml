    </item>
    <item>
      <title>হৃদযন্ত্রের মারাত্মক শত্রু পোড়া তেল, নিরাপদ খাদ্য কর্তৃপক্ষের সতর্কতা</title>
      <link>https://www.itvbd.com/health/277923/%E0%A6%B9%E0%A7%83%E0%A6%A6%E0%A6%AF%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%AE%E0%A6%95-%E0%A6%B6%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%81-%E0%A6%AA%E0%A7%8B%E0%A7%9C%E0%A6%BE-%E0%A6%A4%E0%A7%87%E0%A6%B2-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A6%A6-%E0%A6%96%E0%A6%BE%E0%A6%A6%E0%A7%8D%E0%A6%AF</link>
      <guid isPermaLink="true">https://www.itvbd.com/health/277923/%E0%A6%B9%E0%A7%83%E0%A6%A6%E0%A6%AF%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%AE%E0%A6%95-%E0%A6%B6%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%81-%E0%A6%AA%E0%A7%8B%E0%A7%9C%E0%A6%BE-%E0%A6%A4%E0%A7%87%E0%A6%B2-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A6%A6-%E0%A6%96%E0%A6%BE%E0%A6%A6%E0%A7%8D%E0%A6%AF</guid>
      <pubDate>Wed, 11 Nov 2026 20:35:03 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/f6dc5e13f12322c21d34a48607b5e484-6af47ce05dc6a.jpg?jadewits_media_id=167771" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/f6dc5e13f12322c21d34a48607b5e484-6af47ce05dc6a.jpg?jadewits_media_id=167771" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/f6dc5e13f12322c21d34a48607b5e484-6af47ce05dc6a.jpg?jadewits_media_id=167771" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হৃদযন্ত্রের মারাত্মক শত্রু পোড়া তেল, নিরাপদ খাদ্য কর্তৃপক্ষের সতর্কতা" /&gt;&lt;/p&gt;&lt;p&gt;রান্নায় বারবার ব্যবহৃত পোড়া তেল হৃদযন্ত্রের জন্য মারাত্মক শত্রু। এই তেলের কারণে উচ্চ রক্তচাপ, হৃদরোগ ও ক্যানসারের মতো স্বাস্থ্যঝুঁকি তৈরি হচ্ছে বলে সতর্ক করেছে নিরাপদ খাদ্য কর্তৃপক্ষ। বুধবার রাজধানীতে এক আলোচনায় এসব কথা বলেন সংস্থার চেয়ারম্যান। এ সময় পোড়া তেলকে বায়োডিজেলে রূপান্তর করে যানবাহন চালানো&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/health/277923/%E0%A6%B9%E0%A7%83%E0%A6%A6%E0%A6%AF%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%AE%E0%A6%95-%E0%A6%B6%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%81-%E0%A6%AA%E0%A7%8B%E0%A7%9C%E0%A6%BE-%E0%A6%A4%E0%A7%87%E0%A6%B2-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A6%A6-%E0%A6%96%E0%A6%BE%E0%A6%A6%E0%A7%8D%E0%A6%AF">Independent Television</source>

    <item>
      <title>রোহিঙ্গা প্রত্যাবাসন ও সুরক্ষায় কার্যকর উদ্যোগের আহ্বান রাষ্ট্রপতির</title>
      <link>https://www.itvbd.com/national/277890/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%A8-%E0%A6%93-%E0%A6%B8%E0%A7%81%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A6%B0-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.itvbd.com/national/277890/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%A8-%E0%A6%93-%E0%A6%B8%E0%A7%81%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A6%B0-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Wed, 11 Nov 2026 13:29:28 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/e67fe62bfff6aa36859d328953e38848-6af4193c23f46.jpg?jadewits_media_id=167747" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/e67fe62bfff6aa36859d328953e38848-6af4193c23f46.jpg?jadewits_media_id=167747" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/e67fe62bfff6aa36859d328953e38848-6af4193c23f46.jpg?jadewits_media_id=167747" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রোহিঙ্গা প্রত্যাবাসন ও সুরক্ষায় কার্যকর উদ্যোগের আহ্বান রাষ্ট্রপতির" /&gt;&lt;/p&gt;&lt;p&gt;রাষ্ট্রপতি মির্জা ফখরুল ইসলাম আলমগীর বাংলাদেশে আশ্রয় নেওয়া জোরপূর্বক বাস্তুচ্যুত রোহিঙ্গা জনগোষ্ঠীর নিরাপদে স্বদেশ প্রত্যাবাসনে যুক্তরাজ্যসহ আন্তর্জাতিক সম্প্রদায়কে আরও কার্যকর উদ্যোগ নেওয়ার আহ্বান আহ্বান জানিয়েছেন। একই সঙ্গে তিনি ঝুঁকির মুখে থাকা নারী ও শিশুদের সুরক্ষাতেও একই উদ্যোগ নেওয়ার আহ্বান জ&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/national/277890/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%A8-%E0%A6%93-%E0%A6%B8%E0%A7%81%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A6%B0-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%87%E0%A6%B0">Independent Television</source>
    </item>

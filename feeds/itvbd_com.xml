    </item>
    <item>
      <title>নাশকতা ঠেকাতে জিরো টলারেন্সে ১১ দলীয় জোট, সহযোগিতা চায় সরকারের</title>
      <link>https://www.itvbd.com/politics/278125/%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%BE-%E0%A6%A0%E0%A7%87%E0%A6%95%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%9C%E0%A6%BF%E0%A6%B0%E0%A7%8B-%E0%A6%9F%E0%A6%B2%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%B8%E0%A7%87-%E0%A7%A7%E0%A7%A7-%E0%A6%A6%E0%A6%B2%E0%A7%80%E0%A7%9F-%E0%A6%9C%E0%A7%8B%E0%A6%9F-%E0%A6%B8%E0%A6%B9%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A6%BF%E0%A6%A4%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.itvbd.com/politics/278125/%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%BE-%E0%A6%A0%E0%A7%87%E0%A6%95%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%9C%E0%A6%BF%E0%A6%B0%E0%A7%8B-%E0%A6%9F%E0%A6%B2%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%B8%E0%A7%87-%E0%A7%A7%E0%A7%A7-%E0%A6%A6%E0%A6%B2%E0%A7%80%E0%A7%9F-%E0%A6%9C%E0%A7%8B%E0%A6%9F-%E0%A6%B8%E0%A6%B9%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A6%BF%E0%A6%A4%E0%A6%BE</guid>
      <pubDate>Mon, 16 Nov 2026 11:08:38 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/1810ead14cabc45bbe407a3c3fa3fa3c-6afa8fc2694ca.jpg?jadewits_media_id=167903" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/1810ead14cabc45bbe407a3c3fa3fa3c-6afa8fc2694ca.jpg?jadewits_media_id=167903" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/1810ead14cabc45bbe407a3c3fa3fa3c-6afa8fc2694ca.jpg?jadewits_media_id=167903" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নাশকতা ঠেকাতে জিরো টলারেন্সে ১১ দলীয় জোট, সহযোগিতা চায় সরকারের" /&gt;&lt;/p&gt;&lt;p&gt;কার্যক্রম নিষিদ্ধ আওয়ামী লীগের নাশকতা ঠেকাতে জিরো টলারেন্স অবস্থানের কথা জানিয়েছে জামায়াত-এনসিপির নেতৃত্বধীন ১১ দলীয় জোট। বিরোধী জোটের অনেক নেতার দাবি, সরকারের নমনীয়তার সুযোগে নাশকতা করছে কার্যক্রম নিষিদ্ধ দলটি। আওয়ামী লীগকে প্রতিহত করতে সরকারকেও পাশে চায় দলগুলো। 						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/politics/278125/%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%BE-%E0%A6%A0%E0%A7%87%E0%A6%95%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%9C%E0%A6%BF%E0%A6%B0%E0%A7%8B-%E0%A6%9F%E0%A6%B2%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%B8%E0%A7%87-%E0%A7%A7%E0%A7%A7-%E0%A6%A6%E0%A6%B2%E0%A7%80%E0%A7%9F-%E0%A6%9C%E0%A7%8B%E0%A6%9F-%E0%A6%B8%E0%A6%B9%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A6%BF%E0%A6%A4%E0%A6%BE">Independent Television</source>
    </item>
    <item>
      <title>মধ্যপ্রাচ্যে যুক্তরাষ্ট্রের ৩ রণতরি মোতায়েন, আগাম হামলার হুঁশিয়ারি ইরানের</title>

      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/02/15/080d7f2e699e228e4a15fb667182aec3-65ce05f7074de.jpg?jadewits_media_id=38444" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/02/15/080d7f2e699e228e4a15fb667182aec3-65ce05f7074de.jpg?jadewits_media_id=38444" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/02/15/080d7f2e699e228e4a15fb667182aec3-65ce05f7074de.jpg?jadewits_media_id=38444" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পোশাকশ্রমিকদের মজুরি ১৮-২৪ হাজার টাকার মধ্যে হওয়া উচিত: সিপিডি" /&gt;&lt;/p&gt;&lt;p&gt;৬ মাস আগে মজুরি বোর্ড গঠন করলে শ্রমিক অসন্তোষ এড়ানো যেত বলে মনে করে, বেসরকারি গবেষণা প্রতিষ্ঠান- সিপিডি। বুধবার সংবাদ সম্মেলনে সাড়ে ১৮ থেকে ২৪ হাজার টাকার মধ্যে মজুরি নির্ধারণের সুপারিশ করে সংস্থাটি। সিপিডির সম্মাননীয় ফেলো দেবপ্রিয় ভট্টাচার্য বলেন, ঘুষ- দুর্নীতির দায় শ্রমিকের মজুরির ওপর চাপাতে পারেন&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/economy/278240/%E0%A6%AA%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%95%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%9C%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A7%A7%E0%A7%AE-%E0%A7%A8%E0%A7%AA-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%B9%E0%A6%93%E0%A7%9F%E0%A6%BE">Independent Television</source>

      <guid isPermaLink="true">https://www.itvbd.com/national/277898/%E0%A6%9C%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A7%81-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0</guid>
      <pubDate>Wed, 11 Nov 2026 16:02:30 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/04664ad33c424f688ec045d842919f9b-6af43d230374d.jpg?jadewits_media_id=167754" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/04664ad33c424f688ec045d842919f9b-6af43d230374d.jpg?jadewits_media_id=167754" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/04664ad33c424f688ec045d842919f9b-6af43d230374d.jpg?jadewits_media_id=167754" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জলবায়ু সম্মেলনে বিশ্বনেতাদের সঙ্গে প্রধানমন্ত্রীর শুভেচ্ছা বিনিময়" /&gt;&lt;/p&gt;&lt;p&gt;তুরস্কের আন্তালিয়ায় জাতিসংঘ জলবায়ু পরিবর্তনবিষয়ক সম্মেলনের (কপ-৩১) উদ্বোধনী অনুষ্ঠানের আগে বিভিন্ন দেশের রাষ্ট্র ও সরকারপ্রধান এবং আন্তর্জাতিক সংস্থার শীর্ষ প্রতিনিধিদের সঙ্গে শুভেচ্ছা ও কুশল বিনিময় করেছেন প্রধানমন্ত্রী তারেক রহমান। এ সময় সম্মেলনস্থলের লিডার্স লাউঞ্জে সমবেত বিশ্বনেতারা পারস্পরিক স্ব&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/national/277898/%E0%A6%9C%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A7%81-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0">Independent Television</source>
    </item>

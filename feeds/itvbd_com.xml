      <guid isPermaLink="true">https://www.itvbd.com/entertainment/hollywood/278553/%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A6%B2%E0%A7%8D%E0%A6%AA-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E2%80%98%E0%A6%AA%E0%A7%87%E0%A6%AA%E0%A6%BE%E0%A6%B0-%E0%A6%9F%E0%A6%BE%E0%A6%87%E0%A6%97%E0%A6%BE%E0%A6%B0%E2%80%99-%E0%A6%AC%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%9C%E0%A7%87%E0%A6%AE%E0%A6%B8</guid>
      <pubDate>Tue, 24 Nov 2026 00:07:17 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/3f9c26f2f678f367f884c0e1ca2c93e8-6b0480a665340.jpeg?jadewits_media_id=168149" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/3f9c26f2f678f367f884c0e1ca2c93e8-6b0480a665340.jpeg?jadewits_media_id=168149" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/3f9c26f2f678f367f884c0e1ca2c93e8-6b0480a665340.jpeg?jadewits_media_id=168149" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পরিবারের গল্প নিয়ে ‘পেপার টাইগার’ বানালেন জেমস গ্রে" /&gt;&lt;/p&gt;&lt;p&gt;হলিউডের আলোচিত নির্মাতা জেমস গ্রে। &amp;lsquo;দ্য লস্ট সিটি অব জেড&amp;rsquo;, &amp;lsquo;অ্যাড অ্যাস্ট্রা&amp;rsquo;, &amp;lsquo;টু লাভার্স&amp;rsquo; কিংবা &amp;lsquo;আর্মাগেডন টাইম&amp;rsquo;-এর মতো চলচ্চিত্র দিয়ে আন্তর্জাতিক অঙ্গনে পরিচিতি পেয়েছেন তিনি। ব্যক্তিগত স্মৃতি, পারিবারিক সম্পর্ক ও মানুষের জটিল মনস্তত্ত্ব তাঁর সিনেমার&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/entertainment/hollywood/278553/%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A6%B2%E0%A7%8D%E0%A6%AA-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E2%80%98%E0%A6%AA%E0%A7%87%E0%A6%AA%E0%A6%BE%E0%A6%B0-%E0%A6%9F%E0%A6%BE%E0%A6%87%E0%A6%97%E0%A6%BE%E0%A6%B0%E2%80%99-%E0%A6%AC%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%9C%E0%A7%87%E0%A6%AE%E0%A6%B8">Independent Television</source>
    </item>
    <item>
      <title>গোপালগঞ্জে কার্যক্রম নিষিদ্ধ আওয়ামী লীগের দুই গ্রুপের মধ্যে সংঘর্ষ, ককটেল বিস্ফোরণ, আহত ২০</title>

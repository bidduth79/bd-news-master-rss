      <title>গোপালগঞ্জে আরও ৮ প্লাটুন আনসার মোতায়েন</title>
      <link>https://www.itvbd.com/country/dhaka/278250/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A7%AE-%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%9F%E0%A7%81%E0%A6%A8-%E0%A6%86%E0%A6%A8%E0%A6%B8%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A7%8B%E0%A6%A4%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.itvbd.com/country/dhaka/278250/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A7%AE-%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%9F%E0%A7%81%E0%A6%A8-%E0%A6%86%E0%A6%A8%E0%A6%B8%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A7%8B%E0%A6%A4%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Wed, 18 Nov 2026 18:36:53 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/12/31/c0fd266a684e49a980f750d1858ea8b5-6954b58f11ac0.jpg?jadewits_media_id=150406" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/12/31/c0fd266a684e49a980f750d1858ea8b5-6954b58f11ac0.jpg?jadewits_media_id=150406" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/12/31/c0fd266a684e49a980f750d1858ea8b5-6954b58f11ac0.jpg?jadewits_media_id=150406" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গোপালগঞ্জে আরও ৮ প্লাটুন আনসার মোতায়েন" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জে জনগণের জানমালের নিরাপত্তায় নতুন করে ৮ প্লাটুন আনসার মোতায়েন করা হয়েছে। দায়িত্ব পালনকালে তারা মারণাস্ত্র বা লাইভ বুলেট ব্যবহার করবেন না বলে জানানো হয়েছে। আজ বুধবার সকালে বেদগ্রামে ২৩ আনসার ব্যাটালিয়ন সদর দপ্তরে সংবাদ সম্মেলনে বাহিনীর ঢাকা রেঞ্জের উপ-মহাপরিচালক আসাদুজ্জামান গনী এ তথ্য নিশ্&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/country/dhaka/278250/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A7%AE-%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%9F%E0%A7%81%E0%A6%A8-%E0%A6%86%E0%A6%A8%E0%A6%B8%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A7%8B%E0%A6%A4%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%A8">Independent Television</source>
    </item>

      <guid isPermaLink="true">https://www.itvbd.com/politics/278131/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%87%E0%A6%89%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BE%E0%A6%A3</guid>
      <pubDate>Mon, 16 Nov 2026 13:38:54 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/08/25/c2b2c882c2ad4d75db36ae307432c311-6a8d426323315.jpg?jadewits_media_id=165452" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/08/25/c2b2c882c2ad4d75db36ae307432c311-6a8d426323315.jpg?jadewits_media_id=165452" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/08/25/c2b2c882c2ad4d75db36ae307432c311-6a8d426323315.jpg?jadewits_media_id=165452" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গোপালগঞ্জের ঘটনা আওয়ামী লীগের দেউলিয়াত্বের প্রমাণ: তথ্যমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জের সাম্প্রতিক ঘটনা কার্যক্রম নিষিদ্ধ আওয়ামী লীগের দেউলিয়াত্ব ছাড়া কিছু নয়। আওয়ামী লীগ পাকিস্তানের চেয়ে দেশকে বেশি ক্ষতি করেছে বলে মন্তব্য করেন তথ‍্য ও সম্প্রচার মন্ত্রী আন্দালিভ রহমান পার্থ। এ ছাড়া গোপালগঞ্জের ঘটনার সরকার ধৈর্যের পরিচয় দিয়েছে বলে মন্তব্য করেছেন তথ‍্য ও সম্প্রচার প্রতিমন্&lt;/p&gt;</description>

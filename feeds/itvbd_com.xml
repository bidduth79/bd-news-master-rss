    </item>
    <item>
      <title>শুক্রবার আঘাত হানতে পারে ‘আকভান’</title>
      <link>https://www.itvbd.com/environment/278205/%E0%A6%B6%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%98%E0%A6%BE%E0%A6%A4-%E0%A6%B9%E0%A6%BE%E0%A6%A8%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87-%E2%80%98%E0%A6%86%E0%A6%95%E0%A6%AD%E0%A6%BE%E0%A6%A8%E2%80%99%C2%A0</link>
      <guid isPermaLink="true">https://www.itvbd.com/environment/278205/%E0%A6%B6%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%98%E0%A6%BE%E0%A6%A4-%E0%A6%B9%E0%A6%BE%E0%A6%A8%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87-%E2%80%98%E0%A6%86%E0%A6%95%E0%A6%AD%E0%A6%BE%E0%A6%A8%E2%80%99%C2%A0</guid>
      <pubDate>Tue, 17 Nov 2026 20:50:48 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/06/07/d337aca521c9f5ec744535533ea8315f-6843abb981edf.jpg?jadewits_media_id=123966" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/06/07/d337aca521c9f5ec744535533ea8315f-6843abb981edf.jpg?jadewits_media_id=123966" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/06/07/d337aca521c9f5ec744535533ea8315f-6843abb981edf.jpg?jadewits_media_id=123966" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শুক্রবার আঘাত হানতে পারে ‘আকভান’" /&gt;&lt;/p&gt;&lt;p&gt;আগামী বৃহস্পতিবার তীব্র ঘূর্ণিঝড়ে রূপ নেবে আকভান। যা শুক্রবার দুপুরের পর স্থলভাগে আঘাত হানতে পারে। ঘূর্ণিঝড়টি উত্তর পশ্চিম দিকে এগিয়ে যাচ্ছে। আবহাওয়া অধিদপ্তর বলছে, এর গতিপথ বাংলাদেশের দিকে নেই; ভারতের অন্ধ্রপ্রদেশের উপকূলে আঘাত হানার আশঙ্কা বেশি। 						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/environment/278205/%E0%A6%B6%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%98%E0%A6%BE%E0%A6%A4-%E0%A6%B9%E0%A6%BE%E0%A6%A8%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87-%E2%80%98%E0%A6%86%E0%A6%95%E0%A6%AD%E0%A6%BE%E0%A6%A8%E2%80%99%C2%A0">Independent Television</source>
    </item>

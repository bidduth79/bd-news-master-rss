      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/3436bef7b273d6f2f81d25ec07ffe05e-6afaea2dcd7d0.JPG?jadewits_media_id=167916" length="0" type="image/jpeg" />

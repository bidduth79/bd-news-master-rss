    <item>
      <title>সাগরে নিম্নচাপ, এগোচ্ছে যে পথে</title>
      <link>https://www.itvbd.com/environment/278095/%E0%A6%B8%E0%A6%BE%E0%A6%97%E0%A6%B0%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%AE%E0%A7%8D%E0%A6%A8%E0%A6%9A%E0%A6%BE%E0%A6%AA-%E0%A6%8F%E0%A6%97%E0%A7%8B%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%AF%E0%A7%87-%E0%A6%AA%E0%A6%A5%E0%A7%87</link>
      <guid isPermaLink="true">https://www.itvbd.com/environment/278095/%E0%A6%B8%E0%A6%BE%E0%A6%97%E0%A6%B0%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%AE%E0%A7%8D%E0%A6%A8%E0%A6%9A%E0%A6%BE%E0%A6%AA-%E0%A6%8F%E0%A6%97%E0%A7%8B%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%AF%E0%A7%87-%E0%A6%AA%E0%A6%A5%E0%A7%87</guid>
      <pubDate>Sun, 15 Nov 2026 12:08:52 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/10/19/ca3e94724e29eb54d46534f66b69642d-6713407d9bcc0.jpg?jadewits_media_id=82478" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/10/19/ca3e94724e29eb54d46534f66b69642d-6713407d9bcc0.jpg?jadewits_media_id=82478" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/10/19/ca3e94724e29eb54d46534f66b69642d-6713407d9bcc0.jpg?jadewits_media_id=82478" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাগরে নিম্নচাপ, এগোচ্ছে যে পথে" /&gt;&lt;/p&gt;&lt;p&gt;দক্ষিণপূর্ব বঙ্গোপসাগর ও তৎসংলগ্ন এলাকায় অবস্থানরত সুস্পষ্ট লঘুচাপটি ঘনীভূত হয়ে নিম্নচাপে পরিণত হয়েছে। এটি আরও উত্তর-উত্তরপশ্চিম দিকে অগ্রসর ও ঘনীভূত হয়ে ঘূর্ণিঝড়ে রূপ নিতে পারে। বাংলাদেশ আবহাওয়া অধিদপ্তরের ঝড় সতর্কীকরণ কেন্দ্র আজ সকালে আবহাওয়ার বিশেষ বিজ্ঞপ্তিতে এ তথ্য জানিয়েছে।						বিস্তারিত&lt;/p&gt;</description>

    <item>
      <title>একই টেবিলে বসছেন ট্রাম্প, পুতিন ও শি!</title>
      <link>https://www.itvbd.com/world/278081/%E0%A6%8F%E0%A6%95%E0%A6%87-%E0%A6%9F%E0%A7%87%E0%A6%AC%E0%A6%BF%E0%A6%B2%E0%A7%87-%E0%A6%AC%E0%A6%B8%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA-%E0%A6%AA%E0%A7%81%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%93-%E0%A6%B6%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.itvbd.com/world/278081/%E0%A6%8F%E0%A6%95%E0%A6%87-%E0%A6%9F%E0%A7%87%E0%A6%AC%E0%A6%BF%E0%A6%B2%E0%A7%87-%E0%A6%AC%E0%A6%B8%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA-%E0%A6%AA%E0%A7%81%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%93-%E0%A6%B6%E0%A6%BF</guid>
      <pubDate>Sat, 14 Nov 2026 21:35:00 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/11/02/61ca1f3e8cb117e9fb7ba6e854b22d6b-690772a2734cc.JPG?jadewits_media_id=144262" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/11/02/61ca1f3e8cb117e9fb7ba6e854b22d6b-690772a2734cc.JPG?jadewits_media_id=144262" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/11/02/61ca1f3e8cb117e9fb7ba6e854b22d6b-690772a2734cc.JPG?jadewits_media_id=144262" style="max-width:100%;height:auto;margin-bottom:10px;" alt="একই টেবিলে বসছেন ট্রাম্প, পুতিন ও শি!" /&gt;&lt;/p&gt;&lt;p&gt;বিশ্ব রাজনীতির নানা সংকটের মধ্যে চীনের শেনঝেনে মুখোমুখি হতে যাচ্ছেন যুক্তরাষ্ট্র, রাশিয়া ও চীনের রাষ্ট্রপ্রধান। এপেক সম্মেলনের ফাঁকে হতে যাচ্ছে বহুল আলোচিত এক ঐতিহাসিক ত্রিপক্ষীয় বৈঠক। আলোচনায় গুরুত্ব পেতে পারে পারমাণবিক অস্ত্র নিয়ন্ত্রণ, ইরান ও উত্তর কোরিয়া পরিস্থিতি। বৈশ্বিক নিরাপত্তা ও ভূরাজ&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/world/278081/%E0%A6%8F%E0%A6%95%E0%A6%87-%E0%A6%9F%E0%A7%87%E0%A6%AC%E0%A6%BF%E0%A6%B2%E0%A7%87-%E0%A6%AC%E0%A6%B8%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA-%E0%A6%AA%E0%A7%81%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%93-%E0%A6%B6%E0%A6%BF">Independent Television</source>
    </item>
    <item>
      <title>হরমুজ প্রণালিতে ২৪ ঘণ্টায় ৫ জাহাজে হামলা</title>
      <link>https://www.itvbd.com/world/middle-east/278080/%E0%A6%B9%E0%A6%B0%E0%A6%AE%E0%A7%81%E0%A6%9C-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A3%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A7%A8%E0%A7%AA-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A7%9F-%E0%A7%AB-%E0%A6%9C%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.itvbd.com/world/middle-east/278080/%E0%A6%B9%E0%A6%B0%E0%A6%AE%E0%A7%81%E0%A6%9C-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A3%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A7%A8%E0%A7%AA-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A7%9F-%E0%A7%AB-%E0%A6%9C%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE</guid>
      <pubDate>Sat, 14 Nov 2026 21:24:07 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/08/28/9e62b1ee37c66c9ef4bec692c626e101-6a91854607422.jpg?jadewits_media_id=165582" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/08/28/9e62b1ee37c66c9ef4bec692c626e101-6a91854607422.jpg?jadewits_media_id=165582" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/08/28/9e62b1ee37c66c9ef4bec692c626e101-6a91854607422.jpg?jadewits_media_id=165582" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হরমুজ প্রণালিতে ২৪ ঘণ্টায় ৫ জাহাজে হামলা" /&gt;&lt;/p&gt;&lt;p&gt;ব্যাপক ঝুঁকি নিয়ে হরমুজ প্রণালিতে চলছে বাণিজ্যিক জাহাজ। গত ২৪ ঘণ্টায় ৫টি জাহাজে হামলার ঘটনা ঘটেছে। ইরানের দাবি, তেলবাহী ট্যাঙ্কারে আগুন, নৌমাইনের আঘাত এবং মার্কিন ড্রোন ভূপাতিত করা হয়েছে। জাতিসংঘের তথ্য অনুযায়ী, হরমুজে হামলার সংখ্যা ১৩০ ছাড়িয়েছে, নিহত হয়েছেন ২৫ নাবিক।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/world/middle-east/278080/%E0%A6%B9%E0%A6%B0%E0%A6%AE%E0%A7%81%E0%A6%9C-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A3%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A7%A8%E0%A7%AA-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A7%9F-%E0%A7%AB-%E0%A6%9C%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE">Independent Television</source>
    </item>

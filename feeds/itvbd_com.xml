      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/f04ec4ad244a844e513ede85d9e3d0d5-6af487041279f.jpg?jadewits_media_id=167775" length="0" type="image/jpeg" />

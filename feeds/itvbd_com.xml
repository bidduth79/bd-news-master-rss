      <guid isPermaLink="true">https://www.itvbd.com/entertainment/bollywood/278110/%E0%A6%B8%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%80%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%83%E0%A6%A4-%E0%A6%9B%E0%A6%AC%E0%A6%BF-%E0%A6%9B%E0%A7%9C%E0%A6%BE%E0%A6%A8%E0%A7%8B%E0%A7%9F-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%95%E0%A6%95%E0%A7%87-%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0</guid>
      <pubDate>Sun, 15 Nov 2026 17:06:05 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/66f858eefcb813e15e5a3ac81e15fc31-6af991fb9b8c2.png?jadewits_media_id=167893" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/66f858eefcb813e15e5a3ac81e15fc31-6af991fb9b8c2.png?jadewits_media_id=167893" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/66f858eefcb813e15e5a3ac81e15fc31-6af991fb9b8c2.png?jadewits_media_id=167893" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সোনাক্ষীর বিকৃত ছবি ছড়ানোয় অভিযুক্ত যুবককে মুক্তির নির্দেশ" /&gt;&lt;/p&gt;&lt;p&gt;বলিউড অভিনেত্রী সোনাক্ষী সিনহার এআই দিয়ে তৈরি বিকৃত নগ্ন ছবি সামাজিক যোগাযোগমাধ্যমে ছড়িয়ে দেওয়ার অভিযোগে এক যুবককে গ্রেপ্তার করেছিল মুম্বাই পুলিশ। তবে গ্রেপ্তারের ক্ষেত্রে আইনি প্রক্রিয়া অনুসরণ না করায় শেষ পর্যন্ত আদালতের নির্দেশে মুক্তি পেয়েছেন অভিযুক্ত।
ভারতীয় সংবাদমাধ্যম দ্য ওয়ালের প্রতিবেদন অনুয&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/entertainment/bollywood/278110/%E0%A6%B8%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%80%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%83%E0%A6%A4-%E0%A6%9B%E0%A6%AC%E0%A6%BF-%E0%A6%9B%E0%A7%9C%E0%A6%BE%E0%A6%A8%E0%A7%8B%E0%A7%9F-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%95%E0%A6%95%E0%A7%87-%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0">Independent Television</source>

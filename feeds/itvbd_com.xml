      <title>জাতীয় প্রাণিসম্পদ সপ্তাহের উদ্বোধনী অনুষ্ঠানে প্রধানমন্ত্রী</title>
      <link>https://www.itvbd.com/national/278681/%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3%E0%A6%BF%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%A6-%E0%A6%B8%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B9%E0%A7%87%E0%A6%B0-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%8B%E0%A6%A7%E0%A6%A8%E0%A7%80-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A8%E0%A7%87</link>
      <guid isPermaLink="true">https://www.itvbd.com/national/278681/%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3%E0%A6%BF%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%A6-%E0%A6%B8%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B9%E0%A7%87%E0%A6%B0-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%8B%E0%A6%A7%E0%A6%A8%E0%A7%80-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A8%E0%A7%87</guid>
      <pubDate>Thu, 26 Nov 2026 09:55:40 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/a6fc5381cb90398e5a4d92dfe11e6401-6b07adb00422f.jpg?jadewits_media_id=168228" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/a6fc5381cb90398e5a4d92dfe11e6401-6b07adb00422f.jpg?jadewits_media_id=168228" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/a6fc5381cb90398e5a4d92dfe11e6401-6b07adb00422f.jpg?jadewits_media_id=168228" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জাতীয় প্রাণিসম্পদ সপ্তাহের উদ্বোধনী অনুষ্ঠানে প্রধানমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;জাতীয় প্রাণিসম্পদ সপ্তাহ-২০২৬-এর উদ্বোধনী অনুষ্ঠানে প্রধান অতিথি হিসেবে যোগ দিয়েছেন প্রধানমন্ত্রী তারেক রহমান। আজ বৃহস্পতিবার সকালে রাজধানীর শেরেবাংলা নগরে পুরাতন বাণিজ্য মেলার মাঠে এ অনুষ্ঠানের আয়োজন করা হয়েছে।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/national/278681/%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3%E0%A6%BF%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%A6-%E0%A6%B8%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B9%E0%A7%87%E0%A6%B0-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%8B%E0%A6%A7%E0%A6%A8%E0%A7%80-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A8%E0%A7%87">Independent Television</source>
    </item>
    <item>
      <title>বহুমাত্রিক দারিদ্র্য সূচকে ভারত-পাকিস্তানের চেয়ে ভালো অবস্থানে বাংলাদেশ</title>
      <link>https://www.itvbd.com/national/278680/%E0%A6%AC%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95-%E0%A6%A6%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A7%82%E0%A6%9A%E0%A6%95%E0%A7%87-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4-%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A7%87%E0%A7%9F%E0%A7%87</link>
      <guid isPermaLink="true">https://www.itvbd.com/national/278680/%E0%A6%AC%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95-%E0%A6%A6%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A7%82%E0%A6%9A%E0%A6%95%E0%A7%87-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4-%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A7%87%E0%A7%9F%E0%A7%87</guid>
      <pubDate>Thu, 26 Nov 2026 09:49:27 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/c0c74e770f93a627c46a093debff5c00-6b07ac333502a.jpg?jadewits_media_id=168227" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/c0c74e770f93a627c46a093debff5c00-6b07ac333502a.jpg?jadewits_media_id=168227" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/c0c74e770f93a627c46a093debff5c00-6b07ac333502a.jpg?jadewits_media_id=168227" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বহুমাত্রিক দারিদ্র্য সূচকে ভারত-পাকিস্তানের চেয়ে ভালো অবস্থানে বাংলাদেশ" /&gt;&lt;/p&gt;&lt;p&gt;বহুমাত্রিক দারিদ্র্য সূচকে ভারত ও পাকিস্তানের চেয়ে ভালো অবস্থানে বাংলাদেশ। জাতিসংঘ উন্নয়ন কর্মসূচি ইউএনডিপির তথ্য বলছে, বর্তমানে বাংলাদেশে দারিদ্র্যের হার ১৪ দশমিক ৯ শতাংশ। এই হার ভারতের ১৬ দশমিক ৪ শতাংশ এবং পাকিস্তানে ৩৮ দশমিক ৩ শতাংশ। বিশ্লেষকরা বলছেন, পিছিয়ে পড়া জনগোষ্ঠীর শিক্ষা, স্বাস্থ্য ও জীবন&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/national/278680/%E0%A6%AC%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95-%E0%A6%A6%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A7%82%E0%A6%9A%E0%A6%95%E0%A7%87-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4-%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A7%87%E0%A7%9F%E0%A7%87">Independent Television</source>
    </item>
    <item>
      <title>মিশরে ট্যাংকার উল্টে ভয়াবহ অগ্নিকাণ্ড, নিহত ৩১</title>
      <link>https://www.itvbd.com/world/africa/278679/%E0%A6%AE%E0%A6%BF%E0%A6%B6%E0%A6%B0%E0%A7%87-%E0%A6%9F%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%89%E0%A6%B2%E0%A7%8D%E0%A6%9F%E0%A7%87-%E0%A6%AD%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A6%B9-%E0%A6%85%E0%A6%97%E0%A7%8D%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%A3%E0%A7%8D%E0%A6%A1-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A7%A9%E0%A7%A7</link>
      <guid isPermaLink="true">https://www.itvbd.com/world/africa/278679/%E0%A6%AE%E0%A6%BF%E0%A6%B6%E0%A6%B0%E0%A7%87-%E0%A6%9F%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%89%E0%A6%B2%E0%A7%8D%E0%A6%9F%E0%A7%87-%E0%A6%AD%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A6%B9-%E0%A6%85%E0%A6%97%E0%A7%8D%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%A3%E0%A7%8D%E0%A6%A1-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A7%A9%E0%A7%A7</guid>
      <pubDate>Thu, 26 Nov 2026 08:54:24 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/10faef705eab9a6683f090b6e66d4758-6b079f3b806b5.jpg?jadewits_media_id=168226" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/10faef705eab9a6683f090b6e66d4758-6b079f3b806b5.jpg?jadewits_media_id=168226" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/10faef705eab9a6683f090b6e66d4758-6b079f3b806b5.jpg?jadewits_media_id=168226" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মিশরে ট্যাংকার উল্টে ভয়াবহ অগ্নিকাণ্ড, নিহত ৩১" /&gt;&lt;/p&gt;&lt;p&gt;মিশরের রাজধানী কায়রোতে জ্বালানিবাহী ট্যাংকার দুর্ঘটনার পর ভয়াবহ অগ্নিকাণ্ডে ৩১ জন নিহত হয়েছেন। এ ঘটনায় আহত হয়েছেন অন্তত ২১ জন। স্থানীয় সময় বুধবার সন্ধ্যায় এ দুর্ঘটনা ঘটে। আগুনের সূত্রপাত সম্পর্কে এখনও কিছু জানায়নি কর্তৃপক্ষ।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/world/africa/278679/%E0%A6%AE%E0%A6%BF%E0%A6%B6%E0%A6%B0%E0%A7%87-%E0%A6%9F%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%89%E0%A6%B2%E0%A7%8D%E0%A6%9F%E0%A7%87-%E0%A6%AD%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A6%B9-%E0%A6%85%E0%A6%97%E0%A7%8D%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%A3%E0%A7%8D%E0%A6%A1-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A7%A9%E0%A7%A7">Independent Television</source>
    </item>
    <item>
      <title>রুশ হামলায় ইউক্রেনে বাড়ছে পারমাণবিক দুর্ঘটনার ঝুঁকি</title>
      <link>https://www.itvbd.com/world/europe/278678/%E0%A6%B0%E0%A7%81%E0%A6%B6-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%87%E0%A6%89%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%9B%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%AE%E0%A6%BE%E0%A6%A3%E0%A6%AC%E0%A6%BF%E0%A6%95-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.itvbd.com/world/europe/278678/%E0%A6%B0%E0%A7%81%E0%A6%B6-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%87%E0%A6%89%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%9B%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%AE%E0%A6%BE%E0%A6%A3%E0%A6%AC%E0%A6%BF%E0%A6%95-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Thu, 26 Nov 2026 08:22:09 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/1954f547bc6a364a19f3540c8cb6ab9d-6b0797c16c579.jpg?jadewits_media_id=168225" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/1954f547bc6a364a19f3540c8cb6ab9d-6b0797c16c579.jpg?jadewits_media_id=168225" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/1954f547bc6a364a19f3540c8cb6ab9d-6b0797c16c579.jpg?jadewits_media_id=168225" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রুশ হামলায় ইউক্রেনে বাড়ছে পারমাণবিক দুর্ঘটনার ঝুঁকি" /&gt;&lt;/p&gt;&lt;p&gt;ইউক্রেনে এই শীতে বাড়ছে পারমাণবিক বিপর্যয়ের ঝুঁকি। দেশটির জ্বালানি অবকাঠামোয় রাশিয়ার হামলা জোরদার হওয়ায় ব্যাহত হচ্ছে বিদ্যুৎ সরবরাহ। বিশেষজ্ঞদের আশঙ্কা, নিরবচ্ছিন্ন বিদ্যুৎ না থাকলে পারমাণবিক কেন্দ্রগুলোর রিঅ্যাক্টর ঠান্ডা রাখা কঠিন হয়ে পড়বে, যা বড় ধরনের দুর্ঘটনার কারণ হতে পারে।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/world/europe/278678/%E0%A6%B0%E0%A7%81%E0%A6%B6-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%87%E0%A6%89%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%9B%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%AE%E0%A6%BE%E0%A6%A3%E0%A6%AC%E0%A6%BF%E0%A6%95-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A6%B0">Independent Television</source>

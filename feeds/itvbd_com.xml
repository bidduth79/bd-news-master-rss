    <item>
      <title>দোষী মিয়ানমার, তবুও রোহিঙ্গা প্রত্যাবাসন নিয়ে অনিশ্চয়তা</title>
      <link>https://www.itvbd.com/national/278411/%E0%A6%A6%E0%A7%8B%E0%A6%B7%E0%A7%80-%E0%A6%AE%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0-%E0%A6%A4%E0%A6%AC%E0%A7%81%E0%A6%93-%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87</link>
      <guid isPermaLink="true">https://www.itvbd.com/national/278411/%E0%A6%A6%E0%A7%8B%E0%A6%B7%E0%A7%80-%E0%A6%AE%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0-%E0%A6%A4%E0%A6%AC%E0%A7%81%E0%A6%93-%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87</guid>
      <pubDate>Sat, 21 Nov 2026 18:10:46 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/edd10be5a4084cf11935bfdbbf16a130-6afbdc850f979.jpg?jadewits_media_id=167934" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/edd10be5a4084cf11935bfdbbf16a130-6afbdc850f979.jpg?jadewits_media_id=167934" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/edd10be5a4084cf11935bfdbbf16a130-6afbdc850f979.jpg?jadewits_media_id=167934" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দোষী মিয়ানমার, তবুও রোহিঙ্গা প্রত্যাবাসন নিয়ে অনিশ্চয়তা" /&gt;&lt;/p&gt;&lt;p&gt;রোহিঙ্গা জাতিগোষ্ঠীর বিরুদ্ধে গণহত্যা চালানোর অভিযোগে আন্তর্জাতিক বিচার আদালতের রায়ে দোষী সাব্যস্ত মিয়ানমার। ৭ বছরের বিচারিক প্রক্রিয়া শেষে আসা এই রায়কে স্বাগত জানিয়েছে বাংলাদেশ। তবে, রায়ের পর রোহিঙ্গা প্রত্যাবাসন অগ্রগতি কতটা হবে, তা নিয়ে রয়েছে অনিশ্চয়তা। বিশেষজ্ঞদের পরামর্শ, দেশটির ওপর আন্তর্জাতিক&lt;/p&gt;</description>

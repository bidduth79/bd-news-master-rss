      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/cebef837fd090fa65f1cc1c391b1830d-6af2cd1dd3466.jpg?jadewits_media_id=167716" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দণ্ডিত শেখ হাসিনাকে আইন অনুযায়ী পাসপোর্ট দিতে পারবে না সরকার: চিফ প্রসিকিউটর" /&gt;&lt;/p&gt;&lt;p&gt;মানবতাবিরোধী অপরাধে দণ্ডিত হওয়ায় আইন অনুযায়ী শেখ হাসিনাকে সরকার পাসপোর্ট দিতে পারবে না বলে জানিয়েছেন আন্তর্জাতিক অপরাধ ট্রাইব্যুনালের চিফ প্রসিকিউটর আমিনুল ইসলাম। শেখ হাসিনার দেশে ফেরার আইনি বৈধতা নিয়ে আজ মঙ্গলবার দুপুরে ট্রাইব্যুনালে সংবাদ সম্মেলনে এ তথ্য জানান তিনি।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/national/277848/%E0%A6%A6%E0%A6%A3%E0%A7%8D%E0%A6%A1%E0%A6%BF%E0%A6%A4-%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%86%E0%A6%87%E0%A6%A8-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AF%E0%A6%BE%E0%A7%9F%E0%A7%80-%E0%A6%AA%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%9F-%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87">Independent Television</source>
    </item>
    <item>
      <title>মোহনগঞ্জে ট্রেনে দুর্বৃত্তের আগুন, পুড়ল ৪টি আসন</title>
      <link>https://www.itvbd.com/country/mymensingh/277847/%E0%A6%AE%E0%A7%8B%E0%A6%B9%E0%A6%A8%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%AA%E0%A7%81%E0%A7%9C%E0%A6%B2-%E0%A7%AA%E0%A6%9F%E0%A6%BF-%E0%A6%86%E0%A6%B8%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.itvbd.com/country/mymensingh/277847/%E0%A6%AE%E0%A7%8B%E0%A6%B9%E0%A6%A8%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%AA%E0%A7%81%E0%A7%9C%E0%A6%B2-%E0%A7%AA%E0%A6%9F%E0%A6%BF-%E0%A6%86%E0%A6%B8%E0%A6%A8</guid>
      <pubDate>Tue, 10 Nov 2026 13:52:05 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/fa19978b7bba67e9b93fa8b7721fa32c-6af2cd20b4643.jpg?jadewits_media_id=167717" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/fa19978b7bba67e9b93fa8b7721fa32c-6af2cd20b4643.jpg?jadewits_media_id=167717" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/fa19978b7bba67e9b93fa8b7721fa32c-6af2cd20b4643.jpg?jadewits_media_id=167717" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মোহনগঞ্জে ট্রেনে দুর্বৃত্তের আগুন, পুড়ল ৪টি আসন" /&gt;&lt;/p&gt;&lt;p&gt;নেত্রকোণার মোহনগঞ্জ রেলওয়ে স্টেশনে দাঁড়িয়ে থাকা আন্তঃনগর হাওর এক্সপ্রেস ট্রেনে আগুন দিয়েছে দুর্বৃত্তরা। এতে ট্রেনটির একটি বগির অন্তত চারটি আসনের রেক্সিনের কভার পুড়ে গেছে। মঙ্গলবার ভোর ৬টার দিকে এ ঘটনা হয়। পরে ট্রেনের কর্মী, রেলওয়ে পুলিশ ও ফায়ার সার্ভিসের সদস্যরা আগুন নিয়ন্ত্রণে আনে। 						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/country/mymensingh/277847/%E0%A6%AE%E0%A7%8B%E0%A6%B9%E0%A6%A8%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%AA%E0%A7%81%E0%A7%9C%E0%A6%B2-%E0%A7%AA%E0%A6%9F%E0%A6%BF-%E0%A6%86%E0%A6%B8%E0%A6%A8">Independent Television</source>
    </item>
    <item>
      <title>অভিনেত্রী মেঘলা মুক্তার বাবা নিখোঁজ</title>
      <link>https://www.itvbd.com/entertainment/dhallywood/277846/%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%AE%E0%A7%87%E0%A6%98%E0%A6%B2%E0%A6%BE-%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%96%E0%A7%8B%E0%A6%81%E0%A6%9C</link>
      <guid isPermaLink="true">https://www.itvbd.com/entertainment/dhallywood/277846/%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%AE%E0%A7%87%E0%A6%98%E0%A6%B2%E0%A6%BE-%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%96%E0%A7%8B%E0%A6%81%E0%A6%9C</guid>

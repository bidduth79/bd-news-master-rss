    </item>
    <item>
      <title>বেনাপোল-ঢাকা রুটে রূপসী বাংলা এক্সপ্রেসের চলাচল বন্ধ</title>
      <link>https://www.itvbd.com/country/278676/%E0%A6%AC%E0%A7%87%E0%A6%A8%E0%A6%BE%E0%A6%AA%E0%A7%8B%E0%A6%B2-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%B0%E0%A7%81%E0%A6%9F%E0%A7%87-%E0%A6%B0%E0%A7%82%E0%A6%AA%E0%A6%B8%E0%A7%80-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE-%E0%A6%8F%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%B2%E0%A6%BE%E0%A6%9A%E0%A6%B2</link>
      <guid isPermaLink="true">https://www.itvbd.com/country/278676/%E0%A6%AC%E0%A7%87%E0%A6%A8%E0%A6%BE%E0%A6%AA%E0%A7%8B%E0%A6%B2-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%B0%E0%A7%81%E0%A6%9F%E0%A7%87-%E0%A6%B0%E0%A7%82%E0%A6%AA%E0%A6%B8%E0%A7%80-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE-%E0%A6%8F%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%B2%E0%A6%BE%E0%A6%9A%E0%A6%B2</guid>
      <pubDate>Wed, 25 Nov 2026 22:35:30 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/1381ff1345b41959e023e60d5dbdc94b-6b070df96d150.jpg?jadewits_media_id=168223" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/1381ff1345b41959e023e60d5dbdc94b-6b070df96d150.jpg?jadewits_media_id=168223" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/1381ff1345b41959e023e60d5dbdc94b-6b070df96d150.jpg?jadewits_media_id=168223" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বেনাপোল-ঢাকা রুটে রূপসী বাংলা এক্সপ্রেসের চলাচল বন্ধ" /&gt;&lt;/p&gt;&lt;p&gt;বেনাপোল-ঢাকা রুটে চলাচলকারী রূপসী বাংলা এক্সপ্রেস ট্রেনের যাত্রা সাময়িকভাবে স্থগিত করেছে বাংলাদেশ রেলওয়ে। একই সঙ্গে খুলনা-ঢাকা রুটে চলাচলকারী জাহানাবাদ এক্সপ্রেসের নিয়মিত চলাচলও স্থগিত করা হয়েছে। তবে বিকল্প পথে জাহানাবাদ এক্সপ্রেস চলাচল করবে বলে জানিয়েছে রেল কর্তৃপক্ষ।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/country/278676/%E0%A6%AC%E0%A7%87%E0%A6%A8%E0%A6%BE%E0%A6%AA%E0%A7%8B%E0%A6%B2-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%B0%E0%A7%81%E0%A6%9F%E0%A7%87-%E0%A6%B0%E0%A7%82%E0%A6%AA%E0%A6%B8%E0%A7%80-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE-%E0%A6%8F%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%B2%E0%A6%BE%E0%A6%9A%E0%A6%B2">Independent Television</source>
    </item>
    <item>
      <title>বাংলাদেশসহ ১৪ দেশের ওপর নতুন শুল্ক আরোপের ঘোষণা আমেরিকার</title>

      <guid isPermaLink="true">https://www.itvbd.com/country/barisal/278248/%E0%A6%AC%E0%A6%B0%E0%A6%BF%E0%A6%B6%E0%A6%BE%E0%A6%B2-%E0%A6%B8%E0%A6%BF%E0%A6%AD%E0%A6%BF%E0%A6%B2-%E0%A6%9C%E0%A6%9C-%E0%A6%86%E0%A6%A6%E0%A6%BE%E0%A6%B2%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%8F%E0%A6%95-%E0%A6%AC%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A6%95-%E0%A6%A8%E0%A6%BF%E0%A6%96%E0%A7%8B%E0%A6%81%E0%A6%9C-%C2%A0</guid>
      <pubDate>Wed, 18 Nov 2026 18:04:52 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/9c29614dde66d578a1f8324f57fac923-6afd946055442.jpeg?jadewits_media_id=167976" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/9c29614dde66d578a1f8324f57fac923-6afd946055442.jpeg?jadewits_media_id=167976" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/9c29614dde66d578a1f8324f57fac923-6afd946055442.jpeg?jadewits_media_id=167976" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বরিশাল সিভিল জজ আদালতের এক বিচারক নিখোঁজ!" /&gt;&lt;/p&gt;&lt;p&gt;বরিশাল সিভিল জেলা জজ আদালতের একজন বিচারক নিখোঁজ রয়েছেন। নিখোঁজ ওই বিচারকের নাম শেখ ফারহান নাদিম। তিনি জেলা ও দায়রা জজ আদালতের মেহেন্দিগঞ্জ সিভিল জজ আদালতের বিচারক। তার নিখোঁজের বিষয়টি বুধবার বিকেলে নিশ্চিত করেছেন কোতয়ালী মডেল থানার ভারপ্রাপ্ত কর্মকর্তা (ওসি) মনিরুল ইসলাম।						বিস্তারিত&lt;/p&gt;</description>

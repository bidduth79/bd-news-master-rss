      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/fdea0e31410a535701b46ab8aaf2b587-6af838e053c2e.jpg?jadewits_media_id=167874" length="0" type="image/jpeg" />

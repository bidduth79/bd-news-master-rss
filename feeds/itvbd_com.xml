      <title>দেশব্যাপী রেল প্রসারিত করতে সরকারের উদ্যোগ রয়েছে: রেলমন্ত্রী</title>
      <link>https://www.itvbd.com/country/rajshahi/278322/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AA%E0%A7%80-%E0%A6%B0%E0%A7%87%E0%A6%B2-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%B0%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%9B%E0%A7%87</link>
      <guid isPermaLink="true">https://www.itvbd.com/country/rajshahi/278322/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AA%E0%A7%80-%E0%A6%B0%E0%A7%87%E0%A6%B2-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%B0%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%9B%E0%A7%87</guid>
      <pubDate>Thu, 19 Nov 2026 20:40:04 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/9057b9f29cf8100901d5e088f03418b1-6aff0a420902e.jpeg?jadewits_media_id=168026" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/9057b9f29cf8100901d5e088f03418b1-6aff0a420902e.jpeg?jadewits_media_id=168026" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/9057b9f29cf8100901d5e088f03418b1-6aff0a420902e.jpeg?jadewits_media_id=168026" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দেশব্যাপী রেল প্রসারিত করতে সরকারের উদ্যোগ রয়েছে: রেলমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;দেশব্যাপী রেল ব্যবস্থাপনার উন্নয়ন, রেলযাত্রার মানের উন্নয়ন এবং প্রসারিত করার জন্য বর্তমান সরকারের উদ্যোগ রয়েছে বলে জানিয়েছেন রেলপথ, সড়ক পরিবহন ও সেতু মন্ত্রী শেখ রবিউল ইসলাম। বৃহস্পতিবার সন্ধ্যায় ঢাকা-পাবনা ট্রেন চলাচল উদ্বোধনকালে পাবনা রেলস্টেশনে সাংবাদিকদের তিনি এ বলেন। 						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/country/rajshahi/278322/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AA%E0%A7%80-%E0%A6%B0%E0%A7%87%E0%A6%B2-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%B0%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%9B%E0%A7%87">Independent Television</source>

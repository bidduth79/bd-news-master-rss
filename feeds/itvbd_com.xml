      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/fbdebe14c5cf7f0d06a00af789c1abc1-6afdb3e579d44.jpg?jadewits_media_id=167985" length="0" type="image/jpeg" />

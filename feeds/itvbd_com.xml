      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/05/13/8292a991c6bb4af2e9508b8137a4f751-6641a12bb0dd2.jpg?jadewits_media_id=53946" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/05/13/8292a991c6bb4af2e9508b8137a4f751-6641a12bb0dd2.jpg?jadewits_media_id=53946" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রামপুরায় চাঁদা না পেয়ে ইন্টারনেট সরবরাহকারী প্রতিষ্ঠানে ঢুকে গুলি, আহত ২" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর রামপুরায় চাঁদা না পেয়ে ইন্টারনেট সরবরাহকারী প্রতিষ্ঠানের কার্যালয়ে ঢুকে গুলি চালিয়েছে দুর্বৃত্তরা। এতে প্রতিষ্ঠানটির দুই কর্মচারী গুলিবিদ্ধ হয়েছেন। তাদের ঢাকা মেডিকেল কলেজ হাসপাতালে চিকিৎসা দেয়া হচ্ছে।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/country/dhaka/278119/%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%BE-%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A7%87%E0%A7%9F%E0%A7%87-%E0%A6%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A6%A8%E0%A7%87%E0%A6%9F-%E0%A6%B8%E0%A6%B0%E0%A6%AC%E0%A6%B0%E0%A6%BE%E0%A6%B9%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%80">Independent Television</source>
    </item>

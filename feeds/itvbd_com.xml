      <guid isPermaLink="true">https://www.itvbd.com/economy/278470/%E0%A7%A7%E0%A7%A6-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%B8%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE-%E0%A6%95%E0%A6%AE%E0%A6%B2-%E0%A7%A9%E0%A7%AB-%E0%A6%B6%E0%A6%A4%E0%A6%BE%E0%A6%82%E0%A6%B6-%E0%A7%A8%E0%A7%A8-%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%9F%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Sun, 22 Nov 2026 17:52:42 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/02/01/f0a636fb3a8d2e6a267a25f2024a2a4a-697f8144e6b88.jpg?jadewits_media_id=153492" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/02/01/f0a636fb3a8d2e6a267a25f2024a2a4a-697f8144e6b88.jpg?jadewits_media_id=153492" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/02/01/f0a636fb3a8d2e6a267a25f2024a2a4a-697f8144e6b88.jpg?jadewits_media_id=153492" style="max-width:100%;height:auto;margin-bottom:10px;" alt="১০ মাসে দেশে সোনার দাম কমল ৩৫ শতাংশ, ২২ ক্যারেটের ভরি দুই লাখের নিচে" /&gt;&lt;/p&gt;&lt;p&gt;বিশ্ববাজারে টানা দরপতনের প্রভাব পড়েছে দেশের সোনার বাজারেও। গত ১০ মাসে দেশের বাজারে দাম প্রায় ৩৫ শতাংশ কমে ২ লাখের নিচে নামল সোনার ভরি। চলতি মাসেই ৯ দফা কমেছে দাম। মূলত যুক্তরাষ্ট্রের কেন্দ্রীয় ব্যাংক ফেডারেল রিজার্ভের কঠোর মুদ্রানীতির ইঙ্গিত এবং ডলার শক্তিশালী হওয়ার কারণে বিশ্বজুড়ে সোনার দাম কমছে। 	&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/economy/278470/%E0%A7%A7%E0%A7%A6-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%B8%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE-%E0%A6%95%E0%A6%AE%E0%A6%B2-%E0%A7%A9%E0%A7%AB-%E0%A6%B6%E0%A6%A4%E0%A6%BE%E0%A6%82%E0%A6%B6-%E0%A7%A8%E0%A7%A8-%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%9F%E0%A7%87%E0%A6%B0">Independent Television</source>
    </item>

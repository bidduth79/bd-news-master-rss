      <guid isPermaLink="true">https://www.itvbd.com/politics/278242/%E0%A6%AA%E0%A6%B2%E0%A6%BE%E0%A6%A4%E0%A6%95%E0%A6%B0%E0%A6%BE-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%B8%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%95%E0%A7%87-%E0%A6%85%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BF%E0%A6%A4%E0%A6%BF%E0%A6%B6%E0%A7%80%E0%A6%B2-%E0%A6%95%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%B7%E0%A7%9C%E0%A6%AF%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0</guid>
      <pubDate>Wed, 18 Nov 2026 17:30:51 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/10/27/4e86d61bb8899697e5cc0b7d1592cb49-6ae0a576eba83.JPG?jadewits_media_id=167267" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/10/27/4e86d61bb8899697e5cc0b7d1592cb49-6ae0a576eba83.JPG?jadewits_media_id=167267" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/10/27/4e86d61bb8899697e5cc0b7d1592cb49-6ae0a576eba83.JPG?jadewits_media_id=167267" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পলাতকরা ভারতে বসে দেশকে অস্থিতিশীলের ষড়যন্ত্র করছে: রিজভী" /&gt;&lt;/p&gt;&lt;p&gt;পলাতক শক্তি ও আওয়ামী লীগের নেতারা ভারতে বসে বাংলাদেশকে অস্থিতিশীল করার ষড়যন্ত্র করছে বলে অভিযোগ করেছেন বিএনপির ভারপ্রাপ্ত মহাসচিব রুহুল কবির রিজভী। তিনি বলেন, ‘বিদেশ থেকে ভিডিও বার্তার মাধ্যমে উসকানি ও নাশকতার নির্দেশ দিয়ে কোনো লাভ হবে না।’ 						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/politics/278242/%E0%A6%AA%E0%A6%B2%E0%A6%BE%E0%A6%A4%E0%A6%95%E0%A6%B0%E0%A6%BE-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%B8%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%95%E0%A7%87-%E0%A6%85%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BF%E0%A6%A4%E0%A6%BF%E0%A6%B6%E0%A7%80%E0%A6%B2-%E0%A6%95%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%B7%E0%A7%9C%E0%A6%AF%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0">Independent Television</source>
    </item>
    <item>
      <title>চাঁদপুরে শ্যালককে হত্যার দায়ে ভগ্নিপতির মৃত্যুদণ্ড</title>

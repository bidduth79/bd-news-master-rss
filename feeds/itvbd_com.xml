      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/ef61f472840a76200a9bda73c6f2aaab-6af288c7216c8.JPG?jadewits_media_id=167702" length="0" type="image/jpeg" />

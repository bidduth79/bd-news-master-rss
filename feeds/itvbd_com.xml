      <guid isPermaLink="true">https://www.itvbd.com/economy/278756/%E0%A6%B8%E0%A6%AC%E0%A6%9C%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE-%E0%A6%AC%E0%A7%87%E0%A7%9C%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%82%E0%A6%9B%E2%80%93%E0%A6%AE%E0%A6%BE%E0%A6%82%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BF%E0%A6%A4%E0%A6%BF%E0%A6%B6%E0%A7%80%E0%A6%B2</guid>
      <pubDate>Fri, 27 Nov 2026 16:05:32 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/05/25/90de2b5fb16c9ecc71fac9632c7b1d47-6a1444971e08e.jpg?jadewits_media_id=161959" length="0" type="image/jpeg" />

      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/65feee883e248f68ad22732523739162-6b08fd469986a.jpg?jadewits_media_id=168254" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/65feee883e248f68ad22732523739162-6b08fd469986a.jpg?jadewits_media_id=168254" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/65feee883e248f68ad22732523739162-6b08fd469986a.jpg?jadewits_media_id=168254" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রূপপুরে পৌঁছাল ইউরেনিয়ামের নবম চালান" /&gt;&lt;/p&gt;&lt;p&gt;ইউরেনিয়ামের আরও একটি চালান কঠোর নিরাপত্তা ব্যবস্থার মধ্য দিয়ে পাবনার ঈশ্বরদীতে অবস্থিত রূপপুর পারমাণবিক বিদ্যুৎকেন্দ্রে পৌঁছেছে। শুক্রবার ভোর ৫টা ৪৮ মিনিটে তিনটি বিশেষায়িত লরিতে করে ইউরেনিয়াম প্রকল্প এলাকায় পৌঁছায়। এর মধ্যদিয়ে রূপপুর পারমাণবিক বিদ্যুৎকেন্দ্রের দুটি ইউনিটের জন্য নির্ধারিত নয়টি চালান&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/country/rajshahi/278736/%E0%A6%B0%E0%A7%82%E0%A6%AA%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%AA%E0%A7%8C%E0%A6%81%E0%A6%9B%E0%A6%BE%E0%A6%B2-%E0%A6%87%E0%A6%89%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%AC%E0%A6%AE-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%A8">Independent Television</source>

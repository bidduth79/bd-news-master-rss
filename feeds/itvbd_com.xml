      <pubDate>Tue, 24 Nov 2026 20:49:29 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2023/07/26/deadbody-4b10e21d8172d2ac16c3911071f8bc27.jpg?jadewits_media_id=1340" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2023/07/26/deadbody-4b10e21d8172d2ac16c3911071f8bc27.jpg?jadewits_media_id=1340" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2023/07/26/deadbody-4b10e21d8172d2ac16c3911071f8bc27.jpg?jadewits_media_id=1340" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গোপালগঞ্জে পিকআপ ভ্যানের চাপায় স্কুলছাত্র নিহত" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জে মুরগি বোঝাই পিকআপ ভ্যানের চাপায় শিবা বিশ্বাস (১৪) নামে এক স্কুল শিক্ষার্থী নিহত হয়েছেন। আজ মঙ্গলবার সকাল ১০টার দিকে গোপালগঞ্জ-টেকেরহাট আঞ্চলিক মহাসড়কে এ দুর্ঘটনা হয়। পরে মঙ্গলবার বিকেলে ঢাকার পঙ্গু হাসপাতালে চিকিৎসাধীন অবস্থায় ওই শিক্ষার্থী নিহত হয়। 						বিস্তারিত&lt;/p&gt;</description>

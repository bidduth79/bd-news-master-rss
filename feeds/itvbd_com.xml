    <item>
      <title>চীনের মহাকাশকেন্দ্রে যাচ্ছেন এক পাকিস্তানি, কে এই নভোচারী</title>
      <link>https://www.itvbd.com/world/278616/%E0%A6%9A%E0%A7%80%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%8F%E0%A6%95-%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%95%E0%A7%87-%E0%A6%8F%E0%A6%87</link>
      <guid isPermaLink="true">https://www.itvbd.com/world/278616/%E0%A6%9A%E0%A7%80%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%8F%E0%A6%95-%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%95%E0%A7%87-%E0%A6%8F%E0%A6%87</guid>
      <pubDate>Tue, 24 Nov 2026 22:41:27 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/63308c2a298cacc40f9bb09075465e3b-6b05be35d7863.jpg?jadewits_media_id=168188" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/63308c2a298cacc40f9bb09075465e3b-6b05be35d7863.jpg?jadewits_media_id=168188" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/63308c2a298cacc40f9bb09075465e3b-6b05be35d7863.jpg?jadewits_media_id=168188" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চীনের মহাকাশকেন্দ্রে যাচ্ছেন এক পাকিস্তানি, কে এই নভোচারী" /&gt;&lt;/p&gt;&lt;p&gt;প্রথম বিদেশি নভোচারী হিসেবে চীনের মহাকাশকেন্দ্রে যাচ্ছেন পাকিস্তানের মুহাম্মদ জিশান আলী। চীনের নভোচারীদের সঙ্গে তিনি শেনঝু টোয়েন্টি ফোর মিশনে অংশগ্রহণ করবেন। বুধবার চীনা সময় সকাল ৮টা ১৮ মিনিটে এই মহাকাশযান উৎক্ষেপণ করবে চীন। 						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/world/278616/%E0%A6%9A%E0%A7%80%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%8F%E0%A6%95-%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%95%E0%A7%87-%E0%A6%8F%E0%A6%87">Independent Television</source>
    </item>
    <item>
      <title>পদ্মা ব্যাংককে রেজল্যুশন প্রক্রিয়ার আওতায় আনল কেন্দ্রীয় ব্যাংক</title>
      <link>https://www.itvbd.com/economy/278615/%E0%A6%AA%E0%A6%A6%E0%A7%8D%E0%A6%AE%E0%A6%BE-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A6%95%E0%A7%87-%E0%A6%B0%E0%A7%87%E0%A6%9C%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%B6%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%93%E0%A6%A4%E0%A6%BE%E0%A7%9F-%E0%A6%86%E0%A6%A8%E0%A6%B2</link>
      <guid isPermaLink="true">https://www.itvbd.com/economy/278615/%E0%A6%AA%E0%A6%A6%E0%A7%8D%E0%A6%AE%E0%A6%BE-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A6%95%E0%A7%87-%E0%A6%B0%E0%A7%87%E0%A6%9C%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%B6%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%93%E0%A6%A4%E0%A6%BE%E0%A7%9F-%E0%A6%86%E0%A6%A8%E0%A6%B2</guid>
      <pubDate>Tue, 24 Nov 2026 22:31:05 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/10/04/c8378c6ebed81a594d06b973f83e483c-6ac24d4fa966e.jpg?jadewits_media_id=166668" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/10/04/c8378c6ebed81a594d06b973f83e483c-6ac24d4fa966e.jpg?jadewits_media_id=166668" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/10/04/c8378c6ebed81a594d06b973f83e483c-6ac24d4fa966e.jpg?jadewits_media_id=166668" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পদ্মা ব্যাংককে রেজল্যুশন প্রক্রিয়ার আওতায় আনল কেন্দ্রীয় ব্যাংক" /&gt;&lt;/p&gt;&lt;p&gt;আর্থিক খাতে শৃঙ্খলা ফিরিয়ে আনা এবং আমানতকারীদের স্বার্থ সুরক্ষায় পদ্মা ব্যাংককে রেজল্যুশন প্রক্রিয়ার আওতায় এনেছে বাংলাদেশ ব্যাংক। ব্যাংক রেজল্যুশন আইন, ২০২৬ এর আওতায় কেন্দ্রীয় ব্যাংক এ সিদ্ধান্ত নেয়। এ বিষয়ে মঙ্গলবার একটি প্রজ্ঞাপন জারি করেছে বাংলাদেশ ব্যাংক। 						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/economy/278615/%E0%A6%AA%E0%A6%A6%E0%A7%8D%E0%A6%AE%E0%A6%BE-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A6%95%E0%A7%87-%E0%A6%B0%E0%A7%87%E0%A6%9C%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%B6%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%93%E0%A6%A4%E0%A6%BE%E0%A7%9F-%E0%A6%86%E0%A6%A8%E0%A6%B2">Independent Television</source>
    </item>

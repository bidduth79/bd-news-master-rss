      <guid isPermaLink="true">https://www.itvbd.com/environment/278356/%E0%A6%95%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%AE-%E0%A6%A1%E0%A6%BE%E0%A6%95-%E0%A6%93-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%95%E0%A7%8C%E0%A6%B6%E0%A6%B2%E0%A7%87-%E0%A6%9A%E0%A6%B2%E0%A6%9B%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%96%E0%A6%BF-%E0%A6%A8%E0%A6%BF%E0%A6%A7%E0%A6%A8</guid>
      <pubDate>Fri, 20 Nov 2026 16:07:25 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/02/14/65a2112c4e72b0b79345f31000d178cb-65cc52b9273e9.jpg?jadewits_media_id=38142" length="0" type="image/jpeg" />

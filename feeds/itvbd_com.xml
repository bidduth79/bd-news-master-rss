    <item>
      <title>প্রধানমন্ত্রীর সঙ্গে এনসিপি প্রতিনিধিদলের বৈঠক চলছে</title>
      <link>https://www.itvbd.com/politics/278504/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A6%A7%E0%A6%BF%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95</link>
      <guid isPermaLink="true">https://www.itvbd.com/politics/278504/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A6%A7%E0%A6%BF%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95</guid>
      <pubDate>Mon, 23 Nov 2026 14:35:36 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/05/43511af4f5d21a56ce7b59cab034ab12-6aec1ed0de0bc.jpg?jadewits_media_id=167547" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/05/43511af4f5d21a56ce7b59cab034ab12-6aec1ed0de0bc.jpg?jadewits_media_id=167547" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/05/43511af4f5d21a56ce7b59cab034ab12-6aec1ed0de0bc.jpg?jadewits_media_id=167547" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রধানমন্ত্রীর সঙ্গে এনসিপি প্রতিনিধিদলের বৈঠক চলছে" /&gt;&lt;/p&gt;&lt;p&gt;প্রধানমন্ত্রী তারেক রহমানের সঙ্গে বৈঠক করছে জাতীয় নাগরিক পার্টির (এনসিপি) একটি প্রতিনিধিদল। আজ সোমবার দুপুর ১টার দিকে সচিবালয়ে মন্ত্রিপরিষদ বিভাগের মন্ত্রিসভা কক্ষে এ বৈঠক শুরু হয়। দেশের বিভিন্ন স্থানে ককটেল বিস্ফোরণ, অগ্নিসংযোগ ও সহিংসতার ঘটনার কারণে বিরাজমান রাজনৈতিক পরিস্থিতিতে বৈঠকটি অনুষ্ঠিত হয়&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/politics/278504/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%A8%E0%A6%BF%E0%A6%A7%E0%A6%BF%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95">Independent Television</source>
    </item>

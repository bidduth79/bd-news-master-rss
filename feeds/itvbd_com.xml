      <title>রোনালদোকে সম্মান দেখাতে গিয়ে ইতিহাসের সবচেয়ে বড় লজ্জা পেল পর্তুগাল</title>
      <link>https://www.itvbd.com/sports/football/278089/%E0%A6%B0%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A6%A6%E0%A7%8B%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%97%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%87%E0%A6%A4%E0%A6%BF%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AC%E0%A6%9A%E0%A7%87%E0%A7%9F%E0%A7%87-%E0%A6%AC%E0%A7%9C</link>
      <guid isPermaLink="true">https://www.itvbd.com/sports/football/278089/%E0%A6%B0%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A6%A6%E0%A7%8B%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%97%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%87%E0%A6%A4%E0%A6%BF%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AC%E0%A6%9A%E0%A7%87%E0%A7%9F%E0%A7%87-%E0%A6%AC%E0%A7%9C</guid>
      <pubDate>Sun, 15 Nov 2026 10:35:20 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/26f9e180b2adfe0813ccd1c094e43d28-6af935bfdbe8a.jpg?jadewits_media_id=167883" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/26f9e180b2adfe0813ccd1c094e43d28-6af935bfdbe8a.jpg?jadewits_media_id=167883" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/26f9e180b2adfe0813ccd1c094e43d28-6af935bfdbe8a.jpg?jadewits_media_id=167883" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রোনালদোকে সম্মান দেখাতে গিয়ে ইতিহাসের সবচেয়ে বড় লজ্জা পেল পর্তুগাল" /&gt;&lt;/p&gt;&lt;p&gt;এখানেই শেষ নয়। যে ম্যাচে রোনালদোকে সম্মান দেখানোর কথা, সেই ম্যাচ শেষেই কি না রোনালদোকে নিয়ে আবারও ‘অপমানজনক’ মন্তব্য করেছেন জর্জ জেসুস। রোনালদোকে মিস করছেন কি না, এমন প্রশ্নের জবাবে পর্তুগাল কোচ জানিয়েছেন, শুধু সঙ্গ দেওয়ার জন্য কাউকে পাশে দরকার নেই তাঁর। 						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/sports/football/278089/%E0%A6%B0%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A6%A6%E0%A7%8B%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%97%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%87%E0%A6%A4%E0%A6%BF%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AC%E0%A6%9A%E0%A7%87%E0%A7%9F%E0%A7%87-%E0%A6%AC%E0%A7%9C">Independent Television</source>

      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/cebef837fd090fa65f1cc1c391b1830d-6af2cd1dd3466.jpg?jadewits_media_id=167716" length="0" type="image/jpeg" />

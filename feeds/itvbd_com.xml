    </item>
    <item>
      <title>স্ট্রোকের লক্ষণ বুঝবেন যেভাবে, কখন হাসপাতালে যাবেন?</title>
      <link>https://www.itvbd.com/health/278540/%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%B2%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A3-%E0%A6%AC%E0%A7%81%E0%A6%9D%E0%A6%AC%E0%A7%87%E0%A6%A8-%E0%A6%AF%E0%A7%87%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%95%E0%A6%96%E0%A6%A8-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A7%87</link>
      <guid isPermaLink="true">https://www.itvbd.com/health/278540/%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%B2%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A3-%E0%A6%AC%E0%A7%81%E0%A6%9D%E0%A6%AC%E0%A7%87%E0%A6%A8-%E0%A6%AF%E0%A7%87%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%95%E0%A6%96%E0%A6%A8-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A7%87</guid>
      <pubDate>Mon, 23 Nov 2026 19:46:40 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2023/10/29/0876f660f397e12f6df666de0b817744-653e0a781db32.jpg?jadewits_media_id=17219" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2023/10/29/0876f660f397e12f6df666de0b817744-653e0a781db32.jpg?jadewits_media_id=17219" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2023/10/29/0876f660f397e12f6df666de0b817744-653e0a781db32.jpg?jadewits_media_id=17219" style="max-width:100%;height:auto;margin-bottom:10px;" alt="স্ট্রোকের লক্ষণ বুঝবেন যেভাবে, কখন হাসপাতালে যাবেন?" /&gt;&lt;/p&gt;&lt;p&gt;হঠাৎ কথা জড়িয়ে যাচ্ছে। মুখের এক পাশ বেঁকে গেছে। হাত তুলতে গিয়ে দেখছেন, এক পাশের হাত দুর্বল হয়ে পড়েছে। বয়স মাত্র ৩০ কিংবা ৪০। তাই ভাবছেন, ক্লান্তি বা সাময়িক কোনো সমস্যা। কিন্তু এই লক্ষণগুলো হতে পারে স্ট্রোকের সংকেত।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/health/278540/%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%B2%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A3-%E0%A6%AC%E0%A7%81%E0%A6%9D%E0%A6%AC%E0%A7%87%E0%A6%A8-%E0%A6%AF%E0%A7%87%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%95%E0%A6%96%E0%A6%A8-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A7%87">Independent Television</source>

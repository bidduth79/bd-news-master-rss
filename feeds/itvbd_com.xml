      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/140b284b5809dd4a4481fbfdbb441b62-6afa6cf2f0800.jpg?jadewits_media_id=167900" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/140b284b5809dd4a4481fbfdbb441b62-6afa6cf2f0800.jpg?jadewits_media_id=167900" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/140b284b5809dd4a4481fbfdbb441b62-6afa6cf2f0800.jpg?jadewits_media_id=167900" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যশোর সীমান্তে নজরদারি জোরদার, ফেরারি আসামিদের ধরতে বিজিবির পুরস্কার ঘোষণা" /&gt;&lt;/p&gt;&lt;p&gt;যশোরের শার্শা ও বেনাপোলসহ স্পর্শকাতর সীমান্ত দিয়ে ভারত থেকে দাগি ফেরারি ও গ্রেপ্তারি পরোয়ানাভুক্ত আসামিদের অনুপ্রবেশ রোধে পুরস্কার ঘোষণা করেছে বর্ডার গার্ড বাংলাদেশ (বিজিবি)।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/country/jessore/278121/%E0%A6%AF%E0%A6%B6%E0%A7%8B%E0%A6%B0-%E0%A6%B8%E0%A7%80%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A6%9C%E0%A6%B0%E0%A6%A6%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%9C%E0%A7%8B%E0%A6%B0%E0%A6%A6%E0%A6%BE%E0%A6%B0-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%86%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A7%E0%A6%B0%E0%A6%A4%E0%A7%87">Independent Television</source>

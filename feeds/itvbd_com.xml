    <item>
      <title>ফেনীতে সপ্তাহের ব্যবধানে পুলিশ সুপার পদে ফের বদলি</title>
      <link>https://www.itvbd.com/country/chittagong/278674/%E0%A6%AB%E0%A7%87%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B9%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%B8%E0%A7%81%E0%A6%AA%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%A6%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.itvbd.com/country/chittagong/278674/%E0%A6%AB%E0%A7%87%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B9%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%B8%E0%A7%81%E0%A6%AA%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%A6%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A6%BF</guid>
      <pubDate>Wed, 25 Nov 2026 22:18:54 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/63a46724d55c0b3e68326e976f994f1f-6b070a6bbb858.jpg?jadewits_media_id=168222" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/63a46724d55c0b3e68326e976f994f1f-6b070a6bbb858.jpg?jadewits_media_id=168222" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/63a46724d55c0b3e68326e976f994f1f-6b070a6bbb858.jpg?jadewits_media_id=168222" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফেনীতে সপ্তাহের ব্যবধানে পুলিশ সুপার পদে ফের বদলি" /&gt;&lt;/p&gt;&lt;p&gt;সপ্তাহের ব্যবধানে আবারও পরিবর্তন হলো ফেনী জেলা পুলিশ সুপার (এসপি)। জেলার নতুন পুলিশ সুপার হিসেবে নিয়োগ পেয়েছেন গাইবান্ধার বর্তমান পুলিশ সুপার মো. জসিম উদ্দিন। অন্যদিকে, ফেনীর বর্তমান পুলিশ সুপার মো. হাবীবুল্লাহকে খাগড়াছড়ি পুলিশ লাইনে সংযুক্ত করা হয়েছে। 						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/country/chittagong/278674/%E0%A6%AB%E0%A7%87%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B9%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%B8%E0%A7%81%E0%A6%AA%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%A6%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A6%BF">Independent Television</source>
    </item>
    <item>
      <title>ট্রাম্প কি পারবেন কিমকে থামাতে?</title>
      <link>https://www.itvbd.com/analysis/278673/%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA-%E0%A6%95%E0%A6%BF-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%AC%E0%A7%87%E0%A6%A8-%E0%A6%95%E0%A6%BF%E0%A6%AE%E0%A6%95%E0%A7%87-%E0%A6%A5%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%87</link>
      <guid isPermaLink="true">https://www.itvbd.com/analysis/278673/%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA-%E0%A6%95%E0%A6%BF-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%AC%E0%A7%87%E0%A6%A8-%E0%A6%95%E0%A6%BF%E0%A6%AE%E0%A6%95%E0%A7%87-%E0%A6%A5%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%87</guid>
      <pubDate>Wed, 25 Nov 2026 21:45:16 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/afbefb32d336699d38abf1c4be91f9a0-6b07012280112.jpg?jadewits_media_id=168220" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/afbefb32d336699d38abf1c4be91f9a0-6b07012280112.jpg?jadewits_media_id=168220" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/afbefb32d336699d38abf1c4be91f9a0-6b07012280112.jpg?jadewits_media_id=168220" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ট্রাম্প কি পারবেন কিমকে থামাতে?" /&gt;&lt;/p&gt;&lt;p&gt;মার্কিন প্রেসিডেন্ট ডোনাল্ড ট্রাম্প যদি হন ‘বুনো ওল’, উত্তর কোরিয়ার নেতা কিম জং উন যেন ‘বাঘা তেঁতুল!’ বিশ্ব রাজনীতির এই দুই ‘পাগলা ঘোড়া’ কখন কী করে বসেন, তা অনুমান করার সাধ্য যেন কারো নেই। নিজের স্বার্থ আর লক্ষ্য পূরণে দুজন–ই নিতে পারেন যেকোনো অপ্রত্যাশিত সিদ্ধান্ত।
কারো কাছে নত হওয়া—দুজনেরই স্বভাবব&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/analysis/278673/%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA-%E0%A6%95%E0%A6%BF-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%AC%E0%A7%87%E0%A6%A8-%E0%A6%95%E0%A6%BF%E0%A6%AE%E0%A6%95%E0%A7%87-%E0%A6%A5%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%87">Independent Television</source>
    </item>

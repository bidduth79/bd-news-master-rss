    </item>
    <item>
      <title>রাজনীতিতে আসতে শিক্ষার্থীদের যোগ্য হিসেবে গড়ে ওঠার পরামর্শ প্রধানমন্ত্রীর</title>
      <link>https://www.itvbd.com/national/278116/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%B8%E0%A6%A4%E0%A7%87-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%8D%E0%A6%AF-%E0%A6%B9%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A7%87-%E0%A6%97%E0%A7%9C%E0%A7%87-%E0%A6%93%E0%A6%A0%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.itvbd.com/national/278116/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%B8%E0%A6%A4%E0%A7%87-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%8D%E0%A6%AF-%E0%A6%B9%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A7%87-%E0%A6%97%E0%A7%9C%E0%A7%87-%E0%A6%93%E0%A6%A0%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Sun, 15 Nov 2026 21:26:42 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/7900d386c9c6acb3d5c33e70ff4e66e3-6af9ced2d24e8.jpg?jadewits_media_id=167896" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/7900d386c9c6acb3d5c33e70ff4e66e3-6af9ced2d24e8.jpg?jadewits_media_id=167896" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/15/7900d386c9c6acb3d5c33e70ff4e66e3-6af9ced2d24e8.jpg?jadewits_media_id=167896" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজনীতিতে আসতে শিক্ষার্থীদের যোগ্য হিসেবে গড়ে ওঠার পরামর্শ প্রধানমন্ত্রীর" /&gt;&lt;/p&gt;&lt;p&gt;রাজনীতিতে সম্পৃক্ত হওয়ার আগে নিজেদের যোগ্য, দক্ষ ও দায়িত্বশীল নাগরিক হিসেবে গড়ে তোলার জন্য শিক্ষার্থীদের পরামর্শ দিয়েছেন প্রধানমন্ত্রী তারেক রহমান। রোববার জাতীয় সংসদ ভবনে দেশের বিভিন্ন শিক্ষাপ্রতিষ্ঠানের শিক্ষার্থীদের সঙ্গে আলাপকালে তিনি এ পরামর্শ দেন। প্রধানমন্ত্রীর উপ প্রেস সচিব শাহাদাৎ স্বাধীন এ &lt;/p&gt;</description>
      <source url="https://www.itvbd.com/national/278116/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%B8%E0%A6%A4%E0%A7%87-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%8D%E0%A6%AF-%E0%A6%B9%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A7%87-%E0%A6%97%E0%A7%9C%E0%A7%87-%E0%A6%93%E0%A6%A0%E0%A6%BE%E0%A6%B0">Independent Television</source>

      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/05/24/b11a82cc36e257977586a359e6e795b5-6650a9da7e09d.jpg?jadewits_media_id=55985" length="0" type="image/jpeg" />

      <guid isPermaLink="true">https://www.itvbd.com/economy/277746/%E0%A6%9C%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A7%81%E0%A6%A8%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%82%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A7%9F%E0%A6%A8%E0%A7%87-%E0%A6%AB%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%95-%E0%A6%85%E0%A6%A1%E0%A6%BF%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%97</guid>
      <pubDate>Sun, 08 Nov 2026 18:15:03 +0600</pubDate>
      <description>অতীতে অসত্য তথ্য প্রবাহের কারণে মানুষের অনাস্থা তৈরি হয়েছে। তাই তথ্যের স্বচ্ছতা নিয়ে জনগণ যেন প্রশ্ন তুলতে না পারে, সে নির্দেশনা দিয়েছেন প্রধানমন্ত্রী। রোববার রাজধানীতে পরিসংখ্যান দিবসের আলোচনায় এসব কথা জানান অর্থমন্ত্রী আমির খসরু মাহমুদ চৌধুরী। তিনি বলেন, জিডিপির গরমিল চিহ্নিত করতে ফরেনসিক অডিট করা</description>

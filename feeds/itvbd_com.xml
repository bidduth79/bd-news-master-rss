    </item>
    <item>
      <title>হামের উপসর্গে আরও ৬ মৃত্যু, নতুন রোগী ১৩৭৬</title>
      <link>https://www.itvbd.com/health/278260/%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%89%E0%A6%AA%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A7%AC-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%B0%E0%A7%8B%E0%A6%97%E0%A7%80-%E0%A7%A7%E0%A7%A9%E0%A7%AD%E0%A7%AC</link>
      <guid isPermaLink="true">https://www.itvbd.com/health/278260/%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%89%E0%A6%AA%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A7%AC-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%B0%E0%A7%8B%E0%A6%97%E0%A7%80-%E0%A7%A7%E0%A7%A9%E0%A7%AD%E0%A7%AC</guid>
      <pubDate>Wed, 18 Nov 2026 20:25:38 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/06/12/5ff361a538edc3a86c3dfdc309e5a72f-6a2be9c60fe80.jpg?jadewits_media_id=162536" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/06/12/5ff361a538edc3a86c3dfdc309e5a72f-6a2be9c60fe80.jpg?jadewits_media_id=162536" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/06/12/5ff361a538edc3a86c3dfdc309e5a72f-6a2be9c60fe80.jpg?jadewits_media_id=162536" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হামের উপসর্গে আরও ৬ মৃত্যু, নতুন রোগী ১৩৭৬" /&gt;&lt;/p&gt;&lt;p&gt;দেশে গত ২৪ ঘণ্টায় হামের উপসর্গে ছয়জনের মৃত্যু হয়েছে। একই সময়ে সারাদেশে হাম উপসর্গ এবং নিশ্চিত হামে আক্রান্ত হয়েছেন এক হাজার ৬৩৪ জন। আজ বুধবার স্বাস্থ্য অধিদপ্তরের কন্ট্রোলরুম থেকে পাঠানো হামবিষয়ক এক সংবাদ বিজ্ঞপ্তিতে এ তথ্য জানানো হয়।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/health/278260/%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%89%E0%A6%AA%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A7%AC-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%B0%E0%A7%8B%E0%A6%97%E0%A7%80-%E0%A7%A7%E0%A7%A9%E0%A7%AD%E0%A7%AC">Independent Television</source>
    </item>
    <item>
      <title>পাকিস্তানে সৌরবিদ্যুৎ সফলতায় ধসের মুখে জাতীয় গ্রিড</title>

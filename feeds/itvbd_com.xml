    <item>
      <title>নান্দাইল দিঘির পাড়ে এবারের ‘ইত্যাদি’, দেখা যাবে আজ</title>
      <link>https://www.itvbd.com/entertainment/television-stage/278755/%E0%A6%A8%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%BE%E0%A6%87%E0%A6%B2-%E0%A6%A6%E0%A6%BF%E0%A6%98%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A7%87-%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E2%80%98%E0%A6%87%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A6%E0%A6%BF%E2%80%99</link>
      <guid isPermaLink="true">https://www.itvbd.com/entertainment/television-stage/278755/%E0%A6%A8%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%BE%E0%A6%87%E0%A6%B2-%E0%A6%A6%E0%A6%BF%E0%A6%98%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A7%87-%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E2%80%98%E0%A6%87%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A6%E0%A6%BF%E2%80%99</guid>
      <pubDate>Fri, 27 Nov 2026 19:25:21 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/4065a53096ef1d94c5b50dcf0dc3617a-6b094350de359.jpg?jadewits_media_id=168265" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/4065a53096ef1d94c5b50dcf0dc3617a-6b094350de359.jpg?jadewits_media_id=168265" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/4065a53096ef1d94c5b50dcf0dc3617a-6b094350de359.jpg?jadewits_media_id=168265" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নান্দাইল দিঘির পাড়ে এবারের ‘ইত্যাদি’, দেখা যাবে আজ" /&gt;&lt;/p&gt;&lt;p&gt;জনপ্রিয় ম্যাগাজিন অনুষ্ঠান ‘ইত্যাদি’র এবারের পর্ব ধারণ করা হয়েছে ইতিহাস-ঐতিহ্যে সমৃদ্ধ সীমান্তবর্তী জেলা জয়পুরহাটে। সেখানকার কালাই উপজেলায় সপ্তদশ শতাব্দীতে খনন করা ঐতিহাসিক ‘নান্দাইল দিঘি’র কোলঘেঁষে অবস্থিত নান্দাইল দিঘি কলেজ প্রাঙ্গণে নির্মিত হয়েছিল মূল মঞ্চ। স্বচ্ছ জলরাশি, প্রাচীন আবহ আর আলোকস&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/entertainment/television-stage/278755/%E0%A6%A8%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%BE%E0%A6%87%E0%A6%B2-%E0%A6%A6%E0%A6%BF%E0%A6%98%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A7%87-%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E2%80%98%E0%A6%87%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A6%E0%A6%BF%E2%80%99">Independent Television</source>
    </item>
    <item>
      <title>ইউক্রেন থেকে নজর সরে যাচ্ছে আমেরিকার, অভিযোগ জেলেনস্কির</title>

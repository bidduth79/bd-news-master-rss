    <item>
      <title>‘তাঁর কাছে এটি খুব বড় ব্যাপার নয়’, অনন্তর ঋণ নিয়ে সানী</title>
      <link>https://www.itvbd.com/entertainment/dhallywood/278130/%E2%80%98%E0%A6%A4%E0%A6%BE%E0%A6%81%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%9B%E0%A7%87-%E0%A6%8F%E0%A6%9F%E0%A6%BF-%E0%A6%96%E0%A7%81%E0%A6%AC-%E0%A6%AC%E0%A7%9C-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AA%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A7%9F%E2%80%99-%E0%A6%85%E0%A6%A8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%B0-%E0%A6%8B%E0%A6%A3-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87</link>
      <guid isPermaLink="true">https://www.itvbd.com/entertainment/dhallywood/278130/%E2%80%98%E0%A6%A4%E0%A6%BE%E0%A6%81%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%9B%E0%A7%87-%E0%A6%8F%E0%A6%9F%E0%A6%BF-%E0%A6%96%E0%A7%81%E0%A6%AC-%E0%A6%AC%E0%A7%9C-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AA%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A7%9F%E2%80%99-%E0%A6%85%E0%A6%A8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%B0-%E0%A6%8B%E0%A6%A3-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87</guid>
      <pubDate>Mon, 16 Nov 2026 13:29:06 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/419d86195bee17cf6b7e78fdaef798a8-6afab0614c516.jpg?jadewits_media_id=167907" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/419d86195bee17cf6b7e78fdaef798a8-6afab0614c516.jpg?jadewits_media_id=167907" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/419d86195bee17cf6b7e78fdaef798a8-6afab0614c516.jpg?jadewits_media_id=167907" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘তাঁর কাছে এটি খুব বড় ব্যাপার নয়’, অনন্তর ঋণ নিয়ে সানী" /&gt;&lt;/p&gt;&lt;p&gt;সামাজিক যোগাযোগমাধ্যমে বরাবরই বেশ সরব উপস্থিতি চিত্রনায়ক ওমর সানীর। সমসাময়িক নানা বিষয়ে নিজের মতামত প্রকাশ করেন তিনি। এবার ঢাকাই সিনেমার আরেক জনপ্রিয় নায়ক ও ব্যবসায়ী এম এ জলিল অনন্তকে নিয়ে সাম্প্রতিক আলোচনার বিষয়ে মুখ খুলেছেন এই অভিনেতা। সম্প্রতি অনন্ত জলিলের বিপুল পরিমাণ ঋণের বিষয়টি সামনে আসার পর এ&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/entertainment/dhallywood/278130/%E2%80%98%E0%A6%A4%E0%A6%BE%E0%A6%81%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%9B%E0%A7%87-%E0%A6%8F%E0%A6%9F%E0%A6%BF-%E0%A6%96%E0%A7%81%E0%A6%AC-%E0%A6%AC%E0%A7%9C-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AA%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A7%9F%E2%80%99-%E0%A6%85%E0%A6%A8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%B0-%E0%A6%8B%E0%A6%A3-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87">Independent Television</source>
    </item>

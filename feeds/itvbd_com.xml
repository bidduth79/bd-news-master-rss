      <guid isPermaLink="true">https://www.itvbd.com/national/278605/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%A6%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A6%B6%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%B8%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%AE%E0%A6%A4%E0%A6%BE-%E0%A6%A4%E0%A7%81%E0%A6%B2%E0%A7%87-%E0%A6%A7%E0%A6%B0%E0%A6%AC%E0%A7%87-%E0%A6%AF%E0%A7%8C%E0%A6%A5</guid>
      <pubDate>Tue, 24 Nov 2026 20:28:38 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/3aeffef8827024b694a1738b9e63ee13-6b059f0e9e968.jpg?jadewits_media_id=168184" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/3aeffef8827024b694a1738b9e63ee13-6b059f0e9e968.jpg?jadewits_media_id=168184" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/3aeffef8827024b694a1738b9e63ee13-6b059f0e9e968.jpg?jadewits_media_id=168184" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিশ্বদরবারে সশস্ত্র বাহিনীর সক্ষমতা তুলে ধরবে যৌথ মহড়া: প্রধানমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;প্রধানমন্ত্রী তারেক রহমান বলেছেন, ‘তিন বাহিনীর যৌথ সামরিক মহড়া বিশ্বদরবারে বাংলাদেশের সশস্ত্র বাহিনীর সক্ষমতা তুলে ধরবে।’

তিনি বলেন, ‘বাংলাদেশের সামরিক বাহিনীর ইতিহাসে আজ একটি নতুন অধ্যায়ের সূচনা হয়েছে। দেশের ইতিহাসে প্রথমবারের মতো তিন বাহিনীর স্পেশাল ফোর্সের সমন্বয়ে অনুষ্ঠিত যৌথ সামরিক মহড়ার সাক্ষ&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/national/278605/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%A6%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A6%B6%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%B8%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%AE%E0%A6%A4%E0%A6%BE-%E0%A6%A4%E0%A7%81%E0%A6%B2%E0%A7%87-%E0%A6%A7%E0%A6%B0%E0%A6%AC%E0%A7%87-%E0%A6%AF%E0%A7%8C%E0%A6%A5">Independent Television</source>
    </item>

      <guid isPermaLink="true">https://www.itvbd.com/country/barisal/278123/%E0%A6%AA%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%9C%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%93-%E0%A6%A6%E0%A7%81%E0%A6%87%E0%A6%9F%E0%A6%BF-%E0%A6%A6%E0%A6%B2%E0%A7%80%E0%A7%9F-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87</guid>
      <pubDate>Mon, 16 Nov 2026 09:45:34 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/eb048467f433ff60815c60df414fe55a-6afa7c37b7ece.jpg?jadewits_media_id=167901" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/eb048467f433ff60815c60df414fe55a-6afa7c37b7ece.jpg?jadewits_media_id=167901" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/eb048467f433ff60815c60df414fe55a-6afa7c37b7ece.jpg?jadewits_media_id=167901" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পিরোজপুরে বিএনপি নেতার বাড়ি ও দুইটি দলীয় কার্যালয়ে হামলা-ভাঙচুর" /&gt;&lt;/p&gt;&lt;p&gt;‎পিরোজপুরের নাজিরপুর উপজেলার মালিখালি গ্রামে বিএনপির দুই নেতার বাড়ি ও দলীয় কার্যালয়ে হামলা, ভাঙচুর এবং অগ্নিসংযোগের অভিযোগ উঠেছে কার্যক্রম নিষিদ্ধ আওয়ামী লীগের নেতা-কর্মীদের বিরুদ্ধে। এ ঘটনায় বসতবাড়ির থাই গ্লাস, দলীয় কার্যালয়ের আসবাবপত্র ও টিনের ঘর ক্ষতিগ্রস্ত হয়েছে বলে জানা গেছে।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/country/barisal/278123/%E0%A6%AA%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%9C%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%93-%E0%A6%A6%E0%A7%81%E0%A6%87%E0%A6%9F%E0%A6%BF-%E0%A6%A6%E0%A6%B2%E0%A7%80%E0%A7%9F-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87">Independent Television</source>
    </item>

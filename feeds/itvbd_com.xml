      <pubDate>Tue, 17 Nov 2026 18:03:02 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/10/30/013a149fcb0fd736de926a64641955e4-69034286eba40.JPG?jadewits_media_id=143903" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/10/30/013a149fcb0fd736de926a64641955e4-69034286eba40.JPG?jadewits_media_id=143903" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/10/30/013a149fcb0fd736de926a64641955e4-69034286eba40.JPG?jadewits_media_id=143903" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফের কমল স্বর্ণের দাম" /&gt;&lt;/p&gt;&lt;p&gt;টানা পাঁচ দফায় দেশের বাজারে স্বর্ণের দাম কমলো ১২ হাজার টাকা। আজ নতুন দাম ঘোষণা করে বাংলাদেশ জুয়েলার্স অ্যাসোসিয়েশন - বাজুস। সকাল ১০ টা থেকে কার্যকর হয়েছে।						বিস্তারিত&lt;/p&gt;</description>

      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/5d97842ca7a7be70c533911d3ce076d8-6aff0f2373d39.jpg?jadewits_media_id=168027" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/5d97842ca7a7be70c533911d3ce076d8-6aff0f2373d39.jpg?jadewits_media_id=168027" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কুমিল্লায় মহাসড়কে নাশকতার চেষ্টাকালে গ্রেপ্তার ৬" /&gt;&lt;/p&gt;&lt;p&gt;কুমিল্লার চৌদ্দগ্রামে ঢাকা-চট্টগ্রাম মহাসড়কে টায়ারে আগুন জ্বালিয়ে নাশকতা সৃষ্টির চেষ্টাকালে ছয়জনকে হাতেনাতে গ্রেপ্তার করেছে পুলিশ। বৃহস্পতিবার ভোর ৫টার দিকে উপজেলার আলকরা ইউনিয়নের ফেনী সীমান্তবর্তী পদুয়া রাস্তার মাথা এলাকা থেকে তাদের গ্রেপ্তার করা হয় বলে জানিয়েছেন কুমিল্লার অতিরিক্ত পুলিশ সুপার লুৎফ&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/country/chittagong/278323/%E0%A6%95%E0%A7%81%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A7%9C%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%9A%E0%A7%87%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A7%AC">Independent Television</source>

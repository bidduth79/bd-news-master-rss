    <item>
      <title>রামদা-কুড়াল হাতে হাসপাতালে আগুন দিল আওয়ামী লীগ, আন্তর্জাতিক আইনে যুদ্ধাপরাধের প্রশ্ন</title>
      <link>https://www.itvbd.com/politics/278330/%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%A6%E0%A6%BE-%E0%A6%95%E0%A7%81%E0%A7%9C%E0%A6%BE%E0%A6%B2-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%A6%E0%A6%BF%E0%A6%B2-%E0%A6%86%E0%A6%93%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97</link>
      <guid isPermaLink="true">https://www.itvbd.com/politics/278330/%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%A6%E0%A6%BE-%E0%A6%95%E0%A7%81%E0%A7%9C%E0%A6%BE%E0%A6%B2-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%A6%E0%A6%BF%E0%A6%B2-%E0%A6%86%E0%A6%93%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97</guid>
      <pubDate>Thu, 19 Nov 2026 23:58:37 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/6c611a36826603d449177189b5c917b7-6aff381c03737.jpg?jadewits_media_id=168031" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/6c611a36826603d449177189b5c917b7-6aff381c03737.jpg?jadewits_media_id=168031" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/6c611a36826603d449177189b5c917b7-6aff381c03737.jpg?jadewits_media_id=168031" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রামদা-কুড়াল হাতে হাসপাতালে আগুন দিল আওয়ামী লীগ, আন্তর্জাতিক আইনে যুদ্ধাপরাধের প্রশ্ন" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জে আওয়ামী লীগের তাণ্ডবের মধ্যে রামদা ও কুড়াল হাতে মহড়া এবং হাসপাতালে আগুন দেওয়ার ঘটনা আন্তর্জাতিক মানবিক আইনের আলোকে গুরুতর প্রশ্নের জন্ম দিয়েছে। আন্তর্জাতিক আইন অনুযায়ী, সশস্ত্র সংঘাতের সময় হাসপাতাল ও চিকিৎসাসেবা প্রতিষ্ঠানের ওপর ইচ্ছাকৃত হামলা যুদ্ধাপরাধ হিসেবে গণ্য হতে পারে।						বিস্তারি&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/politics/278330/%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%A6%E0%A6%BE-%E0%A6%95%E0%A7%81%E0%A7%9C%E0%A6%BE%E0%A6%B2-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%A6%E0%A6%BF%E0%A6%B2-%E0%A6%86%E0%A6%93%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97">Independent Television</source>
    </item>
    <item>
      <title>গণতন্ত্র রক্ষায় সবাইকে ঐক্যবদ্ধ হওয়ার আহ্বান প্রধানমন্ত্রীর</title>
      <link>https://www.itvbd.com/national/278329/%E0%A6%97%E0%A6%A3%E0%A6%A4%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A7%9F-%E0%A6%B8%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%87-%E0%A6%90%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%B9%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%B9%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.itvbd.com/national/278329/%E0%A6%97%E0%A6%A3%E0%A6%A4%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A7%9F-%E0%A6%B8%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%87-%E0%A6%90%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%B9%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%B9%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%A8</guid>
      <pubDate>Thu, 19 Nov 2026 23:30:33 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/d3a61280ec698d55eda289a4b8a06e69-6aff323640112.jpg?jadewits_media_id=168030" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/d3a61280ec698d55eda289a4b8a06e69-6aff323640112.jpg?jadewits_media_id=168030" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/d3a61280ec698d55eda289a4b8a06e69-6aff323640112.jpg?jadewits_media_id=168030" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গণতন্ত্র রক্ষায় সবাইকে ঐক্যবদ্ধ হওয়ার আহ্বান প্রধানমন্ত্রীর" /&gt;&lt;/p&gt;&lt;p&gt;দেশের গণতন্ত্র, মানুষের ভোটাধিকার ও নিরাপত্তা রক্ষায় সব গণতন্ত্রকামী রাজনৈতিক দল ও দেশপ্রেমিক মানুষকে ঐক্যবদ্ধ হওয়ার আহ্বান জানিয়েছেন প্রধানমন্ত্রী তারেক রহমান। এসময়, সন্ত্রাসীদের সমুচিত জবাব দিতে জনগণের প্রতি আহ্বান প্রধানমন্ত্রী। লালমনিরহাটে মহেন্দ্রনগর খাল পুনঃখনন কর্মসূচির উদ্বোধন শেষে জনসভায় এ &lt;/p&gt;</description>
      <source url="https://www.itvbd.com/national/278329/%E0%A6%97%E0%A6%A3%E0%A6%A4%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A7%9F-%E0%A6%B8%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%87-%E0%A6%90%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%B9%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%B9%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%A8">Independent Television</source>
    </item>
    <item>
      <title>খুনি চক্রকে রাজনৈতিকভাবে মোকাবিলা করা হবে: সালাউদ্দিন টুকু</title>
      <link>https://www.itvbd.com/politics/278328/%E0%A6%96%E0%A7%81%E0%A6%A8%E0%A6%BF-%E0%A6%9A%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A8%E0%A7%88%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%AE%E0%A7%8B%E0%A6%95%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%B2%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%BE-%E0%A6%B9%E0%A6%AC%E0%A7%87</link>
      <guid isPermaLink="true">https://www.itvbd.com/politics/278328/%E0%A6%96%E0%A7%81%E0%A6%A8%E0%A6%BF-%E0%A6%9A%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A8%E0%A7%88%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%AE%E0%A7%8B%E0%A6%95%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%B2%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%BE-%E0%A6%B9%E0%A6%AC%E0%A7%87</guid>
      <pubDate>Thu, 19 Nov 2026 23:13:40 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/c8da8894e9c1b9fc2e5e103e81d5be4a-6aff2e3992149.jpg?jadewits_media_id=168029" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/c8da8894e9c1b9fc2e5e103e81d5be4a-6aff2e3992149.jpg?jadewits_media_id=168029" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/c8da8894e9c1b9fc2e5e103e81d5be4a-6aff2e3992149.jpg?jadewits_media_id=168029" style="max-width:100%;height:auto;margin-bottom:10px;" alt="খুনি চক্রকে রাজনৈতিকভাবে মোকাবিলা করা হবে: সালাউদ্দিন টুকু" /&gt;&lt;/p&gt;&lt;p&gt;মৎস্য ও প্রাণিসম্পদ প্রতিমন্ত্রী এবং বিএনপির কেন্দ্রীয় প্রচার সম্পাদক সুলতান সালাউদ্দিন টুকু বলেছেন, প্রধানমন্ত্রী তারেক রহমানের নেতৃত্বে দেশ শান্তিপূর্ণভাবে এগিয়ে যাচ্ছে। এ সময় ফ্যাসিস্ট আওয়ামী লীগের খুনি চক্র আবারও হত্যার রাজনীতি শুরু করেছে। তারা মানুষ হত্যা করে দেশে রাজত্ব কায়েম করতে চায়। তবে এই &lt;/p&gt;</description>
      <source url="https://www.itvbd.com/politics/278328/%E0%A6%96%E0%A7%81%E0%A6%A8%E0%A6%BF-%E0%A6%9A%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A8%E0%A7%88%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%AE%E0%A7%8B%E0%A6%95%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%B2%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%BE-%E0%A6%B9%E0%A6%AC%E0%A7%87">Independent Television</source>
    </item>
    <item>
      <title>২৩ থেকে ৩১ ডিসেম্বর বিক্ষোভ ও প্রতিবাদ সমাবেশ করবে এনসিপি</title>
      <link>https://www.itvbd.com/politics/278327/%E0%A7%A8%E0%A7%A9-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A7%A9%E0%A7%A7-%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8B%E0%A6%AD-%E0%A6%93-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%A6-%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%B6-%E0%A6%95%E0%A6%B0%E0%A6%AC%E0%A7%87</link>
      <guid isPermaLink="true">https://www.itvbd.com/politics/278327/%E0%A7%A8%E0%A7%A9-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A7%A9%E0%A7%A7-%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8B%E0%A6%AD-%E0%A6%93-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%A6-%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%B6-%E0%A6%95%E0%A6%B0%E0%A6%AC%E0%A7%87</guid>
      <pubDate>Thu, 19 Nov 2026 22:58:45 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/3749fc286de90d3580ed1ef72bc144e2-6aff29adde30a.jpg?jadewits_media_id=168028" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/3749fc286de90d3580ed1ef72bc144e2-6aff29adde30a.jpg?jadewits_media_id=168028" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/3749fc286de90d3580ed1ef72bc144e2-6aff29adde30a.jpg?jadewits_media_id=168028" style="max-width:100%;height:auto;margin-bottom:10px;" alt="২৩ থেকে ৩১ ডিসেম্বর বিক্ষোভ ও প্রতিবাদ সমাবেশ করবে এনসিপি" /&gt;&lt;/p&gt;&lt;p&gt;কার্যক্রম নিষিদ্ধ সংগঠন আওয়ামী লীগের বিচারসহ ৫ দাবিতে ২৩ নভেম্বর থেকে ৩১ ডিসেম্বর দেশজুড়ে বিক্ষোভ মিছিল ও প্রতিবাদ সমাবেশ করবে জাতীয় নাগরিক পার্টি–এনসিপি। আজ বৃহস্পতিবার রাতে এনসিপির সর্বোচ্চ নীতিনির্ধারণী কমিটি ‘রাজনৈতিক পর্ষদ’–এর জরুরি বৈঠক শেষে সংবাদ সম্মেলনে এ কথা বলেন এনসিপির সদস্য সচিব আখতার হ&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/politics/278327/%E0%A7%A8%E0%A7%A9-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A7%A9%E0%A7%A7-%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8B%E0%A6%AD-%E0%A6%93-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%A6-%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%B6-%E0%A6%95%E0%A6%B0%E0%A6%AC%E0%A7%87">Independent Television</source>
    </item>

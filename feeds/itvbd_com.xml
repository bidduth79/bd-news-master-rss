    </item>
    <item>
      <title>পাবনায় বিএনপির মিছিলের প্রস্তুতির সময় মুখোশধারীদের হামলা ও গুলি, আহত ৫</title>
      <link>https://www.itvbd.com/country/rajshahi/278551/%E0%A6%AA%E0%A6%BE%E0%A6%AC%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%81%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A7%9F-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%8B%E0%A6%B6%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.itvbd.com/country/rajshahi/278551/%E0%A6%AA%E0%A6%BE%E0%A6%AC%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%81%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A7%9F-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%8B%E0%A6%B6%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Tue, 24 Nov 2026 00:11:27 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/fb3be9cf55f0ccf3be57ebcf891cc598-6b04816596dc3.jpg?jadewits_media_id=168150" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/fb3be9cf55f0ccf3be57ebcf891cc598-6b04816596dc3.jpg?jadewits_media_id=168150" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/fb3be9cf55f0ccf3be57ebcf891cc598-6b04816596dc3.jpg?jadewits_media_id=168150" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পাবনায় বিএনপির মিছিলের প্রস্তুতির সময় মুখোশধারীদের হামলা ও গুলি, আহত ৫" /&gt;&lt;/p&gt;&lt;p&gt;পাবনার ঈশ্বরদী উপজেলায় বিএনপির বিক্ষোভ মিছিলের প্রস্তুতির সময় মুখোশধারী দুর্বৃত্তদের অতর্কিত হামলা ও গুলিবর্ষণে অন্তত পাঁচজন আহত হয়েছেন। সোমবার (২৩ নভেম্বর) বিকেলে উপজেলার সাঁড়া ইউনিয়নের মাজদিয়া এলাকায় এ ঘটনা ঘটে।						বিস্তারিত&lt;/p&gt;</description>

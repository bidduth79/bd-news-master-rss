      <title>বৃহস্পতিবার লালমনিরহাট যাচ্ছেন প্রধানমন্ত্রী, আগমন ঘিরে উৎসবের আমেজ</title>
      <link>https://www.itvbd.com/national/278218/%E0%A6%AC%E0%A7%83%E0%A6%B9%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A6%A4%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A6%AE%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%B9%E0%A6%BE%E0%A6%9F-%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%86%E0%A6%97%E0%A6%AE%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.itvbd.com/national/278218/%E0%A6%AC%E0%A7%83%E0%A6%B9%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A6%A4%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A6%AE%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%B9%E0%A6%BE%E0%A6%9F-%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%86%E0%A6%97%E0%A6%AE%E0%A6%A8</guid>
      <pubDate>Wed, 18 Nov 2026 08:44:19 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/07/27/4dbc5f59884dde3ae0946b0e9b46a8be-6a675886d8e21.jpg?jadewits_media_id=164412" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/07/27/4dbc5f59884dde3ae0946b0e9b46a8be-6a675886d8e21.jpg?jadewits_media_id=164412" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/07/27/4dbc5f59884dde3ae0946b0e9b46a8be-6a675886d8e21.jpg?jadewits_media_id=164412" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বৃহস্পতিবার লালমনিরহাট যাচ্ছেন প্রধানমন্ত্রী, আগমন ঘিরে উৎসবের আমেজ" /&gt;&lt;/p&gt;&lt;p&gt;আগামীকাল বৃহস্পতিবার লালমনিরহাট সফরে যাচ্ছেন প্রধানমন্ত্রী তারেক রহমান। প্রধানমন্ত্রীর এই সফর ঘিরে তিস্তা মহাপরিকল্পনা বাস্তবায়ন, শিল্পায়ন ও কর্মসংস্থানের নতুন স্বপ্ন দেখছেন জেলাবাসী। সরকার প্রধানের আগমনকে ঘিরে পুরো শহরে সাজ সাজ রব। এ নিয়ে উচ্ছ্বসিত নেতা-কর্মীরাও।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/national/278218/%E0%A6%AC%E0%A7%83%E0%A6%B9%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A6%A4%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A6%AE%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%B9%E0%A6%BE%E0%A6%9F-%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%86%E0%A6%97%E0%A6%AE%E0%A6%A8">Independent Television</source>
    </item>
    <item>
      <title>দুই মাস পরও থামছে না ফ্রান্সের বিক্ষোভ</title>
      <link>https://www.itvbd.com/world/europe/278217/%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%AE%E0%A6%BE%E0%A6%B8-%E0%A6%AA%E0%A6%B0%E0%A6%93-%E0%A6%A5%E0%A6%BE%E0%A6%AE%E0%A6%9B%E0%A7%87-%E0%A6%A8%E0%A6%BE-%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8B%E0%A6%AD</link>
      <guid isPermaLink="true">https://www.itvbd.com/world/europe/278217/%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%AE%E0%A6%BE%E0%A6%B8-%E0%A6%AA%E0%A6%B0%E0%A6%93-%E0%A6%A5%E0%A6%BE%E0%A6%AE%E0%A6%9B%E0%A7%87-%E0%A6%A8%E0%A6%BE-%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8B%E0%A6%AD</guid>
      <pubDate>Wed, 18 Nov 2026 08:14:46 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/06/bb93d876b64fe8b6da0663dbe4a909ff-6aed5426676c8.jpg?jadewits_media_id=167579" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/06/bb93d876b64fe8b6da0663dbe4a909ff-6aed5426676c8.jpg?jadewits_media_id=167579" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/06/bb93d876b64fe8b6da0663dbe4a909ff-6aed5426676c8.jpg?jadewits_media_id=167579" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দুই মাস পরও থামছে না ফ্রান্সের বিক্ষোভ" /&gt;&lt;/p&gt;&lt;p&gt;দুই মাস পরও থামছে না ফ্রান্সের বিক্ষোভ। জীবনযাত্রার বাড়তি খরচ ও ধনী-গরিবের আয় বৈষম্যের প্রতিবাদে প্যারিস ও নঁতে শহরে আন্দোলন করছে কয়েক হাজার বাসিন্দা। ন্যূনতম মজুরি ও বেতন আরও বাড়ানোর দাবি জানিয়েছেন শ্রমিক, শিক্ষার্থী ও ইউনিয়ন নেতারা। 						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/world/europe/278217/%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%AE%E0%A6%BE%E0%A6%B8-%E0%A6%AA%E0%A6%B0%E0%A6%93-%E0%A6%A5%E0%A6%BE%E0%A6%AE%E0%A6%9B%E0%A7%87-%E0%A6%A8%E0%A6%BE-%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8B%E0%A6%AD">Independent Television</source>
    </item>

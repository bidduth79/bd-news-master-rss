    <item>
      <title>আনফিট কর্মীকে ফিট দেখিয়ে বিদেশ পাঠালে লাইসেন্স বাতিল: বৈদেশিক কর্মসংস্থান মন্ত্রী</title>
      <link>https://www.itvbd.com/national/278759/%E0%A6%86%E0%A6%A8%E0%A6%AB%E0%A6%BF%E0%A6%9F-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%AB%E0%A6%BF%E0%A6%9F-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%AA%E0%A6%BE%E0%A6%A0%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%B8%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%B8</link>
      <guid isPermaLink="true">https://www.itvbd.com/national/278759/%E0%A6%86%E0%A6%A8%E0%A6%AB%E0%A6%BF%E0%A6%9F-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%AB%E0%A6%BF%E0%A6%9F-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%AA%E0%A6%BE%E0%A6%A0%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%B8%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%B8</guid>
      <pubDate>Fri, 27 Nov 2026 17:19:21 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/772b2b4289308ee2eec1f83274f9fcc8-6b0966f7546b1.jpg?jadewits_media_id=168270" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/772b2b4289308ee2eec1f83274f9fcc8-6b0966f7546b1.jpg?jadewits_media_id=168270" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/27/772b2b4289308ee2eec1f83274f9fcc8-6b0966f7546b1.jpg?jadewits_media_id=168270" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আনফিট কর্মীকে ফিট দেখিয়ে বিদেশ পাঠালে লাইসেন্স বাতিল: বৈদেশিক কর্মসংস্থান মন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;শ্রম ও কর্মসংস্থান এবং প্রবাসী কল্যাণ ও বৈদেশিক কর্মসংস্থান মন্ত্রী আরিফুল হক চৌধুরী বলেছেন, মালয়েশিয়াসহ বিভিন্ন দেশে কর্মী পাঠানোর ক্ষেত্রে অনিয়মের প্রমাণ পাওয়া গেলে সংশ্লিষ্ট রিক্রুটিং এজেন্সির বিরুদ্ধে কঠোর ব্যবস্থা নেওয়া হবে। তিনি বলেন, ‘আনফিট’ কর্মীকে ‘ফিট’ দেখিয়ে বিদেশে পাঠানোর প্রমাণ মিললে সং&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/national/278759/%E0%A6%86%E0%A6%A8%E0%A6%AB%E0%A6%BF%E0%A6%9F-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%AB%E0%A6%BF%E0%A6%9F-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%AA%E0%A6%BE%E0%A6%A0%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%B8%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%B8">Independent Television</source>

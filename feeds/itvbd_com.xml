    <item>
      <title>স্বাধীনতার অনেক ইতিহাস আড়ালে রয়ে গেছে: স্পিকার</title>
      <link>https://www.itvbd.com/national/278078/%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%A7%E0%A7%80%E0%A6%A8%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%A8%E0%A7%87%E0%A6%95-%E0%A6%87%E0%A6%A4%E0%A6%BF%E0%A6%B9%E0%A6%BE%E0%A6%B8-%E0%A6%86%E0%A7%9C%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%B0%E0%A7%9F%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.itvbd.com/national/278078/%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%A7%E0%A7%80%E0%A6%A8%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%A8%E0%A7%87%E0%A6%95-%E0%A6%87%E0%A6%A4%E0%A6%BF%E0%A6%B9%E0%A6%BE%E0%A6%B8-%E0%A6%86%E0%A7%9C%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%B0%E0%A7%9F%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Sat, 14 Nov 2026 20:17:04 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/03/12/fa03a415860719274199dbea0667f393-69b275de63d3d.jpg?jadewits_media_id=156997" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/03/12/fa03a415860719274199dbea0667f393-69b275de63d3d.jpg?jadewits_media_id=156997" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/03/12/fa03a415860719274199dbea0667f393-69b275de63d3d.jpg?jadewits_media_id=156997" style="max-width:100%;height:auto;margin-bottom:10px;" alt="স্বাধীনতার অনেক ইতিহাস আড়ালে রয়ে গেছে: স্পিকার" /&gt;&lt;/p&gt;&lt;p&gt;২৪–এর গণঅভ্যুত্থানে সাধারণ মানুষের পক্ষ নেওয়ায় সেনাবাহিনীকে ধন্যবাদ জানিয়েছেন জাতীয় সংসদের স্পিকার মেজর হাফিজ উদ্দিন আহমদ। 

শনিবার সন্ধ্যায় রাজধানীর মহাখালী রাওয়া ক্লাবে ভেটারান্স ডের অনুষ্ঠানে স্পিকার মেজর হাফিজ উদ্দিন আহমদ বলেন, ‘৭১ এ স্বাধীনতার অনেক ইতিহাস আড়ালে রয়ে গেছে।’						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/national/278078/%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%A7%E0%A7%80%E0%A6%A8%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%A8%E0%A7%87%E0%A6%95-%E0%A6%87%E0%A6%A4%E0%A6%BF%E0%A6%B9%E0%A6%BE%E0%A6%B8-%E0%A6%86%E0%A7%9C%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%B0%E0%A7%9F%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0">Independent Television</source>
    </item>
    <item>
      <title>গোপালগঞ্জে বাসের ধাক্কায় সাইকেল আরোহী নিহত, বাসে আগুন</title>
      <link>https://www.itvbd.com/country/dhaka/278077/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%A7%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%87%E0%A6%B2-%E0%A6%86%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A7%80-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87</link>

      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/06/10/4c834e49514580ebe627a349809563f5-6a28e5440e0a6.jpg?jadewits_media_id=162435" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আমেরিকায় ‘ডার্টি বোমা’ হামলার পরিকল্পনা ইরানের" /&gt;&lt;/p&gt;&lt;p&gt;আমেরিকার ওয়াশিংটন ডিসিতে প্রেসিডেন্ট ডোনাল্ড ট্রাম্প প্রশাসনের শীর্ষ কর্মকর্তাদের লক্ষ্য করে ডার্টি বোমা বা রাসায়নিক অস্ত্র হামলার পরিকল্পনা নিয়ে কাজ করছে ইরান। ৭ মার্কিন কর্মকর্তার বরাতে মঙ্গলবার এ তথ্য দিয়েছে সিএনএন। 						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/world/america/278192/%E0%A6%86%E0%A6%AE%E0%A7%87%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A7%9F-%E2%80%98%E0%A6%A1%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A6%BF-%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE%E2%80%99-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A6%A8%E0%A6%BE-%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0">Independent Television</source>
    </item>
    <item>
      <title>পোশাক খাতের মজুরি নির্ধারণে তৃতীয় সভা ২৩ নভেম্বর</title>
      <link>https://www.itvbd.com/economy/278191/%E0%A6%AA%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%95-%E0%A6%96%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%9C%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%A4%E0%A7%83%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%B8%E0%A6%AD%E0%A6%BE-%E0%A7%A8%E0%A7%A9-%E0%A6%A8%E0%A6%AD%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.itvbd.com/economy/278191/%E0%A6%AA%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%95-%E0%A6%96%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%9C%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%A4%E0%A7%83%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%B8%E0%A6%AD%E0%A6%BE-%E0%A7%A8%E0%A7%A9-%E0%A6%A8%E0%A6%AD%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0</guid>
      <pubDate>Tue, 17 Nov 2026 18:03:29 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/11/10/7b214d664397c7e297c81ec2c5202f84-67307be7f2c89.jpg?jadewits_media_id=87026" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/11/10/7b214d664397c7e297c81ec2c5202f84-67307be7f2c89.jpg?jadewits_media_id=87026" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/11/10/7b214d664397c7e297c81ec2c5202f84-67307be7f2c89.jpg?jadewits_media_id=87026" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পোশাক খাতের মজুরি নির্ধারণে তৃতীয় সভা ২৩ নভেম্বর" /&gt;&lt;/p&gt;&lt;p&gt;তৈরি পোশাকশিল্পের শ্রমিকদের নিম্নতম মজুরি নির্ধারণে তৃতীয় সভা ২৩ নভেম্বর অনুষ্ঠিত হবে বলে জানিয়েছে শ্রম মন্ত্রণালয়। ওই দিন সোমবার বেলা সাড়ে ১১টায় রাজধানীর সেগুনবাগিচায় নিম্নতম মজুরি বোর্ডের কার্যালয়ে সভাটি অনুষ্ঠিত হবে। এতে বোর্ডের চেয়ারম্যানের সভাপতিত্বে করবেন। 						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/economy/278191/%E0%A6%AA%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%95-%E0%A6%96%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%9C%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%A4%E0%A7%83%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%B8%E0%A6%AD%E0%A6%BE-%E0%A7%A8%E0%A7%A9-%E0%A6%A8%E0%A6%AD%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0">Independent Television</source>
    </item>
    <item>
      <title>ফের কমল স্বর্ণের দাম</title>
      <link>https://www.itvbd.com/economy/278190/%E0%A6%AB%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%AE%E0%A6%B2-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE</link>

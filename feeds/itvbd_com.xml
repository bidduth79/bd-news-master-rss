      <guid isPermaLink="true">https://www.itvbd.com/country/khulna/277918/%E0%A6%9A%E0%A7%81%E0%A7%9F%E0%A6%BE%E0%A6%A1%E0%A6%BE%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A6%95-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A7%AF-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AF%E0%A6%BE%E0%A6%AC%E0%A6%9C%E0%A7%8D%E0%A6%9C%E0%A7%80%E0%A6%AC%E0%A6%A8%C2%A0</guid>
      <pubDate>Wed, 11 Nov 2026 19:07:15 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/f17f15e6701563f0eefe8cc96eb055fe-6af4683cabdc5.jpg?jadewits_media_id=167766" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/f17f15e6701563f0eefe8cc96eb055fe-6af4683cabdc5.jpg?jadewits_media_id=167766" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/f17f15e6701563f0eefe8cc96eb055fe-6af4683cabdc5.jpg?jadewits_media_id=167766" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চুয়াডাঙ্গায় মাদক মামলায় ৯ বছর পর যুবকের যাবজ্জীবন" /&gt;&lt;/p&gt;&lt;p&gt;চুয়াডাঙ্গায় মাদকদ্রব্য নিয়ন্ত্রণ আইনে করা মামলায় বকুল নামে এক ব্যক্তিকে যাবজ্জীবন কারাদণ্ড দিয়েছেন আদালত। একই সঙ্গে তাকে ৩ হাজার টাকা জরিমানা, অনাদায়ে আরও এক মাসের সশ্রম কারাদণ্ড দেওয়া হয়েছে।

আজ বুধবার দুপুরে চুয়াডাঙ্গার বিশেষ দায়রা জজ আদালতের বিচারক শিমুল কুমার বিশ্বাস আসামির উপস্থিতিতে এ রায় ঘোষণ&lt;/p&gt;</description>

      <title>প্রধানমন্ত্রী তারেক রহমানের সঙ্গে চীনের ভাইস প্রেসিডেন্টের বৈঠক অনুষ্ঠিত</title>
      <link>https://www.itvbd.com/national/277930/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%B0%E0%A6%B9%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%9A%E0%A7%80%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AD%E0%A6%BE%E0%A6%87%E0%A6%B8</link>
      <guid isPermaLink="true">https://www.itvbd.com/national/277930/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%B0%E0%A6%B9%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%9A%E0%A7%80%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AD%E0%A6%BE%E0%A6%87%E0%A6%B8</guid>
      <pubDate>Wed, 11 Nov 2026 22:38:43 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/220eae426a9d8c8a91e625560c4f9be8-6af499d47cbaf.jpg?jadewits_media_id=167778" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/220eae426a9d8c8a91e625560c4f9be8-6af499d47cbaf.jpg?jadewits_media_id=167778" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/220eae426a9d8c8a91e625560c4f9be8-6af499d47cbaf.jpg?jadewits_media_id=167778" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রধানমন্ত্রী তারেক রহমানের সঙ্গে চীনের ভাইস প্রেসিডেন্টের বৈঠক অনুষ্ঠিত" /&gt;&lt;/p&gt;&lt;p&gt;প্রধানমন্ত্রী তারেক রহমানের সঙ্গে চীনের ভাইস প্রেসিডেন্ট হান ঝেং-এর দ্বিপক্ষীয় বৈঠক অনুষ্ঠিত হয়েছে। আজ বুধবার স্থানীয় সময় বিকেল সাড়ে ৪টায় তুরস্কের আনতালিয়ায় জাতিসংঘের জলবায়ু পরিবর্তনবিষয়ক সম্মেলনের (কপ৩১) সাইডলাইনে দুই নেতা বৈঠকে মিলিত হন।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/national/277930/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%95-%E0%A6%B0%E0%A6%B9%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%9A%E0%A7%80%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AD%E0%A6%BE%E0%A6%87%E0%A6%B8">Independent Television</source>
    </item>
    <item>
      <title>পাকিস্তানে পুলিশের ওপর হামলায় নিহত ১০</title>
      <link>https://www.itvbd.com/world/pakistan/277929/%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A7%A7%E0%A7%A6</link>

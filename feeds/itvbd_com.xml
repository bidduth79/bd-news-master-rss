    <item>
      <title>পাগলা মসজিদের দানবাক্সে এবার মিলল ১৮ কোটি ২১ লাখ টাকা</title>
      <link>https://www.itvbd.com/country/dhaka/278425/%E0%A6%AA%E0%A6%BE%E0%A6%97%E0%A6%B2%E0%A6%BE-%E0%A6%AE%E0%A6%B8%E0%A6%9C%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A7%87-%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2-%E0%A7%A7%E0%A7%AE-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A7%A8%E0%A7%A7-%E0%A6%B2%E0%A6%BE%E0%A6%96</link>
      <guid isPermaLink="true">https://www.itvbd.com/country/dhaka/278425/%E0%A6%AA%E0%A6%BE%E0%A6%97%E0%A6%B2%E0%A6%BE-%E0%A6%AE%E0%A6%B8%E0%A6%9C%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A7%87-%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2-%E0%A7%A7%E0%A7%AE-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A7%A8%E0%A7%A7-%E0%A6%B2%E0%A6%BE%E0%A6%96</guid>
      <pubDate>Sat, 21 Nov 2026 22:53:17 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/c60524d30424f1b6f551217cfef5f26e-6b01cc46d6872.jpg?jadewits_media_id=168076" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/c60524d30424f1b6f551217cfef5f26e-6b01cc46d6872.jpg?jadewits_media_id=168076" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/c60524d30424f1b6f551217cfef5f26e-6b01cc46d6872.jpg?jadewits_media_id=168076" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পাগলা মসজিদের দানবাক্সে এবার মিলল ১৮ কোটি ২১ লাখ টাকা" /&gt;&lt;/p&gt;&lt;p&gt;কিশোরগঞ্জের ঐতিহ্যবাহী পাগলা মসজিদের ১৫টি দানবাক্স খুলে এবার পাওয়া গেছে ১৮ কোটি ২১ লাখ ৬৯ হাজার ৫১৭ টাকা। প্রায় পাঁচ মাসের জমা হওয়া এসব টাকার পাশাপাশি পাওয়া গেছে বিপুল পরিমাণ স্বর্ণালংকার, রুপা ও বৈদেশিক মুদ্রা। দানের অর্থ দিয়ে আন্তর্জাতিক মানের ইসলামিক কমপ্লেক্স নির্মাণ এবং জেলার দরিদ্র ও অসহায় রোগ&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/country/dhaka/278425/%E0%A6%AA%E0%A6%BE%E0%A6%97%E0%A6%B2%E0%A6%BE-%E0%A6%AE%E0%A6%B8%E0%A6%9C%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A7%87-%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2-%E0%A7%A7%E0%A7%AE-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A7%A8%E0%A7%A7-%E0%A6%B2%E0%A6%BE%E0%A6%96">Independent Television</source>
    </item>
    <item>
      <title>ইয়েমেনের দুই জেলায় বিমান হামলার দাবি হুতিদের</title>
      <link>https://www.itvbd.com/world/middle-east/278424/%E0%A6%87%E0%A7%9F%E0%A7%87%E0%A6%AE%E0%A7%87%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF-%E0%A6%B9%E0%A7%81%E0%A6%A4%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.itvbd.com/world/middle-east/278424/%E0%A6%87%E0%A7%9F%E0%A7%87%E0%A6%AE%E0%A7%87%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF-%E0%A6%B9%E0%A7%81%E0%A6%A4%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Sat, 21 Nov 2026 21:30:23 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/04/18/f22acac46cbcf87265f67f1e990efb09-6801bb4730439.jpg?jadewits_media_id=116383" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/04/18/f22acac46cbcf87265f67f1e990efb09-6801bb4730439.jpg?jadewits_media_id=116383" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/04/18/f22acac46cbcf87265f67f1e990efb09-6801bb4730439.jpg?jadewits_media_id=116383" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইয়েমেনের দুই জেলায় বিমান হামলার দাবি হুতিদের" /&gt;&lt;/p&gt;&lt;p&gt;ইয়েমেনের তাইজ প্রদেশের দুটি জেলায় বিমান হামলার দাবি করেছে দেশটির হুতি বিদ্রোহী গোষ্ঠী। এছাড়া হুতি নিয়ন্ত্রিত সানা, তাইজ ও সাদা প্রদেশে ইয়েমেন সরকারি বাহিনীর অভিযান চালানোর কথা জানানো হয়েছে। তবে এ অভিযানে এখনও কোনো হুতি সদস্যের হতাহতের খবর দেওয়া হয়নি। খবর রয়টার্সের।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/world/middle-east/278424/%E0%A6%87%E0%A7%9F%E0%A7%87%E0%A6%AE%E0%A7%87%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF-%E0%A6%B9%E0%A7%81%E0%A6%A4%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0">Independent Television</source>
    </item>
    <item>
      <title>রোহিঙ্গা মামলার রায়ে গাজা নিয়ে চাপে ইসরায়েল</title>
      <link>https://www.itvbd.com/world/middle-east/278423/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%AA%E0%A7%87-%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%B2</link>
      <guid isPermaLink="true">https://www.itvbd.com/world/middle-east/278423/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%AA%E0%A7%87-%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%B2</guid>
      <pubDate>Sat, 21 Nov 2026 21:25:32 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/04/24/a55bbfc02abc561d994f32ce0411dd1f-69eb69c92fb48.jpg?jadewits_media_id=160591" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/04/24/a55bbfc02abc561d994f32ce0411dd1f-69eb69c92fb48.jpg?jadewits_media_id=160591" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/04/24/a55bbfc02abc561d994f32ce0411dd1f-69eb69c92fb48.jpg?jadewits_media_id=160591" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রোহিঙ্গা মামলার রায়ে গাজা নিয়ে চাপে ইসরায়েল" /&gt;&lt;/p&gt;&lt;p&gt;রোহিঙ্গা গণহত্যায় মিয়ানমারকে অভিযুক্ত করার ঐতিহাসিক রায়ে বদলে যাচ্ছে ইসরায়েলের আইনি লড়াইয়ের যৌক্তিকতা। বিশেষজ্ঞদের মতে, আন্তর্জাতিক বিচার আদালত বা আইসিজে-র এমন ভূমিকা গাজা সংক্রান্ত মামলায় ইসরায়েলের ওপর বড় ধরনের চাপ সৃষ্টি করবে। তাই গণহত্যার চেষ্টা প্রমাণের ক্ষেত্রে এই আইনি লড়াইয়ের নজির ইসরায়েলের অব&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/world/middle-east/278423/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%AA%E0%A7%87-%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A7%87%E0%A6%B2">Independent Television</source>
    </item>
    <item>
      <title>পশ্চিমবঙ্গে আড়াই হাজার মেগাওয়াট নবায়নযোগ্য বিদ্যুৎ সরবরাহ করবে আদানি</title>
      <link>https://www.itvbd.com/world/india/278422/%E0%A6%AA%E0%A6%B6%E0%A7%8D%E0%A6%9A%E0%A6%BF%E0%A6%AE%E0%A6%AC%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%86%E0%A7%9C%E0%A6%BE%E0%A6%87-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A7%87%E0%A6%97%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%9F-%E0%A6%A8%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A6%A8%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%8D%E0%A6%AF-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A7%8E</link>
      <guid isPermaLink="true">https://www.itvbd.com/world/india/278422/%E0%A6%AA%E0%A6%B6%E0%A7%8D%E0%A6%9A%E0%A6%BF%E0%A6%AE%E0%A6%AC%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%86%E0%A7%9C%E0%A6%BE%E0%A6%87-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A7%87%E0%A6%97%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%9F-%E0%A6%A8%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A6%A8%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%8D%E0%A6%AF-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A7%8E</guid>
      <pubDate>Sat, 21 Nov 2026 21:15:40 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/02/11/70f2a43233ee0ec1167c7d2c102ca37d-67ab11467bc0e.jpg?jadewits_media_id=105514" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/02/11/70f2a43233ee0ec1167c7d2c102ca37d-67ab11467bc0e.jpg?jadewits_media_id=105514" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/02/11/70f2a43233ee0ec1167c7d2c102ca37d-67ab11467bc0e.jpg?jadewits_media_id=105514" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পশ্চিমবঙ্গে আড়াই হাজার মেগাওয়াট নবায়নযোগ্য বিদ্যুৎ সরবরাহ করবে আদানি" /&gt;&lt;/p&gt;&lt;p&gt;ভারতের পশ্চিমবঙ্গে ২৫ বছর মেয়াদে নবায়নযোগ্য বিদ্যুৎ সরবরাহের কার্যাদেশ পেয়েছে আদানি এনার্জি সলিউশনস লিমিটেডের (এইএসএল) শতভাগ মালিকানাধীন সহযোগী প্রতিষ্ঠান পাওয়ারপালস ট্রেডিং সলিউশনস লিমিটেড (পিটিএসএল)। পশ্চিমবঙ্গ রাজ্য বিদ্যুৎ বিতরণ কোম্পানি লিমিটেডের (ডব্লিউবিএসইডিসিএল) কাছ থেকে এ কার্যাদেশ পেয়েছে &lt;/p&gt;</description>
      <source url="https://www.itvbd.com/world/india/278422/%E0%A6%AA%E0%A6%B6%E0%A7%8D%E0%A6%9A%E0%A6%BF%E0%A6%AE%E0%A6%AC%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%86%E0%A7%9C%E0%A6%BE%E0%A6%87-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A7%87%E0%A6%97%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%9F-%E0%A6%A8%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A6%A8%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%8D%E0%A6%AF-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A7%8E">Independent Television</source>

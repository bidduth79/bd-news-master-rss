      <guid isPermaLink="true">https://www.itvbd.com/national/278417/%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%86.%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A6%95%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A8%E0%A7%88%E0%A6%A4%E0%A6%BF%E0%A6%95%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%AE%E0%A7%8B%E0%A6%95%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%B2%E0%A6%BE</guid>
      <pubDate>Sat, 21 Nov 2026 20:05:37 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/10/23/98c8155112550ad2c9bc5cd12ea1d6a0-68f9d7a45546c.jpg?jadewits_media_id=142921" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/10/23/98c8155112550ad2c9bc5cd12ea1d6a0-68f9d7a45546c.jpg?jadewits_media_id=142921" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/10/23/98c8155112550ad2c9bc5cd12ea1d6a0-68f9d7a45546c.jpg?jadewits_media_id=142921" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কার্যক্রম নিষিদ্ধ আ.লীগকে রাজনৈতিকভাবে মোকাবিলা করবে সরকার: আইনমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;কার্যক্রম নিষিদ্ধ আওয়ামী লীগকে গুলি করে নয়, রাজনৈতিকভাবে মোকাবিলা করবে সরকার বলে জানিয়েছেন আইনমন্ত্রী মো. আসাদুজ্জামান।

শনিবার রাজধানীর শাহবাগে জাতীয় জাদুঘরে চুয়াডাঙ্গার শিক্ষার্থীদের মিলনমেলা ও শিক্ষাবৃত্তি প্রদান অনুষ্ঠানে তিনি এ কথা জানান। 						বিস্তারিত&lt;/p&gt;</description>

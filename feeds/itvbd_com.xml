    <item>
      <title>মিথিলা নয়, ‘অ্যালেন স্বপন’র সঙ্গী এবার প্রভা</title>
      <link>https://www.itvbd.com/entertainment/ott/278501/%E0%A6%AE%E0%A6%BF%E0%A6%A5%E0%A6%BF%E0%A6%B2%E0%A6%BE-%E0%A6%A8%E0%A7%9F-%E2%80%98%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%AA%E0%A6%A8%E2%80%99%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%80-%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AD%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.itvbd.com/entertainment/ott/278501/%E0%A6%AE%E0%A6%BF%E0%A6%A5%E0%A6%BF%E0%A6%B2%E0%A6%BE-%E0%A6%A8%E0%A7%9F-%E2%80%98%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%AA%E0%A6%A8%E2%80%99%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%80-%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AD%E0%A6%BE</guid>
      <pubDate>Mon, 23 Nov 2026 14:08:39 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/985293b5fea56ec17a397ebc64093448-6b03f3a639627.jpg?jadewits_media_id=168123" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/985293b5fea56ec17a397ebc64093448-6b03f3a639627.jpg?jadewits_media_id=168123" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/23/985293b5fea56ec17a397ebc64093448-6b03f3a639627.jpg?jadewits_media_id=168123" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মিথিলা নয়, ‘অ্যালেন স্বপন’র সঙ্গী এবার প্রভা" /&gt;&lt;/p&gt;&lt;p&gt;দেশের ওটিটি ইতিহাসে অন্যতম আলোচিত চরিত্র ‘অ্যালেন স্বপন’। ২০২২ সালে ‘সিন্ডিকেট’ সিরিজে সর্বপ্রথম এই চরিত্রের দেখা মেলে। চরিত্রটির আকাশচুম্বী জনপ্রিয়তায় নির্মাতা শিহাব শাহীন নির্মাণ করেন আলাদা সিরিজ ‘মাইশেলফ অ্যালেন স্বপন’। সেটিতেও দর্শকদের দারুণ সাড়া মেলে, ‘অ্যালেন স্বপন’ রূপে তুমুল প্রশংসিত হন অভিন&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/entertainment/ott/278501/%E0%A6%AE%E0%A6%BF%E0%A6%A5%E0%A6%BF%E0%A6%B2%E0%A6%BE-%E0%A6%A8%E0%A7%9F-%E2%80%98%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%AA%E0%A6%A8%E2%80%99%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%80-%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AD%E0%A6%BE">Independent Television</source>
    </item>
    <item>
      <title>মুন্সিগঞ্জে অটোরিকশা গ্যারেজে ডাকাতি, ব্যবসায়ীর হাত-পা বাঁধা মরদেহ উদ্ধার</title>

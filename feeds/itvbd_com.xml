      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/fbdebe14c5cf7f0d06a00af789c1abc1-6afdb3e579d44.jpg?jadewits_media_id=167985" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পাকিস্তানে সৌরবিদ্যুৎ সফলতায় ধসের মুখে জাতীয় গ্রিড" /&gt;&lt;/p&gt;&lt;p&gt;পাকিস্তানে সৌরবিদ্যুতের ব্যাপক বিস্তারে জাতীয় বিদ্যুৎ গ্রিড বড় ধরনের সংকটে পড়েছে। ঘরে ঘরে সোলার প্যানেল স্থাপনের ফলে গ্রিডের বিদ্যুতের চাহিদা কমে গেছে। এতে গ্রিডের রক্ষণাবেক্ষণ ব্যয় মেটানো কঠিন হয়ে পড়ছে সরকারের জন্য। 						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/world/pakistan/278259/%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%B8%E0%A7%8C%E0%A6%B0%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A7%8E-%E0%A6%B8%E0%A6%AB%E0%A6%B2%E0%A6%A4%E0%A6%BE%E0%A7%9F-%E0%A6%A7%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%A1">Independent Television</source>
    </item>
    <item>
      <title>ব্যবসার আড়ালে নানক ও শামীম ওসমান পরিবারের ৪৫৩ কোটি টাকা পাচার</title>
      <link>https://www.itvbd.com/politics/278258/%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A7%9C%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%A8%E0%A6%95-%E0%A6%93-%E0%A6%B6%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%AE-%E0%A6%93%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A7%AA%E0%A7%AB%E0%A7%A9-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.itvbd.com/politics/278258/%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A7%9C%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%A8%E0%A6%95-%E0%A6%93-%E0%A6%B6%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%AE-%E0%A6%93%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A7%AA%E0%A7%AB%E0%A7%A9-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF</guid>
      <pubDate>Wed, 18 Nov 2026 20:09:13 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/c1afaeb2f1cb61fbd786b43523242668-6afdb16d2e72c.jpg?jadewits_media_id=167984" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/c1afaeb2f1cb61fbd786b43523242668-6afdb16d2e72c.jpg?jadewits_media_id=167984" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/c1afaeb2f1cb61fbd786b43523242668-6afdb16d2e72c.jpg?jadewits_media_id=167984" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ব্যবসার আড়ালে নানক ও শামীম ওসমান পরিবারের ৪৫৩ কোটি টাকা পাচার" /&gt;&lt;/p&gt;&lt;p&gt;কার্যক্রম নিষিদ্ধ আওয়ামী লীগের দুই নেতা জাহাঙ্গীর কবির নানক ও শামীম ওসমানের বিরুদ্ধে টাকা পাচারের প্রমাণ পেয়েছে দুদক। সংস্থাটির অভিযোগ, টেলিকম ব্যবসার আড়ালে নানক ও শামীম ওসমানের পরিবার পাচার করেছে ৪৫৩ কোটি টাকা। এরই মধ্যে দুই পরিবারের ৯ জনের বিরুদ্ধে চার্জশিটে অনুমোদন দিয়েছে দুদক। 						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/politics/278258/%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A7%9C%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%A8%E0%A6%95-%E0%A6%93-%E0%A6%B6%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%AE-%E0%A6%93%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A7%AA%E0%A7%AB%E0%A7%A9-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF">Independent Television</source>
    </item>

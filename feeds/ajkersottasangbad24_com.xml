    <item>
      <title>মাদকের বিরুদ্ধে কোস্ট গার্ডের অভিযান; কক্সবাজারের টেকনাফে ১০ হাজার পিস ইয়াবা জব্দ</title>
      <link>https://ajkersottasangbad24.com/%e0%a6%ae%e0%a6%be%e0%a6%a6%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%b0%e0%a7%81%e0%a6%a6%e0%a7%8d%e0%a6%a7%e0%a7%87-%e0%a6%95%e0%a7%8b%e0%a6%b8%e0%a7%8d%e0%a6%9f-%e0%a6%97%e0%a6%be/</link>

      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/05/Trump-Shi-Jin-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/05/Trump-Shi-Jin-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চীন সফরে এনভিডিয়া কেলেঙ্কারি নিয়ে কথা বলবেন না ট্রাম্প" /&gt;&lt;/p&gt;&lt;p&gt;চীন সফরে এনভিডিয়ার প্রধান নির্বাহী কর্মকর্তা জেনসেন হুয়াংকে ঘিরে আলোচিত কেলেঙ্কারি নিয়ে কোনো আলোচনা করবেন না যুক্তরাষ্ট্রের প্রেসিডেন্ট ডোনাল্ড ট্রাম্প। মার্কিন প্রশাসনের জ্যেষ্ঠ কর্মকর্তারা জানিয়েছেন, আগামী ১৮ ও ১৯ নভেম্বর চীনের শেনজেনে এশিয়া-প্যাসিফিক অর্থনৈতিক সহযোগিতা (এপেক) সম্মেলনে অংশ নেওয়ার &lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982388/%e0%a6%9a%e0%a7%80%e0%a6%a8-%e0%a6%b8%e0%a6%ab%e0%a6%b0%e0%a7%87-%e0%a6%8f%e0%a6%a8%e0%a6%ad%e0%a6%bf%e0%a6%a1%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be-%e0%a6%95%e0%a7%87%e0%a6%b2%e0%a7%87%e0%a6%99/">অর্থসূচক</source>
    </item>
    <item>
      <title>বিডি ক্রিয়েশনের কর্মীদের পেরোল ব্যাংকিং সেবা দেবে প্রাইম ব্যাংক</title>
      <link>https://www.arthosuchak.com/archives/982359/%e0%a6%ac%e0%a6%bf%e0%a6%a1%e0%a6%bf-%e0%a6%95%e0%a7%8d%e0%a6%b0%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%b6%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a7%80%e0%a6%a6%e0%a7%87/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982359/%e0%a6%ac%e0%a6%bf%e0%a6%a1%e0%a6%bf-%e0%a6%95%e0%a7%8d%e0%a6%b0%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%b6%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a7%80%e0%a6%a6%e0%a7%87/</guid>
      <pubDate>Sun, 15 Nov 2026 06:55:34 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Prime-BAnk-Payroll-Creation-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Prime-BAnk-Payroll-Creation-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Prime-BAnk-Payroll-Creation-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিডি ক্রিয়েশনের কর্মীদের পেরোল ব্যাংকিং সেবা দেবে প্রাইম ব্যাংক" /&gt;&lt;/p&gt;&lt;p&gt;বিডি ক্রিয়েশন লিমিটেডের কর্মকর্তা-কর্মচারীদের বেতন পরিশোধ ও বিশেষায়িত ব্যাংকিং সুবিধা দিতে প্রাইম ব্যাংক পিএলসির সঙ্গে একটি চুক্তি স্বাক্ষরিত হয়েছে। এ চুক্তির ফলে প্রতিষ্ঠানটির কর্মীরা প্রাইম ব্যাংকের বিভিন্ন পেরোল ব্যাংকিং সেবা ও বিশেষ সুবিধা পাবেন। সম্প্রতি রাজধানীর গুলশানে প্রাইম ব্যাংকের করপোরেট&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982359/%e0%a6%ac%e0%a6%bf%e0%a6%a1%e0%a6%bf-%e0%a6%95%e0%a7%8d%e0%a6%b0%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%b6%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a7%80%e0%a6%a6%e0%a7%87/">অর্থসূচক</source>
    </item>
    <item>
      <title>আল-আরাফাহ্ ইসলামী ব্যাংকের ঢাকা নর্থ জোনের টাউন হল মিটিং অনুষ্ঠিত</title>
      <link>https://www.arthosuchak.com/archives/982361/%e0%a6%86%e0%a6%b2-%e0%a6%86%e0%a6%b0%e0%a6%be%e0%a6%ab%e0%a6%be%e0%a6%b9%e0%a7%8d-%e0%a6%87%e0%a6%b8%e0%a6%b2%e0%a6%be%e0%a6%ae%e0%a7%80-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95-71/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982361/%e0%a6%86%e0%a6%b2-%e0%a6%86%e0%a6%b0%e0%a6%be%e0%a6%ab%e0%a6%be%e0%a6%b9%e0%a7%8d-%e0%a6%87%e0%a6%b8%e0%a6%b2%e0%a6%be%e0%a6%ae%e0%a7%80-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95-71/</guid>
      <pubDate>Sun, 15 Nov 2026 06:51:06 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/PR-AIBL-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/PR-AIBL-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/PR-AIBL-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আল-আরাফাহ্ ইসলামী ব্যাংকের ঢাকা নর্থ জোনের টাউন হল মিটিং অনুষ্ঠিত" /&gt;&lt;/p&gt;&lt;p&gt;আল-আরাফাহ্ ইসলামী ব্যাংক পিএলসির ঢাকা নর্থ জোনের দিনব্যাপী ‘টাউন হল মিটিং’ অনুষ্ঠিত হয়েছে। ১৪ নভেম্বর ২০২৬, শনিবার রাজধানীর রিজেন্সি হোটেল অ্যান্ড রিসোর্টের হলরুমে এ সভা অনুষ্ঠিত হয়। ব্যাংকের ব্যবস্থাপনা পরিচালক মো. রাফাত উল্লা খানের সভাপতিত্বে অনুষ্ঠানে বিশেষ অতিথি হিসেবে বক্তব্য দেন ব্যাংকের চেয়ার&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982361/%e0%a6%86%e0%a6%b2-%e0%a6%86%e0%a6%b0%e0%a6%be%e0%a6%ab%e0%a6%be%e0%a6%b9%e0%a7%8d-%e0%a6%87%e0%a6%b8%e0%a6%b2%e0%a6%be%e0%a6%ae%e0%a7%80-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95-71/">অর্থসূচক</source>
    </item>
    <item>
      <title>এনভিডিয়ার শেয়ারে চাপ, কমেছে নাসডাক ও এসঅ্যান্ডপি ৫০০</title>
      <link>https://www.arthosuchak.com/archives/982366/%e0%a6%8f%e0%a6%a8%e0%a6%ad%e0%a6%bf%e0%a6%a1%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0-%e0%a6%b6%e0%a7%87%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0%e0%a7%87-%e0%a6%9a%e0%a6%be%e0%a6%aa-%e0%a6%95/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982366/%e0%a6%8f%e0%a6%a8%e0%a6%ad%e0%a6%bf%e0%a6%a1%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0-%e0%a6%b6%e0%a7%87%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0%e0%a7%87-%e0%a6%9a%e0%a6%be%e0%a6%aa-%e0%a6%95/</guid>
      <pubDate>Sun, 15 Nov 2026 06:24:49 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/US-Stock-News-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/US-Stock-News-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/US-Stock-News-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এনভিডিয়ার শেয়ারে চাপ, কমেছে নাসডাক ও এসঅ্যান্ডপি ৫০০" /&gt;&lt;/p&gt;&lt;p&gt;এনভিডিয়ার শেয়ারে টানা দরপতনের প্রভাবে সপ্তাহের শেষ কার্যদিবসে নিম্নমুখী ছিল যুক্তরাষ্ট্রের প্রধান দুই পুঁজিবাজার সূচক নাসডাক ও এসঅ্যান্ডপি ৫০০। তবে দিনের এই পতন সত্ত্বেও পুরো সপ্তাহে তিনটি প্রধান সূচকেই উল্লেখযোগ্য উত্থান হয়েছে। আগস্টের শুরুর পর এটিই ছিল সূচকগুলোর সেরা সাপ্তাহিক পারফরম্যান্স। শুক্রব&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982366/%e0%a6%8f%e0%a6%a8%e0%a6%ad%e0%a6%bf%e0%a6%a1%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0-%e0%a6%b6%e0%a7%87%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0%e0%a7%87-%e0%a6%9a%e0%a6%be%e0%a6%aa-%e0%a6%95/">অর্থসূচক</source>
    </item>
    <item>
      <title>সূচকের উত্থানে চলছে লেনদেন</title>
      <link>https://www.arthosuchak.com/archives/982356/%e0%a6%b8%e0%a7%82%e0%a6%9a%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%89%e0%a6%a4%e0%a7%8d%e0%a6%a5%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%9a%e0%a6%b2%e0%a6%9b%e0%a7%87-%e0%a6%b2%e0%a7%87%e0%a6%a8%e0%a6%a6-241/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982356/%e0%a6%b8%e0%a7%82%e0%a6%9a%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%89%e0%a6%a4%e0%a7%8d%e0%a6%a5%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%9a%e0%a6%b2%e0%a6%9b%e0%a7%87-%e0%a6%b2%e0%a7%87%e0%a6%a8%e0%a6%a6-241/</guid>
      <pubDate>Sun, 15 Nov 2026 05:43:09 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/MU-15-11-113826-300x181.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/MU-15-11-113826-300x181.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/MU-15-11-113826-300x181.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সূচকের উত্থানে চলছে লেনদেন" /&gt;&lt;/p&gt;&lt;p&gt;সপ্তাহের প্রথম কার্যদিবস রোববার (১৫ নভেম্বর) দেশের প্রধান পুঁজিবাজার ঢাকা স্টক এক্সচেঞ্জে (ডিএসই) সূচকের উত্থানে লেনদেন চলছে। এদিন বেলা ১১টা ৩৮ মিনিটে প্রধান সূচক ডিএসইএক্স ১৫ পয়েন্ট বেড়েছে। একই সময়ে অন্য দুই সূচকও ঊর্ধ্বমুখী রয়েছে। ডিএসইর বাজার চিত্র অনুযায়ী, বেলা ১১টা ৩৮ মিনিটে ডিএসইএক্স সূচক ১৫ দ&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982356/%e0%a6%b8%e0%a7%82%e0%a6%9a%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%89%e0%a6%a4%e0%a7%8d%e0%a6%a5%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%9a%e0%a6%b2%e0%a6%9b%e0%a7%87-%e0%a6%b2%e0%a7%87%e0%a6%a8%e0%a6%a6-241/">অর্থসূচক</source>
    </item>

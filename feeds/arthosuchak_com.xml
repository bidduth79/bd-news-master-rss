      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Ific-300x164.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আইএফআইসি ব্যাংক ও ড্রিম স্কয়ার রিসোর্টের মধ্যে সমঝোতা স্বারক সই" /&gt;&lt;/p&gt;&lt;p&gt;আইএফআইসি ব্যাংক পিএলসি ও ড্রিম স্কয়ার রিসোর্ট এর মধ্যে একটি সমঝোতা স্মারক (MoU) স্বাক্ষরিত হয়েছে। বুধবার (২৫ নভেম্বর) ঢাকার আইএফআইসি টাওয়ারে আয়োজিত এক অনুষ্ঠানে উভয় প্রতিষ্ঠানের ঊর্ধ্বতন কর্মকর্তাদের উপস্থিতিতে সমঝোতা স্মারকটি স্বাক্ষরিত হয়। আইএফআইসি ব্যাংকের এএমডি ও চিফ অব ব্রাঞ্চ বিজনেস ইমরান আহমে&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/984150/%e0%a6%86%e0%a6%87%e0%a6%8f%e0%a6%ab%e0%a6%86%e0%a6%87%e0%a6%b8%e0%a6%bf-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95-%e0%a6%93-%e0%a6%a1%e0%a7%8d%e0%a6%b0%e0%a6%bf%e0%a6%ae-%e0%a6%b8/">অর্থসূচক</source>
    </item>
    <item>
      <title>দক্ষিণ আফ্রিকাকে আবাসিক মিশন খোলার আহ্বান বাংলাদেশের</title>
      <link>https://www.arthosuchak.com/archives/984147/%e0%a6%a6%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%bf%e0%a6%a3-%e0%a6%86%e0%a6%ab%e0%a7%8d%e0%a6%b0%e0%a6%bf%e0%a6%95%e0%a6%be%e0%a6%95%e0%a7%87-%e0%a6%86%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%95/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/984147/%e0%a6%a6%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%bf%e0%a6%a3-%e0%a6%86%e0%a6%ab%e0%a7%8d%e0%a6%b0%e0%a6%bf%e0%a6%95%e0%a6%be%e0%a6%95%e0%a7%87-%e0%a6%86%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%95/</guid>
      <pubDate>Wed, 25 Nov 2026 15:36:07 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Bd-South-300x164.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Bd-South-300x164.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Bd-South-300x164.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দক্ষিণ আফ্রিকাকে আবাসিক মিশন খোলার আহ্বান বাংলাদেশের" /&gt;&lt;/p&gt;&lt;p&gt;দক্ষিণ আফ্রিকাকে ঢাকায় একটি আবাসিক মিশন খোলার বিষয়টি বিবেচনা করার আহ্বান জানিয়েছেন পররাষ্ট্র প্রতিমন্ত্রী হুমায়ুন কবির। এর উদ্দেশ্য হলো রাজনৈতিক সম্পৃক্ততা জোরদার করা, দ্বিপাক্ষিক বাণিজ্য সম্প্রসারণ করা এবং কনস্যুলার সেবাকে আরও সহজতর করা। পররাষ্ট্র মন্ত্রণালয়ের এক সংবাদ বিজ্ঞপ্তিতে জানানো হয়েছে, বাং&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/984147/%e0%a6%a6%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%bf%e0%a6%a3-%e0%a6%86%e0%a6%ab%e0%a7%8d%e0%a6%b0%e0%a6%bf%e0%a6%95%e0%a6%be%e0%a6%95%e0%a7%87-%e0%a6%86%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%95/">অর্থসূচক</source>
    </item>
    <item>
      <title>শেখ হাসিনার বাংলাদেশে যেতে চাওয়া প্রত্যপর্ণ চুক্তির বাইরের বিষয়: জয়সওয়াল</title>
      <link>https://www.arthosuchak.com/archives/984145/%e0%a6%b6%e0%a7%87%e0%a6%96-%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%a8%e0%a6%be%e0%a6%b0-%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%87-%e0%a6%af%e0%a7%87/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/984145/%e0%a6%b6%e0%a7%87%e0%a6%96-%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%a8%e0%a6%be%e0%a6%b0-%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%87-%e0%a6%af%e0%a7%87/</guid>
      <pubDate>Wed, 25 Nov 2026 15:20:03 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2025/04/jaiswal-20250418124528-1-300x150.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2025/04/jaiswal-20250418124528-1-300x150.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2025/04/jaiswal-20250418124528-1-300x150.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শেখ হাসিনার বাংলাদেশে যেতে চাওয়া প্রত্যপর্ণ চুক্তির বাইরের বিষয়: জয়সওয়াল" /&gt;&lt;/p&gt;&lt;p&gt;ক্ষমতাচ্যুত সাবেক প্রধানমন্ত্রী শেখ হাসিনার বাংলাদেশে ফিরতে চাওয়ার বিষয়ে ভারতের পররাষ্ট্র মন্ত্রণালয়ের মুখপাত্র রণধীর জয়সওয়াল বলেছেন, শেখ হাসিনার বাংলাদেশে যাওয়ার বিষয়টি তার ও বাংলাদেশ সরকারের বিষয়। এ ছাড়া শেখ হাসিনার বাংলাদেশে যেতে চাওয়ার বিষয়টি প্রত্যপর্ণ চুক্তির বাইরের বিষয় বলেও মন্তব্য করেন তিনি&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/984145/%e0%a6%b6%e0%a7%87%e0%a6%96-%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%a8%e0%a6%be%e0%a6%b0-%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%87-%e0%a6%af%e0%a7%87/">অর্থসূচক</source>
    </item>
    <item>
      <title>মহিলালীগ নেত্রীকে বাংলোয় ডাকা ওসি প্রত্যাহার</title>
      <link>https://www.arthosuchak.com/archives/984142/%e0%a6%ae%e0%a6%b9%e0%a6%bf%e0%a6%b2%e0%a6%be%e0%a6%b2%e0%a7%80%e0%a6%97-%e0%a6%a8%e0%a7%87%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a7%80%e0%a6%95%e0%a7%87-%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a7%8b%e0%a6%af/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/984142/%e0%a6%ae%e0%a6%b9%e0%a6%bf%e0%a6%b2%e0%a6%be%e0%a6%b2%e0%a7%80%e0%a6%97-%e0%a6%a8%e0%a7%87%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a7%80%e0%a6%95%e0%a7%87-%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a7%8b%e0%a6%af/</guid>
      <pubDate>Wed, 25 Nov 2026 14:51:47 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/OC-Mossar-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/OC-Mossar-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/OC-Mossar-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মহিলালীগ নেত্রীকে বাংলোয় ডাকা ওসি প্রত্যাহার" /&gt;&lt;/p&gt;&lt;p&gt;পৌর যুব মহিলা লীগের সভাপতি তাসকিরা তান্নিন সনির সঙ্গে কথোপকথনের একটি অডিও সামাজিক যোগাযোগমাধ্যমে ছড়িয়ে পড়ার পর ফেনীর দাগনভূঞা থানার ওসি মোহাম্মদ ফয়জুল আজীম নোমানকে প্রত্যাহার করে পুলিশ লাইন্সে সংযুক্ত করা হয়েছে। বুধবার (২৫ নভেম্বর) ফেনীর অতিরিক্ত পুলিশ সুপার (অপরাধ) সাইফুল ইসলাম বিষয়টি নিশ্চিত করেছে&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/984142/%e0%a6%ae%e0%a6%b9%e0%a6%bf%e0%a6%b2%e0%a6%be%e0%a6%b2%e0%a7%80%e0%a6%97-%e0%a6%a8%e0%a7%87%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a7%80%e0%a6%95%e0%a7%87-%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a7%8b%e0%a6%af/">অর্থসূচক</source>
    </item>
    <item>
      <title>বাংলাদেশসহ বিভিন্ন দেশের ওপর নতুন শুল্ক আরোপ যুক্তরাষ্ট্রের</title>
      <link>https://www.arthosuchak.com/archives/984140/%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a6%b8%e0%a6%b9-%e0%a6%ac%e0%a6%bf%e0%a6%ad%e0%a6%bf%e0%a6%a8%e0%a7%8d%e0%a6%a8-%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%87%e0%a6%b0/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/984140/%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a6%b8%e0%a6%b9-%e0%a6%ac%e0%a6%bf%e0%a6%ad%e0%a6%bf%e0%a6%a8%e0%a7%8d%e0%a6%a8-%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%87%e0%a6%b0/</guid>
      <pubDate>Wed, 25 Nov 2026 14:27:22 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2025/03/Trump-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2025/03/Trump-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2025/03/Trump-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাংলাদেশসহ বিভিন্ন দেশের ওপর নতুন শুল্ক আরোপ যুক্তরাষ্ট্রের" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ, ইউরোপীয় ইউনিয়নসহ বিভিন্ন দেশের ওপর নতুন করে বিভিন্ন মাত্রার শুল্ক আরোপের ঘোষণা দিয়েছে যুক্তরাষ্ট্র। নিজেদের অন্যতম প্রধান কয়েকটি বাণিজ্যিক অংশীদারের ম্যানুফ্যাকচারিং বা উৎপাদন খাতে কাঠামোগত অতিরিক্ত সক্ষমতা ও উৎপাদন নিয়ে ‘সেকশন ৩০১’ তদন্তের পর এই শুল্ক আরোপ করা হচ্ছে। এর আওতায় থাকা দেশগুলে&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/984140/%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a6%b8%e0%a6%b9-%e0%a6%ac%e0%a6%bf%e0%a6%ad%e0%a6%bf%e0%a6%a8%e0%a7%8d%e0%a6%a8-%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%87%e0%a6%b0/">অর্থসূচক</source>

    <item>
      <title>এনার্জিপ্যাকের লভ্যাংশ ঘোষণা</title>
      <link>https://www.arthosuchak.com/archives/981250/%e0%a6%8f%e0%a6%a8%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%9c%e0%a6%bf%e0%a6%aa%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%b2%e0%a6%ad%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%b6-4/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981250/%e0%a6%8f%e0%a6%a8%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%9c%e0%a6%bf%e0%a6%aa%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%b2%e0%a6%ad%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%b6-4/</guid>
      <pubDate>Sun, 08 Nov 2026 14:05:54 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2024/04/Energypac-PLC-Arthosuchak-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2024/04/Energypac-PLC-Arthosuchak-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2024/04/Energypac-PLC-Arthosuchak-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এনার্জিপ্যাকের লভ্যাংশ ঘোষণা" /&gt;&lt;/p&gt;&lt;p&gt;পুঁজিবাজারের তালিকাভুক্ত কোম্পানি এনার্জিপ্যাক পাওয়ার জেনারেশন পিএলসি গত ৩০ জুন, ২০২৬ তারিখে সমাপ্ত হিসাববছরের জন্য লভ্যাংশ ঘোষণা করেছে। কোম্পানিটি আলোচিত বছরের জন্য সাধারণ শেয়ারহোল্ডারদের ১ শতাংশ নগদ লভ্যাংশ দেবে। রোববার (৮ নভেম্বর) অনুষ্ঠিত কোম্পানিটির পরিচালনা পর্ষদের বৈঠকে সর্বশেষ হিসাববছরের নির&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981250/%e0%a6%8f%e0%a6%a8%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%9c%e0%a6%bf%e0%a6%aa%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%b2%e0%a6%ad%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%b6-4/">অর্থসূচক</source>
    </item>
    <item>
      <title>ঢাবিতে ককটেল বিস্ফোরণ, আটক ৩</title>

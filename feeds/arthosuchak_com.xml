      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/NCC-Bank-300x150.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/NCC-Bank-300x150.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/NCC-Bank-300x150.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টেক্সপ্রো ইকো অ্যাপারেলের সঙ্গে এনসিসি ব্যাংকের পেরোল চুক্তি" /&gt;&lt;/p&gt;&lt;p&gt;কর্মীদের জন্য বিশেষায়িত ব্যাংকিং সুবিধা নিশ্চিত করতে তৈরি পোশাক প্রস্তুতকারক প্রতিষ্ঠান টেক্সপ্রো ইকো অ্যাপারেল লিমিটেডের সঙ্গে পেরোল ব্যাংকিং চুক্তি করেছে এনসিসি ব্যাংক পিএলসি। সম্প্রতি ঢাকার মতিঝিলে এনসিসি ব্যাংকের প্রধান কার্যালয়ে দুই প্রতিষ্ঠানের মধ্যে এ চুক্তি স্বাক্ষরিত হয়। নিজ নিজ প্রতিষ্ঠানে&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983297/%e0%a6%9f%e0%a7%87%e0%a6%95%e0%a7%8d%e0%a6%b8%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a7%8b-%e0%a6%87%e0%a6%95%e0%a7%8b-%e0%a6%85%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%aa%e0%a6%be%e0%a6%b0%e0%a7%87%e0%a6%b2%e0%a7%87/">অর্থসূচক</source>

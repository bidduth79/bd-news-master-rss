    <item>
      <title>শান্তি আলোচনার পরিধি বাড়াতে সম্মত রাশিয়া-ইউক্রেন, যুক্ত হবে ইউরোপ</title>
      <link>https://www.arthosuchak.com/archives/982157/%e0%a6%b6%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a6%bf-%e0%a6%86%e0%a6%b2%e0%a7%8b%e0%a6%9a%e0%a6%a8%e0%a6%be%e0%a6%b0-%e0%a6%aa%e0%a6%b0%e0%a6%bf%e0%a6%a7%e0%a6%bf-%e0%a6%ac%e0%a6%be%e0%a6%a1/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982157/%e0%a6%b6%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a6%bf-%e0%a6%86%e0%a6%b2%e0%a7%8b%e0%a6%9a%e0%a6%a8%e0%a6%be%e0%a6%b0-%e0%a6%aa%e0%a6%b0%e0%a6%bf%e0%a6%a7%e0%a6%bf-%e0%a6%ac%e0%a6%be%e0%a6%a1/</guid>
      <pubDate>Fri, 13 Nov 2026 13:48:12 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2025/08/PutinZelensky-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2025/08/PutinZelensky-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2025/08/PutinZelensky-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শান্তি আলোচনার পরিধি বাড়াতে সম্মত রাশিয়া-ইউক্রেন, যুক্ত হবে ইউরোপ" /&gt;&lt;/p&gt;&lt;p&gt;রাশিয়া ও ইউক্রেনের মধ্যে চলমান শান্তি আলোচনার পরিধি বাড়াতে সম্মত হয়েছে দুই পক্ষ। পরবর্তী দফার আলোচনায় ইউরোপের প্রতিনিধিরাও যুক্ত হবেন। যুক্তরাষ্ট্রের প্রেসিডেন্ট ডোনাল্ড ট্রাম্পের বিশেষ দূত স্টিভ উইটকফ এবং জামাতা জ্যারেড কুশনারের সঙ্গে বৈঠকের পর এ কথা জানিয়েছেন ইউক্রেনের প্রেসিডেন্ট ভলোদিমির জেলেনস্&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982157/%e0%a6%b6%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a6%bf-%e0%a6%86%e0%a6%b2%e0%a7%8b%e0%a6%9a%e0%a6%a8%e0%a6%be%e0%a6%b0-%e0%a6%aa%e0%a6%b0%e0%a6%bf%e0%a6%a7%e0%a6%bf-%e0%a6%ac%e0%a6%be%e0%a6%a1/">অর্থসূচক</source>
    </item>
    <item>
      <title>প্রশাসন ডিসেম্বরের অপেক্ষায়  কি না, জানতে চাইলেন মন্ত্রিপরিষদ সচিব</title>
      <link>https://www.arthosuchak.com/archives/982155/%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%b6%e0%a6%be%e0%a6%b8%e0%a6%a8-%e0%a6%a1%e0%a6%bf%e0%a6%b8%e0%a7%87%e0%a6%ae%e0%a7%8d%e0%a6%ac%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%85%e0%a6%aa%e0%a7%87%e0%a6%95%e0%a7%8d/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982155/%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%b6%e0%a6%be%e0%a6%b8%e0%a6%a8-%e0%a6%a1%e0%a6%bf%e0%a6%b8%e0%a7%87%e0%a6%ae%e0%a7%8d%e0%a6%ac%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%85%e0%a6%aa%e0%a7%87%e0%a6%95%e0%a7%8d/</guid>
      <pubDate>Fri, 13 Nov 2026 12:44:22 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Ministry-Secretary-Nasimul-Gani-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Ministry-Secretary-Nasimul-Gani-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Ministry-Secretary-Nasimul-Gani-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রশাসন ডিসেম্বরের অপেক্ষায়  কি না, জানতে চাইলেন মন্ত্রিপরিষদ সচিব" /&gt;&lt;/p&gt;&lt;p&gt;প্রশাসনের কোনো পর্যায়ে ডিসেম্বরের অপেক্ষায় থেকে কাজে ধীরগতি দেখানো হচ্ছে কি না, তা নিয়ে সচিবদের কাছে প্রশ্ন তুলেছেন মন্ত্রিপরিষদ সচিব নাসিমুল গনি। একই সঙ্গে প্রশাসনিক কাজে গতি বাড়াতে বিভিন্ন মন্ত্রণালয় ও বিভাগের সচিবদের কঠোর নির্দেশনা দিয়েছেন তিনি। বৃহস্পতিবার (১২ নভেম্বর) সচিবালয়ে অনুষ্ঠিত এক জরুরি&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982155/%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%b6%e0%a6%be%e0%a6%b8%e0%a6%a8-%e0%a6%a1%e0%a6%bf%e0%a6%b8%e0%a7%87%e0%a6%ae%e0%a7%8d%e0%a6%ac%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%85%e0%a6%aa%e0%a7%87%e0%a6%95%e0%a7%8d/">অর্থসূচক</source>
    </item>
    <item>
      <title>ডিসেম্বরে সুদের হার বাড়ানোর প্রত্যাশায় ঊর্ধ্বমুখী যুক্তরাষ্ট্রের ট্রেজারি বন্ডের ইল্ড</title>
      <link>https://www.arthosuchak.com/archives/982153/%e0%a6%a1%e0%a6%bf%e0%a6%b8%e0%a7%87%e0%a6%ae%e0%a7%8d%e0%a6%ac%e0%a6%b0%e0%a7%87-%e0%a6%b8%e0%a7%81%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%b9%e0%a6%be%e0%a6%b0-%e0%a6%ac%e0%a6%be%e0%a6%a1%e0%a6%bc/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982153/%e0%a6%a1%e0%a6%bf%e0%a6%b8%e0%a7%87%e0%a6%ae%e0%a7%8d%e0%a6%ac%e0%a6%b0%e0%a7%87-%e0%a6%b8%e0%a7%81%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%b9%e0%a6%be%e0%a6%b0-%e0%a6%ac%e0%a6%be%e0%a6%a1%e0%a6%bc/</guid>
      <pubDate>Fri, 13 Nov 2026 11:49:47 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/World-Stock-MArket-News-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/World-Stock-MArket-News-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/World-Stock-MArket-News-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডিসেম্বরে সুদের হার বাড়ানোর প্রত্যাশায় ঊর্ধ্বমুখী যুক্তরাষ্ট্রের ট্রেজারি বন্ডের ইল্ড" /&gt;&lt;/p&gt;&lt;p&gt;ডিসেম্বরে সুদের হার বাড়াতে পারে যুক্তরাষ্ট্রের কেন্দ্রীয় ব্যাংক ফেডারেল রিজার্ভ—বিনিয়োগকারীদের এমন প্রত্যাশায় দেশটির ট্রেজারি বন্ডের ইল্ড বেড়েছে। শুক্রবার (১৩ নভেম্বর) লেনদেনের শুরুতে ১০ বছর মেয়াদি ট্রেজারি বন্ডের ইল্ড ২ বেসিস পয়েন্ট বেড়ে ৫ দশমিক ১২৭১ শতাংশে দাঁড়িয়েছে। একই সময়ে ৩০ বছর মেয়াদি ট্রেজার&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982153/%e0%a6%a1%e0%a6%bf%e0%a6%b8%e0%a7%87%e0%a6%ae%e0%a7%8d%e0%a6%ac%e0%a6%b0%e0%a7%87-%e0%a6%b8%e0%a7%81%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%b9%e0%a6%be%e0%a6%b0-%e0%a6%ac%e0%a6%be%e0%a6%a1%e0%a6%bc/">অর্থসূচক</source>
    </item>
    <item>
      <title>বাংলাদেশ অটোকারসের প্রথম প্রান্তিক প্রকাশ</title>
      <link>https://www.arthosuchak.com/archives/981949/%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%a6%e0%a7%87%e0%a6%b6-%e0%a6%85%e0%a6%9f%e0%a7%8b%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%b8%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a5%e0%a6%ae/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981949/%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%a6%e0%a7%87%e0%a6%b6-%e0%a6%85%e0%a6%9f%e0%a7%8b%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%b8%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a5%e0%a6%ae/</guid>
      <pubDate>Fri, 13 Nov 2026 11:47:47 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2023/01/bangladesh-autocars-300x150.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2023/01/bangladesh-autocars-300x150.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2023/01/bangladesh-autocars-300x150.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাংলাদেশ অটোকারসের প্রথম প্রান্তিক প্রকাশ" /&gt;&lt;/p&gt;&lt;p&gt;পুঁজিবাজারে তালিকাভুক্ত কোম্পানি বাংলাদেশ অটোকারস গত ৩০ সেপ্টেম্বর, ২০২৬ তারিখে সমাপ্ত প্রথম প্রান্তিকের (জুলাই’২৬-সেপ্টেম্বর’২৬) অনিরীক্ষিত আর্থিক প্রতিবেদন প্রকাশ করেছে। বৃহস্পতিবার (১২ নভেম্বর) অনুষ্ঠিত কোম্পানির পরিচালনা পর্ষদের বৈঠকে চলতি হিসাববছরের প্রথম প্রান্তিকের আর্থিক প্রতিবেদন পর্যালোচনা&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981949/%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%a6%e0%a7%87%e0%a6%b6-%e0%a6%85%e0%a6%9f%e0%a7%8b%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%b8%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a5%e0%a6%ae/">অর্থসূচক</source>
    </item>

    <item>
      <title>মহিলালীগ নেত্রীকে বাংলোয় ডাকা ওসি প্রত্যাহার</title>
      <link>https://www.arthosuchak.com/archives/984142/%e0%a6%ae%e0%a6%b9%e0%a6%bf%e0%a6%b2%e0%a6%be%e0%a6%b2%e0%a7%80%e0%a6%97-%e0%a6%a8%e0%a7%87%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a7%80%e0%a6%95%e0%a7%87-%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a7%8b%e0%a6%af/</link>

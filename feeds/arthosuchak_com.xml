    <item>
      <title>মার্কিন রাডার সিস্টেমে ইরানের ড্রোন হামলা</title>
      <link>https://www.arthosuchak.com/archives/982810/%e0%a6%ae%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%95%e0%a6%bf%e0%a6%a8-%e0%a6%b0%e0%a6%be%e0%a6%a1%e0%a6%be%e0%a6%b0-%e0%a6%b8%e0%a6%bf%e0%a6%b8%e0%a7%8d%e0%a6%9f%e0%a7%87%e0%a6%ae%e0%a7%87-%e0%a6%87/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982810/%e0%a6%ae%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%95%e0%a6%bf%e0%a6%a8-%e0%a6%b0%e0%a6%be%e0%a6%a1%e0%a6%be%e0%a6%b0-%e0%a6%b8%e0%a6%bf%e0%a6%b8%e0%a7%8d%e0%a6%9f%e0%a7%87%e0%a6%ae%e0%a7%87-%e0%a6%87/</guid>
      <pubDate>Tue, 17 Nov 2026 12:08:13 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Iran-drone-2026-300x150.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Iran-drone-2026-300x150.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Iran-drone-2026-300x150.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মার্কিন রাডার সিস্টেমে ইরানের ড্রোন হামলা" /&gt;&lt;/p&gt;&lt;p&gt;বাহরাইনের শেখ ঈসা বিমানঘাঁটিতে স্থাপিত মার্কিন রাডার সিস্টেম লক্ষ্য করে ড্রোন হামলা চালানোর দাবি করেছে ইরানের ইসলামিক রেভল্যুশনারি গার্ড কর্পস (আইআরজিসি)। মঙ্গলবার (১৭ নভেম্বর) এ হামলা চালানো হয়েছে বলে দাবি করেছে সংস্থাটি। ইরানের রাষ্ট্রীয় সম্প্রচারমাধ্যম আইআরআইবিতে প্রচারিত এক বিবৃতিতে আইআরজিসি জান&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982810/%e0%a6%ae%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%95%e0%a6%bf%e0%a6%a8-%e0%a6%b0%e0%a6%be%e0%a6%a1%e0%a6%be%e0%a6%b0-%e0%a6%b8%e0%a6%bf%e0%a6%b8%e0%a7%8d%e0%a6%9f%e0%a7%87%e0%a6%ae%e0%a7%87-%e0%a6%87/">অর্থসূচক</source>
    </item>
    <item>

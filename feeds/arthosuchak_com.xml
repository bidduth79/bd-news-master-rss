      <pubDate>Fri, 27 Nov 2026 04:47:42 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2024/11/Gold-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2024/11/Gold-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2024/11/Gold-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সোনার দামে ফের ঊর্ধ্বগতি, ২ লাখের কাছাকাছি ভরি" /&gt;&lt;/p&gt;&lt;p&gt;দেশের বাজারে সোনার গহনার দাম আবারও বাড়িয়েছে বাংলাদেশ জুয়েলার্স অ্যাসোসিয়েশন (বাজুস)। এবার সবচেয়ে ভালো মানের বা ২২ ক্যারেটের প্রতি ভরি (১১ দশমিক ৬৬৪ গ্রাম) সোনার গহনার দাম ১ হাজার ৫০ টাকা বাড়ানো হয়েছে। এতে ভ্যাটসহ ২২ ক্যারেটের এক ভরি সোনার গহনার নতুন দাম দাঁড়িয়েছে ১ লাখ ৯৮ হাজার ৯৩০ টাকা, যা ২ লাখ ট&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/984332/%e0%a6%b8%e0%a7%8b%e0%a6%a8%e0%a6%be%e0%a6%b0-%e0%a6%a6%e0%a6%be%e0%a6%ae%e0%a7%87-%e0%a6%ab%e0%a7%87%e0%a6%b0-%e0%a6%8a%e0%a6%b0%e0%a7%8d%e0%a6%a7%e0%a7%8d%e0%a6%ac%e0%a6%97%e0%a6%a4%e0%a6%bf/">অর্থসূচক</source>
    </item>
    <item>
      <title>রূপপুর পারমাণবিক বিদ্যুৎকেন্দ্রের শেষ ইউরেনিয়ামের চালান পৌঁছাল, জ্বালানি আমদানি সম্পন্ন</title>
      <link>https://www.arthosuchak.com/archives/984330/%e0%a6%b0%e0%a7%82%e0%a6%aa%e0%a6%aa%e0%a7%81%e0%a6%b0-%e0%a6%aa%e0%a6%be%e0%a6%b0%e0%a6%ae%e0%a6%be%e0%a6%a3%e0%a6%ac%e0%a6%bf%e0%a6%95-%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a7%81-8/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/984330/%e0%a6%b0%e0%a7%82%e0%a6%aa%e0%a6%aa%e0%a7%81%e0%a6%b0-%e0%a6%aa%e0%a6%be%e0%a6%b0%e0%a6%ae%e0%a6%be%e0%a6%a3%e0%a6%ac%e0%a6%bf%e0%a6%95-%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a7%81-8/</guid>
      <pubDate>Fri, 27 Nov 2026 03:52:30 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/10/Ruppur-NPP-Fuel-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/10/Ruppur-NPP-Fuel-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/10/Ruppur-NPP-Fuel-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রূপপুর পারমাণবিক বিদ্যুৎকেন্দ্রের শেষ ইউরেনিয়ামের চালান পৌঁছাল, জ্বালানি আমদানি সম্পন্ন" /&gt;&lt;/p&gt;&lt;p&gt;দেশের প্রথম পারমাণবিক বিদ্যুৎকেন্দ্র রূপপুরের জন্য রাশিয়া থেকে আমদানি করা পারমাণবিক জ্বালানির নবম ও শেষ চালান প্রকল্প এলাকায় পৌঁছেছে। এর মধ্য দিয়ে কেন্দ্রটির দুটি ইউনিটের জন্য নির্ধারিত নয়টি চালানে পারমাণবিক জ্বালানি আমদানির পুরো প্রক্রিয়া সম্পন্ন হলো। শুক্রবার (২৭ নভেম্বর) ভোর ৫টা ৪৮ মিনিটে সেনাবাহ&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/984330/%e0%a6%b0%e0%a7%82%e0%a6%aa%e0%a6%aa%e0%a7%81%e0%a6%b0-%e0%a6%aa%e0%a6%be%e0%a6%b0%e0%a6%ae%e0%a6%be%e0%a6%a3%e0%a6%ac%e0%a6%bf%e0%a6%95-%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a7%81-8/">অর্থসূচক</source>
    </item>
    <item>
      <title>জাতীয় প্রাণিসম্পদ পদক ২০২৬ অর্জন করল আকিজ এগ্রো ফিড</title>
      <link>https://www.arthosuchak.com/archives/984297/%e0%a6%9c%e0%a6%be%e0%a6%a4%e0%a7%80%e0%a6%af%e0%a6%bc-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%a3%e0%a6%bf%e0%a6%b8%e0%a6%ae%e0%a7%8d%e0%a6%aa%e0%a6%a6-%e0%a6%aa%e0%a6%a6%e0%a6%95-%e0%a7%a8/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/984297/%e0%a6%9c%e0%a6%be%e0%a6%a4%e0%a7%80%e0%a6%af%e0%a6%bc-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%a3%e0%a6%bf%e0%a6%b8%e0%a6%ae%e0%a7%8d%e0%a6%aa%e0%a6%a6-%e0%a6%aa%e0%a6%a6%e0%a6%95-%e0%a7%a8/</guid>
      <pubDate>Thu, 26 Nov 2026 14:18:37 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Pic_AKIJ-Agro-Feed-wins-National-Livestock-Award-2026-1-300x169.jpeg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Pic_AKIJ-Agro-Feed-wins-National-Livestock-Award-2026-1-300x169.jpeg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Pic_AKIJ-Agro-Feed-wins-National-Livestock-Award-2026-1-300x169.jpeg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জাতীয় প্রাণিসম্পদ পদক ২০২৬ অর্জন করল আকিজ এগ্রো ফিড" /&gt;&lt;/p&gt;&lt;p&gt;জাতীয় পর্যায়ে প্রাণিসম্পদ খাতে অবদানের স্বীকৃতিস্বরূপ ‘জাতীয় প্রাণিসম্পদ পদক ২০২৬’ অর্জন করেছে আকিজ এগ্রো ফিড লিমিটেড। দেশের প্রাণিসম্পদ খাতের উন্নয়ন, মানসম্মত প্রাণিখাদ্য উৎপাদন, প্রক্রিয়াজাতকরণ ও বাজারজাতকরণে গুরুত্বপূর্ণ অবদানের স্বীকৃতিস্বরূপ রৌপ্য পদক অর্জন করল দেশের অন্যতম শীর্ষস্থানীয় শিল্পগ্&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/984297/%e0%a6%9c%e0%a6%be%e0%a6%a4%e0%a7%80%e0%a6%af%e0%a6%bc-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%a3%e0%a6%bf%e0%a6%b8%e0%a6%ae%e0%a7%8d%e0%a6%aa%e0%a6%a6-%e0%a6%aa%e0%a6%a6%e0%a6%95-%e0%a7%a8/">অর্থসূচক</source>
    </item>
    <item>
      <title>ডিসেম্বরকে ‘ঋণ অনুসন্ধান মাস’ ঘোষণা সোনালী ব্যাংকের</title>
      <link>https://www.arthosuchak.com/archives/984303/%e0%a6%a1%e0%a6%bf%e0%a6%b8%e0%a7%87%e0%a6%ae%e0%a7%8d%e0%a6%ac%e0%a6%b0%e0%a6%95%e0%a7%87-%e0%a6%8b%e0%a6%a3-%e0%a6%85%e0%a6%a8%e0%a7%81%e0%a6%b8%e0%a6%a8%e0%a7%8d%e0%a6%a7%e0%a6%be%e0%a6%a8/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/984303/%e0%a6%a1%e0%a6%bf%e0%a6%b8%e0%a7%87%e0%a6%ae%e0%a7%8d%e0%a6%ac%e0%a6%b0%e0%a6%95%e0%a7%87-%e0%a6%8b%e0%a6%a3-%e0%a6%85%e0%a6%a8%e0%a7%81%e0%a6%b8%e0%a6%a8%e0%a7%8d%e0%a6%a7%e0%a6%be%e0%a6%a8/</guid>

    <item>
      <title>মিনাবের স্কুলে মার্কিন-ইসরায়েলি গণহত্যার কথা কখনোই ভুলব না: প্রেসিডেন্ট মাসুদ</title>
      <link>https://www.arthosuchak.com/archives/984447/%e0%a6%ae%e0%a6%bf%e0%a6%a8%e0%a6%be%e0%a6%ac%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a7%8d%e0%a6%95%e0%a7%81%e0%a6%b2%e0%a7%87-%e0%a6%ae%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%95%e0%a6%bf%e0%a6%a8-%e0%a6%87/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/984447/%e0%a6%ae%e0%a6%bf%e0%a6%a8%e0%a6%be%e0%a6%ac%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a7%8d%e0%a6%95%e0%a7%81%e0%a6%b2%e0%a7%87-%e0%a6%ae%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%95%e0%a6%bf%e0%a6%a8-%e0%a6%87/</guid>
      <pubDate>Sat, 28 Nov 2026 08:55:49 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2024/07/Masud-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2024/07/Masud-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2024/07/Masud-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মিনাবের স্কুলে মার্কিন-ইসরায়েলি গণহত্যার কথা কখনোই ভুলব না: প্রেসিডেন্ট মাসুদ" /&gt;&lt;/p&gt;&lt;p&gt;ইরানের প্রেসিডেন্ট মাসুদ পেজেশকিয়ান মিনাবের স্কুলে ১৬৮ শিশুকে হত্যার জন্য যুক্তরাষ্ট্র ও ইহুদিবাদী ইসরায়েলের প্রতি আবারও তীব্র ঘৃণা প্রকাশ করেছেন। তিনি বলেছেন, এই অপরাধের কথা ইরান কখনো ভুলবে না। ইরনার বরাত দিয়ে পার্সটুডে জানিয়েছে, শুক্রবার রাতে সামাজিক যোগাযোগমাধ্যম এক্সে দেওয়া এক পোস্টে পেজেশকিয়ান &lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/984447/%e0%a6%ae%e0%a6%bf%e0%a6%a8%e0%a6%be%e0%a6%ac%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a7%8d%e0%a6%95%e0%a7%81%e0%a6%b2%e0%a7%87-%e0%a6%ae%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%95%e0%a6%bf%e0%a6%a8-%e0%a6%87/">অর্থসূচক</source>

    <item>
      <title>কাস্টমস ও এনবিআর নিয়ে বিদেশেও প্রশ্নের মুখে পড়তে হয়: অর্থমন্ত্রী</title>
      <link>https://www.arthosuchak.com/archives/984454/%e0%a6%95%e0%a6%be%e0%a6%b8%e0%a7%8d%e0%a6%9f%e0%a6%ae%e0%a6%b8-%e0%a6%93-%e0%a6%8f%e0%a6%a8%e0%a6%ac%e0%a6%bf%e0%a6%86%e0%a6%b0-%e0%a6%a8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%ac%e0%a6%bf/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/984454/%e0%a6%95%e0%a6%be%e0%a6%b8%e0%a7%8d%e0%a6%9f%e0%a6%ae%e0%a6%b8-%e0%a6%93-%e0%a6%8f%e0%a6%a8%e0%a6%ac%e0%a6%bf%e0%a6%86%e0%a6%b0-%e0%a6%a8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%ac%e0%a6%bf/</guid>
      <pubDate>Sat, 28 Nov 2026 09:56:36 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/08/Amir-Khasru-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/08/Amir-Khasru-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/08/Amir-Khasru-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কাস্টমস ও এনবিআর নিয়ে বিদেশেও প্রশ্নের মুখে পড়তে হয়: অর্থমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;দেশে-বিদেশে যেখানেই যাচ্ছেন, সেখানেই কাস্টমস ও জাতীয় রাজস্ব বোর্ড (এনবিআর) নিয়ে কথা শুনতে হচ্ছে বলে জানিয়েছেন অর্থ ও পরিকল্পনামন্ত্রী আমির খসরু মাহমুদ চৌধুরী। তিনি বলেন, জাপান ও কোরিয়াতেও এনবিআর নিয়ে বারবার আলোচনা সামনে আসছে। শনিবার (২৮ নভেম্বর) রাজধানীর মিরপুরে বাংলাদেশ ব্যাংক ট্রেনিং একাডেমিতে দেশ&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/984454/%e0%a6%95%e0%a6%be%e0%a6%b8%e0%a7%8d%e0%a6%9f%e0%a6%ae%e0%a6%b8-%e0%a6%93-%e0%a6%8f%e0%a6%a8%e0%a6%ac%e0%a6%bf%e0%a6%86%e0%a6%b0-%e0%a6%a8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%ac%e0%a6%bf/">অর্থসূচক</source>
    </item>
    <item>
      <title>অস্ট্রেলিয়ার বিপক্ষে নিউজিল্যান্ডের দলে বড় চমক</title>
      <link>https://www.arthosuchak.com/archives/984450/%e0%a6%85%e0%a6%b8%e0%a7%8d%e0%a6%9f%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%b2%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%aa%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a7%87-%e0%a6%a8%e0%a6%bf/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/984450/%e0%a6%85%e0%a6%b8%e0%a7%8d%e0%a6%9f%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%b2%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%aa%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a7%87-%e0%a6%a8%e0%a6%bf/</guid>
      <pubDate>Sat, 28 Nov 2026 09:31:30 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/cricket-newzeland-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/cricket-newzeland-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/cricket-newzeland-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অস্ট্রেলিয়ার বিপক্ষে নিউজিল্যান্ডের দলে বড় চমক" /&gt;&lt;/p&gt;&lt;p&gt;অস্ট্রেলিয়ার বিপক্ষে চার ম্যাচের টেস্ট সিরিজ সামনে রেখে ১৬ সদস্যের দল ঘোষণা করেছে নিউজিল্যান্ড। ঘোষিত দলে বড় চমক হিসেবে ফিরেছেন পেসার উইল ও’রুর্ক। পাশাপাশি দলে জায়গা পেয়েছেন পেসার ম্যাট ফিশার ও মাইকেল রে। শনিবার (২৮ নভেম্বর) আসন্ন অস্ট্রেলিয়া সফরের জন্য দল ঘোষণা করে নিউজিল্যান্ড ক্রিকেট। টম ল্যাথামে&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/984450/%e0%a6%85%e0%a6%b8%e0%a7%8d%e0%a6%9f%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%b2%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%aa%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a7%87-%e0%a6%a8%e0%a6%bf/">অর্থসূচক</source>
    </item>
    <item>
      <title>আমরা ইরান ও ইউক্রেন যুদ্ধের বিরোধিতা করেছি: স্পেনের প্রধানমন্ত্রী</title>
      <link>https://www.arthosuchak.com/archives/984449/%e0%a6%86%e0%a6%ae%e0%a6%b0%e0%a6%be-%e0%a6%87%e0%a6%b0%e0%a6%be%e0%a6%a8-%e0%a6%93-%e0%a6%87%e0%a6%89%e0%a6%95%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%a8-%e0%a6%af%e0%a7%81%e0%a6%a6%e0%a7%8d%e0%a6%a7/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/984449/%e0%a6%86%e0%a6%ae%e0%a6%b0%e0%a6%be-%e0%a6%87%e0%a6%b0%e0%a6%be%e0%a6%a8-%e0%a6%93-%e0%a6%87%e0%a6%89%e0%a6%95%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%a8-%e0%a6%af%e0%a7%81%e0%a6%a6%e0%a7%8d%e0%a6%a7/</guid>
      <pubDate>Sat, 28 Nov 2026 09:25:02 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/10/Pedro-sanchez-300x168.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/10/Pedro-sanchez-300x168.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/10/Pedro-sanchez-300x168.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আমরা ইরান ও ইউক্রেন যুদ্ধের বিরোধিতা করেছি: স্পেনের প্রধানমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;ইরান যুদ্ধ এবং ইউক্রেন যুদ্ধের আমরা দৃঢ়ভাবে বিরোধিতা করেছি বলে জানিয়েছেন স্পেনের প্রধানমন্ত্রী পেদ্রো সানচেজ। স্পেনের পররাষ্ট্রনীতি ব্যাখ্যা করতে গিয়ে প্রধানমন্ত্রী পেদ্রো সানচেজ স্বাধীন ও শান্তিকামী নীতি এবং আন্তর্জাতিক পর্যায়ে যুদ্ধ উসকে দেওয়ার বিরোধিতার ওপর গুরুত্বারোপ করেন। সানচেজ বলেন, আমরা ইরা&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/984449/%e0%a6%86%e0%a6%ae%e0%a6%b0%e0%a6%be-%e0%a6%87%e0%a6%b0%e0%a6%be%e0%a6%a8-%e0%a6%93-%e0%a6%87%e0%a6%89%e0%a6%95%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%a8-%e0%a6%af%e0%a7%81%e0%a6%a6%e0%a7%8d%e0%a6%a7/">অর্থসূচক</source>

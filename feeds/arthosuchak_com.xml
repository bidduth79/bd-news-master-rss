    <item>
      <title>রাজধানীর পরিচ্ছন্নতা কার্যক্রমের অগ্রগতি পর্যালোচনা প্রধানমন্ত্রীর</title>
      <link>https://www.arthosuchak.com/archives/982210/%e0%a6%b0%e0%a6%be%e0%a6%9c%e0%a6%a7%e0%a6%be%e0%a6%a8%e0%a7%80%e0%a6%b0-%e0%a6%aa%e0%a6%b0%e0%a6%bf%e0%a6%9a%e0%a7%8d%e0%a6%9b%e0%a6%a8%e0%a7%8d%e0%a6%a8%e0%a6%a4%e0%a6%be-%e0%a6%95%e0%a6%be%e0%a6%b0/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982210/%e0%a6%b0%e0%a6%be%e0%a6%9c%e0%a6%a7%e0%a6%be%e0%a6%a8%e0%a7%80%e0%a6%b0-%e0%a6%aa%e0%a6%b0%e0%a6%bf%e0%a6%9a%e0%a7%8d%e0%a6%9b%e0%a6%a8%e0%a7%8d%e0%a6%a8%e0%a6%a4%e0%a6%be-%e0%a6%95%e0%a6%be%e0%a6%b0/</guid>
      <pubDate>Sat, 14 Nov 2026 16:16:14 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/07/Tarique-rahman-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/07/Tarique-rahman-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/07/Tarique-rahman-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজধানীর পরিচ্ছন্নতা কার্যক্রমের অগ্রগতি পর্যালোচনা প্রধানমন্ত্রীর" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর পরিচ্ছন্নতা কার্যক্রম আরও গতিশীল ও কার্যকর করতে গঠিত কমিটির কাজের সর্বশেষ অগ্রগতি পর্যালোচনা করেছেন প্রধানমন্ত্রী তারেক রহমান। শনিবার প্রধানমন্ত্রীর সভাপতিত্বে তাঁর তেজগাঁও কার্যালয়ে এ পর্যালোচনা সভা অনুষ্ঠিত হয়। প্রধানমন্ত্রীর উপ-প্রেস সচিব মো. সুজাউদ্দৌলা (সুজন মাহমুদ) এ কথা জানান। খবর- ব&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982210/%e0%a6%b0%e0%a6%be%e0%a6%9c%e0%a6%a7%e0%a6%be%e0%a6%a8%e0%a7%80%e0%a6%b0-%e0%a6%aa%e0%a6%b0%e0%a6%bf%e0%a6%9a%e0%a7%8d%e0%a6%9b%e0%a6%a8%e0%a7%8d%e0%a6%a8%e0%a6%a4%e0%a6%be-%e0%a6%95%e0%a6%be%e0%a6%b0/">অর্থসূচক</source>
    </item>
    <item>
      <title>ডিসেম্বর ঘিরে সীমান্তে বিজিবির নজরদারি বৃদ্ধি</title>
      <link>https://www.arthosuchak.com/archives/982202/%e0%a6%a1%e0%a6%bf%e0%a6%b8%e0%a7%87%e0%a6%ae%e0%a7%8d%e0%a6%ac%e0%a6%b0-%e0%a6%98%e0%a6%bf%e0%a6%b0%e0%a7%87-%e0%a6%b8%e0%a7%80%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%87-%e0%a6%ac/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982202/%e0%a6%a1%e0%a6%bf%e0%a6%b8%e0%a7%87%e0%a6%ae%e0%a7%8d%e0%a6%ac%e0%a6%b0-%e0%a6%98%e0%a6%bf%e0%a6%b0%e0%a7%87-%e0%a6%b8%e0%a7%80%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%87-%e0%a6%ac/</guid>
      <pubDate>Sat, 14 Nov 2026 15:39:17 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2021/02/BGB-300x158.png" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2021/02/BGB-300x158.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2021/02/BGB-300x158.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডিসেম্বর ঘিরে সীমান্তে বিজিবির নজরদারি বৃদ্ধি" /&gt;&lt;/p&gt;&lt;p&gt;ডিসেম্বরকে সামনে রেখে কার্যক্রম নিষিদ্ধ সংগঠনের নেতাকর্মীদের অবৈধ অনুপ্রবেশ এবং সম্ভাব্য নাশকতা ঠেকানোর পাশাপাশি মাদক, অস্ত্র ও গোলাবারুদ চোরাচালান প্রতিরোধে নেত্রকোনার কলমাকান্দা সীমান্তে নিরাপত্তা ও নজরদারি জোরদার করেছে বর্ডার গার্ড বাংলাদেশ (বিজিবি)। শনিবার দুপুরে কলমাকান্দা উপজেলার রংছাতি ইউনিয়ন&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982202/%e0%a6%a1%e0%a6%bf%e0%a6%b8%e0%a7%87%e0%a6%ae%e0%a7%8d%e0%a6%ac%e0%a6%b0-%e0%a6%98%e0%a6%bf%e0%a6%b0%e0%a7%87-%e0%a6%b8%e0%a7%80%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%87-%e0%a6%ac/">অর্থসূচক</source>
    </item>
    <item>
      <title>সিভিও পেট্রোর প্রথম প্রান্তিক প্রকাশ</title>
      <link>https://www.arthosuchak.com/archives/982244/%e0%a6%b8%e0%a6%bf%e0%a6%ad%e0%a6%bf%e0%a6%93-%e0%a6%aa%e0%a7%87%e0%a6%9f%e0%a7%8d%e0%a6%b0%e0%a7%8b%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a5%e0%a6%ae-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%be-3/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982244/%e0%a6%b8%e0%a6%bf%e0%a6%ad%e0%a6%bf%e0%a6%93-%e0%a6%aa%e0%a7%87%e0%a6%9f%e0%a7%8d%e0%a6%b0%e0%a7%8b%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a5%e0%a6%ae-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%be-3/</guid>
      <pubDate>Sat, 14 Nov 2026 15:10:35 +0000</pubDate>
      <description>পুঁজিবাজারে তালিকাভুক্ত কোম্পানি  সিভিও পেট্রোকেমিক্যাল পিএলসি ৩০ সেপ্টেম্বর, ২০২৬ তারিখে সমাপ্ত প্রথম প্রান্তিকের (জুলাই’২৬-সেপ্টেম্বর’২৬) অনিরীক্ষিত আর্থিক প্রতিবেদন প্রকাশ করেছে। শনিবার (১৪ নভেম্বর) অনুষ্ঠিত কোম্পানির পরিচালনা পর্ষদের বৈঠকে চলতি হিসাববছরের প্রথম প্রান্তিকের আর্থিক প্রতিবেদন পর্যা</description>
      <source url="https://www.arthosuchak.com/archives/982244/%e0%a6%b8%e0%a6%bf%e0%a6%ad%e0%a6%bf%e0%a6%93-%e0%a6%aa%e0%a7%87%e0%a6%9f%e0%a7%8d%e0%a6%b0%e0%a7%8b%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a5%e0%a6%ae-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%be-3/">অর্থসূচক</source>
    </item>

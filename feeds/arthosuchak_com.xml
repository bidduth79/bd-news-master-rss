    <item>
      <title>গোল্ডেন সনের প্রথম প্রান্তিক প্রকাশ</title>
      <link>https://www.arthosuchak.com/archives/982055/%e0%a6%97%e0%a7%8b%e0%a6%b2%e0%a7%8d%e0%a6%a1%e0%a7%87%e0%a6%a8-%e0%a6%b8%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a5%e0%a6%ae-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%a8-6/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982055/%e0%a6%97%e0%a7%8b%e0%a6%b2%e0%a7%8d%e0%a6%a1%e0%a7%87%e0%a6%a8-%e0%a6%b8%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a5%e0%a6%ae-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%a8-6/</guid>
      <pubDate>Sat, 14 Nov 2026 20:07:26 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2021/10/golden-son-533x400-1-300x225.png" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2021/10/golden-son-533x400-1-300x225.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2021/10/golden-son-533x400-1-300x225.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গোল্ডেন সনের প্রথম প্রান্তিক প্রকাশ" /&gt;&lt;/p&gt;&lt;p&gt;পুঁজিবাজারে তালিকাভুক্ত কোম্পানি গোল্ডেন সন লিমিটেড ৩০ সেপ্টেম্বর, ২০২৬ তারিখে সমাপ্ত প্রথম প্রান্তিকের (জুলাই’২৬-সেপ্টেম্বর’২৬) অনিরীক্ষিত আর্থিক প্রতিবেদন প্রকাশ করেছে। শনিবার (১৪ নভেম্বর) অনুষ্ঠিত কোম্পানির পরিচালনা পর্ষদের বৈঠকে চলতি হিসাববছরের প্রথম প্রান্তিকের আর্থিক প্রতিবেদন পর্যালোচনা ও অনু&lt;/p&gt;</description>

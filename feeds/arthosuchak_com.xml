    </item>
    <item>
      <title>ভবিষ্যতের নেতৃত্বের জন্য এখন থেকেই নিজেদের প্রস্তুত করতে হবে: প্রধানমন্ত্রী</title>
      <link>https://www.arthosuchak.com/archives/982827/%e0%a6%ad%e0%a6%ac%e0%a6%bf%e0%a6%b7%e0%a7%8d%e0%a6%af%e0%a6%a4%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a7%87%e0%a6%a4%e0%a7%83%e0%a6%a4%e0%a7%8d%e0%a6%ac%e0%a7%87%e0%a6%b0-%e0%a6%9c%e0%a6%a8%e0%a7%8d%e0%a6%af/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982827/%e0%a6%ad%e0%a6%ac%e0%a6%bf%e0%a6%b7%e0%a7%8d%e0%a6%af%e0%a6%a4%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a7%87%e0%a6%a4%e0%a7%83%e0%a6%a4%e0%a7%8d%e0%a6%ac%e0%a7%87%e0%a6%b0-%e0%a6%9c%e0%a6%a8%e0%a7%8d%e0%a6%af/</guid>

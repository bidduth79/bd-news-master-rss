      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/NCC-Bank-Nilphamari-300x159.jpeg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/NCC-Bank-Nilphamari-300x159.jpeg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/NCC-Bank-Nilphamari-300x159.jpeg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নীলফামারীতে প্রান্তিক কৃষকের মাঝে এনসিসি ব্যাংকের কৃষি উপকরণ বিতরণ" /&gt;&lt;/p&gt;&lt;p&gt;কৃষি উৎপাদন বৃদ্ধি, কৃষকদের আর্থিক সক্ষমতা উন্নয়ন এবং দেশের খাদ্যনিরাপত্তা নিশ্চিত করার লক্ষ্যে বিশেষ সিএসআর কর্মসূচির আওতায় নীলফামারী সদর, ডিমলা ও ডোমার উপজেলায় সম্প্রতি ১,৫০০০ প্রান্তিক কৃষকের মাঝে বিনামূল্যে কৃষি উপকরণ বিতরণ করেছে এনসিসি ব্যাংক পিএলসি। বিতরণকৃত উপকরণের মধ্যে রয়েছে বিভিন্ন জাতের উ&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981324/%e0%a6%a8%e0%a7%80%e0%a6%b2%e0%a6%ab%e0%a6%be%e0%a6%ae%e0%a6%be%e0%a6%b0%e0%a7%80%e0%a6%a4%e0%a7%87-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a6%bf%e0%a6%95-%e0%a6%95%e0%a7%83/">অর্থসূচক</source>
    </item>
    <item>
      <title>সিআইডি ও এসবি কার্যালয়ের সামনে ককটেল বিস্ফোরণ</title>
      <link>https://www.arthosuchak.com/archives/981321/%e0%a6%b8%e0%a6%bf%e0%a6%86%e0%a6%87%e0%a6%a1%e0%a6%bf-%e0%a6%93-%e0%a6%8f%e0%a6%b8%e0%a6%ac%e0%a6%bf-%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%b2%e0%a6%af%e0%a6%bc%e0%a7%87/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981321/%e0%a6%b8%e0%a6%bf%e0%a6%86%e0%a6%87%e0%a6%a1%e0%a6%bf-%e0%a6%93-%e0%a6%8f%e0%a6%b8%e0%a6%ac%e0%a6%bf-%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%b2%e0%a6%af%e0%a6%bc%e0%a7%87/</guid>
      <pubDate>Sun, 08 Nov 2026 16:10:08 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2024/10/Cid-300x168.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2024/10/Cid-300x168.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2024/10/Cid-300x168.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সিআইডি ও এসবি কার্যালয়ের সামনে ককটেল বিস্ফোরণ" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর মালিবাগে পুলিশের অপরাধ তদন্ত বিভাগ (সিআইডি) ও পুলিশের বিশেষ শাখার (এসবি) প্রধান কার্যালয়ের সামনে ককটেল বিস্ফোরণের ঘটনা ঘটেছে। তবে এতে কেউ হতাহত হয়নি বলে জানিয়েছে পুলিশ। রোববার (৮ নভেম্বর) সন্ধ্যা সাড়ে ৭টার দিকে এই ঘটনা ঘটে। বিষয়টি নিশ্চিত করে পল্টন থানার ভারপ্রাপ্ত কর্মকর্তা (ওসি) আরিফুল আল&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981321/%e0%a6%b8%e0%a6%bf%e0%a6%86%e0%a6%87%e0%a6%a1%e0%a6%bf-%e0%a6%93-%e0%a6%8f%e0%a6%b8%e0%a6%ac%e0%a6%bf-%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%b2%e0%a6%af%e0%a6%bc%e0%a7%87/">অর্থসূচক</source>
    </item>
    <item>
      <title>এজেন্ট ব্যাংকিংয়ে জালিয়াতি প্রতিরোধে ইসলামী ব্যাংকের প্রশিক্ষণ কর্মশালা</title>
      <link>https://www.arthosuchak.com/archives/981309/%e0%a6%8f%e0%a6%9c%e0%a7%87%e0%a6%a8%e0%a7%8d%e0%a6%9f-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95%e0%a6%bf%e0%a6%82%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%9c%e0%a6%be%e0%a6%b2%e0%a6%bf%e0%a6%af/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981309/%e0%a6%8f%e0%a6%9c%e0%a7%87%e0%a6%a8%e0%a7%8d%e0%a6%9f-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95%e0%a6%bf%e0%a6%82%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%9c%e0%a6%be%e0%a6%b2%e0%a6%bf%e0%a6%af/</guid>
      <pubDate>Sun, 08 Nov 2026 15:51:10 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Agent-Ibb-300x167.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Agent-Ibb-300x167.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Agent-Ibb-300x167.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এজেন্ট ব্যাংকিংয়ে জালিয়াতি প্রতিরোধে ইসলামী ব্যাংকের প্রশিক্ষণ কর্মশালা" /&gt;&lt;/p&gt;&lt;p&gt;এজেন্ট ব্যাংকিংয়ে জালিয়াতি প্রতিরোধ, কমপ্লায়েন্স নিশ্চিতকরণ ও নিরাপদ ব্যাংকিং সেবার মানোন্নয়নে ইসলামী ব্যাংক বাংলাদেশ পিএলসির কক্সবাজার শাখার উদ্যোগে এবং এজেন্ট ব্যাংকিং ডিভিশনের সমন্বয়ে “এজেন্ট আউটলেটগুলোতে জালিয়াতি ও প্রতারণা প্রতিরোধ বিষয়ক প্রশিক্ষণ কর্মশালা” অনুষ্ঠিত হয়েছে। কর্মশালায় প্রধ&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981309/%e0%a6%8f%e0%a6%9c%e0%a7%87%e0%a6%a8%e0%a7%8d%e0%a6%9f-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95%e0%a6%bf%e0%a6%82%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%9c%e0%a6%be%e0%a6%b2%e0%a6%bf%e0%a6%af/">অর্থসূচক</source>
    </item>
    <item>
      <title>জাতীয় বিপ্লব ও সংহতি দিবস উপলক্ষ্যে আইসিবিতে বিশেষ দোয়া ও মিলাদ-মাহফিল</title>
      <link>https://www.arthosuchak.com/archives/981300/%e0%a6%9c%e0%a6%be%e0%a6%a4%e0%a7%80%e0%a6%af%e0%a6%bc-%e0%a6%ac%e0%a6%bf%e0%a6%aa%e0%a7%8d%e0%a6%b2%e0%a6%ac-%e0%a6%93-%e0%a6%b8%e0%a6%82%e0%a6%b9%e0%a6%a4%e0%a6%bf-%e0%a6%a6%e0%a6%bf%e0%a6%ac/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981300/%e0%a6%9c%e0%a6%be%e0%a6%a4%e0%a7%80%e0%a6%af%e0%a6%bc-%e0%a6%ac%e0%a6%bf%e0%a6%aa%e0%a7%8d%e0%a6%b2%e0%a6%ac-%e0%a6%93-%e0%a6%b8%e0%a6%82%e0%a6%b9%e0%a6%a4%e0%a6%bf-%e0%a6%a6%e0%a6%bf%e0%a6%ac/</guid>
      <pubDate>Sun, 08 Nov 2026 15:42:16 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/November-Icb-300x149.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/November-Icb-300x149.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/November-Icb-300x149.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জাতীয় বিপ্লব ও সংহতি দিবস উপলক্ষ্যে আইসিবিতে বিশেষ দোয়া ও মিলাদ-মাহফিল" /&gt;&lt;/p&gt;&lt;p&gt;ঐতিহাসিক ৭ নভেম্বর জাতীয় বিপ্লব ও সংহতি দিবস উপলক্ষ্যে রবিবার বাদ যোহর ইনভেস্টমেন্ট কর্পোরেশন অব বাংলাদেশ (আইসিবি) এর প্রধান কার্যালয়ে এক বিশেষ দোয়া ও মিলাদ মাহফিলের আয়োজন করা হয়। আইসিবির পরিচালনা বোর্ডের চেয়ারম্যান অধ্যাপক আবু আহমেদ, আইসিবি’র ব্যবস্থাপনা পরিচালক নিরঞ্জন চন্দ্র দেবনাথ, উপ-ব্যবস্থাপন&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981300/%e0%a6%9c%e0%a6%be%e0%a6%a4%e0%a7%80%e0%a6%af%e0%a6%bc-%e0%a6%ac%e0%a6%bf%e0%a6%aa%e0%a7%8d%e0%a6%b2%e0%a6%ac-%e0%a6%93-%e0%a6%b8%e0%a6%82%e0%a6%b9%e0%a6%a4%e0%a6%bf-%e0%a6%a6%e0%a6%bf%e0%a6%ac/">অর্থসূচক</source>
    </item>
    <item>
      <title>নবীন বিসিএস কর্মকর্তাদের সততা ও মানবিকতার সঙ্গে জনগণের সেবা করার আহ্বান প্রধানমন্ত্রীর</title>
      <link>https://www.arthosuchak.com/archives/981294/%e0%a6%a8%e0%a6%ac%e0%a7%80%e0%a6%a8-%e0%a6%ac%e0%a6%bf%e0%a6%b8%e0%a6%bf%e0%a6%8f%e0%a6%b8-%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%a6%e0%a7%87-2/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981294/%e0%a6%a8%e0%a6%ac%e0%a7%80%e0%a6%a8-%e0%a6%ac%e0%a6%bf%e0%a6%b8%e0%a6%bf%e0%a6%8f%e0%a6%b8-%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%a6%e0%a7%87-2/</guid>
      <pubDate>Sun, 08 Nov 2026 15:35:15 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/05/Prime-Minister-Tarique-Rahman-1-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/05/Prime-Minister-Tarique-Rahman-1-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/05/Prime-Minister-Tarique-Rahman-1-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নবীন বিসিএস কর্মকর্তাদের সততা ও মানবিকতার সঙ্গে জনগণের সেবা করার আহ্বান প্রধানমন্ত্রীর" /&gt;&lt;/p&gt;&lt;p&gt;নবীন বিসিএস কর্মকর্তাদের সততা, দক্ষতা ও মানবিক মূল্যবোধের সঙ্গে জনগণের সেবা করার আহ্বান জানিয়েছেন প্রধানমন্ত্রী তারেক রহমান। তিনি বলেন, একজন সরকারি কর্মকর্তা হিসেবে আপনাদের কাছে জনগণ শুধু আদেশ-নির্দেশ নয়, মানবিকতাও আশা করে। সরকারি সেবা নিতে গিয়ে কোনো নাগরিক যেন হয়রানির শিকার না হন, তা কর্মকর্তাদের ন&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981294/%e0%a6%a8%e0%a6%ac%e0%a7%80%e0%a6%a8-%e0%a6%ac%e0%a6%bf%e0%a6%b8%e0%a6%bf%e0%a6%8f%e0%a6%b8-%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%a6%e0%a7%87-2/">অর্থসূচক</source>
    </item>

    <item>
      <title>সূচকের মিশ্র প্রতিক্রিয়ায় চলছে লেনদেন</title>
      <link>https://www.arthosuchak.com/archives/981364/%e0%a6%b8%e0%a7%82%e0%a6%9a%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b0%e0%a6%bf%e0%a6%af-181/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981364/%e0%a6%b8%e0%a7%82%e0%a6%9a%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b0%e0%a6%bf%e0%a6%af-181/</guid>
      <pubDate>Mon, 09 Nov 2026 05:11:14 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/MU-09-11-110326-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/MU-09-11-110326-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/MU-09-11-110326-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সূচকের মিশ্র প্রতিক্রিয়ায় চলছে লেনদেন" /&gt;&lt;/p&gt;&lt;p&gt;সপ্তাহের প্রথম কার্যদিবস সোমবার (০৯ নভেম্বর) দেশের প্রধান পুঁজিবাজার ঢাকা স্টক এক্সচেঞ্জে (ডিএসই) সূচকের মিশ্র প্রতিক্রিয়ায় চলছে লেনদেন। এদিন লেনদেনের প্রথম দিকে প্রধান সূচক সামান্য বেড়েছে। তবে কমেছে ডিএসই-৩০ সূচক। সোমবার বেলা ১১টা ২ মিনিটে ডিএসইর প্রধান সূচক ডিএসইএক্স ৫ দশমিক ৬৪ পয়েন্ট বেড়ে ৫ হাজার&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981364/%e0%a6%b8%e0%a7%82%e0%a6%9a%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b0%e0%a6%bf%e0%a6%af-181/">অর্থসূচক</source>
    </item>
    <item>
      <title>দেশে ফিরতে নতুন পাসপোর্ট ও পরিচয়পত্র চাইলেন শেখ হাসিনা</title>
      <link>https://www.arthosuchak.com/archives/981363/%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%87-%e0%a6%ab%e0%a6%bf%e0%a6%b0%e0%a6%a4%e0%a7%87-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%aa%e0%a6%be%e0%a6%b8%e0%a6%aa%e0%a7%8b%e0%a6%b0%e0%a7%8d%e0%a6%9f/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981363/%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%87-%e0%a6%ab%e0%a6%bf%e0%a6%b0%e0%a6%a4%e0%a7%87-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%aa%e0%a6%be%e0%a6%b8%e0%a6%aa%e0%a7%8b%e0%a6%b0%e0%a7%8d%e0%a6%9f/</guid>
      <pubDate>Mon, 09 Nov 2026 04:40:02 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2023/12/pm-hasina-2-300x170.png" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2023/12/pm-hasina-2-300x170.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2023/12/pm-hasina-2-300x170.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দেশে ফিরতে নতুন পাসপোর্ট ও পরিচয়পত্র চাইলেন শেখ হাসিনা" /&gt;&lt;/p&gt;&lt;p&gt;ভারত থেকে বাংলাদেশে ফেরার প্রস্তুতির অংশ হিসেবে নতুন পাসপোর্ট ও জাতীয় পরিচয়পত্র চেয়ে দিল্লিতে অবস্থিত বাংলাদেশ দূতাবাসে আবেদন করেছেন ক্ষমতাচ্যুত প্রধানমন্ত্রী শেখ হাসিনা। সোমবার (৯ নভেম্বর) পাঠানো এক চিঠিতে তাঁর আইনজীবীরা এ আবেদন করেন। ২০২৪ সালে দেশ ছাড়ার পর এ বিষয়ে এটিই তাঁর প্রথম আনুষ্ঠানিক যোগাযো&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981363/%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%87-%e0%a6%ab%e0%a6%bf%e0%a6%b0%e0%a6%a4%e0%a7%87-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%aa%e0%a6%be%e0%a6%b8%e0%a6%aa%e0%a7%8b%e0%a6%b0%e0%a7%8d%e0%a6%9f/">অর্থসূচক</source>
    </item>
    <item>
      <title>মিসরে দুই ট্রেনের সংঘর্ষে নিহত ৭, আহত ১১২</title>
      <link>https://www.arthosuchak.com/archives/981359/%e0%a6%ae%e0%a6%bf%e0%a6%b8%e0%a6%b0%e0%a7%87-%e0%a6%a6%e0%a7%81%e0%a6%87-%e0%a6%9f%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%82%e0%a6%98%e0%a6%b0%e0%a7%8d%e0%a6%b7/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981359/%e0%a6%ae%e0%a6%bf%e0%a6%b8%e0%a6%b0%e0%a7%87-%e0%a6%a6%e0%a7%81%e0%a6%87-%e0%a6%9f%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%82%e0%a6%98%e0%a6%b0%e0%a7%8d%e0%a6%b7/</guid>
      <pubDate>Mon, 09 Nov 2026 04:28:19 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Egypt-Train-Colliton-300x158.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Egypt-Train-Colliton-300x158.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Egypt-Train-Colliton-300x158.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মিসরে দুই ট্রেনের সংঘর্ষে নিহত ৭, আহত ১১২" /&gt;&lt;/p&gt;&lt;p&gt;মিসরের রাজধানী কায়রোর দক্ষিণে দুটি যাত্রীবাহী ট্রেনের সংঘর্ষে অন্তত ৭ জন নিহত হয়েছেন। এ ঘটনায় আহত হয়েছেন আরও ১১২ জন। নিহতদের মধ্যে দুই ট্রেনের কন্ডাক্টরও রয়েছেন। রোববার (৮ নভেম্বর) দেশটির গিজা প্রদেশের আল-আইয়াত জেলায় এ দুর্ঘটনা ঘটে। কায়রো থেকে প্রায় ৫২ কিলোমিটার দক্ষিণে দুর্ঘটনাস্থলটির অবস্থান। মিসর&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981359/%e0%a6%ae%e0%a6%bf%e0%a6%b8%e0%a6%b0%e0%a7%87-%e0%a6%a6%e0%a7%81%e0%a6%87-%e0%a6%9f%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%82%e0%a6%98%e0%a6%b0%e0%a7%8d%e0%a6%b7/">অর্থসূচক</source>
    </item>
    <item>
      <title>ঢাকায় আজ বৃষ্টির সম্ভাবনা নেই, অপরিবর্তিত থাকবে তাপমাত্রা</title>
      <link>https://www.arthosuchak.com/archives/981355/%e0%a6%a2%e0%a6%be%e0%a6%95%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%86%e0%a6%9c-%e0%a6%ac%e0%a7%83%e0%a6%b7%e0%a7%8d%e0%a6%9f%e0%a6%bf%e0%a6%b0-%e0%a6%b8%e0%a6%ae%e0%a7%8d%e0%a6%ad%e0%a6%be%e0%a6%ac/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981355/%e0%a6%a2%e0%a6%be%e0%a6%95%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%86%e0%a6%9c-%e0%a6%ac%e0%a7%83%e0%a6%b7%e0%a7%8d%e0%a6%9f%e0%a6%bf%e0%a6%b0-%e0%a6%b8%e0%a6%ae%e0%a7%8d%e0%a6%ad%e0%a6%be%e0%a6%ac/</guid>
      <pubDate>Mon, 09 Nov 2026 04:25:09 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2024/06/dhaka-1-300x150.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2024/06/dhaka-1-300x150.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2024/06/dhaka-1-300x150.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঢাকায় আজ বৃষ্টির সম্ভাবনা নেই, অপরিবর্তিত থাকবে তাপমাত্রা" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানী ঢাকা ও আশপাশের এলাকায় আজ বৃষ্টির কোনো সম্ভাবনা নেই। আকাশ অস্থায়ীভাবে আংশিক মেঘলা থাকলেও আবহাওয়া শুষ্ক থাকতে পারে। একই সঙ্গে দিনের তাপমাত্রা প্রায় অপরিবর্তিত থাকার পূর্বাভাস দিয়েছে বাংলাদেশ আবহাওয়া অধিদপ্তর। সোমবার (৯ নভেম্বর) সকাল ৭টা থেকে পরবর্তী ছয় ঘণ্টার আবহাওয়ার পূর্বাভাসে এ তথ্য জানানো &lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981355/%e0%a6%a2%e0%a6%be%e0%a6%95%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%86%e0%a6%9c-%e0%a6%ac%e0%a7%83%e0%a6%b7%e0%a7%8d%e0%a6%9f%e0%a6%bf%e0%a6%b0-%e0%a6%b8%e0%a6%ae%e0%a7%8d%e0%a6%ad%e0%a6%be%e0%a6%ac/">অর্থসূচক</source>
    </item>
    <item>
      <title>পাওয়ার গ্রিডের প্রথম প্রান্তিক প্রকাশ</title>
      <link>https://www.arthosuchak.com/archives/981357/%e0%a6%aa%e0%a6%be%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0-%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%bf%e0%a6%a1%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a5%e0%a6%ae-%e0%a6%aa%e0%a7%8d/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981357/%e0%a6%aa%e0%a6%be%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0-%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%bf%e0%a6%a1%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a5%e0%a6%ae-%e0%a6%aa%e0%a7%8d/</guid>
      <pubDate>Mon, 09 Nov 2026 04:20:10 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2025/02/power-grid-bangladesh-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2025/02/power-grid-bangladesh-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2025/02/power-grid-bangladesh-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পাওয়ার গ্রিডের প্রথম প্রান্তিক প্রকাশ" /&gt;&lt;/p&gt;&lt;p&gt;পুঁজিবাজারে তালিকাভুক্ত কোম্পানি পাওয়ার গ্রিড বাংলাদেশ পিএলসির গত ৩০ সেপ্টেম্বর, ২০২৬ তারিখে সমাপ্ত প্রথম প্রান্তিকের (জুলাই’২৬-সেপ্টেম্বর’২৬) অনিরীক্ষিত আর্থিক প্রতিবেদন প্রকাশ করা হয়েছে। কোম্পানিটির পরিচালনা পর্ষদের বৈঠকে চলতি হিসাববছরের প্রথম প্রান্তিকের আর্থিক প্রতিবেদন পর্যালোচনা ও অনুমোদনের পর&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981357/%e0%a6%aa%e0%a6%be%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0-%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%bf%e0%a6%a1%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a5%e0%a6%ae-%e0%a6%aa%e0%a7%8d/">অর্থসূচক</source>
    </item>

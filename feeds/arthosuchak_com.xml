    <item>
      <title>হিমায়িত খাদ্য রপ্তানি খাতে ঋণ দেবে এনসিসি ব্যাংক</title>
      <link>https://www.arthosuchak.com/archives/982846/%e0%a6%b9%e0%a6%bf%e0%a6%ae%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a6%bf%e0%a6%a4-%e0%a6%96%e0%a6%be%e0%a6%a6%e0%a7%8d%e0%a6%af-%e0%a6%b0%e0%a6%aa%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%a8%e0%a6%bf-%e0%a6%96/</link>

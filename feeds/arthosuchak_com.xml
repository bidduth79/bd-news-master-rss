    </item>
    <item>
      <title>মানবাধিকার সংস্থার সঙ্গে গঠনমূলক সম্পৃক্তক্ততা বজায় রাখার অঙ্গীকার বাংলাদেশের</title>
      <link>https://www.arthosuchak.com/archives/981249/%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a6%ac%e0%a6%be%e0%a6%a7%e0%a6%bf%e0%a6%95%e0%a6%be%e0%a6%b0-%e0%a6%b8%e0%a6%82%e0%a6%b8%e0%a7%8d%e0%a6%a5%e0%a6%be%e0%a6%b0-%e0%a6%b8%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%87/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981249/%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a6%ac%e0%a6%be%e0%a6%a7%e0%a6%bf%e0%a6%95%e0%a6%be%e0%a6%b0-%e0%a6%b8%e0%a6%82%e0%a6%b8%e0%a7%8d%e0%a6%a5%e0%a6%be%e0%a6%b0-%e0%a6%b8%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%87/</guid>
      <pubDate>Sun, 08 Nov 2026 13:26:54 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Bd-UN-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Bd-UN-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Bd-UN-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মানবাধিকার সংস্থার সঙ্গে গঠনমূলক সম্পৃক্তক্ততা বজায় রাখার অঙ্গীকার বাংলাদেশের" /&gt;&lt;/p&gt;&lt;p&gt;জাতিসংঘ মানবাধিকার বিষয়ক হাইকমিশনারের কার্যালয় (ওএইচসিএইচআর)-এর সাথে গঠনমূলক সম্পৃক্ততা বজায় রাখার অঙ্গীকার পুনর্ব্যক্ত করেছে বাংলাদেশ। আজ পররাষ্ট্র মন্ত্রণালয়ে ওএইচসিএইচআর-এর বাংলাদেশ মিশনের নবনিযুক্ত প্রধান সাবিন ম্যাগডালেনা লাউবার তার পরিচয়পত্র পেশ করার সময় পররাষ্ট্র প্রতিমন্ত্রী হুমায়ুন কবির এই &lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981249/%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a6%ac%e0%a6%be%e0%a6%a7%e0%a6%bf%e0%a6%95%e0%a6%be%e0%a6%b0-%e0%a6%b8%e0%a6%82%e0%a6%b8%e0%a7%8d%e0%a6%a5%e0%a6%be%e0%a6%b0-%e0%a6%b8%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%87/">অর্থসূচক</source>

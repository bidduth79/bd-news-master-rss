    <item>
      <title>জাতিসংঘে বিপুল ভোটে রোহিঙ্গা প্রস্তাব পাস</title>
      <link>https://www.arthosuchak.com/archives/983134/%e0%a6%9c%e0%a6%be%e0%a6%a4%e0%a6%bf%e0%a6%b8%e0%a6%82%e0%a6%98%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%aa%e0%a7%81%e0%a6%b2-%e0%a6%ad%e0%a7%8b%e0%a6%9f%e0%a7%87-%e0%a6%b0%e0%a7%8b%e0%a6%b9%e0%a6%bf/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983134/%e0%a6%9c%e0%a6%be%e0%a6%a4%e0%a6%bf%e0%a6%b8%e0%a6%82%e0%a6%98%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%aa%e0%a7%81%e0%a6%b2-%e0%a6%ad%e0%a7%8b%e0%a6%9f%e0%a7%87-%e0%a6%b0%e0%a7%8b%e0%a6%b9%e0%a6%bf/</guid>
      <pubDate>Thu, 19 Nov 2026 10:00:01 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2023/12/rohinga-300x162.png" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2023/12/rohinga-300x162.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2023/12/rohinga-300x162.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জাতিসংঘে বিপুল ভোটে রোহিঙ্গা প্রস্তাব পাস" /&gt;&lt;/p&gt;&lt;p&gt;মিয়ানমারে রোহিঙ্গা মুসলিমসহ অন্যান্য সংখ্যালঘু জনগোষ্ঠীর মানবাধিকার পরিস্থিতি নিয়ে জাতিসংঘ সাধারণ পরিষদে উত্থাপিত প্রস্তাব বিপুল ভোটে পাস হয়েছে। ইসলামী সহযোগিতা সংস্থা (ওআইসি) ও ইউরোপীয় ইউনিয়নের (ইইউ) যৌথ উদ্যোগে আনা প্রস্তাবটির পক্ষে ভোট দিয়েছে ১২৮টি দেশ। বিপক্ষে ভোট পড়েছে ছয়টি এবং ভোটদানে বিরত ছিল&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983134/%e0%a6%9c%e0%a6%be%e0%a6%a4%e0%a6%bf%e0%a6%b8%e0%a6%82%e0%a6%98%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%aa%e0%a7%81%e0%a6%b2-%e0%a6%ad%e0%a7%8b%e0%a6%9f%e0%a7%87-%e0%a6%b0%e0%a7%8b%e0%a6%b9%e0%a6%bf/">অর্থসূচক</source>
    </item>
    <item>
      <title>জ্বালানি ইস্যুতে বাংলাদেশের পাশে থাকবে যুক্তরাষ্ট্র</title>

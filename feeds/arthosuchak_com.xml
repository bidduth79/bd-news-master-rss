      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/ncp-new-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/ncp-new-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/ncp-new-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রধানমন্ত্রীর সঙ্গে এনসিপির বৈঠক চলছে" /&gt;&lt;/p&gt;&lt;p&gt;দেশের চলমান রাজনৈতিক পরিস্থিতি ও জাতীয় ঐক্য প্রতিষ্ঠার লক্ষ্যে প্রধানমন্ত্রী ও বিএনপির চেয়ারম্যান তারেক রহমানের সঙ্গে সচিবালয়ে বৈঠকে বসেছেন জাতীয় নাগরিক পার্টির (এনসিপি) ৪ সদস্যের প্রতিনিধি দল। সোমবার (২৩ নভেম্বর) দুপুরে সচিবালয়ে বৈঠকে বসেছে এনসিপি প্রতিনিধি দল। এনসিপির আহ্বায়ক নাহিদ ইসলামের নেতৃত্ব&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983603/%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a7%e0%a6%be%e0%a6%a8%e0%a6%ae%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a7%80%e0%a6%b0-%e0%a6%b8%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%87-%e0%a6%8f%e0%a6%a8%e0%a6%b8/">অর্থসূচক</source>
    </item>
    <item>
      <title>দুই দিনের সফরে ঢাকায় আসছেন মালয়েশিয়ার প্রধানমন্ত্রী</title>
      <link>https://www.arthosuchak.com/archives/983598/%e0%a6%a6%e0%a7%81%e0%a6%87-%e0%a6%a6%e0%a6%bf%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%ab%e0%a6%b0%e0%a7%87-%e0%a6%a2%e0%a6%be%e0%a6%95%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%86%e0%a6%b8%e0%a6%9b/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983598/%e0%a6%a6%e0%a7%81%e0%a6%87-%e0%a6%a6%e0%a6%bf%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%ab%e0%a6%b0%e0%a7%87-%e0%a6%a2%e0%a6%be%e0%a6%95%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%86%e0%a6%b8%e0%a6%9b/</guid>
      <pubDate>Mon, 23 Nov 2026 07:37:43 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/tarek-ibrahim-2026-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/tarek-ibrahim-2026-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/tarek-ibrahim-2026-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দুই দিনের সফরে ঢাকায় আসছেন মালয়েশিয়ার প্রধানমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশে নতুন সরকার গঠনের পর প্রথমবারের মতো কোনো দেশের সরকারপ্রধান দ্বিপক্ষীয় সফরে আসছেন। আগামী ৭ ডিসেম্বর দুই দিনের সফরে ঢাকায় আসছেন মালয়েশিয়ার প্রধানমন্ত্রী আনোয়ার ইব্রাহিম। তার এ সফরকে সামনে রেখে প্রয়োজনীয় প্রস্তুতি চলছে বলে জানিয়েছে পররাষ্ট্র মন্ত্রণালয়ের কর্মকর্তারা। সফরকালে প্রধানমন্ত্রী তারে&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983598/%e0%a6%a6%e0%a7%81%e0%a6%87-%e0%a6%a6%e0%a6%bf%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%ab%e0%a6%b0%e0%a7%87-%e0%a6%a2%e0%a6%be%e0%a6%95%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%86%e0%a6%b8%e0%a6%9b/">অর্থসূচক</source>
    </item>
    <item>
      <title>রূপপুরের বিদ্যুৎ উৎপাদনে নতুন ধাপ, আবারও গ্রিডে পরীক্ষামূলক সরবরাহ</title>
      <link>https://www.arthosuchak.com/archives/983596/%e0%a6%b0%e0%a7%82%e0%a6%aa%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a7%81%e0%a7%8e-%e0%a6%89%e0%a7%8e%e0%a6%aa%e0%a6%be%e0%a6%a6%e0%a6%a8%e0%a7%87/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983596/%e0%a6%b0%e0%a7%82%e0%a6%aa%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a7%81%e0%a7%8e-%e0%a6%89%e0%a7%8e%e0%a6%aa%e0%a6%be%e0%a6%a6%e0%a6%a8%e0%a7%87/</guid>
      <pubDate>Mon, 23 Nov 2026 07:08:28 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Ruppur-300x150.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Ruppur-300x150.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Ruppur-300x150.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রূপপুরের বিদ্যুৎ উৎপাদনে নতুন ধাপ, আবারও গ্রিডে পরীক্ষামূলক সরবরাহ" /&gt;&lt;/p&gt;&lt;p&gt;দেশের প্রথম পারমাণবিক বিদ্যুৎকেন্দ্র রূপপুর থেকে দ্বিতীয় দফায় জাতীয় গ্রিডে বিদ্যুৎ সরবরাহ শুরু হয়েছে। সোমবার (২৩ নভেম্বর) সকাল ১০টা ২০ মিনিটে কেন্দ্রটির উৎপাদিত বিদ্যুৎ পরীক্ষামূলকভাবে গ্রিডে যুক্ত করা হয়। এ ধাপে ৩০০ থেকে ৩৫০ মেগাওয়াট বিদ্যুৎ সরবরাহের পরিকল্পনা রয়েছে। রূপপুর পারমাণবিক বিদ্যুৎকেন্দ্র&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983596/%e0%a6%b0%e0%a7%82%e0%a6%aa%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a7%81%e0%a7%8e-%e0%a6%89%e0%a7%8e%e0%a6%aa%e0%a6%be%e0%a6%a6%e0%a6%a8%e0%a7%87/">অর্থসূচক</source>
    </item>
    <item>
      <title>ব্যাংক খাতে খেলাপি ঋণ ছাড়াল ৬ লাখ কোটি টাকা</title>
      <link>https://www.arthosuchak.com/archives/983593/%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95-%e0%a6%96%e0%a6%be%e0%a6%a4%e0%a7%87-%e0%a6%96%e0%a7%87%e0%a6%b2%e0%a6%be%e0%a6%aa%e0%a6%bf-%e0%a6%8b%e0%a6%a3-%e0%a6%9b%e0%a6%be%e0%a6%a1/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983593/%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95-%e0%a6%96%e0%a6%be%e0%a6%a4%e0%a7%87-%e0%a6%96%e0%a7%87%e0%a6%b2%e0%a6%be%e0%a6%aa%e0%a6%bf-%e0%a6%8b%e0%a6%a3-%e0%a6%9b%e0%a6%be%e0%a6%a1/</guid>
      <pubDate>Mon, 23 Nov 2026 07:01:20 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2022/06/Bangladesh-Bank-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2022/06/Bangladesh-Bank-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2022/06/Bangladesh-Bank-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ব্যাংক খাতে খেলাপি ঋণ ছাড়াল ৬ লাখ কোটি টাকা" /&gt;&lt;/p&gt;&lt;p&gt;দেশের ব্যাংক খাতে খেলাপি ও শ্রেণিকৃত ঋণের পরিমাণ উদ্বেগজনক হারে বাড়ছে। গত সেপ্টেম্বর মাস শেষে খেলাপি ঋণের পরিমাণ বেড়ে দাঁড়িয়েছে ৬ লাখ ২৭ হাজার ৪০৪ কোটি টাকা। বিতরণ করা মোট ঋণের হিসাবে এর হার ৩৩ দশমিক ৮০ শতাংশ। অর্থাৎ ব্যাংক খাতের বিতরণ করা ঋণের প্রায় ৩৪ শতাংশই এখন খেলাপি ঋণের আওতায় চলে এসেছে। বাংলাদ&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983593/%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95-%e0%a6%96%e0%a6%be%e0%a6%a4%e0%a7%87-%e0%a6%96%e0%a7%87%e0%a6%b2%e0%a6%be%e0%a6%aa%e0%a6%bf-%e0%a6%8b%e0%a6%a3-%e0%a6%9b%e0%a6%be%e0%a6%a1/">অর্থসূচক</source>
    </item>
    <item>
      <title>সিরিজ বাঁচানোর লড়াইয়ে আজ দক্ষিণ আফ্রিকার মুখোমুখি বাংলাদেশ</title>
      <link>https://www.arthosuchak.com/archives/983591/%e0%a6%b8%e0%a6%bf%e0%a6%b0%e0%a6%bf%e0%a6%9c-%e0%a6%ac%e0%a6%be%e0%a6%81%e0%a6%9a%e0%a6%be%e0%a6%a8%e0%a7%8b%e0%a6%b0-%e0%a6%b2%e0%a6%a1%e0%a6%bc%e0%a6%be%e0%a6%87%e0%a6%af%e0%a6%bc%e0%a7%87-2/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983591/%e0%a6%b8%e0%a6%bf%e0%a6%b0%e0%a6%bf%e0%a6%9c-%e0%a6%ac%e0%a6%be%e0%a6%81%e0%a6%9a%e0%a6%be%e0%a6%a8%e0%a7%8b%e0%a6%b0-%e0%a6%b2%e0%a6%a1%e0%a6%bc%e0%a6%be%e0%a6%87%e0%a6%af%e0%a6%bc%e0%a7%87-2/</guid>
      <pubDate>Mon, 23 Nov 2026 06:45:41 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/08/Austraila-Ban-Test-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/08/Austraila-Ban-Test-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/08/Austraila-Ban-Test-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সিরিজ বাঁচানোর লড়াইয়ে আজ দক্ষিণ আফ্রিকার মুখোমুখি বাংলাদেশ" /&gt;&lt;/p&gt;&lt;p&gt;জোহানেসবার্গে প্রথম টেস্টে বড় ব্যবধানে হারের পর এবার সিরিজ বাঁচানোর চ্যালেঞ্জ নিয়ে মাঠে নামছে বাংলাদেশ। দুই ম্যাচ সিরিজের দ্বিতীয় ও শেষ টেস্টে আজ সোমবার (২৩ নভেম্বর) স্বাগতিক দক্ষিণ আফ্রিকার মুখোমুখি হবে নাজমুল হোসেন শান্তর দল। সেঞ্চুরিয়নের সুপারস্পোর্ট পার্কে বাংলাদেশ সময় দুপুর ২টায় শুরু হবে ম্যাচট&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983591/%e0%a6%b8%e0%a6%bf%e0%a6%b0%e0%a6%bf%e0%a6%9c-%e0%a6%ac%e0%a6%be%e0%a6%81%e0%a6%9a%e0%a6%be%e0%a6%a8%e0%a7%8b%e0%a6%b0-%e0%a6%b2%e0%a6%a1%e0%a6%bc%e0%a6%be%e0%a6%87%e0%a6%af%e0%a6%bc%e0%a7%87-2/">অর্থসূচক</source>

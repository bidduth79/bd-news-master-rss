      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Bosu-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Bosu-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Bosu-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিজ্ঞানী ও কথাসাহিত্যিক পূরবী বসু আর নেই" /&gt;&lt;/p&gt;&lt;p&gt;বিজ্ঞানী, কথাসাহিত্যিক ও প্রাবন্ধিক ড. পূরবী বসু আর নেই। যুক্তরাষ্ট্রের সময় শুক্রবার (১৩ নভেম্বর) দুপুর ১টায় ফ্লোরিডার পোর্ট সেন্ট লুসি শহরে নিজ বাসভবনে ঘুমের মধ্যে তিনি মারা যান। মৃত্যকালে তার বয়স হয়েছিল ৭৭ বছর। ড. পূরবী বসুর ছেলে দীপেন দত্ত মায়ের প্রয়াণের খবর জানিয়ে ফেসবুক পোস্টে এক আবেগঘন বার্তায়&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982192/%e0%a6%ac%e0%a6%bf%e0%a6%9c%e0%a7%8d%e0%a6%9e%e0%a6%be%e0%a6%a8%e0%a7%80-%e0%a6%93-%e0%a6%95%e0%a6%a5%e0%a6%be%e0%a6%b8%e0%a6%be%e0%a6%b9%e0%a6%bf%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a6%bf%e0%a6%95/">অর্থসূচক</source>
    </item>
    <item>
      <title>৩ শিল্পাঞ্চলে ৩৪ প্লাটুন বিজিবি মোতায়েন</title>
      <link>https://www.arthosuchak.com/archives/982184/%e0%a6%a2%e0%a6%be%e0%a6%95%e0%a6%be-%e0%a6%97%e0%a6%be%e0%a6%9c%e0%a7%80%e0%a6%aa%e0%a7%81%e0%a6%b0-%e0%a6%93-%e0%a6%a8%e0%a6%be%e0%a6%b0%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a6%a3%e0%a6%97%e0%a6%9e/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982184/%e0%a6%a2%e0%a6%be%e0%a6%95%e0%a6%be-%e0%a6%97%e0%a6%be%e0%a6%9c%e0%a7%80%e0%a6%aa%e0%a7%81%e0%a6%b0-%e0%a6%93-%e0%a6%a8%e0%a6%be%e0%a6%b0%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a6%a3%e0%a6%97%e0%a6%9e/</guid>
      <pubDate>Sat, 14 Nov 2026 06:02:54 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2024/04/bgb-300x164.png" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2024/04/bgb-300x164.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2024/04/bgb-300x164.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৩ শিল্পাঞ্চলে ৩৪ প্লাটুন বিজিবি মোতায়েন" /&gt;&lt;/p&gt;&lt;p&gt;শিল্পাঞ্চলের সার্বিক নিরাপত্তা নিশ্চিত করা, আইনশৃঙ্খলা পরিস্থিতি স্বাভাবিক রাখা এবং যেকোনো ধরনের অপ্রীতিকর পরিস্থিতি মোকাবিলায় ঢাকা, গাজীপুর ও নারায়ণগঞ্জের বিভিন্ন গুরুত্বপূর্ণ শিল্পাঞ্চলে মোট ৩৪ প্লাটুন বিজিবি মোতায়েন রয়েছে। শনিবার (১৪ নভেম্বর) এক সংবাদ বিজ্ঞপ্তিতে এসব তথ্য জানিয়েছে বিজিবি। বিজিবি &lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982184/%e0%a6%a2%e0%a6%be%e0%a6%95%e0%a6%be-%e0%a6%97%e0%a6%be%e0%a6%9c%e0%a7%80%e0%a6%aa%e0%a7%81%e0%a6%b0-%e0%a6%93-%e0%a6%a8%e0%a6%be%e0%a6%b0%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a6%a3%e0%a6%97%e0%a6%9e/">অর্থসূচক</source>
    </item>
    <item>
      <title>চীনে ঐতিহাসিক বৈঠকে বসছেন ট্রাম্প, পুতিন ও শি</title>
      <link>https://www.arthosuchak.com/archives/982179/%e0%a6%9a%e0%a7%80%e0%a6%a8%e0%a7%87-%e0%a6%90%e0%a6%a4%e0%a6%bf%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%95-%e0%a6%ac%e0%a7%88%e0%a6%a0%e0%a6%95%e0%a7%87-%e0%a6%ac%e0%a6%b8%e0%a6%9b%e0%a7%87/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982179/%e0%a6%9a%e0%a7%80%e0%a6%a8%e0%a7%87-%e0%a6%90%e0%a6%a4%e0%a6%bf%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%95-%e0%a6%ac%e0%a7%88%e0%a6%a0%e0%a6%95%e0%a7%87-%e0%a6%ac%e0%a6%b8%e0%a6%9b%e0%a7%87/</guid>
      <pubDate>Sat, 14 Nov 2026 05:50:16 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Trump-Putin-and-Xi-300x168.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Trump-Putin-and-Xi-300x168.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Trump-Putin-and-Xi-300x168.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চীনে ঐতিহাসিক বৈঠকে বসছেন ট্রাম্প, পুতিন ও শি" /&gt;&lt;/p&gt;&lt;p&gt;বিশ্ব রাজনীতিতে নতুন কূটনৈতিক সমীকরণের ইঙ্গিত দিয়ে ত্রিপাক্ষিক বৈঠকে বসতে যাচ্ছেন যুক্তরাষ্ট্রের প্রেসিডেন্ট ডোনাল্ড ট্রাম্প, রাশিয়ার প্রেসিডেন্ট ভ্লাদিমির পুতিন ও চীনের প্রেসিডেন্ট শি জিনপিং। আগামী ১৯ নভেম্বর চীনের শেনঝেন শহরে এশিয়া-প্যাসিফিক ইকোনমিক কো-অপারেশন (এপিইসি) সম্মেলনের ফাঁকে অনুষ্ঠিত হওয়&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982179/%e0%a6%9a%e0%a7%80%e0%a6%a8%e0%a7%87-%e0%a6%90%e0%a6%a4%e0%a6%bf%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%95-%e0%a6%ac%e0%a7%88%e0%a6%a0%e0%a6%95%e0%a7%87-%e0%a6%ac%e0%a6%b8%e0%a6%9b%e0%a7%87/">অর্থসূচক</source>
    </item>
    <item>
      <title>ফের ঢাকা-টাঙ্গাইল মহাসড়ক অবরোধ</title>
      <link>https://www.arthosuchak.com/archives/982182/%e0%a6%ab%e0%a7%87%e0%a6%b0-%e0%a6%a2%e0%a6%be%e0%a6%95%e0%a6%be-%e0%a6%9f%e0%a6%be%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a6%be%e0%a6%87%e0%a6%b2-%e0%a6%ae%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%a1%e0%a6%bc/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982182/%e0%a6%ab%e0%a7%87%e0%a6%b0-%e0%a6%a2%e0%a6%be%e0%a6%95%e0%a6%be-%e0%a6%9f%e0%a6%be%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a6%be%e0%a6%87%e0%a6%b2-%e0%a6%ae%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%a1%e0%a6%bc/</guid>
      <pubDate>Sat, 14 Nov 2026 05:43:08 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Road-Gazipur-300x168.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Road-Gazipur-300x168.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Road-Gazipur-300x168.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফের ঢাকা-টাঙ্গাইল মহাসড়ক অবরোধ" /&gt;&lt;/p&gt;&lt;p&gt;গাজীপুরের কালিয়াকৈর উপজেলার চন্দ্রা পল্লীবিদ্যুৎ এলাকায় ঢাকা-টাঙ্গাইল মহাসড়ক অবরোধ করে বিক্ষোভ করছেন পোশাকশ্রমিকরা। শনিবার সকাল ৯টার দিকে শুরু হওয়া এ বিক্ষোভে মহাসড়কের দুই পাশে যানবাহন চলাচল বন্ধ হয়ে যায়। এতে ভোগান্তিতে পড়েছেন যাত্রীরা। পুলিশ ও শ্রমিক সূত্রে জানা যায়, সকালে চন্দ্রা পল্লীবিদ্যুৎ এলাক&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982182/%e0%a6%ab%e0%a7%87%e0%a6%b0-%e0%a6%a2%e0%a6%be%e0%a6%95%e0%a6%be-%e0%a6%9f%e0%a6%be%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a6%be%e0%a6%87%e0%a6%b2-%e0%a6%ae%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%a1%e0%a6%bc/">অর্থসূচক</source>
    </item>
    <item>
      <title>গোল্ডেন হারভেস্ট অ্যাগ্রোর প্রথম প্রান্তিক প্রকাশ</title>
      <link>https://www.arthosuchak.com/archives/981892/%e0%a6%97%e0%a7%8b%e0%a6%b2%e0%a7%8d%e0%a6%a1%e0%a7%87%e0%a6%a8-%e0%a6%b9%e0%a6%be%e0%a6%b0%e0%a6%ad%e0%a7%87%e0%a6%b8%e0%a7%8d%e0%a6%9f-%e0%a6%85%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%97%e0%a7%8d%e0%a6%b0/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981892/%e0%a6%97%e0%a7%8b%e0%a6%b2%e0%a7%8d%e0%a6%a1%e0%a7%87%e0%a6%a8-%e0%a6%b9%e0%a6%be%e0%a6%b0%e0%a6%ad%e0%a7%87%e0%a6%b8%e0%a7%8d%e0%a6%9f-%e0%a6%85%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%97%e0%a7%8d%e0%a6%b0/</guid>
      <pubDate>Sat, 14 Nov 2026 05:36:10 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2024/04/Golden-Harvest-AS-MR-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2024/04/Golden-Harvest-AS-MR-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2024/04/Golden-Harvest-AS-MR-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গোল্ডেন হারভেস্ট অ্যাগ্রোর প্রথম প্রান্তিক প্রকাশ" /&gt;&lt;/p&gt;&lt;p&gt;পুঁজিবাজারে তালিকাভুক্ত কোম্পানি গোল্ডেন হারভেস্ট অ্যাগ্রো গত ৩০ সেপ্টেম্বর, ২০২৬ তারিখে সমাপ্ত প্রথম প্রান্তিকের (জুলাই’২৬-সেপ্টেম্বর’২৬) অনিরীক্ষিত আর্থিক প্রতিবেদন প্রকাশ করেছে। বৃহস্পতিবার (১২ নভেম্বর) অনুষ্ঠিত কোম্পানির পরিচালনা পর্ষদের বৈঠকে চলতি হিসাববছরের প্রথম প্রান্তিকের আর্থিক প্রতিবেদন প&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981892/%e0%a6%97%e0%a7%8b%e0%a6%b2%e0%a7%8d%e0%a6%a1%e0%a7%87%e0%a6%a8-%e0%a6%b9%e0%a6%be%e0%a6%b0%e0%a6%ad%e0%a7%87%e0%a6%b8%e0%a7%8d%e0%a6%9f-%e0%a6%85%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%97%e0%a7%8d%e0%a6%b0/">অর্থসূচক</source>

      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Gopalgonj-1-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Gopalgonj-1-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Gopalgonj-1-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টুঙ্গিপাড়া থানায় আগুন দিয়েছে নিষিদ্ধ আ.লীগের নেতাকর্মীরা" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জের টুঙ্গিপাড়া থানা ঘেরাও করে হামলা, ভাঙচুর ও আগুন দিয়েছে নিষিদ্ধ আওয়ামী লীগের নেতাকর্মীরা। মঙ্গলবার (১৭ নভেম্বর) সন্ধ্যা ৭টার দিকে এ ঘটনা ঘটে। জানা গেছে, গত ১০ নভেম্বর ও ১৫ নভেম্বর নিষিদ্ধ সংগঠন  আওয়ামী লীগ, যুবলীগ ও ছাত্রলীগের নাশকতার ঘটনায় বেশ কয়েকজনকে গ্রেপ্তার করে টুঙ্গিপাড়া থানা পুলিশ।&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982859/%e0%a6%9f%e0%a7%81%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a6%bf%e0%a6%aa%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a6%be-%e0%a6%a5%e0%a6%be%e0%a6%a8%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%86%e0%a6%97%e0%a7%81%e0%a6%a8/">অর্থসূচক</source>
    </item>
    <item>
      <title>হাম উপসর্গে আরও ৫ শিশুর মৃত্যু</title>
      <link>https://www.arthosuchak.com/archives/982854/%e0%a6%b9%e0%a6%be%e0%a6%ae-%e0%a6%89%e0%a6%aa%e0%a6%b8%e0%a6%b0%e0%a7%8d%e0%a6%97%e0%a7%87-%e0%a6%86%e0%a6%b0%e0%a6%93-%e0%a7%ab-%e0%a6%b6%e0%a6%bf%e0%a6%b6%e0%a7%81%e0%a6%b0-%e0%a6%ae%e0%a7%83-3/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982854/%e0%a6%b9%e0%a6%be%e0%a6%ae-%e0%a6%89%e0%a6%aa%e0%a6%b8%e0%a6%b0%e0%a7%8d%e0%a6%97%e0%a7%87-%e0%a6%86%e0%a6%b0%e0%a6%93-%e0%a7%ab-%e0%a6%b6%e0%a6%bf%e0%a6%b6%e0%a7%81%e0%a6%b0-%e0%a6%ae%e0%a7%83-3/</guid>
      <pubDate>Tue, 17 Nov 2026 14:22:09 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/04/Ham-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/04/Ham-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/04/Ham-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হাম উপসর্গে আরও ৫ শিশুর মৃত্যু" /&gt;&lt;/p&gt;&lt;p&gt;হামের উপসর্গ নিয়ে দেশে গত ২৪ ঘণ্টায় পাঁচ শিশুর মৃত্যু হয়েছে। এ সময়ে নিশ্চিত হামে কারও মৃত্যু হয়নি। মঙ্গলবার স্বাস্থ্য অধিদপ্তরের দেওয়া এক বার্তায় এ তথ্য জানানো হয়। স্বাস্থ্য অধিদপ্তরের তথ্য অনুযায়ী, চলতি বছরের ১৫ মার্চ থেকে আজ পর্যন্ত হাম ও উপসর্গে এক হাজার ৩২৩ জনের মৃত্যু হয়েছে। এর মধ্যে নিশ্চিত হা&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982854/%e0%a6%b9%e0%a6%be%e0%a6%ae-%e0%a6%89%e0%a6%aa%e0%a6%b8%e0%a6%b0%e0%a7%8d%e0%a6%97%e0%a7%87-%e0%a6%86%e0%a6%b0%e0%a6%93-%e0%a7%ab-%e0%a6%b6%e0%a6%bf%e0%a6%b6%e0%a7%81%e0%a6%b0-%e0%a6%ae%e0%a7%83-3/">অর্থসূচক</source>
    </item>
    <item>
      <title>সম্মিলিত ইসলামী ব্যাংকের ২০তম পর্ষদ সভা অনুষ্ঠিত</title>
      <link>https://www.arthosuchak.com/archives/982850/%e0%a6%b8%e0%a6%ae%e0%a7%8d%e0%a6%ae%e0%a6%bf%e0%a6%b2%e0%a6%bf%e0%a6%a4-%e0%a6%87%e0%a6%b8%e0%a6%b2%e0%a6%be%e0%a6%ae%e0%a7%80-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95%e0%a7%87-28/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982850/%e0%a6%b8%e0%a6%ae%e0%a7%8d%e0%a6%ae%e0%a6%bf%e0%a6%b2%e0%a6%bf%e0%a6%a4-%e0%a6%87%e0%a6%b8%e0%a6%b2%e0%a6%be%e0%a6%ae%e0%a7%80-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95%e0%a7%87-28/</guid>
      <pubDate>Tue, 17 Nov 2026 14:07:43 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/joint-islamic-bank-300x150.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/joint-islamic-bank-300x150.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/joint-islamic-bank-300x150.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সম্মিলিত ইসলামী ব্যাংকের ২০তম পর্ষদ সভা অনুষ্ঠিত" /&gt;&lt;/p&gt;&lt;p&gt;রাষ্ট্র মালিকানাধীন শরিয়াহভিত্তিক সম্মিলিত ইসলামী ব্যাংক পিএলসির পরিচালনা পর্ষদের ২০তম সভা অনুষ্ঠিত হয়েছে। মঙ্গলবার (১৭ নভেম্বর) ব্যাংকটির প্রধান কার্যালয়ের বোর্ডরুমে এ সভা অনুষ্ঠিত হয়। ব্যাংকের পরিচালনা পর্ষদের চেয়ারম্যান কাজি শায়রুল হাসানের সভাপতিত্বে সভায় পরিচালনা পর্ষদের সদস্য লে. কর্নেল (অব.) ম&lt;/p&gt;</description>

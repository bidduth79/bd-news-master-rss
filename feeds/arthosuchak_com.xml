    <item>
      <title>আ.লীগ আমলে জিডিপির প্রবৃদ্ধি বেশি দেখানো হয়েছিল: ড. তিতুমীর</title>
      <link>https://www.arthosuchak.com/archives/982204/%e0%a6%86-%e0%a6%b2%e0%a7%80%e0%a6%97-%e0%a6%86%e0%a6%ae%e0%a6%b2%e0%a7%87-%e0%a6%9c%e0%a6%bf%e0%a6%a1%e0%a6%bf%e0%a6%aa%e0%a6%bf%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%ac%e0%a7%83%e0%a6%a6/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982204/%e0%a6%86-%e0%a6%b2%e0%a7%80%e0%a6%97-%e0%a6%86%e0%a6%ae%e0%a6%b2%e0%a7%87-%e0%a6%9c%e0%a6%bf%e0%a6%a1%e0%a6%bf%e0%a6%aa%e0%a6%bf%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%ac%e0%a7%83%e0%a6%a6/</guid>
      <pubDate>Sat, 14 Nov 2026 14:51:12 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/09/Titumir-300x167.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/09/Titumir-300x167.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/09/Titumir-300x167.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আ.লীগ আমলে জিডিপির প্রবৃদ্ধি বেশি দেখানো হয়েছিল: ড. তিতুমীর" /&gt;&lt;/p&gt;&lt;p&gt;আওয়ামী লীগ সরকারের আমলে পরিকল্পিতভাবে তথ্য-উপাত্তের কারসাজি করে ২০১৪-১৫ অর্থবছরের পর থেকে দেশের মোট দেশজ উৎপাদনের (জিডিপি) প্রবৃদ্ধি ০.৮ থেকে ১.১৩ শতাংশ বেশি দেখানো হয়েছিল। অর্থনীতির সাতটি খাতে এ ধরনের অতিমূল্যায়নের প্রমাণ পেয়েছে জিডিপির হিসাব নিয়ে পরিচালিত ফরেনসিক অডিট। প্রধানমন্ত্রীর অর্থ ও পরিকল্&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982204/%e0%a6%86-%e0%a6%b2%e0%a7%80%e0%a6%97-%e0%a6%86%e0%a6%ae%e0%a6%b2%e0%a7%87-%e0%a6%9c%e0%a6%bf%e0%a6%a1%e0%a6%bf%e0%a6%aa%e0%a6%bf%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%ac%e0%a7%83%e0%a6%a6/">অর্থসূচক</source>
    </item>

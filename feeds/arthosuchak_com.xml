      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Naogaon-Bus-Fire-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Naogaon-Bus-Fire-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কয়েলের আগুন থেকে নওগাঁয় বাসে অগ্নিকাণ্ড, নাশকতা নয়: পুলিশ" /&gt;&lt;/p&gt;&lt;p&gt;নওগাঁ শহরের বাইপাস এলাকার গাবতলী মোড়ে দাঁড়িয়ে থাকা আল বারাকা পরিবহনের দুটি বাসে অগ্নিকাণ্ডের ঘটনা ঘটেছে। সোমবার (৯ নভেম্বর) দিবাগত রাত সাড়ে ১২টার দিকে এ ঘটনা ঘটে। আগুনে বাস দুটির বড় একটি অংশ পুড়ে গেছে। তবে এ ঘটনায় কেউ হতাহত হয়নি। পুলিশের দাবি, কয়েলের আগুন থেকে এ অগ্নিকাণ্ডের সূত্রপাত হতে পারে। এটি ন&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981471/%e0%a6%95%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a6%86%e0%a6%97%e0%a7%81%e0%a6%a8-%e0%a6%a5%e0%a7%87%e0%a6%95%e0%a7%87-%e0%a6%a8%e0%a6%93%e0%a6%97%e0%a6%be%e0%a6%81%e0%a6%af/">অর্থসূচক</source>
    </item>
    <item>
      <title>সূচকের উত্থানে চলছে লেনদেন</title>
      <link>https://www.arthosuchak.com/archives/981470/%e0%a6%b8%e0%a7%82%e0%a6%9a%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%89%e0%a6%a4%e0%a7%8d%e0%a6%a5%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%9a%e0%a6%b2%e0%a6%9b%e0%a7%87-%e0%a6%b2%e0%a7%87%e0%a6%a8%e0%a6%a6-240/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981470/%e0%a6%b8%e0%a7%82%e0%a6%9a%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%89%e0%a6%a4%e0%a7%8d%e0%a6%a5%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%9a%e0%a6%b2%e0%a6%9b%e0%a7%87-%e0%a6%b2%e0%a7%87%e0%a6%a8%e0%a6%a6-240/</guid>
      <pubDate>Tue, 10 Nov 2026 05:09:23 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/MU-10-11-110426-300x182.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/MU-10-11-110426-300x182.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/MU-10-11-110426-300x182.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সূচকের উত্থানে চলছে লেনদেন" /&gt;&lt;/p&gt;&lt;p&gt;সপ্তাহের দ্বিতীয় কার্যদিবস মঙ্গলবার (১০ নভেম্বর) দেশের প্রধান পুঁজিবাজার ঢাকা স্টক এক্সচেঞ্জে (ডিএসই) সূচকের উত্থানে চলছে লেনদেন। এদিন লেনদেনের প্রথম দিকে প্রধান সূচকের পাশাপাশি বেড়েছে ডিএসই-৩০ ও ডিএসই শরিয়াহ সূচক। একই সঙ্গে অধিকাংশ প্রতিষ্ঠানের শেয়ার ও ইউনিটের দর বেড়েছে। মঙ্গলবার বেলা ১১টা ৪ মিনিটে&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981470/%e0%a6%b8%e0%a7%82%e0%a6%9a%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%89%e0%a6%a4%e0%a7%8d%e0%a6%a5%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%9a%e0%a6%b2%e0%a6%9b%e0%a7%87-%e0%a6%b2%e0%a7%87%e0%a6%a8%e0%a6%a6-240/">অর্থসূচক</source>
    </item>

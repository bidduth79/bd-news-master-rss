    </item>
    <item>
      <title>এইচএসসি সাপ্লিমেন্টারি পরীক্ষার ফরম পূরণের সময় বাড়ল</title>
      <link>https://www.arthosuchak.com/archives/982509/%e0%a6%8f%e0%a6%87%e0%a6%9a%e0%a6%8f%e0%a6%b8%e0%a6%b8%e0%a6%bf-%e0%a6%b8%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%b2%e0%a6%bf%e0%a6%ae%e0%a7%87%e0%a6%a8%e0%a7%8d%e0%a6%9f%e0%a6%be%e0%a6%b0%e0%a6%bf-2/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982509/%e0%a6%8f%e0%a6%87%e0%a6%9a%e0%a6%8f%e0%a6%b8%e0%a6%b8%e0%a6%bf-%e0%a6%b8%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%b2%e0%a6%bf%e0%a6%ae%e0%a7%87%e0%a6%a8%e0%a7%8d%e0%a6%9f%e0%a6%be%e0%a6%b0%e0%a6%bf-2/</guid>
      <pubDate>Sun, 15 Nov 2026 13:48:19 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2023/12/Education-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2023/12/Education-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2023/12/Education-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এইচএসসি সাপ্লিমেন্টারি পরীক্ষার ফরম পূরণের সময় বাড়ল" /&gt;&lt;/p&gt;&lt;p&gt;২০২৬ সালের এইচএসসি সাপ্লিমেন্টারি পরীক্ষার ফরম পূরণের সময় তিনদিন বাড়িয়েছে ঢাকা মাধ্যমিক ও উচ্চমাধ্যমিক শিক্ষা বোর্ড। নতুন সিদ্ধান্ত অনুযায়ী, আগামী ১৮ নভেম্বর পর্যন্ত শিক্ষার্থীরা ফরম পূরণ করতে পারবেন। রোববার (১৫ নভেম্বর) বোর্ডের পরীক্ষা নিয়ন্ত্রক অধ্যাপক জেসমিন তাসলিমা বানু স্বাক্ষরিত এক বিজ্ঞপ্তিতে&lt;/p&gt;</description>

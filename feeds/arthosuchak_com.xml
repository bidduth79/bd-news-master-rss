    <item>
      <title>উপসাগরীয় সব দেশের সঙ্গে ইসরায়েলের সম্পর্ক রয়েছে: কাতারের সাবেক প্রধানমন্ত্রী</title>
      <link>https://www.arthosuchak.com/archives/984488/%e0%a6%89%e0%a6%aa%e0%a6%b8%e0%a6%be%e0%a6%97%e0%a6%b0%e0%a7%80%e0%a6%af%e0%a6%bc-%e0%a6%b8%e0%a6%ac-%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%87/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/984488/%e0%a6%89%e0%a6%aa%e0%a6%b8%e0%a6%be%e0%a6%97%e0%a6%b0%e0%a7%80%e0%a6%af%e0%a6%bc-%e0%a6%b8%e0%a6%ac-%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%87/</guid>
      <pubDate>Sat, 28 Nov 2026 15:50:36 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/jassim-al-thani-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/jassim-al-thani-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/jassim-al-thani-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="উপসাগরীয় সব দেশের সঙ্গে ইসরায়েলের সম্পর্ক রয়েছে: কাতারের সাবেক প্রধানমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;পারস্য উপসাগরীয় সব দেশের সঙ্গে ইসরায়েলের নিরাপত্তা সম্পর্ক রয়েছে বলে দাবি করেছেন কাতারের সাবেক প্রধানমন্ত্রী হামাদ বিন জাসিম আল থানি। তাসনিম সংবাদ সংস্থার বরাত দিয়ে পার্সটুডে জানিয়েছে, কাতারের সাবেক প্রধানমন্ত্রী পারস্য উপসাগরীয় দেশগুলোর সঙ্গে ইসরায়েলি সরকারের গোপন ও প্রকাশ্য সম্পর্কের কথা উল্&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/984488/%e0%a6%89%e0%a6%aa%e0%a6%b8%e0%a6%be%e0%a6%97%e0%a6%b0%e0%a7%80%e0%a6%af%e0%a6%bc-%e0%a6%b8%e0%a6%ac-%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%87/">অর্থসূচক</source>
    </item>
    <item>
      <title>টানা তৃতীয় মেয়াদে ইউসিবি ইনভেস্টমেন্টের নেতৃত্বে তানজীম আলমগীর</title>
      <link>https://www.arthosuchak.com/archives/984512/%e0%a6%9f%e0%a6%be%e0%a6%a8%e0%a6%be-%e0%a6%a4%e0%a7%83%e0%a6%a4%e0%a7%80%e0%a6%af%e0%a6%bc-%e0%a6%ae%e0%a7%87%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%a6%e0%a7%87-%e0%a6%87%e0%a6%89%e0%a6%b8%e0%a6%bf/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/984512/%e0%a6%9f%e0%a6%be%e0%a6%a8%e0%a6%be-%e0%a6%a4%e0%a7%83%e0%a6%a4%e0%a7%80%e0%a6%af%e0%a6%bc-%e0%a6%ae%e0%a7%87%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%a6%e0%a7%87-%e0%a6%87%e0%a6%89%e0%a6%b8%e0%a6%bf/</guid>
      <pubDate>Sat, 28 Nov 2026 15:32:15 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/IMG_20261128_213102-234x300.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/IMG_20261128_213102-234x300.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/IMG_20261128_213102-234x300.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টানা তৃতীয় মেয়াদে ইউসিবি ইনভেস্টমেন্টের নেতৃত্বে তানজীম আলমগীর" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ সিকিউরিটিজ অ্যান্ড এক্সচেঞ্জ কমিশনের (বিএসইসি) অনুমোদনক্রমে ইউসিবি ইনভেস্টমেন্ট লিমিটেডের (ইউসিবিআইএল) ব্যবস্থাপনা পরিচালক ও প্রধান নির্বাহী কর্মকর্তা হিসেবে টানা তৃতীয় মেয়াদে পুনর্নিয়োগ পেয়েছেন জনাব তানজীম আলমগীর। নতুন মেয়াদে আরও তিন বছর প্রতিষ্ঠানটির নেতৃত্ব দেবেন তিনি। তানজীম আলমগীর ৯ নভ&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/984512/%e0%a6%9f%e0%a6%be%e0%a6%a8%e0%a6%be-%e0%a6%a4%e0%a7%83%e0%a6%a4%e0%a7%80%e0%a6%af%e0%a6%bc-%e0%a6%ae%e0%a7%87%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%a6%e0%a7%87-%e0%a6%87%e0%a6%89%e0%a6%b8%e0%a6%bf/">অর্থসূচক</source>
    </item>
    <item>
      <title>মূল্যস্ফীতির চাপে শ্রমিকদের বিক্ষোভ ও অসন্তোষ বাড়ছে: অর্থমন্ত্রী</title>
      <link>https://www.arthosuchak.com/archives/984510/%e0%a6%ae%e0%a7%82%e0%a6%b2%e0%a7%8d%e0%a6%af%e0%a6%b8%e0%a7%8d%e0%a6%ab%e0%a7%80%e0%a6%a4%e0%a6%bf%e0%a6%b0-%e0%a6%9a%e0%a6%be%e0%a6%aa%e0%a7%87-%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a6%ae%e0%a6%bf%e0%a6%95/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/984510/%e0%a6%ae%e0%a7%82%e0%a6%b2%e0%a7%8d%e0%a6%af%e0%a6%b8%e0%a7%8d%e0%a6%ab%e0%a7%80%e0%a6%a4%e0%a6%bf%e0%a6%b0-%e0%a6%9a%e0%a6%be%e0%a6%aa%e0%a7%87-%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a6%ae%e0%a6%bf%e0%a6%95/</guid>
      <pubDate>Sat, 28 Nov 2026 14:35:26 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/05/Finance-minister-Amir-Khashru-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/05/Finance-minister-Amir-Khashru-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/05/Finance-minister-Amir-Khashru-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মূল্যস্ফীতির চাপে শ্রমিকদের বিক্ষোভ ও অসন্তোষ বাড়ছে: অর্থমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;দেশে শ্রমিকদের বিক্ষোভ ও অসন্তোষের অন্যতম প্রধান কারণ হিসেবে মূল্যস্ফীতির চাপকে চিহ্নিত করেছেন অর্থমন্ত্রী আমীর খসরু মাহমুদ চৌধুরী। তিনি বলেন, মূল্যস্ফীতির প্রভাব সবচেয়ে বেশি পড়ছে শ্রমজীবী ও কর্মজীবী মানুষের ওপর। শনিবার (২৮ নভেম্বর) রাজধানীর একটি হোটেলে ‘নির্বাচন-পরবর্তী বিএনপির অর্থনৈতিক অবস্থা এবং&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/984510/%e0%a6%ae%e0%a7%82%e0%a6%b2%e0%a7%8d%e0%a6%af%e0%a6%b8%e0%a7%8d%e0%a6%ab%e0%a7%80%e0%a6%a4%e0%a6%bf%e0%a6%b0-%e0%a6%9a%e0%a6%be%e0%a6%aa%e0%a7%87-%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a6%ae%e0%a6%bf%e0%a6%95/">অর্থসূচক</source>
    </item>
    <item>
      <title>এলএনজি আমদানিতে ছয় মাসে ভর্তুকি ৩৪ হাজার কোটি টাকা</title>

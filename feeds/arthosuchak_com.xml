      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2023/12/airport-road-300x181.png" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2023/12/airport-road-300x181.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2023/12/airport-road-300x181.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সড়ক দুর্ঘটনায় ৮২ মাসে ৪৫ হাজারের বেশি প্রাণহানি: আরএসএফ" /&gt;&lt;/p&gt;&lt;p&gt;২০২০ থেকে ২০২৬ সালের অক্টোবর পর্যন্ত বাংলাদেশে সড়ক দুর্ঘটনায় ৪৫ হাজার ২৫২ জন প্রাণ হারিয়েছেন বলে রোড সেফটি ফাউন্ডেশনের (আরএসএফ) এক পরিসংখ্যানে ওঠে এসেছে। সংস্থাটির তথ্যমতে, ২০২০ থেকে ২০২৫ সালের মধ্যে দেশে ৩৮ হাজার ৩৫৭টি সড়ক দুর্ঘটনায় ৪০ হাজার ৬০৫ জনের প্রাণহানি এবং ৬৭ হাজার ৩৬৪ জন আহত হয়েছেন। এছাড়া &lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981906/%e0%a6%b8%e0%a6%a1%e0%a6%bc%e0%a6%95-%e0%a6%a6%e0%a7%81%e0%a6%b0%e0%a7%8d%e0%a6%98%e0%a6%9f%e0%a6%a8%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a7%ae%e0%a7%a8-%e0%a6%ae%e0%a6%be%e0%a6%b8%e0%a7%87-%e0%a7%aa/">অর্থসূচক</source>
    </item>
    <item>
      <title>রাজধানী‌তে ২৪ ঘণ্টায় গ্রেপ্তার ৪৮৪</title>
      <link>https://www.arthosuchak.com/archives/981878/%e0%a6%b0%e0%a6%be%e0%a6%9c%e0%a6%a7%e0%a6%be%e0%a6%a8%e0%a7%80%e0%a6%a4%e0%a7%87-%e0%a7%a8%e0%a7%aa-%e0%a6%98%e0%a6%a3%e0%a7%8d%e0%a6%9f%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%97%e0%a7%8d-2/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981878/%e0%a6%b0%e0%a6%be%e0%a6%9c%e0%a6%a7%e0%a6%be%e0%a6%a8%e0%a7%80%e0%a6%a4%e0%a7%87-%e0%a7%a8%e0%a7%aa-%e0%a6%98%e0%a6%a3%e0%a7%8d%e0%a6%9f%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%97%e0%a7%8d-2/</guid>
      <pubDate>Thu, 12 Nov 2026 06:22:02 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2021/10/Are.-300x167.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2021/10/Are.-300x167.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2021/10/Are.-300x167.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজধানী‌তে ২৪ ঘণ্টায় গ্রেপ্তার ৪৮৪" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর বিভিন্ন থানা এলাকায় অভিযান চালিয়ে গত ২৪ ঘণ্টায় ৪৮৪ জন গ্রেপ্তার করেছে ঢাকা মেট্রোপলিটন পুলিশ। একই সময়ে ৫২টি মামলা দায়ের করা হয়েছে। বৃহস্প‌তিবার (১২ নভেম্বর) ডিএম‌পির ডি‌সি (মি‌ডিয়া) মো. আকতার হো‌সেন জানান, গ্রেপ্তারকৃতদের মধ্যে রমনা বিভাগ ২৯ জন, লালবাগ বিভাগ ৪৯ জন, ওয়ারী বিভাগ ৪০ জন, মতিঝ&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981878/%e0%a6%b0%e0%a6%be%e0%a6%9c%e0%a6%a7%e0%a6%be%e0%a6%a8%e0%a7%80%e0%a6%a4%e0%a7%87-%e0%a7%a8%e0%a7%aa-%e0%a6%98%e0%a6%a3%e0%a7%8d%e0%a6%9f%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%97%e0%a7%8d-2/">অর্থসূচক</source>
    </item>
    <item>
      <title>প্রধানমন্ত্রীর সঙ্গে চীনের ভাইস প্রেসিডেন্টের বৈঠক</title>
      <link>https://www.arthosuchak.com/archives/981875/%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a7%e0%a6%be%e0%a6%a8%e0%a6%ae%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a7%80%e0%a6%b0-%e0%a6%b8%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%87-%e0%a6%9a%e0%a7%80-2/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981875/%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a7%e0%a6%be%e0%a6%a8%e0%a6%ae%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a7%80%e0%a6%b0-%e0%a6%b8%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%87-%e0%a6%9a%e0%a7%80-2/</guid>
      <pubDate>Thu, 12 Nov 2026 05:48:02 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/PM-China-1-300x180.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/PM-China-1-300x180.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/PM-China-1-300x180.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রধানমন্ত্রীর সঙ্গে চীনের ভাইস প্রেসিডেন্টের বৈঠক" /&gt;&lt;/p&gt;&lt;p&gt;প্রধানমন্ত্রী তারেক রহমানের সঙ্গে চীনের ভাইস প্রেসিডেন্ট হান ঝেং-এর দ্বিপক্ষীয় বৈঠক অনুষ্ঠিত হয়েছে। বৈঠকে বাংলাদেশে চীনের বিনিয়োগ, জলবায়ু পরিবর্তনের প্রভাব মোকাবিলাসহ পারস্পরিক স্বার্থসংশ্লিষ্ট বিভিন্ন বিষয় গুরুত্ব পায়। তুরস্কের আনতালিয়ায় জাতিসংঘের জলবায়ু পরিবর্তনবিষয়ক সম্মেলনের (কপ৩১) সাইডলাইনে দুই&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981875/%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a7%e0%a6%be%e0%a6%a8%e0%a6%ae%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a7%80%e0%a6%b0-%e0%a6%b8%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%87-%e0%a6%9a%e0%a7%80-2/">অর্থসূচক</source>
    </item>
    <item>
      <title>সূচকের উত্থানে চলছে ডিএসইর লেনদেন</title>
      <link>https://www.arthosuchak.com/archives/981857/%e0%a6%b8%e0%a7%82%e0%a6%9a%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%89%e0%a6%a4%e0%a7%8d%e0%a6%a5%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%9a%e0%a6%b2%e0%a6%9b%e0%a7%87-%e0%a6%a1%e0%a6%bf%e0%a6%8f%e0%a6%b8-2/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981857/%e0%a6%b8%e0%a7%82%e0%a6%9a%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%89%e0%a6%a4%e0%a7%8d%e0%a6%a5%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%9a%e0%a6%b2%e0%a6%9b%e0%a7%87-%e0%a6%a1%e0%a6%bf%e0%a6%8f%e0%a6%b8-2/</guid>
      <pubDate>Thu, 12 Nov 2026 05:12:28 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/MU-12-11-110426-300x181.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/MU-12-11-110426-300x181.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/MU-12-11-110426-300x181.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সূচকের উত্থানে চলছে ডিএসইর লেনদেন" /&gt;&lt;/p&gt;&lt;p&gt;সপ্তাহের শেষ কার্যদিবস বৃহস্পতিবার (১২ নভেম্বর) দেশের প্রধান পুঁজিবাজার ঢাকা স্টক এক্সচেঞ্জে (ডিএসই) সূচকের ঊর্ধ্বমুখী প্রতিক্রিয়ায় চলছে লেনদেন। এদিন বেলা ১১টা ৪ মিনিটে প্রধান সূচকসহ সবকটি সূচক ছিল ইতিবাচক অবস্থানে। তবে দরবৃদ্ধির তুলনায় দরপতনের তালিকায় কোম্পানির সংখ্যা বেশি ছিল। ডিএসই সূত্রে এসব তথ্&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981857/%e0%a6%b8%e0%a7%82%e0%a6%9a%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%89%e0%a6%a4%e0%a7%8d%e0%a6%a5%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%9a%e0%a6%b2%e0%a6%9b%e0%a7%87-%e0%a6%a1%e0%a6%bf%e0%a6%8f%e0%a6%b8-2/">অর্থসূচক</source>
    </item>
    <item>
      <title>রিয়াদ-দাম্মামের ১৮৯ ফ্লাইট বাতিল</title>
      <link>https://www.arthosuchak.com/archives/981869/%e0%a6%b0%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%a6-%e0%a6%a6%e0%a6%be%e0%a6%ae%e0%a7%8d%e0%a6%ae%e0%a6%be%e0%a6%ae%e0%a7%87%e0%a6%b0-%e0%a7%a7%e0%a7%ae%e0%a7%af-%e0%a6%ab%e0%a7%8d%e0%a6%b2/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981869/%e0%a6%b0%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%a6-%e0%a6%a6%e0%a6%be%e0%a6%ae%e0%a7%8d%e0%a6%ae%e0%a6%be%e0%a6%ae%e0%a7%87%e0%a6%b0-%e0%a7%a7%e0%a7%ae%e0%a7%af-%e0%a6%ab%e0%a7%8d%e0%a6%b2/</guid>
      <pubDate>Thu, 12 Nov 2026 05:10:49 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2024/09/biman-300x165.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2024/09/biman-300x165.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2024/09/biman-300x165.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রিয়াদ-দাম্মামের ১৮৯ ফ্লাইট বাতিল" /&gt;&lt;/p&gt;&lt;p&gt;ঢাকা থেকে সৌদি আরবের রিয়াদ ও দাম্মামের ১৮৯ টি ফ্লাইট বাতিল হয়েছে। এতে ক্ষতিগ্রস্ত যাত্রীর সংখ্যা দাঁড়িয়েছে ২৩ হাজার ২৭৪ জন। বেসামরিক বিমান চলাচল কর্তৃপক্ষ (বেবিচক) সূত্রে জানা গেছে, গত ১০ অক্টোবর থেকে বুধবার (১১ নভেম্বর) পর্যন্ত বাতিল হওয়া ফ্লাইটগুলোর মধ্যে ১১২টি সরাসরি ফ্লাইট এবং ৭৭টি ট্রানজিট ফ্লা&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981869/%e0%a6%b0%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%a6-%e0%a6%a6%e0%a6%be%e0%a6%ae%e0%a7%8d%e0%a6%ae%e0%a6%be%e0%a6%ae%e0%a7%87%e0%a6%b0-%e0%a7%a7%e0%a7%ae%e0%a7%af-%e0%a6%ab%e0%a7%8d%e0%a6%b2/">অর্থসূচক</source>
    </item>

      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/DSE-MU-Index-Rise-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/DSE-MU-Index-Rise-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/DSE-MU-Index-Rise-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সূচকের উত্থানে লেনদেন ৭৫৭ কোটি" /&gt;&lt;/p&gt;&lt;p&gt;সপ্তাহের চতুর্থ কার্যদিবস বুধবার (১১ নভেম্বর) দেশের প্রধান পুঁজিবাজার ঢাকা স্টক এক্সচেঞ্জে (ডিএসই) সূচকের ঊর্ধ্বমুখী প্রতিক্রিয়ায় লেনদেন শেষ হয়েছে। এদিন প্রধান সূচকসহ সবকটি সূচক বেড়েছে। তবে দরবৃদ্ধি ও দরপতনের তালিকায় কাছাকাছি সংখ্যক কোম্পানি ছিল। বুধবার দিন শেষে ডিএসইর প্রধান সূচক ডিএসইএক্স ৮ দশমিক &lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981679/%e0%a6%b8%e0%a7%82%e0%a6%9a%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%89%e0%a6%a4%e0%a7%8d%e0%a6%a5%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%b2%e0%a7%87%e0%a6%a8%e0%a6%a6%e0%a7%87%e0%a6%a8-%e0%a7%ad%e0%a7%ab/">অর্থসূচক</source>
    </item>
    <item>
      <title>৩ জেলায় ৩৩ প্লাটুন বিজিবি মোতায়েন</title>
      <link>https://www.arthosuchak.com/archives/981673/%e0%a7%a9-%e0%a6%9c%e0%a7%87%e0%a6%b2%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a7%a9%e0%a7%a9-%e0%a6%aa%e0%a7%8d%e0%a6%b2%e0%a6%be%e0%a6%9f%e0%a7%81%e0%a6%a8-%e0%a6%ac%e0%a6%bf%e0%a6%9c%e0%a6%bf%e0%a6%ac/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981673/%e0%a7%a9-%e0%a6%9c%e0%a7%87%e0%a6%b2%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a7%a9%e0%a7%a9-%e0%a6%aa%e0%a7%8d%e0%a6%b2%e0%a6%be%e0%a6%9f%e0%a7%81%e0%a6%a8-%e0%a6%ac%e0%a6%bf%e0%a6%9c%e0%a6%bf%e0%a6%ac/</guid>
      <pubDate>Wed, 11 Nov 2026 08:18:07 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2024/04/bgb-300x164.png" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2024/04/bgb-300x164.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2024/04/bgb-300x164.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৩ জেলায় ৩৩ প্লাটুন বিজিবি মোতায়েন" /&gt;&lt;/p&gt;&lt;p&gt;আইনশৃঙ্খলা পরিস্থিতি স্বাভাবিক রাখা, শিল্পাঞ্চলের সার্বিক নিরাপত্তা নিশ্চিত করা এবং যেকোনও ধরনের অপ্রীতিকর পরিস্থিতি মোকাবিলায় ঢাকা, গাজীপুর ও নারায়ণগঞ্জের গুরুত্বপূর্ণ শিল্পাঞ্চল ও কৌশলগত পয়েন্টে ৩৩ প্লাটুন বিজিবি মোতায়েন করা হয়েছে। বুধবার (১১ নভেম্বর) বিজিবির পাঠানো এক সংবাদ বিজ্ঞপ্তিতে এই তথ্যএ&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981673/%e0%a7%a9-%e0%a6%9c%e0%a7%87%e0%a6%b2%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a7%a9%e0%a7%a9-%e0%a6%aa%e0%a7%8d%e0%a6%b2%e0%a6%be%e0%a6%9f%e0%a7%81%e0%a6%a8-%e0%a6%ac%e0%a6%bf%e0%a6%9c%e0%a6%bf%e0%a6%ac/">অর্থসূচক</source>
    </item>
    <item>
      <title>কপ-৩১ সম্মেলনে যোগ দিলেন প্রধানমন্ত্রী তারেক রহমান</title>
      <link>https://www.arthosuchak.com/archives/981670/%e0%a6%95%e0%a6%aa-%e0%a7%a9%e0%a7%a7-%e0%a6%b8%e0%a6%ae%e0%a7%8d%e0%a6%ae%e0%a7%87%e0%a6%b2%e0%a6%a8%e0%a7%87-%e0%a6%af%e0%a7%8b%e0%a6%97-%e0%a6%a6%e0%a6%bf%e0%a6%b2%e0%a7%87%e0%a6%a8-%e0%a6%aa/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981670/%e0%a6%95%e0%a6%aa-%e0%a7%a9%e0%a7%a7-%e0%a6%b8%e0%a6%ae%e0%a7%8d%e0%a6%ae%e0%a7%87%e0%a6%b2%e0%a6%a8%e0%a7%87-%e0%a6%af%e0%a7%8b%e0%a6%97-%e0%a6%a6%e0%a6%bf%e0%a6%b2%e0%a7%87%e0%a6%a8-%e0%a6%aa/</guid>
      <pubDate>Wed, 11 Nov 2026 07:47:27 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/PM-Tarique-Rahman-COP31-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/PM-Tarique-Rahman-COP31-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/PM-Tarique-Rahman-COP31-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কপ-৩১ সম্মেলনে যোগ দিলেন প্রধানমন্ত্রী তারেক রহমান" /&gt;&lt;/p&gt;&lt;p&gt;তুরস্কের আন্তালিয়ায় জাতিসংঘের জলবায়ু পরিবর্তনবিষয়ক সম্মেলন কপ-৩১-এ অংশ নিয়েছেন প্রধানমন্ত্রী তারেক রহমান। বুধবার (১১ নভেম্বর) স্থানীয় সময় সকাল ১০টা ১০ মিনিটে তিনি সম্মেলনস্থলে পৌঁছান। এবারের সম্মেলনে বিশ্বের বিভিন্ন দেশের রাষ্ট্র ও সরকারপ্রধানের পাশাপাশি আন্তর্জাতিক সংস্থার প্রতিনিধিরা অংশ নিচ্ছেন। &lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981670/%e0%a6%95%e0%a6%aa-%e0%a7%a9%e0%a7%a7-%e0%a6%b8%e0%a6%ae%e0%a7%8d%e0%a6%ae%e0%a7%87%e0%a6%b2%e0%a6%a8%e0%a7%87-%e0%a6%af%e0%a7%8b%e0%a6%97-%e0%a6%a6%e0%a6%bf%e0%a6%b2%e0%a7%87%e0%a6%a8-%e0%a6%aa/">অর্থসূচক</source>
    </item>
    <item>
      <title>ইরানের পক্ষ থেকে প্রাণনাশের হুমকি, সামরিক ঘাঁটিতে মার্কিন অর্থমন্ত্রী</title>

      <pubDate>Sun, 15 Nov 2026 14:45:15 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/03/Asaduzzaman-300x180.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/03/Asaduzzaman-300x180.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/03/Asaduzzaman-300x180.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জিয়াউল আহসানকে হাতকড়া ছাড়া ট্রাইব্যুনালে নেওয়া হবে না : আইনমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;আওয়ামী লীগ সরকারের আমলে গুম-খুনের মতো মানবতাবিরোধী অপরাধ মামলার আসামি সাবেক সেনা কর্মকর্তা জিয়াউল আহসানকে আর বিনা হাতকড়ায় আন্তর্জাতিক অপরাধ ট্রাইব্যুনালে নেওয়া হবে না বলে সংসদে জানিয়েছেন আইনমন্ত্রী মো. আসাদুজ্জামান। তিনি বলেন, আদালত অঙ্গনে একজন আসামিকে নিয়ে যাওয়ার সময় যে অনাকাক্সিক্ষত ঘটনা ঘটেছে,&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982522/%e0%a6%9c%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%89%e0%a6%b2-%e0%a6%86%e0%a6%b9%e0%a6%b8%e0%a6%be%e0%a6%a8%e0%a6%95%e0%a7%87-%e0%a6%b9%e0%a6%be%e0%a6%a4%e0%a6%95%e0%a6%a1%e0%a6%bc%e0%a6%be/">অর্থসূচক</source>
    </item>
    <item>
      <title>পুলিশের ঊর্ধ্বতন ৬ কর্মকর্তা বদলি</title>
      <link>https://www.arthosuchak.com/archives/982517/%e0%a6%aa%e0%a7%81%e0%a6%b2%e0%a6%bf%e0%a6%b6%e0%a7%87%e0%a6%b0-%e0%a6%8a%e0%a6%b0%e0%a7%8d%e0%a6%a7%e0%a7%8d%e0%a6%ac%e0%a6%a4%e0%a6%a8-%e0%a7%ac-%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a6%95-3/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982517/%e0%a6%aa%e0%a7%81%e0%a6%b2%e0%a6%bf%e0%a6%b6%e0%a7%87%e0%a6%b0-%e0%a6%8a%e0%a6%b0%e0%a7%8d%e0%a6%a7%e0%a7%8d%e0%a6%ac%e0%a6%a4%e0%a6%a8-%e0%a7%ac-%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a6%95-3/</guid>
      <pubDate>Sun, 15 Nov 2026 14:19:05 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2023/11/Bangladesh-police-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2023/11/Bangladesh-police-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2023/11/Bangladesh-police-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পুলিশের ঊর্ধ্বতন ৬ কর্মকর্তা বদলি" /&gt;&lt;/p&gt;&lt;p&gt;পুলিশের ঊর্ধ্বতন ছয়জন কর্মকর্তাকে বিভিন্ন ইউনিট ও জেলার গুরুত্বপূর্ণ পদে বদলি করেছে সরকার। রোববার (১৫ নভেম্বর) স্বরাষ্ট্র মন্ত্রণালয়ের পুলিশ-১ শাখা থেকে জারি করা দুটি পৃথক প্রজ্ঞাপনে ডিআইজি পদমর্যাদার চারজন কর্মকর্তা এবং দুটি জেলার পুলিশ সুপারের (এসপি) বদলির এ আদেশ দেওয়া হয়। উপসচিব তৌছিফ আহমেদ স্বাক&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982517/%e0%a6%aa%e0%a7%81%e0%a6%b2%e0%a6%bf%e0%a6%b6%e0%a7%87%e0%a6%b0-%e0%a6%8a%e0%a6%b0%e0%a7%8d%e0%a6%a7%e0%a7%8d%e0%a6%ac%e0%a6%a4%e0%a6%a8-%e0%a7%ac-%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a6%95-3/">অর্থসূচক</source>
    </item>
    <item>
      <title>শিক্ষার্থীদের ৩ বিশেষ পরামর্শ প্রধানমন্ত্রীর</title>
      <link>https://www.arthosuchak.com/archives/982514/%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%a5%e0%a7%80%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a7%a9-%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%87%e0%a6%b7-%e0%a6%aa%e0%a6%b0/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982514/%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%a5%e0%a7%80%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a7%a9-%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%87%e0%a6%b7-%e0%a6%aa%e0%a6%b0/</guid>

    <item>
      <title>ডেঙ্গুতে মৃত্যু আরও ২, হাসপাতালে ভর্তি ১৬১৫</title>
      <link>https://www.arthosuchak.com/archives/983167/%e0%a6%a1%e0%a7%87%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%81%e0%a6%a4%e0%a7%87-%e0%a6%ae%e0%a7%83%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a7%81-%e0%a6%86%e0%a6%b0%e0%a6%93-%e0%a7%a8-%e0%a6%b9%e0%a6%be%e0%a6%b8-32/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983167/%e0%a6%a1%e0%a7%87%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%81%e0%a6%a4%e0%a7%87-%e0%a6%ae%e0%a7%83%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a7%81-%e0%a6%86%e0%a6%b0%e0%a6%93-%e0%a7%a8-%e0%a6%b9%e0%a6%be%e0%a6%b8-32/</guid>
      <pubDate>Thu, 19 Nov 2026 11:27:45 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2023/09/Dengu-300x156.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2023/09/Dengu-300x156.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2023/09/Dengu-300x156.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডেঙ্গুতে মৃত্যু আরও ২, হাসপাতালে ভর্তি ১৬১৫" /&gt;&lt;/p&gt;&lt;p&gt;ডেঙ্গুতে দেশে ২৪ ঘণ্টায় আরও দুজনের মৃত্যু হয়েছে। একই সময়ে সারা দেশে নতুন করে এক হাজার ৬১৫ জন ডেঙ্গু রোগী হাসপাতালে ভর্তি হয়েছে। বৃহস্পতিবার (১৯ নভেম্বর) স্বাস্থ্য অধিদপ্তরের হেলথ ইমার্জেন্সি অপারেশন সেন্টার ও কন্ট্রোল রুমের হালনাগাদ সংবাদ বিজ্ঞপ্তিতে এ তথ্য জানানো হয়েছে। স্বাস্থ্য অধিদপ্তরের তথ্য অন&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983167/%e0%a6%a1%e0%a7%87%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%81%e0%a6%a4%e0%a7%87-%e0%a6%ae%e0%a7%83%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a7%81-%e0%a6%86%e0%a6%b0%e0%a6%93-%e0%a7%a8-%e0%a6%b9%e0%a6%be%e0%a6%b8-32/">অর্থসূচক</source>
    </item>
    <item>
      <title>সম্মিলিত ইসলামী ব্যাংকের সাবসিডিয়ারি ইআইআইএলের বার্ষিক সাধারণ সভা অনুষ্ঠিত</title>
      <link>https://www.arthosuchak.com/archives/983164/%e0%a6%b8%e0%a6%ae%e0%a7%8d%e0%a6%ae%e0%a6%bf%e0%a6%b2%e0%a6%bf%e0%a6%a4-%e0%a6%87%e0%a6%b8%e0%a6%b2%e0%a6%be%e0%a6%ae%e0%a7%80-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95%e0%a7%87-29/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983164/%e0%a6%b8%e0%a6%ae%e0%a7%8d%e0%a6%ae%e0%a6%bf%e0%a6%b2%e0%a6%bf%e0%a6%a4-%e0%a6%87%e0%a6%b8%e0%a6%b2%e0%a6%be%e0%a6%ae%e0%a7%80-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95%e0%a7%87-29/</guid>
      <pubDate>Thu, 19 Nov 2026 11:24:55 +0000</pubDate>

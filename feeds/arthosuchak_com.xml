      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Bkash-award-300x169.jpeg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Bkash-award-300x169.jpeg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আন্তর্জাতিক ফ্লেম অ্যাওয়ার্ডসে পাঁচ ক্যাটাগরিতে গোল্ড জিতল বিকাশ" /&gt;&lt;/p&gt;&lt;p&gt;আন্তর্জাতিক পর্যায়ের ‘আরএমএআই ফ্লেম অ্যাওয়ার্ডস এশিয়া ২০২৬’-এ পাঁচটি ক্যাটাগরিতে গোল্ড অ্যাওয়ার্ড অর্জন করেছে দেশের বৃহত্তম মোবাইল আর্থিক সেবাদানকারী প্রতিষ্ঠান বিকাশ। আর্থিক অন্তর্ভুক্তি, ডিজিটাল লেনদেনে সচেতনতা বৃদ্ধি এবং গ্রাহক সম্পৃক্ততায় পরিচালিত তিনটি পৃথক ক্যাম্পেইনের জন্য এ স্বীকৃতি পেয়েছে প&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982835/%e0%a6%86%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a6%b0%e0%a7%8d%e0%a6%9c%e0%a6%be%e0%a6%a4%e0%a6%bf%e0%a6%95-%e0%a6%ab%e0%a7%8d%e0%a6%b2%e0%a7%87%e0%a6%ae-%e0%a6%85%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%93%e0%a6%af/">অর্থসূচক</source>
    </item>
    <item>
      <title>৭ দিনের রিমান্ডে সাঈদ খোকন</title>
      <link>https://www.arthosuchak.com/archives/982833/%e0%a7%ad-%e0%a6%a6%e0%a6%bf%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%b0%e0%a6%bf%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a1%e0%a7%87-%e0%a6%b8%e0%a6%be%e0%a6%88%e0%a6%a6-%e0%a6%96%e0%a7%8b%e0%a6%95/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982833/%e0%a7%ad-%e0%a6%a6%e0%a6%bf%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%b0%e0%a6%bf%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a1%e0%a7%87-%e0%a6%b8%e0%a6%be%e0%a6%88%e0%a6%a6-%e0%a6%96%e0%a7%8b%e0%a6%95/</guid>
      <pubDate>Tue, 17 Nov 2026 12:41:28 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2025/11/Sayed-Khokhon-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2025/11/Sayed-Khokhon-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2025/11/Sayed-Khokhon-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৭ দিনের রিমান্ডে সাঈদ খোকন" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর ধানমন্ডি থানার কিশোর আবদুল মোতালেব হত্যা মামলায় ঢাকা দক্ষিণ সিটি করপোরেশনের (ডিএসসিসি) সাবেক মেয়র সাঈদ খোকনকে জিজ্ঞাসাবাদের জন্য সাত দিনের রিমান্ড দিয়েছে আদালত। তদন্ত কর্মকর্তার আবেদনের পরিপ্রেক্ষিতে মঙ্গলবার (১৭ অক্টোবর) ঢাকার মেট্রোপলিটন ম্যাজিস্ট্রেট মেহেদী হাসানের আদালত রিমান্ডের আদেশ &lt;/p&gt;</description>

    <item>
      <title>মিয়ানমারের নিরাপত্তা বাহিনী ‘হাজার হাজার রোহিঙ্গাকে’ হত্যা করেছে: আন্তর্জাতিক আদালত</title>
      <link>https://www.arthosuchak.com/archives/983159/%e0%a6%ae%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%a8%e0%a6%ae%e0%a6%be%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a6%bf%e0%a6%b0%e0%a6%be%e0%a6%aa%e0%a6%a4%e0%a7%8d%e0%a6%a4%e0%a6%be-%e0%a6%ac%e0%a6%be/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983159/%e0%a6%ae%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%a8%e0%a6%ae%e0%a6%be%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a6%bf%e0%a6%b0%e0%a6%be%e0%a6%aa%e0%a6%a4%e0%a7%8d%e0%a6%a4%e0%a6%be-%e0%a6%ac%e0%a6%be/</guid>
      <pubDate>Thu, 19 Nov 2026 11:06:30 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2024/01/ICJ-2-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2024/01/ICJ-2-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2024/01/ICJ-2-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মিয়ানমারের নিরাপত্তা বাহিনী ‘হাজার হাজার রোহিঙ্গাকে’ হত্যা করেছে: আন্তর্জাতিক আদালত" /&gt;&lt;/p&gt;&lt;p&gt;রাখাইনে ২০১৭ সালের অগাস্টের ক্লিয়ারেন্স অপারেশন বা শুদ্ধি অভিযানের আগের ঘটনাগুলোর কথা উল্লেখ করে বিচারক ইউজি বলেন, আন্তর্জাতিক বিচার আদালত (আইসিজে) নিরাপত্তা চৌকি ও বেসামরিক নাগরিকদের ওপর আরসার হামলা এবং গ্রাম জ্বালিয়ে দেওয়ার বিষয়টি চিহ্নিত করেছে। ইউজি বলেন, সাক্ষ্য-প্রমাণ থেকে এটি প্রতিষ্ঠিত হয়েছে&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983159/%e0%a6%ae%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%a8%e0%a6%ae%e0%a6%be%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a6%bf%e0%a6%b0%e0%a6%be%e0%a6%aa%e0%a6%a4%e0%a7%8d%e0%a6%a4%e0%a6%be-%e0%a6%ac%e0%a6%be/">অর্থসূচক</source>
    </item>
    <item>
      <title>রোহিঙ্গা গণহত্যা মামলায় আইসিজেতে রায় ঘোষণা শুরু</title>
      <link>https://www.arthosuchak.com/archives/983153/%e0%a6%b0%e0%a7%8b%e0%a6%b9%e0%a6%bf%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a6%be-%e0%a6%97%e0%a6%a3%e0%a6%b9%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a6%be-%e0%a6%ae%e0%a6%be%e0%a6%ae%e0%a6%b2%e0%a6%be%e0%a6%af-2/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983153/%e0%a6%b0%e0%a7%8b%e0%a6%b9%e0%a6%bf%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a6%be-%e0%a6%97%e0%a6%a3%e0%a6%b9%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a6%be-%e0%a6%ae%e0%a6%be%e0%a6%ae%e0%a6%b2%e0%a6%be%e0%a6%af-2/</guid>
      <pubDate>Thu, 19 Nov 2026 10:59:34 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/ICJ-300x150.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/ICJ-300x150.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/ICJ-300x150.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রোহিঙ্গা গণহত্যা মামলায় আইসিজেতে রায় ঘোষণা শুরু" /&gt;&lt;/p&gt;&lt;p&gt;মিয়ানমারের নিরাপত্তা বাহিনীর বিরুদ্ধে রোহিঙ্গা মুসলিম জনগোষ্ঠীর ওপর ব্যাপক হত্যাযজ্ঞ, যৌন সহিংসতা ও নির্যাতনের অভিযোগ তুলে ধরেছে আন্তর্জাতিক বিচার আদালত (আইসিজে)। আদালতের বিচারকেরা জানিয়েছেন, মিয়ানমারের নিরাপত্তা বাহিনী হাজারো রোহিঙ্গা বেসামরিক নাগরিককে হত্যা করেছে। বৃহস্পতিবার (১৯ নভেম্বর) রোহিঙ্গা&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983153/%e0%a6%b0%e0%a7%8b%e0%a6%b9%e0%a6%bf%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a6%be-%e0%a6%97%e0%a6%a3%e0%a6%b9%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a6%be-%e0%a6%ae%e0%a6%be%e0%a6%ae%e0%a6%b2%e0%a6%be%e0%a6%af-2/">অর্থসূচক</source>
    </item>

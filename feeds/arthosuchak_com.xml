      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2021/10/BUET-300x170.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2021/10/BUET-300x170.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভর্তি পরীক্ষা পেছাল বুয়েট" /&gt;&lt;/p&gt;&lt;p&gt;হাইকোর্টের নির্দেশের পর বাংলাদেশ প্রকৌশল বিশ্ববিদ্যালয়ের (বুয়েট) ভর্তির পরীক্ষা পেছানোর সিদ্ধান্ত হয়েছে। নতুন সিদ্ধান্ত অনুযায়ী, আগামী বছরের পহেলা ফেব্রুয়ারি ভর্তি পরীক্ষা অনুষ্ঠিত হবে। পরীক্ষাটি আগামী ১৬ জানুয়ারি অনুষ্ঠিত হওয়ার কথা ছিল। কিন্তু বুধবার দেশের সব পাবলিক বিশ্ববিদ্যালয়ের ভর্তি পরীক্ষা আগ&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983034/%e0%a6%ad%e0%a6%b0%e0%a7%8d%e0%a6%a4%e0%a6%bf-%e0%a6%aa%e0%a6%b0%e0%a7%80%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%be-%e0%a6%aa%e0%a7%87%e0%a6%9b%e0%a6%be%e0%a6%b2-%e0%a6%ac%e0%a7%81%e0%a6%af%e0%a6%bc/">অর্থসূচক</source>
    </item>
    <item>
      <title>কয়েক মাসে হাসপাতালে সাড়ে ৩ হাজার শয্যা বাড়ানো হয়েছে: প্রধানমন্ত্রী</title>
      <link>https://www.arthosuchak.com/archives/983020/%e0%a6%95%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%95-%e0%a6%ae%e0%a6%be%e0%a6%b8%e0%a7%87-%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%aa%e0%a6%be%e0%a6%a4%e0%a6%be%e0%a6%b2%e0%a7%87-%e0%a6%b8%e0%a6%be%e0%a6%a1/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983020/%e0%a6%95%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%95-%e0%a6%ae%e0%a6%be%e0%a6%b8%e0%a7%87-%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%aa%e0%a6%be%e0%a6%a4%e0%a6%be%e0%a6%b2%e0%a7%87-%e0%a6%b8%e0%a6%be%e0%a6%a1/</guid>
      <pubDate>Wed, 18 Nov 2026 15:55:22 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/04/Prime-Minister-Tarique-Rahman-@-Perliament-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/04/Prime-Minister-Tarique-Rahman-@-Perliament-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/04/Prime-Minister-Tarique-Rahman-@-Perliament-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কয়েক মাসে হাসপাতালে সাড়ে ৩ হাজার শয্যা বাড়ানো হয়েছে: প্রধানমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;প্রধানমন্ত্রী তারেক রহমান বলেছেন, দেশের স্বাস্থ্যসেবার সক্ষমতা বাড়াতে গত কয়েক মাসে বিভিন্ন হাসপাতালে নতুন করে প্রায় ৩ হাজার ৫০০ শয্যা যুক্ত করা হয়েছে। হাসপাতালগুলোতে শয্যাসংকটের কারণে বিপুলসংখ্যক রোগীকে বারান্দাসহ বিভিন্ন স্থানে মেঝেতে শুয়ে চিকিৎসা নিতে হচ্ছে। পরিসংখ্যান অনুযায়ী, দেশে এ ধরনের রোগীর &lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983020/%e0%a6%95%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%95-%e0%a6%ae%e0%a6%be%e0%a6%b8%e0%a7%87-%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%aa%e0%a6%be%e0%a6%a4%e0%a6%be%e0%a6%b2%e0%a7%87-%e0%a6%b8%e0%a6%be%e0%a6%a1/">অর্থসূচক</source>
    </item>
    <item>
      <title>চুরি হওয়া পুলিশের পিকআপ ভ্যান উদ্ধার</title>
      <link>https://www.arthosuchak.com/archives/983026/%e0%a6%9a%e0%a7%81%e0%a6%b0%e0%a6%bf-%e0%a6%b9%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be-%e0%a6%aa%e0%a7%81%e0%a6%b2%e0%a6%bf%e0%a6%b6%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a6%bf%e0%a6%95%e0%a6%86%e0%a6%aa/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983026/%e0%a6%9a%e0%a7%81%e0%a6%b0%e0%a6%bf-%e0%a6%b9%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be-%e0%a6%aa%e0%a7%81%e0%a6%b2%e0%a6%bf%e0%a6%b6%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a6%bf%e0%a6%95%e0%a6%86%e0%a6%aa/</guid>
      <pubDate>Wed, 18 Nov 2026 15:30:07 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Polic-Car-1-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Polic-Car-1-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Polic-Car-1-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চুরি হওয়া পুলিশের পিকআপ ভ্যান উদ্ধার" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রাম নগরের হালিশহর এলাকা থেকে চুরি হওয়া পুলিশের একটি টহল পিকআপ ভ্যান কর্ণফুলী থেকে উদ্ধার করা হয়েছে। বুধবার (১৮ নভেম্বর) রাতে উপজেলার ফকিরনীর হাট এলাকা থেকে পরিত্যক্ত অবস্থায় ভ্যানটি উদ্ধার করে পুলিশ। পুলিশ জানায়, বুধবার দুপুরে হালিশহর থানার তিন পুলিশ সদস্য একটি পুরোনো সিঙ্গেল ডেকার পিকআপ ভ্যান&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983026/%e0%a6%9a%e0%a7%81%e0%a6%b0%e0%a6%bf-%e0%a6%b9%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be-%e0%a6%aa%e0%a7%81%e0%a6%b2%e0%a6%bf%e0%a6%b6%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a6%bf%e0%a6%95%e0%a6%86%e0%a6%aa/">অর্থসূচক</source>
    </item>
    <item>

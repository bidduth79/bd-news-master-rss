    <item>
      <title>কক্সবাজারে অটোরিকশায় ট্রেনের ধাক্কা, প্রাণ গেল একই পরিবারের চারজনের</title>
      <link>https://www.arthosuchak.com/archives/983250/%e0%a6%95%e0%a6%95%e0%a7%8d%e0%a6%b8%e0%a6%ac%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0%e0%a7%87-%e0%a6%85%e0%a6%9f%e0%a7%8b%e0%a6%b0%e0%a6%bf%e0%a6%95%e0%a6%b6%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%9f%e0%a7%8d/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983250/%e0%a6%95%e0%a6%95%e0%a7%8d%e0%a6%b8%e0%a6%ac%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0%e0%a7%87-%e0%a6%85%e0%a6%9f%e0%a7%8b%e0%a6%b0%e0%a6%bf%e0%a6%95%e0%a6%b6%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%9f%e0%a7%8d/</guid>
      <pubDate>Fri, 20 Nov 2026 13:14:55 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/CNG-Train-Accidet-cox-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/CNG-Train-Accidet-cox-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/CNG-Train-Accidet-cox-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কক্সবাজারে অটোরিকশায় ট্রেনের ধাক্কা, প্রাণ গেল একই পরিবারের চারজনের" /&gt;&lt;/p&gt;&lt;p&gt;কক্সবাজারের রামুতে ট্রেনের ধাক্কায় সিএনজিচালিত অটোরিকশার চার যাত্রী নিহত হয়েছেন। নিহত ব্যক্তিরা সবাই একই পরিবারের সদস্য। তাঁদের মধ্যে দুই শিশুও রয়েছে। শুক্রবার (২০ নভেম্বর) দুপুর ২টা ৫৫ মিনিটের দিকে উপজেলার দক্ষিণ মিঠাছড়ি ইউনিয়নের কাটিরমাথা রেলক্রসিংয়ে এ দুর্ঘটনা ঘটে। নিহতরা হলেন কাইম্যার ঘোনা এলাকা&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983250/%e0%a6%95%e0%a6%95%e0%a7%8d%e0%a6%b8%e0%a6%ac%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0%e0%a7%87-%e0%a6%85%e0%a6%9f%e0%a7%8b%e0%a6%b0%e0%a6%bf%e0%a6%95%e0%a6%b6%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%9f%e0%a7%8d/">অর্থসূচক</source>
    </item>
    <item>
      <title>শিক্ষায় প্রযুক্তির সুবিধা সবার কাছে পৌঁছানোর আহ্বান ইউজিসি চেয়ারম্যানের</title>
      <link>https://www.arthosuchak.com/archives/983235/%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%af%e0%a7%81%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%bf%e0%a6%b0-%e0%a6%b8%e0%a7%81%e0%a6%ac%e0%a6%bf/</link>

    </item>
    <item>
      <title>দরপতনের শীর্ষে ইসলামী ব্যাংক</title>
      <link>https://www.arthosuchak.com/archives/982969/%e0%a6%a6%e0%a6%b0%e0%a6%aa%e0%a6%a4%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%b6%e0%a7%80%e0%a6%b0%e0%a7%8d%e0%a6%b7%e0%a7%87-%e0%a6%87%e0%a6%b8%e0%a6%b2%e0%a6%be%e0%a6%ae%e0%a7%80-%e0%a6%ac%e0%a7%8d-7/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982969/%e0%a6%a6%e0%a6%b0%e0%a6%aa%e0%a6%a4%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%b6%e0%a7%80%e0%a6%b0%e0%a7%8d%e0%a6%b7%e0%a7%87-%e0%a6%87%e0%a6%b8%e0%a6%b2%e0%a6%be%e0%a6%ae%e0%a7%80-%e0%a6%ac%e0%a7%8d-7/</guid>
      <pubDate>Wed, 18 Nov 2026 10:40:43 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/06/Islami-Bank-Bangladesh-Bank-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/06/Islami-Bank-Bangladesh-Bank-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/06/Islami-Bank-Bangladesh-Bank-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দরপতনের শীর্ষে ইসলামী ব্যাংক" /&gt;&lt;/p&gt;&lt;p&gt;সপ্তাহের তৃতীয় কার্যদিবস বুধবার (১৮ নভেম্বর) ঢাকা স্টক এক্সচেঞ্জে (ডিএসই) দরপতনের শীর্ষে উঠে এসেছে ইসলামী ব্যাংক বাংলাদেশ পিএলসি। এদিন কোম্পানিটির শেয়ারদর ৫ দশমিক ৩১ শতাংশ কমেছে। ডিএসই সূত্রে এ তথ্য জানা গেছে। ডিএসইর সর্বশেষ তথ্য অনুযায়ী, দরপতনের দ্বিতীয় স্থানে রয়েছে প্রিমিয়ার লেদার। কোম্পানিটির শেয়&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982969/%e0%a6%a6%e0%a6%b0%e0%a6%aa%e0%a6%a4%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%b6%e0%a7%80%e0%a6%b0%e0%a7%8d%e0%a6%b7%e0%a7%87-%e0%a6%87%e0%a6%b8%e0%a6%b2%e0%a6%be%e0%a6%ae%e0%a7%80-%e0%a6%ac%e0%a7%8d-7/">অর্থসূচক</source>

    <item>
      <title>শেখ হাসিনাকে পাসপোর্ট দেওয়ার সুযোগ নেই: চিফ প্রসিকিউটর</title>
      <link>https://www.arthosuchak.com/archives/981476/%e0%a6%b6%e0%a7%87%e0%a6%96-%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%a8%e0%a6%be%e0%a6%95%e0%a7%87-%e0%a6%aa%e0%a6%be%e0%a6%b8%e0%a6%aa%e0%a7%8b%e0%a6%b0%e0%a7%8d%e0%a6%9f-%e0%a6%a6%e0%a7%87/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981476/%e0%a6%b6%e0%a7%87%e0%a6%96-%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%a8%e0%a6%be%e0%a6%95%e0%a7%87-%e0%a6%aa%e0%a6%be%e0%a6%b8%e0%a6%aa%e0%a7%8b%e0%a6%b0%e0%a7%8d%e0%a6%9f-%e0%a6%a6%e0%a7%87/</guid>
      <pubDate>Tue, 10 Nov 2026 06:48:35 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/04/chief-prosecutor-advocate-md-aminul-islam-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/04/chief-prosecutor-advocate-md-aminul-islam-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/04/chief-prosecutor-advocate-md-aminul-islam-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শেখ হাসিনাকে পাসপোর্ট দেওয়ার সুযোগ নেই: চিফ প্রসিকিউটর" /&gt;&lt;/p&gt;&lt;p&gt;মৃত্যুদণ্ডপ্রাপ্ত সাবেক প্রধানমন্ত্রী শেখ হাসিনাকে নতুন করে পাসপোর্ট দেওয়ার কোনো আইনি সুযোগ নেই বলে জানিয়েছেন আন্তর্জাতিক অপরাধ ট্রাইব্যুনালের চিফ প্রসিকিউটর মোহাম্মদ আমিনুল ইসলাম। তিনি বলেন, শেখ হাসিনা দেশে ফিরলে তার মৃত্যুদণ্ড কার্যকর করা হবে। মঙ্গলবার এক সংবাদ সম্মেলনে এসব কথা বলেন চিফ প্রসিকিউটর&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981476/%e0%a6%b6%e0%a7%87%e0%a6%96-%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%a8%e0%a6%be%e0%a6%95%e0%a7%87-%e0%a6%aa%e0%a6%be%e0%a6%b8%e0%a6%aa%e0%a7%8b%e0%a6%b0%e0%a7%8d%e0%a6%9f-%e0%a6%a6%e0%a7%87/">অর্থসূচক</source>
    </item>
    <item>
      <title>শিল্পাঞ্চলের নিরাপত্তায় তিন জেলায় ৩৬ প্লাটুন বিজিবি মোতায়েন</title>
      <link>https://www.arthosuchak.com/archives/981477/%e0%a6%b6%e0%a6%bf%e0%a6%b2%e0%a7%8d%e0%a6%aa%e0%a6%be%e0%a6%9e%e0%a7%8d%e0%a6%9a%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a6%bf%e0%a6%b0%e0%a6%be%e0%a6%aa%e0%a6%a4%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%af/</link>

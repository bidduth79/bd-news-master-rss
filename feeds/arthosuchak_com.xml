    <item>
      <title>শাশা ডেনিমসের প্রথম প্রান্তিক প্রকাশ</title>
      <link>https://www.arthosuchak.com/archives/981884/%e0%a6%b6%e0%a6%be%e0%a6%b6%e0%a6%be-%e0%a6%a1%e0%a7%87%e0%a6%a8%e0%a6%bf%e0%a6%ae%e0%a6%b8%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a5%e0%a6%ae-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%be-6/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981884/%e0%a6%b6%e0%a6%be%e0%a6%b6%e0%a6%be-%e0%a6%a1%e0%a7%87%e0%a6%a8%e0%a6%bf%e0%a6%ae%e0%a6%b8%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a5%e0%a6%ae-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%be-6/</guid>
      <pubDate>Thu, 12 Nov 2026 17:21:36 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2022/01/Shasha-Denims-e1666853563921-300x200.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2022/01/Shasha-Denims-e1666853563921-300x200.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2022/01/Shasha-Denims-e1666853563921-300x200.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শাশা ডেনিমসের প্রথম প্রান্তিক প্রকাশ" /&gt;&lt;/p&gt;&lt;p&gt;পুঁজিবাজারে তালিকাভুক্ত কোম্পানি শাশা ডেনিমস গত ৩০ সেপ্টেম্বর, ২০২৬ তারিখে সমাপ্ত প্রথম প্রান্তিকের (জুলাই’২৬-সেপ্টেম্বর’২৬) অনিরীক্ষিত আর্থিক প্রতিবেদন প্রকাশ করেছে। বৃহস্পতিবার (১২ নভেম্বর) অনুষ্ঠিত কোম্পানির পরিচালনা পর্ষদের বৈঠকে চলতি হিসাববছরের প্রথম প্রান্তিকের আর্থিক প্রতিবেদন পর্যালোচনা ও অন&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981884/%e0%a6%b6%e0%a6%be%e0%a6%b6%e0%a6%be-%e0%a6%a1%e0%a7%87%e0%a6%a8%e0%a6%bf%e0%a6%ae%e0%a6%b8%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a5%e0%a6%ae-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%be-6/">অর্থসূচক</source>
    </item>

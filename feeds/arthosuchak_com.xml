    <item>
      <title>সব অবৈধ ইটভাটা বন্ধের নির্দেশ হাইকোর্টের</title>
      <link>https://www.arthosuchak.com/archives/981994/%e0%a6%b8%e0%a6%ac-%e0%a6%85%e0%a6%ac%e0%a7%88%e0%a6%a7-%e0%a6%87%e0%a6%9f%e0%a6%ad%e0%a6%be%e0%a6%9f%e0%a6%be-%e0%a6%ac%e0%a6%a8%e0%a7%8d%e0%a6%a7%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a6%bf%e0%a6%b0/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981994/%e0%a6%b8%e0%a6%ac-%e0%a6%85%e0%a6%ac%e0%a7%88%e0%a6%a7-%e0%a6%87%e0%a6%9f%e0%a6%ad%e0%a6%be%e0%a6%9f%e0%a6%be-%e0%a6%ac%e0%a6%a8%e0%a7%8d%e0%a6%a7%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a6%bf%e0%a6%b0/</guid>
      <pubDate>Thu, 12 Nov 2026 09:20:40 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2023/03/brick-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2023/03/brick-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2023/03/brick-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সব অবৈধ ইটভাটা বন্ধের নির্দেশ হাইকোর্টের" /&gt;&lt;/p&gt;&lt;p&gt;সারাদেশে অবৈধভাবে পরিচালিত সব ইটভাটা বন্ধ ও উচ্ছেদে প্রয়োজনীয় পদক্ষেপ নিতে পরিবেশ অধিদফতরের মহাপরিচালক এবং সব বিভাগীয় কমিশনারকে নির্দেশ দিয়েছেন হাইকোর্ট। একই সঙ্গে আদালতের আগের নির্দেশনা বাস্তবায়নে কী পদক্ষেপ নেওয়া হয়েছে, সে বিষয়ে আগামী ১৪ ডিসেম্বরের মধ্যে প্রতিবেদন দাখিল করতে বলা হয়েছে। বৃহস্পতিবার&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981994/%e0%a6%b8%e0%a6%ac-%e0%a6%85%e0%a6%ac%e0%a7%88%e0%a6%a7-%e0%a6%87%e0%a6%9f%e0%a6%ad%e0%a6%be%e0%a6%9f%e0%a6%be-%e0%a6%ac%e0%a6%a8%e0%a7%8d%e0%a6%a7%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a6%bf%e0%a6%b0/">অর্থসূচক</source>
    </item>
    <item>
      <title>প্রাথমিক শিক্ষার গুণগত মানোন্নয়নে সহযোগিতা অব্যাহত রাখবে এডিবি</title>
      <link>https://www.arthosuchak.com/archives/981989/%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%a5%e0%a6%ae%e0%a6%bf%e0%a6%95-%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%be%e0%a6%b0-%e0%a6%97%e0%a7%81%e0%a6%a3%e0%a6%97%e0%a6%a4-%e0%a6%ae/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981989/%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%a5%e0%a6%ae%e0%a6%bf%e0%a6%95-%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%be%e0%a6%b0-%e0%a6%97%e0%a7%81%e0%a6%a3%e0%a6%97%e0%a6%a4-%e0%a6%ae/</guid>
      <pubDate>Thu, 12 Nov 2026 08:51:25 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Adb-Educa-300x180.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Adb-Educa-300x180.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Adb-Educa-300x180.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রাথমিক শিক্ষার গুণগত মানোন্নয়নে সহযোগিতা অব্যাহত রাখবে এডিবি" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশের প্রাথমিক শিক্ষার গুণগত মানোন্নয়ন ও চলমান সংস্কার কার্যক্রমে সহযোগিতা অব্যাহত রাখার পাশাপাশি অপ্রাতিষ্ঠানিক শিক্ষা ও দক্ষতা উন্নয়ন খাতেও সহযোগিতার পরিধি সম্প্রসারণে আগ্রহ প্রকাশ করেছে এশীয় উন্নয়ন ব্যাংক (এডিবি)। বৃহস্পতিবার সচিবালয়ে প্রাথমিক ও গণশিক্ষা প্রতিমন্ত্রী ববি হাজ্জাজের সঙ্গে সৌজন&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981989/%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%a5%e0%a6%ae%e0%a6%bf%e0%a6%95-%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%be%e0%a6%b0-%e0%a6%97%e0%a7%81%e0%a6%a3%e0%a6%97%e0%a6%a4-%e0%a6%ae/">অর্থসূচক</source>
    </item>
    <item>
      <title>সূচকের মিশ্র প্রতিক্রিয়ায় লেনদেন ৬৯৯ কোটি</title>
      <link>https://www.arthosuchak.com/archives/981985/%e0%a6%b8%e0%a7%82%e0%a6%9a%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b0%e0%a6%bf%e0%a6%af-182/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981985/%e0%a6%b8%e0%a7%82%e0%a6%9a%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b0%e0%a6%bf%e0%a6%af-182/</guid>
      <pubDate>Thu, 12 Nov 2026 08:34:10 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/04/Dhaka-Stock-Exchange-Plc-Logo-DSE-ASMU--300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/04/Dhaka-Stock-Exchange-Plc-Logo-DSE-ASMU--300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/04/Dhaka-Stock-Exchange-Plc-Logo-DSE-ASMU--300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সূচকের মিশ্র প্রতিক্রিয়ায় লেনদেন ৬৯৯ কোটি" /&gt;&lt;/p&gt;&lt;p&gt;সপ্তাহের শেষ কার্যদিবস বৃহস্পতিবার (১২ নভেম্বর) দেশের প্রধান পুঁজিবাজার ঢাকা স্টক এক্সচেঞ্জে (ডিএসই) সূচকের মিশ্র প্রতিক্রিয়ায় লেনদেন শেষ হয়েছে। এদিন প্রধান সূচক ডিএসইএক্স ও ডিএসই-৩০ প্রায় অপরিবর্তিত থাকলেও বেড়েছে শরিয়াহ সূচক। অন্যদিকে দরপতন হয়েছে অধিকাংশ কোম্পানির শেয়ারদরের। ডিএসই সূত্রে এ তথ্য জান&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981985/%e0%a6%b8%e0%a7%82%e0%a6%9a%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b0%e0%a6%bf%e0%a6%af-182/">অর্থসূচক</source>
    </item>
    <item>
      <title>বিএনপির দুই পক্ষের সংঘর্ষে গুলিবিদ্ধ ৫</title>
      <link>https://www.arthosuchak.com/archives/981986/%e0%a6%ac%e0%a6%bf%e0%a6%8f%e0%a6%a8%e0%a6%aa%e0%a6%bf%e0%a6%b0-%e0%a6%a6%e0%a7%81%e0%a6%87-%e0%a6%aa%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%82%e0%a6%98%e0%a6%b0%e0%a7%8d/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981986/%e0%a6%ac%e0%a6%bf%e0%a6%8f%e0%a6%a8%e0%a6%aa%e0%a6%bf%e0%a6%b0-%e0%a6%a6%e0%a7%81%e0%a6%87-%e0%a6%aa%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%82%e0%a6%98%e0%a6%b0%e0%a7%8d/</guid>
      <pubDate>Thu, 12 Nov 2026 08:27:20 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Bnp-Munsi-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Bnp-Munsi-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Bnp-Munsi-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিএনপির দুই পক্ষের সংঘর্ষে গুলিবিদ্ধ ৫" /&gt;&lt;/p&gt;&lt;p&gt;আসন্ন ইউনিয়ন পরিষদ নির্বাচনকে কেন্দ্র করে আধিপত্য বিস্তার নিয়ে মুন্সীগঞ্জ সদরের মোল্লাকান্দি ইউনিয়ন বিএনপির দুই পক্ষের মধ্যে হামলা, সংঘর্ষ ও ককটেল বিস্ফোরণের ঘটনা ঘটেছে। বুধবার (১১ নভেম্বর) রাত সাড়ে ১১টা থেকে বৃহস্পতিবার (১২ নভেম্বর) সকাল ৭টা পর্যন্ত চলা এ সংঘর্ষে ৫ জন গুলিবিদ্ধসহ ১০ জন আহত হয়েছে। স&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981986/%e0%a6%ac%e0%a6%bf%e0%a6%8f%e0%a6%a8%e0%a6%aa%e0%a6%bf%e0%a6%b0-%e0%a6%a6%e0%a7%81%e0%a6%87-%e0%a6%aa%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%82%e0%a6%98%e0%a6%b0%e0%a7%8d/">অর্থসূচক</source>
    </item>
    <item>
      <title>ডাক বিভাগের কাভার্ডভ্যানের ধাক্কায় নিহত ৩</title>
      <link>https://www.arthosuchak.com/archives/981958/%e0%a6%a1%e0%a6%be%e0%a6%95-%e0%a6%ac%e0%a6%bf%e0%a6%ad%e0%a6%be%e0%a6%97%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a6%be%e0%a6%ad%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%a1%e0%a6%ad%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%a8/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981958/%e0%a6%a1%e0%a6%be%e0%a6%95-%e0%a6%ac%e0%a6%bf%e0%a6%ad%e0%a6%be%e0%a6%97%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a6%be%e0%a6%ad%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%a1%e0%a6%ad%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%a8/</guid>
      <pubDate>Thu, 12 Nov 2026 07:50:28 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Road-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Road-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Road-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডাক বিভাগের কাভার্ডভ্যানের ধাক্কায় নিহত ৩" /&gt;&lt;/p&gt;&lt;p&gt;হবিগঞ্জের মাধবপুরে ঢাকা-সিলেট মহাসড়কে দাঁড়িয়ে থাকা পাথরবোঝাই একটি ট্রাকের পেছনে বাংলাদেশ ডাক বিভাগের একটি কাভার্ডভ্যানের ধাক্কায় তিন জন নিহত হয়েছেন। নিহত তিন জনই কাভার্ডভ্যানে ছিলেন। বৃহস্পতিবার (১২ নভেম্বর) উপজেলার নোয়াপাড়া এলাকার কাউছারনগরে এ দুর্ঘটনা ঘটে। নিহতরা হলেন- মৌলভীবাজারের কমলগঞ্জ উপজেলার&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981958/%e0%a6%a1%e0%a6%be%e0%a6%95-%e0%a6%ac%e0%a6%bf%e0%a6%ad%e0%a6%be%e0%a6%97%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a6%be%e0%a6%ad%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%a1%e0%a6%ad%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%a8/">অর্থসূচক</source>
    </item>
    <item>
      <title>সড়ক দুর্ঘটনায় ৮২ মাসে ৪৫ হাজারের বেশি প্রাণহানি: আরএসএফ</title>

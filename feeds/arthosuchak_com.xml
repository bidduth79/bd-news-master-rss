    <item>
      <title>এআই খাতে বিক্রির চাপে অ্যানথ্রপিকের শেয়ারদর কমল ৮ শতাংশ</title>
      <link>https://www.arthosuchak.com/archives/983253/%e0%a6%8f%e0%a6%86%e0%a6%87-%e0%a6%96%e0%a6%be%e0%a6%a4%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b0%e0%a6%bf%e0%a6%b0-%e0%a6%9a%e0%a6%be%e0%a6%aa%e0%a7%87-%e0%a6%85%e0%a7%8d%e0%a6%af/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983253/%e0%a6%8f%e0%a6%86%e0%a6%87-%e0%a6%96%e0%a6%be%e0%a6%a4%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b0%e0%a6%bf%e0%a6%b0-%e0%a6%9a%e0%a6%be%e0%a6%aa%e0%a7%87-%e0%a6%85%e0%a7%8d%e0%a6%af/</guid>
      <pubDate>Fri, 20 Nov 2026 16:57:03 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Anthropic-1-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Anthropic-1-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Anthropic-1-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এআই খাতে বিক্রির চাপে অ্যানথ্রপিকের শেয়ারদর কমল ৮ শতাংশ" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাষ্ট্রের পুঁজিবাজারে কৃত্রিম বুদ্ধিমত্তা (এআই) খাতের শেয়ারে দরপতনের প্রভাবে নাসডাকে তালিকাভুক্ত অ্যানথ্রপিকের শেয়ারের দাম কমেছে ৮ শতাংশ। শুক্রবার (২০ নভেম্বর) প্রিমার্কেট লেনদেনে প্রতিষ্ঠানটির শেয়ারের এ দরপতন দেখা যায়। একই সময়ে চিপ নির্মাতা এনভিডিয়া ও এএমডির শেয়ারেও দর কমেছে। সিএনবিসির এক প্রত&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983253/%e0%a6%8f%e0%a6%86%e0%a6%87-%e0%a6%96%e0%a6%be%e0%a6%a4%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b0%e0%a6%bf%e0%a6%b0-%e0%a6%9a%e0%a6%be%e0%a6%aa%e0%a7%87-%e0%a6%85%e0%a7%8d%e0%a6%af/">অর্থসূচক</source>
    </item>
    <item>
      <title>ইউরোপের পুঁজিবাজারে আসছে আইসল্যান্ডের বিখ্যাত পর্যটনকেন্দ্র ব্লু লেগুন</title>
      <link>https://www.arthosuchak.com/archives/983227/%e0%a6%87%e0%a6%89%e0%a6%b0%e0%a7%8b%e0%a6%aa%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%81%e0%a6%81%e0%a6%9c%e0%a6%bf%e0%a6%ac%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0%e0%a7%87-%e0%a6%86%e0%a6%b8%e0%a6%9b%e0%a7%87/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983227/%e0%a6%87%e0%a6%89%e0%a6%b0%e0%a7%8b%e0%a6%aa%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%81%e0%a6%81%e0%a6%9c%e0%a6%bf%e0%a6%ac%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0%e0%a7%87-%e0%a6%86%e0%a6%b8%e0%a6%9b%e0%a7%87/</guid>
      <pubDate>Fri, 20 Nov 2026 16:01:24 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/The-Blue-Lagoon-Resort-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/The-Blue-Lagoon-Resort-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/The-Blue-Lagoon-Resort-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইউরোপের পুঁজিবাজারে আসছে আইসল্যান্ডের বিখ্যাত পর্যটনকেন্দ্র ব্লু লেগুন" /&gt;&lt;/p&gt;&lt;p&gt;কৃত্রিম বুদ্ধিমত্তাভিত্তিক প্রতিষ্ঠান অ্যানথ্রপিকের বড় আইপিও নিয়ে যখন বিশ্বজুড়ে আলোচনা চলছে, তখন ইউরোপের পুঁজিবাজারে আলোচনায় এসেছে আইসল্যান্ডের পর্যটন ও সুস্থতা সেবাদাতা প্রতিষ্ঠান ব্লু লেগুন। শুক্রবার দেশটির নাসডাক আইসল্যান্ডে লেনদেন শুরু করছে প্রতিষ্ঠানটির শেয়ার। আইপিওর মাধ্যমে প্রায় ১১ কোটি ডলার &lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983227/%e0%a6%87%e0%a6%89%e0%a6%b0%e0%a7%8b%e0%a6%aa%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%81%e0%a6%81%e0%a6%9c%e0%a6%bf%e0%a6%ac%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0%e0%a7%87-%e0%a6%86%e0%a6%b8%e0%a6%9b%e0%a7%87/">অর্থসূচক</source>
    </item>
    <item>
      <title>ইউক্রেনকে ন্যাটোর মতো নিরাপত্তা নিশ্চয়তা দিতে আগ্রহী ট্রাম্প: কুশনার</title>
      <link>https://www.arthosuchak.com/archives/983256/%e0%a6%87%e0%a6%89%e0%a6%95%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%a8%e0%a6%95%e0%a7%87-%e0%a6%a8%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%9f%e0%a7%8b%e0%a6%b0-%e0%a6%ae%e0%a6%a4%e0%a7%8b-%e0%a6%a8%e0%a6%bf/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983256/%e0%a6%87%e0%a6%89%e0%a6%95%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%a8%e0%a6%95%e0%a7%87-%e0%a6%a8%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%9f%e0%a7%8b%e0%a6%b0-%e0%a6%ae%e0%a6%a4%e0%a7%8b-%e0%a6%a8%e0%a6%bf/</guid>
      <pubDate>Fri, 20 Nov 2026 15:37:30 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Kushner-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Kushner-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Kushner-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইউক্রেনকে ন্যাটোর মতো নিরাপত্তা নিশ্চয়তা দিতে আগ্রহী ট্রাম্প: কুশনার" /&gt;&lt;/p&gt;&lt;p&gt;যুদ্ধ শেষ হওয়ার পর ইউক্রেনকে ন্যাটোর মতো নিরাপত্তা নিশ্চয়তা দিতে আগ্রহী যুক্তরাষ্ট্রের প্রেসিডেন্ট ডোনাল্ড ট্রাম্প। এ ধরনের নিশ্চয়তার ধারণার বিষয়ে রাশিয়াও স্বস্তিতে রয়েছে বলে দাবি করেছেন মার্কিন বিশেষ দূত জ্যারেড কুশনার। বৃহস্পতিবার (১৯ নভেম্বর) জার্মানির বার্লিনে ইউরোপীয় নেতাদের সঙ্গে এক সংবাদ সম্ম&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983256/%e0%a6%87%e0%a6%89%e0%a6%95%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%a8%e0%a6%95%e0%a7%87-%e0%a6%a8%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%9f%e0%a7%8b%e0%a6%b0-%e0%a6%ae%e0%a6%a4%e0%a7%8b-%e0%a6%a8%e0%a6%bf/">অর্থসূচক</source>
    </item>
    <item>
      <title>প্রযুক্তির সঠিক ব্যবহারে কর্মসংস্থানের নতুন সুযোগ তৈরি হবে: মাহদী আমিন</title>
      <link>https://www.arthosuchak.com/archives/983228/%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%af%e0%a7%81%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%bf%e0%a6%b0-%e0%a6%b8%e0%a6%a0%e0%a6%bf%e0%a6%95-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%ac%e0%a6%b9%e0%a6%be%e0%a6%b0%e0%a7%87/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983228/%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%af%e0%a7%81%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%bf%e0%a6%b0-%e0%a6%b8%e0%a6%a0%e0%a6%bf%e0%a6%95-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%ac%e0%a6%b9%e0%a6%be%e0%a6%b0%e0%a7%87/</guid>
      <pubDate>Fri, 20 Nov 2026 14:17:31 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Mahdi-Amin-1-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Mahdi-Amin-1-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Mahdi-Amin-1-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রযুক্তির সঠিক ব্যবহারে কর্মসংস্থানের নতুন সুযোগ তৈরি হবে: মাহদী আমিন" /&gt;&lt;/p&gt;&lt;p&gt;কৃত্রিম বুদ্ধিমত্তা (এআই), রোবটিক্স ও মেশিন লার্নিংয়ের সঠিক ব্যবহার কর্মসংস্থানের নতুন সুযোগ তৈরি করতে পারে বলে মন্তব্য করেছেন প্রধানমন্ত্রীর উপদেষ্টা ও কার্যালয়ের মুখপাত্র মাহদী আমিন। তিনি বলেছেন, প্রযুক্তির পরিবর্তনকে কাজে লাগিয়ে নতুন উদ্ভাবন, দক্ষতা ও কর্মক্ষেত্র তৈরির সুযোগ রয়েছে। বৃহস্পতিবার চট&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983228/%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%af%e0%a7%81%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%bf%e0%a6%b0-%e0%a6%b8%e0%a6%a0%e0%a6%bf%e0%a6%95-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%ac%e0%a6%b9%e0%a6%be%e0%a6%b0%e0%a7%87/">অর্থসূচক</source>
    </item>
    <item>
      <title>৫ ডিসেম্বর বগুড়া যাচ্ছেন প্রধানমন্ত্রী, উদ্বোধন করবেন নতুন উপজেলা-পৌরসভা-থানা</title>
      <link>https://www.arthosuchak.com/archives/983248/%e0%a7%ab-%e0%a6%a1%e0%a6%bf%e0%a6%b8%e0%a7%87%e0%a6%ae%e0%a7%8d%e0%a6%ac%e0%a6%b0-%e0%a6%ac%e0%a6%97%e0%a7%81%e0%a6%a1%e0%a6%bc%e0%a6%be-%e0%a6%af%e0%a6%be%e0%a6%9a%e0%a7%8d%e0%a6%9b%e0%a7%87/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983248/%e0%a7%ab-%e0%a6%a1%e0%a6%bf%e0%a6%b8%e0%a7%87%e0%a6%ae%e0%a7%8d%e0%a6%ac%e0%a6%b0-%e0%a6%ac%e0%a6%97%e0%a7%81%e0%a6%a1%e0%a6%bc%e0%a6%be-%e0%a6%af%e0%a6%be%e0%a6%9a%e0%a7%8d%e0%a6%9b%e0%a7%87/</guid>
      <pubDate>Fri, 20 Nov 2026 13:44:14 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/08/PM-Tarique-Rahman-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/08/PM-Tarique-Rahman-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/08/PM-Tarique-Rahman-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৫ ডিসেম্বর বগুড়া যাচ্ছেন প্রধানমন্ত্রী, উদ্বোধন করবেন নতুন উপজেলা-পৌরসভা-থানা" /&gt;&lt;/p&gt;&lt;p&gt;আগামী ৫ ডিসেম্বর বগুড়া সফরে যাওয়ার কথা রয়েছে প্রধানমন্ত্রী তারেক রহমানের। সফরকালে জেলার শিবগঞ্জ উপজেলার মোকামতলা হাইস্কুল মাঠে আয়োজিত অনুষ্ঠানে যোগ দেবেন তিনি। এ সময় নবসৃষ্ট মোকামতলা উপজেলা, মডেল পৌরসভা ও থানার কার্যক্রম আনুষ্ঠানিকভাবে উদ্বোধন করবেন প্রধানমন্ত্রী। শুক্রবার (২০ নভেম্বর) সকালে মোকামতল&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983248/%e0%a7%ab-%e0%a6%a1%e0%a6%bf%e0%a6%b8%e0%a7%87%e0%a6%ae%e0%a7%8d%e0%a6%ac%e0%a6%b0-%e0%a6%ac%e0%a6%97%e0%a7%81%e0%a6%a1%e0%a6%bc%e0%a6%be-%e0%a6%af%e0%a6%be%e0%a6%9a%e0%a7%8d%e0%a6%9b%e0%a7%87/">অর্থসূচক</source>
    </item>
    <item>
      <title>সুন্দরবনের রাস উৎসব ঘিরে বন বিভাগের বিশেষ নিরাপত্তাব্যবস্থা</title>
      <link>https://www.arthosuchak.com/archives/983259/%e0%a6%b8%e0%a7%81%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0%e0%a6%ac%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%b0%e0%a6%be%e0%a6%b8-%e0%a6%89%e0%a7%8e%e0%a6%b8%e0%a6%ac-%e0%a6%98%e0%a6%bf%e0%a6%b0%e0%a7%87/</link>

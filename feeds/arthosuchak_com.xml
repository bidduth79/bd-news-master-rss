      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Pm-Kori-300x180.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Pm-Kori-300x180.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিদেশি বিনিয়োগের প্রক্রিয়া সহজ ও গতিশীল করতে কাজ করছে সরকার: প্রধানমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;সরকার বিদেশি বিনিয়োগের প্রক্রিয়া সহজ ও গতিশীল করতে আন্তরিকভাবে কাজ করছে বলে জানিয়েছেন প্রধানমন্ত্রী তারেক রহমান। প্রধানমন্ত্রীর সঙ্গে দক্ষিণ কোরিয়ার এসকে গ্রুপের একটি উচ্চপর্যায়ের প্রতিনিধিদল সৌজন্য সাক্ষাতে গেলে তিনি এ কথা বলেন। আজ সচিবালয়ে প্রধানমন্ত্রীর কার্যালয়ে এ সাক্ষাৎ অনুষ্ঠিত হয়। প্রধানমন্ত&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983716/%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a6%bf-%e0%a6%ac%e0%a6%bf%e0%a6%a8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%8b%e0%a6%97%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%95%e0%a7%8d%e0%a6%b0/">অর্থসূচক</source>
    </item>
    <item>
      <title>২ বিভাগে বজ্রসহ বৃষ্টি হতে পারে</title>
      <link>https://www.arthosuchak.com/archives/983714/%e0%a7%a8-%e0%a6%ac%e0%a6%bf%e0%a6%ad%e0%a6%be%e0%a6%97%e0%a7%87-%e0%a6%ac%e0%a6%9c%e0%a7%8d%e0%a6%b0%e0%a6%b8%e0%a6%b9-%e0%a6%ac%e0%a7%83%e0%a6%b7%e0%a7%8d%e0%a6%9f%e0%a6%bf-%e0%a6%b9%e0%a6%a4-2/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983714/%e0%a7%a8-%e0%a6%ac%e0%a6%bf%e0%a6%ad%e0%a6%be%e0%a6%97%e0%a7%87-%e0%a6%ac%e0%a6%9c%e0%a7%8d%e0%a6%b0%e0%a6%b8%e0%a6%b9-%e0%a6%ac%e0%a7%83%e0%a6%b7%e0%a7%8d%e0%a6%9f%e0%a6%bf-%e0%a6%b9%e0%a6%a4-2/</guid>
      <pubDate>Mon, 23 Nov 2026 14:43:13 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/04/AS-Weather-Update-Rain--300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/04/AS-Weather-Update-Rain--300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/04/AS-Weather-Update-Rain--300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="২ বিভাগে বজ্রসহ বৃষ্টি হতে পারে" /&gt;&lt;/p&gt;&lt;p&gt;মৌসুমের স্বাভাবিক লঘুচাপ দক্ষিণ বঙ্গোপসাগরে অবস্থান করছে ও এর একটি বর্ধিতাংশ উত্তর বঙ্গোপসাগর পর্যন্ত বিস্তৃত রয়েছে। এর প্রভাবে চট্টগ্রাম ও সিলেট বিভাগের দু’এক জায়গায় বৃষ্টি বা বজ্রসহ বৃষ্টি হতে পারে। তবে দেশের অন্যত্র আবহাওয়া প্রধানত শুষ্ক থাকবে। সোমবার (২৩ নভেম্বর) সন্ধ্যা ৬টা থেকে পরবর্তী ১২০ ঘণ্&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983714/%e0%a7%a8-%e0%a6%ac%e0%a6%bf%e0%a6%ad%e0%a6%be%e0%a6%97%e0%a7%87-%e0%a6%ac%e0%a6%9c%e0%a7%8d%e0%a6%b0%e0%a6%b8%e0%a6%b9-%e0%a6%ac%e0%a7%83%e0%a6%b7%e0%a7%8d%e0%a6%9f%e0%a6%bf-%e0%a6%b9%e0%a6%a4-2/">অর্থসূচক</source>

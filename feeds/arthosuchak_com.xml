      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Cop31-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Cop31-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জলবায়ু চুক্তিতে পৌঁছাতে ব্যর্থ কপ-৩১" /&gt;&lt;/p&gt;&lt;p&gt;জীবাশ্ম জ্বালানি বিতর্কের জেরে ভেস্তে যাওয়ার ঝুঁকিতে পড়েছে তুরস্কে অনুষ্ঠিত জলবায়ু সম্মেলন। দেশটির আনতালিয়া শহরে কপ-৩১-এর বিশৃঙ্খল সমাপ্তিতে নির্ধারিত সময়ের ৪৪ ঘণ্টা পর একগুচ্ছ দেশ মূল চুক্তিটি প্রত্যাখ্যান করে। &amp;#8216;আনতালিয়া অ্যাকর্ডস&amp;#8217; নামের যে চুক্তির খসড়া চূড়ান্ত করা হয়েছিল, ইতোমধ্যেই &lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983539/%e0%a6%9c%e0%a6%b2%e0%a6%ac%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a7%81-%e0%a6%9a%e0%a7%81%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%aa%e0%a7%8c%e0%a6%81%e0%a6%9b%e0%a6%be%e0%a6%a4%e0%a7%87/">অর্থসূচক</source>
    </item>
    <item>
      <title>যেসব অঞ্চলে আগামী ২৪ ঘণ্টায় বৃষ্টি হতে পারে</title>
      <link>https://www.arthosuchak.com/archives/983531/%e0%a6%af%e0%a7%87%e0%a6%b8%e0%a6%ac-%e0%a6%85%e0%a6%9e%e0%a7%8d%e0%a6%9a%e0%a6%b2%e0%a7%87-%e0%a6%86%e0%a6%97%e0%a6%be%e0%a6%ae%e0%a7%80-%e0%a7%a8%e0%a7%aa-%e0%a6%98%e0%a6%a3%e0%a7%8d%e0%a6%9f-13/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983531/%e0%a6%af%e0%a7%87%e0%a6%b8%e0%a6%ac-%e0%a6%85%e0%a6%9e%e0%a7%8d%e0%a6%9a%e0%a6%b2%e0%a7%87-%e0%a6%86%e0%a6%97%e0%a6%be%e0%a6%ae%e0%a7%80-%e0%a7%a8%e0%a7%aa-%e0%a6%98%e0%a6%a3%e0%a7%8d%e0%a6%9f-13/</guid>
      <pubDate>Sun, 22 Nov 2026 14:34:22 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/04/AS-Weather-Update-Rain--300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/04/AS-Weather-Update-Rain--300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/04/AS-Weather-Update-Rain--300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যেসব অঞ্চলে আগামী ২৪ ঘণ্টায় বৃষ্টি হতে পারে" /&gt;&lt;/p&gt;&lt;p&gt;মৌসুমের স্বাভাবিক লঘুচাপ দক্ষিণ বঙ্গোপসাগরে অবস্থান করছে ও এর একটি বর্ধিতাংশ উত্তর বঙ্গোপসাগর পর্যন্ত বিস্তৃত রয়েছে। এর প্রভাবে আগামী দুই দিন দেশের কয়েকটি বিভাগের দু’এক জায়গায় হালকা বৃষ্টি বা বজ্রসহ বৃষ্টি হতে পারে। এরপর থেকে সারা দেশে আবহাওয়া প্রধানত শুষ্ক হয়ে দিন ও রাতের তাপমাত্রা কমতে শুরু করবে ব&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983531/%e0%a6%af%e0%a7%87%e0%a6%b8%e0%a6%ac-%e0%a6%85%e0%a6%9e%e0%a7%8d%e0%a6%9a%e0%a6%b2%e0%a7%87-%e0%a6%86%e0%a6%97%e0%a6%be%e0%a6%ae%e0%a7%80-%e0%a7%a8%e0%a7%aa-%e0%a6%98%e0%a6%a3%e0%a7%8d%e0%a6%9f-13/">অর্থসূচক</source>
    </item>
    <item>
      <title>৩১ ডিসেম্বর পর্যন্ত সব ধরনের নোট-গাইড বই মুদ্রণ বন্ধের নির্দেশ</title>
      <link>https://www.arthosuchak.com/archives/983529/%e0%a7%a9%e0%a7%a7-%e0%a6%a1%e0%a6%bf%e0%a6%b8%e0%a7%87%e0%a6%ae%e0%a7%8d%e0%a6%ac%e0%a6%b0-%e0%a6%aa%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%a8%e0%a7%8d%e0%a6%a4-%e0%a6%b8%e0%a6%ac-%e0%a6%a7%e0%a6%b0/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983529/%e0%a7%a9%e0%a7%a7-%e0%a6%a1%e0%a6%bf%e0%a6%b8%e0%a7%87%e0%a6%ae%e0%a7%8d%e0%a6%ac%e0%a6%b0-%e0%a6%aa%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%a8%e0%a7%8d%e0%a6%a4-%e0%a6%b8%e0%a6%ac-%e0%a6%a7%e0%a6%b0/</guid>
      <pubDate>Sun, 22 Nov 2026 14:07:29 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2023/12/nctb-300x171.png" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2023/12/nctb-300x171.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2023/12/nctb-300x171.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৩১ ডিসেম্বর পর্যন্ত সব ধরনের নোট-গাইড বই মুদ্রণ বন্ধের নির্দেশ" /&gt;&lt;/p&gt;&lt;p&gt;আগামী ৩১ ডিসেম্বর পর্যন্ত সব ধরনের নোট, গাইড এবং অনুশীলনমূলক সহায়ক বইয়ের মুদ্রণ ও বাঁধাই কার্যক্রম বন্ধ রাখার নির্দেশ দিয়েছে জাতীয় শিক্ষাক্রম ও পাঠ্যপুস্তক বোর্ড (এনসিটিবি)। সংস্থাটি জানিয়েছে, ২০২৭ শিক্ষাবর্ষের বিনামূল্যের পাঠ্যপুস্তক শিক্ষার্থীদের মধ্যে বিতরণ সম্পন্ন না হওয়া পর্যন্ত এ কার্যক্রম বন্&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983529/%e0%a7%a9%e0%a7%a7-%e0%a6%a1%e0%a6%bf%e0%a6%b8%e0%a7%87%e0%a6%ae%e0%a7%8d%e0%a6%ac%e0%a6%b0-%e0%a6%aa%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%a8%e0%a7%8d%e0%a6%a4-%e0%a6%b8%e0%a6%ac-%e0%a6%a7%e0%a6%b0/">অর্থসূচক</source>
    </item>
    <item>
      <title>এইচএসসির পুনর্মূল্যায়নের ফল প্রকাশ সোমবার</title>
      <link>https://www.arthosuchak.com/archives/983527/%e0%a6%8f%e0%a6%87%e0%a6%9a%e0%a6%8f%e0%a6%b8%e0%a6%b8%e0%a6%bf%e0%a6%b0-%e0%a6%aa%e0%a7%81%e0%a6%a8%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a7%82%e0%a6%b2%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a6%a8/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983527/%e0%a6%8f%e0%a6%87%e0%a6%9a%e0%a6%8f%e0%a6%b8%e0%a6%b8%e0%a6%bf%e0%a6%b0-%e0%a6%aa%e0%a7%81%e0%a6%a8%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a7%82%e0%a6%b2%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a6%a8/</guid>
      <pubDate>Sun, 22 Nov 2026 13:49:29 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2021/01/result-300x171.png" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2021/01/result-300x171.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2021/01/result-300x171.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এইচএসসির পুনর্মূল্যায়নের ফল প্রকাশ সোমবার" /&gt;&lt;/p&gt;&lt;p&gt;এইচএসসি ও সমমান পরীক্ষা ২০২৬-এর পুনর্নিরীক্ষণ ও পুনর্মূল্যায়নের ফল প্রকাশ করা হবে আগামীকাল (২৩ নভেম্বর) বেলা ৩টায়। সংশ্লিষ্ট শিক্ষা বোর্ডগুলোর ওয়েবসাইট এবং কেন্দ্রীয় ফলাফল প্রকাশের ওয়েবসাইটে এ ফল পাওয়া যাবে। রবিবার (২২ নভেম্বর) আন্তঃশিক্ষা বোর্ড পরীক্ষা নিয়ন্ত্রক কমিটির এক বিজ্ঞপ্তিতে এ তথ্য জানানো &lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983527/%e0%a6%8f%e0%a6%87%e0%a6%9a%e0%a6%8f%e0%a6%b8%e0%a6%b8%e0%a6%bf%e0%a6%b0-%e0%a6%aa%e0%a7%81%e0%a6%a8%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a7%82%e0%a6%b2%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a6%a8/">অর্থসূচক</source>
    </item>
    <item>
      <title>পোশাক খাতে ১৮ দিনে ক্ষতি ৪২৮ মিলিয়ন ডলার</title>
      <link>https://www.arthosuchak.com/archives/983525/%e0%a6%aa%e0%a7%8b%e0%a6%b6%e0%a6%be%e0%a6%95-%e0%a6%96%e0%a6%be%e0%a6%a4%e0%a7%87-%e0%a7%a7%e0%a7%ae-%e0%a6%a6%e0%a6%bf%e0%a6%a8%e0%a7%87-%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%a4%e0%a6%bf-%e0%a7%aa/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983525/%e0%a6%aa%e0%a7%8b%e0%a6%b6%e0%a6%be%e0%a6%95-%e0%a6%96%e0%a6%be%e0%a6%a4%e0%a7%87-%e0%a7%a7%e0%a7%ae-%e0%a6%a6%e0%a6%bf%e0%a6%a8%e0%a7%87-%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%a4%e0%a6%bf-%e0%a7%aa/</guid>
      <pubDate>Sun, 22 Nov 2026 13:38:04 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2021/03/germents-300x171.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2021/03/germents-300x171.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2021/03/germents-300x171.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পোশাক খাতে ১৮ দিনে ক্ষতি ৪২৮ মিলিয়ন ডলার" /&gt;&lt;/p&gt;&lt;p&gt;দেশের তৈরি পোশাকশিল্পে অস্থিরতার প্রভাব ক্রমেই গভীর হচ্ছে। উৎপাদন ব্যাহত হওয়ায় একদিকে বিপুল পরিমাণ আর্থিক ক্ষতি হচ্ছে, অন্যদিকে বিদেশি ক্রেতাদের ক্রয়াদেশও হাতছাড়া হচ্ছে। নভেম্বরের প্রথম ১৮ দিনে ৩১৭টি পোশাক কারখানায় উৎপাদন ক্ষতির পরিমাণ দাঁড়িয়েছে ৪২ কোটি ৮০ লাখ মার্কিন ডলার। রোববার (২২ নভেম্বর) বাংলা&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983525/%e0%a6%aa%e0%a7%8b%e0%a6%b6%e0%a6%be%e0%a6%95-%e0%a6%96%e0%a6%be%e0%a6%a4%e0%a7%87-%e0%a7%a7%e0%a7%ae-%e0%a6%a6%e0%a6%bf%e0%a6%a8%e0%a7%87-%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%a4%e0%a6%bf-%e0%a7%aa/">অর্থসূচক</source>
    </item>

    </item>
    <item>
      <title>দেশের সম্পদের সঠিক ব্যবহার নিশ্চিতের দায়িত্ব তরুণ প্রজন্মকেই নিতে হবে: প্রধানমন্ত্রী</title>
      <link>https://www.arthosuchak.com/archives/983031/%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%ae%e0%a7%8d%e0%a6%aa%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%a0%e0%a6%bf%e0%a6%95-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%ac%e0%a6%b9/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983031/%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%ae%e0%a7%8d%e0%a6%aa%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%a0%e0%a6%bf%e0%a6%95-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%ac%e0%a6%b9/</guid>
      <pubDate>Wed, 18 Nov 2026 17:49:32 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/PM-Parla-4-300x180.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/PM-Parla-4-300x180.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/PM-Parla-4-300x180.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দেশের সম্পদের সঠিক ব্যবহার নিশ্চিতের দায়িত্ব তরুণ প্রজন্মকেই নিতে হবে: প্রধানমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;দেশের প্রাকৃতিক সম্পদ ও সম্ভাবনাকে যথাযথভাবে কাজে লাগিয়ে উন্নয়নের ধারা এগিয়ে নিতে তরুণ প্রজন্মের প্রতি আহ্বান জানিয়েছেন প্রধানমন্ত্রী তারেক রহমান। তিনি বলেছেন, ভবিষ্যতে দেশের সম্পদের সঠিক ব্যবহার নিশ্চিত করার দায়িত্ব তরুণ প্রজন্মকেই নিতে হবে। বুধবার জাতীয় সংসদ ভবনে বিভিন্ন শিক্ষাপ্রতিষ্ঠানের শিক্ষার&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983031/%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%ae%e0%a7%8d%e0%a6%aa%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%a0%e0%a6%bf%e0%a6%95-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%ac%e0%a6%b9/">অর্থসূচক</source>
    </item>
    <item>
      <title>হজযাত্রীদের টিকা গ্রহণের কেন্দ্র তালিকা প্রকাশ</title>
      <link>https://www.arthosuchak.com/archives/983022/%e0%a6%b9%e0%a6%9c%e0%a6%af%e0%a6%be%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a7%80%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%9f%e0%a6%bf%e0%a6%95%e0%a6%be-%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%b9%e0%a6%a3%e0%a7%87%e0%a6%b0/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983022/%e0%a6%b9%e0%a6%9c%e0%a6%af%e0%a6%be%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a7%80%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%9f%e0%a6%bf%e0%a6%95%e0%a6%be-%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%b9%e0%a6%a3%e0%a7%87%e0%a6%b0/</guid>
      <pubDate>Wed, 18 Nov 2026 17:08:00 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2022/05/HAJJ-300x166.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2022/05/HAJJ-300x166.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2022/05/HAJJ-300x166.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হজযাত্রীদের টিকা গ্রহণের কেন্দ্র তালিকা প্রকাশ" /&gt;&lt;/p&gt;&lt;p&gt;২০২৭ সালের হজযাত্রীদের মেনিনজাইটিস ও ইনফ্লুয়েঞ্জা টিকা গ্রহণের জন্য দেশের ৯০টি টিকা কেন্দ্রের তালিকা প্রকাশ করেছে ধর্ম বিষয়ক মন্ত্রণালয়। বুধবার (১৮ নভেম্বর) ধর্মবিষয়ক মন্ত্রণালয়ের জনসংযোগ কর্মকর্তা ফরহাদ আহমেদ এসব তথ্য জানান। সৌদি সরকারের নির্দেশনা অনুযায়ী, স্বাস্থ্য পরীক্ষায় উত্তীর্ণ (এফআইটি) হজযাত&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983022/%e0%a6%b9%e0%a6%9c%e0%a6%af%e0%a6%be%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a7%80%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%9f%e0%a6%bf%e0%a6%95%e0%a6%be-%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%b9%e0%a6%a3%e0%a7%87%e0%a6%b0/">অর্থসূচক</source>
    </item>
    <item>
      <title>শ্রেণিকক্ষে শিক্ষক-শিক্ষার্থীদের মোবাইল ব্যবহার নিষিদ্ধ: শিক্ষামন্ত্রী</title>
      <link>https://www.arthosuchak.com/archives/983029/%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%a3%e0%a6%bf%e0%a6%95%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a7%87-%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%95-%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983029/%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%a3%e0%a6%bf%e0%a6%95%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a7%87-%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%95-%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7/</guid>

      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Walton-300x150.jpeg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Walton-300x150.jpeg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Walton-300x150.jpeg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শীতের বাজারে ওয়ালটনের নতুন স্মার্ট গিজার , রুম হিটার ও কেটলি" /&gt;&lt;/p&gt;&lt;p&gt;শীত মৌসুমকে সামনে রেখে আধুনিক প্রযুক্তি ও উন্নত ফিচারসমৃদ্ধ নতুন প্রিমিয়াম মডেলের গিজার, ইলেকট্রিক কেটলি ও রুম হিটার বাজারে এনেছে ওয়ালটন। নতুন পণ্যের তালিকায় রয়েছে ওয়াইফাই ও ভয়েস কমান্ডে পরিচালনাযোগ্য স্মার্ট গিজার, বিভিন্ন ডিজাইনের ইলেকট্রিক কেটলি এবং গরম-ঠান্ডা দুই ধরনের বাতাস সরবরাহে সক্ষম কম্বো &lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983177/%e0%a6%b6%e0%a7%80%e0%a6%a4%e0%a7%87%e0%a6%b0-%e0%a6%ac%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0%e0%a7%87-%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b2%e0%a6%9f%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%a8/">অর্থসূচক</source>
    </item>
    <item>
      <title>পুলিশের ডিআইজিসহ ১৭ কর্মকর্তাকে রদবদল</title>
      <link>https://www.arthosuchak.com/archives/983175/%e0%a6%aa%e0%a7%81%e0%a6%b2%e0%a6%bf%e0%a6%b6%e0%a7%87%e0%a6%b0-%e0%a6%a1%e0%a6%bf%e0%a6%86%e0%a6%87%e0%a6%9c%e0%a6%bf%e0%a6%b8%e0%a6%b9-%e0%a7%a7%e0%a7%ad-%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%ae/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983175/%e0%a6%aa%e0%a7%81%e0%a6%b2%e0%a6%bf%e0%a6%b6%e0%a7%87%e0%a6%b0-%e0%a6%a1%e0%a6%bf%e0%a6%86%e0%a6%87%e0%a6%9c%e0%a6%bf%e0%a6%b8%e0%a6%b9-%e0%a7%a7%e0%a7%ad-%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%ae/</guid>
      <pubDate>Thu, 19 Nov 2026 11:54:49 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2023/11/Bangladesh-police-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2023/11/Bangladesh-police-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2023/11/Bangladesh-police-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পুলিশের ডিআইজিসহ ১৭ কর্মকর্তাকে রদবদল" /&gt;&lt;/p&gt;&lt;p&gt;পুলিশের উপ-মহাপুলিশ পরিদর্শক (ডিআইজি), অতিরিক্ত ডিআইজি ও পুলিশ সুপার পদমর্যাদার ১৭ কর্মকর্তাকে রদবদল করা হয়েছে। বৃহস্পতিবার (১৯ নভেম্বর) স্বরাষ্ট্র মন্ত্রণালয়ের পৃথক প্রজ্ঞাপনে এ তথ্য জানানো হয়। প্রজ্ঞাপন অনুযায়ী, ঢাকা মহানগর পুলিশের (ডিএমপি) অতিরিক্ত পুলিশ কমিশনার (ডিআইজি) মোহাম্মদ ওসমান গণিকে রংপু&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983175/%e0%a6%aa%e0%a7%81%e0%a6%b2%e0%a6%bf%e0%a6%b6%e0%a7%87%e0%a6%b0-%e0%a6%a1%e0%a6%bf%e0%a6%86%e0%a6%87%e0%a6%9c%e0%a6%bf%e0%a6%b8%e0%a6%b9-%e0%a7%a7%e0%a7%ad-%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%ae/">অর্থসূচক</source>
    </item>
    <item>
      <title>ডেরিভেটিভস বাজার চালু ঐতিহাসিক মুহূর্ত, তবে সফলতা সময়সাপেক্ষ: মাসুদ খান</title>
      <link>https://www.arthosuchak.com/archives/983171/%e0%a6%a1%e0%a7%87%e0%a6%b0%e0%a6%bf%e0%a6%ad%e0%a7%87%e0%a6%9f%e0%a6%bf%e0%a6%ad%e0%a6%b8-%e0%a6%ac%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0-%e0%a6%9a%e0%a6%be%e0%a6%b2%e0%a7%81-%e0%a6%90%e0%a6%a4/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983171/%e0%a6%a1%e0%a7%87%e0%a6%b0%e0%a6%bf%e0%a6%ad%e0%a7%87%e0%a6%9f%e0%a6%bf%e0%a6%ad%e0%a6%b8-%e0%a6%ac%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0-%e0%a6%9a%e0%a6%be%e0%a6%b2%e0%a7%81-%e0%a6%90%e0%a6%a4/</guid>
      <pubDate>Thu, 19 Nov 2026 11:50:56 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/BSEC-CHAIRMAN-CSE-CDE-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/BSEC-CHAIRMAN-CSE-CDE-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/BSEC-CHAIRMAN-CSE-CDE-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডেরিভেটিভস বাজার চালু ঐতিহাসিক মুহূর্ত, তবে সফলতা সময়সাপেক্ষ: মাসুদ খান" /&gt;&lt;/p&gt;&lt;p&gt;দেশের পুঁজিবাজারে ডেরিভেটিভস লেনদেন চালুর উদ্যোগকে ঐতিহাসিক মুহূর্ত হিসেবে উল্লেখ করেছেন বাংলাদেশ সিকিউরিটিজ অ্যান্ড এক্সচেঞ্জ কমিশনের (বিএসইসি) চেয়ারম্যান মাসুদ খান। তবে এই বাজার চালু হলেই দ্রুত বড় ধরনের লেনদেন শুরু হবে না উল্লেখ করে তিনি বলেছেন, ডেরিভেটিভস বাজারের সফলতা নির্ভর করবে দীর্ঘমেয়াদি পরি&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983171/%e0%a6%a1%e0%a7%87%e0%a6%b0%e0%a6%bf%e0%a6%ad%e0%a7%87%e0%a6%9f%e0%a6%bf%e0%a6%ad%e0%a6%b8-%e0%a6%ac%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0-%e0%a6%9a%e0%a6%be%e0%a6%b2%e0%a7%81-%e0%a6%90%e0%a6%a4/">অর্থসূচক</source>
    </item>
    <item>
      <title>ডেঙ্গুতে মৃত্যু আরও ২, হাসপাতালে ভর্তি ১৬১৫</title>
      <link>https://www.arthosuchak.com/archives/983167/%e0%a6%a1%e0%a7%87%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%81%e0%a6%a4%e0%a7%87-%e0%a6%ae%e0%a7%83%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a7%81-%e0%a6%86%e0%a6%b0%e0%a6%93-%e0%a7%a8-%e0%a6%b9%e0%a6%be%e0%a6%b8-32/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983167/%e0%a6%a1%e0%a7%87%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%81%e0%a6%a4%e0%a7%87-%e0%a6%ae%e0%a7%83%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a7%81-%e0%a6%86%e0%a6%b0%e0%a6%93-%e0%a7%a8-%e0%a6%b9%e0%a6%be%e0%a6%b8-32/</guid>
      <pubDate>Thu, 19 Nov 2026 11:27:45 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2023/09/Dengu-300x156.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2023/09/Dengu-300x156.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2023/09/Dengu-300x156.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডেঙ্গুতে মৃত্যু আরও ২, হাসপাতালে ভর্তি ১৬১৫" /&gt;&lt;/p&gt;&lt;p&gt;ডেঙ্গুতে দেশে ২৪ ঘণ্টায় আরও দুজনের মৃত্যু হয়েছে। একই সময়ে সারা দেশে নতুন করে এক হাজার ৬১৫ জন ডেঙ্গু রোগী হাসপাতালে ভর্তি হয়েছে। বৃহস্পতিবার (১৯ নভেম্বর) স্বাস্থ্য অধিদপ্তরের হেলথ ইমার্জেন্সি অপারেশন সেন্টার ও কন্ট্রোল রুমের হালনাগাদ সংবাদ বিজ্ঞপ্তিতে এ তথ্য জানানো হয়েছে। স্বাস্থ্য অধিদপ্তরের তথ্য অন&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983167/%e0%a6%a1%e0%a7%87%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%81%e0%a6%a4%e0%a7%87-%e0%a6%ae%e0%a7%83%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a7%81-%e0%a6%86%e0%a6%b0%e0%a6%93-%e0%a7%a8-%e0%a6%b9%e0%a6%be%e0%a6%b8-32/">অর্থসূচক</source>
    </item>
    <item>
      <title>সম্মিলিত ইসলামী ব্যাংকের সাবসিডিয়ারি ইআইআইএলের বার্ষিক সাধারণ সভা অনুষ্ঠিত</title>
      <link>https://www.arthosuchak.com/archives/983164/%e0%a6%b8%e0%a6%ae%e0%a7%8d%e0%a6%ae%e0%a6%bf%e0%a6%b2%e0%a6%bf%e0%a6%a4-%e0%a6%87%e0%a6%b8%e0%a6%b2%e0%a6%be%e0%a6%ae%e0%a7%80-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95%e0%a7%87-29/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983164/%e0%a6%b8%e0%a6%ae%e0%a7%8d%e0%a6%ae%e0%a6%bf%e0%a6%b2%e0%a6%bf%e0%a6%a4-%e0%a6%87%e0%a6%b8%e0%a6%b2%e0%a6%be%e0%a6%ae%e0%a7%80-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95%e0%a7%87-29/</guid>

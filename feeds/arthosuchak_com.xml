    <item>
      <title>সংসদে বিশেষ সৌরবিদ্যুৎ স্থাপন বিল-২০২৬ পাস</title>
      <link>https://www.arthosuchak.com/archives/983018/%e0%a6%b8%e0%a6%82%e0%a6%b8%e0%a6%a6%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%87%e0%a6%b7-%e0%a6%b8%e0%a7%8c%e0%a6%b0%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a7%81%e0%a7%8e-%e0%a6%b8/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983018/%e0%a6%b8%e0%a6%82%e0%a6%b8%e0%a6%a6%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%87%e0%a6%b7-%e0%a6%b8%e0%a7%8c%e0%a6%b0%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a7%81%e0%a7%8e-%e0%a6%b8/</guid>

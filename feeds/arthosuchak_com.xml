    <item>
      <title>কেএফসির ৫০তম আউটলেট এখন বসুন্ধরায়</title>
      <link>https://www.arthosuchak.com/archives/984435/%e0%a6%95%e0%a7%87%e0%a6%8f%e0%a6%ab%e0%a6%b8%e0%a6%bf%e0%a6%b0-%e0%a7%ab%e0%a7%a6%e0%a6%a4%e0%a6%ae-%e0%a6%86%e0%a6%89%e0%a6%9f%e0%a6%b2%e0%a7%87%e0%a6%9f-%e0%a6%8f%e0%a6%96%e0%a6%a8-%e0%a6%ac/</link>

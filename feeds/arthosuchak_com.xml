    <item>
      <title>অর্থনৈতিক চ্যালেঞ্জ মোকাবেলায় স্থিতিশীলতা ও আস্থায় জোর রাষ্ট্রপতির</title>
      <link>https://www.arthosuchak.com/archives/984442/%e0%a6%85%e0%a6%b0%e0%a7%8d%e0%a6%a5%e0%a6%a8%e0%a7%88%e0%a6%a4%e0%a6%bf%e0%a6%95-%e0%a6%9a%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%b2%e0%a7%87%e0%a6%9e%e0%a7%8d%e0%a6%9c-%e0%a6%ae%e0%a7%8b%e0%a6%95-2/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/984442/%e0%a6%85%e0%a6%b0%e0%a7%8d%e0%a6%a5%e0%a6%a8%e0%a7%88%e0%a6%a4%e0%a6%bf%e0%a6%95-%e0%a6%9a%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%b2%e0%a7%87%e0%a6%9e%e0%a7%8d%e0%a6%9c-%e0%a6%ae%e0%a7%8b%e0%a6%95-2/</guid>

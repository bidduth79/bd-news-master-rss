    <item>
      <title>সাধারণ মানুষের কাছে স্বাস্থ্যসেবার সুফল পৌঁছাচ্ছে না: রাষ্ট্রপতি</title>
      <link>https://www.arthosuchak.com/archives/982137/%e0%a6%b8%e0%a6%be%e0%a6%a7%e0%a6%be%e0%a6%b0%e0%a6%a3-%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a7%81%e0%a6%b7%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a6%be%e0%a6%9b%e0%a7%87-%e0%a6%b8%e0%a7%8d%e0%a6%ac%e0%a6%be/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982137/%e0%a6%b8%e0%a6%be%e0%a6%a7%e0%a6%be%e0%a6%b0%e0%a6%a3-%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a7%81%e0%a6%b7%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a6%be%e0%a6%9b%e0%a7%87-%e0%a6%b8%e0%a7%8d%e0%a6%ac%e0%a6%be/</guid>

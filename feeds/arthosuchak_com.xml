      <pubDate>Fri, 20 Nov 2026 06:17:12 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Akvan-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Akvan-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Akvan-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দুর্বল হয়ে অন্ধ্র-ওড়িশা উপকূলে আঘাত হানছে ঘূর্ণিঝড় ‘আকভান’" /&gt;&lt;/p&gt;&lt;p&gt;টানা কয়েক দিন সাগরে অবস্থান করে শক্তি সঞ্চয় করছিল ঘূর্ণিঝড় ‘আকভান’। একপর্যায়ে ঘণ্টায় ১১৭ কিলোমিটার বেগের বাতাস নিয়ে প্রবল ঘূর্ণিঝড়ে রূপ নেয় এটি। তবে ভারতের অন্ধ্র-ওড়িশা উপকূলে আঘাত হানার আগে দুর্বল হয়ে পড়েছে ঘূর্ণিঝড়টি। শুক্রবার (২০ নভেম্বর) দুর্বল অবস্থায় উপকূল অতিক্রম করতে শুরু করেছে ‘আকভান’। ভারত&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983208/%e0%a6%a6%e0%a7%81%e0%a6%b0%e0%a7%8d%e0%a6%ac%e0%a6%b2-%e0%a6%b9%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%85%e0%a6%a8%e0%a7%8d%e0%a6%a7%e0%a7%8d%e0%a6%b0-%e0%a6%93%e0%a6%a1%e0%a6%bc%e0%a6%bf%e0%a6%b6/">অর্থসূচক</source>
    </item>
    <item>
      <title>শিক্ষার্থীদের নিরাপত্তায় ক্লাস-পরীক্ষা বন্ধ করল গোবিপ্রবি</title>
      <link>https://www.arthosuchak.com/archives/983205/%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%a5%e0%a7%80%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a6%bf%e0%a6%b0%e0%a6%be%e0%a6%aa%e0%a6%a4%e0%a7%8d%e0%a6%a4%e0%a6%be/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983205/%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%a5%e0%a7%80%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a6%bf%e0%a6%b0%e0%a6%be%e0%a6%aa%e0%a6%a4%e0%a7%8d%e0%a6%a4%e0%a6%be/</guid>
      <pubDate>Fri, 20 Nov 2026 05:48:57 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Gopalganj-Science-And-Technology-Universty-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Gopalganj-Science-And-Technology-Universty-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Gopalganj-Science-And-Technology-Universty-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শিক্ষার্থীদের নিরাপত্তায় ক্লাস-পরীক্ষা বন্ধ করল গোবিপ্রবি" /&gt;&lt;/p&gt;&lt;p&gt;ক্যাম্পাসের সার্বিক পরিস্থিতি ও শিক্ষার্থীদের নিরাপত্তার কথা বিবেচনায় নিয়ে অনির্দিষ্টকালের জন্য সব ধরনের ক্লাস ও পরীক্ষা বন্ধ ঘোষণা করেছে গোপালগঞ্জ বিজ্ঞান ও প্রযুক্তি বিশ্ববিদ্যালয় (গোবিপ্রবি)। আগামী ২২ নভেম্বর থেকে এ সিদ্ধান্ত কার্যকর হবে। বৃহস্পতিবার (১৯ নভেম্বর) বিশ্ববিদ্যালয়ের ভারপ্রাপ্ত রেজিস্&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983205/%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%a5%e0%a7%80%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a6%bf%e0%a6%b0%e0%a6%be%e0%a6%aa%e0%a6%a4%e0%a7%8d%e0%a6%a4%e0%a6%be/">অর্থসূচক</source>
    </item>
    <item>
      <title>দেশের বাজারে ফের সোনা-রুপার দামে বড় পতন</title>
      <link>https://www.arthosuchak.com/archives/983203/%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%87%e0%a6%b0-%e0%a6%ac%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0%e0%a7%87-%e0%a6%ab%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a7%8b%e0%a6%a8%e0%a6%be-%e0%a6%b0%e0%a7%81%e0%a6%aa/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983203/%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%87%e0%a6%b0-%e0%a6%ac%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0%e0%a7%87-%e0%a6%ab%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a7%8b%e0%a6%a8%e0%a6%be-%e0%a6%b0%e0%a7%81%e0%a6%aa/</guid>
      <pubDate>Fri, 20 Nov 2026 04:56:02 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2024/11/Gold-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2024/11/Gold-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2024/11/Gold-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দেশের বাজারে ফের সোনা-রুপার দামে বড় পতন" /&gt;&lt;/p&gt;&lt;p&gt;স্থানীয় বাজারে তেজাবি সোনার (পাকা সোনা) দাম কমার পরিপ্রেক্ষিতে দেশের বাজারে আবারও কমানো হয়েছে সোনা ও রুপার দাম। এর মধ্যে সবচেয়ে ভালো মানের ২২ ক্যারেটের প্রতি ভরি সোনার দাম কমেছে ১০ হাজার ৯৬৫ টাকা। শুক্রবার (২০ নভেম্বর) সকাল ১০টা থেকে নতুন এ দাম কার্যকর হয়েছে। শুক্রবার সকালে বাংলাদেশ জুয়েলার্স অ্যাসো&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983203/%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%87%e0%a6%b0-%e0%a6%ac%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0%e0%a7%87-%e0%a6%ab%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a7%8b%e0%a6%a8%e0%a6%be-%e0%a6%b0%e0%a7%81%e0%a6%aa/">অর্থসূচক</source>
    </item>
    <item>
      <title>উড়িষ্যা উপকূলে আঘাত হানতে পারে ঘূর্ণিঝড় ‘আকভান’, বাংলাদেশে ঝড়বৃষ্টির আভাস</title>
      <link>https://www.arthosuchak.com/archives/983201/%e0%a6%89%e0%a6%a1%e0%a6%bc%e0%a6%bf%e0%a6%b7%e0%a7%8d%e0%a6%af%e0%a6%be-%e0%a6%89%e0%a6%aa%e0%a6%95%e0%a7%82%e0%a6%b2%e0%a7%87-%e0%a6%86%e0%a6%98%e0%a6%be%e0%a6%a4-%e0%a6%b9%e0%a6%be%e0%a6%a8/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983201/%e0%a6%89%e0%a6%a1%e0%a6%bc%e0%a6%bf%e0%a6%b7%e0%a7%8d%e0%a6%af%e0%a6%be-%e0%a6%89%e0%a6%aa%e0%a6%95%e0%a7%82%e0%a6%b2%e0%a7%87-%e0%a6%86%e0%a6%98%e0%a6%be%e0%a6%a4-%e0%a6%b9%e0%a6%be%e0%a6%a8/</guid>
      <pubDate>Fri, 20 Nov 2026 04:29:48 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2025/08/Cyclon-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2025/08/Cyclon-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2025/08/Cyclon-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="উড়িষ্যা উপকূলে আঘাত হানতে পারে ঘূর্ণিঝড় ‘আকভান’, বাংলাদেশে ঝড়বৃষ্টির আভাস" /&gt;&lt;/p&gt;&lt;p&gt;বঙ্গোপসাগরে সৃষ্ট ঘূর্ণিঝড় ‘আকভান’ কিছুটা শক্তি হারিয়ে ভারতের উড়িষ্যা উপকূলের দিকে অগ্রসর হচ্ছে। শুক্রবার (২০ নভেম্বর) দুপুরে ঘূর্ণিঝড়টি উড়িষ্যার গোপালপুরের কাছে উপকূলে আঘাত হানতে পারে। এর প্রভাবে বাংলাদেশের ১০ জেলার ওপর দিয়ে ঘণ্টায় সর্বোচ্চ ৬০ কিলোমিটার বেগে ঝোড়ো হাওয়াসহ বৃষ্টি অথবা বজ্রবৃষ্টির আশঙ&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983201/%e0%a6%89%e0%a6%a1%e0%a6%bc%e0%a6%bf%e0%a6%b7%e0%a7%8d%e0%a6%af%e0%a6%be-%e0%a6%89%e0%a6%aa%e0%a6%95%e0%a7%82%e0%a6%b2%e0%a7%87-%e0%a6%86%e0%a6%98%e0%a6%be%e0%a6%a4-%e0%a6%b9%e0%a6%be%e0%a6%a8/">অর্থসূচক</source>
    </item>
    <item>
      <title>কমোডিটি ডেরিভেটিভস এক্সচেঞ্জ চালুর প্রস্তুতি সম্পন্ন, প্রথম ধাপে লেনদেন হবে সোনা-রুপা-পাম অয়েলে</title>
      <link>https://www.arthosuchak.com/archives/983198/%e0%a6%95%e0%a6%ae%e0%a7%8b%e0%a6%a1%e0%a6%bf%e0%a6%9f%e0%a6%bf-%e0%a6%a1%e0%a7%87%e0%a6%b0%e0%a6%bf%e0%a6%ad%e0%a7%87%e0%a6%9f%e0%a6%bf%e0%a6%ad%e0%a6%b8-%e0%a6%8f%e0%a6%95%e0%a7%8d%e0%a6%b8-2/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983198/%e0%a6%95%e0%a6%ae%e0%a7%8b%e0%a6%a1%e0%a6%bf%e0%a6%9f%e0%a6%bf-%e0%a6%a1%e0%a7%87%e0%a6%b0%e0%a6%bf%e0%a6%ad%e0%a7%87%e0%a6%9f%e0%a6%bf%e0%a6%ad%e0%a6%b8-%e0%a6%8f%e0%a6%95%e0%a7%8d%e0%a6%b8-2/</guid>
      <pubDate>Fri, 20 Nov 2026 04:11:06 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/IMG-20261119-WA0000-300x200.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/IMG-20261119-WA0000-300x200.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/IMG-20261119-WA0000-300x200.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কমোডিটি ডেরিভেটিভস এক্সচেঞ্জ চালুর প্রস্তুতি সম্পন্ন, প্রথম ধাপে লেনদেন হবে সোনা-রুপা-পাম অয়েলে" /&gt;&lt;/p&gt;&lt;p&gt;দেশের পুঁজিবাজারে নতুন দিগন্ত উন্মোচনে প্রথম কমোডিটি ডেরিভেটিভস এক্সচেঞ্জ চালুর প্রস্তুতি নিচ্ছে চট্টগ্রাম স্টক এক্সচেঞ্জ (সিএসই)। ইতোমধ্যে এ বাজারের প্রয়োজনীয় প্রযুক্তিগত অবকাঠামো ও নিয়ন্ত্রক কাঠামো সম্পন্ন হয়েছে। প্রাথমিকভাবে ছয়টি পণ্যকে দুই ধাপে লেনদেনের জন্য নির্বাচন করা হয়েছে। প্রথম ধাপে সোনা, &lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983198/%e0%a6%95%e0%a6%ae%e0%a7%8b%e0%a6%a1%e0%a6%bf%e0%a6%9f%e0%a6%bf-%e0%a6%a1%e0%a7%87%e0%a6%b0%e0%a6%bf%e0%a6%ad%e0%a7%87%e0%a6%9f%e0%a6%bf%e0%a6%ad%e0%a6%b8-%e0%a6%8f%e0%a6%95%e0%a7%8d%e0%a6%b8-2/">অর্থসূচক</source>

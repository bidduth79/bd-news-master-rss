    <item>
      <title>সিঙ্গাপুরকে ৭-০ গোলে উড়িয়ে দিল ব্রাজিল</title>
      <link>https://www.arthosuchak.com/archives/982831/%e0%a6%b8%e0%a6%bf%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a6%be%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a6%95%e0%a7%87-%e0%a7%ad-%e0%a7%a6-%e0%a6%97%e0%a7%8b%e0%a6%b2%e0%a7%87-%e0%a6%89%e0%a6%a1%e0%a6%bc%e0%a6%bf/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982831/%e0%a6%b8%e0%a6%bf%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a6%be%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a6%95%e0%a7%87-%e0%a7%ad-%e0%a7%a6-%e0%a6%97%e0%a7%8b%e0%a6%b2%e0%a7%87-%e0%a6%89%e0%a6%a1%e0%a6%bc%e0%a6%bf/</guid>
      <pubDate>Tue, 17 Nov 2026 12:53:00 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2025/03/vinicius-goal-vs-colombia-20250321090508-1-300x150.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2025/03/vinicius-goal-vs-colombia-20250321090508-1-300x150.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2025/03/vinicius-goal-vs-colombia-20250321090508-1-300x150.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সিঙ্গাপুরকে ৭-০ গোলে উড়িয়ে দিল ব্রাজিল" /&gt;&lt;/p&gt;&lt;p&gt;আন্তর্জাতিক প্রীতি ফুটবল ম্যাচে সিঙ্গাপুরকে ৭-০ গোলের বিশাল ব্যবধানে উড়িয়ে দিয়েছে পাঁচবারের বিশ্বচ্যাম্পিয়ন ব্রাজিল। দুর্দান্ত পারফরম্যান্সে দলের জয়ে বড় অবদান রেখেছেন ভিনিসিয়ুস জুনিয়র। একাই তিন গোল করে হ্যাটট্রিক পূর্ণ করেছেন রিয়াল মাদ্রিদের এই তারকা। ব্রাজিলের জার্সিতে এটিই তাঁর প্রথম হ্যাটট্রিক। ম&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982831/%e0%a6%b8%e0%a6%bf%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a6%be%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a6%95%e0%a7%87-%e0%a7%ad-%e0%a7%a6-%e0%a6%97%e0%a7%8b%e0%a6%b2%e0%a7%87-%e0%a6%89%e0%a6%a1%e0%a6%bc%e0%a6%bf/">অর্থসূচক</source>
    </item>
    <item>
      <title>আন্তর্জাতিক ফ্লেম অ্যাওয়ার্ডসে পাঁচ ক্যাটাগরিতে গোল্ড জিতল বিকাশ</title>
      <link>https://www.arthosuchak.com/archives/982835/%e0%a6%86%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a6%b0%e0%a7%8d%e0%a6%9c%e0%a6%be%e0%a6%a4%e0%a6%bf%e0%a6%95-%e0%a6%ab%e0%a7%8d%e0%a6%b2%e0%a7%87%e0%a6%ae-%e0%a6%85%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%93%e0%a6%af/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982835/%e0%a6%86%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a6%b0%e0%a7%8d%e0%a6%9c%e0%a6%be%e0%a6%a4%e0%a6%bf%e0%a6%95-%e0%a6%ab%e0%a7%8d%e0%a6%b2%e0%a7%87%e0%a6%ae-%e0%a6%85%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%93%e0%a6%af/</guid>

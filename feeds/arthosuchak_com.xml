    <item>
      <title>লেনদেনের শীর্ষে আইপিডিসি ফাইন্যান্স</title>
      <link>https://www.arthosuchak.com/archives/981694/%e0%a6%b2%e0%a7%87%e0%a6%a8%e0%a6%a6%e0%a7%87%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%b6%e0%a7%80%e0%a6%b0%e0%a7%8d%e0%a6%b7%e0%a7%87-%e0%a6%86%e0%a6%87%e0%a6%aa%e0%a6%bf%e0%a6%a1%e0%a6%bf%e0%a6%b8-10/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981694/%e0%a6%b2%e0%a7%87%e0%a6%a8%e0%a6%a6%e0%a7%87%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%b6%e0%a7%80%e0%a6%b0%e0%a7%8d%e0%a6%b7%e0%a7%87-%e0%a6%86%e0%a6%87%e0%a6%aa%e0%a6%bf%e0%a6%a1%e0%a6%bf%e0%a6%b8-10/</guid>
      <pubDate>Wed, 11 Nov 2026 10:22:10 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2022/07/IPDC-300x154.png" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2022/07/IPDC-300x154.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2022/07/IPDC-300x154.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="লেনদেনের শীর্ষে আইপিডিসি ফাইন্যান্স" /&gt;&lt;/p&gt;&lt;p&gt;সপ্তাহের চতুর্থ কার্যদিবস বুধবার (১১ নভেম্বর) দেশের প্রধান পুঁজিবাজার ঢাকা স্টক এক্সচেঞ্জে (ডিএসই) লেনদেনে অংশ নেওয়া কোম্পানিগুলোর মধ্যে লেনদেনের শীর্ষস্থান দখল করেছে আইপিডিসি ফাইন্যান্স পিএলসি। এদিন কোম্পানিটির ৩২ কোটি ৩৮ লাখ টাকার শেয়ার লেনদেন হয়েছে। ডিএসই সূত্রে এ তথ্য জানা গেছে। সর্বশেষ তথ্য অনু&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981694/%e0%a6%b2%e0%a7%87%e0%a6%a8%e0%a6%a6%e0%a7%87%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%b6%e0%a7%80%e0%a6%b0%e0%a7%8d%e0%a6%b7%e0%a7%87-%e0%a6%86%e0%a6%87%e0%a6%aa%e0%a6%bf%e0%a6%a1%e0%a6%bf%e0%a6%b8-10/">অর্থসূচক</source>
    </item>
    <item>
      <title>হাম উপসর্গে আরও ৬ শিশুর মৃত্যু</title>
      <link>https://www.arthosuchak.com/archives/981681/%e0%a6%b9%e0%a6%be%e0%a6%ae-%e0%a6%89%e0%a6%aa%e0%a6%b8%e0%a6%b0%e0%a7%8d%e0%a6%97%e0%a7%87-%e0%a6%86%e0%a6%b0%e0%a6%93-%e0%a7%ac-%e0%a6%b6%e0%a6%bf%e0%a6%b6%e0%a7%81%e0%a6%b0-%e0%a6%ae%e0%a7%83-7/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981681/%e0%a6%b9%e0%a6%be%e0%a6%ae-%e0%a6%89%e0%a6%aa%e0%a6%b8%e0%a6%b0%e0%a7%8d%e0%a6%97%e0%a7%87-%e0%a6%86%e0%a6%b0%e0%a6%93-%e0%a7%ac-%e0%a6%b6%e0%a6%bf%e0%a6%b6%e0%a7%81%e0%a6%b0-%e0%a6%ae%e0%a7%83-7/</guid>
      <pubDate>Wed, 11 Nov 2026 10:15:27 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/08/Hum-Sastho-Adhidaotar-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/08/Hum-Sastho-Adhidaotar-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/08/Hum-Sastho-Adhidaotar-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হাম উপসর্গে আরও ৬ শিশুর মৃত্যু" /&gt;&lt;/p&gt;&lt;p&gt;সারা দেশে হামের প্রাদুর্ভাব অব্যাহত রয়েছে। গত ২৪ ঘণ্টায় হাম ও হামের উপসর্গ নিয়ে আরও পাঁচ শিশুর মৃত্যু হয়েছে। এ নিয়ে ১৫ মার্চ থেকে হাম ও হামের উপসর্গে এ পর্যন্ত মোট মৃতের সংখ্যা বেড়ে হয়েছে এক হাজার ২৯৫ জন। স্বাস্থ্য অধিদপ্তরের হিসাবে, এ সময়ে নিশ্চিত হামে কারও মৃত্যু নথিভুক্ত হয়নি। বুধবার (১১ নভেম্বর)&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981681/%e0%a6%b9%e0%a6%be%e0%a6%ae-%e0%a6%89%e0%a6%aa%e0%a6%b8%e0%a6%b0%e0%a7%8d%e0%a6%97%e0%a7%87-%e0%a6%86%e0%a6%b0%e0%a6%93-%e0%a7%ac-%e0%a6%b6%e0%a6%bf%e0%a6%b6%e0%a7%81%e0%a6%b0-%e0%a6%ae%e0%a7%83-7/">অর্থসূচক</source>
    </item>
    <item>
      <title>উচ্চ রক্তচাপ নিয়ন্ত্রণে টেকসই অর্থায়ন নিশ্চিতের আহ্বান</title>
      <link>https://www.arthosuchak.com/archives/981684/%e0%a6%89%e0%a6%9a%e0%a7%8d%e0%a6%9a-%e0%a6%b0%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%9a%e0%a6%be%e0%a6%aa-%e0%a6%a8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a6%a3-6/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981684/%e0%a6%89%e0%a6%9a%e0%a7%8d%e0%a6%9a-%e0%a6%b0%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%9a%e0%a6%be%e0%a6%aa-%e0%a6%a8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a6%a3-6/</guid>
      <pubDate>Wed, 11 Nov 2026 09:48:37 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Journalists-Workshop-300x158.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Journalists-Workshop-300x158.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Journalists-Workshop-300x158.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="উচ্চ রক্তচাপ নিয়ন্ত্রণে টেকসই অর্থায়ন নিশ্চিতের আহ্বান" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশে উচ্চ রক্তচাপজনিত অসুস্থতা ও অকালমৃত্যুর ঝুঁকি আশঙ্কাজনক হারে বাড়ছে। ২০২৪ সালে দেশে হৃদরোগে মৃত্যুবরণ করেছে প্রায় ২ লাখ ৮৩ হাজার ৮০০ মানুষ, যার ৫২ শতাংশের জন্য দায়ী উচ্চ রক্তচাপ। সরকার স্বাস্থ্য বাজেট বাড়ালেও, উচ্চ রক্তচাপ নিয়ন্ত্রণে পর্যাপ্ত ও নিরবচ্ছিন্ন অর্থায়নের ঘাটতি রয়েছে। বর্ধিত স্ব&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981684/%e0%a6%89%e0%a6%9a%e0%a7%8d%e0%a6%9a-%e0%a6%b0%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%9a%e0%a6%be%e0%a6%aa-%e0%a6%a8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a6%a3-6/">অর্থসূচক</source>
    </item>
    <item>
      <title>রমজানে মূল্যবৃদ্ধি ঠেকাতে ১০ খাদ্যপণ্য আমদানিতে ঋণসুবিধা</title>
      <link>https://www.arthosuchak.com/archives/981682/%e0%a6%b0%e0%a6%ae%e0%a6%9c%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%ae%e0%a7%82%e0%a6%b2%e0%a7%8d%e0%a6%af%e0%a6%ac%e0%a7%83%e0%a6%a6%e0%a7%8d%e0%a6%a7%e0%a6%bf-%e0%a6%a0%e0%a7%87%e0%a6%95%e0%a6%be%e0%a6%a4/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981682/%e0%a6%b0%e0%a6%ae%e0%a6%9c%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%ae%e0%a7%82%e0%a6%b2%e0%a7%8d%e0%a6%af%e0%a6%ac%e0%a7%83%e0%a6%a6%e0%a7%8d%e0%a6%a7%e0%a6%bf-%e0%a6%a0%e0%a7%87%e0%a6%95%e0%a6%be%e0%a6%a4/</guid>
      <pubDate>Wed, 11 Nov 2026 09:23:07 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2024/09/df52b8f4-34f8-4d47-aba7-72db4c3059db-1-300x150.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2024/09/df52b8f4-34f8-4d47-aba7-72db4c3059db-1-300x150.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2024/09/df52b8f4-34f8-4d47-aba7-72db4c3059db-1-300x150.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রমজানে মূল্যবৃদ্ধি ঠেকাতে ১০ খাদ্যপণ্য আমদানিতে ঋণসুবিধা" /&gt;&lt;/p&gt;&lt;p&gt;রমজানে নিত্যপ্রয়োজনীয় পণ্যের সরবরাহ বাজারদর সহনীয় রাখতে ১০ ধরনের খাদ্যপণ্য আমদানিতে ৯০ দিনের বাকিতে মূল্য পরিশোধের সুযোগ দিয়েছে বাংলাদেশ ব্যাংক। এ সুবিধায় আমদানিকারকরা এখন পণ্য এনে পরে মূল্য পরিশোধ করতে পারবেন। বুধবার (১১ নভেম্বর) বাংলাদেশ ব্যাংকের বৈদেশিক মুদ্রানীতি বিভাগ-১ এ-সংক্রান্ত এক সার্কুলার&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981682/%e0%a6%b0%e0%a6%ae%e0%a6%9c%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%ae%e0%a7%82%e0%a6%b2%e0%a7%8d%e0%a6%af%e0%a6%ac%e0%a7%83%e0%a6%a6%e0%a7%8d%e0%a6%a7%e0%a6%bf-%e0%a6%a0%e0%a7%87%e0%a6%95%e0%a6%be%e0%a6%a4/">অর্থসূচক</source>
    </item>
    <item>
      <title>ধর্ষণে ছাত্রী অন্তঃসত্ত্বা, সেই শিক্ষকের মৃত্যুদণ্ড</title>
      <link>https://www.arthosuchak.com/archives/981675/%e0%a6%a7%e0%a6%b0%e0%a7%8d%e0%a6%b7%e0%a6%a3%e0%a7%87-%e0%a6%9b%e0%a6%be%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a7%80-%e0%a6%85%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a6%83%e0%a6%b8%e0%a6%a4%e0%a7%8d%e0%a6%a4%e0%a7%8d/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981675/%e0%a6%a7%e0%a6%b0%e0%a7%8d%e0%a6%b7%e0%a6%a3%e0%a7%87-%e0%a6%9b%e0%a6%be%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a7%80-%e0%a6%85%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a6%83%e0%a6%b8%e0%a6%a4%e0%a7%8d%e0%a6%a4%e0%a7%8d/</guid>

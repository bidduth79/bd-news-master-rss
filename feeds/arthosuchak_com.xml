    <item>
      <title>ইস্টার্ন কেবলসের লভ্যাংশ সংক্রান্ত ঘোষণা</title>
      <link>https://www.arthosuchak.com/archives/981513/%e0%a6%87%e0%a6%b8%e0%a7%8d%e0%a6%9f%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%a8-%e0%a6%95%e0%a7%87%e0%a6%ac%e0%a6%b2%e0%a6%b8%e0%a7%87%e0%a6%b0-%e0%a6%b2%e0%a6%ad%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82-3/</link>

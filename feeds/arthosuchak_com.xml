      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2025/03/NCP-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2025/03/NCP-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2025/03/NCP-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="১০০ উপজেলা ও পৌরসভায় এনসপির প্রার্থী তালিকা প্রকাশ" /&gt;&lt;/p&gt;&lt;p&gt;আসন্ন স্থানীয় সরকার নির্বাচন সামনে রেখে আরও ১০০ উপজেলা ও পৌরসভায় দলীয় প্রার্থির নাম ঘোষণা করেছে জাতীয় নাগরিক পার্টি (এনসিপি)। মঙ্গলবার (১৭ নভেম্বর) দুপুরে রাজধানীর বাংলা মোটরে দলের অস্থায়ী কেন্দ্রীয় কার্যালয়ে এ তালিকা প্রকাশ করেন দলের সিনিয়র যুগ্ম সদস্য সচিব সারজিস আলম। সময় উপস্থিত ছিলেন- দলের সিনিয়&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982822/%e0%a6%86%e0%a6%b0%e0%a6%93-%e0%a7%a7%e0%a7%a6%e0%a7%a6-%e0%a6%89%e0%a6%aa%e0%a6%9c%e0%a7%87%e0%a6%b2%e0%a6%be-%e0%a6%93-%e0%a6%aa%e0%a7%8c%e0%a6%b0%e0%a6%b8%e0%a6%ad%e0%a6%be%e0%a6%af%e0%a6%bc/">অর্থসূচক</source>
    </item>
    <item>
      <title>আইপিএল থেকে অবসরের ঘোষণা ধোনির</title>
      <link>https://www.arthosuchak.com/archives/982817/%e0%a6%86%e0%a6%87%e0%a6%aa%e0%a6%bf%e0%a6%8f%e0%a6%b2%e0%a6%95%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%9c%e0%a6%be%e0%a6%a8%e0%a6%be%e0%a6%b2%e0%a7%87%e0%a6%a8/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982817/%e0%a6%86%e0%a6%87%e0%a6%aa%e0%a6%bf%e0%a6%8f%e0%a6%b2%e0%a6%95%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%9c%e0%a6%be%e0%a6%a8%e0%a6%be%e0%a6%b2%e0%a7%87%e0%a6%a8/</guid>
      <pubDate>Tue, 17 Nov 2026 11:30:02 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2021/10/Ddo2-300x162.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2021/10/Ddo2-300x162.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2021/10/Ddo2-300x162.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আইপিএল থেকে অবসরের ঘোষণা ধোনির" /&gt;&lt;/p&gt;&lt;p&gt;২০০৭ টি-টোয়েন্টি বিশ্বকাপজয়ী ভারতের কিংবদন্তি ক্রিকেটার মহেন্দ্র সিং ধোনি ইন্ডিয়ান প্রিমিয়ার লিগ (আইপিএল) থেকে অবসরের সিদ্ধান্ত নিয়েছেন। মঙ্গলবার (১৭ নভেম্বর) চেন্নাই সুপার কিংস (সিএসকে) আনুষ্ঠানিকভাবে তাঁর অবসরের বিষয়টি নিশ্চিত করেছে। তবে ক্রিকেটের সঙ্গে সম্পর্ক ছিন্ন করছেন না তিনি। ২০২৭ সালের আইপি&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982817/%e0%a6%86%e0%a6%87%e0%a6%aa%e0%a6%bf%e0%a6%8f%e0%a6%b2%e0%a6%95%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%9c%e0%a6%be%e0%a6%a8%e0%a6%be%e0%a6%b2%e0%a7%87%e0%a6%a8/">অর্থসূচক</source>
    </item>
    <item>
      <title>বিশ্বব্যাংকের সহায়তা চাইল বাংলাদেশ</title>
      <link>https://www.arthosuchak.com/archives/982816/%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%ac%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%b9%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a6%a4%e0%a6%be-%e0%a6%9a%e0%a6%be/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982816/%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%ac%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%b9%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a6%a4%e0%a6%be-%e0%a6%9a%e0%a6%be/</guid>
      <pubDate>Tue, 17 Nov 2026 11:24:38 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Abdul-WB-300x158.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Abdul-WB-300x158.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Abdul-WB-300x158.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিশ্বব্যাংকের সহায়তা চাইল বাংলাদেশ" /&gt;&lt;/p&gt;&lt;p&gt;ব্যবসার পরিবেশ উন্নয়ন, সরকারি সেবার ডিজিটাল রূপান্তর এবং তৈরি পোশাকনির্ভর রপ্তানি কাঠামো থেকে বেরিয়ে নতুন শিল্প খাতের বিকাশে বিশ্বব্যাংকের নীতিগত ও কারিগরি সহায়তা চেয়েছে বাংলাদেশ। একই সঙ্গে স্বল্পোন্নত দেশের (এলডিসি) তালিকা থেকে উত্তরণ সামনে রেখে আগামী তিন বছরের জন্য একটি সমন্বিত কর্মপরিকল্পনা গ্রহণ&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982816/%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%ac%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%b9%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a6%a4%e0%a6%be-%e0%a6%9a%e0%a6%be/">অর্থসূচক</source>
    </item>
    <item>
      <title>ডেঙ্গুতে মৃত্যু আরও ৫</title>
      <link>https://www.arthosuchak.com/archives/982814/%e0%a6%a1%e0%a7%87%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%81%e0%a6%a4%e0%a7%87-%e0%a6%ae%e0%a7%83%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a7%81-%e0%a6%86%e0%a6%b0%e0%a6%93-%e0%a7%ab-8/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982814/%e0%a6%a1%e0%a7%87%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%81%e0%a6%a4%e0%a7%87-%e0%a6%ae%e0%a7%83%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a7%81-%e0%a6%86%e0%a6%b0%e0%a6%93-%e0%a7%ab-8/</guid>
      <pubDate>Tue, 17 Nov 2026 11:00:09 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2022/11/dengu-300x158.png" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2022/11/dengu-300x158.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2022/11/dengu-300x158.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডেঙ্গুতে মৃত্যু আরও ৫" /&gt;&lt;/p&gt;&lt;p&gt;দেশে ডেঙ্গুতে আক্রান্ত হয়ে আরও পাঁচ জনের মৃত্যু হয়েছে। এছাড়া এই সময়ের মধ্যে ডেঙ্গুতে আক্রন্ত হয়ে নতুন করে হাসপাতালে ভর্তি হয়েছেন ১ হাজার ৫৩৭ জন। মঙ্গলবার (১৭ নভেম্বর) স্বাস্থ্য অধিদফতরের প্রকাশিত বিজ্ঞপ্তিতে এ তথ্য জানানো হয়েছে। এতে বলা হয়, ঢাকা বিভাগে ৪৪৪ জন, ময়মনসিংহ বিভাগে ৫৭ জন, চট্টগ্রাম বিভাগে&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982814/%e0%a6%a1%e0%a7%87%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%81%e0%a6%a4%e0%a7%87-%e0%a6%ae%e0%a7%83%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a7%81-%e0%a6%86%e0%a6%b0%e0%a6%93-%e0%a7%ab-8/">অর্থসূচক</source>
    </item>
    <item>
      <title>এপস্টেইনের সঙ্গে ৫৮২ মিলিয়ন ডলারের লেনদেন, চাপে ডয়েচে ব্যাংক</title>
      <link>https://www.arthosuchak.com/archives/982806/%e0%a6%8f%e0%a6%aa%e0%a6%b8%e0%a7%8d%e0%a6%9f%e0%a7%87%e0%a6%87%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%87-%e0%a7%ab%e0%a7%ae%e0%a7%a8-%e0%a6%ae%e0%a6%bf%e0%a6%b2/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982806/%e0%a6%8f%e0%a6%aa%e0%a6%b8%e0%a7%8d%e0%a6%9f%e0%a7%87%e0%a6%87%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%87-%e0%a7%ab%e0%a7%ae%e0%a7%a8-%e0%a6%ae%e0%a6%bf%e0%a6%b2/</guid>
      <pubDate>Tue, 17 Nov 2026 10:52:14 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Deuthcse-Bank-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Deuthcse-Bank-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Deuthcse-Bank-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এপস্টেইনের সঙ্গে ৫৮২ মিলিয়ন ডলারের লেনদেন, চাপে ডয়েচে ব্যাংক" /&gt;&lt;/p&gt;&lt;p&gt;জেফরি এপস্টেইনের সঙ্গে সন্দেহজনক আর্থিক লেনদেন, যুক্তরাষ্ট্রের প্রেসিডেন্ট ডোনাল্ড ট্রাম্পের করসংক্রান্ত তথ্য অনিচ্ছাকৃতভাবে ফাঁস এবং রাশিয়ার অর্থপাচার-সংশ্লিষ্ট যোগাযোগের অভিযোগে নতুন করে চাপে পড়েছে জার্মানির ডয়েচে ব্যাংক। এসব বিষয়ে ১ কোটি ৫০ লাখের বেশি অভ্যন্তরীণ নথি ফাঁস হওয়ার পর মঙ্গলবার ব্যাংকট&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982806/%e0%a6%8f%e0%a6%aa%e0%a6%b8%e0%a7%8d%e0%a6%9f%e0%a7%87%e0%a6%87%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%87-%e0%a7%ab%e0%a7%ae%e0%a7%a8-%e0%a6%ae%e0%a6%bf%e0%a6%b2/">অর্থসূচক</source>
    </item>

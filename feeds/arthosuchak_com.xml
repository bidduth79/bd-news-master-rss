    <item>
      <title>৪ হাজার চিকিৎসক-নার্স নিয়োগ দেবে সরকার</title>
      <link>https://www.arthosuchak.com/archives/982693/%e0%a7%aa-%e0%a6%b9%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0-%e0%a6%9a%e0%a6%bf%e0%a6%95%e0%a6%bf%e0%a7%8e%e0%a6%b8%e0%a6%95-%e0%a6%a8%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%b8-%e0%a6%a8%e0%a6%bf%e0%a6%af/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982693/%e0%a7%aa-%e0%a6%b9%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0-%e0%a6%9a%e0%a6%bf%e0%a6%95%e0%a6%bf%e0%a7%8e%e0%a6%b8%e0%a6%95-%e0%a6%a8%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%b8-%e0%a6%a8%e0%a6%bf%e0%a6%af/</guid>
      <pubDate>Mon, 16 Nov 2026 15:02:06 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Muhit-300x149.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Muhit-300x149.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Muhit-300x149.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৪ হাজার চিকিৎসক-নার্স নিয়োগ দেবে সরকার" /&gt;&lt;/p&gt;&lt;p&gt;দেশের স্বাস্থ্যসেবায় জনবল সংকট দূর করতে প্রায় চার হাজার চিকিৎসক এবং সমসংখ্যক সিনিয়র স্টাফ নার্স ও নার্সিং কর্মী নিয়োগের প্রক্রিয়া শুরু করেছে সরকার। পাশাপাশি দেশের ৫০৩টি উপজেলায় ১৫১ শয্যাবিশিষ্ট নতুন হাসপাতাল নির্মাণের উদ্যোগ নেওয়া হয়েছে। স্বাস্থ্য ও পরিবার কল্যাণ প্রতিমন্ত্রী এম এ মুহিত সোমবার জাতীয়&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982693/%e0%a7%aa-%e0%a6%b9%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0-%e0%a6%9a%e0%a6%bf%e0%a6%95%e0%a6%bf%e0%a7%8e%e0%a6%b8%e0%a6%95-%e0%a6%a8%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%b8-%e0%a6%a8%e0%a6%bf%e0%a6%af/">অর্থসূচক</source>

      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2025/03/Trump-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2025/03/Trump-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2025/03/Trump-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাংলাদেশসহ বিভিন্ন দেশের ওপর নতুন শুল্ক আরোপ যুক্তরাষ্ট্রের" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ, ইউরোপীয় ইউনিয়নসহ বিভিন্ন দেশের ওপর নতুন করে বিভিন্ন মাত্রার শুল্ক আরোপের ঘোষণা দিয়েছে যুক্তরাষ্ট্র। নিজেদের অন্যতম প্রধান কয়েকটি বাণিজ্যিক অংশীদারের ম্যানুফ্যাকচারিং বা উৎপাদন খাতে কাঠামোগত অতিরিক্ত সক্ষমতা ও উৎপাদন নিয়ে ‘সেকশন ৩০১’ তদন্তের পর এই শুল্ক আরোপ করা হচ্ছে। এর আওতায় থাকা দেশগুলে&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/984140/%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a6%b8%e0%a6%b9-%e0%a6%ac%e0%a6%bf%e0%a6%ad%e0%a6%bf%e0%a6%a8%e0%a7%8d%e0%a6%a8-%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%87%e0%a6%b0/">অর্থসূচক</source>
    </item>
    <item>
      <title>সৌদির তেল শোধনাগার ও অর্থনৈতিক এলাকায় হামলার দাবি হুতিদের</title>
      <link>https://www.arthosuchak.com/archives/984137/%e0%a6%b8%e0%a7%8c%e0%a6%a6%e0%a6%bf%e0%a6%b0-%e0%a6%a4%e0%a7%87%e0%a6%b2-%e0%a6%b6%e0%a7%8b%e0%a6%a7%e0%a6%a8%e0%a6%be%e0%a6%97%e0%a6%be%e0%a6%b0-%e0%a6%93-%e0%a6%85%e0%a6%b0%e0%a7%8d%e0%a6%a5/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/984137/%e0%a6%b8%e0%a7%8c%e0%a6%a6%e0%a6%bf%e0%a6%b0-%e0%a6%a4%e0%a7%87%e0%a6%b2-%e0%a6%b6%e0%a7%8b%e0%a6%a7%e0%a6%a8%e0%a6%be%e0%a6%97%e0%a6%be%e0%a6%b0-%e0%a6%93-%e0%a6%85%e0%a6%b0%e0%a7%8d%e0%a6%a5/</guid>
      <pubDate>Wed, 25 Nov 2026 14:18:13 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Soud-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Soud-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Soud-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সৌদির তেল শোধনাগার ও অর্থনৈতিক এলাকায় হামলার দাবি হুতিদের" /&gt;&lt;/p&gt;&lt;p&gt;সৌদি আরবের রাস তানুরা তেল শোধনাগার এবং রিয়াদের অর্থনৈতিক এলাকায় হামলার দাবি করেছে ইয়েমেনি হুতিরা। সৌদির সবচেয়ে বড় তেল শোধনাগার রাস তানুরা এবং দেশটির অপরিশোধিত তেল রপ্তানির অন্যতম প্রধান কেন্দ্র। হুতি সামরিক বাহিনীর মুখপাত্র ইয়াহিয়া সারি বলেছেন, শোধনাগারে ওই হামলার ফলে আগুন লেগেছে, আর রিয়াদের অর্থনৈত&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/984137/%e0%a6%b8%e0%a7%8c%e0%a6%a6%e0%a6%bf%e0%a6%b0-%e0%a6%a4%e0%a7%87%e0%a6%b2-%e0%a6%b6%e0%a7%8b%e0%a6%a7%e0%a6%a8%e0%a6%be%e0%a6%97%e0%a6%be%e0%a6%b0-%e0%a6%93-%e0%a6%85%e0%a6%b0%e0%a7%8d%e0%a6%a5/">অর্থসূচক</source>
    </item>
    <item>
      <title>কমিউনিটি ব্যাংকের পরিচালনা পর্ষদের ৮৩তম সভা অনুষ্ঠিত</title>
      <link>https://www.arthosuchak.com/archives/984134/%e0%a6%95%e0%a6%ae%e0%a6%bf%e0%a6%89%e0%a6%a8%e0%a6%bf%e0%a6%9f%e0%a6%bf-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a6%b0%e0%a6%bf%e0%a6%9a%e0%a6%be-11/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/984134/%e0%a6%95%e0%a6%ae%e0%a6%bf%e0%a6%89%e0%a6%a8%e0%a6%bf%e0%a6%9f%e0%a6%bf-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a6%b0%e0%a6%bf%e0%a6%9a%e0%a6%be-11/</guid>
      <pubDate>Wed, 25 Nov 2026 13:55:20 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/CB26-1-300x150.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/CB26-1-300x150.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/CB26-1-300x150.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কমিউনিটি ব্যাংকের পরিচালনা পর্ষদের ৮৩তম সভা অনুষ্ঠিত" /&gt;&lt;/p&gt;&lt;p&gt;কমিউনিটি ব্যাংক বাংলাদেশ পিএলসি.-এর পরিচালনা পর্ষদের ৮৩তম সভা আজ (২৫ নভেম্বর) পুলিশ হেডকোয়ার্টার্সে অনুষ্ঠিত হয়েছে। সভায় সভাপতিত্ব করেন বাংলাদেশ পুলিশের ইন্সপেক্টর জেনারেল অব পুলিশ (আইজিপি) এবং কমিউনিটি ব্যাংক বাংলাদেশ পিএলসি.-এর পরিচালনা পর্ষদের চেয়ারম্যান মো. আলী হোসেন ফকির, বিপিএম। সভায় ব্যা&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/984134/%e0%a6%95%e0%a6%ae%e0%a6%bf%e0%a6%89%e0%a6%a8%e0%a6%bf%e0%a6%9f%e0%a6%bf-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a6%b0%e0%a6%bf%e0%a6%9a%e0%a6%be-11/">অর্থসূচক</source>
    </item>
    <item>
      <title>প্রধানমন্ত্রীর উদ্বোধনে কাল শুরু হচ্ছে প্রাণিসম্পদ সপ্তাহ</title>
      <link>https://www.arthosuchak.com/archives/984132/%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a7%e0%a6%be%e0%a6%a8%e0%a6%ae%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a7%80%e0%a6%b0-%e0%a6%89%e0%a6%a6%e0%a7%8d%e0%a6%ac%e0%a7%8b%e0%a6%a7%e0%a6%a8%e0%a7%87/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/984132/%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a7%e0%a6%be%e0%a6%a8%e0%a6%ae%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a7%80%e0%a6%b0-%e0%a6%89%e0%a6%a6%e0%a7%8d%e0%a6%ac%e0%a7%8b%e0%a6%a7%e0%a6%a8%e0%a7%87/</guid>
      <pubDate>Wed, 25 Nov 2026 13:48:07 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/08/PM-Tarique-Rahman-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/08/PM-Tarique-Rahman-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/08/PM-Tarique-Rahman-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রধানমন্ত্রীর উদ্বোধনে কাল শুরু হচ্ছে প্রাণিসম্পদ সপ্তাহ" /&gt;&lt;/p&gt;&lt;p&gt;প্রাণিসম্পদ খাতের উন্নয়ন, উৎপাদন বৃদ্ধি ও রপ্তানির সম্ভাবনা তুলে ধরতে আগামীকাল বৃহস্পতিবার (২৬ নভেম্বর) শুরু হচ্ছে জাতীয় প্রাণিসম্পদ সপ্তাহ ২০২৬। ‘রপ্তানিমুখী প্রাণিসম্পদে গড়ব দেশ, সবার আগে বাংলাদেশ’ প্রতিপাদ্যে আয়োজিত এ কর্মসূচি চলবে ২৮ নভেম্বর পর্যন্ত। দেশের কেন্দ্রীয়, জেলা ও উপজেলা পর্যায়ে একযোগে&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/984132/%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a7%e0%a6%be%e0%a6%a8%e0%a6%ae%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a7%80%e0%a6%b0-%e0%a6%89%e0%a6%a6%e0%a7%8d%e0%a6%ac%e0%a7%8b%e0%a6%a7%e0%a6%a8%e0%a7%87/">অর্থসূচক</source>
    </item>
    <item>
      <title>জনতা ব্যাংকের নতুন এমডি মাহবুব আলম</title>
      <link>https://www.arthosuchak.com/archives/984129/%e0%a6%9c%e0%a6%a8%e0%a6%a4%e0%a6%be-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%8f%e0%a6%ae%e0%a6%a1%e0%a6%bf-%e0%a6%ae/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/984129/%e0%a6%9c%e0%a6%a8%e0%a6%a4%e0%a6%be-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%8f%e0%a6%ae%e0%a6%a1%e0%a6%bf-%e0%a6%ae/</guid>
      <pubDate>Wed, 25 Nov 2026 13:31:15 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Janata-bank-md-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Janata-bank-md-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Janata-bank-md-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জনতা ব্যাংকের নতুন এমডি মাহবুব আলম" /&gt;&lt;/p&gt;&lt;p&gt;জনতা ব্যাংক পিএলসির ব্যবস্থাপনা পরিচালকের (এমডি) দায়িত্ব গ্রহণ করেছেন ব্যাংকার মো. মাহবুব আলম। বুধবার (২৫ নভেম্বর) থেকে আগামী তিন বছরের জন্য তাকে এ পদে নিয়োগ দেওয়া হয়েছে। জনতা ব্যাংকে যোগ দেওয়ার আগে তিনি সাউথইস্ট ব্যাংক পিএলসির অতিরিক্ত ব্যবস্থাপনা পরিচালক (এএমডি) হিসেবে কর্মরত ছিলেন। সেখানে দায়িত্ব&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/984129/%e0%a6%9c%e0%a6%a8%e0%a6%a4%e0%a6%be-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%8f%e0%a6%ae%e0%a6%a1%e0%a6%bf-%e0%a6%ae/">অর্থসূচক</source>
    </item>

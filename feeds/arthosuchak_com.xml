      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/england-vs-spain-football-2-300x168.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/england-vs-spain-football-2-300x168.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/england-vs-spain-football-2-300x168.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৪৩ ম্যাচ পর ইংল্যান্ডের কাছে হারলো স্পেন" /&gt;&lt;/p&gt;&lt;p&gt;একজন খেলোয়াড় কম নিয়েও বিশ্ব চ্যাম্পিয়ন স্পেনকে ৩-২ গোলে হারিয়েছে ইংল্যান্ড। ম্যাচের ৬৩ মিনিটে মিডফিল্ডার এলিয়ট অ্যান্ডারসন লাল কার্ড দেখে মাঠ ছাড়লেও বাকি সময় দৃঢ় প্রতিরোধ গড়ে জয় নিশ্চিত করে থ্রি লায়ন্সরা। এই হারে ২০২৪ সালের মার্চ থেকে চলা স্পেনের টানা ৪৩ ম্যাচ অপরাজিত থাকার রেকর্ডের অবসান ঘটেছে। ম্য&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982581/%e0%a7%aa%e0%a7%a9-%e0%a6%ae%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%9a-%e0%a6%aa%e0%a6%b0-%e0%a6%87%e0%a6%82%e0%a6%b2%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a1%e0%a7%87%e0%a6%b0-%e0%a6%95/">অর্থসূচক</source>
    </item>
    <item>
      <title>ড্রোনসহ আধুনিক প্রযুক্তির নজরদারিতে গোপালগঞ্জ</title>
      <link>https://www.arthosuchak.com/archives/982594/%e0%a6%a1%e0%a7%8d%e0%a6%b0%e0%a7%8b%e0%a6%a8%e0%a6%b8%e0%a6%b9-%e0%a6%86%e0%a6%a7%e0%a7%81%e0%a6%a8%e0%a6%bf%e0%a6%95-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%af%e0%a7%81%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%bf/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982594/%e0%a6%a1%e0%a7%8d%e0%a6%b0%e0%a7%8b%e0%a6%a8%e0%a6%b8%e0%a6%b9-%e0%a6%86%e0%a6%a7%e0%a7%81%e0%a6%a8%e0%a6%bf%e0%a6%95-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%af%e0%a7%81%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%bf/</guid>
      <pubDate>Mon, 16 Nov 2026 08:13:50 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2024/04/bgb-300x164.png" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2024/04/bgb-300x164.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2024/04/bgb-300x164.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ড্রোনসহ আধুনিক প্রযুক্তির নজরদারিতে গোপালগঞ্জ" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জ জেলার সার্বিক আইনশৃঙ্খলা পরিস্থিতি স্বাভাবিক ও জননিরাপত্তা নিশ্চিত করতে জেলার গুরুত্বপূর্ণ এলাকায় ১০ প্লাটুন বর্ডার গার্ড বাংলাদেশ (বিজিবি) মোতায়েন করা হয়েছে। এছাড়া যেকোনো ধরনের অনাকাঙ্ক্ষিত পরিস্থিতি মোকাবিলা ও প্রয়োজনীয় দাঙ্গা নিয়ন্ত্রণের জন্য প্রয়োজনীয় সংখ্যক আর্মার্ড পারসোনেল ক্যারিয়ার&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982594/%e0%a6%a1%e0%a7%8d%e0%a6%b0%e0%a7%8b%e0%a6%a8%e0%a6%b8%e0%a6%b9-%e0%a6%86%e0%a6%a7%e0%a7%81%e0%a6%a8%e0%a6%bf%e0%a6%95-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%af%e0%a7%81%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%bf/">অর্থসূচক</source>
    </item>
    <item>
      <title>শাপলা চত্বর হত্যাকাণ্ড: ট্রাইব্যুনালে হাজির ১১ আসামি</title>
      <link>https://www.arthosuchak.com/archives/982582/%e0%a6%b6%e0%a6%be%e0%a6%aa%e0%a6%b2%e0%a6%be-%e0%a6%9a%e0%a6%a4%e0%a7%8d%e0%a6%ac%e0%a6%b0-%e0%a6%b9%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%95%e0%a6%be%e0%a6%a3%e0%a7%8d%e0%a6%a1-%e0%a6%9f/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982582/%e0%a6%b6%e0%a6%be%e0%a6%aa%e0%a6%b2%e0%a6%be-%e0%a6%9a%e0%a6%a4%e0%a7%8d%e0%a6%ac%e0%a6%b0-%e0%a6%b9%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%95%e0%a6%be%e0%a6%a3%e0%a7%8d%e0%a6%a1-%e0%a6%9f/</guid>
      <pubDate>Mon, 16 Nov 2026 07:14:35 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Shapla-Killing-ICT-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Shapla-Killing-ICT-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Shapla-Killing-ICT-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শাপলা চত্বর হত্যাকাণ্ড: ট্রাইব্যুনালে হাজির ১১ আসামি" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর মতিঝিলের শাপলা চত্বরে হেফাজতে ইসলামের সমাবেশ ঘিরে সংঘটিত হত্যাকাণ্ডের ঘটনায় মানবতাবিরোধী অপরাধের মামলায় গ্রেফতার ১১ আসামিকে আন্তর্জাতিক অপরাধ ট্রাইব্যুনালে হাজির করা হয়েছে। সোমবার (১৬ নভেম্বর) সকালে কারাগার থেকে কড়া নিরাপত্তার মধ্য দিয়ে ১০ আসামিকে ট্রাইব্যুনালে আনা হয়। পরে দুপুর ১২টা ১ মিনি&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982582/%e0%a6%b6%e0%a6%be%e0%a6%aa%e0%a6%b2%e0%a6%be-%e0%a6%9a%e0%a6%a4%e0%a7%8d%e0%a6%ac%e0%a6%b0-%e0%a6%b9%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%95%e0%a6%be%e0%a6%a3%e0%a7%8d%e0%a6%a1-%e0%a6%9f/">অর্থসূচক</source>
    </item>
    <item>
      <title>পোশাকশ্রমিকদের নতুন মজুরি নির্ধারণের বৈঠক স্থগিত</title>
      <link>https://www.arthosuchak.com/archives/982570/%e0%a6%aa%e0%a7%8b%e0%a6%b6%e0%a6%be%e0%a6%95%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a6%ae%e0%a6%bf%e0%a6%95%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%ae%e0%a6%9c%e0%a7%81-2/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982570/%e0%a6%aa%e0%a7%8b%e0%a6%b6%e0%a6%be%e0%a6%95%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a6%ae%e0%a6%bf%e0%a6%95%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%ae%e0%a6%9c%e0%a7%81-2/</guid>
      <pubDate>Mon, 16 Nov 2026 06:50:44 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2025/07/Garments-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2025/07/Garments-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2025/07/Garments-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পোশাকশ্রমিকদের নতুন মজুরি নির্ধারণের বৈঠক স্থগিত" /&gt;&lt;/p&gt;&lt;p&gt;তৈরি পোশাকশিল্পের শ্রমিক ও কর্মচারীদের নতুন ন্যূনতম মজুরি নির্ধারণে গঠিত মজুরি বোর্ডের তৃতীয় সভা স্থগিত করা হয়েছে। অনিবার্য কারণ দেখিয়ে নির্ধারিত এ সভা স্থগিত করা হয়। সোমবার (১৬ নভেম্বর) সকালে বোর্ড সচিব রাইসা আফরোজ এক নোটিসে এ সিদ্ধান্তের কথা জানান। এতে বলা হয়, সোমবার বেলা ১১টায় শ্রম অধিদপ্তরে মজু&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982570/%e0%a6%aa%e0%a7%8b%e0%a6%b6%e0%a6%be%e0%a6%95%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a6%ae%e0%a6%bf%e0%a6%95%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%ae%e0%a6%9c%e0%a7%81-2/">অর্থসূচক</source>
    </item>
    <item>
      <title>এক দিনেই শেয়ারের দর কমেছে ২৯%, ইন্টেলের বিরুদ্ধে মামলা</title>
      <link>https://www.arthosuchak.com/archives/982578/%e0%a6%8f%e0%a6%95-%e0%a6%a6%e0%a6%bf%e0%a6%a8%e0%a7%87%e0%a6%87-%e0%a6%b6%e0%a7%87%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%a6%e0%a6%b0-%e0%a6%95%e0%a6%ae%e0%a7%87%e0%a6%9b/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982578/%e0%a6%8f%e0%a6%95-%e0%a6%a6%e0%a6%bf%e0%a6%a8%e0%a7%87%e0%a6%87-%e0%a6%b6%e0%a7%87%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%a6%e0%a6%b0-%e0%a6%95%e0%a6%ae%e0%a7%87%e0%a6%9b/</guid>
      <pubDate>Mon, 16 Nov 2026 06:39:09 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/10/Intel-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/10/Intel-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/10/Intel-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এক দিনেই শেয়ারের দর কমেছে ২৯%, ইন্টেলের বিরুদ্ধে মামলা" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাষ্ট্রের চিপ নির্মাতা প্রতিষ্ঠান ইন্টেলের বিরুদ্ধে প্রতারণার অভিযোগে মামলা করেছেন কোম্পানিটির বিনিয়োগকারীরা। ব্যক্তিগত কম্পিউটার (পিসি) বিক্রিতে দীর্ঘস্থায়ী মন্দা এবং অতিরিক্ত পণ্য মজুতের প্রভাব সম্পর্কে বিনিয়োগকারীদের যথাসময়ে তথ্য না দেওয়ার অভিযোগে এ মামলা করা হয়েছে। এক দিনেই কোম্পানিটির শেয়া&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982578/%e0%a6%8f%e0%a6%95-%e0%a6%a6%e0%a6%bf%e0%a6%a8%e0%a7%87%e0%a6%87-%e0%a6%b6%e0%a7%87%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%a6%e0%a6%b0-%e0%a6%95%e0%a6%ae%e0%a7%87%e0%a6%9b/">অর্থসূচক</source>

    <item>
      <title>২৪ ঘণ্টায় হাম উপসর্গে মৃত্যু ৫, মোট মৃত্যু ১৩০৪ জন</title>
      <link>https://www.arthosuchak.com/archives/982152/%e0%a7%a8%e0%a7%aa-%e0%a6%98%e0%a6%a3%e0%a7%8d%e0%a6%9f%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%b9%e0%a6%be%e0%a6%ae-%e0%a6%89%e0%a6%aa%e0%a6%b8%e0%a6%b0%e0%a7%8d%e0%a6%97%e0%a7%87-%e0%a6%ae%e0%a7%83/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982152/%e0%a7%a8%e0%a7%aa-%e0%a6%98%e0%a6%a3%e0%a7%8d%e0%a6%9f%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%b9%e0%a6%be%e0%a6%ae-%e0%a6%89%e0%a6%aa%e0%a6%b8%e0%a6%b0%e0%a7%8d%e0%a6%97%e0%a7%87-%e0%a6%ae%e0%a7%83/</guid>
      <pubDate>Fri, 13 Nov 2026 10:55:39 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/08/Hum-Sastho-Adhidaotar-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/08/Hum-Sastho-Adhidaotar-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/08/Hum-Sastho-Adhidaotar-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="২৪ ঘণ্টায় হাম উপসর্গে মৃত্যু ৫, মোট মৃত্যু ১৩০৪ জন" /&gt;&lt;/p&gt;&lt;p&gt;দেশে গত ২৪ ঘণ্টায় হাম ও হামের উপসর্গ নিয়ে আরও পাঁচ শিশুর মৃত্যু হয়েছে। এ নিয়ে ১৫ মার্চ থেকে হাম ও হামের উপসর্গে এ পর্যন্ত মোট মৃতের সংখ্যা বেড়ে হয়েছে এক হাজার ৩০৪ জন। তবে এ সময়ে নিশ্চিত হামে কারও মৃত্যু নথিভুক্ত হয়নি। শুক্রবার (১৩ নভেম্বর) স্বাস্থ্য অধিদপ্তরের দেওয়া এক বার্তায় এ তথ্য জানানো হয়। [&amp;#8&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982152/%e0%a7%a8%e0%a7%aa-%e0%a6%98%e0%a6%a3%e0%a7%8d%e0%a6%9f%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%b9%e0%a6%be%e0%a6%ae-%e0%a6%89%e0%a6%aa%e0%a6%b8%e0%a6%b0%e0%a7%8d%e0%a6%97%e0%a7%87-%e0%a6%ae%e0%a7%83/">অর্থসূচক</source>
    </item>
    <item>
      <title>সাপ্তাহিক দরপতনের শীর্ষে ব্যাংক এশিয়া ফার্স্ট পারপেচুয়াল বন্ড</title>
      <link>https://www.arthosuchak.com/archives/982149/%e0%a6%b8%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%b9%e0%a6%bf%e0%a6%95-%e0%a6%a6%e0%a6%b0%e0%a6%aa%e0%a6%a4%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%b6%e0%a7%80%e0%a6%b0%e0%a7%8d%e0%a6%b7-55/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982149/%e0%a6%b8%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%b9%e0%a6%bf%e0%a6%95-%e0%a6%a6%e0%a6%b0%e0%a6%aa%e0%a6%a4%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%b6%e0%a7%80%e0%a6%b0%e0%a7%8d%e0%a6%b7-55/</guid>

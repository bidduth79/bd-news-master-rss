    <item>
      <title>‘জয় বাংলা’ স্লোগান দিয়ে গ্রামীণ ব্যাংক কার্যালয়ে আগুন</title>
      <link>https://www.arthosuchak.com/archives/981650/%e0%a6%9c%e0%a6%af%e0%a6%bc-%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be-%e0%a6%b8%e0%a7%8d%e0%a6%b2%e0%a7%8b%e0%a6%97%e0%a6%be%e0%a6%a8-%e0%a6%a6%e0%a6%bf%e0%a6%af%e0%a6%bc-2/</link>

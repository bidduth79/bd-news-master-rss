      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/03/Parlament26-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/03/Parlament26-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সংসদে বিশেষ সৌরবিদ্যুৎ স্থাপন বিল-২০২৬ পাস" /&gt;&lt;/p&gt;&lt;p&gt;দেশে সৌরবিদ্যুৎ স্থাপন কার্যক্রম সম্প্রসারণ ও দ্রুততর করার লক্ষ্যে জাতীয় সংসদে ‘বিশেষ সৌরবিদ্যুৎ স্থাপন বিল-২০২৬’ পাস হয়েছে। বুধবার জাতীয় সংসদে বিদ্যুৎ, জ্বালানি ও খনিজ সম্পদ মন্ত্রী ইকবাল হাসান মাহমুদের পক্ষে প্রতিমন্ত্রী অনিন্দ্য ইসলাম অমিত বিলটি উত্থাপন করেন। স্পিকার হাফিজ উদ্দিন আহমদের সভাপতিত্ব&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983018/%e0%a6%b8%e0%a6%82%e0%a6%b8%e0%a6%a6%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%87%e0%a6%b7-%e0%a6%b8%e0%a7%8c%e0%a6%b0%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a7%81%e0%a7%8e-%e0%a6%b8/">অর্থসূচক</source>

    <item>
      <title>সরকার স্বাস্থ্য খাতে ইতিহাসের সর্বোচ্চ বাজেট বরাদ্দ দিয়েছে: সমাজকল্যাণমন্ত্রী</title>
      <link>https://www.arthosuchak.com/archives/981617/%e0%a6%b8%e0%a6%b0%e0%a6%95%e0%a6%be%e0%a6%b0-%e0%a6%b8%e0%a7%8d%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a7%8d%e0%a6%a5%e0%a7%8d%e0%a6%af-%e0%a6%96%e0%a6%be%e0%a6%a4%e0%a7%87-%e0%a6%87%e0%a6%a4%e0%a6%bf/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981617/%e0%a6%b8%e0%a6%b0%e0%a6%95%e0%a6%be%e0%a6%b0-%e0%a6%b8%e0%a7%8d%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a7%8d%e0%a6%a5%e0%a7%8d%e0%a6%af-%e0%a6%96%e0%a6%be%e0%a6%a4%e0%a7%87-%e0%a6%87%e0%a6%a4%e0%a6%bf/</guid>

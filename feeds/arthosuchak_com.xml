      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2021/02/mobile_phone-300x171.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2021/02/mobile_phone-300x171.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2021/02/mobile_phone-300x171.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শ্রেণিকক্ষে শিক্ষক-শিক্ষার্থীদের মোবাইল ব্যবহার নিষিদ্ধ: শিক্ষামন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;মাধ্যমিক পর্যায়ের শিক্ষাপ্রতিষ্ঠানে শ্রেণিকক্ষে শিক্ষক ও শিক্ষার্থীদের মোবাইল ফোন নিয়ে প্রবেশ ও ব্যবহার নিষিদ্ধ করা হয়েছে। বুধবার জাতীয় সংসদে শিক্ষামন্ত্রী ড. আ ন ম এহছানুল হক মিলন এ তথ্য জানান। চট্টগ্রাম-২ আসনের সরকারি দলের সংসদ সদস্য সরোয়ার আলমগীরের টেবিলে উপস্থাপিত তারকা চিহ্নিত লিখিত প্রশ্নের জব&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983029/%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%a3%e0%a6%bf%e0%a6%95%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a7%87-%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%95-%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7/">অর্থসূচক</source>

      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/China-Amba-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/China-Amba-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/China-Amba-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাংলাদেশের সার্বভৌমত্ব ও অখণ্ডতার প্রতি চীনের সমর্থন অব্যাহত থাকবে: রাষ্ট্রদূত" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশের স্বাধীনতা, সার্বভৌমত্ব ও ভৌগোলিক অখণ্ডতার প্রতি দৃঢ় সমর্থন পুনর্ব্যক্ত করেছে চীন। দেশটি বলেছে, বাংলাদেশের সঙ্গে তাদের বেল্ট অ্যান্ড রোড ইনিশিয়েটিভ (বিআরআই) সহযোগিতা কোনো তৃতীয় দেশের বিরুদ্ধে নয় কিংবা কোনো একচেটিয়া জোট গঠনের উদ্দেশ্যেও নয়। ঢাকায় চীনা দূতাবাসের চার্জ দ্য অ্যাফেয়ার্স ড. লিউ &lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983725/%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%ac%e0%a6%ad%e0%a7%8c%e0%a6%ae%e0%a6%a4%e0%a7%8d%e0%a6%ac-%e0%a6%93/">অর্থসূচক</source>
    </item>
    <item>
      <title>হুয়াংয়ের ফেরার খবরে এনভিডিয়ার শেয়ারের দাম আবারও বাড়ছে</title>
      <link>https://www.arthosuchak.com/archives/983722/%e0%a6%b9%e0%a7%81%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%82%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%b0-%e0%a6%ab%e0%a7%87%e0%a6%b0%e0%a6%be%e0%a6%b0-%e0%a6%96%e0%a6%ac%e0%a6%b0%e0%a7%87-%e0%a6%8f%e0%a6%a8/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983722/%e0%a6%b9%e0%a7%81%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%82%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%b0-%e0%a6%ab%e0%a7%87%e0%a6%b0%e0%a6%be%e0%a6%b0-%e0%a6%96%e0%a6%ac%e0%a6%b0%e0%a7%87-%e0%a6%8f%e0%a6%a8/</guid>
      <pubDate>Mon, 23 Nov 2026 15:46:16 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/NVDR-300x168.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/NVDR-300x168.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/NVDR-300x168.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হুয়াংয়ের ফেরার খবরে এনভিডিয়ার শেয়ারের দাম আবারও বাড়ছে" /&gt;&lt;/p&gt;&lt;p&gt;সিইও হিসেবে জেনসেন হুয়াংয়ের ফেরার খবরে এনভিডিয়ার শেয়ারের দাম আবারও বাড়তে শুরু করেছে। ইতোমধ্যেই কোম্পানির শেয়ারের দাম প্রায় ৩০ শতাংশ বেড়ে গেছে বলে জানা যাচ্ছে। এর আগে, তাকে পদচ্যুত করার পর এনভিডিয়ার শেয়ারের দামে বড় পতন লক্ষ্য করা গিয়েছিল। স্বপদে পুনর্ববহাল হওয়ার পর এক বিবৃতিতে কোম্পানির বোর্ডে&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983722/%e0%a6%b9%e0%a7%81%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%82%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%b0-%e0%a6%ab%e0%a7%87%e0%a6%b0%e0%a6%be%e0%a6%b0-%e0%a6%96%e0%a6%ac%e0%a6%b0%e0%a7%87-%e0%a6%8f%e0%a6%a8/">অর্থসূচক</source>
    </item>
    <item>
      <title>তিন প্রান্তিকে লংকাবাংলা ফাইন্যান্সের ইপিএস ৮৫ পয়সা</title>
      <link>https://www.arthosuchak.com/archives/983719/%e0%a6%b2%e0%a6%82%e0%a6%95%e0%a6%be-%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be-%e0%a6%ab%e0%a6%be%e0%a6%87%e0%a6%a8%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%b8%e0%a7%87%e0%a6%b0-2/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983719/%e0%a6%b2%e0%a6%82%e0%a6%95%e0%a6%be-%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be-%e0%a6%ab%e0%a6%be%e0%a6%87%e0%a6%a8%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%b8%e0%a7%87%e0%a6%b0-2/</guid>
      <pubDate>Mon, 23 Nov 2026 15:44:08 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2021/03/Lankabangla-Finance-300x181.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2021/03/Lankabangla-Finance-300x181.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2021/03/Lankabangla-Finance-300x181.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="তিন প্রান্তিকে লংকাবাংলা ফাইন্যান্সের ইপিএস ৮৫ পয়সা" /&gt;&lt;/p&gt;&lt;p&gt;পুঁজিবাজারে তালিকাভুক্ত লংকাবাংলা ফাইন্যান্স পিএলসি গত ৩০ সেপ্টেম্বর, ২০২৬ তারিখে সমাপ্ত তৃতীয় প্রান্তিকের (জুলাই’২৬-সেপ্টেম্বর’২৬) অনিরীক্ষিত আর্থিক প্রতিবেদন প্রকাশ করেছে. সোমবার (২৩ নভেম্বর) অনুষ্ঠিত কোম্পানিটির পরিচালনা পর্ষদের বৈঠকে চলতি হিসাববছরের তৃতীয় প্রান্তিকের আর্থিক প্রতিবেদন পর্যালোচনা &lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983719/%e0%a6%b2%e0%a6%82%e0%a6%95%e0%a6%be-%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be-%e0%a6%ab%e0%a6%be%e0%a6%87%e0%a6%a8%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%b8%e0%a7%87%e0%a6%b0-2/">অর্থসূচক</source>
    </item>
    <item>
      <title>বিদেশি বিনিয়োগের প্রক্রিয়া সহজ ও গতিশীল করতে কাজ করছে সরকার: প্রধানমন্ত্রী</title>
      <link>https://www.arthosuchak.com/archives/983716/%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a6%bf-%e0%a6%ac%e0%a6%bf%e0%a6%a8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%8b%e0%a6%97%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%95%e0%a7%8d%e0%a6%b0/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983716/%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a6%bf-%e0%a6%ac%e0%a6%bf%e0%a6%a8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%8b%e0%a6%97%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%95%e0%a7%8d%e0%a6%b0/</guid>
      <pubDate>Mon, 23 Nov 2026 15:15:29 +0000</pubDate>

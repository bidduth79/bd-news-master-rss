      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/NCC-BB-for-Frozen-Food-300x150.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/NCC-BB-for-Frozen-Food-300x150.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হিমায়িত খাদ্য রপ্তানি খাতে ঋণ দেবে এনসিসি ব্যাংক" /&gt;&lt;/p&gt;&lt;p&gt;দেশের রপ্তানিমুখী হিমায়িত খাদ্যশিল্পের বিকাশ ও রপ্তানি বহুমুখীকরণে উদ্যোক্তাদের অর্থায়ন সুবিধা দেবে এনসিসি ব্যাংক পিএলসি। এ লক্ষ্যে বাংলাদেশ ব্যাংকের ২ হাজার কোটি টাকার প্রাক্‌-অর্থায়ন তহবিলের আওতায় অংশগ্রহণ চুক্তি স্বাক্ষর করেছে ব্যাংকটি। সম্প্রতি বাংলাদেশ ব্যাংকের প্রধান কার্যালয়ে আয়োজিত এক অনুষ্ঠ&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982846/%e0%a6%b9%e0%a6%bf%e0%a6%ae%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a6%bf%e0%a6%a4-%e0%a6%96%e0%a6%be%e0%a6%a6%e0%a7%8d%e0%a6%af-%e0%a6%b0%e0%a6%aa%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%a8%e0%a6%bf-%e0%a6%96/">অর্থসূচক</source>
    </item>
    <item>
      <title>ইরান যুদ্ধ শেষ করতে শি ও পুতিনের সাহায্য চাইবেন ট্রাম্প</title>
      <link>https://www.arthosuchak.com/archives/982849/%e0%a6%87%e0%a6%b0%e0%a6%be%e0%a6%a8-%e0%a6%af%e0%a7%81%e0%a6%a6%e0%a7%8d%e0%a6%a7-%e0%a6%b6%e0%a7%87%e0%a6%b7-%e0%a6%95%e0%a6%b0%e0%a6%a4%e0%a7%87-%e0%a6%b6%e0%a6%bf-%e0%a6%93-%e0%a6%aa%e0%a7%81/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982849/%e0%a6%87%e0%a6%b0%e0%a6%be%e0%a6%a8-%e0%a6%af%e0%a7%81%e0%a6%a6%e0%a7%8d%e0%a6%a7-%e0%a6%b6%e0%a7%87%e0%a6%b7-%e0%a6%95%e0%a6%b0%e0%a6%a4%e0%a7%87-%e0%a6%b6%e0%a6%bf-%e0%a6%93-%e0%a6%aa%e0%a7%81/</guid>

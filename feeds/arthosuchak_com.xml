      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Bank-Gov-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Bank-Gov-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাষ্ট্রায়ত্ত ব্যাংকের পর্ষদে থাকতে পারবেন না সচিবরা" /&gt;&lt;/p&gt;&lt;p&gt;সরকারি মালিকানাধীন ব্যাংক ও আর্থিক প্রতিষ্ঠানের পরিচালনা পর্ষদে কর্মরত কোনো সচিব বা সমমর্যাদার কর্মকর্তা চেয়ারম্যান বা পরিচালক হতে পারবেন না। সরকারের শেয়ার থাকা বেসরকারি ব্যাংক ও আর্থিক প্রতিষ্ঠানের ক্ষেত্রেও এ নিয়ম কার্যকর হবে। পাশাপাশি পরিচালনা পর্ষদের এক-তৃতীয়াংশ পদে যোগ্য নারী পরিচালক নিয়োগ&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983711/%e0%a6%b0%e0%a6%be%e0%a6%b7%e0%a7%8d%e0%a6%9f%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a6%a4%e0%a7%8d%e0%a6%a4-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%aa/">অর্থসূচক</source>
    </item>
    <item>
      <title>মালিকপক্ষের প্রস্তাবে সন্তুষ্ট নন শ্রমিক নেতারা, আলোচনা অব্যাহত</title>
      <link>https://www.arthosuchak.com/archives/983708/%e0%a6%ae%e0%a6%be%e0%a6%b2%e0%a6%bf%e0%a6%95%e0%a6%aa%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%b8%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%ac%e0%a7%87-%e0%a6%b8%e0%a6%a8/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983708/%e0%a6%ae%e0%a6%be%e0%a6%b2%e0%a6%bf%e0%a6%95%e0%a6%aa%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%b8%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%ac%e0%a7%87-%e0%a6%b8%e0%a6%a8/</guid>
      <pubDate>Mon, 23 Nov 2026 13:57:52 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Babul-Akther-300x168.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Babul-Akther-300x168.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Babul-Akther-300x168.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মালিকপক্ষের প্রস্তাবে সন্তুষ্ট নন শ্রমিক নেতারা, আলোচনা অব্যাহত" /&gt;&lt;/p&gt;&lt;p&gt;তৈরি পোশাকশ্রমিকদের নতুন ন্যূনতম মজুরি নির্ধারণে মালিকপক্ষ তাদের প্রস্তাব জমা দিয়েছে। তবে মালিক ও শ্রমিকপক্ষের প্রস্তাবের মধ্যে উল্লেখযোগ্য ব্যবধান থাকায় এখনো কোনো ঐকমত্যে পৌঁছাতে পারেনি নিম্নতম মজুরি বোর্ড। এ ব্যবধান কমিয়ে গ্রহণযোগ্য মজুরি কাঠামো নির্ধারণে আলোচনা অব্যাহত রয়েছে। দু&amp;#8217;পক্ষের মধ্য&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983708/%e0%a6%ae%e0%a6%be%e0%a6%b2%e0%a6%bf%e0%a6%95%e0%a6%aa%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%b8%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%ac%e0%a7%87-%e0%a6%b8%e0%a6%a8/">অর্থসূচক</source>
    </item>
    <item>
      <title>দক্ষিণ আফ্রিকার বিপক্ষে ওয়ানডে দল ঘোষণা বিসিবির</title>
      <link>https://www.arthosuchak.com/archives/983704/%e0%a6%a6%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%bf%e0%a6%a3-%e0%a6%86%e0%a6%ab%e0%a7%8d%e0%a6%b0%e0%a6%bf%e0%a6%95%e0%a6%be%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%aa%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a7%87/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983704/%e0%a6%a6%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%bf%e0%a6%a3-%e0%a6%86%e0%a6%ab%e0%a7%8d%e0%a6%b0%e0%a6%bf%e0%a6%95%e0%a6%be%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%aa%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a7%87/</guid>
      <pubDate>Mon, 23 Nov 2026 13:50:19 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/bd-cricket-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/bd-cricket-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/bd-cricket-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দক্ষিণ আফ্রিকার বিপক্ষে ওয়ানডে দল ঘোষণা বিসিবির" /&gt;&lt;/p&gt;&lt;p&gt;দক্ষিণ আফ্রিকার বিপক্ষে তিন ম্যাচের ওয়ানডে সিরিজের জন্য ১৫ সদস্যের দল ঘোষণা করেছে বাংলাদেশ ক্রিকেট বোর্ড (বিসিবি)। ঘোষিত দলে প্রায় তিন বছর পর ফিরেছেন ব্যাটার ইয়াসির আলী চৌধুরী। এ ছাড়া দলে ফিরেছেন পারভেজ হোসেন ইমন, নাঈম শেখ, জাকের আলী অনিক ও খালেদ আহমেদ। সোমবার (২৩ নভেম্বর) আসন্ন সিরিজের জন্য দল ঘোষণ&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983704/%e0%a6%a6%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%bf%e0%a6%a3-%e0%a6%86%e0%a6%ab%e0%a7%8d%e0%a6%b0%e0%a6%bf%e0%a6%95%e0%a6%be%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%aa%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a7%87/">অর্থসূচক</source>
    </item>
    <item>
      <title>যুক্তরাষ্ট্র শর্ত মানলেই দ্রুত খুলবে হরমুজ প্রণালি: ইরান</title>
      <link>https://www.arthosuchak.com/archives/983701/%e0%a6%af%e0%a7%81%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%b0%e0%a6%be%e0%a6%b7%e0%a7%8d%e0%a6%9f%e0%a7%8d%e0%a6%b0-%e0%a6%b6%e0%a6%b0%e0%a7%8d%e0%a6%a4-%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a6%b2%e0%a7%87%e0%a6%87/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983701/%e0%a6%af%e0%a7%81%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%b0%e0%a6%be%e0%a6%b7%e0%a7%8d%e0%a6%9f%e0%a7%8d%e0%a6%b0-%e0%a6%b6%e0%a6%b0%e0%a7%8d%e0%a6%a4-%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a6%b2%e0%a7%87%e0%a6%87/</guid>
      <pubDate>Mon, 23 Nov 2026 13:29:33 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/iran-1-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/iran-1-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/iran-1-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যুক্তরাষ্ট্র শর্ত মানলেই দ্রুত খুলবে হরমুজ প্রণালি: ইরান" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাষ্ট্র ইরানের শর্ত মেনে নিলে খুব দ্রুত হরমুজ প্রণালি পুনরায় খুলে দেওয়ার পদক্ষেপ নিতে পারে বলে জানিয়েছেন দেশটির পররাষ্ট্র মন্ত্রণালয়ের মুখপাত্র ইসমাইল বাঘাই। সোমবার (২৩ নভেম্বর) মিডল ইস্ট আই এর প্রতিবেদনে এসব তথ্য জানা যায়। ইসমাইল বাঘাই বলেন, ইরান তার প্রতিশ্রুতি রক্ষায় অটল রয়েছে এবং অপর পক্ষ স&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983701/%e0%a6%af%e0%a7%81%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%b0%e0%a6%be%e0%a6%b7%e0%a7%8d%e0%a6%9f%e0%a7%8d%e0%a6%b0-%e0%a6%b6%e0%a6%b0%e0%a7%8d%e0%a6%a4-%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a6%b2%e0%a7%87%e0%a6%87/">অর্থসূচক</source>
    </item>
    <item>
      <title>গ্রামীণ ব্যাংকে অগ্নিসংযোগ বন্ধ ও হামলাকারীদের বিরুদ্ধে সোচ্চার হওয়ার আহ্বান ড. ইউনূসের</title>
      <link>https://www.arthosuchak.com/archives/983698/%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ae%e0%a7%80%e0%a6%a3-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95%e0%a7%87-%e0%a6%85%e0%a6%97%e0%a7%8d%e0%a6%a8%e0%a6%bf%e0%a6%b8%e0%a6%82%e0%a6%af/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983698/%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ae%e0%a7%80%e0%a6%a3-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95%e0%a7%87-%e0%a6%85%e0%a6%97%e0%a7%8d%e0%a6%a8%e0%a6%bf%e0%a6%b8%e0%a6%82%e0%a6%af/</guid>
      <pubDate>Mon, 23 Nov 2026 13:15:12 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2025/03/dr-yunus-20250303101721-1-300x150.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2025/03/dr-yunus-20250303101721-1-300x150.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2025/03/dr-yunus-20250303101721-1-300x150.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গ্রামীণ ব্যাংকে অগ্নিসংযোগ বন্ধ ও হামলাকারীদের বিরুদ্ধে সোচ্চার হওয়ার আহ্বান ড. ইউনূসের" /&gt;&lt;/p&gt;&lt;p&gt;গ্রামীণ ব্যাংকের বিভিন্ন শাখায় ধারাবাহিক অগ্নিসংযোগ বন্ধ এবং হামলাকারীদের দ্রুত বিচারের আওতায় আনার দাবি জানিয়েছেন নোবেলজয়ী অধ্যাপক ও অন্তর্বর্তী সরকারের সাবেক প্রধান উপদেষ্টা ড. মুহাম্মদ ইউনূস। তিনি বলেছেন, নভেম্বরের শুরু থেকে প্রায় প্রতিদিন পেট্রলবোমা দিয়ে গ্রামীণ ব্যাংকের শাখায় হামলা চালানো হচ্ছে।&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983698/%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ae%e0%a7%80%e0%a6%a3-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95%e0%a7%87-%e0%a6%85%e0%a6%97%e0%a7%8d%e0%a6%a8%e0%a6%bf%e0%a6%b8%e0%a6%82%e0%a6%af/">অর্থসূচক</source>

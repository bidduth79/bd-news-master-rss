    </item>
    <item>
      <title>দেশের আইনশৃঙ্খলা পরিস্থিতি নিয়ন্ত্রণে রয়েছে: স্বরাষ্ট্রমন্ত্রী</title>
      <link>https://www.arthosuchak.com/archives/982507/%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%87%e0%a6%b0-%e0%a6%86%e0%a6%87%e0%a6%a8%e0%a6%b6%e0%a7%83%e0%a6%99%e0%a7%8d%e0%a6%96%e0%a6%b2%e0%a6%be-%e0%a6%aa%e0%a6%b0%e0%a6%bf%e0%a6%b8%e0%a7%8d%e0%a6%a5%e0%a6%bf/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982507/%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%87%e0%a6%b0-%e0%a6%86%e0%a6%87%e0%a6%a8%e0%a6%b6%e0%a7%83%e0%a6%99%e0%a7%8d%e0%a6%96%e0%a6%b2%e0%a6%be-%e0%a6%aa%e0%a6%b0%e0%a6%bf%e0%a6%b8%e0%a7%8d%e0%a6%a5%e0%a6%bf/</guid>

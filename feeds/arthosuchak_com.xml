    <item>
      <title>জগন্নাথ বিশ্ববিদ্যালয়ের সাথে রূপালী ব্যাংকের চুক্তি সম্পন্ন</title>
      <link>https://www.arthosuchak.com/archives/982092/%e0%a6%9c%e0%a6%97%e0%a6%a8%e0%a7%8d%e0%a6%a8%e0%a6%be%e0%a6%a5-%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%ac%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%b2%e0%a6%af%e0%a6%bc-3/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982092/%e0%a6%9c%e0%a6%97%e0%a6%a8%e0%a7%8d%e0%a6%a8%e0%a6%be%e0%a6%a5-%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%ac%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%b2%e0%a6%af%e0%a6%bc-3/</guid>
      <pubDate>Thu, 12 Nov 2026 16:31:33 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/JU-RuPAL-300x149.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/JU-RuPAL-300x149.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/JU-RuPAL-300x149.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জগন্নাথ বিশ্ববিদ্যালয়ের সাথে রূপালী ব্যাংকের চুক্তি সম্পন্ন" /&gt;&lt;/p&gt;&lt;p&gt;২০২৬-২০২৭ শিক্ষাবর্ষে আন্ডারগ্র্যাজুয়েট প্রোগ্রামে ভর্তি পরীক্ষার পর ভর্তি-ইচ্ছুক শিক্ষার্থীদের ভর্তি কার্যক্রম ও পেমেন্ট সুবিধা আরও সহজ, দ্রুত ও নিরাপদ করার জন্য রূপালী ব্যাংক পিএলসি-এর নিজস্ব ব্যবস্থাপনায় পরিচালিত মোবাইল ফিন্যান্সিয়াল সার্ভিস (MFS) &amp;#8220;রূপালীক্যাশ&amp;#8221; নিরলস ভাবে কাজ করে যা&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982092/%e0%a6%9c%e0%a6%97%e0%a6%a8%e0%a7%8d%e0%a6%a8%e0%a6%be%e0%a6%a5-%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%ac%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%b2%e0%a6%af%e0%a6%bc-3/">অর্থসূচক</source>
    </item>

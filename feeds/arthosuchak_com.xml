    <item>
      <title>হুন্দাই গাড়ি কিনতে ট্রাস্ট ব্যাংকের অটো লোন সুবিধা</title>
      <link>https://www.arthosuchak.com/archives/984098/%e0%a6%b9%e0%a7%81%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%be%e0%a6%87-%e0%a6%97%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a6%bf-%e0%a6%95%e0%a6%bf%e0%a6%a8%e0%a6%a4%e0%a7%87-%e0%a6%9f%e0%a7%8d%e0%a6%b0%e0%a6%be/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/984098/%e0%a6%b9%e0%a7%81%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%be%e0%a6%87-%e0%a6%97%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a6%bf-%e0%a6%95%e0%a6%bf%e0%a6%a8%e0%a6%a4%e0%a7%87-%e0%a6%9f%e0%a7%8d%e0%a6%b0%e0%a6%be/</guid>
      <pubDate>Wed, 25 Nov 2026 11:56:24 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Trust-Bank-PLC-2-300x169.jpeg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Trust-Bank-PLC-2-300x169.jpeg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Trust-Bank-PLC-2-300x169.jpeg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হুন্দাই গাড়ি কিনতে ট্রাস্ট ব্যাংকের অটো লোন সুবিধা" /&gt;&lt;/p&gt;&lt;p&gt;হুন্দাই গাড়ির ক্রেতাদের জন্য সহজ ও সাশ্রয়ী অটো লোন সুবিধা চালু করতে ট্রাস্ট ব্যাংক পিএলসি এবং বাংলাদেশে হুন্দাই গাড়ির অফিশিয়াল পরিবেশক ফেয়ার টেকনোলজি লিমিটেডের মধ্যে চুক্তি স্বাক্ষরিত হয়েছে। এ চুক্তির আওতায় হুন্দাই গাড়ির গ্রাহকরা কোনো প্রসেসিং ফি ছাড়াই প্রতিযোগিতামূলক সুদের হারে ট্রাস্ট ব্যাংক থেকে &lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/984098/%e0%a6%b9%e0%a7%81%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%be%e0%a6%87-%e0%a6%97%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a6%bf-%e0%a6%95%e0%a6%bf%e0%a6%a8%e0%a6%a4%e0%a7%87-%e0%a6%9f%e0%a7%8d%e0%a6%b0%e0%a6%be/">অর্থসূচক</source>
    </item>
    <item>
      <title>ডেঙ্গুতে মৃত্যু আরও ২, আক্রান্ত ১১৫২</title>
      <link>https://www.arthosuchak.com/archives/984102/%e0%a6%a1%e0%a7%87%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%81%e0%a6%a4%e0%a7%87-%e0%a6%ae%e0%a7%83%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a7%81-%e0%a6%86%e0%a6%b0%e0%a6%93-%e0%a7%a8-%e0%a6%86%e0%a6%95%e0%a7%8d-3/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/984102/%e0%a6%a1%e0%a7%87%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%81%e0%a6%a4%e0%a7%87-%e0%a6%ae%e0%a7%83%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a7%81-%e0%a6%86%e0%a6%b0%e0%a6%93-%e0%a7%a8-%e0%a6%86%e0%a6%95%e0%a7%8d-3/</guid>
      <pubDate>Wed, 25 Nov 2026 11:49:01 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2023/09/Dengu-300x156.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2023/09/Dengu-300x156.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2023/09/Dengu-300x156.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডেঙ্গুতে মৃত্যু আরও ২, আক্রান্ত ১১৫২" /&gt;&lt;/p&gt;&lt;p&gt;সারা দেশে ডেঙ্গুতে আক্রান্ত হয়ে আরও ২ জনের মৃত্যু হয়েছে। এছাড়া এই সময়ের মধ্যে ডেঙ্গুতে আক্রান্ত হয়ে নতুন করে হাসপাতালে ভর্তি হয়েছে ১ হাজার ১৫২ জন। বুধবার (২৫ নভেম্বর) স্বাস্থ্য অধিদফতরের প্রকাশিত বিজ্ঞপ্তিতে এ তথ্য জানানো হয়েছে। বিজ্ঞপ্তিতে বলা হয়, মঙ্গলবার সকাল ৮টা থেকে পরবর্তী ২৪ ঘণ্টায় নতুন ভর্তি&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/984102/%e0%a6%a1%e0%a7%87%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%81%e0%a6%a4%e0%a7%87-%e0%a6%ae%e0%a7%83%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a7%81-%e0%a6%86%e0%a6%b0%e0%a6%93-%e0%a7%a8-%e0%a6%86%e0%a6%95%e0%a7%8d-3/">অর্থসূচক</source>
    </item>
    <item>
      <title>আওয়ামী লীগ আর কখনো রাজনীতি করতে পারবে না: স্বরাষ্ট্রমন্ত্রী</title>
      <link>https://www.arthosuchak.com/archives/984088/%e0%a6%86%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%ae%e0%a7%80-%e0%a6%b2%e0%a7%80%e0%a6%97-%e0%a6%86%e0%a6%b0-%e0%a6%95%e0%a6%96%e0%a6%a8%e0%a7%8b-%e0%a6%b0%e0%a6%be%e0%a6%9c%e0%a6%a8%e0%a7%80/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/984088/%e0%a6%86%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%ae%e0%a7%80-%e0%a6%b2%e0%a7%80%e0%a6%97-%e0%a6%86%e0%a6%b0-%e0%a6%95%e0%a6%96%e0%a6%a8%e0%a7%8b-%e0%a6%b0%e0%a6%be%e0%a6%9c%e0%a6%a8%e0%a7%80/</guid>
      <pubDate>Wed, 25 Nov 2026 11:16:22 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/06/Home-minister-Salahuddin-ahmed-1-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/06/Home-minister-Salahuddin-ahmed-1-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/06/Home-minister-Salahuddin-ahmed-1-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আওয়ামী লীগ আর কখনো রাজনীতি করতে পারবে না: স্বরাষ্ট্রমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;স্বরাষ্ট্রমন্ত্রী সালাহউদ্দিন আহমদ বলেছেন, কার্যক্রম নিষিদ্ধ আওয়ামী লীগ তার কর্মকাণ্ডের মাধ্যমে নিজেদের একটি সন্ত্রাসী গোষ্ঠীতে পরিণত করেছে। ২০২৪-এর গণঅভ্যুত্থানে গণহত্যার মাধ্যমে পতন ও পলায়নের পর এ দলটির রাজনৈতিক দল হিসেবে কোনো স্বীকৃতি নেই। দেশের মানুষও তাদেরকে স্বীকৃতি দেবে না। বুধবার বাংলাদেশ সচ&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/984088/%e0%a6%86%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%ae%e0%a7%80-%e0%a6%b2%e0%a7%80%e0%a6%97-%e0%a6%86%e0%a6%b0-%e0%a6%95%e0%a6%96%e0%a6%a8%e0%a7%8b-%e0%a6%b0%e0%a6%be%e0%a6%9c%e0%a6%a8%e0%a7%80/">অর্থসূচক</source>
    </item>
    <item>
      <title>ব্র্যাক বিশ্ববিদ্যালয়ে বিকাশের এক্সপেরিয়েন্স জোন চালু</title>
      <link>https://www.arthosuchak.com/archives/984085/%e0%a6%ac%e0%a7%8d%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%95-%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%ac%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%b2%e0%a6%af%e0%a6%bc-2/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/984085/%e0%a6%ac%e0%a7%8d%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%95-%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%ac%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%b2%e0%a6%af%e0%a6%bc-2/</guid>
      <pubDate>Wed, 25 Nov 2026 11:15:59 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/brac-bkash-300x169.jpeg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/brac-bkash-300x169.jpeg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/brac-bkash-300x169.jpeg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ব্র্যাক বিশ্ববিদ্যালয়ে বিকাশের এক্সপেরিয়েন্স জোন চালু" /&gt;&lt;/p&gt;&lt;p&gt;ব্র্যাক বিশ্ববিদ্যালয়ের শিক্ষক-শিক্ষার্থী ও কর্মকর্তা-কর্মচারীদের জন্য ক্যাম্পাসে ক্যাশলেস লেনদেনের সব ধরনের সেবা সহজলভ্য করতে ‘এক্সপেরিয়েন্স জোন’ চালু করেছে মোবাইল আর্থিক সেবাদাতা প্রতিষ্ঠান বিকাশ। এর ফলে বিশ্ববিদ্যালয় প্রাঙ্গণ থেকেই বিকাশের বিভিন্ন সেবা নিতে পারবেন ব্যবহারকারীরা। পাশাপাশি ক্যাম্পা&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/984085/%e0%a6%ac%e0%a7%8d%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%95-%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%ac%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%b2%e0%a6%af%e0%a6%bc-2/">অর্থসূচক</source>
    </item>
    <item>
      <title>৭ জেলায় নতুন পুলিশ সুপার</title>
      <link>https://www.arthosuchak.com/archives/984081/%e0%a7%ad-%e0%a6%9c%e0%a7%87%e0%a6%b2%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%aa%e0%a7%81%e0%a6%b2%e0%a6%bf%e0%a6%b6-%e0%a6%b8%e0%a7%81%e0%a6%aa%e0%a6%be%e0%a6%b0-2/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/984081/%e0%a7%ad-%e0%a6%9c%e0%a7%87%e0%a6%b2%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%aa%e0%a7%81%e0%a6%b2%e0%a6%bf%e0%a6%b6-%e0%a6%b8%e0%a7%81%e0%a6%aa%e0%a6%be%e0%a6%b0-2/</guid>
      <pubDate>Wed, 25 Nov 2026 11:00:57 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2023/11/Bangladesh-police-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2023/11/Bangladesh-police-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2023/11/Bangladesh-police-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৭ জেলায় নতুন পুলিশ সুপার" /&gt;&lt;/p&gt;&lt;p&gt;দেশের সাত জেলায় নতুন পুলিশ সুপার নিয়োগ দিয়েছে সরকার। বুধবার (২৫ নভেম্বর) স্বরাষ্ট্র মন্ত্রণালয়ের পুলিশ -১ শাখা থেকে এক প্রজ্ঞাপনে এ তথ্য জানানো হয়েছে। এতে সই করেছেন উপসচিব তৌছিফ আহমেদ। প্রজ্ঞাপন অনুযায়ী, সুনামগঞ্জের পুলিশ সুপার করা হয়েছে চট্টগ্রামের উপপুলিশ কমিশনার আমিরুল ইসলামকে, লালমনিরহাটের পুলিশ&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/984081/%e0%a7%ad-%e0%a6%9c%e0%a7%87%e0%a6%b2%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%aa%e0%a7%81%e0%a6%b2%e0%a6%bf%e0%a6%b6-%e0%a6%b8%e0%a7%81%e0%a6%aa%e0%a6%be%e0%a6%b0-2/">অর্থসূচক</source>
    </item>

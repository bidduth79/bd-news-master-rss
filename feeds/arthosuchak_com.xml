    <item>
      <title>আলহাজ টেক্সটাইলের প্রথম প্রান্তিক প্রকাশ</title>
      <link>https://www.arthosuchak.com/archives/981728/%e0%a6%86%e0%a6%b2%e0%a6%b9%e0%a6%be%e0%a6%9c-%e0%a6%9f%e0%a7%87%e0%a6%95%e0%a7%8d%e0%a6%b8%e0%a6%9f%e0%a6%be%e0%a6%87%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a5%e0%a6%ae/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981728/%e0%a6%86%e0%a6%b2%e0%a6%b9%e0%a6%be%e0%a6%9c-%e0%a6%9f%e0%a7%87%e0%a6%95%e0%a7%8d%e0%a6%b8%e0%a6%9f%e0%a6%be%e0%a6%87%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a5%e0%a6%ae/</guid>
      <pubDate>Wed, 11 Nov 2026 18:35:00 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2022/10/alhaj-textile-al-haj-textile-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2022/10/alhaj-textile-al-haj-textile-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2022/10/alhaj-textile-al-haj-textile-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আলহাজ টেক্সটাইলের প্রথম প্রান্তিক প্রকাশ" /&gt;&lt;/p&gt;&lt;p&gt;পুঁজিবাজারে তালিকাভুক্ত কোম্পানি আলহাজ টেক্সটাইল লিমিটেড ৩০ সেপ্টেম্বর, ২০২৬ তারিখে সমাপ্ত প্রথম প্রান্তিকের (জুলাই’২৬-সেপ্টেম্বর’২৬) অনিরীক্ষিত আর্থিক প্রতিবেদন প্রকাশ করেছে। বুধবার (১১ নভেম্বর) অনুষ্ঠিত কোম্পানির পরিচালনা পর্ষদের বৈঠকে চলতি হিসাববছরের প্রথম প্রান্তিকের আর্থিক প্রতিবেদন পর্যালোচনা &lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981728/%e0%a6%86%e0%a6%b2%e0%a6%b9%e0%a6%be%e0%a6%9c-%e0%a6%9f%e0%a7%87%e0%a6%95%e0%a7%8d%e0%a6%b8%e0%a6%9f%e0%a6%be%e0%a6%87%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a5%e0%a6%ae/">অর্থসূচক</source>
    </item>

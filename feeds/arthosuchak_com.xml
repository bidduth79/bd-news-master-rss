    </item>
    <item>
      <title>মাগুরা মাল্টিপ্লেক্সের লভ্যাংশ ঘোষণা</title>
      <link>https://www.arthosuchak.com/archives/981425/%e0%a6%ae%e0%a6%be%e0%a6%97%e0%a7%81%e0%a6%b0%e0%a6%be-%e0%a6%ae%e0%a6%be%e0%a6%b2%e0%a7%8d%e0%a6%9f%e0%a6%bf%e0%a6%aa%e0%a7%8d%e0%a6%b2%e0%a7%87%e0%a6%95%e0%a7%8d%e0%a6%b8%e0%a7%87%e0%a6%b0-7/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981425/%e0%a6%ae%e0%a6%be%e0%a6%97%e0%a7%81%e0%a6%b0%e0%a6%be-%e0%a6%ae%e0%a6%be%e0%a6%b2%e0%a7%8d%e0%a6%9f%e0%a6%bf%e0%a6%aa%e0%a7%8d%e0%a6%b2%e0%a7%87%e0%a6%95%e0%a7%8d%e0%a6%b8%e0%a7%87%e0%a6%b0-7/</guid>
      <pubDate>Mon, 09 Nov 2026 13:54:08 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2025/11/Magura-Multeplex-300x180.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2025/11/Magura-Multeplex-300x180.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2025/11/Magura-Multeplex-300x180.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মাগুরা মাল্টিপ্লেক্সের লভ্যাংশ ঘোষণা" /&gt;&lt;/p&gt;&lt;p&gt;পুঁজিবাজারে তালিকাভুক্ত কোম্পানি বাংলাদেশ মাগুরা মাল্টিপ্লেক্স পিএলসি গত ৩০ জুন, ২০২৬ তারিখে সমাপ্ত হিসাববছরের জন্য লভ্যাংশ ঘোষণা করেছে। কোম্পানিটি আলোচিত বছরের জন্য শেয়ারহোল্ডারদের ২৫ শতাংশ  লভ্যাংশ দেবে। এর পুরোটাই স্টক লভ্যাংশ। আজ সোমবার (৯ নভেম্বর) অনুষ্ঠিত কোম্পানি পরিচালনা পর্ষদের বৈঠকে সর্বশে&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981425/%e0%a6%ae%e0%a6%be%e0%a6%97%e0%a7%81%e0%a6%b0%e0%a6%be-%e0%a6%ae%e0%a6%be%e0%a6%b2%e0%a7%8d%e0%a6%9f%e0%a6%bf%e0%a6%aa%e0%a7%8d%e0%a6%b2%e0%a7%87%e0%a6%95%e0%a7%8d%e0%a6%b8%e0%a7%87%e0%a6%b0-7/">অর্থসূচক</source>
    </item>
    <item>
      <title>বিদেশে ডলার ছাড়ের সীমা দ্বিগুণ হলো, পড়াশোনার টাকা পাঠাতে লাগবে না অনুমোদন</title>

    <item>
      <title>ট্রাম্পের ‘পুতিন শান্তি চান’ মন্তব্যের কয়েক ঘণ্টার মধ্যেই ইউক্রেনে রাশিয়ার বড় হামলা</title>
      <link>https://www.arthosuchak.com/archives/983243/%e0%a6%9f%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ae%e0%a7%8d%e0%a6%aa%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%81%e0%a6%a4%e0%a6%bf%e0%a6%a8-%e0%a6%b6%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a6%bf/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983243/%e0%a6%9f%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ae%e0%a7%8d%e0%a6%aa%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%81%e0%a6%a4%e0%a6%bf%e0%a6%a8-%e0%a6%b6%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a6%bf/</guid>
      <pubDate>Fri, 20 Nov 2026 11:53:43 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/07/Russian-Strike-at-Kyiv-Ukreine-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/07/Russian-Strike-at-Kyiv-Ukreine-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/07/Russian-Strike-at-Kyiv-Ukreine-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ট্রাম্পের ‘পুতিন শান্তি চান’ মন্তব্যের কয়েক ঘণ্টার মধ্যেই ইউক্রেনে রাশিয়ার বড় হামলা" /&gt;&lt;/p&gt;&lt;p&gt;রাশিয়ার প্রেসিডেন্ট ভ্লাদিমির পুতিন যুদ্ধের অবসানে চুক্তিতে আগ্রহী বলে মন্তব্য করেছেন যুক্তরাষ্ট্রের প্রেসিডেন্ট ডোনাল্ড ট্রাম্প। তবে তাঁর এমন মন্তব্যের কয়েক ঘণ্টার মধ্যেই ইউক্রেনে বড় ধরনের ক্ষেপণাস্ত্র ও ড্রোন হামলা চালিয়েছে রাশিয়া। শুক্রবার রাতভর আট ঘণ্টার বেশি সময় ধরে চলা এ হামলায় অন্তত আটজন নিহত&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983243/%e0%a6%9f%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ae%e0%a7%8d%e0%a6%aa%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%81%e0%a6%a4%e0%a6%bf%e0%a6%a8-%e0%a6%b6%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a6%bf/">অর্থসূচক</source>
    </item>
    <item>
      <title>সাপ্তাহিক লেনদেনের শীর্ষে মালেক স্পিনিং</title>

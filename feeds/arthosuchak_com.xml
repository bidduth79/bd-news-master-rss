    <item>
      <title>ট্রাম্প বন্ধু বললেও পুতিনকে খুনি বললেন জেলেনস্কি</title>
      <link>https://www.arthosuchak.com/archives/983301/%e0%a6%9f%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ae%e0%a7%8d%e0%a6%aa-%e0%a6%ac%e0%a6%a8%e0%a7%8d%e0%a6%a7%e0%a7%81-%e0%a6%ac%e0%a6%b2%e0%a6%b2%e0%a7%87%e0%a6%93-%e0%a6%aa%e0%a7%81%e0%a6%a4%e0%a6%bf/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983301/%e0%a6%9f%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ae%e0%a7%8d%e0%a6%aa-%e0%a6%ac%e0%a6%a8%e0%a7%8d%e0%a6%a7%e0%a7%81-%e0%a6%ac%e0%a6%b2%e0%a6%b2%e0%a7%87%e0%a6%93-%e0%a6%aa%e0%a7%81%e0%a6%a4%e0%a6%bf/</guid>
      <pubDate>Sat, 21 Nov 2026 08:53:08 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2025/02/zelenosky-volodymir-20250219190439-1-300x150.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2025/02/zelenosky-volodymir-20250219190439-1-300x150.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2025/02/zelenosky-volodymir-20250219190439-1-300x150.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ট্রাম্প বন্ধু বললেও পুতিনকে খুনি বললেন জেলেনস্কি" /&gt;&lt;/p&gt;&lt;p&gt;মার্কিন প্রেসিডেন্ট ডোনাল্ড ট্রাম্প রুশ প্রেসিডেন্ট ভ্লাদিমির পুতিনকে ‘বন্ধু’ বলে উল্লেখ করায় তীব্র প্রতিক্রিয়া জানিয়েছেন ইউক্রেনের প্রেসিডেন্ট ভলোদিমির জেলেনস্কি। তিনি বলেছেন, ইউক্রেনের কাছে পুতিন একজন শত্রু ও খুনি। সিএনএনকে দেওয়া সাক্ষাৎকারে জেলেনস্কি বলেন, পুতিনকে কীভাবে সম্বোধন করবেন, তা ট্রাম্প&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983301/%e0%a6%9f%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ae%e0%a7%8d%e0%a6%aa-%e0%a6%ac%e0%a6%a8%e0%a7%8d%e0%a6%a7%e0%a7%81-%e0%a6%ac%e0%a6%b2%e0%a6%b2%e0%a7%87%e0%a6%93-%e0%a6%aa%e0%a7%81%e0%a6%a4%e0%a6%bf/">অর্থসূচক</source>
    </item>
    <item>
      <title>সেন্টমার্টিনে আটকা হাজারো পর্যটক, ট্রলারে ফিরছেন ৩৫০ জন</title>
      <link>https://www.arthosuchak.com/archives/983302/%e0%a6%b8%e0%a7%87%e0%a6%a8%e0%a7%8d%e0%a6%9f%e0%a6%ae%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%9f%e0%a6%bf%e0%a6%a8%e0%a7%87-%e0%a6%86%e0%a6%9f%e0%a6%95%e0%a6%be-%e0%a6%b9%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983302/%e0%a6%b8%e0%a7%87%e0%a6%a8%e0%a7%8d%e0%a6%9f%e0%a6%ae%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%9f%e0%a6%bf%e0%a6%a8%e0%a7%87-%e0%a6%86%e0%a6%9f%e0%a6%95%e0%a6%be-%e0%a6%b9%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0/</guid>
      <pubDate>Sat, 21 Nov 2026 08:49:14 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2023/10/sentmartine-300x168.png" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2023/10/sentmartine-300x168.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2023/10/sentmartine-300x168.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সেন্টমার্টিনে আটকা হাজারো পর্যটক, ট্রলারে ফিরছেন ৩৫০ জন" /&gt;&lt;/p&gt;&lt;p&gt;বৈরী আবহাওয়ার কারণে সেন্টমার্টিন দ্বীপে আটকে পড়া পর্যটকদের মধ্যে সাড়ে ৩০০ জন ঝুঁকি নিয়ে ট্রলারে করে কক্সবাজারের টেকনাফে ফিরছেন। শনিবার (২১ নভেম্বর) সকাল সাড়ে ৮টা থেকে দুপুর সাড়ে ১২টা পর্যন্ত ১০টি ট্রলারে করে তারা দ্বীপ ছাড়েন। তবে ট্রলারের সংকট থাকায় এখনও অনেক পর্যটক জেটিঘাটে অপেক্ষা করছেন। ব&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983302/%e0%a6%b8%e0%a7%87%e0%a6%a8%e0%a7%8d%e0%a6%9f%e0%a6%ae%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%9f%e0%a6%bf%e0%a6%a8%e0%a7%87-%e0%a6%86%e0%a6%9f%e0%a6%95%e0%a6%be-%e0%a6%b9%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0/">অর্থসূচক</source>
    </item>
    <item>
      <title>চট্টগ্রামে কর্পোরেট প্রতিষ্ঠানগুলোর অংশগ্রহণে ব্র্যাক ব্যাংকের ট্রেজারি সামিট</title>
      <link>https://www.arthosuchak.com/archives/983288/%e0%a6%9a%e0%a6%9f%e0%a7%8d%e0%a6%9f%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ae%e0%a7%87-%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%aa%e0%a7%8b%e0%a6%b0%e0%a7%87%e0%a6%9f-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983288/%e0%a6%9a%e0%a6%9f%e0%a7%8d%e0%a6%9f%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ae%e0%a7%87-%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%aa%e0%a7%8b%e0%a6%b0%e0%a7%87%e0%a6%9f-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4/</guid>
      <pubDate>Sat, 21 Nov 2026 08:24:07 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/BRAC-Bank-Treasury-Summit-2-300x150.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/BRAC-Bank-Treasury-Summit-2-300x150.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/BRAC-Bank-Treasury-Summit-2-300x150.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চট্টগ্রামে কর্পোরেট প্রতিষ্ঠানগুলোর অংশগ্রহণে ব্র্যাক ব্যাংকের ট্রেজারি সামিট" /&gt;&lt;/p&gt;&lt;p&gt;বিনিয়োগের সম্ভাবনাময় ক্ষেত্র খুঁজে বের করা এবং আর্থিক বাজারের বিভিন্ন ঝুঁকি মোকাবিলায় ব্যবসাপ্রতিষ্ঠানগুলোকে কার্যকর কৌশল সম্পর্কে ধারণা দিতে চট্টগ্রামে প্রথমবারের মতো ‘ট্রেজারি সামিট’ আয়োজন করেছে ব্র্যাক ব্যাংক। গত ১২ নভেম্বর ২০২৬ বন্দরনগরী চট্টগ্রামে আয়োজিত এ সামিটে দেশের শীর্ষস্থানীয় বিভিন্ন কর্প&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983288/%e0%a6%9a%e0%a6%9f%e0%a7%8d%e0%a6%9f%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ae%e0%a7%87-%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%aa%e0%a7%8b%e0%a6%b0%e0%a7%87%e0%a6%9f-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4/">অর্থসূচক</source>
    </item>
    <item>
      <title>উপবৃত্তি পাবে ষষ্ঠ থেকে দ্বাদশ শ্রেণির সব ছাত্রী</title>
      <link>https://www.arthosuchak.com/archives/983296/%e0%a6%89%e0%a6%aa%e0%a6%ac%e0%a7%83%e0%a6%a4%e0%a7%8d%e0%a6%a4%e0%a6%bf-%e0%a6%aa%e0%a6%be%e0%a6%ac%e0%a7%87-%e0%a6%b7%e0%a6%b7%e0%a7%8d%e0%a6%a0-%e0%a6%a5%e0%a7%87%e0%a6%95%e0%a7%87-%e0%a6%a6/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983296/%e0%a6%89%e0%a6%aa%e0%a6%ac%e0%a7%83%e0%a6%a4%e0%a7%8d%e0%a6%a4%e0%a6%bf-%e0%a6%aa%e0%a6%be%e0%a6%ac%e0%a7%87-%e0%a6%b7%e0%a6%b7%e0%a7%8d%e0%a6%a0-%e0%a6%a5%e0%a7%87%e0%a6%95%e0%a7%87-%e0%a6%a6/</guid>
      <pubDate>Sat, 21 Nov 2026 08:05:06 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2022/11/ssc-result-300x156.png" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2022/11/ssc-result-300x156.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2022/11/ssc-result-300x156.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="উপবৃত্তি পাবে ষষ্ঠ থেকে দ্বাদশ শ্রেণির সব ছাত্রী" /&gt;&lt;/p&gt;&lt;p&gt;দেশের সাধারণ স্কুল, কলেজ ও মাদ্রাসায় ষষ্ঠ থেকে দ্বাদশ বা সমমান শ্রেণিতে অধ্যয়নরত সব ছাত্রীকে উপবৃত্তির আওতায় আনার সিদ্ধান্ত নিয়েছে সরকার। এ সিদ্ধান্ত বাস্তবায়নে উপবৃত্তির অর্থ সরাসরি শিক্ষার্থী বা তার অভিভাবকের ব্যাংক হিসাব, এজেন্ট ব্যাংকিং অথবা মোবাইল ব্যাংকিংয়ের মাধ্যমে পাঠানোর জন্য প্রয়োজনীয় হিসা&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983296/%e0%a6%89%e0%a6%aa%e0%a6%ac%e0%a7%83%e0%a6%a4%e0%a7%8d%e0%a6%a4%e0%a6%bf-%e0%a6%aa%e0%a6%be%e0%a6%ac%e0%a7%87-%e0%a6%b7%e0%a6%b7%e0%a7%8d%e0%a6%a0-%e0%a6%a5%e0%a7%87%e0%a6%95%e0%a7%87-%e0%a6%a6/">অর্থসূচক</source>
    </item>
    <item>
      <title>টেক্সপ্রো ইকো অ্যাপারেলের সঙ্গে এনসিসি ব্যাংকের পেরোল চুক্তি</title>
      <link>https://www.arthosuchak.com/archives/983297/%e0%a6%9f%e0%a7%87%e0%a6%95%e0%a7%8d%e0%a6%b8%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a7%8b-%e0%a6%87%e0%a6%95%e0%a7%8b-%e0%a6%85%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%aa%e0%a6%be%e0%a6%b0%e0%a7%87%e0%a6%b2%e0%a7%87/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983297/%e0%a6%9f%e0%a7%87%e0%a6%95%e0%a7%8d%e0%a6%b8%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a7%8b-%e0%a6%87%e0%a6%95%e0%a7%8b-%e0%a6%85%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%aa%e0%a6%be%e0%a6%b0%e0%a7%87%e0%a6%b2%e0%a7%87/</guid>

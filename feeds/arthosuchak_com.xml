    <item>
      <title>স্থানীয় এলসিতে সুইফটের বিকল্প ‘বার্তা’ চালু করলো বাংলাদেশ ব্যাংক</title>
      <link>https://www.arthosuchak.com/archives/984429/%e0%a6%b8%e0%a7%8d%e0%a6%a5%e0%a6%be%e0%a6%a8%e0%a7%80%e0%a6%af%e0%a6%bc-%e0%a6%8f%e0%a6%b2%e0%a6%b8%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%b8%e0%a7%81%e0%a6%87%e0%a6%ab%e0%a6%9f%e0%a7%87%e0%a6%b0/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/984429/%e0%a6%b8%e0%a7%8d%e0%a6%a5%e0%a6%be%e0%a6%a8%e0%a7%80%e0%a6%af%e0%a6%bc-%e0%a6%8f%e0%a6%b2%e0%a6%b8%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%b8%e0%a7%81%e0%a6%87%e0%a6%ab%e0%a6%9f%e0%a7%87%e0%a6%b0/</guid>

    <item>
      <title>দরপতনের শীর্ষে নাভানা ফার্মাসিউটিক্যালস</title>
      <link>https://www.arthosuchak.com/archives/984059/%e0%a6%a6%e0%a6%b0%e0%a6%aa%e0%a6%a4%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%b6%e0%a7%80%e0%a6%b0%e0%a7%8d%e0%a6%b7%e0%a7%87-%e0%a6%a8%e0%a6%be%e0%a6%ad%e0%a6%be%e0%a6%a8%e0%a6%be-%e0%a6%ab%e0%a6%be-4/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/984059/%e0%a6%a6%e0%a6%b0%e0%a6%aa%e0%a6%a4%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%b6%e0%a7%80%e0%a6%b0%e0%a7%8d%e0%a6%b7%e0%a7%87-%e0%a6%a8%e0%a6%be%e0%a6%ad%e0%a6%be%e0%a6%a8%e0%a6%be-%e0%a6%ab%e0%a6%be-4/</guid>
      <pubDate>Wed, 25 Nov 2026 10:24:34 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2022/07/Navana-Pharma-300x171.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2022/07/Navana-Pharma-300x171.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2022/07/Navana-Pharma-300x171.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দরপতনের শীর্ষে নাভানা ফার্মাসিউটিক্যালস" /&gt;&lt;/p&gt;&lt;p&gt;সপ্তাহের তৃতীয় কার্যদিবস বুধবার (২৫ নভেম্বর) ঢাকা স্টক এক্সচেঞ্জে (ডিএসই) লেনদেনে অংশ নেওয়া কোম্পানিগুলোর মধ্যে দরপতনের শীর্ষে উঠে এসেছে নাভানা ফার্মাসিউটিক্যালস পিএলসি। এদিন কোম্পানিটির শেয়ারদর ৮ দশমিক ৭৮ শতাংশ কমেছে। ডিএসই সূত্রে এ তথ্য জানা গেছে। সর্বশেষ তথ্য অনুযায়ী, দরপতনের দ্বিতীয় স্থানে থাকা &lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/984059/%e0%a6%a6%e0%a6%b0%e0%a6%aa%e0%a6%a4%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%b6%e0%a7%80%e0%a6%b0%e0%a7%8d%e0%a6%b7%e0%a7%87-%e0%a6%a8%e0%a6%be%e0%a6%ad%e0%a6%be%e0%a6%a8%e0%a6%be-%e0%a6%ab%e0%a6%be-4/">অর্থসূচক</source>
    </item>
    <item>
      <title>আছিয়া সি ফুডসের লভ্যাংশ ঘোষণা</title>
      <link>https://www.arthosuchak.com/archives/984039/%e0%a6%86%e0%a6%9b%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be-%e0%a6%b8%e0%a6%bf-%e0%a6%ab%e0%a7%81%e0%a6%a1%e0%a6%b8%e0%a7%87%e0%a6%b0-%e0%a6%b2%e0%a6%ad%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%b6/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/984039/%e0%a6%86%e0%a6%9b%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be-%e0%a6%b8%e0%a6%bf-%e0%a6%ab%e0%a7%81%e0%a6%a1%e0%a6%b8%e0%a7%87%e0%a6%b0-%e0%a6%b2%e0%a6%ad%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%b6/</guid>
      <pubDate>Wed, 25 Nov 2026 10:21:26 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2022/04/Achia-Sea-Food-300x192.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2022/04/Achia-Sea-Food-300x192.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2022/04/Achia-Sea-Food-300x192.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আছিয়া সি ফুডসের লভ্যাংশ ঘোষণা" /&gt;&lt;/p&gt;&lt;p&gt;পুঁজিবাজারে এসএমই বোর্ডে তালিকাভুক্ত কোম্পানি আছিয়া সি ফুডস লিমিটেড গত ৩০ জুন, ২০২৬ তারিখে সমাপ্ত হিসাববছরের জন্য লভ্যাংশ ঘোষণা করেছে। কোম্পানিটি আলোচিত বছরের জন্য শেয়ারহোল্ডারদের ৩ শতাংশ লভ্যাংশ দেবে। এর মধ্যে ২ শতাংশ বোনাস, যা সব শেয়ারহোল্ডার পাবেন। বাকী ১ শতাংশ নগদ লভ্যাংশ পাবেন শুধু সাধারণ শেয়ার&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/984039/%e0%a6%86%e0%a6%9b%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be-%e0%a6%b8%e0%a6%bf-%e0%a6%ab%e0%a7%81%e0%a6%a1%e0%a6%b8%e0%a7%87%e0%a6%b0-%e0%a6%b2%e0%a6%ad%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%b6/">অর্থসূচক</source>
    </item>
    <item>
      <title>হামের উপসর্গে মৃত্যু আরও ২, আক্রান্ত ১৪১২</title>
      <link>https://www.arthosuchak.com/archives/984069/%e0%a6%b9%e0%a6%be%e0%a6%ae%e0%a7%87%e0%a6%b0-%e0%a6%89%e0%a6%aa%e0%a6%b8%e0%a6%b0%e0%a7%8d%e0%a6%97%e0%a7%87-%e0%a6%ae%e0%a7%83%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a7%81-%e0%a6%86%e0%a6%b0%e0%a6%93-20/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/984069/%e0%a6%b9%e0%a6%be%e0%a6%ae%e0%a7%87%e0%a6%b0-%e0%a6%89%e0%a6%aa%e0%a6%b8%e0%a6%b0%e0%a7%8d%e0%a6%97%e0%a7%87-%e0%a6%ae%e0%a7%83%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a7%81-%e0%a6%86%e0%a6%b0%e0%a6%93-20/</guid>
      <pubDate>Wed, 25 Nov 2026 10:20:22 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/04/Ham-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/04/Ham-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/04/Ham-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হামের উপসর্গে মৃত্যু আরও ২, আক্রান্ত ১৪১২" /&gt;&lt;/p&gt;&lt;p&gt;হামের উপসর্গ নিয়ে দেশে গত ২৪ ঘণ্টায় আরও দুই শিশুর মৃত্যু হয়েছে। এই সময়ে হাম ও হামের উপসর্গ নিয়ে আক্রান্ত হয়েছে এক হাজার ৪১২ শিশু। বুধবার (২৫ নভেম্বর) বিকেলে স্বাস্থ্য অধিদপ্তরের হাম-বিষয়ক হালনাগাদ প্রতিবেদনে এ তথ্য জানানো হয়েছে। প্রতিবেদনে জানানো হয়েছে, গত ২৪ ঘণ্টায় দেশে নিশ্চিতভাবে হামে আক্রান্ত হয়&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/984069/%e0%a6%b9%e0%a6%be%e0%a6%ae%e0%a7%87%e0%a6%b0-%e0%a6%89%e0%a6%aa%e0%a6%b8%e0%a6%b0%e0%a7%8d%e0%a6%97%e0%a7%87-%e0%a6%ae%e0%a7%83%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a7%81-%e0%a6%86%e0%a6%b0%e0%a6%93-20/">অর্থসূচক</source>

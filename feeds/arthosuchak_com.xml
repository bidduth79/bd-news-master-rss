    <item>
      <title>বেস্ট হোল্ডিংসের লভ্যাংশ ঘোষণা</title>
      <link>https://www.arthosuchak.com/archives/982434/%e0%a6%ac%e0%a7%87%e0%a6%b8%e0%a7%8d%e0%a6%9f-%e0%a6%b9%e0%a7%8b%e0%a6%b2%e0%a7%8d%e0%a6%a1%e0%a6%bf%e0%a6%82%e0%a6%b8%e0%a7%87%e0%a6%b0-%e0%a6%b2%e0%a6%ad%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82-2/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982434/%e0%a6%ac%e0%a7%87%e0%a6%b8%e0%a7%8d%e0%a6%9f-%e0%a6%b9%e0%a7%8b%e0%a6%b2%e0%a7%8d%e0%a6%a1%e0%a6%bf%e0%a6%82%e0%a6%b8%e0%a7%87%e0%a6%b0-%e0%a6%b2%e0%a6%ad%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82-2/</guid>
      <pubDate>Sun, 15 Nov 2026 16:03:40 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2024/04/Best-Holdings-Arthosuchak-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2024/04/Best-Holdings-Arthosuchak-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2024/04/Best-Holdings-Arthosuchak-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বেস্ট হোল্ডিংসের লভ্যাংশ ঘোষণা" /&gt;&lt;/p&gt;&lt;p&gt;পুঁজিবাজারে তালিকাভুক্ত কোম্পানি বেস্ট হোল্ডিংস পিএলসি গত ৩০ জুন, ২০২৬ তারিখে সমাপ্ত হিসাববছরের জন্য লভ্যাংশ সংক্রান্ত সিদ্ধান্ত জানিয়েছে। কোম্পানিটি আলোচিত বছরের জন্য সাধারণ শেয়ারহোল্ডারদের ২.৫০ কোনো লভ্যাংশ দেবে। রোববার (১৫ নভেম্বর) অনুষ্ঠিত কোম্পানিটির পরিচালনা পর্ষদের বৈঠকে সর্বশেষ হিসাববছরের নি&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982434/%e0%a6%ac%e0%a7%87%e0%a6%b8%e0%a7%8d%e0%a6%9f-%e0%a6%b9%e0%a7%8b%e0%a6%b2%e0%a7%8d%e0%a6%a1%e0%a6%bf%e0%a6%82%e0%a6%b8%e0%a7%87%e0%a6%b0-%e0%a6%b2%e0%a6%ad%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82-2/">অর্থসূচক</source>
    </item>
    <item>
      <title>৩ হাজার কোটি টাকার সুকুক নিলামে তুলছে সরকার</title>
      <link>https://www.arthosuchak.com/archives/982531/%e0%a7%a9-%e0%a6%b9%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0-%e0%a6%95%e0%a7%8b%e0%a6%9f%e0%a6%bf-%e0%a6%9f%e0%a6%be%e0%a6%95%e0%a6%be%e0%a6%b0-%e0%a6%b8%e0%a7%81%e0%a6%95%e0%a7%81%e0%a6%95-%e0%a6%a8/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982531/%e0%a7%a9-%e0%a6%b9%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0-%e0%a6%95%e0%a7%8b%e0%a6%9f%e0%a6%bf-%e0%a6%9f%e0%a6%be%e0%a6%95%e0%a6%be%e0%a6%b0-%e0%a6%b8%e0%a7%81%e0%a6%95%e0%a7%81%e0%a6%95-%e0%a6%a8/</guid>
      <pubDate>Sun, 15 Nov 2026 15:53:32 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2023/04/Sukuk-300x165.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2023/04/Sukuk-300x165.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2023/04/Sukuk-300x165.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৩ হাজার কোটি টাকার সুকুক নিলামে তুলছে সরকার" /&gt;&lt;/p&gt;&lt;p&gt;তিন হাজার কোটি টাকা অভিহিত মূল্যের ১৮২ দিন মেয়াদি বাংলাদেশ সরকারের বিনিয়োগ সুকুক (ইসলামি বন্ড) নিলামে তোলার সিদ্ধান্ত নিয়েছে বাংলাদেশ ব্যাংক। আগামী ১ ডিসেম্বর এ নিলাম হবে। ‘অগ্রাধিকার ভিত্তিতে গুরুত্বপূর্ণ পল্লী অবকাঠামো উন্নয়ন প্রকল্প’-এর বিপরীতে এ সুকুক ইস্যু করা হবে। বাংলাদেশ ব্যাংক এক সংবাদ বিজ্&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982531/%e0%a7%a9-%e0%a6%b9%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0-%e0%a6%95%e0%a7%8b%e0%a6%9f%e0%a6%bf-%e0%a6%9f%e0%a6%be%e0%a6%95%e0%a6%be%e0%a6%b0-%e0%a6%b8%e0%a7%81%e0%a6%95%e0%a7%81%e0%a6%95-%e0%a6%a8/">অর্থসূচক</source>
    </item>
    <item>
      <title>ভিএফএস থ্রেডের প্রথম প্রান্তিক প্রকাশ</title>
      <link>https://www.arthosuchak.com/archives/982466/%e0%a6%ad%e0%a6%bf%e0%a6%8f%e0%a6%ab%e0%a6%8f%e0%a6%b8-%e0%a6%a5%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%a1%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a5%e0%a6%ae-%e0%a6%aa%e0%a7%8d%e0%a6%b0-3/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982466/%e0%a6%ad%e0%a6%bf%e0%a6%8f%e0%a6%ab%e0%a6%8f%e0%a6%b8-%e0%a6%a5%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%a1%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a5%e0%a6%ae-%e0%a6%aa%e0%a7%8d%e0%a6%b0-3/</guid>
      <pubDate>Sun, 15 Nov 2026 15:51:11 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2022/10/VFS-Thread-300x133.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2022/10/VFS-Thread-300x133.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2022/10/VFS-Thread-300x133.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভিএফএস থ্রেডের প্রথম প্রান্তিক প্রকাশ" /&gt;&lt;/p&gt;&lt;p&gt;পুঁজিবাজারে তালিকাভুক্ত কোম্পানি ভিএফএস থ্রেড ডায়িং লিমিটেড ৩০ সেপ্টেম্বর, ২০২৬ তারিখে সমাপ্ত প্রথম প্রান্তিকের (জুলাই’২৬-সেপ্টেম্বর’২৬) অনিরীক্ষিত আর্থিক প্রতিবেদন প্রকাশ করেছে। রোববার (১৫ নভেম্বর) অনুষ্ঠিত কোম্পানির পরিচালনা পর্ষদের বৈঠকে চলতি হিসাববছরের প্রথম প্রান্তিকের আর্থিক প্রতিবেদন পর্যালোচ&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982466/%e0%a6%ad%e0%a6%bf%e0%a6%8f%e0%a6%ab%e0%a6%8f%e0%a6%b8-%e0%a6%a5%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%a1%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a5%e0%a6%ae-%e0%a6%aa%e0%a7%8d%e0%a6%b0-3/">অর্থসূচক</source>
    </item>
    <item>
      <title>বাংলাদেশ ও তুরস্ক একটি সামগ্রিক অংশীদারিত্বের দিকে এগিয়ে যাচ্ছে: পররাষ্ট্র প্রতিমন্ত্রী</title>
      <link>https://www.arthosuchak.com/archives/982524/%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%a6%e0%a7%87%e0%a6%b6-%e0%a6%93-%e0%a6%a4%e0%a7%81%e0%a6%b0%e0%a6%b8%e0%a7%8d%e0%a6%95-%e0%a6%8f%e0%a6%95%e0%a6%9f%e0%a6%bf-%e0%a6%b8%e0%a6%be/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982524/%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%a6%e0%a7%87%e0%a6%b6-%e0%a6%93-%e0%a6%a4%e0%a7%81%e0%a6%b0%e0%a6%b8%e0%a7%8d%e0%a6%95-%e0%a6%8f%e0%a6%95%e0%a6%9f%e0%a6%bf-%e0%a6%b8%e0%a6%be/</guid>
      <pubDate>Sun, 15 Nov 2026 15:37:37 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/09/Humayun-Kabir-300x168.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/09/Humayun-Kabir-300x168.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/09/Humayun-Kabir-300x168.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাংলাদেশ ও তুরস্ক একটি সামগ্রিক অংশীদারিত্বের দিকে এগিয়ে যাচ্ছে: পররাষ্ট্র প্রতিমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;প্রধানমন্ত্রী তারেক রহমান এবং তুরস্কের প্রেসিডেন্ট রিসেপ তাইয়েপ এরদোয়ানের মধ্যে অত্যন্ত ফলপ্রসূ আলোচনার পর বাংলাদেশ ও তুরস্ক প্রতিরক্ষা খাতে বিনিয়োগ, শিল্প সহযোগিতা এবং রোহিঙ্গা সংকটসহ বিভিন্ন বিষয়ে একটি সামগ্রিক অংশীদারিত্বের দিকে এগিয়ে যাচ্ছে। রবিবার এক সংবাদ ব্রিফিংয়ে পররাষ্ট্র প্রতিমন্ত্রী হুমায়&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982524/%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%a6%e0%a7%87%e0%a6%b6-%e0%a6%93-%e0%a6%a4%e0%a7%81%e0%a6%b0%e0%a6%b8%e0%a7%8d%e0%a6%95-%e0%a6%8f%e0%a6%95%e0%a6%9f%e0%a6%bf-%e0%a6%b8%e0%a6%be/">অর্থসূচক</source>
    </item>
    <item>
      <title>কমিউনিটি ব্যাংকের সিএসই ও সিসিইদের সঙ্গে ব্যবস্থাপনা পরিচালক ও প্রধান নির্বাহীর মতবিনিময়</title>
      <link>https://www.arthosuchak.com/archives/982528/%e0%a6%95%e0%a6%ae%e0%a6%bf%e0%a6%89%e0%a6%a8%e0%a6%bf%e0%a6%9f%e0%a6%bf-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%bf%e0%a6%8f%e0%a6%b8%e0%a6%87/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982528/%e0%a6%95%e0%a6%ae%e0%a6%bf%e0%a6%89%e0%a6%a8%e0%a6%bf%e0%a6%9f%e0%a6%bf-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%bf%e0%a6%8f%e0%a6%b8%e0%a6%87/</guid>
      <pubDate>Sun, 15 Nov 2026 15:15:26 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Cb26-300x163.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Cb26-300x163.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Cb26-300x163.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কমিউনিটি ব্যাংকের সিএসই ও সিসিইদের সঙ্গে ব্যবস্থাপনা পরিচালক ও প্রধান নির্বাহীর মতবিনিময়" /&gt;&lt;/p&gt;&lt;p&gt;প্রতিষ্ঠানের অগ্রযাত্রাকে আরও গতিশীল, সুসংহত ও লক্ষ্যভিত্তিক করার প্রত্যয়ে কমিউনিটি ব্যাংক বাংলাদেশ পিএলসি-এর কাস্টমার সার্ভিস এক্সিকিউটিভ (সিএসই) ও কন্টাক্ট সেন্টার এক্সিকিউটিভদের (সিসিই) সঙ্গে ব্যাংকের ব্যবস্থাপনা পরিচালক ও প্রধান নির্বাহী মোহাম্মদ ইমতিয়াজ উদ্দিনের এক মতবিনিময় সভা অনুষ্ঠিত হয়েছে। &lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982528/%e0%a6%95%e0%a6%ae%e0%a6%bf%e0%a6%89%e0%a6%a8%e0%a6%bf%e0%a6%9f%e0%a6%bf-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%bf%e0%a6%8f%e0%a6%b8%e0%a6%87/">অর্থসূচক</source>
    </item>
    <item>
      <title>জিয়াউল আহসানকে হাতকড়া ছাড়া ট্রাইব্যুনালে নেওয়া হবে না : আইনমন্ত্রী</title>

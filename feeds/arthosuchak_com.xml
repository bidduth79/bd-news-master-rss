      <pubDate>Thu, 26 Nov 2026 13:13:28 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/2026-11-25-MTB-signs-MoU-with-Toyota-Bangladesh-Limited-300x169.jpeg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/2026-11-25-MTB-signs-MoU-with-Toyota-Bangladesh-Limited-300x169.jpeg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/2026-11-25-MTB-signs-MoU-with-Toyota-Bangladesh-Limited-300x169.jpeg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টয়োটা বাংলাদেশের সঙ্গে এমটিবির সমঝোতা স্মারক স্বাক্ষর" /&gt;&lt;/p&gt;&lt;p&gt;গ্রাহকসেবার মানোন্নয়ন, উন্নত ব্যাংকিং সেবা এবং নতুন ব্যবসায়িক সুযোগ সৃষ্টির লক্ষ্যে টয়োটা বাংলাদেশ লিমিটেডের সঙ্গে সমঝোতা স্মারক স্বাক্ষর করেছে মিউচুয়াল ট্রাস্ট ব্যাংক পিএলসি (এমটিবি)। গত ১০ নভেম্বর ঢাকার তেজগাঁও শিল্প এলাকায় টয়োটা বাংলাদেশের কার্যালয়ে এ চুক্তি স্বাক্ষর অনুষ্ঠান অনুষ্ঠিত হয়। এতে নিজ&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/984285/%e0%a6%9f%e0%a6%af%e0%a6%bc%e0%a7%8b%e0%a6%9f%e0%a6%be-%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%87/">অর্থসূচক</source>
    </item>
    <item>
      <title>ভালো কোম্পানিকে পুঁজিবাজারে আনতে আইপিও বিধিমালায় আসছে একাধিক পরিবর্তন: বিএসইসি চেয়ারম্যান</title>
      <link>https://www.arthosuchak.com/archives/984301/%e0%a6%ad%e0%a6%be%e0%a6%b2%e0%a7%8b-%e0%a6%95%e0%a7%8b%e0%a6%ae%e0%a7%8d%e0%a6%aa%e0%a6%be%e0%a6%a8%e0%a6%bf%e0%a6%95%e0%a7%87-%e0%a6%aa%e0%a7%81%e0%a6%81%e0%a6%9c%e0%a6%bf%e0%a6%ac%e0%a6%be%e0%a6%9c/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/984301/%e0%a6%ad%e0%a6%be%e0%a6%b2%e0%a7%8b-%e0%a6%95%e0%a7%8b%e0%a6%ae%e0%a7%8d%e0%a6%aa%e0%a6%be%e0%a6%a8%e0%a6%bf%e0%a6%95%e0%a7%87-%e0%a6%aa%e0%a7%81%e0%a6%81%e0%a6%9c%e0%a6%bf%e0%a6%ac%e0%a6%be%e0%a6%9c/</guid>
      <pubDate>Thu, 26 Nov 2026 12:56:51 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/BSEC-CHAIRMAN-MASUD-KHAN-at-BAPLC-PROGRAMME-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/BSEC-CHAIRMAN-MASUD-KHAN-at-BAPLC-PROGRAMME-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/BSEC-CHAIRMAN-MASUD-KHAN-at-BAPLC-PROGRAMME-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভালো কোম্পানিকে পুঁজিবাজারে আনতে আইপিও বিধিমালায় আসছে একাধিক পরিবর্তন: বিএসইসি চেয়ারম্যান" /&gt;&lt;/p&gt;&lt;p&gt;দেশের পুঁজিবাজারে ভালো ও মৌলভিত্তিসম্পন্ন কোম্পানির অংশগ্রহণ বাড়াতে প্রাথমিক গণপ্রস্তাব (আইপিও) বিধিমালায় একাধিক পরিবর্তন আনতে যাচ্ছে বাংলাদেশ সিকিউরিটিজ অ্যান্ড এক্সচেঞ্জ কমিশন (বিএসইসি)। নতুন বিধিমালায় মূল্য নির্ধারণ পদ্ধতি, বুক বিল্ডিং, মিউচুয়াল ফান্ডের বরাদ্দ, আন্ডাররাইটিং এবং তালিকাভুক্তির প্রক&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/984301/%e0%a6%ad%e0%a6%be%e0%a6%b2%e0%a7%8b-%e0%a6%95%e0%a7%8b%e0%a6%ae%e0%a7%8d%e0%a6%aa%e0%a6%be%e0%a6%a8%e0%a6%bf%e0%a6%95%e0%a7%87-%e0%a6%aa%e0%a7%81%e0%a6%81%e0%a6%9c%e0%a6%bf%e0%a6%ac%e0%a6%be%e0%a6%9c/">অর্থসূচক</source>
    </item>
    <item>
      <title>ফের বাড়ল ভোজ্যতেলের দাম</title>
      <link>https://www.arthosuchak.com/archives/984294/%e0%a6%ab%e0%a7%87%e0%a6%b0-%e0%a6%ac%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a6%b2-%e0%a6%ad%e0%a7%8b%e0%a6%9c%e0%a7%8d%e0%a6%af%e0%a6%a4%e0%a7%87%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a6%a6%e0%a6%be%e0%a6%ae/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/984294/%e0%a6%ab%e0%a7%87%e0%a6%b0-%e0%a6%ac%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a6%b2-%e0%a6%ad%e0%a7%8b%e0%a6%9c%e0%a7%8d%e0%a6%af%e0%a6%a4%e0%a7%87%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a6%a6%e0%a6%be%e0%a6%ae/</guid>
      <pubDate>Thu, 26 Nov 2026 12:50:36 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2022/12/oil-300x159.png" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2022/12/oil-300x159.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2022/12/oil-300x159.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফের বাড়ল ভোজ্যতেলের দাম" /&gt;&lt;/p&gt;&lt;p&gt;দেশের বাজারে সয়াবিন তেলের দাম লিটারপ্রতি ৩ টাকা বাড়ানো হয়েছে। নতুন সিদ্ধান্ত অনুযায়ী, প্রতি লিটার বোতলজাত সয়াবিন তেলের দাম ২০৪ টাকা থেকে বাড়িয়ে ২০৭ টাকা এবং খোলা সয়াবিন তেলের দাম ১৮৫ টাকা থেকে বাড়িয়ে ১৮৮ টাকা নির্ধারণ করা হয়েছে। তবে খোলা পাম তেলের দাম আগের মতোই লিটারপ্রতি ১৬৬ টাকা রাখা হয়েছে। এ ছাড়া&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/984294/%e0%a6%ab%e0%a7%87%e0%a6%b0-%e0%a6%ac%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a6%b2-%e0%a6%ad%e0%a7%8b%e0%a6%9c%e0%a7%8d%e0%a6%af%e0%a6%a4%e0%a7%87%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a6%a6%e0%a6%be%e0%a6%ae/">অর্থসূচক</source>
    </item>
    <item>
      <title>পুঁজিবাজার সম্পর্কে বাস্তব জ্ঞান অর্জনে আইআইইউসির শিক্ষার্থীদের সিএসই পরিদর্শন</title>
      <link>https://www.arthosuchak.com/archives/984291/%e0%a6%aa%e0%a7%81%e0%a6%81%e0%a6%9c%e0%a6%bf%e0%a6%ac%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0-%e0%a6%b8%e0%a6%ae%e0%a7%8d%e0%a6%aa%e0%a6%b0%e0%a7%8d%e0%a6%95%e0%a7%87-%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a7%8d/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/984291/%e0%a6%aa%e0%a7%81%e0%a6%81%e0%a6%9c%e0%a6%bf%e0%a6%ac%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0-%e0%a6%b8%e0%a6%ae%e0%a7%8d%e0%a6%aa%e0%a6%b0%e0%a7%8d%e0%a6%95%e0%a7%87-%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a7%8d/</guid>
      <pubDate>Thu, 26 Nov 2026 12:36:32 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/IIUC-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/IIUC-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/IIUC-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পুঁজিবাজার সম্পর্কে বাস্তব জ্ঞান অর্জনে আইআইইউসির শিক্ষার্থীদের সিএসই পরিদর্শন" /&gt;&lt;/p&gt;&lt;p&gt;পুঁজিবাজার সম্পর্কে তাত্ত্বিক ও ব্যবহারিক জ্ঞান অর্জন এবং বিনিয়োগ বিষয়ে দক্ষতা বাড়ানোর লক্ষ্যে চট্টগ্রাম স্টক এক্সচেঞ্জ (সিএসই) পরিদর্শন করেছেন আন্তর্জাতিক ইসলামী বিশ্ববিদ্যালয় চট্টগ্রামের (আইআইইউসি) ব্যবসায় প্রশাসন অনুষদের শিক্ষার্থীরা। গত ২৫ নভেম্বর ২০২৬, বুধবার চট্টগ্রামের আগ্রাবাদে সিএসইর কার্যা&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/984291/%e0%a6%aa%e0%a7%81%e0%a6%81%e0%a6%9c%e0%a6%bf%e0%a6%ac%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0-%e0%a6%b8%e0%a6%ae%e0%a7%8d%e0%a6%aa%e0%a6%b0%e0%a7%8d%e0%a6%95%e0%a7%87-%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a7%8d/">অর্থসূচক</source>
    </item>
    <item>
      <title>বিদ্যুৎ বিল সংগ্রহে সম্মিলিত ইসলামী ব্যাংকের এক্সিম ব্যাংক ইউনিট ও ওজোপাডিকোর চুক্তি</title>
      <link>https://www.arthosuchak.com/archives/984279/%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a7%81%e0%a7%8e-%e0%a6%ac%e0%a6%bf%e0%a6%b2-%e0%a6%b8%e0%a6%82%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%b9%e0%a7%87-%e0%a6%b8%e0%a6%ae%e0%a7%8d%e0%a6%ae/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/984279/%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a7%81%e0%a7%8e-%e0%a6%ac%e0%a6%bf%e0%a6%b2-%e0%a6%b8%e0%a6%82%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%b9%e0%a7%87-%e0%a6%b8%e0%a6%ae%e0%a7%8d%e0%a6%ae/</guid>
      <pubDate>Thu, 26 Nov 2026 12:32:41 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/sammilito-bank-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/sammilito-bank-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/sammilito-bank-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিদ্যুৎ বিল সংগ্রহে সম্মিলিত ইসলামী ব্যাংকের এক্সিম ব্যাংক ইউনিট ও ওজোপাডিকোর চুক্তি" /&gt;&lt;/p&gt;&lt;p&gt;পশ্চিমাঞ্চলের ২১ জেলার গ্রাহকদের বিদ্যুৎ বিল জমা নেওয়ার জন্য চুক্তি করেছে রাষ্ট্র মালিকানাধীন সম্মিলিত ইসলামী ব্যাংকের এক্সিম ব্যাংক ইউনিট ও ওয়েস্ট জোন পাওয়ার ডিস্ট্রিবিউশন কোম্পানি লিমিটেড (ওজোপাডিকো)। বুধবার (২৫ নভেম্বর) সম্মিলিত ইসলামী ব্যাংকের প্রধান কার্যালয়ে এ চুক্তি স্বাক্ষরিত হয়। এর ফলে ওজোপ&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/984279/%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a7%81%e0%a7%8e-%e0%a6%ac%e0%a6%bf%e0%a6%b2-%e0%a6%b8%e0%a6%82%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%b9%e0%a7%87-%e0%a6%b8%e0%a6%ae%e0%a7%8d%e0%a6%ae/">অর্থসূচক</source>
    </item>

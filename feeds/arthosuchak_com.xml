    <item>
      <title>রাজধানীতে স্কুল বাসে আগুন</title>
      <link>https://www.arthosuchak.com/archives/981258/%e0%a6%b0%e0%a6%be%e0%a6%9c%e0%a6%a7%e0%a6%be%e0%a6%a8%e0%a7%80%e0%a6%a4%e0%a7%87-%e0%a6%8f%e0%a6%ac%e0%a6%be%e0%a6%b0-%e0%a6%b8%e0%a7%8d%e0%a6%95%e0%a7%81%e0%a6%b2-%e0%a6%ac%e0%a6%be%e0%a6%b8/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981258/%e0%a6%b0%e0%a6%be%e0%a6%9c%e0%a6%a7%e0%a6%be%e0%a6%a8%e0%a7%80%e0%a6%a4%e0%a7%87-%e0%a6%8f%e0%a6%ac%e0%a6%be%e0%a6%b0-%e0%a6%b8%e0%a7%8d%e0%a6%95%e0%a7%81%e0%a6%b2-%e0%a6%ac%e0%a6%be%e0%a6%b8/</guid>
      <pubDate>Sun, 08 Nov 2026 13:36:42 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Bus-300x168.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Bus-300x168.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Bus-300x168.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজধানীতে স্কুল বাসে আগুন" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর ভাটারার ১০০ ফিট এলাকায় একটি স্কুল বাসে আগুন দিয়েছে দুর্বৃত্তরা। তবে এতে হতাহতের কোনও খবর পাওয়া যায়নি। রবিবার (৮ নভেম্বর) সন্ধ্যা সাড়ে ৬টার দিকে এই ঘটনা ঘটে। ভাটারা থানার কর্তব্যরত অফিসার দেবাশীষ রায় ঘটনার সত্যতা নিশ্চিত করে বলেন, আমাদের ঊর্ধ্বতন কর্মকর্তারা ঘটনাস্থলে রয়েছেন। কারা, কীভাবে আগ&lt;/p&gt;</description>

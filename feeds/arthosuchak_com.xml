      <pubDate>Fri, 20 Nov 2026 12:42:53 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/UGC-Chairman-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/UGC-Chairman-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/UGC-Chairman-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শিক্ষায় প্রযুক্তির সুবিধা সবার কাছে পৌঁছানোর আহ্বান ইউজিসি চেয়ারম্যানের" /&gt;&lt;/p&gt;&lt;p&gt;শিক্ষার বিভিন্ন ক্ষেত্রে কৃত্রিম বুদ্ধিমত্তার (এআই) ব্যবহার বাড়লেও এর সুবিধা যেন কেবল বেশি সুযোগ-সুবিধা পাওয়া শিক্ষাপ্রতিষ্ঠানের শিক্ষার্থীদের মধ্যে সীমাবদ্ধ না থাকে, সেই আহ্বান জানিয়েছেন বাংলাদেশ বিশ্ববিদ্যালয় মঞ্জুরী কমিশনের (ইউজিসি) চেয়ারম্যান অধ্যাপক ড. মামুন আহমেদ। একই সঙ্গে শিক্ষায় প্রযুক্তির &lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983235/%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%af%e0%a7%81%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%bf%e0%a6%b0-%e0%a6%b8%e0%a7%81%e0%a6%ac%e0%a6%bf/">অর্থসূচক</source>

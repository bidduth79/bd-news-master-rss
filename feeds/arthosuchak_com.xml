    <item>
      <title>জেনসেন হুয়াংয়ের পদত্যাগ, এনভিডিয়ার সিইওর দায়িত্বে কোলেট ক্রেস</title>
      <link>https://www.arthosuchak.com/archives/982165/%e0%a6%9c%e0%a7%87%e0%a6%a8%e0%a6%b8%e0%a7%87%e0%a6%a8-%e0%a6%b9%e0%a7%81%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%82%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a6%a6%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a6%be/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/982165/%e0%a6%9c%e0%a7%87%e0%a6%a8%e0%a6%b8%e0%a7%87%e0%a6%a8-%e0%a6%b9%e0%a7%81%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%82%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a6%a6%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a6%be/</guid>
      <pubDate>Fri, 13 Nov 2026 15:56:51 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Colette-Kress-NVIDIA-New-CEO-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Colette-Kress-NVIDIA-New-CEO-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Colette-Kress-NVIDIA-New-CEO-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জেনসেন হুয়াংয়ের পদত্যাগ, এনভিডিয়ার সিইওর দায়িত্বে কোলেট ক্রেস" /&gt;&lt;/p&gt;&lt;p&gt;বিশ্বের অন্যতম শীর্ষ প্রযুক্তিপ্রতিষ্ঠান এনভিডিয়ার প্রধান নির্বাহী কর্মকর্তার (সিইও) পদ থেকে পদত্যাগ করেছেন প্রতিষ্ঠানটির সহপ্রতিষ্ঠাতা জেনসেন হুয়াং। তাঁর স্থলাভিষিক্ত হয়ে অন্তর্বর্তীকালীন সিইও হিসেবে দায়িত্ব নিয়েছেন কোম্পানিটির দীর্ঘদিনের প্রধান অর্থ কর্মকর্তা (সিএফও) কোলেট ক্রেস। এর মধ্য দিয়ে প্রত&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982165/%e0%a6%9c%e0%a7%87%e0%a6%a8%e0%a6%b8%e0%a7%87%e0%a6%a8-%e0%a6%b9%e0%a7%81%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%82%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a6%a6%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a6%be/">অর্থসূচক</source>
    </item>
    <item>
      <title>সিনো বাংলার প্রথম প্রান্তিক প্রকাশ</title>
      <link>https://www.arthosuchak.com/archives/981895/%e0%a6%b8%e0%a6%bf%e0%a6%a8%e0%a7%8b-%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a5%e0%a6%ae-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%a8%e0%a7%8d/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981895/%e0%a6%b8%e0%a6%bf%e0%a6%a8%e0%a7%8b-%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a5%e0%a6%ae-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%a8%e0%a7%8d/</guid>
      <pubDate>Fri, 13 Nov 2026 15:13:52 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2021/10/sinobangla-industries-ltd-533x400-1-300x225.png" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2021/10/sinobangla-industries-ltd-533x400-1-300x225.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2021/10/sinobangla-industries-ltd-533x400-1-300x225.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সিনো বাংলার প্রথম প্রান্তিক প্রকাশ" /&gt;&lt;/p&gt;&lt;p&gt;পুঁজিবাজারে তালিকাভুক্ত কোম্পানি সিনো বাংলা গত ৩০ সেপ্টেম্বর, ২০২৬ তারিখে সমাপ্ত প্রথম প্রান্তিকের (জুলাই’২৬-সেপ্টেম্বর’২৬) অনিরীক্ষিত আর্থিক প্রতিবেদন প্রকাশ করেছে। বৃহস্পতিবার (১২ নভেম্বর) অনুষ্ঠিত কোম্পানির পরিচালনা পর্ষদের বৈঠকে চলতি হিসাববছরের প্রথম প্রান্তিকের আর্থিক প্রতিবেদন পর্যালোচনা ও অনু&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981895/%e0%a6%b8%e0%a6%bf%e0%a6%a8%e0%a7%8b-%e0%a6%ac%e0%a6%be%e0%a6%82%e0%a6%b2%e0%a6%be%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a5%e0%a6%ae-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%a8%e0%a7%8d/">অর্থসূচক</source>
    </item>

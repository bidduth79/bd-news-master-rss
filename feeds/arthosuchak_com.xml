      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Zahid-Hossain-300x180.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Zahid-Hossain-300x180.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Zahid-Hossain-300x180.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সরকার স্বাস্থ্য খাতে ইতিহাসের সর্বোচ্চ বাজেট বরাদ্দ দিয়েছে: সমাজকল্যাণমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;নারী ও শিশু এবং সমাজকল্যাণ মন্ত্রী অধ্যাপক ডা. এ জেড এম জাহিদ হোসেন বলেছেন, বর্তমান সরকার স্বাস্থ্যসেবা প্রতিটি মানুষের দোরগোড়ায় পৌঁছে দিতে এই খাতে ইতিহাসের সর্বোচ্চ বাজেট বরাদ্দ দিয়েছে। এই বরাদ্দ যথাযথভাবে কাজে লাগিয়ে একটি সমৃদ্ধ জাতি গঠন করাই সরকারের মূল লক্ষ্য। মঙ্গলবার জেলার রূপগঞ্জে দাউদপুর জ&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981617/%e0%a6%b8%e0%a6%b0%e0%a6%95%e0%a6%be%e0%a6%b0-%e0%a6%b8%e0%a7%8d%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a7%8d%e0%a6%a5%e0%a7%8d%e0%a6%af-%e0%a6%96%e0%a6%be%e0%a6%a4%e0%a7%87-%e0%a6%87%e0%a6%a4%e0%a6%bf/">অর্থসূচক</source>
    </item>
    <item>
      <title>ডমিনেজ স্টিলের লভ্যাংশ সংক্রান্ত ঘোষণা</title>
      <link>https://www.arthosuchak.com/archives/981535/%e0%a6%a1%e0%a6%ae%e0%a6%bf%e0%a6%a8%e0%a7%87%e0%a6%9c-%e0%a6%b8%e0%a7%8d%e0%a6%9f%e0%a6%bf%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a6%b2%e0%a6%ad%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%b6-%e0%a6%b8/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981535/%e0%a6%a1%e0%a6%ae%e0%a6%bf%e0%a6%a8%e0%a7%87%e0%a6%9c-%e0%a6%b8%e0%a7%8d%e0%a6%9f%e0%a6%bf%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a6%b2%e0%a6%ad%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%b6-%e0%a6%b8/</guid>
      <pubDate>Tue, 10 Nov 2026 16:27:53 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2021/11/Dominage-300x200.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2021/11/Dominage-300x200.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2021/11/Dominage-300x200.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডমিনেজ স্টিলের লভ্যাংশ সংক্রান্ত ঘোষণা" /&gt;&lt;/p&gt;&lt;p&gt;পুঁজিবাজারে তালিকাভুক্ত প্রকৌশল খাতের কোম্পানি ডমিনেজ স্টিল বিল্ডিং সিস্টেম লিমিটেড গত ৩০ জুন, ২০২৬ তারিখে সমাপ্ত হিসাববছরের জন্য লভ্যাংশ ঘোষণা করেছে। কোম্পানিটি আলোচিত বছরের জন্য সাধারণ শেয়ারহোল্ডারদের ০.৫০ শতাংশ নগদ লভ্যাংশ দেবে। মঙ্গলবার (১০ নভেম্বর) অনুষ্ঠিত কোম্পানি পরিচালনা পর্ষদের বৈঠকে সর্বশ&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981535/%e0%a6%a1%e0%a6%ae%e0%a6%bf%e0%a6%a8%e0%a7%87%e0%a6%9c-%e0%a6%b8%e0%a7%8d%e0%a6%9f%e0%a6%bf%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a6%b2%e0%a6%ad%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%b6-%e0%a6%b8/">অর্থসূচক</source>
    </item>
    <item>
      <title>বেনজীর আহমেদকে ফেরাতে আইনি ও কূটনৈতিক প্রচেষ্টা অব্যাহত: স্বরাষ্ট্রমন্ত্রী</title>
      <link>https://www.arthosuchak.com/archives/981622/%e0%a6%ac%e0%a7%87%e0%a6%a8%e0%a6%9c%e0%a7%80%e0%a6%b0-%e0%a6%86%e0%a6%b9%e0%a6%ae%e0%a7%87%e0%a6%a6%e0%a6%95%e0%a7%87-%e0%a6%ab%e0%a7%87%e0%a6%b0%e0%a6%be%e0%a6%a4%e0%a7%87-%e0%a6%86%e0%a6%87/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981622/%e0%a6%ac%e0%a7%87%e0%a6%a8%e0%a6%9c%e0%a7%80%e0%a6%b0-%e0%a6%86%e0%a6%b9%e0%a6%ae%e0%a7%87%e0%a6%a6%e0%a6%95%e0%a7%87-%e0%a6%ab%e0%a7%87%e0%a6%b0%e0%a6%be%e0%a6%a4%e0%a7%87-%e0%a6%86%e0%a6%87/</guid>
      <pubDate>Tue, 10 Nov 2026 16:11:53 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Salauddin-1-300x161.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Salauddin-1-300x161.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Salauddin-1-300x161.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বেনজীর আহমেদকে ফেরাতে আইনি ও কূটনৈতিক প্রচেষ্টা অব্যাহত: স্বরাষ্ট্রমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;সাবেক পুলিশ মহাপরিদর্শক (আইজিপি) বেনজীর আহমেদকে বাংলাদেশে ফিরিয়ে এনে বিচারের মুখোমুখি করতে সব ধরনের আইনগত, কূটনৈতিক ও আন্তর্জাতিক পুলিশি পদক্ষেপ অব্যাহত রেখেছে সরকার। স্বরাষ্ট্রমন্ত্রী সালাহউদ্দিন আহমদ আজ জাতীয় সংসদে এ বিষয়টি অবহিত করেন। তিনি বলেন, বেনজীর আহমেদের বিরুদ্ধে বাংলাদেশের উপযুক্ত আদালত গ্&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981622/%e0%a6%ac%e0%a7%87%e0%a6%a8%e0%a6%9c%e0%a7%80%e0%a6%b0-%e0%a6%86%e0%a6%b9%e0%a6%ae%e0%a7%87%e0%a6%a6%e0%a6%95%e0%a7%87-%e0%a6%ab%e0%a7%87%e0%a6%b0%e0%a6%be%e0%a6%a4%e0%a7%87-%e0%a6%86%e0%a6%87/">অর্থসূচক</source>
    </item>
    <item>
      <title>শেখ হাসিনার প্রত্যপর্ণের বিষয়টি আইনিভাবে দেখা হবে: জয়সওয়াল</title>
      <link>https://www.arthosuchak.com/archives/981624/%e0%a6%b6%e0%a7%87%e0%a6%96-%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%a8%e0%a6%be%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a6%aa%e0%a6%b0%e0%a7%8d%e0%a6%a3%e0%a7%87%e0%a6%b0/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981624/%e0%a6%b6%e0%a7%87%e0%a6%96-%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%a8%e0%a6%be%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a6%aa%e0%a6%b0%e0%a7%8d%e0%a6%a3%e0%a7%87%e0%a6%b0/</guid>

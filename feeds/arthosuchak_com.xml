      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2024/07/Jamuna-Oil-Company-Limited-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2024/07/Jamuna-Oil-Company-Limited-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2024/07/Jamuna-Oil-Company-Limited-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যমুনা অয়েলের লভ্যাংশ ঘোষণা" /&gt;&lt;/p&gt;&lt;p&gt;পুঁজিবাজারে তালিকাভুক্ত কোম্পানি যমুনা অয়েল পিএলসি গত ৩০ জুন, ২০২৬ তারিখে সমাপ্ত হিসাববছরের জন্য লভ্যাংশ ঘোষণা করেছে। কোম্পানিটি আলোচিত বছরের জন্য শেয়ারহোল্ডারদের ১২০ শতাংশ  নগদ লভ্যাংশ দেবে। রোববার (৮ নভেম্বর) অনুষ্ঠিত কোম্পানি পরিচালনা পর্ষদের বৈঠকে সর্বশেষ হিসাববছরের নিরীক্ষিত আর্থিক প্রতিবেদন পর&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981245/%e0%a6%af%e0%a6%ae%e0%a7%81%e0%a6%a8%e0%a6%be-%e0%a6%85%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a6%b2%e0%a6%ad%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%b6-%e0%a6%98%e0%a7%8b-5/">অর্থসূচক</source>
    </item>
    <item>
      <title>এনভয় টেক্সটাইলসের প্রথম প্রান্তিক প্রকাশ</title>
      <link>https://www.arthosuchak.com/archives/981241/%e0%a6%8f%e0%a6%a8%e0%a6%ad%e0%a6%af%e0%a6%bc-%e0%a6%9f%e0%a7%87%e0%a6%95%e0%a7%8d%e0%a6%b8%e0%a6%9f%e0%a6%be%e0%a6%87%e0%a6%b2%e0%a6%b8%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a5-2/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981241/%e0%a6%8f%e0%a6%a8%e0%a6%ad%e0%a6%af%e0%a6%bc-%e0%a6%9f%e0%a7%87%e0%a6%95%e0%a7%8d%e0%a6%b8%e0%a6%9f%e0%a6%be%e0%a6%87%e0%a6%b2%e0%a6%b8%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a5-2/</guid>
      <pubDate>Sun, 08 Nov 2026 13:00:50 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2025/01/Envoy-Taxtiles-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2025/01/Envoy-Taxtiles-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2025/01/Envoy-Taxtiles-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এনভয় টেক্সটাইলসের প্রথম প্রান্তিক প্রকাশ" /&gt;&lt;/p&gt;&lt;p&gt;পুঁজিবাজারে তালিকাভুক্ত কোম্পানি এনভয় টেক্সটাইলস লিমিটেড গত ৩০ সেপ্টেম্বর, ২০২৬ তারিখে সমাপ্ত প্রথম প্রান্তিকের (জুলাই’২৬-সেপ্টেম্বর’২৬) অনিরীক্ষিত আর্থিক প্রতিবেদন প্রকাশ করেছে। রোববার (৮ নভেম্বর) অনুষ্ঠিত কোম্পানির পরিচালনা পর্ষদের বৈঠকে চলতি হিসাববছরের প্রথম প্রান্তিকের আর্থিক প্রতিবেদন পর্যালোচন&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981241/%e0%a6%8f%e0%a6%a8%e0%a6%ad%e0%a6%af%e0%a6%bc-%e0%a6%9f%e0%a7%87%e0%a6%95%e0%a7%8d%e0%a6%b8%e0%a6%9f%e0%a6%be%e0%a6%87%e0%a6%b2%e0%a6%b8%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a5-2/">অর্থসূচক</source>
    </item>
    <item>
      <title>প্রথম ধাপে ১০৫০ ইউপিতে ভোট: ইসি সচিব</title>
      <link>https://www.arthosuchak.com/archives/981239/%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a5%e0%a6%ae-%e0%a6%a7%e0%a6%be%e0%a6%aa%e0%a7%87-%e0%a7%a7%e0%a7%a6%e0%a7%ab%e0%a7%a6-%e0%a6%87%e0%a6%89%e0%a6%aa%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%ad%e0%a7%8b/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981239/%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a5%e0%a6%ae-%e0%a6%a7%e0%a6%be%e0%a6%aa%e0%a7%87-%e0%a7%a7%e0%a7%a6%e0%a7%ab%e0%a7%a6-%e0%a6%87%e0%a6%89%e0%a6%aa%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%ad%e0%a7%8b/</guid>
      <pubDate>Sun, 08 Nov 2026 12:43:38 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2025/12/Akther-300x162.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2025/12/Akther-300x162.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2025/12/Akther-300x162.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রথম ধাপে ১০৫০ ইউপিতে ভোট: ইসি সচিব" /&gt;&lt;/p&gt;&lt;p&gt;আসন্ন স্থানীয় সরকার নির্বাচনের প্রথম ধাপে ১ হাজার ৫০ ইউনিয়ন পরিষদে (ইউপি) নির্বাচন অনুষ্ঠিত হবে বলে জানিয়েছেন নির্বাচন কমিশন (ইসি) সচিবালয়ের সিনিয়র সচিব আখতার আহমেদ। রবিবার (৮ নভেম্বর) রাজধানীর আগারগাঁওয়ের নির্বাচন ভবনে সাংবাদিকদের এ তথ্য জানান তিনি। আখতার আহমেদ বলেন, ইউনিয়ন পরিষদ নির্বাচনের প্রথম &lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981239/%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a5%e0%a6%ae-%e0%a6%a7%e0%a6%be%e0%a6%aa%e0%a7%87-%e0%a7%a7%e0%a7%a6%e0%a7%ab%e0%a7%a6-%e0%a6%87%e0%a6%89%e0%a6%aa%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%ad%e0%a7%8b/">অর্থসূচক</source>
    </item>
    <item>
      <title>ডেঙ্গুতে মৃত্যু বেড়ে ৪৬১, হাসপাতালে ভর্তি ২৩৩৩</title>
      <link>https://www.arthosuchak.com/archives/981237/%e0%a6%a1%e0%a7%87%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%81%e0%a6%a4%e0%a7%87-%e0%a6%ae%e0%a7%83%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a7%81-%e0%a6%ac%e0%a7%87%e0%a6%a1%e0%a6%bc%e0%a7%87-%e0%a7%aa%e0%a7%ac/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981237/%e0%a6%a1%e0%a7%87%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%81%e0%a6%a4%e0%a7%87-%e0%a6%ae%e0%a7%83%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a7%81-%e0%a6%ac%e0%a7%87%e0%a6%a1%e0%a6%bc%e0%a7%87-%e0%a7%aa%e0%a7%ac/</guid>
      <pubDate>Sun, 08 Nov 2026 12:19:32 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2022/09/dengu-300x156.png" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2022/09/dengu-300x156.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2022/09/dengu-300x156.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডেঙ্গুতে মৃত্যু বেড়ে ৪৬১, হাসপাতালে ভর্তি ২৩৩৩" /&gt;&lt;/p&gt;&lt;p&gt;ডেঙ্গুতে আক্রান্ত হয়ে দেশে গত ২৪ ঘণ্টায় আরও তিন জনের মৃত্যু হয়েছে। একই সময়ে আক্রান্ত হয়ে হাসপাতালে ভর্তি হয়েছেন দুই হাজার ৩৩৩ জন। রোববার (৮ নভেম্বর) স্বাস্থ্য অধিদপ্তরের ডেঙ্গুবিষয়ক নিয়মিত প্রতিবেদনে এ তথ্য জানানো হয়। স্বাস্থ্য অধিদপ্তরের তথ্য অনুযায়ী, গত ২৪ ঘণ্টায় তিনজনসহ চলতি বছর ডেঙ্গুতে মোট ৪৬১ &lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981237/%e0%a6%a1%e0%a7%87%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%81%e0%a6%a4%e0%a7%87-%e0%a6%ae%e0%a7%83%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a7%81-%e0%a6%ac%e0%a7%87%e0%a6%a1%e0%a6%bc%e0%a7%87-%e0%a7%aa%e0%a7%ac/">অর্থসূচক</source>
    </item>
    <item>
      <title>সোমবার ৯ ঘণ্টা বিদ্যুৎ থাকবে না যেসব এলাকায়</title>
      <link>https://www.arthosuchak.com/archives/981235/%e0%a6%b8%e0%a7%8b%e0%a6%ae%e0%a6%ac%e0%a6%be%e0%a6%b0-%e0%a7%af-%e0%a6%98%e0%a6%a3%e0%a7%8d%e0%a6%9f%e0%a6%be-%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a7%81%e0%a7%8e-%e0%a6%a5%e0%a6%be/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/981235/%e0%a6%b8%e0%a7%8b%e0%a6%ae%e0%a6%ac%e0%a6%be%e0%a6%b0-%e0%a7%af-%e0%a6%98%e0%a6%a3%e0%a7%8d%e0%a6%9f%e0%a6%be-%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a7%81%e0%a7%8e-%e0%a6%a5%e0%a6%be/</guid>
      <pubDate>Sun, 08 Nov 2026 11:46:03 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2024/11/electricity-300x150.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2024/11/electricity-300x150.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2024/11/electricity-300x150.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সোমবার ৯ ঘণ্টা বিদ্যুৎ থাকবে না যেসব এলাকায়" /&gt;&lt;/p&gt;&lt;p&gt;জরুরি রক্ষণাবেক্ষণ কাজের জন্য আগামীকাল (৯ নভেম্বর) টানা ৯ ঘণ্টা রংপুরের বেশকিছু এলাকায় বিদ্যুৎ থাকবে না। রবিবার নর্দান ইলেকট্রিসিটি সাপ্লাই পিএলসির (নেসকো) শাপলা চত্বর বিক্রয় ও বিতরণ বিভাগ-১ এর নির্বাহী প্রকৌশলীর দপ্তর থেকে এক বিজ্ঞপ্তিতে এ তথ্য জানানো হয়েছে। বিজ্ঞপ্তিতে বলা হয়, ১১ কেভি ফিডারগুলোর ১&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/981235/%e0%a6%b8%e0%a7%8b%e0%a6%ae%e0%a6%ac%e0%a6%be%e0%a6%b0-%e0%a7%af-%e0%a6%98%e0%a6%a3%e0%a7%8d%e0%a6%9f%e0%a6%be-%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a7%81%e0%a7%8e-%e0%a6%a5%e0%a6%be/">অর্থসূচক</source>
    </item>

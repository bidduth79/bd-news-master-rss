    <item>
      <title>তেঁতুলিয়ায় যমুনা ব্যাংকের প্রশিক্ষণ শেষে সনদ পেলেন উদ্যোক্তারা</title>
      <link>https://www.arthosuchak.com/archives/983470/%e0%a6%a4%e0%a7%87%e0%a6%81%e0%a6%a4%e0%a7%81%e0%a6%b2%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%af%e0%a6%ae%e0%a7%81%e0%a6%a8%e0%a6%be-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983470/%e0%a6%a4%e0%a7%87%e0%a6%81%e0%a6%a4%e0%a7%81%e0%a6%b2%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%af%e0%a6%ae%e0%a7%81%e0%a6%a8%e0%a6%be-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82/</guid>
      <pubDate>Sun, 22 Nov 2026 10:51:41 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Panchagarh-uddokta-closing-ceremony.jpg-1-300x169.jpeg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Panchagarh-uddokta-closing-ceremony.jpg-1-300x169.jpeg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Panchagarh-uddokta-closing-ceremony.jpg-1-300x169.jpeg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="তেঁতুলিয়ায় যমুনা ব্যাংকের প্রশিক্ষণ শেষে সনদ পেলেন উদ্যোক্তারা" /&gt;&lt;/p&gt;&lt;p&gt;দক্ষ ও সম্ভাবনাময় উদ্যোক্তা তৈরির লক্ষ্যে পঞ্চগড়ের তেঁতুলিয়ায় এক মাসব্যাপী প্রশিক্ষণ কর্মসূচি সম্পন্ন করেছে যমুনা ব্যাংক পিএলসি। ১০০ ঘণ্টার এ প্রশিক্ষণ শেষে অংশগ্রহণকারীদের মধ্যে সনদপত্র ও ক্রেস্ট বিতরণ করা হয়েছে। রোববার (২২ নভেম্বর) তেঁতুলিয়ার ইকো মহানন্দা কটেজে এ উপলক্ষে সমাপনী ও সনদ বিতরণ অ&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983470/%e0%a6%a4%e0%a7%87%e0%a6%81%e0%a6%a4%e0%a7%81%e0%a6%b2%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%af%e0%a6%ae%e0%a7%81%e0%a6%a8%e0%a6%be-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82/">অর্থসূচক</source>
    </item>
    <item>
      <title>বেকারত্ব বাড়ায় এমন শিক্ষাব্যবস্থা থেকে বেরিয়ে আসতে হবে: রাষ্ট্রপতি</title>
      <link>https://www.arthosuchak.com/archives/983475/%e0%a6%ac%e0%a7%87%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%a4%e0%a7%8d%e0%a6%ac-%e0%a6%ac%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%8f%e0%a6%ae%e0%a6%a8-%e0%a6%b6%e0%a6%bf%e0%a6%95/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983475/%e0%a6%ac%e0%a7%87%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%a4%e0%a7%8d%e0%a6%ac-%e0%a6%ac%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%8f%e0%a6%ae%e0%a6%a8-%e0%a6%b6%e0%a6%bf%e0%a6%95/</guid>
      <pubDate>Sun, 22 Nov 2026 10:41:58 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/President-NS-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/President-NS-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/President-NS-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বেকারত্ব বাড়ায় এমন শিক্ষাব্যবস্থা থেকে বেরিয়ে আসতে হবে: রাষ্ট্রপতি" /&gt;&lt;/p&gt;&lt;p&gt;দেশের শিক্ষাব্যবস্থাকে আরও কর্মোপযোগী করার ওপর গুরুত্ব দিয়েছেন রাষ্ট্রপতি মির্জা ফখরুল ইসলাম আলমগীর। তিনি বলেছেন, যে শিক্ষাব্যবস্থা বেকারত্ব সৃষ্টি করে এবং কর্মক্ষেত্রের উপযোগী দক্ষতা তৈরি করতে পারে না, তা থেকে ধীরে ধীরে বেরিয়ে আসতে হবে। একই সঙ্গে বিশ্ববিদ্যালয়গুলোর গবেষণার মান বাড়ানো এবং বৈশ্বিক র‍&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983475/%e0%a6%ac%e0%a7%87%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%a4%e0%a7%8d%e0%a6%ac-%e0%a6%ac%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%8f%e0%a6%ae%e0%a6%a8-%e0%a6%b6%e0%a6%bf%e0%a6%95/">অর্থসূচক</source>
    </item>

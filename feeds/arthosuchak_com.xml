      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/09/Aprotim-CU-Teachers-Son-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/09/Aprotim-CU-Teachers-Son-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অপ্রতিম হত্যা: ২৯ নভেম্বর শুরু হচ্ছে বিচার" /&gt;&lt;/p&gt;&lt;p&gt;কুমিল্লা বিশ্ববিদ্যালয়ের বাংলা বিভাগের সহযোগী অধ্যাপক ড. নাহিদা বেগমের ছেলে এবং কুমিল্লার বর্ডার গার্ড পাবলিক স্কুলের সপ্তম শ্রেণির শিক্ষার্থী ইশায়াত শাহরিয়ার অপ্রতিম(১৩) হত্যা মামলার বিচারিক প্রক্রিয়া শুরু হতে যাচ্ছে আগামী ২৯ নভেম্বর। ওই দিন চার আসামির বিরুদ্ধে অভিযোগ গঠনের শুনানি অনুষ্ঠিত হওয়ার কথ&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983291/%e0%a6%85%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4%e0%a6%bf%e0%a6%ae-%e0%a6%b9%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a6%be-%e0%a7%a8%e0%a7%af-%e0%a6%a8%e0%a6%ad%e0%a7%87%e0%a6%ae%e0%a7%8d%e0%a6%ac%e0%a6%b0/">অর্থসূচক</source>
    </item>
    <item>
      <title>লায়ন্স ক্লাবের উদ্যোগে ‘Kids Run Fest Marathon 2026’ অনুষ্ঠিত</title>
      <link>https://www.arthosuchak.com/archives/983292/%e0%a6%b2%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a6%a8%e0%a7%8d%e0%a6%b8-%e0%a6%95%e0%a7%8d%e0%a6%b2%e0%a6%be%e0%a6%ac%e0%a7%87%e0%a6%b0-%e0%a6%89%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a7%8b%e0%a6%97%e0%a7%87/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983292/%e0%a6%b2%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a6%a8%e0%a7%8d%e0%a6%b8-%e0%a6%95%e0%a7%8d%e0%a6%b2%e0%a6%be%e0%a6%ac%e0%a7%87%e0%a6%b0-%e0%a6%89%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a7%8b%e0%a6%97%e0%a7%87/</guid>
      <pubDate>Sat, 21 Nov 2026 07:46:17 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Kids-Marathon-300x168.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Kids-Marathon-300x168.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Kids-Marathon-300x168.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="লায়ন্স ক্লাবের উদ্যোগে ‘Kids Run Fest Marathon 2026’ অনুষ্ঠিত" /&gt;&lt;/p&gt;&lt;p&gt;শিশুদের শারীরিক ও মানসিক বিকাশ, মেধা বিকাশ এবং সক্রিয় জীবনযাপনে উৎসাহিত করতে বিশ্ব শিশু দিবস ২০২৬ উপলক্ষে পুরান ঢাকায় প্রথমবারের মতো শিশুদের নিয়ে ‘Kids Run Fest Marathon 2026’ অনুষ্ঠিত হয়েছে। লায়ন্স ক্লাব অব ঢাকা প্রোটেস্টিং ভয়েজ (১৭৯৯৩২)-এর উদ্যোগে এবং লায়ন্স ক্লাব অব ঢাকা ফ্রিডম ও লায়ন্স ক্লাব অব &lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983292/%e0%a6%b2%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a6%a8%e0%a7%8d%e0%a6%b8-%e0%a6%95%e0%a7%8d%e0%a6%b2%e0%a6%be%e0%a6%ac%e0%a7%87%e0%a6%b0-%e0%a6%89%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a7%8b%e0%a6%97%e0%a7%87/">অর্থসূচক</source>
    </item>
    <item>
      <title>রিয়াদে হুতিদের ক্ষেপণাস্ত্র হামলা</title>
      <link>https://www.arthosuchak.com/archives/983284/%e0%a6%b0%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%a6%e0%a7%87-%e0%a6%b9%e0%a7%81%e0%a6%a4%e0%a6%bf%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a7%87%e0%a6%aa%e0%a6%a3%e0%a6%be%e0%a6%b8/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983284/%e0%a6%b0%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%a6%e0%a7%87-%e0%a6%b9%e0%a7%81%e0%a6%a4%e0%a6%bf%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a7%87%e0%a6%aa%e0%a6%a3%e0%a6%be%e0%a6%b8/</guid>
      <pubDate>Sat, 21 Nov 2026 07:19:05 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2022/10/Dron-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2022/10/Dron-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2022/10/Dron-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রিয়াদে হুতিদের ক্ষেপণাস্ত্র হামলা" /&gt;&lt;/p&gt;&lt;p&gt;ইয়েমেনে সৌদি নেতৃত্বাধীন জোটের ‘বিশেষ অভিযানের’ পর সৌদি আরবের রাজধানী রিয়াদ লক্ষ্য করে ক্ষেপণাস্ত্র হামলা চালিয়েছে হুতি বিদ্রোহীরা। শনিবার ভোরে চালানো এ হামলায় রিয়াদের দিকে ছোড়া তিনটি ব্যালিস্টিক ক্ষেপণাস্ত্র প্রতিহত ও ধ্বংস করার দাবি করেছে সৌদি নেতৃত্বাধীন জোট। বার্তা সংস্থা এএফপি ও রয়টার্সের প্রতি&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983284/%e0%a6%b0%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%a6%e0%a7%87-%e0%a6%b9%e0%a7%81%e0%a6%a4%e0%a6%bf%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a7%87%e0%a6%aa%e0%a6%a3%e0%a6%be%e0%a6%b8/">অর্থসূচক</source>
    </item>
    <item>
      <title>পাগলা মসজিদের দানবাক্সে এবার ৫১ বস্তা টাকা, গণনায় ৫৪০ জন</title>
      <link>https://www.arthosuchak.com/archives/983285/%e0%a6%aa%e0%a6%be%e0%a6%97%e0%a6%b2%e0%a6%be-%e0%a6%ae%e0%a6%b8%e0%a6%9c%e0%a6%bf%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%a6%e0%a6%be%e0%a6%a8%e0%a6%ac%e0%a6%be%e0%a6%95%e0%a7%8d%e0%a6%b8%e0%a7%87-2/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983285/%e0%a6%aa%e0%a6%be%e0%a6%97%e0%a6%b2%e0%a6%be-%e0%a6%ae%e0%a6%b8%e0%a6%9c%e0%a6%bf%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%a6%e0%a6%be%e0%a6%a8%e0%a6%ac%e0%a6%be%e0%a6%95%e0%a7%8d%e0%a6%b8%e0%a7%87-2/</guid>
      <pubDate>Sat, 21 Nov 2026 07:15:06 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2024/08/pagla_mosque_2-300x150.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2024/08/pagla_mosque_2-300x150.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2024/08/pagla_mosque_2-300x150.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পাগলা মসজিদের দানবাক্সে এবার ৫১ বস্তা টাকা, গণনায় ৫৪০ জন" /&gt;&lt;/p&gt;&lt;p&gt;কিশোরগঞ্জের ঐতিহ্যবাহী পাগলা মসজিদে আবারও মিলেছে বিপুল পরিমাণ দান। প্রায় পাঁচ মাস পর মসজিদের ১৫টি দানবাক্স খুলে পাওয়া গেছে ৫১ বস্তা টাকা। শনিবার (২১ নভেম্বর) সকাল থেকে এসব টাকা গণনার কাজ শুরু হয়েছে। নগদ অর্থের পাশাপাশি দানবাক্সে পাওয়া গেছে স্বর্ণ ও রুপার অলঙ্কার এবং বিভিন্ন দেশের মুদ্রা। শনিবার সকাল&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983285/%e0%a6%aa%e0%a6%be%e0%a6%97%e0%a6%b2%e0%a6%be-%e0%a6%ae%e0%a6%b8%e0%a6%9c%e0%a6%bf%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%a6%e0%a6%be%e0%a6%a8%e0%a6%ac%e0%a6%be%e0%a6%95%e0%a7%8d%e0%a6%b8%e0%a7%87-2/">অর্থসূচক</source>
    </item>
    <item>
      <title>আধুনিক সেনাবাহিনীর ভিত্তি স্থাপন করেছিলেন জিয়াউর রহমান: রিজভী</title>
      <link>https://www.arthosuchak.com/archives/983282/%e0%a6%86%e0%a6%a7%e0%a7%81%e0%a6%a8%e0%a6%bf%e0%a6%95-%e0%a6%b8%e0%a7%87%e0%a6%a8%e0%a6%be%e0%a6%ac%e0%a6%be%e0%a6%b9%e0%a6%bf%e0%a6%a8%e0%a7%80%e0%a6%b0-%e0%a6%ad%e0%a6%bf%e0%a6%a4%e0%a7%8d%e0%a6%a4/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/983282/%e0%a6%86%e0%a6%a7%e0%a7%81%e0%a6%a8%e0%a6%bf%e0%a6%95-%e0%a6%b8%e0%a7%87%e0%a6%a8%e0%a6%be%e0%a6%ac%e0%a6%be%e0%a6%b9%e0%a6%bf%e0%a6%a8%e0%a7%80%e0%a6%b0-%e0%a6%ad%e0%a6%bf%e0%a6%a4%e0%a7%8d%e0%a6%a4/</guid>
      <pubDate>Sat, 21 Nov 2026 06:58:26 +0000</pubDate>
      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2021/01/rizbi-h-300x169.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2021/01/rizbi-h-300x169.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2021/01/rizbi-h-300x169.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আধুনিক সেনাবাহিনীর ভিত্তি স্থাপন করেছিলেন জিয়াউর রহমান: রিজভী" /&gt;&lt;/p&gt;&lt;p&gt;সেনাবাহিনীকে আধুনিক ও প্রযুক্তিনির্ভর হিসেবে গড়ে তোলার ক্ষেত্রে শহীদ রাষ্ট্রপতি জিয়াউর রহমান গুরুত্বপূর্ণ ভূমিকা রেখেছেন বলে মন্তব্য করেছেন বিএনপির ভারপ্রাপ্ত মহাসচিব রুহুল কবির রিজভী। সশস্ত্র বাহিনী দিবস উপলক্ষে শনিবার (২১ নভেম্বর) বিএনপির কেন্দ্রীয় কার্যালয়ের সামনে আয়োজিত র‍্যালিপূর্ব সমাবেশে তিনি&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/983282/%e0%a6%86%e0%a6%a7%e0%a7%81%e0%a6%a8%e0%a6%bf%e0%a6%95-%e0%a6%b8%e0%a7%87%e0%a6%a8%e0%a6%be%e0%a6%ac%e0%a6%be%e0%a6%b9%e0%a6%bf%e0%a6%a8%e0%a7%80%e0%a6%b0-%e0%a6%ad%e0%a6%bf%e0%a6%a4%e0%a7%8d%e0%a6%a4/">অর্থসূচক</source>

    <item>
      <title>আইন-শৃঙ্খলা রক্ষাকারী বাহিনী জনগণের আস্থা অর্জন করেছে: স্বরাষ্ট্রমন্ত্রী</title>
      <link>https://www.arthosuchak.com/archives/984443/%e0%a6%86%e0%a6%87%e0%a6%a8-%e0%a6%b6%e0%a7%83%e0%a6%99%e0%a7%8d%e0%a6%96%e0%a6%b2%e0%a6%be-%e0%a6%b0%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%be%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a7%80-%e0%a6%ac%e0%a6%be/</link>
      <guid isPermaLink="true">https://www.arthosuchak.com/archives/984443/%e0%a6%86%e0%a6%87%e0%a6%a8-%e0%a6%b6%e0%a7%83%e0%a6%99%e0%a7%8d%e0%a6%96%e0%a6%b2%e0%a6%be-%e0%a6%b0%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%be%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a7%80-%e0%a6%ac%e0%a6%be/</guid>

      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Trump-Putin-and-Xi-300x168.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2026/11/Trump-Putin-and-Xi-300x168.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2026/11/Trump-Putin-and-Xi-300x168.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইরান যুদ্ধ শেষ করতে শি ও পুতিনের সাহায্য চাইবেন ট্রাম্প" /&gt;&lt;/p&gt;&lt;p&gt;ইরানের সঙ্গে যুদ্ধের অবসান ঘটাতে চীনের প্রেসিডেন্ট শি জিনপিং এবং রুশ প্রেসিডেন্ট ভ্লাদিমির পুতিনের কাছে সাহায্য চাইবেন মার্কিন প্রেসিডেন্ট ডোনাল্ড ট্রাম্প। মঙ্গলবার ফিলিপিন্সের রাজধানী ম্যানিলায় তিনি সাংবাদিকদেরকে এ কথা জানিয়েছেন। কোয়াড ও আসিয়ান সম্মেলন শেষে ম্যানিলা থেকে চীনে যাওয়ার কথা রয়েছে ট্&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/982849/%e0%a6%87%e0%a6%b0%e0%a6%be%e0%a6%a8-%e0%a6%af%e0%a7%81%e0%a6%a6%e0%a7%8d%e0%a6%a7-%e0%a6%b6%e0%a7%87%e0%a6%b7-%e0%a6%95%e0%a6%b0%e0%a6%a4%e0%a7%87-%e0%a6%b6%e0%a6%bf-%e0%a6%93-%e0%a6%aa%e0%a7%81/">অর্থসূচক</source>

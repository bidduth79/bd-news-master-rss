      <enclosure url="https://www.arthosuchak.com/wp-content/uploads/2023/01/bangladesh-bank-02-300x169.png" length="0" type="image/jpeg" />
      <media:content url="https://www.arthosuchak.com/wp-content/uploads/2023/01/bangladesh-bank-02-300x169.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.arthosuchak.com/wp-content/uploads/2023/01/bangladesh-bank-02-300x169.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="স্থানীয় এলসিতে সুইফটের বিকল্প ‘বার্তা’ চালু করলো বাংলাদেশ ব্যাংক" /&gt;&lt;/p&gt;&lt;p&gt;আন্তর্জাতিক লেনদেনের মাধ্যম ‘সুইফট’ এর পাশাপাশি স্থানীয় এলসিতে এখন থেকে দেশীয় প্রযুক্তি নির্ভর নতুন ব্যবস্থা ‘বার্তা’ চালু করলো বাংলাদেশ ব্যাংক। এতে খরচ কমার পাশাপাশি জালিয়াতি কমে স্বচ্ছতা বাড়বে বলে মনে করেন অর্থ ও পরিকল্পনামন্ত্রী আমীর খসরু মাহমুদ চৌধুরী। শনিবার রাজধানীর মিরপুরে বাংলাদেশ ব্যাংক আয়ো&lt;/p&gt;</description>
      <source url="https://www.arthosuchak.com/archives/984429/%e0%a6%b8%e0%a7%8d%e0%a6%a5%e0%a6%be%e0%a6%a8%e0%a7%80%e0%a6%af%e0%a6%bc-%e0%a6%8f%e0%a6%b2%e0%a6%b8%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%b8%e0%a7%81%e0%a6%87%e0%a6%ab%e0%a6%9f%e0%a7%87%e0%a6%b0/">অর্থসূচক</source>

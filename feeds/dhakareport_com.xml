    <item>
      <title>ফাহিমের কণ্ঠে ‘অশ্রু’, সুরও করেছেন নিজেই</title>
      <link>https://dhakareport.com/2026/11/03/%e0%a6%ab%e0%a6%be%e0%a6%b9%e0%a6%bf%e0%a6%ae%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a6%a3%e0%a7%8d%e0%a6%a0%e0%a7%87-%e0%a6%85%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a7%81-%e0%a6%b8%e0%a7%81/</link>
      <guid isPermaLink="true">https://dhakareport.com/2026/11/03/%e0%a6%ab%e0%a6%be%e0%a6%b9%e0%a6%bf%e0%a6%ae%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a6%a3%e0%a7%8d%e0%a6%a0%e0%a7%87-%e0%a6%85%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a7%81-%e0%a6%b8%e0%a7%81/</guid>
      <pubDate>Tue, 03 Nov 2026 10:42:40 +0000</pubDate>
      <description>নতুন গান নিয়ে শ্রোতাদের সামনে হাজির হচ্ছেন সংগীতশিল্পী ফাহিম ইসলাম। তার এবারের গানের শিরোনাম ‘অশ্রু’। আবেগঘন কথামালা ও সুরের সমন্বয়ে তৈরি গানটি নিয়ে শ্রোতাদের আগ্রহ তৈরি হবে বলে প্রত্যাশা সংশ্লিষ্টদের। ‘অশ্রু’ গানটির বিশেষত্ব হলো, এর কথা, সুর ও সংগীতায়োজনে রয়েছে একাধিক সংগীতশিল্পীর সৃজনশীল অংশগ্রহণ।</description>
      <source url="https://dhakareport.com/2026/11/03/%e0%a6%ab%e0%a6%be%e0%a6%b9%e0%a6%bf%e0%a6%ae%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a6%a3%e0%a7%8d%e0%a6%a0%e0%a7%87-%e0%a6%85%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a7%81-%e0%a6%b8%e0%a7%81/">dhakareport.com</source>
    </item>
    <item>
      <title>অস্ট্রেলিয়ার মাটিতে টাইগারদের দাপট, ৯ উইকেটের ঐতিহাসিক জয়</title>
      <link>https://dhakareport.com/2026/08/16/%e0%a6%85%e0%a6%b8%e0%a7%8d%e0%a6%9f%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%b2%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0-%e0%a6%ae%e0%a6%be%e0%a6%9f%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%9f%e0%a6%be%e0%a6%87/</link>

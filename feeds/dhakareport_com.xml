    <item>
      <title>জমির ভাগ কম পাওয়ায় বাবার কবর ভাঙচুর করলেন ছেলে, নেটদুনিয়ায় নিন্দার ঝড়</title>
      <link>https://dhakareport.com/2026/03/25/%e0%a6%9c%e0%a6%ae%e0%a6%bf%e0%a6%b0-%e0%a6%ad%e0%a6%be%e0%a6%97-%e0%a6%95%e0%a6%ae-%e0%a6%aa%e0%a6%be%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%ac%e0%a6%be%e0%a6%ac%e0%a6%be/</link>

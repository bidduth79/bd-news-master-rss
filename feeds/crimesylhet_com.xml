    <item>
      <title>সুনামগঞ্জ সওজের ৩৮ কোটি টাকার দুর্নীতি: ভুয়া ইস্টিমেট ও চেক জালিয়াতির অভিযোগ</title>
      <link>https://www.crimesylhet.com/2026/11/02/%e0%a6%b8%e0%a7%81%e0%a6%a8%e0%a6%be%e0%a6%ae%e0%a6%97%e0%a6%9e%e0%a7%8d%e0%a6%9c-%e0%a6%b8%e0%a6%93%e0%a6%9c%e0%a7%87%e0%a6%b0-%e0%a7%a9%e0%a7%ae-%e0%a6%95%e0%a7%8b%e0%a6%9f%e0%a6%bf-%e0%a6%9f/</link>

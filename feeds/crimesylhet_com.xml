    <item>
      <title>পূর্ব জাফলং ইউপি নির্বাচন: আলোচনার কেন্দ্রবিন্দুতে আব্দুল মান্নান</title>
      <link>https://www.crimesylhet.com/2026/11/08/%e0%a6%aa%e0%a7%82%e0%a6%b0%e0%a7%8d%e0%a6%ac-%e0%a6%9c%e0%a6%be%e0%a6%ab%e0%a6%b2%e0%a6%82-%e0%a6%87%e0%a6%89%e0%a6%aa%e0%a6%bf-%e0%a6%a8%e0%a6%bf%e0%a6%b0%e0%a7%8d%e0%a6%ac%e0%a6%be%e0%a6%9a/</link>

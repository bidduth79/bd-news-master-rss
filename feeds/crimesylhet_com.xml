    <item>
      <title>৪২ লাখ টাকার বেশি মূল্যের ভারতীয় মদ, ক্যানুলা ও জিরা জব্দ করেছে বিজিবি</title>
      <link>https://www.crimesylhet.com/2026/11/08/%e0%a7%aa%e0%a7%a8-%e0%a6%b2%e0%a6%be%e0%a6%96-%e0%a6%9f%e0%a6%be%e0%a6%95%e0%a6%be%e0%a6%b0-%e0%a6%ac%e0%a7%87%e0%a6%b6%e0%a6%bf-%e0%a6%ae%e0%a7%82%e0%a6%b2%e0%a7%8d%e0%a6%af%e0%a7%87%e0%a6%b0/</link>

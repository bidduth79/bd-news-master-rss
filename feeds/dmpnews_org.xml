    <item>
      <title>ট্রাফিক আইন লঙ্ঘনে গত ২৪ ঘন্টায় ডিএমপির ২৫১৮ মামলা</title>
      <link>https://dmpnews.org/%e0%a6%9f%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ab%e0%a6%bf%e0%a6%95-%e0%a6%86%e0%a6%87%e0%a6%a8-%e0%a6%b2%e0%a6%99%e0%a7%8d%e0%a6%98%e0%a6%a8%e0%a7%87-%e0%a6%97%e0%a6%a4-%e0%a7%a8%e0%a7%aa-%e0%a6%98-17/</link>

    </item>
    <item>
      <title>ডিএমপির অভিযানে গত ২৪ ঘণ্টায় গ্রেফতার ৪৮৪, মামলা ৫২</title>
      <link>https://dmpnews.org/%e0%a6%a1%e0%a6%bf%e0%a6%8f%e0%a6%ae%e0%a6%aa%e0%a6%bf%e0%a6%b0-%e0%a6%85%e0%a6%ad%e0%a6%bf%e0%a6%af%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%97%e0%a6%a4-%e0%a7%a8%e0%a7%aa-%e0%a6%98%e0%a6%a3%e0%a7%8d-134/</link>
      <guid isPermaLink="true">https://dmpnews.org/%e0%a6%a1%e0%a6%bf%e0%a6%8f%e0%a6%ae%e0%a6%aa%e0%a6%bf%e0%a6%b0-%e0%a6%85%e0%a6%ad%e0%a6%bf%e0%a6%af%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%97%e0%a6%a4-%e0%a7%a8%e0%a7%aa-%e0%a6%98%e0%a6%a3%e0%a7%8d-134/</guid>
      <pubDate>Thu, 12 Nov 2026 03:59:12 +0000</pubDate>
      <description>রাজধানীতে ঢাকা মেট্রোপলিটন পুলিশের নিয়মিত অভিযানে গত ২৪ ঘণ্টায় ৪৮৪ জন গ্রেফতার হয়েছে। একই সময়ে ৫২ টি মামলা দায়ের করা হয়েছে। গ্রেফতারকৃতদের মধ্যে রমনা বিভাগ ২৯ জন, লালবাগ বিভাগ ৪৯ জন, ওয়ারী বিভাগ ৪০ জন, মতিঝিল বিভাগ ৫৯ জন, তেজগাঁও বিভাগ ৭৬ জন, মিরপুর বিভাগ ১২৭ জন, গুলশান বিভাগ ৪৫ জন, উত্তরা বিভাগ ৫১ </description>
      <source url="https://dmpnews.org/%e0%a6%a1%e0%a6%bf%e0%a6%8f%e0%a6%ae%e0%a6%aa%e0%a6%bf%e0%a6%b0-%e0%a6%85%e0%a6%ad%e0%a6%bf%e0%a6%af%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%97%e0%a6%a4-%e0%a7%a8%e0%a7%aa-%e0%a6%98%e0%a6%a3%e0%a7%8d-134/">ডিএমপি নিউজ</source>
    </item>
    <item>
      <title>উত্তরা পূর্ব থানার অভিযানে কিশোর গ্যাংয়ের মূল হোতাসহ গ্রেফতার ৩</title>

    <item>
      <title>যাত্রাবাড়ী ও পল্টনে পৃথক অভিযানে সাত ছিনতাইকারী গ্রেফতার</title>
      <link>https://dmpnews.org/%e0%a6%af%e0%a6%be%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ac%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a7%80-%e0%a6%93-%e0%a6%aa%e0%a6%b2%e0%a7%8d%e0%a6%9f%e0%a6%a8%e0%a7%87-%e0%a6%aa%e0%a7%83%e0%a6%a5/</link>

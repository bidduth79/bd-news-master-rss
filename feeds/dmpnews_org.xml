    <item>
      <title>পদোন্নতিপ্রাপ্ত ১০ সহকারী পুলিশ কমিশনারকে র‍্যাঙ্ক ব্যাজ পরিয়ে দিলেন ডিএমপি কমিশনার</title>
      <link>https://dmpnews.org/%e0%a6%aa%e0%a6%a6%e0%a7%8b%e0%a6%a8%e0%a7%8d%e0%a6%a8%e0%a6%a4%e0%a6%bf%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%a4-%e0%a7%a7%e0%a7%a6-%e0%a6%b8%e0%a6%b9%e0%a6%95%e0%a6%be%e0%a6%b0/</link>
      <guid isPermaLink="true">https://dmpnews.org/%e0%a6%aa%e0%a6%a6%e0%a7%8b%e0%a6%a8%e0%a7%8d%e0%a6%a8%e0%a6%a4%e0%a6%bf%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%a4-%e0%a7%a7%e0%a7%a6-%e0%a6%b8%e0%a6%b9%e0%a6%95%e0%a6%be%e0%a6%b0/</guid>
      <pubDate>Mon, 09 Nov 2026 12:08:00 +0000</pubDate>
      <enclosure url="https://dmpnews.org/wp-content/uploads/2026/11/WhatsApp-Image-2026-11-09-at-6.04.48-PM.jpeg" length="0" type="image/jpeg" />
      <media:content url="https://dmpnews.org/wp-content/uploads/2026/11/WhatsApp-Image-2026-11-09-at-6.04.48-PM.jpeg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://dmpnews.org/wp-content/uploads/2026/11/WhatsApp-Image-2026-11-09-at-6.04.48-PM.jpeg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পদোন্নতিপ্রাপ্ত ১০ সহকারী পুলিশ কমিশনারকে র‍্যাঙ্ক ব্যাজ পরিয়ে দিলেন ডিএমপি কমিশনার" /&gt;&lt;/p&gt;&lt;p&gt;ঢাকা মেট্রোপলিটন পুলিশের পদোন্নতিপ্রাপ্ত ১০ জন সহকারী পুলিশ কমিশনারকে র‍্যাঙ্ক ব্যাজ পরিয়ে দিয়েছেন ডিএমপি কমিশনার মোসলেহ্ উদ্দিন আহমদ, বিপিএম-সেবা। আজ সোমবার (৯ নভেম্বর) দুপুর ১২:৩০ ঘটিকায় ডিএমপি হেডকোয়ার্টার্সের সম্মেলন কক্ষে আয়োজিত এক অনুষ্ঠানে পদোন্নতিপ্রাপ্ত কর্মকর্তাদের র‍্যাঙ্ক ব্যাজ পরিয়ে দেন&lt;/p&gt;</description>
      <source url="https://dmpnews.org/%e0%a6%aa%e0%a6%a6%e0%a7%8b%e0%a6%a8%e0%a7%8d%e0%a6%a8%e0%a6%a4%e0%a6%bf%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%aa%e0%a7%8d%e0%a6%a4-%e0%a7%a7%e0%a7%a6-%e0%a6%b8%e0%a6%b9%e0%a6%95%e0%a6%be%e0%a6%b0/">ডিএমপি নিউজ</source>
    </item>
    <item>

    <item>
      <title>ডিএমপির অভিযানে গত ২৪ ঘণ্টায় গ্রেফতার ৫২০, মামলা ৩৯</title>
      <link>https://dmpnews.org/%e0%a6%a1%e0%a6%bf%e0%a6%8f%e0%a6%ae%e0%a6%aa%e0%a6%bf%e0%a6%b0-%e0%a6%85%e0%a6%ad%e0%a6%bf%e0%a6%af%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%97%e0%a6%a4-%e0%a7%a8%e0%a7%aa-%e0%a6%98%e0%a6%a3%e0%a7%8d-137/</link>

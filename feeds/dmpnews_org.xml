    <item>
      <title>তুরাগ থানা পুলিশের অভিযানে কার্যক্রম নিষিদ্ধ সংগঠন আওয়ামী লীগের ৩ সদস্য গ্রেফতার</title>
      <link>https://dmpnews.org/%e0%a6%a4%e0%a7%81%e0%a6%b0%e0%a6%be%e0%a6%97-%e0%a6%a5%e0%a6%be%e0%a6%a8%e0%a6%be-%e0%a6%aa%e0%a7%81%e0%a6%b2%e0%a6%bf%e0%a6%b6%e0%a7%87%e0%a6%b0-%e0%a6%85%e0%a6%ad%e0%a6%bf%e0%a6%af%e0%a6%be-10/</link>

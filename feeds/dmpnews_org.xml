    <item>
      <title>মিরপুরে নিষিদ্ধ ঘোষিত ছাত্রলীগের সাত কর্মী ও যুবলীগের এক নেতা গ্রেফতার</title>
      <link>https://dmpnews.org/%e0%a6%ae%e0%a6%bf%e0%a6%b0%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87-%e0%a6%a8%e0%a6%bf%e0%a6%b7%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%a7-%e0%a6%98%e0%a7%8b%e0%a6%b7%e0%a6%bf%e0%a6%a4-%e0%a6%9b%e0%a6%be/</link>
      <guid isPermaLink="true">https://dmpnews.org/%e0%a6%ae%e0%a6%bf%e0%a6%b0%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87-%e0%a6%a8%e0%a6%bf%e0%a6%b7%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%a7-%e0%a6%98%e0%a7%8b%e0%a6%b7%e0%a6%bf%e0%a6%a4-%e0%a6%9b%e0%a6%be/</guid>
      <pubDate>Fri, 13 Nov 2026 17:24:48 +0000</pubDate>
      <description>রাজধানীর মিরপুর এলাকায় অভিযান চালিয়ে মিছিল করার সময় নিষিদ্ধ ঘোষিত সংগঠন ছাত্রলীগের সাত কর্মীকে আটক করেছে মিরপুর মডেল থানা পুলিশ। এছাড়া পৃথক অভিযানে যুবলীগের এক নেতাকে গ্রেফতার করা হয়েছে। মিরপুর মডেল থানা সূত্রে জানা যায়, শুক্রবার (১৩ নভেম্বর) রাত ১ টায় মিরপুর মডেল থানাধীন মিরপুর-২ এলাকায় নিষিদ্ধ ঘোষ</description>
      <source url="https://dmpnews.org/%e0%a6%ae%e0%a6%bf%e0%a6%b0%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87-%e0%a6%a8%e0%a6%bf%e0%a6%b7%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%a7-%e0%a6%98%e0%a7%8b%e0%a6%b7%e0%a6%bf%e0%a6%a4-%e0%a6%9b%e0%a6%be/">ডিএমপি নিউজ</source>
    </item>
    <item>
      <title>মিছিলের প্রস্তুতির সময় নিষিদ্ধ ঘোষিত সংগঠন ছাত্রলীগের দুই সদস্য গ্রেফতার</title>
      <link>https://dmpnews.org/%e0%a6%ae%e0%a6%bf%e0%a6%9b%e0%a6%bf%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%b8%e0%a7%8d%e0%a6%a4%e0%a7%81%e0%a6%a4%e0%a6%bf%e0%a6%b0-%e0%a6%b8%e0%a6%ae%e0%a6%af%e0%a6%bc/</link>

    <item>
      <title>এসআরইউ’র অভিযানে পাঁচটি ককটেলসহ গ্রেফতার একজন</title>
      <link>https://dmpnews.org/%e0%a6%8f%e0%a6%b8%e0%a6%86%e0%a6%b0%e0%a6%87%e0%a6%89%e0%a6%b0-%e0%a6%85%e0%a6%ad%e0%a6%bf%e0%a6%af%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%aa%e0%a6%be%e0%a6%81%e0%a6%9a%e0%a6%9f%e0%a6%bf/</link>
      <guid isPermaLink="true">https://dmpnews.org/%e0%a6%8f%e0%a6%b8%e0%a6%86%e0%a6%b0%e0%a6%87%e0%a6%89%e0%a6%b0-%e0%a6%85%e0%a6%ad%e0%a6%bf%e0%a6%af%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%aa%e0%a6%be%e0%a6%81%e0%a6%9a%e0%a6%9f%e0%a6%bf/</guid>
      <pubDate>Mon, 23 Nov 2026 05:30:12 +0000</pubDate>
      <enclosure url="https://dmpnews.org/wp-content/uploads/2026/11/ট্ট্_-300x189.jpg" length="0" type="image/jpeg" />
      <media:content url="https://dmpnews.org/wp-content/uploads/2026/11/ট্ট্_-300x189.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://dmpnews.org/wp-content/uploads/2026/11/ট্ট্_-300x189.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এসআরইউ’র অভিযানে পাঁচটি ককটেলসহ গ্রেফতার একজন" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর যাত্রাবাড়ী থানাধীন জনপদ মোড়ে চেকপোস্ট পরিচালনাকালে পাঁচটি ককটেলসহ মোঃ সাইফুল ইসলাম (৩৪) নামে একজনকে গ্রেফতার করেছে স্পেশাল রেসপন্স ইউনিট (এসআরইউ), ডিএমপি। এসআরইউ সূত্রে জানা যায়, গত ৯ নভেম্বর ২০২৬ তারিখে এসআরইউর নেতৃত্বে যাত্রাবাড়ী থানা পুলিশ ও ট্রাফিক পুলিশের সদস্যদের সহযোগিতায় জনপদ মোড়ে চ&lt;/p&gt;</description>
      <source url="https://dmpnews.org/%e0%a6%8f%e0%a6%b8%e0%a6%86%e0%a6%b0%e0%a6%87%e0%a6%89%e0%a6%b0-%e0%a6%85%e0%a6%ad%e0%a6%bf%e0%a6%af%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%aa%e0%a6%be%e0%a6%81%e0%a6%9a%e0%a6%9f%e0%a6%bf/">ডিএমপি নিউজ</source>
    </item>
    <item>
      <title>ডিবি মতিঝিলের অভিযানে যাত্রাবাড়ীতে ৫০ কেজি গাঁজাসহ মাদক কারবারি গ্রেফতার</title>
      <link>https://dmpnews.org/%e0%a6%a1%e0%a6%bf%e0%a6%ac%e0%a6%bf-%e0%a6%ae%e0%a6%a4%e0%a6%bf%e0%a6%9d%e0%a6%bf%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a6%85%e0%a6%ad%e0%a6%bf%e0%a6%af%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%af%e0%a6%be-4/</link>
      <guid isPermaLink="true">https://dmpnews.org/%e0%a6%a1%e0%a6%bf%e0%a6%ac%e0%a6%bf-%e0%a6%ae%e0%a6%a4%e0%a6%bf%e0%a6%9d%e0%a6%bf%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a6%85%e0%a6%ad%e0%a6%bf%e0%a6%af%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%af%e0%a6%be-4/</guid>
      <pubDate>Mon, 23 Nov 2026 04:54:32 +0000</pubDate>
      <enclosure url="https://dmpnews.org/wp-content/uploads/2026/11/7-1.jpg" length="0" type="image/jpeg" />
      <media:content url="https://dmpnews.org/wp-content/uploads/2026/11/7-1.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://dmpnews.org/wp-content/uploads/2026/11/7-1.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডিবি মতিঝিলের অভিযানে যাত্রাবাড়ীতে ৫০ কেজি গাঁজাসহ মাদক কারবারি গ্রেফতার" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর যাত্রাবাড়ী এলাকায় অভিযান পরিচালনা করে ৫০ কেজি গাঁজাসহ এক মাদক কারবারিকে গ্রেফতার করেছে ঢাকা মেট্রোপলিটন পুলিশের (ডিএমপি) গোয়েন্দা-মতিঝিল বিভাগ। গ্রেফতারকৃতের নাম- মোঃ সাকিব আহম্মেদ (২৪)। গোয়েন্দা-মতিঝিল বিভাগ সূত্রে জানা যায়, রবিবার (২২ নভেম্বর) সকাল ৯: ২০ ঘটিকায় যাত্রাবাড়ী থানাধীন শনির আখড়&lt;/p&gt;</description>
      <source url="https://dmpnews.org/%e0%a6%a1%e0%a6%bf%e0%a6%ac%e0%a6%bf-%e0%a6%ae%e0%a6%a4%e0%a6%bf%e0%a6%9d%e0%a6%bf%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a6%85%e0%a6%ad%e0%a6%bf%e0%a6%af%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%af%e0%a6%be-4/">ডিএমপি নিউজ</source>
    </item>
    <item>
      <title>ডিএমপির অভিযানে গত ২৪ ঘণ্টায় গ্রেফতার ৫২১, মামলা ৪০</title>
      <link>https://dmpnews.org/%e0%a6%a1%e0%a6%bf%e0%a6%8f%e0%a6%ae%e0%a6%aa%e0%a6%bf%e0%a6%b0-%e0%a6%85%e0%a6%ad%e0%a6%bf%e0%a6%af%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%97%e0%a6%a4-%e0%a7%a8%e0%a7%aa-%e0%a6%98%e0%a6%a3%e0%a7%8d-145/</link>

    </item>
    <item>
      <title>নগরবাসীর জানমালের নিরাপত্তায় রাজধানীজুড়ে ডিএমপির জোরালো চেকপোস্ট ও নজরদারি</title>
      <link>https://dmpnews.org/%e0%a6%a8%e0%a6%97%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a7%80%e0%a6%b0-%e0%a6%9c%e0%a6%be%e0%a6%a8%e0%a6%ae%e0%a6%be%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a6%bf%e0%a6%b0%e0%a6%be%e0%a6%aa%e0%a6%a4/</link>
      <guid isPermaLink="true">https://dmpnews.org/%e0%a6%a8%e0%a6%97%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a7%80%e0%a6%b0-%e0%a6%9c%e0%a6%be%e0%a6%a8%e0%a6%ae%e0%a6%be%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a6%bf%e0%a6%b0%e0%a6%be%e0%a6%aa%e0%a6%a4/</guid>
      <pubDate>Wed, 11 Nov 2026 10:46:11 +0000</pubDate>
      <enclosure url="https://dmpnews.org/wp-content/uploads/2026/11/rrrrrrrrrrrrrrrr-1-300x200.jpg" length="0" type="image/jpeg" />
      <media:content url="https://dmpnews.org/wp-content/uploads/2026/11/rrrrrrrrrrrrrrrr-1-300x200.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://dmpnews.org/wp-content/uploads/2026/11/rrrrrrrrrrrrrrrr-1-300x200.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নগরবাসীর জানমালের নিরাপত্তায় রাজধানীজুড়ে ডিএমপির জোরালো চেকপোস্ট ও নজরদারি" /&gt;&lt;/p&gt;&lt;p&gt;নগরবাসীর জানমালের নিরাপত্তা নিশ্চিত করা, অপরাধমূলক কর্মকাণ্ড প্রতিরোধ এবং যানবাহনের নিরাপত্তা রক্ষায় রাজধানীজুড়ে জোরদার নিরাপত্তা ব্যবস্থা গ্রহণ করেছে ঢাকা মেট্রোপলিটন পুলিশ (ডিএমপি)। নগরীর গুরুত্বপূর্ণ প্রবেশপথ, সড়ক ও অপরাধপ্রবণ এলাকাগুলোতে জোরালো চেকপোস্ট স্থাপনের পাশাপাশি বাড়ানো হয়েছে পুলিশি টহল &lt;/p&gt;</description>
      <source url="https://dmpnews.org/%e0%a6%a8%e0%a6%97%e0%a6%b0%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a7%80%e0%a6%b0-%e0%a6%9c%e0%a6%be%e0%a6%a8%e0%a6%ae%e0%a6%be%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a6%bf%e0%a6%b0%e0%a6%be%e0%a6%aa%e0%a6%a4/">ডিএমপি নিউজ</source>
    </item>

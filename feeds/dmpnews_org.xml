    </item>
    <item>
      <title>কলাবাগান থানা পুলিশের অভিযানে ছয় ওয়ারেন্টভুক্ত পলাতক আসামি গ্রেফতার</title>
      <link>https://dmpnews.org/%e0%a6%95%e0%a6%b2%e0%a6%be%e0%a6%ac%e0%a6%be%e0%a6%97%e0%a6%be%e0%a6%a8-%e0%a6%a5%e0%a6%be%e0%a6%a8%e0%a6%be-%e0%a6%aa%e0%a7%81%e0%a6%b2%e0%a6%bf%e0%a6%b6%e0%a7%87%e0%a6%b0-%e0%a6%85%e0%a6%ad/</link>

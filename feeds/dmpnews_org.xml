    <item>
      <title>এসআরইউ’র বিশেষ অভিযানে ৪ জন গ্রেফতার</title>
      <link>https://dmpnews.org/%e0%a6%8f%e0%a6%b8%e0%a6%86%e0%a6%b0%e0%a6%87%e0%a6%89%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%87%e0%a6%b7-%e0%a6%85%e0%a6%ad%e0%a6%bf%e0%a6%af%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a7%aa/</link>

    <item>
      <title>রিজার্ভ খরচ করায় বাড়ছে ডলারের দাম, ছাড়িয়েছে ১২৪ টাকা</title>
      <link>https://odhikar.news/2026/11/08/%e0%a6%b0%e0%a6%bf%e0%a6%9c%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%ad-%e0%a6%96%e0%a6%b0%e0%a6%9a-%e0%a6%95%e0%a6%b0%e0%a6%be%e0%a7%9f-%e0%a6%ac%e0%a6%be%e0%a7%9c%e0%a6%9b%e0%a7%87-%e0%a6%a1%e0%a6%b2/</link>

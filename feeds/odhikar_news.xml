    <item>
      <title>গাজীপুরে পোশাকশ্রমিকদের বিক্ষোভ, কাঁদানে গ্যাস ছুড়ে সরালো পুলিশ</title>
      <link>https://odhikar.news/2026/11/16/%e0%a6%97%e0%a6%be%e0%a6%9c%e0%a7%80%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87-%e0%a6%aa%e0%a7%8b%e0%a6%b6%e0%a6%be%e0%a6%95%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a6%ae%e0%a6%bf%e0%a6%95%e0%a6%a6%e0%a7%87%e0%a6%b0/</link>

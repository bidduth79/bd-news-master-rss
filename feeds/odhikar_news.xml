    <item>
      <title>পদ্মা সেতুতে যান চলাচল স্বাভাবিক</title>
      <link>https://odhikar.news/2026/11/19/%e0%a6%aa%e0%a6%a6%e0%a7%8d%e0%a6%ae%e0%a6%be-%e0%a6%b8%e0%a7%87%e0%a6%a4%e0%a7%81%e0%a6%a4%e0%a7%87-%e0%a6%af%e0%a6%be%e0%a6%a8-%e0%a6%9a%e0%a6%b2%e0%a6%be%e0%a6%9a%e0%a6%b2-%e0%a6%b8%e0%a7%8d/</link>

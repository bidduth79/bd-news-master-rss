    <item>
      <title>এবার আইপিএলকে বয়কট করলেন মোস্তাফিজ</title>
      <link>https://odhikar.news/2026/11/25/%e0%a6%8f%e0%a6%ac%e0%a6%be%e0%a6%b0-%e0%a6%86%e0%a6%87%e0%a6%aa%e0%a6%bf%e0%a6%8f%e0%a6%b2%e0%a6%95%e0%a7%87-%e0%a6%ac%e0%a7%9f%e0%a6%95%e0%a6%9f-%e0%a6%95%e0%a6%b0%e0%a6%b2%e0%a7%87%e0%a6%a8/</link>
      <guid isPermaLink="true">https://odhikar.news/2026/11/25/%e0%a6%8f%e0%a6%ac%e0%a6%be%e0%a6%b0-%e0%a6%86%e0%a6%87%e0%a6%aa%e0%a6%bf%e0%a6%8f%e0%a6%b2%e0%a6%95%e0%a7%87-%e0%a6%ac%e0%a7%9f%e0%a6%95%e0%a6%9f-%e0%a6%95%e0%a6%b0%e0%a6%b2%e0%a7%87%e0%a6%a8/</guid>
      <pubDate>Wed, 25 Nov 2026 09:51:32 +0000</pubDate>
      <description>আইপিএলের গত নিলামে রেকর্ড দামে দল পেয়েছিলেন বাংলাদেশের তারকা পেসার মোস্তাফিজুর রহমান। তবে রাজনৈতিক পরিস্থিতির কারণে শেষ পর্যন্ত কলকাতা নাইট রাইডার্সের (কেকেআর) হয়ে খেলা হয়নি তার। এবার আইপিএলের আগামী আসরের নিলামে নাম নিবন্ধনই করেননি এই বাঁহাতি পেসার। আগামী আইপিএল আসরকে সামনে রেখে মিনি নিলামে অংশ নিতে</description>
      <source url="https://odhikar.news/2026/11/25/%e0%a6%8f%e0%a6%ac%e0%a6%be%e0%a6%b0-%e0%a6%86%e0%a6%87%e0%a6%aa%e0%a6%bf%e0%a6%8f%e0%a6%b2%e0%a6%95%e0%a7%87-%e0%a6%ac%e0%a7%9f%e0%a6%95%e0%a6%9f-%e0%a6%95%e0%a6%b0%e0%a6%b2%e0%a7%87%e0%a6%a8/">দৈনিক অধিকার</source>
    </item>
    <item>
      <title>ফরিদপুরে বাসের ধাক্কায় প্রাণ গেল কলেজছাত্রের</title>
      <link>https://odhikar.news/2026/11/25/%e0%a6%ab%e0%a6%b0%e0%a6%bf%e0%a6%a6%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87-%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a7%87%e0%a6%b0-%e0%a6%a7%e0%a6%be%e0%a6%95%e0%a7%8d%e0%a6%95%e0%a6%be%e0%a6%af%e0%a6%bc/</link>

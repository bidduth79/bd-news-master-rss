    <item>
      <title>সাতটি শহরে চালু হচ্ছে বিসিবির ক্রিকেট একাডেমি</title>
      <link>https://odhikar.news/2026/11/23/%e0%a6%b8%e0%a6%be%e0%a6%a4%e0%a6%9f%e0%a6%bf-%e0%a6%b6%e0%a6%b9%e0%a6%b0%e0%a7%87-%e0%a6%9a%e0%a6%be%e0%a6%b2%e0%a7%81-%e0%a6%b9%e0%a6%9a%e0%a7%8d%e0%a6%9b%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%b8/</link>
      <guid isPermaLink="true">https://odhikar.news/2026/11/23/%e0%a6%b8%e0%a6%be%e0%a6%a4%e0%a6%9f%e0%a6%bf-%e0%a6%b6%e0%a6%b9%e0%a6%b0%e0%a7%87-%e0%a6%9a%e0%a6%be%e0%a6%b2%e0%a7%81-%e0%a6%b9%e0%a6%9a%e0%a7%8d%e0%a6%9b%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%b8/</guid>
      <pubDate>Mon, 23 Nov 2026 08:43:44 +0000</pubDate>
      <description>দেশের ক্রিকেটের তৃণমূল পর্যায়কে আরও শক্তিশালী করতে বাংলাদেশ ক্রিকেট বোর্ড (বিসিবি) নতুন পরিকল্পনা হাতে নিয়েছে। এর অংশ হিসেবে প্রথম পর্যায়ে দেশের ছয় থেকে সাতটি শহরে একযোগে ক্রিকেট একাডেমি চালু করতে যাচ্ছে বোর্ড। প্রতিটি একাডেমিতে ৫০ থেকে ৬০ জন প্রতিভাবান তরুণ ক্রিকেটারকে সম্পূর্ণ বিনা মূল্যে প্রশ</description>
      <source url="https://odhikar.news/2026/11/23/%e0%a6%b8%e0%a6%be%e0%a6%a4%e0%a6%9f%e0%a6%bf-%e0%a6%b6%e0%a6%b9%e0%a6%b0%e0%a7%87-%e0%a6%9a%e0%a6%be%e0%a6%b2%e0%a7%81-%e0%a6%b9%e0%a6%9a%e0%a7%8d%e0%a6%9b%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%b8/">দৈনিক অধিকার</source>
    </item>

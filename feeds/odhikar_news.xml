    </item>
    <item>
      <title>সিও সংস্থার উদ্যোগে ঝিনাইদহে তিন দিনব্যাপী পিঠা ও উদ্যোক্তা মেলা</title>
      <link>https://odhikar.news/2026/11/14/%e0%a6%b8%e0%a6%bf%e0%a6%93-%e0%a6%b8%e0%a6%82%e0%a6%b8%e0%a7%8d%e0%a6%a5%e0%a6%be%e0%a6%b0-%e0%a6%89%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a7%8b%e0%a6%97%e0%a7%87-%e0%a6%9d%e0%a6%bf%e0%a6%a8%e0%a6%be/</link>

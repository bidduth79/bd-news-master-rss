    <item>
      <title>ঘূর্ণিঝড়ের শঙ্কা, ৪ সমুদ্রবন্দরে সতর্কতা জারি</title>
      <link>https://odhikar.news/2026/11/16/%e0%a6%98%e0%a7%82%e0%a6%b0%e0%a7%8d%e0%a6%a3%e0%a6%bf%e0%a6%9d%e0%a7%9c%e0%a7%87%e0%a6%b0-%e0%a6%b6%e0%a6%99%e0%a7%8d%e0%a6%95%e0%a6%be-%e0%a7%aa-%e0%a6%b8%e0%a6%ae%e0%a7%81%e0%a6%a6%e0%a7%8d/</link>

    <item>
      <title>দুর্গাপুরে জনদুর্ভোগ লাঘবে কাঠের সেতু করে দিলেন ডেপুটি স্পিকার</title>
      <link>https://odhikar.news/2026/11/15/%e0%a6%a6%e0%a7%81%e0%a6%b0%e0%a7%8d%e0%a6%97%e0%a6%be%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87-%e0%a6%9c%e0%a6%a8%e0%a6%a6%e0%a7%81%e0%a6%b0%e0%a7%8d%e0%a6%ad%e0%a7%8b%e0%a6%97-%e0%a6%b2%e0%a6%be%e0%a6%98/</link>
      <guid isPermaLink="true">https://odhikar.news/2026/11/15/%e0%a6%a6%e0%a7%81%e0%a6%b0%e0%a7%8d%e0%a6%97%e0%a6%be%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87-%e0%a6%9c%e0%a6%a8%e0%a6%a6%e0%a7%81%e0%a6%b0%e0%a7%8d%e0%a6%ad%e0%a7%8b%e0%a6%97-%e0%a6%b2%e0%a6%be%e0%a6%98/</guid>
      <pubDate>Sun, 15 Nov 2026 12:18:14 +0000</pubDate>
      <description>নেত্রকোনার দুর্গাপুরে জনদুর্ভোগ লাঘবে নিজ অর্থায়নে সোমেশ্বরী নদীর ওপর প্রায় ৬০০ মিটার লম্বা কাঠের সেতু নির্মাণ করে দিয়েছেন জাতীয় সংসদের ডেপুটি স্পিকার ব্যারিস্টার কায়সার কামাল এমপি। রবিবার (১৫ নভেম্বর) দুপুরে বিভিন্ন শিক্ষাপ্রতিষ্ঠানের শিক্ষার্থীদের দিয়ে আনুষ্ঠানিকভাবে এই সেতুর উদ্বোধন করা হয়। ​স্থা</description>
      <source url="https://odhikar.news/2026/11/15/%e0%a6%a6%e0%a7%81%e0%a6%b0%e0%a7%8d%e0%a6%97%e0%a6%be%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87-%e0%a6%9c%e0%a6%a8%e0%a6%a6%e0%a7%81%e0%a6%b0%e0%a7%8d%e0%a6%ad%e0%a7%8b%e0%a6%97-%e0%a6%b2%e0%a6%be%e0%a6%98/">দৈনিক অধিকার</source>
    </item>
    <item>
      <title>সোনারগাঁও ইউনিভার্সিটিতে জাতীয় বিপ্লব ও সংহতি দিবস উদযাপন</title>
      <link>https://odhikar.news/2026/11/15/%e0%a6%b8%e0%a7%8b%e0%a6%a8%e0%a6%be%e0%a6%b0%e0%a6%97%e0%a6%be%e0%a6%81%e0%a6%93-%e0%a6%87%e0%a6%89%e0%a6%a8%e0%a6%bf%e0%a6%ad%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%b8%e0%a6%bf%e0%a6%9f%e0%a6%bf-27/</link>
      <guid isPermaLink="true">https://odhikar.news/2026/11/15/%e0%a6%b8%e0%a7%8b%e0%a6%a8%e0%a6%be%e0%a6%b0%e0%a6%97%e0%a6%be%e0%a6%81%e0%a6%93-%e0%a6%87%e0%a6%89%e0%a6%a8%e0%a6%bf%e0%a6%ad%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%b8%e0%a6%bf%e0%a6%9f%e0%a6%bf-27/</guid>
      <pubDate>Sun, 15 Nov 2026 11:59:09 +0000</pubDate>
      <description>১৯৭৫ সালের ৭ নভেম্বর বাংলাদেশের রাজনৈতিক ইতিহাসে একটি গুরুত্বপূর্ণ ও ঘটনাবহুল দিন। ওই দিন সংঘটিত সিপাহি-জনতার অভ্যুত্থানকে স্মরণ করে জাতীয় বিপ্লব ও সংহতি দিবস পালন করা হয়। দিবসটি দেশের রাজনৈতিক ইতিহাস, জাতীয় ঐক্য ও সংহতির আলোচনায় বিশেষ গুরুত্ব বহন করে। এরই ধারাবাহিকতায় ১৫ নভেম্বর ২০২৬ (রবিবার) সোনার</description>
      <source url="https://odhikar.news/2026/11/15/%e0%a6%b8%e0%a7%8b%e0%a6%a8%e0%a6%be%e0%a6%b0%e0%a6%97%e0%a6%be%e0%a6%81%e0%a6%93-%e0%a6%87%e0%a6%89%e0%a6%a8%e0%a6%bf%e0%a6%ad%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%b8%e0%a6%bf%e0%a6%9f%e0%a6%bf-27/">দৈনিক অধিকার</source>
    </item>
    <item>
      <title>পুলিশের ব্যারিকেড ভেঙে গোপালগঞ্জে আওয়ামী লীগের মিছিল</title>
      <link>https://odhikar.news/2026/11/15/%e0%a6%aa%e0%a7%81%e0%a6%b2%e0%a6%bf%e0%a6%b6%e0%a7%87%e0%a6%b0-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%b0%e0%a6%bf%e0%a6%95%e0%a7%87%e0%a6%a1-%e0%a6%ad%e0%a7%87%e0%a6%99%e0%a7%87-%e0%a6%97/</link>

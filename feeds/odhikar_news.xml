    <item>
      <title>নিষিদ্ধ সংগঠন ছাত্রলীগ নেতা রুহুল আমিন গ্রেপ্তার</title>
      <link>https://odhikar.news/2026/11/26/%e0%a6%a8%e0%a6%bf%e0%a6%b7%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%a7-%e0%a6%b8%e0%a6%82%e0%a6%97%e0%a6%a0%e0%a6%a8-%e0%a6%9b%e0%a6%be%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a6%b2%e0%a7%80%e0%a6%97-%e0%a6%a8/</link>

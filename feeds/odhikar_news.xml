    <item>
      <title>সাত শতাধিক শিক্ষার্থীর অংশগ্রহণে নোবিপ্রবিতে ছাত্রশক্তির নবীনবরণ</title>
      <link>https://odhikar.news/2026/11/08/%e0%a6%b8%e0%a6%be%e0%a6%a4-%e0%a6%b6%e0%a6%a4%e0%a6%be%e0%a6%a7%e0%a6%bf%e0%a6%95-%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%a5%e0%a7%80%e0%a6%b0-%e0%a6%85/</link>

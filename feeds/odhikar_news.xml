    <item>
      <title>কর্ণফুলী টানেল সংযোগ সড়ক নির্মাণে ব্যয় বাড়ল প্রায় ৫৭ কোটি টাকা</title>
      <link>https://odhikar.news/2026/11/12/%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%a3%e0%a6%ab%e0%a7%81%e0%a6%b2%e0%a7%80-%e0%a6%9f%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b2-%e0%a6%b8%e0%a6%82%e0%a6%af%e0%a7%8b%e0%a6%97-%e0%a6%b8%e0%a7%9c%e0%a6%95/</link>
      <guid isPermaLink="true">https://odhikar.news/2026/11/12/%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%a3%e0%a6%ab%e0%a7%81%e0%a6%b2%e0%a7%80-%e0%a6%9f%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b2-%e0%a6%b8%e0%a6%82%e0%a6%af%e0%a7%8b%e0%a6%97-%e0%a6%b8%e0%a7%9c%e0%a6%95/</guid>
      <pubDate>Thu, 12 Nov 2026 09:29:26 +0000</pubDate>
      <description>কর্ণফুলী টানেল সংযোগ সড়ক উন্নয়ন এবং আনোয়ারা উপজেলা সংযোগ সড়ক চার লেনে উন্নীতকরণ প্রকল্পে ব্যয় বাড়ছে প্রায় ৫৭ কোটি টাকা। প্রকল্পের একটি প্যাকেজে অতিরিক্ত ৫৬ কোটি ৯০ লাখ টাকা ব্যয় বাড়ানোর প্রস্তাব অনুমোদন দিয়েছে সরকারি ক্রয়সংক্রান্ত মন্ত্রিসভা কমিটি। এতে সংশোধিত চুক্তিমূল্য দাঁড়িয়েছে ৩২৩ কোটি চার লাখ </description>
      <source url="https://odhikar.news/2026/11/12/%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%a3%e0%a6%ab%e0%a7%81%e0%a6%b2%e0%a7%80-%e0%a6%9f%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b2-%e0%a6%b8%e0%a6%82%e0%a6%af%e0%a7%8b%e0%a6%97-%e0%a6%b8%e0%a7%9c%e0%a6%95/">দৈনিক অধিকার</source>
    </item>
    <item>
      <title>এক কোটি মানুষ বিশুদ্ধ পানি পান করেন না : পানিসম্পদ প্রতিমন্ত্রী</title>
      <link>https://odhikar.news/2026/11/12/%e0%a6%8f%e0%a6%95-%e0%a6%95%e0%a7%8b%e0%a6%9f%e0%a6%bf-%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a7%81%e0%a6%b7-%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%81%e0%a6%a6%e0%a7%8d%e0%a6%a7-%e0%a6%aa%e0%a6%be%e0%a6%a8/</link>
      <guid isPermaLink="true">https://odhikar.news/2026/11/12/%e0%a6%8f%e0%a6%95-%e0%a6%95%e0%a7%8b%e0%a6%9f%e0%a6%bf-%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a7%81%e0%a6%b7-%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%81%e0%a6%a6%e0%a7%8d%e0%a6%a7-%e0%a6%aa%e0%a6%be%e0%a6%a8/</guid>
      <pubDate>Thu, 12 Nov 2026 09:10:39 +0000</pubDate>
      <description>পানিসম্পদ প্রতিমন্ত্রী ফরহাদ হোসেন আজাদ বলেছেন, রাজধানী ঢাকায় প্রায় তিন কোটি মানুষ বসবাস করে। এর মধ্যে এক কোটিরও বেশি মানুষ প্রতিদিন বিশুদ্ধ পানি পান করতে পারেন না। এর ফলে মানুষের শরীরে বিভিন্ন রোগ ছড়িয়ে পড়ছে। তিনি সতর্ক করে বলেছেন, এই অবস্থা চলতে থাকলে দেশে হাসপাতালের সংখ্যা এবং রোগীর সংখ্যা উ</description>
      <source url="https://odhikar.news/2026/11/12/%e0%a6%8f%e0%a6%95-%e0%a6%95%e0%a7%8b%e0%a6%9f%e0%a6%bf-%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a7%81%e0%a6%b7-%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%81%e0%a6%a6%e0%a7%8d%e0%a6%a7-%e0%a6%aa%e0%a6%be%e0%a6%a8/">দৈনিক অধিকার</source>
    </item>
    <item>
      <title>ভূমিকম্পে কাঁপল ইসরায়েল, বন্ধ বিমানবন্দর</title>
      <link>https://odhikar.news/2026/11/12/%e0%a6%ad%e0%a7%82%e0%a6%ae%e0%a6%bf%e0%a6%95%e0%a6%ae%e0%a7%8d%e0%a6%aa%e0%a7%87-%e0%a6%95%e0%a6%be%e0%a6%81%e0%a6%aa%e0%a6%b2-%e0%a6%87%e0%a6%b8%e0%a6%b0%e0%a6%be%e0%a7%9f%e0%a7%87%e0%a6%b2/</link>
      <guid isPermaLink="true">https://odhikar.news/2026/11/12/%e0%a6%ad%e0%a7%82%e0%a6%ae%e0%a6%bf%e0%a6%95%e0%a6%ae%e0%a7%8d%e0%a6%aa%e0%a7%87-%e0%a6%95%e0%a6%be%e0%a6%81%e0%a6%aa%e0%a6%b2-%e0%a6%87%e0%a6%b8%e0%a6%b0%e0%a6%be%e0%a7%9f%e0%a7%87%e0%a6%b2/</guid>
      <pubDate>Thu, 12 Nov 2026 08:23:52 +0000</pubDate>
      <description>ইসরায়েলের দক্ষিণাঞ্চলীয় ইলাত অঞ্চলে ৪ দশমিক ৫ মাত্রার মাঝারি ভূমিকম্প আঘাত হেনেছে। ভূমিকম্পের পর দেশটির রামোন বিমানবন্দর সাময়িকভাবে বন্ধ করে দেওয়া হয়েছে। দেশটির ভূতাত্ত্বিক জরিপ সংস্থার তথ্যের বরাত দিয়ে সংবাদমাধ্যম টাইমস অব ইসরায়েল জানিয়েছে, স্থানীয় সময় বুধবার সকালে এ ভূমিকম্প আঘাত হানে। রিখটার স্কে</description>
      <source url="https://odhikar.news/2026/11/12/%e0%a6%ad%e0%a7%82%e0%a6%ae%e0%a6%bf%e0%a6%95%e0%a6%ae%e0%a7%8d%e0%a6%aa%e0%a7%87-%e0%a6%95%e0%a6%be%e0%a6%81%e0%a6%aa%e0%a6%b2-%e0%a6%87%e0%a6%b8%e0%a6%b0%e0%a6%be%e0%a7%9f%e0%a7%87%e0%a6%b2/">দৈনিক অধিকার</source>
    </item>
    <item>
      <title>ত্রিশালে আন্তর্জাতিক বিমানবন্দর ও আধুনিক পর্যটন নগরী গড়ার ঘোষণা বিমান মন্ত্রীর</title>
      <link>https://odhikar.news/2026/11/12/%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a6%bf%e0%a6%b6%e0%a6%be%e0%a6%b2%e0%a7%87-%e0%a6%86%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a6%b0%e0%a7%8d%e0%a6%9c%e0%a6%be%e0%a6%a4%e0%a6%bf%e0%a6%95-%e0%a6%ac%e0%a6%bf%e0%a6%ae/</link>
      <guid isPermaLink="true">https://odhikar.news/2026/11/12/%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a6%bf%e0%a6%b6%e0%a6%be%e0%a6%b2%e0%a7%87-%e0%a6%86%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a6%b0%e0%a7%8d%e0%a6%9c%e0%a6%be%e0%a6%a4%e0%a6%bf%e0%a6%95-%e0%a6%ac%e0%a6%bf%e0%a6%ae/</guid>
      <pubDate>Thu, 12 Nov 2026 07:35:32 +0000</pubDate>
      <description>ময়মনসিংহের ত্রিশালে একটি আন্তর্জাতিক বিমানবন্দর নির্মাণ এবং উপজেলাটিকে আধুনিক পর্যটন নগরী হিসেবে গড়ে তোলার ঘোষণা দিয়েছেন বেসামরিক বিমান পরিবহন ও পর্যটনমন্ত্রী এম রশিদুজ্জমান মিল্লাত। তিনি উল্লেখ করেন, সরকার ইতোমধ্যেই ত্রিশালকে ‘নজরুল সিটি’ হিসেবে ঘোষণা করেছে। ​বৃহস্পতিবার (১২ নভেম্বর) সকালে ত্রিশাল </description>
      <source url="https://odhikar.news/2026/11/12/%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a6%bf%e0%a6%b6%e0%a6%be%e0%a6%b2%e0%a7%87-%e0%a6%86%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a6%b0%e0%a7%8d%e0%a6%9c%e0%a6%be%e0%a6%a4%e0%a6%bf%e0%a6%95-%e0%a6%ac%e0%a6%bf%e0%a6%ae/">দৈনিক অধিকার</source>
    </item>
    <item>
      <title>মুক্তিযোদ্ধা সিদ্দিক মাস্টারের ৫৪তম শাহাদাতবার্ষিকী আজ</title>
      <link>https://odhikar.news/2026/11/12/%e0%a6%ae%e0%a7%81%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%bf%e0%a6%af%e0%a7%8b%e0%a6%a6%e0%a7%8d%e0%a6%a7%e0%a6%be-%e0%a6%b8%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%a6%e0%a6%bf%e0%a6%95-%e0%a6%ae%e0%a6%be%e0%a6%b8/</link>
      <guid isPermaLink="true">https://odhikar.news/2026/11/12/%e0%a6%ae%e0%a7%81%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%bf%e0%a6%af%e0%a7%8b%e0%a6%a6%e0%a7%8d%e0%a6%a7%e0%a6%be-%e0%a6%b8%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%a6%e0%a6%bf%e0%a6%95-%e0%a6%ae%e0%a6%be%e0%a6%b8/</guid>
      <pubDate>Thu, 12 Nov 2026 07:31:07 +0000</pubDate>
      <description>মুক্তিযোদ্ধা সিদ্দিক মাস্টারের ৫৪তম শাহাদাতবার্ষিকী আজ ১২ নভেম্বর। ১৯৭২ সালের এই দিনে কর্মস্থলে আততায়ীর গুলিতে নিহত হন তিনি। অকুতোভয় মুক্তিযোদ্ধা সিদ্দিকুর রহমান খান (অলি) ঢাকার অদূরে নবাবগঞ্জ বহুমুখী উচ্চবিদ্যালয়ের ইংরেজি শিক্ষক ছিলেন। ছাত্রলীগের একনিষ্ঠ কর্মী সিদ্দিক মাস্টার ১৯৬৬ সালের ছয় দফা আন্দ</description>
      <source url="https://odhikar.news/2026/11/12/%e0%a6%ae%e0%a7%81%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%bf%e0%a6%af%e0%a7%8b%e0%a6%a6%e0%a7%8d%e0%a6%a7%e0%a6%be-%e0%a6%b8%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%a6%e0%a6%bf%e0%a6%95-%e0%a6%ae%e0%a6%be%e0%a6%b8/">দৈনিক অধিকার</source>
    </item>
    <item>
      <title>বিলাস বিউটি পার্লারের ২৭ বছর পূর্তি উদযাপন</title>
      <link>https://odhikar.news/2026/11/12/%e0%a6%ac%e0%a6%bf%e0%a6%b2%e0%a6%be%e0%a6%b8-%e0%a6%ac%e0%a6%bf%e0%a6%89%e0%a6%9f%e0%a6%bf-%e0%a6%aa%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%b2%e0%a6%be%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a7%a8%e0%a7%ad/</link>
      <guid isPermaLink="true">https://odhikar.news/2026/11/12/%e0%a6%ac%e0%a6%bf%e0%a6%b2%e0%a6%be%e0%a6%b8-%e0%a6%ac%e0%a6%bf%e0%a6%89%e0%a6%9f%e0%a6%bf-%e0%a6%aa%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%b2%e0%a6%be%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a7%a8%e0%a7%ad/</guid>
      <pubDate>Thu, 12 Nov 2026 06:23:38 +0000</pubDate>
      <description>ঐতিহ্য, আস্থা আর সৌন্দর্যের ২৭ বছর পেরিয়ে বিলাস বিউটি পার্লার তার ২৭তম প্রতিষ্ঠাবার্ষিকী উদযাপন করেছে। দীর্ঘ এই পথচলায় অসংখ্য নারীর আস্থার ঠিকানা হয়ে উঠেছে প্রতিষ্ঠানটি। আনন্দঘন অনুষ্ঠানে উপস্থিত ছিলেন নাতাশা মেকআপ আর্টিস্ট অ্যান্ড দ্য ইলান ক্যুচারের ওনার নাতাশা আক্তার নেহা, ইতি অ্যাঞ্জেলস মেকওভা</description>
      <source url="https://odhikar.news/2026/11/12/%e0%a6%ac%e0%a6%bf%e0%a6%b2%e0%a6%be%e0%a6%b8-%e0%a6%ac%e0%a6%bf%e0%a6%89%e0%a6%9f%e0%a6%bf-%e0%a6%aa%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%b2%e0%a6%be%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a7%a8%e0%a7%ad/">দৈনিক অধিকার</source>
    </item>
    <item>
      <title>১৫ শিক্ষার্থীর চুল কেটে দেওয়ার ঘটনায় প্রধান শিক্ষককে অন্য বিদ্যালয়ে সংযুক্ত</title>

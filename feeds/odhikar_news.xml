    <item>
      <title>জমি বিক্রির টাকা না পেয়ে মাকে হত্যার অভিযোগে তিন মাস পরে কবর থেকে বৃদ্ধার লাশ উত্তোলন</title>
      <link>https://odhikar.news/2026/11/10/%e0%a6%9c%e0%a6%ae%e0%a6%bf-%e0%a6%ac%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b0%e0%a6%bf%e0%a6%b0-%e0%a6%9f%e0%a6%be%e0%a6%95%e0%a6%be-%e0%a6%a8%e0%a6%be-%e0%a6%aa%e0%a7%87%e0%a7%9f%e0%a7%87-%e0%a6%ae/</link>
      <guid isPermaLink="true">https://odhikar.news/2026/11/10/%e0%a6%9c%e0%a6%ae%e0%a6%bf-%e0%a6%ac%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b0%e0%a6%bf%e0%a6%b0-%e0%a6%9f%e0%a6%be%e0%a6%95%e0%a6%be-%e0%a6%a8%e0%a6%be-%e0%a6%aa%e0%a7%87%e0%a7%9f%e0%a7%87-%e0%a6%ae/</guid>
      <pubDate>Tue, 10 Nov 2026 05:01:10 +0000</pubDate>
      <description>জমি বিক্রি করে টাকা দিতে রাজি না হওয়ায় মাকে নির্যাতন করে হত্যার অভিযোগ উঠেছে এক ছেলের বিরুদ্ধে। মৃত্যুর পর দ্রুত দাফন করা হয়েছিল সুফিয়া বেগমকে (৬২)। তবে দাফনের আগেই মরদেহের শরীরে আঘাত ও কালশিটে দাগ দেখে সন্দেহ হয় স্বজনদের। চলতি বছরের ২৩ আগস্ট এ ঘটনায় ফরিদপুরের সিনিয়র জুডিসিয়াল ম্যাজিস্ট্রেট ৬ নম্বর </description>
      <source url="https://odhikar.news/2026/11/10/%e0%a6%9c%e0%a6%ae%e0%a6%bf-%e0%a6%ac%e0%a6%bf%e0%a6%95%e0%a7%8d%e0%a6%b0%e0%a6%bf%e0%a6%b0-%e0%a6%9f%e0%a6%be%e0%a6%95%e0%a6%be-%e0%a6%a8%e0%a6%be-%e0%a6%aa%e0%a7%87%e0%a7%9f%e0%a7%87-%e0%a6%ae/">দৈনিক অধিকার</source>
    </item>
    <item>
      <title>শেখ হাসিনার বিরুদ্ধে ৬৭৩ মামলা, একটিতে মৃত্যুদণ্ড</title>
      <link>https://odhikar.news/2026/11/10/%e0%a6%b6%e0%a7%87%e0%a6%96-%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%a8%e0%a6%be%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%b0%e0%a7%81%e0%a6%a6%e0%a7%8d%e0%a6%a7%e0%a7%87-%e0%a7%ac%e0%a7%ad%e0%a7%a9/</link>
      <guid isPermaLink="true">https://odhikar.news/2026/11/10/%e0%a6%b6%e0%a7%87%e0%a6%96-%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%a8%e0%a6%be%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%b0%e0%a7%81%e0%a6%a6%e0%a7%8d%e0%a6%a7%e0%a7%87-%e0%a7%ac%e0%a7%ad%e0%a7%a9/</guid>
      <pubDate>Tue, 10 Nov 2026 04:40:32 +0000</pubDate>
      <description>জুলাই গণ-অভ্যুত্থানে ক্ষমতাচ্যুত সাবেক প্রধানমন্ত্রী শেখ হাসিনার বিরুদ্ধে সারা দেশে ৬৭৩টি মামলা রয়েছে, যার মধ্যে ৪৫৭টি হলো হত্যা মামলা। পুলিশ সদর দপ্তরের হিসাব অনুযায়ী, এসব মামলার মধ্যে জুলাই গণ-অভ্যুত্থানে সংঘটিত মানবতাবিরোধী অপরাধের একটি মামলায় আন্তর্জাতিক অপরাধ ট্রাইব্যুনাল তাকে মৃত্যুদণ্ড দিয</description>
      <source url="https://odhikar.news/2026/11/10/%e0%a6%b6%e0%a7%87%e0%a6%96-%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%a8%e0%a6%be%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%b0%e0%a7%81%e0%a6%a6%e0%a7%8d%e0%a6%a7%e0%a7%87-%e0%a7%ac%e0%a7%ad%e0%a7%a9/">দৈনিক অধিকার</source>
    </item>
    <item>
      <title>এনসিপি থেকে পদত্যাগ করে সারজিস আলমকে ‘ভণ্ড’ বললেন ফজলুল করিম</title>
      <link>https://odhikar.news/2026/11/10/%e0%a6%8f%e0%a6%a8%e0%a6%b8%e0%a6%bf%e0%a6%aa%e0%a6%bf-%e0%a6%a5%e0%a7%87%e0%a6%95%e0%a7%87-%e0%a6%aa%e0%a6%a6%e0%a6%a4%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%97-%e0%a6%95%e0%a6%b0%e0%a7%87-%e0%a6%b8/</link>

    <item>
      <title>প্রথম দিনেই শেখ হাসিনাসহ ৩৪ জনের বিরুদ্ধে সাক্ষ্য গ্রহণ হয়নি</title>
      <link>https://odhikar.news/2026/11/25/%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a5%e0%a6%ae-%e0%a6%a6%e0%a6%bf%e0%a6%a8%e0%a7%87%e0%a6%87-%e0%a6%b6%e0%a7%87%e0%a6%96-%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%a8%e0%a6%be%e0%a6%b8%e0%a6%b9/</link>

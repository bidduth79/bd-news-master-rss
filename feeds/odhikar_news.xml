    <item>
      <title>কলেজ গেটে তালা দিয়ে ধর্মঘটের চেষ্টা, নিষিদ্ধ ছাত্রলীগ নেতা আরিফ আটক</title>
      <link>https://odhikar.news/2026/11/10/%e0%a6%95%e0%a6%b2%e0%a7%87%e0%a6%9c-%e0%a6%97%e0%a7%87%e0%a6%9f%e0%a7%87-%e0%a6%a4%e0%a6%be%e0%a6%b2%e0%a6%be-%e0%a6%a6%e0%a6%bf%e0%a7%9f%e0%a7%87-%e0%a6%a7%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a6%98/</link>

    <item>
      <title>দুর্গাপুরে জনদুর্ভোগ লাঘবে কাঠের সেতু করে দিলেন ডেপুটি স্পিকার</title>
      <link>https://odhikar.news/2026/11/15/%e0%a6%a6%e0%a7%81%e0%a6%b0%e0%a7%8d%e0%a6%97%e0%a6%be%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87-%e0%a6%9c%e0%a6%a8%e0%a6%a6%e0%a7%81%e0%a6%b0%e0%a7%8d%e0%a6%ad%e0%a7%8b%e0%a6%97-%e0%a6%b2%e0%a6%be%e0%a6%98/</link>

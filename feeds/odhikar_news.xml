    <item>
      <title>ভাওয়াল ইউনিয়নবাসীর সেবা করতে চান লিটন মাতুব্বর</title>
      <link>https://odhikar.news/2026/11/14/%e0%a6%ad%e0%a6%be%e0%a6%93%e0%a7%9f%e0%a6%be%e0%a6%b2-%e0%a6%87%e0%a6%89%e0%a6%a8%e0%a6%bf%e0%a7%9f%e0%a6%a8%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a7%80%e0%a6%b0-%e0%a6%b8%e0%a7%87%e0%a6%ac%e0%a6%be/</link>

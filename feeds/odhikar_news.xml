    <item>
      <title>সাভার-আশুলিয়ায় ৪০ পোশাক কারখানা অনির্দিষ্টকালের জন্য বন্ধ</title>
      <link>https://odhikar.news/2026/11/15/%e0%a6%b8%e0%a6%be%e0%a6%ad%e0%a6%be%e0%a6%b0-%e0%a6%86%e0%a6%b6%e0%a7%81%e0%a6%b2%e0%a6%bf%e0%a7%9f%e0%a6%be%e0%a7%9f-%e0%a7%aa%e0%a7%a6-%e0%a6%aa%e0%a7%8b%e0%a6%b6%e0%a6%be%e0%a6%95-%e0%a6%95/</link>

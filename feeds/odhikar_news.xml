    <item>
      <title>গ্রামীণ ব্যাংকে অগ্নিসংযোগ বন্ধ ও অপরাধীদের শাস্তির আহ্বান ড. ইউনূসের</title>
      <link>https://odhikar.news/2026/11/23/%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ae%e0%a7%80%e0%a6%a3-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95%e0%a7%87-%e0%a6%85%e0%a6%97%e0%a7%8d%e0%a6%a8%e0%a6%bf%e0%a6%b8%e0%a6%82%e0%a6%af/</link>

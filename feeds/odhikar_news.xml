    <item>
      <title>গুরুদাসপুরে গভীর রাতে বিএনপি কার্যালয়ে ককটেল বিস্ফোরণ, তদন্তে পুলিশ</title>
      <link>https://odhikar.news/2026/11/18/%e0%a6%97%e0%a7%81%e0%a6%b0%e0%a7%81%e0%a6%a6%e0%a6%be%e0%a6%b8%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87-%e0%a6%97%e0%a6%ad%e0%a7%80%e0%a6%b0-%e0%a6%b0%e0%a6%be%e0%a6%a4%e0%a7%87-%e0%a6%ac%e0%a6%bf/</link>

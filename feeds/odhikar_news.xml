    <item>
      <title>ঝিনাইদহের শৈলকুপায় দুই পক্ষের সংঘর্ষে ২০ বাড়িঘর ভাঙচুর, আহত ১০</title>
      <link>https://odhikar.news/2026/11/23/%e0%a6%9d%e0%a6%bf%e0%a6%a8%e0%a6%be%e0%a6%87%e0%a6%a6%e0%a6%b9%e0%a7%87%e0%a6%b0-%e0%a6%b6%e0%a7%88%e0%a6%b2%e0%a6%95%e0%a7%81%e0%a6%aa%e0%a6%be%e0%a7%9f-%e0%a6%a6%e0%a7%81%e0%a6%87-%e0%a6%aa/</link>
      <guid isPermaLink="true">https://odhikar.news/2026/11/23/%e0%a6%9d%e0%a6%bf%e0%a6%a8%e0%a6%be%e0%a6%87%e0%a6%a6%e0%a6%b9%e0%a7%87%e0%a6%b0-%e0%a6%b6%e0%a7%88%e0%a6%b2%e0%a6%95%e0%a7%81%e0%a6%aa%e0%a6%be%e0%a7%9f-%e0%a6%a6%e0%a7%81%e0%a6%87-%e0%a6%aa/</guid>
      <pubDate>Mon, 23 Nov 2026 14:49:15 +0000</pubDate>
      <description>ঝিনাইদহের শৈলকুপায় সামাজিক আধিপত্য বিস্তারকে কেন্দ্র করে দুই পক্ষের সংঘর্ষে অন্তত ১০ জন আহত হয়েছেন। এ সময় অন্তত ২০টি বাড়িঘর ভাঙচুর করা হয়েছে। সোমবার (২৩ নভেম্বর) বিকেলে উপজেলার হাকিমপুর ইউনিয়নের দোহারো গ্রামে এ ঘটনা ঘটে। পুলিশ ও স্থানীয় সূত্রে জানা যায়, শৈলকুপা উপজেলার দোহারো গ্রামে আধিপত্য বিস্তার </description>
      <source url="https://odhikar.news/2026/11/23/%e0%a6%9d%e0%a6%bf%e0%a6%a8%e0%a6%be%e0%a6%87%e0%a6%a6%e0%a6%b9%e0%a7%87%e0%a6%b0-%e0%a6%b6%e0%a7%88%e0%a6%b2%e0%a6%95%e0%a7%81%e0%a6%aa%e0%a6%be%e0%a7%9f-%e0%a6%a6%e0%a7%81%e0%a6%87-%e0%a6%aa/">দৈনিক অধিকার</source>
    </item>

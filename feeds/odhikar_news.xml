    <item>
      <title>বকশীগঞ্জে বাঁশঝাড়ের পাশে গর্ত থেকে ১০৮৫ বোতল ভারতীয় মদ উদ্ধার</title>
      <link>https://odhikar.news/2026/11/18/%e0%a6%ac%e0%a6%95%e0%a6%b6%e0%a7%80%e0%a6%97%e0%a6%9e%e0%a7%8d%e0%a6%9c%e0%a7%87-%e0%a6%ac%e0%a6%be%e0%a6%81%e0%a6%b6%e0%a6%9d%e0%a6%be%e0%a7%9c%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a6%be%e0%a6%b6%e0%a7%87/</link>

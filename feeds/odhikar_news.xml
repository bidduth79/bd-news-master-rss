    <item>
      <title>মালিবাগে ককটেল বিস্ফোরণে ১৭ বছরের কিশোর আহত</title>
      <link>https://odhikar.news/2026/11/10/%e0%a6%ae%e0%a6%be%e0%a6%b2%e0%a6%bf%e0%a6%ac%e0%a6%be%e0%a6%97%e0%a7%87-%e0%a6%95%e0%a6%95%e0%a6%9f%e0%a7%87%e0%a6%b2-%e0%a6%ac%e0%a6%bf%e0%a6%b8%e0%a7%8d%e0%a6%ab%e0%a7%8b%e0%a6%b0%e0%a6%a3%e0%a7%87/</link>

    <item>
      <title>তিন লাখ মেধাবী ছাত্রীকে সাইকেল দেবে সরকার, নিজেই চালিয়ে দেখলেন প্রধানমন্ত্রী</title>
      <link>https://odhikar.news/2026/11/25/%e0%a6%a4%e0%a6%bf%e0%a6%a8-%e0%a6%b2%e0%a6%be%e0%a6%96-%e0%a6%ae%e0%a7%87%e0%a6%a7%e0%a6%be%e0%a6%ac%e0%a7%80-%e0%a6%9b%e0%a6%be%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a7%80%e0%a6%95%e0%a7%87-%e0%a6%b8/</link>

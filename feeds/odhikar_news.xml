    <item>
      <title>ফরিদপুরে সন্ত্রাসবিরোধী আইনে আ.লীগের সাধারণ সম্পাদক গ্রেপ্তার</title>
      <link>https://odhikar.news/2026/11/23/%e0%a6%ab%e0%a6%b0%e0%a6%bf%e0%a6%a6%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87-%e0%a6%b8%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%b8%e0%a6%ac%e0%a6%bf%e0%a6%b0%e0%a7%8b%e0%a6%a7%e0%a7%80/</link>

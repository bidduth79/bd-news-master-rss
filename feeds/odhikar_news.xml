    <item>
      <title>নওগাঁয় যুবলীগ নেতা শান্ত গ্রেপ্তার</title>
      <link>https://odhikar.news/2026/11/16/%e0%a6%a8%e0%a6%93%e0%a6%97%e0%a6%be%e0%a6%81%e0%a7%9f-%e0%a6%af%e0%a7%81%e0%a6%ac%e0%a6%b2%e0%a7%80%e0%a6%97-%e0%a6%a8%e0%a7%87%e0%a6%a4%e0%a6%be-%e0%a6%b6%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a4/</link>
      <guid isPermaLink="true">https://odhikar.news/2026/11/16/%e0%a6%a8%e0%a6%93%e0%a6%97%e0%a6%be%e0%a6%81%e0%a7%9f-%e0%a6%af%e0%a7%81%e0%a6%ac%e0%a6%b2%e0%a7%80%e0%a6%97-%e0%a6%a8%e0%a7%87%e0%a6%a4%e0%a6%be-%e0%a6%b6%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a4/</guid>
      <pubDate>Mon, 16 Nov 2026 05:03:39 +0000</pubDate>
      <description>নওগাঁয় অস্থিতিশীলতা সৃষ্টির অভিযোগে কার্যক্রম নিষিদ্ধ দলের মোশাররফ হোসেন শান্ত (৩৮) নামের এক নেতাকে গ্রেপ্তার করেছে থানা পুলিশ। শনিবার (১৪নভেম্বর) রাতে সদর উপজেলার তিলকপুর ইউনিয়ন এলাকায় অভিযান চালিয়ে তাকে গ্রেপ্তার করা হয়। রবিবার (১৫নভেম্বর) বিকেলে তাকে গ্রেপ্তারের বিষয়টি নিশ্চিত করেন পুলিশ সুপার মো</description>
      <source url="https://odhikar.news/2026/11/16/%e0%a6%a8%e0%a6%93%e0%a6%97%e0%a6%be%e0%a6%81%e0%a7%9f-%e0%a6%af%e0%a7%81%e0%a6%ac%e0%a6%b2%e0%a7%80%e0%a6%97-%e0%a6%a8%e0%a7%87%e0%a6%a4%e0%a6%be-%e0%a6%b6%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a4/">দৈনিক অধিকার</source>
    </item>
    <item>
      <title>টুঙ্গিপাড়ায় বিএনপি নেতাদের বাসভবন ও কার্যালয়ে ভাঙচুর-অগ্নিসংযোগ</title>
      <link>https://odhikar.news/2026/11/16/%e0%a6%9f%e0%a7%81%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a6%bf%e0%a6%aa%e0%a6%be%e0%a7%9c%e0%a6%be%e0%a7%9f-%e0%a6%ac%e0%a6%bf%e0%a6%8f%e0%a6%a8%e0%a6%aa%e0%a6%bf-%e0%a6%a8%e0%a7%87%e0%a6%a4%e0%a6%be%e0%a6%a6/</link>

    <item>
      <title>গাজীপুরের বিভিন্ন কারখানায় একযোগে হামলা-ভাঙচুরের চেষ্টা</title>
      <link>https://odhikar.news/2026/11/25/%e0%a6%97%e0%a6%be%e0%a6%9c%e0%a7%80%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%ad%e0%a6%bf%e0%a6%a8%e0%a7%8d%e0%a6%a8-%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%96%e0%a6%be%e0%a6%a8/</link>
      <guid isPermaLink="true">https://odhikar.news/2026/11/25/%e0%a6%97%e0%a6%be%e0%a6%9c%e0%a7%80%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%ad%e0%a6%bf%e0%a6%a8%e0%a7%8d%e0%a6%a8-%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%96%e0%a6%be%e0%a6%a8/</guid>
      <pubDate>Wed, 25 Nov 2026 11:05:38 +0000</pubDate>
      <description>গাজীপুরের শ্রীপুরে একাধিক পোশাক কারখানায় হামলা ও ভাঙচুরের চেষ্টা চালানোর অভিযোগ উঠেছে। এমনকি আগে থেকেই ছুটি ঘোষণা করা কারখানাগুলোও হামলার হাত থেকে রেহাই পায়নি। পুলিশের দাবি, শ্রমিকের ছদ্মবেশে বহিরাগত যুবকরা এসব হামলা ও বিশৃঙ্খলা সৃষ্টি করেছে। বুধবার (২৫ নভেম্বর) সকাল ৯টার দিকে শ্রীপুরের বিভিন্ন কারখ</description>
      <source url="https://odhikar.news/2026/11/25/%e0%a6%97%e0%a6%be%e0%a6%9c%e0%a7%80%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%ad%e0%a6%bf%e0%a6%a8%e0%a7%8d%e0%a6%a8-%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%96%e0%a6%be%e0%a6%a8/">দৈনিক অধিকার</source>
    </item>
    <item>
      <title>ঝিনাইদহে এসআরবির অভিযানে বিশ কেজি গাঁজাসহ মাদক কারবারি গ্রেফতার ​</title>

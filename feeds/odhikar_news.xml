    <item>
      <title>দেশি-বিদেশি পাখিদের কলকাকলীতে মুখরিত নওগাঁর জবইবিল</title>
      <link>https://odhikar.news/2026/11/23/%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a6%bf-%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a6%bf-%e0%a6%aa%e0%a6%be%e0%a6%96%e0%a6%bf%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a6%b2%e0%a6%95%e0%a6%be/</link>

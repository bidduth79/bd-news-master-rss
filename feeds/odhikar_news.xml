    <item>
      <title>সাভারে বাসে আগুন, বিদ্যালয়ের সামনে ব্যাগে বোমা</title>
      <link>https://odhikar.news/2026/11/10/%e0%a6%b8%e0%a6%be%e0%a6%ad%e0%a6%be%e0%a6%b0%e0%a7%87-%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a7%87-%e0%a6%86%e0%a6%97%e0%a7%81%e0%a6%a8-%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%b2/</link>

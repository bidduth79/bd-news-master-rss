    <item>
      <title>বেনাপোল-ঢাকা রুটের ‘রূপসী বাংলা এক্সপ্রেস’ বন্ধ ঘোষণা</title>
      <link>https://odhikar.news/2026/11/26/%e0%a6%ac%e0%a7%87%e0%a6%a8%e0%a6%be%e0%a6%aa%e0%a7%8b%e0%a6%b2-%e0%a6%a2%e0%a6%be%e0%a6%95%e0%a6%be-%e0%a6%b0%e0%a7%81%e0%a6%9f%e0%a7%87%e0%a6%b0-%e0%a6%b0%e0%a7%82%e0%a6%aa%e0%a6%b8/</link>

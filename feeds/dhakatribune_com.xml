      <enclosure url="https://ecdn.dhakatribune.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/c88f92d52ef29d21e924744fd185b96b-6afdc9d989191.jpeg?jadewits_media_id=77762" length="0" type="image/jpeg" />

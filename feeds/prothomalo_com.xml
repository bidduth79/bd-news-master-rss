      <link>https://www.prothomalo.com/technology/science/ol259iiyy4</link>
      <guid isPermaLink="true">https://www.prothomalo.com/technology/science/ol259iiyy4</guid>
      <pubDate>Fri, 20 Nov 2026 10:58:58 +0000</pubDate>
      <enclosure url="https://media.prothomalo.com/prothomalo-bangla/2026-09-04/626lc5l8/coma_cluster_jpg.webp" length="0" type="image/jpeg" />
      <media:content url="https://media.prothomalo.com/prothomalo-bangla/2026-09-04/626lc5l8/coma_cluster_jpg.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://media.prothomalo.com/prothomalo-bangla/2026-09-04/626lc5l8/coma_cluster_jpg.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডার্ক ম্যাটারের জন্য পর্যায় সারণি তৈরির প্রস্তাব দিলেন বিজ্ঞানীরা" /&gt;&lt;/p&gt;&lt;p&gt;ডার্ক ম্যাটারের জন্য আলাদা পর্যায় সারণি তৈরির প্রস্তাব দিয়েছেন ইউনিভার্সিটি অব ক্যালিফোর্নিয়া সান্তা ক্রুজের বিজ্ঞানী পুয়া আসাদির নেতৃত্বে যুক্তরাষ্ট্র ও কানাডার একদল বিজ্ঞানী।&lt;/p&gt;</description>

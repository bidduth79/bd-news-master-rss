      <link>https://www.prothomalo.com/bangladesh/756u0me1cm</link>
      <guid isPermaLink="true">https://www.prothomalo.com/bangladesh/756u0me1cm</guid>
      <pubDate>Sat, 21 Nov 2026 08:40:16 +0000</pubDate>
      <enclosure url="https://media.prothomalo.com/prothomalo-bangla/2026-11-20/dfmvkakx/ROHINGYA.jpg" length="0" type="image/jpeg" />
      <media:content url="https://media.prothomalo.com/prothomalo-bangla/2026-11-20/dfmvkakx/ROHINGYA.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://media.prothomalo.com/prothomalo-bangla/2026-11-20/dfmvkakx/ROHINGYA.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মিয়ানমারের বিরুদ্ধে রায় বাস্তবায়ন কোন পথে" /&gt;&lt;/p&gt;&lt;p&gt;আদালত আরও দেখতে পেয়েছেন, গ্রামগুলো ‘পরিকল্পিতভাবে ধ্বংস’ করা হয়েছিল। সেসব জায়গায় স্থায়ী স্থাপনা নির্মাণ করা হয় এবং পরবর্তী সময়ে সেখানে রোহিঙ্গা নয়—এমন লোকজনকে পুনর্বাসিত করা হয়।&lt;/p&gt;</description>

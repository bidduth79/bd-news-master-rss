    <item>
      <title>নিষিদ্ধ ছাত্রলীগ নেতাকে পুলিশে দেওয়া নিয়ে ছাত্রদলের দুই পক্ষে সংঘর্ষ, গুলি-ককটেল</title>
      <link>https://www.prothomalo.com/bangladesh/district/jd7bz89kk3</link>
      <guid isPermaLink="true">https://www.prothomalo.com/bangladesh/district/jd7bz89kk3</guid>

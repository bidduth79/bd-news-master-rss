    <item>
      <title>‘ওয়েস্ট বেঙ্গল’ নাম পরিবর্তনের প্রস্তাব বিজেপির, সত্যিই কি বদলে যাচ্ছে রাজ্যটির নাম</title>
      <link>https://www.prothomalo.com/world/india/wg4wra43q3</link>
      <guid isPermaLink="true">https://www.prothomalo.com/world/india/wg4wra43q3</guid>
      <pubDate>Wed, 25 Nov 2026 20:34:50 +0000</pubDate>
      <enclosure url="https://media.prothomalo.com/prothomalo-bangla/2026-11-25/nd0fgyba/%E0%A7%AA.avif" length="0" type="image/jpeg" />
      <media:content url="https://media.prothomalo.com/prothomalo-bangla/2026-11-25/nd0fgyba/%E0%A7%AA.avif" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://media.prothomalo.com/prothomalo-bangla/2026-11-25/nd0fgyba/%E0%A7%AA.avif" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘ওয়েস্ট বেঙ্গল’ নাম পরিবর্তনের প্রস্তাব বিজেপির, সত্যিই কি বদলে যাচ্ছে রাজ্যটির নাম" /&gt;&lt;/p&gt;&lt;p&gt;বিজেপি নেতৃত্বাধীন সরকার যে যুক্তিই দিক, নাম পরিবর্তন হলে মানুষের সুবিধার চেয়ে সমস্যা তৈরি হতে পারে বলে মনে করছেন বুদ্ধিজীবীদের অনেকে।&lt;/p&gt;</description>
      <source url="https://www.prothomalo.com/world/india/wg4wra43q3">Prothom Alo</source>

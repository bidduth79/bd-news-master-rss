      <link>https://www.prothomalo.com/bangladesh/crime/x8lptrtkwq</link>
      <guid isPermaLink="true">https://www.prothomalo.com/bangladesh/crime/x8lptrtkwq</guid>
      <pubDate>Mon, 16 Nov 2026 17:42:42 +0000</pubDate>
      <enclosure url="https://media.prothomalo.com/prothomalo-bangla/2026-11-16/e9kxawce/Rupnagar.jpg" length="0" type="image/jpeg" />

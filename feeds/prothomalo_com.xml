    <item>
      <title>শেষ স্বীকৃত ব্যাটসম্যানদের জুটিও ভাঙল, ইনিংস হারের শঙ্কায় বাংলাদেশ</title>
      <link>https://www.prothomalo.com/sports/cricket/ph1g04v88a</link>
      <guid isPermaLink="true">https://www.prothomalo.com/sports/cricket/ph1g04v88a</guid>
      <pubDate>Mon, 23 Nov 2026 07:29:05 +0000</pubDate>
      <enclosure url="https://media.prothomalo.com/prothomalo-bangla/2026-11-24/g8zrt9m8/946537-01-02.jpg" length="0" type="image/jpeg" />
      <media:content url="https://media.prothomalo.com/prothomalo-bangla/2026-11-24/g8zrt9m8/946537-01-02.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://media.prothomalo.com/prothomalo-bangla/2026-11-24/g8zrt9m8/946537-01-02.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শেষ স্বীকৃত ব্যাটসম্যানদের জুটিও ভাঙল, ইনিংস হারের শঙ্কায় বাংলাদেশ" /&gt;&lt;/p&gt;&lt;p&gt;সেঞ্চুরিয়নে সিরিজের দ্বিতীয় টেস্টে মুখোমুখি বাংলাদেশ–দক্ষিণ আফ্রিকা। ম্যাচের তাৎক্ষণিক ঘটনাপ্রবাহ, তথ্য ও পরিসংখ্যান জানতে চোখ রাখুন প্রথম আলো লাইভ ব্লগে।&lt;/p&gt;</description>
      <source url="https://www.prothomalo.com/sports/cricket/ph1g04v88a">Prothom Alo</source>
    </item>
    <item>

    <item>
      <title>সরকারিভাবে ব্রুনেইয়ে কাজের সুযোগ পাবেন ৩৭০ জন</title>
      <link>https://www.prothomalo.com/chakri/chakri-news/mpbqwb5p5c</link>
      <guid isPermaLink="true">https://www.prothomalo.com/chakri/chakri-news/mpbqwb5p5c</guid>
      <pubDate>Mon, 23 Nov 2026 08:03:04 +0000</pubDate>
      <enclosure url="https://media.prothomalo.com/prothomalo-bangla/2026-09-01/dz6gjbhq/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%80%E2%80%93%E0%A7%A8.png" length="0" type="image/jpeg" />
      <media:content url="https://media.prothomalo.com/prothomalo-bangla/2026-09-01/dz6gjbhq/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%80%E2%80%93%E0%A7%A8.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://media.prothomalo.com/prothomalo-bangla/2026-09-01/dz6gjbhq/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%80%E2%80%93%E0%A7%A8.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সরকারিভাবে ব্রুনেইয়ে কাজের সুযোগ পাবেন ৩৭০ জন" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ ওভারসিজ এমপ্লয়মেন্ট অ্যান্ড সার্ভিসেস লিমিটেডের (বোয়েসেল) মাধ্যমে ব্রুনেইয়ের বিভিন্ন প্রতিষ্ঠানে জনবল নিয়োগ দেওয়া হবে। মোট পদসংখ্যা ৩৭০। আবেদনের শেষ সময় ২৭ নভেম্বর বিকেল ৪টা।&lt;/p&gt;</description>
      <source url="https://www.prothomalo.com/chakri/chakri-news/mpbqwb5p5c">Prothom Alo</source>
    </item>

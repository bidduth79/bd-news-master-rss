    <item>
      <title>জার্মানি প্রথমবারের মতো একজন নারী প্রেসিডেন্ট পেতে পারে</title>
      <link>https://www.prothomalo.com/world/europe/ngce0i2hyk</link>
      <guid isPermaLink="true">https://www.prothomalo.com/world/europe/ngce0i2hyk</guid>

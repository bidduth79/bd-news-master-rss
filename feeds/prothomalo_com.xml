    <item>
      <title>পাগলা মসজিদের সিন্দুকে এবার ৫১ বস্তা টাকা, সব রেকর্ড ছাড়িয়ে যাওয়ার প্রত্যাশা</title>
      <link>https://www.prothomalo.com/bangladesh/district/0fgwxs230n</link>
      <guid isPermaLink="true">https://www.prothomalo.com/bangladesh/district/0fgwxs230n</guid>

    <item>
      <title>মালিকদের সুবিধাই কি সরকারের অগ্রাধিকার</title>
      <link>https://www.prothomalo.com/opinion/editorial/ddq9lq0bsr</link>
      <guid isPermaLink="true">https://www.prothomalo.com/opinion/editorial/ddq9lq0bsr</guid>
      <pubDate>Tue, 17 Nov 2026 03:16:49 +0000</pubDate>
      <enclosure url="https://media.prothomalo.com/prothomalo-bangla/2020-10/1029114c-37fd-4c36-a816-595983984828/editorial_5.png" length="0" type="image/jpeg" />
      <media:content url="https://media.prothomalo.com/prothomalo-bangla/2020-10/1029114c-37fd-4c36-a816-595983984828/editorial_5.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://media.prothomalo.com/prothomalo-bangla/2020-10/1029114c-37fd-4c36-a816-595983984828/editorial_5.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মালিকদের সুবিধাই কি সরকারের অগ্রাধিকার" /&gt;&lt;/p&gt;&lt;p&gt;পরিবেশ মন্ত্রণালয়ের দায়িত্ব শিল্পের প্রয়োজনের সঙ্গে জনস্বার্থের ভারসাম্য রক্ষা করা; শিল্পমালিকদের অনুরোধকে সিদ্ধান্তের প্রধান ভিত্তি করা নয়।&lt;/p&gt;</description>
      <source url="https://www.prothomalo.com/opinion/editorial/ddq9lq0bsr">Prothom Alo</source>
    </item>
    <item>
      <title>হত্যার অপরাধকে লঘু করার সুযোগ নেই</title>
      <link>https://www.prothomalo.com/opinion/editorial/82e5zh7dg9</link>
      <guid isPermaLink="true">https://www.prothomalo.com/opinion/editorial/82e5zh7dg9</guid>
      <pubDate>Tue, 17 Nov 2026 03:12:28 +0000</pubDate>
      <enclosure url="https://media.prothomalo.com/prothomalo-bangla/2020-10/1d63e6da-a8a2-4b30-a01c-0443c6229cd7/editorial_3.png" length="0" type="image/jpeg" />
      <media:content url="https://media.prothomalo.com/prothomalo-bangla/2020-10/1d63e6da-a8a2-4b30-a01c-0443c6229cd7/editorial_3.png" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://media.prothomalo.com/prothomalo-bangla/2020-10/1d63e6da-a8a2-4b30-a01c-0443c6229cd7/editorial_3.png" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হত্যার অপরাধকে লঘু করার সুযোগ নেই" /&gt;&lt;/p&gt;&lt;p&gt;দুই তরুণ শ্রমিকের এমন অকালমৃত্যুতে তাঁদের পরিবার আজ দিশাহারা। পুলিশ ইতিমধ্যে অভিযুক্ত চালক আজির হোসেন ও তাঁর সহকারীকে গ্রেপ্তার করে কারাগারে পাঠিয়েছে।&lt;/p&gt;</description>
      <source url="https://www.prothomalo.com/opinion/editorial/82e5zh7dg9">Prothom Alo</source>
    </item>

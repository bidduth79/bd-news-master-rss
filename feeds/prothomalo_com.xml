      <link>https://www.prothomalo.com/world/asia/5yhbd8jqqj</link>
      <guid isPermaLink="true">https://www.prothomalo.com/world/asia/5yhbd8jqqj</guid>
      <pubDate>Fri, 27 Nov 2026 06:14:52 +0000</pubDate>
      <enclosure url="https://media.prothomalo.com/prothomalo-bangla/2026-11-27/mc7tan0f/Abandoned-By-Families.jpeg" length="0" type="image/jpeg" />

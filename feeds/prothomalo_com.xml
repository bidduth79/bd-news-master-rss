      <link>https://www.prothomalo.com/bangladesh/97ciszq5lu</link>
      <guid isPermaLink="true">https://www.prothomalo.com/bangladesh/97ciszq5lu</guid>
      <pubDate>Wed, 25 Nov 2026 20:29:59 +0000</pubDate>
      <enclosure url="https://media.prothomalo.com/prothomalo-bangla/2026-11-25/q1jkim1b/moon.jfif" length="0" type="image/jpeg" />
      <media:content url="https://media.prothomalo.com/prothomalo-bangla/2026-11-25/q1jkim1b/moon.jfif" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://media.prothomalo.com/prothomalo-bangla/2026-11-25/q1jkim1b/moon.jfif" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শেখ হাসিনার সাবেক উপ–প্রেস সচিব শাখাওয়াতকে আটক করে পুলিশে দিলেন ছাত্রদলের নেতা-কর্মীরা" /&gt;&lt;/p&gt;&lt;p&gt;ভিডিওতে দেখা যায়, শাখাওয়াতকে আটক করে জিজ্ঞাসাবাদ করছেন ছাত্রদলের নেতা-কর্মীরা। তাঁর কাছে কার্যক্রম নিষিদ্ধ আওয়ামী লীগের পরিকল্পনা জানতে চাওয়া হয়।&lt;/p&gt;</description>

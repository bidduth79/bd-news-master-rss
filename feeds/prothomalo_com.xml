    <item>
      <title>বাংলাদেশের অভ্যন্তরীণ বিষয়ে হস্তক্ষেপ না করার নীতিতে অঙ্গীকারবদ্ধ চীন</title>
      <link>https://www.prothomalo.com/bangladesh/z6rmeme3cb</link>
      <guid isPermaLink="true">https://www.prothomalo.com/bangladesh/z6rmeme3cb</guid>
      <pubDate>Mon, 23 Nov 2026 20:04:32 +0000</pubDate>
      <enclosure url="https://media.prothomalo.com/prothomalo-bangla/2026-11-23/cf283jum/china-Embasador-01.jpeg" length="0" type="image/jpeg" />
      <media:content url="https://media.prothomalo.com/prothomalo-bangla/2026-11-23/cf283jum/china-Embasador-01.jpeg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://media.prothomalo.com/prothomalo-bangla/2026-11-23/cf283jum/china-Embasador-01.jpeg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাংলাদেশের অভ্যন্তরীণ বিষয়ে হস্তক্ষেপ না করার নীতিতে অঙ্গীকারবদ্ধ চীন" /&gt;&lt;/p&gt;&lt;p&gt;নেতৃত্ব পর্যায়ে কৌশলগত সমন্বয় নিশ্চিত হলেই কেবল রাজনৈতিক পালাবদলের মধ্যেও পৃথক প্রকল্পগুলোর ধারাবাহিকতা বজায় রাখা সম্ভব বলে মন্তব্য করেছেন ঢাকায় নিযুক্ত চীনের ভারপ্রাপ্ত রাষ্ট্রদূত লিউ ইউয়িন।&lt;/p&gt;</description>
      <source url="https://www.prothomalo.com/bangladesh/z6rmeme3cb">Prothom Alo</source>
    </item>
    <item>

      <guid isPermaLink="true">https://www.bondhushava.com/feature/cn2jhq5zb4</guid>
      <pubDate>Tue, 17 Nov 2026 03:00:00 +0000</pubDate>
      <enclosure url="https://media.prothomalo.com/prothomalo-bangla/2026-11-16/jauehfnu/IMG4773.JPG" length="0" type="image/jpeg" />
      <media:content url="https://media.prothomalo.com/prothomalo-bangla/2026-11-16/jauehfnu/IMG4773.JPG" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://media.prothomalo.com/prothomalo-bangla/2026-11-16/jauehfnu/IMG4773.JPG" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মনে হচ্ছে এখনো সবার সঙ্গে লঞ্চেই আছি" /&gt;&lt;/p&gt;&lt;p&gt;রাতের ট্রেনে চড়ে সকালে কমলাপুর স্টেশনে পৌঁছে দেখি, আমাদের সবাইকে সদরঘাট নিয়ে যাওয়ার জন্য বিআরটিসির ডাবল ডেকার বাস দাঁড়িয়ে আছে। ট্রেনে গান আর আড্ডায় কখন যে ঢাকায় চলে এলাম, বুঝতেই পারলাম না।&lt;/p&gt;</description>
      <source url="https://www.bondhushava.com/feature/cn2jhq5zb4">Prothom Alo</source>
    </item>

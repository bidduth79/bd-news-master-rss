    <item>
      <title>বিশ্বে সবচেয়ে বেশি সোনা উৎপাদন করে কোন দেশ</title>
      <link>https://www.prothomalo.com/world/china/d5iy2jsbmr</link>
      <guid isPermaLink="true">https://www.prothomalo.com/world/china/d5iy2jsbmr</guid>
      <pubDate>Mon, 23 Nov 2026 08:30:35 +0000</pubDate>
      <enclosure url="https://media.prothomalo.com/prothomalo-bangla/2026-11-23/5qe7euk8/Caibai-Jewelry-store-in-Beijing.webp" length="0" type="image/jpeg" />
      <media:content url="https://media.prothomalo.com/prothomalo-bangla/2026-11-23/5qe7euk8/Caibai-Jewelry-store-in-Beijing.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://media.prothomalo.com/prothomalo-bangla/2026-11-23/5qe7euk8/Caibai-Jewelry-store-in-Beijing.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিশ্বে সবচেয়ে বেশি সোনা উৎপাদন করে কোন দেশ" /&gt;&lt;/p&gt;&lt;p&gt;চায়না গোল্ড অ্যাসোসিয়েশনের পরিসংখ্যান অনুযায়ী, ২০২৬ সালের প্রথম তিন প্রান্তিকে চীন দেশীয় কাঁচামাল থেকে মোট ২২০ দশমিক ৯৩৫ টন সোনা উৎপাদন করেছে।&lt;/p&gt;</description>

    <item>
      <title>ফটিকছড়িতে লঙ্কাকাণ্ড ঘটিয়ে ফেসবুকে সাফাই গাইলেন শীর্ষ সন্ত্রাসী রায়হান</title>
      <link>https://suprobhat.com/%e0%a6%ab%e0%a6%9f%e0%a6%bf%e0%a6%95%e0%a6%9b%e0%a6%a1%e0%a6%bc%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%b2%e0%a6%99%e0%a7%8d%e0%a6%95%e0%a6%be%e0%a6%95%e0%a6%be%e0%a6%a3%e0%a7%8d%e0%a6%a1-%e0%a6%98%e0%a6%9f/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%ab%e0%a6%9f%e0%a6%bf%e0%a6%95%e0%a6%9b%e0%a6%a1%e0%a6%bc%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%b2%e0%a6%99%e0%a7%8d%e0%a6%95%e0%a6%be%e0%a6%95%e0%a6%be%e0%a6%a3%e0%a7%8d%e0%a6%a1-%e0%a6%98%e0%a6%9f/</guid>
      <pubDate>Tue, 24 Nov 2026 16:24:26 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/rayhan.jpg" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/rayhan.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/rayhan.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফটিকছড়িতে লঙ্কাকাণ্ড ঘটিয়ে ফেসবুকে সাফাই গাইলেন শীর্ষ সন্ত্রাসী রায়হান" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রামের ফটিকছড়িতে সিএনজিচালিত অটোরিকশা থেকে গুলি ছুড়ে ছয়জনকে আহত করার ঘটনার পর ফেসবুকে নিজের পক্ষে সাফাই দিয়েছেন পুলিশের তালিকাভুক্ত শীর্ষ সন্ত্রাসী মোহাম্মদ রায়হান আলম ওরফে ‘শুটার রায়হান’। তাঁর দাবি, কয়েকজন বিএনপি নেতা তাকে আওয়ামীপন্থি মনে করে গাড়ি আটকানোর চেষ্টা করলে আত্মরক্ষার্থে গুলি চালান ত&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%ab%e0%a6%9f%e0%a6%bf%e0%a6%95%e0%a6%9b%e0%a6%a1%e0%a6%bc%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%b2%e0%a6%99%e0%a7%8d%e0%a6%95%e0%a6%be%e0%a6%95%e0%a6%be%e0%a6%a3%e0%a7%8d%e0%a6%a1-%e0%a6%98%e0%a6%9f/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>লোহাগাড়ায় ঈগল বাসের সঙ্গে কাভার্ড ভ্যানের সংঘর্ষ, আহত ২</title>
      <link>https://suprobhat.com/%e0%a6%b2%e0%a7%8b%e0%a6%b9%e0%a6%be%e0%a6%97%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%88%e0%a6%97%e0%a6%b2-%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%99/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%b2%e0%a7%8b%e0%a6%b9%e0%a6%be%e0%a6%97%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%88%e0%a6%97%e0%a6%b2-%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%99/</guid>
      <pubDate>Tue, 24 Nov 2026 15:58:58 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/lohagara-accident-eagle-bus.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/lohagara-accident-eagle-bus.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/lohagara-accident-eagle-bus.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="লোহাগাড়ায় ঈগল বাসের সঙ্গে কাভার্ড ভ্যানের সংঘর্ষ, আহত ২" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রামের লোহাগাড়ায় চট্টগ্রাম-কক্সবাজার মহাসড়কে ঈগল পরিবহনের একটি বাসের সঙ্গে মিনি কাভার্ড ভ্যানের মুখোমুখি সংঘর্ষ হয়েছে। এতে দুই গাড়ির চালক আহত হয়েছেন। তাঁদের মধ্যে কাভার্ড ভ্যানচালকের অবস্থা গুরুতর বলে জানা গেছে। মঙ্গলবার (২৪ নভেম্বর) সন্ধ্যা ৭টার দিকে উপজেলার আধুনগর গ্রিন প্যালেসের সামনে এ দুর্&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%b2%e0%a7%8b%e0%a6%b9%e0%a6%be%e0%a6%97%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%88%e0%a6%97%e0%a6%b2-%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%99/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>কক্সবাজারে বাস-সিএনজি মুখোমুখি সংঘর্ষ, নিহত ৩</title>
      <link>https://suprobhat.com/%e0%a6%95%e0%a6%95%e0%a7%8d%e0%a6%b8%e0%a6%ac%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0%e0%a7%87-%e0%a6%ac%e0%a6%be%e0%a6%b8-%e0%a6%b8%e0%a6%bf%e0%a6%8f%e0%a6%a8%e0%a6%9c%e0%a6%bf-%e0%a6%ae%e0%a7%81/</link>

      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/epic.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/epic.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সিঙ্গারা না পেয়ে এপিকে ক্যান্টিন কর্মীর অণ্ডকোষ চেপে ধরলেন চিকিৎসক" /&gt;&lt;/p&gt;&lt;p&gt;সিঙ্গারা না পেয়ে ক্ষুব্ধ হয়ে চট্টগ্রামের বেসরকারি রোগ নির্ণয় কেন্দ্র এপিক হেলথ কেয়ারের এক ক্যান্টিন কর্মীর অণ্ডকোষ চেপে ধরার অভিযোগ উঠেছে এক চিকিৎসকের বিরুদ্ধে। প্রতিষ্ঠানের ক্যান্টিনে নারী কর্মীদের সামনেই ওই ঘটনা ঘটে। এতে অসুস্থ হয়ে পড়েন ভুক্তভোগী কর্মী। পরে তাঁকে হাসপাতালে ভর্তি করা হয়। অভিযুক্ত চ&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%b8%e0%a6%bf%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a6%be%e0%a6%b0%e0%a6%be-%e0%a6%a8%e0%a6%be-%e0%a6%aa%e0%a7%87%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%8f%e0%a6%aa%e0%a6%bf%e0%a6%95%e0%a7%87-%e0%a6%95/">Suprobhat Bangladesh</source>

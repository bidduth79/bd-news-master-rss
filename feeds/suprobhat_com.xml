      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/pujarir-beshe-mondire-chain-churi-chandgaon-chattogram.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চান্দগাঁওয়ে পূজারির বেশে মন্দিরে ঢুকে স্বর্ণ চুরি, সিসিটিভিতে ধরা দুই নারী" /&gt;&lt;/p&gt;&lt;p&gt;নগরের চান্দগাঁওয়ে মন্দিরে পূজারির বেশে ঢুকে ভিড়ের মধ্যে দুই নারীর গলা থেকে স্বর্ণের চেইন চুরির অভিযোগে দুজনকে গ্রেপ্তার করেছে পুলিশ। গত ২০ নভেম্বর দুপুরে মধ্যম মোহরার ছাফা মোতালেব কলেজ রোডের শ্রীশ্রী রাধা-গোবিন্দ ইসকন মন্দিরে অন্নকূট অনুষ্ঠানে এ ঘটনা ঘটে। মন্দিরের সিসিটিভি ফুটেজ পর্যালোচনা করে দুই ন&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%9a%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%97%e0%a6%be%e0%a6%81%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%aa%e0%a7%82%e0%a6%9c%e0%a6%be%e0%a6%b0%e0%a6%bf%e0%a6%b0-%e0%a6%ac%e0%a7%87%e0%a6%b6/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>পুতিনকে ‘বন্ধু’ বলায় ট্রাম্পকে জবাব দিলেন জেলেনস্কি</title>
      <link>https://suprobhat.com/%e0%a6%aa%e0%a7%81%e0%a6%a4%e0%a6%bf%e0%a6%a8%e0%a6%95%e0%a7%87-%e0%a6%ac%e0%a6%a8%e0%a7%8d%e0%a6%a7%e0%a7%81-%e0%a6%ac%e0%a6%b2%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%9f%e0%a7%8d/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%aa%e0%a7%81%e0%a6%a4%e0%a6%bf%e0%a6%a8%e0%a6%95%e0%a7%87-%e0%a6%ac%e0%a6%a8%e0%a7%8d%e0%a6%a7%e0%a7%81-%e0%a6%ac%e0%a6%b2%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%9f%e0%a7%8d/</guid>
      <pubDate>Sat, 21 Nov 2026 07:12:38 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/Zelensky.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/Zelensky.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/Zelensky.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পুতিনকে ‘বন্ধু’ বলায় ট্রাম্পকে জবাব দিলেন জেলেনস্কি" /&gt;&lt;/p&gt;&lt;p&gt;রাশিয়ার প্রেসিডেন্ট ভ্লাদিমির পুতিনকে ‘খুনি’ ও ‘শত্রু’ বলে অভিহিত করেছেন ইউক্রেনের প্রেসিডেন্ট ভলোদিমির জেলেনস্কি। চীনে পুতিনকে মার্কিন প্রেসিডেন্ট ডোনাল্ড ট্রাম্প ‘বন্ধু’ বলে সম্বোধন করার প্রতিক্রিয়ায় এ মন্তব্য করেন তিনি। সিএনএনকে দেওয়া এক সাক্ষাৎকারে জেলেনস্কি বলেন, পুতিনকে কীভাবে সম্বোধন করবেন, স&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%aa%e0%a7%81%e0%a6%a4%e0%a6%bf%e0%a6%a8%e0%a6%95%e0%a7%87-%e0%a6%ac%e0%a6%a8%e0%a7%8d%e0%a6%a7%e0%a7%81-%e0%a6%ac%e0%a6%b2%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%9f%e0%a7%8d/">Suprobhat Bangladesh</source>

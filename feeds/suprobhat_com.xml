    <item>
      <title>চার বিশ্ববিদ্যালয়ের শিক্ষার্থীদের অংশগ্রহণে সাউদার্নে ফার্মা ফেস্ট</title>
      <link>https://suprobhat.com/%e0%a6%9a%e0%a6%be%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%ac%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%b2%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%b0-%e0%a6%b6%e0%a6%bf%e0%a6%95/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%9a%e0%a6%be%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%ac%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%b2%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%b0-%e0%a6%b6%e0%a6%bf%e0%a6%95/</guid>
      <pubDate>Mon, 23 Nov 2026 07:47:00 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/Southern-University-Pharma-Fest-2.0.jpg.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/Southern-University-Pharma-Fest-2.0.jpg.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/Southern-University-Pharma-Fest-2.0.jpg.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চার বিশ্ববিদ্যালয়ের শিক্ষার্থীদের অংশগ্রহণে সাউদার্নে ফার্মা ফেস্ট" /&gt;&lt;/p&gt;&lt;p&gt;সাউদার্ন ইউনিভার্সিটি বাংলাদেশে ফার্মেসি বিভাগের উদ্যোগে অনুষ্ঠিত হয়েছে ‘ফার্মাট্রিক্স: ফেয়ারওয়েল অ্যান্ড ফার্মা ফেস্ট ২.০’। এতে চারটি বিশ্ববিদ্যালয়ের শিক্ষার্থীরা কুইজ, বিতর্ক, পোস্টার উপস্থাপনা ও প্রামাণ্যচিত্র নির্মাণ প্রতিযোগিতায় অংশ নেন। সম্প্রতি বিশ্ববিদ্যালয়ের ফার্মেসি বিভাগ ও ফার্মা ক্লাবের &lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%9a%e0%a6%be%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%ac%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%b2%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%b0-%e0%a6%b6%e0%a6%bf%e0%a6%95/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>আনোয়ারায় পুকুরে মিলল অজ্ঞাত নারীর মরদেহ</title>
      <link>https://suprobhat.com/%e0%a6%86%e0%a6%a8%e0%a7%8b%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%aa%e0%a7%81%e0%a6%95%e0%a7%81%e0%a6%b0%e0%a7%87-%e0%a6%ae%e0%a6%bf%e0%a6%b2%e0%a6%b2-%e0%a6%85/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%86%e0%a6%a8%e0%a7%8b%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%aa%e0%a7%81%e0%a6%95%e0%a7%81%e0%a6%b0%e0%a7%87-%e0%a6%ae%e0%a6%bf%e0%a6%b2%e0%a6%b2-%e0%a6%85/</guid>
      <pubDate>Mon, 23 Nov 2026 07:33:42 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/pond.jpg" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/pond.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/pond.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আনোয়ারায় পুকুরে মিলল অজ্ঞাত নারীর মরদেহ" /&gt;&lt;/p&gt;&lt;p&gt;আনোয়ারায় একটি পুকুর থেকেএক নারীর মরদেহ উদ্ধার করেছে পুলিশ। এখনো আনুমানিক ৫৫ বছর বয়সী ওই নারীর পরিচয় মিলেনি। স্থানীয়দের বরাতে পুলিশ বলছে, কয়েক দিন ধরে ভবঘুরে অবস্থায় এলাকায় ঘোরাফেরা করছিলেন। তার আচরণ দেখে মানসিক ভারসাম্যহীন বলে ধারণা করেছেন স্থানীয়রা। সোমবার (২৩ নভেম্বর) সকালে উপজেলার ৯ নম্বর পরৈকোড়া&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%86%e0%a6%a8%e0%a7%8b%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%aa%e0%a7%81%e0%a6%95%e0%a7%81%e0%a6%b0%e0%a7%87-%e0%a6%ae%e0%a6%bf%e0%a6%b2%e0%a6%b2-%e0%a6%85/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>আন্তর্জাতিক যুব পর্ষদে দ্বিতীয় মেয়াদেও ডাক পেলেন শ্রেয়া ঘোষ</title>
      <link>https://suprobhat.com/%e0%a6%86%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a6%b0%e0%a7%8d%e0%a6%9c%e0%a6%be%e0%a6%a4%e0%a6%bf%e0%a6%95-%e0%a6%af%e0%a7%81%e0%a6%ac-%e0%a6%aa%e0%a6%b0%e0%a7%8d%e0%a6%b7%e0%a6%a6%e0%a7%87-%e0%a6%a6/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%86%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a6%b0%e0%a7%8d%e0%a6%9c%e0%a6%be%e0%a6%a4%e0%a6%bf%e0%a6%95-%e0%a6%af%e0%a7%81%e0%a6%ac-%e0%a6%aa%e0%a6%b0%e0%a7%8d%e0%a6%b7%e0%a6%a6%e0%a7%87-%e0%a6%a6/</guid>
      <pubDate>Mon, 23 Nov 2026 06:49:32 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/sreya.jpg" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/sreya.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/sreya.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আন্তর্জাতিক যুব পর্ষদে দ্বিতীয় মেয়াদেও ডাক পেলেন শ্রেয়া ঘোষ" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশের তরুণদের কণ্ঠ আন্তর্জাতিক পরিসরে তুলে ধরার দায়িত্ব আরও এক বছর পেলেন শ্রেয়া ঘোষ। নেদারল্যান্ডসভিত্তিক শিশু অধিকার সংস্থা KidsRights-এর ‘State of Youth’-এর যুব পর্ষদে প্রথম বাংলাদেশি সদস্য হিসেবে যুক্ত হওয়ার পর এবার দ্বিতীয় মেয়াদেও তাঁকে আমন্ত্রণ জানানো হয়েছে। স্থানীয় পর্যায়ে শিশুদের শিক্ষার&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%86%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a6%b0%e0%a7%8d%e0%a6%9c%e0%a6%be%e0%a6%a4%e0%a6%bf%e0%a6%95-%e0%a6%af%e0%a7%81%e0%a6%ac-%e0%a6%aa%e0%a6%b0%e0%a7%8d%e0%a6%b7%e0%a6%a6%e0%a7%87-%e0%a6%a6/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>বোয়ালখালীতে পদ্ম গোখরার কামড়ে প্রাণ গেল ২১ মাসের শিশুর</title>
      <link>https://suprobhat.com/%e0%a6%ac%e0%a7%8b%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b2%e0%a6%96%e0%a6%be%e0%a6%b2%e0%a7%80%e0%a6%a4%e0%a7%87-%e0%a6%aa%e0%a6%a6%e0%a7%8d%e0%a6%ae-%e0%a6%97%e0%a7%8b%e0%a6%96%e0%a6%b0%e0%a6%be%e0%a6%b0/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%ac%e0%a7%8b%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b2%e0%a6%96%e0%a6%be%e0%a6%b2%e0%a7%80%e0%a6%a4%e0%a7%87-%e0%a6%aa%e0%a6%a6%e0%a7%8d%e0%a6%ae-%e0%a6%97%e0%a7%8b%e0%a6%96%e0%a6%b0%e0%a6%be%e0%a6%b0/</guid>
      <pubDate>Mon, 23 Nov 2026 06:22:14 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/boalkhali-snake-abdullah.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/boalkhali-snake-abdullah.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/boalkhali-snake-abdullah.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বোয়ালখালীতে পদ্ম গোখরার কামড়ে প্রাণ গেল ২১ মাসের শিশুর" /&gt;&lt;/p&gt;&lt;p&gt;বোয়ালখালীতে সাপের কামড়ে আবদুল্লাহ নামে ২১ মাস বয়সী এক শিশুর মৃত্যু হয়েছে। রবিবার(২২ নভেম্বর) রাত সাড়ে ১০টার দিকে চট্টগ্রাম মেডিকেল কলেজ হাসপাতালে চিকিৎসাধীন অবস্থায় তার মৃত্যু হয়। আবদুল্লাহ উপজেলার আমুচিয়া ইউনিয়নের ৪ নম্বর ওয়ার্ডের ধোরলা খান বাহাদুর পাড়া এলাকার সিদ্দিক আহমদের বাড়ির প্রবাসী ওসমান আলী&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%ac%e0%a7%8b%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b2%e0%a6%96%e0%a6%be%e0%a6%b2%e0%a7%80%e0%a6%a4%e0%a7%87-%e0%a6%aa%e0%a6%a6%e0%a7%8d%e0%a6%ae-%e0%a6%97%e0%a7%8b%e0%a6%96%e0%a6%b0%e0%a6%be%e0%a6%b0/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>চান্দগাঁওয়ে পূজার অনুষ্ঠানে মদপানে অসুস্থ হয়ে দুজনের মৃত্যু, একজন লাইফ সাপোর্টে</title>
      <link>https://suprobhat.com/%e0%a6%9a%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%97%e0%a6%be%e0%a6%81%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%aa%e0%a7%82%e0%a6%9c%e0%a6%be%e0%a6%b0-%e0%a6%85%e0%a6%a8%e0%a7%81%e0%a6%b7%e0%a7%8d/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%9a%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%97%e0%a6%be%e0%a6%81%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%aa%e0%a7%82%e0%a6%9c%e0%a6%be%e0%a6%b0-%e0%a6%85%e0%a6%a8%e0%a7%81%e0%a6%b7%e0%a7%8d/</guid>
      <pubDate>Mon, 23 Nov 2026 05:57:22 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/chadgaon-death-alchol.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/chadgaon-death-alchol.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/chadgaon-death-alchol.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চান্দগাঁওয়ে পূজার অনুষ্ঠানে মদপানে অসুস্থ হয়ে দুজনের মৃত্যু, একজন লাইফ সাপোর্টে" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রামের চান্দগাঁওয়ে জগদ্ধাত্রী পূজার অনুষ্ঠানে মদপানের পর অসুস্থ হয়ে দুজনের মৃত্যু হয়েছে। একই ঘটনায় অসুস্থ হয়ে বিভিন্ন হাসপাতালে চিকিৎসাধীন রয়েছেন আরও কয়েকজন। তাদের মধ্যে একজনকে লাইফ সাপোর্টে রাখা হয়েছে। রবিবার (২২ নভেম্বর) চিকিৎসাধীন অবস্থায় তাদের মৃত্যু হয়। গত ২০ নভেম্বর রাতে চান্দগাঁওয়ের মগদ্&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%9a%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%97%e0%a6%be%e0%a6%81%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%aa%e0%a7%82%e0%a6%9c%e0%a6%be%e0%a6%b0-%e0%a6%85%e0%a6%a8%e0%a7%81%e0%a6%b7%e0%a7%8d/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>ডিপো-টার্মিনাল শিল্পাঞ্চলের ‘বাকি’ খাতা খুলছে চসিক</title>

    <item>
      <title>একই শ্রাবণে</title>
      <link>https://suprobhat.com/%e0%a6%8f%e0%a6%95%e0%a6%87-%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ac%e0%a6%a3%e0%a7%87/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%8f%e0%a6%95%e0%a6%87-%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ac%e0%a6%a3%e0%a7%87/</guid>
      <pubDate>Mon, 16 Nov 2026 18:14:44 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/shilpo-shahitto-1.jpg" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/shilpo-shahitto-1.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/shilpo-shahitto-1.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="একই শ্রাবণে" /&gt;&lt;/p&gt;&lt;p&gt;শ্রাবণের প্রথম বর্ষণ আজ ঘন ঘোরে আচ্ছন্ন চারিদিক। শীতল হচ্ছে বাতাস। কিন্তু তাপের দাবদাহ নিভল না। হয়তো বা অতসীর মনের দাবদাহ তাকে অস্থির করে তুলেছে। সে জানালার পাশে মাথা রেখে আকাশের দিকে তাকিয়ে উদাসীনভাবে বৃষ্টি দেখছিল। মনে পড়ল, তার সেদিনের কথা, যেদিন প্রথম মহিমকে দেখেছিল। একই রসায়ন বিভাগে তারা পড়ে। হঠ&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%8f%e0%a6%95%e0%a6%87-%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ac%e0%a6%a3%e0%a7%87/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>কবিতা</title>
      <link>https://suprobhat.com/%e0%a6%95%e0%a6%ac%e0%a6%bf%e0%a6%a4%e0%a6%be-68/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%95%e0%a6%ac%e0%a6%bf%e0%a6%a4%e0%a6%be-68/</guid>
      <pubDate>Mon, 16 Nov 2026 18:10:06 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/kobita-1.jpg" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/kobita-1.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/kobita-1.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কবিতা" /&gt;&lt;/p&gt;&lt;p&gt;মাটির যত পাপ শাহীন মাহমুদ টারশিয়ারি যুগের পরের মাটি আর আদম পরবর্তী মাটির ঘনত্বে অনেক ফারাক অতএব আদম মাটির তৈরি। মৃত্তিকা জৈব উপাদান আর সময়ে- অনেক ফারাক অতএব মানুষ মাটির ফিনিশ প্রোডাক্ট। আমি প্লাইস্টোসিন যুগের পুরনো মাটি চাই- দূষণমুক্ত মাটি সভ্যতা, মানবতা, প্রতিহিংসাহীন দমওয়ালা মাটি। হেমন্তের নিমন্ত্&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%95%e0%a6%ac%e0%a6%bf%e0%a6%a4%e0%a6%be-68/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>পিএইচপি ফ্যামিলির  ডিএমডি হলেন মোহাম্মদ  মিজান ভিক্টর মহসিন</title>
      <link>https://suprobhat.com/%e0%a6%aa%e0%a6%bf%e0%a6%8f%e0%a6%87%e0%a6%9a%e0%a6%aa%e0%a6%bf-%e0%a6%ab%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%ae%e0%a6%bf%e0%a6%b2%e0%a6%bf%e0%a6%b0-%e0%a6%a1%e0%a6%bf%e0%a6%8f%e0%a6%ae%e0%a6%a1/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%aa%e0%a6%bf%e0%a6%8f%e0%a6%87%e0%a6%9a%e0%a6%aa%e0%a6%bf-%e0%a6%ab%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%ae%e0%a6%bf%e0%a6%b2%e0%a6%bf%e0%a6%b0-%e0%a6%a1%e0%a6%bf%e0%a6%8f%e0%a6%ae%e0%a6%a1/</guid>
      <pubDate>Mon, 16 Nov 2026 17:51:48 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/Victor-Mahsin.jpg" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/Victor-Mahsin.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/Victor-Mahsin.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পিএইচপি ফ্যামিলির  ডিএমডি হলেন মোহাম্মদ  মিজান ভিক্টর মহসিন" /&gt;&lt;/p&gt;&lt;p&gt;দেশের অন্যতম বৃহৎ শিল্পগোষ্ঠী পিএইচপি ফ্যামিলির প্রতিষ্ঠাতা আলহাজ সুফি মোহাম্মদ মিজানুর রহমানের জ্যেষ্ঠ নাতি ও তৃতীয় প্রজন্মের প্রথম সন্তান মোহাম্মদ মিজান ভিক্টর মহসিন পিএইচপি গ্লাস এবং পিএইচপি অ্যালুমিনিয়াম উপব্যবস্থাপনা পরিচালক (ডিএমডি) হিসেবে পদোন্নতি পেয়েছেন। তাঁর এ নিয়োগ পিএইচপি ফ্যামিলির ব্যবস&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%aa%e0%a6%bf%e0%a6%8f%e0%a6%87%e0%a6%9a%e0%a6%aa%e0%a6%bf-%e0%a6%ab%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%ae%e0%a6%bf%e0%a6%b2%e0%a6%bf%e0%a6%b0-%e0%a6%a1%e0%a6%bf%e0%a6%8f%e0%a6%ae%e0%a6%a1/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>হুমায়ূন আহমেদের শ্রুতিকাব্য</title>
      <link>https://suprobhat.com/%e0%a6%b9%e0%a7%81%e0%a6%ae%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a7%82%e0%a6%a8-%e0%a6%86%e0%a6%b9%e0%a6%ae%e0%a7%87%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a7%81%e0%a6%a4%e0%a6%bf%e0%a6%95/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%b9%e0%a7%81%e0%a6%ae%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a7%82%e0%a6%a8-%e0%a6%86%e0%a6%b9%e0%a6%ae%e0%a7%87%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a7%81%e0%a6%a4%e0%a6%bf%e0%a6%95/</guid>
      <pubDate>Mon, 16 Nov 2026 17:25:55 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/humayon-ahmed.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/humayon-ahmed.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/humayon-ahmed.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হুমায়ূন আহমেদের শ্রুতিকাব্য" /&gt;&lt;/p&gt;&lt;p&gt;হুমায়ূন আহমেদ একজন ব্যর্থ কবি, তবে তিনি বাংলা গানের ধারায় অসাধারণ গীতিকার। গভীর অর্থযুক্ত ও ভাবপ্রবণ এমন গীতিকার বিরলই নয়, দুষ্প্রাপ্য। কথাটি আপাতদৃষ্টিতে স্ববিরোধী মনে হতে পারে। বাংলা সাহিত্যে হুমায়ূন আহমেদের পরিচয় প্রধানত কথাসাহিত্যিক হিসেবে। উপন্যাস, ছোটগল্প, নাটক ও চলচ্চিত্রের মধ্য দিয়ে তিনি যে &lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%b9%e0%a7%81%e0%a6%ae%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a7%82%e0%a6%a8-%e0%a6%86%e0%a6%b9%e0%a6%ae%e0%a7%87%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a7%81%e0%a6%a4%e0%a6%bf%e0%a6%95/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>ছড়া</title>
      <link>https://suprobhat.com/%e0%a6%9b%e0%a6%a1%e0%a6%bc%e0%a6%be-2/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%9b%e0%a6%a1%e0%a6%bc%e0%a6%be-2/</guid>
      <pubDate>Mon, 16 Nov 2026 17:00:34 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/chora.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/chora.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/chora.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ছড়া" /&gt;&lt;/p&gt;&lt;p&gt;মাটির শেকড় জনি সিদ্দিক মাঠ রেঙেছে সোনা রঙে কাঁচা-পাকা ধানে, ঘরে ঘরে সুর ওঠে আজ মহান প্রভুর গানে। আঁকাবাঁকা মেঠো পথে দূর্বাঘাসের মেলা, খেজুরগাছে ডাকছে পাখি সারা দুপুরবেলা। চালতাগাছে চড়ুই পাখি খড়ের বাসা বোনে, নিঝুম রাতে দূর আকাশে তারাগুলো গোনে। ভোরের বেলা শিশিরফোঁটা ঘাসের বুকে হাসে, সোনার খনি মাঠ পেরি&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%9b%e0%a6%a1%e0%a6%bc%e0%a6%be-2/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>জোনাকির হারিয়ে যাওয়া আলো</title>
      <link>https://suprobhat.com/%e0%a6%9c%e0%a7%8b%e0%a6%a8%e0%a6%be%e0%a6%95%e0%a6%bf%e0%a6%b0-%e0%a6%b9%e0%a6%be%e0%a6%b0%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%af%e0%a6%be%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be-%e0%a6%86-2/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%9c%e0%a7%8b%e0%a6%a8%e0%a6%be%e0%a6%95%e0%a6%bf%e0%a6%b0-%e0%a6%b9%e0%a6%be%e0%a6%b0%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%af%e0%a6%be%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be-%e0%a6%86-2/</guid>
      <pubDate>Mon, 16 Nov 2026 16:54:12 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/jonakir-alo.jpeg" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/jonakir-alo.jpeg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/jonakir-alo.jpeg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জোনাকির হারিয়ে যাওয়া আলো" /&gt;&lt;/p&gt;&lt;p&gt;টুকটুকে গোধূলি পেরিয়ে চারপাশ যখন ঘুটঘুটে অন্ধকারে ঢেকে যায়, ঠিক তখনই প্রান্তরজুড়ে শুরু হয় এক নিভৃত আলোড়ন। ঘাসের ডগায়, বুনো ঝোপঝাড়ের আড়ালে কিংবা পাতার ফাঁকে হঠাৎ জ্বলে ওঠা বিন্দু বিন্দু হলুদ আলো দেখলে মনে হয়, আসমান থেকে বুঝি কোনো তারা খসে এসে ঘাসের বিছানায় লুকিয়ে পড়েছে। প্রকৃতির এই জাদুকরী আয়োজন আমাদ&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%9c%e0%a7%8b%e0%a6%a8%e0%a6%be%e0%a6%95%e0%a6%bf%e0%a6%b0-%e0%a6%b9%e0%a6%be%e0%a6%b0%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%af%e0%a6%be%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be-%e0%a6%86-2/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>মনে আছে লিলিপুটদের কথা?</title>
      <link>https://suprobhat.com/%e0%a6%ae%e0%a6%a8%e0%a7%87-%e0%a6%86%e0%a6%9b%e0%a7%87-%e0%a6%b2%e0%a6%bf%e0%a6%b2%e0%a6%bf%e0%a6%aa%e0%a7%81%e0%a6%9f%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a6%a5%e0%a6%be-2/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%ae%e0%a6%a8%e0%a7%87-%e0%a6%86%e0%a6%9b%e0%a7%87-%e0%a6%b2%e0%a6%bf%e0%a6%b2%e0%a6%bf%e0%a6%aa%e0%a7%81%e0%a6%9f%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a6%a5%e0%a6%be-2/</guid>
      <pubDate>Mon, 16 Nov 2026 16:52:27 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/liliput.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/liliput.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/liliput.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মনে আছে লিলিপুটদের কথা?" /&gt;&lt;/p&gt;&lt;p&gt;লিলিপুট শব্দটির সঙ্গে তোমাদের পরিচয় আছে নিশ্চয়ই! লেখক জোনাথন সুইফটের বিখ্যাত বই ‘গুলিভার্স ট্রাভেলস’ যারা পড়েছ, তারা তো নিশ্চয়ই জানো কী দারুণ গল্পটি! আর যারা এখনো পড়নি তারা পড়ে নিও, খুব মজা পাবে। সেই যে, গালিভার নামের এক লোক একদিন গিয়ে পড়ল এক আজব দেশে, যেখানকার মানুষগুলো একদমই ছোট। লম্বায় মাত্র কয়েক&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%ae%e0%a6%a8%e0%a7%87-%e0%a6%86%e0%a6%9b%e0%a7%87-%e0%a6%b2%e0%a6%bf%e0%a6%b2%e0%a6%bf%e0%a6%aa%e0%a7%81%e0%a6%9f%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a6%a5%e0%a6%be-2/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>পিকুর চোখে নতুন পৃথিবী</title>
      <link>https://suprobhat.com/%e0%a6%aa%e0%a6%bf%e0%a6%95%e0%a7%81%e0%a6%b0-%e0%a6%9a%e0%a7%8b%e0%a6%96%e0%a7%87-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%aa%e0%a7%83%e0%a6%a5%e0%a6%bf%e0%a6%ac%e0%a7%80-2/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%aa%e0%a6%bf%e0%a6%95%e0%a7%81%e0%a6%b0-%e0%a6%9a%e0%a7%8b%e0%a6%96%e0%a7%87-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%aa%e0%a7%83%e0%a6%a5%e0%a6%bf%e0%a6%ac%e0%a7%80-2/</guid>
      <pubDate>Mon, 16 Nov 2026 16:47:03 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/piku.jpg" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/piku.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/piku.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পিকুর চোখে নতুন পৃথিবী" /&gt;&lt;/p&gt;&lt;p&gt;পিকু এক ডিভাইসের ছেলে। কিন্তু বর্তমানে তার জগৎটা আটকে গেছে কম্পিউটারের রঙিন স্ক্রিনের ভেতর। সকালের নাশতা থেকে শুরু করে রাতের খাবার, সবসময় তার চোখের সামনে কম্পিউটার অথবা মোবাইল ফোন থাকা চাই। অনলাইনে গেম খেলা আর কার্টুন দেখাই এখন তার একমাত্র কাজ। মা-বাবা ডাকলে সে বিরক্ত হয়। আর বিকেলে বন্ধুরা মাঠে খেলত&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%aa%e0%a6%bf%e0%a6%95%e0%a7%81%e0%a6%b0-%e0%a6%9a%e0%a7%8b%e0%a6%96%e0%a7%87-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%aa%e0%a7%83%e0%a6%a5%e0%a6%bf%e0%a6%ac%e0%a7%80-2/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>চট্টগ্রাম থেকে কেরানীগঞ্জ কারাগারে চিন্ময়</title>
      <link>https://suprobhat.com/%e0%a6%9a%e0%a6%9f%e0%a7%8d%e0%a6%9f%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ae-%e0%a6%a5%e0%a7%87%e0%a6%95%e0%a7%87-%e0%a6%95%e0%a7%87%e0%a6%b0%e0%a6%be%e0%a6%a8%e0%a7%80%e0%a6%97%e0%a6%9e%e0%a7%8d/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%9a%e0%a6%9f%e0%a7%8d%e0%a6%9f%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ae-%e0%a6%a5%e0%a7%87%e0%a6%95%e0%a7%87-%e0%a6%95%e0%a7%87%e0%a6%b0%e0%a6%be%e0%a6%a8%e0%a7%80%e0%a6%97%e0%a6%9e%e0%a7%8d/</guid>
      <pubDate>Mon, 16 Nov 2026 12:47:52 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/Chinmoy-das.jpg" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/Chinmoy-das.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/Chinmoy-das.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চট্টগ্রাম থেকে কেরানীগঞ্জ কারাগারে চিন্ময়" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রামের আদালতে ছয়টি মামলা চলার মধ্যেই কারাবন্দি চিন্ময় কৃষ্ণ দাস ব্রহ্মচারীকে ঢাকার কেরানীগঞ্জে বিশেষ কেন্দ্রীয় কারাগারে স্থানান্তর করা হয়েছে। সোমবার ভোরে তাঁকে চট্টগ্রাম কেন্দ্রীয় কারাগার থেকে কেরানীগঞ্জে নেওয়া হয়। তবে কী কারণে তাঁকে স্থানান্তর করা হয়েছে, তা স্পষ্ট করেনি কারা কর্তৃপক্ষ। চট্টগ্র&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%9a%e0%a6%9f%e0%a7%8d%e0%a6%9f%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ae-%e0%a6%a5%e0%a7%87%e0%a6%95%e0%a7%87-%e0%a6%95%e0%a7%87%e0%a6%b0%e0%a6%be%e0%a6%a8%e0%a7%80%e0%a6%97%e0%a6%9e%e0%a7%8d/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>১০ মাস ধরে ২০ লাখ টাকা চাঁদা দাবি, বাড়িতে গুলি ছুড়ে হুমকি ‘কাফনের কাপড় কিনে রাখিস’</title>
      <link>https://suprobhat.com/%e0%a7%a7%e0%a7%a6-%e0%a6%ae%e0%a6%be%e0%a6%b8-%e0%a6%a7%e0%a6%b0%e0%a7%87-%e0%a7%a8%e0%a7%a6-%e0%a6%b2%e0%a6%be%e0%a6%96-%e0%a6%9f%e0%a6%be%e0%a6%95%e0%a6%be-%e0%a6%9a%e0%a6%be%e0%a6%81%e0%a6%a6/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a7%a7%e0%a7%a6-%e0%a6%ae%e0%a6%be%e0%a6%b8-%e0%a6%a7%e0%a6%b0%e0%a7%87-%e0%a7%a8%e0%a7%a6-%e0%a6%b2%e0%a6%be%e0%a6%96-%e0%a6%9f%e0%a6%be%e0%a6%95%e0%a6%be-%e0%a6%9a%e0%a6%be%e0%a6%81%e0%a6%a6/</guid>
      <pubDate>Mon, 16 Nov 2026 09:54:55 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/bayezid.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/bayezid.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/bayezid.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="১০ মাস ধরে ২০ লাখ টাকা চাঁদা দাবি, বাড়িতে গুলি ছুড়ে হুমকি ‘কাফনের কাপড় কিনে রাখিস’" /&gt;&lt;/p&gt;&lt;p&gt;১০ মাস ধরে ফোনে ২০ লাখ টাকা চাঁদা দাবি করা হচ্ছিল ভূমি ব্যবসায়ী জাফর আহমদের কাছে। দাবি পূরণ না করায় এবার তার বাড়ি লক্ষ্য করে গুলি ছুড়েছে দুর্বৃত্তরা। এরপর আবার ফোন করে প্রাণনাশের হুমকি দেওয়া হয়েছে। বলা হয়েছে, ‘আজ বিল্ডিংয়ে গুলি করেছি, কাল তোর শরীরে করব, কাফনের কাপড় কিনে রাখিস।’ রোববার দিবাগত রাত ১২ট&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a7%a7%e0%a7%a6-%e0%a6%ae%e0%a6%be%e0%a6%b8-%e0%a6%a7%e0%a6%b0%e0%a7%87-%e0%a7%a8%e0%a7%a6-%e0%a6%b2%e0%a6%be%e0%a6%96-%e0%a6%9f%e0%a6%be%e0%a6%95%e0%a6%be-%e0%a6%9a%e0%a6%be%e0%a6%81%e0%a6%a6/">Suprobhat Bangladesh</source>
    </item>

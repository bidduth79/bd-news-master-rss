    <item>
      <title>বাকলিয়া রেসিডেন্সিয়াল মডেল স্কুলে রোবটিক্স কর্মশালা</title>
      <link>https://suprobhat.com/%e0%a6%ac%e0%a6%be%e0%a6%95%e0%a6%b2%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be-%e0%a6%b0%e0%a7%87%e0%a6%b8%e0%a6%bf%e0%a6%a1%e0%a7%87%e0%a6%a8%e0%a7%8d%e0%a6%b8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b2/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%ac%e0%a6%be%e0%a6%95%e0%a6%b2%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be-%e0%a6%b0%e0%a7%87%e0%a6%b8%e0%a6%bf%e0%a6%a1%e0%a7%87%e0%a6%a8%e0%a7%8d%e0%a6%b8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b2/</guid>
      <pubDate>Tue, 17 Nov 2026 08:59:35 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/bakalia-residential-school-robotix.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/bakalia-residential-school-robotix.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/bakalia-residential-school-robotix.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাকলিয়া রেসিডেন্সিয়াল মডেল স্কুলে রোবটিক্স কর্মশালা" /&gt;&lt;/p&gt;&lt;p&gt;বাকলিয়া রেসিডেন্সিয়াল মডেল স্কুলে শিক্ষার্থীদের প্রযুক্তিনির্ভর জ্ঞান ও উদ্ভাবনী দক্ষতা বিকাশে দিনব্যাপী রোবটিক্স কর্মশালা অনুষ্ঠিত হয়েছে। ‘এবিসি অব স্কুল রোবটিক্স’ শীর্ষক এ কর্মশালায় বিদ্যালয়ের তিন শতাধিক শিক্ষার্থী অংশ নেয়। মঙ্গলবার (১৭ নভেম্বর) সকাল ৯টায় বিদ্যালয় প্রাঙ্গণে কর্মশালার কার্যক্রম শুর&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%ac%e0%a6%be%e0%a6%95%e0%a6%b2%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be-%e0%a6%b0%e0%a7%87%e0%a6%b8%e0%a6%bf%e0%a6%a1%e0%a7%87%e0%a6%a8%e0%a7%8d%e0%a6%b8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b2/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>ফটিকছড়িতে অবৈধ বালু উত্তোলন, ড্রেজারসহ ২ হাজার ঘনফুট বালু জব্দ</title>
      <link>https://suprobhat.com/%e0%a6%ab%e0%a6%9f%e0%a6%bf%e0%a6%95%e0%a6%9b%e0%a6%a1%e0%a6%bc%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%85%e0%a6%ac%e0%a7%88%e0%a6%a7-%e0%a6%ac%e0%a6%be%e0%a6%b2%e0%a7%81-%e0%a6%89%e0%a6%a4%e0%a7%8d/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%ab%e0%a6%9f%e0%a6%bf%e0%a6%95%e0%a6%9b%e0%a6%a1%e0%a6%bc%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%85%e0%a6%ac%e0%a7%88%e0%a6%a7-%e0%a6%ac%e0%a6%be%e0%a6%b2%e0%a7%81-%e0%a6%89%e0%a6%a4%e0%a7%8d/</guid>
      <pubDate>Tue, 17 Nov 2026 08:48:36 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/fatikchari-mobile-court.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/fatikchari-mobile-court.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/fatikchari-mobile-court.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফটিকছড়িতে অবৈধ বালু উত্তোলন, ড্রেজারসহ ২ হাজার ঘনফুট বালু জব্দ" /&gt;&lt;/p&gt;&lt;p&gt;ফটিকছড়িতে অবৈধভাবে বালু উত্তোলনের বিরুদ্ধে অভিযান চালিয়ে একটি ড্রেজার, ২২টি পাইপ ও প্রায় ২ হাজার ঘনফুট বালু জব্দ করেছে উপজেলা প্রশাসন। মঙ্গলবার (১৭ নভেম্বর) দুপুর ১২টা থেকে ২টা পর্যন্ত উপজেলার লেলাং ইউনিয়নের ১ নম্বর ওয়ার্ডের কর্ণফুলী চা বাগানের কুতুবছড়ি ডিভিশনের কুতুবছড়ি ছড়ায় এ অভিযান পরিচালনা করা হ&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%ab%e0%a6%9f%e0%a6%bf%e0%a6%95%e0%a6%9b%e0%a6%a1%e0%a6%bc%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%85%e0%a6%ac%e0%a7%88%e0%a6%a7-%e0%a6%ac%e0%a6%be%e0%a6%b2%e0%a7%81-%e0%a6%89%e0%a6%a4%e0%a7%8d/">Suprobhat Bangladesh</source>

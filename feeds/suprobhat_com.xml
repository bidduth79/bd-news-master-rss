      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/lighter-ship-ctg-port.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/lighter-ship-ctg-port.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/lighter-ship-ctg-port.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রমজানের পণ্য বহির্নোঙরে, লাইটার সংকটে বাড়ছে খরচের বোঝা" /&gt;&lt;/p&gt;&lt;p&gt;জাহাজে পণ্য আছে, ক্রেতাও প্রস্তুত। কিন্তু মাদার ভেসেল থেকে সেই পণ্য ছোট জাহাজে তুলে বন্দরে আনা যাচ্ছে না সময়মতো। চট্টগ্রাম বন্দরের বহির্নোঙরে লাইটার জাহাজের সংকটে আটকে আছে রমজান সামনে রেখে আমদানি করা খাদ্যপণ্য। এতে একদিকে মাদার ভেসেলকে দিনের পর দিন অপেক্ষা করতে হচ্ছে, অন্যদিকে বাড়ছে আমদানিকারকদের ব্&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%b0%e0%a6%ae%e0%a6%9c%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a6%a3%e0%a7%8d%e0%a6%af-%e0%a6%ac%e0%a6%b9%e0%a6%bf%e0%a6%b0%e0%a7%8d%e0%a6%a8%e0%a7%8b%e0%a6%99%e0%a6%b0%e0%a7%87/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>ছেলের জন্য পাত্রী দেখে ফেরা হলো না, মিরসরাইয়ে সিএনজি অটোরিকশা খালে পড়ে বাবার মৃত্যু</title>
      <link>https://suprobhat.com/%e0%a6%9b%e0%a7%87%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a6%9c%e0%a6%a8%e0%a7%8d%e0%a6%af-%e0%a6%aa%e0%a6%be%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a7%80-%e0%a6%a6%e0%a7%87%e0%a6%96%e0%a7%87-%e0%a6%ab%e0%a7%87/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%9b%e0%a7%87%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a6%9c%e0%a6%a8%e0%a7%8d%e0%a6%af-%e0%a6%aa%e0%a6%be%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a7%80-%e0%a6%a6%e0%a7%87%e0%a6%96%e0%a7%87-%e0%a6%ab%e0%a7%87/</guid>
      <pubDate>Sat, 28 Nov 2026 07:03:05 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/mirsoray-accident.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/mirsoray-accident.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/mirsoray-accident.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ছেলের জন্য পাত্রী দেখে ফেরা হলো না, মিরসরাইয়ে সিএনজি অটোরিকশা খালে পড়ে বাবার মৃত্যু" /&gt;&lt;/p&gt;&lt;p&gt;ছেলের বিয়ের জন্য পাত্রী দেখে পরিবারের সদস্যদের নিয়ে বাড়ি ফিরছিলেন হেলাল উদ্দিন (৫০)। কিন্তু বাড়ি পৌঁছানোর আগেই নিয়ন্ত্রণ হারিয়ে তাদের বহনকারী অটোরিকশাটি পড়ে যায় খালে। এতে অটোরিকশার নিচে চাপা পড়ে প্রাণ হারান হেলাল। আহত হন তাঁর পরিবারের আরও চার সদস্য। শুক্রবার বিকেল ৪টার দিকে চট্টগ্রামের মিরসরাই উপজেল&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%9b%e0%a7%87%e0%a6%b2%e0%a7%87%e0%a6%b0-%e0%a6%9c%e0%a6%a8%e0%a7%8d%e0%a6%af-%e0%a6%aa%e0%a6%be%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a7%80-%e0%a6%a6%e0%a7%87%e0%a6%96%e0%a7%87-%e0%a6%ab%e0%a7%87/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>টেকনাফে গুলিবিদ্ধ হাতি আবার লোকালয়ে, ঢুকল বসতঘরে</title>
      <link>https://suprobhat.com/%e0%a6%9f%e0%a7%87%e0%a6%95%e0%a6%a8%e0%a6%be%e0%a6%ab%e0%a7%87-%e0%a6%97%e0%a7%81%e0%a6%b2%e0%a6%bf%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%a7-%e0%a6%b9%e0%a6%be%e0%a6%a4%e0%a6%bf-%e0%a6%86/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%9f%e0%a7%87%e0%a6%95%e0%a6%a8%e0%a6%be%e0%a6%ab%e0%a7%87-%e0%a6%97%e0%a7%81%e0%a6%b2%e0%a6%bf%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%a7-%e0%a6%b9%e0%a6%be%e0%a6%a4%e0%a6%bf-%e0%a6%86/</guid>
      <pubDate>Sat, 28 Nov 2026 06:48:43 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/Teknaf-elephant.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/Teknaf-elephant.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/Teknaf-elephant.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টেকনাফে গুলিবিদ্ধ হাতি আবার লোকালয়ে, ঢুকল বসতঘরে" /&gt;&lt;/p&gt;&lt;p&gt;কক্সবাজারের টেকনাফে গুলিবিদ্ধ বন্য হাতিটি আবারও লোকালয়ে ফিরে একটি বসতঘরে ঢুকে পড়েছে। শনিবার সকালে বাহারছড়া ইউনিয়নের হলবনিয়া গ্রামে এ ঘটনা ঘটে। পরে বন বিভাগ ও এলিফ্যান্ট রেসপন্স টিমের (ইআরটি) সদস্যরা হাতিটিকে বনে ফেরানোর চেষ্টা শুরু করেন। স্থানীয় বাসিন্দা নজরুল ইসলাম বলেন, শনিবার সকালে শীলখালী রেঞ্জে&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%9f%e0%a7%87%e0%a6%95%e0%a6%a8%e0%a6%be%e0%a6%ab%e0%a7%87-%e0%a6%97%e0%a7%81%e0%a6%b2%e0%a6%bf%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%a7-%e0%a6%b9%e0%a6%be%e0%a6%a4%e0%a6%bf-%e0%a6%86/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>ইউসিটিসিতে নবীনদের বরণ, গ্র্যাজুয়েটদের বিদায়</title>
      <link>https://suprobhat.com/%e0%a6%87%e0%a6%89%e0%a6%b8%e0%a6%bf%e0%a6%9f%e0%a6%bf%e0%a6%b8%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%a8%e0%a6%ac%e0%a7%80%e0%a6%a8%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%ac%e0%a6%b0%e0%a6%a3-%e0%a6%97/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%87%e0%a6%89%e0%a6%b8%e0%a6%bf%e0%a6%9f%e0%a6%bf%e0%a6%b8%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%a8%e0%a6%ac%e0%a7%80%e0%a6%a8%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%ac%e0%a6%b0%e0%a6%a3-%e0%a6%97/</guid>
      <pubDate>Sat, 28 Nov 2026 06:21:17 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/uctc-freshers-orientation-graduates-farewell-autumn-2026.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/uctc-freshers-orientation-graduates-farewell-autumn-2026.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/uctc-freshers-orientation-graduates-farewell-autumn-2026.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইউসিটিসিতে নবীনদের বরণ, গ্র্যাজুয়েটদের বিদায়" /&gt;&lt;/p&gt;&lt;p&gt;নতুন শিক্ষার্থীদের বরণ আর গ্র্যাজুয়েটদের বিদায়ের মধ্য দিয়ে চট্টগ্রামের ইউনিভার্সিটি অব ক্রিয়েটিভ টেকনোলজি চিটাগংয়ে (ইউসিটিসি) অনুষ্ঠিত হয়েছে অটাম ২০২৬ সেশনের ফ্রেশার্স ওরিয়েন্টেশন ও গ্র্যাজুয়েটদের বিদায় অনুষ্ঠান। শুক্রবার (২৭ নভেম্বর) নগরের জিইসি কনভেনশন সেন্টারে দিনব্যাপী এ অনুষ্ঠানে নবীন ও গ্র্যাজ&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%87%e0%a6%89%e0%a6%b8%e0%a6%bf%e0%a6%9f%e0%a6%bf%e0%a6%b8%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%a8%e0%a6%ac%e0%a7%80%e0%a6%a8%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%ac%e0%a6%b0%e0%a6%a3-%e0%a6%97/">Suprobhat Bangladesh</source>
    </item>

      <pubDate>Sat, 21 Nov 2026 07:59:36 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/pujarir-beshe-mondire-chain-churi-chandgaon-chattogram.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/pujarir-beshe-mondire-chain-churi-chandgaon-chattogram.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/pujarir-beshe-mondire-chain-churi-chandgaon-chattogram.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চান্দগাঁওয়ে পূজারির বেশে মন্দিরে ঢুকে স্বর্ণ চুরি, সিসিটিভিতে ধরা দুই নারী" /&gt;&lt;/p&gt;&lt;p&gt;নগরের চান্দগাঁওয়ে মন্দিরে পূজারির বেশে ঢুকে ভিড়ের মধ্যে দুই নারীর গলা থেকে স্বর্ণের চেইন চুরির অভিযোগে দুজনকে গ্রেপ্তার করেছে পুলিশ। গত ২০ নভেম্বর দুপুরে মধ্যম মোহরার ছাফা মোতালেব কলেজ রোডের শ্রীশ্রী রাধা-গোবিন্দ ইসকন মন্দিরে অন্নকূট অনুষ্ঠানে এ ঘটনা ঘটে। মন্দিরের সিসিটিভি ফুটেজ পর্যালোচনা করে দুই ন&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%9a%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%97%e0%a6%be%e0%a6%81%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%aa%e0%a7%82%e0%a6%9c%e0%a6%be%e0%a6%b0%e0%a6%bf%e0%a6%b0-%e0%a6%ac%e0%a7%87%e0%a6%b6/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>পুতিনকে ‘বন্ধু’ বলায় ট্রাম্পকে জবাব দিলেন জেলেনস্কি</title>
      <link>https://suprobhat.com/%e0%a6%aa%e0%a7%81%e0%a6%a4%e0%a6%bf%e0%a6%a8%e0%a6%95%e0%a7%87-%e0%a6%ac%e0%a6%a8%e0%a7%8d%e0%a6%a7%e0%a7%81-%e0%a6%ac%e0%a6%b2%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%9f%e0%a7%8d/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%aa%e0%a7%81%e0%a6%a4%e0%a6%bf%e0%a6%a8%e0%a6%95%e0%a7%87-%e0%a6%ac%e0%a6%a8%e0%a7%8d%e0%a6%a7%e0%a7%81-%e0%a6%ac%e0%a6%b2%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%9f%e0%a7%8d/</guid>
      <pubDate>Sat, 21 Nov 2026 07:12:38 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/Zelensky.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/Zelensky.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/Zelensky.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পুতিনকে ‘বন্ধু’ বলায় ট্রাম্পকে জবাব দিলেন জেলেনস্কি" /&gt;&lt;/p&gt;&lt;p&gt;রাশিয়ার প্রেসিডেন্ট ভ্লাদিমির পুতিনকে ‘খুনি’ ও ‘শত্রু’ বলে অভিহিত করেছেন ইউক্রেনের প্রেসিডেন্ট ভলোদিমির জেলেনস্কি। চীনে পুতিনকে মার্কিন প্রেসিডেন্ট ডোনাল্ড ট্রাম্প ‘বন্ধু’ বলে সম্বোধন করার প্রতিক্রিয়ায় এ মন্তব্য করেন তিনি। সিএনএনকে দেওয়া এক সাক্ষাৎকারে জেলেনস্কি বলেন, পুতিনকে কীভাবে সম্বোধন করবেন, স&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%aa%e0%a7%81%e0%a6%a4%e0%a6%bf%e0%a6%a8%e0%a6%95%e0%a7%87-%e0%a6%ac%e0%a6%a8%e0%a7%8d%e0%a6%a7%e0%a7%81-%e0%a6%ac%e0%a6%b2%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%9f%e0%a7%8d/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>দুর্নীতির পাশাপাশি প্রাতিষ্ঠানিক হয়রানিও অর্থনীতির বাধা</title>
      <link>https://suprobhat.com/%e0%a6%a6%e0%a7%81%e0%a6%b0%e0%a7%8d%e0%a6%a8%e0%a7%80%e0%a6%a4%e0%a6%bf%e0%a6%b0-%e0%a6%aa%e0%a6%be%e0%a6%b6%e0%a6%be%e0%a6%aa%e0%a6%be%e0%a6%b6%e0%a6%bf-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%a4/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%a6%e0%a7%81%e0%a6%b0%e0%a7%8d%e0%a6%a8%e0%a7%80%e0%a6%a4%e0%a6%bf%e0%a6%b0-%e0%a6%aa%e0%a6%be%e0%a6%b6%e0%a6%be%e0%a6%aa%e0%a6%be%e0%a6%b6%e0%a6%bf-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%a4/</guid>
      <pubDate>Sat, 21 Nov 2026 06:50:05 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/amir-mohammad-kharu.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/amir-mohammad-kharu.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/amir-mohammad-kharu.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দুর্নীতির পাশাপাশি প্রাতিষ্ঠানিক হয়রানিও অর্থনীতির বাধা" /&gt;&lt;/p&gt;&lt;p&gt;ঘুষের খাতা খোলা যায়, কিন্তু হয়রানির কোনো খাতা খোলা যায় না। একজন উদ্যোক্তা মোটামুটি জানেন, কোন দপ্তরে কত টাকা দিলে ফাইল নড়ে। কিন্তু তিনি জানেন না, সব নিয়ম মেনে আবেদন করার পরও ফাইলটি কবে নড়বে, নাকি আদৌ নড়বে কি না। এই অনিশ্চয়তা দুর্নীতির চেয়ে কম আলোচিত হতে পারে, কিন্তু অর্থনীতির জন্য তা কম ক্ষত&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%a6%e0%a7%81%e0%a6%b0%e0%a7%8d%e0%a6%a8%e0%a7%80%e0%a6%a4%e0%a6%bf%e0%a6%b0-%e0%a6%aa%e0%a6%be%e0%a6%b6%e0%a6%be%e0%a6%aa%e0%a6%be%e0%a6%b6%e0%a6%bf-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%a4/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>ট্রলারে টেকনাফ ফিরছেন সেন্টমার্টিনে আটকে পড়া পর্যটকরা</title>
      <link>https://suprobhat.com/%e0%a6%9f%e0%a7%8d%e0%a6%b0%e0%a6%b2%e0%a6%be%e0%a6%b0%e0%a7%87-%e0%a6%9f%e0%a7%87%e0%a6%95%e0%a6%a8%e0%a6%be%e0%a6%ab-%e0%a6%ab%e0%a6%bf%e0%a6%b0%e0%a6%9b%e0%a7%87%e0%a6%a8-%e0%a6%b8%e0%a7%87/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%9f%e0%a7%8d%e0%a6%b0%e0%a6%b2%e0%a6%be%e0%a6%b0%e0%a7%87-%e0%a6%9f%e0%a7%87%e0%a6%95%e0%a6%a8%e0%a6%be%e0%a6%ab-%e0%a6%ab%e0%a6%bf%e0%a6%b0%e0%a6%9b%e0%a7%87%e0%a6%a8-%e0%a6%b8%e0%a7%87/</guid>
      <pubDate>Sat, 21 Nov 2026 06:11:09 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/Teknaf-.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/Teknaf-.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/Teknaf-.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ট্রলারে টেকনাফ ফিরছেন সেন্টমার্টিনে আটকে পড়া পর্যটকরা" /&gt;&lt;/p&gt;&lt;p&gt;বৈরী আবহাওয়ার কারণে সেন্টমার্টিন দ্বীপে আটকে পড়া পর্যটকরা ট্রলারে করে টেকনাফে ফিরতে শুরু করেছেন। শনিবার (২১ নভেম্বর) সকালে দ্বীপের জেটিঘাট থেকে পাঁচটি ট্রলারে করে পর্যটকদের একটি অংশ টেকনাফের উদ্দেশে রওনা হন। জানা গেছে, বৈরী আবহাওয়ায় সাগর উত্তাল থাকায় এবং সতর্কসংকেত জারি হওয়ায় ১৯ নভেম্বর থেকে সেন্টমা&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%9f%e0%a7%8d%e0%a6%b0%e0%a6%b2%e0%a6%be%e0%a6%b0%e0%a7%87-%e0%a6%9f%e0%a7%87%e0%a6%95%e0%a6%a8%e0%a6%be%e0%a6%ab-%e0%a6%ab%e0%a6%bf%e0%a6%b0%e0%a6%9b%e0%a7%87%e0%a6%a8-%e0%a6%b8%e0%a7%87/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>সাউদার্ন ইউনিভার্সিটিতে ইংলিশ লিটারেরি ফেস্ট ৩.০ অনুষ্ঠিত</title>
      <link>https://suprobhat.com/%e0%a6%b8%e0%a6%be%e0%a6%89%e0%a6%a6%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%a8-%e0%a6%87%e0%a6%89%e0%a6%a8%e0%a6%bf%e0%a6%ad%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%b8%e0%a6%bf%e0%a6%9f%e0%a6%bf%e0%a6%a4-4/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%b8%e0%a6%be%e0%a6%89%e0%a6%a6%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%a8-%e0%a6%87%e0%a6%89%e0%a6%a8%e0%a6%bf%e0%a6%ad%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%b8%e0%a6%bf%e0%a6%9f%e0%a6%bf%e0%a6%a4-4/</guid>
      <pubDate>Sat, 21 Nov 2026 05:39:11 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/southern-university.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/southern-university.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/southern-university.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাউদার্ন ইউনিভার্সিটিতে ইংলিশ লিটারেরি ফেস্ট ৩.০ অনুষ্ঠিত" /&gt;&lt;/p&gt;&lt;p&gt;সাউদার্ন ইউনিভার্সিটি বাংলাদেশে ইংরেজি বিভাগের উদ্যোগে এবং কেডিএস গ্রুপের সহযোগিতায় অনুষ্ঠিত হয়েছে ‘ইংলিশ লিটারেরি ফেস্ট ৩.০’। বৃহস্পতিবার বিশ্ববিদ্যালয়ের আরেফিন নগর ক্যাম্পাসে দিনব্যাপী নানা আয়োজনের মধ্য দিয়ে এ উৎসব সম্পন্ন হয়। ইংরেজি বিভাগের বিভাগীয় প্রধান আরমান হোসেনের সভাপতিত্বে আয়োজিত অনুষ্ঠানে&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%b8%e0%a6%be%e0%a6%89%e0%a6%a6%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%a8-%e0%a6%87%e0%a6%89%e0%a6%a8%e0%a6%bf%e0%a6%ad%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%b8%e0%a6%bf%e0%a6%9f%e0%a6%bf%e0%a6%a4-4/">Suprobhat Bangladesh</source>

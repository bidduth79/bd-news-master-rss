      <pubDate>Tue, 17 Nov 2026 09:42:41 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/jum-khagrachari.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/jum-khagrachari.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/jum-khagrachari.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জুম কৃষির রাষ্ট্রীয় স্বীকৃতি ও জলবায়ু তহবিলে অনুদান চান পাহাড়ের নারী চাষিরা" /&gt;&lt;/p&gt;&lt;p&gt;খাগড়াছড়িতে নারী চাষীদের সমাবেশ থেকে জুম কৃষির রাষ্ট্রীয় স্বীকৃতি, ক্ষতিগ্রস্ত কৃষকদের পুনর্বাসন এবং জলবায়ু অর্থায়নে ঋণের পরিবর্তে অনুদান নিশ্চিত করার দাবি জানানো হয়েছে। মঙ্গলবার (১৭ নভেম্বর) সকালে খাগড়াছড়ির ক্ষুদ্র নৃ-গোষ্ঠীর সাংস্কৃতিক ইনস্টিটিউট প্রাঙ্গণে ‘কৃষি উৎপাদনে নারীর সংগ্রাম: জলবায়ু ন্যায়ব&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%9c%e0%a7%81%e0%a6%ae-%e0%a6%95%e0%a7%83%e0%a6%b7%e0%a6%bf%e0%a6%b0-%e0%a6%b0%e0%a6%be%e0%a6%b7%e0%a7%8d%e0%a6%9f%e0%a7%8d%e0%a6%b0%e0%a7%80%e0%a6%af%e0%a6%bc-%e0%a6%b8%e0%a7%8d%e0%a6%ac/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>চন্দনাইশে ইউসিবির আর্থিক সাক্ষরতা দিবস পালন</title>
      <link>https://suprobhat.com/%e0%a6%9a%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%a8%e0%a6%be%e0%a6%87%e0%a6%b6%e0%a7%87-%e0%a6%87%e0%a6%89%e0%a6%b8%e0%a6%bf%e0%a6%ac%e0%a6%bf%e0%a6%b0-%e0%a6%86%e0%a6%b0%e0%a7%8d%e0%a6%a5%e0%a6%bf%e0%a6%95/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%9a%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%a8%e0%a6%be%e0%a6%87%e0%a6%b6%e0%a7%87-%e0%a6%87%e0%a6%89%e0%a6%b8%e0%a6%bf%e0%a6%ac%e0%a6%bf%e0%a6%b0-%e0%a6%86%e0%a6%b0%e0%a7%8d%e0%a6%a5%e0%a6%bf%e0%a6%95/</guid>
      <pubDate>Tue, 17 Nov 2026 09:39:18 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/Ucb.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/Ucb.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/Ucb.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চন্দনাইশে ইউসিবির আর্থিক সাক্ষরতা দিবস পালন" /&gt;&lt;/p&gt;&lt;p&gt;সঞ্চয়, ডিজিটাল নিরাপত্তা ও বৈধ পথে রেমিট্যান্স পাঠানোর বিষয়ে সচেতনতা বাড়াতে চট্টগ্রামের চন্দনাইশে আর্থিক সাক্ষরতা দিবস পালন করেছে ইউনাইটেড কমার্শিয়াল ব্যাংক (ইউসিবি) পিএলসি। ২০২৬ সালের আর্থিক সাক্ষরতা দিবস উপলক্ষে ইউসিবির চন্দনাইশ শাখার উদ্যোগে আয়োজিত মতবিনিময় সভায় গ্রাহক, স্থানীয় ব্যবসায়ী, এনজিও প্&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%9a%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%a8%e0%a6%be%e0%a6%87%e0%a6%b6%e0%a7%87-%e0%a6%87%e0%a6%89%e0%a6%b8%e0%a6%bf%e0%a6%ac%e0%a6%bf%e0%a6%b0-%e0%a6%86%e0%a6%b0%e0%a7%8d%e0%a6%a5%e0%a6%bf%e0%a6%95/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>পরিবেশ দূষণকারী কারখানা চালু থাকে কীভাবে</title>
      <link>https://suprobhat.com/%e0%a6%aa%e0%a6%b0%e0%a6%bf%e0%a6%ac%e0%a7%87%e0%a6%b6-%e0%a6%a6%e0%a7%82%e0%a6%b7%e0%a6%a3%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a7%80-%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%96%e0%a6%be%e0%a6%a8%e0%a6%be/</link>

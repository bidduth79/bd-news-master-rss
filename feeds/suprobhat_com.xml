    </item>
    <item>
      <title>২৭৬ কোটির ঋণখেলাপি, সাবেক ভূমিমন্ত্রী জাবেদ-স্ত্রীসহ ছয়জনের কারাদণ্ড</title>
      <link>https://suprobhat.com/%e0%a7%a8%e0%a7%ad%e0%a7%ac-%e0%a6%95%e0%a7%8b%e0%a6%9f%e0%a6%bf%e0%a6%b0-%e0%a6%8b%e0%a6%a3%e0%a6%96%e0%a7%87%e0%a6%b2%e0%a6%be%e0%a6%aa%e0%a6%bf-%e0%a6%b8%e0%a6%be%e0%a6%ac%e0%a7%87%e0%a6%95/</link>

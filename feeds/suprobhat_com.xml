    <item>
      <title>হুলাইন ছালেহ নূর ডিগ্রি কলেজে জাতীয় বিপ্লব ও সংহতি দিবসের আলোচনা সভা</title>
      <link>https://suprobhat.com/%e0%a6%b9%e0%a7%81%e0%a6%b2%e0%a6%be%e0%a6%87%e0%a6%a8-%e0%a6%9b%e0%a6%be%e0%a6%b2%e0%a7%87%e0%a6%b9-%e0%a6%a8%e0%a7%82%e0%a6%b0-%e0%a6%a1%e0%a6%bf%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%bf-%e0%a6%95/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%b9%e0%a7%81%e0%a6%b2%e0%a6%be%e0%a6%87%e0%a6%a8-%e0%a6%9b%e0%a6%be%e0%a6%b2%e0%a7%87%e0%a6%b9-%e0%a6%a8%e0%a7%82%e0%a6%b0-%e0%a6%a1%e0%a6%bf%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%bf-%e0%a6%95/</guid>
      <pubDate>Mon, 09 Nov 2026 11:44:07 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/Patiya-hulaine-college.jpg" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/Patiya-hulaine-college.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/Patiya-hulaine-college.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হুলাইন ছালেহ নূর ডিগ্রি কলেজে জাতীয় বিপ্লব ও সংহতি দিবসের আলোচনা সভা" /&gt;&lt;/p&gt;&lt;p&gt;পটিয়ার হুলাইন ছালেহ নূর ডিগ্রি কলেজে জাতীয় বিপ্লব ও সংহতি দিবস উপলক্ষে আলোচনা সভা অনুষ্ঠিত হয়েছে। শনিবার (৭ নভেম্বর) কলেজ অডিটোরিয়ামে কলেজের অধ্যক্ষ এন এম ফখরুদ্দীনের সভাপতিত্বে এ সভায় অনুষ্ঠিত হয়। বাংলা বিভাগের প্রভাষক মোহাম্মদ জোনাইদের সঞ্চালনায় এতে বক্তব্য রাখেন ইংরেজি বিভাগের প্রভাষক আ. জ. ম. ওব&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%b9%e0%a7%81%e0%a6%b2%e0%a6%be%e0%a6%87%e0%a6%a8-%e0%a6%9b%e0%a6%be%e0%a6%b2%e0%a7%87%e0%a6%b9-%e0%a6%a8%e0%a7%82%e0%a6%b0-%e0%a6%a1%e0%a6%bf%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%bf-%e0%a6%95/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>আইআইইউসিতে আন্তর্জাতিক সম্মেলন উদ্বোধন</title>
      <link>https://suprobhat.com/%e0%a6%86%e0%a6%87%e0%a6%86%e0%a6%87%e0%a6%87%e0%a6%89%e0%a6%b8%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%86%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a6%b0%e0%a7%8d%e0%a6%9c%e0%a6%be%e0%a6%a4%e0%a6%bf%e0%a6%95-%e0%a6%b8/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%86%e0%a6%87%e0%a6%86%e0%a6%87%e0%a6%87%e0%a6%89%e0%a6%b8%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%86%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a6%b0%e0%a7%8d%e0%a6%9c%e0%a6%be%e0%a6%a4%e0%a6%bf%e0%a6%95-%e0%a6%b8/</guid>
      <pubDate>Mon, 09 Nov 2026 09:25:16 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/IIUC-2.jpg" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/IIUC-2.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/IIUC-2.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আইআইইউসিতে আন্তর্জাতিক সম্মেলন উদ্বোধন" /&gt;&lt;/p&gt;&lt;p&gt;বিশ্ববিদ্যালয়ের গবেষণাকে শিল্পপ্রতিষ্ঠানের বাস্তব সমস্যার সমাধানে কাজে লাগানোর আহ্বান জানিয়েছেন বাংলাদেশ বিশ্ববিদ্যালয় মঞ্জুরি কমিশনের (ইউজিসি) চেয়ারম্যান অধ্যাপক ড. মামুন আহমেদ। রোববার সকালে আন্তর্জাতিক ইসলামী বিশ্ববিদ্যালয় চট্টগ্রামের (আইআইইউসি) বিজ্ঞান ও প্রকৌশল অনুষদ এবং গবেষণা ও প্রকাশনা কেন্দ্&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%86%e0%a6%87%e0%a6%86%e0%a6%87%e0%a6%87%e0%a6%89%e0%a6%b8%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%86%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a6%b0%e0%a7%8d%e0%a6%9c%e0%a6%be%e0%a6%a4%e0%a6%bf%e0%a6%95-%e0%a6%b8/">Suprobhat Bangladesh</source>
    </item>

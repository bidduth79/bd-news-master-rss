      <pubDate>Fri, 27 Nov 2026 11:04:28 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/chattogram-chhatra-league-flash-march-20-arrested.jpg.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/chattogram-chhatra-league-flash-march-20-arrested.jpg.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/chattogram-chhatra-league-flash-march-20-arrested.jpg.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কোতোয়ালীতে নিষিদ্ধ ছাত্রলীগের ঝটিকা মিছিলের চেষ্টা, আটক ২০" /&gt;&lt;/p&gt;&lt;p&gt;নগরের কোতোয়ালীর সিনেমা প্যালেস এলাকায জুমার নামাজের পর ঝটিকা মিছিল বের করার আগেই পুলিশের ধাওয়ায় ছত্রভঙ্গ হয়েছেন নিষিদ্ধ ঘোষিত ছাত্রলীগের নেতাকর্মীরা। শুক্রবার দুপুরে নগরের সিনেমা প্যালেস এলাকায় এ ঘটনার পর সেখান থেকে ২০ জনকে আটক করেছে পুলিশ। শুক্রবার দুপুর ২টার দিকে এ ঘটনা ঘটে। পুলিশ ও প্রত্যক্ষদর্শী&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%95%e0%a7%8b%e0%a6%a4%e0%a7%8b%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b2%e0%a7%80%e0%a6%a4%e0%a7%87-%e0%a6%a8%e0%a6%bf%e0%a6%b7%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%a7-%e0%a6%9b%e0%a6%be%e0%a6%a4%e0%a7%8d/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>জলাবদ্ধতা-যানজট ঠেকাতে সিডিএর নজর দক্ষিণ কোরিয়ায়</title>
      <link>https://suprobhat.com/%e0%a6%9c%e0%a6%b2%e0%a6%be%e0%a6%ac%e0%a6%a6%e0%a7%8d%e0%a6%a7%e0%a6%a4%e0%a6%be-%e0%a6%af%e0%a6%be%e0%a6%a8%e0%a6%9c%e0%a6%9f-%e0%a6%a0%e0%a7%87%e0%a6%95%e0%a6%be%e0%a6%a4%e0%a7%87-%e0%a6%b8/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%9c%e0%a6%b2%e0%a6%be%e0%a6%ac%e0%a6%a6%e0%a7%8d%e0%a6%a7%e0%a6%a4%e0%a6%be-%e0%a6%af%e0%a6%be%e0%a6%a8%e0%a6%9c%e0%a6%9f-%e0%a6%a0%e0%a7%87%e0%a6%95%e0%a6%be%e0%a6%a4%e0%a7%87-%e0%a6%b8/</guid>
      <pubDate>Fri, 27 Nov 2026 10:33:17 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/seoul-smart-traffic-management-system.jpg.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/seoul-smart-traffic-management-system.jpg.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/seoul-smart-traffic-management-system.jpg.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জলাবদ্ধতা-যানজট ঠেকাতে সিডিএর নজর দক্ষিণ কোরিয়ায়" /&gt;&lt;/p&gt;&lt;p&gt;বর্ষা এলেই পানির নিচে চলে যায় চট্টগ্রামের অনেক সড়ক। অন্যদিকে যানজট আর রাস্তার ওপর গাড়ি পার্কিং নগরের চলাচলকে করে তোলে আরও দুর্বিষহ। এসব সমস্যার সমাধানে এবার দক্ষিণ কোরিয়ার রাজধানী সিউলের নগর ব্যবস্থাপনা মডেল পর্যালোচনা করছে চট্টগ্রাম উন্নয়ন কর্তৃপক্ষ (চউক)। নগরের নিচু এলাকায় ভূগর্ভস্থ বৃষ্টির পানি ধ&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%9c%e0%a6%b2%e0%a6%be%e0%a6%ac%e0%a6%a6%e0%a7%8d%e0%a6%a7%e0%a6%a4%e0%a6%be-%e0%a6%af%e0%a6%be%e0%a6%a8%e0%a6%9c%e0%a6%9f-%e0%a6%a0%e0%a7%87%e0%a6%95%e0%a6%be%e0%a6%a4%e0%a7%87-%e0%a6%b8/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>‘দোকানটিই ছিল আমার জীবিকার শেষ সম্বল’</title>
      <link>https://suprobhat.com/%e0%a6%a6%e0%a7%8b%e0%a6%95%e0%a6%be%e0%a6%a8%e0%a6%9f%e0%a6%bf%e0%a6%87-%e0%a6%9b%e0%a6%bf%e0%a6%b2-%e0%a6%86%e0%a6%ae%e0%a6%be%e0%a6%b0-%e0%a6%9c%e0%a7%80%e0%a6%ac%e0%a6%bf%e0%a6%95/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%a6%e0%a7%8b%e0%a6%95%e0%a6%be%e0%a6%a8%e0%a6%9f%e0%a6%bf%e0%a6%87-%e0%a6%9b%e0%a6%bf%e0%a6%b2-%e0%a6%86%e0%a6%ae%e0%a6%be%e0%a6%b0-%e0%a6%9c%e0%a7%80%e0%a6%ac%e0%a6%bf%e0%a6%95/</guid>
      <pubDate>Fri, 27 Nov 2026 09:49:32 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/heyako-market-fire-two-shops-fatikchhari.jpg.jpg" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/heyako-market-fire-two-shops-fatikchhari.jpg.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/heyako-market-fire-two-shops-fatikchhari.jpg.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘দোকানটিই ছিল আমার জীবিকার শেষ সম্বল’" /&gt;&lt;/p&gt;&lt;p&gt;‘দোকানটিই ছিল আমার জীবিকার শেষ সম্বল।’ আগুনে পুড়ে দোকান হারিয়ে এভাবেই নিজের অসহায়ত্বের কথা জানালেন ফটিকছড়ির হেয়াকো বাজারের চা-দোকানি শফিউল্লাহ। গভীর রাতে আগুনে তার চায়ের দোকানের সব মালামাল পুড়ে গেছে। পাশের একটি স্টেশনারি দোকানও রক্ষা পায়নি। আগুনে দুটি দোকানের অবকাঠামো ও মালামাল মিলিয়ে পাঁচ থেকে সাড়ে&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%a6%e0%a7%8b%e0%a6%95%e0%a6%be%e0%a6%a8%e0%a6%9f%e0%a6%bf%e0%a6%87-%e0%a6%9b%e0%a6%bf%e0%a6%b2-%e0%a6%86%e0%a6%ae%e0%a6%be%e0%a6%b0-%e0%a6%9c%e0%a7%80%e0%a6%ac%e0%a6%bf%e0%a6%95/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>চট্টগ্রাম বন্দর বিদেশিদের হাতে দিলে সরকারকে ‘দালাল’ বলবে জনগণ: গোলাম পরওয়ার</title>
      <link>https://suprobhat.com/%e0%a6%9a%e0%a6%9f%e0%a7%8d%e0%a6%9f%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ae-%e0%a6%ac%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a6%bf%e0%a6%a6%e0%a7%87/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%9a%e0%a6%9f%e0%a7%8d%e0%a6%9f%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ae-%e0%a6%ac%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a6%bf%e0%a6%a6%e0%a7%87/</guid>
      <pubDate>Fri, 27 Nov 2026 09:36:12 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/golam-parwar-chattogram-labor-conference-2026.jpg.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/golam-parwar-chattogram-labor-conference-2026.jpg.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/golam-parwar-chattogram-labor-conference-2026.jpg.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চট্টগ্রাম বন্দর বিদেশিদের হাতে দিলে সরকারকে ‘দালাল’ বলবে জনগণ: গোলাম পরওয়ার" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রাম বন্দর বিদেশি প্রতিষ্ঠানের হাতে তুলে দিলে সরকারকে ‘আধিপত্যবাদী শক্তির দালাল’ আখ্যা দেবে জনগণ। এমন হুঁশিয়ারি দিয়েছেন বাংলাদেশ জামায়াতে ইসলামীর সেক্রেটারি জেনারেল মিয়া গোলাম পরওয়ার। শুক্রবার চট্টগ্রাম বন্দর শহীদ প্রকৌশলী শামসুজ্জামান স্টেডিয়ামে বাংলাদেশ শ্রমিক কল্যাণ ফেডারেশন চট্টগ্রাম মহানগর&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%9a%e0%a6%9f%e0%a7%8d%e0%a6%9f%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ae-%e0%a6%ac%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a6%bf%e0%a6%a6%e0%a7%87/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>সৌদিতে কর্মস্থলে সিঁড়ি থেকে পড়ে প্রাণ গেল ফটিকছড়ির প্রবাসীর</title>
      <link>https://suprobhat.com/%e0%a6%b8%e0%a7%8c%e0%a6%a6%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a6%b8%e0%a7%8d%e0%a6%a5%e0%a6%b2%e0%a7%87-%e0%a6%b8%e0%a6%bf%e0%a6%81%e0%a6%a1%e0%a6%bc%e0%a6%bf/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%b8%e0%a7%8c%e0%a6%a6%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a6%b8%e0%a7%8d%e0%a6%a5%e0%a6%b2%e0%a7%87-%e0%a6%b8%e0%a6%bf%e0%a6%81%e0%a6%a1%e0%a6%bc%e0%a6%bf/</guid>
      <pubDate>Fri, 27 Nov 2026 09:22:59 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/saudi-arabia-fatikchhari-expatriate-shahidullah-death.jpg.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/saudi-arabia-fatikchhari-expatriate-shahidullah-death.jpg.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/saudi-arabia-fatikchhari-expatriate-shahidullah-death.jpg.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সৌদিতে কর্মস্থলে সিঁড়ি থেকে পড়ে প্রাণ গেল ফটিকছড়ির প্রবাসীর" /&gt;&lt;/p&gt;&lt;p&gt;জীবিকার তাগিদে পাড়ি জমিয়েছিলেন সৌদি আরবে। সেখানে ইলেকট্রিক মিস্ত্রির কাজ করতেন চট্টগ্রামের ফটিকছড়ির শহিদুল্লাহ বাবু। কিন্তু কর্মস্থলে সিঁড়ি থেকে পড়ে মাথায় গুরুতর আঘাত পেয়ে শেষ পর্যন্ত প্রাণ হারালেন তিনি। বৃহস্পতিবার (২৬ নভেম্বর) বিকেল সাড়ে ৪টার দিকে সৌদি আরবের মক্কা নগরীতে এ দুর্ঘটনা ঘটে। নিহত শহিদু&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%b8%e0%a7%8c%e0%a6%a6%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a6%b8%e0%a7%8d%e0%a6%a5%e0%a6%b2%e0%a7%87-%e0%a6%b8%e0%a6%bf%e0%a6%81%e0%a6%a1%e0%a6%bc%e0%a6%bf/">Suprobhat Bangladesh</source>
    </item>

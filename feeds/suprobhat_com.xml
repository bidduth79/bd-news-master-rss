      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/ramgar-bgb-deadbody.jpg" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/ramgar-bgb-deadbody.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/ramgar-bgb-deadbody.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফেনী নদীতে মিলল অবসরপ্রাপ্ত বিজিবি সদস্যের মরদেহ, কপালে আঘাতের চিহ্ন" /&gt;&lt;/p&gt;&lt;p&gt;খাগড়াছড়ির রামগড়ে নিখোঁজ হওয়ার এক দিন পর ফেনী নদী থেকে অংথৈইপ্রু মারমা (৬৫) নামে এক অবসরপ্রাপ্ত বিজিবি সদস্যের মরদেহ উদ্ধার করা হয়েছে। তাঁর কপালে আঘাতের চিহ্ন পাওয়া গেছে। শুক্রবার দুপুরে নদীর তীরে ঘাস কাটতে গিয়ে নিখোঁজ হয়েছিলেন তিনি। শনিবার (১৪ নভেম্বর) সকাল সাড়ে ৮টার দিকে উপজেলার ফেনীরকুল সীমান্ত এল&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%ab%e0%a7%87%e0%a6%a8%e0%a7%80-%e0%a6%a8%e0%a6%a6%e0%a7%80%e0%a6%a4%e0%a7%87-%e0%a6%ae%e0%a6%bf%e0%a6%b2%e0%a6%b2-%e0%a6%85%e0%a6%ac%e0%a6%b8%e0%a6%b0%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%be/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>দুই বছরে চট্টগ্রামের জন্য কী করেছেন মেয়র শাহাদাত?</title>
      <link>https://suprobhat.com/%e0%a6%a6%e0%a7%81%e0%a6%87-%e0%a6%ac%e0%a6%9b%e0%a6%b0%e0%a7%87-%e0%a6%9a%e0%a6%9f%e0%a7%8d%e0%a6%9f%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ae%e0%a7%87%e0%a6%b0-%e0%a6%9c%e0%a6%a8%e0%a7%8d/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%a6%e0%a7%81%e0%a6%87-%e0%a6%ac%e0%a6%9b%e0%a6%b0%e0%a7%87-%e0%a6%9a%e0%a6%9f%e0%a7%8d%e0%a6%9f%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ae%e0%a7%87%e0%a6%b0-%e0%a6%9c%e0%a6%a8%e0%a7%8d/</guid>
      <pubDate>Sat, 14 Nov 2026 07:20:03 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/mayor-shahadat.jpg" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/mayor-shahadat.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/mayor-shahadat.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দুই বছরে চট্টগ্রামের জন্য কী করেছেন মেয়র শাহাদাত?" /&gt;&lt;/p&gt;&lt;p&gt;২০২৪ সালের নভেম্বরে আদালতের রায়ে চট্টগ্রাম সিটি করপোরেশনের মেয়রের দায়িত্ব নেন বিএনপি নেতা ডা. শাহাদাত হোসেন। প্রায় দুই বছর মেয়র হিসেবে দায়িত্ব পালনের পর এখন তিনি সংস্থাটির প্রশাসক। এই সময়ে নগরের ৪১টি ওয়ার্ডে ৬৭৮টি উন্নয়ন প্রকল্প নিয়েছে সিটি করপোরেশন। এসব প্রকল্পে ব্যয় হয়েছে ২ হাজার ৪২৩ কোটি টাকার বে&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%a6%e0%a7%81%e0%a6%87-%e0%a6%ac%e0%a6%9b%e0%a6%b0%e0%a7%87-%e0%a6%9a%e0%a6%9f%e0%a7%8d%e0%a6%9f%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ae%e0%a7%87%e0%a6%b0-%e0%a6%9c%e0%a6%a8%e0%a7%8d/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>চন্দনাইশ আইডিয়াল স্কুলে বার্ষিক পুরস্কার বিতরণ ও সাংস্কৃতিক উৎসব</title>
      <link>https://suprobhat.com/%e0%a6%9a%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%a8%e0%a6%be%e0%a6%87%e0%a6%b6-%e0%a6%86%e0%a6%87%e0%a6%a1%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b2-%e0%a6%b8%e0%a7%8d%e0%a6%95%e0%a7%81%e0%a6%b2%e0%a7%87/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%9a%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%a8%e0%a6%be%e0%a6%87%e0%a6%b6-%e0%a6%86%e0%a6%87%e0%a6%a1%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b2-%e0%a6%b8%e0%a7%8d%e0%a6%95%e0%a7%81%e0%a6%b2%e0%a7%87/</guid>
      <pubDate>Sat, 14 Nov 2026 06:57:48 +0000</pubDate>
      <description>শিক্ষার্থীদের মধ্যে বার্ষিক পরীক্ষায় কৃতিত্ব অর্জনকারীদের পুরস্কার বিতরণ এবং সাংস্কৃতিক পরিবেশনার মধ্য দিয়ে চট্টগ্রামের চন্দনাইশ আইডিয়াল স্কুলের বার্ষিক উৎসব অনুষ্ঠিত হয়েছে। শনিবার (১৪ নভেম্বর) সকালে চন্দনাইশ পৌরসভার মধ্যম চন্দনাইশের মিজ্জির দোকান সংলগ্ন বিদ্যালয় মাঠে এ আয়োজন করা হয়। এতে শিক্ষার্থী,</description>
      <source url="https://suprobhat.com/%e0%a6%9a%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%a8%e0%a6%be%e0%a6%87%e0%a6%b6-%e0%a6%86%e0%a6%87%e0%a6%a1%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b2-%e0%a6%b8%e0%a7%8d%e0%a6%95%e0%a7%81%e0%a6%b2%e0%a7%87/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>বাল্যবিবাহ ও শিশু নির্যাতন প্রতিরোধে আইন জানল চারুলতার শিক্ষার্থীরা</title>
      <link>https://suprobhat.com/%e0%a6%ac%e0%a6%be%e0%a6%b2%e0%a7%8d%e0%a6%af%e0%a6%ac%e0%a6%bf%e0%a6%ac%e0%a6%be%e0%a6%b9-%e0%a6%93-%e0%a6%b6%e0%a6%bf%e0%a6%b6%e0%a7%81-%e0%a6%a8%e0%a6%bf%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%be/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%ac%e0%a6%be%e0%a6%b2%e0%a7%8d%e0%a6%af%e0%a6%ac%e0%a6%bf%e0%a6%ac%e0%a6%be%e0%a6%b9-%e0%a6%93-%e0%a6%b6%e0%a6%bf%e0%a6%b6%e0%a7%81-%e0%a6%a8%e0%a6%bf%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%be/</guid>
      <pubDate>Sat, 14 Nov 2026 06:15:26 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/charulata-biddyapith.jpg" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/charulata-biddyapith.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/charulata-biddyapith.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাল্যবিবাহ ও শিশু নির্যাতন প্রতিরোধে আইন জানল চারুলতার শিক্ষার্থীরা" /&gt;&lt;/p&gt;&lt;p&gt;বাল্যবিবাহ ও নারী-শিশু নির্যাতন প্রতিরোধে প্রচলিত আইন এবং নিজেদের অধিকার সম্পর্কে জানল চট্টগ্রামের চারুলতা বিদ্যাপীঠের শিক্ষার্থীরা। এ বিষয়ে সচেতনতা বাড়াতে শিক্ষাপ্রতিষ্ঠানটিতে ‘সবার জন্য আইন’ শীর্ষক সেমিনারের আয়োজন করেছে লিগ্যাল এম্পাওয়ারমেন্ট বাংলাদেশ (এলইবি)। শুক্রবার (১৩ নভেম্বর) এলইবির চট্টগ্রা&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%ac%e0%a6%be%e0%a6%b2%e0%a7%8d%e0%a6%af%e0%a6%ac%e0%a6%bf%e0%a6%ac%e0%a6%be%e0%a6%b9-%e0%a6%93-%e0%a6%b6%e0%a6%bf%e0%a6%b6%e0%a7%81-%e0%a6%a8%e0%a6%bf%e0%a6%b0%e0%a7%8d%e0%a6%af%e0%a6%be/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>‘ষড়যন্ত্রকারীদের প্রতিরোধে বিএনপির নেতাকর্মীরাই যথেষ্ট’: ভূমি প্রতিমন্ত্রী</title>
      <link>https://suprobhat.com/%e0%a6%b7%e0%a6%a1%e0%a6%bc%e0%a6%af%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a7%80%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4%e0%a6%bf/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%b7%e0%a6%a1%e0%a6%bc%e0%a6%af%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a7%80%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4%e0%a6%bf/</guid>
      <pubDate>Sat, 14 Nov 2026 06:03:16 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/mir-helal-lalkhan-bazar.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/mir-helal-lalkhan-bazar.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/mir-helal-lalkhan-bazar.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘ষড়যন্ত্রকারীদের প্রতিরোধে বিএনপির নেতাকর্মীরাই যথেষ্ট’: ভূমি প্রতিমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;দেশবিরোধী ও রাষ্ট্রবিরোধী ষড়যন্ত্রকারীদের প্রতিরোধে প্রশাসনের প্রয়োজন হবে না, বিএনপির নেতাকর্মীরাই যথেষ্ট বলে মন্তব্য করেছেন ভূমি ও পার্বত্য চট্টগ্রাম বিষয়ক প্রতিমন্ত্রী ব্যারিস্টার মীর মোহাম্মদ হেলাল উদ্দিন। শনিবার চট্টগ্রাম নগরের লালখান বাজারে শহীদ ওয়াসিম আকরাম এলিভেটেড এক্সপ্রেসওয়ে প্রকল্পের আওতা&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%b7%e0%a6%a1%e0%a6%bc%e0%a6%af%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a7%80%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a4%e0%a6%bf/">Suprobhat Bangladesh</source>
    </item>

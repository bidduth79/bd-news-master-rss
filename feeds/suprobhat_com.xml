    <item>
      <title>অনলাইনেও ইয়াছিনের সাম্রাজ্য!</title>
      <link>https://suprobhat.com/%e0%a6%9c%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a6%b2-%e0%a6%b8%e0%a6%b2%e0%a6%bf%e0%a6%ae%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87-%e0%a6%87%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%9b%e0%a6%bf%e0%a6%a8%e0%a7%87%e0%a6%b0/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%9c%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a6%b2-%e0%a6%b8%e0%a6%b2%e0%a6%bf%e0%a6%ae%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87-%e0%a6%87%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%9b%e0%a6%bf%e0%a6%a8%e0%a7%87%e0%a6%b0/</guid>
      <pubDate>Wed, 18 Nov 2026 10:12:57 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/yasin.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/yasin.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/yasin.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অনলাইনেও ইয়াছিনের সাম্রাজ্য!" /&gt;&lt;/p&gt;&lt;p&gt;জঙ্গল সলিমপুরে র‍্যাব সদস্য হত্যা ও যৌথ বাহিনীর ক্যাম্পে হামলার ঘটনায় অভিযুক্ত ইয়াছিনের অনুসারীদের পরিচালিত ৩৯টি ফেসবুক আইডি ও পেজের সন্ধান পেয়েছে পুলিশ। এসব প্ল্যাটফর্ম থেকে আইনশৃঙ্খলা রক্ষাকারী বাহিনীর অভিযান ও সরকারি সিদ্ধান্তের বিরুদ্ধে অপপ্রচার চালানো হতো বলে অভিযোগ পুলিশের। এ ঘটনায় ইয়াছিনসহ ছয়&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%9c%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a6%b2-%e0%a6%b8%e0%a6%b2%e0%a6%bf%e0%a6%ae%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87-%e0%a6%87%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%9b%e0%a6%bf%e0%a6%a8%e0%a7%87%e0%a6%b0/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>সাউদার্নে ‘কনকোর্স দ্য কুইজিন’ প্রতিযোগিতা অনুষ্ঠিত</title>
      <link>https://suprobhat.com/%e0%a6%b8%e0%a6%be%e0%a6%89%e0%a6%a6%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%a8%e0%a7%87-%e0%a6%95%e0%a6%a8%e0%a6%95%e0%a7%8b%e0%a6%b0%e0%a7%8d%e0%a6%b8-%e0%a6%a6%e0%a7%8d%e0%a6%af-%e0%a6%95/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%b8%e0%a6%be%e0%a6%89%e0%a6%a6%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%a8%e0%a7%87-%e0%a6%95%e0%a6%a8%e0%a6%95%e0%a7%8b%e0%a6%b0%e0%a7%8d%e0%a6%b8-%e0%a6%a6%e0%a7%8d%e0%a6%af-%e0%a6%95/</guid>
      <pubDate>Wed, 18 Nov 2026 08:46:25 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/southern-news.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/southern-news.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/southern-news.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাউদার্নে ‘কনকোর্স দ্য কুইজিন’ প্রতিযোগিতা অনুষ্ঠিত" /&gt;&lt;/p&gt;&lt;p&gt;রান্নার প্রতিযোগিতা ও খাবার প্রদর্শনীর মধ্য দিয়ে সাউদার্ন ইউনিভার্সিটি বাংলাদেশে অনুষ্ঠিত হয়েছে ‘কনকোর্স দ্য কুইজিন’ সিজন-৩। মঙ্গলবার (১৭ নভেম্বর) নগরের বায়েজিদ আরেফিন নগরে বিশ্ববিদ্যালয়ের ব্যবসায় প্রশাসন অনুষদের ট্যুরিজম অ্যান্ড হসপিটালিটি ম্যানেজমেন্ট বিভাগের উদ্যোগে এ আয়োজন করা হয়। ভারপ্রাপ্ত উপা&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%b8%e0%a6%be%e0%a6%89%e0%a6%a6%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%a8%e0%a7%87-%e0%a6%95%e0%a6%a8%e0%a6%95%e0%a7%8b%e0%a6%b0%e0%a7%8d%e0%a6%b8-%e0%a6%a6%e0%a7%8d%e0%a6%af-%e0%a6%95/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>কর্ণফুলীতে শিশু সন্তান বিক্রির বিরোধে বাবাকে হত্যা,  দুই ছেলে গ্রেপ্তার</title>
      <link>https://suprobhat.com/%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%a3%e0%a6%ab%e0%a7%81%e0%a6%b2%e0%a7%80%e0%a6%a4%e0%a7%87-%e0%a6%b6%e0%a6%bf%e0%a6%b6%e0%a7%81-%e0%a6%b8%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%a8-%e0%a6%ac/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%a3%e0%a6%ab%e0%a7%81%e0%a6%b2%e0%a7%80%e0%a6%a4%e0%a7%87-%e0%a6%b6%e0%a6%bf%e0%a6%b6%e0%a7%81-%e0%a6%b8%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%a8-%e0%a6%ac/</guid>
      <pubDate>Wed, 18 Nov 2026 08:42:23 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/karnafully.jpg" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/karnafully.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/karnafully.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কর্ণফুলীতে শিশু সন্তান বিক্রির বিরোধে বাবাকে হত্যা,  দুই ছেলে গ্রেপ্তার" /&gt;&lt;/p&gt;&lt;p&gt;কর্ণফুলীতে নুরুল আবছার (২২) হত্যা মামলায় দুইজনকে গ্রেপ্তার করেছে স্পেশাল রেসপন্স ব্যাটালিয়ন (এসআরবি-৭)। সংস্থাটির দাবি, ১৪ মাস বয়সী এক শিশুকে দুই লাখ টাকায় বিক্রির ঘটনা নিয়ে বিরোধের জেরে তাঁকে হত্যা করা হয়। গ্রেপ্তার ব্যক্তিরা হলেন মোহাম্মদ সুমন (৩১) ও মোহাম্মদ আকাশ (২১)। তারা দুজনই কর্ণফুলী উপজেলার&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%a3%e0%a6%ab%e0%a7%81%e0%a6%b2%e0%a7%80%e0%a6%a4%e0%a7%87-%e0%a6%b6%e0%a6%bf%e0%a6%b6%e0%a7%81-%e0%a6%b8%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%a8-%e0%a6%ac/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>চন্দনাইশে দুই ট্রাকের মুখোমুখি সংঘর্ষ, আহত ৪</title>
      <link>https://suprobhat.com/%e0%a6%9a%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%a8%e0%a6%be%e0%a6%87%e0%a6%b6%e0%a7%87-%e0%a6%a6%e0%a7%81%e0%a6%87-%e0%a6%9f%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a7%81/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%9a%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%a8%e0%a6%be%e0%a6%87%e0%a6%b6%e0%a7%87-%e0%a6%a6%e0%a7%81%e0%a6%87-%e0%a6%9f%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a7%81/</guid>
      <pubDate>Wed, 18 Nov 2026 07:47:59 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/chandonaishe-road-accident.jpg" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/chandonaishe-road-accident.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/chandonaishe-road-accident.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চন্দনাইশে দুই ট্রাকের মুখোমুখি সংঘর্ষ, আহত ৪" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রাম-কক্সবাজার মহাসড়কের চন্দনাইশে দুই ট্রাকের মুখোমুখি সংঘর্ষে চারজন গুরুতর আহত হয়েছেন। দুমড়ে-মুচড়ে গেছে ট্রাক দুটির সামনের অংশ। বুধবার দুপুর ১২টা ১৫ মিনিটের দিকে উপজেলার হাশিমপুর ইউনিয়নের বাগিছাহাট খাঁন বটতল এলাকায় এ দুর্ঘটনা ঘটে। প্রত্যক্ষদর্শী ও স্থানীয় সূত্রে জানা যায়, দোহাজারী থেকে আসা মুর&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%9a%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%a8%e0%a6%be%e0%a6%87%e0%a6%b6%e0%a7%87-%e0%a6%a6%e0%a7%81%e0%a6%87-%e0%a6%9f%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a7%81/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>চসিকের সাবেক কাউন্সিলর সলিমউল্লাহ বাচ্চু গ্রেপ্তার</title>
      <link>https://suprobhat.com/%e0%a6%9a%e0%a6%b8%e0%a6%bf%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%be%e0%a6%ac%e0%a7%87%e0%a6%95-%e0%a6%95%e0%a6%be%e0%a6%89%e0%a6%a8%e0%a7%8d%e0%a6%b8%e0%a6%bf%e0%a6%b2%e0%a6%b0-%e0%a6%b8/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%9a%e0%a6%b8%e0%a6%bf%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%be%e0%a6%ac%e0%a7%87%e0%a6%95-%e0%a6%95%e0%a6%be%e0%a6%89%e0%a6%a8%e0%a7%8d%e0%a6%b8%e0%a6%bf%e0%a6%b2%e0%a6%b0-%e0%a6%b8/</guid>
      <pubDate>Wed, 18 Nov 2026 07:43:07 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/bacchu-.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/bacchu-.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/bacchu-.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চসিকের সাবেক কাউন্সিলর সলিমউল্লাহ বাচ্চু গ্রেপ্তার" /&gt;&lt;/p&gt;&lt;p&gt;নগরের এনায়েত বাজার ওয়ার্ডের সাবেক কাউন্সিলর ও কার্যক্রম নিষিদ্ধ আওয়ামী লীগের নেতা সলিমউল্লাহ বাচ্চুকে গ্রেপ্তার করেছে পুলিশ। নগরের বিভিন্ন স্থানে সাম্প্রতিক নাশকতার ঘটনায় তার সম্পৃক্ততার প্রাথমিক তথ্য পাওয়ার কথা জানিয়েছে পুলিশ। মঙ্গলবার দিবাগত রাত দুইটার দিকে এনায়েত বাজার এলাকায় নিজ বাসা থেকে তাকে গ&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%9a%e0%a6%b8%e0%a6%bf%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%be%e0%a6%ac%e0%a7%87%e0%a6%95-%e0%a6%95%e0%a6%be%e0%a6%89%e0%a6%a8%e0%a7%8d%e0%a6%b8%e0%a6%bf%e0%a6%b2%e0%a6%b0-%e0%a6%b8/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>বিএসআরএমের হোপওয়েল হসপিটালের ডায়াগনস্টিক সেন্টার উদ্বোধন</title>

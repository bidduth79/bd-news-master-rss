    <item>
      <title>ঝিনুকের মেঘলা দিন</title>
      <link>https://suprobhat.com/%e0%a6%9d%e0%a6%bf%e0%a6%a8%e0%a7%81%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a7%87%e0%a6%98%e0%a6%b2%e0%a6%be-%e0%a6%a6%e0%a6%bf%e0%a6%a8/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%9d%e0%a6%bf%e0%a6%a8%e0%a7%81%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a7%87%e0%a6%98%e0%a6%b2%e0%a6%be-%e0%a6%a6%e0%a6%bf%e0%a6%a8/</guid>
      <pubDate>Tue, 24 Nov 2026 07:20:52 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/jhinuker-meghladin.jpeg" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/jhinuker-meghladin.jpeg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/jhinuker-meghladin.jpeg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঝিনুকের মেঘলা দিন" /&gt;&lt;/p&gt;&lt;p&gt;বৃষ্টির দিন ঝিনুকের খুব ভালো লাগে। আজ সারাদিন বৃষ্টি হচ্ছে। বারান্দায় টেবিল-চেয়ার পেতে বসে বই পড়ছে সে। আজ শুক্রবার, তাই স্কুলে যাওয়ার তাড়া নেই। তবে কয়েক দিন পরই বার্ষিক পরীক্ষা। তাই পড়াশোনায় অবহেলার সুযোগ নেই। পড়ার ফাঁকে মাঝে মাঝে বারান্দার গ্রিল ধরে দাঁড়িয়ে বৃষ্টি উপভোগ করছে ঝিনুক। হাত বাড়িয়ে বৃষ্ট&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%9d%e0%a6%bf%e0%a6%a8%e0%a7%81%e0%a6%95%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a7%87%e0%a6%98%e0%a6%b2%e0%a6%be-%e0%a6%a6%e0%a6%bf%e0%a6%a8/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>চট্টগ্রাম বন্দর কি রাজনৈতিক প্রভাবশালীদের ব্যবসার ক্ষেত্র, প্রশ্ন নাসীরুদ্দীন পাটওয়ারীর</title>
      <link>https://suprobhat.com/%e0%a6%9a%e0%a6%9f%e0%a7%8d%e0%a6%9f%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ae-%e0%a6%ac%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0-%e0%a6%95%e0%a6%bf-%e0%a6%b0%e0%a6%be%e0%a6%9c%e0%a6%a8%e0%a7%88/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%9a%e0%a6%9f%e0%a7%8d%e0%a6%9f%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ae-%e0%a6%ac%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0-%e0%a6%95%e0%a6%bf-%e0%a6%b0%e0%a6%be%e0%a6%9c%e0%a6%a8%e0%a7%88/</guid>
      <pubDate>Tue, 24 Nov 2026 07:07:03 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/nasiruddin-patwary.jpg" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/nasiruddin-patwary.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/nasiruddin-patwary.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চট্টগ্রাম বন্দর কি রাজনৈতিক প্রভাবশালীদের ব্যবসার ক্ষেত্র, প্রশ্ন নাসীরুদ্দীন পাটওয়ারীর" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রাম বন্দরের গুরুত্বপূর্ণ স্থাপনা চিটাগাং কনটেইনার টার্মিনালের (সিসিটি) পরিচালনার দায়িত্ব পেয়েছে বিএনপির সংসদ সদস্য শাহাদাত হোসেন সেলিমের পারিবারিক প্রতিষ্ঠান এভারেস্ট পোর্ট সার্ভিসেস লিমিটেড। ছয় মাসের জন্য প্রতিষ্ঠানটিকে দায়িত্ব দেওয়া এবং দরপত্রের সময়সীমা নিয়ে প্রশ্ন তুলেছেন জাতীয় নাগরিক পার্ট&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%9a%e0%a6%9f%e0%a7%8d%e0%a6%9f%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ae-%e0%a6%ac%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%b0-%e0%a6%95%e0%a6%bf-%e0%a6%b0%e0%a6%be%e0%a6%9c%e0%a6%a8%e0%a7%88/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>ফেল থেকে পাস ২৩৮, নতুন জিপিএ-৫ পেলেন আরও ১০১ শিক্ষার্থী</title>
      <link>https://suprobhat.com/%e0%a6%ab%e0%a7%87%e0%a6%b2-%e0%a6%a5%e0%a7%87%e0%a6%95%e0%a7%87-%e0%a6%aa%e0%a6%be%e0%a6%b8-%e0%a7%a8%e0%a7%a9%e0%a7%ae-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%9c%e0%a6%bf%e0%a6%aa%e0%a6%bf/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%ab%e0%a7%87%e0%a6%b2-%e0%a6%a5%e0%a7%87%e0%a6%95%e0%a7%87-%e0%a6%aa%e0%a6%be%e0%a6%b8-%e0%a7%a8%e0%a7%a9%e0%a7%ae-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%9c%e0%a6%bf%e0%a6%aa%e0%a6%bf/</guid>
      <pubDate>Tue, 24 Nov 2026 05:54:51 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/ctg-education-board.jpg" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/ctg-education-board.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/ctg-education-board.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফেল থেকে পাস ২৩৮, নতুন জিপিএ-৫ পেলেন আরও ১০১ শিক্ষার্থী" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রাম শিক্ষা বোর্ডে এইচএসসির মূল ফলাফলে অকৃতকার্য হয়েছিলেন ৪৬ হাজার ১৬৯ শিক্ষার্থী। খাতা পুনঃনিরীক্ষণের পর তাঁদের মধ্যে ২৩৮ জন উত্তীর্ণ হয়েছেন। নতুন করে জিপিএ-৫ পেয়েছেন আরও ১০১ জন। সব মিলিয়ে পুনঃনিরীক্ষণে ২ হাজার ৪৩ জন শিক্ষার্থীর ফল পরিবর্তন হয়েছে। সোমবার (২৩ নভেম্বর) ২০২৬ সালের উচ্চমাধ্যমিক সা&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%ab%e0%a7%87%e0%a6%b2-%e0%a6%a5%e0%a7%87%e0%a6%95%e0%a7%87-%e0%a6%aa%e0%a6%be%e0%a6%b8-%e0%a7%a8%e0%a7%a9%e0%a7%ae-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%9c%e0%a6%bf%e0%a6%aa%e0%a6%bf/">Suprobhat Bangladesh</source>
    </item>

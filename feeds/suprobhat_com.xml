      <pubDate>Sun, 15 Nov 2026 05:15:01 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/ustc.jpg" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/ustc.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/ustc.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইউসিটিসিতে ঈদে মিলাদুন্নবী উপলক্ষে প্রতিযোগিতা ও সেমিনার" /&gt;&lt;/p&gt;&lt;p&gt;পবিত্র ঈদে মিলাদুন্নবী (সা.) উপলক্ষে কিরাত, হামদ-নাত ও বক্তৃতা প্রতিযোগিতার আয়োজন করেছে ইউনিভার্সিটি অব ক্রিয়েটিভ টেকনোলজি চট্টগ্রাম (ইউসিটিসি)। প্রতিযোগিতা শেষে বিজয়ীদের মধ্যে পুরস্কার বিতরণ ও মহানবী হজরত মুহাম্মদ (সা.)-এর জীবনাদর্শ নিয়ে সেমিনার অনুষ্ঠিত হয়েছে। শনিবার (১৪ নভেম্বর) বিশ্ববিদ্যালয়ের ড&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%87%e0%a6%89%e0%a6%b8%e0%a6%bf%e0%a6%9f%e0%a6%bf%e0%a6%b8%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%88%e0%a6%a6%e0%a7%87-%e0%a6%ae%e0%a6%bf%e0%a6%b2%e0%a6%be%e0%a6%a6%e0%a7%81%e0%a6%a8%e0%a7%8d%e0%a6%a8/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>বাল্যবিবাহ ও শিশুশ্রম প্রতিরোধে ধর্মীয় নেতাদের ভূমিকা নিয়ে ইউনিসেফের কর্মশালা</title>
      <link>https://suprobhat.com/%e0%a6%ac%e0%a6%be%e0%a6%b2%e0%a7%8d%e0%a6%af%e0%a6%ac%e0%a6%bf%e0%a6%ac%e0%a6%be%e0%a6%b9-%e0%a6%93-%e0%a6%b6%e0%a6%bf%e0%a6%b6%e0%a7%81%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a6%ae-%e0%a6%aa%e0%a7%8d/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%ac%e0%a6%be%e0%a6%b2%e0%a7%8d%e0%a6%af%e0%a6%ac%e0%a6%bf%e0%a6%ac%e0%a6%be%e0%a6%b9-%e0%a6%93-%e0%a6%b6%e0%a6%bf%e0%a6%b6%e0%a7%81%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a6%ae-%e0%a6%aa%e0%a7%8d/</guid>
      <pubDate>Sun, 15 Nov 2026 05:07:34 +0000</pubDate>

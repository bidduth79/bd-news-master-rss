      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/unisef-.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/unisef-.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাল্যবিবাহ ও শিশুশ্রম প্রতিরোধে ধর্মীয় নেতাদের ভূমিকা নিয়ে ইউনিসেফের কর্মশালা" /&gt;&lt;/p&gt;&lt;p&gt;বাল্যবিবাহ নিরোধ ও শিশুদের নিরাপত্তা নিশ্চিত করতে ধর্মীয় নেতাদের ইতিবাচক ভূমিকা জোরদারের লক্ষ্যে ঢাকায় শুরু হয়েছে তিনদিনের ‘মাইন্ড-হার্ট ডায়লগ’ শীর্ষক প্রশিক্ষণ কর্মশালা। ইউনিসেফ বাংলাদেশের পৃষ্ঠপোষকতায় এবং রিলিজিয়নস ফর পিস বাংলাদেশের উদ্যোগে গতকাল শনিবার (১৪ নভেম্বর) সকাল ৯টায় ইউনিসেফের প্রধান কার্&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%ac%e0%a6%be%e0%a6%b2%e0%a7%8d%e0%a6%af%e0%a6%ac%e0%a6%bf%e0%a6%ac%e0%a6%be%e0%a6%b9-%e0%a6%93-%e0%a6%b6%e0%a6%bf%e0%a6%b6%e0%a7%81%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a6%ae-%e0%a6%aa%e0%a7%8d/">Suprobhat Bangladesh</source>
    </item>

    <item>
      <title>আনোয়ারায় এমপির বাড়ির সামনে গাছ কেটে অবরোধ, গুলি ছোড়ার অভিযোগে আটক ৪</title>
      <link>https://suprobhat.com/%e0%a6%86%e0%a6%a8%e0%a7%8b%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%8f%e0%a6%ae%e0%a6%aa%e0%a6%bf%e0%a6%b0-%e0%a6%ac%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a6%bf%e0%a6%b0/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%86%e0%a6%a8%e0%a7%8b%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%8f%e0%a6%ae%e0%a6%aa%e0%a6%bf%e0%a6%b0-%e0%a6%ac%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a6%bf%e0%a6%b0/</guid>
      <pubDate>Thu, 19 Nov 2026 09:15:33 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/anwara-arrest.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/anwara-arrest.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/anwara-arrest.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আনোয়ারায় এমপির বাড়ির সামনে গাছ কেটে অবরোধ, গুলি ছোড়ার অভিযোগে আটক ৪" /&gt;&lt;/p&gt;&lt;p&gt;আনোয়ারায় সংসদ সদস্য সরওয়ার জামাল নিজামের বাড়ির সামনের সড়কে গাছ কেটে অবরোধের চেষ্টার সময় চারজনকে আটক করা হয়েছে। স্থানীয় বিএনপি ও ছাত্রদলের নেতাকর্মীরা তাদের ধাওয়া করে আটক করেন। এ সময় গুলি ছোড়ার অভিযোগও করেছেন বিএনপি নেতাকর্মীরা। তবে পুলিশ বলছে, এটি এমপির বাড়িতে হামলার ঘটনা নয়, সড়ক অবরোধের চেষ্টা। বৃহ&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%86%e0%a6%a8%e0%a7%8b%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%8f%e0%a6%ae%e0%a6%aa%e0%a6%bf%e0%a6%b0-%e0%a6%ac%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a6%bf%e0%a6%b0/">Suprobhat Bangladesh</source>
    </item>

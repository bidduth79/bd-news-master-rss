      <pubDate>Fri, 20 Nov 2026 14:52:44 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/trade-fair-ctg-amir-khasru.jpg" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/trade-fair-ctg-amir-khasru.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/trade-fair-ctg-amir-khasru.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চট্টগ্রামকে আঞ্চলিক অর্থনৈতিক হাব করতে চায় সরকার: আমির খসরু" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রামকে শুধু বাংলাদেশের অর্থনীতির কেন্দ্র নয়, পুরো অঞ্চলের অর্থনৈতিক হাব হিসেবে গড়ে তুলতে চায় সরকার। এ লক্ষ্য বাস্তবায়নে চট্টগ্রাম বন্দর ও বিমানবন্দরের সক্ষমতা বাড়ানো, গভীর সমুদ্রবন্দর নির্মাণ এবং দুবাইয়ের জেবেল আলীর আদলে ৩০০ একর জমিতে ফ্রিপোর্ট গড়ে তোলার পরিকল্পনা নেওয়া হয়েছে। পাশাপাশি জ্বালানি&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%9a%e0%a6%9f%e0%a7%8d%e0%a6%9f%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ae%e0%a6%95%e0%a7%87-%e0%a6%86%e0%a6%9e%e0%a7%8d%e0%a6%9a%e0%a6%b2%e0%a6%bf%e0%a6%95-%e0%a6%85%e0%a6%b0%e0%a7%8d/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>সড়ক-রেলপথে তিন দুর্ঘটনা, কক্সবাজারে একদিনেই ঝরল ৬ প্রাণ</title>
      <link>https://suprobhat.com/%e0%a6%b8%e0%a6%a1%e0%a6%bc%e0%a6%95-%e0%a6%b0%e0%a7%87%e0%a6%b2%e0%a6%aa%e0%a6%a5%e0%a7%87-%e0%a6%a4%e0%a6%bf%e0%a6%a8-%e0%a6%a6%e0%a7%81%e0%a6%b0%e0%a7%8d%e0%a6%98%e0%a6%9f%e0%a6%a8%e0%a6%be/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%b8%e0%a6%a1%e0%a6%bc%e0%a6%95-%e0%a6%b0%e0%a7%87%e0%a6%b2%e0%a6%aa%e0%a6%a5%e0%a7%87-%e0%a6%a4%e0%a6%bf%e0%a6%a8-%e0%a6%a6%e0%a7%81%e0%a6%b0%e0%a7%8d%e0%a6%98%e0%a6%9f%e0%a6%a8%e0%a6%be/</guid>
      <pubDate>Fri, 20 Nov 2026 14:09:14 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/road-accident.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/road-accident.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/road-accident.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সড়ক-রেলপথে তিন দুর্ঘটনা, কক্সবাজারে একদিনেই ঝরল ৬ প্রাণ" /&gt;&lt;/p&gt;&lt;p&gt;কক্সবাজারে একদিনে সড়ক ও রেলপথে পৃথক তিন দুর্ঘটনায় ছয়জন নিহত হয়েছেন। শুক্রবার (২০ নভেম্বর) এসব দুর্ঘটনায় নিহতদের মধ্যে দুই শিশুসহ একই পরিবারের চারজন, এক যুবক ও এক স্কুলছাত্র রয়েছেন। শুক্রবার বিকেল সাড়ে ৩টার দিকে রামু উপজেলার দক্ষিণ মিঠাছড়ি এলাকার একটি রেলক্রসিংয়ে ট্রেনের ধাক্কায় সিএনজিচালিত অটোরিকশার&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%b8%e0%a6%a1%e0%a6%bc%e0%a6%95-%e0%a6%b0%e0%a7%87%e0%a6%b2%e0%a6%aa%e0%a6%a5%e0%a7%87-%e0%a6%a4%e0%a6%bf%e0%a6%a8-%e0%a6%a6%e0%a7%81%e0%a6%b0%e0%a7%8d%e0%a6%98%e0%a6%9f%e0%a6%a8%e0%a6%be/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>সবজিতে স্বস্তি, মাছের বাজারে আগুন</title>
      <link>https://suprobhat.com/%e0%a6%b8%e0%a6%ac%e0%a6%9c%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%b8%e0%a7%8d%e0%a6%ac%e0%a6%b8%e0%a7%8d%e0%a6%a4%e0%a6%bf-%e0%a6%ae%e0%a6%be%e0%a6%9b%e0%a7%87%e0%a6%b0-%e0%a6%ac%e0%a6%be%e0%a6%9c/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%b8%e0%a6%ac%e0%a6%9c%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%b8%e0%a7%8d%e0%a6%ac%e0%a6%b8%e0%a7%8d%e0%a6%a4%e0%a6%bf-%e0%a6%ae%e0%a6%be%e0%a6%9b%e0%a7%87%e0%a6%b0-%e0%a6%ac%e0%a6%be%e0%a6%9c/</guid>
      <pubDate>Fri, 20 Nov 2026 06:33:41 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/bazar.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/bazar.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/bazar.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সবজিতে স্বস্তি, মাছের বাজারে আগুন" /&gt;&lt;/p&gt;&lt;p&gt;নগরের বাজারে আগাম শীতকালীন সবজির সরবরাহ বাড়ায় কমেছে অধিকাংশ সবজির দাম। তবে সামুদ্রিক মাছের সরবরাহ বাড়লেও গত সপ্তাহের তুলনায় অধিকাংশ মাছের দাম কেজিতে ১২০ থেকে ১৫০ টাকা বেড়েছে। মুরগি ও ডিমের বাজারে সপ্তাহের ব্যবধানে তেমন পরিবর্তন নেই। অন্যদিকে চাল, ডাল, তেল, পেঁয়াজ ও মসলার দাম এখনো চড়া। এমন পরিস্থিতিত&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%b8%e0%a6%ac%e0%a6%9c%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%b8%e0%a7%8d%e0%a6%ac%e0%a6%b8%e0%a7%8d%e0%a6%a4%e0%a6%bf-%e0%a6%ae%e0%a6%be%e0%a6%9b%e0%a7%87%e0%a6%b0-%e0%a6%ac%e0%a6%be%e0%a6%9c/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>সাত মামলায় গ্রেপ্তারি পরোয়ানা, সাদ-মুসার এমডি মহসিন গ্রেপ্তার</title>
      <link>https://suprobhat.com/%e0%a6%b8%e0%a6%be%e0%a6%a4-%e0%a6%ae%e0%a6%be%e0%a6%ae%e0%a6%b2%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%aa%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%b0%e0%a6%bf-%e0%a6%aa/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%b8%e0%a6%be%e0%a6%a4-%e0%a6%ae%e0%a6%be%e0%a6%ae%e0%a6%b2%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%aa%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%b0%e0%a6%bf-%e0%a6%aa/</guid>
      <pubDate>Thu, 19 Nov 2026 19:06:27 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/Saad-musa.jpg" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/Saad-musa.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/Saad-musa.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাত মামলায় গ্রেপ্তারি পরোয়ানা, সাদ-মুসার এমডি মহসিন গ্রেপ্তার" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রামের আলোচিত শিল্পগ্রুপ সাদ-মুসার ব্যবস্থাপনা পরিচালক (এমডি) মোহাম্মদ মহসিনকে গ্রেপ্তার করেছে পুলিশ। বৃহস্পতিবার রাত ৮টার দিকে নগরের আগ্রাবাদ এলাকা থেকে তাঁকে গ্রেপ্তার করে পাঁচলাইশ থানা পুলিশ। তাঁর বিরুদ্ধে সাতটি মামলায় গ্রেপ্তারি পরোয়ানা রয়েছে। পাঁচলাইশ থানার ভারপ্রাপ্ত কর্মকর্তা (ওসি) মোজাম&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%b8%e0%a6%be%e0%a6%a4-%e0%a6%ae%e0%a6%be%e0%a6%ae%e0%a6%b2%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%aa%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%b0%e0%a6%bf-%e0%a6%aa/">Suprobhat Bangladesh</source>
    </item>

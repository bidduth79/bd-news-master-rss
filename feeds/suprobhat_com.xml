      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/iiuc-international-conference-humanities-5-ai-chattogram-2026.jpg.jpg" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/iiuc-international-conference-humanities-5-ai-chattogram-2026.jpg.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/iiuc-international-conference-humanities-5-ai-chattogram-2026.jpg.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এআইয়ের যুগে মানবিকতা ধরে রাখার তাগিদ আইআইইউসির সম্মেলনে" /&gt;&lt;/p&gt;&lt;p&gt;কৃত্রিম বুদ্ধিমত্তার (এআই) দ্রুত অগ্রগতির সঙ্গে পাল্লা দিয়ে মানবিক মূল্যবোধেরও বিকাশ ঘটানোর তাগিদ এসেছে চট্টগ্রামের আন্তর্জাতিক ইসলামী বিশ্ববিদ্যালয়ের (আইআইইউসি) আন্তর্জাতিক সম্মেলনে। বক্তারা বলেছেন, প্রযুক্তির অগ্রগতি মানুষের জীবন সহজ করলেও মানবিক বোধ, নৈতিকতা ও মূল্যবোধকে উপেক্ষা করার সুযোগ নেই। ব&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%8f%e0%a6%86%e0%a6%87%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%b0-%e0%a6%af%e0%a7%81%e0%a6%97%e0%a7%87-%e0%a6%ae%e0%a6%be%e0%a6%a8%e0%a6%ac%e0%a6%bf%e0%a6%95%e0%a6%a4%e0%a6%be-%e0%a6%a7%e0%a6%b0/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>দাদার স্মৃতিবিজড়িত পাকিস্তানের পার্লামেন্টে হুম্মাম, লিখলেন তিন প্রজন্মের গল্প</title>
      <link>https://suprobhat.com/%e0%a6%a6%e0%a6%be%e0%a6%a6%e0%a6%be%e0%a6%b0-%e0%a6%b8%e0%a7%8d%e0%a6%ae%e0%a7%83%e0%a6%a4%e0%a6%bf%e0%a6%ac%e0%a6%bf%e0%a6%9c%e0%a6%a1%e0%a6%bc%e0%a6%bf%e0%a6%a4-%e0%a6%aa%e0%a6%be%e0%a6%95%e0%a6%bf/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%a6%e0%a6%be%e0%a6%a6%e0%a6%be%e0%a6%b0-%e0%a6%b8%e0%a7%8d%e0%a6%ae%e0%a7%83%e0%a6%a4%e0%a6%bf%e0%a6%ac%e0%a6%bf%e0%a6%9c%e0%a6%a1%e0%a6%bc%e0%a6%bf%e0%a6%a4-%e0%a6%aa%e0%a6%be%e0%a6%95%e0%a6%bf/</guid>
      <pubDate>Thu, 26 Nov 2026 07:51:44 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/hummam-kader.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/hummam-kader.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/hummam-kader.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দাদার স্মৃতিবিজড়িত পাকিস্তানের পার্লামেন্টে হুম্মাম, লিখলেন তিন প্রজন্মের গল্প" /&gt;&lt;/p&gt;&lt;p&gt;দাদা ছিলেন পাকিস্তানের জাতীয় পরিষদের স্পিকার। কয়েক প্রজন্ম পর নাতি হিসেবে সেই সংসদ ভবনে দাঁড়িয়ে দাদার প্রতিকৃতির সামনে ছবি তুলেছেন বাংলাদেশের সংসদ সদস্য হুম্মাম কাদের চৌধুরী। এবার সেই পাকিস্তান সফরেই দেশটির প্রধানমন্ত্রী মুহাম্মদ শাহবাজ শরিফের সঙ্গে সাক্ষাৎ করেছেন তিনি। বুধবার (২৫ নভেম্বর) দিবাগত রা&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%a6%e0%a6%be%e0%a6%a6%e0%a6%be%e0%a6%b0-%e0%a6%b8%e0%a7%8d%e0%a6%ae%e0%a7%83%e0%a6%a4%e0%a6%bf%e0%a6%ac%e0%a6%bf%e0%a6%9c%e0%a6%a1%e0%a6%bc%e0%a6%bf%e0%a6%a4-%e0%a6%aa%e0%a6%be%e0%a6%95%e0%a6%bf/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>দালাল ধরতে রোগী সেজে চমেকে এসআরবি, এক ঘণ্টায় আটক ২০</title>
      <link>https://suprobhat.com/%e0%a6%9a%e0%a6%ae%e0%a7%87%e0%a6%95%e0%a7%87-%e0%a6%b0%e0%a7%8b%e0%a6%97%e0%a7%80-%e0%a6%b8%e0%a7%87%e0%a6%9c%e0%a7%87-%e0%a6%8f%e0%a6%b8%e0%a6%86%e0%a6%b0%e0%a6%ac%e0%a6%bf%e0%a6%b0-%e0%a6%85/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%9a%e0%a6%ae%e0%a7%87%e0%a6%95%e0%a7%87-%e0%a6%b0%e0%a7%8b%e0%a6%97%e0%a7%80-%e0%a6%b8%e0%a7%87%e0%a6%9c%e0%a7%87-%e0%a6%8f%e0%a6%b8%e0%a6%86%e0%a6%b0%e0%a6%ac%e0%a6%bf%e0%a6%b0-%e0%a6%85/</guid>
      <pubDate>Thu, 26 Nov 2026 06:58:36 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/cmc-chittagong.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/cmc-chittagong.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/cmc-chittagong.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দালাল ধরতে রোগী সেজে চমেকে এসআরবি, এক ঘণ্টায় আটক ২০" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রাম মেডিকেল কলেজ (চমেক) হাসপাতালে দালালদের ধরতে রোগী ও স্বজন সেজে অভিযান চালাচ্ছে এসআরবি। বৃহস্পতিবার দুপুরে শুরু হওয়া এ অভিযানের প্রথম এক ঘণ্টায় অন্তত ১৫ থেকে ২০ জনকে আটক করা হয়েছে। তাঁদের হাসপাতালের ভেতরে পুলিশ ফাঁড়িতে রাখা হয়েছে। অভিযানে এসআরবির সদস্যরা সাধারণ পোশাকে হাসপাতালের বিভিন্ন ওয়ার&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%9a%e0%a6%ae%e0%a7%87%e0%a6%95%e0%a7%87-%e0%a6%b0%e0%a7%8b%e0%a6%97%e0%a7%80-%e0%a6%b8%e0%a7%87%e0%a6%9c%e0%a7%87-%e0%a6%8f%e0%a6%b8%e0%a6%86%e0%a6%b0%e0%a6%ac%e0%a6%bf%e0%a6%b0-%e0%a6%85/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>রায়হানের আশ্রয়দাতাসহ আটক ৬, অস্ত্র কারখানার সন্ধান; মিলল তাঁর পিস্তলও</title>
      <link>https://suprobhat.com/%e0%a6%b0%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a6%b9%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%86%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a6%af%e0%a6%bc%e0%a6%a6%e0%a6%be%e0%a6%a4%e0%a6%be%e0%a6%b8%e0%a6%b9-%e0%a6%86/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%b0%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a6%b9%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%86%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a6%af%e0%a6%bc%e0%a6%a6%e0%a6%be%e0%a6%a4%e0%a6%be%e0%a6%b8%e0%a6%b9-%e0%a6%86/</guid>
      <pubDate>Thu, 26 Nov 2026 06:46:52 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/raihan-ctg.jpg" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/raihan-ctg.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/raihan-ctg.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রায়হানের আশ্রয়দাতাসহ আটক ৬, অস্ত্র কারখানার সন্ধান; মিলল তাঁর পিস্তলও" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রামের শীর্ষ সন্ত্রাসী রায়হানের অস্ত্রের খোঁজ করতে গিয়ে বেরিয়ে এসেছে গোপন অস্ত্র তৈরির কারখানার সন্ধান। ফটিকছড়ির ভূজপুরে পুলিশের অভিযানে তার ব্যবহৃত পিস্তলসহ দুটি আগ্নেয়াস্ত্র, গুলি ও অস্ত্র তৈরির বিপুল সরঞ্জাম উদ্ধার হয়েছে। এ ঘটনায় রায়হানকে আশ্রয় দেওয়া এবং তার ব্যবহৃত পিস্তল নিজেদের হেফাজতে রা&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%b0%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a6%b9%e0%a6%be%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%86%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a6%af%e0%a6%bc%e0%a6%a6%e0%a6%be%e0%a6%a4%e0%a6%be%e0%a6%b8%e0%a6%b9-%e0%a6%86/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>যৌনতার খোলামেলা দৃশ্যেই কি ‘হান্টিং ওয়াইভস’-এর এত জনপ্রিয়তা?</title>
      <link>https://suprobhat.com/%e0%a6%af%e0%a7%8c%e0%a6%a8%e0%a6%a4%e0%a6%be%e0%a6%b0-%e0%a6%96%e0%a7%8b%e0%a6%b2%e0%a6%be%e0%a6%ae%e0%a7%87%e0%a6%b2%e0%a6%be-%e0%a6%a6%e0%a7%83%e0%a6%b6%e0%a7%8d%e0%a6%af%e0%a7%87%e0%a6%87/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%af%e0%a7%8c%e0%a6%a8%e0%a6%a4%e0%a6%be%e0%a6%b0-%e0%a6%96%e0%a7%8b%e0%a6%b2%e0%a6%be%e0%a6%ae%e0%a7%87%e0%a6%b2%e0%a6%be-%e0%a6%a6%e0%a7%83%e0%a6%b6%e0%a7%8d%e0%a6%af%e0%a7%87%e0%a6%87/</guid>
      <pubDate>Thu, 26 Nov 2026 06:23:46 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/the-hunting-wives.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/the-hunting-wives.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/the-hunting-wives.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যৌনতার খোলামেলা দৃশ্যেই কি ‘হান্টিং ওয়াইভস’-এর এত জনপ্রিয়তা?" /&gt;&lt;/p&gt;&lt;p&gt;নগ্নতা, পরকীয়া, নারীতে নারীতে ঘনিষ্ঠতা, যৌনতার প্রচলিত উপস্থাপনাকে চ্যালেঞ্জ করা নানা দৃশ্য। অভিজাত সমাজের চাকচিক্যের আড়ালে লুকিয়ে থাকা সম্পর্ক, প্রতারণা আর রাজনৈতিক ভণ্ডামি। সব মিলিয়ে মুক্তির পর থেকেই আলোচনায় নেটফ্লিক্সের সিরিজ ‘দ্য হান্টিং ওয়াইভস’। প্রথম মৌসুমের সাফল্যের পর এবার দ্বিতীয় মৌসুম নিয়ে&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%af%e0%a7%8c%e0%a6%a8%e0%a6%a4%e0%a6%be%e0%a6%b0-%e0%a6%96%e0%a7%8b%e0%a6%b2%e0%a6%be%e0%a6%ae%e0%a7%87%e0%a6%b2%e0%a6%be-%e0%a6%a6%e0%a7%83%e0%a6%b6%e0%a7%8d%e0%a6%af%e0%a7%87%e0%a6%87/">Suprobhat Bangladesh</source>
    </item>

      <pubDate>Wed, 11 Nov 2026 11:03:45 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/Ctg-board.jpg" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/Ctg-board.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/Ctg-board.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইংরেজির খাতা দেখতে চান ১১ হাজার শিক্ষার্থী, চট্টগ্রাম বোর্ডে পুনর্নিরীক্ষণের আবেদন পৌনে ১ লাখ" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রাম শিক্ষা বোর্ডে এইচএসসির ফল নিয়ে অসন্তোষের চিত্র মিলেছে খাতা পুনর্নিরীক্ষণের আবেদনে। এবার বোর্ডে ১ লাখ ১৭ হাজার ৬৯৯টি খাতা নতুন করে দেখার আবেদন করেছেন শিক্ষার্থীরা। এর মধ্যে সবচেয়ে বেশি আবেদন ইংরেজি বিষয়ে। বিষয়টির খাতা পুনর্নিরীক্ষণ চেয়েছেন ১১ হাজার ৬৬ জন। আগামী ২৩ নভেম্বর পুনর্নিরীক্ষণের ফল&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%87%e0%a6%82%e0%a6%b0%e0%a7%87%e0%a6%9c%e0%a6%bf%e0%a6%b0-%e0%a6%96%e0%a6%be%e0%a6%a4%e0%a6%be-%e0%a6%a6%e0%a7%87%e0%a6%96%e0%a6%a4%e0%a7%87-%e0%a6%9a%e0%a6%be%e0%a6%a8-%e0%a7%a7%e0%a7%a7/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>লন্ড্রি দোকানিকে পেটালেন এনসিপি নেত্রী, আওয়ামী লীগ-সংশ্লিষ্টতায় গ্রেপ্তার দেখাল পুলিশ</title>
      <link>https://suprobhat.com/%e0%a6%ac%e0%a6%be%e0%a6%95%e0%a6%b2%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%b2%e0%a6%a8%e0%a7%8d%e0%a6%a1%e0%a7%8d%e0%a6%b0%e0%a6%bf-%e0%a6%a6%e0%a7%8b%e0%a6%95%e0%a6%be%e0%a6%a8/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%ac%e0%a6%be%e0%a6%95%e0%a6%b2%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%b2%e0%a6%a8%e0%a7%8d%e0%a6%a1%e0%a7%8d%e0%a6%b0%e0%a6%bf-%e0%a6%a6%e0%a7%8b%e0%a6%95%e0%a6%be%e0%a6%a8/</guid>
      <pubDate>Wed, 11 Nov 2026 07:01:42 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/ncp.jpg" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/ncp.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/ncp.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="লন্ড্রি দোকানিকে পেটালেন এনসিপি নেত্রী, আওয়ামী লীগ-সংশ্লিষ্টতায় গ্রেপ্তার দেখাল পুলিশ" /&gt;&lt;/p&gt;&lt;p&gt;নিজের ফেসবুক পোস্টের প্রতিবাদ জানাতে গিয়ে এক লন্ড্রি ব্যবসায়ীকে দোকানে ঢুকে মারধর করেছেন জাতীয় নাগরিক পার্টির (এনসিপি) এক নেত্রী। শুধু তিনি নন, সঙ্গে থাকা কয়েকজন পুরুষও ওই ব্যবসায়ীর গায়ে হাত তোলেন। ঘটনার ভিডিও ধারণ করে সামাজিক যোগাযোগমাধ্যমে প্রকাশও করেছেন ওই নেত্রী। পরে ব্যবসায়ীর মুঠোফোনে নিষিদ্ধঘো&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%ac%e0%a6%be%e0%a6%95%e0%a6%b2%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%b2%e0%a6%a8%e0%a7%8d%e0%a6%a1%e0%a7%8d%e0%a6%b0%e0%a6%bf-%e0%a6%a6%e0%a7%8b%e0%a6%95%e0%a6%be%e0%a6%a8/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>রাঙ্গুনিয়ায় সিএনজি-মোটরসাইকেল মুখোমুখি সংঘর্ষে প্রাণ গেল তরুণের</title>
      <link>https://suprobhat.com/%e0%a6%b0%e0%a6%be%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%81%e0%a6%a8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%b8%e0%a6%bf%e0%a6%8f%e0%a6%a8%e0%a6%9c%e0%a6%bf-%e0%a6%ae%e0%a7%8b%e0%a6%9f/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%b0%e0%a6%be%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%81%e0%a6%a8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%b8%e0%a6%bf%e0%a6%8f%e0%a6%a8%e0%a6%9c%e0%a6%bf-%e0%a6%ae%e0%a7%8b%e0%a6%9f/</guid>
      <pubDate>Wed, 11 Nov 2026 06:31:35 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/rangunia.jpg" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/rangunia.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/rangunia.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাঙ্গুনিয়ায় সিএনজি-মোটরসাইকেল মুখোমুখি সংঘর্ষে প্রাণ গেল তরুণের" /&gt;&lt;/p&gt;&lt;p&gt;রাঙ্গুনিয়ায় সিএনজি অটোরিকশা ও মোটরসাইকেলের মুখোমুখি সংঘর্ষে সাহেদ (২০) নামে এক তরুণ নিহত হয়েছেন। বুধবার (১১ নভেম্বর) সকাল সাড়ে ৯টার দিকে উপজেলার পোমরা শান্তিরহাট-মালিরহাট সড়কে এ দুর্ঘটনা ঘটে। নিহত সাহেদ উপজেলার ৪ নম্বর ওয়ার্ডের বাসিন্দা দেলোয়ারের ছেলে। তিনি স্থানীয় শান্তিরহাটের তৈয়বিয়া হার্ডওয়্যার প&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%b0%e0%a6%be%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%81%e0%a6%a8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%b8%e0%a6%bf%e0%a6%8f%e0%a6%a8%e0%a6%9c%e0%a6%bf-%e0%a6%ae%e0%a7%8b%e0%a6%9f/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>জঙ্গল সলিমপুরের সন্ত্রাসী ইয়াছিনের ৬৫ দলিল রেজিস্ট্রি, সাময়িক বরখাস্ত সেই সাব-রেজিস্ট্রার</title>
      <link>https://suprobhat.com/%e0%a6%9c%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a6%b2-%e0%a6%b8%e0%a6%b2%e0%a6%bf%e0%a6%ae%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%b8/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%9c%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a6%b2-%e0%a6%b8%e0%a6%b2%e0%a6%bf%e0%a6%ae%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%b8/</guid>
      <pubDate>Wed, 11 Nov 2026 06:05:14 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/jongol-salimpur.jpg" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/jongol-salimpur.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/jongol-salimpur.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জঙ্গল সলিমপুরের সন্ত্রাসী ইয়াছিনের ৬৫ দলিল রেজিস্ট্রি, সাময়িক বরখাস্ত সেই সাব-রেজিস্ট্রার" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রামের জঙ্গল সলিমপুরে শীর্ষ সন্ত্রাসী ইয়াসিনের আস্তানায় গিয়ে এক দিনেই ৬৫টি জমির বিক্রয় দলিল রেজিস্ট্রি করে দিয়েছিলেন সীতাকুণ্ডের সাবেক সাব-রেজিস্ট্রার রায়হান হাবিব। তাঁর মাধ্যমে ওই এলাকায় মোট ৭৪টি দলিল সম্পাদনের অভিযোগ উঠেছে। এ ঘটনায় দুর্নীতি ও অসদাচরণের অভিযোগে তাঁকে সাময়িক বরখাস্ত করেছে আইন ও&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%9c%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a6%b2-%e0%a6%b8%e0%a6%b2%e0%a6%bf%e0%a6%ae%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%b8/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>নিজের অস্ত্র নেই, অন্যের পিস্তলের ছবি দেখিয়েই চাঁদা আদায় করতেন ‘বুলেট হৃদয়’</title>
      <link>https://suprobhat.com/%e0%a6%a8%e0%a6%bf%e0%a6%9c%e0%a7%87%e0%a6%b0-%e0%a6%85%e0%a6%b8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0-%e0%a6%a8%e0%a7%87%e0%a6%87-%e0%a6%85%e0%a6%a8%e0%a7%8d%e0%a6%af%e0%a7%87%e0%a6%b0-%e0%a6%aa/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%a8%e0%a6%bf%e0%a6%9c%e0%a7%87%e0%a6%b0-%e0%a6%85%e0%a6%b8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0-%e0%a6%a8%e0%a7%87%e0%a6%87-%e0%a6%85%e0%a6%a8%e0%a7%8d%e0%a6%af%e0%a7%87%e0%a6%b0-%e0%a6%aa/</guid>
      <pubDate>Wed, 11 Nov 2026 05:50:24 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/bulet-hridoy.jpg" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/bulet-hridoy.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/bulet-hridoy.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নিজের অস্ত্র নেই, অন্যের পিস্তলের ছবি দেখিয়েই চাঁদা আদায় করতেন ‘বুলেট হৃদয়’" /&gt;&lt;/p&gt;&lt;p&gt;অস্ত্র হাতে না থাকলেও ভয় দেখানোর উপকরণ ছিল মুঠোফোনে। অন্যের পিস্তলের ছবি ও ভিডিও, সঙ্গে হুমকিমূলক কথোপকথনের অডিও। এসব পাঠিয়ে প্রবাসী, ব্যবসায়ী ও বাড়ি নির্মাণকারীদের কাছে চাঁদা দাবি করার অভিযোগ উঠেছে রাউজানের মো. হৃদয় আহম্মেদ শাওন ওরফে ‘বুলেট হৃদয়ের’ বিরুদ্ধে। সামাজিক যোগাযোগমাধ্যমে আটটি পিস্তল সাজিয়&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%a8%e0%a6%bf%e0%a6%9c%e0%a7%87%e0%a6%b0-%e0%a6%85%e0%a6%b8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0-%e0%a6%a8%e0%a7%87%e0%a6%87-%e0%a6%85%e0%a6%a8%e0%a7%8d%e0%a6%af%e0%a7%87%e0%a6%b0-%e0%a6%aa/">Suprobhat Bangladesh</source>
    </item>

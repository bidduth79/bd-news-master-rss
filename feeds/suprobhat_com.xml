      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/Mirsoray.jpg" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/Mirsoray.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/Mirsoray.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মিয়ানমারে সার পাচার, মিরসরাইয়ে বিএনপি-ছাত্রদলের সাবেক ৩ নেতা গ্রেপ্তার" /&gt;&lt;/p&gt;&lt;p&gt;মিরসরাইয়ের উপকূলীয় এলাকা দিয়ে মিয়ানমারে সার পাচারের অভিযোগে বিএনপি ও ছাত্রদলের রাজনীতির সঙ্গে সম্পৃক্ত তিনজনকে গ্রেপ্তার করেছে পুলিশ। তাদের মধ্যে রয়েছেন বিএনপির সাবেক এক নেতা ও তাঁর ছেলে। রোববার (৮ নভেম্বর) উপজেলার ওচমানপুর ইউনিয়নের পৃথক এলাকায় অভিযান চালিয়ে তাদের গ্রেপ্তার করা হয়। গ্রেপ্তার ব্যক্তি&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%ae%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%a8%e0%a6%ae%e0%a6%be%e0%a6%b0%e0%a7%87-%e0%a6%b8%e0%a6%be%e0%a6%b0-%e0%a6%aa%e0%a6%be%e0%a6%9a%e0%a6%be%e0%a6%b0-%e0%a6%ae%e0%a6%bf%e0%a6%b0/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>‘শেখ হাসিনা সন্ত্রাসী, তাকে পাসপোর্ট-এনআইডি দেবে না সরকার’</title>
      <link>https://suprobhat.com/%e0%a6%b6%e0%a7%87%e0%a6%96-%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%a8%e0%a6%be-%e0%a6%b8%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%b8%e0%a7%80-%e0%a6%a4%e0%a6%be/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%b6%e0%a7%87%e0%a6%96-%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%a8%e0%a6%be-%e0%a6%b8%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%b8%e0%a7%80-%e0%a6%a4%e0%a6%be/</guid>
      <pubDate>Mon, 09 Nov 2026 08:41:14 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/foreign-minister-1.jpg" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/foreign-minister-1.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/foreign-minister-1.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘শেখ হাসিনা সন্ত্রাসী, তাকে পাসপোর্ট-এনআইডি দেবে না সরকার’" /&gt;&lt;/p&gt;&lt;p&gt;ক্ষমতাচ্যুত প্রধানমন্ত্রী শেখ হাসিনাকে সন্ত্রাসী আখ্যা দিয়ে পররাষ্ট্র প্রতিমন্ত্রী হুমায়ুন কবির বলেছেন, বাংলাদেশ কোনো সন্ত্রাসীকে পাসপোর্ট বা জাতীয় পরিচয়পত্র (এনআইডি) দেবে না। তবে ভারত-বাংলাদেশের বিদ্যমান প্রত্যর্পণ চুক্তির আওতায় শেখ হাসিনাকে দেশে ফেরত চাওয়া হবে। সোমবার (৯ নভেম্বর) পররাষ্ট্র মন্ত্রণ&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%b6%e0%a7%87%e0%a6%96-%e0%a6%b9%e0%a6%be%e0%a6%b8%e0%a6%bf%e0%a6%a8%e0%a6%be-%e0%a6%b8%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%b8%e0%a7%80-%e0%a6%a4%e0%a6%be/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>দক্ষিণ বুড়িশ্চরে সড়ক পরিদর্শনে বিএনপি নেতারা</title>
      <link>https://suprobhat.com/%e0%a6%a6%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%bf%e0%a6%a3-%e0%a6%ac%e0%a7%81%e0%a6%a1%e0%a6%bc%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%9a%e0%a6%b0%e0%a7%87-%e0%a6%b8%e0%a6%a1%e0%a6%bc%e0%a6%95-%e0%a6%aa/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%a6%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%bf%e0%a6%a3-%e0%a6%ac%e0%a7%81%e0%a6%a1%e0%a6%bc%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%9a%e0%a6%b0%e0%a7%87-%e0%a6%b8%e0%a6%a1%e0%a6%bc%e0%a6%95-%e0%a6%aa/</guid>
      <pubDate>Mon, 09 Nov 2026 08:17:51 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/budishchor.jpg" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/budishchor.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/budishchor.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দক্ষিণ বুড়িশ্চরে সড়ক পরিদর্শনে বিএনপি নেতারা" /&gt;&lt;/p&gt;&lt;p&gt;দক্ষিণ বুড়িশ্চরে দীর্ঘদিনের কাঁচা রাস্তা পাকাকরণ ও সড়কের অবৈধ প্রতিবন্ধকতা দূর করার উদ্যোগ নিয়েছেন বিএনপি নেতারা। এ লক্ষ্যে সোমবার বাঁশতল থেকে হিন্দুবাড়ি পর্যন্ত সড়কটি পরিদর্শন করেন তাঁরা। পরিদর্শনকালে স্থানীয় বাসিন্দাদের সঙ্গে সড়কের বিভিন্ন সমস্যা নিয়ে আলোচনা করেন নেতারা। এ সময় এলাকাবাসী দীর্ঘদিনের&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%a6%e0%a6%95%e0%a7%8d%e0%a6%b7%e0%a6%bf%e0%a6%a3-%e0%a6%ac%e0%a7%81%e0%a6%a1%e0%a6%bc%e0%a6%bf%e0%a6%b6%e0%a7%8d%e0%a6%9a%e0%a6%b0%e0%a7%87-%e0%a6%b8%e0%a6%a1%e0%a6%bc%e0%a6%95-%e0%a6%aa/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>পণ্য পরিবহনে ডলারে হিসাব কষতে চায় রেল</title>
      <link>https://suprobhat.com/%e0%a6%aa%e0%a6%a3%e0%a7%8d%e0%a6%af-%e0%a6%aa%e0%a6%b0%e0%a6%bf%e0%a6%ac%e0%a6%b9%e0%a6%a8%e0%a7%87-%e0%a6%a1%e0%a6%b2%e0%a6%be%e0%a6%b0%e0%a7%87-%e0%a6%b9%e0%a6%bf%e0%a6%b8%e0%a6%be%e0%a6%ac/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%aa%e0%a6%a3%e0%a7%8d%e0%a6%af-%e0%a6%aa%e0%a6%b0%e0%a6%bf%e0%a6%ac%e0%a6%b9%e0%a6%a8%e0%a7%87-%e0%a6%a1%e0%a6%b2%e0%a6%be%e0%a6%b0%e0%a7%87-%e0%a6%b9%e0%a6%bf%e0%a6%b8%e0%a6%be%e0%a6%ac/</guid>
      <pubDate>Mon, 09 Nov 2026 08:01:29 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/container-railway.jpg" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/container-railway.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/container-railway.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পণ্য পরিবহনে ডলারে হিসাব কষতে চায় রেল" /&gt;&lt;/p&gt;&lt;p&gt;আমদানি-রফতানির কনটেইনার পরিবহনে এবার ডলারের হিসাবে ভাড়া নির্ধারণ করতে চায় বাংলাদেশ রেলওয়ে। সংস্থাটির হিসাবে, টাকার অঙ্কে কয়েক দফা ভাড়া বাড়লেও ডলারের হিসাবে ১৯৯২ সালের তুলনায় এখন কম আদায় হচ্ছে। এ অবস্থায় ভবিষ্যতে ভাড়া পুনর্নির্ধারণের সময় ডলারের বিনিময় হারকে ভিত্তি ধরার উদ্যোগ নেয়া হয়েছে। পাশাপাশি প্র&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%aa%e0%a6%a3%e0%a7%8d%e0%a6%af-%e0%a6%aa%e0%a6%b0%e0%a6%bf%e0%a6%ac%e0%a6%b9%e0%a6%a8%e0%a7%87-%e0%a6%a1%e0%a6%b2%e0%a6%be%e0%a6%b0%e0%a7%87-%e0%a6%b9%e0%a6%bf%e0%a6%b8%e0%a6%be%e0%a6%ac/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>লোহাগাড়ায় হানিফের ধাক্কায় প্রাণ গেল বৃদ্ধের, গাড়ি রেখে পালালেন চালক</title>
      <link>https://suprobhat.com/%e0%a6%b2%e0%a7%8b%e0%a6%b9%e0%a6%be%e0%a6%97%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%b9%e0%a6%be%e0%a6%a8%e0%a6%bf%e0%a6%ab%e0%a7%87%e0%a6%b0-%e0%a6%a7%e0%a6%be%e0%a6%95%e0%a7%8d/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%b2%e0%a7%8b%e0%a6%b9%e0%a6%be%e0%a6%97%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%b9%e0%a6%be%e0%a6%a8%e0%a6%bf%e0%a6%ab%e0%a7%87%e0%a6%b0-%e0%a6%a7%e0%a6%be%e0%a6%95%e0%a7%8d/</guid>
      <pubDate>Mon, 09 Nov 2026 07:16:00 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/lohagara.jpg" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/lohagara.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/lohagara.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="লোহাগাড়ায় হানিফের ধাক্কায় প্রাণ গেল বৃদ্ধের, গাড়ি রেখে পালালেন চালক" /&gt;&lt;/p&gt;&lt;p&gt;লোহাগাড়ায় হানিফ পরিবহনের ধাক্কায় সাইকেল আরোহী এক বৃদ্ধ নিহত হয়েছেন। সোমবার চট্টগ্রাম-কক্সবাজার মহাসড়কের লোহাগাড়ার চুনতি অংশে এ দুর্ঘটনা ঘটে। নিহত মোহাম্মদ শামসুল আলমের (৬০) বাড়ি উপজেলার চুনতি শাহ সাহেব গেট এলাকায়। তিনি মৃত আবদুল জলিলের ছেলে। প্রত্যক্ষদর্শীরা জানান, সোমবার বেলা ১১টা ২০ মিনিটের দিকে চ&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%b2%e0%a7%8b%e0%a6%b9%e0%a6%be%e0%a6%97%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%b9%e0%a6%be%e0%a6%a8%e0%a6%bf%e0%a6%ab%e0%a7%87%e0%a6%b0-%e0%a6%a7%e0%a6%be%e0%a6%95%e0%a7%8d/">Suprobhat Bangladesh</source>
    </item>

      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/ccc.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/ccc.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/ccc.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডিপো-টার্মিনাল শিল্পাঞ্চলের ‘বাকি’ খাতা খুলছে চসিক" /&gt;&lt;/p&gt;&lt;p&gt;বন্দরের গৃহকর নিয়ে দীর্ঘদিনের বিরোধ মিটিয়ে বছরে ২২৪ কোটি টাকা আদায়ের পথ তৈরি হয়েছে চট্টগ্রাম সিটি করপোরেশনের (চসিক)। এবার নজর বন্দরকেন্দ্রিক ৩৬টি কনটেইনার ডিপো ও টার্মিনাল এবং বিসিক শিল্প এলাকার ২৪৬টি কারখানার দিকে। এসব প্রতিষ্ঠানের কাছ থেকে প্রাপ্য পৌরকর আদায়ে হিসাব কষতে শুরু করেছে সংস্থাটি। কত টাক&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%a1%e0%a6%bf%e0%a6%aa%e0%a7%8b-%e0%a6%9f%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%ae%e0%a6%bf%e0%a6%a8%e0%a6%be%e0%a6%b2-%e0%a6%93-%e0%a6%b6%e0%a6%bf%e0%a6%b2%e0%a7%8d%e0%a6%aa%e0%a6%be%e0%a6%9e/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>ডাকসু ভিপি সাদিক কায়েমের বাড়িতে আগুনের চেষ্টায় শনাক্ত ৩, মামলা</title>
      <link>https://suprobhat.com/%e0%a6%a1%e0%a6%be%e0%a6%95%e0%a6%b8%e0%a7%81-%e0%a6%ad%e0%a6%bf%e0%a6%aa%e0%a6%bf-%e0%a6%b8%e0%a6%be%e0%a6%a6%e0%a6%bf%e0%a6%95-%e0%a6%95%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%ae%e0%a7%87/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%a1%e0%a6%be%e0%a6%95%e0%a6%b8%e0%a7%81-%e0%a6%ad%e0%a6%bf%e0%a6%aa%e0%a6%bf-%e0%a6%b8%e0%a6%be%e0%a6%a6%e0%a6%bf%e0%a6%95-%e0%a6%95%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%ae%e0%a7%87/</guid>
      <pubDate>Sun, 22 Nov 2026 19:18:17 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/khagrachori-.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/khagrachori-.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/khagrachori-.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডাকসু ভিপি সাদিক কায়েমের বাড়িতে আগুনের চেষ্টায় শনাক্ত ৩, মামলা" /&gt;&lt;/p&gt;&lt;p&gt;ঢাকা বিশ্ববিদ্যালয় কেন্দ্রীয় ছাত্র সংসদের (ডাকসু) ভিপি সাদিক কায়েমের খাগড়াছড়ির পৈতৃক বাড়িতে আগুন দেওয়ার চেষ্টার ঘটনায় তিনজনকে শনাক্ত করেছে পুলিশ। এ ঘটনায় মামলা হয়েছে। রোববার বিকালে সাদিক কায়েমের বাবা মো. আবুল কাশেম বাদী হয়ে তিনজনের নাম দিয়ে অজ্ঞাত আরও সাত থেকে আটজনকে আসামি করে মামলাটি দায়ের করেন বলে&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%a1%e0%a6%be%e0%a6%95%e0%a6%b8%e0%a7%81-%e0%a6%ad%e0%a6%bf%e0%a6%aa%e0%a6%bf-%e0%a6%b8%e0%a6%be%e0%a6%a6%e0%a6%bf%e0%a6%95-%e0%a6%95%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%ae%e0%a7%87/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>এমপির সুপারিশে মন গলল কেন্দ্রের, ফটিকছড়ি যুবদলের কমিটি পুনর্বহাল</title>
      <link>https://suprobhat.com/%e0%a6%8f%e0%a6%ae%e0%a6%aa%e0%a6%bf%e0%a6%b0-%e0%a6%b8%e0%a7%81%e0%a6%aa%e0%a6%be%e0%a6%b0%e0%a6%bf%e0%a6%b6%e0%a7%87-%e0%a6%ae%e0%a6%a8-%e0%a6%97%e0%a6%b2%e0%a6%b2-%e0%a6%95%e0%a7%87%e0%a6%a8/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%8f%e0%a6%ae%e0%a6%aa%e0%a6%bf%e0%a6%b0-%e0%a6%b8%e0%a7%81%e0%a6%aa%e0%a6%be%e0%a6%b0%e0%a6%bf%e0%a6%b6%e0%a7%87-%e0%a6%ae%e0%a6%a8-%e0%a6%97%e0%a6%b2%e0%a6%b2-%e0%a6%95%e0%a7%87%e0%a6%a8/</guid>
      <pubDate>Sun, 22 Nov 2026 18:11:44 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/fatikchari-jubodol.jpg" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/fatikchari-jubodol.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/fatikchari-jubodol.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এমপির সুপারিশে মন গলল কেন্দ্রের, ফটিকছড়ি যুবদলের কমিটি পুনর্বহাল" /&gt;&lt;/p&gt;&lt;p&gt;যুবলীগের নেতা-কর্মীদের হামলায় যুবদল ও ছাত্রদলের নেতা-কর্মীরা আহত হওয়ার কয়েক ঘণ্টার মাথায় বিলুপ্ত করা হয়েছিল ফটিকছড়ি উপজেলা যুবদলের কমিটি। তবে সেই সিদ্ধান্তে অনড় থাকেনি কেন্দ্রীয় যুবদল। বিলুপ্তির ২১ ঘণ্টার মাথায় স্থানীয় সংসদ সদস্য সরোয়ার আলমগীর ও বিএনপির কেন্দ্রীয় নেতাদের সঙ্গে আলোচনার পর কমিটিটি পুন&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%8f%e0%a6%ae%e0%a6%aa%e0%a6%bf%e0%a6%b0-%e0%a6%b8%e0%a7%81%e0%a6%aa%e0%a6%be%e0%a6%b0%e0%a6%bf%e0%a6%b6%e0%a7%87-%e0%a6%ae%e0%a6%a8-%e0%a6%97%e0%a6%b2%e0%a6%b2-%e0%a6%95%e0%a7%87%e0%a6%a8/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>চবির শাটল ট্রেনে আগুন দেওয়ার চেষ্টা</title>
      <link>https://suprobhat.com/%e0%a6%9a%e0%a6%ac%e0%a6%bf%e0%a6%b0-%e0%a6%b6%e0%a6%be%e0%a6%9f%e0%a6%b2-%e0%a6%9f%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%a8%e0%a7%87-%e0%a6%85%e0%a6%97%e0%a7%8d%e0%a6%a8%e0%a6%bf%e0%a6%b8%e0%a6%82/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%9a%e0%a6%ac%e0%a6%bf%e0%a6%b0-%e0%a6%b6%e0%a6%be%e0%a6%9f%e0%a6%b2-%e0%a6%9f%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%a8%e0%a7%87-%e0%a6%85%e0%a6%97%e0%a7%8d%e0%a6%a8%e0%a6%bf%e0%a6%b8%e0%a6%82/</guid>
      <pubDate>Sun, 22 Nov 2026 17:55:58 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/cu-shutol.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/cu-shutol.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/cu-shutol.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চবির শাটল ট্রেনে আগুন দেওয়ার চেষ্টা" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রাম বিশ্ববিদ্যালয়ের শিক্ষার্থীদের যাতায়াতের শাটল ট্রেনে অগ্নিসংযোগের চেষ্টা হয়েছে। রোববার রাতে নগরীর বটতলী রেলস্টেশনে দাঁড়িয়ে থাকা একটি ট্রেনের বগিতে কেরোসিন ঢেলে আগুন দেওয়ার চেষ্টা করা হয়। তবে রেলওয়ের কর্মীদের তাৎক্ষণিক তৎপরতায় আগুন নিয়ন্ত্রণে আসায় বড় ধরনের দুর্ঘটনা এড়ানো গেছে। রাত ৮টা ৫ মিনি&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%9a%e0%a6%ac%e0%a6%bf%e0%a6%b0-%e0%a6%b6%e0%a6%be%e0%a6%9f%e0%a6%b2-%e0%a6%9f%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%a8%e0%a7%87-%e0%a6%85%e0%a6%97%e0%a7%8d%e0%a6%a8%e0%a6%bf%e0%a6%b8%e0%a6%82/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>সিএমপির পুলিশ ভ্যান উধাও, দায়িত্বে অবহেলায় এসআইসহ বরখাস্ত ৪ সদস্য</title>
      <link>https://suprobhat.com/%e0%a6%b8%e0%a6%bf%e0%a6%8f%e0%a6%ae%e0%a6%aa%e0%a6%bf%e0%a6%b0-%e0%a6%aa%e0%a7%81%e0%a6%b2%e0%a6%bf%e0%a6%b6-%e0%a6%ad%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%a8-%e0%a6%89%e0%a6%a7%e0%a6%be%e0%a6%93/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%b8%e0%a6%bf%e0%a6%8f%e0%a6%ae%e0%a6%aa%e0%a6%bf%e0%a6%b0-%e0%a6%aa%e0%a7%81%e0%a6%b2%e0%a6%bf%e0%a6%b6-%e0%a6%ad%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%a8-%e0%a6%89%e0%a6%a7%e0%a6%be%e0%a6%93/</guid>
      <pubDate>Sun, 22 Nov 2026 17:46:46 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/cmp-police-van.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/cmp-police-van.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/cmp-police-van.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সিএমপির পুলিশ ভ্যান উধাও, দায়িত্বে অবহেলায় এসআইসহ বরখাস্ত ৪ সদস্য" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রামে পুলিশ লাইনসের সামনে থেকে পুলিশ ভ্যান উধাও হওয়ার ঘটনায় দায়িত্বে অবহেলার দায়ে এক উপপরিদর্শকসহ (এসআই) চার পুলিশ সদস্যকে সাময়িক বরখাস্ত করা হয়েছে। রোববার (২২ নভেম্বর) চট্টগ্রাম মেট্রোপলিটন পুলিশ (সিএমপি) এক অফিস আদেশে তাদের বরখাস্ত করে। সিএমপির জনসংযোগ কর্মকর্তা সহকারী পুলিশ কমিশনার আমিনুর রশ&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%b8%e0%a6%bf%e0%a6%8f%e0%a6%ae%e0%a6%aa%e0%a6%bf%e0%a6%b0-%e0%a6%aa%e0%a7%81%e0%a6%b2%e0%a6%bf%e0%a6%b6-%e0%a6%ad%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%a8-%e0%a6%89%e0%a6%a7%e0%a6%be%e0%a6%93/">Suprobhat Bangladesh</source>
    </item>

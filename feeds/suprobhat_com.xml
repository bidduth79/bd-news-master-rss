      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/ctg-court.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/ctg-court.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/ctg-court.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অবৈধ সম্পদের পাহাড়, দুদকের মামলায় ৬ বছরের সাজা টেকনাফের আবু তাহেরের" /&gt;&lt;/p&gt;&lt;p&gt;জ্ঞাত আয়ের সঙ্গে অসংগতিপূর্ণ প্রায় ২ কোটি ৯১ লাখ টাকার সম্পদ অর্জন এবং সম্পদ বিবরণীতে তথ্য গোপনের মামলায় টেকনাফের আবু তাহেরকে ছয় বছরের কারাদণ্ড দিয়েছেন আদালত। একই সঙ্গে তাঁকে ৩ কোটি ৭৭ লাখ ৭১ হাজার ২০৮ টাকা জরিমানা করা হয়েছে। সোমবার (১৬ নভেম্বর) সকালে চট্টগ্রাম বিভাগীয় বিশেষ জজ আদালতের বিচারক মো. মি&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%85%e0%a6%ac%e0%a7%88%e0%a6%a7-%e0%a6%b8%e0%a6%ae%e0%a7%8d%e0%a6%aa%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%aa%e0%a6%be%e0%a6%b9%e0%a6%be%e0%a6%a1%e0%a6%bc-%e0%a6%a6%e0%a7%81%e0%a6%a6%e0%a6%95/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>চকরিয়া ভেঙে  হল নতুন ‘মাতামুহুরী থানা’</title>
      <link>https://suprobhat.com/%e0%a6%9a%e0%a6%95%e0%a6%b0%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be-%e0%a6%ad%e0%a7%87%e0%a6%99%e0%a7%87-%e0%a6%b9%e0%a6%b2-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%ae%e0%a6%be%e0%a6%a4/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%9a%e0%a6%95%e0%a6%b0%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be-%e0%a6%ad%e0%a7%87%e0%a6%99%e0%a7%87-%e0%a6%b9%e0%a6%b2-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%ae%e0%a6%be%e0%a6%a4/</guid>
      <pubDate>Mon, 16 Nov 2026 07:05:23 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/chakaria-thana.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/chakaria-thana.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/chakaria-thana.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চকরিয়া ভেঙে  হল নতুন ‘মাতামুহুরী থানা’" /&gt;&lt;/p&gt;&lt;p&gt;দেশে নতুন দুটি থানা গঠনের অনুমোদন দিয়েছে সরকার। এর মধ্যে চট্টগ্রাম বিভাগের কক্সবাজার জেলার চকরিয়া থানাকে বিভক্ত করে গঠন করা হচ্ছে ‘মাতামুহুরী থানা’। একই সঙ্গে বগুড়ায় গঠন করা হবে মোকামতলা থানা। সোমবার (১৬ নভেম্বর) প্রশাসনিক পুনর্বিন্যাস সংক্রান্ত জাতীয় বাস্তবায়ন কমিটির (নিকার) সভায় এ অনুমোদন দেওয়া হয়&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%9a%e0%a6%95%e0%a6%b0%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be-%e0%a6%ad%e0%a7%87%e0%a6%99%e0%a7%87-%e0%a6%b9%e0%a6%b2-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%ae%e0%a6%be%e0%a6%a4/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>এসপি জাহাংগীরের ‘নেটওয়ার্ক’ খুঁজছে পুলিশ</title>
      <link>https://suprobhat.com/%e0%a6%8f%e0%a6%b8%e0%a6%aa%e0%a6%bf-%e0%a6%9c%e0%a6%be%e0%a6%b9%e0%a6%be%e0%a6%82%e0%a6%97%e0%a7%80%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a7%87%e0%a6%9f%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%8f%e0%a6%b8%e0%a6%aa%e0%a6%bf-%e0%a6%9c%e0%a6%be%e0%a6%b9%e0%a6%be%e0%a6%82%e0%a6%97%e0%a7%80%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a7%87%e0%a6%9f%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be/</guid>
      <pubDate>Mon, 16 Nov 2026 06:18:08 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/sp-jahangir.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/sp-jahangir.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/sp-jahangir.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এসপি জাহাংগীরের ‘নেটওয়ার্ক’ খুঁজছে পুলিশ" /&gt;&lt;/p&gt;&lt;p&gt;সরকার উৎখাতের কথিত পরিকল্পনায় একা ছিলেন না এসপি মোহাম্মদ জাহাংগীর আলম, এমন সন্দেহ থেকেই তদন্তের পরিধি বাড়াচ্ছে পুলিশ। দেশের ভেতরে ও বাইরে কারা তাঁর সঙ্গে যুক্ত ছিলেন, কারা অর্থ ও প্রযুক্তিগত সহায়তা দিয়েছেন, এমনকি কোনো সংস্থা বা গোষ্ঠীর সংশ্লিষ্টতা ছিল কি না, সেসব খতিয়ে দেখতে চায় তদন্তকারী সংস্থা। এর&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%8f%e0%a6%b8%e0%a6%aa%e0%a6%bf-%e0%a6%9c%e0%a6%be%e0%a6%b9%e0%a6%be%e0%a6%82%e0%a6%97%e0%a7%80%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a7%87%e0%a6%9f%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>চবির হীরকজয়ন্তী উৎসব ঘিরে ফিলোসোফি অ্যালামনাইয়ের প্রস্তুতি সভা</title>
      <link>https://suprobhat.com/%e0%a6%9a%e0%a6%ac%e0%a6%bf%e0%a6%b0-%e0%a6%b9%e0%a7%80%e0%a6%b0%e0%a6%95%e0%a6%9c%e0%a6%af%e0%a6%bc%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%80-%e0%a6%89%e0%a7%8e%e0%a6%b8%e0%a6%ac-%e0%a6%98%e0%a6%bf/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%9a%e0%a6%ac%e0%a6%bf%e0%a6%b0-%e0%a6%b9%e0%a7%80%e0%a6%b0%e0%a6%95%e0%a6%9c%e0%a6%af%e0%a6%bc%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%80-%e0%a6%89%e0%a7%8e%e0%a6%b8%e0%a6%ac-%e0%a6%98%e0%a6%bf/</guid>
      <pubDate>Mon, 16 Nov 2026 05:37:15 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/cu-philosopy.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/cu-philosopy.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/cu-philosopy.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চবির হীরকজয়ন্তী উৎসব ঘিরে ফিলোসোফি অ্যালামনাইয়ের প্রস্তুতি সভা" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রাম বিশ্ববিদ্যালয়ের (চবি) ৬০ বছর পূর্তি বা হীরকজয়ন্তী উৎসব সামনে রেখে প্রস্তুতি শুরু করেছে ফিলোসোফি অ্যালামনাই অ্যাসোসিয়েশন। উৎসবকে সফল ও স্মরণীয় করে তুলতে প্রাক্তন শিক্ষার্থীদের অংশগ্রহণ নিশ্চিত করা এবং বিশ্ববিদ্যালয় কর্তৃপক্ষকে আর্থিক অনুদানসহ সার্বিক সহযোগিতা দেওয়ার বিষয়ে আলোচনা করেছে সংগঠন&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%9a%e0%a6%ac%e0%a6%bf%e0%a6%b0-%e0%a6%b9%e0%a7%80%e0%a6%b0%e0%a6%95%e0%a6%9c%e0%a6%af%e0%a6%bc%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%80-%e0%a6%89%e0%a7%8e%e0%a6%b8%e0%a6%ac-%e0%a6%98%e0%a6%bf/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>বেপরোয়া ঈগল বাস, পটিয়ায় মোটরসাইকেলের সঙ্গে সংঘর্ষে প্রাণ গেল প্রবাসফেরত তরুণের</title>
      <link>https://suprobhat.com/%e0%a6%ac%e0%a7%87%e0%a6%aa%e0%a6%b0%e0%a7%8b%e0%a6%af%e0%a6%bc%e0%a6%be-%e0%a6%88%e0%a6%97%e0%a6%b2-%e0%a6%ac%e0%a6%be%e0%a6%b8-%e0%a6%aa%e0%a6%9f%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%af/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%ac%e0%a7%87%e0%a6%aa%e0%a6%b0%e0%a7%8b%e0%a6%af%e0%a6%bc%e0%a6%be-%e0%a6%88%e0%a6%97%e0%a6%b2-%e0%a6%ac%e0%a6%be%e0%a6%b8-%e0%a6%aa%e0%a6%9f%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%af/</guid>
      <pubDate>Mon, 16 Nov 2026 05:21:18 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/patiya-eagle-bus-accident.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/patiya-eagle-bus-accident.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/patiya-eagle-bus-accident.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বেপরোয়া ঈগল বাস, পটিয়ায় মোটরসাইকেলের সঙ্গে সংঘর্ষে প্রাণ গেল প্রবাসফেরত তরুণের" /&gt;&lt;/p&gt;&lt;p&gt;পটিয়ায় ঈগল পরিবহনের একটি বাসের সঙ্গে মোটরসাইকেলের মুখোমুখি সংঘর্ষে প্রাণ গেছে মো. ফারাজ (২১) নামে এক প্রবাসফেরত তরুণের। এ ঘটনায় মোটরসাইকেলের অপর আরোহী গুরুতর আহত হয়েছেন। সোমবার (১৬ নভেম্বর) সকাল ৯টার দিকে উপজেলার কুসুমপুরা ইউনিয়নের বোর্ড অফিস এলাকায় এ দুর্ঘটনা ঘটে। নিহত ফারাজ লোহাগাড়া উপজেলার মোহাম্&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%ac%e0%a7%87%e0%a6%aa%e0%a6%b0%e0%a7%8b%e0%a6%af%e0%a6%bc%e0%a6%be-%e0%a6%88%e0%a6%97%e0%a6%b2-%e0%a6%ac%e0%a6%be%e0%a6%b8-%e0%a6%aa%e0%a6%9f%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%af/">Suprobhat Bangladesh</source>
    </item>

      <pubDate>Mon, 09 Nov 2026 15:39:28 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/sazzad.jpg" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/sazzad.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/sazzad.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ছোট সাজ্জাদকে ধরিয়ে দেওয়ায় পাঁচলাইশে যুবককে গুলি!" /&gt;&lt;/p&gt;&lt;p&gt;নগরের পাঁচলাইশে ইমতিয়াজ সুলতান ইকরাম (২৮) নামে এক যুবককে গুলি করেছে দুর্বৃত্তরা। ঢাকার বসুন্ধরা সিটি শপিং মলে চট্টগ্রামের সন্ত্রাসী হিসেবে পরিচিত ছোট সাজ্জাদকে পুলিশে ধরিয়ে দেওয়াকে কেন্দ্র করে বিরোধের জেরে এ হামলা হয়েছে বলে অভিযোগ করেছেন ইকরামের স্ত্রী। সোমবার (৯ নভেম্বর) দুপুর ১টার দিকে চট্টগ্রাম শ&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%9b%e0%a7%8b%e0%a6%9f-%e0%a6%b8%e0%a6%be%e0%a6%9c%e0%a7%8d%e0%a6%9c%e0%a6%be%e0%a6%a6%e0%a6%95%e0%a7%87-%e0%a6%a7%e0%a6%b0%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%a6%e0%a7%87%e0%a6%93/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>ইউসিবির হাত ধরে নতুন প্রাণ পেল আগ্রাবাদ জাম্বুরী মাঠ</title>

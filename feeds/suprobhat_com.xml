      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/Mayor-sahadat-goribullah-shah-majar.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/Mayor-sahadat-goribullah-shah-majar.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/Mayor-sahadat-goribullah-shah-majar.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘ডেকচি’ গায়েবের অভিযোগ, মাজারে গিয়ে হিসাব মেলালেন প্রশাসক শাহাদাত" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রামের হযরত খাজা গরীব উল্লাহ শাহ (রহ.) মাজারের ডেকচি নিয়ে বিতর্ক এখন সামাজিক যোগাযোগমাধ্যমে। মাজারের ৬৮টি ডেকচি চুরির অভিযোগ তুলে চট্টগ্রাম সিটি করপোরেশনের (চসিক) প্রশাসক ডা. শাহাদাত হোসেন ও তাঁর অনুসারীদের কাঠগড়ায় দাঁড় করাচ্ছেন বিভিন্ন ব্যক্তি। অভিযোগের জবাবে এবার মাজারে গিয়ে সরেজমিনে ডেকচিসহ &lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%a1%e0%a7%87%e0%a6%95%e0%a6%9a%e0%a6%bf-%e0%a6%97%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%ac%e0%a7%87%e0%a6%b0-%e0%a6%85%e0%a6%ad%e0%a6%bf%e0%a6%af%e0%a7%8b%e0%a6%97/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>প্রিন্টিং মেশিনের নামে ৪৬ কোটি টাকার চালান, এলো জাল সিগারেটের স্ট্যাম্প-প্রসাধনী!</title>
      <link>https://suprobhat.com/%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%bf%e0%a6%a8%e0%a7%8d%e0%a6%9f%e0%a6%bf%e0%a6%82-%e0%a6%ae%e0%a7%87%e0%a6%b6%e0%a6%bf%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a6%be%e0%a6%ae%e0%a7%87-%e0%a7%aa/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%bf%e0%a6%a8%e0%a7%8d%e0%a6%9f%e0%a6%bf%e0%a6%82-%e0%a6%ae%e0%a7%87%e0%a6%b6%e0%a6%bf%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a6%be%e0%a6%ae%e0%a7%87-%e0%a7%aa/</guid>
      <pubDate>Sun, 08 Nov 2026 11:39:58 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/Customs.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/Customs.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/Customs.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রিন্টিং মেশিনের নামে ৪৬ কোটি টাকার চালান, এলো জাল সিগারেটের স্ট্যাম্প-প্রসাধনী!" /&gt;&lt;/p&gt;&lt;p&gt;প্রিন্টিং মেশিন আমদানির ঘোষণা দিয়ে চট্টগ্রাম বন্দরে আনা হয়েছিল একটি কনটেইনার। তবে কনটেইনার খুলে পাওয়া গেল ৪০ লাখ ৮০ হাজার পিস জাল সিগারেটের স্ট্যাম্প ও বিপুল পরিমাণ প্রসাধনী সামগ্রী। এসব পণ্য আমদানির আড়ালে প্রায় ৪৬ কোটি টাকার রাজস্ব ফাঁকির চেষ্টা করা হয়েছিল বলে জানিয়েছে জাতীয় রাজস্ব বোর্ড (এনবিআর)। &lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%bf%e0%a6%a8%e0%a7%8d%e0%a6%9f%e0%a6%bf%e0%a6%82-%e0%a6%ae%e0%a7%87%e0%a6%b6%e0%a6%bf%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a6%be%e0%a6%ae%e0%a7%87-%e0%a7%aa/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>ছড়া ও কবিতা</title>
      <link>https://suprobhat.com/%e0%a6%9b%e0%a6%a1%e0%a6%bc%e0%a6%be-%e0%a6%93-%e0%a6%95%e0%a6%ac%e0%a6%bf%e0%a6%a4%e0%a6%be-62/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%9b%e0%a6%a1%e0%a6%bc%e0%a6%be-%e0%a6%93-%e0%a6%95%e0%a6%ac%e0%a6%bf%e0%a6%a4%e0%a6%be-62/</guid>
      <pubDate>Sun, 08 Nov 2026 10:43:12 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/poem.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/poem.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/poem.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ছড়া ও কবিতা" /&gt;&lt;/p&gt;&lt;p&gt;গাঁয়ের শেকড় জনি সিদ্দিক মাঠ রেঙেছে সোনা রঙে কাঁচা-পাকা ধানে, ঘরে ঘরে সুর ওঠে আজ মহান প্রভুর শানে। আঁকাবাঁকা মেঠো পথে দুর্বাঘাসের মেলা, খেজুরগাছে ডাকছে পাখি সারা দুপুর বেলা। চালতাগাছে চড়ুই পাখি খড়ের বাসা বোনে, নিঝুম রাতে দূর আকাশে তারাগুলো গোনে। ভোরের বেলা শিশিরফোঁটা ঘাসের বুকে হাসে, সোনার খনি মাঠ প&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%9b%e0%a6%a1%e0%a6%bc%e0%a6%be-%e0%a6%93-%e0%a6%95%e0%a6%ac%e0%a6%bf%e0%a6%a4%e0%a6%be-62/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>জোনাকির হারিয়ে যাওয়া আলো</title>
      <link>https://suprobhat.com/%e0%a6%9c%e0%a7%8b%e0%a6%a8%e0%a6%be%e0%a6%95%e0%a6%bf%e0%a6%b0-%e0%a6%b9%e0%a6%be%e0%a6%b0%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%af%e0%a6%be%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be-%e0%a6%86/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%9c%e0%a7%8b%e0%a6%a8%e0%a6%be%e0%a6%95%e0%a6%bf%e0%a6%b0-%e0%a6%b9%e0%a6%be%e0%a6%b0%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%af%e0%a6%be%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be-%e0%a6%86/</guid>
      <pubDate>Sun, 08 Nov 2026 10:40:29 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/elating-belating-3.jpg" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/elating-belating-3.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/elating-belating-3.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জোনাকির হারিয়ে যাওয়া আলো" /&gt;&lt;/p&gt;&lt;p&gt;টুকটুকে গোধূলি পেরিয়ে চারপাশ যখন ঘুটঘুটে অন্ধকারে ঢেকে যায়, ঠিক তখনই প্রান্তরজুড়ে শুরু হয় এক নিভৃত আলোড়ন। ঘাসের ডগায়, বুনো ঝোপঝাড়ের আড়ালে কিংবা পাতার ফাঁকে হঠাৎ জ্বলে ওঠা বিন্দু বিন্দু হলুদ আলো দেখলে মনে হয়, আসমান থেকে বুঝি কোনো তারা খসে এসে ঘাসের বিছানায় লুকিয়ে পড়েছে। প্রকৃতির এই জাদুকরী আয়োজন আমাদ&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%9c%e0%a7%8b%e0%a6%a8%e0%a6%be%e0%a6%95%e0%a6%bf%e0%a6%b0-%e0%a6%b9%e0%a6%be%e0%a6%b0%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%af%e0%a6%be%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be-%e0%a6%86/">Suprobhat Bangladesh</source>
    </item>
    <item>
      <title>মনে আছে লিলিপুটদের কথা?</title>
      <link>https://suprobhat.com/%e0%a6%ae%e0%a6%a8%e0%a7%87-%e0%a6%86%e0%a6%9b%e0%a7%87-%e0%a6%b2%e0%a6%bf%e0%a6%b2%e0%a6%bf%e0%a6%aa%e0%a7%81%e0%a6%9f%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a6%a5%e0%a6%be/</link>
      <guid isPermaLink="true">https://suprobhat.com/%e0%a6%ae%e0%a6%a8%e0%a7%87-%e0%a6%86%e0%a6%9b%e0%a7%87-%e0%a6%b2%e0%a6%bf%e0%a6%b2%e0%a6%bf%e0%a6%aa%e0%a7%81%e0%a6%9f%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a6%a5%e0%a6%be/</guid>
      <pubDate>Sun, 08 Nov 2026 10:34:02 +0000</pubDate>
      <enclosure url="https://suprobhat.com/wp-content/uploads/2026/11/elating-belating-2.webp" length="0" type="image/jpeg" />
      <media:content url="https://suprobhat.com/wp-content/uploads/2026/11/elating-belating-2.webp" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://suprobhat.com/wp-content/uploads/2026/11/elating-belating-2.webp" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মনে আছে লিলিপুটদের কথা?" /&gt;&lt;/p&gt;&lt;p&gt;লিলিপুট শব্দটির সঙ্গে তোমাদের পরিচয় আছে নিশ্চয়ই! লেখক জোনাথন সুইফটের বিখ্যাত বই ‘গালিভারস ট্রাভেলস’ যারা পড়েছ, তারা তো নিশ্চয়ই জানো কী দারুণ গল্পটি। আর যারা এখনো পড়নি, তারা পড়ে নিও, খুব মজা পাবে। সেই যে, গালিভার নামের এক লোক একদিন গিয়ে পড়ল এক আজব দেশে, যেখানকার মানুষেরা একদমই ছোট্ট। লম্বায় মাত্র কয়ে&lt;/p&gt;</description>
      <source url="https://suprobhat.com/%e0%a6%ae%e0%a6%a8%e0%a7%87-%e0%a6%86%e0%a6%9b%e0%a7%87-%e0%a6%b2%e0%a6%bf%e0%a6%b2%e0%a6%bf%e0%a6%aa%e0%a7%81%e0%a6%9f%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a6%a5%e0%a6%be/">Suprobhat Bangladesh</source>

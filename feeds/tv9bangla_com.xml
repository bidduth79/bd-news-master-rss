      <link>https://tv9bangla.com/india/india-successfully-tests-indigenous-bhargavastra-anti-drone-system-in-pokhran-to-counter-drone-swarms-1364196.html</link>
      <guid isPermaLink="true">https://tv9bangla.com/india/india-successfully-tests-indigenous-bhargavastra-anti-drone-system-in-pokhran-to-counter-drone-swarms-1364196.html</guid>
      <pubDate>Sat, 28 Nov 2026 20:16:07 +0530</pubDate>

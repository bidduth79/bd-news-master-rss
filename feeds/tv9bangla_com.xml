    <item>
      <title>Hypnic Jerk: ঘুমের মধ্যে হঠাৎ শরীর ঝাঁকুনি দিয়ে ওঠে কেন? এটা কি কোনও রোগ?</title>
      <link>https://tv9bangla.com/lifestyle/hypnic-jerk-why-you-suddenly-gets-shaken-during-sleep-is-it-some-kind-of-disease-1361164.html</link>
      <guid isPermaLink="true">https://tv9bangla.com/lifestyle/hypnic-jerk-why-you-suddenly-gets-shaken-during-sleep-is-it-some-kind-of-disease-1361164.html</guid>
      <pubDate>Mon, 16 Nov 2026 13:36:19 +0530</pubDate>
      <enclosure url="https://images.tv9bangla.com/wp-content/uploads/2026/11/hypnic-jerk.jpg" length="0" type="image/jpeg" />

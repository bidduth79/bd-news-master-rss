      <pubDate>Fri, 27 Nov 2026 23:34:04 +0530</pubDate>
      <enclosure url="https://images.tv9bangla.com/wp-content/uploads/2026/11/CM-Suvendu-Adhikari-6.jpg" length="0" type="image/jpeg" />

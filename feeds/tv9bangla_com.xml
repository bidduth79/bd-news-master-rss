      <guid isPermaLink="true">https://tv9bangla.com/world/gen-z-protests-spread-across-germany-over-38-cities-rise-against-friedrich-merz-government-1359870.html</guid>
      <pubDate>Tue, 10 Nov 2026 20:50:31 +0530</pubDate>
      <enclosure url="https://images.tv9bangla.com/wp-content/uploads/2026/11/Germany.jpg" length="0" type="image/jpeg" />

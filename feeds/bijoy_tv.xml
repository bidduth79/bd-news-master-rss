    <item>
      <title>এনভিডিয়ার বিতর্কে যুক্তরাষ্ট্রকে চীনের কড়া হুঁশিয়ারি</title>
      <link>https://bijoy.tv/international/%e0%a6%8f%e0%a6%a8%e0%a6%ad%e0%a6%bf%e0%a6%a1%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%a4%e0%a6%b0%e0%a7%8d%e0%a6%95%e0%a7%87-%e0%a6%af%e0%a7%81%e0%a6%95%e0%a7%8d%e0%a6%a4</link>
      <guid isPermaLink="true">https://bijoy.tv/international/%e0%a6%8f%e0%a6%a8%e0%a6%ad%e0%a6%bf%e0%a6%a1%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%a4%e0%a6%b0%e0%a7%8d%e0%a6%95%e0%a7%87-%e0%a6%af%e0%a7%81%e0%a6%95%e0%a7%8d%e0%a6%a4</guid>
      <pubDate>Fri, 13 Nov 2026 08:47:49 +0000</pubDate>
      <description>এআই বা কৃত্রিম বুদ্ধিমত্তা প্রযুক্তির চিপ নির্মাতা প্রতিষ্ঠান এনভিডিয়াকে ঘিরে বিতর্কের জেরে চীনে চিপ রপ্তানিতে নতুন নিষেধাজ্ঞা আরোপের উদ্যোগের বিরুদ্ধে যুক্তরাষ্ট্রকে সতর্ক করেছে বেইজিং। দেশটির দাবি, এ ধরনের পদক্ষেপ বৈশ্বিক শিল্প ও সরবরাহব্যবস্থার স্থিতিশীলতা নষ্ট করবে। এতে কোনো পক্ষেরই লাভ হবে না। </description>
      <source url="https://bijoy.tv/international/%e0%a6%8f%e0%a6%a8%e0%a6%ad%e0%a6%bf%e0%a6%a1%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0-%e0%a6%ac%e0%a6%bf%e0%a6%a4%e0%a6%b0%e0%a7%8d%e0%a6%95%e0%a7%87-%e0%a6%af%e0%a7%81%e0%a6%95%e0%a7%8d%e0%a6%a4">bijoytv.com</source>
    </item>
    <item>
      <title>বোমা হামলার ঘটনায় ইতোমধ্যে অনেকে গ্রেপ্তার হয়েছেন: আইনমন্ত্রী</title>
      <link>https://bijoy.tv/leadnews1/%e0%a6%ac%e0%a7%8b%e0%a6%ae%e0%a6%be-%e0%a6%b9%e0%a6%be%e0%a6%ae%e0%a6%b2%e0%a6%be%e0%a6%b0-%e0%a6%98%e0%a6%9f%e0%a6%a8%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%87%e0%a6%a4%e0%a7%8b%e0%a6%ae%e0%a6%a7</link>

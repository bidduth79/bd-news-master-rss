    <item>
      <title>ইরানে হামলা হলে এশিয়া- ইউরোপ কোথাও আশ্রয় পাবে না যুক্তরাষ্ট্র</title>
      <link>https://bijoy.tv/international/%e0%a6%87%e0%a6%b0%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%b9%e0%a6%be%e0%a6%ae%e0%a6%b2%e0%a6%be-%e0%a6%b9%e0%a6%b2%e0%a7%87-%e0%a6%8f%e0%a6%b6%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be-%e0%a6%87%e0%a6%89</link>

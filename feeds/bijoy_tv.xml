    <item>
      <title>সি-স্যুট অ্যাওয়ার্ডে ভূষিত হলেন ওয়ালটন প্লাজার এমডি</title>
      <link>https://bijoy.tv/national/%e0%a6%b8%e0%a6%bf-%e0%a6%b8%e0%a7%8d%e0%a6%af%e0%a7%81%e0%a6%9f-%e0%a6%85%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%a1%e0%a7%87-%e0%a6%ad%e0%a7%82</link>
      <guid isPermaLink="true">https://bijoy.tv/national/%e0%a6%b8%e0%a6%bf-%e0%a6%b8%e0%a7%8d%e0%a6%af%e0%a7%81%e0%a6%9f-%e0%a6%85%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%a1%e0%a7%87-%e0%a6%ad%e0%a7%82</guid>
      <pubDate>Tue, 24 Nov 2026 12:05:46 +0000</pubDate>
      <description>দেশের ইলেকট্রনিক্স পণ্য বিক্রয় ও গ্রাহকসেবা খাতে অসামান্য অবদানের স্বীকৃতি হিসেবে ‘বাংলাদেশ সি-স্যুট অ্যাওয়ার্ডস ২০২৬’ পেয়েছেন ওয়ালটন প্লাজার ব্যবস্থাপনা পরিচালক (এমডি) মোহাম্মদ রায়হান। দেশের শীর্ষস্থানীয় ইলেকট্রনিক্স পণ্য বিক্রয় ও সেবাদানকারী প্রতিষ্ঠান ওয়ালটন প্লাজার নেতৃত্ব দিয়ে এ খাতে অবদান রাখা</description>
      <source url="https://bijoy.tv/national/%e0%a6%b8%e0%a6%bf-%e0%a6%b8%e0%a7%8d%e0%a6%af%e0%a7%81%e0%a6%9f-%e0%a6%85%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%a1%e0%a7%87-%e0%a6%ad%e0%a7%82">bijoytv.com</source>
    </item>
    <item>
      <title>স্বর্ণদ্বীপে পৌঁছেছেন প্রধানমন্ত্রী তারেক রহমান</title>
      <link>https://bijoy.tv/leadnews/%e0%a6%b8%e0%a7%8d%e0%a6%ac%e0%a6%b0%e0%a7%8d%e0%a6%a3%e0%a6%a6%e0%a7%8d%e0%a6%ac%e0%a7%80%e0%a6%aa%e0%a7%87-%e0%a6%aa%e0%a7%8c%e0%a6%81%e0%a6%9b%e0%a7%87%e0%a6%9b%e0%a7%87%e0%a6%a8-%e0%a6%aa%e0%a7%8d</link>

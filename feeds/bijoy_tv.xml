    <item>
      <title>ডেঙ্গুতে আরও ৩ জনের মৃত্যু, হাসপাতালে ভর্তি ২ হাজার ৩৩৩</title>
      <link>https://bijoy.tv/national/%e0%a6%a1%e0%a7%87%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%81%e0%a6%a4%e0%a7%87-%e0%a6%86%e0%a6%b0%e0%a6%93-%e0%a7%a9-%e0%a6%9c%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a7%83%e0%a6%a4%e0%a7%8d%e0%a6%af-4</link>
      <guid isPermaLink="true">https://bijoy.tv/national/%e0%a6%a1%e0%a7%87%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%81%e0%a6%a4%e0%a7%87-%e0%a6%86%e0%a6%b0%e0%a6%93-%e0%a7%a9-%e0%a6%9c%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a7%83%e0%a6%a4%e0%a7%8d%e0%a6%af-4</guid>
      <pubDate>Sun, 08 Nov 2026 12:22:47 +0000</pubDate>
      <description>দেশে ডেঙ্গুতে আক্রান্ত হয়ে গত ২৪ ঘণ্টায় আরও তিনজনের মৃত্যু হয়েছে। একই সময়ে আক্রান্ত হয়ে হাসপাতালে ভর্তি হয়েছেন দুই হাজার ৩৩৩ জন। রোববার (৮ নভেম্বর) স্বাস্থ্য অধিদফতরের ডেঙ্গুবিষয়ক নিয়মিত বুলেটিনে তথ্যটি জানানো হয়। স্বাস্থ্য অধিদফতরের তথ্য অনুযায়ী, এ নিয়ে চলতি বছর ডেঙ্গুতে মোট ৪৬১ জনের মৃত্যু হয়েছে। </description>
      <source url="https://bijoy.tv/national/%e0%a6%a1%e0%a7%87%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%81%e0%a6%a4%e0%a7%87-%e0%a6%86%e0%a6%b0%e0%a6%93-%e0%a7%a9-%e0%a6%9c%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a7%83%e0%a6%a4%e0%a7%8d%e0%a6%af-4">bijoytv.com</source>
    </item>

    <item>
      <title>আগুন সন্ত্রাসের কারণে আতঙ্কিত নয়, মানুষ কঠোর অবস্থানে: পররাষ্ট্র প্রতিমন্ত্রী</title>
      <link>https://bijoy.tv/politics/%e0%a6%86%e0%a6%97%e0%a7%81%e0%a6%a8-%e0%a6%b8%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%b8%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%a3%e0%a7%87-%e0%a6%86%e0%a6%a4</link>
      <guid isPermaLink="true">https://bijoy.tv/politics/%e0%a6%86%e0%a6%97%e0%a7%81%e0%a6%a8-%e0%a6%b8%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%b8%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%a3%e0%a7%87-%e0%a6%86%e0%a6%a4</guid>
      <pubDate>Tue, 24 Nov 2026 05:11:26 +0000</pubDate>
      <description>আগুন সন্ত্রাসের কারণে বাংলাদেশের মানুষ আতঙ্কিত হচ্ছে না, বরং সন্ত্রাসীদের নিয়ে মানুষ কঠোর অবস্থানে রয়েছে বলে জানিয়েছেন পররাষ্ট্র প্রতিমন্ত্রী হুমায়ুন কবির। মঙ্গলবার (২৪ নভেম্বর) সকাল ৯টায় পররাষ্ট্র মন্ত্রণালয়ে ব্রিফিংয়ে কূটনীতিকদের এ তথ্য জানান তিনি। ব্রিফিংয়ের শুরুতে আমন্ত্রিত বিদেশি কূটনীতিক ও আন্</description>
      <source url="https://bijoy.tv/politics/%e0%a6%86%e0%a6%97%e0%a7%81%e0%a6%a8-%e0%a6%b8%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%b8%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%a3%e0%a7%87-%e0%a6%86%e0%a6%a4">bijoytv.com</source>
    </item>
    <item>
      <title>ঘুষের অর্থ গোপন মামলায় ট্রাম্পের সাজা বাতিলের নতুন সুযোগ</title>
      <link>https://bijoy.tv/international/%e0%a6%98%e0%a7%81%e0%a6%b7%e0%a7%87%e0%a6%b0-%e0%a6%85%e0%a6%b0%e0%a7%8d%e0%a6%a5-%e0%a6%97%e0%a7%8b%e0%a6%aa%e0%a6%a8-%e0%a6%ae%e0%a6%be%e0%a6%ae%e0%a6%b2%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%9f</link>

      <pubDate>Mon, 16 Nov 2026 05:21:24 +0000</pubDate>
      <description>ইয়েমেনের আন্তর্জাতিকভাবে স্বীকৃত সরকারের অস্থায়ী রাজধানী এডেনের দিকে এগোচ্ছে ইরান সমর্থিত হুথি বিদ্রোহীরা। গতকাল রোববার তারা এডেন থেকে মাত্র ৬০ কিলোমিটার দূরে অবস্থান করছিল। এমন অবস্থায় শহরটিকে রক্ষায় প্রস্তুতি নিচ্ছে সৌদি সমর্থিত সরকারি বাহিনীর সেনারা। তারা শহরটির চারপাশে পরিখা খনন এবং বালুর বস্তা</description>
      <source url="https://bijoy.tv/international/%e0%a6%87%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%ae%e0%a7%87%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%85%e0%a6%b8%e0%a7%8d%e0%a6%a5%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a7%80-%e0%a6%b0%e0%a6%be%e0%a6%9c%e0%a6%a7%e0%a6%be">bijoytv.com</source>

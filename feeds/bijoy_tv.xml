    <item>
      <title>ঘুষের অর্থ গোপন মামলায় ট্রাম্পের সাজা বাতিলের নতুন সুযোগ</title>
      <link>https://bijoy.tv/international/%e0%a6%98%e0%a7%81%e0%a6%b7%e0%a7%87%e0%a6%b0-%e0%a6%85%e0%a6%b0%e0%a7%8d%e0%a6%a5-%e0%a6%97%e0%a7%8b%e0%a6%aa%e0%a6%a8-%e0%a6%ae%e0%a6%be%e0%a6%ae%e0%a6%b2%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%9f</link>

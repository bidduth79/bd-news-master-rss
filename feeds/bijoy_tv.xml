    <item>
      <title>কারিগরি-প্রযুক্তিগত শিক্ষায় সর্বোচ্চ অগ্রাধিকার দিচ্ছে সরকার: জাহিদ</title>
      <link>https://bijoy.tv/education/%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%bf%e0%a6%97%e0%a6%b0%e0%a6%bf-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%af%e0%a7%81%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%bf%e0%a6%97%e0%a6%a4-%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d</link>
      <guid isPermaLink="true">https://bijoy.tv/education/%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%bf%e0%a6%97%e0%a6%b0%e0%a6%bf-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%af%e0%a7%81%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%bf%e0%a6%97%e0%a6%a4-%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d</guid>
      <pubDate>Sun, 08 Nov 2026 10:34:37 +0000</pubDate>
      <description>চতুর্থ শিল্পবিপ্লব ও কৃত্রিম বুদ্ধিমত্তার (এআই) বৈশ্বিক চ্যালেঞ্জ মোকাবিলায় দক্ষ মানবসম্পদ তৈরিতে প্রাতিষ্ঠানিক শিক্ষার পাশাপাশি কারিগরি ও প্রযুক্তিগত শিক্ষাকে সর্বোচ্চ অগ্রাধিকার দেওয়া হচ্ছে বলে জানিয়েছেন নারী ও শিশু বিষয়ক এবং সমাজকল্যাণ মন্ত্রী অধ্যাপক ডা. এ জেড এম জাহিদ হোসেন। রোববার (৮ নভেম্বর) </description>
      <source url="https://bijoy.tv/education/%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%bf%e0%a6%97%e0%a6%b0%e0%a6%bf-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%af%e0%a7%81%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%bf%e0%a6%97%e0%a6%a4-%e0%a6%b6%e0%a6%bf%e0%a6%95%e0%a7%8d">bijoytv.com</source>

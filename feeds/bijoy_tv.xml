    <item>
      <title>বাহরাইনে হামলা চালিয়েছে ইরান</title>
      <link>https://bijoy.tv/international/%e0%a6%ac%e0%a6%be%e0%a6%b9%e0%a6%b0%e0%a6%be%e0%a6%87%e0%a6%a8%e0%a7%87-%e0%a6%b9%e0%a6%be%e0%a6%ae%e0%a6%b2%e0%a6%be-%e0%a6%9a%e0%a6%be%e0%a6%b2%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%9b%e0%a7%87</link>
      <guid isPermaLink="true">https://bijoy.tv/international/%e0%a6%ac%e0%a6%be%e0%a6%b9%e0%a6%b0%e0%a6%be%e0%a6%87%e0%a6%a8%e0%a7%87-%e0%a6%b9%e0%a6%be%e0%a6%ae%e0%a6%b2%e0%a6%be-%e0%a6%9a%e0%a6%be%e0%a6%b2%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%9b%e0%a7%87</guid>
      <pubDate>Fri, 13 Nov 2026 04:42:32 +0000</pubDate>
      <description>বাহরাইনে হামলা চালিয়েছে ইরান। ইরানের দক্ষিণাঞ্চলীয় সিরিক শহরে হামলার জবাবে উপসাগরীয় এই দেশটিতে যুক্তরাষ্ট্রের একটি আগাম সতর্কতামূলক রাডার লক্ষ্য করে এই হামলা চালায় তেহরান। ইরানের ইসলামিক রেভল্যুশনারি গার্ড কোরের (আইআরজিসি) দাবি, সিরিকের একটি টেলিযোগাযোগ টাওয়ারে হামলার প্রতিক্রিয়ায় এ পদক্ষেপ নেয়া হয়ে</description>
      <source url="https://bijoy.tv/international/%e0%a6%ac%e0%a6%be%e0%a6%b9%e0%a6%b0%e0%a6%be%e0%a6%87%e0%a6%a8%e0%a7%87-%e0%a6%b9%e0%a6%be%e0%a6%ae%e0%a6%b2%e0%a6%be-%e0%a6%9a%e0%a6%be%e0%a6%b2%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%9b%e0%a7%87">bijoytv.com</source>
    </item>
    <item>
      <title>টানা ৪ দফায় ৯ হাজার ৮৫৬ টাকা কমল স্বর্ণের দাম</title>
      <link>https://bijoy.tv/economy/%e0%a6%9f%e0%a6%be%e0%a6%a8%e0%a6%be-%e0%a7%aa-%e0%a6%a6%e0%a6%ab%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a7%af-%e0%a6%b9%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0-%e0%a7%ae%e0%a7%ab%e0%a7%ac-%e0%a6%9f%e0%a6%be</link>

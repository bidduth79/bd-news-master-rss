    <item>
      <title>যুদ্ধবিরতির মধ্যেই গাজায় ইসরাইলি হামলা, নিহত ৬</title>
      <link>https://outlookbangla.com/2026/11/21/%e0%a6%af%e0%a7%81%e0%a6%a6%e0%a7%8d%e0%a6%a7%e0%a6%ac%e0%a6%bf%e0%a6%b0%e0%a6%a4%e0%a6%bf%e0%a6%b0-%e0%a6%ae%e0%a6%a7%e0%a7%8d%e0%a6%af%e0%a7%87%e0%a6%87-%e0%a6%97%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%af/</link>

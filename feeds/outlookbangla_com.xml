    </item>
    <item>
      <title>ইসরাইল-ফিলিস্তিন নীতিতে গণতন্ত্রকে প্রাধান্য দিতে হবে: এল-সায়েদ</title>
      <link>https://outlookbangla.com/2026/11/23/%e0%a6%87%e0%a6%b8%e0%a6%b0%e0%a6%be%e0%a6%87%e0%a6%b2-%e0%a6%ab%e0%a6%bf%e0%a6%b2%e0%a6%bf%e0%a6%b8%e0%a7%8d%e0%a6%a4%e0%a6%bf%e0%a6%a8-%e0%a6%a8%e0%a7%80%e0%a6%a4%e0%a6%bf%e0%a6%a4%e0%a7%87/</link>

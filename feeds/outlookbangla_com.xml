    <item>
      <title>সৌদি আরবের একাধিক স্থানে হুথির ব্যাপক হামলা</title>
      <link>https://outlookbangla.com/2026/11/26/%e0%a6%b8%e0%a7%8c%e0%a6%a6%e0%a6%bf-%e0%a6%86%e0%a6%b0%e0%a6%ac%e0%a7%87%e0%a6%b0-%e0%a6%8f%e0%a6%95%e0%a6%be%e0%a6%a7%e0%a6%bf%e0%a6%95-%e0%a6%b8%e0%a7%8d%e0%a6%a5%e0%a6%be%e0%a6%a8%e0%a7%87/</link>
      <guid isPermaLink="true">https://outlookbangla.com/2026/11/26/%e0%a6%b8%e0%a7%8c%e0%a6%a6%e0%a6%bf-%e0%a6%86%e0%a6%b0%e0%a6%ac%e0%a7%87%e0%a6%b0-%e0%a6%8f%e0%a6%95%e0%a6%be%e0%a6%a7%e0%a6%bf%e0%a6%95-%e0%a6%b8%e0%a7%8d%e0%a6%a5%e0%a6%be%e0%a6%a8%e0%a7%87/</guid>
      <pubDate>Thu, 26 Nov 2026 03:58:59 +0000</pubDate>
      <description>সৌদি আরবের লোহিত সাগর উপকূলের জিজান বন্দরে হামলা চালিয়েছে ইয়েমেনের হুথি বিদ্রোহীরা। একই সঙ্গে দেশটির রাজধানী রিয়াদ লক্ষ্য করে ব্যালিস্টিক ক্ষেপণাস্ত্র নিক্ষেপ করেছে গোষ্ঠীটি। পালটা হামলা ও সংঘাতের ঘটনায় সৌদি আরব ও ইয়েমেনের মধ্যে উত্তেজনা আরও বেড়েছে। খবর আল জাজিরার বুধবার (২৫ নভেম্বর) সৌদি নেতৃত্বাধী</description>
      <source url="https://outlookbangla.com/2026/11/26/%e0%a6%b8%e0%a7%8c%e0%a6%a6%e0%a6%bf-%e0%a6%86%e0%a6%b0%e0%a6%ac%e0%a7%87%e0%a6%b0-%e0%a6%8f%e0%a6%95%e0%a6%be%e0%a6%a7%e0%a6%bf%e0%a6%95-%e0%a6%b8%e0%a7%8d%e0%a6%a5%e0%a6%be%e0%a6%a8%e0%a7%87/">outlookbangla.com</source>
    </item>
    <item>
      <title>জাতীয় প্রাণিসম্পদ সপ্তাহ উদ্বোধন অনুষ্ঠানে প্রধানমন্ত্রী</title>
      <link>https://outlookbangla.com/2026/11/26/%e0%a6%9c%e0%a6%be%e0%a6%a4%e0%a7%80%e0%a6%af%e0%a6%bc-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%a3%e0%a6%bf%e0%a6%b8%e0%a6%ae%e0%a7%8d%e0%a6%aa%e0%a6%a6-%e0%a6%b8%e0%a6%aa%e0%a7%8d%e0%a6%a4%e0%a6%be/</link>

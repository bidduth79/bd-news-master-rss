    <item>
      <title>দেশের নিরাপত্তা পরিস্থিতির দায় সরকার এড়াতে পারে না: জামায়াত আমির</title>
      <link>https://outlookbangla.com/2026/11/11/%e0%a6%a6%e0%a7%87%e0%a6%b6%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a6%bf%e0%a6%b0%e0%a6%be%e0%a6%aa%e0%a6%a4%e0%a7%8d%e0%a6%a4%e0%a6%be-%e0%a6%aa%e0%a6%b0%e0%a6%bf%e0%a6%b8%e0%a7%8d%e0%a6%a5%e0%a6%bf%e0%a6%a4/</link>

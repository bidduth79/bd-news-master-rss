    <item>
      <title>১৫ বছরে পাচার হয়েছে ২৮ লাখ কোটি টাকা: রাষ্ট্রপতি</title>
      <link>https://outlookbangla.com/2026/11/28/%e0%a7%a7%e0%a7%ab-%e0%a6%ac%e0%a6%9b%e0%a6%b0%e0%a7%87-%e0%a6%aa%e0%a6%be%e0%a6%9a%e0%a6%be%e0%a6%b0-%e0%a6%b9%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%9b%e0%a7%87-%e0%a7%a8%e0%a7%ae-%e0%a6%b2%e0%a6%be/</link>
      <guid isPermaLink="true">https://outlookbangla.com/2026/11/28/%e0%a7%a7%e0%a7%ab-%e0%a6%ac%e0%a6%9b%e0%a6%b0%e0%a7%87-%e0%a6%aa%e0%a6%be%e0%a6%9a%e0%a6%be%e0%a6%b0-%e0%a6%b9%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%9b%e0%a7%87-%e0%a7%a8%e0%a7%ae-%e0%a6%b2%e0%a6%be/</guid>
      <pubDate>Sat, 28 Nov 2026 08:19:20 +0000</pubDate>
      <description>আওয়ামী লীগ সরকারের আমলে ১৫ বছরে প্রায় ২৮ লাখ কোটি টাকা বিদেশে পাচার হয়েছে বলে অর্থনীতির শ্বেতপত্রের বরাত দিয়ে জানিয়েছেন রাষ্ট্রপতি মির্জা ফখরুল ইসলাম আলমগীর। শনিবার (২৮ নভেম্বর) রাজধানীর রেডিসন ব্লু হোটেলে চার্টার্ড অ্যাকাউন্ট্যান্টস বাংলাদেশের আয়োজনে সাউথ এশিয়ান ফেডারেশন অব অ্যাকাউন্ট্যান্টস (সাফা)</description>
      <source url="https://outlookbangla.com/2026/11/28/%e0%a7%a7%e0%a7%ab-%e0%a6%ac%e0%a6%9b%e0%a6%b0%e0%a7%87-%e0%a6%aa%e0%a6%be%e0%a6%9a%e0%a6%be%e0%a6%b0-%e0%a6%b9%e0%a6%af%e0%a6%bc%e0%a7%87%e0%a6%9b%e0%a7%87-%e0%a7%a8%e0%a7%ae-%e0%a6%b2%e0%a6%be/">outlookbangla.com</source>
    </item>

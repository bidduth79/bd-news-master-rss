    <item>
      <title>ইউরোপে আশ্রয় আবেদনে বাংলাদেশিরা তৃতীয়, স্বীকৃতি মাত্র ৩ শতাংশ</title>
      <link>https://outlookbangla.com/2026/11/20/%e0%a6%87%e0%a6%89%e0%a6%b0%e0%a7%8b%e0%a6%aa%e0%a7%87-%e0%a6%86%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a6%af%e0%a6%bc-%e0%a6%86%e0%a6%ac%e0%a7%87%e0%a6%a6%e0%a6%a8%e0%a7%87-%e0%a6%ac%e0%a6%be%e0%a6%82/</link>

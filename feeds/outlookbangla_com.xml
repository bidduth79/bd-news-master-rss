    <item>
      <title>কোন ধাপে কত ইউনিয়নে ভোট, জানালো ইসি</title>
      <link>https://outlookbangla.com/2026/11/16/%e0%a6%95%e0%a7%8b%e0%a6%a8-%e0%a6%a7%e0%a6%be%e0%a6%aa%e0%a7%87-%e0%a6%95%e0%a6%a4-%e0%a6%87%e0%a6%89%e0%a6%a8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%a8%e0%a7%87-%e0%a6%ad%e0%a7%8b%e0%a6%9f-%e0%a6%9c/</link>
      <guid isPermaLink="true">https://outlookbangla.com/2026/11/16/%e0%a6%95%e0%a7%8b%e0%a6%a8-%e0%a6%a7%e0%a6%be%e0%a6%aa%e0%a7%87-%e0%a6%95%e0%a6%a4-%e0%a6%87%e0%a6%89%e0%a6%a8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%a8%e0%a7%87-%e0%a6%ad%e0%a7%8b%e0%a6%9f-%e0%a6%9c/</guid>
      <pubDate>Mon, 16 Nov 2026 13:59:07 +0000</pubDate>
      <description>পাঁচ ধাপে ইউনিয়ন পরিষদ (ইউপি) নির্বাচন আয়োজনের পরিকল্পনা করেছে নির্বাচন কমিশন (ইসি)। প্রথম ধাপে ১৩১টি উপজেলার ১ হাজার ২৬টি ইউনিয়নে ভোট নেওয়ার পরিকল্পনা রয়েছে। আগামী ২১ জানুয়ারি থেকে এ নির্বাচন শুরু করার পরিকল্পনা করছে কমিশন। সোমবার নির্বাচন ভবনে ইসির ১৪তম কমিশন সভা শেষে নির্বাচন কমিশনার আবুল ফজল মো.</description>
      <source url="https://outlookbangla.com/2026/11/16/%e0%a6%95%e0%a7%8b%e0%a6%a8-%e0%a6%a7%e0%a6%be%e0%a6%aa%e0%a7%87-%e0%a6%95%e0%a6%a4-%e0%a6%87%e0%a6%89%e0%a6%a8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%a8%e0%a7%87-%e0%a6%ad%e0%a7%8b%e0%a6%9f-%e0%a6%9c/">outlookbangla.com</source>
    </item>

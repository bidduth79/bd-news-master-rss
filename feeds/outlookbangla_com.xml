    <item>
      <title>জামায়াতের ৪০ দিনের কর্মসূচি ঘোষণা</title>
      <link>https://outlookbangla.com/2026/11/20/%e0%a6%9c%e0%a6%be%e0%a6%ae%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%a4%e0%a7%87%e0%a6%b0-%e0%a7%aa%e0%a7%a6-%e0%a6%a6%e0%a6%bf%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%ae/</link>
      <guid isPermaLink="true">https://outlookbangla.com/2026/11/20/%e0%a6%9c%e0%a6%be%e0%a6%ae%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%a4%e0%a7%87%e0%a6%b0-%e0%a7%aa%e0%a7%a6-%e0%a6%a6%e0%a6%bf%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%ae/</guid>
      <pubDate>Fri, 20 Nov 2026 06:00:42 +0000</pubDate>
      <description>গণ-অভ্যুত্থানে ক্ষমতাচ্যুত প্রধানমন্ত্রী শেখ হাসিনার দেশে ফেরার ঘোষণাকে কেন্দ্র করে চলমান রাজনৈতিক পরিস্থিতি এবং বিজয়ের মাস উপলক্ষে ৪০ দিনব্যাপী কর্মসূচি ঘোষণা করেছে বাংলাদেশ জামায়াতে ইসলামী। দলটি জানিয়েছে, ২১শে নভেম্বর থেকে ৩১শে ডিসেম্বর পর্যন্ত ঢাকাসহ সারা দেশে সমাবেশ, মিছিল, আলোচনা সভা, বিজয় র‌্য</description>
      <source url="https://outlookbangla.com/2026/11/20/%e0%a6%9c%e0%a6%be%e0%a6%ae%e0%a6%be%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%a4%e0%a7%87%e0%a6%b0-%e0%a7%aa%e0%a7%a6-%e0%a6%a6%e0%a6%bf%e0%a6%a8%e0%a7%87%e0%a6%b0-%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%ae/">outlookbangla.com</source>
    </item>
    <item>
      <title>গোপালগঞ্জে দোকানপাট খুলছে তবে কাটেনি আতঙ্ক</title>
      <link>https://outlookbangla.com/2026/11/20/%e0%a6%97%e0%a7%8b%e0%a6%aa%e0%a6%be%e0%a6%b2%e0%a6%97%e0%a6%9e%e0%a7%8d%e0%a6%9c%e0%a7%87-%e0%a6%a6%e0%a7%8b%e0%a6%95%e0%a6%be%e0%a6%a8%e0%a6%aa%e0%a6%be%e0%a6%9f-%e0%a6%96%e0%a7%81%e0%a6%b2%e0%a6%9b/</link>

    <item>
      <title>৮ জেলায় ১০১ প্লাটুন বিজিবি মোতায়েন</title>
      <link>https://outlookbangla.com/2026/11/24/%e0%a7%ae-%e0%a6%9c%e0%a7%87%e0%a6%b2%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a7%a7%e0%a7%a6%e0%a7%a7-%e0%a6%aa%e0%a7%8d%e0%a6%b2%e0%a6%be%e0%a6%9f%e0%a7%81%e0%a6%a8-%e0%a6%ac%e0%a6%bf%e0%a6%9c%e0%a6%bf/</link>

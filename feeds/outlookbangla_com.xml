    <item>
      <title>আ.লীগের রাজনীতি নিষিদ্ধের দাবি শিল্পী সমাজের</title>
      <link>https://outlookbangla.com/2026/11/18/%e0%a6%86-%e0%a6%b2%e0%a7%80%e0%a6%97%e0%a7%87%e0%a6%b0-%e0%a6%b0%e0%a6%be%e0%a6%9c%e0%a6%a8%e0%a7%80%e0%a6%a4%e0%a6%bf-%e0%a6%a8%e0%a6%bf%e0%a6%b7%e0%a6%bf%e0%a6%a6%e0%a7%8d%e0%a6%a7%e0%a7%87/</link>

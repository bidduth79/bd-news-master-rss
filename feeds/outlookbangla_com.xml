    </item>
    <item>
      <title>গোপালগঞ্জে সন্দেহজনক মোবাইল ব্যাংকিং সেবা বন্ধ</title>
      <link>https://outlookbangla.com/2026/11/26/%e0%a6%97%e0%a7%8b%e0%a6%aa%e0%a6%be%e0%a6%b2%e0%a6%97%e0%a6%9e%e0%a7%8d%e0%a6%9c%e0%a7%87-%e0%a6%b8%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a7%87%e0%a6%b9%e0%a6%9c%e0%a6%a8%e0%a6%95-%e0%a6%ae%e0%a7%8b%e0%a6%ac/</link>

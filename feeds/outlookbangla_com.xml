    <item>
      <title>গ্রামীণ ব্যাংকে লাগাতার অগ্নিসংযোগ বন্ধের আহ্বান ড. ইউনূসের</title>
      <link>https://outlookbangla.com/2026/11/23/%e0%a6%97%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%ae%e0%a7%80%e0%a6%a3-%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95%e0%a7%87-%e0%a6%b2%e0%a6%be%e0%a6%97%e0%a6%be%e0%a6%a4%e0%a6%be%e0%a6%b0/</link>

    <item>
      <title>সাভারের বন্ধ ট্যানারি চালু করতে সহায়তা দেবে সরকার</title>
      <link>https://outlookbangla.com/2026/11/11/%e0%a6%b8%e0%a6%be%e0%a6%ad%e0%a6%be%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%ac%e0%a6%a8%e0%a7%8d%e0%a6%a7-%e0%a6%9f%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%a8%e0%a6%be%e0%a6%b0%e0%a6%bf-%e0%a6%9a%e0%a6%be/</link>

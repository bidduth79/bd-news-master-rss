    <item>
      <title>তরুণ উদ্যোক্তা হিসেবে ২০ লাখ টাকা ঋণের সুযোগ, আবেদন করবেন যেভাবে</title>
      <link>https://outlookbangla.com/2026/11/28/%e0%a6%a4%e0%a6%b0%e0%a7%81%e0%a6%a3-%e0%a6%89%e0%a6%a6%e0%a7%8d%e0%a6%af%e0%a7%8b%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%be-%e0%a6%b9%e0%a6%bf%e0%a6%b8%e0%a7%87%e0%a6%ac%e0%a7%87-%e0%a7%a8%e0%a7%a6/</link>

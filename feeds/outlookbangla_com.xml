    <item>
      <title>কাঁঠালবাগানে গ্যাস সিলিন্ডার বিস্ফোরণে একই পরিবারের পাঁচজন দগ্ধ</title>
      <link>https://outlookbangla.com/2026/11/19/%e0%a6%95%e0%a6%be%e0%a6%81%e0%a6%a0%e0%a6%be%e0%a6%b2%e0%a6%ac%e0%a6%be%e0%a6%97%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%97%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%b8-%e0%a6%b8%e0%a6%bf%e0%a6%b2%e0%a6%bf%e0%a6%a8/</link>

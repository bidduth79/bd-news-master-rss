    <item>
      <title>ব্যাংক-বীমা-পুঁজিবাজারের লেনদেন সমন্বিত ডিজিটাল ব্যবস্থা হচ্ছে: অর্থমন্ত্রী</title>
      <link>https://outlookbangla.com/2026/11/28/%e0%a6%ac%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%82%e0%a6%95-%e0%a6%ac%e0%a6%bf%e0%a6%ae%e0%a6%be-%e0%a6%aa%e0%a7%81%e0%a6%81%e0%a6%9c%e0%a6%bf%e0%a6%ac%e0%a6%be%e0%a6%9c%e0%a6%be%e0%a6%b0%e0%a7%87%e0%a6%b0/</link>

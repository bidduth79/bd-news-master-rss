    <item>
      <title>নেতানিয়াহু আর ১ মিনিটও প্রধানমন্ত্রী পদে থাকতে পারেন না: আইজেনকট</title>
      <link>https://outlookbangla.com/2026/11/16/%e0%a6%a8%e0%a7%87%e0%a6%a4%e0%a6%be%e0%a6%a8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b9%e0%a7%81-%e0%a6%86%e0%a6%b0-%e0%a7%a7-%e0%a6%ae%e0%a6%bf%e0%a6%a8%e0%a6%bf%e0%a6%9f%e0%a6%93-%e0%a6%aa/</link>

    <item>
      <title>আবাসন খাতে রাজনৈতিক প্রভাব ও যোগসাজশে গড়ে উঠেছে মাফিয়াতন্ত্র: টিআইবি</title>
      <link>https://outlookbangla.com/2026/11/25/%e0%a6%86%e0%a6%ac%e0%a6%be%e0%a6%b8%e0%a6%a8-%e0%a6%96%e0%a6%be%e0%a6%a4%e0%a7%87-%e0%a6%b0%e0%a6%be%e0%a6%9c%e0%a6%a8%e0%a7%88%e0%a6%a4%e0%a6%bf%e0%a6%95-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%ad/</link>

    <item>
      <title>রোজার আগে খেজুর, আপেল ও কমলার শুল্ক কমালো এনবিআর</title>
      <link>https://outlookbangla.com/2026/11/25/%e0%a6%b0%e0%a7%8b%e0%a6%9c%e0%a6%be%e0%a6%b0-%e0%a6%86%e0%a6%97%e0%a7%87-%e0%a6%96%e0%a7%87%e0%a6%9c%e0%a7%81%e0%a6%b0-%e0%a6%86%e0%a6%aa%e0%a7%87%e0%a6%b2-%e0%a6%93-%e0%a6%95%e0%a6%ae%e0%a6%b2/</link>
      <guid isPermaLink="true">https://outlookbangla.com/2026/11/25/%e0%a6%b0%e0%a7%8b%e0%a6%9c%e0%a6%be%e0%a6%b0-%e0%a6%86%e0%a6%97%e0%a7%87-%e0%a6%96%e0%a7%87%e0%a6%9c%e0%a7%81%e0%a6%b0-%e0%a6%86%e0%a6%aa%e0%a7%87%e0%a6%b2-%e0%a6%93-%e0%a6%95%e0%a6%ae%e0%a6%b2/</guid>
      <pubDate>Wed, 25 Nov 2026 12:00:29 +0000</pubDate>
      <description>আসন্ন রমজানে খেজুর, আপেল ও কমলার দাম নিয়ন্ত্রণে রাখতে আমদানিতে শুল্ক কমিয়েছে জাতীয় রাজস্ব বোর্ড (এনবিআর)। খেজুরের আমদানি শুল্ক ২৫ শতাংশ থেকে কমিয়ে ৫ শতাংশ করা হয়েছে। অন্যদিকে আপেল ও কমলা আমদানিতে নিয়ন্ত্রণমূলক শুল্ক কমিয়ে ৫ শতাংশ নির্ধারণ করা হয়েছে। গতকাল মঙ্গলবার জারি করা এক প্রজ্ঞাপনে এসব তথ্য জান</description>
      <source url="https://outlookbangla.com/2026/11/25/%e0%a6%b0%e0%a7%8b%e0%a6%9c%e0%a6%be%e0%a6%b0-%e0%a6%86%e0%a6%97%e0%a7%87-%e0%a6%96%e0%a7%87%e0%a6%9c%e0%a7%81%e0%a6%b0-%e0%a6%86%e0%a6%aa%e0%a7%87%e0%a6%b2-%e0%a6%93-%e0%a6%95%e0%a6%ae%e0%a6%b2/">outlookbangla.com</source>
    </item>
    <item>
      <title>আইনশৃঙ্খলা বাহিনীর কিছু কর্মকর্তা ফ্যাসিস্ট শক্তির সঙ্গে যুক্ত রয়েছে: স্বরাষ্ট্রমন্ত্রী</title>

    <item>
      <title>জাতীয় এসএমই পণ্য মেলার উদ্বোধন করলেন প্রধানমন্ত্রী</title>
      <link>https://outlookbangla.com/2026/11/22/%e0%a6%9c%e0%a6%be%e0%a6%a4%e0%a7%80%e0%a6%af%e0%a6%bc-%e0%a6%8f%e0%a6%b8%e0%a6%8f%e0%a6%ae%e0%a6%87-%e0%a6%aa%e0%a6%a3%e0%a7%8d%e0%a6%af-%e0%a6%ae%e0%a7%87%e0%a6%b2%e0%a6%be%e0%a6%b0-%e0%a6%89/</link>

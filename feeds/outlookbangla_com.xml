    <item>
      <title>বিচ্ছেদের ঘোষণা সংগীতশিল্পী ন্যানসির</title>
      <link>https://outlookbangla.com/2026/11/26/%e0%a6%ac%e0%a6%bf%e0%a6%9a%e0%a7%8d%e0%a6%9b%e0%a7%87%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%98%e0%a7%8b%e0%a6%b7%e0%a6%a3%e0%a6%be-%e0%a6%b8%e0%a6%82%e0%a6%97%e0%a7%80%e0%a6%a4%e0%a6%b6%e0%a6%bf%e0%a6%b2/</link>
      <guid isPermaLink="true">https://outlookbangla.com/2026/11/26/%e0%a6%ac%e0%a6%bf%e0%a6%9a%e0%a7%8d%e0%a6%9b%e0%a7%87%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%98%e0%a7%8b%e0%a6%b7%e0%a6%a3%e0%a6%be-%e0%a6%b8%e0%a6%82%e0%a6%97%e0%a7%80%e0%a6%a4%e0%a6%b6%e0%a6%bf%e0%a6%b2/</guid>
      <pubDate>Thu, 26 Nov 2026 13:47:50 +0000</pubDate>
      <description>বিচ্ছেদের ঘোষণা দিয়েছেন জনপ্রিয় সংগীত শিল্পী নাজমুন মুনিরা ন্যানসি। বুধবার (২৫ নভেম্বর) রাতে ৯টা ৪০ মিনিটে এক পোস্টে তিনি এটি জানান। ন্যানসি জানান, মেহেদি এবং আমি আলাদা হয়ে যাওয়ার সিদ্ধান্ত নিয়েছি। তিনি আরও লেখেন, যে যাত্রা একসময় আমাদের কাছে সবকিছু ছিল, তার সমাপ্তি ঘটেছে। বহু বছরের স্মৃতি ও অভিজ্ঞতা</description>
      <source url="https://outlookbangla.com/2026/11/26/%e0%a6%ac%e0%a6%bf%e0%a6%9a%e0%a7%8d%e0%a6%9b%e0%a7%87%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%98%e0%a7%8b%e0%a6%b7%e0%a6%a3%e0%a6%be-%e0%a6%b8%e0%a6%82%e0%a6%97%e0%a7%80%e0%a6%a4%e0%a6%b6%e0%a6%bf%e0%a6%b2/">outlookbangla.com</source>
    </item>
    <item>
      <title>হোয়াটসঅ্যাপে আগে থেকেই পাঠিয়ে রাখা যাবে মেসেজ, পাঠাবেন যেভাবে</title>
      <link>https://outlookbangla.com/2026/11/26/%e0%a6%b9%e0%a7%8b%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%9f%e0%a6%b8%e0%a6%85%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%aa%e0%a7%87-%e0%a6%86%e0%a6%97%e0%a7%87-%e0%a6%a5%e0%a7%87%e0%a6%95%e0%a7%87%e0%a6%87/</link>

    <item>
      <title>সঞ্চয়পত্রে বিনিয়োগে ছন্দপতন</title>
      <link>https://outlookbangla.com/2026/11/17/%e0%a6%b8%e0%a6%9e%e0%a7%8d%e0%a6%9a%e0%a6%af%e0%a6%bc%e0%a6%aa%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%a8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%8b%e0%a6%97%e0%a7%87-%e0%a6%9b%e0%a6%a8/</link>

    </item>
    <item>
      <title>নাচ থেকে গানে, বয়কট থেকে বিশ্বরেকর্ড রুনা লায়লার</title>
      <link>https://outlookbangla.com/2026/11/17/%e0%a6%a8%e0%a6%be%e0%a6%9a-%e0%a6%a5%e0%a7%87%e0%a6%95%e0%a7%87-%e0%a6%97%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%ac%e0%a6%af%e0%a6%bc%e0%a6%95%e0%a6%9f-%e0%a6%a5%e0%a7%87%e0%a6%95%e0%a7%87-%e0%a6%ac/</link>

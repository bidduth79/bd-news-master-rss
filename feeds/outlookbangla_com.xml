    <item>
      <title>শ্রমিকদের নতুন মজুরি ১ ডিসেম্বর থেকেই কার্যকর: বোর্ড চেয়ারম্যান</title>
      <link>https://outlookbangla.com/2026/11/17/%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a6%ae%e0%a6%bf%e0%a6%95%e0%a6%a6%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%ae%e0%a6%9c%e0%a7%81%e0%a6%b0%e0%a6%bf-%e0%a7%a7-%e0%a6%a1%e0%a6%bf/</link>

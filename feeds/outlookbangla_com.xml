    <item>
      <title>সি-স্যুট অ্যাওয়ার্ডে ভূষিত হলেন ওয়ালটন প্লাজার এমডি মোহাম্মদ রায়হান</title>
      <link>https://outlookbangla.com/2026/11/24/%e0%a6%b8%e0%a6%bf-%e0%a6%b8%e0%a7%8d%e0%a6%af%e0%a7%81%e0%a6%9f-%e0%a6%85%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%93%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%a1%e0%a7%87-%e0%a6%ad%e0%a7%82/</link>

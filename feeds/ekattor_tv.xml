    <item>
      <title>দুই কোটির সিনেমার আয় ৪৫২ কোটি, সাফল্যের নেপথ্যে তিন নারী</title>
      <link>https://ekattor.tv/entertainment/bollywood/98587/%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%AE%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A7%9F-%E0%A7%AA%E0%A7%AB%E0%A7%A8-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%B8%E0%A6%BE%E0%A6%AB%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A7%87%E0%A6%AA%E0%A6%A5%E0%A7%8D%E0%A6%AF%E0%A7%87</link>
      <guid isPermaLink="true">https://ekattor.tv/entertainment/bollywood/98587/%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%AE%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A7%9F-%E0%A7%AA%E0%A7%AB%E0%A7%A8-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%B8%E0%A6%BE%E0%A6%AB%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A7%87%E0%A6%AA%E0%A6%A5%E0%A7%8D%E0%A6%AF%E0%A7%87</guid>
      <pubDate>Fri, 27 Nov 2026 18:41:58 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/8e3bde2c29222fb4e949dbfbc9447a25-6b097a455b794.jpg?jadewits_media_id=66148" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/8e3bde2c29222fb4e949dbfbc9447a25-6b097a455b794.jpg?jadewits_media_id=66148" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/8e3bde2c29222fb4e949dbfbc9447a25-6b097a455b794.jpg?jadewits_media_id=66148" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দুই কোটির সিনেমার আয় ৪৫২ কোটি, সাফল্যের নেপথ্যে তিন নারী" /&gt;&lt;/p&gt;&lt;p&gt;মাত্র দুই কোটি রুপি বাজেটে নির্মিত একটি সিনেমা আয় করেছে ৪৫২ কোটি ৮৬ লাখ রুপি। বলিউডের বড় বাজেটের সিনেমাগুলোর সঙ্গে পাল্লা দিয়ে এমন অভাবনীয় সাফল্য পেয়েছে নিম করোলি বাবার জীবন অবলম্বনে নির্মিত ‘হনুমান অংশ’। তবে এই সাফল্যের পেছনে শুধু নির্মাতার পরিকল্পনা কিংবা দর্শকদের ভালোবাসা নয়, গুরুত্বপূর্ণ ভূমিকা &lt;/p&gt;</description>

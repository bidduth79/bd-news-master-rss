      <pubDate>Thu, 19 Nov 2026 16:05:07 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/0d8f7cb71284c91fd19b60e8444540e2-6afec9a37859d.jpg?jadewits_media_id=65368" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/0d8f7cb71284c91fd19b60e8444540e2-6afec9a37859d.jpg?jadewits_media_id=65368" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/0d8f7cb71284c91fd19b60e8444540e2-6afec9a37859d.jpg?jadewits_media_id=65368" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘ইরানকে পারমাণবিক অস্ত্র পেতে দেব না’" /&gt;&lt;/p&gt;&lt;p&gt;ট্রাম্প সোজা জানিয়ে দেন, আমরা ইরানকে পারমাণবিক অস্ত্র পেতে দেব না। বিশ্বের সবচেয়ে বড় পারমাণবিক ক্ষমতাধর এই তিন দেশের অবস্থানের কথা উল্লেখ করে মার্কিন প্রেসিডেন্ট বলেন, পৃথিবীতে পারমাণবিক অস্ত্রের সংখ্যা কীভাবে কমানো যায়, তা নিয়ে আলোচনা করার ক্ষেত্রে তাদের অবস্থান অনন্য। অন্যান্য দেশে পারমাণবিক অস্ত্&lt;/p&gt;</description>
      <source url="https://ekattor.tv/international/asia/97981/%E2%80%98%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%AE%E0%A6%BE%E0%A6%A3%E0%A6%AC%E0%A6%BF%E0%A6%95-%E0%A6%85%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AA%E0%A7%87%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%AC-%E0%A6%A8%E0%A6%BE%E2%80%99">একাত্তর</source>
    </item>
    <item>
      <title>ঘূর্ণিঝড় আকভানের প্রভাবে সারা দেশে বৃষ্টি, তাপমাত্রা নিয়ে নতুন বার্তা</title>
      <link>https://ekattor.tv/national/97980/%E0%A6%98%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A6%BF%E0%A6%9D%E0%A7%9C-%E0%A6%86%E0%A6%95%E0%A6%AD%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AC%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF</link>
      <guid isPermaLink="true">https://ekattor.tv/national/97980/%E0%A6%98%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A6%BF%E0%A6%9D%E0%A7%9C-%E0%A6%86%E0%A6%95%E0%A6%AD%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AC%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF</guid>
      <pubDate>Thu, 19 Nov 2026 15:58:43 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/cefab2252d25c419d352fa76e75596a9-6afec8465a97c.jpg?jadewits_media_id=65367" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/cefab2252d25c419d352fa76e75596a9-6afec8465a97c.jpg?jadewits_media_id=65367" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/cefab2252d25c419d352fa76e75596a9-6afec8465a97c.jpg?jadewits_media_id=65367" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঘূর্ণিঝড় আকভানের প্রভাবে সারা দেশে বৃষ্টি, তাপমাত্রা নিয়ে নতুন বার্তা" /&gt;&lt;/p&gt;&lt;p&gt;বঙ্গোপসাগরে সৃষ্টি হওয়া প্রবল ঘূর্ণিঝড় আকভানের প্রভাবে রাজধানী ঢাকাসহ দেশের বিভিন্ন এলাকায় হালকা থেকে মাঝারি ধরনের বৃষ্টি হচ্ছে। সমুদ্র উত্তাল থাকায় দেশের সমুদ্রবন্দরগুলোকে ৩ নম্বর স্থানীয় সতর্কসংকেত দেখাতে বলেছে আবহাওয়া অধিদপ্তর। আগামী তিন দিন বৃষ্টিপাতের এ প্রবণতা অব্যাহত থাকতে পারে। বৃষ্টির কারণে&lt;/p&gt;</description>
      <source url="https://ekattor.tv/national/97980/%E0%A6%98%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A6%BF%E0%A6%9D%E0%A7%9C-%E0%A6%86%E0%A6%95%E0%A6%AD%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AC%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF">একাত্তর</source>
    </item>
    <item>
      <title>ইউনূসের বিরুদ্ধে মামলার কথা ভাবছেন টিউলিপ সিদ্দিক</title>
      <link>https://ekattor.tv/abroad/97979/%E0%A6%87%E0%A6%89%E0%A6%A8%E0%A7%82%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%A5%E0%A6%BE-%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%9F%E0%A6%BF%E0%A6%89%E0%A6%B2%E0%A6%BF%E0%A6%AA-%E0%A6%B8%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A6%E0%A6%BF%E0%A6%95</link>
      <guid isPermaLink="true">https://ekattor.tv/abroad/97979/%E0%A6%87%E0%A6%89%E0%A6%A8%E0%A7%82%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%A5%E0%A6%BE-%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%9F%E0%A6%BF%E0%A6%89%E0%A6%B2%E0%A6%BF%E0%A6%AA-%E0%A6%B8%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A6%E0%A6%BF%E0%A6%95</guid>
      <pubDate>Thu, 19 Nov 2026 15:48:34 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/59ad17391fa13f0e2bc3ce7fea232c3c-6afec5b6c0360.jpg?jadewits_media_id=65366" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/59ad17391fa13f0e2bc3ce7fea232c3c-6afec5b6c0360.jpg?jadewits_media_id=65366" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/59ad17391fa13f0e2bc3ce7fea232c3c-6afec5b6c0360.jpg?jadewits_media_id=65366" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইউনূসের বিরুদ্ধে মামলার কথা ভাবছেন টিউলিপ সিদ্দিক" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশের সাবেক অন্তর্বর্তী সরকারের প্রধান ড. মুহাম্মদ ইউনূসের বিরুদ্ধে আইনি পদক্ষেপ নেওয়ার বিষয়টি বিবেচনা করছেন যুক্তরাজ্যের সাবেক মন্ত্রী এবং ক্ষমতাচ্যুত ও পলাতক সাবেক প্রধানমন্ত্রী শেখ হাসিনার ভাগ্নি টিউলিপ সিদ্দিক। তাঁর দাবি, ২০২৪ থেকে ২০২৬ সাল পর্যন্ত দায়িত্ব পালন করা ইউনূসের নেতৃত্বাধীন সরকার&lt;/p&gt;</description>
      <source url="https://ekattor.tv/abroad/97979/%E0%A6%87%E0%A6%89%E0%A6%A8%E0%A7%82%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%A5%E0%A6%BE-%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%9F%E0%A6%BF%E0%A6%89%E0%A6%B2%E0%A6%BF%E0%A6%AA-%E0%A6%B8%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A6%E0%A6%BF%E0%A6%95">একাত্তর</source>
    </item>
    <item>
      <title>মুশফিকের পর মিরাজও আউট, হারের শঙ্কায় বাংলাদেশ</title>

      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/c03f6cf252efd40c201e75c997e59bc1-6b073e5e2f725.jpg?jadewits_media_id=66023" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জিদানের সঙ্গে তুলনায় নারাজ বেলিংহ্যাম" /&gt;&lt;/p&gt;&lt;p&gt;চ্যাম্পিয়ন্স লিগে পিএসভির বিপক্ষে চোখধাঁধানো এক গোল করার পরও ফরাসি ফুটবল কিংবদন্তি জিনেদিন জিদানের সঙ্গে নিজের তুলনা বিনয়ের সঙ্গে উড়িয়ে দিয়েছেন রিয়াল মাদ্রিদ তারকা জুড বেলিংহ্যাম। মঙ্গলবার (২৪ নভেম্বর) সান্তিয়াগো বার্নাব্যুতে প্রথমার্ধে পিছিয়ে থাকা রিয়াল মাদ্রিদ বিরতির পর বদলি হিসেবে বেলিংহ্যাম মাঠে&lt;/p&gt;</description>
      <source url="https://ekattor.tv/sports/football/98478/%E0%A6%9C%E0%A6%BF%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%A4%E0%A7%81%E0%A6%B2%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%9C-%E0%A6%AC%E0%A7%87%E0%A6%B2%E0%A6%BF%E0%A6%82%E0%A6%B9%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE">একাত্তর</source>

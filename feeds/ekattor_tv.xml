      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/e8ed21e15351917df144438fc3baf99f-6b01417fa984d.jpg?jadewits_media_id=65516" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/e8ed21e15351917df144438fc3baf99f-6b01417fa984d.jpg?jadewits_media_id=65516" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এশিয়া কাপে বিকেলে আফগানিস্তান ‘এ’ দলের মুখোমুখি বাংলাদেশ ‘এ’" /&gt;&lt;/p&gt;&lt;p&gt;এশিয়া কাপ রাইজিং স্টার্সে জয়ের ধারা ধরে রাখার লক্ষ্যে আজ শনিবার (২১ নভেম্বর) নিজেদের দ্বিতীয় ম্যাচে মাঠে নামছে বাংলাদেশ ‘এ’ দল। কাতারের দোহার ওয়েস্ট এন্ড পার্ক ইন্টারন্যাশনাল ক্রিকেট স্টেডিয়ামে (এশিয়ান টাউন ক্রিকেট স্টেডিয়াম) সাইফ হাসানদের প্রতিপক্ষ আফগানিস্তান ‘এ’ দল। ম্যাচটি শুরু হবে বাংলাদ&lt;/p&gt;</description>
      <source url="https://ekattor.tv/sports/cricket/98087/%E0%A6%8F%E0%A6%B6%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE-%E0%A6%95%E0%A6%BE%E0%A6%AA%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%86%E0%A6%AB%E0%A6%97%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8-%E2%80%98%E0%A6%8F%E2%80%99-%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%8B%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A6%BF">একাত্তর</source>

      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/923c8ba114c7cdba658b2adae8faa8ac-6af6939310246.jpg?jadewits_media_id=64823" length="0" type="image/jpeg" />

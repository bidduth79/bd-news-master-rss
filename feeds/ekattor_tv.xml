    <item>
      <title>বাড়িতে আগুন, আওয়ামী লীগকে দুষলেন নুসরাত</title>
      <link>https://ekattor.tv/national/97518/%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A6%95%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%B7%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%A8%E0%A7%81%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%A4</link>
      <guid isPermaLink="true">https://ekattor.tv/national/97518/%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A6%95%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%B7%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%A8%E0%A7%81%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%A4</guid>
      <pubDate>Thu, 12 Nov 2026 14:37:28 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/377ff577fc59a1d1bb3728b404fe7d6f-6af57ab81c2fb.jpg?jadewits_media_id=64733" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/377ff577fc59a1d1bb3728b404fe7d6f-6af57ab81c2fb.jpg?jadewits_media_id=64733" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/377ff577fc59a1d1bb3728b404fe7d6f-6af57ab81c2fb.jpg?jadewits_media_id=64733" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাড়িতে আগুন, আওয়ামী লীগকে দুষলেন নুসরাত" /&gt;&lt;/p&gt;&lt;p&gt;কুষ্টিয়ার দৌলতপুরে জাতীয় নাগরিক পার্টির (এনসিপি) রাজনৈতিক পর্ষদের সদস্য ও সংসদ সদস্য নুসরাত তাবাসসুমের পৈতৃক বাড়িতে পেট্রল বোমা নিক্ষেপ করে আগুন দেওয়ার ঘটনা ঘটেছে। মধ্যরাতে সংঘটিত এই নাশকতার ঘটনায় তীব্র ক্ষোভ প্রকাশ করে নিজ বাড়িতে আয়োজিত এক সংবাদ সম্মেলনে এমপি নুসরাত একে আওয়ামী লীগের পরিকল্পিত হামলা&lt;/p&gt;</description>
      <source url="https://ekattor.tv/national/97518/%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A6%95%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%B7%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%A8%E0%A7%81%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%A4">একাত্তর</source>
    </item>
    <item>
      <title>রাজনীতিবিদরা ঠিক হলেই দেশ বদলে যাবে: স্পিকার</title>

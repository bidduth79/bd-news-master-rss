      <guid isPermaLink="true">https://ekattor.tv/country/rajshahi/98589/%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%AA%E0%A6%BE%E0%A6%87%E0%A6%A8%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%B8%E0%A7%87%E0%A6%87-%E0%A6%AC%E0%A7%9C%E0%A6%BE%E0%A6%87%E0%A6%B2-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A5%E0%A6%AE%E0%A6%BF%E0%A6%95-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2</guid>
      <pubDate>Fri, 27 Nov 2026 19:15:17 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/6888750c7bb34c56e77a21afb4b7d179-6b097cdef06eb.jpg?jadewits_media_id=66150" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/6888750c7bb34c56e77a21afb4b7d179-6b097cdef06eb.jpg?jadewits_media_id=66150" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/6888750c7bb34c56e77a21afb4b7d179-6b097cdef06eb.jpg?jadewits_media_id=66150" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চাঁপাইনবাবগঞ্জের সেই বড়াইল প্রাথমিক বিদ্যালয়ে মিলল সুপেয় পানি" /&gt;&lt;/p&gt;&lt;p&gt;চাঁপাইনবাবগঞ্জের গোমস্তাপুর উপজেলার পার্বতীপুর ইউনিয়নের আদিবাসী ও ক্ষুদ্র নৃগোষ্ঠী অধ্যুষিত বড়াইল গ্রামের বড়াইল বেসরকারি প্রাথমিক বিদ্যালয়ে সুপেয় পানির পাম্প স্থাপন করা হয়েছে। শুক্রবার (২৭ নভেম্বর) উপজেলা নির্বাহী কর্মকর্তা (ইউএনও) মো. জিল্লুর রহমানের উদ্যোগে পাম্পটি বসানো হয়।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/country/rajshahi/98589/%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%AA%E0%A6%BE%E0%A6%87%E0%A6%A8%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%B8%E0%A7%87%E0%A6%87-%E0%A6%AC%E0%A7%9C%E0%A6%BE%E0%A6%87%E0%A6%B2-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A5%E0%A6%AE%E0%A6%BF%E0%A6%95-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2">একাত্তর</source>

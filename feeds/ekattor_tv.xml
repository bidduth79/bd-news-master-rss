      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/0527472e216d57452253bfc802730ec4-6b05ab5aaf617.jpg?jadewits_media_id=65884" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/0527472e216d57452253bfc802730ec4-6b05ab5aaf617.jpg?jadewits_media_id=65884" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পোশাক শ্রমিকদের ন্যূনতম মজুরি নিয়ে সমঝোতার ইঙ্গিত" /&gt;&lt;/p&gt;&lt;p&gt;তৈরি পোশাক খাতের শ্রমিকদের নতুন ন্যূনতম মাসিক মজুরি নির্ধারণ নিয়ে মালিক ও শ্রমিকপক্ষের মধ্যে সমঝোতার সম্ভাবনা তৈরি হয়েছে। দুই পক্ষের প্রস্তাবের ব্যবধান কমে আসায় মঙ্গলবার রাতেই চূড়ান্ত সিদ্ধান্ত আসতে পারে বলে আশা প্রকাশ করেছে নিম্নতম মজুরি বোর্ড। সবশেষ আলোচনায় মালিকপক্ষ ১৫ হাজার ৭০০ টাকা এবং শ্রমিকপক&lt;/p&gt;</description>
      <source url="https://ekattor.tv/national/98384/%E0%A6%AA%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%95-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A7%82%E0%A6%A8%E0%A6%A4%E0%A6%AE-%E0%A6%AE%E0%A6%9C%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B8%E0%A6%AE%E0%A6%9D%E0%A7%8B%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BF%E0%A6%A4">একাত্তর</source>

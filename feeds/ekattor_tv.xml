      <guid isPermaLink="true">https://ekattor.tv/international/south-asia/98378/%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A6%97%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%AB%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%9F-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%B9%E0%A6%B2%E0%A7%8B-%E0%A6%B8%E0%A7%8C%E0%A6%B0%E0%A6%AD%E0%A6%95%E0%A7%87</guid>
      <pubDate>Tue, 24 Nov 2026 20:38:31 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/3700e75d678cc0c0a75b7fa95a4acae2-6b05a15e0ca70.jpg?jadewits_media_id=65879" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/3700e75d678cc0c0a75b7fa95a4acae2-6b05a15e0ca70.jpg?jadewits_media_id=65879" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/3700e75d678cc0c0a75b7fa95a4acae2-6b05a15e0ca70.jpg?jadewits_media_id=65879" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যুক্তরাজ্যগামী ফ্লাইট থেকে নামানো হলো সৌরভকে" /&gt;&lt;/p&gt;&lt;p&gt;পাসপোর্টে জন্মস্থান ভুল উল্লেখ থাকায় ভারতের ককরোচ জনতা পার্টির (সিজেপি) প্রধান মুখপাত্র ও সহ-আহ্বায়ক সৌরভ দাসকে যুক্তরাজ্যগামী ফ্লাইটে উঠতে বাধা দেয়া হয়েছে বলে সংশ্লিষ্ট সূত্র জানিয়েছে। এনডিটিভিকে দেয়া তথ্যে সূত্রগুলো জানায়, একটি অনুষ্ঠানে যোগ দিতে লন্ডনে যাওয়ার কথা থাকলেও জন্মস্থান হিসেবে পাসপোর্টে&lt;/p&gt;</description>
      <source url="https://ekattor.tv/international/south-asia/98378/%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A6%97%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%AB%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%9F-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%B9%E0%A6%B2%E0%A7%8B-%E0%A6%B8%E0%A7%8C%E0%A6%B0%E0%A6%AD%E0%A6%95%E0%A7%87">একাত্তর</source>

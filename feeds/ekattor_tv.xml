      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/f82a1efd61076339332ade02666d80ec-6afedb9849948.jpg?jadewits_media_id=65382" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আগামী ৫৫ বছরে ভারতে কমবে হিন্দু, বাড়বে মুসলিম" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাষ্ট্রভিত্তিক গবেষণা সংস্থা পিউ রিসার্চ সেন্টারের নতুন এক প্রতিবেদনে ২০৭০ সাল নাগাদ ভারতের ধর্মীয় জনসংখ্যার অনুপাতে পরিবর্তনের চিত্র তুলে ধরা হয়েছে। পূর্বাভাস অনুযায়ী, আগামী কয়েক দশকে শতাংশের হারে কিছুটা বদল এলেও ভারতে হিন্দুরাই সংখ্যাগরিষ্ঠ অবস্থানে থাকবেন। ২০২০ সালে ভারতের মোট জনসংখ্যার ৭৯ শ&lt;/p&gt;</description>
      <source url="https://ekattor.tv/international/south-asia/97991/%E0%A6%86%E0%A6%97%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A7%AB%E0%A7%AB-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A6%AE%E0%A6%AC%E0%A7%87-%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%81-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%AC%E0%A7%87-%E0%A6%AE%E0%A7%81%E0%A6%B8%E0%A6%B2%E0%A6%BF%E0%A6%AE">একাত্তর</source>

    <item>
      <title>ইউপি ভোট ইসির সংলাপ শুরু রোববার, যাচ্ছে না জামায়াত</title>
      <link>https://ekattor.tv/politics/98668/%E0%A6%87%E0%A6%89%E0%A6%AA%E0%A6%BF-%E0%A6%AD%E0%A7%8B%E0%A6%9F-%E0%A6%87%E0%A6%B8%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%AA-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81-%E0%A6%B0%E0%A7%8B%E0%A6%AC%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%A8%E0%A6%BE-%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%A4</link>
      <guid isPermaLink="true">https://ekattor.tv/politics/98668/%E0%A6%87%E0%A6%89%E0%A6%AA%E0%A6%BF-%E0%A6%AD%E0%A7%8B%E0%A6%9F-%E0%A6%87%E0%A6%B8%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%AA-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81-%E0%A6%B0%E0%A7%8B%E0%A6%AC%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%A8%E0%A6%BE-%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%A4</guid>
      <pubDate>Sat, 28 Nov 2026 23:23:02 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2023/12/28/b6267ccaa0b78392031cbd8816c601eb-658d56d45de6c.jpg?jadewits_media_id=8892" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2023/12/28/b6267ccaa0b78392031cbd8816c601eb-658d56d45de6c.jpg?jadewits_media_id=8892" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2023/12/28/b6267ccaa0b78392031cbd8816c601eb-658d56d45de6c.jpg?jadewits_media_id=8892" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইউপি ভোট ইসির সংলাপ শুরু রোববার, যাচ্ছে না জামায়াত" /&gt;&lt;/p&gt;&lt;p&gt;আসন্ন ইউনিয়ন পরিষদ (ইউপি) নির্বাচন সামনে রেখে রোববার (২৯ নভেম্বর) থেকে রাজনৈতিক দলগুলোর সঙ্গে সংলাপ শুরু করতে যাচ্ছে নির্বাচন কমিশন (ইসি)। টানা তিন দিনের এই ধারাবাহিক সংলাপে বিএনপি, জামায়াতে ইসলামী ও জাতীয় নাগরিক পার্টিসহ (এনসিপি) নিবন্ধিত ৫৫টি দলকে আমন্ত্রণ জানানো হয়েছে।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/politics/98668/%E0%A6%87%E0%A6%89%E0%A6%AA%E0%A6%BF-%E0%A6%AD%E0%A7%8B%E0%A6%9F-%E0%A6%87%E0%A6%B8%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%AA-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81-%E0%A6%B0%E0%A7%8B%E0%A6%AC%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%A8%E0%A6%BE-%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%A4">একাত্তর</source>
    </item>

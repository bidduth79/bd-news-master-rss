    <item>
      <title>চাকরির বাজারের চাহিদা অনুযায়ী বিশ্ববিদ্যালয়ের শিক্ষার মান বাড়ানোর তাগিদ রাষ্ট্রপতির</title>
      <link>https://ekattor.tv/national/97687/%E0%A6%9A%E0%A6%BE%E0%A6%95%E0%A6%B0%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A6%E0%A6%BE-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AF%E0%A6%BE%E0%A7%9F%E0%A7%80-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://ekattor.tv/national/97687/%E0%A6%9A%E0%A6%BE%E0%A6%95%E0%A6%B0%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A6%E0%A6%BE-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AF%E0%A6%BE%E0%A7%9F%E0%A7%80-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Sun, 15 Nov 2026 13:56:59 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/a73b4337290c720d59d736120ab7ff1b-6af9656554650.jpg?jadewits_media_id=64965" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/a73b4337290c720d59d736120ab7ff1b-6af9656554650.jpg?jadewits_media_id=64965" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/a73b4337290c720d59d736120ab7ff1b-6af9656554650.jpg?jadewits_media_id=64965" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চাকরির বাজারের চাহিদা অনুযায়ী বিশ্ববিদ্যালয়ের শিক্ষার মান বাড়ানোর তাগিদ রাষ্ট্রপতির" /&gt;&lt;/p&gt;&lt;p&gt;দেশের সরকারি ও বেসরকারি বিশ্ববিদ্যালয়গুলোকে দেশীয় ও আন্তর্জাতিক চাকরির বাজারের চাহিদা অনুযায়ী শিক্ষার মান ও শিক্ষার্থীদের দক্ষতা বাড়ানোর ওপর গুরুত্ব দিয়েছেন রাষ্ট্রপতি মির্জা ফখরুল ইসলাম আলমগীর। তিনি বলেন, ‘শিক্ষার্থীদের ডিজিটাল প্রযুক্তি, যোগাযোগ দক্ষতাসহ প্রয়োজনীয় দক্ষতা উন্নয়নে গুরুত্ব দিয়ে বিশ্ব&lt;/p&gt;</description>
      <source url="https://ekattor.tv/national/97687/%E0%A6%9A%E0%A6%BE%E0%A6%95%E0%A6%B0%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A6%E0%A6%BE-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AF%E0%A6%BE%E0%A7%9F%E0%A7%80-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B0">একাত্তর</source>

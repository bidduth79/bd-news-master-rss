    <item>
      <title>হাম উপসর্গে আরও চার মৃত্যু, মোট ১২৯৯</title>
      <link>https://ekattor.tv/health/97523/%E0%A6%B9%E0%A6%BE%E0%A6%AE-%E0%A6%89%E0%A6%AA%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81-%E0%A6%AE%E0%A7%8B%E0%A6%9F-%E0%A7%A7%E0%A7%A8%E0%A7%AF%E0%A7%AF</link>
      <guid isPermaLink="true">https://ekattor.tv/health/97523/%E0%A6%B9%E0%A6%BE%E0%A6%AE-%E0%A6%89%E0%A6%AA%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81-%E0%A6%AE%E0%A7%8B%E0%A6%9F-%E0%A7%A7%E0%A7%A8%E0%A7%AF%E0%A7%AF</guid>
      <pubDate>Thu, 12 Nov 2026 15:28:28 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/10/08/1b6d017712ef9d24cbea2b8dab5bf210-6ac72a748a022.jpg?jadewits_media_id=62534" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/10/08/1b6d017712ef9d24cbea2b8dab5bf210-6ac72a748a022.jpg?jadewits_media_id=62534" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/10/08/1b6d017712ef9d24cbea2b8dab5bf210-6ac72a748a022.jpg?jadewits_media_id=62534" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হাম উপসর্গে আরও চার মৃত্যু, মোট ১২৯৯" /&gt;&lt;/p&gt;&lt;p&gt;গত ২৪ ঘণ্টায় সারাদেশে হাম উপসর্গে আরও চার শিশুর মৃত্যু হয়েছে। একই সময়ে নতুন করে ১৫৭ শিশুর হাম শনাক্ত হয়েছে, হাম উপসর্গ দেখা গেছে এক হাজার ৩৮৪ শিশুর মধ্যে। আর হাম নিয়ে হাসপাতালে ভর্তি হয়েছে এক হাজার ২৬৯টি শিশু। 						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/health/97523/%E0%A6%B9%E0%A6%BE%E0%A6%AE-%E0%A6%89%E0%A6%AA%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81-%E0%A6%AE%E0%A7%8B%E0%A6%9F-%E0%A7%A7%E0%A7%A8%E0%A7%AF%E0%A7%AF">একাত্তর</source>
    </item>
    <item>
      <title>শক্তিশালী রাষ্ট্রের প্রশ্রয়ে দেশজুড়ে নাশকতার চেষ্টা চলছে: রিজভী</title>
      <link>https://ekattor.tv/politics/97522/%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B6%E0%A6%BE%E0%A6%B2%E0%A7%80-%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%9F%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%9C%E0%A7%81%E0%A7%9C%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://ekattor.tv/politics/97522/%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B6%E0%A6%BE%E0%A6%B2%E0%A7%80-%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%9F%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%9C%E0%A7%81%E0%A7%9C%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Thu, 12 Nov 2026 15:25:21 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/3aed5de2d2b12470fb4b924596b36774-6af585bb80a6b.jpg?jadewits_media_id=64743" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/3aed5de2d2b12470fb4b924596b36774-6af585bb80a6b.jpg?jadewits_media_id=64743" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/3aed5de2d2b12470fb4b924596b36774-6af585bb80a6b.jpg?jadewits_media_id=64743" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শক্তিশালী রাষ্ট্রের প্রশ্রয়ে দেশজুড়ে নাশকতার চেষ্টা চলছে: রিজভী" /&gt;&lt;/p&gt;&lt;p&gt;শক্তিশালী কোনো রাষ্ট্রের প্রশ্রয়ে দেশজুড়ে পরিকল্পিতভাবে নাশকতা সৃষ্টির চেষ্টা চলছে বলে অভিযোগ করেছেন বিএনপির ভারপ্রাপ্ত মহাসচিব রুহুল কবির রিজভী। জাতীয় নাগরিক পার্টির সংসদ সদস্য নুসরাত তাবাসসুমের গ্রামের বাড়িতে অগ্নিসংযোগের ঘটনায় নিন্দা জানিয়ে তিনি বলেন, ‘অপশক্তির এসব তৎপরতা বেশিদিন টিকবে না।’						&lt;/p&gt;</description>
      <source url="https://ekattor.tv/politics/97522/%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B6%E0%A6%BE%E0%A6%B2%E0%A7%80-%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%9F%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%9C%E0%A7%81%E0%A7%9C%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%BE%E0%A6%B0">একাত্তর</source>
    </item>
    <item>
      <title>ঋণ নয়, জলবায়ু-ঝুঁকিপূর্ণ দেশগুলোর প্রয়োজন অনুদান: প্রধানমন্ত্রী</title>
      <link>https://ekattor.tv/national/97521/%E0%A6%8B%E0%A6%A3-%E0%A6%A8%E0%A7%9F-%E0%A6%9C%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A7%81-%E0%A6%9D%E0%A7%81%E0%A6%81%E0%A6%95%E0%A6%BF%E0%A6%AA%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%A3-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A7%8B%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%9F%E0%A7%8B%E0%A6%9C%E0%A6%A8-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%A6%E0%A6%BE%E0%A6%A8</link>
      <guid isPermaLink="true">https://ekattor.tv/national/97521/%E0%A6%8B%E0%A6%A3-%E0%A6%A8%E0%A7%9F-%E0%A6%9C%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A7%81-%E0%A6%9D%E0%A7%81%E0%A6%81%E0%A6%95%E0%A6%BF%E0%A6%AA%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%A3-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A7%8B%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%9F%E0%A7%8B%E0%A6%9C%E0%A6%A8-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%A6%E0%A6%BE%E0%A6%A8</guid>
      <pubDate>Thu, 12 Nov 2026 15:08:37 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/cac38309d53b704dc6bf78d59bb609ed-6af581e503339.jpg?jadewits_media_id=64737" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/cac38309d53b704dc6bf78d59bb609ed-6af581e503339.jpg?jadewits_media_id=64737" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/cac38309d53b704dc6bf78d59bb609ed-6af581e503339.jpg?jadewits_media_id=64737" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঋণ নয়, জলবায়ু-ঝুঁকিপূর্ণ দেশগুলোর প্রয়োজন অনুদান: প্রধানমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;জলবায়ু পরিবর্তনের ভয়াবহ ঝুঁকিতে থাকা দেশগুলোর জন্য আর কোনো ঋণের বোঝা নয়, বরং সরাসরি অনুদান ও ন্যায্য আর্থিক সহায়তার জোরালো দাবি জানিয়েছেন বাংলাদেশের প্রধানমন্ত্রী তারেক রহমান। বৃহস্পতিবার তুরস্কের ভূমধ্যসাগরীয় শহর আন্তালিয়ায় অনুষ্ঠিত জাতিসংঘ জলবায়ু পরিবর্তন সম্মেলনের (কপ-৩১) উচ্চপর্যায়ের অধিবেশনে&lt;/p&gt;</description>
      <source url="https://ekattor.tv/national/97521/%E0%A6%8B%E0%A6%A3-%E0%A6%A8%E0%A7%9F-%E0%A6%9C%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A7%81-%E0%A6%9D%E0%A7%81%E0%A6%81%E0%A6%95%E0%A6%BF%E0%A6%AA%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%A3-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A7%8B%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%9F%E0%A7%8B%E0%A6%9C%E0%A6%A8-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%A6%E0%A6%BE%E0%A6%A8">একাত্তর</source>
    </item>
    <item>
      <title>‘সরকার বা জনগণের পক্ষে নয়, সম্পূর্ণ নিরপেক্ষ থাকবে তথ্য কমিশন’</title>
      <link>https://ekattor.tv/national/97520/%E2%80%98%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE-%E0%A6%9C%E0%A6%A8%E0%A6%97%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87-%E0%A6%A8%E0%A7%9F-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%A3-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%AA%E0%A7%87%E0%A6%95%E0%A7%8D%E0%A6%B7-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%AC%E0%A7%87</link>
      <guid isPermaLink="true">https://ekattor.tv/national/97520/%E2%80%98%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE-%E0%A6%9C%E0%A6%A8%E0%A6%97%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87-%E0%A6%A8%E0%A7%9F-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%A3-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%AA%E0%A7%87%E0%A6%95%E0%A7%8D%E0%A6%B7-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%AC%E0%A7%87</guid>
      <pubDate>Thu, 12 Nov 2026 15:10:38 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/1375eb1925d28c43d7c2031a3795af40-6af580caf1f9c.jpg?jadewits_media_id=64736" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/1375eb1925d28c43d7c2031a3795af40-6af580caf1f9c.jpg?jadewits_media_id=64736" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/1375eb1925d28c43d7c2031a3795af40-6af580caf1f9c.jpg?jadewits_media_id=64736" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘সরকার বা জনগণের পক্ষে নয়, সম্পূর্ণ নিরপেক্ষ থাকবে তথ্য কমিশন’" /&gt;&lt;/p&gt;&lt;p&gt;দেশের গণতান্ত্রিক চর্চা ও সুশাসন শক্তিশালী করতে তথ্য কমিশন সম্পূর্ণ নিরপেক্ষ ও স্বাধীনভাবে দায়িত্ব পালন করবে বলে জানিয়েছেন প্রধান তথ্য কমিশনার অধ্যাপক ড. নাহরিন ইসলাম খান। তিনি বলেন, ‘তথ্য কমিশন সরকার বা জনগণের পক্ষে থাকবে না, বরং সম্পূর্ণ নিরপেক্ষ থাকবে।’						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/national/97520/%E2%80%98%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE-%E0%A6%9C%E0%A6%A8%E0%A6%97%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87-%E0%A6%A8%E0%A7%9F-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%A3-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%AA%E0%A7%87%E0%A6%95%E0%A7%8D%E0%A6%B7-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%AC%E0%A7%87">একাত্তর</source>
    </item>
    <item>
      <title>বিনা খরচে মালয়েশিয়াতে চাকরি পাচ্ছেন ১১২ কর্মী</title>
      <link>https://ekattor.tv/national/97519/%E0%A6%AC%E0%A6%BF%E0%A6%A8%E0%A6%BE-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%95%E0%A6%B0%E0%A6%BF-%E0%A6%AA%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A7%A7%E0%A7%A7%E0%A7%A8-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%80</link>
      <guid isPermaLink="true">https://ekattor.tv/national/97519/%E0%A6%AC%E0%A6%BF%E0%A6%A8%E0%A6%BE-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%95%E0%A6%B0%E0%A6%BF-%E0%A6%AA%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A7%A7%E0%A7%A7%E0%A7%A8-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%80</guid>
      <pubDate>Thu, 12 Nov 2026 14:55:09 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/2ecf6d97ee0e65215600c390e0de7add-6af57eb689a5d.jpg?jadewits_media_id=64735" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/2ecf6d97ee0e65215600c390e0de7add-6af57eb689a5d.jpg?jadewits_media_id=64735" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/2ecf6d97ee0e65215600c390e0de7add-6af57eb689a5d.jpg?jadewits_media_id=64735" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিনা খরচে মালয়েশিয়াতে চাকরি পাচ্ছেন ১১২ কর্মী" /&gt;&lt;/p&gt;&lt;p&gt;শূন্য অভিবাসন ব্যয়ে মালয়েশিয়ার স্বনামধন্য বহুজাতিক প্রতিষ্ঠান ‘ডিএইচএল সাপ্লাই চেইন (মালয়েশিয়া) এসডিএন বিএইচডি’-তে বাংলাদেশি কর্মী নিয়োগের প্রক্রিয়া শুরু হয়েছে। সরকারি জনশক্তি রফতানিকারক প্রতিষ্ঠান বোয়েসেলের মাধ্যমে সম্পূর্ণ স্বচ্ছ ও মেধার ভিত্তিতে এই কর্মী নির্বাচন করা হচ্ছে।						বিস্তারিত&lt;/p&gt;</description>

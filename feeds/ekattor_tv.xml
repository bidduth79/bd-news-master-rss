    <item>
      <title>অমিতাভ ও অভিষেককে হত্যায় ২০০ কিলার প্রস্তুত!</title>
      <link>https://ekattor.tv/entertainment/bollywood/97801/%E0%A6%85%E0%A6%AE%E0%A6%BF%E0%A6%A4%E0%A6%BE%E0%A6%AD-%E0%A6%93-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%B7%E0%A7%87%E0%A6%95%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A7%9F-%E0%A7%A8%E0%A7%A6%E0%A7%A6-%E0%A6%95%E0%A6%BF%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%81%E0%A6%A4</link>
      <guid isPermaLink="true">https://ekattor.tv/entertainment/bollywood/97801/%E0%A6%85%E0%A6%AE%E0%A6%BF%E0%A6%A4%E0%A6%BE%E0%A6%AD-%E0%A6%93-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%B7%E0%A7%87%E0%A6%95%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A7%9F-%E0%A7%A8%E0%A7%A6%E0%A7%A6-%E0%A6%95%E0%A6%BF%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%81%E0%A6%A4</guid>
      <pubDate>Tue, 17 Nov 2026 09:30:00 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/d08fe662018583024b90ba198e72b4c2-6afb1435ace4f.jpg?jadewits_media_id=65117" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/d08fe662018583024b90ba198e72b4c2-6afb1435ace4f.jpg?jadewits_media_id=65117" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/d08fe662018583024b90ba198e72b4c2-6afb1435ace4f.jpg?jadewits_media_id=65117" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অমিতাভ ও অভিষেককে হত্যায় ২০০ কিলার প্রস্তুত!" /&gt;&lt;/p&gt;&lt;p&gt;বলিউডের ‘শাহেনশা’ অমিতাভ বচ্চন এবং তাঁর ছেলে অভিনেতা অভিষেক বচ্চনকে সরাসরি প্রাণনাশের হুমকি দিল কুখ্যাত গ্যাংস্টার গোল্ডি ডিলন! লরেন্স বিষ্ণোই গ্যাংয়ের দুই শুটারকে দিল্লি পুলিশ গ্রেপ্তার করার রেশ কাটতে না কাটতেই এল এই চাঞ্চল্যকর হুমকি। সোশ্যাল মিডিয়ায় ভাইরাল হওয়া এক পোস্টে গ্যাংস্টার সরাসরি বচ্চন পর&lt;/p&gt;</description>
      <source url="https://ekattor.tv/entertainment/bollywood/97801/%E0%A6%85%E0%A6%AE%E0%A6%BF%E0%A6%A4%E0%A6%BE%E0%A6%AD-%E0%A6%93-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%B7%E0%A7%87%E0%A6%95%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A7%9F-%E0%A7%A8%E0%A7%A6%E0%A7%A6-%E0%A6%95%E0%A6%BF%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%81%E0%A6%A4">একাত্তর</source>
    </item>

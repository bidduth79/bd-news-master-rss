    <item>
      <title>মেহেরপুরে ধাওয়া করে দুই যুবককে ধরলো পুলিশ</title>
      <link>https://ekattor.tv/country/jessore/97511/%E0%A6%AE%E0%A7%87%E0%A6%B9%E0%A7%87%E0%A6%B0%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%A7%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%95%E0%A6%95%E0%A7%87-%E0%A6%A7%E0%A6%B0%E0%A6%B2%E0%A7%8B-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6</link>
      <guid isPermaLink="true">https://ekattor.tv/country/jessore/97511/%E0%A6%AE%E0%A7%87%E0%A6%B9%E0%A7%87%E0%A6%B0%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%A7%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%95%E0%A6%95%E0%A7%87-%E0%A6%A7%E0%A6%B0%E0%A6%B2%E0%A7%8B-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6</guid>
      <pubDate>Thu, 12 Nov 2026 08:00:00 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/6fee35fb2d26cb08eb20e2781bea6d87-6af4b5d27111e.jpg?jadewits_media_id=64721" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/6fee35fb2d26cb08eb20e2781bea6d87-6af4b5d27111e.jpg?jadewits_media_id=64721" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/6fee35fb2d26cb08eb20e2781bea6d87-6af4b5d27111e.jpg?jadewits_media_id=64721" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মেহেরপুরে ধাওয়া করে দুই যুবককে ধরলো পুলিশ" /&gt;&lt;/p&gt;&lt;p&gt;মেহেরপুরে জুলাই শহীদ স্মৃতিস্তম্ভ লক্ষ্য করে পেট্রোল বোমা নিক্ষেপ ও আগুন দেয়ার চেষ্টার চাঞ্চল্যকর ঘটনায় দুজনকে হাতেনাতে গ্রেপ্তার করেছে পুলিশ। বুধবার রাত ৮টা ৫ মিনিটের দিকে মেহেরপুর সরকারি কলেজ মোড়ে অবস্থিত জুলাই শহীদ স্মৃতিস্তম্ভে এই নাশকতার ঘটনা ঘটে।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/country/jessore/97511/%E0%A6%AE%E0%A7%87%E0%A6%B9%E0%A7%87%E0%A6%B0%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%A7%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%95%E0%A6%95%E0%A7%87-%E0%A6%A7%E0%A6%B0%E0%A6%B2%E0%A7%8B-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6">একাত্তর</source>

    <item>
      <title>‘ইউক্রেন সঙ্কট সমাধানে তিন পরাশক্তির অভিন্ন স্বার্থ রয়েছে’</title>
      <link>https://ekattor.tv/international/asia/97983/%E2%80%98%E0%A6%87%E0%A6%89%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A8-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%9F-%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%AA%E0%A6%B0%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%A8</link>
      <guid isPermaLink="true">https://ekattor.tv/international/asia/97983/%E2%80%98%E0%A6%87%E0%A6%89%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A8-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%9F-%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%AA%E0%A6%B0%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%A8</guid>
      <pubDate>Thu, 19 Nov 2026 16:21:31 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/088bb381c1b5be8c04a207a2aa60fa91-6afecd9bf2d08.jpg?jadewits_media_id=65370" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/088bb381c1b5be8c04a207a2aa60fa91-6afecd9bf2d08.jpg?jadewits_media_id=65370" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/088bb381c1b5be8c04a207a2aa60fa91-6afecd9bf2d08.jpg?jadewits_media_id=65370" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘ইউক্রেন সঙ্কট সমাধানে তিন পরাশক্তির অভিন্ন স্বার্থ রয়েছে’" /&gt;&lt;/p&gt;&lt;p&gt;চীনের দক্ষিণাঞ্চলীয় শহর শেনজেনের একটি ভিলায় বিশাল গোলটেবিল বৈঠকে মুখোমুখি হয়েছেন বিশ্বের শীর্ষ তিন পারমাণবিক শক্তিধর দেশের নেতা মার্কিন প্রেসিডেন্ট ডোনাল্ড ট্রাম্প, চীনের প্রেসিডেন্ট শি জিনপিং এবং রাশিয়ার প্রেসিডেন্ট ভ্লাদিমির পুতিন। ইতিহাসে প্রথমবারের মতো আয়োজিত এই ত্রিপক্ষীয় বৈঠকের সূচনা বক্তব্য&lt;/p&gt;</description>
      <source url="https://ekattor.tv/international/asia/97983/%E2%80%98%E0%A6%87%E0%A6%89%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A8-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%9F-%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%AA%E0%A6%B0%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%A8">একাত্তর</source>
    </item>

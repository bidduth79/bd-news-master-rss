      <title>২০২৫ সালের যুদ্ধের পর প্রথমবার ভারত সফরে পাকিস্তানের মন্ত্রী</title>
      <link>https://ekattor.tv/international/98060/%E0%A7%A8%E0%A7%A6%E0%A7%A8%E0%A7%AB-%E0%A6%B8%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4-%E0%A6%B8%E0%A6%AB%E0%A6%B0%E0%A7%87</link>
      <guid isPermaLink="true">https://ekattor.tv/international/98060/%E0%A7%A8%E0%A7%A6%E0%A7%A8%E0%A7%AB-%E0%A6%B8%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4-%E0%A6%B8%E0%A6%AB%E0%A6%B0%E0%A7%87</guid>
      <pubDate>Fri, 20 Nov 2026 19:48:58 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/a8731919e8b79db0a7427e9c83591309-6b004f6ea6ff2.jpg?jadewits_media_id=65480" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/a8731919e8b79db0a7427e9c83591309-6b004f6ea6ff2.jpg?jadewits_media_id=65480" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/a8731919e8b79db0a7427e9c83591309-6b004f6ea6ff2.jpg?jadewits_media_id=65480" style="max-width:100%;height:auto;margin-bottom:10px;" alt="২০২৫ সালের যুদ্ধের পর প্রথমবার ভারত সফরে পাকিস্তানের মন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;২০২৫ সালের মে মাসে ভারত ও পাকিস্তানের মধ্যে চার দিনের যুদ্ধের পর প্রথমবারের মতো ভারত সফরে গেছেন পাকিস্তানের কেন্দ্রীয় সরকারের কোনো মন্ত্রী। দেশটির জলবায়ু পরিবর্তনবিষয়ক মন্ত্রী মুসাদিক মালিক শুক্রবার নয়াদিল্লিতে পৌঁছেছেন। সাংহাই সহযোগিতা সংস্থার (এসসিও) প্রথম সভ্যতা সংলাপ ফোরামে অংশ নিতে তার এই সফর।	&lt;/p&gt;</description>
      <source url="https://ekattor.tv/international/98060/%E0%A7%A8%E0%A7%A6%E0%A7%A8%E0%A7%AB-%E0%A6%B8%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4-%E0%A6%B8%E0%A6%AB%E0%A6%B0%E0%A7%87">একাত্তর</source>
    </item>
    <item>
      <title>পদত্যাগ করেছেন মার্কিন সাইবার পরিচালক</title>
      <link>https://ekattor.tv/international/98059/%E0%A6%AA%E0%A6%A6%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%97-%E0%A6%95%E0%A6%B0%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8-%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%95</link>
      <guid isPermaLink="true">https://ekattor.tv/international/98059/%E0%A6%AA%E0%A6%A6%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%97-%E0%A6%95%E0%A6%B0%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8-%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%95</guid>
      <pubDate>Fri, 20 Nov 2026 19:34:28 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/e33af334772e19de718c34661a774860-6b004aaf699fa.jpg?jadewits_media_id=65476" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/e33af334772e19de718c34661a774860-6b004aaf699fa.jpg?jadewits_media_id=65476" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/e33af334772e19de718c34661a774860-6b004aaf699fa.jpg?jadewits_media_id=65476" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পদত্যাগ করেছেন মার্কিন সাইবার পরিচালক" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাষ্ট্রে বিমান চলাচল, ব্যাংকিং খাত, বড় প্রযুক্তি সেবা ও জাতীয় নিরাপত্তাসংশ্লিষ্ট বিভিন্ন ব্যবস্থায় টানা কারিগরি বিপর্যয়ের মধ্যে পদ ছেড়েছেন দেশটির জাতীয় সাইবার পরিচালক শন কেয়ার্নক্রস। বৃহস্পতিবার (১৯ নভেম্বর) মার্কিন সংবাদমাধ্যম সিবিএস নিউজ এ তথ্য জানিয়েছে। তার স্থলাভিষিক্ত হয়েছেন মার্কিন প্রতির&lt;/p&gt;</description>
      <source url="https://ekattor.tv/international/98059/%E0%A6%AA%E0%A6%A6%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%97-%E0%A6%95%E0%A6%B0%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8-%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%95">একাত্তর</source>
    </item>
    <item>
      <title>গুগল ম্যাপসে যেভাবে জানবেন নিজের এলাকার বাতাসের মান</title>

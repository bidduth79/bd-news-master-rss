      <title>আফগানদের বিপক্ষে এক উইকেটের নাটকীয় জয়ে সেমিতে বাংলাদেশ</title>
      <link>https://ekattor.tv/sports/cricket/98144/%E0%A6%86%E0%A6%AB%E0%A6%97%E0%A6%BE%E0%A6%A8%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87-%E0%A6%8F%E0%A6%95-%E0%A6%89%E0%A6%87%E0%A6%95%E0%A7%87%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%9F%E0%A6%95%E0%A7%80%E0%A7%9F-%E0%A6%9C%E0%A7%9F%E0%A7%87-%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A6%BF%E0%A6%A4%E0%A7%87</link>
      <guid isPermaLink="true">https://ekattor.tv/sports/cricket/98144/%E0%A6%86%E0%A6%AB%E0%A6%97%E0%A6%BE%E0%A6%A8%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87-%E0%A6%8F%E0%A6%95-%E0%A6%89%E0%A6%87%E0%A6%95%E0%A7%87%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%9F%E0%A6%95%E0%A7%80%E0%A7%9F-%E0%A6%9C%E0%A7%9F%E0%A7%87-%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A6%BF%E0%A6%A4%E0%A7%87</guid>
      <pubDate>Sun, 22 Nov 2026 02:29:20 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/dbc7a76eea53428905c3f26a280eb389-6b01fc8724527.jpg?jadewits_media_id=65584" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/dbc7a76eea53428905c3f26a280eb389-6b01fc8724527.jpg?jadewits_media_id=65584" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/dbc7a76eea53428905c3f26a280eb389-6b01fc8724527.jpg?jadewits_media_id=65584" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আফগানদের বিপক্ষে এক উইকেটের নাটকীয় জয়ে সেমিতে বাংলাদেশ" /&gt;&lt;/p&gt;&lt;p&gt;এশিয়া কাপ রাইজিং স্টার্সে আফগানিস্তান ‘এ’ দলকে এক উইকেটে হারিয়ে সেমিফাইনাল নিশ্চিত করেছে বাংলাদেশ ‘এ’ দল। নিজেদের দ্বিতীয় ম্যাচে রুদ্ধশ্বাস লড়াইয়ের শেষ মুহূর্তে পরপর চার ও ছক্কা হাঁকিয়ে দলের জয় এনে দেন একাদশ ব্যাটার ইকবাল হোসেন ইমন। 						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/sports/cricket/98144/%E0%A6%86%E0%A6%AB%E0%A6%97%E0%A6%BE%E0%A6%A8%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%AA%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87-%E0%A6%8F%E0%A6%95-%E0%A6%89%E0%A6%87%E0%A6%95%E0%A7%87%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%9F%E0%A6%95%E0%A7%80%E0%A7%9F-%E0%A6%9C%E0%A7%9F%E0%A7%87-%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A6%BF%E0%A6%A4%E0%A7%87">একাত্তর</source>
    </item>

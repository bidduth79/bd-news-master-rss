      <guid isPermaLink="true">https://ekattor.tv/international/america/98137/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8-%E0%A6%87%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%A4%E0%A7%87-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A7%81%E0%A6%B0-%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%A8%E0%A6%BE-%E0%A6%AD%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%B8</guid>
      <pubDate>Sat, 21 Nov 2026 22:35:48 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/3cffd90ef7d24a849a6c62a8fde68d3f-6b01c85d25f49.jpg?jadewits_media_id=65574" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/3cffd90ef7d24a849a6c62a8fde68d3f-6b01c85d25f49.jpg?jadewits_media_id=65574" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/3cffd90ef7d24a849a6c62a8fde68d3f-6b01c85d25f49.jpg?jadewits_media_id=65574" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইরান ইস্যুতে ট্রাম্পের সুরে সুর মেলালেন না ভ্যান্স" /&gt;&lt;/p&gt;&lt;p&gt;ইরানকে পারমাণবিক অস্ত্র তৈরি থেকে বিরত রাখতে তিনি দেশটিতে হামলার অনুমোদন দিতেন কি না—এমন প্রশ্নের সরাসরি উত্তর দিতে অস্বীকৃতি জানিয়েছেন মার্কিন ভাইস প্রেসিডেন্ট জে ডি ভ্যান্স। রয়টার্স ও এএফপির প্রতিবেদনে বলা হয়েছে, শুক্রবার (২০ নভেম্বর) হোয়াইট হাউসে প্রেসিডেন্ট ডোনাল্ড ট্রাম্পের পাশে দাঁড়িয়ে আয়োজিত &lt;/p&gt;</description>

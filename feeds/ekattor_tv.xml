    <item>
      <title>আইসিজের রায়ে বাংলাদেশের অবস্থান আরও জোরদার: পররাষ্ট্র মন্ত্রণালয়</title>
      <link>https://ekattor.tv/national/98006/%E0%A6%86%E0%A6%87%E0%A6%B8%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A6%9C%E0%A7%8B%E0%A6%B0%E0%A6%A6%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://ekattor.tv/national/98006/%E0%A6%86%E0%A6%87%E0%A6%B8%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A6%9C%E0%A7%8B%E0%A6%B0%E0%A6%A6%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Thu, 19 Nov 2026 19:59:07 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/cd49bce223f739e2d74606a7108f946a-6aff0063aeda7.jpg?jadewits_media_id=65410" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/cd49bce223f739e2d74606a7108f946a-6aff0063aeda7.jpg?jadewits_media_id=65410" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/cd49bce223f739e2d74606a7108f946a-6aff0063aeda7.jpg?jadewits_media_id=65410" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আইসিজের রায়ে বাংলাদেশের অবস্থান আরও জোরদার: পররাষ্ট্র মন্ত্রণালয়" /&gt;&lt;/p&gt;&lt;p&gt;রোহিঙ্গা গণহত্যার দায়ে মিয়ানমারকে দোষী সাব্যস্ত করে আন্তর্জাতিক বিচার আদালতের (আইসিজে) রায় বাংলাদেশের অবস্থানকে আরও জোরদার করেছে বলে জানিয়েছে পররাষ্ট্র মন্ত্রণালয়। রায়টিকে স্বাগত জানিয়ে রোহিঙ্গাদের দ্রুত, নিরাপদ ও মর্যাদাপূর্ণ প্রত্যাবাসনে মিয়ানমার সরকার ও আরাকান আর্মির ওপর আন্তর্জাতিক চাপ বাড়ানোর আ&lt;/p&gt;</description>
      <source url="https://ekattor.tv/national/98006/%E0%A6%86%E0%A6%87%E0%A6%B8%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A6%9C%E0%A7%8B%E0%A6%B0%E0%A6%A6%E0%A6%BE%E0%A6%B0">একাত্তর</source>
    </item>
    <item>
      <title>মিয়ানমারের ওপর চাপ বাড়ানোর সুযোগ দেখছেন দুই প্রতিমন্ত্রী</title>

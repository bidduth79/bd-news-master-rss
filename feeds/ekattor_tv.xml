    <item>
      <title>কড়া নিয়মে বদলে যাচ্ছে ব্রিটেনের অভিবাসন চিত্র</title>
      <link>https://ekattor.tv/international/98544/%E0%A6%95%E0%A7%9C%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%AE%E0%A7%87-%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%AC%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%9F%E0%A7%87%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%A8-%E0%A6%9A%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%B0</link>
      <guid isPermaLink="true">https://ekattor.tv/international/98544/%E0%A6%95%E0%A7%9C%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%AE%E0%A7%87-%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%AC%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%9F%E0%A7%87%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%A8-%E0%A6%9A%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%B0</guid>
      <pubDate>Fri, 27 Nov 2026 09:30:00 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/a1b732469c6d8edb2d9de51bbcfdd07b-6b083f805828f.jpg?jadewits_media_id=66110" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/a1b732469c6d8edb2d9de51bbcfdd07b-6b083f805828f.jpg?jadewits_media_id=66110" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/a1b732469c6d8edb2d9de51bbcfdd07b-6b083f805828f.jpg?jadewits_media_id=66110" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কড়া নিয়মে বদলে যাচ্ছে ব্রিটেনের অভিবাসন চিত্র" /&gt;&lt;/p&gt;&lt;p&gt;ব্রিটেনের অভিবাসন নীতি ও রাজনীতির সমীকরণে বড়সড় মোড় এনে দিয়েছে নতুন সরকারি পরিসংখ্যান। কোভিড-১৯ মহামারির সময় বাদ দিলে গত প্রায় তিন দশকের মধ্যে সর্বনিম্ন বার্ষিক নিট অভিবাসনের রেকর্ড গড়েছে দেশটি। গত জুনের শেষ পর্যন্ত এক বছরে নিট অভিবাসন আগের বছরের ২ লাখ ৪ হাজার থেকে কমে দাঁড়িয়েছে ৭৭ হাজারে, যা মহামারি&lt;/p&gt;</description>
      <source url="https://ekattor.tv/international/98544/%E0%A6%95%E0%A7%9C%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%AE%E0%A7%87-%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%AC%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%9F%E0%A7%87%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%A8-%E0%A6%9A%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%B0">একাত্তর</source>
    </item>
    <item>
      <title>পাকিস্তানি সিরিয়াল নিয়ে ভারতে কেন এতো তোলপাড়?</title>

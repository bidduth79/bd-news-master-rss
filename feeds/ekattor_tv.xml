      <guid isPermaLink="true">https://ekattor.tv/national/97988/%E0%A6%95%E0%A7%8B%E0%A6%A8-%E0%A6%A7%E0%A6%BE%E0%A6%AA%E0%A7%87-%E0%A6%95%E0%A6%A4%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%89%E0%A6%AA%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE-%E0%A6%93-%E0%A6%87%E0%A6%89%E0%A6%AA%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%9A%E0%A6%A8-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%BE</guid>

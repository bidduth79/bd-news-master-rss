    <item>
      <title>২০৩০ পর্যন্ত আর্জেন্টিনার কোচ স্কালোনি, হাতছানি দুটি রেকর্ডের</title>
      <link>https://ekattor.tv/sports/football/97584/%E0%A7%A8%E0%A7%A6%E0%A7%A9%E0%A7%A6-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%86%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A7%8B%E0%A6%9A-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A6%B2%E0%A7%8B%E0%A6%A8%E0%A6%BF-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A6%9B%E0%A6%BE%E0%A6%A8%E0%A6%BF</link>
      <guid isPermaLink="true">https://ekattor.tv/sports/football/97584/%E0%A7%A8%E0%A7%A6%E0%A7%A9%E0%A7%A6-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%86%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A7%8B%E0%A6%9A-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A6%B2%E0%A7%8B%E0%A6%A8%E0%A6%BF-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A6%9B%E0%A6%BE%E0%A6%A8%E0%A6%BF</guid>
      <pubDate>Fri, 13 Nov 2026 11:48:21 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/fc59aac8c8474609fb6ad7d7138ff4ae-6af6a419e9f02.jpg?jadewits_media_id=64826" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/fc59aac8c8474609fb6ad7d7138ff4ae-6af6a419e9f02.jpg?jadewits_media_id=64826" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/fc59aac8c8474609fb6ad7d7138ff4ae-6af6a419e9f02.jpg?jadewits_media_id=64826" style="max-width:100%;height:auto;margin-bottom:10px;" alt="২০৩০ পর্যন্ত আর্জেন্টিনার কোচ স্কালোনি, হাতছানি দুটি রেকর্ডের" /&gt;&lt;/p&gt;&lt;p&gt;আর্জেন্টিনা জাতীয় ফুটবল দলের প্রধান কোচ হিসেবে ২০৩০ বিশ্বকাপ পর্যন্ত দায়িত্ব পালন করবেন লিওনেল স্কালোনি। নতুন চুক্তিতে সম্মত হয়েছেন ৪৮ বছর বয়সী এই কোচ। এর মধ্য দিয়ে প্রথম কোচ হিসেবে আর্জেন্টিনাকে টানা তিনটি বিশ্বকাপে নেতৃত্ব দেওয়ার সুযোগ পাচ্ছেন তিনি।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/sports/football/97584/%E0%A7%A8%E0%A7%A6%E0%A7%A9%E0%A7%A6-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%86%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A7%8B%E0%A6%9A-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A6%B2%E0%A7%8B%E0%A6%A8%E0%A6%BF-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A6%9B%E0%A6%BE%E0%A6%A8%E0%A6%BF">একাত্তর</source>
    </item>
    <item>
      <title>আজ বৃষ্টি হবে কি না, জানাল আবহাওয়া অধিদপ্তর</title>

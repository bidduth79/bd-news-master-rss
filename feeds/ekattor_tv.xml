    <item>
      <title>মালিবাগ-মৌচাকে পরপর ককটেল বিস্ফোরণ, জনমনে আতঙ্ক</title>
      <link>https://ekattor.tv/capital/97398/%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%97-%E0%A6%AE%E0%A7%8C%E0%A6%9A%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%B0%E0%A6%AA%E0%A6%B0-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%9C%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%A4%E0%A6%99%E0%A7%8D%E0%A6%95</link>
      <guid isPermaLink="true">https://ekattor.tv/capital/97398/%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%97-%E0%A6%AE%E0%A7%8C%E0%A6%9A%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%B0%E0%A6%AA%E0%A6%B0-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%9C%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%A4%E0%A6%99%E0%A7%8D%E0%A6%95</guid>
      <pubDate>Mon, 09 Nov 2026 21:38:46 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/09/1119684552965d523087c1e6f393361f-6af1e8e68515f.jpg?jadewits_media_id=64567" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/09/1119684552965d523087c1e6f393361f-6af1e8e68515f.jpg?jadewits_media_id=64567" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/09/1119684552965d523087c1e6f393361f-6af1e8e68515f.jpg?jadewits_media_id=64567" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মালিবাগ-মৌচাকে পরপর ককটেল বিস্ফোরণ, জনমনে আতঙ্ক" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানী ঢাকাজুড়ে গত কয়েক দিন ধরে চলা ধারাবাহিক নাশকতার অংশ হিসেবে এবার মালিবাগ ও মৌচাক এলাকায় পরপর একাধিক ককটেল বিস্ফোরণের ঘটনা ঘটেছে। সোমবার রাত সাড়ে আটটার দিকে অল্প সময়ের ব্যবধানে সংঘটিত এসব বিস্ফোরণে পুরো এলাকায় তীব্র আতঙ্ক ছড়িয়ে পড়ে।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/capital/97398/%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%97-%E0%A6%AE%E0%A7%8C%E0%A6%9A%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%B0%E0%A6%AA%E0%A6%B0-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%9C%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%A4%E0%A6%99%E0%A7%8D%E0%A6%95">একাত্তর</source>
    </item>
    <item>
      <title>বাবার কাছে শেষ আকুতির পর দিনই মিললো ছাত্রীর মরদেহ</title>
      <link>https://ekattor.tv/capital/97397/%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%9B%E0%A7%87-%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%86%E0%A6%95%E0%A7%81%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A6%87-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2%E0%A7%8B-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%AE%E0%A6%B0%E0%A6%A6%E0%A7%87%E0%A6%B9</link>
      <guid isPermaLink="true">https://ekattor.tv/capital/97397/%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%9B%E0%A7%87-%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%86%E0%A6%95%E0%A7%81%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A6%87-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2%E0%A7%8B-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%AE%E0%A6%B0%E0%A6%A6%E0%A7%87%E0%A6%B9</guid>
      <pubDate>Mon, 09 Nov 2026 21:28:11 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/09/c00316d72043cbd7ef2c31734a3d54db-6af1e6670a655.jpg?jadewits_media_id=64566" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/09/c00316d72043cbd7ef2c31734a3d54db-6af1e6670a655.jpg?jadewits_media_id=64566" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/09/c00316d72043cbd7ef2c31734a3d54db-6af1e6670a655.jpg?jadewits_media_id=64566" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাবার কাছে শেষ আকুতির পর দিনই মিললো ছাত্রীর মরদেহ" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর উত্তরখানে একটি আবাসিক ভবনের নবম তলার ফ্ল্যাট থেকে সানজিদা আক্তার ইমা (২২) নামের এক তরুণীর মরদেহ উদ্ধার করেছে পুলিশ। রোববার রাত পৌনে ১১টার দিকে গলায় ওড়না প্যাঁচানো অবস্থায় তাঁর লাশ উদ্ধার করা হয়। এ ঘটনায় নিহত তরুণীর বাবার দায়ের করা হত্যা মামলায় তাঁর স্বামী আমিনুর রহমানকে গ্রেপ্তার করে&lt;/p&gt;</description>
      <source url="https://ekattor.tv/capital/97397/%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%9B%E0%A7%87-%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%86%E0%A6%95%E0%A7%81%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A6%87-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%B2%E0%A7%8B-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%AE%E0%A6%B0%E0%A6%A6%E0%A7%87%E0%A6%B9">একাত্তর</source>
    </item>
    <item>
      <title>জুবাইদা রহমান-সোফির বৈঠক: নারীর ক্ষমতায়ন ও রোহিঙ্গা প্রত্যাবাসন নিয়ে আলোচনা</title>
      <link>https://ekattor.tv/national/97396/%E0%A6%9C%E0%A7%81%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%A6%E0%A6%BE-%E0%A6%B0%E0%A6%B9%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%B8%E0%A7%8B%E0%A6%AB%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%AE%E0%A6%A4%E0%A6%BE%E0%A7%9F%E0%A6%A8-%E0%A6%93</link>
      <guid isPermaLink="true">https://ekattor.tv/national/97396/%E0%A6%9C%E0%A7%81%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%A6%E0%A6%BE-%E0%A6%B0%E0%A6%B9%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%B8%E0%A7%8B%E0%A6%AB%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%AE%E0%A6%A4%E0%A6%BE%E0%A7%9F%E0%A6%A8-%E0%A6%93</guid>
      <pubDate>Mon, 09 Nov 2026 21:20:36 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/09/6576727140a599833186080ccb7931c6-6af1e4ba780ba.jpg?jadewits_media_id=64565" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/09/6576727140a599833186080ccb7931c6-6af1e4ba780ba.jpg?jadewits_media_id=64565" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/09/6576727140a599833186080ccb7931c6-6af1e4ba780ba.jpg?jadewits_media_id=64565" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জুবাইদা রহমান-সোফির বৈঠক: নারীর ক্ষমতায়ন ও রোহিঙ্গা প্রত্যাবাসন নিয়ে আলোচনা" /&gt;&lt;/p&gt;&lt;p&gt;প্রধানমন্ত্রীর সহধর্মিণী ডা. জুবাইদা রহমান এবং ব্রিটেনের ডাচেস অভ এডিনবরা সোফির মধ্যে বৈঠক অনুষ্ঠিত হয়েছে। বৈঠকে নারীর ক্ষমতায়ন, মাতৃ ও শিশু স্বাস্থ্যসেবা, শিক্ষা এবং রোহিঙ্গা সংকটসহ ঝুঁকিপূর্ণ জনগোষ্ঠী সুরক্ষায় পারস্পরিক সহযোগিতা জোরদার করার বিষয়ে আলোচনা হয়েছে। 						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/national/97396/%E0%A6%9C%E0%A7%81%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%A6%E0%A6%BE-%E0%A6%B0%E0%A6%B9%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%B8%E0%A7%8B%E0%A6%AB%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%AE%E0%A6%A4%E0%A6%BE%E0%A7%9F%E0%A6%A8-%E0%A6%93">একাত্তর</source>
    </item>
    <item>
      <title>জাতীয় নারীশক্তিতে যোগ দিলেন পাইলট ফারিয়াল</title>
      <link>https://ekattor.tv/politics/97395/%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A6%AF%E0%A6%BC-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AA%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A6%9F-%E0%A6%AB%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%B2</link>
      <guid isPermaLink="true">https://ekattor.tv/politics/97395/%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A6%AF%E0%A6%BC-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AA%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A6%9F-%E0%A6%AB%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%B2</guid>
      <pubDate>Mon, 09 Nov 2026 21:17:11 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/09/e8c06ffe77cd69f5f1c8f997588754d1-6af1e3c6d7367.jpg?jadewits_media_id=64564" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/09/e8c06ffe77cd69f5f1c8f997588754d1-6af1e3c6d7367.jpg?jadewits_media_id=64564" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/09/e8c06ffe77cd69f5f1c8f997588754d1-6af1e3c6d7367.jpg?jadewits_media_id=64564" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জাতীয় নারীশক্তিতে যোগ দিলেন পাইলট ফারিয়াল" /&gt;&lt;/p&gt;&lt;p&gt;জাতীয় নাগরিক পার্টির (এনসিপি) অঙ্গসংগঠন ‘জাতীয় নারীশক্তি’র ঢাকা মহানগর দক্ষিণে নতুন নেতৃত্বের মাধ্যমে রাজনীতিতে যুক্ত হয়েছেন বাণিজ্যিক সিভিল পাইলট ইথার ফারিয়াল হামিদ। নবগঠিত কমিটির সদস্যসচিব হিসেবে দায়িত্ব পেয়েছেন তিনি।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/politics/97395/%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A6%AF%E0%A6%BC-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AA%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A6%9F-%E0%A6%AB%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%B2">একাত্তর</source>
    </item>
    <item>
      <title>সুযোগের অভাবে কোনো শিশু-কিশোর যেন পিছিয়ে না পড়ে: ডা. জুবাইদা রহমান</title>

      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/07/08/c66bca21f69cfb33c274310eed6849dc-6a4e658ec6657.jpg?jadewits_media_id=57278" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/07/08/c66bca21f69cfb33c274310eed6849dc-6a4e658ec6657.jpg?jadewits_media_id=57278" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/07/08/c66bca21f69cfb33c274310eed6849dc-6a4e658ec6657.jpg?jadewits_media_id=57278" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হামের উপসর্গে আরও সাতজনের মৃত্যু, মোট ১৩৩৬" /&gt;&lt;/p&gt;&lt;p&gt;দেশে গত ২৪ ঘণ্টায় হামের উপসর্গ নিয়ে আরও সাতজনের মৃত্যু হয়েছে। এ নিয়ে চলতি বছর নিশ্চিত হামে ১০৫ জন এবং হামের উপসর্গ নিয়ে এক হাজার ২৩১ জনের মৃত্যু হয়েছে। সব মিলিয়ে হামে ও এর উপসর্গ নিয়ে মৃত্যুর সংখ্যা দাঁড়িয়েছে এক হাজার ৩৩৬ জনে।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/health/97977/%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%89%E0%A6%AA%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A6%B8%E0%A6%BE%E0%A6%A4-%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81-%E0%A6%AE%E0%A7%8B%E0%A6%9F-%E0%A7%A7%E0%A7%A9%E0%A7%A9%E0%A7%AC%C2%A0">একাত্তর</source>

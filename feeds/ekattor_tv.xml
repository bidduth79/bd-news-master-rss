    <item>
      <title>২০২৫ সালে সশস্ত্র বাহিনীর অনুষ্ঠান ছিল আমার মায়ের জীবনের শেষ অনুষ্ঠান: প্রধানমন্ত্রী</title>
      <link>https://ekattor.tv/national/98141/%E0%A7%A8%E0%A7%A6%E0%A7%A8%E0%A7%AB-%E0%A6%B8%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%B8%E0%A6%B6%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A8-%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%86%E0%A6%AE%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://ekattor.tv/national/98141/%E0%A7%A8%E0%A7%A6%E0%A7%A8%E0%A7%AB-%E0%A6%B8%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%B8%E0%A6%B6%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A8-%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%86%E0%A6%AE%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Sun, 22 Nov 2026 00:43:10 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/5aa14d5434a9df17d2043f1de74cb1ef-6b01e6321664e.jpg?jadewits_media_id=65580" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/5aa14d5434a9df17d2043f1de74cb1ef-6b01e6321664e.jpg?jadewits_media_id=65580" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/5aa14d5434a9df17d2043f1de74cb1ef-6b01e6321664e.jpg?jadewits_media_id=65580" style="max-width:100%;height:auto;margin-bottom:10px;" alt="২০২৫ সালে সশস্ত্র বাহিনীর অনুষ্ঠান ছিল আমার মায়ের জীবনের শেষ অনুষ্ঠান: প্রধানমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;প্রয়াত মা ও সাবেক প্রধানমন্ত্রী বেগম খালেদা জিয়ার স্মৃতিচারণ করতে গিয়ে আবেগাপ্লুত হয়ে পড়েছেন প্রধানমন্ত্রী তারেক রহমান। মায়ের সঙ্গে সশস্ত্র বাহিনী দিবসের স্মৃতিবিজড়িত মুহূর্তের কথা উল্লেখ করে প্রধানমন্ত্রী জানান, ২০২৫ সালের সশস্ত্র বাহিনী দিবসের অনুষ্ঠানটিই ছিল তাঁর মায়ের জীবনের শেষ অনুষ্ঠান।						ব&lt;/p&gt;</description>
      <source url="https://ekattor.tv/national/98141/%E0%A7%A8%E0%A7%A6%E0%A7%A8%E0%A7%AB-%E0%A6%B8%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%B8%E0%A6%B6%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A7%8D%E0%A6%A0%E0%A6%BE%E0%A6%A8-%E0%A6%9B%E0%A6%BF%E0%A6%B2-%E0%A6%86%E0%A6%AE%E0%A6%BE%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B0">একাত্তর</source>
    </item>
    <item>
      <title>শিক্ষা খাতে ধারাবাহিকভাবে বাজেট বাড়বে: পরিকল্পনা প্রতিমন্ত্রী</title>
      <link>https://ekattor.tv/country/chittagong/98140/%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%96%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%95%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A7%87%E0%A6%9F-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%AC%E0%A7%87-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A6%A8%E0%A6%BE</link>
      <guid isPermaLink="true">https://ekattor.tv/country/chittagong/98140/%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%96%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%95%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A7%87%E0%A6%9F-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%AC%E0%A7%87-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A6%A8%E0%A6%BE</guid>
      <pubDate>Sun, 22 Nov 2026 00:38:03 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/90e986e92b930cb033bcead8926da971-6b01e4cc195ee.jpg?jadewits_media_id=65577" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/90e986e92b930cb033bcead8926da971-6b01e4cc195ee.jpg?jadewits_media_id=65577" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/90e986e92b930cb033bcead8926da971-6b01e4cc195ee.jpg?jadewits_media_id=65577" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শিক্ষা খাতে ধারাবাহিকভাবে বাজেট বাড়বে: পরিকল্পনা প্রতিমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;ব্রাহ্মণবাড়িয়ার বাঞ্ছারামপুর উপজেলার মাধ্যমিক পর্যায়ের শিক্ষকদের সঙ্গে মতবিনিময় সভা করেছেন স্থানীয় সংসদ সদস্য ও পরিকল্পনা মন্ত্রণালয়ের প্রতিমন্ত্রী জুনায়েদ সাকী। শনিবার সকাল ১০টায় বাঞ্ছারামপুরের মাওলাগঞ্জ অডিটোরিয়ামে এই মতবিনিময় সভা অনুষ্ঠিত হয়। উপজেলার সব মাধ্যমিক বিদ্যালয়ের প্রধান শিক্ষক ও সহকারী &lt;/p&gt;</description>
      <source url="https://ekattor.tv/country/chittagong/98140/%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%96%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%95%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A7%87%E0%A6%9F-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%AC%E0%A7%87-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A6%A8%E0%A6%BE">একাত্তর</source>

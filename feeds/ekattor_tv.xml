      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/849cc896b550e9bfcc0ad9cf9eacc772-6af708821f5d1.jpg?jadewits_media_id=64867" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/849cc896b550e9bfcc0ad9cf9eacc772-6af708821f5d1.jpg?jadewits_media_id=64867" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/849cc896b550e9bfcc0ad9cf9eacc772-6af708821f5d1.jpg?jadewits_media_id=64867" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ব্রাহ্মণবাড়িয়ায় ছাত্রদলের দুই পক্ষের সংঘর্ষ, এমপি ও বিএনপির কার্যালয় ভাঙচুর" /&gt;&lt;/p&gt;&lt;p&gt;ব্রাহ্মণবাড়িয়ার কমিটি গঠন নিয়ে বিরোধের জেরে ছাত্রদলের দুই পক্ষের মধ্যে সংঘর্ষের ঘটনা ঘটেছে। এতে অন্তত ১৫ জন আহত হয়েছেন। এ সময় আখাউড়া উপজেলা বিএনপির দলীয় কার্যালয়, যা স্থানীয় সংসদ সদস্য মুশফিকুর রহমানের রাজনৈতিক কার্যালয় হিসেবেও ব্যবহৃত হয়, সেটিসহ বেশ কয়েকটি দোকানপাট ভাঙচুর করা হয়েছে।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/country/chittagong/97609/%E0%A6%AC%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B9%E0%A7%8D%E0%A6%AE%E0%A6%A3%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%AA%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%B0%E0%A7%8D%E0%A6%B7-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF">একাত্তর</source>

    <item>
      <title>প্রথমবারের মতো বুধের দোরগোড়ায় ‘জোড়া অতিথি’</title>
      <link>https://ekattor.tv/technology/research/98130/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%A4%E0%A7%8B-%E0%A6%AC%E0%A7%81%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%8B%E0%A6%B0%E0%A6%97%E0%A7%8B%E0%A7%9C%E0%A6%BE%E0%A7%9F-%E2%80%98%E0%A6%9C%E0%A7%8B%E0%A7%9C%E0%A6%BE-%E0%A6%85%E0%A6%A4%E0%A6%BF%E0%A6%A5%E0%A6%BF%E2%80%99</link>
      <guid isPermaLink="true">https://ekattor.tv/technology/research/98130/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%A4%E0%A7%8B-%E0%A6%AC%E0%A7%81%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%8B%E0%A6%B0%E0%A6%97%E0%A7%8B%E0%A7%9C%E0%A6%BE%E0%A7%9F-%E2%80%98%E0%A6%9C%E0%A7%8B%E0%A7%9C%E0%A6%BE-%E0%A6%85%E0%A6%A4%E0%A6%BF%E0%A6%A5%E0%A6%BF%E2%80%99</guid>
      <pubDate>Sat, 21 Nov 2026 19:38:27 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/82b6540b8a924d8c55bd544dee421b29-6b019de046e11.jpg?jadewits_media_id=65568" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/82b6540b8a924d8c55bd544dee421b29-6b019de046e11.jpg?jadewits_media_id=65568" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/82b6540b8a924d8c55bd544dee421b29-6b019de046e11.jpg?jadewits_media_id=65568" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রথমবারের মতো বুধের দোরগোড়ায় ‘জোড়া অতিথি’" /&gt;&lt;/p&gt;&lt;p&gt;প্রায় আট বছরের দীর্ঘ মহাকাশ যাত্রা শেষে আজ শনিবার (২১ নভেম্বর) সূর্যের সবচেয়ে কাছের গ্রহ বুধের কক্ষপথে প্রবেশ করছে ‘বেপিকলম্বো’। ইউরোপীয় স্পেস এজেন্সি (ইএসএ) ও জাপানের মহাকাশ সংস্থার (জাক্সা) যৌথ উদ্যোগে পরিচালিত এই অভিযানে ইতিহাসে প্রথমবারের মতো দুটি মহাকাশযান একসঙ্গে বুধকে প্রদক্ষিণ করবে।						বি&lt;/p&gt;</description>
      <source url="https://ekattor.tv/technology/research/98130/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%A4%E0%A7%8B-%E0%A6%AC%E0%A7%81%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%8B%E0%A6%B0%E0%A6%97%E0%A7%8B%E0%A7%9C%E0%A6%BE%E0%A7%9F-%E2%80%98%E0%A6%9C%E0%A7%8B%E0%A7%9C%E0%A6%BE-%E0%A6%85%E0%A6%A4%E0%A6%BF%E0%A6%A5%E0%A6%BF%E2%80%99">একাত্তর</source>
    </item>

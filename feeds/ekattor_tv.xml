      <guid isPermaLink="true">https://ekattor.tv/national/98443/%E0%A7%A8%E0%A7%AF-%E0%A6%A8%E0%A6%AD%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A6%BF%E0%A6%A4-%E0%A6%A6%E0%A6%B2%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A7%8B%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%AA%E0%A7%87-%E0%A6%AC%E0%A6%B8%E0%A6%9B%E0%A7%87</guid>
      <pubDate>Wed, 25 Nov 2026 17:33:18 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/4d8855bc85beb6f894bfe4c55cc30563-6b06c77669364.jpg?jadewits_media_id=65963" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/4d8855bc85beb6f894bfe4c55cc30563-6b06c77669364.jpg?jadewits_media_id=65963" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/4d8855bc85beb6f894bfe4c55cc30563-6b06c77669364.jpg?jadewits_media_id=65963" style="max-width:100%;height:auto;margin-bottom:10px;" alt="২৯ নভেম্বর থেকে নিবন্ধিত দলগুলোর সঙ্গে সংলাপে বসছে ইসি" /&gt;&lt;/p&gt;&lt;p&gt;স্থানীয় সরকার নির্বাচন সামনে রেখে আগামী ২৯ নভেম্বর থেকে নিবন্ধিত রাজনৈতিক দলগুলোর সঙ্গে সংলাপ শুরু করতে যাচ্ছে নির্বাচন কমিশন (ইসি)। এ সংলাপে আমন্ত্রণ পাচ্ছে নিবন্ধিত ৫৫টি রাজনৈতিক দল। এদিকে শূন্য হওয়া কিশোরগঞ্জ-৩ আসনের উপনির্বাচনের তফসিল ঘোষণা করেছে কমিশন। আগামী ১০ ডিসেম্বর সকাল ৮টা থেকে বিকেল ৪টা &lt;/p&gt;</description>
      <source url="https://ekattor.tv/national/98443/%E0%A7%A8%E0%A7%AF-%E0%A6%A8%E0%A6%AD%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A6%BF%E0%A6%A4-%E0%A6%A6%E0%A6%B2%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A7%8B%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%AA%E0%A7%87-%E0%A6%AC%E0%A6%B8%E0%A6%9B%E0%A7%87">একাত্তর</source>

      <guid isPermaLink="true">https://ekattor.tv/country/rajshahi/97920/%E0%A6%AC%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%9C%E0%A7%9F-%E0%A6%B8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%A4%E0%A6%B0%E0%A7%81%E0%A6%A3%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A7%8B%E0%A6%AC%E0%A7%8B%E0%A6%9F%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A7%87</guid>
      <pubDate>Wed, 18 Nov 2026 18:08:06 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/8dd460d5a0e172ef8727b3ffcbd9931b-6afd94e6e3093.jpg?jadewits_media_id=65279" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/8dd460d5a0e172ef8727b3ffcbd9931b-6afd94e6e3093.jpg?jadewits_media_id=65279" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/8dd460d5a0e172ef8727b3ffcbd9931b-6afd94e6e3093.jpg?jadewits_media_id=65279" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বালিতে বিশ্বজয় সিরাজগঞ্জের তরুণদের, রোবোটিক্সে বিশ্বসেরা" /&gt;&lt;/p&gt;&lt;p&gt;তাঁত, যমুনা নদী আর সহজ-সরল মানুষের জনপদ হিসেবে পরিচিত সিরাজগঞ্জ এবার প্রযুক্তি ও উদ্ভাবনের আলোয় বিশ্বজয়ের ইতিহাস গড়লো। ইন্দোনেশিয়ার বালিতে অনুষ্ঠিত মর্যাদাপূর্ণ ‘Bali International Engineering Science Fair 2026 (BIESF)’ প্রতিযোগিতায় বিশ্বমঞ্চে লাল-সবুজের পতাকা উড়িয়ে দিয়েছেন সিরাজগঞ্জের খাজা ইউনুস &lt;/p&gt;</description>
      <source url="https://ekattor.tv/country/rajshahi/97920/%E0%A6%AC%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%9C%E0%A7%9F-%E0%A6%B8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%A4%E0%A6%B0%E0%A7%81%E0%A6%A3%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A7%8B%E0%A6%AC%E0%A7%8B%E0%A6%9F%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A7%87">একাত্তর</source>
    </item>
    <item>
      <title>ইসরাইলের নতুন স্পিকার বিরোধী শিবিরের মাতান কাহানা</title>
      <link>https://ekattor.tv/international/middle-east/97919/%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%80-%E0%A6%B6%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%A8-%E0%A6%95%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%A8%E0%A6%BE</link>
      <guid isPermaLink="true">https://ekattor.tv/international/middle-east/97919/%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%80-%E0%A6%B6%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%A8-%E0%A6%95%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%A8%E0%A6%BE</guid>
      <pubDate>Wed, 18 Nov 2026 17:32:42 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/a7ee75bbbbf59827b2048710c2bf60d9-6afd8cbdd5bc0.jpg?jadewits_media_id=65277" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/a7ee75bbbbf59827b2048710c2bf60d9-6afd8cbdd5bc0.jpg?jadewits_media_id=65277" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/a7ee75bbbbf59827b2048710c2bf60d9-6afd8cbdd5bc0.jpg?jadewits_media_id=65277" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইসরাইলের নতুন স্পিকার বিরোধী শিবিরের মাতান কাহানা" /&gt;&lt;/p&gt;&lt;p&gt;ইসরাইলের রাজনীতিতে বড় ধরনের মোড় পরিবর্তন ঘটেছে। দেশটির সংসদ নেসেটে বিরোধী দলগুলোর ভোটে নতুন স্পিকার হিসেবে নির্বাচিত হয়েছেন মাতান কাহানা। তিনি প্রধানমন্ত্রী বেনিয়ামিন নেতানিয়াহুর মূল প্রতিদ্বন্দ্বী গাডি আইসেনকোটের নেতৃত্বাধীন ‘যোশার’ পার্টির একজন আইনপ্রণেতা। এতে নেতানিয়াহুর দীর্ঘদিনের রাজনৈতিক এজ&lt;/p&gt;</description>
      <source url="https://ekattor.tv/international/middle-east/97919/%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%80-%E0%A6%B6%E0%A6%BF%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%A8-%E0%A6%95%E0%A6%BE%E0%A6%B9%E0%A6%BE%E0%A6%A8%E0%A6%BE">একাত্তর</source>

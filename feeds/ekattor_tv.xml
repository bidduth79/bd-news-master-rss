      <guid isPermaLink="true">https://ekattor.tv/national/98560/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%BE%E0%A6%AA-%E0%A6%95%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A7%87%E0%A6%95%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%B8%E0%A6%BF%E0%A6%9F%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A6%A8%E0%A6%BE</guid>
      <pubDate>Fri, 27 Nov 2026 11:38:28 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/08/12/aea879facd42d87c97928dc685aa7f50-6a7c9ece0bfda.jpg?jadewits_media_id=59125" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/08/12/aea879facd42d87c97928dc685aa7f50-6a7c9ece0bfda.jpg?jadewits_media_id=59125" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/08/12/aea879facd42d87c97928dc685aa7f50-6a7c9ece0bfda.jpg?jadewits_media_id=59125" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঢাকার আবাসনের চাপ কমাতে সেকেন্ডারি সিটির পরিকল্পনা সরকারের" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীতে জনসংখ্যা ও আবাসনের চাপ কমাতে কেরানীগঞ্জে তিন হাজার একর জমিতে সেকেন্ডারি সিটি গড়ে তোলার পরিকল্পনা গ্রহণ করেছে সরকার। রাজধানীর পাশে নাগরিক সুবিধাসম্পন্ন পরিকল্পিত জনবসতি গড়ে তোলাই সেকেন্ডারি সিটির মূল লক্ষ্য। এর মাধ্যমে ঢাকার মূল নগর এলাকার বাইরে বসবাসের বিকল্প সুযোগ তৈরি হবে।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/national/98560/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%BE%E0%A6%AA-%E0%A6%95%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A7%87%E0%A6%95%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%B8%E0%A6%BF%E0%A6%9F%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A6%A8%E0%A6%BE">একাত্তর</source>

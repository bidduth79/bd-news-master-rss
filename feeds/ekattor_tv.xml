      <guid isPermaLink="true">https://ekattor.tv/sports/football/97663/%E0%A6%AA%E0%A7%8B%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%87-%E0%A6%B2%E0%A6%BE%E0%A6%97%E0%A6%B2-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A6%9F-%E0%A6%97%E0%A7%8B%E0%A6%B2%E0%A6%B6%E0%A7%82%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A7%E0%A7%87</guid>
      <pubDate>Sat, 14 Nov 2026 21:38:28 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/ee02b2b5a2b02bb7c190089d9d096620-6af8805c885a3.jpg?jadewits_media_id=64934" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/ee02b2b5a2b02bb7c190089d9d096620-6af8805c885a3.jpg?jadewits_media_id=64934" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/ee02b2b5a2b02bb7c190089d9d096620-6af8805c885a3.jpg?jadewits_media_id=64934" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পোস্টে লাগল দুই দলের শট, গোলশূন্য প্রথমার্ধে বাংলাদেশ-পাকিস্তান" /&gt;&lt;/p&gt;&lt;p&gt;সাফ চ্যাম্পিয়নশিপের সেমিফাইনালে পাকিস্তানের বিপক্ষে গোলশূন্য সমতায় থেকে প্রথমার্ধ শেষ করেছে বাংলাদেশ। দুই দলই কয়েকটি ভালো আক্রমণ করেছে। তবে কোনো দলই গোলের দেখা পায়নি। দুই দলের দুটি জোরালো শট পোস্টে লেগে ফিরে এসেছে।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/sports/football/97663/%E0%A6%AA%E0%A7%8B%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%87-%E0%A6%B2%E0%A6%BE%E0%A6%97%E0%A6%B2-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A6%9F-%E0%A6%97%E0%A7%8B%E0%A6%B2%E0%A6%B6%E0%A7%82%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A7%E0%A7%87">একাত্তর</source>
    </item>
    <item>

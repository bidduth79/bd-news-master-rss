    </item>
    <item>
      <title>ভাবমূর্তির অজুহাতে বাঁচিয়ে রাখা হচ্ছে ইতালির জনতা এক্সচেঞ্জ</title>
      <link>https://ekattor.tv/business/98189/%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A6%AE%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%85%E0%A6%9C%E0%A7%81%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%81%E0%A6%9A%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%96%E0%A6%BE-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%87%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A6%A4%E0%A6%BE</link>
      <guid isPermaLink="true">https://ekattor.tv/business/98189/%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A6%AE%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%85%E0%A6%9C%E0%A7%81%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%81%E0%A6%9A%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%96%E0%A6%BE-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%87%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A6%A4%E0%A6%BE</guid>
      <pubDate>Sun, 22 Nov 2026 16:35:05 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/24929af076c371c089d1dd07b0e0f3aa-6b02c40a170b6.jpg?jadewits_media_id=65640" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/24929af076c371c089d1dd07b0e0f3aa-6b02c40a170b6.jpg?jadewits_media_id=65640" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/24929af076c371c089d1dd07b0e0f3aa-6b02c40a170b6.jpg?jadewits_media_id=65640" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভাবমূর্তির অজুহাতে বাঁচিয়ে রাখা হচ্ছে ইতালির জনতা এক্সচেঞ্জ" /&gt;&lt;/p&gt;&lt;p&gt;পরিচালনার অনিয়মসহ দেড়যুগ ধরে প্রায় সোয়া দুইশ কোটি টাকা লোকসানে জনতা ব্যাংকের সহযোগী প্রতিষ্ঠান জনতা এক্সচেঞ্জের ইতালি শাখা। প্রয়োজন না থাকায় নিয়ন্ত্রক সংস্থা বন্ধ করে দেয়ার সুপারিশ করলেও ইমেজ বা ভাবমূর্তি খোয়া যাওয়ার ভয়ে, সেটি ভর্তুকি দিয়ে বাঁচিয়ে রাখার পাঁয়তারা করছে অর্থ মন্ত্রণালয়।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/business/98189/%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A6%AE%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%85%E0%A6%9C%E0%A7%81%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%81%E0%A6%9A%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%96%E0%A6%BE-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%87%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A6%A4%E0%A6%BE">একাত্তর</source>
    </item>

    <item>
      <title>গাড়ি শিল্প ছেড়ে ড্রোন ও সমরাস্ত্র তৈরিতে ঝুঁকছে জাপান</title>
      <link>https://ekattor.tv/international/98364/%E0%A6%97%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%B6%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%AA-%E0%A6%9B%E0%A7%87%E0%A7%9C%E0%A7%87-%E0%A6%A1%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%A8-%E0%A6%93-%E0%A6%B8%E0%A6%AE%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%A4%E0%A7%88%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%9D%E0%A7%81%E0%A6%81%E0%A6%95%E0%A6%9B%E0%A7%87</link>
      <guid isPermaLink="true">https://ekattor.tv/international/98364/%E0%A6%97%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%B6%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%AA-%E0%A6%9B%E0%A7%87%E0%A7%9C%E0%A7%87-%E0%A6%A1%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%A8-%E0%A6%93-%E0%A6%B8%E0%A6%AE%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%A4%E0%A7%88%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%9D%E0%A7%81%E0%A6%81%E0%A6%95%E0%A6%9B%E0%A7%87</guid>
      <pubDate>Wed, 25 Nov 2026 08:00:00 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/f0942ed9fb1e9e645c3638146ae1194a-6b058a571231e.jpg?jadewits_media_id=65856" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/f0942ed9fb1e9e645c3638146ae1194a-6b058a571231e.jpg?jadewits_media_id=65856" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/f0942ed9fb1e9e645c3638146ae1194a-6b058a571231e.jpg?jadewits_media_id=65856" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গাড়ি শিল্প ছেড়ে ড্রোন ও সমরাস্ত্র তৈরিতে ঝুঁকছে জাপান" /&gt;&lt;/p&gt;&lt;p&gt;বছরের পর বছর টয়োটার গাড়ির যন্ত্রাংশ সরবরাহ করে ব্যবসা চালিয়ে এসেছে জাপানের নির্মাতা প্রতিষ্ঠান ‘অ্যাস্টার’। কিন্তু চীনের তীব্র প্রতিযোগিতায় দেশের গাড়ি শিল্প চাপের মুখে পড়ায় প্রতিরক্ষা প্রযুক্তিতে নতুন সম্ভাবনা খুঁজে নিয়েছে প্রতিষ্ঠানটি। বর্তমানে অ্যাস্টারের তৈরি ইলেকট্রিক মোটর যুক্তরাষ্ট্রের সামরিক &lt;/p&gt;</description>
      <source url="https://ekattor.tv/international/98364/%E0%A6%97%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%B6%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%AA-%E0%A6%9B%E0%A7%87%E0%A7%9C%E0%A7%87-%E0%A6%A1%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%A8-%E0%A6%93-%E0%A6%B8%E0%A6%AE%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%A4%E0%A7%88%E0%A6%B0%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%9D%E0%A7%81%E0%A6%81%E0%A6%95%E0%A6%9B%E0%A7%87">একাত্তর</source>
    </item>
    <item>
      <title>শয়তান ও নরকের দর্শন পেয়েছিলেন পোপ ফ্রান্সিস!</title>
      <link>https://ekattor.tv/international/98356/%E0%A6%B6%E0%A7%9F%E0%A6%A4%E0%A6%BE%E0%A6%A8-%E0%A6%93-%E0%A6%A8%E0%A6%B0%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%B0%E0%A7%8D%E0%A6%B6%E0%A6%A8-%E0%A6%AA%E0%A7%87%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AA%E0%A7%8B%E0%A6%AA-%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%B8%E0%A6%BF%E0%A6%B8</link>
      <guid isPermaLink="true">https://ekattor.tv/international/98356/%E0%A6%B6%E0%A7%9F%E0%A6%A4%E0%A6%BE%E0%A6%A8-%E0%A6%93-%E0%A6%A8%E0%A6%B0%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%B0%E0%A7%8D%E0%A6%B6%E0%A6%A8-%E0%A6%AA%E0%A7%87%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AA%E0%A7%8B%E0%A6%AA-%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%B8%E0%A6%BF%E0%A6%B8</guid>
      <pubDate>Wed, 25 Nov 2026 07:30:00 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/de41798885bfa6fea76713bde7674939-6b057e335391d.jpg?jadewits_media_id=65842" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/de41798885bfa6fea76713bde7674939-6b057e335391d.jpg?jadewits_media_id=65842" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/de41798885bfa6fea76713bde7674939-6b057e335391d.jpg?jadewits_media_id=65842" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শয়তান ও নরকের দর্শন পেয়েছিলেন পোপ ফ্রান্সিস!" /&gt;&lt;/p&gt;&lt;p&gt;ভ্যাটিকানের উঁচু দেয়ালের আড়ালে ক্ষমতার ভারসাম্য আর সংস্কারের কঠিন লড়াই সামলাতে গিয়ে নিজের ভেতরেই যে কী প্রবল ঝড় বয়ে যেত, তা এবার প্রকাশ্যে এল প্রয়াত পোপ ফ্রান্সিসের ব্যক্তিগত ডায়েরিতে। মঙ্গলবার প্রকাশিত ‘দ্য প্রাইভেট ডায়েরি অব পোপ ফ্রান্সিস’ শীর্ষক সংকলন অনুযায়ী, ২০২১ সাল থেকে টানা দুই বছর গভীর এক আ&lt;/p&gt;</description>
      <source url="https://ekattor.tv/international/98356/%E0%A6%B6%E0%A7%9F%E0%A6%A4%E0%A6%BE%E0%A6%A8-%E0%A6%93-%E0%A6%A8%E0%A6%B0%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%B0%E0%A7%8D%E0%A6%B6%E0%A6%A8-%E0%A6%AA%E0%A7%87%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AA%E0%A7%8B%E0%A6%AA-%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%B8%E0%A6%BF%E0%A6%B8">একাত্তর</source>

    <item>
      <title>গাজায় ত্রাণ প্রবেশে বাধা না দিতে ও সীমান্ত খুলে দিতে ইসরায়েলকে ইইউর আহ্বান</title>
      <link>https://ekattor.tv/international/97664/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A7%9F-%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%A7%E0%A6%BE-%E0%A6%A8%E0%A6%BE-%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%93-%E0%A6%B8%E0%A7%80%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A7%87</link>
      <guid isPermaLink="true">https://ekattor.tv/international/97664/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A7%9F-%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%A7%E0%A6%BE-%E0%A6%A8%E0%A6%BE-%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%93-%E0%A6%B8%E0%A7%80%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A7%87</guid>
      <pubDate>Sat, 14 Nov 2026 22:05:55 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/bea03f8588ef2c6a312dafab8aec5ddd-6af886c383b05.jpg?jadewits_media_id=64935" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/bea03f8588ef2c6a312dafab8aec5ddd-6af886c383b05.jpg?jadewits_media_id=64935" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/bea03f8588ef2c6a312dafab8aec5ddd-6af886c383b05.jpg?jadewits_media_id=64935" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গাজায় ত্রাণ প্রবেশে বাধা না দিতে ও সীমান্ত খুলে দিতে ইসরায়েলকে ইইউর আহ্বান" /&gt;&lt;/p&gt;&lt;p&gt;গাজায় ভয়াবহ মানবিক সংকটের অবনতিতে গভীর উদ্বেগ প্রকাশ করেছে ইউরোপীয় ইউনিয়ন (ইইউ)। উপত্যকাটিতে জরুরি ভিত্তিতে নির্বিঘ্নে মানবিক সহায়তা প্রবেশ ও বিতরণ নিশ্চিত করা এবং সব সীমান্ত ক্রসিং খুলে দেওয়ার জন্য ইসরায়েলের প্রতি আহ্বান জানিয়েছে সংস্থাটি।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/international/97664/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A7%9F-%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%A7%E0%A6%BE-%E0%A6%A8%E0%A6%BE-%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%93-%E0%A6%B8%E0%A7%80%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%96%E0%A7%81%E0%A6%B2%E0%A7%87">একাত্তর</source>
    </item>
    <item>
      <title>পোস্টে লাগল দুই দলের শট, গোলশূন্য প্রথমার্ধে বাংলাদেশ-পাকিস্তান</title>

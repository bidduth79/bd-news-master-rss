    <item>
      <title>যশোরের সাবেক এমপি আজিজুল লালমাটিয়ায় গ্রেপ্তার</title>
      <link>https://ekattor.tv/capital/98293/%E0%A6%AF%E0%A6%B6%E0%A7%8B%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF-%E0%A6%86%E0%A6%9C%E0%A6%BF%E0%A6%9C%E0%A7%81%E0%A6%B2-%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A6%AE%E0%A6%BE%E0%A6%9F%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://ekattor.tv/capital/98293/%E0%A6%AF%E0%A6%B6%E0%A7%8B%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95-%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF-%E0%A6%86%E0%A6%9C%E0%A6%BF%E0%A6%9C%E0%A7%81%E0%A6%B2-%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A6%AE%E0%A6%BE%E0%A6%9F%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Mon, 23 Nov 2026 19:40:25 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/99fbbd64a16750791b0de2ce7595bc4c-6b04421fb7350.jpg?jadewits_media_id=65774" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/99fbbd64a16750791b0de2ce7595bc4c-6b04421fb7350.jpg?jadewits_media_id=65774" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/99fbbd64a16750791b0de2ce7595bc4c-6b04421fb7350.jpg?jadewits_media_id=65774" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যশোরের সাবেক এমপি আজিজুল লালমাটিয়ায় গ্রেপ্তার" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর মোহাম্মদপুরের লালমাটিয়া এলাকা থেকে যশোর-৬ আসনের সাবেক সংসদ সদস্য আজিজুল ইসলামকে গ্রেপ্তার করেছে ঢাকা মহানগর পুলিশের গোয়েন্দা শাখা (ডিবি)। সোমবার বিকেল সাড়ে ৪টার দিকে লালমাটিয়ার একটি বাসায় অভিযান চালিয়ে তাঁকে আটক করা হয়।						বিস্তারিত&lt;/p&gt;</description>

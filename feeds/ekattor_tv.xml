      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/1ca9b1b90c4ab3a7d6958703835d6390-6af3325e43905.jpg?jadewits_media_id=64610" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/1ca9b1b90c4ab3a7d6958703835d6390-6af3325e43905.jpg?jadewits_media_id=64610" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/1ca9b1b90c4ab3a7d6958703835d6390-6af3325e43905.jpg?jadewits_media_id=64610" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ককটেল ফুটিয়ে অরাজকতা সৃষ্টির সুযোগ নেই: স্বরাষ্ট্রমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;রাতের অন্ধকারে এক-দুটি বিচ্ছিন্ন ককটেল বিস্ফোরণ কিংবা জনশূন্য স্থানে প্রতীকী অরাজকতা সৃষ্টি করে দেশের সার্বিক আইনশৃঙ্খলা পরিস্থিতি অবনতিশীল বলার কোনো সুযোগ নেই বলে মন্তব্য করেছেন স্বরাষ্ট্রমন্ত্রী সালাহউদ্দিন আহমদ। তিনি দৃঢ়তার সঙ্গে জানান, দেশের আইনশৃঙ্খলা পরিস্থিতি শতভাগ নিয়ন্ত্রণে রয়েছে এবং যে কোন&lt;/p&gt;</description>
      <source url="https://ekattor.tv/national/97440/%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AB%E0%A7%81%E0%A6%9F%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%85%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%95%E0%A6%A4%E0%A6%BE-%E0%A6%B8%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A7%81%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%87">একাত্তর</source>
    </item>

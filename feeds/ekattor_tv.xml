    <item>
      <title>দক্ষিণ আফ্রিকা সিরিজের বাংলাদেশ ওয়ানডে দল ঘোষনা, বড় রদবদল</title>
      <link>https://ekattor.tv/sports/cricket/98305/%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%A3-%E0%A6%86%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE-%E0%A6%B8%E0%A6%BF%E0%A6%B0%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%A1%E0%A7%87-%E0%A6%A6%E0%A6%B2-%E0%A6%98%E0%A7%8B%E0%A6%B7%E0%A6%A8%E0%A6%BE</link>
      <guid isPermaLink="true">https://ekattor.tv/sports/cricket/98305/%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%A3-%E0%A6%86%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE-%E0%A6%B8%E0%A6%BF%E0%A6%B0%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%A1%E0%A7%87-%E0%A6%A6%E0%A6%B2-%E0%A6%98%E0%A7%8B%E0%A6%B7%E0%A6%A8%E0%A6%BE</guid>
      <pubDate>Tue, 24 Nov 2026 10:50:45 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/92a51230c7784baecc0a954b42adff27-6b051188917f1.jpg?jadewits_media_id=65790" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/92a51230c7784baecc0a954b42adff27-6b051188917f1.jpg?jadewits_media_id=65790" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/92a51230c7784baecc0a954b42adff27-6b051188917f1.jpg?jadewits_media_id=65790" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দক্ষিণ আফ্রিকা সিরিজের বাংলাদেশ ওয়ানডে দল ঘোষনা, বড় রদবদল" /&gt;&lt;/p&gt;&lt;p&gt;দক্ষিণ আফ্রিকার বিপক্ষে তিন ম্যাচের ওয়ানডে সিরিজের জন্য বাংলাদেশ ক্রিকেট বোর্ড (বিসিবি) ১৫ সদস্যের দল ঘোষণা করেছে। সোমবার (২৩ নভেম্বর) ঘোষিত দলে একাধিক পরিবর্তন এনেছেন নির্বাচকরা। দলে ফিরেছেন লিটন দাস, ইয়াসির আলী চৌধুরী, নাঈম শেখ, জাকের আলী অনিক ও সৈয়দ খালেদ আহমেদ।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/sports/cricket/98305/%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%A3-%E0%A6%86%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE-%E0%A6%B8%E0%A6%BF%E0%A6%B0%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%A1%E0%A7%87-%E0%A6%A6%E0%A6%B2-%E0%A6%98%E0%A7%8B%E0%A6%B7%E0%A6%A8%E0%A6%BE">একাত্তর</source>
    </item>

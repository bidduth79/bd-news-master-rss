    <item>
      <title>ইউক্রনকে পাল্টা জবাব দেয়ার কড়া হুঁশিয়ারি দিলেন পুতিন</title>
      <link>https://ekattor.tv/international/europe/98451/%E0%A6%87%E0%A6%89%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%9C%E0%A6%AC%E0%A6%BE%E0%A6%AC-%E0%A6%A6%E0%A7%87%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A7%9C%E0%A6%BE-%E0%A6%B9%E0%A7%81%E0%A6%81%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8</link>
      <guid isPermaLink="true">https://ekattor.tv/international/europe/98451/%E0%A6%87%E0%A6%89%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%9C%E0%A6%AC%E0%A6%BE%E0%A6%AC-%E0%A6%A6%E0%A7%87%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A7%9C%E0%A6%BE-%E0%A6%B9%E0%A7%81%E0%A6%81%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Wed, 25 Nov 2026 18:13:17 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/10/30/8575d2bb8cb0eb380db59ae363708e47-6ae427158e615.jpg?jadewits_media_id=63939" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/10/30/8575d2bb8cb0eb380db59ae363708e47-6ae427158e615.jpg?jadewits_media_id=63939" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/10/30/8575d2bb8cb0eb380db59ae363708e47-6ae427158e615.jpg?jadewits_media_id=63939" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইউক্রনকে পাল্টা জবাব দেয়ার কড়া হুঁশিয়ারি দিলেন পুতিন" /&gt;&lt;/p&gt;&lt;p&gt;মার্কিন প্রেসিডেন্ট ডোনাল্ড ট্রাম্পের অনুরোধ সত্ত্বেও ইউক্রেন রুশ তেল শোধনাগারগুলোতে হামলা চালিয়ে যাচ্ছে বলে অভিযোগ করেছেন রাশিয়ার প্রেসিডেন্ট ভ্লাদিমির পুতিন; পাশাপাশি এর জবাবে পাল্টা ব্যবস্থা নেয়ার হুঁশিয়ারি দিয়েছেন তিনি। কিয়েভ জানিয়েছে, মস্কো একই ধরনের হামলা বন্ধ করলেই কেবল তারা রুশ জ্বালানি স্থা&lt;/p&gt;</description>
      <source url="https://ekattor.tv/international/europe/98451/%E0%A6%87%E0%A6%89%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%9C%E0%A6%AC%E0%A6%BE%E0%A6%AC-%E0%A6%A6%E0%A7%87%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A7%9C%E0%A6%BE-%E0%A6%B9%E0%A7%81%E0%A6%81%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8">একাত্তর</source>
    </item>
    <item>
      <title>সেরা ১০ নবীন চিকিৎসককে সম্মাননা দিলো ইউনিভার্সেল মেডিক্যাল</title>
      <link>https://ekattor.tv/others/98450/%E0%A6%B8%E0%A7%87%E0%A6%B0%E0%A6%BE-%E0%A7%A7%E0%A7%A6-%E0%A6%A8%E0%A6%AC%E0%A7%80%E0%A6%A8-%E0%A6%9A%E0%A6%BF%E0%A6%95%E0%A6%BF%E0%A7%8E%E0%A6%B8%E0%A6%95%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%A8%E0%A6%BE-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%8B-%E0%A6%87%E0%A6%89%E0%A6%A8%E0%A6%BF%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B8%E0%A7%87%E0%A6%B2</link>
      <guid isPermaLink="true">https://ekattor.tv/others/98450/%E0%A6%B8%E0%A7%87%E0%A6%B0%E0%A6%BE-%E0%A7%A7%E0%A7%A6-%E0%A6%A8%E0%A6%AC%E0%A7%80%E0%A6%A8-%E0%A6%9A%E0%A6%BF%E0%A6%95%E0%A6%BF%E0%A7%8E%E0%A6%B8%E0%A6%95%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%A8%E0%A6%BE-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%8B-%E0%A6%87%E0%A6%89%E0%A6%A8%E0%A6%BF%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B8%E0%A7%87%E0%A6%B2</guid>
      <pubDate>Wed, 25 Nov 2026 18:09:32 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/12fdd2efcf8becd29363cb3ea41b8329-6b06cff559e54.jpg?jadewits_media_id=65969" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/12fdd2efcf8becd29363cb3ea41b8329-6b06cff559e54.jpg?jadewits_media_id=65969" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/12fdd2efcf8becd29363cb3ea41b8329-6b06cff559e54.jpg?jadewits_media_id=65969" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সেরা ১০ নবীন চিকিৎসককে সম্মাননা দিলো ইউনিভার্সেল মেডিক্যাল" /&gt;&lt;/p&gt;&lt;p&gt;ঢাকা বিশ্ববিদ্যালয়ের অধীনে অনুষ্ঠিত এমবিবিএস ফাইনাল প্রফেশনাল পরীক্ষা (মে ২০২৬)–এ সর্বোচ্চ নম্বর পাওয়া শীর্ষ ১০ জন নবীন চিকিৎসককে সম্মাননা দিয়েছে রাজধানীর ইউনিভার্সেল মেডিক্যাল কলেজ হাসপাতাল। দ্বিতীয়বারের মতো ‘টপ টেন জিনিয়াস ডক্টরস সম্মাননা ২০২৬’ শিরোনামে এ আয়োজন করা হয়।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/others/98450/%E0%A6%B8%E0%A7%87%E0%A6%B0%E0%A6%BE-%E0%A7%A7%E0%A7%A6-%E0%A6%A8%E0%A6%AC%E0%A7%80%E0%A6%A8-%E0%A6%9A%E0%A6%BF%E0%A6%95%E0%A6%BF%E0%A7%8E%E0%A6%B8%E0%A6%95%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%A8%E0%A6%BE-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%8B-%E0%A6%87%E0%A6%89%E0%A6%A8%E0%A6%BF%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B8%E0%A7%87%E0%A6%B2">একাত্তর</source>
    </item>
    <item>
      <title>টেস্ট র‌্যাংকিংয়ে ২৮ ধাপ এগোলেন হৃদয়, উন্নতি লিটনেরও</title>
      <link>https://ekattor.tv/sports/cricket/98449/%E0%A6%9F%E0%A7%87%E0%A6%B8%E0%A7%8D%E0%A6%9F-%E0%A6%B0%E2%80%8C%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A6%BF%E0%A6%82%E0%A7%9F%E0%A7%87-%E0%A7%A8%E0%A7%AE-%E0%A6%A7%E0%A6%BE%E0%A6%AA-%E0%A6%8F%E0%A6%97%E0%A7%8B%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%B9%E0%A7%83%E0%A6%A6%E0%A7%9F-%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A6%A4%E0%A6%BF</link>
      <guid isPermaLink="true">https://ekattor.tv/sports/cricket/98449/%E0%A6%9F%E0%A7%87%E0%A6%B8%E0%A7%8D%E0%A6%9F-%E0%A6%B0%E2%80%8C%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A6%BF%E0%A6%82%E0%A7%9F%E0%A7%87-%E0%A7%A8%E0%A7%AE-%E0%A6%A7%E0%A6%BE%E0%A6%AA-%E0%A6%8F%E0%A6%97%E0%A7%8B%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%B9%E0%A7%83%E0%A6%A6%E0%A7%9F-%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A6%A4%E0%A6%BF</guid>
      <pubDate>Wed, 25 Nov 2026 18:01:23 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/3a76fae3d0d5717bc4e4d9c6b94c5630-6b06ce0d92d2c.jpg?jadewits_media_id=65968" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/3a76fae3d0d5717bc4e4d9c6b94c5630-6b06ce0d92d2c.jpg?jadewits_media_id=65968" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/3a76fae3d0d5717bc4e4d9c6b94c5630-6b06ce0d92d2c.jpg?jadewits_media_id=65968" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টেস্ট র‌্যাংকিংয়ে ২৮ ধাপ এগোলেন হৃদয়, উন্নতি লিটনেরও" /&gt;&lt;/p&gt;&lt;p&gt;আইসিসির সর্বশেষ টেস্ট ব্যাটারদের র‌্যাংকিংয়ে বড় অগ্রগতি হয়েছে বাংলাদেশের দুই ব্যাটার তাওহীদ হৃদয় ও লিটন দাসের। দক্ষিণ আফ্রিকার বিপক্ষে প্রথম টেস্টে সেঞ্চুরি করে ২৮ ধাপ এগিয়েছেন হৃদয়। আর ১২০ রানের ইনিংস খেলে ৯ ধাপ উন্নতি হয়েছে লিটনের। সর্বশেষ র‌্যাংকিংয়ে হৃদয় ৩৩তম ও লিটন উঠে এসেছেন ২৪তম স্থানে।						&lt;/p&gt;</description>
      <source url="https://ekattor.tv/sports/cricket/98449/%E0%A6%9F%E0%A7%87%E0%A6%B8%E0%A7%8D%E0%A6%9F-%E0%A6%B0%E2%80%8C%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%82%E0%A6%95%E0%A6%BF%E0%A6%82%E0%A7%9F%E0%A7%87-%E0%A7%A8%E0%A7%AE-%E0%A6%A7%E0%A6%BE%E0%A6%AA-%E0%A6%8F%E0%A6%97%E0%A7%8B%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%B9%E0%A7%83%E0%A6%A6%E0%A7%9F-%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A6%A4%E0%A6%BF">একাত্তর</source>
    </item>
    <item>
      <title>ইসরাইলে সরকার গঠনে এক ধাপ এগুলেন আইজেনকোট</title>
      <link>https://ekattor.tv/international/middle-east/98448/%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%97%E0%A6%A0%E0%A6%A8%E0%A7%87-%E0%A6%8F%E0%A6%95-%E0%A6%A7%E0%A6%BE%E0%A6%AA-%E0%A6%8F%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%86%E0%A6%87%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A6%95%E0%A7%8B%E0%A6%9F</link>
      <guid isPermaLink="true">https://ekattor.tv/international/middle-east/98448/%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%97%E0%A6%A0%E0%A6%A8%E0%A7%87-%E0%A6%8F%E0%A6%95-%E0%A6%A7%E0%A6%BE%E0%A6%AA-%E0%A6%8F%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%86%E0%A6%87%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A6%95%E0%A7%8B%E0%A6%9F</guid>
      <pubDate>Wed, 25 Nov 2026 18:00:27 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/d35f941ba569f906d8e13a1c80ecb037-6b06cdd3703cb.jpg?jadewits_media_id=65967" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/d35f941ba569f906d8e13a1c80ecb037-6b06cdd3703cb.jpg?jadewits_media_id=65967" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/d35f941ba569f906d8e13a1c80ecb037-6b06cdd3703cb.jpg?jadewits_media_id=65967" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইসরাইলে সরকার গঠনে এক ধাপ এগুলেন আইজেনকোট" /&gt;&lt;/p&gt;&lt;p&gt;গত অক্টোবরের নির্বাচনের পর নতুন সরকার গঠনের লক্ষ্যে একটি ডানপন্থী দলের সঙ্গে জোট চুক্তিতে একমত হয়েছে ইসরায়েলি বিরোধী নেতা গাদি আইজেনকোটের দল। মধ্যপন্থী দল ‘ইয়াশার’ মঙ্গলবার জানায়, আভিগদর লিবারম্যানের নেতৃত্বাধীন ‘ইসরাইল আওয়ার হোম’ দলের সঙ্গে বৈঠকের পর একটি জোট চুক্তি স্বাক্ষরে তারা সম্মত হয়েছে; নির্&lt;/p&gt;</description>
      <source url="https://ekattor.tv/international/middle-east/98448/%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%97%E0%A6%A0%E0%A6%A8%E0%A7%87-%E0%A6%8F%E0%A6%95-%E0%A6%A7%E0%A6%BE%E0%A6%AA-%E0%A6%8F%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%86%E0%A6%87%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A6%95%E0%A7%8B%E0%A6%9F">একাত্তর</source>

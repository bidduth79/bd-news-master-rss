      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/00f146a30c91d6a247b780217c4a9faf-6b01b0c06dcc7.jpg?jadewits_media_id=65571" medium="image" />

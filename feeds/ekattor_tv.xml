    <item>
      <title>দেউলিয়া হয়ে দুই কোটি মানুষের ‘গোপন চ্যাট’ নিলামে তুলছে জনপ্রিয় এআই প্রতিষ্ঠান!</title>
      <link>https://ekattor.tv/technology/98626/%E0%A6%A6%E0%A7%87%E0%A6%89%E0%A6%B2%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE-%E0%A6%B9%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A7%87%E0%A6%B0-%E2%80%98%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%A8-%E0%A6%9A%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9F%E2%80%99-%E0%A6%A8%E0%A6%BF%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A7%87</link>
      <guid isPermaLink="true">https://ekattor.tv/technology/98626/%E0%A6%A6%E0%A7%87%E0%A6%89%E0%A6%B2%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE-%E0%A6%B9%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A7%87%E0%A6%B0-%E2%80%98%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%A8-%E0%A6%9A%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9F%E2%80%99-%E0%A6%A8%E0%A6%BF%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A7%87</guid>
      <pubDate>Sat, 28 Nov 2026 14:16:36 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/f30c8d3f239e01d6ba0bb9847efa8b82-6b0a8a51936fb.jpg?jadewits_media_id=66189" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/f30c8d3f239e01d6ba0bb9847efa8b82-6b0a8a51936fb.jpg?jadewits_media_id=66189" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/f30c8d3f239e01d6ba0bb9847efa8b82-6b0a8a51936fb.jpg?jadewits_media_id=66189" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দেউলিয়া হয়ে দুই কোটি মানুষের ‘গোপন চ্যাট’ নিলামে তুলছে জনপ্রিয় এআই প্রতিষ্ঠান!" /&gt;&lt;/p&gt;&lt;p&gt;কৃত্রিম বুদ্ধিমত্তা (এআই) চ্যাটবটের সঙ্গে একান্ত ব্যক্তিগত অনুভূতি ও গোপন কথা ভাগ করে নেওয়ার পরিণতি যে কতটা ভয়াবহ হতে পারে, তা সামনে এনেছে জনপ্রিয় স্টার্টআপ ক্যারেক্টার.এআই (Character.AI)। দেউলিয়া হওয়ার প্রক্রিয়ায় গিয়ে প্রতিষ্ঠানটি যুক্তরাষ্ট্রের দুই কোটি ১০ লাখের বেশি ব্যবহারকারীর ব্যক্তিগত কথোপকথন&lt;/p&gt;</description>

    <item>
      <title>জলবায়ু সম্মেলনে যোগ দিতে আন্তালিয়ায় প্রধানমন্ত্রী</title>
      <link>https://ekattor.tv/national/97441/%E0%A6%9C%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A7%81-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%A8%E0%A7%87-%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80</link>
      <guid isPermaLink="true">https://ekattor.tv/national/97441/%E0%A6%9C%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A7%81-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%A8%E0%A7%87-%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80</guid>
      <pubDate>Tue, 10 Nov 2026 21:14:45 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/bd40923e7cedc3b0ed4d0303d56a90b9-6af3346ee4e00.jpg?jadewits_media_id=64611" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/bd40923e7cedc3b0ed4d0303d56a90b9-6af3346ee4e00.jpg?jadewits_media_id=64611" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/bd40923e7cedc3b0ed4d0303d56a90b9-6af3346ee4e00.jpg?jadewits_media_id=64611" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জলবায়ু সম্মেলনে যোগ দিতে আন্তালিয়ায় প্রধানমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;জাতিসংঘের বার্ষিক জলবায়ু সম্মেলনে (কপ-৩১) যোগ দিতে তিন দিনের সরকারি সফরে তুরস্কের আন্তালিয়ায় পৌঁছেছেন প্রধানমন্ত্রী তারেক রহমান। সোমবার স্থানীয় সময় বিকেল ৪টা ৩ মিনিটে প্রধানমন্ত্রী, তাঁর সহধর্মিণী ডা. জুবাইদা রহমান এবং সফরসঙ্গীদের বহনকারী টার্কিশ এয়ারলাইন্সের একটি ফ্লাইট আন্তালিয়া বিমানবন্দরে অবতরণ&lt;/p&gt;</description>
      <source url="https://ekattor.tv/national/97441/%E0%A6%9C%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A7%81-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%A8%E0%A7%87-%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80">একাত্তর</source>
    </item>
    <item>
      <title>ককটেল ফুটিয়ে অরাজকতা সৃষ্টির সুযোগ নেই: স্বরাষ্ট্রমন্ত্রী</title>
      <link>https://ekattor.tv/national/97440/%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AB%E0%A7%81%E0%A6%9F%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%85%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%95%E0%A6%A4%E0%A6%BE-%E0%A6%B8%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A7%81%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%87</link>
      <guid isPermaLink="true">https://ekattor.tv/national/97440/%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AB%E0%A7%81%E0%A6%9F%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%85%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%95%E0%A6%A4%E0%A6%BE-%E0%A6%B8%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A7%81%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%A8%E0%A7%87%E0%A6%87</guid>

    <item>
      <title>ভারতকে হারিয়ে ফাইনালে শ্রীলঙ্কা</title>
      <link>https://ekattor.tv/sports/cricket/98561/%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AB%E0%A6%BE%E0%A6%87%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B2%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BE</link>
      <guid isPermaLink="true">https://ekattor.tv/sports/cricket/98561/%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AB%E0%A6%BE%E0%A6%87%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B2%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BE</guid>
      <pubDate>Fri, 27 Nov 2026 12:19:47 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/e28e901ded2e6ec35eb85e0eb4d6d582-6b09201b467e1.jpg?jadewits_media_id=66126" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/e28e901ded2e6ec35eb85e0eb4d6d582-6b09201b467e1.jpg?jadewits_media_id=66126" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/e28e901ded2e6ec35eb85e0eb4d6d582-6b09201b467e1.jpg?jadewits_media_id=66126" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভারতকে হারিয়ে ফাইনালে শ্রীলঙ্কা" /&gt;&lt;/p&gt;&lt;p&gt;রাইজিং স্টার্স এশিয়া কাপের প্রথম সেমিফাইনালে ভারত ‘এ’ দলকে ৮ উইকেটে হারিয়ে ফাইনালে জায়গা করে নিয়েছে শ্রীলঙ্কা ‘এ’ দল। বৃহস্পতিবার (২৬ নভেম্বর) দোহায় প্রথম ভারতের দেওয়া ৩১৮ রানের লক্ষ্য ৮.৩ ওভার হাতে রেখেই পেরিয়ে যায় লঙ্কানরা।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/sports/cricket/98561/%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AB%E0%A6%BE%E0%A6%87%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B2%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BE">একাত্তর</source>
    </item>

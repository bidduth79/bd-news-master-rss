    <item>
      <title>মন্দিরে ১২১ কেজি স্বর্ণদান, আলোচনায় ভারতীয় ব্যবসায়ী</title>
      <link>https://ekattor.tv/international/south-asia/98666/%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A7%A7%E0%A7%A8%E0%A7%A7-%E0%A6%95%E0%A7%87%E0%A6%9C%E0%A6%BF-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A6%A6%E0%A6%BE%E0%A6%A8-%E0%A6%86%E0%A6%B2%E0%A7%8B%E0%A6%9A%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%80%E0%A7%9F</link>
      <guid isPermaLink="true">https://ekattor.tv/international/south-asia/98666/%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A7%A7%E0%A7%A8%E0%A7%A7-%E0%A6%95%E0%A7%87%E0%A6%9C%E0%A6%BF-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A6%A6%E0%A6%BE%E0%A6%A8-%E0%A6%86%E0%A6%B2%E0%A7%8B%E0%A6%9A%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%80%E0%A7%9F</guid>
      <pubDate>Sat, 28 Nov 2026 23:10:59 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/9dbbe2fb127f9eb0818d74ea27950bfc-6b0b0af313499.jpg?jadewits_media_id=66244" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/9dbbe2fb127f9eb0818d74ea27950bfc-6b0b0af313499.jpg?jadewits_media_id=66244" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/9dbbe2fb127f9eb0818d74ea27950bfc-6b0b0af313499.jpg?jadewits_media_id=66244" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মন্দিরে ১২১ কেজি স্বর্ণদান, আলোচনায় ভারতীয় ব্যবসায়ী" /&gt;&lt;/p&gt;&lt;p&gt;ভারতের অন্ধ্রপ্রদেশের তিরুমালা মন্দিরে ভগবান ভেঙ্কটেশ্বরের চরণে প্রায় ২০৬ কোটি টাকা মূল্যের ১২১ কেজি স্বর্ণালংকার দান করে রীতিমতো হইচই ফেলে দিয়েছেন চেন্নাইয়ের উদ্যোক্তা ও সমাজসেবী বর্ধমান জৈন। স্ত্রী রাধিকা জৈনকে সঙ্গে নিয়ে গেলো বৃহস্পতিবার মুখ্যমন্ত্রী এন চন্দ্রবাবু নাইডুর উপস্থিতিতে এই গয়নাগুলো অর&lt;/p&gt;</description>
      <source url="https://ekattor.tv/international/south-asia/98666/%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A7%A7%E0%A7%A8%E0%A7%A7-%E0%A6%95%E0%A7%87%E0%A6%9C%E0%A6%BF-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A6%A6%E0%A6%BE%E0%A6%A8-%E0%A6%86%E0%A6%B2%E0%A7%8B%E0%A6%9A%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%80%E0%A7%9F">একাত্তর</source>
    </item>
    <item>
      <title>মালয়েশিয়ার প্রধানমন্ত্রী আনোয়ার ইব্রাহিমের ঢাকা সফর স্থগিত</title>
      <link>https://ekattor.tv/national/98664/%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%86%E0%A6%A8%E0%A7%8B%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%87%E0%A6%AC%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE</link>
      <guid isPermaLink="true">https://ekattor.tv/national/98664/%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%86%E0%A6%A8%E0%A7%8B%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%87%E0%A6%AC%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE</guid>
      <pubDate>Sat, 28 Nov 2026 22:48:49 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/73189335fe2d13183534bc4fedf809a3-6b0b05ea5a8bf.jpg?jadewits_media_id=66242" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/73189335fe2d13183534bc4fedf809a3-6b0b05ea5a8bf.jpg?jadewits_media_id=66242" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/73189335fe2d13183534bc4fedf809a3-6b0b05ea5a8bf.jpg?jadewits_media_id=66242" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মালয়েশিয়ার প্রধানমন্ত্রী আনোয়ার ইব্রাহিমের ঢাকা সফর স্থগিত" /&gt;&lt;/p&gt;&lt;p&gt;মালয়েশিয়ার প্রধানমন্ত্রী আনোয়ার ইব্রাহিমের নির্ধারিত ঢাকা সফর স্থগিত করা হয়েছে। আগামী সাত ডিসেম্বর দুই দিনের সরকারি সফরে তার ঢাকায় আসার কথা ছিলো। তবে মালয়েশিয়ার অভ্যন্তরীণ রাজনৈতিক পরিস্থিতির কারণে দেশটির সরকার তার ঢাকা ও ব্যাংকক সফর পেছানোর সিদ্ধান্ত নিয়েছে।						বিস্তারিত&lt;/p&gt;</description>

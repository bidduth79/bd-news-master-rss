    <item>
      <title>মার্কিন নিষেধাজ্ঞা ইরানকে কতটা গভীরভাবে আঘাত হানছে?</title>
      <link>https://ekattor.tv/international/middle-east/98458/%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A7%87%E0%A6%A7%E0%A6%BE%E0%A6%9C%E0%A7%8D%E0%A6%9E%E0%A6%BE-%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A6%A4%E0%A6%9F%E0%A6%BE-%E0%A6%97%E0%A6%AD%E0%A7%80%E0%A6%B0%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%86%E0%A6%98%E0%A6%BE%E0%A6%A4</link>
      <guid isPermaLink="true">https://ekattor.tv/international/middle-east/98458/%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A7%87%E0%A6%A7%E0%A6%BE%E0%A6%9C%E0%A7%8D%E0%A6%9E%E0%A6%BE-%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A6%A4%E0%A6%9F%E0%A6%BE-%E0%A6%97%E0%A6%AD%E0%A7%80%E0%A6%B0%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%86%E0%A6%98%E0%A6%BE%E0%A6%A4</guid>
      <pubDate>Thu, 26 Nov 2026 08:00:00 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/67f4ea5d3b9883a104dabc76bd776a4d-6b06db29e0291.jpg?jadewits_media_id=65980" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/67f4ea5d3b9883a104dabc76bd776a4d-6b06db29e0291.jpg?jadewits_media_id=65980" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/67f4ea5d3b9883a104dabc76bd776a4d-6b06db29e0291.jpg?jadewits_media_id=65980" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মার্কিন নিষেধাজ্ঞা ইরানকে কতটা গভীরভাবে আঘাত হানছে?" /&gt;&lt;/p&gt;&lt;p&gt;বিশ্বের বৃহত্তম প্রাকৃতিক গ্যাসক্ষেত্রের একটি অংশের নিয়ন্ত্রণ রয়েছে তেহরানের হাতে, আর প্রমাণিত তেলের মজুদের দিক থেকে দেশটির অবস্থান বিশ্বে তৃতীয়। তবু রোববার থেকে কর্তৃপক্ষ প্রতিদিন প্রায় দুই ঘণ্টা করে পালাক্রমে লোডশেডিং চালু করায় এখন লাখ লাখ ইরানিকে বিদ্যুৎ রেশনিং করতে হচ্ছে।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/international/middle-east/98458/%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A7%87%E0%A6%A7%E0%A6%BE%E0%A6%9C%E0%A7%8D%E0%A6%9E%E0%A6%BE-%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A6%A4%E0%A6%9F%E0%A6%BE-%E0%A6%97%E0%A6%AD%E0%A7%80%E0%A6%B0%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%86%E0%A6%98%E0%A6%BE%E0%A6%A4">একাত্তর</source>

    <item>
      <title>নন্দীগ্রামে বিএনপি কার্যালয়ে আগুন লাগেনি দাবি এমপির, দূরে ময়লা পোড়ানোর ভিডিও ভাইরাল</title>
      <link>https://ekattor.tv/country/rajshahi/98472/%E0%A6%A8%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%80%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%B2%E0%A6%BE%E0%A6%97%E0%A7%87%E0%A6%A8%E0%A6%BF-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF</link>
      <guid isPermaLink="true">https://ekattor.tv/country/rajshahi/98472/%E0%A6%A8%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%80%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%B2%E0%A6%BE%E0%A6%97%E0%A7%87%E0%A6%A8%E0%A6%BF-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF</guid>
      <pubDate>Wed, 25 Nov 2026 22:39:13 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/d4fbd70197e89727875bb848093f958b-6b070e61325ec.jpg?jadewits_media_id=66012" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/d4fbd70197e89727875bb848093f958b-6b070e61325ec.jpg?jadewits_media_id=66012" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/25/d4fbd70197e89727875bb848093f958b-6b070e61325ec.jpg?jadewits_media_id=66012" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নন্দীগ্রামে বিএনপি কার্যালয়ে আগুন লাগেনি দাবি এমপির, দূরে ময়লা পোড়ানোর ভিডিও ভাইরাল" /&gt;&lt;/p&gt;&lt;p&gt;বগুড়ার নন্দীগ্রামে উপজেলা বিএনপির দলীয় কার্যালয়ে আগুন দেওয়ার একটি খবর সামাজিক যোগাযোগমাধ্যমে ছড়িয়ে পড়েছে। তবে দলীয় কার্যালয়ে কোনো আগুন লাগেনি বলে দাবি করেছেন উপজেলা বিএনপির নেতা–কর্মী ও স্থানীয় সংসদ সদস্য মোশারফ হোসেন।						বিস্তারিত&lt;/p&gt;</description>

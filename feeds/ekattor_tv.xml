      <guid isPermaLink="true">https://ekattor.tv/national/97852/%E0%A6%AD%E0%A6%AC%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%AF%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%8F%E0%A6%96%E0%A6%A8-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87%E0%A6%87-%E0%A6%A8%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%A6%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Tue, 17 Nov 2026 18:02:27 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/fdf160ba55f2b6b78ff0883b73b77b6e-6afc421a83102.jpg?jadewits_media_id=65179" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/fdf160ba55f2b6b78ff0883b73b77b6e-6afc421a83102.jpg?jadewits_media_id=65179" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/fdf160ba55f2b6b78ff0883b73b77b6e-6afc421a83102.jpg?jadewits_media_id=65179" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভবিষ্যতের নেতৃত্বের জন্য এখন থেকেই নিজেদের প্রস্তুত করতে হবে: প্রধানমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;পড়ালেখার পাশাপাশি খেলাধুলা, শিল্প-সংস্কৃতি ও সহশিক্ষা কার্যক্রমে নিজেদের দক্ষ করে তুলতে শিক্ষার্থীদের প্রতি আহ্বান জানিয়েছেন প্রধানমন্ত্রী তারেক রহমান। তিনি বলেন, ‘শিক্ষার্থীরাই জাতির ভবিষ্যৎ। তাই ভবিষ্যতের কর্মজীবন ও নেতৃত্বের জন্য এখন থেকেই নিজেদের প্রস্তুত করতে হবে।’						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/national/97852/%E0%A6%AD%E0%A6%AC%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%AF%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%8F%E0%A6%96%E0%A6%A8-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87%E0%A6%87-%E0%A6%A8%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%A6%E0%A7%87%E0%A6%B0">একাত্তর</source>
    </item>

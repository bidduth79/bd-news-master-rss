      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/07/14/dd23865be4007f0b74cc55c094fafe72-6a55ccecae180.jpg?jadewits_media_id=57636" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কিশোরগঞ্জ-৩ আসন শূন্য ঘোষণা করলেন স্পিকার" /&gt;&lt;/p&gt;&lt;p&gt;কিশোরগঞ্জ-৩ সংসদীয় আসনটি শূন্য ঘোষণা করেছেন জাতীয় সংসদের স্পিকার মেজর (অব.) হাফিজ উদ্দিন আহমদ বীর বিক্রম। মঙ্গলবার, সংসদ অধিবেশন শুরুর পরপরই তিনি আসনটি শূন্য হওয়ার এই আনুষ্ঠানিক ঘোষণা দেন। এর আগে শারীরিক অসুস্থতার কারণ দেখিয়ে জাতীয় সংসদ সদস্যের পদ থেকে পদত্যাগ করেন আসনটির বিএনপিদলীয় সংসদ সদস্য ড. ওস&lt;/p&gt;</description>
      <source url="https://ekattor.tv/national/97842/%E0%A6%95%E0%A6%BF%E0%A6%B6%E0%A7%8B%E0%A6%B0%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C-%E0%A7%A9-%E0%A6%86%E0%A6%B8%E0%A6%A8-%E0%A6%B6%E0%A7%82%E0%A6%A8%E0%A7%8D%E0%A6%AF-%E0%A6%98%E0%A7%8B%E0%A6%B7%E0%A6%A3%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0">একাত্তর</source>

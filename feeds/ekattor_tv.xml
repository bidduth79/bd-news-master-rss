    <item>
      <title>থামছে না ডেঙ্গুর থাবা, আরও আট জনের মৃত্যু</title>
      <link>https://ekattor.tv/health/hospital/97431/%E0%A6%A5%E0%A6%BE%E0%A6%AE%E0%A6%9B%E0%A7%87-%E0%A6%A8%E0%A6%BE-%E0%A6%A1%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%81%E0%A6%B0-%E0%A6%A5%E0%A6%BE%E0%A6%AC%E0%A6%BE-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A6%86%E0%A6%9F-%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81</link>
      <guid isPermaLink="true">https://ekattor.tv/health/hospital/97431/%E0%A6%A5%E0%A6%BE%E0%A6%AE%E0%A6%9B%E0%A7%87-%E0%A6%A8%E0%A6%BE-%E0%A6%A1%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%81%E0%A6%B0-%E0%A6%A5%E0%A6%BE%E0%A6%AC%E0%A6%BE-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A6%86%E0%A6%9F-%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81</guid>
      <pubDate>Tue, 10 Nov 2026 18:53:03 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/09/05/70b5a51b062c3ec4fcf0f1b5df2fd95f-6a9c1da4e4f87.jpg?jadewits_media_id=60603" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/09/05/70b5a51b062c3ec4fcf0f1b5df2fd95f-6a9c1da4e4f87.jpg?jadewits_media_id=60603" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/09/05/70b5a51b062c3ec4fcf0f1b5df2fd95f-6a9c1da4e4f87.jpg?jadewits_media_id=60603" style="max-width:100%;height:auto;margin-bottom:10px;" alt="থামছে না ডেঙ্গুর থাবা, আরও আট জনের মৃত্যু" /&gt;&lt;/p&gt;&lt;p&gt;দেশে ডেঙ্গুর সংক্রমণ আবারও উদ্বেগজনক পর্যায়ে পৌঁছেছে। গত ২৪ ঘণ্টায় ডেঙ্গুতে আক্রান্ত হয়ে আরও ৮ জনের মৃত্যু হয়েছে। একই সময়ে নতুন করে হাসপাতালে ভর্তি হয়েছেন ১ হাজার ৫৯৫ জন রোগী। স্বাস্থ্য অধিদপ্তরের ডেঙ্গুবিষয়ক নিয়মিত বুলেটিনে মঙ্গলবার এই তথ্য জানানো হয়েছে।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/health/hospital/97431/%E0%A6%A5%E0%A6%BE%E0%A6%AE%E0%A6%9B%E0%A7%87-%E0%A6%A8%E0%A6%BE-%E0%A6%A1%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%81%E0%A6%B0-%E0%A6%A5%E0%A6%BE%E0%A6%AC%E0%A6%BE-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A6%86%E0%A6%9F-%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81">একাত্তর</source>

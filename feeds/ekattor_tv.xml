      <title>ফ্যাসিবাদী শক্তির বিরুদ্ধে জাতীয় ঐক্যের ডাক দিলেন প্রধানমন্ত্রী</title>
      <link>https://ekattor.tv/national/97952/%E0%A6%AB%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A7%80-%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%90%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%A1%E0%A6%BE%E0%A6%95</link>
      <guid isPermaLink="true">https://ekattor.tv/national/97952/%E0%A6%AB%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A7%80-%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%90%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%A1%E0%A6%BE%E0%A6%95</guid>
      <pubDate>Thu, 19 Nov 2026 03:01:40 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/35da2f097f028b8939b934ea24120475-6afe11a5a8995.jpg?jadewits_media_id=65327" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/35da2f097f028b8939b934ea24120475-6afe11a5a8995.jpg?jadewits_media_id=65327" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/35da2f097f028b8939b934ea24120475-6afe11a5a8995.jpg?jadewits_media_id=65327" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফ্যাসিবাদী শক্তির বিরুদ্ধে জাতীয় ঐক্যের ডাক দিলেন প্রধানমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;কার্যক্রম নিষিদ্ধ আওয়ামী লীগকে একটি ‘সন্ত্রাসী গোষ্ঠী’ হিসেবে অভিহিত করে তাদের মাথা তুলে দাঁড়ানোর আগেই চব্বিশের চেতনায় তাদের মাথা গুঁড়িয়ে দেওয়ার জন্য দেশবাসীর প্রতি জোরালো আহ্বান জানিয়েছেন প্রধানমন্ত্রী তারেক রহমান। তিনি স্পষ্ট করে বলেছেন, আওয়ামী লীগ কোনো রাজনৈতিক দল নয়, বরং দেশ ও বিদেশে বারবার সন্&lt;/p&gt;</description>
      <source url="https://ekattor.tv/national/97952/%E0%A6%AB%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A7%80-%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%90%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%A1%E0%A6%BE%E0%A6%95">একাত্তর</source>
    </item>

      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/9a327ae5f8845d9f24bd627039ddefcd-6afb3bc2de54a.jpg?jadewits_media_id=65120" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/9a327ae5f8845d9f24bd627039ddefcd-6afb3bc2de54a.jpg?jadewits_media_id=65120" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/9a327ae5f8845d9f24bd627039ddefcd-6afb3bc2de54a.jpg?jadewits_media_id=65120" style="max-width:100%;height:auto;margin-bottom:10px;" alt="উন্নয়নের মূল ধারায় যুক্ত হচ্ছে দক্ষিণ বাংলা: স্বপন" /&gt;&lt;/p&gt;&lt;p&gt;দক্ষিণ বাংলাকে দেশের সামগ্রিক উন্নয়নের মূল ধারায় যুক্ত করার জোরালো প্রত্যয় ব্যক্ত করেছেন প্রধানমন্ত্রীর রাজনৈতিক উপদেষ্টা জহির উদ্দিন স্বপন এমপি। তিনি বলেছেন, ভোলার গ্যাসসম্পদ, পর্যটনকেন্দ্র কুয়াকাটার সমুদ্র সৈকত এবং পায়রা বন্দর দক্ষিণাঞ্চলের অত্যন্ত গুরুত্বপূর্ণ কৌশলগত সম্পদ। বর্তমান সরকার এই &lt;/p&gt;</description>
      <source url="https://ekattor.tv/abroad/97805/%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A6%AF%E0%A6%BC%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%82%E0%A6%B2-%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%A3-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE">একাত্তর</source>
    </item>
    <item>
      <title>অপেক্ষা শেষ! জাতীয় গ্রিডে যুক্ত হচ্ছে রূপপুরের বিদ্যুৎ</title>
      <link>https://ekattor.tv/national/97802/%E0%A6%85%E0%A6%AA%E0%A7%87%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%A1%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%B0%E0%A7%82%E0%A6%AA%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://ekattor.tv/national/97802/%E0%A6%85%E0%A6%AA%E0%A7%87%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%A1%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%B0%E0%A7%82%E0%A6%AA%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Mon, 16 Nov 2026 23:00:00 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/10/11/2a0b433b1b70a113d4e98f485ddc08d7-6acba9a4453e0.jpg?jadewits_media_id=62775" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/10/11/2a0b433b1b70a113d4e98f485ddc08d7-6acba9a4453e0.jpg?jadewits_media_id=62775" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/10/11/2a0b433b1b70a113d4e98f485ddc08d7-6acba9a4453e0.jpg?jadewits_media_id=62775" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অপেক্ষা শেষ! জাতীয় গ্রিডে যুক্ত হচ্ছে রূপপুরের বিদ্যুৎ" /&gt;&lt;/p&gt;&lt;p&gt;দেশের ইতিহাসে এক নতুন অধ্যায় রচনার দ্বারপ্রান্তে বাংলাদেশ। পারমাণবিক যুগের পথে বড় মাইলফলক ছুঁয়ে মঙ্গলবার মধ্যে প্রথমবারের মতো পরীক্ষামূলকভাবে জাতীয় গ্রিডের সঙ্গে যুক্ত হতে যাচ্ছে দেশের প্রথম পারমাণবিক বিদ্যুৎকেন্দ্র ‘রূপপুর পারমাণবিক বিদ্যুৎকেন্দ্র’ (আরএনপিপি)।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/national/97802/%E0%A6%85%E0%A6%AA%E0%A7%87%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%A1%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%B0%E0%A7%82%E0%A6%AA%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87%E0%A6%B0">একাত্তর</source>

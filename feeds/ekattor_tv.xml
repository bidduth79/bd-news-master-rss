      <guid isPermaLink="true">https://ekattor.tv/sports/cricket/98630/%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%8B%E0%A6%95%E0%A6%B8%E0%A6%95%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%9F%E0%A7%87%E0%A6%B8%E0%A7%8D%E0%A6%9F-%E0%A6%9A%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A7%9F%E0%A6%A8%E0%A6%B6%E0%A6%BF%E0%A6%AA%E0%A7%87-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A1</guid>
      <pubDate>Sat, 28 Nov 2026 15:28:13 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/6a6176cd8a53c3a761493ac6a032d4ad-6b0a9e78bfee1.jpg?jadewits_media_id=66196" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/6a6176cd8a53c3a761493ac6a032d4ad-6b0a9e78bfee1.jpg?jadewits_media_id=66196" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/6a6176cd8a53c3a761493ac6a032d4ad-6b0a9e78bfee1.jpg?jadewits_media_id=66196" style="max-width:100%;height:auto;margin-bottom:10px;" alt="স্টোকসকে ছাড়িয়ে টেস্ট চ্যাম্পিয়নশিপে নতুন রেকর্ড পান্তের" /&gt;&lt;/p&gt;&lt;p&gt;নিউজিল্যান্ডের বিপক্ষে ক্রাইস্টচার্চ টেস্টে ব্যাট হাতে নতুন রেকর্ড গড়েছেন ভারতের উইকেটকিপার ব্যাটার ঋষভ পান্ত। বেন স্টোকসকে পেছনে ফেলে বিশ্ব টেস্ট চ্যাম্পিয়নশিপের ইতিহাসে সর্বোচ্চ ছক্কার মালিক হয়েছেন তিনি।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/sports/cricket/98630/%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%8B%E0%A6%95%E0%A6%B8%E0%A6%95%E0%A7%87-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%9F%E0%A7%87%E0%A6%B8%E0%A7%8D%E0%A6%9F-%E0%A6%9A%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A7%9F%E0%A6%A8%E0%A6%B6%E0%A6%BF%E0%A6%AA%E0%A7%87-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A1">একাত্তর</source>

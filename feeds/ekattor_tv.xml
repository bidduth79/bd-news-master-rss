      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/598c76f9e54126cad69fd2b4454d303f-6b059c2ab027f.jpg?jadewits_media_id=65876" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিশ্ব দরবারে সশস্ত্র বাহিনীর সক্ষমতা তুলে ধরবে যৌথ মহড়া: প্রধানমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;প্রধানমন্ত্রী তারেক রহমান বলেছেন, তিন বাহিনীর যৌথ সামরিক মহড়া বিশ্বদরবারে বাংলাদেশের সশস্ত্র বাহিনীর সক্ষমতা তুলে ধরবে। তিনি বলেন, বাংলাদেশের সামরিক বাহিনীর ইতিহাসে আজ একটি নতুন অধ্যায়ের সূচনা হয়েছে। দেশের ইতিহাসে প্রথমবারের মতো তিন বাহিনীর স্পেশাল ফোর্সের সমন্বয়ে অনুষ্ঠিত যৌথ সামরিক মহড়ার সাক্ষী হত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/national/98375/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC-%E0%A6%A6%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A6%B6%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%B8%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%AE%E0%A6%A4%E0%A6%BE-%E0%A6%A4%E0%A7%81%E0%A6%B2%E0%A7%87-%E0%A6%A7%E0%A6%B0%E0%A6%AC%E0%A7%87-%E0%A6%AF%E0%A7%8C%E0%A6%A5">একাত্তর</source>
    </item>
    <item>
      <title>বিদেশ থেকে ফোনে ফোনেই অপরাধ জগত নিয়ন্ত্রণ!</title>
      <link>https://ekattor.tv/capital/98374/%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AB%E0%A7%8B%E0%A6%A8%E0%A7%87-%E0%A6%AB%E0%A7%8B%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%85%E0%A6%AA%E0%A6%B0%E0%A6%BE%E0%A6%A7-%E0%A6%9C%E0%A6%97%E0%A6%A4-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A3</link>
      <guid isPermaLink="true">https://ekattor.tv/capital/98374/%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AB%E0%A7%8B%E0%A6%A8%E0%A7%87-%E0%A6%AB%E0%A7%8B%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%85%E0%A6%AA%E0%A6%B0%E0%A6%BE%E0%A6%A7-%E0%A6%9C%E0%A6%97%E0%A6%A4-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A3</guid>
      <pubDate>Tue, 24 Nov 2026 20:12:43 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/a79fe07b67ac8e74243573988f6997e2-6b059ae16c72f.jpg?jadewits_media_id=65873" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/a79fe07b67ac8e74243573988f6997e2-6b059ae16c72f.jpg?jadewits_media_id=65873" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/a79fe07b67ac8e74243573988f6997e2-6b059ae16c72f.jpg?jadewits_media_id=65873" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিদেশ থেকে ফোনে ফোনেই অপরাধ জগত নিয়ন্ত্রণ!" /&gt;&lt;/p&gt;&lt;p&gt;বিদেশি পিস্তল, গুলি, বিপুল দেশীয় অস্ত্র ও মাদকসহ রাজধানীর মিরপুর, পল্লবী ও রূপনগর এলাকায় সক্রিয় কথিত ‘ফোর স্টার’ গ্রুপের ছয় সদস্যকে গ্রেপ্তার করেছে স্পেশাল রেসপন্স ব্যাটালিয়ন (এসআরবি-৪)। এর আগে এই গ্রুপের অনেক সদস্যকে গ্রেপ্তার করা হলেও, থামেনি তাদের অপরাধ। এসআরবি বলছে, বিদেশে অবস্থান করেই ফোনের মা&lt;/p&gt;</description>
      <source url="https://ekattor.tv/capital/98374/%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AB%E0%A7%8B%E0%A6%A8%E0%A7%87-%E0%A6%AB%E0%A7%8B%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%85%E0%A6%AA%E0%A6%B0%E0%A6%BE%E0%A6%A7-%E0%A6%9C%E0%A6%97%E0%A6%A4-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A3">একাত্তর</source>

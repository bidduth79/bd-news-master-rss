      <guid isPermaLink="true">https://ekattor.tv/international/middle-east/98070/%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%9A%E0%A6%A8%E0%A7%87-%E0%A6%B9%E0%A7%87%E0%A6%B0%E0%A7%87-%E0%A6%AD%E0%A7%9F%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%B0-%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A7%87%E0%A6%A4%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B9%E0%A7%81</guid>
      <pubDate>Fri, 20 Nov 2026 22:20:17 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/05/29/aadb6aab90ef73b688dcbb9dd6559323-6a18b253f0633.jpg?jadewits_media_id=54658" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/05/29/aadb6aab90ef73b688dcbb9dd6559323-6a18b253f0633.jpg?jadewits_media_id=54658" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/05/29/aadb6aab90ef73b688dcbb9dd6559323-6a18b253f0633.jpg?jadewits_media_id=54658" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নির্বাচনে হেরে ভয়ঙ্কর খেলায় মেতেছেন নেতানিয়াহু" /&gt;&lt;/p&gt;&lt;p&gt;আহত পশুর মতো আচরণ করছেন ইসরাইলের প্রধানমন্ত্রী বেনিয়ামিন নেতানিয়াহু। গত ২৭ অক্টোবরের নির্বাচনের পর থেকেই ইসরাইলের তত্ত্বাবধায়ক প্রধানমন্ত্রী নেতানিয়াহু বিরোধীদের বিরুদ্ধে একের পর এক আক্রমণ শানিয়ে যাচ্ছেন এবং নির্বাচনের ফলাফলের বৈধতা নিয়েও প্রশ্ন তুলছেন। দীর্ঘদিন ধরে ইসরাইলের ক্ষমতায় থাকা নেতানিয়াহু &lt;/p&gt;</description>
      <source url="https://ekattor.tv/international/middle-east/98070/%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%9A%E0%A6%A8%E0%A7%87-%E0%A6%B9%E0%A7%87%E0%A6%B0%E0%A7%87-%E0%A6%AD%E0%A7%9F%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%B0-%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A7%87%E0%A6%A4%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B9%E0%A7%81">একাত্তর</source>
    </item>
    <item>
      <title>ইউক্রেনে বৃষ্টির মতো ড্রোন ও ক্ষেপণাস্ত্র ছুড়লো রাশিয়া</title>

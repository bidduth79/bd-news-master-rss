      <guid isPermaLink="true">https://ekattor.tv/national/98249/%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A6%AC%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%B0-%E0%A6%86%E0%A6%AD%E0%A6%BE%E0%A6%B8-%E0%A6%B6%E0%A7%80%E0%A6%A4-%E0%A6%86%E0%A6%B8%E0%A6%9B%E0%A7%87-%E0%A6%95%E0%A6%AC%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A7%8B-%E0%A6%86%E0%A6%AC%E0%A6%B9%E0%A6%BE%E0%A6%93%E0%A6%AF%E0%A6%BC%E0%A6%BE</guid>
      <pubDate>Mon, 23 Nov 2026 13:48:14 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2024/05/30/c621aa49208e4295bbdc7150435d0c2f-665801a6a638a.JPG?jadewits_media_id=21108" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2024/05/30/c621aa49208e4295bbdc7150435d0c2f-665801a6a638a.JPG?jadewits_media_id=21108" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2024/05/30/c621aa49208e4295bbdc7150435d0c2f-665801a6a638a.JPG?jadewits_media_id=21108" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আরও বৃষ্টির আভাস, শীত আসছে কবে জানালো আবহাওয়া অফিস" /&gt;&lt;/p&gt;&lt;p&gt;আগামী ২৪ ঘণ্টায় দেশের উত্তর ও দক্ষিণাঞ্চলের বিভিন্ন জায়গায় বৃষ্টি হতে পারে বলে জানিয়েছে আবহাওয়া অধিদপ্তর। তবে মঙ্গলবার (২৪ নভেম্বর) থেকে দেশের আবহাওয়া শুষ্ক হতে শুরু করবে এবং দিন ও রাতের তাপমাত্রা কমে আসবে। আগামী এক-দুই দিনের মধ্যে সারাদেশে ঠান্ডার অনুভূতি বাড়তে পারে।						বিস্তারিত&lt;/p&gt;</description>

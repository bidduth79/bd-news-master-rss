      <link>https://ekattor.tv/politics/98011/%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%9F%E0%A6%BE%E0%A6%A8%E0%A6%BE</link>
      <guid isPermaLink="true">https://ekattor.tv/politics/98011/%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%9F%E0%A6%BE%E0%A6%A8%E0%A6%BE</guid>
      <pubDate>Thu, 19 Nov 2026 20:43:47 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/a3b7fa5bdaf9953a8cd6d4c324fa4390-6aff0b141879e.jpg?jadewits_media_id=65416" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/a3b7fa5bdaf9953a8cd6d4c324fa4390-6aff0b141879e.jpg?jadewits_media_id=65416" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/a3b7fa5bdaf9953a8cd6d4c324fa4390-6aff0b141879e.jpg?jadewits_media_id=65416" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আওয়ামী লীগের বিরুদ্ধে ডিসেম্বর পর্যন্ত টানা কর্মসূচি ঘোষণা এনসিপির" /&gt;&lt;/p&gt;&lt;p&gt;কার্যক্রম নিষিদ্ধ আওয়ামী লীগের বিরুদ্ধে জনগণকে সঙ্গে নিয়ে রাজপথে থাকার ঘোষণা দিয়েছে জাতীয় নাগরিক পার্টি (এনসিপি)। শেখ হাসিনার ফাঁসি কার্যকর ও গঙ্গার পানি চুক্তিসহ কয়েকটি দাবিতে চলতি মাস থেকে আগামী ডিসেম্বর পর্যন্ত টানা রাজনৈতিক কর্মসূচি পালন করবে দলটি।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/politics/98011/%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%9F%E0%A6%BE%E0%A6%A8%E0%A6%BE">একাত্তর</source>
    </item>

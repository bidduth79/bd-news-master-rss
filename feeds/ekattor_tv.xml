      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/5aea535eb673140bb8d01b6fa11197c0-6b0153fbafe69.jpg?jadewits_media_id=65521" medium="image" />

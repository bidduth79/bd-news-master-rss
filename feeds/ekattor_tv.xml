      <guid isPermaLink="true">https://ekattor.tv/sports/football/97692/%E0%A6%B0%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A6%A6%E0%A7%8B%E0%A6%B9%E0%A7%80%E0%A6%A8-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A7%81%E0%A6%97%E0%A6%BE%E0%A6%B2%E0%A6%95%E0%A7%87-%E0%A7%AA-%E0%A7%A7-%E0%A6%97%E0%A7%8B%E0%A6%B2%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%A7%E0%A7%8D%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%8B</guid>
      <pubDate>Sun, 15 Nov 2026 14:33:59 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/4cefb016f45c669975a749a584d9103d-6af96def343fd.jpg?jadewits_media_id=64971" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/4cefb016f45c669975a749a584d9103d-6af96def343fd.jpg?jadewits_media_id=64971" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/4cefb016f45c669975a749a584d9103d-6af96def343fd.jpg?jadewits_media_id=64971" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রোনালদোহীন পর্তুগালকে ৪-১ গোলে বিধ্বস্ত করলো ডেনমার্ক" /&gt;&lt;/p&gt;&lt;p&gt;কিংবদন্তি ক্রিশ্চিয়ানো রোনালদো ছাড়া পর্তুগালের নতুন পথচলা শুরু হলো এক চরম দুঃস্বপ্ন আর লজ্জার হার দিয়ে! কোচ হোর্হে জেসুসের সঙ্গে প্রকাশ্য দ্বন্দ্বের জেরে গত সপ্তাহেই আন্তর্জাতিক ফুটবলকে বিদায় বলেছিলেন সিআর সেভেন। শনিবার ব্রাগায় ঘরের মাঠে সেই মহাতারকাকে আবেগঘন বিদায়ী শ্রদ্ধা জানাতে নেমেছিল পর্তুগিজরা&lt;/p&gt;</description>
      <source url="https://ekattor.tv/sports/football/97692/%E0%A6%B0%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A6%A6%E0%A7%8B%E0%A6%B9%E0%A7%80%E0%A6%A8-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A7%81%E0%A6%97%E0%A6%BE%E0%A6%B2%E0%A6%95%E0%A7%87-%E0%A7%AA-%E0%A7%A7-%E0%A6%97%E0%A7%8B%E0%A6%B2%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%A7%E0%A7%8D%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%8B">একাত্তর</source>

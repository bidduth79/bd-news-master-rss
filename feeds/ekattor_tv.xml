      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/b007bbea356974136a44ff0a1937893f-6af5c3c27119f.jpg?jadewits_media_id=64797" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/b007bbea356974136a44ff0a1937893f-6af5c3c27119f.jpg?jadewits_media_id=64797" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/b007bbea356974136a44ff0a1937893f-6af5c3c27119f.jpg?jadewits_media_id=64797" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইরান যুদ্ধ নিয়ে ট্রাম্পের সাথে নেতানিয়াহুর তুমুল ঝগড়া!" /&gt;&lt;/p&gt;&lt;p&gt;ইরান যুদ্ধ নিয়ে মার্কিন প্রেসিডেন্ট ডোনাল্ড ট্রাম্প এবং ইসরাইলি প্রধানমন্ত্রী বেনিয়ামিন নেতানিয়াহুর মধ্যে এক উত্তপ্ত ফোনালাপকে কেন্দ্র করে আন্তর্জাতিক রাজনীতিতে চরম তোলপাড় শুরু হয়েছে। সপ্তাহান্তে হওয়া এই ফোনালাপে দুই নেতার মধ্যে রীতিমতো ‘নরকীয় বাদানুবাদ ও চিৎকার-চেঁচামেচি’ হয়েছে বলে প্রতিবেদন প্রকা&lt;/p&gt;</description>
      <source url="https://ekattor.tv/international/middle-east/97558/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%A5%E0%A7%87-%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%B9%E0%A7%81%E0%A6%B0-%E0%A6%A4%E0%A7%81%E0%A6%AE%E0%A7%81%E0%A6%B2">একাত্তর</source>

      <guid isPermaLink="true">https://ekattor.tv/international/europe/98069/%E0%A6%87%E0%A6%89%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%B0-%E0%A6%AE%E0%A6%A4%E0%A7%8B-%E0%A6%A1%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%A8-%E0%A6%93-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA%E0%A6%A3%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%9B%E0%A7%81%E0%A7%9C%E0%A6%B2%E0%A7%8B</guid>
      <pubDate>Fri, 20 Nov 2026 22:04:00 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/5bf509129dc348109f7744b072a0e7f3-6b006f37882f8.jpg?jadewits_media_id=65494" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/5bf509129dc348109f7744b072a0e7f3-6b006f37882f8.jpg?jadewits_media_id=65494" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/5bf509129dc348109f7744b072a0e7f3-6b006f37882f8.jpg?jadewits_media_id=65494" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইউক্রেনে বৃষ্টির মতো ড্রোন ও ক্ষেপণাস্ত্র ছুড়লো রাশিয়া" /&gt;&lt;/p&gt;&lt;p&gt;ক্রিমিয়া সেতুতে ইউক্রেনীয় হামলার কঠোর প্রতিশোধ নেয়ার হুঁশিয়ারি দেয়ার পরদিনই ইউক্রেনজুড়ে যুদ্ধের অন্যতম ভয়াবহ ক্ষেপণাস্ত্র ও ড্রোন হামলা চালিয়েছে রাশিয়া। শুক্রবার, চালানো এই ব্যাপক আকাশপথে হামলায় ইউক্রেনের বিদ্যুৎ অবকাঠামো, রেলপথ ও পরিবহন ব্যবস্থা মারাত্মকভাবে ক্ষতিগ্রস্ত হয়েছে এবং অন্তত আটজন নিহত হয়&lt;/p&gt;</description>
      <source url="https://ekattor.tv/international/europe/98069/%E0%A6%87%E0%A6%89%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%B0-%E0%A6%AE%E0%A6%A4%E0%A7%8B-%E0%A6%A1%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%A8-%E0%A6%93-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA%E0%A6%A3%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%9B%E0%A7%81%E0%A7%9C%E0%A6%B2%E0%A7%8B">একাত্তর</source>

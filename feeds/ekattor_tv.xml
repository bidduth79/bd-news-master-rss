    <item>
      <title>ইতিহাসের দীর্ঘতম জলবায়ু সম্মেলন কপ-৩১ ব্যর্থ!</title>
      <link>https://ekattor.tv/international/98235/%E0%A6%87%E0%A6%A4%E0%A6%BF%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%80%E0%A6%B0%E0%A7%8D%E0%A6%98%E0%A6%A4%E0%A6%AE-%E0%A6%9C%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A7%81-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%A8-%E0%A6%95%E0%A6%AA-%E0%A7%A9%E0%A7%A7-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%B0%E0%A7%8D%E0%A6%A5</link>
      <guid isPermaLink="true">https://ekattor.tv/international/98235/%E0%A6%87%E0%A6%A4%E0%A6%BF%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%80%E0%A6%B0%E0%A7%8D%E0%A6%98%E0%A6%A4%E0%A6%AE-%E0%A6%9C%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A7%81-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%A8-%E0%A6%95%E0%A6%AA-%E0%A7%A9%E0%A7%A7-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%B0%E0%A7%8D%E0%A6%A5</guid>
      <pubDate>Mon, 23 Nov 2026 02:02:32 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/d7179be2b802b74fab1fa19cc1d2ad6e-6b03486ee9540.jpg?jadewits_media_id=65705" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/d7179be2b802b74fab1fa19cc1d2ad6e-6b03486ee9540.jpg?jadewits_media_id=65705" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/d7179be2b802b74fab1fa19cc1d2ad6e-6b03486ee9540.jpg?jadewits_media_id=65705" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইতিহাসের দীর্ঘতম জলবায়ু সম্মেলন কপ-৩১ ব্যর্থ!" /&gt;&lt;/p&gt;&lt;p&gt;বৈশ্বিক উষ্ণতা রোধে যথেষ্ট শক্তিশালী নয় এমন অভিযোগে কপ-৩১ সম্মেলনের সভাপতি তুরস্ক ও অস্ট্রেলিয়ার উপস্থাপিত চূড়ান্ত খসড়া চুক্তি প্রত্যাখ্যান করেছে ইউরোপীয় ইউনিয়ন (ইইউ) ও অন্যান্য কয়েকটি দেশ। এর ফলে রোববার কোনো ঐকমত্য ছাড়াই ব্যর্থতায় পর্যবসিত হলো জাতিসংঘের জলবায়ু আলোচনা। যুদ্ধবিগ্রহ ও বৈশ্বিক অর্থনৈতি&lt;/p&gt;</description>
      <source url="https://ekattor.tv/international/98235/%E0%A6%87%E0%A6%A4%E0%A6%BF%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%80%E0%A6%B0%E0%A7%8D%E0%A6%98%E0%A6%A4%E0%A6%AE-%E0%A6%9C%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A7%81-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%A8-%E0%A6%95%E0%A6%AA-%E0%A7%A9%E0%A7%A7-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%B0%E0%A7%8D%E0%A6%A5">একাত্তর</source>
    </item>
    <item>
      <title>নতুন বছরে ইরানে নতুন সামরিক অভিযান: ট্রাম্প</title>
      <link>https://ekattor.tv/international/middle-east/98234/%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87-%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%B0%E0%A6%BF%E0%A6%95-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA</link>
      <guid isPermaLink="true">https://ekattor.tv/international/middle-east/98234/%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87-%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%B0%E0%A6%BF%E0%A6%95-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA</guid>
      <pubDate>Mon, 23 Nov 2026 01:42:59 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/03/ab9ebd1cfa6efbc7d9b91867743aa30e-6aea01b9d1b55.jpg?jadewits_media_id=64162" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/03/ab9ebd1cfa6efbc7d9b91867743aa30e-6aea01b9d1b55.jpg?jadewits_media_id=64162" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/03/ab9ebd1cfa6efbc7d9b91867743aa30e-6aea01b9d1b55.jpg?jadewits_media_id=64162" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নতুন বছরে ইরানে নতুন সামরিক অভিযান: ট্রাম্প" /&gt;&lt;/p&gt;&lt;p&gt;নতুন বছরের পর ইরানের বিরুদ্ধে নতুন সামরিক পদক্ষেপ শুরু করার কড়া হুঁশিয়ারি দিয়েছেন মার্কিন প্রেসিডেন্ট ডোনাল্ড ট্রাম্প। ফক্স নিউজকে দেয়া সাম্প্রতিক বক্তব্যে তিনি সতর্ক করে বলেছেন, ওয়াশিংটনের সঙ্গে চুক্তিতে পৌঁছানো না গেলে যুক্তরাষ্ট্র আবারও সামরিক অভিযানে ফিরে যাবে।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/international/middle-east/98234/%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87-%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%B0%E0%A6%BF%E0%A6%95-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA">একাত্তর</source>
    </item>

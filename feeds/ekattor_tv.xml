      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/e66a23746acf34979c727fbaae7398b9-6b004b2c84371.jpg?jadewits_media_id=65477" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/e66a23746acf34979c727fbaae7398b9-6b004b2c84371.jpg?jadewits_media_id=65477" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/e66a23746acf34979c727fbaae7398b9-6b004b2c84371.jpg?jadewits_media_id=65477" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গুগল ম্যাপসে যেভাবে জানবেন নিজের এলাকার বাতাসের মান" /&gt;&lt;/p&gt;&lt;p&gt;যানবাহনের ধোঁয়া, শিল্পকারখানার দূষণ, নির্মাণকাজের ধুলাবালু ও প্রতিকূল আবহাওয়ার কারণে বিভিন্ন এলাকায় বায়ুদূষণের মাত্রা কমবেশি হয়ে থাকে। এ পরিস্থিতিতে বাইরে বের হওয়ার আগে বাতাসের মান জেনে নেওয়া জরুরি। এ জন্য সহজেই ব্যবহার করা যায় গুগল ম্যাপসের ‘এয়ার কোয়ালিটি’ সুবিধা।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/lifestyle/98058/%E0%A6%97%E0%A7%81%E0%A6%97%E0%A6%B2-%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AA%E0%A6%B8%E0%A7%87-%E0%A6%AF%E0%A7%87%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A7%87%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%8F%E0%A6%B2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B8%E0%A7%87%E0%A6%B0">একাত্তর</source>

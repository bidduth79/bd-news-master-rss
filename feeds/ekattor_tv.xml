      <guid isPermaLink="true">https://ekattor.tv/international/98093/%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%87%E0%A6%87-%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%B8%E0%A7%81%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%95-%E0%A6%93</guid>
      <pubDate>Sat, 21 Nov 2026 14:38:34 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/a03294744bb73d548fe213140a999e6b-6b015755d694c.jpg?jadewits_media_id=65522" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/a03294744bb73d548fe213140a999e6b-6b015755d694c.jpg?jadewits_media_id=65522" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/a03294744bb73d548fe213140a999e6b-6b015755d694c.jpg?jadewits_media_id=65522" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভারতের স্বার্থেই ইসরায়েলের সঙ্গে সুসম্পর্ক ও অস্ত্র বাণিজ্য চান রাহুল গান্ধী" /&gt;&lt;/p&gt;&lt;p&gt;গাজায় ইসরায়েলের সামরিক অভিযান নিয়ে আন্তর্জাতিক সমালোচনা ও গণহত্যার অভিযোগের মধ্যেও দেশটির সঙ্গে ভারতের সুসম্পর্ক ও অস্ত্র বাণিজ্য অব্যাহত রাখার পক্ষে অবস্থান নিয়েছেন ভারতের বিরোধী দল কংগ্রেস নেতা রাহুল গান্ধী। তিনি বলেন, ভারতের পররাষ্ট্রনীতি অন্য দেশের স্বার্থের ভিত্তিতে নয়, বরং নিজেদের জাতীয় স্বার্&lt;/p&gt;</description>
      <source url="https://ekattor.tv/international/98093/%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A7%87%E0%A6%87-%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%B8%E0%A7%81%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%95-%E0%A6%93">একাত্তর</source>

      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/6adf830db3373bfccd6e9da24a64237d-6afdee68c3a7f.jpg?jadewits_media_id=65318" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/6adf830db3373bfccd6e9da24a64237d-6afdee68c3a7f.jpg?jadewits_media_id=65318" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নড়াইলে বিএনপির শোভাযাত্রায় কার্যক্রম নিষিদ্ধ আওয়ামী লীগের হামলায় নিহত দুই নেতা" /&gt;&lt;/p&gt;&lt;p&gt;নড়াইলের কালিয়া উপজেলায় সন্ত্রাস ও নৈরাজ্যের প্রতিবাদে বের করা বিএনপির মোটরসাইকেল শোভাযাত্রায় কার্যক্রম নিষিদ্ধ আওয়ামী লীগ ও এর সহযোগী সংগঠনের নেতাকর্মীদের অতর্কিত হামলায় স্থানীয় জাসাস ও কৃষকদলের দুই নেতা নিহত হয়েছেন। বুধবার সন্ধ্যা ৭টার দিকে কালিয়া পৌরসভার বেন্দারচর এলাকার বটতলা মোড় ও খালের কাছাকাছি&lt;/p&gt;</description>
      <source url="https://ekattor.tv/country/jessore/97946/%E0%A6%A8%E0%A7%9C%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%B6%E0%A7%8B%E0%A6%AD%E0%A6%BE%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7">একাত্তর</source>

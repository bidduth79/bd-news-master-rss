      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/872b21a8fa920202abf46b08ff63a1c3-6afd821b9e91f.jpg?jadewits_media_id=65263" length="0" type="image/jpeg" />

      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/10/23/0fd72b156a5907df2082aaf8be271eea-6adb1d4e5cce6.jpg?jadewits_media_id=63491" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/10/23/0fd72b156a5907df2082aaf8be271eea-6adb1d4e5cce6.jpg?jadewits_media_id=63491" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/10/23/0fd72b156a5907df2082aaf8be271eea-6adb1d4e5cce6.jpg?jadewits_media_id=63491" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফ্যাসিস্টের নৈরাজ্য রুখতে রাজপথে নামছে এনসিপি" /&gt;&lt;/p&gt;&lt;p&gt;কার্যক্রম নিষিদ্ধ আওয়ামী লীগের কথিত নৈরাজ্য প্রতিরোধের ঘোষণা দিয়ে রাজধানীতে মোটরসাইকেল র‍্যালি করবে জাতীয় নাগরিক পার্টি (এনসিপি)। মঙ্গলবার দুপুর সাড়ে ১২টায় রাজধানীর মানিক মিয়া অ্যাভিনিউয়ের আড়ং প্রান্ত থেকে এই কর্মসূচি শুরু হবে।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/politics/98300/%E0%A6%AB%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A7%88%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A7%8D%E0%A6%AF-%E0%A6%B0%E0%A7%81%E0%A6%96%E0%A6%A4%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A6%9B%E0%A7%87-%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF">একাত্তর</source>
    </item>
    <item>
      <title>সেঞ্চুরিয়নে প্রথমবার দুই অঙ্কে অলআউট কোনো দল</title>

      <guid isPermaLink="true">https://ekattor.tv/entertainment/hollywood/98545/%E0%A6%A7%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%8B%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A6%BF-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A6%BF%E0%A6%89</guid>
      <pubDate>Thu, 26 Nov 2026 20:25:53 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/fbc28d387c3515d157969da4406f351d-6b0841647259b.jpg?jadewits_media_id=66112" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/fbc28d387c3515d157969da4406f351d-6b0841647259b.jpg?jadewits_media_id=66112" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/fbc28d387c3515d157969da4406f351d-6b0841647259b.jpg?jadewits_media_id=66112" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ধর্ষণের অভিযোগে বিচারের মুখোমুখি অভিনেতা দেপার্দিউ" /&gt;&lt;/p&gt;&lt;p&gt;ফরাসি সিনেমার অন্যতম পরিচিত মুখ অভিনেতা জেরার্দ দেপার্দিউকে ২০১৮ সালে নামী অভিনেত্রী শার্লট আর্নল্ডকে ধর্ষণের অভিযোগে বিচারের মুখোমুখি হতে হবে। মামলাটি বিচারের আওতায় না নেয়ার আবেদন বৃহস্পতিবার প্যারিসের একটি আপিল আদালত খারিজ করে দেওয়ার পর এই পথ তৈরি হয়েছে।						বিস্তারিত&lt;/p&gt;</description>

      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/3b39336c139c996f53e96af3f5f350f0-6afed41658ebf.jpg?jadewits_media_id=65377" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/3b39336c139c996f53e96af3f5f350f0-6afed41658ebf.jpg?jadewits_media_id=65377" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দেড় ঘণ্টার রুদ্ধদ্বার শেনজেন বৈঠকে কি আলোচনা হলো?" /&gt;&lt;/p&gt;&lt;p&gt;বিশ্ব ইতিহাসে প্রথমবারের মতো এক টেবিলে বসে প্রায় দেড় ঘণ্টাব্যাপী নজিরবিহীন ত্রিপক্ষীয় বৈঠক সম্পন্ন করলেন চীনের প্রেসিডেন্ট শি জিনপিং, মার্কিন প্রেসিডেন্ট ডোনাল্ড ট্রাম্প এবং রাশিয়ার প্রেসিডেন্ট ভ্লাদিমির পুতিন। বৃহস্পতিবার চীনের দক্ষিণাঞ্চলীয় শহর শেনজেনে স্থানীয় সময় বিকেল সাড়ে ৪টায় এই বৈঠক শুরু হয়&lt;/p&gt;</description>
      <source url="https://ekattor.tv/international/asia/97987/%E0%A6%A6%E0%A7%87%E0%A7%9C-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B6%E0%A7%87%E0%A6%A8%E0%A6%9C%E0%A7%87%E0%A6%A8-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A6%BF-%E0%A6%86%E0%A6%B2%E0%A7%8B%E0%A6%9A%E0%A6%A8%E0%A6%BE-%E0%A6%B9%E0%A6%B2%E0%A7%8B">একাত্তর</source>

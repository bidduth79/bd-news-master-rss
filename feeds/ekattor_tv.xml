    <item>
      <title>গোপালগঞ্জে ১০ প্লাটুন বিজিবি, আকাশে ড্রোন মাঠে এপিসি</title>
      <link>https://ekattor.tv/country/dhaka/97757/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A7%A7%E0%A7%A6-%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%9F%E0%A7%81%E0%A6%A8-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%AC%E0%A6%BF-%E0%A6%86%E0%A6%95%E0%A6%BE%E0%A6%B6%E0%A7%87-%E0%A6%A1%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%A0%E0%A7%87</link>
      <guid isPermaLink="true">https://ekattor.tv/country/dhaka/97757/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A7%A7%E0%A7%A6-%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%9F%E0%A7%81%E0%A6%A8-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%AC%E0%A6%BF-%E0%A6%86%E0%A6%95%E0%A6%BE%E0%A6%B6%E0%A7%87-%E0%A6%A1%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%A0%E0%A7%87</guid>
      <pubDate>Mon, 16 Nov 2026 14:38:49 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/443feedbd7b9c0d3ff28659cc44eb089-6afac107b7217.jpg?jadewits_media_id=65048" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/443feedbd7b9c0d3ff28659cc44eb089-6afac107b7217.jpg?jadewits_media_id=65048" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/443feedbd7b9c0d3ff28659cc44eb089-6afac107b7217.jpg?jadewits_media_id=65048" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গোপালগঞ্জে ১০ প্লাটুন বিজিবি, আকাশে ড্রোন মাঠে এপিসি" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জের সার্বিক আইনশৃঙ্খলা পরিস্থিতি স্বাভাবিক রাখা এবং সাধারণ মানুষের জানমালের নিরাপত্তা নিশ্চিত করতে জেলার গুরুত্বপূর্ণ পয়েন্টগুলোতে ১০ প্লাটুন বর্ডার গার্ড বাংলাদেশ (বিজিবি) মোতায়েন করা হয়েছে। যে কোনো ধরনের অনাকাঙ্ক্ষিত পরিস্থিতি ও দাঙ্গা কঠোরভাবে মোকাবিলায় নামানো হয়েছে অত্যাধুনিক আর্মার্ড পা&lt;/p&gt;</description>
      <source url="https://ekattor.tv/country/dhaka/97757/%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A7%A7%E0%A7%A6-%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%9F%E0%A7%81%E0%A6%A8-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%AC%E0%A6%BF-%E0%A6%86%E0%A6%95%E0%A6%BE%E0%A6%B6%E0%A7%87-%E0%A6%A1%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%A0%E0%A7%87">একাত্তর</source>
    </item>
    <item>
      <title>আগুন সন্ত্রাস করে জনগণের সমর্থন পাবে না দুর্বৃত্তরা: আবদুস সালাম</title>
      <link>https://ekattor.tv/politics/97756/%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B8-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%9C%E0%A6%A8%E0%A6%97%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%A8-%E0%A6%AA%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%A8%E0%A6%BE</link>
      <guid isPermaLink="true">https://ekattor.tv/politics/97756/%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B8-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%9C%E0%A6%A8%E0%A6%97%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%A8-%E0%A6%AA%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%A8%E0%A6%BE</guid>
      <pubDate>Mon, 16 Nov 2026 14:29:15 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/87d5d1af2160c385a56854e2ee631c8d-6afabed2ca681.jpg?jadewits_media_id=65047" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/87d5d1af2160c385a56854e2ee631c8d-6afabed2ca681.jpg?jadewits_media_id=65047" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/87d5d1af2160c385a56854e2ee631c8d-6afabed2ca681.jpg?jadewits_media_id=65047" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আগুন সন্ত্রাস করে জনগণের সমর্থন পাবে না দুর্বৃত্তরা: আবদুস সালাম" /&gt;&lt;/p&gt;&lt;p&gt;ঢাকা দক্ষিণ সিটি করপোরেশনের প্রশাসক আবদুস সালাম বলেছেন, ‘আগুন সন্ত্রাসের মাধ্যমে জনগণের সমর্থন পাবে না দুর্বৃত্তরা। দেশে অস্থিতিশীলতা সৃষ্টি করতে যারা নাশকতা চালাতে চায়, জনগণকে সঙ্গে নিয়ে তাদের মোকাবিলা করবে বিএনপি।’						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/politics/97756/%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B8-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%9C%E0%A6%A8%E0%A6%97%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%A8-%E0%A6%AA%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%A8%E0%A6%BE">একাত্তর</source>

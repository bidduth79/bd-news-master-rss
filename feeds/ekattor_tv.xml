      <guid isPermaLink="true">https://ekattor.tv/country/chittagong/97480/%E0%A6%95%E0%A7%81%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A6%BE-%E0%A6%AE%E0%A7%87%E0%A7%9F%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%A7%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A6%A3-%E0%A6%93-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A7%9F%E0%A7%87-%E0%A6%AE%E0%A7%8B%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Wed, 11 Nov 2026 16:31:04 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/a24b29b5ebb3226c131bad5534a62393-6af443aebf70c.jpg?jadewits_media_id=64674" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/a24b29b5ebb3226c131bad5534a62393-6af443aebf70c.jpg?jadewits_media_id=64674" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/a24b29b5ebb3226c131bad5534a62393-6af443aebf70c.jpg?jadewits_media_id=64674" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কুমিল্লায় মা-মেয়েকে ধর্ষণ ও হত্যার দায়ে মোবারকের মৃত্যুদণ্ড" /&gt;&lt;/p&gt;&lt;p&gt;কুমিল্লা বিশ্ববিদ্যালয়ের (কুবি) ছাত্রী সুমাইয়া আফরিন ও তার মা তাহমিনা বেগমকে ধর্ষণ ও হত্যার দায়ে মামলার একমাত্র আসামি মোবারক হোসেনকে মৃত্যুদণ্ড দিয়েছেন আদালত। একই সঙ্গে তাকে মোট ৩ লাখ টাকা জরিমানা করা হয়েছে।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/country/chittagong/97480/%E0%A6%95%E0%A7%81%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A6%BE-%E0%A6%AE%E0%A7%87%E0%A7%9F%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%A7%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A6%A3-%E0%A6%93-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A7%9F%E0%A7%87-%E0%A6%AE%E0%A7%8B%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A7%87%E0%A6%B0">একাত্তর</source>
    </item>
    <item>
      <title>বিদেশি দক্ষ কর্মীদের মার্কিন ভিসা স্পন্সরশিপ বন্ধ করছে আইবিএম</title>
      <link>https://ekattor.tv/business/97479/%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF-%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8-%E0%A6%AD%E0%A6%BF%E0%A6%B8%E0%A6%BE-%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A6%A8%E0%A7%8D%E0%A6%B8%E0%A6%B0%E0%A6%B6%E0%A6%BF%E0%A6%AA-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7</link>
      <guid isPermaLink="true">https://ekattor.tv/business/97479/%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF-%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8-%E0%A6%AD%E0%A6%BF%E0%A6%B8%E0%A6%BE-%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A6%A8%E0%A7%8D%E0%A6%B8%E0%A6%B0%E0%A6%B6%E0%A6%BF%E0%A6%AA-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7</guid>
      <pubDate>Wed, 11 Nov 2026 16:28:14 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/e1ae271b1bb879f934073081f35c143e-6af4432fa208b.jpg?jadewits_media_id=64673" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/e1ae271b1bb879f934073081f35c143e-6af4432fa208b.jpg?jadewits_media_id=64673" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/e1ae271b1bb879f934073081f35c143e-6af4432fa208b.jpg?jadewits_media_id=64673" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিদেশি দক্ষ কর্মীদের মার্কিন ভিসা স্পন্সরশিপ বন্ধ করছে আইবিএম" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাষ্ট্রের টেক জায়ান্ট আইবিএম কনসাল্টিং বিভাগে কর্মী নিয়োগের ক্ষেত্রে বড় পরিবর্তন আনছে। প্রতিষ্ঠানটি ঘোষণা দিয়েছে, তারা কনসাল্টিং ফার্মের অধিকাংশ পদের জন্য মার্কিন ভিসা ও গ্রিন কার্ড স্পন্সরশিপ দেওয়া বন্ধ করে দিচ্ছে। যেখানে বর্তমানে কর্মরত রয়েছেন ১ লাখ ৫০ হাজারের বেশি কর্মী।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/business/97479/%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF-%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8-%E0%A6%AD%E0%A6%BF%E0%A6%B8%E0%A6%BE-%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A6%A8%E0%A7%8D%E0%A6%B8%E0%A6%B0%E0%A6%B6%E0%A6%BF%E0%A6%AA-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7">একাত্তর</source>

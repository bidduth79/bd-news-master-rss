      <title>মিয়ানমারের জান্তাকে বাঁচিয়ে রাখার নেপথ্য সমীকরণ</title>
      <link>https://ekattor.tv/international/asia/98019/%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%81%E0%A6%9A%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%96%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A7%87%E0%A6%AA%E0%A6%A5%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A6%AE%E0%A7%80%E0%A6%95%E0%A6%B0%E0%A6%A3</link>
      <guid isPermaLink="true">https://ekattor.tv/international/asia/98019/%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%81%E0%A6%9A%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%96%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A7%87%E0%A6%AA%E0%A6%A5%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A6%AE%E0%A7%80%E0%A6%95%E0%A6%B0%E0%A6%A3</guid>
      <pubDate>Fri, 20 Nov 2026 01:53:25 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/94ab1315730ab768278655b6fea158e7-6aff521e90b39.jpg?jadewits_media_id=65425" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/94ab1315730ab768278655b6fea158e7-6aff521e90b39.jpg?jadewits_media_id=65425" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/94ab1315730ab768278655b6fea158e7-6aff521e90b39.jpg?jadewits_media_id=65425" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মিয়ানমারের জান্তাকে বাঁচিয়ে রাখার নেপথ্য সমীকরণ" /&gt;&lt;/p&gt;&lt;p&gt;মিয়ানমারের রাখাইন রাজ্যে রোহিঙ্গা গণহত্যা নিয়ে বিশ্ব আদালতে ঐতিহাসিক নৈতিক ও আইনি বিজয়ের পরও সবচেয়ে বড় প্রশ্ন হয়ে দাঁড়িয়েছে, এই রায় আদৌ বাস্তবায়িত হবে কি না। কারণ, আইসিজের নিজস্ব কোনো বলপ্রয়োগকারী বাহিনী নেই; তাদের আদেশ বাস্তবায়নের জন্য তা পাঠানো হয় জাতিসংঘের নিরাপত্তা পরিষদে। আর ঠিক এখানেই এসে থমকে&lt;/p&gt;</description>
      <source url="https://ekattor.tv/international/asia/98019/%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%81%E0%A6%9A%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%96%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A7%87%E0%A6%AA%E0%A6%A5%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A6%AE%E0%A7%80%E0%A6%95%E0%A6%B0%E0%A6%A3">একাত্তর</source>
    </item>
    <item>
      <title>জাতীয় বিশ্ববিদ্যালয়ের ১৭২ কর্মকর্তা-কর্মচারীর বিরুদ্ধে সন্ত্রাসবিরোধী আইনে মামলা</title>

      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/c920d4f7328a3c18871bd53f4526341f-6af616694d280.jpg?jadewits_media_id=64811" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাংলাদেশকে ৩০ মিলিয়ন ডলার অনুদান দিচ্ছে জলবায়ু তহবিল" /&gt;&lt;/p&gt;&lt;p&gt;তুরস্ক সফরে জলবায়ু কূটনীতিতে বড় ধরনের সাফল্য অর্জন করেছে বাংলাদেশ। দেশের জলবায়ু পরিবর্তন মোকাবিলা ও টেকসই উন্নয়নের লক্ষ্যে বাংলাদেশকে ৩০ মিলিয়ন মার্কিন ডলার অনুদান দেওয়ার ঘোষণা দিয়েছে জাতিসংঘের ‘ক্লাইমেট ইনভেস্ট ফান্ড’।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/national/97573/%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%95%E0%A7%87-%E0%A7%A9%E0%A7%A6-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%A8-%E0%A6%A1%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%A6%E0%A6%BE%E0%A6%A8-%E0%A6%A6%E0%A6%BF%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%9C%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A7%81">একাত্তর</source>
    </item>
    <item>
      <title>জলবায়ু ন্যায়বিচার ও টেকসই অর্থনীতির রূপরেখা</title>
      <link>https://ekattor.tv/national/97551/%E0%A6%9C%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A7%81-%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A6%AC%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%93-%E0%A6%9F%E0%A7%87%E0%A6%95%E0%A6%B8%E0%A6%87-%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%B0%E0%A7%82%E0%A6%AA%E0%A6%B0%E0%A7%87%E0%A6%96%E0%A6%BE</link>
      <guid isPermaLink="true">https://ekattor.tv/national/97551/%E0%A6%9C%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A7%81-%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A6%AC%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%93-%E0%A6%9F%E0%A7%87%E0%A6%95%E0%A6%B8%E0%A6%87-%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%B0%E0%A7%82%E0%A6%AA%E0%A6%B0%E0%A7%87%E0%A6%96%E0%A6%BE</guid>
      <pubDate>Fri, 13 Nov 2026 00:13:49 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/aecc6bdd2e2938fe5880f352bfcabe39-6af5bad677bf6.jpg?jadewits_media_id=64788" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/aecc6bdd2e2938fe5880f352bfcabe39-6af5bad677bf6.jpg?jadewits_media_id=64788" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/aecc6bdd2e2938fe5880f352bfcabe39-6af5bad677bf6.jpg?jadewits_media_id=64788" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জলবায়ু ন্যায়বিচার ও টেকসই অর্থনীতির রূপরেখা" /&gt;&lt;/p&gt;&lt;p&gt;তুরস্কের আনতালিয়ায় অনুষ্ঠিত জাতিসংঘ জলবায়ু পরিবর্তনবিষয়ক সম্মেলন (কপ-৩১)-এর উচ্চপর্যায়ের অধিবেশনে বাংলাদেশের প্রধানমন্ত্রী তারেক রহমান যে বক্তব্য প্রদান করেছেন, তা মূলত জলবায়ু ন্যায়বিচার, টেকসই অর্থনীতি এবং বৈশ্বিক সহযোগিতার এক অনন্য দলিল।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/national/97551/%E0%A6%9C%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A7%81-%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A6%AC%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%93-%E0%A6%9F%E0%A7%87%E0%A6%95%E0%A6%B8%E0%A6%87-%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%B0%E0%A7%82%E0%A6%AA%E0%A6%B0%E0%A7%87%E0%A6%96%E0%A6%BE">একাত্তর</source>
    </item>
    <item>
      <title>অবশেষে এনভিডিয়া থেকে সরে দাঁড়ালেন জেনসেন হুয়াং</title>

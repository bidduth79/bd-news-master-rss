      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/1c31bb204d77e7687f504804b4c3877f-6b0aea8b22207.jpg?jadewits_media_id=66230" length="0" type="image/jpeg" />

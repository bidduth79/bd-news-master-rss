    <item>
      <title>বিশ্বনেতাদের ভাষণে জলবায়ু ও বিদ্যুৎনির্ভর জ্বালানির রূপরেখা</title>
      <link>https://ekattor.tv/international/europe/97467/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AD%E0%A6%BE%E0%A6%B7%E0%A6%A3%E0%A7%87-%E0%A6%9C%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A7%81-%E0%A6%93-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A7%8E%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AD%E0%A6%B0</link>
      <guid isPermaLink="true">https://ekattor.tv/international/europe/97467/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AD%E0%A6%BE%E0%A6%B7%E0%A6%A3%E0%A7%87-%E0%A6%9C%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A7%81-%E0%A6%93-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A7%8E%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AD%E0%A6%B0</guid>
      <pubDate>Wed, 11 Nov 2026 14:14:05 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/44592c885af0909445e5927bdb4f451b-6af423c5d19dc.jpg?jadewits_media_id=64661" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/44592c885af0909445e5927bdb4f451b-6af423c5d19dc.jpg?jadewits_media_id=64661" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/44592c885af0909445e5927bdb4f451b-6af423c5d19dc.jpg?jadewits_media_id=64661" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিশ্বনেতাদের ভাষণে জলবায়ু ও বিদ্যুৎনির্ভর জ্বালানির রূপরেখা" /&gt;&lt;/p&gt;&lt;p&gt;তুরস্কের ভূমধ্যসাগরীয় শহর আন্তালিয়ায় আয়োজিত জাতিসংঘ বার্ষিক জলবায়ু সম্মেলনে (কপ-৩১) বুধবার থেকে শুরু হয়েছে বিশ্বনেতাদের হাই-লেভেল হাইলাইটস পর্ব। সম্মেলনে অংশ নেওয়া প্রায় ২০০টি দেশের প্রতিনিধিরা এমন এক সময়ে বৈঠকে বসেছেন, যখন বৈশ্বিক গ্রিনহাউস গ্যাস নির্গমন কমার কোনো জোরালো লক্ষণ নেই এবং বিশ্বজুড়ে&lt;/p&gt;</description>
      <source url="https://ekattor.tv/international/europe/97467/%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AD%E0%A6%BE%E0%A6%B7%E0%A6%A3%E0%A7%87-%E0%A6%9C%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A7%81-%E0%A6%93-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A7%8E%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AD%E0%A6%B0">একাত্তর</source>
    </item>
    <item>
      <title>ই-রিকশা চালকদের লাইসেন্স ও নিবন্ধন ফি পুনর্নির্ধারণসহ ৯ দাবি</title>
      <link>https://ekattor.tv/capital/97466/%E0%A6%87-%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%B6%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%95%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%B8%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%B8-%E0%A6%93-%E0%A6%A8%E0%A6%BF%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A6%A8-%E0%A6%AB%E0%A6%BF</link>
      <guid isPermaLink="true">https://ekattor.tv/capital/97466/%E0%A6%87-%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%B6%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%95%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%B8%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%B8-%E0%A6%93-%E0%A6%A8%E0%A6%BF%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A6%A8-%E0%A6%AB%E0%A6%BF</guid>
      <pubDate>Wed, 11 Nov 2026 14:06:14 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/6c936c4b95c5f38c0a045ea660e1a22d-6af421d440d71.jpg?jadewits_media_id=64660" length="0" type="image/jpeg" />

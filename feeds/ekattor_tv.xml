    <item>
      <title>‘নাৎসিদের মতো ফ্যাসিস্ট আওয়ামী শক্তিও আর ফিরতে পারবে না’</title>
      <link>https://ekattor.tv/national/97496/%E2%80%98%E0%A6%A8%E0%A6%BE%E0%A7%8E%E0%A6%B8%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%A4%E0%A7%8B-%E0%A6%AB%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%9F-%E0%A6%86%E0%A6%93%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%93-%E0%A6%86%E0%A6%B0-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A6%A4%E0%A7%87</link>
      <guid isPermaLink="true">https://ekattor.tv/national/97496/%E2%80%98%E0%A6%A8%E0%A6%BE%E0%A7%8E%E0%A6%B8%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%A4%E0%A7%8B-%E0%A6%AB%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%9F-%E0%A6%86%E0%A6%93%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%93-%E0%A6%86%E0%A6%B0-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A6%A4%E0%A7%87</guid>
      <pubDate>Wed, 11 Nov 2026 21:29:01 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/e45080f86c60b1b132b3f4cd88623b61-6af489a92ea02.jpg?jadewits_media_id=64698" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/e45080f86c60b1b132b3f4cd88623b61-6af489a92ea02.jpg?jadewits_media_id=64698" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/e45080f86c60b1b132b3f4cd88623b61-6af489a92ea02.jpg?jadewits_media_id=64698" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘নাৎসিদের মতো ফ্যাসিস্ট আওয়ামী শক্তিও আর ফিরতে পারবে না’" /&gt;&lt;/p&gt;&lt;p&gt;জার্মানিতে নাৎসি বাহিনী যেমন আর রাজনীতিতে ফিরতে পারেনি, ঠিক তেমনি গণঅভ্যুত্থানে পালিয়ে যাওয়া ফ্যাসিস্ট আওয়ামী শক্তি বাংলাদেশে আর কখনো ফিরে আসতে পারবে না বলে হুঁশিয়ারি দিয়েছেন স্বরাষ্ট্রমন্ত্রী সালাহউদ্দিন আহমদ।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/national/97496/%E2%80%98%E0%A6%A8%E0%A6%BE%E0%A7%8E%E0%A6%B8%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%A4%E0%A7%8B-%E0%A6%AB%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%9F-%E0%A6%86%E0%A6%93%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%93-%E0%A6%86%E0%A6%B0-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A6%A4%E0%A7%87">একাত্তর</source>
    </item>
    <item>
      <title>ঘুষ নেওয়ার ভিডিও ছড়িয়ে পড়ার ঘটনায় লক্ষ্মীপুরে পিডিবির প্রকৌশলী সাময়িক বরখাস্ত</title>
      <link>https://ekattor.tv/country/chittagong/97495/%E0%A6%98%E0%A7%81%E0%A6%B7-%E0%A6%A8%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%AD%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A6%93-%E0%A6%9B%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AA%E0%A7%9C%E0%A6%BE%E0%A6%B0-%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%B2%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8D%E0%A6%AE%E0%A7%80%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87</link>
      <guid isPermaLink="true">https://ekattor.tv/country/chittagong/97495/%E0%A6%98%E0%A7%81%E0%A6%B7-%E0%A6%A8%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%AD%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A6%93-%E0%A6%9B%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AA%E0%A7%9C%E0%A6%BE%E0%A6%B0-%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%B2%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8D%E0%A6%AE%E0%A7%80%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87</guid>
      <pubDate>Wed, 11 Nov 2026 20:01:56 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/081cbef9c3a61a547c34d525ff21f410-6af4751be1d67.jpg?jadewits_media_id=64697" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/081cbef9c3a61a547c34d525ff21f410-6af4751be1d67.jpg?jadewits_media_id=64697" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/081cbef9c3a61a547c34d525ff21f410-6af4751be1d67.jpg?jadewits_media_id=64697" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঘুষ নেওয়ার ভিডিও ছড়িয়ে পড়ার ঘটনায় লক্ষ্মীপুরে পিডিবির প্রকৌশলী সাময়িক বরখাস্ত" /&gt;&lt;/p&gt;&lt;p&gt;বিদ্যুৎ সংযোগ ও মিটার দেওয়ার নামে ঘুষ হিসেবে নগদ অর্থ গ্রহণের ভিডিও সামাজিক যোগাযোগমাধ্যমে ছড়িয়ে পড়ার পর বাংলাদেশ বিদ্যুৎ উন্নয়ন বোর্ডের (পিডিবি) লক্ষ্মীপুর বিক্রয় ও বিতরণ বিভাগের উপসহকারী প্রকৌশলী ইফতে খাইরুল ইসলামকে সাময়িক বরখাস্ত করা হয়েছে।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/country/chittagong/97495/%E0%A6%98%E0%A7%81%E0%A6%B7-%E0%A6%A8%E0%A7%87%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%AD%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A6%93-%E0%A6%9B%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AA%E0%A7%9C%E0%A6%BE%E0%A6%B0-%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%B2%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8D%E0%A6%AE%E0%A7%80%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87">একাত্তর</source>
    </item>
    <item>
      <title>চেকপোস্ট, টহল ও তল্লাশিতে কড়াকড়ি বাড়ালো ডিএমপি</title>
      <link>https://ekattor.tv/capital/97494/%E0%A6%9A%E0%A7%87%E0%A6%95%E0%A6%AA%E0%A7%8B%E0%A6%B8%E0%A7%8D%E0%A6%9F-%E0%A6%9F%E0%A6%B9%E0%A6%B2-%E0%A6%93-%E0%A6%A4%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%B6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A7%9C%E0%A6%BE%E0%A6%95%E0%A7%9C%E0%A6%BF-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%B2%E0%A7%8B-%E0%A6%A1%E0%A6%BF%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF</link>
      <guid isPermaLink="true">https://ekattor.tv/capital/97494/%E0%A6%9A%E0%A7%87%E0%A6%95%E0%A6%AA%E0%A7%8B%E0%A6%B8%E0%A7%8D%E0%A6%9F-%E0%A6%9F%E0%A6%B9%E0%A6%B2-%E0%A6%93-%E0%A6%A4%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%B6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A7%9C%E0%A6%BE%E0%A6%95%E0%A7%9C%E0%A6%BF-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%B2%E0%A7%8B-%E0%A6%A1%E0%A6%BF%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF</guid>
      <pubDate>Wed, 11 Nov 2026 19:00:03 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/0bfa508dfd8f7f096fec20d6a94d02dd-6af466c922b40.jpg?jadewits_media_id=64695" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/0bfa508dfd8f7f096fec20d6a94d02dd-6af466c922b40.jpg?jadewits_media_id=64695" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/0bfa508dfd8f7f096fec20d6a94d02dd-6af466c922b40.jpg?jadewits_media_id=64695" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চেকপোস্ট, টহল ও তল্লাশিতে কড়াকড়ি বাড়ালো ডিএমপি" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীবাসীর জানমালের নিরাপত্তা নিশ্চিত করতে এবং অপরাধমূলক কর্মকাণ্ড কঠোরভাবে প্রতিরোধ করতে বিশেষ নিরাপত্তা ব্যবস্থা গ্রহণ করেছে ঢাকা মহানগর পুলিশ (ডিএমপি)। গুরুত্বপূর্ণ প্রবেশপথ, প্রধান সড়ক এবং অপরাধপ্রবণ এলাকাগুলোতে চেকপোস্ট বসানোর পাশাপাশি বাড়ানো হয়েছে পুলিশি টহল ও নজরদারি।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/capital/97494/%E0%A6%9A%E0%A7%87%E0%A6%95%E0%A6%AA%E0%A7%8B%E0%A6%B8%E0%A7%8D%E0%A6%9F-%E0%A6%9F%E0%A6%B9%E0%A6%B2-%E0%A6%93-%E0%A6%A4%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%B6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%95%E0%A7%9C%E0%A6%BE%E0%A6%95%E0%A7%9C%E0%A6%BF-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%B2%E0%A7%8B-%E0%A6%A1%E0%A6%BF%E0%A6%8F%E0%A6%AE%E0%A6%AA%E0%A6%BF">একাত্তর</source>
    </item>

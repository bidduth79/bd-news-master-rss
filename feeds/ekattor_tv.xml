      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/120e2a4ac1eb98cba345aa34eec32405-6af339ba3bf9b.jpg?jadewits_media_id=64615" length="0" type="image/jpeg" />

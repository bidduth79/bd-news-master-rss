      <guid isPermaLink="true">https://ekattor.tv/international/asia/98296/%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A7%9F-%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%A8-%E0%A6%A4%E0%A6%A5%E0%A7%8D%E0%A6%AF-%E0%A6%AA%E0%A6%BE%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%9A%E0%A7%80%E0%A6%A8%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Mon, 23 Nov 2026 20:12:57 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/3053791aab4e9a273f4f46a800883d7d-6b0449dcdd3f7.jpg?jadewits_media_id=65780" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/3053791aab4e9a273f4f46a800883d7d-6b0449dcdd3f7.jpg?jadewits_media_id=65780" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/3053791aab4e9a273f4f46a800883d7d-6b0449dcdd3f7.jpg?jadewits_media_id=65780" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাষ্ট্রীয় গোপন তথ্য পাচারে চীনা কর্মকর্তার মৃত্যুদণ্ড" /&gt;&lt;/p&gt;&lt;p&gt;বিদেশি একটি রাষ্ট্রের কাছে রাষ্ট্রীয় গোপন তথ্য পাচারের দায়ে কেন্দ্রীয় প্রশাসনের এক কর্মকর্তাকে মৃত্যুদণ্ড দিয়েছে চীন। সোমবার দেশটির রাষ্ট্রীয় গোপনীয়তা রক্ষা বিষয়ক জাতীয় প্রশাসনের পরিচালিত সামাজিক যোগাযোগমাধ্যম অ্যাকাউন্ট ‘বাওমিগুয়ান’-এ প্রকাশিত এক প্রতিবেদনে এ তথ্য জানানো হয়।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/international/asia/98296/%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A7%9F-%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%A8-%E0%A6%A4%E0%A6%A5%E0%A7%8D%E0%A6%AF-%E0%A6%AA%E0%A6%BE%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%9A%E0%A7%80%E0%A6%A8%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0">একাত্তর</source>
    </item>
    <item>
      <title>ধর্মঘটে স্থবির বেলজিয়াম, বাতিল শত শত ফ্লাইট</title>

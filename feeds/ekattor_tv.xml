      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/934c00fdcc08c2db37180b311e43085c-6af5c6228631b.jpg?jadewits_media_id=64800" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/934c00fdcc08c2db37180b311e43085c-6af5c6228631b.jpg?jadewits_media_id=64800" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/934c00fdcc08c2db37180b311e43085c-6af5c6228631b.jpg?jadewits_media_id=64800" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ব্রুকলিনে বিধ্বস্ত ভবনের ধ্বংসস্তূপ থেকে গর্ভবতী নারী উদ্ধার" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাষ্ট্রের নিউইয়র্কের ব্রুকলিনে একটি তিনতলা আবাসিক ভবন ধসে পড়ার মর্মান্তিক ঘটনায় অন্তত আটজনের প্রাণহানি ঘটেছে। স্থানীয় সময় বুধবার বিকেল চারটার দিকে ব্রুকলিনের বেডফোর্ড এভিনিউতে ঘটে যাওয়া এই দুর্ঘটনায় তিন ফায়ারফাইটারসহ অন্তত ১৭ জন আহত হয়েছেন। তবে ধ্বংসস্তূপের ভেতর থেকে অলৌকিকভাবে এক গর্ভবতী নারী&lt;/p&gt;</description>
      <source url="https://ekattor.tv/international/america/97559/%E0%A6%AC%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%95%E0%A6%B2%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%A7%E0%A7%8D%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A4-%E0%A6%AD%E0%A6%AC%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A7%E0%A7%8D%E0%A6%AC%E0%A6%82%E0%A6%B8%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%82%E0%A6%AA-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%97%E0%A6%B0%E0%A7%8D%E0%A6%AD%E0%A6%AC%E0%A6%A4%E0%A7%80">একাত্তর</source>
    </item>

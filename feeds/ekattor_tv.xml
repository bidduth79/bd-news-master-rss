      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/473aa4229e1e9cd47cc5aca0f2930769-6b02f9c167bfc.jpg?jadewits_media_id=65682" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বগুড়ায় ‘পাকা ধানে আকভানের মই’, ক্ষতিতে ৮৫০০ কৃষক" /&gt;&lt;/p&gt;&lt;p&gt;ঘূর্ণিঝড় আকভানের প্রভাবে দুই দিনের টানা গুঁড়ি গুঁড়ি বৃষ্টিতে বগুড়ায় পাকা আমন ধানসহ এক হাজার ৫৪১ হেক্টর জমির ফসল ক্ষতিগ্রস্ত হয়েছে। এর মধ্যে সবচেয়ে বেশি ক্ষতিগ্রস্ত হয়েছে আমন ধান; অনেক জমির কেটে রাখা ধান পানির নিচে তলিয়ে গেছে। এতে জেলায় আট হাজার ৪৯১ জন কৃষক ক্ষতিগ্রস্ত হয়েছেন বলে জানিয়েছে &lt;/p&gt;</description>
      <source url="https://ekattor.tv/country/rajshahi/98220/%E0%A6%AC%E0%A6%97%E0%A7%81%E0%A6%A1%E0%A6%BC%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E2%80%98%E0%A6%AA%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%95%E0%A6%AD%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%87%E2%80%99-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A7%AE%E0%A7%AB%E0%A7%A6%E0%A7%A6-%E0%A6%95%E0%A7%83%E0%A6%B7%E0%A6%95">একাত্তর</source>
    </item>
    <item>
      <title>আকভানে বাগেরহাটে ফসলের ক্ষতি ১০৪ কোটি টাকা</title>
      <link>https://ekattor.tv/country/khulna/98218/%E0%A6%86%E0%A6%95%E0%A6%AD%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%97%E0%A7%87%E0%A6%B0%E0%A6%B9%E0%A6%BE%E0%A6%9F%E0%A7%87-%E0%A7%AA%E0%A7%A9%E0%A7%AC-%E0%A6%B9%E0%A7%87%E0%A6%95%E0%A7%8D%E0%A6%9F%E0%A6%B0-%E0%A6%9C%E0%A6%AE%E0%A6%BF%E0%A6%B0-%E0%A6%AB%E0%A6%B8%E0%A6%B2-%E0%A6%86%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4</link>
      <guid isPermaLink="true">https://ekattor.tv/country/khulna/98218/%E0%A6%86%E0%A6%95%E0%A6%AD%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%97%E0%A7%87%E0%A6%B0%E0%A6%B9%E0%A6%BE%E0%A6%9F%E0%A7%87-%E0%A7%AA%E0%A7%A9%E0%A7%AC-%E0%A6%B9%E0%A7%87%E0%A6%95%E0%A7%8D%E0%A6%9F%E0%A6%B0-%E0%A6%9C%E0%A6%AE%E0%A6%BF%E0%A6%B0-%E0%A6%AB%E0%A6%B8%E0%A6%B2-%E0%A6%86%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4</guid>

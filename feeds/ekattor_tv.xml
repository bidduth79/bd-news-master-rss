      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/eb196ebfc89c7ef4be841b555580ef9f-6afb662a82ac0.jpg?jadewits_media_id=65133" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/eb196ebfc89c7ef4be841b555580ef9f-6afb662a82ac0.jpg?jadewits_media_id=65133" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মিরপুরে বাসে আগুন দিয়ে পালানোর সময় গ্রেপ্তার দুই" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর মিরপুর-১ বাসস্ট্যান্ড এলাকায় সড়কের পাশে দাঁড়িয়ে থাকা রাজধানী পরিবহনের একটি যাত্রীবাহী বাসে আগুন দিয়েছে দুর্বৃত্তরা। সোমবার, রাত ১০টা ৫ মিনিটের দিকে মিরপুর মডেল থানাধীন ওই বাসস্ট্যান্ডের পাকা সড়কে এই নাশকতার ঘটনা ঘটে। তবে আগুন দিয়ে পালিয়ে যাওয়ার সময় ঘটনাস্থল থেকেই দুজনকে গ্রেপ্তার করতে সক্ষম&lt;/p&gt;</description>
      <source url="https://ekattor.tv/capital/97810/%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A7%8B%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A7%9F-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%87">একাত্তর</source>

    <item>
      <title>‘শেখ হাসিনাকে হাতকড়া পরিয়ে ভারত থেকে দেশে আনা হবে’</title>
      <link>https://ekattor.tv/country/dhaka/98586/%E2%80%98%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A6%95%E0%A7%9C%E0%A6%BE-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%86%E0%A6%A8%E0%A6%BE-%E0%A6%B9%E0%A6%AC%E0%A7%87%E2%80%99</link>
      <guid isPermaLink="true">https://ekattor.tv/country/dhaka/98586/%E2%80%98%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A6%95%E0%A7%9C%E0%A6%BE-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%86%E0%A6%A8%E0%A6%BE-%E0%A6%B9%E0%A6%AC%E0%A7%87%E2%80%99</guid>
      <pubDate>Fri, 27 Nov 2026 18:20:41 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/a9a86fb5b1c69b763f88786d86a744d7-6b09758480da5.jpg?jadewits_media_id=66146" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/a9a86fb5b1c69b763f88786d86a744d7-6b09758480da5.jpg?jadewits_media_id=66146" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/a9a86fb5b1c69b763f88786d86a744d7-6b09758480da5.jpg?jadewits_media_id=66146" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘শেখ হাসিনাকে হাতকড়া পরিয়ে ভারত থেকে দেশে আনা হবে’" /&gt;&lt;/p&gt;&lt;p&gt;প্রধানমন্ত্রীর ডাকা জাতীয় ঐক্য রাজপথে ভারতীয় আধিপত্যের বিরুদ্ধে হতে হবে বলে মন্তব্য করেছেন জাতীয় নাগরিক পার্টির (এনসিপি) নেতারা। তারা বলেন, শেখ হাসিনা নিজে থেকে দেশে আসবেন না, বরং তাকে হাতকড়া পরিয়ে ভারত থেকে দেশে ফিরিয়ে আনা হবে।						বিস্তারিত&lt;/p&gt;</description>

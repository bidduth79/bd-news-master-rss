      <guid isPermaLink="true">https://ekattor.tv/international/middle-east/97575/%E0%A6%86%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%87%E0%A6%9F%E0%A6%BF-%E0%A6%B8%E0%A7%9C%E0%A6%95-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A7%A7%E0%A7%AD-%E0%A6%86%E0%A6%B9%E0%A6%A4-%E0%A7%A9%E0%A7%A6</guid>
      <pubDate>Fri, 13 Nov 2026 02:05:27 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/a542d866454596682a151a0d073f0c4c-6af61bfb21d9f.jpg?jadewits_media_id=64812" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/a542d866454596682a151a0d073f0c4c-6af61bfb21d9f.jpg?jadewits_media_id=64812" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/a542d866454596682a151a0d073f0c4c-6af61bfb21d9f.jpg?jadewits_media_id=64812" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আমিরাতে দুইটি সড়ক দুর্ঘটনায় নিহত ১৭, আহত ৩০" /&gt;&lt;/p&gt;&lt;p&gt;সংযুক্ত আরব আমিরাতের ফুজাইরাহতে আলাদা দুটি ভয়াবহ সড়ক দুর্ঘটনায় একই পরিবারের তিন প্রবাসীসহ অন্তত ১৭ জন নিহত হয়েছেন। বৃহস্পতিবার ঘটে যাওয়া মর্মান্তিক এসব দুর্ঘটনায় অন্তত সাতটি দেশের ৩০ জন নাগরিক গুরুতর আহত হয়েছেন। মধ্যপ্রাচ্যের প্রভাবশালী সংবাদমাধ্যম খালিজ টাইমসের এক প্রতিবেদনে এই হৃদয়বিদারক তথ্য উঠে &lt;/p&gt;</description>
      <source url="https://ekattor.tv/international/middle-east/97575/%E0%A6%86%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%87%E0%A6%9F%E0%A6%BF-%E0%A6%B8%E0%A7%9C%E0%A6%95-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A7%A7%E0%A7%AD-%E0%A6%86%E0%A6%B9%E0%A6%A4-%E0%A7%A9%E0%A7%A6">একাত্তর</source>
    </item>

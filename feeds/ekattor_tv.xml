      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/187cc543390345dbbc8b8c5430c2f276-6b09c2c9043b0.jpg?jadewits_media_id=66167" length="0" type="image/jpeg" />

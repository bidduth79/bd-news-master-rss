      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/6f2662050d86502ea47e1c34bdaace56-6b048f3a06d77.jpg?jadewits_media_id=65784" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সেঞ্চুরিয়নে প্রথমবার দুই অঙ্কে অলআউট কোনো দল" /&gt;&lt;/p&gt;&lt;p&gt;সেঞ্চুরিয়ন টেস্টের প্রথম দিনেই দক্ষিণ আফ্রিকার নিখুঁত ও বিধ্বংসী বোলিং আক্রমণের সামনে তাসের ঘরের মতো ভেঙে পড়ল বাংলাদেশের ব্যাটিং লাইনআপ। প্রোটিয়া পেসারদের তোপে মাত্র ৯১ রানেই গুটিয়ে গেছে সফরকারীরা, যা সেঞ্চুরিয়নের সুপারস্পোর্ট পার্কের ইতিহাসে কোনো দলের প্রথমবার দুই অঙ্কের ঘরে অলআউট হওয়ার লজ্জার রেকর&lt;/p&gt;</description>
      <source url="https://ekattor.tv/sports/cricket/98298/%E0%A6%B8%E0%A7%87%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%A8%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%85%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A7%87-%E0%A6%85%E0%A6%B2%E0%A6%86%E0%A6%89%E0%A6%9F-%E0%A6%95%E0%A7%8B%E0%A6%A8%E0%A7%8B-%E0%A6%A6%E0%A6%B2">একাত্তর</source>

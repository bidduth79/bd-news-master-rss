    <item>
      <title>জর্ডানে গির্জা হামলায় তিন জঙ্গির মৃত্যুদণ্ড</title>
      <link>https://ekattor.tv/international/middle-east/97734/%E0%A6%9C%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%97%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A6%BE-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%9C%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BF%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A6%A3%E0%A7%8D%E0%A6%A1</link>
      <guid isPermaLink="true">https://ekattor.tv/international/middle-east/97734/%E0%A6%9C%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%97%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A6%BE-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%9C%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BF%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A6%A3%E0%A7%8D%E0%A6%A1</guid>
      <pubDate>Sun, 15 Nov 2026 20:35:06 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/a4b52b703b0e742b9292fb5cc194e767-6af9c310de18e.jpg?jadewits_media_id=65026" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/a4b52b703b0e742b9292fb5cc194e767-6af9c310de18e.jpg?jadewits_media_id=65026" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/a4b52b703b0e742b9292fb5cc194e767-6af9c310de18e.jpg?jadewits_media_id=65026" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জর্ডানে গির্জা হামলায় তিন জঙ্গির মৃত্যুদণ্ড" /&gt;&lt;/p&gt;&lt;p&gt;জর্ডানের দক্ষিণাঞ্চলীয় কারাক গভর্নরেটের একটি গির্জায় বর্বরোচিত সন্ত্রাসী হামলা চালিয়ে ৯ জনকে হত্যার ঘটনায় তিন অভিযুক্তকে ফাঁসির আদেশ দিয়েছে দেশটির স্টেট সিকিউরিটি কোর্ট। রবিবার (১৫ নভেম্বর) রাষ্ট্রীয় বার্তা সংস্থা পেত্রা’র বরাত দিয়ে এই চাঞ্চল্যকর তথ্য জানানো হয়। গত মাসে ঘটা এই নৃশংস হত্যাকাণ্ডে পুর&lt;/p&gt;</description>
      <source url="https://ekattor.tv/international/middle-east/97734/%E0%A6%9C%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%97%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A6%BE-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%9C%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BF%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A6%A3%E0%A7%8D%E0%A6%A1">একাত্তর</source>

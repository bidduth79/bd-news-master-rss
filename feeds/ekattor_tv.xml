    <item>
      <title>মামলায় মৃত ব্যক্তির নাম, পুলিশ বলছে ভুল</title>
      <link>https://ekattor.tv/country/dhaka/97630/%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A7%83%E0%A6%A4-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%AC%E0%A6%B2%E0%A6%9B%E0%A7%87-%E0%A6%AD%E0%A7%81%E0%A6%B2</link>
      <guid isPermaLink="true">https://ekattor.tv/country/dhaka/97630/%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A7%83%E0%A6%A4-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%AC%E0%A6%B2%E0%A6%9B%E0%A7%87-%E0%A6%AD%E0%A7%81%E0%A6%B2</guid>
      <pubDate>Sat, 14 Nov 2026 15:43:13 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/c9ae4e8bfa8b59c56e14d6ed789cfd0f-6af82cf3505b9.jpg?jadewits_media_id=64899" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/c9ae4e8bfa8b59c56e14d6ed789cfd0f-6af82cf3505b9.jpg?jadewits_media_id=64899" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/c9ae4e8bfa8b59c56e14d6ed789cfd0f-6af82cf3505b9.jpg?jadewits_media_id=64899" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মামলায় মৃত ব্যক্তির নাম, পুলিশ বলছে ভুল" /&gt;&lt;/p&gt;&lt;p&gt;পদ্মা সেতুর দক্ষিণ প্রান্তের টোলপ্লাজায় সড়ক অবরোধ, ভাঙচুর ও ককটেল বিস্ফোরণের ঘটনায় করা একটি মামলায় মৃত এক ব্যক্তিকে আসামি করার চাঞ্চল্যকর তথ্য সামনে এসেছে। মৃত্যুর প্রায় সাড়ে সাত মাস পর মামলার এজাহারে নাম এসেছে বীর মুক্তিযোদ্ধা ও আওয়ামী লীগ নেতা সামচু ঢালীর। এ ঘটনায় এলাকায় ব্যাপক আলোচনার সৃষ্টি হয়ে&lt;/p&gt;</description>
      <source url="https://ekattor.tv/country/dhaka/97630/%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A7%83%E0%A6%A4-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%AC%E0%A6%B2%E0%A6%9B%E0%A7%87-%E0%A6%AD%E0%A7%81%E0%A6%B2">একাত্তর</source>
    </item>

      <guid isPermaLink="true">https://ekattor.tv/national/97583/%E0%A6%86%E0%A6%9C-%E0%A6%AC%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF-%E0%A6%B9%E0%A6%AC%E0%A7%87-%E0%A6%95%E0%A6%BF-%E0%A6%A8%E0%A6%BE-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B2-%E0%A6%86%E0%A6%AC%E0%A6%B9%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%85%E0%A6%A7%E0%A6%BF%E0%A6%A6%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%B0</guid>
      <pubDate>Fri, 13 Nov 2026 11:13:29 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/1b9a53a66dde0121ca43bfbdb35f16a1-6af69c6160203.jpg?jadewits_media_id=64825" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/1b9a53a66dde0121ca43bfbdb35f16a1-6af69c6160203.jpg?jadewits_media_id=64825" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/1b9a53a66dde0121ca43bfbdb35f16a1-6af69c6160203.jpg?jadewits_media_id=64825" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আজ বৃষ্টি হবে কি না, জানাল আবহাওয়া অধিদপ্তর" /&gt;&lt;/p&gt;&lt;p&gt;সারা দেশে আজ বৃষ্টির কোনো সম্ভাবনা নেই। আকাশ অস্থায়ীভাবে আংশিক মেঘলা থাকলেও দেশের আবহাওয়া প্রধানত শুষ্ক থাকতে পারে। একই সঙ্গে দিন ও রাতের তাপমাত্রা প্রায় অপরিবর্তিত থাকার পূর্বাভাস দিয়েছে আবহাওয়া অধিদপ্তর।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/national/97583/%E0%A6%86%E0%A6%9C-%E0%A6%AC%E0%A7%83%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BF-%E0%A6%B9%E0%A6%AC%E0%A7%87-%E0%A6%95%E0%A6%BF-%E0%A6%A8%E0%A6%BE-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B2-%E0%A6%86%E0%A6%AC%E0%A6%B9%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%85%E0%A6%A7%E0%A6%BF%E0%A6%A6%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%B0">একাত্তর</source>
    </item>
    <item>
      <title>নদী রক্ষায় রীতিমতো যুদ্ধ করতে হচ্ছে: নৌপরিবহনমন্ত্রী</title>
      <link>https://ekattor.tv/national/97582/%E0%A6%A8%E0%A6%A6%E0%A7%80-%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A7%9F-%E0%A6%B0%E0%A7%80%E0%A6%A4%E0%A6%BF%E0%A6%AE%E0%A6%A4%E0%A7%8B-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87</link>
      <guid isPermaLink="true">https://ekattor.tv/national/97582/%E0%A6%A8%E0%A6%A6%E0%A7%80-%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A7%9F-%E0%A6%B0%E0%A7%80%E0%A6%A4%E0%A6%BF%E0%A6%AE%E0%A6%A4%E0%A7%8B-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87</guid>
      <pubDate>Fri, 13 Nov 2026 10:54:41 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/d12b3bbe76cf31e5d42cf7a76f514c47-6af69808673a8.jpg?jadewits_media_id=64824" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/d12b3bbe76cf31e5d42cf7a76f514c47-6af69808673a8.jpg?jadewits_media_id=64824" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/d12b3bbe76cf31e5d42cf7a76f514c47-6af69808673a8.jpg?jadewits_media_id=64824" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নদী রক্ষায় রীতিমতো যুদ্ধ করতে হচ্ছে: নৌপরিবহনমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;নদী দখল ও দূষণকারীদের বিরুদ্ধে সরকার লড়াই চালিয়ে যাচ্ছে বলে জানিয়েছেন সড়ক পরিবহন ও সেতু, রেলপথ এবং নৌপরিবহনমন্ত্রী শেখ রবিউল আলম। ঢাকা ও সারা দেশের নদীগুলোর সৌন্দর্য ও পরিবেশ ফিরিয়ে আনতে সরকার নানা উদ্যোগ নিয়েছে বলেও জানান তিনি।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/national/97582/%E0%A6%A8%E0%A6%A6%E0%A7%80-%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A7%9F-%E0%A6%B0%E0%A7%80%E0%A6%A4%E0%A6%BF%E0%A6%AE%E0%A6%A4%E0%A7%8B-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87">একাত্তর</source>
    </item>
    <item>
      <title>নুসরাত তাবাসসুমের বাড়িতে যাচ্ছে বিরোধী দলীয় সংসদীয় টিম</title>

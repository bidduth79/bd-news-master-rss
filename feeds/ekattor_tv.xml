    <item>
      <title>মৌসুমের প্রথম হার বায়ার্ন মিউনিখের</title>
      <link>https://ekattor.tv/sports/football/98487/%E0%A6%AE%E0%A7%8C%E0%A6%B8%E0%A7%81%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%B9%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A8-%E0%A6%AE%E0%A6%BF%E0%A6%89%E0%A6%A8%E0%A6%BF%E0%A6%96%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://ekattor.tv/sports/football/98487/%E0%A6%AE%E0%A7%8C%E0%A6%B8%E0%A7%81%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%B9%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A8-%E0%A6%AE%E0%A6%BF%E0%A6%89%E0%A6%A8%E0%A6%BF%E0%A6%96%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Thu, 26 Nov 2026 10:39:47 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/73055ae4546206d9668faa3e7c14b003-6b07b560a553b.jpg?jadewits_media_id=66031" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/73055ae4546206d9668faa3e7c14b003-6b07b560a553b.jpg?jadewits_media_id=66031" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/73055ae4546206d9668faa3e7c14b003-6b07b560a553b.jpg?jadewits_media_id=66031" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মৌসুমের প্রথম হার বায়ার্ন মিউনিখের" /&gt;&lt;/p&gt;&lt;p&gt;উয়েফা চ্যাম্পিয়ন্স লিগে অপ্রত্যাশিত ধাক্কা খেল বায়ার্ন মিউনিখ। বৃহস্পতিবার (২৬ নভেম্বর) ভোরে লিগ পর্বের পঞ্চম রাউন্ডে ফরাসি ক্লাব লিলের কাছে ২–১ গোলে হেরেছে বায়ার্ন মিউনিখ। এর মধ্য দিয়ে ২০২৬–২৭ মৌসুমে প্রথম পরাজয়ের স্বাদ পেল দলটি।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/sports/football/98487/%E0%A6%AE%E0%A7%8C%E0%A6%B8%E0%A7%81%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%B9%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A8-%E0%A6%AE%E0%A6%BF%E0%A6%89%E0%A6%A8%E0%A6%BF%E0%A6%96%E0%A7%87%E0%A6%B0">একাত্তর</source>
    </item>

    <item>
      <title>ঢাকাজুড়ে ২৫০ চেকপোস্টে তল্লাশি, আটক ১৫</title>
      <link>https://ekattor.tv/capital/97399/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%9C%E0%A7%81%E0%A6%A1%E0%A6%BC%E0%A7%87-%E0%A7%A8%E0%A7%AB%E0%A7%A6-%E0%A6%9A%E0%A7%87%E0%A6%95%E0%A6%AA%E0%A7%8B%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%87-%E0%A6%A4%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%B6%E0%A6%BF-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A7%A7%E0%A7%AB</link>
      <guid isPermaLink="true">https://ekattor.tv/capital/97399/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%9C%E0%A7%81%E0%A6%A1%E0%A6%BC%E0%A7%87-%E0%A7%A8%E0%A7%AB%E0%A7%A6-%E0%A6%9A%E0%A7%87%E0%A6%95%E0%A6%AA%E0%A7%8B%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%87-%E0%A6%A4%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%B6%E0%A6%BF-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A7%A7%E0%A7%AB</guid>
      <pubDate>Mon, 09 Nov 2026 21:48:24 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/09/5f31888e0548ef3332b1988c123d2372-6af1eb39ef2cb.jpg?jadewits_media_id=64568" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/09/5f31888e0548ef3332b1988c123d2372-6af1eb39ef2cb.jpg?jadewits_media_id=64568" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/09/5f31888e0548ef3332b1988c123d2372-6af1eb39ef2cb.jpg?jadewits_media_id=64568" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঢাকাজুড়ে ২৫০ চেকপোস্টে তল্লাশি, আটক ১৫" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানী জুড়ে কয়েক দিন ধরে চলা ধারাবাহিক ও সিরিজ ককটেল বিস্ফোরণ এবং বাসে অগ্নিসংযোগের ঘটনার প্রেক্ষাপটে কঠোর নিরাপত্তা ব্যবস্থা গ্রহণ করেছে ঢাকা মেট্রোপলিটন পুলিশ (ডিএমপি)। রাজধানী জুড়ে নজিরবিহীন নিরাপত্তা বলয় তৈরি করে শহরের গুরুত্বপূর্ণ সড়ক, গুরুত্বপূর্ণ মোড় ও কৌশলগত স্থানগুলোতে বসানো হয়েছে অ&lt;/p&gt;</description>
      <source url="https://ekattor.tv/capital/97399/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%9C%E0%A7%81%E0%A6%A1%E0%A6%BC%E0%A7%87-%E0%A7%A8%E0%A7%AB%E0%A7%A6-%E0%A6%9A%E0%A7%87%E0%A6%95%E0%A6%AA%E0%A7%8B%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%87-%E0%A6%A4%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%B6%E0%A6%BF-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A7%A7%E0%A7%AB">একাত্তর</source>
    </item>

    <item>
      <title>৯ ও ১৫ মাসে কোরআনের হাফেজ দুই শিশু!</title>
      <link>https://ekattor.tv/country/chittagong/98071/%E0%A7%AF-%E0%A6%93-%E0%A7%A7%E0%A7%AB-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%95%E0%A7%8B%E0%A6%B0%E0%A6%86%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%AB%E0%A7%87%E0%A6%9C-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81</link>
      <guid isPermaLink="true">https://ekattor.tv/country/chittagong/98071/%E0%A7%AF-%E0%A6%93-%E0%A7%A7%E0%A7%AB-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%95%E0%A7%8B%E0%A6%B0%E0%A6%86%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%AB%E0%A7%87%E0%A6%9C-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81</guid>
      <pubDate>Fri, 20 Nov 2026 22:32:46 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/697522103f5806b782b48cd8d14d007e-6b007615ad2a5.jpg?jadewits_media_id=65495" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/697522103f5806b782b48cd8d14d007e-6b007615ad2a5.jpg?jadewits_media_id=65495" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/20/697522103f5806b782b48cd8d14d007e-6b007615ad2a5.jpg?jadewits_media_id=65495" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৯ ও ১৫ মাসে কোরআনের হাফেজ দুই শিশু!" /&gt;&lt;/p&gt;&lt;p&gt;অধ্যবসায়, ধৈর্য আর অদম্য সাধনার এক উজ্জ্বল দৃষ্টান্ত গড়েছে চাঁদপুরের দুই কোমলমতি শিক্ষার্থী। কচি বয়সেই পবিত্র কোরআনের ৩০ পারা মুখস্থ করে হাফেজ হওয়ার গৌরব অর্জন করেছে তারা। মাত্র ৯ মাস ১০ দিন এবং ১৪ মাসের নিরলস সাধনায় এই অসাধারণ কৃতিত্ব দেখানো একই মাদরাসার দুই শিক্ষার্থীর সাফল্যে আনন্দে ভাসছে তাঁদের &lt;/p&gt;</description>
      <source url="https://ekattor.tv/country/chittagong/98071/%E0%A7%AF-%E0%A6%93-%E0%A7%A7%E0%A7%AB-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%95%E0%A7%8B%E0%A6%B0%E0%A6%86%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%AB%E0%A7%87%E0%A6%9C-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81">একাত্তর</source>
    </item>
    <item>
      <title>নির্বাচনে হেরে ভয়ঙ্কর খেলায় মেতেছেন নেতানিয়াহু</title>

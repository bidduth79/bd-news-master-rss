      <link>https://ekattor.tv/others/97662/%E0%A6%A1%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%9F%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%9D%E0%A7%81%E0%A6%81%E0%A6%95%E0%A6%BF-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A7%9F-%E0%A6%93-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%86%E0%A6%B8%E0%A6%9B%E0%A7%87</link>
      <guid isPermaLink="true">https://ekattor.tv/others/97662/%E0%A6%A1%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%9F%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%9D%E0%A7%81%E0%A6%81%E0%A6%95%E0%A6%BF-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A7%9F-%E0%A6%93-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%86%E0%A6%B8%E0%A6%9B%E0%A7%87</guid>
      <pubDate>Sat, 14 Nov 2026 21:15:26 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/710ef729b19b4569bb606a83768fcdad-6af87b0558ef4.jpg?jadewits_media_id=64933" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/710ef729b19b4569bb606a83768fcdad-6af87b0558ef4.jpg?jadewits_media_id=64933" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/710ef729b19b4569bb606a83768fcdad-6af87b0558ef4.jpg?jadewits_media_id=64933" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডায়াবেটিসের ঝুঁকি নির্ণয় ও নিয়ন্ত্রণে আসছে ‘ডায়াবেটিস মেলা’ অ্যাপ" /&gt;&lt;/p&gt;&lt;p&gt;ডায়াবেটিসে আক্রান্ত ব্যক্তি এবং এ রোগের ঝুঁকিতে থাকা মানুষের জন্য ‘ডায়াবেটিস মেলা’ নামে একটি অ্যাপ চালু হতে যাচ্ছে। এ অ্যাপের মাধ্যমে যে কেউ নিজের ডায়াবেটিসে আক্রান্ত হওয়ার ঝুঁকি এবং আক্রান্ত কি না, তা জানতে পারবেন। পাশাপাশি রোগ প্রতিরোধ, স্বাস্থ্যকর জীবনযাপন ও চিকিৎসাসংক্রান্ত প্রয়োজনীয় তথ্য ও সহায়&lt;/p&gt;</description>
      <source url="https://ekattor.tv/others/97662/%E0%A6%A1%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%9F%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%9D%E0%A7%81%E0%A6%81%E0%A6%95%E0%A6%BF-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A7%9F-%E0%A6%93-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%86%E0%A6%B8%E0%A6%9B%E0%A7%87">একাত্তর</source>
    </item>
    <item>
      <title>পারস্পরিক আস্থায় বাড়ছে বাংলাদেশের পোশাকশিল্পের ব্যবসা ও বিনিয়োগ</title>
      <link>https://ekattor.tv/others/97661/%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%95-%E0%A6%86%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%9B%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%95%E0%A6%B6%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://ekattor.tv/others/97661/%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%95-%E0%A6%86%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%9B%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%95%E0%A6%B6%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Sat, 14 Nov 2026 20:38:39 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/3c078eeb29a3c94eec8d9d7274a300fb-6af8725c5fcb6.jpg?jadewits_media_id=64932" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/3c078eeb29a3c94eec8d9d7274a300fb-6af8725c5fcb6.jpg?jadewits_media_id=64932" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/3c078eeb29a3c94eec8d9d7274a300fb-6af8725c5fcb6.jpg?jadewits_media_id=64932" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পারস্পরিক আস্থায় বাড়ছে বাংলাদেশের পোশাকশিল্পের ব্যবসা ও বিনিয়োগ" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশের তৈরি পোশাকশিল্পের প্রবৃদ্ধিতে গুরুত্বপূর্ণ ভূমিকা রাখছে আন্তর্জাতিক ক্রেতা ও দেশীয় সরবরাহকারী প্রতিষ্ঠানের দীর্ঘমেয়াদি ব্যবসায়িক সম্পর্ক। শুধু ক্রয়াদেশ নয়, পারস্পরিক আস্থা ও সহযোগিতার মাধ্যমে বাড়ছে বিনিয়োগ, ব্যবসার পরিধি এবং দক্ষ জনবল। এর ফলে বৈশ্বিক পোশাকবাজারে বাংলাদেশের অবস্থান আরও সুদ&lt;/p&gt;</description>

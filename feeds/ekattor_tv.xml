    <item>
      <title>কেন ন্যাটোর সঙ্গে রাশিয়ার সম্ভাব্য সংঘাতের কেন্দ্রবিন্দু হয়ে উঠছে কালিনিনগ্রাদ?</title>
      <link>https://ekattor.tv/international/europe/98276/%E0%A6%95%E0%A7%87%E0%A6%A8-%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9F%E0%A7%8B%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://ekattor.tv/international/europe/98276/%E0%A6%95%E0%A7%87%E0%A6%A8-%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9F%E0%A7%8B%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Tue, 24 Nov 2026 09:00:00 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/142bef111fe1fcbe187f2af4c204c30d-6b0429decce22.jpg?jadewits_media_id=65758" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/142bef111fe1fcbe187f2af4c204c30d-6b0429decce22.jpg?jadewits_media_id=65758" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/142bef111fe1fcbe187f2af4c204c30d-6b0429decce22.jpg?jadewits_media_id=65758" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কেন ন্যাটোর সঙ্গে রাশিয়ার সম্ভাব্য সংঘাতের কেন্দ্রবিন্দু হয়ে উঠছে কালিনিনগ্রাদ?" /&gt;&lt;/p&gt;&lt;p&gt;ফিনল্যান্ড উপসাগরে সামরিক সংশ্লিষ্ট একটি রুশ পণ্যবাহী জাহাজে ড্রোন হামলা ও অগ্নিকাণ্ডের পর গত শনিবার রুশ ছিটমহল কালিনিনগ্রাদের প্রধান বিমানবন্দরে কয়েক ঘণ্টা ফ্লাইট চলাচল বন্ধ রাখা হয় এবং কর্তৃপক্ষ ড্রোন সতর্কতা জারি করে। ২০২৬ সালের অক্টোবরে প্রেসিডেন্ট ভ্লাদিমির পুতিন পশ্চিমা বিশ্বকে সতর্ক করে বলেন,&lt;/p&gt;</description>
      <source url="https://ekattor.tv/international/europe/98276/%E0%A6%95%E0%A7%87%E0%A6%A8-%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9F%E0%A7%8B%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AD%E0%A6%BE%E0%A6%AC%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0">একাত্তর</source>
    </item>
    <item>
      <title>ইরানের ক্ষেপণাস্ত্র ভান্ডার বদলে দিচ্ছে ট্রাম্পের হিসাব নিকাশ!</title>
      <link>https://ekattor.tv/international/middle-east/98299/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA%E0%A6%A3%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AD%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A7%87-%E0%A6%A6%E0%A6%BF%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://ekattor.tv/international/middle-east/98299/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA%E0%A6%A3%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AD%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A7%87-%E0%A6%A6%E0%A6%BF%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Tue, 24 Nov 2026 08:30:00 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/493ffe710e6573970db4ac4a84bc2202-6b04942b144bb.jpg?jadewits_media_id=65786" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/493ffe710e6573970db4ac4a84bc2202-6b04942b144bb.jpg?jadewits_media_id=65786" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/493ffe710e6573970db4ac4a84bc2202-6b04942b144bb.jpg?jadewits_media_id=65786" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইরানের ক্ষেপণাস্ত্র ভান্ডার বদলে দিচ্ছে ট্রাম্পের হিসাব নিকাশ!" /&gt;&lt;/p&gt;&lt;p&gt;ইরানের বিরুদ্ধে যুক্তরাষ্ট্র ও ইসরাইলের সামরিক অভিযান শুরুর প্রায় ৯ মাস পর ওয়াশিংটন এবং তেল আবিবে একটি উদ্বেগজনক প্রশ্ন সামনে আসছে: তেহরান কি এখনো পর্যাপ্ত তাদের সামরিক সক্ষমতা ধরে রেখেছে, যা নতুন কোনো অভিযানকে ধারণার চেয়েও অনেক বেশি বিপজ্জনক করে তুলতে পারে? সম্প্রাতিক সময়ে ইরানের বেশ কিছু তৎপরতা সে&lt;/p&gt;</description>
      <source url="https://ekattor.tv/international/middle-east/98299/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA%E0%A6%A3%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AD%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A7%87-%E0%A6%A6%E0%A6%BF%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A7%87%E0%A6%B0">একাত্তর</source>

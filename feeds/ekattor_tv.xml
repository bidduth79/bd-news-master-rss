    <item>
      <title>দেশে মানসিক অসুস্থতায় ভুগছেন প্রতি পাঁচজনে একজন</title>
      <link>https://ekattor.tv/health/treatment/97932/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%95-%E0%A6%85%E0%A6%B8%E0%A7%81%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%A4%E0%A6%BE%E0%A7%9F-%E0%A6%AD%E0%A7%81%E0%A6%97%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF-%E0%A6%AA%E0%A6%BE%E0%A6%81%E0%A6%9A%E0%A6%9C%E0%A6%A8%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A6%9C%E0%A6%A8</link>
      <guid isPermaLink="true">https://ekattor.tv/health/treatment/97932/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%95-%E0%A6%85%E0%A6%B8%E0%A7%81%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%A4%E0%A6%BE%E0%A7%9F-%E0%A6%AD%E0%A7%81%E0%A6%97%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF-%E0%A6%AA%E0%A6%BE%E0%A6%81%E0%A6%9A%E0%A6%9C%E0%A6%A8%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A6%9C%E0%A6%A8</guid>
      <pubDate>Thu, 19 Nov 2026 08:45:00 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/d2d2b2524287d8ca96acc1f28ea6f21c-6afdb3b96d6e8.jpg?jadewits_media_id=65296" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/d2d2b2524287d8ca96acc1f28ea6f21c-6afdb3b96d6e8.jpg?jadewits_media_id=65296" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/d2d2b2524287d8ca96acc1f28ea6f21c-6afdb3b96d6e8.jpg?jadewits_media_id=65296" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দেশে মানসিক অসুস্থতায় ভুগছেন প্রতি পাঁচজনে একজন" /&gt;&lt;/p&gt;&lt;p&gt;একবিংশ শতাব্দীর সবচেয়ে বড় অথচ নীরব মহামারীর নাম মানসিক স্বাস্থ্য সংকট। আপনার পাশের মানুষটি হয়তো বাইরে থেকে প্রাণখুলে হাসছেন, কারণে-অকারণে উচ্ছ্বাস ছড়াচ্ছেন, কিন্তু ভেতরে ভেতরে সেই মানুষটিই হয়তো ডুবে আছেন তীব্র হতাশা ও একাকীত্বে।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/health/treatment/97932/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%95-%E0%A6%85%E0%A6%B8%E0%A7%81%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%A4%E0%A6%BE%E0%A7%9F-%E0%A6%AD%E0%A7%81%E0%A6%97%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF-%E0%A6%AA%E0%A6%BE%E0%A6%81%E0%A6%9A%E0%A6%9C%E0%A6%A8%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A6%9C%E0%A6%A8">একাত্তর</source>
    </item>
    <item>
      <title>পোশাক রপ্তানিতে দ্বিতীয় অবস্থান হারানোর শঙ্কায় বাংলাদেশ</title>
      <link>https://ekattor.tv/business/97931/%E0%A6%AA%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%95-%E0%A6%B0%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8B%E0%A6%B0-%E0%A6%B6%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A7%9F</link>
      <guid isPermaLink="true">https://ekattor.tv/business/97931/%E0%A6%AA%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%95-%E0%A6%B0%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8B%E0%A6%B0-%E0%A6%B6%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A7%9F</guid>
      <pubDate>Thu, 19 Nov 2026 08:30:00 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2023/11/07/853f8a92625a61a16ddb3c947b205b86-654a0c46e077b.JPG?jadewits_media_id=5270" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2023/11/07/853f8a92625a61a16ddb3c947b205b86-654a0c46e077b.JPG?jadewits_media_id=5270" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2023/11/07/853f8a92625a61a16ddb3c947b205b86-654a0c46e077b.JPG?jadewits_media_id=5270" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পোশাক রপ্তানিতে দ্বিতীয় অবস্থান হারানোর শঙ্কায় বাংলাদেশ" /&gt;&lt;/p&gt;&lt;p&gt;বিশ্ব পোশাক রপ্তানির বাজারে দীর্ঘদিনের দ্বিতীয় অবস্থান ধরে রাখা নিয়ে বড় ধরনের চ্যালেঞ্জের মুখে পড়েছে বাংলাদেশ। বিশ্ব বাণিজ্য সংস্থার (ডব্লিউটিও) ২০২৫ সালের পরিসংখ্যান বলছে, বৈশ্বিক পোশাক রপ্তানিতে বাংলাদেশের অংশীদারিত্ব ৬ দশমিক ৭৫ শতাংশ, যেখানে মাত্র ৬ দশমিক ৫৩ শতাংশ নিয়ে বাংলাদেশের ঠিক ঘাড়েই নিশ্বা&lt;/p&gt;</description>
      <source url="https://ekattor.tv/business/97931/%E0%A6%AA%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%95-%E0%A6%B0%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%85%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%8B%E0%A6%B0-%E0%A6%B6%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A7%9F">একাত্তর</source>
    </item>
    <item>
      <title>পেটা ইন্ডিয়া ফ্যাশনে বাজিমাত ঐশ্বরিয়া-ক্যাটরিনার!</title>

      <title>ডিএফসি তহবিলের যোগ্য দেশ হিসেবে স্বীকৃতি পেলো বাংলাদেশ</title>
      <link>https://ekattor.tv/national/97807/%E0%A6%A1%E0%A6%BF%E0%A6%8F%E0%A6%AB%E0%A6%B8%E0%A6%BF-%E0%A6%A4%E0%A6%B9%E0%A6%AC%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%8D%E0%A6%AF-%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%B9%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A7%80%E0%A6%95%E0%A7%83%E0%A6%A4%E0%A6%BF-%E0%A6%AA%E0%A7%87%E0%A6%B2%E0%A7%8B</link>
      <guid isPermaLink="true">https://ekattor.tv/national/97807/%E0%A6%A1%E0%A6%BF%E0%A6%8F%E0%A6%AB%E0%A6%B8%E0%A6%BF-%E0%A6%A4%E0%A6%B9%E0%A6%AC%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%8D%E0%A6%AF-%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%B9%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A7%80%E0%A6%95%E0%A7%83%E0%A6%A4%E0%A6%BF-%E0%A6%AA%E0%A7%87%E0%A6%B2%E0%A7%8B</guid>
      <pubDate>Mon, 16 Nov 2026 23:57:28 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/7325783003fc8c27e57f262d19be3717-6afb43a6bead5.jpg?jadewits_media_id=65122" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/7325783003fc8c27e57f262d19be3717-6afb43a6bead5.jpg?jadewits_media_id=65122" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/7325783003fc8c27e57f262d19be3717-6afb43a6bead5.jpg?jadewits_media_id=65122" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডিএফসি তহবিলের যোগ্য দেশ হিসেবে স্বীকৃতি পেলো বাংলাদেশ" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাষ্ট্রের আন্তর্জাতিক উন্নয়ন অর্থায়ন সংস্থা ‘ইউএস ইন্টারন্যাশনাল ডেভেলপমেন্ট ফিন্যান্স করপোরেশনের (ডিএফসি) অর্থায়নের যোগ্য দেশ হিসেবে তালিকাভুক্ত হয়েছে বাংলাদেশ। সোমবার ওয়াশিংটন ডিসি থেকে ডিএফসি আনুষ্ঠানিকভাবে ঘোষণা করেছে, এখন থেকে বাংলাদেশের বিভিন্ন উন্নয়ন প্রকল্প সংস্থাটির অর্থায়ন ও বিনিয়োগ স&lt;/p&gt;</description>
      <source url="https://ekattor.tv/national/97807/%E0%A6%A1%E0%A6%BF%E0%A6%8F%E0%A6%AB%E0%A6%B8%E0%A6%BF-%E0%A6%A4%E0%A6%B9%E0%A6%AC%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%8D%E0%A6%AF-%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%B9%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A7%80%E0%A6%95%E0%A7%83%E0%A6%A4%E0%A6%BF-%E0%A6%AA%E0%A7%87%E0%A6%B2%E0%A7%8B">একাত্তর</source>
    </item>

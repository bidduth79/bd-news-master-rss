      <guid isPermaLink="true">https://ekattor.tv/international/asia/97987/%E0%A6%A6%E0%A7%87%E0%A7%9C-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B6%E0%A7%87%E0%A6%A8%E0%A6%9C%E0%A7%87%E0%A6%A8-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A6%BF-%E0%A6%86%E0%A6%B2%E0%A7%8B%E0%A6%9A%E0%A6%A8%E0%A6%BE-%E0%A6%B9%E0%A6%B2%E0%A7%8B</guid>
      <pubDate>Thu, 19 Nov 2026 16:49:03 +0600</pubDate>

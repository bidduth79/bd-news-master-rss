    <item>
      <title>নিরাপত্তা সংকটের জেরে জর্ডানে নিষিদ্ধ হলো টেলিগ্রাম</title>
      <link>https://ekattor.tv/international/middle-east/97790/%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BE-%E0%A6%B8%E0%A6%82%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A7%87%E0%A6%B0%E0%A7%87-%E0%A6%9C%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%B9%E0%A6%B2%E0%A7%8B</link>
      <guid isPermaLink="true">https://ekattor.tv/international/middle-east/97790/%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BE-%E0%A6%B8%E0%A6%82%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A7%87%E0%A6%B0%E0%A7%87-%E0%A6%9C%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%B9%E0%A6%B2%E0%A7%8B</guid>
      <pubDate>Tue, 17 Nov 2026 08:15:00 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/deddbbe122d2c36deb393f455435ce76-6afb024a8bb7a.jpg?jadewits_media_id=65092" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/deddbbe122d2c36deb393f455435ce76-6afb024a8bb7a.jpg?jadewits_media_id=65092" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/deddbbe122d2c36deb393f455435ce76-6afb024a8bb7a.jpg?jadewits_media_id=65092" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নিরাপত্তা সংকটের জেরে জর্ডানে নিষিদ্ধ হলো টেলিগ্রাম" /&gt;&lt;/p&gt;&lt;p&gt;জর্ডানের নিরাপত্তা জোরদার এবং অবৈধ ও উগ্রবাদী কনটেন্ট প্রচার কঠোরভাবে দমন করতে জনপ্রিয় মেসেজিং অ্যাপ ‘টেলিগ্রাম’ নিষিদ্ধ করেছে দেশটির কর্তৃপক্ষ। গত মাসে কারক শহরের একটি গ্রিক অর্থোডক্স গির্জায় বর্বরোচিত হামলায় ৯ জন নিহত হওয়ার পর চলমান বিশেষ নিরাপত্তা অভিযানের অংশ হিসেবে এই কঠোর সিদ্ধান্ত নেওয়া হয়।	&lt;/p&gt;</description>
      <source url="https://ekattor.tv/international/middle-east/97790/%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BE-%E0%A6%B8%E0%A6%82%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A7%87%E0%A6%B0%E0%A7%87-%E0%A6%9C%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%B9%E0%A6%B2%E0%A7%8B">একাত্তর</source>

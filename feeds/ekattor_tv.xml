    <item>
      <title>জাতীয় ঐক্যের লক্ষ্যে সংলাপে বসছেন প্রধানমন্ত্রী</title>
      <link>https://ekattor.tv/national/98199/%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%90%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%B2%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%AA%E0%A7%87-%E0%A6%AC%E0%A6%B8%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80</link>
      <guid isPermaLink="true">https://ekattor.tv/national/98199/%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%90%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%B2%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%AA%E0%A7%87-%E0%A6%AC%E0%A6%B8%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80</guid>
      <pubDate>Mon, 23 Nov 2026 00:00:00 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/1786f93908d6ccb8d87954a645758d3b-6b02cf36595c5.jpg?jadewits_media_id=65650" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/1786f93908d6ccb8d87954a645758d3b-6b02cf36595c5.jpg?jadewits_media_id=65650" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/1786f93908d6ccb8d87954a645758d3b-6b02cf36595c5.jpg?jadewits_media_id=65650" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জাতীয় ঐক্যের লক্ষ্যে সংলাপে বসছেন প্রধানমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;দেশের বর্তমান উদ্ভূত রাজনৈতিক পরিস্থিতিতে জাতীয় ঐক্য গড়ে তুলতে সব রাজনৈতিক দলের সঙ্গে সংলাপে বসতে যাচ্ছেন প্রধানমন্ত্রী তারেক রহমান। সোমবার দুপুরে জাতীয় নাগরিক পার্টির (এনসিপি) সঙ্গে বৈঠকের মধ্য দিয়ে সরকারপ্রধানের এই সংলাপ শুরু হতে যাচ্ছে।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/national/98199/%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%90%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%B2%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%AA%E0%A7%87-%E0%A6%AC%E0%A6%B8%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80">একাত্তর</source>
    </item>
    <item>
      <title>শিক্ষার অধিকার যাচাইয়ে বাংলাদেশে আসছেন জাতিসংঘের বিশেষ প্রতিনিধি</title>

      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/7fb89fdc916d54fe96204277465ca05e-6af492ade3c24.jpg?jadewits_media_id=64705" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইতালিসহ ইউরোপজুড়ে হাজার হাজার স্কুলে ভুয়া বোমা হুমকি" /&gt;&lt;/p&gt;&lt;p&gt;ইতালির প্রায় ৬ হাজার ৩০০ স্কুল একই সঙ্গে ভুয়া বোমা হুমকির ই-মেইল পাওয়ার পর দেশটির বিভিন্ন এলাকায় স্কুল ভবনগুলো খালি করা হয়েছে। শুধু ইতালিই নয়, একই ধরনের বার্তা পাওয়ার কথা জানিয়েছে স্কটল্যান্ড ও উত্তর আয়ারল্যান্ডের কর্তৃপক্ষও। কাতারভিত্তিক সংবাদমাধ্যম আল জাজিরার এক প্রতিবেদনে এই চাঞ্চল্যকর তথ্য উঠে &lt;/p&gt;</description>
      <source url="https://ekattor.tv/international/europe/97500/%E0%A6%87%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%B8%E0%A6%B9-%E0%A6%87%E0%A6%89%E0%A6%B0%E0%A7%8B%E0%A6%AA%E0%A6%9C%E0%A7%81%E0%A7%9C%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2%E0%A7%87-%E0%A6%AD%E0%A7%81%E0%A7%9F%E0%A6%BE-%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE">একাত্তর</source>

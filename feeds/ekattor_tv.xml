      <guid isPermaLink="true">https://ekattor.tv/national/97611/%E0%A6%9C%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A7%81-%E0%A6%A4%E0%A6%B9%E0%A6%AC%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A5-%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A6%B0%E0%A6%BF-%E0%A6%AA%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE-%E0%A6%B8%E0%A6%B9%E0%A6%9C%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Fri, 13 Nov 2026 20:05:00 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/d13ec5e9318241e3414b11db123d3150-6af70c08beb57.jpg?jadewits_media_id=64869" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/d13ec5e9318241e3414b11db123d3150-6af70c08beb57.jpg?jadewits_media_id=64869" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/d13ec5e9318241e3414b11db123d3150-6af70c08beb57.jpg?jadewits_media_id=64869" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জলবায়ু তহবিলের অর্থ সরাসরি পাওয়ার প্রক্রিয়া সহজের দাবি পরিবেশমন্ত্রীর" /&gt;&lt;/p&gt;&lt;p&gt;জলবায়ু পরিবর্তন মোকাবিলায় গ্রিন ক্লাইমেট ফান্ড, গ্লোবাল এনভায়রনমেন্ট ফ্যাসিলিটি এবং অ্যাডাপটেশন ফান্ড থেকে সরাসরি অর্থ পাওয়ার প্রক্রিয়া সহজ করার দাবি জানিয়েছেন পরিবেশ, বন ও জলবায়ু পরিবর্তনমন্ত্রী আবদুল আউয়াল মিন্টু।						বিস্তারিত&lt;/p&gt;</description>

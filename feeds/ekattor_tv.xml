    <item>
      <title>জুবাইদা রহমান-সোফির বৈঠক: নারীর ক্ষমতায়ন ও রোহিঙ্গা প্রত্যাবাসন নিয়ে আলোচনা</title>
      <link>https://ekattor.tv/national/97396/%E0%A6%9C%E0%A7%81%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%A6%E0%A6%BE-%E0%A6%B0%E0%A6%B9%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%B8%E0%A7%8B%E0%A6%AB%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%AE%E0%A6%A4%E0%A6%BE%E0%A7%9F%E0%A6%A8-%E0%A6%93</link>
      <guid isPermaLink="true">https://ekattor.tv/national/97396/%E0%A6%9C%E0%A7%81%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%A6%E0%A6%BE-%E0%A6%B0%E0%A6%B9%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%B8%E0%A7%8B%E0%A6%AB%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%AE%E0%A6%A4%E0%A6%BE%E0%A7%9F%E0%A6%A8-%E0%A6%93</guid>
      <pubDate>Mon, 09 Nov 2026 21:20:36 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/09/6576727140a599833186080ccb7931c6-6af1e4ba780ba.jpg?jadewits_media_id=64565" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/09/6576727140a599833186080ccb7931c6-6af1e4ba780ba.jpg?jadewits_media_id=64565" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/09/6576727140a599833186080ccb7931c6-6af1e4ba780ba.jpg?jadewits_media_id=64565" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জুবাইদা রহমান-সোফির বৈঠক: নারীর ক্ষমতায়ন ও রোহিঙ্গা প্রত্যাবাসন নিয়ে আলোচনা" /&gt;&lt;/p&gt;&lt;p&gt;প্রধানমন্ত্রীর সহধর্মিণী ডা. জুবাইদা রহমান এবং ব্রিটেনের ডাচেস অভ এডিনবরা সোফির মধ্যে বৈঠক অনুষ্ঠিত হয়েছে। বৈঠকে নারীর ক্ষমতায়ন, মাতৃ ও শিশু স্বাস্থ্যসেবা, শিক্ষা এবং রোহিঙ্গা সংকটসহ ঝুঁকিপূর্ণ জনগোষ্ঠী সুরক্ষায় পারস্পরিক সহযোগিতা জোরদার করার বিষয়ে আলোচনা হয়েছে। 						বিস্তারিত&lt;/p&gt;</description>

    <item>
      <title>দক্ষিণ কোরিয়ার এআই দিয়ে পরীক্ষা নকল, শিক্ষামন্ত্রীর পদত্যাগ</title>
      <link>https://ekattor.tv/international/asia/98192/%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%A3-%E0%A6%95%E0%A7%8B%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%8F%E0%A6%86%E0%A6%87-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%A8%E0%A6%95%E0%A6%B2</link>
      <guid isPermaLink="true">https://ekattor.tv/international/asia/98192/%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%A3-%E0%A6%95%E0%A7%8B%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%8F%E0%A6%86%E0%A6%87-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%A8%E0%A6%95%E0%A6%B2</guid>
      <pubDate>Sun, 22 Nov 2026 16:46:13 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/89931b7250c5f1ee020e8b0339c93901-6b02c7eb97aee.jpg?jadewits_media_id=65644" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/89931b7250c5f1ee020e8b0339c93901-6b02c7eb97aee.jpg?jadewits_media_id=65644" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/89931b7250c5f1ee020e8b0339c93901-6b02c7eb97aee.jpg?jadewits_media_id=65644" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দক্ষিণ কোরিয়ার এআই দিয়ে পরীক্ষা নকল, শিক্ষামন্ত্রীর পদত্যাগ" /&gt;&lt;/p&gt;&lt;p&gt;কৃত্রিম বুদ্ধিমত্তা (এআই) ব্যবহার করে পরীক্ষায় জালিয়াতির ঘটনার জেরে তীব্র সমালোচনা ও জনরোষের মুখে পদত্যাগ করেছেন দক্ষিণ কোরিয়ার শিক্ষামন্ত্রী চোই কিয়ো-জিন। রোববার তাঁর পদত্যাগপত্র গ্রহণ করেছেন প্রেসিডেন্ট লি জে মিয়ং। সামাজিক যোগাযোগমাধ্যম এক্সে দেওয়া এক পোস্টে চোই কিয়ো জানিয়েছেন, পরীক্ষা শেষ হয়েছে এ&lt;/p&gt;</description>
      <source url="https://ekattor.tv/international/asia/98192/%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%A3-%E0%A6%95%E0%A7%8B%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%8F%E0%A6%86%E0%A6%87-%E0%A6%A6%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%A8%E0%A6%95%E0%A6%B2">একাত্তর</source>
    </item>
    <item>
      <title>মির্জা আজমকে আত্মসমর্পণ করতে পত্রিকায় বিজ্ঞপ্তির নির্দেশ</title>
      <link>https://ekattor.tv/politics/98191/%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A6%BE-%E0%A6%86%E0%A6%9C%E0%A6%AE%E0%A6%95%E0%A7%87-%E0%A6%86%E0%A6%A4%E0%A7%8D%E0%A6%AE%E0%A6%B8%E0%A6%AE%E0%A6%B0%E0%A7%8D%E0%A6%AA%E0%A6%A3-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A7%8D%E0%A6%9E%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0</link>
      <guid isPermaLink="true">https://ekattor.tv/politics/98191/%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A6%BE-%E0%A6%86%E0%A6%9C%E0%A6%AE%E0%A6%95%E0%A7%87-%E0%A6%86%E0%A6%A4%E0%A7%8D%E0%A6%AE%E0%A6%B8%E0%A6%AE%E0%A6%B0%E0%A7%8D%E0%A6%AA%E0%A6%A3-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A7%8D%E0%A6%9E%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0</guid>
      <pubDate>Sun, 22 Nov 2026 16:44:06 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/6f8ca325cf34a98b489ff9200779c01e-6b02c755ab473.jpg?jadewits_media_id=65643" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/6f8ca325cf34a98b489ff9200779c01e-6b02c755ab473.jpg?jadewits_media_id=65643" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/22/6f8ca325cf34a98b489ff9200779c01e-6b02c755ab473.jpg?jadewits_media_id=65643" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মির্জা আজমকে আত্মসমর্পণ করতে পত্রিকায় বিজ্ঞপ্তির নির্দেশ" /&gt;&lt;/p&gt;&lt;p&gt;জুলাই গণ-অভ্যুত্থানের সময় সংঘটিত মানবতাবিরোধী অপরাধের মামলায় রাজনৈতিক কার্যক্রম নিষিদ্ধ আওয়ামী লীগের সাংগঠনিক সম্পাদক ও জামালপুর-৩ আসনের সাবেক সংসদ সদস্য মির্জা আজমকে আত্মসমর্পণের নির্দেশ দিয়ে পত্রিকায় বিজ্ঞপ্তি প্রকাশের আদেশ দিয়েছেন আন্তর্জাতিক অপরাধ ট্রাইব্যুনাল-২।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/politics/98191/%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A6%BE-%E0%A6%86%E0%A6%9C%E0%A6%AE%E0%A6%95%E0%A7%87-%E0%A6%86%E0%A6%A4%E0%A7%8D%E0%A6%AE%E0%A6%B8%E0%A6%AE%E0%A6%B0%E0%A7%8D%E0%A6%AA%E0%A6%A3-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A7%8D%E0%A6%9E%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%B0">একাত্তর</source>
    </item>
    <item>
      <title>অতীতের সব রেকর্ড ভাঙলো পাগলা মসজিদের দানবাক্স</title>
      <link>https://ekattor.tv/country/dhaka/98190/%E0%A6%85%E0%A6%A4%E0%A7%80%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AC-%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A1-%E0%A6%AD%E0%A6%BE%E0%A6%99%E0%A6%B2%E0%A7%8B-%E0%A6%AA%E0%A6%BE%E0%A6%97%E0%A6%B2%E0%A6%BE-%E0%A6%AE%E0%A6%B8%E0%A6%9C%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%B8</link>
      <guid isPermaLink="true">https://ekattor.tv/country/dhaka/98190/%E0%A6%85%E0%A6%A4%E0%A7%80%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AC-%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A1-%E0%A6%AD%E0%A6%BE%E0%A6%99%E0%A6%B2%E0%A7%8B-%E0%A6%AA%E0%A6%BE%E0%A6%97%E0%A6%B2%E0%A6%BE-%E0%A6%AE%E0%A6%B8%E0%A6%9C%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A6%AC%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%B8</guid>

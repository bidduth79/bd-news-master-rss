    <item>
      <title>বাগেরহাটে ফসলের মাঠ যেন ‘জলে কুমির, ডাঙায় বাঘ’</title>
      <link>https://ekattor.tv/country/khulna/98539/%E0%A6%AC%E0%A6%BE%E0%A6%97%E0%A7%87%E0%A6%B0%E0%A6%B9%E0%A6%BE%E0%A6%9F%E0%A7%87-%E0%A6%AB%E0%A6%B8%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%A0-%E0%A6%AF%E0%A7%87%E0%A6%A8-%E2%80%98%E0%A6%9C%E0%A6%B2%E0%A7%87-%E0%A6%95%E0%A7%81%E0%A6%AE%E0%A6%BF%E0%A6%B0-%E0%A6%A1%E0%A6%BE%E0%A6%99%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BE%E0%A6%98%E2%80%99</link>
      <guid isPermaLink="true">https://ekattor.tv/country/khulna/98539/%E0%A6%AC%E0%A6%BE%E0%A6%97%E0%A7%87%E0%A6%B0%E0%A6%B9%E0%A6%BE%E0%A6%9F%E0%A7%87-%E0%A6%AB%E0%A6%B8%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%A0-%E0%A6%AF%E0%A7%87%E0%A6%A8-%E2%80%98%E0%A6%9C%E0%A6%B2%E0%A7%87-%E0%A6%95%E0%A7%81%E0%A6%AE%E0%A6%BF%E0%A6%B0-%E0%A6%A1%E0%A6%BE%E0%A6%99%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BE%E0%A6%98%E2%80%99</guid>
      <pubDate>Thu, 26 Nov 2026 19:29:56 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/8a44e371cad0d616f2182cc2ed8ab100-6b0833c538c0b.jpg?jadewits_media_id=66097" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/8a44e371cad0d616f2182cc2ed8ab100-6b0833c538c0b.jpg?jadewits_media_id=66097" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/8a44e371cad0d616f2182cc2ed8ab100-6b0833c538c0b.jpg?jadewits_media_id=66097" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাগেরহাটে ফসলের মাঠ যেন ‘জলে কুমির, ডাঙায় বাঘ’" /&gt;&lt;/p&gt;&lt;p&gt;বঙ্গোপসাগরে সৃষ্ট ঘূর্ণিঝড় আকভানের প্রভাবে অতিবৃষ্টিতে বাগেরহাটে জলাবদ্ধতা দেখা দিয়েছে, যার ফলে কয়েক দিন ধরে পানিতে ডুবে থাকা কাচা-পাকা আমন ধানে পচন ধরেছে। এর মধ্যেই বৃষ্টির পর চড়া রোদ ওঠায় শুকিয়ে মারা যাচ্ছে শীতকালীন সবজির চারা—ফলে উভয় সঙ্কটে পড়েছেন জেলার চাষী। 						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/country/khulna/98539/%E0%A6%AC%E0%A6%BE%E0%A6%97%E0%A7%87%E0%A6%B0%E0%A6%B9%E0%A6%BE%E0%A6%9F%E0%A7%87-%E0%A6%AB%E0%A6%B8%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BE%E0%A6%A0-%E0%A6%AF%E0%A7%87%E0%A6%A8-%E2%80%98%E0%A6%9C%E0%A6%B2%E0%A7%87-%E0%A6%95%E0%A7%81%E0%A6%AE%E0%A6%BF%E0%A6%B0-%E0%A6%A1%E0%A6%BE%E0%A6%99%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BE%E0%A6%98%E2%80%99">একাত্তর</source>

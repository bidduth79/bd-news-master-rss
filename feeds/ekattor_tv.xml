    <item>
      <title>স্পেনের জয়যাত্রা থামালো ইংল্যান্ড, ইতালিকে বিদায় করলো বেলজিয়াম</title>
      <link>https://ekattor.tv/sports/football/97759/%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A7%87%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A7%9F%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE-%E0%A6%A5%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A7%8B-%E0%A6%87%E0%A6%82%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1-%E0%A6%87%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A6%BE%E0%A7%9F</link>
      <guid isPermaLink="true">https://ekattor.tv/sports/football/97759/%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A7%87%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A7%9F%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE-%E0%A6%A5%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A7%8B-%E0%A6%87%E0%A6%82%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1-%E0%A6%87%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A6%BE%E0%A7%9F</guid>
      <pubDate>Mon, 16 Nov 2026 14:49:50 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/939b3f8be9021f753087613be22423eb-6afac38560c49.jpg?jadewits_media_id=65052" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/939b3f8be9021f753087613be22423eb-6afac38560c49.jpg?jadewits_media_id=65052" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/939b3f8be9021f753087613be22423eb-6afac38560c49.jpg?jadewits_media_id=65052" style="max-width:100%;height:auto;margin-bottom:10px;" alt="স্পেনের জয়যাত্রা থামালো ইংল্যান্ড, ইতালিকে বিদায় করলো বেলজিয়াম" /&gt;&lt;/p&gt;&lt;p&gt;ইউরোপিয়ান ফুটবলে এক রোমাঞ্চকর ও নাটকীয় রাত! বিশ্বচ্যাম্পিয়ন স্পেনের দুর্গে হানা দিয়ে তাদের দীর্ঘ ৪৩ ম্যাচের রেকর্ড অজেয় যাত্রা থামিয়ে দিল ইংল্যান্ড। রোববার রাতে মাদ্রিদের মেট্রোপলিটানো স্টেডিয়ামে উয়েফা নেশনস লিগের শ্বাসরুদ্ধকর লড়াইয়ে স্পেনকে ৩-২ গোলে হারিয়ে গ্রুপ সেরা হয়ে কোয়ার্টার ফাইনালে পা রাখল ট&lt;/p&gt;</description>
      <source url="https://ekattor.tv/sports/football/97759/%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A7%87%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A7%9F%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE-%E0%A6%A5%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A7%8B-%E0%A6%87%E0%A6%82%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1-%E0%A6%87%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A6%BE%E0%A7%9F">একাত্তর</source>
    </item>
    <item>
      <title>মেয়েকে সেঞ্চুরি উৎসর্গ করলেন লিটন, লিখলেন ‘শুভ জন্মদিন আমার রাজকন্যা’</title>

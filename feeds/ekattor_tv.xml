    <item>
      <title>তুরস্কে ইস্পাত কারখানায় ভয়াবহ বিস্ফোরণে নিহত ১৭</title>
      <link>https://ekattor.tv/international/europe/97442/%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%87-%E0%A6%87%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A6%BE%E0%A6%A4-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AD%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A6%B9-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A7%A7%E0%A7%AD</link>
      <guid isPermaLink="true">https://ekattor.tv/international/europe/97442/%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%87-%E0%A6%87%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A6%BE%E0%A6%A4-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AD%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A6%B9-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A7%A7%E0%A7%AD</guid>
      <pubDate>Tue, 10 Nov 2026 21:26:32 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/65d1203e4f43125985a1276dc405e18e-6af3379fb8ed8.jpg?jadewits_media_id=64613" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/65d1203e4f43125985a1276dc405e18e-6af3379fb8ed8.jpg?jadewits_media_id=64613" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/65d1203e4f43125985a1276dc405e18e-6af3379fb8ed8.jpg?jadewits_media_id=64613" style="max-width:100%;height:auto;margin-bottom:10px;" alt="তুরস্কে ইস্পাত কারখানায় ভয়াবহ বিস্ফোরণে নিহত ১৭" /&gt;&lt;/p&gt;&lt;p&gt;পশ্চিম তুরস্কের ইজমির প্রদেশের আলিয়াগা জেলায় একটি লোহা ও ইস্পাত কারখানায় ভয়াবহ বিস্ফোরণ ও অগ্নিকাণ্ডে কমপক্ষে ১৭ জন শ্রমিক নিহত এবং ১২ জন আহত হয়েছেন। সোমবার দুপুরে হাবাস ডেমির চেলিক নামের ইস্পাত উৎপাদনকারী কারখানায় এই মর্মান্তিক দুর্ঘটনা ঘটে। ঘটনার পর ধ্বংসস্তূপের নিচে আরও বেশ কয়েকজন শ্রমিক আটকে থাক&lt;/p&gt;</description>
      <source url="https://ekattor.tv/international/europe/97442/%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%87-%E0%A6%87%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A6%BE%E0%A6%A4-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%AD%E0%A7%9F%E0%A6%BE%E0%A6%AC%E0%A6%B9-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A7%A7%E0%A7%AD">একাত্তর</source>

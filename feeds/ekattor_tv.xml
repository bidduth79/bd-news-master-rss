      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/26/98962aebee8bac9cc174f6bea97d7add-6b0746d956e58.jpg?jadewits_media_id=66028" length="0" type="image/jpeg" />

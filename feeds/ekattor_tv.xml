      <title>ব্যবসার খরচ কমাতে আর্থিক খাতে সমন্বিত ডিজিটাল ব্যবস্থা চালু হচ্ছে: গভর্নর</title>
      <link>https://ekattor.tv/business/98629/%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A6%BE%E0%A6%B0-%E0%A6%96%E0%A6%B0%E0%A6%9A-%E0%A6%95%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%BF%E0%A6%95-%E0%A6%96%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%A4-%E0%A6%A1%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%9F%E0%A6%BE%E0%A6%B2</link>
      <guid isPermaLink="true">https://ekattor.tv/business/98629/%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A6%BE%E0%A6%B0-%E0%A6%96%E0%A6%B0%E0%A6%9A-%E0%A6%95%E0%A6%AE%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%BF%E0%A6%95-%E0%A6%96%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%A4-%E0%A6%A1%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%9F%E0%A6%BE%E0%A6%B2</guid>
      <pubDate>Sat, 28 Nov 2026 15:27:44 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/61712e90572086b011e07df201f5ab2c-6b0a9e713c65b.jpg?jadewits_media_id=66195" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/61712e90572086b011e07df201f5ab2c-6b0a9e713c65b.jpg?jadewits_media_id=66195" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/61712e90572086b011e07df201f5ab2c-6b0a9e713c65b.jpg?jadewits_media_id=66195" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ব্যবসার খরচ কমাতে আর্থিক খাতে সমন্বিত ডিজিটাল ব্যবস্থা চালু হচ্ছে: গভর্নর" /&gt;&lt;/p&gt;&lt;p&gt;ব্যবসা পরিচালনার খরচ কমানো এবং সাধারণ মানুষের কাছে সাশ্রয়ী মূল্যে পণ্য ও সেবা পৌঁছে দিতে বিভিন্ন উদ্যোগ নেওয়া হচ্ছে বলে জানিয়েছেন বাংলাদেশ ব্যাংকের গভর্নর মোস্তাকুর রহমান। তিনি বলেন, অর্থায়নের ব্যয় কমাতে নীতি সুদহার ইতিমধ্যে ৫০ বেসিস পয়েন্ট কমানো হয়েছে।						বিস্তারিত&lt;/p&gt;</description>

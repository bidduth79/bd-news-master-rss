    <item>
      <title>পার্ল হারবার হামলার সাক্ষী শতবর্ষী ফ্রিমান জনসনের মৃত্যু</title>
      <link>https://ekattor.tv/international/america/97869/%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B2-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%80-%E0%A6%B6%E0%A6%A4%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A7%80-%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%9C%E0%A6%A8%E0%A6%B8%E0%A6%A8%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://ekattor.tv/international/america/97869/%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B2-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%80-%E0%A6%B6%E0%A6%A4%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A7%80-%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%9C%E0%A6%A8%E0%A6%B8%E0%A6%A8%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Wed, 18 Nov 2026 08:00:00 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/6c1ec9b7c2213ff173b526318466c072-6afc6dd40b954.jpg?jadewits_media_id=65201" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/6c1ec9b7c2213ff173b526318466c072-6afc6dd40b954.jpg?jadewits_media_id=65201" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/6c1ec9b7c2213ff173b526318466c072-6afc6dd40b954.jpg?jadewits_media_id=65201" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পার্ল হারবার হামলার সাক্ষী শতবর্ষী ফ্রিমান জনসনের মৃত্যু" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাষ্ট্রের নৌঘাঁটি পার্ল হারবার হামলার অন্যতম প্রাচীন এবং প্রবীণতম জীবিত মার্কিন সামরিক ভেটেরান ফ্রিমান জনসন ১০৬ বছর বয়সে পরলোকগমন করেছেন। গত শনিবার  ম্যাসাচুসেটসের সেন্টারেভিলে নিজের বাসভবনে তিনি শেষ নিঃশ্বাস ত্যাগ করেন বলে তাঁর কন্যা ডায়ান জনসন এ্যাসোসিয়েটেড প্রেসকে (এপি) নিশ্চিত করেছেন।				&lt;/p&gt;</description>
      <source url="https://ekattor.tv/international/america/97869/%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B2-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%80-%E0%A6%B6%E0%A6%A4%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%B7%E0%A7%80-%E0%A6%AB%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%9C%E0%A6%A8%E0%A6%B8%E0%A6%A8%E0%A7%87%E0%A6%B0">একাত্তর</source>
    </item>
    <item>
      <title>রাজধানীতে দেড় ঘণ্টায় তিনটি বাসে আগুন</title>
      <link>https://ekattor.tv/capital/97878/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A7%9C-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A7%9F-%E0%A6%A4%E0%A6%BF%E0%A6%A8%E0%A6%9F%E0%A6%BF-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</link>
      <guid isPermaLink="true">https://ekattor.tv/capital/97878/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A7%9C-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A7%9F-%E0%A6%A4%E0%A6%BF%E0%A6%A8%E0%A6%9F%E0%A6%BF-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</guid>
      <pubDate>Wed, 18 Nov 2026 00:12:36 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/94c73477e5f061e052f7afa8225726f3-6afc9908259b5.jpg?jadewits_media_id=65218" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/94c73477e5f061e052f7afa8225726f3-6afc9908259b5.jpg?jadewits_media_id=65218" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/94c73477e5f061e052f7afa8225726f3-6afc9908259b5.jpg?jadewits_media_id=65218" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজধানীতে দেড় ঘণ্টায় তিনটি বাসে আগুন" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর মিরপুর, মহাখালী এবং বাড্ডা এলাকায় মাত্র দেড় ঘণ্টার ব্যবধানে তিনটি যাত্রীবাহী বাসে আগুন দেয়ার ঘটনা ঘটেছে। মঙ্গলবার রাত পৌনে ৯টা থেকে রাত ১০টা ২০ মিনিটের মধ্যে পৃথক এই তিনটি ঘটনায় নগরজুড়ে আতঙ্ক ছড়িয়ে পড়ে। তবে ফায়ার সার্ভিসের দ্রুত তৎপরতায় সবকটি বাসের আগুন নিয়ন্ত্রণে আনা সম্ভব হয়েছে এবং কোনো ঘ&lt;/p&gt;</description>
      <source url="https://ekattor.tv/capital/97878/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A7%9C-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A7%9F-%E0%A6%A4%E0%A6%BF%E0%A6%A8%E0%A6%9F%E0%A6%BF-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8">একাত্তর</source>
    </item>
    <item>
      <title>ভিডিও দেখে সব দুষ্কৃতকারীকে ধরা হবে: স্বরাষ্ট্রমন্ত্রী</title>
      <link>https://ekattor.tv/national/97877/%E0%A6%AD%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A6%93-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A7%87-%E0%A6%B8%E0%A6%AC-%E0%A6%A6%E0%A7%81%E0%A6%B7%E0%A7%8D%E0%A6%95%E0%A7%83%E0%A6%A4%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%A7%E0%A6%B0%E0%A6%BE-%E0%A6%B9%E0%A6%AC%E0%A7%87</link>
      <guid isPermaLink="true">https://ekattor.tv/national/97877/%E0%A6%AD%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A6%93-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A7%87-%E0%A6%B8%E0%A6%AC-%E0%A6%A6%E0%A7%81%E0%A6%B7%E0%A7%8D%E0%A6%95%E0%A7%83%E0%A6%A4%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%A7%E0%A6%B0%E0%A6%BE-%E0%A6%B9%E0%A6%AC%E0%A7%87</guid>
      <pubDate>Tue, 17 Nov 2026 23:59:17 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/ef6dabff9f52e8fe95f310630d222559-6afc95d9e0879.jpg?jadewits_media_id=65217" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/ef6dabff9f52e8fe95f310630d222559-6afc95d9e0879.jpg?jadewits_media_id=65217" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/ef6dabff9f52e8fe95f310630d222559-6afc95d9e0879.jpg?jadewits_media_id=65217" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভিডিও দেখে সব দুষ্কৃতকারীকে ধরা হবে: স্বরাষ্ট্রমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জের টুঙ্গিপাড়া থানায় অগ্নিসংযোগ ও স্থানীয় সংসদ সদস্যের বাড়িতে হামলার ঘটনায় কার্যক্রম নিষিদ্ধ আওয়ামী লীগের বিরুদ্ধে তীব্র হুঁশিয়ারি উচ্চারণ করেছেন স্বরাষ্ট্রমন্ত্রী সালাহউদ্দিন আহমদ। তিনি ঘোষণা দিয়েছেন, আজ হোক বা কাল হোক, প্রতিটি ভিডিও ফুটেজ, ছবি ও অডিও রেকর্ড দেখে দুষ্কৃতকারীদের সবাইকে আইনের&lt;/p&gt;</description>
      <source url="https://ekattor.tv/national/97877/%E0%A6%AD%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A6%93-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A7%87-%E0%A6%B8%E0%A6%AC-%E0%A6%A6%E0%A7%81%E0%A6%B7%E0%A7%8D%E0%A6%95%E0%A7%83%E0%A6%A4%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%A7%E0%A6%B0%E0%A6%BE-%E0%A6%B9%E0%A6%AC%E0%A7%87">একাত্তর</source>
    </item>

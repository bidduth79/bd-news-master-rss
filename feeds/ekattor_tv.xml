      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/c920d4f7328a3c18871bd53f4526341f-6af616694d280.jpg?jadewits_media_id=64811" medium="image" />

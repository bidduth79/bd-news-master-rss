      <guid isPermaLink="true">https://ekattor.tv/politics/98598/%E0%A7%A7-%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%B8%E0%A7%8B%E0%A6%B9%E0%A6%B0%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A7%9F-%E0%A6%A6%E0%A6%BF%E0%A6%AC%E0%A6%B8%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Fri, 27 Nov 2026 23:23:39 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/1746076653f85c11170aa6a0e4db9070-6b09bc8fd1db4.jpg?jadewits_media_id=66165" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/1746076653f85c11170aa6a0e4db9070-6b09bc8fd1db4.jpg?jadewits_media_id=66165" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/1746076653f85c11170aa6a0e4db9070-6b09bc8fd1db4.jpg?jadewits_media_id=66165" style="max-width:100%;height:auto;margin-bottom:10px;" alt="১ ডিসেম্বর সোহরাওয়ার্দীতে বিএনপির বিজয় দিবসের সমাবেশ" /&gt;&lt;/p&gt;&lt;p&gt;মহান বিজয় দিবস উপলক্ষে মাসব্যাপী কর্মসূচির ঢাকঢোল পেটাতে যাচ্ছে বাংলাদেশ জাতীয়তাবাদী দল (বিএনপি)। এই কর্মসূচির উদ্বোধনী সমাবেশ আগামী ১ ডিসেম্বর রাজধানীর সোহরাওয়ার্দী উদ্যানে অনুষ্ঠিত হবে। ওই দিন দুপুর ২টায় সমাবেশ শুরু হবে এবং এতে প্রধান অতিথি হিসেবে উপস্থিত থাকবেন বিএনপি চেয়ারম্যান ও প্রধানমন্ত্রী ত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/politics/98598/%E0%A7%A7-%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%B8%E0%A7%8B%E0%A6%B9%E0%A6%B0%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A7%9F-%E0%A6%A6%E0%A6%BF%E0%A6%AC%E0%A6%B8%E0%A7%87%E0%A6%B0">একাত্তর</source>
    </item>
    <item>
      <title>ডিসেম্বরে চার উপজেলায় ফ্যামিলি কার্ড বিতরণ করবেন প্রধানমন্ত্রী</title>
      <link>https://ekattor.tv/national/98597/%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%89%E0%A6%AA%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%AB%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%BF-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A1-%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A6%B0%E0%A6%A3-%E0%A6%95%E0%A6%B0%E0%A6%AC%E0%A7%87%E0%A6%A8</link>
      <guid isPermaLink="true">https://ekattor.tv/national/98597/%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%89%E0%A6%AA%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%AB%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%BF-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A1-%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A6%B0%E0%A6%A3-%E0%A6%95%E0%A6%B0%E0%A6%AC%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Fri, 27 Nov 2026 21:18:50 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/ec1d2072fa91892756ee60fe59656802-6b099f532d6dc.jpg?jadewits_media_id=66164" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/ec1d2072fa91892756ee60fe59656802-6b099f532d6dc.jpg?jadewits_media_id=66164" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/27/ec1d2072fa91892756ee60fe59656802-6b099f532d6dc.jpg?jadewits_media_id=66164" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডিসেম্বরে চার উপজেলায় ফ্যামিলি কার্ড বিতরণ করবেন প্রধানমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;আগামী ডিসেম্বর মাসে দেশের ২৬৮টি উপজেলায় ফ্যামিলি কার্ড বিতরণ কর্মসূচি অনুষ্ঠিত হবে। এর মধ্যে চারটি উপজেলায় সরাসরি উপস্থিত থেকে বিতরণ অনুষ্ঠানে অংশ নেবেন প্রধানমন্ত্রী তারেক রহমান। বাকি ২৬৪টি উপজেলায় ভিডিও কনফারেন্সের মাধ্যমে যুক্ত থাকবেন তিনি।						বিস্তারিত&lt;/p&gt;</description>

      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/89a1b197df905739e379cb69bbfe916a-6af5c9f0ea050.jpg?jadewits_media_id=64803" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অবশেষে এনভিডিয়া থেকে সরে দাঁড়ালেন জেনসেন হুয়াং" /&gt;&lt;/p&gt;&lt;p&gt;পরকীয়া কেলেঙ্কারি এবং জাতীয় নিরাপত্তার ঝুঁকির মতো স্পর্শকাতর অভিযোগের মুখে অবশেষে বিশ্বখ্যাত চিপ নির্মাতা ও প্রযুক্তি জায়ান্ট এনভিডিয়ার প্রেসিডেন্ট ও প্রধান নির্বাহী কর্মকর্তার (সিইও) পদ থেকে সরে দাঁড়ালেন জেনসেন হুয়াং। তাৎক্ষণিকভাবে কার্যকর হওয়া এই পদত্যাগের মধ্য দিয়ে কৃত্রিম বুদ্ধিমত্তা (এআই) খাতের&lt;/p&gt;</description>
      <source url="https://ekattor.tv/international/america/97571/%E0%A6%85%E0%A6%AC%E0%A6%B6%E0%A7%87%E0%A6%B7%E0%A7%87-%E0%A6%8F%E0%A6%A8%E0%A6%AD%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A7%9F%E0%A6%BE-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A7%87-%E0%A6%A6%E0%A6%BE%E0%A6%81%E0%A7%9C%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A6%B8%E0%A7%87%E0%A6%A8-%E0%A6%B9%E0%A7%81%E0%A7%9F%E0%A6%BE%E0%A6%82">একাত্তর</source>

      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/07/14/dd23865be4007f0b74cc55c094fafe72-6a55ccecae180.jpg?jadewits_media_id=57636" length="0" type="image/jpeg" />

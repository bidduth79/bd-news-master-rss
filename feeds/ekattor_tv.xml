    <item>
      <title>ইউকে ও আইরিশ বক্স অফিসেও ইতিহাস গড়লো রামায়াণ</title>
      <link>https://ekattor.tv/entertainment/bollywood/97477/%E0%A6%87%E0%A6%89%E0%A6%95%E0%A7%87-%E0%A6%93-%E0%A6%86%E0%A6%87%E0%A6%B0%E0%A6%BF%E0%A6%B6-%E0%A6%AC%E0%A6%95%E0%A7%8D%E0%A6%B8-%E0%A6%85%E0%A6%AB%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%93-%E0%A6%87%E0%A6%A4%E0%A6%BF%E0%A6%B9%E0%A6%BE%E0%A6%B8-%E0%A6%97%E0%A7%9C%E0%A6%B2%E0%A7%8B-%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%A3</link>
      <guid isPermaLink="true">https://ekattor.tv/entertainment/bollywood/97477/%E0%A6%87%E0%A6%89%E0%A6%95%E0%A7%87-%E0%A6%93-%E0%A6%86%E0%A6%87%E0%A6%B0%E0%A6%BF%E0%A6%B6-%E0%A6%AC%E0%A6%95%E0%A7%8D%E0%A6%B8-%E0%A6%85%E0%A6%AB%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%93-%E0%A6%87%E0%A6%A4%E0%A6%BF%E0%A6%B9%E0%A6%BE%E0%A6%B8-%E0%A6%97%E0%A7%9C%E0%A6%B2%E0%A7%8B-%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%A3</guid>
      <pubDate>Wed, 11 Nov 2026 16:04:55 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/c0c391b4dabc7940492a11692ff9e31a-6af43dbae9d96.jpg?jadewits_media_id=64672" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/c0c391b4dabc7940492a11692ff9e31a-6af43dbae9d96.jpg?jadewits_media_id=64672" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/11/c0c391b4dabc7940492a11692ff9e31a-6af43dbae9d96.jpg?jadewits_media_id=64672" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইউকে ও আইরিশ বক্স অফিসেও ইতিহাস গড়লো রামায়াণ" /&gt;&lt;/p&gt;&lt;p&gt;ভারতে যখন রণবীর কাপুরের রামায়ন একের পর এক ইতিহাস গড়ছে, তখন যুক্তরাজ্য ও আয়ারল্যান্ডের বক্স অফিসে রীতিমতো কাঁপিয়ে দিয়েছে সনির অ্যানিমেটেড পৌরাণিক অ্যাডভেঞ্চার ছবি ‘রামায়ণ: রাইজ অফ এ লিজেন্ড’। সব রেকর্ড চূর্ণ-বিচূর্ণ করে এই প্রথম কোনো ভারতীয় ফিচার ছবি জায়গা করে নিয়েছে বক্স অফিসের একেবারে শীর্ষ সিংহাসন&lt;/p&gt;</description>
      <source url="https://ekattor.tv/entertainment/bollywood/97477/%E0%A6%87%E0%A6%89%E0%A6%95%E0%A7%87-%E0%A6%93-%E0%A6%86%E0%A6%87%E0%A6%B0%E0%A6%BF%E0%A6%B6-%E0%A6%AC%E0%A6%95%E0%A7%8D%E0%A6%B8-%E0%A6%85%E0%A6%AB%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%93-%E0%A6%87%E0%A6%A4%E0%A6%BF%E0%A6%B9%E0%A6%BE%E0%A6%B8-%E0%A6%97%E0%A7%9C%E0%A6%B2%E0%A7%8B-%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%A3">একাত্তর</source>

    <item>
      <title>উপকূলের উন্নয়নে ২০০ মিলিয়ন ডলার দিচ্ছে বিশ্বব্যাংক, নজর ঢাকার বস্তিতেও</title>
      <link>https://ekattor.tv/national/98239/%E0%A6%89%E0%A6%AA%E0%A6%95%E0%A7%82%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A6%AF%E0%A6%BC%E0%A6%A8%E0%A7%87-%E0%A7%A8%E0%A7%A6%E0%A7%A6-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%A8-%E0%A6%A1%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BF%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87</link>
      <guid isPermaLink="true">https://ekattor.tv/national/98239/%E0%A6%89%E0%A6%AA%E0%A6%95%E0%A7%82%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A6%AF%E0%A6%BC%E0%A6%A8%E0%A7%87-%E0%A7%A8%E0%A7%A6%E0%A7%A6-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%A8-%E0%A6%A1%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BF%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87</guid>
      <pubDate>Mon, 23 Nov 2026 12:04:02 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/05dd2f6f72d7c2b736c0821556eb5047-6b03d73f73f24.jpg?jadewits_media_id=65710" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/05dd2f6f72d7c2b736c0821556eb5047-6b03d73f73f24.jpg?jadewits_media_id=65710" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/05dd2f6f72d7c2b736c0821556eb5047-6b03d73f73f24.jpg?jadewits_media_id=65710" style="max-width:100%;height:auto;margin-bottom:10px;" alt="উপকূলের উন্নয়নে ২০০ মিলিয়ন ডলার দিচ্ছে বিশ্বব্যাংক, নজর ঢাকার বস্তিতেও" /&gt;&lt;/p&gt;&lt;p&gt;দেশের উপকূলীয় অঞ্চলের মানুষের জীবনমান উন্নয়নে ২০০ মিলিয়ন মার্কিন ডলার আর্থিক সহায়তা দিতে সম্মত হয়েছে বিশ্বব্যাংক। সোমবার (২৩ নভেম্বর) সকালে সচিবালয়ে বিশ্বব্যাংকের একটি প্রতিনিধিদলের সঙ্গে বৈঠক শেষে স্থানীয় সরকার, পল্লী উন্নয়ন ও সমবায়মন্ত্রী ড. আবদুল মঈন খান সাংবাদিকদের এ তথ্য জানিয়েছেন।   &lt;/p&gt;</description>
      <source url="https://ekattor.tv/national/98239/%E0%A6%89%E0%A6%AA%E0%A6%95%E0%A7%82%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A6%AF%E0%A6%BC%E0%A6%A8%E0%A7%87-%E0%A7%A8%E0%A7%A6%E0%A7%A6-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%A8-%E0%A6%A1%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BF%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87">একাত্তর</source>
    </item>

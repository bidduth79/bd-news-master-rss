    <item>
      <title>স্কুল-কলেজে কমিটি গঠনে নতুন নির্দেশনা</title>
      <link>https://ekattor.tv/education/98382/%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2-%E0%A6%95%E0%A6%B2%E0%A7%87%E0%A6%9C%E0%A7%87-%E0%A6%95%E0%A6%AE%E0%A6%BF%E0%A6%9F%E0%A6%BF-%E0%A6%97%E0%A6%A0%E0%A6%A8%E0%A7%87-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%A8%E0%A6%BE</link>
      <guid isPermaLink="true">https://ekattor.tv/education/98382/%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2-%E0%A6%95%E0%A6%B2%E0%A7%87%E0%A6%9C%E0%A7%87-%E0%A6%95%E0%A6%AE%E0%A6%BF%E0%A6%9F%E0%A6%BF-%E0%A6%97%E0%A6%A0%E0%A6%A8%E0%A7%87-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%A8%E0%A6%BE</guid>
      <pubDate>Tue, 24 Nov 2026 20:59:22 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/75d40ae65184f971fe6bd2f16f1aea9d-6b05a642834d7.jpg?jadewits_media_id=65882" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/75d40ae65184f971fe6bd2f16f1aea9d-6b05a642834d7.jpg?jadewits_media_id=65882" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/75d40ae65184f971fe6bd2f16f1aea9d-6b05a642834d7.jpg?jadewits_media_id=65882" style="max-width:100%;height:auto;margin-bottom:10px;" alt="স্কুল-কলেজে কমিটি গঠনে নতুন নির্দেশনা" /&gt;&lt;/p&gt;&lt;p&gt;বেসরকারি স্কুল ও কলেজের গভর্নিং বডি এবং ম্যানেজিং কমিটি গঠনে নতুন নির্দেশনা দিয়েছে শিক্ষা মন্ত্রণালয়। নতুন নির্দেশনা অনুযায়ী, এসব কমিটির সভাপতি হতে হলে সাধারণভাবে ন্যূনতম স্নাতক বা সমমানের ডিগ্রি থাকতে হবে। তবে বিশেষ ক্ষেত্রে শিক্ষার প্রসার ও উন্নয়নে কোনো ব্যক্তির বিশেষ অবদান বা যোগ্যতা বিবেচনায় এ শ&lt;/p&gt;</description>
      <source url="https://ekattor.tv/education/98382/%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%81%E0%A6%B2-%E0%A6%95%E0%A6%B2%E0%A7%87%E0%A6%9C%E0%A7%87-%E0%A6%95%E0%A6%AE%E0%A6%BF%E0%A6%9F%E0%A6%BF-%E0%A6%97%E0%A6%A0%E0%A6%A8%E0%A7%87-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%A8%E0%A6%BE">একাত্তর</source>
    </item>
    <item>
      <title>‘শেখ হাসিনা প্রয়োজনে আওয়ামী লীগকেও কোরবানি দিতে পারেন’</title>
      <link>https://ekattor.tv/politics/98381/%E2%80%98%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%9F%E0%A7%8B%E0%A6%9C%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A6%95%E0%A7%87%E0%A6%93-%E0%A6%95%E0%A7%8B%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87</link>
      <guid isPermaLink="true">https://ekattor.tv/politics/98381/%E2%80%98%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%9F%E0%A7%8B%E0%A6%9C%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A6%95%E0%A7%87%E0%A6%93-%E0%A6%95%E0%A7%8B%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87</guid>
      <pubDate>Tue, 24 Nov 2026 20:58:57 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2025/04/28/ab814e099a0827ae5d51bd75dece9767-680f4249a9cc4.jpg?jadewits_media_id=37312" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2025/04/28/ab814e099a0827ae5d51bd75dece9767-680f4249a9cc4.jpg?jadewits_media_id=37312" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2025/04/28/ab814e099a0827ae5d51bd75dece9767-680f4249a9cc4.jpg?jadewits_media_id=37312" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘শেখ হাসিনা প্রয়োজনে আওয়ামী লীগকেও কোরবানি দিতে পারেন’" /&gt;&lt;/p&gt;&lt;p&gt;কার্যক্রম নিষিদ্ধ আওয়ামী লীগের পলাতক সভাপতি শেখ হাসিনা দেশে অরাজকতা সৃষ্টির জন্য ‘সুইসাইড বম্বার’ চাইছেন বলে ধারণা প্রকাশ করেছেন সাবেক অন্তর্বর্তী সরকারের আইন উপদেষ্টা ড. আসিফ নজরুল। তাঁর মতে, এই সুইসাইড বোমায় শেখ হাসিনা নিজে নন, বরং আওয়ামী লীগই ক্ষতবিক্ষত হবে।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/politics/98381/%E2%80%98%E0%A6%B6%E0%A7%87%E0%A6%96-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%9F%E0%A7%8B%E0%A6%9C%E0%A6%A8%E0%A7%87-%E0%A6%86%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A6%95%E0%A7%87%E0%A6%93-%E0%A6%95%E0%A7%8B%E0%A6%B0%E0%A6%AC%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87">একাত্তর</source>
    </item>

      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/7feb267ed2a6397a427d5cbfed917a70-6af2cd4606478.jpg?jadewits_media_id=64577" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/7feb267ed2a6397a427d5cbfed917a70-6af2cd4606478.jpg?jadewits_media_id=64577" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফতুল্লায় মাদ্রাসায় আগুন: বার্ন ইনস্টিটিউটে ৬৩, আইসিইউতে চার ও লাইফ সাপোর্টে এক" /&gt;&lt;/p&gt;&lt;p&gt;নারায়ণগঞ্জের ফতুল্লায় একটি মাদ্রাসায় আগুন লেগে ধোঁয়ায় অসুস্থ হয়ে পড়া ৬৩ শিক্ষার্থীকে ঢাকার জাতীয় বার্ন ও প্লাস্টিক সার্জারি ইনস্টিটিউটে ভর্তি করা হয়েছে। প্রত্যক্ষ ও সরাসরি আগুনে পোড়া না গেলেও ঘন ধোঁয়া শ্বাসের সঙ্গে ভেতরে প্রবেশ করায় এদের অধিকাংশেরই শ্বাসনালি মারাত্মকভাবে ক্ষতিগ্রস্ত হয়েছে।						বিস্&lt;/p&gt;</description>
      <source url="https://ekattor.tv/country/dhaka/97409/%E0%A6%AB%E0%A6%A4%E0%A7%81%E0%A6%B2%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A7%9F-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A8-%E0%A6%87%E0%A6%A8%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BF%E0%A6%9F%E0%A6%BF%E0%A6%89%E0%A6%9F%E0%A7%87-%E0%A7%AC%E0%A7%A9">একাত্তর</source>

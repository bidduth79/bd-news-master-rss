      <guid isPermaLink="true">https://ekattor.tv/sports/cricket/98094/%E0%A6%8F%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE-%E0%A6%95%E0%A6%BE%E0%A6%AA%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%87-%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%80%E0%A7%9F-%E0%A6%B8%E0%A6%BF%E0%A6%B0%E0%A6%BF%E0%A6%9C-%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A6%A4%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6</guid>
      <pubDate>Sat, 21 Nov 2026 15:05:47 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/5921d7c3abbdda21c63f5088a965b421-6b015dbf18b31.jpg?jadewits_media_id=65524" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/5921d7c3abbdda21c63f5088a965b421-6b015dbf18b31.jpg?jadewits_media_id=65524" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/21/5921d7c3abbdda21c63f5088a965b421-6b015dbf18b31.jpg?jadewits_media_id=65524" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এশিয়া কাপের আগে ত্রিদেশীয় সিরিজ খেলতে চায় বাংলাদেশ" /&gt;&lt;/p&gt;&lt;p&gt;আগামী বছরের জুনে ঘরের মাঠে বসতে যাচ্ছে এশিয়া কাপের ১৮ তম আসর। এই টুর্নামেন্টের প্রস্তুতি ঝালিয়ে নিতে পাকিস্তান ও শ্রীলঙ্কাকে নিয়ে দেশের মাটিতে একটি ত্রিদেশীয় সিরিজ আয়োজন করতে চায় বাংলাদেশ ক্রিকেট বোর্ড (বিসিবি)। ক্রিকেটবিষয়ক ওয়েবসাইট ক্রিকবাজের এক প্রতিবেদনে জানানো হয়েছে, বিসিবির এই উদ্যোগে প্রাথমিক&lt;/p&gt;</description>
      <source url="https://ekattor.tv/sports/cricket/98094/%E0%A6%8F%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE-%E0%A6%95%E0%A6%BE%E0%A6%AA%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%87-%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%80%E0%A7%9F-%E0%A6%B8%E0%A6%BF%E0%A6%B0%E0%A6%BF%E0%A6%9C-%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A6%A4%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6">একাত্তর</source>

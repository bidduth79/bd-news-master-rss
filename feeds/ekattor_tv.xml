      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/816066e243e956ae281b22907a4fa7c8-6afe0aca5f92e.jpg?jadewits_media_id=65325" length="0" type="image/jpeg" />

    <item>
      <title>গভীর নিম্নচাপ থেকে ঘূর্ণিঝড় ‘আকভান’, গতিপথ কোন দিকে?</title>
      <link>https://ekattor.tv/environment/weather/97811/%E0%A6%97%E0%A6%AD%E0%A7%80%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%AE%E0%A7%8D%E0%A6%A8%E0%A6%9A%E0%A6%BE%E0%A6%AA-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%98%E0%A7%82%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A6%BF%E0%A6%9D%E0%A7%9C-%E2%80%98%E0%A6%86%E0%A6%95%E0%A6%AD%E0%A6%BE%E0%A6%A8%E2%80%99-%E0%A6%97%E0%A6%A4%E0%A6%BF%E0%A6%AA%E0%A6%A5-%E0%A6%95%E0%A7%8B%E0%A6%A8</link>

      <guid isPermaLink="true">https://ekattor.tv/national/97510/%E0%A6%B8%E0%A6%AC%E0%A7%81%E0%A6%9C-%E0%A6%B6%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A6%BE%E0%A7%9F%E0%A6%A8%E0%A7%87-%E0%A6%A6%E0%A7%80%E0%A6%B0%E0%A7%8D%E0%A6%98%E0%A6%AE%E0%A7%87%E0%A7%9F%E0%A6%BE%E0%A6%A6%E0%A6%BF-%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A7%9F%E0%A6%A8-%E0%A6%93-%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AF%E0%A7%8D%E0%A6%AF</guid>
      <pubDate>Thu, 12 Nov 2026 00:25:29 +0600</pubDate>

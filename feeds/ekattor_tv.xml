      <guid isPermaLink="true">https://ekattor.tv/national/97569/%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%9A%E0%A6%BE%E0%A6%95%E0%A6%B0%E0%A6%BF%E0%A6%9C%E0%A7%80%E0%A6%AC%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%81%E0%A6%96%E0%A6%AC%E0%A6%B0-%E0%A6%AA%E0%A7%87%E0%A6%A8%E0%A6%B6%E0%A6%A8-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%B2%E0%A7%8B</guid>
      <pubDate>Thu, 12 Nov 2026 22:08:54 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2025/12/15/2c4e1a78b51877cf843c8eaabfc43637-6940149f7d57f.jpg?jadewits_media_id=45326" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2025/12/15/2c4e1a78b51877cf843c8eaabfc43637-6940149f7d57f.jpg?jadewits_media_id=45326" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2025/12/15/2c4e1a78b51877cf843c8eaabfc43637-6940149f7d57f.jpg?jadewits_media_id=45326" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সরকারি চাকরিজীবীদের সুখবর, পেনশন বাড়লো" /&gt;&lt;/p&gt;&lt;p&gt;সরকারি চাকরিজীবীদের পেনশন ও অবসর-উত্তর সুবিধায় গুরুত্বপূর্ণ পরিবর্তন এনেছে সরকার। নতুন জাতীয় বেতনস্কেল অনুযায়ী অবসরপ্রাপ্ত সরকারি কর্মচারীদের নিট পেনশন ৫৫ থেকে ১০০ শতাংশ পর্যন্ত বৃদ্ধির বিধান রেখে প্রজ্ঞাপন জারি করেছে অর্থ মন্ত্রণালয়। একই সঙ্গে সর্বনিম্ন নিট পেনশন ১০ হাজার টাকা এবং সর্বোচ্চ ৭০ হা&lt;/p&gt;</description>
      <source url="https://ekattor.tv/national/97569/%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%9A%E0%A6%BE%E0%A6%95%E0%A6%B0%E0%A6%BF%E0%A6%9C%E0%A7%80%E0%A6%AC%E0%A7%80%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%81%E0%A6%96%E0%A6%AC%E0%A6%B0-%E0%A6%AA%E0%A7%87%E0%A6%A8%E0%A6%B6%E0%A6%A8-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%B2%E0%A7%8B">একাত্তর</source>
    </item>

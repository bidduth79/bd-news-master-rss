    <item>
      <title>বিতর্ক মাড়িয়ে এনভিডিয়ায় জেনসেনের নাটকীয় প্রত্যাবর্তন</title>
      <link>https://ekattor.tv/technology/98303/%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%95-%E0%A6%AE%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%8F%E0%A6%A8%E0%A6%AD%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A6%B8%E0%A7%87%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%9F%E0%A6%95%E0%A7%80%E0%A7%9F</link>
      <guid isPermaLink="true">https://ekattor.tv/technology/98303/%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%95-%E0%A6%AE%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%8F%E0%A6%A8%E0%A6%AD%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A6%B8%E0%A7%87%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%9F%E0%A6%95%E0%A7%80%E0%A7%9F</guid>
      <pubDate>Tue, 24 Nov 2026 02:13:23 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/d2619725baa8fd0fb57a145b908fbb47-6b049e5820e64.jpg?jadewits_media_id=65789" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/d2619725baa8fd0fb57a145b908fbb47-6b049e5820e64.jpg?jadewits_media_id=65789" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/d2619725baa8fd0fb57a145b908fbb47-6b049e5820e64.jpg?jadewits_media_id=65789" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিতর্ক মাড়িয়ে এনভিডিয়ায় জেনসেনের নাটকীয় প্রত্যাবর্তন" /&gt;&lt;/p&gt;&lt;p&gt;কথিত এক চীনা গুপ্তচরসহ একাধিক বিবাহবহির্ভূত সম্পর্কের বিতর্কে পদত্যাগ করার মাত্র এক সপ্তাহ পরই নাটকীয়ভাবে প্রযুক্তি জায়ান্ট এনভিডিয়ার প্রধান নির্বাহী কর্মকর্তা (সিইও) পদে ফিরে এসেছেন জেনসেন হুয়াং। সোমবার এক জরুরি বৈঠক শেষে এনভিডিয়ার পরিচালনা পর্ষদ তাঁকে প্রেসিডেন্ট ও সিইও পদে পুনর্বহাল করার ঘোষণা দে&lt;/p&gt;</description>
      <source url="https://ekattor.tv/technology/98303/%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%95-%E0%A6%AE%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%8F%E0%A6%A8%E0%A6%AD%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A6%B8%E0%A7%87%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%9F%E0%A6%95%E0%A7%80%E0%A7%9F">একাত্তর</source>
    </item>
    <item>
      <title>স্বর্ণদ্বীপে তিন বাহিনীর যৌথ মহড়া দেখবেন প্রধানমন্ত্রী</title>
      <link>https://ekattor.tv/national/98302/%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%80%E0%A6%AA%E0%A7%87-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%AF%E0%A7%8C%E0%A6%A5-%E0%A6%AE%E0%A6%B9%E0%A7%9C%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%AC%E0%A7%87%E0%A6%A8</link>
      <guid isPermaLink="true">https://ekattor.tv/national/98302/%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%80%E0%A6%AA%E0%A7%87-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%AF%E0%A7%8C%E0%A6%A5-%E0%A6%AE%E0%A6%B9%E0%A7%9C%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%AC%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Tue, 24 Nov 2026 01:53:43 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/07/09/52f4bfd19e8419917ba6bc47e72cc607-6a4f77edc1f71.jpg?jadewits_media_id=57325" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/07/09/52f4bfd19e8419917ba6bc47e72cc607-6a4f77edc1f71.jpg?jadewits_media_id=57325" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/07/09/52f4bfd19e8419917ba6bc47e72cc607-6a4f77edc1f71.jpg?jadewits_media_id=57325" style="max-width:100%;height:auto;margin-bottom:10px;" alt="স্বর্ণদ্বীপে তিন বাহিনীর যৌথ মহড়া দেখবেন প্রধানমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;নোয়াখালীর স্বর্ণদ্বীপে বাংলাদেশ সেনাবাহিনী, নৌবাহিনী ও বিমানবাহিনীর বিশেষ যৌথ প্রশিক্ষণ মহড়া পরিদর্শন করবেন প্রধানমন্ত্রী তারেক রহমান। মঙ্গলবার সকালে হেলিকপ্টারে করে তিনি স্বর্ণদ্বীপে পৌঁছাবেন। সেখানে সশস্ত্র বাহিনীর স্পেশাল ফোর্সগুলোর সমন্বয়ে প্রথমবারের মতো আয়োজিত ‘জয়েন্ট স্পেশাল ফোর্সেস এক্সারসাইজ&lt;/p&gt;</description>
      <source url="https://ekattor.tv/national/98302/%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%80%E0%A6%AA%E0%A7%87-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%AF%E0%A7%8C%E0%A6%A5-%E0%A6%AE%E0%A6%B9%E0%A7%9C%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%AC%E0%A7%87%E0%A6%A8">একাত্তর</source>
    </item>
    <item>
      <title>মিরপুরে বাসে আগুন, চালক-হেলপার পুলিশ হেফাজতে</title>
      <link>https://ekattor.tv/capital/98301/%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%95-%E0%A6%B9%E0%A7%87%E0%A6%B2%E0%A6%AA%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%B9%E0%A7%87%E0%A6%AB%E0%A6%BE%E0%A6%9C%E0%A6%A4%E0%A7%87</link>
      <guid isPermaLink="true">https://ekattor.tv/capital/98301/%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%95-%E0%A6%B9%E0%A7%87%E0%A6%B2%E0%A6%AA%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%B9%E0%A7%87%E0%A6%AB%E0%A6%BE%E0%A6%9C%E0%A6%A4%E0%A7%87</guid>
      <pubDate>Tue, 24 Nov 2026 01:49:22 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/940a01104faa1f3413655f96b4d2407c-6b04989edf8ee.jpg?jadewits_media_id=65788" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/940a01104faa1f3413655f96b4d2407c-6b04989edf8ee.jpg?jadewits_media_id=65788" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/24/940a01104faa1f3413655f96b4d2407c-6b04989edf8ee.jpg?jadewits_media_id=65788" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মিরপুরে বাসে আগুন, চালক-হেলপার পুলিশ হেফাজতে" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর মিরপুর ১ নম্বরে সনি সিনেমা হলের সামনে বসুমতি পরিবহনের একটি যাত্রীবাহী বাসে আগুন দেওয়ার ঘটনা ঘটেছে। সোমবার সন্ধ্যা সাড়ে ৭টার দিকে দুর্বৃত্তরা বাসটিতে অগ্নিসংযোগ করে। এ ঘটনার পর উত্তেজিত জনতা ও স্থানীয় নেতা-কর্মীদের মারধরের হাত থেকে বাসটির চালক ও হেলপারকে উদ্ধার করে নিজেদের হেফাজতে নিয়েছে পুল&lt;/p&gt;</description>
      <source url="https://ekattor.tv/capital/98301/%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%95-%E0%A6%B9%E0%A7%87%E0%A6%B2%E0%A6%AA%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6-%E0%A6%B9%E0%A7%87%E0%A6%AB%E0%A6%BE%E0%A6%9C%E0%A6%A4%E0%A7%87">একাত্তর</source>
    </item>
    <item>
      <title>ফ্যাসিস্টের নৈরাজ্য রুখতে রাজপথে নামছে এনসিপি</title>
      <link>https://ekattor.tv/politics/98300/%E0%A6%AB%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A7%88%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A7%8D%E0%A6%AF-%E0%A6%B0%E0%A7%81%E0%A6%96%E0%A6%A4%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A6%9B%E0%A7%87-%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF</link>
      <guid isPermaLink="true">https://ekattor.tv/politics/98300/%E0%A6%AB%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A7%88%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A7%8D%E0%A6%AF-%E0%A6%B0%E0%A7%81%E0%A6%96%E0%A6%A4%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A6%9B%E0%A7%87-%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF</guid>

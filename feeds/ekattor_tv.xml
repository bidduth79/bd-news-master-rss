      <guid isPermaLink="true">https://ekattor.tv/politics/97577/%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%AC%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A7%87-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%81%E0%A6%AC%E0%A7%8D%E0%A6%A7</guid>
      <pubDate>Fri, 13 Nov 2026 02:26:55 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/ea68fd498d5daf27cab8bc45a153cd84-6af62085d0f67.jpg?jadewits_media_id=64814" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/ea68fd498d5daf27cab8bc45a153cd84-6af62085d0f67.jpg?jadewits_media_id=64814" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/13/ea68fd498d5daf27cab8bc45a153cd84-6af62085d0f67.jpg?jadewits_media_id=64814" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাড়িতে আগুন: স্বরাষ্ট্রমন্ত্রীর বক্তব্যে ক্ষুব্ধ নুসরাত" /&gt;&lt;/p&gt;&lt;p&gt;কুষ্টিয়ার দৌলতপুরে নিজের পৈতৃক বাড়িতে পেট্রলবোমা নিক্ষেপ করে আগুন দেওয়ার অভিযোগের ঘটনায় জাতীয় সংসদে স্বরাষ্ট্রমন্ত্রী সালাহউদ্দিন আহমদের দেওয়া বক্তব্যে তীব্র ক্ষোভ প্রকাশ করেছেন সংরক্ষিত নারী আসনের সংসদ সদস্য ও এনসিপির যুগ্ম আহ্বায়ক নুসরাত তাবাসসুম।						বিস্তারিত&lt;/p&gt;</description>

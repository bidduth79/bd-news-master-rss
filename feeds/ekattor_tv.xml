      <title>জোরালো বিস্ফোরণে উড়ে গেলো আরামকোর দরজা-জানালা!</title>
      <link>https://ekattor.tv/international/middle-east/97350/%E0%A6%9C%E0%A7%8B%E0%A6%B0%E0%A6%BE%E0%A6%B2%E0%A7%8B-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%89%E0%A7%9C%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%B2%E0%A7%8B-%E0%A6%86%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%95%E0%A7%8B%E0%A6%B0-%E0%A6%A6%E0%A6%B0%E0%A6%9C%E0%A6%BE-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A6%BE</link>
      <guid isPermaLink="true">https://ekattor.tv/international/middle-east/97350/%E0%A6%9C%E0%A7%8B%E0%A6%B0%E0%A6%BE%E0%A6%B2%E0%A7%8B-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%89%E0%A7%9C%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%B2%E0%A7%8B-%E0%A6%86%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%95%E0%A7%8B%E0%A6%B0-%E0%A6%A6%E0%A6%B0%E0%A6%9C%E0%A6%BE-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A6%BE</guid>
      <pubDate>Sun, 08 Nov 2026 20:15:42 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/08/61797ef5cf43e1c107d691d3ae8fe895-6af07fed41be3.jpg?jadewits_media_id=64502" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/08/61797ef5cf43e1c107d691d3ae8fe895-6af07fed41be3.jpg?jadewits_media_id=64502" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/08/61797ef5cf43e1c107d691d3ae8fe895-6af07fed41be3.jpg?jadewits_media_id=64502" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জোরালো বিস্ফোরণে উড়ে গেলো আরামকোর দরজা-জানালা!" /&gt;&lt;/p&gt;&lt;p&gt;সৌদি আরবের রাজধানী রিয়াদের আকাশসীমায় হুতি বিদ্রোহীদের ছোড়া দুটি ক্ষেপণাস্ত্র ‘সফলভাবে’ প্রতিহত ও ধ্বংস করার দাবি করেছে সৌদি নেতৃত্বাধীন সামরিক জোট। তবে এই আকাশযুদ্ধের ঠিক পরপরই রিয়াদের কিং আবদুল্লাহ ফিন্যান্সিয়াল ডিস্ট্রিক্টে অবস্থিত দেশটির বৃহত্তম রাষ্ট্রীয় জ্বালানি কোম্পানি ‘সৌদি আরামকো’র ভবন&lt;/p&gt;</description>
      <source url="https://ekattor.tv/international/middle-east/97350/%E0%A6%9C%E0%A7%8B%E0%A6%B0%E0%A6%BE%E0%A6%B2%E0%A7%8B-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%89%E0%A7%9C%E0%A7%87-%E0%A6%97%E0%A7%87%E0%A6%B2%E0%A7%8B-%E0%A6%86%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%95%E0%A7%8B%E0%A6%B0-%E0%A6%A6%E0%A6%B0%E0%A6%9C%E0%A6%BE-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A6%BE">একাত্তর</source>
    </item>
    <item>
      <title>ইরানের বিরুদ্ধে ইসরাইলের অভিযান এখনো শেষ হয়নি!</title>
      <link>https://ekattor.tv/international/97349/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A6%8F%E0%A6%96%E0%A6%A8%E0%A7%8B-%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%B9%E0%A7%9F%E0%A6%A8%E0%A6%BF</link>
      <guid isPermaLink="true">https://ekattor.tv/international/97349/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A6%8F%E0%A6%96%E0%A6%A8%E0%A7%8B-%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%B9%E0%A7%9F%E0%A6%A8%E0%A6%BF</guid>
      <pubDate>Sun, 08 Nov 2026 20:10:00 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/08/cd28ad9f31320c813184ee8143c6d107-6af082ad15ed3.jpg?jadewits_media_id=64503" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/08/cd28ad9f31320c813184ee8143c6d107-6af082ad15ed3.jpg?jadewits_media_id=64503" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/08/cd28ad9f31320c813184ee8143c6d107-6af082ad15ed3.jpg?jadewits_media_id=64503" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইরানের বিরুদ্ধে ইসরাইলের অভিযান এখনো শেষ হয়নি!" /&gt;&lt;/p&gt;&lt;p&gt;ইরানের বিরুদ্ধে ইসরায়েলের সামরিক লক্ষ্য অর্জন এখনো সম্পূর্ণ হয়নি বলে সোজা জানিয়ে দিয়েছেন দেশটির প্রতিরক্ষামন্ত্রী ইসরাইল কাটজ। তেহরান নতুন করে পারমাণবিক অস্ত্র তৈরির চেষ্টা চালাচ্ছে বলে অভিযোগ তুলে তিনি সতর্ক করেছেন যে, যে কোনো নতুন হামলায় হিজবুল্লাহ ইরানের সঙ্গে যোগ দিলে তাদের ওপর চরম আঘাত হানা &lt;/p&gt;</description>
      <source url="https://ekattor.tv/international/97349/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%87%E0%A6%B8%E0%A6%B0%E0%A6%BE%E0%A6%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A6%8F%E0%A6%96%E0%A6%A8%E0%A7%8B-%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%B9%E0%A7%9F%E0%A6%A8%E0%A6%BF">একাত্তর</source>
    </item>

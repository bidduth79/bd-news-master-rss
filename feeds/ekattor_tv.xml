      <guid isPermaLink="true">https://ekattor.tv/business/98667/%E0%A6%85%E0%A6%95%E0%A7%8D%E0%A6%9F%E0%A7%8B%E0%A6%AC%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A7%87%E0%A7%9C%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%A3%E0%A7%8D%E0%A6%AF-%E0%A6%AC%E0%A6%BE%E0%A6%A3%E0%A6%BF%E0%A6%9C%E0%A7%8D%E0%A6%AF-%E0%A6%98%E0%A6%BE%E0%A6%9F%E0%A6%A4%E0%A6%BF</guid>
      <pubDate>Sat, 28 Nov 2026 23:22:50 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/d6cb1cc8c5f1dea637448bda44c26c29-6b0b0de68a19f.jpg?jadewits_media_id=66246" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/d6cb1cc8c5f1dea637448bda44c26c29-6b0b0de68a19f.jpg?jadewits_media_id=66246" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/28/d6cb1cc8c5f1dea637448bda44c26c29-6b0b0de68a19f.jpg?jadewits_media_id=66246" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অক্টোবরে বেড়েছে যুক্তরাষ্ট্রের পণ্য বাণিজ্য ঘাটতি" /&gt;&lt;/p&gt;&lt;p&gt;কৃত্রিম বুদ্ধিমত্তা বা এআই অবকাঠামো নির্মাণের চাহিদা বাড়ায় অক্টোবরে যুক্তরাষ্ট্রের পণ্য বাণিজ্য ঘাটতি উল্লেখযোগ্যভাবে বৃদ্ধি পেয়েছে। মার্কিন বাণিজ্য দপ্তরের সাম্প্রতিক প্রতিবেদনে দেখা যায়, আমদানি রেকর্ড উচ্চতায় পৌঁছানোয় চতুর্থ প্রান্তিকে দেশটির সামগ্রিক অর্থনৈতিক প্রবৃদ্ধিতে বাণিজ্য খাত আবারও নেতিবা&lt;/p&gt;</description>
      <source url="https://ekattor.tv/business/98667/%E0%A6%85%E0%A6%95%E0%A7%8D%E0%A6%9F%E0%A7%8B%E0%A6%AC%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A7%87%E0%A7%9C%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%A3%E0%A7%8D%E0%A6%AF-%E0%A6%AC%E0%A6%BE%E0%A6%A3%E0%A6%BF%E0%A6%9C%E0%A7%8D%E0%A6%AF-%E0%A6%98%E0%A6%BE%E0%A6%9F%E0%A6%A4%E0%A6%BF">একাত্তর</source>

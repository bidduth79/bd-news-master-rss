      <guid isPermaLink="true">https://ekattor.tv/sports/cricket/97758/%E0%A6%AE%E0%A7%87%E0%A7%9F%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A7%87%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%89%E0%A7%8E%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%97-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%B2%E0%A6%BF%E0%A6%9F%E0%A6%A8-%E0%A6%B2%E0%A6%BF%E0%A6%96%E0%A6%B2%E0%A7%87%E0%A6%A8-%E2%80%98%E0%A6%B6%E0%A7%81%E0%A6%AD</guid>
      <pubDate>Mon, 16 Nov 2026 14:44:17 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/a20553c503af99f3c91e296e3cd31c93-6afac25031eb7.jpg?jadewits_media_id=65049" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/a20553c503af99f3c91e296e3cd31c93-6afac25031eb7.jpg?jadewits_media_id=65049" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/a20553c503af99f3c91e296e3cd31c93-6afac25031eb7.jpg?jadewits_media_id=65049" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মেয়েকে সেঞ্চুরি উৎসর্গ করলেন লিটন, লিখলেন ‘শুভ জন্মদিন আমার রাজকন্যা’" /&gt;&lt;/p&gt;&lt;p&gt;মেয়ের জন্মদিনে সেঞ্চুরি করে সেই ইনিংস তাকে উৎসর্গ করলেন লিটন দাস। দক্ষিণ আফ্রিকার বিপক্ষে টেস্টের দ্বিতীয় দিনের চতুর্থ ওভারেই মার্কো ইয়ানসেনের বলে পুল করে চার মেরে শতরানের দেখা পান তিনি। এটি টেস্টে লিটনের অষ্টম সেঞ্চুরি।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/sports/cricket/97758/%E0%A6%AE%E0%A7%87%E0%A7%9F%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A7%87%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%89%E0%A7%8E%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%97-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%B2%E0%A6%BF%E0%A6%9F%E0%A6%A8-%E0%A6%B2%E0%A6%BF%E0%A6%96%E0%A6%B2%E0%A7%87%E0%A6%A8-%E2%80%98%E0%A6%B6%E0%A7%81%E0%A6%AD">একাত্তর</source>

      <guid isPermaLink="true">https://ekattor.tv/national/97392/%E2%80%98%E0%A6%AC%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%AC%E0%A7%8D%E0%A6%AF-%E0%A6%B2%E0%A6%BE%E0%A6%89%E0%A6%A1-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1-%E0%A6%95%E0%A7%8D%E0%A6%B2%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%AE%E0%A6%B0%E0%A6%BE-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%86%E0%A6%9B%E0%A6%BF%E2%80%99</guid>
      <pubDate>Mon, 09 Nov 2026 20:46:28 +0600</pubDate>

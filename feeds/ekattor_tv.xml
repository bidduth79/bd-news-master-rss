    <item>
      <title>টিকার আগে বাধ্যতামূলক সাত স্বাস্থ্য পরীক্ষা, মিলবে কোথায়?</title>
      <link>https://ekattor.tv/national/98253/%E0%A6%9F%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A6%A4%E0%A6%BE%E0%A6%AE%E0%A7%82%E0%A6%B2%E0%A6%95-%E0%A6%B8%E0%A6%BE%E0%A6%A4-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A7%8D%E0%A6%AF-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%AC%E0%A7%87</link>
      <guid isPermaLink="true">https://ekattor.tv/national/98253/%E0%A6%9F%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A6%A4%E0%A6%BE%E0%A6%AE%E0%A7%82%E0%A6%B2%E0%A6%95-%E0%A6%B8%E0%A6%BE%E0%A6%A4-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A7%8D%E0%A6%AF-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%AC%E0%A7%87</guid>
      <pubDate>Mon, 23 Nov 2026 14:36:18 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/c131c4426ed86b7390eb04a00f5cf0d2-6b03faf813437.jpg?jadewits_media_id=65722" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/c131c4426ed86b7390eb04a00f5cf0d2-6b03faf813437.jpg?jadewits_media_id=65722" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/c131c4426ed86b7390eb04a00f5cf0d2-6b03faf813437.jpg?jadewits_media_id=65722" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টিকার আগে বাধ্যতামূলক সাত স্বাস্থ্য পরীক্ষা, মিলবে কোথায়?" /&gt;&lt;/p&gt;&lt;p&gt;২০২৭ সালের হজযাত্রীদের টিকা গ্রহণের আগে সাত ধরনের স্বাস্থ্য পরীক্ষা সম্পন্ন করার নির্দেশনা দিয়েছে ধর্ম বিষয়ক মন্ত্রণালয়। দেশের সব জেলা ও উপজেলা পর্যায়ের সরকারি হাসপাতাল এবং নির্ধারিত ‘ক’ শ্রেণির বেসরকারি হাসপাতালে এসব পরীক্ষা করাতে হবে।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/national/98253/%E0%A6%9F%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%A7%E0%A7%8D%E0%A6%AF%E0%A6%A4%E0%A6%BE%E0%A6%AE%E0%A7%82%E0%A6%B2%E0%A6%95-%E0%A6%B8%E0%A6%BE%E0%A6%A4-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A7%8D%E0%A6%AF-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%AC%E0%A7%87">একাত্তর</source>
    </item>
    <item>
      <title>হজের চূড়ান্ত নিবন্ধনের শেষ সময় ১০ ডিসেম্বর</title>
      <link>https://ekattor.tv/national/98252/%E0%A6%B9%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A7%82%E0%A7%9C%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%A8%E0%A6%BF%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%B8%E0%A6%AE%E0%A7%9F-%E0%A7%A7%E0%A7%A6-%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0</link>
      <guid isPermaLink="true">https://ekattor.tv/national/98252/%E0%A6%B9%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A7%82%E0%A7%9C%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%A8%E0%A6%BF%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%B8%E0%A6%AE%E0%A7%9F-%E0%A7%A7%E0%A7%A6-%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0</guid>
      <pubDate>Mon, 23 Nov 2026 14:24:12 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/afb7db2509f76dc4b01f135f3eb8084b-6b03f81eafcd5.jpg?jadewits_media_id=65721" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/afb7db2509f76dc4b01f135f3eb8084b-6b03f81eafcd5.jpg?jadewits_media_id=65721" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/afb7db2509f76dc4b01f135f3eb8084b-6b03f81eafcd5.jpg?jadewits_media_id=65721" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হজের চূড়ান্ত নিবন্ধনের শেষ সময় ১০ ডিসেম্বর" /&gt;&lt;/p&gt;&lt;p&gt;আগামী ১০ ডিসেম্বরের মধ্যে ২০২৭ সালের হজযাত্রীদের চূড়ান্ত নিবন্ধন সম্পন্ন করার অনুরোধ জানিয়েছে ধর্ম বিষয়ক মন্ত্রণালয়। সরকারি ও বেসরকারি উভয় ব্যবস্থাপনায় প্রাথমিক নিবন্ধন শেষ করে হজযাত্রীদের নির্বাচিত প্যাকেজের অবশিষ্ট অর্থ জমা দিয়ে এই চূড়ান্ত নিবন্ধন শেষ করতে হবে।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/national/98252/%E0%A6%B9%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A7%82%E0%A7%9C%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4-%E0%A6%A8%E0%A6%BF%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%B8%E0%A6%AE%E0%A7%9F-%E0%A7%A7%E0%A7%A6-%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0">একাত্তর</source>
    </item>
    <item>
      <title>ঢাকা বিশ্ববিদ্যালয়ে ভর্তি পরীক্ষা আগের সূচিতেই</title>
      <link>https://ekattor.tv/education/university/98251/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87-%E0%A6%AD%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%86%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%82%E0%A6%9A%E0%A6%BF%E0%A6%A4%E0%A7%87%E0%A6%87</link>
      <guid isPermaLink="true">https://ekattor.tv/education/university/98251/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87-%E0%A6%AD%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%86%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%82%E0%A6%9A%E0%A6%BF%E0%A6%A4%E0%A7%87%E0%A6%87</guid>
      <pubDate>Mon, 23 Nov 2026 14:23:36 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2025/12/06/e84f3732740756259754c2de625cac15-6933d307efe64.jpg?jadewits_media_id=44920" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2025/12/06/e84f3732740756259754c2de625cac15-6933d307efe64.jpg?jadewits_media_id=44920" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2025/12/06/e84f3732740756259754c2de625cac15-6933d307efe64.jpg?jadewits_media_id=44920" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঢাকা বিশ্ববিদ্যালয়ে ভর্তি পরীক্ষা আগের সূচিতেই" /&gt;&lt;/p&gt;&lt;p&gt;ঢাকা বিশ্ববিদ্যালয়সহ দেশের সব পাবলিক বিশ্ববিদ্যালয়ের ভর্তি পরীক্ষা আগামী ৩১ ডিসেম্বর পর্যন্ত স্থগিত করে হাইকোর্ট যে আদেশ দিয়েছিলো, তা স্থগিত করেছে সুপ্রিম কোর্টের আপিল বিভাগ। ফলে পূর্বনির্ধারিত সময়সূচি অনুযায়ীই ঢাকা বিশ্ববিদ্যালয়ের ২০২৬-২০২৭ শিক্ষাবর্ষের আন্ডারগ্র্যাজুয়েট প্রোগ্রামের ভর্তি পরীক্ষা &lt;/p&gt;</description>
      <source url="https://ekattor.tv/education/university/98251/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87-%E0%A6%AD%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%AA%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%86%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%82%E0%A6%9A%E0%A6%BF%E0%A6%A4%E0%A7%87%E0%A6%87">একাত্তর</source>
    </item>
    <item>
      <title>শিকাগোতে বেগম খালেদা জিয়ার নামে সড়কের নামকরণ</title>
      <link>https://ekattor.tv/abroad/98250/%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%97%E0%A7%8B%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A7%87%E0%A6%97%E0%A6%AE-%E0%A6%96%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A6%E0%A6%BE-%E0%A6%9C%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%B8%E0%A7%9C%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A6%95%E0%A6%B0%E0%A6%A3</link>
      <guid isPermaLink="true">https://ekattor.tv/abroad/98250/%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%97%E0%A7%8B%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A7%87%E0%A6%97%E0%A6%AE-%E0%A6%96%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A6%E0%A6%BE-%E0%A6%9C%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%B8%E0%A7%9C%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A6%95%E0%A6%B0%E0%A6%A3</guid>
      <pubDate>Mon, 23 Nov 2026 14:12:43 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/fcdef6da58fc718f94cb0bee6e519744-6b03f5707a077.jpg?jadewits_media_id=65720" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/fcdef6da58fc718f94cb0bee6e519744-6b03f5707a077.jpg?jadewits_media_id=65720" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/fcdef6da58fc718f94cb0bee6e519744-6b03f5707a077.jpg?jadewits_media_id=65720" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শিকাগোতে বেগম খালেদা জিয়ার নামে সড়কের নামকরণ" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাষ্ট্রের শিকাগো শহরের প্রাণকেন্দ্রে বাংলাদেশের তিনবারের সাবেক প্রধানমন্ত্রী বেগম খালেদা জিয়ার নামে একটি গুরুত্বপূর্ণ সড়কের নামকরণ করা হয়েছে। গতকাল (২২ নভেম্বর) ‘মাদার অব ডেমোক্রেসি বেগম খালেদা জিয়া ওয়ে’ নামে সড়কটির নামফলক আনুষ্ঠানিকভাবে উন্মোচন করা হয়।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/abroad/98250/%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%97%E0%A7%8B%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A7%87%E0%A6%97%E0%A6%AE-%E0%A6%96%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A6%E0%A6%BE-%E0%A6%9C%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%B8%E0%A7%9C%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A6%95%E0%A6%B0%E0%A6%A3">একাত্তর</source>

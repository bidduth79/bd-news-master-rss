    <item>
      <title>তাসকিন-হাসানের আঘাতে তিন উইকেট হারিয়ে চাপে দক্ষিণ আফ্রিকা</title>
      <link>https://ekattor.tv/sports/cricket/97844/%E0%A6%A4%E0%A6%BE%E0%A6%B8%E0%A6%95%E0%A6%BF%E0%A6%A8-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%98%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%89%E0%A6%87%E0%A6%95%E0%A7%87%E0%A6%9F-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%AA%E0%A7%87-%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%A3</link>
      <guid isPermaLink="true">https://ekattor.tv/sports/cricket/97844/%E0%A6%A4%E0%A6%BE%E0%A6%B8%E0%A6%95%E0%A6%BF%E0%A6%A8-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%98%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%89%E0%A6%87%E0%A6%95%E0%A7%87%E0%A6%9F-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%AA%E0%A7%87-%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%A3</guid>
      <pubDate>Tue, 17 Nov 2026 17:04:58 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/2fa739bb2c9e4f34c3f8b2ebd6282e59-6afc34cf4e976.jpg?jadewits_media_id=65172" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/2fa739bb2c9e4f34c3f8b2ebd6282e59-6afc34cf4e976.jpg?jadewits_media_id=65172" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/17/2fa739bb2c9e4f34c3f8b2ebd6282e59-6afc34cf4e976.jpg?jadewits_media_id=65172" style="max-width:100%;height:auto;margin-bottom:10px;" alt="তাসকিন-হাসানের আঘাতে তিন উইকেট হারিয়ে চাপে দক্ষিণ আফ্রিকা" /&gt;&lt;/p&gt;&lt;p&gt;জোহানেসবার্গ টেস্টের তৃতীয় দিনে দারুণভাবে ঘুরে দাঁড়িয়েছে বাংলাদেশ। নতুন বল হাতে পাওয়ার পর দক্ষিণ আফ্রিকার তিনটি উইকেট তুলে নিয়েছেন তাসকিন আহমেদ ও হাসান মাহমুদ। তবে প্রথম ইনিংসে এখনো ১৪ রানে পিছিয়ে আছে দক্ষিণ আফ্রিকা। চোটের কারণে মাঠ ছাড়লেও আবার ব্যাট করতে নামবেন অধিনায়ক টেম্বা বাভুমা।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/sports/cricket/97844/%E0%A6%A4%E0%A6%BE%E0%A6%B8%E0%A6%95%E0%A6%BF%E0%A6%A8-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%98%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%89%E0%A6%87%E0%A6%95%E0%A7%87%E0%A6%9F-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%AA%E0%A7%87-%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BF%E0%A6%A3">একাত্তর</source>

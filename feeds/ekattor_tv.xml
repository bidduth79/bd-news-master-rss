      <guid isPermaLink="true">https://ekattor.tv/country/dhaka/97675/%E0%A6%9F%E0%A7%81%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BF%E0%A6%AA%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%93-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87-%E0%A6%AD%E0%A6%BE%E0%A6%99%E0%A6%9A%E0%A7%81%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</guid>
      <pubDate>Sun, 15 Nov 2026 00:14:50 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/315933cf569b088a851478f6da551364-6af8a50e7227d.jpg?jadewits_media_id=64949" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/315933cf569b088a851478f6da551364-6af8a50e7227d.jpg?jadewits_media_id=64949" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/315933cf569b088a851478f6da551364-6af8a50e7227d.jpg?jadewits_media_id=64949" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টুঙ্গিপাড়ায় বিএনপি ও যুবদলের কার্যালয়ে ভাঙচুর-আগুন" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জের টুঙ্গিপাড়ায় বিএনপি ও যুবদলের দুটি কার্যালয়ে হামলা, ভাঙচুর ও অগ্নিসংযোগের ঘটনা ঘটেছে। কার্যক্রম নিষিদ্ধ ঘোষিত আওয়ামী লীগ ও এর সহযোগী সংগঠনের নেতাকর্মীরা এই হামলা চালিয়েছে বলে অভিযোগ পাওয়া গেছে। শনিবার রাতে টুঙ্গিপাড়া উপজেলার নিলফা বাজার ও বর্ণি বাজারে এই পৃথক সহিংসতার ঘটনা ঘটে।						বিস্&lt;/p&gt;</description>
      <source url="https://ekattor.tv/country/dhaka/97675/%E0%A6%9F%E0%A7%81%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BF%E0%A6%AA%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%93-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%A6%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87-%E0%A6%AD%E0%A6%BE%E0%A6%99%E0%A6%9A%E0%A7%81%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8">একাত্তর</source>

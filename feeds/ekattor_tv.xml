      <title>শ্রমিক দলে ৫১ সদস্যের নতুন আহবায়ক কমিটি গঠন, নতুন লক্ষ্য</title>
      <link>https://ekattor.tv/politics/98134/%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95-%E0%A6%A6%E0%A6%B2%E0%A7%87-%E0%A7%AB%E0%A7%A7-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%86%E0%A6%B9%E0%A6%AC%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A6%95-%E0%A6%95%E0%A6%AE%E0%A6%BF%E0%A6%9F%E0%A6%BF-%E0%A6%97%E0%A6%A0%E0%A6%A8-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8</link>
      <guid isPermaLink="true">https://ekattor.tv/politics/98134/%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95-%E0%A6%A6%E0%A6%B2%E0%A7%87-%E0%A7%AB%E0%A7%A7-%E0%A6%B8%E0%A6%A6%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%86%E0%A6%B9%E0%A6%AC%E0%A6%BE%E0%A6%AF%E0%A6%BC%E0%A6%95-%E0%A6%95%E0%A6%AE%E0%A6%BF%E0%A6%9F%E0%A6%BF-%E0%A6%97%E0%A6%A0%E0%A6%A8-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8</guid>
      <pubDate>Sat, 21 Nov 2026 20:55:20 +0600</pubDate>

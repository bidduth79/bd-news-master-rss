      <guid isPermaLink="true">https://ekattor.tv/national/98302/%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%8D%E0%A6%A3%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%80%E0%A6%AA%E0%A7%87-%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%BF%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%AF%E0%A7%8C%E0%A6%A5-%E0%A6%AE%E0%A6%B9%E0%A7%9C%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%AC%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Tue, 24 Nov 2026 01:53:43 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/07/09/52f4bfd19e8419917ba6bc47e72cc607-6a4f77edc1f71.jpg?jadewits_media_id=57325" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/07/09/52f4bfd19e8419917ba6bc47e72cc607-6a4f77edc1f71.jpg?jadewits_media_id=57325" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/07/09/52f4bfd19e8419917ba6bc47e72cc607-6a4f77edc1f71.jpg?jadewits_media_id=57325" style="max-width:100%;height:auto;margin-bottom:10px;" alt="স্বর্ণদ্বীপে তিন বাহিনীর যৌথ মহড়া দেখবেন প্রধানমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;নোয়াখালীর স্বর্ণদ্বীপে বাংলাদেশ সেনাবাহিনী, নৌবাহিনী ও বিমানবাহিনীর বিশেষ যৌথ প্রশিক্ষণ মহড়া পরিদর্শন করবেন প্রধানমন্ত্রী তারেক রহমান। মঙ্গলবার সকালে হেলিকপ্টারে করে তিনি স্বর্ণদ্বীপে পৌঁছাবেন। সেখানে সশস্ত্র বাহিনীর স্পেশাল ফোর্সগুলোর সমন্বয়ে প্রথমবারের মতো আয়োজিত ‘জয়েন্ট স্পেশাল ফোর্সেস এক্সারসাইজ&lt;/p&gt;</description>

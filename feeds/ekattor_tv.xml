      <guid isPermaLink="true">https://ekattor.tv/country/rangpur/97560/%E0%A6%AA%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%97%E0%A6%A1%E0%A6%BC%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%87%E0%A6%AD%E0%A7%87%E0%A6%9F-%E0%A6%AA%E0%A6%A1%E0%A6%BC%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%97%E0%A6%BE%E0%A6%9B%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87</guid>
      <pubDate>Thu, 12 Nov 2026 21:27:07 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/07/9739faeeda91107820da12d2476f7feb-6aeec06192efc.jpg?jadewits_media_id=64360" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/07/9739faeeda91107820da12d2476f7feb-6aeec06192efc.jpg?jadewits_media_id=64360" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/07/9739faeeda91107820da12d2476f7feb-6aeec06192efc.jpg?jadewits_media_id=64360" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পঞ্চগড়ে প্রাইভেট পড়ে ফেরার পথে গাছের সঙ্গে বাইকের ধাক্কা, নিহত তিন" /&gt;&lt;/p&gt;&lt;p&gt;পঞ্চগড়ে প্রাইভেট পড়া শেষে মোটরসাইকেলে করে বাড়ি ফেরার পথে নিয়ন্ত্রণ হারিয়ে গাছের সঙ্গে ধাক্কা লেগে সাকোয়া দাখিল মাদ্রাসার দশম শ্রেণির দুই শিক্ষার্থী ঘটনাস্থলে নিহত হয়েছে। এ ঘটনায় গুরুতর আহত হয়েছেন আরও এক শিক্ষার্থী। তাকে ঠাকুরগাঁও সদর হাসপাতালে ভর্তি করা হলে সেখানে চিকিৎসাধীন অবস্থায় তার মৃত্য&lt;/p&gt;</description>
      <source url="https://ekattor.tv/country/rangpur/97560/%E0%A6%AA%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%97%E0%A6%A1%E0%A6%BC%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%87%E0%A6%AD%E0%A7%87%E0%A6%9F-%E0%A6%AA%E0%A6%A1%E0%A6%BC%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A7%87-%E0%A6%97%E0%A6%BE%E0%A6%9B%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87">একাত্তর</source>
    </item>
    <item>
      <title>ব্রুকলিনে বিধ্বস্ত ভবনের ধ্বংসস্তূপ থেকে গর্ভবতী নারী উদ্ধার</title>
      <link>https://ekattor.tv/international/america/97559/%E0%A6%AC%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%95%E0%A6%B2%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%A7%E0%A7%8D%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A4-%E0%A6%AD%E0%A6%AC%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A7%E0%A7%8D%E0%A6%AC%E0%A6%82%E0%A6%B8%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%82%E0%A6%AA-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%97%E0%A6%B0%E0%A7%8D%E0%A6%AD%E0%A6%AC%E0%A6%A4%E0%A7%80</link>
      <guid isPermaLink="true">https://ekattor.tv/international/america/97559/%E0%A6%AC%E0%A7%8D%E0%A6%B0%E0%A7%81%E0%A6%95%E0%A6%B2%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%A7%E0%A7%8D%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A4-%E0%A6%AD%E0%A6%AC%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A7%E0%A7%8D%E0%A6%AC%E0%A6%82%E0%A6%B8%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%82%E0%A6%AA-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%97%E0%A6%B0%E0%A7%8D%E0%A6%AD%E0%A6%AC%E0%A6%A4%E0%A7%80</guid>

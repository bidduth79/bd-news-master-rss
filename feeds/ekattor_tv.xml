    <item>
      <title>হাম উপসর্গে আরও ছয় মৃত্যু, মোট ১২৯৫</title>
      <link>https://ekattor.tv/health/97474/%E0%A6%B9%E0%A6%BE%E0%A6%AE-%E0%A6%89%E0%A6%AA%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A6%9B%E0%A7%9F-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81-%E0%A6%AE%E0%A7%8B%E0%A6%9F-%E0%A7%A7%E0%A7%A8%E0%A7%AF%E0%A7%AB</link>

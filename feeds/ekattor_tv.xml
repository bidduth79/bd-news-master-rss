      <title>অক্টোবরে সারাদেশে গণপিটুনির ৬৪ ঘটনায় নিহত ৩২</title>
      <link>https://ekattor.tv/national/97347/%E0%A6%85%E0%A6%95%E0%A7%8D%E0%A6%9F%E0%A7%8B%E0%A6%AC%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%97%E0%A6%A3%E0%A6%AA%E0%A6%BF%E0%A6%9F%E0%A7%81%E0%A6%A8%E0%A6%BF%E0%A6%B0-%E0%A7%AC%E0%A7%AA-%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A7%A9%E0%A7%A8</link>
      <guid isPermaLink="true">https://ekattor.tv/national/97347/%E0%A6%85%E0%A6%95%E0%A7%8D%E0%A6%9F%E0%A7%8B%E0%A6%AC%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%97%E0%A6%A3%E0%A6%AA%E0%A6%BF%E0%A6%9F%E0%A7%81%E0%A6%A8%E0%A6%BF%E0%A6%B0-%E0%A7%AC%E0%A7%AA-%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A7%A9%E0%A7%A8</guid>
      <pubDate>Sun, 08 Nov 2026 19:47:41 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/08/039e4adfa912914161ecb492bb539b28-6af07d6752e77.jpg?jadewits_media_id=64501" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/08/039e4adfa912914161ecb492bb539b28-6af07d6752e77.jpg?jadewits_media_id=64501" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/08/039e4adfa912914161ecb492bb539b28-6af07d6752e77.jpg?jadewits_media_id=64501" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অক্টোবরে সারাদেশে গণপিটুনির ৬৪ ঘটনায় নিহত ৩২" /&gt;&lt;/p&gt;&lt;p&gt;দেশে আইন নিজের হাতে তুলে নেওয়ার প্রবণতা এবং বিচারবহির্ভূত সহিংসতার মাত্রা আশঙ্কাজনকহারে বৃদ্ধি পেয়েছে। মানবাধিকার সংস্কৃতি ফাউন্ডেশনের (এমএসএফ) প্রকাশিত অক্টোবর মাসের পর্যবেক্ষণ প্রতিবেদনে দেশের সার্বিক আইনশৃঙ্খলা পরিস্থিতি নিয়ে এক ভয়াবহ চিত্র উঠে এসেছে।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/national/97347/%E0%A6%85%E0%A6%95%E0%A7%8D%E0%A6%9F%E0%A7%8B%E0%A6%AC%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%97%E0%A6%A3%E0%A6%AA%E0%A6%BF%E0%A6%9F%E0%A7%81%E0%A6%A8%E0%A6%BF%E0%A6%B0-%E0%A7%AC%E0%A7%AA-%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A7%A9%E0%A7%A8">একাত্তর</source>
    </item>
    <item>

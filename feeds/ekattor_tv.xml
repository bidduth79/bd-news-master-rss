    <item>
      <title>হরমুজ প্রণালীতে মার্কিন ড্রোন ভূপাতিত করলো ইরান</title>
      <link>https://ekattor.tv/international/middle-east/97948/%E0%A6%B9%E0%A6%B0%E0%A6%AE%E0%A7%81%E0%A6%9C-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A3%E0%A6%BE%E0%A6%B2%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8-%E0%A6%A1%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%A8-%E0%A6%AD%E0%A7%82%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%8B-%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8</link>
      <guid isPermaLink="true">https://ekattor.tv/international/middle-east/97948/%E0%A6%B9%E0%A6%B0%E0%A6%AE%E0%A7%81%E0%A6%9C-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A3%E0%A6%BE%E0%A6%B2%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8-%E0%A6%A1%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%A8-%E0%A6%AD%E0%A7%82%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%8B-%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8</guid>
      <pubDate>Thu, 19 Nov 2026 02:11:08 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/4db349c13b4becc92b39c435926a8cd8-6afe06523853c.jpg?jadewits_media_id=65323" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/4db349c13b4becc92b39c435926a8cd8-6afe06523853c.jpg?jadewits_media_id=65323" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/4db349c13b4becc92b39c435926a8cd8-6afe06523853c.jpg?jadewits_media_id=65323" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হরমুজ প্রণালীতে মার্কিন ড্রোন ভূপাতিত করলো ইরান" /&gt;&lt;/p&gt;&lt;p&gt;কৌশলগতভাবে অত্যন্ত গুরুত্বপূর্ণ হরমুজ প্রণালীর পূর্বাঞ্চলে যুক্তরাষ্ট্রের একটি অত্যাধুনিক এমকিউ-৯ ড্রোন গুলি করে ভূপাতিত করার দাবি করেছে ইরানের সেনাবাহিনী। বুধবার ইরানি সেনাবাহিনীর পক্ষ থেকে প্রকাশিত এক আনুষ্ঠানিক বিবৃতিতে এই তথ্য জানানো হয়েছে। ওয়াশিংটন ও তেহরানের মধ্যকার চলমান তীব্র উত্তেজনার মধ্যে&lt;/p&gt;</description>
      <source url="https://ekattor.tv/international/middle-east/97948/%E0%A6%B9%E0%A6%B0%E0%A6%AE%E0%A7%81%E0%A6%9C-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A3%E0%A6%BE%E0%A6%B2%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8-%E0%A6%A1%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%A8-%E0%A6%AD%E0%A7%82%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%B2%E0%A7%8B-%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8">একাত্তর</source>

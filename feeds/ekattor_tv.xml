    <item>
      <title>বঙ্গোপসাগরে নিম্নচাপ, চার সমুদ্রবন্দরে সতর্ক সংকেত</title>
      <link>https://ekattor.tv/national/97693/%E0%A6%AC%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%B8%E0%A6%BE%E0%A6%97%E0%A6%B0%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%AE%E0%A7%8D%E0%A6%A8%E0%A6%9A%E0%A6%BE%E0%A6%AA-%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%95-%E0%A6%B8%E0%A6%82%E0%A6%95%E0%A7%87%E0%A6%A4</link>
      <guid isPermaLink="true">https://ekattor.tv/national/97693/%E0%A6%AC%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%B8%E0%A6%BE%E0%A6%97%E0%A6%B0%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%AE%E0%A7%8D%E0%A6%A8%E0%A6%9A%E0%A6%BE%E0%A6%AA-%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%95-%E0%A6%B8%E0%A6%82%E0%A6%95%E0%A7%87%E0%A6%A4</guid>
      <pubDate>Sun, 15 Nov 2026 14:42:23 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/163b10bff932cdae49389a4e5e210d28-6af9704c8ae47.jpg?jadewits_media_id=64973" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/163b10bff932cdae49389a4e5e210d28-6af9704c8ae47.jpg?jadewits_media_id=64973" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/15/163b10bff932cdae49389a4e5e210d28-6af9704c8ae47.jpg?jadewits_media_id=64973" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বঙ্গোপসাগরে নিম্নচাপ, চার সমুদ্রবন্দরে সতর্ক সংকেত" /&gt;&lt;/p&gt;&lt;p&gt;বঙ্গোপসাগরে সৃষ্ট নিম্নচাপটি আরও ঘনীভূত হয়ে ঘূর্ণিঝড়ে রূপ নিতে পারে। এর প্রভাবে সাগর উত্তাল থাকায় দেশের চার সমুদ্রবন্দরে ১ নম্বর দূরবর্তী সতর্ক সংকেত দেখাতে বলেছে আবহাওয়া অধিদপ্তর। একই সঙ্গে উত্তর বঙ্গোপসাগরে অবস্থানরত মাছ ধরার নৌকা ও ট্রলারগুলোকে পরবর্তী নির্দেশ না দেওয়া পর্যন্ত গভীর সাগরে বিচরণ না&lt;/p&gt;</description>
      <source url="https://ekattor.tv/national/97693/%E0%A6%AC%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%8B%E0%A6%AA%E0%A6%B8%E0%A6%BE%E0%A6%97%E0%A6%B0%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%AE%E0%A7%8D%E0%A6%A8%E0%A6%9A%E0%A6%BE%E0%A6%AA-%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%95-%E0%A6%B8%E0%A6%82%E0%A6%95%E0%A7%87%E0%A6%A4">একাত্তর</source>

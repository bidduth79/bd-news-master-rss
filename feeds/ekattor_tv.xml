      <guid isPermaLink="true">https://ekattor.tv/international/america/98481/%E0%A6%8F%E0%A6%B2-%E0%A6%B8%E0%A6%BE%E0%A6%88%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B6%E0%A6%82%E0%A6%B8%E0%A6%BE%E0%A7%9F-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA-%E0%A6%AC%E0%A6%B8%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%8F%E0%A6%95-%E0%A6%9F%E0%A7%87%E0%A6%AC%E0%A6%BF%E0%A6%B2%E0%A7%87</guid>

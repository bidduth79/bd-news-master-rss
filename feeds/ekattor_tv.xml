    </item>
    <item>
      <title>মালয়েশিয়া যাবে এক হাজার জুলাই যোদ্ধাসহ ১০ হাজার শ্রমিক: প্রধানমন্ত্রী</title>
      <link>https://ekattor.tv/national/97917/%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE-%E0%A6%AF%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%8F%E0%A6%95-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A7%81%E0%A6%B2%E0%A6%BE%E0%A6%87-%E0%A6%AF%E0%A7%8B%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B8%E0%A6%B9-%E0%A7%A7%E0%A7%A6-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://ekattor.tv/national/97917/%E0%A6%AE%E0%A6%BE%E0%A6%B2%E0%A7%9F%E0%A7%87%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE-%E0%A6%AF%E0%A6%BE%E0%A6%AC%E0%A7%87-%E0%A6%8F%E0%A6%95-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%9C%E0%A7%81%E0%A6%B2%E0%A6%BE%E0%A6%87-%E0%A6%AF%E0%A7%8B%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B8%E0%A6%B9-%E0%A7%A7%E0%A7%A6-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Wed, 18 Nov 2026 17:27:39 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/90806fd266fe4a916934f3cfa4fdf738-6afd8b8fd09e4.jpg?jadewits_media_id=65274" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/90806fd266fe4a916934f3cfa4fdf738-6afd8b8fd09e4.jpg?jadewits_media_id=65274" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/90806fd266fe4a916934f3cfa4fdf738-6afd8b8fd09e4.jpg?jadewits_media_id=65274" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মালয়েশিয়া যাবে এক হাজার জুলাই যোদ্ধাসহ ১০ হাজার শ্রমিক: প্রধানমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;মালয়েশিয়ায় ১০ হাজার শ্রমিক পাঠাবে বাংলাদেশ। তাদের মধ্যে এক হাজার থাকবেন জুলাই যোদ্ধা। এ ছাড়া মালয়েশিয়াগামী শ্রমিকদের অভিবাসন খরচ সর্বোচ্চ দুই লাখ টাকার মধ্যে রাখার পরিকল্পনা করছে সরকার। 						বিস্তারিত&lt;/p&gt;</description>

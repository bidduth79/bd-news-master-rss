      <guid isPermaLink="true">https://ekattor.tv/entertainment/bollywood/97922/%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A6%BE-%E0%A6%87%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A6%BF%E0%A7%9F%E0%A6%BE-%E0%A6%AB%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B6%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A4-%E0%A6%90%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE-%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9F%E0%A6%B0%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Thu, 19 Nov 2026 08:15:00 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/e9d28f69d196ac660500066f65fafc24-6afd9abfdd302.jpg?jadewits_media_id=65281" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/e9d28f69d196ac660500066f65fafc24-6afd9abfdd302.jpg?jadewits_media_id=65281" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/e9d28f69d196ac660500066f65fafc24-6afd9abfdd302.jpg?jadewits_media_id=65281" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পেটা ইন্ডিয়া ফ্যাশনে বাজিমাত ঐশ্বরিয়া-ক্যাটরিনার!" /&gt;&lt;/p&gt;&lt;p&gt;গ্ল্যামার আর আভিজাত্যের সঙ্গে পশুপ্রেম মিলেমিশে একাকার! কোনো প্রাণীর ক্ষতি না করেও যে ফ্যাশন দুনিয়ায় ঝড় তোলা যায়, তা আবারও প্রমাণ করলেন বলিউডের দুই শীর্ষ সুন্দরী ঐশ্বরিয়া রাই বচ্চন এবং ক্যাটরিনা কাইফ। সম্প্রতি অনুষ্ঠিত ‘পেটা ইন্ডিয়া ভেগান ফ্যাশন অ্যাওয়ার্ডস ২০২৬’-এ বাজিমাত করেছেন এই দুই তারকা।			&lt;/p&gt;</description>
      <source url="https://ekattor.tv/entertainment/bollywood/97922/%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A6%BE-%E0%A6%87%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A6%BF%E0%A7%9F%E0%A6%BE-%E0%A6%AB%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B6%E0%A6%A8%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A4-%E0%A6%90%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE-%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9F%E0%A6%B0%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0">একাত্তর</source>
    </item>
    <item>
      <title>ভিয়েতনামে বোমারু বিমান পাঠিয়ে কি বার্তা দিলেন পুতিন?</title>
      <link>https://ekattor.tv/international/asia/97916/%E0%A6%AD%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%A4%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%81-%E0%A6%AC%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%AA%E0%A6%BE%E0%A6%A0%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%95%E0%A6%BF-%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8</link>
      <guid isPermaLink="true">https://ekattor.tv/international/asia/97916/%E0%A6%AD%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%A4%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%81-%E0%A6%AC%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%AA%E0%A6%BE%E0%A6%A0%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%95%E0%A6%BF-%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Thu, 19 Nov 2026 08:00:00 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/cd9c58659fd0cf741917c5cd828dabf7-6afd8a7c5a902.jpg?jadewits_media_id=65271" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/cd9c58659fd0cf741917c5cd828dabf7-6afd8a7c5a902.jpg?jadewits_media_id=65271" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/18/cd9c58659fd0cf741917c5cd828dabf7-6afd8a7c5a902.jpg?jadewits_media_id=65271" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ভিয়েতনামে বোমারু বিমান পাঠিয়ে কি বার্তা দিলেন পুতিন?" /&gt;&lt;/p&gt;&lt;p&gt;যুক্তরাষ্ট্র, চীন ও রাশিয়ার মধ্যকার হাই-ভোল্টেজ বৈঠকের ঠিক আগে পূর্ব এশিয়ায় গত এক দশকেরও বেশি সময়ের মধ্যে নিজেদের সবচেয়ে বড় সামরিক বিমান মোতায়েন করেছে রাশিয়া। ভিয়েতনামের দানাং বিমানবন্দরে রাশিয়ার দুটি পরমাণু-সক্ষম কৌশলগত টিইউ-৯৫ বোমারু বিমান এবং দুটি দূরপাল্লার ট্যাংকার বিমান অবস্থান করছে। ন্যাটো বি&lt;/p&gt;</description>
      <source url="https://ekattor.tv/international/asia/97916/%E0%A6%AD%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%A4%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%81-%E0%A6%AC%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%AA%E0%A6%BE%E0%A6%A0%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%95%E0%A6%BF-%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A7%87%E0%A6%A8">একাত্তর</source>

      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/19/a3d8d35b432f00daf0e36c02bacbedae-6afec41d1be6f.jpg?jadewits_media_id=65365" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মুশফিকের পর মিরাজও আউট, হারের শঙ্কায় বাংলাদেশ" /&gt;&lt;/p&gt;&lt;p&gt;দক্ষিণ আফ্রিকার বিপক্ষে ইনিংস হার এড়িয়েছে বাংলাদেশ। তবে দ্বিতীয় ইনিংসে একের পর এক উইকেট হারিয়ে বড় ব্যবধানে হারের শঙ্কায় পড়েছে দল। শেষ স্বীকৃত ব্যাটসম্যান মেহেদী হাসান মিরাজও আউট হয়ে যাওয়ায় বাংলাদেশের লিড কতটা বাড়বে, তা নিয়ে অনিশ্চয়তা তৈরি হয়েছে।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/sports/cricket/97978/%E0%A6%AE%E0%A7%81%E0%A6%B6%E0%A6%AB%E0%A6%BF%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%93-%E0%A6%86%E0%A6%89%E0%A6%9F-%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6">একাত্তর</source>
    </item>
    <item>
      <title>হামের উপসর্গে আরও সাতজনের মৃত্যু, মোট ১৩৩৬</title>
      <link>https://ekattor.tv/health/97977/%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%89%E0%A6%AA%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%97%E0%A7%87-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A6%B8%E0%A6%BE%E0%A6%A4-%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81-%E0%A6%AE%E0%A7%8B%E0%A6%9F-%E0%A7%A7%E0%A7%A9%E0%A7%A9%E0%A7%AC%C2%A0</link>

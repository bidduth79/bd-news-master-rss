    <item>
      <title>প্রতিবেশী দেশের সহায়তায় আবারও দেশে ফেরার ষড়যন্ত্র চলছে: রিজভী</title>
      <link>https://ekattor.tv/politics/97752/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A7%80-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%B9%E0%A6%BE%E0%A7%9F%E0%A6%A4%E0%A6%BE%E0%A7%9F-%E0%A6%86%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A6%93-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%B7%E0%A7%9C%E0%A6%AF%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0</link>
      <guid isPermaLink="true">https://ekattor.tv/politics/97752/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A7%80-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%B9%E0%A6%BE%E0%A7%9F%E0%A6%A4%E0%A6%BE%E0%A7%9F-%E0%A6%86%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A6%93-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%B7%E0%A7%9C%E0%A6%AF%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0</guid>
      <pubDate>Mon, 16 Nov 2026 14:03:53 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/8466a4c732ab65731f81a372a3d0a106-6afab8d0697ad.jpg?jadewits_media_id=65044" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/8466a4c732ab65731f81a372a3d0a106-6afab8d0697ad.jpg?jadewits_media_id=65044" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/16/8466a4c732ab65731f81a372a3d0a106-6afab8d0697ad.jpg?jadewits_media_id=65044" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রতিবেশী দেশের সহায়তায় আবারও দেশে ফেরার ষড়যন্ত্র চলছে: রিজভী" /&gt;&lt;/p&gt;&lt;p&gt;পেছনের দরজা দিয়ে প্রতিবেশী দেশের সহায়তায় আবারও দেশে ফেরার ষড়যন্ত্র চলছে বলে অভিযোগ করেছেন বিএনপির ভারপ্রাপ্ত মহাসচিব রুহুল কবির রিজভী। তবে আবারও রক্তাক্ত রাজনীতি ফিরিয়ে আনার চেষ্টা দেশের মানুষ মেনে নেবে না বলে হুঁশিয়ারি দিয়েছেন তিনি। সব ষড়যন্ত্র মোকাবিলায় দলের নেতাকর্মীদের ঐক্যবদ্ধ থাকার আহ্বান জানি&lt;/p&gt;</description>
      <source url="https://ekattor.tv/politics/97752/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A7%80-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%B9%E0%A6%BE%E0%A7%9F%E0%A6%A4%E0%A6%BE%E0%A7%9F-%E0%A6%86%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A6%93-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%B7%E0%A7%9C%E0%A6%AF%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0">একাত্তর</source>

    <item>
      <title>‘ইরানকে পারমাণবিক অস্ত্র পেতে দেব না’</title>
      <link>https://ekattor.tv/international/asia/97981/%E2%80%98%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%AE%E0%A6%BE%E0%A6%A3%E0%A6%AC%E0%A6%BF%E0%A6%95-%E0%A6%85%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%AA%E0%A7%87%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%87%E0%A6%AC-%E0%A6%A8%E0%A6%BE%E2%80%99</link>

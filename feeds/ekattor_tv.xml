      <pubDate>Tue, 10 Nov 2026 20:16:12 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/c0df17583eb4d382cc461f79adab39b2-6af3271e9adc4.jpg?jadewits_media_id=64607" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/c0df17583eb4d382cc461f79adab39b2-6af3271e9adc4.jpg?jadewits_media_id=64607" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/10/c0df17583eb4d382cc461f79adab39b2-6af3271e9adc4.jpg?jadewits_media_id=64607" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দেশে নাশকতার দায় সরকারকেই নিতে হবে: শফিকুর রহমান" /&gt;&lt;/p&gt;&lt;p&gt;দেশের বিভিন্ন স্থানে ককটেল বিস্ফোরণ, হামলা ও নাশকতার ঘটনায় আইনশৃঙ্খলা পরিস্থিতির অবনতি নিয়ে সংসদে তীব্র ক্ষোভ ও উদ্বেগ প্রকাশ করেছেন বিরোধীদলীয় নেতা ও জামায়াতে ইসলামীর আমির শফিকুর রহমান। মঙ্গলবার জাতীয় সংসদের অধিবেশনে বক্তব্য দেওয়ার সময় তিনি বলেন, চলমান এই পরিস্থিতির দায় পুরোপুরি সরকার ও স্বরাষ্ট্র &lt;/p&gt;</description>
      <source url="https://ekattor.tv/national/97437/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%B6%E0%A6%95%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A7%9F-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%95%E0%A7%87%E0%A6%87-%E0%A6%A8%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%AC%E0%A7%87-%E0%A6%B6%E0%A6%AB%E0%A6%BF%E0%A6%95%E0%A7%81%E0%A6%B0-%E0%A6%B0%E0%A6%B9%E0%A6%AE%E0%A6%BE%E0%A6%A8">একাত্তর</source>

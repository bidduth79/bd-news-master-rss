    <item>
      <title>ঢাবির ভর্তি আবেদনের সময় বাড়ানোর অনুরোধ শিক্ষামন্ত্রীর</title>
      <link>https://ekattor.tv/education/university/97619/%E0%A6%A2%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%AD%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%86%E0%A6%AC%E0%A7%87%E0%A6%A6%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A7%9F-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%A8%E0%A7%8B%E0%A6%B0-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%B0%E0%A7%8B%E0%A6%A7</link>
      <guid isPermaLink="true">https://ekattor.tv/education/university/97619/%E0%A6%A2%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%AD%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%86%E0%A6%AC%E0%A7%87%E0%A6%A6%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A7%9F-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%A8%E0%A7%8B%E0%A6%B0-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%B0%E0%A7%8B%E0%A6%A7</guid>
      <pubDate>Sat, 14 Nov 2026 12:33:03 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/aede46552dfd420c27452afebef520b3-6af8009389d22.jpg?jadewits_media_id=64884" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/aede46552dfd420c27452afebef520b3-6af8009389d22.jpg?jadewits_media_id=64884" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/14/aede46552dfd420c27452afebef520b3-6af8009389d22.jpg?jadewits_media_id=64884" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঢাবির ভর্তি আবেদনের সময় বাড়ানোর অনুরোধ শিক্ষামন্ত্রীর" /&gt;&lt;/p&gt;&lt;p&gt;পুনর্নিরীক্ষণে যেসব শিক্ষার্থীর পরীক্ষার ফলাফল ভালো হবে, তারাও যেন উচ্চশিক্ষায় ভর্তির আবেদন করতে পারে, সে জন্য ঢাকা বিশ্ববিদ্যালয়ের (ঢাবি) ভর্তি আবেদনের সময়সীমা আরও কয়েক দিন বাড়ানোর অনুরোধ জানিয়েছেন শিক্ষামন্ত্রী ড. আ ন ম এহছানুল হক মিলন। পাশাপাশি আগের সরকারের শিক্ষা খাতের কর্মকাণ্ড নিয়েও কঠোর সমালো&lt;/p&gt;</description>
      <source url="https://ekattor.tv/education/university/97619/%E0%A6%A2%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%AD%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%86%E0%A6%AC%E0%A7%87%E0%A6%A6%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%AE%E0%A7%9F-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%A8%E0%A7%8B%E0%A6%B0-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%B0%E0%A7%8B%E0%A6%A7">একাত্তর</source>
    </item>

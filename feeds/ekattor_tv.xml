    <item>
      <title>ইরানের ভয়ে বাড়ি ছেড়ে পালালেন মার্কিন অর্থমন্ত্রী!</title>
      <link>https://ekattor.tv/international/america/97512/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AD%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%9B%E0%A7%87%E0%A7%9C%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8-%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80</link>
      <guid isPermaLink="true">https://ekattor.tv/international/america/97512/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AD%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%9B%E0%A7%87%E0%A7%9C%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8-%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80</guid>
      <pubDate>Thu, 12 Nov 2026 08:30:00 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/26dc3e90fb8167b76ee6217ce3b72555-6af4b7fbe8e00.jpg?jadewits_media_id=64722" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/26dc3e90fb8167b76ee6217ce3b72555-6af4b7fbe8e00.jpg?jadewits_media_id=64722" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/12/26dc3e90fb8167b76ee6217ce3b72555-6af4b7fbe8e00.jpg?jadewits_media_id=64722" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইরানের ভয়ে বাড়ি ছেড়ে পালালেন মার্কিন অর্থমন্ত্রী!" /&gt;&lt;/p&gt;&lt;p&gt;নিবাসের সঠিক ভৌগোলিক অবস্থান (জিও-লোকেশন) অনলাইনে ফাঁস হয়ে যাওয়ায় চরম প্রাণভয়ে ওয়াশিংটন ডিসির জর্জটাউনের বিলাসবহুল বাড়ি থেকে এক প্রকার পালিয়েই একটি সুরক্ষিত সামরিক ঘাঁটিতে আশ্রয় নিতে বাধ্য হয়েছেন মার্কিন অর্থমন্ত্রী স্কট বেসেন্ট। প্রভাবশালী সংবাদমাধ্যম সিবিএস নিউজ এই চাঞ্চল্যকর তথ্য নিশ্চিত করেছে।		&lt;/p&gt;</description>
      <source url="https://ekattor.tv/international/america/97512/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AD%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%9B%E0%A7%87%E0%A7%9C%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8-%E0%A6%85%E0%A6%B0%E0%A7%8D%E0%A6%A5%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80">একাত্তর</source>

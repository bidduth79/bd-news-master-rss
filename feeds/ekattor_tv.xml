      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/1a0ccd70b3d7e03b23313b8605d2cb4a-6b044854beef7.jpg?jadewits_media_id=65779" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ধর্মঘটে স্থবির বেলজিয়াম, বাতিল শত শত ফ্লাইট" /&gt;&lt;/p&gt;&lt;p&gt;সরকারের পরিকল্পিত ব্যয় সংকোচন নীতির বিরুদ্ধে দেশব্যাপী ধর্মঘট ও বিক্ষোভে কার্যত স্থবির হয়ে পড়েছে বেলজিয়াম। ধর্মঘটের জেরে সোমবার দেশটির বিমানবন্দরগুলোতে শত শত ফ্লাইট বাতিল করা হয়েছে এবং গণপরিবহন ব্যবস্থা মারাত্মকভাবে ব্যাহত হচ্ছে। রাজধানী ব্রাসেলসে ভূগর্ভস্থ রেল (আন্ডারগ্রাউন্ড) সেবা বন্ধ থাকার পাশাপ&lt;/p&gt;</description>
      <source url="https://ekattor.tv/international/europe/98295/%E0%A6%A7%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%98%E0%A6%9F%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A7%87%E0%A6%B2%E0%A6%9C%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%AE-%E0%A6%AC%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%B2-%E0%A6%B6%E0%A6%A4-%E0%A6%B6%E0%A6%A4-%E0%A6%AB%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%9F">একাত্তর</source>

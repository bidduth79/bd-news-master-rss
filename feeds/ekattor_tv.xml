      <guid isPermaLink="true">https://ekattor.tv/business/98228/%E0%A7%A7%E0%A7%AE-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%89%E0%A7%8E%E0%A6%AA%E0%A6%BE%E0%A6%A6%E0%A6%A8-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A4%E0%A6%BF-%E0%A7%AA%E0%A7%A8%E0%A7%AE-%E0%A6%AE%E0%A6%BF%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%A8-%E0%A6%A1%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%8F%E0%A6%AE%E0%A6%87%E0%A6%8F</guid>
      <pubDate>Sun, 22 Nov 2026 23:02:25 +0600</pubDate>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2024/06/10/1a51b589c22a99dfae7b2d8d7bdc45fc-6666f04597bbe.jpg?jadewits_media_id=22042" length="0" type="image/jpeg" />

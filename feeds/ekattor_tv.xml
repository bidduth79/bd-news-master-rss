      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/a657fb1050e783766c4856a3266842ce-6b0434d69a224.jpg?jadewits_media_id=65767" length="0" type="image/jpeg" />
      <media:content url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/a657fb1050e783766c4856a3266842ce-6b0434d69a224.jpg?jadewits_media_id=65767" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/11/23/a657fb1050e783766c4856a3266842ce-6b0434d69a224.jpg?jadewits_media_id=65767" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রধানমন্ত্রীর উপহারের নতুন ঘরে হাসি ফুটলো দুর্গাপুরের সুধিনী মান্দার মুখে" /&gt;&lt;/p&gt;&lt;p&gt;‘আমি আজ ভীষণ খুশি ও আনন্দিত। এতোদিন আমার নিজের কোনো ঘর ছিলো না, তাই আমাকে অনেক কষ্ট করে দিন কাটাতে হয়েছে। আমি দিন আনি দিন খাই—নিজের সামর্থ্যে একটি ঘর বানানোর মতো অবস্থা আমার কখনোই ছিলো না। প্রধানমন্ত্রী আমাকে ঘর দিয়েছেন, এতে আমি যে কতোটা খুশি হয়েছি তা ভাষায় প্রকাশ করার মতো নয়’-						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://ekattor.tv/country/mymensingh/98284/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%89%E0%A6%AA%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%98%E0%A6%B0%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF-%E0%A6%AB%E0%A7%81%E0%A6%9F%E0%A6%B2%E0%A7%8B">একাত্তর</source>

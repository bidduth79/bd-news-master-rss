      <pubDate>Sun, 08 Nov 2026 12:11:45 +0000</pubDate>
      <enclosure url="https://www.ajkerbazzar.com/wp-content/uploads/2026/11/image-357878-1794139600.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.ajkerbazzar.com/wp-content/uploads/2026/11/image-357878-1794139600.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.ajkerbazzar.com/wp-content/uploads/2026/11/image-357878-1794139600.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কাজের মাধ্যমেই রাজনীতিতে নেতৃত্বের অবস্থান তৈরি করতে হয়: আইনমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;আইন, বিচার ও সংসদ বিষয়ক মন্ত্রী মো. আসাদুজ্জামান বলেছেন, রাজনীতিতে নেতৃত্বের জায়গা তৈরি করতে হয় কাজের মাধ্যমে। ইতিবাচক রাজনীতি, যোগ্যতা, দক্ষতা ও সাংগঠনিক অবদানের মধ্য দিয়েই নেতৃত্বে আসতে হয় উল্লেখ করে আইনমন্ত্রী বলেন, ব্যক্তিগত স্বার্থের চেয়ে দলের স্বার্থকে সর্বোচ্চ গুরুত্ব দিতে হবে। দলের জন্য কে &lt;/p&gt;</description>
      <source url="https://www.ajkerbazzar.com/%e0%a6%95%e0%a6%be%e0%a6%9c%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a6%be%e0%a6%a7%e0%a7%8d%e0%a6%af%e0%a6%ae%e0%a7%87%e0%a6%87-%e0%a6%b0%e0%a6%be%e0%a6%9c%e0%a6%a8%e0%a7%80%e0%a6%a4%e0%a6%bf%e0%a6%a4%e0%a7%87/">আজকের বাজার</source>
    </item>
    <item>
      <title>সাভার-আশুলিয়া, গাজীপুর ও নারায়ণগঞ্জে ফের কর্মস্থলে ফিরেছেন পোশাক শ্রমিকরা</title>
      <link>https://www.ajkerbazzar.com/%e0%a6%b8%e0%a6%be%e0%a6%ad%e0%a6%be%e0%a6%b0-%e0%a6%86%e0%a6%b6%e0%a7%81%e0%a6%b2%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be-%e0%a6%97%e0%a6%be%e0%a6%9c%e0%a7%80%e0%a6%aa%e0%a7%81%e0%a6%b0-%e0%a6%93/</link>
      <guid isPermaLink="true">https://www.ajkerbazzar.com/%e0%a6%b8%e0%a6%be%e0%a6%ad%e0%a6%be%e0%a6%b0-%e0%a6%86%e0%a6%b6%e0%a7%81%e0%a6%b2%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be-%e0%a6%97%e0%a6%be%e0%a6%9c%e0%a7%80%e0%a6%aa%e0%a7%81%e0%a6%b0-%e0%a6%93/</guid>
      <pubDate>Sun, 08 Nov 2026 11:31:00 +0000</pubDate>
      <enclosure url="https://www.ajkerbazzar.com/wp-content/uploads/2026/11/image-357739-1794119427.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.ajkerbazzar.com/wp-content/uploads/2026/11/image-357739-1794119427.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.ajkerbazzar.com/wp-content/uploads/2026/11/image-357739-1794119427.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাভার-আশুলিয়া, গাজীপুর ও নারায়ণগঞ্জে ফের কর্মস্থলে ফিরেছেন পোশাক শ্রমিকরা" /&gt;&lt;/p&gt;&lt;p&gt;কয়েক দিনের শ্রমিক অসন্তোষ কাটিয়ে সাভার, আশুলিয়া, গাজীপুর ও নারায়ণগঞ্জের পোশাক কারখানাগুলোতে কাজে ফিরেছেন শ্রমিকরা। আজ রোববার এসব শিল্পাঞ্চলের অধিকাংশ কারখানায় শ্রমিকদের উপস্থিতিতে উৎপাদন কার্যক্রমে কর্মচাঞ্চল্য ফিরে এসেছে। এর মধ্য দিয়ে তৈরি পোশাকশিল্পে স্বাভাবিক পরিবেশ ফিরতে শুরু করেছে। এদিকে, গত ৫ &lt;/p&gt;</description>

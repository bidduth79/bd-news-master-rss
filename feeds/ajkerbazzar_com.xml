    <item>
      <title>ইন্দোনেশিয়ায় অগ্নিনির্বাপণ কাজে নিয়োজিত হেলিকপ্টার বিধ্বস্ত</title>
      <link>https://www.ajkerbazzar.com/%e0%a6%87%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a7%8b%e0%a6%a8%e0%a7%87%e0%a6%b6%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%85%e0%a6%97%e0%a7%8d%e0%a6%a8%e0%a6%bf%e0%a6%a8%e0%a6%bf%e0%a6%b0/</link>
      <guid isPermaLink="true">https://www.ajkerbazzar.com/%e0%a6%87%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a7%8b%e0%a6%a8%e0%a7%87%e0%a6%b6%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%85%e0%a6%97%e0%a7%8d%e0%a6%a8%e0%a6%bf%e0%a6%a8%e0%a6%bf%e0%a6%b0/</guid>
      <pubDate>Sun, 08 Nov 2026 12:17:49 +0000</pubDate>
      <enclosure url="https://www.ajkerbazzar.com/wp-content/uploads/2026/11/image-357874-1794139293.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.ajkerbazzar.com/wp-content/uploads/2026/11/image-357874-1794139293.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.ajkerbazzar.com/wp-content/uploads/2026/11/image-357874-1794139293.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইন্দোনেশিয়ায় অগ্নিনির্বাপণ কাজে নিয়োজিত হেলিকপ্টার বিধ্বস্ত" /&gt;&lt;/p&gt;&lt;p&gt;ইন্দোনেশিয়ায় দাবানল নিয়ন্ত্রণে পানি ছিটানোর কাজে নিয়োজিত একটি হেলিকপ্টার রোববার নদীতে বিধ্বস্ত হয়েছে। পানি সংগ্রহের সময় এ দুর্ঘটনা ঘটে। এ দুর্ঘটনায় দুই ক্রু সদস্যকে উদ্ধার করা হয়েছে। তবে অপর একজন এখনো নিখোঁজ রয়েছেন বলে দেশটির এক কর্মকর্তা এএফপিকে জানিয়েছেন। বোর্নিও দ্বীপের দক্ষিণ কালিমান্তান প্রদেশ&lt;/p&gt;</description>
      <source url="https://www.ajkerbazzar.com/%e0%a6%87%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a7%8b%e0%a6%a8%e0%a7%87%e0%a6%b6%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%85%e0%a6%97%e0%a7%8d%e0%a6%a8%e0%a6%bf%e0%a6%a8%e0%a6%bf%e0%a6%b0/">আজকের বাজার</source>
    </item>
    <item>
      <title>জিয়াউর রহমান ও খালেদা জিয়ার সমাধিতে শ্রদ্ধা নিবেদন করলেন প্রধানমন্ত্রী</title>
      <link>https://www.ajkerbazzar.com/%e0%a6%9c%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%89%e0%a6%b0-%e0%a6%b0%e0%a6%b9%e0%a6%ae%e0%a6%be%e0%a6%a8-%e0%a6%93-%e0%a6%96%e0%a6%be%e0%a6%b2%e0%a7%87%e0%a6%a6%e0%a6%be-%e0%a6%9c%e0%a6%bf-6/</link>
      <guid isPermaLink="true">https://www.ajkerbazzar.com/%e0%a6%9c%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%89%e0%a6%b0-%e0%a6%b0%e0%a6%b9%e0%a6%ae%e0%a6%be%e0%a6%a8-%e0%a6%93-%e0%a6%96%e0%a6%be%e0%a6%b2%e0%a7%87%e0%a6%a6%e0%a6%be-%e0%a6%9c%e0%a6%bf-6/</guid>
      <pubDate>Sun, 08 Nov 2026 12:14:43 +0000</pubDate>
      <enclosure url="https://www.ajkerbazzar.com/wp-content/uploads/2026/11/image-357414-1794024660.jpeg" length="0" type="image/jpeg" />
      <media:content url="https://www.ajkerbazzar.com/wp-content/uploads/2026/11/image-357414-1794024660.jpeg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://www.ajkerbazzar.com/wp-content/uploads/2026/11/image-357414-1794024660.jpeg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জিয়াউর রহমান ও খালেদা জিয়ার সমাধিতে শ্রদ্ধা নিবেদন করলেন প্রধানমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;জাতীয় বিপ্লব ও সংহতি দিবস উপলক্ষে শহীদ রাষ্ট্রপতি জিয়াউর রহমান ও সাবেক প্রধানমন্ত্রী খালেদা জিয়ার সমাধিতে শ্রদ্ধা নিবেদন করেছেন প্রধানমন্ত্রী ও বিএনপি চেয়ারম্যান তারেক রহমান। আজ শনিবার সকাল সাড়ে ৮টায় দলের কেন্দ্রীয় নেতাদের সঙ্গে নিয়ে তিনি রাজধানীর জিয়া উদ্যানে যান। প্রধানমন্ত্রী তারেক রহমান কেন্দ্রী&lt;/p&gt;</description>
      <source url="https://www.ajkerbazzar.com/%e0%a6%9c%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%89%e0%a6%b0-%e0%a6%b0%e0%a6%b9%e0%a6%ae%e0%a6%be%e0%a6%a8-%e0%a6%93-%e0%a6%96%e0%a6%be%e0%a6%b2%e0%a7%87%e0%a6%a6%e0%a6%be-%e0%a6%9c%e0%a6%bf-6/">আজকের বাজার</source>
    </item>
    <item>
      <title>কাজের মাধ্যমেই রাজনীতিতে নেতৃত্বের অবস্থান তৈরি করতে হয়: আইনমন্ত্রী</title>
      <link>https://www.ajkerbazzar.com/%e0%a6%95%e0%a6%be%e0%a6%9c%e0%a7%87%e0%a6%b0-%e0%a6%ae%e0%a6%be%e0%a6%a7%e0%a7%8d%e0%a6%af%e0%a6%ae%e0%a7%87%e0%a6%87-%e0%a6%b0%e0%a6%be%e0%a6%9c%e0%a6%a8%e0%a7%80%e0%a6%a4%e0%a6%bf%e0%a6%a4%e0%a7%87/</link>

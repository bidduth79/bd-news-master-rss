    <item>
      <title>কোন ইউনিয়নে কবে ভোট, বৃহস্পতিবার জানাবে ইসি দেশে পাঁচ ধাপে ইউনিয়ন পরিষদ নির্বাচন আয়োজনের পরিকল্পনা করছে নির্বাচন কমিশন (ইসি)। প্রথম ধাপে ১৩১টি উপজেলার ১ হাজার ২৬টি ইউনিয়ন, দ্বিতীয় ধাপে ১২৯টি উপজেলার ১ হাজার ১১৩টি ইউনিয়ন, তৃতীয় ধাপে ১১৮টি উপজেলার ১ হাজার ২টি ইউনিয়ন, চতুর্থ ধাপে ৯৩টি উপজেলার ৭৯৩টি ইউনিয়ন এবং পঞ্চম ধাপে ৩৭টি উপজেলার ৩৫০টি ইউনিয়নে ভোটগ্রহণ অনুষ্ঠিত হবে।</title>
      <link>https://www.bvnews24.com/national/news/221959</link>
      <guid isPermaLink="true">https://www.bvnews24.com/national/news/221959</guid>
      <pubDate>Mon, 16 Nov 2026 09:13:38 +0000</pubDate>
      <enclosure url="https://www.bvnews24.com/media/imgAll/2026October/1d5c4370-6b7b-11ef-8c32-f3c2bc7494c6-1-2611160741.jpg" length="0" type="image/jpeg" />
      <media:content url="https://www.bvnews24.com/media/imgAll/2026October/1d5c4370-6b7b-11ef-8c32-f3c2bc7494c6-1-2611160741.jpg" medium="image" />

    <item>
      <title>গণমাধ্যম নিয়ন্ত্রণের ইচ্ছা সরকারের নেই: তথ্য প্রতিমন্ত্রী</title>
      <link>https://shamolbangla24.com/2026/11/10/%e0%a6%97%e0%a6%a3%e0%a6%ae%e0%a6%be%e0%a6%a7%e0%a7%8d%e0%a6%af%e0%a6%ae-%e0%a6%a8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%a8%e0%a7%8d%e0%a6%a4%e0%a7%8d%e0%a6%b0%e0%a6%a3%e0%a7%87%e0%a6%b0-%e0%a6%87%e0%a6%9a/</link>

    <item>
      <title>লাহোর কালান্দার্সের নতুন দায়িত্বে সাবেক বিসিবি সভাপতি</title>
      <link>https://shamolbangla24.com/2026/11/10/%e0%a6%b2%e0%a6%be%e0%a6%b9%e0%a7%8b%e0%a6%b0-%e0%a6%95%e0%a6%be%e0%a6%b2%e0%a6%be%e0%a6%a8%e0%a7%8d%e0%a6%a6%e0%a6%be%e0%a6%b0%e0%a7%8d%e0%a6%b8%e0%a7%87%e0%a6%b0-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8/</link>

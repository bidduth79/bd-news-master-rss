    <item>
      <title>শেরপুরে জমি নিয়ে বিরোধ, ভাতিজাদের হামলায় চাচা নিহত, অভিযুক্তদের বাড়িতে অগ্নিসংযোগ</title>
      <link>https://shamolbangla24.com/2026/11/09/%e0%a6%b6%e0%a7%87%e0%a6%b0%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87-%e0%a6%9c%e0%a6%ae%e0%a6%bf-%e0%a6%a8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%b0%e0%a7%8b%e0%a6%a7-%e0%a6%ad/</link>
      <guid isPermaLink="true">https://shamolbangla24.com/2026/11/09/%e0%a6%b6%e0%a7%87%e0%a6%b0%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87-%e0%a6%9c%e0%a6%ae%e0%a6%bf-%e0%a6%a8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%b0%e0%a7%8b%e0%a6%a7-%e0%a6%ad/</guid>
      <pubDate>Sun, 08 Nov 2026 18:56:30 +0000</pubDate>
      <description>শেরপুরে জমিসংক্রান্ত বিরোধের জেরে ভাতিজাদের হামলায় জিন্নাত আলী (৭০) নামে এক ব্যক্তি নিহত হয়েছেন। ৮ নভেম্বর রবিবার সন্ধ্যায় সদর উপজেলার লছমনপুর ইউনিয়নের কুসুমহাটি বাজারসংলগ্ন কাজীরচর এলাকায় এ ঘটনা ঘটে। নিহত জিন্নাত আলী কাজীরচর গ্রামের মৃত তনু শেখের ছেলে। তিনি পানি উন্নয়ন বোর্ডের সাবেক গাড়িচালক ছিলেন।</description>
      <source url="https://shamolbangla24.com/2026/11/09/%e0%a6%b6%e0%a7%87%e0%a6%b0%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87-%e0%a6%9c%e0%a6%ae%e0%a6%bf-%e0%a6%a8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%ac%e0%a6%bf%e0%a6%b0%e0%a7%8b%e0%a6%a7-%e0%a6%ad/">shamolbangla24.com</source>
    </item>
    <item>
      <title>শেরপুরে কমিউনিটি পুলিশিং আন্তঃজেলা কাবাডি চ্যাম্পিয়নশিপের ফাইনাল ও পুরস্কার বিতরণী</title>
      <link>https://shamolbangla24.com/2026/11/08/%e0%a6%b6%e0%a7%87%e0%a6%b0%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87-%e0%a6%95%e0%a6%ae%e0%a6%bf%e0%a6%89%e0%a6%a8%e0%a6%bf%e0%a6%9f%e0%a6%bf-%e0%a6%aa%e0%a7%81%e0%a6%b2%e0%a6%bf%e0%a6%b6%e0%a6%bf-6/</link>
      <guid isPermaLink="true">https://shamolbangla24.com/2026/11/08/%e0%a6%b6%e0%a7%87%e0%a6%b0%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87-%e0%a6%95%e0%a6%ae%e0%a6%bf%e0%a6%89%e0%a6%a8%e0%a6%bf%e0%a6%9f%e0%a6%bf-%e0%a6%aa%e0%a7%81%e0%a6%b2%e0%a6%bf%e0%a6%b6%e0%a6%bf-6/</guid>
      <pubDate>Sun, 08 Nov 2026 15:36:31 +0000</pubDate>
      <enclosure url="https://shamolbangla24.com/wp-content/uploads/2026/11/Kabaddi-2-821x476.jpg" length="0" type="image/jpeg" />
      <media:content url="https://shamolbangla24.com/wp-content/uploads/2026/11/Kabaddi-2-821x476.jpg" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://shamolbangla24.com/wp-content/uploads/2026/11/Kabaddi-2-821x476.jpg" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শেরপুরে কমিউনিটি পুলিশিং আন্তঃজেলা কাবাডি চ্যাম্পিয়নশিপের ফাইনাল ও পুরস্কার বিতরণী" /&gt;&lt;/p&gt;&lt;p&gt;‘ক্রীড়া হলে পেশা, পরিবার পাবে ভরসা’ এবং ‘মাদকদ্রব্য ত্যাগ করি, কিশোর গ্যাং নির্মূল করি, সুস্থ জীবন গড়ি’ এ স্লোগানকে সামনে রেখে খেলাধুলার মাধ্যমে তরুণ সমাজকে মাদক ও অপরাধ থেকে দূরে রাখা, কিশোর গ্যাং প্রতিরোধ এবং পুলিশ ও জনগণের মধ্যে পারস্পরিক আস্থা ও সম্প্রীতি সুদৃঢ় করার লক্ষ্যে প্রথম কমিউনিটি পুলিশি&lt;/p&gt;</description>
      <source url="https://shamolbangla24.com/2026/11/08/%e0%a6%b6%e0%a7%87%e0%a6%b0%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87-%e0%a6%95%e0%a6%ae%e0%a6%bf%e0%a6%89%e0%a6%a8%e0%a6%bf%e0%a6%9f%e0%a6%bf-%e0%a6%aa%e0%a7%81%e0%a6%b2%e0%a6%bf%e0%a6%b6%e0%a6%bf-6/">shamolbangla24.com</source>
    </item>
    <item>
      <title>শ্রীবরদীতে সাড়ে ৩ লাখ টাকার ভারতীয় প্রসাধনী জব্দ করল পুলিশ</title>
      <link>https://shamolbangla24.com/2026/11/08/%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a7%80%e0%a6%ac%e0%a6%b0%e0%a6%a6%e0%a7%80%e0%a6%a4%e0%a7%87-%e0%a6%b8%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a7%87-%e0%a7%a9-%e0%a6%b2%e0%a6%be%e0%a6%96-%e0%a6%9f%e0%a6%be/</link>
      <guid isPermaLink="true">https://shamolbangla24.com/2026/11/08/%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a7%80%e0%a6%ac%e0%a6%b0%e0%a6%a6%e0%a7%80%e0%a6%a4%e0%a7%87-%e0%a6%b8%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a7%87-%e0%a7%a9-%e0%a6%b2%e0%a6%be%e0%a6%96-%e0%a6%9f%e0%a6%be/</guid>
      <pubDate>Sun, 08 Nov 2026 15:11:27 +0000</pubDate>
      <description>শেরপুরের শ্রীবরদীতে শুল্ক ফাঁকি দিয়ে চোরাই পথে আনা প্রায় সাড়ে ৩ লাখ টাকা মূল্যের ভারতীয় প্রসাধনী ও একটি সিএনজিচালিত অটোরিকশা জব্দ করেছে পুলিশ। ৮ নভেম্বর রবিবার সকালে উপজেলার কাকিলাকুড়া চিথলিয়া নতুন বাজার এলাকায় এসব ভারতীয় প্রসাধনী জব্দ করা হয়। জানা যায়, রবিবার ভোরে উপজেলার কর্ণঝোড়া সীমান্ত এলাকা থেক</description>
      <source url="https://shamolbangla24.com/2026/11/08/%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a7%80%e0%a6%ac%e0%a6%b0%e0%a6%a6%e0%a7%80%e0%a6%a4%e0%a7%87-%e0%a6%b8%e0%a6%be%e0%a6%a1%e0%a6%bc%e0%a7%87-%e0%a7%a9-%e0%a6%b2%e0%a6%be%e0%a6%96-%e0%a6%9f%e0%a6%be/">shamolbangla24.com</source>
    </item>

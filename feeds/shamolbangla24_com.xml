    <item>
      <title>বিটিআরসির নতুন চেয়ারম্যান ওয়াহিদ-উজ-জামান</title>
      <link>https://shamolbangla24.com/2026/11/15/%e0%a6%ac%e0%a6%bf%e0%a6%9f%e0%a6%bf%e0%a6%86%e0%a6%b0%e0%a6%b8%e0%a6%bf%e0%a6%b0-%e0%a6%a8%e0%a6%a4%e0%a7%81%e0%a6%a8-%e0%a6%9a%e0%a7%87%e0%a6%af%e0%a6%bc%e0%a6%be%e0%a6%b0%e0%a6%ae%e0%a7%8d%e0%a6%af/</link>

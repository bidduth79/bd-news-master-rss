    <item>
      <title>শেরপুরে সরকারি প্রাথমিক বিদ্যালয় পরিদর্শন করলেন জেলা প্রশাসক</title>
      <link>https://shamolbangla24.com/2026/11/09/%e0%a6%b6%e0%a7%87%e0%a6%b0%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87-%e0%a6%b8%e0%a6%b0%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%bf-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%a5%e0%a6%ae%e0%a6%bf%e0%a6%95-2/</link>
      <guid isPermaLink="true">https://shamolbangla24.com/2026/11/09/%e0%a6%b6%e0%a7%87%e0%a6%b0%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87-%e0%a6%b8%e0%a6%b0%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%bf-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%a5%e0%a6%ae%e0%a6%bf%e0%a6%95-2/</guid>
      <pubDate>Mon, 09 Nov 2026 15:11:12 +0000</pubDate>
      <description>শেরপুর সদর উপজেলার চরশেরপুর নয়াপাড়া ও নাগপাড়া সরকারি প্রাথমিক বিদ্যালয় পরিদর্শন করেছেন জেলা প্রশাসক ফরিদা ইয়াসমিন। ৯ নভেম্বর সোমবার সকালে তিনি ওই বিদ্যালয় দুটি পরিদর্শনে যান। পরিদর্শনকালে নাগপাড়া সরকারি প্রাথমিক বিদ্যালয়ে শিক্ষার্থীদের উপস্থিতির হার মাত্র ২০ শতাংশ দেখে তিনি উদ্বেগ প্রকাশ করেন। শিক্ষ</description>
      <source url="https://shamolbangla24.com/2026/11/09/%e0%a6%b6%e0%a7%87%e0%a6%b0%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87-%e0%a6%b8%e0%a6%b0%e0%a6%95%e0%a6%be%e0%a6%b0%e0%a6%bf-%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%be%e0%a6%a5%e0%a6%ae%e0%a6%bf%e0%a6%95-2/">shamolbangla24.com</source>
    </item>
    <item>
      <title>সরি না বললে কি মেরে ফেলারও হুমকি দেবেন : পরীমনি</title>
      <link>https://shamolbangla24.com/2026/11/09/%e0%a6%b8%e0%a6%b0%e0%a6%bf-%e0%a6%a8%e0%a6%be-%e0%a6%ac%e0%a6%b2%e0%a6%b2%e0%a7%87-%e0%a6%95%e0%a6%bf-%e0%a6%ae%e0%a7%87%e0%a6%b0%e0%a7%87-%e0%a6%ab%e0%a7%87%e0%a6%b2%e0%a6%be%e0%a6%b0%e0%a6%93/</link>
      <guid isPermaLink="true">https://shamolbangla24.com/2026/11/09/%e0%a6%b8%e0%a6%b0%e0%a6%bf-%e0%a6%a8%e0%a6%be-%e0%a6%ac%e0%a6%b2%e0%a6%b2%e0%a7%87-%e0%a6%95%e0%a6%bf-%e0%a6%ae%e0%a7%87%e0%a6%b0%e0%a7%87-%e0%a6%ab%e0%a7%87%e0%a6%b2%e0%a6%be%e0%a6%b0%e0%a6%93/</guid>
      <pubDate>Mon, 09 Nov 2026 14:52:11 +0000</pubDate>
      <description>গুলশানে একটি অনুষ্ঠানে গিয়ে অনাকাঙ্ক্ষিত পরিস্থিতির মুখে পড়ার অভিযোগ করেছেন চিত্রনায়িকা পরীমনি। তার দাবি, মধ্যরাতে তার গাড়িতেও হামলা হয়েছে। এ ঘটনার পর সামাজিক যোগাযোগ মাধ্যমে দেওয়া এক ভিডিও বার্তায় ক্ষোভ প্রকাশ করেছেন অভিনেত্রী। তাকে দিয়ে জোর করে ক্ষমা চাওয়ানোর চেষ্টা, অপদস্থ করা, কাজে বাধা দেওয়া এব</description>
      <source url="https://shamolbangla24.com/2026/11/09/%e0%a6%b8%e0%a6%b0%e0%a6%bf-%e0%a6%a8%e0%a6%be-%e0%a6%ac%e0%a6%b2%e0%a6%b2%e0%a7%87-%e0%a6%95%e0%a6%bf-%e0%a6%ae%e0%a7%87%e0%a6%b0%e0%a7%87-%e0%a6%ab%e0%a7%87%e0%a6%b2%e0%a6%be%e0%a6%b0%e0%a6%93/">shamolbangla24.com</source>
    </item>
    <item>
      <title>পাকিস্তানে নারী টিভি উপস্থাপককে গুলি করে হত্যা</title>
      <link>https://shamolbangla24.com/2026/11/09/%e0%a6%aa%e0%a6%be%e0%a6%95%e0%a6%bf%e0%a6%b8%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%a8%e0%a6%be%e0%a6%b0%e0%a7%80-%e0%a6%9f%e0%a6%bf%e0%a6%ad%e0%a6%bf-%e0%a6%89%e0%a6%aa%e0%a6%b8/</link>
      <guid isPermaLink="true">https://shamolbangla24.com/2026/11/09/%e0%a6%aa%e0%a6%be%e0%a6%95%e0%a6%bf%e0%a6%b8%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%a8%e0%a6%be%e0%a6%b0%e0%a7%80-%e0%a6%9f%e0%a6%bf%e0%a6%ad%e0%a6%bf-%e0%a6%89%e0%a6%aa%e0%a6%b8/</guid>
      <pubDate>Mon, 09 Nov 2026 14:48:02 +0000</pubDate>
      <description>পাকিস্তানের রাওয়ালপিন্ডিতে নিজ বাড়ি থেকে দেশটির বেসরকারি এক টেলিভিশন চ্যানেলের উপস্থাপিকা রাবিয়া আহসানের গুলিবিদ্ধ মরদেহ উদ্ধার করা হয়েছে। হত্যাকাণ্ডের এই ঘটনায় ওই নারীর স্বামী আহসান তাহিরকে হেফাজতে নিয়েছে পুলিশ। একই সঙ্গে হত্যাকাণ্ডে ব্যবহৃত অস্ত্রও জব্দ করা হয়েছে। রবিবার পাকিস্তানি সংবাদমাধ্যম</description>
      <source url="https://shamolbangla24.com/2026/11/09/%e0%a6%aa%e0%a6%be%e0%a6%95%e0%a6%bf%e0%a6%b8%e0%a7%8d%e0%a6%a4%e0%a6%be%e0%a6%a8%e0%a7%87-%e0%a6%a8%e0%a6%be%e0%a6%b0%e0%a7%80-%e0%a6%9f%e0%a6%bf%e0%a6%ad%e0%a6%bf-%e0%a6%89%e0%a6%aa%e0%a6%b8/">shamolbangla24.com</source>
    </item>
    <item>
      <title>৬ শিল্পাঞ্চলে ১০০ শয্যার শ্রমিক হাসপাতাল নির্মাণের ঘোষণা প্রধানমন্ত্রীর</title>
      <link>https://shamolbangla24.com/2026/11/09/%e0%a7%ac-%e0%a6%b6%e0%a6%bf%e0%a6%b2%e0%a7%8d%e0%a6%aa%e0%a6%be%e0%a6%9e%e0%a7%8d%e0%a6%9a%e0%a6%b2%e0%a7%87-%e0%a7%a7%e0%a7%a6%e0%a7%a6-%e0%a6%b6%e0%a6%af%e0%a7%8d%e0%a6%af%e0%a6%be%e0%a6%b0/</link>

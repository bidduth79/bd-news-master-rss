    <item>
      <title>শেরপুরে নমুনা শস্য কর্তন উৎসব অনুষ্ঠিত</title>
      <link>https://shamolbangla24.com/2026/11/12/%e0%a6%b6%e0%a7%87%e0%a6%b0%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87-%e0%a6%a8%e0%a6%ae%e0%a7%81%e0%a6%a8%e0%a6%be-%e0%a6%b6%e0%a6%b8%e0%a7%8d%e0%a6%af-%e0%a6%95%e0%a6%b0%e0%a7%8d%e0%a6%a4%e0%a6%a8/</link>

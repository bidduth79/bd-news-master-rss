    <item>
      <title>শেরপুরে ‘সুজন’ এর দুই যুগ পূর্তি উপলক্ষে আলোচনা সভা অনুষ্ঠিত</title>
      <link>https://shamolbangla24.com/2026/11/12/%e0%a6%b6%e0%a7%87%e0%a6%b0%e0%a6%aa%e0%a7%81%e0%a6%b0%e0%a7%87-%e0%a6%b8%e0%a7%81%e0%a6%9c%e0%a6%a8-%e0%a6%8f%e0%a6%b0-%e0%a6%a6%e0%a7%81%e0%a6%87-%e0%a6%af%e0%a7%81%e0%a6%97/</link>

      <description>২০২৭ শিক্ষাবর্ষে বেসরকারি বিদ্যালয়ে প্রথম শ্রেণিতে ভর্তির ক্ষেত্রে শিশুর বয়স কমপক্ষে ছয় বছর হতে হবে। তবে সাত বছর পূর্ণ হলে প্রথম শ্রেণিতে ভর্তি হওয়া যাবে না। বিশেষ চাহিদাসম্পন্ন শিক্ষার্থীদের ক্ষেত্রে বয়সসীমায় সর্বোচ্চ পাঁচ বছর ছাড় দেওয়ার সুযোগ রাখা হয়েছে। এ ছাড়া প্রতিটি শ্রেণির প্রতি শাখায় সর্বোচ্চ</description>
      <source url="https://shamolbangla24.com/2026/11/11/%e0%a6%aa%e0%a7%8d%e0%a6%b0%e0%a6%a5%e0%a6%ae-%e0%a6%b6%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%a3%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%ad%e0%a6%b0%e0%a7%8d%e0%a6%a4%e0%a6%bf%e0%a6%b0-%e0%a6%ac%e0%a6%af/">shamolbangla24.com</source>

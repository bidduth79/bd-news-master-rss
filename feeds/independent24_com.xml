      <guid isPermaLink="true">https://www.itvbd.com/national/277955/%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A6%95-%E0%A6%9A%E0%A7%8B%E0%A6%B0%E0%A6%BE%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A7%9F%E0%A7%87-%E0%A6%B8%E0%A7%8C%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A7%AB-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF</guid>
      <pubDate>Thu, 12 Nov 2026 15:02:32 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/09/07/e23df1a9dd45cc874199546df03a393f-6a9e48c0eff42.jpg?jadewits_media_id=165895" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/09/07/e23df1a9dd45cc874199546df03a393f-6a9e48c0eff42.jpg?jadewits_media_id=165895" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/09/07/e23df1a9dd45cc874199546df03a393f-6a9e48c0eff42.jpg?jadewits_media_id=165895" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মাদক চোরাচালানের দায়ে সৌদিতে ৫ বাংলাদেশি গ্রেপ্তার" /&gt;&lt;/p&gt;&lt;p&gt;মাদক চোরাচালানের দায়ে পাঁচ বাংলাদেশিকে গ্রেপ্তার করেছে সৌদি আরব। বুধবার এক্সে দেওয়া এক পোস্টে জানিয়েছে দেশটির মাদকদ্রব্য নিয়ন্ত্রণ মহাপরিদপ্তর। তাতে বলা হয়, গ্রেপ্তারের পর অভিযুক্তদের বিরুদ্ধে আইনি পদক্ষেপ শুরু হয়েছে।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/national/277955/%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A6%95-%E0%A6%9A%E0%A7%8B%E0%A6%B0%E0%A6%BE%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A7%9F%E0%A7%87-%E0%A6%B8%E0%A7%8C%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A7%AB-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF">ইনডিপেনডেন্ট টিভি</source>
    </item>
    <item>
      <title>গাজীপুরে চাঁদা না দেওয়ায় অপপ্রচারের অভিযোগ, ভুক্তভোগীর সংবাদ সম্মেলন</title>
      <link>https://www.itvbd.com/country/dhaka/277954/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A7%80%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%BE-%E0%A6%A8%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%85%E0%A6%AA%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97</link>
      <guid isPermaLink="true">https://www.itvbd.com/country/dhaka/277954/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A7%80%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%BE-%E0%A6%A8%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%93%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%85%E0%A6%AA%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97</guid>
      <pubDate>Thu, 12 Nov 2026 14:45:08 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/f586278ca19c4d4d76146937c2d1b990-6af57c6caafb0.jpg?jadewits_media_id=167800" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/f586278ca19c4d4d76146937c2d1b990-6af57c6caafb0.jpg?jadewits_media_id=167800" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/f586278ca19c4d4d76146937c2d1b990-6af57c6caafb0.jpg?jadewits_media_id=167800" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গাজীপুরে চাঁদা না দেওয়ায় অপপ্রচারের অভিযোগ, ভুক্তভোগীর সংবাদ সম্মেলন" /&gt;&lt;/p&gt;&lt;p&gt;গাজীপুরে ব্যবসায়িক বিরোধ ও ব্যক্তিস্বার্থে নানাভাবে হয়রানি ও ২০ লাখ টাকা চাঁদা না দেওয়ায় বিভিন্ন মাধ্যমে একের পর এক মিথ্যা ও বানোয়াট তথ্য প্রকাশের প্রতিবাদে সংবাদ সম্মেলন অনুষ্ঠিত হয়েছে। আজ বৃহস্পতিবার দুপুরে নগরীর বোর্ড বাজারে স্থানীয় একটি রেস্তোরাঁয় আয়োজিত সংবাদ সম্মেলনে লিখিত বক্তব্য তুল&lt;/p&gt;</description>

      <pubDate>Thu, 12 Nov 2026 22:27:04 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/a40426e7e677c141f1c1e226907ee672-6af5e8d4b5875.jpg?jadewits_media_id=167825" length="0" type="image/jpeg" />

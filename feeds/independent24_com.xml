      <guid isPermaLink="true">https://www.itvbd.com/country/277742/%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9F%E0%A6%95%E0%A7%8B%E0%A6%B0-%E0%A6%B8%E0%A6%AD%E0%A6%BE%E0%A6%AA%E0%A6%A4%E0%A6%BF-%E0%A6%85%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A6%A8-%E0%A6%9A%E0%A7%8C%E0%A6%A7%E0%A7%81%E0%A6%B0%E0%A7%80-%E0%A6%B8%E0%A6%BE%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A6%A3-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BE%E0%A6%A6%E0%A6%95</guid>
      <pubDate>Sun, 08 Nov 2026 17:02:34 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/8f435f47b5f552147efb62fdd621fa98-6af0567f3e0ff.jpg?jadewits_media_id=167655" length="0" type="image/jpeg" />

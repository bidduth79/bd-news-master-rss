    <item>
      <title>‘আপনি তবুও অমলিন! চিরঞ্জীব!’ সঞ্জীবকে স্মরণে আবেগঘন বাপ্পা</title>
      <link>https://www.itvbd.com/entertainment/music/278289/%E2%80%98%E0%A6%86%E0%A6%AA%E0%A6%A8%E0%A6%BF-%E0%A6%A4%E0%A6%AC%E0%A7%81%E0%A6%93-%E0%A6%85%E0%A6%AE%E0%A6%B2%E0%A6%BF%E0%A6%A8-%E0%A6%9A%E0%A6%BF%E0%A6%B0%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%80%E0%A6%AC-%E2%80%99-%E0%A6%B8%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%80%E0%A6%AC%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%AE%E0%A6%B0%E0%A6%A3%E0%A7%87</link>
      <guid isPermaLink="true">https://www.itvbd.com/entertainment/music/278289/%E2%80%98%E0%A6%86%E0%A6%AA%E0%A6%A8%E0%A6%BF-%E0%A6%A4%E0%A6%AC%E0%A7%81%E0%A6%93-%E0%A6%85%E0%A6%AE%E0%A6%B2%E0%A6%BF%E0%A6%A8-%E0%A6%9A%E0%A6%BF%E0%A6%B0%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%80%E0%A6%AC-%E2%80%99-%E0%A6%B8%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%80%E0%A6%AC%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%AE%E0%A6%B0%E0%A6%A3%E0%A7%87</guid>
      <pubDate>Thu, 19 Nov 2026 14:06:52 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/9aba2544d7c043a01f464626a5de1ce5-6afeadfe1f58d.jpg?jadewits_media_id=168005" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/9aba2544d7c043a01f464626a5de1ce5-6afeadfe1f58d.jpg?jadewits_media_id=168005" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/9aba2544d7c043a01f464626a5de1ce5-6afeadfe1f58d.jpg?jadewits_media_id=168005" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘আপনি তবুও অমলিন! চিরঞ্জীব!’ সঞ্জীবকে স্মরণে আবেগঘন বাপ্পা" /&gt;&lt;/p&gt;&lt;p&gt;আজ ১৯ নভেম্বর সঞ্জীব চৌধুরীর প্রয়াণ দিবস। ২০০৭ সালের এই দিনে না ফেরার দেশে পাড়ি দেন বরেণ্য এই সংগীতশিল্পী ও সাংবাদিক। দেখতে দেখতে ১৯ বছর পেরিয়ে গেলেও সংগীতপ্রেমীদের হৃদয়ে আজও তিনি অমলিন। সঞ্জীব চৌধুরীর প্রতি শ্রদ্ধা ও ভালোবাসা আগের মতোই অটুট রয়েছে জনপ্রিয় সংগীতশিল্পী বাপ্পা মজুমদারের মনেও—সামা&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/entertainment/music/278289/%E2%80%98%E0%A6%86%E0%A6%AA%E0%A6%A8%E0%A6%BF-%E0%A6%A4%E0%A6%AC%E0%A7%81%E0%A6%93-%E0%A6%85%E0%A6%AE%E0%A6%B2%E0%A6%BF%E0%A6%A8-%E0%A6%9A%E0%A6%BF%E0%A6%B0%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%80%E0%A6%AC-%E2%80%99-%E0%A6%B8%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%80%E0%A6%AC%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%AE%E0%A6%B0%E0%A6%A3%E0%A7%87">ইনডিপেনডেন্ট টিভি</source>

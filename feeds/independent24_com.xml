      <guid isPermaLink="true">https://www.itvbd.com/country/dhaka/278398/%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8B%E0%A6%B2%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%B8%E0%A6%B9%E0%A6%BF%E0%A6%82%E0%A6%B8%E0%A6%A4%E0%A6%BE-%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%A8-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95-%E0%A6%B8%E0%A6%82%E0%A6%97%E0%A6%A0%E0%A6%A8%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Sat, 21 Nov 2026 14:57:58 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/8421d5a6f0127c515eb07ddeeab75f97-6b015d07915fb.jpg?jadewits_media_id=168066" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/8421d5a6f0127c515eb07ddeeab75f97-6b015d07915fb.jpg?jadewits_media_id=168066" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/8421d5a6f0127c515eb07ddeeab75f97-6b015d07915fb.jpg?jadewits_media_id=168066" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আন্দোলনের নামে সহিংসতা রোধে বিভিন্ন শ্রমিক সংগঠনের মতবিনিময়" /&gt;&lt;/p&gt;&lt;p&gt;আন্দোলনের নামে সহিংসতা রোধ ও  শ্রমিকদের ন্যায় সঙ্গত দাবি আদায়ে গাজীপুরের বিভিন্ন গার্মেন্টস শ্রমিক ফেডারেশনের নেতাদের অংশগ্রহণে এক মতবিনিময় সভা অনুষ্ঠিত হয়েছে। শনিবার দুপুরে ভোগড়া বাইপাস এলাকায় সম্মিলিত গার্মেন্টস ফেডারেশন ঐক্য পরিষদ এ মতবিনিময় সভার আয়োজন করে। 						বিস্তারিত&lt;/p&gt;</description>

    <item>
      <title>জনগণকে নিয়ে কার্যক্রম নিষিদ্ধ দলকে প্রতিহত করা হবে: রিজভী</title>
      <link>https://www.itvbd.com/politics/278301/%E0%A6%9C%E0%A6%A8%E0%A6%97%E0%A6%A3%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%A6%E0%A6%B2%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.itvbd.com/politics/278301/%E0%A6%9C%E0%A6%A8%E0%A6%97%E0%A6%A3%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%A6%E0%A6%B2%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%BE</guid>
      <pubDate>Thu, 19 Nov 2026 17:19:50 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/03cb398c0f97f38f57721009dd270166-6afedb5466b60.jpg?jadewits_media_id=168013" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/03cb398c0f97f38f57721009dd270166-6afedb5466b60.jpg?jadewits_media_id=168013" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/03cb398c0f97f38f57721009dd270166-6afedb5466b60.jpg?jadewits_media_id=168013" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জনগণকে নিয়ে কার্যক্রম নিষিদ্ধ দলকে প্রতিহত করা হবে: রিজভী" /&gt;&lt;/p&gt;&lt;p&gt;কার্যক্রম নিষিদ্ধ একটি রাজনৈতিক দল এখন পঞ্চম বাহিনী হিসেবে আবির্ভূত হয়েছে। আবারও তারা লুটপাটতন্ত্র, মানুষ হত্যা ও পুলিশ হত্যা করে দেশকে অস্থিতিশীল করতে চায়। এমন মন্তব্য বিএনপির ভারপ্রাপ্ত মাহসচিব রুহুল কবির রিজভীর। বৃহস্পতিবার দুপুরে রাজধানীর পল্টনে বিএনপির কেন্দ্রীয় কার্যালয়ে এক সংবাদ সম্মেলনে রিজভ&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/politics/278301/%E0%A6%9C%E0%A6%A8%E0%A6%97%E0%A6%A3%E0%A6%95%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%A6%E0%A6%B2%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%BE">ইনডিপেনডেন্ট টিভি</source>
    </item>

    <item>
      <title>ডিএসসিসির খালখনন কর্মসূচিতে প্রশাসকের সামনেই বিএনপির দু’পক্ষের সংঘর্ষ</title>
      <link>https://www.itvbd.com/country/dhaka/278270/%E0%A6%A1%E0%A6%BF%E0%A6%8F%E0%A6%B8%E0%A6%B8%E0%A6%BF%E0%A6%B8%E0%A6%BF%E0%A6%B0-%E0%A6%96%E0%A6%BE%E0%A6%B2%E0%A6%96%E0%A6%A8%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%B8%E0%A7%82%E0%A6%9A%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B6%E0%A6%BE%E0%A6%B8%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%87%E0%A6%87</link>
      <guid isPermaLink="true">https://www.itvbd.com/country/dhaka/278270/%E0%A6%A1%E0%A6%BF%E0%A6%8F%E0%A6%B8%E0%A6%B8%E0%A6%BF%E0%A6%B8%E0%A6%BF%E0%A6%B0-%E0%A6%96%E0%A6%BE%E0%A6%B2%E0%A6%96%E0%A6%A8%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%B8%E0%A7%82%E0%A6%9A%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B6%E0%A6%BE%E0%A6%B8%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%87%E0%A6%87</guid>
      <pubDate>Wed, 18 Nov 2026 22:58:29 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/d965cc036f263b08fb660262e11e0649-6afdd926939ed.jpg?jadewits_media_id=167991" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/d965cc036f263b08fb660262e11e0649-6afdd926939ed.jpg?jadewits_media_id=167991" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/d965cc036f263b08fb660262e11e0649-6afdd926939ed.jpg?jadewits_media_id=167991" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডিএসসিসির খালখনন কর্মসূচিতে প্রশাসকের সামনেই বিএনপির দু’পক্ষের সংঘর্ষ" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর ডেমরায় খাল খনন কর্মসূচিকে কেন্দ্র করে বিএনপির দুই পক্ষের মধ্যে সংঘর্ষের ঘটনা ঘটেছে। বুধবার দুপুরে ডেমরার স্টাফ কোয়ার্টার এলাকায় ডগাইর-বামৈল এলাকার প্রধান ও শাখা খাল পরিষ্কার এবং পুনঃখননকাজের উদ্বোধনী অনুষ্ঠানে এ সংঘর্ষ হয়। অনুষ্ঠানের প্রধান অতিথি ঢাকা দক্ষিণ সিটি করপোরেশনের (ডিএসসিসি) প্রশা&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/country/dhaka/278270/%E0%A6%A1%E0%A6%BF%E0%A6%8F%E0%A6%B8%E0%A6%B8%E0%A6%BF%E0%A6%B8%E0%A6%BF%E0%A6%B0-%E0%A6%96%E0%A6%BE%E0%A6%B2%E0%A6%96%E0%A6%A8%E0%A6%A8-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%B8%E0%A7%82%E0%A6%9A%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B6%E0%A6%BE%E0%A6%B8%E0%A6%95%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%87%E0%A6%87">ইনডিপেনডেন্ট টিভি</source>
    </item>
    <item>
      <title>শ ম রেজাউল করিমের ২ বাড়িতে হামলা</title>
      <link>https://www.itvbd.com/country/barisal/278269/%E0%A6%B6-%E0%A6%AE-%E0%A6%B0%E0%A7%87%E0%A6%9C%E0%A6%BE%E0%A6%89%E0%A6%B2-%E0%A6%95%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A7%A8-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.itvbd.com/country/barisal/278269/%E0%A6%B6-%E0%A6%AE-%E0%A6%B0%E0%A7%87%E0%A6%9C%E0%A6%BE%E0%A6%89%E0%A6%B2-%E0%A6%95%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A7%A8-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE</guid>

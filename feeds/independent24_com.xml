      <guid isPermaLink="true">https://www.itvbd.com/national/277865/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A8%E0%A7%88%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A6%B9%E0%A6%B2%E0%A7%87-%E0%A6%A4%E0%A6%BE-%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A6%BE%E0%A6%87-%E0%A6%95%E0%A6%B0%E0%A6%BE-%E0%A6%B9%E0%A6%AC%E0%A7%87</guid>
      <pubDate>Tue, 10 Nov 2026 20:39:30 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/10/23/98c8155112550ad2c9bc5cd12ea1d6a0-68f9d7a45546c.jpg?jadewits_media_id=142921" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/10/23/98c8155112550ad2c9bc5cd12ea1d6a0-68f9d7a45546c.jpg?jadewits_media_id=142921" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/10/23/98c8155112550ad2c9bc5cd12ea1d6a0-68f9d7a45546c.jpg?jadewits_media_id=142921" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজনৈতিক কারণে মামলা হলে তা যাচাই করা হবে: আইনমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;ধর্ষণ ছাড়া, হত্যাসহ অন্যান্য মামলা রাজনৈতিক কারণে হয়ে থাকলে, তা যাচাই করে প্রত্যাহার করা হবে বলে জানিয়েছেন আইনমন্ত্রী মো. আসাদুজ্জামান।

মঙ্গলবার সংসদে প্রশ্নোত্তর পর্বে, এ কথা বলেন মন্ত্রী। এসময়, রাজনৈতিক কারণে দায়ের করা হয়রানিমূলক ২৪ হাজার ১৩টি মামলা সরকার প্রত্যাহার করেছে বলেও তথ্য দেন তিনি। 				&lt;/p&gt;</description>

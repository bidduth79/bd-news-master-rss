    <item>
      <title>পোশাক খাতের অস্থিরতায় দিনে ক্ষতি ৪০০ কোটি টাকা</title>
      <link>https://www.itvbd.com/economy/278334/%E0%A6%AA%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%95-%E0%A6%96%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BF%E0%A6%B0%E0%A6%A4%E0%A6%BE%E0%A7%9F-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A4%E0%A6%BF-%E0%A7%AA%E0%A7%A6%E0%A7%A6-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.itvbd.com/economy/278334/%E0%A6%AA%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%95-%E0%A6%96%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BF%E0%A6%B0%E0%A6%A4%E0%A6%BE%E0%A7%9F-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A4%E0%A6%BF-%E0%A7%AA%E0%A7%A6%E0%A7%A6-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE</guid>
      <pubDate>Fri, 20 Nov 2026 07:57:16 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/03/22/6f66433cce31ab20725d5b08a4f2d7d3-67de9f5a54217.jpg?jadewits_media_id=112050" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/03/22/6f66433cce31ab20725d5b08a4f2d7d3-67de9f5a54217.jpg?jadewits_media_id=112050" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/03/22/6f66433cce31ab20725d5b08a4f2d7d3-67de9f5a54217.jpg?jadewits_media_id=112050" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পোশাক খাতের অস্থিরতায় দিনে ক্ষতি ৪০০ কোটি টাকা" /&gt;&lt;/p&gt;&lt;p&gt;মজুরি বৃদ্ধির দাবিতে শ্রমিক অসন্তোষে প্রতিদিন বন্ধ থাকছে তৈরি পোশাক খাতের এক-তৃতীয়াংশ কারখানা। এতে দিনে ৪০০ কোটি টাকার বেশি ক্ষতি হচ্ছে দাবি বিজিএমইএর।  ক্রয়াদেশ অন্য দেশে চলে যাওয়া এবং কারখানা স্থায়ীভাবে বন্ধের ঝুঁকিও বাড়ছে। এ পরিস্থিতিতে অর্থনৈতিক ক্ষতি ও রপ্তানি বাজার ধরে রাখতে দ্রুত অসন্তোষ নিরস&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/economy/278334/%E0%A6%AA%E0%A7%8B%E0%A6%B6%E0%A6%BE%E0%A6%95-%E0%A6%96%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BF%E0%A6%B0%E0%A6%A4%E0%A6%BE%E0%A7%9F-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A4%E0%A6%BF-%E0%A7%AA%E0%A7%A6%E0%A7%A6-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE">ইনডিপেনডেন্ট টিভি</source>
    </item>
    <item>
      <title>নতুন খসড়া চুক্তিতে জীবাশ্ম জ্বালানির ব্যবহার সীমিতকরণ প্রসঙ্গ বাদ!</title>

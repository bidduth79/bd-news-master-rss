      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/bf3d1c19fae3fdad2debee12d04ab9fc-6af3ea12bea03.JPG?jadewits_media_id=167742" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/bf3d1c19fae3fdad2debee12d04ab9fc-6af3ea12bea03.JPG?jadewits_media_id=167742" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/11/bf3d1c19fae3fdad2debee12d04ab9fc-6af3ea12bea03.JPG?jadewits_media_id=167742" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নতুন খসড়া চুক্তিতে জীবাশ্ম জ্বালানির ব্যবহার সীমিতকরণ প্রসঙ্গ বাদ!" /&gt;&lt;/p&gt;&lt;p&gt;জলবায়ু সম্মেলন কপ-৩১-এর নতুন খসড়া চুক্তি থেকে জীবাশ্ম জ্বালানির ব্যবহার সীমিত করার প্রসঙ্গ বাদ পড়েছে। বাদ গেছে উন্নয়নশীল দেশগুলোর জলবায়ু অভিযোজনের জন্য ১২০ বিলিয়ন ডলার অর্থায়নের লক্ষ্যমাত্রাও। 						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/environment/278333/%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%96%E0%A6%B8%E0%A7%9C%E0%A6%BE-%E0%A6%9A%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%9C%E0%A7%80%E0%A6%AC%E0%A6%BE%E0%A6%B6%E0%A7%8D%E0%A6%AE-%E0%A6%9C%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B9%E0%A6%BE%E0%A6%B0">ইনডিপেনডেন্ট টিভি</source>
    </item>
    <item>
      <title>রোহিঙ্গা ইস্যুতে লন্ডনে মিয়ানমার দূতাবাসের প্রতিরক্ষা উপদেষ্টা বহিষ্কার</title>
      <link>https://www.itvbd.com/world/europe/278332/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%87%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%A4%E0%A7%87-%E0%A6%B2%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A6%A8%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A7%82%E0%A6%A4%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.itvbd.com/world/europe/278332/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%87%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%A4%E0%A7%87-%E0%A6%B2%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A6%A8%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A7%82%E0%A6%A4%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Fri, 20 Nov 2026 07:15:11 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/108ffaa2766af3b2bbf099c3c964bbf1-6aff9ca6da991.jpg?jadewits_media_id=168035" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/108ffaa2766af3b2bbf099c3c964bbf1-6aff9ca6da991.jpg?jadewits_media_id=168035" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/108ffaa2766af3b2bbf099c3c964bbf1-6aff9ca6da991.jpg?jadewits_media_id=168035" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রোহিঙ্গা ইস্যুতে লন্ডনে মিয়ানমার দূতাবাসের প্রতিরক্ষা উপদেষ্টা বহিষ্কার" /&gt;&lt;/p&gt;&lt;p&gt;রোহিঙ্গা গণহত্যার দায়ে মিয়ানমারকে অভিযুক্ত করে জাতিসংঘের আন্তর্জাতিক বিচার আদালত–আইসিজের রায়ের পরপরই দেশটির বিরুদ্ধে নতুন পদক্ষেপ নিয়েছে যুক্তরাজ্য। লন্ডনে মিয়ানমার দূতাবাসের প্রতিরক্ষা উপদেষ্টাকে বহিষ্কার এবং ভারপ্রাপ্ত রাষ্ট্রদূতকে তলব করেছে ব্রিটিশ সরকার। 						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/world/europe/278332/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%87%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%A4%E0%A7%87-%E0%A6%B2%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A6%A8%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A7%82%E0%A6%A4%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87%E0%A6%B0">ইনডিপেনডেন্ট টিভি</source>
    </item>
    <item>
      <title>৬০ দেশের ১০৪ সিনেমা নিয়ে শুরু হলো দোহা ফিল্ম ফেস্ট</title>
      <link>https://www.itvbd.com/entertainment/dakshini-and-others/278331/%E0%A7%AC%E0%A7%A6-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A7%A7%E0%A7%A6%E0%A7%AA-%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%AE%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81-%E0%A6%B9%E0%A6%B2%E0%A7%8B-%E0%A6%A6%E0%A7%8B%E0%A6%B9%E0%A6%BE-%E0%A6%AB%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%AE-%E0%A6%AB%E0%A7%87%E0%A6%B8%E0%A7%8D%E0%A6%9F</link>
      <guid isPermaLink="true">https://www.itvbd.com/entertainment/dakshini-and-others/278331/%E0%A7%AC%E0%A7%A6-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A7%A7%E0%A7%A6%E0%A7%AA-%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%AE%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81-%E0%A6%B9%E0%A6%B2%E0%A7%8B-%E0%A6%A6%E0%A7%8B%E0%A6%B9%E0%A6%BE-%E0%A6%AB%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%AE-%E0%A6%AB%E0%A7%87%E0%A6%B8%E0%A7%8D%E0%A6%9F</guid>
      <pubDate>Fri, 20 Nov 2026 03:22:58 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/d3e969940d8da03f36cd0ea583745102-6aff684270d27.jpeg?jadewits_media_id=168034" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/d3e969940d8da03f36cd0ea583745102-6aff684270d27.jpeg?jadewits_media_id=168034" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/d3e969940d8da03f36cd0ea583745102-6aff684270d27.jpeg?jadewits_media_id=168034" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৬০ দেশের ১০৪ সিনেমা নিয়ে শুরু হলো দোহা ফিল্ম ফেস্ট" /&gt;&lt;/p&gt;&lt;p&gt;বিশ্বের বিভিন্ন প্রান্তের নির্মাতা, অভিনয়শিল্পী ও চলচ্চিত্রপ্রেমীদের মিলনমেলায় পরিণত হচ্ছে কাতারের রাজধানী দোহা। বৃহস্পতিবার (১৯ নভেম্বর) শুরু হয়েছে দোহা চলচ্চিত্র উৎসবের ২০২৬ সালের আসর। দোহা ফিল্ম ইনস্টিটিউট আয়োজিত নয় দিনব্যাপী এই উৎসব চলবে ২৭ নভেম্বর পর্যন্ত।
 
এবারের উৎসবে প্রদর্শিত হবে ৬০টি দেশে&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/entertainment/dakshini-and-others/278331/%E0%A7%AC%E0%A7%A6-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A7%A7%E0%A7%A6%E0%A7%AA-%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%AE%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81-%E0%A6%B9%E0%A6%B2%E0%A7%8B-%E0%A6%A6%E0%A7%8B%E0%A6%B9%E0%A6%BE-%E0%A6%AB%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%AE-%E0%A6%AB%E0%A7%87%E0%A6%B8%E0%A7%8D%E0%A6%9F">ইনডিপেনডেন্ট টিভি</source>
    </item>
    <item>
      <title>রামদা-কুড়াল হাতে হাসপাতালে আগুন দিল আওয়ামী লীগ, আন্তর্জাতিক আইনে যুদ্ধাপরাধের প্রশ্ন</title>
      <link>https://www.itvbd.com/politics/278330/%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%A6%E0%A6%BE-%E0%A6%95%E0%A7%81%E0%A7%9C%E0%A6%BE%E0%A6%B2-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%A6%E0%A6%BF%E0%A6%B2-%E0%A6%86%E0%A6%93%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97</link>
      <guid isPermaLink="true">https://www.itvbd.com/politics/278330/%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%A6%E0%A6%BE-%E0%A6%95%E0%A7%81%E0%A7%9C%E0%A6%BE%E0%A6%B2-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%A6%E0%A6%BF%E0%A6%B2-%E0%A6%86%E0%A6%93%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97</guid>
      <pubDate>Thu, 19 Nov 2026 23:58:37 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/6c611a36826603d449177189b5c917b7-6aff381c03737.jpg?jadewits_media_id=168031" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/6c611a36826603d449177189b5c917b7-6aff381c03737.jpg?jadewits_media_id=168031" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/6c611a36826603d449177189b5c917b7-6aff381c03737.jpg?jadewits_media_id=168031" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রামদা-কুড়াল হাতে হাসপাতালে আগুন দিল আওয়ামী লীগ, আন্তর্জাতিক আইনে যুদ্ধাপরাধের প্রশ্ন" /&gt;&lt;/p&gt;&lt;p&gt;গোপালগঞ্জে আওয়ামী লীগের তাণ্ডবের মধ্যে রামদা ও কুড়াল হাতে মহড়া এবং হাসপাতালে আগুন দেওয়ার ঘটনা আন্তর্জাতিক মানবিক আইনের আলোকে গুরুতর প্রশ্নের জন্ম দিয়েছে। আন্তর্জাতিক আইন অনুযায়ী, সশস্ত্র সংঘাতের সময় হাসপাতাল ও চিকিৎসাসেবা প্রতিষ্ঠানের ওপর ইচ্ছাকৃত হামলা যুদ্ধাপরাধ হিসেবে গণ্য হতে পারে।						বিস্তারি&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/politics/278330/%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%A6%E0%A6%BE-%E0%A6%95%E0%A7%81%E0%A7%9C%E0%A6%BE%E0%A6%B2-%E0%A6%B9%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8-%E0%A6%A6%E0%A6%BF%E0%A6%B2-%E0%A6%86%E0%A6%93%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B2%E0%A7%80%E0%A6%97">ইনডিপেনডেন্ট টিভি</source>

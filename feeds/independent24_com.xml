      <guid isPermaLink="true">https://www.itvbd.com/entertainment/music/278061/%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%86%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BF%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%9C%E0%A6%B2-%E0%A6%86%E0%A6%B0%E0%A6%BF%E0%A6%AB%E0%A7%87%E0%A6%B0-%E2%80%98%E0%A6%95%E0%A7%87%E0%A6%AE%E0%A6%A8-%E0%A6%AD%E0%A6%BE%E0%A6%B2%E0%A7%8B%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8B-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A7%81%E2%80%99</guid>
      <pubDate>Sat, 14 Nov 2026 14:24:10 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/2f026d480f58895bdd21d0cd90aa5631-6af81a90af22c.jpg?jadewits_media_id=167869" length="0" type="image/jpeg" />

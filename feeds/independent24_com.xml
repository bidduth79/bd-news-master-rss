    <item>
      <title>গাজায় বালির স্তূপ ধসে নিহত অন্তত ৫</title>
      <link>https://www.itvbd.com/world/middle-east/277815/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%82%E0%A6%AA-%E0%A6%A7%E0%A6%B8%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A6%85%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%A4-%E0%A7%AB</link>
      <guid isPermaLink="true">https://www.itvbd.com/world/middle-east/277815/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%82%E0%A6%AA-%E0%A6%A7%E0%A6%B8%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A6%85%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%A4-%E0%A7%AB</guid>
      <pubDate>Mon, 09 Nov 2026 21:48:29 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/0310cfce941c0868cb17889127d49fab-6af1eb49549e3.jpg?jadewits_media_id=167700" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/0310cfce941c0868cb17889127d49fab-6af1eb49549e3.jpg?jadewits_media_id=167700" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/0310cfce941c0868cb17889127d49fab-6af1eb49549e3.jpg?jadewits_media_id=167700" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গাজায় বালির স্তূপ ধসে নিহত অন্তত ৫" /&gt;&lt;/p&gt;&lt;p&gt;ফিলিস্তিনি সিভিল ডিফেন্স জানায়, দেইর আল-বালাহ এলাকায় বাস্তুচ্যুত ফিলিস্তিনিদের তাঁবুর ওপর ধস নামলে এই হতাহতের ঘটনা হয়। 
এদিকে, ভারী বৃষ্টিতে সৃষ্ট বন্যায় লাখো বাস্তুচ্যুত ফিলিস্তিনির অস্থায়ী বাসস্থান ও তাঁবু ক্ষতিগ্রস্ত হয়েছে। 						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/world/middle-east/277815/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A7%9F-%E0%A6%AC%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%82%E0%A6%AA-%E0%A6%A7%E0%A6%B8%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A6%85%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%A4-%E0%A7%AB">ইনডিপেনডেন্ট টিভি</source>
    </item>

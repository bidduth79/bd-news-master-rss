    <item>
      <title>৬৬ বছর আগের ভবিষ্যদ্বাণী নিয়ে আতঙ্ক!</title>
      <link>https://www.itvbd.com/analysis/277804/%E0%A7%AC%E0%A7%AC-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%AD%E0%A6%AC%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%AF%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%A3%E0%A7%80-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%86%E0%A6%A4%E0%A6%99%E0%A7%8D%E0%A6%95</link>
      <guid isPermaLink="true">https://www.itvbd.com/analysis/277804/%E0%A7%AC%E0%A7%AC-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%AD%E0%A6%AC%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%AF%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%A3%E0%A7%80-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%86%E0%A6%A4%E0%A6%99%E0%A7%8D%E0%A6%95</guid>
      <pubDate>Mon, 09 Nov 2026 19:59:58 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/1ba8b42ec735208dee51a025a1afbc66-6af1d1c774245.jpg?jadewits_media_id=167691" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/1ba8b42ec735208dee51a025a1afbc66-6af1d1c774245.jpg?jadewits_media_id=167691" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/1ba8b42ec735208dee51a025a1afbc66-6af1d1c774245.jpg?jadewits_media_id=167691" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৬৬ বছর আগের ভবিষ্যদ্বাণী নিয়ে আতঙ্ক!" /&gt;&lt;/p&gt;&lt;p&gt;১৩ নভেম্বর কি সত্যিই শেষ হয়ে যাবে পৃথিবী? ৬৬ বছর আগে একদল বিজ্ঞানী হিসাব করে জানিয়েছিলেন, ২০২৬ সালের এই দিনে পৃথিবীর জনসংখ্যা পৌঁছে যাবে অসীমে! নিজেদের চাপেই ধ্বংস হবে মানবজাতি! এবার পুরোনো এই ভবিষ্যদ্বাণীর সঙ্গে যুক্ত হয়েছে আরও কিছু দাবি। কোথাও বলা হচ্ছে, ওই দিন ঘটতে পারে ভয়াবহ সৌরঝড়। কোথাও আবার পৃ&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/analysis/277804/%E0%A7%AC%E0%A7%AC-%E0%A6%AC%E0%A6%9B%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%87%E0%A6%B0-%E0%A6%AD%E0%A6%AC%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%AF%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%A3%E0%A7%80-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%86%E0%A6%A4%E0%A6%99%E0%A7%8D%E0%A6%95">ইনডিপেনডেন্ট টিভি</source>

    </item>
    <item>
      <title>চাঁদপুর-শরীয়তপুর রুটে ৬ ঘণ্টা পর ফেরি চলাচল শুরু ​</title>
      <link>https://www.itvbd.com/country/chittagong/278055/%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%AA%E0%A7%81%E0%A6%B0-%E0%A6%B6%E0%A6%B0%E0%A7%80%E0%A7%9F%E0%A6%A4%E0%A6%AA%E0%A7%81%E0%A6%B0-%E0%A6%B0%E0%A7%81%E0%A6%9F%E0%A7%87-%E0%A7%AC-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%AA%E0%A6%B0-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BF-%E0%A6%9A%E0%A6%B2%E0%A6%BE%E0%A6%9A%E0%A6%B2-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81-%E2%80%8B</link>
      <guid isPermaLink="true">https://www.itvbd.com/country/chittagong/278055/%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%AA%E0%A7%81%E0%A6%B0-%E0%A6%B6%E0%A6%B0%E0%A7%80%E0%A7%9F%E0%A6%A4%E0%A6%AA%E0%A7%81%E0%A6%B0-%E0%A6%B0%E0%A7%81%E0%A6%9F%E0%A7%87-%E0%A7%AC-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%AA%E0%A6%B0-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BF-%E0%A6%9A%E0%A6%B2%E0%A6%BE%E0%A6%9A%E0%A6%B2-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81-%E2%80%8B</guid>
      <pubDate>Sat, 14 Nov 2026 12:53:35 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/b214f80f7b9e06340b7eb477bdc4f4d8-6af8056c6cbd8.jpeg?jadewits_media_id=167861" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/b214f80f7b9e06340b7eb477bdc4f4d8-6af8056c6cbd8.jpeg?jadewits_media_id=167861" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/b214f80f7b9e06340b7eb477bdc4f4d8-6af8056c6cbd8.jpeg?jadewits_media_id=167861" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চাঁদপুর-শরীয়তপুর রুটে ৬ ঘণ্টা পর ফেরি চলাচল শুরু ​" /&gt;&lt;/p&gt;&lt;p&gt;মেঘনায় ফেরি মাস্টারকে গ্রেপ্তারের প্রতিবাদে বন্ধ থাকার দীর্ঘ ৬ ঘণ্টা পর চাঁদপুর-শরীয়তপুর নৌরুটে ফেরি চলাচল স্বাভাবিক হয়েছে। ​ফেরি মাস্টারকে গ্রেপ্তারের প্রতিবাদে ও তাঁর মুক্তির দাবিতে শনিবার সকাল থেকে বিআইডব্লিউটিসির কর্মীরা কর্মবিরতি ও বিক্ষোভ শুরু করেন। এর ফলে নৌরুটে ফেরি চলাচল সম্পূর্ণ বন্ধ থাকে।&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/country/chittagong/278055/%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%AA%E0%A7%81%E0%A6%B0-%E0%A6%B6%E0%A6%B0%E0%A7%80%E0%A7%9F%E0%A6%A4%E0%A6%AA%E0%A7%81%E0%A6%B0-%E0%A6%B0%E0%A7%81%E0%A6%9F%E0%A7%87-%E0%A7%AC-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%AA%E0%A6%B0-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BF-%E0%A6%9A%E0%A6%B2%E0%A6%BE%E0%A6%9A%E0%A6%B2-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81-%E2%80%8B">ইনডিপেনডেন্ট টিভি</source>
    </item>

      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/265193c7c197bafb5ab839a76e3316b0-6b02bf9ab63d9.jpg?jadewits_media_id=168100" length="0" type="image/jpeg" />

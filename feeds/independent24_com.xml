    </item>
    <item>
      <title>গাইবান্ধায় কুলখানির খাবার খেয়ে অসুস্থ দুই শতাধিক</title>
      <link>https://www.itvbd.com/country/rangpur/278034/%E0%A6%97%E0%A6%BE%E0%A6%87%E0%A6%AC%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A7%81%E0%A6%B2%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%B0-%E0%A6%96%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%96%E0%A7%87%E0%A7%9F%E0%A7%87-%E0%A6%85%E0%A6%B8%E0%A7%81%E0%A6%B8%E0%A7%8D%E0%A6%A5-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%B6%E0%A6%A4%E0%A6%BE%E0%A6%A7%E0%A6%BF%E0%A6%95</link>
      <guid isPermaLink="true">https://www.itvbd.com/country/rangpur/278034/%E0%A6%97%E0%A6%BE%E0%A6%87%E0%A6%AC%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A7%81%E0%A6%B2%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%B0-%E0%A6%96%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%96%E0%A7%87%E0%A7%9F%E0%A7%87-%E0%A6%85%E0%A6%B8%E0%A7%81%E0%A6%B8%E0%A7%8D%E0%A6%A5-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%B6%E0%A6%A4%E0%A6%BE%E0%A6%A7%E0%A6%BF%E0%A6%95</guid>
      <pubDate>Fri, 13 Nov 2026 20:53:25 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/83c676b6215db0e6e1348b87436c82f6-6af723cc0e5ec.jpg?jadewits_media_id=167846" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/83c676b6215db0e6e1348b87436c82f6-6af723cc0e5ec.jpg?jadewits_media_id=167846" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/13/83c676b6215db0e6e1348b87436c82f6-6af723cc0e5ec.jpg?jadewits_media_id=167846" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গাইবান্ধায় কুলখানির খাবার খেয়ে অসুস্থ দুই শতাধিক" /&gt;&lt;/p&gt;&lt;p&gt;গাইবান্ধার সাঘাটা উপজেলার বোনারপাড়া ইউনিয়নের কালপানি নয়াপাড়া গ্রামে কুলখানির খাবার খেয়ে দুই শতাধিক মানুষ অসুস্থ হয়ে পড়েছেন। তাদের মধ্যে ১১৫ জন সাঘাটা উপজেলা স্বাস্থ্য কমপ্লেক্সে ভর্তি হয়ে চিকিৎসা নিয়েছেন। অন্যরা গাইবান্ধা জেনারেল হাসপাতালসহ বিভিন্ন স্থানে চিকিৎসা নিচ্ছেন।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/country/rangpur/278034/%E0%A6%97%E0%A6%BE%E0%A6%87%E0%A6%AC%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A7%81%E0%A6%B2%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%B0-%E0%A6%96%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%96%E0%A7%87%E0%A7%9F%E0%A7%87-%E0%A6%85%E0%A6%B8%E0%A7%81%E0%A6%B8%E0%A7%8D%E0%A6%A5-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%B6%E0%A6%A4%E0%A6%BE%E0%A6%A7%E0%A6%BF%E0%A6%95">ইনডিপেনডেন্ট টিভি</source>
    </item>
    <item>
      <title>বাংলাদেশের সঙ্গে ইতিবাচক সম্পর্ক চায় নয়াদিল্লি: রণধীর জয়সওয়াল</title>

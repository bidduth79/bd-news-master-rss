    <item>
      <title>বেনজীরকে ফেরাতে সরকারের কী পদক্ষেপ, জানালেন স্বরাষ্ট্রমন্ত্রী</title>
      <link>https://www.itvbd.com/national/277870/%E0%A6%AC%E0%A7%87%E0%A6%A8%E0%A6%9C%E0%A7%80%E0%A6%B0%E0%A6%95%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A7%80-%E0%A6%AA%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.itvbd.com/national/277870/%E0%A6%AC%E0%A7%87%E0%A6%A8%E0%A6%9C%E0%A7%80%E0%A6%B0%E0%A6%95%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A7%80-%E0%A6%AA%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Tue, 10 Nov 2026 22:13:18 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/06/20/6135f1d63733a7d2e53d44a28ecc2105-6a364ca19d801.jpg?jadewits_media_id=162805" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/06/20/6135f1d63733a7d2e53d44a28ecc2105-6a364ca19d801.jpg?jadewits_media_id=162805" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/06/20/6135f1d63733a7d2e53d44a28ecc2105-6a364ca19d801.jpg?jadewits_media_id=162805" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বেনজীরকে ফেরাতে সরকারের কী পদক্ষেপ, জানালেন স্বরাষ্ট্রমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;সাবেক পুলিশ মহাপরিদর্শক (আইজিপি) বেনজীর আহমেদকে বাংলাদেশে ফিরিয়ে এনে বিচারের মুখোমুখি করতে সব ধরনের আইনগত, কূটনৈতিক ও আন্তর্জাতিক পুলিশি পদক্ষেপ অব্যাহত রেখেছে সরকার। স্বরাষ্ট্রমন্ত্রী সালাহউদ্দিন আহমদ আজ মঙ্গলবার জাতীয় সংসদে এ বিষয়টি অবহিত করেন।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/national/277870/%E0%A6%AC%E0%A7%87%E0%A6%A8%E0%A6%9C%E0%A7%80%E0%A6%B0%E0%A6%95%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A7%80-%E0%A6%AA%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A8">ইনডিপেনডেন্ট টিভি</source>

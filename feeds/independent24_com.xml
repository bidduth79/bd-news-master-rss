      <guid isPermaLink="true">https://www.itvbd.com/country/dhaka/277753/%E0%A6%AD%E0%A6%BF%E0%A6%B8%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%A5%E0%A6%BF-%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A6%BE%E0%A6%87%E0%A7%9F%E0%A7%87-%E0%A6%A1%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%9F%E0%A6%BE%E0%A6%B2-%E0%A6%B8%E0%A6%BF%E0%A6%B2-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B9%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%AC</guid>
      <pubDate>Sun, 08 Nov 2026 20:39:51 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/d470ad98155fc1f04f32f43d363cdea1-6af089a457f7f.jpg?jadewits_media_id=167659" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/d470ad98155fc1f04f32f43d363cdea1-6af089a457f7f.jpg?jadewits_media_id=167659" medium="image" />

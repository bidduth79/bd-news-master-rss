    <item>
      <title>অভিনেতা সোহেল খান মারা গেছেন</title>
      <link>https://www.itvbd.com/entertainment/television-stage/278567/%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%B8%E0%A7%8B%E0%A6%B9%E0%A7%87%E0%A6%B2-%E0%A6%96%E0%A6%BE%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%97%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.itvbd.com/entertainment/television-stage/278567/%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%B8%E0%A7%8B%E0%A6%B9%E0%A7%87%E0%A6%B2-%E0%A6%96%E0%A6%BE%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%97%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Tue, 24 Nov 2026 11:10:07 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/2c96ffc3c3e9662b4a064e8cac74fb65-6b051bd439541.jpg?jadewits_media_id=168158" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/2c96ffc3c3e9662b4a064e8cac74fb65-6b051bd439541.jpg?jadewits_media_id=168158" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/2c96ffc3c3e9662b4a064e8cac74fb65-6b051bd439541.jpg?jadewits_media_id=168158" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অভিনেতা সোহেল খান মারা গেছেন" /&gt;&lt;/p&gt;&lt;p&gt;শুটিংয়ের কাজে বগুড়ায় গিয়েছিলেন ছোট ও বড় পর্দার জনপ্রিয় অভিনেতা সোহেল খান। সেখান থেকে আর ফেরা হলো না তাঁর। অসুস্থ হয়ে হাসপাতালে চিকিৎসাধীন অবস্থায় মারা গেছেন এই অভিনেতা।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/entertainment/television-stage/278567/%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%A4%E0%A6%BE-%E0%A6%B8%E0%A7%8B%E0%A6%B9%E0%A7%87%E0%A6%B2-%E0%A6%96%E0%A6%BE%E0%A6%A8-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%97%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8">ইনডিপেনডেন্ট টিভি</source>
    </item>
    <item>
      <title>হাসিনার ১৬ ডিসেম্বর ফেরার ইচ্ছা আর বাস্তবতা এক নয়: পররাষ্ট্র প্রতিমন্ত্রী</title>
      <link>https://www.itvbd.com/national/278566/%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A7%A7%E0%A7%AC-%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%87%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A6%BE-%E0%A6%86%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%AC%E0%A6%A4%E0%A6%BE-%E0%A6%8F%E0%A6%95-%E0%A6%A8%E0%A7%9F</link>
      <guid isPermaLink="true">https://www.itvbd.com/national/278566/%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A7%A7%E0%A7%AC-%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%87%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A6%BE-%E0%A6%86%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%AC%E0%A6%A4%E0%A6%BE-%E0%A6%8F%E0%A6%95-%E0%A6%A8%E0%A7%9F</guid>
      <pubDate>Tue, 24 Nov 2026 10:58:43 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/08/24/b376f8ed2e996bee1f2feb518877ea00-6a8bdcb87207b.jpg?jadewits_media_id=165421" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/08/24/b376f8ed2e996bee1f2feb518877ea00-6a8bdcb87207b.jpg?jadewits_media_id=165421" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/08/24/b376f8ed2e996bee1f2feb518877ea00-6a8bdcb87207b.jpg?jadewits_media_id=165421" style="max-width:100%;height:auto;margin-bottom:10px;" alt="হাসিনার ১৬ ডিসেম্বর ফেরার ইচ্ছা আর বাস্তবতা এক নয়: পররাষ্ট্র প্রতিমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;ছাত্র–জনতার অভ্যুত্থানে ক্ষমতাচ্যুত হয়ে ভারতে চলে যাওয়া শেখ হাসিনার ১৬ ডিসেম্বর দেশে ফেরার ইচ্ছা আর বাস্তবতা এক নয় বলে মন্তব্য করেছেন পররাষ্ট্র প্রতিমন্ত্রী হুমায়ুন কবির। শেখ হাসিনাসহ সন্ত্রাসীদের প্রত্যর্পণ চুক্তি বাদে অন্যভাবে দেশে ফেরার সুযোগ নেই বলেও উল্লেখ করেন তিনি।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/national/278566/%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A7%A7%E0%A7%AC-%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%AB%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%87%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A6%BE-%E0%A6%86%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%AC%E0%A6%A4%E0%A6%BE-%E0%A6%8F%E0%A6%95-%E0%A6%A8%E0%A7%9F">ইনডিপেনডেন্ট টিভি</source>

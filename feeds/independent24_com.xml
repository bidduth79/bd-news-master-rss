    <item>
      <title>আমি তাহলে ঘোমটা পরেই থাকি: পরী মণি</title>
      <link>https://www.itvbd.com/entertainment/277763/%E0%A6%86%E0%A6%AE%E0%A6%BF-%E0%A6%A4%E0%A6%BE%E0%A6%B9%E0%A6%B2%E0%A7%87-%E0%A6%98%E0%A7%8B%E0%A6%AE%E0%A6%9F%E0%A6%BE-%E0%A6%AA%E0%A6%B0%E0%A7%87%E0%A6%87-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%BF-%E0%A6%AA%E0%A6%B0%E0%A7%80-%E0%A6%AE%E0%A6%A3%E0%A6%BF</link>

      <title>প্রাণিসম্পদ খাতকে রপ্তানিমুখী শিল্পে রূপ দিতে চায় সরকার: প্রধানমন্ত্রী</title>
      <link>https://www.itvbd.com/national/278654/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3%E0%A6%BF%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%A6-%E0%A6%96%E0%A6%BE%E0%A6%A4%E0%A6%95%E0%A7%87-%E0%A6%B0%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%80-%E0%A6%B6%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A7%87-%E0%A6%B0%E0%A7%82%E0%A6%AA-%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A7%9F</link>
      <guid isPermaLink="true">https://www.itvbd.com/national/278654/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3%E0%A6%BF%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%A6-%E0%A6%96%E0%A6%BE%E0%A6%A4%E0%A6%95%E0%A7%87-%E0%A6%B0%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%80-%E0%A6%B6%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A7%87-%E0%A6%B0%E0%A7%82%E0%A6%AA-%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A7%9F</guid>
      <pubDate>Wed, 25 Nov 2026 17:25:03 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/6bcb97a5489946193c10afc6886a2f4b-6af01b909ebff.jpg?jadewits_media_id=167643" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/6bcb97a5489946193c10afc6886a2f4b-6af01b909ebff.jpg?jadewits_media_id=167643" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/6bcb97a5489946193c10afc6886a2f4b-6af01b909ebff.jpg?jadewits_media_id=167643" style="max-width:100%;height:auto;margin-bottom:10px;" alt="প্রাণিসম্পদ খাতকে রপ্তানিমুখী শিল্পে রূপ দিতে চায় সরকার: প্রধানমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;প্রাণিসম্পদ খাতকে আধুনিক, বিজ্ঞানভিত্তিক ও রপ্তানিমুখী শিল্পে রূপ দেওয়ার ওপর গুরুত্বারোপ করেছেন প্রধানমন্ত্রী তারেক রহমান। বৃহস্পতিবার ‘জাতীয় প্রাণিসম্পদ সপ্তাহ ২০২৬’ উপলক্ষে আজ দেওয়া এক বাণীতে তিনি বলেন, আন্তর্জাতিক বাজারে বাংলাদেশের হালাল মাংস, দুগ্ধজাত পণ্য, পোলট্রি পণ্য এবং চামড়াজাত পণ্য রপ্তানি&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/national/278654/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3%E0%A6%BF%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%A6-%E0%A6%96%E0%A6%BE%E0%A6%A4%E0%A6%95%E0%A7%87-%E0%A6%B0%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A8%E0%A6%BF%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%80-%E0%A6%B6%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A7%87-%E0%A6%B0%E0%A7%82%E0%A6%AA-%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A7%9F">ইনডিপেনডেন্ট টিভি</source>

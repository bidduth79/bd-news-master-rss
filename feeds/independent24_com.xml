      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/354ee33e98fd7725c3adba541b612b8c-6af045212e3ca.jpg?jadewits_media_id=167654" medium="image" />

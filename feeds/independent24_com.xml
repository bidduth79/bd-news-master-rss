      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/bc03d188ea6ea0b0b17fe9339c1c6484-6af5ef72675f5.jpeg?jadewits_media_id=167826" length="0" type="image/jpeg" />

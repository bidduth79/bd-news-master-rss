      <guid isPermaLink="true">https://www.itvbd.com/world/middle-east/277760/%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%B6%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%AE%E0%A6%BE%E0%A6%A3%E0%A6%AC%E0%A6%BF%E0%A6%95-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%AA%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%B8%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%95</guid>
      <pubDate>Mon, 09 Nov 2026 08:36:01 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/a064c5630223c262ab4d6d90021575db-6af13184e09f1.jpg?jadewits_media_id=167665" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/a064c5630223c262ab4d6d90021575db-6af13184e09f1.jpg?jadewits_media_id=167665" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/a064c5630223c262ab4d6d90021575db-6af13184e09f1.jpg?jadewits_media_id=167665" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মার্কিন হামলার শঙ্কায় পারমাণবিক স্থাপনায় সতর্ক ইরান" /&gt;&lt;/p&gt;&lt;p&gt;ইরানের পারমাণবিক কেন্দ্রে মার্কিন হামলার আশঙ্কা উড়িয়ে দিচ্ছে না তেহরান। এতে তেজস্ক্রিয়তা ছড়িয়ে পড়লে স্বাস্থ্যঝুঁকি হতে পারে। তাই আগাম সতর্কতা নিচ্ছে ইরান। কারণ এরই মধ্যে যুক্তরাষ্ট্র ঘোষণা দিয়েছে, ইরানের পরমাণু কর্মসূচির তথ্য দিলে ২ কোটি ডলার পুরস্কার দেয়া হবে। তথ্যদাতাকে আশ্রয়ও দেবে ওয়াশিংটন।  				&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/world/middle-east/277760/%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%B6%E0%A6%99%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A6%AE%E0%A6%BE%E0%A6%A3%E0%A6%AC%E0%A6%BF%E0%A6%95-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%AA%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%B8%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%95">ইনডিপেনডেন্ট টিভি</source>

    <item>
      <title>অতিরিক্ত ডিআইজি প্রলয়সহ পুলিশের ৬ কর্মকর্তা বরখাস্ত</title>
      <link>https://www.itvbd.com/national/277988/%E0%A6%85%E0%A6%A4%E0%A6%BF%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%A1%E0%A6%BF%E0%A6%86%E0%A6%87%E0%A6%9C%E0%A6%BF-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%9F%E0%A6%B8%E0%A6%B9-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A7%AC-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.itvbd.com/national/277988/%E0%A6%85%E0%A6%A4%E0%A6%BF%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%A4-%E0%A6%A1%E0%A6%BF%E0%A6%86%E0%A6%87%E0%A6%9C%E0%A6%BF-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%B2%E0%A7%9F%E0%A6%B8%E0%A6%B9-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A7%AC-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE</guid>
      <pubDate>Thu, 12 Nov 2026 22:34:26 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2023/12/13/5371ba11acbb013616b2780b55989f9f-65797ef36f31a.jpg?jadewits_media_id=25927" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2023/12/13/5371ba11acbb013616b2780b55989f9f-65797ef36f31a.jpg?jadewits_media_id=25927" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2023/12/13/5371ba11acbb013616b2780b55989f9f-65797ef36f31a.jpg?jadewits_media_id=25927" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অতিরিক্ত ডিআইজি প্রলয়সহ পুলিশের ৬ কর্মকর্তা বরখাস্ত" /&gt;&lt;/p&gt;&lt;p&gt;অতিরিক্ত ডিআইজি প্রলয় কুমার জোয়ারদারসহ ৬ জন পুলিশ কর্মকর্তাকে বরখাস্ত করা হয়েছে। ১ জনকে পাঠানো হয়েছে বাধ্যতামূলক অবসরে। বৃহস্পতিবার স্বরাষ্ট্র মন্ত্রণালয়ের আলাদা প্রজ্ঞাপনে এসব তথ্য জানা যায়। 						বিস্তারিত&lt;/p&gt;</description>

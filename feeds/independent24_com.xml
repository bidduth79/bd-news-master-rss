      <guid isPermaLink="true">https://www.itvbd.com/world/europe/277866/%E0%A6%AC%E0%A7%81%E0%A6%B2%E0%A6%97%E0%A7%87%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%98%E0%A6%A8-%E0%A6%95%E0%A7%81%E0%A7%9F%E0%A6%BE%E0%A6%B6%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%B8%E0%A7%9C%E0%A6%95-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4</guid>
      <pubDate>Tue, 10 Nov 2026 20:56:52 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/dc11f7264874baa52e51635959f9f98f-6af3302e45bbb.jpg?jadewits_media_id=167730" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/dc11f7264874baa52e51635959f9f98f-6af3302e45bbb.jpg?jadewits_media_id=167730" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/dc11f7264874baa52e51635959f9f98f-6af3302e45bbb.jpg?jadewits_media_id=167730" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বুলগেরিয়ায় ঘন কুয়াশার কারণে সড়ক দুর্ঘটনায় নিহত অন্তত ১২" /&gt;&lt;/p&gt;&lt;p&gt;বুলগেরিয়ার পূর্বাঞ্চলে ঘন কুয়াশার কারণে সড়ক দুর্ঘটনায় অন্তত ১২ জন নিহত হয়েছে। আহত হয়েছে অর্ধশত মানুষ। তাদের উদ্ধার করে বিভিন্ন হাসপাতালে নেওয়া হয়েছে। খবর রয়টার্সের।

মঙ্গলবার দেশটির এ-ওয়ান মহাসড়কে ৫০টির বেশি গাড়ি ও ট্রাকের মধ্যে সংঘর্ষ ঘটে। 						বিস্তারিত&lt;/p&gt;</description>

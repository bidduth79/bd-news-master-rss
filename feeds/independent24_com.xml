      <pubDate>Mon, 09 Nov 2026 09:32:34 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/e15da82af6dc7d52b71388e6a8b91e0b-6af13ead39216.jpg?jadewits_media_id=167668" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/e15da82af6dc7d52b71388e6a8b91e0b-6af13ead39216.jpg?jadewits_media_id=167668" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/e15da82af6dc7d52b71388e6a8b91e0b-6af13ead39216.jpg?jadewits_media_id=167668" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আমি তাহলে ঘোমটা পরেই থাকি: পরী মণি" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর গুলশানে একটি অনুষ্ঠানে হেনস্তার শিকার হওয়ার অভিযোগ তুলেছেন চিত্রনায়িকা পরী মণি। রোববার রাতে গুলশানের শুটিং ক্লাবে ওই ঘটনার পর ফেসবুক লাইভে ক্ষোভ প্রকাশ করেছেন তিনি।						বিস্তারিত&lt;/p&gt;</description>

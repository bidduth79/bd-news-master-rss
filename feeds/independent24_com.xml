      <guid isPermaLink="true">https://www.itvbd.com/health/278161/%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B8%E0%A6%BF%E0%A6%82-%E0%A6%93-%E0%A6%AE%E0%A6%BF%E0%A6%A1%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%87%E0%A6%AB%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%AA%E0%A7%87%E0%A6%B6%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A7%88%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%95-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Mon, 16 Nov 2026 23:53:03 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/a6ef6638f27a47e4c6664a647a769b26-6afb2e12369c7.jpg?jadewits_media_id=167925" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/a6ef6638f27a47e4c6664a647a769b26-6afb2e12369c7.jpg?jadewits_media_id=167925" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/a6ef6638f27a47e4c6664a647a769b26-6afb2e12369c7.jpg?jadewits_media_id=167925" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নার্সিং-মিডওয়াইফারিকে বৈশ্বিক কর্মসংস্থানের খাত করতে চায় সরকার: জিয়াউদ্দিন হায়দার" /&gt;&lt;/p&gt;&lt;p&gt;নার্সিং ও মিডওয়াইফারি শিক্ষার মান আন্তর্জাতিক পর্যায়ে উন্নীত করে দক্ষ জনশক্তি গড়ে তুলতে কাজ করছে সরকার। এ পেশাকে বৈশ্বিক কর্মসংস্থানের অন্যতম প্রধান খাতে পরিণত করার লক্ষ্যও রয়েছে বলে জানিয়েছেন প্রধানমন্ত্রীর স্বাস্থ্যবিষয়ক বিশেষ সহকারী ড. এস. এম. জিয়াউদ্দিন হায়দার।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/health/278161/%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B8%E0%A6%BF%E0%A6%82-%E0%A6%93-%E0%A6%AE%E0%A6%BF%E0%A6%A1%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%87%E0%A6%AB%E0%A6%BE%E0%A6%B0%E0%A6%BF-%E0%A6%AA%E0%A7%87%E0%A6%B6%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A7%88%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%95-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0">ইনডিপেনডেন্ট টিভি</source>

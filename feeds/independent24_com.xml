    <item>
      <title>ইরান যুদ্ধ বন্ধে চীন–রাশিয়ার প্রেসিডেন্টের সঙ্গে আলোচনা চান ট্রাম্প</title>
      <link>https://www.itvbd.com/world/america/277816/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%9A%E0%A7%80%E0%A6%A8%E2%80%93%E0%A6%B0%E0%A6%BE%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B8%E0%A6%BF%E0%A6%A1%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87</link>
      <guid isPermaLink="true">https://www.itvbd.com/world/america/277816/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%9A%E0%A7%80%E0%A6%A8%E2%80%93%E0%A6%B0%E0%A6%BE%E0%A6%B6%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B8%E0%A6%BF%E0%A6%A1%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%87</guid>
      <pubDate>Mon, 09 Nov 2026 22:11:39 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/08/17/20c1971d60aa25afacadf181753b3057-6a827389d541e.jpg?jadewits_media_id=165137" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/08/17/20c1971d60aa25afacadf181753b3057-6a827389d541e.jpg?jadewits_media_id=165137" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/08/17/20c1971d60aa25afacadf181753b3057-6a827389d541e.jpg?jadewits_media_id=165137" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ইরান যুদ্ধ বন্ধে চীন–রাশিয়ার প্রেসিডেন্টের সঙ্গে আলোচনা চান ট্রাম্প" /&gt;&lt;/p&gt;&lt;p&gt;ইরানের সঙ্গে যুদ্ধ বন্ধে চীন ও রাশিয়ার প্রেসিডেন্টের সঙ্গে আলোচনায় বসতে চান মার্কিন প্রেসিডেন্ট ডোনাল্ড ট্রাম্প। আগামী সপ্তাহে চীনের শেনজেনে এশিয়া-প্যাসিফিক ইকোনমিক কো-অপারেশন- এপেক সম্মেলনের ফাঁকে বৈঠক হতে পারে বলে জানিয়েছেন তিনি। 						বিস্তারিত&lt;/p&gt;</description>

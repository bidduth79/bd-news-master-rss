      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/b643376d364d47b364f375a1da02d29d-6af1e97aaec0f.JPG?jadewits_media_id=167699" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/b643376d364d47b364f375a1da02d29d-6af1e97aaec0f.JPG?jadewits_media_id=167699" medium="image" />

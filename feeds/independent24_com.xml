      <guid isPermaLink="true">https://www.itvbd.com/country/chittagong/278267/%E0%A6%9A%E0%A6%BE%E0%A6%81%E0%A6%A6%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%85%E0%A6%AC%E0%A7%88%E0%A6%A7-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%87%E0%A6%9F%E0%A6%AD%E0%A6%BE%E0%A6%9F%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A7%AD-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%9C%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%BE</guid>
      <pubDate>Wed, 18 Nov 2026 21:57:04 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/c2df1ae652b23c197f31a6405467914e-6afdcab6256ed.jpg?jadewits_media_id=167990" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/c2df1ae652b23c197f31a6405467914e-6afdcab6256ed.jpg?jadewits_media_id=167990" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/c2df1ae652b23c197f31a6405467914e-6afdcab6256ed.jpg?jadewits_media_id=167990" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চাঁদপুরে অবৈধ দুই ইটভাটায় ৭ লাখ টাকা জরিমানা, বিদ্যুৎ সংযোগ বিচ্ছিন্ন" /&gt;&lt;/p&gt;&lt;p&gt;চাঁদপুরের শাহরাস্তি উপজেলায় অবৈধ ইটভাটার বিরুদ্ধে অভিযান চালিয়ে দুই ইটভাটাকে ৭ লাখ টাকা জরিমানা করা হয়েছে।
বুধবার বিকালে পরিচালিত মোবাইল কোর্টে মেসার্স এ এস এস ব্রিকসের প্রোপ্রাইটর মো. আকতার হোসেন চৌধুরীকে ৪ লাখ টাকা এবং মেসার্স হারুন ব্রিকসের প্রোপ্রাইটর মো. হারুন শেখকে ৩ লাখ টাকা জরিমানা ধার্য &lt;/p&gt;</description>

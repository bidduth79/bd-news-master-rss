    <item>
      <title>বিএনপির দু’পক্ষের বিরোধে ককটেল বিস্ফোরণ, ওসির দাবি বাজির শব্দ</title>
      <link>https://www.itvbd.com/country/chittagong/277757/%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A7%81%E2%80%99%E0%A6%AA%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%93%E0%A6%B8%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.itvbd.com/country/chittagong/277757/%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A7%81%E2%80%99%E0%A6%AA%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%93%E0%A6%B8%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF</guid>
      <pubDate>Sun, 08 Nov 2026 22:35:08 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/df86062405ad38f7779228113d89f0bb-6af0a47c45458.jpg?jadewits_media_id=167662" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/df86062405ad38f7779228113d89f0bb-6af0a47c45458.jpg?jadewits_media_id=167662" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/df86062405ad38f7779228113d89f0bb-6af0a47c45458.jpg?jadewits_media_id=167662" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিএনপির দু’পক্ষের বিরোধে ককটেল বিস্ফোরণ, ওসির দাবি বাজির শব্দ" /&gt;&lt;/p&gt;&lt;p&gt;জাতীয় বিপ্লব ও সংহতি দিবসের কর্মসূচিকে কেন্দ্র করে ফেনীর দাগনভূঞায় বিএনপির দুই পক্ষের মধ্যে বিরোধ ও মুহুর্মুহু ককটেল বিস্ফোরণের ঘটনা ঘটেছে। এ সময় শহরের বিভিন্ন ব্যবসাপ্রতিষ্ঠান সাময়িকভাবে বন্ধ হয়ে যায়। ফেনী-নোয়াখালী আঞ্চলিক মহাসড়কে যানবাহন চলাচল বন্ধ হয়ে সৃষ্টি হয় যানজট। তবে দাগনভূঞা থানার ভারপ্রাপ্&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/country/chittagong/277757/%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A7%81%E2%80%99%E0%A6%AA%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%93%E0%A6%B8%E0%A6%BF%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF">ইনডিপেনডেন্ট টিভি</source>

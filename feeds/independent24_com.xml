      <guid isPermaLink="true">https://www.itvbd.com/national/278162/%E0%A6%85%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE-%E0%A6%97%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%93-%E0%A6%AB%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF-%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7-%E0%A6%9C%E0%A6%A8%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF</guid>
      <pubDate>Mon, 16 Nov 2026 22:31:32 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/a7ef65e0a5f7a84caeb2f6345807fd24-6afb2fdb8a100.jpeg?jadewits_media_id=167926" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/a7ef65e0a5f7a84caeb2f6345807fd24-6afb2fdb8a100.jpeg?jadewits_media_id=167926" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/a7ef65e0a5f7a84caeb2f6345807fd24-6afb2fdb8a100.jpeg?jadewits_media_id=167926" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অস্ট্রিয়া, গায়ানা ও ফিজিতে বাংলাদেশি দক্ষ জনশক্তি নিয়োগের আহ্বান রাষ্ট্রপতির" /&gt;&lt;/p&gt;&lt;p&gt;রাষ্ট্রপতি মির্জা ফখরুল ইসলাম আলমগীর বাংলাদেশ থেকে দক্ষ জনশক্তি নিয়োগের জন্যে অস্ট্রিয়া, গায়ানা ও ফিজির প্রতি আহ্বান জানিয়েছেন। একইসঙ্গে তিনি বাণিজ্য ও বিনিয়োগে দ্বিপাক্ষিক সহযোগিতা জোরদারেরও আহ্বান জানান। আজ সোমবার সকালে বাংলাদেশে নবনিযুক্ত অস্ট্রিয়ার অনাবাসিক রাষ্ট্রদূত এবং ফিজি ও গায়ানার অনাবাসিক&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/national/278162/%E0%A6%85%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A6%BE-%E0%A6%97%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%93-%E0%A6%AB%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%BF-%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7-%E0%A6%9C%E0%A6%A8%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF">ইনডিপেনডেন্ট টিভি</source>

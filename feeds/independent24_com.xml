      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/bde398f1e0c3f170f91353326e61d064-6b0518552d98e.jpg?jadewits_media_id=168156" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/bde398f1e0c3f170f91353326e61d064-6b0518552d98e.jpg?jadewits_media_id=168156" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/bde398f1e0c3f170f91353326e61d064-6b0518552d98e.jpg?jadewits_media_id=168156" style="max-width:100%;height:auto;margin-bottom:10px;" alt="তাড়াহুড়ো করতে গিয়েই ভুল করেছে বাংলাদেশের ব্যাটসম্যানরা: সহকারী কোচ" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশের সহকারী কোচের ভাষায়, ‘দক্ষিণ আফ্রিকা আমাদের অনেক চাপ দিচ্ছে, এর ফলেই ভুলগুলো হচ্ছে। এজন্য আমরা প্লেয়ারদের সাথে মানসিক দিক নিয়ে কাজ করছি। ব্যাট হাতে আমরা অনেক তাড়াহুড়া করতে গিয়েছি, সেখানেই ভুলগুলো হয়ে গেছে। আমরা এসব নিয়ে কাজ করে যাচ্ছি, ভুল খুঁজে বের করে যাচ্ছি এবং আশা করছি একটা সমাধান বের &lt;/p&gt;</description>
      <source url="https://www.itvbd.com/sports/cricket/278565/%E0%A6%A4%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%B9%E0%A7%81%E0%A7%9C%E0%A7%8B-%E0%A6%95%E0%A6%B0%E0%A6%A4%E0%A7%87-%E0%A6%97%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%87-%E0%A6%AD%E0%A7%81%E0%A6%B2-%E0%A6%95%E0%A6%B0%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0">ইনডিপেনডেন্ট টিভি</source>
    </item>
    <item>
      <title>ঢাকাসহ বিভিন্ন জেলায় ১০১ প্লাটুন বিজিবি মোতায়েন</title>
      <link>https://www.itvbd.com/national/278564/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B8%E0%A6%B9-%E0%A6%AC%E0%A6%BF%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%A8-%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A7%A7%E0%A7%A6%E0%A7%A7-%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%9F%E0%A7%81%E0%A6%A8-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%AC%E0%A6%BF-%E0%A6%AE%E0%A7%8B%E0%A6%A4%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.itvbd.com/national/278564/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B8%E0%A6%B9-%E0%A6%AC%E0%A6%BF%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%A8-%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A7%A7%E0%A7%A6%E0%A7%A7-%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%9F%E0%A7%81%E0%A6%A8-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%AC%E0%A6%BF-%E0%A6%AE%E0%A7%8B%E0%A6%A4%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Tue, 24 Nov 2026 10:25:06 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/12/18/49c20cedb4cd10202ddd4c205a54ae7f-67625dc63829d.jpg?jadewits_media_id=94851" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/12/18/49c20cedb4cd10202ddd4c205a54ae7f-67625dc63829d.jpg?jadewits_media_id=94851" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/12/18/49c20cedb4cd10202ddd4c205a54ae7f-67625dc63829d.jpg?jadewits_media_id=94851" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঢাকাসহ বিভিন্ন জেলায় ১০১ প্লাটুন বিজিবি মোতায়েন" /&gt;&lt;/p&gt;&lt;p&gt;আইনশৃঙ্খলা পরিস্থিতি নিয়ন্ত্রণ, জননিরাপত্তা নিশ্চিত করা এবং যেকোনো ধরনের অনাকাঙ্ক্ষিত পরিস্থিতি মোকাবিলায় ঢাকাসহ দেশের বিভিন্ন জেলায় ১০১ প্লাটুন বর্ডার গার্ড বাংলাদেশ (বিজিবি) মোতায়েন করা হয়েছে। এর মধ্যে গোপালগঞ্জে মোতায়েন করা হয়েছে দুই ব্যাটালিয়ন বিজিবি। অন্য যেসব জায়গায় বিজিবির সদস্য মোতায়েন করা হ&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/national/278564/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B8%E0%A6%B9-%E0%A6%AC%E0%A6%BF%E0%A6%AD%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%A8-%E0%A6%9C%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A7%A7%E0%A7%A6%E0%A7%A7-%E0%A6%AA%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%9F%E0%A7%81%E0%A6%A8-%E0%A6%AC%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%AC%E0%A6%BF-%E0%A6%AE%E0%A7%8B%E0%A6%A4%E0%A6%BE%E0%A7%9F%E0%A7%87%E0%A6%A8">ইনডিপেনডেন্ট টিভি</source>
    </item>

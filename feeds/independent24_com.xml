    <item>
      <title>মসলার আড়ালে হংকং থেকে আনা শিশা উদ্ধার, গ্রেপ্তার ৩</title>
      <link>https://www.itvbd.com/country/dhaka/278001/%E0%A6%AE%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A7%9C%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%B9%E0%A6%82%E0%A6%95%E0%A6%82-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%86%E0%A6%A8%E0%A6%BE-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A6%BE-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A7%A9</link>
      <guid isPermaLink="true">https://www.itvbd.com/country/dhaka/278001/%E0%A6%AE%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A7%9C%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%B9%E0%A6%82%E0%A6%95%E0%A6%82-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%86%E0%A6%A8%E0%A6%BE-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A6%BE-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A7%A9</guid>
      <pubDate>Fri, 13 Nov 2026 10:39:52 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2023/07/24/-8b948ccedd9107ba80dddc546bb2555d.jpg?jadewits_media_id=1128" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2023/07/24/-8b948ccedd9107ba80dddc546bb2555d.jpg?jadewits_media_id=1128" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2023/07/24/-8b948ccedd9107ba80dddc546bb2555d.jpg?jadewits_media_id=1128" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মসলার আড়ালে হংকং থেকে আনা শিশা উদ্ধার, গ্রেপ্তার ৩" /&gt;&lt;/p&gt;&lt;p&gt;মসলার আড়ালে হংকং থেকে আমদানি করা ৩০ কেজি অবৈধ শিশা (হুক্কায় ব্যবহৃত তামাকজাত পণ্য) উদ্ধার করেছে মাদকদ্রব্য নিয়ন্ত্রণ অধিদপ্তর (ডিএনসি)। এ ঘটনায় একটি আমদানিকারক প্রতিষ্ঠানের মালিক, সরবরাহকারী ও বিক্রেতাসহ তিনজনকে গ্রেপ্তার করা হয়েছে। শুক্রবার সকালে মাদকদ্রব্য নিয়ন্ত্রণ অধিদপ্তরের এক প্রেস বিজ্ঞপ্তিতে&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/country/dhaka/278001/%E0%A6%AE%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A7%9C%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%B9%E0%A6%82%E0%A6%95%E0%A6%82-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%86%E0%A6%A8%E0%A6%BE-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A6%BE-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A7%A9">ইনডিপেনডেন্ট টিভি</source>
    </item>
    <item>
      <title>অনিশ্চয়তা কাটিয়ে ২০৩০ বিশ্বকাপ পর্যন্ত আর্জেন্টিনার দায়িত্বে স্কালোনি</title>
      <link>https://www.itvbd.com/sports/football/278000/%E0%A6%85%E0%A6%A8%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%9A%E0%A7%9F%E0%A6%A4%E0%A6%BE-%E0%A6%95%E0%A6%BE%E0%A6%9F%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A7%A8%E0%A7%A6%E0%A7%A9%E0%A7%A6-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%95%E0%A6%BE%E0%A6%AA-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%A8%E0%A7%8D%E0%A6%A4</link>
      <guid isPermaLink="true">https://www.itvbd.com/sports/football/278000/%E0%A6%85%E0%A6%A8%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%9A%E0%A7%9F%E0%A6%A4%E0%A6%BE-%E0%A6%95%E0%A6%BE%E0%A6%9F%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A7%A8%E0%A7%A6%E0%A7%A9%E0%A7%A6-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%95%E0%A6%BE%E0%A6%AA-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%A8%E0%A7%8D%E0%A6%A4</guid>
      <pubDate>Fri, 13 Nov 2026 10:24:53 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/07/04/7b66158235867b47cf99030a5d60d8d5-6686760b822e4.jpeg?jadewits_media_id=63060" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/07/04/7b66158235867b47cf99030a5d60d8d5-6686760b822e4.jpeg?jadewits_media_id=63060" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/07/04/7b66158235867b47cf99030a5d60d8d5-6686760b822e4.jpeg?jadewits_media_id=63060" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অনিশ্চয়তা কাটিয়ে ২০৩০ বিশ্বকাপ পর্যন্ত আর্জেন্টিনার দায়িত্বে স্কালোনি" /&gt;&lt;/p&gt;&lt;p&gt;আগের চুক্তি অনুসারে, চলতি বছরের শেষেই আলবিসেলেস্তেদের সঙ্গে চুক্তির মেয়াদ শেষ হওয়ার কথা ছিল স্কালোনির। কিন্তু নতুন চুক্তির কারণে ২০৩০ সাল পর্যন্ত আর্জেন্টিনার ডাগআউটে থাকার বিষয়টি নিশ্চিত হলো তাঁর। গতকাল বৃহস্পতিবার স্কালোনির সঙ্গে চুক্তি নবায়নের ঘোষণা দেন এএফএ সভাপতি ক্লদিও তাপিয়া।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/sports/football/278000/%E0%A6%85%E0%A6%A8%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%9A%E0%A7%9F%E0%A6%A4%E0%A6%BE-%E0%A6%95%E0%A6%BE%E0%A6%9F%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A7%A8%E0%A7%A6%E0%A7%A9%E0%A7%A6-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%95%E0%A6%BE%E0%A6%AA-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%A8%E0%A7%8D%E0%A6%A4">ইনডিপেনডেন্ট টিভি</source>

      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/02/26/d63b08491b8ba5ba23f859c0bb5795ad-69a05f4f08754.jpg?jadewits_media_id=155748" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/02/26/d63b08491b8ba5ba23f859c0bb5795ad-69a05f4f08754.jpg?jadewits_media_id=155748" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/02/26/d63b08491b8ba5ba23f859c0bb5795ad-69a05f4f08754.jpg?jadewits_media_id=155748" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জিডিপির পুনর্মূল্যায়নে ফরেনসিক অডিটের উদ্যোগ" /&gt;&lt;/p&gt;&lt;p&gt;অতীতে অসত্য তথ্য প্রবাহের কারণে মানুষের অনাস্থা তৈরি হয়েছে। তাই তথ্যের স্বচ্ছতা নিয়ে জনগণ যেন প্রশ্ন তুলতে না পারে, সে নির্দেশনা দিয়েছেন প্রধানমন্ত্রী। রোববার রাজধানীতে পরিসংখ্যান দিবসের আলোচনায় এসব কথা জানান অর্থমন্ত্রী আমির খসরু মাহমুদ চৌধুরী। তিনি বলেন, জিডিপির গরমিল চিহ্নিত করতে ফরেনসিক অডিট করা&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/economy/277746/%E0%A6%9C%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A6%AA%E0%A6%BF%E0%A6%B0-%E0%A6%AA%E0%A7%81%E0%A6%A8%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%82%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A7%9F%E0%A6%A8%E0%A7%87-%E0%A6%AB%E0%A6%B0%E0%A7%87%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%95-%E0%A6%85%E0%A6%A1%E0%A6%BF%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%97">ইনডিপেনডেন্ট টিভি</source>
    </item>
    <item>
      <title>জামানত ছাড়াই ২০ লাখ টাকা ঋণ পাবেন তরুণ উদ্যোক্তারা</title>
      <link>https://www.itvbd.com/economy/277745/%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%A4-%E0%A6%9B%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A6%BE%E0%A6%87-%E0%A7%A8%E0%A7%A6-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%8B%E0%A6%A3-%E0%A6%AA%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%A8-%E0%A6%A4%E0%A6%B0%E0%A7%81%E0%A6%A3</link>
      <guid isPermaLink="true">https://www.itvbd.com/economy/277745/%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%A4-%E0%A6%9B%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A6%BE%E0%A6%87-%E0%A7%A8%E0%A7%A6-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%8B%E0%A6%A3-%E0%A6%AA%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%A8-%E0%A6%A4%E0%A6%B0%E0%A7%81%E0%A6%A3</guid>
      <pubDate>Sun, 08 Nov 2026 18:05:34 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/07/08/75306da8a956df2fed2664b6992f4a8f-6a4e5724d684c.jpg?jadewits_media_id=163605" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/07/08/75306da8a956df2fed2664b6992f4a8f-6a4e5724d684c.jpg?jadewits_media_id=163605" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/07/08/75306da8a956df2fed2664b6992f4a8f-6a4e5724d684c.jpg?jadewits_media_id=163605" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জামানত ছাড়াই ২০ লাখ টাকা ঋণ পাবেন তরুণ উদ্যোক্তারা" /&gt;&lt;/p&gt;&lt;p&gt;চাকরির পেছনে না ছুটে নিজেরাই কর্মসংস্থান তৈরি করবেন তরুণরা । এমন লক্ষ্য নিয়ে নতুন উদ্যোগ কর্মসূচি নিয়েছে বাংলাদেশ ব্যাংক। এর আওতায় তরুণ উদ্যোক্তাদের ঋণের পাশাপাশি দেয়া হবে অনুদানও। নির্বাচিত একজন উদ্যোক্তা পাবেন সর্বোচ্চ ২০ লাখ টাকা। রোববার থেকে মানিকগঞ্জ জেলার সম্ভাবনাময় তরুণ উদ্যোক্তা বাছাইয়ের মাধ&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/economy/277745/%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A6%A4-%E0%A6%9B%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A6%BE%E0%A6%87-%E0%A7%A8%E0%A7%A6-%E0%A6%B2%E0%A6%BE%E0%A6%96-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%8B%E0%A6%A3-%E0%A6%AA%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%A8-%E0%A6%A4%E0%A6%B0%E0%A7%81%E0%A6%A3">ইনডিপেনডেন্ট টিভি</source>
    </item>
    <item>
      <title>নরসিংদীতে বিড়ির নকল ব্যান্ডরোল জব্দ, আটক ২</title>
      <link>https://www.itvbd.com/country/dhaka/277744/%E0%A6%A8%E0%A6%B0%E0%A6%B8%E0%A6%BF%E0%A6%82%E0%A6%A6%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A7%9C%E0%A6%BF%E0%A6%B0-%E0%A6%A8%E0%A6%95%E0%A6%B2-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A6%B0%E0%A7%8B%E0%A6%B2-%E0%A6%9C%E0%A6%AC%E0%A7%8D%E0%A6%A6-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A7%A8</link>
      <guid isPermaLink="true">https://www.itvbd.com/country/dhaka/277744/%E0%A6%A8%E0%A6%B0%E0%A6%B8%E0%A6%BF%E0%A6%82%E0%A6%A6%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A7%9C%E0%A6%BF%E0%A6%B0-%E0%A6%A8%E0%A6%95%E0%A6%B2-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A6%B0%E0%A7%8B%E0%A6%B2-%E0%A6%9C%E0%A6%AC%E0%A7%8D%E0%A6%A6-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A7%A8</guid>
      <pubDate>Sun, 08 Nov 2026 17:28:32 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/504552f2a9c2d2b84b8449eec21ee647-6af05c582612f.jpg?jadewits_media_id=167657" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/504552f2a9c2d2b84b8449eec21ee647-6af05c582612f.jpg?jadewits_media_id=167657" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/504552f2a9c2d2b84b8449eec21ee647-6af05c582612f.jpg?jadewits_media_id=167657" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নরসিংদীতে বিড়ির নকল ব্যান্ডরোল জব্দ, আটক ২" /&gt;&lt;/p&gt;&lt;p&gt;নরসিংদীর শিবপুরে একাধিক বিড়ি কারখানায় অভিযান চালিয়ে বিপুল নকল ব্যান্ডরোল জব্দ করেছে ভ্রাম্যমাণ আদালত। এসময় দুজনকে আটক করা হয়েছে। রোববার দুপুরে শিবপুর উপজেলার কামরাবো বাজারে এ অভিযান পরিচালনা করা হয় বলে জানিয়েছেন শিবপুর উপজেলা সহকারী কমিশনার (ভূমি) সামিউর রহমান।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/country/dhaka/277744/%E0%A6%A8%E0%A6%B0%E0%A6%B8%E0%A6%BF%E0%A6%82%E0%A6%A6%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A7%9C%E0%A6%BF%E0%A6%B0-%E0%A6%A8%E0%A6%95%E0%A6%B2-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A1%E0%A6%B0%E0%A7%8B%E0%A6%B2-%E0%A6%9C%E0%A6%AC%E0%A7%8D%E0%A6%A6-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A7%A8">ইনডিপেনডেন্ট টিভি</source>
    </item>

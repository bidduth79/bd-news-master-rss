    <item>
      <title>বিদেশগামী শ্রমিকদের ভাষা শিক্ষা কার্যক্রম শুরু করবে সরকার: প্রধানমন্ত্রী</title>
      <link>https://www.itvbd.com/national/278725/%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%97%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AD%E0%A6%BE%E0%A6%B7%E0%A6%BE-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81</link>
      <guid isPermaLink="true">https://www.itvbd.com/national/278725/%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%97%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AD%E0%A6%BE%E0%A6%B7%E0%A6%BE-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81</guid>
      <pubDate>Thu, 26 Nov 2026 20:28:50 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/dc4e721e35682a0dc347ddebb938c8a5-6b08421f798f5.jpg?jadewits_media_id=168250" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/dc4e721e35682a0dc347ddebb938c8a5-6b08421f798f5.jpg?jadewits_media_id=168250" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/dc4e721e35682a0dc347ddebb938c8a5-6b08421f798f5.jpg?jadewits_media_id=168250" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বিদেশগামী শ্রমিকদের ভাষা শিক্ষা কার্যক্রম শুরু করবে সরকার: প্রধানমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;দেশের ভাবমূর্তি রক্ষায় মালয়েশিয়াগামী প্রবাসীদের আইন-কানুন মেনে কাজ করার আহ্বান জানিয়েছেন প্রধানমন্ত্রী তারেক রহমান। বিনা খরচে মালয়েশিয়াগামী শ্রমিকদের বিদায় জানাতে আজ বৃহস্পতিবার সন্ধ্যায় ঢাকার হজরত শাহজালাল আন্তর্জাতিক বিমানবন্দরে গিয়ে প্রধানমন্ত্রী এ আহ্বান জানান। 						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/national/278725/%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A6%97%E0%A6%BE%E0%A6%AE%E0%A7%80-%E0%A6%B6%E0%A7%8D%E0%A6%B0%E0%A6%AE%E0%A6%BF%E0%A6%95%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AD%E0%A6%BE%E0%A6%B7%E0%A6%BE-%E0%A6%B6%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AE-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81">ইনডিপেনডেন্ট টিভি</source>
    </item>
    <item>
      <title>জনবল সংকট কাটাতে ১০ হাজার চিকিৎসক নিয়োগ হবে: স্বাস্থ্য প্রতিমন্ত্রী</title>
      <link>https://www.itvbd.com/health/278724/%E0%A6%9C%E0%A6%A8%E0%A6%AC%E0%A6%B2-%E0%A6%B8%E0%A6%82%E0%A6%95%E0%A6%9F-%E0%A6%95%E0%A6%BE%E0%A6%9F%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A7%A7%E0%A7%A6-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%9A%E0%A6%BF%E0%A6%95%E0%A6%BF%E0%A7%8E%E0%A6%B8%E0%A6%95-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%8B%E0%A6%97-%E0%A6%B9%E0%A6%AC%E0%A7%87</link>
      <guid isPermaLink="true">https://www.itvbd.com/health/278724/%E0%A6%9C%E0%A6%A8%E0%A6%AC%E0%A6%B2-%E0%A6%B8%E0%A6%82%E0%A6%95%E0%A6%9F-%E0%A6%95%E0%A6%BE%E0%A6%9F%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A7%A7%E0%A7%A6-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%9A%E0%A6%BF%E0%A6%95%E0%A6%BF%E0%A7%8E%E0%A6%B8%E0%A6%95-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%8B%E0%A6%97-%E0%A6%B9%E0%A6%AC%E0%A7%87</guid>
      <pubDate>Thu, 26 Nov 2026 19:39:56 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/3a1afe28bac8d0cab5e269a008829d7d-6b08369bc67c7.jpg?jadewits_media_id=168249" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/3a1afe28bac8d0cab5e269a008829d7d-6b08369bc67c7.jpg?jadewits_media_id=168249" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/3a1afe28bac8d0cab5e269a008829d7d-6b08369bc67c7.jpg?jadewits_media_id=168249" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জনবল সংকট কাটাতে ১০ হাজার চিকিৎসক নিয়োগ হবে: স্বাস্থ্য প্রতিমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;জনবল সংকট কাটাতে দ্রুত সময়ের মধ্যেই সরকার ১০ হাজার চিকিৎসক নিয়োগ দেবে বলে জানিয়েছেন স্বাস্থ্য ও পরিবার কল্যাণ প্রতিমন্ত্রী ড. এম এ মুহিত। তিনি জানান, জনবল সংকট কাটাতে সরকার ১০ হাজার চিকিৎসক নিয়োগ এবং চিকিৎসক ও রোগী উভয়ের সুরক্ষায় একটি ভারসাম্যপূর্ণ আইন প্রণয়নের কাজ করছে।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/health/278724/%E0%A6%9C%E0%A6%A8%E0%A6%AC%E0%A6%B2-%E0%A6%B8%E0%A6%82%E0%A6%95%E0%A6%9F-%E0%A6%95%E0%A6%BE%E0%A6%9F%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A7%A7%E0%A7%A6-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%9A%E0%A6%BF%E0%A6%95%E0%A6%BF%E0%A7%8E%E0%A6%B8%E0%A6%95-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%8B%E0%A6%97-%E0%A6%B9%E0%A6%AC%E0%A7%87">ইনডিপেনডেন্ট টিভি</source>
    </item>
    <item>
      <title>ট্রিপল ২০০ মেগাপিক্সেল ক্যামেরার নতুন ফোন আনল অপো, দাম কত?</title>
      <link>https://www.itvbd.com/science-tech/gadget/278723/%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%AA%E0%A6%B2-%E0%A7%A8%E0%A7%A6%E0%A7%A6-%E0%A6%AE%E0%A7%87%E0%A6%97%E0%A6%BE%E0%A6%AA%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A7%87%E0%A6%B2-%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%AB%E0%A7%8B%E0%A6%A8-%E0%A6%86%E0%A6%A8%E0%A6%B2-%E0%A6%85%E0%A6%AA%E0%A7%8B</link>
      <guid isPermaLink="true">https://www.itvbd.com/science-tech/gadget/278723/%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%AA%E0%A6%B2-%E0%A7%A8%E0%A7%A6%E0%A7%A6-%E0%A6%AE%E0%A7%87%E0%A6%97%E0%A6%BE%E0%A6%AA%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A7%87%E0%A6%B2-%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%AB%E0%A7%8B%E0%A6%A8-%E0%A6%86%E0%A6%A8%E0%A6%B2-%E0%A6%85%E0%A6%AA%E0%A7%8B</guid>
      <pubDate>Thu, 26 Nov 2026 19:25:18 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/80641b43937d5e235f3896b6d1242e29-6b0832d8eef8d.jpeg?jadewits_media_id=168248" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/80641b43937d5e235f3896b6d1242e29-6b0832d8eef8d.jpeg?jadewits_media_id=168248" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/80641b43937d5e235f3896b6d1242e29-6b0832d8eef8d.jpeg?jadewits_media_id=168248" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ট্রিপল ২০০ মেগাপিক্সেল ক্যামেরার নতুন ফোন আনল অপো, দাম কত?" /&gt;&lt;/p&gt;&lt;p&gt;দেশের প্রিমিয়াম স্মার্টফোনের বাজারে নতুন ফ্ল্যাগশিপ ফোন এনেছে বৈশ্বিক প্রযুক্তি ব্র্যান্ড অপো। ‘ফাইন্ড এক্স১০ প্রো ম্যাক্স’ নামের এই স্মার্টফোনে রয়েছে বিশ্বের প্রথম ট্রিপল ২০০ মেগাপিক্সেল রিয়ার ক্যামেরা সিস্টেম। পেশাদার ক্যামেরা নির্মাতা প্রতিষ্ঠান হ্যাসেলব্লাডের সঙ্গে যৌথভাবে তৈরি করা হয়েছে ফোনটির &lt;/p&gt;</description>
      <source url="https://www.itvbd.com/science-tech/gadget/278723/%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%AA%E0%A6%B2-%E0%A7%A8%E0%A7%A6%E0%A7%A6-%E0%A6%AE%E0%A7%87%E0%A6%97%E0%A6%BE%E0%A6%AA%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A7%87%E0%A6%B2-%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%AB%E0%A7%8B%E0%A6%A8-%E0%A6%86%E0%A6%A8%E0%A6%B2-%E0%A6%85%E0%A6%AA%E0%A7%8B">ইনডিপেনডেন্ট টিভি</source>

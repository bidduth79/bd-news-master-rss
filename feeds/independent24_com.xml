    <item>
      <title>বাঁশখালীতে একই ঘর থেকে বাবা ও দুই শিশুর মরদেহ উদ্ধার</title>
      <link>https://www.itvbd.com/country/chittagong/278037/%E0%A6%AC%E0%A6%BE%E0%A6%81%E0%A6%B6%E0%A6%96%E0%A6%BE%E0%A6%B2%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A6%87-%E0%A6%98%E0%A6%B0-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A6%BE-%E0%A6%93-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%B0-%E0%A6%AE%E0%A6%B0%E0%A6%A6%E0%A7%87%E0%A6%B9</link>
      <guid isPermaLink="true">https://www.itvbd.com/country/chittagong/278037/%E0%A6%AC%E0%A6%BE%E0%A6%81%E0%A6%B6%E0%A6%96%E0%A6%BE%E0%A6%B2%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A6%87-%E0%A6%98%E0%A6%B0-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A6%BE-%E0%A6%93-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%B0-%E0%A6%AE%E0%A6%B0%E0%A6%A6%E0%A7%87%E0%A6%B9</guid>
      <pubDate>Fri, 13 Nov 2026 22:29:33 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2023/08/08/-2-3469155fe6110a5ca518aa383f60a2d0.jpg?jadewits_media_id=2972" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2023/08/08/-2-3469155fe6110a5ca518aa383f60a2d0.jpg?jadewits_media_id=2972" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2023/08/08/-2-3469155fe6110a5ca518aa383f60a2d0.jpg?jadewits_media_id=2972" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাঁশখালীতে একই ঘর থেকে বাবা ও দুই শিশুর মরদেহ উদ্ধার" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রামের বাঁশখালীতে একই ঘর থেকে সাত মাস বয়সী যমজ দুই কন্যাশিশু ও তাদের বাবার মরদেহ উদ্ধার করেছে পুলিশ। শুক্রবার বিকেলে উপজেলার পুইছড়ি ইউনিয়নের মধ্যম পুইছড়ি মওলার পাড়ায় শ্বশুরবাড়ির একটি ঘর থেকে মরদেহ তিনটি উদ্ধার করা হয়। পুলিশ ও ফায়ার সার্ভিসের সদস্যরা এ উদ্ধারকাজ চালান।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/country/chittagong/278037/%E0%A6%AC%E0%A6%BE%E0%A6%81%E0%A6%B6%E0%A6%96%E0%A6%BE%E0%A6%B2%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A6%87-%E0%A6%98%E0%A6%B0-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%AC%E0%A6%BE-%E0%A6%93-%E0%A6%A6%E0%A7%81%E0%A6%87-%E0%A6%B6%E0%A6%BF%E0%A6%B6%E0%A7%81%E0%A6%B0-%E0%A6%AE%E0%A6%B0%E0%A6%A6%E0%A7%87%E0%A6%B9">ইনডিপেনডেন্ট টিভি</source>
    </item>
    <item>
      <title>আফগানিস্তানে নারীদের চিকিৎসা দিতে পারবে না পুরুষ চিকিৎসক</title>

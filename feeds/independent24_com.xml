      <guid isPermaLink="true">https://www.itvbd.com/politics/277811/%E0%A6%85%E0%A6%AA%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%B8%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%87-%E0%A6%90%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%B9%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%A8</guid>
      <pubDate>Mon, 09 Nov 2026 20:37:43 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/ff017985040265c13f0d19026938b984-6af1dab260d30.jpg?jadewits_media_id=167696" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/ff017985040265c13f0d19026938b984-6af1dab260d30.jpg?jadewits_media_id=167696" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/ff017985040265c13f0d19026938b984-6af1dab260d30.jpg?jadewits_media_id=167696" style="max-width:100%;height:auto;margin-bottom:10px;" alt="অপপ্রচারের বিরুদ্ধে সবাইকে ঐক্যবদ্ধ থাকার আহ্বান জাপান বিএনপির" /&gt;&lt;/p&gt;&lt;p&gt;ঐতিহাসিক ৭ নভেম্বর, জাতীয় বিপ্লব ও সংহতি দিবস উপলক্ষে টোকিওর একটি হোটেলে জাপান বিএনপির উদ্যোগে আলোচনা সভা অনুষ্ঠিত হয়েছে। সোমবার এ আলোচনা সভা হয় বলে এক প্রেস বিজ্ঞপ্তিতে জানানো হয়েছে। 						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/politics/277811/%E0%A6%85%E0%A6%AA%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%9A%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%B8%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%87-%E0%A6%90%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%A6%E0%A7%8D%E0%A6%A7-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%B9%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%A8">ইনডিপেনডেন্ট টিভি</source>
    </item>
    <item>
      <title>গাজীপুরে দাঁড়িয়ে থাকা বাসে আগুন</title>
      <link>https://www.itvbd.com/country/dhaka/277810/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A7%80%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%A6%E0%A6%BE%E0%A6%81%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.itvbd.com/country/dhaka/277810/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A7%80%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%A6%E0%A6%BE%E0%A6%81%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</guid>
      <pubDate>Mon, 09 Nov 2026 20:32:00 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/8d739225e21c0e027ffdc84f4c52f493-6af1d924343dd.jpg?jadewits_media_id=167695" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/8d739225e21c0e027ffdc84f4c52f493-6af1d924343dd.jpg?jadewits_media_id=167695" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/8d739225e21c0e027ffdc84f4c52f493-6af1d924343dd.jpg?jadewits_media_id=167695" style="max-width:100%;height:auto;margin-bottom:10px;" alt="গাজীপুরে দাঁড়িয়ে থাকা বাসে আগুন" /&gt;&lt;/p&gt;&lt;p&gt;গাজীপুরের কালিয়াকৈরে ঢাকা-টাঙ্গাইল মহাসড়কে দাঁড়িয়ে থাকা আজমেরী পরিবহনের একটি বাসে আগুন দিয়েছে দুর্বৃত্তরা। খবর পেয়ে ফায়ার সার্ভিসের কর্মীরা ঘটনাস্থলে গিয়ে আগুন নিয়ন্ত্রণে আনেন।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/country/dhaka/277810/%E0%A6%97%E0%A6%BE%E0%A6%9C%E0%A7%80%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%A6%E0%A6%BE%E0%A6%81%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%A5%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8">ইনডিপেনডেন্ট টিভি</source>
    </item>
    <item>

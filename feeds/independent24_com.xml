    <item>
      <title>মাহদীর বাড়িতে পেট্রোল বোমা নিক্ষেপের অভিযোগ, ‘আলামত পায়নি’ পুলিশ</title>
      <link>https://www.itvbd.com/country/sylhet/278056/%E0%A6%AE%E0%A6%BE%E0%A6%B9%E0%A6%A6%E0%A7%80%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B2-%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97</link>
      <guid isPermaLink="true">https://www.itvbd.com/country/sylhet/278056/%E0%A6%AE%E0%A6%BE%E0%A6%B9%E0%A6%A6%E0%A7%80%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A7%87%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%8B%E0%A6%B2-%E0%A6%AC%E0%A7%8B%E0%A6%AE%E0%A6%BE-%E0%A6%A8%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%97</guid>
      <pubDate>Sat, 14 Nov 2026 13:09:46 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/23a2bf77d81071d9bcde74222fd4efff-6af80936cc25d.jpeg?jadewits_media_id=167862" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/23a2bf77d81071d9bcde74222fd4efff-6af80936cc25d.jpeg?jadewits_media_id=167862" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/23a2bf77d81071d9bcde74222fd4efff-6af80936cc25d.jpeg?jadewits_media_id=167862" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মাহদীর বাড়িতে পেট্রোল বোমা নিক্ষেপের অভিযোগ, ‘আলামত পায়নি’ পুলিশ" /&gt;&lt;/p&gt;&lt;p&gt;মাহদীর দাবি, রাত সাড়ে ১২টার দিকে হবিগঞ্জ সদর উপজেলার গোপায়া ইউনিয়নের পশ্চিম ভাদৈ গ্রামে তাদের বাড়িতে পেট্রোল বোমা হামলা হয়। দুর্বৃত্তরা বাড়ি লক্ষ্য করে তিনটি পেট্রোল বোমা নিক্ষেপ করে। এতে তার ছোট চাচার ঘরের বৈদ্যুতিক মিটার পুড়ে গেছে। 						বিস্তারিত&lt;/p&gt;</description>

      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/b02a3cf315a08ebe08f540a6c7f6ac9f-6b02c6f4921cf.jpg?jadewits_media_id=168101" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/b02a3cf315a08ebe08f540a6c7f6ac9f-6b02c6f4921cf.jpg?jadewits_media_id=168101" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/b02a3cf315a08ebe08f540a6c7f6ac9f-6b02c6f4921cf.jpg?jadewits_media_id=168101" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নাটোরে মা ও ছেলেকে হত্যায় একজনের মৃত্যুদণ্ড" /&gt;&lt;/p&gt;&lt;p&gt;নাটোরের দস্তানাবাদে নিজের মা বিলকিস বেগম ও ছেলে আলিফ হোসেনকে জবাই করে হত্যার দায়ে শাহআলম নামের এক ব্যক্তিকে মৃত্যুদণ্ড দিয়েছেন আদালত। একই মামলায় হত্যাকাণ্ডে সহযোগিতার দায়ে সোহাগ হোসেনকে যাবজ্জীবন কারাদণ্ড দেওয়া হয়েছে। এ ছাড়া শাহআলমকে ৫০ হাজার এবং সোহাগকে ২০ হাজার টাকা জরিমানা করা হয়েছে।						বিস্তার&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/country/rajshahi/278462/%E0%A6%A8%E0%A6%BE%E0%A6%9F%E0%A7%8B%E0%A6%B0%E0%A7%87-%E0%A6%AE%E0%A6%BE-%E0%A6%93-%E0%A6%9B%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A7%9F-%E0%A6%8F%E0%A6%95%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A6%A3%E0%A7%8D%E0%A6%A1">ইনডিপেনডেন্ট টিভি</source>
    </item>
    <item>

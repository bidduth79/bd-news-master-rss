      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2023/08/24/cb1fabcc370df61c54dd9e506d2906cd-64e6ea918e332.jpg?jadewits_media_id=5453" length="0" type="image/jpeg" />

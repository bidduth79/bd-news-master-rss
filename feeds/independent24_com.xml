    <item>
      <title>বাইরে আমাদের ঠিকানা নেই, দেশেই জনগণের সেবা করব: মীর শাহে আলম</title>
      <link>https://www.itvbd.com/national/278396/%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%87-%E0%A6%9C%E0%A6%A8%E0%A6%97%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%AC</link>
      <guid isPermaLink="true">https://www.itvbd.com/national/278396/%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%87-%E0%A6%9C%E0%A6%A8%E0%A6%97%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%AC</guid>
      <pubDate>Sat, 21 Nov 2026 13:52:08 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/ff0cdc88676113349dc1270ab714f5fc-6b014d4f79f16.jpg?jadewits_media_id=168064" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/ff0cdc88676113349dc1270ab714f5fc-6b014d4f79f16.jpg?jadewits_media_id=168064" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/ff0cdc88676113349dc1270ab714f5fc-6b014d4f79f16.jpg?jadewits_media_id=168064" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাইরে আমাদের ঠিকানা নেই, দেশেই জনগণের সেবা করব: মীর শাহে আলম" /&gt;&lt;/p&gt;&lt;p&gt;স্থানীয় সরকার পল্লী উন্নয়ন ও সমবায় প্রতিমন্ত্রী মীর শাহে আলম বলেছেন, ‘আমরা জনগণের ভোটে নির্বাচিত। প্রধানমন্ত্রীসহ আমরা যারা বিএনপির রাজনীতি করি, আমাদের কারো দেশের বাইরে কোনো ঠিকানা নেই। আমরা এ দেশে থেকেই জনগণের উন্নয়নে কাজ করব।’						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/national/278396/%E0%A6%AC%E0%A6%BE%E0%A6%87%E0%A6%B0%E0%A7%87-%E0%A6%86%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%A0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%A8%E0%A7%87%E0%A6%87-%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%87-%E0%A6%9C%E0%A6%A8%E0%A6%97%E0%A6%A3%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A6%BE-%E0%A6%95%E0%A6%B0%E0%A6%AC">ইনডিপেনডেন্ট টিভি</source>

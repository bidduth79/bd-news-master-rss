      <pubDate>Tue, 17 Nov 2026 08:49:02 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/b791357164ec72c284e00c266110de7d-6afbc0981461a.jpg?jadewits_media_id=167930" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/b791357164ec72c284e00c266110de7d-6afbc0981461a.jpg?jadewits_media_id=167930" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/b791357164ec72c284e00c266110de7d-6afbc0981461a.jpg?jadewits_media_id=167930" style="max-width:100%;height:auto;margin-bottom:10px;" alt="চলতি সপ্তাহেই হতে পারে ট্রাম্প-কিমের বৈঠক" /&gt;&lt;/p&gt;&lt;p&gt;এ সপ্তাহে উত্তর কোরিয়ার নেতা কিম জং উনের সঙ্গে বৈঠক করতে পারেন মার্কিন প্রেসিডেন্ট। সোমবার, ফিলিপাইন ও চীনের উদ্দেশে হোয়াইট হাউস ছাড়ার সময় সাংবাদিকদের এ কথা জানান ডোনাল্ড ট্রাম্প।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/world/america/278166/%E0%A6%9A%E0%A6%B2%E0%A6%A4%E0%A6%BF-%E0%A6%B8%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B9%E0%A7%87%E0%A6%87-%E0%A6%B9%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA-%E0%A6%95%E0%A6%BF%E0%A6%AE%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%88%E0%A6%A0%E0%A6%95">ইনডিপেনডেন্ট টিভি</source>
    </item>
    <item>
      <title>খাবারে ভেজাল ঠেকানো যাচ্ছে না কেন?</title>
      <link>https://www.itvbd.com/analysis/278165/%E0%A6%96%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%AD%E0%A7%87%E0%A6%9C%E0%A6%BE%E0%A6%B2-%E0%A6%A0%E0%A7%87%E0%A6%95%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%A8%E0%A6%BE-%E0%A6%95%E0%A7%87%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.itvbd.com/analysis/278165/%E0%A6%96%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%AD%E0%A7%87%E0%A6%9C%E0%A6%BE%E0%A6%B2-%E0%A6%A0%E0%A7%87%E0%A6%95%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%A8%E0%A6%BE-%E0%A6%95%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Tue, 17 Nov 2026 00:38:54 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/35ad3e881f97e6bd1416a1b3b2ba66c3-6afb4d81067ed.jpg?jadewits_media_id=167929" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/35ad3e881f97e6bd1416a1b3b2ba66c3-6afb4d81067ed.jpg?jadewits_media_id=167929" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/35ad3e881f97e6bd1416a1b3b2ba66c3-6afb4d81067ed.jpg?jadewits_media_id=167929" style="max-width:100%;height:auto;margin-bottom:10px;" alt="খাবারে ভেজাল ঠেকানো যাচ্ছে না কেন?" /&gt;&lt;/p&gt;&lt;p&gt;দুধ, মাছ, সবজি কিংবা মসলা—দেখতে ভালো হলেই নিরাপদ নয়। তাতে থাকতে পারে ক্ষতিকর জীবাণু, নিষিদ্ধ উপাদান কিংবা দূষিত মাটি ও পানি থেকে আসা ধাতু। এসব ঠেকাতে আইন আছে। অভিযান হয়। জরিমানাও হয়। তারপরও পরীক্ষায় সমস্যা মিলছে। কেন? উত্তর খুঁজতে দেখতে হবে খাবারের পুরো যাত্রা। উৎপাদন থেকে বাজার পর্যন্ত কোথায় দূষণ হ&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/analysis/278165/%E0%A6%96%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%AD%E0%A7%87%E0%A6%9C%E0%A6%BE%E0%A6%B2-%E0%A6%A0%E0%A7%87%E0%A6%95%E0%A6%BE%E0%A6%A8%E0%A7%8B-%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%A8%E0%A6%BE-%E0%A6%95%E0%A7%87%E0%A6%A8">ইনডিপেনডেন্ট টিভি</source>
    </item>
    <item>
      <title>জমির সর্বনিম্ন মূল্য নির্ধারণে ক্লাস্টার, নাকি রাস্তা-কেন্দ্রিক নীতি?</title>
      <link>https://www.itvbd.com/others/278164/%E0%A6%9C%E0%A6%AE%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%A8%E0%A6%BF%E0%A6%AE%E0%A7%8D%E0%A6%A8-%E0%A6%AE%E0%A7%82%E0%A6%B2%E0%A7%8D%E0%A6%AF-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%95%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%95%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.itvbd.com/others/278164/%E0%A6%9C%E0%A6%AE%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%A8%E0%A6%BF%E0%A6%AE%E0%A7%8D%E0%A6%A8-%E0%A6%AE%E0%A7%82%E0%A6%B2%E0%A7%8D%E0%A6%AF-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%95%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%95%E0%A6%BF</guid>
      <pubDate>Tue, 17 Nov 2026 00:30:55 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/28b67c12331370642859ab8991c7cee4-6afb4bc79d6ac.jpg?jadewits_media_id=167928" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/28b67c12331370642859ab8991c7cee4-6afb4bc79d6ac.jpg?jadewits_media_id=167928" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/17/28b67c12331370642859ab8991c7cee4-6afb4bc79d6ac.jpg?jadewits_media_id=167928" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জমির সর্বনিম্ন মূল্য নির্ধারণে ক্লাস্টার, নাকি রাস্তা-কেন্দ্রিক নীতি?" /&gt;&lt;/p&gt;&lt;p&gt;ধরা যাক, একজন ব্যক্তি ৮ লাখ টাকার বিনিময়ে ১০ শতক জমি ক্রয় করে সাফ কবলা দলিল নিবন্ধন করার জন্য সাব-রেজিস্ট্রি অফিসে গেলেন। অফিস থেকে জানানো হলো, সরকারি মূল্য অনুযায়ী দলিলে ২৬ লাখ টাকা দেখাতে হবে। অর্থাৎ ক্রেতা-বিক্রেতা পরস্পর যে অর্থ লেনদেন করেননি, দলিলে তার দায় তাঁদের নিতে হবে এবং অতিরিক্ত টাকার ওপর&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/others/278164/%E0%A6%9C%E0%A6%AE%E0%A6%BF%E0%A6%B0-%E0%A6%B8%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A6%A8%E0%A6%BF%E0%A6%AE%E0%A7%8D%E0%A6%A8-%E0%A6%AE%E0%A7%82%E0%A6%B2%E0%A7%8D%E0%A6%AF-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0%E0%A6%A3%E0%A7%87-%E0%A6%95%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%95%E0%A6%BF">ইনডিপেনডেন্ট টিভি</source>

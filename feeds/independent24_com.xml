      <guid isPermaLink="true">https://www.itvbd.com/national/277867/%E0%A6%95%E0%A6%AA%E2%80%93%E0%A7%A9%E0%A7%A7-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%A8%E0%A7%87-%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A7%87%E0%A7%97%E0%A6%81%E0%A6%9B%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Tue, 10 Nov 2026 21:05:12 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/63b79e46cb88745365a214f94b97ccdb-6af332721fa46.jpg?jadewits_media_id=167731" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/63b79e46cb88745365a214f94b97ccdb-6af332721fa46.jpg?jadewits_media_id=167731" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/63b79e46cb88745365a214f94b97ccdb-6af332721fa46.jpg?jadewits_media_id=167731" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কপ–৩১ সম্মেলনে যোগ দিতে আন্তালিয়ায় পৌঁছেছেন প্রধানমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;প্রধানমন্ত্রী তারেক রহমান কপ–৩১ সম্মেলনে যোগ দিতে তিন দিনের সরকারি সফরে আজ (স্থানীয় সময়) বিকেলে ৪টা ৩ মিনিটে তুরস্কের আন্তালিয়ায় পৌঁছেছেন।

প্রধানমন্ত্রীর উপ প্রেস সচিব হাসান শিপলু জানান, প্রধানমন্ত্রী তার সহধর্মিণী ডা. জুবাইদা রহমান এবং সফরসঙ্গীদের বহনকারী টার্কিশ এয়ারলাইনসের একটি ফ্লাইট ইস্তাম্বু&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/national/277867/%E0%A6%95%E0%A6%AA%E2%80%93%E0%A7%A9%E0%A7%A7-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%A8%E0%A7%87-%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A7%87%E0%A7%97%E0%A6%81%E0%A6%9B%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8">ইনডিপেনডেন্ট টিভি</source>
    </item>
    <item>
      <title>বুলগেরিয়ায় ঘন কুয়াশার কারণে সড়ক দুর্ঘটনায় নিহত অন্তত ১২</title>

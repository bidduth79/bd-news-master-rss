    <item>
      <title>রামিসা হত্যা মামলায় হাইকোর্টের রায় আজ</title>
      <link>https://www.itvbd.com/national/278167/%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%BF%E0%A6%B8%E0%A6%BE-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%B9%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%86%E0%A6%9C</link>
      <guid isPermaLink="true">https://www.itvbd.com/national/278167/%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%BF%E0%A6%B8%E0%A6%BE-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%B9%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%86%E0%A6%9C</guid>
      <pubDate>Tue, 17 Nov 2026 09:28:15 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/05/13/ae0a2b69c9be870f989ae9b9922e40ee-6822d1edd0c44.jpg?jadewits_media_id=120237" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/05/13/ae0a2b69c9be870f989ae9b9922e40ee-6822d1edd0c44.jpg?jadewits_media_id=120237" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/05/13/ae0a2b69c9be870f989ae9b9922e40ee-6822d1edd0c44.jpg?jadewits_media_id=120237" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রামিসা হত্যা মামলায় হাইকোর্টের রায় আজ" /&gt;&lt;/p&gt;&lt;p&gt;বহুল আলোচিত শিশু রামিসা ধর্ষণ ও হত্যা মামলার আপিল শুনানি এক দিনেই শেষ হয়েছে হাইকোর্টে। আজ মঙ্গলবার রায় ঘোষণা করবে বিচারপতি ভিষ্মদেব চক্রবর্তীর নেতৃত্বাধীন বেঞ্চ। আসামি সোহেল রানা ও তার স্ত্রী স্বপ্না খাতুনের মৃত্যুদণ্ড বহাল চায় রাষ্ট্রপক্ষ। আর আসামিদের পক্ষে রাষ্ট্র নিয়োজিত আইনজীবী চান খালাস।					&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/national/278167/%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A6%BF%E0%A6%B8%E0%A6%BE-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%B9%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A7%9F-%E0%A6%86%E0%A6%9C">ইনডিপেনডেন্ট টিভি</source>
    </item>
    <item>
      <title>চলতি সপ্তাহেই হতে পারে ট্রাম্প-কিমের বৈঠক</title>

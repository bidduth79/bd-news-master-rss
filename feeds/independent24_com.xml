    <item>
      <title>নেটওয়ার্কিংয়ে নতুন প্রযুক্তি</title>
      <link>https://www.itvbd.com/science-tech/278375/%E0%A6%A8%E0%A7%87%E0%A6%9F%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%82%E0%A7%9F%E0%A7%87-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.itvbd.com/science-tech/278375/%E0%A6%A8%E0%A7%87%E0%A6%9F%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%82%E0%A7%9F%E0%A7%87-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF</guid>
      <pubDate>Fri, 20 Nov 2026 21:33:41 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/aa1d84523db705087f8a2d047ac15387-6b006830da18b.jpeg?jadewits_media_id=168053" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/aa1d84523db705087f8a2d047ac15387-6b006830da18b.jpeg?jadewits_media_id=168053" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/aa1d84523db705087f8a2d047ac15387-6b006830da18b.jpeg?jadewits_media_id=168053" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নেটওয়ার্কিংয়ে নতুন প্রযুক্তি" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশের বাজারে পরবর্তী প্রজন্মের ওয়্যারলেস প্রযুক্তি ওয়াই-ফাই ৮ উন্মোচন করেছে নেটওয়ার্কিং প্রতিষ্ঠান টিপি-লিংক। একই সঙ্গে নেটওয়ার্ক প্রকৌশলী ও প্রযুক্তি পেশাজীবীদের দক্ষতা বাড়াতে ‘ওমাডা এক্সপার্ট’ কর্মসূচি চালুর ঘোষণা দিয়েছে প্রতিষ্ঠানটি।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/science-tech/278375/%E0%A6%A8%E0%A7%87%E0%A6%9F%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%82%E0%A7%9F%E0%A7%87-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF">ইনডিপেনডেন্ট টিভি</source>
    </item>
    <item>
      <title>ইইউয়ের সঙ্গে নতুন চুক্তি করেছে যুক্তরাজ্য</title>

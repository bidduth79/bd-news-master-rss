    <item>
      <title>জাতীয় প্রাণিসম্পদ পদক ২০২৬ পেল আকিজ এগ্রো ফিড</title>
      <link>https://www.itvbd.com/economy/corporate/278717/%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3%E0%A6%BF%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%A6-%E0%A6%AA%E0%A6%A6%E0%A6%95-%E0%A7%A8%E0%A7%A6%E0%A7%A8%E0%A7%AC-%E0%A6%AA%E0%A7%87%E0%A6%B2-%E0%A6%86%E0%A6%95%E0%A6%BF%E0%A6%9C-%E0%A6%8F%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%8B-%E0%A6%AB%E0%A6%BF%E0%A6%A1%C2%A0</link>
      <guid isPermaLink="true">https://www.itvbd.com/economy/corporate/278717/%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3%E0%A6%BF%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%A6-%E0%A6%AA%E0%A6%A6%E0%A6%95-%E0%A7%A8%E0%A7%A6%E0%A7%A8%E0%A7%AC-%E0%A6%AA%E0%A7%87%E0%A6%B2-%E0%A6%86%E0%A6%95%E0%A6%BF%E0%A6%9C-%E0%A6%8F%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%8B-%E0%A6%AB%E0%A6%BF%E0%A6%A1%C2%A0</guid>
      <pubDate>Thu, 26 Nov 2026 18:17:07 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/a8776cd904237be849eea36f82c8b4d3-6b08231891e84.jpg?jadewits_media_id=168246" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/a8776cd904237be849eea36f82c8b4d3-6b08231891e84.jpg?jadewits_media_id=168246" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/a8776cd904237be849eea36f82c8b4d3-6b08231891e84.jpg?jadewits_media_id=168246" style="max-width:100%;height:auto;margin-bottom:10px;" alt="জাতীয় প্রাণিসম্পদ পদক ২০২৬ পেল আকিজ এগ্রো ফিড" /&gt;&lt;/p&gt;&lt;p&gt;জাতীয় পর্যায়ে প্রাণিসম্পদ খাতে অবদানের স্বীকৃতিস্বরূপ ‘জাতীয় প্রাণিসম্পদ পদক ২০২৬’ পেয়েছে আকিজ এগ্রো ফিড লিমিটেড। দেশের প্রাণিসম্পদ খাতের উন্নয়ন, মানসম্মত প্রাণিখাদ্য উৎপাদন, প্রক্রিয়াজাতকরণ ও বাজারজাতকরণে গুরুত্বপূর্ণ অবদানের স্বীকৃতিস্বরূপ রৌপ্য পদক পেল দেশের অন্যতম শীর্ষস্থানীয় শিল্পগ্রুপ আকিজ রি&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/economy/corporate/278717/%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A7%9F-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3%E0%A6%BF%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%A6-%E0%A6%AA%E0%A6%A6%E0%A6%95-%E0%A7%A8%E0%A7%A6%E0%A7%A8%E0%A7%AC-%E0%A6%AA%E0%A7%87%E0%A6%B2-%E0%A6%86%E0%A6%95%E0%A6%BF%E0%A6%9C-%E0%A6%8F%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%8B-%E0%A6%AB%E0%A6%BF%E0%A6%A1%C2%A0">ইনডিপেনডেন্ট টিভি</source>
    </item>

      <guid isPermaLink="true">https://www.itvbd.com/world/india/278262/%E0%A6%86%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%B8%E0%A6%BF%E0%A6%AE%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%AC%E0%A7%88%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%95-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A7%81</guid>
      <pubDate>Wed, 18 Nov 2026 20:35:49 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/d40ca8c5986d550443cc92fec93f6847-6afdb770d4c55.jpg?jadewits_media_id=167986" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/d40ca8c5986d550443cc92fec93f6847-6afdb770d4c55.jpg?jadewits_media_id=167986" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/d40ca8c5986d550443cc92fec93f6847-6afdb770d4c55.jpg?jadewits_media_id=167986" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আদানি সিমেন্টের ভারী বৈদ্যুতিক ট্রাক চালু" /&gt;&lt;/p&gt;&lt;p&gt;ভারতের অন্যতম শীর্ষ নির্মাণসামগ্রী প্রতিষ্ঠান আদানি সিমেন্ট ক্লিঙ্কার ও সিমেন্ট পরিবহনে ভারী বৈদ্যুতিক ট্রাকের যাত্রা শুরু করেছে। গুজরাটের সাংঘি প্লান্টে এসব ট্রাকের উদ্বোধন করা হয়। আদানি গ্রুপের সহযোগী এই প্রতিষ্ঠানটির জন্য এটিই প্রথম বৈদ্যুতিক ট্রাক ব্যবহারের উদ্যোগ, যা তাদের টেকসই ও সবুজ পরিবহন&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/world/india/278262/%E0%A6%86%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%B8%E0%A6%BF%E0%A6%AE%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A7%80-%E0%A6%AC%E0%A7%88%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%95-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A7%81">ইনডিপেনডেন্ট টিভি</source>
    </item>
    <item>
      <title>তাঁবেদার অপশক্তি অগ্রযাত্রা ব্যাহত করার চেষ্টা করছে বারবার: সংসদে প্রধানমন্ত্রী</title>

    <item>
      <title>সাফ চ্যাম্পিয়নশিপের স্বাস্থ্যসেবার দায়িত্বে মাদানী এভিনিউর ইউনাইটেড মেডিকেল কলেজ হসপিটাল</title>
      <link>https://www.itvbd.com/economy/corporate/277747/%E0%A6%B8%E0%A6%BE%E0%A6%AB-%E0%A6%9A%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A7%9F%E0%A6%A8%E0%A6%B6%E0%A6%BF%E0%A6%AA%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A7%8D%E0%A6%AF%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A7%9F%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A7%80</link>
      <guid isPermaLink="true">https://www.itvbd.com/economy/corporate/277747/%E0%A6%B8%E0%A6%BE%E0%A6%AB-%E0%A6%9A%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A7%9F%E0%A6%A8%E0%A6%B6%E0%A6%BF%E0%A6%AA%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A7%8D%E0%A6%AF%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A7%9F%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A7%80</guid>
      <pubDate>Sun, 08 Nov 2026 18:16:48 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/b500535fc851591f5e615d79f2a10bed-6af068235c0c0.jpg?jadewits_media_id=167658" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/b500535fc851591f5e615d79f2a10bed-6af068235c0c0.jpg?jadewits_media_id=167658" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/b500535fc851591f5e615d79f2a10bed-6af068235c0c0.jpg?jadewits_media_id=167658" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাফ চ্যাম্পিয়নশিপের স্বাস্থ্যসেবার দায়িত্বে মাদানী এভিনিউর ইউনাইটেড মেডিকেল কলেজ হসপিটাল" /&gt;&lt;/p&gt;&lt;p&gt;সাফ চ্যাম্পিয়নশিপ ২০২৬-এ মেডিকেল সাপোর্ট নিশ্চিত করার দায়িত্ব পেয়েছে ইউনাইটেড মেডিকেল কলেজ হসপিটাল। সাউথ এশিয়ান ফুটবল ফেডারেশন (সাফ) আয়োজিত এই টুর্নামেন্টে অংশগ্রহণকারী খেলোয়াড় ও দর্শকদের জরুরি স্বাস্থ্যসেবা দেবে হসপিটালটি।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/economy/corporate/277747/%E0%A6%B8%E0%A6%BE%E0%A6%AB-%E0%A6%9A%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A7%9F%E0%A6%A8%E0%A6%B6%E0%A6%BF%E0%A6%AA%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A7%8D%E0%A6%AF%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A7%9F%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A6%BE%E0%A6%A8%E0%A7%80">ইনডিপেনডেন্ট টিভি</source>

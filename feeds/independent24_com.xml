      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/47140a78e7f187e9ebda0ec3c4fc4992-6b0a7745e5ca9.jpg?jadewits_media_id=168284" length="0" type="image/jpeg" />

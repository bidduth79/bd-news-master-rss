      <title>বেলাল খানের মিউজিক্যাল শর্টফিল্ম ‘আঁধার রাতের ছায়া’</title>
      <link>https://www.itvbd.com/entertainment/music/278064/%E0%A6%AC%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A6%B2-%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%89%E0%A6%9C%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2-%E0%A6%B6%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A6%AB%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%AE-%E2%80%98%E0%A6%86%E0%A6%81%E0%A6%A7%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.itvbd.com/entertainment/music/278064/%E0%A6%AC%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A6%B2-%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%89%E0%A6%9C%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2-%E0%A6%B6%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A6%AB%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%AE-%E2%80%98%E0%A6%86%E0%A6%81%E0%A6%A7%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Sat, 14 Nov 2026 14:47:38 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/e92317c807e8bd1f4cbb55ffd59b6861-6af81f849314e.jpg?jadewits_media_id=167871" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/e92317c807e8bd1f4cbb55ffd59b6861-6af81f849314e.jpg?jadewits_media_id=167871" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/e92317c807e8bd1f4cbb55ffd59b6861-6af81f849314e.jpg?jadewits_media_id=167871" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বেলাল খানের মিউজিক্যাল শর্টফিল্ম ‘আঁধার রাতের ছায়া’" /&gt;&lt;/p&gt;&lt;p&gt;জনপ্রিয় সংগীতশিল্পী বেলাল খানের কণ্ঠে প্রকাশিত হয়েছে মিউজিক্যাল শর্টফিল্ম ‘আঁধার রাতের ছায়া’। প্রচলিত মিউজিক ভিডিওর বাইরে গিয়ে এই গানের সঙ্গে একটি পূর্ণাঙ্গ চলচ্চিত্রের আবহ ও গল্পনির্ভর দৃশ্যায়ন যুক্ত করা হয়েছে।

আঁধার রাতের ছায়া গানের কথা লিখেছেন সালাম সরকার। সুর করেছেন সোহেল অটল। যৌথভাবে গানটির সং&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/entertainment/music/278064/%E0%A6%AC%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A6%B2-%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%BF%E0%A6%89%E0%A6%9C%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2-%E0%A6%B6%E0%A6%B0%E0%A7%8D%E0%A6%9F%E0%A6%AB%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%AE-%E2%80%98%E0%A6%86%E0%A6%81%E0%A6%A7%E0%A6%BE%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A6%A4%E0%A7%87%E0%A6%B0">ইনডিপেনডেন্ট টিভি</source>
    </item>

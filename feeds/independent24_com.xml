    <item>
      <title>রাজধানীতে আবাসিক হোটেলের জানালা থেকে পড়ে কিশোরের মৃত্যু</title>
      <link>https://www.itvbd.com/country/dhaka/277750/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%95-%E0%A6%B9%E0%A7%8B%E0%A6%9F%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A6%BE-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%A1%E0%A6%BC%E0%A7%87-%E0%A6%95%E0%A6%BF%E0%A6%B6%E0%A7%8B%E0%A6%B0%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.itvbd.com/country/dhaka/277750/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%86%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%95-%E0%A6%B9%E0%A7%8B%E0%A6%9F%E0%A7%87%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A6%BE-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AA%E0%A6%A1%E0%A6%BC%E0%A7%87-%E0%A6%95%E0%A6%BF%E0%A6%B6%E0%A7%8B%E0%A6%B0%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Sun, 08 Nov 2026 19:20:45 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2023/08/07/-1-135cb37d59860c151c10da891acdc8f1.jpg?jadewits_media_id=2854" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2023/08/07/-1-135cb37d59860c151c10da891acdc8f1.jpg?jadewits_media_id=2854" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2023/08/07/-1-135cb37d59860c151c10da891acdc8f1.jpg?jadewits_media_id=2854" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজধানীতে আবাসিক হোটেলের জানালা থেকে পড়ে কিশোরের মৃত্যু" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর উত্তরায় একটি আবাসিক হোটেলের পঞ্চম তলার গ্রিলবিহীন জানালা থেকে নিচে পড়ে মাহমুদুল হাসান সিয়াম (১৭) নামে এক তরুণের মৃত্যু হয়েছে।

গতকাল শনিবার বিকেল সাড়ে ৪টার দিকে বিমানবন্দর থানাধীন উত্তরা ১ নম্বর সেক্টরের ৫ নম্বর রোডে অবস্থিত হোটেল এম্বাসেডরে এ দুর্ঘটনা ঘটে।						বিস্তারিত&lt;/p&gt;</description>

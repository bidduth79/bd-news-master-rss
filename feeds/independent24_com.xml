    <item>
      <title>৮ শহরে পানি ও পয়োনিষ্কাশন সেবা উন্নয়নে ১৫ কোটি ডলার দিচ্ছে এডিবি</title>
      <link>https://www.itvbd.com/economy/278713/%E0%A7%AE-%E0%A6%B6%E0%A6%B9%E0%A6%B0%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%93-%E0%A6%AA%E0%A7%9F%E0%A7%8B%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A6%B6%E0%A6%A8-%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A6%BE-%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A7%9F%E0%A6%A8%E0%A7%87-%E0%A7%A7%E0%A7%AB-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.itvbd.com/economy/278713/%E0%A7%AE-%E0%A6%B6%E0%A6%B9%E0%A6%B0%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%93-%E0%A6%AA%E0%A7%9F%E0%A7%8B%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A6%B6%E0%A6%A8-%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A6%BE-%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A7%9F%E0%A6%A8%E0%A7%87-%E0%A7%A7%E0%A7%AB-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF</guid>
      <pubDate>Thu, 26 Nov 2026 17:58:37 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2023/12/08/9a3f7ac74a63031e7705c78c46fd8670-6572f5f8128ad.jpg?jadewits_media_id=24929" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2023/12/08/9a3f7ac74a63031e7705c78c46fd8670-6572f5f8128ad.jpg?jadewits_media_id=24929" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2023/12/08/9a3f7ac74a63031e7705c78c46fd8670-6572f5f8128ad.jpg?jadewits_media_id=24929" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৮ শহরে পানি ও পয়োনিষ্কাশন সেবা উন্নয়নে ১৫ কোটি ডলার দিচ্ছে এডিবি" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশের আটটি দ্রুত বর্ধনশীল শহরে নিরাপদ ও নির্ভরযোগ্য পানি সরবরাহ এবং পয়োনিষ্কাশন ব্যবস্থা উন্নয়নে ১৫ কোটি ডলার ঋণ অনুমোদন করেছে এশীয় উন্নয়ন ব্যাংক (এডিবি)। এ প্রকল্পের আওতায় প্রায় ৯ লাখ মানুষ উন্নত পানি ও পয়োনিষ্কাশন সুবিধা পাবে।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/economy/278713/%E0%A7%AE-%E0%A6%B6%E0%A6%B9%E0%A6%B0%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%93-%E0%A6%AA%E0%A7%9F%E0%A7%8B%E0%A6%A8%E0%A6%BF%E0%A6%B7%E0%A7%8D%E0%A6%95%E0%A6%BE%E0%A6%B6%E0%A6%A8-%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A6%BE-%E0%A6%89%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A7%9F%E0%A6%A8%E0%A7%87-%E0%A7%A7%E0%A7%AB-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF">ইনডিপেনডেন্ট টিভি</source>
    </item>
    <item>
      <title>১৮ মাসের বিক্রয়োত্তর সেবা দেবে কিউসিওয়াই</title>
      <link>https://www.itvbd.com/science-tech/278712/%E0%A7%A7%E0%A7%AE-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AF%E0%A6%BC%E0%A7%8B%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%B0-%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%AC%E0%A7%87-%E0%A6%95%E0%A6%BF%E0%A6%89%E0%A6%B8%E0%A6%BF%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%87</link>
      <guid isPermaLink="true">https://www.itvbd.com/science-tech/278712/%E0%A7%A7%E0%A7%AE-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AF%E0%A6%BC%E0%A7%8B%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%B0-%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%AC%E0%A7%87-%E0%A6%95%E0%A6%BF%E0%A6%89%E0%A6%B8%E0%A6%BF%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%87</guid>
      <pubDate>Thu, 26 Nov 2026 17:53:31 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/6817aa8d0ef3f84938524a3d96a5f9c6-6b081d4aede47.jpg?jadewits_media_id=168241" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/6817aa8d0ef3f84938524a3d96a5f9c6-6b081d4aede47.jpg?jadewits_media_id=168241" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/6817aa8d0ef3f84938524a3d96a5f9c6-6b081d4aede47.jpg?jadewits_media_id=168241" style="max-width:100%;height:auto;margin-bottom:10px;" alt="১৮ মাসের বিক্রয়োত্তর সেবা দেবে কিউসিওয়াই" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশে জনপ্রিয় প্রযুক্তিপণ্য ব্র্যান্ড কিউসিওয়াইয়ের ব্র্যান্ড অ্যাম্বাসেডর হয়েছেন অভিনেতা তৌসিফ মাহবুব। একই সঙ্গে দেশে বাজারজারে তাদের পণ্যের ওয়ারেন্টির মেয়াদ ১২ মাস থেকে বাড়িয়ে ১৮ মাস করার ঘোষণা দিয়েছে পরিবেশক প্রতিষ্ঠান আইটেক স্মার্ট লিমিটেড।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/science-tech/278712/%E0%A7%A7%E0%A7%AE-%E0%A6%AE%E0%A6%BE%E0%A6%B8%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%AF%E0%A6%BC%E0%A7%8B%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%B0-%E0%A6%B8%E0%A7%87%E0%A6%AC%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%AC%E0%A7%87-%E0%A6%95%E0%A6%BF%E0%A6%89%E0%A6%B8%E0%A6%BF%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%87">ইনডিপেনডেন্ট টিভি</source>

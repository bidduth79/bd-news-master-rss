      <guid isPermaLink="true">https://www.itvbd.com/economy/278800/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%B0-%E0%A6%B6%E0%A6%AA%E0%A6%BF%E0%A6%82%E0%A6%AE%E0%A6%B2-%E0%A6%93-%E0%A6%AB%E0%A7%81%E0%A6%9F%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%9C%E0%A6%AE%E0%A7%87-%E0%A6%89%E0%A6%A0%E0%A6%9B%E0%A7%87-%E0%A6%B6%E0%A7%80%E0%A6%A4%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%AA%E0%A7%9C%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Sat, 28 Nov 2026 18:32:35 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/77ac05e484df0e7e90e8430b9b8fef43-6b0ac9d8d21b9.jpg?jadewits_media_id=168299" length="0" type="image/jpeg" />

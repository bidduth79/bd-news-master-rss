      <guid isPermaLink="true">https://www.itvbd.com/national/278261/%E0%A6%A4%E0%A6%BE%E0%A6%81%E0%A6%AC%E0%A7%87%E0%A6%A6%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%AA%E0%A6%B6%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%85%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A6%AF%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B9%E0%A6%A4-%E0%A6%95%E0%A6%B0%E0%A6%BE%E0%A6%B0-%E0%A6%9A%E0%A7%87%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A6%BE</guid>
      <pubDate>Wed, 18 Nov 2026 20:27:45 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/d525ea604dada78af05f6f0a4f57e08d-6afda06e35ef2.jpg?jadewits_media_id=167978" length="0" type="image/jpeg" />

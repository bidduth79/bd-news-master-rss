    <item>
      <title>পুলিশে নতুন ১৪ হাজার পদ সৃজনের অনুমোদন স্বরাষ্ট্র মন্ত্রণালয়ের</title>
      <link>https://www.itvbd.com/national/278460/%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A7%A7%E0%A7%AA-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%A6-%E0%A6%B8%E0%A7%83%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AE%E0%A7%8B%E0%A6%A6%E0%A6%A8-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.itvbd.com/national/278460/%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A7%A7%E0%A7%AA-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%A6-%E0%A6%B8%E0%A7%83%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AE%E0%A7%8B%E0%A6%A6%E0%A6%A8-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0</guid>
      <pubDate>Sun, 22 Nov 2026 16:13:28 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/07/05/94d15b0df728a7b5110cacf7ad057efb-6a4a50b446664.jpg?jadewits_media_id=163447" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/07/05/94d15b0df728a7b5110cacf7ad057efb-6a4a50b446664.jpg?jadewits_media_id=163447" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/07/05/94d15b0df728a7b5110cacf7ad057efb-6a4a50b446664.jpg?jadewits_media_id=163447" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পুলিশে নতুন ১৪ হাজার পদ সৃজনের অনুমোদন স্বরাষ্ট্র মন্ত্রণালয়ের" /&gt;&lt;/p&gt;&lt;p&gt;পুলিশের জনবল ও প্রাতিষ্ঠানিক সক্ষমতা বাড়াতে ১৪ হাজার নতুন পদ সৃজনের অনুমোদন দিয়েছে স্বরাষ্ট্র মন্ত্রণালয়। এর মধ্যে ১০ হাজার কনস্টেবল এবং ৪ হাজার উপপরিদর্শক (এসআই-নিরস্ত্র) পদ রয়েছে। নতুন এসব পদ সৃজনে জনপ্রশাসন মন্ত্রণালয়, অর্থ বিভাগ ও মন্ত্রিপরিষদ বিভাগের প্রয়োজনীয় সম্মতি এবং যথাযথ কর্তৃপক্ষের অনুমো&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/national/278460/%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A7%A7%E0%A7%AA-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%A6-%E0%A6%B8%E0%A7%83%E0%A6%9C%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%85%E0%A6%A8%E0%A7%81%E0%A6%AE%E0%A7%8B%E0%A6%A6%E0%A6%A8-%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0">ইনডিপেনডেন্ট টিভি</source>

    <item>
      <title>আবাসন খাতে সমন্বিত অনিয়ম চলছে: টিআইবি</title>
      <link>https://www.itvbd.com/country/dhaka/278652/%E0%A6%86%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%A8-%E0%A6%96%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%A4-%E0%A6%85%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%AE-%E0%A6%9A%E0%A6%B2%E0%A6%9B%E0%A7%87-%E0%A6%9F%E0%A6%BF%E0%A6%86%E0%A6%87%E0%A6%AC%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.itvbd.com/country/dhaka/278652/%E0%A6%86%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%A8-%E0%A6%96%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%A4-%E0%A6%85%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%AE-%E0%A6%9A%E0%A6%B2%E0%A6%9B%E0%A7%87-%E0%A6%9F%E0%A6%BF%E0%A6%86%E0%A6%87%E0%A6%AC%E0%A6%BF</guid>
      <pubDate>Wed, 25 Nov 2026 17:23:28 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/09/06/42586fe46c73cbbe4c00a6cc690c6840-6a9d7a465b5e8.jpg?jadewits_media_id=165885" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/09/06/42586fe46c73cbbe4c00a6cc690c6840-6a9d7a465b5e8.jpg?jadewits_media_id=165885" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/09/06/42586fe46c73cbbe4c00a6cc690c6840-6a9d7a465b5e8.jpg?jadewits_media_id=165885" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আবাসন খাতে সমন্বিত অনিয়ম চলছে: টিআইবি" /&gt;&lt;/p&gt;&lt;p&gt;রিহ্যাব, রিয়েল এস্টেট কোম্পানি, প্রশাসন এবং নিয়ন্ত্রক কর্তৃপক্ষ ও রাজনীতি সংশ্লিষ্ট প্রভাবশালীদের একাংশের সমন্বিত অনিয়মে আবাসন খাতে মাফিয়াতন্ত্র চলছে বলে জানিয়েছে টিআইবি। বুধবার এক গবেষণা প্রতিবেদন তুলে ধরে সংস্থাটির নির্বাহী পরিচালকের দাবি, এতে বাংলাদেশ প্রতারণা ও ভূমি অপদখলের দেশে পরিণত হচ্ছে।				&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/country/dhaka/278652/%E0%A6%86%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%A8-%E0%A6%96%E0%A6%BE%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%A4-%E0%A6%85%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A6%AE-%E0%A6%9A%E0%A6%B2%E0%A6%9B%E0%A7%87-%E0%A6%9F%E0%A6%BF%E0%A6%86%E0%A6%87%E0%A6%AC%E0%A6%BF">ইনডিপেনডেন্ট টিভি</source>

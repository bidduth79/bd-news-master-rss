    <item>
      <title>সাইবার অপরাধ প্রতিরোধের নামে যেন হয়রানি না হয়: এইচআরএসএস</title>
      <link>https://www.itvbd.com/science-tech/278268/%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%AA%E0%A6%B0%E0%A6%BE%E0%A6%A7-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%AF%E0%A7%87%E0%A6%A8-%E0%A6%B9%E0%A7%9F%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%A8%E0%A6%BE-%E0%A6%B9%E0%A7%9F</link>
      <guid isPermaLink="true">https://www.itvbd.com/science-tech/278268/%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%AA%E0%A6%B0%E0%A6%BE%E0%A6%A7-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%AF%E0%A7%87%E0%A6%A8-%E0%A6%B9%E0%A7%9F%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%A8%E0%A6%BE-%E0%A6%B9%E0%A7%9F</guid>
      <pubDate>Wed, 18 Nov 2026 22:21:45 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/08/22/967dfd73a8f48a6f446edd84a7fa5904-6a89b3685d11f.jpeg?jadewits_media_id=165363" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/08/22/967dfd73a8f48a6f446edd84a7fa5904-6a89b3685d11f.jpeg?jadewits_media_id=165363" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/08/22/967dfd73a8f48a6f446edd84a7fa5904-6a89b3685d11f.jpeg?jadewits_media_id=165363" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সাইবার অপরাধ প্রতিরোধের নামে যেন হয়রানি না হয়: এইচআরএসএস" /&gt;&lt;/p&gt;&lt;p&gt;সাইবার অপরাধ প্রতিরোধের নামে যেন ভিন্নমত দমন, সাংবাদিকতা নিয়ন্ত্রণ, নাগরিক হয়রানি কিংবা ব্যক্তিগত গোপনীয়তা লঙ্ঘন না হয়। তা নিশ্চিত করার তাগিদ দিয়েছে হিউম্যান রাইটস সাপোর্ট সোসাইটি বা এইচআরএসএস নামের একটি সংগঠন। বুধবার সকালে জাতীয় প্রেসক্লাবে আলোচনা সভায় এ আহ্বান জানান বক্তারা।   						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/science-tech/278268/%E0%A6%B8%E0%A6%BE%E0%A6%87%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%85%E0%A6%AA%E0%A6%B0%E0%A6%BE%E0%A6%A7-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B0%E0%A7%8B%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A7%87-%E0%A6%AF%E0%A7%87%E0%A6%A8-%E0%A6%B9%E0%A7%9F%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%A8%E0%A6%BE-%E0%A6%B9%E0%A7%9F">ইনডিপেনডেন্ট টিভি</source>

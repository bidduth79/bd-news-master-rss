    <item>
      <title>এপিসি থেকে ফেলে ইয়ামিনকে হত্যার বিচার শুরু</title>
      <link>https://www.itvbd.com/national/278453/%E0%A6%8F%E0%A6%AA%E0%A6%BF%E0%A6%B8%E0%A6%BF-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%87%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A6%BF%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81</link>
      <guid isPermaLink="true">https://www.itvbd.com/national/278453/%E0%A6%8F%E0%A6%AA%E0%A6%BF%E0%A6%B8%E0%A6%BF-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%87%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A6%BF%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81</guid>
      <pubDate>Sun, 22 Nov 2026 15:16:14 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/03/24/bf292dcfc98c8d4482f145736f81e669-67e0bd07ac162.jpg?jadewits_media_id=112275" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/03/24/bf292dcfc98c8d4482f145736f81e669-67e0bd07ac162.jpg?jadewits_media_id=112275" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/03/24/bf292dcfc98c8d4482f145736f81e669-67e0bd07ac162.jpg?jadewits_media_id=112275" style="max-width:100%;height:auto;margin-bottom:10px;" alt="এপিসি থেকে ফেলে ইয়ামিনকে হত্যার বিচার শুরু" /&gt;&lt;/p&gt;&lt;p&gt;জুলাই অভ্যুত্থান চলাকালীন ঢাকার সাভারে শিক্ষার্থী আসহাবুল ইয়ামিনকে এপিসি থেকে ফেলে হত্যার ঘটনায় মানবতাবিরোধী অপরাধের মামলায় অভিযোগ গঠন করে বিচার শুরুর আদেশ দিয়েছেন আন্তর্জাতিক অপরাধ ট্রাইব্যুনাল। সেইসঙ্গে এই মাসূচনা বক্তব্য ও প্রসিকিউশন পক্ষের সাক্ষ্য গ্রহণের জন্য আগামী ১৫ ডিসেম্বর দিন ধার্য করা হয়ে&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/national/278453/%E0%A6%8F%E0%A6%AA%E0%A6%BF%E0%A6%B8%E0%A6%BF-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AB%E0%A7%87%E0%A6%B2%E0%A7%87-%E0%A6%87%E0%A7%9F%E0%A6%BE%E0%A6%AE%E0%A6%BF%E0%A6%A8%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81">ইনডিপেনডেন্ট টিভি</source>

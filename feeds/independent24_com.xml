    <item>
      <title>ব্যবসার আড়ালে নানক ও শামীম ওসমান পরিবারের ৪৫৩ কোটি টাকা পাচার</title>
      <link>https://www.itvbd.com/politics/278258/%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A7%9C%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%A8%E0%A6%95-%E0%A6%93-%E0%A6%B6%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%AE-%E0%A6%93%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A7%AA%E0%A7%AB%E0%A7%A9-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.itvbd.com/politics/278258/%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A7%9C%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%A8%E0%A6%95-%E0%A6%93-%E0%A6%B6%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%AE-%E0%A6%93%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A7%AA%E0%A7%AB%E0%A7%A9-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF</guid>
      <pubDate>Wed, 18 Nov 2026 20:09:13 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/c1afaeb2f1cb61fbd786b43523242668-6afdb16d2e72c.jpg?jadewits_media_id=167984" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/c1afaeb2f1cb61fbd786b43523242668-6afdb16d2e72c.jpg?jadewits_media_id=167984" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/c1afaeb2f1cb61fbd786b43523242668-6afdb16d2e72c.jpg?jadewits_media_id=167984" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ব্যবসার আড়ালে নানক ও শামীম ওসমান পরিবারের ৪৫৩ কোটি টাকা পাচার" /&gt;&lt;/p&gt;&lt;p&gt;কার্যক্রম নিষিদ্ধ আওয়ামী লীগের দুই নেতা জাহাঙ্গীর কবির নানক ও শামীম ওসমানের বিরুদ্ধে টাকা পাচারের প্রমাণ পেয়েছে দুদক। সংস্থাটির অভিযোগ, টেলিকম ব্যবসার আড়ালে নানক ও শামীম ওসমানের পরিবার পাচার করেছে ৪৫৩ কোটি টাকা। এরই মধ্যে দুই পরিবারের ৯ জনের বিরুদ্ধে চার্জশিটে অনুমোদন দিয়েছে দুদক। 						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/politics/278258/%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A7%9C%E0%A6%BE%E0%A6%B2%E0%A7%87-%E0%A6%A8%E0%A6%BE%E0%A6%A8%E0%A6%95-%E0%A6%93-%E0%A6%B6%E0%A6%BE%E0%A6%AE%E0%A7%80%E0%A6%AE-%E0%A6%93%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A7%AA%E0%A7%AB%E0%A7%A9-%E0%A6%95%E0%A7%8B%E0%A6%9F%E0%A6%BF">ইনডিপেনডেন্ট টিভি</source>
    </item>
    <item>
      <title>দিনদুপুরে পুলিশের গাড়ি চুরি, উদ্ধার লাগল ৫ ঘণ্টা</title>
      <link>https://www.itvbd.com/country/chittagong/278257/%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A6%A6%E0%A7%81%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0-%E0%A6%B2%E0%A6%BE%E0%A6%97%E0%A6%B2-%E0%A7%AB-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE</link>
      <guid isPermaLink="true">https://www.itvbd.com/country/chittagong/278257/%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A6%A6%E0%A7%81%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0-%E0%A6%B2%E0%A6%BE%E0%A6%97%E0%A6%B2-%E0%A7%AB-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE</guid>
      <pubDate>Wed, 18 Nov 2026 20:05:28 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/42d2a86abd87bf14edcbbe6269ceaa03-6afdb0a3e8881.jpg?jadewits_media_id=167983" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/42d2a86abd87bf14edcbbe6269ceaa03-6afdb0a3e8881.jpg?jadewits_media_id=167983" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/42d2a86abd87bf14edcbbe6269ceaa03-6afdb0a3e8881.jpg?jadewits_media_id=167983" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দিনদুপুরে পুলিশের গাড়ি চুরি, উদ্ধার লাগল ৫ ঘণ্টা" /&gt;&lt;/p&gt;&lt;p&gt;চট্টগ্রামের হালিশহরে দিনদুপুরে পুলিশের টহলদলের পিকআপ চুরি করে নিয়ে গেছে চোর। আজ বুধবার দুপুরে পুলিশ সদস্যরা ভাত খাওয়ার সময় চুরি হয় এই পিকআপ। তবে চুরির ৫ ঘণ্টা পর বন্দর ফকিরহাট এলাকা থেকে পিকআপ ভ্যানটি উদ্ধার করে পুলিশ। এই চুরির সঙ্গে জড়িত ব্যক্তির স্ত্রীকে জিজ্ঞাসাবাদের জন্য থানায় নিয়ে যাওয়া হয়েছে।	&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/country/chittagong/278257/%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A6%A6%E0%A7%81%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B2%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%97%E0%A6%BE%E0%A7%9C%E0%A6%BF-%E0%A6%9A%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0-%E0%A6%B2%E0%A6%BE%E0%A6%97%E0%A6%B2-%E0%A7%AB-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE">ইনডিপেনডেন্ট টিভি</source>
    </item>
    <item>
      <title>ট্রাম্প-পুতিন-জিনপিংয়ের ঐতিহাসিক বৈঠক কাল, কী থাকছে আলোচনায়?</title>
      <link>https://www.itvbd.com/world/278256/%E0%A6%8F%E0%A6%AA%E0%A7%87%E0%A6%95-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AB%E0%A6%BE%E0%A6%81%E0%A6%95%E0%A7%87-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA-%E0%A6%AA%E0%A7%81%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%9C%E0%A6%BF%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%82-%E0%A6%90%E0%A6%A4%E0%A6%BF%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%95</link>
      <guid isPermaLink="true">https://www.itvbd.com/world/278256/%E0%A6%8F%E0%A6%AA%E0%A7%87%E0%A6%95-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AB%E0%A6%BE%E0%A6%81%E0%A6%95%E0%A7%87-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA-%E0%A6%AA%E0%A7%81%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%9C%E0%A6%BF%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%82-%E0%A6%90%E0%A6%A4%E0%A6%BF%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%95</guid>
      <pubDate>Wed, 18 Nov 2026 19:40:09 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/880aa764e2f84a1f4e9868dd43c6989d-6afda9dad8688.jpg?jadewits_media_id=167982" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/880aa764e2f84a1f4e9868dd43c6989d-6afda9dad8688.jpg?jadewits_media_id=167982" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/880aa764e2f84a1f4e9868dd43c6989d-6afda9dad8688.jpg?jadewits_media_id=167982" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ট্রাম্প-পুতিন-জিনপিংয়ের ঐতিহাসিক বৈঠক কাল, কী থাকছে আলোচনায়?" /&gt;&lt;/p&gt;&lt;p&gt;বিশ্ব বাণিজ্য ও বিনিয়োগে বাধা দূর করে অবাধ বাণিজ্য নিশ্চিত করার আহ্বান জানিয়েছেন চীনা প্রেসিডেন্ট শি জিনপিং। বুধবার শেনজেনে এপেক সম্মেলনের উদ্বোধনী বক্তব্যে এ আহ্বান জানান তিনি। একই আহ্বান রুশ প্রেসিডেন্ট ভ্লাদিমির পুতিনেরও। সম্মেলনের ফাঁকে সাইডলাইনে বৈঠক করেন জিনপিং ও পুতিন। 						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/world/278256/%E0%A6%8F%E0%A6%AA%E0%A7%87%E0%A6%95-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AB%E0%A6%BE%E0%A6%81%E0%A6%95%E0%A7%87-%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA-%E0%A6%AA%E0%A7%81%E0%A6%A4%E0%A6%BF%E0%A6%A8-%E0%A6%9C%E0%A6%BF%E0%A6%A8%E0%A6%AA%E0%A6%BF%E0%A6%82-%E0%A6%90%E0%A6%A4%E0%A6%BF%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%95">ইনডিপেনডেন্ট টিভি</source>
    </item>

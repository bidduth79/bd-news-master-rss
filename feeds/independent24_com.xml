    <item>
      <title>৮ হাজার চিকিৎসক-নার্স নিয়োগ দিচ্ছে সরকার</title>
      <link>https://www.itvbd.com/national/278160/%E0%A7%AE-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%9A%E0%A6%BF%E0%A6%95%E0%A6%BF%E0%A7%8E%E0%A6%B8%E0%A6%95-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B8-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%8B%E0%A6%97-%E0%A6%A6%E0%A6%BF%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.itvbd.com/national/278160/%E0%A7%AE-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%9A%E0%A6%BF%E0%A6%95%E0%A6%BF%E0%A7%8E%E0%A6%B8%E0%A6%95-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B8-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%8B%E0%A6%97-%E0%A6%A6%E0%A6%BF%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Mon, 16 Nov 2026 22:21:00 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/b99850e580f05961adc5adb9db9ec757-6afb2d5c0b761.jpeg?jadewits_media_id=167924" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/b99850e580f05961adc5adb9db9ec757-6afb2d5c0b761.jpeg?jadewits_media_id=167924" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/16/b99850e580f05961adc5adb9db9ec757-6afb2d5c0b761.jpeg?jadewits_media_id=167924" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৮ হাজার চিকিৎসক-নার্স নিয়োগ দিচ্ছে সরকার" /&gt;&lt;/p&gt;&lt;p&gt;দেশের স্বাস্থ্যসেবায় জনবল সংকট দূর করতে প্রায় চার হাজার চিকিৎসক এবং সমসংখ্যক সিনিয়র স্টাফ নার্স ও নার্সিং কর্মী নিয়োগের প্রক্রিয়া শুরু করেছে সরকার। পাশাপাশি দেশের ৫০৩টি উপজেলায় ১৫১ শয্যাবিশিষ্ট নতুন হাসপাতাল নির্মাণের উদ্যোগ নেওয়া হয়েছে।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/national/278160/%E0%A7%AE-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%9A%E0%A6%BF%E0%A6%95%E0%A6%BF%E0%A7%8E%E0%A6%B8%E0%A6%95-%E0%A6%A8%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%B8-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%8B%E0%A6%97-%E0%A6%A6%E0%A6%BF%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A6%B8%E0%A6%B0%E0%A6%95%E0%A6%BE%E0%A6%B0">ইনডিপেনডেন্ট টিভি</source>

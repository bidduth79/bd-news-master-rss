      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/bb6435cd3bdeb462a9259bbe215ca63f-6b02c96aa1845.jpg?jadewits_media_id=168103" medium="image" />

    <item>
      <title>ট্রাম্পের উদ্যোগে এনভিডিয়ার সিইও পদে ফিরলেন জেনসেন হুয়াং</title>
      <link>https://www.itvbd.com/world/america/278555/%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A7%87%E0%A6%B0-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%87-%E0%A6%8F%E0%A6%A8%E0%A6%AD%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BF%E0%A6%87%E0%A6%93-%E0%A6%AA%E0%A6%A6%E0%A7%87-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A6%B8%E0%A7%87%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.itvbd.com/world/america/278555/%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A7%87%E0%A6%B0-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A7%87-%E0%A6%8F%E0%A6%A8%E0%A6%AD%E0%A6%BF%E0%A6%A1%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BF%E0%A6%87%E0%A6%93-%E0%A6%AA%E0%A6%A6%E0%A7%87-%E0%A6%AB%E0%A6%BF%E0%A6%B0%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%9C%E0%A7%87%E0%A6%A8%E0%A6%B8%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Tue, 24 Nov 2026 08:36:34 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/dd0ed40a17f7e11752093fd38aabe5f5-6b04f80e8f2a5.jpg?jadewits_media_id=168153" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/dd0ed40a17f7e11752093fd38aabe5f5-6b04f80e8f2a5.jpg?jadewits_media_id=168153" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/24/dd0ed40a17f7e11752093fd38aabe5f5-6b04f80e8f2a5.jpg?jadewits_media_id=168153" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ট্রাম্পের উদ্যোগে এনভিডিয়ার সিইও পদে ফিরলেন জেনসেন হুয়াং" /&gt;&lt;/p&gt;&lt;p&gt;মার্কিন বহুজাতিক প্রযুক্তি প্রতিষ্ঠান এনভিডিয়ার সিইও পদে জেনসেন হুয়াংকে পুনর্বহালে পরিচালনা পর্ষদকে রাজি করিয়েছেন মার্কিন প্রেসিডেন্ট। সোমবার, ডোনাল্ড ট্রাম্প নিজেই বিষয়টি নিশ্চিত করেন।						বিস্তারিত&lt;/p&gt;</description>

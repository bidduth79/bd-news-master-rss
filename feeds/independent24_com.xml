      <guid isPermaLink="true">https://www.itvbd.com/science-tech/278264/%E0%A6%A8%E0%A6%BE%E0%A6%B8%E0%A6%BE-%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A7%87%E0%A6%B8-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AA%E0%A6%B8-%E0%A6%9A%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Wed, 18 Nov 2026 20:49:19 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/3cddcf252be578613fe8ccd3ee2cd7dd-6afdbada7920a.jpg?jadewits_media_id=167988" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/3cddcf252be578613fe8ccd3ee2cd7dd-6afdbada7920a.jpg?jadewits_media_id=167988" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/18/3cddcf252be578613fe8ccd3ee2cd7dd-6afdbada7920a.jpg?jadewits_media_id=167988" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নাসা স্পেস অ্যাপস চ্যালেঞ্জের বাংলাদেশ পর্বের সমাপনী অনুষ্ঠিত" /&gt;&lt;/p&gt;&lt;p&gt;নয়টি শহরে আয়োজিত নাসা স্পেস অ্যাপস চ্যালেঞ্জ ২০২৬-এর বাংলাদেশ পর্বের সমাপনী অনুষ্ঠান অনুষ্ঠিত হয়েছে। গতকাল মঙ্গলবার রাজধানীর আমেরিকান ইন্টারন্যাশনাল ইউনিভার্সিটি-বাংলাদেশের (এআইইউবি) মিলনায়তনে এ অনুষ্ঠানের আয়োজন করা হয়। এতে প্রতিযোগিতার বিভিন্ন পর্যায়ে অংশ নেওয়া দলগুলোর সাফল্য ও উদ্ভাবনী উদ্যোগের স্&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/science-tech/278264/%E0%A6%A8%E0%A6%BE%E0%A6%B8%E0%A6%BE-%E0%A6%B8%E0%A7%8D%E0%A6%AA%E0%A7%87%E0%A6%B8-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AA%E0%A6%B8-%E0%A6%9A%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AC%E0%A7%87%E0%A6%B0">ইনডিপেনডেন্ট টিভি</source>

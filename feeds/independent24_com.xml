    <item>
      <title>ঢাবির জগন্নাথ হলে নির্মিত হচ্ছে ৩০ ফুটের সরস্বতী প্রতিমা</title>
      <link>https://www.itvbd.com/country/dhaka/277813/%E0%A6%A2%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%9C%E0%A6%97%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A6%BE%E0%A6%A5-%E0%A6%B9%E0%A6%B2%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%BF%E0%A6%A4-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A7%A9%E0%A7%A6-%E0%A6%AB%E0%A7%81%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%A4%E0%A7%80</link>
      <guid isPermaLink="true">https://www.itvbd.com/country/dhaka/277813/%E0%A6%A2%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%9C%E0%A6%97%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A6%BE%E0%A6%A5-%E0%A6%B9%E0%A6%B2%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%BF%E0%A6%A4-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A7%A9%E0%A7%A6-%E0%A6%AB%E0%A7%81%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%A4%E0%A7%80</guid>
      <pubDate>Mon, 09 Nov 2026 21:37:30 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/383b31aa38f888ac538c1fd192dd8003-6af1e8a8eca9e.jpg?jadewits_media_id=167698" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/383b31aa38f888ac538c1fd192dd8003-6af1e8a8eca9e.jpg?jadewits_media_id=167698" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/383b31aa38f888ac538c1fd192dd8003-6af1e8a8eca9e.jpg?jadewits_media_id=167698" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ঢাবির জগন্নাথ হলে নির্মিত হচ্ছে ৩০ ফুটের সরস্বতী প্রতিমা" /&gt;&lt;/p&gt;&lt;p&gt;বিশ্বের সবচেয়ে বড় স্থায়ী সরস্বতী প্রতিমা নির্মাণের উদ্যোগ নিয়েছে ঢাকা বিশ্ববিদ্যালয়ের (ঢাবি) জগন্নাথ হল কর্তৃপক্ষ। ৩০ ফুট উচ্চতার কংক্রিটের এই প্রতিমা নির্মাণ করা হবে হলের রবীন্দ্র ভবনের পূর্বাংশে। নির্মাণকাজ শেষ হলে এটি বিশ্বের সবচেয়ে বড় স্থায়ী সরস্বতী প্রতিমা হবে বলে আশা করছে হল প্রশাসন। এ উদ্যোগে&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/country/dhaka/277813/%E0%A6%A2%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%B0-%E0%A6%9C%E0%A6%97%E0%A6%A8%E0%A7%8D%E0%A6%A8%E0%A6%BE%E0%A6%A5-%E0%A6%B9%E0%A6%B2%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%BF%E0%A6%A4-%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87-%E0%A7%A9%E0%A7%A6-%E0%A6%AB%E0%A7%81%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%B0%E0%A6%B8%E0%A7%8D%E0%A6%AC%E0%A6%A4%E0%A7%80">ইনডিপেনডেন্ট টিভি</source>
    </item>

      <guid isPermaLink="true">https://www.itvbd.com/national/278265/%E0%A6%86%E0%A6%87%E0%A6%B8%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A7%8B%E0%A6%B7%E0%A7%80-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%B8%E0%A7%8D%E0%A6%A4-%E0%A6%B9%E0%A6%B2%E0%A7%87-%E0%A6%AF%E0%A6%BE-%E0%A6%AF%E0%A6%BE-%E0%A6%98%E0%A6%9F%E0%A6%AC%E0%A7%87</guid>
      <pubDate>Wed, 18 Nov 2026 21:49:45 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/05/24/b11a82cc36e257977586a359e6e795b5-6650a9da7e09d.jpg?jadewits_media_id=55985" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/05/24/b11a82cc36e257977586a359e6e795b5-6650a9da7e09d.jpg?jadewits_media_id=55985" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/05/24/b11a82cc36e257977586a359e6e795b5-6650a9da7e09d.jpg?jadewits_media_id=55985" style="max-width:100%;height:auto;margin-bottom:10px;" alt="আইসিজের রায়ে মিয়ানমার দোষী সাব্যস্ত হলে যা ঘটতে পারে" /&gt;&lt;/p&gt;&lt;p&gt;মিয়ানমারের বিরুদ্ধে রোহিঙ্গা গণহত্যা মামলার রায় দিতে যাচ্ছেন আন্তর্জাতিক বিচার আদালত–আইসিজে। বৃহস্পতিবারের রায়ে দেশটি দোষী সাব্যস্ত হলে, আসতে পারে আন্তর্জাতিক চাপসহ নানা পদক্ষেপ। একই সঙ্গে রোহিঙ্গাদের ন্যায়বিচার ও নিরাপদ প্রত্যাবাসনে তৈরি হতে পারে নতুন সম্ভাবনা।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/national/278265/%E0%A6%86%E0%A6%87%E0%A6%B8%E0%A6%BF%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%B0%E0%A6%BE%E0%A7%9F%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A7%8B%E0%A6%B7%E0%A7%80-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%B8%E0%A7%8D%E0%A6%A4-%E0%A6%B9%E0%A6%B2%E0%A7%87-%E0%A6%AF%E0%A6%BE-%E0%A6%AF%E0%A6%BE-%E0%A6%98%E0%A6%9F%E0%A6%AC%E0%A7%87">ইনডিপেনডেন্ট টিভি</source>

    <item>
      <title>পদ্মা সেতুর এক্সপ্রেসওয়েতে দুর্ঘটনা বাড়ছে, চার বছরে মৃত্যু ১৭১</title>
      <link>https://www.itvbd.com/country/dhaka/278771/%E0%A6%AA%E0%A6%A6%E0%A7%8D%E0%A6%AE%E0%A6%BE-%E0%A6%B8%E0%A7%87%E0%A6%A4%E0%A7%81%E0%A6%B0-%E0%A6%8F%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B8%E0%A6%93%E0%A7%9F%E0%A7%87%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%9B%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.itvbd.com/country/dhaka/278771/%E0%A6%AA%E0%A6%A6%E0%A7%8D%E0%A6%AE%E0%A6%BE-%E0%A6%B8%E0%A7%87%E0%A6%A4%E0%A7%81%E0%A6%B0-%E0%A6%8F%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B8%E0%A6%93%E0%A7%9F%E0%A7%87%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%9B%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Sat, 28 Nov 2026 09:52:02 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/006d29c3e6d5678e2e9f1c27f4a8fb2b-6b0a4fcebbf18.jpg?jadewits_media_id=168277" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/006d29c3e6d5678e2e9f1c27f4a8fb2b-6b0a4fcebbf18.jpg?jadewits_media_id=168277" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/006d29c3e6d5678e2e9f1c27f4a8fb2b-6b0a4fcebbf18.jpg?jadewits_media_id=168277" style="max-width:100%;height:auto;margin-bottom:10px;" alt="পদ্মা সেতুর এক্সপ্রেসওয়েতে দুর্ঘটনা বাড়ছে, চার বছরে মৃত্যু ১৭১" /&gt;&lt;/p&gt;&lt;p&gt;শরীয়তপুর-ভাঙ্গা এক্সপ্রেসওয়েতে প্রতিনিয়ত ঘটছে দুর্ঘটনা। গত চার বছরে এই সড়কে প্রাণ গেছে ১৭১ জনের। হাইওয়ে পুলিশ বলছে, যানবাহনের বেপরোয়া গতি, সড়কের মাঝখানে গাড়ি রেখে যাত্রী ওঠানামা এবং চালকের অদক্ষতার কারণে বাড়ছে দুর্ঘটনা। তবে দুর্ঘটনা রোধে সড়কে ২৪ ঘণ্টা কাজ করছে আইনশৃঙ্খলা বাহিনী।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/country/dhaka/278771/%E0%A6%AA%E0%A6%A6%E0%A7%8D%E0%A6%AE%E0%A6%BE-%E0%A6%B8%E0%A7%87%E0%A6%A4%E0%A7%81%E0%A6%B0-%E0%A6%8F%E0%A6%95%E0%A7%8D%E0%A6%B8%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B8%E0%A6%93%E0%A7%9F%E0%A7%87%E0%A6%A4%E0%A7%87-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A7%9C%E0%A6%9B%E0%A7%87-%E0%A6%9A%E0%A6%BE%E0%A6%B0">ইনডিপেনডেন্ট টিভি</source>

      <guid isPermaLink="true">https://www.itvbd.com/country/dhaka/278299/%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A6%BE-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%A6%E0%A6%BF%E0%A6%95-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95</guid>
      <pubDate>Thu, 19 Nov 2026 17:10:07 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/da7156b0fe23b59ccd7ebea8fe43e81e-6afea0ec92933.jpg?jadewits_media_id=168002" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/da7156b0fe23b59ccd7ebea8fe43e81e-6afea0ec92933.jpg?jadewits_media_id=168002" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/da7156b0fe23b59ccd7ebea8fe43e81e-6afea0ec92933.jpg?jadewits_media_id=168002" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মাদরাসা ছাত্র সাদিক হত্যা মামলায় সাবেক শিক্ষামন্ত্রী নাহিদ কারাগারে" /&gt;&lt;/p&gt;&lt;p&gt;শেখ হাসিনা সরকারের সাবেক শিক্ষামন্ত্রী নুরুল ইসলাম নাহিদকে জুলাই গণঅভ্যুত্থানের সময় মাদরাসার শিক্ষার্থী সাদিকুল ইসলাম হত্যা মামলায় কারাগার পাঠানোর আদেশ দিয়েছেন আদালত। বৃহস্পতিবার বিকেলে ঢাকার মেট্রোপলিটন ম্যাজিস্ট্রেট মো. রিপন হোসেনের আদালত এই আদেশ দেন। 						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/country/dhaka/278299/%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A6%B0%E0%A6%BE%E0%A6%B8%E0%A6%BE-%E0%A6%9B%E0%A6%BE%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%A6%E0%A6%BF%E0%A6%95-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A6%B8%E0%A6%BE%E0%A6%AC%E0%A7%87%E0%A6%95">ইনডিপেনডেন্ট টিভি</source>
    </item>
    <item>
      <title>রোহিঙ্গাদের ওপর গণহত্যা চালিয়েছে মিয়ানমারের বাহিনী: আইসিজে</title>
      <link>https://www.itvbd.com/world/278298/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%97%E0%A6%A3%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.itvbd.com/world/278298/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%97%E0%A6%A3%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Thu, 19 Nov 2026 17:01:37 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/6a5f88be8341f97a8212cadc04c307a8-6afed70eb300f.jpg?jadewits_media_id=168011" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/6a5f88be8341f97a8212cadc04c307a8-6afed70eb300f.jpg?jadewits_media_id=168011" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/19/6a5f88be8341f97a8212cadc04c307a8-6afed70eb300f.jpg?jadewits_media_id=168011" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রোহিঙ্গাদের ওপর গণহত্যা চালিয়েছে মিয়ানমারের বাহিনী: আইসিজে" /&gt;&lt;/p&gt;&lt;p&gt;মিয়ানমারের নিরাপত্তা বাহিনী সংখ্যালঘু মুসলিম রোহিঙ্গা জনগোষ্ঠীর হাজার হাজার সদস্যকে হত্যা করেছে এবং যৌন সহিংসতা চালিয়েছে বলে রায় দিয়েছেন জাতিসংঘের সর্বোচ্চ আদালত আন্তর্জাতিক বিচার আদালত–আইসিজে। বৃহস্পতিবার নেদারল্যান্ডসের দ্য হেগে গাম্বিয়ার করা গণহত্যার মামলায় এ রায় ঘোষণা শুরু করেন আদালত।						বিস্ত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/world/278298/%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%97%E0%A6%A3%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%AE%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0">ইনডিপেনডেন্ট টিভি</source>

    <item>
      <title>৯ দিনের সিনেমা-উৎসব, দোহায় শেষ হলো গল্পের মহাযাত্রা</title>
      <link>https://www.itvbd.com/entertainment/dakshini-and-others/278775/%E0%A6%A8%E0%A7%9F-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%AE%E0%A6%BE-%E0%A6%89%E0%A7%8E%E0%A6%B8%E0%A6%AC-%E0%A6%A6%E0%A7%8B%E0%A6%B9%E0%A6%BE%E0%A7%9F-%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%B9%E0%A6%B2%E0%A7%8B-%E0%A6%97%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.itvbd.com/entertainment/dakshini-and-others/278775/%E0%A6%A8%E0%A7%9F-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%AE%E0%A6%BE-%E0%A6%89%E0%A7%8E%E0%A6%B8%E0%A6%AC-%E0%A6%A6%E0%A7%8B%E0%A6%B9%E0%A6%BE%E0%A7%9F-%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%B9%E0%A6%B2%E0%A7%8B-%E0%A6%97%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Sat, 28 Nov 2026 12:52:15 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/5df1e1cbc0743bc9fd517439f8a3a00d-6b0a71252183d.jpeg?jadewits_media_id=168280" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/5df1e1cbc0743bc9fd517439f8a3a00d-6b0a71252183d.jpeg?jadewits_media_id=168280" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/5df1e1cbc0743bc9fd517439f8a3a00d-6b0a71252183d.jpeg?jadewits_media_id=168280" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৯ দিনের সিনেমা-উৎসব, দোহায় শেষ হলো গল্পের মহাযাত্রা" /&gt;&lt;/p&gt;&lt;p&gt;নয় দিন ধরে বিশ্বের বিভিন্ন দেশের চলচ্চিত্র নির্মাতা, অভিনয়শিল্পী ও সংস্কৃতিকর্মীদের পদচারণায় মুখর ছিল কাতারের দোহা। চলচ্চিত্র প্রদর্শনী, আলোচনা ও নানা সাংস্কৃতিক আয়োজন শেষে পর্দা নামল দোহা চলচ্চিত্র উৎসব ২০২৬-এর। শুক্রবার (২৭ নভেম্বর) সমাপনী ও পুরস্কার বিতরণী অনুষ্ঠানের মধ্য দিয়ে শেষ হয় এবারের আসর।
&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/entertainment/dakshini-and-others/278775/%E0%A6%A8%E0%A7%9F-%E0%A6%A6%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A7%87%E0%A6%AE%E0%A6%BE-%E0%A6%89%E0%A7%8E%E0%A6%B8%E0%A6%AC-%E0%A6%A6%E0%A7%8B%E0%A6%B9%E0%A6%BE%E0%A7%9F-%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%B9%E0%A6%B2%E0%A7%8B-%E0%A6%97%E0%A6%B2%E0%A7%8D%E0%A6%AA%E0%A7%87%E0%A6%B0">ইনডিপেনডেন্ট টিভি</source>
    </item>

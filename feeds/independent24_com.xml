      <title>সমঝোতা না হলে চুক্তি ছাড়াই শেষ হবে কপ-৩১: ইইউ কমিশনার</title>
      <link>https://www.itvbd.com/world/europe/278430/%E0%A6%B8%E0%A6%AE%E0%A6%9D%E0%A7%8B%E0%A6%A4%E0%A6%BE-%E0%A6%A8%E0%A6%BE-%E0%A6%B9%E0%A6%B2%E0%A7%87-%E0%A6%9A%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%87-%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%B9%E0%A6%AC%E0%A7%87-%E0%A6%95%E0%A6%AA-%E0%A7%A9%E0%A7%A7-%E0%A6%87%E0%A6%87%E0%A6%89</link>
      <guid isPermaLink="true">https://www.itvbd.com/world/europe/278430/%E0%A6%B8%E0%A6%AE%E0%A6%9D%E0%A7%8B%E0%A6%A4%E0%A6%BE-%E0%A6%A8%E0%A6%BE-%E0%A6%B9%E0%A6%B2%E0%A7%87-%E0%A6%9A%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%87-%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%B9%E0%A6%AC%E0%A7%87-%E0%A6%95%E0%A6%AA-%E0%A7%A9%E0%A7%A7-%E0%A6%87%E0%A6%87%E0%A6%89</guid>
      <pubDate>Sun, 22 Nov 2026 08:20:49 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/683b5f5c2187a7e8332f4a26c1c8cd6a-6b02513d57407.jpg?jadewits_media_id=168080" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/683b5f5c2187a7e8332f4a26c1c8cd6a-6b02513d57407.jpg?jadewits_media_id=168080" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/683b5f5c2187a7e8332f4a26c1c8cd6a-6b02513d57407.jpg?jadewits_media_id=168080" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সমঝোতা না হলে চুক্তি ছাড়াই শেষ হবে কপ-৩১: ইইউ কমিশনার" /&gt;&lt;/p&gt;&lt;p&gt;নির্ধারিত সময় পেরিয়ে গেলেও চূড়ান্ত চুক্তিতে পৌঁছাতে পারেনি কপ-৩১ সম্মেলন। প্রয়োজনীয় সমঝোতা না হলে চুক্তি ছাড়াই সম্মেলন শেষ হতে পারে বলে সতর্ক করেছেন ইউরোপীয় ইউনিয়নের জলবায়ু বিষয়ক কমিশনার ভপকে হুকস্ট্রা।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/world/europe/278430/%E0%A6%B8%E0%A6%AE%E0%A6%9D%E0%A7%8B%E0%A6%A4%E0%A6%BE-%E0%A6%A8%E0%A6%BE-%E0%A6%B9%E0%A6%B2%E0%A7%87-%E0%A6%9A%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%87-%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%B9%E0%A6%AC%E0%A7%87-%E0%A6%95%E0%A6%AA-%E0%A7%A9%E0%A7%A7-%E0%A6%87%E0%A6%87%E0%A6%89">ইনডিপেনডেন্ট টিভি</source>
    </item>
    <item>
      <title>বাহরাইনে মার্কিন ঘাঁটিতে হামলার দাবি আইআরজিসির</title>
      <link>https://www.itvbd.com/world/middle-east/278429/%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%B0%E0%A6%BE%E0%A6%87%E0%A6%A8%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8-%E0%A6%98%E0%A6%BE%E0%A6%81%E0%A6%9F%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF-%E0%A6%86%E0%A6%87%E0%A6%86%E0%A6%B0%E0%A6%9C%E0%A6%BF%E0%A6%B8%E0%A6%BF%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.itvbd.com/world/middle-east/278429/%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%B0%E0%A6%BE%E0%A6%87%E0%A6%A8%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8-%E0%A6%98%E0%A6%BE%E0%A6%81%E0%A6%9F%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF-%E0%A6%86%E0%A6%87%E0%A6%86%E0%A6%B0%E0%A6%9C%E0%A6%BF%E0%A6%B8%E0%A6%BF%E0%A6%B0</guid>
      <pubDate>Sun, 22 Nov 2026 07:58:41 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/9499e0ad6508887c6aa85e7e975ec0e6-6b024c44af25e.jpg?jadewits_media_id=168079" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/9499e0ad6508887c6aa85e7e975ec0e6-6b024c44af25e.jpg?jadewits_media_id=168079" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/9499e0ad6508887c6aa85e7e975ec0e6-6b024c44af25e.jpg?jadewits_media_id=168079" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বাহরাইনে মার্কিন ঘাঁটিতে হামলার দাবি আইআরজিসির" /&gt;&lt;/p&gt;&lt;p&gt;বাহরাইনে নতুন করে আবারও হামলা চালিয়েছে ইরানের ইসলামিক বিপ্লবী গার্ড (আইআরজিসি)। মার্কিনিদের দুটি ঘাঁটিতে থাকা আকাশ প্রতিরক্ষা ব্যবস্থা লক্ষ্য করে হামলা চালানো হয়েছে বলে দাবি সংগঠনটির। বাহরাইনের স্বরাষ্ট্র মন্ত্রণালয় ইরানের বিরুদ্ধে একটি বেসামরিক বাণিজ্যিক অবকাঠামোতে হামলার অভিযোগ করেছে।						বিস্তা&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/world/middle-east/278429/%E0%A6%AC%E0%A6%BE%E0%A6%B9%E0%A6%B0%E0%A6%BE%E0%A6%87%E0%A6%A8%E0%A7%87-%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A6%BF%E0%A6%A8-%E0%A6%98%E0%A6%BE%E0%A6%81%E0%A6%9F%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%B9%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AC%E0%A6%BF-%E0%A6%86%E0%A6%87%E0%A6%86%E0%A6%B0%E0%A6%9C%E0%A6%BF%E0%A6%B8%E0%A6%BF%E0%A6%B0">ইনডিপেনডেন্ট টিভি</source>
    </item>
    <item>
      <title>দোহায় চার ‘আরব রাইজিং স্টার’, আলোচনায় নতুন প্রজন্মের সিনেমা</title>
      <link>https://www.itvbd.com/entertainment/dakshini-and-others/278428/%E0%A6%A6%E0%A7%8B%E0%A6%B9%E0%A6%BE%E0%A7%9F-%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E2%80%98%E0%A6%86%E0%A6%B0%E0%A6%AC-%E0%A6%B0%E0%A6%BE%E0%A6%87%E0%A6%9C%E0%A6%BF%E0%A6%82-%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0%E2%80%99-%E0%A6%86%E0%A6%B2%E0%A7%8B%E0%A6%9A%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.itvbd.com/entertainment/dakshini-and-others/278428/%E0%A6%A6%E0%A7%8B%E0%A6%B9%E0%A6%BE%E0%A7%9F-%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E2%80%98%E0%A6%86%E0%A6%B0%E0%A6%AC-%E0%A6%B0%E0%A6%BE%E0%A6%87%E0%A6%9C%E0%A6%BF%E0%A6%82-%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0%E2%80%99-%E0%A6%86%E0%A6%B2%E0%A7%8B%E0%A6%9A%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8</guid>
      <pubDate>Sun, 22 Nov 2026 01:56:11 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/296b377fcc434ec58e22495b968d8514-6b01f486f12e4.jpeg?jadewits_media_id=168077" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/296b377fcc434ec58e22495b968d8514-6b01f486f12e4.jpeg?jadewits_media_id=168077" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/296b377fcc434ec58e22495b968d8514-6b01f486f12e4.jpeg?jadewits_media_id=168077" style="max-width:100%;height:auto;margin-bottom:10px;" alt="দোহায় চার ‘আরব রাইজিং স্টার’, আলোচনায় নতুন প্রজন্মের সিনেমা" /&gt;&lt;/p&gt;&lt;p&gt;দোহা চলচ্চিত্র উৎসবের (ডিএফএফ) ২০২৬ আসরে প্রথমবারের মতো দেওয়া হলো &amp;lsquo;আরব রাইজিং স্টারস&amp;rsquo; সম্মাননা। আন্তর্জাতিক চলচ্চিত্রবিষয়ক সাময়িকী স্ক্রিন ইন্টারন্যাশনালের উদ্যোগে এই স্বীকৃতি পেয়েছেন আরব বিশ্বের চার উদীয়মান প্রতিভা। তাঁরা হলেন কাতারের নির্মাতা নাদিয়া আল-খাতের, ইরাকি-কুর্দি অভিনেত্রী আভা&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/entertainment/dakshini-and-others/278428/%E0%A6%A6%E0%A7%8B%E0%A6%B9%E0%A6%BE%E0%A7%9F-%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E2%80%98%E0%A6%86%E0%A6%B0%E0%A6%AC-%E0%A6%B0%E0%A6%BE%E0%A6%87%E0%A6%9C%E0%A6%BF%E0%A6%82-%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0%E2%80%99-%E0%A6%86%E0%A6%B2%E0%A7%8B%E0%A6%9A%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8">ইনডিপেনডেন্ট টিভি</source>
    </item>
    <item>
      <title>শিল্প কোনো বিলাসিতা নয়, মানুষের মৌলিক প্রয়োজন: নন্দিতা দাস</title>
      <link>https://www.itvbd.com/entertainment/dakshini-and-others/278426/%E2%80%98%E0%A6%B6%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%AA-%E0%A6%95%E0%A7%8B%E0%A6%A8%E0%A7%8B-%E0%A6%AC%E0%A6%BF%E0%A6%B2%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A4%E0%A6%BE-%E0%A6%A8%E0%A7%9F-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%8C%E0%A6%B2%E0%A6%BF%E0%A6%95-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%9F%E0%A7%8B%E0%A6%9C%E0%A6%A8%E2%80%99</link>
      <guid isPermaLink="true">https://www.itvbd.com/entertainment/dakshini-and-others/278426/%E2%80%98%E0%A6%B6%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%AA-%E0%A6%95%E0%A7%8B%E0%A6%A8%E0%A7%8B-%E0%A6%AC%E0%A6%BF%E0%A6%B2%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A4%E0%A6%BE-%E0%A6%A8%E0%A7%9F-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%8C%E0%A6%B2%E0%A6%BF%E0%A6%95-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%9F%E0%A7%8B%E0%A6%9C%E0%A6%A8%E2%80%99</guid>
      <pubDate>Sun, 22 Nov 2026 01:49:34 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/98dcede585e3aa7ce6473f8df00f1e21-6b01f4878dcf1.jpg?jadewits_media_id=168078" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/98dcede585e3aa7ce6473f8df00f1e21-6b01f4878dcf1.jpg?jadewits_media_id=168078" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/98dcede585e3aa7ce6473f8df00f1e21-6b01f4878dcf1.jpg?jadewits_media_id=168078" style="max-width:100%;height:auto;margin-bottom:10px;" alt="শিল্প কোনো বিলাসিতা নয়, মানুষের মৌলিক প্রয়োজন: নন্দিতা দাস" /&gt;&lt;/p&gt;&lt;p&gt;‘শিল্প কোনো বিলাসিতা নয়। এটি মানুষের মৌলিক প্রয়োজন'- দোহা চলচ্চিত্র উৎসবে এমন মন্তব্য করেছেন ভারতের অভিনেত্রী ও নির্মাতা নন্দিতা দাস। তাঁর মতে, সংঘাত, সহিংসতা ও বিদ্বেষে ভরা বর্তমান বিশ্বে সিনেমার দায়িত্ব আগের যেকোনো সময়ের চেয়ে বেশি।
দোহা চলচ্চিত্র উৎসবের ২০২৬ আসরে ‘ক্রিয়েটিভ এক্সেলেন্স অ্যাওয়ার্ড’ &lt;/p&gt;</description>
      <source url="https://www.itvbd.com/entertainment/dakshini-and-others/278426/%E2%80%98%E0%A6%B6%E0%A6%BF%E0%A6%B2%E0%A7%8D%E0%A6%AA-%E0%A6%95%E0%A7%8B%E0%A6%A8%E0%A7%8B-%E0%A6%AC%E0%A6%BF%E0%A6%B2%E0%A6%BE%E0%A6%B8%E0%A6%BF%E0%A6%A4%E0%A6%BE-%E0%A6%A8%E0%A7%9F-%E0%A6%AE%E0%A6%BE%E0%A6%A8%E0%A7%81%E0%A6%B7%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A7%8C%E0%A6%B2%E0%A6%BF%E0%A6%95-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%9F%E0%A7%8B%E0%A6%9C%E0%A6%A8%E2%80%99">ইনডিপেনডেন্ট টিভি</source>

    <item>
      <title>নবীন বিসিএস কর্মকর্তাদের সততার কাজের আহ্বান প্রধানমন্ত্রীর</title>
      <link>https://www.itvbd.com/national/277755/%E0%A6%A8%E0%A6%AC%E0%A7%80%E0%A6%A8-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A6%BF%E0%A6%8F%E0%A6%B8-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%A4%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%B9%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.itvbd.com/national/277755/%E0%A6%A8%E0%A6%AC%E0%A7%80%E0%A6%A8-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A6%BF%E0%A6%8F%E0%A6%B8-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%A4%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%B9%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%A8</guid>
      <pubDate>Sun, 08 Nov 2026 22:18:16 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/cfe1a757f33d54e5d7687b0149535ab9-6af0a095ad14b.jpg?jadewits_media_id=167661" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/cfe1a757f33d54e5d7687b0149535ab9-6af0a095ad14b.jpg?jadewits_media_id=167661" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/cfe1a757f33d54e5d7687b0149535ab9-6af0a095ad14b.jpg?jadewits_media_id=167661" style="max-width:100%;height:auto;margin-bottom:10px;" alt="নবীন বিসিএস কর্মকর্তাদের সততার কাজের আহ্বান প্রধানমন্ত্রীর" /&gt;&lt;/p&gt;&lt;p&gt;প্রধানমন্ত্রী তারেক রহমান নবীন বিসিএস কর্মকর্তাদের সততা, দক্ষতা ও মানবিক মূল্যবোধের সঙ্গে জনগণের সেবা করার আহ্বান জানিয়েছেন।

তিনি বলেন, ‘একজন সরকারি কর্মকর্তা হিসেবে আপনাদের কাছে জনগণ শুধু আদেশ-নির্দেশ নয়, মানবিকতাও আশা করে। সরকারি সেবা নিতে গিয়ে কোনো নাগরিক যেন হয়রানির শিকার না হন, তা কর্মকর্তাদের&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/national/277755/%E0%A6%A8%E0%A6%AC%E0%A7%80%E0%A6%A8-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A6%BF%E0%A6%8F%E0%A6%B8-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%A4%E0%A6%A4%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A6%BE%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%B9%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%A8">ইনডিপেনডেন্ট টিভি</source>
    </item>
    <item>
      <title>রাজধানীতে একাধিক স্থানে ককটেল বিস্ফোরণ, বাসে আগুন</title>
      <link>https://www.itvbd.com/country/dhaka/277754/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A6%BE%E0%A6%A7%E0%A6%BF%E0%A6%95-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.itvbd.com/country/dhaka/277754/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%8F%E0%A6%95%E0%A6%BE%E0%A6%A7%E0%A6%BF%E0%A6%95-%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%A8%E0%A7%87-%E0%A6%95%E0%A6%95%E0%A6%9F%E0%A7%87%E0%A6%B2-%E0%A6%AC%E0%A6%BF%E0%A6%B8%E0%A7%8D%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A6%A3-%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A7%87-%E0%A6%86%E0%A6%97%E0%A7%81%E0%A6%A8</guid>
      <pubDate>Sun, 08 Nov 2026 21:21:45 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/6704a57b9a69f5c5f51f03a96258c2c9-6af0932407596.jpg?jadewits_media_id=167660" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/6704a57b9a69f5c5f51f03a96258c2c9-6af0932407596.jpg?jadewits_media_id=167660" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/08/6704a57b9a69f5c5f51f03a96258c2c9-6af0932407596.jpg?jadewits_media_id=167660" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রাজধানীতে একাধিক স্থানে ককটেল বিস্ফোরণ, বাসে আগুন" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর একাধিক স্থানে ককটেল বিস্ফোরণের ঘটনা ঘটেছে। এ ছাড়া ১০০ ফিট এলাকায় ভাটারা থানার সামনে একটি বাসে আগুন দিয়েছে দুর্বৃত্তরা। রোববার সন্ধ্যায় এসব ঘটনা ঘটে।						বিস্তারিত&lt;/p&gt;</description>

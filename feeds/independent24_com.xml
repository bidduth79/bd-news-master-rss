    <item>
      <title>যারা দেশ ছেড়েছে, তারাই ষড়যন্ত্র করছে: জামায়াত আমির</title>
      <link>https://www.itvbd.com/politics/278059/%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%9B%E0%A7%87%E0%A7%9C%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%87-%E0%A6%B7%E0%A7%9C%E0%A6%AF%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%9B%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%A4-%E0%A6%86%E0%A6%AE%E0%A6%BF%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.itvbd.com/politics/278059/%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%9B%E0%A7%87%E0%A7%9C%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%87-%E0%A6%B7%E0%A7%9C%E0%A6%AF%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%9B%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%A4-%E0%A6%86%E0%A6%AE%E0%A6%BF%E0%A6%B0</guid>
      <pubDate>Sat, 14 Nov 2026 13:30:34 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/3d57eeffda51c4537486ea770144448f-6af80e15698a9.jpg?jadewits_media_id=167866" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/3d57eeffda51c4537486ea770144448f-6af80e15698a9.jpg?jadewits_media_id=167866" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/3d57eeffda51c4537486ea770144448f-6af80e15698a9.jpg?jadewits_media_id=167866" style="max-width:100%;height:auto;margin-bottom:10px;" alt="যারা দেশ ছেড়েছে, তারাই ষড়যন্ত্র করছে: জামায়াত আমির" /&gt;&lt;/p&gt;&lt;p&gt;ডিসেম্বর মাসে জামায়াতে ইসলামী সর্বোচ্চ শক্তি নিয়ে মাঠে থাকবে বলে জানিয়েছেন জামায়াত আমির ডা. শফিকুর রহমান। তিনি বলেন, ‘পাপের বোঝা বেশি বলেই দেশ ছেড়ে পালিয়েছে যারা, তারাই এখন নানা ষড়যন্ত্র করছে।’ শনিবার দুপুরে রাজধানীল ইঞ্জিনিয়ার্স ইনস্টিটিউশন মিলনায়তেন দলের যুব উপজেলা প্রতিনিধি সম্মেলনে যোগ দিয়ে এ ম&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/politics/278059/%E0%A6%AF%E0%A6%BE%E0%A6%B0%E0%A6%BE-%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%9B%E0%A7%87%E0%A7%9C%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%A4%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%87-%E0%A6%B7%E0%A7%9C%E0%A6%AF%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A6%9B%E0%A7%87-%E0%A6%9C%E0%A6%BE%E0%A6%AE%E0%A6%BE%E0%A7%9F%E0%A6%BE%E0%A6%A4-%E0%A6%86%E0%A6%AE%E0%A6%BF%E0%A6%B0">ইনডিপেনডেন্ট টিভি</source>
    </item>
    <item>
      <title>ধর্মীয় বাণী-খচিত গয়না, কারিনার পর এবার বিতর্কে দীপিকা</title>
      <link>https://www.itvbd.com/entertainment/bollywood/278058/%E0%A6%A7%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%80%E0%A6%AF%E0%A6%BC-%E0%A6%AC%E0%A6%BE%E0%A6%A3%E0%A7%80-%E0%A6%96%E0%A6%9A%E0%A6%BF%E0%A6%A4-%E0%A6%97%E0%A6%AF%E0%A6%BC%E0%A6%A8%E0%A6%BE-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A7%87</link>
      <guid isPermaLink="true">https://www.itvbd.com/entertainment/bollywood/278058/%E0%A6%A7%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%80%E0%A6%AF%E0%A6%BC-%E0%A6%AC%E0%A6%BE%E0%A6%A3%E0%A7%80-%E0%A6%96%E0%A6%9A%E0%A6%BF%E0%A6%A4-%E0%A6%97%E0%A6%AF%E0%A6%BC%E0%A6%A8%E0%A6%BE-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A7%87</guid>
      <pubDate>Sat, 14 Nov 2026 14:09:57 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/d4cb764159f0b55e7f0003c9eacad5f7-6af80ce51506a.jpg?jadewits_media_id=167864" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/d4cb764159f0b55e7f0003c9eacad5f7-6af80ce51506a.jpg?jadewits_media_id=167864" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/14/d4cb764159f0b55e7f0003c9eacad5f7-6af80ce51506a.jpg?jadewits_media_id=167864" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ধর্মীয় বাণী-খচিত গয়না, কারিনার পর এবার বিতর্কে দীপিকা" /&gt;&lt;/p&gt;&lt;p&gt;বলিউডে ধর্মীয় বাণী-খচিত গয়না পরার ট্রেন্ড নতুন কিছু নয়, তবে সম্প্রতি তা নতুন করে বিতর্কের জন্ম দিয়েছে। অভিনেত্রী কারিনা কাপুর খানের পর এবার সমালোচনার মুখে পড়েছেন আরেক শীর্ষ তারকা দীপিকা পাড়ুকোন। সামাজিক যোগাযোগমাধ্যমে তাঁর পুরনো একটি ছবি ভাইরাল হওয়ার পর থেকেই এই আলোচনা তুঙ্গে।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/entertainment/bollywood/278058/%E0%A6%A7%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%80%E0%A6%AF%E0%A6%BC-%E0%A6%AC%E0%A6%BE%E0%A6%A3%E0%A7%80-%E0%A6%96%E0%A6%9A%E0%A6%BF%E0%A6%A4-%E0%A6%97%E0%A6%AF%E0%A6%BC%E0%A6%A8%E0%A6%BE-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BF%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%95%E0%A7%87">ইনডিপেনডেন্ট টিভি</source>

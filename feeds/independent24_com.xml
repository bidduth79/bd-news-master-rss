    <item>
      <title>টোকিওস্থ বাংলাদেশ দূতাবাস ও গিফু শোটোকু ইউনিভার্সিটির মধ্যে এমওইউ</title>
      <link>https://www.itvbd.com/probash/278715/%E0%A6%9F%E0%A7%8B%E0%A6%95%E0%A6%BF%E0%A6%93%E0%A6%B8%E0%A7%8D%E0%A6%A5-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%A6%E0%A7%82%E0%A6%A4%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8-%E0%A6%93-%E0%A6%97%E0%A6%BF%E0%A6%AB%E0%A7%81-%E0%A6%B6%E0%A7%8B%E0%A6%9F%E0%A7%8B%E0%A6%95%E0%A7%81</link>
      <guid isPermaLink="true">https://www.itvbd.com/probash/278715/%E0%A6%9F%E0%A7%8B%E0%A6%95%E0%A6%BF%E0%A6%93%E0%A6%B8%E0%A7%8D%E0%A6%A5-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%A6%E0%A7%82%E0%A6%A4%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8-%E0%A6%93-%E0%A6%97%E0%A6%BF%E0%A6%AB%E0%A7%81-%E0%A6%B6%E0%A7%8B%E0%A6%9F%E0%A7%8B%E0%A6%95%E0%A7%81</guid>
      <pubDate>Thu, 26 Nov 2026 18:08:54 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/bfabf84bb3e7542afad84b0fe22ddd30-6b08215133d25.jpeg?jadewits_media_id=168244" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/bfabf84bb3e7542afad84b0fe22ddd30-6b08215133d25.jpeg?jadewits_media_id=168244" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/bfabf84bb3e7542afad84b0fe22ddd30-6b08215133d25.jpeg?jadewits_media_id=168244" style="max-width:100%;height:auto;margin-bottom:10px;" alt="টোকিওস্থ বাংলাদেশ দূতাবাস ও গিফু শোটোকু ইউনিভার্সিটির মধ্যে এমওইউ" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ ও জাপানের মধ্যে শিক্ষাক্ষেত্রে সম্পর্ক সম্প্রসারণ, মানবসম্পদ উন্নয়ন এবং জাপানি ভাষা শিক্ষার প্রসারের লক্ষ্যে জাপানের গিফু শোটোকু গাকুয়েন ইউনিভার্সিটি এবং টোকিওস্থ বাংলাদেশ দূতাবাসের মধ্যে একটি সমঝোতা স্মারক (এমওইউ) স্বাক্ষরিত হয়েছে। আজ বৃহস্পতিবার দূতাবাসে আয়োজিত এক অনুষ্ঠানে এই সমঝোতা স্ম&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/probash/278715/%E0%A6%9F%E0%A7%8B%E0%A6%95%E0%A6%BF%E0%A6%93%E0%A6%B8%E0%A7%8D%E0%A6%A5-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%A6%E0%A7%82%E0%A6%A4%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%B8-%E0%A6%93-%E0%A6%97%E0%A6%BF%E0%A6%AB%E0%A7%81-%E0%A6%B6%E0%A7%8B%E0%A6%9F%E0%A7%8B%E0%A6%95%E0%A7%81">ইনডিপেনডেন্ট টিভি</source>
    </item>
    <item>
      <title>সি-স্যুট অ্যাওয়ার্ডে ‘সিওও অব দ্য ইয়ার’ হলেন এসিআই কনজ্যুমার ব্র‍্যান্ডসের কামরুল হাসান</title>
      <link>https://www.itvbd.com/economy/corporate/278714/%E0%A6%B8%E0%A6%BF-%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%9F-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A7%87-%E2%80%98%E0%A6%B8%E0%A6%BF%E0%A6%93%E0%A6%93-%E0%A6%85%E0%A6%AC-%E0%A6%A6%E0%A7%8D%E0%A6%AF-%E0%A6%87%E0%A7%9F%E0%A6%BE%E0%A6%B0%E2%80%99-%E0%A6%B9%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%8F%E0%A6%B8%E0%A6%BF%E0%A6%86%E0%A6%87</link>
      <guid isPermaLink="true">https://www.itvbd.com/economy/corporate/278714/%E0%A6%B8%E0%A6%BF-%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%9F-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A7%87-%E2%80%98%E0%A6%B8%E0%A6%BF%E0%A6%93%E0%A6%93-%E0%A6%85%E0%A6%AC-%E0%A6%A6%E0%A7%8D%E0%A6%AF-%E0%A6%87%E0%A7%9F%E0%A6%BE%E0%A6%B0%E2%80%99-%E0%A6%B9%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%8F%E0%A6%B8%E0%A6%BF%E0%A6%86%E0%A6%87</guid>
      <pubDate>Thu, 26 Nov 2026 18:31:58 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/84e1346cb8215f361a56e4eab2a289b7-6b081fce1dcba.jpg?jadewits_media_id=168243" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/84e1346cb8215f361a56e4eab2a289b7-6b081fce1dcba.jpg?jadewits_media_id=168243" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/84e1346cb8215f361a56e4eab2a289b7-6b081fce1dcba.jpg?jadewits_media_id=168243" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সি-স্যুট অ্যাওয়ার্ডে ‘সিওও অব দ্য ইয়ার’ হলেন এসিআই কনজ্যুমার ব্র‍্যান্ডসের কামরুল হাসান" /&gt;&lt;/p&gt;&lt;p&gt;বাংলাদেশ সি-স্যুট অ্যাওয়ার্ডস ২০২৬-এ ‘সিওও অব দ্য ইয়ার’ সম্মাননা অর্জন করেছেন এসিআই কনজ্যুমার ব্র‍্যান্ডসের নির্বাহী পরিচালক ও প্রধান পরিচালন কর্মকর্তা (সিওও) মো. কামরুল হাসান। রাজধানীর লা মেরিডিয়ান হোটেলে আয়োজিত এক অনুষ্ঠানে বাংলাদেশ ব্র‍্যান্ড ফোরামের পক্ষ থেকে তাকে এই পুরস্কার দেওয়া হয়। ব্যবসায়িক&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/economy/corporate/278714/%E0%A6%B8%E0%A6%BF-%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A6%9F-%E0%A6%85%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A7%87-%E2%80%98%E0%A6%B8%E0%A6%BF%E0%A6%93%E0%A6%93-%E0%A6%85%E0%A6%AC-%E0%A6%A6%E0%A7%8D%E0%A6%AF-%E0%A6%87%E0%A7%9F%E0%A6%BE%E0%A6%B0%E2%80%99-%E0%A6%B9%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%8F%E0%A6%B8%E0%A6%BF%E0%A6%86%E0%A6%87">ইনডিপেনডেন্ট টিভি</source>

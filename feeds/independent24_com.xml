    <item>
      <title>রমজানের আগেই অস্থির ছোলার বাজার, কেজিতে বেড়েছে ২০ টাকা</title>
      <link>https://www.itvbd.com/economy/277761/%E0%A6%B0%E0%A6%AE%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%87%E0%A6%87-%E0%A6%85%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BF%E0%A6%B0-%E0%A6%9B%E0%A7%8B%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B9%E0%A7%87-%E0%A6%95%E0%A7%87%E0%A6%9C%E0%A6%BF%E0%A6%A4%E0%A7%87</link>
      <guid isPermaLink="true">https://www.itvbd.com/economy/277761/%E0%A6%B0%E0%A6%AE%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%87%E0%A6%87-%E0%A6%85%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BF%E0%A6%B0-%E0%A6%9B%E0%A7%8B%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B9%E0%A7%87-%E0%A6%95%E0%A7%87%E0%A6%9C%E0%A6%BF%E0%A6%A4%E0%A7%87</guid>
      <pubDate>Mon, 09 Nov 2026 09:36:16 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/7b39b0b450ba57b50db1749a83ff751c-6af1357b4feef.jpg?jadewits_media_id=167666" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/7b39b0b450ba57b50db1749a83ff751c-6af1357b4feef.jpg?jadewits_media_id=167666" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/09/7b39b0b450ba57b50db1749a83ff751c-6af1357b4feef.jpg?jadewits_media_id=167666" style="max-width:100%;height:auto;margin-bottom:10px;" alt="রমজানের আগেই অস্থির ছোলার বাজার, কেজিতে বেড়েছে ২০ টাকা" /&gt;&lt;/p&gt;&lt;p&gt;রমজান আসতে মাস তিনেক বাকি। এরই মধ্যে ছোলার বাজারে শুরু হয়েছে অস্থিরতা। মাত্র এক সপ্তাহের ব্যবধানে মানভেদে প্রতি কেজি ছোলার দাম বেড়েছে ২০ টাকার বেশি। এজন্য আমদানি ও পরিবহন খরচ বৃদ্ধিকে দায়ি করছেন ব্যবসায়ীরা। তবে, কৃত্রিম সংকট তৈরি করে দাম বাড়ানোর অভিযোগ করছেন ক্রেতারা। সিন্ডিকেট নিয়ন্ত্রণে আমদানি থেক&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/economy/277761/%E0%A6%B0%E0%A6%AE%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%87%E0%A6%87-%E0%A6%85%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BF%E0%A6%B0-%E0%A6%9B%E0%A7%8B%E0%A6%B2%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B9%E0%A7%87-%E0%A6%95%E0%A7%87%E0%A6%9C%E0%A6%BF%E0%A6%A4%E0%A7%87">ইনডিপেনডেন্ট টিভি</source>

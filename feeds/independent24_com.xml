      <guid isPermaLink="true">https://www.itvbd.com/country/khulna/277860/%E0%A6%AE%E0%A7%8B%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A7%AA%E0%A7%A9-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%AA%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%96%E0%A7%8B%E0%A6%81%E0%A6%9C-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%80%E0%A6%B0-%E0%A6%AE%E0%A6%B0%E0%A6%A6%E0%A7%87%E0%A6%B9</guid>
      <pubDate>Tue, 10 Nov 2026 18:23:36 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/22f5805886632ffb8118904fd374a32c-6af30c7270f41.jpg?jadewits_media_id=167725" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/22f5805886632ffb8118904fd374a32c-6af30c7270f41.jpg?jadewits_media_id=167725" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/10/22f5805886632ffb8118904fd374a32c-6af30c7270f41.jpg?jadewits_media_id=167725" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মোংলায় ৪৩ ঘণ্টা পর নিখোঁজ নিরাপত্তাকর্মীর মরদেহ উদ্ধার" /&gt;&lt;/p&gt;&lt;p&gt;বাগেরহাটের মোংলায় পশুর নদীতে গোসল করতে নেমে  নিখোঁজ সাবিত খান (২০)  নামের এক নিরাপত্তাকর্মীর মরদেহ উদ্ধার করা হয়েছে।

আজ মঙ্গলবার সকাল ৯টা ১০ মিনিটে সুন্দরবনের ঢাংমারী খালসংলগ্ন এলাকা থেকে নৌবাহিনী ও কোস্ট গার্ডের যৌথ উদ্ধারকারী দল সাবিতের মরদেহ উদ্ধার করে।  						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/country/khulna/277860/%E0%A6%AE%E0%A7%8B%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A7%AA%E0%A7%A9-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%AA%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%96%E0%A7%8B%E0%A6%81%E0%A6%9C-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%80%E0%A6%B0-%E0%A6%AE%E0%A6%B0%E0%A6%A6%E0%A7%87%E0%A6%B9">ইনডিপেনডেন্ট টিভি</source>
    </item>
    <item>
      <title>ডেঙ্গুতে ২৪ ঘণ্টা আরও ৮ প্রাণহানি</title>
      <link>https://www.itvbd.com/health/277859/%E0%A6%A1%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%81%E0%A6%A4%E0%A7%87-%E0%A7%A8%E0%A7%AA-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A7%AE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3%E0%A6%B9%E0%A6%BE%E0%A6%A8%E0%A6%BF%C2%A0</link>
      <guid isPermaLink="true">https://www.itvbd.com/health/277859/%E0%A6%A1%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%81%E0%A6%A4%E0%A7%87-%E0%A7%A8%E0%A7%AA-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A7%AE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3%E0%A6%B9%E0%A6%BE%E0%A6%A8%E0%A6%BF%C2%A0</guid>
      <pubDate>Tue, 10 Nov 2026 17:36:38 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/12/29/8567c28826c23e0a14023a2bce5c528d-6770c66f42783.jpg?jadewits_media_id=96920" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/12/29/8567c28826c23e0a14023a2bce5c528d-6770c66f42783.jpg?jadewits_media_id=96920" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/12/29/8567c28826c23e0a14023a2bce5c528d-6770c66f42783.jpg?jadewits_media_id=96920" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ডেঙ্গুতে ২৪ ঘণ্টা আরও ৮ প্রাণহানি" /&gt;&lt;/p&gt;&lt;p&gt;ডেঙ্গু আক্রান্ত হয়ে ২৪ ঘণ্টায় আরও ৮ জনের মৃত্যু হয়েছে। এ নিয়ে জানুয়ারি থেকে এ পর্যন্ত ডেঙ্গুতে মোট প্রাণহানি বেড়ে দাঁড়িয়েছে ৪৭৪ জনে।

একদিনে হাসপাতালে ভর্তি হয়েছেন ১ হাজার ৫৯৫ জন ডেঙ্গু রোগী। 						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/health/277859/%E0%A6%A1%E0%A7%87%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A7%81%E0%A6%A4%E0%A7%87-%E0%A7%A8%E0%A7%AA-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A7%AE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%A3%E0%A6%B9%E0%A6%BE%E0%A6%A8%E0%A6%BF%C2%A0">ইনডিপেনডেন্ট টিভি</source>
    </item>
    <item>
      <title>কপ-৩১ সম্মেলনে যোগ দিতে ইস্তাম্বুল পৌঁছেছেন প্রধানমন্ত্রী</title>
      <link>https://www.itvbd.com/national/277858/%E0%A6%95%E0%A6%AA-%E0%A7%A9%E0%A7%A7-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%A8%E0%A7%87-%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%87%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A7%81%E0%A6%B2-%E0%A6%AA%E0%A7%8C%E0%A6%81%E0%A6%9B%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.itvbd.com/national/277858/%E0%A6%95%E0%A6%AA-%E0%A7%A9%E0%A7%A7-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%A8%E0%A7%87-%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%87%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A7%81%E0%A6%B2-%E0%A6%AA%E0%A7%8C%E0%A6%81%E0%A6%9B%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Tue, 10 Nov 2026 17:03:56 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/11/20/012fb16d94833ea854cee6713f26b945-691e80d47c422.jpg?jadewits_media_id=146382" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/11/20/012fb16d94833ea854cee6713f26b945-691e80d47c422.jpg?jadewits_media_id=146382" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2025/11/20/012fb16d94833ea854cee6713f26b945-691e80d47c422.jpg?jadewits_media_id=146382" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কপ-৩১ সম্মেলনে যোগ দিতে ইস্তাম্বুল পৌঁছেছেন প্রধানমন্ত্রী" /&gt;&lt;/p&gt;&lt;p&gt;প্রধানমন্ত্রী তারেক রহমান কপ-৩১ সম্মেলনে যোগ দিতে তিন দিনের সরকারি সফরে আজ (স্থানীয় সময়) বেলা ১২ টা ৪০ মিনিটে তুরস্কের ইস্তাম্বুলে পৌঁছেছেন।

সম্মেলনে তিনি একটি পূর্ণাঙ্গ অধিবেশনে ভাষণ দেবেন এবং সম্মেলনের ফাঁকে বিভিন্ন দেশের নেতাদের সঙ্গে দ্বিপক্ষীয় বৈঠকে অংশ নেবেন।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/national/277858/%E0%A6%95%E0%A6%AA-%E0%A7%A9%E0%A7%A7-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%A8%E0%A7%87-%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%87%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A7%81%E0%A6%B2-%E0%A6%AA%E0%A7%8C%E0%A6%81%E0%A6%9B%E0%A7%87%E0%A6%9B%E0%A7%87%E0%A6%A8">ইনডিপেনডেন্ট টিভি</source>
    </item>
    <item>
      <title>সন্দেহভাজন গুপ্তচর প্রেমিকার বিষয়ে হুয়াং কিছুই জানতেন না: ট্রাম্প</title>
      <link>https://www.itvbd.com/world/america/277857/%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%87%E0%A6%B9%E0%A6%AD%E0%A6%BE%E0%A6%9C%E0%A6%A8-%E0%A6%97%E0%A7%81%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%9A%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AE%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B7%E0%A7%9F%E0%A7%87-%E0%A6%B9%E0%A7%81%E0%A7%9F%E0%A6%BE%E0%A6%82-%E0%A6%95%E0%A6%BF%E0%A6%9B%E0%A7%81%E0%A6%87</link>
      <guid isPermaLink="true">https://www.itvbd.com/world/america/277857/%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%87%E0%A6%B9%E0%A6%AD%E0%A6%BE%E0%A6%9C%E0%A6%A8-%E0%A6%97%E0%A7%81%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%9A%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AE%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B7%E0%A7%9F%E0%A7%87-%E0%A6%B9%E0%A7%81%E0%A7%9F%E0%A6%BE%E0%A6%82-%E0%A6%95%E0%A6%BF%E0%A6%9B%E0%A7%81%E0%A6%87</guid>
      <pubDate>Tue, 10 Nov 2026 16:56:02 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/12/28/7d5148891cf841d84a1be59939547ecc-676fa78992d0d.jpg?jadewits_media_id=96781" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/12/28/7d5148891cf841d84a1be59939547ecc-676fa78992d0d.jpg?jadewits_media_id=96781" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2024/12/28/7d5148891cf841d84a1be59939547ecc-676fa78992d0d.jpg?jadewits_media_id=96781" style="max-width:100%;height:auto;margin-bottom:10px;" alt="সন্দেহভাজন গুপ্তচর প্রেমিকার বিষয়ে হুয়াং কিছুই জানতেন না: ট্রাম্প" /&gt;&lt;/p&gt;&lt;p&gt;এনভিডিয়ার প্রধান নির্বাহী কর্মকর্তা (সিইও) জেনসেন হুয়াংয়ের প্রতি সহানুভূতি প্রকাশ করেছেন যুক্তরাষ্ট্রের প্রেসিডেন্ট ডোনাল্ড ট্রাম্প। সোমবার তিনি বলেন, হুয়াং ‘ভীষণ মানসিক কষ্টে’ রয়েছেন।						বিস্তারিত&lt;/p&gt;</description>

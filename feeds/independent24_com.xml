      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/26/13f6aa8df688c5cb76c74ebd9c102041-6b081c7cabe2d.jpg?jadewits_media_id=168239" length="0" type="image/jpeg" />

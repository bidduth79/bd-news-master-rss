    <item>
      <title>‘আমেরিকার সামরিক পদক্ষেপের জবাব দিতে পুরোপুরি প্রস্তুত ইরান’</title>
      <link>https://www.itvbd.com/world/middle-east/278807/%E2%80%98%E0%A6%86%E0%A6%AE%E0%A7%87%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%B0%E0%A6%BF%E0%A6%95-%E0%A6%AA%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%AC%E0%A6%BE%E0%A6%AC-%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%8B%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A6%BF</link>
      <guid isPermaLink="true">https://www.itvbd.com/world/middle-east/278807/%E2%80%98%E0%A6%86%E0%A6%AE%E0%A7%87%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%B0%E0%A6%BF%E0%A6%95-%E0%A6%AA%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%AC%E0%A6%BE%E0%A6%AC-%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%8B%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A6%BF</guid>
      <pubDate>Sat, 28 Nov 2026 22:00:53 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/f27da63227270b98641cc0ba9cc63f4e-6b0afaa136ff3.jpg?jadewits_media_id=168304" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/f27da63227270b98641cc0ba9cc63f4e-6b0afaa136ff3.jpg?jadewits_media_id=168304" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/28/f27da63227270b98641cc0ba9cc63f4e-6b0afaa136ff3.jpg?jadewits_media_id=168304" style="max-width:100%;height:auto;margin-bottom:10px;" alt="‘আমেরিকার সামরিক পদক্ষেপের জবাব দিতে পুরোপুরি প্রস্তুত ইরান’" /&gt;&lt;/p&gt;&lt;p&gt;আমেরিকার সম্ভাব্য সামরিক পদক্ষেপ নিয়ে যখন নতুন করে উত্তেজনা বাড়ছে, তখন একের পর এক কড়া বার্তা দিচ্ছে ইরান। দেশটির সামরিক বাহিনী বলেছে, শত্রুর যেকোনো ভুল পদক্ষেপের জবাব দিতে পুরোপুরি প্রস্তুত তারা। একই সঙ্গে ইরাককে ওয়াশিংটনের নীতির হাতিয়ার না হওয়ার সতর্কবার্তা দিয়েছে তেহরান।						বিস্তারিত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/world/middle-east/278807/%E2%80%98%E0%A6%86%E0%A6%AE%E0%A7%87%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%BE%E0%A6%B0-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%B0%E0%A6%BF%E0%A6%95-%E0%A6%AA%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA%E0%A7%87%E0%A6%B0-%E0%A6%9C%E0%A6%AC%E0%A6%BE%E0%A6%AC-%E0%A6%A6%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%8B%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A6%BF">ইনডিপেনডেন্ট টিভি</source>
    </item>
    <item>

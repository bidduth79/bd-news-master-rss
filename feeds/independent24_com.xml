      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/d7a667e39096bc4cb00a800aecc078af-6b0059b660967.jpg?jadewits_media_id=168052" length="0" type="image/jpeg" />

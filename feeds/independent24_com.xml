    <item>
      <title>বৈশ্বিক জলবায়ু সংকট মোকাবিলায় ৫ জরুরি পদক্ষেপের আহ্বান প্রধানমন্ত্রীর</title>
      <link>https://www.itvbd.com/national/277957/%E0%A6%AC%E0%A7%88%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%95-%E0%A6%9C%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A7%81-%E0%A6%B8%E0%A6%82%E0%A6%95%E0%A6%9F-%E0%A6%AE%E0%A7%8B%E0%A6%95%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A7%AB-%E0%A6%9C%E0%A6%B0%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%AA%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA%E0%A7%87%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.itvbd.com/national/277957/%E0%A6%AC%E0%A7%88%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%95-%E0%A6%9C%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A7%81-%E0%A6%B8%E0%A6%82%E0%A6%95%E0%A6%9F-%E0%A6%AE%E0%A7%8B%E0%A6%95%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A7%AB-%E0%A6%9C%E0%A6%B0%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%AA%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA%E0%A7%87%E0%A6%B0</guid>
      <pubDate>Thu, 12 Nov 2026 15:27:27 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/ee254fa5a39e01b59d8210d6f75526e6-6af5847b39b4c.jpg?jadewits_media_id=167803" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/ee254fa5a39e01b59d8210d6f75526e6-6af5847b39b4c.jpg?jadewits_media_id=167803" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/ee254fa5a39e01b59d8210d6f75526e6-6af5847b39b4c.jpg?jadewits_media_id=167803" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বৈশ্বিক জলবায়ু সংকট মোকাবিলায় ৫ জরুরি পদক্ষেপের আহ্বান প্রধানমন্ত্রীর" /&gt;&lt;/p&gt;&lt;p&gt;প্রধানমন্ত্রী তারেক রহমান বিশ্বব্যাপী জলবায়ু পরিবর্তনের ঝুঁকিতে থাকা দেশগুলোর স্বার্থ সুরক্ষায় পাঁচ জরুরি পদক্ষেপ গ্রহণের আহ্বান জানিয়েছেন। তিনি বলেছেন, ‘সাধারণ কিন্তু ভিন্নতর দায়িত্ব এবং নিজ নিজ সক্ষমতা নীতির আলোকে জলবায়ু পরিবর্তন মোকাবিলায় আন্তর্জাতিক সম্প্রদায়কে কার্যকর ও সমন্বিত উদ্যোগ নিতে হবে।&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/national/277957/%E0%A6%AC%E0%A7%88%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%BF%E0%A6%95-%E0%A6%9C%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A7%81-%E0%A6%B8%E0%A6%82%E0%A6%95%E0%A6%9F-%E0%A6%AE%E0%A7%8B%E0%A6%95%E0%A6%BE%E0%A6%AC%E0%A6%BF%E0%A6%B2%E0%A6%BE%E0%A7%9F-%E0%A7%AB-%E0%A6%9C%E0%A6%B0%E0%A7%81%E0%A6%B0%E0%A6%BF-%E0%A6%AA%E0%A6%A6%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A7%87%E0%A6%AA%E0%A7%87%E0%A6%B0">ইনডিপেনডেন্ট টিভি</source>
    </item>
    <item>
      <title>বন্ধুর জানাজায় নীরবে দাঁড়িয়ে শেষ বিদায় জানালেন সনাতন ধর্মের সুরেশ</title>
      <link>https://www.itvbd.com/country/barisal/277956/%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A7%81%E0%A6%B0-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A7%80%E0%A6%B0%E0%A6%AC%E0%A7%87-%E0%A6%A6%E0%A6%BE%E0%A6%81%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A6%BE%E0%A7%9F-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A8</link>
      <guid isPermaLink="true">https://www.itvbd.com/country/barisal/277956/%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A7%81%E0%A6%B0-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A7%80%E0%A6%B0%E0%A6%AC%E0%A7%87-%E0%A6%A6%E0%A6%BE%E0%A6%81%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A6%BE%E0%A7%9F-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A8</guid>
      <pubDate>Thu, 12 Nov 2026 15:19:29 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/48e53654fe56d867081b287e9708adf7-6af5845de5969.jpg?jadewits_media_id=167801" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/48e53654fe56d867081b287e9708adf7-6af5845de5969.jpg?jadewits_media_id=167801" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/48e53654fe56d867081b287e9708adf7-6af5845de5969.jpg?jadewits_media_id=167801" style="max-width:100%;height:auto;margin-bottom:10px;" alt="বন্ধুর জানাজায় নীরবে দাঁড়িয়ে শেষ বিদায় জানালেন সনাতন ধর্মের সুরেশ" /&gt;&lt;/p&gt;&lt;p&gt;ধর্ম আলাদা, কিন্তু বন্ধুত্বের বন্ধন ছিল অটুট। জীবনের শেষ বিদায়েও বন্ধুকে একনজর দেখতে ছুটে এলেন সনাতন ধর্মের বাল্যবন্ধু সুরেশ। মুসলিম বন্ধু হাকিম ডাকুয়ার জানাজা চলছিল নিচে। আর ব্রিজের ওপর নীরবে দাঁড়িয়ে অপলক দৃষ্টিতে বন্ধুর শেষ বিদায়ের দৃশ্য দেখছিলেন তিনি। দুই ভিন্ন ধর্মের মানুষের এমন মানবিক বন্ধুত্বে&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/country/barisal/277956/%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A7%81%E0%A6%B0-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A7%9F-%E0%A6%A8%E0%A7%80%E0%A6%B0%E0%A6%AC%E0%A7%87-%E0%A6%A6%E0%A6%BE%E0%A6%81%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A6%BE%E0%A7%9F-%E0%A6%9C%E0%A6%BE%E0%A6%A8%E0%A6%BE%E0%A6%B2%E0%A7%87%E0%A6%A8">ইনডিপেনডেন্ট টিভি</source>
    </item>
    <item>
      <title>মাদক চোরাচালানের দায়ে সৌদিতে ৫ বাংলাদেশি গ্রেপ্তার</title>

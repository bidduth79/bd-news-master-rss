    <item>
      <title>২৪ ডিসেম্বর বাংলাদেশেও শাহরুখের ‘কিং’! চলছে প্রস্তুতি</title>
      <link>https://www.itvbd.com/entertainment/dhallywood/277983/%E0%A7%A8%E0%A7%AA-%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%93-%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A6%B0%E0%A7%81%E0%A6%96%E0%A7%87%E0%A6%B0-%E2%80%98%E0%A6%95%E0%A6%BF%E0%A6%82%E2%80%99-%E0%A6%9A%E0%A6%B2%E0%A6%9B%E0%A7%87</link>
      <guid isPermaLink="true">https://www.itvbd.com/entertainment/dhallywood/277983/%E0%A7%A8%E0%A7%AA-%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%93-%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A6%B0%E0%A7%81%E0%A6%96%E0%A7%87%E0%A6%B0-%E2%80%98%E0%A6%95%E0%A6%BF%E0%A6%82%E2%80%99-%E0%A6%9A%E0%A6%B2%E0%A6%9B%E0%A7%87</guid>
      <pubDate>Thu, 12 Nov 2026 21:59:38 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/756685374accc9a4f7e5bd269e05182a-6af5dbda93263.jpg?jadewits_media_id=167821" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/756685374accc9a4f7e5bd269e05182a-6af5dbda93263.jpg?jadewits_media_id=167821" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/756685374accc9a4f7e5bd269e05182a-6af5dbda93263.jpg?jadewits_media_id=167821" style="max-width:100%;height:auto;margin-bottom:10px;" alt="২৪ ডিসেম্বর বাংলাদেশেও শাহরুখের ‘কিং’! চলছে প্রস্তুতি" /&gt;&lt;/p&gt;&lt;p&gt;শাহরুখ খানের বহুল প্রতীক্ষিত সিনেমা ‘কিং’ মুক্তি পেতে যাচ্ছে আগামী ২৪ ডিসেম্বর। ভারতসহ বিশ্বের বিভিন্ন দেশের সঙ্গে একই দিনে বাংলাদেশের প্রেক্ষাগৃহেও সিনেমাটি মুক্তি দেওয়ার উদ্যোগ নেওয়া হয়েছে। এরই মধ্যে সরকারি অনুমতির জন্য আবেদন করেছে প্রযোজনা ও পরিবেশনা প্রতিষ্ঠান অ্যাকশন কাট এন্টারটেইনমেন্ট।
বৃহস্প&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/entertainment/dhallywood/277983/%E0%A7%A8%E0%A7%AA-%E0%A6%A1%E0%A6%BF%E0%A6%B8%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%93-%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A6%B0%E0%A7%81%E0%A6%96%E0%A7%87%E0%A6%B0-%E2%80%98%E0%A6%95%E0%A6%BF%E0%A6%82%E2%80%99-%E0%A6%9A%E0%A6%B2%E0%A6%9B%E0%A7%87">ইনডিপেনডেন্ট টিভি</source>

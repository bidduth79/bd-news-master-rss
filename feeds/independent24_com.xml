    <item>
      <title>১৫ বছরের পথচলায় জাতীয়তাবাদী প্রচার দল</title>
      <link>https://www.itvbd.com/politics/278362/%E0%A7%A7%E0%A7%AB-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A6%9A%E0%A6%B2%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A6%AF%E0%A6%BC%E0%A6%A4%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A7%80-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%B2</link>
      <guid isPermaLink="true">https://www.itvbd.com/politics/278362/%E0%A7%A7%E0%A7%AB-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A6%9A%E0%A6%B2%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A6%AF%E0%A6%BC%E0%A6%A4%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A7%80-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%B2</guid>
      <pubDate>Fri, 20 Nov 2026 19:06:17 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/03d6151ab73b64488037a86837d95dea-6b002e5e4a05b.jpg?jadewits_media_id=168047" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/03d6151ab73b64488037a86837d95dea-6b002e5e4a05b.jpg?jadewits_media_id=168047" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/20/03d6151ab73b64488037a86837d95dea-6b002e5e4a05b.jpg?jadewits_media_id=168047" style="max-width:100%;height:auto;margin-bottom:10px;" alt="১৫ বছরের পথচলায় জাতীয়তাবাদী প্রচার দল" /&gt;&lt;/p&gt;&lt;p&gt;রাজনীতির মাঠে আদর্শের লড়াই শুধু রাজপথের আন্দোলন কিংবা সভা-সমাবেশের মধ্যেই সীমাবদ্ধ নয়; মতাদর্শের পক্ষে জনমত গঠন, রাজনৈতিক বক্তব্য মানুষের কাছে পৌঁছে দেওয়া এবং প্রতিকূল পরিস্থিতিতে সত্য তুলে ধরার লড়াইটিও সমান গুরুত্বপূর্ণ। বিশেষ করে সামাজিক যোগাযোগমাধ্যমের বিস্তারের আগের সময়ে রাজনৈতিক প্রচার ছিল&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/politics/278362/%E0%A7%A7%E0%A7%AB-%E0%A6%AC%E0%A6%9B%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%A5%E0%A6%9A%E0%A6%B2%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A7%80%E0%A6%AF%E0%A6%BC%E0%A6%A4%E0%A6%BE%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A7%80-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%9A%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%B2">ইনডিপেনডেন্ট টিভি</source>
    </item>
    <item>
      <title>জীবাশ্ম জ্বালানি নিয়ে জলবায়ু সম্মেলনে মতভেদ, ক্ষুব্ধ পরিবেশবিদরা</title>
      <link>https://www.itvbd.com/world/278361/%E0%A6%9C%E0%A7%80%E0%A6%AC%E0%A6%BE%E0%A6%B6%E0%A7%8D%E0%A6%AE-%E0%A6%9C%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%9C%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A7%81-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%A8%E0%A7%87-%E0%A6%AE%E0%A6%A4%E0%A6%AD%E0%A7%87%E0%A6%A6</link>
      <guid isPermaLink="true">https://www.itvbd.com/world/278361/%E0%A6%9C%E0%A7%80%E0%A6%AC%E0%A6%BE%E0%A6%B6%E0%A7%8D%E0%A6%AE-%E0%A6%9C%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%A8%E0%A6%BF-%E0%A6%A8%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%9C%E0%A6%B2%E0%A6%AC%E0%A6%BE%E0%A7%9F%E0%A7%81-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%A8%E0%A7%87-%E0%A6%AE%E0%A6%A4%E0%A6%AD%E0%A7%87%E0%A6%A6</guid>

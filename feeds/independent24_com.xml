      <guid isPermaLink="true">https://www.itvbd.com/national/278388/%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A3%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A7%9F-%E0%A6%B8%E0%A6%B9%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A6%BF%E0%A6%A4%E0%A6%BE</guid>
      <pubDate>Sat, 21 Nov 2026 11:21:17 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/62c96a6ce4de87b2b9c11222a83447cb-6b012a4a4ff28.jpg?jadewits_media_id=168060" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/62c96a6ce4de87b2b9c11222a83447cb-6b012a4a4ff28.jpg?jadewits_media_id=168060" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/21/62c96a6ce4de87b2b9c11222a83447cb-6b012a4a4ff28.jpg?jadewits_media_id=168060" style="max-width:100%;height:auto;margin-bottom:10px;" alt="মুক্তিযোদ্ধা পরিবারের কল্যাণে রাষ্ট্রীয় সহযোগিতা অব্যাহত রাখার ঘোষণা প্রধানমন্ত্রীর" /&gt;&lt;/p&gt;&lt;p&gt;বীর মুক্তিযোদ্ধা ও তাদের পরিবারের কল্যাণে রাষ্ট্রের সহযোগিতা সবসময় অব্যাহত থাকবে বলে জানিয়েছেন প্রধানমন্ত্রী তারেক রহমান। আজ শনিবার সকালে সশস্ত্র বাহিনী দিবসে ঢাকা সেনানিবাসের আর্মি মাল্টিপারপাস কমপ্লেক্সে খেতাবপ্রাপ্ত বীর মুক্তিযোদ্ধা এবং তাদের উত্তরাধিকারীদের সংবর্ধনা অনুষ্ঠানে তিনি এ কথা বলেন। 		&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/national/278388/%E0%A6%AE%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%AF%E0%A7%8B%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%95%E0%A6%B2%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A3%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A7%9F-%E0%A6%B8%E0%A6%B9%E0%A6%AF%E0%A7%8B%E0%A6%97%E0%A6%BF%E0%A6%A4%E0%A6%BE">ইনডিপেনডেন্ট টিভি</source>

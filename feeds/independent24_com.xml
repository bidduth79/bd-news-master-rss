    <item>
      <title>৪র্থ স্কোয়াট বাংলাদেশ সিম্পোজিয়াম শুরু ৫ ডিসেম্বর</title>
      <link>https://www.itvbd.com/science-tech/278660/%E0%A7%AA%E0%A6%B0%E0%A7%8D%E0%A6%A5-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%8B%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%9F-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%B8%E0%A6%BF%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A7%8B%E0%A6%9C%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AE-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81-%E0%A7%AB</link>
      <guid isPermaLink="true">https://www.itvbd.com/science-tech/278660/%E0%A7%AA%E0%A6%B0%E0%A7%8D%E0%A6%A5-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%8B%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%9F-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%B8%E0%A6%BF%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A7%8B%E0%A6%9C%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AE-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81-%E0%A7%AB</guid>
      <pubDate>Wed, 25 Nov 2026 18:00:13 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/c7f9a758cc231ca20dba4ac72e28a718-6b06cdc9dba90.jpg?jadewits_media_id=168210" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/c7f9a758cc231ca20dba4ac72e28a718-6b06cdc9dba90.jpg?jadewits_media_id=168210" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/25/c7f9a758cc231ca20dba4ac72e28a718-6b06cdc9dba90.jpg?jadewits_media_id=168210" style="max-width:100%;height:auto;margin-bottom:10px;" alt="৪র্থ স্কোয়াট বাংলাদেশ সিম্পোজিয়াম শুরু ৫ ডিসেম্বর" /&gt;&lt;/p&gt;&lt;p&gt;কৃত্রিম বুদ্ধিমত্তার যুগে সফটওয়্যারের মান নিশ্চিতের লক্ষ্য নিয়ে আগামী ৫ ডিসেম্বর ঢাকায় অনুষ্ঠিত হতে যাচ্ছে ৪র্থ স্কোয়াট বাংলাদেশ সিম্পোজিয়াম। এবারের প্রতিপাদ্য– ‘কোয়ালিটি ইন দ্য এজ অফ এআই’। রাজধানীর একটি হোটেলে আয়োজিত এই সম্মেলনে যোগ দেবেন ইন্টারন্যাশনাল সফটওয়্যার টেস্টিং কোয়ালিফিকেশনস বোর্ড - আই&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/science-tech/278660/%E0%A7%AA%E0%A6%B0%E0%A7%8D%E0%A6%A5-%E0%A6%B8%E0%A7%8D%E0%A6%95%E0%A7%8B%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%9F-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6-%E0%A6%B8%E0%A6%BF%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A7%8B%E0%A6%9C%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AE-%E0%A6%B6%E0%A7%81%E0%A6%B0%E0%A7%81-%E0%A7%AB">ইনডিপেনডেন্ট টিভি</source>
    </item>

    <item>
      <title>ফুটসাল ৭ টুর্নামেন্টের চ্যাম্পিয়ন রিয়েল মাদ্রিদ</title>
      <link>https://www.itvbd.com/sports/278465/%E0%A6%AB%E0%A7%81%E0%A6%9F%E0%A6%B8%E0%A6%BE%E0%A6%B2-%E0%A7%AD-%E0%A6%9F%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A7%9F%E0%A6%A8-%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%B2-%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%A6</link>
      <guid isPermaLink="true">https://www.itvbd.com/sports/278465/%E0%A6%AB%E0%A7%81%E0%A6%9F%E0%A6%B8%E0%A6%BE%E0%A6%B2-%E0%A7%AD-%E0%A6%9F%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A7%9F%E0%A6%A8-%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%B2-%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%A6</guid>
      <pubDate>Sun, 22 Nov 2026 16:53:20 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/82156d23e83a110c93c841e54dfc9301-6b02c9861c574.jpg?jadewits_media_id=168104" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/82156d23e83a110c93c841e54dfc9301-6b02c9861c574.jpg?jadewits_media_id=168104" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/22/82156d23e83a110c93c841e54dfc9301-6b02c9861c574.jpg?jadewits_media_id=168104" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফুটসাল ৭ টুর্নামেন্টের চ্যাম্পিয়ন রিয়েল মাদ্রিদ" /&gt;&lt;/p&gt;&lt;p&gt;রাজধানীর কোর্টসাইড ফুটসাল গ্রাউন্ডে অনুষ্ঠিত &amp;lsquo;ফুটসাল ৭ টুর্নামেন্ট ২০২৬&amp;rsquo;-এর শিরোপা জিতেছে রিয়েল মাদ্রিদ। গত শুক্রবার অনুষ্ঠিত ফাইনালে ম্যানচেস্টার ইউনাইটেডকে পেনাল্টি শুটআউটে ২-০ গোলে হারিয়ে চ্যাম্পিয়ন হয় দলটি।
নির্ধারিত সময়ে দুই দল গোল করতে না পারায় ম্যাচের ভাগ্য নির্ধারিত হয় পেনাল্টি শ&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/sports/278465/%E0%A6%AB%E0%A7%81%E0%A6%9F%E0%A6%B8%E0%A6%BE%E0%A6%B2-%E0%A7%AD-%E0%A6%9F%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%A8%E0%A6%BE%E0%A6%AE%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%AE%E0%A7%8D%E0%A6%AA%E0%A6%BF%E0%A7%9F%E0%A6%A8-%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%B2-%E0%A6%AE%E0%A6%BE%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%A6">ইনডিপেনডেন্ট টিভি</source>
    </item>

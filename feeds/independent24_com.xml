    <item>
      <title>কোরআনের আদর্শে ন্যায়ভিত্তিক সমাজ গঠনে কাজ করার আহ্বান রাষ্ট্রপতির</title>
      <link>https://www.itvbd.com/national/277991/%E0%A6%95%E0%A7%8B%E0%A6%B0%E0%A6%86%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%A6%E0%A6%B0%E0%A7%8D%E0%A6%B6%E0%A7%87-%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A7%9F%E0%A6%AD%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%9C-%E0%A6%97%E0%A6%A0%E0%A6%A8%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%9C-%E0%A6%95%E0%A6%B0%E0%A6%BE%E0%A6%B0</link>
      <guid isPermaLink="true">https://www.itvbd.com/national/277991/%E0%A6%95%E0%A7%8B%E0%A6%B0%E0%A6%86%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%A6%E0%A6%B0%E0%A7%8D%E0%A6%B6%E0%A7%87-%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A7%9F%E0%A6%AD%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%9C-%E0%A6%97%E0%A6%A0%E0%A6%A8%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%9C-%E0%A6%95%E0%A6%B0%E0%A6%BE%E0%A6%B0</guid>
      <pubDate>Thu, 12 Nov 2026 23:13:31 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/bf43f3d6191660648640ba8ee03940f1-6af5f3b88ec8b.JPG?jadewits_media_id=167827" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/bf43f3d6191660648640ba8ee03940f1-6af5f3b88ec8b.JPG?jadewits_media_id=167827" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2026/11/12/bf43f3d6191660648640ba8ee03940f1-6af5f3b88ec8b.JPG?jadewits_media_id=167827" style="max-width:100%;height:auto;margin-bottom:10px;" alt="কোরআনের আদর্শে ন্যায়ভিত্তিক সমাজ গঠনে কাজ করার আহ্বান রাষ্ট্রপতির" /&gt;&lt;/p&gt;&lt;p&gt;রাষ্ট্রপতি মির্জা ফখরুল ইসলাম আলমগীর পবিত্র কোরআনের শিক্ষা ও আদর্শ অনুসরণ করে একটি ন্যায়ভিত্তিক, মানবিক, শান্তিপূর্ণ ও কল্যাণমুখী সমাজ গঠনে সবাইকে সম্মিলিতভাবে কাজ করার আহ্বান জানিয়েছেন। তিনি বলেন, আলেমগণ মানুষকে সত্য, ন্যায় ও মানবতার পথ দেখান। সমাজে তাদের প্রভাব গভীর। সমাজ থেকে দুর্নীতি, মাদক, সন্ত&lt;/p&gt;</description>
      <source url="https://www.itvbd.com/national/277991/%E0%A6%95%E0%A7%8B%E0%A6%B0%E0%A6%86%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%A6%E0%A6%B0%E0%A7%8D%E0%A6%B6%E0%A7%87-%E0%A6%A8%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A7%9F%E0%A6%AD%E0%A6%BF%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%B8%E0%A6%AE%E0%A6%BE%E0%A6%9C-%E0%A6%97%E0%A6%A0%E0%A6%A8%E0%A7%87-%E0%A6%95%E0%A6%BE%E0%A6%9C-%E0%A6%95%E0%A6%B0%E0%A6%BE%E0%A6%B0">ইনডিপেনডেন্ট টিভি</source>
    </item>
    <item>
      <title>ফুটবল খেলাকে কেন্দ্র করে সংঘর্ষ, অটোরিকশা চালক নিহত</title>
      <link>https://www.itvbd.com/country/chittagong/277990/%E0%A6%AB%E0%A7%81%E0%A6%9F%E0%A6%AC%E0%A6%B2-%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8D%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%B0%E0%A7%8D%E0%A6%B7-%E0%A6%85%E0%A6%9F%E0%A7%8B%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%B6%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%95</link>
      <guid isPermaLink="true">https://www.itvbd.com/country/chittagong/277990/%E0%A6%AB%E0%A7%81%E0%A6%9F%E0%A6%AC%E0%A6%B2-%E0%A6%96%E0%A7%87%E0%A6%B2%E0%A6%BE%E0%A6%95%E0%A7%87-%E0%A6%95%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8D%E0%A6%B0-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A6%82%E0%A6%98%E0%A6%B0%E0%A7%8D%E0%A6%B7-%E0%A6%85%E0%A6%9F%E0%A7%8B%E0%A6%B0%E0%A6%BF%E0%A6%95%E0%A6%B6%E0%A6%BE-%E0%A6%9A%E0%A6%BE%E0%A6%B2%E0%A6%95</guid>
      <pubDate>Thu, 12 Nov 2026 23:06:00 +0600</pubDate>
      <enclosure url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2023/07/26/deadbody-4b10e21d8172d2ac16c3911071f8bc27.jpg?jadewits_media_id=1340" length="0" type="image/jpeg" />
      <media:content url="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2023/07/26/deadbody-4b10e21d8172d2ac16c3911071f8bc27.jpg?jadewits_media_id=1340" medium="image" />
      <description>&lt;p&gt;&lt;img src="https://cdn.itvbd.net/contents/cache/images/300x300x1/uploads/media/2023/07/26/deadbody-4b10e21d8172d2ac16c3911071f8bc27.jpg?jadewits_media_id=1340" style="max-width:100%;height:auto;margin-bottom:10px;" alt="ফুটবল খেলাকে কেন্দ্র করে সংঘর্ষ, অটোরিকশা চালক নিহত" /&gt;&lt;/p&gt;&lt;p&gt;ফুটবল খেলাকে কেন্দ্র করে চাঁদপুরের হাজীগঞ্জ উপজেলার এনায়েতপুর ও শাহরাস্তি উপজেলার ধোপল্লা গ্রামের দুই গ্রুপের সংঘর্ষে শাহজাহান (৩৫) নামে এক অটোরিকশা চালক নিহত হয়েছেন। এ ঘটনায় আহত হয়েছে আরও ৬ জন। বৃহস্পতিবার বিকেলে চাঁদপুর জেলার শাহরাস্তি উপজেলার ধোপল্লা বাজারে এ সংঘর্ষ হয়।						বিস্তারিত&lt;/p&gt;</description>

      <guid isPermaLink="true">https://www.deshebideshe.com/464152/the-ninth-and-final-shipment-of-uranium-has-arrived-at-the-rooppur-nuclear-power-plant/</guid>
      <pubDate>Fri, 27 Nov 2026 07:05:11 +0000</pubDate>

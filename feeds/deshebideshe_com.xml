    </item>
    <item>
      <title>আকাশপথে খাবার পাঠিয়ে উবার ইটসের নতুন চমক</title>
      <link>https://www.deshebideshe.com/463048/air-delivered-food-to-ub/</link>
      <guid isPermaLink="true">https://www.deshebideshe.com/463048/air-delivered-food-to-ub/</guid>

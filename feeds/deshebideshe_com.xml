      <guid isPermaLink="true">https://www.deshebideshe.com/463188/at-the-grameen-bank-in-mongla/</guid>
      <pubDate>Fri, 20 Nov 2026 17:53:21 +0000</pubDate>
      <enclosure url="https://www.deshebideshe.com/wp-content/uploads/2026/11/arrested.jpg" length="0" type="image/jpeg" />

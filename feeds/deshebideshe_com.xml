    <item>
      <title>তুরস্কের ইজমিরে ইস্পাত কারখানায় বিস্ফোরণে নিহত ১৭, আহত ১২</title>
      <link>https://www.deshebideshe.com/461701/17-killed-and-12-injured-in-an-explosion-at-a-steel-factory-in-izmir-turkey/</link>
      <guid isPermaLink="true">https://www.deshebideshe.com/461701/17-killed-and-12-injured-in-an-explosion-at-a-steel-factory-in-izmir-turkey/</guid>
      <pubDate>Tue, 10 Nov 2026 07:01:11 +0000</pubDate>
      <enclosure url="https://www.deshebideshe.com/wp-content/uploads/2026/11/tr-1.jpg" length="0" type="image/jpeg" />

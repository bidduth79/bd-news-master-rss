    <item>
      <title>[উখিয়া নিউজ] সৌদিতে সড়ক দুর্ঘটনায় নিহত ৭ বাংলাদেশির পরিচয় জানা‌ল কনস্যুলেট</title>
      <link>https://www.ukhiyanews.com/%e0%a6%b8%e0%a7%8c%e0%a6%a6%e0%a6%bf%e0%a6%a4%e0%a7%87-%e0%a6%b8%e0%a6%a1%e0%a6%bc%e0%a6%95-%e0%a6%a6%e0%a7%81%e0%a6%b0%e0%a7%8d%e0%a6%98%e0%a6%9f%e0%a6%a8%e0%a6%be%e0%a6%af%e0%a6%bc-%e0%a6%a8/</link>

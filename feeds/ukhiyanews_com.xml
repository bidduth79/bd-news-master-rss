    <item>
      <title>[উখিয়া নিউজ] চুক্তিভিত্তিক নিয়োগ দেবে ব্র্যাক এনজিও, থাকছে যেসব সুবিধা</title>
      <link>https://www.ukhiyanews.com/%e0%a6%9a%e0%a7%81%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%bf%e0%a6%ad%e0%a6%bf%e0%a6%a4%e0%a7%8d%e0%a6%a4%e0%a6%bf%e0%a6%95-%e0%a6%a8%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%8b%e0%a6%97-%e0%a6%a6%e0%a7%87-4/</link>
